// An effect with an operation, so every unit prints that operation's default body, and a
// private fn beside it for the bench to edit.
pub effect Audit {
    effect Log {
        fn note(msg: Str)
    }
}

pub fn audited(n: Int) -> Int ! Audit {
    audit.note(audit_line(n))
    n
}

fn audit_line(n: Int) -> Str {
    "items {n}"
}
