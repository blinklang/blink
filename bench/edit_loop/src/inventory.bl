import model.{Item, Category, category_name, item_value}

pub type Inventory {
    items: List[Item]
    by_category: Map[Str, Int]
}

fn restock_amount(it: Item) -> Int {
    if it.qty >= 10 {
        return 0
    }
    match it.category {
        Tool => 2
        Part => 20 - it.qty
        Supply => 50 - it.qty
    }
}

pub fn build_inventory(items: List[Item]) -> Inventory {
    let mut by_category: Map[Str, Int] = Map()
    for it in items {
        let key = category_name(it.category)
        let prev = by_category.get(key) ?? 0
        by_category.insert(key, prev + it.qty)
    }
    Inventory { items: items, by_category: by_category }
}

pub fn total_value(inv: Inventory) -> Int {
    let mut total = 0
    for it in inv.items {
        total = total + item_value(it)
    }
    total
}

pub fn restock_list(inv: Inventory) -> List[Str] {
    let mut out: List[Str] = []
    for it in inv.items {
        let n = restock_amount(it)
        if n > 0 {
            out.push("{it.name} +{n}")
        }
    }
    out
}

pub fn count_in(inv: Inventory, c: Category) -> Int {
    inv.by_category.get(category_name(c)) ?? 0
}
