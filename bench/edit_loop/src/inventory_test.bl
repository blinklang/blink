import model.{Item, Category}
import inventory.{build_inventory, total_value, restock_list, count_in}

fn sample() -> List[Item] {
    [
        Item { name: "saw", category: Category.Tool, qty: 1, price_cents: 2500 },
        Item { name: "nut", category: Category.Part, qty: 15, price_cents: 5 },
        Item { name: "tape", category: Category.Supply, qty: 30, price_cents: 300 },
    ]
}

test "total value sums qty times price" {
    assert_eq(total_value(build_inventory(sample())), 2500 + 75 + 9000)
}

test "restock lists only items under ten" {
    assert_eq(restock_list(build_inventory(sample())), ["saw +2"])
}

test "counts group by category" {
    let inv = build_inventory(sample())
    assert_eq(count_in(inv, Category.Part), 15)
    assert_eq(count_in(inv, Category.Tool), 1)
}
