import parse.{parse_items}
import inventory.{build_inventory}
import report.{render}
import audit.{Audit, audited}

let SAMPLE: Str = "[\{\"name\": \"hammer\", \"category\": \"tool\", \"qty\": 3, \"price\": 1599\}, \{\"name\": \"bolt\", \"category\": \"part\", \"qty\": 120, \"price\": 12\}, \{\"name\": \"glue\", \"category\": \"supply\", \"qty\": 4, \"price\": 450\}]"

fn main() {
    match parse_items(SAMPLE) {
        Ok(items) => {
            // The handler drops each note, so the output stays what it was before the effect.
            with handler Audit {
                fn note(_msg: Str) {}
            } {
                let _n = audited(items.len())
            }
            io.print_raw(render(build_inventory(items)))
        }
        Err(e) => io.eprintln("error: {e}")
    }
}
