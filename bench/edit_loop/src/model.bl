pub type Category {
    Tool
    Part
    Supply
}

pub type Item {
    name: Str
    category: Category
    qty: Int
    price_cents: Int
}

pub fn category_name(c: Category) -> Str {
    match c {
        Tool => "tool"
        Part => "part"
        Supply => "supply"
    }
}

pub fn category_of(s: Str) -> Option[Category] {
    match s {
        "tool" => Some(Category.Tool)
        "part" => Some(Category.Part)
        "supply" => Some(Category.Supply)
        _ => None
    }
}

pub fn item_value(it: Item) -> Int {
    it.qty * it.price_cents
}
