import std.json
import model.{Item, category_of}

fn field_str(obj: Int, key: Str) -> Result[Str, Str] {
    let node = json.json_get(obj, key)
    if node == -1 {
        return Err("missing field {key}")
    }
    Ok(json.json_as_str(node))
}

fn field_int(obj: Int, key: Str) -> Result[Int, Str] {
    let node = json.json_get(obj, key)
    if node == -1 {
        return Err("missing field {key}")
    }
    Ok(json.json_as_int(node))
}

fn parse_item(obj: Int) -> Result[Item, Str] {
    let name = field_str(obj, "name")?
    let cat_name = field_str(obj, "category")?
    let category = match category_of(cat_name) {
        Some(c) => c
        None => return Err("unknown category {cat_name}")
    }
    let qty = field_int(obj, "qty")?
    let price = field_int(obj, "price")?
    Ok(Item { name: name, category: category, qty: qty, price_cents: price })
}

pub fn parse_items(input: Str) -> Result[List[Item], Str] {
    let root = json.json_parse(input)
    if root == -1 {
        return Err("bad json")
    }
    let mut items: List[Item] = []
    let mut i = 0
    loop {
        let obj = json.json_at(root, i)
        if obj == -1 {
            break
        }
        items.push(parse_item(obj)?)
        i = i + 1
    }
    Ok(items)
}
