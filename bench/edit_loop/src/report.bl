import model.{Category}
import inventory.{Inventory, total_value, restock_list, count_in}

fn dollars(cents: Int) -> Str {
    let frac = cents % 100
    let pad = if frac < 10 { "0" } else { "" }
    "${cents / 100}.{pad}{frac}"
}

pub fn render(inv: Inventory) -> Str {
    let sb = StringBuilder.new()
    sb.write("items: {inv.items.len()}\n")
    sb.write("tools: {count_in(inv, Category.Tool)} parts: {count_in(inv, Category.Part)} supplies: {count_in(inv, Category.Supply)}\n")
    sb.write("value: {dollars(total_value(inv))}\n")
    for line in restock_list(inv) {
        sb.write("restock {line}\n")
    }
    sb.to_str()
}
