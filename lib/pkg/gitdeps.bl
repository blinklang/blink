// gitdeps.bl — git dependency fetcher for Blink package manager
//
// Clones, caches, and checks out git dependencies.
// Cache layout: ~/.blink/cache/git/{sanitized_url}/repo.git (bare clone)
//               ~/.blink/cache/git/{sanitized_url}/{commit}/ (checkout)

import std.path.{path_join}
import std.str.{str_trim_right}

// ── Last fetch results ──────────────────────────────────────────
pub let mut last_commit: Str = ""
pub let mut last_checkout_path: Str = ""
pub let mut last_content_hash: Str = ""

// ── Clear state ─────────────────────────────────────────────────

pub fn git_clear() {
    last_commit = ""
    last_checkout_path = ""
    last_content_hash = ""
}

// ── Helpers ─────────────────────────────────────────────────────

fn get_home_dir() -> Str {
    env.var("HOME") ?? ""
}

pub fn sanitize_url(url: Str) -> Str {
    let mut result = ""
    let mut i = 0
    while i < url.byte_len() {
        let ch = url.byte_at(i)
        let mut keep = 0
        if ch >= 48 && ch <= 57 { // '0'..'9'
            keep = 1
        }
        if ch >= 65 && ch <= 90 { // 'A'..'Z'
            keep = 1
        }
        if ch >= 97 && ch <= 122 { // 'a'..'z'
            keep = 1
        }
        if keep == 1 {
            result = result.concat(url.byte_slice(i, i + 1))
        } else {
            result = result.concat("_")
        }
        i = i + 1
    }
    result
}

// ── Git operations ──────────────────────────────────────────────

fn ensure_bare_clone(url: Str, cache_dir: Str) -> Int {
    let repo_dir = path_join(cache_dir, "repo.git")
    if is_dir(repo_dir) == 1 {
        // A fetch that fails (offline, say) leaves the clone as it was, and resolve_commit
        // still finds a ref the clone already holds.
        let _ = process.run("git", ["-C", repo_dir, "fetch", "--tags", "--quiet"])
        return 0
    }
    if git_ok(["clone", "--bare", "--quiet", url, repo_dir]) { 0 } else { 1 }
}

// Whether git ran with args and exited 0. git's own messages are captured and dropped,
// as the old 2>/dev/null did: the caller says which dependency failed.
fn git_ok(args: List[Str]) -> Bool {
    match process.run("git", args) {
        Ok(r) => r.success()
        Err(_) => false
    }
}

fn resolve_commit(cache_dir: Str, ref: Str) -> Int {
    let repo_dir = path_join(cache_dir, "repo.git")
    last_commit = match process.run("sh", ["-c", "git -C {repo_dir} rev-list -1 {ref} 2>/dev/null | head -c 40"]) {
        Ok(result) => str_trim_right(result.out)
        Err(_) => ""
    }
    if last_commit.len() == 0 {
        return 1
    }
    0
}

fn ensure_checkout(cache_dir: Str, commit: Str) -> Int {
    let checkout_dir = path_join(cache_dir, commit)
    if is_dir(checkout_dir) == 1 {
        last_checkout_path = checkout_dir
        return 0
    }
    let repo_dir = path_join(cache_dir, "repo.git")
    // A half-made checkout dir would pass the is_dir check above on the next fetch.
    if !git_ok(["clone", "--shared", "--quiet", repo_dir, checkout_dir]) || !git_ok(["-C", checkout_dir, "checkout", "--quiet", commit]) {
        let _ = process.run("rm", ["-rf", checkout_dir])
        return 1
    }
    last_checkout_path = checkout_dir
    0
}

fn compute_content_hash(dir: Str) -> Int {
    match process.run("sh", ["-c", "find {dir} -name '*.bl' -type f | sort | xargs cat | sha256sum | cut -c1-64"]) {
        Ok(result) => {
            last_content_hash = str_trim_right(result.out)
            0
        }
        Err(_) => 1
    }
}

// ── Main fetch function ─────────────────────────────────────────

pub fn git_fetch(url: Str, tag: Str) -> Int {
    git_clear()

    let home = get_home_dir()
    let sanitized = sanitize_url(url)
    let cache_dir = path_join(path_join(path_join(home, ".blink"), "cache"), "git")
    let dep_dir = path_join(cache_dir, sanitized)

    match process.run("mkdir", ["-p", dep_dir]) {
        Ok(r) => {
            if !r.success() {
                io.eprint(r.err_out)
                return 1
            }
        }
        Err(e) => {
            io.eprintln("{e}")
            return 1
        }
    }

    let clone_rc = ensure_bare_clone(url, dep_dir)
    if clone_rc != 0 {
        return 1
    }

    let resolve_rc = resolve_commit(dep_dir, tag)
    if resolve_rc != 0 {
        return 1
    }

    let checkout_rc = ensure_checkout(dep_dir, last_commit)
    if checkout_rc != 0 {
        return 1
    }

    let hash_rc = compute_content_hash(last_checkout_path)
    if hash_rc != 0 {
        return 1
    }

    0
}

// ── Query functions ─────────────────────────────────────────────

pub fn git_get_commit() -> Str {
    last_commit
}

pub fn git_get_checkout_path() -> Str {
    last_checkout_path
}

pub fn git_get_content_hash() -> Str {
    last_content_hash
}
