// manifest.bl — blink.toml manifest loader and validator (§8.9.3)
//
// Loads, parses, and validates blink.toml project manifests.
// Uses std.toml for parsing and stores results in parallel arrays.

import std.toml.{toml_keys, toml_types, toml_values, toml_has, toml_get, toml_get_int, toml_get_array_len, toml_get_array_item, toml_clear, toml_parse, toml_key_spans, toml_value_spans, toml_headers, toml_header_spans, TomlSpan, TOML_STRING, TOML_ARRAY, TOML_INLINE_TABLE}

// ── Package metadata ─────────────────────────────────────────────
pub let mut manifest_name: Str = ""
pub let mut manifest_version: Str = ""
pub let mut manifest_edition: Str = ""
pub let mut manifest_description: Str = ""
pub let mut manifest_license: Str = ""
pub let mut manifest_repository: Str = ""
pub let mut manifest_blink_version: Str = ""

// ── Dependencies: parallel arrays ────────────────────────────────
pub let mut dep_names: List[Str] = []
pub let mut dep_versions: List[Str] = []
pub let mut dep_git_urls: List[Str] = []
pub let mut dep_git_tags: List[Str] = []
pub let mut dep_paths: List[Str] = []
pub let mut dep_is_dev: List[Int] = []

// ── Capabilities ─────────────────────────────────────────────────
pub let mut cap_required: List[Str] = []
pub let mut cap_optional: List[Str] = []

// ── Alternatives ─────────────────────────────────────────────────
pub let mut alt_keys: List[Str] = []
pub let mut alt_values: List[Str] = []

// ── Lint overrides ──────────────────────────────────────────────
pub let mut lint_names: List[Str] = []
pub let mut lint_levels: List[Str] = []

// ── Warnings from the last load ─────────────────────────────────
// Always collected, so a caller that loads the manifest more than once in one command can turn
// the print off and report the list itself, once.
pub let mut manifest_warnings: List[Str] = []
pub let mut manifest_print_warnings = true

// ── Issues from the last load ───────────────────────────────────
// The compiler maps each kind to its diagnostic code. The span is the token the spec names
// (§8.9.8): the value token for a bad value, the [header] for a bad section.
@derive(Eq, Debug)
pub type ManifestIssueKind {
    InvalidLintLevel
    UnknownManifestSection
    UnknownManifestKey
}

pub type ManifestIssue {
    kind: ManifestIssueKind
    section: Str
    // The lint name, for InvalidLintLevel; the key as written below the section, for
    // UnknownManifestKey; "" otherwise.
    key: Str
    // The level as written: the string for a string value, else the value token.
    level: Str
    // The closest defined section, for UnknownManifestSection; the closest key of the same
    // table, for UnknownManifestKey.
    suggestion: Option[Str]
    line: Int
    col: Int
    end_line: Int
    end_col: Int
}

pub let mut manifest_issues: List[ManifestIssue] = []

// ── [test] ───────────────────────────────────────────────────────
// A value as written, for a caller that checks it and reports a bad one at its span.
pub type ManifestValue {
    // The string for a string value, else the source text of the value.
    text: Str
    is_string: Bool
    span: TomlSpan
}

// [test] timeout, unchecked: `blink test` parses it and owns its errors (§8.10.7).
pub let mut manifest_test_timeout: Option[ManifestValue] = None

// ── Native dependencies: parallel arrays ────────────────────────
pub let mut native_dep_names: List[Str] = []
pub let mut native_dep_types: List[Str] = []
pub let mut native_dep_paths: List[Str] = []
pub let mut native_dep_pkg_configs: List[Str] = []
pub let mut native_dep_links: List[Str] = []
pub let mut native_dep_headers: List[List[Str]] = []
let mut declared_headers_set: Map[Str, Int] = Map()

// ── Known top-level sections ─────────────────────────────────────
let known_sections: List[Str] = ["package", "dependencies", "dev-dependencies", "capabilities", "alternatives", "lints", "native-dependencies", "test"]

// The keys of each closed table (§8.9.8). A table not listed here takes any key.
fn closed_table_keys(section: Str) -> Option[List[Str]] {
    if section == "test" { return Some(["timeout"]) }
    None
}

// ── Clear all manifest state ─────────────────────────────────────

pub fn manifest_clear() {
    manifest_name = ""
    manifest_version = ""
    manifest_edition = ""
    manifest_description = ""
    manifest_license = ""
    manifest_repository = ""
    manifest_blink_version = ""
    dep_names = []
    dep_versions = []
    dep_git_urls = []
    dep_git_tags = []
    dep_paths = []
    dep_is_dev = []
    cap_required = []
    cap_optional = []
    alt_keys = []
    alt_values = []
    lint_names = []
    lint_levels = []
    manifest_warnings = []
    manifest_issues = []
    manifest_test_timeout = None
    native_dep_names = []
    native_dep_types = []
    native_dep_paths = []
    native_dep_pkg_configs = []
    native_dep_links = []
    native_dep_headers = []
    declared_headers_set = Map()
}

// ── Helpers ──────────────────────────────────────────────────────

// Validate [package].name grammar per spec §10.5: must match [a-z][a-z0-9_]*.
// Returns 1 if valid, 0 otherwise.
pub fn validate_package_name(name: Str) -> Int {
    if name.len() == 0 {
        return 0
    }
    let first = name.byte_at(0)
    if first < 97 || first > 122 { // 'a'..'z'
        return 0
    }
    let mut i = 1
    while i < name.byte_len() {
        let ch = name.byte_at(i)
        let ok = (ch >= 97 && ch <= 122) || (ch >= 48 && ch <= 57) || ch == 95
        if !ok {
            return 0
        }
        i = i + 1
    }
    1
}

fn is_known_section(name: Str) -> Int {
    let mut i = 0
    while i < known_sections.len() {
        if known_sections.get(i).unwrap() == name {
            return 1
        }
        i = i + 1
    }
    0
}

fn has_dep(name: Str) -> Int {
    let mut i = 0
    while i < dep_names.len() {
        if dep_names.get(i).unwrap() == name {
            return 1
        }
        i = i + 1
    }
    0
}

// Extract the dep name from a toml key like "dependencies.std/http" or
// "dependencies.std/http.git". Returns the portion after "dependencies."
// up to the next dot (if any) that isn't part of a package name with /.
// dep_prefix is "dependencies" or "dev-dependencies".
fn extract_dep_name(key: Str, prefix_len: Int) -> Str {
    // Skip past "dependencies." or "dev-dependencies."
    let start = prefix_len + 1
    if start >= key.byte_len() {
        return ""
    }
    let rest = key.byte_slice(start, key.byte_len())
    // The dep name can contain / (e.g. std/http). We need to find the
    // sub-key separator dot that comes AFTER the dep name. Dep names
    // are bare-key chars (alphanumeric, -, _, /). We scan for a dot
    // that is followed by a known sub-key: git, tag, path, version, features.
    let mut i = 0
    while i < rest.byte_len() {
        if rest.byte_at(i) == 46 { // '.'
            let after = rest.byte_slice(i + 1, rest.byte_len())
            if after == "git" || after == "tag" || after == "path" || after == "version" || after == "features" {
                return rest.byte_slice(0, i)
            }
            if after.starts_with("features[") {
                return rest.byte_slice(0, i)
            }
        }
        i = i + 1
    }
    rest
}

fn add_dep(name: Str, version: Str, git_url: Str, git_tag: Str, dep_path: Str, is_dev: Int) {
    dep_names.push(name)
    dep_versions.push(version)
    dep_git_urls.push(git_url)
    dep_git_tags.push(git_tag)
    dep_paths.push(dep_path)
    dep_is_dev.push(is_dev)
}

// ── Load package metadata from parsed toml ───────────────────────

pub fn load_package() -> Int {
    if toml_has("package.name") == 0 {
        io.eprintln("error: [package] section missing required field 'name'")
        return 1
    }
    if toml_has("package.version") == 0 {
        io.eprintln("error: [package] section missing required field 'version'")
        return 1
    }

    manifest_name = toml_get("package.name")
    manifest_version = toml_get("package.version")

    if manifest_name == "" {
        io.eprintln("error: package name must not be empty")
        return 1
    }
    if manifest_version == "" {
        io.eprintln("error: package version must not be empty")
        return 1
    }
    if validate_package_name(manifest_name) == 0 {
        io.eprintln("error[E1011]: package name '{manifest_name}' is invalid — must match [a-z][a-z0-9_]* (no hyphens, no dots, no uppercase)")
        return 1
    }

    if toml_has("package.edition") == 1 {
        manifest_edition = toml_get("package.edition")
    }
    if toml_has("package.description") == 1 {
        manifest_description = toml_get("package.description")
    }
    if toml_has("package.license") == 1 {
        manifest_license = toml_get("package.license")
    }
    if toml_has("package.repository") == 1 {
        manifest_repository = toml_get("package.repository")
    }
    if toml_has("package.blink-version") == 1 {
        manifest_blink_version = toml_get("package.blink-version")
    }

    0
}

// ── Collect dependency names from toml keys ──────────────────────
// Scans toml_keys for entries starting with the given prefix
// (e.g. "dependencies" or "dev-dependencies") and collects
// unique dep names into a temporary list.

let mut tmp_dep_names: List[Str] = []

fn collect_dep_names(prefix: Str) {
    tmp_dep_names = []
    let prefix_dot = prefix.concat(".")
    let mut i = 0
    while i < toml_keys.len() {
        let key = toml_keys.get(i).unwrap()
        if key.starts_with(prefix_dot) {
            let name = extract_dep_name(key, prefix.byte_len())
            if name != "" {
                // Check if already collected
                let mut found = 0
                let mut j = 0
                while j < tmp_dep_names.len() {
                    if tmp_dep_names.get(j).unwrap() == name {
                        found = 1
                    }
                    j = j + 1
                }
                if found == 0 {
                    tmp_dep_names.push(name)
                }
            }
        }
        i = i + 1
    }
}

// ── Load dependencies from a section ─────────────────────────────

pub fn load_deps(prefix: Str, is_dev: Int) -> Int {
    collect_dep_names(prefix)

    let mut i = 0
    while i < tmp_dep_names.len() {
        let name = tmp_dep_names.get(i).unwrap()
        let base_key = prefix.concat(".").concat(name)

        let mut version = ""
        let mut git_url = ""
        let mut git_tag = ""
        let mut dep_path = ""
        let mut source_count = 0

        // Check if this is a plain string value (e.g. std/http = "1.2")
        if toml_has(base_key) == 1 {
            let idx = find_dep_type(base_key)
            if idx == 0 {
                // TOML_STRING — simple version constraint
                version = toml_get(base_key)
                source_count = source_count + 1
            } else if idx == 4 {
                // TOML_INLINE_TABLE — check sub-keys
                let ver_key = base_key.concat(".version")
                let git_key = base_key.concat(".git")
                let tag_key = base_key.concat(".tag")
                let path_key = base_key.concat(".path")

                if toml_has(ver_key) == 1 {
                    version = toml_get(ver_key)
                    source_count = source_count + 1
                }
                if toml_has(git_key) == 1 {
                    git_url = toml_get(git_key)
                    source_count = source_count + 1
                    if toml_has(tag_key) == 1 {
                        git_tag = toml_get(tag_key)
                    }
                }
                if toml_has(path_key) == 1 {
                    dep_path = toml_get(path_key)
                    source_count = source_count + 1
                }
            }
        } else {
            // Inline table sub-keys exist but no base entry — check sub-keys directly
            let ver_key = base_key.concat(".version")
            let git_key = base_key.concat(".git")
            let tag_key = base_key.concat(".tag")
            let path_key = base_key.concat(".path")

            if toml_has(ver_key) == 1 {
                version = toml_get(ver_key)
                source_count = source_count + 1
            }
            if toml_has(git_key) == 1 {
                git_url = toml_get(git_key)
                source_count = source_count + 1
                if toml_has(tag_key) == 1 {
                    git_tag = toml_get(tag_key)
                }
            }
            if toml_has(path_key) == 1 {
                dep_path = toml_get(path_key)
                source_count = source_count + 1
            }
        }

        if source_count == 0 {
            io.eprintln("error: dependency '{name}' has no source (need version, git, or path)")
            return 1
        }
        if source_count > 1 {
            io.eprintln("error: dependency '{name}' has multiple sources (must specify exactly one of: version, git, path)")
            return 1
        }

        add_dep(name, version, git_url, git_tag, dep_path, is_dev)
        i = i + 1
    }

    0
}

// Look up the toml type tag for a key
fn find_dep_type(key: Str) -> Int {
    let mut i = 0
    while i < toml_keys.len() {
        if toml_keys.get(i).unwrap() == key {
            return toml_types.get(i).unwrap()
        }
        i = i + 1
    }
    -1
}

// ── Load capabilities ────────────────────────────────────────────

pub fn load_capabilities() {
    if toml_has("capabilities.required") == 1 {
        let count = toml_get_array_len("capabilities.required")
        let mut i = 0
        while i < count {
            let item = toml_get_array_item("capabilities.required", i)
            cap_required.push(item)
            i = i + 1
        }
    }
    if toml_has("capabilities.optional") == 1 {
        let count = toml_get_array_len("capabilities.optional")
        let mut i = 0
        while i < count {
            let item = toml_get_array_item("capabilities.optional", i)
            cap_optional.push(item)
            i = i + 1
        }
    }
}

// ── Load alternatives ────────────────────────────────────────────

pub fn load_alternatives() {
    let prefix = "alternatives."
    let prefix_len = prefix.byte_len()
    let mut i = 0
    while i < toml_keys.len() {
        let key = toml_keys.get(i).unwrap()
        if key.starts_with(prefix) {
            let alt_key = key.byte_slice(prefix_len, key.byte_len())
            let alt_val = toml_values.get(i).unwrap()
            alt_keys.push(alt_key)
            alt_values.push(alt_val)
        }
        i = i + 1
    }
}

// ── Load lint overrides ─────────────────────────────────────────

pub fn load_lints() {
    let prefix = "lints."
    let prefix_len = prefix.byte_len()
    let mut i = 0
    while i < toml_keys.len() {
        let key = toml_keys.get(i).unwrap()
        if key.starts_with(prefix) {
            let lint_name = key.byte_slice(prefix_len, key.byte_len())
            let lint_val = toml_values.get(i).unwrap()
            if lint_val == "off" || lint_val == "warn" || lint_val == "error" {
                lint_names.push(lint_name)
                lint_levels.push(lint_val)
            } else {
                manifest_warn("warning: unknown lint level '{lint_val}' for '{lint_name}' in [lints] (expected off, warn, or error)")
            }
        }
        i = i + 1
    }
}

// ── Load native dependencies ────────────────────────────────────

pub fn load_native_deps() {
    let prefix = "native-dependencies."
    let prefix_len = prefix.byte_len()
    let mut collected: List[Str] = []
    let mut i = 0
    while i < toml_keys.len() {
        let key = toml_keys.get(i).unwrap()
        if key.starts_with(prefix) {
            let rest = key.byte_slice(prefix_len, key.byte_len())
            let mut dot_pos = -1
            let mut j = 0
            while j < rest.byte_len() {
                if rest.byte_at(j) == 46 { // '.'
                    dot_pos = j
                    j = rest.byte_len()
                }
                j = j + 1
            }
            let mut dep_name = rest
            if dot_pos > 0 {
                dep_name = rest.byte_slice(0, dot_pos)
            }
            let mut already = 0
            let mut ci = 0
            while ci < collected.len() {
                if collected.get(ci).unwrap() == dep_name {
                    already = 1
                    ci = collected.len()
                }
                ci = ci + 1
            }
            if already == 0 {
                collected.push(dep_name)
            }
        }
        i = i + 1
    }
    let mut di = 0
    while di < collected.len() {
        let name = collected.get(di).unwrap()
        let base = "native-dependencies.{name}"
        let mut dep_type = ""
        let mut dep_path = ""
        let mut dep_pkg_config = ""
        let mut dep_link = ""
        if toml_has("{base}.system") == 1 {
            dep_type = "system"
        }
        if toml_has("{base}.path") == 1 {
            dep_type = "vendored"
            dep_path = toml_get("{base}.path")
        }
        if toml_has("{base}.pkg-config") == 1 {
            dep_type = "pkg-config"
            dep_pkg_config = toml_get("{base}.pkg-config")
        }
        if toml_has("{base}.type") == 1 {
            dep_type = toml_get("{base}.type")
        }
        if toml_has("{base}.link") == 1 {
            dep_link = toml_get("{base}.link")
        }
        if dep_type == "" {
            dep_type = "system"
        }
        let mut hdrs: List[Str] = []
        if toml_has("{base}.headers") == 1 {
            let count = toml_get_array_len("{base}.headers")
            let mut hi = 0
            while hi < count {
                let h = toml_get_array_item("{base}.headers", hi)
                hdrs.push(h)
                declared_headers_set.insert(h, 1)
                hi = hi + 1
            }
        }
        native_dep_names.push(name)
        native_dep_types.push(dep_type)
        native_dep_paths.push(dep_path)
        native_dep_pkg_configs.push(dep_pkg_config)
        native_dep_links.push(dep_link)
        native_dep_headers.push(hdrs)
        di = di + 1
    }
}

// Look up the headers list for a native dependency by name.
// Returns empty list if the dep is not declared or has no headers.
pub fn manifest_native_dep_headers(name: Str) -> List[Str] {
    let idx = native_dep_index(name)
    if idx >= 0 { return native_dep_headers.get(idx).unwrap() }
    []
}

// Returns 1 if any declared native-dep lists this header in its
// [native-dependencies].<name>.headers list.
pub fn manifest_header_is_declared(header: Str) -> Int {
    if declared_headers_set.contains_key(header) != 0 { return 1 }
    0
}

fn manifest_warn(msg: Str) {
    manifest_warnings.push(msg)
    if manifest_print_warnings {
        io.println(msg)
    }
}

// ── Warn about unknown sections ──────────────────────────────────

fn check_unknown_sections() {
    let mut warned: List[Str] = []
    let mut i = 0
    while i < toml_keys.len() {
        let key = toml_keys.get(i).unwrap()
        // Extract top-level section name (part before first dot)
        let mut dot_pos = -1
        let mut j = 0
        while j < key.byte_len() {
            if key.byte_at(j) == 46 { // '.'
                dot_pos = j
                j = key.byte_len()
            }
            j = j + 1
        }
        let mut section = key
        if dot_pos > 0 {
            section = key.byte_slice(0, dot_pos)
        }
        // A per-load list, so a later load of the same manifest in this process warns again.
        if is_known_section(section) == 0 && !warned.contains(section) {
            manifest_warn("warning: unknown section '{section}' in manifest")
            warned.push(section)
        }
        i = i + 1
    }
}

// ── Issues ───────────────────────────────────────────────────────

fn make_issue(kind: ManifestIssueKind, section: Str, key: Str, level: Str, suggestion: Option[Str], span: TomlSpan) -> ManifestIssue {
    ManifestIssue { kind: kind, section: section, key: key, level: level, suggestion: suggestion, line: span.line, col: span.col, end_line: span.end_line, end_col: span.end_col }
}

// The name before the first `.` or `[`: `bogus` for `bogus.x` and for `bogus[0].x`.
fn top_segment(name: Str) -> Str {
    let mut j = 0
    while j < name.byte_len() {
        let c = name.byte_at(j)
        if c == 46 || c == 91 { // '.' '['
            return name.byte_slice(0, j)
        }
        j = j + 1
    }
    name
}

fn entry_type(key: Str) -> Int {
    let mut i = 0
    while i < toml_keys.len() {
        if toml_keys.get(i).unwrap() == key {
            return toml_types.get(i).unwrap()
        }
        i = i + 1
    }
    -1
}

// An array item or inline-table field belongs to the entry of its array or table, which carries
// the issue, so one bad value gives one issue.
fn is_nested_entry(key: Str) -> Bool {
    let mut j = 0
    while j < key.byte_len() {
        let c = key.byte_at(j)
        if c == 46 || c == 91 { // '.' '['
            let t = entry_type(key.byte_slice(0, j))
            if t == TOML_ARRAY || t == TOML_INLINE_TABLE {
                return true
            }
        }
        j = j + 1
    }
    false
}

fn collect_lint_issues(content: Str) {
    let prefix = "lints."
    let mut i = 0
    while i < toml_keys.len() {
        let key = toml_keys.get(i).unwrap()
        if key.starts_with(prefix) && !is_nested_entry(key) {
            let vtype = toml_types.get(i).unwrap()
            let val = toml_values.get(i).unwrap()
            let valid = vtype == TOML_STRING && (val == "off" || val == "warn" || val == "error")
            if !valid {
                let span = toml_value_spans.get(i).unwrap()
                let level = if vtype == TOML_STRING { val } else { content.byte_slice(span.start_byte, span.end_byte) }
                let name = key.byte_slice(prefix.byte_len(), key.byte_len())
                manifest_issues.push(make_issue(ManifestIssueKind.InvalidLintLevel, "lints", name, level, None, span))
            }
        }
        i = i + 1
    }
}

// Iterative two-row Levenshtein distance over bytes.
fn edit_distance(a: Str, b: Str) -> Int {
    let alen = a.byte_len()
    let blen = b.byte_len()
    if alen == 0 { return blen }
    if blen == 0 { return alen }
    let mut prev: List[Int] = []
    let mut j = 0
    while j <= blen {
        prev.push(j)
        j = j + 1
    }
    let mut i = 0
    while i < alen {
        let mut curr: List[Int] = [i + 1]
        let mut k = 0
        while k < blen {
            let cost = if a.byte_at(i) == b.byte_at(k) { 0 } else { 1 }
            let mut best = prev.get(k + 1).unwrap() + 1
            let ins = curr.get(k).unwrap() + 1
            let sub = prev.get(k).unwrap() + cost
            if ins < best { best = ins }
            if sub < best { best = sub }
            curr.push(best)
            k = k + 1
        }
        prev = curr
        i = i + 1
    }
    prev.get(blen).unwrap()
}

// The threshold of the compiler's other did-you-mean helps, max(1, len / 3) edits: a typo
// gets a suggestion and an unrelated name does not. A tie goes to the first name in the list.
fn closest_name(name: Str, keys: List[Str]) -> Option[Str] {
    let mut best_dist = -1
    let mut best = ""
    for known in keys {
        let d = edit_distance(name, known)
        if best_dist == -1 || d < best_dist {
            best_dist = d
            best = known
        }
    }
    let mut threshold = name.byte_len() / 3
    if threshold < 1 { threshold = 1 }
    if best_dist == -1 || best_dist > threshold { return None }
    Some(best)
}

fn closest_section(name: Str) -> Option[Str] {
    closest_name(name, known_sections)
}

// One issue per unknown section, at its first [header]. A section that only a top-level key
// names has no header, so the issue points at that key.
fn collect_section_issues() {
    let mut seen: List[Str] = []
    let mut h = 0
    while h < toml_headers.len() {
        let section = top_segment(toml_headers.get(h).unwrap())
        if is_known_section(section) == 0 && !seen.contains(section) {
            seen.push(section)
            manifest_issues.push(make_issue(ManifestIssueKind.UnknownManifestSection, section, "", "", closest_section(section), toml_header_spans.get(h).unwrap()))
        }
        h = h + 1
    }
    let mut i = 0
    while i < toml_keys.len() {
        let section = top_segment(toml_keys.get(i).unwrap())
        if is_known_section(section) == 0 && !seen.contains(section) {
            seen.push(section)
            manifest_issues.push(make_issue(ManifestIssueKind.UnknownManifestSection, section, "", "", closest_section(section), toml_key_spans.get(i).unwrap()))
        }
        i = i + 1
    }
}

// One issue per unknown key of a closed table. A key that a [section.key] header opens points
// at its first header; any other key points at the entry of that exact key, or at the first
// entry below it (a dotted key or an array item).
fn collect_key_issues(section: Str, keys: List[Str]) {
    let prefix = "{section}."
    let mut seen: List[Str] = []
    let mut h = 0
    while h < toml_headers.len() {
        let name = toml_headers.get(h).unwrap()
        if name.starts_with(prefix) {
            let key = top_segment(name.byte_slice(prefix.byte_len(), name.byte_len()))
            if !keys.contains(key) && !seen.contains(key) {
                seen.push(key)
                manifest_issues.push(make_issue(ManifestIssueKind.UnknownManifestKey, section, key, "", closest_name(key, keys), toml_header_spans.get(h).unwrap()))
            }
        }
        h = h + 1
    }
    let mut i = 0
    while i < toml_keys.len() {
        let full = toml_keys.get(i).unwrap()
        if full.starts_with(prefix) {
            let key = top_segment(full.byte_slice(prefix.byte_len(), full.byte_len()))
            if !keys.contains(key) && !seen.contains(key) {
                seen.push(key)
                let exact = toml_keys.index_of("{prefix}{key}") ?? i
                manifest_issues.push(make_issue(ManifestIssueKind.UnknownManifestKey, section, key, "", closest_name(key, keys), toml_key_spans.get(exact).unwrap()))
            }
        }
        i = i + 1
    }
}

fn collect_closed_table_issues() {
    for section in known_sections {
        match closed_table_keys(section) {
            Some(keys) => collect_key_issues(section, keys)
            None => {}
        }
    }
}

fn load_test_table(content: Str) {
    let i = toml_keys.index_of("test.timeout") ?? -1
    if i >= 0 {
        let span = toml_value_spans.get(i).unwrap()
        let is_string = toml_types.get(i).unwrap() == TOML_STRING
        let text = if is_string { toml_values.get(i).unwrap() } else { content.byte_slice(span.start_byte, span.end_byte) }
        manifest_test_timeout = Some(ManifestValue { text: text, is_string: is_string, span: span })
        return
    }
    // A [test.timeout] sub-table is a timeout that is not a string.
    let h = toml_headers.index_of("test.timeout") ?? -1
    if h >= 0 {
        let span = toml_header_spans.get(h).unwrap()
        manifest_test_timeout = Some(ManifestValue { text: content.byte_slice(span.start_byte, span.end_byte), is_string: false, span: span })
    }
}

fn issue_before(a: ManifestIssue, b: ManifestIssue) -> Bool {
    a.line < b.line || (a.line == b.line && a.col < b.col)
}

fn sort_issues() {
    let mut i = 1
    while i < manifest_issues.len() {
        let cur = manifest_issues.get(i).unwrap()
        let mut j = i
        while j > 0 && issue_before(cur, manifest_issues.get(j - 1).unwrap()) {
            manifest_issues.set(j, manifest_issues.get(j - 1).unwrap())
            j = j - 1
        }
        manifest_issues.set(j, cur)
        i = i + 1
    }
}

fn collect_manifest_issues(content: Str) {
    collect_lint_issues(content)
    collect_section_issues()
    collect_closed_table_issues()
    sort_issues()
}

// ── Main load function ───────────────────────────────────────────

pub fn manifest_load(path: Str) -> Int {
    manifest_clear()
    toml_clear()

    if file_exists(path) == 0 {
        io.eprintln("error: manifest file not found: {path}")
        return 1
    }

    let content = read_file(path)
    let parse_result = toml_parse(content)
    if parse_result != 0 {
        io.eprintln("error: failed to parse manifest: {path}")
        return 1
    }

    let pkg_result = load_package()
    if pkg_result != 0 {
        return 1
    }

    let dep_result = load_deps("dependencies", 0)
    if dep_result != 0 {
        return 1
    }

    let dev_dep_result = load_deps("dev-dependencies", 1)
    if dev_dep_result != 0 {
        return 1
    }

    load_capabilities()
    load_alternatives()
    load_lints()
    load_native_deps()
    load_test_table(content)
    check_unknown_sections()
    collect_manifest_issues(content)

    0
}

// ── Query functions ──────────────────────────────────────────────

pub fn manifest_dep_count() -> Int {
    dep_names.len()
}

pub fn manifest_get_dep_name(i: Int) -> Str {
    if i < 0 || i >= dep_names.len() {
        return ""
    }
    dep_names.get(i).unwrap()
}

pub fn manifest_get_dep_version(i: Int) -> Str {
    if i < 0 || i >= dep_versions.len() {
        return ""
    }
    dep_versions.get(i).unwrap()
}

pub fn manifest_get_dep_source(i: Int) -> Str {
    if i < 0 || i >= dep_names.len() {
        return ""
    }
    if dep_git_urls.get(i).unwrap() != "" {
        return "git"
    }
    if dep_paths.get(i).unwrap() != "" {
        return "path"
    }
    "registry"
}

pub fn manifest_has_dep(name: Str) -> Int {
    has_dep(name)
}

fn native_dep_index(name: Str) -> Int {
    let mut i = 0
    while i < native_dep_names.len() {
        if native_dep_names.get(i).unwrap() == name {
            return i
        }
        i = i + 1
    }
    -1
}

pub fn manifest_has_native_dep(name: Str) -> Int {
    if native_dep_index(name) >= 0 { return 1 }
    0
}

pub fn manifest_native_dep_type(name: Str) -> Str {
    let idx = native_dep_index(name)
    if idx >= 0 { return native_dep_types.get(idx).unwrap() }
    ""
}

pub fn manifest_native_dep_link(name: Str) -> Str {
    let idx = native_dep_index(name)
    if idx >= 0 { return native_dep_links.get(idx).unwrap() }
    ""
}

pub fn manifest_native_dep_count() -> Int {
    native_dep_names.len()
}

pub fn manifest_native_dep_name_at(i: Int) -> Str {
    if i < 0 || i >= native_dep_names.len() { return "" }
    native_dep_names.get(i).unwrap()
}

pub fn manifest_native_dep_path(name: Str) -> Str {
    let idx = native_dep_index(name)
    if idx >= 0 { return native_dep_paths.get(idx).unwrap() }
    ""
}
