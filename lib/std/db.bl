import std.db_row.{Row}
import std.db_error.{DBError}
import std.db_stmt.{Stmt}
import std.db_sqlite.{Sqlite3, sqlite_handler, sqlite_close}

pub effect DB {
    effect Read {
        fn query(sql: Template[DB]) -> Result[List[Row], DBError]
        fn query_one(sql: Template[DB]) -> Result[Option[Row], DBError]
        fn prepare(sql: Template[DB]) -> Result[Stmt, DBError]
    }
    effect Write {
        fn exec(sql: Template[DB]) -> Result[Void, DBError]
        fn execute(sql: Template[DB]) -> Result[Int, DBError]
        fn begin() -> Result[Void, DBError]
        fn commit() -> Result[Void, DBError]
        fn rollback() -> Result[Void, DBError]
    }
}

// --- Connection (scoped effect handler) ---

@ffi("blink_sqlite3_open")
@trusted(audit: "STD-DB-SQLITE")
/// Open a SQLite database. The shim returns NULL on failure, which reads as None.
fn sqlite_open_or_none(path: Str) -> Option[Sqlite3] ! FFI {}

/// An open SQLite database. `with db.connect(path)? { ... }` installs its DB handler for the
/// block and closes the database after it.
pub type Connection {
    handle: Sqlite3
}

impl BlockHandler for Connection {
    type Context = Handler[DB]

    fn enter(self) -> Handler[DB] {
        sqlite_handler(self.handle)
    }

    // The handler this item installed is gone by now, so db.* here reaches the outer DB.
    fn exit(self, _ok: Bool) {
        sqlite_close(self.handle)
    }
}

/// Open the SQLite database at `path`, or report `ConnectionError` when it cannot be opened.
pub fn connect(path: Str) -> Result[Connection, DBError] {
    match sqlite_open_or_none(path) {
        Some(handle) => Ok(Connection { handle: handle })
        None => Err(DBError.ConnectionError("cannot open database at {path}"))
    }
}
