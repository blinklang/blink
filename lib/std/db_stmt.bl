import std.db.{DB}
import std.db_error.{DBError}

pub let STEP_ROW: Int = 100
pub let STEP_DONE: Int = 101

/// A prepared statement: a token that the DB handler makes in `prepare`
/// (sections/04_effects.md §4.4.10). The handler keeps the real statement, so code reads no
/// field of a `Stmt`, and every method performs a `DB` operation.
@runtime("blink_db_stmt")
pub type Stmt

/// `Stmt.new()`: a new token, `==` to no other token. The token names no handler, so a
/// handler that must refuse a foreign token keeps a record of the tokens that it made.
/// `State` is in the row so that no compiler merges two calls into one token.
@runtime("blink_db_stmt_fresh")
@trusted(audit: "STD-DB-STMT")
pub fn Stmt_new() -> Stmt ! State

@runtime("blink_db_stmt_serial")
@trusted(audit: "STD-DB-STMT")
fn stmt_serial(s: Stmt) -> Int

@runtime("blink_db_stmt_hash")
@trusted(audit: "STD-DB-STMT")
fn stmt_hash(s: Stmt) -> U64

impl Eq for Stmt {
    fn eq(self, other: Stmt) -> Bool {
        stmt_serial(self) == stmt_serial(other)
    }
}

impl Hash for Stmt {
    fn hash(self) -> U64 {
        stmt_hash(self)
    }
}

// The text holds no serial, so no program can read one out of a token.
impl Debug for Stmt {
    fn debug(_self) -> Str {
        "Stmt(fresh)"
    }
}

pub trait StmtOps {
    fn bind_int(self, idx: Int, val: Int) -> Result[Void, DBError] ! DB.Read
    fn bind_text(self, idx: Int, val: Str) -> Result[Void, DBError] ! DB.Read
    fn step(self) -> Result[Int, DBError] ! DB.Write
    fn column_int(self, idx: Int) -> Int ! DB.Read
    fn column_text(self, idx: Int) -> Str ! DB.Read
    fn reset(self) -> Result[Void, DBError] ! DB.Read
    fn finalize(self) -> Result[Void, DBError] ! DB.Read
}

impl StmtOps for Stmt {
    fn bind_int(self, idx: Int, val: Int) -> Result[Void, DBError] ! DB.Read {
        db.bind_int(self, idx, val)
    }

    fn bind_text(self, idx: Int, val: Str) -> Result[Void, DBError] ! DB.Read {
        db.bind_text(self, idx, val)
    }

    fn step(self) -> Result[Int, DBError] ! DB.Write {
        db.step(self)
    }

    fn column_int(self, idx: Int) -> Int ! DB.Read {
        db.column_int(self, idx)
    }

    fn column_text(self, idx: Int) -> Str ! DB.Read {
        db.column_text(self, idx)
    }

    fn reset(self) -> Result[Void, DBError] ! DB.Read {
        db.reset(self)
    }

    fn finalize(self) -> Result[Void, DBError] ! DB.Read {
        db.finalize(self)
    }
}

impl Closeable for Stmt {
    fn close(self) ! DB.Read {
        let _ = self.finalize()
    }
}
