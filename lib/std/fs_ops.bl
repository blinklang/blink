// The Result[T, FsError] surface for filesystem operations. Each wrapper calls a
// raw fs op — which records errno via fs.errno() (0 = success) instead of
// exiting — and turns a nonzero errno into Err(FsError{op, path, code}), the same
// way http_do_request turns a raw socket failure into Err(NetError). The public
// fs.read/write/list_dir/delete surface redirects codegen here; the wrappers call
// the raw free-fn layer (read_file/write_file/list_dir/fs_remove) so the redirect
// does not recurse back through the signed methods.
import std.fs_error.{FsError, FsOp}
import std.errno.{Errno}

pub fn fs_do_read(path: Str) -> Result[Str, FsError] ! FS.Read {
    let content = read_file(path)
    let code = fs.errno()
    if code != 0 {
        return Err(FsError { op: FsOp.Read, path: path, code: Errno(code) })
    }
    Ok(content)
}

pub fn fs_do_write(path: Str, content: Str) -> Result[Void, FsError] ! FS.Write {
    write_file(path, content)
    let code = fs.errno()
    if code != 0 {
        return Err(FsError { op: FsOp.Write, path: path, code: Errno(code) })
    }
    Ok()
}

pub fn fs_do_list_dir(path: Str) -> Result[List[Str], FsError] ! FS.Read {
    let entries = list_dir(path)
    let code = fs.errno()
    if code != 0 {
        return Err(FsError { op: FsOp.ListDir, path: path, code: Errno(code) })
    }
    Ok(entries)
}

pub fn fs_do_delete(path: Str) -> Result[Void, FsError] ! FS.Delete {
    fs_remove(path)
    let code = fs.errno()
    if code != 0 {
        return Err(FsError { op: FsOp.Delete, path: path, code: Errno(code) })
    }
    Ok()
}
