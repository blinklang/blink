import std.http_types.{UrlParts, Request, Response, request_new, request_with_body}
import std.net_error.{NetError}
import std.net_tcp.{tcp_connect}
import std.num.{parse_int}
import std.sb.{sb_write_int}

fn hex_char_val(c: Int) -> Int {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 97 && c <= 102 { return c - 87 }
    if c >= 65 && c <= 70 { return c - 55 }
    -1
}

fn parse_hex(s: Str) -> Int {
    let slen = s.len()
    let mut result = 0
    let mut i = 0
    while i < slen {
        let v = hex_char_val(s.byte_at(i).to_int())
        if v < 0 { break }
        result = result * 16 + v
        i = i + 1
    }
    result
}

pub fn parse_url(url: Str) -> Result[UrlParts, NetError] {
    let mut p = url
    let scheme = "http"
    if p.starts_with("https://") {
        return Err(NetError.TlsError("HTTPS not supported"))
    }
    if p.starts_with("http://") {
        p = p.byte_slice(7, p.len())
    }
    let mut host_port = p
    let mut path = "/"
    match p.byte_index_of("/", 0) {
        Some(slash_idx) => {
            host_port = p.byte_slice(0, slash_idx)
            path = p.byte_slice(slash_idx, p.len())
        }
        None => {}
    }
    let mut host = host_port
    let mut port = 80
    match host_port.byte_index_of(":", 0) {
        Some(colon_idx) => {
            host = host_port.byte_slice(0, colon_idx)
            let port_str = host_port.byte_slice(colon_idx + 1, host_port.len())
            port = port_str.to_int()
        }
        None => {}
    }
    if host.is_empty() {
        return Err(NetError.InvalidUrl("empty host"))
    }
    Ok(UrlParts { scheme: scheme, host: host, port: port, path: path })
}

pub fn format_request(req: Request, host: Str, path: Str) -> Str {
    let sb = StringBuilder.new()
    sb.write(req.method)
    sb.write(" ")
    sb.write(path)
    sb.write(" HTTP/1.1\r\nHost: ")
    sb.write(host)
    sb.write("\r\n")
    let mut has_content_length = false
    let mut has_connection = false
    let keys = req.headers.keys()
    let mut i = 0
    while i < keys.len() {
        let k = keys.get(i).unwrap()
        let v = req.headers.get(k).unwrap()
        sb.write(k)
        sb.write(": ")
        sb.write(v)
        sb.write("\r\n")
        let kl = k.to_lower()
        if kl == "content-length" {
            has_content_length = true
        }
        if kl == "connection" {
            has_connection = true
        }
        i = i + 1
    }
    if req.body.len() > 0 && !has_content_length {
        sb.write("Content-Length: ")
        sb_write_int(sb, req.body.len())
        sb.write("\r\n")
    }
    if !has_connection {
        sb.write("Connection: close\r\n")
    }
    sb.write("\r\n")
    if req.body.len() > 0 {
        sb.write(req.body)
    }
    sb.to_str()
}

// Chunk sizes count bytes and a chunk may end inside a character, so the body is
// rebuilt byte by byte and checked as UTF-8 only once it is whole.
fn decode_chunked(raw: Str) -> Result[Str, NetError] {
    let mut out = Bytes.new()
    let rlen = raw.len()
    let mut cursor = 0
    while cursor < rlen {
        let mut crlf = cursor
        while crlf + 1 < rlen && !(raw.byte_at(crlf) == 13 && raw.byte_at(crlf + 1) == 10) {
            crlf = crlf + 1
        }
        if crlf + 1 >= rlen { break }
        let mut h = cursor
        while h < crlf && (raw.byte_at(h) == 32 || raw.byte_at(h) == 9) {
            h = h + 1
        }
        let mut chunk_size = 0
        while h < crlf && hex_char_val(raw.byte_at(h).to_int()) >= 0 {
            chunk_size = chunk_size * 16 + hex_char_val(raw.byte_at(h).to_int())
            h = h + 1
        }
        if chunk_size <= 0 { break }
        let data_start = crlf + 2
        let data_end = if data_start + chunk_size > rlen { rlen } else { data_start + chunk_size }
        let mut i = data_start
        while i < data_end {
            out.push(raw.byte_at(i).to_int())
            i = i + 1
        }
        cursor = data_end
        if cursor + 2 <= rlen && raw.byte_at(cursor) == 13 && raw.byte_at(cursor + 1) == 10 {
            cursor = cursor + 2
        }
    }
    match out.to_str() {
        Ok(body) => Ok(body)
        Err(_) => Err(NetError.ProtocolError("chunked body is not valid UTF-8"))
    }
}

pub fn parse_response(raw: Str) -> Result[Response, NetError] {
    let hdr_end_idx = match raw.byte_index_of("\r\n\r\n", 0) {
        Some(i) => i
        None => { return Err(NetError.ProtocolError("malformed HTTP response")) }
    }
    let header_section = raw.byte_slice(0, hdr_end_idx)
    let body_start = hdr_end_idx + 4
    let body_raw = raw.byte_slice(body_start, raw.len())

    let first_crlf = header_section.byte_index_of("\r\n", 0)
    let status_line = header_section.byte_slice(0, first_crlf ?? header_section.len())

    let mut status_code = 0
    if status_line.len() > 12 && status_line.starts_with("HTTP/") {
        match status_line.byte_index_of(" ", 0) {
            Some(space_idx) => {
                let after_space = status_line.byte_slice(space_idx + 1, status_line.len())
                let code_str = match after_space.byte_index_of(" ", 0) {
                    Some(space2) => after_space.byte_slice(0, space2)
                    None => after_space
                }
                status_code = parse_int(code_str)
            }
            None => {}
        }
    }

    let mut hdrs: Map[Str, Str] = Map()
    match first_crlf {
        Some(crlf) => {
            let hdr_lines_str = header_section.byte_slice(crlf + 2, header_section.len())
            let hdr_lines = hdr_lines_str.split("\r\n")
            let mut i = 0
            while i < hdr_lines.len() {
                let line = hdr_lines.get(i).unwrap()
                match line.byte_index_of(":", 0) {
                    Some(colon_idx) => {
                        if colon_idx > 0 {
                            let key = line.byte_slice(0, colon_idx).to_lower()
                            let mut val = line.byte_slice(colon_idx + 1, line.len())
                            if val.len() > 0 && val.byte_at(0) == 32 {
                                val = val.byte_slice(1, val.len())
                            }
                            hdrs.insert(key, val)
                        }
                    }
                    None => {}
                }
                i = i + 1
            }
        }
        None => {}
    }

    let mut body = body_raw
    let te = hdrs.get("transfer-encoding") ?? ""
    if te != "" && te.contains("chunked") {
        body = match decode_chunked(body_raw) {
            Ok(b) => b
            Err(e) => { return Err(e) }
        }
    }

    Ok(Response { status: status_code, body: body, headers: hdrs })
}

pub fn http_do_request(req: Request) -> Result[Response, NetError] ! Net.Connect, Net.DNS {
    let url_result = parse_url(req.url)
    if url_result.is_err() {
        return Err(url_result.unwrap_err())
    }
    let parts = url_result.unwrap()

    let connect_result = tcp_connect(parts.host, parts.port)
    if connect_result.is_err() {
        return Err(connect_result.unwrap_err())
    }
    let sock = connect_result.unwrap()

    if req.timeout_ms > 0 {
        sock.set_timeout(req.timeout_ms)
    }

    let request_str = format_request(req, parts.host, parts.path)
    sock.write(request_str)

    let raw = sock.read_all()
    sock.close()

    if raw.is_empty() {
        return Err(NetError.ProtocolError("empty response"))
    }

    parse_response(raw)
}

/// Make a GET request
pub fn get(url: Str) -> Result[Response, NetError] ! Net.Connect, Net.DNS {
    let req = request_new("GET", url)
    http_do_request(req)
}

/// Make a POST request with body
pub fn post(url: Str, body: Str) -> Result[Response, NetError] ! Net.Connect, Net.DNS {
    let req = request_new("POST", url)
    let req2 = request_with_body(req, body)
    http_do_request(req2)
}

/// Make a PUT request with body
pub fn put(url: Str, body: Str) -> Result[Response, NetError] ! Net.Connect, Net.DNS {
    let req = request_new("PUT", url)
    let req2 = request_with_body(req, body)
    http_do_request(req2)
}

/// Make a DELETE request
pub fn delete(url: Str) -> Result[Response, NetError] ! Net.Connect, Net.DNS {
    let req = request_new("DELETE", url)
    http_do_request(req)
}

/// Make a HEAD request
pub fn head(url: Str) -> Result[Response, NetError] ! Net.Connect, Net.DNS {
    let req = request_new("HEAD", url)
    http_do_request(req)
}

/// Make an HTTP request from a Request struct
pub fn request(req: Request) -> Result[Response, NetError] ! Net.Connect, Net.DNS {
    http_do_request(req)
}
