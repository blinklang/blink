// std.io — derived I/O combinators in ordinary Blink.
//
// `read_fully` loops `libc.read_bytes` until exactly `n` bytes are read or EOF.
// It is a pure-Blink combinator: no syscall and no FFI bridge crossing of its own
// (it only calls `read_bytes`, which owns the single `read(2)` crossing). This
// preserves the "`libc.*` is exactly one syscall, 1:1" invariant (§9.1.3.3).
//
// Spec: sections/07_trust_modules_metadata.md §9.1.3.3;
//       decisions/libc-bytes-wrapper-coverage.md.

import std.libc.{read_bytes, ERR_INVAL}
import std.errno.{Errno}

// Read exactly `n` bytes from `fd`, looping over `libc.read_bytes` until `n`
// bytes are accumulated or EOF (a 0-length read) is reached.
//
// Unlike `read_bytes`, a short read is NOT returned — `read_fully` keeps looping.
// The returned `Bytes.len()` is fewer than `n` only on EOF before `n` bytes
// arrived; that is still `Ok` (caller inspects `.len()`). A `-1` syscall return
// propagates as `Err(Errno(code))` via `?`.
pub fn read_fully(fd: Int, n: Int) -> Result[Bytes, Errno] ! IO {
    if n < 0 {
        return Err(Errno(ERR_INVAL))
    }
    let mut acc = Bytes.new()
    while acc.len() < n {
        let remaining = n - acc.len()
        let chunk = read_bytes(fd, remaining)?
        if chunk.len() == 0 {
            return Ok(acc)
        }
        acc = acc.concat(chunk)
    }
    Ok(acc)
}
