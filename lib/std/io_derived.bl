// The bodies of the derived IO operations (sections/04_effects.md §4.4 and §4.4.9), as the
// spec writes them. A handler that omits one runs its body here over its own operations: the
// compiler points the omitted slot at a function that calls the body with the handler
// installed. The default handler answers each operation itself and gives the same results.
// All are private: user code reaches them only through the io calls of the same names (§4.7.1).

/// Writes `s` as it is, through print_no_nl.
fn print_raw(s: Str) ! IO.Print {
    io.print(s)
}

/// Writes `s` as it is to stderr, through eprint_no_nl.
fn eprint_raw(s: Str) ! IO.Eprint {
    io.eprint(s)
}

/// The next line without its terminator, or None at end of input.
fn read_line() -> Option[Str] ! IO.Read {
    let mut line = Bytes.new()
    loop {
        let b = io.read_bytes(1)
        if b.is_empty() {
            if line.is_empty() { return None }
            break
        }
        if b.get(0) == Some(10) {
            let n = line.len()
            if n > 0 && line.get(n - 1) == Some(13) {
                line = line.slice(0, n - 1)
            }
            break
        }
        line = line.concat(b)
    }
    match line.to_str() {
        Ok(s) => Some(s)
        Err(_) => panic("io.read_line: input is not valid UTF-8; read it with io.read_bytes")
    }
}

/// All of the input that is left. Empty at end of input.
fn read_all() -> Str ! IO.Read {
    let mut all = Bytes.new()
    loop {
        let chunk = io.read_bytes(65536)
        all = all.concat(chunk)
        if chunk.len() < 65536 { break }
    }
    match all.to_str() {
        Ok(s) => s
        Err(_) => panic("io.read_all: input is not valid UTF-8; read it with io.read_bytes")
    }
}
