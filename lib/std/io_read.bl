// The bodies of the two derived operations of IO.Read (sections/04_effects.md §4.4.9), as
// the spec writes them. A handler for IO.Read that omits read_line or read_all runs these
// over its own read_bytes: the compiler points the omitted slot at a function that calls the
// body here with the handler installed. The default handler answers all three operations
// from its own buffer and gives the same results.

/// The next line without its terminator, or None at end of input.
pub fn read_line() -> Option[Str] ! IO.Read {
    let mut line = Bytes.new()
    loop {
        let b = io.read_bytes(1)
        if b.is_empty() {
            if line.is_empty() { return None }
            break
        }
        if b.get(0) == Some(10) {
            let n = line.len()
            if n > 0 && line.get(n - 1) == Some(13) {
                line = line.slice(0, n - 1)
            }
            break
        }
        line = line.concat(b)
    }
    match line.to_str() {
        Ok(s) => Some(s)
        Err(_) => panic("io.read_line: input is not valid UTF-8; read it with io.read_bytes")
    }
}

/// All of the input that is left. Empty at end of input.
pub fn read_all() -> Str ! IO.Read {
    let mut all = Bytes.new()
    loop {
        let chunk = io.read_bytes(65536)
        all = all.concat(chunk)
        if chunk.len() < 65536 { break }
    }
    match all.to_str() {
        Ok(s) => s
        Err(_) => panic("io.read_all: input is not valid UTF-8; read it with io.read_bytes")
    }
}
