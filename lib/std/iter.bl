// Iterator[T] is a recipe: calling it starts a fresh cursor, and each cursor call yields
// the next element or None. A copy of an Iterator shares the recipe, never a position,
// so every consumer starts over (sections/03c_protocols.md).
//
// Nothing here is pub. The compiler routes each Iterator method to the generic named
// `iter_<method>`, the way it routes the sealed List methods to `list_<method>`, and
// `into_iter` to `iter_from_<receiver>`; `iter_from_str` and the `iter_from_range_<bound>`
// fns are not generic.

// The two views between the sealed carrier and the recipe it holds. Both are one closure
// pointer in C, so the compiler lowers each call to its argument and emits no symbol.
@ffi("blink_iter_recipe")
@trusted(audit: "STD-ITER")
fn iter_recipe[T](it: Iterator[T]) -> fn() -> fn() -> Option[T] ! () {}

@ffi("blink_iter_of")
@trusted(audit: "STD-ITER")
fn iter_of[T](r: fn() -> fn() -> Option[T]) -> Iterator[T] ! () {}

// The list is read at each pull, not copied, so a consumer sees the list as it is then.
fn iter_from_list[T](xs: List[T]) -> Iterator[T] {
    iter_of(fn() -> fn() -> Option[T] {
        let mut i = 0
        fn() -> Option[T] {
            if i >= xs.len() { return None }
            let v = xs.get(i)
            i = i + 1
            v
        }
    })
}

// A Set has no position to read at, so each cursor takes its own snapshot on start.
fn iter_from_set[T](s: Set[T]) -> Iterator[T] {
    iter_of(fn() -> fn() -> Option[T] {
        let mut xs: List[T] = []
        for x in s {
            xs.push(x)
        }
        let mut i = 0
        fn() -> Option[T] {
            if i >= xs.len() { return None }
            let v = xs.get(i)
            i = i + 1
            v
        }
    })
}

// The runtime decoder a `for c in s` loop calls, so both walks read the same Chars: each
// step answers the next byte position and the Char before it, or -1 at the end.
@ffi("blink_str_char_step")
@trusted(audit: "STD-ITER")
fn iter_str_char_step(s: Str, pos: Int) -> Int ! () {}

@ffi("blink_str_step_char")
@trusted(audit: "STD-ITER")
fn iter_str_step_char(step: Int) -> Char ! () {}

// A Str is immutable, so each cursor walks it in place from byte 0.
fn iter_from_str(s: Str) -> Iterator[Char] {
    iter_of(fn() -> fn() -> Option[Char] {
        let mut pos = 0
        fn() -> Option[Char] {
            let step = iter_str_char_step(s, pos)
            if step < 0 { return None }
            pos = step >> 21
            Some(iter_str_step_char(step))
        }
    })
}

// A range steps by its own integer type, which a generic body cannot add 1 to, so each
// bound type passes its step in. A step runs only below the end, so it never overflows.
fn iter_range_walk[T: Ord](r: Range[T], step: fn(T) -> T) -> Iterator[T] {
    let (lo, hi, inclusive) = range_bounds(r)
    iter_of(fn() -> fn() -> Option[T] {
        let mut cur = lo
        let mut done = if inclusive { lo > hi } else { lo >= hi }
        fn() -> Option[T] {
            if done { return None }
            let v = cur
            if inclusive && cur == hi {
                done = true
            } else {
                cur = step(cur)
                if !inclusive && cur >= hi { done = true }
            }
            Some(v)
        }
    })
}

fn iter_from_range_int(r: Range[Int]) -> Iterator[Int] { iter_range_walk(r, fn(x: Int) -> Int { x + 1 }) }

fn iter_from_range_i8(r: Range[I8]) -> Iterator[I8] { iter_range_walk(r, fn(x: I8) -> I8 { x + 1 }) }

fn iter_from_range_i16(r: Range[I16]) -> Iterator[I16] { iter_range_walk(r, fn(x: I16) -> I16 { x + 1 }) }

fn iter_from_range_i32(r: Range[I32]) -> Iterator[I32] { iter_range_walk(r, fn(x: I32) -> I32 { x + 1 }) }

fn iter_from_range_u8(r: Range[U8]) -> Iterator[U8] { iter_range_walk(r, fn(x: U8) -> U8 { x + 1 }) }

fn iter_from_range_u16(r: Range[U16]) -> Iterator[U16] { iter_range_walk(r, fn(x: U16) -> U16 { x + 1 }) }

fn iter_from_range_u32(r: Range[U32]) -> Iterator[U32] { iter_range_walk(r, fn(x: U32) -> U32 { x + 1 }) }

fn iter_from_range_u64(r: Range[U64]) -> Iterator[U64] { iter_range_walk(r, fn(x: U64) -> U64 { x + 1 }) }

fn iter_map[T, U](it: Iterator[T], f: fn(T) -> U) -> Iterator[U] {
    let src = iter_recipe(it)
    iter_of(fn() -> fn() -> Option[U] {
        let next = src()
        fn() -> Option[U] {
            match next() {
                Some(v) => Some(f(v))
                None => None
            }
        }
    })
}

fn iter_filter[T](it: Iterator[T], f: fn(T) -> Bool) -> Iterator[T] {
    let src = iter_recipe(it)
    iter_of(fn() -> fn() -> Option[T] {
        let next = src()
        fn() -> Option[T] {
            loop {
                match next() {
                    Some(v) => { if f(v) { return Some(v) } }
                    None => { return None }
                }
            }
            None
        }
    })
}

fn iter_take[T](it: Iterator[T], n: Int) -> Iterator[T] {
    let src = iter_recipe(it)
    iter_of(fn() -> fn() -> Option[T] {
        let next = src()
        let mut left = n
        fn() -> Option[T] {
            if left <= 0 { return None }
            left = left - 1
            next()
        }
    })
}

fn iter_skip[T](it: Iterator[T], n: Int) -> Iterator[T] {
    let src = iter_recipe(it)
    iter_of(fn() -> fn() -> Option[T] {
        let next = src()
        let mut owed = n
        fn() -> Option[T] {
            while owed > 0 {
                owed = owed - 1
                if next().is_none() { return None }
            }
            next()
        }
    })
}

fn iter_chain[T](it: Iterator[T], other: Iterator[T]) -> Iterator[T] {
    let first = iter_recipe(it)
    let second = iter_recipe(other)
    iter_of(fn() -> fn() -> Option[T] {
        let a = first()
        let b = second()
        let mut on_b = false
        fn() -> Option[T] {
            if !on_b {
                match a() {
                    Some(v) => { return Some(v) }
                    None => { on_b = true }
                }
            }
            b()
        }
    })
}

fn iter_enumerate[T](it: Iterator[T]) -> Iterator[(Int, T)] {
    let src = iter_recipe(it)
    iter_of(fn() -> fn() -> Option[(Int, T)] {
        let next = src()
        let mut i = 0
        fn() -> Option[(Int, T)] {
            match next() {
                Some(v) => {
                    let at = i
                    i = i + 1
                    Some((at, v))
                }
                None => None
            }
        }
    })
}

fn iter_zip[T, U](it: Iterator[T], other: Iterator[U]) -> Iterator[(T, U)] {
    let left = iter_recipe(it)
    let right = iter_recipe(other)
    iter_of(fn() -> fn() -> Option[(T, U)] {
        let a = left()
        let b = right()
        fn() -> Option[(T, U)] {
            match a() {
                Some(x) => {
                    match b() {
                        Some(y) => Some((x, y))
                        None => None
                    }
                }
                None => None
            }
        }
    })
}

fn iter_flat_map[T, U](it: Iterator[T], f: fn(T) -> Iterator[U]) -> Iterator[U] {
    let src = iter_recipe(it)
    iter_of(fn() -> fn() -> Option[U] {
        let outer = src()
        let mut inner: fn() -> Option[U] = fn() -> Option[U] { None }
        fn() -> Option[U] {
            loop {
                match inner() {
                    Some(v) => { return Some(v) }
                    None => {
                        match outer() {
                            Some(x) => { inner = iter_recipe(f(x))() }
                            None => { return None }
                        }
                    }
                }
            }
            None
        }
    })
}

fn iter_collect[T](it: Iterator[T]) -> List[T] {
    let next = iter_recipe(it)()
    let mut out: List[T] = []
    loop {
        match next() {
            Some(v) => out.push(v)
            None => { return out }
        }
    }
    out
}

fn iter_count[T](it: Iterator[T]) -> Int {
    let next = iter_recipe(it)()
    let mut n = 0
    while next().is_some() {
        n = n + 1
    }
    n
}

fn iter_for_each[T](it: Iterator[T], f: fn(T) -> Void) {
    let next = iter_recipe(it)()
    loop {
        match next() {
            Some(v) => f(v)
            None => { return }
        }
    }
}

fn iter_any[T](it: Iterator[T], f: fn(T) -> Bool) -> Bool {
    let next = iter_recipe(it)()
    loop {
        match next() {
            Some(v) => { if f(v) { return true } }
            None => { return false }
        }
    }
    false
}

fn iter_all[T](it: Iterator[T], f: fn(T) -> Bool) -> Bool {
    let next = iter_recipe(it)()
    loop {
        match next() {
            Some(v) => { if !f(v) { return false } }
            None => { return true }
        }
    }
    true
}

fn iter_find[T](it: Iterator[T], f: fn(T) -> Bool) -> Option[T] {
    let next = iter_recipe(it)()
    loop {
        match next() {
            Some(v) => { if f(v) { return Some(v) } }
            None => { return None }
        }
    }
    None
}

fn iter_fold[T, A](it: Iterator[T], init: A, f: fn(A, T) -> A) -> A {
    let next = iter_recipe(it)()
    let mut acc = init
    loop {
        match next() {
            Some(v) => { acc = f(acc, v) }
            None => { return acc }
        }
    }
    acc
}
