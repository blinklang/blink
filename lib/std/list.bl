/// Transform each element of a list using a function.
pub fn list_map[T, U](ls: List[T], f: fn(T) -> U) -> List[U] {
    let mut _r: List[U] = []
    let mut _i = 0
    while _i < ls.len() {
        _r.push(f(ls.get(_i).unwrap()))
        _i = _i + 1
    }
    _r
}

/// Return a new list containing only elements that satisfy the predicate.
pub fn list_filter[T](ls: List[T], f: fn(T) -> Bool) -> List[T] {
    let mut _r: List[T] = []
    let mut _i = 0
    while _i < ls.len() {
        let _v = ls.get(_i).unwrap()
        if f(_v) {
            _r.push(_v)
        }
        _i = _i + 1
    }
    _r
}

/// Reduce a list to a single value by applying a function with an accumulator.
pub fn list_fold[T, U](ls: List[T], init: U, f: fn(U, T) -> U) -> U {
    let mut _a = init
    let mut _i = 0
    while _i < ls.len() {
        _a = f(_a, ls.get(_i).unwrap())
        _i = _i + 1
    }
    _a
}

/// Return true if any element satisfies the predicate.
pub fn list_any[T](ls: List[T], f: fn(T) -> Bool) -> Bool {
    let mut _i = 0
    while _i < ls.len() {
        if f(ls.get(_i).unwrap()) {
            return true
        }
        _i = _i + 1
    }
    false
}

/// Return true if all elements satisfy the predicate.
pub fn list_all[T](ls: List[T], f: fn(T) -> Bool) -> Bool {
    let mut _i = 0
    while _i < ls.len() {
        if !f(ls.get(_i).unwrap()) {
            return false
        }
        _i = _i + 1
    }
    true
}

/// Call a function for each element (side effects only, no return value).
pub fn list_for_each[T](ls: List[T], f: fn(T) -> Void) {
    let mut _i = 0
    while _i < ls.len() {
        f(ls.get(_i).unwrap())
        _i = _i + 1
    }
}

/// Concatenate two lists into a new list.
@ffi("blink_list_concat")
@trusted(audit: "STD-LIST")
pub fn list_concat[T](a: List[T], b: List[T]) -> List[T] ! () {}

/// Return a sublist from start (inclusive) to end (exclusive).
@ffi("blink_list_slice")
@trusted(audit: "STD-LIST")
pub fn list_slice[T](ls: List[T], start: Int, end: Int) -> List[T] ! () {}

@ffi("blink_list_len")
@trusted(audit: "STD-LIST")
fn list_len[T](l: List[T]) -> Int ! () {}

@ffi("blink_list_capacity")
@trusted(audit: "STD-LIST")
fn list_capacity[T](l: List[T]) -> Int ! () {}

@ffi("blink_list_clear")
@trusted(audit: "STD-LIST")
fn list_clear[T](l: List[T]) ! () {}

impl[T] Sized for List[T] {
    fn len(self) -> Int { list_len(self) }
    fn is_empty(self) -> Bool { self.len() == 0 }
}

pub trait ListPure {
    fn clear(self)
}

impl[T] ListPure for List[T] {
    fn clear(self) { list_clear(self) }
}

/// Drop the first n elements, keeping the rest.
pub fn list_skip[T](ls: List[T], n: Int) -> List[T] {
    list_slice(ls, n, list_len(ls))
}

/// Pair each element with its index.
pub fn list_enumerate[T](ls: List[T]) -> List[(Int, T)] {
    let mut _r: List[(Int, T)] = []
    let mut _i = 0
    while _i < ls.len() {
        _r.push((_i, ls.get(_i).unwrap()))
        _i = _i + 1
    }
    _r
}

/// Pair elements from two lists by position, stopping at the shorter one.
pub fn list_zip[T, U](a: List[T], b: List[U]) -> List[(T, U)] {
    let mut _r: List[(T, U)] = []
    let mut _i = 0
    let n = if a.len() < b.len() { a.len() } else { b.len() }
    while _i < n {
        _r.push((a.get(_i).unwrap(), b.get(_i).unwrap()))
        _i = _i + 1
    }
    _r
}

/// Return the first element satisfying the predicate.
pub fn list_find[T](ls: List[T], f: fn(T) -> Bool) -> Option[T] {
    let mut _i = 0
    while _i < ls.len() {
        let _v = ls.get(_i).unwrap()
        if f(_v) {
            return Some(_v)
        }
        _i = _i + 1
    }
    None
}

/// Map each element to a list, then flatten the results into one list.
pub fn list_flat_map[T, U](ls: List[T], f: fn(T) -> List[U]) -> List[U] {
    let mut _r: List[U] = []
    let mut _i = 0
    while _i < ls.len() {
        let sub = f(ls.get(_i).unwrap())
        let mut _j = 0
        while _j < sub.len() {
            _r.push(sub.get(_j).unwrap())
            _j = _j + 1
        }
        _i = _i + 1
    }
    _r
}

/// A sorted copy of the list, in the order `cmp` gives. Stable: elements that compare
/// `Equal` keep their input order. The receiver is not changed.
pub fn list_sort_by[T](ls: List[T], cmp: fn(T, T) -> Ordering) -> List[T] {
    let n = ls.len()
    // Lay each run the input already has into `src` in ascending order, and note where it
    // ends. A descending run is taken only when strictly descending, so reversing it cannot
    // reorder two elements that compare Equal.
    let mut src: List[T] = []
    let mut ends: List[Int] = []
    let mut i = 0
    while i < n {
        let start = i
        i = i + 1
        if i < n && cmp(ls.get(i - 1).unwrap(), ls.get(i).unwrap()) == Ordering.Greater {
            while i < n && cmp(ls.get(i - 1).unwrap(), ls.get(i).unwrap()) == Ordering.Greater { i = i + 1 }
            let mut j = i
            while j > start {
                j = j - 1
                src.push(ls.get(j).unwrap())
            }
        } else {
            while i < n && cmp(ls.get(i - 1).unwrap(), ls.get(i).unwrap()) != Ordering.Greater { i = i + 1 }
            let mut j = start
            while j < i {
                src.push(ls.get(j).unwrap())
                j = j + 1
            }
        }
        ends.push(i)
    }
    // Merge neighbouring runs pass by pass into a fresh buffer. Every loop is bounded by
    // indices alone, so a comparator that breaks the Ord laws still ends, with each element
    // once. Taking the right element only when it is strictly Less keeps the sort stable.
    while ends.len() > 1 {
        let mut dst: List[T] = []
        let mut next_ends: List[Int] = []
        let mut r = 0
        let mut lo = 0
        while r < ends.len() {
            let mid = ends.get(r).unwrap()
            let hi = if r + 1 < ends.len() { ends.get(r + 1).unwrap() } else { mid }
            let mut a = lo
            let mut b = mid
            while a < mid && b < hi {
                let left = src.get(a).unwrap()
                let right = src.get(b).unwrap()
                if cmp(right, left) == Ordering.Less {
                    dst.push(right)
                    b = b + 1
                } else {
                    dst.push(left)
                    a = a + 1
                }
            }
            while a < mid {
                dst.push(src.get(a).unwrap())
                a = a + 1
            }
            while b < hi {
                dst.push(src.get(b).unwrap())
                b = b + 1
            }
            next_ends.push(hi)
            lo = hi
            r = r + 2
        }
        src = dst
        ends = next_ends
    }
    src
}

/// A sorted copy of the list, in the element's `Ord` order. Stable, as `list_sort_by` is.
pub fn list_sort[T: Ord](ls: List[T]) -> List[T] {
    list_sort_by(ls, fn(a: T, b: T) -> Ordering { a.cmp(b) })
}
