@ffi("blink_map_has")
@trusted
fn map_has[K, V](m: Map[K, V], key: Str) -> Int ! FFI {}

@ffi("blink_map_remove")
@trusted
fn map_remove[K, V](m: Map[K, V], key: Str) -> Int ! FFI {}

@ffi("blink_map_len")
@trusted
fn map_len[K, V](m: Map[K, V]) -> Int ! FFI {}

@ffi("blink_map_clear")
@trusted
fn map_clear[K, V](m: Map[K, V]) ! FFI {}

/// Call a function for each key-value pair in the map.
pub fn map_for_each[K, V](m: Map[K, V], f: fn(K, V) -> Void) {
    let _ks = m.keys()
    let mut _i = 0
    while _i < _ks.len() {
        let _k = _ks.get(_i).unwrap()
        f(_k, m.get(_k).unwrap())
        _i = _i + 1
    }
}

/// Return a new map containing only entries that satisfy the predicate.
pub fn map_filter[K, V](m: Map[K, V], f: fn(K, V) -> Bool) -> Map[K, V] {
    let mut _r: Map[K, V] = Map()
    let _ks = m.keys()
    let mut _i = 0
    while _i < _ks.len() {
        let _k = _ks.get(_i).unwrap()
        let _v = m.get(_k).unwrap()
        if f(_k, _v) {
            _r.insert(_k, _v)
        }
        _i = _i + 1
    }
    _r
}

/// Reduce a map to a single value by applying a function with an accumulator.
pub fn map_fold[K, V, U](m: Map[K, V], init: U, f: fn(U, K, V) -> U) -> U {
    let _ks = m.keys()
    let mut _a = init
    let mut _i = 0
    while _i < _ks.len() {
        let _k = _ks.get(_i).unwrap()
        _a = f(_a, _k, m.get(_k).unwrap())
        _i = _i + 1
    }
    _a
}

/// Transform all values in a map, returning a new map with the same keys.
pub fn map_map_values[K, V, U](m: Map[K, V], f: fn(K, V) -> U) -> Map[K, U] {
    let mut _r: Map[K, U] = Map()
    let _ks = m.keys()
    let mut _i = 0
    while _i < _ks.len() {
        let _k = _ks.get(_i).unwrap()
        _r.insert(_k, f(_k, m.get(_k).unwrap()))
        _i = _i + 1
    }
    _r
}

/// Merge two maps into a new map. Keys in b override keys in a.
pub fn map_merge[K, V](a: Map[K, V], b: Map[K, V]) -> Map[K, V] {
    let mut _r: Map[K, V] = Map()
    let _ks_a = a.keys()
    let mut _i = 0
    while _i < _ks_a.len() {
        let _k = _ks_a.get(_i).unwrap()
        _r.insert(_k, a.get(_k).unwrap())
        _i = _i + 1
    }
    let _ks_b = b.keys()
    _i = 0
    while _i < _ks_b.len() {
        let _k = _ks_b.get(_i).unwrap()
        _r.insert(_k, b.get(_k).unwrap())
        _i = _i + 1
    }
    _r
}

pub trait MapPure {
    fn contains_key(self, key: Str) -> Bool
    fn contains(self, key: Str) -> Bool
    fn remove(self, key: Str) -> Bool
    fn clear(self)
}

impl[K, V] MapPure for Map[K, V] {
    fn contains_key(self, key: Str) -> Bool { map_has(self, key) != 0 }
    fn contains(self, key: Str) -> Bool { map_has(self, key) != 0 }
    fn remove(self, key: Str) -> Bool { map_remove(self, key) != 0 }
    fn clear(self) { map_clear(self) }
}

impl[K, V] Sized for Map[K, V] {
    fn len(self) -> Int { map_len(self) }
    fn is_empty(self) -> Bool { self.len() == 0 }
}
