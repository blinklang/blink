// panic.bl — the type a panic hook takes (sections/02_syntax.md §2.20)
//
// `with on_panic(f)` and a closure hook `fn(p) { ... }` need no import. A module that writes
// the name imports it: `import std.panic.{PanicInfo}`.

// What a panic hook gets. `line` is None when the line is not known, never 0.
pub type PanicInfo {
    message: Str
    file: Str
    line: Int?
}
