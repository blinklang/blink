// Non-blocking process spawning + signal propagation.
//
// `spawn` launches a child process and returns immediately with a `Pid`
// handle. Use `wait` to collect the result, or `kill`/`send_signal` to
// terminate the child early. Stdout and stderr are captured into the
// `ProcessResult` returned by `wait`.
//
// Use this when you need to forward signals to live children (e.g. a
// test orchestrator that wants Ctrl-C to clean up its workers) or when
// you need to overlap a long-running child with other work in the
// parent. For one-shot capture-and-block, `process_run` is simpler.
import std.errno.{Errno}

/// Captured outputs from a finished child process. runtime.h defines the
/// C struct (bootstrap/runtime_process.h), so these fields must match it.
pub type ProcessResult {
    out: Str
    err_out: Str
    /// How the child ended (sections/04_effects.md §4.4.8).
    end: ChildEnd
}

/// How a child ended. A signal is `Signaled(n)`, never an exit code of 128 + n.
@derive(Eq, Debug)
pub type ChildEnd {
    Exited(Int)
    Signaled(Int)
    Limit(LimitKind)
}

/// The limit that the runtime ended a child for.
@derive(Eq, Debug)
pub type LimitKind {
    Timeout
    Memory
    Processes
}

// An end renders as `exit N`, `signal <name>` or `limit <kind>` (sections/04_effects.md
// §4.4.8), so a log line reads the same on every host.
impl Display for ChildEnd {
    fn fmt(self, sb: StringBuilder) {
        match self {
            Exited(code) => sb.write("exit {code}")
            Signaled(n) => sb.write("signal {signal_name(n)}")
            Limit(kind) => {
                let name = match kind {
                    LimitKind.Timeout => "timeout"
                    LimitKind.Memory => "memory"
                    LimitKind.Processes => "processes"
                }
                sb.write("limit {name}")
            }
        }
    }
}

// A method needs a trait (Blink has no inherent methods); this one carries the one
// predicate the spec gives ProcessResult.
pub trait ProcessResultOps {
    /// True exactly when the child exited with code 0. Every signal and limit end is false.
    fn success(self) -> Bool
}

impl ProcessResultOps for ProcessResult {
    fn success(self) -> Bool {
        self.end == ChildEnd.Exited(0)
    }
}

/// Signal numbers differ between hosts (SIGBUS is 7 on Linux and 10 on macOS), so the build
/// target's signal.h sets each one. Match on the constants, never on a number or a name.
@ffi("SIGHUP", header: "signal.h")
pub let SIGHUP: Int
@ffi("SIGINT", header: "signal.h")
pub let SIGINT: Int
@ffi("SIGQUIT", header: "signal.h")
pub let SIGQUIT: Int
@ffi("SIGABRT", header: "signal.h")
pub let SIGABRT: Int
@ffi("SIGBUS", header: "signal.h")
pub let SIGBUS: Int
@ffi("SIGKILL", header: "signal.h")
pub let SIGKILL: Int
@ffi("SIGSEGV", header: "signal.h")
pub let SIGSEGV: Int
@ffi("SIGTERM", header: "signal.h")
pub let SIGTERM: Int
@ffi("SIGXCPU", header: "signal.h")
pub let SIGXCPU: Int

@ffi("blink_process_signal_name")
@trusted(audit: "Reads a static table of the host's signal names and returns an owned GC copy, or SIG<n> formatted into a local buffer. Pure lookup, no side effects, no memory shared back to C.")
fn c_signal_name(n: Int) -> Str ! () {}

/// The host's name for signal `n`, such as `"SIGSEGV"`, or `"SIG<n>"` for a number the
/// host has no name for.
pub fn signal_name(n: Int) -> Str {
    c_signal_name(n)
}

/// The operation a `ProcessError` comes from.
pub type ProcessOp {
    Run
    Spawn
    Wait
    Exec
    Signal
}

/// A failed `process.*` operation: the program was not found or could not start, the
/// wait failed, or the signal could not be sent. An exit code is never an error.
pub type ProcessError {
    op: ProcessOp
    cmd: Str
    code: Errno
}

@ffi("blink_strerror")
@trusted(audit: "Wraps strerror_r(3) through the blink_strerror shim, which renders the message into a local buffer and returns an owned GC copy. Pure lookup, thread-safe, no side effects, no memory shared back to C.")
fn c_process_strerror(code: Int) -> Str ! () {}

// A ProcessError renders as `op cmd: message` (sections/04_effects.md §4.4.8), the
// convention FsError uses, e.g. `run gti: No such file or directory`.
impl Display for ProcessError {
    fn fmt(self, sb: StringBuilder) {
        let op = match self.op {
            ProcessOp.Run => "run"
            ProcessOp.Spawn => "spawn"
            ProcessOp.Wait => "wait"
            ProcessOp.Exec => "exec"
            ProcessOp.Signal => "signal"
        }
        let code = match self.code {
            Errno(c) => c
        }
        sb.write("{op} {self.cmd}: {c_process_strerror(code)}")
    }
}

/// A child that `process.spawn` started. It has no methods: `process.wait` and
/// `process.signal` take it. Every copy is the same child, so a second wait returns the
/// result of the first.
// A pointer to the runtime's child box (bootstrap/runtime_process.h), which keeps the
// result of the first wait for every copy.
@ffi.opaque(name: "blink_child_box")
pub type Child

@ffi("blink_child_run")
@trusted(audit: "STD-PROCESS")
fn c_child_run(cmd: Str, args: List[Str], has_stdin: Int, stdin: Str) -> Child ! Process.Spawn {}

@ffi("blink_child_spawn")
@trusted(audit: "STD-PROCESS")
fn c_child_spawn(cmd: Str, args: List[Str]) -> Child ! Process.Spawn {}

@ffi("blink_child_wait")
@trusted(audit: "STD-PROCESS")
fn c_child_wait(child: Child) -> Int ! Process.Spawn {}

@ffi("blink_child_signal")
@trusted(audit: "STD-PROCESS")
fn c_child_signal(child: Child, sig: Int) -> Int ! Process.Signal {}

@ffi("blink_child_exec")
@trusted(audit: "STD-PROCESS")
fn c_child_exec(cmd: Str, args: List[Str]) -> Int ! Process.Spawn, Env.Exit {}

@ffi("blink_child_box_err")
@trusted(audit: "STD-PROCESS")
fn c_child_err(child: Child) -> Int ! () {}

@ffi("blink_child_box_cmd")
@trusted(audit: "STD-PROCESS")
fn c_child_cmd(child: Child) -> Str ! () {}

@ffi("blink_child_box_out")
@trusted(audit: "STD-PROCESS")
fn c_child_out(child: Child) -> Str ! () {}

@ffi("blink_child_box_err_out")
@trusted(audit: "STD-PROCESS")
fn c_child_err_out(child: Child) -> Str ! () {}

@ffi("blink_child_box_end_tag")
@trusted(audit: "STD-PROCESS")
fn c_child_end_tag(child: Child) -> Int ! () {}

@ffi("blink_child_box_end_value")
@trusted(audit: "STD-PROCESS")
fn c_child_end_value(child: Child) -> Int ! () {}

// The box holds the result once its run or wait succeeded. The tags are the ChildEnd
// tags of runtime_process.h; no Limit end exists until child limits do.
fn child_result(child: Child) -> ProcessResult {
    let tag = c_child_end_tag(child)
    let value = c_child_end_value(child)
    let end = if tag == 1 { ChildEnd.Signaled(value) } else { ChildEnd.Exited(value) }
    ProcessResult { out: c_child_out(child), err_out: c_child_err_out(child), end: end }
}

// The process_do_* default bodies are private: a user call of one would skip every
// Handler[Process] (§4.7.1). The compiler reaches them as the default slots of the vtable.

/// The default `process.run`: runs `cmd` to its end and returns its output and end.
fn process_do_run(cmd: Str, args: List[Str], -- stdin: Str? = None) -> Result[ProcessResult, ProcessError] ! Process.Spawn {
    let child = match stdin {
        Some(input) => c_child_run(cmd, args, 1, input)
        None => c_child_run(cmd, args, 0, "")
    }
    let code = c_child_err(child)
    if code != 0 {
        return Err(ProcessError { op: ProcessOp.Run, cmd: cmd, code: Errno(code) })
    }
    Ok(child_result(child))
}

/// The default `process.spawn`: starts `cmd` and returns at once.
fn process_do_spawn(cmd: Str, args: List[Str]) -> Result[Child, ProcessError] ! Process.Spawn {
    let child = c_child_spawn(cmd, args)
    let code = c_child_err(child)
    if code != 0 {
        return Err(ProcessError { op: ProcessOp.Spawn, cmd: cmd, code: Errno(code) })
    }
    Ok(child)
}

/// The default `process.wait`: waits for the child to end, or returns its result again.
fn process_do_wait(child: Child) -> Result[ProcessResult, ProcessError] ! Process.Spawn {
    let code = c_child_wait(child)
    if code != 0 {
        return Err(ProcessError { op: ProcessOp.Wait, cmd: c_child_cmd(child), code: Errno(code) })
    }
    Ok(child_result(child))
}

/// The default `process.signal`: sends `sig` to a child that has not been waited on.
fn process_do_signal(child: Child, sig: Int) -> Result[(), ProcessError] ! Process.Signal {
    let code = c_child_signal(child, sig)
    if code != 0 {
        return Err(ProcessError { op: ProcessOp.Signal, cmd: c_child_cmd(child), code: Errno(code) })
    }
    Ok(())
}

/// The default `process.exec`: replaces this program with `cmd`, so it returns only
/// when that failed.
fn process_do_exec(cmd: Str, args: List[Str]) -> Result[Never, ProcessError] ! Process.Spawn, Env.Exit {
    let code = c_child_exec(cmd, args)
    Err(ProcessError { op: ProcessOp.Exec, cmd: cmd, code: Errno(code) })
}

/// Opaque handle to a spawned child process. Wraps a runtime-side slot
/// index that tracks the OS pid plus stdout/stderr read pipes.
pub type Pid {
    handle: Int
}

pub trait PidOps {
    /// Block until the child exits, capturing stdout/stderr and how it
    /// ended. Idempotent: calling twice returns the cached result. The
    /// runtime keeps the most recent waited results, up to 4096 of them and
    /// 1 MiB of output in all; once this one is dropped, a further wait
    /// returns an `end` of `Exited(-1)` and an `err_out` of
    /// "invalid pid handle", never another child's result.
    fn wait(self) -> ProcessResult

    /// Send SIGKILL (or `signal` if non-zero) to the child. Returns 0
    /// on success, -1 if the child is already reaped or never spawned.
    fn kill(self, signal: Int) -> Int

    /// Send an arbitrary signal to the child. Returns 0 on success,
    /// -1 on failure.
    fn send_signal(self, signal: Int) -> Int
}

impl PidOps for Pid {
    fn wait(self) -> ProcessResult {
        process_pid_wait(self.handle)
    }

    fn kill(self, signal: Int) -> Int {
        process_pid_kill(self.handle, signal)
    }

    fn send_signal(self, signal: Int) -> Int {
        process_pid_send_signal(self.handle, signal)
    }
}

/// Spawn `cmd` with `args` as a non-blocking child process. Returns a
/// `Pid` handle. Stdin is the null device; stdout and stderr are captured into
/// pipes drained by `wait`.
pub fn spawn(cmd: Str, args: List[Str]) -> Pid {
    Pid { handle: process_spawn(cmd, args) }
}
