// random.bl — generic helpers over the Rand effect (sections/04_effects.md §4.4.7)
//
// These are free functions, not methods on the `rand` handle: `rand.<name>` always means an
// operation of Rand. Each helper draws only through `rand.int`, so a handler in force sees,
// and can replay, every draw.

/// A new list with the elements of `xs` in a uniform random order. Makes exactly
/// `xs.len() - 1` draws, none for an empty list. `xs` does not change.
pub fn shuffle[T](xs: List[T]) -> List[T] ! Rand {
    let mut out = xs.slice(0, xs.len())
    let mut i = out.len() - 1
    while i > 0 {
        let j = rand.int(0..=i)
        let held = out.get(i).unwrap()
        out.set(i, out.get(j).unwrap())
        out.set(j, held)
        i = i - 1
    }
    out
}

/// One element of `xs`, each with the same chance, or `None` for an empty list. Makes one
/// draw, none for an empty list.
pub fn choice[T](xs: List[T]) -> Option[T] ! Rand {
    // A local, not `0..xs.len()`: a range end parses as a primary, so the `.len()` would
    // apply to the range.
    let n = xs.len()
    if n == 0 { return None }
    xs.get(rand.int(0..n))
}
