@ffi("blink_sb_new")
@trusted(audit: "STD-SB")
pub fn sb_new() -> StringBuilder ! () {}

@ffi("blink_sb_with_capacity")
@trusted(audit: "STD-SB")
fn sb_with_capacity(cap: Int) -> StringBuilder ! () {}

@ffi("blink_sb_write")
@trusted(audit: "STD-SB")
pub fn sb_write(sb: StringBuilder, s: Str) ! () {}

@ffi("blink_sb_write_char")
@trusted(audit: "STD-SB")
fn sb_write_char(sb: StringBuilder, ch: Str) ! () {}

@ffi("blink_sb_write_int")
@trusted(audit: "STD-SB")
pub fn sb_write_int(sb: StringBuilder, val: Int) ! () {}

@ffi("blink_sb_write_float")
@trusted(audit: "STD-SB")
fn sb_write_float(sb: StringBuilder, val: Float) ! () {}

@ffi("blink_sb_write_bool")
@trusted(audit: "STD-SB")
fn sb_write_bool(sb: StringBuilder, val: Int) ! () {}

@ffi("blink_sb_to_str")
@trusted(audit: "STD-SB")
fn sb_to_str(sb: StringBuilder) -> Str ! () {}

@ffi("blink_sb_len")
@trusted(audit: "STD-SB")
fn sb_len(sb: StringBuilder) -> Int ! () {}

@ffi("blink_sb_capacity")
@trusted(audit: "STD-SB")
fn sb_capacity(sb: StringBuilder) -> Int ! () {}

@ffi("blink_sb_clear")
@trusted(audit: "STD-SB")
fn sb_clear(sb: StringBuilder) ! () {}

@ffi("blink_sb_is_empty")
@trusted(audit: "STD-SB")
fn sb_is_empty(sb: StringBuilder) -> Int ! () {}

impl Sized for StringBuilder {
    fn len(self) -> Int { sb_len(self) }
    fn is_empty(self) -> Bool { self.len() == 0 }
}

pub trait StringBuilderPure {
    fn write_char(self, ch: Char)
    fn to_str(self) -> Str
    fn capacity(self) -> Int
    fn clear(self)
}
