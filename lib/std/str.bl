@ffi("blink_str_len")
@trusted(audit: "STD-STR")
fn str_len(s: Str) -> Int ! FFI {}

@ffi("blink_str_char_at")
@trusted(audit: "STD-STR")
fn str_char_at(s: Str, i: Int) -> U8 ! FFI {}

@ffi("blink_str_substr")
@trusted(audit: "STD-STR")
fn str_substr(s: Str, start: Int, length: Int) -> Str ! FFI {}

@ffi("blink_str_from_char_code")
@trusted(audit: "STD-STR")
fn str_from_char_code(code: Int) -> Str ! FFI {}

@ffi("blink_str_concat")
@trusted(audit: "STD-STR")
fn str_concat(a: Str, b: Str) -> Str ! FFI {}

@ffi("blink_str_eq")
@trusted(audit: "STD-STR")
fn str_eq(a: Str, b: Str) -> Int ! FFI {}

@ffi("blink_str_contains")
@trusted(audit: "STD-STR")
fn str_contains(s: Str, needle: Str) -> Int ! FFI {}

@ffi("blink_str_starts_with")
@trusted(audit: "STD-STR")
fn str_starts_with(s: Str, prefix: Str) -> Int ! FFI {}

@ffi("blink_str_ends_with")
@trusted(audit: "STD-STR")
fn str_ends_with(s: Str, suffix: Str) -> Int ! FFI {}

@ffi("blink_str_index_of")
@trusted(audit: "STD-STR")
fn str_index_of(s: Str, needle: Str) -> Int ! FFI {}

@ffi("blink_str_index_of_from")
@trusted(audit: "STD-STR")
fn str_index_of_from(s: Str, needle: Str, from: Int) -> Int ! FFI {}

@ffi("blink_str_byte_slice")
@trusted(audit: "STD-STR")
fn str_byte_slice(s: Str, start: Int, end: Int) -> Str ! FFI {}

@ffi("blink_str_byte_index_of")
@trusted(audit: "STD-STR")
fn str_byte_index_of_raw(s: Str, needle: Str, from: Int) -> Int ! FFI {}

@ffi("blink_char_at_opt_raw")
@trusted(audit: "STD-STR")
fn str_char_at_opt_raw(s: Str, i: Int) -> Int ! FFI {}

impl Sized for Str {
    fn len(self) -> Int { str_len(self) }
    fn is_empty(self) -> Bool { self.len() == 0 }
}

/// Backing function for the codegen-routed `Str.char_at` method.
pub fn str_char_at_opt(s: Str, index: Int) -> Option[Char] {
    let raw = str_char_at_opt_raw(s, index)
    if raw < 0 { None } else { Some(Char.from_code_point(raw).unwrap()) }
}

/// Backing function for the codegen-routed `Str.byte_index_of` method.
pub fn str_byte_index_of(s: Str, needle: Str, from: Int) -> Option[Int] {
    let raw = str_byte_index_of_raw(s, needle, from)
    if raw < 0 { None } else { Some(raw) }
}

/// Strip leading and trailing whitespace from a string.
pub fn str_trim(s: Str) -> Str {
    let slen = s.byte_len()
    let mut start = 0
    while start < slen {
        let c = s.byte_at(start)
        if c != 32 && c != 9 && c != 10 && c != 13 {
            break
        }
        start = start + 1
    }
    let mut end = slen
    while end > start {
        let c = s.byte_at(end - 1)
        if c != 32 && c != 9 && c != 10 && c != 13 {
            break
        }
        end = end - 1
    }
    s.byte_slice(start, end)
}

/// Strip trailing whitespace from a string (right side only).
pub fn str_trim_right(s: Str) -> Str {
    let mut end = s.byte_len()
    while end > 0 {
        let c = s.byte_at(end - 1)
        if c != 32 && c != 9 && c != 10 && c != 13 {
            break
        }
        end = end - 1
    }
    s.byte_slice(0, end)
}

/// Strip leading whitespace from a string (left side only).
pub fn str_trim_left(s: Str) -> Str {
    let slen = s.byte_len()
    let mut start = 0
    while start < slen {
        let c = s.byte_at(start)
        if c != 32 && c != 9 && c != 10 && c != 13 {
            break
        }
        start = start + 1
    }
    s.byte_slice(start, slen)
}

/// Convert all ASCII lowercase characters to uppercase.
pub fn str_to_upper(s: Str) -> Str {
    let sb = StringBuilder.new()
    for ch in s {
        let cp = ch.to_int()
        if cp >= 97 && cp <= 122 {
            sb.write(str_from_code_point(cp - 32))
        } else {
            sb.write(ch.to_str())
        }
    }
    sb.to_str()
}

/// Convert all ASCII uppercase characters to lowercase.
pub fn str_to_lower(s: Str) -> Str {
    let sb = StringBuilder.new()
    for ch in s {
        let cp = ch.to_int()
        if cp >= 65 && cp <= 90 {
            sb.write(str_from_code_point(cp + 32))
        } else {
            sb.write(ch.to_str())
        }
    }
    sb.to_str()
}

/// Returns a single-character string for the given Unicode code point.
/// Caller must ensure `code` is a valid scalar value (0..=0x10FFFF, excluding surrogates).
pub fn str_from_code_point(code: Int) -> Str {
    str_from_char_code(code)
}

/// Split a string by a delimiter, returning a list of parts.
pub fn str_split(s: Str, delim: Str) -> List[Str] {
    let mut result: List[Str] = []
    let dlen = delim.byte_len()
    if dlen == 0 {
        result.push(s)
        return result
    }
    let slen = s.byte_len()
    // Each search starts at cursor and each piece is copied from a known offset, so no
    // step rescans or copies the text before cursor. Both calls are unchecked and rely on
    // cursor never passing slen.
    let mut cursor = 0
    loop {
        let idx = str_index_of_from(s, delim, cursor)
        if idx == -1 {
            result.push(str_substr(s, cursor, slen - cursor))
            break
        }
        result.push(str_substr(s, cursor, idx - cursor))
        cursor = idx + dlen
    }
    result
}

/// Join a list of strings with a delimiter.
pub fn str_join(parts: List[Str], delim: Str) -> Str {
    let plen = parts.len()
    if plen == 0 {
        return ""
    }
    let sb = StringBuilder.new()
    let mut i = 0
    while i < plen {
        if i > 0 {
            sb.write(delim)
        }
        sb.write(parts.get(i).unwrap())
        i = i + 1
    }
    sb.to_str()
}

/// Replace all occurrences of needle with repl in a string.
pub fn str_replace(s: Str, needle: Str, repl: Str) -> Str {
    let nlen = needle.byte_len()
    if nlen == 0 {
        return s
    }
    let slen = s.byte_len()
    let sb = StringBuilder.new()
    let mut cursor = 0
    loop {
        let idx = str_index_of_from(s, needle, cursor)
        if idx == -1 {
            sb.write(str_substr(s, cursor, slen - cursor))
            break
        }
        sb.write(str_substr(s, cursor, idx - cursor))
        sb.write(repl)
        cursor = idx + nlen
    }
    sb.to_str()
}

/// Split a string into lines, handling both \n and \r\n.
pub fn str_lines(s: Str) -> List[Str] {
    let mut result: List[Str] = []
    let slen = s.byte_len()
    if slen == 0 {
        return result
    }
    let mut cursor = 0
    let mut line_start = 0
    while cursor < slen {
        let c = s.byte_at(cursor)
        if c == 10 {
            result.push(s.byte_slice(line_start, cursor))
            cursor = cursor + 1
            line_start = cursor
        } else if c == 13 {
            result.push(s.byte_slice(line_start, cursor))
            cursor = cursor + 1
            if cursor < slen && s.byte_at(cursor) == 10 {
                cursor = cursor + 1
            }
            line_start = cursor
        } else {
            cursor = cursor + 1
        }
    }
    if line_start < slen {
        result.push(s.byte_slice(line_start, slen))
    }
    result
}

/// Escape a string for JSON output, wrapping in double quotes.
pub fn json_escape_str(s: Str) -> Str {
    let slen = s.byte_len()
    let sb = StringBuilder.new()
    sb.write(#"""#)
    // Unescaped bytes are copied a run at a time: a run ends only at an ASCII byte, so it
    // never cuts a multi-byte codepoint.
    let mut run = 0
    let mut i = 0
    while i < slen {
        let c = s.byte_at(i)
        let esc = if c == 34 {
            #"\""#
        } else if c == 92 {
            "\\\\"
        } else if c == 10 {
            "\\n"
        } else if c == 9 {
            "\\t"
        } else if c == 13 {
            "\\r"
        } else {
            ""
        }
        if esc != "" {
            sb.write(s.byte_slice(run, i))
            sb.write(esc)
            run = i + 1
        }
        i = i + 1
    }
    sb.write(s.byte_slice(run, slen))
    sb.write(#"""#)
    sb.to_str()
}
