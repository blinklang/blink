import std.float.{fabs, is_nan}

let mut _capture_log_target: List[Str] = []
let mut _capture_print_target: List[Str] = []
let mut _capture_eprint_target: List[Str] = []

pub fn capture_log(messages: List[Str]) -> Handler[IO.Log] {
    _capture_log_target = messages
    handler IO.Log {
        fn log(msg: Str) {
            _capture_log_target.push(msg)
        }
    }
}

pub fn capture_print(messages: List[Str]) -> Handler[IO.Print] {
    _capture_print_target = messages
    handler IO.Print {
        fn print(msg: Str) {
            _capture_print_target.push(msg)
        }
        fn print_no_nl(msg: Str) {
            _capture_print_target.push(msg)
        }
    }
}

pub fn capture_eprint(messages: List[Str]) -> Handler[IO.Eprint] {
    _capture_eprint_target = messages
    handler IO.Eprint {
        fn eprint(msg: Str) {
            _capture_eprint_target.push(msg)
        }
        fn eprint_no_nl(msg: Str) {
            _capture_eprint_target.push(msg)
        }
    }
}

/// A handler that reads the UTF-8 bytes of `text` as standard input, from the start, and
/// then gives end of input. Each call makes a new stream. It writes only read_bytes, so
/// read_line and read_all are the derived bodies of IO.Read over those bytes.
pub fn stdin_from(text: Str) -> Handler[IO.Read] {
    let data = Bytes.from_str(text)
    let mut pos = 0
    // The position moves in a closure because a handler operation cannot yet assign a
    // captured `let mut`.
    let next = fn(n: Int) -> Bytes {
        let left = data.len() - pos
        let take = if n < left { n } else { left }
        let out = data.slice(pos, pos + take)
        pos = pos + take
        out
    }
    handler IO.Read {
        fn read_bytes(n: Int) -> Bytes { next(n) }
    }
}

/// Source position of a `?` propagation site inside a test body.
/// Populated by the compiler — do not construct directly.
pub type SourceLocation {
    file: Str,
    line: Int,
    col: Int,
}

/// Sealed error carrier produced by `?` propagation inside test bodies.
/// When a test body contains `?`, its return type is implicitly elaborated
/// to `Result[Void, TestError]`; the runner introspects this type to emit
/// `cause:"propagated_error"` in NDJSON output.
///
/// SEALED BY CONVENTION: this type must only be constructed by compiler-
/// generated code. User code that names `TestError` as a constructor or in
/// a pattern is rejected by typecheck.
pub type TestError {
    message: Str,
    error_type: Str,
    origin: SourceLocation,
}

/// `BlockHandler` that runs a closure on every catchable unwind out of a
/// `with cleanup(fn) { ... }` block (normal exit, `?`, `return`, assert
/// failure, `skip()`). For non-`Closeable` cleanup — temp paths, env-var
/// resets, mock restores. For resources that already implement `Closeable`,
/// use `with x = acquire() as x { ... }` directly.
pub type Cleanup {
    action: fn() -> Void
}

impl BlockHandler for Cleanup {
    type Context = Void
    fn enter(self) -> Void {
        let _ = self
    }
    fn exit(self, ok: Bool) {
        let _ = ok
        (self.action)()
    }
}

pub fn cleanup(action: fn() -> Void) -> Cleanup {
    Cleanup { action: action }
}

/// Run one `for_each` case in its own catch frame and record it in the
/// runner's per-test `cases[]` buffer. A failure, panic or `skip()` in the case
/// ends that case only. A non-empty `duplicate` makes the case panic with it
/// before `body` runs. Returns the case status: 0=pass 1=fail 2=skip.
@ffi("blink_test_run_case")
@trusted(audit: "STD-TESTING")
fn run_case(label: Str, duplicate: Str, body: fn() -> Void) -> Int ! FFI {}

/// Mark the running test skipped without unwinding; `for_each` calls it when
/// every case skipped.
@ffi("blink_test_mark_skipped")
@trusted(audit: "STD-TESTING")
fn mark_skipped() ! FFI {}

/// Mark the current test as skipped. Catchable unwind: fires
/// `BlockHandler.exit(false)` / `Closeable.close()` for in-scope `with`
/// bindings. Compile error E0827 if called outside a `test { ... }` block.
/// The body is unreachable — codegen short-circuits the call at emit_call.
pub fn skip(reason: Str) {
    let _ = reason
}

pub fn for_each[T](cases: List[(Str, T)], body: fn(T) -> Void) {
    let mut _seen: List[Str] = []
    let mut _skipped = 0
    let mut _i = 0
    while _i < cases.len() {
        let _case = cases.get(_i).unwrap()
        let (_label, _value) = _case
        let mut _duplicate = ""
        let mut _j = 0
        while _j < _seen.len() {
            if _duplicate == "" && _seen.get(_j).unwrap() == _label {
                _duplicate = "for_each: duplicate case label \"{_label}\" at indices {_j} and {_i}"
            }
            _j = _j + 1
        }
        _seen.push(_label)
        if run_case(_label, _duplicate, fn() { body(_value) }) == 2 {
            _skipped = _skipped + 1
        }
        _i = _i + 1
    }
    if cases.len() > 0 && _skipped == cases.len() {
        mark_skipped()
    }
}

/// Assert that two floats are within `tol` of each other (absolute tolerance).
/// Panics on failure. Panics if any input is NaN. Panics if `tol` is negative.
/// Identical infinities pass; opposite-sign or mixed Inf/finite fail.
pub fn assert_close(left: Float, right: Float, tol: Float) {
    assert(!is_nan(left), "assert_close: left is NaN")
    assert(!is_nan(right), "assert_close: right is NaN")
    assert(!is_nan(tol), "assert_close: tol is NaN")
    assert(tol >= 0.0, "assert_close: tolerance must be non-negative, got {tol}")
    if left == right { return }
    let diff = fabs(left - right)
    assert(diff <= tol, "assert_close failed: |{left} - {right}| = {diff} exceeds tol {tol}")
}

/// Assert that two floats agree within a relative tolerance.
/// Predicate: |left - right| <= rel_tol * max(|left|, |right|).
/// Panics on failure, on any NaN input, and on negative `rel_tol`.
/// Both exactly 0.0 passes vacuously. Identical infinities pass.
pub fn assert_close_rel(left: Float, right: Float, rel_tol: Float) {
    assert(!is_nan(left), "assert_close_rel: left is NaN")
    assert(!is_nan(right), "assert_close_rel: right is NaN")
    assert(!is_nan(rel_tol), "assert_close_rel: rel_tol is NaN")
    assert(rel_tol >= 0.0, "assert_close_rel: tolerance must be non-negative, got {rel_tol}")
    if left == right { return }
    let abs_l = fabs(left)
    let abs_r = fabs(right)
    let scale = if abs_l > abs_r { abs_l } else { abs_r }
    let bound = scale * rel_tol
    let diff = fabs(left - right)
    // An infinite scale times a zero rel_tol is NaN, and NaN sorts above every bound.
    assert(!is_nan(bound) && diff <= bound, "assert_close_rel failed: |{left} - {right}| = {diff} exceeds {scale} * {rel_tol} = {bound}")
}
