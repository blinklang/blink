// toml.bl — Minimal TOML parser for blink.toml / blink.lock
//
// Supports: [section], [[array]], key = value (string, int, bool),
// inline tables { k = v }, arrays ["a", "b"], comments (#), blank lines.
// Uses parallel arrays since Blink has no Map type.

// ── ASCII constants ────────────────────────────────────────────────
let CH_TAB = 9
let CH_NEWLINE = 10
let CH_CR = 13
let CH_SPACE = 32
let CH_HASH = 35
let CH_DQUOTE = 34
let CH_COMMA = 44
let CH_DOT = 46
let CH_0 = 48
let CH_9 = 57
let CH_EQUALS = 61
let CH_LBRACKET = 91
let CH_BACKSLASH = 92
let CH_RBRACKET = 93
let CH_a = 97
let CH_z = 122
let CH_A = 65
let CH_Z = 90
let CH_UNDERSCORE = 95
let CH_MINUS = 45
let CH_SLASH = 47
let CH_LBRACE = 123
let CH_RBRACE = 125
let CH_PLUS = 43
let CH_TILDE = 126
let CH_GREATER = 62
let CH_LESS = 60
let CH_STAR = 42
let CH_CARET = 94
let CH_n = 110
let CH_t = 116
let CH_r = 114

// ── TOML value type tags ───────────────────────────────────────────
pub let TOML_STRING = 0
pub let TOML_INT = 1
pub let TOML_BOOL = 2
pub let TOML_ARRAY = 3
pub let TOML_INLINE_TABLE = 4

// ── Global store: parallel arrays ──────────────────────────────────
pub let mut toml_keys: List[Str] = []
pub let mut toml_values: List[Str] = []
pub let mut toml_types: List[Int] = []

/// Where a token sits in the parsed text. Lines and columns count from 1, and a column counts
/// bytes, as compiler diagnostics do. end_col is the column after the last byte. start_byte and
/// end_byte are offsets into the text, end exclusive.
pub type TomlSpan {
    line: Int
    col: Int
    end_line: Int
    end_col: Int
    start_byte: Int
    end_byte: Int
}

// Parallel to toml_keys. An array item shares its array's key span.
pub let mut toml_key_spans: List[TomlSpan] = []
pub let mut toml_value_spans: List[TomlSpan] = []

// Every [name] and [[name]] header in source order, brackets included in the span.
pub let mut toml_headers: List[Str] = []
pub let mut toml_header_spans: List[TomlSpan] = []

// ── Array table counters ───────────────────────────────────────────
// Tracks how many [[name]] entries toml_parse has seen for each array table name, until
// toml_clear.
let mut arr_table_names: List[Str] = []
let mut arr_table_counts: List[Int] = []

// ── Character helpers ──────────────────────────────────────────────

fn peek(s: Str, offset: Int) -> Int {
    if offset >= s.byte_len() {
        return 0
    }
    s.byte_at(offset).to_int()
}

fn toml_is_ws(c: Int) -> Int {
    c == CH_SPACE || c == CH_TAB
}

fn is_newline(c: Int) -> Int {
    c == CH_NEWLINE || c == CH_CR
}

fn is_digit(c: Int) -> Int {
    c >= CH_0 && c <= CH_9
}

fn toml_is_alpha(c: Int) -> Int {
    (c >= CH_a && c <= CH_z) || (c >= CH_A && c <= CH_Z)
}

fn is_bare_key_char(c: Int) -> Int {
    toml_is_alpha(c) || is_digit(c) || c == CH_UNDERSCORE || c == CH_MINUS || c == CH_SLASH
}

// ── Skip helpers ───────────────────────────────────────────────────

fn toml_skip_ws(content: Str, offset: Int) -> Int {
    let mut p = offset
    while p < content.byte_len() && toml_is_ws(peek(content, p)) {
        p = p + 1
    }
    p
}

fn skip_to_newline(content: Str, offset: Int) -> Int {
    let mut p = offset
    while p < content.byte_len() && peek(content, p) != CH_NEWLINE {
        p = p + 1
    }
    p
}

fn skip_ws_and_newlines(content: Str, offset: Int) -> Int {
    let mut p = offset
    while p < content.byte_len() {
        let c = peek(content, p)
        if toml_is_ws(c) || is_newline(c) {
            p = p + 1
        } else {
            return p
        }
    }
    p
}

// ── Parse results ──────────────────────────────────────────────────

/// One segment of an entry's path: a key, with `index` -1, or the index of an array item or of
/// a `[[name]]` element, with `key` empty.
pub type TomlSeg {
    key: Str
    index: Int
}

/// One `key = value`, or one array item, that a parse read. `key` is the dotted key the global
/// store holds, which does not tell a quoted `"a.b"` from `a.b`; `path` does. `path` holds the
/// segments of the key: the header's, then the key's own. A quoted segment keeps its dots, so
/// `"a.b" = 1` is one segment and `a.b = 1` is two. An array item adds an index segment, and so
/// does each `[[name]]` element, after the segments of that name: under `[[a]]` and then
/// `[a.b]`, the path of `y = 1` is `a`, the index of the last `a`, `b`, `y`. `header` is the
/// index in TomlDoc.headers of the header the entry is under, or -1 above the first one.
pub type TomlEntry {
    key: Str
    path: List[TomlSeg]
    value: Str
    vtype: Int
    key_span: TomlSpan
    value_span: TomlSpan
    header: Int
}

/// One `[name]` or `[[name]]` header. `path` holds the keys written in it, with no index.
pub type TomlHeader {
    name: Str
    path: List[Str]
    span: TomlSpan
    is_array: Bool
}

/// What toml_parse_doc read, in source order. The entries of an inline table come before the
/// entry of the table itself, and an array's items before the array.
pub type TomlDoc {
    entries: List[TomlEntry]
    headers: List[TomlHeader]
}

// The output of one parse, which each helper adds to. The [[name]] counters of the store keys
// belong to the caller, because toml_parse counts on across parses until toml_clear. `arrays`
// counts the elements of each [[name]] array by its path, for the index segments of one parse.
type TomlParser {
    entries: List[TomlEntry]
    headers: List[TomlHeader]
    arr_names: List[Str]
    arr_counts: List[Int]
    arrays: Map[Str, Int]
    starts: List[Int]
}

// Text a helper read, and the offset after it.
type Scanned {
    text: Str
    pos: Int
}

// A key a helper read: dotted as the global store holds it, its segments, and the offset after it.
type ScannedKey {
    key: Str
    path: List[Str]
    pos: Int
}

// ── Store helpers ──────────────────────────────────────────────────

fn key_seg(key: Str) -> TomlSeg {
    TomlSeg { key: key, index: -1 }
}

fn index_seg(index: Int) -> TomlSeg {
    TomlSeg { key: "", index: index }
}

fn key_segs(keys: List[Str]) -> List[TomlSeg] {
    keys.map(fn(k: Str) -> TomlSeg { key_seg(k) })
}

// Names a path in TomlParser.arrays. Each segment says where it ends, so no key text can make
// two paths share a name.
fn seg_id(path: List[TomlSeg]) -> Str {
    let mut out = ""
    for s in path {
        out = if s.index >= 0 { out.concat("#{s.index};") } else { out.concat("{s.key.byte_len()}:{s.key}") }
    }
    out
}

// The path of a header's keys, with the index of the last element after each leading part that
// names a [[name]] array, since TOML reads `[a.b]` after `[[a]]` as a table in the last `a`.
fn header_path(ps: TomlParser, keys: List[Str]) -> List[TomlSeg] {
    let mut out: List[TomlSeg] = []
    let mut i = 0
    while i < keys.len() {
        out.push(key_seg(keys.get(i).unwrap()))
        if i < keys.len() - 1 {
            let n = ps.arrays.get(seg_id(out)) ?? 0
            if n > 0 {
                out.push(index_seg(n - 1))
            }
        }
        i = i + 1
    }
    out
}

fn span_of(ps: TomlParser, start: Int, end: Int) -> TomlSpan {
    let li = line_index(ps.starts, start)
    let eli = line_index(ps.starts, end)
    TomlSpan {
        line: li + 1,
        col: start - ps.starts.get(li).unwrap() + 1,
        end_line: eli + 1,
        end_col: end - ps.starts.get(eli).unwrap() + 1,
        start_byte: start,
        end_byte: end,
    }
}

fn add_entry(ps: TomlParser, key: Str, path: List[TomlSeg], value: Str, vtype: Int, header: Int, key_start: Int, key_end: Int, value_start: Int, value_end: Int) {
    ps.entries.push(TomlEntry {
        key: key,
        path: path,
        value: value,
        vtype: vtype,
        key_span: span_of(ps, key_start, key_end),
        value_span: span_of(ps, value_start, value_end),
        header: header,
    })
}

fn find_key_index(key: Str) -> Int {
    let mut i = 0
    while i < toml_keys.len() {
        if toml_keys.get(i).unwrap() == key {
            return i
        }
        i = i + 1
    }
    -1
}

fn get_arr_table_count(name: Str) -> Int {
    let mut i = 0
    while i < arr_table_names.len() {
        if arr_table_names.get(i).unwrap() == name {
            return arr_table_counts.get(i).unwrap()
        }
        i = i + 1
    }
    0
}

fn inc_arr_table_count(ps: TomlParser, name: Str) -> Int {
    let mut i = 0
    while i < ps.arr_names.len() {
        if ps.arr_names.get(i).unwrap() == name {
            let count = ps.arr_counts.get(i).unwrap()
            ps.arr_counts.set(i, count + 1)
            return count
        }
        i = i + 1
    }
    ps.arr_names.push(name)
    ps.arr_counts.push(1)
    0
}

// ── Parse a quoted string value ────────────────────────────────────

fn parse_quoted_string(content: Str, offset: Int) -> Scanned {
    let mut p = offset + 1
    let mut result = ""
    while p < content.byte_len() {
        let c = peek(content, p)
        if c == CH_DQUOTE {
            return Scanned { text: result, pos: p + 1 }
        }
        if c == CH_BACKSLASH && p + 1 < content.byte_len() {
            let next = peek(content, p + 1)
            if next == CH_n {
                result = result.concat("\n")
                p = p + 2
                continue
            }
            if next == CH_t {
                result = result.concat("\t")
                p = p + 2
                continue
            }
            if next == CH_BACKSLASH {
                result = result.concat("\\")
                p = p + 2
                continue
            }
            if next == CH_DQUOTE {
                result = result.concat("\"")
                p = p + 2
                continue
            }
            result = result.concat(content.byte_slice(p, p + 1))
            p = p + 1
            continue
        }
        // Copy up to the next quote or backslash in one piece, so a multi-byte codepoint is
        // never cut.
        let run = p
        p = p + 1
        while p < content.byte_len() && peek(content, p) != CH_DQUOTE && peek(content, p) != CH_BACKSLASH {
            p = p + 1
        }
        result = result.concat(content.byte_slice(run, p))
    }
    Scanned { text: result, pos: p }
}

// ── Parse a bare key ───────────────────────────────────────────────
// Bare TOML keys: letters, digits, -, _, and / (for namespaced packages)

fn parse_bare_key(content: Str, offset: Int) -> Scanned {
    let mut p = offset
    while p < content.byte_len() && is_bare_key_char(peek(content, p)) {
        p = p + 1
    }
    Scanned { text: content.byte_slice(offset, p), pos: p }
}

// ── Parse a key (bare or quoted) ───────────────────────────────────

fn parse_key(content: Str, offset: Int) -> Scanned {
    if peek(content, offset) == CH_DQUOTE {
        return parse_quoted_string(content, offset)
    }
    parse_bare_key(content, offset)
}

// ── Parse a dotted key like package.name ────────────────────────────

fn parse_dotted_key(content: Str, offset: Int) -> ScannedKey {
    let first = parse_key(content, offset)
    let mut result = first.text
    let mut path: List[Str] = [first.text]
    let mut p = first.pos
    while p < content.byte_len() {
        let pp = toml_skip_ws(content, p)
        if peek(content, pp) != CH_DOT {
            return ScannedKey { key: result, path: path, pos: p }
        }
        let after_dot = toml_skip_ws(content, pp + 1)
        let seg = parse_key(content, after_dot)
        result = result.concat(".").concat(seg.text)
        path.push(seg.text)
        p = seg.pos
    }
    ScannedKey { key: result, path: path, pos: p }
}

// ── Parse an integer value ─────────────────────────────────────────

fn parse_integer(content: Str, offset: Int) -> Scanned {
    let mut p = offset
    if p < content.byte_len() && (peek(content, p) == CH_PLUS || peek(content, p) == CH_MINUS) {
        p = p + 1
    }
    while p < content.byte_len() && is_digit(peek(content, p)) {
        p = p + 1
    }
    Scanned { text: content.byte_slice(offset, p), pos: p }
}

// Compares bytes, so a codepoint that straddles the end of the word reads as a mismatch
// instead of a cut.
fn word_at(s: Str, p: Int, word: Str) -> Bool {
    if p + word.byte_len() > s.byte_len() { return false }
    let mut k = 0
    while k < word.byte_len() {
        if s.byte_at(p + k) != word.byte_at(k) { return false }
        k = k + 1
    }
    true
}

// ── Parse an array value ["a", "b", "c"] ───────────────────────────
// Adds each item as key[0], key[1], etc., and then the array itself, with the count as its
// value and the type TOML_ARRAY. Returns the offset after the array.
fn parse_array_value(ps: TomlParser, content: Str, offset: Int, full_key: Str, path: List[TomlSeg], header: Int, key_start: Int, key_end: Int) -> Int {
    let mut p = offset + 1
    let mut count = 0
    p = skip_ws_and_newlines(content, p)

    while p < content.byte_len() && peek(content, p) != CH_RBRACKET {
        p = skip_ws_and_newlines(content, p)
        if peek(content, p) == CH_RBRACKET {
            // trailing comma case
            p = p + 1
            add_entry(ps, full_key, path, "{count}", TOML_ARRAY, header, key_start, key_end, offset, p)
            return p
        }

        let c = peek(content, p)
        if c == CH_DQUOTE {
            let s = parse_quoted_string(content, p)
            add_entry(ps, "{full_key}[{count}]", path.append([index_seg(count)]), s.text, TOML_STRING, header, key_start, key_end, p, s.pos)
            p = s.pos
            count = count + 1
        } else if is_digit(c) || c == CH_MINUS || c == CH_PLUS {
            let n = parse_integer(content, p)
            add_entry(ps, "{full_key}[{count}]", path.append([index_seg(count)]), n.text, TOML_INT, header, key_start, key_end, p, n.pos)
            p = n.pos
            count = count + 1
        } else {
            // skip unknown array element
            p = p + 1
        }

        p = skip_ws_and_newlines(content, p)
        if peek(content, p) == CH_COMMA {
            p = p + 1
        }
    }

    if p < content.byte_len() && peek(content, p) == CH_RBRACKET {
        p = p + 1
    }
    add_entry(ps, full_key, path, "{count}", TOML_ARRAY, header, key_start, key_end, offset, p)
    p
}

// ── Parse an inline table { key = value, ... } ─────────────────────

// Returns the offset after the closing brace.
fn parse_inline_table(ps: TomlParser, content: Str, offset: Int, prefix: Str, prefix_path: List[TomlSeg], header: Int) -> Int {
    let mut p = offset + 1
    p = toml_skip_ws(content, p)

    while p < content.byte_len() && peek(content, p) != CH_RBRACE {
        p = toml_skip_ws(content, p)
        if peek(content, p) == CH_RBRACE {
            return p + 1
        }

        let key_start = p
        let k = parse_dotted_key(content, p)
        p = k.pos
        let key_end = p

        p = toml_skip_ws(content, p)
        if peek(content, p) == CH_EQUALS {
            p = p + 1
        }
        p = toml_skip_ws(content, p)

        let full_key = "{prefix}.{k.key}"
        let path = prefix_path.append(key_segs(k.path))

        let vc = peek(content, p)
        if vc == CH_DQUOTE {
            let s = parse_quoted_string(content, p)
            add_entry(ps, full_key, path, s.text, TOML_STRING, header, key_start, key_end, p, s.pos)
            p = s.pos
        } else if vc == CH_LBRACKET {
            p = parse_array_value(ps, content, p, full_key, path, header, key_start, key_end)
        } else if vc == CH_LBRACE {
            let end = parse_inline_table(ps, content, p, full_key, path, header)
            add_entry(ps, full_key, path, "", TOML_INLINE_TABLE, header, key_start, key_end, p, end)
            p = end
        } else if is_digit(vc) || vc == CH_MINUS || vc == CH_PLUS {
            let n = parse_integer(content, p)
            add_entry(ps, full_key, path, n.text, TOML_INT, header, key_start, key_end, p, n.pos)
            p = n.pos
        } else if word_at(content, p, "true") {
            add_entry(ps, full_key, path, "1", TOML_BOOL, header, key_start, key_end, p, p + 4)
            p = p + 4
        } else if word_at(content, p, "false") {
            add_entry(ps, full_key, path, "0", TOML_BOOL, header, key_start, key_end, p, p + 5)
            p = p + 5
        } else {
            p = p + 1
        }

        p = toml_skip_ws(content, p)
        if peek(content, p) == CH_COMMA {
            p = p + 1
        }
    }

    if p < content.byte_len() && peek(content, p) == CH_RBRACE {
        p = p + 1
    }
    p
}

// ── Parse a value (string, int, bool, array, inline table) ─────────

// Returns the offset after the value. An unknown value adds no entry and runs to the end of
// the line.
fn toml_parse_value(ps: TomlParser, content: Str, offset: Int, full_key: Str, path: List[TomlSeg], header: Int, key_start: Int, key_end: Int) -> Int {
    let c = peek(content, offset)

    if c == CH_DQUOTE {
        let s = parse_quoted_string(content, offset)
        add_entry(ps, full_key, path, s.text, TOML_STRING, header, key_start, key_end, offset, s.pos)
        return s.pos
    }

    if c == CH_LBRACKET {
        return parse_array_value(ps, content, offset, full_key, path, header, key_start, key_end)
    }

    if c == CH_LBRACE {
        let end = parse_inline_table(ps, content, offset, full_key, path, header)
        add_entry(ps, full_key, path, "", TOML_INLINE_TABLE, header, key_start, key_end, offset, end)
        return end
    }

    if is_digit(c) || c == CH_MINUS || c == CH_PLUS {
        let n = parse_integer(content, offset)
        add_entry(ps, full_key, path, n.text, TOML_INT, header, key_start, key_end, offset, n.pos)
        return n.pos
    }

    if word_at(content, offset, "true") {
        add_entry(ps, full_key, path, "1", TOML_BOOL, header, key_start, key_end, offset, offset + 4)
        return offset + 4
    }

    if word_at(content, offset, "false") {
        add_entry(ps, full_key, path, "0", TOML_BOOL, header, key_start, key_end, offset, offset + 5)
        return offset + 5
    }

    skip_to_newline(content, offset)
}

// ── Parse a section header [name] or [name.sub] ───────────────────
// pos is after the closing ]

fn parse_section_header(content: Str, offset: Int) -> ScannedKey {
    let mut p = offset + 1
    p = toml_skip_ws(content, p)
    let name = parse_dotted_key(content, p)
    p = toml_skip_ws(content, name.pos)
    if p < content.byte_len() && peek(content, p) == CH_RBRACKET {
        p = p + 1
    }
    ScannedKey { key: name.key, path: name.path, pos: p }
}

// ── Parse an array table header [[name]] ───────────────────────────

fn parse_array_table_header(content: Str, offset: Int) -> ScannedKey {
    let mut p = offset + 2
    p = toml_skip_ws(content, p)
    let name = parse_dotted_key(content, p)
    p = toml_skip_ws(content, name.pos)
    if p < content.byte_len() && peek(content, p) == CH_RBRACKET {
        p = p + 1
    }
    if p < content.byte_len() && peek(content, p) == CH_RBRACKET {
        p = p + 1
    }
    ScannedKey { key: name.key, path: name.path, pos: p }
}

// ── Main parser ────────────────────────────────────────────────────

/// Parse a TOML string and return what it read, with each key's segments and the line and
/// column of each key, value and header. Reads and writes none of the global store, so it is
/// safe at any point, a parse into the store included.
pub fn toml_parse_doc(content: Str) -> TomlDoc {
    parse_doc_with(content, [], [])
}

/// Parse a TOML string into the global store. Returns 0.
@allow(UnrestoredMutation, IncompleteStateRestore)
pub fn toml_parse(content: Str) -> Int {
    let doc = parse_doc_with(content, arr_table_names, arr_table_counts)
    for e in doc.entries {
        toml_keys.push(e.key)
        toml_values.push(e.value)
        toml_types.push(e.vtype)
        toml_key_spans.push(e.key_span)
        toml_value_spans.push(e.value_span)
    }
    for h in doc.headers {
        toml_headers.push(h.name)
        toml_header_spans.push(h.span)
    }
    0
}

fn parse_doc_with(content: Str, arr_names: List[Str], arr_counts: List[Int]) -> TomlDoc {
    let ps = TomlParser { entries: [], headers: [], arr_names: arr_names, arr_counts: arr_counts, arrays: Map(), starts: line_starts(content) }
    parse_entries(ps, content)
    TomlDoc { entries: ps.entries, headers: ps.headers }
}

fn parse_entries(ps: TomlParser, content: Str) {
    let mut cursor = 0
    let mut current_section = ""
    let mut current_path: List[TomlSeg] = []
    let mut header = -1

    while cursor < content.byte_len() {
        cursor = toml_skip_ws(content, cursor)

        if cursor >= content.byte_len() {
            return
        }

        let c = peek(content, cursor)

        // Skip blank lines
        if is_newline(c) {
            cursor = cursor + 1
            continue
        }

        // Skip comment lines
        if c == CH_HASH {
            cursor = skip_to_newline(content, cursor)
            if cursor < content.byte_len() {
                cursor = cursor + 1
            }
            continue
        }

        // Array table header [[name]]
        if c == CH_LBRACKET && cursor + 1 < content.byte_len() && peek(content, cursor + 1) == CH_LBRACKET {
            let h = parse_array_table_header(content, cursor)
            ps.headers.push(TomlHeader { name: h.key, path: h.path, span: span_of(ps, cursor, h.pos), is_array: true })
            header = ps.headers.len() - 1
            current_section = "{h.key}[{inc_arr_table_count(ps, h.key)}]"
            let base = header_path(ps, h.path)
            let id = seg_id(base)
            let index = ps.arrays.get(id) ?? 0
            ps.arrays.insert(id, index + 1)
            current_path = base.append([index_seg(index)])
            cursor = skip_to_newline(content, h.pos)
            if cursor < content.byte_len() {
                cursor = cursor + 1
            }
            continue
        }

        // Section header [name]
        if c == CH_LBRACKET {
            let h = parse_section_header(content, cursor)
            ps.headers.push(TomlHeader { name: h.key, path: h.path, span: span_of(ps, cursor, h.pos), is_array: false })
            header = ps.headers.len() - 1
            current_section = h.key
            current_path = header_path(ps, h.path)
            cursor = skip_to_newline(content, h.pos)
            if cursor < content.byte_len() {
                cursor = cursor + 1
            }
            continue
        }

        // Key = value pair
        let key_start = cursor
        let k = parse_dotted_key(content, cursor)
        cursor = k.pos
        let key_end = cursor

        cursor = toml_skip_ws(content, cursor)
        if peek(content, cursor) == CH_EQUALS {
            cursor = cursor + 1
        }
        cursor = toml_skip_ws(content, cursor)

        let full_key = if current_section != "" { "{current_section}.{k.key}" } else { k.key }
        cursor = toml_parse_value(ps, content, cursor, full_key, current_path.append(key_segs(k.path)), header, key_start, key_end)

        cursor = skip_to_newline(content, cursor)
        if cursor < content.byte_len() {
            cursor = cursor + 1
        }
    }
}

// ── Line and column for the spans of one parse ─────────────────

// Lines end at LF only, so the CR of a CRLF line stays on the line it ends and moves no column.
fn line_starts(content: Str) -> List[Int] {
    let mut starts: List[Int] = [0]
    let mut p = 0
    while p < content.byte_len() {
        if peek(content, p) == CH_NEWLINE {
            starts.push(p + 1)
        }
        p = p + 1
    }
    starts
}

// The index of the last line that starts at or before the offset.
fn line_index(starts: List[Int], offset: Int) -> Int {
    let mut lo = 0
    let mut hi = starts.len() - 1
    while lo < hi {
        let mid = (lo + hi + 1) / 2
        if starts.get(mid).unwrap() <= offset {
            lo = mid
        } else {
            hi = mid - 1
        }
    }
    lo
}

// ── Query API ──────────────────────────────────────────────────────

/// Get a string value by key. Supports dotted keys like "section.key"
pub fn toml_get(key: Str) -> Str {
    let idx = find_key_index(key)
    if idx == -1 {
        return ""
    }
    toml_values.get(idx).unwrap()
}

/// Get an integer value by key
pub fn toml_get_int(key: Str) -> Int {
    let val = toml_get(key)
    if val == "" {
        return 0
    }
    let mut result = 0
    let mut i = 0
    let mut negative = 0
    if i < val.byte_len() && val.byte_at(i).to_int() == CH_MINUS {
        negative = 1
        i = i + 1
    }
    if i < val.byte_len() && val.byte_at(i).to_int() == CH_PLUS {
        i = i + 1
    }
    while i < val.byte_len() {
        let c = val.byte_at(i).to_int()
        if c >= CH_0 && c <= CH_9 {
            result = result * 10 + (c - CH_0)
        }
        i = i + 1
    }
    if negative == 1 {
        return 0 - result
    }
    result
}

/// Check if a key exists. Returns 1 if found
pub fn toml_has(key: Str) -> Int {
    if find_key_index(key) != -1 {
        return 1
    }
    0
}

/// Get number of entries in a [[table]] array
pub fn toml_array_len(key: Str) -> Int {
    get_arr_table_count(key)
}

/// Get string value from an array by key and index
pub fn toml_get_array_item(key: Str, index: Int) -> Str {
    let item_key = "{key}[{index}]"
    toml_get(item_key)
}

/// Get length of an inline array offset key
pub fn toml_get_array_len(key: Str) -> Int {
    let val = toml_get(key)
    if val == "" {
        return 0
    }
    toml_get_int(key)
}

/// Reset all TOML state for next parse
pub fn toml_clear() -> Int {
    toml_keys = []
    toml_values = []
    toml_types = []
    toml_key_spans = []
    toml_value_spans = []
    toml_headers = []
    toml_header_spans = []
    arr_table_names = []
    arr_table_counts = []
    0
}

/// Stateless query: parse `content` and return the string value at
/// `[section].key` (or top-level `key` when section is ""). It reads and writes none of the
/// global store, so it is safe to call mid-parse.
pub fn toml_read_value(content: Str, section: Str, key: Str) -> Option[Str] {
    let lookup = if section == "" { key } else { "{section}.{key}" }
    for e in toml_parse_doc(content).entries {
        if e.key == lookup {
            return Some(e.value)
        }
    }
    None
}
