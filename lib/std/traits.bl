// 4q2etk: Display is a prelude trait. The compiler synthesizes a sealed
// `display() -> Str` for every impl (fmt rendered through a fresh
// StringBuilder); `display` is deliberately absent here because trait-sig
// methods are required in impls (E0900) and display is never user-written
// (E0731 — decision 344dnd). General trait-default-body infrastructure is
// ticket mwxtyj. No effect row on fmt pending zqeyay (StringBuilderPure
// effect/trait naming).
pub trait Display {
    fn fmt(self, sb: StringBuilder)
}

pub trait Sized {
    fn len(self) -> Int
    fn is_empty(self) -> Bool
}

pub trait Contains[T] {
    fn contains(self, value: T) -> Bool
}

pub trait StrOps {
    fn char_at(self, index: Int) -> Option[Char]
    fn byte_at(self, index: Int) -> Int
    fn contains(self, needle: Str) -> Bool
    fn starts_with(self, prefix: Str) -> Bool
    fn ends_with(self, suffix: Str) -> Bool
    fn index_of(self, needle: Str) -> Int
    fn substring(self, start: Int, len: Int) -> Str
    fn concat(self, other: Str) -> Str
    fn split(self, separator: Str) -> List[Str]
    fn lines(self) -> List[Str]
    fn to_upper(self) -> Str
    fn to_lower(self) -> Str
    fn trim(self) -> Str
    fn replace(self, needle: Str, replacement: Str) -> Str
    fn parse_int(self) -> Int
    fn parse_float(self) -> Float
    fn slice(self, start: Int, end: Int) -> Str
    fn to_int(self) -> Int
}

pub trait ListOps[T] {
    fn get(self, index: Int) -> Option[T]
    fn push(self, value: T)
    fn pop(self) -> Option[T]
    fn set(self, index: Int, value: T)
    fn concat(self, other: List[T]) -> List[T]
    fn slice(self, start: Int, end: Int) -> List[T]
}

pub trait MapOps[K, V] {
    fn get(self, key: K) -> V
    fn set(self, key: K, value: V)
    fn has(self, key: K) -> Bool
    fn remove(self, key: K) -> Bool
    fn keys(self) -> List[K]
    fn values(self) -> List[V]
}

pub trait SetOps[T] {
    fn insert(self, value: T) -> Bool
    fn remove(self, value: T) -> Bool
    fn union(self, other: Set[T]) -> Set[T]
}

pub trait BytesOps {
    fn push(self, byte: Int)
    fn get(self, index: Int) -> Option[Int]
    fn set(self, index: Int, byte: Int)
    fn len(self) -> Int
    fn is_empty(self) -> Bool
    fn slice(self, start: Int, end: Int) -> Bytes
    fn concat(self, other: Bytes) -> Bytes
    fn to_str(self) -> Result[Str, Str]
    fn to_hex(self) -> Str
    fn read_u16_be(self, off: Int) -> Result[Int, Str]
    fn read_u32_be(self, off: Int) -> Result[Int, Str]
    fn read_i32_be(self, off: Int) -> Result[Int, Str]
    fn read_i64_be(self, off: Int) -> Result[Int, Str]
    fn read_u16_le(self, off: Int) -> Result[Int, Str]
    fn read_u32_le(self, off: Int) -> Result[Int, Str]
    fn read_i32_le(self, off: Int) -> Result[Int, Str]
    fn read_i64_le(self, off: Int) -> Result[Int, Str]
    fn write_u16_be(self, v: Int)
    fn write_u32_be(self, v: Int)
    fn write_i32_be(self, v: Int)
    fn write_i64_be(self, v: Int)
    fn write_u16_le(self, v: Int)
    fn write_u32_le(self, v: Int)
    fn write_i32_le(self, v: Int)
    fn write_i64_le(self, v: Int)
    fn set_u16_be(self, off: Int, v: Int) -> Result[Void, Str]
    fn set_u16_le(self, off: Int, v: Int) -> Result[Void, Str]
    fn set_i16_be(self, off: Int, v: Int) -> Result[Void, Str]
    fn set_i16_le(self, off: Int, v: Int) -> Result[Void, Str]
    fn set_u32_be(self, off: Int, v: Int) -> Result[Void, Str]
    fn set_u32_le(self, off: Int, v: Int) -> Result[Void, Str]
    fn set_i32_be(self, off: Int, v: Int) -> Result[Void, Str]
    fn set_i32_le(self, off: Int, v: Int) -> Result[Void, Str]
    fn set_u64_be(self, off: Int, v: Int) -> Result[Void, Str]
    fn set_u64_le(self, off: Int, v: Int) -> Result[Void, Str]
    fn set_i64_be(self, off: Int, v: Int) -> Result[Void, Str]
    fn set_i64_le(self, off: Int, v: Int) -> Result[Void, Str]
}

pub trait StringBuildOps {
    fn write(self, s: Str)
    fn write_char(self, c: Char)
    fn to_str(self) -> Str
    fn len(self) -> Int
    fn capacity(self) -> Int
    fn clear(self)
    fn is_empty(self) -> Bool
}

pub trait Joinable {
    fn join(self, separator: Str) -> Str
}

pub trait Closeable {
    fn close(self)
}

pub trait BlockHandler {
    type Context
    fn enter(self) -> Self.Context
    fn exit(self, ok: Bool)
}

pub type ConversionError {
    message: Str
    source_type: Str
    target_type: Str
}

pub trait From[T] {
    fn from(value: T) -> Self
}

pub trait Into[T] {
    fn into(self) -> T
}

pub trait TryFrom[T] {
    fn try_from(value: T) -> Result[Self, ConversionError]
}

