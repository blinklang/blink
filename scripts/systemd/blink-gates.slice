# The slice that holds every gate run: scripts/capped.sh puts each run's scope
# in it, so these limits hold over all gates at once. Install it with
# scripts/install-gate-slice.sh, which fills in the values that depend on the
# machine. See docs/build/gate-memory-budget.md for the numbers.
[Unit]
Description=Blink gate runs (scripts/capped.sh)

[Slice]
CPUQuota=@CPU_QUOTA@
MemoryHigh=@MEMORY_HIGH@
MemoryMax=@MEMORY_MAX@
MemorySwapMax=2G
TasksMax=4096
# systemd-oomd, when it runs, kills a gate scope here under memory pressure or
# when the swap fills, before the kernel's OOM killer reaches the sessions.
ManagedOOMMemoryPressure=kill
ManagedOOMSwap=kill
