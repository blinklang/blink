// ast.bl — AST node definitions for the self-hosting compiler
//
// Fat-node approach: a single AstNode struct carries fields for every
// possible node kind. Only the fields relevant to a given kind are
// meaningful; the rest are zero/empty. Child references are Int node
// IDs into the parser's nodes: List[AstNode] pool.

// -- Expression node kinds --
pub type NodeKind {
    IntLit, FloatLit, Ident, Call, MethodCall, BinOp, UnaryOp, InterpString,
    BoolLit, TupleLit, ListLit, StructLit, FieldAccess, IndexExpr, RangeLit, IfExpr,
    MatchExpr, Closure, LetBinding, ExprStmt, Assignment, CompoundAssign, Return, ForIn,
    WhileLoop, LoopExpr, Break, Continue, Block, FnDef, Param, Program,
    TypeDef, TypeField, TypeVariant, TraitDef, ImplBlock, TestBlock, IntPattern, WildcardPattern,
    IdentPattern, TuplePattern, StringPattern, OrPattern, RangePattern, StructPattern, EnumPattern, AsPattern, ListPattern,
    MatchArm, StructLitField, WithBlock, WithResource, HandlerExpr, Annotation, ModBlock, ImportStmt, TypeAnn,
    TypeParam, EffectDecl,
    AsyncScope, AsyncSpawn, AwaitExpr, ChannelNew,
    EmbedExpr,
    NamedArg,
    AssocType,
    SpreadExpr,
    CharLit,
    AssertPanics,
    // Not a node kind. Kept last so its tag is the number of real kinds, which is what
    // nk_bridge_gap walks to prove the Int-to-NodeKind bridge is total.
    KindCount,
}

// -- Statement node kinds --

// -- Block / structural kinds --

// -- Type definition kinds --

// -- Pattern kinds --

// -- Struct literal field --

// -- With / handler / annotation --

// -- Module system --

// -- Type annotation --

// Flat AST node for the node pool. All child references are Int node IDs
// (-1 = no node). Sublist fields store Int indices into sl_data.
pub type AstNode {
    kind: Int = 0
    int_val: Int = 0
    str_val: Str = ""
    name: Str = ""
    op: Str = ""
    left: Int = -1
    right: Int = -1
    body: Int = -1
    condition: Int = -1
    then_body: Int = -1
    else_body: Int = -1
    scrutinee: Int = -1
    pattern: Int = -1
    guard: Int = -1
    value: Int = -1
    target: Int = -1
    iterable: Int = -1
    var_name: Str = ""
    is_mut: Int = 0
    is_pub: Int = 0
    is_const: Int = 0
    module: Str = ""
    inclusive: Int = 0
    start: Int = -1
    end: Int = -1
    obj: Int = -1
    method: Str = ""
    index: Int = -1
    return_type: Str = ""
    type_name: Str = ""
    trait_name: Str = ""
    params: Int = -1
    args: Int = -1
    stmts: Int = -1
    arms: Int = -1
    fields: Int = -1
    elements: Int = -1
    methods: Int = -1
    type_params: Int = -1
    effects: Int = -1
    captures: Int = -1
    type_ann: Int = -1
    handlers: Int = -1
    leading_comments: Str = ""
    trailing_comments: Str = ""
    doc_comment: Str = ""
    line: Int = -1
    col: Int = -1
    end_line: Int = -1
    end_col: Int = -1
    assoc_types: Int = -1
    impl_binders: Int = -1
    recv_type_args: Int = -1
    impl_where_bounds: Int = -1
    xfail_reason: Str = ""
    xfail_ticket: Str = ""
    for_binder: Int = -1
    supertraits: Int = -1
}



// The name a node kind spells. A match over NodeKind, not over the stored Int: an enum is
// nominally distinct from Int, so widening the kind to match it against `NodeKind.*` arms
// is ill-typed, and it throws exhaustiveness away as well — a kind added without a
// spelling would fall through a catch-all instead of failing to compile here.
pub fn nk_name(k: NodeKind) -> Str {
    match k {
        NodeKind.IntLit => "IntLit"
        NodeKind.FloatLit => "FloatLit"
        NodeKind.Ident => "Ident"
        NodeKind.Call => "Call"
        NodeKind.MethodCall => "MethodCall"
        NodeKind.BinOp => "BinOp"
        NodeKind.UnaryOp => "UnaryOp"
        NodeKind.InterpString => "InterpString"
        NodeKind.BoolLit => "BoolLit"
        NodeKind.TupleLit => "TupleLit"
        NodeKind.ListLit => "ListLit"
        NodeKind.StructLit => "StructLit"
        NodeKind.FieldAccess => "FieldAccess"
        NodeKind.IndexExpr => "IndexExpr"
        NodeKind.RangeLit => "RangeLit"
        NodeKind.IfExpr => "IfExpr"
        NodeKind.MatchExpr => "MatchExpr"
        NodeKind.Closure => "Closure"
        NodeKind.LetBinding => "LetBinding"
        NodeKind.ExprStmt => "ExprStmt"
        NodeKind.Assignment => "Assignment"
        NodeKind.CompoundAssign => "CompoundAssign"
        NodeKind.Return => "Return"
        NodeKind.ForIn => "ForIn"
        NodeKind.WhileLoop => "WhileLoop"
        NodeKind.LoopExpr => "LoopExpr"
        NodeKind.Break => "Break"
        NodeKind.Continue => "Continue"
        NodeKind.Block => "Block"
        NodeKind.FnDef => "FnDef"
        NodeKind.Param => "Param"
        NodeKind.Program => "Program"
        NodeKind.TypeDef => "TypeDef"
        NodeKind.TypeField => "TypeField"
        NodeKind.TypeVariant => "TypeVariant"
        NodeKind.TraitDef => "TraitDef"
        NodeKind.ImplBlock => "ImplBlock"
        NodeKind.TestBlock => "TestBlock"
        NodeKind.IntPattern => "IntPattern"
        NodeKind.WildcardPattern => "WildcardPattern"
        NodeKind.IdentPattern => "IdentPattern"
        NodeKind.TuplePattern => "TuplePattern"
        NodeKind.StringPattern => "StringPattern"
        NodeKind.OrPattern => "OrPattern"
        NodeKind.RangePattern => "RangePattern"
        NodeKind.StructPattern => "StructPattern"
        NodeKind.EnumPattern => "EnumPattern"
        NodeKind.AsPattern => "AsPattern"
        NodeKind.ListPattern => "ListPattern"
        NodeKind.MatchArm => "MatchArm"
        NodeKind.StructLitField => "StructLitField"
        NodeKind.WithBlock => "WithBlock"
        NodeKind.WithResource => "WithResource"
        NodeKind.HandlerExpr => "HandlerExpr"
        NodeKind.Annotation => "Annotation"
        NodeKind.ModBlock => "ModBlock"
        NodeKind.ImportStmt => "ImportStmt"
        NodeKind.TypeAnn => "TypeAnn"
        NodeKind.TypeParam => "TypeParam"
        NodeKind.EffectDecl => "EffectDecl"
        NodeKind.AsyncScope => "AsyncScope"
        NodeKind.AsyncSpawn => "AsyncSpawn"
        NodeKind.AwaitExpr => "AwaitExpr"
        NodeKind.ChannelNew => "ChannelNew"
        NodeKind.EmbedExpr => "EmbedExpr"
        NodeKind.NamedArg => "NamedArg"
        NodeKind.AssocType => "AssocType"
        NodeKind.SpreadExpr => "SpreadExpr"
        NodeKind.CharLit => "CharLit"
        NodeKind.AssertPanics => "AssertPanics"
        NodeKind.KindCount => "KindCount"
    }
}

// The same name for a kind held as a stored tag. The bridge crosses to NodeKind once and
// asks the speller above, so the two answers cannot drift. A tag that names no kind is not
// given a plausible-wrong one.
pub fn node_kind_name(kind: Int) -> Str {
    if kind < 0 { return "Unknown" }
    if kind > nk_tag(NodeKind.KindCount) { return "Unknown" }
    nk_name(nk_of(kind))
}

// Helper: does this node kind carry control-flow blocks whose non-tail
// statements need walking? Single source of truth for the typecheck ExprStmt
// re-dispatch (tc_check_body) so a future block-bearing kind cannot silently
// lose statement-walking coverage there.
pub fn is_block_bearing(kind: Int) -> Int {
    if kind == NodeKind.IfExpr { return 1 }
    if kind == NodeKind.MatchExpr { return 1 }
    if kind == NodeKind.WhileLoop { return 1 }
    if kind == NodeKind.LoopExpr { return 1 }
    if kind == NodeKind.ForIn { return 1 }
    if kind == NodeKind.WithBlock { return 1 }
    // `async.scope { ... }` bears a block, so it must be listed here: tc_check_body's
    // ExprStmt arm only re-dispatches into a body for kinds this predicate claims, and a
    // block-bearing kind missing from this list loses every per-statement check in STATEMENT
    // position. Initializer position is always walked regardless.
    if kind == NodeKind.AsyncScope { return 1 }
    0
}

// ── NodeKind as a value, and the child/type tables keyed on it ──────────────
//
// `AstNode.kind` is an Int, so a match on it can never be proved exhaustive: adding a
// NodeKind would compile and every Int-keyed table would answer its catch-all instead.
// The tables below are keyed on the NodeKind VALUE with no catch-all arm, so a new
// variant fails the build until every table has an arm for it — which is the point, since
// a walk that silently skips a kind is the bug these tables exist to make impossible.
// NK_ALL and nk_tag bridge the stored Int to that value, and nk_bridge_gap proves the
// bridge is total and order-faithful, the one part no match can check.

// Every real kind, in declaration order: the index of an entry is its nk_tag.
pub let NK_ALL: List[NodeKind] = [
    NodeKind.IntLit, NodeKind.FloatLit, NodeKind.Ident, NodeKind.Call,
    NodeKind.MethodCall, NodeKind.BinOp, NodeKind.UnaryOp, NodeKind.InterpString,
    NodeKind.BoolLit, NodeKind.TupleLit, NodeKind.ListLit, NodeKind.StructLit,
    NodeKind.FieldAccess, NodeKind.IndexExpr, NodeKind.RangeLit, NodeKind.IfExpr,
    NodeKind.MatchExpr, NodeKind.Closure, NodeKind.LetBinding, NodeKind.ExprStmt,
    NodeKind.Assignment, NodeKind.CompoundAssign, NodeKind.Return, NodeKind.ForIn,
    NodeKind.WhileLoop, NodeKind.LoopExpr, NodeKind.Break, NodeKind.Continue,
    NodeKind.Block, NodeKind.FnDef, NodeKind.Param, NodeKind.Program,
    NodeKind.TypeDef, NodeKind.TypeField, NodeKind.TypeVariant, NodeKind.TraitDef,
    NodeKind.ImplBlock, NodeKind.TestBlock, NodeKind.IntPattern, NodeKind.WildcardPattern,
    NodeKind.IdentPattern, NodeKind.TuplePattern, NodeKind.StringPattern, NodeKind.OrPattern,
    NodeKind.RangePattern, NodeKind.StructPattern, NodeKind.EnumPattern, NodeKind.AsPattern,
    NodeKind.ListPattern, NodeKind.MatchArm, NodeKind.StructLitField, NodeKind.WithBlock,
    NodeKind.WithResource, NodeKind.HandlerExpr, NodeKind.Annotation, NodeKind.ModBlock,
    NodeKind.ImportStmt, NodeKind.TypeAnn, NodeKind.TypeParam, NodeKind.EffectDecl,
    NodeKind.AsyncScope, NodeKind.AsyncSpawn, NodeKind.AwaitExpr, NodeKind.ChannelNew,
    NodeKind.EmbedExpr, NodeKind.NamedArg, NodeKind.AssocType, NodeKind.SpreadExpr,
    NodeKind.CharLit, NodeKind.AssertPanics,
]

// The Int spelling of a NodeKind, which is what AstNode.kind holds.
pub fn nk_tag(k: NodeKind) -> Int {
    match k {
        NodeKind.IntLit => 0
        NodeKind.FloatLit => 1
        NodeKind.Ident => 2
        NodeKind.Call => 3
        NodeKind.MethodCall => 4
        NodeKind.BinOp => 5
        NodeKind.UnaryOp => 6
        NodeKind.InterpString => 7
        NodeKind.BoolLit => 8
        NodeKind.TupleLit => 9
        NodeKind.ListLit => 10
        NodeKind.StructLit => 11
        NodeKind.FieldAccess => 12
        NodeKind.IndexExpr => 13
        NodeKind.RangeLit => 14
        NodeKind.IfExpr => 15
        NodeKind.MatchExpr => 16
        NodeKind.Closure => 17
        NodeKind.LetBinding => 18
        NodeKind.ExprStmt => 19
        NodeKind.Assignment => 20
        NodeKind.CompoundAssign => 21
        NodeKind.Return => 22
        NodeKind.ForIn => 23
        NodeKind.WhileLoop => 24
        NodeKind.LoopExpr => 25
        NodeKind.Break => 26
        NodeKind.Continue => 27
        NodeKind.Block => 28
        NodeKind.FnDef => 29
        NodeKind.Param => 30
        NodeKind.Program => 31
        NodeKind.TypeDef => 32
        NodeKind.TypeField => 33
        NodeKind.TypeVariant => 34
        NodeKind.TraitDef => 35
        NodeKind.ImplBlock => 36
        NodeKind.TestBlock => 37
        NodeKind.IntPattern => 38
        NodeKind.WildcardPattern => 39
        NodeKind.IdentPattern => 40
        NodeKind.TuplePattern => 41
        NodeKind.StringPattern => 42
        NodeKind.OrPattern => 43
        NodeKind.RangePattern => 44
        NodeKind.StructPattern => 45
        NodeKind.EnumPattern => 46
        NodeKind.AsPattern => 47
        NodeKind.ListPattern => 48
        NodeKind.MatchArm => 49
        NodeKind.StructLitField => 50
        NodeKind.WithBlock => 51
        NodeKind.WithResource => 52
        NodeKind.HandlerExpr => 53
        NodeKind.Annotation => 54
        NodeKind.ModBlock => 55
        NodeKind.ImportStmt => 56
        NodeKind.TypeAnn => 57
        NodeKind.TypeParam => 58
        NodeKind.EffectDecl => 59
        NodeKind.AsyncScope => 60
        NodeKind.AsyncSpawn => 61
        NodeKind.AwaitExpr => 62
        NodeKind.ChannelNew => 63
        NodeKind.EmbedExpr => 64
        NodeKind.NamedArg => 65
        NodeKind.AssocType => 66
        NodeKind.SpreadExpr => 67
        NodeKind.CharLit => 68
        NodeKind.AssertPanics => 69
        NodeKind.KindCount => 70
    }
}

// The stored Int read back as a value. Out of range answers the sentinel, which every
// table treats as childless and untyped.
pub fn nk_of(kind: Int) -> NodeKind {
    if kind < 0 { return NodeKind.KindCount }
    if kind >= NK_ALL.len() { return NodeKind.KindCount }
    NK_ALL.get(kind).unwrap()
}

// The first tag NK_ALL spells wrong, or -1 when the bridge is total and in order. A gap
// here makes nk_of answer the WRONG kind for every node of that tag, so a caller treats a
// non-negative answer as an internal error and not a warning.
pub fn nk_bridge_gap() -> Int {
    if NK_ALL.len() != nk_tag(NodeKind.KindCount) { return NK_ALL.len() }
    let mut t = 0
    while t < NK_ALL.len() {
        let k = NK_ALL.get(t).unwrap()
        if nk_tag(k) != t { return t }
        // Two independent spellings of the same number: nk_tag's hand-written match, and the
        // Int the enum itself stores in AstNode.kind — which is what the parser writes and
        // node_kind reads back. nk_tag agreeing with NK_ALL proves nothing if both drifted
        // from the enum, so the stored Int is compared too.
        let probe = AstNode { kind: k }
        if probe.kind != t { return t }
        t = t + 1
    }
    -1
}

// A node's children, split by what the child is: `refs`/`lists` hold the children that
// stand in a VALUE position, `spell_refs`/`spell_lists` the children that spell a type or
// a name. The split matters because Ident and TypeAnn nodes appear in both roles — a fn's
// return annotation, a callee name, an effect name and an annotation argument are all
// written with the same node kinds as expressions, and no amount of typing will give them
// a type. A pass that walks values stops at a spelling edge; a pass that must reach every
// node walks both.
//
// `refs` and `spell_refs` hold node ids, `lists` and `spell_lists` hold sublist ids whose
// members are children. Two fields, `LetBinding.elements` and `ForIn.elements`, hold a
// pattern NODE id rather than a sublist despite the field's name, and are listed as refs.
//
// One field is overloaded: `handlers` holds the effect handlers of a WithBlock, and the
// ANNOTATIONS of every other kind that has any. Both are filed as value lists, because an
// annotation's arguments are nodes a total walk still has to reach.
pub type NodeChildren {
    refs: List[Int] = []
    lists: List[Int] = []
    spell_refs: List[Int] = []
    spell_lists: List[Int] = []
}

fn nk_drop_absent(ids: List[Int]) -> List[Int] {
    let mut out: List[Int] = []
    let mut i = 0
    while i < ids.len() {
        let c = ids.get(i).unwrap()
        if c != -1 { out.push(c) }
        i = i + 1
    }
    out
}

fn nk_kids(refs: List[Int], lists: List[Int], spell_refs: List[Int], spell_lists: List[Int]) -> NodeChildren {
    NodeChildren {
        refs: nk_drop_absent(refs), lists: nk_drop_absent(lists),
        spell_refs: nk_drop_absent(spell_refs), spell_lists: nk_drop_absent(spell_lists),
    }
}

// EVERY child of a node, for any pass that must not miss one.
pub fn node_children(node: AstNode) -> NodeChildren {
    match nk_of(node.kind) {
        NodeKind.IntLit => nk_kids([], [], [], [])
        NodeKind.FloatLit => nk_kids([], [], [], [])
        NodeKind.Ident => nk_kids([], [], [], [])
        // A call's `left` is the CALLEE EXPRESSION — an Ident for a named call, any value for
        // a call through a closure — so it is a value child, not a spelling.
        NodeKind.Call => nk_kids([node.left], [node.args], [], [node.type_params])
        NodeKind.MethodCall => nk_kids([node.obj], [node.args], [], [node.type_params])
        NodeKind.BinOp => nk_kids([node.left, node.right], [], [], [])
        NodeKind.UnaryOp => nk_kids([node.left], [], [], [])
        NodeKind.InterpString => nk_kids([], [node.elements], [], [])
        NodeKind.BoolLit => nk_kids([], [], [], [])
        NodeKind.TupleLit => nk_kids([], [node.elements], [], [])
        NodeKind.ListLit => nk_kids([], [node.elements], [], [])
        NodeKind.StructLit => nk_kids([], [node.fields], [], [])
        NodeKind.FieldAccess => nk_kids([node.obj], [], [], [])
        NodeKind.IndexExpr => nk_kids([node.obj, node.index], [], [], [])
        NodeKind.RangeLit => nk_kids([node.start, node.end], [], [], [])
        NodeKind.IfExpr => nk_kids([node.condition, node.then_body, node.else_body], [], [], [])
        NodeKind.MatchExpr => nk_kids([node.scrutinee], [node.arms], [], [])
        NodeKind.Closure => nk_kids([node.body], [node.params], [node.type_ann], [])
        NodeKind.LetBinding => nk_kids([node.value, node.elements], [node.handlers], [node.target], [])
        NodeKind.ExprStmt => nk_kids([node.value], [], [], [])
        NodeKind.Assignment => nk_kids([node.target, node.value], [], [], [])
        NodeKind.CompoundAssign => nk_kids([node.target, node.value], [], [], [])
        NodeKind.Return => nk_kids([node.value], [], [], [])
        NodeKind.ForIn => nk_kids([node.for_binder, node.iterable, node.body, node.elements], [], [], [])
        NodeKind.WhileLoop => nk_kids([node.condition, node.body], [], [], [])
        NodeKind.LoopExpr => nk_kids([node.body], [], [], [])
        NodeKind.Break => nk_kids([], [], [], [])
        NodeKind.Continue => nk_kids([], [], [], [])
        NodeKind.Block => nk_kids([], [node.stmts], [], [])
        // A bodiless fn is a SIGNATURE — a trait method, an effect operation — so its
        // params and return annotation spell types and bind nothing. The same kind with a
        // body binds its params to values.
        NodeKind.FnDef => if node.body == -1 {
            nk_kids([], [node.handlers], [node.type_ann], [node.type_params, node.params, node.effects])
        } else {
            nk_kids([node.body], [node.params, node.handlers], [node.type_ann], [node.type_params, node.effects])
        }
        NodeKind.Param => nk_kids([], [], [node.type_ann, node.value], [])
        NodeKind.Program => nk_kids([], [node.params, node.fields, node.stmts, node.arms, node.methods, node.elements, node.args, node.handlers, node.captures], [], [])
        // A type alias's `condition` is its @where REFINEMENT PREDICATE: an expression over
        // `self` that the boundary checks evaluate, so it is typed like any other value.
        NodeKind.TypeDef => nk_kids([node.condition], [node.fields, node.handlers], [node.value], [node.type_params])
        NodeKind.TypeField => nk_kids([node.condition], [], [node.value], [])
        NodeKind.TypeVariant => nk_kids([], [node.fields], [], [])
        NodeKind.TraitDef => nk_kids([], [node.assoc_types, node.methods, node.handlers], [], [node.type_params, node.supertraits])
        NodeKind.ImplBlock => nk_kids([], [node.assoc_types, node.methods, node.handlers], [], [node.type_params, node.impl_binders, node.recv_type_args, node.impl_where_bounds])
        NodeKind.TestBlock => nk_kids([node.body], [node.handlers], [], [])
        NodeKind.IntPattern => nk_kids([], [], [], [])
        NodeKind.WildcardPattern => nk_kids([], [], [], [])
        NodeKind.IdentPattern => nk_kids([], [], [], [])
        NodeKind.TuplePattern => nk_kids([], [node.elements], [], [])
        NodeKind.StringPattern => nk_kids([], [], [], [])
        NodeKind.OrPattern => nk_kids([], [node.elements], [], [])
        NodeKind.RangePattern => nk_kids([], [], [], [])
        NodeKind.StructPattern => nk_kids([], [node.fields], [], [])
        NodeKind.EnumPattern => nk_kids([], [node.fields], [], [])
        NodeKind.AsPattern => nk_kids([node.pattern], [], [], [])
        NodeKind.ListPattern => nk_kids([], [node.elements], [], [])
        NodeKind.MatchArm => nk_kids([node.pattern, node.guard, node.body], [], [], [])
        NodeKind.StructLitField => nk_kids([node.pattern, node.value], [], [], [])
        NodeKind.WithBlock => nk_kids([node.body], [node.handlers], [], [])
        NodeKind.WithResource => nk_kids([node.value], [], [], [])
        NodeKind.HandlerExpr => nk_kids([], [node.methods], [], [])
        // A contract's predicate is an expression the runtime check evaluates; every other
        // annotation's arguments only spell names and options.
        NodeKind.Annotation => if node.name == "requires" || node.name == "ensures" {
            nk_kids([], [node.args], [], [])
        } else {
            nk_kids([], [], [], [node.args])
        }
        NodeKind.ModBlock => nk_kids([], [], [], [])
        NodeKind.ImportStmt => nk_kids([], [node.handlers], [], [node.args])
        NodeKind.TypeAnn => nk_kids([], [], [node.type_ann], [node.elements])
        NodeKind.TypeParam => nk_kids([], [], [], [node.elements])
        NodeKind.EffectDecl => nk_kids([], [node.elements, node.methods, node.handlers], [], [])
        NodeKind.AsyncScope => nk_kids([node.body], [], [], [])
        NodeKind.AsyncSpawn => nk_kids([node.body], [], [], [])
        NodeKind.AwaitExpr => nk_kids([node.obj], [], [], [])
        NodeKind.ChannelNew => nk_kids([], [node.args], [], [node.type_params])
        NodeKind.EmbedExpr => nk_kids([], [], [], [])
        NodeKind.NamedArg => nk_kids([node.value], [], [], [])
        NodeKind.AssocType => nk_kids([], [], [node.type_ann], [])
        NodeKind.SpreadExpr => nk_kids([node.value], [], [], [])
        NodeKind.CharLit => nk_kids([], [], [], [])
        NodeKind.AssertPanics => nk_kids([node.value, node.body], [], [], [])
        NodeKind.KindCount => nk_kids([], [], [], [])
    }
}

fn nk_holds(ids: List[Int], id: Int) -> Int {
    let mut i = 0
    while i < ids.len() {
        if ids.get(i).unwrap() == id { return 1 }
        i = i + 1
    }
    0
}

// The name of a field holding a child this node's kind does not claim, or "" when the
// kind's arm covers every child the node actually has. Every field that can hold a node id
// or a sublist id is listed here ONCE, independent of kind, so an arm written too narrowly
// is caught by the node itself rather than by whichever later pass needed the lost child.
pub fn node_unclaimed_child(node: AstNode) -> Str {
    let kids = node_children(node)
    if node.left != -1 && nk_holds(kids.refs, node.left) == 0 && nk_holds(kids.spell_refs, node.left) == 0 { return "left" }
    if node.right != -1 && nk_holds(kids.refs, node.right) == 0 && nk_holds(kids.spell_refs, node.right) == 0 { return "right" }
    if node.body != -1 && nk_holds(kids.refs, node.body) == 0 && nk_holds(kids.spell_refs, node.body) == 0 { return "body" }
    if node.condition != -1 && nk_holds(kids.refs, node.condition) == 0 && nk_holds(kids.spell_refs, node.condition) == 0 { return "condition" }
    if node.then_body != -1 && nk_holds(kids.refs, node.then_body) == 0 && nk_holds(kids.spell_refs, node.then_body) == 0 { return "then_body" }
    if node.else_body != -1 && nk_holds(kids.refs, node.else_body) == 0 && nk_holds(kids.spell_refs, node.else_body) == 0 { return "else_body" }
    if node.scrutinee != -1 && nk_holds(kids.refs, node.scrutinee) == 0 && nk_holds(kids.spell_refs, node.scrutinee) == 0 { return "scrutinee" }
    if node.pattern != -1 && nk_holds(kids.refs, node.pattern) == 0 && nk_holds(kids.spell_refs, node.pattern) == 0 { return "pattern" }
    if node.guard != -1 && nk_holds(kids.refs, node.guard) == 0 && nk_holds(kids.spell_refs, node.guard) == 0 { return "guard" }
    if node.value != -1 && nk_holds(kids.refs, node.value) == 0 && nk_holds(kids.spell_refs, node.value) == 0 { return "value" }
    if node.target != -1 && nk_holds(kids.refs, node.target) == 0 && nk_holds(kids.spell_refs, node.target) == 0 { return "target" }
    if node.iterable != -1 && nk_holds(kids.refs, node.iterable) == 0 && nk_holds(kids.spell_refs, node.iterable) == 0 { return "iterable" }
    if node.start != -1 && nk_holds(kids.refs, node.start) == 0 && nk_holds(kids.spell_refs, node.start) == 0 { return "start" }
    if node.end != -1 && nk_holds(kids.refs, node.end) == 0 && nk_holds(kids.spell_refs, node.end) == 0 { return "end" }
    if node.obj != -1 && nk_holds(kids.refs, node.obj) == 0 && nk_holds(kids.spell_refs, node.obj) == 0 { return "obj" }
    if node.index != -1 && nk_holds(kids.refs, node.index) == 0 && nk_holds(kids.spell_refs, node.index) == 0 { return "index" }
    if node.type_ann != -1 && nk_holds(kids.refs, node.type_ann) == 0 && nk_holds(kids.spell_refs, node.type_ann) == 0 { return "type_ann" }
    if node.for_binder != -1 && nk_holds(kids.refs, node.for_binder) == 0 && nk_holds(kids.spell_refs, node.for_binder) == 0 { return "for_binder" }
    if node.params != -1 && nk_holds(kids.lists, node.params) == 0 && nk_holds(kids.spell_lists, node.params) == 0 { return "params" }
    if node.args != -1 && nk_holds(kids.lists, node.args) == 0 && nk_holds(kids.spell_lists, node.args) == 0 { return "args" }
    if node.stmts != -1 && nk_holds(kids.lists, node.stmts) == 0 && nk_holds(kids.spell_lists, node.stmts) == 0 { return "stmts" }
    if node.arms != -1 && nk_holds(kids.lists, node.arms) == 0 && nk_holds(kids.spell_lists, node.arms) == 0 { return "arms" }
    if node.fields != -1 && nk_holds(kids.lists, node.fields) == 0 && nk_holds(kids.spell_lists, node.fields) == 0 { return "fields" }
    if node.methods != -1 && nk_holds(kids.lists, node.methods) == 0 && nk_holds(kids.spell_lists, node.methods) == 0 { return "methods" }
    if node.type_params != -1 && nk_holds(kids.lists, node.type_params) == 0 && nk_holds(kids.spell_lists, node.type_params) == 0 { return "type_params" }
    if node.effects != -1 && nk_holds(kids.lists, node.effects) == 0 && nk_holds(kids.spell_lists, node.effects) == 0 { return "effects" }
    if node.captures != -1 && nk_holds(kids.lists, node.captures) == 0 && nk_holds(kids.spell_lists, node.captures) == 0 { return "captures" }
    if node.handlers != -1 && nk_holds(kids.lists, node.handlers) == 0 && nk_holds(kids.spell_lists, node.handlers) == 0 { return "handlers" }
    if node.assoc_types != -1 && nk_holds(kids.lists, node.assoc_types) == 0 && nk_holds(kids.spell_lists, node.assoc_types) == 0 { return "assoc_types" }
    if node.impl_binders != -1 && nk_holds(kids.lists, node.impl_binders) == 0 && nk_holds(kids.spell_lists, node.impl_binders) == 0 { return "impl_binders" }
    if node.recv_type_args != -1 && nk_holds(kids.lists, node.recv_type_args) == 0 && nk_holds(kids.spell_lists, node.recv_type_args) == 0 { return "recv_type_args" }
    if node.impl_where_bounds != -1 && nk_holds(kids.lists, node.impl_where_bounds) == 0 && nk_holds(kids.spell_lists, node.impl_where_bounds) == 0 { return "impl_where_bounds" }
    if node.supertraits != -1 && nk_holds(kids.lists, node.supertraits) == 0 && nk_holds(kids.spell_lists, node.supertraits) == 0 { return "supertraits" }
    // `elements` is a sublist for most kinds and a pattern node for two, so it is checked
    // against both namespaces at once.
    if node.elements != -1 {
        if nk_holds(kids.lists, node.elements) == 0 && nk_holds(kids.spell_lists, node.elements) == 0 {
            if nk_holds(kids.refs, node.elements) == 0 { return "elements" }
        }
    }
    ""
}

// Whether a node of this kind denotes a value or binds one, and so must carry a concrete
// tid once inference is done. This is the contract codegen reads against: asking for the
// tid of an Untyped kind has no answer to find, and the question itself is the defect.
//
// Typed is every expression kind, including the ones that also carry statements — a block,
// an if, a match and a loop are all expressions in Blink — the diverging forms (return,
// break and continue have type Never), and the binders: a param, a let, an ident pattern,
// an `as` pattern.
//
// Untyped is the statement forms (an assignment and a bare expression statement have no
// value of their own; ask the value they wrap), the declaration forms (a fn's type is its
// signature, not a node tid), the structural clauses (a match arm, a struct literal field,
// a with resource), the patterns that bind nothing, and everything that spells a type.
pub fn nk_is_typed(k: NodeKind) -> Int {
    match k {
        NodeKind.IntLit => 1
        NodeKind.FloatLit => 1
        NodeKind.Ident => 1
        NodeKind.Call => 1
        NodeKind.MethodCall => 1
        NodeKind.BinOp => 1
        NodeKind.UnaryOp => 1
        NodeKind.InterpString => 1
        NodeKind.BoolLit => 1
        NodeKind.TupleLit => 1
        NodeKind.ListLit => 1
        NodeKind.StructLit => 1
        NodeKind.FieldAccess => 1
        NodeKind.IndexExpr => 1
        NodeKind.RangeLit => 1
        NodeKind.IfExpr => 1
        NodeKind.MatchExpr => 1
        NodeKind.Closure => 1
        NodeKind.LetBinding => 1
        NodeKind.ExprStmt => 0
        NodeKind.Assignment => 0
        NodeKind.CompoundAssign => 0
        NodeKind.Return => 1
        NodeKind.ForIn => 0
        NodeKind.WhileLoop => 0
        NodeKind.LoopExpr => 1
        NodeKind.Break => 1
        NodeKind.Continue => 1
        NodeKind.Block => 1
        NodeKind.FnDef => 0
        NodeKind.Param => 1
        NodeKind.Program => 0
        NodeKind.TypeDef => 0
        NodeKind.TypeField => 0
        NodeKind.TypeVariant => 0
        NodeKind.TraitDef => 0
        NodeKind.ImplBlock => 0
        NodeKind.TestBlock => 0
        NodeKind.IntPattern => 0
        NodeKind.WildcardPattern => 0
        NodeKind.IdentPattern => 1
        NodeKind.TuplePattern => 0
        NodeKind.StringPattern => 0
        NodeKind.OrPattern => 0
        NodeKind.RangePattern => 0
        NodeKind.StructPattern => 0
        NodeKind.EnumPattern => 0
        NodeKind.AsPattern => 1
        NodeKind.ListPattern => 0
        NodeKind.MatchArm => 0
        NodeKind.StructLitField => 0
        NodeKind.WithBlock => 1
        NodeKind.WithResource => 0
        NodeKind.HandlerExpr => 1
        NodeKind.Annotation => 0
        NodeKind.ModBlock => 0
        NodeKind.ImportStmt => 0
        NodeKind.TypeAnn => 0
        NodeKind.TypeParam => 0
        NodeKind.EffectDecl => 0
        NodeKind.AsyncScope => 1
        NodeKind.AsyncSpawn => 0
        NodeKind.AwaitExpr => 1
        NodeKind.ChannelNew => 1
        NodeKind.EmbedExpr => 1
        NodeKind.NamedArg => 1
        NodeKind.AssocType => 0
        NodeKind.SpreadExpr => 1
        NodeKind.CharLit => 1
        NodeKind.AssertPanics => 0
        NodeKind.KindCount => 0
    }
}

// ── Fine-grained internal trace sink ────────────────────────────────
//
// The coarse phase tracer (`trace`/`--blink-trace` in compiler.bl) sits at the
// TOP of the import DAG, so the modules doing the interesting work — typecheck,
// codegen_types — cannot reach it without an import cycle. That is why the
// monomorphization / tid-resolution paths have historically had zero
// instrumentation and every debugging session reached for a throwaway printf +
// recompile. This sink lives in ast.bl (the DAG root, imported transitively by
// everyone) so ANY module can emit a fine-grained trace.
//
// Channels are opt-in via BLINK_TRACE_CHANNELS (comma-separated, or "all"),
// wired once at CLI startup into dbg_channels. When unset the guard is a single
// string compare and nothing is emitted — zero cost, and it never touches
// generated C, so it is byte-neutral (Gen1==Gen2 unaffected). Taps ship in
// source permanently: a future session sets the env var instead of editing code.
pub let mut dbg_channels: Str = ""

// Public so hot-path callers can gate the construction of an interpolated trace
// message (eagerly evaluated in Blink) behind the channel check, paying nothing
// when the channel is off.
pub fn dbg_channel_on(ch: Str) -> Int {
    if ch == "" { return 0 }
    if dbg_channels == "" { return 0 }
    if dbg_channels == "all" { return 1 }
    // Exact per-channel match against the comma list so "monotid" does not
    // match a hypothetical "monotidx". Scan comma-delimited segments.
    let needle = dbg_channels
    let mut seg_start = 0
    let mut ci = 0
    while ci <= needle.len() {
        if ci == needle.len() || needle.byte_at(ci) == 44 {
            if needle.substring(seg_start, ci - seg_start) == ch { return 1 }
            seg_start = ci + 1
        }
        ci = ci + 1
    }
    0
}

pub fn dbg_trace(ch: Str, msg: Str) {
    if dbg_channel_on(ch) != 0 {
        io.eprintln("[dbg:{ch}] {msg}")
    }
}

// Phase tracing lives beside the channel tracing, in the leaf every phase already
// imports, so the lexer and the parser can trace without importing the driver.
pub let mut trace_mode: Str = ""

pub fn trace(phase: Str, msg: Str) {
    if trace_mode == phase || trace_mode == "all" {
        io.eprintln("[trace:{phase}] {msg}")
    }
}
