// The records of a package's audits.toml (§9.1 *Audit Records*). A record is the table [K]
// and holds only `claim` and `pins`; any other key is an issue that the loader reports as
// AuditRecordUnknownKey. This module reads text and returns values, so a test can drive it
// without a file.

import std.toml.{toml_parse_doc, TomlDoc, TomlEntry, TomlSeg, TomlSpan, TOML_STRING}

pub type AuditRecord {
    key: Str
    claim: Str
    pins: Map[Str, Str]
}

// A key in record `record` that the schema does not allow, spanned on its first segment.
pub type AuditRecordIssue {
    record: Str
    key: Str
    span: TomlSpan
}

pub type AuditRecords {
    records: Map[Str, AuditRecord]
    issues: List[AuditRecordIssue]
}

pub fn audit_records_empty() -> AuditRecords {
    AuditRecords { records: Map(), issues: [] }
}

pub fn audit_records_parse(text: Str) -> AuditRecords {
    let doc = toml_parse_doc(text)
    let arrays = array_names(doc)
    let mut records: Map[Str, AuditRecord] = Map()
    let mut issues: List[AuditRecordIssue] = []
    let mut issue_at: Map[Str, Int] = Map()
    // A bare `[K.x]` is the table x inside record K, so x is a key of K the same as `x = ...`
    // under `[K]`. It is reported at the header, which names it, and before the entries
    // under that header, which name it again.
    for h in doc.headers {
        if h.is_array || h.path.len() < 2 { continue }
        let k = h.path.get(0).unwrap()
        let first = h.path.get(1).unwrap()
        if arrays.contains(k) || first == "claim" || first == "pins" { continue }
        let id = "{k}\n{first}"
        if !issue_at.contains_key(id) {
            issue_at.insert(id, issues.len())
            issues.push(AuditRecordIssue { record: k, key: first, span: h.span })
        }
    }
    for e in doc.entries {
        let k = record_of(doc, arrays, e)
        if k == "" { continue }
        if !records.contains_key(k) {
            records.insert(k, AuditRecord { key: k, claim: "", pins: Map() })
        }
        let rel = e.path.slice(1, e.path.len())
        let seg = rel.get(0).unwrap()
        if seg.index >= 0 { continue }
        let first = seg.key
        if first == "claim" {
            if rel.len() == 1 && e.vtype == TOML_STRING {
                let r = records.get(k).unwrap()
                records.insert(k, AuditRecord { claim: e.value, ..r })
            }
        } else if first == "pins" {
            // `pins = { ... }` and `[K.pins]` give one entry for each pin in the table.
            let pin = rel.get(1) ?? TomlSeg { key: "", index: 0 }
            if rel.len() == 2 && pin.index < 0 && e.vtype == TOML_STRING {
                let r = records.get(k).unwrap()
                let mut pins = r.pins
                pins.insert(pin.key, e.value)
                records.insert(k, AuditRecord { pins: pins, ..r })
            }
        } else {
            // A dotted or inline-table key gives several entries; the record key is reported
            // once, at the entry that writes it. An inline table records its inner keys first.
            let id = "{k}\n{first}"
            let span = first_segment_span(text, e.key_span)
            match issue_at.get(id) {
                Some(i) => {
                    if rel.len() == 1 {
                        issues.set(i, AuditRecordIssue { record: k, key: first, span: span })
                    }
                }
                None => {
                    issue_at.insert(id, issues.len())
                    issues.push(AuditRecordIssue { record: k, key: first, span: span })
                }
            }
        }
    }
    AuditRecords { records: records, issues: in_source_order(issues) }
}

fn in_source_order(issues: List[AuditRecordIssue]) -> List[AuditRecordIssue] {
    let mut out = issues
    let mut i = 1
    while i < out.len() {
        let cur = out.get(i).unwrap()
        let mut j = i
        while j > 0 && out.get(j - 1).unwrap().span.start_byte > cur.span.start_byte {
            out.set(j, out.get(j - 1).unwrap())
            j = j - 1
        }
        out.set(j, cur)
        i = i + 1
    }
    out
}

pub fn audit_record_find(recs: AuditRecords, k: Str) -> Option[AuditRecord] {
    recs.records.get(k)
}

// The K of the record an entry sits in, or "" when the entry is outside every record: before
// the first header, under a `[[name]]` header, or in a K that some `[[K]]` makes an array.
fn record_of(doc: TomlDoc, arrays: Set[Str], e: TomlEntry) -> Str {
    if e.header < 0 || e.path.len() < 2 { return "" }
    if doc.headers.get(e.header).unwrap().is_array { return "" }
    let k = e.path.get(0).unwrap().key
    if arrays.contains(k) { "" } else { k }
}

// The first key of each `[[name]]` header, which makes that key an array and not a record.
fn array_names(doc: TomlDoc) -> Set[Str] {
    let mut out: Set[Str] = Set()
    for h in doc.headers {
        if h.is_array { out.insert(h.path.get(0) ?? "") }
    }
    out
}

// The span of the first segment of a key: `a` in `a.b = 1`, `"a.b"` in `"a.b".c = 1`. The
// caret then marks the key the record does not allow, not the whole dotted path.
fn first_segment_span(text: Str, span: TomlSpan) -> TomlSpan {
    let start = span.start_byte
    let mut p = start
    let q = text.byte_at(start)
    if q == 34 || q == 39 {
        p = p + 1
        while p < span.end_byte && text.byte_at(p) != q {
            if q == 34 && text.byte_at(p) == 92 { p = p + 1 }
            p = p + 1
        }
        p = p + 1
    } else {
        while p < span.end_byte && is_bare_key_byte(text.byte_at(p)) {
            p = p + 1
        }
    }
    if p >= span.end_byte || span.end_line != span.line { return span }
    TomlSpan { end_col: span.col + (p - start), end_byte: p, ..span }
}

fn is_bare_key_byte(b: U8) -> Bool {
    (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95 || b == 45
}
