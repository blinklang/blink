// The records of a package's audits.toml (§9.1 *Audit Records*). A record is the table [K]
// and holds only `claim` and `pins`; any other key is an issue that the loader reports as
// AuditRecordUnknownKey. This module reads text and returns values, so a test can drive it
// without a file.

import std.toml.{toml_parse_doc, TomlDoc, TomlEntry, TomlSpan, TOML_STRING}

pub type AuditRecord {
    claim: Str
    pins: Map[Str, Str]
}

// A key in record `record` that the schema does not allow, spanned on its first segment.
pub type AuditRecordIssue {
    record: Str
    key: Str
    span: TomlSpan
}

pub type AuditRecords {
    records: Map[Str, AuditRecord]
    issues: List[AuditRecordIssue]
}

pub fn audit_records_empty() -> AuditRecords {
    AuditRecords { records: Map(), issues: [] }
}

pub fn audit_records_parse(text: Str) -> AuditRecords {
    let doc = toml_parse_doc(text)
    let arrays = array_names(doc)
    let mut records: Map[Str, AuditRecord] = Map()
    let mut issues: List[AuditRecordIssue] = []
    let mut issue_at: Map[Str, Int] = Map()
    // A header makes its record exist even with no keys under it, as TOML does. A bare `[K.x]`
    // is the table x inside record K, so x is a key of K the same as `x = ...` under `[K]`. It
    // is reported at the header, which names it, and before the entries under that header,
    // which name it again.
    for h in doc.headers {
        let k = match h.path.get(0) {
            Some(name) => name
            None => continue
        }
        if arrays.contains(k) || (k == "" && !quoted_empty(text, h.span)) { continue }
        if !records.contains_key(k) {
            records.insert(k, AuditRecord { claim: "", pins: Map() })
        }
        if h.path.len() < 2 { continue }
        let first = h.path.get(1).unwrap()
        if first == "claim" || first == "pins" { continue }
        if first == "" && !quoted_empty(text, h.span) { continue }
        let id = "{k}\n{first}"
        if !issue_at.contains_key(id) {
            issue_at.insert(id, issues.len())
            issues.push(AuditRecordIssue { record: k, key: first, span: h.span })
        }
    }
    for e in doc.entries {
        let k = match record_of(arrays, e) {
            Some(name) => name
            None => continue
        }
        // Its header made the record, unless the header was one the parser could not read.
        if !records.contains_key(k) { continue }
        let rel = e.path.slice(1, e.path.len())
        let seg = rel.get(0).unwrap()
        if seg.index >= 0 { continue }
        let first = seg.key
        if first == "claim" {
            if rel.len() == 1 && e.vtype == TOML_STRING {
                let r = records.get(k).unwrap()
                records.insert(k, AuditRecord { claim: e.value, ..r })
            }
        } else if first == "pins" {
            // `pins = { ... }` and `[K.pins]` give one entry for each pin in the table.
            if rel.len() == 2 && rel.get(1).unwrap().index < 0 && e.vtype == TOML_STRING {
                let pin = rel.get(1).unwrap()
                let r = records.get(k).unwrap()
                let mut pins = r.pins
                pins.insert(pin.key, e.value)
                records.insert(k, AuditRecord { pins: pins, ..r })
            }
        } else if first != "" || quoted_empty(text, e.key_span) {
            // A dotted or inline-table key gives several entries; the record key is reported
            // once, at the first place it is written. An inline table records its inner keys
            // before the key that holds them, so the earliest span wins and not the first entry.
            let id = "{k}\n{first}"
            let span = first_segment_span(text, e.key_span, first)
            match issue_at.get(id) {
                Some(i) => {
                    if span.start_byte < issues.get(i).unwrap().span.start_byte {
                        issues.set(i, AuditRecordIssue { record: k, key: first, span: span })
                    }
                }
                None => {
                    issue_at.insert(id, issues.len())
                    issues.push(AuditRecordIssue { record: k, key: first, span: span })
                }
            }
        }
    }
    let ordered = issues.sort_by(fn(a: AuditRecordIssue, b: AuditRecordIssue) -> Ordering {
        a.span.start_byte.cmp(b.span.start_byte)
    })
    AuditRecords { records: records, issues: ordered }
}

// The K of the record an entry sits in, or None when the entry is outside every record: above
// the first header, or in a K that a `[[K]]` header makes an array.
fn record_of(arrays: Set[Str], e: TomlEntry) -> Option[Str] {
    if e.header < 0 || e.path.len() < 2 { return None }
    let k = e.path.get(0).unwrap().key
    if arrays.contains(k) { None } else { Some(k) }
}

// The name of each top-level `[[name]]` header, which makes that name an array and not a
// record. A longer `[[K.x]]` is the key x inside record K.
fn array_names(doc: TomlDoc) -> Set[Str] {
    let mut out: Set[Str] = Set()
    for h in doc.headers {
        if h.is_array && h.path.len() == 1 { out.insert(h.path.get(0).unwrap()) }
    }
    out
}

// The parser gives an empty key both for `"" = 1` and for a line it could not read, such as
// `= 1` or `.x = 1`. Only the written `""` or `''` is a key the record does not allow.
fn quoted_empty(text: Str, span: TomlSpan) -> Bool {
    let src = text.byte_slice(span.start_byte, span.end_byte)
    src.contains("\"\"") || src.contains("''")
}

// The span of the first segment of a key: `a` in `a.b = 1`, `"a.b"` in `"a.b".c = 1`. The
// caret then marks the key the record does not allow, not the whole dotted path.
fn first_segment_span(text: Str, span: TomlSpan, first: Str) -> TomlSpan {
    let start = span.start_byte
    let mut p = start + first.byte_len()
    let q = text.byte_at(start)
    if q == 34 || q == 39 {
        p = start + 1
        while p < span.end_byte && text.byte_at(p) != q {
            if q == 34 && text.byte_at(p) == 92 { p = p + 1 }
            p = p + 1
        }
        p = p + 1
    }
    if p >= span.end_byte || span.end_line != span.line { return span }
    TomlSpan { end_col: span.col + (p - start), end_byte: p, ..span }
}
