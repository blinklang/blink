// The file work of a build, done in process. A daemon-served edit runs in a child the daemon
// forks, and each shell it started for a mkdir, a rename or a hash cost more than the work.
// Each call does what the shell command it replaces did, so a build sees the same files.
// A libc call is bound here only when the prototype the FFI writes matches the one its header
// gives: a Str parameter is written const char*, but no Blink type is written char* or a
// pointer to a C struct, so utimes(2) cannot be bound.

import std.libc.{getentropy_bytes, read_bytes, write_bytes, poll, Pollfd, POLL_EVT_IN}

// The errno values the calls below test, the same on Linux and macOS but ENOTEMPTY.
let BFS_ENOENT = 2
let BFS_EEXIST = 17
let BFS_ENOTEMPTY_LINUX = 39
let BFS_ENOTEMPTY_MACOS = 66

// mkdir -p: each missing directory of path, made with mode 0777 less the umask. True when path
// is a directory at the end, which a directory another process made first also gives.
pub fn mkdir_p(path: Str) -> Bool ! IO, FS.Write {
    if path == "" { return false }
    if is_dir(path) == 1 { return true }
    let mut prefix = if path.starts_with("/") { "/" } else { "" }
    for part in path.split("/") {
        if part == "" { continue }
        prefix = if prefix == "" || prefix == "/" { "{prefix}{part}" } else { "{prefix}/{part}" }
        if is_dir(prefix) == 1 { continue }
        with ffi.scope() as scope {
            // 511 is 0777.
            let _ = bfs_mkdir(scope.cstr(prefix), 511.to_u32())
        }
    }
    is_dir(path) == 1
}

// rm -rf: path and all under it. A link is removed, never followed. True when path is gone.
// A private dir this process holds live is unlocked once it is gone.
pub fn remove_tree(path: Str) -> Bool ! IO, FS.Delete {
    if path == "" { return false }
    if live_locks.contains_key(path) {
        let gone = remove_entries(path)
        drop_lock(path)
        return gone
    }
    remove_entries(path)
}

fn remove_entries(path: Str) -> Bool ! IO, FS.Delete {
    let mut rc = 0
    let mut err = 0
    with ffi.scope() as scope {
        rc = bfs_unlink(scope.cstr(path)).to_int()
        if rc != 0 { err = bfs_errno() }
    }
    if rc == 0 || err == BFS_ENOENT { return true }
    let e = rmdir_errno(path)
    if e == 0 || e == BFS_ENOENT { return true }
    // Only a directory with entries fails rmdir with these, so the walk below never reads
    // through a link.
    if e != BFS_ENOTEMPTY_LINUX && e != BFS_ENOTEMPTY_MACOS && e != BFS_EEXIST { return false }
    for name in list_dir(path) {
        let _ = remove_entries("{path}/{name}")
    }
    let again = rmdir_errno(path)
    again == 0 || again == BFS_ENOENT
}

// 0 when rmdir(2) removed path, else its errno, or -1 when it set none.
fn rmdir_errno(path: Str) -> Int ! IO, FS.Delete {
    let mut e = 0
    with ffi.scope() as scope {
        if bfs_rmdir(scope.cstr(path)).to_int() != 0 {
            e = bfs_errno()
            if e == 0 { e = -1 }
        }
    }
    e
}

// mv -f within one filesystem. False when rename(2) fails; mv would copy across
// filesystems, so a caller whose paths may cross one falls back to it.
pub fn rename(from: Str, to: Str) -> Bool ! IO, FS.Write {
    let mut rc = -1
    with ffi.scope() as scope {
        rc = bfs_rename(scope.cstr(from), scope.cstr(to)).to_int()
    }
    rc == 0
}

// Moves the finished private dir stage to dir with mode 0755, which mkdir -p would have given
// it, and says whether dir holds key after. rename(2) does not replace a dir that holds
// entries, so when a concurrent build put its dir there first, that dir stays and stage goes:
// a check-then-mv would put stage inside it. A dir there without key is no dir any build
// published, and goes first. It is tested for before key, so a dir another build renames in
// between is never taken for one without key.
pub fn publish_dir(stage: Str, dir: Str, key: Str) -> Bool ! IO, FS.Write, FS.Delete {
    unmark(stage)
    if file_exists(dir) == 1 && file_exists("{dir}/{key}") == 0 {
        let _ = remove_tree(dir)
    }
    let mut opened = false
    with ffi.scope() as scope {
        // 493 is 0755.
        opened = bfs_chmod(scope.cstr(stage), 493.to_u32()).to_int() == 0
    }
    if !opened || !rename(stage, dir) {
        let _ = remove_tree(stage)
    }
    file_exists("{dir}/{key}") == 1
}

let BFS_NAME_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"

// mktemp -d {parent}/{prefix}.XXXXXX: a new directory only its user may enter, named by six
// random characters, which this process holds live (hold_live) until it removes it or calls
// unmark. "" when none can be made.
pub fn private_dir(parent: Str, prefix: Str) -> Str ! IO, FS.Write, FS.Read {
    let mut tries = 0
    while tries < 100 {
        tries = tries + 1
        let bytes = match getentropy_bytes(6) {
            Ok(b) => b
            Err(_) => return ""
        }
        let mut name = StringBuilder.new()
        for b in bytes {
            let c = b.to_int() % 62
            name.write(BFS_NAME_CHARS.byte_slice(c, c + 1))
        }
        let path = "{parent}/{prefix}.{name.to_str()}"
        let mut rc = -1
        let mut err = 0
        with ffi.scope() as scope {
            // 448 is 0700, as mktemp makes it.
            rc = bfs_mkdir(scope.cstr(path), 448.to_u32()).to_int()
            if rc != 0 { err = bfs_errno() }
        }
        if rc == 0 {
            hold_live(path)
            return path
        }
        if err != BFS_EEXIST { return "" }
    }
    ""
}

// A private dir that holds LIVE_MARK is one whose owner holds a flock on it for as long as
// the owner runs, and the kernel drops that lock when the owner dies, however it dies. So a
// marked dir whose lock another process can take belongs to a dead build. A dir with no
// mark, as a compiler from before the mark makes, is never taken for dead: nothing says
// whether its build still runs.
let LIVE_MARK = ".blink-live"

// The lock descriptor of each private dir this process holds live, by path.
let mut live_locks: Map[Str, Int] = Map()

// LOCK_EX and LOCK_NB, 2 and 4 on Linux and macOS.
let BFS_LOCK_EX_NB = 6

// Whether name is the mark a live private dir holds, which a walk that clears the dir keeps.
pub fn is_live_mark(name: Str) -> Bool {
    name == LIVE_MARK
}

// Locks the new dir at path, then marks it. The mark comes only after the lock, so no reaper
// can take a marked dir for dead between the two. Where the lock cannot be taken the dir
// stays unmarked, and no reaper ever removes it.
fn hold_live(path: Str) ! IO, FS.Read {
    let mut fd = -1
    with ffi.scope() as scope {
        fd = bfs_open_read(scope.cstr(path), 0.to_i32()).to_int()
    }
    if fd < 0 { return }
    // No child gets a descriptor of the build: a cc that outlives it would pin the dir.
    if bfs_fcntl(fd.to_i32(), 2.to_i32(), 1.to_i32()).to_int() != 0 || bfs_flock(fd.to_i32(), BFS_LOCK_EX_NB.to_i32()).to_int() != 0 {
        let _ = bfs_close(fd.to_i32())
        return
    }
    write_file("{path}/{LIVE_MARK}", "")
    live_locks.insert(path, fd)
}

// Drops the mark and the lock of a private dir this process holds live, before it renames
// the dir to a name no reaper looks at. The dir stays.
pub fn unmark(path: Str) ! IO {
    match live_locks.get(path) {
        Some(fd) => {
            fs_remove("{path}/{LIVE_MARK}")
            let _ = bfs_close(fd.to_i32())
            live_locks.remove(path)
        }
        None => {}
    }
}

fn drop_lock(path: Str) ! IO {
    match live_locks.get(path) {
        Some(fd) => {
            let _ = bfs_close(fd.to_i32())
            live_locks.remove(path)
        }
        None => {}
    }
}

// Removes each private dir {parent}/{prefix}.*, for each of prefixes, that a dead build left:
// one that holds the mark and whose lock this process takes. It holds the lock while it
// removes the dir.
pub fn reap_dead(parent: Str, prefixes: List[Str]) ! IO, FS.Read, FS.Delete {
    for name in list_dir(parent) {
        let mut ours = false
        for prefix in prefixes {
            if name.starts_with("{prefix}.") { ours = true }
        }
        if !ours { continue }
        let path = "{parent}/{name}"
        if live_locks.contains_key(path) || file_exists("{path}/{LIVE_MARK}") == 0 { continue }
        let mut fd = -1
        with ffi.scope() as scope {
            fd = bfs_open_read(scope.cstr(path), 0.to_i32()).to_int()
        }
        if fd < 0 { continue }
        // The mark is checked again under the lock: a reaper that removed the dir first
        // leaves none.
        if bfs_flock(fd.to_i32(), BFS_LOCK_EX_NB.to_i32()).to_int() == 0 && file_exists("{path}/{LIVE_MARK}") == 1 {
            let _ = remove_tree(path)
        }
        let _ = bfs_close(fd.to_i32())
    }
}

// touch on a file: its mtime becomes now and its bytes stay. The first byte is written back
// over itself, as the FFI cannot bind utimes(2). A missing file is made empty, as touch makes
// it; an empty one is written empty again.
pub fn touch(path: Str) -> Bool ! IO, FS.Read, FS.Write {
    let mut fd = -1
    let mut err = 0
    with ffi.scope() as scope {
        // 2 is O_RDWR on Linux and macOS.
        fd = bfs_open_write(scope.cstr(path), 2.to_i32()).to_int()
        if fd < 0 { err = bfs_errno() }
    }
    if fd < 0 {
        if err != BFS_ENOENT { return false }
        write_file(path, "")
        return file_exists(path) == 1
    }
    let mut ok = false
    let mut empty = false
    match read_bytes(fd, 1) {
        Ok(b) => {
            if b.len() == 0 {
                empty = true
            } else if bfs_lseek(fd.to_i32(), 0, 0.to_i32()) == 0 {
                ok = match write_bytes(fd, b) {
                    Ok(n) => n == 1
                    Err(_) => false
                }
            }
        }
        Err(_) => {}
    }
    let _ = bfs_close(fd.to_i32())
    if empty {
        // There is no byte to write back; truncating an empty file moves its mtime.
        write_file(path, "")
        ok = true
    }
    ok
}

// ln: a hard link at to for the file at from. False when link(2) fails, as it does across
// filesystems or on one with no hard links.
pub fn hard_link(from: Str, to: Str) -> Bool ! IO, FS.Write {
    bfs_link(from, to).to_int() == 0
}

// cp: a new file at to with the bytes of the file at from, read and written in this process,
// as a process per file costs more than a small unit's compile. False, with to removed, when
// from cannot be read or to cannot be written.
pub fn copy_file(from: Str, to: Str) -> Bool ! IO, FS.Read, FS.Write, FS.Delete {
    let mut src = -1
    with ffi.scope() as scope {
        src = bfs_open_read(scope.cstr(from), 0.to_i32()).to_int()
    }
    if src < 0 { return false }
    write_file(to, "")
    let mut dst = -1
    with ffi.scope() as scope {
        // 1 is O_WRONLY on Linux and macOS.
        dst = bfs_open_write(scope.cstr(to), 1.to_i32()).to_int()
    }
    let mut ok = dst >= 0
    let mut done = false
    while ok && !done {
        match read_bytes(src, 65536) {
            Ok(b) => {
                if b.len() == 0 {
                    done = true
                } else {
                    ok = write_all(dst, b)
                }
            }
            Err(_) => { ok = false }
        }
    }
    let _ = bfs_close(src.to_i32())
    if dst >= 0 {
        let _ = bfs_close(dst.to_i32())
    }
    if !ok {
        let _ = remove_tree(to)
    }
    ok
}

// write(2) until all of data is written, as a write may take only part of it.
fn write_all(fd: Int, data: Bytes) -> Bool ! IO {
    let mut rest = data
    while rest.len() > 0 {
        match write_bytes(fd, rest) {
            Ok(n) => {
                if n <= 0 { return false }
                rest = rest.slice(n, rest.len())
            }
            Err(_) => { return false }
        }
    }
    true
}

// The size of the file at path in bytes, or -1 when it cannot be opened.
pub fn file_size(path: Str) -> Int ! IO, FS.Read {
    let mut size = -1
    with ffi.scope() as scope {
        let fd = bfs_open_read(scope.cstr(path), 0.to_i32()).to_int()
        if fd >= 0 {
            // 2 is SEEK_END on Linux and macOS.
            size = bfs_lseek(fd.to_i32(), 0, 2.to_i32())
            let _ = bfs_close(fd.to_i32())
        }
    }
    size
}

// The path with each symbolic link resolved, or None when realpath(3) cannot resolve it, such
// as a missing file.
pub fn real_path(path: Str) -> Option[Str] ! FS.Read {
    let mut real: Option[Str] = None
    with ffi.scope() as scope {
        let buf = scope.alloc_n[U8](4096)
        if !bfs_realpath(scope.cstr(path), buf).is_null() {
            real = buf.to_str()
        }
    }
    real
}

// Whether the files at a and b hold the same bytes. False when either cannot be read.
pub fn same_bytes(a: Str, b: Str) -> Bool ! IO, FS.Read {
    match read_all(a) {
        Some(x) => {
            match read_all(b) {
                Some(y) => x == y
                None => false
            }
        }
        None => false
    }
}

// The whole file as bytes: a Str read would stop at the first NUL byte.
fn read_all(path: Str) -> Option[Bytes] ! IO, FS.Read {
    let mut fd = -1
    with ffi.scope() as scope {
        fd = bfs_open_read(scope.cstr(path), 0.to_i32()).to_int()
    }
    if fd < 0 { return None }
    let mut all = Bytes.new()
    let mut ok = true
    let mut done = false
    while ok && !done {
        match read_bytes(fd, 1048576) {
            Ok(b) => {
                if b.len() == 0 {
                    done = true
                } else {
                    all = all.concat(b)
                }
            }
            Err(_) => { ok = false }
        }
    }
    let _ = bfs_close(fd.to_i32())
    if ok { Some(all) } else { None }
}

// The path execvp runs for name, or "" when it finds none. An empty PATH entry is the working
// directory, and an unset PATH is the one glibc's execvp searches.
pub fn find_program(name: Str) -> Str ! IO, FS.Read {
    if name == "" { return "" }
    if name.contains("/") {
        return if is_executable(name) { name } else { "" }
    }
    let path = env.var("PATH") ?? "/bin:/usr/bin"
    for d in path.split(":") {
        let candidate = if d == "" { name } else { "{d}/{name}" }
        if is_executable(candidate) {
            return if d == "" { "./{name}" } else { candidate }
        }
    }
    ""
}

fn is_executable(path: Str) -> Bool ! IO, FS.Read {
    if is_dir(path) == 1 { return false }
    let mut rc = -1
    with ffi.scope() as scope {
        // 1 is X_OK on Linux and macOS.
        rc = bfs_access(scope.cstr(path), 1.to_i32()).to_int()
    }
    rc == 0
}

// The CPUs this process may run on, as nproc counts them. A daemon worker asks once, before
// it forks a build child, so no child starts nproc; a change to the worker's CPU affinity
// while the daemon lives is not seen.
let mut bfs_cpu_count: Int = 0

pub fn cpu_count() -> Int ! IO, FS.Read {
    if bfs_cpu_count <= 0 {
        let mut n = 0
        if find_program("nproc") != "" { n = run_out("nproc", []).trim().to_int() }
        if n <= 0 && find_program("getconf") != "" { n = run_out("getconf", ["_NPROCESSORS_ONLN"]).trim().to_int() }
        bfs_cpu_count = if n > 0 { n } else { 1 }
    }
    bfs_cpu_count
}

// What program printed to stdout, or "" when it could not run; the count above then falls back.
fn run_out(program: Str, args: List[Str]) -> Str {
    match process.run(program, args) {
        Ok(r) => r.out
        Err(_) => ""
    }
}

// The bytes sh reads as more than a part of a word: quotes and escapes, globs, expansions,
// redirects, lists, comments, braces bash expands, and any space but the one between words.
let BFS_SHELL_BYTES = "|&;<>()$`\\\"'*?[]#~\{}!\t\n\r"

// The words sh would split cmd into, when sh would do no more than split it at spaces, or []
// when it would do more, so only sh may run it. A first word holding `=` is an assignment.
pub fn plain_words(cmd: Str) -> List[Str] {
    for c in cmd {
        if BFS_SHELL_BYTES.contains(c.to_str()) { return [] }
    }
    let mut words: List[Str] = []
    for w in cmd.split(" ") {
        if w != "" { words.push(w) }
    }
    if words.len() == 0 || words.get(0).unwrap().contains("=") { return [] }
    words
}

// Runs program with args as sh runs a command: on this process's stdin, stdout and stderr,
// which a captured run would turn into pipes and so take a compiler's colors away. Its exit
// code, 127 when it could not start, as sh gives, or -1 when a signal ended it or no child
// could be made.
pub fn run_program(program: Str, args: List[Str]) -> Int ! IO, Process.Spawn, Env.Exit {
    // The child inherits what stdout holds unflushed, and exec flushes it there.
    io.write("")
    let pid = bfs_fork().to_int()
    if pid == 0 {
        exec_in_child(program, args)
    }
    if pid < 0 { return -1 }
    let mut status = -1
    with ffi.scope() as scope {
        let cell = scope.alloc[I32]()
        loop {
            let r = bfs_waitpid(pid.to_i32(), cell, 0.to_i32()).to_int()
            if r == pid {
                status = cell.deref().to_int()
                break
            }
            // EINTR is 4 on Linux and macOS.
            if r > 0 || bfs_errno() != 4 { break }
        }
    }
    if status < 0 || (status & 127) != 0 { return -1 }
    (status >> 8) & 255
}

// The line cmd as sh -c runs it, through run_program: on this process's stdin, stdout and
// stderr, its exit code, or -1 when a signal ended it.
pub fn run_shell(cmd: Str) -> Int ! IO, Process.Spawn, Env.Exit {
    run_program("sh", ["-c", cmd])
}

// In a child bfs_fork made: becomes program, or ends with 127 and the reason on stderr, as sh
// does for a program it cannot run. _exit, not env.exit, as the child holds a copy of this
// process's state and must run none of its exit work.
fn exec_in_child(program: Str, args: List[Str]) -> Never ! IO, Process.Spawn, Env.Exit {
    let e = process.exec(program, args).unwrap_err()
    io.eprintln("{e}")
    bfs_exit_now(127.to_i32())
}

// A child spawn_to_files started. live is the read end of a pipe whose write end only the
// child and the processes it starts hold, so the pipe hangs up once they have all ended, as
// the pipes of a captured run reach their end; -1 once it has. status is the wait status
// waitpid gave for the child, -1 while no wait has seen it end, or -2 when waitpid failed. A
// pid of -1 is a child that could not start, or one the caller has reaped.
pub type FileChild {
    pid: Int
    live: Int
    status: Int
    out_path: Str
    err_path: Str
}

// Starts program with args, its stdout and stderr written to out_path and err_path and its
// stdin this process's own. Files, not pipes: a pipe this process does not drain while it
// waits for another child fills, and its child stops.
pub fn spawn_to_files(program: Str, args: List[Str], out_path: Str, err_path: Str) -> FileChild ! IO, FS.Read, FS.Write, Process.Spawn, Env.Exit {
    // open() here never creates.
    write_file(out_path, "")
    write_file(err_path, "")
    let mut out_fd = -1
    let mut err_fd = -1
    let mut live = -1
    let mut live_w = -1
    with ffi.scope() as scope {
        out_fd = bfs_open_write(scope.cstr(out_path), 1.to_i32()).to_int()
        err_fd = bfs_open_write(scope.cstr(err_path), 1.to_i32()).to_int()
        let ends = scope.alloc_n[I32](2)
        if bfs_pipe(ends).to_int() == 0 {
            live = ends.deref().to_int()
            live_w = ends.offset(1).deref().to_int()
        }
    }
    // This process holds live while later children start, and a child that held it would
    // keep the pipe of another open. F_SETFD and FD_CLOEXEC are 2 and 1 on Linux and macOS.
    if live >= 0 && bfs_fcntl(live.to_i32(), 2.to_i32(), 1.to_i32()).to_int() != 0 {
        let _ = bfs_close(live.to_i32())
        let _ = bfs_close(live_w.to_i32())
        live = -1
        live_w = -1
    }
    let mut pid = -1
    if out_fd >= 0 && err_fd >= 0 && live >= 0 {
        // The child inherits what stdout holds unflushed, and exec flushes it into out_path.
        io.write("")
        pid = bfs_fork().to_int()
        if pid == 0 {
            let _ = bfs_dup2(out_fd.to_i32(), 1.to_i32())
            let _ = bfs_dup2(err_fd.to_i32(), 2.to_i32())
            // With stdout or stderr closed, open() can hand out 1 or 2 itself.
            if out_fd > 2 { let _ = bfs_close(out_fd.to_i32()) }
            if err_fd > 2 { let _ = bfs_close(err_fd.to_i32()) }
            let _ = bfs_close(live.to_i32())
            exec_in_child(program, args)
        }
    }
    // Before the next spawn: a later child that inherits live_w would hold this pipe open.
    for fd in [out_fd, err_fd, live_w] {
        if fd >= 0 { let _ = bfs_close(fd.to_i32()) }
    }
    if pid < 0 && live >= 0 {
        let _ = bfs_close(live.to_i32())
    }
    FileChild { pid: pid, live: if pid < 0 { -1 } else { live }, status: -1, out_path: out_path, err_path: err_path }
}

// A pipe with FD_CLOEXEC on both ends, as (read end, write end), or (-1, -1). A process that
// forks, and whose child holds the write end and never execs, reads the end of the pipe once
// the child ends: the child's own children drop the ends when they exec.
pub fn exit_pipe() -> (Int, Int) ! IO {
    let mut r = -1
    let mut w = -1
    with ffi.scope() as scope {
        let ends = scope.alloc_n[I32](2)
        if bfs_pipe(ends).to_int() == 0 {
            r = ends.deref().to_int()
            w = ends.offset(1).deref().to_int()
        }
    }
    if r < 0 { return (-1, -1) }
    // F_SETFD and FD_CLOEXEC are 2 and 1 on Linux and macOS.
    if bfs_fcntl(r.to_i32(), 2.to_i32(), 1.to_i32()).to_int() != 0 || bfs_fcntl(w.to_i32(), 2.to_i32(), 1.to_i32()).to_int() != 0 {
        let _ = bfs_close(r.to_i32())
        let _ = bfs_close(w.to_i32())
        return (-1, -1)
    }
    (r, w)
}

// The longest wait_children waits between two waitpid sweeps. A process a child started can
// hold its pipe open after the child ends, and then only a sweep finds the end.
let BFS_SWEEP_MS = 50

// Waits until at least one running child has ended and answers children with what it found:
// each pipe that hung up closed, and each child that ended with its status. A pipe hangs up
// as the child ends, a moment before waitpid can see it, so a sweep follows each wake, and a
// child whose pipe hung up but that no sweep has seen end is swept again a millisecond later.
// When poll fails for more than a signal, it waits on the first running child. Answers
// children as they were when none runs.
pub fn wait_children(children: List[FileChild]) -> List[FileChild] ! IO, Process.Spawn {
    let mut kids: List[FileChild] = []
    for c in children { kids.push(c) }
    loop {
        let mut fds: List[Pollfd] = []
        let mut places: List[Int] = []
        let mut running = 0
        let mut hung_up = false
        let mut i = 0
        while i < kids.len() {
            let c = kids.get(i).unwrap()
            if c.pid > 0 && c.status == -1 {
                running = running + 1
                if c.live >= 0 {
                    fds.push(Pollfd { fd: c.live.to_i32(), events: POLL_EVT_IN.to_i16(), revents: 0.to_i16() })
                    places.push(i)
                } else {
                    hung_up = true
                }
            }
            i = i + 1
        }
        if running == 0 { return kids }
        let wait_ms = if hung_up { 1 } else { BFS_SWEEP_MS }
        if fds.len() == 0 {
            // poll skips a negative fd, so this only waits out wait_ms.
            let _ = poll([Pollfd { fd: (-1).to_i32(), events: 0.to_i16(), revents: 0.to_i16() }], wait_ms)
        } else {
            match poll(fds, wait_ms) {
                Ok(got) => {
                    let mut j = 0
                    while j < got.len() {
                        // No one writes to the pipe, so any event is its end: a hang-up, or a
                        // read of nothing where a host reports no hang-up for a pipe.
                        if got.get(j).unwrap().revents.to_int() != 0 {
                            let at = places.get(j).unwrap()
                            let c = kids.get(at).unwrap()
                            let _ = bfs_close(c.live.to_i32())
                            kids.set(at, FileChild { live: -1, ..c })
                        }
                        j = j + 1
                    }
                }
                Err(_) => {
                    // EINTR is 4 on Linux and macOS: a signal handler ran.
                    if bfs_errno() != 4 {
                        let mut k = 0
                        while kids.get(k).unwrap().pid <= 0 || kids.get(k).unwrap().status != -1 {
                            k = k + 1
                        }
                        let c = kids.get(k).unwrap()
                        kids.set(k, FileChild { status: wait_status(c.pid, 0), ..c })
                        return kids
                    }
                }
            }
        }
        let mut ended = false
        let mut k = 0
        while k < kids.len() {
            let c = kids.get(k).unwrap()
            if c.pid > 0 && c.status == -1 {
                // WNOHANG is 1 on Linux and macOS.
                let s = wait_status(c.pid, 1)
                if s != -1 {
                    kids.set(k, FileChild { status: s, ..c })
                    ended = true
                }
            }
            k = k + 1
        }
        if ended { return kids }
    }
    kids
}

// The wait status of child pid once waitpid with options sees it end, -1 when WNOHANG finds
// it running, or -2 when waitpid fails for more than a signal.
fn wait_status(pid: Int, options: Int) -> Int ! IO, Process.Spawn {
    let mut status = -2
    with ffi.scope() as scope {
        let cell = scope.alloc[I32]()
        loop {
            let r = bfs_waitpid(pid.to_i32(), cell, options.to_i32()).to_int()
            if r == pid {
                status = cell.deref().to_int()
                break
            }
            if r == 0 {
                status = -1
                break
            }
            // EINTR is 4 on Linux and macOS.
            if r > 0 || bfs_errno() != 4 { break }
        }
    }
    status
}

// What reap_to_files answers. Its own type, not std.process.ProcessResult: the pinned gen0
// builds src against its own lib/std, so src must not depend on the shape that type has in
// this tree's lib.
pub type ReapedChild {
    out: Str
    err_out: Str
    exit_code: Int
}

// Waits for child to end, unless wait_children saw it end, and answers its exit code (128
// plus the signal that ended it, as a captured run gives) and its output, then removes its
// output files.
pub fn reap_to_files(child: FileChild) -> ReapedChild ! IO, Process.Spawn {
    if child.live >= 0 {
        let _ = bfs_close(child.live.to_i32())
    }
    let mut exit_code = -1
    let mut err_note = ""
    if child.pid > 0 {
        let status = if child.status == -1 { wait_status(child.pid, 0) } else { child.status }
        if status >= 0 {
            if (status & 127) == 0 {
                exit_code = (status >> 8) & 255
            } else if (status & 127) != 127 {
                exit_code = 128 + (status & 127)
            }
        }
    } else {
        err_note = "fork() failed"
    }
    let out = read_file(child.out_path)
    let err_out = read_file(child.err_path)
    fs_remove(child.out_path)
    fs_remove(child.err_path)
    ReapedChild { out: out, err_out: "{err_out}{err_note}", exit_code: exit_code }
}

// An @ffi function's C name has no module part, so these carry the module in their own names.
@ffi("_exit", header: "unistd.h")
@trusted(audit: "Wraps _exit(2) in a forked child that could not exec. Takes an int, returns never, touches no memory.")
fn bfs_exit_now(code: I32) -> Never ! Env.Exit {}

@ffi("mkdir", header: "sys/stat.h")
@trusted(audit: "Wraps mkdir(2). path is a NUL-terminated copy from ffi.scope(); mode is 0777 or 0700.")
fn bfs_mkdir(path: Ptr[U8], mode: U32) -> I32 ! FS.Write {}

@ffi("unlink", header: "unistd.h")
@trusted(audit: "Wraps unlink(2). path is a NUL-terminated copy from ffi.scope().")
fn bfs_unlink(path: Ptr[U8]) -> I32 ! FS.Delete {}

@ffi("rmdir", header: "unistd.h")
@trusted(audit: "Wraps rmdir(2). path is a NUL-terminated copy from ffi.scope().")
fn bfs_rmdir(path: Ptr[U8]) -> I32 ! FS.Delete {}

@ffi("rename", header: "stdio.h")
@trusted(audit: "Wraps rename(2). Both paths are NUL-terminated copies from ffi.scope().")
fn bfs_rename(from: Ptr[U8], to: Ptr[U8]) -> I32 ! FS.Write {}

@ffi("chmod", header: "sys/stat.h")
@trusted(audit: "Wraps chmod(2). path is a NUL-terminated copy from ffi.scope(); mode is 0755.")
fn bfs_chmod(path: Ptr[U8], mode: U32) -> I32 ! FS.Write {}

@ffi("link", header: "unistd.h")
@trusted(audit: "Wraps link(2). A Str is NUL-terminated and holds no NUL, so each path reaches C whole.")
fn bfs_link(from: Str, to: Str) -> I32 ! FS.Write {}

// open(2) is bound twice so that a caller that only reads does not need the write row.
@ffi("open", header: "fcntl.h")
@trusted(audit: "Wraps open(2) with no mode, so it never creates. path is a NUL-terminated copy from ffi.scope(); flags is O_RDONLY, 0 on every host.")
fn bfs_open_read(path: Ptr[U8], flags: I32) -> I32 ! FS.Read {}

@ffi("open", header: "fcntl.h")
@trusted(audit: "Wraps open(2) with no mode, so it never creates. path is a NUL-terminated copy from ffi.scope(); flags is O_WRONLY or O_RDWR, 1 and 2 on every host.")
fn bfs_open_write(path: Ptr[U8], flags: I32) -> I32 ! FS.Read, FS.Write {}

@ffi("close", header: "unistd.h")
@trusted(audit: "Wraps close(2) on a descriptor bfs_open_read, bfs_open_write or bfs_pipe returned.")
fn bfs_close(fd: I32) -> I32 ! FFI {}

@ffi("realpath", header: "stdlib.h")
@trusted(audit: "Wraps realpath(3). path is a NUL-terminated copy from ffi.scope(); resolved is a 4096-byte buffer from ffi.scope(), PATH_MAX or more on every host, which realpath fills on success.")
fn bfs_realpath(path: Ptr[U8], resolved: Ptr[U8]) -> Ptr[U8] ! FS.Read {}

@ffi("lseek", header: "unistd.h")
@trusted(audit: "Wraps lseek(2). fd is one bfs_open_read or bfs_open_write returned; whence is SEEK_SET or SEEK_END, 0 and 2 on every host.")
fn bfs_lseek(fd: I32, offset: Int, whence: I32) -> Int ! FS.Read {}

@ffi("access", header: "unistd.h")
@trusted(audit: "Wraps access(2). path is a NUL-terminated copy from ffi.scope(); mode is X_OK, 1 on every host.")
fn bfs_access(path: Ptr[U8], mode: I32) -> I32 ! FS.Read {}

@ffi("blink_errno_get")
@trusted(audit: "Wraps the runtime blink_errno_get(), which returns errno. Read right after the failed call.")
fn bfs_errno() -> Int ! FFI {}

@ffi("fork", header: "unistd.h")
@trusted(audit: "Wraps fork(2). The child only execs, as the runtime's own process calls do after their fork.")
fn bfs_fork() -> I32 ! Process.Spawn {}

@ffi("waitpid", header: "sys/wait.h")
@trusted(audit: "Wraps waitpid(2) on a child bfs_fork made. status is one I32 cell from ffi.scope(); options is 0, so it blocks, or WNOHANG, 1 on Linux and macOS.")
fn bfs_waitpid(pid: I32, status: Ptr[I32], options: I32) -> I32 ! Process.Spawn {}

@ffi("pipe", header: "unistd.h")
@trusted(audit: "Wraps pipe(2). fds is a two-I32 buffer from ffi.scope(); int is 32 bits on every host.")
fn bfs_pipe(fds: Ptr[I32]) -> I32 ! FFI {}

@ffi("fcntl", header: "fcntl.h")
@trusted(audit: "Wraps fcntl(2) with F_SETFD and FD_CLOEXEC, 2 and 1 on Linux and macOS, on a descriptor bfs_pipe or bfs_open_read made. The third argument is an int, as F_SETFD takes.")
fn bfs_fcntl(fd: I32, cmd: I32, arg: I32) -> I32 ! FFI {}

@ffi("flock", header: "sys/file.h")
@trusted(audit: "Wraps flock(2) on a descriptor bfs_open_read returned. op is LOCK_EX with LOCK_NB, 2 and 4 on Linux and macOS, so it never blocks.")
fn bfs_flock(fd: I32, op: I32) -> I32 ! FFI {}

@ffi("dup2", header: "unistd.h")
@trusted(audit: "Wraps dup2(2) in a child bfs_fork made, on descriptors bfs_open_write returned, before it execs.")
fn bfs_dup2(from: I32, to: I32) -> I32 ! FFI {}
