// Per-module .o content-addressed cache.
//
// Cache key = 16-hex SHA-256 over a deterministic manifest (schema,
// module key, src sha, sorted import shas, runtime sha, blinkc sha,
// cc id, sorted flags, target). Layout under obj_cache_dir():
//
//   <16-hex>.o                — the cached object
//   <16-hex>.meta             — "<unix-mtime> <module_key> <src_sha>"
//   tmp/unit.<rand>/          — a build's private C snapshot and staged .o
//   tmp/<label>.<pid>.<n>.o   — `blink cache __store` staging
//
// Hits touch .meta mtime so LRU-by-mtime survives stdlib re-reads.
// Stores rename(2) into place. Two parallel jobs racing on the same
// key both compile and both rename — content is byte-identical.

import build_fs
import sha256.{sha256_hex, sha256_file_hex}
import std_cache_key.{sha256_of_manifest, sha256_of_file_first, IN_PROCESS_HASH_BYTES}

pub fn obj_cache_dir() -> Str {
    let override_val = env.var("BLINK_CACHE_DIR") ?? ""
    if override_val == "" {
        return "build/obj-cache"
    }
    override_val
}

pub fn cache_enabled() -> Bool {
    // Empty BLINK_CACHE_DIR explicitly disables the cache (used by the
    // bootstrap loop). Unset uses the default `build/obj-cache`.
    (env.var("BLINK_CACHE_DIR") ?? "x") != ""
}

fn cache_size_cap_mb() -> Int {
    let v = env.var("BLINK_CACHE_SIZE_MB") ?? ""
    if v == "" {
        return 2048
    }
    v.to_int()
}

pub fn ensure_dir() ! IO {
    let _ = build_fs.mkdir_p("{obj_cache_dir()}/tmp")
}

// Per-process counter so each call to make_staging_path is unique even
// when invoked back-to-back inside the same build.
let mut stage_counter: Int = 0

// Produce a per-process unique staging path under tmp/. The header
// comment promises tmp/<pid>.<rand>.o atomicity — parallel jobs that
// hit the same key must not collide on the staging file.
pub fn make_staging_path(label: Str) -> Str {
    stage_counter = stage_counter + 1
    let pid = getpid()
    "{obj_cache_dir()}/tmp/{label}.{pid}.{stage_counter}.o"
}

// A directory no other build writes, under tmp/ so a rename out of it stays on one
// filesystem. A pid and a counter are not enough: two pid namespaces can share a cache
// dir. "" when it cannot be made.
pub fn make_private_dir() -> Str ! IO {
    ensure_dir()
    build_fs.private_dir("{obj_cache_dir()}/tmp", "unit")
}

fn cc_identity() -> Str {
    let res = process_run("sh", ["-c", "cc --version 2>&1 | head -1"])
    res.out.trim()
}

fn sort_lines(s: Str) -> Str {
    if s == "" {
        return ""
    }
    let cmd = "printf '%s' \"{s}\" | sort"
    let res = process_run("sh", ["-c", cmd])
    res.out
}

// Build the manifest text, then hash it. Caller passes pre-computed
// shas where possible to avoid re-reading files on every call.
pub fn compute_obj_key(
    module_key: Str,
    src_sha: Str,
    dep_header_lines: List[Str],
    runtime_sha: Str,
    blinkc_sha: Str,
    cc_id: Str,
    flags: List[Str],
    target: Str,
) -> Str {
    let mut imp = StringBuilder.new()
    let mut i = 0
    while i < dep_header_lines.len() {
        if i > 0 { imp.write("\n") }
        imp.write(dep_header_lines.get(i).unwrap())
        i = i + 1
    }
    let imports_sorted = sort_lines(imp.to_str()).trim()

    let mut fl = StringBuilder.new()
    let mut k = 0
    while k < flags.len() {
        if k > 0 { fl.write("\n") }
        fl.write(flags.get(k).unwrap())
        k = k + 1
    }
    let flags_sorted = sort_lines(fl.to_str()).trim()

    let mut m = StringBuilder.new()
    m.write("schema:1\n")
    m.write("mod:{module_key}\n")
    m.write("src_sha:{src_sha}\n")
    m.write("imports:{imports_sorted}\n")
    m.write("runtime_sha:{runtime_sha}\n")
    m.write("blinkc_sha:{blinkc_sha}\n")
    m.write("cc_id:{cc_id}\n")
    m.write("flags:{flags_sorted}\n")
    m.write("target:{target}\n")
    sha256_of_manifest(m.to_str())
}

// "<path>=<sha256>" for each header in dirs. None when one cannot be hashed, so a header
// the unit may read never drops out of the key.
fn header_lines_in(dirs: List[Str]) -> Option[List[Str]] ! IO {
    let mut lines: List[Str] = []
    let mut paths: List[Str] = []
    for d in dirs {
        for name in list_dir(d) {
            // What the glob "$d"/*.h names: no dotfile, and only what exists past a link.
            if name.starts_with(".") || !name.ends_with(".h") { continue }
            let path = "{d}/{name}"
            if file_exists(path) == 1 { paths.push(path) }
        }
    }
    let shas = hash_files(paths)
    for path in paths {
        match shas.get(path) {
            Some(sha) => lines.push("{path}={sha}")
            None => return None
        }
    }
    Some(lines)
}

// The key of a user unit compiled from the C at src_path. The unit includes
// libblink_std.h from arc_dir, which includes the runtime.h beside it; cc reads a
// libblink_std.h.gch there in place of the header; a vendored dependency's headers come
// from its include dir. Each shapes the object, so each is in the key. "" when an input
// cannot be read: a key without it would match an object built from other headers.
pub fn user_unit_key(
    src_path: Str,
    module_key: Str,
    arc_dir: Str,
    vendored_include_dirs: List[Str],
    blinkc_sha: Str,
    cc_id: Str,
    flags: List[Str],
    target: Str,
) -> Str ! IO {
    if blinkc_sha == "" || cc_id == "" {
        return ""
    }
    let src_sha = sha256_of_file_first(src_path)
    let runtime_sha = sha256_of_file_first("{arc_dir}/runtime.h")
    let archive_header_sha = sha256_of_file_first("{arc_dir}/libblink_std.h")
    if src_sha == "" || runtime_sha == "" || archive_header_sha == "" {
        return ""
    }
    let mut headers = ["libblink_std.h={archive_header_sha}"]
    let pch = "{arc_dir}/libblink_std.h.gch"
    if file_exists(pch) == 1 {
        let pch_sha = sha256_of_file_first(pch)
        if pch_sha == "" {
            return ""
        }
        headers.push("libblink_std.h.gch={pch_sha}")
    }
    match header_lines_in(vendored_include_dirs) {
        Some(lines) => {
            for line in lines {
                headers.push(line)
            }
        }
        None => {
            return ""
        }
    }
    compute_obj_key(module_key, src_sha, headers, runtime_sha, blinkc_sha, cc_id, flags, target)
}

pub fn sorted_strs(xs: List[Str]) -> List[Str] {
    let mut out: List[Str] = []
    for x in xs {
        out.push(x)
        let mut i = out.len() - 1
        while i > 0 && out.get(i - 1).unwrap() > x {
            out.set(i, out.get(i - 1).unwrap())
            i = i - 1
        }
        out.set(i, x)
    }
    out
}

// The sha of each file in paths, by its path; a file that cannot be read is absent. Files
// that together hold more than IN_PROCESS_HASH_BYTES go to sha256sum, one exec per run of
// paths that fits an exec argument list, since past that it hashes faster than this process
// does; the rest, and any file sha256sum did not answer for, are hashed in process.
fn hash_files(paths: List[Str]) -> Map[Str, Str] ! IO {
    let mut m: Map[Str, Str] = Map()
    let mut total = 0
    for p in paths {
        let n = build_fs.file_size(p)
        if n > 0 { total = total + n }
    }
    if total > IN_PROCESS_HASH_BYTES && build_fs.find_program("sha256sum") != "" {
        for run in exec_sized_batches(paths) {
            let mut args = ["--"]
            for p in run { args.push(p) }
            let r = process_run("sha256sum", args)
            for line in r.out.lines() {
                // sha256sum prints "<64 hex>  <name>", and starts the line with a backslash
                // when it had to escape the name, which then misses below.
                if line.byte_len() < 67 || line.starts_with("\\") { continue }
                m.insert(line.byte_slice(66, line.byte_len()), line.byte_slice(0, 64))
            }
        }
    }
    for p in paths {
        if m.contains_key(p) { continue }
        match sha256_file_hex(p) {
            Some(sha) => m.insert(p, sha)
            None => {}
        }
    }
    m
}

// The keys of the per-module build's units in dir, by module. A unit includes the headers in
// dir that unit_headers names for it, libblink_std.h and the runtime.h beside it from arc_dir
// (or the .gch cc reads in place of the header), and the vendored headers, so a key covers all
// of them along with the unit's own C, and no other header in dir: one module's header can
// change without a new key for a unit that does not include it. The headers are named by their
// name in dir, not by the path of dir, which differs on every build. A module whose key cannot
// be built is absent, and its unit compiles without the cache: a key that left out an input it
// could not read would match an object built from other bytes. Every file is hashed by one
// process, and the manifests by one more, since a process per file or unit costs more than the
// hashing on a no-change build.
pub fn unit_keys(
    dir: Str,
    modules: List[Str],
    unit_headers: Map[Str, List[Str]],
    arc_dir: Str,
    vendored_include_dirs: List[Str],
    blinkc_sha: Str,
    cc_id: Str,
    flags: List[Str],
    target: Str,
) -> Map[Str, Str] ! IO {
    if blinkc_sha == "" || cc_id == "" || modules.len() == 0 {
        return Map()
    }
    match unit_file_shas(dir, arc_dir) {
        Some(shas) => unit_keys_from(shas, modules, unit_headers, arc_dir, vendored_include_dirs, blinkc_sha, cc_id, flags, target)
        None => Map()
    }
}

// The sha of each file a unit key covers: the archive's runtime.h, libblink_std.h and .gch,
// by their path, and every .h and .c in dir, by their name in dir. A file that could not be
// read is absent. None when dir is not a directory.
pub fn unit_file_shas(dir: Str, arc_dir: Str) -> Option[Map[Str, Str]] ! IO {
    unit_file_shas_with(dir, arc_dir, [])
}

// unit_file_shas, and the sha of each file in dir that extra names, by that name.
pub fn unit_file_shas_with(dir: Str, arc_dir: Str, extra: List[Str]) -> Option[Map[Str, Str]] ! IO {
    if is_dir(dir) != 1 {
        return None
    }
    let mut paths: List[Str] = []
    for f in ["{arc_dir}/runtime.h", "{arc_dir}/libblink_std.h", "{arc_dir}/libblink_std.h.gch"] {
        if file_exists(f) == 1 { paths.push(f) }
    }
    let arc_count = paths.len()
    let mut names: List[Str] = []
    for name in list_dir(dir) {
        // What the glob *.h *.c names: no dotfile.
        if name.starts_with(".") || !(name.ends_with(".h") || name.ends_with(".c")) { continue }
        names.push(name)
    }
    for name in extra { names.push(name) }
    for name in names {
        if file_exists("{dir}/{name}") == 1 { paths.push("{dir}/{name}") }
    }
    let shas = hash_files(paths)
    let mut m: Map[Str, Str] = Map()
    let mut i = 0
    while i < paths.len() {
        let p = paths.get(i).unwrap()
        match shas.get(p) {
            Some(sha) => {
                let key = if i < arc_count { p } else { p.byte_slice(dir.byte_len() + 1, p.byte_len()) }
                m.insert(key, sha)
            }
            None => {}
        }
        i = i + 1
    }
    Some(m)
}

// The sha of each file in dir that names lists, by that name. A file that could not be read
// is absent.
pub fn file_shas(dir: Str, names: List[Str]) -> Map[Str, Str] ! IO {
    let mut m: Map[Str, Str] = Map()
    if is_dir(dir) != 1 {
        return m
    }
    let mut paths: List[Str] = []
    for n in names { paths.push("{dir}/{n}") }
    let shas = hash_files(paths)
    for n in names {
        match shas.get("{dir}/{n}") {
            Some(sha) => m.insert(n, sha)
            None => {}
        }
    }
    m
}

// unit_keys over shas unit_file_shas answered for dir and arc_dir.
pub fn unit_keys_from(
    shas: Map[Str, Str],
    modules: List[Str],
    unit_headers: Map[Str, List[Str]],
    arc_dir: Str,
    vendored_include_dirs: List[Str],
    blinkc_sha: Str,
    cc_id: Str,
    flags: List[Str],
    target: Str,
) -> Map[Str, Str] ! IO {
    let mut keys: Map[Str, Str] = Map()
    if blinkc_sha == "" || cc_id == "" || modules.len() == 0 {
        return keys
    }
    let runtime_h = "{arc_dir}/runtime.h"
    let archive_h = "{arc_dir}/libblink_std.h"
    let pch = "{arc_dir}/libblink_std.h.gch"
    let runtime_sha = shas.get(runtime_h) ?? ""
    let archive_sha = shas.get(archive_h) ?? ""
    if runtime_sha == "" || archive_sha == "" {
        return keys
    }
    let mut headers = ["libblink_std.h={archive_sha}"]
    if file_exists(pch) == 1 {
        let pch_sha = shas.get(pch) ?? ""
        if pch_sha == "" {
            return keys
        }
        headers.push("libblink_std.h.gch={pch_sha}")
    }
    match header_lines_in(vendored_include_dirs) {
        Some(lines) => {
            for line in lines {
                headers.push(line)
            }
        }
        None => {
            return keys
        }
    }
    // The inputs every unit shares go into one digest that each unit's manifest names. Put
    // in full in every manifest, the header list grows with units times headers.
    let mut shared = ["schema:unit-3", "runtime_sha:{runtime_sha}", "blinkc_sha:{blinkc_sha}", "cc_id:{cc_id}", "target:{target}"]
    for line in sorted_strs(headers) {
        shared.push("import:{line}")
    }
    for f in sorted_strs(flags) {
        shared.push("flag:{f}")
    }
    let shared_sha = digest_of_lines(shared)
    if shared_sha == "" {
        return keys
    }
    for m in modules {
        let src_sha = shas.get("{m}.c") ?? ""
        if src_sha == "" { continue }
        // A unit with no header list would get a key that covers none of its headers.
        let names = match unit_headers.get(m) {
            Some(hs) => hs
            None => continue
        }
        let mut text = "mod:{m}\nsrc_sha:{src_sha}\nshared:{shared_sha}"
        let mut readable = true
        for name in sorted_strs(names) {
            let sha = shas.get(name) ?? ""
            if sha == "" { readable = false }
            text = "{text}\nunit:{name}={sha}"
        }
        if !readable { continue }
        // The bytes sha256sum hashed when the manifest went through a file: the text and a
        // newline.
        keys.insert(m, sha256_hex("{text}\n").byte_slice(0, 16))
    }
    keys
}

// Linux caps one exec argument at 128 KiB. The keys on disk were made when each run of
// digest_of_lines went to sha256sum as one `sh -c` argument, so the runs keep that size, and
// it bounds the paths hash_files gives one sha256sum.
let EXEC_ARG_BUDGET: Int = 65536

// texts in order, split into runs whose total size stays under EXEC_ARG_BUDGET. A text over
// the budget gets a run of its own.
fn exec_sized_batches(texts: List[Str]) -> List[List[Str]] {
    let mut out: List[List[Str]] = []
    let mut cur: List[Str] = []
    let mut size = 0
    for t in texts {
        // The 128 stood for the heredoc and pipe the script put around each text; a key
        // depends on where a run ends, so it stays.
        let n = t.byte_len() + 128
        if cur.len() > 0 && size + n > EXEC_ARG_BUDGET {
            out.push(cur)
            cur = []
            size = 0
        }
        cur.push(t)
        size = size + n
    }
    if cur.len() > 0 {
        out.push(cur)
    }
    out
}

// The 16-hex digest of lines. Lines past one exec argument's worth are hashed a run at a
// time, and the run digests hashed again: each run once went to sha256sum in a script of its
// own, and the keys on disk were made that way. "" when a hash fails.
fn digest_of_lines(lines: List[Str]) -> Str {
    let mut parts: List[Str] = []
    for run in exec_sized_batches(lines) {
        let d = sha256_of_manifest(run.join("\n"))
        if d.byte_len() != 16 {
            return ""
        }
        parts.push(d)
    }
    if parts.len() == 1 {
        return parts.get(0).unwrap()
    }
    let d = sha256_of_manifest(parts.join("\n"))
    if d.byte_len() != 16 { "" } else { d }
}

// Hash an arbitrary manifest passed as a string. Used by `blink cache
// key <manifest>` for tests and for tooling that wants to drive the
// digest directly.
pub fn key_from_text(text: Str) -> Str {
    sha256_of_manifest(text)
}

// Look up by key. On hit, touches .meta mtime and returns the .o path.
// On miss, returns "".
pub fn lookup_obj(key: Str) -> Str ! IO {
    if !cache_enabled() {
        return ""
    }
    let dir = obj_cache_dir()
    let obj = "{dir}/{key}.o"
    if file_exists(obj) == 0 {
        return ""
    }
    let _ = build_fs.touch("{dir}/{key}.meta")
    obj
}

// lookup_obj for each key, in order. "" for an empty key.
pub fn lookup_objs(keys: List[Str]) -> List[Str] ! IO {
    let mut out: List[Str] = []
    if !cache_enabled() {
        for _k in keys {
            out.push("")
        }
        return out
    }
    let dir = obj_cache_dir()
    for key in keys {
        let obj = "{dir}/{key}.o"
        if key == "" || file_exists(obj) == 0 {
            out.push("")
            continue
        }
        out.push(obj)
        let _ = build_fs.touch("{dir}/{key}.meta")
    }
    out
}

// Atomically install obj_tmp_path as <key>.o under the cache, plus
// write the .meta sidecar. Caller is responsible for putting a fresh
// obj at obj_tmp_path; we rename it (so the temp path is consumed).
// Returns true iff a new entry was installed (signal for maybe_gc); on
// false the caller must not link <key>.o.
pub fn store(key: Str, obj_tmp_path: Str, module_key: Str, src_sha: Str) -> Bool ! IO {
    if !cache_enabled() {
        return false
    }
    ensure_dir()
    let dir = obj_cache_dir()
    if !move_obj(obj_tmp_path, "{dir}/{key}.o") {
        return false
    }
    let now = time.read().to_unix_secs()
    let meta_path = "{dir}/{key}.meta"
    write_file(meta_path, "{now} {module_key} {src_sha}\n")
    true
}

// mv -f: rename(2), and mv where that fails, as it copies across filesystems.
fn move_obj(from: Str, to: Str) -> Bool ! IO {
    build_fs.rename(from, to) || shell_exec("mv -f '{from}' '{to}'") == 0
}

// store for each (key, obj_tmp_path, module_key), in order. The answer for each entry is what
// store would answer for it.
pub fn store_objs(keys: List[Str], obj_tmp_paths: List[Str], module_keys: List[Str]) -> List[Bool] ! IO {
    let mut out: List[Bool] = []
    for _k in keys {
        out.push(false)
    }
    if !cache_enabled() || keys.len() == 0 {
        return out
    }
    let dir = obj_cache_dir()
    ensure_dir()
    let now = time.read().to_unix_secs()
    let mut i = 0
    while i < keys.len() {
        if move_obj(obj_tmp_paths.get(i).unwrap(), "{dir}/{keys.get(i).unwrap()}.o") {
            write_file("{dir}/{keys.get(i).unwrap()}.meta", "{now} {module_keys.get(i).unwrap()} \n")
            out.set(i, true)
        }
        i = i + 1
    }
    out
}

// The apparent bytes of the files under dir. du would count the blocks they take, which can
// differ; the cap only starts an eviction and never changes what a build writes, so either
// unit holds it, and this one starts no program.
fn cache_total_bytes(dir: Str) -> Int ! IO {
    tree_bytes(dir, 0)
}

// The cache keeps its files at most two levels down (tmp/unit.<rand>/<file>). is_dir follows
// a link, so the depth bound ends a walk that a link to a parent would never end.
let CACHE_WALK_DEPTH: Int = 4

fn tree_bytes(path: Str, depth: Int) -> Int ! IO {
    if is_dir(path) != 1 {
        let n = build_fs.file_size(path)
        return if n < 0 { 0 } else { n }
    }
    if depth >= CACHE_WALK_DEPTH {
        return 0
    }
    let mut total = 0
    for name in list_dir(path) {
        total = total + tree_bytes("{path}/{name}", depth + 1)
    }
    total
}

fn cache_entry_count(dir: Str) -> Int {
    if file_exists(dir) == 0 {
        return 0
    }
    // Only count 16-hex-named .o files — those are real cache entries.
    // Other .o files in the directory (e.g. user-staged files in tests
    // that point BLINK_CACHE_DIR at an arbitrary scratch dir) are
    // ignored.
    let res = process_run("sh", ["-c", "ls -1 {dir}/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].o 2>/dev/null | wc -l"])
    let v = res.out.trim()
    if v == "" { 0 } else { v.to_int() }
}

// Opportunistic LRU eviction by .meta mtime until total <= cap_mb.
// Caller invokes this once at end of a build that stored anything.
pub fn maybe_gc() ! IO {
    if !cache_enabled() {
        return
    }
    let dir = obj_cache_dir()
    let cap_bytes = cache_size_cap_mb() * 1024 * 1024
    let mut total = cache_total_bytes(dir)
    if total <= cap_bytes {
        return
    }
    let listing = process_run("sh", ["-c", "ls -1tr {dir}/*.meta 2>/dev/null"])
    let lines = listing.out.split("\n")
    let mut idx = 0
    // Subtract per-entry size as we evict — re-walking the tree per
    // delete is O(N²) on big caches.
    while idx < lines.len() && total > cap_bytes {
        let meta_path = lines.get(idx).unwrap().trim()
        if meta_path != "" {
            let obj_path = meta_path.replace(".meta", ".o")
            let freed = tree_bytes(obj_path, 0) + tree_bytes(meta_path, 0)
            fs_remove(obj_path)
            fs_remove(meta_path)
            total = total - freed
        }
        idx = idx + 1
    }
}

pub fn cmd_info() -> Int ! IO {
    let dir = obj_cache_dir()
    let count = cache_entry_count(dir)
    let total_kb = cache_total_bytes(dir) / 1024
    let total_mb = total_kb / 1024
    io.println("blink object cache")
    io.println("  location: {dir}")
    io.println("  entries: {count}")
    io.println("  size: {total_mb} MiB ({total_kb} KiB)")
    io.println("  cap: {cache_size_cap_mb()} MiB")
    0
}

pub fn cmd_clean(older_than: Str) -> Int {
    let dir = obj_cache_dir()
    if file_exists(dir) == 0 {
        return 0
    }
    if older_than == "" {
        shell_exec("rm -rf {dir}/*.o {dir}/*.meta 2>/dev/null")
        return 0
    }
    // older_than format: "Nd" / "Nh" / "Nm". Convert to find -mtime / -mmin.
    // The unit is checked as an ASCII byte first, so the cut that drops it never lands
    // inside a multi-byte codepoint.
    let unit = older_than.byte_at(older_than.byte_len() - 1)
    if unit != 100 && unit != 104 && unit != 109 { // d h m
        io.eprintln("error: --older-than expects format like '7d', '12h', or '30m'")
        return 1
    }
    let n = older_than.byte_slice(0, older_than.byte_len() - 1).to_int()
    let find_arg = if unit == 100 {
        "-mtime +{n - 1}"
    } else if unit == 104 {
        "-mmin +{n * 60}"
    } else {
        "-mmin +{n}"
    }
    let prune = "find {dir} -maxdepth 1 -name '*.meta' {find_arg} -print"
    let listing = process_run("sh", ["-c", prune])
    let lines = listing.out.split("\n")
    let mut i = 0
    while i < lines.len() {
        let meta = lines.get(i).unwrap().trim()
        if meta != "" {
            let obj = meta.replace(".meta", ".o")
            shell_exec("rm -f {meta} {obj}")
        }
        i = i + 1
    }
    0
}

// Hidden sub-subcommands used by tests to drive the cache directly.
// Return 0/1 so the test can assert exit codes.
pub fn cmd_internal_lookup(key: Str) -> Int ! IO {
    let p = lookup_obj(key)
    if p == "" {
        return 1
    }
    io.println(p)
    0
}

pub fn cmd_internal_store(key: Str, src_obj: Str, module_key: Str, src_sha: Str) -> Int ! IO {
    if file_exists(src_obj) == 0 {
        io.eprintln("error: source obj does not exist: {src_obj}")
        return 1
    }
    ensure_dir()
    let staging = make_staging_path(module_key)
    shell_exec("cp {src_obj} {staging}")
    store(key, staging, module_key, src_sha)
    0
}

pub fn cmd_internal_gc() -> Int ! IO {
    maybe_gc()
    0
}

pub fn cmd_key(text: Str) -> Int {
    let k = key_from_text(text)
    io.println(k)
    0
}
