// Per-module .o content-addressed cache.
//
// Cache key = 16-hex SHA-256 over a deterministic manifest (schema,
// module key, src sha, sorted import shas, runtime sha, blinkc sha,
// cc id, sorted flags, target). Layout under obj_cache_dir():
//
//   <16-hex>.o                — the cached object
//   <16-hex>.meta             — "<unix-mtime> <module_key> <src_sha>"
//   <16-hex>.pch/             — a PCH of the archive header (see pch_key)
//   <16-hex>.reads            — what the compile read that the key does not hold, whose
//                               object goes by reads_key (see ReadScope)
//   tmp/unit.<rand>/          — a build's private C snapshot and staged .o, or a staged PCH
//   tmp/hold.<rand>/          — a build's links to the objects it links (make_hold_dir)
//   tmp/stage.<rand>/         — objects on their way into the cache (install_objs, __store)
//
// A build removes each tmp/ dir it makes; the first one it makes also removes those a killed
// build left (build_fs.reap_dead).
//
// Hits touch .meta mtime so LRU-by-mtime survives stdlib re-reads.
// Stores rename(2) into place. Two parallel jobs racing on the same
// key both compile and both rename — content is byte-identical.

import build_fs
import std.path.{path_basename, path_dirname}
import sha256.{sha256_hex, sha256_file_hex}
import std_cache_key.{sha256_of_manifest, sha256_of_file_first, sorted_strs, cc_identity}

pub fn obj_cache_dir() -> Str {
    let override_val = env.var("BLINK_CACHE_DIR") ?? ""
    if override_val == "" {
        return "build/obj-cache"
    }
    override_val
}

pub fn cache_enabled() -> Bool {
    // Empty BLINK_CACHE_DIR explicitly disables the cache (used by the
    // bootstrap loop). Unset uses the default `build/obj-cache`.
    (env.var("BLINK_CACHE_DIR") ?? "x") != ""
}

fn cache_size_cap_mb() -> Int {
    let v = env.var("BLINK_CACHE_SIZE_MB") ?? ""
    if v == "" {
        return 2048
    }
    v.to_int()
}

pub fn ensure_dir() ! IO {
    let _ = build_fs.mkdir_p("{obj_cache_dir()}/tmp")
}

// A dir of prefix no other build writes, under tmp/ so a rename out of it stays on one
// filesystem. A pid and a counter are not enough: two pid namespaces can share a cache
// dir. "" when it cannot be made.
fn make_tmp_dir(prefix: Str) -> Str ! IO {
    ensure_dir()
    let tmp = "{obj_cache_dir()}/tmp"
    build_fs.reap_dead(tmp, ["unit", "hold", "stage"])
    build_fs.private_dir(tmp, prefix)
}

pub fn make_private_dir() -> Str ! IO {
    make_tmp_dir("unit")
}

// The lines of s sorted by byte, ended by no newline.
fn sort_lines(s: Str) -> Str {
    if s == "" {
        return ""
    }
    sorted_strs(s.split("\n")).join("\n")
}

// Build the manifest text, then hash it. Caller passes pre-computed
// shas where possible to avoid re-reading files on every call.
pub fn compute_obj_key(
    module_key: Str,
    src_sha: Str,
    dep_header_lines: List[Str],
    runtime_sha: Str,
    blinkc_sha: Str,
    cc_id: Str,
    flags: List[Str],
    target: Str,
) -> Str {
    let mut imp = StringBuilder.new()
    let mut i = 0
    while i < dep_header_lines.len() {
        if i > 0 { imp.write("\n") }
        imp.write(dep_header_lines.get(i).unwrap())
        i = i + 1
    }
    let imports_sorted = sort_lines(imp.to_str()).trim()

    let mut fl = StringBuilder.new()
    let mut k = 0
    while k < flags.len() {
        if k > 0 { fl.write("\n") }
        fl.write(flags.get(k).unwrap())
        k = k + 1
    }
    let flags_sorted = sort_lines(fl.to_str()).trim()

    let mut m = StringBuilder.new()
    m.write("schema:1\n")
    m.write("mod:{module_key}\n")
    m.write("src_sha:{src_sha}\n")
    m.write("imports:{imports_sorted}\n")
    m.write("runtime_sha:{runtime_sha}\n")
    m.write("blinkc_sha:{blinkc_sha}\n")
    m.write("cc_id:{cc_id}\n")
    m.write("flags:{flags_sorted}\n")
    m.write("target:{target}\n")
    sha256_of_manifest(m.to_str())
}

// The vendored lines of a unit key: header_lines_named for dirs, and "incdir:<i>=<dir>" for
// the i-th dir when there are two or more. A unit takes a name present in two dirs from the
// first in -I order, so the key holds the order; one dir has one order, and its keys stay the
// keys made before the order was keyed. None as header_lines_named answers it. skip names what
// the build writes, which is under a vendored dir when the dir holds the project.
pub fn vendored_key_lines(dirs: List[Str], by_name: Bool, skip: List[Str]) -> Option[List[Str]] ! IO {
    let mut lines = match lines_under(dirs, by_name, skip) {
        Some(l) => l
        None => return None
    }
    if dirs.len() > 1 {
        let spellings = if by_name { vendored_dir_spellings(dirs) } else { dirs }
        let mut k = 0
        for spelling in spellings {
            // The key sorts its lines, so the index carries the order.
            lines.push("incdir:{k}={spelling}")
            k = k + 1
        }
    }
    Some(lines)
}

// vendored_key_lines for dirs spelled by their paths.
pub fn header_lines_in(dirs: List[Str]) -> Option[List[Str]] ! IO {
    vendored_key_lines(dirs, false, [])
}

// "<path>=<sha256>" for each file under dirs, each dir spelled as vendored_dir_spellings
// spells it when by_name: the lines of an object compiled with vendored_dir_maps, which
// records no other spelling. A unit can #include any file under a dir, at any depth and by
// any name, so every file is in the key. None when a file cannot be hashed or a dir cannot
// be listed, so a file the unit may read never drops out of the key. A build hashes them
// once for every key it makes: a vendored dir can be large (sqlite3.c is 9.4 MB).
pub fn header_lines_named(dirs: List[Str], by_name: Bool) -> Option[List[Str]] ! IO {
    lines_under(dirs, by_name, [])
}

// header_lines_named without the files at the paths in skip.
fn lines_under(dirs: List[Str], by_name: Bool, skip: List[Str]) -> Option[List[Str]] ! IO {
    let skip_real = skip_reals(skip)
    let mut lines: List[Str] = []
    let mut paths: List[Str] = []
    let mut spelled: List[Str] = []
    let spellings = if by_name { vendored_dir_spellings(dirs) } else { dirs }
    let mut k = 0
    for d in dirs {
        let spelling = spellings.get(k).unwrap()
        k = k + 1
        let rels = match files_under(d, "", [], skip_real) {
            Some(r) => r
            None => return None
        }
        for rel in rels {
            paths.push("{d}/{rel}")
            spelled.push("{spelling}/{rel}")
        }
    }
    let shas = hash_files(paths)
    let mut i = 0
    while i < paths.len() {
        match shas.get(paths.get(i).unwrap()) {
            Some(sha) => lines.push("{spelled.get(i).unwrap()}={sha}")
            None => return None
        }
        i = i + 1
    }
    Some(lines)
}

// The walk meets each entry under the realpath of its dir, so a skip path is spelled so too.
// One whose dir does not exist yet is under no dir the walk lists.
fn skip_reals(skip: List[Str]) -> List[Str] ! IO {
    let mut skip_real: List[Str] = []
    for s in skip {
        let p = without_trailing_slash(s)
        match build_fs.real_path(path_dirname(p)) {
            Some(r) => skip_real.push("{without_trailing_slash(r)}/{path_basename(p)}")
            None => {}
        }
    }
    skip_real
}

// The path relative to root of each file under {root}/{rel}, past each link, but for a dot
// entry and a path in skip (realpaths). A dot entry is what the glob "$d"/*.h left out at
// the top, and holds .git. A dir link back to a dir it lies in is not walked again: cc
// reaches each file under it by a path the walk already took. None when a dir cannot be
// listed.
fn files_under(root: Str, rel: Str, ancestors: List[Str], skip: List[Str]) -> Option[List[Str]] ! IO {
    let dir = if rel == "" { root } else { "{root}/{rel}" }
    let real = match build_fs.real_path(dir) {
        Some(r) => r
        None => return None
    }
    if ancestors.contains(real) {
        return Some([])
    }
    // A copy: a sibling dir is not an ancestor.
    let mut chain: List[Str] = []
    for a in ancestors { chain.push(a) }
    chain.push(real)
    let names = list_dir(dir)
    if fs.errno() != 0 {
        return None
    }
    let mut out: List[Str] = []
    for name in names {
        if name.starts_with(".") || skip.contains("{without_trailing_slash(real)}/{name}") { continue }
        let sub = if rel == "" { name } else { "{rel}/{name}" }
        if is_dir("{root}/{sub}") == 1 {
            match files_under(root, sub, chain, skip) {
                Some(inner) => {
                    for f in inner { out.push(f) }
                }
                None => return None
            }
        } else if file_exists("{root}/{sub}") == 1 {
            out.push(sub)
        }
    }
    Some(out)
}

fn without_trailing_slash(d: Str) -> Str {
    let mut end = d.byte_len()
    while end > 1 && d.byte_at(end - 1) == 47 {
        end = end - 1
    }
    d.byte_slice(0, end)
}

// The name an absolute vendored include dir goes by in an object below --debug, and so in its
// key: the dir's own name. Such an object records the dir only through the __FILE__ of a
// header in it, which vendored_dir_maps spells by this name, so two trees whose dirs hold the
// same bytes at other paths share it. A relative dir already names no tree. A dir whose name
// the map cannot spell keeps its path.
pub fn vendored_dir_name(d: Str) -> Str {
    let dir = without_trailing_slash(d)
    if !dir.starts_with("/") || dir.contains("=") {
        return d
    }
    let name = path_basename(dir)
    if name == "" || name == "." || name == ".." {
        return d
    }
    name
}

// The cc flags that spell the __FILE__ of a header in each of dirs as vendored_dir_spellings
// spells the dir. The trailing slash keeps a map from matching a sibling dir whose name starts with
// the same name.
pub fn vendored_dir_maps(dirs: List[Str]) -> List[Str] {
    let mut flags: List[Str] = []
    let spellings = vendored_dir_spellings(dirs)
    let mut i = 0
    while i < dirs.len() {
        let d = dirs.get(i).unwrap()
        let name = spellings.get(i).unwrap()
        if name != d {
            flags.push("-fmacro-prefix-map={without_trailing_slash(d)}/={name}/")
        }
        i = i + 1
    }
    flags
}

// How each of dirs is spelled in an object below --debug, and so in its key: by
// vendored_dir_name, except a dir that keeps its path when its name is not its own. Two dirs
// of one name would spell their headers alike, and their key lines sort together, so trees
// that swap the headers between them would share a key and not their bytes. A dir inside
// another gets the map of either one, by the order of the -I flags.
pub fn vendored_dir_spellings(dirs: List[Str]) -> List[Str] {
    let mut names: List[Str] = []
    for d in dirs {
        names.push(vendored_dir_name(d))
    }
    let mut out: List[Str] = []
    let mut i = 0
    while i < dirs.len() {
        let d = dirs.get(i).unwrap()
        let name = names.get(i).unwrap()
        let mut own = name != d
        let mut j = 0
        while own && j < dirs.len() {
            if j != i {
                let other = dirs.get(j).unwrap()
                if names.get(j).unwrap() == name || nested(d, other) || nested(other, d) {
                    own = false
                }
            }
            j = j + 1
        }
        out.push(if own { name } else { d })
        i = i + 1
    }
    out
}

// Whether inner is outer or lies inside it.
fn nested(inner: Str, outer: Str) -> Bool {
    let a = without_trailing_slash(inner)
    let b = without_trailing_slash(outer)
    a == b || a.starts_with("{b}/")
}

// The dir cc records as a debug object's compile dir, read as gcc and clang read it: $PWD
// when it is absolute and names the cwd, else the cwd. cc inherits this process's PWD, and an
// sh between them keeps a PWD that names the cwd and replaces one that does not with the cwd,
// so cc reads the same answer. gcc and clang compare by inode, so a stale PWD that names the
// cwd through another mount of it is recorded where this answers the cwd; both name the same
// dir. "" when the cwd cannot be read.
pub fn compile_dir() -> Str ! IO {
    let cwd = env.cwd()
    if cwd == "" {
        return ""
    }
    let pwd = env.var("PWD") ?? ""
    if pwd.starts_with("/") && (build_fs.real_path(pwd) ?? "") == cwd { pwd } else { cwd }
}

// The key of a user unit compiled from the C at src_path. The unit includes
// libblink_std.h from arc_dir, which includes the runtime.h beside it; cc reads a
// libblink_std.h.gch there in place of the header; a vendored dependency's headers come
// from its include dir. Each shapes the object, so each is in the key, and so is each path
// the object records (recorded_paths). "" when an input cannot be read: a key without it
// would match an object built from other headers.
pub fn user_unit_key(
    src_path: Str,
    module_key: Str,
    arc_dir: Str,
    vendored_include_dirs: List[Str],
    blinkc_sha: Str,
    cc_id: Str,
    flags: List[Str],
    target: Str,
    recorded_paths: List[Str],
) -> Str ! IO {
    match header_lines_in(vendored_include_dirs) {
        Some(lines) => user_unit_key_with_headers(src_path, module_key, arc_dir, lines, blinkc_sha, cc_id, flags, target, recorded_paths)
        None => ""
    }
}

// user_unit_key over the lines vendored_key_lines answered for the vendored include dirs.
pub fn user_unit_key_with_headers(
    src_path: Str,
    module_key: Str,
    arc_dir: Str,
    vendored_headers: List[Str],
    blinkc_sha: Str,
    cc_id: Str,
    flags: List[Str],
    target: Str,
    recorded_paths: List[Str],
) -> Str ! IO {
    if blinkc_sha == "" || cc_id == "" {
        return ""
    }
    let src_sha = sha256_of_file_first(src_path)
    let runtime_sha = sha256_of_file_first("{arc_dir}/runtime.h")
    let archive_header_sha = sha256_of_file_first("{arc_dir}/libblink_std.h")
    if src_sha == "" || runtime_sha == "" || archive_header_sha == "" {
        return ""
    }
    let mut headers = ["libblink_std.h={archive_header_sha}"]
    let pch = "{arc_dir}/libblink_std.h.gch"
    if file_exists(pch) == 1 {
        let pch_sha = sha256_of_file_first(pch)
        if pch_sha == "" {
            return ""
        }
        headers.push("libblink_std.h.gch={pch_sha}")
    }
    for line in vendored_headers {
        headers.push(line)
    }
    // As import lines, so a level that records no path keeps the keys it had.
    for p in recorded_paths {
        headers.push("path:{p}")
    }
    compute_obj_key(module_key, src_sha, headers, runtime_sha, blinkc_sha, cc_id, flags, target)
}

// The sha of each file in paths, by its path; a file that cannot be read is absent.
fn hash_files(paths: List[Str]) -> Map[Str, Str] ! IO {
    let mut m: Map[Str, Str] = Map()
    for p in paths {
        match sha256_file_hex(p) {
            Some(sha) => m.insert(p, sha)
            None => {}
        }
    }
    m
}

// The keys of the per-module build's units in dir, by module. A unit includes the headers in
// dir that unit_headers names for it, libblink_std.h and the runtime.h beside it from arc_dir
// (or the .gch cc reads in place of the header), and the vendored headers, so a key covers all
// of them along with the unit's own C, and no other header in dir: one module's header can
// change without a new key for a unit that does not include it. The headers are named by their
// name in dir, not by the path of dir, which differs on every build. A module whose key cannot
// be built is absent, and its unit compiles without the cache: a key that left out an input it
// could not read would match an object built from other bytes. Every file is hashed by one
// process, and the manifests by one more, since a process per file or unit costs more than the
// hashing on a no-change build.
pub fn unit_keys(
    dir: Str,
    modules: List[Str],
    unit_headers: Map[Str, List[Str]],
    arc_dir: Str,
    vendored_include_dirs: List[Str],
    blinkc_sha: Str,
    cc_id: Str,
    flags: List[Str],
    target: Str,
) -> Map[Str, Str] ! IO {
    if blinkc_sha == "" || cc_id == "" || modules.len() == 0 {
        return Map()
    }
    match unit_file_shas(dir, arc_dir) {
        Some(shas) => unit_keys_from(shas, modules, unit_headers, arc_dir, vendored_include_dirs, blinkc_sha, cc_id, flags, target)
        None => Map()
    }
}

// The sha of each file a unit key covers: the archive's runtime.h, libblink_std.h and .gch,
// by their path, and every .h and .c in dir, by their name in dir. A file that could not be
// read is absent. None when dir is not a directory.
pub fn unit_file_shas(dir: Str, arc_dir: Str) -> Option[Map[Str, Str]] ! IO {
    unit_file_shas_with(dir, arc_dir, [])
}

// unit_file_shas, and the sha of each file in dir that extra names, by that name.
pub fn unit_file_shas_with(dir: Str, arc_dir: Str, extra: List[Str]) -> Option[Map[Str, Str]] ! IO {
    if is_dir(dir) != 1 {
        return None
    }
    let mut paths: List[Str] = []
    for f in ["{arc_dir}/runtime.h", "{arc_dir}/libblink_std.h", "{arc_dir}/libblink_std.h.gch"] {
        if file_exists(f) == 1 { paths.push(f) }
    }
    let arc_count = paths.len()
    let mut names: List[Str] = []
    for name in list_dir(dir) {
        // What the glob *.h *.c names: no dotfile.
        if name.starts_with(".") || !(name.ends_with(".h") || name.ends_with(".c")) { continue }
        names.push(name)
    }
    for name in extra { names.push(name) }
    for name in names {
        if file_exists("{dir}/{name}") == 1 { paths.push("{dir}/{name}") }
    }
    let shas = hash_files(paths)
    let mut m: Map[Str, Str] = Map()
    let mut i = 0
    while i < paths.len() {
        let p = paths.get(i).unwrap()
        match shas.get(p) {
            Some(sha) => {
                let key = if i < arc_count { p } else { p.byte_slice(dir.byte_len() + 1, p.byte_len()) }
                m.insert(key, sha)
            }
            None => {}
        }
        i = i + 1
    }
    Some(m)
}

// The sha of each file in dir that names lists, by that name. A file that could not be read
// is absent.
pub fn file_shas(dir: Str, names: List[Str]) -> Map[Str, Str] ! IO {
    let mut m: Map[Str, Str] = Map()
    if is_dir(dir) != 1 {
        return m
    }
    let mut paths: List[Str] = []
    for n in names { paths.push("{dir}/{n}") }
    let shas = hash_files(paths)
    for n in names {
        match shas.get("{dir}/{n}") {
            Some(sha) => m.insert(n, sha)
            None => {}
        }
    }
    m
}

// unit_keys over shas unit_file_shas answered for dir and arc_dir.
pub fn unit_keys_from(
    shas: Map[Str, Str],
    modules: List[Str],
    unit_headers: Map[Str, List[Str]],
    arc_dir: Str,
    vendored_include_dirs: List[Str],
    blinkc_sha: Str,
    cc_id: Str,
    flags: List[Str],
    target: Str,
) -> Map[Str, Str] ! IO {
    match header_lines_in(vendored_include_dirs) {
        Some(lines) => unit_keys_with_headers(shas, modules, unit_headers, arc_dir, lines, blinkc_sha, cc_id, flags, target, [])
        None => Map()
    }
}

// unit_keys_from over the lines vendored_key_lines answered for the vendored include dirs, with
// each path the objects record (recorded_paths) in every key.
pub fn unit_keys_with_headers(
    shas: Map[Str, Str],
    modules: List[Str],
    unit_headers: Map[Str, List[Str]],
    arc_dir: Str,
    vendored_headers: List[Str],
    blinkc_sha: Str,
    cc_id: Str,
    flags: List[Str],
    target: Str,
    recorded_paths: List[Str],
) -> Map[Str, Str] ! IO {
    let mut keys: Map[Str, Str] = Map()
    if blinkc_sha == "" || cc_id == "" || modules.len() == 0 {
        return keys
    }
    let runtime_h = "{arc_dir}/runtime.h"
    let archive_h = "{arc_dir}/libblink_std.h"
    let pch = "{arc_dir}/libblink_std.h.gch"
    let runtime_sha = shas.get(runtime_h) ?? ""
    let archive_sha = shas.get(archive_h) ?? ""
    if runtime_sha == "" || archive_sha == "" {
        return keys
    }
    let mut headers = ["libblink_std.h={archive_sha}"]
    if file_exists(pch) == 1 {
        let pch_sha = shas.get(pch) ?? ""
        if pch_sha == "" {
            return keys
        }
        headers.push("libblink_std.h.gch={pch_sha}")
    }
    for line in vendored_headers {
        headers.push(line)
    }
    // The inputs every unit shares go into one digest that each unit's manifest names. Put
    // in full in every manifest, the header list grows with units times headers.
    let mut shared = ["schema:unit-3", "runtime_sha:{runtime_sha}", "blinkc_sha:{blinkc_sha}", "cc_id:{cc_id}", "target:{target}"]
    for line in sorted_strs(headers) {
        shared.push("import:{line}")
    }
    for f in sorted_strs(flags) {
        shared.push("flag:{f}")
    }
    // Only when there are any, so a level that records no path keeps the keys it had.
    for p in recorded_paths {
        shared.push("path:{p}")
    }
    let shared_sha = digest_of_lines(shared)
    if shared_sha == "" {
        return keys
    }
    for m in modules {
        let src_sha = shas.get("{m}.c") ?? ""
        if src_sha == "" { continue }
        // A unit with no header list would get a key that covers none of its headers.
        let names = match unit_headers.get(m) {
            Some(hs) => hs
            None => continue
        }
        let mut text = "mod:{m}\nsrc_sha:{src_sha}\nshared:{shared_sha}"
        let mut readable = true
        for name in sorted_strs(names) {
            let sha = shas.get(name) ?? ""
            if sha == "" { readable = false }
            text = "{text}\nunit:{name}={sha}"
        }
        if !readable { continue }
        // The bytes sha256sum hashed when the manifest went through a file: the text and a
        // newline.
        keys.insert(m, sha256_hex("{text}\n").byte_slice(0, 16))
    }
    keys
}

// Linux caps one exec argument at 128 KiB. The keys on disk were made when each run of
// digest_of_lines went to sha256sum as one `sh -c` argument, so the runs keep that size.
let EXEC_ARG_BUDGET: Int = 65536

// texts in order, split into runs whose total size stays under EXEC_ARG_BUDGET. A text over
// the budget gets a run of its own.
fn exec_sized_batches(texts: List[Str]) -> List[List[Str]] {
    let mut out: List[List[Str]] = []
    let mut cur: List[Str] = []
    let mut size = 0
    for t in texts {
        // The 128 stood for the heredoc and pipe the script put around each text; a key
        // depends on where a run ends, so it stays.
        let n = t.byte_len() + 128
        if cur.len() > 0 && size + n > EXEC_ARG_BUDGET {
            out.push(cur)
            cur = []
            size = 0
        }
        cur.push(t)
        size = size + n
    }
    if cur.len() > 0 {
        out.push(cur)
    }
    out
}

// The 16-hex digest of lines. Lines past one exec argument's worth are hashed a run at a
// time, and the run digests hashed again: each run once went to sha256sum in a script of its
// own, and the keys on disk were made that way. "" when a hash fails.
fn digest_of_lines(lines: List[Str]) -> Str {
    let mut parts: List[Str] = []
    for run in exec_sized_batches(lines) {
        let d = sha256_of_manifest(run.join("\n"))
        if d.byte_len() != 16 {
            return ""
        }
        parts.push(d)
    }
    if parts.len() == 1 {
        return parts.get(0).unwrap()
    }
    let d = sha256_of_manifest(parts.join("\n"))
    if d.byte_len() != 16 { "" } else { d }
}

// Hash an arbitrary manifest passed as a string. Used by `blink cache
// key <manifest>` for tests and for tooling that wants to drive the
// digest directly.
pub fn key_from_text(text: Str) -> Str {
    sha256_of_manifest(text)
}

// Look up by key. On hit, touches .meta mtime and returns the .o path.
// On miss, returns "".
pub fn lookup_obj(key: Str) -> Str ! IO {
    if !cache_enabled() {
        return ""
    }
    let dir = obj_cache_dir()
    let obj = "{dir}/{key}.o"
    if file_exists(obj) == 0 {
        return ""
    }
    let _ = build_fs.touch("{dir}/{key}.meta")
    obj
}

// lookup_obj for each key, in order. "" for an empty key.
pub fn lookup_objs(keys: List[Str]) -> List[Str] ! IO {
    let mut out: List[Str] = []
    if !cache_enabled() {
        for _k in keys {
            out.push("")
        }
        return out
    }
    let dir = obj_cache_dir()
    for key in keys {
        let obj = "{dir}/{key}.o"
        if key == "" || file_exists(obj) == 0 {
            out.push("")
            continue
        }
        out.push(obj)
        let _ = build_fs.touch("{dir}/{key}.meta")
    }
    out
}

// A build links an object some time after it finds or stores it here, and the GC of another
// build can remove the entry in between. So the build links a name of its own for the bytes,
// in a dir under tmp/ that no GC removes, and removes that dir after its link. "" when none
// can be made.
pub fn make_hold_dir() -> Str ! IO {
    make_tmp_dir("hold")
}

// A hard link at to for the file at from, or a copy where the filesystem makes no link. False
// when from is gone or cannot be copied.
fn hold_file(from: Str, to: Str) -> Bool ! IO {
    // Dev knob: BLINK_DEV_OBJCACHE_HOLD=copy fails each link, as a filesystem with no hard
    // links does; =none fails each copy too. A test makes either path happen every time.
    let knob = env.var("BLINK_DEV_OBJCACHE_HOLD") ?? ""
    if knob == "" && build_fs.hard_link(from, to) {
        return true
    }
    if knob == "none" {
        return false
    }
    build_fs.copy_file(from, to)
}

// lookup_obj for each key, in order, that answers a name in hold for each hit: what the
// build links stays there after the GC of another build removes the entry. A key whose
// compile read files the key does not hold (<key>.reads) hits only when each of them, found
// through dirs, the vendored include dirs of this build, still has the bytes it had. "" for an
// empty key, a miss, or no hold dir.
pub fn hold_objs(keys: List[Str], hold: Str, dirs: List[Str]) -> List[Str] ! IO {
    let mut out: List[Str] = []
    let dir = obj_cache_dir()
    let mut read_keys: List[Int] = []
    for key in keys {
        let held = "{hold}/{key}.o"
        if !cache_enabled() || hold == "" || key == "" {
            out.push("")
            continue
        }
        if !hold_file("{dir}/{key}.o", held) {
            if file_exists("{dir}/{key}.reads") == 1 {
                read_keys.push(out.len())
            }
            out.push("")
            continue
        }
        out.push(held)
        // After the hold: an entry the GC removed in between leaves only an empty .meta, which
        // the next GC removes.
        let _ = build_fs.touch("{dir}/{key}.meta")
    }
    if read_keys.len() == 0 {
        return out
    }
    let mut lists: List[List[Str]] = []
    let mut paths: List[Str] = []
    for i in read_keys {
        let lines = read_lines_file("{dir}/{keys.get(i).unwrap()}.reads")
        for line in lines {
            paths.push(read_line_path(line, dirs))
        }
        lists.push(lines)
    }
    // One hash per file for the whole build: units share most of what they read.
    let shas = hash_files(unique_strs(paths))
    let mut j = 0
    while j < read_keys.len() {
        let i = read_keys.get(j).unwrap()
        let lines = lists.get(j).unwrap()
        j = j + 1
        if lines.len() == 0 || !reads_match(lines, dirs, shas) { continue }
        // The object goes by a key of the lines it was found by, so an object stored for
        // other bytes of those files is never held for these.
        let key = keys.get(i).unwrap()
        let obj_key = reads_key(key, lines)
        let held = "{hold}/{obj_key}.o"
        if obj_key != "" && hold_file("{dir}/{obj_key}.o", held) {
            out.set(i, held)
            let _ = build_fs.touch("{dir}/{obj_key}.meta")
            let _ = build_fs.touch("{dir}/{key}.meta")
        }
    }
    out
}

// What a compile reads that its key does not hold, beside a cached object.
//
// A vendored header can include a file under no vendored dir, by a path that climbs out of
// one or by an absolute path, or one under a dot entry, which the walk of vendored_key_lines
// leaves out. Its bytes shape the object and are in no key. So each cached compile writes a
// depfile (cc -MMD), and the files it names that no key line holds are kept, each with its
// sha, in <key>.reads as "<sha256> <where>" lines. The object then goes under reads_key, a
// key of the unit key and those lines, and a build holds it only after each file still
// hashes to its line. A compile that read no such file stores its object under the unit key,
// as before.
//
// <where> names a file as the hitting build must find it: "v<i>:<rest>" for a path cc spelled
// under the i-th vendored dir, which another tree that shares the key spells under its own
// dir; "a:<path>" for an absolute path, and "r:<path>" for one relative to the dir cc runs in.

// The files a compile may read whose bytes another key line already holds: dirs the build
// itself writes the unit into (own_dirs), the archive headers (own_files), and each file the
// walk of vendored_key_lines hashes under real_dirs. All are realpaths, as are skip_real, the
// entries the walk passed over.
pub type ReadScope {
    dirs: List[Str]
    real_dirs: List[Str]
    skip_real: List[Str]
    own_dirs: List[Str]
    own_files: List[Str]
    // Wall time in ms when the scope was made, before the compile it serves started.
    since_ms: Int
}

// How far before since_ms an mtime still counts as written during the compile: some file
// systems keep mtimes to the second (FAT to two), and the kernel stamps a write from a clock
// that runs a tick behind the wall clock.
let READ_MTIME_SLACK_MS: Int = 2000

// The ReadScope of a compile with vendored include dirs dirs, whose key walk skips skip, that
// reads its own C and headers under own and the archive headers in arc_dir. A dir that does not
// exist holds nothing a compile reads. Made before the compile starts.
pub fn read_scope(dirs: List[Str], skip: List[Str], own: List[Str], arc_dir: Str) -> ReadScope ! IO {
    let since_ms = time.read().to_unix_ms()
    let mut real_dirs: List[Str] = []
    for d in dirs {
        real_dirs.push(without_trailing_slash(build_fs.real_path(d) ?? ""))
    }
    let mut own_dirs: List[Str] = []
    for o in own {
        match build_fs.real_path(o) {
            Some(r) => own_dirs.push(without_trailing_slash(r))
            None => {}
        }
    }
    // A build's private dirs in the cache: the unit's C snapshot, a staged PCH, the PCH it holds.
    match build_fs.real_path("{obj_cache_dir()}/tmp") {
        Some(r) => own_dirs.push(without_trailing_slash(r))
        None => {}
    }
    let mut own_files: List[Str] = []
    for name in ["libblink_std.h", "runtime.h", "libblink_std.h.gch"] {
        match build_fs.real_path("{arc_dir}/{name}") {
            Some(r) => own_files.push(r)
            None => {}
        }
    }
    ReadScope { dirs: dirs, real_dirs: real_dirs, skip_real: skip_reals(skip), own_dirs: own_dirs, own_files: own_files, since_ms: since_ms }
}

// The "<sha256> <where>" lines of the files the depfile names that no key line holds, sorted
// and each once. None when the depfile cannot be read or a file it names can no longer be
// hashed: the object must not be stored, since a hit could not check that file.
pub fn compile_reads(depfile: Str, scope: ReadScope) -> Option[List[Str]] ! IO {
    if file_exists(depfile) == 0 {
        return None
    }
    let named = match depfile_paths(read_file(depfile)) {
        Some(p) => p
        None => return None
    }
    let mut kept: List[Str] = []
    for p in unique_strs(named) {
        let real = match build_fs.real_path(p) {
            Some(r) => r
            None => return None
        }
        if !keyed_elsewhere(real, scope) {
            kept.push(p)
        }
    }
    let shas = hash_files(kept)
    let mut lines: List[Str] = []
    for p in kept {
        match shas.get(p) {
            Some(sha) => lines.push("{sha} {read_where(p, scope.dirs)}")
            None => return None
        }
        // Checked after the hash: a write cc saw but the hash missed has an mtime at or past
        // the start, and a write after this check changes the hash the next hit compares.
        let mt = file_mtime(p)
        if mt < 0 || mt >= scope.since_ms - READ_MTIME_SLACK_MS {
            return None
        }
    }
    Some(unique_strs(sorted_strs(lines)))
}

// Whether another key line holds the bytes of the file at the realpath real. The walk keys a
// file under a vendored dir by each path it takes, and it takes the file's realpath unless an
// entry on it is a dot entry or one the walk skips. Membership, not a prefix of the dir: a
// file under a dot dir lies under the vendored dir too.
fn keyed_elsewhere(real: Str, scope: ReadScope) -> Bool {
    if scope.own_files.contains(real) {
        return true
    }
    for d in scope.own_dirs {
        if real.starts_with("{d}/") {
            return true
        }
    }
    for d in scope.real_dirs {
        if d == "" || !real.starts_with("{d}/") { continue }
        let mut at = d
        let mut walked = true
        for part in real.byte_slice(d.byte_len() + 1, real.byte_len()).split("/") {
            at = "{at}/{part}"
            if part.starts_with(".") || scope.skip_real.contains(at) {
                walked = false
                break
            }
        }
        if walked {
            return true
        }
    }
    false
}

// How a compile line names the file cc read at p: under the first of dirs, in -I order, that
// p is spelled under, else by p itself.
fn read_where(p: Str, dirs: List[Str]) -> Str {
    let mut i = 0
    for d in dirs {
        let prefix = "{without_trailing_slash(d)}/"
        if p.starts_with(prefix) {
            return "v{i}:{p.byte_slice(prefix.byte_len(), p.byte_len())}"
        }
        i = i + 1
    }
    if p.starts_with("/") { "a:{p}" } else { "r:{p}" }
}

// The path a "<sha256> <where>" line names in a build whose vendored include dirs are dirs; ""
// when it names a dir this build does not have.
fn read_line_path(line: Str, dirs: List[Str]) -> Str {
    if line.byte_len() < 68 {
        return ""
    }
    let loc = line.byte_slice(65, line.byte_len())
    if loc.starts_with("a:") || loc.starts_with("r:") {
        return loc.byte_slice(2, loc.byte_len())
    }
    if !loc.starts_with("v") {
        return ""
    }
    let colon = loc.index_of(":") ?? -1
    if colon < 2 {
        return ""
    }
    let i = loc.byte_slice(1, colon).to_int()
    if i < 0 || i >= dirs.len() {
        return ""
    }
    "{without_trailing_slash(dirs.get(i).unwrap())}/{loc.byte_slice(colon + 1, loc.byte_len())}"
}

// Whether each of lines names a file that hashes, in shas, to the sha the line holds.
fn reads_match(lines: List[Str], dirs: List[Str], shas: Map[Str, Str]) -> Bool {
    for line in lines {
        let p = read_line_path(line, dirs)
        if p == "" || (shas.get(p) ?? "") != line.byte_slice(0, 64) {
            return false
        }
    }
    true
}

// The key an object goes by when its compile read the files lines name. "" when a hash fails.
pub fn reads_key(key: Str, lines: List[Str]) -> Str {
    let mut all = ["schema:reads-1", "key:{key}"]
    for l in lines {
        all.push(l)
    }
    digest_of_lines(all)
}

// The lines of a .reads file; none when it cannot be read.
fn read_lines_file(path: Str) -> List[Str] ! IO {
    let mut out: List[Str] = []
    for line in read_file(path).split("\n") {
        if line != "" {
            out.push(line)
        }
    }
    out
}

// The prerequisites of the rule cc -MMD writes, unescaped: cc writes a space in a path as
// "\ ", a # as "\#" and a $ as "$$", and breaks a long line with a backslash before the
// newline. None when the text holds no rule.
pub fn depfile_paths(text: Str) -> Option[List[Str]] {
    let mut words: List[Str] = []
    let mut cur = ""
    let mut start = 0
    let n = text.byte_len()
    let mut i = 0
    while i < n {
        let c = text.byte_at(i).to_int()
        let next = if i + 1 < n { text.byte_at(i + 1).to_int() } else { 0 }
        // "\ " and "\#"
        if c == 92 && (next == 32 || next == 35) {
            cur = "{cur}{text.byte_slice(start, i)}{text.byte_slice(i + 1, i + 2)}"
            i = i + 2
            start = i
            continue
        }
        // "$$"
        if c == 36 && next == 36 {
            cur = "{cur}{text.byte_slice(start, i)}$"
            i = i + 2
            start = i
            continue
        }
        let line_break = c == 92 && next == 10
        if line_break || c == 32 || c == 9 || c == 10 || c == 13 {
            cur = "{cur}{text.byte_slice(start, i)}"
            if cur != "" {
                words.push(cur)
                cur = ""
            }
            i = i + if line_break { 2 } else { 1 }
            start = i
            continue
        }
        i = i + 1
    }
    cur = "{cur}{text.byte_slice(start, n)}"
    if cur != "" {
        words.push(cur)
    }
    let mut k = 0
    while k < words.len() {
        let w = words.get(k).unwrap()
        k = k + 1
        if w.ends_with(":") {
            let mut deps: List[Str] = []
            while k < words.len() {
                deps.push(words.get(k).unwrap())
                k = k + 1
            }
            return Some(deps)
        }
    }
    None
}

// reads with the lines of more, as a unit that read a PCH read what the PCH read.
pub fn merge_reads(reads: Option[List[Str]], more: List[Str]) -> Option[List[Str]] {
    match reads {
        Some(lines) => {
            let mut all: List[Str] = []
            for l in lines { all.push(l) }
            for l in more { all.push(l) }
            Some(unique_strs(sorted_strs(all)))
        }
        None => None
    }
}

// xs in order, each once.
fn unique_strs(xs: List[Str]) -> List[Str] {
    let mut seen: Map[Str, Bool] = Map()
    let mut out: List[Str] = []
    for x in xs {
        if !seen.contains_key(x) {
            seen.insert(x, true)
            out.push(x)
        }
    }
    out
}

// Whether a PCH this build holds in hold, built by a compile that read the files the lines in
// its reads file name, may serve its units: each file, found through dirs, still hashes to its
// line. Its lines when it may (none without a reads file); None when it may not.
pub fn held_pch_reads(hold: Str, dirs: List[Str]) -> Option[List[Str]] ! IO {
    let path = "{hold}/{PCH_READS}"
    if file_exists(path) == 0 {
        return Some([])
    }
    let lines = read_lines_file(path)
    let mut paths: List[Str] = []
    for line in lines {
        paths.push(read_line_path(line, dirs))
    }
    if !reads_match(lines, dirs, hash_files(unique_strs(paths))) {
        return None
    }
    Some(lines)
}

// The file in a PCH dir that holds the lines of what its build read that its key does not
// hold, as <key>.reads does for an object. A PCH whose build read nothing more has none, so
// its dir holds what it held before PCHs kept their reads.
pub let PCH_READS: Str = "reads"

// store, but installs a link or a copy of obj_path and leaves obj_path in place, so the build
// links its own bytes whatever the GC of another build removes. Answers whether the object is
// now in the cache.
// reads holds what the compile read that the key does not (compile_reads); None stores
// nothing.
pub fn install(key: Str, obj_path: Str, module_key: Str, src_sha: Str, reads: Option[List[Str]]) -> Bool ! IO {
    if !cache_enabled() {
        return false
    }
    let stage = make_tmp_dir("stage")
    let ok = install_reads(obj_cache_dir(), stage, key, obj_path, "{time.read().to_unix_secs()} {module_key} {src_sha}\n", reads)
    let _ = build_fs.remove_tree(stage)
    ok
}

// install for each (key, obj_path, module_key, reads), in order.
pub fn install_objs(keys: List[Str], obj_paths: List[Str], module_keys: List[Str], reads: List[Option[List[Str]]]) -> List[Bool] ! IO {
    let mut out: List[Bool] = []
    for _k in keys {
        out.push(false)
    }
    if !cache_enabled() || keys.len() == 0 {
        return out
    }
    let dir = obj_cache_dir()
    let stage = make_tmp_dir("stage")
    let now = time.read().to_unix_secs()
    let mut i = 0
    while i < keys.len() {
        let m = module_keys.get(i).unwrap()
        out.set(i, install_reads(dir, stage, keys.get(i).unwrap(), obj_paths.get(i).unwrap(), "{now} {m} \n", reads.get(i).unwrap()))
        i = i + 1
    }
    let _ = build_fs.remove_tree(stage)
    out
}

// install_at under the key reads names, then <key>.reads, so a build that finds the lines
// finds the object too. An object whose compile read nothing the key does not hold goes
// under key.
fn install_reads(dir: Str, stage: Str, key: Str, obj_path: Str, meta: Str, reads: Option[List[Str]]) -> Bool ! IO {
    let lines = match reads {
        Some(l) => l
        None => return false
    }
    if lines.len() == 0 {
        return install_at(dir, stage, key, obj_path, meta)
    }
    let obj_key = reads_key(key, lines)
    if stage == "" || obj_key == "" || !install_at(dir, stage, obj_key, obj_path, meta) {
        return false
    }
    let staging = "{stage}/{key}.reads"
    write_file(staging, "{lines.join("\n")}\n")
    if !build_fs.rename(staging, "{dir}/{key}.reads") {
        fs_remove(staging)
        return false
    }
    // The LRU entry of the lines: the GC removes them with it.
    write_file("{dir}/{key}.meta", meta)
    true
}

// A staged name in stage, so no build links a part-made copy under the key. False with no
// stage dir.
fn install_at(dir: Str, stage: Str, key: Str, obj_path: Str, meta: Str) -> Bool ! IO {
    if stage == "" {
        return false
    }
    let staging = "{stage}/{key}.o"
    if hold_file(obj_path, staging) && build_fs.rename(staging, "{dir}/{key}.o") {
        write_file("{dir}/{key}.meta", meta)
        return true
    }
    fs_remove(staging)
    false
}

// Atomically install obj_tmp_path as <key>.o under the cache, plus
// write the .meta sidecar. Caller is responsible for putting a fresh
// obj at obj_tmp_path; we rename it (so the temp path is consumed).
// Returns true iff a new entry was installed (signal for maybe_gc); on
// false the caller must not link <key>.o.
pub fn store(key: Str, obj_tmp_path: Str, module_key: Str, src_sha: Str) -> Bool ! IO {
    if !cache_enabled() {
        return false
    }
    ensure_dir()
    let dir = obj_cache_dir()
    if !move_obj(obj_tmp_path, "{dir}/{key}.o") {
        return false
    }
    let now = time.read().to_unix_secs()
    let meta_path = "{dir}/{key}.meta"
    write_file(meta_path, "{now} {module_key} {src_sha}\n")
    true
}

// mv -f: rename(2), and mv where that fails, as it copies across filesystems.
fn move_obj(from: Str, to: Str) -> Bool ! IO {
    build_fs.rename(from, to) || shell_exec("mv -f '{from}' '{to}'") == 0
}

// store for each (key, obj_tmp_path, module_key), in order. The answer for each entry is what
// store would answer for it.
pub fn store_objs(keys: List[Str], obj_tmp_paths: List[Str], module_keys: List[Str]) -> List[Bool] ! IO {
    let mut out: List[Bool] = []
    for _k in keys {
        out.push(false)
    }
    if !cache_enabled() || keys.len() == 0 {
        return out
    }
    let dir = obj_cache_dir()
    ensure_dir()
    let now = time.read().to_unix_secs()
    let mut i = 0
    while i < keys.len() {
        if move_obj(obj_tmp_paths.get(i).unwrap(), "{dir}/{keys.get(i).unwrap()}.o") {
            write_file("{dir}/{keys.get(i).unwrap()}.meta", "{now} {module_keys.get(i).unwrap()} \n")
            out.set(i, true)
        }
        i = i + 1
    }
    out
}

// A unit spends most of a small compile parsing the archive header, so a build keeps a PCH
// of it here, and <key>.meta its mtime for the LRU. For gcc, <key>.pch/ holds copies of
// libblink_std.h and runtime.h and the .gch built from them. For clang it holds only the .pch:
// clang records the path of each header it read and reads them there again, so the PCH is
// built from the archive dir itself. The key covers what the compiler needs to take the PCH:
// the header bytes, the compiler (cc_id, so a gcc and a clang PCH never serve each other),
// every flag, the macros a unit defines before the header, each include dir and the headers
// in it (vendored_headers, as vendored_key_lines answers them for those dirs), and the archive
// dir the debug info names. gcc checks the rest itself and reads the header copy beside a .gch
// it rejects; clang stops on one, and the unit compiles again without it. Either way a
// unit's object, and its key, do not depend on the PCH.
pub fn pch_key(archive_sha: Str, runtime_sha: Str, cc_id: Str, arc_dir: Str, flags: List[Str], defines: List[Str], include_flags: List[Str], vendored_headers: List[Str]) -> Str {
    if archive_sha == "" || runtime_sha == "" || cc_id == "" {
        return ""
    }
    // pch-2: a PCH stored under pch-1 kept no reads, so no build could check one.
    let mut lines = ["schema:pch-2", "libblink_std.h={archive_sha}", "runtime.h={runtime_sha}", "cc_id:{cc_id}", "arc_dir:{arc_dir}"]
    for f in sorted_strs(flags) {
        lines.push("flag:{f}")
    }
    for d in defines {
        lines.push("define:{d}")
    }
    for f in include_flags {
        lines.push("include:{f}")
    }
    // A vendored header the archive header pulls in under a gate is part of the PCH.
    for h in sorted_strs(vendored_headers) {
        lines.push("import:{h}")
    }
    digest_of_lines(lines)
}

pub fn pch_dir(key: Str) -> Str {
    "{obj_cache_dir()}/{key}.pch"
}

// The file in a PCH dir that clang reads through -include-pch.
pub fn clang_pch_name() -> Str {
    "libblink_std.h.pch"
}

// The PCH dir for key when its .gch is in place, and its entry marked as used; "" when not.
pub fn lookup_pch(key: Str) -> Str ! IO {
    lookup_pch_file(key, "libblink_std.h.gch")
}

// lookup_pch for the PCH file name a compiler reads.
pub fn lookup_pch_file(key: Str, name: Str) -> Str ! IO {
    if !cache_enabled() || key == "" {
        return ""
    }
    let dir = pch_dir(key)
    if file_exists("{dir}/{name}") == 0 {
        return ""
    }
    let _ = build_fs.touch("{obj_cache_dir()}/{key}.meta")
    dir
}

// Holds the PCH in dir for a build's units: a link or a copy of each of its files in hold,
// which the units read in place of dir, so the GC of another build can remove the entry while
// they compile. False, with nothing left in hold, when one cannot be held.
pub fn hold_pch(dir: Str, hold: Str) -> Bool ! IO {
    hold_pch_files(dir, hold, ["libblink_std.h", "runtime.h", "libblink_std.h.gch"])
}

// hold_pch for the files a PCH dir holds for a compiler.
pub fn hold_pch_files(dir: Str, hold: Str, names: List[Str]) -> Bool ! IO {
    if dir == "" || hold == "" || !build_fs.mkdir_p(hold) {
        return false
    }
    for name in names {
        if !hold_file("{dir}/{name}", "{hold}/{name}") {
            let _ = build_fs.remove_tree(hold)
            return false
        }
    }
    true
}

// A private dir that holds copies of the archive's libblink_std.h and runtime.h, for a PCH
// build to write its .gch beside; "" when the copies do not hash to the shas the key was
// made from, as when the archive changed after the build hashed it.
pub fn stage_pch(arc_dir: Str, archive_sha: Str, runtime_sha: Str) -> Str ! IO {
    let dir = make_private_dir()
    if dir == "" {
        return ""
    }
    for pair in [("libblink_std.h", archive_sha), ("runtime.h", runtime_sha)] {
        let (name, sha) = pair
        write_file("{dir}/{name}", read_file("{arc_dir}/{name}"))
        if (sha256_file_hex("{dir}/{name}") ?? "") != sha {
            let _ = build_fs.remove_tree(dir)
            return ""
        }
    }
    dir
}

// Whether libblink_std.h and runtime.h in arc_dir still hash to the shas a PCH key was made
// from. clang takes a PCH whose header changed but kept its size, so a PCH built from the
// archive dir is stored only when its headers did not change while it was built.
pub fn pch_headers_unchanged(arc_dir: Str, archive_sha: Str, runtime_sha: Str) -> Bool ! IO {
    (sha256_file_hex("{arc_dir}/libblink_std.h") ?? "") == archive_sha && (sha256_file_hex("{arc_dir}/runtime.h") ?? "") == runtime_sha
}

// Installs the staged dir as the PCH for key. False when another build installed it first, or
// the rename failed; the staged dir is gone either way.
pub fn store_pch(key: Str, staged: Str) -> Bool ! IO {
    let dir = pch_dir(key)
    // Under its key the dir is no longer one a reaper may take.
    build_fs.unmark(staged)
    if build_fs.rename(staged, dir) {
        write_file("{obj_cache_dir()}/{key}.meta", "{time.read().to_unix_secs()} pch \n")
        return true
    }
    let _ = build_fs.remove_tree(staged)
    false
}

// Drops the PCH for key, as when a unit that read it failed and compiled without it.
pub fn drop_pch(key: Str) ! IO {
    let _ = build_fs.remove_tree(pch_dir(key))
    fs_remove("{obj_cache_dir()}/{key}.meta")
}

// The apparent bytes of the files under dir. du would count the blocks they take, which can
// differ; the cap only starts an eviction and never changes what a build writes, so either
// unit holds it, and this one starts no program.
fn cache_total_bytes(dir: Str) -> Int ! IO {
    tree_bytes(dir, 0)
}

// The cache keeps its files at most two levels down (tmp/unit.<rand>/<file>). is_dir follows
// a link, so the depth bound ends a walk that a link to a parent would never end.
let CACHE_WALK_DEPTH: Int = 4

fn tree_bytes(path: Str, depth: Int) -> Int ! IO {
    if is_dir(path) != 1 {
        let n = build_fs.file_size(path)
        return if n < 0 { 0 } else { n }
    }
    if depth >= CACHE_WALK_DEPTH {
        return 0
    }
    let mut total = 0
    for name in list_dir(path) {
        total = total + tree_bytes("{path}/{name}", depth + 1)
    }
    total
}

fn cache_entry_count(dir: Str) -> Int {
    if file_exists(dir) == 0 {
        return 0
    }
    // Only count 16-hex-named .o files — those are real cache entries.
    // Other .o files in the directory (e.g. user-staged files in tests
    // that point BLINK_CACHE_DIR at an arbitrary scratch dir) are
    // ignored.
    let res = process_run("sh", ["-c", "ls -1 {dir}/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].o 2>/dev/null | wc -l"])
    let v = res.out.trim()
    if v == "" { 0 } else { v.to_int() }
}

// Opportunistic LRU eviction by .meta mtime until total <= cap_mb.
// Caller invokes this once at end of a build that stored anything.
pub fn maybe_gc() ! IO {
    if !cache_enabled() {
        return
    }
    let dir = obj_cache_dir()
    let cap_bytes = cache_size_cap_mb() * 1024 * 1024
    let mut total = cache_total_bytes(dir)
    if total <= cap_bytes {
        return
    }
    let listing = process_run("sh", ["-c", "ls -1tr {dir}/*.meta 2>/dev/null"])
    let lines = listing.out.split("\n")
    let mut idx = 0
    // Subtract per-entry size as we evict — re-walking the tree per
    // delete is O(N²) on big caches.
    while idx < lines.len() && total > cap_bytes {
        let meta_path = lines.get(idx).unwrap().trim()
        if meta_path != "" {
            let obj_path = meta_path.replace(".meta", ".o")
            let pch_path = meta_path.replace(".meta", ".pch")
            let reads_path = meta_path.replace(".meta", ".reads")
            let freed = tree_bytes(obj_path, 0) + tree_bytes(meta_path, 0) + tree_bytes(pch_path, 0) + tree_bytes(reads_path, 0)
            fs_remove(obj_path)
            fs_remove(reads_path)
            let _ = build_fs.remove_tree(pch_path)
            fs_remove(meta_path)
            total = total - freed
        }
        idx = idx + 1
    }
}

// Dev knob: BLINK_DEV_OBJCACHE_EVICT=<point> empties the cache, as `blink cache clean` does,
// when the build reaches point ("compile": after its lookups, before its units compile;
// "link": before its link). It stands in for another build's GC at that moment, so a test
// can make that race happen every time. Answers whether it emptied the cache.
pub fn dev_evict_at(point: Str) -> Bool ! IO {
    if !cache_enabled() || (env.var("BLINK_DEV_OBJCACHE_EVICT") ?? "") != point {
        return false
    }
    let _ = cmd_clean("")
    true
}

pub fn cmd_info() -> Int ! IO {
    let dir = obj_cache_dir()
    let count = cache_entry_count(dir)
    let total_kb = cache_total_bytes(dir) / 1024
    let total_mb = total_kb / 1024
    io.println("blink object cache")
    io.println("  location: {dir}")
    io.println("  entries: {count}")
    io.println("  size: {total_mb} MiB ({total_kb} KiB)")
    io.println("  cap: {cache_size_cap_mb()} MiB")
    0
}

pub fn cmd_clean(older_than: Str) -> Int {
    let dir = obj_cache_dir()
    if file_exists(dir) == 0 {
        return 0
    }
    if older_than == "" {
        shell_exec("rm -rf {dir}/*.o {dir}/*.pch {dir}/*.reads {dir}/*.meta 2>/dev/null")
        return 0
    }
    // older_than format: "Nd" / "Nh" / "Nm". Convert to find -mtime / -mmin.
    // The unit is checked as an ASCII byte first, so the cut that drops it never lands
    // inside a multi-byte codepoint.
    let unit = older_than.byte_at(older_than.byte_len() - 1)
    if unit != 100 && unit != 104 && unit != 109 { // d h m
        io.eprintln("error: --older-than expects format like '7d', '12h', or '30m'")
        return 1
    }
    let n = older_than.byte_slice(0, older_than.byte_len() - 1).to_int()
    let find_arg = if unit == 100 {
        "-mtime +{n - 1}"
    } else if unit == 104 {
        "-mmin +{n * 60}"
    } else {
        "-mmin +{n}"
    }
    let prune = "find {dir} -maxdepth 1 -name '*.meta' {find_arg} -print"
    let listing = process_run("sh", ["-c", prune])
    let lines = listing.out.split("\n")
    let mut i = 0
    while i < lines.len() {
        let meta = lines.get(i).unwrap().trim()
        if meta != "" {
            let obj = meta.replace(".meta", ".o")
            let pch = meta.replace(".meta", ".pch")
            let reads = meta.replace(".meta", ".reads")
            shell_exec("rm -rf {meta} {obj} {pch} {reads}")
        }
        i = i + 1
    }
    0
}

// Hidden sub-subcommands used by tests to drive the cache directly.
// Return 0/1 so the test can assert exit codes.
pub fn cmd_internal_lookup(key: Str) -> Int ! IO {
    let p = lookup_obj(key)
    if p == "" {
        return 1
    }
    io.println(p)
    0
}

pub fn cmd_internal_store(key: Str, src_obj: Str, module_key: Str, src_sha: Str) -> Int ! IO {
    if file_exists(src_obj) == 0 {
        io.eprintln("error: source obj does not exist: {src_obj}")
        return 1
    }
    let stage = make_tmp_dir("stage")
    if stage == "" {
        io.eprintln("error: cannot make a staging directory in {obj_cache_dir()}/tmp")
        return 1
    }
    let staging = "{stage}/{key}.o"
    shell_exec("cp {src_obj} {staging}")
    store(key, staging, module_key, src_sha)
    let _ = build_fs.remove_tree(stage)
    0
}

pub fn cmd_internal_gc() -> Int ! IO {
    maybe_gc()
    0
}

pub fn cmd_key(text: Str) -> Int {
    let k = key_from_text(text)
    io.println(k)
    0
}
