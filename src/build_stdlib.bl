// Stdlib archive build orchestrator.
//
// Produces `build/libblink_std.a` (a symlink into a content-hashed
// `build/std-cache/<hash>/`) plus `libblink_std.h` (extern decls +
// typedefs) and `monolith.o` (all stdlib bodies). The header is
// consumed by the per-module peel loop — when `peeled` is non-empty,
// each peeled module compiles into its own `.o` that includes
// `libblink_std.h` and links against the shrunk monolith.
//
// Cache key includes `peeled` so invalidation is automatic.

import lexer.{Lex}
import parser.{Parse}
import typecheck.{TypeCheck, check_types, desugar_sealed_ops_calls}
import compiler.{compile_to_program, check_unused_imports, embedded_keys}
import cg.{Codegen, CgConfig, generate, generate_archive_header}
import mutation_analysis.{analyze_mutations, analyze_save_restore}
import escape.{analyze_escapes}
import mono.{run_mono}
import diagnostics.{Diag, diag_count, diag_ice_count, diag_flush}
import cli.{resolve_install_root, run_cc, process_compiler_sha, blink_cli_version}
import stdlib_native_deps.{peeled_module_keys, peeled_module_dotted, peeled_module_underscored}
import std_cache_key.{compute_cache_key, archive_compiler_path, sha256_of_file_first, sha256_of_manifest}
import std.path.{path_join}

pub fn resolve_runtime_h() -> Str {
    let blink_root = env.var("BLINK_ROOT") ?? ""
    if blink_root != "" {
        let p_build = path_join(blink_root, "build/runtime.h")
        if file_exists(p_build) == 1 { return p_build }
        let p_boot = path_join(blink_root, "bootstrap/runtime.h")
        if file_exists(p_boot) == 1 { return p_boot }
    }
    let install_root = resolve_install_root()
    if install_root != "" {
        // A dev tree's own build/ first, chosen as resolve_archive_dir chooses it: an
        // archive rebuilt there must not take the runtime.h of the directory blink runs in.
        let p_dev = path_join(install_root, "build/runtime.h")
        if file_exists(path_join(install_root, "build/libblink_std.a")) == 1 && file_exists(p_dev) == 1 { return p_dev }
        let p_install = path_join(install_root, "share/blink/runtime.h")
        if file_exists(p_install) == 1 { return p_install }
    }
    if file_exists("build/runtime.h") == 1 { return "build/runtime.h" }
    if file_exists("bootstrap/runtime.h") == 1 { return "bootstrap/runtime.h" }
    ""
}

fn resolve_stdlib_dir() -> Str {
    let root = resolve_install_root()
    if root != "" {
        let candidate = path_join(root, "lib/std")
        if file_exists(candidate) == 1 {
            return candidate
        }
    }
    if file_exists("lib/std") == 1 {
        return "lib/std"
    }
    ""
}

pub fn list_stdlib_modules() -> List[Str] {
    let std_dir = resolve_stdlib_dir()
    let mut out: List[Str] = []
    if std_dir != "" {
        let entries = list_dir(std_dir)
        let mut i = 0
        while i < entries.len() {
            let entry = entries.get(i).unwrap()
            if entry.ends_with(".bl") {
                let stem = entry.byte_slice(0, entry.byte_len() - 3)
                out.push("std.{stem}")
            }
            i = i + 1
        }
    } else {
        let keys = embedded_keys()
        let mut i = 0
        while i < keys.len() {
            let key = keys.get(i).unwrap()
            // Only re-export std/* entries; pkg/* are package-manager modules.
            if key.starts_with("std/") {
                let stem = key.byte_slice(4, key.byte_len())
                out.push("std.{stem}")
            }
            i = i + 1
        }
    }
    sort_strs(out)
    out
}

// Same module list as list_stdlib_modules() but in the underscore form
// node_source_module() yields ("std_json", not "std.json"). Used to
// populate the emit config's skip_modules so the archive provides those bodies.
//
// Peeled modules (those backed by a vendored native dep, see
// stdlib_native_deps) are excluded here because they're NOT in the
// archive — codegen must emit their bodies into the user TU. Subtracting
// them from the skip set is how that emission gets triggered.
pub fn list_stdlib_module_keys() -> List[Str] {
    let mods = list_stdlib_modules()
    let peeled = peeled_module_underscored()
    let mut out: List[Str] = []
    let mut i = 0
    while i < mods.len() {
        let key = mods.get(i).unwrap().replace(".", "_")
        if !peeled.contains(key) { out.push(key) }
        i = i + 1
    }
    out
}

fn sort_strs(xs: List[Str]) {
    // Insertion sort. Small N (~38), no need for anything fancier.
    let mut i = 1
    while i < xs.len() {
        let cur = xs.get(i).unwrap()
        let mut j = i
        while j > 0 && xs.get(j - 1).unwrap() > cur {
            xs.set(j, xs.get(j - 1).unwrap())
            j = j - 1
        }
        xs.set(j, cur)
        i = i + 1
    }
}

fn synthesize_entry_source(modules: List[Str]) -> Str {
    let mut sb = StringBuilder.new()
    let mut i = 0
    while i < modules.len() {
        sb.write("import ")
        sb.write(modules.get(i).unwrap())
        sb.write("\n")
        i = i + 1
    }
    sb.write("\n")
    sb.write("fn main() \{\}\n")
    sb.to_str()
}

fn build_manifest(compiler: Str, std_dir: Str, modules: List[Str], rt_path: Str, peeled: List[Str]) -> Str {
    let mut sb = StringBuilder.new()
    sb.write("compiler-path:")
    sb.write(compiler)
    sb.write("\n")
    sb.write("std-dir:")
    sb.write(std_dir)
    sb.write("\n")
    let mut i = 0
    while i < modules.len() {
        sb.write("mod:")
        sb.write(modules.get(i).unwrap())
        sb.write("\n")
        i = i + 1
    }
    sb.write("runtime-path:")
    sb.write(rt_path)
    sb.write("\n")
    sb.write("peeled:")
    let mut p = 0
    while p < peeled.len() {
        if p > 0 { sb.write(",") }
        sb.write(peeled.get(p).unwrap())
        p = p + 1
    }
    sb.write("\n")
    sb.to_str()
}

// Every dev run and build gets here, often several at once, so a link that already
// points at the cache dir is left alone, and one that does not is replaced by a
// rename: a concurrent link never finds it missing.
fn relink_archive(build_dir: Str, cache_dir_rel: Str) {
    let mut cmd = StringBuilder.new()
    cmd.write("for f in libblink_std.a libblink_std.h skip_modules.txt .archive-id; do ")
    cmd.write("t=\"{cache_dir_rel}/$f\"; l=\"{build_dir}/$f\"; ")
    cmd.write("[ \"$(readlink \"$l\")\" = \"$t\" ] || \{ ln -sfn \"$t\" \"$l.$$\" && mv -f \"$l.$$\" \"$l\"; \}; ")
    cmd.write("done")
    shell_exec(cmd.to_str())
}

fn write_skip_modules_file(path: Str, keys: List[Str]) {
    let mut sb = StringBuilder.new()
    let mut i = 0
    while i < keys.len() {
        sb.write(keys.get(i).unwrap())
        sb.write("\n")
        i = i + 1
    }
    write_file(path, sb.to_str())
}

fn bail_on_diag() -> Int ! Diag.Report {
    if diag_ice_count > 0 {
        diag_flush()
        return 101
    }
    if diag_count > 0 {
        diag_flush()
        return 1
    }
    0
}

pub fn stdlib_rebuild_forced() -> Bool {
    (env.var("BLINK_FORCE_STDLIB_REBUILD") ?? "") != ""
}

pub fn build_stdlib_archive(peeled: List[Str]) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, Codegen {
    build_stdlib_archive_in("build", peeled, stdlib_rebuild_forced())
}

// Builds the archive under build_dir/std-cache/<key> unless that entry exists, and
// points build_dir's archive links at it.
pub fn build_stdlib_archive_in(build_dir: Str, peeled: List[Str], force_rebuild: Bool) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, Codegen {
    let compiler = archive_compiler_path()
    if compiler == "" {
        io.eprintln("error: cannot locate the running compiler binary, which the stdlib-archive cache key must hash")
        return 1
    }
    let std_dir = resolve_stdlib_dir()
    let rt_path_final = resolve_runtime_h()
    if rt_path_final == "" {
        io.eprintln("error: cannot locate runtime.h (checked $BLINK_ROOT/build, $BLINK_ROOT/bootstrap, <install-root>/build, <install-root>/share/blink, ./build, ./bootstrap)")
        return 1
    }

    let all_modules = list_stdlib_modules()
    // Strip peeled (dotted-form) modules from the archive entry imports.
    // Their bodies are excluded from monolith.o; codegen emits them into
    // the user TU on demand (gated by the emit config's skip_modules subtraction in
    // list_stdlib_module_keys).
    let peeled_set = peeled_module_dotted()
    let mut modules: List[Str] = []
    let mut mi = 0
    while mi < all_modules.len() {
        let m = all_modules.get(mi).unwrap()
        if !peeled_set.contains(m) { modules.push(m) }
        mi = mi + 1
    }
    let manifest = build_manifest(compiler, std_dir, modules, rt_path_final, peeled)
    let hash = compute_cache_key(compiler, std_dir, rt_path_final, manifest)
    if hash == "" {
        io.eprintln("error: failed to compute stdlib-archive cache key")
        return 1
    }
    let final_dir = "{build_dir}/std-cache/{hash}"
    if file_exists("{final_dir}/.stamp") == 1 && !force_rebuild {
        // Backfill the identity stamp for caches built before .archive-id
        // existed, so relink_archive's symlink never dangles.
        if file_exists("{final_dir}/.archive-id") == 0 {
            write_archive_id("{final_dir}/.archive-id", rt_path_final, "{final_dir}/libblink_std.h")
        }
        relink_archive(build_dir, "std-cache/{hash}")
        return 0
    }
    // Built aside and renamed into place, so a concurrent build of the same key never
    // reads a half-written entry.
    let cache_dir = "{final_dir}.tmp-{getpid()}"
    shell_exec("rm -rf {cache_dir}")
    shell_exec("mkdir -p {cache_dir}")

    let entry_bl = "{cache_dir}/__archive_main.bl"
    write_file(entry_bl, synthesize_entry_source(modules))
    let program = compile_to_program(entry_bl, 1)
    let _tc_err = check_types(program)
    check_unused_imports()
    let tc_rc = bail_on_diag()
    if tc_rc != 0 { return tc_rc }
    desugar_sealed_ops_calls(program)
    analyze_mutations(program)
    analyze_save_restore(program)
    analyze_escapes(program)
    run_mono(program)
    let esc_rc = bail_on_diag()
    if esc_rc != 0 { return esc_rc }

    // The archive is the whole stdlib in one TU: no module filter, nothing skipped.
    let hdr_cfg = CgConfig { debug_mode: 0, trace_codegen: 0, deterministic: 0,
        emit_only_module: "", skip_modules: Map(), user_tu_mode: 0,
        blink_ev_extern_only: 0, archive_build_mode: 0, archive_over_std: 0, compiler_archive_modules: Map() }
    let header = generate_archive_header(program, hdr_cfg)
    let hdr_rc = bail_on_diag()
    if hdr_rc != 0 { return hdr_rc }
    write_file("{cache_dir}/libblink_std.h", header)
    write_file("{cache_dir}/runtime.h", read_file(rt_path_final))

    let mono_cfg = CgConfig { debug_mode: 0, trace_codegen: 0, deterministic: 0,
        emit_only_module: "", skip_modules: Map(), user_tu_mode: 0,
        blink_ev_extern_only: 0, archive_build_mode: 1, archive_over_std: 0, compiler_archive_modules: Map() }
    let monolith_c = generate(program, mono_cfg)
    let mono_rc = bail_on_diag()
    if mono_rc != 0 { return mono_rc }
    write_file("{cache_dir}/monolith.c", monolith_c)
    // Peeled modules (e.g. std/db_sqlite) are excluded from monolith.c
    // entirely, so no BLINK_USE_<dep> macros are needed for the archive.
    // The user TU defines those macros itself when codegen emits a peeled
    // module body that references the vendored runtime header.
    let cc_args = "-c -ffunction-sections -fdata-sections -o {cache_dir}/monolith.o {cache_dir}/monolith.c -I{cache_dir}"
    let rc = run_cc(cc_args, 0, 1, "")
    if rc != 0 {
        io.eprintln("error: cc failed building stdlib monolith (rc={rc})")
        return rc
    }

    shell_exec("ar rcs {cache_dir}/libblink_std.a {cache_dir}/monolith.o")
    write_skip_modules_file("{cache_dir}/skip_modules.txt", list_stdlib_module_keys())
    write_archive_id("{cache_dir}/.archive-id", rt_path_final, "{cache_dir}/libblink_std.h")
    write_file("{cache_dir}/.stamp", "")
    if force_rebuild { shell_exec("rm -rf {final_dir}") }
    // A concurrent build of the same key that renamed first wins; its entry is as good.
    shell_exec("if [ -e {final_dir} ]; then rm -rf {cache_dir}; else mv {cache_dir} {final_dir}; fi")
    relink_archive(build_dir, "std-cache/{hash}")
    0
}

// Compatibility identity for the built archive: runtime.h SHA + the archive
// header (libblink_std.h) SHA + compiler SHA + the CLI version. A dev link
// rebuilds the archive when the compiler SHA does not name the running compiler.
// An *installed* archive (copied out of the cache dir, losing the hash-named
// directory) is never rebuilt, so the stamp lets it be checked against the
// compiler that links a user TU — guarding the ABI-skew class of bug where a
// stale installed archive is silently linked.
//
// BOTH headers are load-bearing ABI. runtime.h carries the runtime struct
// layouts; libblink_std.h carries the stdlib struct typedefs (e.g. db Row,
// std.args.* — emitted by codegen, so they can diverge when codegen changes
// even if runtime.h is byte-identical). The user TU `#include`s both. The
// function bodies are not in either header, so the verify side also requires
// the compiler SHA to name the running compiler.
fn archive_id_string(rt_path: Str, hdr_path: Str) -> Str {
    let rt_sha = sha256_of_file_first(rt_path)
    let hdr_sha = sha256_of_file_first(hdr_path)
    let bc_sha = process_compiler_sha()
    "{rt_sha}|{hdr_sha}|{bc_sha}|{blink_cli_version}"
}

fn write_archive_id(path: Str, rt_path: Str, hdr_path: Str) {
    write_file(path, "{archive_id_string(rt_path, hdr_path)}\n")
}
