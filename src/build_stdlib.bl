// Stdlib archive build orchestrator.
//
// Produces `build/libblink_std.a` (a symlink into a content-hashed
// `build/std-cache/<hash>/`) plus `libblink_std.h` (extern decls +
// typedefs) and `monolith.o` (all stdlib bodies). The header is
// consumed by the per-module peel loop — when `peeled` is non-empty,
// each peeled module compiles into its own `.o` that includes
// `libblink_std.h` and links against the shrunk monolith.
//
// Cache key includes `peeled` so invalidation is automatic.

import lexer.{Lex}
import parser.{Parse}
import typecheck.{TypeCheck, check_types}
import compiler.{compile_to_program, check_unused_imports, embedded_keys}
import codegen.{Codegen, generate, generate_archive_header}
import codegen_types.{cg_emit_only_module, cg_skip_modules, cg_archive_build_mode, list_contains_str}
import mutation_analysis.{analyze_mutations, analyze_save_restore}
import diagnostics.{Diag, diag_count, diag_ice_count, diag_flush}
import cli.{resolve_install_root, run_cc, sha256_of_file_first, process_blinkc_sha, blink_cli_version}
import stdlib_native_deps.{peeled_module_keys, peeled_module_dotted, peeled_module_underscored}
import std.path.{path_join}

fn resolve_under_root(rel: Str) -> Str {
    let blink_root = env.var("BLINK_ROOT") ?? ""
    if blink_root != "" {
        let p = path_join(blink_root, rel)
        if file_exists(p) == 1 {
            return p
        }
    }
    if file_exists(rel) == 1 {
        return rel
    }
    ""
}

pub fn resolve_blinkc_path() -> Str {
    resolve_under_root("build/blinkc")
}

pub fn resolve_runtime_h() -> Str {
    let blink_root = env.var("BLINK_ROOT") ?? ""
    if blink_root != "" {
        let p_build = path_join(blink_root, "build/runtime.h")
        if file_exists(p_build) == 1 { return p_build }
        let p_boot = path_join(blink_root, "bootstrap/runtime.h")
        if file_exists(p_boot) == 1 { return p_boot }
    }
    let install_root = resolve_install_root()
    if install_root != "" {
        let p_install = path_join(install_root, "share/blink/runtime.h")
        if file_exists(p_install) == 1 { return p_install }
    }
    if file_exists("build/runtime.h") == 1 { return "build/runtime.h" }
    if file_exists("bootstrap/runtime.h") == 1 { return "bootstrap/runtime.h" }
    ""
}

fn resolve_stdlib_dir() -> Str {
    let root = resolve_install_root()
    if root != "" {
        let candidate = path_join(root, "lib/std")
        if file_exists(candidate) == 1 {
            return candidate
        }
    }
    if file_exists("lib/std") == 1 {
        return "lib/std"
    }
    ""
}

pub fn list_stdlib_modules() -> List[Str] {
    let std_dir = resolve_stdlib_dir()
    let mut out: List[Str] = []
    if std_dir != "" {
        let entries = fs.list_dir(std_dir)
        let mut i = 0
        while i < entries.len() {
            let entry = entries.get(i).unwrap()
            if entry.ends_with(".bl") {
                let stem = entry.substring(0, entry.len() - 3)
                out.push("std.{stem}")
            }
            i = i + 1
        }
    } else {
        let keys = embedded_keys()
        let mut i = 0
        while i < keys.len() {
            let key = keys.get(i).unwrap()
            // Only re-export std/* entries; pkg/* are package-manager modules.
            if key.starts_with("std/") {
                let stem = key.substring(4, key.len() - 4)
                out.push("std.{stem}")
            }
            i = i + 1
        }
    }
    sort_strs(out)
    out
}

// Same module list as list_stdlib_modules() but in the underscore form
// node_source_module() yields ("std_json", not "std.json"). Used to
// populate cg_skip_modules so the archive provides those bodies.
//
// Peeled modules (those backed by a vendored native dep, see
// stdlib_native_deps) are excluded here because they're NOT in the
// archive — codegen must emit their bodies into the user TU. Subtracting
// them from the skip set is how that emission gets triggered.
pub fn list_stdlib_module_keys() -> List[Str] {
    let mods = list_stdlib_modules()
    let peeled = peeled_module_underscored()
    let mut out: List[Str] = []
    let mut i = 0
    while i < mods.len() {
        let key = mods.get(i).unwrap().replace(".", "_")
        if list_contains_str(peeled, key) == 0 { out.push(key) }
        i = i + 1
    }
    out
}

fn sort_strs(xs: List[Str]) {
    // Insertion sort. Small N (~38), no need for anything fancier.
    let mut i = 1
    while i < xs.len() {
        let cur = xs.get(i).unwrap()
        let mut j = i
        while j > 0 && xs.get(j - 1).unwrap() > cur {
            xs.set(j, xs.get(j - 1).unwrap())
            j = j - 1
        }
        xs.set(j, cur)
        i = i + 1
    }
}

fn synthesize_entry_source(modules: List[Str]) -> Str {
    let mut sb = StringBuilder.new()
    let mut i = 0
    while i < modules.len() {
        sb.write("import ")
        sb.write(modules.get(i).unwrap())
        sb.write("\n")
        i = i + 1
    }
    sb.write("\n")
    sb.write("fn main() \{\}\n")
    sb.to_str()
}

fn build_manifest(blinkc: Str, std_dir: Str, modules: List[Str], rt_path: Str, peeled: List[Str]) -> Str {
    let mut sb = StringBuilder.new()
    sb.write("blinkc-path:")
    sb.write(blinkc)
    sb.write("\n")
    sb.write("std-dir:")
    sb.write(std_dir)
    sb.write("\n")
    let mut i = 0
    while i < modules.len() {
        sb.write("mod:")
        sb.write(modules.get(i).unwrap())
        sb.write("\n")
        i = i + 1
    }
    sb.write("runtime-path:")
    sb.write(rt_path)
    sb.write("\n")
    sb.write("peeled:")
    let mut p = 0
    while p < peeled.len() {
        if p > 0 { sb.write(",") }
        sb.write(peeled.get(p).unwrap())
        p = p + 1
    }
    sb.write("\n")
    sb.to_str()
}

// Hash a heredoc-fed manifest text + extra `sha256sum` lines into a
// 16-hex digest. Shared between this module's stdlib-archive cache and
// `build_objcache.sha256_of_manifest`.
pub fn sha256_of_manifest(text: Str) -> Str {
    let mut cmd = StringBuilder.new()
    cmd.write("(cat <<'__BLINK_MANIFEST_EOF__'\n")
    cmd.write(text)
    if !text.ends_with("\n") {
        cmd.write("\n")
    }
    cmd.write("__BLINK_MANIFEST_EOF__\n")
    cmd.write(") | sha256sum | cut -c1-16")
    let res = process_run("sh", ["-c", cmd.to_str()])
    res.out.trim()
}

fn compute_cache_key(blinkc: Str, std_dir: Str, rt_path: Str, manifest: Str) -> Str {
    // Cache key = sha256 over manifest + content of compiler binary,
    // stdlib sources, runtime.h, cc version. Manifest is fed inline via
    // a heredoc so we don't touch the disk on the cache-hit path.
    let mut cmd = StringBuilder.new()
    cmd.write("(cat <<'__BLINK_MANIFEST_EOF__'\n")
    cmd.write(manifest)
    cmd.write("__BLINK_MANIFEST_EOF__\n")
    if blinkc != "" {
        cmd.write("sha256sum {blinkc} 2>/dev/null\n")
    }
    cmd.write("sha256sum {std_dir}/*.bl 2>/dev/null\n")
    if rt_path != "" {
        cmd.write("sha256sum {rt_path} 2>/dev/null\n")
    }
    cmd.write("cc --version 2>&1 | head -1) | sha256sum | cut -c1-16")

    let res = process_run("sh", ["-c", cmd.to_str()])
    res.out.trim()
}

fn relink_archive(cache_dir_rel: Str) {
    shell_exec("ln -sfn {cache_dir_rel}/libblink_std.a build/libblink_std.a")
    shell_exec("ln -sfn {cache_dir_rel}/libblink_std.h build/libblink_std.h")
    shell_exec("ln -sfn {cache_dir_rel}/skip_modules.txt build/skip_modules.txt")
    shell_exec("ln -sfn {cache_dir_rel}/.archive-id build/.archive-id")
}

fn write_skip_modules_file(path: Str, keys: List[Str]) {
    let mut sb = StringBuilder.new()
    let mut i = 0
    while i < keys.len() {
        sb.write(keys.get(i).unwrap())
        sb.write("\n")
        i = i + 1
    }
    write_file(path, sb.to_str())
}

fn bail_on_diag() -> Int ! Diag.Report {
    if diag_ice_count > 0 {
        diag_flush()
        return 101
    }
    if diag_count > 0 {
        diag_flush()
        return 1
    }
    0
}

pub fn build_stdlib_archive(peeled: List[Str]) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, Codegen {
    let blinkc = resolve_blinkc_path()
    let std_dir = resolve_stdlib_dir()
    let rt_path_final = resolve_runtime_h()
    if rt_path_final == "" {
        io.eprintln("error: cannot locate runtime.h (checked $BLINK_ROOT/build, $BLINK_ROOT/bootstrap, <install-root>/share/blink, ./build, ./bootstrap)")
        return 1
    }

    let all_modules = list_stdlib_modules()
    // Strip peeled (dotted-form) modules from the archive entry imports.
    // Their bodies are excluded from monolith.o; codegen emits them into
    // the user TU on demand (gated by cg_skip_modules subtraction in
    // list_stdlib_module_keys).
    let peeled_set = peeled_module_dotted()
    let mut modules: List[Str] = []
    let mut mi = 0
    while mi < all_modules.len() {
        let m = all_modules.get(mi).unwrap()
        if list_contains_str(peeled_set, m) == 0 { modules.push(m) }
        mi = mi + 1
    }
    let manifest = build_manifest(blinkc, std_dir, modules, rt_path_final, peeled)
    let hash = compute_cache_key(blinkc, std_dir, rt_path_final, manifest)
    if hash == "" {
        io.eprintln("error: failed to compute stdlib-archive cache key")
        return 1
    }
    let cache_dir = "build/std-cache/{hash}"
    let stamp = "{cache_dir}/.stamp"
    let force_rebuild = (env.var("BLINK_FORCE_STDLIB_REBUILD") ?? "") != ""
    if file_exists(stamp) == 1 && !force_rebuild {
        // Backfill the identity stamp for caches built before .archive-id
        // existed, so relink_archive's symlink never dangles (br 105z02).
        if file_exists("{cache_dir}/.archive-id") == 0 {
            write_archive_id("{cache_dir}/.archive-id", rt_path_final, "{cache_dir}/libblink_std.h")
        }
        relink_archive("std-cache/{hash}")
        return 0
    }
    shell_exec("mkdir -p {cache_dir}")

    let entry_bl = "{cache_dir}/__archive_main.bl"
    write_file(entry_bl, synthesize_entry_source(modules))
    let program = compile_to_program(entry_bl, 1)
    let _tc_err = check_types(program)
    check_unused_imports()
    let tc_rc = bail_on_diag()
    if tc_rc != 0 { return tc_rc }
    analyze_mutations(program)
    analyze_save_restore(program)

    cg_emit_only_module = ""
    cg_skip_modules = Map()
    cg_archive_build_mode = 0

    let header = generate_archive_header(program)
    let hdr_rc = bail_on_diag()
    if hdr_rc != 0 { return hdr_rc }
    write_file("{cache_dir}/libblink_std.h", header)
    write_file("{cache_dir}/runtime.h", read_file(rt_path_final))

    cg_archive_build_mode = 1
    let monolith_c = generate(program)
    cg_archive_build_mode = 0
    let mono_rc = bail_on_diag()
    if mono_rc != 0 { return mono_rc }
    write_file("{cache_dir}/monolith.c", monolith_c)
    // Peeled modules (e.g. std/db_sqlite) are excluded from monolith.c
    // entirely, so no BLINK_USE_<dep> macros are needed for the archive.
    // The user TU defines those macros itself when codegen emits a peeled
    // module body that references the vendored runtime header.
    let cc_args = "-c -ffunction-sections -fdata-sections -o {cache_dir}/monolith.o {cache_dir}/monolith.c -I{cache_dir}"
    let rc = run_cc(cc_args, 0, 1, "")
    if rc != 0 {
        io.eprintln("error: cc failed building stdlib monolith (rc={rc})")
        return rc
    }

    shell_exec("ar rcs {cache_dir}/libblink_std.a {cache_dir}/monolith.o")
    write_skip_modules_file("{cache_dir}/skip_modules.txt", list_stdlib_module_keys())
    write_archive_id("{cache_dir}/.archive-id", rt_path_final, "{cache_dir}/libblink_std.h")
    write_file(stamp, "")
    relink_archive("std-cache/{hash}")
    0
}

// Compatibility identity for the built archive: runtime.h SHA + the archive
// header (libblink_std.h) SHA + blinkc SHA + the CLI version. These are the
// same inputs the std-cache hash already covers, so a dev build is
// self-consistent by construction. The stamp exists so an *installed* archive
// (copied out of the cache dir, losing the hash-named directory) can still be
// checked against the compiler that links a user TU — guarding the ABI-skew
// class of bug where a stale installed archive is silently linked (br 105z02).
//
// BOTH headers are load-bearing ABI. runtime.h carries the runtime struct
// layouts; libblink_std.h carries the stdlib struct typedefs (e.g. db Row,
// std.args.* — emitted by codegen, so they can diverge when codegen changes
// even if runtime.h is byte-identical). The user TU `#include`s both, so the
// verify side gates on both SHAs. blinkc SHA is recorded for forensics but
// not re-checked (an installed tree ships no blinkc to hash).
fn archive_id_string(rt_path: Str, hdr_path: Str) -> Str {
    let rt_sha = sha256_of_file_first(rt_path)
    let hdr_sha = sha256_of_file_first(hdr_path)
    let bc_sha = process_blinkc_sha()
    "{rt_sha}|{hdr_sha}|{bc_sha}|{blink_cli_version}"
}

fn write_archive_id(path: Str, rt_path: Str, hdr_path: Str) {
    write_file(path, "{archive_id_string(rt_path, hdr_path)}\n")
}
