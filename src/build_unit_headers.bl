// build_unit_headers.bl: which program declarations each unit of the per-module build holds.
//
// A unit holds the declaration of each symbol its text names, and no other, written into the
// unit itself in place of the module headers. Its imports do not answer this. A module
// imported for a type alone needs no declaration, since every type is in the types header that
// every unit includes. And a unit names symbols of modules it never imports: a method of a type
// it got through another module, the init function of every module from the entry unit, an
// instance it calls of a generic declared elsewhere.
//
// The declarations are written into the unit, not included from the module headers, because
// the object cache keys a unit on the bytes it compiles. A header holds every declaration of a
// module, so an added pub fn would change the key of every unit that includes it. A unit's own
// declarations, so the C a unit compiles changes only when a declaration it uses changes.
//
// Leaving a declaration out can never compile to wrong code: C rejects a read of an undeclared
// name, and a unit compiles with -Werror=implicit-function-declaration, since a C compiler
// before C99 rules (gcc before 14) only warns on a call to an undeclared function and then
// guesses an int return. So a missed declaration is a build error. The scan reads whole
// identifiers in code, so a name can match only itself.

pub type HeaderIndex {
    // Every header that declares a symbol, by the symbol.
    by_symbol: Map[Str, List[Str]]
    // The headers a scan cannot vouch for, which every unit includes whole.
    always: List[Str]
    // Why each header of `always` is there, for the trace that counts them.
    why: Map[Str, Str]
    // Each other header's declarations, in the order the header has them.
    decls: Map[Str, List[Decl]]
}

pub type Decl {
    name: Str
    line: Str
}

// What a unit holds of the module headers: an include of each header in `whole`, then each
// line of `lines`.
pub type UnitDecls {
    whole: List[Str]
    lines: List[Str]
}

// Every program symbol has this in its name, so the scan looks only at the words that do. A
// header that declares a name without it is put in `always`.
fn symbol_mark() -> Str { "blink" }

// The index of `texts`, the headers named by `names` at the same position. `types` is the
// types header, the one include a header may hold and still be read line by line.
pub fn index_headers(names: List[Str], texts: List[Str], types: Str) -> HeaderIndex {
    let mut by_symbol: Map[Str, List[Str]] = Map()
    let mut always: List[Str] = []
    let mut why: Map[Str, Str] = Map()
    let mut decls: Map[Str, List[Decl]] = Map()
    let mut i = 0
    while i < names.len() {
        let name = names.get(i).unwrap()
        match declared(texts.get(i).unwrap(), types) {
            Ok(ds) => {
                let mut readable = true
                for d in ds {
                    if !d.name.contains(symbol_mark()) {
                        if readable { why.insert(name, "a name without \"{symbol_mark()}\": {d.line}") }
                        readable = false
                        continue
                    }
                    let mut hs = by_symbol.get(d.name) ?? []
                    hs.push(name)
                    by_symbol.insert(d.name, hs)
                }
                if readable {
                    decls.insert(name, ds)
                } else {
                    always.push(name)
                }
            }
            Err(line) => {
                why.insert(name, "a line the scan cannot read: {line}")
                always.push(name)
            }
        }
        i = i + 1
    }
    HeaderIndex { by_symbol: by_symbol, always: always, why: why, decls: decls }
}

// The declarations of a module header, or the first line that is not its guard, an include of
// `types` or a one-line declaration. Such a line might declare a name this reader cannot see,
// or a macro a unit needs, so that header is included whole.
fn declared(text: Str, types: Str) -> Result[List[Decl], Str] {
    let mut out: List[Decl] = []
    for line in text.lines() {
        if line == "" { continue }
        if line.starts_with("#") {
            if !is_guard_line(line, types) { return Err(line) }
            continue
        }
        if !line.ends_with(";") || line.starts_with(" ") || line.starts_with("typedef") || line.starts_with("struct") || line.starts_with("union") || line.starts_with("enum") || line.starts_with("}") {
            return Err(line)
        }
        // A prototype's name is the word before its parameter list, a global's the last word.
        let head = match line.byte_index_of("(", 0) {
            Some(p) => line.byte_slice(0, p)
            None => line.byte_slice(0, line.byte_len() - 1)
        }
        let name = last_word(head)
        if name == "" { return Err(line) }
        out.push(Decl { name: name, line: line })
    }
    Ok(out)
}

// A line of the include guard, or the include of the types header. A `#define` with a value
// is a macro, not a guard.
fn is_guard_line(line: Str, types: Str) -> Bool {
    if line == "#endif" || line == "#include \"{types}\"" { return true }
    let words = line.split(" ").filter(fn(w) { w != "" })
    if words.len() != 2 { return false }
    let kw = words.get(0).unwrap()
    kw == "#ifndef" || kw == "#define"
}

fn is_word_byte(b: U8) -> Bool {
    (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95
}

fn last_word(s: Str) -> Str {
    let mut end = s.byte_len()
    while end > 0 && !is_word_byte(s.byte_at(end - 1)) { end = end - 1 }
    let mut start = end
    while start > 0 && is_word_byte(s.byte_at(start - 1)) { start = start - 1 }
    s.byte_slice(start, end)
}

// The identifiers of `c` that some header declares. Strings, character constants and comments
// are skipped, since a name there names nothing: counting it would only add a declaration,
// but it would put that declaration in the unit's key for no use.
fn named_symbols(c: Str, idx: HeaderIndex) -> Map[Str, Bool] {
    let mut out: Map[Str, Bool] = Map()
    let mark = symbol_mark()
    let n = c.byte_len()
    let mut i = 0
    while i < n {
        let b = c.byte_at(i)
        if is_word_byte(b) {
            let start = i
            while i < n && is_word_byte(c.byte_at(i)) { i = i + 1 }
            let word = c.byte_slice(start, i)
            if word.contains(mark) && idx.by_symbol.contains_key(word) { out.insert(word, true) }
        } else if b == 34 || b == 39 {
            i = past_quoted(c, i)
        } else if b == 47 && i + 1 < n && c.byte_at(i + 1) == 47 {
            i = match c.byte_index_of("\n", i) {
                Some(p) => p
                None => n
            }
        } else if b == 47 && i + 1 < n && c.byte_at(i + 1) == 42 {
            i = match c.byte_index_of("*/", i + 2) {
                Some(p) => p + 2
                None => n
            }
        } else {
            i = i + 1
        }
    }
    out
}

// The offset just past the string or character constant that opens at `at`. A constant cannot
// span a line, so an unclosed one ends at the newline and the scan reads on from there.
fn past_quoted(c: Str, at: Int) -> Int {
    let q = c.byte_at(at)
    let n = c.byte_len()
    let mut j = at + 1
    while j < n {
        let b = c.byte_at(j)
        if b == 92 {
            j = j + 2
        } else if b == q {
            return j + 1
        } else if b == 10 {
            return j
        } else {
            j = j + 1
        }
    }
    n
}

// What `c` holds of the headers: every header in `always` whole, and the declaration of each
// word of `c` that a readable header declares. The headers of `own` come first, then the rest
// in the order of `order`, each in its own order, so the same uses give the same bytes. A
// declaration two headers both hold is written once.
pub fn unit_declarations(c: Str, own: List[Str], idx: HeaderIndex, order: List[Str]) -> UnitDecls {
    let used = named_symbols(c, idx)
    let mut seq: List[Str] = []
    for h in own { seq.push(h) }
    for h in order {
        if !own.contains(h) { seq.push(h) }
    }
    let mut whole: List[Str] = []
    let mut lines: List[Str] = []
    let mut seen: Set[Str] = Set()
    for h in seq {
        match idx.decls.get(h) {
            Some(ds) => {
                for d in ds {
                    if used.contains_key(d.name) && !seen.contains(d.line) {
                        seen.insert(d.line)
                        lines.push(d.line)
                    }
                }
            }
            None => {
                if idx.always.contains(h) { whole.push(h) }
            }
        }
    }
    UnitDecls { whole: whole, lines: lines }
}

// `c` with its include of `own` replaced by an include of `types`, an include of each header
// of `d.whole`, and the lines of `d.lines`, or None if `c` has no include of `own`.
pub fn splice_declarations(c: Str, own: Str, types: Str, d: UnitDecls) -> Option[Str] {
    let line = "#include \"{own}\"\n"
    let at = match c.byte_index_of(line, 0) {
        Some(p) => p
        None => return None
    }
    let mut sb = StringBuilder.new()
    sb.write(c.byte_slice(0, at))
    sb.write("#include \"{types}\"\n")
    for h in d.whole { sb.write("#include \"{h}\"\n") }
    for l in d.lines {
        sb.write(l)
        sb.write("\n")
    }
    sb.write(c.byte_slice(at + line.byte_len(), c.byte_len()))
    Some(sb.to_str())
}
