// Flags for the C compiles of the C that blink generates, shared by blink build and by the
// blinkc entry that a hand-written cc line asks for its probe flags.

// Flags each per-module unit compiles with, on top of cc_opt_flags. A unit holds only the
// declarations its scan found, so a missed one must stop the build: gcc before 14 only warns
// on a call to an undeclared function and then guesses an int return.
pub fn unit_cc_flags() -> List[Str] {
    let mut flags = ["-Werror=implicit-function-declaration"]
    for f in generated_c_flags() { flags.push(f) }
    flags
}

// Flags for each compile of C that blink generates, and never for a user's C source. A call
// through a header's prototype passes a Ptr[U8] as uint8_t * where C takes char *, and clang
// warns on the sign of the pointer target by default. No change to the Blink source can stop
// that warning, so it is noise to a user. The prototype test (§9.1) and the unit compile both
// make a wrong pointer type and an int to pointer conversion errors, so that a call the test
// passes also compiles in the unit, on each C compiler.
pub fn generated_c_flags() -> List[Str] {
    ["-Wno-pointer-sign", "-Werror=incompatible-pointer-types", "-Werror=int-conversion"]
}

// The flag that lifts the C compiler's error limit, for a probe that reads every error, from
// the compiler's `--version` text. clang stops after 20 errors by default, and a probe that
// stops declares nothing. gcc has no such limit and rejects the flag. The first line names
// the compiler: a later line can hold a path that says clang.
pub fn cc_error_limit_flag(version: Str) -> Str {
    if version.split("\n").get(0).unwrap().contains("clang") { " -ferror-limit=0" } else { "" }
}

// Why the probe cannot read its errors under the cflag `flag`, or None when it can. A probe reads
// each error that names a prototype's lines. A flag that stops at an error, makes a warning on a
// prototype an error, or runs no compile changes which errors come, and the probe has no sign of
// it. Dependency output goes beside the probe, which is a scratch file. A response file can hold
// any of these where this check cannot see it. A flag the probe passes itself is safe.
pub fn probe_unsafe_cflag(flag: Str) -> Option[Str] {
    if unit_cc_flags().contains(flag) { return None }
    if flag == "-Wfatal-errors" || flag.starts_with("-fmax-errors=") || flag.starts_with("-ferror-limit=") {
        return Some("stops the C compiler at an error")
    }
    if flag == "-Werror" || flag.starts_with("-Werror=") || flag == "-pedantic-errors" || flag == "--pedantic-errors" {
        return Some("can make a warning on a prototype an error")
    }
    if flag == "-E" || flag == "--preprocess" || flag == "-###" {
        return Some("runs no compile")
    }
    if flag.starts_with("-M") || flag == "--dependencies" || flag == "--user-dependencies" {
        return Some("asks for dependency output")
    }
    let other_format = flag.starts_with("-fdiagnostics-format=") && flag != "-fdiagnostics-format=text" && flag != "-fdiagnostics-format=clang"
    if flag == "-fdiagnostics-color" || flag == "-fdiagnostics-color=always" || flag == "-fcolor-diagnostics" || flag == "-fansi-escape-codes" || other_format {
        return Some("changes how the C compiler writes its errors")
    }
    if flag.starts_with("@") { return Some("is a response file, which can hold a flag that blinkc cannot check") }
    None
}
