// cg.bl: the code-generation driver.
//
// It owns the emit MODES — whole-program monolith, stdlib archive header, per-module
// header and object — and the settings each mode needs. Every mode runs the same
// pipeline: build the nominal registries, lower to IR, print C.
//
// The stages below it are being written one at a time. Until a stage lands its entry
// point reports I0004 and returns, so a mode that cannot yet be produced hands back an
// empty string. Every caller must therefore read diag_ice_count before it uses the
// result, or an unbuilt stage looks like a program that legitimately emits nothing.

import diagnostics.{
    Diag, diag_ice, diag_ice_at, diag_ice_count, diag_ice_stage_not_built, UNSOLVED_TYPEVAR_AT_CODEGEN,
    UNVERIFIED_IR_AT_PRINT, TYPEDEF_QUEUED_NOT_WRITTEN,
}
import cname.{
    c_archive_header_guard, c_layer_archive_header_guard, c_layer_archive_header_name, c_module_header_guard, c_module_init_globals_name,
    c_module_private_header_guard, c_program_types_header_guard, c_program_types_header_name,
    c_string_literal, c_test_fn_name,
}
import ast.{NodeKind, nk_of}
import parser.{
    ann_str_val, node_args, node_body, node_handlers, node_int_val, node_is_pub, node_kind, node_name, node_trait_name,
    node_str_val, node_value, node_push_value_child_ids, node_xfail_reason,
    sublist_get, sublist_length,
}
import layout.{
    LayoutTypedefMarks, Position, layout_of, layout_reset, layout_start_from, layout_typedef_marks, set_current_inst,
    layout_take_typedefs, layout_queued_typedef_tids,
}
import cg_print.{
    print_ev_default_decl, print_ev_storage, print_fn, print_fn_decl, print_guard_open, print_include, print_main_shim, print_reset, print_scope_restore_support,
    print_take, print_test_fn, print_test_table, print_typedef_blocks, print_extern_const_array,
}
import cg_reg.{
    cg_reg_build, cg_reg_entry_point, cg_reg_fn_decls, cg_reg_global_decls, cg_reg_has_main,
    cg_reg_impl_methods, cg_reg_impl_of, cg_reg_modules, cg_reg_module_of, cg_reg_reset,
    cg_reg_test_decls, cg_reg_type_decls,
}
import cg_decl.{
    BodySite, cg_decl_body_site, cg_decl_takes_ev, cg_decl_emit_epilogue, cg_decl_emit_ev, cg_decl_emit_ev_owned_by_archive, cg_decl_emit_ev_typedef,
    cg_decl_emit_fn_decl, cg_decl_emit_fn_def, cg_decl_emit_foreign_wrapper,
    cg_decl_emit_impl_method_decl,
    cg_decl_emit_globals, cg_decl_emit_signature_decl, cg_decl_emit_signature_def,
    cg_decl_emit_prologue, cg_decl_emit_typedefs_over, cg_decl_has_deferred_global, cg_decl_reset,
    cg_decl_spelled_carrier_tids, CgDeclMarks, cg_decl_marks, cg_decl_start_from,
}
import cg_derive.{
    cg_derive_emit_bodies, cg_derive_emit_decls, cg_derive_emit_key_tables, cg_derive_key_table_keys,
    cg_derive_key_table_names, cg_derive_key_table_nodes, cg_derive_reset,
}
import ir.{ir_begin_body, ir_block, ir_note_source, ir_pos_begin, ir_pos_take, ir_reset, ir_sources_pause, ir_sources_resume, ir_span, ir_verify}
import mono.{instances, named_instance_rows, program_spawns, set_named_instance_rows}
import typecheck.{TYPE_INT, TYPE_VOID, TyKind, tc_resolve, tc_tid_kind}
import cg_stmt.{
    cg_stmt_reset, cg_stmt_set_debug_mode, lower_block, lower_block_returning, lower_fn,
    lower_global_init,
}
import cg_promote.{
    cg_promote_body_enter, cg_promote_body_exit, cg_promote_has_pending, cg_promote_print_walkers,
    cg_promote_reset, cg_promote_set_trace,
}
import cg_expr.{cg_expr_frame_clear, cg_expr_reset, cg_expr_set_return_type, cg_expr_set_test_body}
import cg_eff.{
    cg_eff_forwarding_body, cg_eff_pending_thunks, cg_eff_print_thunk, cg_eff_register_async_scope_guard_support,
    cg_eff_register_ffi_scope_guard_support, cg_eff_reset, cg_eff_thunk_body_node, cg_eff_thunk_close,
    cg_eff_thunk_has_body, cg_eff_thunk_open, cg_eff_thunk_ret_tid, cg_eff_thunks_drained,
}

effect Codegen {
    effect Emit
    effect Register
    effect Scope
}

// The emit settings, in one record passed to the entry point rather than one mutable
// global each. A caller builds the record for the mode it wants and passes it in;
// nothing below reads a setting the caller did not set for this run, and two emits in
// one process cannot see each other's settings.
pub type CgConfig {
    // -g/-O0 C and the debug_assert bodies.
    debug_mode: Int
    // Per-phase timing and shape traces on stderr.
    trace_codegen: Int
    // Suppress anything a rerun could order differently, so two runs of the same
    // source produce byte-identical C.
    deterministic: Int
    // Non-empty restricts the emit to one module. The per-module mode does NOT use this:
    // it passes the module key as an argument and leaves this empty. This is for the
    // whole-program mode under BLINK_ONLY_MODULE.
    emit_only_module: Str
    // Modules already compiled into the linked archive, which this TU must declare
    // rather than define.
    skip_modules: Map[Str, Int]
    // This TU is user code linked against the stdlib archive, not the archive itself.
    user_tu_mode: Int
    // Declare `blink_ev` extern instead of defining it, so the linker resolves the
    // single definition the program has.
    blink_ev_extern_only: Int
    // This TU is an archive being built: the stdlib's, or with `archive_over_std` one layered
    // over it.
    archive_build_mode: Int
    // The archive being built is linked beside the stdlib archive, which defines the
    // runtime's storage and every std module this archive skips.
    archive_over_std: Int
    // The modules of the archive layered over the stdlib archive, when this user unit links
    // it: the unit reads that archive's header and runs its globals init. Empty when the
    // unit links no such archive.
    compiler_archive_modules: Map[Str, Int]
}


// Every mode starts from the same clean state. Two emits in one process must not see
// each other's memo tables, and a stale entry would be read as a fact about this program.
fn begin_unit(program: Int) ! Diag.Report {
    reset_unit_state()
    cg_reg_reset()
    cg_reg_build(program)
}

// Every piece of codegen state but the registry, which cg_reg_build makes from the program
// alone and no emit writes, so units of one program may share it.
fn reset_unit_state() {
    print_reset()
    ir_reset()
    // layout_reset resets cname and then re-marks the declaration facts that cname holds,
    // so a second cname_reset here would clear the facts it had just written.
    layout_reset()
    cg_decl_reset()
    cg_derive_reset()
    cg_promote_reset()
    cg_stmt_reset()
    cg_expr_reset()
    set_named_instance_rows([])
    cg_eff_reset()
}

// The instances of one generic base, as rows of the whole-program table. The row number is
// what makes an instance current, so the numbers travel rather than the instances.
fn instance_rows_of(decl: Int) -> List[Int] {
    let table = instances()
    let mut out: List[Int] = []
    let mut i = 0
    while i < table.len() {
        if table.get(i).unwrap().base_decl_node == decl { out.push(i) }
        i = i + 1
    }
    out
}

// A declaration node belongs to no instance, so reading one while an instance is current
// is refused rather than answered. Every walk over declarations therefore starts from the
// root, whatever the walk before it left current.
fn emit_root_signatures(cfg: CgConfig, decls: List[Int], methods: List[Int]) ! Diag.Report {
    set_current_inst(-1)
    for f in decls { cg_decl_emit_fn_decl(f, is_archive_private_copy(cfg, f)) }
    for m in methods { cg_decl_emit_impl_method_decl(m, is_archive_private_copy(cfg, m)) }
}

// A std function that takes the evidence vector, written into the archive layered over the
// stdlib archive. The stdlib archive does not hold it, since it does not define the vector
// such a signature names. The layered archive is one object, so every symbol its bodies call
// must resolve even in a program whose own graph never reaches that std function: the
// archive writes its own copy. A program that calls the function writes another, so the
// archive's copy is internal.
fn is_archive_private_copy(cfg: CgConfig, decl: Int) -> Bool {
    cfg.archive_over_std != 0 && cfg.skip_modules.contains_key(cg_reg_module_of(decl)) && cg_decl_takes_ev(decl)
}

// A header offers what other units may call, and an internal copy is not callable from
// outside its unit.
fn without_private_copies(cfg: CgConfig, decls: List[Int]) -> List[Int] {
    let mut out: List[Int] = []
    for d in decls {
        if !is_archive_private_copy(cfg, d) { out.push(d) }
    }
    out
}

// One prototype per instance. A unit that defines an instance and declares none puts the
// definition after the call that reads it, which C rejects, so the two halves walk the
// same table in the same order.
fn emit_instance_signatures(cfg: CgConfig, decls: List[Int]) ! Diag.Report {
    for d in decls {
        match cg_decl_body_site(d) {
            BodySite.PerInstance => emit_instance_decls(d, instance_is_private_copy(cfg, d))
            BodySite.ThisUnit => {}
            BodySite.ForeignWrapper => {}
            BodySite.Nothing => {}
        }
    }
}

fn emit_instance_decls(decl: Int, is_static: Bool) ! Diag.Report {
    let table = instances()
    for row in instance_rows_of(decl) {
        set_current_inst(row)
        cg_decl_emit_signature_decl(decl, table.get(row).unwrap().c_name, is_static)
        set_current_inst(-1)
    }
}

// One body per instance, under the instance's own name and its substituted types. The
// instance is current only for the lowering and the signature that wraps it, and the root
// is restored immediately after so nothing later reads a declaration through an instance.
fn emit_instance_bodies(decl: Int, is_static: Bool) ! Diag.Report {
    let rows = instance_rows_of(decl)
    if rows.len() == 0 { return no_instance_bodies(decl) }
    for row in rows { emit_instance_body(decl, row, is_static) }
}

fn emit_instance_body(decl: Int, row: Int, is_static: Bool) ! Diag.Report {
    set_current_inst(row)
    cg_decl_emit_signature_def(decl, instances().get(row).unwrap().c_name, is_static, lower_body(decl))
    set_current_inst(-1)
}

// A unit of the per-module build that links the archive. The archive already holds every
// non-generic std body, so such a unit writes a std generic's instance only as a private
// copy, and only the ones its own calls name: writing every row into every unit would
// compile the whole std instance set once per module.
fn copies_on_demand(cfg: CgConfig, module_key: Str) -> Bool {
    module_key != "" && cfg.user_tu_mode != 0
}

fn without_on_demand_copies(cfg: CgConfig, module_key: Str, decls: List[Int]) -> List[Int] {
    if !copies_on_demand(cfg, module_key) { return decls }
    let mut out: List[Int] = []
    for d in decls {
        let per_instance = match cg_decl_body_site(d) {
            BodySite.PerInstance => true
            _ => false
        }
        if !(per_instance && instance_is_private_copy(cfg, d)) { out.push(d) }
    }
    out
}

// The private copies this unit's calls named, and then the ones those copies' own bodies
// name, until a pass names nothing new. Each one's prototype is already in scope: the
// header of the module that declares the generic offers every instance as a static
// declaration. A pass writes its copies by C name, not in table order: the table is in the
// order the whole program first named each instance, which an edit to another module can
// change without changing anything this unit reads, and a unit taken from the last build
// must match a cold emit byte for byte.
fn emit_named_private_copies(cfg: CgConfig) ! Diag.Report {
    let table = instances()
    let mut written: Map[Int, Int] = Map()
    let mut grew = true
    while grew {
        grew = false
        let mut pass: List[Int] = []
        for row in named_instance_rows() {
            if written.contains_key(row) { continue }
            written.insert(row, 1)
            grew = true
            pass.push(row)
        }
        for row in rows_by_c_name(pass) {
            let decl = table.get(row).unwrap().base_decl_node
            if !instance_is_private_copy(cfg, decl) { continue }
            emit_instance_body(decl, row, true)
        }
    }
}

fn rows_by_c_name(rows: List[Int]) -> List[Int] {
    let table = instances()
    let mut out: List[Int] = []
    for row in rows {
        let name = table.get(row).unwrap().c_name
        out.push(row)
        let mut i = out.len() - 1
        while i > 0 && table.get(out.get(i - 1).unwrap()).unwrap().c_name > name {
            out.set(i, out.get(i - 1).unwrap())
            i = i - 1
        }
        out.set(i, row)
    }
    out
}

// Whether this unit keeps its copies of one generic's instances to itself. Inside a
// program it does not: the unit that declares the generic defines every instance of it and
// another unit calls them through that unit's header. A generic already compiled into the
// archive cannot be homed that way, because the archive was built before this program
// existed and its own monomorphization pass never saw the types this program instantiates
// the generic at. Every unit that needs one of those writes its own copy, and two
// definitions of one external symbol do not link, so those copies are internal.
fn instance_is_private_copy(cfg: CgConfig, decl: Int) -> Bool {
    cfg.skip_modules.contains_key(cg_reg_module_of(decl))
}

// A generic declaration the mono pass registered no instance for. For a free function
// that means nothing called it: there is no body to write and no caller left undefined,
// so this is not a gap. For a method it means the pass did not monomorphize the impl it
// belongs to and no single body is right either, so the body a call needs is written
// nowhere and this stage must say so rather than emit nothing and leave the name to fail
// at link.
fn no_instance_bodies(decl: Int) ! Diag.Report {
    if cg_reg_impl_of(decl) >= 0 {
        diag_ice_stage_not_built("cg generic impl method bodies", decl)
    }
}

// Every global in `globals`' initializer, lowered through the same expression seam as any
// other value and keyed by the global's own node. A global with no initializer (the
// parser accepts a bare top-level `let` the same as a local one) has nothing to lower and
// is left out, so a reader of this map never has to ask "was there one." The caller
// chooses the scope: the whole program for a single-unit build, or one module's own
// globals for the per-module mode — the defining module is the only one that ever lowers
// a given global's initializer.
fn lower_global_inits(globals: List[Int]) -> Map[Int, Int] ! Diag.Report {
    let mut out: Map[Int, Int] = Map()
    for g in globals {
        let init = node_value(g)
        if init < 0 { continue }
        out.insert(g, verify_lowered_unit(lower_global_init(g), g))
    }
    out
}

// A module's own scope of globals, filtered on the same terms a function or a method is:
// `declare_only` widens an archive-skipped module back in for the declaration half, the
// same reason `fns_in_scope`/`methods_in_scope` take it, even though the per-module mode
// leaves `skip_modules` empty and so never exercises the difference today.
fn globals_in_scope(cfg: CgConfig, module_key: Str, declare_only: Bool) -> List[Int] {
    decls_in_scope(cfg, module_key, cg_reg_global_decls(), declare_only)
}

// The declaration half, in the order C requires: a type must be complete where a later
// declaration names it, the evidence vector's fields name those types, and a global or a
// signature names them again. Answers the globals that could not take their value on the
// definition line, in declaration order, for the entry point to assign before anything
// else runs; a header declares no definition and so never has any to answer.
fn emit_declarations(cfg: CgConfig, header_guard: Str, self_header: Str, define_ev: Bool, globals_extern: Bool, shared: Bool, key_table_nodes: List[Int]) -> List[Int] ! Diag.Report {
    cg_decl_emit_prologue(cfg.user_tu_mode != 0, cfg.archive_over_std != 0, defines_runtime_storage(cfg), false, header_guard, self_header, false)
    if links_compiler_archive(cfg) { print_include(c_layer_archive_header_name()) }
    cg_decl_emit_typedefs_over(program_carrier_tids(key_table_nodes))
    if define_ev {
        emit_ev(cfg)
    } else if cfg.archive_over_std != 0 {
        cg_decl_emit_ev_typedef()
        print_ev_default_decl()
    }
    // The definition half owns exactly the globals in scope for this unit: a skipped
    // module's own globals are the archive's to define, and the archive's header already
    // promises them extern, so a second declaration here is redundant at best and, for a
    // non-const global, a second definition the linker rejects. The header half keeps the
    // unfiltered set — every global in the program needs a declaration somewhere, and a
    // header is where one that lives in the archive gets it.
    // A layered archive's header leaves the skipped modules to the stdlib archive's header,
    // which every unit that reads this one has already included.
    let all_globals = globals_extern && cfg.archive_over_std == 0
    let globals = if all_globals { cg_reg_global_decls() } else { globals_in_scope(cfg, "", false) }
    let inits = if globals_extern { Map() } else { lower_global_inits(globals) }
    let deferred = cg_decl_emit_globals(globals_extern, globals, inits)
    let declare_only = !(globals_extern && cfg.archive_over_std != 0)
    let fns = fns_in_scope(cfg, "", shared, declare_only)
    let methods = methods_in_scope(cfg, "", shared, declare_only)
    if globals_extern {
        emit_root_signatures(cfg, without_private_copies(cfg, fns), without_private_copies(cfg, methods))
    } else {
        emit_root_signatures(cfg, fns, methods)
    }
    // A layered archive's header leaves a skipped module's derived methods and key tables to
    // the stdlib archive's header too, as it leaves that module's globals.
    let derived = if globals_extern && cfg.archive_over_std != 0 { decls_outside_skipped(cfg, cg_reg_type_decls()) } else { derived_decls_declared_everywhere() }
    cg_derive_emit_decls(derived)
    deferred
}

// A unit that links the archive layered over the stdlib archive reads the vector's typedef,
// vtables and default from that archive's header, and defines only the vector itself.
fn emit_ev(cfg: CgConfig) ! Diag.Report {
    if links_compiler_archive(cfg) {
        print_ev_storage(ev_storage(cfg))
    } else if cfg.archive_over_std != 0 {
        cg_decl_emit_ev_owned_by_archive()
    } else {
        cg_decl_emit_ev(ev_storage(cfg))
    }
}

// Only the stdlib archive defines the runtime's storage. A layered archive is linked beside
// it, so a second definition would not link.
fn defines_runtime_storage(cfg: CgConfig) -> Bool {
    cfg.archive_build_mode != 0 && cfg.archive_over_std == 0
}

// "" for the unit that owns the vector and is linked against, "extern " for a unit that
// only refers to it. Exactly one unit of a program may own it — an archive serves many
// programs, so it never owns the vector even when nothing else asked it to extern it.
fn ev_storage(cfg: CgConfig) -> Str {
    if cfg.archive_build_mode != 0 || cfg.blink_ev_extern_only != 0 { return "extern " }
    ""
}

// A module filter of "" means the whole program. The per-module modes pass a key and get
// only what that module declared.
//
// `declare_only` widens that for a skipped module: this unit still calls a plain
// function a skipped module owns — the archive compiles its body, not this unit — so
// leaving it out of the SIGNATURE set the same way its body is left out of the
// DEFINITION set would emit a call with no prototype in sight. A caller building the
// declaration half passes true and keeps every skipped-module decl in scope for a
// prototype; a caller building bodies passes false and keeps today's rule, or a plain
// function would gain a second definition here on top of the one the archive already
// carries.
fn decls_in_scope(cfg: CgConfig, module_key: Str, decls: List[Int], declare_only: Bool) -> List[Int] {
    let mut out: List[Int] = []
    for f in decls {
        if module_key != "" && cg_reg_module_of(f) != module_key { continue }
        if cfg.emit_only_module != "" && cg_reg_module_of(f) != cfg.emit_only_module { continue }
        if !declare_only && cfg.skip_modules.contains_key(cg_reg_module_of(f)) && !kept_for_user(cfg, f) { continue }
        out.push(f)
    }
    out
}

// A derived method is declared in every unit and defined in one. A unit that only uses a
// type still calls the method that type's own module defines, and every unit already
// carries every typedef, so the declaration half takes no module filter. The definition
// half takes the same filter every other body takes, or two objects define one symbol.
fn derived_decls_declared_everywhere() -> List[Int] {
    cg_reg_type_decls()
}

fn decls_outside_skipped(cfg: CgConfig, decls: List[Int]) -> List[Int] {
    let mut out: List[Int] = []
    for d in decls {
        if !cfg.skip_modules.contains_key(cg_reg_module_of(d)) { out.push(d) }
    }
    out
}

// The entry point belongs to the unit that carries the program's shim. One archive
// serves many programs, and the archive build synthesizes a main of its own just to pull
// every module into one unit.
fn is_entry_point(fn_node: Int) -> Bool {
    fn_node == cg_reg_entry_point()
}

// A module compiled into the archive is declared by the user's unit, not compiled again
// — except for the declarations the archive could not hold. A signature that takes the
// evidence vector names a type the stdlib archive does not define, and one archive serves
// many programs, so the stdlib archive left those out. The archive layered over it does
// define the vector, and a unit that links that archive takes the vector from it, so a
// function of one of its modules that takes the vector is the archive's to define. A
// generic has no body of its own at all: what a program links are its instances, and which
// instances a program needs follows from that program's call sites, which the archive was
// compiled without. Those are left for the user's unit. An archive layered over the stdlib
// archive is in the same position for a std generic: it writes its own copy of each
// instance its bodies call.
fn kept_for_user(cfg: CgConfig, decl: Int) -> Bool {
    if cfg.user_tu_mode == 0 && cfg.archive_over_std == 0 { return false }
    match cg_decl_body_site(decl) {
        BodySite.PerInstance => return true
        BodySite.ThisUnit => {}
        BodySite.ForeignWrapper => {}
        BodySite.Nothing => {}
    }
    cg_decl_takes_ev(decl) && !cfg.compiler_archive_modules.contains_key(cg_reg_module_of(decl))
}

// The archive holds no entry point: one archive serves many programs. The stdlib archive
// also holds no function that takes the evidence vector, since it does not define the
// vector such a signature names; those are compiled into the user's unit instead. The
// archive layered over it defines the vector and holds them. A foreign binding carries
// `! FFI` but is a plain C wrapper that reads no evidence, which is why the signature is
// asked rather than the effects list.
fn fns_in_scope(cfg: CgConfig, module_key: Str, shared: Bool, declare_only: Bool) -> List[Int] {
    let mut out: List[Int] = []
    for f in decls_in_scope(cfg, module_key, cg_reg_fn_decls(), declare_only) {
        if shared && is_entry_point(f) { continue }
        if shared && cg_decl_takes_ev(f) && cfg.archive_over_std == 0 { continue }
        out.push(f)
    }
    out
}

// An impl method is in scope on the same terms as a free function, minus the entry
// point: a method named `main` is a method, not the program's entry.
fn methods_in_scope(cfg: CgConfig, module_key: Str, shared: Bool, declare_only: Bool) -> List[Int] {
    let mut out: List[Int] = []
    for m in decls_in_scope(cfg, module_key, cg_reg_impl_methods(), declare_only) {
        if shared && cg_decl_takes_ev(m) && cfg.archive_over_std == 0 { continue }
        out.push(m)
    }
    out
}

// Whether `id`'s own subtree holds a node of `kind`, walked through every child so a scope
// buried inside a closure, an if, or a match arm is still found. `kids` is one buffer shared
// down the walk, so a subtree is searched without a list per node.
fn subtree_has_kind(id: Int, kind: NodeKind, kids: List[Int]) -> Bool {
    if id < 0 { return false }
    if nk_of(node_kind(id)) == kind { return true }
    let base = kids.len()
    node_push_value_child_ids(id, kids)
    let end = kids.len()
    let mut i = base
    let mut found = false
    while i < end && !found {
        found = subtree_has_kind(kids.get(i).unwrap(), kind, kids)
        i = i + 1
    }
    while kids.len() > base {
        let _ = kids.pop()
    }
    found
}

// Whether this unit will lower an AsyncScope, answered ahead of emit_definitions: it fuses
// lowering with printing one body at a time, so the guard support must already be printed
// by the time the first one needs it. Tests are scanned only for the unit that calls emit_entry.
fn unit_uses_async_scope(fns: List[Int], methods: List[Int], include_tests: Bool) -> Bool {
    let mut kids: List[Int] = []
    for f in fns {
        ir_note_source(f)
        if subtree_has_kind(node_body(f), NodeKind.AsyncScope, kids) { return true }
    }
    for m in methods {
        ir_note_source(m)
        if subtree_has_kind(node_body(m), NodeKind.AsyncScope, kids) { return true }
    }
    if include_tests {
        for t in cg_reg_test_decls() {
            ir_note_source(t)
            if subtree_has_kind(node_body(t), NodeKind.AsyncScope, kids) { return true }
        }
    }
    false
}

// One declaration's body, or the report that names the stage which would write it. A
// unit that leaves a body out links as an undefined symbol at best, so every gap is
// named here rather than discovered by the linker. A binding that needs no wrapper is the
// one shape with no body at all, and it is not a gap.
//
// Nothing here reads the diagnostic count to decide whether to go on. A report that
// repeats one already made does not raise that count, so it cannot tell a body that
// failed from one that succeeded. The caller discards the whole unit instead.
fn emit_bodies(cfg: CgConfig, decls: List[Int]) ! Diag.Report {
    set_current_inst(-1)
    for d in decls {
        match cg_decl_body_site(d) {
            BodySite.ThisUnit => cg_decl_emit_fn_def(d, is_archive_private_copy(cfg, d), lower_body(d))
            BodySite.PerInstance => emit_instance_bodies(d, instance_is_private_copy(cfg, d))
            BodySite.ForeignWrapper => cg_decl_emit_foreign_wrapper(d)
            BodySite.Nothing => {}
        }
    }
}

// One lowered unit, checked before the printer reads it. The printer reads a tree by
// position: it takes each part to be what its place says it is and writes the C for it,
// so a defect lowering left behind becomes C that neither the C compiler nor a reader of
// the output can tell is wrong. Every tree this driver hands to the printer comes through
// here, and the answer is the tree itself so a caller cannot take the shortcut of
// printing the tree it already has.
//
// The shape form, not the frame form: a body reads its parameters and the globals of
// every module it imports, and this stage enumerates neither, so the scope rule would
// report a name that is in fact declared.
//
// Nothing is checked once a stage has reported. A stage that stopped answered a tree it
// never finished, and that tree failing the shape rules is the consequence of the failure
// already named rather than a second fault -- which is the same count every caller of
// this driver reads before it uses the output at all.
pub fn verify_lowered_unit(root: Int, at_node: Int) -> Int ! Diag.Report {
    if diag_ice_count > 0 { return root }
    let problems = ir_verify(root)
    if problems.len() > 0 {
        diag_ice_at("UnverifiedIrAtPrint", UNVERIFIED_IR_AT_PRINT,
            "lowering produced a tree the verifier refuses: {problems.get(0).unwrap()}", at_node,
            "every tree the printer reads must verify; this is a compiler bug")
    }
    root
}

// A global initializer that crosses an arena calls a walker no body has printed yet.
fn flush_walkers() ! Diag.Report {
    if !cg_promote_has_pending() { return }
    print_typedef_blocks(layout_take_typedefs())
    cg_promote_print_walkers()
}

// One body, with every closure it queued defined ahead of it. The thunks print before the
// body that names them because C reads a name only after its definition, and they print
// under the same mono instance the body was lowered under, because a thunk's types are
// read through that instance. A thunk body can queue a nested closure, so the count is
// re-read on every step, and the queue keeps the count it was told against its own length.
//
// Every caller prints the body before it lowers the next one, so the next body's start is
// where this one's nodes are released.
fn lower_body(decl: Int) -> Int ! Diag.Report {
    ir_begin_body()
    let body = lower_fn(decl)
    let mut bodies: List[Int] = []
    while bodies.len() < cg_eff_pending_thunks() {
        let n = bodies.len()
        // A task-only entry has no body to lower. An open that refused has made its report;
        // a close would only add a second.
        if !cg_eff_thunk_has_body(n) {
            bodies.push(-1)
        } else if cg_eff_thunk_open(n) >= 0 {
            bodies.push(lower_thunk_body(n))
            cg_eff_thunk_close()
        } else {
            bodies.push(-1)
        }
    }
    // A carrier first spelled while lowering this body or its thunks prints ahead of the
    // thunks too. The signature drains what is left, but the thunks come out before it.
    print_typedef_blocks(layout_take_typedefs())
    // The arena walkers this body and its thunks call, after the typedefs they spell.
    cg_promote_print_walkers()
    // A nested closure is queued after the thunk whose body names it, so the later thunk
    // prints first.
    let mut k = bodies.len()
    while k > 0 {
        k = k - 1
        cg_eff_print_thunk(k, bodies.get(k).unwrap())
    }
    cg_eff_thunks_drained(bodies.len())
    verify_lowered_unit(body, decl)
}

// One thunk's body, lowered against the closure's own result, which decides two things a
// function body's result decides for it.
//
// The first is where a `?` goes. `?` lowers in the expression stage, which reads no
// function of its own and is told the enclosing result instead. A closure is that
// enclosing function for its own body: the arm a `?` takes there belongs to what the
// closure returns, not to whatever function the closure happens to sit inside.
//
// The second is whether the tail is the answer. A closure returning nothing is spelled
// `void` in C, and C rejects a value on a return out of it, so its tail is a statement
// like any other. This is the test lower_fn makes for the same reason, on the same fact.
fn lower_thunk_body(n: Int) -> Int ! Diag.Report {
    match cg_eff_forwarding_body(n) {
        Some(fwd) => return if fwd < 0 { -1 } else { verify_lowered_unit(fwd, ir_span(fwd)) }
        None => {}
    }
    let body_node = cg_eff_thunk_body_node(n)
    let ret = cg_eff_thunk_ret_tid(n)
    if ret < 0 {
        diag_ice_at("ThunkResultHasNoType", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "the closure result this body propagates into carries no type", body_node,
            "typecheck stamps every closure with one result type; this is a compiler bug")
        return -1
    }
    cg_expr_set_return_type(ret)
    // A closure is its own enclosing function for the `?` in its body, so a closure written
    // inside a test body does not take the test body's propagation.
    cg_expr_set_test_body(false)
    cg_expr_frame_clear()
    let k = tc_tid_kind(tc_resolve(ret))
    cg_promote_body_enter()
    let body = if k == TyKind.Void || k == TyKind.Never {
        lower_block(body_node)
    } else {
        lower_block_returning(body_node)
    }
    cg_promote_body_exit()
    cg_expr_set_return_type(-1)
    verify_lowered_unit(body, body_node)
}

// The definition half. Test blocks are not here: they are written beside the entry shim,
// which is a different unit under the per-module mode.
fn emit_definitions(cfg: CgConfig, module_key: Str, shared: Bool, key_table_nodes: List[Int]) ! Diag.Report {
    emit_definitions_of(cfg, module_key, fns_in_scope(cfg, module_key, shared, false), methods_in_scope(cfg, module_key, shared, false), key_table_nodes, true)
}

// The definitions of scope_fns and scope_methods. Of the files of a module's unit, only the
// one that passes with_derived writes the module's derived bodies and key tables.
fn emit_definitions_of(cfg: CgConfig, module_key: Str, scope_fns: List[Int], scope_methods: List[Int], key_table_nodes: List[Int], with_derived: Bool) ! Diag.Report {
    let fns = without_on_demand_copies(cfg, module_key, scope_fns)
    let methods = without_on_demand_copies(cfg, module_key, scope_methods)
    // A unit declares every instance it defines, in its own text, ahead of every body.
    // The declaration half cannot do it: a header is read by units that define nothing,
    // and the archive's header would then offer instances the archive does not have.
    emit_instance_signatures(cfg, fns)
    emit_instance_signatures(cfg, methods)
    emit_bodies(cfg, fns)
    emit_bodies(cfg, methods)
    if !with_derived { return }
    cg_derive_emit_bodies(decls_in_scope(cfg, module_key, cg_reg_type_decls(), false))
    // A key table's text is spelled from its tuple type, which the entry key holds by the
    // table's name. The node it is written from only lends the lowering a span, so the table
    // reads no source, and a unit that writes it stays keyed on its own sources.
    let track = ir_sources_pause()
    cg_derive_emit_key_tables(key_tables_in_scope(cfg, module_key, key_table_nodes))
    ir_sources_resume(track)
}

// A tuple key has no declaration, so no module owns its table. The node that spells it is
// an expression, which carries no module of its own, so the module scope rule would place
// it in no unit at all. The entry unit is the one unit every per-module program has, so it
// defines each table and every other unit declares it. A one-unit build keeps its filters.
fn key_tables_in_scope(cfg: CgConfig, module_key: Str, key_table_nodes: List[Int]) -> List[Int] {
    if module_key == "" { return decls_in_scope(cfg, module_key, key_table_nodes, false) }
    if module_key == "__main__" { return key_table_nodes }
    []
}

// ── Test blocks ──────────────────────────────────────────────────────────────
//
// A test block is a body with no parameters and no result, so it lowers through the
// producers a function body goes through and prints as a static void function. What it
// needs beyond the body is registration. The runtime supplies the runner and the row
// type; this unit supplies the table of rows and the `__blink_run_tests` the entry shim
// calls. A unit that wrote the bodies and left the table out links against a name nothing
// defines, so the two are written together or not at all.
//
// Both are written beside the entry shim rather than beside the module that declared the
// test. The table, the runner and the shim that calls it are one linkage unit: the runner
// and the table are file-static, and the table holds the address of every body. Under the
// per-module mode only the entry module gets a shim, so putting any of the three in
// another module's file leaves the shim naming a static it cannot see.
//
// The rows carry C tokens, not Blink values: the printer spells no literal, so the names
// and the expected-failure reasons are quoted here, where the one producer of a C literal
// is in scope.
fn emit_test_bodies(tests: List[Int]) ! Diag.Report {
    if tests.len() == 0 { return }
    set_current_inst(-1)
    let mut name_lits: List[Str] = []
    let mut symbols: List[Str] = []
    let mut tag_lits: List[List[Str]] = []
    let mut xfail_lits: List[Str] = []
    for t in tests {
        let symbol = c_test_fn_name(t)
        cg_expr_set_test_body(true)
        print_test_fn(symbol, lower_body(t))
        cg_expr_set_test_body(false)
        name_lits.push(c_string_literal(node_str_val(t)))
        symbols.push(symbol)
        tag_lits.push(test_tag_literals(t))
        xfail_lits.push(test_xfail_literal(t))
    }
    print_test_table(name_lits, symbols, tag_lits, xfail_lits)
}

// The tags one test block carries. A tag selector on the command line matches these, so a
// tag the parser recorded and the row dropped silently changes which tests run.
//
// A tag is written either quoted or bare, and both spellings mean the same tag. The two
// reach the parser as different nodes: a quoted one is a string whose text lives in its own
// slot, a bare one is an identifier whose text is its name. A reader that answers only one
// of the two empties the table for every file written in the other, so this reads both.
fn test_tag_literals(tb: Int) -> List[Str] {
    let mut out: List[Str] = []
    let anns = node_handlers(tb)
    if anns == -1 { return out }
    let mut i = 0
    while i < sublist_length(anns) {
        let ann = sublist_get(anns, i)
        if node_name(ann) == "tags" {
            let args = node_args(ann)
            if args != -1 {
                let mut j = 0
                while j < sublist_length(args) {
                    let arg = sublist_get(args, j)
                    if tag_arg_is_positional(arg) { out.push(c_string_literal(ann_str_val(arg))) }
                    j = j + 1
                }
            }
        }
        i = i + 1
    }
    out
}

// Whether one annotation argument is a tag rather than a named option. A named argument is
// written `key: value`, and the parser records the key in the node's name: on a string
// argument the name is the key and the text stays in the slot, on an identifier argument
// the key and the value are joined with a colon into the one name.
fn tag_arg_is_positional(arg: Int) -> Bool {
    if nk_of(node_kind(arg)) == NodeKind.InterpString { return node_name(arg) == "" }
    !node_name(arg).contains(":")
}

// The entry of a whole program: the test bodies and their table, then the shim that calls
// the runner. One list answers both what is written and whether the shim calls it, because
// a shim that calls a runner the unit did not write is a name the linker cannot resolve.
// `init_fns` is every deferred-init function the shim must call before test or main
// dispatch, in the order it must call them: one name for a single-unit build (built by
// the caller from its own deferred list), or one name per module that needed one, in
// module order, under the per-module mode.
fn emit_entry(cfg: CgConfig, init_fns: List[Str]) ! Diag.Report {
    let tests = cg_reg_test_decls()
    emit_test_bodies(tests)
    print_main_shim(cg_reg_has_main(), tests.len() > 0, program_spawns(),
        cfg.trace_codegen != 0, cfg.deterministic, archive_init_fns(cfg).append(init_fns))
}

// The init functions of the archives this unit links, in link-layer order, ahead of the
// program's own: a global the program initialises may read one an archive set.
fn archive_init_fns(cfg: CgConfig) -> List[Str] {
    if cfg.user_tu_mode == 0 { return [] }
    if links_compiler_archive(cfg) { return [stdlib_init_globals_name(), layer_init_globals_name()] }
    [stdlib_init_globals_name()]
}

fn links_compiler_archive(cfg: CgConfig) -> Bool { cfg.compiler_archive_modules.len() > 0 }

fn stdlib_init_globals_name() -> Str { "__blink_init_stdlib_globals" }

// A layered archive's init runs in the same program as the stdlib's, so the two names
// must differ.
fn archive_init_globals_name(cfg: CgConfig) -> Str {
    if cfg.archive_over_std != 0 { return layer_init_globals_name() }
    stdlib_init_globals_name()
}

fn layer_init_globals_name() -> Str { "__blink_init_compiler_globals" }

// One function running every deferred global assignment, in the order the globals were
// declared in, or nothing if every global already took its value on the definition line.
// The shim runs it before any test or main dispatch, so a global a test reads is never
// caught unset. An archive monolith emits this unconditionally, empty body when there is
// nothing to run, since its header declares the extern to every linking user TU regardless.
fn emit_global_init_fn(cfg: CgConfig, program: Int, deferred: List[Int]) -> List[Str] ! Diag.Report {
    let is_archive = cfg.archive_build_mode != 0
    if deferred.len() == 0 && !is_archive { return [] }
    let decls = cg_reg_global_decls()
    let span = if decls.len() > 0 { decls.get(0).unwrap() } else { program }
    let body = verify_lowered_unit(ir_block(span, deferred), span)
    flush_walkers()
    let mut name = "__blink_init_globals"
    if is_archive {
        name = archive_init_globals_name(cfg)
        print_fn(false, layout_of(TYPE_VOID, Position.Return).c_spelling, name, [], false, body)
    } else {
        print_test_fn(name, body)
    }
    [name]
}

// The reason the runner prints for a test that is expected to fail, and the empty string
// for a test that is not one. `int_val` is the parser's marker for the `test.failing`
// form; typecheck has already refused that form with an empty reason (§8.10.6).
fn test_xfail_literal(tb: Int) -> Str {
    if node_int_val(tb) == 0 { return "" }
    c_string_literal(node_xfail_reason(tb))
}

// The whole program as one translation unit.
pub fn generate(program: Int, cfg: CgConfig) -> Str ! Codegen, Diag.Report {
    begin_unit(program)
    cg_promote_set_trace(cfg.trace_codegen != 0)
    let shared = cfg.archive_build_mode != 0
    let key_table_nodes = cg_derive_key_table_nodes()
    let deferred = emit_declarations(cfg, "", "", true, false, shared, key_table_nodes)
    print_scope_restore_support()
    cg_eff_register_ffi_scope_guard_support()
    // Pre-scan for the async.scope guard (see unit_uses_async_scope): an archive monolith
    // never reaches emit_entry, so its tests never lower here and are left out of the scan.
    let fns = fns_in_scope(cfg, "", shared, false)
    let methods = methods_in_scope(cfg, "", shared, false)
    if unit_uses_async_scope(fns, methods, !shared) {
        cg_eff_register_async_scope_guard_support()
    }
    cg_stmt_set_debug_mode(cfg.debug_mode != 0)
    emit_definitions(cfg, "", shared, key_table_nodes)
    // An archive monolith has no entry point: the user TU that links against it owns
    // main(), so neither the test-body table nor the main shim belongs here.
    let init_fns = emit_global_init_fn(cfg, program, deferred)
    if cfg.archive_build_mode == 0 { emit_entry(cfg, init_fns) }
    print_take()
}

// The stdlib archive's public header: every declaration a user TU needs to link
// against the archive, and no definition.
//
// The stdlib archive's header leaves the evidence vector out on purpose. A user unit
// declares its own, longer vector — the archive's builtin fields followed by the user
// program's effects — and two definitions of one C type is an ODR violation. The header of
// an archive layered over it carries the vector instead, for the user unit to use as it is.
pub fn generate_archive_header(program: Int, cfg: CgConfig) -> Str ! Codegen, Diag.Report {
    begin_unit(program)
    let guard = if cfg.archive_over_std != 0 { c_layer_archive_header_guard() } else { c_archive_header_guard() }
    let _ = emit_declarations(cfg, guard, "", false, true, true, cg_derive_key_table_nodes())
    print_fn_decl(false, layout_of(TYPE_VOID, Position.Return).c_spelling, archive_init_globals_name(cfg), [], false)
    cg_decl_emit_epilogue(guard)
    print_take()
}

// The per-module mode's header of every type in the program, which every module header
// includes. A unit can hold a type by value that came to it through a module it never
// names, so it needs that type's layout without that module's header; one header of every
// layout answers that for every unit. Each derived method is declared here beside its type,
// since a unit that only uses a type still calls it.
pub fn generate_types_header(program: Int, cfg: CgConfig) -> Str ! Codegen, Diag.Report {
    begin_unit(program)
    let guard = c_program_types_header_guard()
    cg_decl_emit_prologue(cfg.user_tu_mode != 0, cfg.archive_over_std != 0, false, false, guard, "", false)
    cg_decl_emit_typedefs_over(program_carrier_tids(cg_derive_key_table_nodes()))
    cg_decl_emit_ev_typedef()
    cg_derive_emit_decls(derived_decls_declared_everywhere())
    types_header_check_queue_drained()
    cg_decl_emit_epilogue(guard)
    print_take()
}

// A pass that only queues a typedef leaves it out of the header every unit includes, and
// cc then rejects each unit that names it, far from the cause.
fn types_header_check_queue_drained() ! Diag.Report {
    let queued = layout_queued_typedef_tids()
    if queued.len() == 0 { return }
    let mut names: List[Str] = []
    for t in queued { names.push("tid {t} ({layout_of(t, Position.Local).c_spelling})") }
    let listed = names.join(", ")
    diag_ice("TypedefQueuedNotWritten", TYPEDEF_QUEUED_NOT_WRITTEN,
        "the types header queued and never wrote: {listed}", 0, 0,
        "the pass that called ensure_typedef_for must drain layout_take_typedefs into the header")
}

// One module's two headers for the per-module mode. `surface` declares what other modules
// can name: its pub functions and globals and its trait impls' methods. `internal` declares
// the rest: its private functions and globals, its init function, and the instances its
// object defines. A unit includes a header only when it names a
// symbol the header declares, so a private edit changes only `internal`, and only the
// units that name something private to the module compile again.
pub type ModuleHeaders {
    surface: Str
    internal: Str
}

// What a scan of every node answers about a program. Each unit of one program would ask
// the same of the same nodes, and on a program with many modules the scans cost more than
// the units, so a driver that emits many units scans once and hands the answers to each.
// Only codegen runs between the scan and the units, and it adds no node and stamps no type.
pub type ProgramFacts {
    key_table_nodes: List[Int]
    carrier_tids: List[Int]
    // The init names the entry unit's shim calls. Finding one lowers another module's
    // globals, so it runs here, before any unit: the entry unit's emit then lowers no code
    // but its own, and its key holds the names its text calls.
    entry_init_fns: List[Str]
}

pub fn program_facts(program: Int, cfg: CgConfig) -> ProgramFacts ! Diag.Report {
    begin_unit(program)
    let init_fns = module_init_fn_names(cfg)
    begin_unit(program)
    let key_table_nodes = cg_derive_key_table_nodes()
    ProgramFacts { key_table_nodes: key_table_nodes, carrier_tids: program_carrier_tids(key_table_nodes), entry_init_fns: init_fns }
}

// The carriers whose typedefs the declarations every unit shares hold: each one a node
// spells, then the key of each table. A key written only inside a Map or Set type is no
// node's own type, yet its table names it, and the unit that defines the table reads the
// key's typedef from those shared declarations. The types header writes this list and
// every other unit marks it written, so both read this one list.
fn program_carrier_tids(key_table_nodes: List[Int]) -> List[Int] {
    let mut out = cg_decl_spelled_carrier_tids()
    for key in cg_derive_key_table_keys(key_table_nodes) { out.push(key) }
    out
}

pub fn generate_module_headers(program: Int, module_key: Str, cfg: CgConfig) -> ModuleHeaders ! Codegen, Diag.Report {
    let facts = program_facts(program, cfg)
    generate_module_headers_with(program, module_key, cfg, facts)
}

pub fn generate_module_headers_with(program: Int, module_key: Str, cfg: CgConfig, facts: ProgramFacts) -> ModuleHeaders ! Codegen, Diag.Report {
    begin_unit(program)
    // The prologue sets the linkage the signatures are printed under.
    cg_decl_emit_prologue(cfg.user_tu_mode != 0, cfg.archive_over_std != 0, false, false, c_module_header_guard(module_key), "", false)
    mark_typedefs_written(facts)
    module_header_texts(module_key, cfg, false)
}

// The types header already holds every typedef. Writing them here too and throwing the
// text away marks them written, so a signature that spells one does not write it again.
fn mark_typedefs_written(facts: ProgramFacts) ! Diag.Report {
    cg_decl_emit_typedefs_over(facts.carrier_tids)
    cg_decl_emit_ev_typedef()
    let _ = print_take()
}

// What the typedef walk of generate_module_headers_with marks written. The walk is the same
// for every module of a program and its text is thrown away, so a pass over the modules
// walks once and each header starts from the marks.
pub type HeaderPreamble {
    decl: CgDeclMarks
    layout: LayoutTypedefMarks
}

// The capture and the install below must cover every piece of state mark_typedefs_written
// leaves, or a header built from the capture differs from one built after the walk. Any new
// state the walk writes goes into HeaderPreamble, in both functions.
pub fn header_preamble(program: Int, cfg: CgConfig, facts: ProgramFacts) -> HeaderPreamble ! Diag.Report {
    begin_unit(program)
    cg_decl_emit_prologue(cfg.user_tu_mode != 0, cfg.archive_over_std != 0, false, false, c_module_header_guard("__preamble__"), "", false)
    mark_typedefs_written(facts)
    HeaderPreamble { decl: cg_decl_marks(), layout: layout_typedef_marks() }
}

fn install_header_preamble(pre: HeaderPreamble) {
    cg_decl_start_from(pre.decl)
    layout_start_from(pre.layout)
}

// generate_module_headers_with for a module of the program `pre` was walked for, after
// header_preamble and with no other emit between, so the registry is still that program's.
// BLINK_EMIT_REUSE_VERIFY compares each header with the one generate_module_headers_with
// writes.
pub fn generate_module_headers_from(module_key: Str, cfg: CgConfig, pre: HeaderPreamble) -> ModuleHeaders ! Codegen, Diag.Report {
    reset_unit_state()
    cg_decl_emit_prologue(cfg.user_tu_mode != 0, cfg.archive_over_std != 0, false, false, c_module_header_guard(module_key), "", false)
    install_header_preamble(pre)
    let _ = print_take()
    module_header_texts(module_key, cfg, true)
}

// `skip_embeds`: an #embed initializer lowers to one string constant, so it never needs
// the init function, and spelling a large file as a C literal costs more than the rest of
// the header.
fn module_header_texts(module_key: Str, cfg: CgConfig, skip_embeds: Bool) -> ModuleHeaders ! Codegen, Diag.Report {
    let globals = globals_in_scope(cfg, module_key, true)
    let fns = fns_in_scope(cfg, module_key, false, true)
    let methods = methods_in_scope(cfg, module_key, false, true)

    let guard = c_module_header_guard(module_key)
    open_module_header(guard)
    let _ = cg_decl_emit_globals(true, surface_decls(globals, true), Map())
    emit_root_signatures(cfg, surface_decls(fns, true), surface_decls(methods, true))
    cg_decl_emit_epilogue(guard)
    let surface = print_take()

    let private_guard = c_module_private_header_guard(module_key)
    open_module_header(private_guard)
    let _ = cg_decl_emit_globals(true, surface_decls(globals, false), Map())
    let lowered = if skip_embeds { without_embed_inits(globals) } else { globals }
    if cg_decl_has_deferred_global(lowered, lower_global_inits(lowered)) {
        print_fn_decl(false, layout_of(TYPE_VOID, Position.Return).c_spelling, c_module_init_globals_name(module_key), [], false)
    }
    emit_root_signatures(cfg, surface_decls(fns, false), surface_decls(methods, false))
    // Nothing is compiled ahead of this program, so its modules home their own generics'
    // instances, and a module that calls one compiled into another module's object needs
    // the name from this header.
    emit_instance_signatures(cfg, fns)
    emit_instance_signatures(cfg, methods)
    cg_decl_emit_epilogue(private_guard)
    ModuleHeaders { surface: surface, internal: print_take() }
}

// What module_header_texts reads of the instance table for one module: each instance its
// generics have, in the order its header declares them. A build compares this list to keep
// the module's headers from the last build, since an edit elsewhere can add an instance.
pub fn module_instance_names(cfg: CgConfig, module_key: Str) -> List[Str] {
    let table = instances()
    let mut out: List[Str] = []
    for decls in [fns_in_scope(cfg, module_key, false, true), methods_in_scope(cfg, module_key, false, true)] {
        for d in decls {
            match cg_decl_body_site(d) {
                BodySite.PerInstance => {
                    let mark = if instance_is_private_copy(cfg, d) { "static " } else { "" }
                    for row in instance_rows_of(d) { out.push("{mark}{table.get(row).unwrap().c_name}") }
                }
                BodySite.ThisUnit => {}
                BodySite.ForeignWrapper => {}
                BodySite.Nothing => {}
            }
        }
    }
    out
}

fn without_embed_inits(globals: List[Int]) -> List[Int] {
    let mut out: List[Int] = []
    for g in globals {
        let init = node_value(g)
        if init >= 0 && nk_of(node_kind(init)) == NodeKind.EmbedExpr { continue }
        out.push(g)
    }
    out
}

fn open_module_header(guard: Str) {
    print_guard_open(guard)
    print_include(c_program_types_header_name())
}

// The declarations of `decls` that go in a module's surface header, or with `want_surface`
// false those that do not. A trait impl's method is named wherever its type and trait are,
// pub or not.
fn surface_decls(decls: List[Int], want_surface: Bool) -> List[Int] {
    let mut out: List[Int] = []
    for d in decls {
        let im = cg_reg_impl_of(d)
        let named_outside = node_is_pub(d) == 1 || (im >= 0 && !node_trait_name(im).is_empty())
        if named_outside == want_surface { out.push(d) }
    }
    out
}

// One module's translation unit, including `self_header` for its own declarations. The
// declarations come from that header, so this unit carries definitions only.
//
// A module defines only the globals it owns — two objects defining the same C symbol is
// a link error, not a codegen detail — and, when at least one of its own globals is not a
// literal, a non-static init function assigning them, callable from outside this unit. The
// entry module's shim calls every module's, by the names in facts.
pub fn generate_module_object(program: Int, module_key: Str, self_header: Str, cfg: CgConfig) -> Str ! Codegen, Diag.Report {
    let facts = program_facts(program, cfg)
    generate_module_object_with(program, module_key, self_header, cfg, facts)
}

pub fn generate_module_object_with(program: Int, module_key: Str, self_header: Str, cfg: CgConfig, facts: ProgramFacts) -> Str ! Codegen, Diag.Report {
    begin_unit(program)
    let shared = cfg.archive_build_mode != 0
    emit_module_head(module_key, self_header, cfg, facts, fns_in_scope(cfg, module_key, shared, false), methods_in_scope(cfg, module_key, shared, false), "")
}

// The file of a module's unit that holds all of the unit but the bodies of the functions
// cut off into chunks.
// pos_sym names the table its lines are read from, or is "" to write them as numbers.
fn emit_module_head(module_key: Str, self_header: Str, cfg: CgConfig, facts: ProgramFacts, fns: List[Int], methods: List[Int], pos_sym: Str) -> Str ! Codegen, Diag.Report {
    cg_promote_set_trace(cfg.trace_codegen != 0)
    // The entry module's object defines the runtime's storage and bodies, the way it owns
    // __blink_ev; every other object declares them. A unit that links the archive leaves
    // them to the archive, which already defines them.
    let define_storage = defines_runtime_storage(cfg) || (module_key == "__main__" && cfg.user_tu_mode == 0)
    cg_decl_emit_prologue(cfg.user_tu_mode != 0, cfg.archive_over_std != 0, define_storage, false, "", self_header, module_key != "__main__")
    declare_pos_table(pos_sym)
    cg_decl_emit_ev(ev_storage(cfg))
    let own_globals = globals_in_scope(cfg, module_key, false)
    let inits = lower_global_inits(own_globals)
    let deferred = cg_decl_emit_globals(false, own_globals, inits)
    if deferred.len() > 0 {
        let span = own_globals.get(0).unwrap()
        let init_body = verify_lowered_unit(ir_block(span, deferred), span)
        flush_walkers()
        print_fn(false, layout_of(TYPE_VOID, Position.Return).c_spelling, c_module_init_globals_name(module_key), [], false, init_body)
    }
    print_scope_restore_support()
    cg_eff_register_ffi_scope_guard_support()
    // Only the entry module reaches emit_entry, where a test body would lower; scanning
    // every other module's tests too would ask gen0 to declare a symbol that module's own
    // TU never ends up printing a call to.
    if unit_uses_async_scope(fns, methods, module_key == "__main__") {
        cg_eff_register_async_scope_guard_support()
    }
    cg_stmt_set_debug_mode(cfg.debug_mode != 0)
    emit_definitions_of(cfg, module_key, fns, methods, facts.key_table_nodes, true)
    if module_key == "__main__" { emit_entry(cfg, facts.entry_init_fns) }
    if copies_on_demand(cfg, module_key) { emit_named_private_copies(cfg) }
    print_take()
}

// One file of a module's unit. The head's suffix is ""; a chunk's file stem is the module
// key, a dot, and its suffix.
pub type UnitChunk {
    suffix: Str
    c: Str
    // A file that includes no header: the table of a split unit's lines.
    plain: Bool
}

type PosTable {
    sym: Str
    lines: List[Int]
}

// A module's unit as one head and the chunks cut off it. A body edit then changes the C of
// one file, and cc compiles that file alone, where one cc on a large module's whole unit
// takes seconds. Each chunk is emitted as a unit of its own, from a clean state, so its text
// is a function of its own functions and of what every unit reads, never of the chunks
// beside it. chunk_decls is the group size the cut aims at; 0 cuts nothing.
pub fn generate_module_chunks_with(program: Int, module_key: Str, self_header: Str, cfg: CgConfig, facts: ProgramFacts, chunk_decls: Int) -> List[UnitChunk] ! Codegen, Diag.Report {
    begin_unit(program)
    let shared = cfg.archive_build_mode != 0
    let fns = fns_in_scope(cfg, module_key, shared, false)
    let methods = methods_in_scope(cfg, module_key, shared, false)
    let mut is_fn: Map[Int, Bool] = Map()
    let mut decls: List[Int] = []
    for f in fns {
        is_fn.insert(f, true)
        decls.push(f)
    }
    for m in methods { decls.push(m) }
    let groups = if module_key == "" || shared { [decls] } else { chunk_groups(decls, chunk_decls) }
    let split = groups.len() > 1
    let mut out: List[UnitChunk] = []
    let mut tables: List[PosTable] = []
    let mut taken: Map[Str, Bool] = Map()
    let mut gi = 0
    while gi < groups.len() {
        let g = groups.get(gi).unwrap()
        let mut g_fns: List[Int] = []
        let mut g_methods: List[Int] = []
        for d in g {
            if is_fn.contains_key(d) { g_fns.push(d) } else { g_methods.push(d) }
        }
        if gi == 0 {
            let sym = if split { pos_table_name(module_key, "head") } else { "" }
            ir_pos_begin(sym)
            out.push(UnitChunk { suffix: "", c: emit_module_head(module_key, self_header, cfg, facts, g_fns, g_methods, sym), plain: false })
            let lines = ir_pos_take()
            if split { tables.push(PosTable { sym: sym, lines: lines }) }
        } else {
            reset_unit_state()
            // Two groups whose first decls hash alike are told apart in decl order.
            let base = "p{hex32(decl_cut_hash(g.get(0).unwrap()))}"
            let mut suffix = base
            let mut n = 2
            while taken.contains_key(suffix) {
                suffix = "{base}x{n}"
                n = n + 1
            }
            taken.insert(suffix, true)
            let sym = pos_table_name(module_key, suffix)
            ir_pos_begin(sym)
            out.push(UnitChunk { suffix: suffix, c: emit_module_chunk(module_key, self_header, cfg, g_fns, g_methods, sym), plain: false })
            tables.push(PosTable { sym: sym, lines: ir_pos_take() })
        }
        gi = gi + 1
    }
    if split { out.push(UnitChunk { suffix: "pos", c: pos_tables_text(tables), plain: true }) }
    out
}

// The C name of the table of lines a file of module_key's unit reads. A suffix holds no
// underscore, so the last one in the name parts it from the module key.
fn pos_table_name(module_key: Str, suffix: Str) -> Str {
    "__blink_pos_{module_key}_{suffix}"
}

fn declare_pos_table(sym: Str) {
    if sym != "" { print_extern_const_array(layout_of(TYPE_INT, Position.Local).c_spelling, sym) }
}

// The file that defines a split unit's tables. It holds numbers alone, so it compiles in
// next to no time, and it is the one file whose text a line added to the module changes
// outside the edited function's chunk. C has no empty array, so a file that reads no line
// still gets an entry.
fn pos_tables_text(tables: List[PosTable]) -> Str {
    let spelling = layout_of(TYPE_INT, Position.Local).c_spelling
    let mut out = "#include <stdint.h>\n"
    for t in tables {
        let mut nums: List[Str] = []
        for l in t.lines { nums.push("{l}") }
        if nums.len() == 0 { nums.push("0") }
        out = "{out}const {spelling} {t.sym}[] = \{ {nums.join(", ")} };\n"
    }
    out
}

// A chunk declares what the head defines: the module's globals, its init function, the
// evidence vector and the native shims. It defines its own functions, and its own copy of
// each file-local helper they need.
fn emit_module_chunk(module_key: Str, self_header: Str, cfg: CgConfig, fns: List[Int], methods: List[Int], pos_sym: Str) -> Str ! Codegen, Diag.Report {
    cg_promote_set_trace(cfg.trace_codegen != 0)
    cg_decl_emit_prologue(cfg.user_tu_mode != 0, cfg.archive_over_std != 0, false, false, "", self_header, true)
    declare_pos_table(pos_sym)
    cg_decl_emit_ev("extern ")
    print_scope_restore_support()
    cg_eff_register_ffi_scope_guard_support()
    if unit_uses_async_scope(fns, methods, false) {
        cg_eff_register_async_scope_guard_support()
    }
    cg_stmt_set_debug_mode(cfg.debug_mode != 0)
    emit_definitions_of(cfg, module_key, fns, methods, [], false)
    if copies_on_demand(cfg, module_key) { emit_named_private_copies(cfg) }
    print_take()
}

// decls cut into groups, in order. A cut falls before a decl whose name hashes to 0 modulo
// target once the group holds half of target, and before any decl once it holds four times
// target. Where a cut falls depends on the names near it, not on a count from the start,
// so a decl added or removed changes its own group and seldom the next, where a cut at
// every n decls would move every group after it. A module of no more than sixteen times
// target decls is one group: cc can not inline across a cut, and only a module past that
// size costs seconds of cc on each edit, so only such a module pays for its cuts.
fn chunk_groups(decls: List[Int], target: Int) -> List[List[Int]] {
    let hi = target * 4
    if target <= 0 || decls.len() <= target * 16 { return [decls] }
    let lo = if target / 2 > 0 { target / 2 } else { 1 }
    let mut groups: List[List[Int]] = []
    let mut cur: List[Int] = []
    for d in decls {
        let n = cur.len()
        if n >= hi || (n >= lo && decl_cut_hash(d) % target == 0) {
            groups.push(cur)
            cur = []
        }
        cur.push(d)
    }
    if cur.len() > 0 { groups.push(cur) }
    groups
}

// 32-bit FNV-1a of the name a decl has in its module: a function's name, or a method's
// type, trait and name. It reads source text alone, so every process and host cuts alike.
fn decl_cut_hash(decl: Int) -> Int {
    let im = cg_reg_impl_of(decl)
    let key = if im >= 0 { "{node_name(im)}.{node_trait_name(im)}.{node_name(decl)}" } else { node_name(decl) }
    let mut h = 2166136261
    let mut i = 0
    while i < key.byte_len() {
        h = ((h ^ key.byte_at(i).to_int()) * 16777619) % 4294967296
        i = i + 1
    }
    h
}

// Eight lowercase hex digits of a value below 2^32.
fn hex32(v: Int) -> Str {
    let digits = "0123456789abcdef"
    let mut out = ""
    let mut place = 268435456
    while place > 0 {
        let d = (v / place) % 16
        out = "{out}{digits.byte_slice(d, d + 1)}"
        place = place / 16
    }
    out
}

// Every module's init-fn name the entry unit's shim must call, in module order (the same
// first-seen order `cg_reg_modules` yields, which is import order — an imported module is
// merged ahead of the importing module, so its init call lands first). Each is answered by
// lowering that module's own globals, which is safe to discard: this only checks whether a
// name is needed, and never prints. The entry module's globals answer the same Const
// question here as in its unit's head.
fn module_init_fn_names(cfg: CgConfig) -> List[Str] ! Diag.Report {
    // The lowering below is thrown away, so the instances it names and the sources it spans
    // are no unit's, even if a unit is being emitted.
    let named = named_instance_rows()
    let track = ir_sources_pause()
    let mut out: List[Str] = []
    for m in cg_reg_modules() {
        let g = globals_in_scope(cfg, m, false)
        if cg_decl_has_deferred_global(g, lower_global_inits(g)) {
            out.push(c_module_init_globals_name(m))
        }
    }
    set_named_instance_rows(named)
    ir_sources_resume(track)
    out
}

// The facts the entry unit's text reads that no source span carries, one per line: whether
// a main and a spawn exist, each test's C symbol and name, and the name of each key table, in
// the order the unit writes them. The caller adds the init names. A build takes the entry unit
// only when these are the last build's.
pub fn entry_unit_facts(program: Int, facts: ProgramFacts) -> List[Str] ! Diag.Report {
    begin_unit(program)
    let mut out = ["main {cg_reg_has_main()}", "spawns {program_spawns()}"]
    for t in cg_reg_test_decls() {
        let name = node_str_val(t)
        out.push("test {c_test_fn_name(t)} {name.byte_len()} {name}")
    }
    for name in cg_derive_key_table_names(facts.key_table_nodes) { out.push("table {name}") }
    out
}

// The modules that get an object of their own when the per-module build links the archive,
// in emit order. A module the archive holds needs one only for the bodies the archive could
// not hold, the functions that take the evidence vector; most have none.
pub fn archive_unit_modules(program: Int, cfg: CgConfig) -> List[Str] ! Diag.Report {
    let mut out: List[Str] = []
    for m in enumerate_program_modules(program) {
        if !cfg.skip_modules.contains_key(m) {
            out.push(m)
            continue
        }
        let fns = without_on_demand_copies(cfg, m, fns_in_scope(cfg, m, false, false))
        let methods = without_on_demand_copies(cfg, m, methods_in_scope(cfg, m, false, false))
        if fns.len() > 0 || methods.len() > 0 { out.push(m) }
    }
    out
}

// The modules of `program` in the order the per-module mode must emit them: first-seen
// order, which is dependency order, never sorted.
pub fn enumerate_program_modules(program: Int) -> List[Str] ! Diag.Report {
    begin_unit(program)
    cg_reg_modules()
}
