// cg.bl: the code-generation driver.
//
// It owns the emit MODES — whole-program monolith, stdlib archive header, per-module
// header and object — and the settings each mode needs. Every mode runs the same
// pipeline: build the nominal registries, lower to IR, print C.
//
// The stages below it are being written one at a time. Until a stage lands its entry
// point reports I0004 and returns, so a mode that cannot yet be produced hands back an
// empty string. Every caller must therefore read diag_ice_count before it uses the
// result, or an unbuilt stage looks like a program that legitimately emits nothing.

import diagnostics.{Diag, diag_ice_stage_not_built}
import parser.{get_annotation, node_effects, sublist_length}
import cname.{c_archive_header_guard, c_module_header_guard, cname_reset}
import layout.{layout_reset}
import cg_print.{print_main_shim, print_reset, print_scope_restore_support, print_take}
import cg_reg.{
    cg_reg_build, cg_reg_entry_point, cg_reg_fn_decls, cg_reg_has_main, cg_reg_impl_methods,
    cg_reg_modules, cg_reg_module_of, cg_reg_reset, cg_reg_test_decls,
}
import cg_decl.{
    BodySite, cg_decl_body_site, cg_decl_emit_epilogue, cg_decl_emit_ev,
    cg_decl_emit_fn_decl, cg_decl_emit_fn_def, cg_decl_emit_impl_method_decl,
    cg_decl_emit_globals, cg_decl_emit_prologue, cg_decl_emit_typedefs, cg_decl_reset,
}
import cg_stmt.{cg_stmt_reset, lower_fn}

effect Codegen {
    effect Emit
    effect Register
    effect Scope
}

// The emit settings, in one record passed to the entry point rather than one mutable
// global each. A caller builds the record for the mode it wants and passes it in;
// nothing below reads a setting the caller did not set for this run, and two emits in
// one process cannot see each other's settings.
pub type CgConfig {
    // -g/-O0 C and the debug_assert bodies.
    debug_mode: Int
    // Per-phase timing and shape traces on stderr.
    trace_codegen: Int
    // Suppress anything a rerun could order differently, so two runs of the same
    // source produce byte-identical C.
    deterministic: Int
    // Non-empty restricts the emit to one module. The per-module mode does NOT use this:
    // it passes the module key as an argument and leaves this empty. This is for the
    // whole-program mode under BLINK_ONLY_MODULE.
    emit_only_module: Str
    // Modules already compiled into the linked archive, which this TU must declare
    // rather than define.
    skip_modules: Map[Str, Int]
    // This TU is user code linked against the stdlib archive, not the archive itself.
    user_tu_mode: Int
    // Declare `blink_ev` extern instead of defining it, so the linker resolves the
    // single definition the program has.
    blink_ev_extern_only: Int
    // This TU is the stdlib archive being built.
    archive_build_mode: Int
}


// Every mode starts from the same clean state. Two emits in one process must not see
// each other's memo tables, and a stale entry would be read as a fact about this program.
fn begin_unit(program: Int) ! Diag.Report {
    print_reset()
    layout_reset()
    cname_reset()
    cg_reg_reset()
    cg_reg_build(program)
    cg_decl_reset()
    cg_stmt_reset()
}

// The declaration half, in the order C requires: a type must be complete where a later
// declaration names it, the evidence vector's fields name those types, and a global or a
// signature names them again.
fn emit_declarations(cfg: CgConfig, header_guard: Str, self_header: Str, define_ev: Bool, globals_extern: Bool, shared: Bool) ! Diag.Report {
    let user_tu = cfg.user_tu_mode != 0
    let define_storage = cfg.archive_build_mode != 0
    cg_decl_emit_prologue(user_tu, define_storage, false, header_guard, self_header)
    cg_decl_emit_typedefs()
    if define_ev { cg_decl_emit_ev(ev_storage(cfg)) }
    cg_decl_emit_globals(globals_extern)
    for f in fns_in_scope(cfg, "", shared) { cg_decl_emit_fn_decl(f, false) }
    for m in methods_in_scope(cfg, "", shared) { cg_decl_emit_impl_method_decl(m, false) }
}

// A function whose body reads the program's own evidence cannot live in the shared
// stdlib archive: many programs link one archive, and the archive does not even define
// the evidence vector such a signature names. Those functions are compiled into the
// user's translation unit instead. A foreign binding carries `! FFI` but is a plain C
// wrapper that reads no evidence, so it stays.
fn is_evidence_bound(fn_node: Int) -> Bool {
    if get_annotation(fn_node, "ffi") != -1 { return false }
    let sl = node_effects(fn_node)
    if sl == -1 { return false }
    sublist_length(sl) > 0
}

// "" for the unit that owns the vector and is linked against, "extern " for a unit that
// only refers to it. Exactly one unit of a program may own it.
fn ev_storage(cfg: CgConfig) -> Str {
    if cfg.blink_ev_extern_only != 0 { return "extern " }
    ""
}

// A module filter of "" means the whole program. The per-module modes pass a key and get
// only what that module declared.
fn decls_in_scope(cfg: CgConfig, module_key: Str, decls: List[Int]) -> List[Int] {
    let mut out: List[Int] = []
    for f in decls {
        if module_key != "" && cg_reg_module_of(f) != module_key { continue }
        if cfg.emit_only_module != "" && cg_reg_module_of(f) != cfg.emit_only_module { continue }
        if cfg.skip_modules.contains_key(cg_reg_module_of(f)) && !kept_for_user(cfg, f) { continue }
        out.push(f)
    }
    out
}

// The entry point belongs to the unit that carries the program's shim. One archive
// serves many programs, and the archive build synthesizes a main of its own just to pull
// every module into one unit.
fn is_entry_point(fn_node: Int) -> Bool {
    fn_node == cg_reg_entry_point()
}

// A module compiled into the archive is declared by the user's unit, not compiled again
// — except for the functions the archive could not hold. An evidence-bound signature
// names the program's own evidence vector, which the archive does not define, so the
// archive left those out and the user's unit is the only place left to compile them.
fn kept_for_user(cfg: CgConfig, decl: Int) -> Bool {
    cfg.user_tu_mode != 0 && is_evidence_bound(decl)
}

fn fns_in_scope(cfg: CgConfig, module_key: Str, shared: Bool) -> List[Int] {
    let mut out: List[Int] = []
    for f in decls_in_scope(cfg, module_key, cg_reg_fn_decls()) {
        if shared && is_entry_point(f) { continue }
        if shared && is_evidence_bound(f) { continue }
        out.push(f)
    }
    out
}

// An impl method is in scope on the same terms as a free function, minus the entry
// point: a method named `main` is a method, not the program's entry.
fn methods_in_scope(cfg: CgConfig, module_key: Str, shared: Bool) -> List[Int] {
    let mut out: List[Int] = []
    for m in decls_in_scope(cfg, module_key, cg_reg_impl_methods()) {
        if shared && is_evidence_bound(m) { continue }
        out.push(m)
    }
    out
}

// One declaration's body, or the report that names the stage which would write it. A
// unit that leaves a body out links as an undefined symbol at best, so every gap is
// named here rather than discovered by the linker. A binding that needs no wrapper is the
// one shape with no body at all, and it is not a gap.
//
// Nothing here reads the diagnostic count to decide whether to go on. A report that
// repeats one already made does not raise that count, so it cannot tell a body that
// failed from one that succeeded. The caller discards the whole unit instead.
fn emit_bodies(decls: List[Int]) ! Diag.Report {
    for d in decls {
        match cg_decl_body_site(d) {
            BodySite.ThisUnit => cg_decl_emit_fn_def(d, false, lower_fn(d))
            BodySite.PerInstance => diag_ice_stage_not_built("cg mono instance bodies", d)
            BodySite.ForeignWrapper => diag_ice_stage_not_built("cg foreign wrapper bodies", d)
            BodySite.Nothing => {}
        }
    }
}

// The definition half. A test block is a body too, and the entry shim calls a runner
// that only the test table defines, so a unit with tests is not whole without it.
fn emit_definitions(cfg: CgConfig, module_key: Str, shared: Bool) ! Diag.Report {
    emit_bodies(fns_in_scope(cfg, module_key, shared))
    emit_bodies(methods_in_scope(cfg, module_key, shared))
    let tests = decls_in_scope(cfg, module_key, cg_reg_test_decls())
    if tests.len() == 0 { return }
    diag_ice_stage_not_built("cg test bodies", tests.get(0).unwrap())
}

// The whole program as one translation unit.
pub fn generate(program: Int, cfg: CgConfig) -> Str ! Codegen, Diag.Report {
    begin_unit(program)
    let shared = cfg.archive_build_mode != 0
    emit_declarations(cfg, "", "", true, false, shared)
    print_scope_restore_support()
    emit_definitions(cfg, "", shared)
    print_main_shim(cg_reg_has_main(), cg_reg_test_decls().len() > 0, false,
        cfg.user_tu_mode != 0, cfg.trace_codegen != 0, cfg.deterministic, [])
    print_take()
}

// The stdlib archive's public header: every declaration a user TU needs to link
// against the archive, and no definition.
//
// The evidence vector is left out on purpose. A user unit declares its own, longer
// vector — the archive's builtin fields followed by the user program's effects — and two
// definitions of one C type is an ODR violation.
pub fn generate_archive_header(program: Int, cfg: CgConfig) -> Str ! Codegen, Diag.Report {
    begin_unit(program)
    emit_declarations(cfg, c_archive_header_guard(), "", false, true, true)
    cg_decl_emit_epilogue(c_archive_header_guard())
    print_take()
}

// One module's public header, for the per-module object mode.
pub fn generate_module_header(program: Int, module_key: Str, cfg: CgConfig) -> Str ! Codegen, Diag.Report {
    begin_unit(program)
    let guard = c_module_header_guard(module_key)
    cg_decl_emit_prologue(cfg.user_tu_mode != 0, false, false, guard, "")
    cg_decl_emit_typedefs()
    cg_decl_emit_globals(true)
    for f in fns_in_scope(cfg, module_key, false) { cg_decl_emit_fn_decl(f, false) }
    for m in methods_in_scope(cfg, module_key, false) { cg_decl_emit_impl_method_decl(m, false) }
    cg_decl_emit_epilogue(guard)
    print_take()
}

// One module's translation unit, including `self_header` for its own declarations. The
// declarations come from that header, so this unit carries definitions only.
pub fn generate_module_object(program: Int, module_key: Str, self_header: Str, cfg: CgConfig) -> Str ! Codegen, Diag.Report {
    begin_unit(program)
    cg_decl_emit_prologue(cfg.user_tu_mode != 0, cfg.archive_build_mode != 0, false, "", self_header)
    cg_decl_emit_ev(ev_storage(cfg))
    cg_decl_emit_globals(false)
    print_scope_restore_support()
    emit_definitions(cfg, module_key, cfg.archive_build_mode != 0)
    if module_key == "__main__" {
        print_main_shim(cg_reg_has_main(), cg_reg_test_decls().len() > 0, false,
            cfg.user_tu_mode != 0, cfg.trace_codegen != 0, cfg.deterministic, [])
    }
    print_take()
}

// The modules of `program` in the order the per-module mode must emit them: first-seen
// order, which is dependency order, never sorted.
pub fn enumerate_program_modules(program: Int) -> List[Str] ! Diag.Report {
    begin_unit(program)
    cg_reg_modules()
}
