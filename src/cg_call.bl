// cg_call.bl: every call, lowered to typed IR.
//
// One owner for "what C function does this call reach, and what arguments does it take".
// Dispatch is keyed on the callee's declaration node and on the receiver's type id, never
// on a method-name string crossed with a C-type ladder: the name a caller writes decides
// which declaration is meant, and the declaration plus cname decide the symbol.
//
// The seams this module publishes replace the refusals cg_expr records for the shapes it
// does not own: the Eq or Ord method a comparison operator desugars to, the Display call
// an interpolation hole needs, the container copy a spread performs, and the element read
// that `[i]` and `.get(i)` share. Each takes its operands already lowered, so cg_expr
// keeps control of evaluation order and of the statements an operand hoisted.

import parser.{
    node_kind, node_name, node_left, node_obj, node_method, node_args,
    node_methods, node_impl_binders, node_type_params, node_trait_name,
    node_module, node_source_module,
    get_annotation, sublist_get, sublist_length,
}
import ast.{NodeKind, nk_of, node_kind_name}
import typecheck.{
    TyKind, tk_name, tc_resolve, tc_tid_kind, tc_tid_decl_node, lookup_named_type,
    is_import_module_name, is_builtin_namespace, is_builtin_fn, tc_alias_to_original,
    tc_qualifier_to_module_or_self, tc_get_symbol_module, TYPE_STR,
}
import layout.{
    LayoutRecord, Position, SlotForm, layout_of, tid_of_node,
    tid_of_binder, current_binder_scope, current_inst, decl_has_derive,
}
import mono.{instances, instance_for_call}
import cg_reg.{cg_reg_fn_decls, cg_reg_impl_decls}
import cname.{
    c_fn_decl_name, c_impl_method_name, c_display_dispatch_name, c_derive_method_name,
    c_runtime_helper,
}
import ir.{ir_tid, ir_call_direct, ir_call_runtime, ir_cast, ir_unary}
import cg_expr.{lower_expr}
import cg_decl.{cg_decl_takes_ev}
import diagnostics.{
    Diag, diag_ice_at, diag_ice_stage_not_built, CODEGEN_STAGE_NOT_BUILT,
    UNSOLVED_TYPEVAR_AT_CODEGEN,
}

// The trait whose synthesized dispatcher renders a value into a string, the two traits
// whose derive builds an equality method, and the method those traits name. All are
// compiler-owned names, not user-written ones, so the name is the only key there is until
// a trait carries a declaration id.
let trait_display = "Display"
let trait_eq = "Eq"
let trait_ord = "Ord"
let method_eq = "eq"

// ── Seams ─────────────────────────────────────────────────────────────────

// Every call the language spells: a free function, an impl method, and the qualified
// forms of both. cg_expr lowers the carrier constructors itself and hands over the rest.
pub fn lower_call(node: Int) -> Int ! Diag.Report {
    match nk_of(node_kind(node)) {
        NodeKind.Call => lower_fn_call(node)
        NodeKind.MethodCall => lower_method_call(node)
        _ => cc_unhandled(node)
    }
}

// `a == b` on a struct or data enum operand: C's own operators do not compare an
// aggregate, so the comparison is the method the type derived.
pub fn lower_operator_method(node: Int, op: Str, lhs: Int, rhs: Int) -> Int ! Diag.Report {
    if lhs < 0 || rhs < 0 { return -1 }
    let tid = tid_of_node(node)
    if tid < 0 { return -1 }
    let rec = cc_local(tid, node)
    if cc_stopped(rec) { return -1 }
    if op != "==" && op != "!=" {
        diag_ice_at("OrderingMethodNotLowered", CODEGEN_STAGE_NOT_BUILT,
            "operator '{op}' has no ordering method lowering here", node,
            "an ordering operator desugars to Ord.cmp against an Ordering variant")
        return -1
    }
    let decl = tc_tid_decl_node(ir_tid(lhs))
    if decl < 0 {
        diag_ice_at("EqualityOperandNotDerived", CODEGEN_STAGE_NOT_BUILT,
            "a {tk_name(cc_kind(ir_tid(lhs)))} operand has no derived equality method", node,
            "only a declared struct or enum derives Eq; another operand needs its own lowering")
        return -1
    }
    let symbol = cc_equality_symbol(node, decl, ir_tid(lhs))
    if symbol == "" { return -1 }
    let eq = ir_call_direct(tid, node, rec.c_spelling, symbol, rec.slot_form, [lhs, rhs])
    if op == "==" { return eq }
    ir_unary(tid, node, rec.c_spelling, "!", eq)
}

// The C function an equality operator reaches. A type carries equality by writing the impl
// out or by deriving it, and the two spell the same method differently, so the declaration
// decides the name. A type may do both, and then the hand-written impl is what the program
// said: the derive stage still emits its own body, and nothing reaches it. "" is answered
// after an internal error is recorded.
fn cc_equality_symbol(node: Int, decl: Int, recv_tid: Int) -> Str ! Diag.Report {
    let im = cc_impl_for(recv_tid, trait_eq)
    if im >= 0 { return c_impl_method_name(im, method_eq) }
    if cc_derives_equality(decl) { return c_derive_method_name(decl, method_eq) }
    diag_ice_at("EqualityMethodNotFound", UNSOLVED_TYPEVAR_AT_CODEGEN,
        "'{node_name(decl)}' has neither a derived nor a written {trait_eq} method", node,
        "typecheck must reject a comparison whose operand carries no equality; this is a compiler bug")
    ""
}

// Ord is the second name that builds an equality method, because an ordering answers
// whether two values are equal on the way to answering which is smaller.
fn cc_derives_equality(decl: Int) -> Bool {
    decl_has_derive(decl, trait_eq) || decl_has_derive(decl, trait_ord)
}

// An interpolation hole whose type has no printf form renders through the sealed
// dispatcher the compiler synthesizes next to the user's `Display.fmt`. A missing impl is
// an internal error: typecheck has already proved one exists.
pub fn lower_display_call(part: Int, value: Int) -> Int ! Diag.Report {
    if value < 0 { return -1 }
    let tid = ir_tid(value)
    let im = cc_impl_for(tid, trait_display)
    if im < 0 {
        diag_ice_at("DisplayImplNotFound", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "a {tk_name(cc_kind(tid))} hole has no Display impl to call", part,
            "typecheck must reject a hole whose type cannot be shown; this is a compiler bug")
        return -1
    }
    let rec = cc_local(TYPE_STR, part)
    if cc_stopped(rec) { return -1 }
    ir_call_direct(TYPE_STR, part, rec.c_spelling, c_display_dispatch_name(im), rec.slot_form, [value])
}

// `[..xs, y]` copies every element of `xs` into the container being built. The copy is a
// runtime call that takes the destination, which no IR node names yet: a ContainerNew
// kid is written as one appended element, so the destination is not in hand here.
pub fn lower_spread(node: Int, into_tid: Int) -> Int ! Diag.Report {
    diag_ice_at("SpreadCopyNotLowered", CODEGEN_STAGE_NOT_BUILT,
        "a spread into a {tk_name(cc_kind(into_tid))} has no lowering", node,
        "the container copy needs an IR node that names the destination it extends")
    -1
}

// One owner for reading an element out of a container: `[i]`, which answers the element
// type, and `.get(i)`, which answers an Option over it. The node's own type says which.
pub fn lower_element_read(node: Int, obj: Int, index: Int) -> Int ! Diag.Report {
    if obj < 0 || index < 0 { return -1 }
    let tid = tid_of_node(node)
    if tid < 0 { return -1 }
    if cc_kind(tid) == TyKind.Option {
        diag_ice_at("CheckedElementReadNotLowered", CODEGEN_STAGE_NOT_BUILT,
            "an element read answering Option has no lowering here", node,
            "the bounds test and the carrier it fills are statements cg_expr must hoist")
        return -1
    }
    let helper = cc_element_helper(node, ir_tid(obj))
    if helper == "" { return -1 }
    let slot = cc_element_slot(node, tid)
    if cc_stopped(slot) { return -1 }
    let raw = ir_call_runtime(tid, node, slot.c_spelling, helper, slot.slot_form, [obj, index])
    ir_cast(tid, node, slot.c_spelling, raw)
}

// ── Element reads ─────────────────────────────────────────────────────────

// The runtime reader for a container kind. "" after an internal error is recorded.
fn cc_element_helper(node: Int, container_tid: Int) -> Str ! Diag.Report {
    if cc_kind(container_tid) == TyKind.List { return c_runtime_helper("list_get") }
    diag_ice_at("ElementReadContainerNotLowered", CODEGEN_STAGE_NOT_BUILT,
        "an element read on a {tk_name(cc_kind(container_tid))} has no lowering", node,
        "a keyed container reads through its key-operations table, which is not built here")
    ""
}

// How the element type is held in a runtime slot. The slot is one machine word, so an
// element the layer holds behind a pointer, and a double the runtime heap-boxes, each
// need a dereference this stage does not write yet.
fn cc_element_slot(node: Int, elem_tid: Int) -> LayoutRecord ! Diag.Report {
    let rec = layout_of(elem_tid, Position.ContainerSlot)
    let why = "container element has no C layout: {rec.decline_reason}"
    if rec.decline_reason != "" {
        diag_ice_at("UnspellableElementType", UNSOLVED_TYPEVAR_AT_CODEGEN, why, node,
            "monomorphisation must resolve every type codegen reads; this is a compiler bug")
        return rec
    }
    if rec.slot_form != SlotForm.InlineWord || cc_kind(elem_tid) == TyKind.Float {
        diag_ice_at("BoxedElementReadNotLowered", CODEGEN_STAGE_NOT_BUILT,
            "a {tk_name(cc_kind(elem_tid))} element is held behind a pointer in its slot", node,
            "reading it is a dereference of the slot's pointer spelling, which layout omits")
        return cc_stop(rec)
    }
    rec
}

// ── Free functions ────────────────────────────────────────────────────────

fn lower_fn_call(node: Int) -> Int ! Diag.Report {
    let callee = node_left(node)
    if callee < 0 || nk_of(node_kind(callee)) != NodeKind.Ident {
        diag_ice_stage_not_built("cg_call qualified calls", node)
        return -1
    }
    if !cc_is_free_name(callee) {
        diag_ice_stage_not_built("cg_call closure values", node)
        return -1
    }
    cc_free_call(node, cc_fn_anywhere(node, cc_declared_name(node_name(callee))))
}

// `mod.f(args)`: the same free-function call, written with the module the function was
// declared in. The qualifier names no value, so nothing precedes the written arguments,
// and the declaration is the one that module declares rather than whichever module
// happens to spell the name.
fn lower_module_call(node: Int, obj: Int) -> Int ! Diag.Report {
    let module_key = tc_qualifier_to_module_or_self(node_name(obj))
    cc_free_call(node, cc_fn_in_module(node, module_key, cc_declared_name(node_method(node))))
}

// The tail every free-function call shares once its declaration is known. A declaration of
// -1 is a refusal the resolver already reported.
fn cc_free_call(node: Int, decl: Int) -> Int ! Diag.Report {
    if decl < 0 { return -1 }
    let symbol = cc_callee_symbol(node, decl)
    if symbol == "" { return -1 }
    if cg_decl_takes_ev(decl) {
        cc_ev_not_in_ir(node)
        return -1
    }
    cc_direct(node, symbol, [])
}

// The name the declaration was written under. An import may rename what it brings in, and
// every register is keyed on the original.
fn cc_declared_name(written: Str) -> Str {
    tc_alias_to_original.get(written) ?? written
}

// The C name of the function this call reaches. A plain declaration is its own symbol; a
// template has no symbol at all, so the answer is the name of the instance the
// monomorphisation pass registered for this very call site. "" after an internal error.
fn cc_callee_symbol(node: Int, decl: Int) -> Str ! Diag.Report {
    if !cc_is_instantiated(decl) { return c_fn_decl_name(decl) }
    cc_instance_name(node, decl)
}

// Whether a call of this declaration reaches an instance rather than the declaration
// itself. A generic declaration is a template, which has no C name until its binders are
// chosen. A declaration bridged to C is the one exception: the bridge is a single
// type-erased symbol, so the pass instantiates nothing for it.
fn cc_is_instantiated(decl: Int) -> Bool {
    if get_annotation(decl, "ffi") != -1 { return false }
    cc_is_generic(decl)
}

// The registered instance for a generic call, which must be an instance of the very
// declaration this call resolved to. The pass walks every reachable call and records one,
// so anything else is a compiler bug: the walk never reached this body, the driver has
// another instance current, or the two stages read the call as different callees.
fn cc_instance_name(node: Int, decl: Int) -> Str ! Diag.Report {
    match instances().get(instance_for_call(current_inst(), node)) {
        Some(inst) => if inst.base_decl_node == decl { return inst.c_name }
        None => {}
    }
    diag_ice_at("MonoInstanceNotRegistered", UNSOLVED_TYPEVAR_AT_CODEGEN,
        "the call of generic '{node_name(decl)}' has no monomorphised instance here", node,
        "the pass must record an instance of this declaration for this call site")
    ""
}

// The function one named module exposes: the one it declares, else the one it re-exports.
// A qualifier settles the module, so another module's declaration of the same name is a
// candidate only through a re-export, and the front end has already decided which module
// each name resolves to.
fn cc_fn_in_module(node: Int, module_key: Str, name: Str) -> Int ! Diag.Report {
    let own = cc_fn_declared_in(module_key, name)
    if own >= 0 { return own }
    if tc_get_symbol_module(name) == module_key { return cc_fn_anywhere(node, name) }
    cc_no_module_member(node)
}

// A module is named twice over: by the path its file was read from, and by the name it
// announces itself under. A qualifier is the announced name, so the declarations it reaches
// are the ones filed under that name, not the ones filed under the path.
fn cc_fn_declared_in(module_key: Str, name: Str) -> Int {
    for f in cg_reg_fn_decls() {
        if node_name(f) == name && node_module(f) == module_key { return f }
    }
    -1
}

// The declaration a bare name means. The front end refuses a bare name that a second
// loaded module also declares, so one declaration is the whole answer here; more than one
// is an internal error rather than a guess, because the wrong choice is a call to the
// wrong function.
fn cc_fn_anywhere(node: Int, name: Str) -> Int ! Diag.Report {
    let mut found = -1
    let mut clashes = 0
    for f in cg_reg_fn_decls() {
        if node_name(f) != name { continue }
        if found >= 0 { clashes = clashes + 1 }
        found = f
    }
    if found >= 0 && clashes == 0 { return found }
    if found < 0 { return cc_no_such_callee(node) }
    diag_ice_at("CalleeAmbiguous", UNSOLVED_TYPEVAR_AT_CODEGEN,
        "'{name}' is declared in more than one module and the call names neither", node,
        "the call needs the declaration typecheck resolved, which it does not record yet")
    -1
}

// Typecheck accepted the call, so the name is not undeclared: it binds a closure value, or
// it is one of the call forms the compiler provides itself. Both are calls this stage does
// not lower yet, and neither is a front-end fault.
fn cc_no_such_callee(node: Int) -> Int ! Diag.Report {
    diag_ice_stage_not_built("cg_call closure values and compiler-provided calls", node)
    -1
}

// A qualifier reaches a member its module declares as something other than a function: a
// type it exports, or a constant that holds one. A qualified receiver never binds a
// closure, so the refusal above would name the wrong shape.
fn cc_no_module_member(node: Int) -> Int ! Diag.Report {
    diag_ice_stage_not_built("cg_call qualified constructors and constant callees", node)
    -1
}

// ── Methods ───────────────────────────────────────────────────────────────

fn lower_method_call(node: Int) -> Int ! Diag.Report {
    let obj = node_obj(node)
    let role = cc_receiver_role(obj)
    if role == Receiver.Module { return lower_module_call(node, obj) }
    if role != Receiver.Value {
        diag_ice_stage_not_built(cc_role_stage(role), node)
        return -1
    }
    let recv_tid = tid_of_node(obj)
    if recv_tid < 0 { return -1 }
    let im = cc_impl_with_method(recv_tid, node_method(node))
    if im < 0 {
        diag_ice_stage_not_built("cg_call builtin and trait-object methods", node)
        return -1
    }
    if cc_is_generic(im) {
        diag_ice_stage_not_built("cg_call monomorphised impl methods", node)
        return -1
    }
    let method = cc_method_of(im, node_method(node))
    if method < 0 { return -1 }
    if cg_decl_takes_ev(method) {
        cc_ev_not_in_ir(node)
        return -1
    }
    let receiver = lower_expr(obj)
    if receiver < 0 { return -1 }
    cc_direct(node, c_impl_method_name(im, node_method(node)), [receiver])
}

// What the left of the dot names. Only a Value is a receiver to lower; the other three are
// qualifiers, and each keys a different lowering.
pub type Receiver { Value, Namespace, Module, TypeOwner }

// A namespace the compiler provides is read before an imported module, because a module of
// that name does not take the namespace over. A builtin type has no declaration to look up,
// so the register of compiler-provided names answers for it, the way typecheck decides the
// same call on the name alone.
fn cc_receiver_role(obj: Int) -> Receiver {
    if !cc_is_free_name(obj) { return Receiver.Value }
    let name = node_name(obj)
    if is_builtin_namespace(name) == 1 { return Receiver.Namespace }
    if is_import_module_name(name) == 1 { return Receiver.Module }
    if lookup_named_type(name) >= 0 { return Receiver.TypeOwner }
    if is_builtin_fn(name) == 1 { return Receiver.TypeOwner }
    Receiver.Value
}

// The lowering a qualifier this stage does not own is waiting for. Each qualifier says
// which one rather than blaming whichever is listed first.
fn cc_role_stage(role: Receiver) -> Str {
    if role == Receiver.Namespace { return "cg_call intrinsic namespaces" }
    "cg_call static and associated calls"
}

// Whether the receiver is a bare name that binds no value here. A binder in scope wins
// over every other reading of the same spelling, so a value named like a module or a type
// is still a value.
fn cc_is_free_name(obj: Int) -> Bool {
    if obj < 0 { return false }
    if nk_of(node_kind(obj)) != NodeKind.Ident { return false }
    tid_of_binder(current_binder_scope(), node_name(obj)) < 0
}

// The impl block that extends the receiver's own declaration with a method of this name.
// Matching on the declaration, not on the type id, lets an instance of a generic type
// find the impl its base declares.
fn cc_impl_with_method(recv_tid: Int, mname: Str) -> Int {
    let want = tc_tid_decl_node(recv_tid)
    if want < 0 { return -1 }
    for im in cg_reg_impl_decls() {
        if cc_impl_owner(im) != want { continue }
        if cc_method_index(im, mname) >= 0 { return im }
    }
    -1
}

// The declaration an impl block extends. Two modules may spell the same bare type name,
// so the impl's own module qualifies the name first, the way the type registry keys it;
// the bare name is the answer only when no module owns one.
fn cc_impl_owner(im: Int) -> Int {
    let name = node_name(im)
    if name == "" { return -1 }
    let module_key = node_source_module(im)
    let mut tid = -1
    if module_key != "" { tid = lookup_named_type("{module_key}.{name}") }
    if tid < 0 { tid = lookup_named_type(name) }
    if tid < 0 { return -1 }
    tc_tid_decl_node(tid)
}

// The impl block of one trait over the receiver's declaration, whatever its methods.
fn cc_impl_for(recv_tid: Int, trait_name: Str) -> Int {
    let want = tc_tid_decl_node(recv_tid)
    if want < 0 { return -1 }
    for im in cg_reg_impl_decls() {
        if node_trait_name(im) != trait_name { continue }
        if cc_impl_owner(im) == want { return im }
    }
    -1
}

fn cc_method_index(im: Int, mname: Str) -> Int {
    let ms = node_methods(im)
    if ms == -1 { return -1 }
    let mut i = 0
    while i < sublist_length(ms) {
        if node_name(sublist_get(ms, i)) == mname { return i }
        i = i + 1
    }
    -1
}

fn cc_method_of(im: Int, mname: Str) -> Int ! Diag.Report {
    let i = cc_method_index(im, mname)
    if i >= 0 { return sublist_get(node_methods(im), i) }
    diag_ice_at("ImplMethodNotFound", UNSOLVED_TYPEVAR_AT_CODEGEN,
        "the impl block has no method '{mname}'", im,
        "the caller must only ask an impl block that declares the method")
    -1
}

// ── Shared ────────────────────────────────────────────────────────────────

// One direct call: the callee's C name, the receiver arguments already lowered, then the
// written arguments in source order.
fn cc_direct(node: Int, symbol: Str, leading: List[Int]) -> Int ! Diag.Report {
    let tid = tid_of_node(node)
    if tid < 0 { return -1 }
    let rec = cc_local(tid, node)
    if cc_stopped(rec) { return -1 }
    let mut args: List[Int] = []
    for a in leading { args.push(a) }
    let written = node_args(node)
    let mut i = 0
    while i < sublist_length(written) {
        let a = lower_expr(sublist_get(written, i))
        if a < 0 { return -1 }
        args.push(a)
        i = i + 1
    }
    ir_call_direct(tid, node, rec.c_spelling, symbol, rec.slot_form, args)
}

fn cc_kind(tid: Int) -> TyKind {
    tc_tid_kind(tc_resolve(tid))
}

fn cc_local(tid: Int, node: Int) -> LayoutRecord ! Diag.Report {
    let rec = layout_of(tid, Position.Local)
    let why = "call result has no C layout: {rec.decline_reason}"
    if rec.decline_reason != "" {
        diag_ice_at("UnspellableCallType", UNSOLVED_TYPEVAR_AT_CODEGEN, why, node,
            "monomorphisation must resolve every type codegen reads; this is a compiler bug")
    }
    rec
}

// layout.bl answers every decline with an empty spelling, and no answer it accepts is
// empty, so that is the one question a caller has to ask after recording an ICE.
fn cc_stopped(rec: LayoutRecord) -> Bool {
    rec.c_spelling == ""
}

fn cc_stop(rec: LayoutRecord) -> LayoutRecord {
    LayoutRecord { c_spelling: "", ..rec }
}

// A generic declaration is a template: it has a C name only once its binders are chosen,
// which is one monomorphised instance per choice. A function names its binders in its own
// type parameters, and an impl block only in its `impl[...]` header: an impl block's type
// parameters hold the arguments its trait was written with, which bind nothing.
fn cc_is_generic(decl: Int) -> Bool {
    if nk_of(node_kind(decl)) == NodeKind.ImplBlock { return cc_has_entries(node_impl_binders(decl)) }
    cc_has_entries(node_type_params(decl))
}

fn cc_has_entries(sl: Int) -> Bool {
    sl != -1 && sublist_length(sl) > 0
}

fn cc_ev_not_in_ir(node: Int) ! Diag.Report {
    diag_ice_at("EvidenceVectorNotInIr", CODEGEN_STAGE_NOT_BUILT,
        "the callee takes the evidence vector, which no IR argument spells", node,
        "a call to an effectful function needs an IR node the printer writes as the vector")
}

fn cc_unhandled(node: Int) -> Int ! Diag.Report {
    diag_ice_at("UnhandledCallKind", UNSOLVED_TYPEVAR_AT_CODEGEN,
        "call kind {node_kind_name(node_kind(node))} has no lowering", node,
        "every call kind the parser produces needs an arm in lower_call")
    -1
}
