import cg_print.{vtable_slot_self_spelling}
import cg_decl.{BodySite, cg_decl_body_site, cg_decl_takes_ev}
import diagnostics.{
    Diag, diag_ice_at, diag_ice_stage_not_built, diag_error_at, diag_file_for_node, diag_source_file,
    diag_is_ice_seg,
    CODEGEN_STAGE_NOT_BUILT, UNSOLVED_TYPEVAR_AT_CODEGEN, UNRESOLVED_METHOD,
    UNHANDLED_ITERABLE_AT_CODEGEN,
