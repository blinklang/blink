// cg_decl.bl: the declaration half of a translation unit — typedefs, function
// declarations, globals, effect vtables and the prologue.
//
// Every C spelling here comes from the reading layer through one gate,
// cg_decl_require_spelling. layout_of never guesses, so a type it declines has no
// spelling at all and the gate raises I0001 rather than writing a default: a wrong C
// type compiles cleanly and then gets the program wrong at run time.
//
// Typedef order is a dependency order read off the type graph, not the order the
// declarations were written in. A member's type must be complete where the embedding
// typedef names it, so a declaration is emitted only after every nominal type its
// members reach by value.

import diagnostics.{
    Diag, diag_ice, diag_ice_at, diag_is_ice_seg,
    CODEGEN_STAGE_NOT_BUILT, UNSOLVED_TYPEVAR_AT_CODEGEN,
}
import layout.{
    LayoutRecord, Position, SlotForm, layout_of, field_layout_of, field_embeds_owner, ensure_typedef_for, c_type_of, enum_tag_tid,
    carrier_complete_children,
    layout_take_typedefs, tid_of_node,
}
import cname.{
    c_builtin_effect_roots, c_effect_default_op_name, c_effect_vtable_slot_name, c_ev_field_name, c_ev_global_name, c_ev_type_name, c_ffi_struct_original, c_ffi_struct_ptr_name,
    c_ffi_symbol, c_field_name,
    c_fn_decl_name, cname_ffi_struct_mirror,
    c_global_name, c_vtable_type_name, c_vtable_userdata_member,
    c_impl_method_name, c_display_dispatch_name, c_local_name, c_runtime_helper,
    c_typedef_name, c_variant_discriminant, c_string_literal,
    cname_is_runtime_owned, td_guard_name, c_enum_tag_member, c_enum_payload_member,
    c_builtin_derived_op_name,
}
import cg_print.{
    print_effect_default_vtable, print_effect_vtable_typedef,
    print_ev, print_ev_with_external_default, print_ev_typedef, print_epilogue, print_fn, print_fn_decl, print_vtable_slot_fn, print_vtable_slot_fn_decl, print_foreign_decl, print_global_decl,
    print_global_init, print_prologue, print_prologue_declares, print_foreign_includes, print_ffi_layout_asserts,
    print_simple_enum_typedef, print_struct_typedef, print_tagged_enum_typedef,
    print_typedef_blocks,
}
import cg_reg.{
    cg_reg_effect_decls, cg_reg_effect_ops, cg_reg_entry_point, cg_reg_fs_op_decl, cg_reg_fs_ops, cg_reg_fn_decls, cg_reg_global_decls,
    cg_reg_io_derived_decl,
    cg_reg_impl_methods, cg_reg_impl_of, cg_reg_module_of, cg_reg_modules, cg_reg_tid_for_decl,
    cg_reg_type_decls,
}
import ir.{
    ir_assign, ir_block, ir_call_direct, ir_call_runtime, ir_c_name, ir_cast, ir_const,
    ir_evidence_address, ir_evidence_vector, ir_expr_stmt, ir_global_ref, ir_kind, ir_let, ir_return, ir_sources_pause, ir_sources_resume,
    ir_var_ref, IrKind,
}
import mono.{instances, is_poly_impl, poly_impl_is_element_agnostic}
import typecheck.{
    TyKind, tc_enum_has_payload, tc_enum_variant_slots, tc_evar_field_slots,
    tc_evar_name, tc_evfield_name,
    tc_evfield_tid, tc_resolve, tc_sfield_name, tc_sfield_tid, tc_struct_field_slots,
    make_handler_type, tc_member_tid_at_instance, tc_impl_trait_id,
    tc_tid_child, tc_tid_child_count, tc_tid_decl_node, tc_tid_kind,
    tc_lookup_node_tid, tc_type_str, tc_void_tid, DECL_NODE_AMBIGUOUS, TYPE_STR, io_read_ops, is_io_read_derived_op,
}
import parser.{
    get_annotation, get_str_named_arg, node_effects, parser_live_ranges, node_elements, node_fields, node_impl_binders,
    node_body, node_is_pub, node_methods, node_name, node_params, node_type_ann,
    node_type_params, node_value, sublist_get, sublist_length,
}
import stdlib_native_deps.{
    stdlib_native_dep_gate_macro, stdlib_native_dep_name_by_ffi_symbol, stdlib_native_dep_owned_by_source_module,
}

// 1 while a type's dependencies are being emitted, 2 once its typedef is written. The key
// is the C name the typedef will carry, not the declaration: one generic declaration has
// one typedef per instance, and two type ids that spell the same C name are one C type.
let mut typedef_state: NameMarks = no_marks()

// What this unit has written for each root effect's vtable typedef, keyed by the C name the
// typedef carries: 1 once a name this stage cannot spell has stopped it and reported that,
// 2 once the typedef is written, 3 once the default bodies and instance are written too. A struct field of handler type reaches an effect from the
// type graph and the evidence vector reaches the same effect from the declarations, so both
// read this rather than writing one typedef twice or reporting one gap twice.
let mut vtable_state: NameMarks = no_marks()

// A unit's marks over the marks of the header preamble it starts from. The preamble's marks
// are only read, so every header of one pass shares one walk's marks and copies none.
type NameMarks {
    own: Map[Str, Int]
    base: Map[Str, Int]
}

fn no_marks() -> NameMarks {
    NameMarks { own: Map(), base: Map() }
}

fn mark_of(m: NameMarks, name: Str) -> Int {
    m.own.get(name) ?? (m.base.get(name) ?? 0)
}

fn flat_marks(m: NameMarks) -> Map[Str, Int] {
    if m.base.len() == 0 { return m.own }
    let mut out: Map[Str, Int] = Map()
    for k in m.base.keys() { out.insert(k, m.base.get(k) ?? 0) }
    for k in m.own.keys() { out.insert(k, m.own.get(k) ?? 0) }
    out
}

// What the typedef walk of one unit marked written, for the module headers of the same
// program to start from instead of walking again.
pub type CgDeclMarks {
    typedefs: Map[Str, Int]
    vtables: Map[Str, Int]
}

pub fn cg_decl_marks() -> CgDeclMarks {
    CgDeclMarks { typedefs: flat_marks(typedef_state), vtables: flat_marks(vtable_state) }
}

// After cg_decl_reset: this unit has written what `m` marks.
pub fn cg_decl_start_from(m: CgDeclMarks) {
    typedef_state = NameMarks { own: Map(), base: m.typedefs }
    vtable_state = NameMarks { own: Map(), base: m.vtables }
}

// The prototype this unit wrote for each foreign symbol, as its return and parameter
// spellings. C takes one declaration per symbol, so two bindings over one symbol either
// ask for the same prototype or one of them is wrong.
let mut foreign_decls: Map[Str, Str] = Map()

// How much of a unit's own functions may be private, as the prologue was told it. A name
// another file can see is not this unit's to keep, so a unit that declares for others or is
// the archive keeps everything external; a unit linked against the archive keeps only the
// program's own module. The value before a prologue keeps every declaration external, so a
// caller that emits no prologue cannot make a symbol private by omission.
type UnitLinkage {
    AllExternal
    ProgramModuleOnly
    WholeUnit
}

let mut unit_linkage: UnitLinkage = UnitLinkage.AllExternal

pub fn cg_decl_reset() {
    typedef_state = no_marks()
    vtable_state = no_marks()
    foreign_decls = Map()
    unit_linkage = UnitLinkage.AllExternal
}

// ── The spelling gate ─────────────────────────────────────────────────────

fn spelling_or_ice(rec: LayoutRecord, what: Str) -> Str ! Diag.Report {
    let reason = rec.decline_reason
    if reason == "" { return rec.c_spelling }
    diag_ice("NoCSpellingForType", UNSOLVED_TYPEVAR_AT_CODEGEN,
        "no C spelling for {what}: {reason}", 0, 0,
        "every type that reaches code generation must be concrete and nameable; this is a compiler bug")
    ""
}

// The one place a type id becomes a C spelling for a declaration. A declined type
// answers "" and has raised I0001; no caller may substitute anything for it.
pub fn cg_decl_require_spelling(tid: Int, position: Position) -> Str ! Diag.Report {
    spelling_or_ice(layout_of(tid, position), tc_type_str(tid))
}

// ── Typedefs ──────────────────────────────────────────────────────────────

pub fn cg_decl_emit_typedefs() ! Diag.Report {
    cg_decl_emit_typedefs_over(cg_decl_spelled_carrier_tids())
}

// cg_decl_emit_typedefs with the program's spelled carriers already found, for a driver
// that emits many units of one program and scans its nodes once.
//
// A carrier is structural, so no declaration owns one and the walk over the declarations
// reaches it only as a member of a declared type. One spelled by a local annotation, a
// match scrutinee or a binder is reached by nothing, and the C then names a type it never
// defined. Flushing the spelled carriers after the declarations leaves every nominal
// member complete.
pub fn cg_decl_emit_typedefs_over(carriers: List[Int]) ! Diag.Report {
    for decl in cg_reg_type_decls() {
        if is_generic_base(decl) {
            for inst in instance_tids_of(decl) { emit_typedef_for(decl, inst) }
            continue
        }
        emit_type_decl(decl)
    }
    for decl in cg_reg_type_decls() {
        if is_generic_base(decl) {
            for inst in instance_tids_of(decl) { flush_boxed_members(decl, inst) }
            continue
        }
        flush_boxed_members(decl, -1)
    }
    for tid in carriers { flush_member_typedefs(tid) }
}

// The carriers of the members emit_struct and emit_enum held boxed, once every nominal
// typedef is written.
fn flush_boxed_members(decl: Int, inst_tid: Int) {
    if decl < 0 || skips_typedef(decl) { return }
    let owner_tid = cg_owner_tid(decl, inst_tid)
    if owner_tid < 0 { return }
    for ftid in member_tids(decl, inst_tid) {
        if field_embeds_owner(owner_tid, ftid) { flush_member_typedefs(ftid) }
    }
}

// Each carrier type a node of the program spells, once, in the order of its first node. The
// stamp table is the set of types the program spells, whatever position spelled each one.
// A second flush of a type is a no-op, so the first node is the only one that counts. The
// nodes go in load order, which a load that kept sources does not give by id.
pub fn cg_decl_spelled_carrier_tids() -> List[Int] {
    let mut seen: Map[Int, Int] = Map()
    let mut out: List[Int] = []
    let ranges = parser_live_ranges()
    let mut r = 0
    while r < ranges.len() {
        let mut n = ranges.get(r).unwrap()
        while n < ranges.get(r + 1).unwrap() {
            let tid = tc_lookup_node_tid(n)
            if tid >= 0 && seen.contains_key(tid) == 0 && is_carrier_kind(tc_tid_kind(tc_resolve(tid))) {
                seen.insert(tid, 1)
                out.push(tid)
            }
            n = n + 1
        }
        r = r + 2
    }
    out
}

fn is_carrier_kind(k: TyKind) -> Bool {
    k == TyKind.Option || k == TyKind.Result || k == TyKind.Tuple
}

// A generic declaration is a template. Only its instances have a C spelling, so asking
// the reading layer for the base's types would ask for the C type of a free type
// variable and get a decline this stage must report as a compiler bug.
fn is_generic_base(decl: Int) -> Bool {
    let tps = node_type_params(decl)
    tps != -1 && sublist_length(tps) > 0
}

// The type ids the monomorphization pass registered for one generic declaration. That
// pass is the only authority on which instances a program has: none of them is written
// down in the source, and an instance nobody reaches has no C shape to write.
fn instance_tids_of(decl: Int) -> List[Int] {
    let mut out: List[Int] = []
    for inst in instances() {
        if inst.base_decl_node == decl { out.push(inst.inst_tid) }
    }
    out
}

// A declaration whose C typedef this translation unit does not write: an alias (it has no
// storage of its own), an opaque foreign handle (the foreign header declares the pointee)
// and a type whose typedef lives in runtime.h. A generic base is not on this list: it is
// not skipped but redirected, because its instances do get typedefs.
fn skips_typedef(decl: Int) -> Bool {
    if node_fields(decl) == -1 && node_value(decl) != -1 { return true }
    if get_annotation(decl, "ffi.opaque") != -1 { return true }
    cname_is_runtime_owned(decl)
}

// A monomorphic declaration: its own tid is the type, and it has no instance arguments.
fn emit_type_decl(decl: Int) ! Diag.Report {
    if decl < 0 { return }
    emit_typedef_for(decl, -1)
}

// One typedef. `inst_tid` is the instance this typedef describes, or -1 for a declaration
// that has no type parameters and is therefore its own single type.
fn emit_typedef_for(decl: Int, inst_tid: Int) ! Diag.Report {
    if decl < 0 { return }
    let tid = if inst_tid < 0 { cg_reg_tid_for_decl(decl) } else { inst_tid }
    if tid < 0 { return }
    let c_name = c_typedef_name(tid)
    if diag_is_ice_seg(c_name) { return }
    // 1 means this type is already on the stack: the only way back to it is a member that
    // reaches its own owner, and such a member is stored boxed, so the cycle needs no
    // completed typedef and is not followed.
    if mark_of(typedef_state, c_name) != 0 { return }
    typedef_state.own.insert(c_name, 1)
    if skips_typedef(decl) {
        typedef_state.own.insert(c_name, 2)
        return
    }
    for mtid in member_tids(decl, inst_tid) {
        for dep in nominal_deps(mtid) { emit_dep(dep) }
        emit_handler_dep(handler_dep_of(mtid))
    }
    typedef_state.own.insert(c_name, 2)
    emit_one(decl, tid, inst_tid, c_name)
}

// A nominal type one member reaches. Which of the two paths it takes is a fact about its
// own declaration, not about the member: an instance is emitted at the tid the member
// carries, and a monomorphic type always at the tid its declaration registered, so a
// member that names it and the declaration walk that reaches it agree on one typedef.
fn emit_dep(dep_tid: Int) ! Diag.Report {
    let decl = tc_tid_decl_node(tc_resolve(dep_tid))
    if decl < 0 || decl == DECL_NODE_AMBIGUOUS { return }
    if is_generic_base(decl) {
        emit_typedef_for(decl, tc_resolve(dep_tid))
        return
    }
    emit_type_decl(decl)
}

// The member types of a nominal type, in declaration order: a struct's fields, or every
// field of every enum variant. The slots are registered against the declaration, so a
// generic type's members are declared over its own binders and each one is read back at
// the instance's arguments.
fn member_tids(decl: Int, inst_tid: Int) -> List[Int] {
    let base = cg_reg_tid_for_decl(decl)
    let mut out: List[Int] = []
    if tc_tid_kind(tc_resolve(base)) == TyKind.Enum {
        for v in tc_enum_variant_slots(base) {
            for f in tc_evar_field_slots(v) {
                out.push(tc_member_tid_at_instance(tc_evfield_tid(f), inst_tid))
            }
        }
        return out
    }
    for f in tc_struct_field_slots(base) {
        out.push(tc_member_tid_at_instance(tc_sfield_tid(f), inst_tid))
    }
    out
}

// The nominal types whose typedef a member type needs written first. A carrier needs what
// carrier_complete_children answers, so the walk goes through those; a nominal type a
// carrier holds by pointer needs only its name, which layout declares ahead, and a runtime
// container is one C type whatever it holds, so the walk stops at both.
fn nominal_deps(tid: Int) -> List[Int] {
    let r = tc_resolve(tid)
    let k = tc_tid_kind(r)
    if k == TyKind.Struct || k == TyKind.Enum { return [r] }
    let mut out: List[Int] = []
    for c in carrier_complete_children(r) {
        for d in nominal_deps(c) { out.push(d) }
    }
    out
}

// The root effect vtable a member names BY POINTER, as a Handler tid, or -1. A handler field
// holds a pointer to the vtable, so the typedef has to be read where the field names it,
// exactly as a nominal member's typedef does.
//
// Only a member that IS a handler names one. A member of another nominal type names its own
// typedef, and the walk reaches that type's handler fields through it; a carrier or a tuple
// holding a handler erases the element to a word, so its typedef names no vtable at all.
fn handler_dep_of(tid: Int) -> Int {
    let r = tc_resolve(tid)
    if tc_tid_kind(r) != TyKind.Handler { return -1 }
    r
}

// One effect's vtable typedef, reached from a member rather than from the declaration walk
// that writes the evidence vector. The vector comes after every typedef, which is too late
// for a struct that names the vtable in a field.
//
// A builtin root other than FS has no declaration here and no typedef to write: runtime.h
// owns both, which is why a Handler[IO] field has always worked.
fn emit_handler_dep(handler_tid: Int) ! Diag.Report {
    if handler_tid < 0 { return }
    let vtable = c_vtable_type_name(handler_tid)
    if diag_is_ice_seg(vtable) { return }
    if mark_of(vtable_state, vtable) != 0 { return }
    if vtable == c_vtable_type_name(fs_handler_tid()) {
        let _ = emit_fs_vtable(false)
        return
    }
    let decl = effect_decl_for_vtable(vtable)
    if decl < 0 { return }
    let sig = vtable_sig(decl, make_handler_type(node_name(decl)))
    if !sig.ok {
        vtable_state.own.insert(vtable, 1)
        return
    }
    emit_vtable_typedef(vtable, sig)
}

// The declaration that owns the root vtable of this C name, or -1 when no declaration in
// this program does. The compare is on the name the namer answers rather than on the effect
// name, because a handler of a sub-effect names its root's vtable and the namer is the one
// layer that knows which root that is.
fn effect_decl_for_vtable(vtable: Str) -> Int {
    for e in cg_reg_effect_decls() {
        if c_vtable_type_name(make_handler_type(node_name(e))) == vtable { return e }
    }
    -1
}

// layout.bl builds a member's Option, Result and Tuple typedefs children-first as
// finished blocks. Draining them here, before the typedef that names them, is what puts
// an inner carrier ahead of the outer one.
fn flush_member_typedefs(tid: Int) {
    let _ = ensure_typedef_for(tid)
    print_typedef_blocks(layout_take_typedefs())
}

// The tid of the type a member sits in: the instance being emitted, or the declaration's
// own single type when it takes no parameters and -1 stands for "no instance".
fn cg_owner_tid(decl: Int, inst_tid: Int) -> Int {
    if inst_tid >= 0 { return inst_tid }
    cg_reg_tid_for_decl(decl)
}

fn emit_one(decl: Int, tid: Int, inst_tid: Int, c_name: Str) ! Diag.Report {
    let guard = td_guard_name(c_name)
    if tc_tid_kind(tc_resolve(tid)) == TyKind.Enum {
        emit_enum(decl, inst_tid, guard, c_name)
    } else {
        emit_struct(decl, inst_tid, guard, c_name)
    }
}

// A member that embeds its owner is held boxed, so the owner typedef needs none of its
// carriers. Those carriers need the owner's typedef, and that of every other type on the
// cycle, some of which the walk may still be inside, so they wait for flush_boxed_members.
fn flush_unless_embeds_owner(owner_tid: Int, ftid: Int) {
    if !field_embeds_owner(owner_tid, ftid) { flush_member_typedefs(ftid) }
}

fn emit_struct(decl: Int, inst_tid: Int, guard: Str, c_name: Str) ! Diag.Report {
    let owner_tid = cg_owner_tid(decl, inst_tid)
    let mut fields: List[Str] = []
    for slot in tc_struct_field_slots(cg_reg_tid_for_decl(decl)) {
        let ftid = tc_member_tid_at_instance(tc_sfield_tid(slot), inst_tid)
        flush_unless_embeds_owner(owner_tid, ftid)
        let fname = tc_sfield_name(slot)
        let spelling = spelling_or_ice(field_layout_of(owner_tid, ftid), "{node_name(decl)}.{fname}")
        if spelling == "" { return }
        fields.push("{spelling} {c_field_name(fname)}")
    }
    print_struct_typedef(guard, c_name, fields)
    emit_ffi_layout_asserts(decl, c_name)
}

// C is the only authority on a foreign layout, so a mirror of a named C struct asks the C
// compiler to refuse it once it drifts from the header. A mirror with no name has nothing
// to compare against.
fn emit_ffi_layout_asserts(decl: Int, c_name: Str) ! Diag.Report {
    let original = c_ffi_struct_original(decl)
    if original == "" { return }
    let mut fields: List[Str] = []
    let mut c_fields: List[Str] = []
    for slot in tc_struct_field_slots(cg_reg_tid_for_decl(decl)) {
        fields.push(c_field_name(tc_sfield_name(slot)))
        c_fields.push(tc_sfield_name(slot))
    }
    print_ffi_layout_asserts(c_name, original, fields, c_fields)
}

// A variant's declaration node, needed for the tag macro cname spells. The variant
// entries typecheck registered are in declaration order, so they line up by index.
fn variant_node(decl: Int, index: Int) -> Int {
    let vars = node_fields(decl)
    if vars == -1 || index >= sublist_length(vars) { return -1 }
    sublist_get(vars, index)
}

fn emit_enum(decl: Int, inst_tid: Int, guard: Str, c_name: Str) ! Diag.Report {
    let slots = tc_enum_variant_slots(cg_reg_tid_for_decl(decl))
    let mut names: List[Str] = []
    let mut fields: List[List[Str]] = []
    let mut macros: List[Str] = []
    let mut ordinals: List[Str] = []
    // Which of the two C forms an enum takes is a fact about the declaration, so it is
    // asked of the same predicate the namer asks. Counting the fields that reached a
    // spelling would answer it differently when one declines: the decline still reports
    // its own ICE, but a payload enum would emit as a plain C enum and miscompile.
    let carries_data = tc_enum_has_payload(cg_owner_tid(decl, inst_tid))
    let mut i = 0
    while i < slots.len() {
        let slot = slots.get(i).unwrap()
        let vnode = variant_node(decl, i)
        if vnode < 0 { return }
        let decls = variant_field_decls(decl, inst_tid, slot)
        names.push(tc_evar_name(slot))
        fields.push(decls)
        let disc = c_variant_discriminant(cg_owner_tid(decl, inst_tid), vnode)
        macros.push(disc)
        ordinals.push(disc)
        i += 1
    }
    if !carries_data {
        print_simple_enum_typedef(guard, c_name, ordinals)
        return
    }
    print_tagged_enum_typedef(guard, c_name, c_type_of(enum_tag_tid(), Position.Field),
        c_enum_tag_member(), c_enum_payload_member(), names, fields, macros)
}

fn variant_field_decls(owner: Int, inst_tid: Int, var_slot: Int) -> List[Str] ! Diag.Report {
    let owner_tid = cg_owner_tid(owner, inst_tid)
    let mut out: List[Str] = []
    for f in tc_evar_field_slots(var_slot) {
        let ftid = tc_member_tid_at_instance(tc_evfield_tid(f), inst_tid)
        flush_unless_embeds_owner(owner_tid, ftid)
        let fname = tc_evfield_name(f)
        let spelling = spelling_or_ice(field_layout_of(owner_tid, ftid), "{node_name(owner)}.{tc_evar_name(var_slot)}.{fname}")
        if spelling == "" { return out }
        out.push("{spelling} {c_field_name(fname)}")
    }
    out
}

// ── Function declarations ────────────────────────────────────────────────────
//
// A function's signature types are not on the function node: typecheck stamps each
// parameter node and the return annotation node, so those are what the spelling gate
// reads. A function with no return annotation returns void.

// A declared effect is what puts the evidence vector in the signature. The entry point is
// the exception in both directions: the shim always passes it one, and an FFI extern binds
// a C function that knows nothing about evidence. Which node is the entry point is the
// registry's answer, not a name compare: an impl method may be named `main` too.
//
// This is published because it is an ABI fact, not a private detail of printing: a call
// site must pass exactly the arguments the printed signature takes, and the driver must
// know which signatures name a vector the stdlib archive does not define. A second copy
// of the rule is an arity mismatch waiting to happen, found by the C compiler rather than
// by this one.
pub fn cg_decl_takes_ev(fn_node: Int) -> Bool {
    if get_annotation(fn_node, "ffi") != -1 { return false }
    if fn_node == cg_reg_entry_point() { return true }
    let sl = node_effects(fn_node)
    if sl == -1 { return false }
    sublist_length(sl) > 0
}

// A function with no return annotation returns the void type, which the reading layer
// already spells for the return position; naming that spelling here would be a twin.
fn fn_ret_tid(fn_node: Int) -> Int ! Diag.Report {
    let ann = node_type_ann(fn_node)
    if ann == -1 { return tc_void_tid() }
    tid_of_node(ann)
}

fn fn_ret_spelling(fn_node: Int) -> Str ! Diag.Report {
    let tid = fn_ret_tid(fn_node)
    flush_member_typedefs(tid)
    cg_decl_require_spelling(tid, Position.Return)
}

fn fn_param_decls(fn_node: Int) -> List[Str] ! Diag.Report {
    let mut out: List[Str] = []
    let sl = node_params(fn_node)
    if sl == -1 { return out }
    let mut i = 0
    while i < sublist_length(sl) {
        let p = sublist_get(sl, i)
        flush_member_typedefs(tid_of_node(p))
        let spelling = cg_decl_require_spelling(tid_of_node(p), Position.Param)
        out.push("{spelling} {c_local_name(node_name(p))}")
        i = i + 1
    }
    out
}

// A foreign binding is reached through a C wrapper under the Blink name. When that
// wrapper would carry the foreign symbol's own name there is no wrapper at all: the
// call goes straight to the foreign function, whose own header declares it. A second
// prototype guessed from the Blink signature loses the qualifiers that header spells,
// and C rejects the mismatch. The name the wrapper would carry is the caller's to say:
// a free function and an impl method spell it differently.
fn needs_no_wrapper(fn_node: Int, decl_name: Str) -> Bool {
    let symbol = c_ffi_symbol(fn_node)
    symbol != "" && symbol == decl_name
}

// The C name a declaration carries. A method takes its receiver type and its trait, a
// free function its module. Which of the two applies comes from the registry, so it is
// a property of where the declaration was written and not of the call that reaches it.
// A static call of an impl method is spelled like a free call, so a reader that decided
// from the call site would have to be right about every call shape.
//
// Pub so a stage outside this module asks instead of deciding. Whoever writes a prototype
// and whoever writes the call to it must answer this the same way, and two readers that
// decide it apart agree until the rule changes under one of them. C reports the result as
// an undefined symbol, with no Blink span on it.
pub fn cg_decl_c_name(decl: Int) -> Str {
    let im = cg_reg_impl_of(decl)
    if im >= 0 { return c_impl_method_name(im, node_name(decl)) }
    c_fn_decl_name(decl)
}

// The module key of the file a program is built from. Nothing imports it, so a name it
// declares is reachable from no other unit.
let entry_module = "__main__"

// Whether C should be told this function belongs to this translation unit alone. Only a
// function this unit both declares and defines, and that nothing outside it can name,
// qualifies: C reads a prototype and a definition that disagree on linkage as two
// different functions and rejects the unit, and a name another unit calls but this one
// keeps private fails at link instead.
//
// So four unit shapes answer no whatever the declaration says. A header is read by every
// unit that includes it, and a unit whose own declarations come from such a header has
// its prototype in a file this one does not own, so neither may narrow a name. A unit
// linked against the stdlib archive declares the archive's own private functions and
// defines none of them, so only the program's own module is this unit's to keep -- that
// is the shape this rule was withdrawn over once already. And an archive, the stdlib's or
// one layered over it, is linked against by every program built after it, so nothing
// compiled into it is private.
//
// A pub function is named from outside, the entry point is the program's, and an @ffi
// binding wraps a name the C library owns, so those three keep external linkage too.
//
// One reader, so the prototype and the body cannot answer it apart.
fn cg_decl_fn_is_internal(fn_node: Int) -> Bool {
    match unit_linkage {
        UnitLinkage.AllExternal => return false
        UnitLinkage.ProgramModuleOnly => {
            if cg_reg_module_of(fn_node) != entry_module { return false }
        }
        UnitLinkage.WholeUnit => {}
    }
    if node_is_pub(fn_node) == 1 { return false }
    if fn_node == cg_reg_entry_point() { return false }
    if c_ffi_symbol(fn_node) != "" { return false }
    match cg_decl_body_site(fn_node) {
        BodySite.ThisUnit => true
        BodySite.PerInstance => false
        BodySite.ForeignWrapper => false
        BodySite.Nothing => false
    }
}


// A carrier type has no declaration of its own, so the only thing that asks for it is
// the signature that names it. Spelling it records its typedef, which must be written
// before the declaration that reads it, so the spellings are taken first.
pub fn cg_decl_emit_fn_decl(fn_node: Int, is_static: Bool) ! Diag.Report {
    if !site_is_declared(cg_decl_body_site(fn_node)) { return }
    cg_decl_emit_signature_decl(fn_node, cg_decl_c_name(fn_node), is_static || cg_decl_fn_is_internal(fn_node))
}

// A signature under a name the caller chose. The spellings come from the declaration's
// own nodes, which read as the binder's type on the root walk and as the substituted type
// while an instance is current, so one reader serves both and neither can drift. A
// monomorphized instance therefore comes through here under the instance's own name,
// with that instance made current by the caller.
pub fn cg_decl_emit_signature_decl(fn_node: Int, name: Str, is_static: Bool) ! Diag.Report {
    let ret = fn_ret_spelling(fn_node)
    let params = fn_param_decls(fn_node)
    print_fn_decl(is_static, ret, name, params, cg_decl_takes_ev(fn_node))
}

pub fn cg_decl_emit_signature_def(fn_node: Int, name: Str, is_static: Bool, body: Int) ! Diag.Report {
    let ret = fn_ret_spelling(fn_node)
    let params = fn_param_decls(fn_node)
    print_fn(is_static, ret, name, params, cg_decl_takes_ev(fn_node), body)
}

pub fn cg_decl_emit_fn_decls() ! Diag.Report {
    for f in cg_reg_fn_decls() { cg_decl_emit_fn_decl(f, false) }
}

// ── Impl method declarations ─────────────────────────────────────────────────
//
// An impl method is a plain C function that takes the receiver first. Typecheck stamps
// the `self` parameter node with the receiver's type id exactly as it stamps every other
// parameter, so the signature needs nothing the free-function path does not already have.
// Only the name differs: it carries the receiver type and the trait.

// A generic impl block is a template over its binders. Its methods have a C spelling only
// once a receiver type is chosen, which is one monomorphized instance per choice.
fn impl_is_generic(im: Int) -> Bool {
    let binders = node_impl_binders(im)
    binders != -1 && sublist_length(binders) > 0
}

// The same linkage rule the body half reads. A method is written twice, once here and
// once as a definition, and C rejects a file whose two halves disagree.
pub fn cg_decl_emit_impl_method_decl(method: Int, is_static: Bool) ! Diag.Report {
    if cg_reg_impl_of(method) < 0 { return }
    if !site_is_declared(cg_decl_body_site(method)) { return }
    cg_decl_emit_signature_decl(method, cg_decl_c_name(method), is_static || cg_decl_fn_is_internal(method))
    emit_display_dispatch_decl(method, is_static)
}

// ── The Display dispatcher ───────────────────────────────────────────────────
//
// `Display.fmt` fills a builder and answers nothing, so nothing can render a value from
// it alone. Every renderer calls a second function beside it that makes the builder, runs
// `fmt` and answers the built Str. That function has no declaration in the source, so it
// is written here, from the same walk that writes `fmt`: a prelude type's impl is
// compiled into every unit that uses it, and a list of type names would leave those units
// calling a name nothing defines.

let display_trait = "Display"
let display_method = "fmt"

// The impl behind a `Display.fmt`, or -1 for anything else. The trait name is the
// registry's, not a guess from the method name: a user trait may name a method `fmt` too.
fn display_fmt_impl(decl: Int) -> Int {
    let im = cg_reg_impl_of(decl)
    if im < 0 { return -1 }
    if tc_impl_trait_id(im) != display_trait { return -1 }
    if node_name(decl) != display_method { return -1 }
    im
}

// The receiver, declared. `fmt` takes the builder as well, and the dispatcher makes its
// own, so only the first parameter carries over.
fn display_self_decl(method: Int) -> List[Str] ! Diag.Report {
    let all = fn_param_decls(method)
    if all.len() == 0 { return [] }
    [all.get(0).unwrap()]
}

fn display_param(method: Int, which: Int) -> Int {
    let sl = node_params(method)
    if sl == -1 || sublist_length(sl) <= which { return -1 }
    sublist_get(sl, which)
}

fn emit_display_dispatch_decl(method: Int, is_static: Bool) ! Diag.Report {
    let im = display_fmt_impl(method)
    if im < 0 { return }
    if display_param(method, 1) < 0 { return }
    print_fn_decl(is_static, c_type_of(TYPE_STR, Position.Return),
        c_display_dispatch_name(im), display_self_decl(method), false)
}

fn emit_display_dispatch_def(method: Int, is_static: Bool) ! Diag.Report {
    let im = display_fmt_impl(method)
    if im < 0 { return }
    let recv = display_param(method, 0)
    let sb = display_param(method, 1)
    if recv < 0 || sb < 0 { return }

    let sb_tid = tid_of_node(sb)
    let sb_lay = layout_of(sb_tid, Position.Local)
    let sb_name = c_local_name(node_name(sb))
    let str_lay = layout_of(TYPE_STR, Position.Return)

    let made = ir_call_runtime(sb_tid, method, sb_lay.c_spelling,
        c_runtime_helper("sb_new"), sb_lay.slot_form, [])
    let hold = ir_let(sb_tid, method, sb_lay.c_spelling, sb_name, sb_lay.slot_form, made)

    let recv_tid = tid_of_node(recv)
    let recv_lay = layout_of(recv_tid, Position.Param)
    let void_lay = layout_of(tc_void_tid(), Position.Return)
    let filled = ir_expr_stmt(method, ir_call_direct(tc_void_tid(), method, void_lay.c_spelling,
        c_impl_method_name(im, display_method), void_lay.slot_form, [
            ir_var_ref(recv_tid, method, recv_lay.c_spelling, c_local_name(node_name(recv)), recv_lay.slot_form),
            ir_var_ref(sb_tid, method, sb_lay.c_spelling, sb_name, sb_lay.slot_form),
        ]))

    let built = ir_return(method, ir_call_runtime(TYPE_STR, method, str_lay.c_spelling,
        c_runtime_helper("sb_to_str"), str_lay.slot_form,
        [ir_var_ref(sb_tid, method, sb_lay.c_spelling, sb_name, sb_lay.slot_form)]))

    print_fn(is_static, str_lay.c_spelling, c_display_dispatch_name(im),
        display_self_decl(method), false, ir_block(method, [hold, filled, built]))
}

pub fn cg_decl_emit_impl_method_decls() ! Diag.Report {
    for m in cg_reg_impl_methods() { cg_decl_emit_impl_method_decl(m, false) }
}

// ── Definitions ──────────────────────────────────────────────────────────────
//
// A definition repeats the declaration's signature and adds the body the statement
// stage lowered. The signature comes from the same three producers the declaration used,
// so a definition can never disagree with the prototype a caller compiled against.

// Where a declaration's body is written. Both the prototype and the body follow from
// this one answer, so this unit can never declare what it does not define, nor define
// what it never declared.
pub type BodySite {
    // This unit, under the declaration's own name.
    ThisUnit
    // One body per monomorphized instance, because the declaration's own types are
    // binders and a body needs concrete ones.
    PerInstance
    // A C wrapper whose body calls the foreign symbol. It has no Blink statements.
    ForeignWrapper
    // Nowhere: the call goes straight to the foreign function under its own name, so
    // there is no wrapper and no body to write.
    Nothing
}

pub fn cg_decl_body_site(decl: Int) -> BodySite {
    let im = cg_reg_impl_of(decl)
    if im >= 0 { return method_body_site(decl, im) }
    free_fn_body_site(decl)
}

// A free binding over a foreign symbol has one wrapper however many binders its Blink
// signature carries, because the foreign symbol has one address. That makes the binding
// the exception to the per-instance rule, so it is asked about first.
fn free_fn_body_site(fn_node: Int) -> BodySite {
    if c_ffi_symbol(fn_node) != "" { return foreign_body_site(fn_node) }
    if is_generic_base(fn_node) { return BodySite.PerInstance }
    BodySite.ThisUnit
}

// A method has no such exception. Its name carries the receiver type, so a binding over
// one foreign symbol still needs a wrapper for each receiver the binders admit. So the
// question of which bodies exist is settled before the question of where they come from.
//
// The mono pass answers the first question. It writes one instance per element for the
// impls `is_poly_impl` admits and walks every other impl as a root, which asks for one
// shared body. Reading its own predicate here is what keeps the two stages naming the same
// set: a second rule sends methods down a path whose rows are never registered.
fn method_body_site(method: Int, im: Int) -> BodySite {
    if is_poly_impl(im) || method_is_mono_gap(method, im) { return BodySite.PerInstance }
    if c_ffi_symbol(method) != "" { return foreign_body_site(method) }
    BodySite.ThisUnit
}

// A method that needs one body per instance rather than one shared body.
//
// Three ways a method gets here. It carries its own type parameters: mono instantiates
// those the same way it instantiates a free function's own generic parameter
// (register_own_generic_method / register_poly_own_generic_method), one instance per
// distinct argument tuple, so a shared body is the wrong shape rather than a gap. Or its
// impl names a binder in a method signature, so the C differs per choice and no single
// body is the right one. Or its receiver is a generic user type, which has no C spelling
// until an argument is chosen: a shared body would have to name a struct that does not
// exist. A method that reaches none of the three rows above but that mono still registers
// no call for is a different problem, caught downstream by no_instance_bodies rather than
// by this predicate.
fn method_is_mono_gap(method: Int, im: Int) -> Bool {
    if is_poly_impl(im) { return false }
    if is_generic_base(method) { return true }
    if !impl_is_generic(im) { return false }
    receiver_is_generic_user_type(im) || !poly_impl_is_element_agnostic(im)
}

// Whether the receiver names a generic declaration this program writes. A builtin
// container is one erased pointer however it is parameterized, so an impl over it has one
// C body; a generic user type is a different struct per argument and has none.
//
// A bare name two modules both declare identifies no single declaration, so a generic
// namesake is answer enough. Reporting a gap that is not one costs a diagnostic; the other
// way round writes a body naming a struct that does not exist.
fn receiver_is_generic_user_type(im: Int) -> Bool {
    for d in cg_reg_type_decls() {
        if node_name(d) == node_name(im) && is_generic_base(d) { return true }
    }
    false
}

fn foreign_body_site(decl: Int) -> BodySite {
    if needs_no_wrapper(decl, cg_decl_c_name(decl)) { return BodySite.Nothing }
    BodySite.ForeignWrapper
}

// A prototype is written for exactly the bodies that exist under the declaration's own
// name. A per-instance body is declared with its instance, and a direct binding has no
// wrapper for a prototype to describe.
fn site_is_declared(site: BodySite) -> Bool {
    match site {
        BodySite.ThisUnit => true
        BodySite.ForeignWrapper => true
        BodySite.PerInstance => false
        BodySite.Nothing => false
    }
}

pub fn cg_decl_emit_fn_def(fn_node: Int, is_static: Bool, body: Int) ! Diag.Report {
    cg_decl_emit_signature_def(fn_node, cg_decl_c_name(fn_node), is_static || cg_decl_fn_is_internal(fn_node), body)
    emit_display_dispatch_def(fn_node, is_static)
}

// ── Foreign wrappers ───────────────────────────────────────────────────
//
// A binding declares a Blink signature over a C symbol and has no Blink body, so the body
// this stage writes is the whole conversion: the wrapper's own parameters, handed to the
// foreign symbol in the shape C reads them, and the answer handed straight back. The
// signature is the developer's claim about what the foreign function expects, so an
// argument crosses unchanged unless C would read it as a different type.
//
// Which declaration the call is checked against decides the rest. A symbol the prologue
// already declares is checked against the real header, so an @ffi.struct mirror has to be
// cast to the C struct that header names. A symbol nothing declares is checked against the
// prototype written here from the Blink signature, so the same argument crosses under the
// mirror's own spelling and needs no cast.
pub fn cg_decl_emit_foreign_wrapper(fn_node: Int) ! Diag.Report {
    let symbol = c_ffi_symbol(fn_node)
    let declared = print_prologue_declares(symbol)
    if declared && !foreign_shapes_convertible(fn_node) { return }
    let ret = fn_ret_spelling(fn_node)
    let params = fn_param_decls(fn_node)
    if !declared && !write_foreign_decl(fn_node, ret, symbol, params) { return }
    let args = foreign_call_args(fn_node, declared)
    print_fn(false, ret, cg_decl_c_name(fn_node), params, cg_decl_takes_ev(fn_node),
        foreign_call_block(fn_node, symbol, ret, args))
}

// Whether the unit's prototype for `symbol` is the one this binding needs, writing it when
// the unit has none yet. A second binding that asks for a different one is refused: C
// rejects the pair, and picking either prototype makes one of the two wrappers call the
// foreign function under a signature its own source never wrote.
fn write_foreign_decl(site: Int, ret: Str, symbol: Str, params: List[Str]) -> Bool ! Diag.Report {
    let shape = ret.concat("(").concat(params.join(", ")).concat(")")
    if foreign_decls.contains_key(symbol) == 0 {
        foreign_decls.insert(symbol, shape)
        print_foreign_decl(ret, symbol, params)
        return true
    }
    if foreign_decls.get(symbol).unwrap() == shape { return true }
    diag_ice_at("ForeignSymbolTwoPrototypes", CODEGEN_STAGE_NOT_BUILT,
        "two bindings over the foreign symbol `{symbol}` ask for different prototypes",
        site, "C takes one declaration per symbol: give the two bindings one signature")
    false
}

// A value-returning wrapper that drops the call's answer falls off the end of a function
// whose signature promises one, so the return type decides the statement, not the call. The
// test is the one layout uses to spell a return `void`, or the two could disagree.
fn foreign_call_block(fn_node: Int, symbol: Str, ret: Str, args: List[Int]) -> Int ! Diag.Report {
    let tid = fn_ret_tid(fn_node)
    let k = tc_tid_kind(tc_resolve(tid))
    let drops = k == TyKind.Void || k == TyKind.Never
    let direct = ir_call_direct(tid, fn_node, ret, symbol, SlotForm.Inline, args)
    let call = if k == TyKind.Str && !foreign_symbol_makes_strs(symbol) {
        // A C string has no Str length header, so the answer is copied into a Str.
        ir_call_runtime(tid, fn_node, ret, c_runtime_helper("str_from_foreign"), SlotForm.Inline,
            [direct, ir_const(tid, fn_node, ret, c_string_literal(symbol))])
    } else {
        direct
    }
    let stmt = if drops { ir_expr_stmt(fn_node, call) } else { ir_return(fn_node, call) }
    ir_block(fn_node, [stmt])
}

// The runtime's own functions answer real Strs, header and all; any other symbol answers a
// plain C string.
fn foreign_symbol_makes_strs(symbol: Str) -> Bool {
    symbol.starts_with("blink_") || symbol.starts_with("blinkrt_") || symbol.starts_with("__blink")
}

fn foreign_call_args(fn_node: Int, declared: Bool) -> List[Int] ! Diag.Report {
    let mut out: List[Int] = []
    let sl = node_params(fn_node)
    if sl == -1 { return out }
    let mut i = 0
    while i < sublist_length(sl) {
        let p = sublist_get(sl, i)
        let tid = tid_of_node(p)
        let rec = layout_of(tid, Position.Param)
        let arg = ir_var_ref(tid, p, spelling_or_ice(rec, tc_type_str(tid)),
            c_local_name(node_name(p)), rec.slot_form)
        let cast_to = if declared { foreign_cast_name(tid) } else { "" }
        out.push(if cast_to != "" { ir_cast(tid, p, cast_to, arg) } else { arg })
        i = i + 1
    }
    out
}

// What a type reaches on its way across: the @ffi.struct mirror behind its pointers, and
// how many Ptr levels stand in front of it. C casts one level, so those two facts together
// decide between a cast, a plain argument and a refusal. `decl` is -1 when the type reaches
// no mirror at all.
type Crossing {
    decl: Int
    ptr_depth: Int
}

fn crossing_of(tid: Int) -> Crossing {
    let mut t = tc_resolve(tid)
    let mut depth = 0
    while tc_tid_kind(t) == TyKind.Ptr && tc_tid_child_count(t) > 0 {
        t = tc_resolve(tc_tid_child(t, 0))
        depth = depth + 1
    }
    let decl = tc_tid_decl_node(t)
    if decl == DECL_NODE_AMBIGUOUS { return Crossing { decl: decl, ptr_depth: depth } }
    if cname_ffi_struct_mirror(decl) { return Crossing { decl: decl, ptr_depth: depth } }
    Crossing { decl: -1, ptr_depth: depth }
}

// The C struct an argument must be cast to, or "" when it crosses as the wrapper spells it.
fn foreign_cast_name(tid: Int) -> Str {
    let cross = crossing_of(tid)
    if cross.decl < 0 || cross.ptr_depth != 1 { return "" }
    c_ffi_struct_ptr_name(cross.decl)
}

// Every position whose C shape this stage can write when the call is checked against the
// real header. Each position refuses on its own, so one wrapper can name more than one
// shape it has no conversion for.
fn foreign_shapes_convertible(fn_node: Int) -> Bool ! Diag.Report {
    let mut ok = true
    let sl = node_params(fn_node)
    let n = if sl == -1 { 0 } else { sublist_length(sl) }
    let mut i = 0
    while i < n {
        let p = sublist_get(sl, i)
        if !shape_convertible(tid_of_node(p), p, false) { ok = false }
        i = i + 1
    }
    if !shape_convertible(fn_ret_tid(fn_node), fn_node, true) { ok = false }
    ok
}

// A mirror crossing by value has no conversion: C forbids a cast between two struct types,
// so the wrapper would hand the foreign function the wrong type under a name that compiles.
// A cast reaches one pointer level, and a mirror that names no C struct cannot be spelled as
// the original at all. An answer is stricter: it arrives under the foreign spelling and this
// stage writes no conversion on the way out, so any mirror in the return is refused.
fn shape_convertible(tid: Int, site: Int, is_return: Bool) -> Bool ! Diag.Report {
    let cross = crossing_of(tid)
    if cross.decl == DECL_NODE_AMBIGUOUS {
        return refuse_foreign_shape(site, is_return, "a type whose name two modules declare")
    }
    if cross.decl < 0 { return true }
    let what = "the @ffi.struct type {node_name(cross.decl)}"
    if cross.ptr_depth == 0 { return refuse_foreign_shape(site, is_return, "a value of {what}") }
    if cross.ptr_depth > 1 {
        return refuse_foreign_shape(site, is_return, "a pointer to a pointer to {what}")
    }
    if is_return { return refuse_foreign_shape(site, is_return, "a pointer to {what}") }
    if c_ffi_struct_ptr_name(cross.decl) != "" { return true }
    refuse_foreign_shape(site, is_return,
        "a pointer to {what}, which names no C struct")
}

fn refuse_foreign_shape(site: Int, is_return: Bool, what: Str) -> Bool ! Diag.Report {
    let position = if is_return { "returns" } else { "takes" }
    let fix = if is_return {
        "return an Int or a Ptr to a type no foreign header declares, and read the struct through a second binding"
    } else {
        "pass the type through a single Ptr and give its @ffi.struct annotation a name"
    }
    diag_ice_at("ForeignShapeNotConvertible", CODEGEN_STAGE_NOT_BUILT,
        "cg foreign wrapper bodies cannot convert {what}, which this binding {position}, for a foreign function the prologue already declares",
        site, fix)
    false
}

// ── Globals ──────────────────────────────────────────────────────────────────
//
// A top-level `let` is a C global under its bare Blink name, in every module. The name
// is unmangled on purpose: it is the linkage another translation unit refers to.

// `globals` is the caller's chosen scope — the whole program, or one module's own
// globals, filtered before this is called. `inits` carries each of those globals'
// initializer, already lowered by the driver, keyed by the global's own node. A value
// classified IrKind.Const is a literal the front end already resolved, so it prints
// straight onto the definition line; anything else keeps a bare declaration and is
// instead handed back as one assignment for the caller to run before the program does
// anything else, in the order the globals were declared in. An extern declaration never
// carries an initializer either way, because it names a definition another unit already
// owns.
pub fn cg_decl_emit_globals(is_extern: Bool, globals: List[Int], inits: Map[Int, Int]) -> List[Int] ! Diag.Report {
    let mut deferred: List[Int] = []
    for g in globals {
        let tid = tid_of_node(g)
        flush_member_typedefs(tid)
        let spelling = cg_decl_require_spelling(tid, Position.Local)
        let name = c_global_name(g)
        if is_extern {
            print_global_decl(spelling, name, true)
            continue
        }
        let value = inits.get(g) ?? -1
        if value >= 0 && ir_kind(value) == IrKind.Const {
            print_global_init(spelling, name, ir_c_name(value))
        } else {
            print_global_decl(spelling, name, false)
            // An initializer with checks to run first comes back as its own block, the
            // assignment last, so it is handed on whole.
            if value >= 0 && ir_kind(value) == IrKind.Block {
                deferred.push(value)
            } else if value >= 0 {
                let rec = layout_of(tid, Position.Local)
                deferred.push(ir_assign(g, ir_global_ref(tid, g, rec.c_spelling, name, rec.slot_form), value))
            }
        }
    }
    deferred
}

// A pure check the header pass can use to decide whether a module needs its init
// function's prototype, without printing a single definition: it answers the same
// Const/not-Const question `cg_decl_emit_globals` answers, over the same scoped list and
// the same lowered inits, but never emits anything.
pub fn cg_decl_has_deferred_global(globals: List[Int], inits: Map[Int, Int]) -> Bool {
    for g in globals {
        let value = inits.get(g) ?? -1
        if value >= 0 && ir_kind(value) != IrKind.Const { return true }
    }
    false
}

// ── Prologue and evidence vector ─────────────────────────────────────────────

// `over_std` is an archive layered over the stdlib archive: it reads std from that
// archive's header and shares its runtime storage, as a user unit does, but every program
// that links it calls into it, so nothing in it is private.
pub fn cg_decl_emit_prologue(user_tu: Bool, over_std: Bool, define_storage: Bool, test_build: Bool, header_guard: Str, self_header: Str, shims_decls_only: Bool) ! Diag.Report {
    unit_linkage = if header_guard != "" || self_header != "" || define_storage || over_std {
        UnitLinkage.AllExternal
    } else if user_tu {
        UnitLinkage.ProgramModuleOnly
    } else {
        UnitLinkage.WholeUnit
    }
    print_prologue(user_tu || over_std, define_storage, test_build, header_guard, self_header, program_native_gates(), shims_decls_only)
    let includes = program_foreign_includes()
    print_foreign_includes(includes.headers, includes.gates)
}

type ForeignIncludes { headers: List[Str], gates: List[Str] }

// Every unit carries every typedef, so every unit reads every header a foreign type names.
// A header named by a native dependency's own module goes under that dependency's gate, the
// way the runtime reads it; named from anywhere else, it is read unconditionally.
fn program_foreign_includes() -> ForeignIncludes {
    let mut headers: List[Str] = []
    let mut gates: List[Str] = []
    // offsetof is a stddef.h macro, and the runtime header does not promise it.
    for decl in cg_reg_type_decls() {
        if c_ffi_struct_original(decl) != "" && headers.is_empty() {
            headers.push("stddef.h")
            gates.push("")
        }
    }
    let mut at: Map[Str, Int] = Map()
    for decl in cg_reg_type_decls() {
        let header = foreign_header_of(decl)
        if header == "" || header == "stddef.h" { continue }
        let dep = stdlib_native_dep_owned_by_source_module(cg_reg_module_of(decl))
        let gate = if dep == "" { "" } else { stdlib_native_dep_gate_macro(dep) }
        let i = at.get(header) ?? -1
        if i < 0 {
            at.insert(header, headers.len())
            headers.push(header)
            gates.push(gate)
        } else if (gates.get(i) ?? "") != gate {
            gates.set(i, "")
        }
    }
    ForeignIncludes { headers: headers, gates: gates }
}

fn foreign_header_of(decl: Int) -> Str {
    let mirror = get_annotation(decl, "ffi.struct")
    if mirror != -1 { return get_str_named_arg(mirror, "header") }
    let opaque = get_annotation(decl, "ffi.opaque")
    if opaque != -1 { return get_str_named_arg(opaque, "header") }
    ""
}

// A unit spells a native dependency's C types in the typedefs it carries, and every unit
// carries every typedef, so the gate follows the program's modules and not the unit that
// holds a binding. A binding written outside the owner over one of the dep's runtime shims
// needs the gate too: the prologue answers for those symbols, and only the gate declares them.
fn program_native_gates() -> List[Str] {
    let mut deps: List[Str] = []
    for m in cg_reg_modules() { deps.push(stdlib_native_dep_owned_by_source_module(m)) }
    for f in cg_reg_fn_decls().append(cg_reg_impl_methods()) {
        let symbol = c_ffi_symbol(f)
        if symbol != "" { deps.push(stdlib_native_dep_name_by_ffi_symbol(symbol)) }
    }
    let mut out: List[Str] = []
    for dep in deps {
        let gate = if dep == "" { "" } else { stdlib_native_dep_gate_macro(dep) }
        if gate != "" && !out.contains(gate) { out.push(gate) }
    }
    out
}

pub fn cg_decl_emit_epilogue(header_guard: Str) {
    print_epilogue(header_guard)
}

// `ev_storage` is the storage class of the one `__blink_ev` the program has: "" for the
// unit that owns it, "static " for a single unit, "extern " for a unit that only refers
// to it.
//
// A user-declared effect takes a slot of its own, after the eight builtin fields. The
// order is the printer's, and it is what lets the stdlib archive be compiled against a
// vector that stops at the builtins and still read the same field at the same offset.
//
// The vtable each slot points at is written first, because the vector names it by value and
// C must have read the typedef by then. A vector that dropped a field would put every later
// field at a different offset, which the archive reads as the field it expected.
pub fn cg_decl_emit_ev(ev_storage: Str) ! Diag.Report {
    let defines_default = ev_storage != "extern "
    let slots = emit_ev_vtables(defines_default)
    if !slots.ok { return }
    print_ev(td_guard_name(c_ev_type_name()), slots.vtables, slots.fields, ev_storage)
    if defines_default { emit_fs_default_bodies(false) }
    emit_io_derived_bodies(false)
}

// The vector of the archive layered over the stdlib archive. A program that links it calls
// the archive's bodies with its own vector, and C checks nothing across the two objects, so
// the archive is the one place the vector is spelled: its header carries the typedef and
// the default for the program to use as they are.
//
// The archive's std.fs_ops functions are its own private copies, so the default FS bodies
// declare them that way.
pub fn cg_decl_emit_ev_owned_by_archive() ! Diag.Report {
    let slots = emit_ev_vtables(true)
    if !slots.ok { return }
    print_ev_with_external_default(td_guard_name(c_ev_type_name()), slots.vtables, slots.fields)
    emit_fs_default_bodies(true)
    emit_io_derived_bodies(true)
}

type EvSlots {
    vtables: List[Str]
    fields: List[Str]
    ok: Bool
}

// The builtin fields, in the order the stdlib archive was compiled against. Only FS's vtable is
// this compiler's to write; the others are the runtime header's.
fn builtin_ev_slots() -> EvSlots {
    let mut vtables: List[Str] = []
    let mut fields: List[Str] = []
    for root in c_builtin_effect_roots() {
        let slot_tid = make_handler_type(root)
        vtables.push(c_vtable_type_name(slot_tid))
        fields.push(c_ev_field_name(slot_tid))
    }
    EvSlots { vtables: vtables, fields: fields, ok: true }
}

fn emit_ev_vtables(defines_default: Bool) -> EvSlots ! Diag.Report {
    let builtins = builtin_ev_slots()
    let mut vtables = builtins.vtables
    let mut fields = builtins.fields
    if !emit_fs_vtable(defines_default) { return EvSlots { vtables: vtables, fields: fields, ok: false } }
    for e in cg_reg_effect_decls() {
        let slot_tid = make_handler_type(node_name(e))
        let vtable = c_vtable_type_name(slot_tid)
        let field = c_ev_field_name(slot_tid)
        if !ev_slot_nameable(e, vtable, field) { return EvSlots { vtables: vtables, fields: fields, ok: false } }
        if emit_effect_vtable(e, slot_tid, vtable) == 0 { return EvSlots { vtables: vtables, fields: fields, ok: false } }
        vtables.push(vtable)
        fields.push(field)
    }
    EvSlots { vtables: vtables, fields: fields, ok: true }
}

// The vector's type and each user effect's vtable type, and nothing that defines storage.
// A per-module header declares every prototype with a `blink_ev*` parameter, so it needs
// the type before them; the default vtables and the vector itself stay in the module
// objects. The object writes the same guarded typedefs again after including the header,
// and the guards make that second copy a no-op.
pub fn cg_decl_emit_ev_typedef() ! Diag.Report {
    let builtins = builtin_ev_slots()
    let mut vtables = builtins.vtables
    let mut fields = builtins.fields
    if !emit_fs_vtable(false) { return }
    for e in cg_reg_effect_decls() {
        let slot_tid = make_handler_type(node_name(e))
        let vtable = c_vtable_type_name(slot_tid)
        let field = c_ev_field_name(slot_tid)
        if !ev_slot_nameable(e, vtable, field) { return }
        if mark_of(vtable_state, vtable) == 1 { return }
        let sig = vtable_sig(e, slot_tid)
        if !sig.ok {
            vtable_state.own.insert(vtable, 1)
            return
        }
        emit_vtable_typedef(vtable, sig)
        vtables.push(vtable)
        fields.push(field)
    }
    print_ev_typedef(td_guard_name(c_ev_type_name()), vtables, fields)
}

fn ev_slot_nameable(effect_decl: Int, vtable: Str, field: Str) -> Bool ! Diag.Report {
    if diag_is_ice_seg(vtable) || diag_is_ice_seg(field) {
        diag_ice_at("EvidenceFieldNotNameable", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "no evidence field for effect `{node_name(effect_decl)}`", effect_decl,
            "every declared effect must name a slot of the evidence vector; this is a compiler bug")
        return false
    }
    true
}

fn fs_handler_tid() -> Int { make_handler_type("FS") }

// FS's vtable, laid out from the std.fs_ops functions that are its operations' defaults: an
// FS operation answers a Result of std.fs types, which only a unit that reads std.fs can
// spell. A program that never loads std.fs_ops gets a vtable of no slots, and one that does
// gets every slot. The vector is one ABI across the units of a program, so an archive that
// defines its default for other units always loads std.fs_ops (build_compiler_archive).
//
// The unit that defines the vector's default also declares each default body and the
// default instance here, ahead of the vector that takes its address. The bodies call the
// std.fs_ops functions with the vector, so they come after it, from emit_fs_default_bodies.
//
// Answers false when a name this stage cannot spell stopped it, as emit_effect_vtable does.
fn emit_fs_vtable(defines_default: Bool) -> Bool ! Diag.Report {
    let slot_tid = fs_handler_tid()
    let vtable = c_vtable_type_name(slot_tid)
    if mark_of(vtable_state, vtable) == 1 { return false }
    let sig = fs_vtable_sig(slot_tid)
    if !sig.ok {
        vtable_state.own.insert(vtable, 1)
        return false
    }
    emit_vtable_typedef(vtable, sig)
    if !defines_default { return true }
    let mut i = 0
    while i < sig.slots.len() {
        print_vtable_slot_fn_decl(sig.rets.get(i).unwrap(), sig.defaults.get(i).unwrap(), sig.params.get(i).unwrap())
        i = i + 1
    }
    print_effect_default_vtable(vtable, sig.defaults)
    true
}

// Each FS default body hands its arguments and the program's one vector to the std.fs_ops
// function the operation names. `private` says the unit holds those functions as internal
// copies, so the prototypes here agree with the definitions on linkage.
fn emit_fs_default_bodies(private: Bool) ! Diag.Report {
    let slot_tid = fs_handler_tid()
    if mark_of(vtable_state, c_vtable_type_name(slot_tid)) == 1 { return }
    let sig = fs_vtable_sig(slot_tid)
    if !sig.ok { return }
    let decls = fs_op_decls()
    for d in decls { cg_decl_emit_fn_decl(d, private) }
    let track = ir_sources_pause()
    let mut i = 0
    while i < decls.len() {
        let ret = sig.rets.get(i).unwrap()
        print_vtable_slot_fn(ret, sig.defaults.get(i).unwrap(), sig.params.get(i).unwrap(),
            std_forwarding_body(decls.get(i).unwrap(), ret))
        i = i + 1
    }
    ir_sources_resume(track)
}

// The derived slots of a unit that reads the vector's typedef and default from the archive
// layered over the stdlib archive. That header does not carry them, and the std.io_read
// bodies they call are the stdlib archive's.
pub fn cg_decl_emit_io_derived_bodies() ! Diag.Report { emit_io_derived_bodies(false) }

// The slot a handler literal points an omitted IO.Read derived operation at: a function that
// runs the std.io_read body with the program's vector, so the body's io.read_bytes reaches the
// handler installed at the time of the call. The literal names it from any unit that builds a
// handler, so every unit that spells the vector holds its own static copy.
fn emit_io_derived_bodies(private: Bool) ! Diag.Report {
    let slot_tid = make_handler_type("IO")
    let mut decls: List[Int] = []
    let mut symbols: List[Str] = []
    for op in io_read_ops() {
        if !is_io_read_derived_op(op) { continue }
        // A program with no handler of IO or IO.Read does not load std.io_read.
        let decl = cg_reg_io_derived_decl(op)
        if decl < 0 { continue }
        let symbol = c_builtin_derived_op_name(slot_tid, op)
        if diag_is_ice_seg(symbol) {
            diag_ice_at("IoDerivedBodyNotNameable", UNSOLVED_TYPEVAR_AT_CODEGEN,
                "no slot function name for IO.Read operation `{op}`", decl,
                "IO is a builtin root the runtime owns, so its derived slot names are fixed; this is a compiler bug")
            return
        }
        decls.push(decl)
        symbols.push(symbol)
    }
    for d in decls { cg_decl_emit_fn_decl(d, private) }
    let track = ir_sources_pause()
    let mut i = 0
    while i < decls.len() {
        let decl = decls.get(i).unwrap()
        let ret = op_ret_spelling(decl)
        print_vtable_slot_fn(ret, symbols.get(i).unwrap(), fn_param_decls(decl), std_forwarding_body(decl, ret))
        i = i + 1
    }
    ir_sources_resume(track)
}

fn fs_op_decls() -> List[Int] {
    let mut out: List[Int] = []
    for op in cg_reg_fs_ops() { out.push(cg_reg_fs_op_decl(op)) }
    out
}

fn fs_vtable_sig(slot_tid: Int) -> VtableSig ! Diag.Report {
    let ops = cg_reg_fs_ops()
    let decls = fs_op_decls()
    let mut i = 0
    while i < decls.len() {
        if decls.get(i).unwrap() < 0 {
            diag_ice("FsDefaultBodyNotLoaded", UNSOLVED_TYPEVAR_AT_CODEGEN,
                "no std.fs_ops default body for FS operation `{ops.get(i).unwrap()}`", 0, 0,
                "a program that loads std.fs_ops holds every FS default, so a missing one is a compiler bug")
            return VtableSig { slots: [], rets: [], params: [], defaults: [], ok: false }
        }
        i = i + 1
    }
    vtable_sig_over("FS", slot_tid, ops, decls)
}

// A slot function's body: its arguments and the program's one vector, handed to the std
// function that holds the operation's Blink body.
fn std_forwarding_body(decl: Int, ret: Str) -> Int ! Diag.Report {
    let mut args: List[Int] = []
    let sl = node_params(decl)
    let mut i = 0
    while sl != -1 && i < sublist_length(sl) {
        let p = sublist_get(sl, i)
        let ptid = tid_of_node(p)
        let rec = layout_of(ptid, Position.Param)
        args.push(ir_var_ref(ptid, decl, rec.c_spelling, c_local_name(node_name(p)), rec.slot_form))
        i = i + 1
    }
    args.push(ir_evidence_address(decl, ir_evidence_vector(decl, c_ev_type_name(), c_ev_global_name(), SlotForm.Inline)))
    let ret_tid = fn_ret_tid(decl)
    let call = ir_call_direct(ret_tid, decl, ret, cg_decl_c_name(decl), layout_of(ret_tid, Position.Return).slot_form, args)
    ir_block(decl, [ir_return(decl, call)])
}

// One root effect's vtable struct, a default body per operation, and the default instance the
// evidence vector takes the address of.
//
// The whole root is one struct, because a handler for one sub-effect copies the instance and
// overwrites only the slots it names; a struct sized to that sub-effect would drop the rest.
// Each operation also owns a capture word, so an operation the inner handler left alone reads
// the captures of the handler that did define it.
//
// Every name and every signature is read before anything is written. Two reasons: reading a
// signature can write a member typedef, and a typedef opened inside the struct would nest one
// declaration in another; and a name this stage cannot spell must stop it before the typedef
// lands, or the unit carries a vtable type whose instance nothing defines.
//
// Answers 0 when it wrote nothing, so the caller leaves the effect out of the vector rather
// than pointing a field at an instance that is not there.
fn emit_effect_vtable(effect_decl: Int, slot_tid: Int, vtable: Str) -> Int ! Diag.Report {
    // A gap this vtable already reported is not reported again: the type graph may have
    // reached the same effect from a handler field, and one gap is one report.
    if mark_of(vtable_state, vtable) == 1 { return 0 }
    let sig = vtable_sig(effect_decl, slot_tid)
    if !sig.ok {
        vtable_state.own.insert(vtable, 1)
        return 0
    }
    emit_vtable_typedef(vtable, sig)
    // Every unit prints these bodies, and their C comes from the operations' names and types,
    // never from a position. The emit record keys those on the effect item, whose every change
    // takes no unit, and on the types header. Marking the declaring source here would make
    // every unit read it, so a body edit beside the effect would emit every unit again.
    let track = ir_sources_pause()
    let ops = cg_reg_effect_ops(effect_decl)
    let mut i = 0
    while i < ops.len() {
        let op = ops.get(i).unwrap()
        // A derived operation's default is its declared body. That body may call anything
        // the program declares, so only its prototype goes here, ahead of the instance, and
        // the definition half writes it from cg_decl_derived_slots.
        if node_body(op) != -1 {
            print_vtable_slot_fn_decl(sig.rets.get(i).unwrap(), sig.defaults.get(i).unwrap(), sig.params.get(i).unwrap())
        } else {
            print_vtable_slot_fn(sig.rets.get(i).unwrap(), sig.defaults.get(i).unwrap(), sig.params.get(i).unwrap(),
                default_op_body(op, sig.rets.get(i).unwrap()))
        }
        i = i + 1
    }
    ir_sources_resume(track)
    print_effect_default_vtable(vtable, sig.defaults)
    vtable_state.own.insert(vtable, 3)
    1
}

// One derived operation whose default this unit declared, with the spellings its definition
// must repeat.
pub type DerivedSlot {
    op: Int
    ret: Str
    symbol: Str
    params: List[Str]
}

// Every derived operation of the effects whose defaults this unit has declared. Each unit
// keeps its own static copy, as it does every other default body.
pub fn cg_decl_derived_slots() -> List[DerivedSlot] ! Diag.Report {
    let mut out: List[DerivedSlot] = []
    for e in cg_reg_effect_decls() {
        let ops = cg_reg_effect_ops(e)
        if !has_derived_op(ops) { continue }
        let slot_tid = make_handler_type(node_name(e))
        if mark_of(vtable_state, c_vtable_type_name(slot_tid)) != 3 { continue }
        let sig = vtable_sig(e, slot_tid)
        let mut i = 0
        while i < ops.len() {
            let op = ops.get(i).unwrap()
            if node_body(op) != -1 {
                out.push(DerivedSlot { op: op, ret: sig.rets.get(i).unwrap(), symbol: sig.defaults.get(i).unwrap(), params: sig.params.get(i).unwrap() })
            }
            i = i + 1
        }
    }
    out
}

fn has_derived_op(ops: List[Int]) -> Bool {
    for op in ops {
        if node_body(op) != -1 { return true }
    }
    false
}

// The typedef alone, written once per unit. Both readers of `vtable_state` come through
// here, so whichever reaches the effect first writes it and the other one does not.
fn emit_vtable_typedef(vtable: Str, sig: VtableSig) ! Diag.Report {
    if mark_of(vtable_state, vtable) >= 2 { return }
    vtable_state.own.insert(vtable, 2)
    let mut userdata: List[Str] = []
    for slot in sig.slots { userdata.push(c_vtable_userdata_member(slot)) }
    print_effect_vtable_typedef(td_guard_name(vtable), vtable, sig.slots, userdata, sig.rets, sig.params)
}

// One root effect's vtable, as the slot name, return spelling, parameter list and default
// body symbol of each operation, in the order the sub-effects and their operations are
// written. `ok` is false when a name this stage cannot spell stopped it, and the caller must
// then write nothing at all: a unit carrying a vtable type whose instance nothing defines is
// worse than a unit that reported the gap.
type VtableSig {
    slots: List[Str]
    rets: List[Str]
    params: List[List[Str]]
    defaults: List[Str]
    ok: Bool
}

fn vtable_sig(effect_decl: Int, slot_tid: Int) -> VtableSig ! Diag.Report {
    let ops = cg_reg_effect_ops(effect_decl)
    let mut names: List[Str] = []
    for op in ops { names.push(node_name(op)) }
    vtable_sig_over(node_name(effect_decl), slot_tid, names, ops)
}

// The signature of operation `names[i]` is read off the function `sigs[i]`: the operation's
// own declaration for a user effect, the std.fs_ops default for FS.
fn vtable_sig_over(effect_name: Str, slot_tid: Int, names: List[Str], sigs: List[Int]) -> VtableSig ! Diag.Report {
    let mut slots: List[Str] = []
    let mut rets: List[Str] = []
    let mut params: List[List[Str]] = []
    let mut defaults: List[Str] = []
    let mut i = 0
    while i < names.len() {
        let name = names.get(i).unwrap()
        let op = sigs.get(i).unwrap()
        i = i + 1
        // The slot is a struct member, so it takes the member-name producer. The perform site
        // reads the slot by name and must ask the same producer, or an operation whose name C
        // owns is written one way here and read another way there.
        let slot = c_effect_vtable_slot_name(slot_tid, name)
        // The sub-effects share the one struct, so two operations of one name would be two
        // members of that name and two definitions of one static. C rejects both with no span
        // that points back at the declaration, so the stop is reported here with one.
        if slots.contains(slot) {
            diag_ice_at("EffectOperationNameRepeated", UNSOLVED_TYPEVAR_AT_CODEGEN,
                "effect `{effect_name}` declares operation `{name}` more than once", op,
                "the operations under one root effect share a vtable, so their names must differ; the declaration should have been rejected before codegen")
            return VtableSig { slots: slots, rets: rets, params: params, defaults: defaults, ok: false }
        }
        let symbol = c_effect_default_op_name(slot_tid, name)
        if diag_is_ice_seg(symbol) {
            diag_ice_at("EffectDefaultBodyNotNameable", UNSOLVED_TYPEVAR_AT_CODEGEN,
                "no default body name for operation `{name}` of effect `{effect_name}`", op,
                "a declared effect that is not builtin names a default body per operation; this is a compiler bug")
            return VtableSig { slots: slots, rets: rets, params: params, defaults: defaults, ok: false }
        }
        emit_signature_deps(op)
        slots.push(slot)
        rets.push(op_ret_spelling(op))
        params.push(fn_param_decls(op))
        defaults.push(symbol)
    }
    VtableSig { slots: slots, rets: rets, params: params, defaults: defaults, ok: true }
}

// The nominal types one signature names by value, emitted before the declaration that
// spells them. The vtable typedef names an operation's by-value parameter inside itself, and
// the type graph can reach that typedef from a handler field before the declaration walk has
// reached the parameter's own type.
fn emit_signature_deps(fn_node: Int) ! Diag.Report {
    for dep in nominal_deps(fn_ret_tid(fn_node)) { emit_dep(dep) }
    let sl = node_params(fn_node)
    if sl == -1 { return }
    let mut i = 0
    while i < sublist_length(sl) {
        for dep in nominal_deps(tid_of_node(sublist_get(sl, i))) { emit_dep(dep) }
        i = i + 1
    }
}

// The C type a vtable slot answers with. The handler thunk and the perform site spell the
// same tid at the same position, so all three agree on the slot's type by construction.
fn op_ret_spelling(op: Int) -> Str ! Diag.Report {
    let tid = fn_ret_tid(op)
    flush_member_typedefs(tid)
    cg_decl_require_spelling(tid, Position.VtableSlot)
}

// What an operation gives back when the program installs no handler for its effect.
//
// The value has to be one the caller can act on with no further knowledge, so it is the empty
// or failed value of the operation's own return type, never memory nobody wrote.
//
// A Result answers its error side. Zeroing the carrier would set tag 0, which is Ok, and hand
// the caller a success holding a payload the program never produced.
//
// A list answers an empty list. The handle is a pointer the caller reads through at once, and
// a zero of it is the address the first read would take.
//
// Everything else answers a zero of its own type, written as a compound literal so a number, a
// pointer, a carrier and a by-value struct all take the one rule. An Option zeroes to tag 0,
// which is None, so it needs no arm of its own.
//
// An operation that returns nothing has nothing to give back. The test is the one the foreign
// wrapper uses to decide the same thing, or the two could disagree on what `void` covers.
fn default_op_body(op: Int, ret: Str) -> Int ! Diag.Report {
    let tid = fn_ret_tid(op)
    let k = tc_tid_kind(tc_resolve(tid))
    if k == TyKind.Void || k == TyKind.Never { return ir_block(op, []) }
    if k == TyKind.Result {
        return ir_block(op, [ir_return(op, ir_const(tid, op, ret, "({ret})\{ .{c_enum_tag_member()} = 1 }"))])
    }
    if k == TyKind.List {
        return ir_block(op, [ir_return(op, ir_const(tid, op, ret, "blink_list_new()"))])
    }
    ir_block(op, [ir_return(op, ir_const(tid, op, ret, "({ret})\{0}"))])
}
