// cg_derive.bl: the method bodies @derive writes, and the key-operations tables a Map
// or Set binds for a derived key.
//
// A derived method has no function declaration in the source, so this stage builds its
// body as typed IR and hands it to the printer itself. Every type spelling comes from
// layout_of and every symbol from cname; nothing here writes a C type.
//
// A field this stage cannot compare is an internal error, never a skipped field. The
// pre-rewrite emitter dropped a field it had no rule for, which made two unequal values
// answer equal: a wrong answer that compiles cleanly.

import diagnostics.{
    Diag, diag_ice_at, diag_ice_stage_not_built, UNSOLVED_TYPEVAR_AT_CODEGEN,
}
import layout.{
    LayoutRecord, Position, SlotForm, decl_derive_args, ensure_typedef_for, field_layout_of,
    format_spec_of, layout_of, tid_is_opaque_handle, varargs_spelling, enum_tag_tid,
}
import cname.{
    c_derive_method_name, c_field_name, c_mint_local, c_runtime_helper, c_string_literal,
    c_tid_derive_method_name, c_tuple_member,
    c_variant_discriminant, c_enum_tag_member, c_enum_payload_member,
}
import cg_print.{print_fn, print_fn_decl, print_kops_table, print_kops_table_decl}
import cg_reg.{cg_reg_tid_for_decl}
import ir.{
    ir_assign, ir_binary, ir_block, ir_call_direct, ir_call_runtime, ir_cast, ir_const,
    ir_field_get, ir_if, ir_let, ir_panic, ir_return, ir_switch, ir_unary, ir_var_ref,
}
import typecheck.{
    DECL_NODE_AMBIGUOUS, TYPE_BOOL, TYPE_CHAR, TYPE_INT, TYPE_STR, TYPE_U64, TyKind, lookup_named_type,
    tc_decl_derives, tc_enum_variant_slots,
    tc_evar_field_slots, tc_evar_name, tc_evfield_name, tc_evfield_tid, tc_resolve,
    tc_lookup_node_tid, tc_sfield_name, tc_sfield_tid, tc_struct_field_slots,
    tc_tid_child, tc_tid_child_count, tc_tid_decl_node, tc_tid_kind, tc_tid_resolved,
    tc_type_str, tk_name,
}
import parser.{
    node_count, node_name, node_fields, node_source_module, node_type_params, sublist_get,
    sublist_length,
}

// The two members a tagged enum's typedef declares. Member names, not type spellings;
// the typedef emitter writes the same two names.

// The derive names, held as data so no branch here compares against a literal.
let derive_eq = "Eq"
let derive_ord = "Ord"
let derive_debug = "Debug"
let derive_hash = "Hash"
let derive_clone = "Clone"

// The two words a Bool renders as. They are the Display of a Bool, not C text, and the
// runtime holds the same pair in blink_sb_write_bool.
let bool_true = "true"
let bool_false = "false"

// A declaration may write the same derive twice, in one annotation or in two, so a pass
// records the pairs it has answered. Keyed on the declaration and the derive name: on the
// declaration alone one type's second derive would be dropped, and on the symbol alone
// two declarations that collided on one symbol would lose a body.
let mut written: Map[Str, Int] = Map()

// The same record for the methods a structural key needs, keyed on the symbol because a
// tuple has no declaration to key on. Held apart from `written` so a symbol can never
// answer for a declaration's derive, and holding 1 for a pair this pass wrote and 0 for a
// pair it refused: an element's refusal must reach the table that would have named it.
let mut tuple_methods_done: Map[Str, Int] = Map()

pub fn cg_derive_reset() {
    written = Map()
    tuple_methods_done = Map()
}

fn already_written(decl: Int, name: Str) -> Bool {
    let key = "{decl}|{name}"
    if written.contains_key(key) != 0 { return true }
    written.insert(key, 1)
    false
}

// ── The passes the driver runs ────────────────────────────────────────────

// Both passes walk the type declarations the driver hands them rather than the whole
// registry. Which declarations belong to a translation unit is the driver's rule, and it
// already applies that rule to every other declaration; a second copy of it here would be
// a second producer of the same fact.

// Every derived method, declared. A type declared after the type that compares it
// would otherwise be called before the C compiler has seen its definition.
pub fn cg_derive_emit_decls(decls: List[Int]) ! Diag.Report {
    derive_walk(decls, false)
    key_table_decls()
}

pub fn cg_derive_emit_bodies(decls: List[Int]) ! Diag.Report {
    derive_walk(decls, true)
}

fn derive_walk(decls: List[Int], bodies: Bool) ! Diag.Report {
    written = Map()
    tuple_methods_done = Map()
    for decl in decls {
        for arg in decl_derive_args(decl) { derive_one(decl, arg, bodies) }
    }
}

fn derive_one(decl: Int, arg: Int, bodies: Bool) ! Diag.Report {
    let name = node_name(arg)
    // Whether the name is one @derive accepts is typecheck's answer, given before any
    // stage of codegen runs. What is left here is the name this stage has not built.
    if already_written(decl, name) { return }
    if name == derive_eq { return eq_method(decl, arg, bodies) }
    if name == derive_ord { return ord_method(decl, arg, bodies) }
    if name == derive_debug { return debug_method(decl, arg, bodies) }
    if name == derive_hash { return hash_method(decl, arg, bodies) }
    if name == derive_clone { return clone_method(decl, arg, bodies) }
    not_built(arg, "@derive({name})")
}

fn has_str(names: List[Str], want: Str) -> Bool {
    for n in names { if n == want { return true } }
    false
}

// ── Refusals ─────────────────────────────────────────────────────────────

fn not_built(node: Int, what: Str) ! Diag.Report {
    diag_ice_stage_not_built("cg_derive for {what}", node)
}

// A refusal, reported. An empty reason means the derive may go ahead. Every derive asks
// the same way, so one place decides whether a body may be written.
fn refused(refusal: Str, node: Int) -> Bool ! Diag.Report {
    if refusal == "" { return false }
    not_built(node, refusal)
    true
}

// The type id of the declaration a derive is written on. Every derive needs it before it
// can ask layout anything, and a declaration that reached this stage without one is a
// compiler bug rather than an author's mistake.
fn derive_tid(decl: Int, node: Int) -> Int ! Diag.Report {
    let tid = cg_reg_tid_for_decl(decl)
    if tid < 0 {
        derive_ice(node, "type '{node_name(decl)}' reached cg_derive with no type id")
        return -1
    }
    tid
}

fn derive_ice(node: Int, message: Str) ! Diag.Report {
    diag_ice_at("DeriveBodyNotBuildable", UNSOLVED_TYPEVAR_AT_CODEGEN, message, node,
        "every type that reaches code generation must be concrete and nameable; this is a compiler bug")
}

// A declined layout has no spelling at all. Writing a default here would compile and
// then get the comparison wrong at run time.
fn spelling_or_ice(rec: LayoutRecord, what: Str, node: Int) -> Str ! Diag.Report {
    let reason = rec.decline_reason
    if reason == "" { return rec.c_spelling }
    diag_ice_at("DeriveBodyNotBuildable", UNSOLVED_TYPEVAR_AT_CODEGEN,
        "no C spelling for {what}: {reason}", node,
        "every type that reaches code generation must be concrete and nameable; this is a compiler bug")
    ""
}

fn bool_spelling(node: Int) -> Str ! Diag.Report {
    spelling_or_ice(layout_of(TYPE_BOOL, Position.Return), "Bool", node)
}

fn int_spelling(node: Int) -> Str ! Diag.Report {
    spelling_or_ice(layout_of(TYPE_INT, Position.Field), "Int", node)
}

// How a slot holds an Int is layout's answer, the same as for every other type.
fn int_form() -> SlotForm {
    layout_of(TYPE_INT, Position.Field).slot_form
}

// ── Eq ───────────────────────────────────────────────────────────────────

// ── What a declaration's own shape refuses ───────────────────────────────

// Why this stage writes no body for a type, or "" when it writes one. Both the field
// reader and the method writer ask, because a field is rendered or compared by calling
// the type's own method, and a call to a method nobody writes is an undefined symbol at
// link time. The two refusals are facts about the declaration, so every derive shares
// them: an opaque handle exposes no fields at all, and a generic type has one body per
// instance rather than one body.
fn shape_refusal(decl: Int, tid: Int, derive: Str) -> Str {
    if tid_is_opaque_handle(tid) {
        return "@derive({derive}) on the opaque handle '{node_name(decl)}', which exposes no fields"
    }
    let tparams = node_type_params(decl)
    if tparams != -1 && sublist_length(tparams) > 0 {
        return "@derive({derive}) on the generic type '{node_name(decl)}'"
    }
    ""
}

// Whether this stage may read a field at all, recorded once. A declined layout has no
// spelling. A boxed field is an opaque word holding a heap pointer, and every derive that
// walks fields has to read through that pointer to answer, which this stage does not do.
// The caller passes the field layout and asks before it builds anything, because Eq names
// one field twice, once on each side of the comparison: asked twice it would record the
// same refusal twice, and a count of refusals could no longer tell one gap from two.
fn field_refused(frec: LayoutRecord, path: Str, derive: Str, span: Int) -> Bool ! Diag.Report {
    let reason = frec.decline_reason
    if reason != "" {
        diag_ice_at("DeriveBodyNotBuildable", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "no C spelling for field '{path}': {reason}", span,
            "every type that reaches code generation must be concrete and nameable; this is a compiler bug")
        return true
    }
    if frec.slot_form == SlotForm.PointerBoxed {
        not_built(span, "@derive({derive}) on the boxed field '{path}'")
        return true
    }
    false
}

// The value of one field of `self` or `other`, or -1 after a refusal.
fn field_value(owner_tid: Int, ftid: Int, path: Str, holder: Str, derive: Str, span: Int) -> Int ! Diag.Report {
    let frec = field_layout_of(owner_tid, ftid)
    if field_refused(frec, path, derive, span) { return -1 }
    field_ref(owner_tid, holder, Position.Param, ftid, frec, path, span)
}

// One case per variant, in the order the switch kids alternate: the tag label, then the
// block the named derive builds for that variant. Eq, Ord, Debug and Hash differ only in
// that block. Four copies of the label half could become different while each copy still
// passed its own tests, and a label that names the wrong variant reads a payload through
// the wrong tag. An empty answer means a refusal was recorded.
fn variant_cases(decl: Int, tid: Int, slots: List[Int], ints: Str, derive: Str, acc: Str, span: Int) -> List[Int] ! Diag.Report {
    let mut cases: List[Int] = []
    let mut i = 0
    while i < slots.len() {
        let slot = slots.get(i).unwrap()
        let vnode = variant_decl_node(decl, slot, i, span)
        if vnode < 0 { return [] }
        let body = variant_block(decl, tid, slot, derive, acc, span)
        if body < 0 { return [] }
        cases.push(ir_const(TYPE_INT, span, ints, c_variant_discriminant(tid, vnode)))
        cases.push(body)
        i = i + 1
    }
    cases
}

// The block one derive builds for one variant. `acc` is the local the derive builds its
// answer in, which only Hash has. Eq, Ord and Debug answer from the block itself, so they
// pass an empty name they never read. A derive with no builder here is refused. A last branch
// that accepted any name would hand one derive another derive's block, which compiles and
// then answers wrongly.
fn variant_block(decl: Int, tid: Int, slot: Int, derive: Str, acc: Str, span: Int) -> Int ! Diag.Report {
    if derive == derive_eq { return eq_variant_block(decl, tid, slot, span) }
    if derive == derive_ord { return cmp_variant_block(decl, tid, slot, span) }
    if derive == derive_debug { return debug_variant_block(decl, tid, slot, span) }
    if derive == derive_hash { return hash_variant_block(decl, tid, slot, acc, span) }
    derive_ice(span, "no per-variant block for @derive({derive})")
    -1
}

// The declaration node of the variant a registered entry describes. The tag label comes
// from the declaration node and the payload from the registered entry, so if the two
// orders ever diverged both halves would move into the same wrong variant, which reads a
// payload through the wrong tag.
fn variant_decl_node(decl: Int, slot: Int, index: Int, span: Int) -> Int ! Diag.Report {
    let vnode = variant_node(decl, index)
    if vnode < 0 {
        derive_ice(span, "variant {index} of '{node_name(decl)}' has no declaration node")
        return -1
    }
    if tc_evar_name(slot) != node_name(vnode) {
        derive_ice(span, "variant {index} of '{node_name(decl)}' is registered as '{tc_evar_name(slot)}' but declared as '{node_name(vnode)}'")
        return -1
    }
    vnode
}

fn eq_method(decl: Int, arg: Int, bodies: Bool) ! Diag.Report {
    let tid = derive_tid(decl, arg)
    if tid < 0 { return }
    if refused(shape_refusal(decl, tid, derive_eq), arg) { return }
    let self_spelling = spelling_or_ice(layout_of(tid, Position.Param), node_name(decl), arg)
    let ret = bool_spelling(arg)
    if self_spelling == "" || ret == "" { return }
    let symbol = c_derive_method_name(decl, "eq")
    let params = ["{self_spelling} self", "{self_spelling} other"]
    if !bodies { return print_fn_decl(false, ret, symbol, params, false) }
    let body = eq_body(decl, tid, arg)
    if body < 0 { return }
    print_fn(false, ret, symbol, params, false, body)
}

// A value layout gives as one word is its own whole value, so it compares as a word and
// has no member to read: an ordinal enum and a transparent newtype both land here, and
// asking layout is what keeps this stage from deciding the shape for itself.
fn eq_body(decl: Int, tid: Int, span: Int) -> Int ! Diag.Report {
    let rec = layout_of(tid, Position.Param)
    if rec.slot_form == SlotForm.InlineWord { return eq_word_body(tid, span) }
    let k = tc_tid_kind(tc_resolve(tid))
    if k == TyKind.Struct { return eq_struct_body(decl, tid, span) }
    if k == TyKind.Enum { return eq_enum_body(decl, tid, span) }
    not_built(span, "@derive(Eq) on a {tk_name(k)} type")
    -1
}

// Each field guards the answer: the first field that differs answers false, and
// reaching the end means every field agreed.
fn eq_struct_body(decl: Int, tid: Int, span: Int) -> Int ! Diag.Report {
    let mut stmts: List[Int] = []
    for slot in tc_struct_field_slots(tid) {
        let guard = eq_guard(tid, tc_sfield_tid(slot), c_field_name(tc_sfield_name(slot)), span)
        if guard < 0 { return -1 }
        stmts.push(guard)
    }
    let agreed = eq_answer(span, "1")
    if agreed < 0 { return -1 }
    stmts.push(agreed)
    ir_block(span, stmts)
}

// An enum with a payload must agree on the tag before it reads the union: reading a
// payload through the wrong variant is undefined.
fn eq_enum_body(decl: Int, tid: Int, span: Int) -> Int ! Diag.Report {
    let slots = tc_enum_variant_slots(tid)
    if slots.len() == 0 {
        derive_ice(span, "enum '{node_name(decl)}' reached cg_derive with no variants")
        return -1
    }
    let ints = int_spelling(span)
    let bools = bool_spelling(span)
    if ints == "" || bools == "" { return -1 }
    let self_tag = tag_ref(tid, "self", Position.Param, ints, span)
    let other_tag = tag_ref(tid, "other", Position.Param, ints, span)
    let switch_tag = tag_ref(tid, "self", Position.Param, ints, span)
    let mismatch = eq_false_block(span)
    let unknown = eq_false_block(span)
    if self_tag < 0 || other_tag < 0 || switch_tag < 0 || mismatch < 0 || unknown < 0 { return -1 }
    let differs = ir_binary(TYPE_BOOL, span, bools, "!=", self_tag, other_tag)
    let guard = ir_if(span, differs, mismatch, -1)
    let cases = variant_cases(decl, tid, slots, ints, derive_eq, "", span)
    if cases.len() == 0 { return -1 }
    ir_block(span, [guard, ir_switch(span, switch_tag, cases, unknown)])
}

fn eq_word_body(tid: Int, span: Int) -> Int ! Diag.Report {
    let bools = bool_spelling(span)
    let lhs = value_ref(tid, "self", Position.Param, span)
    let rhs = value_ref(tid, "other", Position.Param, span)
    if bools == "" || lhs < 0 || rhs < 0 { return -1 }
    ir_block(span, [ir_return(span, ir_binary(TYPE_BOOL, span, bools, "==", lhs, rhs))])
}

fn eq_variant_block(decl: Int, tid: Int, slot: Int, span: Int) -> Int ! Diag.Report {
    let vname = tc_evar_name(slot)
    let mut stmts: List[Int] = []
    for f in tc_evar_field_slots(slot) {
        let path = "{c_enum_payload_member()}.{vname}.{c_field_name(tc_evfield_name(f))}"
        let guard = eq_guard(tid, tc_evfield_tid(f), path, span)
        if guard < 0 { return -1 }
        stmts.push(guard)
    }
    let agreed = eq_answer(span, "1")
    if agreed < 0 { return -1 }
    stmts.push(agreed)
    ir_block(span, stmts)
}

// A variant's declaration node, for the tag macro cname spells. The variant entries
// typecheck registered are in declaration order, so they line up by index.
fn variant_node(decl: Int, index: Int) -> Int {
    let vars = node_fields(decl)
    if vars == -1 || index >= sublist_length(vars) { return -1 }
    sublist_get(vars, index)
}

// ── One field's comparison ───────────────────────────────────────────────

fn eq_answer(span: Int, literal: Str) -> Int ! Diag.Report {
    let bools = bool_spelling(span)
    if bools == "" { return -1 }
    ir_return(span, ir_const(TYPE_BOOL, span, bools, literal))
}

// What a guard runs when a comparison differs, and what the switch runs for a tag no
// variant claims: both answer false.
fn eq_false_block(span: Int) -> Int ! Diag.Report {
    let answer = eq_answer(span, "0")
    if answer < 0 { return -1 }
    ir_block(span, [answer])
}

fn eq_guard(owner_tid: Int, ftid: Int, path: Str, span: Int) -> Int ! Diag.Report {
    let differs = eq_differs(owner_tid, ftid, path, span)
    let answer = eq_false_block(span)
    if differs < 0 || answer < 0 { return -1 }
    ir_if(span, differs, answer, -1)
}

fn eq_differs(owner_tid: Int, ftid: Int, path: Str, span: Int) -> Int ! Diag.Report {
    let bools = bool_spelling(span)
    if bools == "" { return -1 }
    let frec = field_layout_of(owner_tid, ftid)
    if field_refused(frec, path, derive_eq, span) { return -1 }
    let lhs = field_ref(owner_tid, "self", Position.Param, ftid, frec, path, span)
    let rhs = field_ref(owner_tid, "other", Position.Param, ftid, frec, path, span)
    if lhs < 0 || rhs < 0 { return -1 }
    let k = tc_tid_kind(tc_resolve(ftid))
    // A Str is a pointer, so == would compare addresses rather than bytes.
    if k == TyKind.Str { return eq_helper_differs("str_eq", lhs, rhs, bools, span) }
    // A Float's equality is total, and C's != is not: it answers true for two NaNs.
    if k == TyKind.Float { return eq_helper_differs("float_eq", lhs, rhs, bools, span) }
    if eq_is_scalar(k) { return ir_binary(TYPE_BOOL, span, bools, "!=", lhs, rhs) }
    if k == TyKind.Struct || k == TyKind.Enum {
        return eq_nested_differs(ftid, lhs, rhs, bools, path, span)
    }
    // A tuple element is compared by the element tuple's own method, which this stage
    // writes from the type rather than from a declaration the tuple does not have.
    if k == TyKind.Tuple {
        return eq_call_differs(c_tid_derive_method_name(tc_resolve(ftid), "eq"), lhs, rhs, bools, span)
    }
    not_built(span, "@derive(Eq) on the {tk_name(k)} field '{path}'")
    -1
}

// A nested type is compared by its own derived method, so the comparison stays one
// call deep however far the nesting goes.
fn eq_nested_differs(ftid: Int, lhs: Int, rhs: Int, bools: Str, path: Str, span: Int) -> Int ! Diag.Report {
    let fdecl = tc_tid_decl_node(ftid)
    if fdecl < 0 || fdecl == DECL_NODE_AMBIGUOUS {
        derive_ice(span, "field type {ftid} has no unambiguous declaration to compare through")
        return -1
    }
    if !defines_eq(fdecl) {
        not_built(span, "@derive(Eq) on a field whose type '{node_name(fdecl)}' implements Eq by hand")
        return -1
    }
    let refusal = shape_refusal(fdecl, ftid, derive_eq)
    if refusal != "" {
        not_built(span, "{refusal}, which the field '{path}' would have to call")
        return -1
    }
    eq_call_differs(c_derive_method_name(fdecl, "eq"), lhs, rhs, bools, span)
}

// Whether two values differ, when a derived method answers whether they are equal.
fn eq_call_differs(symbol: Str, lhs: Int, rhs: Int, bools: Str, span: Int) -> Int ! Diag.Report {
    ir_unary(TYPE_BOOL, span, bools, "!",
        ir_call_direct(TYPE_BOOL, span, bools, symbol, SlotForm.InlineWord, [lhs, rhs]))
}

// Whether a declaration's derives write it an eq. Ord and Hash both have Eq for a
// supertrait and this stage derives it, so either one writes an eq. Which derives oblige
// which is typecheck's answer, not a second list here: the front end decides whether a
// type has an equality at all, and a stage that disagreed would refuse what it admits.
fn defines_eq(decl: Int) -> Bool {
    tc_decl_derives(decl, derive_eq) != 0
}

fn derive_names(decl: Int) -> List[Str] {
    let mut out: List[Str] = []
    for a in decl_derive_args(decl) { out.push(node_name(a)) }
    out
}

// One whole value of the derived type, named by its C variable. The caller says which
// position layout is to spell it at rather than this reader choosing one, because a value
// declared at one position and read at another would be spelled two ways the moment layout
// gives the two positions different answers.
fn value_ref(owner_tid: Int, name: Str, at_pos: Position, span: Int) -> Int ! Diag.Report {
    let rec = layout_of(owner_tid, at_pos)
    let spelling = spelling_or_ice(rec, "the value '{name}'", span)
    if spelling == "" { return -1 }
    ir_var_ref(owner_tid, span, spelling, name, rec.slot_form)
}

fn tag_ref(owner_tid: Int, name: Str, at_pos: Position, ints: Str, span: Int) -> Int ! Diag.Report {
    let base = value_ref(owner_tid, name, at_pos, span)
    if base < 0 { return -1 }
    ir_field_get(enum_tag_tid(), span, ints, c_enum_tag_member(), SlotForm.InlineWord, base)
}

fn field_ref(owner_tid: Int, name: Str, at_pos: Position, ftid: Int, frec: LayoutRecord, path: Str, span: Int) -> Int ! Diag.Report {
    let base = value_ref(owner_tid, name, at_pos, span)
    if base < 0 { return -1 }
    ir_field_get(ftid, span, frec.c_spelling, path, frec.slot_form, base)
}

// Whether two values differ, when a runtime helper answers whether they are equal. The
// helper answers equality and the caller wants the opposite, so the call is negated.
fn eq_helper_differs(helper: Str, lhs: Int, rhs: Int, bools: Str, span: Int) -> Int ! Diag.Report {
    ir_unary(TYPE_BOOL, span, bools, "!",
        ir_call_runtime(TYPE_BOOL, span, bools, c_runtime_helper(helper),
            SlotForm.InlineWord, [lhs, rhs]))
}

// The kinds whose C inequality is the language's. Float is absent: the language equates
// NaN with NaN and C's != does not, so a Float is compared through a helper instead.
fn eq_is_scalar(k: TyKind) -> Bool {
    if k == TyKind.Int || k == TyKind.Bool || k == TyKind.Char { return true }
    if k == TyKind.I8 || k == TyKind.I16 || k == TyKind.I32 { return true }
    if k == TyKind.U8 || k == TyKind.U16 || k == TyKind.U32 || k == TyKind.U64 { return true }
    false
}

// ── Ord ──────────────────────────────────────────────────────────────────

// The type a derived cmp answers, and its three variants. The language declares them, so
// this stage names the declaration rather than an integer of its own. C accepts an integer
// where an Ordering is wanted, so an integer here would compile and mean something else.
let ordering_type = "Ordering"
let ordering_less = "Less"
let ordering_equal = "Equal"
let ordering_greater = "Greater"

fn ordering_tid(span: Int) -> Int ! Diag.Report {
    let tid = lookup_named_type(ordering_type)
    if tid < 0 {
        derive_ice(span, "the '{ordering_type}' type @derive(Ord) answers is not declared")
        return -1
    }
    tid
}

fn ordering_spelling(tid: Int, span: Int) -> Str ! Diag.Report {
    spelling_or_ice(layout_of(tid, Position.Return), ordering_type, span)
}

// One of the three answers, as the C name its own declaration carries.
fn ordering_const(tid: Int, name: Str, span: Int) -> Int ! Diag.Report {
    let spelling = ordering_spelling(tid, span)
    if spelling == "" { return -1 }
    let decl = tc_tid_decl_node(tid)
    if decl < 0 || decl == DECL_NODE_AMBIGUOUS {
        derive_ice(span, "the '{ordering_type}' type has no unambiguous declaration to answer through")
        return -1
    }
    let vnode = variant_named(decl, name)
    if vnode < 0 {
        derive_ice(span, "the '{ordering_type}' type declares no variant '{name}'")
        return -1
    }
    ir_const(tid, span, spelling, c_variant_discriminant(tid, vnode))
}

fn ordering_return(name: Str, span: Int) -> Int ! Diag.Report {
    let tid = ordering_tid(span)
    if tid < 0 { return -1 }
    let answer = ordering_const(tid, name, span)
    if answer < 0 { return -1 }
    ir_return(span, answer)
}

fn variant_named(decl: Int, name: Str) -> Int {
    let vars = node_fields(decl)
    if vars == -1 { return -1 }
    let mut i = 0
    while i < sublist_length(vars) {
        let v = sublist_get(vars, i)
        if node_name(v) == name { return v }
        i = i + 1
    }
    -1
}

// Ord requires Eq, and the language derives the supertrait rather than asking the author
// for it, so one annotation writes both methods. Without the eq an Ord-only type answers
// `a < b` through cmp and has no `a == b` to call at all. The record of what this pass has
// written keeps @derive(Eq, Ord) to one eq, in either order.
fn ord_method(decl: Int, arg: Int, bodies: Bool) ! Diag.Report {
    let tid = derive_tid(decl, arg)
    if tid < 0 { return }
    if refused(shape_refusal(decl, tid, derive_ord), arg) { return }
    if !already_written(decl, derive_eq) { eq_method(decl, arg, bodies) }
    cmp_method(decl, tid, arg, bodies)
}

fn cmp_method(decl: Int, tid: Int, arg: Int, bodies: Bool) ! Diag.Report {
    let otid = ordering_tid(arg)
    if otid < 0 { return }
    let self_spelling = spelling_or_ice(layout_of(tid, Position.Param), node_name(decl), arg)
    let ret = ordering_spelling(otid, arg)
    if self_spelling == "" || ret == "" { return }
    let symbol = c_derive_method_name(decl, "cmp")
    let params = ["{self_spelling} self", "{self_spelling} other"]
    if !bodies { return print_fn_decl(false, ret, symbol, params, false) }
    let body = cmp_body(decl, tid, arg)
    if body < 0 { return }
    print_fn(false, ret, symbol, params, false, body)
}

// A value layout gives as one word is its own whole value, so it orders as a word and has
// no member to read: an ordinal enum and a transparent newtype both land here, and asking
// layout is what keeps this stage from deciding the shape for itself.
fn cmp_body(decl: Int, tid: Int, span: Int) -> Int ! Diag.Report {
    let rec = layout_of(tid, Position.Param)
    if rec.slot_form == SlotForm.InlineWord { return cmp_word_body(tid, span) }
    let k = tc_tid_kind(tc_resolve(tid))
    if k == TyKind.Struct { return cmp_struct_body(decl, tid, span) }
    if k == TyKind.Enum { return cmp_tagged_body(decl, tid, span) }
    not_built(span, "@derive(Ord) on a {tk_name(k)} type")
    -1
}

// One test and the answer it settles. Reaching past the guard means the two values agreed
// on what it compared, so the next guard decides.
fn cmp_guard(cond: Int, answer: Str, span: Int) -> Int ! Diag.Report {
    let ret = ordering_return(answer, span)
    if cond < 0 || ret < 0 { return -1 }
    ir_if(span, cond, ir_block(span, [ret]), -1)
}

fn cmp_word_body(tid: Int, span: Int) -> Int ! Diag.Report {
    let less = cmp_word_guard(tid, "<", ordering_less, span)
    let greater = cmp_word_guard(tid, ">", ordering_greater, span)
    let equal = ordering_return(ordering_equal, span)
    if less < 0 || greater < 0 || equal < 0 { return -1 }
    ir_block(span, [less, greater, equal])
}

fn cmp_word_guard(tid: Int, op: Str, answer: Str, span: Int) -> Int ! Diag.Report {
    let bools = bool_spelling(span)
    let lhs = value_ref(tid, "self", Position.Param, span)
    let rhs = value_ref(tid, "other", Position.Param, span)
    if bools == "" || lhs < 0 || rhs < 0 { return -1 }
    cmp_guard(ir_binary(TYPE_BOOL, span, bools, op, lhs, rhs), answer, span)
}

// Lexicographic in declaration order: the first field that differs decides, and the fields
// after it are never read. Reaching the end means every field agreed.
fn cmp_struct_body(decl: Int, tid: Int, span: Int) -> Int ! Diag.Report {
    let mut stmts: List[Int] = []
    for slot in tc_struct_field_slots(tid) {
        let part = cmp_field(tid, tc_sfield_tid(slot), c_field_name(tc_sfield_name(slot)), span)
        if part.len() == 0 { return -1 }
        for s in part { stmts.push(s) }
    }
    let equal = ordering_return(ordering_equal, span)
    if equal < 0 { return -1 }
    stmts.push(equal)
    ir_block(span, stmts)
}

// An enum orders by variant before it reads a payload: the tag decides which member of the
// union may be read at all, so comparing payloads across two variants would read one of
// them through the wrong variant.
fn cmp_tagged_body(decl: Int, tid: Int, span: Int) -> Int ! Diag.Report {
    let slots = tc_enum_variant_slots(tid)
    if slots.len() == 0 {
        derive_ice(span, "enum '{node_name(decl)}' reached cg_derive with no variants")
        return -1
    }
    let ints = int_spelling(span)
    if ints == "" { return -1 }
    let less = cmp_tag_guard(tid, ints, "<", ordering_less, span)
    let greater = cmp_tag_guard(tid, ints, ">", ordering_greater, span)
    let scrutinee = tag_ref(tid, "self", Position.Param, ints, span)
    let unknown = corrupt_tag_block(decl, derive_ord, span)
    let equal = ordering_return(ordering_equal, span)
    if less < 0 || greater < 0 || scrutinee < 0 || unknown < 0 || equal < 0 { return -1 }
    let cases = variant_cases(decl, tid, slots, ints, derive_ord, "", span)
    if cases.len() == 0 { return -1 }
    ir_block(span, [less, greater, ir_switch(span, scrutinee, cases, unknown), equal])
}

fn cmp_tag_guard(tid: Int, ints: Str, op: Str, answer: Str, span: Int) -> Int ! Diag.Report {
    let bools = bool_spelling(span)
    let lhs = tag_ref(tid, "self", Position.Param, ints, span)
    let rhs = tag_ref(tid, "other", Position.Param, ints, span)
    if bools == "" || lhs < 0 || rhs < 0 { return -1 }
    cmp_guard(ir_binary(TYPE_BOOL, span, bools, op, lhs, rhs), answer, span)
}

// The payload of one variant, ordered field by field. A variant whose fields all agree
// runs past its last guard and reaches the answer that the two values are equal.
fn cmp_variant_block(decl: Int, tid: Int, slot: Int, span: Int) -> Int ! Diag.Report {
    let vname = tc_evar_name(slot)
    let mut stmts: List[Int] = []
    for f in tc_evar_field_slots(slot) {
        let path = "{c_enum_payload_member()}.{vname}.{c_field_name(tc_evfield_name(f))}"
        let part = cmp_field(tid, tc_evfield_tid(f), path, span)
        if part.len() == 0 { return -1 }
        for s in part { stmts.push(s) }
    }
    ir_block(span, stmts)
}

// ── One field's order ────────────────────────────────────────────────────

// The statements one field contributes: the guards that can answer from it, and the local
// a guard reads when the comparison is a call rather than an operator. Every field that is
// ordered contributes at least one statement, so an empty answer means a refusal was
// recorded. A field this stage drops instead would make two values that differ answer
// Equal, which sorts wrongly and compiles cleanly.
fn cmp_field(owner_tid: Int, ftid: Int, path: Str, span: Int) -> List[Int] ! Diag.Report {
    let frec = field_layout_of(owner_tid, ftid)
    if field_refused(frec, path, derive_ord, span) { return [] }
    let k = tc_tid_kind(tc_resolve(ftid))
    if k == TyKind.Str { return cmp_sign_field("str_cmp", owner_tid, ftid, frec, path, span) }
    if k == TyKind.Float { return cmp_sign_field("float_cmp", owner_tid, ftid, frec, path, span) }
    if cmp_is_scalar(k) { return cmp_scalar_field(owner_tid, ftid, frec, path, span) }
    if k == TyKind.Struct || k == TyKind.Enum {
        return cmp_nested_field(owner_tid, ftid, frec, path, span)
    }
    not_built(span, "@derive(Ord) on the {tk_name(k)} field '{path}'")
    []
}

fn cmp_scalar_field(owner_tid: Int, ftid: Int, frec: LayoutRecord, path: Str, span: Int) -> List[Int] ! Diag.Report {
    let less = cmp_field_guard(owner_tid, ftid, frec, path, "<", ordering_less, span)
    let greater = cmp_field_guard(owner_tid, ftid, frec, path, ">", ordering_greater, span)
    if less < 0 || greater < 0 { return [] }
    [less, greater]
}

fn cmp_field_guard(owner_tid: Int, ftid: Int, frec: LayoutRecord, path: Str, op: Str, answer: Str, span: Int) -> Int ! Diag.Report {
    let bools = bool_spelling(span)
    let lhs = field_ref(owner_tid, "self", Position.Param, ftid, frec, path, span)
    let rhs = field_ref(owner_tid, "other", Position.Param, ftid, frec, path, span)
    if bools == "" || lhs < 0 || rhs < 0 { return -1 }
    cmp_guard(ir_binary(TYPE_BOOL, span, bools, op, lhs, rhs), answer, span)
}

// A field whose order a runtime helper answers as a sign. A Str is a pointer, so < would
// order two addresses rather than bytes. A Float has a total order the language defines and
// C's < does not give: both < and > answer false for a NaN, which would order every NaN
// equal to everything. A local holds the sign because two guards read it: calling the
// helper twice would order the same pair twice.
fn cmp_sign_field(helper: Str, owner_tid: Int, ftid: Int, frec: LayoutRecord, path: Str, span: Int) -> List[Int] ! Diag.Report {
    let ints = int_spelling(span)
    let lhs = field_ref(owner_tid, "self", Position.Param, ftid, frec, path, span)
    let rhs = field_ref(owner_tid, "other", Position.Param, ftid, frec, path, span)
    if ints == "" || lhs < 0 || rhs < 0 { return [] }
    let name = c_mint_local("ord")
    let call = ir_call_runtime(TYPE_INT, span, ints, c_runtime_helper(helper), int_form(), [lhs, rhs])
    let less = cmp_sign_guard(name, ints, "<", ordering_less, span)
    let greater = cmp_sign_guard(name, ints, ">", ordering_greater, span)
    if less < 0 || greater < 0 { return [] }
    [ir_let(TYPE_INT, span, ints, name, int_form(), call), less, greater]
}

fn cmp_sign_guard(name: Str, ints: Str, op: Str, answer: Str, span: Int) -> Int ! Diag.Report {
    let bools = bool_spelling(span)
    if bools == "" { return -1 }
    let read = ir_var_ref(TYPE_INT, span, ints, name, int_form())
    let zero = ir_const(TYPE_INT, span, ints, "0")
    cmp_guard(ir_binary(TYPE_BOOL, span, bools, op, read, zero), answer, span)
}

// A nested type is ordered by its own derived method, so the comparison stays one call
// deep however far the nesting goes. A local holds the answer because the guard tests it
// and then returns that same answer.
fn cmp_nested_field(owner_tid: Int, ftid: Int, frec: LayoutRecord, path: Str, span: Int) -> List[Int] ! Diag.Report {
    let fdecl = tc_tid_decl_node(ftid)
    if fdecl < 0 || fdecl == DECL_NODE_AMBIGUOUS {
        derive_ice(span, "field type {ftid} has no unambiguous declaration to order through")
        return []
    }
    if !has_str(derive_names(fdecl), derive_ord) {
        not_built(span, "@derive(Ord) on a field whose type '{node_name(fdecl)}' implements Ord by hand")
        return []
    }
    let refusal = shape_refusal(fdecl, ftid, derive_ord)
    if refusal != "" {
        not_built(span, "{refusal}, which the field '{path}' would have to call")
        return []
    }
    let otid = ordering_tid(span)
    if otid < 0 { return [] }
    let ospelling = ordering_spelling(otid, span)
    let bools = bool_spelling(span)
    let equal = ordering_const(otid, ordering_equal, span)
    let lhs = field_ref(owner_tid, "self", Position.Param, ftid, frec, path, span)
    let rhs = field_ref(owner_tid, "other", Position.Param, ftid, frec, path, span)
    if ospelling == "" || bools == "" || equal < 0 || lhs < 0 || rhs < 0 { return [] }
    let form = layout_of(otid, Position.Return).slot_form
    let name = c_mint_local("ord")
    let call = ir_call_direct(otid, span, ospelling, c_derive_method_name(fdecl, "cmp"), form, [lhs, rhs])
    let differs = ir_binary(TYPE_BOOL, span, bools, "!=",
        ir_var_ref(otid, span, ospelling, name, form), equal)
    let answer = ir_return(span, ir_var_ref(otid, span, ospelling, name, form))
    [ir_let(otid, span, ospelling, name, form, call),
        ir_if(span, differs, ir_block(span, [answer]), -1)]
}

// The kinds C orders the way the language does. Bool is a backstop: the language gives a
// Bool equality and no order at all, and typecheck rejects a Bool field under @derive(Ord)
// before this stage runs. Float is absent because C's operators do not give its order; it
// reaches a helper above rather than a refusal.
fn cmp_is_scalar(k: TyKind) -> Bool {
    if k == TyKind.Int || k == TyKind.Char { return true }
    if k == TyKind.I8 || k == TyKind.I16 || k == TyKind.I32 { return true }
    if k == TyKind.U8 || k == TyKind.U16 || k == TyKind.U32 || k == TyKind.U64 { return true }
    false
}

// ── Debug ────────────────────────────────────────────────────────────────

// One field's contribution to a debug string: the printf conversion it needs, the
// argument that feeds it, and the statements that argument depends on. `ok` is false
// when a refusal was recorded, which a zero argument id could not say.
type DebugPart {
    spec: Str
    arg: Int
    pre: List[Int]
    ok: Bool
}

// The answer when a refusal has been recorded. Spelled out rather than left to the field
// defaults, which the language does not define for a List field.
fn debug_refused() -> DebugPart {
    DebugPart { spec: "", arg: -1, pre: [], ok: false }
}

fn str_spelling(node: Int) -> Str ! Diag.Report {
    spelling_or_ice(layout_of(TYPE_STR, Position.Return), "Str", node)
}

fn debug_method(decl: Int, arg: Int, bodies: Bool) ! Diag.Report {
    let tid = derive_tid(decl, arg)
    if tid < 0 { return }
    if refused(shape_refusal(decl, tid, derive_debug), arg) { return }
    let self_spelling = spelling_or_ice(layout_of(tid, Position.Param), node_name(decl), arg)
    let ret = str_spelling(arg)
    if self_spelling == "" || ret == "" { return }
    let symbol = c_derive_method_name(decl, "debug")
    let params = ["{self_spelling} self"]
    if !bodies { return print_fn_decl(false, ret, symbol, params, false) }
    let body = debug_body(decl, tid, arg)
    if body < 0 { return }
    print_fn(false, ret, symbol, params, false, body)
}

// A value layout gives as one word has no member to read. A transparent newtype is the
// payload of its one variant and an ordinal enum is its own tag, and asking layout which
// is which keeps this stage from deciding the shape for itself.
fn debug_body(decl: Int, tid: Int, span: Int) -> Int ! Diag.Report {
    let rec = layout_of(tid, Position.Param)
    if rec.slot_form == SlotForm.InlineWord {
        if rec.is_transparent != 0 { return debug_newtype_body(decl, tid, span) }
        return debug_ordinal_body(decl, tid, span)
    }
    let k = tc_tid_kind(tc_resolve(tid))
    if k == TyKind.Struct { return debug_struct_body(decl, tid, span) }
    if k == TyKind.Enum { return debug_tagged_body(decl, tid, span) }
    not_built(span, "@derive(Debug) on a {tk_name(k)} type")
    -1
}

// ── Assembling one rendered string ───────────────────────────────────────

// The runtime formatter sizes its buffer exactly, so the whole value is one call however
// many fields it has. An empty answer means a refusal was recorded.
fn debug_stmts(fmt: Str, parts: List[DebugPart], span: Int) -> List[Int] ! Diag.Report {
    let rec = layout_of(TYPE_STR, Position.Return)
    let spelling = spelling_or_ice(rec, "Str", span)
    if spelling == "" { return [] }
    let mut stmts: List[Int] = []
    let mut args = [ir_const(TYPE_STR, span, spelling, c_string_literal(fmt))]
    for p in parts {
        for s in p.pre { stmts.push(s) }
        args.push(p.arg)
    }
    stmts.push(ir_return(span, ir_call_runtime(TYPE_STR, span, spelling,
        c_runtime_helper("str_format"), rec.slot_form, args)))
    stmts
}

// A value with nothing to render is one constant. Nothing is formatted because nothing
// varies: a unit variant and a payload-less enum both answer this way.
fn debug_constant(text: Str, span: Int) -> Int ! Diag.Report {
    let spelling = str_spelling(span)
    if spelling == "" { return -1 }
    ir_return(span, ir_const(TYPE_STR, span, spelling, c_string_literal(text)))
}

// A tag no variant declares means the value's memory is corrupt. A derive that reads a
// payload has to choose which payload to read, and no choice is right, so Ord, Debug and
// Hash stop here rather than order, report or hash a value the program does not hold. Eq
// answers false
// instead, because two values it cannot read are not known to be equal.
fn corrupt_tag_block(decl: Int, derive: Str, span: Int) -> Int ! Diag.Report {
    let spelling = str_spelling(span)
    if spelling == "" { return -1 }
    let text = "blink: @derive({derive}) on {node_name(decl)} met a tag no variant declares"
    ir_block(span, [ir_panic(span, ir_const(TYPE_STR, span, spelling, c_string_literal(text)))])
}

fn struct_fmt(name: Str, labels: List[Str], parts: List[DebugPart]) -> Str {
    if parts.len() == 0 { return "{name} \{\}" }
    let mut inner: List[Str] = []
    let mut i = 0
    while i < parts.len() {
        inner.push("{labels.get(i).unwrap()}: {parts.get(i).unwrap().spec}")
        i = i + 1
    }
    "{name} \{ {inner.join(", ")} \}"
}

fn variant_fmt(vname: Str, parts: List[DebugPart]) -> Str {
    let mut specs: List[Str] = []
    for p in parts { specs.push(p.spec) }
    "{vname}({specs.join(", ")})"
}

// ── The four shapes ──────────────────────────────────────────────────────

fn debug_struct_body(decl: Int, tid: Int, span: Int) -> Int ! Diag.Report {
    let mut parts: List[DebugPart] = []
    let mut labels: List[Str] = []
    for slot in tc_struct_field_slots(tid) {
        let ftid = tc_sfield_tid(slot)
        let name = tc_sfield_name(slot)
        let value = field_value(tid, ftid, c_field_name(name), "self", derive_debug, span)
        if value < 0 { return -1 }
        let part = debug_part(ftid, value, name, span)
        if !part.ok { return -1 }
        parts.push(part)
        labels.push(name)
    }
    let stmts = debug_stmts(struct_fmt(node_name(decl), labels, parts), parts, span)
    if stmts.len() == 0 { return -1 }
    ir_block(span, stmts)
}

// An enum with a payload reads its union through the tag, so the tag chooses the variant
// before any payload is read: reading a payload through the wrong variant is undefined.
fn debug_tagged_body(decl: Int, tid: Int, span: Int) -> Int ! Diag.Report {
    let slots = tc_enum_variant_slots(tid)
    if slots.len() == 0 {
        derive_ice(span, "enum '{node_name(decl)}' reached cg_derive with no variants")
        return -1
    }
    let ints = int_spelling(span)
    if ints == "" { return -1 }
    let scrutinee = tag_ref(tid, "self", Position.Param, ints, span)
    let unknown = corrupt_tag_block(decl, derive_debug, span)
    if scrutinee < 0 || unknown < 0 { return -1 }
    let cases = variant_cases(decl, tid, slots, ints, derive_debug, "", span)
    if cases.len() == 0 { return -1 }
    ir_block(span, [ir_switch(span, scrutinee, cases, unknown)])
}

fn debug_variant_block(decl: Int, tid: Int, slot: Int, span: Int) -> Int ! Diag.Report {
    let vname = tc_evar_name(slot)
    let mut parts: List[DebugPart] = []
    for f in tc_evar_field_slots(slot) {
        let ftid = tc_evfield_tid(f)
        let fname = tc_evfield_name(f)
        let path = "{c_enum_payload_member()}.{vname}.{c_field_name(fname)}"
        let value = field_value(tid, ftid, path, "self", derive_debug, span)
        if value < 0 { return -1 }
        // The C member path is what an internal error about the emitted access should
        // name, but a refusal a user can meet names the field they wrote.
        let part = debug_part(ftid, value, "{vname}.{fname}", span)
        if !part.ok { return -1 }
        parts.push(part)
    }
    if parts.len() == 0 {
        let answer = debug_constant(vname, span)
        if answer < 0 { return -1 }
        return ir_block(span, [answer])
    }
    let stmts = debug_stmts(variant_fmt(vname, parts), parts, span)
    if stmts.len() == 0 { return -1 }
    ir_block(span, stmts)
}

// A payload-less enum is a C enum, so its variants are enumerators rather than tag
// macros and the whole value is the tag.
fn debug_ordinal_body(decl: Int, tid: Int, span: Int) -> Int ! Diag.Report {
    let slots = tc_enum_variant_slots(tid)
    if slots.len() == 0 {
        derive_ice(span, "enum '{node_name(decl)}' reached cg_derive with no variants")
        return -1
    }
    let spelling = spelling_or_ice(layout_of(tid, Position.Param), node_name(decl), span)
    let scrutinee = value_ref(tid, "self", Position.Param, span)
    let unknown = corrupt_tag_block(decl, derive_debug, span)
    if spelling == "" || scrutinee < 0 || unknown < 0 { return -1 }
    let cases = debug_ordinal_cases(decl, slots, spelling, tid, span)
    if cases.len() == 0 { return -1 }
    ir_block(span, [ir_switch(span, scrutinee, cases, unknown)])
}

fn debug_ordinal_cases(decl: Int, slots: List[Int], spelling: Str, tid: Int, span: Int) -> List[Int] ! Diag.Report {
    let mut cases: List[Int] = []
    let mut i = 0
    while i < slots.len() {
        let slot = slots.get(i).unwrap()
        let vnode = variant_decl_node(decl, slot, i, span)
        if vnode < 0 { return [] }
        let answer = debug_constant(tc_evar_name(slot), span)
        if answer < 0 { return [] }
        cases.push(ir_const(tid, span, spelling, c_variant_discriminant(tid, vnode)))
        cases.push(ir_block(span, [answer]))
        i = i + 1
    }
    cases
}

// A transparent newtype is the bare word its one field holds, so the parameter itself is
// that field's value and there is no union to read.
fn debug_newtype_body(decl: Int, tid: Int, span: Int) -> Int ! Diag.Report {
    let slots = tc_enum_variant_slots(tid)
    if slots.len() != 1 {
        derive_ice(span, "transparent newtype '{node_name(decl)}' has {slots.len()} variants, not one")
        return -1
    }
    let slot = slots.get(0).unwrap()
    let fields = tc_evar_field_slots(slot)
    if fields.len() != 1 {
        derive_ice(span, "transparent newtype '{node_name(decl)}' carries {fields.len()} fields, not one")
        return -1
    }
    let value = value_ref(tid, "self", Position.Param, span)
    if value < 0 { return -1 }
    let part = debug_part(tc_evfield_tid(fields.get(0).unwrap()), value, node_name(decl), span)
    if !part.ok { return -1 }
    let stmts = debug_stmts(variant_fmt(tc_evar_name(slot), [part]), [part], span)
    if stmts.len() == 0 { return -1 }
    ir_block(span, stmts)
}

// ── One field's rendering ────────────────────────────────────────────────

// The textual scalars and the nested types each have their own debug form, so they are
// asked before the printf table: a Char is quoted rather than printed as its code point,
// and a nested type renders through its own derived method.
fn debug_part(ftid: Int, value: Int, path: Str, span: Int) -> DebugPart ! Diag.Report {
    let k = tc_tid_kind(tc_resolve(ftid))
    if k == TyKind.Bool { return debug_bool_part(value, span) }
    if k == TyKind.Char { return debug_helper_part(TYPE_CHAR, "char_debug", value, span) }
    if k == TyKind.Str { return debug_helper_part(TYPE_STR, "str_debug", value, span) }
    if k == TyKind.Struct || k == TyKind.Enum { return debug_nested_part(ftid, value, path, span) }
    let spec = format_spec_of(ftid)
    if spec == "" {
        not_built(span, "@derive(Debug) on the {tk_name(k)} field '{path}'")
        return debug_refused()
    }
    // C promotes a narrow integer across `...`, and the cast must name the promoted
    // width or the formatter reads the wrong number of bytes.
    let promoted = varargs_spelling(ftid)
    let arg = if promoted == "" { value } else { ir_cast(ftid, span, promoted, value) }
    DebugPart { spec: spec, arg: arg, pre: [], ok: true }
}

// A scalar whose debug form the runtime owns: the helper answers a string, so the
// conversion is the one the scalar's own kind already names.
fn debug_helper_part(tid: Int, helper: Str, value: Int, span: Int) -> DebugPart ! Diag.Report {
    let rec = layout_of(TYPE_STR, Position.Local)
    let spelling = spelling_or_ice(rec, "Str", span)
    let spec = format_spec_of(tid)
    if spelling == "" || spec == "" { return debug_refused() }
    let arg = ir_call_runtime(TYPE_STR, span, spelling, c_runtime_helper(helper), rec.slot_form, [value])
    DebugPart { spec: spec, arg: arg, pre: [], ok: true }
}

// C has no conditional IR node and the runtime exports no bool-to-text helper, so a Bool
// becomes a string temp an `if` fills.
fn debug_bool_part(value: Int, span: Int) -> DebugPart ! Diag.Report {
    let rec = layout_of(TYPE_STR, Position.Local)
    let spelling = spelling_or_ice(rec, "Str", span)
    let spec = format_spec_of(TYPE_BOOL)
    if spelling == "" || spec == "" { return debug_refused() }
    let name = c_mint_local("d")
    let no = ir_const(TYPE_STR, span, spelling, c_string_literal(bool_false))
    let bind = ir_let(TYPE_STR, span, spelling, name, rec.slot_form, no)
    let target = ir_var_ref(TYPE_STR, span, spelling, name, rec.slot_form)
    let yes = ir_const(TYPE_STR, span, spelling, c_string_literal(bool_true))
    let fill = ir_if(span, value, ir_block(span, [ir_assign(span, target, yes)]), -1)
    let arg = ir_var_ref(TYPE_STR, span, spelling, name, rec.slot_form)
    DebugPart { spec: spec, arg: arg, pre: [bind, fill], ok: true }
}

// A nested type is rendered by its own derived method, so the rendering stays one call
// deep however far the nesting goes.
fn debug_nested_part(ftid: Int, value: Int, path: Str, span: Int) -> DebugPart ! Diag.Report {
    let rec = layout_of(TYPE_STR, Position.Local)
    let spelling = spelling_or_ice(rec, "Str", span)
    let spec = format_spec_of(TYPE_STR)
    if spelling == "" || spec == "" { return debug_refused() }
    let fdecl = tc_tid_decl_node(ftid)
    if fdecl < 0 || fdecl == DECL_NODE_AMBIGUOUS {
        derive_ice(span, "field type {ftid} has no unambiguous declaration to render through")
        return debug_refused()
    }
    if !has_str(derive_names(fdecl), derive_debug) {
        not_built(span, "@derive(Debug) on a field whose type '{node_name(fdecl)}' implements Debug by hand")
        return debug_refused()
    }
    let refusal = shape_refusal(fdecl, ftid, derive_debug)
    if refusal != "" {
        not_built(span, "{refusal}, which the field '{path}' would have to call")
        return debug_refused()
    }
    let arg = ir_call_direct(TYPE_STR, span, spelling, c_derive_method_name(fdecl, "debug"),
        rec.slot_form, [value])
    DebugPart { spec: spec, arg: arg, pre: [], ok: true }
}

// ── Hash ─────────────────────────────────────────────────────────────────

// Where the accumulator starts. The runtime owns the constant, so this stage only names
// it. It carries the process seed today, which the Hash contract says a hash must not
// observe; correcting that moves the seed into the table's adapter, where every builtin
// key already mixes it, and is not a change this stage can make alone.
let HASH_INIT = "BLINK_HASH_INIT"

fn u64_spelling(node: Int) -> Str ! Diag.Report {
    spelling_or_ice(layout_of(TYPE_U64, Position.Return), "U64", node)
}

// How a slot holds a U64 is layout's answer, the same as for every other type. A literal
// here would be a second answer to a question one producer already owns.
fn u64_form() -> SlotForm {
    layout_of(TYPE_U64, Position.Return).slot_form
}

fn hash_method(decl: Int, arg: Int, bodies: Bool) ! Diag.Report {
    let tid = derive_tid(decl, arg)
    if tid < 0 { return }
    if refused(hash_refusal(decl, tid), arg) { return }
    if !already_written(decl, derive_eq) { eq_method(decl, arg, bodies) }
    let rec = layout_of(tid, Position.Param)
    let self_spelling = spelling_or_ice(rec, node_name(decl), arg)
    let ret = u64_spelling(arg)
    if self_spelling == "" || ret == "" { return }
    let symbol = c_derive_method_name(decl, "hash")
    let params = ["{self_spelling} self"]
    if !bodies {
        print_fn_decl(false, ret, symbol, params, false)
        return kops_table_decl(rec)
    }
    let body = hash_body(decl, tid, arg)
    if body < 0 { return }
    print_fn(false, ret, symbol, params, false, body)
    kops_table(decl, rec, self_spelling)
}

// The adapters take the key by value, so the size and the spelling must be the ones
// layout gives a parameter, not the ones it gives a container slot. Whether the runtime
// keeps the key's own bytes in the slot is layout's answer too, never this stage's guess:
// a guess from the slot form gets a one-field struct wrong and mis-reads every key.
fn kops_table(decl: Int, rec: LayoutRecord, key_spelling: Str) {
    if rec.kops_table == "" { return }
    print_kops_table(rec.kops_table, key_spelling, c_derive_method_name(decl, "hash"),
        c_derive_method_name(decl, "eq"), rec.kops_inline_key)
}

// A unit that binds the table needs the symbol, and it may not be the unit that defines
// it. The declaration pass walks the whole program, so declaring here reaches every unit;
// the definition stays with the bodies pass, which walks one unit's own types.
fn kops_table_decl(rec: LayoutRecord) {
    if rec.kops_table == "" { return }
    print_kops_table_decl(rec.kops_table)
}

// ── Key tables a declaration cannot carry ─────────────────────────────────
//
// Every key above reaches its table through the declaration that carries @derive(Hash). A
// tuple has no declaration. Section 3.8 derives a tuple's Hash and its Eq from its
// elements, so `Map[(Str, Int), Int]` is a legal keyed map with nothing for the walk above
// to hang a table on, while layout still answers with the table's name — lo_kops_decline_of
// checks the derive for a struct and an enum only. The reference is then emitted where the
// map is created and the unit stops linking on a name no stage wrote.
//
// The table is declared in every unit and defined where the bodies are written, the rule
// every derived method already follows. A nominal key is placed by the module that declared
// it; a structural key belongs to no module, so the driver's scope rule places it instead,
// which is the only reader that knows which units a program is cut into. The hash and the
// equality are static: the adapters the table holds are the only callers, and they are
// written beside it.
pub fn cg_derive_emit_key_tables(key_nodes: List[Int]) ! Diag.Report {
    for n in key_nodes { tuple_key_table(n) }
}

// Declared in every unit and defined in one, the rule every derived method already
// follows. A unit that creates the map holds the reference and may not be the unit that
// holds the table, and the reference is emitted inside a function body, so a declaration
// that arrived with the bodies would arrive after its own first use.
fn key_table_decls() ! Diag.Report {
    for n in cg_derive_key_table_nodes() {
        let key = tuple_key_of(n)
        if key >= 0 {
            // The key's C shape has to exist wherever its table does. A Map is not a
            // carrier, so the typedef walk does not reach the tuple through the map, and a
            // program that spells the pair nowhere else would declare a table over a type
            // the unit has never seen.
            let _ = ensure_typedef_for(key)
            kops_table_decl(layout_of(key, Position.Param))
        }
    }
}

// The keys the program USES, not the keys it names. Layout promises a table to every tuple
// whose typedef is spellable, whether or not anything keys on it, so walking the promise
// would build a hash body for a tuple holding a List and refuse a program that only ever
// held the pair.
//
// A node rather than a type id: it carries the source position every producer below needs,
// and a structural type has none of its own. The first node that spells each table is
// enough, because the table is named from the type and two nodes spelling one type ask for
// one table.
pub fn cg_derive_key_table_nodes() -> List[Int] {
    let mut seen: Map[Str, Int] = Map()
    let mut out: List[Int] = []
    let mut n = 0
    while n < node_count() {
        let key = tuple_key_of(n)
        if key >= 0 {
            let table = layout_of(key, Position.Param).kops_table
            if table != "" && seen.contains_key(table) == 0 {
                seen.insert(table, 1)
                out.push(n)
            }
        }
        n = n + 1
    }
    out
}

// The tuple a keyed container at this node keys on, or -1. Map and Set are the two kinds
// with a key, and child 0 is that key for both.
fn tuple_key_of(n: Int) -> Int {
    let tid = tc_tid_resolved(tc_lookup_node_tid(n))
    if tid < 0 { return -1 }
    let k = tc_tid_kind(tid)
    if k != TyKind.Map && k != TyKind.Set { return -1 }
    let key = tc_tid_resolved(tc_tid_child(tid, 0))
    if key < 0 { return -1 }
    if tc_tid_kind(key) != TyKind.Tuple { return -1 }
    key
}

// One structural key's table, over the methods the key and its elements need. The two
// symbols are spelled from the typedef name, which is the name the table is spelled from,
// so a non-empty table means both are spellable and neither needs a second check here.
fn tuple_key_table(n: Int) ! Diag.Report {
    let tid = tuple_key_of(n)
    if tid < 0 { return }
    let rec = layout_of(tid, Position.Param)
    if rec.kops_table == "" { return }
    if !tuple_methods(tid, n) { return }
    let key_spelling = spelling_or_ice(rec, tc_type_str(tid), n)
    if key_spelling == "" { return }
    print_kops_table(rec.kops_table, key_spelling, c_tid_derive_method_name(tid, "hash"),
        c_tid_derive_method_name(tid, "eq"), rec.kops_inline_key)
}

// One tuple's hash and equality, and every tuple inside it first. An element that is itself
// a tuple is compared by that tuple's own method, and C reads a static function only after
// its definition, so the inner pair is written before the outer one. Both bodies are built
// before either is printed: a refusal in the hash must not leave an equality behind that
// nothing calls. Answers whether the pair now exists, so a refusal deep in an element stops
// the table that would have named it.
fn tuple_methods(tid: Int, span: Int) -> Bool ! Diag.Report {
    let eq_symbol = c_tid_derive_method_name(tid, "eq")
    if tuple_methods_done.contains_key(eq_symbol) != 0 {
        return tuple_methods_done.get(eq_symbol).unwrap() == 1
    }
    tuple_methods_done.insert(eq_symbol, 0)
    let mut i = 0
    while i < tc_tid_child_count(tid) {
        let etid = tc_tid_resolved(tc_tid_child(tid, i))
        if etid >= 0 && tc_tid_kind(etid) == TyKind.Tuple {
            if !tuple_methods(etid, span) { return false }
        }
        i = i + 1
    }
    let key_spelling = spelling_or_ice(layout_of(tid, Position.Param), tc_type_str(tid), span)
    let hashed = u64_spelling(span)
    let compared = bool_spelling(span)
    if key_spelling == "" || hashed == "" || compared == "" { return false }
    let equality = tuple_eq_body(tid, span)
    if equality < 0 { return false }
    let hash = tuple_hash_body(tid, span)
    if hash < 0 { return false }
    print_fn(true, compared, eq_symbol, ["{key_spelling} self", "{key_spelling} other"], false, equality)
    print_fn(true, hashed, c_tid_derive_method_name(tid, "hash"), ["{key_spelling} self"], false, hash)
    tuple_methods_done.insert(eq_symbol, 1)
    true
}

// A tuple's elements fold exactly as a struct's fields do: the reads differ, because a
// struct reaches a member through a field slot and a tuple through a child, and everything
// after the read is shared. The mixing, the short-circuit and every refusal an element can
// raise stay in one place rather than being written a second way here.
fn tuple_hash_body(tid: Int, span: Int) -> Int ! Diag.Report {
    let u64s = u64_spelling(span)
    let init = hash_init_const(span)
    if u64s == "" || init < 0 { return -1 }
    let acc = c_mint_local("h")
    let mut stmts = [ir_let(TYPE_U64, span, u64s, acc, u64_form(), init)]
    let mut i = 0
    while i < tc_tid_child_count(tid) {
        let etid = tc_tid_child(tid, i)
        let path = c_tuple_member(i)
        let value = field_value(tid, etid, path, "self", derive_hash, span)
        if value < 0 { return -1 }
        let folded = hash_fold(acc, etid, value, path, span)
        if folded < 0 { return -1 }
        stmts.push(folded)
        i = i + 1
    }
    stmts.push(ir_return(span, ir_var_ref(TYPE_U64, span, u64s, acc, u64_form())))
    ir_block(span, stmts)
}

fn tuple_eq_body(tid: Int, span: Int) -> Int ! Diag.Report {
    let mut stmts: List[Int] = []
    let mut i = 0
    while i < tc_tid_child_count(tid) {
        let guard = eq_guard(tid, tc_tid_child(tid, i), c_tuple_member(i), span)
        if guard < 0 { return -1 }
        stmts.push(guard)
        i = i + 1
    }
    let agreed = eq_answer(span, "1")
    if agreed < 0 { return -1 }
    stmts.push(agreed)
    ir_block(span, stmts)
}

// A value layout gives as one word is its own hash input, but which input depends on
// what the word holds: an ordinal enum is its tag, and a transparent newtype is the
// field it stands for, which may be a string rather than a number.
fn hash_body(decl: Int, tid: Int, span: Int) -> Int ! Diag.Report {
    let rec = layout_of(tid, Position.Param)
    if rec.slot_form == SlotForm.InlineWord {
        if rec.is_transparent != 0 { return hash_newtype_body(decl, tid, span) }
        return hash_ordinal_body(decl, tid, span)
    }
    let k = tc_tid_kind(tc_resolve(tid))
    if k == TyKind.Struct { return hash_struct_body(decl, tid, span) }
    if k == TyKind.Enum { return hash_tagged_body(decl, tid, span) }
    not_built(span, "@derive(Hash) on a {tk_name(k)} type")
    -1
}

fn hash_init_const(span: Int) -> Int ! Diag.Report {
    let u64s = u64_spelling(span)
    if u64s == "" { return -1 }
    ir_const(TYPE_U64, span, u64s, HASH_INIT)
}

// One value folded in: the accumulator is mixed after the exclusive-or, so a field's
// bits reach every bit of the answer before the next field is folded. Mixing only at
// the end would let two fields cancel each other out.
fn hash_mix(acc: Int, value: Int, span: Int) -> Int ! Diag.Report {
    let u64s = u64_spelling(span)
    if u64s == "" { return -1 }
    let xored = ir_binary(TYPE_U64, span, u64s, "^", acc, value)
    ir_call_runtime(TYPE_U64, span, u64s, c_runtime_helper("kops_mix_u64"), u64_form(), [xored])
}

// A shape with no accumulator to carry: one value, mixed once, returned.
fn hash_single(value: Int, span: Int) -> Int ! Diag.Report {
    let init = hash_init_const(span)
    if init < 0 || value < 0 { return -1 }
    let mixed = hash_mix(init, value, span)
    if mixed < 0 { return -1 }
    ir_block(span, [ir_return(span, mixed)])
}

fn hash_struct_body(decl: Int, tid: Int, span: Int) -> Int ! Diag.Report {
    let u64s = u64_spelling(span)
    let init = hash_init_const(span)
    if u64s == "" || init < 0 { return -1 }
    let acc = c_mint_local("h")
    let mut stmts = [ir_let(TYPE_U64, span, u64s, acc, u64_form(), init)]
    for slot in tc_struct_field_slots(tid) {
        let ftid = tc_sfield_tid(slot)
        let name = tc_sfield_name(slot)
        let value = field_value(tid, ftid, c_field_name(name), "self", derive_hash, span)
        if value < 0 { return -1 }
        let folded = hash_fold(acc, ftid, value, name, span)
        if folded < 0 { return -1 }
        stmts.push(folded)
    }
    stmts.push(ir_return(span, ir_var_ref(TYPE_U64, span, u64s, acc, u64_form())))
    ir_block(span, stmts)
}

// One field's whole contribution as a statement: read it, mix it, put it back.
fn hash_fold(acc: Str, ftid: Int, value: Int, path: Str, span: Int) -> Int ! Diag.Report {
    let u64s = u64_spelling(span)
    let contribution = hash_contribution(ftid, value, path, span)
    if u64s == "" || contribution < 0 { return -1 }
    let read = ir_var_ref(TYPE_U64, span, u64s, acc, u64_form())
    let mixed = hash_mix(read, contribution, span)
    if mixed < 0 { return -1 }
    ir_assign(span, ir_var_ref(TYPE_U64, span, u64s, acc, u64_form()), mixed)
}

// The tag is folded first, so two variants that carry the same payload still hash
// differently. Then the tag chooses which payload may be read at all.
fn hash_tagged_body(decl: Int, tid: Int, span: Int) -> Int ! Diag.Report {
    let slots = tc_enum_variant_slots(tid)
    if slots.len() == 0 {
        derive_ice(span, "enum '{node_name(decl)}' reached cg_derive with no variants")
        return -1
    }
    let u64s = u64_spelling(span)
    let ints = int_spelling(span)
    if u64s == "" || ints == "" { return -1 }
    let tag = tag_ref(tid, "self", Position.Param, ints, span)
    let init = hash_init_const(span)
    if tag < 0 || init < 0 { return -1 }
    let seeded = hash_mix(init, ir_cast(TYPE_U64, span, u64s, tag), span)
    if seeded < 0 { return -1 }
    let acc = c_mint_local("h")
    let scrutinee = tag_ref(tid, "self", Position.Param, ints, span)
    let unknown = corrupt_tag_block(decl, derive_hash, span)
    if scrutinee < 0 || unknown < 0 { return -1 }
    let cases = variant_cases(decl, tid, slots, ints, derive_hash, acc, span)
    if cases.len() == 0 { return -1 }
    ir_block(span, [
        ir_let(TYPE_U64, span, u64s, acc, u64_form(), seeded),
        ir_switch(span, scrutinee, cases, unknown),
        ir_return(span, ir_var_ref(TYPE_U64, span, u64s, acc, u64_form())),
    ])
}

fn hash_variant_block(decl: Int, tid: Int, slot: Int, acc: Str, span: Int) -> Int ! Diag.Report {
    let vname = tc_evar_name(slot)
    let mut stmts: List[Int] = []
    for f in tc_evar_field_slots(slot) {
        let ftid = tc_evfield_tid(f)
        let fname = tc_evfield_name(f)
        let path = "{c_enum_payload_member()}.{vname}.{c_field_name(fname)}"
        let value = field_value(tid, ftid, path, "self", derive_hash, span)
        if value < 0 { return -1 }
        let folded = hash_fold(acc, ftid, value, "{vname}.{fname}", span)
        if folded < 0 { return -1 }
        stmts.push(folded)
    }
    ir_block(span, stmts)
}

// A payload-less enum is its own tag, so the value itself is the whole hash input.
fn hash_ordinal_body(decl: Int, tid: Int, span: Int) -> Int ! Diag.Report {
    let u64s = u64_spelling(span)
    let value = value_ref(tid, "self", Position.Param, span)
    if u64s == "" || value < 0 { return -1 }
    if tc_enum_variant_slots(tid).len() == 0 {
        derive_ice(span, "enum '{node_name(decl)}' reached cg_derive with no variants")
        return -1
    }
    hash_single(ir_cast(TYPE_U64, span, u64s, value), span)
}

// A transparent newtype is the bare word its one field holds, so the parameter itself
// is that field's value. Which hash that word needs is still the field's question: a
// newtype over a string holds a pointer, and hashing the pointer is not hashing the key.
fn hash_newtype_body(decl: Int, tid: Int, span: Int) -> Int ! Diag.Report {
    let slots = tc_enum_variant_slots(tid)
    if slots.len() != 1 {
        derive_ice(span, "transparent newtype '{node_name(decl)}' has {slots.len()} variants, not one")
        return -1
    }
    let fields = tc_evar_field_slots(slots.get(0).unwrap())
    if fields.len() != 1 {
        derive_ice(span, "transparent newtype '{node_name(decl)}' carries {fields.len()} fields, not one")
        return -1
    }
    let value = value_ref(tid, "self", Position.Param, span)
    if value < 0 { return -1 }
    let contribution = hash_contribution(tc_evfield_tid(fields.get(0).unwrap()), value, node_name(decl), span)
    if contribution < 0 { return -1 }
    hash_single(contribution, span)
}

// The unsigned word one value contributes. A string is hashed by its bytes, a nested
// type by its own derived method, and an integral scalar by widening. A Float has no
// hash coherent with its equality and a container has none at all, so both are refused
// here as well as at the gate that keeps them from arriving.
fn hash_contribution(ftid: Int, value: Int, path: Str, span: Int) -> Int ! Diag.Report {
    let u64s = u64_spelling(span)
    if u64s == "" { return -1 }
    let k = tc_tid_kind(tc_resolve(ftid))
    if k == TyKind.Str {
        return ir_call_runtime(TYPE_U64, span, u64s, c_runtime_helper("map_hash"), u64_form(), [value])
    }
    if k == TyKind.Struct || k == TyKind.Enum { return hash_nested(ftid, value, path, span) }
    if k == TyKind.Tuple {
        return ir_call_direct(TYPE_U64, span, u64s,
            c_tid_derive_method_name(tc_resolve(ftid), "hash"), u64_form(), [value])
    }
    if !hash_is_integral(k) {
        not_built(span, "@derive(Hash) on the {tk_name(k)} field '{path}'")
        return -1
    }
    ir_cast(TYPE_U64, span, u64s, value)
}

// The kinds whose bits are the value. Float is absent on purpose: -0.0 equals 0.0 with
// a different bit pattern, so a bitwise hash of a Float cannot stay coherent with its
// equality, and the spec makes that a permanent contract rather than a missing impl.
fn hash_is_integral(k: TyKind) -> Bool {
    if k == TyKind.Int || k == TyKind.Bool || k == TyKind.Char { return true }
    if k == TyKind.I8 || k == TyKind.I16 || k == TyKind.I32 { return true }
    if k == TyKind.U8 || k == TyKind.U16 || k == TyKind.U32 || k == TyKind.U64 { return true }
    false
}

// What stops this stage hashing `decl`. Hash's supertrait Eq is derived alongside it, so
// a type naming Hash alone is not refused for want of an equality; only the shape can
// refuse now.
fn hash_refusal(decl: Int, tid: Int) -> Str {
    shape_refusal(decl, tid, derive_hash)
}

fn hash_nested(ftid: Int, value: Int, path: Str, span: Int) -> Int ! Diag.Report {
    let u64s = u64_spelling(span)
    if u64s == "" { return -1 }
    let fdecl = tc_tid_decl_node(ftid)
    if fdecl < 0 || fdecl == DECL_NODE_AMBIGUOUS {
        derive_ice(span, "field type {ftid} has no unambiguous declaration to hash through")
        return -1
    }
    if !has_str(derive_names(fdecl), derive_hash) {
        not_built(span, "@derive(Hash) on a field whose type '{node_name(fdecl)}' implements Hash by hand")
        return -1
    }
    let refusal = hash_refusal(fdecl, ftid)
    if refusal != "" {
        not_built(span, "{refusal}, which the field '{path}' would have to call")
        return -1
    }
    ir_call_direct(TYPE_U64, span, u64s, c_derive_method_name(fdecl, "hash"), u64_form(), [value])
}

// ── Clone ────────────────────────────────────────────────────────────────

// Clone is a logical copy one level deep: a new value of the same shape, holding what the
// old one held. A C assignment of a whole value is that copy, for a struct and for a tagged
// union alike, so every shape answers the value it was handed. A pointer field is copied as
// the pointer, which is what the language promises for a Str, a List, a Map and a Set.
//
// So this is the one derive that reads no field and calls no field type's own derived
// method. To recurse would deep-copy what the language says two values share, and no test
// of the copy's contents would show it.
fn clone_method(decl: Int, arg: Int, bodies: Bool) ! Diag.Report {
    let tid = derive_tid(decl, arg)
    if tid < 0 { return }
    if refused(shape_refusal(decl, tid, derive_clone), arg) { return }
    let self_spelling = spelling_or_ice(layout_of(tid, Position.Param), node_name(decl), arg)
    if self_spelling == "" { return }
    let ret = spelling_or_ice(layout_of(tid, Position.Return), node_name(decl), arg)
    if ret == "" { return }
    let symbol = c_derive_method_name(decl, "clone")
    let params = ["{self_spelling} self"]
    if !bodies { return print_fn_decl(false, ret, symbol, params, false) }
    let body = clone_body(tid, arg)
    if body < 0 { return }
    print_fn(false, ret, symbol, params, false, body)
}

// The caller has already refused a type layout cannot spell, so the one spelling this asks
// for is always available.
fn clone_body(tid: Int, span: Int) -> Int ! Diag.Report {
    let value = value_ref(tid, "self", Position.Param, span)
    if value < 0 { return -1 }
    ir_block(span, [ir_return(span, value)])
}
