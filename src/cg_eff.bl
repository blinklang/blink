// cg_eff.bl: closures, effects, handlers and async, lowered to IR.
//
// A stage of the tid-native emitter. What it answers today is the with-resource cleanup
// protocol, a closure literal as a value and a handler install; async is still to come.
//
// Nothing here falls back. A protocol whose exit runner no stage emits yet answers the
// protocol and records an internal error, never a symbol. A guessed symbol would link
// against nothing, or link against a runtime function whose first parameter is a
// different struct and read a neighbouring stack slot as its done flag.

import ast.{NodeKind, nk_of}
import parser.{
    node_args, node_body, node_elements, node_is_mut, node_kind, node_method, node_methods, node_name, node_obj,
    node_params, node_recv_type_args, node_stmts, node_target, node_trait_name, node_type_ann, node_value, node_value_child_ids, sublist_get,
    sublist_length,
}
import typecheck.{
    TyKind, TYPE_INT, TYPE_STR, lookup_named_type, make_ffi_scope_type, make_fn_type, make_handler_type, tc_resolve,
    tc_tid_decl_node, tc_tid_handler_effect, tc_tid_kind, tc_void_tid, tk_name, ty_pool,
    tc_call_decl_node, tc_call_user_effect, tc_decl_ret_tid,
}
import layout.{
    BinderMut, LayoutRecord, Position, Slot, SlotForm, async_scope_handles_spelling,
    bind_binder_cell, bind_binder_mut, binder_is_celled, binder_mutability_of, binder_scope_pop, binder_scope_push,
    child_tid, closure_self_spelling, container_slot_spelling, current_binder_scope, ensure_typedef_for,
    layout_of, pointer_spelling, tid_of_binder, tid_of_node, spawn_pair_spelling,
}
import cname.{
    c_builtin_effect_slot, c_cell_name, c_effect_vtable_slot_name, c_ev_field_name, c_ev_global_name,
    c_ev_type_name, c_field_name,
    c_impl_method_name, c_local_name, c_mint_local, c_runtime_helper,
}
import ir.{
    ir_assign, ir_block, ir_box, ir_call_direct, ir_call_runtime, ir_cast,
    ir_closure_new, ir_const, ir_effect_perform, ir_evidence_address, ir_evidence_vector,
    ir_field_get, ir_handler_install, ir_if, ir_let, ir_struct_new, ir_unbox, ir_var_ref,
    ir_expr_stmt, ir_return,
}
import cg_print.{
    print_closure_thunk, print_handler_builder, print_resource_guard_support, print_spawn_pair_typedef,
    print_spawn_task_wrapper, print_vtable_slot_fn, print_vtable_slot_fn_decl, vtable_slot_self_spelling,
}
import cg_reg.{cg_reg_impl_decls}
import cg_promote.{cg_promote_capture_table}
import free_names.{closure_read_names, pattern_names}
import cg_decl.{cg_decl_takes_ev}
import cg_expr.{cg_expr_push_pending, lower_expr, lower_value_as_text, cg_expr_option_some, cg_expr_option_none}
import diagnostics.{
    Diag, diag_ice, diag_ice_at, diag_ice_stage_not_built, diag_is_ice_seg, CODEGEN_STAGE_NOT_BUILT,
    POISONED_IR_AT_SEAM, UNSOLVED_TYPEVAR_AT_CODEGEN,
}

// ── With-resource cleanup ─────────────────────────────────────────────────────────

// Which of the four protocols a `with <expr> as <name>` resource takes on the way out.
pub type CleanupProtocol { Plain, Closeable, BlockHandler, FfiScope }

pub type ResourceCleanup {
    protocol: CleanupProtocol
    // The impl block carrying the protocol's methods, -1 when no trait answers.
    impl_block: Int
    // The C function the guard local runs on the way out, already spelled by cname, or ""
    // when nothing runs. A caller cannot re-derive it: FfiScope's is the runtime's and
    // Closeable's is an impl method's, and the two are spelled by different producers.
    exit_symbol: Str
    // Whether that function takes the block's success flag as a second argument.
    passes_ok: Bool
}

// The traits that claim a resource. Held as names because an impl block's trait is a
// name, and written once each so no comparison against a literal type name is needed.
let TRAIT_BLOCK_HANDLER = "BlockHandler"
let TRAIT_CLOSEABLE = "Closeable"
// The one method Closeable declares, and the runtime's own scope exit.
let CLOSEABLE_EXIT_METHOD = "close"
let FFI_SCOPE_EXIT = "blink_ffi_scope_cleanup"
// async.scope's own exit runner: awaits every handle the scope's body still has running.
let ASYNC_SCOPE_EXIT = "blink_async_scope_drain"

// Nothing runs on the way out. This is also what a recorded internal error hands back,
// so a poisoned answer cannot install a cleanup nobody asked for.
fn plain_binding() -> ResourceCleanup {
    ResourceCleanup { protocol: CleanupProtocol.Plain, impl_block: -1, exit_symbol: "", passes_ok: false }
}

// The FFI scope's exit runner, registered once per translation unit before any function
// that might use it prints. Its symbol is fixed by the runtime; its resource's spelling
// comes from layout_of the same way every other stage reads a tid's C type, rather than a
// literal repeated here. Unlike Closeable's, both are fixed for every FfiScope alike, so
// one unconditional call covers every unit: an unused runner costs nothing, and printing
// it only where a WithScope of this exit symbol turns up would need a scan this driver
// does not otherwise make.
pub fn cg_eff_register_ffi_scope_guard_support() ! Diag.Report {
    let spelling = layout_of(make_ffi_scope_type(), Position.Local).c_spelling
    print_resource_guard_support(FFI_SCOPE_EXIT, spelling, false)
}

// async.scope's exit symbol, read by cg_stmt's lowering so the two sides name the runner
// once, the same way FFI_SCOPE_EXIT is read through cg_eff_register_ffi_scope_guard_support.
pub fn cg_eff_async_scope_exit_symbol() -> Str { ASYNC_SCOPE_EXIT }

// Unlike FFI_SCOPE_EXIT, gen0 predates ASYNC_SCOPE_EXIT, so the driver calls this only for
// a unit whose own pre-scan found an AsyncScope (see cg.bl), not unconditionally.
pub fn cg_eff_register_async_scope_guard_support() ! Diag.Report {
    print_resource_guard_support(ASYNC_SCOPE_EXIT, async_scope_handles_spelling(), false)
}

// A kind that names a declaration of its own, so an impl block can be written for it.
// Anything else is a plain binding without consulting the impls at all.
fn kind_can_carry_impl(k: TyKind) -> Bool {
    k == TyKind.Struct || k == TyKind.Enum
}

// The impl block of one trait for one type declaration, or -1.
//
// The bridge from an impl block to its receiver is the type name it was written with —
// the same bridge typecheck's own impl resolution uses — and the declaration node behind
// that name is what identifies the type: a generic type and each of its instances share
// one declaration where they share no spelling. A name two modules both declare resolves
// to no declaration, so it matches nothing here and the caller reports it.
fn impl_of_trait_for_decl(trait_name: Str, decl: Int, node: Int) -> Int ! Diag.Report {
    let impls = cg_reg_impl_decls()
    let mut i = 0
    while i < impls.len() {
        let im = impls.get(i).unwrap()
        if node_trait_name(im) == trait_name {
            let recv = tc_tid_decl_node(lookup_named_type(node_name(im)))
            if recv >= 0 && recv == decl {
                // A receiver written with type arguments claims ONE instance, and the
                // declaration node is shared by every instance, so the match above
                // cannot tell `Box[Int]` from `Box[Str]`. Answering either way would
                // close the wrong resource or none.
                let args = node_recv_type_args(im)
                if args != -1 && sublist_length(args) > 0 {
                    diag_ice_stage_not_built(
                        "matching a {trait_name} impl written for one instance of a generic type", node)
                    return -1
                }
                return im
            }
        }
        i = i + 1
    }
    -1
}

// The cleanup protocol of one `with <expr> as <name>` item, read from the tid of the
// resource EXPRESSION.
//
// The item node is the whole argument on purpose. Under the BlockHandler protocol the
// binder holds the handler's Context, which is a different type from the resource, and a
// Context of `Int` is a legitimate plain binding — so a caller that passed the binder's
// tid instead would get a silently wrong answer rather than a loud one. Taking the item
// leaves the caller no tid to choose.
pub fn cg_eff_resource_cleanup(item: Int) -> ResourceCleanup ! Diag.Report {
    let node = node_value(item)
    if node < 0 {
        diag_ice_at("NoResourceExpr", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "with-resource item {item} carries no resource expression", item,
            "the parser gives every with-item a value; this is a compiler bug")
        return plain_binding()
    }
    let tid = tc_resolve(tid_of_node(node))
    if tid < 0 || tid >= ty_pool.len() {
        diag_ice_at("NoTypeForResource", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "with-resource reached codegen with a resource type that is not a type", node,
            "typecheck must stamp the resource expression; this is a compiler bug")
        return plain_binding()
    }
    let kind = tc_tid_kind(tid)
    if kind == TyKind.Unknown || kind == TyKind.Typevar {
        diag_ice_at("UnknownResourceKind", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "resource type {tid} reached codegen unsubstituted, as {tk_name(kind)}", node,
            "an unsubstituted type cannot be asked which cleanup protocol it takes; a plain binding here would leave a Closeable resource unclosed")
        return plain_binding()
    }
    if kind == TyKind.FfiScope {
        return ResourceCleanup { protocol: CleanupProtocol.FfiScope, impl_block: -1,
            exit_symbol: FFI_SCOPE_EXIT, passes_ok: false }
    }
    if !kind_can_carry_impl(kind) { return plain_binding() }
    let decl = tc_tid_decl_node(tid)
    if decl < 0 {
        diag_ice_at("NoDeclForResource", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "resource type {tid} names no single declaration, so its impl blocks cannot be found", node,
            "a nominal type reaching codegen must carry one declaration node; a bare name two modules both declare carries none")
        return plain_binding()
    }
    // A block handler calls enter before its body, which no resource does, so the with
    // stage routes it away before asking this. Reaching here means that routing missed it.
    let bh = impl_of_trait_for_decl(TRAIT_BLOCK_HANDLER, decl, node)
    if bh >= 0 {
        diag_ice_at("BlockHandlerOnResourcePath", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "a {TRAIT_BLOCK_HANDLER} reached the resource cleanup path", node,
            "the with stage lowers every block handler through cg_eff_block_handler_calls")
        return ResourceCleanup { protocol: CleanupProtocol.BlockHandler, impl_block: bh,
            exit_symbol: "", passes_ok: false }
    }
    let cl = impl_of_trait_for_decl(TRAIT_CLOSEABLE, decl, node)
    if cl >= 0 { return closeable_binding(cl, tid, node) }
    plain_binding()
}

// Closeable's exit runner is the close method the user wrote. `fn close(self)` is an
// ordinary impl method, so the declaration stage already emits a C function taking the
// resource by value, which is exactly the shape the guard hands its stored resource to.
// Nothing is synthesised here: the symbol is spelled through the same producer that
// spells the definition, and a literal repeated here would link against nothing the day
// the definition moved.
fn closeable_binding(im: Int, tid: Int, node: Int) -> ResourceCleanup ! Diag.Report {
    let rec = layout_of(tid, Position.Local)
    if rec.decline_reason != "" {
        diag_ice_at("UnspellableResourceType", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "a {TRAIT_CLOSEABLE} resource has no C spelling for its guard to store", node,
            "the spelling the resource has at the with-item must spell again where the guard declares it")
        return plain_binding()
    }
    let exit_symbol = c_impl_method_name(im, CLOSEABLE_EXIT_METHOD)
    print_resource_guard_support(exit_symbol, rec.c_spelling, false)
    ResourceCleanup { protocol: CleanupProtocol.Closeable, impl_block: im,
        exit_symbol: exit_symbol, passes_ok: false }
}

// ── Block handlers ────────────────────────────────────────────────────────────────

// The BlockHandler methods one with-item calls, all spelled from one impl block.
pub type BlockHandlerCalls {
    impl_block: Int
    enter_method: Int
    // What enter returns: the Context the `as` binder holds.
    context_tid: Int
    exit_symbol: Str
}

let BLOCK_HANDLER_ENTER_METHOD = "enter"
let BLOCK_HANDLER_EXIT_METHOD = "exit"

// The BlockHandler impl of a with-item expression's type, or -1. The same question
// decides both `with` forms: without `as` an item is a block handler or an effect handler,
// and with it a block handler or a resource.
pub fn cg_eff_block_handler_impl(expr: Int) -> Int ! Diag.Report {
    if expr < 0 { return -1 }
    let tid = tc_resolve(tid_of_node(expr))
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    if !kind_can_carry_impl(tc_tid_kind(tid)) { return -1 }
    let decl = tc_tid_decl_node(tid)
    if decl < 0 { return -1 }
    impl_of_trait_for_decl(TRAIT_BLOCK_HANDLER, decl, expr)
}

// exit runs from the guard with the ok flag the guard recorded. The guard runner passes no
// effect vector, so an exit that performs effects has no lowering yet and says so loudly
// rather than calling a function with one argument missing.
pub fn cg_eff_block_handler_calls(im: Int, tid: Int, node: Int) -> BlockHandlerCalls ! Diag.Report {
    let none = BlockHandlerCalls { impl_block: -1, enter_method: -1, context_tid: -1, exit_symbol: "" }
    let enter = impl_method_named(im, BLOCK_HANDLER_ENTER_METHOD, node)
    let exit = impl_method_named(im, BLOCK_HANDLER_EXIT_METHOD, node)
    if enter < 0 || exit < 0 { return none }
    if cg_decl_takes_ev(exit) {
        diag_ice_stage_not_built("a {TRAIT_BLOCK_HANDLER} exit that performs effects", node)
        return none
    }
    let rec = layout_of(tid, Position.Local)
    if rec.decline_reason != "" {
        diag_ice_at("UnspellableBlockHandlerType", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "a {TRAIT_BLOCK_HANDLER} has no C spelling for its guard to store", node,
            "the spelling the handler has at the with-item must spell again where the guard declares it")
        return none
    }
    let context_tid = callee_answer(enter, node)
    if context_tid < 0 { return none }
    let exit_symbol = c_impl_method_name(im, BLOCK_HANDLER_EXIT_METHOD)
    print_resource_guard_support(exit_symbol, rec.c_spelling, true)
    BlockHandlerCalls { impl_block: im, enter_method: enter, context_tid: context_tid, exit_symbol: exit_symbol }
}

// `handler.enter()`, built by hand because no call node exists in the source. The handler
// arrives as a value the caller already bound, so the call reads it without running it.
pub fn cg_eff_block_handler_enter(calls: BlockHandlerCalls, held: Int, node: Int) -> Int ! Diag.Report {
    let ret = calls.context_tid
    let rec = layout_of(ret, Position.Local)
    if rec.decline_reason != "" {
        diag_ice_at("UnspellableBlockHandlerContext", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "a {TRAIT_BLOCK_HANDLER} enter returns a type with no C spelling", node,
            "typecheck resolves the Context type of every block handler; this is a compiler bug")
        return -1
    }
    let mut args: List[Int] = [held]
    if cg_decl_takes_ev(calls.enter_method) {
        let ev = cg_eff_ev_argument(node)
        if ev < 0 { return -1 }
        args.push(ev)
    }
    let symbol = c_impl_method_name(calls.impl_block, BLOCK_HANDLER_ENTER_METHOD)
    ir_call_direct(ret, node, rec.c_spelling, symbol, rec.slot_form, args)
}

// Typecheck checks an impl against its trait, so a missing method here is a compiler bug.
fn impl_method_named(im: Int, name: Str, node: Int) -> Int ! Diag.Report {
    let ms = node_methods(im)
    let n = if ms == -1 { 0 } else { sublist_length(ms) }
    let mut i = 0
    while i < n {
        let m = sublist_get(ms, i)
        if node_name(m) == name { return m }
        i = i + 1
    }
    diag_ice_at("BlockHandlerMethodMissing", UNSOLVED_TYPEVAR_AT_CODEGEN,
        "the {TRAIT_BLOCK_HANDLER} impl declares no method `{name}`", node,
        "typecheck checks every impl against its trait; this is a compiler bug")
    -1
}

// ── Closures as values ────────────────────────────────────────────────────────────

// A closure literal is a value at its own site and a function definition somewhere
// else. The IR carries no definitions, so the value is a ClosureNew record naming
// `symbol` and the definition waits here until the driver drains the queue.
//
// The driver drains after the enclosing body and BEFORE it leaves that body's instance:
// the thunk's body reads its types through tid_of_node, which answers under the current
// instance, so a thunk drained under a different one would read a different
// substitution from the one its literal was lowered under.
type PendingThunk {
    closure: Int
    symbol: Str
    fn_tid: Int
    // The captured names in first-read order, and the type each was bound at in the frame
    // open where the literal was written. The thunk is printed after that frame has closed,
    // so what the prologue needs is carried here rather than looked up again.
    cap_names: List[Str]
    cap_tids: List[Int]
    // 1 where that name is a shared mutable binding, so its word is the address of its cell
    // rather than a copy of its value. The frame that built the word has closed by the time
    // the prologue reads it back, so which of the two shapes it was built in travels here.
    cap_celled: List[Int]
    // -1 for a closure thunk. A handler literal's tid for one of its operations, which is
    // what makes the operation take its signature from its own declaration rather than from
    // its Fn type, and its performs of that root reach outer_name rather than the vector.
    handler_tid: Int
    // The local an operation's prologue binds the copied-from handler to, out of capture word
    // 0, or "". Each operation's own words carry it, so each handler value keeps its own.
    outer_name: Str
    // "" for a plain closure thunk. For a spawned one, the symbol of the task wrapper that
    // runs on the pool thread and stashes the closure's result into the handle spawn
    // answered — minted beside the closure's own symbol so both exist before either prints.
    task_symbol: Str
    // -1 for a thunk with a written body. For a top-level function named as a value, that
    // function's declaration: the thunk's parameters are its parameters, and its body is one
    // call to forward_symbol, passing the evidence vector when forward_ev says the function
    // takes one.
    forward_to: Int
    forward_symbol: Str
    forward_ev: Bool
}

let mut eff_thunks: List[PendingThunk] = []

// Whether any thunk queued so far is a spawn's, which is what the driver's main shim reads
// to decide whether the program's one TU owning main needs to start the pool. Reset by
// cg_eff_program_reset, not cg_eff_reset: a module boundary is not a program boundary, and
// the shim reads this once, after every module's closures have queued theirs.
let mut eff_uses_async: Bool = false

// Whether the one pair struct every spawn's task wrapper reads its argument through has
// been printed yet. Set the first time a queued thunk carries a task_symbol; every wrapper
// after the first reuses the same typedef rather than printing its own copy.
let mut eff_spawn_pair_printed: Bool = false

// The frame cg_eff_thunk_open pushed, or -1 between thunks, so a close with nothing open
// cannot pop a frame that belongs to someone else.
let mut eff_thunk_scope: Int = -1

// While a handler operation's body lowers: the local its prologue binds the copied-from
// handler to, and the evidence field of the root that operation handles. Both empty outside
// one, which is what a perform reads to decide whether it is performing its own operation.
let mut eff_op_outer_name: Str = ""
let mut eff_op_field: Str = ""

pub fn cg_eff_reset() {
    eff_thunks = []
    eff_shared_names = []
    eff_frame_written = []
    eff_thunk_scope = -1
    eff_op_outer_name = ""
    eff_op_field = ""
    eff_spawn_pair_printed = false
}

// The program-wide counterpart to cg_eff_reset: run once, before the per-module loop, for
// state that a module boundary must not clear. eff_uses_async is read once by the main
// shim after every module's closures have queued theirs, so it has to survive every
// per-unit cg_eff_reset in between and start false only at the program's own start.
pub fn cg_eff_program_reset() {
    eff_uses_async = false
}

// The closure record for one closure literal, or -1 after a recorded internal error.
//
// A captured name rides one void* capture word, which is the slot a container element
// rides, so Position.ContainerSlot already answers what a capture can hold and nothing
// here decides it a second time. A shared mutable binding rides the address of its cell,
// which the declaration allocated, so its own size never reaches the word. One shape is
// still refused by name rather than built: a value that does not fit the word needs a heap
// box, which is not allocated yet, and a closure that is refused queues nothing, so a
// poisoned unit never reaches the printer.
//
// A closure that captures carries its capture descriptor table, which arena promotion reads
// to copy each capture (§5.2.1 clause 7).
pub fn cg_eff_lower_closure(node: Int) -> Int ! Diag.Report {
    lower_closure_thunk(node, "")
}

// `async.spawn(f)` queues the same closure thunk plus a second symbol: the task wrapper
// that runs on the pool thread, minted here so it exists the instant the closure does and
// cg_call can read it straight back off the thunk this returns into. The queue is the
// single owner of both symbols together, which is what keeps a wrapper from ever being
// printed for a closure that was refused, or the reverse.
pub fn cg_eff_lower_spawn_closure(node: Int) -> Int ! Diag.Report {
    eff_uses_async = true
    lower_closure_thunk(node, c_mint_local("spawn_task"))
}

fn lower_closure_thunk(node: Int, task_symbol: Str) -> Int ! Diag.Report {
    let tid = tid_of_node(node)
    if tid < 0 { return -1 }
    let rec = closure_layout(tid, node)
    if rec.c_spelling == "" { return -1 }
    let free = closure_free_names(node)
    if !captures_are_buildable(node, free) { return -1 }
    let tids: List[Int] = []
    let celled: List[Int] = []
    let words = capture_words(node, free, tids, celled)
    let symbol = c_mint_local("closure")
    let descs = cg_promote_capture_table(symbol, free, tids, celled, node)
    if descs == "" && free.len() > 0 { return -1 }
    eff_thunks.push(PendingThunk {
        closure: node, symbol: symbol, fn_tid: tid, cap_names: free, cap_tids: tids,
        cap_celled: celled, handler_tid: -1, outer_name: "", task_symbol: task_symbol,
        forward_to: -1, forward_symbol: "", forward_ev: false,
    })
    ir_closure_new(tid, node, rec.c_spelling, symbol, descs, "", words)
}

fn closure_layout(tid: Int, node: Int) -> LayoutRecord ! Diag.Report {
    let rec = layout_of(tid, Position.Local)
    let why = rec.decline_reason
    if why != "" {
        diag_ice_at("UnspellableClosureType", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "closure has no C layout: {why}", node,
            "monomorphisation must resolve every type codegen reads; this is a compiler bug")
    }
    rec
}

// A top-level function named as a value. A closure is called with its own record in front
// of the arguments and a plain function takes no record, so the value is a thunk that
// forwards to the function rather than the function's own symbol. It captures nothing.
pub fn cg_eff_lower_fn_value(node: Int, decl: Int, symbol: Str, takes_ev: Bool) -> Int ! Diag.Report {
    let tid = tid_of_node(node)
    if tid < 0 { return -1 }
    let rec = closure_layout(tid, node)
    if rec.c_spelling == "" { return -1 }
    let thunk = c_mint_local("fn_value")
    eff_thunks.push(PendingThunk {
        closure: node, symbol: thunk, fn_tid: tid, cap_names: [], cap_tids: [], cap_celled: [],
        handler_tid: -1, outer_name: "", task_symbol: "", forward_to: decl, forward_symbol: symbol,
        forward_ev: takes_ev,
    })
    ir_closure_new(tid, node, rec.c_spelling, thunk, "", "", [])
}

// One capture word per captured name, in first-read order, built in the frame the literal
// was written in because that is where the name still resolves. The thunk reads each word
// back by the position it was built at. Every name is known buildable before this runs.
fn capture_words(node: Int, free: List[Str], tids: List[Int], celled: List[Int]) -> List[Int] ! Diag.Report {
    let mut out: List[Int] = []
    for nm in free {
        let ntid = tid_of_binder(current_binder_scope(), nm)
        let is_cell = binder_is_celled(current_binder_scope(), nm)
        celled.push(if is_cell { 1 } else { 0 })
        tids.push(ntid)
        if is_cell {
            // The binding's storage is one heap cell and the word is its address, which is
            // already a word. A copy here, boxed or punned, would be a second storage the
            // frame never writes to, and every write on either side would go unseen.
            let cell = layout_of(ntid, Position.Local)
            out.push(ir_var_ref(ntid, node, pointer_spelling(cell.c_spelling), c_cell_name(nm),
                SlotForm.InlineWord))
            continue
        }
        let slot = layout_of(ntid, Position.ContainerSlot)
        let loc = layout_of(ntid, Position.Local)
        let read = ir_var_ref(ntid, node, loc.c_spelling, c_local_name(nm), loc.slot_form)
        if slot.slot_form == SlotForm.PointerBoxed {
            // Too wide for the word, so the word holds the address of a heap copy. The
            // binding is not assignable -- the gate above refused it otherwise -- so the
            // copy answers what the original answers for as long as the closure lives.
            out.push(ir_box(ntid, node, slot.c_spelling, loc.c_spelling, read))
        } else {
            // A pointer already is a word. Everything else goes through the integer bridge
            // ContainerSlot names, so the value that comes back out is the value that went in.
            out.push(if slot.slot_word == "" { read } else { ir_cast(ntid, node, slot.slot_word, read) })
        }
    }
    out
}

// Whether every captured name can be held in a capture word, and may be copied into one.
//
// The representational question is asked first and per name. Whether a value fits a word
// is a property of its type alone, so it holds whatever the enclosing frame recorded, and
// a refusal that names the type is the more useful of the two when both apply.
//
// sections/02_syntax.md has a `let mut` binding shared with its closure, not copied: a
// write on either side is visible on the other, which needs one cell both read through.
// Copying the value instead compiles, and then answers the pre-write number on one side
// and drops the closure's writes on the other. A `let` binding carries no such rule, so
// copying it is what the spec calls observationally equivalent.
//
// So a mutable binding is buildable exactly when its declaration gave it that cell. The
// answer comes off the binder frame, the same entry the capture's type comes from, so the
// name is resolved once. A bind site that records nothing answers Unknown and the capture
// is refused: a binder that cannot be told from a shared one is treated as one.
fn captures_are_buildable(node: Int, free: List[Str]) -> Bool ! Diag.Report {
    if free.len() == 0 { return true }
    let scope = current_binder_scope()
    let mut shared: List[Str] = []
    let mut unrecorded: List[Str] = []
    for nm in free {
        let m = binder_mutability_of(scope, nm)
        if m == BinderMut.Mutable && !binder_is_celled(scope, nm) { shared.push(nm) }
        if m == BinderMut.Unknown { unrecorded.push(nm) }
    }
    if shared.len() > 0 {
        diag_ice_at("SharedMutableCaptureNotLowered", CODEGEN_STAGE_NOT_BUILT,
            "closure captures {join_names(shared)}, which the enclosing function can assign, and a shared mutable binding has no cell yet",
            node, "a mutable binding is shared with its closure rather than copied; copying the value would lose a write on each side")
        return false
    }
    if unrecorded.len() > 0 {
        diag_ice_at("CaptureMutabilityNotRecorded", CODEGEN_STAGE_NOT_BUILT,
            "closure captures {join_names(unrecorded)}, bound where codegen records no mutability, and a binding that might be shared has no cell yet",
            node, "parameters and pattern binders do not record mutability yet; until their bind site does, a capture of one cannot be told from a shared binding")
        return false
    }
    for nm in free {
        let ntid = tid_of_binder(scope, nm)
        if binder_is_celled(scope, nm) {
            // The word holds the cell's address, so the value's width never comes up. What
            // has to spell is the pointee, which the frame and the prologue both name.
            let cell = layout_of(ntid, Position.Local)
            let cell_why = cell.decline_reason
            if cell_why != "" {
                diag_ice_at("UnspellableCaptureType", UNSOLVED_TYPEVAR_AT_CODEGEN,
                    "captured local `{nm}` has no C layout: {cell_why}", node,
                    "monomorphisation must resolve every type codegen reads; this is a compiler bug")
                return false
            }
            continue
        }
        let slot = layout_of(ntid, Position.ContainerSlot)
        let why = slot.decline_reason
        if why != "" {
            diag_ice_at("UnspellableCaptureType", UNSOLVED_TYPEVAR_AT_CODEGEN,
                "captured local `{nm}` has no C layout: {why}", node,
                "monomorphisation must resolve every type codegen reads; this is a compiler bug")
            return false
        }
        if slot.slot_form == SlotForm.PointerBoxed {
            let value = layout_of(ntid, Position.Local)
            let value_why = value.decline_reason
            if value_why != "" {
                diag_ice_at("UnspellableCaptureType", UNSOLVED_TYPEVAR_AT_CODEGEN,
                    "captured local `{nm}` has no C layout: {value_why}", node,
                    "monomorphisation must resolve every type codegen reads; this is a compiler bug")
                return false
            }
            // The copy is allocated and read back by the value's own spelling, which for a
            // carrier names a typedef this unit has to declare before either site reads it.
            let _ = ensure_typedef_for(ntid)
        }
    }
    true
}

fn join_names(names: List[Str]) -> Str {
    let mut out = ""
    let mut i = 0
    while i < names.len() {
        if i > 0 { out = "{out}, " }
        out = "{out}`{names.get(i).unwrap()}`"
        i = i + 1
    }
    out
}

// ── Handler literals ─────────────────────────────────────────────

// A handler literal `handler E { ... }` is a value at its own site, like a closure literal,
// and a set of function definitions somewhere else. The value is a vtable for E, a copy of
// the vtable installed for E's root when the literal runs, with one slot replaced per
// operation the literal writes. Copying is what makes a partial handler complete: an
// operation the literal omits keeps the body and userdata word the copied-from handler gave
// it, and a literal that writes no operation at all delegates everything.
//
// Each operation is a closure object built here, stored in its slot's userdata word: word 0
// is the copied-from handler, read now, and the words after it are the locals the operation
// reads. The copy is built by a function of its own because the value stands where C has no
// statement. The operations ride the thunk queue the closure thunks ride, and each is
// forward-declared here because the builder names it before the drain defines it.
pub fn cg_eff_lower_handler_expr(node: Int) -> Int ! Diag.Report {
    let tid = tc_resolve(tid_of_node(node))
    if tid < 0 { return -1 }
    if tc_tid_handler_effect(tid) == "" {
        diag_ice_at("HandlerLiteralNotAHandler", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "handler literal type {tid} is not a handler of a named effect", node,
            "typecheck stamps every handler literal as Handler[E]; this is a compiler bug")
        return -1
    }
    let field = ev_field_of(tid, node)
    if field == "" { return -1 }
    let rec = layout_or_ice(tid, Position.Local, node, "UnspellableHandlerType", "handler literal")
    if rec.c_spelling == "" { return -1 }
    let ops = handler_ops(node)
    // Every signature and capture is checked before anything is queued, so a literal this
    // stage cannot build leaves the queue as it found it rather than a thunk nothing defines.
    let mut sigs: List[HandlerOpSig] = []
    for op in ops {
        let sig = handler_op_sig(tid, op)
        if sig.slot == "" { return -1 }
        sigs.push(sig)
    }
    let outer = c_mint_local("handler_outer")
    let mut slots: List[Str] = []
    let mut symbols: List[Str] = []
    let mut words: List[Int] = []
    for sig in sigs {
        let symbol = c_mint_local("handler_op")
        let captured = ir_field_get(tid, node, rec.c_spelling, field, SlotForm.PointerBoxed, ev_read(node))
        let tids: List[Int] = []
        let celled: List[Int] = []
        let mut kids: List[Int] = [captured]
        for w in capture_words(sig.op, sig.free, tids, celled) { kids.push(w) }
        eff_thunks.push(PendingThunk {
            closure: sig.op, symbol: symbol, fn_tid: sig.fn_tid, cap_names: sig.free, cap_tids: tids,
            cap_celled: celled, handler_tid: tid, outer_name: outer, task_symbol: "", forward_to: -1,
            forward_symbol: "", forward_ev: false,
        })
        print_vtable_slot_fn_decl(sig.ret, symbol, sig.params)
        words.push(ir_closure_new(sig.fn_tid, sig.op, sig.closure_spelling, symbol, "", "", kids))
        slots.push(sig.slot)
        symbols.push(symbol)
    }
    let symbol = c_mint_local("handler")
    print_handler_builder(rec.c_spelling, symbol, c_ev_global_name(), field, slots, symbols)
    ir_call_direct(tid, node, rec.c_spelling, symbol, rec.slot_form, words)
}

// One operation of a literal as the builder and its thunk need it. slot is "" when a part
// did not spell or a capture cannot be built, and that part has recorded its own report.
type HandlerOpSig {
    op: Int
    slot: Str
    ret: Str
    params: List[Str]
    fn_tid: Int
    closure_spelling: Str
    free: List[Str]
}

fn handler_op_sig(tid: Int, op: Int) -> HandlerOpSig ! Diag.Report {
    let none = HandlerOpSig { op: op, slot: "", ret: "", params: [], fn_tid: -1, closure_spelling: "", free: [] }
    let ret = handler_op_ret(op)
    let ps = handler_op_params(op)
    if ret == "" || ps.len() != declared_param_count(op) { return none }
    let slot = c_effect_vtable_slot_name(tid, node_name(op))
    if diag_is_ice_seg(slot) {
        diag_ice_at("HandlerOpNotNameable", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "no vtable member for operation `{node_name(op)}` of this handler", op,
            "a handler literal installs into its root's vtable; a root with no vtable should have been refused before codegen")
        return none
    }
    let fn_tid = handler_op_fn_tid(op)
    if fn_tid < 0 { return none }
    let closure = closure_layout(fn_tid, op)
    if closure.c_spelling == "" { return none }
    let free = closure_free_names(op)
    if !captures_are_buildable(op, free) { return none }
    HandlerOpSig {
        op: op, slot: slot, ret: ret, params: ps, fn_tid: fn_tid, closure_spelling: closure.c_spelling,
        free: free,
    }
}

// The Fn type an operation's closure object carries, from the same result and parameter
// types its signature is spelled from.
fn handler_op_fn_tid(op: Int) -> Int ! Diag.Report {
    let ret = handler_op_ret_tid(op)
    if ret < 0 { return -1 }
    let mut ps: List[Int] = []
    let sl = node_params(op)
    if sl != -1 {
        let mut k = 0
        while k < sublist_length(sl) {
            let t = tid_of_node(sublist_get(sl, k))
            if t < 0 { return -1 }
            ps.push(t)
            k = k + 1
        }
    }
    make_fn_type(ret, ps)
}

// The operations one literal writes, in the order written, which is the order their slots are
// assigned in. A literal writes them flat, unlike a declaration, where they live under the
// sub-effects of a root.
fn handler_ops(node: Int) -> List[Int] {
    let mut out: List[Int] = []
    let sl = node_methods(node)
    if sl == -1 { return out }
    let mut i = 0
    while i < sublist_length(sl) {
        out.push(sublist_get(sl, i))
        i = i + 1
    }
    out
}

fn declared_param_count(fn_like: Int) -> Int {
    let ps = node_params(fn_like)
    if ps == -1 { return 0 }
    sublist_length(ps)
}

// An operation declares its own result, and a declaration with no annotation answers nothing.
fn handler_op_ret_tid(op: Int) -> Int ! Diag.Report {
    let ann = node_type_ann(op)
    if ann == -1 { return tc_void_tid() }
    tid_of_node(ann)
}

fn handler_op_ret(op: Int) -> Str ! Diag.Report {
    thunk_spelling(handler_op_ret_tid(op), Position.VtableSlot, op)
}

// One `<spelling> <name>` per parameter. The names are the literal's own, because the body
// reads them, and the types come off the parameter nodes typecheck stamped when it walked the
// operation against the effect it implements.
fn handler_op_params(op: Int) -> List[Str] ! Diag.Report {
    let mut out: List[Str] = []
    let ps = node_params(op)
    if ps == -1 { return out }
    let mut k = 0
    while k < sublist_length(ps) {
        let p = sublist_get(ps, k)
        let spelling = thunk_spelling(tid_of_node(p), Position.Param, p)
        if spelling == "" { return [] }
        out.push("{spelling} {c_local_name(node_name(p))}")
        k = k + 1
    }
    out
}

// ── The thunk queue ───────────────────────────────────────────────────────────────

pub fn cg_eff_pending_thunks() -> Int { eff_thunks.len() }

// The driver calls this once it has printed every queued thunk, so the next body's
// queue starts empty and a thunk is never defined twice. A thunk body can queue a
// nested closure while the driver is draining, so a driver that fixed its count before
// the loop would leave a closure record pointing at a function nothing defines; the
// count it printed has to match the queue before the queue may go.
pub fn cg_eff_thunks_drained(printed: Int) ! Diag.Report {
    if printed != eff_thunks.len() {
        diag_ice("ThunkQueueNotDrained", POISONED_IR_AT_SEAM,
            "the driver printed {printed} thunks but {eff_thunks.len()} are queued", 0, 0,
            "re-read cg_eff_pending_thunks on every step: a thunk body can queue another thunk")
        return
    }
    eff_thunks = []
}

// A queue index the driver never handed out is a driver bug, and the readers below have
// no node to blame it on, so the report carries no position.
fn thunk_at(i: Int) -> Int ! Diag.Report {
    if i >= 0 && i < eff_thunks.len() { return i }
    diag_ice("NoSuchThunk", POISONED_IR_AT_SEAM,
        "thunk {i} is not in the queue of {eff_thunks.len()}", 0, 0,
        "the driver must read the queue through cg_eff_pending_thunks before indexing it")
    -1
}

pub fn cg_eff_thunk_symbol(i: Int) -> Str ! Diag.Report {
    let t = thunk_at(i)
    if t < 0 { return "" }
    eff_thunks.get(t).unwrap().symbol
}

// The task wrapper symbol cg_eff_lower_spawn_closure minted for this thunk, for cg_call to
// pass to blink_threadpool_submit -- the one fact about the queued thunk that lowering the
// closure alone does not return, because the closure value spawn answers with is the
// runtime closure, not the wrapper the pool calls.
pub fn cg_eff_thunk_task_symbol(i: Int) -> Str ! Diag.Report {
    let t = thunk_at(i)
    if t < 0 { return "" }
    eff_thunks.get(t).unwrap().task_symbol
}

// Whether any closure lowered so far was a spawn's. The driver's main shim reads this once,
// after the whole program's closures have queued theirs, to decide whether main starts the
// pool at all.
pub fn cg_eff_program_uses_async() -> Bool { eff_uses_async }

// The block the thunk's body lowers from, in the same shape lower_block_returning takes.
pub fn cg_eff_thunk_body_node(i: Int) -> Int ! Diag.Report {
    let t = thunk_at(i)
    if t < 0 { return -1 }
    node_body(eff_thunks.get(t).unwrap().closure)
}

// The C spelling of the thunk's result, read from the closure's own Fn type. A closure
// that declares no result carries the void type there, and the return position is where
// layout spells that type as nothing.
pub fn cg_eff_thunk_ret(i: Int) -> Str ! Diag.Report {
    let t = thunk_at(i)
    if t < 0 { return "" }
    let th = eff_thunks.get(t).unwrap()
    // A handler operation is assigned into a vtable slot, and every handler of one effect is
    // assigned into the same one, so the erasure that gives them a single signature is
    // attached to that position rather than to the plain return.
    if th.handler_tid >= 0 { return handler_op_ret(th.closure) }
    thunk_spelling(cg_eff_thunk_ret_tid(i), Position.Return, th.closure)
}

// The closure's result, and the only place the queue is read for it. Two readers want it
// in different shapes: the body lowering wants the type, because the arm a `?` takes is
// decided by the kind, and the signature wants the C spelling. Both come through here, so
// a change to where the result sits moves one reader, not two that can drift apart.
//
// -1 when the queue holds no such thunk, which has already been reported, or when the Fn
// type carries no result there, which has not. A caller that refuses on -1 should only do
// so for an index it knows the queue holds.
pub fn cg_eff_thunk_ret_tid(i: Int) -> Int ! Diag.Report {
    let t = thunk_at(i)
    if t < 0 { return -1 }
    let th = eff_thunks.get(t).unwrap()
    if th.handler_tid >= 0 { return handler_op_ret_tid(th.closure) }
    child_tid(th.fn_tid, Slot.Inner1)
}

// One `<spelling> <name>` per parameter, in declaration order. The name is the local's
// own producer, because the body reads each parameter as a local and the declaration has
// to introduce the identifier those reads spell.
pub fn cg_eff_thunk_params(i: Int) -> List[Str] ! Diag.Report {
    let mut out: List[Str] = []
    let t = thunk_at(i)
    if t < 0 { return out }
    let th = eff_thunks.get(t).unwrap()
    if th.handler_tid >= 0 { return handler_op_params(th.closure) }
    let ps = node_params(thunk_sig_node(th))
    if ps == -1 { return out }
    let mut k = 0
    while k < sublist_length(ps) {
        let p = sublist_get(ps, k)
        let spelling = thunk_spelling(child_tid(th.fn_tid, Slot.Param(k)), Position.Param, p)
        if spelling == "" { return [] }
        out.push("{spelling} {c_local_name(node_name(p))}")
        k = k + 1
    }
    out
}

// The node whose parameters the thunk takes: the forwarded-to function's for a function
// named as a value, else the literal's own.
fn thunk_sig_node(th: PendingThunk) -> Int {
    if th.forward_to >= 0 { th.forward_to } else { th.closure }
}

// The body of a thunk that forwards to a function, built here because no written body
// exists to lower: one call passing each parameter through, returned unless the result is
// void. None for a thunk with a written body, which the driver lowers itself.
pub fn cg_eff_forwarding_body(i: Int) -> Option[Int] ! Diag.Report {
    let t = thunk_at(i)
    if t < 0 { return Some(-1) }
    let th = eff_thunks.get(t).unwrap()
    if th.forward_to < 0 { return None }
    let span = th.closure
    let mut args: List[Int] = []
    let ps = node_params(th.forward_to)
    let mut k = 0
    while ps != -1 && k < sublist_length(ps) {
        let p = sublist_get(ps, k)
        let ptid = child_tid(th.fn_tid, Slot.Param(k))
        if ptid < 0 { return Some(-1) }
        let rec = layout_or_ice(ptid, Position.Local, span, "UnspellableThunkSlot", "forwarded parameter")
        if rec.c_spelling == "" { return Some(-1) }
        args.push(ir_var_ref(ptid, span, rec.c_spelling, c_local_name(node_name(p)), rec.slot_form))
        k = k + 1
    }
    if th.forward_ev { args.push(cg_eff_ev_argument(span)) }
    let ret_tid = cg_eff_thunk_ret_tid(i)
    if ret_tid < 0 { return Some(-1) }
    let ret = layout_or_ice(ret_tid, Position.Local, span, "UnspellableThunkSlot", "forwarded result")
    if ret.c_spelling == "" { return Some(-1) }
    let call = ir_call_direct(ret_tid, span, ret.c_spelling, th.forward_symbol, ret.slot_form, args)
    let k_ret = tc_tid_kind(tc_resolve(ret_tid))
    let stmt = if k_ret == TyKind.Void || k_ret == TyKind.Never { ir_expr_stmt(span, call) } else { ir_return(span, call) }
    Some(ir_block(span, [stmt]))
}

// A layout decline is an ICE and an empty spelling, so a caller can stop on "".
fn thunk_spelling(tid: Int, position: Position, node: Int) -> Str ! Diag.Report {
    if tid < 0 {
        diag_ice_at("ClosureTypeHasNoSlot", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "the closure's Fn type has no type in the slot this parameter or result needs", node,
            "typecheck stamps a closure with one type per parameter and one result; this is a compiler bug")
        return ""
    }
    layout_or_ice(tid, position, node, "UnspellableThunkSlot", "closure parameter or result").c_spelling
}

// A layout this stage reads. A decline is reported once here under the caller's name for
// the slot, and the caller reads the empty spelling as the stop.
fn layout_or_ice(tid: Int, position: Position, node: Int, ice: Str, what: Str) -> LayoutRecord ! Diag.Report {
    let rec = layout_of(tid, position)
    let why = rec.decline_reason
    if why != "" {
        diag_ice_at(ice, UNSOLVED_TYPEVAR_AT_CODEGEN, "{what} has no C layout: {why}", node,
            "monomorphisation must resolve every type codegen reads; this is a compiler bug")
    }
    rec
}

// Prints one queued thunk as a function definition. The body arrives already lowered: it
// goes through the statement stage, which this file cannot import, so the driver lowers it
// under cg_eff_thunk_open and hands the result here. A signature slot that did not spell
// has recorded its own report, and a definition with a hole in its signature is not
// printed on top of it.
pub fn cg_eff_print_thunk(i: Int, body: Int) ! Diag.Report {
    let t = thunk_at(i)
    if t < 0 || body < 0 { return }
    let th = eff_thunks.get(t).unwrap()
    let ret = cg_eff_thunk_ret(i)
    if ret == "" { return }
    let params = cg_eff_thunk_params(i)
    if params.len() != declared_param_count(thunk_sig_node(th)) { return }
    let whole = with_capture_prologue(th, body)
    if whole < 0 { return }
    // A handler operation is reached through a vtable slot, which passes the slot's userdata
    // word in front of the operation's parameters: the operation's own closure object.
    if th.handler_tid >= 0 {
        print_vtable_slot_fn(ret, th.symbol, params, whole)
        return
    }
    print_closure_thunk(ret, th.symbol, params, whole)
    if th.task_symbol != "" { print_spawn_task_wrapper_for(i, th, ret) }
}

// The wrapper a spawned thunk's task symbol names: unpacks the {closure, handle} pair the
// pool thread was handed, calls the thunk through the closure the way call_closure_text
// does inline, and stashes the answer in the handle at the same width a container slot
// takes a value at -- Position.ContainerSlot already answers word-vs-boxed for every other
// void* cell an element rides through, and a handle's result cell is exactly one more.
fn print_spawn_task_wrapper_for(i: Int, th: PendingThunk, ret: Str) ! Diag.Report {
    if !eff_spawn_pair_printed {
        print_spawn_pair_typedef(spawn_pair_spelling())
        eff_spawn_pair_printed = true
    }
    let ret_tid = cg_eff_thunk_ret_tid(i)
    let is_void = ret_tid == tc_void_tid()
    let slot = layout_of(ret_tid, Position.ContainerSlot)
    let boxed = slot.slot_form == SlotForm.PointerBoxed
    print_spawn_task_wrapper(spawn_pair_spelling(), ret, th.task_symbol, is_void, boxed, slot.slot_word)
}

// The body with one declaration per captured name in front of it, each read back out of
// __self at the position its word was built at. A handler operation's word 0 is the
// copied-from handler, so its captures start at 1.
//
// The body lowered its captures as plain local reads, because that is what they are inside
// the thunk, so the prologue is what makes those identifiers exist. __self is the closure
// itself, which is why it carries the thunk's own Fn type.
fn with_capture_prologue(th: PendingThunk, body: Int) -> Int ! Diag.Report {
    let is_op = th.handler_tid >= 0
    if th.cap_names.len() == 0 && !is_op { return body }
    let index_rec = perform_layout(TYPE_INT, Position.Local, th.closure)
    if index_rec.c_spelling == "" { return -1 }
    let mut stmts: List[Int] = []
    if is_op {
        let rec = perform_layout(th.handler_tid, Position.Local, th.closure)
        if rec.c_spelling == "" { return -1 }
        let raw = capture_read(th, th.handler_tid, 0, index_rec.c_spelling)
        stmts.push(ir_let(th.handler_tid, th.closure, rec.c_spelling, th.outer_name, rec.slot_form,
            ir_cast(th.handler_tid, th.closure, rec.c_spelling, raw)))
    }
    let base = if is_op { 1 } else { 0 }
    let mut i = 0
    while i < th.cap_names.len() {
        let s = capture_let(th, i, base + i, index_rec.c_spelling)
        if s < 0 { return -1 }
        stmts.push(s)
        i = i + 1
    }
    stmts.push(body)
    ir_block(th.closure, stmts)
}

// "__self" is the name cg_emit gives the receiver word in every thunk's parameter list, so
// the two have to agree on it. A handler operation's receiver is a vtable slot's word.
fn capture_read(th: PendingThunk, tid: Int, index: Int, index_spelling: Str) -> Int {
    let self_spelling = if th.handler_tid >= 0 { vtable_slot_self_spelling() } else { closure_self_spelling() }
    let self_ref = ir_var_ref(th.fn_tid, th.closure, self_spelling, "__self", SlotForm.InlineWord)
    let at = ir_const(TYPE_INT, th.closure, index_spelling, "{index}")
    ir_call_runtime(tid, th.closure, container_slot_spelling(),
        c_runtime_helper("closure_get_capture"), SlotForm.InlineWord, [self_ref, at])
}

// The declaration of capture i, read from the word at index.
fn capture_let(th: PendingThunk, i: Int, index: Int, index_spelling: Str) -> Int ! Diag.Report {
    let nm = th.cap_names.get(i).unwrap()
    let ntid = th.cap_tids.get(i).unwrap()
    let is_cell = th.cap_celled.get(i).unwrap() == 1
    let slot = layout_of(ntid, Position.ContainerSlot)
    let loc = layout_of(ntid, Position.Local)
    if loc.decline_reason != "" || (!is_cell && slot.decline_reason != "") {
        diag_ice_at("UnspellableCaptureType", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "captured local `{nm}` has no C layout in the thunk that reads it", th.closure,
            "the same type spelled at the literal's site must spell again where the thunk declares it")
        return -1
    }
    let raw = capture_read(th, ntid, index, index_spelling)
    if is_cell {
        // The word is the cell's address and the name is the cell, so the pointer is
        // taken as it stands. Reading through it here would bind a copy of the value,
        // which compiles and then drops every write the thunk makes.
        let cell_spelling = pointer_spelling(loc.c_spelling)
        return ir_let(ntid, th.closure, cell_spelling, c_cell_name(nm), SlotForm.InlineWord,
            ir_cast(ntid, th.closure, cell_spelling, raw))
    }
    // The pun the word was built through, undone in the same order.
    let punned = if slot.slot_word == "" { raw } else { ir_cast(ntid, th.closure, slot.slot_word, raw) }
    // A boxed capture travels as the address of a heap copy, so the name binds to what
    // the address holds. Binding the address instead would read a pointer as the value.
    let init = if slot.slot_form == SlotForm.PointerBoxed {
        ir_unbox(ntid, th.closure, loc.c_spelling, loc.slot_form,
            ir_cast(ntid, th.closure, slot.c_spelling, punned))
    } else {
        ir_cast(ntid, th.closure, loc.c_spelling, punned)
    }
    ir_let(ntid, th.closure, loc.c_spelling, c_local_name(nm), loc.slot_form, init)
}

// Opens the thunk's own binder frame with its parameters bound at their types, and answers
// the frame; the caller lowers the body inside it and then calls cg_eff_thunk_close.
//
// Layout parents a new frame to whatever frame is open. A thunk opened inside another
// function's frame would resolve that function's locals, and the body would then read C
// identifiers the thunk never declares. So an open frame is refused, not adopted.
pub fn cg_eff_thunk_open(i: Int) -> Int ! Diag.Report {
    let t = thunk_at(i)
    if t < 0 { return -1 }
    let th = eff_thunks.get(t).unwrap()
    if current_binder_scope() != -1 {
        diag_ice_at("ThunkFrameNested", POISONED_IR_AT_SEAM,
            "a closure thunk's frame cannot open while another function's frame is open", th.closure,
            "the driver drains the thunk queue after the enclosing body has closed its frame")
        return -1
    }
    let scope = binder_scope_push()
    eff_thunk_scope = scope
    // The thunk's body is its own frame, so the bindings its own closures share are its
    // own. The enclosing frame's answer closed with that frame.
    cg_eff_scan_shared_binders(th.closure)
    if th.handler_tid >= 0 {
        eff_op_outer_name = th.outer_name
        eff_op_field = ev_field_of(th.handler_tid, th.closure)
    }
    if !bind_thunk_params(th, scope) {
        cg_eff_thunk_close()
        return -1
    }
    scope
}

// Pops only the frame cg_eff_thunk_open pushed. A close with no thunk open, or with a
// body's frame still above the thunk's, is a caller that lost track of its frames, and
// popping there would take a frame that belongs to someone else.
pub fn cg_eff_thunk_close() ! Diag.Report {
    if eff_thunk_scope < 0 {
        diag_ice("ThunkNotOpen", POISONED_IR_AT_SEAM, "a closure thunk was closed but none is open", 0, 0,
            "the driver pairs every cg_eff_thunk_close with the cg_eff_thunk_open before it")
        return
    }
    if current_binder_scope() != eff_thunk_scope {
        diag_ice("ThunkFrameUnbalanced", POISONED_IR_AT_SEAM,
            "a closure thunk was closed while a frame opened inside its body is still open", 0, 0,
            "every frame the body lowering opens must close before the thunk does")
        return
    }
    binder_scope_pop()
    eff_thunk_scope = -1
    eff_shared_names = []
    eff_frame_written = []
    eff_op_outer_name = ""
    eff_op_field = ""
}

// The parameter types come from the Fn tid, the same source the signature is spelled
// from, so a binder and its declaration cannot disagree. Answers false when a slot has no
// type: a parameter left unbound would resolve to an outer name instead.
fn bind_thunk_params(th: PendingThunk, scope: Int) -> Bool ! Diag.Report {
    let ps = node_params(thunk_sig_node(th))
    if ps == -1 { return true }
    let mut k = 0
    while k < sublist_length(ps) {
        let p = sublist_get(ps, k)
        let tid = if th.handler_tid >= 0 { tid_of_node(p) } else { child_tid(th.fn_tid, Slot.Param(k)) }
        if tid < 0 {
            diag_ice_at("ClosureParamHasNoType", UNSOLVED_TYPEVAR_AT_CODEGEN,
                "parameter `{node_name(p)}` has no type where the thunk's signature reads it", p,
                "typecheck stamps one type per parameter of a closure and of a handler operation; this is a compiler bug")
            return false
        }
        // Reads the parsed `mut` keyword, not a hardcoded false: name resolution does not
        // honor it yet, but the thunk's own rebind of its closure's param must not bake
        // that gap in and silently copy a param that becomes reassignable the day it does.
        bind_binder_mut(scope, node_name(p), tid, node_is_mut(p) == 1)
        k = k + 1
    }
    // A capture is a local of the thunk, at the type it was bound at where the literal was
    // written. Without it the body's reads would find no binder and resolve nowhere.
    let mut c = 0
    while c < th.cap_names.len() {
        let nm = th.cap_names.get(c).unwrap()
        let ctid = th.cap_tids.get(c).unwrap()
        // A shared binding is shared inside the thunk too, so the body reads and writes it
        // through the cell the prologue declares rather than through a local of its own.
        if th.cap_celled.get(c).unwrap() == 1 {
            bind_binder_cell(scope, nm, ctid)
        } else {
            // captures_are_buildable already refused a mutable, non-celled capture
            // before this runs, so every name reaching here was immutable to begin
            // with; the thunk's copy of it stays immutable too.
            bind_binder_mut(scope, nm, ctid, false)
        }
        c = c + 1
    }
    true
}

// ── Captures ──────────────────────────────────────────────────────────────────────

// The names a closure body reads that are locals of the enclosing function: bound in the
// frame open at the literal's site and not bound by the closure itself. A name the body
// binds for itself, in any of the forms that introduce one, is not a capture even when the
// enclosing function binds the same spelling. A name bound nowhere is a module-level name
// or a namespace, which a thunk reaches without help.
fn closure_free_names(closure: Int) -> List[Str] {
    frame_locals_among(closure_read_names(closure))
}

// Of those names, the ones the frame open right now binds. A name bound nowhere in it is a
// module-level name or a namespace, which a thunk reaches without a capture word.
fn frame_locals_among(names: List[Str]) -> List[Str] {
    let mut out: List[Str] = []
    for nm in names {
        if tid_of_binder(current_binder_scope(), nm) >= 0 { out.push(nm) }
    }
    out
}

// ── Shared mutable bindings ───────────────────────────────────────────────────────

// The `let mut` bindings of the frame now lowering that a closure written in it shares.
let mut eff_shared_names: List[Str] = []

// Records which of one body's `let mut` bindings its closures share, before the body's
// first statement lowers. The cell is the binding's storage from its declaration on, and a
// declaration lowers before the closure below it does, so the declaration cannot ask a
// closure it has not reached yet. The bindings an assert_panics body writes across its
// frame are settled here for the same reason.
//
// `fn_like` is the FnDef or Closure whose frame is about to lower, and the answer covers
// that frame alone. A binding declared inside a nested closure belongs to the nested frame,
// which is scanned again when its thunk opens.
pub fn cg_eff_scan_shared_binders(fn_like: Int) {
    eff_shared_names = []
    eff_frame_written = []
    let body = node_body(fn_like)
    if body < 0 { return }
    let mut env: List[FrameBinder] = []
    let mut written: List[Int] = []
    scan_frame_writes(body, env, 0, written)
    eff_frame_written = written
    let mut read: List[Str] = []
    collect_captured_names(body, read)
    if read.len() == 0 { return }
    let mut found: List[Str] = []
    collect_shared_muts(body, read, found)
    eff_shared_names = found
}

// Whether the binding of this name in the frame now lowering is shared with a closure, and
// so is declared as a cell rather than as a local.
pub fn cg_eff_binder_is_shared(name: Str) -> Bool {
    eff_shared_names.contains(name)
}

// ── Locals written across a panic frame ───────────────────────────────────────────

// The `let` nodes of the frame now lowering, and the leaves of its destructuring patterns,
// that an assert_panics body nested inside their scope assigns.
let mut eff_frame_written: List[Int] = []

// A `let` binder in lexical scope during scan_frame_writes, with the count of assert_panics
// bodies around its declaration.
type FrameBinder {
    name: Str
    decl: Int
    depth: Int
}

// Whether this `let`, or this leaf of a destructuring `let`, is assigned inside an
// assert_panics body its declaration stands outside. The catch comes back through longjmp,
// and a changed local that is not volatile is indeterminate after it (C11 7.13.2.1p3).
pub fn cg_eff_frame_written(decl: Int) -> Bool {
    eff_frame_written.contains(decl)
}

// Resolves each assignment to the innermost binder of its name, so a shadowing `let` in a
// nested block takes the write and the outer binder keeps its plain local. A closure or a
// nested `fn` is a frame of its own, scanned when its own body lowers.
fn scan_frame_writes(node: Int, env: List[FrameBinder], depth: Int, out: List[Int]) {
    if node < 0 { return }
    let k = nk_of(node_kind(node))
    if k == NodeKind.Closure || k == NodeKind.FnDef { return }
    if k == NodeKind.AssertPanics {
        scan_frame_writes(node_value(node), env, depth, out)
        scan_frame_writes(node_body(node), env, depth + 1, out)
        return
    }
    // The initializer reads the outer binding of the name, so it is walked first.
    if k == NodeKind.LetBinding {
        scan_frame_writes(node_value(node), env, depth, out)
        enter_let_binders(node, env, depth)
        return
    }
    if k == NodeKind.Assignment || k == NodeKind.CompoundAssign {
        let b = innermost_frame_binder(env, assigned_root_name(node_target(node)))
        if b.decl >= 0 && b.depth < depth && !out.contains(b.decl) { out.push(b.decl) }
    }
    let mark = env.len()
    for kid in node_value_child_ids(node) { scan_frame_writes(kid, env, depth, out) }
    if k == NodeKind.Block {
        while env.len() > mark {
            let _ = env.pop()
        }
    }
}

// The decl node is the one the let lowering declares from: the LetBinding for a single
// name, the leaf itself for a destructuring pattern.
fn enter_let_binders(node: Int, env: List[FrameBinder], depth: Int) {
    let pat = node_elements(node)
    if pat == -1 {
        env.push(FrameBinder { name: node_name(node), decl: node, depth: depth })
        return
    }
    enter_pattern_leaves(pat, env, depth)
}

fn enter_pattern_leaves(pat: Int, env: List[FrameBinder], depth: Int) {
    let kind = nk_of(node_kind(pat))
    if kind == NodeKind.WildcardPattern { return }
    if kind == NodeKind.TuplePattern {
        let elems = node_elements(pat)
        if elems == -1 { return }
        let mut i = 0
        while i < sublist_length(elems) {
            enter_pattern_leaves(sublist_get(elems, i), env, depth)
            i += 1
        }
        return
    }
    env.push(FrameBinder { name: node_name(pat), decl: pat, depth: depth })
}

// A write to a field lands in the local the field access starts from.
fn assigned_root_name(target: Int) -> Str {
    let k = nk_of(node_kind(target))
    if k == NodeKind.FieldAccess { return assigned_root_name(node_obj(target)) }
    if k == NodeKind.Ident { node_name(target) } else { "" }
}

fn innermost_frame_binder(env: List[FrameBinder], name: Str) -> FrameBinder {
    let mut i = env.len() - 1
    while i >= 0 {
        let b = env.get(i).unwrap()
        if name != "" && b.name == name { return b }
        i -= 1
    }
    FrameBinder { name: name, decl: -1, depth: 0 }
}

// Every name read by a closure written anywhere in this body. A nested literal's own free
// names arrive with the outer one's, because the outer walk binds the nested parameters and
// keeps what is still free.
fn collect_captured_names(node: Int, out: List[Str]) {
    if node < 0 { return }
    let k = nk_of(node_kind(node))
    if k == NodeKind.Closure {
        for nm in closure_read_names(node) {
            if !out.contains(nm) { out.push(nm) }
        }
        return
    }
    // A nested `fn` opens its own frame and captures nothing, so a closure inside it shares
    // that frame's bindings and none of this one's.
    if k == NodeKind.FnDef { return }
    for kid in node_value_child_ids(node) { collect_captured_names(kid, out) }
}

// The `let mut` declarations of this body whose name one of those closures reads. The
// intersection is what makes a private mutable local stay a local: celling every `let mut`
// would put a heap allocation in front of every mutable binding in the language.
fn collect_shared_muts(node: Int, read: List[Str], out: List[Str]) {
    if node < 0 { return }
    let k = nk_of(node_kind(node))
    if k == NodeKind.Closure || k == NodeKind.FnDef { return }
    if k == NodeKind.LetBinding && node_is_mut(node) == 1 {
        let nm = node_name(node)
        if nm != "" && read.contains(nm) && !out.contains(nm) { out.push(nm) }
        // `let mut (a, b) = t` spells its mutability once for the whole pattern, not per
        // leaf, so every leaf gets the same shared check a single mut name gets. pattern_names
        // is the same lookup scan_block already uses to name a destructured let's bound leaves.
        let mut leaves: List[Str] = []
        pattern_names(node_elements(node), leaves)
        for leaf in leaves {
            if read.contains(leaf) && !out.contains(leaf) { out.push(leaf) }
        }
    }
    for kid in node_value_child_ids(node) { collect_shared_muts(kid, read, out) }
}

// ── Handler installs ──────────────────────────────────────────────────────────────

// A `with` item that is not a resource, a block handler or `arena` installs a handler: one field of the
// effect vector holds the handler for the length of the body. Which field is a fact about
// the handler's type, read off the tid typecheck stamped on the item, so an inline
// `handler E { }`, a local of type Handler[E] and a call answering one all land in the
// same slot. The handler value and the body arrive lowered by the stages that own them.
//
// A caller that already recorded an error hands in -1, and gets -1 back without a second
// report, so one bug reads as one.
pub fn cg_eff_lower_handler_install(item: Int, handler_value: Int, body: Int) -> Int ! Diag.Report {
    if handler_value < 0 || body < 0 { return -1 }
    let tid = tc_resolve(tid_of_node(item))
    if tid < 0 { return -1 }
    let effect_name = tc_tid_handler_effect(tid)
    if effect_name == "" {
        diag_ice_at("WithItemNotAHandler", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "with-item type {tid} is not a handler of a named effect", item,
            "a with-item without `as` must be a Handler[E] or a BlockHandler; typecheck refuses the rest (E0839), so this is a compiler defect")
        return -1
    }
    let field = ev_field_of(tid, item)
    if field == "" { return -1 }
    ir_handler_install(item, field, handler_value, body)
}

// The vector field a handler tid owns. A tid that names none is a compiler bug: an effect
// that reaches codegen is declared or builtin, so its root owns a field.
fn ev_field_of(handler_tid: Int, node: Int) -> Str ! Diag.Report {
    let field = c_ev_field_name(handler_tid)
    if diag_is_ice_seg(field) {
        diag_ice_at("EffectSlotUnnamed", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "effect `{tc_tid_handler_effect(handler_tid)}` names no effect vector field: {field}", node,
            "an effect that reaches codegen is declared or builtin, so its root owns a field")
        return ""
    }
    field
}

// ── Effect performs ───────────────────────────────────────────────────────────

// A perform is a virtual call: the vector's field for the effect's root holds a vtable
// pointer, and the operation is one slot of it. Both halves of the address are producers'
// answers, the field cname's for the handler tid and the slot cname's for a builtin pair
// or the member name of a user operation.
//
// The vector read is the program's one global instance. A handler install writes the
// global in place for the length of its body and restores it on the way out, so the global
// is the innermost handler wherever the perform sits, inside a function that also holds a
// vector parameter or not.

// The builtin namespaces whose operations the runtime dispatches through a vtable, and
// the one operation whose slot answers a nullable text where the call answers an Option.
let NS_IO = "io"
let NS_ENV = "env"
let NS_TIME = "time"
let ENV_VAR = "var"
let TIME_READ = "read"

fn ev_read(node: Int) -> Int {
    ir_evidence_vector(node, c_ev_type_name(), c_ev_global_name(), SlotForm.Inline)
}

fn perform_layout(tid: Int, position: Position, node: Int) -> LayoutRecord ! Diag.Report {
    layout_or_ice(tid, position, node, "UnspellablePerformType", "effect operation")
}

// The handler slot of the vector for a root effect. A handler is a vtable pointer, so the
// slot is held by pointer, which is what lets the perform reach its member through it.
fn slot_read(node: Int, handler_tid: Int) -> Int ! Diag.Report {
    let field = ev_field_of(handler_tid, node)
    if field == "" { return -1 }
    let rec = perform_layout(handler_tid, Position.Local, node)
    if rec.c_spelling == "" { return -1 }
    // Inside a handler operation, a perform of the root that operation handles reaches the
    // handler this one was copied from. The vector holds this very operation, so reading it
    // here would call the operation from its own body and recurse until the stack ran out,
    // silently, because the C is well formed. Every other root reads the vector, or a handler
    // installed around this one would be missed. Two handler tids of one root own one field,
    // so the field is the comparison the vtable identity rule already makes.
    if eff_op_outer_name != "" && eff_op_field == field {
        // The operation's prologue binds this local out of the operation's own word 0.
        return ir_var_ref(handler_tid, node, rec.c_spelling, eff_op_outer_name, SlotForm.PointerBoxed)
    }
    ir_field_get(handler_tid, node, rec.c_spelling, field, SlotForm.PointerBoxed, ev_read(node))
}

// The root effect behind a builtin namespace. The pair is checked against cname's field
// producer, so the namespace a caller writes and the field the vector holds cannot drift
// apart without a report.
fn builtin_handler_tid(ns: Str, node: Int) -> Int ! Diag.Report {
    let root = if ns == NS_IO { "IO" } else if ns == NS_ENV { "Env" } else if ns == NS_TIME { "Time" } else { "" }
    let tid = if root == "" { -1 } else { make_handler_type(root) }
    if tid < 0 || c_ev_field_name(tid) != ns {
        diag_ice_at("BuiltinNamespaceNotAnEffect", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "namespace `{ns}` owns no field of the evidence vector", node,
            "only the io, env and time namespaces perform through the vector; this is a compiler bug")
        return -1
    }
    tid
}

fn lower_args(node: Int) -> Option[List[Int]] ! Diag.Report {
    let written = node_args(node)
    let mut out: List[Int] = []
    let mut i = 0
    while i < sublist_length(written) {
        let a = lower_expr(sublist_get(written, i))
        if a < 0 { return None }
        out.push(a)
        i = i + 1
    }
    Some(out)
}

// An operation of the io or env namespace, reached through the runtime's vtable for it.
//
// The io slots take text, and the surface accepts any value the Display trait renders, so
// an io argument is rendered first: text passes as it is, a struct or enum through its
// Display impl, and a kind whose rendering is private to the expression stage is refused
// before anything is built. The env slots take what their signatures declare, which
// typecheck has already checked, so an env argument passes as it is.
pub fn cg_eff_lower_builtin_perform(node: Int, ns: Str, method: Str) -> Int ! Diag.Report {
    let slot = c_builtin_effect_slot(ns, method)
    if diag_is_ice_seg(slot) {
        diag_ice_at("BuiltinEffectOpNotASlot", CODEGEN_STAGE_NOT_BUILT,
            "`{ns}.{method}` is no slot of the runtime's {ns} vtable", node,
            "the runtime dispatches the io print names and the env names through a vtable; nothing else performs here")
        return -1
    }
    let handler_tid = builtin_handler_tid(ns, node)
    if handler_tid < 0 { return -1 }
    let call_tid = tid_of_node(node)
    if call_tid < 0 { return -1 }
    let wraps = ns == NS_ENV && method == ENV_VAR
    // The read slot answers a nullable text, not the Option the call holds.
    let tid = if wraps { TYPE_STR } else { call_tid }
    let rec = perform_layout(tid, Position.Local, node)
    if rec.c_spelling == "" { return -1 }
    let args = if ns == NS_IO { lower_text_args(node) } else { lower_args(node) }
    match args {
        None => -1
        Some(lowered) => {
            let read = slot_read(node, handler_tid)
            if read < 0 { return -1 }
            let perform = ir_effect_perform(tid, node, rec.c_spelling, slot, rec.slot_form, read, lowered)
            if wraps { return wrap_nullable_text(node, call_tid, perform) }
            perform
        }
    }
}

// time.read and time.sleep, reached through the same vtable-slot road as
// cg_eff_lower_builtin_perform, but not through it: cg_call.bl's lower_time_call checks
// time.sleep's argument count before calling here (typecheck's time.sleep arm types the
// call as Void without the generic namespace-intrinsic arity check every other namespace
// intrinsic gets), so this function can assume the argument list it is handed is already
// right-sized. Instant and Duration are runtime-owned (LO_FACT_RUNTIME_OWNED,
// src/layout.bl), so their own tid-native C spelling already matches the vtable's
// read/sleep signatures, and both operations pass their value straight through with no
// field copy on the way in or out.
pub fn cg_eff_lower_time_perform(node: Int, method: Str) -> Int ! Diag.Report {
    let slot = c_builtin_effect_slot(NS_TIME, method)
    if diag_is_ice_seg(slot) {
        diag_ice_at("BuiltinEffectOpNotASlot", CODEGEN_STAGE_NOT_BUILT,
            "`{NS_TIME}.{method}` is no slot of the runtime's {NS_TIME} vtable", node,
            "the runtime dispatches time.read and time.sleep through a vtable; nothing else performs here")
        return -1
    }
    let handler_tid = builtin_handler_tid(NS_TIME, node)
    if handler_tid < 0 { return -1 }
    let read = slot_read(node, handler_tid)
    if read < 0 { return -1 }

    if method == TIME_READ {
        let instant_tid = tid_of_node(node)
        if instant_tid < 0 { return -1 }
        let instant_rec = perform_layout(instant_tid, Position.Local, node)
        if instant_rec.c_spelling == "" { return -1 }
        return ir_effect_perform(instant_tid, node, instant_rec.c_spelling, slot, instant_rec.slot_form, read, [])
    }

    let written = node_args(node)
    let dur_arg = lower_expr(sublist_get(written, 0))
    if dur_arg < 0 { return -1 }
    let void_rec = perform_layout(tc_void_tid(), Position.Local, node)
    if void_rec.c_spelling == "" { return -1 }
    ir_effect_perform(tc_void_tid(), node, void_rec.c_spelling, slot, SlotForm.Inline, read, [dur_arg])
}

// Every io argument rendered to text. The kinds are read before any argument is lowered,
// so a refusal leaves nothing hoisted behind it.
fn lower_text_args(node: Int) -> Option[List[Int]] ! Diag.Report {
    let written = node_args(node)
    let mut out: List[Int] = []
    let mut i = 0
    while i < sublist_length(written) {
        let value = lower_value_as_text(sublist_get(written, i))
        if value < 0 { return None }
        out.push(value)
        i = i + 1
    }
    Some(out)
}

// The runtime's env read answers a text pointer that is null for an unset name, and the
// call holds an Option. The read lands in a temp, the Option starts as None, and the Some
// is written only when the temp holds text; the answer is a reference to the Option temp.
fn wrap_nullable_text(node: Int, opt_tid: Int, perform: Int) -> Int ! Diag.Report {
    if tc_tid_kind(tc_resolve(opt_tid)) != TyKind.Option {
        diag_ice_at("NullableSlotAnswerNotOption", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "a nullable slot read is typed {tk_name(tc_tid_kind(tc_resolve(opt_tid)))} where an Option is needed", node,
            "typecheck signs env.var as Option[Str]; this is a compiler bug")
        return -1
    }
    let text = perform_layout(TYPE_STR, Position.Local, node)
    let opt = perform_layout(opt_tid, Position.Local, node)
    if text.c_spelling == "" || opt.c_spelling == "" { return -1 }
    let raw_name = c_mint_local("env_raw")
    let opt_name = c_mint_local("env_opt")
    let none = cg_expr_option_none(opt_tid, node, opt)
    if none < 0 { return -1 }
    let payload = ir_var_ref(TYPE_STR, node, text.c_spelling, raw_name, text.slot_form)
    let some = cg_expr_option_some(opt_tid, node, opt, payload)
    if some < 0 { return -1 }
    let target = ir_var_ref(opt_tid, node, opt.c_spelling, opt_name, opt.slot_form)
    let cond = ir_var_ref(TYPE_STR, node, text.c_spelling, raw_name, text.slot_form)
    cg_expr_push_pending(node, ir_let(TYPE_STR, node, text.c_spelling, raw_name, text.slot_form, perform))
    cg_expr_push_pending(node, ir_let(opt_tid, node, opt.c_spelling, opt_name, opt.slot_form, none))
    cg_expr_push_pending(node, ir_if(node, cond, ir_block(node, [ir_assign(node, target, some)]), -1))
    ir_var_ref(opt_tid, node, opt.c_spelling, opt_name, opt.slot_form)
}

// An operation of a user effect, written `handle.op(args)` on the lowered handle name of
// its root effect. The operation and its root come from the declaration typecheck recorded
// for the call. The slot is the operation's member of the root's vtable, spelled by the
// same producer the declaration used.
//
// The call reads the slot's answer with no conversion, so its own type must spell as the
// operation's declared answer does in the slot. A call typecheck stamped with another type
// would assign across two C types, so it is refused by name.
pub fn cg_eff_lower_user_perform(node: Int) -> Int ! Diag.Report {
    let handle = node_name(node_obj(node))
    let op = node_method(node)
    let decl = tc_call_user_effect(node)
    if decl < 0 {
        diag_ice_at("PerformWithoutOperation", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "`{handle}.{op}` was lowered as a perform but resolved to no effect operation", node,
            "codegen reads a perform only from the operation typecheck recorded; this is a compiler bug")
        return -1
    }
    let tid = tid_of_node(node)
    if tid < 0 { return -1 }
    let rec = perform_layout(tid, Position.Local, node)
    if rec.c_spelling == "" { return -1 }
    let k = tc_tid_kind(tc_resolve(tid))
    if k != TyKind.Void && k != TyKind.Never {
        let slot_rec = perform_layout(callee_answer(tc_call_decl_node(node), node), Position.VtableSlot, node)
        if slot_rec.c_spelling == "" { return -1 }
        if slot_rec.c_spelling != rec.c_spelling {
            diag_ice_at("PerformAnswerDiffersFromSlot", UNSOLVED_TYPEVAR_AT_CODEGEN,
                "`{handle}.{op}` answers {slot_rec.c_spelling} from its slot where the call holds {rec.c_spelling}", node,
                "typecheck stamps a perform with its operation's declared answer; this is a compiler bug")
            return -1
        }
    }
    match lower_args(node) {
        None => -1
        Some(lowered) => {
            let read = slot_read(node, make_handler_type(node_name(decl)))
            if read < 0 { return -1 }
            ir_effect_perform(tid, node, rec.c_spelling, c_field_name(op), rec.slot_form, read, lowered)
        }
    }
}

// ── The evidence argument of an effectful call ─────────────────────────────────

// The argument a call appends when its callee carries an effect row. The callee receives
// the vector as a trailing `blink_ev*`, so what a caller passes is the address of the
// program's one vector, which is exact everywhere because a handler install writes that
// vector in place and restores it on the way out.
//
// The global read is the operand even inside a function that holds a vector parameter: one
// vector means the two are the same address, and the IR admits no other operand here, since
// a parameter is already its own address.
//
// The signature still answers `! Diag.Report` because every caller is written against it
// and reaches it before lowering anything; nothing in this body raises.
pub fn cg_eff_ev_argument(node: Int) -> Int ! Diag.Report {
    ir_evidence_address(node, ev_read(node))
}

// What a callee declared outside the body being lowered answers, read from its signature.
// Inside a generic instance the callee's annotation node has no type, because it belongs
// to no instance.
fn callee_answer(decl: Int, node: Int) -> Int ! Diag.Report {
    let tid = tc_decl_ret_tid(decl)
    if tid >= 0 { return tid }
    diag_ice_at("CalleeWithoutSignature", UNSOLVED_TYPEVAR_AT_CODEGEN,
        "the callee this call reaches registered no signature", node,
        "typecheck registers a signature for every declaration a call can reach; this is a compiler bug")
    -1
}
