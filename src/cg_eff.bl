// cg_eff.bl: closures, effects, handlers and async, lowered to IR.
//
// A stage of the tid-native emitter. What it answers today is the with-resource cleanup
// protocol, a closure literal as a value and a handler install; async is still to come.
//
// Nothing here falls back. A protocol whose exit runner no stage emits yet answers the
// protocol and records an internal error, never a symbol. A guessed symbol would link
// against nothing, or link against a runtime function whose first parameter is a
// different struct and read a neighbouring stack slot as its done flag.

import ast.{NodeKind, nk_of}
import parser.{
    is_literal_string_part, node_args, node_body, node_elements, node_for_binder, node_guard, node_handlers,
    node_iterable, node_kind, node_method, node_methods, node_name, node_obj, node_params, node_pattern,
    node_recv_type_args, node_stmts, node_trait_name, node_value, node_value_child_ids, sublist_get,
    sublist_length,
}
import typecheck.{
    TyKind, TYPE_INT, TYPE_STR, lookup_named_type, make_ffi_scope_type, make_handler_type, tc_resolve,
    tc_tid_decl_node, tc_tid_handler_effect, tc_tid_kind, tk_name, ty_pool,
}
import layout.{
    BinderMut, LayoutRecord, Position, Slot, SlotForm, bind_binder, binder_mutability_of, binder_scope_pop,
    binder_scope_push, child_tid, closure_self_spelling, container_slot_spelling, current_binder_scope,
    ensure_typedef_for, layout_of, tid_of_binder, tid_of_node,
}
import cname.{
    c_builtin_effect_slot, c_ev_field_name, c_ev_global_name, c_ev_type_name, c_field_name,
    c_impl_method_name, c_local_name, c_mint_local, c_runtime_helper,
}
import ir.{
    ir_assign, ir_block, ir_box, ir_carrier_wrap, ir_closure_new, ir_const, ir_effect_perform, ir_evidence_address,
    ir_evidence_vector, ir_call_runtime, ir_cast, ir_field_get, ir_handler_install, ir_if, ir_let, ir_unbox,
    ir_var_ref,
}
import cg_print.{print_closure_thunk, print_resource_guard_support}
import cg_reg.{cg_reg_effect_decls, cg_reg_impl_decls}
import cg_expr.{cg_expr_push_pending, lower_expr, lower_value_as_text}
import diagnostics.{
    Diag, diag_ice, diag_ice_at, diag_ice_stage_not_built, diag_is_ice_seg, CODEGEN_STAGE_NOT_BUILT,
    POISONED_IR_AT_SEAM, UNSOLVED_TYPEVAR_AT_CODEGEN,
}

// ── With-resource cleanup ─────────────────────────────────────────────────────────

// Which of the four protocols a `with <expr> as <name>` resource takes on the way out.
pub type CleanupProtocol { Plain, Closeable, BlockHandler, FfiScope }

pub type ResourceCleanup {
    protocol: CleanupProtocol
    // The impl block carrying the protocol's methods, -1 when no trait answers.
    impl_block: Int
    // The C function the guard local runs on the way out, already spelled by cname, or ""
    // when nothing runs. A caller cannot re-derive it: FfiScope's is the runtime's and
    // Closeable's is an impl method's, and the two are spelled by different producers.
    exit_symbol: Str
    // Whether that function takes the block's success flag as a second argument.
    passes_ok: Bool
}

// The traits that claim a resource. Held as names because an impl block's trait is a
// name, and written once each so no comparison against a literal type name is needed.
let TRAIT_BLOCK_HANDLER = "BlockHandler"
let TRAIT_CLOSEABLE = "Closeable"
// The one method Closeable declares, and the runtime's own scope exit.
let CLOSEABLE_EXIT_METHOD = "close"
let FFI_SCOPE_EXIT = "blink_ffi_scope_cleanup"

// Nothing runs on the way out. This is also what a recorded internal error hands back,
// so a poisoned answer cannot install a cleanup nobody asked for.
fn plain_binding() -> ResourceCleanup {
    ResourceCleanup { protocol: CleanupProtocol.Plain, impl_block: -1, exit_symbol: "", passes_ok: false }
}

// The FFI scope's exit runner, registered once per translation unit before any function
// that might use it prints. Its symbol is fixed by the runtime; its resource's spelling
// comes from layout_of the same way every other stage reads a tid's C type, rather than a
// literal repeated here. Unlike Closeable's, both are fixed for every FfiScope alike, so
// one unconditional call covers every unit: an unused runner costs nothing, and printing
// it only where a WithScope of this exit symbol turns up would need a scan this driver
// does not otherwise make.
pub fn cg_eff_register_ffi_scope_guard_support() ! Diag.Report {
    let spelling = layout_of(make_ffi_scope_type(), Position.Local).c_spelling
    print_resource_guard_support(FFI_SCOPE_EXIT, spelling, false)
}

// A kind that names a declaration of its own, so an impl block can be written for it.
// Anything else is a plain binding without consulting the impls at all.
fn kind_can_carry_impl(k: TyKind) -> Bool {
    k == TyKind.Struct || k == TyKind.Enum
}

// The impl block of one trait for one type declaration, or -1.
//
// The bridge from an impl block to its receiver is the type name it was written with —
// the same bridge typecheck's own impl resolution uses — and the declaration node behind
// that name is what identifies the type: a generic type and each of its instances share
// one declaration where they share no spelling. A name two modules both declare resolves
// to no declaration, so it matches nothing here and the caller reports it.
fn impl_of_trait_for_decl(trait_name: Str, decl: Int, node: Int) -> Int ! Diag.Report {
    let impls = cg_reg_impl_decls()
    let mut i = 0
    while i < impls.len() {
        let im = impls.get(i).unwrap()
        if node_trait_name(im) == trait_name {
            let recv = tc_tid_decl_node(lookup_named_type(node_name(im)))
            if recv >= 0 && recv == decl {
                // A receiver written with type arguments claims ONE instance, and the
                // declaration node is shared by every instance, so the match above
                // cannot tell `Box[Int]` from `Box[Str]`. Answering either way would
                // close the wrong resource or none.
                let args = node_recv_type_args(im)
                if args != -1 && sublist_length(args) > 0 {
                    diag_ice_stage_not_built(
                        "matching a {trait_name} impl written for one instance of a generic type", node)
                    return -1
                }
                return im
            }
        }
        i = i + 1
    }
    -1
}

// The cleanup protocol of one `with <expr> as <name>` item, read from the tid of the
// resource EXPRESSION.
//
// The item node is the whole argument on purpose. Under the BlockHandler protocol the
// binder holds the handler's Context, which is a different type from the resource, and a
// Context of `Int` is a legitimate plain binding — so a caller that passed the binder's
// tid instead would get a silently wrong answer rather than a loud one. Taking the item
// leaves the caller no tid to choose.
pub fn cg_eff_resource_cleanup(item: Int) -> ResourceCleanup ! Diag.Report {
    let node = node_value(item)
    if node < 0 {
        diag_ice_at("NoResourceExpr", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "with-resource item {item} carries no resource expression", item,
            "the parser gives every with-item a value; this is a compiler bug")
        return plain_binding()
    }
    let tid = tc_resolve(tid_of_node(node))
    if tid < 0 || tid >= ty_pool.len() {
        diag_ice_at("NoTypeForResource", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "with-resource reached codegen with a resource type that is not a type", node,
            "typecheck must stamp the resource expression; this is a compiler bug")
        return plain_binding()
    }
    let kind = tc_tid_kind(tid)
    if kind == TyKind.Unknown || kind == TyKind.Typevar {
        diag_ice_at("UnknownResourceKind", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "resource type {tid} reached codegen unsubstituted, as {tk_name(kind)}", node,
            "an unsubstituted type cannot be asked which cleanup protocol it takes; a plain binding here would leave a Closeable resource unclosed")
        return plain_binding()
    }
    if kind == TyKind.FfiScope {
        return ResourceCleanup { protocol: CleanupProtocol.FfiScope, impl_block: -1,
            exit_symbol: FFI_SCOPE_EXIT, passes_ok: false }
    }
    if !kind_can_carry_impl(kind) { return plain_binding() }
    let decl = tc_tid_decl_node(tid)
    if decl < 0 {
        diag_ice_at("NoDeclForResource", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "resource type {tid} names no single declaration, so its impl blocks cannot be found", node,
            "a nominal type reaching codegen must carry one declaration node; a bare name two modules both declare carries none")
        return plain_binding()
    }
    // BlockHandler is tried first: a type that implements both also feeds the block's
    // binder its context, and only the BlockHandler protocol does that. Typecheck
    // rejects the pair outright, so this order is a guard rather than a live choice.
    let bh = impl_of_trait_for_decl(TRAIT_BLOCK_HANDLER, decl, node)
    if bh >= 0 {
        return needs_exit_runner(CleanupProtocol.BlockHandler, bh,
            "a {TRAIT_BLOCK_HANDLER} resource's cleanup", node)
    }
    let cl = impl_of_trait_for_decl(TRAIT_CLOSEABLE, decl, node)
    if cl >= 0 { return closeable_binding(cl, tid, node) }
    plain_binding()
}

// A protocol that is selected but cannot yet be spelled. The guard local's cleanup
// attribute needs a function taking the resource by value, and under BlockHandler the
// binder holds the Context that `enter` answers rather than the resource itself, so no
// method the user wrote has that shape. The protocol travels with an empty symbol and a
// loud error rather than degrading to a plain binding, which would leave the exit unrun.
fn needs_exit_runner(protocol: CleanupProtocol, im: Int, what: Str, node: Int) -> ResourceCleanup ! Diag.Report {
    diag_ice_stage_not_built(what, node)
    ResourceCleanup { protocol: protocol, impl_block: im, exit_symbol: "", passes_ok: false }
}

// Closeable's exit runner is the close method the user wrote. `fn close(self)` is an
// ordinary impl method, so the declaration stage already emits a C function taking the
// resource by value, which is exactly the shape the guard hands its stored resource to.
// Nothing is synthesised here: the symbol is spelled through the same producer that
// spells the definition, and a literal repeated here would link against nothing the day
// the definition moved.
fn closeable_binding(im: Int, tid: Int, node: Int) -> ResourceCleanup ! Diag.Report {
    let rec = layout_of(tid, Position.Local)
    if rec.decline_reason != "" {
        diag_ice_at("UnspellableResourceType", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "a {TRAIT_CLOSEABLE} resource has no C spelling for its guard to store", node,
            "the spelling the resource has at the with-item must spell again where the guard declares it")
        return plain_binding()
    }
    let exit_symbol = c_impl_method_name(im, CLOSEABLE_EXIT_METHOD)
    print_resource_guard_support(exit_symbol, rec.c_spelling, false)
    ResourceCleanup { protocol: CleanupProtocol.Closeable, impl_block: im,
        exit_symbol: exit_symbol, passes_ok: false }
}

// ── Closures as values ────────────────────────────────────────────────────────────

// A closure literal is a value at its own site and a function definition somewhere
// else. The IR carries no definitions, so the value is a ClosureNew record naming
// `symbol` and the definition waits here until the driver drains the queue.
//
// The driver drains after the enclosing body and BEFORE it leaves that body's instance:
// the thunk's body reads its types through tid_of_node, which answers under the current
// instance, so a thunk drained under a different one would read a different
// substitution from the one its literal was lowered under.
type PendingThunk {
    closure: Int
    symbol: Str
    fn_tid: Int
    // The captured names in first-read order, and the type each was bound at in the frame
    // open where the literal was written. The thunk is printed after that frame has closed,
    // so what the prologue needs is carried here rather than looked up again.
    cap_names: List[Str]
    cap_tids: List[Int]
}

let mut eff_thunks: List[PendingThunk] = []

// The frame cg_eff_thunk_open pushed, or -1 between thunks, so a close with nothing open
// cannot pop a frame that belongs to someone else.
let mut eff_thunk_scope: Int = -1

pub fn cg_eff_reset() {
    eff_thunks = []
    eff_thunk_scope = -1
}

// The closure record for one closure literal, or -1 after a recorded internal error.
//
// A captured name rides one void* capture word, which is the slot a container element
// rides, so Position.ContainerSlot already answers what a capture can hold and nothing
// here decides it a second time. Two shapes are still refused by name rather than built:
// a value that does not fit the word needs a heap box, and a binding the enclosing
// function can assign needs a cell both sides share. Neither is allocated yet, and a
// closure that is refused queues nothing, so a poisoned unit never reaches the printer.
//
// The descriptor table and the arena promoter stay empty together. The table has one
// reader, the promoter that deep-copies captures into an arena, so a closure that is never
// promoted would carry an array nothing reads.
pub fn cg_eff_lower_closure(node: Int) -> Int ! Diag.Report {
    let tid = tid_of_node(node)
    if tid < 0 { return -1 }
    let rec = layout_of(tid, Position.Local)
    let why = rec.decline_reason
    if why != "" {
        diag_ice_at("UnspellableClosureType", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "closure has no C layout: {why}", node,
            "monomorphisation must resolve every type codegen reads; this is a compiler bug")
        return -1
    }
    let free = closure_free_names(node)
    if !captures_are_buildable(node, free) { return -1 }
    let tids: List[Int] = []
    let words = capture_words(node, free, tids)
    let symbol = c_mint_local("closure")
    eff_thunks.push(PendingThunk {
        closure: node, symbol: symbol, fn_tid: tid, cap_names: free, cap_tids: tids,
    })
    ir_closure_new(tid, node, rec.c_spelling, symbol, "", "", words)
}

// One capture word per captured name, in first-read order, built in the frame the literal
// was written in because that is where the name still resolves. The thunk reads each word
// back by the position it was built at. Every name is known buildable before this runs.
fn capture_words(node: Int, free: List[Str], tids: List[Int]) -> List[Int] ! Diag.Report {
    let mut out: List[Int] = []
    for nm in free {
        let ntid = tid_of_binder(current_binder_scope(), nm)
        let slot = layout_of(ntid, Position.ContainerSlot)
        let loc = layout_of(ntid, Position.Local)
        let read = ir_var_ref(ntid, node, loc.c_spelling, c_local_name(nm), loc.slot_form)
        if slot.slot_form == SlotForm.PointerBoxed {
            // Too wide for the word, so the word holds the address of a heap copy. The
            // binding is not assignable -- the gate above refused it otherwise -- so the
            // copy answers what the original answers for as long as the closure lives.
            out.push(ir_box(ntid, node, slot.c_spelling, loc.c_spelling, read))
        } else {
            // A pointer already is a word. Everything else goes through the integer bridge
            // ContainerSlot names, so the value that comes back out is the value that went in.
            out.push(if slot.slot_word == "" { read } else { ir_cast(ntid, node, slot.slot_word, read) })
        }
        tids.push(ntid)
    }
    out
}

// Whether every captured name can be held in a capture word, and may be copied into one.
//
// The representational question is asked first and per name. Whether a value fits a word
// is a property of its type alone, so it holds whatever the enclosing frame recorded, and
// a refusal that names the type is the more useful of the two when both apply.
//
// sections/02_syntax.md has a `let mut` binding shared with its closure, not copied: a
// write on either side is visible on the other, which needs one cell both read through.
// Copying the value instead compiles, and then answers the pre-write number on one side
// and drops the closure's writes on the other. A `let` binding carries no such rule, so
// copying it is what the spec calls observationally equivalent.
//
// The answer comes off the binder frame, the same entry the capture's type comes from, so
// the name is resolved once. A bind site that records nothing answers Unknown and the
// capture is refused: a binder that cannot be told from a shared one is treated as one.
fn captures_are_buildable(node: Int, free: List[Str]) -> Bool ! Diag.Report {
    if free.len() == 0 { return true }
    let scope = current_binder_scope()
    let mut shared: List[Str] = []
    let mut unrecorded: List[Str] = []
    for nm in free {
        let m = binder_mutability_of(scope, nm)
        if m == BinderMut.Mutable { shared.push(nm) }
        if m == BinderMut.Unknown { unrecorded.push(nm) }
    }
    if shared.len() > 0 {
        diag_ice_at("SharedMutableCaptureNotLowered", CODEGEN_STAGE_NOT_BUILT,
            "closure captures {join_names(shared)}, which the enclosing function can assign, and a shared mutable binding has no cell yet",
            node, "a mutable binding is shared with its closure rather than copied; copying the value would lose a write on each side")
        return false
    }
    if unrecorded.len() > 0 {
        diag_ice_at("CaptureMutabilityNotRecorded", CODEGEN_STAGE_NOT_BUILT,
            "closure captures {join_names(unrecorded)}, bound where codegen records no mutability, and a binding that might be shared has no cell yet",
            node, "parameters and pattern binders do not record mutability yet; until their bind site does, a capture of one cannot be told from a shared binding")
        return false
    }
    for nm in free {
        let ntid = tid_of_binder(scope, nm)
        let slot = layout_of(ntid, Position.ContainerSlot)
        if !capture_layout_spells(node, nm, slot.decline_reason) { return false }
        if slot.slot_form == SlotForm.PointerBoxed {
            let value = layout_of(ntid, Position.Local)
            if !capture_layout_spells(node, nm, value.decline_reason) { return false }
            // The copy is allocated and read back by the value's own spelling, which for a
            // carrier names a typedef this unit has to declare before either site reads it.
            let _ = ensure_typedef_for(ntid)
        }
    }
    true
}

// Whether one capture's layout spelled. A decline is the same report at either position,
// so both sites read one producer rather than writing the message twice.
fn capture_layout_spells(node: Int, nm: Str, why: Str) -> Bool ! Diag.Report {
    if why == "" { return true }
    diag_ice_at("UnspellableCaptureType", UNSOLVED_TYPEVAR_AT_CODEGEN,
        "captured local '{nm}' has no C layout: {why}", node,
        "monomorphisation must resolve every type codegen reads; this is a compiler bug")
    false
}

fn join_names(names: List[Str]) -> Str {
    let mut out = ""
    let mut i = 0
    while i < names.len() {
        if i > 0 { out = "{out}, " }
        out = "{out}'{names.get(i).unwrap()}'"
        i = i + 1
    }
    out
}

// ── The thunk queue ───────────────────────────────────────────────────────────────

pub fn cg_eff_pending_thunks() -> Int { eff_thunks.len() }

// The driver calls this once it has printed every queued thunk, so the next body's
// queue starts empty and a thunk is never defined twice. A thunk body can queue a
// nested closure while the driver is draining, so a driver that fixed its count before
// the loop would leave a closure record pointing at a function nothing defines; the
// count it printed has to match the queue before the queue may go.
pub fn cg_eff_thunks_drained(printed: Int) ! Diag.Report {
    if printed != eff_thunks.len() {
        diag_ice("ThunkQueueNotDrained", POISONED_IR_AT_SEAM,
            "the driver printed {printed} thunks but {eff_thunks.len()} are queued", 0, 0,
            "re-read cg_eff_pending_thunks on every step: a thunk body can queue another thunk")
        return
    }
    eff_thunks = []
}

// A queue index the driver never handed out is a driver bug, and the readers below have
// no node to blame it on, so the report carries no position.
fn thunk_at(i: Int) -> Int ! Diag.Report {
    if i >= 0 && i < eff_thunks.len() { return i }
    diag_ice("NoSuchThunk", POISONED_IR_AT_SEAM,
        "thunk {i} is not in the queue of {eff_thunks.len()}", 0, 0,
        "the driver must read the queue through cg_eff_pending_thunks before indexing it")
    -1
}

pub fn cg_eff_thunk_symbol(i: Int) -> Str ! Diag.Report {
    let t = thunk_at(i)
    if t < 0 { return "" }
    eff_thunks.get(t).unwrap().symbol
}

// The block the thunk's body lowers from, in the same shape lower_block_returning takes.
pub fn cg_eff_thunk_body_node(i: Int) -> Int ! Diag.Report {
    let t = thunk_at(i)
    if t < 0 { return -1 }
    node_body(eff_thunks.get(t).unwrap().closure)
}

// The C spelling of the thunk's result, read from the closure's own Fn type. A closure
// that declares no result carries the void type there, and the return position is where
// layout spells that type as nothing.
pub fn cg_eff_thunk_ret(i: Int) -> Str ! Diag.Report {
    let t = thunk_at(i)
    if t < 0 { return "" }
    let th = eff_thunks.get(t).unwrap()
    thunk_spelling(cg_eff_thunk_ret_tid(i), Position.Return, th.closure)
}

// The closure's result, and the only place the queue is read for it. Two readers want it
// in different shapes: the body lowering wants the type, because the arm a `?` takes is
// decided by the kind, and the signature wants the C spelling. Both come through here, so
// a change to where the result sits moves one reader, not two that can drift apart.
//
// -1 when the queue holds no such thunk, which has already been reported, or when the Fn
// type carries no result there, which has not. A caller that refuses on -1 should only do
// so for an index it knows the queue holds.
pub fn cg_eff_thunk_ret_tid(i: Int) -> Int ! Diag.Report {
    let t = thunk_at(i)
    if t < 0 { return -1 }
    child_tid(eff_thunks.get(t).unwrap().fn_tid, Slot.Inner1)
}

// One `<spelling> <name>` per parameter, in declaration order. The name is the local's
// own producer, because the body reads each parameter as a local and the declaration has
// to introduce the identifier those reads spell.
pub fn cg_eff_thunk_params(i: Int) -> List[Str] ! Diag.Report {
    let mut out: List[Str] = []
    let t = thunk_at(i)
    if t < 0 { return out }
    let th = eff_thunks.get(t).unwrap()
    let ps = node_params(th.closure)
    if ps == -1 { return out }
    let mut k = 0
    while k < sublist_length(ps) {
        let p = sublist_get(ps, k)
        let spelling = thunk_spelling(child_tid(th.fn_tid, Slot.Param(k)), Position.Param, p)
        if spelling == "" { return [] }
        out.push("{spelling} {c_local_name(node_name(p))}")
        k = k + 1
    }
    out
}

// A layout decline is an ICE and an empty spelling, so a caller can stop on "".
fn thunk_spelling(tid: Int, position: Position, node: Int) -> Str ! Diag.Report {
    if tid < 0 {
        diag_ice_at("ClosureTypeHasNoSlot", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "the closure's Fn type has no type in the slot this parameter or result needs", node,
            "typecheck stamps a closure with one type per parameter and one result; this is a compiler bug")
        return ""
    }
    layout_or_ice(tid, position, node, "UnspellableThunkSlot", "closure parameter or result").c_spelling
}

// A layout this stage reads. A decline is reported once here under the caller's name for
// the slot, and the caller reads the empty spelling as the stop.
fn layout_or_ice(tid: Int, position: Position, node: Int, ice: Str, what: Str) -> LayoutRecord ! Diag.Report {
    let rec = layout_of(tid, position)
    let why = rec.decline_reason
    if why != "" {
        diag_ice_at(ice, UNSOLVED_TYPEVAR_AT_CODEGEN, "{what} has no C layout: {why}", node,
            "monomorphisation must resolve every type codegen reads; this is a compiler bug")
    }
    rec
}

// Prints one queued thunk as a function definition. The body arrives already lowered: it
// goes through the statement stage, which this file cannot import, so the driver lowers it
// under cg_eff_thunk_open and hands the result here. A signature slot that did not spell
// has recorded its own report, and a definition with a hole in its signature is not
// printed on top of it.
pub fn cg_eff_print_thunk(i: Int, body: Int) ! Diag.Report {
    let t = thunk_at(i)
    if t < 0 || body < 0 { return }
    let th = eff_thunks.get(t).unwrap()
    let ret = cg_eff_thunk_ret(i)
    if ret == "" { return }
    let params = cg_eff_thunk_params(i)
    let ps = node_params(th.closure)
    let declared = if ps == -1 { 0 } else { sublist_length(ps) }
    if params.len() != declared { return }
    let whole = with_capture_prologue(th, body)
    if whole < 0 { return }
    print_closure_thunk(ret, th.symbol, params, whole)
}

// The body with one declaration per captured name in front of it, each read back out of
// __self at the position its word was built at.
//
// The body lowered its captures as plain local reads, because that is what they are inside
// the thunk, so the prologue is what makes those identifiers exist. __self is the closure
// itself, which is why it carries the thunk's own Fn type.
fn with_capture_prologue(th: PendingThunk, body: Int) -> Int ! Diag.Report {
    if th.cap_names.len() == 0 { return body }
    let index_rec = perform_layout(TYPE_INT, Position.Local, th.closure)
    if index_rec.c_spelling == "" { return -1 }
    let mut stmts: List[Int] = []
    let mut i = 0
    while i < th.cap_names.len() {
        let nm = th.cap_names.get(i).unwrap()
        let ntid = th.cap_tids.get(i).unwrap()
        let slot = layout_of(ntid, Position.ContainerSlot)
        let loc = layout_of(ntid, Position.Local)
        if slot.decline_reason != "" || loc.decline_reason != "" {
            diag_ice_at("UnspellableCaptureType", UNSOLVED_TYPEVAR_AT_CODEGEN,
                "captured local '{nm}' has no C layout in the thunk that reads it", th.closure,
                "the same type spelled at the literal's site must spell again where the thunk declares it")
            return -1
        }
        // "__self" is the name cg_emit gives the receiver word in every thunk's parameter
        // list, so the two have to agree on it.
        let self_ref = ir_var_ref(th.fn_tid, th.closure, closure_self_spelling(), "__self", SlotForm.InlineWord)
        let index = ir_const(TYPE_INT, th.closure, index_rec.c_spelling, "{i}")
        let raw = ir_call_runtime(ntid, th.closure, container_slot_spelling(),
            c_runtime_helper("closure_get_capture"), SlotForm.InlineWord, [self_ref, index])
        // The pun the word was built through, undone in the same order.
        let punned = if slot.slot_word == "" { raw } else { ir_cast(ntid, th.closure, slot.slot_word, raw) }
        // A boxed capture travels as the address of a heap copy, so the name binds to what
        // the address holds. Binding the address instead would read a pointer as the value.
        let init = if slot.slot_form == SlotForm.PointerBoxed {
            ir_unbox(ntid, th.closure, loc.c_spelling, loc.slot_form,
                ir_cast(ntid, th.closure, slot.c_spelling, punned))
        } else {
            ir_cast(ntid, th.closure, loc.c_spelling, punned)
        }
        stmts.push(ir_let(ntid, th.closure, loc.c_spelling, c_local_name(nm), loc.slot_form, init))
        i = i + 1
    }
    stmts.push(body)
    ir_block(th.closure, stmts)
}

// Opens the thunk's own binder frame with its parameters bound at their types, and answers
// the frame; the caller lowers the body inside it and then calls cg_eff_thunk_close.
//
// Layout parents a new frame to whatever frame is open. A thunk opened inside another
// function's frame would resolve that function's locals, and the body would then read C
// identifiers the thunk never declares. So an open frame is refused, not adopted.
pub fn cg_eff_thunk_open(i: Int) -> Int ! Diag.Report {
    let t = thunk_at(i)
    if t < 0 { return -1 }
    let th = eff_thunks.get(t).unwrap()
    if current_binder_scope() != -1 {
        diag_ice_at("ThunkFrameNested", POISONED_IR_AT_SEAM,
            "a closure thunk's frame cannot open while another function's frame is open", th.closure,
            "the driver drains the thunk queue after the enclosing body has closed its frame")
        return -1
    }
    let scope = binder_scope_push()
    eff_thunk_scope = scope
    if !bind_thunk_params(th, scope) {
        cg_eff_thunk_close()
        return -1
    }
    scope
}

// Pops only the frame cg_eff_thunk_open pushed. A close with no thunk open, or with a
// body's frame still above the thunk's, is a caller that lost track of its frames, and
// popping there would take a frame that belongs to someone else.
pub fn cg_eff_thunk_close() ! Diag.Report {
    if eff_thunk_scope < 0 {
        diag_ice("ThunkNotOpen", POISONED_IR_AT_SEAM, "a closure thunk was closed but none is open", 0, 0,
            "the driver pairs every cg_eff_thunk_close with the cg_eff_thunk_open before it")
        return
    }
    if current_binder_scope() != eff_thunk_scope {
        diag_ice("ThunkFrameUnbalanced", POISONED_IR_AT_SEAM,
            "a closure thunk was closed while a frame opened inside its body is still open", 0, 0,
            "every frame the body lowering opens must close before the thunk does")
        return
    }
    binder_scope_pop()
    eff_thunk_scope = -1
}

// The parameter types come from the Fn tid, the same source the signature is spelled
// from, so a binder and its declaration cannot disagree. Answers false when a slot has no
// type: a parameter left unbound would resolve to an outer name instead.
fn bind_thunk_params(th: PendingThunk, scope: Int) -> Bool ! Diag.Report {
    let ps = node_params(th.closure)
    if ps == -1 { return true }
    let mut k = 0
    while k < sublist_length(ps) {
        let p = sublist_get(ps, k)
        let tid = child_tid(th.fn_tid, Slot.Param(k))
        if tid < 0 {
            diag_ice_at("ClosureParamHasNoType", UNSOLVED_TYPEVAR_AT_CODEGEN,
                "closure parameter '{node_name(p)}' has no type in the closure's Fn type", p,
                "typecheck stamps a closure with one type per parameter; this is a compiler bug")
            return false
        }
        bind_binder(scope, node_name(p), tid)
        k = k + 1
    }
    // A capture is a local of the thunk, at the type it was bound at where the literal was
    // written. Without it the body's reads would find no binder and resolve nowhere.
    let mut c = 0
    while c < th.cap_names.len() {
        bind_binder(scope, th.cap_names.get(c).unwrap(), th.cap_tids.get(c).unwrap())
        c = c + 1
    }
    true
}

// ── Captures ──────────────────────────────────────────────────────────────────────

// The names a closure body reads that are locals of the enclosing function: bound in the
// frame open at the literal's site and not bound by the closure itself. A name the body
// binds for itself, in any of the forms that introduce one, is not a capture even when the
// enclosing function binds the same spelling. A name bound nowhere is a module-level name
// or a namespace, which a thunk reaches without help.
fn closure_free_names(closure: Int) -> List[Str] {
    let mut out: List[Str] = []
    let mut bound: List[Str] = []
    push_param_names(closure, bound)
    scan_free(node_body(closure), bound, out)
    out
}

fn scan_free(node: Int, bound: List[Str], out: List[Str]) {
    if node < 0 { return }
    match nk_of(node_kind(node)) {
        NodeKind.Ident => note_ident(node, bound, out)
        NodeKind.Block => scan_block(node, bound, out)
        NodeKind.ForIn => scan_for(node, bound, out)
        NodeKind.MatchArm => scan_arm(node, bound, out)
        NodeKind.WithBlock => scan_with(node, bound, out)
        NodeKind.Closure => scan_fn_like(node, bound, out)
        NodeKind.FnDef => scan_fn_like(node, bound, out)
        _ => scan_kids(node, bound, out)
    }
}

fn scan_kids(node: Int, bound: List[Str], out: List[Str]) {
    for kid in node_value_child_ids(node) { scan_free(kid, bound, out) }
}

// The parser stores each literal chunk of an interpolated string as an Ident whose name
// is the chunk's text, so a chunk spelled like an enclosing local is not a read of it.
fn note_ident(node: Int, bound: List[Str], out: List[Str]) {
    if is_literal_string_part(node) == 1 { return }
    note_free(node_name(node), bound, out)
}

fn note_free(name: Str, bound: List[Str], out: List[Str]) {
    if bound.contains(name) || out.contains(name) { return }
    if tid_of_binder(current_binder_scope(), name) >= 0 { out.push(name) }
}

// A block's `let` binds from the statement after it, and its initializer is read before
// the name binds, so `let n = n + 1` reads the outer `n` the source names.
fn scan_block(node: Int, bound: List[Str], out: List[Str]) {
    let sl = node_stmts(node)
    if sl == -1 { return }
    let mut inner = copy_names(bound)
    let mut i = 0
    while i < sublist_length(sl) {
        let s = sublist_get(sl, i)
        if nk_of(node_kind(s)) == NodeKind.LetBinding {
            scan_free(node_value(s), inner, out)
            if node_name(s) != "" { inner.push(node_name(s)) }
            pattern_names(node_elements(s), inner)
        } else {
            scan_free(s, inner, out)
        }
        i = i + 1
    }
}

fn scan_for(node: Int, bound: List[Str], out: List[Str]) {
    scan_free(node_iterable(node), bound, out)
    let inner = copy_names(bound)
    pattern_names(node_for_binder(node), inner)
    pattern_names(node_elements(node), inner)
    scan_free(node_body(node), inner, out)
}

fn scan_arm(node: Int, bound: List[Str], out: List[Str]) {
    let inner = copy_names(bound)
    pattern_names(node_pattern(node), inner)
    scan_free(node_guard(node), inner, out)
    scan_free(node_body(node), inner, out)
}

// A later `with` item can read an earlier item's binder, so the items bind in order.
fn scan_with(node: Int, bound: List[Str], out: List[Str]) {
    let mut inner = copy_names(bound)
    let hs = node_handlers(node)
    if hs != -1 {
        let mut i = 0
        while i < sublist_length(hs) {
            let h = sublist_get(hs, i)
            scan_kids(h, inner, out)
            if nk_of(node_kind(h)) == NodeKind.WithResource && node_name(h) != "" { inner.push(node_name(h)) }
            i = i + 1
        }
    }
    scan_free(node_body(node), inner, out)
}

// A nested closure, or a handler method written inside the body: its parameters are its
// own, and what its body reads from outside is what the outer closure reads.
fn scan_fn_like(node: Int, bound: List[Str], out: List[Str]) {
    let inner = copy_names(bound)
    push_param_names(node, inner)
    scan_free(node_body(node), inner, out)
}

fn push_param_names(fn_like: Int, bound: List[Str]) {
    let ps = node_params(fn_like)
    if ps == -1 { return }
    let mut i = 0
    while i < sublist_length(ps) {
        bound.push(node_name(sublist_get(ps, i)))
        i = i + 1
    }
}

// Every name a pattern introduces. A variant name written as a pattern lands here too,
// which is harmless: a pattern never reads a local, so nothing it names can be a capture.
fn pattern_names(pat: Int, bound: List[Str]) {
    if pat < 0 { return }
    match nk_of(node_kind(pat)) {
        NodeKind.Ident => bound.push(node_name(pat))
        NodeKind.IdentPattern => bound.push(node_name(pat))
        NodeKind.AsPattern => {
            bound.push(node_name(pat))
            pattern_names(node_pattern(pat), bound)
        }
        // `Point { x }` binds the field's own name; `Point { x: p }` binds through p.
        NodeKind.StructLitField => {
            if node_pattern(pat) >= 0 { pattern_names(node_pattern(pat), bound) } else { bound.push(node_name(pat)) }
        }
        _ => { for kid in node_value_child_ids(pat) { pattern_names(kid, bound) } }
    }
}

// Lists are references, so a scope that adds names works on a copy of its parent's.
fn copy_names(names: List[Str]) -> List[Str] {
    let mut out: List[Str] = []
    for n in names { out.push(n) }
    out
}

// ── Handler installs ──────────────────────────────────────────────────────────────

// A `with` item that is not a resource and not `arena` installs a handler: one field of the
// effect vector holds the handler for the length of the body. Which field is a fact about
// the handler's type, read off the tid typecheck stamped on the item, so an inline
// `handler E { }`, a local of type Handler[E] and a call answering one all land in the
// same slot. The handler value and the body arrive lowered by the stages that own them.
//
// A caller that already recorded an error hands in -1, and gets -1 back without a second
// report, so one bug reads as one.
pub fn cg_eff_lower_handler_install(item: Int, handler_value: Int, body: Int) -> Int ! Diag.Report {
    if handler_value < 0 || body < 0 { return -1 }
    let tid = tc_resolve(tid_of_node(item))
    if tid < 0 { return -1 }
    let effect_name = tc_tid_handler_effect(tid)
    if effect_name == "" {
        diag_ice_at("WithItemNotAHandler", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "with-item type {tid} is not a handler of a named effect", item,
            "typecheck stamps every non-resource with-item as Handler[E]; this is a compiler bug")
        return -1
    }
    let field = ev_field_of(tid, item)
    if field == "" { return -1 }
    ir_handler_install(item, field, handler_value, body)
}

// The vector field a handler tid owns. A tid that names none is a compiler bug: an effect
// that reaches codegen is declared or builtin, so its root owns a field.
fn ev_field_of(handler_tid: Int, node: Int) -> Str ! Diag.Report {
    let field = c_ev_field_name(handler_tid)
    if diag_is_ice_seg(field) {
        diag_ice_at("EffectSlotUnnamed", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "effect '{tc_tid_handler_effect(handler_tid)}' names no effect vector field: {field}", node,
            "an effect that reaches codegen is declared or builtin, so its root owns a field")
        return ""
    }
    field
}

// ── Effect performs ───────────────────────────────────────────────────────────

// A perform is a virtual call: the vector's field for the effect's root holds a vtable
// pointer, and the operation is one slot of it. Both halves of the address are producers'
// answers, the field cname's for the handler tid and the slot cname's for a builtin pair
// or the member name of a user operation.
//
// The vector read is the program's one global instance. A handler install writes the
// global in place for the length of its body and restores it on the way out, so the global
// is the innermost handler wherever the perform sits, inside a function that also holds a
// vector parameter or not.

// The two builtin namespaces whose operations the runtime dispatches through a vtable, and
// the one operation whose slot answers a nullable text where the call answers an Option.
let NS_IO = "io"
let NS_ENV = "env"
let ENV_VAR = "var"

// The carrier member an Option payload lands in; the printer designates it by this name.
let CARRIER_VALUE = "value"

fn ev_read(node: Int) -> Int {
    ir_evidence_vector(node, c_ev_type_name(), c_ev_global_name(), SlotForm.Inline)
}

fn perform_layout(tid: Int, position: Position, node: Int) -> LayoutRecord ! Diag.Report {
    layout_or_ice(tid, position, node, "UnspellablePerformType", "effect operation")
}

// The handler slot of the vector for a root effect. A handler is a vtable pointer, so the
// slot is held by pointer, which is what lets the perform reach its member through it.
fn slot_read(node: Int, handler_tid: Int) -> Int ! Diag.Report {
    let field = ev_field_of(handler_tid, node)
    if field == "" { return -1 }
    let rec = perform_layout(handler_tid, Position.Local, node)
    if rec.c_spelling == "" { return -1 }
    ir_field_get(handler_tid, node, rec.c_spelling, field, SlotForm.PointerBoxed, ev_read(node))
}

// The root effect behind a builtin namespace. The pair is checked against cname's field
// producer, so the namespace a caller writes and the field the vector holds cannot drift
// apart without a report.
fn builtin_handler_tid(ns: Str, node: Int) -> Int ! Diag.Report {
    let root = if ns == NS_IO { "IO" } else if ns == NS_ENV { "Env" } else { "" }
    let tid = if root == "" { -1 } else { make_handler_type(root) }
    if tid < 0 || c_ev_field_name(tid) != ns {
        diag_ice_at("BuiltinNamespaceNotAnEffect", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "namespace '{ns}' owns no field of the evidence vector", node,
            "only the io and env namespaces perform through the vector; this is a compiler bug")
        return -1
    }
    tid
}

fn lower_args(node: Int) -> Option[List[Int]] ! Diag.Report {
    let written = node_args(node)
    let mut out: List[Int] = []
    let mut i = 0
    while i < sublist_length(written) {
        let a = lower_expr(sublist_get(written, i))
        if a < 0 { return None }
        out.push(a)
        i = i + 1
    }
    Some(out)
}

// An operation of the io or env namespace, reached through the runtime's vtable for it.
//
// The io slots take text, and the surface accepts any value the Display trait renders, so
// an io argument is rendered first: text passes as it is, a struct or enum through its
// Display impl, and a kind whose rendering is private to the expression stage is refused
// before anything is built. The env slots take what their signatures declare, which
// typecheck has already checked, so an env argument passes as it is.
pub fn cg_eff_lower_builtin_perform(node: Int, ns: Str, method: Str) -> Int ! Diag.Report {
    let slot = c_builtin_effect_slot(ns, method)
    if diag_is_ice_seg(slot) {
        diag_ice_at("BuiltinEffectOpNotASlot", CODEGEN_STAGE_NOT_BUILT,
            "'{ns}.{method}' is no slot of the runtime's {ns} vtable", node,
            "the runtime dispatches the io print names and the env names through a vtable; nothing else performs here")
        return -1
    }
    let handler_tid = builtin_handler_tid(ns, node)
    if handler_tid < 0 { return -1 }
    let call_tid = tid_of_node(node)
    if call_tid < 0 { return -1 }
    let wraps = ns == NS_ENV && method == ENV_VAR
    // The read slot answers a nullable text, not the Option the call holds.
    let tid = if wraps { TYPE_STR } else { call_tid }
    let rec = perform_layout(tid, Position.Local, node)
    if rec.c_spelling == "" { return -1 }
    let args = if ns == NS_IO { lower_text_args(node) } else { lower_args(node) }
    match args {
        None => -1
        Some(lowered) => {
            let read = slot_read(node, handler_tid)
            if read < 0 { return -1 }
            let perform = ir_effect_perform(tid, node, rec.c_spelling, slot, rec.slot_form, read, lowered)
            if wraps { return wrap_nullable_text(node, call_tid, perform) }
            perform
        }
    }
}

// Every io argument rendered to text. The kinds are read before any argument is lowered,
// so a refusal leaves nothing hoisted behind it.
fn lower_text_args(node: Int) -> Option[List[Int]] ! Diag.Report {
    let written = node_args(node)
    let mut out: List[Int] = []
    let mut i = 0
    while i < sublist_length(written) {
        let value = lower_value_as_text(sublist_get(written, i))
        if value < 0 { return None }
        out.push(value)
        i = i + 1
    }
    Some(out)
}

// The runtime's env read answers a text pointer that is null for an unset name, and the
// call holds an Option. The read lands in a temp, the Option starts as None, and the Some
// is written only when the temp holds text; the answer is a reference to the Option temp.
fn wrap_nullable_text(node: Int, opt_tid: Int, perform: Int) -> Int ! Diag.Report {
    if tc_tid_kind(tc_resolve(opt_tid)) != TyKind.Option {
        diag_ice_at("NullableSlotAnswerNotOption", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "a nullable slot read is typed {tk_name(tc_tid_kind(tc_resolve(opt_tid)))} where an Option is needed", node,
            "typecheck signs env.var as Option[Str]; this is a compiler bug")
        return -1
    }
    let text = perform_layout(TYPE_STR, Position.Local, node)
    let opt = perform_layout(opt_tid, Position.Local, node)
    let tag_rec = perform_layout(TYPE_INT, Position.Local, node)
    if text.c_spelling == "" || opt.c_spelling == "" || tag_rec.c_spelling == "" { return -1 }
    let raw_name = c_mint_local("env_raw")
    let opt_name = c_mint_local("env_opt")
    let none = ir_carrier_wrap(opt_tid, node, opt.c_spelling, "", ir_const(TYPE_INT, node, tag_rec.c_spelling, "0"), -1)
    let payload = ir_var_ref(TYPE_STR, node, text.c_spelling, raw_name, text.slot_form)
    let some = ir_carrier_wrap(opt_tid, node, opt.c_spelling, CARRIER_VALUE,
        ir_const(TYPE_INT, node, tag_rec.c_spelling, "1"), payload)
    let target = ir_var_ref(opt_tid, node, opt.c_spelling, opt_name, opt.slot_form)
    let cond = ir_var_ref(TYPE_STR, node, text.c_spelling, raw_name, text.slot_form)
    cg_expr_push_pending(node, ir_let(TYPE_STR, node, text.c_spelling, raw_name, text.slot_form, perform))
    cg_expr_push_pending(node, ir_let(opt_tid, node, opt.c_spelling, opt_name, opt.slot_form, none))
    cg_expr_push_pending(node, ir_if(node, cond, ir_block(node, [ir_assign(node, target, some)]), -1))
    ir_var_ref(opt_tid, node, opt.c_spelling, opt_name, opt.slot_form)
}

// An operation of a user effect, written `handle.op(args)` on the lowered handle name of
// its root effect. The slot is the operation's member of the root's vtable, spelled by the
// same producer the declaration used.
//
// The vtable slot erases a bare Option over a boxed nominal answer to the shared pointer
// Option, and C holds the two as different struct types, so a call whose own type is the
// nominal Option cannot take the slot's answer without a conversion no IR node writes
// yet. That perform is refused by name rather than assigned across the two types.
pub fn cg_eff_lower_user_perform(node: Int) -> Int ! Diag.Report {
    let handle = node_name(node_obj(node))
    let op = node_method(node)
    let decl = user_effect_decl(handle, op, node)
    if decl < 0 { return -1 }
    let tid = tid_of_node(node)
    if tid < 0 { return -1 }
    let rec = perform_layout(tid, Position.Local, node)
    if rec.c_spelling == "" { return -1 }
    let k = tc_tid_kind(tc_resolve(tid))
    if k != TyKind.Void && k != TyKind.Never {
        let slot_rec = perform_layout(tid, Position.VtableSlot, node)
        if slot_rec.c_spelling == "" { return -1 }
        if slot_rec.c_spelling != rec.c_spelling {
            diag_ice_at("PerformAnswerErasedInSlot", CODEGEN_STAGE_NOT_BUILT,
                "'{handle}.{op}' answers {slot_rec.c_spelling} from its slot where the call holds {rec.c_spelling}", node,
                "a perform whose slot erases its answer needs a conversion node between the two struct types")
            return -1
        }
    }
    match lower_args(node) {
        None => -1
        Some(lowered) => {
            let read = slot_read(node, make_handler_type(node_name(decl)))
            if read < 0 { return -1 }
            ir_effect_perform(tid, node, rec.c_spelling, c_field_name(op), rec.slot_form, read, lowered)
        }
    }
}

// ── The evidence argument of an effectful call ─────────────────────────────────

// The argument a call appends when its callee carries an effect row. The callee receives
// the vector as a trailing `blink_ev*`, so what a caller passes is the address of the
// program's one vector, which is exact everywhere because a handler install writes that
// vector in place and restores it on the way out.
//
// The global read is the operand even inside a function that holds a vector parameter: one
// vector means the two are the same address, and the IR admits no other operand here, since
// a parameter is already its own address.
//
// The signature still answers `! Diag.Report` because every caller is written against it
// and reaches it before lowering anything; nothing in this body raises.
pub fn cg_eff_ev_argument(node: Int) -> Int ! Diag.Report {
    ir_evidence_address(node, ev_read(node))
}

// The root effect declaration a handle names, checked to declare the operation. The
// handle typecheck registers is the lowered root name, so the same lowering finds it.
fn user_effect_decl(handle: Str, op: Str, node: Int) -> Int ! Diag.Report {
    for e in cg_reg_effect_decls() {
        if node_name(e).to_lower() != handle { continue }
        if declares_op(e, op) { return e }
        diag_ice_at("UserEffectOpUnknown", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "effect '{node_name(e)}' declares no operation '{op}'", node,
            "typecheck resolves every perform against the effect's operations; this is a compiler bug")
        return -1
    }
    diag_ice_at("UserEffectHandleUnknown", UNSOLVED_TYPEVAR_AT_CODEGEN,
        "'{handle}' is the handle of no declared effect", node,
        "typecheck registers one handle per root effect; this is a compiler bug")
    -1
}

// Operations live under the sub-effects of a root, never on the root itself.
fn declares_op(effect_decl: Int, op: Str) -> Bool {
    let children = node_elements(effect_decl)
    if children == -1 { return false }
    let mut ci = 0
    while ci < sublist_length(children) {
        let ops = node_methods(sublist_get(children, ci))
        let mut oi = 0
        while ops != -1 && oi < sublist_length(ops) {
            if node_name(sublist_get(ops, oi)) == op { return true }
            oi = oi + 1
        }
        ci = ci + 1
    }
    false
}
