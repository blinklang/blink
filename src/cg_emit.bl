// cg_emit.bl: the C text buffer and the C-ABI text forms.
//
// This module holds the only C text the compiler writes. It knows nothing about types:
// every function takes strings (a spelling, a symbol, a field name) and writes them into
// the buffer verbatim. cg_print.bl is the only module that may import it.
//
// The three pub globals are the buffer, the indent depth and the temp counter. They are the
// whole mutable state of emission that a unit changes, and are on the lint allowlist. The
// one other global below holds a constant table and is filled once per process.

pub let mut em_lines: List[Str] = []
pub let mut em_indent: Int = 0
pub let mut em_temp_counter: Int = 0

pub fn em_reset() {
    em_lines = []
    em_indent = 0
    em_temp_counter = 0
}

pub fn em_line(line: Str) {
    if line == "" {
        em_lines.push("")
        return
    }
    let mut pad = ""
    let mut i = 0
    while i < em_indent {
        pad = pad.concat("    ")
        i += 1
    }
    em_lines.push(pad.concat(line))
}

// Lines that must start in column 0 whatever the indent: preprocessor directives.
pub fn em_directive(line: Str) { em_lines.push(line) }

pub fn em_indent_push() { em_indent += 1 }

pub fn em_indent_pop() {
    if em_indent > 0 { em_indent -= 1 }
}

pub fn em_reset_temps() { em_temp_counter = 0 }

pub fn em_temp(prefix: Str) -> Str {
    let n = em_temp_counter
    em_temp_counter += 1
    "{prefix}{n}"
}

pub fn em_take() -> Str {
    let out = em_lines.join("\n")
    em_lines = []
    out.concat("\n")
}

pub fn em_open_brace(head: Str) {
    em_line("{head} \{")
    em_indent_push()
}

pub fn em_close_brace(tail: Str) {
    em_indent_pop()
    em_line("}{tail}")
}

// ── Prologue and storage gating ──────────────────────────────────────────────
//
// A user TU includes the stdlib archive header and shares runtime storage with it. The
// archive monolith defines that storage. A standalone TU includes runtime.h and owns
// everything itself.
//
// The runtime header and the CLI both read a unit's native dependency gates, the CLI to
// build the link line, so the gates come before any include.

pub fn em_prologue(user_tu: Bool, define_storage: Bool, test_build: Bool, header_guard: Str, self_header: Str, gates: List[Str]) {
    if header_guard != "" {
        em_directive("#ifndef {header_guard}")
        em_directive("#define {header_guard}")
    }
    for gate in gates { em_directive("#define {gate} 1") }
    if user_tu || header_guard != "" || define_storage {
        em_directive("#define BLINK_USE_EXTERN_RUNTIME_STORAGE 1")
    }
    if define_storage { em_directive("#define BLINK_RUNTIME_STORAGE_DEFINE 1") }
    if test_build { em_directive("#define BLINK_TEST_BUILD 1") }
    if user_tu {
        em_directive("#include \"libblink_std.h\"")
    } else {
        em_directive("#include \"runtime.h\"")
    }
    if self_header != "" { em_directive("#include \"{self_header}\"") }
    em_line("")
}

// A header a native dependency ships is read under that dependency's gate, as the runtime
// reads it. `gates` runs parallel to `headers` and holds "" for an unconditional one.
pub fn em_foreign_includes(headers: List[Str], gates: List[Str]) {
    let mut i = 0
    while i < headers.len() {
        let gate = gates.get(i) ?? ""
        if gate != "" { em_directive("#ifdef {gate}") }
        em_directive("#include <{headers.get(i) ?? ""}>")
        if gate != "" { em_directive("#endif") }
        i = i + 1
    }
    if headers.len() > 0 { em_line("") }
}

pub fn em_epilogue(header_guard: Str) {
    if header_guard != "" { em_directive("#endif") }
}

// ── What the prologue already declares ───────────────────────────────────────
//
// The header the prologue includes reaches the C standard headers these names come from, so
// a foreign binding over one of them already has a prototype in the unit. A second one
// written from a Blink signature declares `int64_t labs(int64_t)` against stdlib.h's
// `long labs(long)`, and C rejects the pair.
//
// Only names the prologue reaches unconditionally belong here. math.h is absent because
// nothing includes it; `usleep` because runtime_core.h asks for _POSIX_C_SOURCE 200809L,
// which removed it; the sqlite3 entry points because runtime_sqlite.h includes their header
// only under BLINK_USE_SQLITE. A name listed here that the unit does not in fact declare
// leaves the call with no prototype at all, which is the worse of the two failures: the
// missing name only writes a second declaration that C rejects out loud.
//
// The runtime's own exports carry a reserved prefix and are declared the same way, which
// is why they are a prefix rule here rather than a hundred more names.
fn prologue_symbol_names() -> List[Str] {
    [
        "printf", "fprintf", "sprintf", "snprintf", "fopen", "fclose", "fread", "fwrite",
        "fgets", "fputs", "puts", "scanf", "fflush", "fseek", "ftell", "rewind", "remove",
        "rename", "perror",
        "malloc", "calloc", "realloc", "free", "exit", "abort", "atoi", "atol", "atof",
        "strtol", "strtod", "abs", "labs", "llabs", "rand", "srand", "getenv", "system",
        "qsort", "bsearch",
        "strlen", "strcmp", "strncmp", "strcpy", "strncpy", "strcat", "strncat", "memcpy",
        "memset", "memmove", "memcmp", "strstr", "strchr", "strrchr", "strdup", "strtok",
        "strerror",
        "__errno_location",
        "time", "clock", "difftime", "mktime", "strftime", "localtime", "gmtime",
        "read", "write", "close", "sleep", "getcwd", "chdir", "fork", "execvp", "pipe",
        "dup", "dup2", "access", "unlink", "rmdir", "isatty", "getpid", "lseek", "ftruncate",
        "open", "fcntl",
        "poll",
        "stat", "fstat", "mkdir", "chmod",
        "wait", "waitpid",
        "signal", "kill", "raise",
        "setjmp", "longjmp",
        "opendir", "readdir", "closedir",
        "pthread_create", "pthread_join", "pthread_mutex_init", "pthread_mutex_lock",
        "pthread_mutex_unlock", "pthread_mutex_destroy",
        "socket", "bind", "listen", "accept", "connect", "send", "recv", "sendto",
        "recvfrom", "setsockopt", "getsockopt", "shutdown", "getaddrinfo", "freeaddrinfo",
        "gai_strerror",
        "htons", "htonl", "ntohs", "ntohl", "inet_ntop", "inet_pton",
    ]
}

let mut prologue_symbols: Map[Str, Int] = Map()

pub fn em_prologue_declares(symbol: Str) -> Bool {
    if symbol.starts_with("blink_") { return true }
    if symbol.starts_with("blinkrt_") { return true }
    if symbol.starts_with("__blink") { return true }
    if prologue_symbols.len() == 0 {
        for name in prologue_symbol_names() { prologue_symbols.insert(name, 1) }
    }
    prologue_symbols.contains_key(symbol) != 0
}

// The prototype for a foreign symbol nothing else declares. `extern` is written out
// because a bare declaration reads as a definition to a reader, not because C needs it.
pub fn em_foreign_decl(ret: Str, symbol: Str, params: List[Str]) {
    em_line("extern {fn_signature(false, ret, symbol, params, false)};")
}

// ── Functions ────────────────────────────────────────────────────────────────

// `static int64_t sym(int64_t a, blink_ev* __ev)`. The caller spells an empty parameter
// list as `void`; this helper only joins what it is given.
pub fn fn_signature(is_static: Bool, ret: Str, symbol: Str, params: List[Str], takes_ev: Bool) -> Str {
    let mut ps: List[Str] = []
    for p in params { ps.push(p) }
    if takes_ev { ps.push("blink_ev* __ev") }
    let plist = ps.join(", ")
    let prefix = if is_static { "static " } else { "" }
    "{prefix}{ret} {symbol}({plist})"
}

pub fn em_fn_decl(is_static: Bool, ret: Str, symbol: Str, params: List[Str], takes_ev: Bool) {
    em_line("{fn_signature(is_static, ret, symbol, params, takes_ev)};")
}

pub fn em_fn_open(is_static: Bool, ret: Str, symbol: Str, params: List[Str], takes_ev: Bool) {
    em_open_brace(fn_signature(is_static, ret, symbol, params, takes_ev))
}

pub fn em_fn_close() { em_close_brace("") }

// A closure thunk receives its own closure record first so it can read captures.
pub fn closure_thunk_params(params: List[Str]) -> List[Str] {
    let mut ps: List[Str] = ["const blink_closure* __self"]
    for p in params { ps.push(p) }
    ps
}

// ── Spawn ────────────────────────────────────────────────────────────────────
//
// A spawned closure's task wrapper is the one function the pool thread calls: it unpacks
// the pair the submit site allocated, calls the closure through its own fn_ptr the way an
// inline call would, and stashes the answer in the handle. Every wrapper shares one pair
// shape -- two pointers, neither depending on the closure's own return type -- so one
// typedef serves every spawn site in the unit, printed once and reused.
pub fn em_spawn_pair_typedef(pair_spelling: Str) {
    em_line("typedef struct \{ const blink_closure* closure; blink_handle* handle; } {pair_spelling};")
}

// `boxed` and `slot_word` are the same two facts Position.ContainerSlot answers for a
// container element, read at the closure's own return type: boxed means the value is
// wider than a pointer and travels as the address of a heap copy, and a non-empty
// slot_word is the pointer-wide integer a narrower value is punned through. Neither set
// names a pointer already the cell's own width, which needs no conversion at all.
//
// A closure returning nothing has no answer to box, slot, or pun -- Position.ContainerSlot
// has no inline form for a void-like kind, so `boxed`/`slot_word` are never consulted for
// it -- and the call is made for effect only, with the handle's result set to NULL so an
// awaiter still has something to unblock on. The caller reads the closure's own return
// tid to tell this case apart, not the spelling: cg_emit prints text, it does not compare
// against one.
pub fn em_spawn_task_wrapper(pair_spelling: Str, ret_spelling: Str, task_symbol: Str, is_void: Bool, boxed: Bool, slot_word: Str) {
    em_open_brace("static void {task_symbol}(void* __arg)")
    em_line("{pair_spelling}* __p = ({pair_spelling}*)__arg;")
    if is_void {
        em_line("(({ret_spelling}(*)(const blink_closure*))__p->closure->fn_ptr)(__p->closure);")
        em_line("blink_handle_set_result(__p->handle, (void*)0);")
    } else {
        em_line("{ret_spelling} __r = (({ret_spelling}(*)(const blink_closure*))__p->closure->fn_ptr)(__p->closure);")
        if boxed {
            em_line("{ret_spelling}* __box = ({ret_spelling}*)blink_alloc(sizeof({ret_spelling}));")
            em_line("*__box = __r;")
            em_line("blink_handle_set_result(__p->handle, (void*)__box);")
        } else if slot_word != "" {
            em_line("blink_handle_set_result(__p->handle, (void*)({slot_word})__r);")
        } else {
            em_line("blink_handle_set_result(__p->handle, (void*)__r);")
        }
    }
    em_close_brace("")
}

pub fn em_global_decl(spelling: Str, name: Str, is_extern: Bool) {
    let prefix = if is_extern { "extern " } else { "" }
    em_line("{prefix}{spelling} {name};")
}

// ── Typedef bodies ───────────────────────────────────────────────────────────
//
// The guard macro name comes from cname through the driver; an empty guard writes none.

pub fn em_td_guard_open(guard: Str) {
    if guard == "" { return }
    em_directive("#ifndef {guard}")
    em_directive("#define {guard}")
}

pub fn em_td_guard_close(guard: Str) {
    if guard != "" { em_directive("#endif") }
}

pub fn em_struct_typedef_body(c_name: Str, field_decls: List[Str]) {
    em_open_brace("typedef struct")
    for f in field_decls { em_line("{f};") }
    em_close_brace(" {c_name};")
}

// `fields` holds the mirror's C member names and `c_fields` the original's, in field order.
pub fn em_ffi_layout_asserts(c_name: Str, original: Str, fields: List[Str], c_fields: List[Str]) {
    em_line("_Static_assert(sizeof({c_name}) == sizeof({original}), \"{c_name} size mismatch with C {original}\");")
    let mut i = 0
    while i < fields.len() {
        let f = fields.get(i) ?? ""
        let cf = c_fields.get(i) ?? ""
        em_line("_Static_assert(offsetof({c_name}, {f}) == offsetof({original}, {cf}), \"{c_name}.{f} offset mismatch\");")
        i = i + 1
    }
}

pub fn em_simple_enum_typedef_body(c_name: Str, variant_c_names: List[Str]) {
    em_line("typedef enum \{ {variant_c_names.join(", ")} } {c_name};")
}

// A payload enum: `{ <tag_spelling> <tag_member>; union { struct { ... } Variant; ... } <payload_member>; }`.
// variant_fields holds one `type name` list per variant, in variant order. The tag's
// spelling and the two member names are given by the caller, which is the layer allowed
// to ask what a tagged union is shaped like.
pub fn em_tagged_enum_typedef_body(c_name: Str, tag_spelling: Str, tag_member: Str, payload_member: Str, variant_names: List[Str], variant_fields: List[List[Str]]) {
    em_open_brace("typedef struct")
    em_line("{tag_spelling} {tag_member};")
    em_open_brace("union")
    let mut i = 0
    while i < variant_names.len() {
        // A payload-less variant rides the tag alone. An empty `struct \{}` member is a
        // GNU extension, not C, so the variant contributes no union member at all.
        let vf = variant_fields.get(i).unwrap()
        if vf.len() > 0 {
            em_open_brace("struct")
            for f in vf { em_line("{f};") }
            em_close_brace(" {variant_names.get(i).unwrap()};")
        }
        i += 1
    }
    em_close_brace(" {payload_member};")
    em_close_brace(" {c_name};")
}

pub fn em_tag_macro(macro_name: Str, value: Int) {
    em_directive("#ifndef {macro_name}")
    em_directive("#define {macro_name} {value}")
    em_directive("#endif")
}

// ── Effects ──────────────────────────────────────────────────────────────────

// `typedef struct { RET (*slot)(void* __self, params); ... void* __userdata_slot; ... } <vtable>;`
// All function pointers come first, then one capture word per op, as the archive was built.
// An effect with no ops keeps one word so the struct is never empty. Arena promotion copies
// the struct whole and then each capture word by its member name, so every op needs its own.
pub fn em_effect_vtable_typedef_body(vtable_c_name: Str, slots: List[Str], userdata_members: List[Str], slot_rets: List[Str], slot_params: List[List[Str]]) {
    em_open_brace("typedef struct")
    let mut i = 0
    while i < slots.len() {
        let plist = slot_params.get(i).unwrap().join(", ")
        em_line("{slot_rets.get(i).unwrap()} (*{slots.get(i).unwrap()})({plist});")
        i += 1
    }
    for member in userdata_members { em_line("void* {member};") }
    if slots.len() == 0 { em_line("void* __userdata;") }
    em_close_brace(" {vtable_c_name};")
}

pub fn em_effect_default_vtable(vtable_c_name: Str, default_fn_symbols: List[Str]) {
    em_open_brace("static {vtable_c_name} {vtable_c_name}_default =")
    for s in default_fn_symbols { em_line("{s},") }
    for _s in default_fn_symbols { em_line("NULL,") }
    if default_fn_symbols.len() == 0 { em_line("NULL,") }
    em_close_brace(";")
}

// ── Key operations ───────────────────────────────────────────────────────────

// `const blink_kops <table> = { hash, eq, key_size, inline_key };`, the four members in the
// order runtime_core.h declares them. The runtime hands each adapter a `const void*` that
// points at one key value: with inline_key that is the slot itself, without it the pointer
// the slot holds. Both read as `*(K const*)`, so the method takes the key the way its own
// signature spells it. The adapters are static and private to this definition, and a table
// symbol never starts with `hash_` or `eq_`, so the prefix cannot meet another table's name.
pub fn em_kops_table(table: Str, key_spelling: Str, hash_symbol: Str, eq_symbol: Str, inline_key: Bool) {
    let arg = "*({key_spelling} const*)"
    em_line("static uint64_t hash_{table}(const void* k) \{ return {hash_symbol}({arg}k); }")
    em_line("static int eq_{table}(const void* a, const void* b) \{ return {eq_symbol}({arg}a, {arg}b); }")
    let inline_flag = if inline_key { "1" } else { "0" }
    em_line("const blink_kops {table} = \{ hash_{table}, eq_{table}, sizeof({key_spelling}), {inline_flag} };")
}

pub fn em_kops_table_decl(table: Str) { em_global_decl("const blink_kops", table, true) }

// ── Capture descriptors ──────────────────────────────────────────────────────

// `static const blink_capture_desc <table>[] = { { name, cell_size, walk, fill }, ... };`,
// one row per capture word in capture order, the members in the order runtime_core.h
// declares them. A table is static: its closure literal is in this unit and nowhere else.
pub fn em_capture_desc_table(table: Str, name_lits: List[Str], sizes: List[Str], walks: List[Str], fills: List[Str]) {
    em_open_brace("static const blink_capture_desc {table}[] =")
    let mut i = 0
    while i < name_lits.len() {
        em_line("\{ {name_lits.get(i).unwrap()}, {sizes.get(i).unwrap()}, {walks.get(i).unwrap()}, {fills.get(i).unwrap()} },")
        i += 1
    }
    em_close_brace(";")
}

// blink_ev is the effect vector every function threads. The archive is compiled against a
// vector with only the builtin fields, so those stay first and in this order; a user effect
// appends after them.
fn builtin_ev_fields() -> List[Str] {
    ["io", "fs", "net", "crypto", "rand", "time", "env", "process"]
}

pub fn em_ev_typedef_body(user_vtables: List[Str], user_fields: List[Str]) {
    em_open_brace("typedef struct")
    for f in builtin_ev_fields() { em_line("blink_{f}_vtable* {f};") }
    let mut i = 0
    while i < user_fields.len() {
        em_line("{user_vtables.get(i).unwrap()}* {user_fields.get(i).unwrap()};")
        i += 1
    }
    em_close_brace(" blink_ev;")
}

// A TU that only refers to the vector declares it extern and defines no default.
pub fn em_ev_default_fn(user_vtables: List[Str], user_fields: List[Str], ev_storage: Str) {
    if ev_storage == "extern " {
        em_line("extern blink_ev __blink_ev;")
        return
    }
    em_open_brace("BLINK_UNUSED static blink_ev blink_ev_default(void)")
    em_line("blink_ev ev;")
    for f in builtin_ev_fields() { em_line("ev.{f} = &blink_{f}_vtable_default;") }
    let mut i = 0
    while i < user_fields.len() {
        em_line("ev.{user_fields.get(i).unwrap()} = &{user_vtables.get(i).unwrap()}_default;")
        i += 1
    }
    em_line("return ev;")
    em_close_brace("")
    em_line("{ev_storage}blink_ev __blink_ev;")
}

// The cleanup records a handler install and an arena scope use to restore state on any exit.
// A handler install also restores from the runtime's panic drain, which runs a with-item's
// exit(false) under an armed frame: the drain calls the runner, and the attribute cleanup
// pops the entry on every other way out, as a resource guard does.
pub fn em_scope_restore_support() {
    em_line("typedef struct \{ void** slot; void* saved; } __blink_ev_restore_t;")
    em_open_brace("static void __blink_ev_restore_run(void* p, int ok)")
    em_line("(void)ok;")
    em_line("__blink_ev_restore_t* st = (__blink_ev_restore_t*)p;")
    em_line("*st->slot = st->saved;")
    em_close_brace("")
    em_open_brace("static void __blink_ev_restore(__blink_ev_restore_t* st)")
    em_line("__blink_cleanup_pop((void*)st);")
    em_line("*st->slot = st->saved;")
    em_close_brace("")
    em_line("typedef struct \{ blink_arena_t* prev; blink_arena_t* arena; } __blink_arena_restore_t;")
    em_open_brace("static void __blink_arena_restore(__blink_arena_restore_t* st)")
    em_line("__blink_current_arena = st->prev;")
    em_line("blink_arena_destroy(st->arena);")
    em_close_brace("")
}

// ── Resource guards ──────────────────────────────────────────────────────────
//
// A `with expr as name` resource leaves through a guard local of a state struct, not through
// the resource's own type: the cleanup attribute can only take a pointer to the guard, and
// the exit needs two flags the resource cannot hold. `done` makes the exit run once whether
// the attribute fires first or the runtime's panic drain does, and `ok` tells a BlockHandler
// whether the body completed. Both are `int` because the runtime's drain callback and the
// Bool parameter of exit are spelled `int`. The three symbols hang off the exit symbol under
// the reserved `__blink_` prefix, so one exit method gets one family and no user symbol can
// meet it.

pub fn rs_state_name(exit_symbol: Str) -> Str { "__blink_rs_state_{exit_symbol}" }
pub fn rs_run_name(exit_symbol: Str) -> Str { "__blink_rs_run_{exit_symbol}" }
pub fn rs_cleanup_name(exit_symbol: Str) -> Str { "__blink_rs_cleanup_{exit_symbol}" }

// The runner has the `void (*)(void*, int)` shape the runtime's cleanup stack calls; the
// attribute cleanup pops the stack entry the scope pushed and runs it with the recorded ok.
pub fn em_resource_guard_support(exit_symbol: Str, resource_spelling: Str, passes_ok: Bool) {
    let st = rs_state_name(exit_symbol)
    let run = rs_run_name(exit_symbol)
    em_line("typedef struct \{ {resource_spelling} resource; int ok; int done; } {st};")
    em_open_brace("static void {run}(void* p, int ok)")
    if !passes_ok { em_line("(void)ok;") }
    em_line("{st}* st = ({st}*)p;")
    em_line("if (st->done) \{ return; }")
    em_line("st->done = 1;")
    if passes_ok { em_line("{exit_symbol}(st->resource, ok);") } else { em_line("{exit_symbol}(st->resource);") }
    em_close_brace("")
    em_open_brace("static void {rs_cleanup_name(exit_symbol)}({st}* st)")
    em_line("__blink_cleanup_pop((void*)st);")
    em_line("{run}((void*)st, st->ok);")
    em_close_brace("")
}

// The guard copies the resource value in, registers with the cleanup stack only while a
// panic frame is armed, and marks ok after the body. A return or `?` skips the mark, so
// the attribute cleanup then runs the exit with ok still zero. A scope that has no exit to
// run keeps the plain declaration, so a TU carrying that ICE still compiles.
pub fn em_resource_guard_open(guard: Str, exit_symbol: Str, value: Str) {
    let st = rs_state_name(exit_symbol)
    em_line("{st} {guard} __attribute__((cleanup({rs_cleanup_name(exit_symbol)}))) = \{ .resource = {value}, .ok = 0, .done = 0 };")
    em_line("if (__blink_panic_armed) \{ __blink_cleanup_push((void*)&{guard}, {rs_run_name(exit_symbol)}, &{guard}.done); }")
}

pub fn em_resource_guard_ok(guard: Str) { em_line("{guard}.ok = 1;") }

pub fn em_resource_plain(guard: Str, spelling: Str, value: Str) { em_line("{spelling} {guard} = {value};") }

// ── main ─────────────────────────────────────────────────────────────────────

pub fn em_main_shim(has_main: Bool, has_tests: Bool, uses_async: Bool, user_tu: Bool, trace: Bool, deterministic: Int, init_fns: List[Str]) {
    em_open_brace("int main(int argc, char** argv)")
    em_line("GC_INIT();")
    em_line("blink_map_init_seed({deterministic});")
    em_line("blink_g_argc = argc;")
    em_line("blink_g_argv = (const char**)argv;")
    em_line("__blink_ev = blink_ev_default();")
    if trace { em_line("blink_trace_init(argc, argv);") }
    if uses_async { em_line("__blink_pool = blink_threadpool_init(4);") }
    if user_tu { em_line("__blink_init_stdlib_globals();") }
    for f in init_fns { em_line("{f}();") }
    if has_tests && has_main {
        em_open_brace("for (int i = 1; i < argc; i++)")
        em_open_brace("if (strcmp(argv[i], \"--test\") == 0)")
        em_line("__blink_run_tests(argc, (const char**)argv);")
        if uses_async { em_line("blink_threadpool_shutdown(__blink_pool);") }
        em_line("return 0;")
        em_close_brace("")
        em_close_brace("")
    }
    if has_main {
        em_line("blink_main(&__blink_ev);")
    } else if has_tests {
        em_line("__blink_run_tests(argc, (const char**)argv);")
    }
    if uses_async { em_line("blink_threadpool_shutdown(__blink_pool);") }
    em_line("return 0;")
    em_close_brace("")
}

// ── Test registration ────────────────────────────────────────────────────────
//
// The runtime declares `blink_test_entry` and `blink_test_run`; a unit with tests
// supplies the table and the `__blink_run_tests` the shim above calls. Every field
// arrives already spelled as the C token it prints as, because this module writes no
// literal of its own.

// One row of the table. An empty tag list and an empty expected-failure reason both print
// as the null pointer, which is what the runner tests for before it reads either slot.
fn test_row(name_lit: Str, symbol: Str, tag_count: Int, xfail_lit: Str, comma: Str) -> Str {
    let tags = if tag_count > 0 { "{symbol}_tags" } else { "NULL" }
    let expected_fail = if xfail_lit == "" { 0 } else { 1 }
    let reason = if xfail_lit == "" { "NULL" } else { xfail_lit }
    "\{{name_lit}, {symbol}, __FILE__, 0, 0, {tags}, {tag_count}, {expected_fail}, {reason}}{comma}"
}

pub fn em_test_table(name_lits: List[Str], symbols: List[Str], tag_lits: List[List[Str]], xfail_lits: List[Str]) {
    let count = symbols.len()
    let mut i = 0
    while i < count {
        let tags = tag_lits.get(i).unwrap()
        if tags.len() > 0 {
            em_line("static const char* {symbols.get(i).unwrap()}_tags[] = \{{tags.join(", ")}};")
        }
        i += 1
    }
    em_open_brace("static const blink_test_entry __blink_tests[] =")
    let mut r = 0
    while r < count {
        let comma = if r < count - 1 { "," } else { "" }
        em_line(test_row(name_lits.get(r).unwrap(), symbols.get(r).unwrap(),
            tag_lits.get(r).unwrap().len(), xfail_lits.get(r).unwrap(), comma))
        r += 1
    }
    em_close_brace(";")
    em_line("")
    em_open_brace("static void __blink_run_tests(int argc, const char** argv)")
    em_line("blink_test_run(__blink_tests, {count}, argc, argv);")
    em_close_brace("")
    em_line("")
}
