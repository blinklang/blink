// cg_expr.bl: expressions, literals and operators, lowered to IR.
//
// A stage of the tid-native emitter, not yet written. Its entry point reports I0004 and
// returns, so the driver's diag_ice_count check turns a call into a loud failure rather
// than a translation unit that is silently empty.

import diagnostics.{Diag, diag_ice_stage_not_built}

pub fn cg_expr_lower(node: Int) ! Diag.Report {
    diag_ice_stage_not_built("cg_expr", node)
}
