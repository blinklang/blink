// cg_expr.bl: every Blink expression becomes one typed IR value.
//
// A node's tid is the only thing that decides its C shape. Every spelling and slot form
// comes from layout_of, every symbol from cname, and no C text is written here. A shape
// this stage cannot lower is an ICE, never a guess.
//
// Three things an expression cannot finish alone belong to the statement stage:
//   - a hoisted statement (a heap box, a short-circuit arm, a coalesce, a `?` return)
//     lands in a pending buffer that cg_stmt drains ahead of the statement it serves;
//   - an `if` or `match` in value position is materialised by cg_stmt, which registers
//     the temp here before lowering the expression that reads it;
//   - `?` returns from the enclosing function, so cg_stmt hands over that return tid.
//
// The inline rule (docs/codegen-rewrite/printer.md) is why so little is hoisted: a value
// prints into its parent unless it is effectful or the tree reaches it twice. Every temp
// below exists because C has no expression form for the shape, not for readability.

import parser.{
    node_kind, node_name, node_op, node_left, node_right, node_value, node_obj,
    node_str_val, node_int_val, node_elements, node_fields, node_args, node_condition,
    node_line, node_col, node_type_name,
    sublist_get, sublist_length, interp_part_is_literal,
}
import ast.{NodeKind, nk_of, node_kind_name}
import typecheck.{
    TyKind, tk_name, tc_resolve, tc_tid_kind, tc_tid_decl_node, tc_tid_child_count, is_integer_type, type_bit_width,
    lookup_named_type, tc_field_tid_at_instance, is_import_module_name,
    tc_qualifier_to_module_or_self, tc_tid_struct, tc_global_decl_node, tc_fn_value_decl_node, tc_type_str,
    TYPE_INT, TYPE_BOOL, TYPE_STR, TYPE_VOID,
}
import layout.{
    LayoutRecord, Position, Slot, SlotForm, layout_of, binder_is_celled, carrier_member_layout,
    child_tid, current_binder_scope, field_layout_of, tid_of_binder, tid_of_node, ensure_typedef_for,
    format_spec_of, varargs_spelling, pointer_spelling,
}
import cg_reg.{cg_reg_global_decls, cg_reg_module_of}
import cname.{
    c_local_name, c_field_name, c_global_name, c_string_literal, c_container_ctor,
    c_runtime_helper, c_tuple_member, c_variant_discriminant, c_mint_local,
    c_overflow_builtin, c_int_min_macro, c_test_propagate_name,
}
import ir.{
    IrKind, ir_kind, ir_kind_is_name, ir_kid, ir_kid_count, ir_c_name, ir_panic, ir_tid, ir_span,
    ir_c_spelling, ir_slot_form,
    ir_const, ir_var_ref, ir_cell_ref, ir_global_ref, ir_unary, ir_binary, ir_cast, ir_field_get,
    ir_struct_new, ir_tuple_new, ir_container_new, ir_box, ir_unbox, ir_carrier_wrap,
    ir_carrier_unwrap, ir_carrier_tag, ir_call_runtime, ir_let, ir_assign, ir_return,
    ir_expr_stmt, ir_if, ir_block, ir_enum_new, ir_unreachable, ir_panic_catch_exit,
}
import cg_stmt.{cg_stmt_return_value}
import cg_call.{
    lower_call, lower_operator_method, lower_display_of_value,
    lower_spread, lower_element_read, lower_element_store, cc_enum_variant_construct,
    lower_await_expr, lower_fn_value, lower_channel_new,
}
import cg_eff.{cg_eff_lower_closure, cg_eff_lower_handler_expr}
import diagnostics.{
    Diag, diag_ice, diag_ice_at, diag_is_ice_seg, diag_error_at, diag_file_for_node, diag_source_file,
    UNSOLVED_TYPEVAR_AT_CODEGEN, CODEGEN_STAGE_NOT_BUILT, POISONED_IR_AT_SEAM,
    FILE_NOT_FOUND,
}
import std.path.{path_dirname}

// The constructor and member spellings this stage compares against, held as data so no
// branch here dispatches on a type's name.
let ctor_none = "None"
let ctor_some = "Some"
let ctor_ok = "Ok"
let ctor_err = "Err"
let member_value = "value"
let member_ok = "ok"
let member_err = "err"
let bool_true = "true"
let bool_false = "false"

// The value a struct literal spreads. Every field the literal omits reads it, so it is
// bound to a temp and the expression that produced it runs once.
type SpreadBase {
    name: Str = ""
    tid: Int = -1
    decl: Int = -1
}

// One interpolation hole: the conversion the format string needs and the argument that
// feeds it. An empty spec means the hole has already reported an ICE.
type InterpHole {
    spec: Str = ""
    arg: Int = -1
}

let mut cx_pending: List[Int] = []
// The temp an `if` or `match` in value position was materialised into. Name and type
// travel together in one row, so a lookup cannot find one and miss the other.
type MaterialisedValue {
    c_name: Str
    tid: Int
}

let mut cx_value: Map[Str, MaterialisedValue] = Map()
// The nodes cx_value names, in the order they were named. A map answers by key and
// cannot say which of its rows are newer than a mark, so the order lives beside it.
let mut cx_value_keys: List[Str] = []
let mut cx_return_type: Int = -1
// The local each `old(e)` of the function being lowered was copied into on entry, keyed by
// the `old` call node.
let mut cx_old_snapshots: Map[Int, Str] = Map()
let mut cx_test_body: Bool = false
// The innermost-last stack of open async.scope handle lists, named by their C variable.
// cg_stmt pushes on scope entry and pops on exit; cg_call reads the top so a spawn inside
// the scope's body registers its handle there, and a spawn outside every scope sees none.
let mut cx_async_scope_stack: List[Str] = []
// The innermost-last stack of open assert_panics frames, named by their frame record, and
// beside each the count of loops opened inside it. A break or continue with that count at
// zero leaves the frame, so it is lowered as the frame's exit.
let mut cx_frames: List[Str] = []
let mut cx_frame_loops: List[Int] = []

// ── Seam ──────────────────────────────────────────────────────────────────

pub fn cg_expr_reset() {
    cx_pending = []
    cx_value = Map()
    cx_value_keys = []
    cx_return_type = -1
    cx_old_snapshots = Map()
    cx_test_body = false
    cx_async_scope_stack = []
    cx_frames = []
    cx_frame_loops = []
}

pub fn cg_expr_set_old_snapshot(node: Int, c_name: Str) {
    cx_old_snapshots.insert(node, c_name)
}

pub fn cg_expr_clear_old_snapshots() {
    cx_old_snapshots = Map()
}

// Opens a new innermost async.scope, named by the C variable holding its handle list.
pub fn cg_expr_async_scope_open(c_name: Str) {
    cx_async_scope_stack.push(c_name)
}

// Closes the innermost async.scope. Called once per open, in the same lowering that
// opened it, so the stack always matches the nesting of scopes still being lowered.
pub fn cg_expr_async_scope_close() {
    cx_async_scope_stack.pop()
}

// The innermost open scope's handle list, or "" when no async.scope is open, the case an
// un-scoped async.spawn hits.
pub fn cg_expr_async_scope_current() -> Str {
    if cx_async_scope_stack.len() == 0 { return "" }
    cx_async_scope_stack.get(cx_async_scope_stack.len() - 1).unwrap()
}

// Opens a new innermost assert_panics frame. cg_stmt closes it in the same lowering.
pub fn cg_expr_frame_open(c_name: Str) {
    cx_frames.push(c_name)
    cx_frame_loops.push(0)
}

pub fn cg_expr_frame_close() {
    let _ = cx_frames.pop()
    let _ = cx_frame_loops.pop()
}

// A closure body is its own function, so a frame open where the closure is written does
// not enclose it. The driver clears the stack before it lowers a thunk body.
pub fn cg_expr_frame_clear() {
    cx_frames = []
    cx_frame_loops = []
}

// Called around each loop body, so a break or continue knows whether its loop is inside
// the innermost frame.
pub fn cg_expr_frame_loop_enter() {
    if cx_frames.len() == 0 { return }
    let n = cx_frame_loops.pop() ?? 0
    cx_frame_loops.push(n + 1)
}

pub fn cg_expr_frame_loop_exit() {
    if cx_frames.len() == 0 { return }
    let n = cx_frame_loops.pop() ?? 1
    cx_frame_loops.push(n - 1)
}

// The frame a return or a `?` leaves, or "" when none is open.
pub fn cg_expr_frame_current() -> Str {
    if cx_frames.len() == 0 { return "" }
    cx_frames.get(cx_frames.len() - 1).unwrap()
}

// The frame a break or continue leaves: the innermost one, when no loop opened inside it
// encloses the jump. "" means the jump stays inside the frame, or no frame is open.
pub fn cg_expr_frame_left_by_jump() -> Str {
    if cx_frames.len() == 0 { return "" }
    if cx_frame_loops.get(cx_frame_loops.len() - 1).unwrap() > 0 { return "" }
    cg_expr_frame_current()
}

// The carrier `?` returns on the error path.
pub fn cg_expr_set_return_type(tid: Int) {
    cx_return_type = tid
}

pub fn cg_expr_return_type() -> Int { cx_return_type }

// Whether the body being lowered is a test block. A test body is a third propagation mode
// beside a function with a Result result and a function with an Option result, and it is
// not a return type: the C body has no result, so `?` calls the runtime and then returns
// with no value. The driver sets this the same way it sets a return type, around the body,
// and clears it after.
//
// A closure written inside a test body is its own enclosing function for the `?` in it, so
// the driver clears this before it lowers a thunk body.
pub fn cg_expr_set_test_body(on: Bool) {
    cx_test_body = on
}

// An `if` or `match` in value position: cg_stmt declares the temp, lowers the arms into
// assignments to it, and names it here before lowering the expression that reads it.
pub fn cg_expr_register_value(node: Int, c_name: Str, tid: Int) {
    cx_value.insert("{node}", MaterialisedValue { c_name: c_name, tid: tid })
    cx_value_keys.push("{node}")
}

// How many nodes carry a temp. A statement reads this before it lowers and hands it
// back to cg_expr_drop_values when it stops, the way it marks the pending buffer.
pub fn cg_expr_value_count() -> Int { cx_value_keys.len() }

// The rows named past `mark`, removed. The statements that declared those temps are
// dropped when a statement stops, so a row that outlived them would name a temp no C
// declares, and it would outlive the function that made it: the only other clearer
// runs once per unit.
pub fn cg_expr_drop_values(mark: Int) {
    let mut i = cx_value_keys.len()
    while i > mark {
        i = i - 1
        let key = cx_value_keys.get(i).unwrap()
        // A node named on both sides of the mark keeps its row: the older naming is
        // the one the mark was taken above, and this rollback does not reach it.
        if !x_value_named_below(key, mark) { cx_value.remove(key) }
        cx_value_keys.pop()
    }
}

fn x_value_named_below(key: Str, mark: Int) -> Bool {
    let mut i = 0
    while i < mark {
        if cx_value_keys.get(i).unwrap() == key { return true }
        i = i + 1
    }
    false
}

pub fn cg_expr_pending_count() -> Int { cx_pending.len() }

// Whether a temp already carries this node's value. The statement stage asks before it
// lowers an initialiser a second time: a construct the materialiser reached is already a
// read of a temp, and lowering it again would run its body twice.
pub fn cg_expr_is_registered(node: Int) -> Bool {
    match cx_value.get("{node}") {
        Some(_v) => true
        None => false
    }
}

// A statement the caller's own lowering needs run before the expression that reads its
// result. The call stage materialises the shapes this stage refuses into temps, and the
// buffer for the statements that fill them is this module's cell, so the push is a seam.
//
// `node` is the expression the statement belongs to, and gives the refusal a span to
// blame. Buffering a poisoned statement would put an id the pool does not hold in front
// of the expression that reads the temp, and the printer would read it as a real node.
// Node 0 is real, so both tests are for negative: a caller that lost the statement may
// have lost the expression too, and the node readers exit the process on an id the pool
// does not hold, which would turn the refusal into a silent exit.
pub fn cg_expr_push_pending(node: Int, stmt: Int) ! Diag.Report {
    if stmt >= 0 {
        x_hoist(stmt)
        return
    }
    let why = "a statement that was never lowered was handed to the pending buffer"
    let fix = "the caller must stop when its own lowering reports, not push the poisoned node"
    if node < 0 {
        diag_ice("PendingStatementNotLowered", POISONED_IR_AT_SEAM, why, 0, 0, fix)
        return
    }
    diag_ice_at("PendingStatementNotLowered", POISONED_IR_AT_SEAM, why, node, fix)
}

// The statements pushed past `mark`, removed from the buffer and given to the caller. A
// caller that means to drop them reads the answer for its length: an empty one says the
// value it lowered needed no statement of its own.
//
// The mark belongs to the caller because a caller that lowered a value of its own before
// recursing keeps that value's statements with itself rather than handing them down.
pub fn cg_expr_take_pending(mark: Int) -> List[Int] {
    x_take_from(mark)
}

// The statements pushed past `mark`, moved onto the end of `out` in order. The caller
// emits them in front of the statement that reads the temp they fill. Moving them costs
// one copy rather than the two an answer of its own would, and every caller wants them
// joined to a list it is already building.
pub fn cg_expr_drain_pending(mark: Int, out: List[Int]) {
    let mut i = mark
    while i < cx_pending.len() {
        out.push(cx_pending.get(i).unwrap())
        i = i + 1
    }
    while cx_pending.len() > mark { cx_pending.pop() }
}

// ── Dispatch ──────────────────────────────────────────────────────────────

// Every expression reaches its own lowering through here, so the buffer rule lives here and
// not in each seam that hoists: a lowering that answers -1 leaves no statement behind. Those
// statements fill temps only the refused expression reads, and cg_stmt splices the buffer
// into the enclosing block whole, so one left behind runs for nothing.
pub fn lower_expr(node: Int) -> Int ! Diag.Report {
    if cg_expr_is_registered(node) { return lower_registered(node) }
    let mark = cx_pending.len()
    let out = x_dispatch(node)
    if out >= 0 { return out }
    let _dropped = x_take_from(mark)
    -1
}

fn x_dispatch(node: Int) -> Int ! Diag.Report {
    match nk_of(node_kind(node)) {
        NodeKind.IntLit => lower_int_lit(node)
        NodeKind.FloatLit => lower_literal(node, node_str_val(node))
        NodeKind.CharLit => lower_literal(node, node_str_val(node))
        NodeKind.BoolLit => lower_bool_lit(node)
        NodeKind.InterpString => lower_interp(node)
        NodeKind.Ident => lower_ident(node)
        NodeKind.BinOp => lower_binop(node)
        NodeKind.UnaryOp => lower_unary(node)
        NodeKind.TupleLit => lower_tuple_lit(node)
        NodeKind.ListLit => lower_list_lit(node)
        NodeKind.StructLit => lower_struct_lit(node)
        NodeKind.FieldAccess => lower_field_access(node)
        NodeKind.IndexExpr => lower_index(node)
        NodeKind.Call => lower_call_expr(node)
        NodeKind.IfExpr => lower_registered(node)
        NodeKind.MatchExpr => lower_registered(node)
        NodeKind.Block => lower_registered(node)
        NodeKind.WithBlock => lower_registered(node)
        NodeKind.AsyncScope => lower_registered(node)
        NodeKind.SpreadExpr => x_spread_not_built(node)
        NodeKind.Closure => cg_eff_lower_closure(node)
        NodeKind.HandlerExpr => cg_eff_lower_handler_expr(node)
        NodeKind.MethodCall => lower_call(node)
        NodeKind.AwaitExpr => lower_await_expr(node)
        NodeKind.ChannelNew => lower_channel_new(node)
        NodeKind.EmbedExpr => x_embed(node)
        _ => x_unhandled(node)
    }
}

// ── Type and layout ───────────────────────────────────────────────────────

// The one reader every decline-to-ICE layout wrapper shares: a caller has already asked
// layout.bl for a record however its own site does that (a Local lookup, a carrier
// member, a struct field, a foreign field), and this is the single place that turns a
// decline into the ICE every one of those sites used to raise on its own. The decline
// check and the diag_ice_at that answers it stay three lines apart here, and nowhere
// else reads decline_reason directly any more.
pub fn x_layout_checked(rec: LayoutRecord, node: Int, ice_name: Str, what: Str, hint: Str) -> LayoutRecord ! Diag.Report {
    if rec.decline_reason != "" {
        diag_ice_at(ice_name, UNSOLVED_TYPEVAR_AT_CODEGEN, "{what}: {rec.decline_reason}", node, hint)
    }
    rec
}

// A decline here means monomorphisation left a type codegen cannot spell, so it is an
// ICE and the caller stops.
fn x_local(tid: Int, node: Int) -> LayoutRecord ! Diag.Report {
    x_layout_checked(layout_of(tid, Position.Local), node, "UnspellableExprType",
        "expression has no C layout", "monomorphisation must resolve every type codegen reads; this is a compiler bug")
}

fn x_member(carrier: Int, slot: Slot, node: Int) -> LayoutRecord ! Diag.Report {
    x_layout_checked(carrier_member_layout(carrier, slot), node, "UnspellableCarrierMember",
        "carrier member has no C layout", "monomorphisation must resolve every type codegen reads; this is a compiler bug")
}

// x_local and x_member have already turned a decline into an ICE, so a caller is only
// asking whether lowering may go on. layout.bl answers every decline with an empty
// spelling, and no answer it accepts is empty, so that is the question to ask.
pub fn x_stopped(rec: LayoutRecord) -> Bool {
    rec.c_spelling == ""
}

// A field read takes the owner's stored form: a field whose type reaches its own owner
// by value is held as a boxed word, which the field's own Local layout does not say.
fn x_field(owner_tid: Int, field_tid: Int, node: Int) -> LayoutRecord ! Diag.Report {
    x_layout_checked(field_layout_of(owner_tid, field_tid), node, "UnspellableFieldType",
        "struct field has no C layout", "monomorphisation must resolve every type codegen reads; this is a compiler bug")
}

fn x_unhandled(node: Int) -> Int ! Diag.Report {
    diag_ice_at("UnhandledExprKind", UNSOLVED_TYPEVAR_AT_CODEGEN,
        "expression kind {node_kind_name(node_kind(node))} has no lowering", node,
        "every expression kind the parser produces needs an arm in lower_expr")
    -1
}

// `..a` copies a container into the one being built, so it is not a value that stands on
// its own: it needs the destination, which only the literal around it names. Reaching this
// arm means a spread was lowered with no literal to fill.
fn x_spread_not_built(node: Int) -> Int ! Diag.Report {
    diag_ice_at("SpreadElementNotLowered", CODEGEN_STAGE_NOT_BUILT,
        "a spread has no container to copy into here", node,
        "a spread lowers through the container literal that names its destination")
    -1
}

// Whether running this value can be observed. Only a call, a performed effect or an
// installed handler acts; every other kind answers for the kids it is built from.
fn x_has_effect(id: Int) -> Bool {
    if id < 0 { return false }
    if x_kind_acts(ir_kind(id)) { return true }
    let mut i = 0
    while i < ir_kid_count(id) {
        if x_has_effect(ir_kid(id, i)) { return true }
        i = i + 1
    }
    false
}

fn x_kind_acts(k: IrKind) -> Bool {
    if k == IrKind.CallDirect { return true }
    if k == IrKind.CallIndirect { return true }
    if k == IrKind.CallClosure { return true }
    if k == IrKind.CallVirtual { return true }
    if k == IrKind.CallRuntime { return true }
    if k == IrKind.EffectPerform { return true }
    k == IrKind.HandlerInstall
}

// ── Hoisting ──────────────────────────────────────────────────────────────

fn x_hoist(stmt: Int) {
    cx_pending.push(stmt)
}

// Statements pushed since `mark`, removed from the buffer. A short-circuit or coalesce arm
// owns the statements its own operand needed, so they move into that arm's block. A caller
// that refuses drops them instead: they fill a temp only the refused expression reads.
fn x_take_from(mark: Int) -> List[Int] {
    let mut out: List[Int] = []
    let mut i = mark
    while i < cx_pending.len() {
        out.push(cx_pending.get(i).unwrap())
        i = i + 1
    }
    while cx_pending.len() > mark { cx_pending.pop() }
    out
}

// Declares a temp of `tid` and answers its name. init < 0 declares without initialising.
fn x_bind(tid: Int, node: Int, init: Int) -> Str ! Diag.Report {
    let rec = x_local(tid, node)
    if x_stopped(rec) { return "" }
    let name = c_mint_local("x")
    x_hoist(ir_let(tid, node, rec.c_spelling, name, rec.slot_form, init))
    name
}

fn x_ref(tid: Int, node: Int, name: Str) -> Int ! Diag.Report {
    let rec = x_local(tid, node)
    if x_stopped(rec) { return -1 }
    ir_var_ref(tid, node, rec.c_spelling, name, rec.slot_form)
}

// ── Literals ──────────────────────────────────────────────────────────────

fn lower_literal(node: Int, literal: Str) -> Int ! Diag.Report {
    let tid = tid_of_node(node)
    if tid < 0 { return -1 }
    let rec = x_local(tid, node)
    if x_stopped(rec) { return -1 }
    ir_const(tid, node, rec.c_spelling, literal)
}

fn lower_int_lit(node: Int) -> Int ! Diag.Report {
    let s = node_str_val(node)
    if s == "" { return lower_literal(node, "{node_int_val(node)}") }
    lower_literal(node, s)
}

fn lower_bool_lit(node: Int) -> Int ! Diag.Report {
    if node_int_val(node) != 0 { return lower_literal(node, "1") }
    lower_literal(node, "0")
}

// `#embed` is read here and nowhere later: the file's bytes become one string constant, so
// the generated program holds no array to declare and no path to open. The path is written
// relative to the source file that holds the `#embed`, which is the only directory the
// author can reason about; the stdlib registry writes all of its paths that way.
fn x_embed(node: Int) -> Int ! Diag.Report {
    let path = "{path_dirname(diag_file_for_node(node))}/{node_str_val(node)}"
    if file_exists(path) != 1 {
        diag_error_at("FileNotFound", FILE_NOT_FOUND, "#embed file not found: {path}", node,
            "the path is read relative to the file that holds the #embed, not the directory the compiler runs in")
        return -1
    }
    lower_literal(node, c_string_literal(read_file(path)))
}

// ── Names ─────────────────────────────────────────────────────────────────

fn x_kind(tid: Int) -> TyKind {
    tc_tid_kind(tc_resolve(tid))
}

fn lower_ident(node: Int) -> Int ! Diag.Report {
    let tid = tid_of_node(node)
    if tid < 0 { return -1 }
    let name = node_name(node)
    if name == ctor_none { return lower_none(node, tid) }
    let rec = x_local(tid, node)
    if x_stopped(rec) { return -1 }
    if x_is_local(name) {
        // A binding shared with a closure keeps its value in one heap cell, so a read of
        // the name is a read through that cell. Reading a local of the same spelling would
        // read storage the closure's writes never reach.
        if binder_is_celled(current_binder_scope(), name) {
            return ir_cell_ref(tid, node, rec.c_spelling, name, rec.slot_form)
        }
        return ir_var_ref(tid, node, rec.c_spelling, c_local_name(name), rec.slot_form)
    }
    // Which module's global a bare name reads is settled by name resolution, from the
    // reading file's own module and import list, and published against this node. Two
    // modules may each declare a private global of one spelling, so searching the registry
    // by the name alone answers whichever it holds first — the wrong module's value, with
    // no diagnostic.
    let decl = tc_global_decl_node(node)
    if decl >= 0 {
        return ir_global_ref(tid, node, rec.c_spelling, c_global_name(decl), rec.slot_form)
    }
    let fn_decl = tc_fn_value_decl_node(node)
    if fn_decl >= 0 { return lower_fn_value(node, fn_decl) }
    // A bare unit variant (`LZero`, or `Map` shadowing the builtin ctor) is neither a
    // binder nor a global; typecheck already settled which enum it means via this node's
    // tid, so read the variant off that tid the way a qualified `Type.Variant` would.
    let bare_vd = x_bare_variant_decl(tid, name)
    if bare_vd >= 0 { return x_variant_from_decl(node, bare_vd) }
    // Typecheck already refused an undefined name, so a name with no binder and no resolved
    // global is a binder the statement stage never recorded, or one it recorded with no
    // type. Spelling it as a local would emit a C identifier no declaration introduces, and
    // picking a global by the spelling would pick one the reader never named.
    diag_ice_at("NameNotBound", CODEGEN_STAGE_NOT_BUILT,
        "`{name}` is neither a typed binder in scope nor a resolved module global", node,
        "every local must be bound at its own type before an expression that reads it is lowered")
    -1
}

// The language lets a local shadow a module global, so a bare name is a local wherever
// the statement stage has a binder of that name in the open frame. Both stages read the
// one set of frames layout keeps, so they cannot disagree about what is in scope.
fn x_is_local(name: Str) -> Bool {
    tid_of_binder(current_binder_scope(), name) >= 0
}

// The module-level `let` that `module` declares under `name`, or -1. The driver's registry
// is the only list of them, so it is read rather than copied into a table here that could
// fall behind it.
//
// The module is always named. A bare read does not come here: two modules may each declare
// a private global of one spelling, and every one of them is a distinct C symbol, so a scan
// by the name alone answers whichever the registry holds first rather than the one the
// reader named. That question is name resolution's, and lower_ident reads its answer.
fn x_global_decl(module: Str, name: Str) -> Int {
    let decls = cg_reg_global_decls()
    let mut i = 0
    while i < decls.len() {
        let decl = decls.get(i).unwrap()
        if node_name(decl) == name && cg_reg_module_of(decl) == module { return decl }
        i = i + 1
    }
    -1
}

// An `if` or `match` in value position: the arms are statements, so cg_stmt materialises
// them into a temp and names it here. Reaching one that was never registered means the
// statement stage lowered the arms without claiming the value.
fn lower_registered(node: Int) -> Int ! Diag.Report {
    match cx_value.get("{node}") {
        Some(v) => return lower_registered_ref(node, v)
        None => {}
    }
    diag_ice_at("UnmaterialisedValueExpr", CODEGEN_STAGE_NOT_BUILT,
        "{node_kind_name(node_kind(node))} in value position was not materialised", node,
        "cg_stmt must declare the temp and call cg_expr_register_value before lowering the reader")
    -1
}

fn lower_registered_ref(node: Int, v: MaterialisedValue) -> Int ! Diag.Report {
    if v.tid < 0 {
        diag_ice_at("MaterialisedValueHasNoType", CODEGEN_STAGE_NOT_BUILT,
            "the temp `{v.c_name}` was registered without a type", node,
            "cg_expr_register_value takes the temp's tid; it must be the one the arms assign")
        return -1
    }
    x_ref(v.tid, node, v.c_name)
}

// ── Carriers ──────────────────────────────────────────────────────────────

fn x_tag(node: Int, value: Int) -> Int ! Diag.Report {
    let rec = x_local(TYPE_INT, node)
    if x_stopped(rec) { return -1 }
    ir_const(TYPE_INT, node, rec.c_spelling, "{value}")
}

// Every carrier arm is built here, so the opaque-handle Option has one rule: it is the bare
// handle pointer, with NULL for None, and has no tag to write. layout says which shape
// applies by answering a word slot form. A payload of -1 is an arm that carries nothing.
fn x_carrier_arm(tid: Int, node: Int, rec: LayoutRecord, member: Str, tag_value: Int, payload: Int) -> Int ! Diag.Report {
    if rec.slot_form == SlotForm.InlineWord {
        if payload < 0 { return ir_const(tid, node, rec.c_spelling, "0") }
        return ir_cast(tid, node, rec.c_spelling, payload)
    }
    let tag = x_tag(node, tag_value)
    if tag < 0 { return -1 }
    ir_carrier_wrap(tid, node, rec.c_spelling, member, tag, payload)
}

// The two Option arms for a caller that fills a carrier itself, such as a checked read
// choosing between them by a runtime test. `rec` is the carrier's own layout.
pub fn cg_expr_option_some(tid: Int, node: Int, rec: LayoutRecord, payload: Int) -> Int ! Diag.Report {
    x_carrier_arm(tid, node, rec, member_value, 1, payload)
}

pub fn cg_expr_option_none(tid: Int, node: Int, rec: LayoutRecord) -> Int ! Diag.Report {
    x_carrier_arm(tid, node, rec, "", 0, -1)
}

fn lower_none(node: Int, tid: Int) -> Int ! Diag.Report {
    if x_kind(tid) != TyKind.Option {
        diag_ice_at("NoneOutsideOption", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "None lowered at a type that is not an Option", node,
            "typecheck must give every None an Option type")
        return -1
    }
    let rec = x_local(tid, node)
    if x_stopped(rec) { return -1 }
    let _td = ensure_typedef_for(tid)
    cg_expr_option_none(tid, node, rec)
}

// Some, Ok and Err all write one tag and one member. Which member and which tag is the
// only difference, and the member's physical form is layout's answer, not a guess here.
fn lower_wrap(node: Int, slot: Slot, member: Str, tag_value: Int) -> Int ! Diag.Report {
    let tid = tid_of_node(node)
    if tid < 0 { return -1 }
    let args = node_args(node)
    let n = sublist_length(args)
    // `Ok()` is the spelling of a Void success, so a missing argument is an arity of its
    // own rather than an error; only a second argument is one.
    if n > 1 {
        diag_ice_at("CarrierCtorArity", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "carrier constructor takes one argument, got {n}", node,
            "typecheck must reject a carrier constructor of the wrong arity")
        return -1
    }
    let rec = x_local(tid, node)
    if x_stopped(rec) { return -1 }
    let _td = ensure_typedef_for(tid)
    let arg = if n == 1 { sublist_get(args, 0) } else { -1 }
    lower_wrap_body(node, tid, slot, member, tag_value, rec, arg)
}

fn lower_wrap_body(node: Int, tid: Int, slot: Slot, member: Str, tag_value: Int, rec: LayoutRecord, arg: Int) -> Int ! Diag.Report {
    let mem = x_member(tid, slot, node)
    if x_stopped(mem) { return -1 }
    let inner = child_tid(tid, slot)
    // A Void arm holds an int64_t placeholder, so the unit value writes the placeholder
    // rather than a compound literal of the empty tuple.
    if x_is_void_like(inner) { return lower_wrap_unit(node, tid, member, tag_value, rec, mem, arg) }
    if arg < 0 {
        diag_ice_at("CarrierCtorArity", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "carrier constructor over a {tk_name(x_kind(inner))} payload was given no argument", node,
            "typecheck must reject a carrier constructor of the wrong arity")
        return -1
    }
    let payload = lower_expr(arg)
    if payload < 0 { return -1 }
    x_wrap_value(node, tid, slot, member, tag_value, payload)
}

// Wrapping a payload that is already lowered. `?` reaches here too: it rebuilds the
// caller's error carrier from a payload it unwrapped rather than from an argument node.
fn x_wrap_value(node: Int, tid: Int, slot: Slot, member: Str, tag_value: Int, payload: Int) -> Int ! Diag.Report {
    let rec = x_local(tid, node)
    if x_stopped(rec) { return -1 }
    let _td = ensure_typedef_for(tid)
    let mem = x_member(tid, slot, node)
    if x_stopped(mem) { return -1 }
    // The opaque-handle Option holds the handle itself, so there is no member to box into.
    let mut value = payload
    if rec.slot_form != SlotForm.InlineWord && mem.slot_form == SlotForm.PointerBoxed {
        value = x_box(node, child_tid(tid, slot), payload, mem.c_spelling)
        if value < 0 { return -1 }
    }
    x_carrier_arm(tid, node, rec, member, tag_value, value)
}

// The unit carries no value, but the argument that produced it is an ordinary expression
// and may be a call written for its effect, so it runs ahead of the wrap.
fn lower_wrap_unit(node: Int, tid: Int, member: Str, tag_value: Int, rec: LayoutRecord, mem: LayoutRecord, arg: Int) -> Int ! Diag.Report {
    if arg >= 0 {
        let produced = lower_expr(arg)
        if produced < 0 { return -1 }
        if x_has_effect(produced) { x_hoist(ir_expr_stmt(node, produced)) }
    }
    x_carrier_arm(tid, node, rec, member, tag_value, ir_const(TYPE_INT, node, mem.c_spelling, "0"))
}

fn x_is_void_like(tid: Int) -> Bool {
    let k = x_kind(tid)
    k == TyKind.Void || k == TyKind.Never
}

// A payload wider than the carrier's pointer member gets a heap copy. The box's tid is the
// pointee's: the slot form, not the tid, records that the value sits behind a pointer.
fn x_box(node: Int, tid: Int, value: Int, ptr_spelling: Str) -> Int ! Diag.Report {
    let rec = x_local(tid, node)
    if x_stopped(rec) { return -1 }
    ir_box(tid, node, ptr_spelling, rec.c_spelling, value)
}

// ── Operators ─────────────────────────────────────────────────────────────

fn lower_binop(node: Int) -> Int ! Diag.Report {
    let op = node_op(node)
    if op == "??" { return lower_coalesce(node) }
    if op == "&&" { return lower_short_circuit(node, op) }
    if op == "||" { return lower_short_circuit(node, op) }
    let lhs_tid = tid_of_node(node_left(node))
    if lhs_tid < 0 { return -1 }
    if x_kind(lhs_tid) == TyKind.Str { return lower_str_binop(node, op) }
    if x_kind(lhs_tid) == TyKind.Float && x_is_comparison_op(op) { return lower_float_compare(node, op) }
    let lhs_rec = x_local(lhs_tid, node_left(node))
    if x_stopped(lhs_rec) { return -1 }
    // The whole comparison goes over, and the method stage lowers the two operands itself
    // after it knows which method it can call, so that a refusal there has built nothing and
    // hoisted nothing.
    if !x_is_c_comparable(lhs_tid, lhs_rec) { return lower_operator_method(node, op) }
    let tid = tid_of_node(node)
    if tid < 0 { return -1 }
    let rec = x_local(tid, node)
    if x_stopped(rec) { return -1 }
    let lhs = lower_expr(node_left(node))
    let rhs = lower_expr(node_right(node))
    if lhs < 0 { return -1 }
    if rhs < 0 { return -1 }
    lower_arith_operator(ArithSite { node: node, op: op, tid: tid, lhs_node: node_left(node),
        rhs_node: node_right(node) }, lhs, rhs)
}

// One operator over two C scalars: where it stands, what it does, its result type, and
// the source nodes of its operands. A compound assignment has no left and right children,
// so the operands' nodes travel here instead of being read off `node`.
pub type ArithSite {
    node: Int
    op: Str
    tid: Int
    lhs_node: Int
    rhs_node: Int
}

// Every operator over two C scalars lowers here, from an expression or from a compound
// assignment, so that neither can reach C without the checks the spec promises. The
// operands arrive already lowered, in the order the program wrote them.
pub fn lower_arith_operator(site: ArithSite, lhs: Int, rhs: Int) -> Int ! Diag.Report {
    if lhs < 0 || rhs < 0 { return -1 }
    let rec = x_local(site.tid, site.node)
    if x_stopped(rec) { return -1 }
    let lhs_tid = tid_of_node(site.lhs_node)
    let rhs_tid = tid_of_node(site.rhs_node)
    if lhs_tid < 0 || rhs_tid < 0 { return -1 }
    // An operand that never produces a value leaves the operator unreachable, so there is
    // nothing to check and no value to print in a message.
    if x_is_void_like(lhs_tid) || x_is_void_like(rhs_tid) {
        return ir_binary(site.tid, site.node, rec.c_spelling, site.op, lhs, rhs)
    }
    if x_operator_needs_guard(site.op, lhs_tid, rhs) || x_needs_min_guard(site.op, lhs_tid, rhs) {
        return x_guarded_binary(site, rec, lhs_tid, lhs, rhs)
    }
    if x_operator_can_overflow(site.op, site.tid) { return x_checked_arith(site, rec, lhs_tid, lhs, rhs) }
    ir_binary(site.tid, site.node, rec.c_spelling, site.op, lhs, rhs)
}

// Three integer operations C leaves undefined where Blink promises a panic: a division or
// a remainder by zero, and a shift by the left operand's own width or more. On x86 the
// first two fault and the third quietly masks the amount, so the promise cannot come from
// the C operator and the seam that lowers the operator emits the test instead.
//
// A literal the front end has already judged needs nothing. It refuses a shift whose
// amount is an integer literal out of range, and a division by a literal that is not zero
// cannot fault, so those sites keep printing as the bare operator. Anything else is
// guarded, including a literal this stage cannot read as a number: guessing there would
// trade a panic for a fault.
fn x_operator_needs_guard(op: Str, lhs_tid: Int, rhs: Int) -> Bool {
    if is_integer_type(lhs_tid) == 0 { return false }
    if op == "/" || op == "%" { return !x_is_nonzero_literal(rhs) }
    if op == "<<" || op == ">>" { return ir_kind(rhs) != IrKind.Const }
    false
}

// A signed quotient leaves its range at one point only, the minimum over -1, which C
// leaves undefined and x86 faults on. A literal divisor that is not negative can never be
// -1, so only that divisor skips the test.
fn x_needs_min_guard(op: Str, lhs_tid: Int, rhs: Int) -> Bool {
    if op != "/" || !x_is_signed_int(lhs_tid) { return false }
    if ir_kind(rhs) != IrKind.Const { return true }
    ir_c_name(rhs).starts_with("-")
}

fn x_is_signed_int(tid: Int) -> Bool {
    if is_integer_type(tid) == 0 { return false }
    !diag_is_ice_seg(c_int_min_macro(x_kind(tid)))
}

fn x_is_nonzero_literal(id: Int) -> Bool {
    if ir_kind(id) != IrKind.Const { return false }
    let text = ir_c_name(id)
    let mut i = 0
    while i < text.len() {
        let c = text.byte_at(i)
        if c != 48 && c != 43 && c != 45 { return true }
        i = i + 1
    }
    false
}

// The tests read the same values the operator reads, so an operand that is not already a
// name becomes a temp: testing it where it stands would run it twice, and leaving the left
// operand inline would run it after a panic that must come later than its own effects.
fn x_guarded_binary(site: ArithSite, rec: LayoutRecord, lhs_tid: Int, lhs: Int, rhs: Int) -> Int ! Diag.Report {
    let rhs_tid = tid_of_node(site.rhs_node)
    if rhs_tid < 0 { return -1 }
    let zero_test = x_operator_needs_guard(site.op, lhs_tid, rhs)
    let min_test = x_needs_min_guard(site.op, lhs_tid, rhs)
    let left_held = x_hold(lhs_tid, site.lhs_node, lhs)
    let right_held = x_hold(rhs_tid, site.rhs_node, rhs)
    if left_held < 0 || right_held < 0 { return -1 }
    if zero_test {
        let tripped = x_operand_test(site.node, site.op, lhs_tid, rhs_tid, right_held)
        let said = x_guard_message(site.node, site.op, lhs_tid)
        if tripped < 0 || said < 0 { return -1 }
        x_hoist(ir_if(site.node, tripped, ir_block(site.node, [ir_panic(site.node, said)]), -1))
    }
    if min_test && !x_hoist_min_guard(site, lhs_tid, rhs_tid, left_held, right_held) { return -1 }
    let left = x_reread(left_held)
    let divisor = x_reread(right_held)
    if left < 0 || divisor < 0 { return -1 }
    ir_binary(site.tid, site.node, rec.c_spelling, site.op, left, divisor)
}

// `left == MIN && right == -1`, and the panic it guards.
fn x_hoist_min_guard(site: ArithSite, lhs_tid: Int, rhs_tid: Int, left: Int, right: Int) -> Bool ! Diag.Report {
    let bool_rec = x_local(TYPE_BOOL, site.node)
    let lhs_rec = x_local(lhs_tid, site.node)
    let rhs_rec = x_local(rhs_tid, site.node)
    if x_stopped(bool_rec) || x_stopped(lhs_rec) || x_stopped(rhs_rec) { return false }
    let l = x_reread(left)
    let r = x_reread(right)
    if l < 0 || r < 0 { return false }
    let at_min = ir_binary(TYPE_BOOL, site.node, bool_rec.c_spelling, "==", l,
        ir_const(lhs_tid, site.node, lhs_rec.c_spelling, c_int_min_macro(x_kind(lhs_tid))))
    let by_minus_one = ir_binary(TYPE_BOOL, site.node, bool_rec.c_spelling, "==", r,
        ir_const(rhs_tid, site.node, rhs_rec.c_spelling, "-1"))
    let tripped = ir_binary(TYPE_BOOL, site.node, bool_rec.c_spelling, "&&", at_min, by_minus_one)
    let said = x_operands_message(site, lhs_tid, rhs_tid, left, right)
    if said < 0 { return false }
    x_hoist(ir_if(site.node, tripped, ir_block(site.node, [ir_panic(site.node, said)]), -1))
    true
}

// An operand the guard needs to read twice, as a value: already a name, or a fresh temp.
fn x_hold(tid: Int, node: Int, value: Int) -> Int ! Diag.Report {
    if ir_kind_is_name(ir_kind(value)) { return value }
    let bound = x_bind(tid, node, value)
    if bound == "" { return -1 }
    x_ref(tid, node, bound)
}

// A held operand read once more. A module global stays a GlobalRef, so no read of it
// names the global as if it were a local.
fn x_reread(held: Int) -> Int {
    if held < 0 { return -1 }
    if ir_kind(held) == IrKind.GlobalRef {
        return ir_global_ref(ir_tid(held), ir_span(held), ir_c_spelling(held), ir_c_name(held), ir_slot_form(held))
    }
    ir_var_ref(ir_tid(held), ir_span(held), ir_c_spelling(held), ir_c_name(held), ir_slot_form(held))
}

fn x_operand_test(node: Int, op: Str, lhs_tid: Int, rhs_tid: Int, held: Int) -> Int ! Diag.Report {
    let bool_rec = x_local(TYPE_BOOL, node)
    let rhs_rec = x_local(rhs_tid, node)
    if x_stopped(bool_rec) || x_stopped(rhs_rec) { return -1 }
    let operand = x_reread(held)
    if operand < 0 { return -1 }
    if op == "/" || op == "%" {
        return ir_binary(TYPE_BOOL, node, bool_rec.c_spelling, "==", operand,
            ir_const(rhs_tid, node, rhs_rec.c_spelling, "0"))
    }
    ir_binary(TYPE_BOOL, node, bool_rec.c_spelling, ">=", operand,
        ir_const(rhs_tid, node, rhs_rec.c_spelling, "{type_bit_width(lhs_tid)}"))
}

// The message a reader sees at the panic. It names the operation and, for a shift, the
// bound that was passed, because the amount itself is not known until the program runs.
fn x_guard_message(node: Int, op: Str, lhs_tid: Int) -> Int ! Diag.Report {
    let ty = tk_name(x_kind(lhs_tid))
    let mut text = "{ty} division by zero"
    if op == "<<" || op == ">>" {
        text = "shift amount out of range for {ty} (must be 0..{type_bit_width(lhs_tid) - 1})"
    }
    x_panic_message(node, x_pct_escape(text), [])
}

// Addition, subtraction and multiplication can leave the range of their own operands.
// C answers neither half of the promise: signed overflow is undefined and unsigned
// overflow wraps without a word. The wrapping methods are the opt-in escape, and they are
// method calls, so they never arrive here.
fn x_operator_can_overflow(op: Str, tid: Int) -> Bool {
    if is_integer_type(tid) == 0 { return false }
    op == "+" || op == "-" || op == "*"
}

// Both operands are held as names first: the check reads each one and the message reads
// it again, and an operand evaluated twice would run its effects twice.
fn x_checked_arith(site: ArithSite, rec: LayoutRecord, lhs_tid: Int, lhs: Int, rhs: Int) -> Int ! Diag.Report {
    let rhs_tid = tid_of_node(site.rhs_node)
    if rhs_tid < 0 { return -1 }
    let left = x_hold(lhs_tid, site.lhs_node, lhs)
    let right = x_hold(rhs_tid, site.rhs_node, rhs)
    if left < 0 || right < 0 { return -1 }
    let l = x_reread(left)
    let r = x_reread(right)
    let said = x_operands_message(site, lhs_tid, rhs_tid, left, right)
    x_checked_into(site.node, site.op, site.tid, rec, l, r, said)
}

// The operator becomes a declaration, a check and a read. The checked builtin computes
// into the declaration and answers whether the value fitted it, so the range it tests is
// the range of the result and one shape serves every width.
fn x_checked_into(node: Int, op: Str, tid: Int, rec: LayoutRecord, l: Int, r: Int, said: Int) -> Int ! Diag.Report {
    if l < 0 || r < 0 || said < 0 { return -1 }
    let bool_rec = x_local(TYPE_BOOL, node)
    if x_stopped(bool_rec) { return -1 }
    let out = x_bind(tid, node, -1)
    if out == "" { return -1 }
    let target = x_ref(tid, node, out)
    if target < 0 { return -1 }
    let into = ir_unary(tid, node, pointer_spelling(rec.c_spelling), "&", target)
    let overflowed = ir_call_runtime(TYPE_BOOL, node, bool_rec.c_spelling, c_overflow_builtin(op),
        bool_rec.slot_form, [l, r, into])
    x_hoist(ir_if(node, overflowed, ir_block(node, [ir_panic(node, said)]), -1))
    x_ref(tid, node, out)
}

// "U8 overflow in addition (255 + 1)", the form sections/03_types.md:785 shows. The
// operands are values only the run knows, so the message is formatted, and it is built
// inside the check, so the formatting runs only on the path that panics.
fn x_operands_message(site: ArithSite, lhs_tid: Int, rhs_tid: Int, left: Int, right: Int) -> Int ! Diag.Report {
    let lspec = x_operand_spec(lhs_tid, site.lhs_node)
    let rspec = x_operand_spec(rhs_tid, site.rhs_node)
    if lspec == "" || rspec == "" { return -1 }
    let l = x_reread(left)
    let r = x_reread(right)
    if l < 0 || r < 0 { return -1 }
    let what = "{tk_name(x_kind(site.tid))} overflow in {x_operation_word(site.op)} ({lspec} {site.op} {rspec})"
    x_panic_message(site.node, what, [
        x_promote_for_varargs(site.lhs_node, lhs_tid, l),
        x_promote_for_varargs(site.rhs_node, rhs_tid, r),
    ])
}

// Every operand an overflow check can reach is an integer, and every integer prints. An
// operand with no printed form is a gap in this stage, reported, so that a check never
// drops its statement without a word.
fn x_operand_spec(tid: Int, node: Int) -> Str ! Diag.Report {
    let spec = format_spec_of(tid)
    if spec == "" {
        diag_ice_at("OverflowOperandNotPrintable", CODEGEN_STAGE_NOT_BUILT,
            "an overflow message cannot print a {tk_name(x_kind(tid))} operand", node,
            "the checked operators print integer operands; this operand type needs a format")
    }
    spec
}

fn x_operation_word(op: Str) -> Str {
    match op {
        "+" => "addition"
        "-" => "subtraction"
        "*" => "multiplication"
        "/" => "division"
        _ => op
    }
}

// A panic sentence formatted when the program panics. `what` is a format: every value
// the run supplies is one of its conversions, in the order of `args`. It names the
// operator's own place, as a carrier panic does, so a caught panic reads the same.
pub fn x_panic_message(node: Int, what: Str, args: List[Int]) -> Int ! Diag.Report {
    let rec = x_local(TYPE_STR, node)
    if x_stopped(rec) { return -1 }
    let mut file = diag_file_for_node(node)
    if file == "" { file = diag_source_file }
    let line = if node_line(node) <= 0 { "<synthesized>" } else { "{node_line(node)}" }
    let sentence = "panic: {what} at {x_pct_escape(file)}:{line}"
    let mut parts = [ir_const(TYPE_STR, node, rec.c_spelling, c_string_literal(sentence))]
    for a in args { parts.push(a) }
    ir_call_runtime(TYPE_STR, node, rec.c_spelling, c_runtime_helper("str_format"), rec.slot_form, parts)
}

// Kinds C's own operators compare and arithmetic correctly: the scalars and the ordinal
// enums. A struct, data enum, Bytes or container operand desugars to a trait method.
pub fn x_is_c_comparable(tid: Int, rec: LayoutRecord) -> Bool {
    if rec.slot_form != SlotForm.InlineWord { return false }
    let k = x_kind(tid)
    if k == TyKind.Option { return false }
    if k == TyKind.List { return false }
    if k == TyKind.Map { return false }
    if k == TyKind.Set { return false }
    if k == TyKind.Bytes { return false }
    if k == TyKind.Fn { return false }
    true
}

// C compares a const char* by address, so every Str comparison goes through the runtime.
fn lower_str_binop(node: Int, op: Str) -> Int ! Diag.Report {
    let tid = tid_of_node(node)
    if tid < 0 { return -1 }
    let rec = x_local(tid, node)
    if x_stopped(rec) { return -1 }
    let lhs = lower_expr(node_left(node))
    let rhs = lower_expr(node_right(node))
    if lhs < 0 { return -1 }
    if rhs < 0 { return -1 }
    if op == "==" { return x_str_eq(node, tid, rec, lhs, rhs) }
    if op == "!=" { return ir_unary(tid, node, rec.c_spelling, "!", x_str_eq(node, tid, rec, lhs, rhs)) }
    lower_str_order(node, tid, rec, op, lhs, rhs)
}

fn x_str_eq(node: Int, tid: Int, rec: LayoutRecord, lhs: Int, rhs: Int) -> Int ! Diag.Report {
    ir_call_runtime(tid, node, rec.c_spelling, c_runtime_helper("str_eq"), rec.slot_form, [lhs, rhs])
}

fn lower_str_order(node: Int, tid: Int, rec: LayoutRecord, op: Str, lhs: Int, rhs: Int) -> Int ! Diag.Report {
    if op != "<" && op != "<=" && op != ">" && op != ">=" { return x_unhandled(node) }
    let cmp_rec = x_local(TYPE_INT, node)
    if x_stopped(cmp_rec) { return -1 }
    let cmp = ir_call_runtime(TYPE_INT, node, cmp_rec.c_spelling, c_runtime_helper("str_cmp"), SlotForm.InlineWord, [lhs, rhs])
    ir_binary(tid, node, rec.c_spelling, op, cmp, ir_const(TYPE_INT, node, cmp_rec.c_spelling, "0"))
}

fn x_is_comparison_op(op: Str) -> Bool {
    op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">="
}

// The spec gives Float a total order (NaN equals NaN and sorts above every other value,
// -0.0 equals 0.0), and C's own operators answer false for every comparison with a NaN.
// Only the comparisons come here: Float arithmetic is still C's.
fn lower_float_compare(node: Int, op: Str) -> Int ! Diag.Report {
    let tid = tid_of_node(node)
    if tid < 0 { return -1 }
    let rec = x_local(tid, node)
    if x_stopped(rec) { return -1 }
    let lhs = lower_expr(node_left(node))
    let rhs = lower_expr(node_right(node))
    if lhs < 0 { return -1 }
    if rhs < 0 { return -1 }
    if op == "==" || op == "!=" {
        let eq = ir_call_runtime(tid, node, rec.c_spelling, c_runtime_helper("float_eq"), rec.slot_form, [lhs, rhs])
        if op == "!=" { return ir_unary(tid, node, rec.c_spelling, "!", eq) }
        return eq
    }
    let cmp_rec = x_local(TYPE_INT, node)
    if x_stopped(cmp_rec) { return -1 }
    let cmp = ir_call_runtime(TYPE_INT, node, cmp_rec.c_spelling, c_runtime_helper("float_cmp"), SlotForm.InlineWord, [lhs, rhs])
    ir_binary(tid, node, rec.c_spelling, op, cmp, ir_const(TYPE_INT, node, cmp_rec.c_spelling, "0"))
}

// C's own && and || short-circuit, so the whole operator prints inline whenever the right
// operand needs no statement of its own. When it does, the statement would run
// unconditionally inside the operand, so the operator becomes a temp and an `if`.
fn lower_short_circuit(node: Int, op: Str) -> Int ! Diag.Report {
    let tid = tid_of_node(node)
    if tid < 0 { return -1 }
    let rec = x_local(tid, node)
    if x_stopped(rec) { return -1 }
    let lhs = lower_expr(node_left(node))
    if lhs < 0 { return -1 }
    // The mark splits the right operand's own statements from the left's. Only the right
    // operand's move into the guarded arm, because only they must wait on the test.
    let mark = cx_pending.len()
    let rhs = lower_expr(node_right(node))
    if rhs < 0 { return -1 }
    if cx_pending.len() == mark { return ir_binary(tid, node, rec.c_spelling, op, lhs, rhs) }
    let arm = x_take_from(mark)
    lower_short_circuit_guarded(node, tid, op, lhs, rhs, arm)
}

fn lower_short_circuit_guarded(node: Int, tid: Int, op: Str, lhs: Int, rhs: Int, arm: List[Int]) -> Int ! Diag.Report {
    let name = x_bind(tid, node, lhs)
    if name == "" { return -1 }
    let target = x_ref(tid, node, name)
    if target < 0 { return -1 }
    let mut stmts = arm
    stmts.push(ir_assign(node, target, rhs))
    let mut cond = x_ref(tid, node, name)
    if cond < 0 { return -1 }
    let rec = x_local(tid, node)
    if x_stopped(rec) { return -1 }
    if op == "||" { cond = ir_unary(tid, node, rec.c_spelling, "!", cond) }
    x_hoist(ir_if(node, cond, ir_block(node, stmts), -1))
    x_ref(tid, node, name)
}

// `a ?? b` reads the carrier's tag once, so the carrier is bound before it is read twice,
// and the default only runs on the None arm. C's conditional operator cannot hold the
// statements either arm may need, so this is a temp and an `if`.
fn lower_coalesce(node: Int) -> Int ! Diag.Report {
    let opt_node = node_left(node)
    let opt_tid = tid_of_node(opt_node)
    if opt_tid < 0 { return -1 }
    if x_kind(opt_tid) != TyKind.Option {
        diag_ice_at("CoalesceOnNonOption", CODEGEN_STAGE_NOT_BUILT,
            "`??` on a {tk_name(x_kind(opt_tid))} operand has no lowering", node,
            "`??` is the Option default operator; any other carrier needs its own lowering")
        return -1
    }
    let opt = lower_expr(opt_node)
    if opt < 0 { return -1 }
    let carrier = x_bind(opt_tid, opt_node, opt)
    if carrier == "" { return -1 }
    lower_coalesce_arms(node, opt_tid, carrier)
}

fn lower_coalesce_arms(node: Int, opt_tid: Int, carrier: Str) -> Int ! Diag.Report {
    let tid = tid_of_node(node)
    if tid < 0 { return -1 }
    let result = x_bind(tid, node, -1)
    if result == "" { return -1 }
    let mark = cx_pending.len()
    let fallback = lower_expr(node_right(node))
    if fallback < 0 { return -1 }
    let mut none_arm = x_take_from(mark)
    let none_target = x_ref(tid, node, result)
    if none_target < 0 { return -1 }
    none_arm.push(ir_assign(node, none_target, fallback))
    let some = x_payload_of(node, opt_tid, tid, carrier, Slot.Inner1, member_value)
    if some < 0 { return -1 }
    let some_target = x_ref(tid, node, result)
    if some_target < 0 { return -1 }
    let cond = x_tag_is(node, opt_tid, carrier, 1)
    if cond < 0 { return -1 }
    x_hoist(ir_if(node, cond, ir_block(node, [ir_assign(node, some_target, some)]), ir_block(node, none_arm)))
    x_ref(tid, node, result)
}

// The payload a carrier temp holds, unboxed when the member stores a pointer.
fn x_payload_of(node: Int, carrier_tid: Int, inner_tid: Int, carrier: Str, slot: Slot, member: Str) -> Int ! Diag.Report {
    let crec = x_local(carrier_tid, node)
    if x_stopped(crec) { return -1 }
    let obj = x_ref(carrier_tid, node, carrier)
    if obj < 0 { return -1 }
    // The opaque-handle Option's payload is the carrier word itself.
    if crec.slot_form == SlotForm.InlineWord {
        let held = x_local(inner_tid, node)
        if x_stopped(held) { return -1 }
        return ir_cast(inner_tid, node, held.c_spelling, obj)
    }
    let mem = x_member(carrier_tid, slot, node)
    if x_stopped(mem) { return -1 }
    if mem.slot_form != SlotForm.PointerBoxed { return x_unbox_payload(inner_tid, node, obj, mem, mem, member) }
    let rec = x_local(inner_tid, node)
    if x_stopped(rec) { return -1 }
    x_unbox_payload(inner_tid, node, obj, mem, rec, member)
}

// The one producer for a carrier member read that layout may have boxed: unwrap the member,
// and when its slot form is PointerBoxed, follow the box to `held` (the payload's own Local
// layout) rather than handing back the pointer. Every carrier-payload reader shares this
// tail, so `held` is taken from the caller instead of re-derived here -- a caller already
// holding one from its own read pass answers it directly, and one that does not looks it up
// (x_local or its equivalent) before calling in, the same way x_payload_of does above.
pub fn x_unbox_payload(inner_tid: Int, node: Int, obj: Int, member: LayoutRecord, held: LayoutRecord,
        arm: Str) -> Int ! Diag.Report {
    let got = ir_carrier_unwrap(inner_tid, node, member.c_spelling, arm, member.slot_form, obj)
    if member.slot_form != SlotForm.PointerBoxed { return got }
    ir_unbox(inner_tid, node, held.c_spelling, held.slot_form, got)
}

fn x_tag_is(node: Int, carrier_tid: Int, carrier: Str, want: Int) -> Int ! Diag.Report {
    let obj = x_ref(carrier_tid, node, carrier)
    if obj < 0 { return -1 }
    let int_rec = x_local(TYPE_INT, node)
    let bool_rec = x_local(TYPE_BOOL, node)
    if x_stopped(int_rec) { return -1 }
    if x_stopped(bool_rec) { return -1 }
    let crec = x_local(carrier_tid, node)
    if x_stopped(crec) { return -1 }
    // The opaque-handle Option holds no tag: Some is a live handle and None the null one.
    if crec.slot_form == SlotForm.InlineWord {
        let op = if want == 0 { "==" } else { "!=" }
        return ir_binary(TYPE_BOOL, node, bool_rec.c_spelling, op, obj, ir_const(carrier_tid, node, crec.c_spelling, "0"))
    }
    let tag = ir_carrier_tag(TYPE_INT, node, int_rec.c_spelling, obj)
    ir_binary(TYPE_BOOL, node, bool_rec.c_spelling, "==", tag, ir_const(TYPE_INT, node, int_rec.c_spelling, "{want}"))
}

fn lower_unary(node: Int) -> Int ! Diag.Report {
    let op = node_op(node)
    if op == "?" { return lower_try(node) }
    let tid = tid_of_node(node)
    if tid < 0 { return -1 }
    let rec = x_local(tid, node)
    if x_stopped(rec) { return -1 }
    if op == "-" && node_kind(node_left(node)) == NodeKind.IntLit { return x_negative_literal(node, tid, rec) }
    let operand = lower_expr(node_left(node))
    if operand < 0 { return -1 }
    if op == "-" && is_integer_type(tid) != 0 { return x_checked_negation(node, tid, rec, operand) }
    ir_unary(tid, node, rec.c_spelling, op, operand)
}

// A minus written on an integer literal is one negative constant, not a negation to
// check, so a type's own minimum stays a value and a global set to one stays a C
// constant. The 64-bit minimum has no decimal C spelling, so it takes the macro.
fn x_negative_literal(node: Int, tid: Int, rec: LayoutRecord) -> Int ! Diag.Report {
    let lit = node_left(node)
    let s = node_str_val(lit)
    let text = if s == "" { "{node_int_val(lit)}" } else { s }
    if text == "9223372036854775808" && x_is_signed_int(tid) {
        return ir_const(tid, node, rec.c_spelling, c_int_min_macro(TyKind.Int))
    }
    ir_const(tid, node, rec.c_spelling, "-{text}")
}

// Zero minus the operand, checked like any subtraction: only a signed minimum has no
// negation in its own type.
fn x_checked_negation(node: Int, tid: Int, rec: LayoutRecord, operand: Int) -> Int ! Diag.Report {
    let src = node_left(node)
    let held = x_hold(tid, src, operand)
    if held < 0 { return -1 }
    let spec = x_operand_spec(tid, src)
    let shown = x_reread(held)
    if spec == "" || shown < 0 { return -1 }
    let said = x_panic_message(node, "{tk_name(x_kind(tid))} overflow in negation (-({spec}))",
        [x_promote_for_varargs(src, tid, shown)])
    let zero = ir_const(tid, node, rec.c_spelling, "0")
    x_checked_into(node, "-", tid, rec, zero, x_reread(held), said)
}

// `x?` reads the carrier twice, so the carrier is bound first. The failure arm returns
// from the enclosing function, which is why this is a statement the expression hoists
// rather than anything C can write inline.
fn lower_try(node: Int) -> Int ! Diag.Report {
    let src = node_left(node)
    let carrier_tid = tid_of_node(src)
    if carrier_tid < 0 { return -1 }
    let k = x_kind(carrier_tid)
    if k != TyKind.Option && k != TyKind.Result {
        diag_ice_at("TryOnNonCarrier", CODEGEN_STAGE_NOT_BUILT,
            "`?` on a {tk_name(k)} operand has no lowering", node,
            "`?` propagates an Option or a Result; nothing else carries a failure arm")
        return -1
    }
    // A test body declares no result, so it has no return type to want.
    if !cx_test_body && cx_return_type < 0 {
        diag_ice_at("TryWithoutReturnType", CODEGEN_STAGE_NOT_BUILT,
            "`?` needs the result type of the body being lowered and none was set", node,
            "the stage that owns the body sets it before lowering: the statement stage for a named function, the driver for a queued closure thunk")
        return -1
    }
    let value = lower_expr(src)
    if value < 0 { return -1 }
    let carrier = x_bind(carrier_tid, src, value)
    if carrier == "" { return -1 }
    lower_try_arms(node, carrier_tid, k, carrier)
}

fn lower_try_arms(node: Int, carrier_tid: Int, k: TyKind, carrier: Str) -> Int ! Diag.Report {
    let fail_tag = if k == TyKind.Option { 0 } else { 1 }
    let cond = x_tag_is(node, carrier_tid, carrier, fail_tag)
    if cond < 0 { return -1 }
    let frame = cg_expr_frame_current()
    let arm = if frame != "" {
        ir_block(node, [ir_panic_catch_exit(node, frame)])
    } else if cx_test_body {
        x_test_propagate_arm(node, carrier_tid, k, carrier)
    } else {
        x_carrier_return_arm(node, carrier_tid, k, carrier)
    }
    if arm < 0 { return -1 }
    x_hoist(ir_if(node, cond, arm, -1))
    let inner_tid = tid_of_node(node)
    if inner_tid < 0 { return -1 }
    // Both carriers hold their success in the first slot; only the member name differs.
    let member = if k == TyKind.Option { member_value } else { member_ok }
    x_payload_of(node, carrier_tid, inner_tid, carrier, Slot.Inner1, member)
}

// The failure arm of an ordinary body: the carrier the enclosing function declares,
// returned out of it.
fn x_carrier_return_arm(node: Int, carrier_tid: Int, k: TyKind, carrier: Str) -> Int ! Diag.Report {
    let propagated = lower_try_propagate(node, carrier_tid, k, carrier)
    if propagated < 0 { return -1 }
    let out = cg_stmt_return_value(node, propagated)
    if out < 0 { return -1 }
    ir_block(node, [out])
}

// The failure arm of a test body. The body has no result, so it cannot return a carrier.
// It calls the runtime to record the failure and then returns with no value.
//
// The return with no value is required, not a formality. It runs the cleanup destructor of
// every in-scope `with` binding. A jump out of the frame would skip them.
//
// The message and the error type name come from the operand's own carrier, never from an
// annotation. The carrier is the type the failure comes out of.
fn x_test_propagate_arm(node: Int, carrier_tid: Int, k: TyKind, carrier: Str) -> Int ! Diag.Report {
    // The runtime records the line and the column as numbers and has no spelling for
    // "no position", so a node without both has nothing to give it.
    if node_line(node) <= 0 || node_col(node) <= 0 {
        diag_ice_at("TryInTestBodyHasNoPosition", CODEGEN_STAGE_NOT_BUILT,
            "`?` in a test body has no source position to report the failure at", node,
            "the runtime records a line and a column as numbers; a synthesized `?` must copy the position of the expression it replaces")
        return -1
    }
    // Both the message and the type name read the Result error slot, so it is read once
    // here. An Option has no error slot and neither reads this tid.
    let err_tid = if k == TyKind.Option { TYPE_VOID } else { child_tid(carrier_tid, Slot.Inner2) }
    if err_tid < 0 {
        diag_ice_at("TestErrorTypeMissing", CODEGEN_STAGE_NOT_BUILT,
            "the Result a test body's `?` propagates has no error type", node,
            "a Result holds its error in the second slot; the runtime is given the type from there")
        return -1
    }
    let message = x_test_propagate_message(node, carrier_tid, k, carrier, err_tid)
    if message < 0 { return -1 }
    let str_rec = x_local(TYPE_STR, node)
    let int_rec = x_local(TYPE_INT, node)
    if x_stopped(str_rec) { return -1 }
    if x_stopped(int_rec) { return -1 }
    // The C body has no result, so the call's own value has no type to take.
    let void_rec = layout_of(TYPE_VOID, Position.Return)
    if x_stopped(void_rec) { return -1 }
    let args = [
        message,
        ir_const(TYPE_STR, node, str_rec.c_spelling,
            c_string_literal(x_test_error_type_name(k, err_tid))),
        ir_const(TYPE_STR, node, str_rec.c_spelling, c_string_literal(diag_file_for_node(node))),
        ir_const(TYPE_INT, node, int_rec.c_spelling, "{node_line(node)}"),
        ir_const(TYPE_INT, node, int_rec.c_spelling, "{node_col(node)}"),
    ]
    let call = ir_call_runtime(TYPE_VOID, node, void_rec.c_spelling, c_test_propagate_name(),
        void_rec.slot_form, args)
    ir_block(node, [ir_expr_stmt(node, call), ir_return(node, -1)])
}

// The text the runner prints for the failure. An Option has no error value, so the word is
// fixed. A Str error is already that text. Any other error is rendered by a call to its
// Display impl on the payload, which is the route a Display hole takes. An error type with
// no Display impl is refused there by name.
fn x_test_propagate_message(node: Int, carrier_tid: Int, k: TyKind, carrier: Str,
        err_tid: Int) -> Int ! Diag.Report {
    if k == TyKind.Option {
        let str_rec = x_local(TYPE_STR, node)
        if x_stopped(str_rec) { return -1 }
        return ir_const(TYPE_STR, node, str_rec.c_spelling, c_string_literal(ctor_none))
    }
    let payload = x_payload_of(node, carrier_tid, err_tid, carrier, Slot.Inner2, member_err)
    if payload < 0 { return -1 }
    if x_kind(err_tid) == TyKind.Str { return payload }
    lower_display_of_value(node, err_tid, payload)
}

// The error type name the runner prints beside the message. A nominal type gives its own
// name without the module that declares it. Any other type is named by its kind, which is
// the name the surface language spells it with. Every kind has such a name, so this is
// total and cannot fail.
fn x_test_error_type_name(k: TyKind, err_tid: Int) -> Str {
    if k == TyKind.Option { return tk_name(TyKind.Option) }
    let nominal = tc_tid_struct(tc_resolve(err_tid))
    if nominal != "" { return nominal }
    tk_name(x_kind(err_tid))
}

// The failure the caller sees. A None stays a None whatever the function returns; an Err
// carries its payload across, which is sound only when both sides name the same error.
fn lower_try_propagate(node: Int, carrier_tid: Int, k: TyKind, carrier: Str) -> Int ! Diag.Report {
    let ret = cx_return_type
    if k == TyKind.Option { return lower_none(node, ret) }
    if x_kind(ret) != TyKind.Result {
        diag_ice_at("TryResultInNonResultFn", CODEGEN_STAGE_NOT_BUILT,
            "`?` on a Result inside a function returning {tk_name(x_kind(ret))}", node,
            "typecheck must reject this before codegen; there is no error arm to return into")
        return -1
    }
    let err_tid = child_tid(ret, Slot.Inner2)
    if err_tid < 0 { return -1 }
    let payload = x_payload_of(node, carrier_tid, err_tid, carrier, Slot.Inner2, member_err)
    if payload < 0 { return -1 }
    x_wrap_value(node, ret, Slot.Inner2, member_err, 1, payload)
}

// ── Aggregates ────────────────────────────────────────────────────────────

fn lower_tuple_lit(node: Int) -> Int ! Diag.Report {
    let tid = tid_of_node(node)
    if tid < 0 { return -1 }
    let rec = x_local(tid, node)
    if x_stopped(rec) { return -1 }
    // `()` parses as the empty tuple and types as Void, which C holds as the placeholder
    // word, so it is a constant and not a compound literal with no members.
    if x_is_void_like(tid) { return ir_const(tid, node, rec.c_spelling, "0") }
    ensure_typedef_for(tid)
    let elems = x_lower_all(node_elements(node))
    let mut i = 0
    while i < elems.len() {
        if elems.get(i).unwrap() < 0 { return -1 }
        i = i + 1
    }
    ir_tuple_new(tid, node, rec.c_spelling, elems)
}

fn x_lower_all(sl: Int) -> List[Int] ! Diag.Report {
    let mut out: List[Int] = []
    if sl < 0 { return out }
    let mut i = 0
    while i < sublist_length(sl) {
        out.push(lower_expr(sublist_get(sl, i)))
        i = i + 1
    }
    out
}

// The elements a container literal is written with. A written element is an expression; a
// spread copies another container into this one. Only the literal names the container being
// filled, so the literal calls the copy and passes that destination.
//
// A written element enters a slot, so the call stage builds it. That stage owns the form a
// value takes in a cell, and one owner is what keeps a literal, a push and a read in
// agreement. A spread is a whole container rather than one element and fills no cell here.
//
// A refused element stops the loop. Every later element would report the same cause again,
// and none of them can be built into a literal that is not built.
fn x_lower_container_elements(sl: Int, into_tid: Int) -> List[Int] ! Diag.Report {
    let mut out: List[Int] = []
    if sl < 0 { return out }
    let mut i = 0
    while i < sublist_length(sl) {
        let e = sublist_get(sl, i)
        let built = if nk_of(node_kind(e)) == NodeKind.SpreadExpr {
            lower_spread(e, into_tid)
        } else {
            lower_element_store(e, into_tid, Slot.Inner1)
        }
        out.push(built)
        if built < 0 { return out }
        i = i + 1
    }
    out
}

// A container literal hands its elements to the runtime constructor. A map or set literal
// also needs the key-operations table for its key tid, and the IR carries no slot for one.
fn lower_list_lit(node: Int) -> Int ! Diag.Report {
    let tid = tid_of_node(node)
    if tid < 0 { return -1 }
    let k = x_kind(tid)
    if k != TyKind.List && k != TyKind.Map && k != TyKind.Set { return x_unhandled(node) }
    let rec = x_local(tid, node)
    if x_stopped(rec) { return -1 }
    let ctor = c_container_ctor(tid)
    if diag_is_ice_seg(ctor) { return x_unhandled(node) }
    let elems = x_lower_container_elements(node_elements(node), tid)
    let mut i = 0
    while i < elems.len() {
        if elems.get(i).unwrap() < 0 { return -1 }
        i = i + 1
    }
    let mut kops_table = ""
    if k == TyKind.Map || k == TyKind.Set {
        let key_layout = layout_of(child_tid(tid, Slot.Inner1), Position.Local)
        if key_layout.kops_table == "" {
            diag_ice_at("ContainerCtorNeedsKeyOps", CODEGEN_STAGE_NOT_BUILT,
                "a {tk_name(k)} literal answers a container whose key operations are chosen from the key type", node,
                "the key type has no table of the operations its keys are compared and hashed by")
            return -1
        }
        kops_table = key_layout.kops_table
    }
    ir_container_new(tid, node, rec.c_spelling, ctor, kops_table, elems)
}

// A struct literal writes its fields in declaration order, whatever order the source
// names them, because C fills a compound literal positionally.
//
// A struct-style variant literal is not a struct literal at all. `Shape.Rect { width: 3,
// height: 4 }` builds one arm of an enum, so the node's tid is the enum, and the spelling
// is the other surface syntax for `Shape.Rect(3, 4)`; 03_types.md:1036 requires the two to
// emit identical code. Only where the written values sit differs between them, so the tid
// is asked first and a variant construction goes to its one producer.
fn lower_struct_lit(node: Int) -> Int ! Diag.Report {
    let tid = tid_of_node(node)
    if tid < 0 { return -1 }
    if x_kind(tid) == TyKind.Enum { return x_variant_lit(node, tid) }
    let rec = x_local(tid, node)
    if x_stopped(rec) { return -1 }
    let decl = tc_tid_decl_node(tid)
    if decl < 0 {
        diag_ice_at("StructLiteralWithoutDecl", CODEGEN_STAGE_NOT_BUILT,
            "the literal's tid has no type declaration to take a field order from", node,
            "only a declared struct has a field order; a literal of any other tid is a typecheck bug")
        return -1
    }
    ensure_typedef_for(tid)
    let sp = x_spread_node(node)
    let mut base = SpreadBase {}
    if sp >= 0 {
        base = x_bind_spread(sp)
        if base.name == "" { return -1 }
    }
    let values = x_struct_fields(node, decl, base)
    let mut i = 0
    while i < values.len() {
        if values.get(i).unwrap() < 0 { return -1 }
        i = i + 1
    }
    ir_struct_new(tid, node, rec.c_spelling, values)
}

fn x_struct_fields(node: Int, decl: Int, base: SpreadBase) -> List[Int] ! Diag.Report {
    let decls = node_fields(decl)
    let given = node_fields(node)
    let mut out: List[Int] = []
    let mut i = 0
    while i < sublist_length(decls) {
        let fd = sublist_get(decls, i)
        out.push(x_struct_field_value(node, fd, given, base))
        i = i + 1
    }
    out
}

fn x_struct_field_value(node: Int, fd: Int, given: Int, base: SpreadBase) -> Int ! Diag.Report {
    let want = node_name(fd)
    let mut j = 0
    while j < sublist_length(given) {
        let g = sublist_get(given, j)
        if node_name(g) == want { return lower_expr(node_value(g)) }
        j = j + 1
    }
    // A spread supplies every field the literal does not name, and it outranks the
    // field's default: the reader asked for the source's value, not for a fresh one.
    if base.name != "" { return x_field_of_spread(node, want, base) }
    let default = node_condition(fd)
    if default >= 0 { return lower_expr(default) }
    diag_ice_at("StructLiteralFieldMissing", CODEGEN_STAGE_NOT_BUILT,
        "the literal gives no value for field `{want}` and the field has no default", node,
        "typecheck must reject an incomplete struct literal before codegen")
    -1
}

// ── Struct-style variant literals ─────────────────────────────────────────

// The arm a struct-style literal builds, from the values it writes for the variant's
// declared fields. Everything physical about the arm belongs to the variant constructor
// that the call spelling already goes through, so nothing about a tag, a union member or a
// boxed self-recursive field is decided here.
fn x_variant_lit(node: Int, tid: Int) -> Int ! Diag.Report {
    let spelled = node_type_name(node)
    let dot = spelled.index_of(".")
    let vname = if dot < 0 { spelled } else { spelled.slice(dot + 1, spelled.len()) }
    let owner = if dot < 0 { tc_type_str(tid) } else { spelled.slice(0, dot) }
    let decl = tc_tid_decl_node(tid)
    if decl < 0 {
        diag_ice_at("VariantLiteralWithoutDecl", CODEGEN_STAGE_NOT_BUILT,
            "the literal builds a variant of `{owner}`, whose tid has no type declaration", node,
            "a variant is read from its enum's declaration; an enum tid without one is a typecheck bug")
        return -1
    }
    let vnode = x_variant_decl(decl, vname)
    if vnode < 0 {
        diag_ice_at("VariantLiteralNotDeclared", CODEGEN_STAGE_NOT_BUILT,
            "enum `{owner}` declares no variant named `{vname}` for this literal to build", node,
            "typecheck resolves the variant a struct-style literal names before codegen builds it")
        return -1
    }
    // A spread fills the fields of a struct from another value of the same struct. A variant
    // is not a type of its own, so there is no value to spread from and no such form.
    if x_spread_node(node) >= 0 {
        diag_ice_at("VariantLiteralSpread", CODEGEN_STAGE_NOT_BUILT,
            "the literal spreads a value into variant `{owner}.{vname}`, which has no spread form", node,
            "typecheck must reject a spread on a struct-style variant literal before codegen")
        return -1
    }
    let values = x_variant_lit_values(node, vnode, owner, vname)
    if values.len() != x_variant_arity(vnode) { return -1 }
    cc_enum_variant_construct(node, tid, vnode, owner, vname, values)
}

// The value the literal writes for each declared field of the variant, in DECLARED order,
// which is the order the arm's fields are written in. A field is filled by NAME, because a
// struct-style literal names every value it writes; a field the literal leaves out takes
// the field's own default, the rule a struct literal's omitted field already follows.
//
// The nodes are unlowered. The arm's builder lays each field out before it lowers that
// field's operand, so lowering here would put the operands ahead of that check.
//
// A refusal answers an empty list, which the caller reads as short: a complete list is the
// only other answer this can give.
fn x_variant_lit_values(node: Int, vnode: Int, owner: Str, vname: Str) -> List[Int] ! Diag.Report {
    let refused: List[Int] = []
    let decls = node_fields(vnode)
    let mut out: List[Int] = []
    if decls == -1 { return out }
    let mut i = 0
    while i < sublist_length(decls) {
        let fd = sublist_get(decls, i)
        let want = node_name(fd)
        let mut found = x_variant_lit_field_value(node, want)
        if found < 0 { found = node_condition(fd) }
        if found < 0 {
            diag_ice_at("VariantLiteralFieldMissing", CODEGEN_STAGE_NOT_BUILT,
                "the literal gives no value for field `{want}` of variant `{owner}.{vname}` and the field has no default", node,
                "typecheck must reject an incomplete struct-style variant literal before codegen")
            return refused
        }
        out.push(found)
        i = i + 1
    }
    out
}

fn x_variant_lit_field_value(node: Int, want: Str) -> Int {
    let given = node_fields(node)
    if given == -1 { return -1 }
    let mut j = 0
    while j < sublist_length(given) {
        let g = sublist_get(given, j)
        if node_name(g) == want { return node_value(g) }
        j = j + 1
    }
    -1
}

fn x_variant_arity(vnode: Int) -> Int {
    let fields = node_fields(vnode)
    if fields == -1 { 0 } else { sublist_length(fields) }
}

// The spread entry of a struct literal, or -1 when the literal names every field itself.
fn x_spread_node(node: Int) -> Int {
    let given = node_fields(node)
    let mut j = 0
    while j < sublist_length(given) {
        let g = sublist_get(given, j)
        if nk_of(node_kind(g)) == NodeKind.SpreadExpr { return g }
        j = j + 1
    }
    -1
}

fn x_bind_spread(sp: Int) -> SpreadBase ! Diag.Report {
    let src = node_value(sp)
    let tid = tid_of_node(src)
    if tid < 0 { return SpreadBase {} }
    let value = lower_expr(src)
    if value < 0 { return SpreadBase {} }
    let decl = tc_tid_decl_node(tid)
    if decl < 0 {
        diag_ice_at("SpreadSourceWithoutDecl", CODEGEN_STAGE_NOT_BUILT,
            "the spread source is a {tk_name(x_kind(tid))}, which declares no fields", sp,
            "typecheck must reject a spread source that is not a struct")
        return SpreadBase {}
    }
    let name = x_bind(tid, src, value)
    if name == "" { return SpreadBase {} }
    SpreadBase { name: name, tid: tid, decl: decl }
}

fn x_field_of_spread(node: Int, want: Str, base: SpreadBase) -> Int ! Diag.Report {
    let ftid = tc_field_tid_at_instance(base.tid, want)
    if ftid < 0 {
        diag_ice_at("SpreadSourceHasNoField", CODEGEN_STAGE_NOT_BUILT,
            "the spread source has no field `{want}` for the literal to take", node,
            "typecheck must reject a spread that leaves a field of the literal unfilled")
        return -1
    }
    let mem = x_field(base.tid, ftid, node)
    if x_stopped(mem) { return -1 }
    let obj = x_ref(base.tid, node, base.name)
    if obj < 0 { return -1 }
    ir_field_get(ftid, node, mem.c_spelling, c_field_name(want), mem.slot_form, obj)
}

// ── Access ────────────────────────────────────────────────────────────────

fn lower_field_access(node: Int) -> Int ! Diag.Report {
    let obj = node_obj(node)
    if x_variant_of(node, obj) >= 0 { return x_variant_const(node, obj) }
    if x_module_qualifier(obj) != "" { return lower_module_global(node, obj) }
    let obj_tid = tid_of_node(obj)
    if obj_tid < 0 { return -1 }
    if x_kind(obj_tid) == TyKind.Tuple { return lower_tuple_index(node, obj, obj_tid) }
    lower_struct_field(node, obj, obj_tid)
}

// `mod.NAME` reads another module's global. The qualifier names a module, not a value, so
// nothing reads a type for it. A binding of that name outranks the module, which is the
// same rule name resolution applied when it typed the access. The answer is the module
// key a declaration is filed under, because `import std.process` is written `process.` at
// the use site and only typecheck's import map knows the two are the same module.
fn x_module_qualifier(obj: Int) -> Str {
    if nk_of(node_kind(obj)) != NodeKind.Ident { return "" }
    let name = node_name(obj)
    if x_is_local(name) { return "" }
    if tc_global_decl_node(obj) >= 0 { return "" }
    if is_import_module_name(name) == 0 { return "" }
    tc_qualifier_to_module_or_self(name)
}

fn lower_module_global(node: Int, obj: Int) -> Int ! Diag.Report {
    let tid = tid_of_node(node)
    if tid < 0 { return -1 }
    let rec = x_local(tid, node)
    if x_stopped(rec) { return -1 }
    let module = x_module_qualifier(obj)
    let field = node_name(node)
    let decl = x_global_decl(module, field)
    if decl < 0 {
        diag_ice_at("ModuleGlobalNotBound", CODEGEN_STAGE_NOT_BUILT,
            "module `{module}` has no global named `{field}` in the declaration registry", node,
            "the driver must build the registries before a body that reads a module global is lowered")
        return -1
    }
    ir_global_ref(tid, node, rec.c_spelling, c_global_name(decl), rec.slot_form)
}

// `Colour.Red` names a variant, not a field: the object is a type name and has no value.
// The answer is the variant's own declaration node, or -1 when the object is a value.
fn x_variant_of(node: Int, obj: Int) -> Int {
    if nk_of(node_kind(obj)) != NodeKind.Ident { return -1 }
    if node_str_val(obj) != "" { return -1 }
    let named = lookup_named_type(node_name(obj))
    if named < 0 { return -1 }
    let decl = tc_tid_decl_node(named)
    if decl < 0 { return -1 }
    x_variant_decl(decl, node_name(node))
}

fn x_variant_const(node: Int, obj: Int) -> Int ! Diag.Report {
    x_variant_from_decl(node, x_variant_of(node, obj))
}

// Builds a payload-less variant value from its declaration node. `Colour.Red` and a bare
// `Red` (no qualifier, resolved by typecheck to the same enum) are the same value and must
// emit identical code, so both callers land here.
fn x_variant_from_decl(node: Int, vd: Int) -> Int ! Diag.Report {
    let tid = tid_of_node(node)
    if tid < 0 { return -1 }
    let rec = x_local(tid, node)
    if x_stopped(rec) { return -1 }
    let macro = c_variant_discriminant(tid, vd)
    if diag_is_ice_seg(macro) { return x_unhandled(node) }
    // An enum whose every variant carries nothing is one ordinal word, so the tag macro is
    // the whole value. Any data-carrying variant makes the enum a tagged struct instead, and
    // the value of a payload-less arm is that struct with its tag set and no payload written.
    if rec.slot_form == SlotForm.InlineWord { return ir_const(tid, node, rec.c_spelling, macro) }
    let _td = ensure_typedef_for(tid)
    let tag_rec = x_local(TYPE_INT, node)
    if x_stopped(tag_rec) { return -1 }
    ir_enum_new(tid, node, rec.c_spelling, vd, "",
        ir_const(TYPE_INT, node, tag_rec.c_spelling, macro), [])
}

fn x_bare_variant_decl(tid: Int, name: Str) -> Int {
    if x_kind(tid) != TyKind.Enum { return -1 }
    let decl = tc_tid_decl_node(tid)
    if decl < 0 { return -1 }
    x_variant_decl(decl, name)
}

fn x_variant_decl(decl: Int, name: Str) -> Int {
    let vs = node_fields(decl)
    let mut i = 0
    while i < sublist_length(vs) {
        let v = sublist_get(vs, i)
        if node_name(v) == name { return v }
        i = i + 1
    }
    -1
}

fn lower_tuple_index(node: Int, obj: Int, obj_tid: Int) -> Int ! Diag.Report {
    let idx = node_name(node).to_int()
    let tid = tid_of_node(node)
    if tid < 0 { return -1 }
    let mem = x_member(obj_tid, Slot.Elem(idx), node)
    if x_stopped(mem) { return -1 }
    let target = lower_expr(obj)
    if target < 0 { return -1 }
    ir_field_get(tid, node, mem.c_spelling, c_tuple_member(idx), mem.slot_form, target)
}

fn lower_struct_field(node: Int, obj: Int, obj_tid: Int) -> Int ! Diag.Report {
    let tid = tid_of_node(node)
    if tid < 0 { return -1 }
    let decl = tc_tid_decl_node(obj_tid)
    if decl < 0 {
        diag_ice_at("FieldOwnerWithoutDecl", CODEGEN_STAGE_NOT_BUILT,
            "field `{node_name(node)}` read from a {tk_name(x_kind(obj_tid))}, which declares no fields", node,
            "only a declared type has fields; any other owner is a typecheck bug")
        return -1
    }
    let rec = x_field(obj_tid, tid, node)
    if x_stopped(rec) { return -1 }
    let target = lower_expr(obj)
    if target < 0 { return -1 }
    ir_field_get(tid, node, rec.c_spelling, c_field_name(node_name(node)), rec.slot_form, target)
}

// `xs[i]` is handed whole to the stage that owns the read. That stage owns it because `[i]`
// and `.get(i)` read the same container the same way and differ only in what they answer,
// so one reader serves both, and it lowers the two operands itself once it can answer.
fn lower_index(node: Int) -> Int ! Diag.Report {
    lower_element_read(node)
}

// ── Calls ─────────────────────────────────────────────────────────────────

// Only the carrier constructors are lowered here: they build a value out of layout's
// answer and need no dispatch. Every other call, free or method, is cg_call's.
fn lower_call_expr(node: Int) -> Int ! Diag.Report {
    match cx_old_snapshots.get(node) {
        Some(snap) => return x_old_snapshot_read(node, snap)
        None => {}
    }
    let callee = node_left(node)
    if callee >= 0 {
        if nk_of(node_kind(callee)) == NodeKind.Ident {
            let name = node_name(callee)
            if name == ctor_some { return lower_wrap(node, Slot.Inner1, member_value, 1) }
            if name == ctor_ok { return lower_wrap(node, Slot.Inner1, member_ok, 0) }
            if name == ctor_err { return lower_wrap(node, Slot.Inner2, member_err, 1) }
            if name == ctor_none {
                let tid = tid_of_node(node)
                if tid < 0 { return -1 }
                return lower_none(node, tid)
            }
        }
    }
    lower_call(node)
}

fn x_old_snapshot_read(node: Int, snap: Str) -> Int ! Diag.Report {
    let tid = tid_of_node(node)
    if tid < 0 { return -1 }
    let rec = x_local(tid, node)
    if x_stopped(rec) { return -1 }
    ir_var_ref(tid, node, rec.c_spelling, snap, rec.slot_form)
}

// ── Interpolation ─────────────────────────────────────────────────────────

// One value as text, for a caller that holds a value rather than an interpolated string:
// an io print takes text, and the value it is handed may be of any printable type. The
// answer comes from the same hole renderer an interpolation uses, so a print and a
// "{x}" of the same expression render alike and cannot drift apart.
//
// A hole that already answered text is answered as it stands. Its spec is the one a string
// takes, and formatting a string through that spec again would copy it to say nothing
// about it.
pub fn lower_value_as_text(node: Int) -> Int ! Diag.Report {
    let tid = tid_of_node(node)
    if tid < 0 { return -1 }
    if x_kind(tid) == TyKind.Str { return lower_expr(node) }
    let hole = x_interp_hole(node)
    if hole.spec == "" { return -1 }
    if hole.spec == format_spec_of(TYPE_STR) { return hole.arg }
    let rec = x_local(TYPE_STR, node)
    if x_stopped(rec) { return -1 }
    let fmt = ir_const(TYPE_STR, node, rec.c_spelling, c_string_literal(hole.spec))
    ir_call_runtime(TYPE_STR, node, rec.c_spelling, c_runtime_helper("str_format"), rec.slot_form,
        [fmt, hole.arg])
}

// An interpolated string with no holes is one C string constant. With holes it is one
// call to the runtime formatter, which sizes the buffer exactly, because the spec puts no
// length cap on interpolation.
fn lower_interp(node: Int) -> Int ! Diag.Report {
    let tid = tid_of_node(node)
    if tid < 0 { return -1 }
    let rec = x_local(tid, node)
    if x_stopped(rec) { return -1 }
    if x_kind(tid) == TyKind.Template { return lower_template(node, tid, rec) }
    let parts = node_elements(node)
    if x_all_literal(parts) { return ir_const(tid, node, rec.c_spelling, c_string_literal(x_joined(parts))) }
    lower_interp_call(node, tid, rec, parts)
}

fn lower_interp_call(node: Int, tid: Int, rec: LayoutRecord, parts: Int) -> Int ! Diag.Report {
    let mut fmt = ""
    let mut holes: List[Int] = []
    let mut i = 0
    while i < sublist_length(parts) {
        let part = sublist_get(parts, i)
        if interp_part_is_literal(part) {
            fmt = fmt.concat(x_pct_escape(node_str_val(part)))
        } else {
            let hole = x_interp_hole(part)
            if hole.spec == "" { return -1 }
            fmt = fmt.concat(hole.spec)
            holes.push(hole.arg)
        }
        i = i + 1
    }
    let mut args = [ir_const(TYPE_STR, node, rec.c_spelling, c_string_literal(fmt))]
    let mut j = 0
    while j < holes.len() {
        args.push(holes.get(j).unwrap())
        j = j + 1
    }
    ir_call_runtime(tid, node, rec.c_spelling, c_runtime_helper("str_format"), rec.slot_form, args)
}

// A literal a Template parameter took. The text between value holes goes to parts and each
// value keeps its own type, so a handler binds it instead of splicing it. Every builder
// answers the template, which makes the whole literal one expression.
fn lower_template(node: Int, tid: Int, rec: LayoutRecord) -> Int ! Diag.Report {
    let parts = node_elements(node)
    let n = if parts < 0 { 0 } else { sublist_length(parts) }
    let word = x_local(TYPE_INT, node)
    if x_stopped(word) { return -1 }
    let count = ir_const(TYPE_INT, node, word.c_spelling, "{x_template_value_count(parts, n)}")
    let mut t = ir_call_runtime(tid, node, rec.c_spelling, c_runtime_helper("template_new"), rec.slot_form, [count])
    let mut from = 0
    let mut i = 0
    while i <= n {
        if i == n || x_template_takes_value(sublist_get(parts, i)) {
            let text = x_template_segment(node, parts, from, i)
            if text < 0 { return -1 }
            t = x_template_push(node, tid, rec, "template_push_part", t, text)
            if i < n {
                let value = x_template_value(sublist_get(parts, i))
                if value.op == "" { return -1 }
                t = x_template_push(node, tid, rec, value.op, t, value.arg)
            }
            from = i + 1
        }
        i = i + 1
    }
    t
}

type TemplateValue {
    op: Str = ""
    arg: Int = -1
}

fn x_template_push(node: Int, tid: Int, rec: LayoutRecord, op: Str, t: Int, arg: Int) -> Int {
    ir_call_runtime(tid, node, rec.c_spelling, c_runtime_helper(op), rec.slot_form, [t, arg])
}

// Raw() is not a value: it folds into the text around it, which is the bypass it asks for.
// A part with no type has already reported; it counts as a value so its lowering stops.
fn x_template_takes_value(part: Int) -> Bool ! Diag.Report {
    if interp_part_is_literal(part) { return false }
    let tid = tid_of_node(part)
    if tid < 0 { return true }
    x_kind(tid) != TyKind.Raw
}

fn x_template_value_count(parts: Int, n: Int) -> Int ! Diag.Report {
    let mut count = 0
    let mut i = 0
    while i < n {
        if x_template_takes_value(sublist_get(parts, i)) { count = count + 1 }
        i = i + 1
    }
    count
}

// The text of parts [from, to): literal chunks, and the rendered value of each Raw(x) among
// them. With no Raw it is a constant; otherwise it is formatted like any interpolation.
fn x_template_segment(node: Int, parts: Int, from: Int, to: Int) -> Int ! Diag.Report {
    let text = x_local(TYPE_STR, node)
    if x_stopped(text) { return -1 }
    let mut raw = ""
    let mut fmt = ""
    let mut args: List[Int] = []
    let mut i = from
    while i < to {
        let part = sublist_get(parts, i)
        if interp_part_is_literal(part) {
            raw = raw.concat(node_str_val(part))
            fmt = fmt.concat(x_pct_escape(node_str_val(part)))
        } else {
            let inner = x_raw_inner(part)
            if inner < 0 { return -1 }
            let hole = x_interp_hole(inner)
            if hole.spec == "" { return -1 }
            fmt = fmt.concat(hole.spec)
            args.push(hole.arg)
        }
        i = i + 1
    }
    if args.len() == 0 { return ir_const(TYPE_STR, node, text.c_spelling, c_string_literal(raw)) }
    let mut call_args = [ir_const(TYPE_STR, node, text.c_spelling, c_string_literal(fmt))]
    let mut j = 0
    while j < args.len() {
        call_args.push(args.get(j).unwrap())
        j = j + 1
    }
    ir_call_runtime(TYPE_STR, node, text.c_spelling, c_runtime_helper("str_format"), text.slot_form, call_args)
}

// A Raw[T] has no C layout, so only the call written in the literal can fold: its argument
// is the value. A Raw held in a binding reaches here as a name, which this stage cannot read.
fn x_raw_inner(part: Int) -> Int ! Diag.Report {
    let args = if nk_of(node_kind(part)) == NodeKind.Call { node_args(part) } else { -1 }
    if args >= 0 && sublist_length(args) == 1 { return sublist_get(args, 0) }
    diag_ice_at("RawBindingNotFolded", CODEGEN_STAGE_NOT_BUILT,
        "a Raw value held in a binding has no C layout, so this stage cannot fold it into a template", part,
        "write Raw(value) inside the literal itself")
    -1
}

// The runtime carries four value tags. A narrower integer widens to Int, which holds every
// value it can take; any other kind has no tag, so it stops here rather than read garbage.
fn x_template_value(part: Int) -> TemplateValue ! Diag.Report {
    let tid = tid_of_node(part)
    if tid < 0 { return TemplateValue {} }
    let k = x_kind(tid)
    let op = x_template_push_op(k)
    if op == "" {
        diag_ice_at("TemplateHoleKindNotBuilt", CODEGEN_STAGE_NOT_BUILT,
            "a {tk_name(k)} hole has no template value tag", part,
            "a template carries Int, the narrower integers, Float, Bool and Str values")
        return TemplateValue {}
    }
    let value = lower_expr(part)
    if value < 0 { return TemplateValue {} }
    if k == TyKind.Int || k == TyKind.Float || k == TyKind.Bool || k == TyKind.Str {
        return TemplateValue { op: op, arg: value }
    }
    let word = x_local(TYPE_INT, part)
    if x_stopped(word) { return TemplateValue {} }
    TemplateValue { op: op, arg: ir_cast(TYPE_INT, part, word.c_spelling, value) }
}

fn x_template_push_op(k: TyKind) -> Str {
    match k {
        TyKind.Int => "template_push_int"
        TyKind.I8 => "template_push_int"
        TyKind.I16 => "template_push_int"
        TyKind.I32 => "template_push_int"
        TyKind.U8 => "template_push_int"
        TyKind.U16 => "template_push_int"
        TyKind.U32 => "template_push_int"
        TyKind.Float => "template_push_float"
        TyKind.Bool => "template_push_bool"
        TyKind.Str => "template_push_str"
        _ => ""
    }
}

// Lowers one hole to the conversion the format string needs and the argument that feeds
// it. An empty spec means the hole has already reported an ICE.
fn x_interp_hole(part: Int) -> InterpHole ! Diag.Report {
    let tid = tid_of_node(part)
    if tid < 0 { return InterpHole {} }
    if x_kind(tid) == TyKind.Never { return x_never_hole(part) }
    let value = lower_expr(part)
    if value < 0 { return InterpHole {} }
    x_render_value(part, tid, value)
}

// A Never hole is the thing that diverges, so it is lowered once for its effect and the
// marker after it tells C that control stops there. The format call that follows is dead
// but must still compile, so it reads a fresh Int-word zero rather than the hoisted value.
fn x_never_hole(part: Int) -> InterpHole ! Diag.Report {
    let value = lower_expr(part)
    if value < 0 { return InterpHole {} }
    if x_has_effect(value) { x_hoist(ir_expr_stmt(part, value)) }
    x_hoist(ir_unreachable(part))
    let word = x_local(TYPE_INT, part)
    if x_stopped(word) { return InterpHole {} }
    let zero = ir_const(TYPE_INT, part, word.c_spelling, "0")
    InterpHole { spec: format_spec_of(TYPE_INT), arg: ir_cast(TYPE_INT, part, word.c_spelling, zero) }
}

// The one way a value of a printable type becomes a conversion and its argument. A hole
// and a tuple element both come here, so the two cannot show one type two ways.
fn x_render_value(node: Int, tid: Int, value: Int) -> InterpHole ! Diag.Report {
    let spec = format_spec_of(tid)
    if spec == "" { return x_unprintable_hole(node, tid, value) }
    let arg = x_text_arg(node, tid, value)
    if arg < 0 { return InterpHole {} }
    InterpHole { spec: spec, arg: arg }
}

fn x_text_arg(node: Int, tid: Int, value: Int) -> Int ! Diag.Report {
    let k = x_kind(tid)
    if k == TyKind.Bool { return x_bool_text(node, value) }
    if k == TyKind.Char { return x_char_text(node, value) }
    x_promote_for_varargs(node, tid, value)
}

// A value no printf conversion prints. Only a struct or an enum declares a type that can
// carry `impl Display`, so only those two call that impl. Typecheck also shows a tuple, and
// it shows one from its elements.
//
// Each answers a string, so the formatter takes the conversion a string takes. Layout
// answers what that is, because this file spells no conversion of its own.
fn x_unprintable_hole(node: Int, tid: Int, value: Int) -> InterpHole ! Diag.Report {
    let k = x_kind(tid)
    if k == TyKind.Tuple { return x_tuple_text(node, tid, value) }
    if k != TyKind.Struct && k != TyKind.Enum {
        diag_ice_at("StructuralHoleNotRendered", CODEGEN_STAGE_NOT_BUILT,
            "a {tk_name(k)} value has no rendering this stage builds", node,
            "a struct or an enum shows through its Display impl and a tuple through its elements; typecheck must reject any other type")
        return InterpHole {}
    }
    let shown = lower_display_of_value(node, tid, value)
    if shown < 0 { return InterpHole {} }
    InterpHole { spec: format_spec_of(TYPE_STR), arg: shown }
}

// A tuple shows its elements between parentheses, joined by a comma, all through one format
// call. Every element is a read of the tuple and the expression that made it may have an
// effect, so the value is bound once and each element reads the binding.
fn x_tuple_text(node: Int, tid: Int, value: Int) -> InterpHole ! Diag.Report {
    let text = x_local(TYPE_STR, node)
    if x_stopped(text) { return InterpHole {} }
    let whole = x_local(tid, node)
    if x_stopped(whole) { return InterpHole {} }
    let name = c_mint_local("x")
    x_hoist(ir_let(tid, node, whole.c_spelling, name, whole.slot_form, value))
    let n = tc_tid_child_count(tc_resolve(tid))
    let mut fmt = "("
    let mut args: List[Int] = []
    let mut i = 0
    while i < n {
        let mem = x_member(tid, Slot.Elem(i), node)
        if x_stopped(mem) { return InterpHole {} }
        let target = ir_var_ref(tid, node, whole.c_spelling, name, whole.slot_form)
        let elem_tid = child_tid(tid, Slot.Elem(i))
        let elem = x_tuple_element(node, elem_tid,
            ir_field_get(elem_tid, node, mem.c_spelling, c_tuple_member(i), mem.slot_form, target))
        if elem.spec == "" { return InterpHole {} }
        if i > 0 { fmt = fmt.concat(", ") }
        fmt = fmt.concat(elem.spec)
        args.push(elem.arg)
        i = i + 1
    }
    fmt = fmt.concat(")")
    let mut call_args = [ir_const(TYPE_STR, node, text.c_spelling, c_string_literal(fmt))]
    for a in args { call_args.push(a) }
    let shown = ir_call_runtime(TYPE_STR, node, text.c_spelling, c_runtime_helper("str_format"), text.slot_form, call_args)
    InterpHole { spec: format_spec_of(TYPE_STR), arg: shown }
}

// An element shows as a hole of its own type does, so a Str element is not quoted. The
// spec has not settled that form, and this is the one function a change to it touches.
fn x_tuple_element(node: Int, tid: Int, value: Int) -> InterpHole ! Diag.Report {
    x_render_value(node, tid, value)
}

// C promotes a narrow integer across `...`, and the cast must name the promoted width or
// the formatter reads the wrong number of bytes.
fn x_promote_for_varargs(part: Int, tid: Int, value: Int) -> Int ! Diag.Report {
    let promoted = varargs_spelling(tid)
    if promoted == "" { return value }
    ir_cast(tid, part, promoted, value)
}

fn x_char_text(node: Int, value: Int) -> Int ! Diag.Report {
    let rec = x_local(TYPE_STR, node)
    if x_stopped(rec) { return -1 }
    ir_call_runtime(TYPE_STR, node, rec.c_spelling, c_runtime_helper("char_to_str"), rec.slot_form, [value])
}

// C has no conditional IR node and the runtime has no bool-to-text helper, so a Bool value
// becomes a Str temp an `if` fills. The two words are the Display of a Bool, not C text.
fn x_bool_text(node: Int, cond: Int) -> Int ! Diag.Report {
    let rec = x_local(TYPE_STR, node)
    if x_stopped(rec) { return -1 }
    let name = c_mint_local("x")
    let no = ir_const(TYPE_STR, node, rec.c_spelling, c_string_literal(bool_false))
    x_hoist(ir_let(TYPE_STR, node, rec.c_spelling, name, rec.slot_form, no))
    let target = ir_var_ref(TYPE_STR, node, rec.c_spelling, name, rec.slot_form)
    let yes = ir_const(TYPE_STR, node, rec.c_spelling, c_string_literal(bool_true))
    x_hoist(ir_if(node, cond, ir_block(node, [ir_assign(node, target, yes)]), -1))
    ir_var_ref(TYPE_STR, node, rec.c_spelling, name, rec.slot_form)
}

fn x_all_literal(parts: Int) -> Bool {
    if parts < 0 { return true }
    let mut i = 0
    while i < sublist_length(parts) {
        if !interp_part_is_literal(sublist_get(parts, i)) { return false }
        i = i + 1
    }
    true
}

fn x_joined(parts: Int) -> Str {
    if parts < 0 { return "" }
    let mut sb = StringBuilder.new()
    let mut i = 0
    while i < sublist_length(parts) {
        sb.write(node_str_val(sublist_get(parts, i)))
        i = i + 1
    }
    sb.to_str()
}

// A per cent sign in literal text is data, so the formatter must be told not to read it
// as the start of a conversion.
fn x_pct_escape(s: Str) -> Str {
    let mut sb = StringBuilder.new()
    let mut i = 0
    while i < s.len() {
        if s.byte_at(i) == 37 { sb.write("%") }
        sb.write(s.substring(i, 1))
        i = i + 1
    }
    sb.to_str()
}

