// cg_stmt.bl: statements, control flow and function bodies, lowered to IR.
//
// Every statement becomes one IR node. A value the statement needs is asked of the
// expression stage; a C spelling is asked of layout_of; a C symbol is asked of cname.
// This module holds no C text of its own beyond union member names and the two carrier
// tag numbers, which are facts about the carrier struct rather than type spellings.
//
// Nothing here falls back. A node with no recorded type, a declined layout or a shape
// with no lowering is a recorded ICE and a poisoned node, never a guessed answer. The
// driver must read diag_ice_count before it prints a unit this module built.

import ast.{NodeKind, nk_of, node_kind_name}
import parser.{
    node_args, node_arms, node_body, node_col, node_condition, node_elements, node_else_body,
    node_end, node_fields, node_for_binder, node_guard, node_handlers, node_inclusive,
    node_index, node_int_val, node_is_mut, node_iterable, node_kind, node_left, node_line, node_name,
    node_obj, node_op, node_params, node_pattern, node_right, node_scrutinee, node_start,
    node_stmts, node_str_val, node_target, node_then_body, node_type_name, node_type_ann,
    node_value, sublist_get, sublist_length, interp_part_is_literal,
    get_annotation, get_str_named_arg, node_value_child_ids, node_type_params,
}
import typecheck.{
    TyKind, TYPE_BOOL, TYPE_CHAR, TYPE_FLOAT, TYPE_INT, TYPE_STR, TYPE_VOID,
    tc_alias_to_original, tc_enum_has_payload, tc_enum_variant_slots, tc_evar_field_slots,
    tc_evar_name, tc_evfield_name, tc_evfield_tid, tc_global_decl_node, tc_let_binder_is_discard,
    tc_lookup_node_tid, tc_sfield_name, tc_sfield_tid, tc_struct_field_slots, tc_tid_decl_node,
    tc_tid_kind, tk_name, make_list_type,
    tc_alias_decl_of_ann, tc_ensures_preds_of, tc_is_old_snapshot, tc_requires_preds_of,
}
import layout.{
    Position, Slot, SlotForm, LayoutRecord, async_scope_handles_spelling, bind_binder_cell,
    bind_binder_mut, binder_is_celled,
    binder_scope_pop, binder_scope_push, carrier_member_layout, child_tid,
    ensure_typedef_for, field_layout_of,
    layout_of, pointer_spelling, tid_holds_tag_member, tid_of_binder,
    tid_of_node, varargs_spelling,
}
import cname.{
    c_assert_fail_eq_name, c_assert_fail_intro_name, c_assert_fail_name,
    c_debug_assert_fail_name, c_decl_for_tid, c_enum_payload_member, c_field_name,
    c_global_name, c_local_name, c_mint_local, c_ensures_result_name, c_old_snapshot_name, c_tuple_member, c_variant_discriminant, c_runtime_helper,
    c_string_literal,
}
