    AssertKind, ForInIteration, ForInStrategy, cc_assert_family_kind, cc_display_or_placeholder,
    cc_is_ptr_write_stmt, cc_is_skip_call, cc_lower_ptr_write_stmt, cg_call_element_from_runtime,
    cg_call_channel_take, cg_call_cursor_walk, for_in_iteration_of,
}
import unparse.{unparse_expr}
import cg_promote.{
    cg_promote_arena_enter, cg_promote_arena_exit, cg_promote_body_enter, cg_promote_body_exit,
    cg_promote_innermost_ctx, cg_promote_needs_walk, cg_promote_on_exit, cg_promote_trace_begin,
    cg_promote_trace_end, cg_promote_value,
}

// A carrier holds its discriminant in `tag`, its Option payload in `value` and its
// Result arms in `ok` and `err`. These are member names in a struct layout.bl emits,
// not type spellings, so they are spelled here rather than asked of a name producer.
let STMT_CARRIER_VALUE = "value"
let CARRIER_OK = "ok"
let CARRIER_ERR = "err"

// Option is none-first and Result is ok-first. Both orders are fixed by the runtime
// header, which builds carriers of its own with the same numbers.
let TAG_NONE = 0
let TAG_SOME = 1
let TAG_OK = 0
let TAG_ERR = 1

// The prelude carrier variants. A pattern names a variant as a string, so the carrier
// arms are recognised by name; which carrier is in play comes from the scrutinee's tid,
// never from the name.
let VARIANT_SOME = "Some"
let VARIANT_NONE = "None"
let VARIANT_OK = "Ok"
let VARIANT_ERR = "Err"

// A tagged enum keeps its payloads in one union field; a variant's own arm carries the
// variant's name. Member names in a struct layout.bl emits, not type spellings.

// The `with` item that asks for a fresh allocation arena rather than a resource.
let ARENA_ITEM = "arena"

// What a block does with the value its last expression produces.
let TAIL_DISCARD = 0
let TAIL_RETURN = 1
let TAIL_ASSIGN = 2

let mut scope_stack: List[Int] = []

// Whether a `debug_assert` lowers to a check or to nothing. Set once from CgConfig for a
// whole build, so a reset between probes leaves it as the caller set it, the same way a
// build never changes this flag between the functions it lowers.
let mut cs_debug_mode: Bool = false

pub fn cg_stmt_set_debug_mode(on: Bool) {
    cs_debug_mode = on
}

// The name of the function whose body is lowering, for `debug_assert`'s failure message.
// Saved and restored around a function's own body, so a nested closure body cannot leak
// its name into the function around it.
let mut cs_current_fn_name: Str = ""

// What every value exit of the function being lowered checks: the @ensures predicates of a
// runtime-fallback contract, and the alias declarations whose @where the returned value must
// meet. Saved and restored around a function's own body, the same as its name.
let mut cs_exit_ensures: List[Int] = []
let mut cs_exit_where: List[Int] = []

pub fn cg_stmt_reset() {
    scope_stack = []
    mv_work = []
    mv_in_target = false
    cs_current_fn_name = ""
    cs_exit_ensures = []
    cs_exit_where = []
}

// ── Types, spellings and names ────────────────────────────────────────────

// The type of a node under the instance being lowered. layout holds which instance that
// is, so this module carries no walk state of its own and cannot disagree with cg_expr.
fn stmt_tid(node: Int) -> Int ! Diag.Report {
    tid_of_node(node)
}

// layout_of in a position, with the decline contract honoured on the spot: a declined
// record is an internal error here, never a spelling this module invents instead.
fn layout_at(tid: Int, position: Position, node: Int) -> LayoutRecord ! Diag.Report {
    let rec = x_layout_checked(layout_of(tid, position), node, "LayoutDeclined",
        "layout declined type {tid}", "layout answers every type codegen reads; this is a compiler bug")
    if !x_stopped(rec) { return rec }
    // A declined record carries no spelling, and a node without one fails the verifier
    // before the reported error can be read. The integer record stands in.
    x_layout_checked(layout_of(TYPE_INT, position), node, "LayoutDeclined",
        "layout declined the integer type", "every position spells an integer; this is a compiler bug")
}

fn int_form(span: Int) -> SlotForm ! Diag.Report {
    layout_at(TYPE_INT, Position.Local, span).slot_form
}

// The C identifier of a local, parameter or pattern binder. Shared with the expression
// stage so a binder and every read of it spell the same identifier.
pub fn cg_local_c_name(name: Str) -> Str {
    c_local_name(name)
}

fn open_scope() -> Int {
    let id = binder_scope_push()
    scope_stack.push(id)
    id
}

fn close_scope() {
    if scope_stack.len() == 0 { return }
    scope_stack.pop()
    binder_scope_pop()
}

fn cur_scope() -> Int {
    if scope_stack.len() == 0 { return -1 }
    scope_stack.get(scope_stack.len() - 1).unwrap()
}

// ── The expression seam ───────────────────────────────────────────────────

// Every value this module needs comes through here, so switching to the expression
// stage's lowerer is one line and a build without that stage fails loudly at each value
// rather than emitting a statement with a hole in it.
fn lower_value(node: Int) -> Int ! Diag.Report {
    let value = lower_expr(node)
    if value >= 0 { return value }
    poison_value(node)
}

// A module-scope global's initializer. It shares the same seam as any other value; the
// scope it opens and closes is never bound into, because a global reads no local binder,
// but every other entry point pushes and pops one and this keeps the stack symmetric with
// them.
pub fn lower_global_init(g: Int) -> Int ! Diag.Report {
    let _ = open_scope()
    let saved_fn_name = cs_current_fn_name
    cs_current_fn_name = "<module init>"
    let mark = cg_expr_pending_count()
    let value = lower_value(node_value(g))
    let hoisted = cg_expr_take_pending(mark)
    cs_current_fn_name = saved_fn_name
    close_scope()
    if hoisted.len() == 0 { return value }
    lower_global_assign(g, hoisted, value)
}

// A checked initializer needs statements ahead of its value, and a C global's own
// definition line has no room for them. They run in the init function instead, with the
// assignment they feed, so the global is set in declaration order like any other.
fn lower_global_assign(g: Int, hoisted: List[Int], value: Int) -> Int ! Diag.Report {
    let tid = stmt_tid(g)
    if tid < 0 { return -1 }
    let rec = layout_at(tid, Position.Local, g)
    let target = ir_global_ref(tid, g, rec.c_spelling, c_global_name(g), rec.slot_form)
    let mut stmts = hoisted
    stmts.push(ir_assign(g, target, value))
    ir_block(g, stmts)
}

// ── The stop ──────────────────────────────────────────────────────────────

// A statement lowering answers -1 when the statement cannot be lowered: its type was
// never recorded, and the ICE naming that is already on the report. Every reader of a
// lowered statement passes the -1 on rather than building around it, so the operator
// meets the one honest error instead of a second one invented from a missing type. A
// binder is the reason this matters: a name declared by a statement that stopped must
// not bind, and the lowering after it must not run, because a read of that name would
// otherwise walk out to an outer declaration of the same name and answer its type.
//
// lower_fn turns a stopped body into an empty block, so the driver seam always answers
// a node. The driver reads diag_ice_count, never this number.

// A value node that stands in for one an ICE has already reported. It is well formed so
// the verifier and the dump still work on the surrounding tree; it is never a spelling
// this module chose for a real value, because a unit whose ICE count is non-zero must
// never reach the printer.
fn poison_value(node: Int) -> Int ! Diag.Report {
    int_const(node, "0")
}

// ── Entry points ──────────────────────────────────────────────────────────

// A function body. Parameters bind in the body's scope so a read of one resolves to its
// declared type, and the body's tail value becomes the function's return.
pub fn lower_fn(fn_node: Int) -> Int ! Diag.Report {
    let scope = open_scope()
    // A binding a closure of this body shares is stored in one heap cell, and the cell is
    // allocated where the binding is declared. So which names are shared has to be settled
    // before the first statement lowers: a declaration cannot ask a closure below it.
    cg_eff_scan_shared_binders(fn_node)
    let bound = bind_params(fn_node, scope)
    let tail = if fn_returns_value(fn_node) { TAIL_RETURN } else { TAIL_DISCARD }
    let body = node_body(fn_node)
    // `?` in the body returns the enclosing function's carrier on the failure arm, and `?`
    // lowers in the expression stage, which reads no function of its own. The annotation is
    // the only place the carrier is named, so the type goes across before the body lowers
    // and comes back off after, leaving nothing for the next function to read.
    let ann = node_type_ann(fn_node)
    cg_expr_set_return_type(if ann < 0 { -1 } else { stmt_tid(ann) })
    let saved_fn_name = cs_current_fn_name
    cs_current_fn_name = node_name(fn_node)
    let saved_ensures = cs_exit_ensures
    let saved_where = cs_exit_where
    cg_promote_body_enter()
    let mut stmts = if bound && body >= 0 { contract_entry(fn_node, tail == TAIL_RETURN) } else { [] }
    let block = if bound && body >= 0 { lower_body_block(body, tail, "", -1) } else { -1 }
    // A function with no result falls off the end of its body, which is an exit too.
    let falls_off = if block >= 0 && tail != TAIL_RETURN { contract_void_exit() } else { [] }
    cg_promote_body_exit()
    cs_exit_ensures = saved_ensures
    cs_exit_where = saved_where
    cg_expr_clear_old_snapshots()
    cs_current_fn_name = saved_fn_name
    cg_expr_set_return_type(-1)
    close_scope()
    // A stopped body, a parameter with no type and a declaration with no body all leave
    // nothing worth printing, and the seam still answers a node.
    if block < 0 { return ir_block(fn_node, []) }
    if stmts.len() == 0 && falls_off.len() == 0 { return block }
    stmts.push(block)
    for check in falls_off { stmts.push(check) }
    ir_block(fn_node, stmts)
}

// ── Contracts ─────────────────────────────────────────────────────────────
//
// Spec 3b.4: with no solver every contract is Unknown, and `@verify(fallback: "runtime")`
// turns it into a check that panics when it fails. 3b.1: a @where is checked at every
// boundary the solver cannot prove, which today is every parameter and every return.

// The checks a function runs on entry, before its body: @where on each parameter, then the
// @requires, then the `old(e)` snapshots its @ensures reads. Also arms the exit checks.
fn contract_entry(fn_node: Int, returns_value: Bool) -> List[Int] ! Diag.Report {
    let mut stmts: List[Int] = []
    let params = node_params(fn_node)
    let mut i = 0
    while params != -1 && i < sublist_length(params) {
        let p = sublist_get(params, i)
        let source = c_local_name(node_name(p))
        for td in where_decls_of(node_type_ann(p)) {
            stmts.push(contract_check(node_condition(td), where_failure(td), "self", stmt_tid(p), source))
        }
        i = i + 1
    }
    cs_exit_ensures = []
    cs_exit_where = if returns_value { where_decls_of(node_type_ann(fn_node)) } else { [] }
    if !contract_runtime(fn_node) { return stmts }
    for pred in tc_requires_preds_of(fn_node) {
        stmts.push(contract_check(pred, "precondition failed: @requires in {node_name(fn_node)}", "", -1, ""))
    }
    let ensures = tc_ensures_preds_of(fn_node)
    for pred in ensures { snapshot_olds(pred, stmts) }
    cs_exit_ensures = ensures
    stmts
}

// Whether the contract lowers to checks. A fallback of trust checks nothing, and a bad
// fallback is already an error.
fn contract_runtime(fn_node: Int) -> Bool ! Diag.Report {
    let verify = get_annotation(fn_node, "verify")
    // Typecheck refuses a contract with no @verify (V0003), so here there is no contract.
    if verify < 0 { return false }
    get_str_named_arg(verify, "fallback") == "runtime"
}

// The alias declarations with a @where that a value written as `ann` must meet, innermost
// first. An alias of an alias meets both.
fn where_decls_of(ann: Int) -> List[Int] ! Diag.Report {
    let mut chain: List[Int] = []
    if ann < 0 { return chain }
    let mut td = tc_alias_decl_of_ann(ann)
    while td >= 0 && !chain.contains(td) {
        chain.push(td)
        td = tc_alias_decl_of_ann(node_value(td))
    }
    let mut out: List[Int] = []
    let mut k = chain.len()
    while k > 0 {
        k = k - 1
        let decl = chain.get(k).unwrap()
        if node_condition(decl) != -1 {
            // A generic alias binds its type parameters per use, and the predicate would
            // lower under the function's instance instead of the alias's.
            if node_type_params(decl) != -1 {
                diag_ice_stage_not_built("a @where on a generic type alias", decl)
            } else {
                out.push(decl)
            }
        }
    }
    out
}

fn where_failure(td: Int) -> Str {
    "refinement violated: @where on {node_name(td)}"
}

// `old(e)` is e's value on entry. Each one is copied into its own local before the body
// runs, and the @ensures check reads that local in its place.
fn snapshot_olds(node: Int, out: List[Int]) ! Diag.Report {
    if tc_is_old_snapshot(node) {
        let tid = stmt_tid(node)
        if tid < 0 { return }
        let mark = cg_expr_pending_count()
        let value = lower_value(sublist_get(node_args(node), 0))
        cg_expr_drain_pending(mark, out)
        let rec = layout_at(tid, Position.Local, node)
        let name = c_old_snapshot_name()
        out.push(ir_let(tid, node, rec.c_spelling, name, rec.slot_form, value))
        cg_expr_set_old_snapshot(node, name)
        return
    }
    for kid in node_value_child_ids(node) { snapshot_olds(kid, out) }
}

// `if (!pred) panic`, with `binder` bound to the C local `source` of type `tid` while the
// predicate lowers. A tid below zero binds nothing. The predicate is one AST lowered at
// every exit, so the temps it names are forgotten once its check is built.
fn contract_check(pred: Int, what: Str, binder: Str, tid: Int, source: Str) -> Int ! Diag.Report {
    let scope = open_scope()
    let mut stmts: List[Int] = []
    if tid >= 0 {
        bind_binder_mut(scope, binder, tid, false)
        // `T self = self;` would read the new declarator, not the parameter: C puts a
        // name in scope before its own initializer. A parameter already spelled like the
        // binder is read as it stands.
        if source != c_local_name(binder) {
            let rec = layout_at(tid, Position.Local, pred)
            let read = ir_var_ref(tid, pred, rec.c_spelling, source, rec.slot_form)
            stmts.push(ir_let(tid, pred, rec.c_spelling, c_local_name(binder), rec.slot_form, read))
        }
    }
    let values = cg_expr_value_count()
    let mark = cg_expr_pending_count()
    let cond = lower_value(pred)
    cg_expr_drain_pending(mark, stmts)
    cg_expr_drop_values(values)
    close_scope()
    let said = x_panic_message(pred, pct_escape(what), [])
    // The layout stop is already reported, and an empty block keeps the tree well formed.
    if said < 0 { return ir_block(pred, []) }
    let bool_rec = layout_at(TYPE_BOOL, Position.Local, pred)
    let failed = ir_unary(TYPE_BOOL, pred, bool_rec.c_spelling, "!", cond)
    stmts.push(ir_if(pred, failed, ir_block(pred, [ir_panic(pred, said)]), -1))
    ir_block(pred, stmts)
}

// The @ensures checks at an exit with no value. `result` is not bound: there is none.
fn contract_void_exit() -> List[Int] ! Diag.Report {
    let mut out: List[Int] = []
    for pred in cs_exit_ensures {
        out.push(contract_check(pred, ensures_failure(), "", -1, ""))
    }
    out
}

fn ensures_failure() -> Str {
    "postcondition failed: @ensures in {cs_current_fn_name}"
}

// A value leaving the function: every return, tail and `?` failure arm comes through here,
// so an exit cannot skip the checks. The value is bound once, checked as `result` by each
// @ensures and as `self` by each @where on the return type, then returned.
pub fn cg_stmt_return_value(node: Int, value: Int) -> Int ! Diag.Report {
    let rt = cg_expr_return_type()
    if cs_exit_ensures.len() == 0 && cs_exit_where.len() == 0 {
        let out = cg_promote_on_exit(rt, value, node)
        if out < 0 { return -1 }
        return ir_return(node, out)
    }
    let rec = layout_at(rt, Position.Local, node)
    let rv = c_ensures_result_name()
    let mut stmts = [ir_let(rt, node, rec.c_spelling, rv, rec.slot_form, value)]
    for pred in cs_exit_ensures {
        stmts.push(contract_check(pred, ensures_failure(), "result", rt, rv))
    }
    for td in cs_exit_where {
        stmts.push(contract_check(node_condition(td), where_failure(td), "self", rt, rv))
    }
    let out = cg_promote_on_exit(rt, ir_var_ref(rt, node, rec.c_spelling, rv, rec.slot_form), node)
    if out < 0 { return -1 }
    stmts.push(ir_return(node, out))
    ir_block(node, stmts)
}

// A return with no value.
fn return_void(node: Int) -> Int ! Diag.Report {
    let checks = contract_void_exit()
    if checks.len() == 0 { return ir_return(node, -1) }
    let mut stmts = checks
    stmts.push(ir_return(node, -1))
    ir_block(node, stmts)
}

// Whether the tail expression of the body is the function's result. A function that
// declares no return type, or declares one with no values, discards its tail instead:
// C rejects a value on a return out of a function that returns nothing.
fn fn_returns_value(fn_node: Int) -> Bool ! Diag.Report {
    let ann = node_type_ann(fn_node)
    if ann < 0 { return false }
    let tid = stmt_tid(ann)
    if tid < 0 {
        diag_ice_at("NoTypeForReturnAnnotation", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "the return annotation of this function has no recorded type", fn_node,
            "typecheck stamps every annotation codegen reads; this is a compiler bug")
        // Returning the value is the shape that keeps C's own return-type rule: a
        // function that declares a result must produce one.
        return true
    }
    tc_tid_kind(tid) != TyKind.Void
}

// Answers false when a parameter has no recorded type. The body reads its parameters, so
// one left unbound is a name the body resolves somewhere else instead.
fn bind_params(fn_node: Int, scope: Int) -> Bool ! Diag.Report {
    let params = node_params(fn_node)
    if params == -1 { return true }
    let mut i = 0
    while i < sublist_length(params) {
        let p = sublist_get(params, i)
        let tid = stmt_tid(p)
        if tid < 0 { return false }
        // Reads the parsed `mut` keyword, not a hardcoded false: name resolution does not
        // honor it yet, but codegen must not bake that gap in and silently copy a param
        // that becomes reassignable the day it does.
        bind_binder_mut(scope, node_name(p), tid, node_is_mut(p) == 1)
        i = i + 1
    }
    true
}

// A block in statement position: its own binder scope, and a tail value nobody reads.
// Answers -1 when a statement in it stopped; see The stop above.
pub fn lower_block(node: Int) -> Int ! Diag.Report {
    lower_body_block(node, TAIL_DISCARD, "", -1)
}

// A block whose tail value is the enclosing function's result. Answers -1 on a stop.
pub fn lower_block_returning(node: Int) -> Int ! Diag.Report {
    lower_body_block(node, TAIL_RETURN, "", -1)
}

// A block whose tail value is stored into an already declared local of type `dest_tid`.
// This is how a block-shaped expression (an `if`, a `match`, a `with`) hands its value
// back without the IR needing a value-carrying block node. Answers -1 on a stop.
pub fn lower_block_into(node: Int, dest_c_name: Str, dest_tid: Int) -> Int ! Diag.Report {
    lower_body_block(node, TAIL_ASSIGN, dest_c_name, dest_tid)
}

// One statement, with its value discarded. This is the seam the driver and the
// expression stage call for a statement they already know is not in tail position.
// Answers -1 on a stop.
pub fn lower_stmt(node: Int) -> Int ! Diag.Report {
    lower_stmt_tail(node, TAIL_DISCARD, "", -1)
}

// ── Statement dispatch ────────────────────────────────────────────────────

// One arm per statement shape. A shape with no arm reaches the value path, which asks
// the expression stage; a shape the expression stage does not know reports there.
fn lower_stmt_tail(node: Int, tail: Int, dest: Str, dest_tid: Int) -> Int ! Diag.Report {
    match nk_of(node_kind(node)) {
        NodeKind.LetBinding => lower_let(node)
        NodeKind.Assignment => lower_assign(node)
        NodeKind.CompoundAssign => lower_compound_assign(node)
        NodeKind.ExprStmt => lower_stmt_tail(node_value(node), tail, dest, dest_tid)
        NodeKind.Return => lower_return(node)
        NodeKind.Break => lower_jump(node, ir_break(node))
        NodeKind.Continue => lower_jump(node, ir_continue(node))
        NodeKind.Block => lower_tail_block_into(node, tail, dest, dest_tid)
        NodeKind.IfExpr => lower_if(node, tail, dest, dest_tid)
        NodeKind.MatchExpr => lower_match(node, tail, dest, dest_tid)
        NodeKind.WhileLoop => lower_while(node)
        NodeKind.LoopExpr => lower_loop(node)
        NodeKind.ForIn => lower_for_in(node)
        NodeKind.WithBlock => lower_with_block(node, tail, dest, dest_tid)
        NodeKind.AsyncScope => lower_async_scope(node, tail, dest, dest_tid)
        NodeKind.AssertPanics => lower_assert_panics(node)
        NodeKind.Call => lower_call_stmt(node, tail, dest, dest_tid)
        NodeKind.MethodCall => lower_method_call_stmt(node, tail, dest, dest_tid)
        _ => lower_value_stmt(node, tail, dest, dest_tid)
    }
}

// A pointer store (`p.write(v)` or `p.f.write(v)`) is the one method call this stage
// intercepts before it reaches the value path: cc_is_ptr_write_stmt decides by the
// receiver's own tid kind, never by a name, so a call this is not falls straight through to
// the same value lowering every other method call reached before this arm existed. `.write`
// answers Unit, so a store built here ignores tail/dest/dest_tid exactly as WhileLoop and
// the other bare-statement arms above do; a caller that names one in a value slot (`let x =
// p.write(v)`) never reaches this function at all, since typecheck's own tid marks the
// slot as one this stage still refuses.
fn lower_method_call_stmt(node: Int, tail: Int, dest: Str, dest_tid: Int) -> Int ! Diag.Report {
    if cc_is_ptr_write_stmt(node) { return cc_lower_ptr_write_stmt(node) }
    lower_value_stmt(node, tail, dest, dest_tid)
}

// The assert family is statement-shaped only: the parser fabricates a bare Call it never
// hands the expression stage a value for. Every other call is a value like any other, so
// only the assert family's own names are intercepted here; everything else falls through
// to the same value path a Call reached before this arm existed.
fn lower_call_stmt(node: Int, tail: Int, dest: Str, dest_tid: Int) -> Int ! Diag.Report {
    let callee = node_left(node)
    if callee < 0 || nk_of(node_kind(callee)) != NodeKind.Ident {
        return lower_value_stmt(node, tail, dest, dest_tid)
    }
    let written = node_name(callee)
    let name = tc_alias_to_original.get(written) ?? written
    if cc_is_skip_call(node) { return lower_skip_call(node) }
    // cc_assert_family_kind is cg_call's own answer for these four names, read here so
    // the spelling lives in one place rather than a second chain of name comparisons.
    match cc_assert_family_kind(name) {
        AssertKind.Assert => lower_assert_call(node)
        AssertKind.AssertEq => lower_assert_eq_call(node)
        AssertKind.AssertNe => lower_assert_ne_call(node)
        AssertKind.DebugAssert => lower_debug_assert_call(node)
        AssertKind.None => lower_value_stmt(node, tail, dest, dest_tid)
    }
}

fn lower_value_stmt(node: Int, tail: Int, dest: Str, dest_tid: Int) -> Int ! Diag.Report {
    tail_wrap(node, lower_value(node), tail, dest, dest_tid)
}

// skip(reason) records the reason then returns out of its enclosing function. A plain
// IrKind.Return already runs every enclosing WithScope's C cleanup attribute, so nothing
// else needs composing here.
fn lower_skip_call(node: Int) -> Int ! Diag.Report {
    let args = node_args(node)
    if !assert_args_ok(node, "skip", args, 1) { return -1 }
    let reason = lower_value(sublist_get(args, 0))
    if reason < 0 { return -1 }
    let set_skipped = call_runtime_void(node, "__blink_test_set_skipped", [reason])
    ir_block(node, [set_skipped, frame_exit_or(node, ir_return(node, -1))])
}

// Every way out of an assert_panics body but a panic is the failure that the body
// returned, and it must disarm the frame on the way out. `exit` is the jump the same
// statement takes outside every frame.
fn frame_exit_or(node: Int, exit: Int) -> Int {
    let frame = cg_expr_frame_current()
    if frame == "" { exit } else { ir_panic_catch_exit(node, frame) }
}

// A break or continue leaves the frame only when its loop is outside it.
fn lower_jump(node: Int, jump: Int) -> Int {
    let frame = cg_expr_frame_left_by_jump()
    if frame == "" { jump } else { ir_panic_catch_exit(node, frame) }
}

// How a produced value leaves the block that produced it.
fn tail_wrap(node: Int, value: Int, tail: Int, dest: Str, dest_tid: Int) -> Int ! Diag.Report {
    if tail == TAIL_RETURN { return cg_stmt_return_value(node, value) }
    if tail == TAIL_ASSIGN {
        // A genuinely Void-typed tail (a bare call whose C shape is `void`, most often a
        // diverging builtin like `env.exit`) has nothing to store into dest: dest_tid is
        // the match's own type, decided by a sibling arm, not this arm's -- checking it
        // would miss the arm that never reaches the assignment it appears to make. Same
        // two-signal guard lower_assign's Void arm uses: the call's side effect is kept,
        // the store is not.
        let own_tid = stmt_tid(node)
        if own_tid >= 0 && cs_is_void_like(own_tid) && !cg_expr_is_registered(node) {
            return ir_expr_stmt(node, value)
        }
        let rec = layout_at(dest_tid, Position.Local, node)
        let lvalue = ir_var_ref(dest_tid, node, rec.c_spelling, dest, rec.slot_form)
        return ir_assign(node, lvalue, value)
    }
    ir_expr_stmt(node, value)
}

// ── The assert family ─────────────────────────────────────────────────────
//
// Four builtin calls the parser hands here as a bare, statement-shaped Call: assert,
// assert_eq, assert_ne and debug_assert. None of them produce a value, so each lowers to
// an `if (!condition) { fail-call }`, composed from IrKind.If, IrKind.ExprStmt and
// IrKind.CallRuntime, the same three kinds x_test_propagate_arm composes a runtime call
// from. A stopped operand poisons the whole call, the same as any other statement; see
// The stop above.

// A value bound into a fresh local, and a read of that local. Every operand this section
// reads twice (once to compare, once to render) binds once so its side effects run once.
type Bound {
    stmt: Int
    ref: Int
}

fn bind_temp(stem: Str, tid: Int, span: Int, value: Int) -> Bound ! Diag.Report {
    let rec = layout_at(tid, Position.Local, span)
    let holder = c_mint_local(stem)
    let stmt = ir_let(tid, span, rec.c_spelling, holder, rec.slot_form, value)
    let ref = ir_var_ref(tid, span, rec.c_spelling, holder, rec.slot_form)
    // Every Bound is read more than once by design (see the comment above); mark it so
    // ir_verify accepts the reuse instead of reporting a value reached from two parents.
    ir_mark_materialize(ref)
    Bound { stmt: stmt, ref: ref }
}

fn str_const(span: Int, text: Str) -> Int ! Diag.Report {
    let rec = layout_at(TYPE_STR, Position.Local, span)
    ir_const(TYPE_STR, span, rec.c_spelling, c_string_literal(text))
}

// A void runtime call, in statement position. Position.Return is the shape a call with no
// value of its own takes, the same position x_test_propagate_arm's own runtime call uses.
fn call_runtime_void(span: Int, symbol: Str, args: List[Int]) -> Int ! Diag.Report {
    let rec = layout_of(TYPE_VOID, Position.Return)
    ir_expr_stmt(span, ir_call_runtime(TYPE_VOID, span, rec.c_spelling, symbol, rec.slot_form, args))
}

// blink_str_format is a value-returning Str build, not a buffer the caller must size: one
// call builds every message, expected-side and actual-side string this section needs.
fn call_str_format(span: Int, fmt: Str, args: List[Int]) -> Int ! Diag.Report {
    let rec = layout_at(TYPE_STR, Position.Local, span)
    let mut all_args = [str_const(span, fmt)]
    let mut i = 0
    while i < args.len() {
        all_args.push(args.get(i).unwrap())
        i = i + 1
    }
    ir_call_runtime(TYPE_STR, span, rec.c_spelling, c_runtime_helper("str_format"), rec.slot_form, all_args)
}

// `%` in a name or a literal spliced into a format string built for blink_str_format would
// read to printf as the start of a specifier. Doubling it here is not something gen0's own
// power-assert intro does, and gen0's intro can misrender when an operand's source holds
// one; this section always escapes it instead of reproducing that gap.
fn pct_escape(text: Str) -> Str {
    let mut sb = StringBuilder.new()
    let mut i = 0
    while i < text.len() {
        if text.byte_at(i) == 37 { sb.write("%") }
        sb.write(text.substring(i, 1))
        i = i + 1
    }
    sb.to_str()
}

fn assert_args_ok(node: Int, name: Str, args: Int, want: Int) -> Bool ! Diag.Report {
    if args >= 0 && sublist_length(args) >= want {
        return true
    }
    diag_ice_at("AssertArityWrong", CODEGEN_STAGE_NOT_BUILT,
        "{name} needs at least {want} argument(s)", node,
        "typecheck accepts a call's arity before codegen ever sees it; this is a compiler bug")
    false
}

// ── assert(cond, msg?): the power-assert decomposition ────────────────────

// What assert's decomposition answers: either the whole condition, unchanged, with no
// intro text, or a rebuilt Bool condition over two bound operands plus the intro line
// that names each side's source text and value.
type PaResult {
    ok: Bool
    cond: Int
    intro: Int
    pre: List[Int]
}

fn pa_not_decomposed() -> PaResult ! Diag.Report {
    PaResult { ok: false, cond: -1, intro: -1, pre: [] }
}

// && and || are not in this set: short-circuit is part of the language surface, and
// binding both operands to temporaries ahead of the operator (the way every other
// decomposed pair works) would evaluate the right operand even when the left one alone
// decides the result. An assert must not change what the program does, so a logical
// condition falls back to the whole-condition path below with no operand introspection,
// the same as any other non-decomposable shape.
fn pa_op_renderable(op: Str) -> Bool {
    op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">="
}

// The scalar set assert's intro knows how to render. Every comparison pa_op_renderable
// admits needs both sides in this set; && and || never reach here (see pa_op_renderable).
fn pa_kind_renderable(k: TyKind) -> Bool {
    k == TyKind.Int || k == TyKind.Bool || k == TyKind.Float || k == TyKind.Char ||
        k == TyKind.Str || k == TyKind.I8 || k == TyKind.I16 || k == TyKind.I32 ||
        k == TyKind.U8 || k == TyKind.U16 || k == TyKind.U32 || k == TyKind.U64
}

// One level deep: a top-level BinOp whose operator and operand kinds are decomposable.
// Everything else falls back to the whole condition, rendered with no intro.
fn pa_decompose(cond_node: Int) -> PaResult ! Diag.Report {
    if nk_of(node_kind(cond_node)) != NodeKind.BinOp { return pa_not_decomposed() }
    let op = node_op(cond_node)
    if !pa_op_renderable(op) { return pa_not_decomposed() }
    let lhs_node = node_left(cond_node)
    let rhs_node = node_right(cond_node)
    let lhs_tid = stmt_tid(lhs_node)
    let rhs_tid = stmt_tid(rhs_node)
    if lhs_tid < 0 || rhs_tid < 0 { return pa_not_decomposed() }
    if !(pa_kind_renderable(tc_tid_kind(lhs_tid)) && pa_kind_renderable(tc_tid_kind(rhs_tid))) {
        return pa_not_decomposed()
    }
    let lhs_value = lower_value(lhs_node)
    let rhs_value = lower_value(rhs_node)
    if lhs_value < 0 || rhs_value < 0 { return pa_not_decomposed() }
    let lhs_bound = bind_temp("pa_l", lhs_tid, lhs_node, lhs_value)
    let rhs_bound = bind_temp("pa_r", rhs_tid, rhs_node, rhs_value)
    let bool_rec = layout_at(TYPE_BOOL, Position.Local, cond_node)
    let cond = pa_cond_expr(cond_node, op, lhs_tid, rhs_tid, lhs_bound.ref, rhs_bound.ref, bool_rec)
    if cond < 0 { return pa_not_decomposed() }
    let mut pre: List[Int] = [lhs_bound.stmt, rhs_bound.stmt]
    let lhs_arg = pa_arg_for(lhs_node, lhs_tid, lhs_bound.ref, pre)
    let rhs_arg = pa_arg_for(rhs_node, rhs_tid, rhs_bound.ref, pre)
    if lhs_arg < 0 || rhs_arg < 0 { return pa_not_decomposed() }
    let lhs_src = pct_escape(unparse_expr(lhs_node))
    let rhs_src = pct_escape(unparse_expr(rhs_node))
    let fmt = "  {lhs_src} = {pa_spec_for_kind(tc_tid_kind(lhs_tid))}\n  {rhs_src} = {pa_spec_for_kind(tc_tid_kind(rhs_tid))}"
    let intro = call_str_format(cond_node, fmt, [lhs_arg, rhs_arg])
    PaResult { ok: true, cond: cond, intro: intro, pre: pre }
}

// The rebuilt Bool condition over two already-bound operands. Only a comparison operator
// reaches here (see pa_op_renderable). A Str or a Float comparison goes through the same
// runtime helpers lower_str_binop and lower_float_compare use; every other comparison is a
// plain C operator between the two temps.
fn pa_cond_expr(cond_node: Int, op: Str, lhs_tid: Int, rhs_tid: Int, lhs_ref: Int, rhs_ref: Int, bool_rec: LayoutRecord) -> Int ! Diag.Report {
    let both_str = tc_tid_kind(lhs_tid) == TyKind.Str && tc_tid_kind(rhs_tid) == TyKind.Str
    let both_float = tc_tid_kind(lhs_tid) == TyKind.Float && tc_tid_kind(rhs_tid) == TyKind.Float
    if !both_str && !both_float {
        return ir_binary(TYPE_BOOL, cond_node, bool_rec.c_spelling, op, lhs_ref, rhs_ref)
    }
    let eq_helper = if both_str { "str_eq" } else { "float_eq" }
    let cmp_helper = if both_str { "str_cmp" } else { "float_cmp" }
    if op == "==" || op == "!=" {
        let eq = ir_call_runtime(TYPE_BOOL, cond_node, bool_rec.c_spelling,
            c_runtime_helper(eq_helper), bool_rec.slot_form, [lhs_ref, rhs_ref])
        if op == "!=" { return ir_unary(TYPE_BOOL, cond_node, bool_rec.c_spelling, "!", eq) }
        return eq
    }
    let int_rec = layout_at(TYPE_INT, Position.Local, cond_node)
    let cmp = ir_call_runtime(TYPE_INT, cond_node, int_rec.c_spelling,
        c_runtime_helper(cmp_helper), int_rec.slot_form, [lhs_ref, rhs_ref])
    ir_binary(TYPE_BOOL, cond_node, bool_rec.c_spelling, op, cmp, int_const(cond_node, "0"))
}

// The printf spec assert's intro renders a kind with. Bool and Char each need their value
// turned into the spec's own shape first; see pa_arg_for.
fn pa_spec_for_kind(k: TyKind) -> Str {
    if k == TyKind.Bool { return "%s" }
    if k == TyKind.Float { return "%g" }
    if k == TyKind.Str { return "%s" }
    if k == TyKind.Char { return "%d" }
    "%lld"
}

// The argument pa_spec_for_kind's spec reads. Bool becomes its "true"/"false" spelling,
// hoisted ahead of the statement that reads it; Float and Str pass through as they are
// already spelled; Char passes through with no cast, since C's own vararg promotion
// widens an int32_t to int with no help; everything else is the assert family's one
// shared default bucket, cast the way lower_interp already casts a varargs integer hole.
fn pa_arg_for(node: Int, tid: Int, value_ref: Int, pre: List[Int]) -> Int ! Diag.Report {
    let k = tc_tid_kind(tid)
    if k == TyKind.Bool { return bool_to_str_ref(node, value_ref, pre) }
    if k == TyKind.Float { return value_ref }
    if k == TyKind.Str { return value_ref }
    if k == TyKind.Char { return value_ref }
    ir_cast(tid, node, varargs_spelling(TYPE_INT), value_ref)
}

// A Bool value turned into its "true"/"false" spelling: a Str temp initialised to "false",
// reassigned to "true" under a hoisted `if`, both pushed onto `pre` ahead of the statement
// that reads the temp.
fn bool_to_str_ref(node: Int, cond_ref: Int, pre: List[Int]) -> Int ! Diag.Report {
    let str_rec = layout_at(TYPE_STR, Position.Local, node)
    let holder = c_mint_local("pa_b")
    pre.push(ir_let(TYPE_STR, node, str_rec.c_spelling, holder, str_rec.slot_form, str_const(node, "false")))
    let target = ir_var_ref(TYPE_STR, node, str_rec.c_spelling, holder, str_rec.slot_form)
    let assign_true = ir_assign(node, target, str_const(node, "true"))
    pre.push(ir_if(node, cond_ref, ir_block(node, [assign_true]), -1))
    ir_var_ref(TYPE_STR, node, str_rec.c_spelling, holder, str_rec.slot_form)
}

fn lower_assert_call(node: Int) -> Int ! Diag.Report {
    let args = node_args(node)
    if !assert_args_ok(node, "assert", args, 1) { return -1 }
    let cond_node = sublist_get(args, 0)
    let decomposed = pa_decompose(cond_node)
    let cond_value = if decomposed.ok { decomposed.cond } else { lower_value(cond_node) }
    if cond_value < 0 { return -1 }
    let bool_rec = layout_at(TYPE_BOOL, Position.Local, node)
    let neg = ir_unary(TYPE_BOOL, node, bool_rec.c_spelling, "!", cond_value)
    let intro_arg = if decomposed.ok { decomposed.intro } else { str_const(node, "") }
    let mut user_msg = str_const(node, "")
    if sublist_length(args) >= 2 {
        user_msg = lower_value(sublist_get(args, 1))
        if user_msg < 0 { return -1 }
    }
    let assertion = "assert({unparse_expr(cond_node)})"
    let fail_stmt = call_runtime_void(node, c_assert_fail_intro_name(), [
        str_const(node, assertion),
        intro_arg,
        str_const(node, diag_file_for_node(node)),
        int_const(node, "{node_line(node)}"),
        int_const(node, "{node_col(node)}"),
        user_msg,
    ])
    let mut pre = decomposed.pre
    pre.push(ir_if(node, neg, ir_block(node, [fail_stmt]), -1))
    ir_block(node, pre)
}

// ── assert_eq / assert_ne: the per-type comparison buckets ─────────────────
//
// gen0 casts every scalar in this bucket to int64_t and renders it %lld, Bool and Char
// included, regardless of signedness; there is no separate unsigned bucket here. Str
// compares by blink_str_eq and renders %s; Float compares by != and renders %f, not the
// %g assert's own intro uses. A struct, an enum, a Result or an Option walks its fields
// or its tagged arm instead; see agg_cmp below.
// The cast this bucket renders is built once and read twice (once in the failure
// message, once as its own exp/act arg), so it must materialise the same as a Bound.
fn eq_default_arg(tid: Int, span: Int, value_ref: Int) -> Int ! Diag.Report {
    let cast = ir_cast(tid, span, varargs_spelling(TYPE_INT), value_ref)
    ir_mark_materialize(cast)
    cast
}

fn eq_is_str(tid: Int) -> Bool ! Diag.Report { tc_tid_kind(tid) == TyKind.Str }
fn eq_is_float(tid: Int) -> Bool ! Diag.Report { tc_tid_kind(tid) == TyKind.Float }
fn eq_is_aggregate(tid: Int) -> Bool ! Diag.Report {
    let k = tc_tid_kind(tid)
    k == TyKind.Struct || k == TyKind.Enum || k == TyKind.Result || k == TyKind.Option
}

// ── assert_eq / assert_ne over a struct, an enum, a Result or an Option ───
//
// No @derive(Eq) is asked for here: gen0's own assert_eq walked a struct's fields with
// no trait bound at all, and this keeps that. A struct compares field by field; an enum,
// a Result and an Option compare their tag first and only the active arm's fields after,
// the same order gen0 used for Result and Option and the order a payload read always
// needs, since reading a union member through the wrong tag is undefined. Every walk is
// keyed on TyKind and reads a field through child_tid or field_layout_of, never by name.
//
// A tag-guarded arm needs a runtime switch, which a single Bool expression cannot hold,
// so a walk answers in two parts: `pre`, the statements a switch needs hoisted ahead of
// the read, and `differs`, the Bool value those statements leave ready. A struct needs no
// switch, so its `pre` is empty and its `differs` is one OR-chain built straight from its
// fields.

type AggCmp {
    pre: List[Int]
    differs: Int
}

fn agg_bool_spelling(span: Int) -> Str ! Diag.Report {
    layout_at(TYPE_BOOL, Position.Local, span).c_spelling
}

// The kinds whose C inequality is the language's, the same set @derive(Eq) compares by
// !=. Float is absent: the language equates NaN with NaN and C's != does not.
fn agg_is_scalar_kind(k: TyKind) -> Bool {
    if k == TyKind.Int || k == TyKind.Bool || k == TyKind.Char { return true }
    if k == TyKind.I8 || k == TyKind.I16 || k == TyKind.I32 { return true }
    if k == TyKind.U8 || k == TyKind.U16 || k == TyKind.U32 || k == TyKind.U64 { return true }
    false
}

// Whether two values differ, when a runtime helper answers whether they are equal.
fn agg_helper_differs(helper: Str, lhs: Int, rhs: Int, bools: Str, span: Int) -> Int ! Diag.Report {
    ir_unary(TYPE_BOOL, span, bools, "!",
        ir_call_runtime(TYPE_BOOL, span, bools, c_runtime_helper(helper), SlotForm.InlineWord, [lhs, rhs]))
}

// One field or one tagged arm's comparison, dispatched on the value's own tid. `lhs` and
// `rhs` must already be safe to read more than once (bind_temp's own ref, or a field or
// payload read this walk has marked materialize itself), since a struct or an enum reads
// its operand once per field and a carrier reads its operand once for the tag and again
// for the active arm.
fn agg_cmp(tid: Int, lhs: Int, rhs: Int, span: Int) -> AggCmp ! Diag.Report {
    let bools = agg_bool_spelling(span)
    let k = tc_tid_kind(tid)
    if k == TyKind.Str {
        return AggCmp { pre: [], differs: agg_helper_differs("str_eq", lhs, rhs, bools, span) }
    }
    if k == TyKind.Float {
        return AggCmp { pre: [], differs: agg_helper_differs("float_eq", lhs, rhs, bools, span) }
    }
    if agg_is_scalar_kind(k) {
        return AggCmp { pre: [], differs: ir_binary(TYPE_BOOL, span, bools, "!=", lhs, rhs) }
    }
    if k == TyKind.Struct { return agg_struct_cmp(tid, lhs, rhs, span, bools) }
    if k == TyKind.Enum { return agg_enum_cmp(tid, lhs, rhs, span, bools) }
    if k == TyKind.Option { return agg_carrier_cmp(tid, lhs, rhs, span, bools, true) }
    if k == TyKind.Result { return agg_carrier_cmp(tid, lhs, rhs, span, bools, false) }
    diag_ice_stage_not_built("assert_eq/assert_ne over a {tk_name(k)} value", span)
    AggCmp { pre: [], differs: -1 }
}

// A field this walk cannot read is an internal error, never a skipped field: skipping one
// would answer two unequal values as equal, a wrong answer that compiles cleanly.
fn agg_field_refused(frec: LayoutRecord, path: Str, span: Int) -> Bool ! Diag.Report {
    let reason = frec.decline_reason
    if reason != "" {
        diag_ice_at("AssertCompareFieldNotBuildable", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "no C spelling for field `{path}`: {reason}", span,
            "every type that reaches code generation must be concrete and nameable; this is a compiler bug")
        return true
    }
    if frec.slot_form == SlotForm.PointerBoxed {
        diag_ice_stage_not_built("assert_eq/assert_ne over the boxed field `{path}`", span)
        return true
    }
    false
}

// A field's own `differs` bound to a fresh Bool local before it joins the OR-chain, so
// every operand that chain ever holds is a bare name. C's || skips whichever side answers
// first, and the verifier refuses a skippable side that still has a statement to run for
// it (see agg_field_refused's neighbor `ir_binds_statement`, ir.bl); a struct or an enum
// nested inside a field reads its own container more than once, which only a materialized
// read can do, and a materialized read is exactly the kind of statement a bare comparison
// never binds. Binding every leaf the same way, scalar or not, keeps one rule instead of
// two.
fn agg_bind_bool(pre: List[Int], sub: AggCmp, span: Int) -> Int ! Diag.Report {
    for s in sub.pre { pre.push(s) }
    let rec = layout_at(TYPE_BOOL, Position.Local, span)
    let holder = c_mint_local("agg_f")
    pre.push(ir_let(TYPE_BOOL, span, rec.c_spelling, holder, rec.slot_form, sub.differs))
    ir_var_ref(TYPE_BOOL, span, rec.c_spelling, holder, rec.slot_form)
}

// A struct's own fields disagree in field order; the first field this walk builds is the
// first one a reader would blame, the same order gen0's field-wise walk read them in. The
// struct's own value is read once per field, so it is materialized here the same way an
// enum or a carrier materializes its own value before agg_cmp ever reads a field of it.
fn agg_struct_cmp(tid: Int, lhs: Int, rhs: Int, span: Int, bools: Str) -> AggCmp ! Diag.Report {
    ir_mark_materialize(lhs)
    ir_mark_materialize(rhs)
    let mut pre: List[Int] = []
    let mut differs = ir_const(TYPE_BOOL, span, bools, "0")
    let mut first = true
    for slot in tc_struct_field_slots(tid) {
        let ftid = tc_sfield_tid(slot)
        let frec = field_layout_of(tid, ftid)
        let path = c_field_name(tc_sfield_name(slot))
        if agg_field_refused(frec, path, span) { return AggCmp { pre: [], differs: -1 } }
        let field_lhs = ir_field_get(ftid, span, frec.c_spelling, path, frec.slot_form, lhs)
        let field_rhs = ir_field_get(ftid, span, frec.c_spelling, path, frec.slot_form, rhs)
        let sub = agg_cmp(ftid, field_lhs, field_rhs, span)
        if sub.differs < 0 { return AggCmp { pre: [], differs: -1 } }
        let leaf = agg_bind_bool(pre, sub, span)
        differs = if first { leaf } else { ir_binary(TYPE_BOOL, span, bools, "||", differs, leaf) }
        first = false
    }
    AggCmp { pre: pre, differs: differs }
}

// The value that tells two values of this enum's variant apart, read the same way the
// match lowering's own `discriminant` reads it (tid_holds_tag_member below is that same
// function's own test): a tag member for an enum whose variants carry fields, and the
// value itself for a payload-less enum, which is already one bare word with no member
// beside it.
fn agg_enum_tag(tid: Int, base: Int, span: Int, ints: Str) -> Int ! Diag.Report {
    let tag = enum_tag_word(tid, base, span, ints)
    if tag >= 0 { return tag }
    diag_ice_stage_not_built("assert_eq/assert_ne over an enum holding no discriminant", span)
    -1
}

// The word an enum value keeps its tag in, or -1 for a one-variant newtype, which is its
// payload alone and keeps no tag at all. Each caller decides what that absence means,
// since the only variant such a value can hold is known without reading anything.
pub fn enum_tag_word(tid: Int, base: Int, span: Int, ints: Str) -> Int {
    if tid_holds_tag_member(tid) { return ir_carrier_tag(TYPE_INT, span, ints, base) }
    if !tc_enum_has_payload(tid) { return base }
    -1
}

// An enum agrees on its tag before it reads its payload: a mismatched tag already answers
// differs=true, and only a matching tag switches into the one variant it is safe to read.
fn agg_enum_cmp(tid: Int, lhs: Int, rhs: Int, span: Int, bools: Str) -> AggCmp ! Diag.Report {
    let slots = tc_enum_variant_slots(tid)
    if slots.len() == 0 {
        diag_ice_stage_not_built("assert_eq/assert_ne over an enum with no variants", span)
        return AggCmp { pre: [], differs: -1 }
    }
    ir_mark_materialize(lhs)
    ir_mark_materialize(rhs)
    let ints = int_spelling(span)
    let tag_lhs = agg_enum_tag(tid, lhs, span, ints)
    let tag_rhs = agg_enum_tag(tid, rhs, span, ints)
    let tag_differs = ir_binary(TYPE_BOOL, span, bools, "!=", tag_lhs, tag_rhs)
    let holder_rec = layout_at(TYPE_BOOL, Position.Local, span)
    let holder = c_mint_local("agg_d")
    let decl = ir_let(TYPE_BOOL, span, holder_rec.c_spelling, holder, holder_rec.slot_form, tag_differs)
    let decl_node = c_decl_for_tid(tid)
    let mut cases: List[Int] = []
    for slot in slots {
        let vname = tc_evar_name(slot)
        let vnode = find_variant(decl_node, vname)
        if vnode < 0 {
            diag_ice_at("AssertCompareVariantNotFound", CODEGEN_STAGE_NOT_BUILT,
                "variant `{vname}` of an enum compared by assert_eq/assert_ne has no declaration", span,
                "typecheck registers every variant of a type it accepts; this is a compiler bug")
            return AggCmp { pre: [], differs: -1 }
        }
        let body = agg_variant_case_body(tid, slot, vname, lhs, rhs, holder_rec, holder, span, bools)
        if body < 0 { return AggCmp { pre: [], differs: -1 } }
        cases.push(int_const(span, c_variant_discriminant(tid, vnode)))
        cases.push(body)
    }
    let tag_switch = agg_enum_tag(tid, lhs, span, ints)
    let target_read = ir_var_ref(TYPE_BOOL, span, holder_rec.c_spelling, holder, holder_rec.slot_form)
    let not_yet = ir_unary(TYPE_BOOL, span, bools, "!", target_read)
    let guard = ir_if(span, not_yet, ir_block(span, [ir_switch(span, tag_switch, cases, ir_block(span, []))]), -1)
    let final_read = ir_var_ref(TYPE_BOOL, span, holder_rec.c_spelling, holder, holder_rec.slot_form)
    AggCmp { pre: [decl, guard], differs: final_read }
}

// The block one variant's case runs once the tag has already matched: a unit variant has
// nothing left to disagree on, so its case is empty and `target` keeps the false the tag
// check already left it at; a variant with fields OR-chains them the same way a struct's
// fields are OR-chained, then assigns the answer into `target`.
fn agg_variant_case_body(tid: Int, slot: Int, vname: Str, lhs: Int, rhs: Int, holder_rec: LayoutRecord, holder: Str, span: Int, bools: Str) -> Int ! Diag.Report {
    let fields = tc_evar_field_slots(slot)
    if fields.len() == 0 { return ir_block(span, []) }
    let mut stmts: List[Int] = []
    let mut differs = ir_const(TYPE_BOOL, span, bools, "0")
    let mut first = true
    for f in fields {
        let ftid = tc_evfield_tid(f)
        let path = "{c_enum_payload_member()}.{vname}.{c_field_name(tc_evfield_name(f))}"
        let frec = field_layout_of(tid, ftid)
        if agg_field_refused(frec, path, span) { return -1 }
        let field_lhs = ir_field_get(ftid, span, frec.c_spelling, path, frec.slot_form, lhs)
        let field_rhs = ir_field_get(ftid, span, frec.c_spelling, path, frec.slot_form, rhs)
        let sub = agg_cmp(ftid, field_lhs, field_rhs, span)
        if sub.differs < 0 { return -1 }
        let leaf = agg_bind_bool(stmts, sub, span)
        differs = if first { leaf } else { ir_binary(TYPE_BOOL, span, bools, "||", differs, leaf) }
        first = false
    }
    let target = ir_var_ref(TYPE_BOOL, span, holder_rec.c_spelling, holder, holder_rec.slot_form)
    stmts.push(ir_assign(span, target, differs))
    ir_block(span, stmts)
}

// Option and Result share one shape: a tag, and one payload slot per arm. Option's one
// arm is Slot.Inner1 under the "value" member; Result's two arms split Slot.Inner1 ("ok")
// and Slot.Inner2 ("err"). is_option picks which pair of tags and which arm names apply;
// everything past that reads exactly like agg_enum_cmp's tag-then-payload guard.
fn agg_carrier_cmp(tid: Int, lhs: Int, rhs: Int, span: Int, bools: Str, is_option: Bool) -> AggCmp ! Diag.Report {
    ir_mark_materialize(lhs)
    ir_mark_materialize(rhs)
    let ints = int_spelling(span)
    let tag_lhs = ir_carrier_tag(TYPE_INT, span, ints, lhs)
    let tag_rhs = ir_carrier_tag(TYPE_INT, span, ints, rhs)
    let tag_differs = ir_binary(TYPE_BOOL, span, bools, "!=", tag_lhs, tag_rhs)
    let holder_rec = layout_at(TYPE_BOOL, Position.Local, span)
    let holder = c_mint_local("agg_d")
    let decl = ir_let(TYPE_BOOL, span, holder_rec.c_spelling, holder, holder_rec.slot_form, tag_differs)
    let mut cases: List[Int] = []
    if is_option {
        let some_body = agg_carrier_arm_body(tid, Slot.Inner1, STMT_CARRIER_VALUE, lhs, rhs, holder_rec, holder, span)
        if some_body < 0 { return AggCmp { pre: [], differs: -1 } }
        cases.push(int_const(span, "{TAG_SOME}"))
        cases.push(some_body)
        cases.push(int_const(span, "{TAG_NONE}"))
        cases.push(ir_block(span, []))
    } else {
        let ok_body = agg_carrier_arm_body(tid, Slot.Inner1, CARRIER_OK, lhs, rhs, holder_rec, holder, span)
        if ok_body < 0 { return AggCmp { pre: [], differs: -1 } }
        let err_body = agg_carrier_arm_body(tid, Slot.Inner2, CARRIER_ERR, lhs, rhs, holder_rec, holder, span)
        if err_body < 0 { return AggCmp { pre: [], differs: -1 } }
        cases.push(int_const(span, "{TAG_OK}"))
        cases.push(ok_body)
        cases.push(int_const(span, "{TAG_ERR}"))
        cases.push(err_body)
    }
    let tag_switch = ir_carrier_tag(TYPE_INT, span, ints, lhs)
    let target_read = ir_var_ref(TYPE_BOOL, span, holder_rec.c_spelling, holder, holder_rec.slot_form)
    let not_yet = ir_unary(TYPE_BOOL, span, bools, "!", target_read)
    let guard = ir_if(span, not_yet, ir_block(span, [ir_switch(span, tag_switch, cases, ir_block(span, []))]), -1)
    let final_read = ir_var_ref(TYPE_BOOL, span, holder_rec.c_spelling, holder, holder_rec.slot_form)
    AggCmp { pre: [decl, guard], differs: final_read }
}

// One carrier arm's payload, unboxed the same way a match arm's own binder unboxes it
// (x_unbox_payload, shared with the pattern-match lowering above), then compared the same
// as any other field.
fn agg_carrier_arm_body(tid: Int, slot: Slot, arm: Str, lhs: Int, rhs: Int, holder_rec: LayoutRecord, holder: Str, span: Int) -> Int ! Diag.Report {
    let inner_tid = child_tid(tid, slot)
    let member = carrier_member_layout_at(tid, slot, span)
    let held = layout_at(inner_tid, Position.Local, span)
    let payload_lhs = x_unbox_payload(inner_tid, span, lhs, member, held, arm)
    let payload_rhs = x_unbox_payload(inner_tid, span, rhs, member, held, arm)
    ir_mark_materialize(payload_lhs)
    ir_mark_materialize(payload_rhs)
    let sub = agg_cmp(inner_tid, payload_lhs, payload_rhs, span)
    if sub.differs < 0 { return -1 }
    let target = ir_var_ref(TYPE_BOOL, span, holder_rec.c_spelling, holder, holder_rec.slot_form)
    let mut stmts: List[Int] = sub.pre
    stmts.push(ir_assign(span, target, sub.differs))
    ir_block(span, stmts)
}

// The failure message's rendering of one side. A struct or an enum renders through
// Display when the type has one and a "<TypeName>" placeholder when it does not, the
// same placeholder gen0's own defensive renderer used for a value with no Display: unlike
// an interpolation hole, assert_eq's operand has no typecheck gate guaranteeing Display
// exists. A Result or an Option has no Display of its own in this compiler, so it renders
// by which arm it holds instead.
fn agg_render_side(node: Int, tid: Int, value_ref: Int, pre: List[Int]) -> Int ! Diag.Report {
    let k = tc_tid_kind(tid)
    if k == TyKind.Struct || k == TyKind.Enum { return cc_display_or_placeholder(node, tid, value_ref) }
    agg_tag_label(node, tid, value_ref, pre)
}

// A carrier's active arm, named rather than shown: "Some(..)"/"None" or "Ok(..)"/"Err(..)".
// The label is read from a fresh Str local the same way bool_to_str_ref above builds one,
// hoisted into `pre` ahead of the statement that reads it.
fn agg_tag_label(node: Int, tid: Int, value_ref: Int, pre: List[Int]) -> Int ! Diag.Report {
    let k = tc_tid_kind(tid)
    let default_label = if k == TyKind.Option { "None" } else { "Err(..)" }
    let other_label = if k == TyKind.Option { "Some(..)" } else { "Ok(..)" }
    let want_tag = if k == TyKind.Option { TAG_SOME } else { TAG_OK }
    let str_rec = layout_at(TYPE_STR, Position.Local, node)
    let holder = c_mint_local("agg_lbl")
    pre.push(ir_let(TYPE_STR, node, str_rec.c_spelling, holder, str_rec.slot_form, str_const(node, default_label)))
    let ints = int_spelling(node)
    let tag = ir_carrier_tag(TYPE_INT, node, ints, value_ref)
    let is_other = ir_binary(TYPE_BOOL, node, agg_bool_spelling(node), "==", tag, int_const(node, "{want_tag}"))
    let target = ir_var_ref(TYPE_STR, node, str_rec.c_spelling, holder, str_rec.slot_form)
    pre.push(ir_if(node, is_other, ir_block(node, [ir_assign(node, target, str_const(node, other_label))]), -1))
    ir_var_ref(TYPE_STR, node, str_rec.c_spelling, holder, str_rec.slot_form)
}

// assert_eq and assert_ne share the same comparison and the same two rendered sides; only
// the failing condition and the message wording differ, the same split the scalar buckets
// above make between an EQ and an NE failure.
fn lower_assert_aggregate(node: Int, tid: Int, left_node: Int, right_node: Int, is_eq: Bool) -> Int ! Diag.Report {
    let left_value = lower_value(left_node)
    let right_value = lower_value(right_node)
    if left_value < 0 || right_value < 0 { return -1 }
    let left_bound = bind_temp("left", tid, node, left_value)
    let right_bound = bind_temp("right", tid, node, right_value)
    let bools = agg_bool_spelling(node)
    let line = int_const(node, "{node_line(node)}")
    let mut pre: List[Int] = [left_bound.stmt, right_bound.stmt]
    let cmp = agg_cmp(tid, left_bound.ref, right_bound.ref, node)
    if cmp.differs < 0 { return -1 }
    for s in cmp.pre { pre.push(s) }
    let left_str = agg_render_side(node, tid, left_bound.ref, pre)
    let right_str = agg_render_side(node, tid, right_bound.ref, pre)
    if left_str < 0 || right_str < 0 { return -1 }
    // Each rendered side is read twice below (once in the mismatch message, once in the
    // expected/actual value), so mark it the same way bind_temp marks a repeated read.
    ir_mark_materialize(left_str)
    ir_mark_materialize(right_str)
    if is_eq {
        let msg = call_str_format(node, "ASSERT_EQ FAILED: %s != %s", [left_str, right_str])
        let exp = call_str_format(node, "%s", [right_str])
        let act = call_str_format(node, "%s", [left_str])
        let fail_stmt = call_runtime_void(node, c_assert_fail_eq_name(), [msg, exp, act, line])
        pre.push(ir_if(node, cmp.differs, ir_block(node, [fail_stmt]), -1))
        return ir_block(node, pre)
    }
    let msg = call_str_format(node, "ASSERT_NE FAILED: %s == %s", [left_str, right_str])
    let fail_stmt = call_runtime_void(node, c_assert_fail_name(), [msg, line])
    let eq = ir_unary(TYPE_BOOL, node, bools, "!", cmp.differs)
    pre.push(ir_if(node, eq, ir_block(node, [fail_stmt]), -1))
    ir_block(node, pre)
}

fn lower_assert_eq_call(node: Int) -> Int ! Diag.Report {
    let args = node_args(node)
    if !assert_args_ok(node, "assert_eq", args, 2) { return -1 }
    let left_node = sublist_get(args, 0)
    let right_node = sublist_get(args, 1)
    let tid = stmt_tid(left_node)
    if tid < 0 { return -1 }
    if eq_is_aggregate(tid) { return lower_assert_aggregate(node, tid, left_node, right_node, true) }
    let left_value = lower_value(left_node)
    let right_value = lower_value(right_node)
    if left_value < 0 || right_value < 0 { return -1 }
    let left_bound = bind_temp("left", tid, node, left_value)
    let right_bound = bind_temp("right", tid, node, right_value)
    let bool_rec = layout_at(TYPE_BOOL, Position.Local, node)
    let line = int_const(node, "{node_line(node)}")
    let mut pre: List[Int] = [left_bound.stmt, right_bound.stmt]
    if eq_is_str(tid) {
        let eq = ir_call_runtime(TYPE_BOOL, node, bool_rec.c_spelling,
            c_runtime_helper("str_eq"), bool_rec.slot_form, [left_bound.ref, right_bound.ref])
        let neq = ir_unary(TYPE_BOOL, node, bool_rec.c_spelling, "!", eq)
        let msg = call_str_format(node, "ASSERT_EQ FAILED: \"%s\" != \"%s\"", [left_bound.ref, right_bound.ref])
        let exp = call_str_format(node, "%s", [right_bound.ref])
        let act = call_str_format(node, "%s", [left_bound.ref])
        let fail_stmt = call_runtime_void(node, c_assert_fail_eq_name(), [msg, exp, act, line])
        pre.push(ir_if(node, neq, ir_block(node, [fail_stmt]), -1))
        return ir_block(node, pre)
    }
    if eq_is_float(tid) {
        let eq = ir_call_runtime(TYPE_BOOL, node, bool_rec.c_spelling,
            c_runtime_helper("float_eq"), bool_rec.slot_form, [left_bound.ref, right_bound.ref])
        let neq = ir_unary(TYPE_BOOL, node, bool_rec.c_spelling, "!", eq)
        let msg = call_str_format(node, "ASSERT_EQ FAILED: %f != %f", [left_bound.ref, right_bound.ref])
        let exp = call_str_format(node, "%f", [right_bound.ref])
        let act = call_str_format(node, "%f", [left_bound.ref])
        let fail_stmt = call_runtime_void(node, c_assert_fail_eq_name(), [msg, exp, act, line])
        pre.push(ir_if(node, neq, ir_block(node, [fail_stmt]), -1))
        return ir_block(node, pre)
    }
    let left_arg = eq_default_arg(tid, node, left_bound.ref)
    let right_arg = eq_default_arg(tid, node, right_bound.ref)
    let neq = ir_binary(TYPE_BOOL, node, bool_rec.c_spelling, "!=", left_bound.ref, right_bound.ref)
    let msg = call_str_format(node, "ASSERT_EQ FAILED: %lld != %lld", [left_arg, right_arg])
    let exp = call_str_format(node, "%lld", [right_arg])
    let act = call_str_format(node, "%lld", [left_arg])
    let fail_stmt = call_runtime_void(node, c_assert_fail_eq_name(), [msg, exp, act, line])
    pre.push(ir_if(node, neq, ir_block(node, [fail_stmt]), -1))
    ir_block(node, pre)
}

fn lower_assert_ne_call(node: Int) -> Int ! Diag.Report {
    let args = node_args(node)
    if !assert_args_ok(node, "assert_ne", args, 2) { return -1 }
    let left_node = sublist_get(args, 0)
    let right_node = sublist_get(args, 1)
    let tid = stmt_tid(left_node)
    if tid < 0 { return -1 }
    if eq_is_aggregate(tid) { return lower_assert_aggregate(node, tid, left_node, right_node, false) }
    let left_value = lower_value(left_node)
    let right_value = lower_value(right_node)
    if left_value < 0 || right_value < 0 { return -1 }
    let left_bound = bind_temp("left", tid, node, left_value)
    let right_bound = bind_temp("right", tid, node, right_value)
    let bool_rec = layout_at(TYPE_BOOL, Position.Local, node)
    let line = int_const(node, "{node_line(node)}")
    let mut pre: List[Int] = [left_bound.stmt, right_bound.stmt]
    if eq_is_str(tid) {
        let eq = ir_call_runtime(TYPE_BOOL, node, bool_rec.c_spelling,
            c_runtime_helper("str_eq"), bool_rec.slot_form, [left_bound.ref, right_bound.ref])
        let msg = call_str_format(node, "ASSERT_NE FAILED: \"%s\" == \"%s\"", [left_bound.ref, right_bound.ref])
        let fail_stmt = call_runtime_void(node, c_assert_fail_name(), [msg, line])
        pre.push(ir_if(node, eq, ir_block(node, [fail_stmt]), -1))
        return ir_block(node, pre)
    }
    if eq_is_float(tid) {
        let eq = ir_call_runtime(TYPE_BOOL, node, bool_rec.c_spelling,
            c_runtime_helper("float_eq"), bool_rec.slot_form, [left_bound.ref, right_bound.ref])
        let msg = call_str_format(node, "ASSERT_NE FAILED: %f == %f", [left_bound.ref, right_bound.ref])
        let fail_stmt = call_runtime_void(node, c_assert_fail_name(), [msg, line])
        pre.push(ir_if(node, eq, ir_block(node, [fail_stmt]), -1))
        return ir_block(node, pre)
    }
    let left_arg = eq_default_arg(tid, node, left_bound.ref)
    let right_arg = eq_default_arg(tid, node, right_bound.ref)
    let eq = ir_binary(TYPE_BOOL, node, bool_rec.c_spelling, "==", left_bound.ref, right_bound.ref)
    let msg = call_str_format(node, "ASSERT_NE FAILED: %lld == %lld", [left_arg, right_arg])
    let fail_stmt = call_runtime_void(node, c_assert_fail_name(), [msg, line])
    pre.push(ir_if(node, eq, ir_block(node, [fail_stmt]), -1))
    ir_block(node, pre)
}

// ── debug_assert(cond, msg?) ────────────────────────────────────────────────
//
// Gated on cs_debug_mode: off answers an empty block, the same as gen0 emitting nothing.
// On, a single non-decomposed check. gen0's own cond text is the raw C expression it just
// emitted; nothing here holds that text, so the Blink source of the condition stands in,
// the same substitution assert's own assertion text already makes.
fn lower_debug_assert_call(node: Int) -> Int ! Diag.Report {
    let args = node_args(node)
    if !assert_args_ok(node, "debug_assert", args, 1) { return -1 }
    if !cs_debug_mode { return ir_block(node, []) }
    let cond_node = sublist_get(args, 0)
    let cond_value = lower_value(cond_node)
    if cond_value < 0 { return -1 }
    let bool_rec = layout_at(TYPE_BOOL, Position.Local, node)
    let neg = ir_unary(TYPE_BOOL, node, bool_rec.c_spelling, "!", cond_value)
    let mut msg = str_const(node, "debug assertion failed")
    if sublist_length(args) >= 2 {
        msg = lower_value(sublist_get(args, 1))
        if msg < 0 { return -1 }
    }
    let fail_stmt = call_runtime_void(node, c_debug_assert_fail_name(), [
        str_const(node, diag_file_for_node(node)),
        int_const(node, "{node_line(node)}"),
        str_const(node, cs_current_fn_name),
        str_const(node, unparse_expr(cond_node)),
        msg,
    ])
    ir_block(node, [ir_if(node, neg, ir_block(node, [fail_stmt]), -1)])
}

// ── Simple statements ─────────────────────────────────────────────────────

// A unit-typed initialiser carries the one value of `()` but hands back nothing to assign,
// because a `()`-returning function is emitted as C `void` while storage spells unit as an
// integer. So the initialiser runs as a statement and the name is given the single value
// directly. Reading it as an expression instead would assign a void result, which no C
// compiler accepts.
// The declaration of one named `let`. A `let mut` a closure of this body shares is stored
// in a heap cell, which is that binding's storage for its whole life, and both frames read
// and write through it; sections/02_syntax.md:336 is what makes the two sides one binding.
// A binding nothing shares keeps the plain local it has today.
// Void has exactly one value and Never has none, so both alike leave nothing to store: a
// C expression at either type is `void`. The pairing mirrors x_is_void_like (cg_expr.bl)
// and lo_is_void_like (layout.bl); those are private to their own modules, so this is its
// own copy rather than a shared import.
fn cs_is_void_like(tid: Int) -> Bool {
    let k = tc_tid_kind(tid)
    k == TyKind.Void || k == TyKind.Never
}

fn bind_and_declare_let(node: Int, tid: Int, rec: LayoutRecord, name: Str, value: Int, discard: Bool) -> Int ! Diag.Report {
    // A discard binder has no source name to bind or escape, so mint a fresh local instead
    // of routing it through the ordinary name-escaping path. This is decided structurally
    // by the caller (tc_let_binder_is_discard), never by comparing the name itself.
    if discard {
        return ir_let(tid, node, rec.c_spelling, c_mint_local("_"), rec.slot_form, value)
    }
    let is_mut = node_is_mut(node) == 1
    if is_mut && cg_eff_binder_is_shared(name) {
        bind_binder_cell(cur_scope(), name, tid)
        return ir_cell_let(tid, node, rec.c_spelling, name, rec.slot_form, value)
    }
    bind_binder_mut(cur_scope(), name, tid, is_mut)
    if is_mut && cg_eff_frame_written(node) {
        return ir_volatile_let(tid, node, rec.c_spelling, cg_local_c_name(name), rec.slot_form, value)
    }
    ir_let(tid, node, rec.c_spelling, cg_local_c_name(name), rec.slot_form, value)
}

fn bind_unit_let(node: Int, tid: Int, init: Int, rec: LayoutRecord, name: Str, discard: Bool) -> Int ! Diag.Report {
    let ran = lower_stmt_tail(init, TAIL_DISCARD, "", -1)
    if ran < 0 { return -1 }
    cg_expr_push_pending(node, ran)
    let unit = int_const(node, "0")
    if unit < 0 { return -1 }
    bind_and_declare_let(node, tid, rec, name, unit, discard)
}

fn lower_let(node: Int) -> Int ! Diag.Report {
    // A discarding binder mints its own WildcardPattern node into the elements slot, so it
    // must be told apart from a real tuple pattern before the elements-slot dispatch below,
    // or `let _ = e` would wrongly fall into tuple destructuring.
    let discard = tc_let_binder_is_discard(node) == 1
    if !discard && node_elements(node) != -1 { return lower_destructuring_let(node) }
    let tid = stmt_tid(node)
    if tid < 0 { return -1 }
    let rec = layout_at(tid, Position.Local, node)
    let _ = ensure_typedef_for(tid)
    let name = if discard { "" } else { node_name(node) }
    let init = node_value(node)
    if init < 0 {
        return bind_and_declare_let(node, tid, rec, name, -1, discard)
    }
    if tc_tid_kind(tid) == TyKind.Void {
        if !cg_expr_is_registered(init) { return bind_unit_let(node, tid, init, rec, name, discard) }
    }
    // The initializer is lowered before the name binds, so `let x = x + 1` reads the
    // outer `x` the source names rather than the one this statement is declaring.
    let value = lower_value(init)
    bind_and_declare_let(node, tid, rec, name, value, discard)
}

// `let (a, b) = e`. The tuple binds once so the initializer runs once, and each element
// binds from that local. A nested tuple pattern binds through another element local.
fn lower_destructuring_let(node: Int) -> Int ! Diag.Report {
    let tid = stmt_tid(node)
    if tid < 0 { return -1 }
    let rec = layout_at(tid, Position.Local, node)
    let _ = ensure_typedef_for(tid)
    let holder = c_mint_local("tup")
    let init = node_value(node)
    let value = if init < 0 { poison_value(node) } else { lower_value(init) }
    let mut out: List[Int] = [ir_let(tid, node, rec.c_spelling, holder, rec.slot_form, value)]
    let is_mut = node_is_mut(node) == 1
    if !bind_tuple_pattern(node_elements(node), tid, holder, rec.c_spelling, rec.slot_form, out, is_mut) {
        return -1
    }
    // Every binding but the last drains unscoped into the enclosing block, the same path
    // bind_unit_let takes -- a `Block` here would give the destructured names a C scope of
    // their own that ends before the next statement can read them.
    let mut i = 0
    while i < out.len() - 1 {
        cg_expr_push_pending(node, out.get(i).unwrap())
        i = i + 1
    }
    out.get(out.len() - 1).unwrap()
}

// Binds every name a tuple pattern holds against `holder`, appending one Let each.
// Answers false when an element has no type, so no name of this pattern binds at all.
// `is_mut` is the enclosing `let`'s own mutability: `let mut (a, b) = t` spells it once
// on the LetBinding, not per leaf, so it threads down the same way typecheck's
// nr_define_let_pattern already does.
fn bind_tuple_pattern(pat: Int, tid: Int, holder: Str, spell: Str, form: SlotForm, out: List[Int], is_mut: Bool) -> Bool ! Diag.Report {
    let elems = node_elements(pat)
    if elems == -1 { return true }
    let mut i = 0
    while i < sublist_length(elems) {
        let sub = sublist_get(elems, i)
        let elem_tid = child_tid(tid, Slot.Elem(i))
        if elem_tid < 0 {
            diag_ice_at("TupleElementMissing", UNSOLVED_TYPEVAR_AT_CODEGEN,
                "tuple type {tid} has no element {i}", sub,
                "a tuple pattern is checked against its tuple type; this is a compiler bug")
            return false
        }
        let rec = layout_at(elem_tid, Position.Local, sub)
        let _ = ensure_typedef_for(elem_tid)
        let obj = ir_var_ref(tid, sub, spell, holder, form)
        let get = ir_field_get(elem_tid, sub, rec.c_spelling, tuple_member(i), rec.slot_form, obj)
        if !bind_sub_pattern(sub, elem_tid, get, rec, out, is_mut) { return false }
        i = i + 1
    }
    true
}

// One element of a destructuring pattern: a name binds, a nested tuple binds through a
// local of its own, and a wildcard drops the element.
fn bind_sub_pattern(sub: Int, tid: Int, value: Int, rec: LayoutRecord, out: List[Int], is_mut: Bool) -> Bool ! Diag.Report {
    let kind = nk_of(node_kind(sub))
    if kind == NodeKind.WildcardPattern { return true }
    if kind == NodeKind.TuplePattern {
        let inner = c_mint_local("tup")
        out.push(ir_let(tid, sub, rec.c_spelling, inner, rec.slot_form, value))
        return bind_tuple_pattern(sub, tid, inner, rec.c_spelling, rec.slot_form, out, is_mut)
    }
    let name = node_name(sub)
    // A leaf has no `mut` form of its own; only `let mut (a, b) = t` can make one
    // reassignable, and that mutability is the caller's `is_mut` argument. A mutable
    // leaf a closure shares needs the same cell a plain `let mut` capture needs.
    if is_mut && cg_eff_binder_is_shared(name) {
        bind_binder_cell(cur_scope(), name, tid)
        out.push(ir_cell_let(tid, sub, rec.c_spelling, name, rec.slot_form, value))
        return true
    }
    bind_binder_mut(cur_scope(), name, tid, is_mut)
    if is_mut && cg_eff_frame_written(sub) {
        out.push(ir_volatile_let(tid, sub, rec.c_spelling, cg_local_c_name(name), rec.slot_form, value))
        return true
    }
    out.push(ir_let(tid, sub, rec.c_spelling, cg_local_c_name(name), rec.slot_form, value))
    true
}

fn lower_assign(node: Int) -> Int ! Diag.Report {
    let target = node_target(node)
    if !is_assignable_place(target) {
        diag_ice_stage_not_built("an assignment to a place that is not a local", node)
        return ir_expr_stmt(node, poison_value(node))
    }
    let rhs = node_value(node)
    let tid = stmt_tid(target)
    // `m = nothing()` reassigns a genuine Void-typed local: the RHS is a `void`-valued C
    // call, and the target already holds the placeholder int its own `let` gave it, so
    // there is nothing to write back -- only the call's side effect needs to run. The
    // same two-signal guard lower_let's Void arm uses: registered means some earlier
    // seam already turned this node into a real value (a materialised temp), not a bare
    // void call, so the ordinary assignment path is still the right one for it.
    if tid >= 0 && cs_is_void_like(tid) && !cg_expr_is_registered(rhs) {
        return lower_stmt_tail(rhs, TAIL_DISCARD, "", -1)
    }
    ir_assign(node, lower_target(target), lower_value(rhs))
}

// Whether a target is a place this stage can build an lvalue for: a bare local this module
// bound itself, a module-level global name resolution already resolved for this node, or a
// field reached off one. Anything else -- an index expression, a place behind a pointer --
// is a place the expression stage builds that has no lvalue producer yet.
fn is_assignable_place(node: Int) -> Bool ! Diag.Report {
    let kind = nk_of(node_kind(node))
    if kind == NodeKind.Ident {
        if tid_of_binder(cur_scope(), node_name(node)) >= 0 { return true }
        return tc_global_decl_node(node) >= 0
    }
    kind == NodeKind.FieldAccess
}

// The left side of an assignment must be an lvalue. A bare local is one this module bound
// itself, so it is read straight from the binder scope. A module-level `let mut` global is
// not bound anywhere this module tracks binders, so its declaration is asked of typecheck's
// own record instead of re-derived here -- name resolution already decided which module's
// global a name reaches, from the reading file's own import list, and the spelling alone
// cannot recover that (two modules may each declare a private global under one name). A
// field access reuses the expression stage's own reader: `lower_expr` already builds a
// FieldGet for it, and `is_lvalue_kind` in ir.bl already accepts a FieldGet as an Assign
// target, so this is not a new node shape, only a new place lower_target reaches it from.
fn lower_target(node: Int) -> Int ! Diag.Report {
    if nk_of(node_kind(node)) == NodeKind.FieldAccess { return lower_value(node) }
    let name = node_name(node)
    let tid = tid_of_binder(cur_scope(), name)
    if tid >= 0 {
        let rec = layout_at(tid, Position.Local, node)
        // The place a shared binding names is its cell's value. A write to a local of the
        // same spelling would land in storage the closure sharing it never reads.
        if binder_is_celled(cur_scope(), name) {
            return ir_cell_ref(tid, node, rec.c_spelling, name, rec.slot_form)
        }
        return ir_var_ref(tid, node, rec.c_spelling, cg_local_c_name(name), rec.slot_form)
    }
    let decl = tc_global_decl_node(node)
    if decl >= 0 {
        let gtid = stmt_tid(node)
        if gtid >= 0 {
            let rec = layout_at(gtid, Position.Local, node)
            return ir_global_ref(gtid, node, rec.c_spelling, c_global_name(decl), rec.slot_form)
        }
    }
    diag_ice_stage_not_built("an assignment to a place that is not a local", node)
    poison_value(node)
}

// `x += e` is `x = x + e`. The target is read and written, so it is lowered twice: two
// nodes for one source node, which keeps each reach a separate tree the printer can
// place inline on its own.
fn lower_compound_assign(node: Int) -> Int ! Diag.Report {
    let target = node_target(node)
    if !is_assignable_place(target) {
        diag_ice_stage_not_built("an assignment to a place that is not a local", node)
        return ir_expr_stmt(node, poison_value(node))
    }
    let tid = stmt_tid(target)
    if tid < 0 { return -1 }
    let lhs = lower_target(target)
    let read = lower_target(target)
    // The same seam as the operator, so `x += 1` is checked wherever `x + 1` is.
    let site = ArithSite { node: node, op: node_op(node), tid: tid, lhs_node: target, rhs_node: node_value(node) }
    let sum = lower_arith_operator(site, read, lower_value(node_value(node)))
    if sum < 0 { return -1 }
    ir_assign(node, lhs, sum)
}

fn lower_return(node: Int) -> Int ! Diag.Report {
    let v = node_value(node)
    let frame = cg_expr_frame_current()
    if frame != "" {
        // A test body returns no value, so the one a return carries runs for its effects.
        if v < 0 { return ir_panic_catch_exit(node, frame) }
        let value = lower_value(v)
        if value < 0 { return -1 }
        return ir_block(node, [ir_expr_stmt(node, value), ir_panic_catch_exit(node, frame)])
    }
    if v < 0 { return return_void(node) }
    let value = lower_value(v)
    if value < 0 { return -1 }
    cg_stmt_return_value(node, value)
}

// ── Blocks in value position ──────────────────────────────────────────────

// One statement, with the statements its value needed in front of it.
//
// A value the expression stage cannot finish on its own (a coalesce, a short-circuit arm,
// a `?`, a carrier unwrap) declares a temp, leaves the statements that fill it in that
// stage's buffer, and answers a read of the temp. A block is where those statements land,
// because a C block is the only thing that holds a statement, and they go in front of the
// statement that reads the temp.
//
// The mark is taken per statement rather than per block. A seam that lowers a value of its
// own before recursing into a block (an `if` its condition) owns that value's statements,
// so a block must take only what was pushed while it lowered its own statement.
//
// An `if` or a `match` the statement reads as a value is materialised into a temp first,
// because the expression stage can only answer a read of a temp something else declared.
//
// Answers false on a stop, having left `out` as it found it.
fn lower_stmt_hoisted(s: Int, tail: Int, dest: Str, dest_tid: Int, out: List[Int]) -> Bool ! Diag.Report {
    let mark = cg_expr_pending_count()
    let value_mark = cg_expr_value_count()
    let lowered = if materialise_stmt_values(s) { lower_stmt_tail(s, tail, dest, dest_tid) } else { -1 }
    if lowered < 0 {
        // The statements filled temps only the stopped statement reads, so they go nowhere,
        // and the rows naming those temps go with them.
        let _dropped = cg_expr_take_pending(mark)
        cg_expr_drop_values(value_mark)
        return false
    }
    cg_expr_drain_pending(mark, out)
    out.push(lowered)
    true
}

fn lower_tail_block_into(node: Int, tail: Int, dest: Str, dest_tid: Int) -> Int ! Diag.Report {
    let _ = open_scope()
    let stmts = node_stmts(node)
    let n = if stmts == -1 { 0 } else { sublist_length(stmts) }
    let mut out: List[Int] = []
    let mut i = 0
    while i < n {
        let s = sublist_get(stmts, i)
        let mode = if i == n - 1 { tail } else { TAIL_DISCARD }
        if !lower_stmt_hoisted(s, mode, dest, dest_tid, out) {
            close_scope()
            return -1
        }
        i = i + 1
    }
    if n == 0 && tail == TAIL_RETURN { out.push(ir_return(node, -1)) }
    close_scope()
    ir_block(node, out)
}

// ── Values an arm has to fill ─────────────────────────────────────────────

// An `if` or a `match` written where a value is wanted. Its arms are blocks, and only a
// statement can stand in a block, so C has no expression to put one in. The lowering is a
// temp declared in front of the statement that reads it, each arm assigning into that
// temp, and the temp's name given to the expression stage, which spells a read of it.
//
// The walk runs before the statement lowers, so the temp and the arms that fill it reach
// the block ahead of the reader. It stops at every boundary that would move work to a
// place it does not belong: a block of its own, which is walked for each of its own
// statements; a closure body, which is another function; a loop test, a match guard and
// the right operand of a short-circuit, each of which runs a different number of times
// than the statement around it. A shape left unwalked is not wrong C. The expression
// stage refuses a value it was given no temp for, by name.
//
// Answers false when a shape was refused, so the statement stops on the one named report
// rather than lowering into a read of a temp nothing declared; see The stop above.
fn materialise_stmt_values(s: Int) -> Bool ! Diag.Report {
    mv_work = []
    mv_in_target = false
    mv_stmt(s)
}

fn mv_stmt(s: Int) -> Bool ! Diag.Report {
    match nk_of(node_kind(s)) {
        NodeKind.LetBinding => mv_expr(node_value(s))
        NodeKind.Assignment => mv_assign_pair(node_target(s), node_value(s))
        NodeKind.CompoundAssign => mv_assign_pair(node_target(s), node_value(s))
        NodeKind.ExprStmt => mv_stmt(node_value(s))
        NodeKind.Return => mv_expr(node_value(s))
        NodeKind.IfExpr => mv_expr(node_condition(s))
        NodeKind.MatchExpr => mv_expr(node_scrutinee(s))
        // The ends of a counted range are read once above the loop, so a temp in front of
        // the statement is read exactly as often as they are.
        NodeKind.ForIn => mv_expr(node_iterable(s))
        NodeKind.Block => true
        NodeKind.WhileLoop => true
        NodeKind.LoopExpr => true
        NodeKind.WithBlock => true
        NodeKind.AsyncScope => true
        NodeKind.Break => true
        NodeKind.Continue => true
        _ => mv_expr(s)
    }
}

// A part of the statement the walk passed that an if/match/block's arms may not simply run
// before, unless it is moved there too: a number, a character and a boolean, and the
// tuples, lists and ranges built out of those, are the only parts that read nothing, write
// nothing, cannot trap and call nothing, so only those are left out of this record.
//
// Everything else is work: it reads a cell an arm can write, it traps, or it calls a
// function. Recorded here in the order the walk passed it, so a value-position construct
// reached afterward can hoist each one into a temp of its own standing in front of it,
// in that same order, rather than being refused outright. `hoistable` is false for a value
// with no type of its own, and for anything read while computing an assignment's target --
// hoisting a target would read a place that is about to be written instead of reaching the
// place itself, so nothing found there is ever safe to move. Whether a node has a type of
// its own is answered by tc_lookup_node_tid, never by stmt_tid: a bare name resolved
// structurally -- a type, a trait, a module, an effect handle -- carries no type of its
// own by design, and stmt_tid's tid_of_node reports that as the ICE it is everywhere else,
// which is the wrong report for a plain hoistability probe.
type MvWork { node: Int, hoistable: Bool }

let mut mv_work: List[MvWork] = []

// True while the walk is inside an assignment's target.
let mut mv_in_target: Bool = false

// Work the walk may not move an arm above unless it hoists it first. Whatever follows in
// the same statement asks the record built here before it decides.
fn mv_moves_work(node: Int) -> Bool ! Diag.Report {
    // A spread copies its source into the container being built; the walk knows nothing
    // about when that copy runs relative to the container's other elements, so it is never
    // safe to hoist even when typecheck gave it a type.
    if nk_of(node_kind(node)) == NodeKind.SpreadExpr {
        mv_work.push(MvWork { node: node, hoistable: false })
        return true
    }
    mv_work.push(MvWork { node: node, hoistable: !mv_in_target && tc_lookup_node_tid(node) >= 0 })
    true
}

fn mv_pair(a: Int, b: Int) -> Bool ! Diag.Report {
    if !mv_expr(a) { return false }
    mv_expr(b)
}

// An assignment's target and its value, in that order. The target is never a value to
// hoist a copy of, so everything the walk finds while it is being computed is marked
// unhoistable for as long as that computation lasts, whatever came before it.
//
// A bare name is the one target shape lower_target reaches with no call, no trap and no
// read of its own: it names a place straight out of the binder scope or the global table,
// the same way a callee resolved structurally is. Walking it would record a place-name as
// work a later value-position construct has to run after, which refuses that construct for
// no reason -- nothing runs here to move. A field access does read its object first, so it
// still walks under mv_in_target the way it always has.
fn mv_assign_pair(target: Int, value: Int) -> Bool ! Diag.Report {
    if nk_of(node_kind(target)) != NodeKind.Ident {
        let was_in_target = mv_in_target
        mv_in_target = true
        let ok = mv_expr(target)
        mv_in_target = was_in_target
        if !ok { return false }
    }
    mv_expr(value)
}

fn mv_list(sl: Int) -> Bool ! Diag.Report {
    if sl == -1 { return true }
    let mut i = 0
    while i < sublist_length(sl) {
        if !mv_expr(sublist_get(sl, i)) { return false }
        i = i + 1
    }
    true
}

// An interpolated string's literal-text segments carry nothing to walk; a hole is an
// arbitrary expression, including an `if`/`match`/block that needs materialising exactly
// like one written outside a string.
fn mv_interp_holes(e: Int) -> Bool ! Diag.Report {
    let parts = node_elements(e)
    let mut i = 0
    while i < sublist_length(parts) {
        let part = sublist_get(parts, i)
        if !interp_part_is_literal(part) {
            if !mv_expr(part) { return false }
        }
        i = i + 1
    }
    true
}

// One expression, in the order its parts run. A kind whose parts this does not know is
// walked no further and counts as work, so nothing inside it is moved and nothing after it
// is either.
fn mv_expr(e: Int) -> Bool ! Diag.Report {
    if e < 0 { return true }
    match nk_of(node_kind(e)) {
        NodeKind.IntLit => true
        NodeKind.FloatLit => true
        NodeKind.CharLit => true
        NodeKind.BoolLit => true
        NodeKind.TupleLit => mv_list(node_elements(e))
        NodeKind.ListLit => mv_list(node_elements(e))
        NodeKind.RangeLit => mv_pair(node_start(e), node_end(e))
        NodeKind.NamedArg => mv_expr(node_value(e))
        NodeKind.IfExpr => materialise_value_expr(e)
        NodeKind.MatchExpr => materialise_value_expr(e)
        NodeKind.Block => materialise_value_expr(e)
        NodeKind.WithBlock => materialise_value_expr(e)
        NodeKind.AsyncScope => materialise_value_expr(e)
        NodeKind.BinOp => mv_binop(e)
        // `?` returns out of the function on its failure arm, and an operator on a type
        // that carries an impl is a call into it.
        NodeKind.UnaryOp => mv_after(mv_expr(node_left(e)), e)
        // A name and a field read a cell an arm can write.
        NodeKind.Ident => mv_moves_work(e)
        NodeKind.FieldAccess => mv_after(mv_expr(node_obj(e)), e)
        // A hole runs before the formatter call that reads it.
        NodeKind.InterpString => mv_after(mv_interp_holes(e), e)
        NodeKind.StructLit => mv_struct_lit(e)
        // A read through an index is checked, and the check is a statement of its own.
        NodeKind.IndexExpr => mv_after(mv_pair(node_obj(e), node_index(e)), e)
        // A call's left is the callee, which runs before its arguments.
        NodeKind.Call => mv_after(mv_call_head(node_left(e)) && mv_list(node_args(e)), e)
        NodeKind.MethodCall => mv_after(mv_call_head(node_obj(e)) && mv_list(node_args(e)), e)
        _ => mv_moves_work(e)
    }
}

// codegen fills a struct literal one declared field at a time, by name, not in the order
// the literal spelled them. A field the literal omits runs its default at the place the
// type declares it, so the walk cannot put it among the others and refuses the literal. A
// spread is bound to a temp before any field is written, and an omitted field then reads
// that temp, which nothing can write. So the walk takes the source first, then the written
// fields in declaration order, the order lower_struct_lit runs them in.
fn mv_struct_lit(e: Int) -> Bool ! Diag.Report {
    let tid = tid_of_node(e)
    if tid < 0 { return mv_moves_work(e) }
    let decl = tc_tid_decl_node(tid)
    if decl < 0 { return mv_moves_work(e) }
    let given = node_fields(e)
    let sp = mv_struct_lit_spread(given)
    if sp >= 0 {
        if !mv_expr(node_value(sp)) { return false }
    }
    let decls = node_fields(decl)
    let mut i = 0
    while i < sublist_length(decls) {
        let fd = sublist_get(decls, i)
        let g = mv_struct_lit_find(given, node_name(fd))
        if g >= 0 {
            if !mv_expr(node_value(g)) { return false }
        } else if sp < 0 {
            return mv_moves_work(e)
        }
        i = i + 1
    }
    true
}

fn mv_struct_lit_spread(given: Int) -> Int {
    let mut i = 0
    while i < sublist_length(given) {
        let g = sublist_get(given, i)
        if nk_of(node_kind(g)) == NodeKind.SpreadExpr { return g }
        i = i + 1
    }
    -1
}

fn mv_struct_lit_find(given: Int, name: Str) -> Int {
    let mut i = 0
    while i < sublist_length(given) {
        let g = sublist_get(given, i)
        if node_name(g) == name { return g }
        i = i + 1
    }
    -1
}

// The part of a value-position expression that lowers ahead of the statements that fill
// the temp: an `if` reads its condition there, a `match` its scrutinee, a `with` the
// resources it opens. A bare block has none, because every statement it holds stands under
// the temp already.
fn mv_head(node: Int) -> Bool ! Diag.Report {
    match nk_of(node_kind(node)) {
        NodeKind.IfExpr => mv_expr(node_condition(node))
        NodeKind.MatchExpr => mv_expr(node_scrutinee(node))
        NodeKind.WithBlock => mv_with_items(node)
        _ => true
    }
}

// Only a resource item carries an expression. An arena item is a bare name and a handler
// item is its own shape, and neither holds a value this walk could move.
fn mv_with_items(node: Int) -> Bool ! Diag.Report {
    let items = node_handlers(node)
    if items == -1 { return true }
    let mut i = 0
    while i < sublist_length(items) {
        let item = sublist_get(items, i)
        if nk_of(node_kind(item)) == NodeKind.WithResource {
            if !mv_expr(node_value(item)) { return false }
        }
        i = i + 1
    }
    true
}

// A part whose own work runs after the parts inside it.
fn mv_after(walked: Bool, node: Int) -> Bool ! Diag.Report {
    if !walked { return false }
    mv_moves_work(node)
}

// A callee or a method receiver spelled as a bare name that owns no local binder and
// names no module-level global is a namespace, a module, a type, a trait, an effect
// handle or a plain function: lower_fn_call and cc_receiver_role resolve every one of
// those by the spelling alone and never read a value for it, so tid_of_node has nothing
// to answer and this walk must not ask either -- asking anyway reports the wrong bug, the
// same hazard cc_receiver_role's own note names. Nothing runs here at all, so it is not
// recorded as work. A bound local, a resolved global, or an expression more than a bare
// name is a real read in this position and is walked the ordinary way.
fn mv_call_head(node: Int) -> Bool ! Diag.Report {
    if nk_of(node_kind(node)) != NodeKind.Ident { return mv_expr(node) }
    if tid_of_binder(cur_scope(), node_name(node)) >= 0 { return mv_expr(node) }
    if tc_global_decl_node(node) >= 0 { return mv_expr(node) }
    true
}

fn mv_binop(e: Int) -> Bool ! Diag.Report {
    if !mv_expr(node_left(e)) { return false }
    let op = node_op(e)
    // The right operand of `&&`, `||` and `??` runs only when the left one decided
    // nothing, and the expression stage builds each as an `if`. A temp filled in front of
    // the statement would run it every time, which both changes what the program does and
    // can run work the left operand was guarding.
    if op == "&&" { return mv_moves_work(e) }
    if op == "||" { return mv_moves_work(e) }
    if op == "??" { return mv_moves_work(e) }
    if !mv_expr(node_right(e)) { return false }
    // A divide traps on a zero right operand, and an operator on a type that carries an
    // impl is a call into it.
    mv_moves_work(e)
}

// Every work item the walk passed before this node, hoisted into a temp of its own, in the
// order the walk found them, so this node's own temp can stand after all of them without
// moving anything the source put ahead of it. Answers false, leaving the record untouched,
// the moment one item cannot be hoisted, so the caller reports the same refusal a walk
// with no hoisting at all would have given.
fn mv_hoist_pending() -> Bool ! Diag.Report {
    let mut i = 0
    while i < mv_work.len() {
        if !mv_work.get(i).unwrap().hoistable { return false }
        i = i + 1
    }
    i = 0
    while i < mv_work.len() {
        mv_hoist_one(mv_work.get(i).unwrap())
        i = i + 1
    }
    mv_work = []
    true
}

// One work item, lowered into a temp exactly the way any other value would be, and named
// to the expression stage the same way a value-position construct's own temp is: a later
// read of this same node substitutes a read of the temp instead of lowering it again.
fn mv_hoist_one(w: MvWork) ! Diag.Report {
    let tid = stmt_tid(w.node)
    let rec = layout_at(tid, Position.Local, w.node)
    let _ = ensure_typedef_for(tid)
    let name = c_mint_local("hoist")
    let value = lower_value(w.node)
    cg_expr_push_pending(w.node, ir_let(tid, w.node, rec.c_spelling, name, rec.slot_form, value))
    cg_expr_register_value(w.node, name, tid)
}

// The temp for one value-position `if` or `match`: declared unset, filled by the arms,
// and named to the expression stage before the statement that reads it lowers.
//
// What the walk passed before it reached this node decides whether the temp is safe, so
// hoisting that work comes before anything else this does. The head is not part of that:
// it lowers inside the `if` the temp stands under, so it keeps its place ahead of the arms
// whatever work it holds. Walking it materialises a value-position `if` in a condition or
// a scrutinee into a temp of its own above this one.
// A construct whose tail is not a value expression has type `()`, which is an ordinary
// inhabited type carrying one value and a representation, so the binding gets that one
// value rather than a report. The temp is declared at the unit spelling and initialised to
// the single value; the construct then runs as a statement, because a tail that is not a
// value expression has nothing to assign. The fill question is not asked: there is one
// value and it is already in the temp, whichever path the body takes.
fn materialise_unit_value(node: Int, tid: Int) -> Bool ! Diag.Report {
    let rec = layout_at(tid, Position.Local, node)
    let _ = ensure_typedef_for(tid)
    let name = c_mint_local("val")
    let unit = int_const(node, "0")
    if unit < 0 { return false }
    cg_expr_push_pending(node, ir_let(tid, node, rec.c_spelling, name, rec.slot_form, unit))
    let ran = lower_stmt_tail(node, TAIL_DISCARD, "", -1)
    if ran < 0 { return false }
    cg_expr_push_pending(node, ran)
    cg_expr_register_value(node, name, tid)
    mv_work = []
    true
}

fn materialise_value_expr(node: Int) -> Bool ! Diag.Report {
    if !mv_hoist_pending() {
        diag_ice_at("ValuePositionExprMovesWork", CODEGEN_STAGE_NOT_BUILT,
            "{node_kind_name(node_kind(node))} in value position stands after work its arms would run before", node,
            "materialising this needs the temp declared where the reader is lowered; bind the value in a let above the statement")
        return false
    }
    if !mv_head(node) { return false }
    let tid = stmt_tid(node)
    if tid < 0 { return false }
    if tc_tid_kind(tid) == TyKind.Void { return materialise_unit_value(node, tid) }
    if !tail_fills(node) {
        diag_ice_at("ValuePositionArmFillsNothing", CODEGEN_STAGE_NOT_BUILT,
            "the tail of this {node_kind_name(node_kind(node))} in value position neither produces a value nor leaves the block", node,
            "every arm must end in a value, a return, a break or a continue; an arm ending in a let or a loop has no lowering yet")
        return false
    }
    let rec = layout_at(tid, Position.Local, node)
    let _ = ensure_typedef_for(tid)
    let name = c_mint_local("val")
    cg_expr_push_pending(node, ir_let(tid, node, rec.c_spelling, name, rec.slot_form, -1))
    let filled = lower_stmt_tail(node, TAIL_ASSIGN, name, tid)
    if filled < 0 { return false }
    cg_expr_push_pending(node, filled)
    cg_expr_register_value(node, name, tid)
    // The head and the arms both stand under this temp, and a temp minted later stands
    // under this one. So nothing they hold is work a later part of the same statement has
    // to move above. Lowering the arms ran this same walk over each arm statement, which
    // left the record holding whatever the last of them passed; this is what clears it.
    mv_work = []
    true
}

// Whether every arm of a value-position `if` or `match` either assigns the temp or leaves
// the block without reaching the read. A `return`, a `break` and a `continue` all leave;
// anything that runs to the end of its arm without producing a value would let the temp be
// read before anything wrote it, which is the one shape this must never build.
fn arms_fill_tail(node: Int) -> Bool ! Diag.Report {
    if nk_of(node_kind(node)) == NodeKind.MatchExpr { return match_arms_fill(node) }
    let els = node_else_body(node)
    // With no else arm there is a path around the whole `if`, and it writes nothing.
    if els < 0 { return false }
    if !body_fills(node_then_body(node)) { return false }
    body_fills(els)
}

fn match_arms_fill(node: Int) -> Bool ! Diag.Report {
    let arms = node_arms(node)
    let n = if arms == -1 { 0 } else { sublist_length(arms) }
    if n == 0 { return false }
    let mut i = 0
    while i < n {
        if !body_fills(node_body(sublist_get(arms, i))) { return false }
        i = i + 1
    }
    true
}

fn body_fills(body: Int) -> Bool ! Diag.Report {
    if body < 0 { return false }
    if nk_of(node_kind(body)) != NodeKind.Block { return tail_fills(body) }
    let stmts = node_stmts(body)
    let n = if stmts == -1 { 0 } else { sublist_length(stmts) }
    if n == 0 { return false }
    tail_fills(sublist_get(stmts, n - 1))
}

// Whether the last statement of an arm hands its value to the tail mode. The arms answer
// the same question lower_stmt_tail does: the shapes that reach tail_wrap produce a value,
// the shapes that jump leave the block, and the rest fall off the end writing nothing.
fn tail_fills(s: Int) -> Bool ! Diag.Report {
    match nk_of(node_kind(s)) {
        NodeKind.LetBinding => false
        NodeKind.Assignment => false
        NodeKind.CompoundAssign => false
        NodeKind.WhileLoop => false
        NodeKind.LoopExpr => false
        NodeKind.ForIn => false
        NodeKind.Return => true
        NodeKind.Break => true
        NodeKind.Continue => true
        NodeKind.ExprStmt => tail_fills(node_value(s))
        NodeKind.Block => body_fills(s)
        NodeKind.IfExpr => arms_fill_tail(s)
        NodeKind.MatchExpr => match_arms_fill(s)
        NodeKind.WithBlock => body_fills(node_body(s))
        NodeKind.AsyncScope => body_fills(node_body(s))
        _ => true
    }
}

// ── If ────────────────────────────────────────────────────────────────────

// Both arms carry the tail mode, so an `if` in tail position returns or stores from
// inside each arm rather than producing a value the enclosing block would have to name.
fn lower_if(node: Int, tail: Int, dest: Str, dest_tid: Int) -> Int ! Diag.Report {
    let cond = lower_value(node_condition(node))
    let then_block = lower_body_block(node_then_body(node), tail, dest, dest_tid)
    if then_block < 0 { return -1 }
    let els = node_else_body(node)
    if els < 0 { return ir_if(node, cond, then_block, -1) }
    let else_block = lower_body_block(els, tail, dest, dest_tid)
    if else_block < 0 { return -1 }
    ir_if(node, cond, then_block, else_block)
}

// A body the AST may spell as a block or as a single expression. The IR wants a Block
// either way, so a bare expression gets one of its own.
fn lower_body_block(node: Int, tail: Int, dest: Str, dest_tid: Int) -> Int ! Diag.Report {
    if nk_of(node_kind(node)) == NodeKind.Block {
        return lower_tail_block_into(node, tail, dest, dest_tid)
    }
    let _ = open_scope()
    let mut out: List[Int] = []
    let ok = lower_stmt_hoisted(node, tail, dest, dest_tid, out)
    close_scope()
    if !ok { return -1 }
    ir_block(node, out)
}

// ── Loops ─────────────────────────────────────────────────────────────────

// A loop opened inside an assert_panics frame owns the break and continue in its body.
fn lower_loop_body(node: Int) -> Int ! Diag.Report {
    cg_expr_frame_loop_enter()
    let body = lower_block(node_body(node))
    cg_expr_frame_loop_exit()
    body
}

// `while c { b }` is `while (1) { if (!c) break; b }`. One loop form in the IR means the
// printer never has to decide where a continue lands.
fn lower_while(node: Int) -> Int ! Diag.Report {
    let cond_node = node_condition(node)
    let tid = stmt_tid(cond_node)
    if tid < 0 { return -1 }
    let rec = layout_at(tid, Position.Local, cond_node)
    // The test is read once per turn, and the guard the test becomes sits inside the loop.
    // A statement the test needed has no place above the loop: it would run once, and the
    // turns after the first would read a stale temp. The loop body already runs every turn,
    // so the statements land there, ahead of the guard that reads what they filled.
    let mark = cg_expr_pending_count()
    let tested = lower_value(cond_node)
    let hoisted = cg_expr_take_pending(mark)
    let cond = ir_binary(tid, cond_node, rec.c_spelling, "==",
        tested, ir_const(tid, cond_node, rec.c_spelling, "0"))
    let guard = ir_if(cond_node, cond, ir_block(cond_node, [ir_break(cond_node)]), -1)
    let body = lower_loop_body(node)
    if body < 0 { return -1 }
    let mut turn: List[Int] = hoisted
    turn.push(guard)
    turn.push(body)
    ir_loop(node, ir_block(node, turn))
}

// `loop { b }` is the bare form: the IR loop node with no guard of its own.
fn lower_loop(node: Int) -> Int ! Diag.Report {
    let body = lower_loop_body(node)
    if body < 0 { return -1 }
    ir_loop(node, body)
}

// ── For-in ────────────────────────────────────────────────────────────────

// `for i in a..b` is a counted loop, so it lowers with no help from the runtime. Every
// other iterable walks through the strategy cg_call's for_in_iteration_of answers --
// Indexed reads a container by position, Materialized reads one first into a List (or,
// for a Map, a pair of them) and then walks that by position, and Drained has no
// position at all, and Cursor pulls from a fresh cursor of an Iterator's recipe. The match is exhaustive, so a strategy added to ForInStrategy without
// an arm here fails to compile rather than falling through to a silent wrong walk.
fn lower_for_in(node: Int) -> Int ! Diag.Report {
    let iter = node_iterable(node)
    if nk_of(node_kind(iter)) == NodeKind.RangeLit { return lower_for_range(node, iter) }
    let container = tid_of_node(iter)
    if container < 0 { return ir_block(node, []) }
    let walk = for_in_iteration_of(container, node)
    // The producer reports the iterables it has no entry points for, and answers a shape
    // with no element. Reporting again here would name one gap twice.
    if walk.element_tid < 0 { return ir_block(node, []) }
    match walk.strategy {
        ForInStrategy.Indexed => lower_for_indexed(node, iter, walk)
        ForInStrategy.Materialized => lower_for_materialized(node, iter, walk)
        ForInStrategy.Drained => lower_for_drained(node, iter, walk)
        ForInStrategy.Cursor => lower_for_cursor(node, iter, walk)
    }
}

// Binds the loop variable(s) for one turn of a for-in, into `out` in loop-body order. A
// plain binder (`for x in xs`) binds `value` straight to its own name, the same one Let
// this built before every strategy shared this helper. A destructured binder
// (`for (k, v) in m`) binds `value` to a holder local first and reads each name off it
// through bind_tuple_pattern -- the same tuple-field-read machinery `let (a, b) = e`
// already binds through, so a for-in tuple binder is not a second way to destructure.
fn bind_for_element(node: Int, elem: Int, rec: LayoutRecord, value: Int, out: List[Int]) -> Bool ! Diag.Report {
    if node_elements(node) == -1 {
        let binder = node_for_binder(node)
        out.push(ir_let(elem, node, rec.c_spelling, cg_local_c_name(node_name(binder)), rec.slot_form, value))
        // A for-in binder has no `mut` form to write, so it is immutable as a matter of
        // syntax rather than of bookkeeping, and a closure in the body may copy it.
        bind_binder_mut(cur_scope(), node_name(binder), elem, false)
        return true
    }
    let holder = c_mint_local("elem")
    out.push(ir_let(elem, node, rec.c_spelling, holder, rec.slot_form, value))
    // A for-in binder has no `mut` form to write, tuple or otherwise.
    bind_tuple_pattern(node_elements(node), elem, holder, rec.c_spelling, rec.slot_form, out, false)
}

// `for x in xs { b }` becomes
//   L src = xs; int64_t n = blink_list_len(src); int64_t i = -1;
//   while (1) { i = i + 1; if (i >= n) break; E x = <element of src at i>; b }
// The container and its length are each read once, in front of the loop, so a body that
// appends to the list it walks cannot change how many turns run. The step is at the top,
// from -1, so a `continue` in the body cannot skip it and spin.
fn lower_for_indexed(node: Int, iter: Int, walk: ForInIteration) -> Int ! Diag.Report {
    let _ = open_scope()
    let elem = walk.element_tid
    let rec = layout_at(elem, Position.Local, node)
    let src_tid = tid_of_node(iter)
    if src_tid < 0 {
        close_scope()
        return -1
    }
    let src_rec = layout_at(src_tid, Position.Local, iter)
    let src = c_mint_local("iter")
    let src_let = ir_let(src_tid, node, src_rec.c_spelling, src, src_rec.slot_form, lower_value(iter))
    let len = c_mint_local("len")
    let len_let = ir_let(TYPE_INT, node, int_spelling(node), len, int_form(node),
        ir_call_runtime(TYPE_INT, node, int_spelling(node), walk.len_symbol, int_form(node),
            [container_ref(node, src_tid, src_rec, src)]))
    let idx = c_mint_local("idx")
    let idx_let = ir_let(TYPE_INT, node, int_spelling(node), idx, int_form(node), int_const(node, "-1"))
    let step = ir_assign(node, flag_ref(node, idx),
        ir_binary(TYPE_INT, node, int_spelling(node), "+", flag_ref(node, idx), int_const(node, "1")))
    let cond = ir_binary(TYPE_INT, node, int_spelling(node), ">=", flag_ref(node, idx), flag_ref(node, len))
    let guard = ir_if(node, cond, ir_block(node, [ir_break(node)]), -1)
    let read = cg_call_element_from_runtime(node, elem, walk.get_symbol,
        [container_ref(node, src_tid, src_rec, src), flag_ref(node, idx)])
    if read < 0 {
        close_scope()
        return -1
    }
    let mut binds: List[Int] = []
    if !bind_for_element(node, elem, rec, read, binds) {
        close_scope()
        return -1
    }
    let body = lower_loop_body(node)
    close_scope()
    if body < 0 { return -1 }
    let mut turn: List[Int] = [step, guard]
    let mut i = 0
    while i < binds.len() {
        turn.push(binds.get(i).unwrap())
        i = i + 1
    }
    turn.push(body)
    ir_block(node, [src_let, len_let, idx_let, ir_loop(node, ir_block(node, turn))])
}

// The pieces lower_for_materialized reads by position once the source is materialized: the
// keys list (always) and, for a Map, the parallel values list at the same positions, plus
// the index/length step and guard that walk both. Split out of lower_for_materialized so
// that function stays about the one turn's read, not this setup.
type MaterializedRead {
    pre: List[Int],
    keys_tid: Int,
    keys_rec: LayoutRecord,
    keys: Str,
    vals_tid: Int,
    vals_rec: LayoutRecord,
    vals: Str,
    idx: Str,
    step: Int,
    guard: Int,
}

fn lower_for_materialized_sources(node: Int, walk: ForInIteration, has_pair: Bool, key_tid: Int,
        val_tid: Int, src_tid: Int, src_rec: LayoutRecord, src: Str) -> MaterializedRead ! Diag.Report {
    let keys_tid = make_list_type(key_tid)
    let keys_rec = layout_at(keys_tid, Position.Local, node)
    let keys = c_mint_local("keys")
    let keys_let = ir_let(keys_tid, node, keys_rec.c_spelling, keys, keys_rec.slot_form,
        ir_call_runtime(keys_tid, node, keys_rec.c_spelling, walk.materialize_symbol, keys_rec.slot_form,
            [container_ref(node, src_tid, src_rec, src)]))
    let mut pre: List[Int] = [keys_let]
    let mut vals_tid = -1
    let mut vals = ""
    let mut vals_rec = keys_rec
    if has_pair {
        vals_tid = make_list_type(val_tid)
        vals_rec = layout_at(vals_tid, Position.Local, node)
        vals = c_mint_local("vals")
        pre.push(ir_let(vals_tid, node, vals_rec.c_spelling, vals, vals_rec.slot_form,
            ir_call_runtime(vals_tid, node, vals_rec.c_spelling, walk.pair_symbol, vals_rec.slot_form,
                [container_ref(node, src_tid, src_rec, src)])))
    }
    let len = c_mint_local("len")
    pre.push(ir_let(TYPE_INT, node, int_spelling(node), len, int_form(node),
        ir_call_runtime(TYPE_INT, node, int_spelling(node), walk.len_symbol, int_form(node),
            [container_ref(node, keys_tid, keys_rec, keys)])))
    let idx = c_mint_local("idx")
    pre.push(ir_let(TYPE_INT, node, int_spelling(node), idx, int_form(node), int_const(node, "-1")))
    let step = ir_assign(node, flag_ref(node, idx),
        ir_binary(TYPE_INT, node, int_spelling(node), "+", flag_ref(node, idx), int_const(node, "1")))
    let cond = ir_binary(TYPE_INT, node, int_spelling(node), ">=", flag_ref(node, idx), flag_ref(node, len))
    let guard = ir_if(node, cond, ir_block(node, [ir_break(node)]), -1)
    MaterializedRead { pre: pre, keys_tid: keys_tid, keys_rec: keys_rec, keys: keys,
        vals_tid: vals_tid, vals_rec: vals_rec, vals: vals, idx: idx, step: step, guard: guard }
}

// `for x in s { b }` / `for (k, v) in m { b }`: a Set or a Map has no by-position read of
// its own storage, so this reads it into one List first -- a Set's own elements at
// materialize_symbol, or a Map's keys there and its values at pair_symbol, at the same
// positions -- and then walks that/those exactly like lower_for_indexed walks a List,
// since list_len/list_get are what for_in_iteration_of already answers for a
// Materialized walk. A Map's element_tid is always the (K, V) pair tuple
// tc_tid_iter_elem gives it, so the pair is rebuilt at each turn from one read of each
// list before this hands the turn's value to bind_for_element.
fn lower_for_materialized(node: Int, iter: Int, walk: ForInIteration) -> Int ! Diag.Report {
    let _ = open_scope()
    let elem = walk.element_tid
    let has_pair = walk.pair_symbol != ""
    let key_tid = if has_pair { child_tid(elem, Slot.Elem(0)) } else { elem }
    let val_tid = if has_pair { child_tid(elem, Slot.Elem(1)) } else { -1 }
    if has_pair && (key_tid < 0 || val_tid < 0) {
        diag_ice_at("ForInPairElementMissing", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "this for-in's element tid has no (K, V) pair to read", node,
            "for_in_iteration_of only sets pair_symbol for a Map, whose element tid is always a two-element tuple")
        close_scope()
        return -1
    }
    let src_tid = tid_of_node(iter)
    if src_tid < 0 {
        close_scope()
        return -1
    }
    let src_rec = layout_at(src_tid, Position.Local, iter)
    let src = c_mint_local("iter")
    let src_let = ir_let(src_tid, node, src_rec.c_spelling, src, src_rec.slot_form, lower_value(iter))
    let m = lower_for_materialized_sources(node, walk, has_pair, key_tid, val_tid, src_tid, src_rec, src)
    let key_read = cg_call_element_from_runtime(node, key_tid, walk.get_symbol,
        [container_ref(node, m.keys_tid, m.keys_rec, m.keys), flag_ref(node, m.idx)])
    if key_read < 0 {
        close_scope()
        return -1
    }
    let mut value = key_read
    if has_pair {
        let val_read = cg_call_element_from_runtime(node, val_tid, walk.get_symbol,
            [container_ref(node, m.vals_tid, m.vals_rec, m.vals), flag_ref(node, m.idx)])
        if val_read < 0 {
            close_scope()
            return -1
        }
        let pair_rec = layout_at(elem, Position.Local, node)
        ensure_typedef_for(elem)
        value = ir_tuple_new(elem, node, pair_rec.c_spelling, [key_read, val_read])
    }
    let rec = layout_at(elem, Position.Local, node)
    let mut binds: List[Int] = []
    if !bind_for_element(node, elem, rec, value, binds) {
        close_scope()
        return -1
    }
    let body = lower_loop_body(node)
    close_scope()
    if body < 0 { return -1 }
    let mut turn: List[Int] = [m.step, m.guard]
    let mut i = 0
    while i < binds.len() {
        turn.push(binds.get(i).unwrap())
        i = i + 1
    }
    turn.push(body)
    let mut pre: List[Int] = [src_let]
    let mut j = 0
    while j < m.pre.len() {
        pre.push(m.pre.get(j).unwrap())
        j = j + 1
    }
    pre.push(ir_loop(node, ir_block(node, turn)))
    ir_block(node, pre)
}

// `for x in ch { b }`: a Channel has no length to ask for up front, so each turn takes one
// word and stops the moment it is NULL, the runtime's answer for closed and empty. The take,
// the test and the decode all come from cg_call, where send stores the slot, so the loop
// never reads a slot in a shape the store did not write.
fn lower_for_drained(node: Int, iter: Int, walk: ForInIteration) -> Int ! Diag.Report {
    let _ = open_scope()
    let elem = walk.element_tid
    let rec = layout_at(elem, Position.Local, node)
    let src_tid = tid_of_node(iter)
    if src_tid < 0 {
        close_scope()
        return -1
    }
    let src_rec = layout_at(src_tid, Position.Local, iter)
    let src = c_mint_local("iter")
    let src_let = ir_let(src_tid, node, src_rec.c_spelling, src, src_rec.slot_form, lower_value(iter))
    let t = cg_call_channel_take(node, elem, container_ref(node, src_tid, src_rec, src))
    if t.element < 0 {
        close_scope()
        return -1
    }
    let guard = ir_if(node, t.closed, ir_block(node, [ir_break(node)]), -1)
    let mut binds: List[Int] = []
    if !bind_for_element(node, elem, rec, t.element, binds) {
        close_scope()
        return -1
    }
    let body = lower_loop_body(node)
    close_scope()
    if body < 0 { return -1 }
    let mut turn: List[Int] = [t.take, guard]
    let mut i = 0
    while i < binds.len() {
        turn.push(binds.get(i).unwrap())
        i = i + 1
    }
    turn.push(body)
    ir_block(node, [src_let, ir_loop(node, ir_block(node, turn))])
}

// `for x in it { b }`: the recipe is called once for a cursor, and each turn pulls one
// Option from it and stops at None. The start, the pull and the read come from cg_call,
// which reads every other Option, so the loop never spells a carrier on its own.
fn lower_for_cursor(node: Int, iter: Int, walk: ForInIteration) -> Int ! Diag.Report {
    let _ = open_scope()
    let elem = walk.element_tid
    let rec = layout_at(elem, Position.Local, node)
    let src_tid = tid_of_node(iter)
    if src_tid < 0 {
        close_scope()
        return -1
    }
    let src_rec = layout_at(src_tid, Position.Local, iter)
    let src = c_mint_local("iter")
    let src_let = ir_let(src_tid, node, src_rec.c_spelling, src, src_rec.slot_form, lower_value(iter))
    let w = cg_call_cursor_walk(node, elem, container_ref(node, src_tid, src_rec, src))
    if w.element < 0 {
        close_scope()
        return -1
    }
    let guard = ir_if(node, w.closed, ir_block(node, [ir_break(node)]), -1)
    let mut binds: List[Int] = []
    if !bind_for_element(node, elem, rec, w.element, binds) {
        close_scope()
        return -1
    }
    let body = lower_loop_body(node)
    close_scope()
    if body < 0 { return -1 }
    let mut turn: List[Int] = [w.take, guard]
    let mut i = 0
    while i < binds.len() {
        turn.push(binds.get(i).unwrap())
        i = i + 1
    }
    turn.push(body)
    ir_block(node, [src_let, w.start, ir_loop(node, ir_block(node, turn))])
}

// A read of the local the container was copied into. Each read is a node of its own,
// because the verifier rejects one node reached from two places.
fn container_ref(span: Int, tid: Int, rec: LayoutRecord, name: Str) -> Int {
    ir_var_ref(tid, span, rec.c_spelling, name, rec.slot_form)
}

// `for i in lo..hi { b }` becomes
//   T i = lo; T end = hi; int first = 1;
//   while (1) { if (first) { first = 0; } else { i = i + 1; } if (i >= end) break; b }
// The step runs at the top of the loop, so a `continue` in the body cannot skip it, and
// the end of the range is read once rather than on every turn. An inclusive range
// compares with `>` so the last value runs.
fn lower_for_range(node: Int, iter: Int) -> Int ! Diag.Report {
    let _ = open_scope()
    let binder = node_for_binder(node)
    let tid = stmt_tid(binder)
    if tid < 0 {
        close_scope()
        return -1
    }
    let rec = layout_at(tid, Position.Local, binder)
    let name = cg_local_c_name(node_name(binder))
    let init = ir_let(tid, node, rec.c_spelling, name, rec.slot_form, lower_value(node_start(iter)))
    let end_name = c_mint_local("end")
    let end_let = ir_let(tid, iter, rec.c_spelling, end_name, rec.slot_form, lower_value(node_end(iter)))
    let first = c_mint_local("first")
    let first_let = ir_let(TYPE_INT, node, int_spelling(node), first, int_form(node), int_const(node, "1"))
    // A for-in binder has no `mut` form to write, so it is immutable as a matter of syntax.
    bind_binder_mut(cur_scope(), node_name(binder), tid, false)
    let step = ir_if(node, flag_ref(node, first),
        ir_block(node, [ir_assign(node, flag_ref(node, first), int_const(node, "0"))]),
        ir_block(node, [ir_assign(node, ir_var_ref(tid, node, rec.c_spelling, name, rec.slot_form),
            ir_binary(tid, node, rec.c_spelling, "+",
                ir_var_ref(tid, node, rec.c_spelling, name, rec.slot_form),
                ir_const(tid, node, rec.c_spelling, "1")))]))
    let stop = if node_inclusive(iter) == 1 { ">" } else { ">=" }
    let cond = ir_binary(TYPE_INT, iter, int_spelling(iter), stop,
        ir_var_ref(tid, iter, rec.c_spelling, name, rec.slot_form),
        ir_var_ref(tid, iter, rec.c_spelling, end_name, rec.slot_form))
    let guard = ir_if(iter, cond, ir_block(iter, [ir_break(iter)]), -1)
    let body = lower_loop_body(node)
    close_scope()
    if body < 0 { return -1 }
    ir_block(node, [init, end_let, first_let, ir_loop(node, ir_block(node, [step, guard, body]))])
}

// A read of a compiler-minted integer local: a range's first-turn flag, or a walk's index
// and length. Each read is a node of its own, because the verifier rejects one node
// reached from two places.
fn flag_ref(span: Int, name: Str) -> Int ! Diag.Report {
    ir_var_ref(TYPE_INT, span, int_spelling(span), name, int_form(span))
}

// ── With blocks ───────────────────────────────────────────────────────────

// A `with` binds one or more items around a body: `arena` for a fresh allocation arena, a
// block handler for enter and exit around the body, `expr as name` for a resource whose
// cleanup runs on every exit, and anything else for an effect handler. The items nest
// outside in, so the first item written is the outermost.
fn lower_with_block(node: Int, tail: Int, dest: Str, dest_tid: Int) -> Int ! Diag.Report {
    let items = node_handlers(node)
    let n = if items == -1 { 0 } else { sublist_length(items) }
    wrap_with_items(node, items, n, 0, tail, dest, dest_tid)
}

fn wrap_with_items(node: Int, items: Int, n: Int, i: Int, tail: Int, dest: Str, dest_tid: Int) -> Int ! Diag.Report {
    if i >= n { return lower_body_block(node_body(node), tail, dest, dest_tid) }
    let item = sublist_get(items, i)
    let kind = nk_of(node_kind(item))
    // A block handler is one with or without `as`, so the question is asked of the item's
    // expression before the binder decides between a resource and an effect handler.
    let expr = if kind == NodeKind.WithResource { node_value(item) } else { item }
    let bh = cg_eff_block_handler_impl(expr)
    if bh >= 0 { return wrap_block_handler(node, items, n, i, bh, tail, dest, dest_tid) }
    if kind == NodeKind.WithResource { return wrap_resource(node, items, n, i, tail, dest, dest_tid) }
    if kind == NodeKind.Ident && node_name(item) == ARENA_ITEM {
        return wrap_arena(node, items, n, i, tail, dest, dest_tid)
    }
    let rest = wrap_with_items(node, items, n, i + 1, tail, dest, dest_tid)
    if rest < 0 { return -1 }
    wrap_handler(item, as_block(rest))
}

// An arena frees its cells as the block closes, so a tail stored past the block is copied
// out first, inside the scope, while the arena is still live. A tail the function returns
// is copied where it returns (tail_wrap), and a discarded tail leaves nothing to copy.
fn wrap_arena(node: Int, items: Int, n: Int, i: Int, tail: Int, dest: Str, dest_tid: Int) -> Int ! Diag.Report {
    let item = sublist_get(items, i)
    cg_promote_arena_enter()
    let rest = wrap_with_items(node, items, n, i + 1, tail, dest, dest_tid)
    let mut stmts: List[Int] = [if rest < 0 { -1 } else { as_block(rest) }]
    let valued = rest >= 0 && tail == TAIL_ASSIGN && dest_tid >= 0
    if valued {
        let begin = cg_promote_trace_begin(cs_current_fn_name, item)
        if begin != -2 { stmts.push(begin) }
    }
    if valued && cg_promote_needs_walk(dest_tid) {
        let rec = layout_at(dest_tid, Position.Local, item)
        let held = ir_var_ref(dest_tid, item, rec.c_spelling, dest, rec.slot_form)
        let moved = cg_promote_value(dest_tid, held, cg_promote_innermost_ctx(item), item)
        stmts.push(if moved < 0 { -1 } else {
            ir_assign(item, ir_var_ref(dest_tid, item, rec.c_spelling, dest, rec.slot_form), moved)
        })
    }
    let target = cg_promote_arena_exit()
    for s in stmts { if s < 0 { return -1 } }
    // The body is already a block; a second block around it only when there is more to run.
    let scope_body = if stmts.len() == 1 { stmts.get(0).unwrap() } else { ir_block(item, stmts) }
    let scope = ir_arena_scope(item, target, scope_body)
    let end = if valued { cg_promote_trace_end(cs_current_fn_name, dest_tid, item) } else { -2 }
    if end == -2 { return scope }
    if end < 0 { return -1 }
    ir_block(item, [scope, end])
}

// A scope and a handler each carry their body as a block, so an item that wraps another
// item seals that item's tree in a block of its own.
fn as_block(id: Int) -> Int {
    if ir_kind(id) == IrKind.Block { return id }
    ir_block(ir_span(id), [id])
}

// The resource binds before the body is lowered, so the body reads it, and the resource
// expression is lowered before the bind, so it cannot read the name it is defining.
//
// Which cleanup a resource gets is a question about the traits its type implements:
// Closeable closes it, BlockHandler hands it the block, an FFI scope frees its arena and
// a type with none of those is a plain binding. cg_eff_resource_cleanup answers the
// question and hands back the exit symbol to run on the way out, so this stage tests for
// a symbol rather than for a protocol: every protocol that names one is wrapped the same
// way, and a protocol added later needs nothing here. BlockHandler names none, because its
// binder holds the Context that enter() answers rather than the resource; it records its
// own internal error and the bind underneath it is left exactly as plain as it always
// was.
fn wrap_resource(node: Int, items: Int, n: Int, i: Int, tail: Int, dest: Str, dest_tid: Int) -> Int ! Diag.Report {
    let item = sublist_get(items, i)
    let _ = open_scope()
    let tid = stmt_tid(item)
    if tid < 0 {
        close_scope()
        return -1
    }
    let rec = layout_at(tid, Position.Local, item)
    let _ = ensure_typedef_for(tid)
    let name = node_name(item)
    let value = lower_value(node_value(item))
    // A with-resource binder has no `mut` form to write, so it is immutable as a
    // matter of syntax, and a closure capturing one may copy it.
    bind_binder_mut(cur_scope(), name, tid, false)
    let bound_name = cg_local_c_name(name)
    let bind = ir_let(tid, item, rec.c_spelling, bound_name, rec.slot_form, value)
    let cleanup = cg_eff_resource_cleanup(item)
    let rest = wrap_with_items(node, items, n, i + 1, tail, dest, dest_tid)
    close_scope()
    if rest < 0 { return -1 }
    let rest_block = as_block(rest)
    if cleanup.exit_symbol != "" {
        let resource_ref = ir_var_ref(tid, item, rec.c_spelling, bound_name, rec.slot_form)
        let scoped = ir_with_scope(item, cleanup.exit_symbol, resource_ref, rest_block)
        return ir_block(item, [bind, scoped])
    }
    ir_block(item, [bind, rest_block])
}

// The handler is held in a hidden local, so enter and the guard's exit(ok) both read the
// one value the item built. The guard is armed only after enter returns, so an enter that
// never returns has no exit run for it.
fn wrap_block_handler(node: Int, items: Int, n: Int, i: Int, bh: Int, tail: Int, dest: Str, dest_tid: Int) -> Int ! Diag.Report {
    let item = sublist_get(items, i)
    let binds = nk_of(node_kind(item)) == NodeKind.WithResource
    let expr = if binds { node_value(item) } else { item }
    let tid = stmt_tid(expr)
    if tid < 0 { return -1 }
    let calls = cg_eff_block_handler_calls(bh, tid, item)
    if calls.impl_block < 0 { return -1 }
    let _ = ensure_typedef_for(tid)
    let value = lower_value(expr)
    if value < 0 { return -1 }
    let held = bind_temp("bh", tid, item, value)
    let enter = cg_eff_block_handler_enter(calls, held.ref, item)
    if enter < 0 { return -1 }
    // An enter returning Void gives an `as` binder nothing, and typecheck then types the
    // binder as the handler itself, so that is what it holds.
    let void_enter = tc_tid_kind(calls.context_tid) == TyKind.Void
    let mut stmts: List[Int] = [held.stmt]
    if !binds || void_enter { stmts.push(ir_expr_stmt(item, enter)) }
    let _ = open_scope()
    let bind = if !binds { 0 } else if void_enter { bind_context(item, held.ref) } else { bind_context(item, enter) }
    let rest = if bind < 0 { -1 } else { wrap_with_items(node, items, n, i + 1, tail, dest, dest_tid) }
    close_scope()
    if rest < 0 { return -1 }
    if binds { stmts.push(bind) }
    stmts.push(ir_with_scope(item, calls.exit_symbol, held.ref, as_block(rest)))
    ir_block(item, stmts)
}

// The binder's type is typecheck's answer and the value's is the handler's own, so a
// disagreement between them is reported rather than spelled one way or the other.
fn bind_context(item: Int, init: Int) -> Int ! Diag.Report {
    let tid = stmt_tid(item)
    if tid < 0 { return -1 }
    if tid != ir_tid(init) {
        diag_ice_at("BlockHandlerBinderType", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "the `as` binder is typed {tid} but the block handler gives it type {ir_tid(init)}", item,
            "typecheck types the binder as the Context enter returns; the two must agree")
        return -1
    }
    let rec = layout_at(tid, Position.Local, item)
    let _ = ensure_typedef_for(tid)
    let name = node_name(item)
    bind_binder_mut(cur_scope(), name, tid, false)
    ir_let(tid, item, rec.c_spelling, cg_local_c_name(name), rec.slot_form, init)
}

// A handler replaces one slot of the effect vector for the body. Which slot is a fact
// about the item's own type, not about its value, so cg_eff owns both the field lookup
// and the ICE a with-item that is not actually a handler must report -- this stage's own
// part is lowering the item to the value that goes in the slot.
fn wrap_handler(item: Int, inner: Int) -> Int ! Diag.Report {
    cg_eff_lower_handler_install(item, lower_value(item), inner)
}

// `assert_panics(matching: m) { body }` runs the body under a catch frame. The matcher
// is bound ahead of the frame, so a panic in it is not the one the frame waits for and
// the printer reads it twice without running it twice. The body's value is discarded.
fn lower_assert_panics(node: Int) -> Int ! Diag.Report {
    if node_line(node) <= 0 || node_col(node) <= 0 {
        diag_ice_at("AssertPanicsHasNoPosition", CODEGEN_STAGE_NOT_BUILT,
            "assert_panics has no source position to report its failure at", node,
            "the runtime records a line and a column as numbers; a synthesized assert_panics must copy a position")
        return -1
    }
    let str_rec = layout_at(TYPE_STR, Position.Local, node)
    let int_rec = layout_at(TYPE_INT, Position.Local, node)
    let mut out: List[Int] = []
    let mut matcher = -1
    let m = node_value(node)
    if m >= 0 {
        let value = lower_value(m)
        if value < 0 { return -1 }
        let name = c_mint_local("apm")
        out.push(ir_let(TYPE_STR, node, str_rec.c_spelling, name, str_rec.slot_form, value))
        matcher = ir_var_ref(TYPE_STR, node, str_rec.c_spelling, name, str_rec.slot_form)
    }
    let frame = c_mint_local("ap")
    cg_expr_frame_open(frame)
    let body = lower_body_block(node_body(node), TAIL_DISCARD, "", -1)
    cg_expr_frame_close()
    if body < 0 { return -1 }
    let file = ir_const(TYPE_STR, node, str_rec.c_spelling, c_string_literal(diag_file_for_node(node)))
    let line = ir_const(TYPE_INT, node, int_rec.c_spelling, "{node_line(node)}")
    let col = ir_const(TYPE_INT, node, int_rec.c_spelling, "{node_col(node)}")
    out.push(ir_panic_catch(node, frame, file, line, col, matcher, as_block(body)))
    ir_block(node, out)
}

// `async.scope { body }` opens a handle list before the body and drains it on every exit
// from the body, normal, early return, or panic, through the same resource guard a `with`
// resource gets. The open/close pair lets a nested `async.spawn` find its enclosing scope
// by name through cg_expr_async_scope_current.
fn lower_async_scope(node: Int, tail: Int, dest: Str, dest_tid: Int) -> Int ! Diag.Report {
    let spelling = async_scope_handles_spelling()
    let list_name = c_mint_local("ascope")
    let bind = ir_let(TYPE_INT, node, spelling, list_name, SlotForm.InlineWord,
        ir_call_runtime(TYPE_INT, node, spelling, c_runtime_helper("list_new"), SlotForm.InlineWord, []))
    cg_expr_async_scope_open(list_name)
    let body = lower_body_block(node_body(node), tail, dest, dest_tid)
    cg_expr_async_scope_close()
    if body < 0 { return -1 }
    let resource = ir_var_ref(TYPE_INT, node, spelling, list_name, SlotForm.InlineWord)
    let scoped = ir_with_scope(node, cg_eff_async_scope_exit_symbol(), resource, as_block(body))
    ir_block(node, [bind, scoped])
}

// ── Match ─────────────────────────────────────────────────────────────────

// What every arm of one match shares. The scrutinee is bound once, so each arm reads the
// same local, and the tail mode travels with it so an arm in tail position returns or
// stores from inside its own block.
type MatchCtx {
    tid: Int
    holder: Str
    rec: LayoutRecord
    tail: Int
    dest: Str
    dest_tid: Int
    // -1 for the bound scrutinee, read through `holder`; >= 0 for a nested nested-pattern
    // test, which reads this already-built value directly instead -- minting a Let for it
    // would run before the outer test that alone makes reading it safe.
    value: Int
}

fn lower_match(node: Int, tail: Int, dest: Str, dest_tid: Int) -> Int ! Diag.Report {
    let scrut = node_scrutinee(node)
    let stid = stmt_tid(scrut)
    if stid < 0 { return -1 }
    let rec = layout_at(stid, Position.Local, scrut)
    let _ = ensure_typedef_for(stid)
    let holder = c_mint_local("scrut")
    let ctx = MatchCtx { tid: stid, holder: holder, rec: rec, tail: tail, dest: dest, dest_tid: dest_tid, value: -1 }
    let arms = node_arms(node)
    let n = if arms == -1 { 0 } else { sublist_length(arms) }
    let mut out: List[Int] = [ir_let(stid, scrut, rec.c_spelling, holder, rec.slot_form, lower_value(scrut))]
    // The front end accepts some matches that are not exhaustive, and this proof is weaker
    // than a full one, so a match it cannot prove covered panics when no arm runs.
    let covered = arms_cover(arms, n, ctx)
    if arms_are_switchable(arms, n, ctx) {
        let sw = lower_match_switch(node, arms, n, ctx, covered)
        if sw < 0 { return -1 }
        out.push(sw)
    } else {
        if !lower_match_chain(node, arms, n, ctx, covered, out) { return -1 }
    }
    ir_block(node, out)
}

// Whether one arm is guaranteed to run. An unguarded arm that matches anything covers the
// match; short of that, the unguarded arms must name every variant the scrutinee has.
fn arms_cover(arms: Int, n: Int, ctx: MatchCtx) -> Bool ! Diag.Report {
    let mut pats: List[Int] = []
    let mut i = 0
    while i < n {
        let arm = sublist_get(arms, i)
        if node_guard(arm) < 0 { pats.push(node_pattern(arm)) }
        i = i + 1
    }
    patterns_cover(pats, ctx.tid)
}

// The proof arms_cover makes, generalised to a bare list of patterns against one tid so
// it can be asked again one level down, of the sub-patterns bucketed under one variant
// name (bucket_covers) or found at one shared refuting position across arms
// (projected_patterns_cover). The names are collected rather than counted, so a variant
// written twice counts once and this does not rest on another pass having rejected the
// repeat.
fn patterns_cover(pats: List[Int], tid: Int) -> Bool ! Diag.Report {
    let mut named: Map[Str, Int] = Map()
    let mut i = 0
    while i < pats.len() {
        let pat = pats.get(i).unwrap()
        if pattern_is_irrefutable(pat, tid) { return true }
        collect_labels(tid, pat, named)
        i = i + 1
    }
    let total = variant_count(tid)
    if total > 0 && named.len() >= total { return true }
    if bucket_covers(pats, tid, named) { return true }
    if list_lengths_cover(pats, tid) { return true }
    projected_patterns_cover(pats, tid)
}

// Every variant one arm names, when that arm reduces to nothing more than the tag
// comparison itself. An or-pattern names one per alternative, so an arm written `A | B`
// covers two. A variant multiple arms share by splitting its payload (`Ok(Some(x))` and
// `Ok(None)`) does not reduce this way and is left for bucket_covers, one level below.
fn collect_labels(tid: Int, raw: Int, named: Map[Str, Int]) ! Diag.Report {
    let pat = pattern_core(raw)
    if nk_of(node_kind(pat)) == NodeKind.OrPattern {
        let elems = node_elements(pat)
        if elems == -1 { return }
        let mut i = 0
        while i < sublist_length(elems) {
            collect_labels(tid, sublist_get(elems, i), named)
            i = i + 1
        }
        return
    }
    if !pattern_is_labelled(pat, tid) { return }
    if nk_of(node_kind(pat)) == NodeKind.IntPattern {
        named.insert(node_str_val(pat), 1)
        return
    }
    named.insert(pattern_variant_name(pat), 1)
}

// The variant name at the very top of a pattern, independent of whether its own payload
// still refuses -- unlike collect_labels/pattern_is_labelled, which only name a variant
// whose arm is nothing more than the tag comparison. "" when the pattern names none.
fn arm_top_variant(raw: Int, tid: Int) -> Str {
    let pat = pattern_core(raw)
    match nk_of(node_kind(pat)) {
        NodeKind.EnumPattern => pattern_variant_name(pat)
        NodeKind.IdentPattern => if is_variant_name(tid, node_name(pat)) { node_name(pat) } else { "" }
        NodeKind.StructPattern => if is_variant_name(tid, node_type_name(pat)) { node_type_name(pat) } else { "" }
        _ => ""
    }
}

// The one sub-pattern inside a variant pattern's payload, when it has exactly one payload
// slot (a carrier's, a transparent newtype's, or a user variant with one field) -- the
// same single slot payload_binds/payload_test read through. -1 for any other shape:
// nothing here decides how several fields would jointly bucket.
fn one_payload_sub(pat: Int) -> Int {
    let flds = node_fields(pat)
    if flds == -1 || sublist_length(flds) != 1 { return -1 }
    let f = sublist_get(flds, 0)
    // A bare struct-style pattern holds its fields the way the qualified one does.
    if node_int_val(pat) == 1 || nk_of(node_kind(pat)) == NodeKind.StructPattern {
        let sub = node_pattern(f)
        if sub >= 0 { return sub }
    }
    f
}

// A variant name several arms share by splitting its own payload (`Ok(Some(x))` and
// `Ok(None)`) is covered when those arms' own payload sub-patterns, taken together, cover
// the payload's type -- patterns_cover asked again, one level down. Only a single-slot
// payload is decomposed this way; a variant sharing a multi-field payload, or one whose
// slot carries no recorded type, proves nothing here.
fn bucket_covers(pats: List[Int], tid: Int, named: Map[Str, Int]) -> Bool ! Diag.Report {
    let total = variant_count(tid)
    if total <= 0 { return false }
    let mut seen: Map[Str, Int] = Map()
    let mut i = 0
    while i < pats.len() {
        let vname = arm_top_variant(pats.get(i).unwrap(), tid)
        if vname != "" && !named.contains_key(vname) { seen.insert(vname, 1) }
        i = i + 1
    }
    let vnames = seen.keys()
    let mut j = 0
    while j < vnames.len() {
        let vname = vnames.get(j).unwrap()
        let mut subs: List[Int] = []
        let mut sub_tid = -1
        let mut k = 0
        while k < pats.len() {
            let pat = pattern_core(pats.get(k).unwrap())
            if arm_top_variant(pat, tid) == vname {
                let sub = one_payload_sub(pat)
                if sub < 0 { return false }
                let stid = stmt_tid(sub)
                if stid < 0 || (sub_tid >= 0 && sub_tid != stid) { return false }
                sub_tid = stid
                subs.push(sub)
            }
            k = k + 1
        }
        if subs.len() == 0 || !patterns_cover(subs, sub_tid) { return false }
        named.insert(vname, 1)
        j = j + 1
    }
    named.len() >= total
}

// Arms that refuse at one labelled place, such as `(Ok(x), _)` at element 0, cover the
// match when their labels at one place reach its variant count. Other arms are left out:
// they still run in order, and leaving arms out never makes an uncovered match look covered.
fn projected_patterns_cover(pats: List[Int], tid: Int) -> Bool ! Diag.Report {
    let mut at_paths: List[Str] = []
    let mut at_tids: List[Int] = []
    let mut at_leaves: List[Int] = []
    let mut i = 0
    while i < pats.len() {
        let mut positions: List[Str] = []
        let mut tids: List[Int] = []
        let mut leaves: List[Int] = []
        let typed = refuting_positions(tid, "", pats.get(i).unwrap(), positions, tids, leaves)
        if typed && positions.len() == 1 {
            let ptid = tids.get(0).unwrap()
            let leaf = leaves.get(0).unwrap()
            if pattern_is_labelled(leaf, ptid) {
                at_paths.push(positions.get(0).unwrap())
                at_tids.push(ptid)
                at_leaves.push(leaf)
            }
        }
        i = i + 1
    }
    let mut j = 0
    while j < at_paths.len() {
        if path_labels_cover(at_paths, at_tids, at_leaves, j) { return true }
        j = j + 1
    }
    false
}

// Whether the labels every kept arm names at the place entry `first` refuses at reach
// that place's variant count.
fn path_labels_cover(paths: List[Str], tids: List[Int], leaves: List[Int], first: Int) -> Bool ! Diag.Report {
    let path = paths.get(first).unwrap()
    let ptid = tids.get(first).unwrap()
    let mut named: Map[Str, Int] = Map()
    let mut k = 0
    while k < paths.len() {
        if paths.get(k).unwrap() == path { collect_labels(ptid, leaves.get(k).unwrap(), named) }
        k = k + 1
    }
    let total = variant_count(ptid)
    total > 0 && named.len() >= total
}

// A list arm whose elements all match anything tests only the length: exactly n without
// a rest, n or more with one. The arms cover every list when each length below the
// shortest rest arm has an exact arm. An arm with an element that can refuse is left out.
fn list_lengths_cover(pats: List[Int], tid: Int) -> Bool ! Diag.Report {
    if tc_tid_kind(tid) != TyKind.List { return false }
    let mut exact: List[Int] = []
    let mut least_rest = -1
    let mut i = 0
    while i < pats.len() {
        let pat = pattern_core(pats.get(i).unwrap())
        let elems = node_elements(pat)
        if nk_of(node_kind(pat)) == NodeKind.ListPattern && elements_are_irrefutable(elems) {
            let n = if elems == -1 { 0 } else { sublist_length(elems) }
            if node_inclusive(pat) != 1 {
                exact.push(n)
            } else if least_rest < 0 || n < least_rest {
                least_rest = n
            }
        }
        i = i + 1
    }
    if least_rest < 0 { return false }
    let mut len = 0
    while len < least_rest {
        if !exact.contains(len) { return false }
        len = len + 1
    }
    true
}

// Every position one arm's pattern refuses at, named by a '.'-joined path of element
// indices and field names from the arm's own top-level pattern. A plain tuple or a
// plain (non-variant) struct is decomposed position by position; a variant pattern,
// bare or struct-style, is one leaf position and is not decomposed further -- exhausting
// its own payload is a separate question from exhausting the position it sits in.
// False only when a part has no recorded type.
fn refuting_positions(tid: Int, path: Str, raw: Int, paths: List[Str], tids: List[Int], leaves: List[Int]) -> Bool ! Diag.Report {
    let pat = pattern_core(raw)
    if pattern_is_irrefutable(pat, tid) { return true }
    let kind = nk_of(node_kind(pat))
    if kind == NodeKind.TuplePattern {
        let elems = node_elements(pat)
        if elems == -1 { return true }
        let mut i = 0
        while i < sublist_length(elems) {
            let sub = sublist_get(elems, i)
            let stid = stmt_tid(sub)
            if stid < 0 { return false }
            if !refuting_positions(stid, "{path}.{i}", sub, paths, tids, leaves) { return false }
            i = i + 1
        }
        return true
    }
    if kind == NodeKind.StructPattern && !is_variant_name(tid, node_type_name(pat)) {
        let flds = node_fields(pat)
        if flds == -1 { return true }
        let mut i = 0
        while i < sublist_length(flds) {
            let f = sublist_get(flds, i)
            let sub = node_pattern(f)
            if sub >= 0 {
                let stid = stmt_tid(sub)
                if stid < 0 { return false }
                if !refuting_positions(stid, "{path}.{node_name(f)}", sub, paths, tids, leaves) { return false }
            }
            i = i + 1
        }
        return true
    }
    paths.push(path)
    tids.push(tid)
    leaves.push(pat)
    true
}

// How many variants the scrutinee's type has, or 0 when naming variants cannot exhaust
// it. A carrier has its two arms, a boolean its two values, an enum the ones its
// declaration lists.
fn variant_count(tid: Int) -> Int {
    if tid_is_carrier(tid) { return 2 }
    if tc_tid_kind(tid) == TyKind.Bool { return 2 }
    if tc_tid_kind(tid) != TyKind.Enum { return 0 }
    let td = c_decl_for_tid(tid)
    if td < 0 { return 0 }
    let flds = node_fields(td)
    if flds == -1 { return 0 }
    let mut n = 0
    let mut i = 0
    while i < sublist_length(flds) {
        if nk_of(node_kind(sublist_get(flds, i))) == NodeKind.TypeVariant { n = n + 1 }
        i = i + 1
    }
    n
}

// A value scrut_ref hands out is read from more than one place once a nested test goes
// deep enough: a refutable enum payload reads it once for its own tag and again for its
// own payload, and a struct or tuple payload reads it once per field or element. Every
// one of these is a pure read with no effect of its own beyond the kids it is built
// from, so the fix is to hand each caller its own copy rather than the same node twice
// -- a copy is exactly the same value, and unlike the original it has only the one
// parent the verifier already expects a plain read to have.
fn dup_readable(id: Int) -> Bool {
    let kind = ir_kind(id)
    if kind == IrKind.CallRuntime { return ir_c_name(id) == list_get_symbol() }
    kind == IrKind.VarRef || kind == IrKind.GlobalRef || kind == IrKind.FieldGet ||
        kind == IrKind.Cast || kind == IrKind.CarrierUnwrap || kind == IrKind.Unbox ||
        kind == IrKind.Const
}

// Most runtime calls have effects (a push, a channel op, an allocation), so only the list
// slot read is copied: it reads one slot and changes nothing, which a list pattern's
// element test relies on when a refutable element reads its value twice.
fn list_get_symbol() -> Str { c_runtime_helper("list_get") }

fn dup_value(id: Int) -> Int {
    if !dup_readable(id) { return id }
    let mut kids: List[Int] = []
    let mut i = 0
    while i < ir_kid_count(id) {
        kids.push(dup_value(ir_kid(id, i)))
        i = i + 1
    }
    ir_new(ir_kind(id), ir_tid(id), ir_span(id), ir_c_spelling(id), ir_c_name(id), ir_slot_form(id), kids)
}

fn scrut_ref(ctx: MatchCtx, span: Int) -> Int {
    if ctx.value >= 0 { return dup_value(ctx.value) }
    ir_var_ref(ctx.tid, span, ctx.rec.c_spelling, ctx.holder, ctx.rec.slot_form)
}

fn int_spelling(span: Int) -> Str ! Diag.Report {
    layout_at(TYPE_INT, Position.Local, span).c_spelling
}

fn int_const(span: Int, literal: Str) -> Int ! Diag.Report {
    ir_const(TYPE_INT, span, int_spelling(span), literal)
}

// The value an arm label is compared against: an integer scrutinee compares with itself,
// a carrier or enum with a tag member compares with that member, and a payload-less enum
// -- one machine word with no member beside it -- compares with itself the same way an
// integer does.
fn discriminant(ctx: MatchCtx, span: Int) -> Int ! Diag.Report {
    if tid_is_ordinal(ctx.tid) { return scrut_ref(ctx, span) }
    if tid_holds_tag_member(ctx.tid) {
        return ir_carrier_tag(TYPE_INT, span, int_spelling(span), scrut_ref(ctx, span))
    }
    // The Option over an opaque handle is the handle itself, NULL for None, so its
    // nullness is its discriminant: 1 for Some and 0 for None, as a real tag would be.
    if is_handle_option(ctx) {
        return ir_binary(TYPE_INT, span, int_spelling(span), "!=", scrut_ref(ctx, span),
            ir_const(ctx.tid, span, ctx.rec.c_spelling, "0"))
    }
    // A transparent newtype is one word too, but the word is its payload and it has one
    // variant, so it is never matched by tag and stays refused here.
    if tid_is_tagged(ctx.tid) && tc_tid_kind(ctx.tid) == TyKind.Enum && !tc_enum_has_payload(ctx.tid) {
        return scrut_ref(ctx, span)
    }
    diag_ice_stage_not_built("a match that compares a value holding no discriminant", span)
    int_const(span, "0")
}

// A value one tag read tells apart: a carrier or a user enum. A struct, a tuple, a string
// and a float all hold no such member, so no arm of theirs is one equality.
fn tid_is_tagged(tid: Int) -> Bool {
    tid_is_carrier(tid) || tc_tid_kind(tid) == TyKind.Enum
}

// Whether `discriminant` below can actually produce a value for this scrutinee. This must name
// exactly the same four cases that function does: naming only the type's kind here (as
// `tid_is_tagged` does) would call a tid switchable that `discriminant` then refuses --
// a single-variant type with a real payload is an Enum by kind and one undecorated word by
// shape, so it carries no tag member and is never payload-less either.
fn is_discriminable(ctx: MatchCtx) -> Bool {
    let tid = ctx.tid
    tid_is_ordinal(tid) || tid_holds_tag_member(tid) || is_handle_option(ctx) ||
        (tc_tid_kind(tid) == TyKind.Enum && !tc_enum_has_payload(tid))
}

fn tid_is_ordinal(tid: Int) -> Bool {
    match tc_tid_kind(tid) {
        TyKind.Int => true
        TyKind.I8 => true
        TyKind.I16 => true
        TyKind.I32 => true
        TyKind.U8 => true
        TyKind.U16 => true
        TyKind.U32 => true
        TyKind.U64 => true
        TyKind.Char => true
        TyKind.Bool => true
        _ => false
    }
}

fn tid_is_carrier(tid: Int) -> Bool {
    let k = tc_tid_kind(tid)
    k == TyKind.Option || k == TyKind.Result
}

// A carrier layout makes one word only of the Option over an opaque handle: the handle
// itself, NULL for None, with no tag or value member. ctx.rec is the scrutinee's checked
// Local layout, so this asks layout the same question cg_expr's carrier readers ask.
fn is_handle_option(ctx: MatchCtx) -> Bool {
    tid_is_carrier(ctx.tid) && ctx.rec.slot_form == SlotForm.InlineWord
}

// ── Patterns: names and labels ────────────────────────────────────────────

// The variant a pattern names. A qualified pattern carries the enum in `name` and the
// variant in `type_name`; a bare one carries only the variant.
fn pattern_variant_name(pat: Int) -> Str {
    let qualified = node_type_name(pat)
    if qualified != "" { return qualified }
    node_name(pat)
}

// Whether a bare identifier in pattern position names a variant of the scrutinee rather
// than a new binder. The scrutinee's type decides; the spelling alone never does.
fn is_variant_name(tid: Int, name: Str) -> Bool {
    if tid_is_carrier(tid) {
        return name == VARIANT_SOME || name == VARIANT_NONE || name == VARIANT_OK || name == VARIANT_ERR
    }
    if tc_tid_kind(tid) != TyKind.Enum { return false }
    find_variant(c_decl_for_tid(tid), name) >= 0
}

// A tuple's members are positional: element i is the member the type's emitter laid out
// under that position. One spelling, so the three readers below cannot drift apart.
fn tuple_member(i: Int) -> Str { c_tuple_member(i) }

fn find_variant(td: Int, name: Str) -> Int {
    if td < 0 { return -1 }
    let flds = node_fields(td)
    if flds == -1 { return -1 }
    let mut i = 0
    while i < sublist_length(flds) {
        let v = sublist_get(flds, i)
        if nk_of(node_kind(v)) == NodeKind.TypeVariant && node_name(v) == name { return v }
        i = i + 1
    }
    -1
}

// The constant an arm's variant compares against. A carrier's numbers are fixed by the
// runtime header; an enum's come from the tag macro the type's own emitter defines.
fn variant_label(ctx: MatchCtx, pat: Int, vname: Str) -> Int ! Diag.Report {
    let k = tc_tid_kind(ctx.tid)
    if k == TyKind.Option {
        if vname == VARIANT_SOME { return int_const(pat, "{TAG_SOME}") }
        if vname == VARIANT_NONE { return int_const(pat, "{TAG_NONE}") }
        return unknown_variant(ctx, pat, vname)
    }
    if k == TyKind.Result {
        if vname == VARIANT_OK { return int_const(pat, "{TAG_OK}") }
        if vname == VARIANT_ERR { return int_const(pat, "{TAG_ERR}") }
        return unknown_variant(ctx, pat, vname)
    }
    let v = find_variant(c_decl_for_tid(ctx.tid), vname)
    if v < 0 { return unknown_variant(ctx, pat, vname) }
    let macro = c_variant_discriminant(ctx.tid, v)
    if diag_is_ice_seg(macro) {
        diag_ice_at("UnnameableVariantTag", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "variant {vname} of type {ctx.tid} has no spellable tag", pat,
            "an enum must be fully solved before its tags are spelled")
        return int_const(pat, "0")
    }
    int_const(pat, macro)
}

// A variant a pattern names that the scrutinee's type does not have. Codegen never
// decides which arm that is, so it reports and poisons the label.
fn unknown_variant(ctx: MatchCtx, pat: Int, vname: Str) -> Int ! Diag.Report {
    diag_ice_at("UnknownVariant", UNSOLVED_TYPEVAR_AT_CODEGEN,
        "type {ctx.tid} has no variant {vname}", pat,
        "a pattern is checked against its scrutinee's type before codegen runs")
    int_const(pat, "0")
}

// A pattern that matches whatever it is given: the fallthrough arm of a switch. A tuple
// or a struct pattern matches anything only when every part of it does, so `(1, y)` is
// refutable even though its shape always fits.
fn pattern_is_irrefutable(pat: Int, tid: Int) -> Bool ! Diag.Report {
    match nk_of(node_kind(pat)) {
        NodeKind.WildcardPattern => true
        NodeKind.IdentPattern => !is_variant_name(tid, node_name(pat))
        NodeKind.TuplePattern => elements_are_irrefutable(node_elements(pat))
        NodeKind.StructPattern => struct_pattern_is_irrefutable(pat, tid)
        NodeKind.AsPattern => pattern_is_irrefutable(node_pattern(pat), tid)
        // A variant pattern refuses only by naming a variant the value might not hold, or
        // by a payload that itself refuses. A type with one variant has no other tag to
        // miss, so the variant name never refuses; only its payload still can.
        NodeKind.EnumPattern => variant_count(tid) == 1 && payload_is_irrefutable(pat)
        _ => false
    }
}

// A StructPattern node is StructPattern-shaped whether it names a real struct or a bare
// (unqualified) variant of the scrutinee's enum (see struct_pattern_binds above); only
// type information at codegen time tells the two apart. When it names a variant it
// refuses on the same terms as the qualified EnumPattern form above: a type with one
// variant has no other tag to miss, so only its own field sub-patterns can still refuse.
// A genuine struct pattern always matches once its own field sub-patterns do.
fn struct_pattern_is_irrefutable(pat: Int, tid: Int) -> Bool ! Diag.Report {
    let sname = node_type_name(pat)
    if is_variant_name(tid, sname) {
        return variant_count(tid) == 1 && fields_are_irrefutable(node_fields(pat))
    }
    fields_are_irrefutable(node_fields(pat))
}

// A part of a pattern decides on its own recorded type, because whether a bare name
// there binds or names a variant depends on what that part is matched against.
fn sub_is_irrefutable(sub: Int) -> Bool ! Diag.Report {
    if nk_of(node_kind(sub)) == NodeKind.WildcardPattern { return true }
    pattern_is_irrefutable(sub, stmt_tid(sub))
}

fn elements_are_irrefutable(elems: Int) -> Bool ! Diag.Report {
    if elems == -1 { return true }
    let mut i = 0
    while i < sublist_length(elems) {
        if !sub_is_irrefutable(sublist_get(elems, i)) { return false }
        i = i + 1
    }
    true
}

// A field written as `x` alone binds a fresh name and matches anything; only a field
// written as `x: p` carries a sub-pattern that can refuse.
fn fields_are_irrefutable(flds: Int) -> Bool ! Diag.Report {
    if flds == -1 { return true }
    let mut i = 0
    while i < sublist_length(flds) {
        let sub = node_pattern(sublist_get(flds, i))
        if sub >= 0 && !sub_is_irrefutable(sub) { return false }
        i = i + 1
    }
    true
}

// A pattern whose whole cond is one equality against a constant, which is what a switch
// can carry. Everything else needs an `if` chain.
fn pattern_core(pat: Int) -> Int {
    if nk_of(node_kind(pat)) == NodeKind.AsPattern { return node_pattern(pat) }
    pat
}

fn pattern_is_labelled(raw: Int, tid: Int) -> Bool ! Diag.Report {
    let pat = pattern_core(raw)
    match nk_of(node_kind(pat)) {
        NodeKind.IntPattern => tid_is_ordinal(tid)
        NodeKind.EnumPattern => payload_is_irrefutable(pat)
        NodeKind.IdentPattern => is_variant_name(tid, node_name(pat))
        // A bare struct-style variant pattern reduces to one tag comparison exactly when
        // the qualified spelling would: it names a variant, and its own field
        // sub-patterns never refuse (any that could, made the whole arm need more than a
        // label, and fall through to the `if` chain below instead).
        NodeKind.StructPattern => is_variant_name(tid, node_type_name(pat)) && fields_are_irrefutable(node_fields(pat))
        _ => false
    }
}

// Whether the payload of a variant pattern accepts every value the variant can hold. When
// it does not, the arm is more than one tag comparison, so it is neither a switch label
// nor proof that the variant is covered.
fn payload_is_irrefutable(pat: Int) -> Bool ! Diag.Report {
    let flds = node_fields(pat)
    if flds == -1 { return true }
    if node_int_val(pat) == 1 { return fields_are_irrefutable(flds) }
    elements_are_irrefutable(flds)
}

fn pattern_label(ctx: MatchCtx, raw: Int) -> Int ! Diag.Report {
    let pat = pattern_core(raw)
    if nk_of(node_kind(pat)) == NodeKind.IntPattern {
        return ir_const(ctx.tid, pat, ctx.rec.c_spelling, node_str_val(pat))
    }
    variant_label(ctx, pat, pattern_variant_name(pat))
}

// ── Patterns: binders ─────────────────────────────────────────────────────

// Every name a pattern introduces becomes one Let at the top of the arm's block, read
// from the scrutinee local. A binder's type is the one recorded for the pattern node,
// never one derived from the shape around it.
// Answers false when a part of the pattern has no recorded type. A pattern binds all of
// its names or none of them: one name left out resolves to an outer declaration of the
// same name, and the arm then reads that declaration's type as if it were the right one.
fn pattern_binds(ctx: MatchCtx, pat: Int, out: List[Int]) -> Bool ! Diag.Report {
    match nk_of(node_kind(pat)) {
        NodeKind.IdentPattern => {
            bind_whole(ctx, pat, out)
            true
        }
        NodeKind.AsPattern => {
            bind_whole(ctx, pat, out)
            pattern_binds(ctx, node_pattern(pat), out)
        }
        NodeKind.EnumPattern => payload_binds(ctx, pat, out)
        NodeKind.TuplePattern => tuple_pattern_binds(ctx, pat, out)
        NodeKind.StructPattern => struct_pattern_binds(ctx, pat, out)
        NodeKind.ListPattern => list_pattern_binds(ctx, pat, out)
        _ => true
    }
}

// A StructPattern's own type_name may in fact be a bare (unqualified) variant name: the
// parser cannot tell `NotFound { msg }` from a real struct pattern without type
// information, so both share this node kind — only the qualified `Type.Variant { .. }`
// form parses as EnumPattern (see the struct-style arm of payload_binds below). When it
// does name a variant of the scrutinee, its fields still read through that variant's own
// union member, the same prefix payload_binds' struct-style arm builds for the qualified
// spelling; a plain struct has no such member and reads its fields off the scrutinee
// itself.
fn struct_pattern_binds(ctx: MatchCtx, pat: Int, out: List[Int]) -> Bool ! Diag.Report {
    let sname = node_type_name(pat)
    if is_variant_name(ctx.tid, sname) {
        return field_pattern_binds(ctx, pat, "{c_enum_payload_member()}.{sname}", out)
    }
    field_pattern_binds(ctx, pat, "", out)
}

fn bind_whole(ctx: MatchCtx, pat: Int, out: List[Int]) ! Diag.Report {
    let name = node_name(pat)
    if name == "" || is_variant_name(ctx.tid, name) { return }
    // A match binder has no `mut` form to write, so it is immutable as a matter of
    // syntax, and a closure capturing one may copy it.
    bind_binder_mut(cur_scope(), name, ctx.tid, false)
    out.push(ir_let(ctx.tid, pat, ctx.rec.c_spelling, cg_local_c_name(name), ctx.rec.slot_form,
        scrut_ref(ctx, pat)))
}

// A part of a pattern needs a recorded type only when it declares a name. A literal or a
// wildcard part binds nothing, so no later read of it can resolve to the wrong
// declaration: `(1, y)` carries no type on its `1` and never wanted one. A nested shape
// that the payload binder does not lower yet is reported by the binder and binds nothing
// either, so it does not need one before that report.
fn sub_pattern_declares(sub: Int) -> Bool {
    nk_of(node_kind(sub)) == NodeKind.IdentPattern
}

// One payload slot of a variant, bound from the value the reader hands back. A plain
// name binds directly, the same as ever; a compound sub-pattern (itself a nested variant,
// tuple, or struct) first mints a local to hold this slot's own value, then binds the
// rest of it by recursing into pattern_binds the same way the top-level scrutinee is
// bound, so every existing binder for every pattern shape works one level deeper too. A
// slot with no type at all stops the arm instead.
fn bind_slot(ctx: MatchCtx, sub: Int, value: Int, out: List[Int]) -> Bool ! Diag.Report {
    let kind = nk_of(node_kind(sub))
    if kind == NodeKind.WildcardPattern { return true }
    let tid = stmt_tid(sub)
    if tid < 0 { return false }
    if kind == NodeKind.IdentPattern {
        // A bare variant name in binder position (`Ok(None)`'s inner `None`) names
        // nothing to bind.
        if is_variant_name(tid, node_name(sub)) { return true }
        bind_named(sub, node_name(sub), tid, layout_at(tid, Position.Local, sub), value, out)
        return true
    }
    let rec = layout_at(tid, Position.Local, sub)
    let name = c_mint_local("nest")
    out.push(ir_let(tid, sub, rec.c_spelling, name, rec.slot_form, value))
    let nested = MatchCtx { tid: tid, holder: name, rec: rec, tail: ctx.tail, dest: ctx.dest, dest_tid: ctx.dest_tid, value: -1 }
    pattern_binds(nested, sub, out)
}

// One name, declared and bound to a value read out of the scrutinee.
fn bind_named(span: Int, name: Str, tid: Int, rec: LayoutRecord, value: Int, out: List[Int]) ! Diag.Report {
    let _ = ensure_typedef_for(tid)
    // A payload/field binder has no `mut` form to write, so it is immutable as a
    // matter of syntax, and a closure capturing one may copy it.
    bind_binder_mut(cur_scope(), name, tid, false)
    out.push(ir_let(tid, span, rec.c_spelling, cg_local_c_name(name), rec.slot_form, value))
}

// A carrier keeps its payload in a named member; a user enum keeps its in the union arm
// that carries the variant's own name.
fn payload_binds(ctx: MatchCtx, pat: Int, out: List[Int]) -> Bool ! Diag.Report {
    let flds = node_fields(pat)
    if flds == -1 || sublist_length(flds) == 0 { return true }
    let vname = pattern_variant_name(pat)
    if tid_is_carrier(ctx.tid) { return carrier_payload_bind(ctx, vname, flds, out) }
    if ctx.rec.is_transparent != 0 { return newtype_payload_bind(ctx, flds, out) }
    if node_int_val(pat) == 1 { return field_pattern_binds(ctx, pat, "{c_enum_payload_member()}.{vname}", out) }
    positional_payload_binds(ctx, pat, vname, flds, out)
}

// A transparent newtype's one field is the whole word the scrutinee already is, so the
// payload read is that same word cast to the field's own type rather than a member of a
// `.data` union no transparent newtype's C shape has.
fn newtype_payload_bind(ctx: MatchCtx, flds: Int, out: List[Int]) -> Bool ! Diag.Report {
    let sub = sublist_get(flds, 0)
    let tid = stmt_tid(sub)
    if tid < 0 { return !sub_pattern_declares(sub) }
    let rec = layout_at(tid, Position.Local, sub)
    bind_slot(ctx, sub, ir_cast(tid, sub, rec.c_spelling, scrut_ref(ctx, sub)), out)
}

// The binder's own Local layout (`held`) says what the `Let` declares; the carrier's
// member layout (`member`) says what the carrier actually stores there. They agree
// whenever the payload is word-sized, and disagree whenever layout boxed the member --
// x_unbox_payload is the shared tail every other carrier reader uses to reconcile the two,
// unwrapping through the pointer when `member.slot_form` says PointerBoxed.
fn carrier_payload_bind(ctx: MatchCtx, vname: Str, flds: Int, out: List[Int]) -> Bool ! Diag.Report {
    let sub = sublist_get(flds, 0)
    let tid = stmt_tid(sub)
    if tid < 0 { return !sub_pattern_declares(sub) }
    let held = layout_at(tid, Position.Local, sub)
    bind_slot(ctx, sub, carrier_payload_value(ctx, vname, sub, tid, held), out)
}

// The payload an arm reads out of its carrier. The handle Option's Some payload is the
// scrutinee word itself, the same way a transparent newtype's is.
fn carrier_payload_value(ctx: MatchCtx, vname: Str, sub: Int, tid: Int, held: LayoutRecord) -> Int ! Diag.Report {
    if is_handle_option(ctx) { return ir_cast(tid, sub, held.c_spelling, scrut_ref(ctx, sub)) }
    let member = carrier_member_layout_at(ctx.tid, carrier_slot(vname), sub)
    x_unbox_payload(tid, sub, scrut_ref(ctx, sub), member, held, carrier_member(vname))
}

fn carrier_member(vname: Str) -> Str {
    if vname == VARIANT_OK { return CARRIER_OK }
    if vname == VARIANT_ERR { return CARRIER_ERR }
    STMT_CARRIER_VALUE
}

// Option has one payload slot; a Result's Ok arm shares that same slot and its Err arm
// takes the other, the same split cg_call.bl's cc_read_slot makes for a carrier read.
fn carrier_slot(vname: Str) -> Slot {
    if vname == VARIANT_ERR { return Slot.Inner2 }
    Slot.Inner1
}

fn carrier_member_layout_at(carrier_tid: Int, slot: Slot, node: Int) -> LayoutRecord ! Diag.Report {
    x_layout_checked(carrier_member_layout(carrier_tid, slot), node, "LayoutDeclined",
        "carrier {carrier_tid} has no such member", "layout answers every carrier member codegen reads; this is a compiler bug")
}

// The member name comes from the declaration's own field node, named or synthesized,
// because that is what the type's emitter laid out.
fn positional_payload_binds(ctx: MatchCtx, pat: Int, vname: Str, flds: Int, out: List[Int]) -> Bool ! Diag.Report {
    let vnode = find_variant(c_decl_for_tid(ctx.tid), vname)
    if vnode < 0 {
        let _ = unknown_variant(ctx, pat, vname)
        return false
    }
    let decl_flds = node_fields(vnode)
    let mut i = 0
    while i < sublist_length(flds) {
        let sub = sublist_get(flds, i)
        let tid = stmt_tid(sub)
        if tid < 0 {
            if sub_pattern_declares(sub) { return false }
        } else {
            if decl_flds == -1 || i >= sublist_length(decl_flds) {
                return payload_field_count_mismatch(sub, ctx.tid, vname)
            }
            let member = c_field_name(node_name(sublist_get(decl_flds, i)))
            let held = layout_at(tid, Position.Local, sub)
            let path = "{c_enum_payload_member()}.{vname}.{member}"
            let read = variant_field_read(ctx, sub, tid, path, held)
            if !bind_slot(ctx, sub, read, out) { return false }
        }
        i = i + 1
    }
    true
}

// A field's own C shape (`held`, what its `Let` declares) and what the field's owner
// actually stores for it (`field_layout_of`) agree unless the field reaches its own
// owner by value -- a self-recursive field -- in which case the owner boxes it, the
// same way a carrier's boxed payload does. The read must then deref through that box,
// the shared reconciliation x_unbox_payload makes for a carrier, built here for
// ir_field_get's dotted-path reads instead of a carrier's named arm.
fn variant_field_read(ctx: MatchCtx, node: Int, tid: Int, path: Str, held: LayoutRecord) -> Int ! Diag.Report {
    let member = field_layout_of(ctx.tid, tid)
    let read = ir_field_get(tid, node, member.c_spelling, path, member.slot_form, scrut_ref(ctx, node))
    if member.slot_form != SlotForm.PointerBoxed { return read }
    // The owner stores this field as a bare word (its C spelling is the scalar, not a
    // pointer type), the same way a container slot stores a boxed element: the box is
    // read back by casting the word to a pointer before the deref, not by the word's own
    // declared type, which names what is pointed at rather than the pointer itself.
    let ptr = ir_cast(tid, node, pointer_spelling(held.c_spelling), read)
    ir_unbox(tid, node, held.c_spelling, held.slot_form, ptr)
}

// A pattern names more positional slots than the variant declares fields for. Typecheck
// checks a pattern's arity against its variant's before codegen runs.
fn payload_field_count_mismatch(pat: Int, tid: Int, vname: Str) -> Bool ! Diag.Report {
    diag_ice_at("PayloadFieldCountMismatch", UNSOLVED_TYPEVAR_AT_CODEGEN,
        "variant {vname} of type {tid} has fewer fields than this pattern names", pat,
        "a pattern's arity is checked against its variant's before codegen runs")
    false
}

// Struct-shaped fields, either of a struct pattern (no prefix) or of a struct-shaped
// variant payload (the union arm is the prefix).
fn field_pattern_binds(ctx: MatchCtx, pat: Int, prefix: Str, out: List[Int]) -> Bool ! Diag.Report {
    let flds = node_fields(pat)
    if flds == -1 { return true }
    let mut i = 0
    while i < sublist_length(flds) {
        let f = sublist_get(flds, i)
        // A field written as `x` is its own binder; only `x: p` carries a sub-pattern.
        let sub = node_pattern(f)
        let holder = if sub < 0 { f } else { sub }
        let tid = stmt_tid(holder)
        // A shorthand field is a binder itself, so it always wants a type.
        if tid < 0 {
            if sub < 0 || sub_pattern_declares(sub) { return false }
        } else {
            let held = layout_at(tid, Position.Local, holder)
            let path = if prefix == "" { node_name(f) } else { "{prefix}.{node_name(f)}" }
            let read = variant_field_read(ctx, holder, tid, path, held)
            if sub < 0 {
                bind_named(holder, node_name(f), tid, held, read, out)
            } else {
                if !bind_slot(ctx, sub, read, out) { return false }
            }
        }
        i = i + 1
    }
    true
}

fn tuple_pattern_binds(ctx: MatchCtx, pat: Int, out: List[Int]) -> Bool ! Diag.Report {
    let elems = node_elements(pat)
    if elems == -1 { return true }
    let mut i = 0
    while i < sublist_length(elems) {
        let sub = sublist_get(elems, i)
        let tid = stmt_tid(sub)
        if tid < 0 {
            if sub_pattern_declares(sub) { return false }
        } else {
            let rec = layout_at(tid, Position.Local, sub)
            let read = ir_field_get(tid, sub, rec.c_spelling, tuple_member(i), rec.slot_form,
                scrut_ref(ctx, sub))
            if !bind_slot(ctx, sub, read, out) { return false }
        }
        i = i + 1
    }
    true
}

// A list keeps its elements in runtime slots, so each position is read and decoded the
// same way an index expression reads one; cg_call owns whether the slot holds a box.
fn list_pattern_binds(ctx: MatchCtx, pat: Int, out: List[Int]) -> Bool ! Diag.Report {
    let elems = node_elements(pat)
    if elems == -1 { return true }
    let mut i = 0
    while i < sublist_length(elems) {
        let sub = sublist_get(elems, i)
        let tid = stmt_tid(sub)
        if tid < 0 {
            if sub_pattern_declares(sub) { return false }
        } else {
            let read = list_element_read(ctx, sub, tid, i)
            if read < 0 { return false }
            if !bind_slot(ctx, sub, read, out) { return false }
        }
        i = i + 1
    }
    true
}

fn list_element_read(ctx: MatchCtx, sub: Int, tid: Int, i: Int) -> Int ! Diag.Report {
    cg_call_element_from_runtime(sub, tid, list_get_symbol(),
        [scrut_ref(ctx, sub), int_const(sub, "{i}")])
}

// ── Patterns: tests ───────────────────────────────────────────────────────

// The condition under which an arm runs, or -1 when the arm always runs. Binders are not
// in scope here: a cond reads the scrutinee only, so an arm's guard is applied separately
// once its binders exist.
fn pattern_test(ctx: MatchCtx, pat: Int) -> Int ! Diag.Report {
    let kind = nk_of(node_kind(pat))
    if pattern_is_irrefutable(pat, ctx.tid) { return -1 }
    if pattern_is_labelled(pat, ctx.tid) {
        return ir_binary(TYPE_INT, pat, int_spelling(pat), "==",
            discriminant(ctx, pat), pattern_label(ctx, pat))
    }
    if kind == NodeKind.RangePattern { return range_test(ctx, pat) }
    if kind == NodeKind.OrPattern { return or_test(ctx, pat) }
    if kind == NodeKind.StringPattern { return string_pattern_test(ctx, pat) }
    // Not irrefutable and not labelled means some part still refuses beyond a single tag
    // comparison -- either this shape's own parts (a tuple or plain struct), or a payload
    // one level inside a variant (pattern_is_labelled already answered false for those).
    if kind == NodeKind.AsPattern { return pattern_test(ctx, node_pattern(pat)) }
    if kind == NodeKind.EnumPattern { return enum_pattern_test(ctx, pat) }
    if kind == NodeKind.TuplePattern { return tuple_pattern_test(ctx, pat) }
    if kind == NodeKind.StructPattern { return struct_pattern_test(ctx, pat) }
    if kind == NodeKind.ListPattern { return list_pattern_test(ctx, pat) }
    diag_ice_stage_not_built("a match on this pattern shape", pat)
    int_const(pat, "0")
}

// `"lit"` against a Str scrutinee. C compares a const char* by address, so this is not a
// label C can switch on; the test is the same runtime equality call a `==` on two Str
// expressions lowers to, against a Str constant built from the pattern's own content.
fn string_pattern_test(ctx: MatchCtx, pat: Int) -> Int ! Diag.Report {
    let bool_rec = layout_at(TYPE_BOOL, Position.Local, pat)
    if x_stopped(bool_rec) { return -1 }
    let str_rec = layout_at(TYPE_STR, Position.Local, pat)
    if x_stopped(str_rec) { return -1 }
    let lit = ir_const(TYPE_STR, pat, str_rec.c_spelling, c_string_literal(node_str_val(pat)))
    ir_call_runtime(TYPE_BOOL, pat, bool_rec.c_spelling, c_runtime_helper("str_eq"),
        bool_rec.slot_form, [scrut_ref(ctx, pat), lit])
}

// `lo..hi` on an ordinal. An inclusive range takes the high end too.
fn range_test(ctx: MatchCtx, pat: Int) -> Int ! Diag.Report {
    if !tid_is_ordinal(ctx.tid) {
        diag_ice_stage_not_built("a range pattern over a non-ordinal scrutinee", pat)
        return int_const(pat, "0")
    }
    let spell = ctx.rec.c_spelling
    let lo = ir_binary(TYPE_INT, pat, int_spelling(pat), ">=",
        scrut_ref(ctx, pat), ir_const(ctx.tid, pat, spell, node_str_val(pat)))
    let op = if node_inclusive(pat) == 1 { "<=" } else { "<" }
    let hi = ir_binary(TYPE_INT, pat, int_spelling(pat), op,
        scrut_ref(ctx, pat), ir_const(ctx.tid, pat, spell, node_name(pat)))
    ir_binary(TYPE_INT, pat, int_spelling(pat), "&&", lo, hi)
}

// `a | b | c`. An alternative binds nothing, so the arms join with `||` and the arm body
// is built once.
fn or_test(ctx: MatchCtx, pat: Int) -> Int ! Diag.Report {
    let elems = node_elements(pat)
    let n = if elems == -1 { 0 } else { sublist_length(elems) }
    if n == 0 { return int_const(pat, "0") }
    let mut acc = pattern_test(ctx, sublist_get(elems, 0))
    if acc < 0 { return -1 }
    let mut i = 1
    while i < n {
        let next = pattern_test(ctx, sublist_get(elems, i))
        if next < 0 { return -1 }
        acc = ir_binary(TYPE_INT, pat, int_spelling(pat), "||", acc, next)
        i = i + 1
    }
    acc
}

// EnumPattern, not reducible to a single label test because some part of its own payload
// still refuses. Tests the tag the same way the label branch in pattern_test would, then
// ANDs in the payload's own test -- the tag runs first, so a boxed payload read the
// payload test needs is only ever reached once the tag has proven it safe.
fn enum_pattern_test(ctx: MatchCtx, pat: Int) -> Int ! Diag.Report {
    let vname = pattern_variant_name(pat)
    let tag_test = ir_binary(TYPE_INT, pat, int_spelling(pat), "==",
        discriminant(ctx, pat), variant_label(ctx, pat, vname))
    and_test(pat, tag_test, payload_test(ctx, pat, vname))
}

// A variant's payload test, mirroring payload_binds one for one: a carrier keeps its
// payload in a named member, a transparent newtype's is the scrutinee word itself, and a
// user enum's is either the struct-style union arm or the positional one. -1 (this walk's
// "always true", the same meaning pattern_test gives it for an irrefutable pattern) when
// the payload names no fields to test.
fn payload_test(ctx: MatchCtx, pat: Int, vname: Str) -> Int ! Diag.Report {
    let flds = node_fields(pat)
    if flds == -1 || sublist_length(flds) == 0 { return -1 }
    if tid_is_carrier(ctx.tid) { return carrier_payload_test(ctx, vname, flds) }
    if ctx.rec.is_transparent != 0 { return newtype_payload_test(ctx, flds) }
    if node_int_val(pat) == 1 { return field_pattern_test(ctx, pat, "{c_enum_payload_member()}.{vname}") }
    positional_payload_test(ctx, pat, vname, flds)
}

fn newtype_payload_test(ctx: MatchCtx, flds: Int) -> Int ! Diag.Report {
    let sub = sublist_get(flds, 0)
    let tid = stmt_tid(sub)
    if tid < 0 { return -1 }
    let rec = layout_at(tid, Position.Local, sub)
    slot_test(ctx, sub, tid, rec, ir_cast(tid, sub, rec.c_spelling, scrut_ref(ctx, sub)))
}

fn carrier_payload_test(ctx: MatchCtx, vname: Str, flds: Int) -> Int ! Diag.Report {
    let sub = sublist_get(flds, 0)
    let tid = stmt_tid(sub)
    if tid < 0 { return -1 }
    let held = layout_at(tid, Position.Local, sub)
    slot_test(ctx, sub, tid, held, carrier_payload_value(ctx, vname, sub, tid, held))
}

fn positional_payload_test(ctx: MatchCtx, pat: Int, vname: Str, flds: Int) -> Int ! Diag.Report {
    let vnode = find_variant(c_decl_for_tid(ctx.tid), vname)
    if vnode < 0 { return -1 }
    let decl_flds = node_fields(vnode)
    let mut acc = -1
    let mut i = 0
    while i < sublist_length(flds) {
        let sub = sublist_get(flds, i)
        let tid = stmt_tid(sub)
        if tid >= 0 && !(decl_flds == -1 || i >= sublist_length(decl_flds)) {
            let member = c_field_name(node_name(sublist_get(decl_flds, i)))
            let held = layout_at(tid, Position.Local, sub)
            let path = "{c_enum_payload_member()}.{vname}.{member}"
            let read = variant_field_read(ctx, sub, tid, path, held)
            acc = and_test(sub, acc, slot_test(ctx, sub, tid, held, read))
        }
        i = i + 1
    }
    acc
}

// Struct-shaped fields, either of a struct pattern (no prefix) or of a struct-shaped
// variant payload (the union arm is the prefix) -- the test-side twin of
// field_pattern_binds.
fn field_pattern_test(ctx: MatchCtx, pat: Int, prefix: Str) -> Int ! Diag.Report {
    let flds = node_fields(pat)
    if flds == -1 { return -1 }
    let mut acc = -1
    let mut i = 0
    while i < sublist_length(flds) {
        let f = sublist_get(flds, i)
        let sub = node_pattern(f)
        if sub >= 0 {
            let tid = stmt_tid(sub)
            if tid >= 0 {
                let held = layout_at(tid, Position.Local, sub)
                let path = if prefix == "" { node_name(f) } else { "{prefix}.{node_name(f)}" }
                let read = variant_field_read(ctx, sub, tid, path, held)
                acc = and_test(sub, acc, slot_test(ctx, sub, tid, held, read))
            }
        }
        i = i + 1
    }
    acc
}

// The length test is the left operand, so no element read runs past the end of a
// shorter list. A trailing `..` accepts any longer list.
fn list_pattern_test(ctx: MatchCtx, pat: Int) -> Int ! Diag.Report {
    let elems = node_elements(pat)
    let n = if elems == -1 { 0 } else { sublist_length(elems) }
    let op = if node_inclusive(pat) == 1 { ">=" } else { "==" }
    let len = ir_call_runtime(TYPE_INT, pat, int_spelling(pat), c_runtime_helper("list_len"),
        int_form(pat), [scrut_ref(ctx, pat)])
    let mut acc = ir_binary(TYPE_INT, pat, int_spelling(pat), op, len, int_const(pat, "{n}"))
    let mut i = 0
    while i < n {
        let sub = sublist_get(elems, i)
        let tid = stmt_tid(sub)
        if tid >= 0 {
            let read = list_element_read(ctx, sub, tid, i)
            if read < 0 { return int_const(pat, "0") }
            acc = and_test(sub, acc, slot_test(ctx, sub, tid, layout_at(tid, Position.Local, sub), read))
        }
        i = i + 1
    }
    acc
}

fn tuple_pattern_test(ctx: MatchCtx, pat: Int) -> Int ! Diag.Report {
    let elems = node_elements(pat)
    if elems == -1 { return -1 }
    let mut acc = -1
    let mut i = 0
    while i < sublist_length(elems) {
        let sub = sublist_get(elems, i)
        let tid = stmt_tid(sub)
        if tid >= 0 {
            let rec = layout_at(tid, Position.Local, sub)
            let read = ir_field_get(tid, sub, rec.c_spelling, tuple_member(i), rec.slot_form,
                scrut_ref(ctx, sub))
            acc = and_test(sub, acc, slot_test(ctx, sub, tid, rec, read))
        }
        i = i + 1
    }
    acc
}

// A StructPattern node that may in fact name a variant (see struct_pattern_binds above):
// when it does, its own tag needs testing the same way an EnumPattern's does before its
// fields are read; a genuine struct pattern has no tag of its own, only its fields.
fn struct_pattern_test(ctx: MatchCtx, pat: Int) -> Int ! Diag.Report {
    let sname = node_type_name(pat)
    if is_variant_name(ctx.tid, sname) {
        let tag_test = ir_binary(TYPE_INT, pat, int_spelling(pat), "==",
            discriminant(ctx, pat), variant_label(ctx, pat, sname))
        return and_test(pat, tag_test, field_pattern_test(ctx, pat, "{c_enum_payload_member()}.{sname}"))
    }
    field_pattern_test(ctx, pat, "")
}

// Combines two tests where -1 stands for "always true": either side missing leaves the
// other, both present join with a left-to-right '&&' so the side that makes a later boxed
// read safe always runs first, the same order every existing '&&'-built test in this file
// already relies on.
fn and_test(span: Int, a: Int, b: Int) -> Int ! Diag.Report {
    if a < 0 { return b }
    if b < 0 { return a }
    ir_binary(TYPE_INT, span, int_spelling(span), "&&", a, b)
}

// One payload slot's own test, nested inside ctx: nothing for a plain binder (a name or
// wildcard matches whatever it is given), and the sub-pattern's own test otherwise --
// reusing pattern_test itself so every shape it already knows how to test works nested
// too, as many levels deep as the pattern goes, the same way bind_slot reuses
// pattern_binds to bind at any depth.
//
// The nested test may read `value` more than once: a refutable enum payload reads it
// once for its own tag and again for its own payload, and a struct or tuple payload
// reads it once per field or element. scrut_ref hands out a fresh copy on every read
// (see dup_value), so passing the same `value` down here again is safe no matter how
// many times the nested test reads it or how deep it recurses further.
fn slot_test(ctx: MatchCtx, sub: Int, tid: Int, rec: LayoutRecord, value: Int) -> Int ! Diag.Report {
    let nested = MatchCtx { tid: tid, holder: "", rec: rec, tail: ctx.tail, dest: ctx.dest, dest_tid: ctx.dest_tid, value: value }
    pattern_test(nested, sub)
}

// ── Arms ──────────────────────────────────────────────────────────────────

// One arm's block: its binders, then its body under the match's tail mode. The binder
// scope opens and closes around the arm so two arms can bind the same name.
fn arm_block(ctx: MatchCtx, arm: Int, extra: List[Int]) -> Int ! Diag.Report {
    let _ = open_scope()
    let mut out: List[Int] = []
    if !pattern_binds(ctx, node_pattern(arm), out) {
        close_scope()
        return -1
    }
    let mut i = 0
    while i < extra.len() {
        out.push(extra.get(i).unwrap())
        i = i + 1
    }
    let body = lower_body_block(node_body(arm), ctx.tail, ctx.dest, ctx.dest_tid)
    close_scope()
    if body < 0 { return -1 }
    out.push(body)
    ir_block(arm, out)
}

// A guarded arm decides inside its own block, because the guard reads binders the pattern
// introduced. The statements that mark the arm taken sit under the guard with the body.
fn guarded_arm_block(ctx: MatchCtx, arm: Int, guard: Int, extra: List[Int]) -> Int ! Diag.Report {
    let _ = open_scope()
    let mut out: List[Int] = []
    if !pattern_binds(ctx, node_pattern(arm), out) {
        close_scope()
        return -1
    }
    let mut inner: List[Int] = []
    let mut i = 0
    while i < extra.len() {
        inner.push(extra.get(i).unwrap())
        i = i + 1
    }
    let body = lower_body_block(node_body(arm), ctx.tail, ctx.dest, ctx.dest_tid)
    if body < 0 {
        close_scope()
        return -1
    }
    inner.push(body)
    // A statement the guard needs runs in this arm's block, after the binders and ahead of
    // the guard's `if`. Left to the enclosing block it would run above the whole match, for
    // arms that never match, before the binders it reads exist.
    let mark = cg_expr_pending_count()
    let tested = lower_value(guard)
    let hoisted = cg_expr_take_pending(mark)
    let mut h = 0
    while h < hoisted.len() {
        out.push(hoisted.get(h).unwrap())
        h = h + 1
    }
    out.push(ir_if(arm, tested, ir_block(arm, inner), -1))
    close_scope()
    ir_block(arm, out)
}

// ── Match shapes ──────────────────────────────────────────────────────────

// A match every arm of which is one equality against a constant, with at most a single
// catch-all last. That shape is a switch; anything else needs the chain below.
fn arms_are_switchable(arms: Int, n: Int, ctx: MatchCtx) -> Bool ! Diag.Report {
    if n == 0 { return false }
    if !is_discriminable(ctx) { return false }
    let mut i = 0
    while i < n {
        let arm = sublist_get(arms, i)
        if node_guard(arm) >= 0 { return false }
        let pat = node_pattern(arm)
        if pattern_is_irrefutable(pat, ctx.tid) {
            if i != n - 1 { return false }
        } else if !pattern_is_labelled(pat, ctx.tid) {
            return false
        }
        i = i + 1
    }
    true
}

fn lower_match_switch(node: Int, arms: Int, n: Int, ctx: MatchCtx, covered: Bool) -> Int ! Diag.Report {
    let mut cases: List[Int] = []
    let mut default_block = -1
    let none: List[Int] = []
    let mut i = 0
    while i < n {
        let arm = sublist_get(arms, i)
        // The label is read before the arm is lowered, so an arm that names a variant the
        // scrutinee has not reports that ahead of whatever its body reports.
        let catch_all = pattern_is_irrefutable(node_pattern(arm), ctx.tid)
        let label = if catch_all { -1 } else { pattern_label(ctx, node_pattern(arm)) }
        let block = arm_block(ctx, arm, none)
        if block < 0 { return -1 }
        if catch_all {
            default_block = block
        } else {
            cases.push(label)
            cases.push(block)
        }
        i = i + 1
    }
    // With no default arm written, a covered switch needs none; an uncovered one panics.
    if default_block < 0 && !covered {
        default_block = no_arm_ran(node)
        if default_block < 0 { return -1 }
    }
    ir_switch(node, discriminant(ctx, node), cases, default_block)
}

// The general shape: one `if` per arm, each gated on a flag that later arms read, so a
// guard that fails falls through to the next arm without the rest of the chain being
// built twice. A covered match none of whose arms ran is unreachable by construction; an
// uncovered one panics.
fn lower_match_chain(node: Int, arms: Int, n: Int, ctx: MatchCtx, covered: Bool, out: List[Int]) -> Bool ! Diag.Report {
    let flag = c_mint_local("taken")
    out.push(ir_let(TYPE_INT, node, int_spelling(node), flag, int_form(node),
        int_const(node, "0")))
    let mut i = 0
    while i < n {
        let arm = sublist_get(arms, i)
        let mark: List[Int] = [ir_assign(arm, flag_ref(arm, flag), int_const(arm, "1"))]
        let guard = node_guard(arm)
        let block = if guard < 0 { arm_block(ctx, arm, mark) } else { guarded_arm_block(ctx, arm, guard, mark) }
        if block < 0 { return false }
        let cond = pattern_test(ctx, node_pattern(arm))
        out.push(ir_if(arm, chain_condition(arm, flag, cond), block, -1))
        i = i + 1
    }
    let tail = if covered { ir_block(node, [ir_unreachable(node)]) } else { no_arm_ran(node) }
    if tail < 0 { return false }
    out.push(ir_if(node, not_taken(node, flag), tail, -1))
    true
}

fn no_arm_ran(node: Int) -> Int ! Diag.Report {
    let said = x_panic_message(node, "non-exhaustive match", [])
    if said < 0 { return -1 }
    ir_block(node, [ir_panic(node, said)])
}

fn not_taken(span: Int, flag: Str) -> Int ! Diag.Report {
    ir_binary(TYPE_INT, span, int_spelling(span), "==", flag_ref(span, flag),
        int_const(span, "0"))
}

fn chain_condition(span: Int, flag: Str, cond: Int) -> Int ! Diag.Report {
    if cond < 0 { return not_taken(span, flag) }
    ir_binary(TYPE_INT, span, int_spelling(span), "&&", not_taken(span, flag), cond)
}
