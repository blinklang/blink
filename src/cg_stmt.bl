// cg_stmt.bl: statements, control flow and function bodies, lowered to IR.
//
// Every statement becomes one IR node. A value the statement needs is asked of the
// expression stage; a C spelling is asked of layout_of; a C symbol is asked of cname.
// This module holds no C text of its own beyond union member names and the two carrier
// tag numbers, which are facts about the carrier struct rather than type spellings.
//
// Nothing here falls back. A node with no recorded type, a declined layout or a shape
// with no lowering is a recorded ICE and a poisoned node, never a guessed answer. The
// driver must read diag_ice_count before it prints a unit this module built.

import ast.{NodeKind, nk_of, node_kind_name}
import parser.{
    node_args, node_arms, node_body, node_col, node_condition, node_elements, node_else_body,
    node_end, node_fields, node_for_binder, node_guard, node_handlers, node_inclusive,
    node_index, node_int_val, node_is_mut, node_iterable, node_kind, node_left, node_line, node_name,
    node_obj, node_op, node_params, node_pattern, node_right, node_scrutinee, node_start,
    node_stmts, node_str_val, node_target, node_then_body, node_type_name, node_type_ann,
    node_value, sublist_get, sublist_length,
}
import typecheck.{
    TyKind, TYPE_BOOL, TYPE_CHAR, TYPE_FLOAT, TYPE_INT, TYPE_STR, TYPE_VOID,
    tc_alias_to_original, tc_tid_handler_effect, tc_tid_kind,
}
import layout.{
    Position, Slot, SlotForm, LayoutRecord, bind_binder, bind_binder_mut, binder_scope_pop, binder_scope_push,
    child_tid, ensure_typedef_for, layout_of, tid_of_binder, tid_of_node, varargs_spelling,
}
import cname.{
    c_assert_fail_eq_name, c_assert_fail_intro_name, c_assert_fail_name,
    c_debug_assert_fail_name, c_decl_for_tid, c_enum_payload_member, c_field_name,
    c_local_name, c_mint_local, c_variant_discriminant, c_runtime_helper,
    c_string_literal,
}
import ir.{
    IrKind, ir_assign, ir_binary, ir_block, ir_break, ir_call_runtime, ir_carrier_tag,
    ir_carrier_unwrap, ir_cast, ir_const, ir_continue, ir_expr_stmt, ir_field_get, ir_if,
    ir_kind, ir_let, ir_loop, ir_mark_materialize, ir_return, ir_span, ir_switch, ir_unary,
    ir_unreachable, ir_var_ref, ir_with_scope,
}
import diagnostics.{
    Diag, diag_file_for_node, diag_ice_at, diag_ice_stage_not_built, diag_is_ice_seg,
    CODEGEN_STAGE_NOT_BUILT, UNHANDLED_ITERABLE_AT_CODEGEN, UNSOLVED_TYPEVAR_AT_CODEGEN,
}
import cg_expr.{
    cg_expr_drain_pending, cg_expr_is_registered, cg_expr_pending_count, cg_expr_push_pending,
    cg_expr_register_value, cg_expr_set_return_type, cg_expr_take_pending, lower_expr,
    x_layout_checked, x_stopped,
}
import cg_eff.{cg_eff_resource_cleanup}
import cg_call.{
    AssertKind, ForInIteration, ForInStrategy, cc_assert_family_kind, cc_is_ptr_write_stmt,
    cc_lower_ptr_write_stmt, cg_call_element_from_runtime, for_in_iteration_of,
}
import unparse.{unparse_expr}

// A carrier holds its discriminant in `tag`, its Option payload in `value` and its
// Result arms in `ok` and `err`. These are member names in a struct layout.bl emits,
// not type spellings, so they are spelled here rather than asked of a name producer.
let STMT_CARRIER_VALUE = "value"
let CARRIER_OK = "ok"
let CARRIER_ERR = "err"

// Option is none-first and Result is ok-first. Both orders are fixed by the runtime
// header, which builds carriers of its own with the same numbers.
let TAG_NONE = 0
let TAG_SOME = 1
let TAG_OK = 0
let TAG_ERR = 1

// The prelude carrier variants. A pattern names a variant as a string, so the carrier
// arms are recognised by name; which carrier is in play comes from the scrutinee's tid,
// never from the name.
let VARIANT_SOME = "Some"
let VARIANT_NONE = "None"
let VARIANT_OK = "Ok"
let VARIANT_ERR = "Err"

// A tagged enum keeps its payloads in one union field; a variant's own arm carries the
// variant's name. Member names in a struct layout.bl emits, not type spellings.

// The `with` item that asks for a fresh allocation arena rather than a resource.
let ARENA_ITEM = "arena"

// What a block does with the value its last expression produces.
let TAIL_DISCARD = 0
let TAIL_RETURN = 1
let TAIL_ASSIGN = 2

let mut scope_stack: List[Int] = []

// Whether a `debug_assert` lowers to a check or to nothing. Set once from CgConfig for a
// whole build, so a reset between probes leaves it as the caller set it, the same way a
// build never changes this flag between the functions it lowers.
let mut cs_debug_mode: Bool = false

pub fn cg_stmt_set_debug_mode(on: Bool) {
    cs_debug_mode = on
}

// The name of the function whose body is lowering, for `debug_assert`'s failure message.
// Saved and restored around a function's own body, so a nested closure body cannot leak
// its name into the function around it.
let mut cs_current_fn_name: Str = ""

pub fn cg_stmt_reset() {
    scope_stack = []
    mv_clean = true
    cs_current_fn_name = ""
}

// ── Types, spellings and names ────────────────────────────────────────────

// The type of a node under the instance being lowered. layout holds which instance that
// is, so this module carries no walk state of its own and cannot disagree with cg_expr.
fn stmt_tid(node: Int) -> Int ! Diag.Report {
    tid_of_node(node)
}

// layout_of in a position, with the decline contract honoured on the spot: a declined
// record is an internal error here, never a spelling this module invents instead.
fn layout_at(tid: Int, position: Position, node: Int) -> LayoutRecord ! Diag.Report {
    let rec = x_layout_checked(layout_of(tid, position), node, "LayoutDeclined",
        "layout declined type {tid}", "layout answers every type codegen reads; this is a compiler bug")
    if !x_stopped(rec) { return rec }
    // A declined record carries no spelling, and a node without one fails the verifier
    // before the reported error can be read. The integer record stands in.
    x_layout_checked(layout_of(TYPE_INT, position), node, "LayoutDeclined",
        "layout declined the integer type", "every position spells an integer; this is a compiler bug")
}

fn int_form(span: Int) -> SlotForm ! Diag.Report {
    layout_at(TYPE_INT, Position.Local, span).slot_form
}

// The C identifier of a local, parameter or pattern binder. Shared with the expression
// stage so a binder and every read of it spell the same identifier.
pub fn cg_local_c_name(name: Str) -> Str {
    c_local_name(name)
}

fn open_scope() -> Int {
    let id = binder_scope_push()
    scope_stack.push(id)
    id
}

fn close_scope() {
    if scope_stack.len() == 0 { return }
    scope_stack.pop()
    binder_scope_pop()
}

fn cur_scope() -> Int {
    if scope_stack.len() == 0 { return -1 }
    scope_stack.get(scope_stack.len() - 1).unwrap()
}

// ── The expression seam ───────────────────────────────────────────────────

// Every value this module needs comes through here, so switching to the expression
// stage's lowerer is one line and a build without that stage fails loudly at each value
// rather than emitting a statement with a hole in it.
fn lower_value(node: Int) -> Int ! Diag.Report {
    let value = lower_expr(node)
    if value >= 0 { return value }
    poison_value(node)
}

// A module-scope global's initializer. It shares the same seam as any other value; the
// scope it opens and closes is never bound into, because a global reads no local binder,
// but every other entry point pushes and pops one and this keeps the stack symmetric with
// them.
pub fn lower_global_init(node: Int) -> Int ! Diag.Report {
    let _ = open_scope()
    let saved_fn_name = cs_current_fn_name
    cs_current_fn_name = "<module init>"
    let value = lower_value(node)
    cs_current_fn_name = saved_fn_name
    close_scope()
    value
}

// ── The stop ──────────────────────────────────────────────────────────────

// A statement lowering answers -1 when the statement cannot be lowered: its type was
// never recorded, and the ICE naming that is already on the report. Every reader of a
// lowered statement passes the -1 on rather than building around it, so the operator
// meets the one honest error instead of a second one invented from a missing type. A
// binder is the reason this matters: a name declared by a statement that stopped must
// not bind, and the lowering after it must not run, because a read of that name would
// otherwise walk out to an outer declaration of the same name and answer its type.
//
// lower_fn turns a stopped body into an empty block, so the driver seam always answers
// a node. The driver reads diag_ice_count, never this number.

// A value node that stands in for one an ICE has already reported. It is well formed so
// the verifier and the dump still work on the surrounding tree; it is never a spelling
// this module chose for a real value, because a unit whose ICE count is non-zero must
// never reach the printer.
fn poison_value(node: Int) -> Int ! Diag.Report {
    int_const(node, "0")
}

// ── Entry points ──────────────────────────────────────────────────────────

// A function body. Parameters bind in the body's scope so a read of one resolves to its
// declared type, and the body's tail value becomes the function's return.
pub fn lower_fn(fn_node: Int) -> Int ! Diag.Report {
    let scope = open_scope()
    let bound = bind_params(fn_node, scope)
    let tail = if fn_returns_value(fn_node) { TAIL_RETURN } else { TAIL_DISCARD }
    let body = node_body(fn_node)
    // `?` in the body returns the enclosing function's carrier on the failure arm, and `?`
    // lowers in the expression stage, which reads no function of its own. The annotation is
    // the only place the carrier is named, so the type goes across before the body lowers
    // and comes back off after, leaving nothing for the next function to read.
    let ann = node_type_ann(fn_node)
    cg_expr_set_return_type(if ann < 0 { -1 } else { stmt_tid(ann) })
    let saved_fn_name = cs_current_fn_name
    cs_current_fn_name = node_name(fn_node)
    let block = if bound && body >= 0 { lower_body_block(body, tail, "", -1) } else { -1 }
    cs_current_fn_name = saved_fn_name
    cg_expr_set_return_type(-1)
    close_scope()
    // A stopped body, a parameter with no type and a declaration with no body all leave
    // nothing worth printing, and the seam still answers a node.
    if block < 0 { return ir_block(fn_node, []) }
    block
}

// Whether the tail expression of the body is the function's result. A function that
// declares no return type, or declares one with no values, discards its tail instead:
// C rejects a value on a return out of a function that returns nothing.
fn fn_returns_value(fn_node: Int) -> Bool ! Diag.Report {
    let ann = node_type_ann(fn_node)
    if ann < 0 { return false }
    let tid = stmt_tid(ann)
    if tid < 0 {
        diag_ice_at("NoTypeForReturnAnnotation", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "the return annotation of this function has no recorded type", fn_node,
            "typecheck stamps every annotation codegen reads; this is a compiler bug")
        // Returning the value is the shape that keeps C's own return-type rule: a
        // function that declares a result must produce one.
        return true
    }
    tc_tid_kind(tid) != TyKind.Void
}

// Answers false when a parameter has no recorded type. The body reads its parameters, so
// one left unbound is a name the body resolves somewhere else instead.
fn bind_params(fn_node: Int, scope: Int) -> Bool ! Diag.Report {
    let params = node_params(fn_node)
    if params == -1 { return true }
    let mut i = 0
    while i < sublist_length(params) {
        let p = sublist_get(params, i)
        let tid = stmt_tid(p)
        if tid < 0 { return false }
        bind_binder(scope, node_name(p), tid)
        i = i + 1
    }
    true
}

// A block in statement position: its own binder scope, and a tail value nobody reads.
// Answers -1 when a statement in it stopped; see The stop above.
pub fn lower_block(node: Int) -> Int ! Diag.Report {
    lower_body_block(node, TAIL_DISCARD, "", -1)
}

// A block whose tail value is the enclosing function's result. Answers -1 on a stop.
pub fn lower_block_returning(node: Int) -> Int ! Diag.Report {
    lower_body_block(node, TAIL_RETURN, "", -1)
}

// A block whose tail value is stored into an already declared local of type `dest_tid`.
// This is how a block-shaped expression (an `if`, a `match`, a `with`) hands its value
// back without the IR needing a value-carrying block node. Answers -1 on a stop.
pub fn lower_block_into(node: Int, dest_c_name: Str, dest_tid: Int) -> Int ! Diag.Report {
    lower_body_block(node, TAIL_ASSIGN, dest_c_name, dest_tid)
}

// One statement, with its value discarded. This is the seam the driver and the
// expression stage call for a statement they already know is not in tail position.
// Answers -1 on a stop.
pub fn lower_stmt(node: Int) -> Int ! Diag.Report {
    lower_stmt_tail(node, TAIL_DISCARD, "", -1)
}

// ── Statement dispatch ────────────────────────────────────────────────────

// One arm per statement shape. A shape with no arm reaches the value path, which asks
// the expression stage; a shape the expression stage does not know reports there.
fn lower_stmt_tail(node: Int, tail: Int, dest: Str, dest_tid: Int) -> Int ! Diag.Report {
    match nk_of(node_kind(node)) {
        NodeKind.LetBinding => lower_let(node)
        NodeKind.Assignment => lower_assign(node)
        NodeKind.CompoundAssign => lower_compound_assign(node)
        NodeKind.ExprStmt => lower_stmt_tail(node_value(node), tail, dest, dest_tid)
        NodeKind.Return => lower_return(node)
        NodeKind.Break => ir_break(node)
        NodeKind.Continue => ir_continue(node)
        NodeKind.Block => lower_tail_block_into(node, tail, dest, dest_tid)
        NodeKind.IfExpr => lower_if(node, tail, dest, dest_tid)
        NodeKind.MatchExpr => lower_match(node, tail, dest, dest_tid)
        NodeKind.WhileLoop => lower_while(node)
        NodeKind.LoopExpr => lower_loop(node)
        NodeKind.ForIn => lower_for_in(node)
        NodeKind.WithBlock => lower_with_block(node, tail, dest, dest_tid)
        NodeKind.Call => lower_call_stmt(node, tail, dest, dest_tid)
        NodeKind.MethodCall => lower_method_call_stmt(node, tail, dest, dest_tid)
        _ => lower_value_stmt(node, tail, dest, dest_tid)
    }
}

// A pointer store (`p.write(v)` or `p.f.write(v)`) is the one method call this stage
// intercepts before it reaches the value path: cc_is_ptr_write_stmt decides by the
// receiver's own tid kind, never by a name, so a call this is not falls straight through to
// the same value lowering every other method call reached before this arm existed. `.write`
// answers Unit, so a store built here ignores tail/dest/dest_tid exactly as WhileLoop and
// the other bare-statement arms above do; a caller that names one in a value slot (`let x =
// p.write(v)`) never reaches this function at all, since typecheck's own tid marks the
// slot as one this stage still refuses.
fn lower_method_call_stmt(node: Int, tail: Int, dest: Str, dest_tid: Int) -> Int ! Diag.Report {
    if cc_is_ptr_write_stmt(node) { return cc_lower_ptr_write_stmt(node) }
    lower_value_stmt(node, tail, dest, dest_tid)
}

// The assert family is statement-shaped only: the parser fabricates a bare Call it never
// hands the expression stage a value for. Every other call is a value like any other, so
// only the assert family's own names are intercepted here; everything else falls through
// to the same value path a Call reached before this arm existed.
fn lower_call_stmt(node: Int, tail: Int, dest: Str, dest_tid: Int) -> Int ! Diag.Report {
    let callee = node_left(node)
    if callee < 0 || nk_of(node_kind(callee)) != NodeKind.Ident {
        return lower_value_stmt(node, tail, dest, dest_tid)
    }
    let written = node_name(callee)
    let name = tc_alias_to_original.get(written) ?? written
    // cc_assert_family_kind is cg_call's own answer for these four names, read here so
    // the spelling lives in one place rather than a second chain of name comparisons.
    match cc_assert_family_kind(name) {
        AssertKind.Assert => lower_assert_call(node)
        AssertKind.AssertEq => lower_assert_eq_call(node)
        AssertKind.AssertNe => lower_assert_ne_call(node)
        AssertKind.DebugAssert => lower_debug_assert_call(node)
        AssertKind.None => lower_value_stmt(node, tail, dest, dest_tid)
    }
}

fn lower_value_stmt(node: Int, tail: Int, dest: Str, dest_tid: Int) -> Int ! Diag.Report {
    tail_wrap(node, lower_value(node), tail, dest, dest_tid)
}

// How a produced value leaves the block that produced it.
fn tail_wrap(node: Int, value: Int, tail: Int, dest: Str, dest_tid: Int) -> Int ! Diag.Report {
    if tail == TAIL_RETURN { return ir_return(node, value) }
    if tail == TAIL_ASSIGN {
        let rec = layout_at(dest_tid, Position.Local, node)
        let lvalue = ir_var_ref(dest_tid, node, rec.c_spelling, dest, rec.slot_form)
        return ir_assign(node, lvalue, value)
    }
    ir_expr_stmt(node, value)
}

// ── The assert family ─────────────────────────────────────────────────────
//
// Four builtin calls the parser hands here as a bare, statement-shaped Call: assert,
// assert_eq, assert_ne and debug_assert. None of them produce a value, so each lowers to
// an `if (!condition) { fail-call }`, composed from IrKind.If, IrKind.ExprStmt and
// IrKind.CallRuntime, the same three kinds x_test_propagate_arm composes a runtime call
// from. A stopped operand poisons the whole call, the same as any other statement; see
// The stop above.

// A value bound into a fresh local, and a read of that local. Every operand this section
// reads twice (once to compare, once to render) binds once so its side effects run once.
type Bound {
    stmt: Int
    ref: Int
}

fn bind_temp(stem: Str, tid: Int, span: Int, value: Int) -> Bound ! Diag.Report {
    let rec = layout_at(tid, Position.Local, span)
    let holder = c_mint_local(stem)
    let stmt = ir_let(tid, span, rec.c_spelling, holder, rec.slot_form, value)
    let ref = ir_var_ref(tid, span, rec.c_spelling, holder, rec.slot_form)
    // Every Bound is read more than once by design (see the comment above); mark it so
    // ir_verify accepts the reuse instead of reporting a value reached from two parents.
    ir_mark_materialize(ref)
    Bound { stmt: stmt, ref: ref }
}

fn str_const(span: Int, text: Str) -> Int ! Diag.Report {
    let rec = layout_at(TYPE_STR, Position.Local, span)
    ir_const(TYPE_STR, span, rec.c_spelling, c_string_literal(text))
}

// A void runtime call, in statement position. Position.Return is the shape a call with no
// value of its own takes, the same position x_test_propagate_arm's own runtime call uses.
fn call_runtime_void(span: Int, symbol: Str, args: List[Int]) -> Int ! Diag.Report {
    let rec = layout_of(TYPE_VOID, Position.Return)
    ir_expr_stmt(span, ir_call_runtime(TYPE_VOID, span, rec.c_spelling, symbol, rec.slot_form, args))
}

// blink_str_format is a value-returning Str build, not a buffer the caller must size: one
// call builds every message, expected-side and actual-side string this section needs.
fn call_str_format(span: Int, fmt: Str, args: List[Int]) -> Int ! Diag.Report {
    let rec = layout_at(TYPE_STR, Position.Local, span)
    let mut all_args = [str_const(span, fmt)]
    let mut i = 0
    while i < args.len() {
        all_args.push(args.get(i).unwrap())
        i = i + 1
    }
    ir_call_runtime(TYPE_STR, span, rec.c_spelling, c_runtime_helper("str_format"), rec.slot_form, all_args)
}

// `%` in a name or a literal spliced into a format string built for blink_str_format would
// read to printf as the start of a specifier. Doubling it here is not something gen0's own
// power-assert intro does, and gen0's intro can misrender when an operand's source holds
// one; this section always escapes it instead of reproducing that gap.
fn pct_escape(text: Str) -> Str {
    let mut sb = StringBuilder.new()
    let mut i = 0
    while i < text.len() {
        if text.byte_at(i) == 37 { sb.write("%") }
        sb.write(text.substring(i, 1))
        i = i + 1
    }
    sb.to_str()
}

fn assert_args_ok(node: Int, name: Str, args: Int, want: Int) -> Bool ! Diag.Report {
    if args >= 0 && sublist_length(args) >= want {
        return true
    }
    diag_ice_at("AssertArityWrong", CODEGEN_STAGE_NOT_BUILT,
        "{name} needs at least {want} argument(s)", node,
        "typecheck accepts a call's arity before codegen ever sees it; this is a compiler bug")
    false
}

fn assert_aggregate_refused(node: Int, form: Str) -> Int ! Diag.Report {
    diag_ice_at("AssertCompareAggregateNotBuilt", CODEGEN_STAGE_NOT_BUILT,
        "{form} over a struct, an enum, a Result or an Option has no lowering yet", node,
        "only Str, Float and the integer, Bool and Char scalars compare and render here so far")
    -1
}

// ── assert(cond, msg?): the power-assert decomposition ────────────────────

// What assert's decomposition answers: either the whole condition, unchanged, with no
// intro text, or a rebuilt Bool condition over two bound operands plus the intro line
// that names each side's source text and value.
type PaResult {
    ok: Bool
    cond: Int
    intro: Int
    pre: List[Int]
}

fn pa_not_decomposed() -> PaResult ! Diag.Report {
    PaResult { ok: false, cond: -1, intro: -1, pre: [] }
}

fn pa_op_renderable(op: Str) -> Bool {
    op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" ||
        op == "&&" || op == "||"
}

// The scalar set assert's intro knows how to render. && and || decompose regardless of
// their operands' kinds; every comparison needs both sides in this set.
fn pa_kind_renderable(k: TyKind) -> Bool {
    k == TyKind.Int || k == TyKind.Bool || k == TyKind.Float || k == TyKind.Char ||
        k == TyKind.Str || k == TyKind.I8 || k == TyKind.I16 || k == TyKind.I32 ||
        k == TyKind.U8 || k == TyKind.U16 || k == TyKind.U32 || k == TyKind.U64
}

// One level deep: a top-level BinOp whose operator and operand kinds are decomposable.
// Everything else falls back to the whole condition, rendered with no intro.
fn pa_decompose(cond_node: Int) -> PaResult ! Diag.Report {
    if nk_of(node_kind(cond_node)) != NodeKind.BinOp { return pa_not_decomposed() }
    let op = node_op(cond_node)
    if !pa_op_renderable(op) { return pa_not_decomposed() }
    let lhs_node = node_left(cond_node)
    let rhs_node = node_right(cond_node)
    let logical = op == "&&" || op == "||"
    let lhs_tid = stmt_tid(lhs_node)
    let rhs_tid = stmt_tid(rhs_node)
    if lhs_tid < 0 || rhs_tid < 0 { return pa_not_decomposed() }
    if !logical && !(pa_kind_renderable(tc_tid_kind(lhs_tid)) && pa_kind_renderable(tc_tid_kind(rhs_tid))) {
        return pa_not_decomposed()
    }
    let lhs_value = lower_value(lhs_node)
    let rhs_value = lower_value(rhs_node)
    if lhs_value < 0 || rhs_value < 0 { return pa_not_decomposed() }
    let lhs_bound = bind_temp("pa_l", lhs_tid, lhs_node, lhs_value)
    let rhs_bound = bind_temp("pa_r", rhs_tid, rhs_node, rhs_value)
    let bool_rec = layout_at(TYPE_BOOL, Position.Local, cond_node)
    let cond = pa_cond_expr(cond_node, op, lhs_tid, rhs_tid, lhs_bound.ref, rhs_bound.ref, bool_rec)
    if cond < 0 { return pa_not_decomposed() }
    let mut pre: List[Int] = [lhs_bound.stmt, rhs_bound.stmt]
    let lhs_arg = pa_arg_for(lhs_node, lhs_tid, lhs_bound.ref, pre)
    let rhs_arg = pa_arg_for(rhs_node, rhs_tid, rhs_bound.ref, pre)
    if lhs_arg < 0 || rhs_arg < 0 { return pa_not_decomposed() }
    let lhs_src = pct_escape(unparse_expr(lhs_node))
    let rhs_src = pct_escape(unparse_expr(rhs_node))
    let fmt = "  {lhs_src} = {pa_spec_for_kind(tc_tid_kind(lhs_tid))}\n  {rhs_src} = {pa_spec_for_kind(tc_tid_kind(rhs_tid))}"
    let intro = call_str_format(cond_node, fmt, [lhs_arg, rhs_arg])
    PaResult { ok: true, cond: cond, intro: intro, pre: pre }
}

// The rebuilt Bool condition over two already-bound operands. A Str comparison goes
// through the same runtime helpers lower_str_binop uses; every other comparison, and both
// logical operators, are a plain C operator between the two temps.
fn pa_cond_expr(cond_node: Int, op: Str, lhs_tid: Int, rhs_tid: Int, lhs_ref: Int, rhs_ref: Int, bool_rec: LayoutRecord) -> Int ! Diag.Report {
    let both_str = tc_tid_kind(lhs_tid) == TyKind.Str && tc_tid_kind(rhs_tid) == TyKind.Str
    if both_str && (op == "==" || op == "!=") {
        let eq = ir_call_runtime(TYPE_BOOL, cond_node, bool_rec.c_spelling,
            c_runtime_helper("str_eq"), bool_rec.slot_form, [lhs_ref, rhs_ref])
        if op == "!=" { return ir_unary(TYPE_BOOL, cond_node, bool_rec.c_spelling, "!", eq) }
        return eq
    }
    if both_str && (op == "<" || op == "<=" || op == ">" || op == ">=") {
        let int_rec = layout_at(TYPE_INT, Position.Local, cond_node)
        let cmp = ir_call_runtime(TYPE_INT, cond_node, int_rec.c_spelling,
            c_runtime_helper("str_cmp"), int_rec.slot_form, [lhs_ref, rhs_ref])
        return ir_binary(TYPE_BOOL, cond_node, bool_rec.c_spelling, op, cmp, int_const(cond_node, "0"))
    }
    ir_binary(TYPE_BOOL, cond_node, bool_rec.c_spelling, op, lhs_ref, rhs_ref)
}

// The printf spec assert's intro renders a kind with. Bool and Char each need their value
// turned into the spec's own shape first; see pa_arg_for.
fn pa_spec_for_kind(k: TyKind) -> Str {
    if k == TyKind.Bool { return "%s" }
    if k == TyKind.Float { return "%g" }
    if k == TyKind.Str { return "%s" }
    if k == TyKind.Char { return "%d" }
    "%lld"
}

// The argument pa_spec_for_kind's spec reads. Bool becomes its "true"/"false" spelling,
// hoisted ahead of the statement that reads it; Float and Str pass through as they are
// already spelled; Char passes through with no cast, since C's own vararg promotion
// widens an int32_t to int with no help; everything else is the assert family's one
// shared default bucket, cast the way lower_interp already casts a varargs integer hole.
fn pa_arg_for(node: Int, tid: Int, value_ref: Int, pre: List[Int]) -> Int ! Diag.Report {
    let k = tc_tid_kind(tid)
    if k == TyKind.Bool { return bool_to_str_ref(node, value_ref, pre) }
    if k == TyKind.Float { return value_ref }
    if k == TyKind.Str { return value_ref }
    if k == TyKind.Char { return value_ref }
    ir_cast(tid, node, varargs_spelling(TYPE_INT), value_ref)
}

// A Bool value turned into its "true"/"false" spelling: a Str temp initialised to "false",
// reassigned to "true" under a hoisted `if`, both pushed onto `pre` ahead of the statement
// that reads the temp.
fn bool_to_str_ref(node: Int, cond_ref: Int, pre: List[Int]) -> Int ! Diag.Report {
    let str_rec = layout_at(TYPE_STR, Position.Local, node)
    let holder = c_mint_local("pa_b")
    pre.push(ir_let(TYPE_STR, node, str_rec.c_spelling, holder, str_rec.slot_form, str_const(node, "false")))
    let target = ir_var_ref(TYPE_STR, node, str_rec.c_spelling, holder, str_rec.slot_form)
    let assign_true = ir_assign(node, target, str_const(node, "true"))
    pre.push(ir_if(node, cond_ref, ir_block(node, [assign_true]), -1))
    ir_var_ref(TYPE_STR, node, str_rec.c_spelling, holder, str_rec.slot_form)
}

fn lower_assert_call(node: Int) -> Int ! Diag.Report {
    let args = node_args(node)
    if !assert_args_ok(node, "assert", args, 1) { return -1 }
    let cond_node = sublist_get(args, 0)
    let decomposed = pa_decompose(cond_node)
    let cond_value = if decomposed.ok { decomposed.cond } else { lower_value(cond_node) }
    if cond_value < 0 { return -1 }
    let bool_rec = layout_at(TYPE_BOOL, Position.Local, node)
    let neg = ir_unary(TYPE_BOOL, node, bool_rec.c_spelling, "!", cond_value)
    let intro_arg = if decomposed.ok { decomposed.intro } else { str_const(node, "") }
    let mut user_msg = str_const(node, "")
    if sublist_length(args) >= 2 {
        user_msg = lower_value(sublist_get(args, 1))
        if user_msg < 0 { return -1 }
    }
    let assertion = "assert({unparse_expr(cond_node)})"
    let fail_stmt = call_runtime_void(node, c_assert_fail_intro_name(), [
        str_const(node, assertion),
        intro_arg,
        str_const(node, diag_file_for_node(node)),
        int_const(node, "{node_line(node)}"),
        int_const(node, "{node_col(node)}"),
        user_msg,
    ])
    let mut pre = decomposed.pre
    pre.push(ir_if(node, neg, ir_block(node, [fail_stmt]), -1))
    ir_block(node, pre)
}

// ── assert_eq / assert_ne: the per-type comparison buckets ─────────────────
//
// gen0 casts every scalar in this bucket to int64_t and renders it %lld, Bool and Char
// included, regardless of signedness; there is no separate unsigned bucket here. Str
// compares by blink_str_eq and renders %s; Float compares by != and renders %f, not the
// %g assert's own intro uses. A struct, an enum, a Result or an Option refuses by name;
// see assert_aggregate_refused.
// The cast this bucket renders is built once and read twice (once in the failure
// message, once as its own exp/act arg), so it must materialise the same as a Bound.
fn eq_default_arg(tid: Int, span: Int, value_ref: Int) -> Int ! Diag.Report {
    let cast = ir_cast(tid, span, varargs_spelling(TYPE_INT), value_ref)
    ir_mark_materialize(cast)
    cast
}

fn eq_is_str(tid: Int) -> Bool ! Diag.Report { tc_tid_kind(tid) == TyKind.Str }
fn eq_is_float(tid: Int) -> Bool ! Diag.Report { tc_tid_kind(tid) == TyKind.Float }
fn eq_is_aggregate(tid: Int) -> Bool ! Diag.Report {
    let k = tc_tid_kind(tid)
    k == TyKind.Struct || k == TyKind.Enum || k == TyKind.Result || k == TyKind.Option
}

fn lower_assert_eq_call(node: Int) -> Int ! Diag.Report {
    let args = node_args(node)
    if !assert_args_ok(node, "assert_eq", args, 2) { return -1 }
    let left_node = sublist_get(args, 0)
    let right_node = sublist_get(args, 1)
    let tid = stmt_tid(left_node)
    if tid < 0 { return -1 }
    if eq_is_aggregate(tid) { return assert_aggregate_refused(node, "assert_eq") }
    let left_value = lower_value(left_node)
    let right_value = lower_value(right_node)
    if left_value < 0 || right_value < 0 { return -1 }
    let left_bound = bind_temp("left", tid, node, left_value)
    let right_bound = bind_temp("right", tid, node, right_value)
    let bool_rec = layout_at(TYPE_BOOL, Position.Local, node)
    let line = int_const(node, "{node_line(node)}")
    let mut pre: List[Int] = [left_bound.stmt, right_bound.stmt]
    if eq_is_str(tid) {
        let eq = ir_call_runtime(TYPE_BOOL, node, bool_rec.c_spelling,
            c_runtime_helper("str_eq"), bool_rec.slot_form, [left_bound.ref, right_bound.ref])
        let neq = ir_unary(TYPE_BOOL, node, bool_rec.c_spelling, "!", eq)
        let msg = call_str_format(node, "ASSERT_EQ FAILED: \"%s\" != \"%s\"", [left_bound.ref, right_bound.ref])
        let exp = call_str_format(node, "%s", [right_bound.ref])
        let act = call_str_format(node, "%s", [left_bound.ref])
        let fail_stmt = call_runtime_void(node, c_assert_fail_eq_name(), [msg, exp, act, line])
        pre.push(ir_if(node, neq, ir_block(node, [fail_stmt]), -1))
        return ir_block(node, pre)
    }
    if eq_is_float(tid) {
        let neq = ir_binary(TYPE_BOOL, node, bool_rec.c_spelling, "!=", left_bound.ref, right_bound.ref)
        let msg = call_str_format(node, "ASSERT_EQ FAILED: %f != %f", [left_bound.ref, right_bound.ref])
        let exp = call_str_format(node, "%f", [right_bound.ref])
        let act = call_str_format(node, "%f", [left_bound.ref])
        let fail_stmt = call_runtime_void(node, c_assert_fail_eq_name(), [msg, exp, act, line])
        pre.push(ir_if(node, neq, ir_block(node, [fail_stmt]), -1))
        return ir_block(node, pre)
    }
    let left_arg = eq_default_arg(tid, node, left_bound.ref)
    let right_arg = eq_default_arg(tid, node, right_bound.ref)
    let neq = ir_binary(TYPE_BOOL, node, bool_rec.c_spelling, "!=", left_bound.ref, right_bound.ref)
    let msg = call_str_format(node, "ASSERT_EQ FAILED: %lld != %lld", [left_arg, right_arg])
    let exp = call_str_format(node, "%lld", [right_arg])
    let act = call_str_format(node, "%lld", [left_arg])
    let fail_stmt = call_runtime_void(node, c_assert_fail_eq_name(), [msg, exp, act, line])
    pre.push(ir_if(node, neq, ir_block(node, [fail_stmt]), -1))
    ir_block(node, pre)
}

// assert_ne has no Result or Option bucket in gen0 either; a struct still refuses.
fn lower_assert_ne_call(node: Int) -> Int ! Diag.Report {
    let args = node_args(node)
    if !assert_args_ok(node, "assert_ne", args, 2) { return -1 }
    let left_node = sublist_get(args, 0)
    let right_node = sublist_get(args, 1)
    let tid = stmt_tid(left_node)
    if tid < 0 { return -1 }
    if eq_is_aggregate(tid) { return assert_aggregate_refused(node, "assert_ne") }
    let left_value = lower_value(left_node)
    let right_value = lower_value(right_node)
    if left_value < 0 || right_value < 0 { return -1 }
    let left_bound = bind_temp("left", tid, node, left_value)
    let right_bound = bind_temp("right", tid, node, right_value)
    let bool_rec = layout_at(TYPE_BOOL, Position.Local, node)
    let line = int_const(node, "{node_line(node)}")
    let mut pre: List[Int] = [left_bound.stmt, right_bound.stmt]
    if eq_is_str(tid) {
        let eq = ir_call_runtime(TYPE_BOOL, node, bool_rec.c_spelling,
            c_runtime_helper("str_eq"), bool_rec.slot_form, [left_bound.ref, right_bound.ref])
        let msg = call_str_format(node, "ASSERT_NE FAILED: \"%s\" == \"%s\"", [left_bound.ref, right_bound.ref])
        let fail_stmt = call_runtime_void(node, c_assert_fail_name(), [msg, line])
        pre.push(ir_if(node, eq, ir_block(node, [fail_stmt]), -1))
        return ir_block(node, pre)
    }
    if eq_is_float(tid) {
        let eq = ir_binary(TYPE_BOOL, node, bool_rec.c_spelling, "==", left_bound.ref, right_bound.ref)
        let msg = call_str_format(node, "ASSERT_NE FAILED: %f == %f", [left_bound.ref, right_bound.ref])
        let fail_stmt = call_runtime_void(node, c_assert_fail_name(), [msg, line])
        pre.push(ir_if(node, eq, ir_block(node, [fail_stmt]), -1))
        return ir_block(node, pre)
    }
    let left_arg = eq_default_arg(tid, node, left_bound.ref)
    let right_arg = eq_default_arg(tid, node, right_bound.ref)
    let eq = ir_binary(TYPE_BOOL, node, bool_rec.c_spelling, "==", left_bound.ref, right_bound.ref)
    let msg = call_str_format(node, "ASSERT_NE FAILED: %lld == %lld", [left_arg, right_arg])
    let fail_stmt = call_runtime_void(node, c_assert_fail_name(), [msg, line])
    pre.push(ir_if(node, eq, ir_block(node, [fail_stmt]), -1))
    ir_block(node, pre)
}

// ── debug_assert(cond, msg?) ────────────────────────────────────────────────
//
// Gated on cs_debug_mode: off answers an empty block, the same as gen0 emitting nothing.
// On, a single non-decomposed check. gen0's own cond text is the raw C expression it just
// emitted; nothing here holds that text, so the Blink source of the condition stands in,
// the same substitution assert's own assertion text already makes.
fn lower_debug_assert_call(node: Int) -> Int ! Diag.Report {
    let args = node_args(node)
    if !assert_args_ok(node, "debug_assert", args, 1) { return -1 }
    if !cs_debug_mode { return ir_block(node, []) }
    let cond_node = sublist_get(args, 0)
    let cond_value = lower_value(cond_node)
    if cond_value < 0 { return -1 }
    let bool_rec = layout_at(TYPE_BOOL, Position.Local, node)
    let neg = ir_unary(TYPE_BOOL, node, bool_rec.c_spelling, "!", cond_value)
    let mut msg = str_const(node, "debug assertion failed")
    if sublist_length(args) >= 2 {
        msg = lower_value(sublist_get(args, 1))
        if msg < 0 { return -1 }
    }
    let fail_stmt = call_runtime_void(node, c_debug_assert_fail_name(), [
        str_const(node, diag_file_for_node(node)),
        int_const(node, "{node_line(node)}"),
        str_const(node, cs_current_fn_name),
        str_const(node, unparse_expr(cond_node)),
        msg,
    ])
    ir_block(node, [ir_if(node, neg, ir_block(node, [fail_stmt]), -1)])
}

// ── Simple statements ─────────────────────────────────────────────────────

// A unit-typed initialiser carries the one value of `()` but hands back nothing to assign,
// because a `()`-returning function is emitted as C `void` while storage spells unit as an
// integer. So the initialiser runs as a statement and the name is given the single value
// directly. Reading it as an expression instead would assign a void result, which no C
// compiler accepts.
fn bind_unit_let(node: Int, tid: Int, init: Int, rec: LayoutRecord, name: Str) -> Int ! Diag.Report {
    let ran = lower_stmt_tail(init, TAIL_DISCARD, "", -1)
    if ran < 0 { return -1 }
    cg_expr_push_pending(node, ran)
    let unit = int_const(node, "0")
    if unit < 0 { return -1 }
    bind_binder_mut(cur_scope(), name, tid, node_is_mut(node) == 1)
    ir_let(tid, node, rec.c_spelling, cg_local_c_name(name), rec.slot_form, unit)
}

fn lower_let(node: Int) -> Int ! Diag.Report {
    if node_elements(node) != -1 { return lower_destructuring_let(node) }
    let tid = stmt_tid(node)
    if tid < 0 { return -1 }
    let rec = layout_at(tid, Position.Local, node)
    let _ = ensure_typedef_for(tid)
    let name = node_name(node)
    let init = node_value(node)
    if init < 0 {
        bind_binder_mut(cur_scope(), name, tid, node_is_mut(node) == 1)
        return ir_let(tid, node, rec.c_spelling, cg_local_c_name(name), rec.slot_form, -1)
    }
    if tc_tid_kind(tid) == TyKind.Void {
        if !cg_expr_is_registered(init) { return bind_unit_let(node, tid, init, rec, name) }
    }
    // The initializer is lowered before the name binds, so `let x = x + 1` reads the
    // outer `x` the source names rather than the one this statement is declaring.
    let value = lower_value(init)
    bind_binder_mut(cur_scope(), name, tid, node_is_mut(node) == 1)
    ir_let(tid, node, rec.c_spelling, cg_local_c_name(name), rec.slot_form, value)
}

// `let (a, b) = e`. The tuple binds once so the initializer runs once, and each element
// binds from that local. A nested tuple pattern binds through another element local.
fn lower_destructuring_let(node: Int) -> Int ! Diag.Report {
    let tid = stmt_tid(node)
    if tid < 0 { return -1 }
    let rec = layout_at(tid, Position.Local, node)
    let _ = ensure_typedef_for(tid)
    let holder = c_mint_local("tup")
    let init = node_value(node)
    let value = if init < 0 { poison_value(node) } else { lower_value(init) }
    let mut out: List[Int] = [ir_let(tid, node, rec.c_spelling, holder, rec.slot_form, value)]
    if !bind_tuple_pattern(node_elements(node), tid, holder, rec.c_spelling, rec.slot_form, out) { return -1 }
    ir_block(node, out)
}

// Binds every name a tuple pattern holds against `holder`, appending one Let each.
// Answers false when an element has no type, so no name of this pattern binds at all.
fn bind_tuple_pattern(pat: Int, tid: Int, holder: Str, spell: Str, form: SlotForm, out: List[Int]) -> Bool ! Diag.Report {
    let elems = node_elements(pat)
    if elems == -1 { return true }
    let mut i = 0
    while i < sublist_length(elems) {
        let sub = sublist_get(elems, i)
        let elem_tid = child_tid(tid, Slot.Elem(i))
        if elem_tid < 0 {
            diag_ice_at("TupleElementMissing", UNSOLVED_TYPEVAR_AT_CODEGEN,
                "tuple type {tid} has no element {i}", sub,
                "a tuple pattern is checked against its tuple type; this is a compiler bug")
            return false
        }
        let rec = layout_at(elem_tid, Position.Local, sub)
        let _ = ensure_typedef_for(elem_tid)
        let obj = ir_var_ref(tid, sub, spell, holder, form)
        let get = ir_field_get(elem_tid, sub, rec.c_spelling, tuple_member(i), rec.slot_form, obj)
        if !bind_sub_pattern(sub, elem_tid, get, rec, out) { return false }
        i = i + 1
    }
    true
}

// One element of a destructuring pattern: a name binds, a nested tuple binds through a
// local of its own, and a wildcard drops the element.
fn bind_sub_pattern(sub: Int, tid: Int, value: Int, rec: LayoutRecord, out: List[Int]) -> Bool ! Diag.Report {
    let kind = nk_of(node_kind(sub))
    if kind == NodeKind.WildcardPattern { return true }
    if kind == NodeKind.TuplePattern {
        let inner = c_mint_local("tup")
        out.push(ir_let(tid, sub, rec.c_spelling, inner, rec.slot_form, value))
        return bind_tuple_pattern(sub, tid, inner, rec.c_spelling, rec.slot_form, out)
    }
    let name = node_name(sub)
    bind_binder(cur_scope(), name, tid)
    out.push(ir_let(tid, sub, rec.c_spelling, cg_local_c_name(name), rec.slot_form, value))
    true
}

fn lower_assign(node: Int) -> Int ! Diag.Report {
    let target = node_target(node)
    if !is_assignable_place(target) {
        diag_ice_stage_not_built("an assignment to a place that is not a local", node)
        return ir_expr_stmt(node, poison_value(node))
    }
    ir_assign(node, lower_target(target), lower_value(node_value(node)))
}

// Whether a target is a place this stage can build an lvalue for: a bare local this module
// bound itself, or a field reached off one. Anything else -- an index expression, a place
// behind a pointer -- is a place the expression stage builds that has no lvalue producer yet.
fn is_assignable_place(node: Int) -> Bool ! Diag.Report {
    let kind = nk_of(node_kind(node))
    if kind == NodeKind.Ident { return tid_of_binder(cur_scope(), node_name(node)) >= 0 }
    kind == NodeKind.FieldAccess
}

// The left side of an assignment must be an lvalue. A bare local is one this module bound
// itself, so it is read straight from the binder scope. A field access reuses the
// expression stage's own reader: `lower_expr` already builds a FieldGet for it, and
// `is_lvalue_kind` in ir.bl already accepts a FieldGet as an Assign target, so this is not
// a new node shape, only a new place lower_target reaches it from.
fn lower_target(node: Int) -> Int ! Diag.Report {
    if nk_of(node_kind(node)) == NodeKind.FieldAccess { return lower_value(node) }
    let name = node_name(node)
    let tid = tid_of_binder(cur_scope(), name)
    if tid < 0 {
        diag_ice_stage_not_built("an assignment to a place that is not a local", node)
        return poison_value(node)
    }
    let rec = layout_at(tid, Position.Local, node)
    ir_var_ref(tid, node, rec.c_spelling, cg_local_c_name(name), rec.slot_form)
}

// `x += e` is `x = x + e`. The target is read and written, so it is lowered twice: two
// nodes for one source node, which keeps each reach a separate tree the printer can
// place inline on its own.
fn lower_compound_assign(node: Int) -> Int ! Diag.Report {
    let target = node_target(node)
    if !is_assignable_place(target) {
        diag_ice_stage_not_built("an assignment to a place that is not a local", node)
        return ir_expr_stmt(node, poison_value(node))
    }
    let tid = stmt_tid(target)
    if tid < 0 { return -1 }
    let rec = layout_at(tid, Position.Local, node)
    let lhs = lower_target(target)
    let read = lower_target(target)
    let sum = ir_binary(tid, node, rec.c_spelling, node_op(node), read, lower_value(node_value(node)))
    ir_assign(node, lhs, sum)
}

fn lower_return(node: Int) -> Int ! Diag.Report {
    let v = node_value(node)
    if v < 0 { return ir_return(node, -1) }
    ir_return(node, lower_value(v))
}

// ── Blocks in value position ──────────────────────────────────────────────

// One statement, with the statements its value needed in front of it.
//
// A value the expression stage cannot finish on its own (a coalesce, a short-circuit arm,
// a `?`, a carrier unwrap) declares a temp, leaves the statements that fill it in that
// stage's buffer, and answers a read of the temp. A block is where those statements land,
// because a C block is the only thing that holds a statement, and they go in front of the
// statement that reads the temp.
//
// The mark is taken per statement rather than per block. A seam that lowers a value of its
// own before recursing into a block (an `if` its condition) owns that value's statements,
// so a block must take only what was pushed while it lowered its own statement.
//
// An `if` or a `match` the statement reads as a value is materialised into a temp first,
// because the expression stage can only answer a read of a temp something else declared.
//
// Answers false on a stop, having left `out` as it found it.
fn lower_stmt_hoisted(s: Int, tail: Int, dest: Str, dest_tid: Int, out: List[Int]) -> Bool ! Diag.Report {
    let mark = cg_expr_pending_count()
    let lowered = if materialise_stmt_values(s) { lower_stmt_tail(s, tail, dest, dest_tid) } else { -1 }
    if lowered < 0 {
        // The statements filled temps only the stopped statement reads, so they go nowhere.
        let _dropped = cg_expr_take_pending(mark)
        return false
    }
    cg_expr_drain_pending(mark, out)
    out.push(lowered)
    true
}

fn lower_tail_block_into(node: Int, tail: Int, dest: Str, dest_tid: Int) -> Int ! Diag.Report {
    let _ = open_scope()
    let stmts = node_stmts(node)
    let n = if stmts == -1 { 0 } else { sublist_length(stmts) }
    let mut out: List[Int] = []
    let mut i = 0
    while i < n {
        let s = sublist_get(stmts, i)
        let mode = if i == n - 1 { tail } else { TAIL_DISCARD }
        if !lower_stmt_hoisted(s, mode, dest, dest_tid, out) {
            close_scope()
            return -1
        }
        i = i + 1
    }
    if n == 0 && tail == TAIL_RETURN { out.push(ir_return(node, -1)) }
    close_scope()
    ir_block(node, out)
}

// ── Values an arm has to fill ─────────────────────────────────────────────

// An `if` or a `match` written where a value is wanted. Its arms are blocks, and only a
// statement can stand in a block, so C has no expression to put one in. The lowering is a
// temp declared in front of the statement that reads it, each arm assigning into that
// temp, and the temp's name given to the expression stage, which spells a read of it.
//
// The walk runs before the statement lowers, so the temp and the arms that fill it reach
// the block ahead of the reader. It stops at every boundary that would move work to a
// place it does not belong: a block of its own, which is walked for each of its own
// statements; a closure body, which is another function; a loop test, a match guard and
// the right operand of a short-circuit, each of which runs a different number of times
// than the statement around it. A shape left unwalked is not wrong C. The expression
// stage refuses a value it was given no temp for, by name.
//
// Answers false when a shape was refused, so the statement stops on the one named report
// rather than lowering into a read of a temp nothing declared; see The stop above.
fn materialise_stmt_values(s: Int) -> Bool ! Diag.Report {
    mv_clean = true
    mv_stmt(s)
}

fn mv_stmt(s: Int) -> Bool ! Diag.Report {
    match nk_of(node_kind(s)) {
        NodeKind.LetBinding => mv_expr(node_value(s))
        NodeKind.Assignment => mv_pair(node_target(s), node_value(s))
        NodeKind.CompoundAssign => mv_pair(node_target(s), node_value(s))
        NodeKind.ExprStmt => mv_stmt(node_value(s))
        NodeKind.Return => mv_expr(node_value(s))
        NodeKind.IfExpr => mv_expr(node_condition(s))
        NodeKind.MatchExpr => mv_expr(node_scrutinee(s))
        // The ends of a counted range are read once above the loop, so a temp in front of
        // the statement is read exactly as often as they are.
        NodeKind.ForIn => mv_expr(node_iterable(s))
        NodeKind.Block => true
        NodeKind.WhileLoop => true
        NodeKind.LoopExpr => true
        NodeKind.WithBlock => true
        NodeKind.Break => true
        NodeKind.Continue => true
        _ => mv_expr(s)
    }
}

// False once the walk has passed a part of the statement that an arm may not run before.
//
// The arms of a materialised `if` run in front of the whole statement, not where the
// source wrote them. So every part the walk passed first must be a part that runs the same
// whether it goes before the arms or after them. Only a value that reads nothing, writes
// nothing, cannot trap and calls nothing qualifies: a number, a character and a boolean,
// and the tuples, lists and ranges built out of those.
//
// Everything else is work: it reads a cell an arm can write, it traps, or it calls a
// function. Past any of it the `if` is left to the expression stage, which refuses it by
// name. Each arm below gives the reason for its kind.
let mut mv_clean: Bool = true

// Work the walk may not move an arm above. Whatever follows in the same statement is left
// to the expression stage.
fn mv_moves_work() -> Bool {
    mv_clean = false
    true
}

fn mv_pair(a: Int, b: Int) -> Bool ! Diag.Report {
    if !mv_expr(a) { return false }
    mv_expr(b)
}

fn mv_list(sl: Int) -> Bool ! Diag.Report {
    if sl == -1 { return true }
    let mut i = 0
    while i < sublist_length(sl) {
        if !mv_expr(sublist_get(sl, i)) { return false }
        i = i + 1
    }
    true
}

// One expression, in the order its parts run. A kind whose parts this does not know is
// walked no further and counts as work, so nothing inside it is moved and nothing after it
// is either.
fn mv_expr(e: Int) -> Bool ! Diag.Report {
    if e < 0 { return true }
    match nk_of(node_kind(e)) {
        NodeKind.IntLit => true
        NodeKind.FloatLit => true
        NodeKind.CharLit => true
        NodeKind.BoolLit => true
        NodeKind.TupleLit => mv_list(node_elements(e))
        NodeKind.ListLit => mv_list(node_elements(e))
        NodeKind.RangeLit => mv_pair(node_start(e), node_end(e))
        NodeKind.NamedArg => mv_expr(node_value(e))
        NodeKind.IfExpr => materialise_value_expr(e)
        NodeKind.MatchExpr => materialise_value_expr(e)
        NodeKind.Block => materialise_value_expr(e)
        NodeKind.WithBlock => materialise_value_expr(e)
        NodeKind.BinOp => mv_binop(e)
        // `?` returns out of the function on its failure arm, and an operator on a type
        // that carries an impl is a call into it.
        NodeKind.UnaryOp => mv_after(mv_expr(node_left(e)))
        // A name and a field read a cell an arm can write.
        NodeKind.Ident => mv_moves_work()
        NodeKind.FieldAccess => mv_after(mv_expr(node_obj(e)))
        // A hole calls the formatter, and a field the literal left out can carry a default
        // that runs between the fields the literal did write.
        NodeKind.InterpString => mv_moves_work()
        NodeKind.StructLit => mv_moves_work()
        // A read through an index is checked, and the check is a statement of its own.
        NodeKind.IndexExpr => mv_after(mv_pair(node_obj(e), node_index(e)))
        // A call's left is the callee, which runs before its arguments.
        NodeKind.Call => mv_after(mv_expr(node_left(e)) && mv_list(node_args(e)))
        NodeKind.MethodCall => mv_after(mv_expr(node_obj(e)) && mv_list(node_args(e)))
        _ => mv_moves_work()
    }
}

// The part of a value-position expression that lowers ahead of the statements that fill
// the temp: an `if` reads its condition there, a `match` its scrutinee, a `with` the
// resources it opens. A bare block has none, because every statement it holds stands under
// the temp already.
fn mv_head(node: Int) -> Bool ! Diag.Report {
    match nk_of(node_kind(node)) {
        NodeKind.IfExpr => mv_expr(node_condition(node))
        NodeKind.MatchExpr => mv_expr(node_scrutinee(node))
        NodeKind.WithBlock => mv_with_items(node)
        _ => true
    }
}

// Only a resource item carries an expression. An arena item is a bare name and a handler
// item is its own shape, and neither holds a value this walk could move.
fn mv_with_items(node: Int) -> Bool ! Diag.Report {
    let items = node_handlers(node)
    if items == -1 { return true }
    let mut i = 0
    while i < sublist_length(items) {
        let item = sublist_get(items, i)
        if nk_of(node_kind(item)) == NodeKind.WithResource {
            if !mv_expr(node_value(item)) { return false }
        }
        i = i + 1
    }
    true
}

// A part whose own work runs after the parts inside it.
fn mv_after(walked: Bool) -> Bool {
    if !walked { return false }
    mv_moves_work()
}

fn mv_binop(e: Int) -> Bool ! Diag.Report {
    if !mv_expr(node_left(e)) { return false }
    let op = node_op(e)
    // The right operand of `&&`, `||` and `??` runs only when the left one decided
    // nothing, and the expression stage builds each as an `if`. A temp filled in front of
    // the statement would run it every time, which both changes what the program does and
    // can run work the left operand was guarding.
    if op == "&&" { return mv_moves_work() }
    if op == "||" { return mv_moves_work() }
    if op == "??" { return mv_moves_work() }
    if !mv_expr(node_right(e)) { return false }
    // A divide traps on a zero right operand, and an operator on a type that carries an
    // impl is a call into it.
    mv_moves_work()
}

// The temp for one value-position `if` or `match`: declared unset, filled by the arms,
// and named to the expression stage before the statement that reads it lowers.
//
// What the walk passed before it reached this node decides whether the temp is safe, so
// the test comes before anything else this does. The head is not part of that: it lowers
// inside the `if` the temp stands under, so it keeps its place ahead of the arms whatever
// work it holds. Walking it materialises a value-position `if` in a condition or a
// scrutinee into a temp of its own above this one.
// A construct whose tail is not a value expression has type `()`, which is an ordinary
// inhabited type carrying one value and a representation, so the binding gets that one
// value rather than a report. The temp is declared at the unit spelling and initialised to
// the single value; the construct then runs as a statement, because a tail that is not a
// value expression has nothing to assign. The fill question is not asked: there is one
// value and it is already in the temp, whichever path the body takes.
fn materialise_unit_value(node: Int, tid: Int) -> Bool ! Diag.Report {
    let rec = layout_at(tid, Position.Local, node)
    let _ = ensure_typedef_for(tid)
    let name = c_mint_local("val")
    let unit = int_const(node, "0")
    if unit < 0 { return false }
    cg_expr_push_pending(node, ir_let(tid, node, rec.c_spelling, name, rec.slot_form, unit))
    let ran = lower_stmt_tail(node, TAIL_DISCARD, "", -1)
    if ran < 0 { return false }
    cg_expr_push_pending(node, ran)
    cg_expr_register_value(node, name, tid)
    mv_clean = true
    true
}

fn materialise_value_expr(node: Int) -> Bool ! Diag.Report {
    if !mv_clean {
        diag_ice_at("ValuePositionExprMovesWork", CODEGEN_STAGE_NOT_BUILT,
            "{node_kind_name(node_kind(node))} in value position stands after work its arms would run before", node,
            "materialising this needs the temp declared where the reader is lowered; bind the value in a let above the statement")
        return false
    }
    if !mv_head(node) { return false }
    let tid = stmt_tid(node)
    if tid < 0 { return false }
    if tc_tid_kind(tid) == TyKind.Void { return materialise_unit_value(node, tid) }
    if !tail_fills(node) {
        diag_ice_at("ValuePositionArmFillsNothing", CODEGEN_STAGE_NOT_BUILT,
            "the tail of this {node_kind_name(node_kind(node))} in value position neither produces a value nor leaves the block", node,
            "every arm must end in a value, a return, a break or a continue; an arm ending in a let or a loop has no lowering yet")
        return false
    }
    let rec = layout_at(tid, Position.Local, node)
    let _ = ensure_typedef_for(tid)
    let name = c_mint_local("val")
    cg_expr_push_pending(node, ir_let(tid, node, rec.c_spelling, name, rec.slot_form, -1))
    let filled = lower_stmt_tail(node, TAIL_ASSIGN, name, tid)
    if filled < 0 { return false }
    cg_expr_push_pending(node, filled)
    cg_expr_register_value(node, name, tid)
    // The head and the arms both stand under this temp, and a temp minted later stands
    // under this one. So nothing they hold is work a later part of the same statement has
    // to move above. Lowering the arms ran this same walk over each arm statement, which
    // left the flag holding the last of them; this is what puts it back.
    mv_clean = true
    true
}

// Whether every arm of a value-position `if` or `match` either assigns the temp or leaves
// the block without reaching the read. A `return`, a `break` and a `continue` all leave;
// anything that runs to the end of its arm without producing a value would let the temp be
// read before anything wrote it, which is the one shape this must never build.
fn arms_fill_tail(node: Int) -> Bool ! Diag.Report {
    if nk_of(node_kind(node)) == NodeKind.MatchExpr { return match_arms_fill(node) }
    let els = node_else_body(node)
    // With no else arm there is a path around the whole `if`, and it writes nothing.
    if els < 0 { return false }
    if !body_fills(node_then_body(node)) { return false }
    body_fills(els)
}

fn match_arms_fill(node: Int) -> Bool ! Diag.Report {
    let arms = node_arms(node)
    let n = if arms == -1 { 0 } else { sublist_length(arms) }
    if n == 0 { return false }
    let mut i = 0
    while i < n {
        if !body_fills(node_body(sublist_get(arms, i))) { return false }
        i = i + 1
    }
    true
}

fn body_fills(body: Int) -> Bool ! Diag.Report {
    if body < 0 { return false }
    if nk_of(node_kind(body)) != NodeKind.Block { return tail_fills(body) }
    let stmts = node_stmts(body)
    let n = if stmts == -1 { 0 } else { sublist_length(stmts) }
    if n == 0 { return false }
    tail_fills(sublist_get(stmts, n - 1))
}

// Whether the last statement of an arm hands its value to the tail mode. The arms answer
// the same question lower_stmt_tail does: the shapes that reach tail_wrap produce a value,
// the shapes that jump leave the block, and the rest fall off the end writing nothing.
fn tail_fills(s: Int) -> Bool ! Diag.Report {
    match nk_of(node_kind(s)) {
        NodeKind.LetBinding => false
        NodeKind.Assignment => false
        NodeKind.CompoundAssign => false
        NodeKind.WhileLoop => false
        NodeKind.LoopExpr => false
        NodeKind.ForIn => false
        NodeKind.Return => true
        NodeKind.Break => true
        NodeKind.Continue => true
        NodeKind.ExprStmt => tail_fills(node_value(s))
        NodeKind.Block => body_fills(s)
        NodeKind.IfExpr => arms_fill_tail(s)
        NodeKind.MatchExpr => match_arms_fill(s)
        NodeKind.WithBlock => body_fills(node_body(s))
        _ => true
    }
}

// ── If ────────────────────────────────────────────────────────────────────

// Both arms carry the tail mode, so an `if` in tail position returns or stores from
// inside each arm rather than producing a value the enclosing block would have to name.
fn lower_if(node: Int, tail: Int, dest: Str, dest_tid: Int) -> Int ! Diag.Report {
    let cond = lower_value(node_condition(node))
    let then_block = lower_body_block(node_then_body(node), tail, dest, dest_tid)
    if then_block < 0 { return -1 }
    let els = node_else_body(node)
    if els < 0 { return ir_if(node, cond, then_block, -1) }
    let else_block = lower_body_block(els, tail, dest, dest_tid)
    if else_block < 0 { return -1 }
    ir_if(node, cond, then_block, else_block)
}

// A body the AST may spell as a block or as a single expression. The IR wants a Block
// either way, so a bare expression gets one of its own.
fn lower_body_block(node: Int, tail: Int, dest: Str, dest_tid: Int) -> Int ! Diag.Report {
    if nk_of(node_kind(node)) == NodeKind.Block {
        return lower_tail_block_into(node, tail, dest, dest_tid)
    }
    let _ = open_scope()
    let mut out: List[Int] = []
    let ok = lower_stmt_hoisted(node, tail, dest, dest_tid, out)
    close_scope()
    if !ok { return -1 }
    ir_block(node, out)
}

// ── Loops ─────────────────────────────────────────────────────────────────

// `while c { b }` is `while (1) { if (!c) break; b }`. One loop form in the IR means the
// printer never has to decide where a continue lands.
fn lower_while(node: Int) -> Int ! Diag.Report {
    let cond_node = node_condition(node)
    let tid = stmt_tid(cond_node)
    if tid < 0 { return -1 }
    let rec = layout_at(tid, Position.Local, cond_node)
    // The test is read once per turn, and the guard the test becomes sits inside the loop.
    // A statement the test needed has no place there: the enclosing block would take it,
    // which puts it above the loop, where it runs once and the turns after the first read
    // a stale temp. The shape that works copies those statements into the guard block ahead
    // of the test, and nothing builds that yet.
    let mark = cg_expr_pending_count()
    let tested = lower_value(cond_node)
    let hoisted = cg_expr_take_pending(mark)
    if hoisted.len() > 0 {
        diag_ice_at("HoistOutOfLoopTest", CODEGEN_STAGE_NOT_BUILT,
            "this loop test needs a statement run before it, and there it would run once instead of each turn",
            cond_node,
            "a test that needs a temp has no lowering yet; bind the value in a let above the loop and test that")
        return -1
    }
    let cond = ir_binary(tid, cond_node, rec.c_spelling, "==",
        tested, ir_const(tid, cond_node, rec.c_spelling, "0"))
    let guard = ir_if(cond_node, cond, ir_block(cond_node, [ir_break(cond_node)]), -1)
    let body = lower_block(node_body(node))
    if body < 0 { return -1 }
    ir_loop(node, ir_block(node, [guard, body]))
}

// `loop { b }` is the bare form: the IR loop node with no guard of its own.
fn lower_loop(node: Int) -> Int ! Diag.Report {
    let body = lower_block(node_body(node))
    if body < 0 { return -1 }
    ir_loop(node, body)
}

// ── For-in ────────────────────────────────────────────────────────────────

// `for i in a..b` is a counted loop, so it lowers with no help from the runtime. Every
// other iterable is walked by index, and the two runtime entry points walking needs are
// named by cg_call's for_in_iteration_of rather than chosen here.
fn lower_for_in(node: Int) -> Int ! Diag.Report {
    let iter = node_iterable(node)
    if nk_of(node_kind(iter)) == NodeKind.RangeLit { return lower_for_range(node, iter) }
    let container = tid_of_node(iter)
    if container < 0 { return ir_block(node, []) }
    let walk = for_in_iteration_of(container, node)
    // The producer reports the iterables it has no entry points for, and answers a shape
    // with no element. Reporting again here would name one gap twice.
    if walk.element_tid < 0 { return ir_block(node, []) }
    if !for_in_walkable(node, container, walk) { return ir_block(node, []) }
    if node_elements(node) != -1 {
        diag_ice_at("ForInTupleBinderNotLowered", CODEGEN_STAGE_NOT_BUILT,
            "this for-in destructures the element into more than one name, and no stage binds a destructured element yet",
            node, "a destructured binder records no mutability at its bind site, so a closure in the body could not tell a capture of one from a binding it shares")
        return ir_block(node, [])
    }
    lower_for_indexed(node, iter, walk)
}

// Only a list is walked today. Every other container the producer answers reads its
// element back at a C type of its own -- blink_bytes_get answers an integer where
// blink_list_get answers a cell -- and ForInIteration does not yet say which, so a reader
// built from it here would convert the wrong one with nothing to catch it.
fn for_in_walkable(node: Int, container: Int, walk: ForInIteration) -> Bool ! Diag.Report {
    if walk.strategy == ForInStrategy.Indexed && tc_tid_kind(container) == TyKind.List {
        return true
    }
    diag_ice_at("UnhandledIterable", UNHANDLED_ITERABLE_AT_CODEGEN,
        "for-in over this iterable has no lowering yet", node,
        "a container needs an entry point whose C answer this stage can convert; only ranges and lists lower today")
    false
}

// `for x in xs { b }` becomes
//   L src = xs; int64_t n = blink_list_len(src); int64_t i = -1;
//   while (1) { i = i + 1; if (i >= n) break; E x = <element of src at i>; b }
// The container and its length are each read once, in front of the loop, so a body that
// appends to the list it walks cannot change how many turns run. The step is at the top,
// from -1, so a `continue` in the body cannot skip it and spin.
fn lower_for_indexed(node: Int, iter: Int, walk: ForInIteration) -> Int ! Diag.Report {
    let _ = open_scope()
    let binder = node_for_binder(node)
    let elem = walk.element_tid
    let rec = layout_at(elem, Position.Local, binder)
    let src_tid = tid_of_node(iter)
    if src_tid < 0 {
        close_scope()
        return -1
    }
    let src_rec = layout_at(src_tid, Position.Local, iter)
    let src = c_mint_local("iter")
    let src_let = ir_let(src_tid, node, src_rec.c_spelling, src, src_rec.slot_form, lower_value(iter))
    let len = c_mint_local("len")
    let len_let = ir_let(TYPE_INT, node, int_spelling(node), len, int_form(node),
        ir_call_runtime(TYPE_INT, node, int_spelling(node), walk.len_symbol, int_form(node),
            [container_ref(node, src_tid, src_rec, src)]))
    let idx = c_mint_local("idx")
    let idx_let = ir_let(TYPE_INT, node, int_spelling(node), idx, int_form(node), int_const(node, "-1"))
    let step = ir_assign(node, flag_ref(node, idx),
        ir_binary(TYPE_INT, node, int_spelling(node), "+", flag_ref(node, idx), int_const(node, "1")))
    let cond = ir_binary(TYPE_INT, node, int_spelling(node), ">=", flag_ref(node, idx), flag_ref(node, len))
    let guard = ir_if(node, cond, ir_block(node, [ir_break(node)]), -1)
    let read = cg_call_element_from_runtime(node, elem, walk.get_symbol,
        [container_ref(node, src_tid, src_rec, src), flag_ref(node, idx)])
    if read < 0 {
        close_scope()
        return -1
    }
    let bind = ir_let(elem, node, rec.c_spelling, cg_local_c_name(node_name(binder)), rec.slot_form, read)
    // A for-in binder has no `mut` form to write, so it is immutable as a matter of syntax
    // rather than of bookkeeping, and a closure in the body may copy it.
    bind_binder_mut(cur_scope(), node_name(binder), elem, false)
    let body = lower_block(node_body(node))
    close_scope()
    if body < 0 { return -1 }
    ir_block(node, [src_let, len_let, idx_let, ir_loop(node, ir_block(node, [step, guard, bind, body]))])
}

// A read of the local the container was copied into. Each read is a node of its own,
// because the verifier rejects one node reached from two places.
fn container_ref(span: Int, tid: Int, rec: LayoutRecord, name: Str) -> Int {
    ir_var_ref(tid, span, rec.c_spelling, name, rec.slot_form)
}

// `for i in lo..hi { b }` becomes
//   T i = lo; T end = hi; int first = 1;
//   while (1) { if (first) { first = 0; } else { i = i + 1; } if (i >= end) break; b }
// The step runs at the top of the loop, so a `continue` in the body cannot skip it, and
// the end of the range is read once rather than on every turn. An inclusive range
// compares with `>` so the last value runs.
fn lower_for_range(node: Int, iter: Int) -> Int ! Diag.Report {
    let _ = open_scope()
    let binder = node_for_binder(node)
    let tid = stmt_tid(binder)
    if tid < 0 {
        close_scope()
        return -1
    }
    let rec = layout_at(tid, Position.Local, binder)
    let name = cg_local_c_name(node_name(binder))
    let init = ir_let(tid, node, rec.c_spelling, name, rec.slot_form, lower_value(node_start(iter)))
    let end_name = c_mint_local("end")
    let end_let = ir_let(tid, iter, rec.c_spelling, end_name, rec.slot_form, lower_value(node_end(iter)))
    let first = c_mint_local("first")
    let first_let = ir_let(TYPE_INT, node, int_spelling(node), first, int_form(node), int_const(node, "1"))
    // A for-in binder has no `mut` form to write, so it is immutable as a matter of syntax.
    bind_binder_mut(cur_scope(), node_name(binder), tid, false)
    let step = ir_if(node, flag_ref(node, first),
        ir_block(node, [ir_assign(node, flag_ref(node, first), int_const(node, "0"))]),
        ir_block(node, [ir_assign(node, ir_var_ref(tid, node, rec.c_spelling, name, rec.slot_form),
            ir_binary(tid, node, rec.c_spelling, "+",
                ir_var_ref(tid, node, rec.c_spelling, name, rec.slot_form),
                ir_const(tid, node, rec.c_spelling, "1")))]))
    let stop = if node_inclusive(iter) == 1 { ">" } else { ">=" }
    let cond = ir_binary(TYPE_INT, iter, int_spelling(iter), stop,
        ir_var_ref(tid, iter, rec.c_spelling, name, rec.slot_form),
        ir_var_ref(tid, iter, rec.c_spelling, end_name, rec.slot_form))
    let guard = ir_if(iter, cond, ir_block(iter, [ir_break(iter)]), -1)
    let body = lower_block(node_body(node))
    close_scope()
    if body < 0 { return -1 }
    ir_block(node, [init, end_let, first_let, ir_loop(node, ir_block(node, [step, guard, body]))])
}

// A read of a compiler-minted integer local: a range's first-turn flag, or a walk's index
// and length. Each read is a node of its own, because the verifier rejects one node
// reached from two places.
fn flag_ref(span: Int, name: Str) -> Int ! Diag.Report {
    ir_var_ref(TYPE_INT, span, int_spelling(span), name, int_form(span))
}

// ── With blocks ───────────────────────────────────────────────────────────

// A `with` binds one or more items around a body: `arena` for a fresh allocation arena,
// `name = expr` for a resource whose cleanup runs on every exit, and anything else for an
// effect handler. The items nest outside in, so the first item written is the outermost.
fn lower_with_block(node: Int, tail: Int, dest: Str, dest_tid: Int) -> Int ! Diag.Report {
    let items = node_handlers(node)
    let n = if items == -1 { 0 } else { sublist_length(items) }
    wrap_with_items(node, items, n, 0, tail, dest, dest_tid)
}

fn wrap_with_items(node: Int, items: Int, n: Int, i: Int, tail: Int, dest: Str, dest_tid: Int) -> Int ! Diag.Report {
    if i >= n { return lower_body_block(node_body(node), tail, dest, dest_tid) }
    let item = sublist_get(items, i)
    let kind = nk_of(node_kind(item))
    if kind == NodeKind.WithResource { return wrap_resource(node, items, n, i, tail, dest, dest_tid) }
    let rest = wrap_with_items(node, items, n, i + 1, tail, dest, dest_tid)
    if rest < 0 { return -1 }
    let inner = as_block(rest)
    if kind == NodeKind.Ident && node_name(item) == ARENA_ITEM {
        return ir_with_scope(item, "", -1, inner)
    }
    wrap_handler(item, inner)
}

// A scope and a handler each carry their body as a block, so an item that wraps another
// item seals that item's tree in a block of its own.
fn as_block(id: Int) -> Int {
    if ir_kind(id) == IrKind.Block { return id }
    ir_block(ir_span(id), [id])
}

// The resource binds before the body is lowered, so the body reads it, and the resource
// expression is lowered before the bind, so it cannot read the name it is defining.
//
// Which cleanup a resource gets is a question about the traits its type implements:
// Closeable closes it, BlockHandler hands it the block, an FFI scope frees its arena and
// a type with none of those is a plain binding. cg_eff_resource_cleanup answers the
// question and hands back the exit symbol to run on the way out, so this stage tests for
// a symbol rather than for a protocol: every protocol that names one is wrapped the same
// way, and a protocol added later needs nothing here. BlockHandler names none, because its
// binder holds the Context that enter() answers rather than the resource; it records its
// own internal error and the bind underneath it is left exactly as plain as it always
// was.
fn wrap_resource(node: Int, items: Int, n: Int, i: Int, tail: Int, dest: Str, dest_tid: Int) -> Int ! Diag.Report {
    let item = sublist_get(items, i)
    let _ = open_scope()
    let tid = stmt_tid(item)
    if tid < 0 {
        close_scope()
        return -1
    }
    let rec = layout_at(tid, Position.Local, item)
    let _ = ensure_typedef_for(tid)
    let name = node_name(item)
    let value = lower_value(node_value(item))
    bind_binder(cur_scope(), name, tid)
    let bound_name = cg_local_c_name(name)
    let bind = ir_let(tid, item, rec.c_spelling, bound_name, rec.slot_form, value)
    let cleanup = cg_eff_resource_cleanup(item)
    let rest = wrap_with_items(node, items, n, i + 1, tail, dest, dest_tid)
    close_scope()
    if rest < 0 { return -1 }
    let rest_block = as_block(rest)
    if cleanup.exit_symbol != "" {
        let resource_ref = ir_var_ref(tid, item, rec.c_spelling, bound_name, rec.slot_form)
        let scoped = ir_with_scope(item, cleanup.exit_symbol, resource_ref, rest_block)
        return ir_block(item, [bind, scoped])
    }
    ir_block(item, [bind, rest_block])
}

// A handler replaces one slot of the effect vector for the body. The slot is a C field
// name: a builtin effect names its root, a user effect names its handle under a prefix
// of its own. No producer spells either yet, so nothing here installs a handler.
fn wrap_handler(item: Int, inner: Int) -> Int ! Diag.Report {
    let tid = stmt_tid(item)
    if tid >= 0 && tc_tid_handler_effect(tid) == "" {
        diag_ice_at("UnnamedHandlerEffect", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "handler type {tid} names no effect", item,
            "a handler's tid carries the effect it handles")
    }
    diag_ice_stage_not_built("the effect vtable field a handler install writes", item)
    ir_block(item, [ir_expr_stmt(item, lower_value(item)), inner])
}

// ── Match ─────────────────────────────────────────────────────────────────

// What every arm of one match shares. The scrutinee is bound once, so each arm reads the
// same local, and the tail mode travels with it so an arm in tail position returns or
// stores from inside its own block.
type MatchCtx {
    tid: Int
    holder: Str
    rec: LayoutRecord
    tail: Int
    dest: Str
    dest_tid: Int
}

fn lower_match(node: Int, tail: Int, dest: Str, dest_tid: Int) -> Int ! Diag.Report {
    let scrut = node_scrutinee(node)
    let stid = stmt_tid(scrut)
    if stid < 0 { return -1 }
    let rec = layout_at(stid, Position.Local, scrut)
    let _ = ensure_typedef_for(stid)
    let holder = c_mint_local("scrut")
    let ctx = MatchCtx { tid: stid, holder: holder, rec: rec, tail: tail, dest: dest, dest_tid: dest_tid }
    let arms = node_arms(node)
    let n = if arms == -1 { 0 } else { sublist_length(arms) }
    let mut out: List[Int] = [ir_let(stid, scrut, rec.c_spelling, holder, rec.slot_form, lower_value(scrut))]
    let covered = arms_cover(arms, n, ctx)
    if !covered {
        // Nothing below may claim the match cannot fall through: a C `switch` that runs
        // no arm is well defined, and an unreachable marker on one that can is not.
        diag_ice_stage_not_built("a match with no arm that is guaranteed to run", node)
    }
    if arms_are_switchable(arms, n, ctx) {
        let sw = lower_match_switch(node, arms, n, ctx)
        if sw < 0 { return -1 }
        out.push(sw)
    } else {
        if !lower_match_chain(node, arms, n, ctx, covered, out) { return -1 }
    }
    ir_block(node, out)
}

// Whether one arm is guaranteed to run. An unguarded arm that matches anything covers the
// match; short of that, the unguarded arms must name every variant the scrutinee has.
// The names are collected rather than counted, so a variant written twice counts once and
// this does not rest on another pass having rejected the repeat. Nothing else is provable
// here, so nothing else is claimed.
fn arms_cover(arms: Int, n: Int, ctx: MatchCtx) -> Bool ! Diag.Report {
    let mut named: Map[Str, Int] = Map()
    let mut i = 0
    while i < n {
        let arm = sublist_get(arms, i)
        if node_guard(arm) < 0 {
            let pat = node_pattern(arm)
            if pattern_is_irrefutable(pat, ctx.tid) { return true }
            collect_labels(ctx, pat, named)
        }
        i = i + 1
    }
    let total = variant_count(ctx.tid)
    total > 0 && named.len() >= total
}

// Every variant one arm names. An or-pattern names one per alternative, so an arm written
// `A | B` covers two.
fn collect_labels(ctx: MatchCtx, raw: Int, named: Map[Str, Int]) ! Diag.Report {
    let pat = pattern_core(raw)
    if nk_of(node_kind(pat)) == NodeKind.OrPattern {
        let elems = node_elements(pat)
        if elems == -1 { return }
        let mut i = 0
        while i < sublist_length(elems) {
            collect_labels(ctx, sublist_get(elems, i), named)
            i = i + 1
        }
        return
    }
    if !pattern_is_labelled(pat, ctx.tid) { return }
    if nk_of(node_kind(pat)) == NodeKind.IntPattern {
        named.insert(node_str_val(pat), 1)
        return
    }
    named.insert(pattern_variant_name(pat), 1)
}

// How many variants the scrutinee's type has, or 0 when naming variants cannot exhaust
// it. A carrier has its two arms, a boolean its two values, an enum the ones its
// declaration lists.
fn variant_count(tid: Int) -> Int {
    if tid_is_carrier(tid) { return 2 }
    if tc_tid_kind(tid) == TyKind.Bool { return 2 }
    if tc_tid_kind(tid) != TyKind.Enum { return 0 }
    let td = c_decl_for_tid(tid)
    if td < 0 { return 0 }
    let flds = node_fields(td)
    if flds == -1 { return 0 }
    let mut n = 0
    let mut i = 0
    while i < sublist_length(flds) {
        if nk_of(node_kind(sublist_get(flds, i))) == NodeKind.TypeVariant { n = n + 1 }
        i = i + 1
    }
    n
}

fn scrut_ref(ctx: MatchCtx, span: Int) -> Int {
    ir_var_ref(ctx.tid, span, ctx.rec.c_spelling, ctx.holder, ctx.rec.slot_form)
}

fn int_spelling(span: Int) -> Str ! Diag.Report {
    layout_at(TYPE_INT, Position.Local, span).c_spelling
}

fn int_const(span: Int, literal: Str) -> Int ! Diag.Report {
    ir_const(TYPE_INT, span, int_spelling(span), literal)
}

// The value an arm label is compared against: an integer scrutinee compares with itself,
// a carrier or enum compares with its discriminant.
fn discriminant(ctx: MatchCtx, span: Int) -> Int ! Diag.Report {
    if tid_is_ordinal(ctx.tid) { return scrut_ref(ctx, span) }
    if !tid_is_tagged(ctx.tid) {
        diag_ice_stage_not_built("a match that compares a value holding no discriminant", span)
        return int_const(span, "0")
    }
    ir_carrier_tag(TYPE_INT, span, int_spelling(span), scrut_ref(ctx, span))
}

// A value one tag read tells apart: a carrier or a user enum. A struct, a tuple, a string
// and a float all hold no such member, so no arm of theirs is one equality.
fn tid_is_tagged(tid: Int) -> Bool {
    tid_is_carrier(tid) || tc_tid_kind(tid) == TyKind.Enum
}

fn tid_is_discriminable(tid: Int) -> Bool {
    tid_is_ordinal(tid) || tid_is_tagged(tid)
}

fn tid_is_ordinal(tid: Int) -> Bool {
    match tc_tid_kind(tid) {
        TyKind.Int => true
        TyKind.I8 => true
        TyKind.I16 => true
        TyKind.I32 => true
        TyKind.U8 => true
        TyKind.U16 => true
        TyKind.U32 => true
        TyKind.U64 => true
        TyKind.Char => true
        TyKind.Bool => true
        _ => false
    }
}

fn tid_is_carrier(tid: Int) -> Bool {
    let k = tc_tid_kind(tid)
    k == TyKind.Option || k == TyKind.Result
}

// ── Patterns: names and labels ────────────────────────────────────────────

// The variant a pattern names. A qualified pattern carries the enum in `name` and the
// variant in `type_name`; a bare one carries only the variant.
fn pattern_variant_name(pat: Int) -> Str {
    let qualified = node_type_name(pat)
    if qualified != "" { return qualified }
    node_name(pat)
}

// Whether a bare identifier in pattern position names a variant of the scrutinee rather
// than a new binder. The scrutinee's type decides; the spelling alone never does.
fn is_variant_name(tid: Int, name: Str) -> Bool {
    if tid_is_carrier(tid) {
        return name == VARIANT_SOME || name == VARIANT_NONE || name == VARIANT_OK || name == VARIANT_ERR
    }
    if tc_tid_kind(tid) != TyKind.Enum { return false }
    find_variant(c_decl_for_tid(tid), name) >= 0
}

// A tuple's members are positional: element i is the member the type's emitter laid out
// under that position. One spelling, so the three readers below cannot drift apart.
fn tuple_member(i: Int) -> Str { "_{i}" }

fn find_variant(td: Int, name: Str) -> Int {
    if td < 0 { return -1 }
    let flds = node_fields(td)
    if flds == -1 { return -1 }
    let mut i = 0
    while i < sublist_length(flds) {
        let v = sublist_get(flds, i)
        if nk_of(node_kind(v)) == NodeKind.TypeVariant && node_name(v) == name { return v }
        i = i + 1
    }
    -1
}

// The constant an arm's variant compares against. A carrier's numbers are fixed by the
// runtime header; an enum's come from the tag macro the type's own emitter defines.
fn variant_label(ctx: MatchCtx, pat: Int, vname: Str) -> Int ! Diag.Report {
    let k = tc_tid_kind(ctx.tid)
    if k == TyKind.Option {
        if vname == VARIANT_SOME { return int_const(pat, "{TAG_SOME}") }
        if vname == VARIANT_NONE { return int_const(pat, "{TAG_NONE}") }
        return unknown_variant(ctx, pat, vname)
    }
    if k == TyKind.Result {
        if vname == VARIANT_OK { return int_const(pat, "{TAG_OK}") }
        if vname == VARIANT_ERR { return int_const(pat, "{TAG_ERR}") }
        return unknown_variant(ctx, pat, vname)
    }
    let v = find_variant(c_decl_for_tid(ctx.tid), vname)
    if v < 0 { return unknown_variant(ctx, pat, vname) }
    let macro = c_variant_discriminant(ctx.tid, v)
    if diag_is_ice_seg(macro) {
        diag_ice_at("UnnameableVariantTag", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "variant {vname} of type {ctx.tid} has no spellable tag", pat,
            "an enum must be fully solved before its tags are spelled")
        return int_const(pat, "0")
    }
    int_const(pat, macro)
}

// A variant a pattern names that the scrutinee's type does not have. Codegen never
// decides which arm that is, so it reports and poisons the label.
fn unknown_variant(ctx: MatchCtx, pat: Int, vname: Str) -> Int ! Diag.Report {
    diag_ice_at("UnknownVariant", UNSOLVED_TYPEVAR_AT_CODEGEN,
        "type {ctx.tid} has no variant {vname}", pat,
        "a pattern is checked against its scrutinee's type before codegen runs")
    int_const(pat, "0")
}

// A pattern that matches whatever it is given: the fallthrough arm of a switch. A tuple
// or a struct pattern matches anything only when every part of it does, so `(1, y)` is
// refutable even though its shape always fits.
fn pattern_is_irrefutable(pat: Int, tid: Int) -> Bool ! Diag.Report {
    match nk_of(node_kind(pat)) {
        NodeKind.WildcardPattern => true
        NodeKind.IdentPattern => !is_variant_name(tid, node_name(pat))
        NodeKind.TuplePattern => elements_are_irrefutable(node_elements(pat))
        NodeKind.StructPattern => fields_are_irrefutable(node_fields(pat))
        NodeKind.AsPattern => pattern_is_irrefutable(node_pattern(pat), tid)
        _ => false
    }
}

// A part of a pattern decides on its own recorded type, because whether a bare name
// there binds or names a variant depends on what that part is matched against.
fn sub_is_irrefutable(sub: Int) -> Bool ! Diag.Report {
    if nk_of(node_kind(sub)) == NodeKind.WildcardPattern { return true }
    pattern_is_irrefutable(sub, stmt_tid(sub))
}

fn elements_are_irrefutable(elems: Int) -> Bool ! Diag.Report {
    if elems == -1 { return true }
    let mut i = 0
    while i < sublist_length(elems) {
        if !sub_is_irrefutable(sublist_get(elems, i)) { return false }
        i = i + 1
    }
    true
}

// A field written as `x` alone binds a fresh name and matches anything; only a field
// written as `x: p` carries a sub-pattern that can refuse.
fn fields_are_irrefutable(flds: Int) -> Bool ! Diag.Report {
    if flds == -1 { return true }
    let mut i = 0
    while i < sublist_length(flds) {
        let sub = node_pattern(sublist_get(flds, i))
        if sub >= 0 && !sub_is_irrefutable(sub) { return false }
        i = i + 1
    }
    true
}

// A pattern whose whole cond is one equality against a constant, which is what a switch
// can carry. Everything else needs an `if` chain.
fn pattern_core(pat: Int) -> Int {
    if nk_of(node_kind(pat)) == NodeKind.AsPattern { return node_pattern(pat) }
    pat
}

fn pattern_is_labelled(raw: Int, tid: Int) -> Bool ! Diag.Report {
    let pat = pattern_core(raw)
    match nk_of(node_kind(pat)) {
        NodeKind.IntPattern => tid_is_ordinal(tid)
        NodeKind.EnumPattern => payload_is_irrefutable(pat)
        NodeKind.IdentPattern => is_variant_name(tid, node_name(pat))
        _ => false
    }
}

// Whether the payload of a variant pattern accepts every value the variant can hold. When
// it does not, the arm is more than one tag comparison, so it is neither a switch label
// nor proof that the variant is covered.
fn payload_is_irrefutable(pat: Int) -> Bool ! Diag.Report {
    let flds = node_fields(pat)
    if flds == -1 { return true }
    if node_int_val(pat) == 1 { return fields_are_irrefutable(flds) }
    elements_are_irrefutable(flds)
}

fn pattern_label(ctx: MatchCtx, raw: Int) -> Int ! Diag.Report {
    let pat = pattern_core(raw)
    if nk_of(node_kind(pat)) == NodeKind.IntPattern {
        return ir_const(ctx.tid, pat, ctx.rec.c_spelling, node_str_val(pat))
    }
    variant_label(ctx, pat, pattern_variant_name(pat))
}

// ── Patterns: binders ─────────────────────────────────────────────────────

// Every name a pattern introduces becomes one Let at the top of the arm's block, read
// from the scrutinee local. A binder's type is the one recorded for the pattern node,
// never one derived from the shape around it.
// Answers false when a part of the pattern has no recorded type. A pattern binds all of
// its names or none of them: one name left out resolves to an outer declaration of the
// same name, and the arm then reads that declaration's type as if it were the right one.
fn pattern_binds(ctx: MatchCtx, pat: Int, out: List[Int]) -> Bool ! Diag.Report {
    match nk_of(node_kind(pat)) {
        NodeKind.IdentPattern => {
            bind_whole(ctx, pat, out)
            true
        }
        NodeKind.AsPattern => {
            bind_whole(ctx, pat, out)
            pattern_binds(ctx, node_pattern(pat), out)
        }
        NodeKind.EnumPattern => payload_binds(ctx, pat, out)
        NodeKind.TuplePattern => tuple_pattern_binds(ctx, pat, out)
        NodeKind.StructPattern => field_pattern_binds(ctx, pat, "", out)
        _ => true
    }
}

fn bind_whole(ctx: MatchCtx, pat: Int, out: List[Int]) ! Diag.Report {
    let name = node_name(pat)
    if name == "" || is_variant_name(ctx.tid, name) { return }
    bind_binder(cur_scope(), name, ctx.tid)
    out.push(ir_let(ctx.tid, pat, ctx.rec.c_spelling, cg_local_c_name(name), ctx.rec.slot_form,
        scrut_ref(ctx, pat)))
}

// A part of a pattern needs a recorded type only when it declares a name. A literal or a
// wildcard part binds nothing, so no later read of it can resolve to the wrong
// declaration: `(1, y)` carries no type on its `1` and never wanted one. A nested shape
// that the payload binder does not lower yet is reported by the binder and binds nothing
// either, so it does not need one before that report.
fn sub_pattern_declares(sub: Int) -> Bool {
    nk_of(node_kind(sub)) == NodeKind.IdentPattern
}

// One payload slot of a variant, bound from the value the reader hands back. A shape with
// no lowering yet is reported and left out, because the names around it still bind to the
// types they were given; a slot with no type at all stops the arm instead.
fn bind_slot(sub: Int, value: Int, out: List[Int]) -> Bool ! Diag.Report {
    let kind = nk_of(node_kind(sub))
    if kind == NodeKind.WildcardPattern { return true }
    if kind != NodeKind.IdentPattern {
        diag_ice_stage_not_built("a nested pattern inside a variant payload", sub)
        return true
    }
    let tid = stmt_tid(sub)
    if tid < 0 { return false }
    if is_variant_name(tid, node_name(sub)) {
        diag_ice_stage_not_built("a variant named inside a variant payload", sub)
        return true
    }
    bind_named(sub, node_name(sub), tid, layout_at(tid, Position.Local, sub), value, out)
    true
}

// One name, declared and bound to a value read out of the scrutinee.
fn bind_named(span: Int, name: Str, tid: Int, rec: LayoutRecord, value: Int, out: List[Int]) ! Diag.Report {
    let _ = ensure_typedef_for(tid)
    bind_binder(cur_scope(), name, tid)
    out.push(ir_let(tid, span, rec.c_spelling, cg_local_c_name(name), rec.slot_form, value))
}

// A carrier keeps its payload in a named member; a user enum keeps its in the union arm
// that carries the variant's own name.
fn payload_binds(ctx: MatchCtx, pat: Int, out: List[Int]) -> Bool ! Diag.Report {
    let flds = node_fields(pat)
    if flds == -1 || sublist_length(flds) == 0 { return true }
    let vname = pattern_variant_name(pat)
    if tid_is_carrier(ctx.tid) { return carrier_payload_bind(ctx, vname, flds, out) }
    if node_int_val(pat) == 1 { return field_pattern_binds(ctx, pat, "{c_enum_payload_member()}.{vname}", out) }
    positional_payload_binds(ctx, pat, vname, flds, out)
}

fn carrier_payload_bind(ctx: MatchCtx, vname: Str, flds: Int, out: List[Int]) -> Bool ! Diag.Report {
    let sub = sublist_get(flds, 0)
    let tid = stmt_tid(sub)
    if tid < 0 { return !sub_pattern_declares(sub) }
    let rec = layout_at(tid, Position.Local, sub)
    let member = carrier_member(vname)
    bind_slot(sub, ir_carrier_unwrap(tid, sub, rec.c_spelling, member, rec.slot_form,
        scrut_ref(ctx, sub)), out)
}

fn carrier_member(vname: Str) -> Str {
    if vname == VARIANT_OK { return CARRIER_OK }
    if vname == VARIANT_ERR { return CARRIER_ERR }
    STMT_CARRIER_VALUE
}

// The member name comes from the declaration's own field node, named or synthesized,
// because that is what the type's emitter laid out.
fn positional_payload_binds(ctx: MatchCtx, pat: Int, vname: Str, flds: Int, out: List[Int]) -> Bool ! Diag.Report {
    let vnode = find_variant(c_decl_for_tid(ctx.tid), vname)
    if vnode < 0 {
        let _ = unknown_variant(ctx, pat, vname)
        return false
    }
    let decl_flds = node_fields(vnode)
    let mut i = 0
    while i < sublist_length(flds) {
        let sub = sublist_get(flds, i)
        let tid = stmt_tid(sub)
        if tid < 0 {
            if sub_pattern_declares(sub) { return false }
        } else {
            if decl_flds == -1 || i >= sublist_length(decl_flds) {
                return payload_field_count_mismatch(sub, ctx.tid, vname)
            }
            let member = c_field_name(node_name(sublist_get(decl_flds, i)))
            let rec = layout_at(tid, Position.Local, sub)
            let path = "{c_enum_payload_member()}.{vname}.{member}"
            let read = ir_field_get(tid, sub, rec.c_spelling, path, rec.slot_form,
                scrut_ref(ctx, sub))
            if !bind_slot(sub, read, out) { return false }
        }
        i = i + 1
    }
    true
}

// A pattern names more positional slots than the variant declares fields for. Typecheck
// checks a pattern's arity against its variant's before codegen runs.
fn payload_field_count_mismatch(pat: Int, tid: Int, vname: Str) -> Bool ! Diag.Report {
    diag_ice_at("PayloadFieldCountMismatch", UNSOLVED_TYPEVAR_AT_CODEGEN,
        "variant {vname} of type {tid} has fewer fields than this pattern names", pat,
        "a pattern's arity is checked against its variant's before codegen runs")
    false
}

// Struct-shaped fields, either of a struct pattern (no prefix) or of a struct-shaped
// variant payload (the union arm is the prefix).
fn field_pattern_binds(ctx: MatchCtx, pat: Int, prefix: Str, out: List[Int]) -> Bool ! Diag.Report {
    let flds = node_fields(pat)
    if flds == -1 { return true }
    let mut i = 0
    while i < sublist_length(flds) {
        let f = sublist_get(flds, i)
        // A field written as `x` is its own binder; only `x: p` carries a sub-pattern.
        let sub = node_pattern(f)
        let holder = if sub < 0 { f } else { sub }
        let tid = stmt_tid(holder)
        // A shorthand field is a binder itself, so it always wants a type.
        if tid < 0 {
            if sub < 0 || sub_pattern_declares(sub) { return false }
        } else {
            let rec = layout_at(tid, Position.Local, holder)
            let path = if prefix == "" { node_name(f) } else { "{prefix}.{node_name(f)}" }
            let read = ir_field_get(tid, holder, rec.c_spelling, path, rec.slot_form,
                scrut_ref(ctx, holder))
            if sub < 0 {
                bind_named(holder, node_name(f), tid, rec, read, out)
            } else {
                if !bind_slot(sub, read, out) { return false }
            }
        }
        i = i + 1
    }
    true
}

fn tuple_pattern_binds(ctx: MatchCtx, pat: Int, out: List[Int]) -> Bool ! Diag.Report {
    let elems = node_elements(pat)
    if elems == -1 { return true }
    let mut i = 0
    while i < sublist_length(elems) {
        let sub = sublist_get(elems, i)
        let tid = stmt_tid(sub)
        if tid < 0 {
            if sub_pattern_declares(sub) { return false }
        } else {
            let rec = layout_at(tid, Position.Local, sub)
            let read = ir_field_get(tid, sub, rec.c_spelling, tuple_member(i), rec.slot_form,
                scrut_ref(ctx, sub))
            if !bind_slot(sub, read, out) { return false }
        }
        i = i + 1
    }
    true
}

// ── Patterns: tests ───────────────────────────────────────────────────────

// The condition under which an arm runs, or -1 when the arm always runs. Binders are not
// in scope here: a cond reads the scrutinee only, so an arm's guard is applied separately
// once its binders exist.
fn pattern_test(ctx: MatchCtx, pat: Int) -> Int ! Diag.Report {
    let kind = nk_of(node_kind(pat))
    if pattern_is_irrefutable(pat, ctx.tid) { return -1 }
    if pattern_is_labelled(pat, ctx.tid) {
        return ir_binary(TYPE_INT, pat, int_spelling(pat), "==",
            discriminant(ctx, pat), pattern_label(ctx, pat))
    }
    if kind == NodeKind.RangePattern { return range_test(ctx, pat) }
    if kind == NodeKind.OrPattern { return or_test(ctx, pat) }
    if kind == NodeKind.StringPattern { return string_pattern_test(ctx, pat) }
    diag_ice_stage_not_built("a match on this pattern shape", pat)
    int_const(pat, "0")
}

// `"lit"` against a Str scrutinee. C compares a const char* by address, so this is not a
// label C can switch on; the test is the same runtime equality call a `==` on two Str
// expressions lowers to, against a Str constant built from the pattern's own content.
fn string_pattern_test(ctx: MatchCtx, pat: Int) -> Int ! Diag.Report {
    let bool_rec = layout_at(TYPE_BOOL, Position.Local, pat)
    if x_stopped(bool_rec) { return -1 }
    let str_rec = layout_at(TYPE_STR, Position.Local, pat)
    if x_stopped(str_rec) { return -1 }
    let lit = ir_const(TYPE_STR, pat, str_rec.c_spelling, c_string_literal(node_str_val(pat)))
    ir_call_runtime(TYPE_BOOL, pat, bool_rec.c_spelling, c_runtime_helper("str_eq"),
        bool_rec.slot_form, [scrut_ref(ctx, pat), lit])
}

// `lo..hi` on an ordinal. An inclusive range takes the high end too.
fn range_test(ctx: MatchCtx, pat: Int) -> Int ! Diag.Report {
    if !tid_is_ordinal(ctx.tid) {
        diag_ice_stage_not_built("a range pattern over a non-ordinal scrutinee", pat)
        return int_const(pat, "0")
    }
    let spell = ctx.rec.c_spelling
    let lo = ir_binary(TYPE_INT, pat, int_spelling(pat), ">=",
        scrut_ref(ctx, pat), ir_const(ctx.tid, pat, spell, node_str_val(pat)))
    let op = if node_inclusive(pat) == 1 { "<=" } else { "<" }
    let hi = ir_binary(TYPE_INT, pat, int_spelling(pat), op,
        scrut_ref(ctx, pat), ir_const(ctx.tid, pat, spell, node_name(pat)))
    ir_binary(TYPE_INT, pat, int_spelling(pat), "&&", lo, hi)
}

// `a | b | c`. An alternative binds nothing, so the arms join with `||` and the arm body
// is built once.
fn or_test(ctx: MatchCtx, pat: Int) -> Int ! Diag.Report {
    let elems = node_elements(pat)
    let n = if elems == -1 { 0 } else { sublist_length(elems) }
    if n == 0 { return int_const(pat, "0") }
    let mut acc = pattern_test(ctx, sublist_get(elems, 0))
    if acc < 0 { return -1 }
    let mut i = 1
    while i < n {
        let next = pattern_test(ctx, sublist_get(elems, i))
        if next < 0 { return -1 }
        acc = ir_binary(TYPE_INT, pat, int_spelling(pat), "||", acc, next)
        i = i + 1
    }
    acc
}

// ── Arms ──────────────────────────────────────────────────────────────────

// One arm's block: its binders, then its body under the match's tail mode. The binder
// scope opens and closes around the arm so two arms can bind the same name.
fn arm_block(ctx: MatchCtx, arm: Int, extra: List[Int]) -> Int ! Diag.Report {
    let _ = open_scope()
    let mut out: List[Int] = []
    if !pattern_binds(ctx, node_pattern(arm), out) {
        close_scope()
        return -1
    }
    let mut i = 0
    while i < extra.len() {
        out.push(extra.get(i).unwrap())
        i = i + 1
    }
    let body = lower_body_block(node_body(arm), ctx.tail, ctx.dest, ctx.dest_tid)
    close_scope()
    if body < 0 { return -1 }
    out.push(body)
    ir_block(arm, out)
}

// A guarded arm decides inside its own block, because the guard reads binders the pattern
// introduced. The statements that mark the arm taken sit under the guard with the body.
fn guarded_arm_block(ctx: MatchCtx, arm: Int, guard: Int, extra: List[Int]) -> Int ! Diag.Report {
    let _ = open_scope()
    let mut out: List[Int] = []
    if !pattern_binds(ctx, node_pattern(arm), out) {
        close_scope()
        return -1
    }
    let mut inner: List[Int] = []
    let mut i = 0
    while i < extra.len() {
        inner.push(extra.get(i).unwrap())
        i = i + 1
    }
    let body = lower_body_block(node_body(arm), ctx.tail, ctx.dest, ctx.dest_tid)
    if body < 0 {
        close_scope()
        return -1
    }
    inner.push(body)
    // The guard is read only once this arm's pattern matched. A statement the guard needed
    // has no place in this arm's block either: the block is reached after the pattern test,
    // but the statements would have to stand above the guard's own `if`, and the enclosing
    // block is what takes them, which puts them above the whole match. There they run for
    // arms that never match, and the guard of one arm would read a temp another arm filled.
    let mark = cg_expr_pending_count()
    let tested = lower_value(guard)
    let hoisted = cg_expr_take_pending(mark)
    if hoisted.len() > 0 {
        close_scope()
        diag_ice_at("HoistOutOfMatchGuard", CODEGEN_STAGE_NOT_BUILT,
            "this match guard needs a statement run before it, and there it would run for arms that never match",
            guard,
            "a guard that needs a temp has no lowering yet; bind the value in a let above the match and test that")
        return -1
    }
    out.push(ir_if(arm, tested, ir_block(arm, inner), -1))
    close_scope()
    ir_block(arm, out)
}

// ── Match shapes ──────────────────────────────────────────────────────────

// A match every arm of which is one equality against a constant, with at most a single
// catch-all last. That shape is a switch; anything else needs the chain below.
fn arms_are_switchable(arms: Int, n: Int, ctx: MatchCtx) -> Bool ! Diag.Report {
    if n == 0 { return false }
    if !tid_is_discriminable(ctx.tid) { return false }
    let mut i = 0
    while i < n {
        let arm = sublist_get(arms, i)
        if node_guard(arm) >= 0 { return false }
        let pat = node_pattern(arm)
        if pattern_is_irrefutable(pat, ctx.tid) {
            if i != n - 1 { return false }
        } else if !pattern_is_labelled(pat, ctx.tid) {
            return false
        }
        i = i + 1
    }
    true
}

fn lower_match_switch(node: Int, arms: Int, n: Int, ctx: MatchCtx) -> Int ! Diag.Report {
    let mut cases: List[Int] = []
    let mut default_block = -1
    let none: List[Int] = []
    let mut i = 0
    while i < n {
        let arm = sublist_get(arms, i)
        // The label is read before the arm is lowered, so an arm that names a variant the
        // scrutinee has not reports that ahead of whatever its body reports.
        let catch_all = pattern_is_irrefutable(node_pattern(arm), ctx.tid)
        let label = if catch_all { -1 } else { pattern_label(ctx, node_pattern(arm)) }
        let block = arm_block(ctx, arm, none)
        if block < 0 { return -1 }
        if catch_all {
            default_block = block
        } else {
            cases.push(label)
            cases.push(block)
        }
        i = i + 1
    }
    // No default arm when none was written: the arms already name every variant, so a
    // fallthrough branch would be dead code the printer would still have to place.
    ir_switch(node, discriminant(ctx, node), cases, default_block)
}

// The general shape: one `if` per arm, each gated on a flag that later arms read, so a
// guard that fails falls through to the next arm without the rest of the chain being
// built twice. A match none of whose arms ran is unreachable by construction.
fn lower_match_chain(node: Int, arms: Int, n: Int, ctx: MatchCtx, covered: Bool, out: List[Int]) -> Bool ! Diag.Report {
    let flag = c_mint_local("taken")
    out.push(ir_let(TYPE_INT, node, int_spelling(node), flag, int_form(node),
        int_const(node, "0")))
    let mut i = 0
    while i < n {
        let arm = sublist_get(arms, i)
        let mark: List[Int] = [ir_assign(arm, flag_ref(arm, flag), int_const(arm, "1"))]
        let guard = node_guard(arm)
        let block = if guard < 0 { arm_block(ctx, arm, mark) } else { guarded_arm_block(ctx, arm, guard, mark) }
        if block < 0 { return false }
        let cond = pattern_test(ctx, node_pattern(arm))
        out.push(ir_if(arm, chain_condition(arm, flag, cond), block, -1))
        i = i + 1
    }
    if covered { out.push(ir_if(node, not_taken(node, flag), ir_block(node, [ir_unreachable(node)]), -1)) }
    true
}

fn not_taken(span: Int, flag: Str) -> Int ! Diag.Report {
    ir_binary(TYPE_INT, span, int_spelling(span), "==", flag_ref(span, flag),
        int_const(span, "0"))
}

fn chain_condition(span: Int, flag: Str, cond: Int) -> Int ! Diag.Report {
    if cond < 0 { return not_taken(span, flag) }
    ir_binary(TYPE_INT, span, int_spelling(span), "&&", not_taken(span, flag), cond)
}
