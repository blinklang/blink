// cg_trace.bl: the enter, exit and state events of a traced function (§8.15).
//
// A unit built with --trace calls the runtime tracer at the start of each traced body and at
// each of its exits. A unit built without it holds no trace code at all, so a plain build
// pays nothing at run time. The runtime keeps the call stack: blink_trace_fn_enter pushes
// the call, whether or not the filters print the events, and the cleanup of one local of the
// body pops it. A `with` scope in the body ends with its own C cleanup, after the body's
// return statement, so the pop and the exit event wait for those cleanups: a call they make
// is inside the traced call. Each exit keeps its return text for the pop to print.
//
// Each event renders its values only after the runtime says the event prints, so a call the
// filters leave out pays for no Display call. A value shows its Display text, else its Debug
// text, else the name of its type, and is never left out (§8.15.9). The render runs with the
// tracer muted, so a traced call that a Display or Debug impl makes writes no event.
//
// A write to a whole `let mut` binding, local or module-level, in a traced body writes a
// state event with the binding's value after the write.
//
// A body is traced when it is a fn or a method of the program or of a package it uses, and
// not of the std library (§8.15.8). A method that the compiler writes, such as the enter and
// exit of the BlockHandler impl that an `impl Closeable` gets, is no frame: no source text
// spells it. The driver arms a body before it lowers it, and lower_fn takes the arm, so the
// closures a body queued, which lower after it, carry no trace calls of that body.
//
// A closure and the body of an operation in a handler literal are frames of their own, named
// after the frame that holds them. The thunk queue lowers them after that frame's body is
// done, so each takes its frame name when it is queued, while the frame that holds it is the
// one being lowered. The default body of an operation of a user effect is a frame too, which
// the driver arms with its effect.

import std.path.{path_stem}
import ast.{NodeKind}
import parser.{impl_provided_by_closeable, node_col, node_elements, node_kind, node_line, node_methods, node_module, node_name, node_params, sublist_get, sublist_length}
import typecheck.{TyKind, TYPE_BOOL, TYPE_INT, TYPE_STR, TYPE_VOID, builtin_effect_op_sub, builtin_op_sub_effect, io_op_sub_effect, tc_get_dotted_module_path, tc_handler_effect_root, tc_module_in_std, tc_tid_kind, tc_type_str}
import layout.{LayoutRecord, Position, layout_of, tid_of_node}
import cname.{c_local_name, c_mint_local, c_runtime_helper, c_str_const}
import ir.{ir_block, ir_call_runtime, ir_col, ir_const, ir_expr_stmt, ir_if, ir_let, ir_line_text, ir_trace_frame, ir_var_ref}
import diagnostics.{Diag, diag_file_for_node}
import cg_reg.{cg_reg_effect_root_decl, cg_reg_impl_of}
import cg_call.{cg_call_has_debug, lower_debug_of_value}
import cg_derive.{cg_derive_container_debug_renders, cg_derive_container_debug_text}
import cg_expr.{cg_expr_can_display, cg_expr_display_text, cg_expr_pending_count, cg_expr_take_pending, x_layout_checked, x_stopped}

// on: the unit is built with --trace. armed: the declaration the driver will lower next, or
// -1, and armed_effect the effect that declares it when it is the default body of an
// operation. traced: the body being lowered is traced, and fn_name and module name its events.
// mut_self_call: the last method call of the body built against a `mut self` declaration,
// which the dispatch finds deep down and the state event of the call reads after it.
type TraceUnit {
    on: Bool = false
    armed: Int = -1
    armed_effect: Int = -1
    traced: Bool = false
    fn_name: Str = ""
    module: Str = ""
    mut_self_call: Int = -1
}

let mut tr_unit = TraceUnit {}

pub fn cg_trace_set(on: Bool) { tr_unit = TraceUnit { on: on } }

pub fn cg_trace_on() -> Bool { tr_unit.on }

// The driver arms each fn and each impl method before it lowers the body. A test block and a
// derived operation are never armed.
pub fn cg_trace_arm(decl: Int) {
    if !tr_unit.on || node_kind(decl) != NodeKind.FnDef { return }
    tr_unit = TraceUnit { on: true, armed: decl }
}

// The default body of an operation of `effect_decl` is armed with its effect, which names it.
pub fn cg_trace_arm_default(op: Int, effect_decl: Int) {
    if !tr_unit.on { return }
    tr_unit = TraceUnit { on: true, armed: op, armed_effect: effect_decl }
}

// Takes the arm when it names this body, and answers the statements that open the body:
// the push, and the enter event when it prints. None when the body is not traced.
pub fn cg_trace_body_enter(fn_node: Int) -> List[Int] ! Diag.Report {
    let armed = tr_unit.armed == fn_node
    let effect_decl = tr_unit.armed_effect
    tr_unit = TraceUnit { on: tr_unit.on }
    if !armed { return [] }
    if effect_decl >= 0 {
        if tc_module_in_std(tr_module_key(effect_decl)) { return [] }
        let module = tr_module_name(effect_decl)
        let path = tr_effect_path(node_name(effect_decl), node_name(fn_node))
        return tr_enter(fn_node, fn_node, "{module}.{path}.{node_name(fn_node)}", module, tr_param_tids(fn_node))
    }
    if tc_module_in_std(tr_module_key(fn_node)) || tr_compiler_written(fn_node) { return [] }
    let module = tr_module_name(fn_node)
    tr_enter(fn_node, fn_node, tr_frame_name(fn_node, module), module, tr_param_tids(fn_node))
}

// The frame name of a closure written at `node` in the body being lowered, or "" when that
// body is not traced, as a closure in the std library is no frame (§8.15.8).
pub fn cg_trace_closure_frame(node: Int) -> Str {
    if !tr_unit.traced { return "" }
    "{tr_unit.fn_name}.fn@{node_line(node)}:{node_col(node)}"
}

// The frame name of the body of operation `op` in a handler literal of `eff` written at
// `node` in the body being lowered, or "" when that body is not traced.
pub fn cg_trace_handler_frame(node: Int, eff: Str, op: Str) -> Str {
    if !tr_unit.traced { return "" }
    let path = tr_effect_path(eff, op)
    "{tr_unit.fn_name}.handler@{node_line(node)}:{node_col(node)}.{path}.{op}"
}

// The module of the events of the body being lowered, which a closure or a handler body
// written in it shares.
pub fn cg_trace_frame_module() -> Str { tr_unit.module }

// The statements that open the body of a closure or a handler operation that is the frame
// `fn_name`: the push, and the enter event when it prints. `sig` holds the parameters, whose
// types are `tids`, and `at` is the keyword the enter event names in its span. None when
// fn_name is "".
pub fn cg_trace_thunk_enter(sig: Int, at: Int, fn_name: Str, module: Str, tids: List[Int]) -> List[Int] ! Diag.Report {
    tr_unit = TraceUnit { on: tr_unit.on }
    if fn_name.is_empty() { return [] }
    tr_enter(sig, at, fn_name, module, tids)
}

fn tr_param_tids(fn_node: Int) -> List[Int] ! Diag.Report {
    let mut out: List[Int] = []
    let params = node_params(fn_node)
    let n = if params == -1 { 0 } else { sublist_length(params) }
    let mut i = 0
    while i < n {
        out.push(tid_of_node(sublist_get(params, i)))
        i = i + 1
    }
    out
}

// The push and the enter event of a frame. The span of the event is the place of `at`.
fn tr_enter(sig: Int, at: Int, fn_name: Str, module: Str, tids: List[Int]) -> List[Int] ! Diag.Report {
    let mut args = [tr_text(at, fn_name), tr_text(at, module),
        tr_text(at, diag_file_for_node(at)), tr_int(at, ir_line_text(at)),
        tr_int(at, "{ir_col(at)}")]
    let params = node_params(sig)
    let n = if params == -1 { 0 } else { sublist_length(params) }
    if tids.len() != n { return [] }
    args.push(tr_int(at, "{n}"))
    let render: List[Int] = []
    let mut i = 0
    while i < n {
        let p = sublist_get(params, i)
        let tid = tids.get(i).unwrap()
        if tid < 0 { return [] }
        let rec = tr_local(tid, p)
        if x_stopped(rec) { return [] }
        let text = tr_value(p, tid, ir_var_ref(tid, p, rec.c_spelling, c_local_name(node_name(p)), rec.slot_form), render)
        if text < 0 { return [] }
        args.push(tr_text(p, node_name(p)))
        args.push(text)
        i = i + 1
    }
    let mut event = tr_muted(at, render)
    event.push(tr_call(at, TYPE_VOID, "trace_enter_event", args))
    let gate = tr_call_value(at, TYPE_BOOL, "trace_fn_enter", [tr_text(at, fn_name), tr_text(at, module)])
    tr_unit = TraceUnit { on: true, traced: true, fn_name: fn_name, module: module }
    [ir_if(at, gate, ir_block(at, event), -1), ir_trace_frame(at)]
}

// The body has lowered: nothing after it is the traced body.
pub fn cg_trace_body_leave() { tr_unit = TraceUnit { on: tr_unit.on } }

// Whether the body being lowered is traced.
pub fn cg_trace_body_traced() -> Bool { tr_unit.traced }

// The method call `node` has been built against a declaration with a `mut self` receiver.
pub fn cg_trace_note_mut_self_call(node: Int) {
    if tr_unit.traced { tr_unit.mut_self_call = node }
}

// Whether `node` is the last method call built against a `mut self` declaration.
pub fn cg_trace_is_mut_self_call(node: Int) -> Bool { node >= 0 && tr_unit.mut_self_call == node }

// The statements before an exit with a value, which `value` reads. None when the body is
// not traced.
pub fn cg_trace_exit_value(node: Int, tid: Int, value: Int) -> List[Int] ! Diag.Report {
    if !cg_trace_body_traced() { return [] }
    let render: List[Int] = []
    let text = tr_value(node, tid, value, render)
    if text < 0 { return [] }
    tr_exit(node, tr_muted(node, render), text)
}

// The statements before an exit with no value. None when the body is not traced.
pub fn cg_trace_exit_void(node: Int) -> List[Int] ! Diag.Report {
    if !cg_trace_body_traced() { return [] }
    tr_exit(node, [], tr_text(node, "()"))
}

// The statements after a change `op` of the `let mut` binding `var` (§8.15.11), which `value`
// reads once the change is done. None when the body is not traced.
pub fn cg_trace_state(node: Int, var: Str, op: Str, tid: Int, value: Int) -> List[Int] ! Diag.Report {
    if !cg_trace_body_traced() || tid < 0 { return [] }
    let render: List[Int] = []
    let text = tr_value(node, tid, value, render)
    if text < 0 { return [] }
    let mut event = tr_muted(node, render)
    let fn_name = tr_text(node, tr_unit.fn_name)
    let module = tr_text(node, tr_unit.module)
    event.push(tr_call(node, TYPE_VOID, "trace_state_emit", [fn_name, module, tr_text(node, var), tr_text(node, op), text]))
    let gate = tr_call_value(node, TYPE_BOOL, "trace_on_state", [tr_text(node, tr_unit.fn_name), tr_text(node, tr_unit.module), tr_text(node, var)])
    [ir_if(node, gate, ir_block(node, event), -1)]
}

fn tr_exit(node: Int, render: List[Int], text: Int) -> List[Int] ! Diag.Report {
    let mut event = render
    event.push(tr_call(node, TYPE_VOID, "trace_exit_keep", [text]))
    let gate = tr_call_value(node, TYPE_BOOL, "trace_on_exit", [])
    [ir_if(node, gate, ir_block(node, event), -1)]
}

// The value string of a value (§8.15.9). The statements that build it go into `render`, and
// the last of them holds the text in a temp, so the render is over before the event is
// written. -1 when the render stopped.
fn tr_value(node: Int, tid: Int, value: Int, render: List[Int]) -> Int ! Diag.Report {
    let mark = cg_expr_pending_count()
    let text = tr_value_text(node, tid, value)
    if text < 0 { return -1 }
    for s in cg_expr_take_pending(mark) { render.push(s) }
    let rec = layout_of(TYPE_STR, Position.Local)
    let held = c_mint_local("trace_value")
    render.push(ir_let(TYPE_STR, node, rec.c_spelling, held, rec.slot_form, text))
    ir_var_ref(TYPE_STR, node, rec.c_spelling, held, rec.slot_form)
}

// The unit value is `()`, the text the return of a fn with no value has (§8.15.4).
fn tr_value_text(node: Int, tid: Int, value: Int) -> Int ! Diag.Report {
    if tc_tid_kind(tid) == TyKind.Void { return tr_text(node, "()") }
    if cg_expr_can_display(node, tid) { return cg_expr_display_text(node, tid, value) }
    if cg_call_has_debug(node, tid) { return lower_debug_of_value(node, tid, value) }
    if cg_derive_container_debug_renders(tid) { return cg_derive_container_debug_text(tid, value, node) }
    tr_text(node, "<{tc_type_str(tid)}>")
}

// The render statements with the tracer muted around them.
fn tr_muted(span: Int, render: List[Int]) -> List[Int] {
    let mut out = [tr_call(span, TYPE_VOID, "trace_mute", [])]
    for s in render { out.push(s) }
    out.push(tr_call(span, TYPE_VOID, "trace_unmute", []))
    out
}

// The module key of a fn. The loader marks the impl with its module and not the methods in it.
fn tr_module_key(fn_node: Int) -> Str {
    let m = node_module(fn_node)
    let im = cg_reg_impl_of(fn_node)
    if m == "" && im >= 0 { node_module(im) } else { m }
}

// The module an event names. The entry file's module is the package, which takes the name
// of the file (§8.15.7 names a fn of main.bl `main.lower`). Any other module takes its name in
// the program, as a filter matches that name (§8.15.5), not its C prefix. A key that
// `@module` set is that name; any other key is the import path with `_` for each `.`.
fn tr_module_name(fn_node: Int) -> Str {
    let m = tr_module_key(fn_node)
    if m == "" || m == "__main__" { return path_stem(diag_file_for_node(fn_node)) }
    let dotted = tc_get_dotted_module_path(m)
    if dotted.replace(".", "_") == m { dotted } else { m }
}

// The BlockHandler enter and exit of an `impl Closeable` are code the user did not write.
fn tr_compiler_written(fn_node: Int) -> Bool {
    let im = cg_reg_impl_of(fn_node)
    im >= 0 && impl_provided_by_closeable(im)
}

// `module.function`, or `module.Type.method` for a method (§8.15.8). The impl may write its
// receiver qualified or with type args, and the frame names the type by its bare name, as a
// name holds no bracket and the module already says where the code is.
fn tr_frame_name(fn_node: Int, module: Str) -> Str {
    let im = cg_reg_impl_of(fn_node)
    if im < 0 { return "{module}.{node_name(fn_node)}" }
    let written = node_name(im)
    let head = written.split("[").get(0) ?? written
    let parts = head.split(".")
    "{module}.{parts.get(parts.len() - 1) ?? head}.{node_name(fn_node)}"
}

// The effect that declares operation `op` of a handler of `eff`, written with its parent,
// as in `Log.Out` or `IO.Print` (§8.15.8). An effect with no sub-effect that declares the
// operation is the root alone.
fn tr_effect_path(eff: Str, op: Str) -> Str {
    let root = tc_handler_effect_root(eff)
    let decl = cg_reg_effect_root_decl(eff)
    if decl >= 0 {
        let children = node_elements(decl)
        let n = if children == -1 { 0 } else { sublist_length(children) }
        let mut i = 0
        while i < n {
            let child = sublist_get(children, i)
            let ops = node_methods(child)
            let m = if ops == -1 { 0 } else { sublist_length(ops) }
            let mut k = 0
            while k < m {
                if node_name(sublist_get(ops, k)) == op { return "{root}.{node_name(child)}" }
                k = k + 1
            }
            i = i + 1
        }
        return root
    }
    let sub = builtin_effect_op_sub(root, op)
    if sub == "" { root } else { "{root}.{sub}" }
}

fn tr_local(tid: Int, node: Int) -> LayoutRecord ! Diag.Report {
    x_layout_checked(layout_of(tid, Position.Local), node, "UnspellableTracedValue",
        "a traced value has no C layout", "monomorphisation must resolve every type codegen reads; this is a compiler bug")
}

fn tr_text(span: Int, text: Str) -> Int {
    ir_const(TYPE_STR, span, layout_of(TYPE_STR, Position.Local).c_spelling, c_str_const(text))
}

fn tr_int(span: Int, literal: Str) -> Int {
    ir_const(TYPE_INT, span, layout_of(TYPE_INT, Position.Local).c_spelling, literal)
}

fn tr_call_value(span: Int, tid: Int, helper: Str, args: List[Int]) -> Int {
    let rec = layout_of(tid, Position.Return)
    ir_call_runtime(tid, span, rec.c_spelling, c_runtime_helper(helper), rec.slot_form, args)
}

fn tr_call(span: Int, tid: Int, helper: Str, args: List[Int]) -> Int {
    ir_expr_stmt(span, tr_call_value(span, tid, helper, args))
}
