import compiler.{compile_to_program, check_unused_imports, loaded_inputs}
import lexer.{Lex}
import parser.{Parse}
import typecheck.{TypeCheck, check_types, desugar_sealed_ops_calls}
import mutation_analysis.{analyze_mutations, analyze_save_restore}
import escape.{analyze_escapes}
import mono.{run_mono}
import diagnostics.{Diag, diag_count, diag_warn_count, diag_ice_count, diag_render, json_escape}

// check_pipeline.bl — the one check every path answers with
//
// `blink check`, the daemon and the LSP each call check_source, so none of them can stop
// short of a stage the build runs and say clean on a program the build refuses. The build
// paths call run_build_analyses for the same stages in the same order.

// Some rules are judged only after typecheck: mono judges the pointee of `Ptr[T]` per
// instance, and the mutation passes warn on unrestored state. Mono assumes a well-typed
// program, so the build runs these only on a clean front end.
pub fn run_build_analyses(program: Int) ! Diag.Report {
    desugar_sealed_ops_calls(program)
    analyze_mutations(program)
    analyze_save_restore(program)
    analyze_escapes(program)
    run_mono(program)
}

// The inputs of the last check_source, so a caller that answers many checks can tell whether
// a new one could say anything different.
type CheckedInputs {
    // The entry the check ran on, or "" before any check.
    source: Str
    // Each file it read, beside the bytes it read.
    paths: List[Str]
    texts: List[Str]
    // Each path the loader probed, beside whether a file was there.
    probe_paths: List[Str]
    probe_found: List[Bool]
}

fn checked_inputs_empty() -> CheckedInputs {
    CheckedInputs { source: "", paths: [], texts: [], probe_paths: [], probe_found: [] }
}

let mut checked: CheckedInputs = checked_inputs_empty()

// What the front end reported before the build analyses ran. A build prints it there, and
// stops on an error, or on a warning under --strict, so a build from a checked program
// prints and stops from this.
pub type FrontEndReport {
    errors: Int
    warnings: Int
    ices: Int
    // What diag_flush printed at that point in a build.
    human: Str
}

// A check sees the whole program, so it loads the imports and the prelude as the build
// does. Escape analysis needs no well-typed program, so it still runs when the front end
// has errors and reports what it finds next to them.
pub fn check_source(source_path: Str) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck {
    let (program, _) = check_source_reporting(source_path)
    program
}

// check_source, and what its front end reported.
pub fn check_source_reporting(source_path: Str) -> (Int, FrontEndReport) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck {
    let program = compile_to_program(source_path, 1)
    check_types(program)
    check_unused_imports()
    let front = FrontEndReport { errors: diag_count, warnings: diag_warn_count, ices: diag_ice_count, human: diag_render(0) }
    if diag_ice_count > 0 || diag_count > 0 {
        analyze_escapes(program)
    } else {
        run_build_analyses(program)
    }
    record_checked_inputs(source_path)
    (program, front)
}

fn record_checked_inputs(source_path: Str) {
    checked = checked_inputs_empty()
    checked.source = source_path
    let mut i = 0
    while i < loaded_inputs.source_paths.len() {
        checked.paths.push(loaded_inputs.source_paths.get(i).unwrap())
        checked.texts.push(loaded_inputs.source_texts.get(i).unwrap())
        i = i + 1
    }
    i = 0
    while i < loaded_inputs.config_paths.len() {
        checked.paths.push(loaded_inputs.config_paths.get(i).unwrap())
        checked.texts.push(loaded_inputs.config_texts.get(i).unwrap())
        i = i + 1
    }
    i = 0
    while i < loaded_inputs.embed_paths.len() {
        let p = loaded_inputs.embed_paths.get(i).unwrap()
        checked.paths.push(p)
        checked.texts.push(loaded_inputs.embed_texts.get(p).unwrap())
        i = i + 1
    }
    for p in loaded_inputs.probe_paths {
        checked.probe_paths.push(p)
        checked.probe_found.push(loaded_inputs.probe_found.get(p).unwrap())
    }
}

// A check is current while every file it read holds the same bytes and every path the
// loader probed gives the same answer. The loader acts on nothing else that can change while
// the process runs: its env, argv0 and cwd stay as they were. Compares bytes, not mtimes: an
// edit inside one mtime tick still counts. The probes catch a file the last check did not
// read: a new module an import needed, or one that now shadows the file an import found.
pub fn checked_inputs_changed(source_path: Str) -> Bool {
    if checked.source == "" || checked.source != source_path { return true }
    if checked_probes_changed() { return true }
    let mut i = 0
    while i < checked.paths.len() {
        let p = checked.paths.get(i).unwrap()
        // The compiler carries the embedded stdlib, so no edit can change it.
        if !p.starts_with("<embedded:") {
            if file_exists(p) != 1 { return true }
            if read_file(p) != checked.texts.get(i).unwrap() { return true }
        }
        i = i + 1
    }
    false
}

// Whether a path the loader probed in the last check now finds a file where it found none, or
// none where it found one.
pub fn checked_probes_changed() -> Bool {
    let mut i = 0
    while i < checked.probe_paths.len() {
        let found = file_exists(checked.probe_paths.get(i).unwrap()) == 1
        if found != checked.probe_found.get(i).unwrap() { return true }
        i = i + 1
    }
    false
}

// The files the last check read from disk, apart from the embedded stdlib.
pub fn checked_input_files() -> List[Str] {
    checked.paths.filter(fn(p) { !p.starts_with("<embedded:") })
}

pub fn checked_inputs_reset() {
    checked = checked_inputs_empty()
}

// How a check exits: 101 for a compiler bug, 1 for errors, and 1 for warnings under --strict.
pub fn check_exit_code(strict: Int, ices: Int, errors: Int, warnings: Int) -> Int {
    if ices > 0 { return 101 }
    if errors > 0 { return 1 }
    if strict != 0 && warnings > 0 { return 1 }
    0
}

// The line `blink check` prints on stdout after the diagnostics. A cold check and a daemon
// check both take it from here, so the two can not drift apart.
pub fn check_status_line(source_path: Str, json_status: Int, strict: Int, ices: Int, errors: Int, warnings: Int) -> Str {
    let code = check_exit_code(strict, ices, errors, warnings)
    if json_status != 0 {
        let status = if ices > 0 { "ice" } else if code != 0 { "error" } else { "ok" }
        return "\{\"status\":\"{status}\",\"file\":\"{json_escape(source_path)}\"}"
    }
    if ices > 0 { return "error: internal compiler error" }
    if errors > 0 { return "error: check failed" }
    if code != 0 { return "error: check failed (warnings treated as errors in --strict mode)" }
    "ok: {source_path}"
}
