// Two emit settings the CLI learns while parsing arguments and needs again at the
// emit call, several frames down. Everything else the emit needs is set beside the
// call itself and travels in the CgConfig record.
let mut cli_trace_codegen: Int = 0
let mut cli_deterministic: Int = 0

// -1 until has_ccache looks for ccache, then 1 when it found it and 0 when not.
let mut ccache_state: Int = -1
let mut install_root_cached: Str = "<unset>"

fn strip_extension(filename: Str) -> Str {
    if filename.ends_with(".bl") {
        return filename.byte_slice(0, filename.byte_len() - 3)
    }
    if filename.ends_with(".pact") {
        return filename.byte_slice(0, filename.byte_len() - 5)
    }
    return filename
}

fn resolve_blink_bin() -> Str {
    let blink_bin = env.var("BLINK_BIN") ?? ""
    if blink_bin != "" { return blink_bin }
    if file_exists("build/blink") { return "build/blink" }
    return "blink"
}

fn detect_async(source: Str) -> Int {
    if source.contains("async.spawn") || source.contains("async.scope") {
        return 1
    }
    return 0
}


// Returns the list of native-dep names whose gate macro appears in the
// emitted C. Codegen prepends `#define BLINK_USE_<gate> 1` to TUs that
// touch a registered dep, so this scan answers "which native sources
// must the link line pull in?"
fn detect_native_deps(c_source: Str) -> List[Str] {
    let mut used: List[Str] = []
    let names = stdlib_native_dep_names()
    let mut i = 0
    while i < names.len() {
        let name = names.get(i).unwrap()
        let gate = stdlib_native_dep_gate_macro(name)
        if gate != "" && c_source.contains(gate) {
            used.push(name)
        }
        i = i + 1
    }
    used
}

fn detect_ffi_libs(c_source: Str) -> List[Str] {
    let mut libs: List[Str] = []
    let line_marker = "// BLINK_FFI_LIB:"
    let marker = "\n{line_marker}"
    let mut remaining = c_source
    if remaining.starts_with(line_marker) {
        let tail = remaining.byte_slice(line_marker.byte_len(), remaining.byte_len())
        match tail.byte_index_of("\n", 0) {
            Some(nl) => {
                libs.push(tail.byte_slice(0, nl))
                remaining = tail.byte_slice(nl + 1, tail.byte_len())
            }
            None => {}
        }
    }
    let mut from = 0
    loop {
        match remaining.byte_index_of(marker, from) {
            Some(idx) => {
                let start = idx + marker.byte_len()
                match remaining.byte_index_of("\n", start) {
                    Some(nl) => {
                        libs.push(remaining.byte_slice(start, nl))
                        from = nl + 1
                    }
                    None => { break }
                }
            }
            None => { break }
        }
    }
    libs
}

fn try_pkg_config(lib: Str) -> Option[Str] {
    let result = process_run("pkg-config", ["--libs", lib])
    if result.exit_code == 0 {
        return Some(result.out.trim())
    }
    return None
}

fn resolve_ffi_link_flags(lib: Str, target: Str) -> Str {
    let dep_type = manifest_native_dep_type(lib)

    if dep_type == "vendored" {
        return ""
    }

    let dep_link = manifest_native_dep_link(lib)
    if dep_link == "dynamic" {
        return "-l{lib}"
    }

    if target != "" {
        return "-l:lib{lib}.a"
    }
    let pkg_flags = try_pkg_config(lib)
    if pkg_flags.is_some() {
        return pkg_flags.unwrap()
    }
    "-l{lib}"
}

fn resolve_gc_source() -> Str {
    let blink_root = env.var("BLINK_ROOT") ?? ""
    if blink_root != "" {
        let path = "{blink_root}/bootstrap/vendor/gc/extra/gc.c"
        if file_exists(path) == 1 {
            return path
        }
    }
    if file_exists("bootstrap/vendor/gc/extra/gc.c") == 1 {
        return "bootstrap/vendor/gc/extra/gc.c"
    }
    let base = extract_embedded_gc()
    "{base}/gc_unity.c"
}

fn resolve_gc_include() -> Str {
    let blink_root = env.var("BLINK_ROOT") ?? ""
    if blink_root != "" {
        let path = "{blink_root}/bootstrap/vendor/gc/include"
        if file_exists("{path}/gc.h") == 1 {
            return path
        }
    }
    if file_exists("bootstrap/vendor/gc/include/gc.h") == 1 {
        return "bootstrap/vendor/gc/include"
    }
    let base = extract_embedded_gc()
    "{base}/include"
}

fn build_link_flags(target: Str, has_async: Int, used_deps: List[Str], ffi_libs: List[Str]) -> Str {
    let mut flags = "-lm"
    if target == "" {
        flags = "{flags} -lgc"
    }
    if has_async != 0 {
        flags = "{flags} -pthread"
    }
    let mut di = 0
    while di < used_deps.len() {
        let dep_name = used_deps.get(di).unwrap()
        // A registry native dep that resolves to a vendored static .o (the
        // sidecar / dev-tree source) is already fully linked from that object
        // — appending the dynamic `-l<name>` is both redundant and harmful:
        // it forces a system shared lib onto the link line, leaving undefined
        // `U <name>_*` symbols resolved dynamically and a needless ldd dep, and
        // it hard-fails the link (`cannot find -l<name>`) on any host without
        // the system dev package (e.g. the Docker image after the SQLite peel).
        // The dynamic `-l` is the right thing only for a `{ system = true }`
        // manifest override, where resolve_native_dep_source returns "".
        if resolve_native_dep_source(dep_name) != "" {
            di = di + 1
            continue
        }
        let dep_flags = resolve_ffi_link_flags(dep_name, target)
        if dep_flags != "" {
            flags = "{flags} {dep_flags}"
        }
        di = di + 1
    }
    let mut i = 0
    while i < ffi_libs.len() {
        let lib = ffi_libs.get(i).unwrap()
        let lib_flags = resolve_ffi_link_flags(lib, target)
        if lib_flags != "" {
            flags = "{flags} {lib_flags}"
        }
        i = i + 1
    }
    flags
}

fn has_test_blocks(source: Str) -> Int {
    if source.starts_with("test \"") || source.contains("\ntest \"") {
        return 1
    }
    if source.starts_with("test.failing(") || source.contains("\ntest.failing(") {
        return 1
    }
    return 0
}

fn collect_source_files(dir: Str, results: List[Str]) {
    let entries = list_dir(dir)
    let mut i = 0
    while i < entries.len() {
        let entry = entries.get(i).unwrap()
        if entry.starts_with(".") || entry == "build" || entry == "legacy" || entry == "node_modules" {
            i = i + 1
            continue
        }
        let full_path = path_join(dir, entry)
        if is_dir(full_path) {
            collect_source_files(full_path, results)
        } else if entry.ends_with(".bl") || entry.ends_with(".pact") {
            results.push(full_path)
        }
        i = i + 1
    }
}

fn collect_test_files(dir: Str, results: List[Str]) {
    let entries = list_dir(dir)
    let mut i = 0
    while i < entries.len() {
        let entry = entries.get(i).unwrap()
        if entry.starts_with(".") || entry == "build" || entry == "legacy" || entry == "node_modules" {
            i = i + 1
            continue
        }
        let full_path = path_join(dir, entry)
        if is_dir(full_path) {
            collect_test_files(full_path, results)
        } else if entry.ends_with(".bl") || entry.ends_with(".pact") {
            let source = read_file(full_path)
            if source.starts_with("// xtest") {
                i = i + 1
                continue
            }
            if has_test_blocks(source) {
                results.push(full_path)
            }
        }
        i = i + 1
    }
}

fn resolve_manifest_path() -> Str {
    if file_exists("blink.toml") == 1 {
        return "blink.toml"
    }
    ""
}

fn resolve_lockfile_path() -> Str {
    if file_exists("blink.lock") == 1 {
        return "blink.lock"
    }
    ""
}

// Whether blink.toml is newer than the lock, or has none, so a build resolves its
// dependencies first.
fn deps_unresolved() -> Bool {
    let manifest = resolve_manifest_path()
    if manifest == "" {
        return false
    }
    let toml_mt = file_mtime(manifest)
    if toml_mt == -1 {
        return false
    }
    let lockfile = resolve_lockfile_path()
    let lock_mt = if lockfile != "" { file_mtime(lockfile) } else { -1 }
    lock_mt == -1 || toml_mt > lock_mt
}

fn ensure_deps_resolved() {
    if deps_unresolved() {
        io.eprintln("resolving dependencies...")
        let rc = resolve_and_lock(".", blink_cli_version)
        if rc != 0 {
            io.eprintln("error: dependency resolution failed")
            exit(1)
        }
    }
}

// Source to a monomorphized program: everything both build shapes share. Err carries the
// exit code the build stops with.
fn compile_front_end(source_path: Str, strict_mode: Int) -> Result[Int, Int] ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, Codegen {
    let final_program = compile_to_program(source_path, 1)

    let _tc_err_count = check_types(final_program)

    check_unused_imports()

    if diag_ice_count > 0 {
        diag_flush()
        return Err(101)
    }
    if diag_count > 0 {
        diag_flush()
        return Err(1)
    }
    if diag_warn_count > 0 {
        diag_flush()
        if strict_mode != 0 {
            return Err(1)
        }
    }

    run_build_analyses(final_program)
    if diag_ice_count > 0 {
        diag_flush()
        return Err(101)
    }
    if diag_count > 0 {
        diag_flush()
        return Err(1)
    }
    Ok(final_program)
}

// What compile_front_end returns for the program the daemon checked, printing what it would
// print: the check ran the same stages on the same inputs, and front holds what they reported
// where compile_front_end stops on an error.
fn checked_front_end(b: DaemonBuild, strict_mode: Int) -> Result[Int, Int] ! Diag.Report {
    io.print(b.out)
    io.eprint(b.err)
    let f = b.front
    if f.ices > 0 {
        io.eprint(f.human)
        return Err(101)
    }
    if f.errors > 0 {
        io.eprint(f.human)
        return Err(1)
    }
    if f.warnings > 0 {
        io.eprint(f.human)
        if strict_mode != 0 {
            return Err(1)
        }
    }
    if diag_ice_count > 0 {
        diag_flush()
        return Err(101)
    }
    if diag_count > 0 {
        diag_flush()
        return Err(1)
    }
    Ok(b.program)
}

fn do_compile(source_path: Str, c_path: Str, format_flag: Str, debug_mode: Int, strict_mode: Int) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, Format.Emit, Codegen {
    if format_flag == "blink" {
        reset_compiler_state()
        diag_reset()
        diag_source_file = source_path
        let source = read_file(source_path)
        lex(source)
        let first_node = node_count()
        // Format must round-trip the original `@expect_panic` surface syntax, so
        // suppress the parse-time desugar (which the compile path relies on).
        parse_desugar_enabled = 0
        let program = parse_program()
        parse_desugar_enabled = 1
        attach_comments_pass(program, first_node)
        if diag_ice_count > 0 {
            diag_flush()
            return 101
        }
        if diag_count > 0 {
            diag_flush()
            return 1
        }
        let fmt_output = format(program)
        write_file(c_path, fmt_output)
        return 0
    }
    let final_program = match compile_front_end(source_path, strict_mode) {
        Ok(p) => p
        Err(rc) => return rc
    }

    let skip_raw = env.var("BLINK_SKIP_MODULES") ?? ""
    let mut skip_modules: Map[Str, Int] = Map()
    if skip_raw != "" {
        let parts = skip_raw.split(",")
        let mut si = 0
        while si < parts.len() {
            let part = parts.get(si).unwrap()
            if part != "" {
                skip_modules.insert(part, 1)
            }
            si = si + 1
        }
    }
    let archived = list_stdlib_module_keys()
    let mut ai = 0
    while ai < archived.len() {
        skip_modules.insert(archived.get(ai).unwrap(), 1)
        ai = ai + 1
    }
    let mut layer_modules: Map[Str, Int] = Map()
    let layer_dir = compiler_archive_env()
    if layer_dir != "" {
        let layer_keys = compiler_archive_skip_keys(layer_dir)
        if layer_keys.len() > 0 && compiler_archive_holds_effects(final_program, layer_keys) {
            for k in layer_keys {
                skip_modules.insert(k, 1)
                layer_modules.insert(k, 1)
            }
        }
    }

    let cfg = CgConfig { debug_mode: if debug_mode != 0 { 1 } else { 0 },
        trace_codegen: cli_trace_codegen, deterministic: cli_deterministic,
        emit_only_module: env.var("BLINK_ONLY_MODULE") ?? "", skip_modules: skip_modules,
        user_tu_mode: 1, blink_ev_extern_only: 0, archive_build_mode: 0, archive_over_std: 0,
        compiler_archive_modules: layer_modules }
    let c_output = generate(final_program, cfg)

    if diag_ice_count > 0 {
        diag_flush()
        return 101
    }
    if diag_count > 0 {
        diag_flush()
        return 1
    }
    if diag_warn_count > 0 {
        diag_flush()
        if strict_mode != 0 {
            return 1
        }
    }

    write_file(c_path, c_output)
    return 0
}

// Whether the compiler archive's evidence vector has a slot for every effect `program`
// declares. A unit that links the archive takes the vector the archive was built with, so a
// program with an effect the archive lacks is built in one unit instead. An effect is the
// archive's when the module that declares it is one the archive holds: `held` passed the
// source check, so that module's declarations are the ones the archive was built from. The
// name does not say this, since a program may declare an effect of its own under the name
// of one the archive holds.
fn compiler_archive_holds_effects(program: Int, held: List[Str]) -> Bool {
    let effects = node_args(program)
    if effects == -1 { return true }
    let mut i = 0
    while i < sublist_length(effects) {
        if !held.contains(node_source_module(sublist_get(effects, i))) { return false }
        i = i + 1
    }
    true
}

// Returns the install prefix: $BLINK_ROOT if set, or the running binary's resolved path
// walked up two dirs (build/blink → repo root, or <prefix>/bin/blink →
// <prefix>). "" if neither resolves — callers then fall back to
// cwd-relative paths.
pub fn resolve_install_root() -> Str {
    if install_root_cached != "<unset>" {
        return install_root_cached
    }
    let blink_root = env.var("BLINK_ROOT") ?? ""
    if blink_root != "" {
        install_root_cached = blink_root
        return blink_root
    }
    // The binary the archive is checked against, so the root and that check agree on it.
    let exe_path = archive_compiler_path()
    if exe_path == "" {
        install_root_cached = ""
        return ""
    }
    install_root_cached = path_dirname(path_dirname(exe_path))
    install_root_cached
}

pub fn resolve_archive_dir() -> Str {
    let root = resolve_install_root()
    if root != "" {
        let dev_archive = path_join(root, "build/libblink_std.a")
        if file_exists(dev_archive) == 1 {
            return path_join(root, "build")
        }
        let installed_archive = path_join(root, "share/blink/libblink_std.a")
        if file_exists(installed_archive) == 1 {
            return path_join(root, "share/blink")
        }
    }
    "build"
}

fn resolve_target_triple(alias: Str) -> Str {
    if alias == "linux" || alias == "linux-amd64" {
        return "x86_64-linux-gnu"
    }
    if alias == "linux-arm64" {
        return "aarch64-linux-gnu"
    }
    if alias == "macos-arm64" {
        return "aarch64-macos"
    }
    if alias == "macos-amd64" {
        return "x86_64-macos"
    }
    if alias == "macos" {
        let result = process_run("uname", ["-m"])
        let arch = result.out.trim()
        return "{arch}-macos"
    }
    return alias
}

fn has_ccache() -> Int ! IO {
    if ccache_state < 0 {
        ccache_state = if build_fs.find_program("ccache") != "" { 1 } else { 0 }
    }
    ccache_state
}

pub fn run_cc(args: Str, debug_mode: Int, release_mode: Int, target: Str) -> Int ! IO {
    run_command(cc_command(args, debug_mode, release_mode, target))
}

// Runs cmd as shell_exec does, but without a shell when sh would only split it into words:
// a build runs cc once per unit and once to link, and each sh costs as much as a small unit.
fn run_command(cmd: Str) -> Int ! IO {
    let words = build_fs.plain_words(cmd)
    if words.len() > 0 && build_fs.find_program(words[0]) != "" {
        return build_fs.run_program(words[0], words_after_first(words))
    }
    shell_exec(cmd)
}

// Starts cmd as process_spawn("sh", ["-c", cmd]) does, without the shell when run_command
// would run it without one, its output written to files in dir named for name.
fn spawn_unit(cmd: Str, dir: Str, name: Str) -> build_fs.FileChild ! IO {
    let out_path = "{dir}/{name}.cc-out"
    let err_path = "{dir}/{name}.cc-err"
    let words = build_fs.plain_words(cmd)
    if words.len() > 0 && build_fs.find_program(words[0]) != "" {
        return build_fs.spawn_to_files(words[0], words_after_first(words), out_path, err_path)
    }
    build_fs.spawn_to_files("sh", ["-c", cmd], out_path, err_path)
}

fn words_after_first(words: List[Str]) -> List[Str] {
    let mut rest: List[Str] = []
    let mut i = 1
    while i < words.len() {
        rest.push(words[i])
        i = i + 1
    }
    rest
}

fn cc_command(args: Str, debug_mode: Int, release_mode: Int, target: Str) -> Str ! IO {
    let mut compiler = "cc"
    let mut pipe = "-pipe "
    if target != "" {
        compiler = "zig cc -target {target}"
        pipe = ""
    } else if has_ccache() != 0 {
        compiler = "ccache cc"
    }
    let opt_flags = cc_opt_flags(debug_mode, release_mode).join(" ")
    "{compiler} {pipe}{opt_flags} {args}"
}

// The one place a build mode becomes cc optimization flags. The object-cache key reads
// the same list, so a cached object always matches the level it is linked at.
// BLINK_DEBUG turns on the runtime's own checks, such as a Str's recorded length.
fn cc_opt_flags(debug_mode: Int, release_mode: Int) -> List[Str] {
    if debug_mode != 0 {
        return ["-g", "-O0", "-DBLINK_DEBUG"]
    }
    if release_mode != 0 {
        return ["-O2"]
    }
    ["-O1"]
}

// Flags each per-module unit compiles with, on top of cc_opt_flags. A unit holds only the
// declarations its scan found, so a missed one must stop the build: gcc before 14 only warns
// on a call to an undeclared function and then guesses an int return.
fn unit_cc_flags() -> List[Str] {
    ["-Werror=implicit-function-declaration"]
}

// The flags a unit's object is keyed on: the ones its compile passes.
fn unit_key_flags(debug_mode: Int, release_mode: Int) -> List[Str] {
    let mut flags = cc_opt_flags(debug_mode, release_mode)
    for f in unit_cc_flags() { flags.push(f) }
    flags
}

fn compile_vendored_source(c_path: Str, o_path: Str, debug_mode: Int, release_mode: Int, target: Str) -> Int ! IO {
    let src_mt = file_mtime(c_path)
    let obj_mt = file_mtime(o_path)
    if obj_mt >= src_mt && src_mt != -1 {
        return 0
    }
    let tmp_path = "{o_path}.{getpid()}.tmp"
    let rc = run_cc("-c -o {tmp_path} {c_path}", debug_mode, release_mode, target)
    if rc != 0 {
        shell_exec("rm -f {tmp_path}")
        io.println("error: compiling vendored source {c_path} failed")
        return rc
    }
    shell_exec("mv {tmp_path} {o_path}")
    return 0
}

// Resolve where to find a registered native dep's C source. Lookup order:
// (1) user manifest [native-dependencies] override (lets a user pin a
// custom build), (2) installed sidecar at `<install_root>/share/blink/native/<name>/`,
// (3) dev-tree `lib/native/<name>/`. Returns "" if no source can be
// located, leaving the caller to error out.
fn resolve_native_dep_source(name: Str) -> Str {
    let dep_type = manifest_native_dep_type(name)
    let dep_path = manifest_native_dep_path(name)
    if dep_type == "vendored" && dep_path != "" {
        return dep_path
    }
    if dep_type == "" {
        let paths = stdlib_native_dep_source_paths(name)
        let install_root = resolve_install_root()
        let mut i = 0
        while i < paths.len() {
            let p = paths.get(i).unwrap()
            if install_root != "" {
                // Map `lib/native/<name>/<file>` → `<root>/share/blink/native/<name>/<file>`.
                let base = path_basename(p)
                let sidecar = path_join(install_root, "share/blink/native/{name}/{base}")
                if file_exists(sidecar) == 1 {
                    return sidecar
                }
            }
            if file_exists(p) == 1 {
                return p
            }
            i = i + 1
        }
    }
    ""
}

fn resolve_vendored_objects(used_deps: List[Str], debug_mode: Int, release_mode: Int, target: Str) -> List[Str] ! IO {
    let mut objects: List[Str] = []
    let mut did_mkdir = 0

    if target != "" {
        let gc_src = resolve_gc_source()
        if gc_src != "" {
            shell_exec("mkdir -p .tmp")
            did_mkdir = 1
            let gc_inc = resolve_gc_include()
            let o_path = ".tmp/gc-{target}.o"
            let src_mt = file_mtime(gc_src)
            let obj_mt = file_mtime(o_path)
            if obj_mt < src_mt || src_mt == -1 {
                let tmp_path = "{o_path}.{getpid()}.tmp"
                let mut gc_extra_flags = ""
                if target.contains("macos") {
                    let stubs = "{gc_inc}/zig-stubs"
                    if file_exists("{stubs}/mach/exception.h") == 1 {
                        gc_extra_flags = "-I{stubs} -DNO_MPROTECT_VDB"
                    }
                }
                let rc = run_cc("-c -o {tmp_path} {gc_extra_flags} -I{gc_inc} -DGC_THREADS -DGC_BUILTIN_ATOMIC -DUSE_MMAP -DUSE_MUNMAP {gc_src}", debug_mode, release_mode, target)
                if rc != 0 {
                    shell_exec("rm -f {tmp_path}")
                    io.println("error: compiling vendored gc failed")
                    return objects
                }
                shell_exec("mv {tmp_path} {o_path}")
            }
            objects.push(o_path)
        }
    }

    let mut di = 0
    while di < used_deps.len() {
        let name = used_deps.get(di).unwrap()
        let src = resolve_native_dep_source(name)
        if src != "" {
            if did_mkdir == 0 {
                shell_exec("mkdir -p .tmp")
                did_mkdir = 1
            }
            let mut o_path = ".tmp/{name}.o"
            if target != "" {
                o_path = ".tmp/{name}-{target}.o"
            }
            let rc = compile_vendored_source(src, o_path, debug_mode, release_mode, target)
            if rc != 0 {
                return objects
            }
            objects.push(o_path)
        }
        di = di + 1
    }

    let count = manifest_native_dep_count()
    let mut i = 0
    while i < count {
        let name = manifest_native_dep_name_at(i)
        i = i + 1
        if manifest_native_dep_type(name) != "vendored" { continue }
        // Registry-managed deps already came in via used_deps above; skip
        // the manifest entry so the same .o isn't compiled and linked twice.
        if used_deps.contains(name) { continue }
        let dep_path = manifest_native_dep_path(name)
        if dep_path == "" { continue }
        if did_mkdir == 0 {
            shell_exec("mkdir -p .tmp")
            did_mkdir = 1
        }
        let mut o_path = ".tmp/{name}.o"
        if target != "" {
            o_path = ".tmp/{name}-{target}.o"
        }
        let rc = compile_vendored_source(dep_path, o_path, debug_mode, release_mode, target)
        if rc != 0 {
            return objects
        }
        objects.push(o_path)
    }

    objects
}

fn resolve_vendored_includes(used_deps: List[Str], target: Str) -> Str {
    let mut includes: List[Str] = []

    if target != "" {
        let gc_inc = resolve_gc_include()
        if gc_inc != "" {
            if target.contains("macos") {
                let stubs = "{gc_inc}/zig-stubs"
                if file_exists("{stubs}/mach/exception.h") == 1 {
                    includes.push("-I{stubs}")
                }
            }
            includes.push("-I{gc_inc}")
        }
    }

    let mut di = 0
    while di < used_deps.len() {
        let name = used_deps.get(di).unwrap()
        let src = resolve_native_dep_source(name)
        if src != "" {
            includes.push("-I{path_dirname(src)}")
        }
        di = di + 1
    }

    let count = manifest_native_dep_count()
    let mut i = 0
    while i < count {
        let name = manifest_native_dep_name_at(i)
        i = i + 1
        if manifest_native_dep_type(name) != "vendored" { continue }
        if used_deps.contains(name) { continue }
        let dep_path = manifest_native_dep_path(name)
        if dep_path == "" { continue }
        includes.push("-I{path_dirname(dep_path)}")
    }

    if includes.len() == 0 {
        return ""
    }
    includes.join(" ")
}

// When set, do_link_target consults the .o cache for the user .c and
// skips `cc -c` on a hit. Reset by callers each invocation so the
// global doesn't leak across runs.
let mut cg_obj_cache_enabled: Int = 1

fn apply_cache_flag(a: Args) {
    cg_obj_cache_enabled = if args_has(a, "no-cache") { 0 } else { 1 }
}

// compiler_sha and cc_id are constant for the life of this process —
// memoize so multi-link runs (e.g. `blink test`) don't re-hash a
// multi-MB compiler + spawn `cc --version` on every link.
let mut cached_compiler_sha: Str = ""
let mut cached_compiler_sha_init: Int = 0
let mut cached_cc_id: Str = ""
// "<target>\n" once cached_cc_id holds that target's identity; "" before the first call.
let mut cached_cc_id_for: Str = ""

pub fn process_compiler_sha() -> Str ! IO {
    if cached_compiler_sha_init == 0 {
        cached_compiler_sha = sha256_of_file_first(archive_compiler_path())
        cached_compiler_sha_init = 1
    }
    cached_compiler_sha
}

// The compiler run_cc runs for target: a cross build runs zig, whose clang line does not
// move with every zig release, so the zig version is part of it.
fn process_cc_id(target: Str) -> Str ! IO {
    if cached_cc_id_for != "{target}\n" {
        if target == "" {
            // The first line `cc --version 2>&1 | head -1` gave, which every cached key holds:
            // the version goes to stdout, and only a cc that fails to give one writes stderr.
            let r = process_run("cc", ["--version"])
            let text = if r.out != "" { r.out } else { r.err_out }
            cached_cc_id = text.split("\n")[0].trim()
        } else {
            let r = process_run("sh", ["-c", "zig version && zig cc -target {target} --version 2>&1 | head -1"])
            cached_cc_id = if r.exit_code == 0 { r.out.trim().replace("\n", " ") } else { "" }
        }
        cached_cc_id_for = "{target}\n"
    }
    cached_cc_id
}

// Sentinel set by cache_compile_user_c when it actually stored a new
// entry. Caller checks this to gate maybe_gc — cache hits should not
// trigger a full-tree size walk.
let mut cache_did_store: Int = 0

// The object answered sits in a private dir, which the caller removes after its link: the GC
// of another build can remove the cache entry before then.
fn cache_compile_user_c(c_path: Str, debug_mode: Int, release_mode: Int, target: Str, arc_dir: Str, include_flags: Str) -> Str ! IO {
    cache_did_store = 0
    if cg_obj_cache_enabled == 0 || !build_objcache.cache_enabled() {
        return ""
    }
    // Another build that writes the same C path can rewrite it at any time, so the key
    // and the compile both read one private copy: a second read of c_path could compile
    // other bytes than the ones hashed and store that object under the key.
    let snap_dir = build_objcache.make_private_dir()
    if snap_dir == "" {
        return ""
    }
    let obj = cache_compile_snapshot(c_path, snap_dir, debug_mode, release_mode, target, arc_dir, include_flags)
    if obj == "" {
        let _ = build_fs.remove_tree(snap_dir)
    }
    obj
}

fn cache_compile_snapshot(c_path: Str, snap_dir: Str, debug_mode: Int, release_mode: Int, target: Str, arc_dir: Str, include_flags: Str) -> Str ! IO {
    let snap = "{snap_dir}/{path_basename(c_path)}"
    if shell_exec("cp {c_path} {snap}") != 0 {
        return ""
    }
    let mut vendored_dirs: List[Str] = []
    for part in include_flags.split(" ") {
        if part.starts_with("-I") {
            vendored_dirs.push(part.byte_slice(2, part.byte_len()))
        }
    }
    let flags = cc_opt_flags(debug_mode, release_mode)
    let key = build_objcache.user_unit_key(snap, c_path, arc_dir, vendored_dirs, process_compiler_sha(), process_cc_id(target), flags, target)
    if key == "" {
        return ""
    }
    let hit = build_objcache.hold_objs([key], snap_dir).get(0).unwrap()
    if hit != "" {
        return hit
    }
    let staging = "{snap_dir}/unit.o"
    let includes = if include_flags != "" { "-I{arc_dir} {include_flags}" } else { "-I{arc_dir}" }
    // The map gives the object the __FILE__ and debug paths a compile of c_path gives.
    let rc = run_cc("-c {snap} -o {staging} -ffile-prefix-map={snap_dir}={path_dirname(c_path)} {includes}", debug_mode, release_mode, target)
    if rc != 0 {
        return ""
    }
    if build_objcache.install(key, staging, c_path, sha256_of_file_first(snap)) {
        cache_did_store = 1
    }
    staging
}

fn sha8(sha: Str) -> Str {
    if sha.byte_len() >= 8 { sha.byte_slice(0, 8) } else { sha }
}

// A dev archive's links can point at an archive another compiler built (build-cli
// links a new blink against the old blink's archive), or one built against another
// runtime.h, so before a link a dev compiler checks the stamp's compiler SHA and the
// runtime.h the archive was built against, and rebuilds on a mismatch. The full std-cache key
// is not recomputed on each run: it costs tens of ms, and the compiler SHA is already
// memoized for the obj cache. An installed archive is never rebuilt;
// verify_installed_archive checks it instead.
fn ensure_dev_archive() -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, Codegen, IO {
    if dev_archive_current() {
        return 0
    }
    let arc_dir = resolve_archive_dir()
    let rc = build_stdlib_archive_in(arc_dir, peeled_module_keys(), false)
    if rc != 0 {
        io.eprintln("error: failed to build stdlib archive in {arc_dir} (rc={rc})")
    }
    rc
}

// Whether ensure_dev_archive would leave the archive as it is.
fn dev_archive_current() -> Bool ! IO {
    let arc_dir = resolve_archive_dir()
    if arc_dir.ends_with("share/blink") {
        return true
    }
    let stamp_path = path_join(arc_dir, ".archive-id")
    let cur_bc_sha = process_compiler_sha()
    if cur_bc_sha != "" && file_exists(stamp_path) == 1 && file_exists(path_join(arc_dir, "libblink_std.a")) == 1 {
        let parts = read_file(stamp_path).trim().split("|")
        // A runtime header edit reflattens build/runtime.h under the same compiler, and the
        // units compile against the new header, so the archive must be built against it too.
        if parts.len() > 2 && parts.get(2).unwrap() == cur_bc_sha {
            return dev_archive_runtime_h_current(arc_dir, parts.get(0).unwrap())
        }
    }
    false
}

// Whether the dev archive was built against the runtime.h a build compiles against. A
// std-cache entry keeps a copy of the runtime.h its archive compiled, and reading both is
// cheaper than hashing one: the sha costs about 2 ms, and this runs on each build. An archive
// with no such copy apart from the live header is checked by its stamp's runtime.h sha.
fn dev_archive_runtime_h_current(arc_dir: Str, stamp_rt_sha: Str) -> Bool ! IO {
    let rt = resolve_runtime_h()
    match build_fs.real_path(path_join(arc_dir, "libblink_std.a")) {
        Some(archive) => {
            let copy = path_join(path_dirname(archive), "runtime.h")
            let live = build_fs.real_path(rt) ?? rt
            if copy != live && file_exists(copy) == 1 {
                return build_fs.same_bytes(copy, rt)
            }
        }
        None => {}
    }
    stamp_rt_sha == sha256_of_file_first(rt)
}

// Reject a stale *installed* stdlib archive before it can be linked into a
// user binary. A dev archive is brought up to date by ensure_dev_archive and
// needs no check here. An *installed* archive (copied out of the cache into
// <prefix>/share/blink/, losing the hash-named directory) carries a
// `.archive-id` stamp instead:
// runtime.h SHA | archive-header SHA | compiler SHA | version.
//
// The runtime.h and archive-header (libblink_std.h) SHAs catch a torn install:
// BOTH headers are #included by the freshly emitted user TU and define the
// structs it shares with the archive's monolith.o. runtime.h carries the
// runtime struct layouts; libblink_std.h carries the stdlib struct typedefs
// (e.g. the db Row, std.args.*). If either disagrees, boxed values are read at
// the wrong offsets and the binary corrupts memory at runtime (the reported
// Option[Row] UAF was exactly this skew: a stale 161789-byte install vs the
// current 172853-byte runtime.h).
//
// The headers do not cover the archive's function bodies, which another
// compiler's codegen may have emitted under the same headers, so the stamp's
// compiler SHA must name the running compiler. Every installer stamps the
// binary it ships. The version is shown in the diagnostic only.
//
// Returns 0 when the link may proceed (dev archive, or matching installed
// stamp), 1 when an installed archive is incompatible or unstamped (a
// diagnostic is emitted and the caller must not produce a binary).
fn verify_installed_archive(arc_dir: Str) -> Int ! Diag.Report, IO {
    if !arc_dir.ends_with("share/blink") {
        return 0
    }
    let stamp_path = path_join(arc_dir, ".archive-id")
    let cur_rt_sha = sha256_of_file_first(resolve_runtime_h())
    let cur_hdr_sha = sha256_of_file_first(path_join(arc_dir, "libblink_std.h"))
    if file_exists(stamp_path) == 0 {
        diag_error_no_loc("IncompatibleStdlibArchive", INCOMPATIBLE_STDLIB_ARCHIVE, "installed stdlib archive is missing its identity stamp ({stamp_path})", "reinstall: task install   (or rebuild against the current toolchain)")
        diag_flush()
        return 1
    }
    let stamp = read_file(stamp_path).trim()
    let parts = stamp.split("|")
    let arc_rt_sha = if parts.len() > 0 { parts.get(0).unwrap() } else { "" }
    let arc_hdr_sha = if parts.len() > 1 { parts.get(1).unwrap() } else { "" }
    let arc_bc_sha = if parts.len() > 2 { parts.get(2).unwrap() } else { "" }
    let arc_ver = if parts.len() > 3 { parts.get(3).unwrap() } else { "?" }
    let cur_bc_sha = process_compiler_sha()
    if arc_rt_sha == cur_rt_sha && arc_hdr_sha == cur_hdr_sha && cur_bc_sha != "" && arc_bc_sha == cur_bc_sha {
        return 0
    }
    diag_error_no_loc("IncompatibleStdlibArchive", INCOMPATIBLE_STDLIB_ARCHIVE, "installed stdlib archive is incompatible with this compiler\n  archive built by blink {arc_ver} (compiler {sha8(arc_bc_sha)}, runtime {sha8(arc_rt_sha)}, header {sha8(arc_hdr_sha)}), current blink is {blink_cli_version} (compiler {sha8(cur_bc_sha)}, runtime {sha8(cur_rt_sha)}, header {sha8(cur_hdr_sha)})", "reinstall: task install   (or rebuild against the current toolchain)")
    diag_flush()
    1
}

fn do_link_target(out: Str, c_path: Str, link_flags: Str, obj_files: List[Str], include_flags: Str, debug_mode: Int, release_mode: Int, target: Str, compiler_archive: Str) -> Int ! Diag.Report, IO {
    let mut objs = ""
    if obj_files.len() > 0 {
        objs = " {obj_files.join(" ")}"
    }
    let mut includes = ""
    if include_flags != "" {
        includes = " {include_flags}"
    }
    let arc_dir = resolve_archive_dir()
    let vrc = verify_installed_archive(arc_dir)
    if vrc != 0 {
        return vrc
    }
    // The layer goes ahead of the stdlib archive, whose symbols it uses.
    let layer = if compiler_archive != "" { " {compiler_archive_link_args(compiler_archive)}" } else { "" }
    let archive = "{layer} -I{arc_dir} {arc_dir}/libblink_std.a -Wl,--gc-sections"
    let mut effective_link_flags = link_flags
    // obj_files / include_flags carry per-build vendored deps the caller
    // resolved via detect_native_deps(c_source); the archive itself owns
    // only non-peeled stdlib bodies, so the link set is just user .c +
    // vendored objs + archive.
    if !link_flags.contains("-pthread") {
        effective_link_flags = "{link_flags} -pthread"
    }
    // Try the .o cache for the user .c — on hit we skip `cc -c` and link
    // the cached .o; on miss we cc-compile, store, then link. The user TU
    // includes the archive header AND, when it imports a peeled native dep,
    // that dep's header (runtime.h does `#include <sqlite3.h>`), so the
    // compile needs the vendored `-I` too — otherwise the `cc -c` fails with
    // `fatal error: sqlite3.h: No such file or directory`, the cache silently
    // misses, and we only succeed by falling through to the combined link
    // below (which does pass includes). On a host without the system header
    // that surfaced a scary fatal error on every db build; on a cache hit it
    // would never have produced the .o at all.
    // The object key does not cover the compiler archive header, which each corpus run
    // rebuilds, so a unit that reads it is never cached.
    let cached_o = if compiler_archive != "" { "" } else { cache_compile_user_c(c_path, debug_mode, release_mode, target, arc_dir, include_flags) }
    let compile_input = if cached_o != "" { cached_o } else { c_path }
    if build_objcache.dev_evict_at("link") {
        dbg_trace("build.units", "dev evict link")
    }
    let rc = run_cc("-o {out} {compile_input}{objs}{includes}{archive} {effective_link_flags}", debug_mode, release_mode, target)
    if cached_o != "" {
        let _ = build_fs.remove_tree(path_dirname(cached_o))
    }
    if rc != 0 {
        io.println("error: C compilation failed")
        return rc
    }
    if cache_did_store == 1 {
        build_objcache.maybe_gc()
    }
    return 0
}

fn validate_ffi_native_deps(ffi_libs: List[Str]) -> Int ! Diag.Report {
    let mut errors = 0
    let mut i = 0
    while i < ffi_libs.len() {
        let lib = ffi_libs.get(i).unwrap()
        if manifest_has_native_dep(lib) == 0 {
            diag_error_no_loc("MissingNativeDep", MISSING_NATIVE_DEP, "@ffi references undeclared native dependency \"{lib}\"", "add to blink.toml:\n  [native-dependencies]\n  {lib} = \{ system = true \}")
            errors = errors + 1
        }
        i = i + 1
    }
    if errors > 0 {
        diag_flush()
        return 1
    }
    0
}

fn validate_cross_target_deps(target: Str) -> Int ! Diag.Report {
    let mut errors = 0
    let count = manifest_native_dep_count()
    let mut i = 0
    while i < count {
        let name = manifest_native_dep_name_at(i)
        let dep_type = manifest_native_dep_type(name)
        let dep_link = manifest_native_dep_link(name)
        if dep_type == "system" && dep_link != "dynamic" {
            diag_error_no_loc("NativeDepUnavailableCrossTarget", NATIVE_DEP_UNAVAILABLE_CROSS, "native dependency \"{name}\" is system-only but target is {target}", "cross-compilation requires vendored source or static archive\n  provide source: {name} = \{ path = \"vendor/{name}.c\" \}\n  or override linking: {name} = \{ system = true, link = \"dynamic\" \}")
            errors = errors + 1
        }
        i = i + 1
    }
    if errors > 0 {
        diag_flush()
        return 1
    }
    0
}

fn stamp_blink_version() {
    let manifest = resolve_manifest_path()
    if manifest == "" {
        return
    }
    manifest_clear()
    let rc = manifest_load(manifest)
    if rc != 0 {
        return
    }
    if manifest_blink_version == blink_cli_version {
        return
    }
    let content = read_file(manifest)
    if manifest_blink_version == "" {
        let insertion = "blink-version = \"{blink_cli_version}\"\n"
        let pkg_header = "[package]\n"
        match content.byte_index_of(pkg_header, 0) {
            Some(idx) => {
                let after = idx + pkg_header.byte_len()
                let updated = content.byte_slice(0, after).concat(insertion).concat(content.byte_slice(after, content.byte_len()))
                write_file(manifest, updated)
            }
            None => {}
        }
    } else {
        let old_line = "blink-version = \"{manifest_blink_version}\""
        let new_line = "blink-version = \"{blink_cli_version}\""
        let updated = content.replace(old_line, new_line)
        if updated != content {
            write_file(manifest, updated)
        }
    }
}

fn validate_build_deps(ffi_libs: List[Str], targets: List[Str]) -> Int ! Diag.Report {
    let has_toml = if resolve_manifest_path() != "" { 1 } else { 0 }
    if has_toml == 1 && ffi_libs.len() > 0 {
        let vrc = validate_ffi_native_deps(ffi_libs)
        if vrc != 0 {
            return vrc
        }
    }

    if has_toml == 1 && targets.len() > 0 {
        let first_target = resolve_target_triple(targets.get(0).unwrap())
        if first_target != "" {
            let crc = validate_cross_target_deps(first_target)
            if crc != 0 {
                return crc
            }
        }
    }
    0
}

fn do_build(source_path: Str, output_path: Str, c_path: Str, format_flag: Str, debug_mode: Int, release_mode: Int, emit_mode: Str, targets: List[Str], json_output: Int, strict_mode: Int, unit_jobs: Int, per_module_flag: Bool, checked: Option[DaemonBuild]) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, Format.Emit, Codegen, IO {
    fs_remove(output_path)
    // Before the compile: it checks a compiler archive against the stdlib archive's
    // stamp, which a rebuild here would change.
    if emit_mode != "c" {
        let arc_rc = ensure_dev_archive()
        if arc_rc != 0 {
            return arc_rc
        }
    }
    if unit_jobs != 0 {
        let reason = per_module_fallback_reason(emit_mode, format_flag)
        if reason == "" {
            return do_build_units(source_path, output_path, debug_mode, release_mode, targets, json_output, strict_mode, unit_jobs, checked)
        }
        // BLINK_PER_MODULE alone sets a default, not a request on this command, so its
        // fallback is silent.
        if per_module_flag {
            io.eprintln("note: --per-module ignored: {reason}; building one C unit")
        }
    }
    // The daemon's process already ran a front end, which a second one would build on. Its
    // child gets here only if this path and daemon_may_build disagree; the client then
    // builds cold.
    match checked {
        Some(b) => {
            write_file(b.declined, "")
            exit(0)
        }
        None => {}
    }
    let rc = do_compile(source_path, c_path, format_flag, debug_mode, strict_mode)
    if rc != 0 {
        return rc
    }

    if emit_mode == "c" {
        return 0
    }

    let source = read_file(source_path)
    let c_source = read_file(c_path)
    let has_async = detect_async(source)
    let used_deps = detect_native_deps(c_source)
    let ffi_libs = detect_ffi_libs(c_source)
    let compiler_archive = compiler_archive_of_unit(c_source)

    let vrc = validate_build_deps(ffi_libs, targets)
    if vrc != 0 {
        return vrc
    }

    if targets.len() <= 1 {
        let mut target = ""
        if targets.len() == 1 {
            target = resolve_target_triple(targets.get(0).unwrap())
        }
        let link_flags = build_link_flags(target, has_async, used_deps, ffi_libs)
        let obj_files = resolve_vendored_objects(used_deps, debug_mode, release_mode, target)
        let inc_flags = resolve_vendored_includes(used_deps, target)
        let lrc = do_link_target(output_path, c_path, link_flags, obj_files, inc_flags, debug_mode, release_mode, target, compiler_archive)
        if lrc != 0 {
            return lrc
        }
        if json_output != 0 {
            io.println("\{\"status\":\"ok\",\"output\":\"{output_path}\"}")
        } else {
            io.println("built: {output_path}")
        }
        return 0
    }

    let first_triple = resolve_target_triple(targets.get(0).unwrap())
    let inc_flags = resolve_vendored_includes(used_deps, first_triple)
    if json_output != 0 {
        io.print_raw("\{\"status\":\"ok\",\"outputs\":[")
    }
    let mut i = 0
    while i < targets.len() {
        let alias = targets.get(i).unwrap()
        let triple = resolve_target_triple(alias)
        let link_flags = build_link_flags(triple, has_async, used_deps, ffi_libs)
        let obj_files = resolve_vendored_objects(used_deps, debug_mode, release_mode, triple)
        let out = "{output_path}-{alias}"
        fs_remove(out)
        let lrc = do_link_target(out, c_path, link_flags, obj_files, inc_flags, debug_mode, release_mode, triple, compiler_archive)
        if lrc != 0 {
            return lrc
        }
        if json_output != 0 {
            if i > 0 {
                io.print_raw(",")
            }
            io.print_raw("\"{out}\"")
        } else {
            io.println("built: {out}")
        }
        i = i + 1
    }
    if json_output != 0 {
        io.println("]}")
    }
    return 0
}

// ── Per-module build (the default; --no-per-module opts out) ────────────────
//
// One C unit per program module, compiled in parallel and cached one object per unit, so an
// edit recompiles the units whose C or headers changed rather than the whole program. The
// units link against the stdlib archive the same as the one-unit build: the archive defines
// the runtime and every std body it holds, and a unit writes only what the archive cannot
// hold. See docs/build/per-module-o-default.md.

// How many units a build, run and test compile at once: 0 when it builds one C unit, else
// --jobs, BLINK_JOBS or -1 for the CPU count. A job count that is not a positive integer is an
// error rather than a silent fallback, so a typo cannot quietly serialise a build. Only a
// per-module build reads the count, so only it can fail on one.
fn unit_jobs_from_args(a: Args) -> Int {
    if !per_module_selected(a) { return 0 }
    let flag = args_get(a, "jobs")
    let env_val = env.var("BLINK_JOBS") ?? ""
    let (raw, name) = if flag != "" { (flag, "--jobs") } else { (env_val, "BLINK_JOBS") }
    if raw != "" {
        let n = raw.to_int()
        if n <= 0 || "{n}" != raw.trim() {
            io.eprintln("error: {name} must be a positive integer, got '{raw}'")
            exit(1)
        }
        return n
    }
    // Read only when a unit compiles: it costs an exec, and a no-change build compiles none.
    -1
}

// Whether a build, run or test takes the per-module path. A flag on the command beats
// BLINK_PER_MODULE, which beats the default. --no-per-module keeps the one-unit build
// reachable, so a per-module bug can be bisected against it.
fn per_module_selected(a: Args) -> Bool {
    // Read even under a flag, so a bad value fails here and not in a build this one starts.
    let by_env = per_module_from_env()
    let on = args_has(a, "per-module")
    let off = args_has(a, "no-per-module")
    if on && off {
        io.eprintln("error: --per-module and --no-per-module are mutually exclusive")
        exit(1)
    }
    if on { return true }
    if off { return false }
    by_env
}

// BLINK_PER_MODULE sets the path for every build, run and test that passes neither flag, so
// the builds a program starts through the CLI take the same path as the caller. Any value but
// 0 or 1 is an error, for the same reason as a bad job count.
fn per_module_from_env() -> Bool {
    let raw = env.var("BLINK_PER_MODULE") ?? ""
    if raw == "" || raw == "1" { return true }
    if raw == "0" { return false }
    io.eprintln("error: BLINK_PER_MODULE must be 0 or 1, got '{raw}'")
    exit(1)
    false
}

// Why a --per-module build falls back to one unit, or "" when it does not.
fn per_module_fallback_reason(emit_mode: Str, format_flag: Str) -> Str {
    if emit_mode == "c" { return "--emit c writes one C file" }
    if format_flag == "blink" { return "--format blink formats the source" }
    if (env.var("BLINK_SKIP_MODULES") ?? "") != "" { return "BLINK_SKIP_MODULES is set" }
    if (env.var("BLINK_ONLY_MODULE") ?? "") != "" { return "BLINK_ONLY_MODULE is set" }
    if compiler_archive_env() != "" { return "BLINK_COMPILER_ARCHIVE is set" }
    ""
}

// The headers of a per-module build: the types header, and each module's two headers in
// `order`, the order a unit includes them in.
type UnitHeaders {
    index: HeaderIndex
    order: List[Str]
    // Every header written, the types header first, and its text.
    files: List[Str]
    texts: List[Str]
    // Each module's key for the record: what its headers are a function of besides its own
    // declarations.
    keys: Map[Str, Str]
    // The module headers linked from the last build, which the build checks against its
    // record when it hashes its units directory.
    kept: Map[Str, Bool]
}

// Writes the types header and each module's two headers into dir. `full_walk` walks the
// typedefs again for each module, as the verify's cold emit does; otherwise one walk serves
// every header. With `last`, a module whose headers emit_record.headers_unchanged allows keeps
// the last build's, and a header whose text did not change is a link to the last build's file.
fn write_unit_headers(program: Int, modules: List[Str], cfg: CgConfig, facts: ProgramFacts, dir: Str, full_walk: Bool, last: Option[emit_record.LastBuild]) -> Result[UnitHeaders, Int] ! Diag.Report, Codegen, IO {
    let types = generate_types_header(program, cfg)
    let trc = units_bail_on_diag()
    if trc != 0 { return Err(trc) }
    let from_dir = match last {
        Some(lb) => lb.from_dir
        None => ""
    }
    emit_record.keep_or_write(from_dir, dir, c_program_types_header_name(), types)
    let types_sha = sha256_hex(types)
    let mut keys: Map[Str, Str] = Map()
    let mut kept: Map[Str, Bool] = Map()
    let mut names: List[Str] = []
    let mut texts: List[Str] = []
    let mut pre: Option[HeaderPreamble] = None
    for m in modules {
        let key = sha256_hex("{types_sha}\n{module_instance_names(cfg, m).join("\n")}")
        keys.insert(m, key)
        let surface_name = c_module_header_name(m)
        let internal_name = c_module_private_header_name(m)
        let mut linked: Option[List[Str]] = None
        match last {
            Some(lb) => {
                if !full_walk && emit_record.headers_unchanged(lb, m, key) {
                    linked = emit_record.link_last_files(lb, dir, [surface_name, internal_name])
                }
            }
            None => {}
        }
        match linked {
            Some(ts) => {
                dbg_trace("build.unit_headers", "keep headers {m}")
                kept.insert(surface_name, true)
                kept.insert(internal_name, true)
                names.push(surface_name)
                texts.push(ts.get(0).unwrap())
                names.push(internal_name)
                texts.push(ts.get(1).unwrap())
            }
            None => {
                // The walk costs as much as a few headers, so a build that keeps every header
                // skips it.
                if !full_walk && pre.is_none() {
                    pre = Some(header_preamble(program, cfg, facts))
                    let prc = units_bail_on_diag()
                    if prc != 0 { return Err(prc) }
                }
                let hs = match pre {
                    Some(p) => generate_module_headers_from(m, cfg, p)
                    None => generate_module_headers_with(program, m, cfg, facts)
                }
                let hrc = units_bail_on_diag()
                if hrc != 0 { return Err(hrc) }
                emit_record.keep_or_write(from_dir, dir, surface_name, hs.surface)
                emit_record.keep_or_write(from_dir, dir, internal_name, hs.internal)
                names.push(surface_name)
                texts.push(hs.surface)
                names.push(internal_name)
                texts.push(hs.internal)
            }
        }
    }
    let mut files = [c_program_types_header_name()]
    let mut file_texts = [types]
    for n in names { files.push(n) }
    for t in texts { file_texts.push(t) }
    Ok(UnitHeaders { index: index_headers(names, texts, c_program_types_header_name()), order: names, files: files, texts: file_texts, keys: keys, kept: kept })
}

// Module m's unit with the declaration of each program symbol it names in place of its include
// of its own pub header, and the list of every header in the units directory it then includes.
fn unit_with_includes(c: Str, m: Str, hs: UnitHeaders) -> (Str, List[Str]) {
    let own = c_module_header_name(m)
    let types = c_program_types_header_name()
    let d = unit_declarations(c, [own, c_module_private_header_name(m)], hs.index, hs.order)
    match splice_declarations(c, own, types, d) {
        Some(text) => {
            let mut all = [types]
            for h in d.whole {
                dbg_trace("build.unit_headers", "whole {m}: {h}: {hs.index.why.get(h) ?? ""}")
                all.push(h)
            }
            (text, all)
        }
        // A unit with no include of its own header is not one the emitter wrote, so its key
        // takes every header: a header too many costs a recompile, one too few a stale object.
        None => {
            dbg_trace("build.unit_headers", "whole {m}: every header: no include of {own}")
            (c, hs.files)
        }
    }
}

fn units_bail_on_diag() -> Int ! Diag.Report {
    if diag_ice_count > 0 {
        diag_flush()
        return 101
    }
    if diag_count > 0 {
        diag_flush()
        return 1
    }
    0
}

// The std modules the archive holds are declared, not compiled, as in the one-unit build.
fn units_cg_config(debug_mode: Int) -> CgConfig {
    let mut skip: Map[Str, Int] = Map()
    for k in list_stdlib_module_keys() {
        skip.insert(k, 1)
    }
    CgConfig { debug_mode: if debug_mode != 0 { 1 } else { 0 },
        trace_codegen: cli_trace_codegen, deterministic: cli_deterministic,
        emit_only_module: "", skip_modules: skip,
        user_tu_mode: 1, blink_ev_extern_only: 0, archive_build_mode: 0, archive_over_std: 0,
        compiler_archive_modules: Map() }
}

// The units of a per-module build in its units directory, and what its record needs.
type CompiledUnits {
    units: List[emit_record.EmittedUnit]
    // The text of the emit's inputs; "" when this build may neither reuse nor record units.
    inputs: Str
    // The sha of each file, when the build already hashed them.
    shas: Option[Map[Str, Str]]
    // The emit reported no diagnostic, so a build that reuses its units reports all it did.
    recordable: Bool
    // The module headers in the order a unit includes them, joined by ",", and each module's
    // header key, for the record.
    order: Str
    header_keys: Map[Str, Str]
    // The key of the facts the entry unit read that no source span carries, for the record.
    entry_key: Str
}

// A build reuses or records units only when the emit would print nothing: no trace but the
// build's own channels. --no-cache asks for every step again.
fn emit_reuse_allowed() -> Bool {
    if trace_mode != "" || cli_trace_codegen != 0 { return false }
    if cg_obj_cache_enabled == 0 || !build_objcache.cache_enabled() { return false }
    if dbg_channels != "" {
        for ch in dbg_channels.split(",") {
            if !ch.starts_with("build.") { return false }
        }
    }
    true
}

// Writes the per-module headers and one .c per unit into dir, or takes them from the record
// in last_dir when the emit's inputs are the ones it records.
// checked is the build the daemon forked this process for, whose checked program it
// compiles; None in any other process.
fn do_compile_units(source_path: Str, dir: Str, last_dir: Str, debug_mode: Int, strict_mode: Int, chunk_decls: Int, checked: Option[DaemonBuild]) -> Result[CompiledUnits, Int] ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, Codegen, IO {
    let front = match checked {
        Some(b) => checked_front_end(b, strict_mode)
        None => {
            // Only a build that may take units compares the interface texts, so only it parses for them.
            parser_want_interface_text(emit_reuse_allowed())
            let f = compile_front_end(source_path, strict_mode)
            parser_want_interface_text(false)
            f
        }
    }
    let program = match front {
        Ok(p) => p
        Err(rc) => return Err(rc)
    }
    let cfg = units_cg_config(debug_mode)
    let modules = enumerate_program_modules(program)
    let erc = units_bail_on_diag()
    if erc != 0 { return Err(erc) }
    let mut inputs = ""
    if emit_reuse_allowed() {
        let sha = process_compiler_sha()
        if sha != "" {
            inputs = emit_record.inputs_text(source_path, cfg, strict_mode, sha, get_arg(0), chunk_decls)
        }
    }
    let verify = emit_reuse_verify()
    if inputs != "" {
        match emit_record.reuse(last_dir, dir, inputs, resolve_archive_dir()) {
            Some(r) => {
                dbg_trace("build.units", "reuse emit")
                if verify {
                    let vrc = verify_against_cold_emit(program, modules, cfg, r.units, dir, chunk_decls)
                    if vrc != 0 { return Err(vrc) }
                }
                let wrc = units_flush_warnings(strict_mode)
                if wrc != 0 { return Err(wrc) }
                return Ok(CompiledUnits { units: r.units, inputs: inputs, shas: Some(r.shas), recordable: true, order: r.order, header_keys: r.header_keys, entry_key: r.entry_key })
            }
            None => {}
        }
    }
    dbg_trace("build.units", "emit")
    let entries_before = diag_entry_count()
    let ice_before = diag_ice_count
    let facts = program_facts(program, cfg)
    let unit_modules = archive_unit_modules(program, cfg)
    let urc = units_bail_on_diag()
    if urc != 0 { return Err(urc) }
    let sources = unit_sources(unit_modules, inputs != "")
    let mut last: Option[emit_record.LastBuild] = None
    if inputs != "" && sources.tracked {
        last = emit_record.last_build(last_dir, inputs, sources.own)
    }
    let mut hs = match write_unit_headers(program, modules, cfg, facts, dir, false, last) {
        Ok(h) => h
        Err(rc) => return Err(rc)
    }
    let mut taken: Option[emit_record.TakenUnits] = None
    // The entry key of this build when it took the entry unit, which it then does not emit.
    let mut taken_entry_key = ""
    match last {
        Some(lb) => {
            taken = emit_record.take_units(lb, dir, unit_modules, hs.files, hs.texts, hs.order, hs.kept)
            match taken {
                Some(t) => {
                    if units_hold_module(t.units, "__main__") {
                        taken_entry_key = entry_unit_key(program, facts, sources)
                        if taken_entry_key != lb.rec.entry_key {
                            dbg_trace("build.units", "skip unit __main__: the facts of the whole program it reads differ")
                            taken = Some(emit_record.without_unit(t, "__main__"))
                            taken_entry_key = ""
                        }
                    }
                }
                None => {}
            }
        }
        None => {}
    }
    let mut by_module: Map[Str, emit_record.EmittedUnit] = Map()
    match taken {
        Some(t) => {
            for u in t.units {
                dbg_trace("build.units", "reuse unit {u.module}")
                by_module.insert(u.module, u)
            }
        }
        None => {}
    }
    for m in unit_modules {
        if by_module.contains_key(m) { continue }
        match emit_unit(program, m, cfg, facts, hs, sources, dir, chunk_decls) {
            Ok(u) => by_module.insert(m, u)
            Err(rc) => return Err(rc)
        }
    }
    let mut shas: Option[Map[Str, Str]] = None
    if inputs != "" {
        // Hashed with the units, so the record can name the inputs text by its sha.
        write_file("{dir}/{emit_record.inputs_name()}", inputs)
        let mut extra = [emit_record.inputs_name()]
        let mut placed = true
        match taken {
            Some(t) => {
                for x in t.extras { extra.push(x) }
                placed = emit_record.place_taken(t)
            }
            None => {}
        }
        shas = if placed { build_objcache.unit_file_shas_with(dir, resolve_archive_dir(), extra) } else { None }
        let headers_held = match last {
            Some(lb) => match shas {
                Some(s) => emit_record.kept_headers_hold(lb, hs.kept, s)
                None => hs.kept.len() == 0
            }
            None => true
        }
        if !headers_held {
            // Another build replaced the last units directory after this one read its record,
            // and every unit declares what the kept headers held. The build writes the headers
            // and every unit as one that keeps and takes nothing.
            dbg_trace("build.units", "emit the headers and every unit again")
            for name in list_dir(dir) {
                let _ = build_fs.remove_tree("{dir}/{name}")
            }
            hs = match write_unit_headers(program, modules, cfg, facts, dir, false, None) {
                Ok(h) => h
                Err(rc) => return Err(rc)
            }
            by_module = Map()
            taken_entry_key = ""
            for m in unit_modules {
                match emit_unit(program, m, cfg, facts, hs, sources, dir, chunk_decls) {
                    Ok(u) => by_module.insert(m, u)
                    Err(rc) => return Err(rc)
                }
            }
            write_file("{dir}/{emit_record.inputs_name()}", inputs)
            taken = None
            shas = build_objcache.unit_file_shas_with(dir, resolve_archive_dir(), [emit_record.inputs_name()])
        }
        match taken {
            Some(t) => {
                let held = match shas {
                    Some(s) => emit_record.taken_units_hold(t, s)
                    None => false
                }
                if !held {
                    // Another build replaced the last units directory after this one read its
                    // record, so what it took may be of two builds. It emits them after all.
                    taken_entry_key = ""
                    for u in t.units {
                        dbg_trace("build.units", "emit unit {u.module} again")
                        for f in emit_record.unit_files(u) { fs_remove("{dir}/{f.stem}.c") }
                        match emit_unit(program, u.module, cfg, facts, hs, sources, dir, chunk_decls) {
                            Ok(e) => by_module.insert(u.module, e)
                            Err(rc) => return Err(rc)
                        }
                    }
                    shas = build_objcache.unit_file_shas_with(dir, resolve_archive_dir(), [emit_record.inputs_name()])
                }
            }
            None => {}
        }
        match taken {
            Some(t) => {
                for x in t.extras { fs_remove("{dir}/{x}") }
            }
            None => {}
        }
    }
    let mut out: List[emit_record.EmittedUnit] = []
    for m in unit_modules {
        match by_module.get(m) {
            Some(u) => out.push(u)
            None => {}
        }
    }
    let mut entry_key = taken_entry_key
    if entry_key == "" && inputs != "" && by_module.contains_key("__main__") {
        entry_key = entry_unit_key(program, facts, sources)
    }
    if verify {
        let vrc = verify_against_cold_emit(program, modules, cfg, out, dir, chunk_decls)
        if vrc != 0 { return Err(vrc) }
    }
    let recordable = diag_entry_count() == entries_before && diag_ice_count == ice_before
    let wrc = units_flush_warnings(strict_mode)
    if wrc != 0 { return Err(wrc) }
    Ok(CompiledUnits { units: out, inputs: inputs, shas: shas, recordable: recordable, order: hs.order.join(","), header_keys: hs.keys, entry_key: entry_key })
}

// BLINK_EMIT_REUSE_VERIFY=1 makes each per-module build emit the whole program again and fail
// unless every file is byte-equal. Also a build that takes nothing: it writes its headers from
// one shared preamble, which the cold emit does not. It proves the reuse key in tests; it never
// changes the C.
fn emit_reuse_verify() -> Bool {
    (env.var("BLINK_EMIT_REUSE_VERIFY") ?? "") == "1"
}

// Emits the headers and every unit as a build that takes nothing would, into a directory of
// its own, and gives 1 after naming the first file not byte-equal to the build's. Every file,
// not only the units taken: main, a header or a unit lowered beside a taken unit can read what
// the taken unit's lowering would have set. The files taken are links to the last build's, so
// nothing is written beside them.
fn verify_against_cold_emit(program: Int, modules: List[Str], cfg: CgConfig, units: List[emit_record.EmittedUnit], dir: Str, chunk_decls: Int) -> Int ! Diag.Report, Codegen, IO {
    let vdir = "{dir}/.verify"
    shell_exec("rm -rf \"{vdir}\" && mkdir -p \"{vdir}\"")
    let rc = verify_cold_files(program, modules, cfg, units, dir, vdir, chunk_decls)
    shell_exec("rm -rf \"{vdir}\"")
    rc
}

fn verify_cold_files(program: Int, modules: List[Str], cfg: CgConfig, units: List[emit_record.EmittedUnit], dir: Str, vdir: Str, chunk_decls: Int) -> Int ! Diag.Report, Codegen, IO {
    let facts = program_facts(program, cfg)
    let hs = match write_unit_headers(program, modules, cfg, facts, vdir, true, None) {
        Ok(h) => h
        Err(rc) => return rc
    }
    for f in hs.files {
        if read_file("{vdir}/{f}") != read_file("{dir}/{f}") {
            io.eprintln("error: emit reuse verify: header {f} is not the header a cold emit writes")
            return 1
        }
        dbg_trace("build.units", "verify header {f} same")
    }
    let unit_modules = archive_unit_modules(program, cfg)
    let urc = units_bail_on_diag()
    if urc != 0 { return urc }
    let mut built: List[Str] = []
    for u in units { built.push(u.module) }
    if built.join(",") != unit_modules.join(",") {
        io.eprintln("error: emit reuse verify: the build has units {built.join(",")}, a cold emit {unit_modules.join(",")}")
        return 1
    }
    let sources = unit_sources(unit_modules, false)
    let mut cold: List[emit_record.EmittedUnit] = []
    for m in unit_modules {
        match emit_unit(program, m, cfg, facts, hs, sources, vdir, chunk_decls) {
            Ok(u) => cold.push(u)
            Err(erc) => return erc
        }
    }
    let mut ui = 0
    while ui < cold.len() {
        let mut built_files: List[Str] = []
        for f in emit_record.unit_files(units.get(ui).unwrap()) { built_files.push(f.stem) }
        let mut cold_files: List[Str] = []
        for f in emit_record.unit_files(cold.get(ui).unwrap()) { cold_files.push(f.stem) }
        let m = cold.get(ui).unwrap().module
        if built_files.join(",") != cold_files.join(",") {
            io.eprintln("error: emit reuse verify: unit {m} has the files {built_files.join(",")}, a cold emit {cold_files.join(",")}")
            return 1
        }
        for f in cold_files {
            let cold_text = read_file("{vdir}/{f}.c")
            let built_text = read_file("{dir}/{f}.c")
            if cold_text != built_text {
                let why = emit_record.verify_differ_reason(m, units.get(ui).unwrap().uses, cold.get(ui).unwrap().uses, built_text, cold_text)
                io.eprintln("error: emit reuse verify: unit {f} is not the unit a cold emit writes: {why}")
                return 1
            }
            dbg_trace("build.units", "verify unit {f} same")
        }
        ui = ui + 1
    }
    0
}

// The loaded sources, as a unit's emit tells which it read.
type UnitSources {
    // The node ranges are in node order and one path per range, so a node names one source.
    tracked: Bool
    firsts: List[Int]
    ends: List[Int]
    paths: List[Str]
    modules: List[Str]
    // The path of each source of a module that has a unit.
    own: Map[Str, Bool]
}

fn unit_sources(unit_modules: List[Str], wanted: Bool) -> UnitSources {
    let firsts = loaded_inputs.source_first_nodes
    let ends = loaded_inputs.source_end_nodes
    let paths = loaded_inputs.source_paths
    let modules = loaded_inputs.source_modules
    let n = paths.len()
    let mut tracked = wanted && firsts.len() == n && ends.len() == n && modules.len() == n
    let mut i = 0
    while tracked && i < n {
        if ends[i] < firsts[i] || (i > 0 && firsts[i] < ends[i - 1]) { tracked = false }
        i = i + 1
    }
    let mut has_unit: Map[Str, Bool] = Map()
    for m in unit_modules { has_unit.insert(m, true) }
    let mut own: Map[Str, Bool] = Map()
    if tracked {
        i = 0
        while i < n {
            if has_unit.contains_key(modules[i]) { own.insert(paths[i], true) }
            i = i + 1
        }
    }
    UnitSources { tracked: tracked, firsts: firsts, ends: ends, paths: paths, modules: modules, own: own }
}

// Emits module m's unit into dir, with the sources its IR spanned, cut into chunks as
// chunk_decls says.
fn emit_unit(program: Int, m: Str, cfg: CgConfig, facts: ProgramFacts, hs: UnitHeaders, sources: UnitSources, dir: Str, chunk_decls: Int) -> Result[emit_record.EmittedUnit, Int] ! Diag.Report, Codegen {
    // Untracked, the empty ranges keep a unit's emit from marking sources it reads.
    if sources.tracked { ir_track_sources(sources.firsts, sources.ends) } else { ir_track_sources([], []) }
    // Copy-update, so a field added to CgConfig later keeps cfg's value here.
    let obj_cfg = CgConfig { blink_ev_extern_only: if m != "__main__" { 1 } else { 0 }, ..cfg }
    let parts = generate_module_chunks_with(program, m, c_module_header_name(m), obj_cfg, facts, chunk_decls)
    let orc = units_bail_on_diag()
    if orc != 0 { return Err(orc) }
    let mut files: List[emit_record.UnitChunkFile] = []
    for part in parts {
        let stem = if part.suffix == "" { m } else { "{m}.{part.suffix}" }
        let (c, headers) = if part.plain { (part.c, []) } else { unit_with_includes(part.c, m, hs) }
        write_file("{dir}/{stem}.c", c)
        files.push(emit_record.UnitChunkFile { stem: stem, c_bytes: c.byte_len(), headers: headers })
    }
    let head = files.get(0).unwrap()
    let mut chunks: List[emit_record.UnitChunkFile] = []
    let mut i = 1
    while i < files.len() {
        chunks.push(files.get(i).unwrap())
        i = i + 1
    }
    Ok(emit_record.EmittedUnit { module: m, c_bytes: head.c_bytes, headers: head.headers, uses: unit_uses(m, sources), chunks: chunks })
}

fn units_hold_module(units: List[emit_record.EmittedUnit], m: Str) -> Bool {
    for u in units {
        if u.module == m { return true }
    }
    false
}

// The sha of what the entry unit's text reads of the whole program with no source span to key
// it: the facts entry_unit_facts gives, the init names its shim calls, and the source of the
// node each key table is written from, whose position the table's lowering spans.
fn entry_unit_key(program: Int, facts: ProgramFacts, sources: UnitSources) -> Str ! Diag.Report {
    // No unit is being emitted, so nothing read here is a unit's.
    ir_track_sources([], [])
    let mut lines = entry_unit_facts(program, facts)
    for n in facts.entry_init_fns { lines.push("init {n}") }
    for node in facts.key_table_nodes { lines.push("table_source {source_of_node(sources, node)}") }
    sha256_hex(lines.join("\n"))
}

// The path of the source whose node range holds node, or "-".
fn source_of_node(sources: UnitSources, node: Int) -> Str {
    let mut i = 0
    while i < sources.paths.len() {
        if node >= sources.firsts[i] && node < sources.ends[i] { return sources.paths[i] }
        i = i + 1
    }
    "-"
}

// The mean number of decls in each file a large module's unit is cut into, or 0 to cut
// none: BLINK_UNIT_CHUNK_DECLS, which tests set low so that a small module is cut, or 32. A
// release build cuts nothing, so cc sees each module whole, to inline across its functions.
fn unit_chunk_decls(release_mode: Int) -> Int {
    if release_mode != 0 { return 0 }
    let v = env.var("BLINK_UNIT_CHUNK_DECLS") ?? ""
    let n = v.to_int()
    if v != "" && n >= 0 && "{n}" == v { return n }
    32
}

// The sources module m's unit read: its own, whose every edit can move a line the unit
// carries, and each the emit marked: one its IR spans, whose fn body it lowered or inspected,
// or whose node position it wrote. The record keys the rest of every source on its interface
// text, which leaves out bodies and positions. Empty, so no later build takes the unit on its
// own, when the module has no source of its own to key on.
fn unit_uses(m: Str, sources: UnitSources) -> List[Str] {
    if !sources.tracked { return [] }
    let mut read: Map[Int, Bool] = Map()
    for i in ir_sources_read() { read.insert(i, true) }
    let mut out: List[Str] = []
    let mut has_own = false
    let mut i = 0
    while i < sources.paths.len() {
        let is_own = sources.modules[i] == m
        if is_own { has_own = true }
        if is_own || read.contains_key(i) { out.push(sources.paths[i]) }
        i = i + 1
    }
    if !has_own { return [] }
    out
}

fn units_flush_warnings(strict_mode: Int) -> Int ! Diag.Report {
    if diag_warn_count > 0 {
        diag_flush()
        if strict_mode != 0 {
            return 1
        }
    }
    0
}

fn do_build_units(source_path: Str, output_path: Str, debug_mode: Int, release_mode: Int, targets: List[Str], json_output: Int, strict_mode: Int, unit_jobs: Int, checked: Option[DaemonBuild]) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, Codegen, IO {
    let mut out_dir = path_dirname(output_path)
    if out_dir == "" {
        out_dir = "."
    }
    let units_dir = "{out_dir}/{strip_extension(path_basename(output_path))}.units"
    // The units are written into a directory no other build writes, so the bytes a key
    // hashes are the bytes cc compiles. It replaces units_dir once the build is done, and
    // the objects carry units_dir's path through -ffile-prefix-map.
    let work = build_fs.private_dir(out_dir, ".units")
    if work == "" {
        io.eprintln("error: cannot make a units directory in {out_dir}")
        return 1
    }
    let compiled = match do_compile_units(source_path, work, units_dir, debug_mode, strict_mode, unit_chunk_decls(release_mode), checked) {
        Ok(u) => u
        Err(rc) => {
            let _ = build_fs.remove_tree(work)
            return rc
        }
    }
    // Hashed once, for both the cache keys and the record.
    let mut shas = compiled.shas
    if shas.is_none() && cg_obj_cache_enabled != 0 && build_objcache.cache_enabled() {
        shas = build_objcache.unit_file_shas(work, resolve_archive_dir())
    }
    let rc = link_units_all_targets(source_path, output_path, work, units_dir, compiled.units, shas, debug_mode, release_mode, targets, json_output, unit_jobs)
    // Written last, and into the directory that replaces units_dir only after this: a build
    // that stops before here leaves the last record beside the files it describes.
    if rc == 0 && compiled.inputs != "" && compiled.recordable {
        match shas {
            Some(s) => {
                let _ = emit_record.write_record(work, compiled.inputs, compiled.units, s, compiled.order, compiled.header_keys, compiled.entry_key)
            }
            None => {}
        }
    }
    // rename(2) fails, where mv would move work into it, when another build made units_dir
    // again after the remove; this build then tries once more and else leaves units_dir be.
    if !(build_fs.remove_tree(units_dir) && build_fs.rename(work, units_dir)) {
        if !(build_fs.remove_tree(units_dir) && build_fs.rename(work, units_dir)) {
            let _ = build_fs.remove_tree(work)
        }
    }
    rc
}

fn link_units_all_targets(source_path: Str, output_path: Str, work: Str, units_dir: Str, units: List[emit_record.EmittedUnit], shas: Option[Map[Str, Str]], debug_mode: Int, release_mode: Int, targets: List[Str], json_output: Int, unit_jobs: Int) -> Int ! Diag.Report, IO {
    // The scans below read what the one-unit build reads from its single C file: each unit
    // and each header a unit includes, which is all cc compiles. A marker the scans look
    // for starts a line, so each file starts one.
    let mut c_parts: List[Str] = []
    let mut seen: Map[Str, Bool] = Map()
    for u in units {
        for f in emit_record.unit_files(u) {
            for h in f.headers {
                if seen.contains_key(h) == 0 {
                    seen.insert(h, true)
                    c_parts.push(read_file("{work}/{h}"))
                }
            }
            c_parts.push(read_file("{work}/{f.stem}.c"))
        }
    }
    let c_source = c_parts.join("\n")
    let has_async = detect_async(read_file(source_path))
    let used_deps = detect_native_deps(c_source)
    let ffi_libs = detect_ffi_libs(c_source)
    let vrc = validate_build_deps(ffi_libs, targets)
    if vrc != 0 {
        return vrc
    }
    if targets.len() <= 1 {
        let target = if targets.len() == 1 { resolve_target_triple(targets.get(0).unwrap()) } else { "" }
        let link_flags = build_link_flags(target, has_async, used_deps, ffi_libs)
        let obj_files = resolve_vendored_objects(used_deps, debug_mode, release_mode, target)
        let inc_flags = resolve_vendored_includes(used_deps, target)
        let lrc = link_units(output_path, work, units_dir, units, shas, link_flags, obj_files, inc_flags, debug_mode, release_mode, target, unit_jobs)
        if lrc != 0 {
            return lrc
        }
        if json_output != 0 {
            io.println("\{\"status\":\"ok\",\"output\":\"{output_path}\"}")
        } else {
            io.println("built: {output_path}")
        }
        return 0
    }
    let first_triple = resolve_target_triple(targets.get(0).unwrap())
    let inc_flags = resolve_vendored_includes(used_deps, first_triple)
    if json_output != 0 {
        io.print_raw("\{\"status\":\"ok\",\"outputs\":[")
    }
    let mut i = 0
    while i < targets.len() {
        let alias = targets.get(i).unwrap()
        let triple = resolve_target_triple(alias)
        let link_flags = build_link_flags(triple, has_async, used_deps, ffi_libs)
        let obj_files = resolve_vendored_objects(used_deps, debug_mode, release_mode, triple)
        let out = "{output_path}-{alias}"
        fs_remove(out)
        let lrc = link_units(out, work, units_dir, units, shas, link_flags, obj_files, inc_flags, debug_mode, release_mode, triple, unit_jobs)
        if lrc != 0 {
            return lrc
        }
        if json_output != 0 {
            if i > 0 {
                io.print_raw(",")
            }
            io.print_raw("\"{out}\"")
        } else {
            io.println("built: {out}")
        }
        i = i + 1
    }
    if json_output != 0 {
        io.println("]}")
    }
    0
}

type UnitCompile {
    idx: Int
    exit_code: Int
    out: Str
    err_out: Str
    used_pch: Bool
}

// A PCH build for run_unit_compiles: cmd writes the .gch into the staged dir, which becomes
// the PCH for key when cmd ends well. The units read it from hold. An empty cmd builds none.
type PchJob {
    cmd: Str
    key: Str
    staged: Str
    hold: Str
}

// pch_child is a PCH build still running when every unit had started without it, or one with
// a pid of -1; the caller ends it with finish_pch.
type UnitRun {
    results: List[UnitCompile]
    pch_stored: Bool
    pch: PchJob
    pch_child: build_fs.FileChild
}

fn no_pch_job() -> PchJob {
    PchJob { cmd: "", key: "", staged: "", hold: "" }
}

fn no_child() -> build_fs.FileChild {
    build_fs.FileChild { pid: -1, live: -1, status: -1, out_path: "", err_path: "" }
}

// Waits for the PCH build run left running and installs its PCH. Answers whether this or run
// installed one.
fn finish_pch(run: UnitRun) -> Bool ! IO {
    if run.pch_child.pid < 0 {
        return run.pch_stored
    }
    let r = build_fs.reap_to_files(run.pch_child)
    if r.exit_code == 0 {
        return build_objcache.store_pch(run.pch.key, run.pch.staged)
    }
    let _ = build_fs.remove_tree(run.pch.staged)
    false
}

// Runs each unit command as sh would with at most `unit_jobs` at a time (the CPU count for
// -1), starting them in list order. A unit runs with_pch[i] when pch_ready, or when it starts
// after the PCH build ended and installed its PCH, and plain[i] otherwise or when with_pch[i]
// is empty. The PCH build
// starts first in a slot of its own, so the units that start before it ends do not wait.
// When every unit starts before it ends, no unit of this build reads it, so it runs on past
// the units and the caller ends it after its link: a small build need not wait for it.
// Answers one result per unit, indexed by its place in the list.
// The children are started and reaped from this thread rather than from async tasks: the
// async pool has four threads and a task that waits on a child holds one, so tasks could
// never run more than four at once. Whichever unit ends first frees its slot for the next
// one, so a unit that ends early does not wait on a long one started before it. A unit and
// the PCH build write their output to files in io_dir, which a slow reap cannot fill as it
// can a pipe.
// Only the units are waited on by pid, so no child another part of this process started is
// reaped here.
fn run_unit_compiles(plain: List[Str], with_pch: List[Str], pch_ready: Bool, pch: PchJob, unit_jobs: Int, io_dir: Str) -> UnitRun ! IO {
    let n = plain.len()
    let mut by_idx: List[UnitCompile] = []
    if n == 0 { return UnitRun { results: by_idx, pch_stored: false, pch: no_pch_job(), pch_child: no_child() } }
    let jobs = if unit_jobs > 0 { unit_jobs } else { build_fs.cpu_count() }
    let mut ready = pch_ready
    let mut stored = false
    let mut pch_child = no_child()
    if pch.cmd != "" {
        // No key: the key holds the archive dir, and tests match this trace across trees.
        dbg_trace("build.units", "pch build")
        pch_child = spawn_unit(pch.cmd, io_dir, "pch")
        if pch_child.pid < 0 {
            let _ = build_fs.reap_to_files(pch_child)
            let _ = build_fs.remove_tree(pch.staged)
            pch_child = no_child()
        }
    }
    let slots = if pch_child.pid > 0 && jobs > 1 { jobs - 1 } else { jobs }
    let mut units: List[build_fs.FileChild] = []
    let mut used: List[Bool] = []
    let mut started = 0
    while started < n && started < slots {
        let reads_pch = ready && with_pch.get(started).unwrap() != ""
        units.push(spawn_unit(if reads_pch { with_pch.get(started).unwrap() } else { plain.get(started).unwrap() }, io_dir, "{started}"))
        used.push(reads_pch)
        started = started + 1
    }
    if pch_child.pid > 0 && started < n {
        let r = build_fs.reap_to_files(pch_child)
        if r.exit_code == 0 {
            // Held before the store: once stored, the GC of another build can remove it.
            ready = build_objcache.hold_pch(pch.staged, pch.hold)
            stored = build_objcache.store_pch(pch.key, pch.staged)
        } else {
            let _ = build_fs.remove_tree(pch.staged)
        }
        if started < n && slots < jobs {
            let reads_pch = ready && with_pch.get(started).unwrap() != ""
            units.push(spawn_unit(if reads_pch { with_pch.get(started).unwrap() } else { plain.get(started).unwrap() }, io_dir, "{started}"))
            used.push(reads_pch)
            started = started + 1
        }
        pch_child = no_child()
    }
    let mut ends: List[Option[UnitCompile]] = []
    for _ in units {
        ends.push(None)
    }
    let mut reaped = 0
    while reaped < n {
        units = build_fs.wait_children(units)
        // A unit that could not start has ended too, and wait_children passes it over.
        let mut ended: List[Int] = []
        let mut i = 0
        while i < units.len() {
            let u = units.get(i).unwrap()
            if ends.get(i).unwrap().is_none() && (u.pid <= 0 || u.status != -1) {
                ended.push(i)
            }
            i = i + 1
        }
        for idx in ended {
            let u = units.get(idx).unwrap()
            let r = build_fs.reap_to_files(u)
            units.set(idx, build_fs.FileChild { pid: -1, live: -1, ..u })
            ends.set(idx, Some(UnitCompile { idx: idx, exit_code: r.exit_code, out: r.out, err_out: r.err_out, used_pch: used.get(idx).unwrap() }))
            reaped = reaped + 1
            if started < n {
                let reads_pch = ready && with_pch.get(started).unwrap() != ""
                units.push(spawn_unit(if reads_pch { with_pch.get(started).unwrap() } else { plain.get(started).unwrap() }, io_dir, "{started}"))
                used.push(reads_pch)
                ends.push(None)
                started = started + 1
            }
        }
    }
    for e in ends {
        by_idx.push(e.unwrap())
    }
    UnitRun { results: by_idx, pch_stored: stored, pch: pch, pch_child: pch_child }
}

// The macros the unit at c_path defines before it includes the archive header, as -D flags
// in its order, or None when anything else comes first. gcc takes a PCH only for a unit that
// defines the macros it was built with. The prologue is a line per gate the unit reads, so
// the head of the file holds it.
fn archive_header_prefix(c_path: Str) -> Option[List[Str]] ! IO {
    let text = read_file(c_path)
    let head = text.byte_slice(0, if text.byte_len() < 4096 { text.byte_len() } else { 4096 })
    let mut defines: List[Str] = []
    for line in head.split("\n") {
        if line == "#include \"libblink_std.h\"" {
            return Some(defines)
        }
        let parts = line.split(" ")
        if parts.len() != 3 || parts.get(0).unwrap() != "#define" {
            return None
        }
        defines.push("-D{parts.get(1).unwrap()}={parts.get(2).unwrap()}")
    }
    None
}

// A PCH of the archive header serves only a plain gcc compile. clang and zig cc read a PCH
// only through -include-pch, ccache needs settings of its own to pass one, and a .gch beside
// the archive header already serves every unit. BLINK_ARCHIVE_PCH=0 turns it off, so a test
// can build the same objects with no PCH in the cache.
fn archive_pch_eligible(target: Str, arc_dir: Str) -> Bool ! IO {
    if (env.var("BLINK_ARCHIVE_PCH") ?? "") == "0" {
        return false
    }
    if target != "" || has_ccache() != 0 {
        return false
    }
    if file_exists("{arc_dir}/libblink_std.h.gch") == 1 {
        return false
    }
    !process_cc_id(target).contains("clang")
}

// Compiles the units the cache cannot answer, largest first, then links every unit's object
// against the archive.
fn link_units(out: Str, work: Str, units_dir: Str, units: List[emit_record.EmittedUnit], shas: Option[Map[Str, Str]], link_flags: Str, obj_files: List[Str], include_flags: Str, debug_mode: Int, release_mode: Int, target: Str, unit_jobs: Int) -> Int ! Diag.Report, IO {
    let arc_dir = resolve_archive_dir()
    let vrc = verify_installed_archive(arc_dir)
    if vrc != 0 {
        return vrc
    }
    // Each file of a unit compiles to an object of its own, cached on its own.
    let mut files: List[emit_record.UnitChunkFile] = []
    for u in units {
        for f in emit_record.unit_files(u) { files.push(f) }
    }
    let obj_dir = if target != "" { "{work}/obj-{target}" } else { "{work}/obj" }
    let _ = build_fs.mkdir_p(obj_dir)
    let use_cache = cg_obj_cache_enabled != 0 && build_objcache.cache_enabled()
    let mut keys: Map[Str, Str] = Map()
    // The obj keys and the PCH key share the hashes of the vendored headers.
    let mut vendored_headers: Option[List[Str]] = None
    if use_cache && shas.is_some() {
        let mut vendored_dirs: List[Str] = []
        for part in include_flags.split(" ") {
            if part.starts_with("-I") {
                vendored_dirs.push(part.byte_slice(2, part.byte_len()))
            }
        }
        vendored_headers = build_objcache.header_lines_in(vendored_dirs)
        let mut modules: List[Str] = []
        let mut unit_headers: Map[Str, List[Str]] = Map()
        for u in files {
            modules.push(u.stem)
            unit_headers.insert(u.stem, u.headers)
        }
        match vendored_headers {
            Some(lines) => {
                keys = build_objcache.unit_keys_with_headers(shas.unwrap(), modules, unit_headers, arc_dir, lines, process_compiler_sha(), process_cc_id(target), unit_key_flags(debug_mode, release_mode), target)
            }
            None => {}
        }
    }
    let mut objs: Map[Str, Str] = Map()
    let mut misses: List[emit_record.UnitChunkFile] = []
    let mut unit_keys: List[Str] = []
    for u in files {
        unit_keys.push(keys.get(u.stem) ?? "")
    }
    let hold = if keys.len() > 0 { build_objcache.make_hold_dir() } else { "" }
    let hits = build_objcache.hold_objs(unit_keys, hold)
    let mut ui = 0
    for u in files {
        let hit = hits.get(ui).unwrap()
        ui = ui + 1
        if hit != "" {
            dbg_trace("build.units", "hit {u.stem}")
            objs.insert(u.stem, hit)
        } else {
            misses.push(u)
        }
    }
    // Largest first: the biggest unit bounds the wall time, so it must not start last.
    let mut i = 1
    while i < misses.len() {
        let cur = misses.get(i).unwrap()
        let mut j = i
        while j > 0 && misses.get(j - 1).unwrap().c_bytes < cur.c_bytes {
            misses.set(j, misses.get(j - 1).unwrap())
            j = j - 1
        }
        misses.set(j, cur)
        i = i + 1
    }
    let includes = if include_flags != "" { "-I{arc_dir} {include_flags}" } else { "-I{arc_dir}" }
    // One PCH serves the units that define one set of macros before the archive header: the
    // set most of the units to compile define. The rest read the header.
    let mut prefixes: List[Str] = []
    let mut pch_prefix = ""
    let mut pch_defines: List[Str] = []
    if misses.len() > 0 && keys.len() > 0 && archive_pch_eligible(target, arc_dir) {
        let mut counts: Map[Str, Int] = Map()
        let mut best = 0
        for u in misses {
            // "" for a unit no PCH can serve; the "D" keeps a unit that defines nothing apart.
            let prefix = match archive_header_prefix("{work}/{u.stem}.c") {
                Some(defines) => {
                    let p = "D {defines.join(" ")}"
                    let c = (counts.get(p) ?? 0) + 1
                    counts.insert(p, c)
                    if c > best {
                        best = c
                        pch_prefix = p
                        pch_defines = defines
                    }
                    p
                }
                None => ""
            }
            prefixes.push(prefix)
        }
    }
    let mut pch_key = ""
    // The units read the PCH from here, never from the cache.
    let mut pch_hold = ""
    let mut pch_ready = false
    let mut pch = no_pch_job()
    if pch_prefix != "" {
        let s = shas.unwrap()
        let archive_sha = s.get("{arc_dir}/libblink_std.h") ?? ""
        let runtime_sha = s.get("{arc_dir}/runtime.h") ?? ""
        let mut include_list: List[Str] = []
        for part in include_flags.split(" ") {
            if part != "" { include_list.push(part) }
        }
        pch_key = build_objcache.pch_key(archive_sha, runtime_sha, process_cc_id(target), arc_dir, unit_key_flags(debug_mode, release_mode), pch_defines, include_list, vendored_headers ?? [])
        if pch_key != "" && hold != "" {
            pch_hold = "{hold}/pch"
            let found = build_objcache.lookup_pch(pch_key)
            pch_ready = found != "" && build_objcache.hold_pch(found, pch_hold)
            // A program's first build makes no PCH: a one-off build (a test, a CI job) would
            // pay for one that no later build reads. units_dir holds the last build of this
            // program, so the first edit after it builds the PCH while its units compile.
            if !pch_ready && is_dir(units_dir) == 1 {
                let staged = build_objcache.stage_pch(arc_dir, archive_sha, runtime_sha)
                if staged != "" {
                    // The debug info names the archive dir, as a unit's without the PCH does,
                    // and the header finds each file it includes where a unit's compile does.
                    let cmd = cc_command("{unit_cc_flags().join(" ")} {pch_defines.join(" ")} -ffile-prefix-map={staged}={arc_dir} -x c-header {staged}/libblink_std.h -o {staged}/libblink_std.h.gch -I{staged} {includes}", debug_mode, release_mode, target)
                    pch = PchJob { cmd: cmd, key: pch_key, staged: staged, hold: pch_hold }
                }
            }
        }
    }
    let mut cmds: List[Str] = []
    let mut pch_cmds: List[Str] = []
    let mut mi = 0
    for u in misses {
        dbg_trace("build.units", "compile {u.stem}")
        let line = "-c {unit_cc_flags().join(" ")} {work}/{u.stem}.c -o {obj_dir}/{u.stem}.o -ffile-prefix-map={work}={units_dir}"
        cmds.push(cc_command("{line} {includes}", debug_mode, release_mode, target))
        if pch_hold != "" && prefixes.get(mi).unwrap() == pch_prefix {
            pch_cmds.push(cc_command("{line} -ffile-prefix-map={pch_hold}={arc_dir} -I{pch_hold} {includes}", debug_mode, release_mode, target))
        } else {
            pch_cmds.push("")
        }
        mi = mi + 1
    }
    if build_objcache.dev_evict_at("compile") {
        dbg_trace("build.units", "dev evict compile")
    }
    let run = run_unit_compiles(cmds, pch_cmds, pch_ready, pch, unit_jobs, obj_dir)
    let mut results = run.results
    // gcc stops on a .gch cut short, where it reads the header beside any other .gch it cannot
    // take. So a unit that failed with the PCH compiles once more without it, and the PCH goes
    // when that compile ends well.
    let mut retry_idx: List[Int] = []
    let mut retry_cmds: List[Str] = []
    for r in results {
        if r.exit_code != 0 && r.used_pch {
            retry_idx.push(r.idx)
            retry_cmds.push(cmds.get(r.idx).unwrap())
        }
    }
    let mut dropped = false
    for a in run_unit_compiles(retry_cmds, retry_cmds, false, no_pch_job(), unit_jobs, obj_dir).results {
        let idx = retry_idx.get(a.idx).unwrap()
        dbg_trace("build.units", "pch fallback {misses.get(idx).unwrap().stem} exit {a.exit_code}")
        if a.exit_code == 0 && !dropped {
            build_objcache.drop_pch(pch_key)
            dropped = true
        }
        results.set(idx, UnitCompile { idx: idx, exit_code: a.exit_code, out: a.out, err_out: a.err_out, used_pch: false })
    }
    let mut failed = 0
    let mut store_keys: List[Str] = []
    let mut store_paths: List[Str] = []
    let mut store_modules: List[Str] = []
    for r in results {
        let m = misses.get(r.idx).unwrap().stem
        if r.used_pch {
            dbg_trace("build.units", "pch use {m}")
        }
        if r.exit_code != 0 {
            io.eprint_raw(r.err_out)
            io.print_raw(r.out)
            io.println("error: C compilation failed in unit {m}")
            failed = failed + 1
            continue
        }
        let local = "{obj_dir}/{m}.o"
        objs.insert(m, local)
        let key = keys.get(m) ?? ""
        if key != "" {
            store_keys.push(key)
            store_paths.push(local)
            store_modules.push(m)
        }
    }
    // Stored before the failure check, so a unit that compiled is not compiled again next time.
    let mut stored = false
    // The build links its own objects; the cache gets a link or a copy of each.
    let installed = build_objcache.install_objs(store_keys, store_paths, store_modules)
    for ok in installed {
        if ok { stored = true }
    }
    if failed > 0 {
        let _ = finish_pch(run)
        drop_link_holds(hold, store_paths, installed)
        return 1
    }
    let mut link_objs: List[Str] = []
    for u in files {
        link_objs.push(objs.get(u.stem) ?? "")
    }
    for o in obj_files {
        link_objs.push(o)
    }
    let incl = if include_flags != "" { " {include_flags}" } else { "" }
    let effective_link_flags = if link_flags.contains("-pthread") { link_flags } else { "{link_flags} -pthread" }
    if build_objcache.dev_evict_at("link") {
        dbg_trace("build.units", "dev evict link")
    }
    let rc = run_cc("-o {out} {link_objs.join(" ")}{incl} -I{arc_dir} {arc_dir}/libblink_std.a -Wl,--gc-sections {effective_link_flags}", debug_mode, release_mode, target)
    if finish_pch(run) {
        stored = true
    }
    drop_link_holds(hold, store_paths, installed)
    if rc != 0 {
        io.println("error: C compilation failed while linking {out}")
        return rc
    }
    if stored {
        build_objcache.maybe_gc()
    }
    0
}

// Removes the objects link_units held for its link: the hold dir of its cache hits, and each
// object it compiled that the cache now holds, which the units dir need not keep. Before the
// GC, so it does not count them.
fn drop_link_holds(hold: Str, compiled: List[Str], installed: List[Bool]) ! IO {
    if hold != "" {
        let _ = build_fs.remove_tree(hold)
    }
    let mut i = 0
    while i < compiled.len() {
        if installed.get(i).unwrap() {
            fs_remove(compiled.get(i).unwrap())
        }
        i = i + 1
    }
}

fn find_section_end(content: Str, section: Str) -> Int {
    let header = "[".concat(section).concat("]")
    let mut header_end = -1
    let mut i = 0
    while i < content.byte_len() - header.byte_len() {
        let mut found_match = 1
        let mut j = 0
        while j < header.byte_len() {
            if content.byte_at(i + j) != header.byte_at(j) {
                found_match = 0
                j = header.byte_len()
            }
            j = j + 1
        }
        if found_match == 1 {
            header_end = i + header.byte_len()
            while header_end < content.byte_len() && content.byte_at(header_end) != 10 {
                header_end = header_end + 1
            }
            if header_end < content.byte_len() {
                header_end = header_end + 1
            }
            let mut end = header_end
            while end < content.byte_len() {
                if content.byte_at(end) == 91 {
                    if end == 0 || content.byte_at(end - 1) == 10 {
                        return end
                    }
                }
                end = end + 1
            }
            return content.byte_len()
        }
        i = i + 1
    }
    -1
}

fn has_section(content: Str, section: Str) -> Int {
    let header = "[".concat(section).concat("]")
    let mut i = 0
    while i < content.byte_len() - header.byte_len() + 1 {
        let mut found_match = 1
        let mut j = 0
        while j < header.byte_len() {
            if i + j >= content.byte_len() || content.byte_at(i + j) != header.byte_at(j) {
                found_match = 0
                j = header.byte_len()
            }
            j = j + 1
        }
        if found_match == 1 {
            if i == 0 || content.byte_at(i - 1) == 10 {
                return 1
            }
        }
        i = i + 1
    }
    0
}

fn format_dep_value(dep_path_flag: Str, git_url_flag: Str, git_tag_flag: Str) -> Str {
    if dep_path_flag != "" {
        return "\{ path = \"".concat(dep_path_flag).concat("\" \}")
    }
    if git_url_flag != "" {
        if git_tag_flag != "" {
            return "\{ git = \"".concat(git_url_flag).concat("\", tag = \"").concat(git_tag_flag).concat("\" \}")
        }
        return "\{ git = \"".concat(git_url_flag).concat("\" \}")
    }
    ""
}

fn insert_dep_line(content: Str, section: Str, dep_name: Str, dep_value: Str) -> Str {
    let line = dep_name.concat(" = ").concat(dep_value).concat("\n")
    if has_section(content, section) == 1 {
        let end = find_section_end(content, section)
        let before = content.byte_slice(0, end)
        let after = content.byte_slice(end, content.byte_len())
        return before.concat(line).concat(after)
    }
    content.concat("\n[").concat(section).concat("]\n").concat(line)
}

fn remove_dep_line(content: Str, dep_name: Str) -> Str {
    let mut sb = StringBuilder.new()
    let mut i = 0
    let mut line_start = 0
    while i <= content.byte_len() {
        if i == content.byte_len() || content.byte_at(i) == 10 {
            let line_len = i - line_start
            let line = content.byte_slice(line_start, line_start + line_len)
            let mut skip = 0
            if line.starts_with(dep_name) {
                let after_name_pos = dep_name.byte_len()
                if after_name_pos < line.byte_len() {
                    let ch = line.byte_at(after_name_pos)
                    if ch == 61 || ch == 32 {
                        skip = 1
                    }
                }
            }
            if skip == 0 {
                sb.write(line)
                if i < content.byte_len() {
                    sb.write("\n")
                }
            }
            line_start = i + 1
        }
        i = i + 1
    }
    sb.to_str()
}

fn ffi_collect_ptr_params(fn_node: Int) -> Str {
    let params_sl = node_params(fn_node)
    if params_sl == -1 {
        return ""
    }
    let mut result = ""
    let mut i = 0
    while i < sublist_length(params_sl) {
        let p = sublist_get(params_sl, i)
        let ptype = node_type_name(p)
        if ptype == "Ptr" {
            if result != "" {
                result = result.concat(",")
            }
            let pname = node_name(p)
            let mut full_type = "Ptr"
            let pta = node_type_ann(p)
            if pta != -1 {
                let pelems_sl = node_elements(pta)
                if pelems_sl != -1 && sublist_length(pelems_sl) > 0 {
                    let inner = node_name(sublist_get(pelems_sl, 0))
                    full_type = "Ptr[{inner}]"
                }
            }
            result = result.concat("{pname}:{full_type}")
        }
        i = i + 1
    }
    result
}

fn ffi_ptr_return(fn_node: Int) -> Str {
    let ret = node_return_type(fn_node)
    if ret == "Ptr" {
        let ret_ann = node_type_ann(fn_node)
        if ret_ann != -1 {
            let relems_sl = node_elements(ret_ann)
            if relems_sl != -1 && sublist_length(relems_sl) > 0 {
                let inner = node_name(sublist_get(relems_sl, 0))
                return "Ptr[{inner}]"
            }
        }
        return "Ptr"
    }
    ""
}

// Collect the names of every top-level @ffi.opaque handle type in the program.
// The audit runs after parse+merge only (compile_to_program stops before
// typecheck), so the typecheck/codegen opaque registries are empty here; the
// opaque set is rebuilt straight from the type-decl AST, keyed on the same
// `ffi.opaque` annotation typecheck uses to populate ffi_opaque_type_set.
fn collect_opaque_type_names(program: Int) -> Map[Str, Int] {
    let mut set: Map[Str, Int] = Map()
    let types_sl = node_fields(program)
    if types_sl == -1 {
        return set
    }
    let mut i = 0
    while i < sublist_length(types_sl) {
        let td = sublist_get(types_sl, i)
        if get_annotation(td, "ffi.opaque") != -1 {
            set.insert(node_name(td), 1)
        }
        i = i + 1
    }
    set
}

// The module-qualifier-stripped inner type name carried by a single-arg wrapper
// type node — the `T` of a `Ptr[T]` or `Option[T]` — or "" when the node carries
// no wrapped element. Works on a param node and on a fn node (whose type
// annotation is its return type), so a wrapped opaque is detected against the
// bare-keyed opaque set in either slot.
fn opaque_wrapper_inner(p: Int) -> Str {
    let pta = node_type_ann(p)
    if pta == -1 {
        return ""
    }
    let pelems_sl = node_elements(pta)
    if pelems_sl == -1 || sublist_length(pelems_sl) == 0 {
        return ""
    }
    strip_module_qualifier(node_name(sublist_get(pelems_sl, 0)))
}

fn ffi_extract_trusted_info(fn_node: Int) -> Str {
    let ann = get_annotation(fn_node, "trusted")
    if ann == -1 {
        return ""
    }
    let args_sl = node_args(ann)
    if args_sl == -1 {
        return "true"
    }
    let count = sublist_length(args_sl)
    if count == 0 {
        return "true"
    }
    let mut result = ""
    let mut i = 0
    while i < count {
        let arg = sublist_get(args_sl, i)
        let arg_name = node_name(arg)
        if i > 0 {
            result = result.concat(",")
        }
        let str_val = ann_str_val(arg)
        if arg_name != str_val && arg_name != "" {
            result = result.concat(arg_name).concat(":").concat(str_val)
        } else {
            result = result.concat(str_val)
        }
        i = i + 1
    }
    result
}

// One opaque-ffi-handle boundary crossing. `site` says where it was found: a
// "signature" crossing is an @ffi slot that produces (opaque return / Ptr
// out-cell) or consumes (opaque param) a handle; a "mint" crossing is a body
// `Ptr[opaque].deref()` that materialises a handle inside an FFI region
// (sections/07_trust_modules_metadata.md:211, :895-935). Held as a record so
// the accumulate and both emit loops share one field order instead of parallel
// index-locked lists.
type OpaqueCrossing {
    fname: Str
    line: Int
    file: Str
    param: Str
    handle: Str
    direction: Str
    site: Str
}

// The output sink for one body walk. Bundling both audits' accumulators plus the
// opaque-type lookup into one record lets a single descent (walk_ffi_audit) serve
// both the bytes-bridge byte-pin audit and the opaque-handle mint audit, so a new
// AST node kind is handled in one place instead of drifting between two near-
// identical walkers. The List/Map fields are references, so the walk accumulates
// by mutating them in place and the caller reads the same objects back.
type FfiAuditSink {
    bp_lines: List[Int]
    bp_files: List[Str]
    oc: List[OpaqueCrossing]
    opaque_set: Map[Str, Int]
}

// A function body is an FFI region when it carries @ffi or @trusted
// (sections/07_trust_modules_metadata.md:211, region forms 1 and 2). The third
// form — a `with ffi.scope() as _ { }` block — is a within-body sub-region the
// walker detects via ffi_scope_resource_name, shared with escape.bl's E0601 pass
// so the two cannot drift. This body-region predicate is intentionally broader
// than E0811's signature gate (validate_ffi_fn, @ffi-only), which is left
// unchanged: E0811 governs where a Ptr[T] may sit in a signature; this governs
// where a body deref mints a handle.
fn fn_is_ffi_region(fn_node: Int) -> Int {
    if get_annotation(fn_node, "ffi") != -1 { return 1 }
    if get_annotation(fn_node, "trusted") != -1 { return 1 }
    0
}

// The pointer-minting intrinsics this audit recognises, keyed by call SHAPE so
// the caller matches the right callee base: 1 = bare free-fn form (alloc_ptr[T](),
// null_ptr[T]()); 2 = ffi.scope method form (scope.alloc[T](), scope.alloc_n[T](n));
// 0 = not a pointer mint. One spelling so the two base checks below stay in step.
// `cstr` is excluded on purpose: it mints a Ptr[U8] cstring, not an opaque handle
// — escape.bl tracks that separately for scope-free.
fn ptr_mint_intrinsic_kind(name: Str) -> Int {
    if name == "alloc_ptr" { return 1 }
    if name == "null_ptr" { return 1 }
    if name == "alloc" { return 2 }
    if name == "alloc_n" { return 2 }
    0
}

// The opaque pointee produced by a pointer-minting intrinsic call
// (`scope.alloc[T]()`, `scope.alloc_n[T](n)`, `alloc_ptr[T]()`, `null_ptr[T]()`),
// or "" for any other call. The pointee `T` is the call's first type argument.
fn intrinsic_ptr_opaque_pointee(call: Int, opaque_set: Map[Str, Int]) -> Str {
    let targs = node_type_params(call)
    if targs == -1 || sublist_length(targs) == 0 { return "" }
    let mut ok = 0
    if node_kind(call) == NodeKind.Call {
        let callee = node_left(call)
        if callee != -1 && node_kind(callee) == NodeKind.Ident {
            if ptr_mint_intrinsic_kind(node_name(callee)) == 1 { ok = 1 }
        }
    }
    if node_kind(call) == NodeKind.MethodCall {
        if ptr_mint_intrinsic_kind(node_method(call)) == 2 { ok = 1 }
    }
    if ok == 0 { return "" }
    let inner = strip_module_qualifier(node_name(sublist_get(targs, 0)))
    if opaque_set.contains_key(inner) != 0 { return inner }
    ""
}

// The opaque pointee an expression carries when it has Ptr[opaque] type,
// recovered purely syntactically pre-typecheck: a bound var in `ptr_env`, or a
// direct pointer-producing intrinsic call. "" when the expression is not a
// Ptr[opaque]. A `.deref()` on such an expression inside a region is a mint.
fn ptr_opaque_pointee(expr: Int, ptr_env: Map[Str, Str], opaque_set: Map[Str, Int]) -> Str {
    if expr == -1 { return "" }
    let k = node_kind(expr)
    if k == NodeKind.Ident {
        let nm = node_name(expr)
        if ptr_env.contains_key(nm) != 0 { return ptr_env.get(nm).unwrap() }
        return ""
    }
    if k == NodeKind.Call || k == NodeKind.MethodCall {
        return intrinsic_ptr_opaque_pointee(expr, opaque_set)
    }
    ""
}

// A shallow copy of a binder env, so a nested lexical scope can grow its own
// bindings without leaking them back to the parent or across sibling blocks.
fn copy_str_env(src: Map[Str, Str]) -> Map[Str, Str] {
    let mut out: Map[Str, Str] = Map()
    let ks = src.keys()
    let mut i = 0
    while i < ks.len() {
        let k = ks.get(i).unwrap()
        out.insert(k, src.get(k).unwrap())
        i = i + 1
    }
    out
}

// Seed each Ptr[opaque] param name into the binder env. Shared by the fn-level
// scan and the closure arm, which both bring params into scope for the body.
fn seed_ptr_opaque_params(params_sl: Int, ptr_env: Map[Str, Str], opaque_set: Map[Str, Int]) {
    if params_sl == -1 { return }
    let mut pi = 0
    while pi < sublist_length(params_sl) {
        let pp = sublist_get(params_sl, pi)
        let pt = strip_module_qualifier(node_type_name(pp))
        if pt == "Ptr" {
            let inner = opaque_wrapper_inner(pp)
            if inner != "" && opaque_set.contains_key(inner) != 0 {
                ptr_env.insert(node_name(pp), inner)
            }
        }
        pi = pi + 1
    }
}

// Walk one top-level fn or impl method for the FFI audit: decide the fn-level
// region (@ffi / @trusted), seed a fresh Ptr[opaque] binder env from the params,
// and descend the body. Test blocks and top-level lets have no fn-level region,
// so the driver walks those directly with in_region 0.
fn scan_fn_ffi_audit(fn_node: Int, w: FfiAuditSink) {
    if fn_node == -1 { return }
    let region = fn_is_ffi_region(fn_node)
    let mut ptr_env: Map[Str, Str] = Map()
    seed_ptr_opaque_params(node_params(fn_node), ptr_env, w.opaque_set)
    walk_ffi_audit(node_body(fn_node), diag_file_for_node(fn_node), region, node_name(fn_node), ptr_env, w)
}

// The single shared descent for both FFI body audits. At every MethodCall it
// records two independent things: a `Bytes.with_ptr` call is a byte-pin site
// (spec §9.1.3.3, region-independent), and a `Ptr[opaque].deref()` inside an FFI
// region is an opaque-handle MINT (spec §9.1.4, :211). It threads `in_region`
// (1 inside an @ffi/@trusted fn or an ffi.scope block), `fn_name` (attributed to
// each mint), and `ptr_env` (binder name -> opaque pointee, grown from params and
// pointer-producing lets); the byte-pin side ignores all three. A closure literal
// inherits the region (R-PROP-CLOSURE) after its own Ptr[opaque] params are
// seeded. A handler method is the witness for R-NO-PROP-FNITEM (a named nested
// `fn` does not inherit): its body is walked with region 0 and a fresh env. Each
// block copies the binder env so a binding never leaks to a sibling. A plain Call routes
// through node_left (the callee); node_obj is the MethodCall receiver, not a
// Call's callee, so descending it would miss a call sitting in callee position.
fn walk_ffi_audit(node: Int, file: Str, in_region: Int, fn_name: Str, ptr_env: Map[Str, Str], w: FfiAuditSink) {
    if node == -1 { return }
    let kind = node_kind(node)

    if kind == NodeKind.MethodCall {
        let m = node_method(node)
        if m == "with_ptr" {
            w.bp_lines.push(node_line(node))
            w.bp_files.push(file)
        }
        if in_region != 0 && m == "deref" {
            let pointee = ptr_opaque_pointee(node_obj(node), ptr_env, w.opaque_set)
            if pointee != "" {
                w.oc.push(OpaqueCrossing {
                    fname: fn_name,
                    line: node_line(node),
                    file: file,
                    param: "",
                    handle: pointee,
                    direction: "produce",
                    site: "mint"
                })
            }
        }
        let mc_obj = node_obj(node)
        if mc_obj != -1 { walk_ffi_audit(mc_obj, file, in_region, fn_name, ptr_env, w) }
        let args_sl = node_args(node)
        if args_sl != -1 {
            let mut i = 0
            while i < sublist_length(args_sl) {
                walk_ffi_audit(sublist_get(args_sl, i), file, in_region, fn_name, ptr_env, w)
                i = i + 1
            }
        }
        return
    }

    if kind == NodeKind.Call {
        let cleft = node_left(node)
        if cleft != -1 { walk_ffi_audit(cleft, file, in_region, fn_name, ptr_env, w) }
        let args_sl = node_args(node)
        if args_sl != -1 {
            let mut i = 0
            while i < sublist_length(args_sl) {
                walk_ffi_audit(sublist_get(args_sl, i), file, in_region, fn_name, ptr_env, w)
                i = i + 1
            }
        }
        return
    }

    if kind == NodeKind.Block {
        // A block is a lexical scope: bindings made here are visible to later
        // statements in the same block but must not escape to a sibling block
        // (an if then-branch must not leak a binding into the else-branch).
        let benv = copy_str_env(ptr_env)
        let stmts_sl = node_stmts(node)
        if stmts_sl != -1 {
            let mut i = 0
            while i < sublist_length(stmts_sl) {
                walk_ffi_audit(sublist_get(stmts_sl, i), file, in_region, fn_name, benv, w)
                i = i + 1
            }
        }
        return
    }

    if kind == NodeKind.LetBinding {
        let v = node_value(node)
        let mut inner = ""
        let ta = node_target(node)
        if ta != -1 {
            let head = strip_module_qualifier(node_name(ta))
            if head == "Ptr" {
                let pelems_sl = node_elements(ta)
                if pelems_sl != -1 && sublist_length(pelems_sl) > 0 {
                    inner = strip_module_qualifier(node_name(sublist_get(pelems_sl, 0)))
                }
            }
        }
        if inner == "" && v != -1 {
            inner = ptr_opaque_pointee(v, ptr_env, w.opaque_set)
        }
        if inner != "" && w.opaque_set.contains_key(inner) != 0 {
            ptr_env.insert(node_name(node), inner)
        }
        walk_ffi_audit(v, file, in_region, fn_name, ptr_env, w)
        return
    }

    if kind == NodeKind.ExprStmt {
        walk_ffi_audit(node_value(node), file, in_region, fn_name, ptr_env, w)
        return
    }

    if kind == NodeKind.Assignment || kind == NodeKind.CompoundAssign {
        walk_ffi_audit(node_target(node), file, in_region, fn_name, ptr_env, w)
        walk_ffi_audit(node_value(node), file, in_region, fn_name, ptr_env, w)
        return
    }

    if kind == NodeKind.Return {
        walk_ffi_audit(node_value(node), file, in_region, fn_name, ptr_env, w)
        return
    }

    if kind == NodeKind.IfExpr {
        walk_ffi_audit(node_condition(node), file, in_region, fn_name, ptr_env, w)
        walk_ffi_audit(node_then_body(node), file, in_region, fn_name, ptr_env, w)
        walk_ffi_audit(node_else_body(node), file, in_region, fn_name, ptr_env, w)
        return
    }

    if kind == NodeKind.MatchExpr {
        walk_ffi_audit(node_scrutinee(node), file, in_region, fn_name, ptr_env, w)
        let arms_sl = node_arms(node)
        if arms_sl != -1 {
            let mut i = 0
            while i < sublist_length(arms_sl) {
                let arm = sublist_get(arms_sl, i)
                walk_ffi_audit(node_guard(arm), file, in_region, fn_name, ptr_env, w)
                walk_ffi_audit(node_body(arm), file, in_region, fn_name, ptr_env, w)
                i = i + 1
            }
        }
        return
    }

    if kind == NodeKind.WhileLoop {
        walk_ffi_audit(node_condition(node), file, in_region, fn_name, ptr_env, w)
        walk_ffi_audit(node_body(node), file, in_region, fn_name, ptr_env, w)
        return
    }

    if kind == NodeKind.LoopExpr || kind == NodeKind.AsyncScope || kind == NodeKind.AssertPanics {
        walk_ffi_audit(node_body(node), file, in_region, fn_name, ptr_env, w)
        return
    }

    if kind == NodeKind.ForIn {
        walk_ffi_audit(node_iterable(node), file, in_region, fn_name, ptr_env, w)
        walk_ffi_audit(node_body(node), file, in_region, fn_name, ptr_env, w)
        return
    }

    if kind == NodeKind.AwaitExpr {
        walk_ffi_audit(node_obj(node), file, in_region, fn_name, ptr_env, w)
        return
    }

    if kind == NodeKind.NamedArg || kind == NodeKind.SpreadExpr {
        walk_ffi_audit(node_value(node), file, in_region, fn_name, ptr_env, w)
        return
    }

    if kind == NodeKind.RangeLit {
        walk_ffi_audit(node_start(node), file, in_region, fn_name, ptr_env, w)
        walk_ffi_audit(node_end(node), file, in_region, fn_name, ptr_env, w)
        return
    }

    if kind == NodeKind.WithBlock {
        let mut region = in_region
        let handlers_sl = node_handlers(node)
        if handlers_sl != -1 {
            let mut i = 0
            while i < sublist_length(handlers_sl) {
                let h = sublist_get(handlers_sl, i)
                walk_ffi_audit(h, file, in_region, fn_name, ptr_env, w)
                if ffi_scope_resource_name(h) != "" { region = 1 }
                i = i + 1
            }
        }
        walk_ffi_audit(node_body(node), file, region, fn_name, ptr_env, w)
        return
    }

    if kind == NodeKind.WithResource {
        walk_ffi_audit(node_value(node), file, in_region, fn_name, ptr_env, w)
        return
    }

    if kind == NodeKind.BinOp {
        walk_ffi_audit(node_left(node), file, in_region, fn_name, ptr_env, w)
        walk_ffi_audit(node_right(node), file, in_region, fn_name, ptr_env, w)
        return
    }

    if kind == NodeKind.UnaryOp {
        walk_ffi_audit(node_value(node), file, in_region, fn_name, ptr_env, w)
        return
    }

    if kind == NodeKind.FieldAccess || kind == NodeKind.IndexExpr {
        walk_ffi_audit(node_obj(node), file, in_region, fn_name, ptr_env, w)
        walk_ffi_audit(node_index(node), file, in_region, fn_name, ptr_env, w)
        return
    }

    if kind == NodeKind.TupleLit || kind == NodeKind.ListLit || kind == NodeKind.InterpString {
        let elems_sl = node_elements(node)
        if elems_sl != -1 {
            let mut i = 0
            while i < sublist_length(elems_sl) {
                walk_ffi_audit(sublist_get(elems_sl, i), file, in_region, fn_name, ptr_env, w)
                i = i + 1
            }
        }
        return
    }

    if kind == NodeKind.StructLit {
        let fields_sl = node_fields(node)
        if fields_sl != -1 {
            let mut i = 0
            while i < sublist_length(fields_sl) {
                walk_ffi_audit(node_value(sublist_get(fields_sl, i)), file, in_region, fn_name, ptr_env, w)
                i = i + 1
            }
        }
        return
    }

    if kind == NodeKind.Closure {
        let cenv = copy_str_env(ptr_env)
        seed_ptr_opaque_params(node_params(node), cenv, w.opaque_set)
        walk_ffi_audit(node_body(node), file, in_region, fn_name, cenv, w)
        return
    }

    if kind == NodeKind.HandlerExpr {
        // A handler method is a named `fn` item, so by R-NO-PROP-FNITEM it does
        // NOT inherit the enclosing FFI region: its body is walked with region 0
        // and a fresh env seeded only from its own params. Byte-pins are still
        // found (they are region-independent); a mint is tagged only if the
        // method body opens its own region.
        let methods_sl = node_methods(node)
        if methods_sl != -1 {
            let mut i = 0
            while i < sublist_length(methods_sl) {
                let mth = sublist_get(methods_sl, i)
                let mut menv: Map[Str, Str] = Map()
                seed_ptr_opaque_params(node_params(mth), menv, w.opaque_set)
                walk_ffi_audit(node_body(mth), file, 0, node_name(mth), menv, w)
                i = i + 1
            }
        }
        return
    }

    if kind == NodeKind.ChannelNew {
        // `channel.new[T](buffer: arg)` is its own node, not a Call; its argument is an
        // ordinary sub-expression evaluated in the enclosing region.
        let args_sl = node_args(node)
        if args_sl != -1 {
            let mut i = 0
            while i < sublist_length(args_sl) {
                walk_ffi_audit(sublist_get(args_sl, i), file, in_region, fn_name, ptr_env, w)
                i = i + 1
            }
        }
        return
    }
}

fn do_ffi_audit(program: Int, json_output: Int) {
    let fns_sl = node_params(program)
    if fns_sl == -1 {
        if json_output != 0 {
            io.println("\{\"ffi_functions\":[],\"bytes_bridge\":\{\"byte-pin\":[]},\"summary\":\{\"total\":0,\"audited\":0,\"unaudited\":0,\"ptr_params\":0,\"ptr_returns\":0,\"byte_pin\":0,\"opaque_handle\":0}}")
        } else {
            io.println("No FFI functions found.")
        }
        return
    }

    let mut names: List[Str] = []
    let mut libs: List[Str] = []
    let mut symbols: List[Str] = []
    let mut trusted_infos: List[Str] = []
    let mut effects_list: List[Str] = []
    let mut ptr_params_list: List[Str] = []
    let mut ptr_returns: List[Str] = []
    let mut lines: List[Int] = []
    let mut files: List[Str] = []
    let mut audited = 0
    let mut ptr_param_count = 0
    let mut ptr_ret_count = 0

    // opaque-ffi-handle crossings (spec §9.1.4): one entry per @ffi signature slot
    // that produces (opaque return) or consumes (opaque param) a handle.
    let opaque_set = collect_opaque_type_names(program)
    let mut oc: List[OpaqueCrossing] = []

    // @ffi DISCOVERY is intentionally top-level-only: validate_ffi_fn (typecheck)
    // and codegen lower @ffi over top-level fns alone — no path lowers @ffi on an
    // impl method — so widening discovery here would report fns that never
    // typecheck. Only byte-pin COLLECTION is widened (below) to all body scopes.
    let mut i = 0
    while i < sublist_length(fns_sl) {
        let fn_node = sublist_get(fns_sl, i)
        let ffi_ann = get_annotation(fn_node, "ffi")
        if ffi_ann != -1 {
            let fn_name = node_name(fn_node)
            let fn_line = node_line(fn_node)
            let fn_file = diag_file_for_node(fn_node)
            names.push(fn_name)
            lines.push(fn_line)
            files.push(fn_file)

            let ffi_args_sl = node_args(ffi_ann)
            let mut lib = ""
            let mut sym = fn_name
            if ffi_args_sl != -1 {
                let arg_count = positional_str_arg_count(ffi_args_sl)
                if arg_count >= 2 {
                    lib = positional_str_arg(ffi_args_sl, 0)
                    sym = positional_str_arg(ffi_args_sl, 1)
                } else if arg_count == 1 {
                    sym = positional_str_arg(ffi_args_sl, 0)
                }
            }
            libs.push(lib)
            symbols.push(sym)

            let trusted = ffi_extract_trusted_info(fn_node)
            trusted_infos.push(trusted)
            if trusted != "" {
                audited = audited + 1
            }

            effects_list.push(collect_effects(fn_node))

            let ptrs = ffi_collect_ptr_params(fn_node)
            ptr_params_list.push(ptrs)
            if ptrs != "" {
                ptr_param_count = ptr_param_count + 1
            }

            let ptr_ret = ffi_ptr_return(fn_node)
            ptr_returns.push(ptr_ret)
            if ptr_ret != "" {
                ptr_ret_count = ptr_ret_count + 1
            }

            // Opaque lookups strip the module qualifier because this map is
            // built from the AST under bare declared names; a cross-module
            // reference arrives qualified as `mod.Handle`.
            let oret = strip_module_qualifier(node_return_type(fn_node))
            if opaque_set.contains_key(oret) != 0 {
                oc.push(OpaqueCrossing {
                    fname: fn_name,
                    line: fn_line,
                    file: fn_file,
                    param: "",
                    handle: oret,
                    direction: "produce",
                    site: "signature"
                })
            } else if oret == "Option" {
                // Option[opaque] return: an @ffi return is a produce mechanism and
                // a nullable handle is the sole absence channel
                // (sections/07_trust_modules_metadata.md:895, :911) — produce, same
                // direction as a bare opaque return.
                let rinner = opaque_wrapper_inner(fn_node)
                if rinner != "" && opaque_set.contains_key(rinner) != 0 {
                    oc.push(OpaqueCrossing {
                        fname: fn_name,
                        line: fn_line,
                        file: fn_file,
                        param: "",
                        handle: rinner,
                        direction: "produce",
                        site: "signature"
                    })
                }
            }
            let oparams_sl = node_params(fn_node)
            if oparams_sl != -1 {
                let mut pj = 0
                while pj < sublist_length(oparams_sl) {
                    let pp = sublist_get(oparams_sl, pj)
                    let pt = strip_module_qualifier(node_type_name(pp))
                    if opaque_set.contains_key(pt) != 0 {
                        oc.push(OpaqueCrossing {
                            fname: fn_name,
                            line: fn_line,
                            file: fn_file,
                            param: node_name(pp),
                            handle: pt,
                            direction: "consume",
                            site: "signature"
                        })
                    } else if pt == "Ptr" {
                        // A Ptr[opaque] out-cell (`sqlite3**`) mints a handle at
                        // the boundary — read back via out.deref() — so it is a
                        // PRODUCE crossing carrying the out-cell param name
                        // (sections/07_trust_modules_metadata.md:904, :916).
                        let inner = opaque_wrapper_inner(pp)
                        if inner != "" && opaque_set.contains_key(inner) != 0 {
                            oc.push(OpaqueCrossing {
                                fname: fn_name,
                                line: fn_line,
                                file: fn_file,
                                param: node_name(pp),
                                handle: inner,
                                direction: "produce",
                                site: "signature"
                            })
                        }
                    } else if pt == "Option" {
                        // Option[opaque] param: a nullable handle handed to C
                        // (sections/07_trust_modules_metadata.md:895) — consume,
                        // same direction as a bare opaque param, carrying the name.
                        let oinner = opaque_wrapper_inner(pp)
                        if oinner != "" && opaque_set.contains_key(oinner) != 0 {
                            oc.push(OpaqueCrossing {
                                fname: fn_name,
                                line: fn_line,
                                file: fn_file,
                                param: node_name(pp),
                                handle: oinner,
                                direction: "consume",
                                site: "signature"
                            })
                        }
                    }
                    pj = pj + 1
                }
            }
        }
        i = i + 1
    }

    let total = names.len()
    let unaudited = total - audited

    // FFI body audits: one shared descent (walk_ffi_audit) over every body the
    // Program node holds records both the bytes-bridge byte-pin sites (spec
    // §9.1.3.3, any Bytes.with_ptr call, region-independent) and the opaque-handle
    // MINT sites (spec §9.1.4, a Ptr[opaque].deref() inside an FFI region). A pin
    // or mint can live in any body — a top-level fn, an impl method, a test block,
    // or a top-level let initializer — so all four Program sublists are walked.
    // Top-level fns and impl methods enter through scan_fn_ffi_audit, which decides
    // the fn-level region (@ffi / @trusted) and seeds the Ptr[opaque] binder env
    // from params; test blocks and top-level lets have no fn-level region, so they
    // start outside one (in_region 0) and a mint is tagged only under an inner
    // ffi.scope block. Each site's file is resolved per-node via diag_file_for_node
    // so multi-file programs attribute it to its own source file. Round-trips (a
    // handle handed back to a raw pointer) are NOT yet tagged — deferred by
    // decision opaque-handle-mint-boundary.md. (bridge-call /
    // buf-mention byte-pin subcategories are not yet implemented; the JSON object
    // is keyed by subcategory so they can slot in additively.)
    let mut byte_pin_lines: List[Int] = []
    let mut byte_pin_files: List[Str] = []
    let w = FfiAuditSink {
        bp_lines: byte_pin_lines,
        bp_files: byte_pin_files,
        oc: oc,
        opaque_set: opaque_set
    }

    let impls_sl = node_methods(program)
    let tests_sl = node_captures(program)
    let lets_sl = node_stmts(program)

    // top-level fn bodies
    let mut bp = 0
    while bp < sublist_length(fns_sl) {
        scan_fn_ffi_audit(sublist_get(fns_sl, bp), w)
        bp = bp + 1
    }

    // impl-method bodies (node_methods(program) -> each impl's node_methods)
    if impls_sl != -1 {
        let mut ii = 0
        while ii < sublist_length(impls_sl) {
            let im = sublist_get(impls_sl, ii)
            let methods_sl = node_methods(im)
            if methods_sl != -1 {
                let mut mi = 0
                while mi < sublist_length(methods_sl) {
                    scan_fn_ffi_audit(sublist_get(methods_sl, mi), w)
                    mi = mi + 1
                }
            }
            ii = ii + 1
        }
    }

    // test-block bodies (node_captures): no fn-level region
    if tests_sl != -1 {
        let mut ti = 0
        while ti < sublist_length(tests_sl) {
            let tb = sublist_get(tests_sl, ti)
            let tbody = node_body(tb)
            if tbody != -1 {
                let mut tenv: Map[Str, Str] = Map()
                walk_ffi_audit(tbody, diag_file_for_node(tb), 0, node_name(tb), tenv, w)
            }
            ti = ti + 1
        }
    }

    // top-level let nodes directly (node_stmts; the walker handles LetBinding)
    if lets_sl != -1 {
        let mut li = 0
        while li < sublist_length(lets_sl) {
            let ln = sublist_get(lets_sl, li)
            if ln != -1 {
                let mut lenv: Map[Str, Str] = Map()
                walk_ffi_audit(ln, diag_file_for_node(ln), 0, "", lenv, w)
            }
            li = li + 1
        }
    }

    if json_output != 0 {
        let mut out = "\{\"ffi_functions\":["
        let mut k = 0
        while k < total {
            if k > 0 {
                out = out.concat(",")
            }
            let n = names.get(k).unwrap()
            let lib = libs.get(k).unwrap()
            let sym = symbols.get(k).unwrap()
            let trusted = trusted_infos.get(k).unwrap()
            let effs = effects_list.get(k).unwrap()
            let ptrs = ptr_params_list.get(k).unwrap()
            let ptr_ret = ptr_returns.get(k).unwrap()
            let line = lines.get(k).unwrap()
            let file = files.get(k).unwrap()
            let trusted_json = if trusted != "" { "true" } else { "false" }
            out = out.concat("\{\"name\":\"{n}\",\"lib\":\"{lib}\",\"symbol\":\"{sym}\",\"trusted\":{trusted_json}")
            if trusted != "" && trusted != "true" {
                out = out.concat(",\"audit\":\"{trusted}\"")
            }
            out = out.concat(",\"effects\":\"{effs}\"")
            if ptrs != "" {
                out = out.concat(",\"ptr_params\":\"{ptrs}\"")
            }
            if ptr_ret != "" {
                out = out.concat(",\"ptr_return\":\"{ptr_ret}\"")
            }
            out = out.concat(",\"file\":\"{file}\",\"line\":{line}}")
            k = k + 1
        }
        out = out.concat("],\"bytes_bridge\":\{\"byte-pin\":[")
        let mut bpj = 0
        while bpj < byte_pin_lines.len() {
            if bpj > 0 {
                out = out.concat(",")
            }
            let bline = byte_pin_lines.get(bpj).unwrap()
            let bfile = byte_pin_files.get(bpj).unwrap()
            out = out.concat("\{\"file\":\"{bfile}\",\"line\":{bline}}")
            bpj = bpj + 1
        }
        out = out.concat("]},\"opaque_ffi_handle\":\{\"crossing\":[")
        let mut ocj = 0
        while ocj < oc.len() {
            if ocj > 0 {
                out = out.concat(",")
            }
            let occ = oc.get(ocj).unwrap()
            out = out.concat("\{\"file\":\"{occ.file}\",\"line\":{occ.line},\"fn\":\"{occ.fname}\"")
            if occ.param != "" {
                out = out.concat(",\"param\":\"{occ.param}\"")
            }
            out = out.concat(",\"handle\":\"{occ.handle}\",\"direction\":\"{occ.direction}\",\"site\":\"{occ.site}\"}")
            ocj = ocj + 1
        }
        out = out.concat("]},\"summary\":\{\"total\":{total},\"audited\":{audited},\"unaudited\":{unaudited},\"ptr_params\":{ptr_param_count},\"ptr_returns\":{ptr_ret_count},\"byte_pin\":{byte_pin_lines.len()},\"opaque_handle\":{oc.len()}}}")
        io.println(out)
    } else {
        if total == 0 {
            io.println("No FFI functions found.")
            return
        }
        io.println("FFI Audit Report")
        io.println("================")
        io.println("")
        let mut k = 0
        while k < total {
            let n = names.get(k).unwrap()
            let lib = libs.get(k).unwrap()
            let sym = symbols.get(k).unwrap()
            let trusted = trusted_infos.get(k).unwrap()
            let effs = effects_list.get(k).unwrap()
            let ptrs = ptr_params_list.get(k).unwrap()
            let ptr_ret = ptr_returns.get(k).unwrap()
            let line = lines.get(k).unwrap()
            let file = files.get(k).unwrap()
            let status = if trusted != "" { "AUDITED" } else { "UNAUDITED" }
            io.println("  {n} [{status}]")
            io.println("    lib: {lib}  symbol: {sym}")
            io.println("    effects: {effs}  file: {file}:{line}")
            if trusted != "" && trusted != "true" {
                io.println("    audit: {trusted}")
            }
            if ptrs != "" {
                io.println("    ptr params: {ptrs}")
            }
            if ptr_ret != "" {
                io.println("    ptr return: {ptr_ret}")
            }
            io.println("")
            k = k + 1
        }
        io.println("Summary: {total} FFI function(s), {audited} audited, {unaudited} unaudited")
        if ptr_param_count > 0 || ptr_ret_count > 0 {
            io.println("Pointers: {ptr_param_count} with ptr params, {ptr_ret_count} with ptr returns")
        }
        if byte_pin_lines.len() > 0 {
            io.println("")
            io.println("bytes-bridge")
            io.println("============")
            let mut bph = 0
            while bph < byte_pin_lines.len() {
                let bline = byte_pin_lines.get(bph).unwrap()
                let bfile = byte_pin_files.get(bph).unwrap()
                io.println("  byte-pin: {bfile}:{bline}")
                bph = bph + 1
            }
        }
        if oc.len() > 0 {
            io.println("")
            io.println("opaque-ffi-handle")
            io.println("=================")
            let mut och = 0
            while och < oc.len() {
                let occ = oc.get(och).unwrap()
                let slot = if occ.site == "mint" { "mint" } else if occ.param != "" { "param {occ.param}" } else { "return" }
                io.println("  {occ.direction}: {occ.fname} ({slot}: {occ.handle})  {occ.file}:{occ.line}")
                och = och + 1
            }
        }
    }
}

fn cmd_build(p: ArgParser, a: Args) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, Format.Emit, Codegen, IO {
    if build_through_daemon(a, "build") {
        return
    }
    build_here(p, a, None)
}

// The build `blink build` runs in its own process, or in a child of the daemon, which passes
// the build it forked the child for as checked.
fn build_here(p: ArgParser, a: Args, checked: Option[DaemonBuild]) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, Format.Emit, Codegen, IO {
    let source_path = args_positional(a, 0)
    if source_path == "" {
        io.println("error: no source file specified")
        io.println(generate_command_help(p, "build"))
        return
    }
    check_file_exists(source_path)
    apply_cache_flag(a)
    let unit_jobs = unit_jobs_from_args(a)
    let debug_flag = if args_has(a, "debug") { 1 } else { 0 }
    let release_flag = if args_has(a, "release") { 1 } else { 0 }
    let strict_flag = if args_has(a, "strict") { 1 } else { 0 }
    let strict_struct_layout_flag = if args_has(a, "strict-struct-layout") { 1 } else { 0 }
    set_strict_struct_layout(strict_struct_layout_flag)
    let json_output = if args_has(a, "json") { 1 } else { 0 }
    let emit_flag = args_get(a, "emit")
    let targets = args_get_all(a, "target")

    // `--emit per-module-dir <out>` emits a per-module .c/.h set into a
    // directory instead of a single monolith .c or a linked binary. The
    // output target is a DIRECTORY: take it from the second positional
    // (`build <file.bl> <outdir>`) or fall back to `-o`. This is the
    // documented surface for the per-module emit machinery that the hidden
    // `__emit-per-module` subcommand drives. See docs/build/per-module-o-default.md.
    if emit_flag == "per-module-dir" {
        let mut pm_out = args_positional(a, 1)
        if pm_out == "" {
            pm_out = args_get(a, "output")
        }
        if pm_out == "" {
            io.println("error: --emit per-module-dir requires an output directory (build <file.bl> <outdir> or -o <outdir>)")
            io.println(generate_command_help(p, "build"))
            exit(1)
        }
        let mut pm_args: List[Str] = []
        pm_args.push(source_path)
        pm_args.push(pm_out)
        cmd_emit_per_module(pm_args)
        if json_output != 0 {
            io.println("\{\"status\":\"ok\",\"output\":\"{pm_out}\"}")
        } else {
            io.println("emitted per-module: {pm_out}")
        }
        return
    }

    let mut format_flag = args_get(a, "format")
    if json_output != 0 && format_flag == "" {
        format_flag = "json"
    }
    if debug_flag != 0 && release_flag != 0 {
        io.eprintln("error: --debug and --release are mutually exclusive")
        exit(1)
    }
    trace_mode = args_get(a, "blink-trace")
    let build_trace_val = args_get(a, "trace")
    if build_trace_val != "" {
        cli_trace_codegen = 1
    }
    cli_deterministic = if args_has(a, "deterministic") { 1 } else { 0 }
    let basename = path_basename(source_path)
    let name = strip_extension(basename)
    let mut output_path = args_get(a, "output")
    if output_path == "" {
        output_path = "build/{name}"
    }
    let mut out_dir = path_dirname(output_path)
    if out_dir == "" {
        out_dir = "."
    }
    let _ = build_fs.mkdir_p(out_dir)
    let out_base = strip_extension(path_basename(output_path))
    let c_path = "{out_dir}/{out_base}.c"
    ensure_deps_resolved()
    let rc = do_build(source_path, output_path, c_path, format_flag, debug_flag, release_flag, emit_flag, targets, json_output, strict_flag, unit_jobs, args_has(a, "per-module"), checked)
    if rc == 0 {
        if emit_flag == "c" {
            if json_output != 0 {
                io.println("\{\"status\":\"ok\",\"output\":\"{c_path}\"}")
            } else {
                io.println("emitted: {c_path}")
            }
        }
    } else {
        if json_output != 0 {
            io.println("\{\"status\":\"error\"}")
        }
        exit(1)
    }
}

fn cmd_run(p: ArgParser, a: Args) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, Format.Emit, Codegen, IO {
    if build_through_daemon(a, "run") {
        run_built(a, run_output_path(a))
        return
    }
    match run_build_here(p, a, None) {
        Some(output_path) => run_built(a, output_path)
        None => {}
    }
}

// Where `blink run` writes the program it runs.
fn run_output_path(a: Args) -> Str {
    let output_path = args_get(a, "output")
    if output_path != "" {
        return output_path
    }
    "build/{strip_extension(path_basename(args_positional(a, 0)))}"
}

// The build `blink run` runs in its own process, or in a child of the daemon, which passes
// checked as build_here's does: the path of the program it built, or None when it names no
// source.
fn run_build_here(p: ArgParser, a: Args, checked: Option[DaemonBuild]) -> Option[Str] ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, Format.Emit, Codegen, IO {
    let source_path = args_positional(a, 0)
    if source_path == "" {
        io.println("error: no source file specified")
        io.println(generate_command_help(p, "run"))
        return None
    }
    check_file_exists(source_path)
    apply_cache_flag(a)
    let unit_jobs = unit_jobs_from_args(a)
    let debug_flag = if args_has(a, "debug") { 1 } else { 0 }
    let release_flag = if args_has(a, "release") { 1 } else { 0 }
    let strict_flag = if args_has(a, "strict") { 1 } else { 0 }
    let strict_struct_layout_flag = if args_has(a, "strict-struct-layout") { 1 } else { 0 }
    set_strict_struct_layout(strict_struct_layout_flag)
    let targets = args_get_all(a, "target")
    let mut format_flag = args_get(a, "format")
    if debug_flag != 0 && release_flag != 0 {
        io.eprintln("error: --debug and --release are mutually exclusive")
        exit(1)
    }
    if targets.len() > 1 {
        io.eprintln("error: 'run' does not support multiple targets")
        exit(1)
    }
    trace_mode = args_get(a, "blink-trace")
    let output_path = run_output_path(a)
    let mut out_dir = path_dirname(output_path)
    if out_dir == "" {
        out_dir = "."
    }
    let _ = build_fs.mkdir_p(out_dir)
    let out_base = strip_extension(path_basename(output_path))
    let c_path = "{out_dir}/{out_base}.c"
    if run_traces(a) {
        cli_trace_codegen = 1
    }
    cli_deterministic = if args_has(a, "deterministic") { 1 } else { 0 }
    ensure_deps_resolved()
    let rc = do_build(source_path, output_path, c_path, format_flag, debug_flag, release_flag, "", targets, 0, strict_flag, unit_jobs, args_has(a, "per-module"), checked)
    if rc != 0 {
        exit(1)
    }
    Some(output_path)
}

// Whether `blink run` builds its program to trace the calls it makes.
fn run_traces(a: Args) -> Bool {
    args_get(a, "trace") != "" || (env.var("BLINK_TRACE") ?? "") != ""
}

// Runs the program `blink run` built, with the arguments meant for it.
fn run_built(a: Args, output_path: Str) {
    let trace_val = args_get(a, "trace")
    let mut rest = args_rest(a)
    if trace_val != "" {
        if trace_val == "all" {
            rest.push("--trace")
        } else {
            rest.push("--trace={trace_val}")
        }
    }
    let trace_limit_val = args_get(a, "trace-limit")
    if trace_limit_val != "" {
        rest.push("--trace-limit={trace_limit_val}")
    }
    process_exec(output_path, rest)
}

// What one test file's task hands back. A spawned task may not capture a `let mut`
// (E0650), so the tasks send their results and the caller files them by index.
type TestFileResult {
    idx: Int
    built: Bool
    exit_code: Int
    out: Str
    err_out: Str
}

// Where one test file stands after the run. A file starts pending, so a task that never
// handed back a result can not be mistaken for a build that failed.
let TEST_FILE_PENDING = 0
let TEST_FILE_BUILD_FAILED = 1
let TEST_FILE_RAN = 2

fn cmd_test(_p: ArgParser, a: Args) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, Format.Emit, Codegen, IO {
    let source_path = args_positional(a, 0)
    apply_cache_flag(a)
    let json_output = if args_has(a, "json") { 1 } else { 0 }
    let verbose = if args_has(a, "verbose") { 1 } else { 0 }
    let quiet = if args_has(a, "quiet") { 1 } else { 0 }
    let dots = if verbose == 0 && quiet == 0 && json_output == 0 { 1 } else { 0 }
    let esc = str_from_code_point(27)
    let filter_pattern = args_get(a, "filter")
    let tags_filter = args_get(a, "tags")
    let parallel_str = args_get(a, "parallel")
    let mut num_workers = 4
    if parallel_str != "" {
        num_workers = parallel_str.to_int()
    }
    if num_workers < 1 {
        num_workers = 1
    }
    let targets = args_get_all(a, "target")
    let format_flag = args_get(a, "format")
    let unit_jobs = unit_jobs_from_args(a)

    ensure_deps_resolved()
    // A forced rebuild compiles the stdlib in process ahead of the program. It lands in
    // the cwd build/ so it never replaces the archive that concurrent builds link.
    if stdlib_rebuild_forced() && !resolve_archive_dir().ends_with("share/blink") {
        let arc_rc = build_stdlib_archive(peeled_module_keys())
        if arc_rc != 0 {
            io.eprintln("error: failed to build stdlib archive (rc={arc_rc})")
            exit(arc_rc)
        }
    }
    let dev_rc = ensure_dev_archive()
    if dev_rc != 0 {
        exit(dev_rc)
    }
    if source_path != "" {
        check_file_exists(source_path)
    }
    if source_path != "" && is_dir(source_path) == 0 {
        let basename = path_basename(source_path)
        let name = strip_extension(basename)
        shell_exec("mkdir -p build")
        let c_path = "build/{name}.c"
        let output_path = "build/{name}"
        let rc = do_build(source_path, output_path, c_path, format_flag, 1, 0, "", targets, 0, 0, unit_jobs, args_has(a, "per-module"), None)
        if rc != 0 {
            exit(1)
        }
        let mut run_cmd = output_path
        if filter_pattern != "" {
            run_cmd = "{run_cmd} --test-filter \"{filter_pattern}\""
        }
        if json_output != 0 {
            run_cmd = "{run_cmd} --test-json"
        }
        if tags_filter != "" {
            run_cmd = "{run_cmd} --test-tags \"{tags_filter}\""
        }
        let test_rc = shell_exec(run_cmd)
        exit(test_rc)
    }

    let mut test_dir = "."
    if source_path != "" {
        test_dir = source_path
    }
    let mut test_files: List[Str] = []
    collect_test_files(test_dir, test_files)
    let file_count = test_files.len()

    if file_count == 0 {
        if json_output != 0 {
            io.println("\{\"files\":[],\"summary\":\{\"files\":0,\"files_passed\":0,\"files_failed\":0,\"build_errors\":0}}")
        } else {
            io.println("error: no files with test blocks found")
        }
        exit(1)
    }

    // Fail-fast: typecheck in-process before spawning parallel build workers.
    // Without this, broken-but-large fixtures can deadlock async.scope
    // coordination — single-threaded ~25ms/file is cheap insurance.
    if json_output != 0 {
        diag_format = 1
    }
    let mut tc_failed_files = 0
    let mut tci = 0
    while tci < file_count {
        let tcf = test_files.get(tci).unwrap()
        let prog = compile_to_program(tcf, 1)
        check_types(prog)
        check_unused_imports()
        if diag_ice_count > 0 || diag_count > 0 {
            tc_failed_files = tc_failed_files + 1
        }
        tci = tci + 1
    }
    if tc_failed_files > 0 {
        diag_flush()
        if json_output != 0 {
            io.println("\{\"status\":\"error\",\"build_errors\":{tc_failed_files}}")
        } else {
            io.eprintln("error: {tc_failed_files} test file(s) failed to compile")
        }
        exit(1)
    }
    diag_flush()

    let blink_bin = resolve_blink_bin()

    let mut build_args: List[List[Str]] = []
    let mut run_args: List[List[Str]] = []
    let mut output_bins: List[Str] = []
    let mut fi = 0
    while fi < file_count {
        let tf = test_files.get(fi).unwrap()
        let tf_dir = path_dirname(tf)
        let tf_base = strip_extension(path_basename(tf))
        let mut build_dir = "build"
        if tf_dir != "." && tf_dir != "" {
            build_dir = "build/{tf_dir}"
        }
        shell_exec("mkdir -p {build_dir}")
        let tf_out = "{build_dir}/{tf_base}"
        output_bins.push(tf_out)

        let mut ba: List[Str] = ["build", tf, "-o", tf_out, "--debug"]
        // Without --jobs the child reads BLINK_JOBS itself, and without a path flag it reads
        // BLINK_PER_MODULE, from the same environment.
        if args_has(a, "per-module") {
            ba.push("--per-module")
        }
        if args_has(a, "no-per-module") {
            ba.push("--no-per-module")
        }
        let jobs_flag = args_get(a, "jobs")
        if unit_jobs != 0 && jobs_flag != "" {
            ba.push("--jobs")
            ba.push(jobs_flag)
        }
        build_args.push(ba)

        let source = read_file(tf)
        let mut ra: List[Str] = []
        if source.contains("fn main(") {
            ra.push("--test")
        }
        if filter_pattern != "" {
            ra.push("--test-filter")
            ra.push(filter_pattern)
        }
        if json_output != 0 {
            ra.push("--test-json")
        }
        if tags_filter != "" {
            ra.push("--test-tags")
            ra.push(tags_filter)
        }
        run_args.push(ra)
        fi = fi + 1
    }

    let mut states: List[Int] = []
    let mut exit_codes: List[Int] = []
    let mut outputs: List[Str] = []
    let mut errors: List[Str] = []
    let mut pi = 0
    while pi < file_count {
        states.push(TEST_FILE_PENDING)
        exit_codes.push(0)
        outputs.push("")
        errors.push("")
        pi = pi + 1
    }

    let sem = channel.new[Int](buffer: num_workers)
    let mut ti = 0
    while ti < num_workers {
        sem.send(1)
        ti = ti + 1
    }

    let dot_ch = channel.new[Int](buffer: 1)
    dot_ch.send(0)

    // One slot per file, so no task blocks on its send while the scope waits for it.
    let results = channel.new[TestFileResult](buffer: file_count)

    // SIGINT/SIGTERM on cmd_test forwards SIGTERM to every live spawned
    // child (build worker or test binary), preventing the orphan-worker
    // problem.
    process_install_signal_forwarding()

    // Dev knob: BLINK_DEV_TEST_DROP_RESULT=<test file> ends that file's task without its
    // result, so a test can check how the runner reports a result it never got.
    let drop_result = env.var("BLINK_DEV_TEST_DROP_RESULT") ?? ""

    async.scope {
        let mut si = 0
        while si < file_count {
            let idx = si
            let bcmd = build_args.get(si).unwrap()
            let rcmd = run_args.get(si).unwrap()
            let bin_path = output_bins.get(si).unwrap()
            let drop_this = test_files.get(si).unwrap() == drop_result
            async.spawn(fn() {
                sem.recv()
                if drop_this {
                    sem.send(1)
                    return 0
                }
                let bpid = process_spawn(blink_bin, bcmd)
                let br = process_pid_wait(bpid)
                if br.exit_code != 0 || !file_exists(bin_path) {
                    let mut err_text = br.out
                    if br.err_out != "" {
                        if err_text != "" {
                            err_text = "{err_text}\n{br.err_out}"
                        } else {
                            err_text = br.err_out
                        }
                    }
                    results.send(TestFileResult { idx: idx, built: false, exit_code: br.exit_code, out: "", err_out: err_text })
                    if dots != 0 {
                        // One recv through a loop that stops after it: that spelling reads the
                        // same whether the pinned compiler types recv as the element or as an
                        // Option of it.
                        for col in dot_ch {
                            io.eprint_raw("{esc}[31mE{esc}[0m")
                            if col + 1 >= 80 {
                                io.eprint_raw("\n")
                                dot_ch.send(0)
                            } else {
                                dot_ch.send(col + 1)
                            }
                            break
                        }
                    }
                    sem.send(1)
                    return 0
                }
                let rpid = process_spawn(bin_path, rcmd)
                let rr = process_pid_wait(rpid)
                results.send(TestFileResult { idx: idx, built: true, exit_code: rr.exit_code, out: rr.out, err_out: rr.err_out })
                if dots != 0 {
                    for col in dot_ch {
                        if rr.exit_code != 0 {
                            io.eprint_raw("{esc}[31mF{esc}[0m")
                        } else {
                            io.eprint_raw("{esc}[32m.{esc}[0m")
                        }
                        if col + 1 >= 80 {
                            io.eprint_raw("\n")
                            dot_ch.send(0)
                        } else {
                            dot_ch.send(col + 1)
                        }
                        break
                    }
                }
                sem.send(1)
                0
            })
            si = si + 1
        }
    }

    // Every task has ended once the scope does, so whatever was sent is buffered.
    results.close()
    for r in results {
        states.set(r.idx, if r.built { TEST_FILE_RAN } else { TEST_FILE_BUILD_FAILED })
        exit_codes.set(r.idx, r.exit_code)
        outputs.set(r.idx, r.out)
        errors.set(r.idx, r.err_out)
    }

    if dots != 0 {
        io.eprintln("")
    }

    let mut total_passed = 0
    let mut total_failed = 0
    let mut total_errors = 0
    let mut total_lost = 0

    if json_output != 0 {
        io.println("\{\"files\":[")
    }

    let mut ri = 0
    let mut json_first = 1
    while ri < file_count {
        let tf = test_files.get(ri).unwrap()
        let state = states.get(ri).unwrap()
        let ec = exit_codes.get(ri).unwrap()
        if state == TEST_FILE_PENDING {
            total_lost = total_lost + 1
            if json_output != 0 {
                if json_first == 0 {
                    io.println(",")
                }
                json_first = 0
                io.println("\{\"file\":\"{tf}\",\"error\":\"internal error: blink test got no result for this file\"}")
            } else {
                io.println("--- {tf} ---")
                io.println("  INTERNAL ERROR: blink test got no result for this file")
                io.println("")
            }
        } else if state == TEST_FILE_BUILD_FAILED {
            total_errors = total_errors + 1
            if json_output != 0 {
                if json_first == 0 {
                    io.println(",")
                }
                json_first = 0
                io.println("\{\"file\":\"{tf}\",\"error\":\"build failed\"}")
            } else {
                io.println("--- {tf} ---")
                io.println("  BUILD FAILED")
                let err_msg = errors.get(ri).unwrap()
                if err_msg != "" {
                    io.println(err_msg)
                }
                io.println("")
            }
        } else {
            if json_output == 0 {
                let out = outputs.get(ri).unwrap()
                if verbose != 0 || ec != 0 {
                    io.println("--- {tf} ---")
                    if out != "" {
                        io.println(out)
                    }
                    let err_out = errors.get(ri).unwrap()
                    if err_out != "" {
                        io.println(err_out)
                    }
                } else if dots == 0 && quiet == 0 {
                    let mut summary = ""
                    let lines = out.trim().split("\n")
                    let lc = lines.len()
                    if lc > 0 {
                        summary = lines.get(lc - 1).unwrap().trim()
                    }
                    if summary != "" {
                        io.println("PASS {tf} ({summary})")
                    } else {
                        io.println("PASS {tf}")
                    }
                }
            } else {
                if json_first == 0 {
                    io.println(",")
                }
                json_first = 0
                let out = outputs.get(ri).unwrap().trim()
                io.println("\{\"file\":\"{tf}\",\"results\":{out}}")
            }
            if ec != 0 {
                total_failed = total_failed + 1
            } else {
                total_passed = total_passed + 1
            }
        }
        ri = ri + 1
    }

    if json_output != 0 {
        io.println("],\"summary\":\{\"files\":{file_count},\"files_passed\":{total_passed},\"files_failed\":{total_failed},\"build_errors\":{total_errors}}}")
    } else {
        if quiet == 0 && dots == 0 {
            io.println("========================================")
        }
        let mut lost_clause = ""
        if total_lost == 1 {
            lost_clause = ", 1 internal error"
        } else if total_lost > 1 {
            lost_clause = ", {total_lost} internal errors"
        }
        io.println("{file_count} test files: {total_passed} passed, {total_failed} failed, {total_errors} build errors{lost_clause}")
    }

    if total_failed > 0 || total_errors > 0 || total_lost > 0 {
        exit(1)
    }
}

fn cmd_check(p: ArgParser, a: Args) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, IO {
    let source_path = args_positional(a, 0)
    if source_path == "" {
        io.println("error: no source file specified")
        io.println(generate_command_help(p, "check"))
        return
    }
    check_file_exists(source_path)
    let json_output = if args_has(a, "json") { 1 } else { 0 }
    let strict_flag = if args_has(a, "strict") { 1 } else { 0 }
    let strict_struct_layout_flag = if args_has(a, "strict-struct-layout") { 1 } else { 0 }
    set_strict_struct_layout(strict_struct_layout_flag)
    let mut format_flag = args_get(a, "format")
    if json_output != 0 && format_flag == "" {
        format_flag = "json"
    }

    trace_mode = args_get(a, "blink-trace")
    ensure_deps_resolved()
    if format_flag != "" {
        diag_format = 1
    }
    // The daemon checks with no trace and with the default layout rule, so a check that
    // asks for either runs cold.
    if trace_mode == "" && strict_struct_layout_flag == 0 {
        if check_through_daemon(source_path, json_output, diag_format, strict_flag) {
            return
        }
    }
    let _ = check_source(source_path)
    diag_flush()
    io.println(check_status_line(source_path, json_output, strict_flag, diag_ice_count, diag_count, diag_warn_count))
    let code = check_exit_code(strict_flag, diag_ice_count, diag_count, diag_warn_count)
    if code != 0 {
        exit(code)
    }
}

// The check asks the project's daemon, which checks the entry as this client spells it from
// this directory, since a diagnostic spells its file relative to both. A reply the client
// can not read falls back to a cold check: the daemon may make a check faster, never
// different. True when the daemon's answer was printed.
fn check_through_daemon(source_path: Str, json_status: Int, diag_json: Int, strict: Int) -> Bool ! IO {
    let sock = daemon_socket_path()
    if !file_exists(sock) {
        return false
    }
    let fd = unix_socket_connect(sock)
    if fd < 0 {
        return false
    }
    json_clear()
    let req = json_new_object()
    json_set(req, "type", json_new_str("check"))
    json_set(req, "cwd", json_new_str(env.cwd()))
    json_set(req, "path", json_new_str(source_path))
    json_set(req, "json", json_new_int(json_status))
    json_set(req, "diag_json", json_new_int(diag_json))
    json_set(req, "strict", json_new_int(strict))
    let reply = daemon_send(fd, json_encode(req))
    json_clear()
    let root = json_parse(reply)
    if root < 0 || json_as_int(json_get(root, "served")) != 1 {
        return false
    }
    io.eprint(json_as_str(json_get(root, "stderr")))
    io.print(json_as_str(json_get(root, "stdout")))
    let code = json_as_int(json_get(root, "exit"))
    if code != 0 {
        exit(code)
    }
    true
}

// Whether the daemon may run this build or run: only a per-module build that reaches the
// unit path. A one-unit build, and a command the CLI rejects, stay cold, so each error says
// what a cold build says. Reads nothing that can exit.
fn daemon_may_build(a: Args) -> Bool {
    let source_path = args_positional(a, 0)
    if source_path == "" || !file_exists(source_path) {
        return false
    }
    if args_get(a, "emit") != "" {
        return false
    }
    let by_env = env.var("BLINK_PER_MODULE") ?? ""
    if by_env != "" && by_env != "0" && by_env != "1" {
        return false
    }
    let on = args_has(a, "per-module")
    let off = args_has(a, "no-per-module")
    if off || (!on && by_env == "0") {
        return false
    }
    let mut format_flag = args_get(a, "format")
    if args_has(a, "json") && format_flag == "" {
        format_flag = "json"
    }
    per_module_fallback_reason("", format_flag) == ""
}

// The compiler binary and the environment, which a build reads besides its sources and its
// command line. The daemon builds only for a client that names the same. `_`, SHLVL and
// OLDPWD are left out: a shell keeps them for itself, as the command it ran, how deep it runs
// and the directory it was in, so two shells differ in them, and a build reads none of them.
// PWD is left out as each directory of a project has its own; the request carries it, and
// the daemon's build sets it.
// Where /proc names both (daemon_proc_identity), no process starts. Elsewhere one shell hashes
// both. The variables are sorted, since a shell lists them in an order that changes as it sets
// them, and a build reads no order. They are sorted as NUL-ended records, as a value may hold
// a newline; an env without -0 lists them unsorted, so the order then counts, and a client in
// another order builds cold.
fn daemon_identity() -> Str ! IO {
    let compiler = archive_compiler_path()
    match daemon_proc_identity(compiler) {
        Some(id) => return "{get_arg(0)}\n{compiler}\n{id}"
        None => {}
    }
    let unset = "-u _ -u SHLVL -u OLDPWD -u PWD"
    let hashes = process_run("sh", ["-c", "{SHA256SUM_SH}sha256sum '{compiler}' 2>/dev/null; \{ env -0 {unset} 2>/dev/null || env {unset}; } | LC_ALL=C sort -z | sha256sum"]).out.trim()
    "{get_arg(0)}\n{compiler}\n{hashes}"
}

// What the front end reads besides its inputs and the environment, so a daemon's check is a
// cold build's front end only for a client that sets each the same: the struct-layout lint
// level, the front-end trace, and whether the parse keeps the interface texts that unit reuse
// compares. Called once the command's flags are applied.
fn front_settings(strict_struct_layout: Bool) -> Str {
    "strict_struct_layout={strict_struct_layout}\nblink_trace={trace_mode}\ninterface_text={emit_reuse_allowed()}"
}

// A build or run asks the project's daemon to run the build, which it does in a child that
// runs this command line from the program the daemon checked. The daemon serves any entry
// of the project, from any directory, for a client with its compiler, environment and
// front-end settings; anything else, and any reply the client can not read, falls back to a
// cold build. The daemon may make a build faster, never different. True when
// the build through the daemon succeeded and its output was printed; a failed build exits with
// its code.
fn build_through_daemon(a: Args, command: Str) -> Bool ! IO {
    if !daemon_may_build(a) {
        return false
    }
    let sock = daemon_socket_path()
    if !file_exists(sock) {
        return false
    }
    // The settings the cold build would apply, which it applies again if the daemon declines.
    apply_cache_flag(a)
    trace_mode = args_get(a, "blink-trace")
    if (command == "build" && args_get(a, "trace") != "") || (command == "run" && run_traces(a)) {
        cli_trace_codegen = 1
    }
    let settings = front_settings(args_has(a, "strict-struct-layout"))
    let fd = unix_socket_connect(sock)
    if fd < 0 {
        return false
    }
    // After the connect, so a socket no daemon serves costs a build no hashing.
    let identity = daemon_identity()
    json_clear()
    let req = json_new_object()
    json_set(req, "type", json_new_str("build"))
    json_set(req, "cwd", json_new_str(env.cwd()))
    json_set(req, "path", json_new_str(args_positional(a, 0)))
    json_set(req, "identity", json_new_str(identity))
    json_set(req, "settings", json_new_str(settings))
    let argv = json_new_array()
    let mut i = 0
    while i < arg_count() {
        json_push(argv, json_new_str(get_arg(i)))
        i = i + 1
    }
    json_set(req, "argv", argv)
    match env.var("PWD") {
        Some(pwd) => {
            json_set(req, "pwd", json_new_str(pwd))
            json_set(req, "pwd_set", json_new_int(1))
        }
        None => json_set(req, "pwd_set", json_new_int(0))
    }
    let reply = daemon_send(fd, json_encode(req))
    json_clear()
    let root = json_parse(reply)
    if root < 0 || json_as_int(json_get(root, "served")) != 1 {
        return false
    }
    io.eprint(json_as_str(json_get(root, "stderr")))
    io.print(json_as_str(json_get(root, "stdout")))
    let code = json_as_int(json_get(root, "exit"))
    if code != 0 {
        exit(code)
    }
    true
}

// A child the daemon forked for a build runs the client's command line here, as the client
// would have run it cold, from the program the daemon checked, and ends when the build does.
// A build that would first resolve dependencies or rebuild the stdlib archive declines, since
// the client's cold build reads what those write, and the archive's own front end would undo
// the checked program.
fn build_in_daemon_child(b: DaemonBuild) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, Format.Emit, Codegen, IO {
    let p = cli_parser()
    let a = parse_argv(p, b.argv)
    let command = args_command(a)
    if args_error(a) != "" || (command != "build" && command != "run") || !daemon_may_build(a) || deps_unresolved() || !dev_archive_current() {
        write_file(b.declined, "")
        exit(0)
    }
    if command == "build" {
        build_here(p, a, Some(b))
    } else {
        let _ = run_build_here(p, a, Some(b))
    }
    exit(0)
}

fn cmd_emit_archive_header(args_list: List[Str]) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, Codegen {
    if args_list.len() < 2 {
        io.println("error: __emit-archive-header requires <entry.bl> <out.h>")
        exit(1)
    }
    let source_path = args_list.get(0).unwrap()
    let out_path = args_list.get(1).unwrap()

    let final_program = compile_to_program(source_path, 1)
    let _tc_err_count = check_types(final_program)
    check_unused_imports()
    if diag_ice_count > 0 {
        diag_flush()
        exit(101)
    }
    if diag_count > 0 {
        diag_flush()
        exit(1)
    }

    run_build_analyses(final_program)
    if diag_ice_count > 0 {
        diag_flush()
        exit(101)
    }
    if diag_count > 0 {
        diag_flush()
        exit(1)
    }

    let hdr_cfg = CgConfig { debug_mode: 0, trace_codegen: cli_trace_codegen,
        deterministic: cli_deterministic, emit_only_module: "", skip_modules: Map(),
        user_tu_mode: 0, blink_ev_extern_only: 0, archive_build_mode: 0, archive_over_std: 0, compiler_archive_modules: Map() }
    let header = generate_archive_header(final_program, hdr_cfg)

    if diag_ice_count > 0 {
        diag_flush()
        exit(101)
    }
    if diag_count > 0 {
        diag_flush()
        exit(1)
    }

    write_file(out_path, header)
    diag_flush()
}

// Hidden subcommand `__emit-per-module <entry.bl> <out_dir>`: emit a .h
// and .c per source module discovered in the merged program. The entry
// file's source module ("__main__") owns __blink_ev; every other module
// emits with blink_ev_extern_only=1 so the linker resolves the single
// definition. Each .c #includes its own .h. Headers are #ifndef-guarded
// so cross-module #includes (added by callers driving cc) compose safely.
fn cmd_emit_per_module(args_list: List[Str]) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, Codegen, IO {
    if args_list.len() < 2 {
        io.println("error: __emit-per-module requires <entry.bl> <out_dir>")
        exit(1)
    }
    let source_path = args_list.get(0).unwrap()
    let out_dir = args_list.get(1).unwrap()
    shell_exec("mkdir -p {out_dir}")

    let final_program = compile_to_program(source_path, 1)
    let _tc_err_count = check_types(final_program)
    check_unused_imports()
    if diag_ice_count > 0 {
        diag_flush()
        exit(101)
    }
    if diag_count > 0 {
        diag_flush()
        exit(1)
    }

    run_build_analyses(final_program)
    if diag_ice_count > 0 {
        diag_flush()
        exit(101)
    }
    if diag_count > 0 {
        diag_flush()
        exit(1)
    }

    let mod_cfg = CgConfig { debug_mode: 0, trace_codegen: cli_trace_codegen,
        deterministic: cli_deterministic, emit_only_module: "", skip_modules: Map(),
        user_tu_mode: 0, blink_ev_extern_only: 0, archive_build_mode: 0, archive_over_std: 0, compiler_archive_modules: Map() }

    let modules = enumerate_program_modules(final_program)
    // Gate the module list before the loops below read it. An empty list makes both
    // loops no-ops, so without this an ICE here would leave the command writing only
    // the types header and exiting 0 -- a build that emitted nothing and said ok.
    if diag_ice_count > 0 {
        diag_flush()
        exit(101)
    }
    if diag_count > 0 {
        diag_flush()
        exit(1)
    }

    let facts = program_facts(final_program, mod_cfg)
    let hs = match write_unit_headers(final_program, modules, mod_cfg, facts, out_dir, false, None) {
        Ok(h) => h
        Err(rc) => {
            exit(rc)
            return
        }
    }
    // The "__main__" entry module owns __blink_ev; everyone else externs it.
    let mut ci = 0
    while ci < modules.len() {
        let m = modules.get(ci).unwrap()
        // Copy-update, not a fresh literal: a field added to CgConfig later must inherit
        // mod_cfg's value here, and a hand-copied literal would silently take the default.
        let obj_cfg = CgConfig { blink_ev_extern_only: if m != "__main__" { 1 } else { 0 }, ..mod_cfg }
        let obj_c = generate_module_object_with(final_program, m, c_module_header_name(m), obj_cfg, facts)
        if diag_ice_count > 0 {
            diag_flush()
            exit(101)
        }
        if diag_count > 0 {
            diag_flush()
            exit(1)
        }
        let (c, _) = unit_with_includes(obj_c, m, hs)
        write_file("{out_dir}/{m}.c", c)
        ci = ci + 1
    }

    diag_flush()
}

fn cmd_audit(_p: ArgParser, a: Args) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report {
    let source_path = args_positional(a, 0)
    let baseline_path = args_get(a, "baseline")
    let json_output = if args_has(a, "json") { 1 } else { 0 }
    let ffi_flag = if args_has(a, "ffi") { 1 } else { 0 }

    if ffi_flag != 0 || source_path != "" {
        let audit_path = if source_path != "" { source_path } else { "src/main.bl" }
        check_file_exists(audit_path)
        let final_program = compile_to_program(audit_path, 1)

        do_ffi_audit(final_program, json_output)
        if diag_ice_count > 0 {
            diag_flush()
            exit(101)
        }
        if diag_count > 0 {
            diag_flush()
        }
    } else {
        let lockfile = resolve_lockfile_path()
        if lockfile == "" {
            io.println("error: no blink.lock found. Run 'blink build' first.")
            return
        }

        lockfile_load(lockfile)

        if baseline_path != "" {
            audit_load_baseline(baseline_path)
        }

        let count = audit_check()
        audit_report()
        if count > 0 {
            exit(1)
        }
    }
}

fn cmd_fmt(_p: ArgParser, a: Args) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, Format.Emit, Codegen {
    let source_path = args_positional(a, 0)
    let json_output = if args_has(a, "json") { 1 } else { 0 }
    let check_flag = if args_has(a, "check") { 1 } else { 0 }
    if source_path != "" {
        check_file_exists(source_path)
    }
    let name = if source_path != "" { strip_extension(path_basename(source_path)) } else { "" }
    if check_flag == 1 {
        shell_exec("mkdir -p .tmp")
        let mut needs_format: List[Str] = []
        let mut ok_files: List[Str] = []
        let mut check_errors = 0
        if source_path == "" {
            let mut fmt_files: List[Str] = []
            collect_source_files(".", fmt_files)
            let mut fi = 0
            while fi < fmt_files.len() {
                let fname = fmt_files.get(fi).unwrap()
                let tmp_name = strip_extension(path_basename(fname))
                let tmp_path = ".tmp/fmt_check_{tmp_name}.bl"
                let rc = do_compile(fname, tmp_path, "blink", 0, 0)
                if rc == 0 {
                    let original = read_file(fname)
                    let formatted = read_file(tmp_path)
                    if original != formatted {
                        needs_format.push(fname)
                        if json_output == 0 {
                            io.println("would reformat: {fname}")
                        }
                    } else {
                        ok_files.push(fname)
                    }
                } else {
                    check_errors = check_errors + 1
                    if json_output == 0 {
                        io.println("error: formatting failed for {fname}")
                    }
                }
                shell_exec("rm -f {tmp_path}")
                fi = fi + 1
            }
        } else {
            let tmp_path = ".tmp/fmt_check_{name}.bl"
            let rc = do_compile(source_path, tmp_path, "blink", 0, 0)
            if rc == 0 {
                let original = read_file(source_path)
                let formatted = read_file(tmp_path)
                if original != formatted {
                    needs_format.push(source_path)
                    if json_output == 0 {
                        io.println("would reformat: {source_path}")
                    }
                } else {
                    ok_files.push(source_path)
                }
            } else {
                check_errors = check_errors + 1
                if json_output == 0 {
                    io.println("error: formatting failed")
                }
            }
            shell_exec("rm -f {tmp_path}")
        }
        if json_output != 0 {
            let mut json_needs = ""
            let mut ni = 0
            while ni < needs_format.len() {
                if ni > 0 {
                    json_needs = json_needs.concat(",")
                }
                json_needs = json_needs.concat("\"").concat(needs_format.get(ni).unwrap()).concat("\"")
                ni = ni + 1
            }
            let mut json_ok = ""
            let mut oi = 0
            while oi < ok_files.len() {
                if oi > 0 {
                    json_ok = json_ok.concat(",")
                }
                json_ok = json_ok.concat("\"").concat(ok_files.get(oi).unwrap()).concat("\"")
                oi = oi + 1
            }
            io.println("\{\"check\":true,\"needs_format\":[{json_needs}],\"ok\":[{json_ok}]}")
        } else {
            if needs_format.len() > 0 {
                io.println("{needs_format.len()} file(s) would be reformatted")
            } else {
                io.println("All files formatted correctly")
            }
        }
        if needs_format.len() > 0 || check_errors > 0 {
            exit(1)
        }
    } else {
        if source_path == "" {
            let mut fmt_files: List[Str] = []
            collect_source_files(".", fmt_files)
            let mut fmt_ok: List[Str] = []
            let mut fmt_err: List[Str] = []
            let mut fi = 0
            while fi < fmt_files.len() {
                let fname = fmt_files.get(fi).unwrap()
                let rc = do_compile(fname, fname, "blink", 0, 0)
                if rc == 0 {
                    if json_output == 0 {
                        io.println("formatted: {fname}")
                    }
                    fmt_ok.push(fname)
                } else {
                    if json_output == 0 {
                        io.println("error: formatting failed for {fname}")
                    }
                    fmt_err.push(fname)
                }
                fi = fi + 1
            }
            if json_output != 0 {
                let mut ok_json = "["
                let mut oi = 0
                while oi < fmt_ok.len() {
                    if oi > 0 {
                        ok_json = ok_json.concat(",")
                    }
                    ok_json = ok_json.concat("\"").concat(fmt_ok.get(oi).unwrap()).concat("\"")
                    oi = oi + 1
                }
                ok_json = ok_json.concat("]")
                let mut err_json = "["
                let mut ei = 0
                while ei < fmt_err.len() {
                    if ei > 0 {
                        err_json = err_json.concat(",")
                    }
                    err_json = err_json.concat("\"").concat(fmt_err.get(ei).unwrap()).concat("\"")
                    ei = ei + 1
                }
                err_json = err_json.concat("]")
                io.println("\{\"formatted\":{ok_json},\"errors\":{err_json}}")
            }
            if fmt_err.len() > 0 {
                exit(1)
            }
        } else {
            let rc = do_compile(source_path, source_path, "blink", 0, 0)
            if rc == 0 {
                if json_output != 0 {
                    io.println("\{\"formatted\":[\"{source_path}\"],\"errors\":[]}")
                } else {
                    io.println("formatted: {source_path}")
                }
            } else {
                if json_output != 0 {
                    io.println("\{\"formatted\":[],\"errors\":[\"{source_path}\"]}")
                } else {
                    io.println("error: formatting failed")
                }
                exit(rc)
            }
        }
    }
}

fn setup_marketplace(pwd: Str) {
    let base = ".claude/blink-marketplace"
    let plugin_dir = "{base}/plugins/blink"
    shell_exec("rm -rf {plugin_dir}/skills/upgrade {plugin_dir}/skills/init")
    shell_exec("mkdir -p {base}/.claude-plugin {plugin_dir}/.claude-plugin {plugin_dir}/skills/blink:upgrade {plugin_dir}/skills/blink:init")

    write_file("{base}/.claude-plugin/marketplace.json", "\{\"name\":\"blink-plugins\",\"owner\":\{\"name\":\"Blink\"},\"plugins\":[\{\"name\":\"blink\",\"source\":\"./plugins/blink\",\"description\":\"Blink language support: LSP, skills, and tools\"}]}")
    write_file("{plugin_dir}/.claude-plugin/plugin.json", "\{\"name\":\"blink\",\"description\":\"Blink language support: LSP, skills, and tools\",\"version\":\"1.0.0\"}")
    write_file("{plugin_dir}/.lsp.json", "\{\"blink\":\{\"command\":\"blink\",\"args\":[\"lsp\"],\"extensionToLanguage\":\{\".pact\":\"blink\",\".bl\":\"blink\"}}}")
    write_file("{plugin_dir}/skills/blink:upgrade/SKILL.md", embedded_upgrade_cmd)
    write_file("{plugin_dir}/skills/blink:init/SKILL.md", embedded_init_cmd)

    let settings_path = ".claude/settings.json"
    json_clear()
    let root = if file_exists(settings_path) == 1 {
        let parsed = json_parse(read_file(settings_path))
        if parsed < 0 {
            json_clear()
            json_new_object()
        } else {
            parsed
        }
    } else {
        json_new_object()
    }

    let source_obj = json_new_object()
    json_set(source_obj, "source", json_new_str("directory"))
    json_set(source_obj, "path", json_new_str(pwd.concat("/.claude/blink-marketplace")))
    let entry = json_new_object()
    json_set(entry, "source", source_obj)
    let mkts = json_ensure_object(root, "extraKnownMarketplaces")
    json_set(mkts, "blink-plugins", entry)
    let plugins = json_ensure_object(root, "enabledPlugins")
    json_set(plugins, "blink@blink-plugins", json_new_bool(1))
    write_file(settings_path, json_encode(root))
}

fn migrate_blink_marketplace() {
    let old_dir = ".claude/pact-marketplace"
    let new_dir = ".claude/blink-marketplace"
    if is_dir(old_dir) == 0 || is_dir(new_dir) == 1 {
        return
    }
    shell_exec("mv {old_dir} {new_dir}")

    let settings_path = ".claude/settings.json"
    if file_exists(settings_path) == 1 {
        json_clear()
        let root = json_parse(read_file(settings_path))
        if root >= 0 {
            let mkts = json_get(root, "extraKnownMarketplaces")
            if mkts >= 0 { json_remove(mkts, "pact-plugins") }
            let plugins = json_get(root, "enabledPlugins")
            if plugins >= 0 {
                json_remove(plugins, "pact@pact-plugins")
                json_remove(plugins, "blink@pact-plugins")
            }
            write_file(settings_path, json_encode(root))
        }
    }

    let pwd = process_run("pwd", []).out.trim()
    setup_marketplace(pwd)
    io.println("  migrated: .claude/pact-marketplace → .claude/blink-marketplace")
}

fn json_ensure_object(parent: Int, key: Str) -> Int {
    let existing = json_get(parent, key)
    if existing >= 0 {
        return existing
    }
    let obj = json_new_object()
    json_set(parent, key, obj)
    obj
}

fn cmd_init(_p: ArgParser, a: Args) {
    let source_path = args_positional(a, 0)
    let project_name = if source_path != "" {
        source_path
    } else {
        let pwd_result = process_run("pwd", [])
        path_basename(pwd_result.out.trim())
    }

    let already_initialized = if resolve_manifest_path() != "" { 1 } else { 0 }

    if already_initialized == 0 {
        let toml_content = "[package]\nname = \"{project_name}\"\nversion = \"0.1.0\"\nblink-version = \"{blink_cli_version}\"\n\n[dependencies]\n"
        write_file("blink.toml", toml_content)
        io.println("  created blink.toml")

        if file_exists("src") == 0 {
            shell_exec("mkdir -p src")
        }
        if file_exists("src/main.bl") == 0 {
            let main_content = "fn main() \{\n    io.println(\"Hello from {project_name}!\")\n\}\n"
            write_file("src/main.bl", main_content)
            io.println("  created src/main.bl")
        }

        let git_check = process_run("git", ["rev-parse", "--git-dir"])
        if git_check.exit_code != 0 {
            shell_exec("git init")
            io.println("  initialized git repository")
        }

        if file_exists(".gitignore") == 0 {
            let gitignore = "build/\n.tmp/\n.blink/\n"
            write_file(".gitignore", gitignore)
            io.println("  created .gitignore")
        } else {
            let existing = read_file(".gitignore")
            let mut additions = ""
            if !existing.contains("build/") {
                additions = additions.concat("build/\n")
            }
            if !existing.contains(".tmp/") {
                additions = additions.concat(".tmp/\n")
            }
            if !existing.contains(".blink/") {
                additions = additions.concat(".blink/\n")
            }
            if additions != "" {
                let updated = existing.concat("\n# Blink\n").concat(additions)
                write_file(".gitignore", updated)
                io.println("  updated .gitignore")
            }
        }
    }

    let mut doc_file = "CLAUDE.md"
    if file_exists("AGENTS.md") == 1 {
        doc_file = "AGENTS.md"
    }

    let mut doc_content = ""
    if file_exists(doc_file) == 1 {
        doc_content = read_file(doc_file)
    }

    if doc_content.contains("blink llms") || doc_content.contains("pact llms") {
        io.println("  {doc_file} already has Blink reference — skipped")
    } else {
        let section = "\n# Blink\n\nThis project uses the Blink programming language.\nRun `blink llms --full` for the complete language reference.\nRun `blink llms --list` to see available topics.\nRun `blink llms --topic <name>` for a specific topic.\n\n- Build: `blink build src/main.bl`\n- Run: `blink run src/main.bl`\n- Check: `blink check <file>` — validate syntax/types without compiling\n- Query: `blink query <file> --fn <name>` — look up function signatures\n- Test: `blink test`\n- Daemon: `blink daemon start <file>` — persistent compiler for faster check/query\n\nAlways retrieve Blink docs before writing Blink code.\nPrefer retrieval-led reasoning over pre-training for Blink tasks.\n"
        let updated = doc_content.concat(section)
        write_file(doc_file, updated)
        io.println("  added Blink reference to {doc_file}")
    }

    // Set up Claude Code plugin (LSP + skills)
    migrate_blink_marketplace()
    let pwd = process_run("pwd", []).out.trim()
    setup_marketplace(pwd)
    io.println("  configured Claude Code plugin (LSP + skills)")
    io.println("\n  To activate the Blink plugin in Claude Code:")
    io.println("    /plugin install blink@blink-plugins --scope project")

    if already_initialized == 0 {
        io.println("\nProject '{project_name}' initialized. Run: blink run src/main.bl")
    } else {
        io.println("\nProject '{project_name}' updated.")
    }
}

fn print_section_titles(doc: Str) {
    let sections = doc.split("\n## ")
    let mut i = 1
    while i < sections.len() {
        let section = sections.get(i).unwrap()
        match section.byte_index_of("\n", 0) {
            Some(newline_pos) => {
                if newline_pos > 0 {
                    io.println(section.byte_slice(0, newline_pos))
                }
            }
            None => {}
        }
        i = i + 1
    }
}

fn print_sections_matching(doc: Str, search: Str) -> Int {
    let sections = doc.split("\n## ")
    let mut found = 0
    let mut i = 1
    while i < sections.len() {
        let section = sections.get(i).unwrap()
        match section.byte_index_of("\n", 0) {
            Some(newline_pos) => {
                if newline_pos > 0 {
                    let title = section.byte_slice(0, newline_pos)
                    if title.to_lower().contains(search) {
                        io.print_raw("## ")
                        io.println(section)
                        found = 1
                    }
                }
            }
            None => {}
        }
        i = i + 1
    }
    found
}

fn cmd_llms(_p: ArgParser, a: Args) {
    let full_flag = if args_has(a, "full") { 1 } else { 0 }
    let list_flag = if args_has(a, "list") { 1 } else { 0 }
    let topic_flag = args_get(a, "topic")
    if embedded_llms_full == "" {
        io.eprintln("error: llms-full.md not found")
    } else if list_flag == 1 {
        print_section_titles(embedded_llms_full)
        print_section_titles(embedded_changelog)
    } else if topic_flag != "" {
        let search = topic_flag.to_lower()
        let ref_found = print_sections_matching(embedded_llms_full, search)
        let log_found = print_sections_matching(embedded_changelog, search)
        if ref_found == 0 && log_found == 0 {
            io.eprintln("error: no topic matching '{topic_flag}' found. Run `blink llms --list` to see topics.")
        }
    } else if full_flag == 1 {
        io.print_raw(embedded_llms_full)
        io.print_raw("\n")
        io.print_raw(embedded_changelog)
    } else {
        if embedded_llms_short != "" {
            io.print_raw(embedded_llms_short)
            io.print_raw("\n")
            io.print_raw(embedded_changelog)
        } else {
            io.eprintln("error: llms.md not found")
        }
    }
}

fn cmd_doc(_p: ArgParser, a: Args) ! Lex.Tokenize, Parse, Diag.Report {
    let list_flag = if args_has(a, "list") { 1 } else { 0 }
    let json_output = if args_has(a, "json") { 1 } else { 0 }
    if list_flag == 1 {
        io.println("Standard library modules:")
        io.println("  std.args        CLI argument parsing")
        io.println("  std.bytes       Byte buffer utilities")
        io.println("  std.db          Database access (SQLite)")
        io.println("  std.http        HTTP client and server")
        io.println("  std.json        JSON parser and serializer")
        io.println("  std.net         TCP networking primitives")
        io.println("  std.path        File path manipulation")
        io.println("  std.semver      Semantic version parsing")
        io.println("  std.template    String template utilities")
        io.println("  std.term        Terminal styling and control")
        io.println("  std.testing     Test framework")
        io.println("  std.time        Date and time utilities")
        io.println("  std.toml        TOML parser")
        io.println("")
        io.println("Run: blink doc <module>  (e.g. blink doc std.args)")
        return
    }
    let module_name = args_positional(a, 0)
    if module_name == "" {
        io.println("error: blink doc requires a module name")
        io.println("usage: blink doc <module>  (e.g. blink doc std.args)")
        io.println("       blink doc --list    (list available modules)")
        return
    }
    reset_compiler_state()
    diag_reset()
    let file_path = resolve_module_path(module_name, "src/")
    if file_path == "" {
        diag_flush()
        return
    }
    // blink.* pseudo-modules (blink.ffi, blink.core) have no backing source —
    // they name compiler-known intrinsics. The `import` is an optional marker,
    // so there is nothing to parse; point the reader at the language spec.
    if file_path.starts_with("<blink-pseudo:") {
        io.println("'{module_name}' is a compiler-internal pseudo-module (no importable source).")
        io.println("Its contents are compiler-known intrinsics — see the language spec §9.1.1 (FFI types) / prelude docs (ConversionError).")
        return
    }
    let mut source = ""
    if file_path.starts_with("<embedded:") {
        let key = embedded_inner_key(file_path)
        source = embedded_get_source(key)
    } else {
        source = read_file(file_path)
    }
    if source == "" {
        io.println("error: could not read module: {module_name}")
        return
    }
    lex(source)
    pos = 0
    diag_source_file = file_path
    let first_node_doc = node_count()
    let program = parse_program()
    attach_comments_pass(program, first_node_doc)
    if diag_count > 0 {
        diag_flush()
        io.println("error: parse failed for module: {module_name}")
        return
    }
    let mut extra_programs: List[Int] = []
    let imports_sl = node_elements(program)
    if imports_sl != -1 {
        let mut ii = 0
        while ii < sublist_length(imports_sl) {
            let imp_node = sublist_get(imports_sl, ii)
            if node_is_pub(imp_node) != 0 {
                let imp_path = node_str_val(imp_node)
                let sub_file = resolve_module_path(imp_path, "src/")
                if sub_file != "" && !sub_file.starts_with("<blink-pseudo:") {
                    let mut sub_source = ""
                    if sub_file.starts_with("<embedded:") {
                        let key = embedded_inner_key(sub_file)
                        sub_source = embedded_get_source(key)
                    } else {
                        sub_source = read_file(sub_file)
                    }
                    if sub_source != "" {
                        lex(sub_source)
                        pos = 0
                        diag_source_file = sub_file
                        let sub_first = node_count()
                        let sub_prog = parse_program()
                        attach_comments_pass(sub_prog, sub_first)
                        extra_programs.push(sub_prog)
                    }
                }
            }
            ii = ii + 1
        }
    }
    let result = generate_doc(program, module_name, json_output, extra_programs)
    io.println(result)
}

fn cmd_query(p: ArgParser, a: Args) ! Lex.Tokenize, Parse, Diag.Report, IO {
    let source_path = args_positional(a, 0)
    if source_path == "" {
        io.println("error: no source file specified")
        io.println(generate_command_help(p, "query"))
        return
    }
    check_file_exists(source_path)
    let mut query_layer = args_get(a, "layer")
    let query_effect = args_get(a, "effect")
    let query_module = args_get(a, "module")
    let query_fn = args_get(a, "fn")
    let query_pub = if args_has(a, "pub") { 1 } else { 0 }
    let query_pure = if args_has(a, "pure") { 1 } else { 0 }
    if query_layer == "" {
        query_layer = "signature"
    }
    let sock_path = daemon_socket_path()
    let sock_fd = if file_exists(sock_path) { unix_socket_connect(sock_path) } else { -1 }
    if sock_fd >= 0 {
        let mut request = ""
        if query_fn != "" {
            request = "\{\"type\":\"query\",\"query_type\":\"fn\",\"name\":\"{query_fn}\"}"
        } else if query_effect != "" {
            request = "\{\"type\":\"query\",\"query_type\":\"effect\",\"effect\":\"{query_effect}\"}"
        } else if query_pub != 0 && query_pure != 0 {
            request = "\{\"type\":\"query\",\"query_type\":\"pub_pure\"}"
        } else if query_pub != 0 {
            let mod_name = if query_module != "" { query_module } else { strip_extension(path_basename(source_path)) }
            request = "\{\"type\":\"query\",\"query_type\":\"signature\",\"module\":\"{mod_name}\"}"
        } else if query_pure != 0 {
            request = "\{\"type\":\"query\",\"query_type\":\"pub_pure\"}"
        } else if query_layer == "signature" {
            let mod_name = if query_module != "" { query_module } else { strip_extension(path_basename(source_path)) }
            request = "\{\"type\":\"query\",\"query_type\":\"signature\",\"module\":\"{mod_name}\"}"
        } else {
            let mod_name = if query_module != "" { query_module } else { strip_extension(path_basename(source_path)) }
            request = "\{\"type\":\"query\",\"query_type\":\"signature\",\"module\":\"{mod_name}\"}"
        }
        let response = daemon_send(sock_fd, request)
        // A daemon that took no request or gave no answer leaves the query to run cold.
        if response != "" {
            io.println(response)
            return
        }
    }
    let source = read_file(source_path)
    lex(source)
    pos = 0
    diag_source_file = source_path
    let first_node = node_count()
    let program = parse_program()
    attach_comments_pass(program, first_node)

    if diag_count > 0 {
        diag_flush()
        io.println("error: parse failed, cannot query")
        exit(1)
    }

    let module_name = strip_extension(path_basename(source_path))
    si_reset()
    si_build(program, source_path, module_name)

    let vis = if query_pub != 0 { 1 } else { -1 }
    let mod_f = if query_module != "" { query_module } else if query_fn == "" { module_name } else { "" }
    let result = query_filtered_layer(query_layer, vis, mod_f, query_effect, query_pure, query_fn)

    io.println(result)
}

fn is_std_add_pkg(name: Str) -> Int {
    if name.starts_with("std/") {
        return 1
    }
    0
}

fn cmd_add(_p: ArgParser, a: Args) {
    let source_path = args_positional(a, 0)
    if source_path == "" {
        io.println("error: blink add requires a package name")
        io.println("usage: blink add <pkg> --path <dir>")
        io.println("       blink add <pkg> --git <url> [--tag <tag>]")
        io.println("       blink add std/<pkg>  (stdlib packages)")
        exit(1)
    }
    let pkg_name = source_path
    let dep_path_flag = args_get(a, "path")
    let git_url_flag = args_get(a, "git")
    let git_tag_flag = args_get(a, "tag")
    let dev_flag = if args_has(a, "dev") { 1 } else { 0 }

    let is_std = is_std_add_pkg(pkg_name)
    if dep_path_flag == "" && git_url_flag == "" && is_std == 0 {
        io.println("error: blink add requires --path or --git (registry not supported in v1)")
        exit(1)
    }

    let manifest = resolve_manifest_path()
    if manifest == "" {
        io.println("error: no blink.toml found in current directory")
        exit(1)
    }

    manifest_clear()
    let load_rc = manifest_load(manifest)
    if load_rc != 0 {
        exit(1)
    }

    if manifest_name == pkg_name {
        io.println("error: cannot add package '{pkg_name}' as a dependency of itself")
        exit(1)
    }

    if manifest_has_dep(pkg_name) == 1 {
        io.println("error: dependency '{pkg_name}' already exists in {manifest}")
        exit(1)
    }

    let dep_val = if is_std == 1 { "\"0.1\"" } else { format_dep_value(dep_path_flag, git_url_flag, git_tag_flag) }
    let content = read_file(manifest)
    let section = "dependencies"
    if dev_flag == 1 {
        let updated = insert_dep_line(content, "dev-dependencies", pkg_name, dep_val)
        write_file(manifest, updated)
    } else {
        let updated = insert_dep_line(content, section, pkg_name, dep_val)
        write_file(manifest, updated)
    }

    let resolve_rc = resolve_and_lock(".", blink_cli_version)
    if resolve_rc == 0 {
        io.println("added: {pkg_name}")
    } else {
        io.println("error: dependency resolution failed after adding '{pkg_name}'")
        exit(1)
    }
}

fn cmd_remove(_p: ArgParser, a: Args) {
    let source_path = args_positional(a, 0)
    if source_path == "" {
        io.println("error: blink remove requires a package name")
        io.println("usage: blink remove <pkg>")
        return
    }
    let pkg_name = source_path

    let manifest = resolve_manifest_path()
    if manifest == "" {
        io.println("error: no blink.toml found in current directory")
        return
    }

    manifest_clear()
    let load_rc = manifest_load(manifest)
    if load_rc != 0 {
        return
    }

    if manifest_has_dep(pkg_name) == 0 {
        io.println("error: dependency '{pkg_name}' not found in {manifest}")
        return
    }

    let content = read_file(manifest)
    let updated = remove_dep_line(content, pkg_name)
    write_file(manifest, updated)

    let resolve_rc = resolve_and_lock(".", blink_cli_version)
    if resolve_rc == 0 {
        io.println("removed: {pkg_name}")
    } else {
        io.println("warning: dependency resolution failed after removing '{pkg_name}'")
        io.println("removed: {pkg_name}")
    }
}

fn cmd_update(_p: ArgParser, a: Args) {
    let source_path = args_positional(a, 0)
    let manifest = resolve_manifest_path()
    if manifest == "" {
        io.println("error: no blink.toml found in current directory")
        return
    }

    stamp_blink_version()
    migrate_blink_marketplace()
    let upgrade_skill = ".claude/blink-marketplace/plugins/blink/skills/blink:upgrade/SKILL.md"
    if file_exists(upgrade_skill) == 1 {
        let existing = read_file(upgrade_skill)
        if existing != embedded_upgrade_cmd {
            write_file(upgrade_skill, embedded_upgrade_cmd)
            io.println("updated: blink plugin upgrade skill")
        }
    }
    let init_skill = ".claude/blink-marketplace/plugins/blink/skills/blink:init/SKILL.md"
    if file_exists(init_skill) == 1 {
        let existing_init = read_file(init_skill)
        if existing_init != embedded_init_cmd {
            write_file(init_skill, embedded_init_cmd)
            io.println("updated: blink plugin init skill")
        }
    }
    let resolve_rc = resolve_and_lock(".", blink_cli_version)
    if resolve_rc == 0 {
        if source_path != "" {
            io.println("updated: {source_path}")
        } else {
            io.println("updated: all dependencies")
        }
        io.println("lockfile written: blink.lock")
    } else {
        io.println("error: dependency resolution failed")
    }
}

fn cmd_lsp(_p: ArgParser, _a: Args) ! IO, Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, Format.Emit {
    lsp_start()
}

fn cmd_explain(_p: ArgParser, a: Args) {
    let code = args_positional(a, 0)
    if code == "" {
        io.println("usage: blink explain <code>")
        io.println("example: blink explain E0500")
        return
    }
    let explanation = diag_explain(code)
    if explanation == "" {
        io.println("unknown error code: {code}")
        exit(1)
    }
    io.println(explanation)
}

fn cmd_ast(p: ArgParser, a: Args) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report {
    let source_path = args_positional(a, 0)
    if source_path == "" {
        io.println("error: no source file specified")
        io.println(generate_command_help(p, "ast"))
        return
    }
    check_file_exists(source_path)
    reset_compiler_state()
    diag_reset()
    let source = read_file(source_path)
    lex(source)
    pos = 0
    diag_source_file = source_path
    let first_node_ast = node_count()
    let program = parse_program()
    attach_comments_pass(program, first_node_ast)

    if diag_count > 0 {
        diag_flush()
        io.println("error: parse failed, cannot dump AST")
        exit(1)
    }

    let imports_flag = if args_has(a, "imports") { 1 } else { 0 }
    let node_id_str = args_get(a, "node")

    let mut final_program = program
    if imports_flag != 0 {
        loaded_inputs.files.push(source_path)
        let src_root = find_src_root(source_path)
        let mut imported_programs: List[Int] = []
        collect_root_imports(program)
        collect_imports(program, src_root, imported_programs)
        inject_prelude(src_root, imported_programs)
        if imported_programs.len() > 0 {
            final_program = merge_programs(program, imported_programs, import_map_nodes)
        }
    }

    if node_id_str != "" {
        let node_id = node_id_str.to_int()
        io.println(ast_to_json(node_id))
    } else {
        io.println(ast_to_json(final_program))
    }
}

// blink.toml names no entry file, so start takes it as an argument. The daemon serves the
// project, so its socket goes at the project root wherever the entry lives.
fn cmd_daemon_start(_p: ArgParser, a: Args) ! Daemon.Serve, IO, Lex.Tokenize, Parse, Parse.Build, TypeCheck, Diag.Report, Format.Emit, Codegen {
    let daemon_source = args_positional(a, 0)
    if daemon_source == "" {
        io.println("error: daemon start needs the entry file of the program to serve")
        io.println("usage: blink daemon start <file.bl>")
        exit(1)
    }
    if !file_exists(daemon_source) {
        io.println("error: file not found: {daemon_source}")
        exit(1)
    }
    let max_flag = args_get(a, "max-entries")
    let mut max_entries = 8
    if max_flag != "" {
        max_entries = max_flag.to_int()
        if max_entries <= 0 || "{max_entries}" != max_flag.trim() {
            io.println("error: --max-entries must be a positive integer, got '{max_flag}'")
            exit(1)
        }
    }
    io.println("Daemon starting on {daemon_socket_path()}")
    // Each build child is a fork of the daemon and keys its objects by this hash. The daemon
    // builds only for a client that runs this compiler, so no child needs to hash it again.
    let _ = process_compiler_sha()
    // The daemon checks with the settings a build with no flags applies.
    match daemon_start(daemon_source, daemon_identity(), front_settings(false), emit_reuse_allowed(), max_entries) {
        Some(b) => build_in_daemon_child(b)
        None => {}
    }
}

// A connection to the project's daemon; exits 1 when none answers.
fn connect_project_daemon() -> Int {
    let sp = daemon_socket_path()
    if !file_exists(sp) {
        io.println("error: daemon not running (no {sp} found)")
        exit(1)
    }
    let fd = unix_socket_connect(sp)
    if fd < 0 {
        io.println("error: daemon not running (could not connect to {sp})")
        exit(1)
    }
    fd
}

// Sends `request` to the project's daemon; exits 1 when the daemon is gone before it is sent.
fn send_to_project_daemon(fd: Int, request: Str) {
    if socket_write(fd, request) < 0 {
        unix_socket_close(fd)
        io.println("error: daemon not running (could not send to {daemon_socket_path()})")
        exit(1)
    }
}

fn cmd_daemon_status(_p: ArgParser, _a: Args) {
    let fd = connect_project_daemon()
    send_to_project_daemon(fd, "\{\"type\":\"status\"}\n")
    let response = socket_read_line(fd)
    unix_socket_close(fd)
    if response == "" {
        io.println("error: daemon closed the connection without a status")
        exit(1)
    }
    io.println(response)
}

fn cmd_daemon_stop(_p: ArgParser, _a: Args) {
    let fd = connect_project_daemon()
    send_to_project_daemon(fd, "\{\"type\":\"stop\"}\n")
    let _response = socket_read_line(fd)
    unix_socket_close(fd)
    io.println("Daemon stopped")
}

fn cmd_daemon_bare(p: ArgParser, _a: Args) {
    io.println("error: daemon requires a subcommand: start, status, or stop")
    io.println(generate_command_help(p, "daemon"))
}

fn shim_c_template(name: Str) -> Str {
    "/* Vendored C shim for `{name}`.\n * Scaffolded by `blink shim init`. Spec: §9.1.3 γ-doctrine.\n *\n * This file holds the C-side implementation that backs the Blink @ffi\n * wrappers in src/{name}.bl. Replace the stub below with real code\n * (varargs, signal handlers, packed structs, alignment overrides, etc.).\n */\n#include \"{name}.h\"\n\n/* TODO: replace this stub with the real shim implementation. */\nint blink_{name}_hello(void) \{\n    return 0;\n\}\n"
}

fn shim_h_template(name: Str) -> Str {
    let upper = name.to_upper()
    "/* Public header for the `{name}` shim. */\n#ifndef BLINK_SHIM_{upper}_H\n#define BLINK_SHIM_{upper}_H\n\nint blink_{name}_hello(void);\n\n#endif\n"
}

fn shim_wrapper_template(name: Str) -> Str {
    "// @trusted wrapper for the `{name}` shim. Spec: §9.1.3 γ-doctrine.\n// The raw @ffi binding is private; only the safe wrapper is `pub`.\n// TODO: review the binding and replace audit:\"TODO\" with a real audit ID.\n\n@ffi(\"{name}\", \"blink_{name}_hello\")\n@trusted(audit: \"TODO\")\nfn raw_{name}_hello() -> Int ! FFI \{\}\n\n// TODO: replace this stub with a real safe wrapper.\npub fn {name}_hello() -> Int ! FFI \{\n    raw_{name}_hello()\n\}\n"
}

fn cmd_shim_init(_p: ArgParser, a: Args) {
    let name = args_positional(a, 0)
    if name == "" {
        io.println("error: blink shim init requires a name")
        io.println("usage: blink shim init <name>")
        exit(1)
    }
    if validate_package_name(name) == 0 {
        io.println("error: shim name must start with a lowercase letter and contain only [a-z0-9_]: '{name}'")
        exit(1)
    }

    let manifest = resolve_manifest_path()
    if manifest == "" {
        io.println("error: no blink.toml found — run `blink init` first")
        exit(1)
    }

    let c_path = "vendor/{name}.c"
    let h_path = "vendor/{name}.h"
    let wrapper_path = "src/{name}.bl"

    if file_exists(c_path) == 1 || file_exists(h_path) == 1 || file_exists(wrapper_path) == 1 {
        io.println("error: shim '{name}' already exists (one of: {c_path}, {h_path}, {wrapper_path})")
        exit(1)
    }

    manifest_clear()
    let load_rc = manifest_load(manifest)
    if load_rc != 0 {
        exit(1)
    }
    if manifest_has_native_dep(name) == 1 {
        io.println("error: native dependency '{name}' already declared in {manifest}")
        exit(1)
    }

    if file_exists("vendor") == 0 {
        shell_exec("mkdir -p vendor")
    }
    if file_exists("src") == 0 {
        shell_exec("mkdir -p src")
    }

    write_file(c_path, shim_c_template(name))
    io.println("  created {c_path}")
    write_file(h_path, shim_h_template(name))
    io.println("  created {h_path}")
    write_file(wrapper_path, shim_wrapper_template(name))
    io.println("  created {wrapper_path}")

    let dep_value = "\{ type = \"vendored\", path = \"".concat(c_path).concat("\" \}")
    let content = read_file(manifest)
    let updated = insert_dep_line(content, "native-dependencies", name, dep_value)
    write_file(manifest, updated)
    io.println("  registered [native-dependencies].{name} in {manifest}")

    io.println("\nShim '{name}' scaffolded.")
    io.println("Next steps:")
    io.println("  1. Implement {c_path} (the C side).")
    io.println("  2. Replace audit:\"TODO\" in {wrapper_path} with a real audit ID.")
    io.println("  3. Use {name}_hello() (or your renamed wrapper) from application code.")
}

fn cmd_shim_bare(p: ArgParser, _a: Args) {
    io.println("error: shim requires a subcommand: init")
    io.println(generate_command_help(p, "shim"))
}

// The parser for the blink command line.
fn cli_parser() -> ArgParser {
    let mut p = argparser_new("blink", "The Blink programming language compiler and toolchain")
    p = add_command(p, "init", "Initialize a new Blink project")
    p = add_command(p, "build", "Compile Blink source to native binary (C at -O1 unless --debug or --release)")
    p = add_command(p, "run", "Build and execute (C at -O1 unless --debug or --release)")
    p = add_command(p, "check", "Validate without producing binary")
    p = add_command(p, "test", "Build and run tests (discovers source files with test blocks)")
    p = add_command(p, "fmt", "Format source file(s) in place")
    p = add_command(p, "ast", "Dump parsed AST as JSON")
    p = add_command(p, "audit", "Audit FFI usage and dependency capabilities")
    p = add_command(p, "add", "Add a dependency (use --path or --git)")
    p = add_command(p, "remove", "Remove a dependency")
    p = add_command(p, "update", "Update dependencies, lockfile, and blink-version")
    p = add_command(p, "daemon.start", "Start the project daemon; it listens in .blink/ at the project root (nearest blink.toml, else the cwd)")
    p = add_command(p, "daemon.status", "Show the project daemon status")
    p = add_command(p, "daemon.stop", "Stop the project daemon")
    p = command_add_positional(p, "daemon.start", "file", "Entry file of the program to serve; the socket stays at the project root")
    p = command_add_option(p, "daemon.start", "--max-entries", "", "Entry files the daemon keeps checked at once, each in a process of its own (default: 8)")
    p = add_command(p, "shim.init", "Scaffold a vendored C shim + @trusted wrapper (§9.1.3)")
    p = command_add_positional(p, "shim.init", "name", "Shim name (lowercase, used as native-dep key and C symbol prefix)")
    p = add_command(p, "query", "Query symbol index (uses daemon if running)")
    p = add_command(p, "doc", "Print module documentation")
    p = add_command(p, "llms", "Print LLM language reference to stdout")
    p = add_command(p, "explain", "Explain an error or warning code")
    p = add_command(p, "lsp", "Start Language Server Protocol server")
    p = command_add_positional(p, "explain", "code", "Error code (e.g. E0500)")

    p = command_add_positional(p, "build", "file", "Source file to compile")
    p = command_add_positional(p, "run", "file", "Source file to build and run")
    p = command_add_positional(p, "check", "file", "Source file to validate")
    p = command_add_positional(p, "query", "file", "Source file to query")
    p = command_add_positional(p, "ast", "file", "Source file to parse")
    p = command_add_flag(p, "ast", "--imports", "-i", "Resolve imports and show merged AST")
    p = command_add_option(p, "ast", "--node", "-n", "Dump subtree for specific node ID")
    p = command_add_positional(p, "fmt", "file", "Source file or directory (default: all source files)")
    p = command_add_positional(p, "test", "file", "Test file or directory (default: discover all)")
    p = command_add_positional(p, "doc", "module", "Module name (e.g. std.args)")
    p = command_add_positional(p, "init", "name", "Project name (default: current directory name)")
    p = command_add_positional(p, "add", "name", "Dependency name")
    p = command_add_positional(p, "remove", "name", "Dependency name to remove")

    p = add_flag(p, "--help", "-h", "Print help")
    p = set_version(p, blink_cli_version)

    p = command_add_flag(p, "build", "--debug", "-d", "Enable debug mode (debug_assert, -g -O0)")
    p = command_add_flag(p, "run", "--debug", "-d", "Enable debug mode (debug_assert, -g -O0)")
    p = command_add_flag(p, "build", "--release", "-R", "Optimized production build (-O2)")
    p = command_add_flag(p, "run", "--release", "-R", "Optimized production build (-O2)")
    p = command_add_flag(p, "build", "--no-cache", "", "Bypass the .o cache for this build")
    p = command_add_flag(p, "run", "--no-cache", "", "Bypass the .o cache for this build")
    p = command_add_flag(p, "build", "--per-module", "", "Compile one C unit per module, in parallel, each cached on its own (the default)")
    p = command_add_flag(p, "run", "--per-module", "", "Compile one C unit per module, in parallel, each cached on its own (the default)")
    p = command_add_option(p, "build", "--jobs", "", "Units a per-module build compiles at once (default: CPU count; env BLINK_JOBS)")
    p = command_add_option(p, "run", "--jobs", "", "Units a per-module build compiles at once (default: CPU count; env BLINK_JOBS)")
    p = command_add_flag(p, "test", "--per-module", "", "Compile one C unit per module, in parallel, each cached on its own (the default)")
    p = command_add_option(p, "test", "--jobs", "", "Units a per-module build compiles at once per test file (default: CPU count; env BLINK_JOBS)")
    p = command_add_flag(p, "build", "--no-per-module", "", "Compile the whole program as one C unit, for bisecting (env BLINK_PER_MODULE=0)")
    p = command_add_flag(p, "run", "--no-per-module", "", "Compile the whole program as one C unit, for bisecting (env BLINK_PER_MODULE=0)")
    p = command_add_flag(p, "test", "--no-per-module", "", "Compile each test program as one C unit, for bisecting (env BLINK_PER_MODULE=0)")
    p = command_add_flag(p, "test", "--no-cache", "", "Bypass the .o cache for the test build")
    p = command_add_flag(p, "build", "--deterministic", "", "Pin map hash seed = 0 (reproducible iteration order)")
    p = command_add_flag(p, "run", "--deterministic", "", "Pin map hash seed = 0 (reproducible iteration order)")

    p = command_add_flag(p, "build", "--json", "-j", "JSON output")
    p = command_add_flag(p, "check", "--json", "-j", "JSON output")
    p = command_add_flag(p, "test", "--json", "-j", "JSON output")
    p = command_add_flag(p, "test", "--verbose", "-v", "Show all test output (default: summary only)")
    p = command_add_flag(p, "test", "--quiet", "-q", "Summary only (suppress individual PASS lines)")
    p = command_add_flag(p, "fmt", "--json", "-j", "JSON output")
    p = command_add_flag(p, "doc", "--json", "-j", "JSON output")
    p = command_add_flag(p, "doc", "--list", "-l", "List available stdlib modules")
    p = command_add_flag(p, "query", "--json", "-j", "JSON output")

    p = command_add_option(p, "build", "--output", "-o", "Output path")
    p = command_add_option(p, "run", "--output", "-o", "Output path")

    p = command_add_option(p, "build", "--target", "-T", "Target triple (e.g. linux, macos-arm64)")
    p = command_add_option(p, "run", "--target", "-T", "Target triple (e.g. linux, macos-arm64)")
    p = command_add_option(p, "build", "--emit", "-e", "Output format: binary (default), c, or per-module-dir (emit one .c/.h per module into <outdir>)")

    p = command_add_option(p, "build", "--format", "-f", "Output format")
    p = command_add_option(p, "check", "--format", "-f", "Output format")
    p = command_add_option(p, "fmt", "--format", "-f", "Output format")

    p = command_add_option(p, "build", "--blink-trace", "", "Trace compiler phase (lex, parse, typecheck, mono, all)")
    p = command_add_option(p, "run", "--blink-trace", "", "Trace compiler phase (lex, parse, typecheck, mono, all)")
    p = command_add_option(p, "check", "--blink-trace", "", "Trace compiler phase (lex, parse, typecheck, mono, all)")
    p = command_add_option(p, "run", "--trace", "", "Runtime execution trace (NDJSON to stderr). Use --trace all or --trace fn:name,module:mod,depth:N")
    p = command_add_option(p, "build", "--trace", "", "Compile with trace instrumentation. Binary accepts --trace[=filter] at runtime")
    p = command_add_option(p, "run", "--trace-limit", "", "Cap trace output to N events")

    p = command_add_flag(p, "llms", "--list", "", "List available topics")
    p = command_add_flag(p, "llms", "--full", "", "Print full reference (default is short summary)")
    p = command_add_option(p, "llms", "--topic", "", "Print a specific topic section")

    p = command_add_flag(p, "build", "--strict", "", "Treat warnings as errors")
    p = command_add_flag(p, "check", "--strict", "", "Treat warnings as errors")
    p = command_add_flag(p, "run", "--strict", "", "Treat warnings as errors")
    p = command_add_flag(p, "build", "--strict-struct-layout", "", "Enforce @ffi.struct layout asserts and header declarations")
    p = command_add_flag(p, "check", "--strict-struct-layout", "", "Enforce @ffi.struct layout asserts and header declarations")
    p = command_add_flag(p, "run", "--strict-struct-layout", "", "Enforce @ffi.struct layout asserts and header declarations")

    p = command_add_flag(p, "fmt", "--check", "-c", "Check formatting without modifying files")

    p = command_add_flag(p, "query", "--pub", "", "Filter to public symbols only")
    p = command_add_flag(p, "query", "--pure", "", "Filter to pure functions")
    p = command_add_option(p, "query", "--layer", "", "Query detail level")
    p = command_add_option(p, "query", "--effect", "", "Filter by effect")
    p = command_add_option(p, "query", "--module", "-m", "Filter by module")
    p = command_add_option(p, "query", "--fn", "", "Look up function by name")

    p = command_add_flag(p, "add", "--dev", "", "Add as dev-dependency")
    p = command_add_option(p, "add", "--path", "", "Path dependency source")
    p = command_add_option(p, "add", "--git", "", "Git dependency source")
    p = command_add_option(p, "add", "--tag", "", "Git tag")

    p = command_add_option(p, "test", "--filter", "", "Test filter pattern")
    p = command_add_option(p, "test", "--tags", "", "Test tags filter")
    p = command_add_option(p, "test", "--parallel", "-P", "Parallel workers (default: 4)")

    p = command_add_option(p, "audit", "--baseline", "", "Audit baseline path")
    p = command_add_flag(p, "audit", "--json", "-j", "JSON output")
    p = command_add_flag(p, "audit", "--ffi", "", "Audit FFI usage in source files")
    p
}

fn main() {
    tune_compiler_gc(env.var("GC_FREE_SPACE_DIVISOR"))
    init_embedded_stdlib()

    // Fine-grained internal trace channels (ast.dbg_trace). Comma-separated
    // channel names, or "all". Empty = off (zero cost). Set once here so every
    // command path (build/run/check + hidden archive/per-module emitters) sees it.
    dbg_channels = env.var("BLINK_TRACE_CHANNELS") ?? ""

    if arg_count() >= 2 && get_arg(1) == "__emit-archive-header" {
        let mut hidden_args: List[Str] = []
        let mut hi = 2
        while hi < arg_count() {
            hidden_args.push(get_arg(hi))
            hi = hi + 1
        }
        cmd_emit_archive_header(hidden_args)
        return
    }

    if arg_count() >= 2 && get_arg(1) == "__emit-per-module" {
        let mut hidden_args: List[Str] = []
        let mut hi = 2
        while hi < arg_count() {
            hidden_args.push(get_arg(hi))
            hi = hi + 1
        }
        cmd_emit_per_module(hidden_args)
        return
    }

    if arg_count() >= 3 && get_arg(1) == "__build-compiler-archive" {
        let mut roots: List[Str] = []
        let mut ri = 3
        while ri < arg_count() {
            roots.push(get_arg(ri))
            ri = ri + 1
        }
        // The compiler archive records the stdlib archive it was built against.
        let arc_rc = ensure_dev_archive()
        if arc_rc != 0 {
            exit(arc_rc)
        }
        let rc = build_compiler_archive(get_arg(2), roots)
        if rc != 0 {
            exit(rc)
        }
        return
    }

    if arg_count() >= 2 && get_arg(1) == "__build-stdlib-archive" {
        let rc = build_stdlib_archive(peeled_module_keys())
        if rc != 0 {
            exit(rc)
        }
        return
    }

    // Pipe-separated record per registered native dep, sourced from the
    // stdlib_native_deps registry. Taskfile install + cross-compile loops
    // consume this so they never hardcode a dep name.
    // Format: name|source_paths(comma)|header_dir|compile_defs(comma)|gate_macro
    if arg_count() >= 2 && get_arg(1) == "__native-deps" {
        let names = stdlib_native_dep_names()
        let mut ni = 0
        while ni < names.len() {
            let n = names.get(ni).unwrap()
            let srcs = stdlib_native_dep_source_paths(n).join(",")
            let hdr = stdlib_native_dep_header_dir(n)
            let defs = stdlib_native_dep_compile_defs(n).join(",")
            let gate = stdlib_native_dep_gate_macro(n)
            io.println("{n}|{srcs}|{hdr}|{defs}|{gate}")
            ni = ni + 1
        }
        return
    }

    if arg_count() >= 2 && get_arg(1) == "cache" {
        let mut sub = ""
        if arg_count() >= 3 {
            sub = get_arg(2)
        }
        if sub == "" || sub == "info" {
            exit(build_objcache.cmd_info())
        }
        if sub == "clean" {
            let mut older = ""
            let mut ai = 3
            while ai < arg_count() {
                let a = get_arg(ai)
                if a == "--older-than" && ai + 1 < arg_count() {
                    older = get_arg(ai + 1)
                    ai = ai + 2
                } else {
                    ai = ai + 1
                }
            }
            exit(build_objcache.cmd_clean(older))
        }
        if sub == "key" {
            let mut text = ""
            if arg_count() >= 4 {
                text = get_arg(3)
            }
            exit(build_objcache.cmd_key(text))
        }
        if sub == "__lookup" && arg_count() >= 4 {
            exit(build_objcache.cmd_internal_lookup(get_arg(3)))
        }
        if sub == "__store" && arg_count() >= 7 {
            exit(build_objcache.cmd_internal_store(get_arg(3), get_arg(4), get_arg(5), get_arg(6)))
        }
        if sub == "__gc" {
            exit(build_objcache.cmd_internal_gc())
        }
        io.println("usage: blink cache <info|clean [--older-than DUR]|key>")
        exit(1)
    }

    let p = cli_parser()

    let a = argparse(p)

    let err = args_error(a)
    if err == "help" || err == "version" {
        return
    }
    if err != "" {
        io.println("error: {err}")
        return
    }

    let command = args_command(a)
    if command == "" {
        io.println(generate_help(p))
        return
    }

    if command == "init" {
        cmd_init(p, a)
    } else if command == "llms" {
        cmd_llms(p, a)
    } else if command == "build" {
        cmd_build(p, a)
    } else if command == "run" {
        cmd_run(p, a)
    } else if command == "test" {
        cmd_test(p, a)
    } else if command == "check" {
        cmd_check(p, a)
    } else if command == "fmt" {
        cmd_fmt(p, a)
    } else if command == "audit" {
        cmd_audit(p, a)
    } else if command == "add" {
        cmd_add(p, a)
    } else if command == "remove" {
        cmd_remove(p, a)
    } else if command == "update" {
        cmd_update(p, a)
    } else if command == "doc" {
        cmd_doc(p, a)
    } else if command == "query" {
        cmd_query(p, a)
    } else if command == "daemon start" {
        cmd_daemon_start(p, a)
    } else if command == "daemon status" {
        cmd_daemon_status(p, a)
    } else if command == "daemon stop" {
        cmd_daemon_stop(p, a)
    } else if command == "daemon" {
        cmd_daemon_bare(p, a)
    } else if command == "shim init" {
        cmd_shim_init(p, a)
    } else if command == "shim" {
        cmd_shim_bare(p, a)
    } else if command == "explain" {
        cmd_explain(p, a)
    } else if command == "ast" {
        cmd_ast(p, a)
    } else if command == "lsp" {
        cmd_lsp(p, a)
    } else {
        io.println("error: unknown command '{command}'")
        io.println(generate_help(p))
    }
}
