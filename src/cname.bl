// The one producer of every C symbol name the compiler emits.
//
// Every name is read from a declaration node or from a type id. No function here
// branches on a type name string or on a CT_ constant: a struct or enum is known by
// its type id, and the module that owns it is read from its declaration node.
//
// Two forms need facts that neither the tid nor the node carries:
//  - a runtime-owned type (declared in lib/std but defined by runtime.h) drops its
//    module prefix;
//  - a transparent newtype spells `int` as a tuple element.
// The owner of that fact marks the declaration through cname_mark_*; this module only
// reads the mark.
//
// A speller that cannot name a type answers an ICE_SEG_* sentinel (diagnostics.bl).
// A sentinel is never interpolated into a longer name: the caller sees it whole, so
// diag_is_ice_seg can still detect it.

import typecheck.{
    TAGPOS_INNER, TAGPOS_SYMBOL, TAGPOS_SYMBOL_INNER, TAGPOS_TOP, TyKind, TypePoolEntry, tc_resolve,
    tc_resolve_transparent_alias_name, tc_tid_decl_node, DECL_NODE_AMBIGUOUS, ty_param_list, ty_pool,
    tc_tid_handler_effect, tc_handler_effect_root, is_user_effect_handle_name,
    sanitize_test_name, tc_enum_has_payload, tc_impl_conv_source,
}
import parser.{
    get_annotation, get_str_named_arg, node_args, node_name, node_source_module,
    node_str_val, node_trait_name, node_type_params, positional_str_arg,
    positional_str_arg_count, sublist_get, sublist_length,
}
import diagnostics.{
    ICE_SEG_AMBIGUOUS_DECL, ICE_SEG_NO_DECL, ICE_SEG_TID_OUT_OF_RANGE, ICE_SEG_UNHANDLED_KIND,
    ICE_SEG_UNSOLVED_TYPEVAR, diag_is_ice_seg,
}

let mut runtime_owned_decls: Map[Int, Int] = Map()
let mut transparent_decls: Map[Int, Int] = Map()
let mut c_mint_seq: Int = 0

// The namespaces this module owns in the emitted C. A user name is moved out of all of them
// by `c_escape_reserved`, which is what lets an escaped name and a minted name be unique.
let C_ESCAPE_PREFIX: Str = "_blink_"
let C_MINTED_PREFIX: Str = "_cg_"
let C_ENSURES_RESULT_STEM: Str = "__ens_rv_"
let C_OLD_SNAPSHOT_STEM: Str = "__old_"

// Runtime C symbols that a user function must not shadow.
let blink_reserved: List[Str] = [
    "list", "map", "set", "bytes", "sb", "closure", "ctx", "task", "threadpool",
    "handle", "channel", "alloc", "strdup", "ProcessResult", "duration_struct",
    "instant_struct",
]

pub fn cname_reset() {
    runtime_owned_decls.clear()
    transparent_decls.clear()
    c_mint_seq = 0
}

// A type declared in lib/std whose C typedef lives in runtime.h keeps the bare
// `blink_<Name>` the runtime declares.
pub fn cname_mark_runtime_owned(td: Int) {
    runtime_owned_decls.insert(td, 1)
}

// The marker asserts the shape (one variant, one Int payload); this module only
// spells the consequence.
pub fn cname_mark_transparent_newtype(td: Int) {
    transparent_decls.insert(td, 1)
}

pub fn cname_is_transparent_newtype(td: Int) -> Bool {
    transparent_decls.contains_key(td) != 0
}

pub fn cname_is_runtime_owned(td: Int) -> Bool {
    runtime_owned_decls.contains_key(td) != 0
}

fn is_reserved(name: Str) -> Bool {
    let mut i = 0
    while i < blink_reserved.len() {
        if blink_reserved.get(i).unwrap() == name { return true }
        i = i + 1
    }
    false
}

// The module segment of a symbol, or "" for the program's own module.
fn named_module(node: Int) -> Str {
    let m = node_source_module(node)
    if m == "__main__" { return "" }
    m
}

fn strip_blink(c_name: Str) -> Str {
    if c_name.starts_with("blink_") { return c_name.slice(6, c_name.len()) }
    c_name
}

// `_` inside a segment becomes `_1` so that `_0` stays the only argument separator.
fn mono_escape(s: Str) -> Str {
    if s.index_of("_") < 0 { return s }
    let mut result = ""
    let mut i = 0
    while i < s.len() {
        if s.byte_at(i) == 95 {
            result = result.concat("_1")
        } else {
            result = result.concat(s.substr(i, 1))
        }
        i = i + 1
    }
    result
}

// ── Functions and globals ────────────────────────────────────────────────────────

// A user function in the program's own module takes `u_` so it cannot collide with a
// runtime export; `main` is the C entry point and stays `blink_main`.
// The foreign symbol an @ffi function binds: the second positional argument of the
// two-argument form `@ffi("library", "symbol")`, the only one of the short form, and
// the Blink name when the annotation names neither. "" when the function is not a
// foreign binding.
pub fn c_ffi_symbol(fn_node: Int) -> Str {
    let ann = get_annotation(fn_node, "ffi")
    if ann == -1 { return "" }
    let args = node_args(ann)
    let count = positional_str_arg_count(args)
    if count >= 2 { return positional_str_arg(args, 1) }
    if count == 1 { return positional_str_arg(args, 0) }
    node_name(fn_node)
}

pub fn c_fn_decl_name(fn_node: Int) -> Str {
    let name = node_name(fn_node)
    if get_annotation(fn_node, "ffi") != -1 { return "blink_{name}" }
    let m = named_module(fn_node)
    if m != "" { return "blink_{m}_{name}" }
    if name != "main" { return "blink_u_{name}" }
    "blink_{name}"
}

// A top-level `let` is a C global, and it carries its module the same way a function
// does. The bare Blink name cannot be the C name: it would sit in the translation unit's
// global namespace next to everything C already owns, so a global named after a libc
// macro stops the unit compiling, and two modules' same-named private globals would be
// one symbol defined twice.
pub fn c_global_name(let_node: Int) -> Str {
    let name = node_name(let_node)
    let m = named_module(let_node)
    if m != "" { return "blink_{m}_{name}" }
    "blink_u_{name}"
}

// The C function one test block becomes. Nothing outside the unit refers to it: the
// runner reaches it through a pointer in the table, and the name a filter or a tag
// selector matches is the test's own string, which the table row carries beside the
// pointer. So the symbol has to be a legal C identifier, distinct per test, and distinct
// from every name the runtime's own header spells.
//
// The runtime is what fixes the second underscore. Its header defines `blink_test_run`
// and `blink_test_entry` with one underscore and everything else with two leading ones,
// so a name under `blink_test__` can collide with none of them. A test named `run` would
// otherwise redefine the runner the table is handed to.
//
// Distinct per test is the one this cannot promise. The sanitizer drops the bytes a C
// identifier cannot hold, so two test names that differ only in those bytes arrive here
// the same and the unit defines one symbol twice. The spec makes a duplicate test name a
// compile error; until that check exists, nothing upstream of this rules the pair out.
//
// The sanitizer is typecheck's, not a second copy. Typecheck already turns the test's
// string into the name it reports the body under, and a body reported under one spelling
// and emitted under another is two answers to one question.
pub fn c_test_fn_name(tb: Int) -> Str {
    "blink_test__{sanitize_test_name(node_str_val(tb))}"
}

// The identifier-safe stem of a function: what a mono instance name embeds. The module
// rides it for the same reason it rides a type's stem — two modules may declare the same
// generic name, and one C symbol cannot stand for both instances. No `u_` guard, unlike
// c_fn_decl_name: every mono name carries at least one `_0` argument segment, which no
// runtime export spells.
fn c_fn_decl_tag(fn_node: Int) -> Str {
    let m = named_module(fn_node)
    if m != "" { return "{m}_{node_name(fn_node)}" }
    node_name(fn_node)
}

// A mono instance of a generic function. `args_tid` is the interned tuple of the
// concrete type arguments; its slots are spelled at TOP position.
pub fn c_mono_fn_name(fn_node: Int, args_tid: Int) -> Str {
    let stem = tuple_stem(c_fn_decl_tag(fn_node), args_tid)
    if diag_is_ice_seg(stem) { return stem }
    "blink_{stem}"
}

// A mono instance of a poly-impl method (`impl[T] Tr for List[T]`): the impl's own
// stem is the base, and the element slots follow like any other instance. A poly
// conversion impl has no dispatch path yet, so its source does not ride the stem.
pub fn c_poly_method_name(im: Int, mname: Str, args_tid: Int) -> Str {
    let stem = tuple_stem(impl_stem(im, node_trait_name(im), mname, -1), args_tid)
    if diag_is_ice_seg(stem) { return stem }
    impl_symbol(im, stem)
}

// The stem of a mono FUNCTION symbol. Its arguments are spelled at the symbol position:
// the name has to name one definition, and the argument list is the only thing that tells
// two instances of one declaration apart.
fn tuple_stem(base: Str, args_tid: Int) -> Str {
    let tid = tc_resolve(args_tid)
    if tid < 0 || tid >= ty_pool.len() { return ICE_SEG_TID_OUT_OF_RANGE }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Tuple { return ICE_SEG_UNHANDLED_KIND }
    mono_stem(base, t.params_start, t.params_count, TAGPOS_SYMBOL)
}

// ── Types ────────────────────────────────────────────────────────────────────────

fn opaque_c_name(td: Int) -> Str {
    let ann = get_annotation(td, "ffi.opaque")
    if ann == -1 { return "" }
    get_str_named_arg(ann, "name")
}

// An @ffi.struct type is a Blink mirror of a C struct that a foreign header declares.
// The mirror and the original are distinct types to C, so a value crossing to a foreign
// function that the real header declared is spelled as the original.
pub fn cname_ffi_struct_mirror(td: Int) -> Bool {
    td >= 0 && get_annotation(td, "ffi.struct") != -1
}

// The C original a mirror names, or "" when it names none. A mirror with no name has no
// spelling here: guessing one writes a type the foreign header never declared.
pub fn c_ffi_struct_original(td: Int) -> Str {
    if !cname_ffi_struct_mirror(td) { return "" }
    let n = get_str_named_arg(get_annotation(td, "ffi.struct"), "name")
    if n == "" { return "" }
    "struct {n}"
}

pub fn c_ffi_struct_ptr_name(td: Int) -> Str {
    let original = c_ffi_struct_original(td)
    if original == "" { return "" }
    "{original}*"
}

// An @ffi.opaque type is the foreign incomplete type itself, as a pointer.
pub fn c_type_decl_name(td: Int) -> Str {
    let name = node_name(td)
    let oc = opaque_c_name(td)
    if oc != "" { return "{oc}*" }
    if runtime_owned_decls.contains_key(td) != 0 { return "blink_{name}" }
    let m = named_module(td)
    if m != "" { return "blink_{m}_{name}" }
    "blink_{name}"
}

// The identifier-safe stem of a type: what a carrier or a mono name embeds. An opaque
// type's C name holds `*`, so its stem is the Blink name.
pub fn c_type_decl_tag(td: Int) -> Str {
    if opaque_c_name(td) != "" { return node_name(td) }
    strip_blink(c_type_decl_name(td))
}

// An opaque type's C name is a pointer, so the stem answers here instead. The prefix the
// stem strips goes back on, which keeps every non-opaque symbol byte-identical.
pub fn c_derive_method_name(td: Int, method: Str) -> Str {
    "blink_{c_type_decl_tag(td)}_{method}"
}

// The same two methods for a key that has no declaration to be named from. A tuple is
// structural, which is the whole reason the derive walk cannot reach it, so the typedef
// name is the stem instead. The table these fill is spelled from the same typedef name,
// so the symbol and its table agree by construction rather than by two readers agreeing.
pub fn c_tid_derive_method_name(tid: Int, method: Str) -> Str {
    let name = c_typedef_name(tid)
    if diag_is_ice_seg(name) { return name }
    "{name}_{method}"
}

// The walker that copies a value of this type out of an arena. The symbol segment keeps
// element types, so `List[Int]` and `List[Str]` get two walkers with two bodies.
pub fn c_promote_walker_name(tid: Int) -> Str {
    let s = spellable(seg_at(tid, TAGPOS_SYMBOL))
    if diag_is_ice_seg(s) { return s }
    "blink_promote_{s}"
}

// The function `==` calls for a type with no equality method of its own: a container, a
// tuple, or an enum that derives nothing. The name keeps element types, so `List[Int]` and
// `List[Str]` get two bodies, and its prefix keeps it apart from a tuple key's derived eq.
pub fn c_values_eq_name(tid: Int) -> Str {
    let s = spellable(seg_at(tid, TAGPOS_SYMBOL))
    if diag_is_ice_seg(s) { return s }
    "blink_eq_{s}"
}

// A closure's walker is per signature (§5.2.1 clause 7): every closure of one type is
// copied by the same walk over its own capture descriptors.
pub fn c_promote_closure_walker_name(tid: Int) -> Str {
    let s = spellable(seg_at(tid, TAGPOS_SYMBOL))
    if diag_is_ice_seg(s) { return s }
    "blink_promote_closure_{s}"
}

// The two per-type entries a capture descriptor names: one moves a capture word that holds
// the value or its box, the other fills a copied `let mut` cell.
pub fn c_capture_word_walker_name(tid: Int) -> Str {
    let s = spellable(seg_at(tid, TAGPOS_SYMBOL))
    if diag_is_ice_seg(s) { return s }
    "blink_capture_word_{s}"
}

pub fn c_capture_cell_fill_name(tid: Int) -> Str {
    let s = spellable(seg_at(tid, TAGPOS_SYMBOL))
    if diag_is_ice_seg(s) { return s }
    "blink_capture_cell_{s}"
}

// One closure literal's capture descriptor table, named after the thunk it describes.
pub fn c_capture_table_name(closure_symbol: Str) -> Str { "{closure_symbol}_descs" }

// A generic declaration has one body per instance, so its derived methods take the
// instance's typedef name. The derive writer and every call site ask here, so the symbol
// a body defines and the symbol a call names cannot drift apart.
pub fn c_derived_method_symbol(tid: Int, method: Str) -> Str {
    let r = tc_resolve(tid)
    let td = tc_tid_decl_node(r)
    if td == DECL_NODE_AMBIGUOUS { return ICE_SEG_AMBIGUOUS_DECL }
    if td < 0 { return ICE_SEG_NO_DECL }
    let tps = node_type_params(td)
    if tps != -1 && sublist_length(tps) > 0 { return c_tid_derive_method_name(r, method) }
    c_derive_method_name(td, method)
}

// A variant's discriminant, in the spelling its own typedef declares. Two facts decide
// it and neither is the caller's to hold. A payload-less enum is emitted as a C enum, so
// its variants are enumerators and no macro is declared beside them; one payload variant
// makes the whole type a tagged union, which declares the macro instead. And a generic
// enum's tags belong to the instance, because two instances declare two typedefs.
// Both questions are answered here, so a reader cannot spell a name the emitter never
// wrote, and the emitter cannot write one no reader asks for.
pub fn c_variant_discriminant(enum_tid: Int, variant: Int) -> Str {
    let owner = c_mono_type_c_name(enum_tid)
    if diag_is_ice_seg(owner) { return owner }
    let stem = "{owner}_{node_name(variant)}"
    if tc_enum_has_payload(enum_tid) { return "{stem}_TAG" }
    stem
}

// The union member a payload variant fills: `.data.Circle`. The typedef names the member
// after the variant, so the same namer must spell both the declaration and every literal.
pub fn c_variant_member_name(variant: Int) -> Str { node_name(variant) }

// The two fixed members of a tagged-enum typedef. The variant name picks one arm of the
// union; these name the union itself and the discriminant beside it. Every reader of a
// tagged enum spells the same two words, so they are written once here.
pub fn c_enum_tag_member() -> Str { "tag" }

pub fn c_enum_payload_member() -> Str { "data" }

// The member a tuple slot fills: `._0`. The typedef declares the members and every read of
// a slot names one, so both sides spell it here. A slot name that drifted on one side would
// be caught by cc only where the two slots differ in width; two same-width neighbours would
// swap and the program would answer the wrong element.
pub fn c_tuple_member(i: Int) -> Str { "_{i}" }

// The declaration node behind a struct or enum tid; -1 for any other kind.
pub fn c_decl_for_tid(tid: Int) -> Int {
    tc_tid_decl_node(tid)
}

// ── Impl methods ─────────────────────────────────────────────────────────────────

// From/TryFrom are one trait with many source-typed impls, so the source type, not
// the trait, keeps their symbols apart. The source is spelled whole, as a mono slot is:
// its head alone names List[Int] and List[Str] alike.
fn impl_stem(im: Int, trait_name: Str, mname: Str, source_tid: Int) -> Str {
    let impl_type = node_name(im)
    if (trait_name == "From" || trait_name == "TryFrom") && source_tid >= 0 {
        let seg = spellable(seg_at(source_tid, TAGPOS_SYMBOL))
        if diag_is_ice_seg(seg) { return seg }
        return "{impl_type}_{mname}_{mono_escape(seg)}"
    }
    "{impl_type}_{trait_name}_{mname}"
}

// An impl method takes the module of the impl block, not of the type it extends.
fn impl_symbol(im: Int, stem: Str) -> Str {
    let m = named_module(im)
    if m != "" { return "blink_{m}_{stem}" }
    if is_reserved(stem) { return "blink_u_{stem}" }
    "blink_{stem}"
}

pub fn c_impl_method_name(im: Int, mname: Str) -> Str {
    let stem = impl_stem(im, node_trait_name(im), mname, tc_impl_conv_source(im))
    if diag_is_ice_seg(stem) { return stem }
    impl_symbol(im, stem)
}

// The trait-qualified form for a caller that already resolved the trait.
pub fn c_impl_method_name_q(im: Int, trait_name: Str, mname: Str) -> Str {
    impl_symbol(im, "{node_name(im)}_{trait_name}_{mname}")
}

// The sealed dispatcher the compiler synthesizes next to a user `Display.fmt`.
pub fn c_display_dispatch_name(im: Int) -> Str {
    c_impl_method_name_q(im, "Display", "display")
}

// ── Mono instances and carriers ──────────────────────────────────────────────────

// THE mono-name producer: escaped base, then `_0` + escaped TOP segment per slot.
// Both a fn instance (slots in a tuple tid) and a struct/enum instance (slots in the
// instance tid) read their arguments from ty_param_list, so both come here.
fn mono_stem(base: Str, args_start: Int, args_count: Int, tagpos: Int) -> Str {
    let mut result = mono_escape(base)
    let mut i = 0
    while i < args_count {
        let seg = spellable(seg_at(ty_param_list.get(args_start + i).unwrap(), tagpos))
        if diag_is_ice_seg(seg) { return seg }
        result = result.concat("_0").concat(mono_escape(seg))
        i = i + 1
    }
    result
}

// The mono stem of a struct/enum INSTANCE tid, or "" for a bare (non-instance) type.
fn struct_instance_stem(t: TypePoolEntry, tid: Int, tagpos: Int) -> Str {
    if t.params_count == 0 { return "" }
    let td = tc_tid_decl_node(tid)
    if td == DECL_NODE_AMBIGUOUS { return ICE_SEG_AMBIGUOUS_DECL }
    if td < 0 { return ICE_SEG_NO_DECL }
    mono_stem(c_type_decl_tag(td), t.params_start, t.params_count, tagpos)
}

fn struct_c_name(t: TypePoolEntry, tid: Int) -> Str {
    let stem = struct_instance_stem(t, tid, TAGPOS_TOP)
    if diag_is_ice_seg(stem) { return stem }
    if stem != "" { return "blink_{stem}" }
    let td = tc_tid_decl_node(tid)
    if td < 0 { return ICE_SEG_NO_DECL }
    c_type_decl_name(td)
}

// The C name of a struct or enum instance tid (`blink_Box_0Int`).
pub fn c_mono_type_c_name(inst_tid: Int) -> Str {
    let tid = tc_resolve(inst_tid)
    if tid < 0 || tid >= ty_pool.len() { return ICE_SEG_TID_OUT_OF_RANGE }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Struct && t.kind != TyKind.Enum { return ICE_SEG_UNHANDLED_KIND }
    struct_c_name(t, tid)
}

// The typedef name of any type that gets its own C struct: a struct or enum (bare or
// instance), an Option or Result carrier, or a tuple.
pub fn c_typedef_name(tid0: Int) -> Str {
    let tid = tc_resolve(tid0)
    if tid < 0 || tid >= ty_pool.len() { return ICE_SEG_TID_OUT_OF_RANGE }
    let t = ty_pool.get(tid).unwrap()
    let k = t.kind
    if k == TyKind.Struct || k == TyKind.Enum { return struct_c_name(t, tid) }
    if k == TyKind.Option || k == TyKind.Result || k == TyKind.Tuple {
        let tag = spellable(seg_at(tid, TAGPOS_TOP))
        if diag_is_ice_seg(tag) { return tag }
        return "blink_{tag}"
    }
    ICE_SEG_UNHANDLED_KIND
}

// A segment may carry `<tv>` for an unsubstituted type parameter: a fine answer for a
// diagnostic, never a C identifier. A name producer refuses it as an ICE segment
// instead of interpolating it.
fn spellable(seg: Str) -> Str {
    if seg.contains("<") { return ICE_SEG_UNSOLVED_TYPEVAR }
    seg
}

// A type spelled as a mono argument (`Int`, `Box_0Int`, `Option_int`).
pub fn c_seg_top(tid: Int) -> Str {
    seg_at(tid, TAGPOS_TOP)
}

// A type spelled inside a carrier (`int`, `mymod_Ngx`, `Option_int`).
pub fn c_seg_inner(tid: Int) -> Str {
    seg_at(tid, TAGPOS_INNER)
}

fn seg_at(tid0: Int, tagpos: Int) -> Str {
    let tid = tc_resolve(tid0)
    if tid < 0 || tid >= ty_pool.len() { return ICE_SEG_TID_OUT_OF_RANGE }
    let t = ty_pool.get(tid).unwrap()
    let k = t.kind
    let sub = child_pos(tagpos)
    if k == TyKind.Struct || k == TyKind.Enum { return struct_seg(t, tid, tagpos) }
    if k == TyKind.Option {
        let inner = seg_at(t.inner1, sub)
        if diag_is_ice_seg(inner) { return inner }
        return "Option_{inner}"
    }
    if k == TyKind.Result {
        let ok = seg_at(t.inner1, sub)
        if diag_is_ice_seg(ok) { return ok }
        let err = seg_at(t.inner2, sub)
        if diag_is_ice_seg(err) { return err }
        return "Result_{ok}_{err}"
    }
    if k == TyKind.Tuple { return tuple_tag(t, tagpos) }
    if k == TyKind.Fn && tagpos == TAGPOS_SYMBOL { return fn_tag(t, tagpos) }
    if k == TyKind.Handler && keeps_elements(tagpos) { return handler_tag(t, tid, tagpos) }
    if k == TyKind.Template && keeps_elements(tagpos) { return template_tag(t, tagpos) }
    if k == TyKind.Typevar { return "<tv>" }
    // One blink_map* serves every key/value pair, so K and V do not ride the name. They
    // are still walked so an unsolved slot fails closed instead of spelling "map".
    if k == TyKind.Map {
        let key = seg_at(t.inner1, sub)
        if diag_is_ice_seg(key) { return key }
        let val = seg_at(t.inner2, sub)
        if diag_is_ice_seg(val) { return val }
        if !keeps_elements(tagpos) { return map_base(tagpos) }
        return "{map_base(tagpos)}_{key}_{val}"
    }
    let base = if top_cased(tagpos) { scalar_top(k) } else { scalar_inner(k) }
    if diag_is_ice_seg(base) { return base }
    if !keeps_elements(tagpos) || !erases_its_element(k) { return base }
    let elem = seg_at(t.inner1, sub)
    if diag_is_ice_seg(elem) { return elem }
    "{base}_{elem}"
}

// The position a compound's children are spelled at. The two existing positions keep
// their asymmetry, where TOP is the outermost tag and everything under it is INNER. A
// symbol keeps its width all the way down, because a Map nested inside a List is exactly
// the pair of instances the outer erasure would merge, so the rule cannot stop at depth
// one -- but it drops to the inner CASE at depth one, the same as TOP does.
fn child_pos(tagpos: Int) -> Int {
    if keeps_elements(tagpos) { return TAGPOS_SYMBOL_INNER }
    TAGPOS_INNER
}

// Whether this position spells the element an erased container loses in its C type. Only
// a symbol does. One blink_list* serves every element, which is a saving a TYPE name is
// entitled to and a symbol is not: the symbol IS the definition, so two instances that
// spell one name are one function defined twice and the unit stops compiling.
fn keeps_elements(tagpos: Int) -> Bool {
    tagpos == TAGPOS_SYMBOL || tagpos == TAGPOS_SYMBOL_INNER
}

// Whether this position spells a scalar capitalised. Case belongs to the DEPTH, not to
// what the name is being built for, so the two symbol positions borrow it from the two
// they mirror. This is what keeps every name that already exists spelled as it is.
fn top_cased(tagpos: Int) -> Bool {
    tagpos == TAGPOS_TOP || tagpos == TAGPOS_SYMBOL
}

fn map_base(tagpos: Int) -> Str {
    if top_cased(tagpos) { return "Map" }
    "map"
}

// The kinds that hold one element type and lose it in the C type. Each is one C shape
// for every element, which is what TOP is entitled to drop and a symbol is not.
fn erases_its_element(k: TyKind) -> Bool {
    if k == TyKind.List || k == TyKind.Set || k == TyKind.Iterator { return true }
    k == TyKind.Channel || k == TyKind.Handle || k == TyKind.Ptr
}

// The position a nominal instance spells its own mono arguments at. That stem has always
// been built at TOP -- `Box[Int]` is `Box_0Int` wherever the tag appears -- so the
// position the tag itself sits in must not reach the arguments. A symbol is the one
// exception, and it reaches them at full width whatever depth the tag sits at, because a
// `Holder[Map[Str, Int]]` argument is the same collision one level in and the stem is the
// only place the instance can be told apart.
fn mono_pos(tagpos: Int) -> Int {
    if keeps_elements(tagpos) { return TAGPOS_SYMBOL }
    TAGPOS_TOP
}

// A bare struct spells its full tag, and an instance its mono stem, at BOTH positions.
// The position a type lands in says where the name is being built, not which type it is,
// so a struct that drops its module at TOP and keeps it inside a carrier gives two answers
// to one question and lets two modules' namesakes share a symbol.
fn struct_seg(t: TypePoolEntry, tid: Int, tagpos: Int) -> Str {
    let stem = struct_instance_stem(t, tid, mono_pos(tagpos))
    if stem != "" { return stem }
    let underlying = tc_resolve_transparent_alias_name(t.name)
    if underlying != -1 { return seg_at(underlying, tagpos) }
    let td = tc_tid_decl_node(tid)
    if td == DECL_NODE_AMBIGUOUS { return ICE_SEG_AMBIGUOUS_DECL }
    if td < 0 { return ICE_SEG_NO_DECL }
    c_type_decl_tag(td)
}

// A transparent newtype element lowers to a bare int64_t, so the tuple names it
// `int`. Result and Option keep its nominal tag, so this stays tuple-only.
fn tuple_tag(t: TypePoolEntry, tagpos: Int) -> Str {
    let mut tag = "Tuple{t.params_count}"
    let mut i = 0
    while i < t.params_count {
        let elem_tid = ty_param_list.get(t.params_start + i).unwrap()
        let raw = seg_at(elem_tid, child_pos(tagpos))
        if diag_is_ice_seg(raw) { return raw }
        let elem = if elem_is_transparent(elem_tid) { "int" } else { raw }
        tag = tag.concat("_").concat(elem)
        i = i + 1
    }
    tag
}

// A closure walker is per signature (§5.2.1 clause 7). A fn-typed parameter or return
// keeps its own signature too, where the inner position would spell every closure
// `closure` and let two signatures share one walker name.
fn fn_tag(t: TypePoolEntry, tagpos: Int) -> Str {
    let mut tag = "Fn{t.params_count}"
    let mut i = 0
    while i < t.params_count {
        let p = fn_child_seg(ty_param_list.get(t.params_start + i).unwrap(), tagpos)
        if diag_is_ice_seg(p) { return p }
        tag = tag.concat("_").concat(p)
        i = i + 1
    }
    let ret = fn_child_seg(t.inner1, tagpos)
    if diag_is_ice_seg(ret) { return ret }
    tag.concat("_").concat(ret)
}

// Each effect's handler is its own C vtable type, so a symbol keeps the effect. The whole
// name rides it, not the root: Handler[IO.Log] and Handler[IO.Print] are two tids, so two
// mono instances, and one root would name both. Each dotted part is escaped before the
// join, so an effect spelled `A_B` and a sub-effect `A.B` stay apart.
fn handler_tag(t: TypePoolEntry, tid: Int, tagpos: Int) -> Str {
    let root = effect_root_of(tid)
    if diag_is_ice_seg(root) { return root }
    let base = if top_cased(tagpos) { "Handler" } else { "handler" }
    "{base}_{effect_path_seg(t.name)}"
}

fn effect_path_seg(name: Str) -> Str {
    let mut seg = ""
    for part in name.split(".") {
        let esc = mono_escape(part)
        seg = if seg == "" { esc } else { "{seg}_{esc}" }
    }
    seg
}

// One blink_template* serves every context, but Template[DB] and Template[Shell] are two
// tids, so two mono instances, and a symbol must tell them apart. The spec's contexts are
// effect names, which resolve to a typevar of that name, so the name is what rides.
fn template_tag(t: TypePoolEntry, tagpos: Int) -> Str {
    let base = if top_cased(tagpos) { "Template" } else { "template" }
    let ctx = tc_resolve(t.inner1)
    if ctx < 0 || ctx >= ty_pool.len() { return ICE_SEG_TID_OUT_OF_RANGE }
    let c = ty_pool.get(ctx).unwrap()
    if c.kind == TyKind.Typevar && c.name != "" { return "{base}_{effect_path_seg(c.name)}" }
    let inner = seg_at(ctx, child_pos(tagpos))
    if diag_is_ice_seg(inner) { return inner }
    "{base}_{inner}"
}

fn fn_child_seg(tid0: Int, tagpos: Int) -> Str {
    let tid = tc_resolve(tid0)
    if tid < 0 || tid >= ty_pool.len() { return ICE_SEG_TID_OUT_OF_RANGE }
    let t = ty_pool.get(tid).unwrap()
    if t.kind == TyKind.Fn { return fn_tag(t, tagpos) }
    seg_at(tid, child_pos(tagpos))
}

fn elem_is_transparent(tid: Int) -> Bool {
    let td = tc_tid_decl_node(tid)
    if td < 0 { return false }
    transparent_decls.contains_key(td) != 0
}

// Exhaustive matches: a TyKind added without a spelling fails to compile here
// instead of falling through to a sentinel at run time. The structural kinds
// (Struct, Enum, Option, Result, Tuple, Map, Typevar) never reach these two
// functions because seg_at answers them first.
fn scalar_top(k: TyKind) -> Str {
    match k {
        TyKind.Int => "Int"
        TyKind.Float => "Float"
        TyKind.Bool => "Bool"
        TyKind.Str => "Str"
        TyKind.List => "List"
        TyKind.Iterator => "Iterator"
        TyKind.Handle => "Handle"
        TyKind.Channel => "Channel"
        TyKind.Ptr => "Ptr"
        TyKind.Handler => "Handler"
        TyKind.Set => "Set"
        TyKind.Bytes => "Bytes"
        TyKind.StringBuilder => "StringBuilder"
        TyKind.I8 => "I8"
        TyKind.I16 => "I16"
        TyKind.I32 => "I32"
        TyKind.U8 => "U8"
        TyKind.U16 => "U16"
        TyKind.U32 => "U32"
        TyKind.U64 => "U64"
        TyKind.Char => "Char"
        TyKind.Void => "Void"
        TyKind.Unknown => ICE_SEG_UNSOLVED_TYPEVAR
        // A fn type at TOP would drop its signature and merge two instances into
        // one symbol, so it is refused here. seg_at spells it at SYMBOL with its
        // signature, and inside a carrier as one closure member.
        TyKind.Fn => ICE_SEG_UNHANDLED_KIND
        TyKind.Never => ICE_SEG_UNHANDLED_KIND
        TyKind.Template => ICE_SEG_UNHANDLED_KIND
        // A `Raw[T]` is consumed by the template coercion in typecheck and never reaches a
        // mono instance argument, so a sighting here is a front-end leak, not a name to mint.
        TyKind.Raw => ICE_SEG_UNHANDLED_KIND
        TyKind.FfiScope => ICE_SEG_UNHANDLED_KIND
        TyKind.Struct => ICE_SEG_UNHANDLED_KIND
        TyKind.Enum => ICE_SEG_UNHANDLED_KIND
        TyKind.Option => ICE_SEG_UNHANDLED_KIND
        TyKind.Result => ICE_SEG_UNHANDLED_KIND
        TyKind.Tuple => ICE_SEG_UNHANDLED_KIND
        TyKind.Map => ICE_SEG_UNHANDLED_KIND
        TyKind.Typevar => ICE_SEG_UNHANDLED_KIND
    }
}

fn scalar_inner(k: TyKind) -> Str {
    match k {
        TyKind.Int => "int"
        TyKind.Float => "double"
        TyKind.Bool => "bool"
        TyKind.Str => "str"
        TyKind.List => "list"
        TyKind.Iterator => "iter"
        TyKind.Handle => "handle"
        TyKind.Channel => "channel"
        TyKind.Ptr => "ptr"
        TyKind.Handler => "handler"
        // Every closure is one blink_closure* member, so the signature does not
        // ride the name.
        TyKind.Fn => "closure"
        TyKind.Set => "set"
        TyKind.Bytes => "bytes"
        TyKind.StringBuilder => "stringbuilder"
        TyKind.I8 => "i8"
        TyKind.I16 => "i16"
        TyKind.I32 => "i32"
        TyKind.U8 => "u8"
        TyKind.U16 => "u16"
        TyKind.U32 => "u32"
        TyKind.U64 => "u64"
        TyKind.Char => "char"
        TyKind.Void => "void"
        // One blink_template* member serves every context C, so C does not ride the name.
        TyKind.Template => "template"
        TyKind.Raw => ICE_SEG_UNHANDLED_KIND
        TyKind.Unknown => ICE_SEG_UNSOLVED_TYPEVAR
        TyKind.Never => ICE_SEG_UNHANDLED_KIND
        TyKind.FfiScope => ICE_SEG_UNHANDLED_KIND
        TyKind.Struct => ICE_SEG_UNHANDLED_KIND
        TyKind.Enum => ICE_SEG_UNHANDLED_KIND
        TyKind.Option => ICE_SEG_UNHANDLED_KIND
        TyKind.Result => ICE_SEG_UNHANDLED_KIND
        TyKind.Tuple => ICE_SEG_UNHANDLED_KIND
        TyKind.Map => ICE_SEG_UNHANDLED_KIND
        TyKind.Typevar => ICE_SEG_UNHANDLED_KIND
    }
}

// ── Runtime symbols keyed on a tid ───────────────────────────────────────────────

// The builtin effects, each in the blink_ev slot it owns, written in the order the
// struct declares them. Prefix compatibility is what that order buys: the archive is
// compiled against a shorter blink_ev than the user unit sees, so a builtin field can
// never move and none can be dropped. Nothing here reads the index yet — the stage that
// emits the struct is still to come, and it must walk this list in order. Both names
// below come off this one list, so a ninth builtin effect is one line rather than two
// tables to keep level.
let builtin_effect_roots: List[Str] = ["IO", "FS", "Net", "Crypto", "Rand", "Time", "Env", "Process"]

fn is_builtin_effect_root(root: Str) -> Bool {
    let mut i = 0
    while i < builtin_effect_roots.len() {
        if builtin_effect_roots.get(i).unwrap() == root { return true }
        i = i + 1
    }
    false
}

// The root effect a handler tid installs for. A sub-effect shares its root's slot and a
// full-size vtable, so the sub-effect rides neither name.
//
// Only a root that dispatches through the effect vector has a slot at all. `Arena` is a
// Handler type and is NOT one: the spec makes it a marker effect that escape analysis
// consumes, so it owns no field and no vtable. Neither does a root nobody declared. Both
// answer an ICE segment, because inventing `ue_arena` would name a field that no
// translation unit defines.
//
// Reading the declared handles makes both names below depend on the program under
// compilation, not on the tid alone: typecheck clears that list per program, so the same
// tid harvested from an earlier program answers an ICE segment afterwards.
fn effect_root_of(handler_tid: Int) -> Str {
    let tid = tc_resolve(handler_tid)
    if tid < 0 || tid >= ty_pool.len() { return ICE_SEG_TID_OUT_OF_RANGE }
    if ty_pool.get(tid).unwrap().kind != TyKind.Handler { return ICE_SEG_UNHANDLED_KIND }
    let root = tc_handler_effect_root(tc_tid_handler_effect(tid))
    if root == "" { return ICE_SEG_UNSOLVED_TYPEVAR }
    if is_builtin_effect_root(root) { return root }
    if is_user_effect_handle_name(root.to_lower()) == 0 { return ICE_SEG_UNHANDLED_KIND }
    root
}

// The vtable struct of a Handler tid. The eight builtin effects have runtime-declared
// vtables; a user effect gets `blink_ue_<root>_vtable`.
pub fn c_vtable_type_name(handler_tid: Int) -> Str {
    let root = effect_root_of(handler_tid)
    if diag_is_ice_seg(root) { return root }
    if is_builtin_effect_root(root) { return "blink_{root.to_lower()}_vtable" }
    "blink_ue_{root.to_lower()}_vtable"
}

// The runtime function that promotes a builtin root's vtable. The runtime declares that
// struct, so it owns the walker too, under the struct. A user root's vtable is emitted by
// this compiler, which builds its walker instead, so it has no runtime promoter.
pub fn c_vtable_promoter_name(handler_tid: Int) -> Str {
    let root = effect_root_of(handler_tid)
    if diag_is_ice_seg(root) { return root }
    if !is_builtin_effect_root(root) { return ICE_SEG_UNHANDLED_KIND }
    "{c_vtable_type_name(handler_tid)}_promote"
}

// The blink_ev field a handler install writes for a Handler tid. A builtin effect names
// its own root; a user effect sits behind `ue_`, which is what stops an effect spelled
// `Io` from taking the builtin `io` slot. Two USER effects whose names differ only in
// case still collide here, because the handle typecheck registers is already lowered.
pub fn c_ev_field_name(handler_tid: Int) -> Str {
    let root = effect_root_of(handler_tid)
    if diag_is_ice_seg(root) { return root }
    if is_builtin_effect_root(root) { return root.to_lower() }
    "ue_{root.to_lower()}"
}

// The body a vtable slot points at until a handler overwrites it. The name carries the root
// and the operation, which is what keeps two operations of different sub-effects apart in the
// one vtable their root owns.
//
// A builtin effect's vtable and its defaults belong to the runtime. Spelling one here would
// define a second body under a name the runtime already owns, so a builtin root answers an
// ICE segment instead.
pub fn c_effect_default_op_name(handler_tid: Int, op: Str) -> Str {
    let root = effect_root_of(handler_tid)
    if diag_is_ice_seg(root) { return root }
    if is_builtin_effect_root(root) { return ICE_SEG_UNHANDLED_KIND }
    "blink_ue_{root.to_lower()}_default_{c_field_name(op)}"
}

// The vtable member one operation of a handler writes, and the member a perform of a user
// effect reads back.
//
// Who owns the spelling decides the answer. A builtin root's vtable is a hand-written
// struct in the runtime header, so the runtime owns every member of it and the operation
// names its member verbatim: escaping `log` to `_blink_log` names a member
// `blink_io_vtable` does not declare, and C rejects the assignment. A user effect's vtable
// is emitted by this compiler, so its members are C names this compiler owns and they take
// the escaping every other field name takes.
//
// This is a spelling and not a lookup: it does not ask whether the operation is an
// operation of the effect. A builtin root that the handler writes an unknown operation for
// still answers that name, and C reports the unknown member.
pub fn c_effect_vtable_slot_name(handler_tid: Int, op: Str) -> Str {
    let root = effect_root_of(handler_tid)
    if diag_is_ice_seg(root) { return root }
    if is_builtin_effect_root(root) { return op }
    c_field_name(op)
}

// The vtable member beside a slot that holds the operation's closure, the word its body
// reads its captures from. The runtime header spells the builtin vtables' members the
// same way, so this takes the slot as C spells it and adds no escaping of its own.
pub fn c_vtable_userdata_member(slot: Str) -> Str {
    "__userdata_{slot}"
}

// The key-operations table a Map or Set keyed on this tid binds at construction. A
// builtin scalar has a runtime table; a struct or enum has `kops_<its C name>`, which
// codegen_derive emits for a @derive(Hash) type. Whether that derive exists is the
// caller's question; this only spells the symbol.
pub fn c_kops_table_name(key_tid: Int) -> Str {
    let tid = tc_resolve(key_tid)
    if tid < 0 || tid >= ty_pool.len() { return ICE_SEG_TID_OUT_OF_RANGE }
    let k = ty_pool.get(tid).unwrap().kind
    if k == TyKind.Struct || k == TyKind.Enum {
        // An opaque handle's C name is a pointer: no identifier can stem from it, and
        // no Hash can be derived for a type with no fields, so there is no table.
        let td = tc_tid_decl_node(tid)
        if td >= 0 && opaque_c_name(td) != "" { return ICE_SEG_UNHANDLED_KIND }
    }
    if k == TyKind.Struct || k == TyKind.Enum || k == TyKind.Tuple {
        let cn = c_typedef_name(tid)
        if diag_is_ice_seg(cn) { return cn }
        return "kops_{cn}"
    }
    match k {
        TyKind.Int => "blink_kops_i64"
        TyKind.Str => "blink_kops_str"
        TyKind.Bool => "blink_kops_bool"
        TyKind.Char => "blink_kops_char"
        TyKind.I8 => "blink_kops_i8"
        TyKind.I16 => "blink_kops_i16"
        TyKind.I32 => "blink_kops_i32"
        TyKind.U8 => "blink_kops_u8"
        TyKind.U16 => "blink_kops_u16"
        TyKind.U32 => "blink_kops_u32"
        TyKind.U64 => "blink_kops_u64"
        TyKind.Void => "blink_kops_unit"
        _ => ICE_SEG_UNHANDLED_KIND
    }
}

// ── Names carried over from Blink ────────────────────────────────────────────────

// A Blink local keeps its own spelling in C unless the escape has to move it.
pub fn c_local_name(name: Str) -> Str { c_escape_reserved(name) }

// The pointer a shared mutable binding is stored through. It is a name of its own,
// because the frame declares the pointer while the source name still spells the value.
// The minted namespace is what keeps it from colliding with a local the program named:
// `c_escape_reserved` moves a user name out of that namespace, so no Blink source can
// reach this spelling. It carries no counter, so the frame, the capture word and the
// thunk's prologue each derive the same name from the same source name.
pub fn c_cell_name(name: Str) -> Str { "{C_MINTED_PREFIX}cell_{c_local_name(name)}" }

// A struct field keeps its Blink spelling too. It is a separate producer from the local
// name because the struct emitter and every field reader must agree on one answer even
// if the two rules ever diverge.
pub fn c_field_name(name: Str) -> Str { c_escape_reserved(name) }

// A local no Blink source named: the temp an expression is materialised into, the holder
// a destructure binds through, the bound a loop tests against. Every stage mints from
// this one counter, so a name is unique across the whole unit rather than within the
// stage that asked for it; two stages with two counters would eventually hand back one
// identifier for two different values. The stem only tells a reader of the C what the
// temp was for.
//
// The prefix does not make a minted name safe on its own, because a program can write
// the same spelling. It is safe because `c_escape_reserved` reserves the namespace and
// moves a user name out of it.
pub fn c_mint_local(stem: Str) -> Str {
    c_mint_seq = c_mint_seq + 1
    "{C_MINTED_PREFIX}{stem}{c_mint_seq}"
}

// The temp an @ensures check reads the returned value from, and the entry snapshot of one
// `old(e)`. They keep these spellings, outside the minted namespace, because they are what
// a reader of the C looks for; c_escape_reserved reserves both stems as it does the minted one.
pub fn c_ensures_result_name() -> Str {
    c_mint_seq = c_mint_seq + 1
    "{C_ENSURES_RESULT_STEM}{c_mint_seq}"
}

pub fn c_old_snapshot_name() -> Str {
    c_mint_seq = c_mint_seq + 1
    "{C_OLD_SNAPSHOT_STEM}{c_mint_seq}"
}

// A user name that C or libc already owns cannot keep its spelling, so it gets the
// `_blink_` prefix. A user name already inside one of the two prefixed namespaces has to
// move as well, or the escape is not injective: an underscore starts a legal Blink
// identifier, so a program may write `_blink_int` or `_cg_tmp1`, and left alone the first
// lands on the answer for `int` and the second on a minted temp. Prefixing those too
// keeps every answer distinct, because an escaped name always carries the prefix and a
// name that keeps its spelling never does.
fn c_escape_reserved(name: Str) -> Str {
    let owned = c_reserved_words().contains_key(name) != 0
    let prefixed = name.starts_with(C_ESCAPE_PREFIX) || name.starts_with(C_MINTED_PREFIX) ||
        name.starts_with(C_ENSURES_RESULT_STEM) || name.starts_with(C_OLD_SNAPSHOT_STEM)
    if owned || prefixed { return "{C_ESCAPE_PREFIX}{name}" }
    name
}

let mut c_reserved_cache: Map[Str, Int] = Map()

fn c_reserved_words() -> Map[Str, Int] {
    if c_reserved_cache.len() > 0 { return c_reserved_cache }
    let words = "auto break case char const continue default do double else enum extern float for goto if inline int long register restrict return short signed sizeof static struct switch typedef union unsigned void volatile while asm typeof _Bool _Complex _Imaginary _Alignas _Alignof _Atomic _Generic _Noreturn _Static_assert _Thread_local errno stdin stdout stderr printf fprintf sprintf snprintf scanf malloc calloc realloc free exit abort strlen strcmp strcpy strcat memcpy memset memmove memcmp strncmp strncpy strncat strstr strchr strdup strtok fopen fclose fread fwrite atoi atof strtol strtod getenv system qsort read write open close sleep fork pipe socket bind listen accept connect send recv time clock log round NULL main true false"
    let parts = words.split(" ")
    let mut i = 0
    while i < parts.len() {
        c_reserved_cache.insert(parts.get(i).unwrap(), 1)
        i = i + 1
    }
    c_reserved_cache
}

// ── Literal tokens ───────────────────────────────────────────────────────────────

fn c_octal3(b: Int) -> Str {
    "\\{b / 64}{(b / 8) % 8}{b % 8}"
}

// The C token for a string constant, quotes included. Escaping a string is a C lexical
// question, so it is answered once here rather than at each place that needs a literal.
// A byte above ASCII passes through as itself: the source is UTF-8 and so is the C file,
// so a multi-byte character stays intact.
pub fn c_string_literal(value: Str) -> Str {
    let mut sb = StringBuilder.new()
    sb.write("\"")
    let mut i = 0
    while i < value.len() {
        let b = value.byte_at(i)
        if b == 92 {
            sb.write("\\\\")
        } else if b == 34 {
            sb.write("\\\"")
        } else if b == 10 {
            sb.write("\\n")
        } else if b == 13 {
            sb.write("\\r")
        } else if b == 9 {
            sb.write("\\t")
        } else if b == 8 {
            sb.write("\\b")
        } else if b == 12 {
            sb.write("\\f")
        } else if b == 63 {
            sb.write("\\?")
        } else if b < 32 || b == 127 {
            // A control byte written raw would be a control character in the C source. The
            // escape is three digits wide so a digit that follows cannot extend it.
            sb.write(c_octal3(b))
        } else {
            sb.write(value.substring(i, 1))
        }
        i = i + 1
    }
    sb.write("\"")
    sb.to_str()
}

// ── Runtime helpers ──────────────────────────────────────────────────────────────

// The runtime constructor a container literal of this tid calls. Only the three
// runtime containers have one; every other kind answers a sentinel.
pub fn c_container_ctor(container_tid: Int) -> Str {
    let tid = tc_resolve(container_tid)
    if tid < 0 || tid >= ty_pool.len() { return ICE_SEG_TID_OUT_OF_RANGE }
    match ty_pool.get(tid).unwrap().kind {
        TyKind.List => "blink_list_new"
        TyKind.Map => "blink_map_new"
        TyKind.Set => "blink_set_new"
        _ => ICE_SEG_UNHANDLED_KIND
    }
}

// A runtime support function named by its operation. The `blink_` prefix is this
// module's to add, so no caller writes a runtime symbol of its own.
pub fn c_runtime_helper(op: Str) -> Str {
    if op == "" { return ICE_SEG_UNHANDLED_KIND }
    "blink_".concat(op)
}

// The checked-arithmetic builtin for an operator. GCC and Clang both declare these, they
// compute into a caller-supplied result and answer whether the value fitted it, and the
// range they check is the range of that result, so one call serves every width. The
// compiler declares them, so the spellings are fixed; they live here because every C name
// has one producer. An operator with no checked builtin answers an ICE segment: only
// addition, subtraction and multiplication can leave the range of their operands.
pub fn c_overflow_builtin(op: Str) -> Str {
    match op {
        "+" => "__builtin_add_overflow"
        "-" => "__builtin_sub_overflow"
        "*" => "__builtin_mul_overflow"
        _ => ICE_SEG_UNHANDLED_KIND
    }
}

// The least value of a signed type, as <stdint.h> names it. A decimal spelling of the
// 64-bit one is not a C constant at all: its magnitude is one past the largest signed
// literal. An unsigned type has no negative range, so it answers an ICE segment.
pub fn c_int_min_macro(k: TyKind) -> Str {
    match k {
        TyKind.I8 => "INT8_MIN"
        TyKind.I16 => "INT16_MIN"
        TyKind.I32 => "INT32_MIN"
        TyKind.Int => "INT64_MIN"
        _ => ICE_SEG_UNHANDLED_KIND
    }
}

// The evidence vector the whole program threads. There is exactly one of these types,
// so the name is fixed; it lives here because every C name has one producer.
pub fn c_ev_type_name() -> Str {
    "blink_ev"
}

// The vector an effectful C function receives as its trailing parameter.
pub fn c_ev_param_name() -> Str {
    "__ev"
}

// The program's one vector instance: what a handler install writes and what a function
// with no vector parameter reads.
pub fn c_ev_global_name() -> Str {
    "__blink_ev"
}

// The program's one thread pool instance: what the main shim starts and what every
// async.spawn submits through. One name, so the declaration and every submit site agree.
pub fn c_pool_global() -> Str {
    "__blink_pool"
}

// The runtime vtable slot a builtin effect operation reaches, keyed by the name a caller
// writes. The runtime declares blink_io_vtable and blink_env_vtable under different
// member names than the source spells (`println` reaches `print`, the slot that appends the newline,
// `exit` is `exit_fn` because libc owns `exit`), so this table is the one place the two
// spellings meet. A pair the runtime has no slot for answers an ICE segment: the raw
// print ops and the other builtin effects are not dispatched through a vtable member.
pub fn c_builtin_effect_slot(ns: Str, op: Str) -> Str {
    if ns == "io" {
        return match op {
            "println" => "print"
            "print" => "print_no_nl"
            "eprintln" => "eprint"
            "eprint" => "eprint_no_nl"
            "log" => "log"
            _ => ICE_SEG_UNHANDLED_KIND
        }
    }
    if ns == "env" {
        return match op {
            "var" => "read"
            "set_var" => "write"
            "remove_var" => "remove"
            "cwd" => "cwd"
            "exit" => "exit_fn"
            _ => ICE_SEG_UNHANDLED_KIND
        }
    }
    // blink_time_vtable's two members are already spelled the way the source writes them.
    if ns == "time" {
        return match op {
            "read" => "read"
            "sleep" => "sleep"
            _ => ICE_SEG_UNHANDLED_KIND
        }
    }
    ICE_SEG_UNHANDLED_KIND
}

// The runtime function a test body's `?` calls to record its failure. The runtime declares
// it, so the spelling is fixed. It lives here because every C name has one producer.
pub fn c_test_propagate_name() -> Str {
    "__blink_test_set_propagate"
}

// The four fail-path helpers the assert family lowers a guarded call to. The runtime
// declares them, so the spellings are fixed; they live here because every C name has
// one producer.
pub fn c_assert_fail_name() -> Str {
    "__blink_assert_fail"
}

pub fn c_assert_fail_eq_name() -> Str {
    "__blink_assert_fail_eq"
}

pub fn c_assert_fail_intro_name() -> Str {
    "__blink_assert_fail_intro"
}

pub fn c_debug_assert_fail_name() -> Str {
    "__blink_debug_assert_fail"
}

// ── Typedef guards ───────────────────────────────────────────────────────────────

// The include guard of the stdlib archive's public header. A user unit includes it, so
// the name is part of the archive's interface and does not change.
pub fn c_archive_header_guard() -> Str {
    "BLINK_LIBBLINK_STD_H"
}

// The include guard of one module's header in the per-module build.
pub fn c_module_header_guard(module_key: Str) -> Str {
    "BLINK_MOD_{module_key}_H"
}

// The per-module deferred-init function a module with a non-const global initializer
// defines; the entry unit calls it, in cg_reg_modules order, before main/test dispatch.
pub fn c_module_init_globals_name(module_key: Str) -> Str {
    "__blink_init_globals_{module_key}"
}

pub fn td_guard_name(c_name: Str) -> Str {
    "BLINK_TD_{c_name}"
}

pub fn td_guard_open_lines(c_name: Str) -> List[Str] {
    let guard = td_guard_name(c_name)
    ["#ifndef {guard}", "#define {guard}"]
}

pub fn td_guard_close_line() -> Str {
    "#endif"
}
