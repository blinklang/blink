// The class digits of src/cname.bl. They live apart from cname.bl so that the test helpers
// can read them without importing the compiler.
//
// Every global this compiler makes from a Blink name is `blink_`, one class digit, and the
// name. The runtime's own globals are `blink_` and a letter, and a Blink identifier never
// starts with a digit, so no compiler name can be a runtime name, and no two classes can
// make one string. The digit is the whole guard: no Blink name has to stay off any list.
// tests/test_no_runtime_name_takes_a_class_digit.bl holds the runtime to its side.
pub let C_CLASS_MAIN_VALUE: Str = "2"
pub let C_CLASS_MODULE_VALUE: Str = "3"
pub let C_CLASS_MAIN_TYPE: Str = "4"
pub let C_CLASS_MODULE_TYPE: Str = "5"
pub let C_CLASS_MAIN_IMPL: Str = "6"
pub let C_CLASS_MODULE_IMPL: Str = "7"
pub let C_CLASS_DERIVED: Str = "8"
pub let C_CLASS_TYPE_HELPER: Str = "9"
