// codegen.bl — Code generation orchestrator
//
// Imports codegen_types (state, registries, helpers),
// codegen_expr (expression/closure emission), and
// codegen_stmt (statement/function/type emission).
// This file contains only generate() — the top-level entry point.

// Detect the canonical builtin poly form `impl[T] Trait[T] for List[T]` (impl
// binders + a parameterized builtin List receiver) and register each of its
// methods under the trait-qualified composed base so the deferred mono pass can
// instantiate them per concrete T. Non-poly impls and unsupported poly shapes
// (Map/Set receivers, user generic-struct receivers) are skipped — they keep
// their existing single-symbol eager path (or are rejected at typecheck).
fn register_poly_impl_methods(im: Int, impl_trait: Str, impl_type: Str) {
    if impl_type != "List" { return }
    let binders_sl = node_impl_binders(im)
    let recv_args_sl = node_recv_type_args(im)
    if binders_sl == -1 || recv_args_sl == -1 { return }
    // Mirror the typecheck E0908 gate exactly: exactly one binder, a List
    // receiver with exactly one type arg, and that arg IS the binder. Codegen
    // maps the single binder to the List element type, so anything looser would
    // mis-monomorphize (and typecheck would have rejected it with E0908 anyway).
    if sublist_length(binders_sl) != 1 || sublist_length(recv_args_sl) != 1 { return }
    let binder_name = node_name(sublist_get(binders_sl, 0))
    if binder_name == "" || node_name(sublist_get(recv_args_sl, 0)) != binder_name { return }
    let methods_sl = node_methods(im)
    if methods_sl == -1 { return }
    let mut j = 0
    while j < sublist_length(methods_sl) {
        let m = sublist_get(methods_sl, j)
        let composed = mangle_impl_method_q(impl_type, impl_trait, node_name(m))
        poly_impl_method_node.insert(composed, m)
        poly_impl_block_node.insert(composed, im)
        j = j + 1
    }
}

fn collect_ann_type_names(ann: Int, out: List[Str]) {
    if ann == -1 { return }
    let n = node_name(ann)
    if n != "" { out.push(n) }
    let elems = node_elements(ann)
    if elems != -1 {
        let mut i = 0
        while i < sublist_length(elems) {
            collect_ann_type_names(sublist_get(elems, i), out)
            i = i + 1
        }
    }
}

fn collect_type_deps(td: Int, out: List[Str]) {
    let flds_sl = node_fields(td)
    if flds_sl == -1 { return }
    let mut i = 0
    while i < sublist_length(flds_sl) {
        let f = sublist_get(flds_sl, i)
        if node_kind(f) == NodeKind.TypeVariant {
            let vflds = node_fields(f)
            if vflds != -1 {
                let mut vi = 0
                while vi < sublist_length(vflds) {
                    let vf = sublist_get(vflds, vi)
                    collect_ann_type_names(node_value(vf), out)
                    vi = vi + 1
                }
            }
        } else {
            collect_ann_type_names(node_value(f), out)
        }
        i = i + 1
    }
}

// Cycles (e.g., self-references stored as int64_t) are broken by skipping
// already-in-progress nodes, preserving stable order.
fn topo_sort_type_indices(types_sl: Int) -> List[Int] {
    let mut name_to_idx: Map[Str, Int] = Map()
    let n = sublist_length(types_sl)
    let mut i = 0
    while i < n {
        let td = sublist_get(types_sl, i)
        let nm = node_name(td)
        if name_to_idx.contains_key(nm) == 0 {
            name_to_idx.insert(nm, i)
        }
        i = i + 1
    }
    let mut visited: Map[Int, Int] = Map()
    let mut in_progress: Map[Int, Int] = Map()
    let mut order: List[Int] = []
    i = 0
    while i < n {
        topo_visit(i, types_sl, name_to_idx, visited, in_progress, order)
        i = i + 1
    }
    order
}

fn topo_visit(idx: Int, types_sl: Int, name_to_idx: Map[Str, Int],
              visited: Map[Int, Int], in_progress: Map[Int, Int],
              order: List[Int]) {
    if visited.contains_key(idx) { return }
    if in_progress.contains_key(idx) { return }
    in_progress.insert(idx, 1)
    let td = sublist_get(types_sl, idx)
    let mut deps: List[Str] = []
    collect_type_deps(td, deps)
    let mut di = 0
    while di < deps.len() {
        let dep_name = deps.get(di).unwrap()
        if name_to_idx.contains_key(dep_name) {
            let dep_idx = name_to_idx.get(dep_name).unwrap()
            if dep_idx != idx {
                topo_visit(dep_idx, types_sl, name_to_idx, visited, in_progress, order)
            }
        }
        di = di + 1
    }
    visited.insert(idx, 1)
    order.push(idx)
}

// Emit mono fn bodies from `start_idx` to a temp buffer, flush any tuple/
// option/result typedefs registered during emission (mono fn bodies can
// register new types — e.g. a List[(Str, T)].get() in a generic body only
// yields Option[Tuple2_str_T] once T is substituted), then append the
// bodies. Without this, typedefs land after the bodies that reference them.
fn owned_by_other_module(module_name: Str) -> Bool {
    cg_emit_only_module != "" && module_name != cg_emit_only_module
}

fn skip_module(module_name: Str) -> Bool {
    if owned_by_other_module(module_name) {
        return true
    }
    cg_skip_modules.contains_key(module_name)
}

// A stdlib fn must live in the user TU (not the shared archive) when
// its body touches program-specific evidence: declared effects (`! IO`,
// `! DB`, …) or a Handler[...] return (handler ctors read __blink_ev).
// FFI shims carry `! FFI` but are pure C wrappers, so stay in the archive.
fn fn_is_archive_excluded(fn_node: Int) -> Bool {
    if has_annotation(fn_node, "ffi") != 0 { return false }
    if fn_node_has_effects(fn_node) != 0 { return true }
    node_return_type(fn_node).starts_with("Handler[")
}

fn prepend_extern_range(start_idx: Int) {
    let mut k = start_idx
    while k < cg_lines.len() {
        let line = cg_lines.get(k).unwrap()
        if line != "" {
            cg_lines.set(k, "extern {line}")
        }
        k = k + 1
    }
}

fn prepend_extern_one(idx: Int) {
    if idx < cg_lines.len() {
        let line = cg_lines.get(idx).unwrap()
        if line != "" {
            cg_lines.set(idx, "extern {line}")
        }
    }
}

// Register the struct-instance carrier typedef for every struct-typed param in a
// param list (free fn or impl method) so it precedes the fn/method forward decl.
// A non-struct param, or a param whose annotation has no memoized instance tid
// (bare/typevar), registers nothing (register_struct_instance_from_tid → "").
// Both registrars live in codegen_stmt so the body-local let path can share them.
fn register_struct_instance_params(params_sl: Int) ! Codegen.Register {
    if params_sl == -1 { return }
    let mut i = 0
    while i < sublist_length(params_sl) {
        let p = sublist_get(params_sl, i)
        let ptid = tc_lookup_node_tid(node_type_ann(p))
        if is_struct_type(node_type_name(p)) != 0 {
            register_struct_instance_from_tid(ptid)
        } else if is_enum_type(node_type_name(p)) != 0 {
            // A generic-enum INSTANCE param (`t: Tree[Int]`) registers its mono
            // instance here so the blink_Tree_Int typedef precedes the fn forward
            // decl that names it — the enum twin of the struct branch.
            register_enum_instance_from_tid(ptid)
        } else {
            // A carrier PARAM over struct instances (`x: Result[RBox[Int],..]`)
            // names blink_RBox_Int by value in its typedef; register that leaf
            // here too, symmetric to the return path.
            register_carrier_struct_instance_leaves(ptid)
        }
        i = i + 1
    }
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn flush_mono_fns_with_typedefs(start_idx: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let pre_option_count = emitted_option_types.len()
    let pre_result_count = emitted_result_types.len()
    let pre_s_option_count = emitted_struct_option_types.len()
    let pre_s_result_count = emitted_struct_result_types.len()
    let pre_tuple_count = emitted_tuple_entries.len()
    let pre_closure_count = cg_closure_defs.len()
    // A mono Set/Map ctor over a tuple/struct key (e.g. `seed[T]` instantiated as
    // Set[(Int,Str)]) registers that key into derive_hash_types only while its
    // body is emitted here — after the main emit_derive_forward_decls /
    // emit_kops_adapters_late passes ran, and (for the pre-body flush) before the
    // test-block pre-count is captured. Its `kops_<cn>` extern decl + adapter def
    // are then never emitted, so the body references an undeclared symbol.
    // Capture the pre-flush hash high-water mark; emit the delta's decls+defs
    // below, positioned before the bodies (same discipline as the mono typedefs).
    let pre_derive_counts = derive_counts_now()
    // A generic-struct/enum INSTANCE first constructed inside a mono body
    // (`fn wrap[T]() { let e: GT[Int] = GT { s: Set() } }`) is registered here, after
    // emit_all_mono_typedefs already ran — so its typedef was never emitted at all
    // and the body referenced an undeclared blink_GT_Int.
    let pre_mono_td_count = mono_instances.len()
    // A `for x in xs` / `for i in 0..n` loop first discovered inside a mono body
    // registers into these iterator registries only while the body is emitted
    // below — after emit_all_iter_types() (the only top-level pass that would
    // have drained them) already ran. Mirrors the test-block flush's own
    // snapshot+drain shape exactly (codegen.bl:2035-2054, :2131-2137).
    let pre_iter_count = emitted_iter_types.len()
    let pre_map_iter_count = emitted_map_iters.len()
    let pre_filter_iter_count = emitted_filter_iters.len()
    let pre_take_iter_count = emitted_take_iters.len()
    let pre_skip_iter_count = emitted_skip_iters.len()
    let pre_chain_iter_count = emitted_chain_iters.len()
    let pre_flat_map_iter_count = emitted_flat_map_iters.len()
    let pre_map_iter_c_count = emitted_map_iters_c.len()
    let pre_filter_iter_c_count = emitted_filter_iters_c.len()
    let pre_take_iter_c_count = emitted_take_iters_c.len()
    let pre_skip_iter_c_count = emitted_skip_iters_c.len()
    let pre_chain_iter_c_count = emitted_chain_iters_c.len()
    let pre_flat_map_iter_c_count = emitted_flat_map_iters_c.len()
    let pre_range_iter = emitted_range_iter
    let pre_str_iter = emitted_str_iter
    let pre_lines = cg_lines
    cg_lines = []

    // emit_mono_fns_from re-reads mono_fns.len() each iteration, so monos
    // discovered transitively during body emission are emitted in this same
    // pass. After it returns, mono_fns holds the pass's full closure.
    emit_mono_fns_from(start_idx)
    let mono_end = mono_fns.len()
    let body_lines = cg_lines
    cg_lines = pre_lines

    // Ahead of the carriers: an Option/Result carrier over a mono instance names it by
    // value, so the instance's own typedef must precede the carrier's (the same
    // dependency ordering emit_all_mono_typedefs relies on at the top level).
    emit_mono_typedefs_from(pre_mono_td_count)
    emit_tuple_types_from(pre_tuple_count)
    emit_option_result_types_from(pre_option_count, pre_result_count, pre_s_option_count, pre_s_result_count)
    // After Option/Result: emit_list_iter_typedef's `_next` return type names
    // option_c_type(inner), so the Option carrier's typedef must precede it.
    emit_iter_types_from(pre_iter_count, pre_map_iter_count, pre_filter_iter_count, pre_take_iter_count, pre_skip_iter_count, pre_chain_iter_count, pre_flat_map_iter_count, pre_map_iter_c_count, pre_filter_iter_c_count, pre_take_iter_c_count, pre_skip_iter_c_count, pre_chain_iter_c_count, pre_flat_map_iter_c_count)
    if emitted_range_iter != 0 && pre_range_iter == 0 {
        emit_range_iter_typedef()
    }
    if emitted_str_iter != 0 && pre_str_iter == 0 {
        emit_str_iter_typedef()
    }

    // kops adapter tables + derive fn defs for hash/derive types first seen in
    // this flush's bodies (tuple/struct Set/Map keys). Emitted before the bodies
    // so the extern decl and definition precede the referencing mono fn.
    emit_derive_fn_defs_from(pre_derive_counts)
    emit_kops_forward_decls_from(pre_derive_counts.hash)
    emit_kops_adapters_from(pre_derive_counts.hash)

    // Closeable cleanup-state typedefs registered while emitting mono bodies
    // must precede the bodies that reference them.
    let mut ci = pre_closure_count
    while ci < cg_closure_defs.len() {
        cg_lines.push(cg_closure_defs.get(ci).unwrap())
        ci = ci + 1
    }

    // Forward decls for every mono in the pass's closure, so a mono calling
    // another mono sees a declaration before the callsite.
    emit_mono_fn_decls_range(start_idx, mono_end)

    let mut i = 0
    while i < body_lines.len() {
        cg_lines.push(body_lines.get(i).unwrap())
        i = i + 1
    }
}

// A field/variant-payload of type Option[ADT]/Result[ADT,_]/Tuple lowers to a
// carrier typedef embedded BY VALUE in the owning struct/enum typedef, so the
// carrier must precede its owner. ensure_compound_type_from_ann only queues the
// carrier; the catch-all flush runs after the whole type-emit loop — too late.
// Register the carriers from the DECLARED annotations here and flush just the
// newly-queued ones, before the owner is emitted (idempotent dedup makes the
// later catch-all flush a no-op). Callers pass their own gathered annotations.
fn preflush_field_carrier_typedefs(anns: List[Int]) ! Codegen.Emit {
    let pre_opt = emitted_option_types.len()
    let pre_res = emitted_result_types.len()
    let pre_struct_opt = emitted_struct_option_types.len()
    let pre_struct_res = emitted_struct_result_types.len()
    let pre_tuple = emitted_tuple_entries.len()
    let mut i = 0
    while i < anns.len() {
        let fann = anns.get(i).unwrap()
        if fann != -1 {
            ensure_compound_type_from_ann(fann)
            if node_name(fann) == "Tuple" {
                let _tup = resolve_tuple_ann(fann, -1, [])
            }
        }
        i = i + 1
    }
    emit_option_result_types_from(pre_opt, pre_res, pre_struct_opt, pre_struct_res)
    emit_tuple_types_from(pre_tuple)
}

// ── Top-level: generate ─────────────────────────────────────────────

@allow(UnrestoredMutation, IncompleteStateRestore)
pub fn generate(program: Int) -> Str ! Codegen, Diag.Report {
    if trace_mode != "" { trace("codegen", "start") }
    cg_program_node = program

    // A program carrying test blocks is a test build: panic sites lower to the
    // thread-local catch dispatch and the generated C #defines BLINK_TEST_BUILD.
    // The stdlib archive never has test blocks, so this stays 0 there, keeping
    // the archive + non-test user TUs byte-identical (assert_panics zero-cost).
    let __cg_tests_sl = node_captures(program)
    cg_test_mode = if __cg_tests_sl != -1 && sublist_length(__cg_tests_sl) > 0 { 1 } else { 0 }

    // Tripwire for state leaked from a previous generate() call when
    // generate() runs more than once per process. Stripped in release.
    debug_assert(cg_lines.len() == 0, "cg_lines not reset")
    debug_assert(cg_indent == 0, "cg_indent not reset")
    debug_assert(cg_temp_counter == 0, "cg_temp_counter not reset")
    debug_assert(cg_closure_counter == 0, "cg_closure_counter not reset")
    debug_assert(cg_assert_panics_counter == 0, "cg_assert_panics_counter not reset")
    debug_assert(cg_async_wrapper_counter == 0, "cg_async_wrapper_counter not reset")
    debug_assert(cg_async_scope_counter == 0, "cg_async_scope_counter not reset")
    debug_assert(cg_ev_restore_emitted == 0, "cg_ev_restore_emitted not reset")
    debug_assert(cg_arena_helper_emitted == 0, "cg_arena_helper_emitted not reset")
    debug_assert(emitted_range_iter == 0, "emitted_range_iter not reset")
    debug_assert(cg_uses_async == 0, "cg_uses_async not reset")
    debug_assert(cg_used_native_deps.len() == 0, "cg_used_native_deps not reset")
    debug_assert(scope_vars.len() == 0, "scope_vars not reset")
    debug_assert(scope_frame_starts.len() == 0, "scope_frame_starts not reset")

    // Emission-mode tripwire. cg_user_tu_mode, cg_archive_build_mode, and
    // cg_archive_header_mode are mutually exclusive. cg_emit_only_module
    // composes with archive header mode (per-module .h via
    // generate_module_header) and may also be set standalone for per-module
    // .c emission via generate_module_object — but cg_skip_modules is only
    // consumed by user-TU and archive-build paths.
    let __emit_modes = (if cg_archive_header_mode != 0 { 1 } else { 0 }) + (if cg_archive_build_mode != 0 { 1 } else { 0 }) + (if cg_user_tu_mode != 0 { 1 } else { 0 })
    debug_assert(__emit_modes <= 1, "multiple cg emission-mode flags set simultaneously")
    if __emit_modes == 0 && cg_emit_only_module == "" {
        debug_assert(cg_skip_modules.len() == 0, "cg_skip_modules leaked into non-archive generate()")
    }

    // Reset state
    cg_lines.clear()
    cg_indent = 0
    cg_temp_counter = 0
    reset_scope_state()
    fn_regs.clear()
    fn_regs_idx.clear()
    ffi_fn_set.clear()
    fn_ret_handlers.clear()
    fn_ret_handlers_idx.clear()
    fn_ret_structs.clear()
    fn_ret_structs_idx.clear()
    fn_ret_types.clear()
    fn_ret_types_idx.clear()
    effect_entries.clear()
    cg_current_fn_name = ""
    cg_current_fn_ret = 0
    cg_current_fn_node = -1
    cg_current_module = ""
    cg_current_fn_option_inner = 0
    cg_global_inits.clear()
    struct_reg_names.clear()
    struct_reg_set.clear()
    enum_regs.clear()
    enum_reg_set.clear()
    enum_str_backed_set.clear()
    enum_variants.clear()
    enum_variant_name_idx.clear()
    enum_variant_full_idx.clear()
    var_enums.clear()
    var_enum_frame_starts.clear()
    fn_enum_rets.clear()
    emitted_let_names.clear()
    emitted_let_set.clear()
    cg_module_global_set.clear()
    emitted_fn_names.clear()
    emitted_fn_set.clear()
    fn_reg_set.clear()
    trait_entries.clear()
    impl_entries.clear()
    impl_method_idx.clear()
    assoc_type_bindings.clear()
    from_entries.clear()
    tryfrom_entries.clear()
    sf_entries.clear()
    sf_entries_idx.clear()
    struct_field_defaults.clear()
    struct_invariants.clear()
    sf_closure_sigs.clear()
    derive_serialize_types.clear()
    derive_deserialize_types.clear()
    display_impl_types.clear()
    derive_eq_types.clear()
    derive_ord_types.clear()
    derive_clone_types.clear()
    derive_hash_types.clear()
    derive_hash_generic_bases.clear()
    derive_eq_generic_bases.clear()
    derive_method_entries.clear()
    deser_externs_emitted = 0
    promote_types.clear()
    promote_emitted.clear()
    promote_fwd_emitted = 0
    debug_types.clear()
    debug_emitted.clear()
    debug_fwd_emitted = 0
    mono_instances.clear()
    mono_idx.clear()
    poly_impl_method_node.clear()
    poly_impl_block_node.clear()
    cg_closure_defs.clear()
    cg_closure_promoter_defs.clear()
    cg_closure_counter = 0
    cg_assert_panics_counter = 0
    cg_fn_shim_emitted.clear()
    cg_bh_cleanup_set.clear()
    cg_cl_cleanup_set.clear()
    cg_ev_restore_emitted = 0
    cg_arena_helper_emitted = 0
    cg_ffi_libs.clear()
    cg_ffi_lib_set.clear()
    generic_fns.clear()
    generic_fns_by_name.clear()
    reset_fn_node_registry()
    reset_closure_codegen_state()
    mono_fns.clear()
    mono_arg_tid_conflicts = 0
    mono_arg_tid_arity_conflicts = 0
    mono_cname_collisions = 0
    mono_slot_conflicts = []
    mono_slot_conflicts_same_type = 0
    mono_slot_conflicts_diff_type = 0
    mono_slot_conflicts_diff_type_injective = 0
    mono_fn_decl_tid_drift = 0
    mono_fn_decl_seg_drift = 0
    emitted_option_types.clear()
    emitted_option_set.clear()
    option_typedef_emitted.clear()
    // emit_*_typedef both emits C and registers field/variant metadata
    // into sf_entries/enum_variants. Stale dedup entries from a prior
    // generate() call would skip both — breaking method resolution.
    reset_typedef_emitted_stmt()
    reset_result_typedef_emitted()
    ensure_option_type(CT_INT)
    ensure_option_type(CT_STRING)
    emitted_result_types.clear()
    emitted_result_set.clear()
    emitted_struct_option_types.clear()
    emitted_struct_result_types.clear()
    fn_ret_struct_inners.clear()
    fn_ret_struct_inners_idx.clear()
    emitted_iter_types.clear()
    emitted_iter_set.clear()
    emitted_range_iter = 0
    emitted_str_iter = 0
    emitted_map_iters.clear()
    emitted_filter_iters.clear()
    emitted_take_iters.clear()
    emitted_skip_iters.clear()
    emitted_chain_iters.clear()
    emitted_flat_map_iters.clear()
    emitted_map_iters_c.clear()
    emitted_filter_iters_c.clear()
    emitted_take_iters_c.clear()
    emitted_skip_iters_c.clear()
    emitted_chain_iters_c.clear()
    emitted_flat_map_iters_c.clear()
    emitted_tuple_set.clear()
    emitted_tuple_entries.clear()
    cg_let_target_type = 0
    cg_let_target_name = ""
    cg_handler_vtable_type = ""
    cg_handler_vtable_field = ""
    cg_handler_is_user_effect = 0
    cg_in_handler_body = 0
    cg_handler_body_vtable_type = ""
    cg_handler_body_field = ""
    cg_handler_body_is_ue = 0
    cg_handler_body_idx = 0
    cg_uses_async = 0
    cg_used_native_deps = Map()
    cg_async_wrapper_counter = 0
    cg_async_scope_stack.clear()
    cg_async_scope_counter = 0
    ue_effects.clear()
    ue_methods.clear()

    push_scope()

    // Register builtins
    reg_fn("arg_count", CT_INT)
    reg_fn("get_arg", CT_STRING)
    reg_fn("read_file", CT_STRING)
    reg_fn("write_file", CT_VOID)
    reg_fn("list_dir", CT_LIST)
    reg_fn_ret_type("list_dir", CT_LIST, CT_STRING, -1)
    reg_fn("fs_remove", CT_VOID)
    reg_fn("file_exists", CT_INT)
    reg_fn("shell_exec", CT_INT)
    reg_fn("exit", CT_VOID)
    reg_fn("is_dir", CT_INT)

    reg_fn("time_ms", CT_INT)
    reg_fn("unix_socket_listen", CT_INT)
    reg_fn("unix_socket_connect", CT_INT)
    reg_fn("unix_socket_accept", CT_INT)
    reg_fn("unix_socket_accept_timeout", CT_INT)
    reg_fn("unix_socket_close", CT_VOID)
    reg_fn("socket_read_line", CT_STRING)
    reg_fn("socket_write", CT_VOID)
    reg_fn("file_mtime", CT_INT)
    reg_fn("getpid", CT_INT)
    reg_fn("process_exec", CT_VOID)

    reg_fn("process_run", CT_VOID)
    reg_fn_struct_ret("process_run", "ProcessResult")
    reg_fn("process_run_with_stdin", CT_VOID)
    reg_fn_struct_ret("process_run_with_stdin", "ProcessResult")
    reg_fn("process_spawn", CT_INT)
    reg_fn("process_pid_wait", CT_VOID)
    reg_fn_struct_ret("process_pid_wait", "ProcessResult")
    reg_fn("process_pid_kill", CT_INT)
    reg_fn("process_pid_send_signal", CT_INT)
    reg_fn("process_install_signal_forwarding", CT_VOID)

    // Register built-in structs
    struct_reg_names.push("ConversionError")
    struct_reg_set.insert("ConversionError", 1)
    builtin_type_set.insert("ConversionError", 1)
    reg_sf_entry("ConversionError", "message", CT_STRING, "", sv_tp(CT_STRING, -1, -1, ""))
    reg_sf_entry("ConversionError", "source_type", CT_STRING, "", sv_tp(CT_STRING, -1, -1, ""))
    reg_sf_entry("ConversionError", "target_type", CT_STRING, "", sv_tp(CT_STRING, -1, -1, ""))

    struct_reg_names.push("ProcessResult")
    struct_reg_set.insert("ProcessResult", 1)
    builtin_type_set.insert("ProcessResult", 1)
    reg_sf_entry("ProcessResult", "out", CT_STRING, "", sv_tp(CT_STRING, -1, -1, ""))
    reg_sf_entry("ProcessResult", "err_out", CT_STRING, "", sv_tp(CT_STRING, -1, -1, ""))
    reg_sf_entry("ProcessResult", "exit_code", CT_INT, "", sv_tp(CT_INT, -1, -1, ""))

    init_builtin_effects()

    trait_entries.push(TraitEntry { name: "Iterator", method_sl: -1 })
    trait_entries.push(TraitEntry { name: "IntoIterator", method_sl: -1 })

    // Builtin trait impls: which CT_* types implement which traits
    builtin_trait_impls.push(BuiltinTraitImpl { trait_name: "Sized", ct_type: CT_STRING })
    builtin_trait_impls.push(BuiltinTraitImpl { trait_name: "Sized", ct_type: CT_LIST })
    builtin_trait_impls.push(BuiltinTraitImpl { trait_name: "Sized", ct_type: CT_MAP })
    builtin_trait_impls.push(BuiltinTraitImpl { trait_name: "Sized", ct_type: CT_BYTES })
    builtin_trait_impls.push(BuiltinTraitImpl { trait_name: "Sized", ct_type: CT_STRINGBUILDER })
    builtin_trait_impls.push(BuiltinTraitImpl { trait_name: "Contains", ct_type: CT_STRING })
    builtin_trait_impls.push(BuiltinTraitImpl { trait_name: "StrOps", ct_type: CT_STRING })
    builtin_trait_impls.push(BuiltinTraitImpl { trait_name: "ListOps", ct_type: CT_LIST })
    builtin_trait_impls.push(BuiltinTraitImpl { trait_name: "MapOps", ct_type: CT_MAP })
    builtin_trait_impls.push(BuiltinTraitImpl { trait_name: "Sized", ct_type: CT_SET })
    builtin_trait_impls.push(BuiltinTraitImpl { trait_name: "Contains", ct_type: CT_SET })
    builtin_trait_impls.push(BuiltinTraitImpl { trait_name: "SetOps", ct_type: CT_SET })
    builtin_trait_impls.push(BuiltinTraitImpl { trait_name: "BytesOps", ct_type: CT_BYTES })
    builtin_trait_impls.push(BuiltinTraitImpl { trait_name: "StringBuildOps", ct_type: CT_STRINGBUILDER })
    builtin_trait_impls.push(BuiltinTraitImpl { trait_name: "Joinable", ct_type: CT_LIST })
    builtin_trait_impls.push(BuiltinTraitImpl { trait_name: "TemplateOps", ct_type: CT_TEMPLATE })
    // Builtin scalar Display impls so `T: Display` bounds accept scalars.
    builtin_trait_impls.push(BuiltinTraitImpl { trait_name: "Display", ct_type: CT_STRING })
    builtin_trait_impls.push(BuiltinTraitImpl { trait_name: "Display", ct_type: CT_INT })
    builtin_trait_impls.push(BuiltinTraitImpl { trait_name: "Display", ct_type: CT_FLOAT })
    builtin_trait_impls.push(BuiltinTraitImpl { trait_name: "Display", ct_type: CT_BOOL })
    builtin_trait_impls.push(BuiltinTraitImpl { trait_name: "Display", ct_type: CT_CHAR })

    // Pre-register struct/enum names and module prefixes so UE effect type resolution works
    let pre_types_sl = node_fields(program)
    if pre_types_sl != -1 {
        let mut pti = 0
        while pti < sublist_length(pre_types_sl) {
            let ptd = sublist_get(pre_types_sl, pti)
            let ptd_name = node_name(ptd)
            let ptd_mod = mangling_module(ptd)
            if ptd_mod != "" && ptd_mod != "__main__" {
                mod_type_prefix.insert(ptd_name, ptd_mod)
                mod_type_prefix.insert("{ptd_mod}:{ptd_name}", ptd_mod)
            }
            let ptd_flds = node_fields(ptd)
            if ptd_flds != -1 && sublist_length(ptd_flds) > 0 {
                if node_kind(sublist_get(ptd_flds, 0)) == NodeKind.TypeVariant {
                    enum_reg_set.insert(ptd_name, 1)
                } else {
                    struct_reg_set.insert(ptd_name, 1)
                }
            }
            pti = pti + 1
        }
    }

    // Register user-defined effect declarations
    let effects_decl_sl = node_args(program)
    if effects_decl_sl != -1 {
        let mut ei = 0
        while ei < sublist_length(effects_decl_sl) {
            let ed = sublist_get(effects_decl_sl, ei)
            let eff_name = node_name(ed)
            let parent_idx = reg_effect(eff_name, -1)
            let mut handle = ""
            let mut hi = 0
            while hi < eff_name.len() {
                let ch = eff_name.char_at(hi).unwrap()
                if ch == 'A' { handle = handle.concat("a") }
                else if ch == 'B' { handle = handle.concat("b") }
                else if ch == 'C' { handle = handle.concat("c") }
                else if ch == 'D' { handle = handle.concat("d") }
                else if ch == 'E' { handle = handle.concat("e") }
                else if ch == 'F' { handle = handle.concat("f") }
                else if ch == 'G' { handle = handle.concat("g") }
                else if ch == 'H' { handle = handle.concat("h") }
                else if ch == 'I' { handle = handle.concat("i") }
                else if ch == 'J' { handle = handle.concat("j") }
                else if ch == 'K' { handle = handle.concat("k") }
                else if ch == 'L' { handle = handle.concat("l") }
                else if ch == 'M' { handle = handle.concat("m") }
                else if ch == 'N' { handle = handle.concat("n") }
                else if ch == 'O' { handle = handle.concat("o") }
                else if ch == 'P' { handle = handle.concat("p") }
                else if ch == 'Q' { handle = handle.concat("q") }
                else if ch == 'R' { handle = handle.concat("r") }
                else if ch == 'S' { handle = handle.concat("s") }
                else if ch == 'T' { handle = handle.concat("t") }
                else if ch == 'U' { handle = handle.concat("u") }
                else if ch == 'V' { handle = handle.concat("v") }
                else if ch == 'W' { handle = handle.concat("w") }
                else if ch == 'X' { handle = handle.concat("x") }
                else if ch == 'Y' { handle = handle.concat("y") }
                else if ch == 'Z' { handle = handle.concat("z") }
                else { handle = handle.concat(eff_name.substring(hi, 1)) }
                hi = hi + 1
            }
            ue_effects.push(UeEffect { name: eff_name, handle: handle })
            let children_sl = node_elements(ed)
            if children_sl != -1 {
                let mut ci = 0
                while ci < sublist_length(children_sl) {
                    let child = sublist_get(children_sl, ci)
                    let child_name = node_name(child)
                    reg_effect("{eff_name}.{child_name}", parent_idx)
                    let child_ops = node_methods(child)
                    if child_ops != -1 {
                        let mut oi = 0
                        while oi < sublist_length(child_ops) {
                            let op = sublist_get(child_ops, oi)
                            let op_name = node_name(op)
                            let op_ret = node_return_type(op)
                            let op_ret_ct = type_from_name(op_ret)
                            let mut op_ret_inner_ct = CT_VOID
                            let mut op_ret_inner_struct = ""
                            let mut op_ret_inner_ct2 = CT_VOID
                            let mut op_ret_inner_struct2 = ""
                            let mut op_ret_ok_elem_ct = CT_VOID
                            let mut op_ret_ok_elem_struct = ""
                            let mut op_c_ret = c_type_str(op_ret_ct)
                            if op_ret == "" {
                                op_c_ret = "void"
                            } else if op_ret_ct == CT_LIST || op_ret_ct == CT_OPTION {
                                let op_ta = node_type_ann(op)
                                if op_ta != -1 {
                                    let op_ta_elems = node_elements(op_ta)
                                    if op_ta_elems != -1 && sublist_length(op_ta_elems) > 0 {
                                        let inner_ann = sublist_get(op_ta_elems, 0)
                                        let inner_name = node_name(inner_ann)
                                        op_ret_inner_ct = type_from_name(inner_name)
                                        if op_ret_inner_ct == CT_VOID && inner_name != "" {
                                            // A generic-struct-instance inner (QBox[Int]) must record
                                            // the mono stem (QBox_0Int) the typedef + handler side use,
                                            // not the base head — the perform-site conversion spells the
                                            // carrier from this and would emit the undeclared blink_QBox.
                                            let inner_mono = mono_name_from_ann(strip_module_qualifier(inner_name), inner_ann, -1, [])
                                            op_ret_inner_struct = if inner_mono != "" { inner_mono } else { strip_module_qualifier(inner_name) }
                                        }
                                    }
                                }
                                if op_ret_ct == CT_OPTION {
                                    if op_ret_inner_struct != "" && is_transparent_newtype(op_ret_inner_struct) != 0 {
                                        // A transparent newtype lowers to a bare int64_t: its Option
                                        // carrier is a scalar carrier with no heap pointer to erase to
                                        // the uniform vtable ABI. Keep the transparent carrier on the
                                        // op signature and mark the inner scalar so the perform site
                                        // reads it by identity instead of casting a pointer.
                                        ensure_struct_option_type(op_ret_inner_struct)
                                        op_c_ret = struct_option_c_type(op_ret_inner_struct)
                                        op_ret_inner_ct = CT_INT
                                    } else if op_ret_inner_struct != "" {
                                        ensure_option_type(CT_PTR)
                                        op_c_ret = option_c_type(CT_PTR)
                                        op_ret_inner_ct = CT_PTR
                                    } else {
                                        ensure_option_type(op_ret_inner_ct)
                                        op_c_ret = option_c_type(op_ret_inner_ct)
                                    }
                                }
                            } else if op_ret_ct == CT_RESULT {
                                let op_ta = node_type_ann(op)
                                if op_ta != -1 {
                                    let op_ta_elems = node_elements(op_ta)
                                    if op_ta_elems != -1 && sublist_length(op_ta_elems) >= 2 {
                                        let ok_ann = sublist_get(op_ta_elems, 0)
                                        let err_ann = sublist_get(op_ta_elems, 1)
                                        let ok_name = node_name(ok_ann)
                                        let err_name = node_name(err_ann)
                                        let ok_t = type_from_name(ok_name)
                                        let err_t = type_from_name(err_name)
                                        op_ret_inner_ct = ok_t
                                        if ok_t == CT_VOID && ok_name != "" && ok_name != "Void" {
                                            op_ret_inner_struct = strip_module_qualifier(ok_name)
                                        }
                                        op_ret_inner_ct2 = err_t
                                        if err_t == CT_VOID && err_name != "" {
                                            op_ret_inner_struct2 = strip_module_qualifier(err_name)
                                        }
                                        if ok_t == CT_LIST || ok_t == CT_OPTION {
                                            let ok_ann_elems = node_elements(ok_ann)
                                            if ok_ann_elems != -1 && sublist_length(ok_ann_elems) > 0 {
                                                let elem_ann = sublist_get(ok_ann_elems, 0)
                                                let elem_name = node_name(elem_ann)
                                                let elem_ct = type_from_name(elem_name)
                                                op_ret_ok_elem_ct = elem_ct
                                                if elem_ct == CT_VOID && elem_name != "" {
                                                    let stripped_elem = strip_module_qualifier(elem_name)
                                                    // A generic-struct-instance element (QBox[Int]) nested in the Ok
                                                    // side's List/Option must record the mono stem (QBox_0Int) the
                                                    // typedef + handler side use, not the base head — the perform-site
                                                    // carrier conversion spells the carrier from this and would emit the
                                                    // undeclared blink_QBox. Mirrors the top-level Option[GS] inner.
                                                    let elem_mono = mono_name_from_ann(stripped_elem, elem_ann, -1, [])
                                                    let elem_final = if elem_mono != "" { elem_mono } else { stripped_elem }
                                                    op_ret_ok_elem_struct = elem_final
                                                    struct_reg_set.insert(elem_final, 1)
                                                    if elem_name != elem_final {
                                                        struct_reg_set.insert(elem_name, 1)
                                                    }
                                                }
                                            }
                                        }
                                        if err_t == CT_VOID && err_name != "" {
                                            let stripped_err = strip_module_qualifier(err_name)
                                            enum_reg_set.insert(stripped_err, 1)
                                            if err_name != stripped_err {
                                                enum_reg_set.insert(err_name, 1)
                                            }
                                        }
                                        let ok_tag = resolve_result_inner_tag(ok_ann, ok_name, ok_t)
                                        let err_tag = resolve_result_inner_tag(err_ann, err_name, err_t)
                                        if ok_tag != "" && is_compound_ct(ok_t) != 0 {
                                            op_ret_inner_struct = ok_tag
                                        }
                                        if err_tag != "" && is_compound_ct(err_t) != 0 {
                                            op_ret_inner_struct2 = err_tag
                                        }
                                        let mut ok_t_tag = if ok_tag != "" { canonical_struct_tag(ok_tag) } else { c_type_tag(ok_t) }
                                        let err_t_tag = if err_tag != "" { canonical_struct_tag(err_tag) } else { c_type_tag(err_t) }
                                        if ok_t == CT_OPTION && op_ret_ok_elem_struct != "" {
                                            ok_t_tag = "Option_ptr"
                                            ensure_option_type(CT_PTR)
                                        }
                                        ensure_struct_result_type(ok_t_tag, err_t_tag)
                                        if ok_t == CT_OPTION && op_ret_ok_elem_struct != "" {
                                            // ptr-erased: skip compound type emission for Ok
                                        } else if is_compound_ct(ok_t) != 0 {
                                            ensure_compound_type_from_ann(ok_ann)
                                        }
                                        if is_compound_ct(err_t) != 0 {
                                            ensure_compound_type_from_ann(err_ann)
                                        }
                                        op_c_ret = "blink_Result_{ok_t_tag}_{err_t_tag}"
                                    }
                                }
                            } else if op_ret_ct == CT_VOID && op_ret != "" {
                                let stripped = strip_module_qualifier(op_ret)
                                if is_struct_type(op_ret) != 0 || is_struct_type(stripped) != 0 {
                                    op_c_ret = c_type_c_name(stripped)
                                }
                            }
                            let op_params_sl = node_params(op)
                            let mut op_c_params = ""
                            let mut op_param_types: List[Int] = []
                            if op_params_sl != -1 {
                                let mut pi = 0
                                while pi < sublist_length(op_params_sl) {
                                    if pi > 0 {
                                        op_c_params = op_c_params.concat(", ")
                                    }
                                    let p = sublist_get(op_params_sl, pi)
                                    let ptype = node_type_name(p)
                                    let pname = c_safe_name(node_name(p))
                                    op_param_types.push(type_from_name(ptype))
                                    let mut pc = "int64_t"
                                    if ptype == "Str" {
                                        pc = "const char*"
                                    } else if ptype == "Float" {
                                        pc = "double"
                                    } else if ptype == "Bool" {
                                        pc = "int"
                                    } else if ptype == "Int" {
                                        pc = "int64_t"
                                    } else if ptype == "Template" {
                                        pc = "blink_template*"
                                    }
                                    op_c_params = op_c_params.concat("{pc} {pname}")
                                    pi = pi + 1
                                }
                            }
                            if op_c_params == "" {
                                op_c_params = "void"
                            }
                            ue_methods.push(UeMethod { name: op_name, params: op_c_params, ret: op_c_ret, ret_ct: op_ret_ct, ret_inner_ct: op_ret_inner_ct, ret_inner_struct: op_ret_inner_struct, ret_inner_ct2: op_ret_inner_ct2, ret_inner_struct2: op_ret_inner_struct2, ret_ok_elem_ct: op_ret_ok_elem_ct, ret_ok_elem_struct: op_ret_ok_elem_struct, effect_handle: handle, param_types: op_param_types })
                            oi = oi + 1
                        }
                    }
                    ci = ci + 1
                }
            }
            ei = ei + 1
        }
    }

    if cg_archive_header_mode != 0 {
        let guard = if cg_module_header_guard != "" { cg_module_header_guard } else { "BLINK_LIBBLINK_STD_H" }
        cg_lines.push("#ifndef {guard}")
        cg_lines.push("#define {guard}")
    }
    // User TU, archive monolith build, archive header pass, and per-module
    // passes all share runtime globals via the archive monolith TU. The
    // legacy standalone path (blinkc without --link-archive) emits its own
    // runtime storage inline and so leaves the extern flag unset.
    if cg_user_tu_mode != 0 || cg_archive_header_mode != 0 || cg_archive_build_mode != 0 || cg_emit_only_module != "" {
        cg_lines.push("#define BLINK_USE_EXTERN_RUNTIME_STORAGE 1")
    }
    // Per-module: __main__.c owns runtime storage (defines globals); other
    // module .c files extern them. Headers never define storage.
    let owns_runtime_storage = in_per_module_object() && cg_emit_only_module == "__main__"
    if cg_archive_build_mode != 0 || owns_runtime_storage {
        cg_lines.push("#define BLINK_RUNTIME_STORAGE_DEFINE 1")
    }
    if cg_test_mode != 0 {
        cg_lines.push("#define BLINK_TEST_BUILD 1")
    }
    if cg_user_tu_mode != 0 {
        cg_lines.push("#include \"libblink_std.h\"")
    } else {
        cg_lines.push("#include \"runtime.h\"")
    }
    if cg_module_object_self_header != "" {
        cg_lines.push("#include \"{cg_module_object_self_header}\"")
    }
    cg_lines.push("")

    // Emit option/result typedefs needed by UE vtable signatures (early, before vtable structs)
    let mut ue_pre = 0
    while ue_pre < ue_methods.len() {
        let ue_m = ue_methods.get(ue_pre).unwrap()
        if ue_m.ret_ct == CT_OPTION {
            if ue_m.ret_inner_struct != "" && is_transparent_newtype(ue_m.ret_inner_struct) != 0 {
                // Transparent newtype: the op signature keeps the scalar struct-option
                // carrier (blink_Option_<NT>, a bare int64_t value). Emit it INLINE here
                // (not via the deferred ensure_* list) so the typedef precedes the vtable
                // struct that references it.
                emit_struct_option_typedef(ue_m.ret_inner_struct)
            } else {
                emit_option_typedef(ue_m.ret_inner_ct)
            }
        } else if ue_m.ret_ct == CT_RESULT {
            if ue_m.ret_inner_struct != "" && ue_m.ret_inner_ct == CT_VOID {
                let td_ok = find_type_def_node(ue_m.ret_inner_struct)
                if td_ok != -1 {
                    emit_struct_typedef(td_ok)
                }
            }
            if ue_m.ret_inner_struct2 != "" {
                let td2 = find_type_def_node(ue_m.ret_inner_struct2)
                if td2 != -1 {
                    emit_enum_typedef(td2)
                }
            }
            let mut ok_tag = if ue_m.ret_inner_struct != "" { canonical_struct_tag(ue_m.ret_inner_struct) } else { c_type_tag(ue_m.ret_inner_ct) }
            let err_tag = if ue_m.ret_inner_struct2 != "" { canonical_struct_tag(ue_m.ret_inner_struct2) } else { c_type_tag(ue_m.ret_inner_ct2) }
            if ue_m.ret_inner_ct == CT_OPTION && ue_m.ret_ok_elem_struct != "" {
                emit_option_typedef(CT_PTR)
                ok_tag = "Option_ptr"
            }
            emit_struct_result_typedef(ok_tag, err_tag)
        }
        ue_pre = ue_pre + 1
    }

    // Emit user-defined effect vtable structs and globals
    let mut uei = 0
    while uei < ue_effects.len() {
        let ue = ue_effects.get(uei).unwrap()
        let vt_type = "blink_ue_{ue.handle}_vtable"
        push_td_guard_open(vt_type)
        cg_lines.push("typedef struct \{")
        let mut mi = 0
        while mi < ue_methods.len() {
            let uem = ue_methods.get(mi).unwrap()
            if uem.effect_handle == ue.handle {
                cg_lines.push("    {uem.ret} (*{uem.name})({uem.params});")
            }
            mi = mi + 1
        }
        cg_lines.push("    void* __userdata;")
        cg_lines.push("} {vt_type};")
        push_td_guard_close()
        cg_lines.push("")
        if cg_archive_header_mode != 0 {
            uei = uei + 1
            continue
        }
        mi = 0
        while mi < ue_methods.len() {
            let uem = ue_methods.get(mi).unwrap()
            if uem.effect_handle == ue.handle {
                let dfn = "blink_ue_{ue.handle}_default_{uem.name}"
                if uem.ret == "void" {
                    cg_lines.push("static void {dfn}({uem.params}) \{")
                    cg_lines.push("    (void)0;")
                    cg_lines.push("}")
                } else if uem.ret == "const char*" {
                    cg_lines.push("static const char* {dfn}({uem.params}) \{")
                    cg_lines.push("    return NULL;")
                    cg_lines.push("}")
                } else if uem.ret_ct == CT_LIST {
                    cg_lines.push("static blink_list* {dfn}({uem.params}) \{")
                    cg_lines.push("    return blink_list_new();")
                    cg_lines.push("}")
                } else if uem.ret_ct == CT_OPTION {
                    cg_lines.push("static {uem.ret} {dfn}({uem.params}) \{")
                    cg_lines.push("    return ({uem.ret})\{ .tag = 0 };")
                    cg_lines.push("}")
                } else if uem.ret_ct == CT_RESULT {
                    cg_lines.push("static {uem.ret} {dfn}({uem.params}) \{")
                    cg_lines.push("    return ({uem.ret})\{ .tag = 1 };")
                    cg_lines.push("}")
                } else {
                    cg_lines.push("static {uem.ret} {dfn}({uem.params}) \{")
                    cg_lines.push("    return 0;")
                    cg_lines.push("}")
                }
                cg_lines.push("")
            }
            mi = mi + 1
        }
        cg_lines.push("static {vt_type} {vt_type}_default = \{")
        mi = 0
        let mut _first_m = 1
        while mi < ue_methods.len() {
            let uem = ue_methods.get(mi).unwrap()
            if uem.effect_handle == ue.handle {
                if _first_m == 0 {
                    cg_lines.push(",")
                }
                cg_lines.push("    blink_ue_{ue.handle}_default_{uem.name}")
                _first_m = 0
            }
            mi = mi + 1
        }
        if _first_m == 0 {
            cg_lines.push(",")
        }
        cg_lines.push("    NULL")
        cg_lines.push("};")
        cg_lines.push("")
        uei = uei + 1
    }

    // Whole-program archive header skips evidence struct entirely (user
    // TU emits its own larger typedef). All other modes emit at least the
    // typedef + extern decl; only the owning TU emits the default
    // initializer and __blink_ev storage.
    if cg_archive_header_mode == 0 || in_per_module_header() {
        if cg_archive_build_mode != 0 {
            cg_lines.push("typedef struct \{")
        } else {
            push_td_guard_open("blink_ev")
            cg_lines.push("typedef struct \{")
        }
        cg_lines.push("    blink_io_vtable*      io;")
        cg_lines.push("    blink_fs_vtable*      fs;")
        cg_lines.push("    blink_net_vtable*     net;")
        cg_lines.push("    blink_crypto_vtable*  crypto;")
        cg_lines.push("    blink_rand_vtable*    rand;")
        cg_lines.push("    blink_time_vtable*    time;")
        cg_lines.push("    blink_env_vtable*     env;")
        cg_lines.push("    blink_process_vtable* process;")
        let mut ev_uei = 0
        while ev_uei < ue_effects.len() {
            let ev_ue = ue_effects.get(ev_uei).unwrap()
            cg_lines.push("    blink_ue_{ev_ue.handle}_vtable* ue_{ev_ue.handle};")
            ev_uei = ev_uei + 1
        }
        cg_lines.push("\} blink_ev;")
        if cg_archive_build_mode == 0 {
            push_td_guard_close()
        }
        cg_lines.push("")

        if cg_archive_build_mode != 0 || cg_blink_ev_extern_only != 0 || in_per_module_header() {
            cg_lines.push("extern blink_ev __blink_ev;")
            cg_lines.push("")
        } else {
            cg_lines.push("BLINK_UNUSED static blink_ev blink_ev_default(void) \{")
            cg_lines.push("    blink_ev ev;")
            cg_lines.push("    ev.io      = &blink_io_vtable_default;")
            cg_lines.push("    ev.fs      = &blink_fs_vtable_default;")
            cg_lines.push("    ev.net     = &blink_net_vtable_default;")
            cg_lines.push("    ev.crypto  = &blink_crypto_vtable_default;")
            cg_lines.push("    ev.rand    = &blink_rand_vtable_default;")
            cg_lines.push("    ev.time    = &blink_time_vtable_default;")
            cg_lines.push("    ev.env     = &blink_env_vtable_default;")
            cg_lines.push("    ev.process = &blink_process_vtable_default;")
            ev_uei = 0
            while ev_uei < ue_effects.len() {
                let ev_ue2 = ue_effects.get(ev_uei).unwrap()
                cg_lines.push("    ev.ue_{ev_ue2.handle} = &blink_ue_{ev_ue2.handle}_vtable_default;")
                ev_uei = ev_uei + 1
            }
            cg_lines.push("    return ev;")
            cg_lines.push("\}")
            cg_lines.push("")
            // User TU and per-module-object mode for the owner both require
            // non-static so peer TUs' `extern` resolves.
            if cg_user_tu_mode != 0 || in_per_module_object() {
                cg_lines.push("blink_ev __blink_ev;")
            } else {
                cg_lines.push("static blink_ev __blink_ev;")
            }
            cg_lines.push("")
        }
    }

    // Populate module prefix registries
    mod_fn_prefix = Map()
    mod_type_prefix = Map()
    type_alias_base = Map()
    type_where_preds = Map()
    cg_where_self_var = ""
    cg_ensures_result_var = ""
    cg_old_snapshot_vars = Map()

    // Register type names first (struct or enum, skip aliases)
    let types_sl = node_fields(program)
    if types_sl != -1 {
        let mut i = 0
        while i < sublist_length(types_sl) {
            let td = sublist_get(types_sl, i)
            let mod_name = mangling_module(td)
            if mod_name != "" && mod_name != "__main__" {
                mod_type_prefix.insert(node_name(td), mod_name)
                mod_type_prefix.insert("{mod_name}:{node_name(td)}", mod_name)
            }
            let td_flds = node_fields(td)
            if td_flds == -1 && node_value(td) != -1 {
                let alias_name = node_name(td)
                let base_ann = node_value(td)
                let base_name = node_name(base_ann)
                type_alias_base.insert(alias_name, base_name)
                let where_pred = node_condition(td)
                if where_pred != -1 {
                    type_where_preds.insert(alias_name, where_pred)
                }
                i = i + 1
                continue
            }
            let mut is_enum = 0
            if td_flds != -1 && sublist_length(td_flds) > 0 {
                if node_kind(sublist_get(td_flds, 0)) == NodeKind.TypeVariant {
                    is_enum = 1
                }
            }
            if is_enum == 0 {
                struct_reg_names.push(node_name(td))
                struct_reg_set.insert(node_name(td), 1)
            }
            i = i + 1
        }
    }

    // Type definitions (structs, enums, and aliases).
    // Topologically sorted so dependencies emit before dependents
    // (otherwise C compilation fails when an earlier-declared ADT
    // has a value-typed field referencing a later-declared ADT).
    let in_per_module_object_types = in_per_module_object() && cg_archive_build_mode == 0
    if types_sl != -1 {
        let order = topo_sort_type_indices(types_sl)
        let mut oi = 0
        while oi < order.len() {
            let i = order.get(oi).unwrap()
            let td = sublist_get(types_sl, i)
            // Resolve typedef emission against the DEFINING module so that when
            // two modules share a bare type name, each typedef (and every
            // c_type_c_name inside it) picks up its own module prefix via the
            // composite key rather than the last-writer bare entry.
            let saved_type_emit_module = cg_current_module
            let td_emit_mod = mangling_module(td)
            cg_current_module = if td_emit_mod != "__main__" { td_emit_mod } else { "" }
            let td_foreign = owned_by_other_module(node_source_module(td))
            // In per-module-object mode, foreign types still need their
            // sf_entries / enum_variants registered so cross-module field
            // access (e.g. `fsi.ok_struct`) resolves to the right type at
            // codegen time. We run the same emit path but discard the
            // generated C — the .h aggregator already provides the typedef.
            if td_foreign && in_per_module_object_types == 0 {
                cg_current_module = saved_type_emit_module
                oi = oi + 1
                continue
            }
            let td_flds = node_fields(td)
            if td_flds == -1 && node_value(td) != -1 {
                if !td_foreign {
                    let alias_name = node_name(td)
                    let base_name = type_alias_base.get(alias_name).unwrap()
                    let c_base = c_type_for_alias(base_name)
                    emit_line("typedef {c_base} blink_{alias_name};")
                }
                cg_current_module = saved_type_emit_module
                oi = oi + 1
                continue
            }
            let mut is_enum = 0
            if td_flds != -1 && sublist_length(td_flds) > 0 {
                if node_kind(sublist_get(td_flds, 0)) == NodeKind.TypeVariant {
                    is_enum = 1
                }
            }
            let saved_lines = cg_lines
            if td_foreign {
                cg_lines = []
            }
            if is_enum != 0 {
                // Flush each variant payload's carrier typedef before this enum.
                // A tuple field whose elements reference THIS enum by value
                // (`Pair(p: (Box, Box))`) forward-references the enum typedef, so
                // its carrier must come AFTER emit_enum_typedef (which boxes the
                // field to int64_t) — defer it, mirroring the mono path.
                let e_nm = node_name(td)
                let etparams = node_type_params(td)
                let e_is_generic = etparams != -1 && sublist_length(etparams) > 0
                let mut deferred_selfrec_tuples: List[Int] = []
                if !e_is_generic && td_flds != -1 {
                    let mut vanns: List[Int] = []
                    let mut vi = 0
                    while vi < sublist_length(td_flds) {
                        let vnode = sublist_get(td_flds, vi)
                        let v_nm = node_name(vnode)
                        let vflds = node_fields(vnode)
                        if vflds != -1 {
                            let mut vfi = 0
                            while vfi < sublist_length(vflds) {
                                let vf = sublist_get(vflds, vfi)
                                let vf_ann = node_value(vf)
                                if vf_ann != -1 && node_name(vf_ann) == "Tuple" && tc_variant_field_is_selfrec_tuple(e_nm, v_nm, node_name(vf)) != 0 {
                                    deferred_selfrec_tuples.push(vf_ann)
                                } else {
                                    vanns.push(vf_ann)
                                }
                                vfi = vfi + 1
                            }
                        }
                        vi = vi + 1
                    }
                    preflush_field_carrier_typedefs(vanns)
                }
                emit_enum_typedef(td)
                let mut dt = 0
                while dt < deferred_selfrec_tuples.len() {
                    let dann = deferred_selfrec_tuples.get(dt).unwrap()
                    let mark = emitted_tuple_entries.len()
                    let _dtup = resolve_tuple_ann(dann, -1, [])
                    emit_tuple_types_from(mark)
                    dt = dt + 1
                }
            } else {
                // Flush each field's carrier typedef before this struct.
                if td_flds != -1 {
                    let tparams = node_type_params(td)
                    let is_generic = tparams != -1 && sublist_length(tparams) > 0
                    if !is_generic {
                        let mut fanns: List[Int] = []
                        let mut fi = 0
                        while fi < sublist_length(td_flds) {
                            fanns.push(node_value(sublist_get(td_flds, fi)))
                            fi = fi + 1
                        }
                        preflush_field_carrier_typedefs(fanns)
                    }
                }
                emit_struct_typedef(td)
            }
            if td_foreign {
                cg_lines = saved_lines
            }
            cg_current_module = saved_type_emit_module
            oi = oi + 1
        }
    }

    // Top-level let bindings (deduplicated). In archive-object mode (user
    // TU linked against libblink_std.a) stdlib globals still need codegen
    // metadata registered (so receivers like `toml_keys.len()` resolve
    // their list element type), but their C definitions live in the
    // monolith. emit_top_level_let routes those to an extern-decl path.
    let lets_sl = node_stmts(program)
    if lets_sl != -1 {
        // Two-pass: emit owned definitions first (prefer them on name
        // collision with foreign externs — same C symbol could be a
        // private local in this TU and an extern reference for other
        // modules' private lets sharing the name; the definition wins).
        let mut i = 0
        while i < sublist_length(lets_sl) {
            let let_node = sublist_get(lets_sl, i)
            let let_name = node_name(let_node)
            let let_mod = node_source_module(let_node)
            let mod_is_skipped = skip_module(let_mod)
            // Non-pub stdlib lets are file-local in monolith.o; declaring
            // them in the archive header would collide with same-named
            // user identifiers in any TU that #includes the header.
            if cg_archive_header_mode != 0 && cg_emit_only_module == "" {
                if !is_stdlib_source_module(let_mod) || node_is_pub(let_node) == 0 {
                    i = i + 1
                    continue
                }
            }
            if is_emitted_let(let_name) == 0 && !mod_is_skipped {
                emit_top_level_let(let_node, 0)
                emitted_let_names.push(let_name)
                emitted_let_set.insert(let_name, 1)
            }
            i = i + 1
        }
        // Second pass: foreign-owned lets need extern decls + codegen metadata
        // so cross-module receivers resolve their value type. Non-pub stdlib
        // lets are file-local (`static`) in both monolith.o (user-TU mode) and
        // the owning module's per-module .o, so there is no external symbol to
        // extern-link to — emitting a foreign `extern` decl would reference an
        // undefined symbol. They're filtered via stdlib_private in both modes.
        let needs_foreign_extern = cg_user_tu_mode != 0 || in_per_module_object()
        i = 0
        while i < sublist_length(lets_sl) {
            let let_node = sublist_get(lets_sl, i)
            let let_name = node_name(let_node)
            let let_mod = node_source_module(let_node)
            let mod_is_skipped = skip_module(let_mod)
            let stdlib_private = (cg_user_tu_mode != 0 || in_per_module_object()) && is_stdlib_source_module(let_mod) && node_is_pub(let_node) == 0
            let extern_only = if needs_foreign_extern && mod_is_skipped && !stdlib_private { 1 } else { 0 }
            if is_emitted_let(let_name) == 0 && extern_only != 0 {
                emit_top_level_let(let_node, extern_only)
                emitted_let_names.push(let_name)
                emitted_let_set.insert(let_name, 1)
            }
            i = i + 1
        }
        emit_line("")
    }

    // Register all functions first (deduplicated)
    let fns_sl = node_params(program)
    if fns_sl != -1 {
        let mut i = 0
        while i < sublist_length(fns_sl) {
            let fn_node = sublist_get(fns_sl, i)
            let fn_name = node_name(fn_node)
            let fn_mod = node_module(fn_node)
            let fn_reg_mod = mangling_module(fn_node)
            let mut fn_eff_prefix = fn_reg_mod
            let ffi_ann = get_annotation(fn_node, "ffi")
            // User-source top-level fns mangle as `blink_u_NAME` so they
            // don't collide with builtin-set runtime exports (which keep
            // the unprefixed `blink_NAME` namespace). `main` is the C
            // entry point and stays `blink_main` (only one user `main`
            // per program). FFI bindings keep their literal C symbol.
            let user_fn = (fn_eff_prefix == "" || fn_eff_prefix == "__main__") && fn_name != "main" && ffi_ann == -1
            if user_fn {
                let fn_src_mod = node_source_module(fn_node)
                if !is_stdlib_source_module(fn_src_mod) {
                    fn_eff_prefix = "u"
                }
            }
            if fn_eff_prefix != "" && fn_eff_prefix != "__main__" {
                mod_fn_prefix.insert(fn_name, fn_eff_prefix)
                mod_fn_prefix.insert("{fn_eff_prefix}:{fn_name}", fn_eff_prefix)
            }
            reg_fn_node(fn_name, fn_node)
            if ffi_ann != -1 {
                let ffi_emit_key = make_emit_key(fn_mod, fn_name)
                reg_fn_as_ffi(fn_name)
                reg_fn_as_ffi(ffi_emit_key)
            }
            // FFI-bridged generics skip monomorphization: the runtime helper
            // is the implementation and operates on the type-erased uniform
            // representation, so all type-args share one symbol.
            let fn_tparams = node_type_params(fn_node)
            if fn_tparams != -1 && sublist_length(fn_tparams) > 0 && ffi_ann == -1 {
                generic_fns.push(GenericFnEntry { name: fn_name, node: fn_node })
                generic_fns_by_name.insert(fn_name, fn_node)
            } else {
                let emit_key = make_emit_key(fn_mod, fn_name)
                if fn_reg_set.contains_key(emit_key) == 0 {
                    let ret_str = node_return_type(fn_node)
                    let fn_eff_sl = node_effects(fn_node)
                    let fn_trusted = has_annotation(fn_node, "trusted")
                    if is_enum_type(ret_str) != 0 {
                        fn_enum_rets.push(FnEnumRetEntry { name: emit_key, enum_type: ret_str })
                        fn_enum_rets.push(FnEnumRetEntry { name: fn_name, enum_type: ret_str })
                        // A NON-transparent data enum has a `blink_<Enum>` struct
                        // representation, so value-typing must report CT_STRUCT to
                        // match the C signature. The transparent newtype Errno
                        // legitimately lowers to bare int64_t, so it stays CT_INT
                        // with no struct-ret registration.
                        if is_data_enum(ret_str) != 0 && is_transparent_newtype(ret_str) == 0 {
                            reg_fn_with_effects(emit_key, CT_STRUCT, fn_eff_sl, fn_trusted)
                            reg_fn_with_effects(fn_name, CT_STRUCT, fn_eff_sl, fn_trusted)
                            // A concrete generic-ENUM INSTANCE return (`-> Tree[Int]`)
                            // registers its mono carrier (Tree_Int) as the struct-ret
                            // so the call-site `_sr` temp + let-binding name the
                            // typedef'd blink_Tree_Int, not the bare blink_Tree — the
                            // enum twin of the struct branch below.
                            // fn_enum_rets above stays BARE (value-typing / variant
                            // lookups). Empty stem (bare/typevar enum) keeps ret_str.
                            let ret_stem = ann_mono_stem(node_type_ann(fn_node))
                            let reg_ret = if ret_stem != "" { ret_stem } else { ret_str }
                            reg_fn_struct_ret(emit_key, reg_ret)
                            reg_fn_struct_ret(fn_name, reg_ret)
                        } else {
                            reg_fn_with_effects(emit_key, CT_INT, fn_eff_sl, fn_trusted)
                            reg_fn_with_effects(fn_name, CT_INT, fn_eff_sl, fn_trusted)
                        }
                    } else {
                        let ret_ct = type_from_name(ret_str)
                        reg_fn_with_effects(emit_key, ret_ct, fn_eff_sl, fn_trusted)
                        reg_fn_with_effects(fn_name, ret_ct, fn_eff_sl, fn_trusted)
                        if is_struct_type(ret_str) != 0 {
                            // A concrete generic-struct INSTANCE return
                            // (`-> Box[Str]`) must register its monomorphized
                            // carrier (Box_Str), not the bare `Box`, so the
                            // call-site `_sr` temp (get_fn_ret_struct) names
                            // the typedef'd type. Read the instance tid the
                            // typechecker memoized onto the return annotation
                            // node and expand to the mono stem, mirroring the
                            // param path (param_c_type). Empty stem (bare/
                            // typevar/module-qualified) keeps ret_str.
                            let ret_stem = ann_mono_stem(node_type_ann(fn_node))
                            let reg_ret = if ret_stem != "" { ret_stem } else { ret_str }
                            reg_fn_struct_ret(emit_key, reg_ret)
                            reg_fn_struct_ret(fn_name, reg_ret)
                        }
                    }
                    reg_fn_ret_from_ann(emit_key, fn_node)
                    reg_fn_ret_from_ann(fn_name, fn_node)
                    fn_reg_set.insert(emit_key, 1)
                    fn_reg_set.insert(fn_name, 1)
                }
            }
            i = i + 1
        }
    }

    // Register traits
    let traits_sl = node_arms(program)
    if traits_sl != -1 {
        let mut i = 0
        while i < sublist_length(traits_sl) {
            let tr = sublist_get(traits_sl, i)
            trait_entries.push(TraitEntry { name: node_name(tr), method_sl: node_methods(tr) })
            i = i + 1
        }
    }

    // Register impls and their methods
    let impls_sl = node_methods(program)
    if impls_sl != -1 {
        let mut i = 0
        while i < sublist_length(impls_sl) {
            let im = sublist_get(impls_sl, i)
            let impl_trait = node_trait_name(im)
            let impl_type = node_name(im)
            reg_impl_entry(impl_trait, impl_type, node_methods(im))
            register_poly_impl_methods(im, impl_trait, impl_type)
            let assoc_sl = node_assoc_types(im)
            if assoc_sl != -1 {
                let mut ai = 0
                while ai < sublist_length(assoc_sl) {
                    let at_node = sublist_get(assoc_sl, ai)
                    let aname = node_name(at_node)
                    let concrete = node_type_name(at_node)
                    assoc_type_bindings.push(AssocTypeBinding {
                        trait_name: impl_trait,
                        impl_type: impl_type,
                        assoc_name: aname,
                        concrete_type: concrete,
                    })
                    ai = ai + 1
                }
            }
            let impl_mod = mangling_module(im)
            if impl_mod != "" && impl_mod != "__main__" && mod_type_prefix.contains_key(impl_type) == false {
                // Bare-key fallback ONLY: this heuristic records the impl's
                // module for a type whose own declaration didn't register a
                // prefix (legacy behavior). Do NOT also write the composite key
                // "{impl_mod}:{impl_type}" here — impl_type is a TYPE name whose
                // module is where the TYPE is DECLARED, not where the impl lives.
                // A cross-module (orphan) impl would otherwise poison the
                // composite key so `self: T` resolves to the impl's module and
                // mismatches the type's real C symbol. The type-decl sites
                // (pre-register + main type loop) own the composite key.
                mod_type_prefix.insert(impl_type, impl_mod)
            }
            // Register Display impls; the compiler synthesizes a sealed
            // `{T}_Display_display`. Mirror the impl-method module prefixing so
            // the synthesized symbol resolves the same way the user's
            // `{T}_Display_fmt` does.
            if impl_trait == "Display" {
                display_impl_types.push(impl_type)
                // Use THIS impl's module directly, not mod_type_prefix.get(impl_type)
                // (bare key, last-writer): when two modules share impl_type the
                // bare entry would prefix the synthesized Display symbol with the
                // wrong module.
                if impl_mod != "" && impl_mod != "__main__" {
                    mod_fn_prefix.insert(mangle_impl_method_q(impl_type, "Display", "display"), impl_mod)
                }
            }
            if impl_trait == "From" {
                let trait_tparams = node_type_params(im)
                if trait_tparams != -1 && sublist_length(trait_tparams) > 0 {
                    let src_node = sublist_get(trait_tparams, 0)
                    let src_type = node_name(src_node)
                    from_entries.push(FromImplEntry { source: src_type, target: impl_type, method_sl: node_methods(im) })
                }
            }
            if impl_trait == "TryFrom" {
                let trait_tparams = node_type_params(im)
                if trait_tparams != -1 && sublist_length(trait_tparams) > 0 {
                    let src_node = sublist_get(trait_tparams, 0)
                    let src_type = node_name(src_node)
                    tryfrom_entries.push(TryFromImplEntry { source: src_type, target: impl_type, method_sl: node_methods(im) })
                }
            }
            let methods_sl = node_methods(im)
            if methods_sl != -1 {
                let mut j = 0
                while j < sublist_length(methods_sl) {
                    let m = sublist_get(methods_sl, j)
                    let mname = node_name(m)
                    // Poly-impl methods have no bare un-mono symbol; their per-T
                    // instances register at the call site. Skip the bare-symbol
                    // metadata + module-prefix registration here.
                    if is_poly_impl_base(mangle_impl_method_q(impl_type, impl_trait, mname)) != 0 {
                        j = j + 1
                        continue
                    }
                    let mangled = mangle_impl_method(im, impl_type, mname)
                    // Prefix this impl's methods by THIS impl's module (impl_mod),
                    // not mod_type_prefix.get(impl_type) (bare key, last-writer):
                    // a colliding impl_type across modules would otherwise route
                    // the method symbol to the wrong module.
                    if impl_mod != "" && impl_mod != "__main__" {
                        mod_fn_prefix.insert(mangled, impl_mod)
                        mod_fn_prefix.insert("{impl_mod}:{mangled}", impl_mod)
                    }
                    let ret_str_raw = node_return_type(m)
                    let ret_str = resolve_self_type(ret_str_raw, impl_type)
                    if is_enum_type(ret_str) != 0 {
                        fn_enum_rets.push(FnEnumRetEntry { name: mangled, enum_type: ret_str })
                        if is_data_enum(ret_str) != 0 && is_transparent_newtype(ret_str) == 0 {
                            reg_fn(mangled, CT_STRUCT)
                            reg_fn_struct_ret(mangled, ret_str)
                        } else {
                            reg_fn(mangled, CT_INT)
                        }
                    } else if is_struct_type(ret_str) != 0 {
                        reg_fn(mangled, CT_VOID)
                        // Concrete generic-struct INSTANCE method return
                        // (`-> Box[Str]`): register the mono carrier off the
                        // return annotation tid so the `_sr` temp names the
                        // typedef'd type. resolve_self_type still handles the
                        // `Self` case (empty stem falls back).
                        let ret_stem = ann_mono_stem(node_type_ann(m))
                        let reg_ret = if ret_stem != "" { ret_stem } else { ret_str }
                        reg_fn_struct_ret(mangled, reg_ret)
                    } else {
                        reg_fn(mangled, type_from_name(ret_str))
                    }
                    reg_fn_ret_from_ann(mangled, m)
                    j = j + 1
                }
            }
            i = i + 1
        }
    }

    // Register @derive annotations
    register_derive_annotations(types_sl)

    // Auto-derive Into from From
    let mut into_i = 0
    while into_i < from_entries.len() {
        let fe = from_entries.get(into_i).unwrap()
        reg_impl_entry("Into", fe.source, fe.method_sl)
        into_i = into_i + 1
    }

    // Def-side struct-instance carriers: a NON-generic fn or impl method whose
    // PARAM type is a concrete generic-struct instance (`b: Box[Str]`) lowers its
    // signature to the mono carrier (blink_Box_Str) off the instance tid — so
    // that carrier's typedef must be registered here, before the fn-decl pass,
    // and flushed into the pre-decl typedef region below. register_struct_
    // instance_from_tid mints the inner-first mono_instances entries; the flushes
    // below emit them ahead of the decls that name them.
    if fns_sl != -1 {
        let mut pi = 0
        while pi < sublist_length(fns_sl) {
            let fn_node2 = sublist_get(fns_sl, pi)
            if is_generic_fn(node_name(fn_node2)) == 0 {
                register_struct_instance_params(node_params(fn_node2))
                // A concrete generic-struct instance RETURN (`-> Box[Str]`) lowers
                // its signature/def to the mono carrier off the same
                // return-annotation tid, so queue that carrier's typedef here too,
                // before the fn-decl pass names it. Nesting is handled inner-first
                // by the recursive registrar.
                let ret_tid = tc_lookup_node_tid(node_type_ann(fn_node2))
                if is_struct_type(node_return_type(fn_node2)) != 0 {
                    register_struct_instance_from_tid(ret_tid)
                } else {
                    // A carrier RETURN over struct instances
                    // (`-> Result[RBox[Int],RBox[Str]]`) names blink_RBox_Int by
                    // value in the carrier typedef, so register those leaves here
                    // ahead of the pre-decl flush.
                    register_carrier_struct_instance_leaves(ret_tid)
                }
            }
            pi = pi + 1
        }
    }
    // Impl-method params reach the same param_c_type lowering via
    // format_impl_params, so their struct-instance carriers must register here
    // too — otherwise the method's forward decl names blink_Box_Str before its
    // typedef. Poly-impl (generic) methods are NOT filtered out here; they no-op
    // safely because register_struct_instance_from_tid returns "" for a
    // typevar-slot instance (`Box[T]`) or bare `T` — the deferred mono pass
    // lowers those per concrete T instead.
    if impls_sl != -1 {
        let mut ii = 0
        while ii < sublist_length(impls_sl) {
            let im = sublist_get(impls_sl, ii)
            let methods_sl = node_methods(im)
            if methods_sl != -1 {
                let mut mj = 0
                while mj < sublist_length(methods_sl) {
                    let method_node = sublist_get(methods_sl, mj)
                    register_struct_instance_params(node_params(method_node))
                    // Method return carrier (`-> Box[Str]`), same rationale as
                    // free fns above. Typevar-slot returns (poly-impl `-> T`)
                    // and `Self` yield "" from the registrar → no-op.
                    let m_ret_tid = tc_lookup_node_tid(node_type_ann(method_node))
                    if is_struct_type(node_return_type(method_node)) != 0 {
                        register_struct_instance_from_tid(m_ret_tid)
                    } else {
                        register_carrier_struct_instance_leaves(m_ret_tid)
                    }
                    mj = mj + 1
                }
            }
            ii = ii + 1
        }
    }
    if fns_sl != -1 {
        let mut pi = 0
        while pi < sublist_length(fns_sl) {
            let fn_node2 = sublist_get(fns_sl, pi)
            let params_sl2 = node_params(fn_node2)
            if params_sl2 != -1 {
                let mut pj = 0
                while pj < sublist_length(params_sl2) {
                    let p2 = sublist_get(params_sl2, pj)
                    let pt2 = node_type_name(p2)
                    if pt2 == "Result" {
                        let ta2 = node_type_ann(p2)
                        if ta2 != -1 {
                            let es2 = node_elements(ta2)
                            if es2 != -1 && sublist_length(es2) >= 2 {
                                let oa2 = sublist_get(es2, 0)
                                let ea2 = sublist_get(es2, 1)
                                let on2 = node_name(oa2)
                                let en2 = node_name(ea2)
                                let ot2 = type_from_name(on2)
                                let et2 = type_from_name(en2)
                                let ok_tag2 = resolve_result_inner_tag(oa2, on2, ot2)
                                let err_tag2 = resolve_result_inner_tag(ea2, en2, et2)
                                if ok_tag2 != "" || err_tag2 != "" {
                                    let ok_t_tag2 = if ok_tag2 != "" { canonical_struct_tag(ok_tag2) } else { c_type_tag(ot2) }
                                    let err_t_tag2 = if err_tag2 != "" { canonical_struct_tag(err_tag2) } else { c_type_tag(et2) }
                                    ensure_struct_result_type(ok_t_tag2, err_t_tag2)
                                } else {
                                    ensure_mixed_result_type(ot2, et2, "", "")
                                }
                            }
                        }
                    } else if pt2 == "Option" {
                        let ta2 = node_type_ann(p2)
                        if ta2 != -1 {
                            let es2 = node_elements(ta2)
                            if es2 != -1 && sublist_length(es2) >= 1 {
                                let ia2 = sublist_get(es2, 0)
                                let in2 = node_name(ia2)
                                let ict2 = type_from_name(in2)
                                if is_struct_or_enum_type(in2) != 0 {
                                    ensure_struct_option_type(in2)
                                } else if is_compound_ct(ict2) != 0 || in2 == "Tuple" {
                                    ensure_struct_option_type(compound_name_from_ann(ia2))
                                } else {
                                    ensure_option_type(ict2)
                                }
                            }
                        }
                    }
                    pj = pj + 1
                }
            }
            pi = pi + 1
        }
    }

    // Flush the mono struct-INSTANCE typedefs (registered from param/return carriers
    // over instances) BEFORE the option/result carrier flush, so a carrier like
    // blink_Result_RBox_Int_RBox_Str sees blink_RBox_Int/blink_RBox_Str already
    // declared instead of referencing them by value before their typedef. The later
    // emit_mono_typedefs_from at the forward-decl merge re-covers the same range; its
    // emitted lines are guarded by BLINK_TD_ (idempotent at the C level) and it still
    // catches instances registered during the fn-decl pass. Same discipline as the
    // existing multi-point option/result flushes.
    //
    // From 0, not from a pre-fn-pass watermark. Producers do not agree on WHEN they
    // register: the Option arm of reg_fn_ret_from_ann registers its inner instance
    // during the reg_fn pass, i.e. before any watermark taken here, while the Result
    // arm's first registration is register_carrier_struct_instance_leaves below it.
    // A watermark silently drops everything on the early side, so
    // `-> Option[QBox[Int]]` emitted blink_Option_QBox_Int naming an undeclared
    // blink_QBox_Int. The BLINK_TD_ guards make the wider range free.
    emit_mono_typedefs_from(0)
    emit_all_option_result_types()
    emit_all_tuple_types()
    let mut early_tuple_count = emitted_tuple_entries.len()
    let mut early_option_count = emitted_option_types.len()
    let mut early_result_count = emitted_result_types.len()
    let mut early_s_option_count = emitted_struct_option_types.len()
    let mut early_s_result_count = emitted_struct_result_types.len()

    // Forward declarations — buffer them so we can prepend tuple types discovered during decl emission
    let pre_fwd_lines = cg_lines
    cg_lines = []
    emitted_fn_names = []
    emitted_fn_set = Map()
    // Archive (whole-program) header and archive monolith both exclude
    // effectful fns — those land in the user TU instead. Per-module
    // header (cg_emit_only_module set + header mode) needs effectful
    // pub fns so other modules can call them via the aggregator.
    let archive_excludes_effectful = if (cg_archive_header_mode != 0 || cg_archive_build_mode != 0) && !in_per_module_header() { 1 } else { 0 }
    if fns_sl != -1 {
        let mut i = 0
        while i < sublist_length(fns_sl) {
            let fn_node = sublist_get(fns_sl, i)
            let fn_name = node_name(fn_node)
            let fn_mod = node_module(fn_node)
            let fn_src_mod = node_source_module(fn_node)
            let fn_is_effectful = fn_is_archive_excluded(fn_node)
            let fn_keep_for_user = cg_user_tu_mode != 0 && fn_is_effectful
            if skip_module(fn_src_mod) && !fn_keep_for_user {
                i = i + 1
                continue
            }
            if cg_archive_header_mode != 0 && cg_emit_only_module == "" && !is_stdlib_source_module(fn_src_mod) {
                i = i + 1
                continue
            }
            if skip_private_in_module_header(fn_node) {
                i = i + 1
                continue
            }
            if archive_excludes_effectful != 0 && fn_is_effectful {
                i = i + 1
                continue
            }
            cg_current_module = fn_mod
            let emit_key = make_emit_key(fn_mod, fn_name)
            if emitted_fn_set.contains_key(emit_key) == 0 && is_generic_fn(fn_name) == 0 {
                let pre_len = cg_lines.len()
                emit_fn_decl(fn_node)
                if cg_archive_header_mode != 0 {
                    prepend_extern_one(pre_len)
                }
                emitted_fn_names.push(fn_name)
                emitted_fn_set.insert(emit_key, 1)
                emitted_fn_set.insert(fn_name, 1)
            }
            i = i + 1
        }
    }

    // Impl method forward declarations
    if impls_sl != -1 {
        let mut i = 0
        while i < sublist_length(impls_sl) {
            let im = sublist_get(impls_sl, i)
            let im_mod = node_module(im)
            let im_src_mod = node_source_module(im)
            if cg_archive_header_mode != 0 && cg_emit_only_module == "" && !is_stdlib_source_module(im_src_mod) {
                i = i + 1
                continue
            }
            cg_current_module = im_mod
            let impl_type = node_name(im)
            let methods_sl = node_methods(im)
            if methods_sl != -1 {
                let mut j = 0
                let im_in_skipped_mod = skip_module(im_src_mod)
                while j < sublist_length(methods_sl) {
                    let m = sublist_get(methods_sl, j)
                    let m_is_effectful = fn_is_archive_excluded(m)
                    if archive_excludes_effectful != 0 && m_is_effectful {
                        j = j + 1
                        continue
                    }
                    if im_in_skipped_mod && !m_is_effectful {
                        j = j + 1
                        continue
                    }
                    // Impl methods have no per-method `pub` keyword (they
                    // inherit from the impl block / trait). Skipping them
                    // via skip_private_in_module_header would erase trait
                    // surface that other modules need to call. Free fns
                    // still get the filter applied at their own site.
                    let mname = node_name(m)
                    // Canonical builtin poly-impl methods have no single bare symbol
                    // — they are monomorphized per concrete T. The deferred mono
                    // pass emits their forward decls; emitting a bare decl here
                    // would lower T to void (broken signature).
                    if is_poly_impl_base(mangle_impl_method_q(impl_type, node_trait_name(im), mname)) != 0 {
                        j = j + 1
                        continue
                    }
                    let mangled = mangle_impl_method(im, impl_type, mname)
                    let params = format_impl_params(m, impl_type)
                    let enum_ret = get_fn_enum_ret(mangled)
                    let ret_tid = cg_node_mono_tid(node_type_ann(m))
                    let pre_len = cg_lines.len()
                    if enum_ret != "" {
                        emit_line("{c_type_from_tag(enum_ret)} {c_fn_name(mangled)}({params});")
                    } else {
                        let ret_str_raw = node_return_type(m)
                        let ret_str = resolve_self_type(ret_str_raw, impl_type)
                        if is_struct_type(ret_str) != 0 {
                            // Mono carrier for a concrete generic-struct instance
                            // method return, matching emit_impl_method_def.
                            let ret_stem = ann_mono_stem(node_type_ann(m))
                            let ret_carrier = if ret_stem != "" { ret_stem } else { ret_str }
                            emit_line("{c_type_c_name(ret_carrier)} {c_fn_name(mangled)}({params});")
                        } else {
                            let resolved = resolve_ret_type_from_ann(m)
                            if resolved != "" {
                                // Return position: void is a legal flat answer, so the tid
                                // leads only when it spells something; empty keeps the flat
                                // carrier. The prototype must match emit_impl_method_def's
                                // guarded def (impl_sig_ret_resolved).
                                let r_spelled = c_type_from_tid(ret_tid)
                                let r_c = if r_spelled != "" { r_spelled } else { resolved }
                                ctype_probe_at(ret_tid, "impl_proto_ret_resolved", mangled, resolved, m)
                                emit_line("{r_c} {c_fn_name(mangled)}({params});")
                            } else {
                                let ret_type = type_from_name(ret_str)
                                let ret_c = c_type_str(ret_type)
                                let s_spelled = c_type_from_tid(ret_tid)
                                let s_c = if s_spelled != "" { s_spelled } else { ret_c }
                                ctype_probe_at(ret_tid, "impl_proto_ret_scalar", mangled, ret_c, m)
                                emit_line("{s_c} {c_fn_name(mangled)}({params});")
                            }
                        }
                    }
                    if cg_archive_header_mode != 0 {
                        prepend_extern_one(pre_len)
                    }
                    j = j + 1
                }
            }
            i = i + 1
        }
    }
    let pre_derive_len = cg_lines.len()
    // Hash high-water mark before the forward-decl pass. Any tuple/struct Set/Map
    // key registered later (during a fn body — mono or not) misses the extern
    // `kops_<cn>` decl emitted here, so its first user (e.g. a top-emitted mono
    // fn body) references an undeclared symbol. A supplemental sweep after all
    // bodies (below, at the pre-fn buffer restore) covers the delta.
    let pre_body_hash_count = derive_counts_now().hash
    emit_derive_forward_decls()
    // Queue every nested-container Debug walker reachable from a @derive(Debug)
    // type (struct fields via tp_to_descriptor, enum-variant fields via the
    // type-string parser) BEFORE emitting the {T}_debug bodies that call them,
    // then forward-declare the walkers in this same derive forward-decl phase.
    queue_all_debug_types()
    emit_debug_forward_decls()
    emit_display_forward_decls()
    if cg_archive_header_mode != 0 {
        prepend_extern_range(pre_derive_len)
    }
    emit_line("")

    // Emit tuple types discovered during forward declarations, then merge
    let fwd_lines = cg_lines
    cg_lines = pre_fwd_lines
    // Def-side struct-instance carriers registered above: flush their typedefs
    // into the pre-decl region so a fn signature naming blink_Box_Str sees the
    // typedef before its own forward decl. From 0 for the same reason as the
    // first flush; BLINK_TD_ makes the re-covered range a no-op.
    emit_mono_typedefs_from(0)
    emit_tuple_types_from(early_tuple_count)
    early_tuple_count = emitted_tuple_entries.len()
    // Flush Option/Result carriers registered while queuing Debug walkers
    // (queue_all_debug_types) into this pre-fwd buffer so a carrier like
    // blink_Option_PT precedes the debug walker's forward decl that references
    // it. Advance the early_* markers so the later codegen flush
    // (emit_option_result_types_from below) doesn't re-emit them.
    emit_option_result_types_from(early_option_count, early_result_count, early_s_option_count, early_s_result_count)
    early_option_count = emitted_option_types.len()
    early_result_count = emitted_result_types.len()
    early_s_option_count = emitted_struct_option_types.len()
    early_s_result_count = emitted_struct_result_types.len()
    let mut fwd_i = 0
    while fwd_i < fwd_lines.len() {
        cg_lines.push(fwd_lines.get(fwd_i).unwrap())
        fwd_i = fwd_i + 1
    }

    if cg_archive_header_mode != 0 {
        // The earlier top-level-let loop already emitted extern decls for
        // globals (header mode flips emit_top_level_let into decl-only).
        // The stdlib monolith adds the init fn decl the user TU calls; a
        // per-module header (cg_emit_only_module set) does not.
        emit_line("")
        if cg_emit_only_module == "" {
            emit_line("extern void __blink_init_stdlib_globals(void);")
        }
        cg_lines.push("")
        cg_lines.push("#endif")
        pop_scope()
        if trace_mode != "" { trace("codegen", "archive-header done ({cg_lines.len()} lines)") }
        return join_lines()
    }

    // Function definitions (deduplicated) — emit into temp buffer
    // so we can prepend closure defs discovered during emission
    let pre_fn_lines = cg_lines
    cg_lines = []
    emitted_fn_names = []
    emitted_fn_set = Map()
    if fns_sl != -1 {
        let mut i = 0
        while i < sublist_length(fns_sl) {
            let fn_node = sublist_get(fns_sl, i)
            let fn_name = node_name(fn_node)
            let fn_mod = node_module(fn_node)
            let fn_src_mod_d = node_source_module(fn_node)
            let fn_is_eff_d = fn_is_archive_excluded(fn_node)
            if cg_archive_build_mode != 0 && fn_is_eff_d {
                i = i + 1
                continue
            }
            let fn_keep_for_user_d = cg_user_tu_mode != 0 && fn_is_eff_d
            if skip_module(fn_src_mod_d) && !fn_keep_for_user_d {
                i = i + 1
                continue
            }
            let emit_key = make_emit_key(fn_mod, fn_name)
            if emitted_fn_set.contains_key(emit_key) == 0 && is_generic_fn(fn_name) == 0 {
                emit_fn_def(fn_node)
                emit_line("")
                emitted_fn_names.push(fn_name)
                emitted_fn_set.insert(emit_key, 1)
                emitted_fn_set.insert(fn_name, 1)
            }
            i = i + 1
        }
    }

    // Impl method definitions
    if impls_sl != -1 {
        let mut i = 0
        while i < sublist_length(impls_sl) {
            let im = sublist_get(impls_sl, i)
            let im_mod = node_module(im)
            let im_src_mod_d = node_source_module(im)
            cg_current_module = im_mod
            let impl_type = node_name(im)
            let im_trait = node_trait_name(im)
            let methods_sl = node_methods(im)
            if methods_sl != -1 {
                let mut j = 0
                let im_in_skipped_mod_d = skip_module(im_src_mod_d)
                while j < sublist_length(methods_sl) {
                    let m = sublist_get(methods_sl, j)
                    let m_is_eff_d = fn_is_archive_excluded(m)
                    if cg_archive_build_mode != 0 && m_is_eff_d {
                        j = j + 1
                        continue
                    }
                    if im_in_skipped_mod_d && !m_is_eff_d {
                        j = j + 1
                        continue
                    }
                    // Canonical builtin poly-impl methods are emitted on demand per concrete
                    // T by the deferred mono pass, never eagerly here (an eager emit
                    // would lower T to void).
                    if is_poly_impl_base(mangle_impl_method_q(impl_type, im_trait, node_name(m))) != 0 {
                        j = j + 1
                        continue
                    }
                    emit_impl_method_def(m, impl_type, im)
                    emit_line("")
                    j = j + 1
                }
            }
            i = i + 1
        }
    }

    // Derived function definitions
    emit_derive_fn_defs()
    // Nested-container Debug walkers: emitted AFTER {T}_debug bodies (which they
    // may call for struct elements) and forward-declared above.
    emit_debug_fn_defs()
    emit_display_fn_defs()
    // kops adapter defs must come AFTER _hash/_eq are defined (above) and
    // see the final derive_hash_types list including tuple K discovered
    // during fn-body codegen.
    emit_kops_adapters_late()

    let fn_def_lines = cg_lines
    cg_lines = pre_fn_lines

    // Supplemental kops extern decls for tuple/struct Set/Map keys registered
    // during fn-body emission (after emit_derive_forward_decls ran). Positioned
    // in the top pre-fn region so the decl precedes every referencing body,
    // including a mono fn body emitted by the flush below. The matching
    // definitions come from emit_kops_adapters_late / the flush's adapter emit.
    emit_kops_forward_decls_from(pre_body_hash_count)

    // Emit monomorphized type definitions discovered during function emission
    emit_all_mono_typedefs()

    // Emit tuple type definitions discovered during codegen (skip early ones)
    emit_tuple_types_from(early_tuple_count)

    // Emit Option/Result type definitions discovered during codegen (skip early ones)
    emit_option_result_types_from(early_option_count, early_result_count, early_s_option_count, early_s_result_count)

    // Emit iterator type definitions discovered during codegen
    emit_all_iter_types()

    // Closure defs registered during the mono flush are emitted inside it,
    // before the bodies that reference them; the loop below emits only the
    // pre-mono defs (from non-test fn bodies).
    let pre_mono0_closure_count = cg_closure_defs.len()
    flush_mono_fns_with_typedefs(0)

    // Promote walker forward decls (phase 1): covers walkers needed by
    // non-test fn bodies AND closure bodies. Emitted before closure-def
    // and fn_def_lines append so they precede all callers in the C file.
    emit_promote_forward_decls()

    // Emit closure definitions (lifted from function bodies) before fn defs
    if pre_mono0_closure_count > 0 {
        let mut ci = 0
        while ci < pre_mono0_closure_count {
            cg_lines.push(cg_closure_defs.get(ci).unwrap())
            ci = ci + 1
        }
    }

    // Thread pool global (emitted before function definitions so fns can reference it)
    if cg_uses_async != 0 {
        emit_line("static blink_threadpool* __blink_pool;")
        emit_line("")
    }

    // Now append the function definitions
    let mut fi = 0
    while fi < fn_def_lines.len() {
        cg_lines.push(fn_def_lines.get(fi).unwrap())
        fi = fi + 1
    }

    // Emit test functions into temp buffer so we can prepend closure defs
    let tests_sl = node_captures(program)
    let mut test_names: List[Str] = []
    let mut test_c_names: List[Str] = []
    let mut test_all_tags: List[Str] = []
    let mut test_tag_offsets: List[Int] = []
    let mut test_tag_counts: List[Int] = []
    let mut test_xfail_reasons: List[Str] = []
    let pre_test_lines = cg_lines
    let pre_test_closure_count = cg_closure_defs.len()
    let pre_test_mono_td_count = mono_instances.len()
    let pre_test_mono_fn_count = mono_fns.len()
    let pre_test_option_count = emitted_option_types.len()
    let pre_test_result_count = emitted_result_types.len()
    let pre_test_s_option_count = emitted_struct_option_types.len()
    let pre_test_s_result_count = emitted_struct_result_types.len()
    let pre_test_iter_count = emitted_iter_types.len()
    let pre_test_map_iter_count = emitted_map_iters.len()
    let pre_test_filter_iter_count = emitted_filter_iters.len()
    let pre_test_take_iter_count = emitted_take_iters.len()
    let pre_test_skip_iter_count = emitted_skip_iters.len()
    let pre_test_chain_iter_count = emitted_chain_iters.len()
    let pre_test_flat_map_iter_count = emitted_flat_map_iters.len()
    // The per-carrier compound adapter registries need the same per-test snapshot
    // so the test-block flush re-emits only the NEW compound adapters (the static
    // _next fn is outside the typedef guard — draining from 0 would redefine
    // adapters already emitted in the main pass).
    let pre_test_map_iter_c_count = emitted_map_iters_c.len()
    let pre_test_filter_iter_c_count = emitted_filter_iters_c.len()
    let pre_test_take_iter_c_count = emitted_take_iters_c.len()
    let pre_test_skip_iter_c_count = emitted_skip_iters_c.len()
    let pre_test_chain_iter_c_count = emitted_chain_iters_c.len()
    let pre_test_flat_map_iter_c_count = emitted_flat_map_iters_c.len()
    let pre_test_tuple_count = emitted_tuple_entries.len()
    let pre_test_range_iter = emitted_range_iter
    let pre_test_str_iter = emitted_str_iter
    let pre_test_async = cg_uses_async
    // Derives (and their kops adapters) discovered only inside a test body —
    // e.g. a tuple/struct Set element — register too late for the main
    // emit_derive_fn_defs/emit_kops_adapters_late above. Capture the pre-test
    // high-water marks so the test-block flush emits just the new ones.
    let pre_test_derive_counts = derive_counts_now()
    cg_lines = []
    cg_current_module = "__main__"
    if tests_sl != -1 {
        let mut ti = 0
        while ti < sublist_length(tests_sl) {
            let tb = sublist_get(tests_sl, ti)
            let tname = node_name(tb)
            let tbody = node_body(tb)
            let sanitized = sanitize_test_name(tname)
            let c_name = "blink_test_{sanitized}"
            test_names.push(tname)
            test_c_names.push(c_name)
            let tag_offset = test_all_tags.len()
            let tb_anns = node_handlers(tb)
            if tb_anns != -1 {
                let mut tai = 0
                while tai < sublist_length(tb_anns) {
                    let ann = sublist_get(tb_anns, tai)
                    if node_name(ann) == "tags" {
                        let tag_args_sl = node_args(ann)
                        if tag_args_sl != -1 {
                            let mut tgi = 0
                            while tgi < sublist_length(tag_args_sl) {
                                let tag_nd = sublist_get(tag_args_sl, tgi)
                                test_all_tags.push(node_name(tag_nd))
                                tgi = tgi + 1
                            }
                        }
                    }
                    tai = tai + 1
                }
            }
            test_tag_offsets.push(tag_offset)
            test_tag_counts.push(test_all_tags.len() - tag_offset)
            if node_int_val(tb) != 0 {
                test_xfail_reasons.push("br:{node_xfail_ticket(tb)} — {node_xfail_reason(tb)}")
            } else {
                test_xfail_reasons.push("")
            }
            push_scope()
            cg_current_fn_name = "__test_{sanitized}"
            cg_current_fn_has_ev = 0
            cg_current_fn_ret = CT_VOID
            // A test body is a void fn with no return annotation, emitted inline here
            // (emit_line/emit_block) rather than through emit_fn_def. emit_fn_def and
            // emit_impl_method_def now save/restore cg_current_fn_node, so it should
            // already be -1 by this loop — but this path does not run through them, so
            // clear it explicitly at the point it matters: a bare tuple literal in the
            // body would otherwise adopt an enclosing fn's return annotation via
            // emit_tuple_lit's Tuple-return branch and collapse onto its carrier. The
            // clear localizes that invariant to the test-body path.
            let saved_test_fn_node = cg_current_fn_node
            cg_current_fn_node = -1
            cg_in_test_body = 1
            mut_captured_vars = []
            prescan_mut_captures(tbody)
            emit_line("static void {c_name}(void) \{")
            cg_indent = cg_indent + 1
            emit_block(tbody)
            cg_indent = cg_indent - 1
            emit_line("}")
            emit_line("")
            cg_in_test_body = 0
            cg_current_fn_node = saved_test_fn_node
            pop_scope()
            ti = ti + 1
        }
    }
    let test_fn_lines = cg_lines
    cg_lines = pre_test_lines

    // Flush type defs discovered during test block emission
    emit_mono_typedefs_from(pre_test_mono_td_count)
    emit_tuple_types_from(pre_test_tuple_count)
    emit_option_result_types_from(pre_test_option_count, pre_test_result_count, pre_test_s_option_count, pre_test_s_result_count)
    emit_iter_types_from(pre_test_iter_count, pre_test_map_iter_count, pre_test_filter_iter_count, pre_test_take_iter_count, pre_test_skip_iter_count, pre_test_chain_iter_count, pre_test_flat_map_iter_count, pre_test_map_iter_c_count, pre_test_filter_iter_c_count, pre_test_take_iter_c_count, pre_test_skip_iter_c_count, pre_test_chain_iter_c_count, pre_test_flat_map_iter_c_count)
    if emitted_range_iter != 0 && pre_test_range_iter == 0 {
        emit_range_iter_typedef()
    }
    if emitted_str_iter != 0 && pre_test_str_iter == 0 {
        emit_str_iter_typedef()
    }

    // Flush derive fn defs + kops adapters discovered during test-block emission.
    // Order matters — the _hash/_eq bodies must precede the kops adapters that
    // reference them, and both must precede the test_fn_lines append below (a
    // test body that references kops_<type>).
    emit_derive_fn_defs_from(pre_test_derive_counts)
    emit_kops_adapters_from(pre_test_derive_counts.hash)

    // Closure defs registered during this mono flush are emitted inside it,
    // before the bodies that reference them; the loop below emits only the
    // defs discovered during test-body emission.
    let pre_test_mono_closure_count = cg_closure_defs.len()
    flush_mono_fns_with_typedefs(pre_test_mono_fn_count)

    // Promote walker forward decls (phase 2): emits only new walkers
    // queued since phase 1 (tracks a high-water mark internally).
    // Emitted before test closure-defs and test_fn_lines append so they
    // precede all callers in the C file.
    emit_promote_forward_decls()

    // Flush closure defs discovered during test block emission
    if pre_test_mono_closure_count > pre_test_closure_count {
        let mut tci = pre_test_closure_count
        while tci < pre_test_mono_closure_count {
            cg_lines.push(cg_closure_defs.get(tci).unwrap())
            tci = tci + 1
        }
    }

    // Thread pool global discovered during test block emission
    if cg_uses_async != 0 && pre_test_async == 0 {
        emit_line("static blink_threadpool* __blink_pool;")
        emit_line("")
    }

    // Now append the test function definitions
    let mut tfi = 0
    while tfi < test_fn_lines.len() {
        cg_lines.push(test_fn_lines.get(tfi).unwrap())
        tfi = tfi + 1
    }

    // Promote walker bodies — emit once here, after fn_defs and tests
    // have both populated the promote_types queue. Forward decls were
    // emitted earlier (in two phases, each preceding its closure-def and
    // fn/test_fn_lines append) so callers can see them.
    emit_promote_fn_defs()

    let mut cpi = 0
    while cpi < cg_closure_promoter_defs.len() {
        cg_lines.push(cg_closure_promoter_defs.get(cpi).unwrap())
        cpi = cpi + 1
    }

    // Emit test registry and runner
    let test_count = test_names.len()
    if test_count > 0 {
        let mut tti = 0
        while tti < test_count {
            let tag_count = test_tag_counts.get(tti).unwrap()
            if tag_count > 0 {
                let tcn = test_c_names.get(tti).unwrap()
                let mut tag_arr = "static const char* {tcn}_tags[] = \{"
                let mut tgi = 0
                while tgi < tag_count {
                    if tgi > 0 {
                        tag_arr = tag_arr.concat(", ")
                    }
                    let tag_idx = test_tag_offsets.get(tti).unwrap() + tgi
                    let tag_val = test_all_tags.get(tag_idx).unwrap()
                    tag_arr = tag_arr.concat("\"").concat(tag_val).concat("\"")
                    tgi = tgi + 1
                }
                tag_arr = tag_arr.concat("};")
                emit_line(tag_arr)
            }
            tti = tti + 1
        }
        emit_line("static const blink_test_entry __blink_tests[] = \{")
        cg_indent = cg_indent + 1
        let mut tri = 0
        while tri < test_count {
            let tn = test_names.get(tri).unwrap()
            let tcn = test_c_names.get(tri).unwrap()
            let comma = if tri < test_count - 1 { "," } else { "" }
            let tc = test_tag_counts.get(tri).unwrap()
            let xfail_reason = test_xfail_reasons.get(tri).unwrap()
            let xfail_flag = if xfail_reason != "" { 1 } else { 0 }
            let xfail_reason_c = if xfail_flag != 0 {
                "\"{escape_c_string(xfail_reason)}\""
            } else {
                "NULL"
            }
            let tn_c = escape_c_string(tn)
            if tc > 0 {
                emit_line("\{\"{tn_c}\", {tcn}, __FILE__, 0, 0, {tcn}_tags, {tc}, {xfail_flag}, {xfail_reason_c}}{comma}")
            } else {
                emit_line("\{\"{tn_c}\", {tcn}, __FILE__, 0, 0, NULL, 0, {xfail_flag}, {xfail_reason_c}}{comma}")
            }
            tri = tri + 1
        }
        cg_indent = cg_indent - 1
        emit_line("};")
        emit_line("")
        emit_line("static void __blink_run_tests(int argc, const char** argv) \{")
        cg_indent = cg_indent + 1
        emit_line("blink_test_run(__blink_tests, {test_count}, argc, argv);")
        cg_indent = cg_indent - 1
        emit_line("}")
        emit_line("")
    }

    // Global init function (if needed). The archive monolith exports its
    // init under a distinct name so the user TU can call both its own
    // local init and the stdlib's. Per-module-object mode does the same
    // for every module: each .c exposes `__blink_init_<mod>_globals` so
    // the entry-point TU can dispatch them in module order. Always emit
    // the function in per-module mode (even when empty) so __main__ can
    // call it without first knowing which modules carry inits.
    let in_pm_object = in_per_module_object() && cg_archive_build_mode == 0
    let needs_init_emit = cg_global_inits.len() > 0 || in_pm_object
    if needs_init_emit {
        let init_decl = if cg_archive_build_mode != 0 {
            "void __blink_init_stdlib_globals(void) \{"
        } else if in_pm_object {
            "void __blink_init_{cg_emit_only_module}_globals(void) \{"
        } else {
            "static void __blink_init_globals(void) \{"
        }
        emit_line(init_decl)
        let mut gi = 0
        while gi < cg_global_inits.len() {
            cg_lines.push(cg_global_inits.get(gi).unwrap())
            gi = gi + 1
        }
        emit_line("}")
        emit_line("")
    }

    // Archive monolith has no entry point — user TU owns main(). Falls
    // through to the prepend block so SQLite/FFI markers still land here.
    // Per-module object emission: only the __blink_ev owner emits main()
    // (cg_blink_ev_extern_only==0 marks the owner). Non-owner modules see
    // the entry-point's `fn main` as filtered-out anyway, but still need
    // to skip the synthesized main() shell to avoid ODR collisions at link.
    let suppress_main_shell = if cg_emit_only_module != "" && cg_blink_ev_extern_only != 0 { 1 } else { 0 }
    if cg_archive_build_mode == 0 && suppress_main_shell == 0 {
        emit_line("int main(int argc, char** argv) \{")
        cg_indent = cg_indent + 1
        emit_line("GC_INIT();")
        emit_line("blink_map_init_seed({cg_deterministic});")
        emit_line("blink_g_argc = argc;")
        emit_line("blink_g_argv = (const char**)argv;")
        emit_line("__blink_ev = blink_ev_default();")
        if cg_trace_codegen != 0 {
            emit_line("blink_trace_init(argc, argv);")
        }
        if cg_uses_async != 0 {
            emit_line("__blink_pool = blink_threadpool_init(4);")
        }
        // Stdlib init must run before user init: user globals may
        // reference stdlib state (e.g. construct lists whose ctors hit
        // stdlib helpers).
        if cg_user_tu_mode != 0 {
            emit_line("__blink_init_stdlib_globals();")
        }
        // Per-module-object mode: dispatch each module's init in module
        // order (deterministic via enumerate_program_modules). __main__ is
        // called last so it can reference state initialized by stdlib +
        // user-side modules. Externs are emitted ahead-of-call.
        if in_pm_object {
            let pm_modules = enumerate_program_modules(program)
            let mut pmi = 0
            while pmi < pm_modules.len() {
                let pm_m = pm_modules.get(pmi).unwrap()
                if pm_m != cg_emit_only_module {
                    emit_line("extern void __blink_init_{pm_m}_globals(void);")
                }
                pmi = pmi + 1
            }
            pmi = 0
            while pmi < pm_modules.len() {
                let pm_m = pm_modules.get(pmi).unwrap()
                if pm_m != cg_emit_only_module {
                    emit_line("__blink_init_{pm_m}_globals();")
                }
                pmi = pmi + 1
            }
            emit_line("__blink_init_{cg_emit_only_module}_globals();")
        } else if cg_global_inits.len() > 0 {
            emit_line("__blink_init_globals();")
        }
        let has_main = is_emitted_fn("main")
        if test_count > 0 && has_main != 0 {
            emit_line("for (int i = 1; i < argc; i++) \{")
            cg_indent = cg_indent + 1
            emit_line("if (strcmp(argv[i], \"--test\") == 0) \{")
            cg_indent = cg_indent + 1
            emit_line("__blink_run_tests(argc, (const char**)argv);")
            if cg_uses_async != 0 {
                emit_line("blink_threadpool_shutdown(__blink_pool);")
            }
            emit_line("return 0;")
            cg_indent = cg_indent - 1
            emit_line("}")
            cg_indent = cg_indent - 1
            emit_line("}")
        }
        if has_main != 0 {
            emit_line("blink_main(&__blink_ev);")
        } else if test_count > 0 {
            emit_line("__blink_run_tests(argc, (const char**)argv);")
        }
        if cg_uses_async != 0 {
            emit_line("blink_threadpool_shutdown(__blink_pool);")
        }
        emit_line("return 0;")
        cg_indent = cg_indent - 1
        emit_line("}")
    }

    pop_scope()

    let mut prepend = ""
    if cg_ffi_libs.len() > 0 {
        let mut ffi_idx = 0
        while ffi_idx < cg_ffi_libs.len() {
            prepend = prepend.concat("// BLINK_FFI_LIB:").concat(cg_ffi_libs.get(ffi_idx).unwrap()).concat("\n")
            ffi_idx = ffi_idx + 1
        }
    }
    if cg_used_native_deps.len() > 0 {
        let dep_keys = cg_used_native_deps.keys()
        let mut di = 0
        while di < dep_keys.len() {
            let gate = stdlib_native_dep_gate_macro(dep_keys.get(di).unwrap())
            if gate != "" {
                prepend = prepend.concat("#define ").concat(gate).concat(" 1\n")
            }
            di = di + 1
        }
    }
    if prepend != "" {
        cg_lines.set(0, prepend.concat(cg_lines.get(0).unwrap()))
    }

    // Triage every slot contradiction merge_arg_tids recorded during this emit. Runs
    // after all emission on purpose — see tc_classify_mono_conflicts for why late
    // spelling is the conservative direction — and unconditionally, since the
    // same_type/diff_type counters must reflect the full emit, not a partial one.
    tc_classify_mono_conflicts()

    // One summary line per instrumented read site, gated on the channel so it costs
    // one check when nobody is measuring. The counter is never reset here, so a
    // multi-module build accumulates across generate() calls instead of reporting
    // only the last one.
    ty_divergence_dump()

    if trace_mode != "" { trace("codegen", "done ({cg_lines.len()} lines)") }
    join_lines()
}

@allow(UnrestoredMutation, IncompleteStateRestore)
pub fn generate_archive_header(program: Int) -> Str ! Codegen, Diag.Report {
    cg_archive_header_mode = 1
    let out = generate(program)
    cg_archive_header_mode = 0
    out
}

// Emit a header (.h) for a single module: extern decls + typedefs only,
// no fn/let definitions. The header guard is "BLINK_MOD_<module_key>_H".
// Composes with cg_archive_header_mode so the existing header pipeline
// runs unchanged; cg_emit_only_module narrows emission to one module.
@allow(UnrestoredMutation, IncompleteStateRestore)
pub fn generate_module_header(program: Int, module_key: Str) -> Str ! Codegen, Diag.Report {
    cg_archive_header_mode = 1
    cg_emit_only_module = module_key
    cg_module_header_guard = "BLINK_MOD_{module_key}_H"
    let out = generate(program)
    cg_archive_header_mode = 0
    cg_emit_only_module = ""
    cg_module_header_guard = ""
    out
}

// Emit a translation unit (.c) for a single module: definitions only, with
// `#include "<module>.h"` so it picks up its own typedefs and extern decls.
// The caller is responsible for emitting per-dependency `#include`s — this
// entry point only handles the self-include.
@allow(UnrestoredMutation, IncompleteStateRestore)
pub fn generate_module_object(program: Int, module_key: Str, self_header: Str) -> Str ! Codegen, Diag.Report {
    cg_emit_only_module = module_key
    cg_module_object_self_header = self_header
    let out = generate(program)
    cg_emit_only_module = ""
    cg_module_object_self_header = ""
    out
}

// Returns unique source_module keys in first-seen AST traversal order.
// The driver in cli.bl uses this set to decide which per-module .h/.c
// outputs to emit, and the order also drives aggregator #include order.
// First-seen order is topologically friendly: types tend to be defined
// before they're referenced, so the aggregator's #include sequence
// matches forward-decl needs. Sorting alphabetically would break this
// (e.g. codegen_stmt.h would precede codegen_types.h that defines
// CaptureEntry).
//
// Determinism: AST construction is deterministic given deterministic
// file inputs (imports processed in source order, files read on demand).
// Empty keys (synthesized builtins) are skipped — they ride in the
// program-aggregator TU.
pub fn enumerate_program_modules(program: Int) -> List[Str] {
    let mut seen: Map[Str, Int] = Map()
    let mut out: List[Str] = []

    let sublists: List[Int] = [
        node_fields(program),
        node_stmts(program),
        node_params(program),
        node_arms(program),
        node_methods(program),
    ]

    let mut s = 0
    while s < sublists.len() {
        let sl = sublists.get(s).unwrap()
        if sl != -1 {
            let mut i = 0
            while i < sublist_length(sl) {
                let k = node_source_module(sublist_get(sl, i))
                if k != "" && seen.contains_key(k) == 0 {
                    seen.insert(k, 1)
                    out.push(k)
                }
                i = i + 1
            }
        }
        s = s + 1
    }

    out
}
