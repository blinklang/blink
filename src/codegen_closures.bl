// ── Helpers ─────────────────────────────────────────────────────────

fn collect_pat_names(node: Int, target: List[Str]) {
    let pat_sl = node_elements(node)
    if pat_sl == -1 { return }
    let elems_sl = node_elements(pat_sl)
    if elems_sl == -1 { return }
    let mut i = 0
    while i < sublist_length(elems_sl) {
        let sp = sublist_get(elems_sl, i)
        target.push(node_name(sp))
        i = i + 1
    }
}

// ── Capture analysis ────────────────────────────────────────────────
// Walk a closure body AST collecting free variable references.

fn collect_free_vars(node: Int, params: List[Str], locals: List[Str], result: List[Str]) {
    if node == -1 {
        return
    }
    let kind = node_kind(node)

    if kind == NodeKind.Ident {
        let name = node_name(node)
        if list_contains_str(params, name) {
            return
        }
        if list_contains_str(locals, name) {
            return
        }
        if list_contains_str(result, name) {
            return
        }
        if is_emitted_fn(name) {
            return
        }
        if resolve_variant(name) != "" {
            return
        }
        if is_enum_type(name) != 0 {
            return
        }
        if is_struct_type(name) != 0 {
            return
        }
        if fn_regs_idx.contains_key(name) {
            return
        }
        if is_scope_var(name) != 0 {
            result.push(name)
        }
        return
    }

    if kind == NodeKind.BinOp {
        collect_free_vars(node_left(node), params, locals, result)
        collect_free_vars(node_right(node), params, locals, result)
        return
    }

    if kind == NodeKind.UnaryOp {
        collect_free_vars(node_left(node), params, locals, result)
        return
    }

    if kind == NodeKind.Call {
        collect_free_vars(node_left(node), params, locals, result)
        let args_sl = node_args(node)
        if args_sl != -1 {
            let mut ai = 0
            while ai < sublist_length(args_sl) {
                collect_free_vars(sublist_get(args_sl, ai), params, locals, result)
                ai = ai + 1
            }
        }
        return
    }

    if kind == NodeKind.MethodCall {
        collect_free_vars(node_obj(node), params, locals, result)
        let args_sl = node_args(node)
        if args_sl != -1 {
            let mut ai = 0
            while ai < sublist_length(args_sl) {
                collect_free_vars(sublist_get(args_sl, ai), params, locals, result)
                ai = ai + 1
            }
        }
        return
    }

    if kind == NodeKind.IfExpr {
        collect_free_vars(node_condition(node), params, locals, result)
        collect_free_vars_block(node_then_body(node), params, locals, result)
        collect_free_vars_block(node_else_body(node), params, locals, result)
        return
    }

    if kind == NodeKind.Block {
        collect_free_vars_block(node, params, locals, result)
        return
    }

    if kind == NodeKind.LetBinding {
        collect_free_vars(node_value(node), params, locals, result)
        let bound_name = node_name(node)
        if !list_contains_str(locals, bound_name) {
            locals.push(bound_name)
        }
        collect_pat_names(node, locals)
        return
    }

    if kind == NodeKind.ForIn {
        collect_free_vars(node_iterable(node), params, locals, result)
        let vn = node_var_name(node)
        let mut inner_locals: List[Str] = []
        let mut li = 0
        while li < locals.len() {
            inner_locals.push(locals.get(li).unwrap())
            li = li + 1
        }
        inner_locals.push(vn)
        collect_pat_names(node, inner_locals)
        collect_free_vars_block(node_body(node), params, inner_locals, result)
        return
    }

    if kind == NodeKind.WhileLoop {
        collect_free_vars(node_condition(node), params, locals, result)
        collect_free_vars_block(node_body(node), params, locals, result)
        return
    }

    if kind == NodeKind.LoopExpr {
        collect_free_vars_block(node_body(node), params, locals, result)
        return
    }

    if kind == NodeKind.Return {
        collect_free_vars(node_value(node), params, locals, result)
        return
    }

    if kind == NodeKind.ExprStmt {
        collect_free_vars(node_value(node), params, locals, result)
        return
    }

    if kind == NodeKind.Assignment {
        collect_free_vars(node_target(node), params, locals, result)
        collect_free_vars(node_value(node), params, locals, result)
        return
    }

    if kind == NodeKind.CompoundAssign {
        collect_free_vars(node_target(node), params, locals, result)
        collect_free_vars(node_value(node), params, locals, result)
        return
    }

    if kind == NodeKind.MatchExpr {
        collect_free_vars(node_scrutinee(node), params, locals, result)
        let arms_sl = node_arms(node)
        if arms_sl != -1 {
            let mut ai = 0
            while ai < sublist_length(arms_sl) {
                let arm = sublist_get(arms_sl, ai)
                collect_free_vars(node_guard(arm), params, locals, result)
                collect_free_vars(node_body(arm), params, locals, result)
                ai = ai + 1
            }
        }
        return
    }

    if kind == NodeKind.FieldAccess {
        collect_free_vars(node_obj(node), params, locals, result)
        return
    }

    if kind == NodeKind.IndexExpr {
        collect_free_vars(node_obj(node), params, locals, result)
        collect_free_vars(node_index(node), params, locals, result)
        return
    }

    if kind == NodeKind.InterpString {
        let parts_sl = node_elements(node)
        if parts_sl != -1 {
            let mut pi = 0
            while pi < sublist_length(parts_sl) {
                let part = sublist_get(parts_sl, pi)
                if node_kind(part) != NodeKind.Ident || node_str_val(part) == "" {
                    collect_free_vars(part, params, locals, result)
                }
                pi = pi + 1
            }
        }
        return
    }

    if kind == NodeKind.Closure {
        return
    }

    if kind == NodeKind.ListLit {
        let elems_sl = node_elements(node)
        if elems_sl != -1 {
            let mut ei = 0
            while ei < sublist_length(elems_sl) {
                collect_free_vars(sublist_get(elems_sl, ei), params, locals, result)
                ei = ei + 1
            }
        }
        return
    }

    if kind == NodeKind.StructLit {
        let flds_sl = node_fields(node)
        if flds_sl != -1 {
            let mut fi = 0
            while fi < sublist_length(flds_sl) {
                let sf = sublist_get(flds_sl, fi)
                collect_free_vars(node_value(sf), params, locals, result)
                fi = fi + 1
            }
        }
        return
    }

    if kind == NodeKind.TupleLit {
        let elems_sl = node_elements(node)
        if elems_sl != -1 {
            let mut ei = 0
            while ei < sublist_length(elems_sl) {
                collect_free_vars(sublist_get(elems_sl, ei), params, locals, result)
                ei = ei + 1
            }
        }
        return
    }

    if kind == NodeKind.RangeLit {
        collect_free_vars(node_start(node), params, locals, result)
        collect_free_vars(node_end(node), params, locals, result)
        return
    }

    if kind == NodeKind.WithBlock {
        let wh_sl = node_handlers(node)
        if wh_sl != -1 {
            let mut hi = 0
            while hi < sublist_length(wh_sl) {
                let hitem = sublist_get(wh_sl, hi)
                if node_kind(hitem) == NodeKind.WithResource {
                    collect_free_vars(node_value(hitem), params, locals, result)
                } else {
                    collect_free_vars(hitem, params, locals, result)
                }
                hi = hi + 1
            }
        }
        collect_free_vars_block(node_body(node), params, locals, result)
        return
    }

    if kind == NodeKind.WithResource {
        collect_free_vars(node_value(node), params, locals, result)
        return
    }
}

fn collect_free_vars_block(block: Int, params: List[Str], locals: List[Str], result: List[Str]) {
    if block == -1 {
        return
    }
    let stmts_sl = node_stmts(block)
    if stmts_sl == -1 {
        return
    }
    let mut block_locals: List[Str] = []
    let mut li = 0
    while li < locals.len() {
        block_locals.push(locals.get(li).unwrap())
        li = li + 1
    }
    let mut si = 0
    while si < sublist_length(stmts_sl) {
        collect_free_vars(sublist_get(stmts_sl, si), params, block_locals, result)
        si = si + 1
    }
}

pub fn analyze_captures(body: Int, params_sl: Int) -> List[Str] {
    let mut param_names: List[Str] = []
    if params_sl != -1 {
        let mut i = 0
        while i < sublist_length(params_sl) {
            let p = sublist_get(params_sl, i)
            param_names.push(node_name(p))
            i = i + 1
        }
    }
    let mut locals: List[Str] = []
    let mut result: List[Str] = []
    collect_free_vars_block(body, param_names, locals, result)
    result
}

// Prescan: collect all let-mut names from a block (non-recursive into closures)
let mut prescan_mut_names: List[Str] = []

fn prescan_collect_muts(node: Int) {
    if node == -1 {
        return
    }
    let kind = node_kind(node)
    if kind == NodeKind.LetBinding {
        if node_is_mut(node) != 0 {
            prescan_mut_names.push(node_name(node))
            collect_pat_names(node, prescan_mut_names)
        }
        // Recurse into the RHS: a `let g = { let mut c = 0; … }` or
        // `let g = with arena { let mut c = 0; … }` hides block-local mut
        // bindings whose closure captures need cell-box treatment.
        prescan_collect_muts(node_value(node))
        return
    }
    if kind == NodeKind.ExprStmt {
        prescan_collect_muts(node_value(node))
        return
    }
    if kind == NodeKind.Block {
        prescan_collect_muts_block(node)
        return
    }
    if kind == NodeKind.IfExpr {
        prescan_collect_muts_block(node_then_body(node))
        prescan_collect_muts_block(node_else_body(node))
        return
    }
    if kind == NodeKind.WhileLoop {
        prescan_collect_muts_block(node_body(node))
        return
    }
    if kind == NodeKind.ForIn {
        prescan_collect_muts_block(node_body(node))
        return
    }
    if kind == NodeKind.LoopExpr {
        prescan_collect_muts_block(node_body(node))
        return
    }
    if kind == NodeKind.WithBlock {
        prescan_collect_muts_block(node_body(node))
        return
    }
}

fn prescan_collect_muts_block(block: Int) {
    if block == -1 {
        return
    }
    let stmts_sl = node_stmts(block)
    if stmts_sl == -1 {
        return
    }
    let mut i = 0
    while i < sublist_length(stmts_sl) {
        prescan_collect_muts(sublist_get(stmts_sl, i))
        i = i + 1
    }
}

// Prescan: collect all idents used inside closure bodies
let mut prescan_closure_idents: List[Str] = []

fn prescan_collect_closure_idents(node: Int) {
    if node == -1 {
        return
    }
    let kind = node_kind(node)
    if kind == NodeKind.Ident {
        prescan_closure_idents.push(node_name(node))
        return
    }
    if kind == NodeKind.BinOp {
        prescan_collect_closure_idents(node_left(node))
        prescan_collect_closure_idents(node_right(node))
        return
    }
    if kind == NodeKind.UnaryOp {
        prescan_collect_closure_idents(node_left(node))
        return
    }
    if kind == NodeKind.Call {
        prescan_collect_closure_idents(node_left(node))
        let args_sl = node_args(node)
        if args_sl != -1 {
            let mut ai = 0
            while ai < sublist_length(args_sl) {
                prescan_collect_closure_idents(sublist_get(args_sl, ai))
                ai = ai + 1
            }
        }
        return
    }
    if kind == NodeKind.MethodCall {
        prescan_collect_closure_idents(node_obj(node))
        let args_sl = node_args(node)
        if args_sl != -1 {
            let mut ai = 0
            while ai < sublist_length(args_sl) {
                prescan_collect_closure_idents(sublist_get(args_sl, ai))
                ai = ai + 1
            }
        }
        return
    }
    if kind == NodeKind.Assignment {
        prescan_collect_closure_idents(node_target(node))
        prescan_collect_closure_idents(node_value(node))
        return
    }
    if kind == NodeKind.CompoundAssign {
        prescan_collect_closure_idents(node_target(node))
        prescan_collect_closure_idents(node_value(node))
        return
    }
    if kind == NodeKind.LetBinding {
        prescan_collect_closure_idents(node_value(node))
        return
    }
    if kind == NodeKind.ExprStmt {
        prescan_collect_closure_idents(node_value(node))
        return
    }
    if kind == NodeKind.Return {
        prescan_collect_closure_idents(node_value(node))
        return
    }
    if kind == NodeKind.Block {
        prescan_collect_closure_idents_block(node)
        return
    }
    if kind == NodeKind.IfExpr {
        prescan_collect_closure_idents(node_condition(node))
        prescan_collect_closure_idents_block(node_then_body(node))
        prescan_collect_closure_idents_block(node_else_body(node))
        return
    }
    if kind == NodeKind.WhileLoop {
        prescan_collect_closure_idents(node_condition(node))
        prescan_collect_closure_idents_block(node_body(node))
        return
    }
    if kind == NodeKind.ForIn {
        prescan_collect_closure_idents(node_iterable(node))
        prescan_collect_closure_idents_block(node_body(node))
        return
    }
    if kind == NodeKind.LoopExpr {
        prescan_collect_closure_idents_block(node_body(node))
        return
    }
    if kind == NodeKind.InterpString {
        let parts_sl = node_elements(node)
        if parts_sl != -1 {
            let mut pi = 0
            while pi < sublist_length(parts_sl) {
                prescan_collect_closure_idents(sublist_get(parts_sl, pi))
                pi = pi + 1
            }
        }
        return
    }
    if kind == NodeKind.FieldAccess {
        prescan_collect_closure_idents(node_obj(node))
        return
    }
    if kind == NodeKind.IndexExpr {
        prescan_collect_closure_idents(node_obj(node))
        prescan_collect_closure_idents(node_index(node))
        return
    }
    if kind == NodeKind.MatchExpr {
        prescan_collect_closure_idents(node_scrutinee(node))
        let arms_sl = node_arms(node)
        if arms_sl != -1 {
            let mut ai = 0
            while ai < sublist_length(arms_sl) {
                let arm = sublist_get(arms_sl, ai)
                prescan_collect_closure_idents(node_body(arm))
                ai = ai + 1
            }
        }
        return
    }
}

fn prescan_collect_closure_idents_block(block: Int) {
    if block == -1 {
        return
    }
    let stmts_sl = node_stmts(block)
    if stmts_sl == -1 {
        return
    }
    let mut i = 0
    while i < sublist_length(stmts_sl) {
        prescan_collect_closure_idents(sublist_get(stmts_sl, i))
        i = i + 1
    }
}

// Walk function body looking for closures; for each, collect idents used in body
fn prescan_closures_in_node(node: Int) {
    if node == -1 {
        return
    }
    let kind = node_kind(node)

    if kind == NodeKind.Closure {
        prescan_collect_closure_idents_block(node_body(node))
        return
    }

    if kind == NodeKind.Block {
        prescan_closures_in_block(node)
        return
    }

    if kind == NodeKind.LetBinding {
        prescan_closures_in_node(node_value(node))
        return
    }

    if kind == NodeKind.ExprStmt {
        prescan_closures_in_node(node_value(node))
        return
    }

    if kind == NodeKind.Assignment {
        prescan_closures_in_node(node_value(node))
        return
    }

    if kind == NodeKind.CompoundAssign {
        prescan_closures_in_node(node_value(node))
        return
    }

    if kind == NodeKind.IfExpr {
        prescan_closures_in_node(node_condition(node))
        prescan_closures_in_block(node_then_body(node))
        prescan_closures_in_block(node_else_body(node))
        return
    }

    if kind == NodeKind.WhileLoop {
        prescan_closures_in_node(node_condition(node))
        prescan_closures_in_block(node_body(node))
        return
    }

    if kind == NodeKind.ForIn {
        prescan_closures_in_node(node_iterable(node))
        prescan_closures_in_block(node_body(node))
        return
    }

    if kind == NodeKind.LoopExpr {
        prescan_closures_in_block(node_body(node))
        return
    }

    if kind == NodeKind.Return {
        prescan_closures_in_node(node_value(node))
        return
    }

    if kind == NodeKind.Call {
        prescan_closures_in_node(node_left(node))
        let args_sl = node_args(node)
        if args_sl != -1 {
            let mut ai = 0
            while ai < sublist_length(args_sl) {
                prescan_closures_in_node(sublist_get(args_sl, ai))
                ai = ai + 1
            }
        }
        return
    }

    if kind == NodeKind.MethodCall {
        prescan_closures_in_node(node_obj(node))
        let args_sl = node_args(node)
        if args_sl != -1 {
            let mut ai = 0
            while ai < sublist_length(args_sl) {
                prescan_closures_in_node(sublist_get(args_sl, ai))
                ai = ai + 1
            }
        }
        return
    }

    if kind == NodeKind.BinOp {
        prescan_closures_in_node(node_left(node))
        prescan_closures_in_node(node_right(node))
        return
    }

    if kind == NodeKind.UnaryOp {
        prescan_closures_in_node(node_left(node))
        return
    }

    if kind == NodeKind.MatchExpr {
        prescan_closures_in_node(node_scrutinee(node))
        let arms_sl = node_arms(node)
        if arms_sl != -1 {
            let mut ai = 0
            while ai < sublist_length(arms_sl) {
                let arm = sublist_get(arms_sl, ai)
                prescan_closures_in_node(node_body(arm))
                ai = ai + 1
            }
        }
        return
    }

    if kind == NodeKind.WithBlock {
        prescan_closures_in_block(node_body(node))
        return
    }
}

fn prescan_closures_in_block(block: Int) {
    if block == -1 {
        return
    }
    let stmts_sl = node_stmts(block)
    if stmts_sl == -1 {
        return
    }
    let mut i = 0
    while i < sublist_length(stmts_sl) {
        prescan_closures_in_node(sublist_get(stmts_sl, i))
        i = i + 1
    }
}

pub fn prescan_mut_captures(block: Int) {
    prescan_mut_names = []
    prescan_closure_idents = []
    prescan_collect_muts_block(block)
    prescan_closures_in_block(block)
    let mut i = 0
    while i < prescan_mut_names.len() {
        let mname = prescan_mut_names.get(i).unwrap()
        let mut j = 0
        while j < prescan_closure_idents.len() {
            let cident = prescan_closure_idents.get(j).unwrap()
            if mname == cident {
                if list_contains_str(mut_captured_vars, mname) == 0 {
                    mut_captured_vars.push(mname)
                }
            }
            j = j + 1
        }
        i = i + 1
    }
}

// Synthesizes a closure-ABI shim for a bare-fn reference passed where a
// `fn(...)` formal is expected. The shim has signature
// `RET(*)(const blink_closure*, args...)`, drops __self, and forwards to
// the mangled target. For effectful targets it threads `&__blink_ev` —
// the shim sets cg_current_fn_has_ev=0 so ev_arg_for_callee picks the
// global ev fallback rather than emitting an ev param the shim doesn't
// have. Deduped per mangled name; returns the shim's C identifier.
@allow(UnrestoredMutation, IncompleteStateRestore)
pub fn emit_fn_value_shim_if_needed(fn_node: Int, mangled: Str) -> Str ! Codegen.Emit, Diag.Report {
    let cached = cg_fn_shim_emitted.get(mangled)
    if cached.is_some() {
        return cached.unwrap()
    }
    let shim_name = "__fn_shim_{mangled}"
    cg_fn_shim_emitted.insert(mangled, shim_name)

    let blink_name = node_name(fn_node)
    let params_sl = node_params(fn_node)
    let has_ev = fn_node_has_effects(fn_node) != 0

    let mut params_c = "const blink_closure* __self"
    let mut call_args = ""
    let mut have_args = 0
    if params_sl != -1 && sublist_length(params_sl) > 0 {
        let mut i = 0
        while i < sublist_length(params_sl) {
            let p = sublist_get(params_sl, i)
            let ptype = node_type_name(p)
            let pname = "__a{i}"
            params_c = params_c.concat(", ")
            if ptype == "Fn" {
                params_c = params_c.concat("blink_closure* {pname}")
            } else if is_enum_type(ptype) != 0 || is_struct_type(ptype) != 0 {
                let mono = ann_mono_c_type(node_type_ann(p))
                let pc = if mono != "" { mono } else { c_type_c_name(ptype) }
                params_c = params_c.concat("{pc} {pname}")
            } else if ptype == "Tuple" {
                params_c = params_c.concat("{tuple_c_name_from_ann(node_type_ann(p), \"void\")} {pname}")
            } else {
                params_c = params_c.concat("{c_type_str(type_from_name(ptype))} {pname}")
            }
            if have_args != 0 {
                call_args = call_args.concat(", ")
            }
            call_args = call_args.concat(pname)
            have_args = 1
            i = i + 1
        }
    }

    let ret_str = node_return_type(fn_node)
    let ret_type = type_from_name(ret_str)
    let resolved_ret = resolve_ret_type_from_ann(fn_node)
    let mut ret_c_str = if resolved_ret != "" { resolved_ret } else { c_type_str(ret_type) }
    if ret_type == CT_VOID && ret_str != "Void" && ret_str != "" {
        if is_struct_type(ret_str) != 0 || is_enum_type(ret_str) != 0 {
            let ret_mono = ann_mono_c_type(node_type_ann(fn_node))
            ret_c_str = if ret_mono != "" { ret_mono } else { c_type_c_name(ret_str) }
        }
    }

    let saved_fn_has_ev = cg_current_fn_has_ev
    cg_current_fn_has_ev = 0
    let final_call_args = if has_ev != 0 { append_ev_arg(blink_name, call_args) } else { call_args }
    cg_current_fn_has_ev = saved_fn_has_ev

    let is_void_ret = ret_type == CT_VOID && (ret_str == "" || ret_str == "Void")

    cg_closure_defs.push("static {ret_c_str} {shim_name}({params_c});")
    cg_closure_defs.push("static {ret_c_str} {shim_name}({params_c}) \{")
    cg_closure_defs.push("    (void)__self;")
    if is_void_ret != 0 {
        cg_closure_defs.push("    {mangled}({final_call_args});")
    } else {
        cg_closure_defs.push("    return {mangled}({final_call_args});")
    }
    cg_closure_defs.push("}")
    cg_closure_defs.push("")

    shim_name
}

@allow(UnrestoredMutation, IncompleteStateRestore)
pub fn emit_closure(node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let closure_idx = cg_closure_counter
    let cname = "__closure_{closure_idx}"
    cg_closure_counter = cg_closure_counter + 1

    let params_sl = node_params(node)
    let ret_str = node_return_type(node)
    let ret_type = type_from_name(ret_str)

    // Capture analysis: find free variables before switching codegen context
    let captures = analyze_captures(node_body(node), params_sl)
    let cap_start = closure_captures.len()
    let mut cap_i = 0
    while cap_i < captures.len() {
        let cap_name = captures.get(cap_i).unwrap()
        let cap_tp = get_var_tp(cap_name)
        let cap_mut = if list_contains_str(mut_captured_vars, cap_name) != 0 { 1 } else { 0 }
        closure_captures.push(CaptureEntry { name: cap_name, is_mut: cap_mut, tp_id: cap_tp, tid: get_var_ty(cap_name), inner1: get_var_inner1(cap_name), inner2: get_var_inner2(cap_name), ctype: get_var_ctype(cap_name) })
        cap_i = cap_i + 1
    }
    closure_cap_infos.push(ClosureCapInfo { start: cap_start, count: captures.len() })
    closure_lit_cap_idx.insert(node, closure_cap_infos.len() - 1)

    // Build C parameter list: __self first if captures, then user params
    let saved_param_hint = cg_closure_param_type_hint
    let saved_param_hint_tid = cg_closure_param_type_hint_tid
    let mut params_c = "const blink_closure* __self"
    if params_sl != -1 && sublist_length(params_sl) > 0 {
        let mut i = 0
        while i < sublist_length(params_sl) {
            let p = sublist_get(params_sl, i)
            let pname = c_safe_name(node_name(p))
            let ptype = node_type_name(p)
            let hint_tid_c = closure_hint_c(cg_closure_param_type_hint_tid)
            params_c = params_c.concat(", ")
            if ptype == "Fn" {
                params_c = params_c.concat("blink_closure* {pname}")
            } else if ptype == "" {
                // An unannotated param takes its per-position type from the closure's own Fn tid
                // (fold's Int accumulator, distinct from the list element) — this leads, so a
                // position-blind element hint no longer mistypes a param the HOF supplies
                // differently. The call-site element hint is the fallback for a slot the tid
                // cannot name; its own tid still leads its flat CT (c_type_str has no struct arm,
                // so a struct hint spelled `void p` — illegal C). Paired with the cast below.
                let lit_c = closure_lit_param_c(node, i)
                if lit_c != "" {
                    params_c = params_c.concat("{lit_c} {pname}")
                } else if hint_tid_c != "" || (cg_closure_param_type_hint >= 0 && cg_closure_param_type_hint != CT_VOID) {
                    let hint_c = if hint_tid_c != "" { hint_tid_c } else { c_type_str(cg_closure_param_type_hint) }
                    params_c = params_c.concat("{hint_c} {pname}")
                } else {
                    params_c = params_c.concat("{c_type_str(type_from_name(ptype))} {pname}")
                }
            } else if is_enum_type(ptype) != 0 || is_struct_type(ptype) != 0 {
                let mono = ann_mono_c_type(node_type_ann(p))
                let pc = if mono != "" { mono } else { c_type_c_name(ptype) }
                params_c = params_c.concat("{pc} {pname}")
            } else if ptype == "Tuple" {
                params_c = params_c.concat("{tuple_c_name_from_ann(node_type_ann(p), \"void\")} {pname}")
            } else if type_from_name(ptype) == CT_OPTION || type_from_name(ptype) == CT_RESULT {
                // A closure param typed `Option[T]` / `Result[T,E]` must lower to the
                // parameterized carrier (blink_Option_int, …), not the bare `void` that
                // c_type_str(CT_OPTION) yields with no inner.
                let carrier = compound_name_from_ann(node_type_ann(p))
                ensure_carrier_from_tag(carrier)
                params_c = params_c.concat("{c_type_c_name(carrier)} {pname}")
            } else {
                // type_from_name answers CT_VOID for every name it cannot map, a type
                // parameter among them, and `void x` is not a legal C parameter. The tid
                // holds the substituted answer; it declines rather than half-spelling, so an
                // unspellable slot stays on the string below with the cast side, which reads
                // the same producer.
                let p_tid_c = closure_lit_param_c(node, i)
                let ct = type_from_name(ptype)
                let p_ts = if p_tid_c != "" { p_tid_c } else { c_type_str(ct) }
                params_c = params_c.concat("{p_ts} {pname}")
            }
            i = i + 1
        }
    }

    let saved_in_traced = cg_in_traced_fn
    cg_in_traced_fn = 0
    let saved_lines = cg_lines
    let saved_indent = cg_indent
    let saved_temp = cg_temp_counter
    let saved_cap_start = cg_closure_cap_start
    let saved_cap_count = cg_closure_cap_count
    let saved_closure_params = closure_param_names
    let saved_fn_name = cg_current_fn_name
    let saved_fn_has_ev = cg_current_fn_has_ev
    let saved_fn_ret = cg_current_fn_ret
    let saved_fn_option_inner = cg_current_fn_option_inner
    let saved_fn_node = cg_current_fn_node
    let saved_fn_option_inner_struct = cg_current_fn_option_inner_struct
    closure_param_names = []
    cg_lines = []
    cg_indent = 0
    cg_temp_counter = 0
    cg_closure_cap_start = cap_start
    cg_closure_cap_count = captures.len()

    push_scope()
    if params_sl != -1 {
        let mut i = 0
        while i < sublist_length(params_sl) {
            let p = sublist_get(params_sl, i)
            let pname = node_name(p)
            let ptype = node_type_name(p)
            if ptype == "Fn" {
                set_var(pname, CT_CLOSURE, 1)
                let ta = node_type_ann(p)
                if ta != -1 {
                    let sig_str = build_closure_sig_from_type_ann(ta)
                    set_var_closure(pname, sig_str, tc_lookup_node_tid(p))
                }
            } else if ptype == "" && saved_param_hint >= 0 && saved_param_hint != CT_VOID {
                set_var(pname, saved_param_hint, 1)
            } else if type_from_name(ptype) == CT_OPTION {
                // The param binds as an Option carrying its inner from the annotation, so
                // a body `match x { Some(v) => ... }` decodes v.
                set_var(pname, CT_OPTION, 1)
                set_var_option_from_struct_tag(pname, compound_name_from_ann(node_type_ann(p)))
                let optid = closure_lit_param_tid(node, i)
                if optid >= 0 {
                    set_var_ty(pname, optid)
                }
            } else if type_from_name(ptype) == CT_RESULT {
                set_var(pname, CT_RESULT, 1)
                set_var_result_from_struct_tag(pname, compound_name_from_ann(node_type_ann(p)))
                let rtid = closure_lit_param_tid(node, i)
                if rtid >= 0 {
                    set_var_ty(pname, rtid)
                }
            } else if ptype == "Set" {
                set_var(pname, CT_SET, 1)
                let stid = closure_lit_param_tid(node, i)
                if stid >= 0 {
                    set_var_ty(pname, stid)
                }
                let ta = node_type_ann(p)
                if ta != -1 {
                    let elems_sl = node_elements(ta)
                    if elems_sl != -1 && sublist_length(elems_sl) > 0 {
                        let elem_ann = sublist_get(elems_sl, 0)
                        let elem_name = node_name(elem_ann)
                        let elem_ct = type_from_name(elem_name)
                        if elem_ct >= 0 && elem_ct != CT_VOID {
                            set_set_elem_type(pname, elem_ct)
                        } else {
                            recover_set_elem_from_tid(ta, pname)
                        }
                    }
                }
            } else if type_from_name(ptype) == CT_LIST {
                // A named fn stamps its List param's element metadata; a closure param
                // must do the same or the body reads the element back as CT_INT. The
                // param tid comes off the closure's own Fn tid (typecheck publishes it
                // only there, not on the param node), the same producer the signature
                // spells from; the tid ladder carries the nested shape (List/Set/Map/...).
                set_var(pname, CT_LIST, 1)
                let ptid = closure_lit_param_tid(node, i)
                if ptid >= 0 {
                    set_var_ty(pname, ptid)
                    let _ = stamp_list_elem_from_list_tid(ptid, pname)
                }
            } else {
                let param_ct = if is_enum_type(ptype) != 0 { CT_INT } else { type_from_name(ptype) }
                set_var(pname, param_ct, 1)
                let ptid = tc_lookup_node_tid(node_type_ann(p))
                let inst_stem = ann_mono_stem(node_type_ann(p))
                if is_struct_type(ptype) != 0 {
                    // The instance, not the base: field reads against the base's declaration
                    // resolve every generic field to its typevar.
                    let spelled = if inst_stem != "" { inst_stem } else { ptype }
                    set_var_struct(pname, spelled)
                    // Registered here, not in a prepass: register_struct_instance_params runs
                    // before a named fn's body is emitted, but a closure body is emitted
                    // mid-expression, so an instance whose only mention is this param would have
                    // no field entries by the time the body needs them.
                    register_struct_instance_from_tid(ptid)
                    // Lead with the tid like the Option/Result/List param arms above, gated on
                    // a round-trip to the instance name so it never silences a name it cannot
                    // reproduce; the flat sname stays the fallback.
                    let sptid = closure_lit_param_tid(node, i)
                    if tid_spells_struct(sptid, spelled) != 0 { set_var_ty(pname, sptid) }
                }
                if is_enum_type(ptype) != 0 {
                    var_enums.push(VarEnumEntry { name: pname, enum_type: ptype })
                    if inst_stem != "" {
                        register_enum_instance_from_tid(ptid)
                        set_var_struct(pname, inst_stem)
                        // Lead with the tid like the struct arm above: a generic-enum
                        // INSTANCE param (m: Maybe[Int]) carries its mono name on the tid,
                        // gated on a round-trip so it never silences a name it cannot
                        // reproduce. Brings closure enum params to parity with the named-fn
                        // params_measure tap; the flat sname stays the fallback.
                        let eptid = closure_lit_param_tid(node, i)
                        if tid_spells_struct(eptid, inst_stem) != 0 { set_var_ty(pname, eptid) }
                    }
                }
                if ptype == "Tuple" {
                    let ta_t = node_type_ann(p)
                    if ta_t != -1 {
                        let tup_opt = resolve_tuple_ann(ta_t, -1, [])
                        if tup_opt.is_some() {
                            set_var_struct(pname, tup_opt.unwrap())
                        }
                    }
                }
            }
            i = i + 1
        }
    }

    if params_sl != -1 {
        let mut cpi = 0
        while cpi < sublist_length(params_sl) {
            let cp = sublist_get(params_sl, cpi)
            closure_param_names.push(node_name(cp))
            cpi = cpi + 1
        }
    }

    let resolved_ret = resolve_ret_type_from_ann(node)
    let mut ret_c_str = if resolved_ret != "" { resolved_ret } else { c_type_str(ret_type) }
    let mut closure_ret_struct = ""
    if ret_type == CT_VOID && ret_str != "Void" && ret_str != "" {
        if is_struct_type(ret_str) != 0 {
            // ret_str is the bare head (`GKV`), but this feeds both the definition line
            // below and the call-site cast, so it must name the mono typedef. An empty stem
            // means a non-generic or typevar head, which keeps its declared name. The stem is
            // unqualified; c_type_c_name reapplies the module prefix for a cross-module type.
            let stem_tid = closure_ret_mono_stem(node)
            let stem = if stem_tid != "" { stem_tid } else { ret_str }
            ret_c_str = c_type_c_name(stem)
            // reg_fn_struct_ret's contract is the mono carrier, so the call-site `_sr`
            // temp names the typedef'd type.
            closure_ret_struct = stem
        } else if is_enum_type(ret_str) != 0 {
            // The enum arm of the same correction: a generic enum instance has no typedef under
            // its base name, and nothing else in the program has to mention the instance, so the
            // tagged union is registered here rather than assumed to exist.
            let estem = closure_ret_mono_stem(node)
            if estem != "" {
                register_enum_instance_from_tid(tc_lookup_node_tid(node_type_ann(node)))
                ret_c_str = c_type_c_name(estem)
            } else {
                ret_c_str = c_type_c_name(ret_str)
            }
        }
    }
    // Ordered last, matching the call-site cast below: the string arms own every return they
    // can spell, and the tid fills in only where they answered `void` — which c_type_str gives
    // for every kind it cannot spell, not just for a genuine Void. The cast is emitted from the
    // same producer, and the two disagreeing is an ABI mismatch cc cannot see.
    if ret_c_str == "void" {
        let tid_ret = closure_lit_ret_c(node)
        if tid_ret != "" {
            ret_c_str = tid_ret
        }
    }
    emit_line("static {ret_c_str} {cname}({params_c}) \{")
    cg_indent = cg_indent + 1
    let mut mc_i = 0
    while mc_i < captures.len() {
        let mc_e = closure_captures.get(cap_start + mc_i).unwrap()
        if mc_e.is_mut != 0 {
            let mut mc_dup = 0
            let mut mc_j = 0
            while mc_j < mc_i {
                if closure_captures.get(cap_start + mc_j).unwrap().name == mc_e.name {
                    mc_dup = 1
                }
                mc_j = mc_j + 1
            }
            if mc_dup == 0 {
                let mc_ts = capture_cell_c_type(mc_e.tid, mc_e.tp_id, "")
                emit_line("{mc_ts}* {mc_e.name}_cell = ({mc_ts}*)blink_closure_get_capture(__self, {mc_i});")
            }
        }
        mc_i = mc_i + 1
    }
    let mut body_ret = ret_type
    if closure_ret_struct != "" || (ret_type == CT_VOID && ret_str != "Void" && ret_str != "" && ret_needs_struct_body(ret_str) != 0) {
        body_ret = CT_INT
    }
    // A signature repaired from the tid without repairing the body leaves the tail lowered as
    // a discard, so the caller reads an uninitialized register. Reads the ct twin of the
    // producer the signature used, so the two cannot answer for different types; a genuine
    // Void answers CT_VOID and this is a no-op.
    if body_ret == CT_VOID {
        let tid_body_ct = closure_lit_ret_ct(node)
        if tid_body_ct != -1 {
            body_ret = tid_body_ct
        }
    }
    cg_current_fn_name = cname
    cg_current_fn_has_ev = 0
    cg_current_fn_ret = body_ret
    cg_current_fn_node = node
    // Spec §3c.2: closures do not inherit test-body elaboration.
    // `?` inside a closure body re-uses the host fn's normal Result/Option
    // gating, not the surrounding test scope.
    let saved_in_test = cg_in_test_body
    cg_in_test_body = 0
    if ret_type == CT_OPTION {
        cg_current_fn_option_inner = resolve_option_inner_from_ann(node)
    } else {
        cg_current_fn_option_inner = 0
    }
    if closure_ret_struct != "" {
        reg_fn_struct_ret(cname, closure_ret_struct)
    }
    reg_fn_ret_from_ann(cname, node)
    emit_fn_body(node_body(node), body_ret)
    cg_current_fn_name = saved_fn_name
    cg_current_fn_has_ev = saved_fn_has_ev
    cg_current_fn_ret = saved_fn_ret
    cg_current_fn_option_inner = saved_fn_option_inner
    cg_current_fn_node = saved_fn_node
    cg_current_fn_option_inner_struct = saved_fn_option_inner_struct
    cg_in_test_body = saved_in_test
    cg_indent = cg_indent - 1
    emit_line("}")
    emit_line("")

    pop_scope()

    let closure_lines = cg_lines
    cg_lines = saved_lines
    cg_indent = saved_indent
    cg_temp_counter = saved_temp
    cg_closure_cap_start = saved_cap_start
    cg_closure_cap_count = saved_cap_count
    closure_param_names = saved_closure_params
    cg_in_traced_fn = saved_in_traced

    let mut ci = 0
    while ci < closure_lines.len() {
        cg_closure_defs.push(closure_lines.get(ci).unwrap())
        ci = ci + 1
    }

    // Build C function pointer signature for closure calls
    let mut sig_params = "const blink_closure*"
    if params_sl != -1 && sublist_length(params_sl) > 0 {
        let mut si = 0
        while si < sublist_length(params_sl) {
            let sp = sublist_get(params_sl, si)
            let sptype = node_type_name(sp)
            sig_params = sig_params.concat(", ")
            let sp_hint_tid_c = closure_hint_c(saved_param_hint_tid)
            if sptype == "Fn" {
                sig_params = sig_params.concat("blink_closure*")
            } else if sptype == "" {
                // The cast half of the definition's unannotated arm above: the per-position Fn-tid
                // type leads and the element hint is the fallback, in the same order and gated on
                // the same channels, so the fn-ptr cast and the closure body's param type stay in
                // ABI sync.
                let sp_lit_c = closure_lit_param_c(node, si)
                if sp_lit_c != "" {
                    sig_params = sig_params.concat(sp_lit_c)
                } else if sp_hint_tid_c != "" || (saved_param_hint >= 0 && saved_param_hint != CT_VOID) {
                    sig_params = sig_params.concat(if sp_hint_tid_c != "" { sp_hint_tid_c } else { c_type_str(saved_param_hint) })
                } else {
                    sig_params = sig_params.concat(c_type_str(type_from_name(sptype)))
                }
            } else if is_enum_type(sptype) != 0 || is_struct_type(sptype) != 0 {
                // Must agree with the definition line's params_c above: this string is the CAST
                // the call is made through, so the two disagreeing is an ABI mismatch, not a
                // cosmetic difference. Both read the one producer.
                let smono = ann_mono_c_type(node_type_ann(sp))
                sig_params = sig_params.concat(if smono != "" { smono } else { c_type_c_name(sptype) })
            } else if sptype == "Tuple" {
                sig_params = sig_params.concat(tuple_c_name_from_ann(node_type_ann(sp), "void"))
            } else if type_from_name(sptype) == CT_OPTION || type_from_name(sptype) == CT_RESULT {
                // The call-site fn-ptr cast must match the closure body's parameterized
                // carrier param, or the cast keeps `void` and gcc rejects the call.
                sig_params = sig_params.concat(c_type_c_name(compound_name_from_ann(node_type_ann(sp))))
            } else {
                // The cast half of the definition's else arm above, reading the one producer.
                let sp_tid_c = closure_lit_param_c(node, si)
                sig_params = sig_params.concat(if sp_tid_c != "" { sp_tid_c } else { c_type_str(type_from_name(sptype)) })
            }
            si = si + 1
        }
    }
    let mut sig_ret_str = if closure_ret_struct != "" { c_type_c_name(closure_ret_struct) } else if resolved_ret != "" { resolved_ret } else { c_type_str(ret_type) }
    // Ordered last: the string arms above own every return they can spell, and the tid fills in
    // only where they answered `void` — which c_type_str gives for every kind it cannot spell, not
    // just for a genuine Void. A genuine Void return reaches this and the tid answers `void` too.
    if sig_ret_str == "void" {
        let tid_ret = closure_lit_ret_c(node)
        if tid_ret != "" {
            sig_ret_str = tid_ret
        }
    }
    expr_closure_sig = "{sig_ret_str}(*)({sig_params})"
    cg_closure_param_type_hint = -1
    cg_closure_param_type_hint_tid = -1

    let mut slot_descs: List[Str] = []
    let mut di = 0
    while di < captures.len() {
        let cap_d = closure_captures.get(cap_start + di).unwrap()
        let d0 = descriptor_from_capture(cap_d)
        slot_descs.push(d0)
        queue_promote_type(d0)
        di = di + 1
    }

    let promoter_name = "__promote_closure_{closure_idx}"
    let saved_lines_p = cg_lines
    let saved_indent_p = cg_indent
    let saved_temp_p = cg_temp_counter
    cg_lines = []
    cg_indent = 0
    cg_temp_counter = 0
    emit_line("static blink_closure* {promoter_name}(blink_arena_t* target, blink_closure* src) \{")
    cg_indent = cg_indent + 1
    emit_line("if (src == NULL) return NULL;")
    if captures.len() == 0 {
        emit_line("return blink_closure_new_typed(src->fn_ptr, NULL, NULL, 0, src->promoter);")
    } else {
        emit_line("blink_arena_t* __save = __blink_current_arena;")
        emit_line("__blink_current_arena = target;")
        emit_line("void** new_caps = (void**)blink_promote_alloc(target, sizeof(void*) * src->capture_count);")
        emit_line("__blink_current_arena = __save;")
        let mut pi = 0
        while pi < captures.len() {
            let cap_pe = closure_captures.get(cap_start + pi).unwrap()
            let pdesc = slot_descs.get(pi).unwrap()
            if cap_pe.is_mut != 0 {
                // Alias the cell — shared-cell semantics (§2.8).
                emit_line("new_caps[{pi}] = src->captures[{pi}];")
            } else {
                emit_line("\{")
                cg_indent = cg_indent + 1
                let stored = emit_promote_elem_into("src->captures[{pi}]", desc_primary_ct(pdesc), pdesc)
                emit_line("new_caps[{pi}] = {stored};")
                cg_indent = cg_indent - 1
                emit_line("}")
            }
            pi = pi + 1
        }
        emit_line("return blink_closure_new_typed(src->fn_ptr, new_caps, src->capture_descs, src->capture_count, src->promoter);")
    }
    cg_indent = cg_indent - 1
    emit_line("}")
    emit_line("")
    let promoter_lines = cg_lines
    cg_lines = saved_lines_p
    cg_indent = saved_indent_p
    cg_temp_counter = saved_temp_p
    cg_closure_defs.push("static blink_closure* {promoter_name}(blink_arena_t* target, blink_closure* src);")
    let mut pli = 0
    while pli < promoter_lines.len() {
        cg_closure_promoter_defs.push(promoter_lines.get(pli).unwrap())
        pli = pli + 1
    }

    if captures.len() > 0 {
        let caps_var = "__caps_{closure_idx}"
        let descs_var = "__descs_{closure_idx}"
        emit_line("void** {caps_var} = (void**)blink_alloc(sizeof(void*) * {captures.len()});")
        let mut sb = StringBuilder.new()
        sb.write("static const char* {descs_var}[{captures.len()}] = \{")
        let mut ddi = 0
        while ddi < captures.len() {
            if ddi > 0 { sb.write(", ") }
            sb.write("\"")
            sb.write(slot_descs.get(ddi).unwrap())
            sb.write("\"")
            ddi = ddi + 1
        }
        sb.write("};")
        emit_line(sb.to_str())
        let mut ci2 = 0
        while ci2 < captures.len() {
            let cap_e = closure_captures.get(cap_start + ci2).unwrap()
            let cap_kind = capture_ct(cap_e.tid, cap_e.tp_id)
            if cap_e.is_mut != 0 {
                emit_line("{caps_var}[{ci2}] = (void*){cap_e.name}_cell;")
            } else if cap_kind == CT_INT {
                emit_line("{caps_var}[{ci2}] = (void*)(intptr_t){cap_e.name};")
            } else if cap_kind == CT_FLOAT {
                emit_line("\{double* __fp_{closure_idx}_{ci2} = (double*)blink_alloc(sizeof(double)); *__fp_{closure_idx}_{ci2} = {cap_e.name}; {caps_var}[{ci2}] = (void*)__fp_{closure_idx}_{ci2};}")
            } else if cap_kind == CT_BOOL {
                emit_line("{caps_var}[{ci2}] = (void*)(intptr_t){cap_e.name};")
            } else if cap_kind == CT_STRUCT && capture_sname(cap_e.tid, cap_e.tp_id) != "" {
                let st_name = capture_sname(cap_e.tid, cap_e.tp_id)
                let c_name = c_type_c_name(st_name)
                emit_line("\{{c_name}* __st_{closure_idx}_{ci2} = ({c_name}*)blink_alloc(sizeof({c_name})); *__st_{closure_idx}_{ci2} = {cap_e.name}; {caps_var}[{ci2}] = (void*)__st_{closure_idx}_{ci2};}")
            } else {
                emit_line("{caps_var}[{ci2}] = (void*){cap_e.name};")
            }
            ci2 = ci2 + 1
        }
        expr_result_str = "blink_closure_new_typed((void*){cname}, {caps_var}, {descs_var}, {captures.len()}, {promoter_name})"
    } else {
        expr_result_str = "blink_closure_new_typed((void*){cname}, NULL, NULL, 0, {promoter_name})"
    }
    expr_result_type = CT_CLOSURE
}
