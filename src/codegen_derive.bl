import codegen_types.{
    Codegen,
    CT_BOOL, CT_CHAR, CT_CLOSURE, CT_FLOAT, CT_INT, CT_LIST, CT_MAP, CT_OPTION, CT_RESULT, CT_STRING, CT_STRUCT, CT_VOID,
    CT_I8, CT_I16, CT_I32, CT_U8, CT_U16, CT_U32, CT_U64,
    cg_indent,
    emit_line,
    fresh_temp,
    c_fn_name, c_type_c_name, c_type_tag, canonical_struct_tag, strip_module_qualifier,
    type_from_name, type_from_name_tag,
    is_hash_scalar_ct,
    kops_table_name, c_type_str,
    ensure_struct_result_type, ensure_struct_option_type, ensure_option_type, ensure_mixed_result_type,
    is_struct_type, is_enum_type, is_data_enum,
    has_derive_method,
    get_struct_field_tp_id,
    tp_child1_kind, tp_child1_sname,
    tp_child2_kind, tp_child2_sname,
    tp_get_child1, tp_get_child2, tp_get_kind, tp_get_sname,
    get_variant_field_name, get_variant_field_type_str,
    derive_serialize_types, derive_deserialize_types,
    derive_eq_types, derive_ord_types, derive_clone_types, derive_hash_types, derive_debug_types,
    derive_method_entries, display_impl_types, lookup_impl_method, mangle_impl_method_q,
    DeriveMethodEntry,
    list_contains_str,
    sf_entries,
    enum_regs, enum_variants,
}
import parser.{node_args, node_handlers, node_name, sublist_get, sublist_length}
import diagnostics.{diag_error_at, UNKNOWN_DERIVE_NAME, Diag}

fn is_known_derive(name: Str) -> Bool {
    name == "Serialize" || name == "Deserialize" || name == "Eq" || name == "Ord" || name == "Clone" || name == "Hash" || name == "Debug"
}

pub fn register_derive_annotations(types_sl: Int) ! Diag.Report {
    if types_sl == -1 { return }
    let mut i = 0
    while i < sublist_length(types_sl) {
        let td = sublist_get(types_sl, i)
        let td_anns = node_handlers(td)
        if td_anns != -1 {
            let mut ai = 0
            while ai < sublist_length(td_anns) {
                let ann = sublist_get(td_anns, ai)
                if node_name(ann) == "derive" {
                    let args_sl = node_args(ann)
                    if args_sl != -1 {
                        let mut di = 0
                        while di < sublist_length(args_sl) {
                            let darg = sublist_get(args_sl, di)
                            let dname = node_name(darg)
                            let tname = node_name(td)
                            if dname == "Serialize" {
                                derive_serialize_types.push(tname)
                                derive_method_entries.push(DeriveMethodEntry {
                                    type_name: tname,
                                    method_name: "to_json",
                                    ret_type: CT_STRING
                                })
                            }
                            if dname == "Deserialize" {
                                derive_deserialize_types.push(tname)
                                derive_method_entries.push(DeriveMethodEntry {
                                    type_name: tname,
                                    method_name: "from_json",
                                    ret_type: CT_VOID
                                })
                                ensure_struct_result_type(tname, "str")
                            }
                            if dname == "Eq" {
                                if list_contains_str(derive_eq_types, tname) == 0 {
                                    derive_eq_types.push(tname)
                                    derive_method_entries.push(DeriveMethodEntry {
                                        type_name: tname,
                                        method_name: "eq",
                                        ret_type: CT_BOOL
                                    })
                                }
                            }
                            // vfgp72: Ord: Eq (spec §3.6). Deriving Ord implies Eq —
                            // auto-include so `a == b` works alongside `a < b` without
                            // forcing the user to write both derives. cmp returns
                            // Ordering; ret_type CT_VOID here, typecheck resolves the
                            // real Ordering tid (mirrors Deserialize's from_json).
                            if dname == "Ord" {
                                if list_contains_str(derive_ord_types, tname) == 0 {
                                    derive_ord_types.push(tname)
                                    derive_method_entries.push(DeriveMethodEntry {
                                        type_name: tname,
                                        method_name: "cmp",
                                        ret_type: CT_VOID
                                    })
                                }
                                if list_contains_str(derive_eq_types, tname) == 0 {
                                    derive_eq_types.push(tname)
                                    derive_method_entries.push(DeriveMethodEntry {
                                        type_name: tname,
                                        method_name: "eq",
                                        ret_type: CT_BOOL
                                    })
                                }
                            }
                            if dname == "Clone" {
                                derive_clone_types.push(tname)
                                derive_method_entries.push(DeriveMethodEntry {
                                    type_name: tname,
                                    method_name: "clone",
                                    ret_type: CT_VOID
                                })
                            }
                            if dname == "Hash" {
                                derive_hash_types.push(tname)
                                derive_method_entries.push(DeriveMethodEntry {
                                    type_name: tname,
                                    method_name: "hash",
                                    ret_type: CT_INT
                                })
                            }
                            if dname == "Debug" {
                                derive_debug_types.push(tname)
                                derive_method_entries.push(DeriveMethodEntry {
                                    type_name: tname,
                                    method_name: "debug",
                                    ret_type: CT_STRING
                                })
                            }
                            if !is_known_derive(dname) {
                                diag_error_at("UnknownDerive", UNKNOWN_DERIVE_NAME, "unknown @derive name '{dname}'; expected one of Serialize, Deserialize, Eq, Ord, Clone, Hash, Debug", darg, "remove or replace this derive name")
                            }
                            di = di + 1
                        }
                    }
                }
                ai = ai + 1
            }
        }
        i = i + 1
    }
}

pub fn emit_derive_forward_decls() ! Codegen.Emit {
    let mut i = 0
    while i < derive_serialize_types.len() {
        let tname = derive_serialize_types.get(i).unwrap()
        if is_enum_type(tname) != 0 {
            emit_line("const char* {c_type_c_name(tname)}_to_json({c_type_c_name(tname)} self);")
        } else {
            emit_line("const char* {c_type_c_name(tname)}_to_json({c_type_c_name(tname)} self);")
        }
        i = i + 1
    }
    let mut j = 0
    while j < derive_deserialize_types.len() {
        let tname = derive_deserialize_types.get(j).unwrap()
        let cs_tag = canonical_struct_tag(tname)
        emit_line("blink_Result_{cs_tag}_str {c_type_c_name(tname)}_from_json(const char* input);")
        j = j + 1
    }
    let mut ei = 0
    while ei < derive_eq_types.len() {
        let tname = derive_eq_types.get(ei).unwrap()
        if is_data_enum(tname) != 0 {
            emit_line("int {c_type_c_name(tname)}_eq({c_type_c_name(tname)} self, {c_type_c_name(tname)} other);")
        } else if is_enum_type(tname) != 0 {
            emit_line("int {c_type_c_name(tname)}_eq({c_type_c_name(tname)} self, {c_type_c_name(tname)} other);")
        } else {
            emit_line("int {c_type_c_name(tname)}_eq({c_type_c_name(tname)} self, {c_type_c_name(tname)} other);")
        }
        ei = ei + 1
    }
    let mut oi = 0
    while oi < derive_ord_types.len() {
        let tname = derive_ord_types.get(oi).unwrap()
        emit_line("{c_type_c_name("Ordering")} {c_type_c_name(tname)}_cmp({c_type_c_name(tname)} self, {c_type_c_name(tname)} other);")
        oi = oi + 1
    }
    let mut ci = 0
    while ci < derive_clone_types.len() {
        let tname = derive_clone_types.get(ci).unwrap()
        emit_line("{c_type_c_name(tname)} {c_type_c_name(tname)}_clone({c_type_c_name(tname)} self);")
        ci = ci + 1
    }
    let mut hi = 0
    while hi < derive_hash_types.len() {
        let tname = derive_hash_types.get(hi).unwrap()
        emit_line("uint64_t {c_type_c_name(tname)}_hash({c_type_c_name(tname)} self);")
        // Tuple K registration can land mid-codegen (when a fn body uses a
        // Map[(K1,K2), V] literal), so we ALSO forward-declare every kops
        // table here as a non-static `extern const`. The matching definition
        // is emitted by emit_kops_adapters_late() after fn bodies, by which
        // point derive_hash_types contains every type any fn body reached.
        let cn = c_type_c_name(tname)
        emit_line("extern const blink_kops kops_{cn};")
        hi = hi + 1
    }
    let mut dbi = 0
    while dbi < derive_debug_types.len() {
        let tname = derive_debug_types.get(dbi).unwrap()
        emit_line("const char* {c_type_c_name(tname)}_debug({c_type_c_name(tname)} self);")
        dbi = dbi + 1
    }
}

// 4q2etk: replaced by mwxtyj — sealed Display.display() synthesis.
// For every `impl Display for T` the compiler provides
// `const char* {T}_display({T} self)` = fmt rendered through a fresh
// StringBuilder. E0731 rejects a user-written `display` inside the
// Display impl; a `display` from a DIFFERENT impl block (e.g. a user
// trait) still owns the symbol, so synthesis is skipped then.
fn display_synthesis_skipped(tname: Str) -> Int {
    lookup_impl_method(tname, "display")
}

pub fn emit_display_forward_decls() ! Codegen.Emit {
    let mut i = 0
    while i < display_impl_types.len() {
        let tname = display_impl_types.get(i).unwrap()
        if display_synthesis_skipped(tname) == 0 {
            emit_line("const char* {c_fn_name(mangle_impl_method_q(tname, "Display", "display"))}({c_type_c_name(tname)} self);")
        }
        i = i + 1
    }
}

pub fn emit_display_fn_defs() ! Codegen.Emit {
    let mut i = 0
    while i < display_impl_types.len() {
        let tname = display_impl_types.get(i).unwrap()
        if display_synthesis_skipped(tname) == 0 {
            emit_line("const char* {c_fn_name(mangle_impl_method_q(tname, "Display", "display"))}({c_type_c_name(tname)} self) \{")
            cg_indent = cg_indent + 1
            emit_line("blink_sb* sb = blink_sb_new();")
            emit_line("{c_fn_name(mangle_impl_method_q(tname, "Display", "fmt"))}(self, sb);")
            emit_line("return blink_sb_to_str(sb);")
            cg_indent = cg_indent - 1
            emit_line("}")
            emit_line("")
        }
        i = i + 1
    }
}

/// Emit the actual kops adapter functions + table definitions for every
/// type currently in derive_hash_types. Runs after fn bodies so tuple K
/// types discovered during fn-body codegen are covered. Forward decls
/// inside emit_derive_forward_decls promised these symbols exist.
pub fn emit_kops_adapters_late() ! Codegen.Emit {
    let mut hi = 0
    while hi < derive_hash_types.len() {
        let tname = derive_hash_types.get(hi).unwrap()
        let cn = c_type_c_name(tname)
        emit_line("static uint64_t kops_hash_{cn}(const void* k) \{ return {cn}_hash(*(const {cn}*)k); }")
        emit_line("static int kops_eq_{cn}(const void* a, const void* b) \{ return {cn}_eq(*(const {cn}*)a, *(const {cn}*)b); }")
        emit_line("const blink_kops kops_{cn} = \{ kops_hash_{cn}, kops_eq_{cn}, sizeof({cn}), 0 };")
        hi = hi + 1
    }
}

pub fn emit_derive_fn_defs() ! Codegen.Emit {
    let mut i = 0
    while i < derive_serialize_types.len() {
        let tname = derive_serialize_types.get(i).unwrap()
        if is_enum_type(tname) != 0 {
            emit_enum_to_json(tname)
        } else {
            emit_struct_to_json(tname)
        }
        i = i + 1
    }
    let mut j = 0
    while j < derive_deserialize_types.len() {
        let tname = derive_deserialize_types.get(j).unwrap()
        if is_enum_type(tname) != 0 {
            emit_enum_from_json(tname)
        } else {
            emit_struct_from_json(tname)
        }
        j = j + 1
    }
    let mut ei = 0
    while ei < derive_eq_types.len() {
        let tname = derive_eq_types.get(ei).unwrap()
        if is_enum_type(tname) != 0 {
            emit_enum_eq(tname)
        } else {
            emit_struct_eq(tname)
        }
        ei = ei + 1
    }
    let mut oi = 0
    while oi < derive_ord_types.len() {
        let tname = derive_ord_types.get(oi).unwrap()
        if is_enum_type(tname) != 0 {
            emit_enum_cmp(tname)
        } else {
            emit_struct_cmp(tname)
        }
        oi = oi + 1
    }
    let mut ci = 0
    while ci < derive_clone_types.len() {
        let tname = derive_clone_types.get(ci).unwrap()
        if is_enum_type(tname) != 0 {
            emit_enum_clone(tname)
        } else {
            emit_struct_clone(tname)
        }
        ci = ci + 1
    }
    let mut hi = 0
    while hi < derive_hash_types.len() {
        let tname = derive_hash_types.get(hi).unwrap()
        if is_enum_type(tname) != 0 {
            emit_enum_hash(tname)
        } else {
            emit_struct_hash(tname)
        }
        hi = hi + 1
    }
    let mut dbi = 0
    while dbi < derive_debug_types.len() {
        let tname = derive_debug_types.get(dbi).unwrap()
        if is_enum_type(tname) != 0 {
            emit_enum_debug(tname)
        } else {
            emit_struct_debug(tname)
        }
        dbi = dbi + 1
    }
}

fn emit_enum_hash(type_name: Str) ! Codegen.Emit {
    let eidx = get_enum_reg_idx(type_name)
    if eidx == -1 { return }
    let is_data = is_data_enum(type_name)
    emit_line("uint64_t {c_type_c_name(type_name)}_hash({c_type_c_name(type_name)} self) \{")
    cg_indent = cg_indent + 1
    if is_data == 0 {
        emit_line("return blink_kops_mix_u64(BLINK_HASH_INIT ^ (uint64_t)self);")
    } else {
        emit_line("uint64_t h = blink_kops_mix_u64(BLINK_HASH_INIT ^ (uint64_t)self.tag);")
        emit_line("switch (self.tag) \{")
        cg_indent = cg_indent + 1
        let mut _tag = 0
        let mut i = 0
        while i < enum_variants.len() {
            let evar = enum_variants.get(i).unwrap()
            if evar.enum_idx == eidx {
                emit_line("case {_tag}: \{")
                cg_indent = cg_indent + 1
                if evar.field_count > 0 {
                    let vidx = i
                    let mut fi = 0
                    while fi < evar.field_count {
                        let fname = get_variant_field_name(vidx, fi).unwrap()
                        let ftype_str = get_variant_field_type_str(vidx, fi).unwrap()
                        let fct = type_from_name(ftype_str)
                        if fct == CT_STRING {
                            emit_line("h = blink_kops_mix_u64(h ^ blink_map_hash(self.data.{evar.name}.{fname}));")
                        } else if is_hash_scalar_ct(fct) != 0 {
                            emit_line("h = blink_kops_mix_u64(h ^ (uint64_t)self.data.{evar.name}.{fname});")
                        } else if is_struct_type(ftype_str) != 0 && has_derive_method(ftype_str, "hash") != 0 {
                            emit_line("h = blink_kops_mix_u64(h ^ {c_type_c_name(ftype_str)}_hash(self.data.{evar.name}.{fname}));")
                        }
                        fi = fi + 1
                    }
                }
                emit_line("break;")
                cg_indent = cg_indent - 1
                emit_line("}")
                _tag = _tag + 1
            }
            i = i + 1
        }
        emit_line("default: break;")
        cg_indent = cg_indent - 1
        emit_line("}")
        emit_line("return h;")
    }
    cg_indent = cg_indent - 1
    emit_line("}")
    emit_line("")
}

fn emit_struct_hash(type_name: Str) ! Codegen.Emit {
    // Order-sensitive: mix accumulator and per-field hash separately so (a, b)
    // and (b, a) field layouts produce distinct hashes.
    emit_line("uint64_t {c_type_c_name(type_name)}_hash({c_type_c_name(type_name)} self) \{")
    cg_indent = cg_indent + 1
    emit_line("uint64_t h = BLINK_HASH_INIT;")
    let mut i = 0
    while i < sf_entries.len() {
        let sf = sf_entries.get(i).unwrap()
        if sf.struct_name == type_name {
            if sf.field_type == CT_STRING {
                emit_line("h = blink_kops_mix_u64(h ^ blink_map_hash(self.{sf.field_name}));")
            } else if is_hash_scalar_ct(sf.field_type) != 0 {
                emit_line("h = blink_kops_mix_u64(h ^ (uint64_t)self.{sf.field_name});")
            } else if sf.field_type == CT_VOID && sf.stype != "" && has_derive_method(sf.stype, "hash") != 0 {
                emit_line("h = blink_kops_mix_u64(h ^ {c_type_c_name(sf.stype)}_hash(self.{sf.field_name}));")
            } else {
                emit_line("/* BLINK_COMPILER_BUG: field {sf.field_name} of {type_name} has unhashable type — typecheck E1400 should have rejected this */")
                emit_line("h = blink_kops_mix_u64(h ^ 0xBADBADBADBADBADBULL);")
            }
        }
        i = i + 1
    }
    emit_line("return h;")
    cg_indent = cg_indent - 1
    emit_line("}")
    emit_line("")
}

fn emit_struct_to_json(type_name: Str) ! Codegen.Emit {
    emit_line("const char* {c_type_c_name(type_name)}_to_json({c_type_c_name(type_name)} self) \{")
    cg_indent = cg_indent + 1
    emit_line("const char* result = \"\{\";")
    let mut _field_idx = 0
    let mut i = 0
    while i < sf_entries.len() {
        let sf = sf_entries.get(i).unwrap()
        if sf.struct_name == type_name {
            if _field_idx > 0 {
                emit_line("result = blink_str_concat(result, \",\");")
            }
            emit_line("result = blink_str_concat(result, \"\\\"{sf.field_name}\\\":\");")
            emit_field_serialize("self.{sf.field_name}", sf.field_type, sf.stype, type_name, sf.field_name)
            _field_idx = _field_idx + 1
        }
        i = i + 1
    }
    emit_line("result = blink_str_concat(result, \"}\");")
    emit_line("return result;")
    cg_indent = cg_indent - 1
    emit_line("}")
    emit_line("")
}

fn emit_field_serialize(access: Str, field_type: Int, stype: Str, struct_name: Str, field_name: Str) ! Codegen.Emit {
    if field_type == CT_STRING {
        emit_line("result = blink_str_concat(result, {c_fn_name("json_escape_str")}({access}));")
    } else if field_type == CT_INT {
        emit_line("result = blink_str_concat(result, {c_fn_name("int_to_str")}({access}));")
    } else if field_type == CT_FLOAT {
        emit_line("result = blink_str_concat(result, {c_fn_name("float_to_str")}({access}));")
    } else if field_type == CT_BOOL {
        emit_line("result = blink_str_concat(result, {access} ? \"true\" : \"false\");")
    } else if field_type == CT_VOID && stype != "" {
        if has_derive_method(stype, "to_json") != 0 {
            emit_line("result = blink_str_concat(result, {c_type_c_name(stype)}_to_json({access}));")
        } else {
            emit_line("result = blink_str_concat(result, \"null\");")
        }
    } else if field_type == CT_LIST {
        emit_list_serialize(access, struct_name, field_name)
    } else {
        emit_line("result = blink_str_concat(result, \"null\");")
    }
}

fn emit_list_serialize(access: Str, struct_name: Str, field_name: Str) ! Codegen.Emit {
    let fa_tp = get_struct_field_tp_id(struct_name, field_name)
    let elem_struct = if fa_tp >= 0 { tp_child1_sname(fa_tp) } else { "" }
    let elem_type = if fa_tp >= 0 { tp_child1_kind(fa_tp) } else { CT_INT }
    emit_line("result = blink_str_concat(result, \"[\");")
    emit_line("\{")
    cg_indent = cg_indent + 1
    emit_line("int64_t _len = blink_list_len({access});")
    emit_line("for (int64_t _i = 0; _i < _len; _i++) \{")
    cg_indent = cg_indent + 1
    emit_line("if (_i > 0) result = blink_str_concat(result, \",\");")
    if elem_struct != "" {
        emit_line("{c_type_c_name(elem_struct)} _elem = *({c_type_c_name(elem_struct)}*)blink_list_get({access}, _i);")
        if has_derive_method(elem_struct, "to_json") != 0 {
            emit_line("result = blink_str_concat(result, {c_type_c_name(elem_struct)}_to_json(_elem));")
        } else {
            emit_line("result = blink_str_concat(result, \"null\");")
        }
    } else if elem_type == CT_STRING {
        emit_line("result = blink_str_concat(result, {c_fn_name("json_escape_str")}((const char*)blink_list_get({access}, _i)));")
    } else if elem_type == CT_INT {
        emit_line("result = blink_str_concat(result, {c_fn_name("int_to_str")}((int64_t)(intptr_t)blink_list_get({access}, _i)));")
    } else if elem_type == CT_FLOAT {
        emit_line("result = blink_str_concat(result, {c_fn_name("float_to_str")}(*(double*)blink_list_get({access}, _i)));")
    } else if elem_type == CT_BOOL {
        emit_line("result = blink_str_concat(result, (int64_t)(intptr_t)blink_list_get({access}, _i) ? \"true\" : \"false\");")
    } else {
        emit_line("result = blink_str_concat(result, \"null\");")
    }
    cg_indent = cg_indent - 1
    emit_line("}")
    cg_indent = cg_indent - 1
    emit_line("}")
    emit_line("result = blink_str_concat(result, \"]\");")
}

fn get_enum_reg_idx(name: Str) -> Int {
    let mut i = 0
    while i < enum_regs.len() {
        if enum_regs.get(i).unwrap().name == name {
            return i
        }
        i = i + 1
    }
    -1
}

fn emit_enum_to_json(type_name: Str) ! Codegen.Emit {
    let eidx = get_enum_reg_idx(type_name)
    if eidx == -1 { return }
    let is_data = is_data_enum(type_name)

    if is_data == 0 {
        // Simple enum: return quoted variant name
        emit_line("const char* {c_type_c_name(type_name)}_to_json({c_type_c_name(type_name)} self) \{")
        cg_indent = cg_indent + 1
        emit_line("switch (self) \{")
        cg_indent = cg_indent + 1
        let mut i = 0
        while i < enum_variants.len() {
            let evar = enum_variants.get(i).unwrap()
            if evar.enum_idx == eidx {
                let json_val = if evar.str_value != "" { evar.str_value } else { evar.name }
                emit_line("case {c_type_c_name(type_name)}_{evar.name}: return \"\\\"{json_val}\\\"\";")
            }
            i = i + 1
        }
        emit_line("default: return \"null\";")
        cg_indent = cg_indent - 1
        emit_line("}")
        cg_indent = cg_indent - 1
        emit_line("}")
        emit_line("")
    } else {
        // Data enum: internally tagged JSON object
        emit_line("const char* {c_type_c_name(type_name)}_to_json({c_type_c_name(type_name)} self) \{")
        cg_indent = cg_indent + 1
        emit_line("const char* result = \"\";")
        emit_line("switch (self.tag) \{")
        cg_indent = cg_indent + 1
        let mut _tag = 0
        let mut i = 0
        while i < enum_variants.len() {
            let evar = enum_variants.get(i).unwrap()
            if evar.enum_idx == eidx {
                emit_line("case {_tag}: \{")
                cg_indent = cg_indent + 1
                emit_line("result = \"\{\\\"type\\\":\\\"{evar.name}\\\"\";")
                if evar.field_count > 0 {
                    let vidx = i
                    let mut fi = 0
                    while fi < evar.field_count {
                        let fname = get_variant_field_name(vidx, fi).unwrap()
                        let ftype_str = get_variant_field_type_str(vidx, fi).unwrap()
                        let fct = type_from_name(ftype_str)
                        emit_line("result = blink_str_concat(result, \",\\\"{fname}\\\":\");")
                        let access = "self.data.{evar.name}.{fname}"
                        if fct == CT_STRING {
                            emit_line("result = blink_str_concat(result, {c_fn_name("json_escape_str")}({access}));")
                        } else if fct == CT_INT {
                            emit_line("result = blink_str_concat(result, {c_fn_name("int_to_str")}({access}));")
                        } else if fct == CT_FLOAT {
                            emit_line("result = blink_str_concat(result, {c_fn_name("float_to_str")}({access}));")
                        } else if fct == CT_BOOL {
                            emit_line("result = blink_str_concat(result, {access} ? \"true\" : \"false\");")
                        } else if is_struct_type(ftype_str) != 0 && has_derive_method(ftype_str, "to_json") != 0 {
                            emit_line("result = blink_str_concat(result, {c_type_c_name(ftype_str)}_to_json({access}));")
                        } else {
                            emit_line("result = blink_str_concat(result, \"null\");")
                        }
                        fi = fi + 1
                    }
                }
                emit_line("result = blink_str_concat(result, \"}\");")
                emit_line("return result;")
                cg_indent = cg_indent - 1
                emit_line("}")
                _tag = _tag + 1
            }
            i = i + 1
        }
        emit_line("default: return \"null\";")
        cg_indent = cg_indent - 1
        emit_line("}")
        cg_indent = cg_indent - 1
        emit_line("}")
        emit_line("")
    }
}

// ── Recursive @derive(Debug) container walkers ───────────────────────
//
// For every nested container monomorphization reachable from a @derive(Debug)
// type, emit a top-level `blink_debug_<Mangled>(<CType> v) -> const char*` that
// recursively calls the walkers for its element/key/value types. Mirrors the
// arena-promote machinery (blink_promote_{mangle}) in SHAPE — recursive
// top-level fns, descriptor-keyed dedup, two-phase forward-decl/def — but not
// its arena semantics: Debug returns const char* and builds via blink_str_concat
// (no arena threading).
//
// Two entry points converge on the SAME descriptor vocabulary (P:/L:/O:/M:/S:)
// and therefore the SAME generated fns:
//   - struct fields (ye9ty9): tp_to_descriptor walks the field's tp_id tree.
//   - enum-variant fields (x112x7): parse_type_str_to_descriptor parses the
//     field's type STRING (no tp_id at that codegen site).
// Both route scalar leaves through ct_to_descriptor so narrow-int / Char widths
// survive (bug 2aw8mt). For the same type they MUST mangle identically.

pub let mut debug_types: List[Str] = []
pub let mut debug_emitted: Map[Str, Int] = Map()
pub let mut debug_fwd_emitted: Int = 0

// Walk a resolved tp_id type tree into a descriptor (struct-field entry). Unlike
// ct_to_descriptor (which lacks tp children and collapses nested containers to
// P:Int), this recurses through tp_get_child1/child2. Scalar leaves defer to
// ct_to_descriptor so narrow widths / Char are preserved.
pub fn tp_to_descriptor(tp_id: Int) -> Str {
    if tp_id < 0 { return "P:Int" }
    let k = tp_get_kind(tp_id)
    if k == CT_LIST {
        let c1 = tp_get_child1(tp_id)
        return "L:{tp_to_descriptor(c1)}"
    }
    if k == CT_OPTION {
        let c1 = tp_get_child1(tp_id)
        return "O:{tp_to_descriptor(c1)}"
    }
    if k == CT_MAP {
        let c1 = tp_get_child1(tp_id)
        let c2 = tp_get_child2(tp_id)
        return "M:{tp_to_descriptor(c1)}|{tp_to_descriptor(c2)}"
    }
    if k == CT_STRUCT || k == CT_VOID {
        let sn = tp_get_sname(tp_id)
        // Canonicalize to the bare name so a module-qualified struct produces
        // the same S:<name> descriptor (and same mangled C fn name) as the
        // enum-variant string parser, and never a '.' in a C identifier.
        if sn != "" { return "S:{strip_module_qualifier(sn)}" }
        return ct_to_descriptor(k, "")
    }
    ct_to_descriptor(k, "")
}

// Index of the top-level comma in `s` (bracket-depth 0), or -1. Mirrors the
// depth counter in get_variant_field_type_str (bytes: '[' 91, ']' 93, ',' 44).
fn top_level_comma(s: Str) -> Int {
    let mut depth = 0
    let mut i = 0
    while i < s.len() {
        let b = s.byte_at(i)
        if b == 91 { depth = depth + 1 }
        else if b == 93 { depth = depth - 1 }
        else if b == 44 && depth == 0 { return i }
        i = i + 1
    }
    -1
}

// Parse an enum-variant field type STRING into a descriptor (enum-variant
// entry). Recursive-descent, bracket-depth-aware, whitespace-tolerant. MUST
// mangle identically to tp_to_descriptor for the same type so struct and enum
// paths share one generated fn.
pub fn parse_type_str_to_descriptor(raw: Str) -> Str {
    let s = raw.trim()
    if s.starts_with("List[") {
        // strip "List[" .. trailing "]"
        let inner = s.slice(5, s.len() - 1)
        return "L:{parse_type_str_to_descriptor(inner)}"
    }
    if s.starts_with("Option[") {
        let inner = s.slice(7, s.len() - 1)
        return "O:{parse_type_str_to_descriptor(inner)}"
    }
    if s.starts_with("Map[") {
        let inner = s.slice(4, s.len() - 1)
        let comma = top_level_comma(inner)
        if comma >= 0 {
            let k = inner.slice(0, comma)
            let v = inner.slice(comma + 1, inner.len())
            return "M:{parse_type_str_to_descriptor(k)}|{parse_type_str_to_descriptor(v)}"
        }
        return "P:Int"
    }
    // Leaf: scalar / Str / user struct. Route through ct_to_descriptor so narrow
    // widths / Char survive; pass the BARE name as sname (matching the struct
    // path's strip_module_qualifier) so a struct becomes S:<name> identically
    // and never yields a '.' in the mangled C fn name.
    let ct = type_from_name(s)
    ct_to_descriptor(ct, strip_module_qualifier(s))
}

// Recursively queue a descriptor + every nested container it reaches. Near-clone
// of queue_promote_type. Skips P: (inline leaves) and C: (closures aren't Debug).
// For S:<name>, does NOT emit a blink_debug_S_* fn (structs get {cn}_debug from
// the derive loop); instead queues each container-typed struct field so those
// nested walkers exist.
// Register the Option carrier typedef for a debug walker over Option[inner]
// (br 4yzsfc sub-issue B). `inner` is the descriptor of the Option's inner type.
// Mirrors descriptor_typedef_tag: a struct/enum inner registers the struct-tagged
// carrier (blink_Option_<canonical tag>); a scalar/Str leaf registers the
// primitive carrier (blink_Option_<c_type_tag>). A nested-compound inner
// (Option/Result/Map/List) registers its OUTER carrier via the tag-keyed path —
// keyed by descriptor_typedef_tag(inner), the same tag descriptor_c_type uses to
// name the carrier the walker references (br bhgzz3). The queue_debug_type
// recursion into the inner descriptor registers the inner carrier(s) separately.
fn register_debug_option_carrier(inner: Str) {
    if inner.starts_with("S:") {
        ensure_struct_option_type(inner.slice(2, inner.len()))
        return
    }
    if inner.starts_with("O:") || inner.starts_with("R:") || inner.starts_with("M:") || inner.starts_with("L:") {
        ensure_struct_option_type(descriptor_typedef_tag(inner))
        return
    }
    // Primitive / Str / narrow-int / Char leaf. (C: closures never reach here:
    // an Option[Closure] element does not survive descriptor construction as a
    // C: inner — see the P: fallthrough this preserves from the prior code.)
    ensure_option_type(desc_primary_ct(inner))
}

pub fn queue_debug_type(desc: Str) {
    if desc == "" { return }
    if desc.starts_with("P:") { return }
    if desc.starts_with("C:") { return }
    if debug_emitted.contains_key(desc) { return }
    debug_emitted.insert(desc, 1)
    if desc.starts_with("S:") {
        let sname = desc.slice(2, desc.len())
        let mut i = 0
        while i < sf_entries.len() {
            let sf = sf_entries.get(i).unwrap()
            if sf.struct_name == sname {
                if sf.field_type == CT_LIST || sf.field_type == CT_OPTION || sf.field_type == CT_MAP {
                    queue_debug_type(tp_to_descriptor(sf.tp_id))
                }
            }
            i = i + 1
        }
        return
    }
    // L: / O: / M: get their own generated walker.
    debug_types.push(desc)
    if desc.starts_with("L:") {
        queue_debug_type(desc.slice(2, desc.len()))
        return
    }
    if desc.starts_with("O:") {
        // br 4yzsfc (sub-issue B): register the Option carrier typedef the debug
        // walker references (blink_Option_<tag>, per descriptor_c_type) so
        // emit_option_result_types_from emits it before the walker's forward
        // decl. Without this, a List[Option[Struct]] whose carrier is only
        // discovered late leaves the debug fwd-decl referencing an undeclared
        // type. Mirrors descriptor_typedef_tag's S:/P: leaf handling.
        register_debug_option_carrier(inner_desc_of(desc))
        queue_debug_type(inner_desc_of(desc))
        return
    }
    if desc.starts_with("M:") {
        let rest = desc.slice(2, desc.len())
        let bar = rest.index_of("|")
        if bar >= 0 {
            let k = rest.slice(0, bar)
            let v = rest.slice(bar + 1, rest.len())
            // Keys are always scalar/struct (container keys rejected at
            // typecheck) — struct keys still need their debug fn queued via S:.
            queue_debug_type(k)
            queue_debug_type(v)
        }
        return
    }
}

// Emit Debug rendering of one container ELEMENT / value read from a void* slot
// (blink_list_get, _m->values[_i]). Scalars/Str/Char read inline (intptr-packed
// or pointer); a struct is boxed behind the slot (deref); nested List/Map store
// the container pointer directly in the slot (cast, no deref); nested Option is
// boxed behind the slot (deref, like a struct).
fn emit_debug_slot(slot: Str, desc: Str) ! Codegen.Emit {
    let ct = desc_primary_ct(desc)
    if desc.starts_with("S:") {
        let sname = desc.slice(2, desc.len())
        emit_line("result = blink_str_concat(result, {c_type_c_name(sname)}_debug(*({c_type_c_name(sname)}*){slot}));")
        return
    }
    if desc.starts_with("L:") || desc.starts_with("M:") {
        // List/Map elements store the container pointer directly in the slot.
        emit_line("result = blink_str_concat(result, blink_debug_{descriptor_mangle(desc)}(({descriptor_c_type(desc)}){slot}));")
        return
    }
    if desc.starts_with("O:") {
        // Option elements are boxed behind the slot pointer (like a struct).
        let cty = descriptor_c_type(desc)
        emit_line("result = blink_str_concat(result, blink_debug_{descriptor_mangle(desc)}(*({cty}*){slot}));")
        return
    }
    if ct == CT_STRING {
        emit_line("result = blink_str_concat(result, {c_fn_name("json_escape_str")}((const char*){slot}));")
    } else if ct == CT_FLOAT {
        emit_line("result = blink_str_concat(result, {c_fn_name("float_to_str")}(*(double*){slot}));")
    } else if ct == CT_BOOL {
        emit_line("result = blink_str_concat(result, (int64_t)(intptr_t){slot} ? \"true\" : \"false\");")
    } else if ct == CT_CHAR {
        emit_line("result = blink_str_concat(result, blink_char_debug((int64_t)(intptr_t){slot}));")
    } else {
        // Int / sized-int — stored as intptr-packed scalar.
        emit_line("result = blink_str_concat(result, {c_fn_name("int_to_str")}((int64_t)(intptr_t){slot}));")
    }
}

// Emit Debug rendering of one container element / field held as a typed C VALUE
// (Option.value, enum-variant field self.data.V.f). Nested containers pass the
// value directly (no cast); scalars/Str/Char render by value; structs call
// {cn}_debug directly.
fn emit_debug_value(access: Str, desc: Str) ! Codegen.Emit {
    let ct = desc_primary_ct(desc)
    if desc.starts_with("S:") {
        let sname = desc.slice(2, desc.len())
        emit_line("result = blink_str_concat(result, {c_type_c_name(sname)}_debug({access}));")
        return
    }
    if desc.starts_with("L:") || desc.starts_with("M:") || desc.starts_with("O:") {
        emit_line("result = blink_str_concat(result, blink_debug_{descriptor_mangle(desc)}({access}));")
        return
    }
    if ct == CT_STRING {
        emit_line("result = blink_str_concat(result, {c_fn_name("json_escape_str")}({access}));")
    } else if ct == CT_FLOAT {
        emit_line("result = blink_str_concat(result, {c_fn_name("float_to_str")}({access}));")
    } else if ct == CT_BOOL {
        emit_line("result = blink_str_concat(result, ({access}) ? \"true\" : \"false\");")
    } else if ct == CT_CHAR {
        emit_line("result = blink_str_concat(result, blink_char_debug((int64_t)({access})));")
    } else {
        emit_line("result = blink_str_concat(result, {c_fn_name("int_to_str")}((int64_t)({access})));")
    }
}

fn emit_debug_list_fn(desc: Str) ! Codegen.Emit {
    let inner = inner_desc_of(desc)
    let mangle = descriptor_mangle(desc)
    emit_line("const char* blink_debug_{mangle}(blink_list* v) \{")
    cg_indent = cg_indent + 1
    emit_line("const char* result = \"[\";")
    emit_line("int64_t _len = blink_list_len(v);")
    emit_line("for (int64_t _i = 0; _i < _len; _i++) \{")
    cg_indent = cg_indent + 1
    emit_line("if (_i > 0) result = blink_str_concat(result, \", \");")
    emit_debug_slot("blink_list_get(v, _i)", inner)
    cg_indent = cg_indent - 1
    emit_line("}")
    emit_line("result = blink_str_concat(result, \"]\");")
    emit_line("return result;")
    cg_indent = cg_indent - 1
    emit_line("}")
    emit_line("")
}

// The Option carrier stores its inner value inline when the inner's C type is
// already a pointer (List/Map → blink_list*/blink_map*) or a scalar; but it BOXES
// a struct / nested-Option / nested-Result inner behind a pointer
// (emit_struct_option_typedef: `{inner_c}* value` when inner_c does not end in
// `*`). So `v.value` for those inners is a `T*` and must be dereferenced before
// handing it to the by-value {cn}_debug / blink_debug_ walker.
fn option_inner_is_boxed(inner: Str) -> Int {
    if inner.starts_with("S:") { return 1 }
    if inner.starts_with("O:") { return 1 }
    if inner.starts_with("R:") { return 1 }
    0
}

fn emit_debug_option_fn(desc: Str) ! Codegen.Emit {
    let inner = inner_desc_of(desc)
    let mangle = descriptor_mangle(desc)
    let cty = descriptor_c_type(desc)
    emit_line("const char* blink_debug_{mangle}({cty} v) \{")
    cg_indent = cg_indent + 1
    emit_line("const char* result = \"\";")
    emit_line("if (v.tag == 1) \{")
    cg_indent = cg_indent + 1
    emit_line("result = \"Some(\";")
    let val_access = if option_inner_is_boxed(inner) != 0 { "(*v.value)" } else { "v.value" }
    emit_debug_value(val_access, inner)
    emit_line("result = blink_str_concat(result, \")\");")
    cg_indent = cg_indent - 1
    emit_line("} else \{")
    cg_indent = cg_indent + 1
    emit_line("result = \"None\";")
    cg_indent = cg_indent - 1
    emit_line("}")
    emit_line("return result;")
    cg_indent = cg_indent - 1
    emit_line("}")
    emit_line("")
}

fn emit_debug_map_fn(desc: Str) ! Codegen.Emit {
    let rest = desc.slice(2, desc.len())
    let bar = rest.index_of("|")
    let kd = rest.slice(0, bar)
    let vd = rest.slice(bar + 1, rest.len())
    let kct = desc_primary_ct(kd)
    let kstruct = if kd.starts_with("S:") { kd.slice(2, kd.len()) } else { "" }
    let mangle = descriptor_mangle(desc)
    emit_line("const char* blink_debug_{mangle}(blink_map* v) \{")
    cg_indent = cg_indent + 1
    emit_line("const char* result = \"\{\";")
    emit_line("blink_map* _m = v;")
    emit_line("size_t _stride = blink_kops_stride(_m->kops);")
    emit_line("int _first = 1;")
    emit_line("for (int64_t _i = 0; _i < _m->cap; _i++) \{")
    cg_indent = cg_indent + 1
    emit_line("if (_m->states[_i] != 1) continue;")
    emit_line("if (!_first) result = blink_str_concat(result, \", \");")
    emit_line("_first = 0;")
    emit_debug_map_key("blink_map_key_slot(_m, _i, _stride)", kct, kstruct)
    emit_line("result = blink_str_concat(result, \": \");")
    emit_debug_slot("_m->values[_i]", vd)
    cg_indent = cg_indent - 1
    emit_line("}")
    emit_line("result = blink_str_concat(result, \"}\");")
    emit_line("return result;")
    cg_indent = cg_indent - 1
    emit_line("}")
    emit_line("")
}

@allow(UnrestoredMutation)
pub fn emit_debug_forward_decls() ! Codegen.Emit {
    let mut i = debug_fwd_emitted
    while i < debug_types.len() {
        let desc = debug_types.get(i).unwrap()
        let mangle = descriptor_mangle(desc)
        let cty = descriptor_c_type(desc)
        emit_line("const char* blink_debug_{mangle}({cty} v);")
        i = i + 1
    }
    debug_fwd_emitted = debug_types.len()
}

pub fn emit_debug_fn_defs() ! Codegen.Emit {
    let mut i = 0
    while i < debug_types.len() {
        let desc = debug_types.get(i).unwrap()
        if desc.starts_with("L:") {
            emit_debug_list_fn(desc)
        } else if desc.starts_with("O:") {
            emit_debug_option_fn(desc)
        } else if desc.starts_with("M:") {
            emit_debug_map_fn(desc)
        }
        i = i + 1
    }
}

// Queue every container descriptor reachable from the @derive(Debug) types so
// emit_debug_forward_decls can run in the forward-decl phase. Walks struct
// fields via tp_to_descriptor and enum-variant fields via the type-string
// parser — both front doors converge on the shared descriptor set.
pub fn queue_all_debug_types() {
    let mut dbi = 0
    while dbi < derive_debug_types.len() {
        let tname = derive_debug_types.get(dbi).unwrap()
        if is_enum_type(tname) != 0 {
            queue_debug_types_for_enum(tname)
        } else {
            queue_debug_type("S:{tname}")
        }
        dbi = dbi + 1
    }
}

fn queue_debug_types_for_enum(type_name: Str) {
    let eidx = get_enum_reg_idx(type_name)
    if eidx == -1 { return }
    let mut i = 0
    while i < enum_variants.len() {
        let evar = enum_variants.get(i).unwrap()
        if evar.enum_idx == eidx {
            let vidx = i
            let mut fi = 0
            while fi < evar.field_count {
                let ftype_str = get_variant_field_type_str(vidx, fi).unwrap()
                let fct = type_from_name(ftype_str)
                if fct == CT_LIST || fct == CT_OPTION || fct == CT_MAP {
                    queue_debug_type(parse_type_str_to_descriptor(ftype_str))
                }
                fi = fi + 1
            }
        }
        i = i + 1
    }
}

// Emit one SCALAR / Str / user-type value's Debug rendering, concatenated onto
// `result`. Containers (List/Option/Map) are handled by emit_field_debug_struct
// on the struct path; on the enum-variant path a container field is rejected at
// typecheck (E0520), so by codegen the only field types reaching here are
// scalars, Str, and Debug-deriving user types. Nested non-Debug user types are
// likewise rejected earlier (E0520) — the nested debug() always exists.
fn emit_field_debug(access: Str, field_type: Int, stype: Str) ! Codegen.Emit {
    if field_type == CT_STRING {
        emit_line("result = blink_str_concat(result, {c_fn_name("json_escape_str")}({access}));")
    } else if field_type == CT_BOOL {
        emit_line("result = blink_str_concat(result, {access} ? \"true\" : \"false\");")
    } else if field_type == CT_FLOAT {
        emit_line("result = blink_str_concat(result, {c_fn_name("float_to_str")}({access}));")
    } else if field_type == CT_CHAR {
        emit_line("result = blink_str_concat(result, blink_char_debug((int64_t){access}));")
    } else if is_hash_scalar_ct(field_type) != 0 {
        emit_line("result = blink_str_concat(result, {c_fn_name("int_to_str")}({access}));")
    } else if field_type == CT_VOID && stype != "" && has_derive_method(stype, "debug") != 0 {
        emit_line("result = blink_str_concat(result, {c_type_c_name(stype)}_debug({access}));")
    } else {
        // Unreachable: containers dispatch via emit_field_debug_struct and
        // enum-variant containers / non-Debug fields are rejected by typecheck
        // (E0520). Mirror emit_struct_hash's compiler-bug marker rather than a
        // silent placeholder so a typecheck/codegen disagreement surfaces.
        emit_line("/* BLINK_COMPILER_BUG: @derive(Debug) field reached emit_field_debug with an un-renderable type — typecheck E0520 should have rejected this */")
        emit_line("result = blink_str_concat(result, \"<?>\");")
    }
}

// Struct-field container Debug now routes through the recursive descriptor
// walkers (blink_debug_{mangle}) so top-level and nested containers render via
// the same depth-agnostic generated fn. The field's tp_id gives the exact
// descriptor (queued during the codegen pre-pass, so the walker exists).
fn emit_list_debug(access: Str, struct_name: Str, field_name: Str) ! Codegen.Emit {
    let fa_tp = get_struct_field_tp_id(struct_name, field_name)
    let desc = tp_to_descriptor(fa_tp)
    emit_line("result = blink_str_concat(result, blink_debug_{descriptor_mangle(desc)}({access}));")
}

fn emit_option_debug(access: Str, struct_name: Str, field_name: Str) ! Codegen.Emit {
    let fa_tp = get_struct_field_tp_id(struct_name, field_name)
    let desc = tp_to_descriptor(fa_tp)
    emit_line("result = blink_str_concat(result, blink_debug_{descriptor_mangle(desc)}({access}));")
}

// Emit Debug rendering of one Map KEY read from the kops storage slot. Keys are
// stored per the kops vtable: inline_key=0 (Str) → the slot holds a pointer;
// inline_key=1 (Char/Int/Bool/sized) → the slot holds the bytes inline at the
// kops stride (= sizeof(K)'s C type). We read the raw slot via blink_map_key_slot(...)
// and MUST cast to the exact width blink_kops_eq_* uses for K — reading a narrow
// key as int64_t over-reads the slot (up to 7 bytes) and, for signed narrow keys,
// mis-renders the value (e.g. I8 -1 as 255). Typecheck restricts K to
// Str/Char/Int/Bool/sized-int, or a @derive(Debug, Hash, Eq) user struct
// (key_struct != "", handled first).
fn emit_debug_map_key(slot: Str, key_ct: Int, key_struct: Str) ! Codegen.Emit {
    if key_struct != "" {
        // @derive(Debug, Hash, Eq) user-struct key. Struct kops set inline_key=0
        // (codegen_derive.bl:253), so the key is stored by pointer and
        // blink_map_key_slot already dereferences it — `slot` is a {cn}*. Read
        // the struct by value and render via its debug(), mirroring
        // emit_debug_slot's S: branch for values.
        emit_line("{c_type_c_name(key_struct)} _k = *({c_type_c_name(key_struct)}*){slot};")
        emit_line("result = blink_str_concat(result, {c_type_c_name(key_struct)}_debug(_k));")
    } else if key_ct == CT_STRING {
        emit_line("result = blink_str_concat(result, {c_fn_name("json_escape_str")}((const char*){slot}));")
    } else if key_ct == CT_BOOL {
        // 1-byte kops stride (blink_kops_bool); read uint8_t like blink_kops_eq_bool.
        emit_line("result = blink_str_concat(result, (*(const uint8_t*){slot}) ? \"true\" : \"false\");")
    } else if key_ct == CT_CHAR {
        // 4-byte kops stride (blink_kops_char, sizeof(uint32_t)); read uint32_t.
        emit_line("result = blink_str_concat(result, blink_char_debug((int64_t)*(const uint32_t*){slot}));")
    } else {
        // Int / sized-int: read at the key's native width (matching blink_kops_eq_*)
        // then widen to int64_t for int_to_str — signed types sign-extend.
        emit_line("result = blink_str_concat(result, {c_fn_name("int_to_str")}((int64_t){map_key_read_expr(key_ct, slot)}));")
    }
}

// The width-correct dereference of an inline integer Map-key slot, matching the
// kops stride for `key_ct` (blink_kops_eq_* casts). Int/U64 are 8-byte; the
// narrower sized ints read their exact C type so the value is not corrupted by
// adjacent slot bytes (over-read) or wrong signedness.
fn map_key_read_expr(key_ct: Int, slot: Str) -> Str {
    if key_ct == CT_I8 { return "*(const int8_t*){slot}" }
    if key_ct == CT_I16 { return "*(const int16_t*){slot}" }
    if key_ct == CT_I32 { return "*(const int32_t*){slot}" }
    if key_ct == CT_U8 { return "*(const uint8_t*){slot}" }
    if key_ct == CT_U16 { return "*(const uint16_t*){slot}" }
    if key_ct == CT_U32 { return "*(const uint32_t*){slot}" }
    if key_ct == CT_U64 { return "*(const uint64_t*){slot}" }
    // CT_INT (and any other 8-byte integer key): full-width read.
    "*(const int64_t*){slot}"
}

fn emit_map_debug(access: Str, struct_name: Str, field_name: Str) ! Codegen.Emit {
    let fa_tp = get_struct_field_tp_id(struct_name, field_name)
    let desc = tp_to_descriptor(fa_tp)
    emit_line("result = blink_str_concat(result, blink_debug_{descriptor_mangle(desc)}({access}));")
}

// Struct-field Debug dispatch. Scalars / Str / user-types delegate to
// emit_field_debug (unchanged, shared with the enum path). Container fields
// (List/Option/Map) render their elements via the per-container emitters,
// using the field's tp_id (available only at the struct call site).
fn emit_field_debug_struct(access: Str, field_type: Int, stype: Str, struct_name: Str, field_name: Str) ! Codegen.Emit {
    if field_type == CT_LIST {
        emit_list_debug(access, struct_name, field_name)
    } else if field_type == CT_OPTION {
        emit_option_debug(access, struct_name, field_name)
    } else if field_type == CT_MAP {
        emit_map_debug(access, struct_name, field_name)
    } else {
        emit_field_debug(access, field_type, stype)
    }
}

fn emit_struct_debug(type_name: Str) ! Codegen.Emit {
    emit_line("const char* {c_type_c_name(type_name)}_debug({c_type_c_name(type_name)} self) \{")
    cg_indent = cg_indent + 1
    emit_line("const char* result = \"{type_name} \{ \";")
    let mut _field_idx = 0
    let mut i = 0
    while i < sf_entries.len() {
        let sf = sf_entries.get(i).unwrap()
        if sf.struct_name == type_name {
            if _field_idx > 0 {
                emit_line("result = blink_str_concat(result, \", \");")
            }
            emit_line("result = blink_str_concat(result, \"{sf.field_name}: \");")
            emit_field_debug_struct("self.{sf.field_name}", sf.field_type, sf.stype, type_name, sf.field_name)
            _field_idx = _field_idx + 1
        }
        i = i + 1
    }
    emit_line("result = blink_str_concat(result, \" }\");")
    emit_line("return result;")
    cg_indent = cg_indent - 1
    emit_line("}")
    emit_line("")
}

fn emit_enum_debug(type_name: Str) ! Codegen.Emit {
    let eidx = get_enum_reg_idx(type_name)
    if eidx == -1 { return }
    let is_data = is_data_enum(type_name)

    if is_data == 0 {
        emit_line("const char* {c_type_c_name(type_name)}_debug({c_type_c_name(type_name)} self) \{")
        cg_indent = cg_indent + 1
        emit_line("switch (self) \{")
        cg_indent = cg_indent + 1
        let mut i = 0
        while i < enum_variants.len() {
            let evar = enum_variants.get(i).unwrap()
            if evar.enum_idx == eidx {
                emit_line("case {c_type_c_name(type_name)}_{evar.name}: return \"{evar.name}\";")
            }
            i = i + 1
        }
        emit_line("default: return \"<unknown>\";")
        cg_indent = cg_indent - 1
        emit_line("}")
        cg_indent = cg_indent - 1
        emit_line("}")
        emit_line("")
    } else {
        emit_line("const char* {c_type_c_name(type_name)}_debug({c_type_c_name(type_name)} self) \{")
        cg_indent = cg_indent + 1
        emit_line("const char* result = \"\";")
        emit_line("switch (self.tag) \{")
        cg_indent = cg_indent + 1
        let mut _tag = 0
        let mut i = 0
        while i < enum_variants.len() {
            let evar = enum_variants.get(i).unwrap()
            if evar.enum_idx == eidx {
                emit_line("case {_tag}: \{")
                cg_indent = cg_indent + 1
                if evar.field_count > 0 {
                    emit_line("result = \"{evar.name}(\";")
                    let vidx = i
                    let mut fi = 0
                    while fi < evar.field_count {
                        let fname = get_variant_field_name(vidx, fi).unwrap()
                        let ftype_str = get_variant_field_type_str(vidx, fi).unwrap()
                        let fct = type_from_name(ftype_str)
                        if fi > 0 {
                            emit_line("result = blink_str_concat(result, \", \");")
                        }
                        let access = "self.data.{evar.name}.{fname}"
                        if fct == CT_LIST || fct == CT_OPTION || fct == CT_MAP {
                            // Enum-variant container field (x112x7): parse the
                            // type STRING into a descriptor (no tp_id here) and
                            // render the typed value via the shared walker.
                            let desc = parse_type_str_to_descriptor(ftype_str)
                            emit_debug_value(access, desc)
                        } else {
                            let fstype = if is_struct_type(ftype_str) != 0 || is_enum_type(ftype_str) != 0 { ftype_str } else { "" }
                            emit_field_debug(access, fct, fstype)
                        }
                        fi = fi + 1
                    }
                    emit_line("result = blink_str_concat(result, \")\");")
                } else {
                    emit_line("result = \"{evar.name}\";")
                }
                emit_line("return result;")
                cg_indent = cg_indent - 1
                emit_line("}")
                _tag = _tag + 1
            }
            i = i + 1
        }
        emit_line("default: return \"<unknown>\";")
        cg_indent = cg_indent - 1
        emit_line("}")
        cg_indent = cg_indent - 1
        emit_line("}")
        emit_line("")
    }
}

fn emit_json_extern_decls() ! Codegen.Emit {
    emit_line("// JSON parser extern declarations for derive(Deserialize)")
    emit_line("extern void {c_fn_name("json_clear")}(void);")
    emit_line("extern int64_t {c_fn_name("json_parse")}(const char* input);")
    emit_line("extern int64_t {c_fn_name("json_get")}(int64_t idx, const char* key);")
    emit_line("extern int64_t {c_fn_name("json_type")}(int64_t idx);")
    emit_line("extern const char* {c_fn_name("json_as_str")}(int64_t idx);")
    emit_line("extern int64_t {c_fn_name("json_as_int")}(int64_t idx);")
    emit_line("extern double {c_fn_name("json_as_float")}(int64_t idx);")
    emit_line("extern int64_t {c_fn_name("json_as_bool")}(int64_t idx);")
    emit_line("extern int64_t {c_fn_name("json_at")}(int64_t idx, int64_t i);")
    emit_line("extern int64_t {c_fn_name("json_len")}(int64_t idx);")
    emit_line("")
}

pub let mut deser_externs_emitted = 0

fn emit_struct_from_json(type_name: Str) ! Codegen.Emit {
    if deser_externs_emitted == 0 {
        emit_json_extern_decls()
        deser_externs_emitted = 1
    }
    let cs_tag = canonical_struct_tag(type_name)
    emit_line("blink_Result_{cs_tag}_str {c_type_c_name(type_name)}_from_json(const char* input) \{")
    cg_indent = cg_indent + 1
    emit_line("blink_Result_{cs_tag}_str _r;")
    emit_line("{c_fn_name("json_clear")}();")
    emit_line("int64_t _root = {c_fn_name("json_parse")}(input);")
    emit_line("if (_root < 0) \{")
    cg_indent = cg_indent + 1
    emit_line("_r.tag = 1;")
    emit_line("_r.err = \"JSON parse error\";")
    emit_line("return _r;")
    cg_indent = cg_indent - 1
    emit_line("}")
    emit_line("{c_type_c_name(type_name)} _val;")
    // Iterate struct fields
    let mut i = 0
    while i < sf_entries.len() {
        let sf = sf_entries.get(i).unwrap()
        if sf.struct_name == type_name {
            emit_line("\{")
            cg_indent = cg_indent + 1
            emit_line("int64_t _f = {c_fn_name("json_get")}(_root, \"{sf.field_name}\");")
            emit_deser_field("_val.{sf.field_name}", "_f", sf.field_type, sf.stype, type_name, sf.field_name)
            cg_indent = cg_indent - 1
            emit_line("}")
        }
        i = i + 1
    }
    emit_line("_r.tag = 0;")
    emit_line("_r.ok = _val;")
    emit_line("return _r;")
    cg_indent = cg_indent - 1
    emit_line("}")
    emit_line("")
}

fn emit_deser_field(target: Str, node_var: Str, field_type: Int, stype: Str, struct_name: Str, field_name: Str) ! Codegen.Emit {
    if field_type == CT_STRING {
        emit_line("{target} = {c_fn_name("json_as_str")}({node_var});")
    } else if field_type == CT_INT {
        emit_line("{target} = {c_fn_name("json_as_int")}({node_var});")
    } else if field_type == CT_FLOAT {
        emit_line("{target} = {c_fn_name("json_as_float")}({node_var});")
    } else if field_type == CT_BOOL {
        emit_line("{target} = {c_fn_name("json_as_bool")}({node_var});")
    } else if field_type == CT_VOID && stype != "" {
        if has_derive_method(stype, "from_json") != 0 {
            emit_line("// nested deserialize: re-serialize node to string, call from_json")
            emit_line("// For now, set to default zero-initialized value")
            emit_line("memset(&{target}, 0, sizeof({target}));")
        } else {
            emit_line("memset(&{target}, 0, sizeof({target}));")
        }
    } else if field_type == CT_LIST {
        emit_list_deserialize(target, node_var, struct_name, field_name)
    } else {
        emit_line("// unknown field type, zero-init")
        emit_line("memset(&{target}, 0, sizeof({target}));")
    }
}

fn emit_list_deserialize(target: Str, node_var: Str, struct_name: Str, field_name: Str) ! Codegen.Emit {
    let fa_tp = get_struct_field_tp_id(struct_name, field_name)
    let elem_type = if fa_tp >= 0 { tp_child1_kind(fa_tp) } else { CT_INT }
    emit_line("{target} = blink_list_new();")
    emit_line("\{")
    cg_indent = cg_indent + 1
    emit_line("int64_t _arr_len = {c_fn_name("json_len")}({node_var});")
    emit_line("for (int64_t _ai = 0; _ai < _arr_len; _ai++) \{")
    cg_indent = cg_indent + 1
    emit_line("int64_t _elem_node = {c_fn_name("json_at")}({node_var}, _ai);")
    if elem_type == CT_STRING {
        emit_line("blink_list_push({target}, (void*){c_fn_name("json_as_str")}(_elem_node));")
    } else if elem_type == CT_INT {
        emit_line("blink_list_push({target}, (void*)(intptr_t){c_fn_name("json_as_int")}(_elem_node));")
    } else if elem_type == CT_FLOAT {
        let fbox = fresh_temp("_fbox")
        emit_line("double* {fbox} = (double*)blink_alloc(sizeof(double));")
        emit_line("*{fbox} = {c_fn_name("json_as_float")}(_elem_node);")
        emit_line("blink_list_push({target}, (void*){fbox});")
    } else if elem_type == CT_BOOL {
        emit_line("blink_list_push({target}, (void*)(intptr_t){c_fn_name("json_as_bool")}(_elem_node));")
    } else {
        emit_line("// unsupported list element type")
    }
    cg_indent = cg_indent - 1
    emit_line("}")
    cg_indent = cg_indent - 1
    emit_line("}")
}

fn emit_enum_from_json(type_name: Str) ! Codegen.Emit {
    if deser_externs_emitted == 0 {
        emit_json_extern_decls()
        deser_externs_emitted = 1
    }
    let eidx = get_enum_reg_idx(type_name)
    if eidx == -1 { return }
    let is_data = is_data_enum(type_name)

    let cs_tag = canonical_struct_tag(type_name)
    emit_line("blink_Result_{cs_tag}_str {c_type_c_name(type_name)}_from_json(const char* input) \{")
    cg_indent = cg_indent + 1
    emit_line("blink_Result_{cs_tag}_str _r;")
    emit_line("{c_fn_name("json_clear")}();")
    emit_line("int64_t _root = {c_fn_name("json_parse")}(input);")
    emit_line("if (_root < 0) \{")
    cg_indent = cg_indent + 1
    emit_line("_r.tag = 1;")
    emit_line("_r.err = \"JSON parse error\";")
    emit_line("return _r;")
    cg_indent = cg_indent - 1
    emit_line("}")

    if is_data == 0 {
        emit_line("const char* _str = {c_fn_name("json_as_str")}(_root);")
        let mut i = 0
        let mut _tag = 0
        while i < enum_variants.len() {
            let evar = enum_variants.get(i).unwrap()
            if evar.enum_idx == eidx {
                let deser_val = if evar.str_value != "" { evar.str_value } else { evar.name }
                if _tag == 0 {
                    emit_line("if (blink_str_eq(_str, \"{deser_val}\")) \{")
                } else {
                    emit_line("} else if (blink_str_eq(_str, \"{deser_val}\")) \{")
                }
                cg_indent = cg_indent + 1
                emit_line("_r.tag = 0;")
                emit_line("_r.ok = {c_type_c_name(type_name)}_{evar.name};")
                cg_indent = cg_indent - 1
                _tag = _tag + 1
            }
            i = i + 1
        }
        emit_line("} else \{")
        cg_indent = cg_indent + 1
        emit_line("_r.tag = 1;")
        emit_line("_r.err = \"unknown enum variant\";")
        cg_indent = cg_indent - 1
        emit_line("}")
    } else {
        emit_line("int64_t _type_node = {c_fn_name("json_get")}(_root, \"type\");")
        emit_line("if (_type_node < 0) \{")
        cg_indent = cg_indent + 1
        emit_line("_r.tag = 1;")
        emit_line("_r.err = \"missing type discriminator\";")
        emit_line("return _r;")
        cg_indent = cg_indent - 1
        emit_line("}")
        emit_line("const char* _disc = {c_fn_name("json_as_str")}(_type_node);")
        emit_line("{c_type_c_name(type_name)} _val;")
        let mut i = 0
        let mut _tag = 0
        let mut _first = 1
        while i < enum_variants.len() {
            let evar = enum_variants.get(i).unwrap()
            if evar.enum_idx == eidx {
                if _first == 1 {
                    emit_line("if (blink_str_eq(_disc, \"{evar.name}\")) \{")
                    _first = 0
                } else {
                    emit_line("} else if (blink_str_eq(_disc, \"{evar.name}\")) \{")
                }
                cg_indent = cg_indent + 1
                emit_line("_val.tag = {_tag};")
                if evar.field_count > 0 {
                    let vidx = i
                    let mut fi = 0
                    while fi < evar.field_count {
                        let fname = get_variant_field_name(vidx, fi).unwrap()
                        let ftype_str = get_variant_field_type_str(vidx, fi).unwrap()
                        let fct = type_from_name(ftype_str)
                        emit_line("\{")
                        cg_indent = cg_indent + 1
                        emit_line("int64_t _fv = {c_fn_name("json_get")}(_root, \"{fname}\");")
                        if fct == CT_STRING {
                            emit_line("_val.data.{evar.name}.{fname} = {c_fn_name("json_as_str")}(_fv);")
                        } else if fct == CT_INT {
                            emit_line("_val.data.{evar.name}.{fname} = {c_fn_name("json_as_int")}(_fv);")
                        } else if fct == CT_FLOAT {
                            emit_line("_val.data.{evar.name}.{fname} = {c_fn_name("json_as_float")}(_fv);")
                        } else if fct == CT_BOOL {
                            emit_line("_val.data.{evar.name}.{fname} = {c_fn_name("json_as_bool")}(_fv);")
                        } else {
                            emit_line("// unsupported variant field type")
                        }
                        cg_indent = cg_indent - 1
                        emit_line("}")
                        fi = fi + 1
                    }
                }
                cg_indent = cg_indent - 1
                _tag = _tag + 1
            }
            i = i + 1
        }
        emit_line("} else \{")
        cg_indent = cg_indent + 1
        emit_line("_r.tag = 1;")
        emit_line("_r.err = \"unknown enum variant\";")
        emit_line("return _r;")
        cg_indent = cg_indent - 1
        emit_line("}")
        emit_line("_r.tag = 0;")
        emit_line("_r.ok = _val;")
    }

    emit_line("return _r;")
    cg_indent = cg_indent - 1
    emit_line("}")
    emit_line("")
}

fn emit_struct_eq(type_name: Str) ! Codegen.Emit {
    emit_line("int {c_type_c_name(type_name)}_eq({c_type_c_name(type_name)} self, {c_type_c_name(type_name)} other) \{")
    cg_indent = cg_indent + 1
    let mut i = 0
    while i < sf_entries.len() {
        let sf = sf_entries.get(i).unwrap()
        if sf.struct_name == type_name {
            if sf.field_type == CT_STRING {
                emit_line("if (!blink_str_eq(self.{sf.field_name}, other.{sf.field_name})) return 0;")
            } else if is_hash_scalar_ct(sf.field_type) != 0 {
                emit_line("if (self.{sf.field_name} != other.{sf.field_name}) return 0;")
            } else if sf.field_type == CT_FLOAT {
                emit_line("if (self.{sf.field_name} != other.{sf.field_name}) return 0;")
            } else if sf.field_type == CT_VOID && sf.stype != "" {
                if has_derive_method(sf.stype, "eq") != 0 {
                    emit_line("if (!{c_type_c_name(sf.stype)}_eq(self.{sf.field_name}, other.{sf.field_name})) return 0;")
                }
            }
        }
        i = i + 1
    }
    emit_line("return 1;")
    cg_indent = cg_indent - 1
    emit_line("}")
    emit_line("")
}

fn emit_enum_eq(type_name: Str) ! Codegen.Emit {
    let eidx = get_enum_reg_idx(type_name)
    if eidx == -1 { return }
    let is_data = is_data_enum(type_name)

    emit_line("int {c_type_c_name(type_name)}_eq({c_type_c_name(type_name)} self, {c_type_c_name(type_name)} other) \{")
    cg_indent = cg_indent + 1

    if is_data == 0 {
        emit_line("return self == other;")
    } else {
        emit_line("if (self.tag != other.tag) return 0;")
        emit_line("switch (self.tag) \{")
        cg_indent = cg_indent + 1
        let mut _tag = 0
        let mut i = 0
        while i < enum_variants.len() {
            let evar = enum_variants.get(i).unwrap()
            if evar.enum_idx == eidx {
                emit_line("case {_tag}: \{")
                cg_indent = cg_indent + 1
                if evar.field_count > 0 {
                    let vidx = i
                    let mut fi = 0
                    while fi < evar.field_count {
                        let fname = get_variant_field_name(vidx, fi).unwrap()
                        let ftype_str = get_variant_field_type_str(vidx, fi).unwrap()
                        let fct = type_from_name(ftype_str)
                        if fct == CT_STRING {
                            emit_line("if (!blink_str_eq(self.data.{evar.name}.{fname}, other.data.{evar.name}.{fname})) return 0;")
                        } else if is_hash_scalar_ct(fct) != 0 {
                            emit_line("if (self.data.{evar.name}.{fname} != other.data.{evar.name}.{fname}) return 0;")
                        } else if fct == CT_FLOAT {
                            emit_line("if (self.data.{evar.name}.{fname} != other.data.{evar.name}.{fname}) return 0;")
                        } else if is_struct_type(ftype_str) != 0 && has_derive_method(ftype_str, "eq") != 0 {
                            emit_line("if (!{c_type_c_name(ftype_str)}_eq(self.data.{evar.name}.{fname}, other.data.{evar.name}.{fname})) return 0;")
                        }
                        fi = fi + 1
                    }
                }
                emit_line("return 1;")
                cg_indent = cg_indent - 1
                emit_line("}")
                _tag = _tag + 1
            }
            i = i + 1
        }
        emit_line("default: return 0;")
        cg_indent = cg_indent - 1
        emit_line("}")
    }

    cg_indent = cg_indent - 1
    emit_line("}")
    emit_line("")
}

// vfgp72: lexicographic Ord.cmp synthesis. Returns an Ordering enum value
// (Less/Equal/Greater). Scalar/Float/Str fields compare directly; nested
// struct/enum fields recurse through their own derived `_cmp`. A field type
// without Ord is rejected at derive time (validate_derive_ord_fields).
fn ord_c(variant: Str) -> Str {
    "{c_type_c_name("Ordering")}_{variant}"
}

// Emit the per-field "<,> short-circuit" comparison for a struct or enum
// payload field. `lhs`/`rhs` are the C lvalue expressions (e.g. "self.x",
// "self.data.Circle.radius"). `ftype_str` names a nested Ord type, else "".
// A field that is neither a scalar/Float/Str nor a derived-Ord type is left
// uncompared here — validate_derive_ord_fields already rejected it at derive
// time, so this only runs for valid fields.
fn emit_cmp_field(lhs: Str, rhs: Str, fct: Int, ftype_str: Str) ! Codegen.Emit {
    if fct == CT_STRING {
        emit_line("\{ int64_t __c = blink_str_cmp({lhs}, {rhs}); if (__c < 0) return {ord_c("Less")}; if (__c > 0) return {ord_c("Greater")}; }")
    } else if is_hash_scalar_ct(fct) != 0 {
        emit_line("if ({lhs} < {rhs}) return {ord_c("Less")};")
        emit_line("if ({lhs} > {rhs}) return {ord_c("Greater")};")
    } else if fct == CT_FLOAT {
        emit_line("if ({lhs} < {rhs}) return {ord_c("Less")};")
        emit_line("if ({lhs} > {rhs}) return {ord_c("Greater")};")
    } else if ftype_str != "" && has_derive_method(ftype_str, "cmp") != 0 {
        emit_line("\{ {c_type_c_name("Ordering")} __o = {c_type_c_name(ftype_str)}_cmp({lhs}, {rhs}); if (__o != {ord_c("Equal")}) return __o; }")
    }
}

// vfgp72: a field type usable by @derive(Ord) is a scalar, Float, Str, or a
// type that itself derives Ord. Bool is excluded — it has Eq but not Ord
// (spec §3.6 built-in trait table).
fn cmp_field_type_ok(fct: Int, ftype_str: Str) -> Int {
    if fct == CT_STRING { return 1 }
    if is_hash_scalar_ct(fct) != 0 { return 1 }
    if fct == CT_FLOAT { return 1 }
    if ftype_str != "" && has_derive_method(ftype_str, "cmp") != 0 { return 1 }
    0
}

fn emit_struct_cmp(type_name: Str) ! Codegen.Emit {
    emit_line("{c_type_c_name("Ordering")} {c_type_c_name(type_name)}_cmp({c_type_c_name(type_name)} self, {c_type_c_name(type_name)} other) \{")
    cg_indent = cg_indent + 1
    let mut i = 0
    while i < sf_entries.len() {
        let sf = sf_entries.get(i).unwrap()
        if sf.struct_name == type_name {
            let fts = if sf.field_type == CT_VOID { sf.stype } else { "" }
            emit_cmp_field("self.{sf.field_name}", "other.{sf.field_name}", sf.field_type, fts)
        }
        i = i + 1
    }
    emit_line("return {ord_c("Equal")};")
    cg_indent = cg_indent - 1
    emit_line("}")
    emit_line("")
}

fn emit_enum_cmp(type_name: Str) ! Codegen.Emit {
    let eidx = get_enum_reg_idx(type_name)
    if eidx == -1 { return }
    let is_data = is_data_enum(type_name)

    emit_line("{c_type_c_name("Ordering")} {c_type_c_name(type_name)}_cmp({c_type_c_name(type_name)} self, {c_type_c_name(type_name)} other) \{")
    cg_indent = cg_indent + 1

    if is_data == 0 {
        emit_line("if (self < other) return {ord_c("Less")};")
        emit_line("if (self > other) return {ord_c("Greater")};")
        emit_line("return {ord_c("Equal")};")
    } else {
        emit_line("if (self.tag < other.tag) return {ord_c("Less")};")
        emit_line("if (self.tag > other.tag) return {ord_c("Greater")};")
        emit_line("switch (self.tag) \{")
        cg_indent = cg_indent + 1
        let mut _tag = 0
        let mut i = 0
        while i < enum_variants.len() {
            let evar = enum_variants.get(i).unwrap()
            if evar.enum_idx == eidx {
                emit_line("case {_tag}: \{")
                cg_indent = cg_indent + 1
                if evar.field_count > 0 {
                    let vidx = i
                    let mut fi = 0
                    while fi < evar.field_count {
                        let fname = get_variant_field_name(vidx, fi).unwrap()
                        let ftype_str = get_variant_field_type_str(vidx, fi).unwrap()
                        let fct = type_from_name(ftype_str)
                        let lhs = "self.data.{evar.name}.{fname}"
                        let rhs = "other.data.{evar.name}.{fname}"
                        let fts = if is_struct_type(ftype_str) != 0 || is_enum_type(ftype_str) != 0 { ftype_str } else { "" }
                        emit_cmp_field(lhs, rhs, fct, fts)
                        fi = fi + 1
                    }
                }
                emit_line("return {ord_c("Equal")};")
                cg_indent = cg_indent - 1
                emit_line("}")
                _tag = _tag + 1
            }
            i = i + 1
        }
        emit_line("default: return {ord_c("Equal")};")
        cg_indent = cg_indent - 1
        emit_line("}")
    }

    cg_indent = cg_indent - 1
    emit_line("}")
    emit_line("")
}

fn emit_struct_clone(type_name: Str) ! Codegen.Emit {
    emit_line("{c_type_c_name(type_name)} {c_type_c_name(type_name)}_clone({c_type_c_name(type_name)} self) \{")
    cg_indent = cg_indent + 1
    emit_line("return self;")
    cg_indent = cg_indent - 1
    emit_line("}")
    emit_line("")
}

fn emit_enum_clone(type_name: Str) ! Codegen.Emit {
    emit_line("{c_type_c_name(type_name)} {c_type_c_name(type_name)}_clone({c_type_c_name(type_name)} self) \{")
    cg_indent = cg_indent + 1
    emit_line("return self;")
    cg_indent = cg_indent - 1
    emit_line("}")
    emit_line("")
}

// ── Arena promotion walkers ──────────────────────────────────────────
//
// For every type T that crosses a `with arena { }` expression boundary,
// emit `blink_promote_<Mangled>(blink_arena_t* target, <CType> src) -> <CType>`.
// Mangling (net-new vs @derive, which bottoms out in struct-name field recursion):
//   Struct Foo       → blink_promote_Foo        (key = "Foo")
//   List[T]          → blink_promote_List_<T>   (key = "List_<T_key>")
//   Map[K, V]        → blink_promote_Map_<K>_<V>
// Str / primitives don't get walkers — Str uses the runtime blink_promote_str;
// primitives copy by value inline in the parent walker.
//
// Types are queued via a descriptor string:
//   "S:<name>"   → struct
//   "L:<inner>"  → list (inner is itself a descriptor)
//   "M:<k>|<v>"  → map (k / v are descriptors; | separator picked to avoid
//                  colliding with ':' used internally)
//   "P:<tag>"    → primitive (Str, Int, Float, Bool) — never queued, used in dispatch

pub let mut promote_types: List[Str] = []
pub let mut promote_emitted: Map[Str, Int] = Map()

pub fn ct_to_descriptor(ct: Int, sname: Str) -> Str {
    if ct == CT_INT { return "P:Int" }
    if ct == CT_FLOAT { return "P:Float" }
    if ct == CT_BOOL { return "P:Bool" }
    if ct == CT_STRING { return "P:Str" }
    // Narrow ints and Char must carry their exact width through the descriptor;
    // collapsing them to "P:Int" picks blink_kops_i64 (8-byte stride) and an
    // 8-byte over-read for a narrow inline map key, corrupting it (bug 2aw8mt).
    if ct == CT_CHAR { return "P:{c_type_tag(ct)}" }
    if ct == CT_I8 || ct == CT_I16 || ct == CT_I32 { return "P:{c_type_tag(ct)}" }
    if ct == CT_U8 || ct == CT_U16 || ct == CT_U32 || ct == CT_U64 { return "P:{c_type_tag(ct)}" }
    if ct == CT_STRUCT || ct == CT_VOID {
        if sname != "" { return "S:{sname}" }
        return "P:Int"
    }
    "P:Int"
}

pub fn descriptor_mangle(desc: Str) -> Str {
    if desc.starts_with("S:") { return desc.slice(2, desc.len()) }
    if desc.starts_with("P:") { return desc.slice(2, desc.len()) }
    if desc.starts_with("C:") { return "Closure_{desc.slice(2, desc.len())}" }
    if desc.starts_with("L:") {
        let inner = desc.slice(2, desc.len())
        return "List_{descriptor_mangle(inner)}"
    }
    if desc.starts_with("O:") {
        return "Option_{descriptor_mangle(inner_desc_of(desc))}"
    }
    if desc.starts_with("R:") {
        let rest = desc.slice(2, desc.len())
        let bar = rest.index_of("|")
        if bar >= 0 {
            let ok = rest.slice(0, bar)
            let err = rest.slice(bar + 1, rest.len())
            return "Result_{descriptor_mangle(ok)}_{descriptor_mangle(err)}"
        }
    }
    if desc.starts_with("M:") {
        let rest = desc.slice(2, desc.len())
        let bar = rest.index_of("|")
        if bar >= 0 {
            let k = rest.slice(0, bar)
            let v = rest.slice(bar + 1, rest.len())
            return "Map_{descriptor_mangle(k)}_{descriptor_mangle(v)}"
        }
    }
    "Int"
}

pub fn descriptor_c_type(desc: Str) -> Str {
    if desc == "P:Int" { return "int64_t" }
    if desc == "P:Float" { return "double" }
    if desc == "P:Bool" { return "int64_t" }
    if desc == "P:Str" { return "const char*" }
    // Narrow int / Char primitive tags (bug 2aw8mt): the exact-match primitive
    // branches above handled Int/Float/Bool/Str, so any remaining "P:" here is a
    // narrow tag — emit its exact C type so a narrow int used as a Map value or
    // Option/Result inner declares the right field width instead of int64_t.
    if desc.starts_with("P:") { return c_type_str(desc_primary_ct(desc)) }
    if desc.starts_with("C:") { return "blink_closure*" }
    if desc.starts_with("S:") {
        let name = desc.slice(2, desc.len())
        return c_type_c_name(name)
    }
    if desc.starts_with("L:") { return "blink_list*" }
    if desc.starts_with("M:") { return "blink_map*" }
    if desc.starts_with("O:") {
        return "blink_Option_{descriptor_typedef_tag(inner_desc_of(desc))}"
    }
    if desc.starts_with("R:") {
        let rest = desc.slice(2, desc.len())
        let bar = rest.index_of("|")
        if bar >= 0 {
            let ok = rest.slice(0, bar)
            let err = rest.slice(bar + 1, rest.len())
            return "blink_Result_{descriptor_typedef_tag(ok)}_{descriptor_typedef_tag(err)}"
        }
    }
    "int64_t"
}

pub fn descriptor_typedef_tag(desc: Str) -> Str {
    if desc.starts_with("S:") { return canonical_struct_tag(desc.slice(2, desc.len())) }
    // Compound inners must recurse so a nested carrier is named the way the
    // Option/Result carrier machinery names it: Option[Option[Int]] →
    // blink_Option_Option_int, not blink_Option_option. Flattening via
    // c_type_tag(CT_OPTION)="option" names an undeclared type (bug found in the
    // ye9ty9/x112x7 review — the shared flat form was latent until nested Debug
    // routed a nested Option/Result through descriptor_c_type).
    if desc.starts_with("O:") {
        return "Option_{descriptor_typedef_tag(inner_desc_of(desc))}"
    }
    if desc.starts_with("R:") {
        let rest = desc.slice(2, desc.len())
        let bar = rest.index_of("|")
        if bar >= 0 {
            let ok = rest.slice(0, bar)
            let err = rest.slice(bar + 1, rest.len())
            return "Result_{descriptor_typedef_tag(ok)}_{descriptor_typedef_tag(err)}"
        }
    }
    c_type_tag(desc_primary_ct(desc))
}

pub fn queue_promote_type(desc: Str) {
    if desc == "" { return }
    if desc.starts_with("P:") { return }
    if promote_emitted.contains_key(desc) { return }
    promote_emitted.insert(desc, 1)
    promote_types.push(desc)
    if desc.starts_with("S:") {
        let sname = desc.slice(2, desc.len())
        let mut i = 0
        while i < sf_entries.len() {
            let sf = sf_entries.get(i).unwrap()
            if sf.struct_name == sname {
                queue_field_type(sf.field_type, sf.stype, sf.tp_id)
            }
            i = i + 1
        }
        return
    }
    if desc.starts_with("L:") {
        let inner = desc.slice(2, desc.len())
        queue_promote_type(inner)
        return
    }
    if desc.starts_with("M:") {
        let rest = desc.slice(2, desc.len())
        let bar = rest.index_of("|")
        if bar >= 0 {
            let k = rest.slice(0, bar)
            let v = rest.slice(bar + 1, rest.len())
            queue_promote_type(k)
            queue_promote_type(v)
        }
        return
    }
    if desc.starts_with("O:") {
        queue_promote_type(inner_desc_of(desc))
        return
    }
    if desc.starts_with("R:") {
        let rest = desc.slice(2, desc.len())
        let bar = rest.index_of("|")
        if bar >= 0 {
            let ok = rest.slice(0, bar)
            let err = rest.slice(bar + 1, rest.len())
            queue_promote_type(ok)
            queue_promote_type(err)
        }
        return
    }
    // C:<sig_hash> — dispatched at runtime via src->promoter; no per-type walker.
}

fn queue_field_type(field_ct: Int, stype: Str, tp_id: Int) {
    if field_ct == CT_STRUCT || (field_ct == CT_VOID && stype != "") {
        if stype != "" { queue_promote_type("S:{stype}") }
        return
    }
    if field_ct == CT_LIST {
        let ek = if tp_id >= 0 { tp_child1_kind(tp_id) } else { -1 }
        let es = if tp_id >= 0 { tp_child1_sname(tp_id) } else { "" }
        let inner = ct_to_descriptor(ek, es)
        queue_promote_type("L:{inner}")
        return
    }
    if field_ct == CT_MAP {
        let kk = if tp_id >= 0 { tp_child1_kind(tp_id) } else { -1 }
        let ks = if tp_id >= 0 { tp_child1_sname(tp_id) } else { "" }
        let vk = if tp_id >= 0 { tp_child2_kind(tp_id) } else { -1 }
        let vs = if tp_id >= 0 { tp_child2_sname(tp_id) } else { "" }
        let kd = ct_to_descriptor(kk, ks)
        let vd = ct_to_descriptor(vk, vs)
        queue_promote_type("M:{kd}|{vd}")
    }
}

pub let mut promote_fwd_emitted: Int = 0

@allow(UnrestoredMutation)
pub fn emit_promote_forward_decls() ! Codegen.Emit {
    let mut i = promote_fwd_emitted
    while i < promote_types.len() {
        let desc = promote_types.get(i).unwrap()
        let mangle = descriptor_mangle(desc)
        let cty = descriptor_c_type(desc)
        emit_line("static {cty} blink_promote_{mangle}(blink_arena_t* target, {cty} src);")
        i = i + 1
    }
    promote_fwd_emitted = promote_types.len()
}


pub fn emit_promote_fn_defs() ! Codegen.Emit {
    let mut i = 0
    while i < promote_types.len() {
        let desc = promote_types.get(i).unwrap()
        if desc.starts_with("S:") {
            emit_promote_struct(desc)
        } else if desc.starts_with("L:") {
            emit_promote_list(desc)
        } else if desc.starts_with("M:") {
            emit_promote_map(desc)
        } else if desc.starts_with("O:") {
            emit_promote_option(desc)
        } else if desc.starts_with("R:") {
            emit_promote_result(desc)
        }
        i = i + 1
    }
}

fn emit_promote_desc_copy(access: Str, desc: Str, dst: Str) ! Codegen.Emit {
    if desc == "P:Str" {
        emit_line("{dst} = blink_promote_str(target, {access});")
        return
    }
    if desc.starts_with("P:") {
        emit_line("{dst} = {access};")
        return
    }
    let mangle = descriptor_mangle(desc)
    emit_line("{dst} = blink_promote_{mangle}(target, {access});")
}

fn emit_promote_option(desc: Str) ! Codegen.Emit {
    let inner = inner_desc_of(desc)
    let mangle = descriptor_mangle(desc)
    let cty = descriptor_c_type(desc)
    emit_line("static {cty} blink_promote_{mangle}(blink_arena_t* target, {cty} src) \{")
    cg_indent = cg_indent + 1
    emit_line("{cty} dst = src;")
    emit_line("if (src.tag == 1) \{")
    cg_indent = cg_indent + 1
    emit_promote_desc_copy("src.value", inner, "dst.value")
    cg_indent = cg_indent - 1
    emit_line("}")
    emit_line("return dst;")
    cg_indent = cg_indent - 1
    emit_line("}")
    emit_line("")
}

fn emit_promote_result(desc: Str) ! Codegen.Emit {
    let rest = desc.slice(2, desc.len())
    let bar = rest.index_of("|")
    let ok_d = rest.slice(0, bar)
    let err_d = rest.slice(bar + 1, rest.len())
    let mangle = descriptor_mangle(desc)
    let cty = descriptor_c_type(desc)
    emit_line("static {cty} blink_promote_{mangle}(blink_arena_t* target, {cty} src) \{")
    cg_indent = cg_indent + 1
    emit_line("{cty} dst = src;")
    emit_line("if (src.tag == 0) \{")
    cg_indent = cg_indent + 1
    emit_promote_desc_copy("src.ok", ok_d, "dst.ok")
    cg_indent = cg_indent - 1
    emit_line("} else \{")
    cg_indent = cg_indent + 1
    emit_promote_desc_copy("src.err", err_d, "dst.err")
    cg_indent = cg_indent - 1
    emit_line("}")
    emit_line("return dst;")
    cg_indent = cg_indent - 1
    emit_line("}")
    emit_line("")
}

fn emit_promote_field_copy(access: Str, field_ct: Int, stype: Str, tp_id: Int, dst: Str) ! Codegen.Emit {
    if field_ct == CT_STRING {
        emit_line("{dst} = blink_promote_str(target, {access});")
        return
    }
    if field_ct == CT_STRUCT || (field_ct == CT_VOID && stype != "") {
        if stype != "" {
            emit_line("{dst} = blink_promote_{stype}(target, {access});")
            return
        }
        emit_line("{dst} = {access};")
        return
    }
    if field_ct == CT_LIST {
        let ek = if tp_id >= 0 { tp_child1_kind(tp_id) } else { -1 }
        let es = if tp_id >= 0 { tp_child1_sname(tp_id) } else { "" }
        let inner = ct_to_descriptor(ek, es)
        let mangle = "List_{descriptor_mangle(inner)}"
        emit_line("{dst} = blink_promote_{mangle}(target, {access});")
        return
    }
    if field_ct == CT_MAP {
        let kk = if tp_id >= 0 { tp_child1_kind(tp_id) } else { -1 }
        let ks = if tp_id >= 0 { tp_child1_sname(tp_id) } else { "" }
        let vk = if tp_id >= 0 { tp_child2_kind(tp_id) } else { -1 }
        let vs = if tp_id >= 0 { tp_child2_sname(tp_id) } else { "" }
        let kd = ct_to_descriptor(kk, ks)
        let vd = ct_to_descriptor(vk, vs)
        let mangle = "Map_{descriptor_mangle(kd)}_{descriptor_mangle(vd)}"
        emit_line("{dst} = blink_promote_{mangle}(target, {access});")
        return
    }
    emit_line("{dst} = {access};")
}

fn emit_promote_struct(desc: Str) ! Codegen.Emit {
    let sname = desc.slice(2, desc.len())
    let cty = c_type_c_name(sname)
    emit_line("static {cty} blink_promote_{sname}(blink_arena_t* target, {cty} src) \{")
    cg_indent = cg_indent + 1
    emit_line("{cty} dst = src;")
    let mut i = 0
    while i < sf_entries.len() {
        let sf = sf_entries.get(i).unwrap()
        if sf.struct_name == sname {
            emit_promote_field_copy("src.{sf.field_name}", sf.field_type, sf.stype, sf.tp_id, "dst.{sf.field_name}")
        }
        i = i + 1
    }
    emit_line("return dst;")
    cg_indent = cg_indent - 1
    emit_line("}")
    emit_line("")
}

// Element-copy emission: source expression is read from blink_list_get / blink_map_get,
// destination is pushed back into the new container. Returns the emitted C expression
// that evaluates to the stored void* pointer for the promoted element.
pub fn emit_promote_elem_into(src_expr: Str, ct: Int, desc: Str) -> Str ! Codegen.Emit {
    // Int, Bool, and every narrow int / Char store their value inline in the
    // list's void* element slot; none has a blink_promote_<tag> walker. Since
    // ct_to_descriptor now carries narrow widths (bug 2aw8mt), guard them here
    // too or the compound catch-all below emits a nonexistent blink_promote_i32.
    if ct == CT_INT || ct == CT_BOOL {
        return "(void*)(intptr_t){src_expr}"
    }
    if ct == CT_I8 || ct == CT_I16 || ct == CT_I32 { return "(void*)(intptr_t){src_expr}" }
    if ct == CT_U8 || ct == CT_U16 || ct == CT_U32 || ct == CT_U64 { return "(void*)(intptr_t){src_expr}" }
    if ct == CT_CHAR { return "(void*)(intptr_t){src_expr}" }
    if ct == CT_STRING {
        return "(void*)blink_promote_str(target, (const char*){src_expr})"
    }
    if ct == CT_FLOAT {
        let box = fresh_temp("_fbox_")
        emit_line("double* {box} = (double*)blink_promote_alloc_atomic(target, sizeof(double));")
        emit_line("*{box} = *(double*){src_expr};")
        return "(void*){box}"
    }
    // Struct / nested list / nested map / closure — descriptor chose the walker
    let mangle = descriptor_mangle(desc)
    if desc.starts_with("S:") {
        let sname = desc.slice(2, desc.len())
        let cty = c_type_c_name(sname)
        let tmp = fresh_temp("_ps_")
        emit_line("{cty}* {tmp} = ({cty}*)blink_promote_alloc(target, sizeof({cty}));")
        emit_line("*{tmp} = blink_promote_{mangle}(target, *({cty}*){src_expr});")
        return "(void*){tmp}"
    }
    if desc.starts_with("C:") {
        // NULL promoter → FFI-constructed closure without typed ABI; alias unchanged.
        let cl_tmp = fresh_temp("_pcls_")
        emit_line("blink_closure* {cl_tmp} = (blink_closure*){src_expr};")
        emit_line("if ({cl_tmp} && {cl_tmp}->promoter) {cl_tmp} = {cl_tmp}->promoter(target, {cl_tmp});")
        return "(void*){cl_tmp}"
    }
    // Nested collection: pointer stored directly
    return "(void*)blink_promote_{mangle}(target, (void*){src_expr})"
}

pub fn inner_desc_of(desc: Str) -> Str {
    if desc.starts_with("L:") { return desc.slice(2, desc.len()) }
    if desc.starts_with("O:") { return desc.slice(2, desc.len()) }
    ""
}

pub fn desc_primary_ct(desc: Str) -> Int {
    if desc == "P:Int" { return CT_INT }
    if desc == "P:Float" { return CT_FLOAT }
    if desc == "P:Bool" { return CT_BOOL }
    if desc == "P:Str" { return CT_STRING }
    // Narrow int / Char tags carried by ct_to_descriptor (bug 2aw8mt); decode
    // to the exact CT so kops_table_name / map_key_read_expr pick the right
    // stride and width.
    if desc == "P:i8" { return CT_I8 }
    if desc == "P:i16" { return CT_I16 }
    if desc == "P:i32" { return CT_I32 }
    if desc == "P:u8" { return CT_U8 }
    if desc == "P:u16" { return CT_U16 }
    if desc == "P:u32" { return CT_U32 }
    if desc == "P:u64" { return CT_U64 }
    if desc == "P:char" { return CT_CHAR }
    if desc == "C:Closure" { return CT_CLOSURE }
    if desc.starts_with("S:") { return CT_STRUCT }
    if desc.starts_with("L:") { return CT_LIST }
    if desc.starts_with("M:") { return CT_MAP }
    if desc.starts_with("O:") { return CT_OPTION }
    if desc.starts_with("R:") { return CT_RESULT }
    CT_VOID
}

fn emit_promote_list(desc: Str) ! Codegen.Emit {
    let inner = inner_desc_of(desc)
    let mangle = descriptor_mangle(desc)
    emit_line("static blink_list* blink_promote_{mangle}(blink_arena_t* target, blink_list* src) \{")
    cg_indent = cg_indent + 1
    emit_line("if (src == NULL) return NULL;")
    emit_line("blink_arena_t* __save = __blink_current_arena;")
    emit_line("__blink_current_arena = target;")
    emit_line("blink_list* dst = blink_list_new();")
    emit_line("__blink_current_arena = __save;")
    emit_line("int64_t _n = blink_list_len(src);")
    emit_line("for (int64_t _i = 0; _i < _n; _i++) \{")
    cg_indent = cg_indent + 1
    let ct = desc_primary_ct(inner)
    let stored = emit_promote_elem_into("blink_list_get(src, _i)", ct, inner)
    emit_line("__blink_current_arena = target;")
    emit_line("blink_list_push(dst, {stored});")
    emit_line("__blink_current_arena = __save;")
    cg_indent = cg_indent - 1
    emit_line("}")
    emit_line("return dst;")
    cg_indent = cg_indent - 1
    emit_line("}")
    emit_line("")
}

// Emit the key argument for blink_map_set inside a map-promote loop and return
// the C expression to pass as the `const void* key`.
//   Str  → promote the pointer into `target` (kops stores the pointer).
//   Bool → exact 1-byte temp (key_size==1); blink_map_set memcpy's key_size bytes.
//   Int / sized-int / Char → width-exact temp read via map_key_read_expr.
// Struct/tuple keys aren't reachable here yet (descriptor can't encode them);
// the kops_table_name sentinel would surface the disagreement at C-compile time.
fn emit_promote_map_key(kct: Int, slot: Str) -> Str ! Codegen.Emit {
    if kct == CT_STRING {
        // blink_map_key_slot already dereferences the pointer slot for non-inline
        // keys, so it yields the stored `const char*` directly.
        emit_line("const char* _k = blink_promote_str(target, (const char*)({slot}));")
        return "_k"
    }
    if kct == CT_BOOL {
        emit_line("uint8_t _k = *(const uint8_t*)({slot});")
        return "&_k"
    }
    // Int / sized-int / Char: read the inline key at its exact width.
    emit_line("{c_type_str(kct)} _k = {map_key_read_expr(kct, slot)};")
    "&_k"
}

fn emit_promote_map(desc: Str) ! Codegen.Emit {
    let rest = desc.slice(2, desc.len())
    let bar = rest.index_of("|")
    let kd = rest.slice(0, bar)
    let vd = rest.slice(bar + 1, rest.len())
    let kct = desc_primary_ct(kd)
    let kops = kops_table_name(kct, "")
    let mangle = descriptor_mangle(desc)
    emit_line("static blink_map* blink_promote_{mangle}(blink_arena_t* target, blink_map* src) \{")
    cg_indent = cg_indent + 1
    emit_line("if (src == NULL) return NULL;")
    emit_line("blink_arena_t* __save = __blink_current_arena;")
    emit_line("__blink_current_arena = target;")
    emit_line("blink_map* dst = blink_map_new(&{kops});")
    emit_line("__blink_current_arena = __save;")
    emit_line("size_t _stride = blink_kops_stride(src->kops);")
    emit_line("for (int64_t _i = 0; _i < src->cap; _i++) \{")
    cg_indent = cg_indent + 1
    emit_line("if (src->states[_i] != 1) continue;")
    emit_line("\{")
    cg_indent = cg_indent + 1
    let key_arg = emit_promote_map_key(kct, "blink_map_key_slot(src, _i, _stride)")
    let vct = desc_primary_ct(vd)
    let stored = emit_promote_elem_into("src->values[_i]", vct, vd)
    emit_line("__blink_current_arena = target;")
    emit_line("blink_map_set(dst, {key_arg}, {stored});")
    emit_line("__blink_current_arena = __save;")
    cg_indent = cg_indent - 1
    emit_line("}")
    cg_indent = cg_indent - 1
    emit_line("}")
    emit_line("return dst;")
    cg_indent = cg_indent - 1
    emit_line("}")
    emit_line("")
}
