// codegen_expr.bl — Expression codegen, closures, capture analysis

// ── Expression codegen ──────────────────────────────────────────────
// Returns (expr_str, type) packed into parallel result slots.
// Since we can't return tuples in the C backend, we use mutable globals.

pub let mut expr_result_str: Str = ""
pub let mut expr_result_type: Int = 0
pub let mut expr_closure_sig: Str = ""
pub let mut expr_option_inner: Int = -1
pub let mut expr_result_ok_type: Int = -1
pub let mut expr_result_err_type: Int = -1
pub let mut expr_result_ok_struct: Str = ""
pub let mut expr_result_err_struct: Str = ""
pub let mut expr_option_inner_struct: Str = ""
pub let mut expr_list_elem_type: Int = -1
pub let mut expr_list_elem_struct: Str = ""
pub let mut expr_map_key_type: Int = -1
pub let mut expr_map_val_type: Int = -1
pub let mut expr_map_val_struct: Str = ""
pub let mut expr_map_key_struct: Str = ""
pub let mut expr_option_is_none: Int = 0
pub let mut expr_option_inner_list_elem: Int = -1
pub let mut expr_option_inner_list_struct: Str = ""
pub let mut expr_option_inner_map_val_struct: Str = ""
pub let mut expr_option_inner_map_val_list_elem: Int = -1
pub let mut expr_iter_next_fn: Str = ""

let mut embed_byte_lut: List[Str] = []

fn ensure_embed_lut() {
    if embed_byte_lut.len() > 0 { return }
    let mut i = 0
    while i < 256 {
        embed_byte_lut.push(",{i}")
        i = i + 1
    }
}

// Helper output for iter_from_source
pub let mut ifs_iter_var: Str = ""
pub let mut ifs_next_fn: Str = ""
pub let mut ifs_elem_type: Int = 0
pub let mut ifs_opt_type: Str = ""

// Convert a CT_LIST or CT_ITERATOR source into a uniform iterator representation.
// Sets ifs_iter_var (C var name of the iterator struct on the stack),
// ifs_next_fn (C function name to call next), ifs_elem_type, ifs_opt_type.
pub fn iter_from_source(obj_str: Str, obj_type: Int) ! Codegen.Emit {
    if obj_type == CT_LIST {
        let mut elem_type = get_list_elem_type(obj_str)
        if elem_type == -1 { elem_type = CT_INT }
        ensure_iter_type(elem_type)
        let tag = c_type_tag(elem_type)
        let li_type = list_iter_c_type(elem_type)
        let iter_var = fresh_temp("__src_iter_")
        emit_line("{li_type} {iter_var} = blink_list_into_iter_{tag}({obj_str});")
        ifs_iter_var = iter_var
        ifs_next_fn = "{li_type}_next"
        ifs_elem_type = elem_type
        ifs_opt_type = option_c_type(elem_type)
    } else {
        ifs_iter_var = obj_str
        ifs_next_fn = get_var_iter_next_fn(obj_str)
        ifs_elem_type = get_var_iterator_inner(obj_str)
        ifs_opt_type = option_c_type(ifs_elem_type)
    }
}

fn propagate_enum_struct(name: Str, result_str: Str) {
    if get_var_struct(name) == "" {
        let ve = get_var_enum(name)
        if ve != "" && is_data_enum(ve) != 0 {
            set_var_struct(result_str, ve)
        }
    }
}

fn emit_ok_result(ok_str: Str, ok_type: Int, err_type: Int, ok_s: Str, err_s: Str) {
    if ok_s != "" || err_s != "" {
        ensure_mixed_result_type(ok_type, err_type, ok_s, err_s)
        let res_type = result_c_type_mixed(ok_type, err_type, ok_s, err_s)
        expr_result_str = "({res_type})\{.tag = 0, .ok = {ok_str}}"
        expr_result_type = CT_RESULT
        expr_result_ok_type = ok_type
        expr_result_err_type = err_type
        expr_result_ok_struct = ok_s
        expr_result_err_struct = err_s
    } else {
        ensure_result_type(ok_type, err_type)
        let res_type = result_c_type(ok_type, err_type)
        expr_result_str = "({res_type})\{.tag = 0, .ok = {ok_str}}"
        expr_result_type = CT_RESULT
        expr_result_ok_type = ok_type
        expr_result_err_type = err_type
        expr_result_ok_struct = ""
        expr_result_err_struct = ""
    }
}

fn emit_err_result(err_str: Str, ok_type: Int, err_type: Int, ok_s: Str, err_s: Str) {
    if ok_s != "" || err_s != "" {
        ensure_mixed_result_type(ok_type, err_type, ok_s, err_s)
        let res_type = result_c_type_mixed(ok_type, err_type, ok_s, err_s)
        expr_result_str = "({res_type})\{.tag = 1, .err = {err_str}}"
    } else {
        ensure_result_type(ok_type, err_type)
        let res_type = result_c_type(ok_type, err_type)
        expr_result_str = "({res_type})\{.tag = 1, .err = {err_str}}"
    }
    expr_result_type = CT_RESULT
    expr_result_ok_type = ok_type
    expr_result_err_type = err_type
    expr_result_ok_struct = ok_s
    expr_result_err_struct = err_s
}

// Render the propagated error `E` for a test-body `?` (spec §2.20 / §3c.2).
// Delegates to the shared `render_result_arm_value` (codegen_types.bl), which
// also backs the unwrap/unwrap_err panic-message rendering: builtin scalars
// coerce directly; struct/enum err types with `impl Display` render through the
// synthesized sealed `{T}_display`. Typecheck's E0514 gate guarantees a Display
// impl exists at this point; the placeholder remains only as a defensive
// fallback for any err type that reaches here without one.
fn test_render_err_message(err_ct: Int, err_struct: Str, err_expr: Str) -> Str ! Codegen.Emit {
    render_result_arm_value(err_ct, err_struct, err_expr)
}

fn test_err_type_display_name(err_ct: Int, err_struct: Str) -> Str {
    if err_ct == CT_STRING { return "Str" }
    if err_ct == CT_INT { return "Int" }
    if err_ct == CT_BOOL { return "Bool" }
    if err_ct == CT_FLOAT { return "Float" }
    if err_ct == CT_CHAR { return "Char" }
    if err_struct != "" { return err_struct }
    "<error>"
}

fn set_bare_none_struct_result(inner_tag: Str) {
    ensure_struct_option_type(inner_tag)
    let opt_type = struct_option_c_type(inner_tag)
    expr_result_str = "({opt_type})\{.tag = 0}"
    expr_result_type = CT_OPTION
    expr_option_inner = CT_INT
    expr_option_inner_struct = inner_tag
}

fn closure_ret_tag_is_recognized(sname: Str) -> Int {
    if sname.starts_with("Option_") { return 1 }
    if sname.starts_with("Result_") { return 1 }
    if resolve_struct_from_c_name(sname) != "" { return 1 }
    0
}

// Reseat expr globals from a closure return type tag (`Option_X`, `Result_X_Y`,
// or a struct name). Returns 1 if `sname` was recognized as a compound/struct,
// 0 otherwise (caller falls back to closure_ret_ct).
fn reseat_from_closure_ret_tag(sname: Str, tmp: Str) -> Int ! Codegen.Scope {
    if sname.starts_with("Option_") {
        let inner_ct = option_inner_ct_from_tag(sname)
        let inner_s = option_inner_struct_from_tag(sname)
        expr_result_str = tmp
        expr_result_type = CT_OPTION
        expr_option_inner = inner_ct
        expr_option_inner_struct = inner_s
        if inner_s != "" {
            ensure_struct_option_type(inner_s)
        } else {
            ensure_option_type(inner_ct)
        }
        return 1
    }
    if sname.starts_with("Result_") {
        let split = split_result_compound(sname)
        expr_result_str = tmp
        expr_result_type = CT_RESULT
        expr_result_ok_type = type_from_name_tag(split.first)
        expr_result_err_type = type_from_name_tag(split.second)
        expr_result_ok_struct = typedef_tag_or_empty(split.first)
        expr_result_err_struct = typedef_tag_or_empty(split.second)
        return 1
    }
    let resolved = resolve_struct_from_c_name(sname)
    if resolved != "" {
        set_var(tmp, CT_STRUCT, 0)
        set_var_struct(tmp, resolved)
        expr_result_str = tmp
        expr_result_type = CT_STRUCT
        return 1
    }
    0
}

// Reseat compound-inner expr globals after `?` on `Result[T, E]`.
// `tmp` is the C tmp holding the result; `rok`/`rok_s` describe the Ok payload.
// Downstream let/match needs to know T when it's Option/Result/struct.
fn reseat_after_q_on_result(tmp: Str, rok: Int, rok_s: Str) {
    expr_result_str = "{tmp}.ok"
    if rok == CT_OPTION {
        expr_result_type = CT_OPTION
        expr_option_inner = option_inner_ct_from_tag(rok_s)
        expr_option_inner_struct = option_inner_struct_from_tag(rok_s)
    } else if rok == CT_RESULT {
        expr_result_type = CT_RESULT
        let split = split_result_compound(rok_s)
        expr_result_ok_type = type_from_name_tag(split.first)
        expr_result_err_type = type_from_name_tag(split.second)
        expr_result_ok_struct = typedef_tag_or_empty(split.first)
        expr_result_err_struct = typedef_tag_or_empty(split.second)
        return
    } else if rok_s != "" {
        expr_result_type = CT_INT
        set_var_struct(expr_result_str, rok_s)
    } else {
        expr_result_type = rok
    }
    expr_result_ok_struct = ""
    expr_result_err_struct = ""
}

// A Set[T] element reached through a type-erased boundary (tuple element or
// struct field) loses its inner type: the carrier is shared across
// monomorphizations, and the struct-field tp_id is reg-side-erased to -1. Both
// the tuple-access and struct-field paths recover it identically from
// typecheck's per-node tid memo, so they share this helper. A -1 elem CT
// (unresolvable inner: typevar/tuple/fn) is a no-op — the caller's default
// element type stands. jkdywb.
fn recover_set_elem_from_tid(node: Int, var_name: Str) ! Codegen.Register, Codegen.Scope {
    let etid = tc_lookup_node_tid(node)
    let ect = tc_tid_set_elem_ct(etid)
    if ect >= 0 {
        set_set_elem_type(var_name, ect)
        let es = tc_tid_set_elem_struct(etid)
        if es != "" { set_set_elem_struct(var_name, es) }
    }
}

@allow(UnrestoredMutation, IncompleteStateRestore)
pub fn emit_expr(node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let kind = node_kind(node)
    expr_closure_sig = ""
    expr_option_is_none = 0

    if kind == NodeKind.IntLit {
        let s = node_str_val(node)
        if s == "" {
            expr_result_str = "{node_int_val(node)}"
        } else {
            expr_result_str = s
        }
        expr_result_type = CT_INT
        return
    }

    if kind == NodeKind.FloatLit {
        expr_result_str = node_str_val(node)
        expr_result_type = CT_FLOAT
        return
    }

    if kind == NodeKind.BoolLit {
        if node_int_val(node) != 0 {
            expr_result_str = "1"
        } else {
            expr_result_str = "0"
        }
        expr_result_type = CT_BOOL
        return
    }

    if kind == NodeKind.CharLit {
        expr_result_str = "(int32_t){node_str_val(node)}"
        expr_result_type = CT_CHAR
        return
    }

    if kind == NodeKind.Ident {
        let name = node_name(node)
        if (name == "self" || name == "_self") && cg_where_self_var != "" {
            expr_result_str = cg_where_self_var
            expr_result_type = CT_INT
            return
        }
        if name == "result" && cg_ensures_result_var != "" {
            expr_result_str = cg_ensures_result_var
            expr_result_type = CT_INT
            return
        }
        if name == "None" {
            let expect_struct = expect_arg_option_inner_struct()
            if expect_struct != "" {
                set_bare_none_struct_result(expect_struct)
                expr_option_is_none = 1
                return
            }
            let expect_inner_ct = expect_arg_option_inner_ct()
            if expect_inner_ct != CT_VOID {
                ensure_option_type(expect_inner_ct)
                let opt_type = option_c_type(expect_inner_ct)
                expr_result_str = "({opt_type})\{.tag = 0}"
                expr_result_type = CT_OPTION
                expr_option_inner = expect_inner_ct
                expr_option_inner_struct = ""
                expr_option_is_none = 1
                return
            }
            let fsi = get_fn_ret_struct_inner(cg_current_fn_name)
            let fn_rt = get_fn_ret_type(cg_current_fn_name)
            if fsi.ok_struct != "" && cg_current_fn_ret == CT_OPTION {
                ensure_struct_option_type(fsi.ok_struct)
                let opt_type = struct_option_c_type(fsi.ok_struct)
                expr_result_str = "({opt_type})\{.tag = 0}"
                expr_result_type = CT_OPTION
                if is_compound_tag(fsi.ok_struct) != 0 {
                    expr_option_inner = type_from_name(fsi.ok_struct.slice(0, fsi.ok_struct.index_of("_")))
                    expr_option_inner_struct = fsi.ok_struct
                } else {
                    expr_option_inner = CT_INT
                    expr_option_inner_struct = fsi.ok_struct
                }
            } else if cg_current_fn_ret == CT_RESULT && fn_rt.inner1 == CT_OPTION && fsi.ok_struct != "" {
                let mut inner_tag = fsi.ok_struct
                if fsi.ok_struct.starts_with("Option_") {
                    inner_tag = fsi.ok_struct.slice(7, fsi.ok_struct.len())
                }
                let inner_ct = type_from_name_tag(inner_tag)
                if is_compound_tag(inner_tag) != 0 || is_struct_type(inner_tag) != 0 || is_enum_type(inner_tag) != 0 {
                    ensure_struct_option_type(inner_tag)
                    let opt_type = struct_option_c_type(inner_tag)
                    expr_result_str = "({opt_type})\{.tag = 0}"
                    expr_result_type = CT_OPTION
                    expr_option_inner = CT_INT
                    expr_option_inner_struct = inner_tag
                } else {
                    ensure_option_type(inner_ct)
                    let opt_type = option_c_type(inner_ct)
                    expr_result_str = "({opt_type})\{.tag = 0}"
                    expr_result_type = CT_OPTION
                    expr_option_inner = inner_ct
                    expr_option_inner_struct = ""
                }
            } else if cg_current_fn_option_inner_struct != "" {
                set_bare_none_struct_result(cg_current_fn_option_inner_struct)
            } else {
                let none_inner = if cg_current_fn_option_inner != 0 { cg_current_fn_option_inner } else { CT_INT }
                ensure_option_type(none_inner)
                let opt_type = option_c_type(none_inner)
                expr_result_str = "({opt_type})\{.tag = 0}"
                expr_result_type = CT_OPTION
                expr_option_inner = none_inner
                expr_option_inner_struct = ""
            }
            expr_option_is_none = 1
            return
        }
        let variant_enum2 = resolve_variant(name)
        if variant_enum2 != "" {
            if is_data_enum(variant_enum2) != 0 {
                let tag = get_variant_tag(variant_enum2, name)
                expr_result_str = "({c_type_c_name(variant_enum2)})\{.tag = {tag}}"
                expr_result_type = CT_STRUCT
                set_var_struct(expr_result_str, variant_enum2)
                return
            }
            expr_result_str = "{c_type_c_name(variant_enum2)}_{name}"
            expr_result_type = CT_INT
            var_enums.push(VarEnumEntry { name: expr_result_str, enum_type: variant_enum2 })
            return
        }
        let safe = c_safe_name(name)
        let cap_idx = get_capture_index(name)
        if cap_idx >= 0 {
            let cap_entry = closure_captures.get(cg_closure_cap_start + cap_idx).unwrap()
            if cap_entry.is_mut != 0 {
                expr_result_str = "(*{safe}_cell)"
                expr_result_type = tp_get_kind(cap_entry.tp_id)
                return
            }
            expr_result_str = capture_cast_expr(cap_idx)
            expr_result_type = tp_get_kind(cap_entry.tp_id)
            return
        }
        if list_contains_str(mut_captured_vars, name) != 0 {
            let mut is_closure_param = 0
            let mut cpi = 0
            while cpi < closure_param_names.len() {
                if closure_param_names.get(cpi).unwrap() == name {
                    is_closure_param = 1
                }
                cpi = cpi + 1
            }
            if is_closure_param == 0 {
                expr_result_str = "(*{safe}_cell)"
                expr_result_type = get_var_type(name)
                return
            }
        }
        // Bare-fn-as-value: callers in Call-arg loops set
        // cg_expect_fn_value_sig before each emit_expr when the formal at
        // that position is `fn(...)`. A local var with the same name wins
        // (is_scope_var guard); FFI bail-out keeps unsafe ABI shimming off
        // the table; generics need an explicit closure literal so type-args
        // can flow from context.
        if cg_expect_fn_value_sig != "" && is_scope_var(name) == 0 && is_fn_registered(name) != 0 && is_fn_ffi(name) == 0 {
            if is_generic_fn(name) != 0 {
                diag_error_at(
                    "BareGenericFnAsValue",
                    BARE_GENERIC_FN_AS_VALUE,
                    "cannot pass generic fn '{name}' as a closure value",
                    node,
                    "wrap it in a closure literal that names the type, e.g. `\{x => {name}(x)\}`"
                )
                expr_result_str = "0"
                expr_result_type = CT_INT
                return
            }
            let target_fn_node = get_fn_node(name)
            if target_fn_node != -1 {
                let shim_name = emit_fn_value_shim_if_needed(target_fn_node, c_fn_name(name))
                expr_result_str = "blink_closure_new_typed((void*){shim_name}, NULL, NULL, 0, NULL)"
                expr_result_type = CT_CLOSURE
                expr_closure_sig = cg_expect_fn_value_sig
                return
            }
        }
        let alias = get_var_alias(name)
        if alias != "" {
            expr_result_str = alias
        } else {
            expr_result_str = safe
        }
        expr_result_type = get_var_type(name)
        if expr_result_type == CT_OPTION {
            expr_option_inner = get_var_option_inner(name)
            expr_option_inner_struct = get_var_option_inner_struct(name)
            if expr_option_inner == CT_LIST {
                expr_option_inner_list_elem = get_var_option_inner2(name)
                expr_option_inner_list_struct = get_var_option_inner2_struct(name)
            }
            if expr_option_inner == CT_MAP {
                expr_option_inner_map_val_list_elem = get_var_option_inner2(name)
                expr_option_inner_map_val_struct = get_var_option_inner2_struct(name)
            }
        }
        if expr_result_type == CT_RESULT {
            expr_result_ok_type = get_var_result_ok(name)
            expr_result_err_type = get_var_result_err(name)
            expr_result_ok_struct = get_var_result_ok_struct(name)
            expr_result_err_struct = get_var_result_err_struct(name)
        }
        if expr_result_type == CT_ITERATOR {
            expr_iter_next_fn = get_var_iter_next_fn(name)
        }
        if expr_result_type == CT_LIST {
            expr_list_elem_type = get_list_elem_type(name)
            expr_list_elem_struct = get_list_elem_struct(name)
        }
        if expr_result_type == CT_STRUCT {
            propagate_enum_struct(name, expr_result_str)
        }
        return
    }

    if kind == NodeKind.BinOp {
        emit_binop(node)
        return
    }

    if kind == NodeKind.UnaryOp {
        emit_unaryop(node)
        return
    }

    if kind == NodeKind.Call {
        // A Call to `old(...)` inside an @ensures predicate has been
        // pre-snapshotted at fn entry. Emit the snapshot var instead of
        // evaluating the inner expression a second time.
        let _callee = node_left(node)
        if _callee != -1 && node_name(_callee) == "old" && cg_old_snapshot_vars.contains_key("{node}") {
            expr_result_str = cg_old_snapshot_vars.get("{node}").unwrap()
            expr_result_type = CT_INT
            return
        }
        emit_call(node)
        return
    }

    if kind == NodeKind.MethodCall {
        emit_method_call(node)
        return
    }

    if kind == NodeKind.InterpString {
        emit_interp_string(node)
        return
    }

    if kind == NodeKind.IfExpr {
        emit_if_expr(node)
        return
    }

    if kind == NodeKind.FieldAccess {
        let fa_obj = node_obj(node)
        let fa_field = node_name(node)
        if node_kind(fa_obj) == NodeKind.Ident {
            let obj_name = node_name(fa_obj)
            if is_import_module_name(obj_name) != 0 && is_enum_type(obj_name) == 0 && is_struct_type(obj_name) == 0 {
                if is_scope_var(obj_name) == 0 {
                    let resolved_field = resolve_import_alias(fa_field)
                    if is_emitted_let(resolved_field) != 0 {
                        let cname = c_safe_name(resolved_field)
                        expr_result_str = cname
                        expr_result_type = get_var_type(resolved_field)
                        if expr_result_type == CT_OPTION {
                            expr_option_inner = get_var_option_inner(resolved_field)
                            expr_option_inner_struct = get_var_option_inner_struct(resolved_field)
                            if expr_option_inner == CT_LIST {
                                expr_option_inner_list_elem = get_var_option_inner2(resolved_field)
                                expr_option_inner_list_struct = get_var_option_inner2_struct(resolved_field)
                            }
                            if expr_option_inner == CT_MAP {
                                expr_option_inner_map_val_list_elem = get_var_option_inner2(resolved_field)
                                expr_option_inner_map_val_struct = get_var_option_inner2_struct(resolved_field)
                            }
                        }
                        if expr_result_type == CT_RESULT {
                            expr_result_ok_type = get_var_result_ok(resolved_field)
                            expr_result_err_type = get_var_result_err(resolved_field)
                            expr_result_ok_struct = get_var_result_ok_struct(resolved_field)
                            expr_result_err_struct = get_var_result_err_struct(resolved_field)
                        }
                        if expr_result_type == CT_ITERATOR {
                            expr_iter_next_fn = get_var_iter_next_fn(resolved_field)
                        }
                        if expr_result_type == CT_LIST {
                            expr_list_elem_type = get_list_elem_type(resolved_field)
                            expr_list_elem_struct = get_list_elem_struct(resolved_field)
                        }
                        if expr_result_type == CT_STRUCT {
                            propagate_enum_struct(resolved_field, expr_result_str)
                        }
                        return
                    }
                }
            }
            if is_enum_type(obj_name) != 0 {
                if is_data_enum(obj_name) != 0 {
                    let tag = get_variant_tag(obj_name, fa_field)
                    expr_result_str = "({c_type_c_name(obj_name)})\{.tag = {tag}}"
                    expr_result_type = CT_STRUCT
                    set_var_struct(expr_result_str, obj_name)
                    return
                }
                expr_result_str = "{c_type_c_name(obj_name)}_{fa_field}"
                expr_result_type = CT_INT
                var_enums.push(VarEnumEntry { name: expr_result_str, enum_type: obj_name })
                return
            }
        }
        emit_expr(fa_obj)
        let obj_str = expr_result_str
        let obj_type_for_fa = expr_result_type
        let mut c_field = fa_field
        if fa_field.len() > 0 {
            let fa_first = fa_field.char_at(0).unwrap()
            if fa_first >= '0' && fa_first <= '9' {
                c_field = "_{fa_field}"
            }
        }
        let fa_accessor = if obj_type_for_fa == CT_PTR { "->" } else { "." }
        expr_result_str = "{obj_str}{fa_accessor}{c_field}"
        let mut fa_type = CT_VOID
        let struct_type = get_var_struct(obj_str)
        // Tuple positional access `t.0`: element types live in the tuple entry
        // (elem_types/elem_structs), not the struct-field registry. Resolve the
        // element CT + compound inner-type globals so a compound element (e.g.
        // Option) can be method-called (`t.0.unwrap()`). qm01e7.
        let fa_first_digit = fa_field.len() > 0 && fa_field.char_at(0).unwrap() >= '0' && fa_field.char_at(0).unwrap() <= '9'
        if struct_type != "" && find_tuple_entry(struct_type) >= 0 && fa_first_digit {
            let tidx = fa_field.to_int()
            let te_struct = tuple_elem_struct(struct_type, tidx)
            let te_ct = tuple_elem_ct(struct_type, tidx)
            if te_struct.starts_with("Option_") {
                fa_type = CT_OPTION
                expr_option_inner = option_inner_ct_from_tag(te_struct)
                expr_option_inner_struct = option_inner_struct_from_tag(te_struct)
            } else if te_struct.starts_with("Result_") {
                fa_type = CT_RESULT
                let rparts = split_result_compound(canonical_struct_tag(te_struct))
                let ok_ct = type_from_name_tag(rparts.first)
                let err_ct = type_from_name_tag(rparts.second)
                expr_result_ok_type = ok_ct
                expr_result_err_type = err_ct
                // A non-scalar (CT_VOID) tag is a struct/enum inner only when
                // it's actually registered as one — mirror the sibling struct
                // branch's positive test rather than treating any unknown tag
                // as a struct name.
                expr_result_ok_struct = if ok_ct == CT_VOID && (is_struct_type(rparts.first) != 0 || is_enum_type(rparts.first) != 0) { rparts.first } else { "" }
                expr_result_err_struct = if err_ct == CT_VOID && (is_struct_type(rparts.second) != 0 || is_enum_type(rparts.second) != 0) { rparts.second } else { "" }
            } else if te_struct != "" && te_struct != "-" {
                fa_type = if is_enum_type(te_struct) != 0 || is_struct_type(te_struct) != 0 { CT_STRUCT } else { te_ct }
                if fa_type == CT_STRUCT { set_var_struct(expr_result_str, te_struct) }
            } else {
                fa_type = te_ct
            }
            // The tuple carrier is type-erased AND shared across
            // monomorphizations ((Set[Int],Int) and (Set[Str],Int) compile to
            // the same carrier), so the element's inner type CANNOT live on
            // te_ct/te_struct. Recover it from typecheck's per-node tid memo,
            // which is keyed by node (this FieldAccess), not by carrier. jkdywb.
            if fa_type == CT_SET {
                recover_set_elem_from_tid(node, expr_result_str)
            } else if fa_type == CT_MAP {
                let mtid = tc_lookup_node_tid(node)
                let kct = tc_tid_map_key_ct(mtid)
                if kct >= 0 {
                    set_map_types(expr_result_str, kct, tc_tid_map_val_ct(mtid), tc_tid_map_val_struct(mtid))
                    let ks = tc_tid_map_key_struct(mtid)
                    if ks != "" { set_map_key_struct(expr_result_str, ks) }
                }
            }
            expr_result_type = fa_type
            return
        }
        if struct_type != "" {
            fa_type = get_struct_field_type(struct_type, c_field)
            if fa_type == CT_STRUCT || fa_type == CT_VOID {
                let mi = lookup_mono_base(struct_type)
                if mi.base != "" {
                    let td = find_type_def_node(mi.base)
                    if td != -1 {
                        let td_tparams = node_type_params(td)
                        let td_flds = node_fields(td)
                        if td_flds != -1 && td_tparams != -1 {
                            let mut fi = 0
                            while fi < sublist_length(td_flds) {
                                let f = sublist_get(td_flds, fi)
                                if node_name(f) == fa_field {
                                    let type_ann_node = node_value(f)
                                    if type_ann_node != -1 {
                                        let type_name = node_name(type_ann_node)
                                        let resolved = resolve_tparam_via_tid(type_name, td_tparams, mi.args, mi.arg_tids)
                                        if resolved == "Option" {
                                            fa_type = CT_OPTION
                                            let inner_elems = node_elements(type_ann_node)
                                            if inner_elems != -1 && sublist_length(inner_elems) >= 1 {
                                                let inner_ann = sublist_get(inner_elems, 0)
                                                let inner_raw = node_name(inner_ann)
                                                let inner_resolved = resolve_tparam_via_tid(inner_raw, td_tparams, mi.args, mi.arg_tids)
                                                let inner_ct = type_from_name(inner_resolved)
                                                expr_option_inner = inner_ct
                                                expr_option_inner_struct = ""
                                                if is_struct_type(inner_resolved) != 0 || is_enum_type(inner_resolved) != 0 {
                                                    expr_option_inner_struct = inner_resolved
                                                } else if is_compound_ct(inner_ct) != 0 {
                                                    expr_option_inner_struct = compound_name_from_ann(inner_ann)
                                                }
                                            }
                                        } else if resolved == "Result" {
                                            fa_type = CT_RESULT
                                        } else {
                                            let resolved_ct = type_from_name(resolved)
                                            if resolved_ct != CT_VOID {
                                                fa_type = resolved_ct
                                            } else if is_struct_type(resolved) != 0 {
                                                fa_type = CT_STRUCT
                                                set_var_struct(expr_result_str, resolved)
                                            }
                                        }
                                    }
                                }
                                fi = fi + 1
                            }
                        }
                    }
                }
            }
            let fa_stype = get_struct_field_stype(struct_type, c_field)
            if fa_stype != "" {
                set_var_struct(expr_result_str, fa_stype)
            }
            if fa_type == CT_CLOSURE {
                let cls_sig = get_struct_field_closure_sig(struct_type, c_field)
                if cls_sig != "" {
                    set_var_closure(expr_result_str, cls_sig)
                    expr_closure_sig = cls_sig
                }
            }
            if fa_type == CT_LIST || fa_type == CT_OPTION || fa_type == CT_RESULT || fa_type == CT_MAP {
                let fa_tp = get_struct_field_tp_id(struct_type, c_field)
                if fa_tp >= 0 {
                    if fa_type == CT_LIST {
                        let le_sname = tp_child1_sname(fa_tp)
                        if le_sname != "" {
                            set_list_elem_struct(expr_result_str, le_sname)
                            set_list_elem_type(expr_result_str, CT_VOID)
                            expr_list_elem_struct = le_sname
                            expr_list_elem_type = CT_VOID
                        } else {
                            let le_kind = tp_child1_kind(fa_tp)
                            if le_kind != CT_INT {
                                set_list_elem_type(expr_result_str, le_kind)
                            }
                            expr_list_elem_type = le_kind
                            expr_list_elem_struct = ""
                        }
                    } else if fa_type == CT_OPTION {
                        expr_option_inner = tp_child1_kind(fa_tp)
                        let fa_opt_sname = tp_child1_sname(fa_tp)
                        expr_option_inner_struct = if fa_opt_sname != "" { fa_opt_sname } else { "" }
                    } else if fa_type == CT_RESULT {
                        expr_result_ok_type = tp_child1_kind(fa_tp)
                        expr_result_err_type = tp_child2_kind(fa_tp)
                    } else if fa_type == CT_MAP {
                        let mk_type = tp_child1_kind(fa_tp)
                        let mv_type = tp_child2_kind(fa_tp)
                        let mv_struct = tp_child2_sname(fa_tp)
                        // 37h7n3: a monomorphized generic-struct field Map[K,V]
                        // reg-erases its typevar value to CT_VOID; set_map_types
                        // keeps any value already resolved by insert rather than
                        // downgrading it on this re-emit.
                        set_map_types(expr_result_str, mk_type, mv_type, mv_struct)
                    }
                }
            }
            // Struct-field Set[T]: the monomorphized-generic struct field tp_id
            // is reg-side-erased to -1 (codegen_stmt reg_sf_entry stores
            // sv_tp(ct, -1, -1, "")), and the container tp-read block above only
            // handles LIST/OPTION/RESULT/MAP — so a Set field never gets its
            // element type set there. Recover it from the per-node tid memo,
            // which covers both the generic and non-generic field cases with one
            // mechanism. jkdywb (sibling of the tuple gap).
            if fa_type == CT_SET {
                recover_set_elem_from_tid(node, expr_result_str)
            }
        }
        expr_result_type = fa_type
        return
    }

    if kind == NodeKind.IndexExpr {
        emit_expr(node_obj(node))
        let obj_str = expr_result_str
        let obj_type = expr_result_type
        emit_expr(node_index(node))
        let idx_str = expr_result_str
        if obj_type == CT_STRING {
            expr_result_str = "blink_str_char_at({obj_str}, {idx_str})"
            expr_result_type = CT_INT
        } else {
            expr_result_str = "{obj_str}[{idx_str}]"
            expr_result_type = CT_INT
        }
        return
    }

    if kind == NodeKind.ListLit {
        emit_list_lit(node)
        return
    }

    if kind == NodeKind.RangeLit {
        expr_result_str = "0"
        expr_result_type = CT_VOID
        return
    }

    if kind == NodeKind.MatchExpr {
        emit_match_expr(node)
        return
    }

    if kind == NodeKind.Block {
        emit_block_expr(node)
        return
    }

    if kind == NodeKind.WithBlock {
        emit_with_block_expr(node)
        return
    }

    if kind == NodeKind.Return {
        if node_value(node) != -1 {
            emit_expr(node_value(node))
            emit_return_with_trace(expr_result_str, cg_current_fn_ret)
        } else {
            emit_trace_exit_void()
            emit_line("return;")
        }
        expr_result_str = "0"
        expr_result_type = CT_VOID
        return
    }

    if kind == NodeKind.TupleLit {
        emit_tuple_lit(node)
        return
    }

    if kind == NodeKind.StructLit {
        emit_struct_lit(node)
        return
    }

    if kind == NodeKind.Closure {
        emit_closure(node)
        return
    }

    if kind == NodeKind.HandlerExpr {
        emit_handler_expr(node)
        return
    }

    if kind == NodeKind.AwaitExpr {
        emit_await_expr(node)
        return
    }

    if kind == NodeKind.AsyncScope {
        emit_async_scope(node)
        return
    }

    if kind == NodeKind.ChannelNew {
        let args_sl = node_args(node)
        if args_sl != -1 && sublist_length(args_sl) > 0 {
            emit_expr(sublist_get(args_sl, 0))
            let cap_str = expr_result_str
            expr_result_str = "blink_channel_new({cap_str})"
        } else {
            expr_result_str = "blink_channel_new(16)"
        }
        expr_result_type = CT_CHANNEL
        return
    }

    if kind == NodeKind.EmbedExpr {
        let embed_path = node_str_val(node)
        let source_dir = path_dirname(diag_source_file)
        let full_path = if source_dir != "" {
            "{source_dir}/{embed_path}"
        } else {
            embed_path
        }
        if file_exists(full_path) != 1 {
            diag_error("FileNotFound", FILE_NOT_FOUND, "#embed file not found: {full_path}", node_line(node), node_col(node), "")
            expr_result_str = "\"\""
            expr_result_type = CT_STRING
            return
        }
        let content = read_file(full_path)
        let var_name = fresh_temp("__embed_")
        ensure_embed_lut()
        let clen = content.len()
        let mut sb = StringBuilder.new()
        sb.write("static const char {var_name}[] = \{")
        if clen > 0 {
            sb.write("{content.byte_at(0)}")
            let mut i = 1
            while i < clen {
                sb.write(embed_byte_lut.get(content.byte_at(i)).unwrap())
                i = i + 1
            }
        }
        sb.write(",0};")
        emit_line(sb.to_str())
        expr_result_str = var_name
        expr_result_type = CT_STRING
        return
    }

    if kind == NodeKind.NamedArg {
        let inner = node_value(node)
        emit_expr(inner)
        return
    }

    expr_result_str = "0"
    expr_result_type = CT_VOID
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_handler_expr(node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let effect_name = node_name(node)
    let methods_sl = node_methods(node)
    let handler_idx = cg_handler_counter
    cg_handler_counter = cg_handler_counter + 1

    let vtable_type = resolve_effect_vtable(effect_name)
    let vtable_field = resolve_effect_field(effect_name)
    let is_user_effect = resolve_effect_is_ue(effect_name)

    if vtable_type == "" {
        emit_line("/* handler for unknown effect: {effect_name} */")
        expr_result_str = "0"
        expr_result_type = CT_VOID
        return
    }

    // Emit a static global for the saved outer vtable (for default delegation)
    let outer_ptr_name = "__handler_{handler_idx}_outer"
    cg_closure_defs.push("static {vtable_type}* {outer_ptr_name} = NULL;")
    cg_closure_defs.push("")

    // Analyze captures across all handler methods
    let mut handler_caps: List[HandlerCapture] = []
    if methods_sl != -1 && sublist_length(methods_sl) > 0 && is_user_effect != 0 {
        let mut mci = 0
        while mci < sublist_length(methods_sl) {
            let mc = sublist_get(methods_sl, mci)
            let mc_body = node_body(mc)
            let mc_params = node_params(mc)
            let mc_caps = analyze_captures(mc_body, mc_params)
            let mut cci = 0
            while cci < mc_caps.len() {
                let cname = mc_caps.get(cci).unwrap()
                let mut already = 0
                let mut aci = 0
                while aci < handler_caps.len() {
                    if handler_caps.get(aci).unwrap().name == cname {
                        already = 1
                        break
                    }
                    aci = aci + 1
                }
                if already == 0 {
                    handler_caps.push(HandlerCapture { name: cname, tp_id: get_var_type(cname) })
                }
                cci = cci + 1
            }
            mci = mci + 1
        }
    }
    let has_handler_caps = handler_caps.len() > 0

    // Emit capture struct if multiple captures needed
    let cap_struct_name = "__handler_{handler_idx}_caps"
    if handler_caps.len() > 1 {
        cg_closure_defs.push("typedef struct \{")
        let mut csi = 0
        while csi < handler_caps.len() {
            let cap = handler_caps.get(csi).unwrap()
            let cn = cap.name
            let ct = cap.tp_id
            cg_closure_defs.push("    {c_type_str(ct)} {c_safe_name(cn)};")
            csi = csi + 1
        }
        cg_closure_defs.push("} {cap_struct_name};")
        cg_closure_defs.push("")
    }

    if methods_sl != -1 && sublist_length(methods_sl) > 0 {
        let mut mi = 0
        while mi < sublist_length(methods_sl) {
            let m = sublist_get(methods_sl, mi)
            let mname = node_name(m)
            let static_name = "__handler_{handler_idx}_{mname}"
            let mut param_str = ""
            let params_sl = node_params(m)
            if params_sl != -1 {
                let mut pi = 0
                while pi < sublist_length(params_sl) {
                    if pi > 0 {
                        param_str = param_str.concat(", ")
                    }
                    let p = sublist_get(params_sl, pi)
                    let pname = node_name(p)
                    let ptype = node_type_name(p)
                    let ct = type_from_name(ptype)
                    param_str = param_str.concat("{c_type_str(ct)} {pname}")
                    pi = pi + 1
                }
            }
            if param_str == "" {
                param_str = "void"
            }
            let ret_str = node_return_type(m)
            let ret_type = type_from_name(ret_str)
            let ann_ret_c = resolve_ret_type_from_ann(m)
            let mut ret_c = if ann_ret_c != "" { ann_ret_c } else { c_type_str(ret_type) }
            let ue_needs_ptr = is_user_effect != 0 && ret_type == CT_OPTION && resolve_option_inner_from_ann(m) == CT_VOID
            if ue_needs_ptr {
                ret_c = option_c_type(CT_PTR)
            }
            let mut ue_result_opt_ptr = 0
            if is_user_effect != 0 && ret_type == CT_RESULT {
                let _ta = node_type_ann(m)
                if _ta != -1 {
                    let _elems = node_elements(_ta)
                    if _elems != -1 && sublist_length(_elems) >= 2 {
                        let _ok_ann = sublist_get(_elems, 0)
                        let _ok_name = node_name(_ok_ann)
                        let _ok_t = type_from_name(_ok_name)
                        if _ok_t == CT_OPTION {
                            let _ok_elems = node_elements(_ok_ann)
                            if _ok_elems != -1 && sublist_length(_ok_elems) > 0 {
                                let _elem_ann = sublist_get(_ok_elems, 0)
                                let _elem_name = node_name(_elem_ann)
                                let _elem_ct = type_from_name(_elem_name)
                                if _elem_ct == CT_VOID && _elem_name != "" {
                                    let _err_ann = sublist_get(_elems, 1)
                                    let _err_name = node_name(_err_ann)
                                    let _err_t = type_from_name(_err_name)
                                    let _err_tag = resolve_result_inner_tag(_err_ann, _err_name, _err_t)
                                    let _err_t_tag = if _err_tag != "" { canonical_struct_tag(_err_tag) } else { c_type_tag(_err_t) }
                                    ret_c = "blink_Result_Option_ptr_{_err_t_tag}"
                                    ue_result_opt_ptr = 1
                                }
                            }
                        }
                    }
                }
            }
            let fn_line = "static {ret_c} {static_name}({param_str}) \{"
            cg_closure_defs.push(fn_line)
            let saved_lines = cg_lines
            let saved_indent = cg_indent
            let saved_in_handler = cg_in_handler_body
            let saved_handler_vt = cg_handler_body_vtable_type
            let saved_handler_field = cg_handler_body_field
            let saved_handler_ue = cg_handler_body_is_ue
            let saved_handler_hidx = cg_handler_body_idx
            let saved_fn_ret = cg_current_fn_ret
            let saved_fn_option_inner = cg_current_fn_option_inner
            let saved_fn_name = cg_current_fn_name
            let saved_fn_has_ev_h = cg_current_fn_has_ev
            let saved_handler_caps = cg_handler_caps
            let saved_in_traced = cg_in_traced_fn
            // An inline handler body is its own C function; it must not inherit
            // the enclosing test/assert_panics elaboration, or a `?` inside it
            // would emit `__blink_test_set_propagate; return` (wrong frame) or
            // `goto __ap_returned_<n>` into a label that lives in the test
            // function, not this static fn. Mirrors the closure emitter.
            let saved_in_test_h = cg_in_test_body
            let saved_in_ap_h = cg_in_assert_panics
            cg_in_test_body = 0
            cg_in_assert_panics = 0
            cg_in_traced_fn = 0
            cg_lines = []
            cg_indent = 1
            cg_in_handler_body = 1
            cg_handler_body_vtable_type = vtable_type
            cg_handler_body_field = vtable_field
            cg_handler_body_is_ue = is_user_effect
            cg_handler_body_idx = handler_idx
            cg_handler_caps = handler_caps
            cg_current_fn_ret = ret_type
            cg_current_fn_name = static_name
            cg_current_fn_has_ev = 0
            if ret_type == CT_RESULT {
                reg_fn_ret_from_ann(static_name, m)
                if ue_result_opt_ptr != 0 {
                    let _fsi_cur = get_fn_ret_struct_inner(static_name)
                    reg_fn_ret_struct_inner(static_name, "Option_ptr", _fsi_cur.err_struct)
                }
            }
            if ue_needs_ptr {
                cg_current_fn_option_inner = CT_PTR
            } else if ue_result_opt_ptr != 0 {
                cg_current_fn_option_inner = CT_PTR
            } else if ret_type == CT_OPTION {
                cg_current_fn_option_inner = resolve_option_inner_from_ann(m)
            } else {
                cg_current_fn_option_inner = 0
            }
            push_scope()
            if params_sl != -1 {
                let mut pi = 0
                while pi < sublist_length(params_sl) {
                    let p = sublist_get(params_sl, pi)
                    let pname = node_name(p)
                    let ptype = node_type_name(p)
                    set_var(pname, type_from_name(ptype), 0)
                    pi = pi + 1
                }
            }
            if has_handler_caps && is_user_effect != 0 {
                let cap_ev_fld = ev_field("ue_{vtable_field}")
                if handler_caps.len() == 1 {
                    let cap0 = handler_caps.get(0).unwrap()
                    let cn = cap0.name
                    let ct = cap0.tp_id
                    let safe_cn = c_safe_name(cn)
                    if ct == CT_STRING {
                        emit_line("{c_type_str(ct)} {safe_cn} = (const char*){cap_ev_fld}->__userdata;")
                    } else {
                        emit_line("{c_type_str(ct)} {safe_cn} = ({c_type_str(ct)})(uintptr_t){cap_ev_fld}->__userdata;")
                    }
                    set_var(cn, ct, 0)
                } else {
                    emit_line("{cap_struct_name}* __caps = ({cap_struct_name}*){cap_ev_fld}->__userdata;")
                    let mut uci = 0
                    while uci < handler_caps.len() {
                        let cap = handler_caps.get(uci).unwrap()
                        let cn = cap.name
                        let ct = cap.tp_id
                        let safe_cn = c_safe_name(cn)
                        emit_line("{c_type_str(ct)} {safe_cn} = __caps->{safe_cn};")
                        set_var(cn, ct, 0)
                        uci = uci + 1
                    }
                }
            }
            emit_fn_body(node_body(m), ret_type)
            pop_scope()
            let mut li = 0
            while li < cg_lines.len() {
                cg_closure_defs.push(cg_lines.get(li).unwrap())
                li = li + 1
            }
            cg_closure_defs.push("}")
            cg_closure_defs.push("")
            cg_lines = saved_lines
            cg_indent = saved_indent
            cg_in_handler_body = saved_in_handler
            cg_handler_body_vtable_type = saved_handler_vt
            cg_handler_body_field = saved_handler_field
            cg_handler_body_is_ue = saved_handler_ue
            cg_handler_body_idx = saved_handler_hidx
            cg_handler_caps = saved_handler_caps
            cg_current_fn_ret = saved_fn_ret
            cg_current_fn_option_inner = saved_fn_option_inner
            cg_current_fn_name = saved_fn_name
            cg_current_fn_has_ev = saved_fn_has_ev_h
            cg_in_traced_fn = saved_in_traced
            cg_in_test_body = saved_in_test_h
            cg_in_assert_panics = saved_in_ap_h
            mi = mi + 1
        }
    }

    // Save current vtable as outer before installing new handler
    let vt_name = "__handler_vt_{handler_idx}"
    if is_user_effect != 0 {
        let ue_ev_fld = ev_field("ue_{vtable_field}")
        emit_line("{outer_ptr_name} = {ue_ev_fld};")
    } else {
        let bi_ev_fld = ev_field(vtable_field)
        emit_line("{outer_ptr_name} = {bi_ev_fld};")
    }
    emit_line("{vtable_type} {vt_name} = *{outer_ptr_name};")
    if methods_sl != -1 {
        let mut mi = 0
        while mi < sublist_length(methods_sl) {
            let m = sublist_get(methods_sl, mi)
            let mname = node_name(m)
            let static_name = "__handler_{handler_idx}_{mname}"
            emit_line("{vt_name}.{mname} = {static_name};")
            mi = mi + 1
        }
    }
    let vt_ptr = "__handler_ptr_{handler_idx}"
    emit_line("{vtable_type}* {vt_ptr} = ({vtable_type}*)blink_alloc(sizeof({vtable_type}));")
    emit_line("*{vt_ptr} = {vt_name};")
    if has_handler_caps && is_user_effect != 0 {
        if handler_caps.len() == 1 {
            let cap0 = handler_caps.get(0).unwrap()
            let cn = cap0.name
            let ct = cap0.tp_id
            let safe_cn = c_safe_name(cn)
            if ct == CT_STRING {
                emit_line("{vt_ptr}->__userdata = (void*){safe_cn};")
            } else {
                emit_line("{vt_ptr}->__userdata = (void*)(uintptr_t){safe_cn};")
            }
        } else {
            let cap_alloc = fresh_temp("__hcaps_")
            emit_line("{cap_struct_name}* {cap_alloc} = ({cap_struct_name}*)blink_alloc(sizeof({cap_struct_name}));")
            let mut sci = 0
            while sci < handler_caps.len() {
                let cn = handler_caps.get(sci).unwrap().name
                let safe_cn = c_safe_name(cn)
                emit_line("{cap_alloc}->{safe_cn} = {safe_cn};")
                sci = sci + 1
            }
            emit_line("{vt_ptr}->__userdata = (void*){cap_alloc};")
        }
    }
    expr_result_str = vt_ptr
    expr_result_type = CT_HANDLER
    cg_handler_vtable_type = vtable_type
    cg_handler_vtable_field = vtable_field
    cg_handler_is_user_effect = is_user_effect
}

@allow(UnrestoredMutation, IncompleteStateRestore)
pub fn emit_async_spawn_closure(closure_node: Int, wrapper_idx: Int, wrapper_name: Str, task_fn_name: Str) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let cl_params_sl = node_params(closure_node)
    let captures = analyze_captures(node_body(closure_node), cl_params_sl)
    let cap_start = closure_captures.len()
    let mut cap_i = 0
    while cap_i < captures.len() {
        let cap_name = captures.get(cap_i).unwrap()
        if is_emitted_let(cap_name) != 0 {
            diag_error_at("CloseableEscapesScope", CLOSEABLE_ESCAPES_SCOPE, "scoped binding '{cap_name}' from with...as block cannot be captured by async.spawn", closure_node, "remove the capture or move the work inside the with block")
        }
        let cap_tp = get_var_tp(cap_name)
        let cap_mut = if list_contains_str(mut_captured_vars, cap_name) != 0 { 1 } else { 0 }
        closure_captures.push(CaptureEntry { name: cap_name, is_mut: cap_mut, tp_id: cap_tp })
        cap_i = cap_i + 1
    }
    closure_cap_infos.push(ClosureCapInfo { start: cap_start, count: captures.len() })

    cg_closure_defs.push("typedef struct \{")
    cg_closure_defs.push("    blink_handle* handle;")
    if captures.len() > 0 {
        cg_closure_defs.push("    void** captures;")
        cg_closure_defs.push("    int64_t capture_count;")
    }
    cg_closure_defs.push("} __async_arg_{wrapper_idx}_t;")
    cg_closure_defs.push("")

    let cl_body = node_body(closure_node)
    let cl_ret_str = node_return_type(closure_node)
    let cl_ret_type = type_from_name(cl_ret_str)
    let mut task_ret_c = c_type_str(cl_ret_type)
    let mut task_ret_struct = ""
    let mut body_ret = cl_ret_type

    if cl_ret_type == CT_OPTION {
        let ret_ann = node_type_ann(closure_node)
        if ret_ann != -1 {
            let elems_sl = node_elements(ret_ann)
            if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
                let inner_ann = sublist_get(elems_sl, 0)
                let inner_name = node_name(inner_ann)
                let inner_ct = type_from_name(inner_name)
                if inner_ct == CT_VOID && is_struct_or_enum_type(inner_name) != 0 {
                    ensure_struct_option_type(inner_name)
                    task_ret_c = struct_option_c_type(inner_name)
                } else if is_compound_ct(inner_ct) != 0 {
                    let compound_name = compound_name_from_ann(inner_ann)
                    ensure_struct_option_type(compound_name)
                    task_ret_c = struct_option_c_type(compound_name)
                } else {
                    ensure_option_type(inner_ct)
                    task_ret_c = option_c_type(inner_ct)
                }
            }
        }
    } else if cl_ret_type == CT_RESULT {
        let ret_ann = node_type_ann(closure_node)
        if ret_ann != -1 {
            let elems_sl = node_elements(ret_ann)
            if elems_sl != -1 && sublist_length(elems_sl) >= 2 {
                let ok_ann = sublist_get(elems_sl, 0)
                let err_ann = sublist_get(elems_sl, 1)
                let ok_name = node_name(ok_ann)
                let err_name = node_name(err_ann)
                let ok_ct = type_from_name(ok_name)
                let err_ct = type_from_name(err_name)
                ensure_result_type(ok_ct, err_ct)
                task_ret_c = result_c_type(ok_ct, err_ct)
            }
        }
    } else if cl_ret_type == CT_VOID && cl_ret_str != "Void" && cl_ret_str != "" {
        if is_struct_type(cl_ret_str) != 0 {
            task_ret_c = c_type_c_name(cl_ret_str)
            task_ret_struct = cl_ret_str
        } else if is_enum_type(cl_ret_str) != 0 {
            task_ret_c = c_type_c_name(cl_ret_str)
        }
    }

    let is_void_ret = cl_ret_str == "Void" || (cl_ret_str == "" && infer_block_type(cl_body) == CT_VOID)
    if is_void_ret {
        task_ret_c = "int64_t"
    } else if cl_ret_str == "" {
        task_ret_c = "int64_t"
        body_ret = CT_INT
    }

    if task_ret_struct != "" || (cl_ret_type == CT_VOID && cl_ret_str != "Void" && cl_ret_str != "" && (is_struct_type(cl_ret_str) != 0 || is_enum_type(cl_ret_str) != 0)) {
        body_ret = CT_INT
    }

    let saved_in_traced = cg_in_traced_fn
    cg_in_traced_fn = 0
    let saved_lines = cg_lines
    let saved_indent = cg_indent
    let saved_temp = cg_temp_counter
    let saved_cap_start = cg_closure_cap_start
    let saved_cap_count = cg_closure_cap_count
    let saved_fn_name = cg_current_fn_name
    let saved_fn_has_ev = cg_current_fn_has_ev
    let saved_fn_ret = cg_current_fn_ret
    let saved_fn_option_inner = cg_current_fn_option_inner
    // The spawned task is its own static C function; it must not inherit the
    // enclosing test/assert_panics elaboration, or a `?` inside it would emit a
    // test-propagation `return` or `goto __ap_returned_<n>` into a frame/label
    // that lives in the test function, not this fn. Mirrors emit_handler_expr.
    let saved_in_test = cg_in_test_body
    let saved_in_ap = cg_in_assert_panics
    cg_in_test_body = 0
    cg_in_assert_panics = 0
    cg_lines = []
    cg_indent = 0
    cg_temp_counter = 0
    cg_closure_cap_start = cap_start
    cg_closure_cap_count = captures.len()
    cg_current_fn_name = task_fn_name
    cg_current_fn_has_ev = 0
    cg_current_fn_ret = body_ret
    if cl_ret_type == CT_OPTION {
        cg_current_fn_option_inner = resolve_option_inner_from_ann(closure_node)
    } else {
        cg_current_fn_option_inner = 0
    }

    push_scope()

    let mut task_params = "const blink_closure* __self"
    emit_line("static {task_ret_c} {task_fn_name}({task_params}) \{")
    cg_indent = cg_indent + 1

    let mut mc_i = 0
    while mc_i < captures.len() {
        let mc_e = closure_captures.get(cap_start + mc_i).unwrap()
        if mc_e.is_mut != 0 {
            let mc_ts = c_type_str(tp_get_kind(mc_e.tp_id))
            emit_line("{mc_ts}* {mc_e.name}_cell = ({mc_ts}*)blink_closure_get_capture(__self, {mc_i});")
        }
        mc_i = mc_i + 1
    }

    if task_ret_struct != "" {
        reg_fn_struct_ret(task_fn_name, task_ret_struct)
    }
    reg_fn_ret_from_ann(task_fn_name, closure_node)

    if is_void_ret {
        emit_fn_body(cl_body, CT_VOID)
        emit_line("return 0;")
    } else {
        emit_fn_body(cl_body, body_ret)
    }
    cg_indent = cg_indent - 1
    emit_line("}")
    emit_line("")

    pop_scope()

    let task_lines = cg_lines
    cg_lines = saved_lines
    cg_indent = saved_indent
    cg_temp_counter = saved_temp
    cg_closure_cap_start = saved_cap_start
    cg_closure_cap_count = saved_cap_count
    cg_current_fn_name = saved_fn_name
    cg_current_fn_has_ev = saved_fn_has_ev
    cg_current_fn_ret = saved_fn_ret
    cg_current_fn_option_inner = saved_fn_option_inner
    cg_in_test_body = saved_in_test
    cg_in_assert_panics = saved_in_ap
    cg_in_traced_fn = saved_in_traced

    let mut tli = 0
    while tli < task_lines.len() {
        cg_closure_defs.push(task_lines.get(tli).unwrap())
        tli = tli + 1
    }

    let needs_boxing = cl_ret_type == CT_FLOAT || cl_ret_type == CT_OPTION || cl_ret_type == CT_RESULT || task_ret_struct != ""

    cg_closure_defs.push("static void {wrapper_name}(void* __arg) \{")
    cg_closure_defs.push("    __async_arg_{wrapper_idx}_t* __a = (__async_arg_{wrapper_idx}_t*)__arg;")
    cg_closure_defs.push("    blink_handle* __h = __a->handle;")
    if captures.len() > 0 {
        cg_closure_defs.push("    blink_closure __self_data = \{NULL, __a->captures, __a->capture_count};")
        cg_closure_defs.push("    {task_ret_c} __r = {task_fn_name}(&__self_data);")
    } else {
        cg_closure_defs.push("    {task_ret_c} __r = {task_fn_name}(NULL);")
    }
    if needs_boxing {
        cg_closure_defs.push("    {task_ret_c}* __bp = ({task_ret_c}*)blink_alloc(sizeof({task_ret_c}));")
        cg_closure_defs.push("    *__bp = __r;")
        cg_closure_defs.push("    blink_handle_set_result(__h, (void*)__bp);")
    } else if cl_ret_type == CT_STRING || cl_ret_type == CT_LIST || cl_ret_type == CT_MAP || cl_ret_type == CT_SET || cl_ret_type == CT_BYTES || cl_ret_type == CT_STRINGBUILDER {
        cg_closure_defs.push("    blink_handle_set_result(__h, (void*)__r);")
    } else {
        cg_closure_defs.push("    blink_handle_set_result(__h, (void*)(intptr_t)__r);")
    }
    cg_closure_defs.push("    GC_FREE(__arg);")
    cg_closure_defs.push("}")
    cg_closure_defs.push("")
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_await_expr(node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    emit_expr(node_obj(node))
    let handle_str = expr_result_str
    let inner_type = get_var_handle_inner(handle_str)
    let handle_sname = get_var_handle_sname(handle_str)
    let tmp = fresh_temp("__await_")
    emit_line("void* {tmp} = blink_handle_await({handle_str});")
    if inner_type == CT_INT {
        expr_result_str = "(int64_t)(intptr_t){tmp}"
        expr_result_type = CT_INT
    } else if inner_type == CT_STRING {
        expr_result_str = "(const char*){tmp}"
        expr_result_type = CT_STRING
    } else if inner_type == CT_FLOAT {
        expr_result_str = "*(double*){tmp}"
        expr_result_type = CT_FLOAT
    } else if inner_type == CT_BOOL {
        expr_result_str = "(int)(intptr_t){tmp}"
        expr_result_type = CT_BOOL
    } else if inner_type == CT_LIST {
        expr_result_str = "(blink_list*){tmp}"
        expr_result_type = CT_LIST
    } else if inner_type == CT_MAP {
        expr_result_str = "(blink_map*){tmp}"
        expr_result_type = CT_MAP
    } else if inner_type == CT_SET {
        expr_result_str = "(blink_set*){tmp}"
        expr_result_type = CT_SET
    } else if inner_type == CT_BYTES {
        expr_result_str = "(blink_bytes*){tmp}"
        expr_result_type = CT_BYTES
    } else if inner_type == CT_OPTION {
        let inner2 = get_var_handle_inner2(handle_str)
        let opt_c_type = if inner2 >= 0 {
            let inner_ct = type_from_name(handle_sname)
            if (inner_ct == CT_VOID || inner_ct == CT_STRUCT || inner_ct == CT_ENUM) && (is_struct_type(handle_sname) != 0 || is_enum_type(handle_sname) != 0) {
                struct_option_c_type(handle_sname)
            } else {
                option_c_type(inner2)
            }
        } else {
            option_c_type(CT_INT)
        }
        let unboxed = fresh_temp("__uopt_")
        emit_line("{opt_c_type} {unboxed} = *({opt_c_type}*){tmp};")
        expr_result_str = unboxed
        expr_result_type = CT_OPTION
        expr_option_inner = if get_var_handle_inner2(handle_str) >= 0 { get_var_handle_inner2(handle_str) } else { CT_INT }
    } else if inner_type == CT_RESULT {
        let inner2 = get_var_handle_inner2(handle_str)
        let ok_ct = type_from_name(handle_sname)
        let err_ct = if inner2 >= 0 { inner2 } else { CT_STRING }
        let res_c_type = result_c_type(ok_ct, err_ct)
        let unboxed = fresh_temp("__ures_")
        emit_line("{res_c_type} {unboxed} = *({res_c_type}*){tmp};")
        expr_result_str = unboxed
        expr_result_type = CT_RESULT
        expr_result_ok_type = ok_ct
        expr_result_err_type = err_ct
    } else if inner_type == CT_STRUCT && handle_sname != "" && is_struct_type(handle_sname) != 0 {
        let struct_c = c_type_c_name(handle_sname)
        let unboxed = fresh_temp("__ust_")
        emit_line("{struct_c} {unboxed} = *({struct_c}*){tmp};")
        expr_result_str = unboxed
        expr_result_type = CT_STRUCT
        set_var_struct(unboxed, handle_sname)
    } else {
        expr_result_str = "(int64_t)(intptr_t){tmp}"
        expr_result_type = CT_INT
    }
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_async_scope(node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    cg_uses_async = 1
    let scope_idx = cg_async_scope_counter
    cg_async_scope_counter = cg_async_scope_counter + 1
    let list_name = "__scope_handles_{scope_idx}"
    emit_line("blink_list* {list_name} = blink_list_new();")
    cg_async_scope_stack.push(list_name)
    emit_block_expr(node_body(node))
    let saved_str = expr_result_str
    let saved_type = expr_result_type
    cg_async_scope_stack.pop()
    let iter_var = fresh_temp("__si_")
    emit_line("for (int64_t {iter_var} = 0; {iter_var} < blink_list_len({list_name}); {iter_var}++) \{")
    cg_indent = cg_indent + 1
    let handle_var = fresh_temp("__sh_")
    emit_line("blink_handle* {handle_var} = (blink_handle*)blink_list_get({list_name}, {iter_var});")
    emit_line("if ({handle_var}->status == BLINK_HANDLE_RUNNING) \{")
    cg_indent = cg_indent + 1
    emit_line("blink_handle_await({handle_var});")
    cg_indent = cg_indent - 1
    emit_line("}")
    cg_indent = cg_indent - 1
    emit_line("}")
    emit_line("blink_list_free({list_name});")
    expr_result_str = saved_str
    expr_result_type = saved_type
}

// Mirrors codegen_stmt.bl:strip_outer_parens. Duplicated rather than
// shared because the import direction is codegen_stmt -> codegen_expr;
// keep the body byte-identical so a fix in one stays trivially
// portable to the other.
fn strip_outer_parens_expr(s: Str) -> Str {
    if s.starts_with("(") && s.ends_with(")") {
        let inner = s.substring(1, s.len() - 2)
        let mut depth = 0
        let mut i = 0
        let mut balanced = 1
        while i < inner.len() {
            let ch = inner.byte_at(i)
            if ch == 40 { // '('
                depth = depth + 1
            } else if ch == 41 { // ')'
                if depth == 0 {
                    balanced = 0
                }
                depth = depth - 1
            }
            i = i + 1
        }
        if balanced != 0 && depth == 0 {
            return inner
        }
    }
    s
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_binop(node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let op = node_op(node)
    if op == "??" {
        emit_expr(node_left(node))
        let left_str = expr_result_str
        let left_type = expr_result_type
        let opt_inner = expr_option_inner
        let opt_inner_s = expr_option_inner_struct
        if left_type == CT_BOOL || left_type == CT_FLOAT || left_type == CT_STRING || left_type == CT_LIST || left_type == CT_RESULT || left_type == CT_CLOSURE {
            diag_error_at("CoalesceRequiresOption", COALESCE_REQUIRES_OPT, "the ?? operator requires an Option value but got a non-Option type in function '{cg_current_fn_name}'", node, "")
        }
        emit_expr(node_right(node))
        let right_str = expr_result_str
        let right_type = expr_result_type
        let tmp = fresh_temp("__opt")
        if opt_inner_s != "" {
            let opt_c = struct_option_c_type(opt_inner_s)
            emit_line("{opt_c} {tmp} = {left_str};")
            let val_tmp = fresh_temp("__optv")
            let inner_c = c_type_from_tag(opt_inner_s)
            if inner_c.ends_with("*") {
                emit_line("{inner_c} {val_tmp} = {tmp}.tag == 1 ? {tmp}.value : {right_str};")
                set_var(val_tmp, opt_inner, 0)
                expr_result_type = opt_inner
            } else {
                emit_line("{c_type_c_name(opt_inner_s)} {val_tmp} = {tmp}.tag == 1 ? *{tmp}.value : {right_str};")
                set_var_struct(val_tmp, opt_inner_s)
                expr_result_type = right_type
            }
            expr_result_str = val_tmp
        } else if opt_inner == CT_LIST {
            let opt_c = option_c_type(CT_LIST)
            emit_line("{opt_c} {tmp} = {left_str};")
            let val_tmp = fresh_temp("__optv")
            emit_line("blink_list* {val_tmp} = {tmp}.tag == 1 ? {tmp}.value : {right_str};")
            set_var(val_tmp, CT_LIST, 0)
            let inner2 = expr_option_inner_list_elem
            if inner2 >= 0 {
                set_list_elem_type(val_tmp, inner2)
                expr_list_elem_type = inner2
            }
            let inner2_s = expr_option_inner_list_struct
            if inner2_s != "" {
                set_list_elem_struct(val_tmp, inner2_s)
            }
            expr_result_str = val_tmp
            expr_result_type = CT_LIST
        } else if opt_inner >= 0 {
            let opt_c = option_c_type(opt_inner)
            emit_line("{opt_c} {tmp} = {left_str};")
            expr_result_str = "({tmp}.tag == 1 ? {tmp}.value : {right_str})"
            expr_result_type = right_type
        } else {
            emit_line("const int64_t {tmp} = (int64_t){left_str};")
            expr_result_str = "({tmp}.tag == 1 ? {tmp}.value : {right_str})"
            expr_result_type = right_type
        }
        return
    }
    emit_expr(node_left(node))
    let left_str = expr_result_str
    let left_type = expr_result_type
    let left_opt_inner = expr_option_inner
    let left_opt_inner_struct = expr_option_inner_struct

    if op == "&&" || op == "||" {
        let pre_len = cg_lines.len()
        emit_expr(node_right(node))
        let right_str = expr_result_str
        let post_len = cg_lines.len()
        if post_len > pre_len {
            let mut rhs_lines: List[Str] = []
            let mut ri = pre_len
            while ri < post_len {
                rhs_lines.push(cg_lines.get(ri).unwrap())
                ri = ri + 1
            }
            let mut pi = post_len - 1
            while pi >= pre_len {
                cg_lines.pop()
                pi = pi - 1
            }
            let sc_tmp = fresh_temp("__sc")
            emit_line("int64_t {sc_tmp};")
            let left_cond = strip_outer_parens_expr(left_str)
            if op == "&&" {
                emit_line("if ({left_cond}) \{")
            } else {
                emit_line("if (!({left_cond})) \{")
            }
            cg_indent = cg_indent + 1
            let mut si = 0
            while si < rhs_lines.len() {
                cg_lines.push(rhs_lines.get(si).unwrap())
                si = si + 1
            }
            emit_line("{sc_tmp} = ({right_str}) ? 1 : 0;")
            cg_indent = cg_indent - 1
            if op == "&&" {
                emit_line("} else \{ {sc_tmp} = 0; }")
            } else {
                emit_line("} else \{ {sc_tmp} = 1; }")
            }
            expr_result_str = sc_tmp
            expr_result_type = CT_BOOL
        } else {
            expr_result_str = "({left_str} {op} {right_str})"
            expr_result_type = CT_BOOL
        }
        return
    }

    emit_expr(node_right(node))
    let right_str = expr_result_str
    let right_type = expr_result_type

    if (op == "==" || op == "!=") && left_type == CT_OPTION && right_type == CT_OPTION && left_opt_inner_struct == "" && expr_option_inner_struct == "" && left_opt_inner == expr_option_inner {
        let opt_c = option_c_type(left_opt_inner)
        let ltmp = fresh_temp("__oeql")
        let rtmp = fresh_temp("__oeqr")
        emit_line("{opt_c} {ltmp} = {left_str};")
        emit_line("{opt_c} {rtmp} = {right_str};")
        if op == "==" {
            expr_result_str = "({ltmp}.tag == {rtmp}.tag && ({ltmp}.tag == 0 || {ltmp}.value == {rtmp}.value))"
        } else {
            expr_result_str = "({ltmp}.tag != {rtmp}.tag || ({ltmp}.tag != 0 && {ltmp}.value != {rtmp}.value))"
        }
        expr_result_type = CT_BOOL
        return
    }

    if op == "==" && left_type == CT_STRING && right_type == CT_STRING {
        let eq_fn = c_fn_name("str_eq")
        expr_result_str = "{eq_fn}({left_str}, {right_str})"
        expr_result_type = CT_BOOL
        return
    }
    if op == "!=" && left_type == CT_STRING && right_type == CT_STRING {
        let eq_fn = c_fn_name("str_eq")
        expr_result_str = "(!{eq_fn}({left_str}, {right_str}))"
        expr_result_type = CT_BOOL
        return
    }
    if (op == "<" || op == "<=" || op == ">" || op == ">=") && left_type == CT_STRING && right_type == CT_STRING {
        expr_result_str = "(blink_str_cmp({left_str}, {right_str}) {op} 0)"
        expr_result_type = CT_BOOL
        return
    }
    if op == "<<" || op == ">>" {
        let lc = c_type_str(left_type)
        let rhs_node = node_right(node)
        if rhs_node != -1 && node_kind(rhs_node) == NodeKind.IntLit {
            expr_result_str = "(({lc})({left_str}) {op} (uint32_t){right_str})"
        } else {
            let bw = ct_bit_width(left_type)
            let amt = fresh_temp("__sh_amt")
            let val = fresh_temp("__sh_val")
            let loc_line = panic_line_str(node)
            let file = panic_file_for_fmt(node)
            emit_line("uint32_t {amt} = (uint32_t)({right_str});")
            emit_line("if ({amt} >= {bw}) \{ {emit_panic_site(\"panic: shift amount %u exceeds bit width {bw} at {file}:{loc_line}\", \", {amt}\")} }")
            emit_line("{lc} {val} = ({lc})({left_str}) {op} {amt};")
            expr_result_str = val
        }
        expr_result_type = left_type
        return
    }

    // Sized-integer arithmetic: trap on overflow per spec §03_types.md:739-760.
    if is_sized_int_ct(left_type) && (op == "+" || op == "-" || op == "*" || op == "/" || op == "%") {
        let lc = c_type_str(left_type)
        let tname = type_name_from_ct(left_type)
        let loc_line = panic_line_str(node)
        let file = panic_file_for_fmt(node)
        let result_tmp = fresh_temp("__sov")
        let lhs_tmp = fresh_temp("__sov_l")
        let rhs_tmp = fresh_temp("__sov_r")
        // The panic message is a printf format; `%` (modulo) is a literal here
        // and must be escaped as `%%` so vsnprintf/fprintf don't read it as a
        // conversion spec (the message is matched by assert_panics).
        let op_msg = if op == "%" { "%%" } else { op }
        emit_line("{lc} {lhs_tmp} = ({lc})({left_str});")
        emit_line("{lc} {rhs_tmp} = ({lc})({right_str});")
        if op == "/" || op == "%" {
            emit_line("if ({rhs_tmp} == 0) \{ {emit_panic_site(\"panic: {tname} division by zero at {file}:{loc_line}\", \"\")} }")
            // Signed INT_MIN / -1 traps as overflow.
            if left_type == CT_I8 {
                emit_line("if ({lhs_tmp} == (int8_t)0x80 && {rhs_tmp} == -1) \{ {emit_panic_site(\"panic: {tname} overflow in {op_msg} at {file}:{loc_line}\", \"\")} }")
            } else if left_type == CT_I16 {
                emit_line("if ({lhs_tmp} == (int16_t)0x8000 && {rhs_tmp} == -1) \{ {emit_panic_site(\"panic: {tname} overflow in {op_msg} at {file}:{loc_line}\", \"\")} }")
            } else if left_type == CT_I32 {
                emit_line("if ({lhs_tmp} == (int32_t)0x80000000 && {rhs_tmp} == -1) \{ {emit_panic_site(\"panic: {tname} overflow in {op_msg} at {file}:{loc_line}\", \"\")} }")
            }
            emit_line("{lc} {result_tmp} = {lhs_tmp} {op} {rhs_tmp};")
        } else {
            // +, -, * use __builtin_*_overflow.
            let builtin_name = if op == "+" { "add" } else if op == "-" { "sub" } else { "mul" }
            emit_line("{lc} {result_tmp};")
            emit_line("if (__builtin_{builtin_name}_overflow({lhs_tmp}, {rhs_tmp}, &{result_tmp})) \{ {emit_panic_site(\"panic: {tname} overflow in {op_msg} (%lld {op_msg} %lld) at {file}:{loc_line}\", \", (long long){lhs_tmp}, (long long){rhs_tmp}\")} }")
        }
        expr_result_str = result_tmp
        expr_result_type = left_type
        return
    }

    // Plain Int / I64 (CT_INT) WRAP for +,-,* (they fall through below to raw C),
    // so they are NOT checked types. But `/0` and `INT64_MIN / -1` are genuine C
    // UB (SIGFPE) -- guard only those two like the sized ints (qf1rgp). I64 is an
    // alias for CT_INT, so this covers both; the message reads "Int" for both.
    if left_type == CT_INT && (op == "/" || op == "%") {
        let lc = c_type_str(left_type)
        let tname = type_name_from_ct(left_type)
        let loc_line = panic_line_str(node)
        let file = panic_file_for_fmt(node)
        let result_tmp = fresh_temp("__iov")
        let lhs_tmp = fresh_temp("__iov_l")
        let rhs_tmp = fresh_temp("__iov_r")
        // `%` (modulo) is literal in the message and must be escaped as `%%` so
        // vsnprintf/fprintf don't read it as a conversion spec.
        let op_msg = if op == "%" { "%%" } else { op }
        emit_line("{lc} {lhs_tmp} = ({lc})({left_str});")
        emit_line("{lc} {rhs_tmp} = ({lc})({right_str});")
        emit_line("if ({rhs_tmp} == 0) \{ {emit_panic_site(\"panic: {tname} division by zero at {file}:{loc_line}\", \"\")} }")
        emit_line("if ({lhs_tmp} == (int64_t)0x8000000000000000 && {rhs_tmp} == -1) \{ {emit_panic_site(\"panic: {tname} overflow in {op_msg} at {file}:{loc_line}\", \"\")} }")
        emit_line("{lc} {result_tmp} = {lhs_tmp} {op} {rhs_tmp};")
        expr_result_str = result_tmp
        expr_result_type = left_type
        return
    }

    // vfgp72: comparison operators desugar to Eq.eq / Ord.cmp for types whose
    // C representation has no usable raw `==`/`<` (structs, Bytes, builtin
    // Instant/Duration, data enums). Simple enums lower to integer tags, so they
    // fall through to raw C below. Typecheck (Stage 4) has already validated
    // that both operands share the type and carry the required impl.
    let is_cmp = op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">="
    if is_cmp {
        // Instant/Duration: `{ int64_t nanos; }` — compare the field directly.
        if left_type == CT_INSTANT || left_type == CT_DURATION {
            expr_result_str = "(({left_str}).nanos {op} ({right_str}).nanos)"
            expr_result_type = CT_BOOL
            return
        }
        // Bytes: runtime structural comparison.
        if left_type == CT_BYTES && right_type == CT_BYTES {
            if op == "==" {
                expr_result_str = "(blink_bytes_eq({left_str}, {right_str}))"
            } else if op == "!=" {
                expr_result_str = "(!blink_bytes_eq({left_str}, {right_str}))"
            } else {
                expr_result_str = "(blink_bytes_cmp({left_str}, {right_str}) {op} 0)"
            }
            expr_result_type = CT_BOOL
            return
        }
        // Struct, or data-enum carrying a custom Eq/Ord: route to the eq/cmp
        // function. The name resolves through the user impl first (mangled,
        // trait-qualified) then the @derive-synthesized `{T}_eq`/`{T}_cmp`.
        let cmp_tname = cmp_operand_type_name(left_type, left_str, right_str)
        if cmp_tname != "" {
            let relational = op != "==" && op != "!="
            if relational == 0 {
                let eq_call = cmp_eq_call(cmp_tname, left_str, right_str)
                if eq_call != "" {
                    expr_result_str = if op == "==" { eq_call } else { "(!{eq_call})" }
                    expr_result_type = CT_BOOL
                    return
                }
            } else {
                let cmp_call = cmp_cmp_call(cmp_tname, left_str, right_str)
                if cmp_call != "" {
                    let ord_t = c_type_c_name("Ordering")
                    let ct = fresh_temp("__ord")
                    emit_line("{ord_t} {ct} = {cmp_call};")
                    // Desugar table (03_types.md:1804-1807).
                    if op == "<" {
                        expr_result_str = "({ct} == {ord_t}_Less)"
                    } else if op == ">" {
                        expr_result_str = "({ct} == {ord_t}_Greater)"
                    } else if op == "<=" {
                        expr_result_str = "({ct} != {ord_t}_Greater)"
                    } else {
                        expr_result_str = "({ct} != {ord_t}_Less)"
                    }
                    expr_result_type = CT_BOOL
                    return
                }
            }
        }
    }

    expr_result_str = "({left_str} {op} {right_str})"
    if op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=" {
        expr_result_type = CT_BOOL
    } else {
        expr_result_type = left_type
    }
}

// vfgp72: the struct/data-enum type name a comparison should dispatch through,
// or "" to fall through to raw C. Simple enums (int tags) return "" — raw C
// works. A struct/data-enum returns its name only when it actually carries an
// Eq/Ord (user impl or @derive); otherwise "" (typecheck already rejected the
// genuinely-uncomparable cases, so this just guards the dispatch).
fn cmp_operand_type_name(lt: Int, ls: Str, rs: Str) -> Str {
    if lt == CT_STRUCT {
        let n = get_var_struct(ls)
        if n != "" { return n }
        let nr = get_var_struct(rs)
        if nr != "" { return nr }
    }
    if lt == CT_ENUM {
        let n = get_var_enum(ls)
        // Only data-enums with a real Eq/Ord need dispatch; simple enums and
        // un-derived data-enums fall through (raw tag compare / typecheck-gated).
        if n != "" && is_data_enum(n) != 0 {
            if has_derive_method(n, "eq") != 0 || lookup_impl_method(n, "eq") != 0 {
                return n
            }
        }
    }
    ""
}

// vfgp72: C call for `a.eq(b)`. User `impl Eq` wins (trait-qualified mangled
// symbol); else the @derive-synthesized `{T}_eq`. "" if neither exists.
fn cmp_eq_call(tname: Str, ls: Str, rs: Str) -> Str {
    if lookup_impl_method(tname, "eq") != 0 {
        let reg = impl_method_reg_name(tname, "eq")
        let owner = if impl_type_implements_trait_method(reg, "Eq", "eq") != 0 { "Eq" } else { impl_trait_for_method(reg, "eq") }
        let mangled = if owner != "" { mangle_impl_method_q(reg, owner, "eq") } else { "{reg}_eq" }
        return "{c_fn_name(mangled)}({ls}, {rs})"
    }
    if has_derive_method(tname, "eq") != 0 {
        return "{derive_method_cname(tname, "eq")}({ls}, {rs})"
    }
    ""
}

// vfgp72: C call for `a.cmp(b)` -> Ordering. User `impl Ord` wins; else the
// @derive-synthesized `{T}_cmp`. "" if neither exists.
fn cmp_cmp_call(tname: Str, ls: Str, rs: Str) -> Str {
    if lookup_impl_method(tname, "cmp") != 0 {
        let reg = impl_method_reg_name(tname, "cmp")
        let owner = if impl_type_implements_trait_method(reg, "Ord", "cmp") != 0 { "Ord" } else { impl_trait_for_method(reg, "cmp") }
        let mangled = if owner != "" { mangle_impl_method_q(reg, owner, "cmp") } else { "{reg}_cmp" }
        return "{c_fn_name(mangled)}({ls}, {rs})"
    }
    if has_derive_method(tname, "cmp") != 0 {
        return "{derive_method_cname(tname, "cmp")}({ls}, {rs})"
    }
    ""
}

fn emit_arena_expr_unwind() ! Codegen.Emit {
    let mut di = cg_arena_expr_tmp_stack.len() - 1
    while di >= 0 {
        let inner_tmp = cg_arena_expr_tmp_stack.get(di).unwrap()
        let inner_prev = cg_arena_expr_prev_stack.get(di).unwrap()
        emit_line("__blink_current_arena = {inner_prev};")
        emit_line("blink_arena_destroy({inner_tmp});")
        di = di - 1
    }
}

// brvx89: shared emission for the test `skip(reason)` intrinsic, reached from
// both the bare-Ident call path (emit_call) and the qualified `testing.skip(...)`
// path (emit_method_call). Plain `return` (not longjmp) so __attribute__((cleanup))
// destructors fire for in-scope `with` bindings. Typecheck (E0827, §2.20
// test-only fence) guarantees skip() only reaches codegen from inside a test.
// NOTE: a codegen-side re-check of cg_in_test_body is NOT a valid backstop —
// cg_in_test_body is deliberately reset to 0 inside closure bodies (spec §3c.2,
// codegen_closures.bl), yet skip() inside a test-nested closure (e.g.
// testing.for_each's case body) is legal, so such a guard would reject valid
// code. Enforcement lives at typecheck.
pub fn emit_skip_intrinsic(reason_arg: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    emit_expr(reason_arg)
    emit_line("__blink_test_set_skipped({expr_result_str});")
    emit_arena_expr_unwind()
    emit_line("return;")
    expr_result_str = ""
    expr_result_type = CT_VOID
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_unaryop(node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    emit_expr(node_left(node))
    let operand_str = expr_result_str
    let operand_type = expr_result_type
    let op = node_op(node)
    if op == "-" {
        if is_sized_int_ct(operand_type) {
            let lc = c_type_str(operand_type)
            let tname = type_name_from_ct(operand_type)
            let loc_line = panic_line_str(node)
            let file = panic_file_for_fmt(node)
            let result_tmp = fresh_temp("__sneg")
            let in_tmp = fresh_temp("__sneg_in")
            emit_line("{lc} {in_tmp} = ({lc})({operand_str});")
            if operand_type == CT_U8 || operand_type == CT_U16 || operand_type == CT_U32 || operand_type == CT_U64 {
                emit_line("if ({in_tmp} != 0) \{ {emit_panic_site(\"panic: {tname} overflow in unary - at {file}:{loc_line}\", \"\")} }")
                emit_line("{lc} {result_tmp} = 0;")
            } else {
                emit_line("{lc} {result_tmp};")
                emit_line("if (__builtin_sub_overflow(({lc})0, {in_tmp}, &{result_tmp})) \{ {emit_panic_site(\"panic: {tname} overflow in unary - at {file}:{loc_line}\", \"\")} }")
            }
            expr_result_str = result_tmp
            expr_result_type = operand_type
            return
        }
        expr_result_str = "(-{operand_str})"
        expr_result_type = operand_type
    } else if op == "!" {
        expr_result_str = "(!{operand_str})"
        expr_result_type = CT_BOOL
    } else if op == "~" {
        expr_result_str = "(~({operand_str}))"
        expr_result_type = operand_type
    } else if op == "?" {
        let tmp = fresh_temp("__res")
        if operand_type == CT_RESULT {
            if cg_in_test_body != 0 {
                // Spec §2.20: test body using `?` is elaborated to
                // Result[Void, TestError]. Result-sentinel propagation
                // (set globals + plain `return`) so __attribute__((cleanup))
                // destructors run on the way out.
                let rok = expr_result_ok_type
                let rerr = expr_result_err_type
                let rok_s = expr_result_ok_struct
                let rerr_s = expr_result_err_struct
                let res_c = result_c_type_mixed(rok, rerr, rok_s, rerr_s)
                emit_line("{res_c} {tmp} = {operand_str};")
                // WHY raw node_line here (no panic_line_str defensive fallback):
                // __blink_test_set_propagate takes a typed Int line, not a
                // string-formatted location. The UnaryOp `?` node is created
                // only by the parser (src/parser.bl: parse postfix; see also
                // br 272w17 audit), and the parser always inherits the line
                // from a real inner expression, so node_line(node) > 0 here.
                // If a future transform synthesizes a `?` node, it must
                // propagate a real line (or this site + the runtime helper
                // need a sentinel like -1 mapped to "<synthesized>").
                let qm_line = node_line(node)
                let qm_col = node_col(node)
                let qm_file = panic_file_for(node)
                let err_msg_expr = test_render_err_message(rerr, rerr_s, "{tmp}.err")
                let err_type_name = test_err_type_display_name(rerr, rerr_s)
                emit_line("if ({tmp}.tag == 1) \{")
                cg_indent = cg_indent + 1
                if cg_in_assert_panics != 0 {
                    // §2.20: a `?`-propagated Err exiting the body WITHOUT a
                    // panic is E0831 (body returned). Jump to the block's E0831
                    // landing label instead of propagating to the runner.
                    emit_arena_expr_unwind()
                    emit_line("goto __ap_returned_{cg_in_assert_panics};")
                } else {
                    emit_line("__blink_test_set_propagate({err_msg_expr}, \"{err_type_name}\", \"{qm_file}\", {qm_line}, {qm_col});")
                    emit_arena_expr_unwind()
                    emit_line("return;")
                }
                cg_indent = cg_indent - 1
                emit_line("}")
                reseat_after_q_on_result(tmp, rok, rok_s)
            } else if cg_current_fn_ret != CT_RESULT {
                diag_error_at("QuestionMarkResultInNonResult", QM_RESULT_IN_NON_RESULT, "'?' on Result in function '{cg_current_fn_name}' which does not return Result", node, "change the return type to Result")
                diag_set_last_fix("replace", "-> Result[T, E]")
                expr_result_str = "0"
                expr_result_type = CT_INT
            } else {
                let rok = expr_result_ok_type
                let rerr = expr_result_err_type
                let rok_s = expr_result_ok_struct
                let rerr_s = expr_result_err_struct
                let fn_rt = get_fn_ret_type(cg_current_fn_name)
                let fn_fsi = get_fn_ret_struct_inner(cg_current_fn_name)
                let res_c = result_c_type_mixed(rok, rerr, rok_s, rerr_s)
                let fn_res_c = result_c_type_mixed(tp_child1_kind(fn_rt.tp_id), tp_child2_kind(fn_rt.tp_id), fn_fsi.ok_struct, fn_fsi.err_struct)
                emit_line("{res_c} {tmp} = {operand_str};")
                let depth = cg_arena_expr_tmp_stack.len()
                if depth == 0 {
                    emit_line("if ({tmp}.tag == 1) return ({fn_res_c})\{.tag = 1, .err = {tmp}.err};")
                } else {
                    let outer_prev = cg_arena_expr_prev_stack.get(0).unwrap()
                    let err_desc = ct_to_descriptor(rerr, rerr_s)
                    emit_line("if ({tmp}.tag == 1) \{")
                    cg_indent = cg_indent + 1
                    let mut err_expr = "{tmp}.err"
                    if err_desc == "P:Str" {
                        let etmp = fresh_temp("__arena_err_")
                        emit_line("const char* {etmp} = blink_promote_str({outer_prev}, {tmp}.err);")
                        err_expr = etmp
                    } else if err_desc != "" && !err_desc.starts_with("P:") {
                        let mangle = descriptor_mangle(err_desc)
                        queue_promote_type(err_desc)
                        let etmp = fresh_temp("__arena_err_")
                        let ec = c_type_from_tag(rerr_s)
                        emit_line("{ec} {etmp} = blink_promote_{mangle}({outer_prev}, {tmp}.err);")
                        err_expr = etmp
                    }
                    let mut di = depth - 1
                    while di >= 0 {
                        let inner_tmp = cg_arena_expr_tmp_stack.get(di).unwrap()
                        let inner_prev = cg_arena_expr_prev_stack.get(di).unwrap()
                        emit_line("__blink_current_arena = {inner_prev};")
                        emit_line("blink_arena_destroy({inner_tmp});")
                        di = di - 1
                    }
                    emit_line("return ({fn_res_c})\{.tag = 1, .err = {err_expr}};")
                    cg_indent = cg_indent - 1
                    emit_line("}")
                }
                reseat_after_q_on_result(tmp, rok, rok_s)
            }
        } else if operand_type == CT_OPTION {
            if cg_in_test_body != 0 {
                // Spec §2.20: test-scope ? on Option None propagates
                // via the Result-sentinel path so cleanup destructors run.
                let opt_inner = expr_option_inner
                let opt_inner_s = expr_option_inner_struct
                if opt_inner_s != "" {
                    let opt_c = struct_option_c_type(opt_inner_s)
                    emit_line("{opt_c} {tmp} = {operand_str};")
                } else {
                    let inner = if opt_inner >= 0 { opt_inner } else { CT_INT }
                    let opt_c = option_c_type(inner)
                    emit_line("{opt_c} {tmp} = {operand_str};")
                }
                // WHY raw node_line here: same invariant as the Result `?`
                // site above — UnaryOp `?` is parser-only and always inherits
                // a real line. See the longer comment above for the audit
                // (br 272w17).
                let qm_line = node_line(node)
                let qm_col = node_col(node)
                let qm_file = panic_file_for(node)
                emit_line("if ({tmp}.tag == 0) \{")
                cg_indent = cg_indent + 1
                if cg_in_assert_panics != 0 {
                    // §2.20: a `?`-propagated None exiting the body WITHOUT a
                    // panic is E0831 (body returned). Jump to the block's E0831
                    // landing label instead of propagating to the runner.
                    emit_arena_expr_unwind()
                    emit_line("goto __ap_returned_{cg_in_assert_panics};")
                } else {
                    emit_line("__blink_test_set_propagate(\"None\", \"Option\", \"{qm_file}\", {qm_line}, {qm_col});")
                    emit_arena_expr_unwind()
                    emit_line("return;")
                }
                cg_indent = cg_indent - 1
                emit_line("}")
                if opt_inner_s != "" {
                    let inner_c = c_type_from_tag(opt_inner_s)
                    if inner_c.ends_with("*") {
                        expr_result_str = "{tmp}.value"
                        expr_result_type = opt_inner
                    } else {
                        expr_result_str = "(*{tmp}.value)"
                        expr_result_type = CT_INT
                        set_var_struct(expr_result_str, opt_inner_s)
                    }
                } else {
                    let inner = if opt_inner >= 0 { opt_inner } else { CT_INT }
                    expr_result_str = "{tmp}.value"
                    expr_result_type = inner
                }
                expr_option_inner = -1
                expr_option_inner_struct = ""
            } else if cg_current_fn_ret != CT_OPTION {
                diag_error_at("QuestionMarkOptionInNonOption", QM_OPTION_IN_NON_OPTION, "'?' on Option in function '{cg_current_fn_name}' which does not return Option", node, "change the return type to Option")
                diag_set_last_fix("replace", "-> Option[T]")
                expr_result_str = "0"
                expr_result_type = CT_INT
            } else {
                let opt_inner = expr_option_inner
                let opt_inner_s = expr_option_inner_struct
                let fsi = get_fn_ret_struct_inner(cg_current_fn_name)
                let fn_opt_c = if fsi.ok_struct != "" {
                    struct_option_c_type(fsi.ok_struct)
                } else {
                    let fn_inner = if cg_current_fn_option_inner != 0 { cg_current_fn_option_inner } else { CT_INT }
                    option_c_type(fn_inner)
                }
                if opt_inner_s != "" {
                    let opt_c = struct_option_c_type(opt_inner_s)
                    emit_line("{opt_c} {tmp} = {operand_str};")
                } else {
                    let inner = if opt_inner >= 0 { opt_inner } else { CT_INT }
                    let opt_c = option_c_type(inner)
                    emit_line("{opt_c} {tmp} = {operand_str};")
                }
                let odepth = cg_arena_expr_tmp_stack.len()
                if odepth == 0 {
                    emit_line("if ({tmp}.tag == 0) return ({fn_opt_c})\{.tag = 0};")
                } else {
                    emit_line("if ({tmp}.tag == 0) \{")
                    cg_indent = cg_indent + 1
                    let mut odi = odepth - 1
                    while odi >= 0 {
                        let inner_tmp = cg_arena_expr_tmp_stack.get(odi).unwrap()
                        let inner_prev = cg_arena_expr_prev_stack.get(odi).unwrap()
                        emit_line("__blink_current_arena = {inner_prev};")
                        emit_line("blink_arena_destroy({inner_tmp});")
                        odi = odi - 1
                    }
                    emit_line("return ({fn_opt_c})\{.tag = 0};")
                    cg_indent = cg_indent - 1
                    emit_line("}")
                }
                if opt_inner_s != "" {
                    let inner_c = c_type_from_tag(opt_inner_s)
                    if inner_c.ends_with("*") {
                        expr_result_str = "{tmp}.value"
                        expr_result_type = opt_inner
                    } else {
                        expr_result_str = "(*{tmp}.value)"
                        expr_result_type = CT_INT
                        set_var_struct(expr_result_str, opt_inner_s)
                    }
                } else {
                    let inner = if opt_inner >= 0 { opt_inner } else { CT_INT }
                    expr_result_str = "{tmp}.value"
                    expr_result_type = inner
                }
                expr_option_inner = -1
                expr_option_inner_struct = ""
            }
        } else {
            diag_error_at("QuestionMarkInvalidOperand", QM_INVALID_OPERAND, "'?' requires a Result or Option value", node, "")
            expr_result_str = "0"
            expr_result_type = CT_INT
        }
    } else {
        expr_result_str = "({op}{operand_str})"
        expr_result_type = operand_type
    }
}

let mut reorder_result: List[Int] = []

fn reorder_named_args(fn_name: Str, args_sl: Int, call_node: Int) ! Diag.Report {
    reorder_result = []
    if args_sl == -1 {
        return
    }
    let argc = sublist_length(args_sl)
    if argc == 0 {
        return
    }
    let mut positional_end = -1
    let mut i = 0
    while i < argc {
        let arg = sublist_get(args_sl, i)
        if node_kind(arg) == NodeKind.NamedArg {
            positional_end = i
            i = argc
        }
        i = i + 1
    }
    if positional_end == -1 {
        return
    }
    let fn_node = get_fn_node(fn_name)
    if fn_node == -1 {
        return
    }
    let params_sl = node_params(fn_node)
    if params_sl == -1 {
        return
    }
    let param_count = sublist_length(params_sl)
    i = positional_end
    while i < argc {
        let arg = sublist_get(args_sl, i)
        if node_kind(arg) == NodeKind.NamedArg {
            let label = node_name(arg)
            let mut valid = 0
            let mut k = 0
            while k < param_count {
                let pk = sublist_get(params_sl, k)
                if node_name(pk) == label {
                    valid = 1
                    k = param_count
                }
                k = k + 1
            }
            if valid == 0 {
                diag_error_at("InvalidKeywordArg", INVALID_KEYWORD_ARG, "no parameter named '{label}' in function '{fn_name}'", call_node, "check the function signature")
                return
            }
        } else {
            diag_error_at("InvalidKeywordArg", INVALID_KEYWORD_ARG, "positional argument after named argument in call to '{fn_name}'", call_node, "place all positional arguments before named arguments")
            return
        }
        i = i + 1
    }
    let mut result: List[Int] = []
    i = 0
    while i < positional_end {
        result.push(sublist_get(args_sl, i))
        i = i + 1
    }
    i = positional_end
    while i < param_count {
        let param_node = sublist_get(params_sl, i)
        let param_name = node_name(param_node)
        let mut found = 0
        let mut j = positional_end
        while j < argc {
            let arg = sublist_get(args_sl, j)
            if node_kind(arg) == NodeKind.NamedArg {
                let label = node_name(arg)
                if label == param_name {
                    result.push(arg)
                    found = 1
                    j = argc
                }
            }
            j = j + 1
        }
        if found == 0 {
            diag_error_at("MissingKeywordArg", MISSING_KEYWORD_ARG, "missing keyword argument '{param_name}' in call to '{fn_name}'", call_node, "add '{param_name}: <value>'")
            return
        }
        i = i + 1
    }
    reorder_result = result
}

// For a one-level decomposition of an assert(...) condition, we render each
// operand's value via a printf-style format. Falls back to a long-long cast
// for types we cannot pretty-print so the assert still produces a handle.
fn pa_fmt_for_ct(c_expr: Str, ct: Int) -> Str {
    if ct == CT_BOOL {
        return "(({c_expr}) ? \"true\" : \"false\")"
    }
    if ct == CT_FLOAT {
        return "(double)({c_expr})"
    }
    if ct == CT_STRING {
        return "({c_expr}) ? ({c_expr}) : \"\""
    }
    if ct == CT_CHAR {
        return "(int)({c_expr})"
    }
    return "(long long)({c_expr})"
}

fn pa_fmt_spec_for_ct(ct: Int) -> Str {
    if ct == CT_BOOL { return "%s" }
    if ct == CT_FLOAT { return "%g" }
    if ct == CT_STRING { return "\\\"%s\\\"" }
    if ct == CT_CHAR { return "%d" }
    return "%lld"
}

// Build the snprintf format chunk for one introspection line: "  <src> = <fmt>".
// escape_c_string covers backslash + quote; identifiers don't carry % and we
// don't decompose into string-literal interiors, so the source text is safe to
// embed in the snprintf format directly.
fn pa_intro_line(src_text: Str, ct: Int) -> Str {
    "  {escape_c_string(src_text)} = {pa_fmt_spec_for_ct(ct)}"
}

// Renderable binop ops for one-level introspection (comparisons + logical).
// Arithmetic ops at the assert top level are unusual and rendering them
// would require care for division-by-zero etc., so we keep the set tight.
fn pa_op_renderable(op: Str) -> Int {
    if op == "==" || op == "!=" { return 1 }
    if op == "<" || op == "<=" { return 1 }
    if op == ">" || op == ">=" { return 1 }
    if op == "&&" || op == "||" { return 1 }
    0
}

// vfgp72: a CT whose value the assert predicate-analysis can decompose into a
// raw-C comparison + %-formatted intro line. Structs, enums, Option, Bytes,
// Instant/Duration carry no usable raw `==`/`<` and no scalar %-format, so an
// assert over them must emit the whole (already-desugared) condition instead.
fn pa_ct_renderable(ct: Int) -> Int {
    if ct == CT_INT || ct == CT_BOOL || ct == CT_FLOAT || ct == CT_CHAR || ct == CT_STRING { return 1 }
    if ct == CT_I8 || ct == CT_I16 || ct == CT_I32 { return 1 }
    if ct == CT_U8 || ct == CT_U16 || ct == CT_U32 || ct == CT_U64 { return 1 }
    0
}

pub fn arg_struct_name_for(rt: Int, rs: Str, list_elem_struct: Str) -> Str {
    if rt == CT_STRUCT { return get_var_struct(rs) }
    if rt == CT_LIST { return list_elem_struct }
    if rt == CT_RESULT { return expr_result_ok_struct }
    if rt == CT_OPTION { return expr_option_inner_struct }
    ""
}

// Carrier element-type for a generic call argument: the inner type-kind to
// thread into infer_fn_type_args_from_types via arg_elem_types[fi]. For a
// List it's the element kind (carried by emit_expr in expr_list_elem_type);
// for a Result/Option carrier it's the ok/inner payload kind. Lets a generic
// `Result[T,E]`/`Option[T]` param infer T from an `Ok(7)`/`Some(7)` scalar arg.
pub fn arg_elem_type_for(rt: Int, list_elem: Int) -> Int {
    if rt == CT_RESULT { return expr_result_ok_type }
    if rt == CT_OPTION { return expr_option_inner }
    list_elem
}

// Err-side carrier for a Result call argument: the struct name / payload kind
// in the Err(...) position, threaded via GenericCallArgs.err_struct_names /
// err_elem_types so a generic `Result[T,E]` param can infer E. Option has no
// err position, so it contributes nothing.
pub fn arg_err_struct_name_for(rt: Int) -> Str {
    if rt == CT_RESULT { return expr_result_err_struct }
    ""
}
pub fn arg_err_elem_type_for(rt: Int) -> Int {
    if rt == CT_RESULT { return expr_result_err_type }
    CT_VOID
}

type ArgMapInfo {
    kt: Int
    ks: Str
    vt: Int
    vs: Str
}

// Carrier type for one side of a Result/Option from a type-annotation element
// name: a struct/enum name carries as CT_INT with struct_name set; everything
// else carries as `fallback` with no struct.
fn carrier_from_elem_name(name: Str, fallback: Int, ann_node: Int) -> CarrierInfo {
    if is_struct_type(name) != 0 || is_enum_type(name) != 0 {
        // A generic struct INSTANCE side (Box[Int]) must carry its recursive mono
        // stem (Box_Int) by value, not the erased bare head (Box) — otherwise the
        // carrier typedef embeds `blink_Box ok` which is never typedef'd (1452w4).
        // The type-args live in ann_node's elements, invisible to the head name, so
        // recurse the annotation exactly like resolve_result_inner_tag.
        let mono = mono_name_from_ann(strip_module_qualifier(name), ann_node, -1, "", [])
        if mono != "" { return CarrierInfo { type_const: CT_INT, struct_name: mono } }
        return CarrierInfo { type_const: CT_INT, struct_name: name }
    }
    CarrierInfo { type_const: fallback, struct_name: "" }
}

// Carrier for one side of a Result whose annotation is an Option/Result
// (`Result[Option[T], E]` etc.). carrier_from_elem_name leaves such a side's
// struct_name empty because the annotation name ("Option"/"Result") is neither a
// struct nor an enum, which erases the carrier member to `blink_Result_option_…`
// (`void ok`/`void err`) — the member is embedded by value, so it needs the
// structured `Option_T`/`Result_.._..` tag. A `Map[K,V]` side is deliberately
// excluded: its carrier member is a uniform `blink_map*` regardless of tag, so
// the erased `map` tag is already correct and every other Map-result path (Err,
// reassignment) keeps it — upgrading only one side would diverge the carrier
// name and break assignment. Non-Option/Result sides are returned unchanged.
fn upgrade_compound_carrier(c: CarrierInfo, ann_node: Int) -> CarrierInfo {
    if c.struct_name != "" { return c }
    if ann_node == -1 { return c }
    let ct = type_from_name(node_name(ann_node))
    if ct != CT_OPTION && ct != CT_RESULT { return c }
    CarrierInfo { type_const: ct, struct_name: compound_name_from_ann(ann_node) }
}

// Select the kops element carrier (ct + sname) for a Set()/Map() constructor from
// its declared container annotation. `container` is "Set" or "Map". A struct-field
// initializer or call-arg supplies the type via cg_expect_arg_ann, not
// cg_let_target_ann (br 6ph073); prefer it, but only when it actually names the
// container — a let-RHS block-expr inside a call arg leaves cg_expect_arg_ann on the
// OUTER param (e.g. Int), which must not shadow the block-local `let s: Set[..] =`'s
// target. The string default (CT_STRING/"") is kept for an unresolved typevar
// (generic-struct field Set[T]/Map[K,_], which typecheck never monomorphizes);
// recover_elem_ct_from_arg corrects the kops downstream (br 6ph073/vbhc4x).
fn resolve_ctor_kops_elem(container: Str) -> CarrierInfo ! Codegen.Emit {
    let ann = if cg_expect_arg_ann != -1 && node_name(cg_expect_arg_ann) == container { cg_expect_arg_ann } else { cg_let_target_ann }
    if ann == -1 || node_name(ann) != container { return CarrierInfo { type_const: CT_STRING, struct_name: "" } }
    let ta_elems = node_elements(ann)
    if ta_elems == -1 || sublist_length(ta_elems) < 1 { return CarrierInfo { type_const: CT_STRING, struct_name: "" } }
    let e_ann = sublist_get(ta_elems, 0)
    let e_name = resolve_tparam_via_tid(node_name(e_ann), cg_mono_tparams_sl, cg_mono_concrete_args, cg_mono_arg_tids)
    if e_name == "Tuple" {
        return CarrierInfo { type_const: CT_VOID, struct_name: key_struct_sname_from_ann(e_ann) }
    }
    if kops_elem_is_concrete(e_name) {
        // A generic-fn mono over a tuple key reaches here with e_name already the
        // tuple C-name ("Tuple2_int_int") rather than the literal "Tuple", so the
        // branch above (which registers the tuple into the hash/eq derive lists)
        // is skipped. Register it here so kops_table_name resolves to a real
        // adapter instead of the BLINK_COMPILER_BUG sentinel (0sh55p).
        ensure_tuple_kops_key(e_name)
        return CarrierInfo { type_const: type_from_name(e_name), struct_name: e_name }
    }
    CarrierInfo { type_const: CT_STRING, struct_name: "" }
}

// Carrier for a just-emitted argument expression. Used when the carrier's
// annotation name is an unresolved generic param (e.g. the `E` in
// `Result[Int, E]`), so it can't name the concrete type — we recover it from
// the emitted value: a struct/enum value carries its name via get_var_struct/
// get_var_enum, everything else carries its scalar kind. Lets a generic
// `Result[T,E]` param infer E from the `Err(...)` arg's actual payload.
fn carrier_from_emitted(expr_str: Str, ct: Int) -> CarrierInfo {
    if ct == CT_STRUCT {
        let sn = get_var_struct(expr_str)
        if sn != "" { return CarrierInfo { type_const: CT_INT, struct_name: sn } }
    }
    if ct == CT_ENUM {
        let en = get_var_enum(expr_str)
        if en != "" { return CarrierInfo { type_const: CT_INT, struct_name: en } }
    }
    CarrierInfo { type_const: ct, struct_name: "" }
}

pub fn arg_map_info_for(arg_node: Int, rt: Int) -> ArgMapInfo {
    if rt != CT_MAP || node_kind(arg_node) != NodeKind.Ident {
        return ArgMapInfo { kt: -1, ks: "", vt: -1, vs: "" }
    }
    let nm = node_name(arg_node)
    ArgMapInfo { kt: get_map_key_type(nm), ks: get_map_key_struct(nm), vt: get_map_value_type(nm), vs: get_map_value_struct(nm) }
}

// Resolves the inner struct/enum name from the expected call-argument annotation
// (cg_expect_arg_ann) when it is `Option[Struct]`/`Result[Struct, _]`. Lets bare
// carrier constructors at a call site pick the parameter's expected carrier.
// Returns "" when there is no struct-typed carrier to adopt.
fn expect_arg_option_inner_struct() -> Str {
    if cg_expect_arg_ann == -1 { return "" }
    if node_name(cg_expect_arg_ann) != "Option" { return "" }
    let elems = node_elements(cg_expect_arg_ann)
    if elems == -1 || sublist_length(elems) < 1 { return "" }
    let inner_ann = sublist_get(elems, 0)
    let inner = node_name(inner_ann)
    if is_struct_type(inner) != 0 || is_enum_type(inner) != 0 { return inner }
    if is_compound_ct(type_from_name(inner)) != 0 || inner == "Tuple" {
        return compound_name_from_ann(inner_ann)
    }
    ""
}

// Returns the declared type-annotation node for field `fname` from a struct's
// field-def sublist `td_flds`, or -1 if the sublist is empty or the field
// isn't found. Used by emit_struct_lit to thread the field's expected carrier
// (e.g. Option[Str]) into emit_expr via cg_expect_arg_ann so a bare `None`
// field adopts it. Callers resolve `td_flds` once via
// `node_fields(find_type_def_node(sname))` rather than per field.
fn struct_field_type_ann(td_flds: Int, fname: Str) -> Int {
    if td_flds == -1 { return -1 }
    let mut fi = 0
    while fi < sublist_length(td_flds) {
        let f = sublist_get(td_flds, fi)
        if node_name(f) == fname {
            return node_value(f)
        }
        fi = fi + 1
    }
    -1
}

// When cg_expect_arg_ann is `Option[Prim]` with a primitive (non-struct,
// non-enum, non-compound) inner, returns that inner's C-type kind. Returns
// CT_VOID otherwise — including when the inner is a struct/enum (handled by
// expect_arg_option_inner_struct) or when there is no annotation. Lets a bare
// `None` adopt e.g. `Option[Str]`'s carrier instead of defaulting to int.
fn expect_arg_option_inner_ct() -> Int {
    if cg_expect_arg_ann == -1 { return CT_VOID }
    if node_name(cg_expect_arg_ann) != "Option" { return CT_VOID }
    let elems = node_elements(cg_expect_arg_ann)
    if elems == -1 || sublist_length(elems) < 1 { return CT_VOID }
    let inner_ann = sublist_get(elems, 0)
    let inner = node_name(inner_ann)
    if is_struct_or_enum_type(inner) != 0 { return CT_VOID }
    let inner_ct = type_from_name(inner)
    if is_compound_ct(inner_ct) != 0 { return CT_VOID }
    inner_ct
}

// Returns the closure-signature string for the i-th formal when it has a
// `fn(...)` type, otherwise "". Used by the Call-arg loops to hint the
// Ident arm that a bare-fn reference should be shimmed.
pub fn arg_fn_value_hint(params_sl: Int, i: Int) -> Str {
    if params_sl == -1 {
        return ""
    }
    if i < 0 || i >= sublist_length(params_sl) {
        return ""
    }
    let p = sublist_get(params_sl, i)
    if node_type_name(p) != "Fn" {
        return ""
    }
    let ta = node_type_ann(p)
    if ta == -1 {
        return ""
    }
    build_closure_sig_from_type_ann(ta)
}

// Returns the i-th callee parameter's type-annotation node, or -1.
pub fn arg_type_ann_at(params_sl: Int, i: Int) -> Int {
    if params_sl == -1 { return -1 }
    if i < 0 || i >= sublist_length(params_sl) { return -1 }
    node_type_ann(sublist_get(params_sl, i))
}

// Returns the element type-annotation of the enclosing `let`-target when it is
// `List[Elem]` (br 4yzsfc). Used by emit_list_lit to thread the declared element
// carrier into cg_expect_arg_ann so a bare `None`/`Ok`/`Err` literal element
// adopts it. Returns -1 when there is no List-typed let target.
fn list_lit_elem_ann() -> Int {
    if cg_let_target_ann == -1 { return -1 }
    if node_name(cg_let_target_ann) != "List" { return -1 }
    let elems = node_elements(cg_let_target_ann)
    if elems == -1 || sublist_length(elems) < 1 { return -1 }
    sublist_get(elems, 0)
}

// When cg_expect_arg_ann is `Result[Ok, Err]`, returns the element annotation at
// `slot` (0 = Ok, 1 = Err), else -1. Lets Ok/Err constructors at a call site
// adopt the parameter's expected Result inner types.
fn expect_arg_result_elem(slot: Int) -> Int {
    let ann = if cg_expect_arg_ann != -1 { cg_expect_arg_ann } else { cg_let_target_ann }
    if ann == -1 { return -1 }
    if node_name(ann) != "Result" { return -1 }
    let elems = node_elements(ann)
    if elems == -1 || sublist_length(elems) < 2 { return -1 }
    sublist_get(elems, slot)
}

// Bind a generic fn's struct/tuple return into a temp so the caller's
// `let x = call()` sees a concrete struct type, and write the expr_result
// globals. Shared by the tuple-return and plain struct/enum-return paths.
fn emit_generic_struct_ret_temp(mangled: Str, struct_name: Str, temp_prefix: Str, call_args: Str) ! Codegen.Emit, Codegen.Register, Codegen.Scope {
    reg_fn_struct_ret(mangled, struct_name)
    let g_tmp = fresh_temp(temp_prefix)
    emit_line("{c_type_c_name(struct_name)} {g_tmp} = {c_fn_name(mangled)}({call_args});")
    set_var(g_tmp, CT_STRUCT, 0)
    set_var_struct(g_tmp, struct_name)
    expr_result_str = g_tmp
    expr_result_type = CT_STRUCT
}

// Slot-aligned resolver for building a mono-args CSV element-by-element off a
// struct/tuple/return INSTANCE tid. `slot_tids` comes from
// mono_instance_arg_tids_from_tid, which is aligned to the ANNOTATION's arg
// positions (slot i = the type's i-th `[...]` arg) — NOT to the enclosing fn's
// tparams_sl. So index it by the element position `ai`, not by the type-param's
// position; using resolve_tparam_via_tid here would misread the tid when the
// annotation permutes the fn's type params (e.g. `fn f[A,B]() -> Pair[B,A]`).
// Byte-parity: for an encodable slot tc_seg_from_tid reproduces resolve_tparam's
// CSV segment; else fall back to the string path keyed on the same element.
fn resolve_arg_seg_via_slot_tid(ai: Int, raw_name: Str, tparams_sl: Int, concrete_args: Str, slot_tids: List[Int]) -> Str {
    if ai < slot_tids.len() {
        let seg = tc_seg_from_tid(slot_tids.get(ai).unwrap())
        if seg.is_some() {
            return seg.unwrap()
        }
    }
    resolve_tparam(raw_name, tparams_sl, concrete_args)
}

// Lower an arg_tids list (aligned to a fn/type's tparams_sl) into the pre-resolved
// segment list the codegen_types trio (resolve_tuple_ann / mono_name_from_ann /
// struct_concrete_args_from_target) consumes via resolve_tparam_seg. Slot pi holds
// the concrete C-tag segment when arg_tids[pi] is encodable, else "" (the trio then
// falls back to the string CSV for that slot). Lives here — not in codegen_types —
// because tc_seg_from_tid is a typecheck fn and codegen_types sits below typecheck
// in the import graph. Byte-parity: tc_seg_from_tid reproduces resolve_tparam's CSV
// segment for every encodable slot, so feeding these segments to the trio matches
// the string path exactly (the same invariant resolve_tparam_via_tid relies on).
pub fn segs_from_arg_tids(arg_tids: List[Int]) -> List[Str] {
    let mut segs: List[Str] = []
    let mut i = 0
    while i < arg_tids.len() {
        let seg = tc_seg_from_tid(arg_tids.get(i).unwrap())
        if seg.is_some() {
            segs.push(seg.unwrap())
        } else {
            segs.push("")
        }
        i = i + 1
    }
    segs
}

// Returns 0 if type-arg inference yields None so the caller can fall through
// to non-generic handling; on success registers the monomorphization, writes
// expr_result_str / expr_result_type plus container inner-type globals, and
// returns 1.
@allow(UnrestoredMutation, IncompleteStateRestore)
pub fn emit_generic_fn_call_tail(node: Int, fn_name: Str, args_str: Str, ca: GenericCallArgs) -> Int ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let gfn_node = get_generic_fn_node(fn_name)
    // Subtask C (7pfhc9): derive the monomorphization CSV from the structured
    // tids (tc_mono_csv) whenever they can express the binding; fall back to the
    // string-tag inference (infer_fn_type_args_from_types) only for the shapes
    // tids can't reach (generic user-struct param, closure-bound typevar, mono-
    // calls-mono, tuple arg). tc_mono_csv returns Some only when it is
    // byte-identical to the old path — tc_tid_encodable gates out every shape
    // that would diverge — so this switch keeps Gen1==Gen2 while making the tid
    // path the primary source: the qm01e7/295z9x/j9v92x compound-carrier cases
    // now flow through it structurally instead of the canonical_struct_tag
    // `_`-guess heuristic.
    let tid_csv = tc_mono_csv(node, gfn_node)
    let type_args = if tid_csv.is_some() { tid_csv } else { infer_fn_type_args_from_types(gfn_node, ca) }
    if type_args.is_none() {
        return 0
    }
    let ta_str = type_args.unwrap()
    let mangled = mangle_generic_name(fn_name, ta_str)
    // 0n07he Step 2b: carry the per-tparam concrete tids on EVERY slot the tid can
    // faithfully spell, whether the CSV came from the tid path (tc_mono_csv) or the
    // string-inference fallback (infer_fn_type_args_from_types). tc_mono_tids is
    // per-slot (a real tid for an encodable slot, -1 for a deferred one), unlike the
    // all-or-nothing tc_mono_csv — so it can upgrade the encodable slots of a CSV
    // that string-inference produced. Byte-parity hazard: tc_mono_tids aligns to
    // tc_resolve_tparam_seg's slot order, but the infer CSV is built by a DIFFERENT
    // walker, so the two could disagree on slot content/order for some shape. Guard
    // it: keep a slot's tid ONLY when tc_seg_from_tid reproduces THIS ta_str's
    // segment byte-for-byte (nth_type_arg), else -1 → the def side stays on the
    // string seg for that slot. Any residual divergence fails the Gen1==Gen2 gate
    // immediately. When tid_csv.is_some() this is a no-op re-confirmation of the
    // D1b invariant; when it is none, it is the coverage upgrade.
    let raw_tids = tc_mono_tids(node, gfn_node)
    let mut arg_tids: List[Int] = []
    let mut ti = 0
    while ti < raw_tids.len() {
        arg_tids.push(listop_slot_tid(raw_tids.get(ti).unwrap(), nth_type_arg(ta_str, ti)))
        ti = ti + 1
    }
    register_mono_fn(fn_name, ta_str, arg_tids)
    register_mono_instance(fn_name, ta_str, arg_tids)
    let segs = segs_from_arg_tids(arg_tids)
    let ret_str = node_return_type(gfn_node)
    let tparams_sl = node_type_params(gfn_node)
    let resolved_ret = resolve_tparam_via_tid(ret_str, tparams_sl, ta_str, arg_tids)
    // A bare-typevar return (`-> T`/`-> U`) bound to a compound resolves through
    // the string tag to a carrier name (Option_int / Result_int_str / Map_..)
    // whose type_from_name is CT_VOID — the tag has no `[` so the whole string
    // is its base (codegen_types.bl `_ => CT_VOID`). typecheck already computed
    // the correct substituted return tid and memoized it on the call node, so
    // reroute ret_type off CT_VOID onto the real carrier CT. Structural fix for
    // ma6n41 / tr5gcn (codegen-structured-tids epic). Only fires when the string
    // path failed AND the tid is a compound — every already-working shape (the
    // annotated `-> Option[T]` path below, tuples, structs) keeps its CT.
    let ret_tid = tc_lookup_node_tid(node)
    let tid_ct = tc_tid_ct(ret_tid)
    let ret_name_ct = type_from_name(resolved_ret)
    // `rerouted` records that ret_type was recovered from the memoized tid (bare
    // typevar bound to a compound), NOT from a genuine `-> Option`/`-> Result`/
    // `-> Map` annotation. The tid-recovery else branches below gate on it: a
    // bracketless `-> Option` (resolved_ret == "Option", type_from_name already
    // CT_OPTION) must stay the old no-op, not run tid recovery against a node
    // whose tid isn't an Option — else it would register a carrier keyed on the
    // -1 sentinel where the old code registered nothing.
    // CT_STRUCT joins the reroute set, but ONLY for a BARE-TYPEVAR return `-> T`
    // bound to a struct INSTANCE (`unbox(outer)` : Box[Int]): the string tag lowers
    // it to the mono name `Box_Int` whose type_from_name is CT_VOID (no `[`), so the
    // caller would type the result `void`. typecheck now substitutes T to the
    // concrete instance and memoizes it (br 8wyq1k), so the tid says CT_STRUCT;
    // reroute onto it and emit a struct-typed temp below (mirrors ma6n41's
    // Option/Result/Map recovery). The `resolved_ret != ret_str` guard confines this
    // to `-> T` (resolve_tparam substituted the whole return type): an ANNOTATED
    // struct return `-> Wrapper[T]` keeps ret_str=="Wrapper" unchanged and MUST stay
    // on the CT_VOID annotated-elements path below (which builds Wrapper_Int from the
    // annotation), not this arm (which would emit the bare base "Wrapper").
    let struct_reroute = tid_ct == CT_STRUCT && resolved_ret != ret_str
    let rerouted = ret_name_ct == CT_VOID && (tid_ct == CT_OPTION || tid_ct == CT_RESULT || tid_ct == CT_MAP || struct_reroute)
    let ret_type = if rerouted { tid_ct } else { ret_name_ct }
    let fn_eff_sl = node_effects(gfn_node)
    let fn_trusted = has_annotation(gfn_node, "trusted")
    reg_fn_with_effects(mangled, ret_type, fn_eff_sl, fn_trusted)
    let call_args = append_ev_arg(mangled, args_str)
    let mut map_ret_val_struct = ""
    let mut map_ret_key_struct = ""
    if ret_type == CT_OPTION {
        let ret_ann = node_type_ann(gfn_node)
        let ann_elems = if ret_ann != -1 { node_elements(ret_ann) } else { -1 }
        if ann_elems != -1 && sublist_length(ann_elems) >= 1 {
            let inner_ann = sublist_get(ann_elems, 0)
            let inner_name_raw = node_name(inner_ann)
            let inner_name = resolve_tparam_via_tid(inner_name_raw, tparams_sl, ta_str, arg_tids)
            let inner_ct = type_from_name(inner_name)
            expr_option_inner = inner_ct
            ensure_option_type(inner_ct)
            reg_fn_ret_type(mangled, CT_OPTION, inner_ct, -1)
            // A bare-typevar Option inner (`-> Option[T]`, T→LocBox[Int]) resolves
            // through the string tag to the mono-instance name `LocBox_Int`, which
            // is NOT is_struct_or_enum_type (only the bare `LocBox` is registered as
            // a struct) — so also admit a registered mono struct instance, else the
            // Option inner erases and the caller types the result Option_void
            // (br bd4mg6). is_mono_struct_instance recovers the registered instance.
            if inner_ct == CT_VOID && (is_struct_or_enum_type(inner_name) != 0 || is_mono_struct_instance(inner_name) != 0) {
                ensure_struct_option_type(inner_name)
                expr_option_inner_struct = inner_name
            }
        } else if rerouted {
            // Bare-typevar return `-> T` bound to Option[..]: no compound child
            // in the annotation, so recover the inner from the memoized tid,
            // mirroring the annotation path above (ma6n41 / tr5gcn). A struct/enum
            // inner MUST be normalized to CT_VOID + a non-empty struct name, EXACTLY
            // as the annotation path does (type_from_name(struct)==CT_VOID there):
            // tc_tid_option_inner_ct returns CT_STRUCT for a struct, which would
            // put a different inner CT into expr_option_inner / the fn-ret ledger
            // than the annotated path for the same shape.
            let raw_inner_ct = tc_tid_option_inner_ct(ret_tid)
            let inner_struct = tc_tid_option_inner_struct(ret_tid)
            let inner_ct = if inner_struct != "" { CT_VOID } else { raw_inner_ct }
            expr_option_inner = inner_ct
            ensure_option_type(inner_ct)
            reg_fn_ret_type(mangled, CT_OPTION, inner_ct, -1)
            if inner_struct != "" {
                ensure_struct_option_type(inner_struct)
                expr_option_inner_struct = inner_struct
            }
        }
    } else if ret_type == CT_RESULT {
        let ret_ann = node_type_ann(gfn_node)
        let ann_elems = if ret_ann != -1 { node_elements(ret_ann) } else { -1 }
        if ann_elems != -1 && sublist_length(ann_elems) >= 2 {
            let ok_ann = sublist_get(ann_elems, 0)
            let err_ann = sublist_get(ann_elems, 1)
            let ok_name = resolve_tparam_via_tid(node_name(ok_ann), tparams_sl, ta_str, arg_tids)
            let err_name = resolve_tparam_via_tid(node_name(err_ann), tparams_sl, ta_str, arg_tids)
            let ok_ct = type_from_name(ok_name)
            let err_ct = type_from_name(err_name)
            expr_result_ok_type = ok_ct
            expr_result_err_type = err_ct
            // Admit a registered mono struct instance (LocBox_Int) as a struct-typed
            // ok/err, symmetric to the Option branch: a bare-typevar Result inner
            // bound to a struct instance resolves to the mono-instance name, which
            // is not is_struct_or_enum_type (only the bare head is) (br bd4mg6).
            let ok_is_type = is_struct_or_enum_type(ok_name) != 0 || is_mono_struct_instance(ok_name) != 0
            let err_is_type = is_struct_or_enum_type(err_name) != 0 || is_mono_struct_instance(err_name) != 0
            if ok_is_type || err_is_type {
                let ok_s = if ok_is_type { ok_name } else { "" }
                let err_s = if err_is_type { err_name } else { "" }
                reg_fn_ret_struct_inner(mangled, ok_s, err_s)
                ensure_mixed_result_type(ok_ct, err_ct, ok_s, err_s)
                expr_result_ok_struct = ok_s
                expr_result_err_struct = err_s
            } else {
                ensure_result_type(ok_ct, err_ct)
                expr_result_ok_struct = ""
                expr_result_err_struct = ""
            }
            reg_fn_ret_type(mangled, CT_RESULT, ok_ct, err_ct)
        } else if rerouted {
            // Bare-typevar return `-> T` bound to Result[..]: recover ok/err
            // from the memoized tid, mirroring the annotation path (ma6n41). As in
            // the Option else, a struct/enum ok/err inner is normalized to CT_VOID
            // + a non-empty struct name so the ledger + expr_* globals match the
            // annotation path (which computes type_from_name(struct)==CT_VOID).
            let ok_s = tc_tid_result_ok_struct(ret_tid)
            let err_s = tc_tid_result_err_struct(ret_tid)
            let ok_ct = if ok_s != "" { CT_VOID } else { tc_tid_result_ok_ct(ret_tid) }
            let err_ct = if err_s != "" { CT_VOID } else { tc_tid_result_err_ct(ret_tid) }
            expr_result_ok_type = ok_ct
            expr_result_err_type = err_ct
            if ok_s != "" || err_s != "" {
                reg_fn_ret_struct_inner(mangled, ok_s, err_s)
                ensure_mixed_result_type(ok_ct, err_ct, ok_s, err_s)
                expr_result_ok_struct = ok_s
                expr_result_err_struct = err_s
            } else {
                ensure_result_type(ok_ct, err_ct)
                expr_result_ok_struct = ""
                expr_result_err_struct = ""
            }
            reg_fn_ret_type(mangled, CT_RESULT, ok_ct, err_ct)
        }
    } else if ret_type == CT_LIST {
        let ret_ann = node_type_ann(gfn_node)
        if ret_ann != -1 {
            let elems_sl = node_elements(ret_ann)
            if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
                let inner_ann = sublist_get(elems_sl, 0)
                let inner_name_raw = node_name(inner_ann)
                let inner_name = resolve_tparam_via_tid(inner_name_raw, tparams_sl, ta_str, arg_tids)
                expr_list_elem_type = type_from_name(inner_name)
            }
        }
    } else if ret_type == CT_MAP {
        let ret_ann = node_type_ann(gfn_node)
        let ann_elems = if ret_ann != -1 { node_elements(ret_ann) } else { -1 }
        if ann_elems != -1 && sublist_length(ann_elems) >= 2 {
            let k_ann = sublist_get(ann_elems, 0)
            let v_ann = sublist_get(ann_elems, 1)
            let k_name = resolve_tparam_via_tid(node_name(k_ann), tparams_sl, ta_str, arg_tids)
            let v_name = resolve_tparam_via_tid(node_name(v_ann), tparams_sl, ta_str, arg_tids)
            expr_map_key_type = type_from_name(k_name)
            expr_map_val_type = type_from_name(v_name)
            // An annotated generic Map return whose value is a struct INSTANCE
            // (`-> Map[Str, Box[T]]`) erases the value to bare "Box" otherwise, so
            // name.get(k) reads the pointer payload as a by-value struct (1452w4).
            // Recover the recursive value/key stems from the annotation's mono, in
            // the fn's mono context (tparams_sl/ta_str resolves the T binding).
            if is_struct_type(v_name) != 0 || is_enum_type(v_name) != 0 {
                map_ret_val_struct = mono_name_from_ann(strip_module_qualifier(v_name), v_ann, tparams_sl, ta_str, segs)
                if map_ret_val_struct == "" { map_ret_val_struct = strip_module_qualifier(v_name) }
                // mono_name_from_ann yields only the mangled NAME; the value
                // struct's mono instance was never registered, so its typedef was
                // never emitted and emit_struct_option_typedef fell through to
                // `void* value` (br h0n5qe). Register it here — rebuild mono_args
                // from the annotation elements (the CT_VOID-return precedent below)
                // and pass real arg tids off the return's value slot.
                register_map_elem_struct_mono(strip_module_qualifier(v_name), v_ann, tparams_sl, ta_str, tc_tid_map_val_tid(ret_tid))
            }
            if is_struct_type(k_name) != 0 || is_enum_type(k_name) != 0 {
                map_ret_key_struct = mono_name_from_ann(strip_module_qualifier(k_name), k_ann, tparams_sl, ta_str, segs)
                if map_ret_key_struct == "" { map_ret_key_struct = strip_module_qualifier(k_name) }
                register_map_elem_struct_mono(strip_module_qualifier(k_name), k_ann, tparams_sl, ta_str, tc_tid_map_key_tid(ret_tid))
            }
        } else if tid_ct == CT_MAP {
            // Bare-typevar return `-> T` bound to Map[K,V]: recover key/value
            // CTs from the memoized tid (ma6n41). Unlike Option/Result, a bare
            // typevar bound to Map does NOT reroute — Map's top-level carrier tag
            // erases to bare "Map", so type_from_name already yields CT_MAP and
            // `rerouted` is false. The distinguisher from a genuine unparameterized
            // `-> Map` is the tid: gate on tid_ct == CT_MAP (a real Map tid).
            // A blink_map* is element-agnostic at the C level, but expr_map_*_type
            // drives downstream method key boxing, so thread the real CTs through.
            // tc_tid_map_key_ct returns -1 for an unmappable key, matching the
            // "unset" default the downstream >= 0 gates already expect.
            expr_map_key_type = tc_tid_map_key_ct(ret_tid)
            expr_map_val_type = tc_tid_map_val_ct(ret_tid)
            // A generic-struct-INSTANCE Map value (Map[Str, Box[Int]] through a
            // bare-typevar return) loses its value struct otherwise, so `m2.get(k)`
            // returns Option_int and reads the pointer payload as a by-value struct
            // (1452w4). Register the recovered val/key structs on the map result
            // string; the let-binding's copy_map_value_meta carries them onto the var.
            map_ret_val_struct = tc_tid_map_val_struct(ret_tid)
            map_ret_key_struct = tc_tid_map_key_struct(ret_tid)
            // Like the annotated branch: the value/key struct mono instance was
            // never registered (the tc_tid_map_val_struct name is not enough), so
            // its typedef never emitted and the carrier erased to void*/bare-head
            // (br h0n5qe). Register off the memoized return tid's value/key slots —
            // this covers nested value structs (Box[Box[Int]]) because the slot
            // tid carries the full instance shape.
            register_map_elem_struct_mono_from_tid(tc_tid_map_val_tid(ret_tid))
            register_map_elem_struct_mono_from_tid(tc_tid_map_key_tid(ret_tid))
        }
    } else if ret_type == CT_STRUCT && rerouted {
        // Bare-typevar return `-> T` bound to a struct INSTANCE (unbox(outer) :
        // Box[Int]): the string mono path already resolved the return spelling to
        // the concrete mono name (`resolved_ret` == "Box_Int", the same symbol the
        // fn was mangled under). Emit a struct-typed temp so the caller's
        // `let got = call()` sees CT_STRUCT + the mono struct name, exactly like the
        // non-generic struct-value reference path — instead of falling through to a
        // `void` binding (br 8wyq1k). Mirrors emit_generic_struct_ret_temp's use at
        // the annotated-tuple/plain-T sites below.
        emit_generic_struct_ret_temp(mangled, resolved_ret, "_gsr", call_args)
        return 1
    } else if ret_type == CT_VOID && resolved_ret != "Void" && resolved_ret != "" {
        let ret_ann = node_type_ann(gfn_node)
        // Generic fn returning a tuple: route through resolve_tuple_ann so the
        // caller binds the canonical tuple name (with Option[T] preserved)
        // instead of treating it as a generic struct and dropping the type arg
        // (bug 295z9x, Site A).
        if resolved_ret == "Tuple" && ret_ann != -1 {
            let tup_opt = resolve_tuple_ann(ret_ann, tparams_sl, ta_str, segs)
            if tup_opt.is_some() {
                emit_generic_struct_ret_temp(mangled, tup_opt.unwrap(), "_gtr", call_args)
                return 1
            }
        }
        let mut ret_struct_name = ""
        if ret_ann != -1 {
            let ret_elems = node_elements(ret_ann)
            if ret_elems != -1 && sublist_length(ret_elems) > 0 {
                let ret_arg_tids = mono_instance_arg_tids_from_tid(ret_tid, resolved_ret, sublist_length(ret_elems))
                let mut mono_args = ""
                let mut ai = 0
                while ai < sublist_length(ret_elems) {
                    let elem = sublist_get(ret_elems, ai)
                    let raw_name = node_name(elem)
                    let resolved_arg = resolve_arg_seg_via_slot_tid(ai, raw_name, tparams_sl, ta_str, ret_arg_tids)
                    if ai > 0 {
                        mono_args = mono_args.concat(",")
                    }
                    mono_args = mono_args.concat(resolved_arg)
                    ai = ai + 1
                }
                ret_struct_name = register_mono_instance(resolved_ret, mono_args, ret_arg_tids)
                set_var_struct("{c_fn_name(mangled)}({call_args})", ret_struct_name)
            }
        }
        // Plain T → user struct/enum: emit a temp + struct binding so the
        // caller's `let x = call()` sees a concrete struct type.
        if ret_struct_name == "" && is_struct_or_enum_type(resolved_ret) != 0 {
            emit_generic_struct_ret_temp(mangled, resolved_ret, "_gsr", call_args)
            return 1
        }
    }
    expr_result_str = "{c_fn_name(mangled)}({call_args})"
    expr_result_type = ret_type
    // Always publish the map value/key struct globals (empty for a non-map or a
    // scalar-valued map) so a struct-valued map call never leaks its stem into the
    // NEXT map binding — mirrors the plain-fn path's unconditional struct resets
    // (expr_result_ok_struct/expr_option_inner_struct) at emit_call (1452w4).
    expr_map_val_struct = map_ret_val_struct
    expr_map_key_struct = map_ret_key_struct
    1
}

// Emit `int <eq_var> = 1;` followed by per-field comparisons for a struct payload
// reached via the C accessor prefix `lhs`/`rhs` (e.g. "_left.ok" / "_left.value").
// `accessor_op` is "." for inline struct values (Result arms) or "->" for pointer
// payloads (struct Option). Comparator per field:
//   - CT_STRING        → blink_str_eq (content, not the char* pointer — zdczwc)
//   - nested aggregate → per-field memcmp (sf.stype != "": the field is an inline
//                        struct/data-enum value; C `!=` is illegal on aggregates,
//                        so shallow-compare its bytes — matches the old behavior)
//   - scalar/ptr       → `!=`
fn emit_struct_field_eq(eq_var: Str, struct_name: Str, lhs: Str, rhs: Str, accessor_op: Str) ! Codegen.Emit {
    emit_line("int {eq_var} = 1;")
    let mut si = 0
    while si < sf_entries.len() {
        let sf = sf_entries.get(si).unwrap()
        if sf.struct_name == struct_name {
            let lf = "{lhs}{accessor_op}{sf.field_name}"
            let rf = "{rhs}{accessor_op}{sf.field_name}"
            if sf.field_type == CT_STRING {
                emit_line("if (!blink_str_eq({lf}, {rf})) {eq_var} = 0;")
            } else if sf.stype != "" {
                emit_line("if (memcmp(&{lf}, &{rf}, sizeof({lf})) != 0) {eq_var} = 0;")
            } else {
                emit_line("if ({lf} != {rf}) {eq_var} = 0;")
            }
        }
        si = si + 1
    }
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_call(node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let func_node = node_left(node)
    let func_kind = node_kind(func_node)
    if func_kind == NodeKind.Ident {
        let fn_name = resolve_import_alias(node_name(func_node))
        let call_line = node_line(func_node)

        if fn_name == "Raw" {
            let args_sl = node_args(node)
            if args_sl != -1 && sublist_length(args_sl) > 0 {
                emit_expr(sublist_get(args_sl, 0))
            }
            return
        }

        if fn_name == "skip" {
            emit_skip_intrinsic(sublist_get(node_args(node), 0))
            return
        }

        if fn_name == "assert" {
            let args_sl = node_args(node)
            if args_sl != -1 && sublist_length(args_sl) > 0 {
                let cond_node = sublist_get(args_sl, 0)
                let cond_kind = node_kind(cond_node)
                let cond_op = if cond_kind == NodeKind.BinOp { node_op(cond_node) } else { "" }
                let decompose = if cond_kind == NodeKind.BinOp { pa_op_renderable(cond_op) } else { 0 }

                let assert_src = "assert({format_expr(cond_node)})"
                let assert_src_lit = escape_c_string(assert_src)
                let file_lit = panic_file_for(func_node)
                let call_col = node_col(func_node)

                emit_line("\{")
                cg_indent = cg_indent + 1

                let mut intro_fmt = ""
                let mut intro_arg_list = ""
                let mut cond_c_expr = ""

                if decompose != 0 {
                    let lhs = node_left(cond_node)
                    let rhs = node_right(cond_node)
                    let lhs_src = format_expr(lhs)
                    let rhs_src = format_expr(rhs)

                    // Emit operands speculatively to learn their CTs.
                    let pre_len = cg_lines.len()
                    emit_expr(lhs)
                    let lhs_c = expr_result_str
                    let lhs_ct = expr_result_type
                    emit_expr(rhs)
                    let rhs_c = expr_result_str
                    let rhs_ct = expr_result_type

                    // Only decompose a relational/equality comparison when both
                    // operands are scalar/Str-renderable. Aggregate operands
                    // (struct, enum, Option, Bytes, Instant/Duration) have no
                    // raw-C compare and no %-format, so the whole (already
                    // Eq/Ord-desugared) condition must be emitted instead — &&/||
                    // always decompose as before (vfgp72).
                    let renderable = pa_ct_renderable(lhs_ct) != 0 && pa_ct_renderable(rhs_ct) != 0
                    let logical = cond_op == "&&" || cond_op == "||"
                    if renderable != 0 || logical != 0 {
                        let lhs_tmp = fresh_temp("_pa_l")
                        let rhs_tmp = fresh_temp("_pa_r")
                        emit_line("{c_type_str(lhs_ct)} {lhs_tmp} = ({lhs_c});")
                        emit_line("{c_type_str(rhs_ct)} {rhs_tmp} = ({rhs_c});")

                        if lhs_ct == CT_STRING && rhs_ct == CT_STRING && (cond_op == "==" || cond_op == "!=") {
                            let neg = if cond_op == "!=" { "!" } else { "" }
                            cond_c_expr = "{neg}blink_str_eq({lhs_tmp}, {rhs_tmp})"
                        } else if lhs_ct == CT_STRING && rhs_ct == CT_STRING && (cond_op == "<" || cond_op == "<=" || cond_op == ">" || cond_op == ">=") {
                            cond_c_expr = "(blink_str_cmp({lhs_tmp}, {rhs_tmp}) {cond_op} 0)"
                        } else {
                            cond_c_expr = "({lhs_tmp}) {cond_op} ({rhs_tmp})"
                        }

                        intro_fmt = "{pa_intro_line(lhs_src, lhs_ct)}\\n{pa_intro_line(rhs_src, rhs_ct)}"
                        intro_arg_list = ", {pa_fmt_for_ct(lhs_tmp, lhs_ct)}, {pa_fmt_for_ct(rhs_tmp, rhs_ct)}"
                    } else {
                        // Discard the speculative operand emission and emit the
                        // full condition through emit_binop (Eq/Ord desugaring).
                        let mut di = cg_lines.len() - 1
                        while di >= pre_len {
                            cg_lines.pop()
                            di = di - 1
                        }
                        emit_expr(cond_node)
                        cond_c_expr = expr_result_str
                    }
                } else {
                    emit_expr(cond_node)
                    cond_c_expr = expr_result_str
                }

                emit_line("int64_t _val = (int64_t)({cond_c_expr});")
                emit_line("if (!_val) \{")
                cg_indent = cg_indent + 1

                let mut user_msg_c = "\"\""
                if sublist_length(args_sl) >= 2 {
                    emit_expr(sublist_get(args_sl, 1))
                    user_msg_c = expr_result_str
                }

                if intro_fmt != "" {
                    let intro_tmp = fresh_temp("_pa_intro")
                    emit_line("char {intro_tmp}[BLINK_PA_INTRO_BUF_SIZE];")
                    emit_line("snprintf({intro_tmp}, BLINK_PA_INTRO_BUF_SIZE, \"{intro_fmt}\"{intro_arg_list});")
                    emit_line("__blink_assert_fail_intro(\"{assert_src_lit}\", {intro_tmp}, \"{file_lit}\", {call_line}, {call_col}, {user_msg_c});")
                } else {
                    emit_line("__blink_assert_fail_intro(\"{assert_src_lit}\", \"\", \"{file_lit}\", {call_line}, {call_col}, {user_msg_c});")
                }
                cg_indent = cg_indent - 1
                emit_line("}")
                cg_indent = cg_indent - 1
                emit_line("}")
            }
            expr_result_str = ""
            expr_result_type = CT_VOID
            return
        }

        if fn_name == "debug_assert" {
            let args_sl = node_args(node)
            if cg_debug_mode == 0 {
                expr_result_str = ""
                expr_result_type = CT_VOID
                return
            }
            if args_sl != -1 && sublist_length(args_sl) > 0 {
                emit_expr(sublist_get(args_sl, 0))
                let cond_str = expr_result_str
                emit_line("\{")
                cg_indent = cg_indent + 1
                emit_line("int64_t _dbg_val = (int64_t)({cond_str});")
                emit_line("if (!_dbg_val) \{")
                cg_indent = cg_indent + 1
                let mut msg_str = "\"debug assertion failed\""
                if sublist_length(args_sl) >= 2 {
                    emit_expr(sublist_get(args_sl, 1))
                    msg_str = expr_result_str
                }
                let dbg_file = panic_file_for(func_node)
                emit_line("__blink_debug_assert_fail(\"{dbg_file}\", {call_line}, \"{cg_current_fn_name}\", \"{cond_str}\", {msg_str});")
                cg_indent = cg_indent - 1
                emit_line("}")
                cg_indent = cg_indent - 1
                emit_line("}")
            }
            expr_result_str = ""
            expr_result_type = CT_VOID
            return
        }

        if fn_name == "assert_eq" {
            let args_sl = node_args(node)
            if args_sl != -1 && sublist_length(args_sl) >= 2 {
                emit_expr(sublist_get(args_sl, 0))
                let left_str = expr_result_str
                let left_type = expr_result_type
                let left_ok = expr_result_ok_type
                let left_err = expr_result_err_type
                let left_ok_s = expr_result_ok_struct
                let left_err_s = expr_result_err_struct
                let left_opt_inner = expr_option_inner
                let left_opt_inner_s = expr_option_inner_struct
                let left_struct = get_var_struct(left_str)
                emit_expr(sublist_get(args_sl, 1))
                let right_str = expr_result_str
                emit_line("\{")
                cg_indent = cg_indent + 1
                if left_type == CT_STRING {
                    emit_line("const char* _left = {left_str};")
                    emit_line("const char* _right = {right_str};")
                    emit_line("if (!blink_str_eq(_left, _right)) \{")
                    cg_indent = cg_indent + 1
                    let msg_tmp1 = fresh_temp("_msg")
                    let exp_tmp1 = fresh_temp("_exp")
                    let act_tmp1 = fresh_temp("_act")
                    emit_line("char {msg_tmp1}[512];")
                    emit_line("snprintf({msg_tmp1}, 512, \"ASSERT_EQ FAILED: \\\"%%s\\\" != \\\"%%s\\\"\", _left, _right);")
                    emit_line("char {exp_tmp1}[256]; char {act_tmp1}[256];")
                    emit_line("snprintf({exp_tmp1}, 256, \"%%s\", _right);")
                    emit_line("snprintf({act_tmp1}, 256, \"%%s\", _left);")
                    emit_line("__blink_assert_fail_eq({msg_tmp1}, {exp_tmp1}, {act_tmp1}, {call_line});")
                    cg_indent = cg_indent - 1
                    emit_line("}")
                } else if left_type == CT_FLOAT {
                    emit_line("double _left = (double)({left_str});")
                    emit_line("double _right = (double)({right_str});")
                    emit_line("if (_left != _right) \{")
                    cg_indent = cg_indent + 1
                    let msg_tmp3 = fresh_temp("_msg")
                    let exp_tmp3 = fresh_temp("_exp")
                    let act_tmp3 = fresh_temp("_act")
                    emit_line("char {msg_tmp3}[256];")
                    emit_line("snprintf({msg_tmp3}, 256, \"ASSERT_EQ FAILED: %%f != %%f\", _left, _right);")
                    emit_line("char {exp_tmp3}[256]; char {act_tmp3}[256];")
                    emit_line("snprintf({exp_tmp3}, 256, \"%%f\", _right);")
                    emit_line("snprintf({act_tmp3}, 256, \"%%f\", _left);")
                    emit_line("__blink_assert_fail_eq({msg_tmp3}, {exp_tmp3}, {act_tmp3}, {call_line});")
                    cg_indent = cg_indent - 1
                    emit_line("}")
                } else if left_type == CT_RESULT {
                    let res_c = if left_ok_s != "" || left_err_s != "" {
                        result_c_type_mixed(left_ok, left_err, left_ok_s, left_err_s)
                    } else {
                        result_c_type(left_ok, left_err)
                    }
                    emit_line("{res_c} _left = {left_str};")
                    emit_line("{res_c} _right = {right_str};")
                    // 6d1913: tag-first, then compare only the ACTIVE arm. A
                    // whole-struct memcmp over the union reads junk in the
                    // inactive arm and falsely reports equal values unequal. Pick
                    // the comparator per arm type: String → blink_str_eq, struct →
                    // field-wise (zdczwc: memcmp compared char* pointers of Str
                    // fields, not contents), other scalar/ptr/void → `!=`. (Ok =
                    // tag 0, Err = tag 1; CT_VOID arms lower to int64_t storage so
                    // the scalar `!=` form is correct for them.)
                    if left_ok_s != "" || left_err_s != "" {
                        // zdczwc: a struct arm needs field-wise comparison, which
                        // is statements not an expression — emit a tag-first
                        // dispatch and fold the active arm's result into _eq.
                        let eq_v = fresh_temp("_eq")
                        emit_line("int {eq_v} = 1;")
                        emit_line("if (_left.tag != _right.tag) \{ {eq_v} = 0; \}")
                        emit_line("else if (_left.tag == 0) \{")
                        cg_indent = cg_indent + 1
                        if left_ok_s != "" {
                            let eq_ok = fresh_temp("_eqok")
                            emit_struct_field_eq(eq_ok, left_ok_s, "_left.ok", "_right.ok", ".")
                            emit_line("if (!{eq_ok}) {eq_v} = 0;")
                        } else if left_ok == CT_STRING {
                            emit_line("if (!blink_str_eq(_left.ok, _right.ok)) {eq_v} = 0;")
                        } else {
                            emit_line("if (_left.ok != _right.ok) {eq_v} = 0;")
                        }
                        cg_indent = cg_indent - 1
                        emit_line("} else \{")
                        cg_indent = cg_indent + 1
                        if left_err_s != "" {
                            let eq_err = fresh_temp("_eqerr")
                            emit_struct_field_eq(eq_err, left_err_s, "_left.err", "_right.err", ".")
                            emit_line("if (!{eq_err}) {eq_v} = 0;")
                        } else if left_err == CT_STRING {
                            emit_line("if (!blink_str_eq(_left.err, _right.err)) {eq_v} = 0;")
                        } else {
                            emit_line("if (_left.err != _right.err) {eq_v} = 0;")
                        }
                        cg_indent = cg_indent - 1
                        emit_line("}")
                        emit_line("if (!{eq_v}) \{")
                    } else {
                        let ok_cmp = if left_ok == CT_STRING {
                            "!blink_str_eq(_left.ok, _right.ok)"
                        } else {
                            "_left.ok != _right.ok"
                        }
                        let err_cmp = if left_err == CT_STRING {
                            "!blink_str_eq(_left.err, _right.err)"
                        } else {
                            "_left.err != _right.err"
                        }
                        emit_line("if (_left.tag != _right.tag || (_left.tag == 0 ? ({ok_cmp}) : ({err_cmp}))) \{")
                    }
                    cg_indent = cg_indent + 1
                    let msg_tmp4 = fresh_temp("_msg")
                    let exp_tmp4 = fresh_temp("_exp")
                    let act_tmp4 = fresh_temp("_act")
                    emit_line("char {msg_tmp4}[256];")
                    emit_line("snprintf({msg_tmp4}, 256, \"ASSERT_EQ FAILED: Result values differ (tag %%lld vs %%lld)\", (long long)_left.tag, (long long)_right.tag);")
                    emit_line("char {exp_tmp4}[256]; char {act_tmp4}[256];")
                    emit_line("snprintf({exp_tmp4}, 256, \"Result tag %%lld\", (long long)_right.tag);")
                    emit_line("snprintf({act_tmp4}, 256, \"Result tag %%lld\", (long long)_left.tag);")
                    emit_line("__blink_assert_fail_eq({msg_tmp4}, {exp_tmp4}, {act_tmp4}, {call_line});")
                    cg_indent = cg_indent - 1
                    emit_line("}")
                } else if left_type == CT_OPTION {
                    let opt_c = if left_opt_inner_s != "" {
                        struct_option_c_type(left_opt_inner_s)
                    } else {
                        option_c_type(left_opt_inner)
                    }
                    emit_line("{opt_c} _left = {left_str};")
                    emit_line("{opt_c} _right = {right_str};")
                    if left_opt_inner_s != "" {
                        // zdczwc: struct Some payload is a pointer (inner_c* value),
                        // so deref with -> and compare field-wise — only when both
                        // are Some (tag 1), since a None has no payload to deref.
                        // memcmp here compared the char* pointers of Str fields, not
                        // their contents, falsely reporting content-equal unequal.
                        let eq_v = fresh_temp("_eq")
                        emit_line("int {eq_v} = 1;")
                        emit_line("if (_left.tag != _right.tag) \{ {eq_v} = 0; \}")
                        emit_line("else if (_left.tag == 1) \{")
                        cg_indent = cg_indent + 1
                        let eq_val = fresh_temp("_eqv")
                        emit_struct_field_eq(eq_val, left_opt_inner_s, "_left.value", "_right.value", "->")
                        emit_line("if (!{eq_val}) {eq_v} = 0;")
                        cg_indent = cg_indent - 1
                        emit_line("}")
                        emit_line("if (!{eq_v}) \{")
                    } else {
                        // 6d1913: tag-first, then compare only the active (Some)
                        // arm's scalar value. A whole-struct memcmp reads junk in
                        // the `value` slot of a None (tag 0) and falsely reports
                        // two Nones unequal. Scalar branch ⇒ scalar inner, so `!=`
                        // is valid (mirrors the float != path).
                        emit_line("if (_left.tag != _right.tag || (_left.tag == 1 && _left.value != _right.value)) \{")
                    }
                    cg_indent = cg_indent + 1
                    let msg_tmp5 = fresh_temp("_msg")
                    let exp_tmp5 = fresh_temp("_exp")
                    let act_tmp5 = fresh_temp("_act")
                    emit_line("char {msg_tmp5}[256];")
                    emit_line("snprintf({msg_tmp5}, 256, \"ASSERT_EQ FAILED: Option values differ (tag %%lld vs %%lld)\", (long long)_left.tag, (long long)_right.tag);")
                    emit_line("char {exp_tmp5}[256]; char {act_tmp5}[256];")
                    emit_line("snprintf({exp_tmp5}, 256, \"Option tag %%lld\", (long long)_right.tag);")
                    emit_line("snprintf({act_tmp5}, 256, \"Option tag %%lld\", (long long)_left.tag);")
                    emit_line("__blink_assert_fail_eq({msg_tmp5}, {exp_tmp5}, {act_tmp5}, {call_line});")
                    cg_indent = cg_indent - 1
                    emit_line("}")
                } else if left_struct != "" && is_struct_type(left_struct) != 0 {
                    let struct_c = c_type_c_name(left_struct)
                    emit_line("{struct_c} _left = {left_str};")
                    emit_line("{struct_c} _right = {right_str};")
                    emit_line("int _eq = 1;")
                    let mut si = 0
                    while si < sf_entries.len() {
                        let sf = sf_entries.get(si).unwrap()
                        if sf.struct_name == left_struct {
                            if sf.field_type == CT_STRING {
                                emit_line("if (!blink_str_eq(_left.{sf.field_name}, _right.{sf.field_name})) _eq = 0;")
                            } else {
                                emit_line("if (_left.{sf.field_name} != _right.{sf.field_name}) _eq = 0;")
                            }
                        }
                        si = si + 1
                    }
                    emit_line("if (!_eq) \{")
                    cg_indent = cg_indent + 1
                    let msg_tmp6 = fresh_temp("_msg")
                    emit_line("char {msg_tmp6}[256];")
                    emit_line("snprintf({msg_tmp6}, 256, \"ASSERT_EQ FAILED: {left_struct} values differ\");")
                    // No per-field Display rendering is available at this site, so
                    // there is no distinct expected/actual to emit — identical
                    // placeholders would be noise (spec §8.10 wants discriminating
                    // values). Fall back to the plain path, which clears
                    // expected/actual so the JSON omits them.
                    emit_line("__blink_assert_fail({msg_tmp6}, {call_line});")
                    cg_indent = cg_indent - 1
                    emit_line("}")
                } else {
                    emit_line("int64_t _left = (int64_t)({left_str});")
                    emit_line("int64_t _right = (int64_t)({right_str});")
                    emit_line("if (_left != _right) \{")
                    cg_indent = cg_indent + 1
                    let msg_tmp2 = fresh_temp("_msg")
                    let exp_tmp2 = fresh_temp("_exp")
                    let act_tmp2 = fresh_temp("_act")
                    emit_line("char {msg_tmp2}[256];")
                    emit_line("snprintf({msg_tmp2}, 256, \"ASSERT_EQ FAILED: %%lld != %%lld\", (long long)_left, (long long)_right);")
                    emit_line("char {exp_tmp2}[256]; char {act_tmp2}[256];")
                    emit_line("snprintf({exp_tmp2}, 256, \"%%lld\", (long long)_right);")
                    emit_line("snprintf({act_tmp2}, 256, \"%%lld\", (long long)_left);")
                    emit_line("__blink_assert_fail_eq({msg_tmp2}, {exp_tmp2}, {act_tmp2}, {call_line});")
                    cg_indent = cg_indent - 1
                    emit_line("}")
                }
                cg_indent = cg_indent - 1
                emit_line("}")
            }
            expr_result_str = ""
            expr_result_type = CT_VOID
            return
        }

        if fn_name == "assert_ne" {
            let args_sl = node_args(node)
            if args_sl != -1 && sublist_length(args_sl) >= 2 {
                emit_expr(sublist_get(args_sl, 0))
                let left_str = expr_result_str
                let left_type = expr_result_type
                let left_ne_struct = get_var_struct(left_str)
                emit_expr(sublist_get(args_sl, 1))
                let right_str = expr_result_str
                emit_line("\{")
                cg_indent = cg_indent + 1
                if left_type == CT_STRING {
                    emit_line("const char* _left = {left_str};")
                    emit_line("const char* _right = {right_str};")
                    emit_line("if (blink_str_eq(_left, _right)) \{")
                    cg_indent = cg_indent + 1
                    let msg_tmp1 = fresh_temp("_msg")
                    emit_line("char {msg_tmp1}[512];")
                    emit_line("snprintf({msg_tmp1}, 512, \"ASSERT_NE FAILED: \\\"%%s\\\" == \\\"%%s\\\"\", _left, _right);")
                    emit_line("__blink_assert_fail({msg_tmp1}, {call_line});")
                    cg_indent = cg_indent - 1
                    emit_line("}")
                } else if left_type == CT_FLOAT {
                    emit_line("double _left = (double)({left_str});")
                    emit_line("double _right = (double)({right_str});")
                    emit_line("if (_left == _right) \{")
                    cg_indent = cg_indent + 1
                    let msg_tmp3 = fresh_temp("_msg")
                    emit_line("char {msg_tmp3}[256];")
                    emit_line("snprintf({msg_tmp3}, 256, \"ASSERT_NE FAILED: %%f == %%f\", _left, _right);")
                    emit_line("__blink_assert_fail({msg_tmp3}, {call_line});")
                    cg_indent = cg_indent - 1
                    emit_line("}")
                } else if left_ne_struct != "" && is_struct_type(left_ne_struct) != 0 {
                    let struct_c = c_type_c_name(left_ne_struct)
                    emit_line("{struct_c} _left = {left_str};")
                    emit_line("{struct_c} _right = {right_str};")
                    emit_line("int _eq = 1;")
                    let mut si = 0
                    while si < sf_entries.len() {
                        let sf = sf_entries.get(si).unwrap()
                        if sf.struct_name == left_ne_struct {
                            let ft = sf.field_type
                            if ft == CT_STRING {
                                emit_line("if (!blink_str_eq(_left.{sf.field_name}, _right.{sf.field_name})) _eq = 0;")
                            } else {
                                emit_line("if (_left.{sf.field_name} != _right.{sf.field_name}) _eq = 0;")
                            }
                        }
                        si = si + 1
                    }
                    emit_line("if (_eq) \{")
                    cg_indent = cg_indent + 1
                    let msg_tmp6 = fresh_temp("_msg")
                    emit_line("char {msg_tmp6}[256];")
                    emit_line("snprintf({msg_tmp6}, 256, \"ASSERT_NE FAILED: {left_ne_struct} values are equal\");")
                    emit_line("__blink_assert_fail({msg_tmp6}, {call_line});")
                    cg_indent = cg_indent - 1
                    emit_line("}")
                } else {
                    emit_line("int64_t _left = (int64_t)({left_str});")
                    emit_line("int64_t _right = (int64_t)({right_str});")
                    emit_line("if (_left == _right) \{")
                    cg_indent = cg_indent + 1
                    let msg_tmp2 = fresh_temp("_msg")
                    emit_line("char {msg_tmp2}[256];")
                    emit_line("snprintf({msg_tmp2}, 256, \"ASSERT_NE FAILED: %%lld == %%lld\", (long long)_left, (long long)_right);")
                    emit_line("__blink_assert_fail({msg_tmp2}, {call_line});")
                    cg_indent = cg_indent - 1
                    emit_line("}")
                }
                cg_indent = cg_indent - 1
                emit_line("}")
            }
            expr_result_str = ""
            expr_result_type = CT_VOID
            return
        }

        let variant_enum = resolve_variant(fn_name)
        if variant_enum != "" && is_transparent_newtype(variant_enum) != 0 {
            // Transparent newtype (br ja9jev): the constructor lowers to its bare
            // scalar payload — `Errno(rc)` emits `rc` (an int64_t), not a tagged
            // struct. The carrier wrapping (`.err = <payload>`) then stores the
            // bare value into the transparent `int64_t err` member.
            let t_args = node_args(node)
            if t_args != -1 && sublist_length(t_args) > 0 {
                emit_expr(sublist_get(t_args, 0))
                expr_result_type = CT_INT
                return
            }
        }
        if variant_enum != "" && is_data_enum(variant_enum) != 0 {
            let vidx = get_variant_index(variant_enum, fn_name)
            let tag = get_variant_tag(variant_enum, fn_name)
            let fcount = get_variant_field_count(vidx)
            let args_sl = node_args(node)
            // A generic-enum instance (`Leaf(1)` → Tree[Int]) mono's to blink_Tree_Int;
            // mono_name is the STEM (Tree_Int) or "" for a non-generic enum, which keeps
            // the bare variant_enum name. Variant metadata (tag/field types) stays keyed
            // on the bare name (jjhnf3).
            let mono_name = register_mono_enum_from_node(node, variant_enum)
            let sname = if mono_name != "" { mono_name } else { variant_enum }
            let enum_c_name = c_type_c_name(sname)
            let mut init_str = "({enum_c_name})\{.tag = {tag}"
            if fcount > 0 && args_sl != -1 {
                init_str = init_str.concat(", .data.{fn_name} = \{")
                let mut fi = 0
                while fi < sublist_length(args_sl) && fi < fcount {
                    if fi > 0 {
                        init_str = init_str.concat(", ")
                    }
                    let field_name = get_variant_field_name(vidx, fi).unwrap()
                    let field_type = get_variant_field_type_str(vidx, fi).unwrap()
                    emit_expr(sublist_get(args_sl, fi))
                    let arg_str = expr_result_str
                    if strip_generic_args(field_type) == variant_enum {
                        let box_tmp = fresh_temp("_ebox")
                        emit_line("{enum_c_name}* {box_tmp} = ({enum_c_name}*)blink_alloc(sizeof({enum_c_name}));")
                        emit_line("*{box_tmp} = {arg_str};")
                        init_str = init_str.concat(".{field_name} = (int64_t)(intptr_t){box_tmp}")
                    } else {
                        init_str = init_str.concat(".{field_name} = {arg_str}")
                    }
                    fi = fi + 1
                }
                init_str = init_str.concat("}")
            }
            init_str = init_str.concat("}")
            expr_result_str = init_str
            expr_result_type = CT_STRUCT
            set_var_struct(init_str, sname)
            return
        }
        if fn_name == "Some" {
            let args_sl = node_args(node)
            if args_sl != -1 && sublist_length(args_sl) > 0 {
                // Resolve a transparent-newtype inner (e.g. Some(Errno(rc))) from
                // the arg node BEFORE emit_expr collapses its type to CT_INT. The
                // carrier stays Option_Errno with a bare int64_t value member (no
                // box), mirroring the transparent Result treatment (br e8n2n3).
                let mut transparent_enum = transparent_newtype_arg_enum(sublist_get(args_sl, 0))
                emit_expr(sublist_get(args_sl, 0))
                let inner_str = expr_result_str
                let inner_type = expr_result_type
                let inner_is_none = expr_option_is_none
                expr_option_is_none = 0
                // When the arg is a transparent-typed VARIABLE (e.g. `let e =
                // Errno(5); Some(e)`) the carve-out at emit_let_binding already
                // lowered `e` to a bare int64_t and cleared its enum tracking, so
                // transparent_newtype_arg_enum sees only a CT_INT Ident. Recover
                // the inner from the enclosing function's Option[Errno] return
                // annotation so the carrier still resolves to Option_Errno rather
                // than Option_int.
                if transparent_enum == "" && inner_type == CT_INT && cg_current_fn_node != -1 {
                    let ann_inner = option_inner_struct_from_fn(cg_current_fn_node)
                    if ann_inner != "" && is_transparent_newtype(ann_inner) != 0 {
                        transparent_enum = ann_inner
                    }
                }
                // Consult the live let-target annotation (`let x: Option[..] =
                // Some(..)`). emit_let_binding derives a STRUCTURED carrier name
                // from this same annotation for the declaration; the RHS Some cast
                // must match it or C reports "invalid initializer" over two
                // byte-identical-but-differently-named carriers (t5nvd4/kjpq9p).
                // The Ok/Err path already consults the annotation this way; this
                // brings Some to parity. Only fires when the annotation is present
                // (fn-return / bare-scalar paths leave ann_inner_name empty, so
                // their existing output is byte-identical).
                let mut ann_inner_name = ""
                if cg_let_target_ann != -1 && node_name(cg_let_target_ann) == "Option" {
                    let lt_elems = node_elements(cg_let_target_ann)
                    if lt_elems != -1 && sublist_length(lt_elems) >= 1 {
                        let lt_inner_ann = sublist_get(lt_elems, 0)
                        let lt_inner_name = node_name(lt_inner_ann)
                        let lt_inner_ct = type_from_name(lt_inner_name)
                        // Transparent-newtype scalar inner (kjpq9p): the arg reached
                        // Some as a CT_INT variable, so transparent_newtype_arg_enum
                        // and the fn-return recovery both missed it. Recover from the
                        // annotation using the UN-STRIPPED node_name — exactly what
                        // option_inner_struct_from_fn returns — so this mints the same
                        // carrier token as the enclosing-fn recovery above.
                        if transparent_enum == "" && inner_type == CT_INT && is_transparent_newtype(lt_inner_name) != 0 {
                            transparent_enum = lt_inner_name
                        } else if is_compound_ct(lt_inner_ct) != 0 || lt_inner_name == "Tuple" {
                            // Compound/Tuple inner (t5nvd4): compute the STRUCTURED
                            // name (Map_int_int, Option_int, ...) to feed the compound
                            // branch's carrier-name chain as its first preference.
                            ann_inner_name = compound_name_from_ann(lt_inner_ann)
                        }
                    }
                }
                if transparent_enum != "" {
                    ensure_struct_option_type(transparent_enum)
                    let opt_type = struct_option_c_type(transparent_enum)
                    expr_result_str = "({opt_type})\{.tag = 1, .value = {inner_str}}"
                    expr_result_type = CT_OPTION
                    expr_option_inner = inner_type
                    expr_option_inner_struct = transparent_enum
                    return
                }
                let mut inner_s = get_var_struct(inner_str)
                if inner_s == "" {
                    let ve_name = get_var_enum(inner_str)
                    if ve_name != "" && is_enum_type(ve_name) != 0 {
                        inner_s = ve_name
                    }
                }
                if inner_s != "" {
                    if cg_in_handler_body != 0 && cg_handler_body_is_ue != 0 && cg_current_fn_option_inner == CT_PTR {
                        ensure_option_type(CT_PTR)
                        let opt_type = option_c_type(CT_PTR)
                        let struct_c = c_type_c_name(inner_s)
                        let heap_tmp = fresh_temp("__ue_heap_")
                        emit_line("{struct_c}* {heap_tmp} = ({struct_c}*)blink_alloc(sizeof({struct_c}));")
                        emit_line("*{heap_tmp} = {inner_str};")
                        expr_result_str = "({opt_type})\{.tag = 1, .value = (void*){heap_tmp}}"
                        expr_result_type = CT_OPTION
                        expr_option_inner = CT_PTR
                        expr_option_inner_struct = inner_s
                    } else {
                        ensure_struct_option_type(inner_s)
                        let opt_type = struct_option_c_type(inner_s)
                        let struct_c = c_type_c_name(inner_s)
                        let box_tmp = fresh_temp("_sbox_")
                        emit_line("{struct_c}* {box_tmp} = ({struct_c}*)blink_alloc(sizeof({struct_c}));")
                        emit_line("*{box_tmp} = {inner_str};")
                        expr_result_str = "({opt_type})\{.tag = 1, .value = {box_tmp}}"
                        expr_result_type = CT_OPTION
                        expr_option_inner = inner_type
                        expr_option_inner_struct = inner_s
                    }
                } else if is_compound_ct(inner_type) != 0 {
                    let compound_name = if ann_inner_name != "" {
                        ann_inner_name
                    } else if inner_type == CT_OPTION && expr_option_inner_struct != "" {
                        expr_option_inner_struct
                    } else if inner_type == CT_OPTION {
                        let opt_tag = c_type_tag(expr_option_inner)
                        "Option_{opt_tag}"
                    } else if inner_type == CT_RESULT {
                        let ok_tag = if expr_result_ok_struct != "" { canonical_struct_tag(expr_result_ok_struct) } else { c_type_tag(expr_result_ok_type) }
                        let err_tag = if expr_result_err_struct != "" { canonical_struct_tag(expr_result_err_struct) } else { c_type_tag(expr_result_err_type) }
                        "Result_{ok_tag}_{err_tag}"
                    } else if inner_type == CT_MAP {
                        let fsi_s = get_fn_ret_struct_inner(cg_current_fn_name)
                        if fsi_s.ok_struct != "" && fsi_s.ok_struct.starts_with("Map_") {
                            fsi_s.ok_struct
                        } else {
                            // Spell the Map inner STRUCTURED (Map_{key}_{val}) so the value
                            // carrier (blink_Option_Map_str_int) matches the tuple field the
                            // tid path mints — compound_option_inner_name's bare "map" would
                            // diverge → void-erased mono param (br yavhwc). Mirror the
                            // tuple-lit CT_MAP arm: a scope-var map reads its key/val from the
                            // scope accessors (keyed by the raw Blink name); a call/field
                            // returned map reads the expr_map_* globals emit_expr just set.
                            let sm_var = c_blink_name(inner_str)
                            let mut sm_key_ct = expr_map_key_type
                            let mut sm_val_ct = expr_map_val_type
                            let mut sm_key_sn = expr_map_key_struct
                            let mut sm_val_sn = expr_map_val_struct
                            if is_scope_var(sm_var) != 0 {
                                sm_key_ct = get_map_key_type(sm_var)
                                sm_val_ct = get_map_value_type(sm_var)
                                sm_key_sn = get_map_key_struct(sm_var)
                                sm_val_sn = get_map_value_struct(sm_var)
                            }
                            let sm_key_tag = if sm_key_sn != "" { canonical_struct_tag(sm_key_sn) } else { c_type_tag(sm_key_ct) }
                            let sm_val_tag = if sm_val_sn != "" { canonical_struct_tag(sm_val_sn) } else { c_type_tag(sm_val_ct) }
                            "Map_{sm_key_tag}_{sm_val_tag}"
                        }
                    } else {
                        compound_option_inner_name(inner_type, inner_str)
                    }
                    ensure_struct_option_type(compound_name)
                    let opt_type = struct_option_c_type(compound_name)
                    let compound_c = c_type_from_tag(compound_name)
                    let mut actual_inner = inner_str
                    if inner_type == CT_OPTION && inner_is_none != 0 {
                        actual_inner = "(blink_{compound_name})\{.tag = 0}"
                    }
                    if compound_c.ends_with("*") {
                        expr_result_str = "({opt_type})\{.tag = 1, .value = {actual_inner}}"
                    } else {
                        let box_tmp = fresh_temp("_cbox_")
                        emit_line("{compound_c}* {box_tmp} = ({compound_c}*)blink_alloc(sizeof({compound_c}));")
                        emit_line("*{box_tmp} = {actual_inner};")
                        expr_result_str = "({opt_type})\{.tag = 1, .value = {box_tmp}}"
                    }
                    expr_result_type = CT_OPTION
                    expr_option_inner = inner_type
                    expr_option_inner_struct = compound_name
                    if inner_type == CT_MAP {
                        let mvs = get_map_value_struct(inner_str)
                        if mvs != "" {
                            expr_option_inner_map_val_struct = mvs
                        }
                        let mvle = get_map_value_list_elem(inner_str)
                        if mvle >= 0 {
                            expr_option_inner_map_val_list_elem = mvle
                        }
                    }
                    if inner_type == CT_LIST {
                        let le = get_list_elem_type(inner_str)
                        if le >= 0 {
                            expr_option_inner_list_elem = le
                        }
                        let les = get_list_elem_struct(inner_str)
                        if les != "" {
                            expr_option_inner_list_struct = les
                        }
                    }
                } else {
                    ensure_option_type(inner_type)
                    let opt_type = option_c_type(inner_type)
                    expr_result_str = "({opt_type})\{.tag = 1, .value = {inner_str}}"
                    expr_result_type = CT_OPTION
                    expr_option_inner = inner_type
                    expr_option_inner_struct = ""
                }
                return
            }
        }
        if fn_name == "Ok" {
            let args_sl = node_args(node)
            let arity = if args_sl != -1 { sublist_length(args_sl) } else { 0 }
            let exp_ok_ann = expect_arg_result_elem(0)
            if exp_ok_ann != -1 && arity > 0 {
                let exp_err_ann = expect_arg_result_elem(1)
                let ok_name = node_name(exp_ok_ann)
                let err_name = node_name(exp_err_ann)
                let saved_arg_ann = cg_expect_arg_ann
                let saved_let_ann = cg_let_target_ann
                // Narrow the value context to the Ok payload's own annotation
                // before recursing. Merely clearing cg_expect_arg_ann leaves the
                // OUTER cg_let_target_ann live, so a nested compound payload
                // (Ok(Ok(x)) → Result[Result[..],..]) would emit the inner Ok with
                // the OUTER carrier type (2bd4aa). Pushing exp_ok_ann makes the
                // inner constructor's expect_arg_result_elem see its real type.
                cg_expect_arg_ann = -1
                cg_let_target_ann = exp_ok_ann
                emit_expr(sublist_get(args_sl, 0))
                cg_expect_arg_ann = saved_arg_ann
                cg_let_target_ann = saved_let_ann
                let ok_str = expr_result_str
                let ok_inner_ct = expr_result_type
                let ok_inner_struct = get_var_struct(ok_str)
                let mut ok_c = carrier_from_elem_name(ok_name, ok_inner_ct, exp_ok_ann)
                // When the expected ok ann is a generic type-param (e.g.
                // `Result[T, Str]`), carrier_from_elem_name leaves struct_name empty
                // (it only sets it for a concrete struct/enum) — recover the
                // carrier from the emitted argument's own struct/enum so the
                // Ok payload keeps its real type. Do NOT fire when the ok side is
                // itself a compound (Option/Result): get_var_struct returns the
                // compound's INNER struct ("Item" for Option[Item]), and stamping
                // it here would make upgrade_compound_carrier's `struct_name != ""`
                // guard early-return, erasing the carrier to blink_Result_Item_str
                // instead of blink_Result_Option_Item_str (msqtkd). Let
                // upgrade_compound_carrier build the compound tag from exp_ok_ann.
                if ok_c.struct_name == "" && ok_inner_struct != "" && ok_name != "Option" && ok_name != "Result" {
                    ok_c = CarrierInfo { type_const: CT_INT, struct_name: ok_inner_struct }
                }
                // A compound ok/err annotation (`Result[Option[T], E]` etc.)
                // carries no struct/enum name; upgrade both sides so the carrier
                // embeds the inner compound by value instead of erasing to
                // `void ok`/`void err`. emit_expr above ensured the ok payload's
                // inner typedef; ensure the (non-emitted) err side's too.
                ok_c = upgrade_compound_carrier(ok_c, exp_ok_ann)
                let mut err_c = carrier_from_elem_name(err_name, type_from_name(err_name), exp_err_ann)
                err_c = upgrade_compound_carrier(err_c, exp_err_ann)
                if err_c.struct_name != "" { ensure_carrier_from_tag(err_c.struct_name) }
                emit_ok_result(ok_str, ok_c.type_const, err_c.type_const, ok_c.struct_name, err_c.struct_name)
                return
            }
            if arity == 0 {
                let fn_rt = get_fn_ret_type(cg_current_fn_name)
                let mut ok_type = CT_VOID
                if fn_rt.kind == CT_RESULT { ok_type = fn_rt.inner1 }
                let fsi = get_fn_ret_struct_inner(cg_current_fn_name)
                let mut ok_s = fsi.ok_struct
                let mut err_s = fsi.err_struct
                let mut err_type = if err_s != "" { CT_INT } else if fn_rt.kind == CT_RESULT { fn_rt.inner2 } else { CT_STRING }
                if fsi.ok_struct.starts_with("Result_") {
                    let split = split_result_compound(fsi.ok_struct)
                    if split.second != "" {
                        let inner_err_ct = type_from_name_tag(split.second)
                        if is_struct_type(split.second) != 0 || is_enum_type(split.second) != 0 {
                            err_s = split.second
                            err_type = CT_INT
                        } else {
                            err_s = ""
                            err_type = inner_err_ct
                        }
                    }
                    ok_s = ""
                }
                emit_ok_result("0", ok_type, err_type, ok_s, err_s)
                return
            }
            if args_sl != -1 && sublist_length(args_sl) > 0 {
                emit_expr(sublist_get(args_sl, 0))
                let ok_str = expr_result_str
                let mut ok_type = expr_result_type
                let fn_rt = get_fn_ret_type(cg_current_fn_name)
                if fn_rt.kind == CT_RESULT && fn_rt.inner1 == CT_VOID {
                    ok_type = CT_VOID
                }
                let ok_var_s = get_var_struct(ok_str)
                let fsi = get_fn_ret_struct_inner(cg_current_fn_name)
                // When the Ok payload is itself compound (CT_OPTION or
                // CT_RESULT), get_var_struct returns the inner struct (e.g.
                // "Item" for Option[Item]) which would be the wrong Ok-tag.
                // Prefer the function-stated fsi.ok_struct (which may be a
                // generic placeholder like "Option_ptr" for effect handlers);
                // fall back to synthesizing the compound tag.
                let compound_ok_s = if ok_type == CT_OPTION {
                    let opt_s = expr_option_inner_struct
                    if opt_s != "" {
                        "Option_{opt_s}"
                    } else {
                        "Option_{c_type_tag(expr_option_inner)}"
                    }
                } else if ok_type == CT_RESULT {
                    let ok_tag = if expr_result_ok_struct != "" { expr_result_ok_struct } else { c_type_tag(expr_result_ok_type) }
                    let err_tag = if expr_result_err_struct != "" { expr_result_err_struct } else { c_type_tag(expr_result_err_type) }
                    "Result_{ok_tag}_{err_tag}"
                } else {
                    ""
                }
                let mut ok_s = if fsi.ok_struct != "" {
                    fsi.ok_struct
                } else if compound_ok_s != "" {
                    compound_ok_s
                } else {
                    ok_var_s
                }
                let mut err_s = fsi.err_struct
                let mut err_type = if err_s != "" { CT_INT } else if fn_rt.kind == CT_RESULT { fn_rt.inner2 } else { CT_STRING }
                if ok_type != CT_RESULT && fsi.ok_struct.starts_with("Result_") {
                    let split = split_result_compound(fsi.ok_struct)
                    if split.second != "" {
                        let inner_err_ct = type_from_name_tag(split.second)
                        if is_struct_type(split.second) != 0 || is_enum_type(split.second) != 0 {
                            err_s = split.second
                            err_type = CT_INT
                        } else {
                            err_s = ""
                            err_type = inner_err_ct
                        }
                    }
                    ok_s = ""
                }
                emit_ok_result(ok_str, ok_type, err_type, ok_s, err_s)
                return
            }
        }
        if fn_name == "Err" {
            let args_sl = node_args(node)
            let exp_err_result_ann = expect_arg_result_elem(0)
            if exp_err_result_ann != -1 && args_sl != -1 && sublist_length(args_sl) > 0 {
                let exp_err_ann = expect_arg_result_elem(1)
                let ok_name = node_name(exp_err_result_ann)
                let err_name = node_name(exp_err_ann)
                let saved_arg_ann = cg_expect_arg_ann
                let saved_let_ann = cg_let_target_ann
                // Narrow to the Err payload's annotation (symmetric with the Ok
                // path). Without this a nested Err(Ok(x)) → Result[.., Result[..]]
                // emits the inner constructor with the OUTER carrier type (2bd4aa).
                cg_expect_arg_ann = -1
                cg_let_target_ann = exp_err_ann
                emit_expr(sublist_get(args_sl, 0))
                cg_expect_arg_ann = saved_arg_ann
                cg_let_target_ann = saved_let_ann
                let err_str = expr_result_str
                let mut ok_c = carrier_from_elem_name(ok_name, type_from_name(ok_name), exp_err_result_ann)
                // The ok side is not emitted in an Err construction; upgrade a
                // compound ok annotation and ensure its inner typedef so the
                // carrier matches the Ok-construction of the same Result type.
                ok_c = upgrade_compound_carrier(ok_c, exp_err_result_ann)
                if ok_c.struct_name != "" { ensure_carrier_from_tag(ok_c.struct_name) }
                let mut err_c = carrier_from_elem_name(err_name, expr_result_type, exp_err_ann)
                if err_c.struct_name == "" {
                    err_c = carrier_from_emitted(err_str, expr_result_type)
                }
                err_c = upgrade_compound_carrier(err_c, exp_err_ann)
                emit_err_result(err_str, ok_c.type_const, err_c.type_const, ok_c.struct_name, err_c.struct_name)
                return
            }
            if args_sl != -1 && sublist_length(args_sl) > 0 {
                emit_expr(sublist_get(args_sl, 0))
                let err_str = expr_result_str
                let err_type = expr_result_type
                let err_enum = get_var_enum(err_str)
                let fsi = get_fn_ret_struct_inner(cg_current_fn_name)
                let mut err_s = if err_enum != "" { err_enum } else { fsi.err_struct }
                let mut ok_s = fsi.ok_struct
                let fn_rt = get_fn_ret_type(cg_current_fn_name)
                let mut ok_type = if ok_s != "" { CT_INT } else if fn_rt.kind == CT_RESULT { fn_rt.inner1 } else { CT_INT }
                if fsi.ok_struct.starts_with("Result_") {
                    let split = split_result_compound(fsi.ok_struct)
                    if split.second != "" {
                        let inner_err_ct = type_from_name_tag(split.second)
                        let inner_ok_ct = type_from_name_tag(split.first)
                        if err_type == inner_err_ct {
                            if is_struct_type(split.first) != 0 || is_enum_type(split.first) != 0 {
                                ok_s = split.first
                                ok_type = CT_INT
                            } else {
                                ok_s = ""
                                ok_type = inner_ok_ct
                            }
                            err_s = if err_enum != "" { err_enum } else { "" }
                        }
                    }
                }
                if ok_s != "" || err_s != "" {
                    ensure_mixed_result_type(ok_type, err_type, ok_s, err_s)
                    let res_type = result_c_type_mixed(ok_type, err_type, ok_s, err_s)
                    expr_result_str = "({res_type})\{.tag = 1, .err = {err_str}}"
                    expr_result_type = CT_RESULT
                    expr_result_ok_type = ok_type
                    expr_result_err_type = err_type
                    expr_result_ok_struct = ok_s
                    expr_result_err_struct = err_s
                } else {
                    ensure_result_type(ok_type, err_type)
                    let res_type = result_c_type(ok_type, err_type)
                    expr_result_str = "({res_type})\{.tag = 1, .err = {err_str}}"
                    expr_result_type = CT_RESULT
                    expr_result_ok_type = ok_type
                    expr_result_err_type = err_type
                    expr_result_ok_struct = ""
                    expr_result_err_struct = ""
                }
                return
            }
        }
        if fn_name == "Map" {
            let ec = resolve_ctor_kops_elem("Map")
            let kops = kops_table_name(ec.type_const, ec.struct_name)
            expr_result_str = "blink_map_new(&{kops})"
            expr_result_type = CT_MAP
            return
        }
        if fn_name == "Set" {
            let ec = resolve_ctor_kops_elem("Set")
            let kops = kops_table_name(ec.type_const, ec.struct_name)
            expr_result_str = "blink_set_new(&{kops})"
            expr_result_type = CT_SET
            // A fresh set carries no element type via the global; the let-block
            // records it from the annotation. Clear so a stale value from a
            // prior expression can't leak into an unannotated `let s = Set()`.
            expr_list_elem_type = -1
            expr_list_elem_struct = ""
            return
        }
        if fn_name == "Bytes" {
            expr_result_str = "blink_bytes_new()"
            expr_result_type = CT_BYTES
            return
        }
        if fn_name == "StringBuilder" {
            let args_sl = node_args(node)
            if args_sl != -1 && sublist_length(args_sl) > 0 {
                emit_expr(sublist_get(args_sl, 0))
                let cap_str = expr_result_str
                expr_result_str = "blink_sb_with_capacity({cap_str})"
            } else {
                expr_result_str = "blink_sb_new()"
            }
            expr_result_type = CT_STRINGBUILDER
            return
        }
        if fn_name == "Channel" {
            let args_sl = node_args(node)
            if args_sl != -1 && sublist_length(args_sl) > 0 {
                emit_expr(sublist_get(args_sl, 0))
                let cap_str = expr_result_str
                expr_result_str = "blink_channel_new({cap_str})"
            } else {
                expr_result_str = "blink_channel_new(16)"
            }
            expr_result_type = CT_CHANNEL
            return
        }
        if fn_name == "alloc_ptr" {
            let inner_c = resolve_ptr_inner_c()
            expr_result_str = "({inner_c}*)malloc(sizeof({inner_c}))"
            expr_result_type = CT_PTR
            return
        }
        if fn_name == "null_ptr" {
            let inner_c = resolve_ptr_inner_c()
            expr_result_str = "(({inner_c}*)NULL)"
            expr_result_type = CT_PTR
            return
        }
        // Check if this is a closure-typed variable
        let closure_sig = get_var_closure_sig(fn_name)
        if closure_sig != "" {
            let cap_idx_cls = get_capture_index(fn_name)
            let mut cls_expr = c_safe_name(fn_name)
            if cap_idx_cls >= 0 {
                let cap_entry_cls = closure_captures.get(cg_closure_cap_start + cap_idx_cls).unwrap()
                if cap_entry_cls.is_mut != 0 {
                    cls_expr = "(*{c_safe_name(fn_name)}_cell)"
                } else {
                    cls_expr = "((blink_closure*)blink_closure_get_capture(__self, {cap_idx_cls}))"
                }
            } else if list_contains_str(mut_captured_vars, fn_name) != 0 {
                let mut is_closure_param_cc = 0
                let mut cpi_cc = 0
                while cpi_cc < closure_param_names.len() {
                    if closure_param_names.get(cpi_cc).unwrap() == fn_name {
                        is_closure_param_cc = 1
                    }
                    cpi_cc = cpi_cc + 1
                }
                if is_closure_param_cc == 0 {
                    cls_expr = "(*{c_safe_name(fn_name)}_cell)"
                }
            }
            let args_sl = node_args(node)
            let mut args_str = cls_expr
            if args_sl != -1 {
                let mut i = 0
                while i < sublist_length(args_sl) {
                    args_str = args_str.concat(", ")
                    emit_expr(sublist_get(args_sl, i))
                    args_str = args_str.concat(expr_result_str)
                    i = i + 1
                }
            }
            let ret_part = closure_sig_ret_part(closure_sig)
            if ret_part.starts_with("blink_") {
                let sname = strip_blink_prefix(ret_part)
                // Decode compound returns (Option_/Result_/Map_) BEFORE
                // falling back to struct resolution — resolve_struct_from_c_name
                // would otherwise misread "Option_UserRow" as the struct "UserRow".
                if closure_ret_tag_is_recognized(sname) != 0 {
                    let tmp = fresh_temp("_cls_ret_")
                    emit_line("{ret_part} {tmp} = (({closure_sig}){cls_expr}->fn_ptr)({args_str});")
                    reseat_from_closure_ret_tag(sname, tmp)
                    return
                }
            }
            expr_result_str = "(({closure_sig}){cls_expr}->fn_ptr)({args_str})"
            expr_result_type = closure_ret_ct(ret_part)
            return
        }
        let args_sl = node_args(node)
        let mut args_str = ""
        let mut arg_types: List[Int] = []
        let mut arg_elem_types: List[Int] = []
        let mut arg_err_elem_types: List[Int] = []
        let mut arg_closure_sigs: List[Str] = []
        let mut arg_struct_names: List[Str] = []
        let mut arg_err_struct_names: List[Str] = []
        let mut arg_map_key_types: List[Int] = []
        let mut arg_map_key_structs: List[Str] = []
        let mut arg_map_val_types: List[Int] = []
        let mut arg_map_val_structs: List[Str] = []
        let is_generic = is_generic_fn(fn_name)
        let callee_params_sl = get_callee_params_sl(fn_name)
        reorder_named_args(fn_name, args_sl, node)
        if reorder_result.len() > 0 {
            let mut i = 0
            while i < reorder_result.len() {
                if i > 0 {
                    args_str = args_str.concat(", ")
                }
                let arg_node = reorder_result.get(i).unwrap()
                let mut actual = arg_node
                if node_kind(arg_node) == NodeKind.NamedArg {
                    actual = node_value(arg_node)
                }
                let saved_hint = cg_expect_fn_value_sig
                cg_expect_fn_value_sig = arg_fn_value_hint(callee_params_sl, i)
                let saved_arg_ann = cg_expect_arg_ann
                cg_expect_arg_ann = arg_type_ann_at(callee_params_sl, i)
                emit_expr(actual)
                cg_expect_arg_ann = saved_arg_ann
                cg_expect_fn_value_sig = saved_hint
                args_str = args_str.concat(expr_result_str)
                if is_generic != 0 {
                    arg_types.push(expr_result_type)
                    arg_elem_types.push(arg_elem_type_for(expr_result_type, expr_list_elem_type))
                    arg_err_elem_types.push(arg_err_elem_type_for(expr_result_type))
                    arg_closure_sigs.push(expr_closure_sig)
                    arg_struct_names.push(arg_struct_name_for(expr_result_type, expr_result_str, expr_list_elem_struct))
                    arg_err_struct_names.push(arg_err_struct_name_for(expr_result_type))
                    let map_info = arg_map_info_for(actual, expr_result_type)
                    arg_map_key_types.push(map_info.kt)
                    arg_map_key_structs.push(map_info.ks)
                    arg_map_val_types.push(map_info.vt)
                    arg_map_val_structs.push(map_info.vs)
                }
                i = i + 1
            }
        } else if args_sl != -1 {
            let mut i = 0
            while i < sublist_length(args_sl) {
                if i > 0 {
                    args_str = args_str.concat(", ")
                }
                let arg_node_i = sublist_get(args_sl, i)
                let saved_hint = cg_expect_fn_value_sig
                cg_expect_fn_value_sig = arg_fn_value_hint(callee_params_sl, i)
                let saved_arg_ann = cg_expect_arg_ann
                cg_expect_arg_ann = arg_type_ann_at(callee_params_sl, i)
                emit_expr(arg_node_i)
                cg_expect_arg_ann = saved_arg_ann
                cg_expect_fn_value_sig = saved_hint
                args_str = args_str.concat(expr_result_str)
                if is_generic != 0 {
                    arg_types.push(expr_result_type)
                    arg_elem_types.push(arg_elem_type_for(expr_result_type, expr_list_elem_type))
                    arg_err_elem_types.push(arg_err_elem_type_for(expr_result_type))
                    arg_closure_sigs.push(expr_closure_sig)
                    arg_struct_names.push(arg_struct_name_for(expr_result_type, expr_result_str, expr_list_elem_struct))
                    arg_err_struct_names.push(arg_err_struct_name_for(expr_result_type))
                    let map_info = arg_map_info_for(arg_node_i, expr_result_type)
                    arg_map_key_types.push(map_info.kt)
                    arg_map_key_structs.push(map_info.ks)
                    arg_map_val_types.push(map_info.vt)
                    arg_map_val_structs.push(map_info.vs)
                }
                i = i + 1
            }
        }
        args_str = append_ev_arg(fn_name, args_str)
        if is_generic != 0 {
            let ca = GenericCallArgs {
                types: arg_types,
                elem_types: arg_elem_types,
                err_elem_types: arg_err_elem_types,
                closure_sigs: arg_closure_sigs,
                struct_names: arg_struct_names,
                err_struct_names: arg_err_struct_names,
                map_key_types: arg_map_key_types,
                map_key_structs: arg_map_key_structs,
                map_val_types: arg_map_val_types,
                map_val_structs: arg_map_val_structs,
            }
            let handled = emit_generic_fn_call_tail(node, fn_name, args_str, ca)
            if handled != 0 {
                return
            }
        }
        if is_fn_registered(fn_name) == 0 && is_generic_fn(fn_name) == 0 {
            diag_error_at("UndefinedFunction", UNDEFINED_FUNCTION, "undefined function '{fn_name}' called in '{cg_current_fn_name}'", node, "")
            emit_line("/* undefined: {fn_name} */")
            expr_result_str = "0"
            expr_result_type = CT_INT
            return
        }
        expr_result_type = get_fn_ret(fn_name)
        if expr_result_type == CT_VOID || expr_result_type == CT_STRUCT || expr_result_type == CT_ENUM {
            let fn_sret = get_fn_ret_struct(fn_name)
            if fn_sret != "" {
                let s_tmp = fresh_temp("_sr")
                emit_line("{c_type_c_name(fn_sret)} {s_tmp} = {c_fn_name(fn_name)}({args_str});")
                set_var(s_tmp, CT_STRUCT, 0)
                set_var_struct(s_tmp, fn_sret)
                expr_result_str = s_tmp
                expr_result_type = CT_STRUCT
            } else {
                expr_result_str = "{c_fn_name(fn_name)}({args_str})"
            }
        } else {
            expr_result_str = "{c_fn_name(fn_name)}({args_str})"
        }
        let rt = get_fn_ret_type(fn_name)
        expr_result_ok_struct = ""
        expr_result_err_struct = ""
        expr_option_inner_struct = ""
        expr_list_elem_struct = ""
        expr_map_val_struct = ""
        expr_map_key_struct = ""
        if expr_result_type == CT_RESULT {
            expr_result_ok_type = tp_child1_kind(rt.tp_id)
            expr_result_err_type = tp_child2_kind(rt.tp_id)
            let fsi = get_fn_ret_struct_inner(fn_name)
            expr_result_ok_struct = fsi.ok_struct
            expr_result_err_struct = fsi.err_struct
            let ok_child_id = tp_get_child1(rt.tp_id)
            if expr_result_ok_type == CT_LIST && ok_child_id >= 0 {
                expr_list_elem_type = tp_child1_kind(ok_child_id)
                let elem_child_id = tp_get_child1(ok_child_id)
                if elem_child_id >= 0 {
                    expr_list_elem_struct = tp_get_sname(elem_child_id)
                }
            }
        }
        if expr_result_type == CT_OPTION {
            expr_option_inner = tp_child1_kind(rt.tp_id)
            let fsi = get_fn_ret_struct_inner(fn_name)
            expr_option_inner_struct = fsi.ok_struct
            let opt_child1 = tp_get_child1(rt.tp_id)
            if expr_option_inner == CT_LIST && opt_child1 >= 0 {
                expr_option_inner_list_elem = tp_child1_kind(opt_child1)
                let elem_child_id = tp_get_child1(opt_child1)
                if elem_child_id >= 0 {
                    let ls = tp_get_sname(elem_child_id)
                    if ls != "" {
                        expr_option_inner_list_struct = ls
                    }
                }
            }
            if expr_option_inner == CT_MAP && opt_child1 >= 0 {
                let map_val_child = tp_get_child2(opt_child1)
                if map_val_child >= 0 {
                    let mvk = tp_get_kind(map_val_child)
                    if mvk == CT_LIST {
                        let list_child = tp_get_child1(map_val_child)
                        if list_child >= 0 {
                            expr_option_inner_map_val_list_elem = tp_get_kind(list_child)
                        }
                    }
                    let mvs = tp_get_sname(map_val_child)
                    if mvs != "" {
                        expr_option_inner_map_val_struct = mvs
                    }
                }
            }
        }
        if expr_result_type == CT_LIST {
            expr_list_elem_type = tp_child1_kind(rt.tp_id)
            let fsi = get_fn_ret_struct_inner(fn_name)
            expr_list_elem_struct = fsi.ok_struct
        }
        if expr_result_type == CT_MAP {
            expr_map_key_type = tp_child1_kind(rt.tp_id)
            expr_map_val_type = tp_child2_kind(rt.tp_id)
        }
        if expr_result_type == CT_SET {
            expr_list_elem_type = tp_child1_kind(rt.tp_id)
        }
        if expr_result_type == CT_HANDLER {
            let h_info = get_fn_ret_handler(fn_name)
            if h_info.vtable_type != "" {
                cg_handler_vtable_type = h_info.vtable_type
                cg_handler_vtable_field = h_info.vtable_field
                cg_handler_is_user_effect = h_info.is_ue
            }
        }
        return
    }
    // Qualified trait call: Trait.method(x, ...)
    if func_kind == NodeKind.FieldAccess {
        let trait_obj = node_obj(func_node)
        if node_kind(trait_obj) == NodeKind.Ident {
            let trait_name = node_name(trait_obj)
            if is_trait_type(trait_name) != 0 {
                let method = node_name(func_node)
                let args_sl = node_args(node)
                // First arg determines the type
                if args_sl != -1 && sublist_length(args_sl) > 0 {
                    emit_expr(sublist_get(args_sl, 0))
                    let first_str = expr_result_str
                    let type_name = get_var_struct(first_str)
                    if type_name != "" && lookup_impl_method(type_name, method) != 0 {
                        // Qualified call (Trait.method form). The named trait
                        // may be a sibling that doesn't own the method (e.g.
                        // ListOps.is_empty when is_empty lives in Sized), so
                        // resolve the trait that actually defines it before
                        // building the trait-qualified symbol (sb3125). Gated on
                        // a real user impl so sealed builtin ops-traits skip this.
                        let reg_name = impl_method_reg_name(type_name, method)
                        let owner_trait = if impl_type_implements_trait_method(reg_name, trait_name, method) != 0 { trait_name } else { impl_trait_for_method(reg_name, method) }
                        let mangled = if owner_trait != "" { mangle_impl_method_q(reg_name, owner_trait, method) } else { "{reg_name}_{method}" }
                        let mut args_str = first_str
                        let mut i = 1
                        while i < sublist_length(args_sl) {
                            args_str = args_str.concat(", ")
                            emit_expr(sublist_get(args_sl, i))
                            args_str = args_str.concat(expr_result_str)
                            i = i + 1
                        }
                        args_str = append_ev_arg(mangled, args_str)
                        expr_result_str = "{c_fn_name(mangled)}({args_str})"
                        expr_list_elem_type = -1
                        expr_list_elem_struct = ""
                        expr_result_type = get_impl_method_ret(type_name, method)
                        return
                    }
                }
            }
        }
    }
    emit_expr(func_node)
    let func_str = expr_result_str
    let func_cls_sig = expr_closure_sig
    let args_sl = node_args(node)
    let mut args_str = ""
    if func_cls_sig != "" {
        args_str = func_str
        if args_sl != -1 {
            let mut i = 0
            while i < sublist_length(args_sl) {
                args_str = args_str.concat(", ")
                emit_expr(sublist_get(args_sl, i))
                args_str = args_str.concat(expr_result_str)
                i = i + 1
            }
        }
        expr_result_str = "(({func_cls_sig}){func_str}->fn_ptr)({args_str})"
        let ret_part = closure_sig_ret_part(func_cls_sig)
        if ret_part.starts_with("blink_") {
            let sname = strip_blink_prefix(ret_part)
            // Decode compound returns (Option_/Result_/Map_) BEFORE
            // falling back to struct resolution — resolve_struct_from_c_name
            // would otherwise misread "Option_UserRow" as the struct "UserRow".
            if closure_ret_tag_is_recognized(sname) != 0 {
                let tmp = fresh_temp("_cls_ret_")
                emit_line("{ret_part} {tmp} = (({func_cls_sig}){func_str}->fn_ptr)({args_str});")
                reseat_from_closure_ret_tag(sname, tmp)
            } else {
                expr_result_type = CT_STRUCT
            }
        } else {
            expr_result_type = closure_ret_ct(ret_part)
        }
    } else {
        if args_sl != -1 {
            let mut i = 0
            while i < sublist_length(args_sl) {
                if i > 0 {
                    args_str = args_str.concat(", ")
                }
                emit_expr(sublist_get(args_sl, i))
                args_str = args_str.concat(expr_result_str)
                i = i + 1
            }
        }
        expr_result_str = "{func_str}({args_str})"
        expr_result_type = CT_VOID
    }
}

// Resolve the owning source file for a node and escape it for embedding
// into emitted C string literals. Falls back to diag_source_file when the
// node has no registered range (e.g. synthesized nodes).
pub fn panic_file_for(node: Int) -> Str {
    let raw = diag_file_for_node(node)
    let resolved = if raw != "" { raw } else { diag_source_file }
    escape_c_string(resolved)
}

// Like panic_file_for, but additionally escapes `%` as `%%` so the path is safe
// to embed in a printf/vsnprintf FORMAT string (the msg_fmt_c of emit_panic_site).
// A path with a literal `%` would otherwise become an unmatched conversion spec
// with no vararg -> UB (ticket 4d3m46). Use ONLY for panic format strings; path
// arguments passed verbatim to runtime helpers must keep panic_file_for.
pub fn panic_file_for_fmt(node: Int) -> Str {
    escape_fmt_percent(panic_file_for(node))
}

// Render the line-number portion of a runtime panic location.
// Returns the decimal line for real source nodes; for synthesized nodes
// whose line did not propagate (line <= 0) returns "<synthesized>" so
// the embedded panic message does not lie about a source position.
pub fn panic_line_str(node: Int) -> Str {
    let l = node_line(node)
    if l <= 0 { "<synthesized>" } else { "{l}" }
}

// Lower a panic site. `msg_fmt_c` is a C printf format WITHOUT a trailing
// newline; `fmt_args_c` is the comma-prefixed argument list (e.g.
// ", (long long)x") or "" when the format is literal. In a non-test build
// this emits the historic inline `fprintf(stderr, "...\n"...); exit(1);` —
// byte-identical to before, so non-test panic sites stay zero-cost. In a test
// build (cg_test_mode) it routes to the thread-local catch dispatch so an
// armed assert_panics can consume the panic (spec §2.20). The caller keeps the
// surrounding `if (cond) { ... }` guard. Returns the C statement string.
pub fn emit_panic_site(msg_fmt_c: Str, fmt_args_c: Str) -> Str {
    if cg_test_mode != 0 {
        "__blink_panic_dispatchf(\"{msg_fmt_c}\"{fmt_args_c});"
    } else {
        "fprintf(stderr, \"{msg_fmt_c}\\n\"{fmt_args_c}); exit(1);"
    }
}

pub fn escape_c_string(s: Str) -> Str {
    let mut sb = StringBuilder.new()
    let mut i = 0
    while i < s.len() {
        let ch = s.byte_at(i)
        if ch == 92 {
            sb.write("\\\\")
        } else if ch == 34 {
            sb.write("\\\"")
        } else if ch == 10 {
            sb.write("\\n")
        } else if ch == 13 {
            sb.write("\\r")
        } else if ch == 9 {
            sb.write("\\t")
        } else if ch == 8 {
            sb.write("\\b")
        } else if ch == 12 {
            sb.write("\\f")
        } else if ch == 63 {
            sb.write("\\?")
        } else {
            sb.write(s.substring(i, 1))
        }
        i = i + 1
    }
    sb.to_str()
}

fn escape_fmt_percent(s: Str) -> Str {
    let mut sb = StringBuilder.new()
    let mut i = 0
    while i < s.len() {
        let ch = s.byte_at(i)
        if ch == 37 {
            if i + 1 < s.len() && s.byte_at(i + 1) == 37 {
                sb.write("%%")
                i = i + 2
            } else {
                sb.write("%%")
                i = i + 1
            }
        } else {
            sb.write(s.substring(i, 1))
            i = i + 1
        }
    }
    sb.to_str()
}

// A single interpolated value's contribution to the blink_str_format call:
// `fmt` is the printf-format fragment, `arg` the matching vararg expression
// (empty when the fragment carries no %-specifier, e.g. an inlined literal).
type InterpFrag {
    fmt: Str
    arg: Str
}

// Render one C value expression `e_str` of C-type `e_type` for interpolation.
// Scalars map to a printf specifier + coerced arg; user structs/enums route
// through their synthesized Display.display(); tuples expand inline to
// "(e0, e1, ...)" by recursing per element (spec §3.6 structural tuple
// Display). The E0523 typecheck gate guarantees every value is Display, so the
// no-Display branch is defensive and emits a placeholder literal — NEVER the
// raw aggregate into %s (which would SIGSEGV — bug fmj80a).
fn interp_render_value(e_str: Str, e_type: Int, known_struct: Str) -> InterpFrag ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    if e_type == CT_INT || e_type == CT_I8 || e_type == CT_I16 || e_type == CT_I32 {
        return InterpFrag { fmt: "%lld", arg: "(long long)".concat(e_str) }
    }
    if e_type == CT_U8 || e_type == CT_U16 || e_type == CT_U32 || e_type == CT_U64 {
        return InterpFrag { fmt: "%llu", arg: "(unsigned long long)".concat(e_str) }
    }
    if e_type == CT_FLOAT {
        return InterpFrag { fmt: "%g", arg: e_str }
    }
    if e_type == CT_BOOL {
        return InterpFrag { fmt: "%s", arg: e_str.concat(" ? \"true\" : \"false\"") }
    }
    if e_type == CT_CHAR {
        return InterpFrag { fmt: "%s", arg: "blink_char_to_str((int64_t)".concat(e_str).concat(")") }
    }
    if e_type == CT_STRUCT || e_type == CT_ENUM || e_type == CT_VOID {
        // `known_struct` is the tag supplied by a tuple-element recursion —
        // `e_str` there is a field-access expr (e.g. `t._1`) that get_var_struct
        // cannot resolve, so trust the caller's tag. Top-level calls pass "".
        let sname = if known_struct != "" {
            known_struct
        } else if get_var_struct(e_str) != "" {
            get_var_struct(e_str)
        } else if is_data_enum(get_var_enum(e_str)) != 0 {
            get_var_enum(e_str)
        } else {
            ""
        }
        // Anonymous tuple: no impl Display, render structurally as (e0, e1, ...).
        let arity = if sname != "" { tuple_struct_arity(sname) } else { -1 }
        if arity >= 0 {
            let mut tfmt = "("
            let mut targ = ""
            let mut ti = 0
            while ti < arity {
                if ti > 0 { tfmt = tfmt.concat(", ") }
                let elem_struct = tuple_elem_struct(sname, ti)
                let elem_ct = if elem_struct != "" { CT_STRUCT } else { tuple_elem_ct(sname, ti) }
                let elem_expr = e_str.concat("._{ti}")
                let sub = interp_render_value(elem_expr, elem_ct, elem_struct)
                tfmt = tfmt.concat(sub.fmt)
                if sub.arg != "" {
                    if targ != "" { targ = targ.concat(", ") }
                    targ = targ.concat(sub.arg)
                }
                ti = ti + 1
            }
            tfmt = tfmt.concat(")")
            return InterpFrag { fmt: tfmt, arg: targ }
        }
        let disp = if sname != "" { synthesized_display_call(sname, e_str) } else { "" }
        if disp != "" {
            return InterpFrag { fmt: "%s", arg: disp }
        }
        let tag = if sname != "" { sname } else { "value" }
        return InterpFrag { fmt: "%s", arg: "\"<".concat(tag).concat(">\"") }
    }
    // CT_STRING is a genuine const char* — raw %s is correct.
    if e_type == CT_STRING {
        return InterpFrag { fmt: "%s", arg: e_str }
    }
    // Any other CT reaching here is a non-Display aggregate the typecheck gate
    // should have rejected (e.g. a List/Map/Option element inside a tuple typed
    // via an un-substituted generic typevar — E0523 fails open on typevars).
    // NEVER pass such a value to %s: that reinterprets its bytes as a char*
    // (type confusion / SIGSEGV — the whole point of fmj80a). Emit a safe
    // placeholder literal instead so codegen can never crash on it.
    InterpFrag { fmt: "%s", arg: "\"<value>\"" }
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_interp_string(node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let parts_sl = node_elements(node)
    if parts_sl == -1 {
        expr_result_str = "\"\""
        expr_result_type = CT_STRING
        return
    }

    // Fast path: if all parts are literal, emit a simple string constant
    let mut all_literal = 1
    let mut ai = 0
    while ai < sublist_length(parts_sl) {
        let part = sublist_get(parts_sl, ai)
        let pk = node_kind(part)
        if !(pk == NodeKind.Ident && node_str_val(part) == node_name(part)) {
            all_literal = 0
        }
        ai = ai + 1
    }
    if all_literal != 0 {
        let mut concat_str = ""
        let mut ci = 0
        while ci < sublist_length(parts_sl) {
            let part = sublist_get(parts_sl, ci)
            concat_str = concat_str.concat(escape_c_string(node_str_val(part)))
            ci = ci + 1
        }
        expr_result_str = "\"".concat(concat_str).concat("\"")
        expr_result_type = CT_STRING
        return
    }

    // Slow path: build the interpolated string with blink_str_format, a
    // GC-allocating variadic helper that sizes the buffer exactly (vsnprintf
    // two-pass). Spec §2.4: interpolation is concatenation with no length cap,
    // so no fixed buffer may be used here.
    let mut fmt = ""
    let mut args = ""
    let mut has_args = 0
    let mut i = 0
    while i < sublist_length(parts_sl) {
        let part = sublist_get(parts_sl, i)
        let pk = node_kind(part)
        // Literal string parts: parser stores them as NodeKind.Ident with str_val == name
        // Expression parts: NodeKind.Ident with str_val == "" (or other node kinds)
        if pk == NodeKind.Ident && node_str_val(part) == node_name(part) {
            fmt = fmt.concat(escape_fmt_percent(escape_c_string(node_str_val(part))))
        } else {
            // Expression part
            emit_expr(part)
            let frag = interp_render_value(expr_result_str, expr_result_type, "")
            fmt = fmt.concat(frag.fmt)
            if frag.arg != "" {
                if has_args {
                    args = args.concat(", ")
                }
                args = args.concat(frag.arg)
                has_args = 1
            }
        }
        i = i + 1
    }
    if has_args {
        expr_result_str = "blink_str_format(\"".concat(fmt).concat("\", ").concat(args).concat(")")
    } else {
        expr_result_str = "blink_str_format(\"".concat(fmt).concat("\")")
    }
    expr_result_type = CT_STRING
}

fn is_raw_call(node: Int) -> Int {
    if node_kind(node) != NodeKind.Call { return 0 }
    let left = node_left(node)
    if left == -1 { return 0 }
    if node_kind(left) != NodeKind.Ident { return 0 }
    if node_name(left) != "Raw" { return 0 }
    let args_sl = node_args(node)
    if args_sl == -1 { return 0 }
    if sublist_length(args_sl) != 1 { return 0 }
    1
}

// If `arg` is a transparent-newtype variant constructor call (e.g. `Errno(rc)`),
// return the enum name (so the Option carrier can stay Option_Errno with a bare
// scalar member). Otherwise "". This must be checked BEFORE emit_expr flattens
// the constructor's expr_result_type to CT_INT (the transparent carve-out at the
// top of the Call handler), which erases the type signal the Some wrapper needs.
fn transparent_newtype_arg_enum(arg: Int) -> Str {
    if node_kind(arg) != NodeKind.Call { return "" }
    let callee = node_left(arg)
    if callee == -1 || node_kind(callee) != NodeKind.Ident { return "" }
    let variant_enum = resolve_variant(node_name(callee))
    if variant_enum != "" && is_transparent_newtype(variant_enum) != 0 {
        return variant_enum
    }
    ""
}

// Inner element NAME of a function's `Option[T]` return annotation, or "" if the
// function does not return an Option. Parallels resolve_option_inner_from_ann
// (which discards the name down to a CT const) — the Some construction path needs
// the name to keep a transparent-newtype carrier (Option_Errno) when the payload
// reaches it as a bare scalar variable rather than a literal constructor call.
fn option_inner_struct_from_fn(fn_node: Int) -> Str {
    if node_return_type(fn_node) != "Option" { return "" }
    let ta = node_type_ann(fn_node)
    if ta == -1 { return "" }
    let elems_sl = node_elements(ta)
    if elems_sl == -1 || sublist_length(elems_sl) < 1 { return "" }
    node_name(sublist_get(elems_sl, 0))
}

fn flush_template_part(tpl: Str, raw_prefix: Str, current_literal: Str) ! Codegen.Emit {
    if raw_prefix != "" {
        emit_line("blink_list_push({tpl}->parts, (void*)blink_str_format(\"%s%s\", {raw_prefix}, \"{current_literal}\"));")
    } else {
        emit_line("blink_list_push({tpl}->parts, (void*)\"{current_literal}\");")
    }
}

@allow(UnrestoredMutation, IncompleteStateRestore)
pub fn emit_template_construction(node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let parts_sl = node_elements(node)
    let tpl = fresh_temp("_tpl_")

    // Count expression parts to determine num_values (Raw() calls don't count)
    let mut num_values = 0
    if parts_sl != -1 {
        let mut ci = 0
        while ci < sublist_length(parts_sl) {
            let part = sublist_get(parts_sl, ci)
            let pk = node_kind(part)
            if !(pk == NodeKind.Ident && node_str_val(part) == node_name(part)) {
                if is_raw_call(part) == 0 {
                    num_values = num_values + 1
                }
            }
            ci = ci + 1
        }
    }

    emit_line("blink_template* {tpl} = blink_template_new({num_values});")

    if parts_sl == -1 {
        emit_line("blink_list_push({tpl}->parts, (void*)\"\");")
        expr_result_str = tpl
        expr_result_type = CT_TEMPLATE
        return
    }

    let mut current_literal = ""
    let mut raw_prefix = ""
    let mut i = 0
    while i < sublist_length(parts_sl) {
        let part = sublist_get(parts_sl, i)
        let pk = node_kind(part)
        if pk == NodeKind.Ident && node_str_val(part) == node_name(part) {
            current_literal = current_literal.concat(escape_c_string(node_str_val(part)))
        } else if is_raw_call(part) != 0 {
            // cg_current_fn_node is -1 when there is no enclosing user fn (a test
            // body, or a clean top level) — has_annotation → node_or_die(-1) would
            // exit(2). No fn means no @trusted to find, so Raw() is untrusted and the
            // warning must fire; guard the read and treat -1 as not-trusted.
            if cg_current_fn_node == -1 || has_annotation(cg_current_fn_node, "trusted") == 0 {
                diag_warn_at("RawBypassesParam", RAW_BYPASSES_PARAM, "Raw() bypasses query parameterization", part, "add @trusted(audit: \"AUDIT-ID\") to suppress")
            }
            let inner = sublist_get(node_args(part), 0)
            emit_expr(inner)
            let raw_str = expr_result_str
            let raw_type = expr_result_type
            let coerced = coerce_to_c_str(raw_str, raw_type)
            if raw_prefix != "" {
                raw_prefix = "blink_str_format(\"%s%s%s\", ".concat(raw_prefix).concat(", \"").concat(current_literal).concat("\", ").concat(coerced).concat(")")
            } else {
                raw_prefix = "blink_str_format(\"%s%s\", \"".concat(current_literal).concat("\", ").concat(coerced).concat(")")
            }
            current_literal = ""
        } else {
            flush_template_part(tpl, raw_prefix, current_literal)
            raw_prefix = ""
            current_literal = ""
            // Emit expression value
            emit_expr(part)
            let e_str = expr_result_str
            let e_type = expr_result_type
            if e_type == CT_INT {
                emit_line("blink_list_push({tpl}->values, (void*)(intptr_t){e_str});")
                emit_line("blink_list_push({tpl}->types, (void*)(intptr_t)BLINK_TPL_INT);")
            } else if e_type == CT_FLOAT {
                let ftmp = fresh_temp("_tplf_")
                emit_line("void* {ftmp}; memcpy(&{ftmp}, &(double)\{{e_str}}, sizeof(double));")
                emit_line("blink_list_push({tpl}->values, {ftmp});")
                emit_line("blink_list_push({tpl}->types, (void*)(intptr_t)BLINK_TPL_FLOAT);")
            } else if e_type == CT_BOOL {
                emit_line("blink_list_push({tpl}->values, (void*)(intptr_t){e_str});")
                emit_line("blink_list_push({tpl}->types, (void*)(intptr_t)BLINK_TPL_BOOL);")
            } else {
                emit_line("blink_list_push({tpl}->values, (void*){e_str});")
                emit_line("blink_list_push({tpl}->types, (void*)(intptr_t)BLINK_TPL_STR);")
            }
        }
        i = i + 1
    }
    flush_template_part(tpl, raw_prefix, current_literal)

    expr_result_str = tpl
    expr_result_type = CT_TEMPLATE
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_list_lit(node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let tmp = fresh_temp("_l")
    emit_line("blink_list* {tmp} = blink_list_new();")
    let elems_sl = node_elements(node)
    let mut first_elem_type = -1
    let mut first_elem_struct = ""
    if elems_sl != -1 {
        let mut i = 0
        while i < sublist_length(elems_sl) {
            let elem_node = sublist_get(elems_sl, i)
            if node_kind(elem_node) == NodeKind.SpreadExpr {
                emit_expr(node_value(elem_node))
                let src_str = expr_result_str
                emit_line("blink_list_extend({tmp}, {src_str});")
                if i == 0 {
                    first_elem_type = get_list_elem_type(src_str)
                    first_elem_struct = get_list_elem_struct(src_str)
                }
            } else {
                // Sub-issue A (br 4yzsfc): thread the list's declared element
                // annotation (from `let xs: List[Option[T]]` via cg_let_target_ann)
                // so a bare `None`/`Ok`/`Err` element adopts the right carrier
                // instead of defaulting to blink_Option_int.
                let saved_arg_ann = cg_expect_arg_ann
                let elem_ann = list_lit_elem_ann()
                if elem_ann != -1 {
                    cg_expect_arg_ann = elem_ann
                }
                emit_expr(elem_node)
                cg_expect_arg_ann = saved_arg_ann
                let e_str = expr_result_str
                let e_type = expr_result_type
                if i == 0 {
                    first_elem_type = e_type
                    first_elem_struct = resolve_push_struct(e_str, tmp)
                }
                let e_struct = resolve_push_struct(e_str, tmp)
                // For a struct literal element whose type isn't recorded on a
                // temp yet, recover its name from the StructLit node.
                let box_struct = if e_type == CT_STRUCT && e_struct == "" && node_kind(elem_node) == NodeKind.StructLit {
                    strip_module_qualifier(node_type_name(elem_node))
                } else {
                    e_struct
                }
                emit_boxed_container_store("blink_list_push({tmp}, ", e_str, e_type, box_struct, tmp)
            }
            i = i + 1
        }
    }
    if first_elem_type >= 0 {
        expr_list_elem_type = first_elem_type
    } else {
        expr_list_elem_type = -1
    }
    if first_elem_struct != "" {
        set_list_elem_type(tmp, CT_VOID)
        set_list_elem_struct(tmp, first_elem_struct)
        expr_list_elem_struct = first_elem_struct
    } else {
        expr_list_elem_struct = ""
    }
    expr_result_str = tmp
    expr_result_type = CT_LIST
}

fn infer_struct_type_args(type_name: Str, field_types: List[Int], field_structs: List[Str]) -> Option[Str] {
    let types_sl = node_fields(cg_program_node)
    if types_sl == -1 {
        return None
    }
    let mut td = -1
    let mut ti = 0
    while ti < sublist_length(types_sl) {
        let candidate = sublist_get(types_sl, ti)
        if node_name(candidate) == type_name {
            td = candidate
        }
        ti = ti + 1
    }
    if td == -1 {
        return None
    }
    let tparams_sl = node_type_params(td)
    if tparams_sl == -1 {
        return None
    }
    let num_params = sublist_length(tparams_sl)
    if num_params == 0 {
        return None
    }
    let td_flds_sl = node_fields(td)
    if td_flds_sl == -1 {
        return None
    }
    let mut args = ""
    let mut pi = 0
    while pi < num_params {
        let param_name = node_name(sublist_get(tparams_sl, pi))
        let mut resolved = "Void"
        let mut fi = 0
        while fi < sublist_length(td_flds_sl) && fi < field_types.len() {
            let f = sublist_get(td_flds_sl, fi)
            let type_ann_node = node_value(f)
            if type_ann_node != -1 {
                let ann_name = node_name(type_ann_node)
                if ann_name == param_name {
                    let fct = field_types.get(fi).unwrap()
                    let fstruct = field_structs.get(fi).unwrap()
                    // A struct/enum-instance field carries its concrete mono name
                    // (e.g. "Box_Int") captured at the literal site; type_name_from_ct
                    // has no CT_STRUCT/CT_ENUM case and would yield "Void", collapsing
                    // Box[Box[Int]] to Box_Void with a `void value;` field (br 3xvjcy).
                    if (fct == CT_STRUCT || fct == CT_ENUM) && fstruct != "" {
                        resolved = fstruct
                    } else {
                        resolved = type_name_from_ct(fct)
                    }
                } else {
                    let sub_elems = node_elements(type_ann_node)
                    if sub_elems != -1 {
                        let mut si = 0
                        while si < sublist_length(sub_elems) {
                            let sub_ann = sublist_get(sub_elems, si)
                            if node_name(sub_ann) == param_name {
                                let ft = field_types.get(fi).unwrap()
                                if ft == CT_OPTION {
                                    resolved = type_name_from_ct(expr_option_inner)
                                } else if ft == CT_RESULT {
                                    if si == 0 {
                                        resolved = type_name_from_ct(expr_result_ok_type)
                                    } else {
                                        resolved = type_name_from_ct(expr_result_err_type)
                                    }
                                }
                            }
                            si = si + 1
                        }
                    }
                }
            }
            fi = fi + 1
        }
        if pi > 0 {
            args = args.concat(",")
        }
        args = args.concat(resolved)
        pi = pi + 1
    }
    Some(args)
}

// Tid-native mono-args for a struct literal whose concrete inner is a COMPOUND
// carrier (`Box[Option[Int]]`), the shape the string path (struct_concrete_args_from_target
// bail + infer_struct_type_args' compound-blind bare-typevar branch) collapses to
// "Void" (br zrybya). Reads the instance tid typecheck memoized on the literal node
// (tc_struct_lit_instance_tid) and lowers each slot via tc_tid_to_c_tag, the epic's
// D-layer carrier-name primitive — Option[Int] → "Option_int", byte-identical to the
// blink_Option_int typedef the field value emits.
//
// Returns "" (defer to the string path, unchanged) unless the instance is a concrete
// same-base struct AND at least one slot is a faithful compound-of-scalar AND every
// slot is either a plain scalar or a faithful compound. A struct-INSTANCE slot
// (`Box[Box[Int]]`) or a compound-of-struct slot keeps the string path authoritative
// (tc_tid_to_c_tag would erase their inner). The at-least-one-compound guard confines
// the change to the previously-broken shapes: a pure-scalar instance keeps its exact
// current string output (byte-identity for every working shape).
// The struct-INSTANCE tid backing a struct literal, resolved with the same
// precedence tid_native_struct_mono_args uses so a caller filling parallel
// arg_tids agrees byte-for-byte on which instance was named. Prefer the
// enclosing annotation's instance tid (`let oi: Box[Option[Int]]`) over the
// literal's own reverse-inferred tid: a bare `None` / `Ok(x)` field value infers
// the compound inner as UNKNOWN (Box[Option[?]]), but the annotation names the
// concrete inner. resolve_type_ann memoized the concrete Box[Option[Int]]
// instance onto the annotation node (tc_produce_struct_instance_tid).
// cg_expect_arg_ann wins when it names this struct (a call-arg position);
// otherwise cg_let_target_ann. Falls back to the literal node's own tid.
// Returns -1 when no memoized tid names this struct.
fn tid_native_struct_inst_tid(node: Int, sname: Str) -> Int {
    let mut inst_tid = -1
    if cg_expect_arg_ann != -1 && strip_module_qualifier(node_name(cg_expect_arg_ann)) == sname {
        inst_tid = tc_lookup_node_tid(cg_expect_arg_ann)
    } else if cg_let_target_ann != -1 && strip_module_qualifier(node_name(cg_let_target_ann)) == sname {
        inst_tid = tc_lookup_node_tid(cg_let_target_ann)
    }
    if inst_tid < 0 || tc_tid_struct(inst_tid) != sname {
        inst_tid = tc_lookup_node_tid(node)
    }
    if inst_tid < 0 { return -1 }
    if tc_tid_struct(inst_tid) != sname { return -1 }
    inst_tid
}

fn tid_native_struct_mono_args(node: Int, sname: Str) -> Str {
    let inst_tid = tid_native_struct_inst_tid(node, sname)
    if inst_tid < 0 { return "" }
    let count = tc_tid_struct_arg_count(inst_tid)
    if count < 1 { return "" }
    let mut has_compound = 0
    let mut i = 0
    while i < count {
        let slot = tc_tid_struct_arg_tid(inst_tid, i)
        if tc_tid_compound_slot_faithful(slot) {
            has_compound = 1
        } else if !tid_slot_is_plain_scalar(slot) {
            // A struct-instance / compound-of-struct / list / tuple slot — the
            // string path (which reuses the field's registered mono name) stays
            // authoritative. Bail so a mixed instance is never half-lowered.
            return ""
        }
        i = i + 1
    }
    if has_compound == 0 { return "" }
    let mut args = ""
    let mut j = 0
    while j < count {
        if j > 0 { args = args.concat(",") }
        args = args.concat(tc_tid_to_c_tag(tc_tid_struct_arg_tid(inst_tid, j)))
        j = j + 1
    }
    args
}

// Recover the per-slot arg tids for a struct-INSTANCE tid, gated on
// tc_struct_slot_encodable exactly like register_struct_instance_from_tid
// (codegen.bl:315-319): an encodable scalar / bare struct slot carries its real
// tid, an unencodable slot (struct-instance, module-qualified, typevar) stores
// -1 so the def-side emitter falls back to the string seg. Returns [] unless the
// tid names `expected_base` with exactly `expected_count` args — so a mismatched
// or absent memoized tid degrades to the string path (byte-identical), never
// half-lowers a mismatched instance (br dhrpxw / the -1-hole regression guards).
fn mono_instance_arg_tids_from_tid(inst_tid: Int, expected_base: Str, expected_count: Int) -> List[Int] {
    let mut out: List[Int] = []
    if inst_tid < 0 { return out }
    if tc_tid_struct(inst_tid) != expected_base { return out }
    let count = tc_tid_struct_arg_count(inst_tid)
    if count != expected_count { return out }
    let mut i = 0
    while i < count {
        let slot = tc_tid_struct_arg_tid(inst_tid, i)
        if tc_struct_slot_encodable(slot) {
            out.push(slot)
        } else {
            out.push(-1)
        }
        i = i + 1
    }
    out
}

// Register the mono instance for a generic-enum construction (`Branch(Leaf(1),…)`)
// and return its mono C-name STEM (`Tree_Int`), so ctor/match can emit the mono
// typedef name (blink_Tree_Int) instead of the erased bare `Tree` (jjhnf3). Reads the
// enum-instance tid typecheck memoized onto the construction node (tc_lookup_node_tid);
// returns "" (defer to the bare path) when the node carries no concretely-encodable
// generic-enum instance. Mirrors register_enum_instance_from_tid but lives here to
// avoid a codegen_expr→codegen_stmt import cycle. `expected_base` guards against a
// mismatched memoized tid — the registered instance must name this variant's enum.
fn register_mono_enum_from_node(node: Int, expected_base: Str) -> Str ! Codegen.Register {
    let inst_tid = tc_lookup_node_tid(node)
    if inst_tid < 0 { return "" }
    if tc_tid_is_enum(inst_tid) == 0 { return "" }
    if tc_tid_struct(inst_tid) != expected_base { return "" }
    let count = tc_tid_struct_arg_count(inst_tid)
    if count < 1 { return "" }
    // Require the whole instance to spell concretely (mono name non-empty) — an
    // unencodable slot (an unsubstituted typevar) keeps the bare path.
    if tc_tid_struct_mono_name(inst_tid) == "" { return "" }
    let mut args = ""
    let mut arg_tids: List[Int] = []
    let mut i = 0
    while i < count {
        let slot = tc_tid_struct_arg_tid(inst_tid, i)
        let mut seg = ""
        if tc_tid_struct_arg_count(slot) >= 1 {
            seg = tc_tid_struct_mono_name(slot)
        } else {
            seg = tc_tid_struct_slot_seg(slot)
        }
        if seg == "" { return "" }
        if i > 0 { args = args.concat(",") }
        args = args.concat(seg)
        if tc_struct_slot_encodable(slot) {
            arg_tids.push(slot)
        } else {
            arg_tids.push(-1)
        }
        i = i + 1
    }
    register_mono_instance(expected_base, args, arg_tids)
}

// A slot tid whose tc_tid_to_c_tag is a plain scalar Pascal tag (Int/Str/…). Kept
// local so the compound-args gate can pass scalar slots through unchanged while
// bailing on anything structural.
fn tid_slot_is_plain_scalar(slot: Int) -> Bool {
    if slot < 0 { return false }
    let ct = tc_tid_ct(slot)
    if ct == CT_INT || ct == CT_FLOAT || ct == CT_BOOL || ct == CT_STRING || ct == CT_CHAR { return true }
    is_sized_int_ct(ct) != 0
}

// Whether `name` is one of the declared type-params in tparams_sl — i.e. still an
// unresolved typevar after resolve_tparam (the caller is generic).
fn tparams_sl_contains(tparams_sl: Int, name: Str) -> Int {
    if tparams_sl == -1 { return 0 }
    let mut i = 0
    while i < sublist_length(tparams_sl) {
        if node_name(sublist_get(tparams_sl, i)) == name { return 1 }
        i = i + 1
    }
    0
}

// Register the mono instance for a generic Map's value/key struct at the generic-fn
// call tail (br h0n5qe). The Map-return branch computes the value-struct NAME
// (Box_Int) but, without this, never registers a mono instance for it — so the
// struct typedef is never emitted, struct_reg_set lacks it, and
// emit_struct_option_typedef falls through to `void* value`. register_mono_instance
// dedups on (phys_base, args), so this is byte-neutral when the body already
// registered the same instance.
//
// ANNOTATED branch: build mono_args the SAME way mono_name_from_ann does (the
// annotation's elements through resolve_tparam), so the registered c_name
// byte-matches the map_ret_val_struct name the annotated branch already published.
// Skips when the type has no tparams / the annotation has no elements / an arg is
// still an unresolved typevar (a caller that itself is generic — the pure-generic
// caller edge is out of scope, tracked separately). arg_tids come off the return
// tid's matching slot so encodable slots lower off tids.
fn register_map_elem_struct_mono(base: Str, ann: Int, tparams_sl: Int, ta_str: Str, slot_tid: Int) ! Codegen.Register {
    let td = find_type_def_node(base)
    if td == -1 { return }
    let td_tparams = node_type_params(td)
    if td_tparams == -1 || sublist_length(td_tparams) == 0 { return }
    if ann == -1 { return }
    let elems = node_elements(ann)
    if elems == -1 || sublist_length(elems) == 0 { return }
    // Per-element concrete tids off the slot instance, hoisted above the loop so
    // each arg resolves tid-first (byte-identical to resolve_tparam's CSV segment
    // for every encodable slot) and reuse the same list for the
    // register_mono_instance call below. arg_tids is aligned to the ANNOTATION's
    // arg positions, so resolve by element index (resolve_arg_seg_via_slot_tid),
    // NOT by type-param position.
    let arg_tids = mono_instance_arg_tids_from_tid(slot_tid, base, sublist_length(elems))
    let mut mono_args = ""
    let mut ai = 0
    while ai < sublist_length(elems) {
        let elem = sublist_get(elems, ai)
        let resolved_arg = resolve_arg_seg_via_slot_tid(ai, node_name(elem), tparams_sl, ta_str, arg_tids)
        // An arg still spelled as a declared type-param means the caller is itself
        // generic (no concrete binding here); registering would produce a bogus
        // typevar-named instance. Defer (the pure-generic-caller edge, br follow-up).
        if tparams_sl_contains(tparams_sl, resolved_arg) != 0 { return }
        if ai > 0 { mono_args = mono_args.concat(",") }
        mono_args = mono_args.concat(resolved_arg)
        ai = ai + 1
    }
    register_mono_instance(base, mono_args, arg_tids)
}

// Register the mono instance for a generic Map's value/key struct off the raw slot
// tid (br h0n5qe, bare-typevar `-> T` branch). The slot tid carries the full
// concrete instance shape, so the args CSV is built via tc_tid_struct_slot_seg —
// byte-identical to how tc_tid_struct_mono_name (which produced the published
// map_ret_val_struct name) spells each slot. A nested instance slot (Box[Box[Int]])
// is registered RECURSIVELY first so its typedef precedes the outer that embeds it,
// mirroring register_struct_instance_from_tid (codegen.bl) — that superset lives in
// codegen.bl, above this module in the import graph, so it can't be shared without a
// cycle (dedup follow-up filed). A non-instance slot (scalar value, bare generic
// base, absent tid) has arg_count 0 → no-op.
fn register_map_elem_struct_mono_from_tid(slot_tid: Int) ! Codegen.Register {
    let _name = register_map_elem_struct_mono_from_tid_named(slot_tid)
}

// Registers a struct-instance slot (and its nested instances, inner-first) and
// RETURNS its mono name — the CSV segment a parent embeds. A nested instance slot
// (Box[Box[Int]]) recurses so the inner typedef precedes the outer that embeds it,
// mirroring register_struct_instance_from_tid (codegen.bl); that superset lives
// above this module in the import graph, so it can't be shared without a cycle
// (dedup follow-up filed). Returns "" for an unencodable/non-instance slot (scalar,
// bare generic base, typevar, module-qualified) so the parent bails identically to
// the def-side string path.
fn register_map_elem_struct_mono_from_tid_named(slot_tid: Int) -> Str ! Codegen.Register {
    if slot_tid < 0 { return "" }
    let base = tc_tid_struct(slot_tid)
    if base == "" { return "" }
    let count = tc_tid_struct_arg_count(slot_tid)
    if count < 1 { return "" }
    let mut mono_args = ""
    let mut i = 0
    while i < count {
        let slot = tc_tid_struct_arg_tid(slot_tid, i)
        let seg = if tc_tid_struct_arg_count(slot) >= 1 {
            register_map_elem_struct_mono_from_tid_named(slot)
        } else {
            tc_tid_struct_slot_seg(slot)
        }
        if seg == "" { return "" }
        if i > 0 { mono_args = mono_args.concat(",") }
        mono_args = mono_args.concat(seg)
        i = i + 1
    }
    let arg_tids = mono_instance_arg_tids_from_tid(slot_tid, base, count)
    register_mono_instance(base, mono_args, arg_tids)
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_struct_lit(node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let raw_sname = node_type_name(node)
    let sname = strip_module_qualifier(raw_sname)

    // raw_sname contains a dot when this is Enum.Variant { ... }; sname is the variant name only.
    // A BARE name (no dot) may still be a struct-style enum-variant construction — resolve_variant
    // maps it to its enum. We take the tagged-union path for both qualified and resolvable-bare
    // variants so bare and qualified emit byte-identical C; otherwise a bare variant would fall
    // through to a plain struct initializer below (wrong output).
    let dot_pos = raw_sname.index_of(".")
    let resolved_variant = resolve_variant(sname)
    if dot_pos >= 0 || resolved_variant != "" {
        // Prefer the resolved enum; for a qualified name with no resolution fall back to the prefix.
        let variant_enum = if resolved_variant != "" { resolved_variant } else { raw_sname.substr(0, dot_pos) }
        let vidx = get_variant_index(variant_enum, sname)
        if variant_enum != "" && is_data_enum(variant_enum) != 0 && vidx >= 0 {
            let tag = get_variant_tag(variant_enum, sname)
            let flds_sl_sv = node_fields(node)
            let enum_c_name = c_type_c_name(variant_enum)
            // Resolve this variant's field-def sublist so bare `None` fields
            // adopt their declared Option[T] carrier instead of defaulting to
            // Option[int] (bug 264p4n). node_fields(vnode) is the same shape
            // struct_field_type_ann consumes (typecheck.bl:742-752).
            let enum_td = find_type_def_node(variant_enum)
            let mut variant_flds = -1
            if enum_td != -1 {
                let variants_sl = node_fields(enum_td)
                if variants_sl != -1 {
                    let mut vj = 0
                    while vj < sublist_length(variants_sl) {
                        let vnode = sublist_get(variants_sl, vj)
                        if node_name(vnode) == sname {
                            variant_flds = node_fields(vnode)
                            break
                        }
                        vj = vj + 1
                    }
                }
            }
            let mut init_str = "({enum_c_name})\{.tag = {tag}"
            if flds_sl_sv != -1 && sublist_length(flds_sl_sv) > 0 {
                init_str = init_str.concat(", .data.{sname} = \{")
                let mut fi = 0
                while fi < sublist_length(flds_sl_sv) {
                    if fi > 0 {
                        init_str = init_str.concat(", ")
                    }
                    let sf = sublist_get(flds_sl_sv, fi)
                    let field_name = node_name(sf)
                    let saved_arg_ann = cg_expect_arg_ann
                    cg_expect_arg_ann = struct_field_type_ann(variant_flds, field_name)
                    emit_expr(node_value(sf))
                    cg_expect_arg_ann = saved_arg_ann
                    let arg_str = expr_result_str
                    let field_type = get_variant_field_type_str(vidx, fi)
                    if field_type.is_some() && field_type.unwrap() == variant_enum {
                        let box_tmp = fresh_temp("_ebox")
                        emit_line("{enum_c_name}* {box_tmp} = ({enum_c_name}*)blink_alloc(sizeof({enum_c_name}));")
                        emit_line("*{box_tmp} = {arg_str};")
                        init_str = init_str.concat(".{field_name} = (int64_t)(intptr_t){box_tmp}")
                    } else {
                        init_str = init_str.concat(".{field_name} = {arg_str}")
                    }
                    fi = fi + 1
                }
                init_str = init_str.concat("}")
            }
            init_str = init_str.concat("}")
            expr_result_str = init_str
            expr_result_type = CT_STRUCT
            set_var_struct(init_str, variant_enum)
            return
        }
    }

    let mut c_type = c_type_c_name(sname)
    let tmp = fresh_temp("_s")
    let flds_sl = node_fields(node)
    let td = find_type_def_node(sname)
    let td_flds = if td != -1 { node_fields(td) } else { -1 }
    // When the enclosing `let` target names this struct with concrete type
    // arguments (`let b: GKV[Int, Str] = ..`), push them as the mono context for
    // the duration of the field loop. A container field built from an empty
    // ctor (`m: Map()`) has no field VALUE to infer its element type from, so
    // resolve_ctor_kops_elem would see the field's key/elem typevar unresolved
    // and fall to the string kops default → int keys hashed as strings collide
    // (hnyqe4). With the struct's tparams bound here, resolve_tparam maps K→Int
    // at the ctor and the right kops vtable is selected. (No-op when the target
    // isn't annotated; the field-value inference below still runs as fallback.)
    let target_args = struct_concrete_args_from_target(sname, segs_from_arg_tids(cg_mono_arg_tids))
    let td_tparams = if td != -1 { node_type_params(td) } else { -1 }
    let saved_mono_tparams = cg_mono_tparams_sl
    let saved_mono_args = cg_mono_concrete_args
    // Struct-lit field emission derives its mono context from the string target
    // args, not a tid list — clear cg_mono_arg_tids so the group-A compound-inner
    // sites reached during field emission fall back to the string path instead of
    // reading a stale tid list from an enclosing generic-fn body.
    let saved_mono_arg_tids = cg_mono_arg_tids
    cg_mono_arg_tids = []
    if target_args != "" && td_tparams != -1 && sublist_length(td_tparams) > 0 {
        cg_mono_tparams_sl = td_tparams
        cg_mono_concrete_args = target_args
    }
    let mut inits = ""
    let mut field_types: List[Int] = []
    let mut field_structs: List[Str] = []
    let mut provided_fields: List[Str] = []
    let mut _init_count = 0
    let mut spread_tmp = ""
    if flds_sl != -1 {
        let mut i = 0
        while i < sublist_length(flds_sl) {
            let sf = sublist_get(flds_sl, i)
            if node_kind(sf) == NodeKind.SpreadExpr {
                emit_expr(node_value(sf))
                spread_tmp = expr_result_str
                i = i + 1
                continue
            }
            let fname = node_name(sf)
            provided_fields.push(fname)
            let saved_arg_ann = cg_expect_arg_ann
            cg_expect_arg_ann = struct_field_type_ann(td_flds, fname)
            emit_expr(node_value(sf))
            cg_expect_arg_ann = saved_arg_ann
            let val_str = expr_result_str
            field_types.push(expr_result_type)
            // Capture the struct-instance's already-registered mono name (e.g.
            // "Box_Int") so a struct-valued generic field infers its concrete
            // inner instead of collapsing to type_name_from_ct(CT_STRUCT)="Void"
            // (br 3xvjcy). Reuses the exact string the field's own literal
            // registered via set_var_struct, so no re-spelling divergence.
            if expr_result_type == CT_STRUCT {
                field_structs.push(get_var_struct(val_str))
            } else {
                field_structs.push("")
            }
            if _init_count > 0 {
                inits = inits.concat(", ")
            }
            inits = inits.concat(".{fname} = {val_str}")
            _init_count = _init_count + 1
            i = i + 1
        }
    }
    if spread_tmp != "" {
        let mut si = 0
        while si < sf_entries.len() {
            let sfe = sf_entries.get(si).unwrap()
            if sfe.struct_name == sname {
                let mut found = 0
                let mut pi = 0
                while pi < provided_fields.len() {
                    if provided_fields.get(pi).unwrap() == sfe.field_name {
                        found = 1
                        break
                    }
                    pi = pi + 1
                }
                if found == 0 {
                    if _init_count > 0 {
                        inits = inits.concat(", ")
                    }
                    inits = inits.concat(".{sfe.field_name} = {spread_tmp}.{sfe.field_name}")
                    provided_fields.push(sfe.field_name)
                    field_types.push(sfe.field_type)
                    if sfe.field_type == CT_STRUCT {
                        field_structs.push(sfe.stype)
                    } else {
                        field_structs.push("")
                    }
                    _init_count = _init_count + 1
                }
            }
            si = si + 1
        }
    }
    let mut di = 0
    while di < struct_field_defaults.len() {
        let dfl = struct_field_defaults.get(di).unwrap()
        if dfl.struct_name == sname {
            let mut found = 0
            let mut pi = 0
            while pi < provided_fields.len() {
                if provided_fields.get(pi).unwrap() == dfl.field_name {
                    found = 1
                    break
                }
                pi = pi + 1
            }
            if found == 0 {
                let saved_dfl_arg_ann = cg_expect_arg_ann
                cg_expect_arg_ann = struct_field_type_ann(td_flds, dfl.field_name)
                emit_expr(dfl.default_node)
                cg_expect_arg_ann = saved_dfl_arg_ann
                let dval = expr_result_str
                field_types.push(expr_result_type)
                if expr_result_type == CT_STRUCT {
                    field_structs.push(get_var_struct(dval))
                } else {
                    field_structs.push("")
                }
                if _init_count > 0 {
                    inits = inits.concat(", ")
                }
                inits = inits.concat(".{dfl.field_name} = {dval}")
                _init_count = _init_count + 1
            }
        }
        di = di + 1
    }
    cg_mono_tparams_sl = saved_mono_tparams
    cg_mono_concrete_args = saved_mono_args
    cg_mono_arg_tids = saved_mono_arg_tids
    // The declared let-target args are authoritative when present (they name the
    // instantiation directly); field-VALUE inference is the fallback for an
    // unannotated `let b = GKV { .. }`. Preferring target_args also lets an empty
    // container field (Map()/Set()) monomorphize the struct — register_mono_field_types
    // then records the field's concrete key/value type so per-op recovery agrees
    // with the ctor's kops choice (hnyqe4).
    let mut mono_args = ""
    // Parallel to mono_args: the concrete arg tids for this instance, filled only
    // when the tid-native branch below wins (the string branches leave it [] and
    // the def-side emitter falls back to the string seg). Gated on
    // tc_struct_slot_encodable — an unencodable slot stores -1 (dhrpxw).
    let mut mono_arg_tids: List[Int] = []
    if target_args != "" && td_tparams != -1 && sublist_length(td_tparams) > 0 {
        mono_args = target_args
    } else {
        // A compound-valued generic field (`Box[Option[Int]]`) is lost by both string
        // seams (struct_concrete_args_from_target bails on a compound annotation arg;
        // infer_struct_type_args' bare-typevar-field branch has no compound case →
        // "Void"). Recover it from the instance tid typecheck memoized on this literal
        // (br zrybya). Returns "" for every shape the string path already handles, so
        // the fallback below stays authoritative for scalar / struct-instance fields.
        mono_args = tid_native_struct_mono_args(node, sname)
        if mono_args == "" {
            let type_args = infer_struct_type_args(sname, field_types, field_structs)
            if type_args.is_some() { mono_args = type_args.unwrap() }
        } else {
            // Tid-native path won: recover the parallel slot tids off the SAME
            // instance tid it resolved, so the def-side typedef emitter can lower
            // off tids for the encodable slots (byte-identical to the string seg).
            let inst_tid = tid_native_struct_inst_tid(node, sname)
            mono_arg_tids = mono_instance_arg_tids_from_tid(inst_tid, sname, tc_tid_struct_arg_count(inst_tid))
        }
    }
    let mut struct_key = sname
    if mono_args != "" {
        let mono_name = register_mono_instance(sname, mono_args, mono_arg_tids)
        c_type = c_type_c_name(mono_name)
        struct_key = mono_name
        register_mono_field_types(sname, mono_name, mono_args, mono_arg_tids)
    }
    emit_line("{c_type} {tmp} = \{ {inits} };")
    set_var_struct(tmp, struct_key)
    let mut ii = 0
    while ii < struct_invariants.len() {
        let inv = struct_invariants.get(ii).unwrap()
        if inv.struct_name == sname {
            let old_self = cg_where_self_var
            cg_where_self_var = tmp
            emit_expr(inv.expr_node)
            let inv_cond = expr_result_str
            emit_line("if (!({inv_cond})) \{ fprintf(stderr, \"invariant violated: @invariant on %s\\n\", \"{sname}\"); exit(1); }")
            cg_where_self_var = old_self
        }
        ii = ii + 1
    }
    expr_result_str = tmp
    expr_result_type = CT_STRUCT
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_tuple_lit(node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let elems_sl = node_elements(node)
    if elems_sl == -1 {
        expr_result_str = "0"
        expr_result_type = CT_VOID
        return
    }
    let arity = sublist_length(elems_sl)

    // Plumb per-slot Option[T] target into the fn-level channels: fn return is
    // Tuple (not Option), so cg_current_fn_option_inner stays 0 and a bare None
    // slot would default to Option[int]. Derive parent ann from let-target or
    // fn return-ann; per-slot override drives the bare-None branch in emit_expr.
    let mut parent_elems_sl: Int = -1
    let mut parent_tuple_ann: Int = -1
    if cg_let_target_ann != -1 && node_name(cg_let_target_ann) == "Tuple" {
        let cand = node_elements(cg_let_target_ann)
        if cand != -1 && sublist_length(cand) == arity {
            parent_elems_sl = cand
            parent_tuple_ann = cg_let_target_ann
        }
    }
    if parent_elems_sl == -1 && cg_current_fn_node != -1 && node_return_type(cg_current_fn_node) == "Tuple" {
        let ret_ann = node_type_ann(cg_current_fn_node)
        if ret_ann != -1 {
            let cand = node_elements(ret_ann)
            if cand != -1 && sublist_length(cand) == arity {
                parent_elems_sl = cand
                parent_tuple_ann = ret_ann
            }
        }
    }

    let saved_fn_option_inner = cg_current_fn_option_inner
    let saved_fn_option_inner_struct = cg_current_fn_option_inner_struct
    let mut val_strs: List[Str] = []
    let mut val_types: List[Int] = []
    let mut val_structs: List[Str] = []
    let mut val_compound_tags: List[Str] = []
    let mut i = 0
    while i < arity {
        cg_current_fn_option_inner = saved_fn_option_inner
        cg_current_fn_option_inner_struct = saved_fn_option_inner_struct
        if parent_elems_sl != -1 {
            let slot_ann = sublist_get(parent_elems_sl, i)
            if node_name(slot_ann) == "Option" {
                let slot_inner_elems = node_elements(slot_ann)
                if slot_inner_elems != -1 && sublist_length(slot_inner_elems) >= 1 {
                    let inner_ann = sublist_get(slot_inner_elems, 0)
                    let inner_name = node_name(inner_ann)
                    if is_named_typedef_tag(inner_name) != 0 {
                        cg_current_fn_option_inner = CT_INT
                        cg_current_fn_option_inner_struct = inner_name
                    } else {
                        cg_current_fn_option_inner = type_from_name(inner_name)
                        cg_current_fn_option_inner_struct = ""
                    }
                }
            }
        }
        let saved_arg_ann = cg_expect_arg_ann
        // A nested-tuple slot literal reads its own C type from cg_let_target_ann.
        // Retarget it to the slot annotation for the recursion so the inner literal
        // resolves to the inner tuple type, not the still-live OUTER let target
        // (which coincidentally shares arity). Mirrors the Ok/Err payload retarget
        // above. Restore both channels after.
        let saved_let_ann = cg_let_target_ann
        if parent_elems_sl != -1 {
            let slot_ann = sublist_get(parent_elems_sl, i)
            cg_expect_arg_ann = slot_ann
            // Promote to cg_let_target_ann for a compound slot too (br yavhwc). The
            // Some/Ok/Err constructor derives its STRUCTURED value carrier from
            // cg_let_target_ann (the t5nvd4/msqtkd annotation-consult), so a
            // Some(m)/Ok(m) whose inner is a Map or nested compound must see the slot
            // annotation on THAT channel — else it falls to compound_option_inner_name's
            // bare "map" and the value carrier (blink_Option_map) diverges from the
            // structured tuple field (blink_Option_Map_str_int) minted below. Tuple
            // slots were already promoted for the same reason (nested-tuple carrier).
            let slot_nm = node_name(slot_ann)
            if slot_nm == "Tuple" || slot_nm == "Option" || slot_nm == "Result" {
                cg_let_target_ann = slot_ann
            }
        }
        emit_expr(sublist_get(elems_sl, i))
        cg_expect_arg_ann = saved_arg_ann
        cg_let_target_ann = saved_let_ann
        val_strs.push(expr_result_str)
        val_types.push(expr_result_type)
        let mut sn = get_var_struct(expr_result_str)
        if sn == "" {
            sn = get_var_enum(expr_result_str)
        }
        let elem_tid = tc_lookup_node_tid(sublist_get(elems_sl, i))
        // The value path must ride the tid-structured spelling EXACTLY when the typecheck
        // gate (tc_tid_tuple_elem_encodable) says the generic-fn mono will — otherwise the
        // value-constructed tuple and the mono param diverge → void-erased param. Consult
        // the SAME predicate (br yavhwc) so the two paths can never drift: an Option carrier
        // over a Map or nested faithful compound rides; a Result carrier with a DIRECT Map
        // inner (the upgrade_compound_carrier assignment-compat carve-out) and any
        // struct/enum leaf stay on the string CSV. Only meaningful for a compound carrier.
        let elem_rides_tid = elem_tid >= 0 && is_compound_ct(expr_result_type) != 0 && tc_tid_tuple_elem_encodable(elem_tid)
        // For a BARE-VAR compound-carrier element (`let a: Option[Map[Str,Int]] = ...;
        // (a, 7)`), get_var_struct returns the carrier's INNER struct tag (Map_str_int),
        // NOT the carrier — so it would drop the Option/Result wrapper and win over the
        // structured ctag below. When the element rides the tid path, clear sn so the
        // tid-driven ctag path spells the full carrier (Option_Map_str_int). A deferred
        // element keeps its sn and rides the string CSV — no regression.
        if sn != "" && elem_rides_tid { sn = "" }
        val_structs.push(sn)
        let mut ctag = ""
        // The memoized element tid is the structured recursion source: it exists for
        // every node (infer_type memoizes tc_node_tid) and is byte-identical to the tid
        // path by construction. For an Option/Result carrier whose inner is itself a
        // compound (a Map, or a nested Option/Result over faithful leaves), the flat
        // c_type_tag below spells only ONE level (bare "map"/"option"/"result") and would
        // diverge from the tid path (tc_tid_inner_tag recurses) → void-erased mono param.
        // When the element RIDES the tid path (elem_rides_tid = tc_tid_tuple_elem_encodable,
        // the SAME gate the generic-fn mono consults), spell the inner structurally via
        // tc_tid_inner_tag — the SAME speller the tid path uses. Otherwise fall through to
        // the existing one-level spelling (defends un-memoized nodes, deferred cases:
        // struct/enum inners, the Result-direct-Map carve-out → still ride the string CSV).
        // Reads only the tid — no scope or expr_* globals — so the kops-sensitive CT_MAP
        // arm below is untouched. Reconciles the value path with the tid/annotation
        // majority in lockstep with the typecheck gate (br yavhwc).
        if sn == "" && is_compound_ct(expr_result_type) != 0 {
            if expr_result_type == CT_OPTION {
                if elem_rides_tid && tc_tid_ct(elem_tid) == CT_OPTION {
                    ctag = "Option_{tc_tid_inner_tag(tc_tid_option_inner_tid(elem_tid))}"
                } else {
                    let inner_tag = if expr_option_inner_struct != "" { canonical_struct_tag(expr_option_inner_struct) } else { c_type_tag(expr_option_inner) }
                    ctag = "Option_{inner_tag}"
                }
            } else if expr_result_type == CT_RESULT {
                if elem_rides_tid && tc_tid_ct(elem_tid) == CT_RESULT {
                    ctag = "Result_{tc_tid_inner_tag(tc_tid_result_ok_tid(elem_tid))}_{tc_tid_inner_tag(tc_tid_result_err_tid(elem_tid))}"
                } else {
                    let ok_tag = if expr_result_ok_struct != "" { canonical_struct_tag(expr_result_ok_struct) } else { c_type_tag(expr_result_ok_type) }
                    let err_tag = if expr_result_err_struct != "" { canonical_struct_tag(expr_result_err_struct) } else { c_type_tag(expr_result_err_type) }
                    ctag = "Result_{ok_tag}_{err_tag}"
                }
            } else if expr_result_type == CT_MAP {
                // A Map tuple element (br 6kqgnp): spell it Map_{key}_{val} to match
                // the tid path (tc_tid_inner_tag) and the annotation path
                // (compound_name_from_ann); a bare "map" here would diverge and erase
                // the Map param to void. Two sources, because neither covers both cases:
                //   - a bare scope var (`(m, 7)`): the map scope accessors are keyed by
                //     the raw Blink name (c_blink_name undoes c_safe_name for a var
                //     named like a C reserved word). The expr_map_* globals are NOT set
                //     for a bare-var reference (and hold stale values from a prior
                //     emit), so they can't be read here.
                //   - a call/field-returned map (`(make_map(), 7)`): never in
                //     scope_vars, but emit_expr populated the expr_map_* globals with
                //     the true key/val (codegen_expr Map-return + FieldAccess paths).
                // Populating the globals in the Ident path instead perturbs the kops
                // path and breaks the Gen1==Gen2 fixed point, so branch on scope
                // membership rather than unifying the source.
                let map_var = c_blink_name(expr_result_str)
                let mut key_ct = expr_map_key_type
                let mut val_ct = expr_map_val_type
                let mut key_sn = expr_map_key_struct
                let mut val_sn = expr_map_val_struct
                if is_scope_var(map_var) != 0 {
                    key_ct = get_map_key_type(map_var)
                    val_ct = get_map_value_type(map_var)
                    key_sn = get_map_key_struct(map_var)
                    val_sn = get_map_value_struct(map_var)
                }
                let key_tag = if key_sn != "" { canonical_struct_tag(key_sn) } else { c_type_tag(key_ct) }
                let val_tag = if val_sn != "" { canonical_struct_tag(val_sn) } else { c_type_tag(val_ct) }
                ctag = "Map_{key_tag}_{val_tag}"
            }
        }
        val_compound_tags.push(ctag)
        i = i + 1
    }
    let mut tags = ""
    let mut elem_types_enc = ""
    let mut elem_structs_enc = ""
    let mut inits = ""
    i = 0
    while i < arity {
        if i > 0 {
            tags = tags.concat("_")
            elem_types_enc = elem_types_enc.concat(",")
            elem_structs_enc = elem_structs_enc.concat(",")
            inits = inits.concat(", ")
        }
        let vs = val_structs.get(i).unwrap()
        let ctag = val_compound_tags.get(i).unwrap()
        if vs != "" {
            tags = tags.concat(vs)
            elem_structs_enc = elem_structs_enc.concat(vs)
        } else if ctag != "" {
            tags = tags.concat(ctag)
            elem_structs_enc = elem_structs_enc.concat(ctag)
        } else {
            tags = tags.concat(c_type_tag(val_types.get(i).unwrap()))
            elem_structs_enc = elem_structs_enc.concat("-")
        }
        elem_types_enc = elem_types_enc.concat("{val_types.get(i).unwrap()}")
        inits = inits.concat("._{i} = {val_strs.get(i).unwrap()}")
        i = i + 1
    }
    cg_current_fn_option_inner = saved_fn_option_inner
    cg_current_fn_option_inner_struct = saved_fn_option_inner_struct
    // Prefer the canonical tuple name from the parent annotation so Option[T]'s
    // T is preserved; the per-element value tags drop it (get_var_struct returns
    // the inner struct for an Option-typed var), yielding e.g. Tuple2_Model_Cmd
    // with a bare-Cmd field (bug 295z9x, Site C). The inits stay valid — only
    // the type name + field tags now come from the annotation.
    let mut tup_name = ""
    if parent_tuple_ann != -1 {
        let tup_opt = resolve_tuple_ann(parent_tuple_ann, cg_mono_tparams_sl, cg_mono_concrete_args, segs_from_arg_tids(cg_mono_arg_tids))
        if tup_opt.is_some() { tup_name = tup_opt.unwrap() }
    }
    if tup_name == "" {
        tup_name = tuple_c_type_name(tags, arity)
        ensure_tuple_type(tup_name, arity, elem_types_enc, elem_structs_enc)
    }
    let tmp = fresh_temp("_tup")
    emit_line("{c_type_c_name(tup_name)} {tmp} = \{ {inits} };")
    set_var_struct(tmp, tup_name)
    expr_result_str = tmp
    expr_result_type = CT_STRUCT
}
