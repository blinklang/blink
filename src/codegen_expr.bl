// codegen_expr.bl — Expression codegen, closures, capture analysis

// ── Expression codegen ──────────────────────────────────────────────
// Returns (expr_str, type) packed into parallel result slots.
// Since we can't return tuples in the C backend, we use mutable globals.

pub let mut expr_result_str: Str = ""
pub let mut expr_result_type: Int = 0
// Physical result tid twin of expr_result_type. Published at every emit_expr result — each inline
// producer arm and the boundary after each external delegate (emit_method_call/emit_if_expr/
// emit_match_expr/emit_block_expr/emit_with_block_expr/emit_closure, which set the flat CT in
// their own module but cannot publish here) — so any expression elaborated through emit_expr
// carries a fresh twin, and a consumer can read the tid directly instead of recovering it from the
// node's LOGICAL mono tid (which mis-spells erased storage slots). Scalar results carry the
// canonical singleton (physically exact); aggregates carry the node's own tid, or -1 when no node
// is in scope (the nodeless carrier helpers, whose aggregate results no tid consumer reads yet).
pub let mut expr_result_tid: Int = -1
pub let mut expr_closure_sig: Str = ""
pub let mut expr_option_inner: Int = -1
pub let mut expr_result_ok_type: Int = -1
pub let mut expr_result_err_type: Int = -1
pub let mut expr_result_ok_struct: Str = ""
pub let mut expr_result_err_struct: Str = ""
pub let mut expr_option_inner_struct: Str = ""
pub let mut expr_list_elem_type: Int = -1
pub let mut expr_list_elem_struct: Str = ""
pub let mut expr_map_key_type: Int = -1
pub let mut expr_map_val_type: Int = -1
pub let mut expr_map_val_struct: Str = ""
pub let mut expr_map_key_struct: Str = ""
pub let mut expr_option_is_none: Int = 0
// 1 iff the just-emitted expr's Option value is physically ptr-erased to the shared
// handler-vtable ABI (blink_Option_ptr box) while expr_option_inner/_struct carry the
// TRUE logical inner. Consumers reassert the erased carrier and cast the void* payload.
pub let mut expr_option_erased: Int = 0
pub let mut expr_option_inner_list_elem: Int = -1
pub let mut expr_option_inner_list_struct: Str = ""
pub let mut expr_option_inner_map_val_struct: Str = ""
pub let mut expr_option_inner_map_val_list_elem: Int = -1
// The full inner tp NODE of a compound List element read back by
// List[Option[C]].get()/pop() (the `Map[Int,Str]` / `List[Int]` tp inside the
// element Option/Result). Carries a NESTED container's own type params — which
// the single-slot inner2 channels can't — so the match arm that unwraps to `mm`
// stamps the Map's K/V (or the List's element) onto `mm` via set_map_types /
// set_list_elem_*. -1 when the element inner is a plain scalar/struct.
pub let mut expr_option_inner_tp: Int = -1
pub let mut expr_iter_next_fn: Str = ""

let mut embed_byte_lut: List[Str] = []

fn ensure_embed_lut() {
    if embed_byte_lut.len() > 0 { return }
    let mut i = 0
    while i < 256 {
        embed_byte_lut.push(",{i}")
        i = i + 1
    }
}

// Helper output for iter_from_source
pub let mut ifs_iter_var: Str = ""
pub let mut ifs_next_fn: Str = ""
pub let mut ifs_elem_type: Int = 0
pub let mut ifs_opt_type: Str = ""
// When the list element is a pointer-boxed COMPOUND (Option/Result), the
// iterator is keyed on CT_INT (the value is an intptr_t to the carrier) and this
// holds the concrete carrier tag (`Option_int`, `Result_int_str`,
// `Option_Map_int_str`). Consumers deref `*(blink_<tag>*)(intptr_t)next.value`
// before handing the element to a closure/adapter. Empty for a scalar element.
pub let mut ifs_carrier_tag: Str = ""

// The carrier tag for a List's COMPOUND element (Option/Result), or "" if
// the element isn't a compound. Mirrors the .get()/for-in carrier derivation:
// the receiver's node tid drives the tag first (it hops transparent aliases and
// keeps a nested container inner — `List[Option[Map[Int,Str]]]` → `Option_map`),
// and the flat inner-tp channel (tp_carrier_tag) is the fallback when the tid
// declines. Composes with the compound-element tp NODE above (expr_option_inner_tp).
fn list_compound_carrier_tag(obj_str: Str, elem_type: Int, obj_node: Int) -> Str {
    if elem_type == CT_OPTION {
        // The tid carrier is authoritative — it hops transparent aliases and keeps a
        // nested container inner — so prefer it, falling back to the flat channels only
        // when it declines. The flat scalar channel erases a container inner to a bare
        // Option_int for a field-bound/monomorphized receiver.
        let tid_carrier = list_elem_option_carrier_tag_from_tid(obj_node)
        if tid_carrier != "" { return tid_carrier }
        let oi_tp = get_list_elem_option_inner_tp(obj_str)
        let oi_struct = get_list_elem_option_inner_struct(obj_str)
        let oi_ct = get_list_elem_option_inner(obj_str)
        if oi_tp >= 0 { return "Option_{tp_carrier_tag(oi_tp)}" }
        if oi_struct != "" { return "Option_{c_type_tag_for_struct(oi_struct)}" }
        if oi_ct >= 0 { return "Option_{c_type_tag(oi_ct)}" }
        return "Option_int"
    }
    if elem_type == CT_RESULT {
        // The tid carrier is authoritative and spells both Ok/Err sides at once;
        // prefer it, falling back to the flat channels only when it declines.
        let tid_res_carrier = list_elem_result_carrier_tag_from_tid(obj_node)
        if tid_res_carrier != "" { return tid_res_carrier }
        let rok_tp = get_list_elem_result_ok_tp(obj_str)
        let rerr_tp = get_list_elem_result_err_tp(obj_str)
        let rok_struct = get_list_elem_result_ok_struct(obj_str)
        let rerr_struct = get_list_elem_result_err_struct(obj_str)
        let rok_ct = get_list_elem_result_ok(obj_str)
        let rerr_ct = get_list_elem_result_err(obj_str)
        let ok_tag = if rok_tp >= 0 { tp_carrier_tag(rok_tp) } else if rok_struct != "" { c_type_tag_for_struct(rok_struct) } else if rok_ct >= 0 { c_type_tag(rok_ct) } else { "int" }
        let err_tag = if rerr_tp >= 0 { tp_carrier_tag(rerr_tp) } else if rerr_struct != "" { c_type_tag_for_struct(rerr_struct) } else if rerr_ct >= 0 { c_type_tag(rerr_ct) } else { "str" }
        return "Result_{ok_tag}_{err_tag}"
    }
    ""
}

// Convert a CT_LIST or CT_ITERATOR source into a uniform iterator representation.
// Sets ifs_iter_var (C var name of the iterator struct on the stack),
// ifs_next_fn (C function name to call next), ifs_elem_type, ifs_opt_type.
// For a COMPOUND element, keys the iterator on CT_INT (the pointer
// iterator) and sets ifs_carrier_tag so consumers deref the boxed carrier.
pub fn iter_from_source(obj_str: Str, obj_type: Int, obj_node: Int) ! Codegen.Emit {
    ifs_carrier_tag = ""
    if obj_type == CT_LIST {
        let mut elem_type = get_list_elem_type(obj_str)
        if elem_type == -1 { elem_type = CT_INT }
        let mut carrier = list_compound_carrier_tag(obj_str, elem_type, obj_node)
        // A NAMED BY-VALUE element — a struct, a tuple, or an enum — reaches here as
        // CT_VOID (or as a bare CT_STRUCT/CT_ENUM), and `c_type_tag(CT_VOID)` is "void", so the
        // whole iterator family below would key itself on the undefined
        // blink_ListIterator_void / blink_Option_void and escape to cc with no Blink span.
        // Route it the same way an Option/Result element is already routed: those are
        // pointer-boxed in a list slot, and so is a struct, a tuple, and a data enum. A plain
        // enum is value-boxed like an Int instead, so it takes the scalar path as CT_INT —
        // everything downstream of a carrier tag derefs it, which for an ordinal would be wrong.
        if carrier == "" && (elem_type == CT_VOID || elem_type == CT_STRUCT || elem_type == CT_ENUM) {
            let ne = list_named_elem_of(obj_str)
            if ne.plain_enum { elem_type = CT_INT }
            else if ne.tag != "" { carrier = ne.tag }
        }
        if carrier != "" {
            // Pointer-boxed compound element: iterate via the generic pointer
            // iterator (values = intptr_t) and expose the carrier tag for the deref.
            ensure_carrier_from_tag(carrier)
            ensure_iter_type(CT_INT)
            let li_type = list_iter_c_type(CT_INT)
            let iter_var = fresh_temp("__src_iter_")
            emit_line("{li_type} {iter_var} = blink_list_into_iter_int({obj_str});")
            ifs_iter_var = iter_var
            ifs_next_fn = "{li_type}_next"
            ifs_elem_type = CT_INT
            ifs_opt_type = option_c_type(CT_INT)
            ifs_carrier_tag = carrier
            return
        }
        ensure_iter_type(elem_type)
        let tag = c_type_tag(elem_type)
        let li_type = list_iter_c_type(elem_type)
        let iter_var = fresh_temp("__src_iter_")
        emit_line("{li_type} {iter_var} = blink_list_into_iter_{tag}({obj_str});")
        ifs_iter_var = iter_var
        ifs_next_fn = "{li_type}_next"
        ifs_elem_type = elem_type
        ifs_opt_type = option_c_type(elem_type)
    } else {
        ifs_iter_var = obj_str
        ifs_next_fn = get_var_iter_next_fn(obj_str)
        ifs_elem_type = get_var_iterator_inner(obj_str)
        ifs_opt_type = option_c_type(ifs_elem_type)
        // A chained adapter var (`a.take(2).filter(...)`) carries its
        // compound carrier on the iterator var's sname so the next adapter derefs
        // and the terminal collect re-stamps the compound result element.
        ifs_carrier_tag = get_var_iter_carrier(obj_str)
    }
}

fn propagate_enum_struct(name: Str, result_str: Str) {
    if get_var_struct(name) == "" {
        let ve = get_var_enum(name)
        if ve != "" && is_data_enum(ve) != 0 {
            set_var_struct(result_str, ve)
        }
    }
}

// One side of a pushed Result carrier is namable from the element tid when it is a
// leaf scalar or a struct/enum/tuple. A compound inner (Option/Result/Map/List/Set)
// needs the annotation path's upgrade_compound_carrier to embed the structured tag,
// so the tid push path declines and the ctor falls through to its existing handling.
fn result_push_side_namable(ct: Int, s: Str) -> Bool {
    if s != "" { return true }
    if ct == CT_OPTION || ct == CT_RESULT || ct == CT_MAP || ct == CT_LIST || ct == CT_SET { return false }
    ct >= 0
}

// Normalize a Result side to the carrier convention carrier_from_elem_name uses: a
// struct/enum/tuple side rides CT_INT (its name carries the tag; the emit helpers
// box the err value and embed the ok value), while a scalar side keeps its own ct.
fn result_push_side_ct(ct: Int, s: Str) -> Int {
    if s != "" { return CT_INT }
    ct
}

fn emit_ok_result(ok_str: Str, ok_type: Int, err_type: Int, ok_s: Str, err_s: Str) {
    if ok_s != "" || err_s != "" {
        ensure_mixed_result_type(ok_type, err_type, ok_s, err_s)
        let res_type = result_c_type_mixed(ok_type, err_type, ok_s, err_s)
        expr_result_str = "({res_type})\{.tag = 0, .ok = {ok_str}}"
        expr_result_type = CT_RESULT
        publish_result_tid(-1)
        expr_result_ok_type = ok_type
        expr_result_err_type = err_type
        expr_result_ok_struct = ok_s
        expr_result_err_struct = err_s
    } else {
        ensure_result_type(ok_type, err_type)
        let res_type = result_c_type(ok_type, err_type)
        expr_result_str = "({res_type})\{.tag = 0, .ok = {ok_str}}"
        expr_result_type = CT_RESULT
        publish_result_tid(-1)
        expr_result_ok_type = ok_type
        expr_result_err_type = err_type
        expr_result_ok_struct = ""
        expr_result_err_struct = ""
    }
}

// C2: a struct-typed err value is GC-heap boxed and the Result carrier stores
// the pointer (see is_boxed_struct_err). Returns the pointer temp to place in
// `.err`; a non-boxed (scalar / transparent / enum) err passes straight through.
fn box_struct_err(err_str: Str, err_s: Str) -> Str ! Codegen.Emit {
    if is_boxed_struct_err(err_s) == 0 { return err_str }
    let ec = c_type_c_name(err_s)
    let box_tmp = fresh_temp("_errbox_")
    emit_line("{ec}* {box_tmp} = ({ec}*)blink_alloc(sizeof({ec}));")
    emit_line("*{box_tmp} = {err_str};")
    box_tmp
}

fn emit_err_result(err_str: Str, ok_type: Int, err_type: Int, ok_s: Str, err_s: Str) ! Codegen.Emit {
    let err_val = box_struct_err(err_str, err_s)
    if ok_s != "" || err_s != "" {
        ensure_mixed_result_type(ok_type, err_type, ok_s, err_s)
        let res_type = result_c_type_mixed(ok_type, err_type, ok_s, err_s)
        expr_result_str = "({res_type})\{.tag = 1, .err = {err_val}}"
    } else {
        ensure_result_type(ok_type, err_type)
        let res_type = result_c_type(ok_type, err_type)
        expr_result_str = "({res_type})\{.tag = 1, .err = {err_val}}"
    }
    expr_result_type = CT_RESULT
    publish_result_tid(-1)
    expr_result_ok_type = ok_type
    expr_result_err_type = err_type
    expr_result_ok_struct = ok_s
    expr_result_err_struct = err_s
}

// Render the propagated error `E` for a test-body `?` (spec §2.20 / §3c.2).
// Delegates to the shared `render_result_arm_value` (codegen_types.bl), which
// also backs the unwrap/unwrap_err panic-message rendering: builtin scalars
// coerce directly; struct/enum err types with `impl Display` render through the
// synthesized sealed `{T}_display`. Typecheck's E0514 gate guarantees a Display
// impl exists at this point; the placeholder remains only as a defensive
// fallback for any err type that reaches here without one.
fn test_render_err_message(err_ct: Int, err_struct: Str, err_expr: Str) -> Str ! Codegen.Emit {
    render_result_arm_value(err_ct, err_struct, err_expr)
}

fn test_err_type_display_name(err_ct: Int, err_struct: Str) -> Str {
    if err_ct == CT_STRING { return "Str" }
    if err_ct == CT_INT { return "Int" }
    if err_ct == CT_BOOL { return "Bool" }
    if err_ct == CT_FLOAT { return "Float" }
    if err_ct == CT_CHAR { return "Char" }
    if err_struct != "" { return err_struct }
    "<error>"
}

fn set_bare_none_struct_result(inner_tag: Str) {
    let opaque_c = opaque_handle_c_name(inner_tag)
    if opaque_c != "" {
        // @ffi.opaque inner: None is the null handle pointer, not a tagged carrier.
        expr_result_str = "(({opaque_c})0)"
        expr_result_type = CT_OPTION
        publish_result_tid(-1)
        expr_option_inner = CT_INT
        expr_option_inner_struct = inner_tag
        return
    }
    ensure_struct_option_type(inner_tag)
    let opt_type = struct_option_c_type(inner_tag)
    expr_result_str = "({opt_type})\{.tag = 0}"
    expr_result_type = CT_OPTION
    publish_result_tid(-1)
    expr_option_inner = CT_INT
    expr_option_inner_struct = inner_tag
}

fn closure_ret_tag_is_recognized(sname: Str) -> Int {
    if sname.starts_with("Option_") { return 1 }
    if sname.starts_with("Result_") { return 1 }
    if resolve_struct_from_c_name(sname) != "" { return 1 }
    0
}

// Reseat expr globals from a closure return type tag (`Option_X`, `Result_X_Y`,
// or a struct name). Returns 1 if `sname` was recognized as a compound/struct,
// 0 otherwise (caller falls back to closure_ret_ct).
fn reseat_from_closure_ret_tag(sname: Str, tmp: Str) -> Int ! Codegen.Scope {
    if sname.starts_with("Option_") {
        let inner_ct = option_inner_ct_from_tag(sname)
        let inner_s = option_inner_struct_from_tag(sname)
        expr_result_str = tmp
        expr_result_type = CT_OPTION
        publish_result_tid(-1)
        expr_option_inner = inner_ct
        expr_option_inner_struct = inner_s
        if inner_s != "" {
            ensure_struct_option_type(inner_s)
        } else {
            ensure_option_type(inner_ct)
        }
        return 1
    }
    if sname.starts_with("Result_") {
        let split = split_result_compound(sname)
        expr_result_str = tmp
        expr_result_type = CT_RESULT
        publish_result_tid(-1)
        expr_result_ok_type = type_from_name_tag(split.first)
        expr_result_err_type = type_from_name_tag(split.second)
        expr_result_ok_struct = typedef_tag_or_empty(split.first)
        expr_result_err_struct = typedef_tag_or_empty(split.second)
        return 1
    }
    let resolved = resolve_struct_from_c_name(sname)
    if resolved != "" {
        set_var(tmp, CT_STRUCT, 0)
        set_var_struct(tmp, resolved)
        expr_result_str = tmp
        expr_result_type = CT_STRUCT
        publish_result_tid(-1)
        return 1
    }
    0
}

// Reseat compound-inner expr globals after `?` on `Result[T, E]`.
// `tmp` is the C tmp holding the result; `rok`/`rok_s` describe the Ok payload.
// Downstream let/match needs to know T when it's Option/Result/struct.
fn reseat_after_q_on_result(tmp: Str, rok: Int, rok_s: Str) {
    expr_result_str = "{tmp}.ok"
    if rok == CT_OPTION {
        expr_result_type = CT_OPTION
        publish_result_tid(-1)
        expr_option_inner = option_inner_ct_from_tag(rok_s)
        expr_option_inner_struct = option_inner_struct_from_tag(rok_s)
    } else if rok == CT_RESULT {
        expr_result_type = CT_RESULT
        publish_result_tid(-1)
        let split = split_result_compound(rok_s)
        expr_result_ok_type = type_from_name_tag(split.first)
        expr_result_err_type = type_from_name_tag(split.second)
        expr_result_ok_struct = typedef_tag_or_empty(split.first)
        expr_result_err_struct = typedef_tag_or_empty(split.second)
        return
    } else if rok_s != "" {
        expr_result_type = CT_INT
        publish_result_tid(-1)
        set_var_struct(expr_result_str, rok_s)
    } else {
        expr_result_type = rok
        publish_result_tid(-1)
    }
    expr_result_ok_struct = ""
    expr_result_err_struct = ""
}

// A Set[T] element reached through a type-erased boundary (tuple element or
// struct field) loses its inner type: the carrier is shared across
// monomorphizations, and the struct-field tp_id is reg-side-erased to -1. Both
// the tuple-access and struct-field paths recover it identically from
// typecheck's per-node tid memo, so they share this helper. A -1 elem CT
// (unresolvable inner: typevar/tuple/fn) is a no-op: it leaves the element
// genuinely unset, not defaulted; callers without their own downstream
// diagnostic must treat that as "still unknown", not "some default is fine".
//
// Uses the _resolved twins, not the plain tc_tid_set_elem_ct/_struct.
// An unannotated `Set()`'s element is a fresh metavar (make_metavar,
// TyKind.Unknown with the solution stashed in inner1, never in .kind) that a later
// `insert(x)` binds IN PLACE -- the plain accessors read inner1's raw .kind
// without following that bind, so a perfectly-solved element still reads back
// as -1. Every caller of this helper wants the concrete backing type for
// codegen bookkeeping, so resolving is always correct here. The deferral the
// plain accessors exist for is a concern for other callers, not this one.
pub fn recover_set_elem_from_tid(node: Int, var_name: Str) ! Codegen.Register, Codegen.Scope {
    let etid = tc_lookup_node_tid(node)
    let ect = tc_tid_set_elem_ct_resolved(etid)
    if ect >= 0 {
        set_set_elem_type(var_name, ect)
        let es = tc_tid_set_elem_struct_resolved(etid)
        if es != "" { set_set_elem_struct(var_name, es) }
    }
}

// The Option-wrapped twin of recover_set_elem_from_tid: `var_name` is an
// already-registered CT_OPTION var whose inner is a Set, so the Set's own
// element rides the option's flat inner2 slot (get_var_option_inner2) rather
// than the var's own elem_type/elem_struct channel. `node` is the Set[T]
// annotation node itself (the Option's inner_ann), not the Option annotation.
pub fn recover_option_set_elem_from_tid(node: Int, var_name: Str) ! Codegen.Register, Codegen.Scope {
    let etid = tc_lookup_node_tid(node)
    let ect = tc_tid_set_elem_ct_resolved(etid)
    if ect >= 0 {
        set_var_option_inner2(var_name, ect)
    }
}

// The Map twin of recover_set_elem_from_tid above, for the same
// reason — a generic struct's Map[K,V] field erases identically for every K,V
// (one sf_entry per (struct,field), sv_tp's CT_MAP arm passing an unset key and
// value through as -1), so both key and value must be recovered per-USE from the
// per-node tid memo rather than per-def.
//
// Key uses the _resolved twin: the key is the kops-deciding
// slot, and a bare `Map()`'s key can be a fresh metavar bound in place by a
// later `.insert()`, which the plain accessor cannot see through. Value uses
// the plain (non-resolved) accessor, mirroring tc_tid_map_val_ct's own
// rationale — kops_table_name never looks at the value, so a value that is
// still a genuinely unbound metavar is safe to defer rather than force here.
//
// Gated on BOTH key and value resolving concretely: a Map's tp_id carries one
// combined (key_type, value_type) pair (set_map_types), so a half-known
// answer cannot be committed without either fabricating the other half or
// clobbering an already-correct half. Leaving it erased is the honest answer.
//
// tc_tid_subst_mono mirrors recover_list_elem_from_tid: inside a generic
// FUNCTION body (e.g. `fn unbox[T](b: Box[T]) -> T { b.value }` at T=Map[K,V]),
// the field access's own tid memo still reads back with T a bare typevar
// unless rewritten through this call's binder.
// Canonical tid read for a codegen_expr position, mirroring codegen_stmt's
// cg_node_mono_tid: resolve, then substitute the active mono binders so a
// typevar slot reads back concrete inside a generic body.
fn cg_expr_mono_tid(raw: Int) -> Int {
    tc_tid_subst_mono(tc_tid_resolved(raw), cg_mono_tparams_sl, cg_mono_arg_tids)
}
fn cg_expr_node_mono_tid(node: Int) -> Int {
    cg_expr_mono_tid(tc_lookup_node_tid(node))
}

// Publish expr_result_tid to agree with the flat expr_result_type just assigned. A scalar CT maps
// to its canonical singleton — physically exact even for an erased slot, and the branch a tid
// consumer reads. Any other (aggregate) CT falls back to the node's own mono tid, whose spelling
// for the container itself is physical; pass node = -1 from a nodeless carrier helper (its
// aggregate result feeds no tid consumer) to record -1 rather than call the node accessor.
fn publish_result_tid(node: Int) {
    let s = tc_scalar_tid_for_ct(expr_result_type)
    if s != -1 {
        expr_result_tid = s
    } else {
        expr_result_tid = if node >= 0 { cg_expr_node_mono_tid(node) } else { -1 }
    }
}

fn recover_map_kv_from_tid(node: Int, var_name: Str) ! Codegen.Register, Codegen.Scope {
    let mtid = tc_tid_subst_mono(tc_lookup_node_tid(node), cg_mono_tparams_sl, cg_mono_arg_tids)
    let kct = tc_tid_map_key_ct_resolved(mtid)
    let vct = tc_tid_map_val_ct_resolved(mtid)
    if kct < 0 || vct < 0 { return }
    set_map_types(var_name, kct, vct, tc_tid_map_val_struct_resolved(mtid))
    let ks = tc_tid_map_key_struct_resolved(mtid)
    if ks != "" { set_map_key_struct(var_name, ks) }
    // Same reason as the declared-field stamp: the projected temp has no
    // ScopeVar tid of its own, so get_map_value_* would read the flat channel.
    // The generic-struct-field and tuple-element Map projections both land here.
    if tc_tid_ct(mtid) == CT_MAP { set_var_ty(var_name, mtid) }
}

// The List twin of recover_set_elem_from_tid above, for the same
// reason — a generic struct's List[T] field erases identically for every T
// (one sf_entry per (struct,field): reg_sf_entry is keyed on name, not
// instantiation), so the element must be recovered per-USE from the
// per-node tid memo rather than per-def. Three divergences from the Set
// twin, each load-bearing:
//   - it ALSO writes the global expr_list_elem_type/expr_list_elem_struct
//     channel. The Set twin has no such global; List does, and the
//     for-loop lowering in codegen_stmt.bl reads the global BEFORE the
//     scope var. That global mirror is now ALL this function does — the
//     scope-var writes and the tid case analysis moved to
//     stamp_list_elem_from_tid (codegen_types.bl), because codegen_methods
//     needs the same rule for a list that is an EXPRESSION with no ScopeVar
//     to key, and cannot import from this file: codegen_expr sits
//     DOWNSTREAM of codegen_methods. One rule, one body, two entry points.
//   - a struct/enum element writes (CT_VOID, sname), not the Set twin's
//     bare CT_STRUCT/CT_ENUM — the List house convention (emit_list_lit's
//     tail; the declared-List[T] LetBinding path in codegen_stmt.bl
//     uses the identical (CT_VOID, sname) shape for a struct elem, and for
//     a nested one).
//   - CT_OPTION/CT_RESULT/CT_MAP elements recover their own inner
//     via deep_tp_from_tid instead of re-erasing to Int — a flat
//     set_list_elem_type(CT_OPTION) would lose that inner, which is exactly
//     what deep_tp_from_tid's tp_id tree exists to preserve. CT_SET has a
//     parity target too (emit_list_method's `get`/`pop` CT_SET arms) — its
//     element is flat (E1400 forbids a container Set element), so it
//     recovers via tc_tid_set_elem_ct/_struct straight onto
//     set_list_nested_elem_type/_struct, no deep_tp_from_tid needed.
//     CT_ITERATOR/CT_HANDLE/CT_CHANNEL/CT_BYTES still have no parity target
//     and stay erased on purpose; a flat write there would trade a loud
//     `.get()` error for a link error in for-in instead. Staying erased is
//     the honest answer, not a wrong-but-quiet one.
// A nested List[List[T]] recurses exactly one level into
// set_list_nested_elem_type/_struct, mirroring the declared-path shape in
// codegen_stmt.bl; a second nested List level, or a typevar or fn
// element, is a safe no-op (the -1/"" sentinel already stands).
//
// A DECLINED stamp (ct == -1) must leave the globals alone rather than clear
// them: the caller's existing channel may hold a correct answer from another
// source, and every arm that declines does so precisely because it has nothing
// better to offer.
pub fn recover_list_elem_from_tid(node: Int, var_name: Str) ! Codegen.Register, Codegen.Scope {
    let stamp = stamp_list_elem_from_tid(node, var_name)
    if stamp.ct < 0 { return }
    expr_list_elem_type = stamp.ct
    expr_list_elem_struct = stamp.sname
}

@allow(UnrestoredMutation, IncompleteStateRestore)
pub fn emit_expr(node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let kind = node_kind(node)
    expr_closure_sig = ""
    expr_option_is_none = 0
    expr_option_erased = 0

    if kind == NodeKind.IntLit {
        let s = node_str_val(node)
        if s == "" {
            expr_result_str = "{node_int_val(node)}"
        } else {
            expr_result_str = s
        }
        expr_result_type = CT_INT
        publish_result_tid(node)
        return
    }

    if kind == NodeKind.FloatLit {
        expr_result_str = node_str_val(node)
        expr_result_type = CT_FLOAT
        publish_result_tid(node)
        return
    }

    if kind == NodeKind.BoolLit {
        if node_int_val(node) != 0 {
            expr_result_str = "1"
        } else {
            expr_result_str = "0"
        }
        expr_result_type = CT_BOOL
        publish_result_tid(node)
        return
    }

    if kind == NodeKind.CharLit {
        expr_result_str = "(int32_t){node_str_val(node)}"
        expr_result_type = CT_CHAR
        publish_result_tid(node)
        return
    }

    if kind == NodeKind.Ident {
        let name = node_name(node)
        if (name == "self" || name == "_self") && cg_where_self_var != "" {
            expr_result_str = cg_where_self_var
            expr_result_type = CT_INT
            publish_result_tid(node)
            return
        }
        if name == "result" && cg_ensures_result_var != "" {
            expr_result_str = cg_ensures_result_var
            expr_result_type = CT_INT
            publish_result_tid(node)
            return
        }
        if name == "None" {
            let expect_struct = expect_arg_option_inner_struct()
            if expect_struct != "" {
                set_bare_none_struct_result(expect_struct)
                expr_option_is_none = 1
                return
            }
            // Reassignment (`o = None`) adopts the target var's declared Option carrier
            // — a statement-level reassignment has no cg_expect_arg_ann, so without this
            // the fn-return fallbacks below mint a scalar carrier (blink_Option_int) that
            // C rejects against the target's structured type (blink_Option_P). A
            // struct/compound inner carries its tag in the var-struct slot; a scalar inner
            // routes through the ct branch. Mirrors the annotation path's carrier choice.
            if cg_assign_target_name != "" && get_var_type(cg_assign_target_name) == CT_OPTION {
                if get_var_option_erased(cg_assign_target_name) != 0 {
                    // The target's physical carrier is the erased blink_Option_ptr box;
                    // a None must match it, not the true struct's carrier.
                    ensure_option_type(CT_PTR)
                    let opt_type = option_c_type(CT_PTR)
                    expr_result_str = "({opt_type})\{.tag = 0}"
                    expr_result_type = CT_OPTION
                    publish_result_tid(node)
                    expr_option_inner = get_var_option_inner(cg_assign_target_name)
                    expr_option_inner_struct = get_var_option_inner_struct(cg_assign_target_name)
                    expr_option_erased = 1
                    expr_option_is_none = 1
                    return
                }
                let t_inner_s = get_var_option_inner_tag(cg_assign_target_name)
                if t_inner_s != "" {
                    set_bare_none_struct_result(t_inner_s)
                    expr_option_is_none = 1
                    return
                }
                let t_inner_ct = get_var_option_inner(cg_assign_target_name)
                ensure_option_type(t_inner_ct)
                let opt_type = option_c_type(t_inner_ct)
                expr_result_str = "({opt_type})\{.tag = 0}"
                expr_result_type = CT_OPTION
                publish_result_tid(node)
                expr_option_inner = t_inner_ct
                expr_option_inner_struct = ""
                expr_option_is_none = 1
                return
            }
            let expect_inner_ct = expect_arg_option_inner_ct()
            if expect_inner_ct != CT_VOID {
                ensure_option_type(expect_inner_ct)
                let opt_type = option_c_type(expect_inner_ct)
                expr_result_str = "({opt_type})\{.tag = 0}"
                expr_result_type = CT_OPTION
                publish_result_tid(node)
                expr_option_inner = expect_inner_ct
                expr_option_inner_struct = ""
                expr_option_is_none = 1
                return
            }
            let fsi = get_fn_ret_struct_inner(cg_current_fn_name)
            let fn_rt = get_fn_ret_type(cg_current_fn_name)
            if fsi.ok_struct != "" && cg_current_fn_ret == CT_OPTION && is_opaque_type(fsi.ok_struct) != 0 {
                // @ffi.opaque inner: null handle pointer, no tagged carrier.
                set_bare_none_struct_result(fsi.ok_struct)
            } else if fsi.ok_struct != "" && cg_current_fn_ret == CT_OPTION {
                ensure_struct_option_type(fsi.ok_struct)
                let opt_type = struct_option_c_type(fsi.ok_struct)
                expr_result_str = "({opt_type})\{.tag = 0}"
                expr_result_type = CT_OPTION
                publish_result_tid(node)
                if is_compound_tag(fsi.ok_struct) != 0 {
                    expr_option_inner = type_from_name(fsi.ok_struct.slice(0, fsi.ok_struct.index_of("_")))
                    expr_option_inner_struct = fsi.ok_struct
                } else {
                    expr_option_inner = CT_INT
                    expr_option_inner_struct = fsi.ok_struct
                }
            } else if cg_current_fn_ret == CT_RESULT && fn_rt.inner1 == CT_OPTION && fsi.ok_struct != "" {
                let mut inner_tag = fsi.ok_struct
                if fsi.ok_struct.starts_with("Option_") {
                    inner_tag = fsi.ok_struct.slice(7, fsi.ok_struct.len())
                }
                let inner_ct = type_from_name_tag(inner_tag)
                if is_opaque_type(inner_tag) != 0 {
                    // Result[Option[@ffi.opaque], E]: the ok segment NPO's to the bare
                    // handle word, so None is the null handle pointer, not a carrier.
                    let handle = opaque_handle_c_name(inner_tag)
                    expr_result_str = "(({handle})0)"
                    expr_result_type = CT_OPTION
                    publish_result_tid(node)
                    expr_option_inner = CT_INT
                    expr_option_inner_struct = inner_tag
                } else if is_compound_tag(inner_tag) != 0 || is_struct_type(inner_tag) != 0 || is_enum_type(inner_tag) != 0 {
                    ensure_struct_option_type(inner_tag)
                    let opt_type = struct_option_c_type(inner_tag)
                    expr_result_str = "({opt_type})\{.tag = 0}"
                    expr_result_type = CT_OPTION
                    publish_result_tid(node)
                    expr_option_inner = CT_INT
                    expr_option_inner_struct = inner_tag
                } else {
                    ensure_option_type(inner_ct)
                    let opt_type = option_c_type(inner_ct)
                    expr_result_str = "({opt_type})\{.tag = 0}"
                    expr_result_type = CT_OPTION
                    publish_result_tid(node)
                    expr_option_inner = inner_ct
                    expr_option_inner_struct = ""
                }
            } else if cg_current_fn_option_inner_struct != "" {
                set_bare_none_struct_result(cg_current_fn_option_inner_struct)
            } else {
                let none_inner = if cg_current_fn_option_inner != 0 { cg_current_fn_option_inner } else { CT_INT }
                ensure_option_type(none_inner)
                let opt_type = option_c_type(none_inner)
                expr_result_str = "({opt_type})\{.tag = 0}"
                expr_result_type = CT_OPTION
                publish_result_tid(node)
                expr_option_inner = none_inner
                expr_option_inner_struct = ""
            }
            expr_option_is_none = 1
            return
        }
        let variant_enum2 = resolve_variant(name)
        if variant_enum2 != "" {
            if is_data_enum(variant_enum2) != 0 {
                let tag = get_variant_tag(variant_enum2, name)
                // A payload-less GENERIC-enum variant (`let t: ITree[Int] = INone`) carries no
                // argument to recover the instance type from, and resolve_variant only answers
                // the bare base (`ITree`) — so cast to the bare-base struct tag directly rather
                // than an instance typedef that has nothing to derive it from.
                expr_result_str = "({c_type_c_name(variant_enum2)})\{.tag = {tag}}"
                expr_result_type = CT_STRUCT
                publish_result_tid(node)
                set_var_struct(expr_result_str, variant_enum2)
                return
            }
            expr_result_str = "{c_type_c_name(variant_enum2)}_{name}"
            expr_result_type = CT_INT
            publish_result_tid(node)
            var_enums.push(VarEnumEntry { name: expr_result_str, enum_type: variant_enum2 })
            return
        }
        let safe = c_safe_name(name)
        let cap_idx = get_capture_index(name)
        if cap_idx >= 0 {
            let cap_entry = closure_captures.get(cg_closure_cap_start + cap_idx).unwrap()
            if cap_entry.is_mut != 0 {
                expr_result_str = "(*{safe}_cell)"
                expr_result_type = tp_get_kind(cap_entry.tp_id)
                publish_result_tid(node)
                // A field access resolves its receiver's struct by the EMITTED string, and
                // `(*x_cell)` is no scope var, so without this the field type is CT_VOID: the read
                // declares `void v` and interpolation prints the `<value>` placeholder.
                if expr_result_type == CT_STRUCT {
                    let cap_sname = tp_get_sname(cap_entry.tp_id)
                    if cap_sname != "" { set_var_struct(expr_result_str, cap_sname) }
                }
                return
            }
            expr_result_str = capture_cast_expr(cap_idx)
            expr_result_type = tp_get_kind(cap_entry.tp_id)
            publish_result_tid(node)
            return
        }
        if list_contains_str(mut_captured_vars, name) != 0 {
            let mut is_closure_param = 0
            let mut cpi = 0
            while cpi < closure_param_names.len() {
                if closure_param_names.get(cpi).unwrap() == name {
                    is_closure_param = 1
                }
                cpi = cpi + 1
            }
            if is_closure_param == 0 {
                expr_result_str = "(*{safe}_cell)"
                expr_result_type = get_var_type(name)
                publish_result_tid(node)
                // Same rewrite, enclosing scope: carry the struct identity onto the cell
                // expression so a field read through it keeps its type.
                if expr_result_type == CT_STRUCT {
                    let mc_sname = get_var_struct(name)
                    if mc_sname != "" { set_var_struct(expr_result_str, mc_sname) }
                }
                return
            }
        }
        // Bare-fn-as-value: callers in Call-arg loops set
        // cg_expect_fn_value_sig before each emit_expr when the formal at
        // that position is `fn(...)`. A local var with the same name wins
        // (is_scope_var guard); FFI bail-out keeps unsafe ABI shimming off
        // the table; generics need an explicit closure literal so type-args
        // can flow from context.
        if cg_expect_fn_value_sig != "" && is_scope_var(name) == 0 && is_fn_registered(name) != 0 && is_fn_ffi(name) == 0 {
            if is_generic_fn(name) != 0 {
                diag_error_at(
                    "BareGenericFnAsValue",
                    BARE_GENERIC_FN_AS_VALUE,
                    "cannot pass generic fn '{name}' as a closure value",
                    node,
                    "wrap it in a closure literal that names the type, e.g. `\{x => {name}(x)\}`"
                )
                expr_result_str = "0"
                expr_result_type = CT_INT
                publish_result_tid(node)
                return
            }
            let target_fn_node = get_fn_node(name)
            if target_fn_node != -1 {
                let shim_name = emit_fn_value_shim_if_needed(target_fn_node, c_fn_name(name))
                expr_result_str = "blink_closure_new_typed((void*){shim_name}, NULL, NULL, 0, NULL)"
                expr_result_type = CT_CLOSURE
                publish_result_tid(node)
                expr_closure_sig = cg_expect_fn_value_sig
                return
            }
        }
        let alias = get_var_alias(name)
        if alias != "" {
            expr_result_str = alias
        } else {
            expr_result_str = safe
        }
        expr_result_type = get_var_type(name)
        publish_result_tid(node)
        if expr_result_type == CT_OPTION {
            expr_option_inner = get_var_option_inner(name)
            expr_option_inner_struct = get_var_option_inner_nominal(name)
            // Propagate the var's ptr-erased carrier so a match / ?? / store on this
            // Option var reasserts the blink_Option_ptr box and casts its void* payload.
            expr_option_erased = get_var_option_erased(name)
            // Restore the deep inner tp so a match on this Option var (an
            // `Option[Map[K,V]]` / `Option[List[T]]` unwrapped from a
            // List[compound] element) recovers the nested container's own type
            // params. -1 for a scalar/struct inner — resets any stale value.
            expr_option_inner_tp = get_var_option_inner_tp(name)
            if expr_option_inner == CT_LIST {
                expr_option_inner_list_elem = get_var_option_inner2(name)
                expr_option_inner_list_struct = get_var_option_inner2_struct(name)
            }
            if expr_option_inner == CT_MAP {
                expr_option_inner_map_val_list_elem = get_var_option_inner2(name)
                expr_option_inner_map_val_struct = get_var_option_inner2_struct(name)
            }
        }
        if expr_result_type == CT_RESULT {
            expr_result_ok_type = get_var_result_ok(name)
            expr_result_err_type = get_var_result_err(name)
            expr_result_ok_struct = get_var_result_ok_nominal(name)
            expr_result_err_struct = get_var_result_err_nominal(name)
        }
        if expr_result_type == CT_ITERATOR {
            expr_iter_next_fn = get_var_iter_next_fn(name)
        }
        // Same restore-on-read need as CT_ITERATOR above: emit_expr clears
        // expr_closure_sig on entry and only ever sets it from
        // cg_expect_fn_value_sig, an argument-position hint. An Ident RHS must
        // restore it here too, or `let g = c` stamps g's signature as "" and a
        // later `g(21)` falls through the closure-variable call path into the
        // UndefinedFunction backstop, even though typecheck binds closures to
        // lets fine.
        if expr_result_type == CT_CLOSURE {
            expr_closure_sig = get_var_closure_sig(name)
        }
        if expr_result_type == CT_LIST {
            expr_list_elem_type = get_list_elem_type(name)
            expr_list_elem_struct = get_list_elem_struct(name)
        }
        if expr_result_type == CT_STRUCT {
            propagate_enum_struct(name, expr_result_str)
        }
        return
    }

    if kind == NodeKind.BinOp {
        emit_binop(node)
        return
    }

    if kind == NodeKind.UnaryOp {
        emit_unaryop(node)
        return
    }

    if kind == NodeKind.Call {
        // A Call to `old(...)` inside an @ensures predicate has been
        // pre-snapshotted at fn entry. Emit the snapshot var instead of
        // evaluating the inner expression a second time.
        let _callee = node_left(node)
        if _callee != -1 && node_name(_callee) == "old" && cg_old_snapshot_vars.contains_key("{node}") {
            expr_result_str = cg_old_snapshot_vars.get("{node}").unwrap()
            expr_result_type = CT_INT
            publish_result_tid(node)
            return
        }
        emit_call(node)
        return
    }

    if kind == NodeKind.MethodCall {
        emit_method_call(node)
        publish_result_tid(node)
        return
    }

    if kind == NodeKind.InterpString {
        emit_interp_string(node)
        return
    }

    if kind == NodeKind.IfExpr {
        emit_if_expr(node)
        publish_result_tid(node)
        return
    }

    if kind == NodeKind.FieldAccess {
        let fa_obj = node_obj(node)
        let fa_field = node_name(node)
        if node_kind(fa_obj) == NodeKind.Ident {
            let obj_name = node_name(fa_obj)
            if is_import_module_name(obj_name) != 0 && is_enum_type(obj_name) == 0 && is_struct_type(obj_name) == 0 {
                if is_scope_var(obj_name) == 0 {
                    let resolved_field = resolve_import_alias(fa_field)
                    if is_emitted_let(resolved_field) != 0 {
                        let cname = c_safe_name(resolved_field)
                        expr_result_str = cname
                        expr_result_type = get_var_type(resolved_field)
                        publish_result_tid(node)
                        if expr_result_type == CT_OPTION {
                            expr_option_inner = get_var_option_inner(resolved_field)
                            expr_option_inner_struct = get_var_option_inner_struct(resolved_field)
                            if expr_option_inner == CT_LIST {
                                expr_option_inner_list_elem = get_var_option_inner2(resolved_field)
                                expr_option_inner_list_struct = get_var_option_inner2_struct(resolved_field)
                            }
                            if expr_option_inner == CT_MAP {
                                expr_option_inner_map_val_list_elem = get_var_option_inner2(resolved_field)
                                expr_option_inner_map_val_struct = get_var_option_inner2_struct(resolved_field)
                            }
                        }
                        if expr_result_type == CT_RESULT {
                            expr_result_ok_type = get_var_result_ok(resolved_field)
                            expr_result_err_type = get_var_result_err(resolved_field)
                            expr_result_ok_struct = get_var_result_ok_struct(resolved_field)
                            expr_result_err_struct = get_var_result_err_struct(resolved_field)
                        }
                        if expr_result_type == CT_ITERATOR {
                            expr_iter_next_fn = get_var_iter_next_fn(resolved_field)
                        }
                        if expr_result_type == CT_LIST {
                            expr_list_elem_type = get_list_elem_type(resolved_field)
                            expr_list_elem_struct = get_list_elem_struct(resolved_field)
                        }
                        if expr_result_type == CT_STRUCT {
                            propagate_enum_struct(resolved_field, expr_result_str)
                        }
                        return
                    }
                }
            }
            if is_enum_type(obj_name) != 0 {
                if is_data_enum(obj_name) != 0 {
                    let tag = get_variant_tag(obj_name, fa_field)
                    // A nullary variant of a generic enum (`LL.Nil` → LL[Int]) mono's to
                    // blink_LL_0Int and must register the instance so its typedef is emitted;
                    // mirrors the Call-form constructor. The instance args live on the let/arg
                    // annotation, not the node, so fall back to that channel. A non-generic
                    // enum keeps the bare name.
                    let node_mono = register_mono_enum_from_node(node, obj_name)
                    let mono_name = if node_mono != "" { node_mono } else { register_mono_enum_from_ann(node, obj_name) }
                    let sname = if mono_name != "" { mono_name } else { obj_name }
                    expr_result_str = "({c_type_c_name(sname)})\{.tag = {tag}}"
                    expr_result_type = CT_STRUCT
                    publish_result_tid(node)
                    set_var_struct(expr_result_str, sname)
                    return
                }
                expr_result_str = "{c_type_c_name(obj_name)}_{fa_field}"
                expr_result_type = CT_INT
                publish_result_tid(node)
                var_enums.push(VarEnumEntry { name: expr_result_str, enum_type: obj_name })
                return
            }
        }
        // The enclosing value-context annotation describes the RESULT of this
        // access, not the receiver — one nesting level too high for a struct literal sitting
        // in fa_obj. tid_native_struct_inst_tid matches cg_let_target_ann / cg_expect_arg_ann
        // by BARE STRUCT NAME with no nesting check, so a receiver of the same struct name
        // adopts the annotation one level too high. Clearing the channels outright is too
        // blunt: it also blinds field_ann_at_instance's descent for whatever
        // is nested INSIDE the receiver (a bare Set()/Map() ctor, an Option carrier), which
        // still needs the leaked annotation to resolve correctly. cg_fa_receiver_ctx instead
        // disables ONLY the ann-name match for fa_obj's OWN identity resolution; emit_struct_lit
        // resumes normal (ann-eligible) behavior around every nested recursive emission
        // (field values, defaults, spread), so a struct literal nested inside the receiver
        // is unaffected.
        let saved_fa_receiver_ctx = cg_fa_receiver_ctx
        cg_fa_receiver_ctx = true
        emit_expr(fa_obj)
        cg_fa_receiver_ctx = saved_fa_receiver_ctx
        let obj_str = expr_result_str
        let obj_type_for_fa = expr_result_type
        let mut c_field = fa_field
        if fa_field.len() > 0 {
            let fa_first = fa_field.char_at(0).unwrap()
            if fa_first >= '0' && fa_first <= '9' {
                c_field = "_{fa_field}"
            }
        }
        let fa_accessor = if obj_type_for_fa == CT_PTR { "->" } else { "." }
        expr_result_str = "{obj_str}{fa_accessor}{c_field}"
        let mut fa_type = CT_VOID
        let struct_type = get_var_struct(obj_str)
        // Tuple positional access `t.0`: element types live in the tuple entry
        // (elem_types/elem_structs), not the struct-field registry. Resolve the
        // element CT + compound inner-type globals so a compound element (e.g.
        // Option) can be method-called (`t.0.unwrap()`).
        let fa_first_digit = fa_field.len() > 0 && fa_field.char_at(0).unwrap() >= '0' && fa_field.char_at(0).unwrap() <= '9'
        if struct_type != "" && find_tuple_entry(struct_type) >= 0 && fa_first_digit {
            let tidx = fa_field.to_int()
            let te_struct = tuple_elem_struct(struct_type, tidx)
            let te_ct = tuple_elem_ct(struct_type, tidx)
            if te_struct.starts_with("Option_") {
                fa_type = CT_OPTION
                expr_option_inner = option_inner_ct_from_tag(te_struct)
                expr_option_inner_struct = option_inner_struct_from_tag(te_struct)
            } else if te_struct.starts_with("Result_") {
                fa_type = CT_RESULT
                let rparts = split_result_compound(canonical_struct_tag(te_struct))
                let ok_ct = type_from_name_tag(rparts.first)
                let err_ct = type_from_name_tag(rparts.second)
                expr_result_ok_type = ok_ct
                expr_result_err_type = err_ct
                // A non-scalar (CT_VOID) tag is a struct/enum inner only when
                // it's actually registered as one — mirror the sibling struct
                // branch's positive test rather than treating any unknown tag
                // as a struct name.
                expr_result_ok_struct = if ok_ct == CT_VOID && (is_struct_type(rparts.first) != 0 || is_enum_type(rparts.first) != 0) { rparts.first } else { "" }
                expr_result_err_struct = if err_ct == CT_VOID && (is_struct_type(rparts.second) != 0 || is_enum_type(rparts.second) != 0) { rparts.second } else { "" }
            } else if te_struct != "" && te_struct != "-" {
                fa_type = if is_enum_type(te_struct) != 0 || is_struct_type(te_struct) != 0 { CT_STRUCT } else { te_ct }
                if fa_type == CT_STRUCT { set_var_struct(expr_result_str, te_struct) }
            } else {
                fa_type = te_ct
            }
            // The tuple carrier is type-erased AND shared across
            // monomorphizations ((Set[Int],Int) and (Set[Str],Int) compile to
            // the same carrier), so the element's inner type CANNOT live on
            // te_ct/te_struct. Recover it from typecheck's per-node tid memo,
            // which is keyed by node (this FieldAccess), not by carrier.
            // A LIST element is erased the same way — `Tuple2_str_list` names no element, and
            // `ensure_tuple_type` registers the field tp through `sv_tp(CT_LIST, -1, -1, "")`,
            // which FABRICATES `List[Int]` rather than admitting it knows nothing. But unlike
            // Set and Map, List carries a GLOBAL channel (expr_list_elem_type/_struct) that the
            // let-ladder and the for-loop lowering read directly, so this arm must use the
            // global-writing entry point, not a bare stamp: otherwise a tuple's List element
            // silently inherits whatever the enclosing statement last left in that global,
            // which can point a list iteration or a let-bound copy at the wrong element type.
            // It declines whole (leaving the flat spelling and the existing globals in charge)
            // when the tid cannot name the element faithfully.
            if fa_type == CT_SET {
                recover_set_elem_from_tid(node, expr_result_str)
            } else if fa_type == CT_MAP {
                recover_map_kv_from_tid(node, expr_result_str)
            } else if fa_type == CT_LIST {
                recover_list_elem_from_tid(node, expr_result_str)
            }
            expr_result_type = fa_type
            publish_result_tid(node)
            return
        }
        if struct_type != "" {
            fa_type = get_struct_field_type(struct_type, c_field)
            if fa_type == CT_STRUCT || fa_type == CT_VOID {
                let mi = lookup_mono_base(struct_type)
                if mi.base != "" {
                    let td = find_type_def_node(mi.base)
                    if td != -1 {
                        let td_tparams = node_type_params(td)
                        let td_flds = node_fields(td)
                        if td_flds != -1 && td_tparams != -1 {
                            let mut fi = 0
                            while fi < sublist_length(td_flds) {
                                let f = sublist_get(td_flds, fi)
                                if node_name(f) == fa_field {
                                    let type_ann_node = node_value(f)
                                    if type_ann_node != -1 {
                                        let type_name = node_name(type_ann_node)
                                        let resolved = resolve_tparam_via_tid(type_name, td_tparams, mi.arg_tids)
                                        if resolved == "Option" {
                                            fa_type = CT_OPTION
                                            let inner_elems = node_elements(type_ann_node)
                                            if inner_elems != -1 && sublist_length(inner_elems) >= 1 {
                                                let inner_ann = sublist_get(inner_elems, 0)
                                                let inner_raw = node_name(inner_ann)
                                                let inner_resolved = resolve_tparam_via_tid(inner_raw, td_tparams, mi.arg_tids)
                                                let inner_ct = type_from_name(inner_resolved)
                                                expr_option_inner = inner_ct
                                                expr_option_inner_struct = ""
                                                if is_struct_type(inner_resolved) != 0 || is_enum_type(inner_resolved) != 0 {
                                                    expr_option_inner_struct = inner_resolved
                                                } else if is_compound_ct(inner_ct) != 0 {
                                                    expr_option_inner_struct = compound_name_from_ann(inner_ann)
                                                }
                                                // A monomorphized generic field Option[Set[T]]: register
                                                // expr_result_str as a real CT_OPTION var so `.unwrap()`'s
                                                // get_var_option_inner2 has an entry to read the Set's OWN
                                                // element off of (there is no flat-global twin of
                                                // expr_option_inner_list_elem for Set, by design — see the
                                                // plan's Stage B.8 guardrail). recover_option_set_elem_from_tid
                                                // resolves T via inner_ann's per-node tid, same as the fn-param
                                                // call sites.
                                                if inner_ct == CT_SET {
                                                    set_var_option(expr_result_str, CT_SET)
                                                    recover_option_set_elem_from_tid(inner_ann, expr_result_str)
                                                }
                                            }
                                        } else if resolved == "Result" {
                                            fa_type = CT_RESULT
                                        } else {
                                            let resolved_ct = type_from_name(resolved)
                                            if resolved_ct != CT_VOID {
                                                fa_type = resolved_ct
                                            } else if is_struct_type(resolved) != 0 {
                                                fa_type = CT_STRUCT
                                                set_var_struct(expr_result_str, resolved)
                                                // Twin of the flat-field stamp below: a mono
                                                // generic tparam-substituted field (e.g.
                                                // Box_0Int) carries its name only on sname,
                                                // and set_var_struct's own auto-stamp declines
                                                // for a mangled instance name. Lead with the
                                                // node's mono tid when it round-trips.
                                                let mi_tid = cg_expr_node_mono_tid(node)
                                                if tid_spells_struct(mi_tid, resolved) != 0 { set_var_ty(expr_result_str, mi_tid) }
                                            }
                                        }
                                    }
                                }
                                fi = fi + 1
                            }
                        }
                    }
                }
            }
            let fa_stype = get_struct_field_stype(struct_type, c_field)
            if fa_stype != "" {
                set_var_struct(expr_result_str, fa_stype)
                // The field-access result expression has no ScopeVar of its own —
                // its struct/tuple name lived only on the flat sname channel above.
                // The field node's mono tid is the value's type; stamp it so the tid
                // leads, gated on the reader's own round-trip (tid_struct_name ==
                // fa_stype), so a tid that spells a different shape keeps the flat name.
                let fa_tid = cg_expr_node_mono_tid(node)
                if tid_spells_struct(fa_tid, fa_stype) != 0 { set_var_ty(expr_result_str, fa_tid) }
            }
            if fa_type == CT_CLOSURE {
                let cls_sig = get_struct_field_closure_sig(struct_type, c_field)
                if cls_sig != "" {
                    set_var_closure(expr_result_str, cls_sig, cg_expr_node_mono_tid(node))
                    expr_closure_sig = cls_sig
                }
            }
            if fa_type == CT_LIST || fa_type == CT_OPTION || fa_type == CT_RESULT || fa_type == CT_MAP {
                let fa_tp = get_struct_field_tp_id(struct_type, c_field)
                if fa_tp >= 0 {
                    if fa_type == CT_LIST {
                        let le_sname = tp_child1_sname(fa_tp)
                        if le_sname != "" {
                            set_list_elem_struct(expr_result_str, le_sname)
                            set_list_elem_type(expr_result_str, CT_VOID)
                            expr_list_elem_struct = le_sname
                            expr_list_elem_type = CT_VOID
                        } else {
                            let le_kind = tp_child1_kind(fa_tp)
                            if le_kind != CT_INT {
                                set_list_elem_type(expr_result_str, le_kind)
                            }
                            expr_list_elem_type = le_kind
                            expr_list_elem_struct = ""
                        }
                    } else if fa_type == CT_OPTION {
                        expr_option_inner = tp_child1_kind(fa_tp)
                        let fa_opt_sname = tp_child1_sname(fa_tp)
                        expr_option_inner_struct = if fa_opt_sname != "" { fa_opt_sname } else { "" }
                        // A plain (non-generic) struct field Option[Set[T]]: unlike the
                        // CT_LIST arm above, fa_tp's own child1 (the Set) has no
                        // recover_set_elem_from_tid fallback anywhere in this branch, so
                        // register expr_result_str as a real CT_OPTION var and stamp the
                        // Set's own element via the node's tid — the same mechanism the
                        // mono-substitution arm above and the fn-param call sites use.
                        if expr_option_inner == CT_SET {
                            set_var_option(expr_result_str, CT_SET)
                            let set_tid = tc_tid_option_inner_tid(tc_lookup_node_tid(node))
                            if set_tid >= 0 {
                                let set_ect = tc_tid_set_elem_ct_resolved(set_tid)
                                if set_ect >= 0 {
                                    set_var_option_inner2(expr_result_str, set_ect)
                                }
                            }
                        }
                    } else if fa_type == CT_RESULT {
                        expr_result_ok_type = tp_child1_kind(fa_tp)
                        expr_result_err_type = tp_child2_kind(fa_tp)
                    } else if fa_type == CT_MAP {
                        let mk_type = tp_child1_kind(fa_tp)
                        let mv_type = tp_child2_kind(fa_tp)
                        let mv_struct = tp_child2_sname(fa_tp)
                        // A monomorphized generic-struct field Map[K,V]
                        // reg-erases its typevar value to CT_VOID; set_map_types
                        // keeps any value already resolved by insert rather than
                        // downgrading it on this re-emit.
                        set_map_types(expr_result_str, mk_type, mv_type, mv_struct)
                        // The field-access result temp has no ScopeVar of its own;
                        // its K/V lived only on the flat channel above. Stamp the
                        // node's Map tid so get_map_value_* lead tid-first, gated on
                        // the tid actually resolving to a Map (its own reader decline
                        // guards keep an unspellable value on the flat sname2).
                        let mp_tid = cg_expr_node_mono_tid(node)
                        if tc_tid_ct(mp_tid) == CT_MAP { set_var_ty(expr_result_str, mp_tid) }
                    }
                }
            }
            // Struct-field List[T] on a MONOMORPHIZED generic struct: reg_sf_entry
            // stores one shared sv_tp(CT_LIST, -1, -1, "") per (struct,field), so
            // fa_tp above answers CT_INT for every instantiation (the sv_tp default
            // in codegen_types.bl) — indistinguishable from a genuinely
            // declared List[Int] field. Gate on that exact erasure shape (no tp_id,
            // or a tp_id whose child1 is bare CT_INT with no struct name) before
            // recovering the real element from the per-node tid memo; a declared
            // field's deep tp_from_tid answer (R8) or an already-resolved non-Int
            // child (a genuine List[Int]) must NOT be overwritten.
            if fa_type == CT_LIST {
                let le_tp = get_struct_field_tp_id(struct_type, c_field)
                // A List[Set[T]] field's own element (Set) is knowable straight off
                // reg_sf_entry's shallow one-level tp (sv_tp has no slot for a 2nd
                // level), but the Set's OWN nested element never is -- recover_list_
                // elem_from_tid's CT_SET arm is the only path that stamps
                // set_list_nested_elem_type/_struct, so it must still run even when
                // the outer "List's element is a Set" fact is already correctly
                // known, or a generic fn body's `for s in b.xs { for x in s {...} }`
                // hits the SetElementTypeUnknownAtCodegen ICE on `s`.
                if le_tp < 0 || (tp_child1_sname(le_tp) == "" && tp_child1_kind(le_tp) == CT_INT) || tp_child1_kind(le_tp) == CT_SET {
                    recover_list_elem_from_tid(node, expr_result_str)
                }
            }
            // Struct-field Map[K,V] on a MONOMORPHIZED generic struct: reg_sf_entry
            // stores one shared sv_tp(CT_MAP, -1, -1, "") per (struct,field), so fa_tp
            // above answers the erased shape for every instantiation regardless of the
            // real K,V. sv_tp's CT_MAP arm now passes an unset key/value through as -1
            // (it no longer fabricates CT_STRING/CT_INT), so the erased shape is a key
            // or value whose kind reads back < 0. Gate on that before recovering the
            // real key/value from the per-node tid memo; a genuinely declared field
            // (both kinds resolved >= 0) is left alone, and re-recovering an already-
            // resolved field would be idempotent anyway.
            if fa_type == CT_MAP {
                let mp_tp = get_struct_field_tp_id(struct_type, c_field)
                if mp_tp < 0 || tp_child1_kind(mp_tp) < 0 || tp_child2_kind(mp_tp) < 0 {
                    recover_map_kv_from_tid(node, expr_result_str)
                }
            }
            // Struct-field Set[T]: the monomorphized-generic struct field tp_id
            // is reg-side-erased to -1 (codegen_stmt reg_sf_entry stores
            // sv_tp(ct, -1, -1, "")), and the container tp-read block above only
            // handles LIST/OPTION/RESULT/MAP — so a Set field never gets its
            // element type set there. Recover it from the per-node tid memo,
            // which covers both the generic and non-generic field cases with one
            // mechanism.
            if fa_type == CT_SET {
                recover_set_elem_from_tid(node, expr_result_str)
            }
        }
        expr_result_type = fa_type
        publish_result_tid(node)
        return
    }

    if kind == NodeKind.IndexExpr {
        emit_expr(node_obj(node))
        let obj_str = expr_result_str
        let obj_type = expr_result_type
        emit_expr(node_index(node))
        let idx_str = expr_result_str
        if obj_type == CT_STRING {
            expr_result_str = "blink_str_char_at({obj_str}, {idx_str})"
            expr_result_type = CT_INT
            publish_result_tid(node)
        } else {
            expr_result_str = "{obj_str}[{idx_str}]"
            expr_result_type = CT_INT
            publish_result_tid(node)
        }
        return
    }

    if kind == NodeKind.ListLit {
        emit_list_lit(node)
        return
    }

    if kind == NodeKind.RangeLit {
        expr_result_str = "0"
        expr_result_type = CT_VOID
        publish_result_tid(node)
        return
    }

    if kind == NodeKind.MatchExpr {
        emit_match_expr(node)
        publish_result_tid(node)
        return
    }

    if kind == NodeKind.Block {
        emit_block_expr(node)
        publish_result_tid(node)
        return
    }

    if kind == NodeKind.WithBlock {
        emit_with_block_expr(node)
        publish_result_tid(node)
        return
    }

    if kind == NodeKind.Return {
        if node_value(node) != -1 {
            emit_expr(node_value(node))
            emit_return_with_trace(expr_result_str, cg_current_fn_ret, node_value(node))
        } else {
            emit_trace_exit_void()
            emit_line("return;")
        }
        expr_result_str = "0"
        expr_result_type = CT_VOID
        publish_result_tid(node)
        return
    }

    if kind == NodeKind.TupleLit {
        emit_tuple_lit(node)
        return
    }

    if kind == NodeKind.StructLit {
        emit_struct_lit(node)
        return
    }

    if kind == NodeKind.Closure {
        emit_closure(node)
        publish_result_tid(node)
        return
    }

    if kind == NodeKind.HandlerExpr {
        emit_handler_expr(node)
        return
    }

    if kind == NodeKind.AwaitExpr {
        emit_await_expr(node)
        return
    }

    if kind == NodeKind.AsyncScope {
        emit_async_scope(node)
        return
    }

    if kind == NodeKind.ChannelNew {
        let args_sl = node_args(node)
        if args_sl != -1 && sublist_length(args_sl) > 0 {
            emit_expr(sublist_get(args_sl, 0))
            let cap_str = expr_result_str
            expr_result_str = "blink_channel_new({cap_str})"
        } else {
            expr_result_str = "blink_channel_new(16)"
        }
        expr_result_type = CT_CHANNEL
        publish_result_tid(node)
        return
    }

    if kind == NodeKind.EmbedExpr {
        let embed_path = node_str_val(node)
        let source_dir = path_dirname(diag_source_file)
        let full_path = if source_dir != "" {
            "{source_dir}/{embed_path}"
        } else {
            embed_path
        }
        if file_exists(full_path) != 1 {
            diag_error("FileNotFound", FILE_NOT_FOUND, "#embed file not found: {full_path}", node_line(node), node_col(node), "")
            expr_result_str = "\"\""
            expr_result_type = CT_STRING
            publish_result_tid(node)
            return
        }
        let content = read_file(full_path)
        let var_name = fresh_temp("__embed_")
        ensure_embed_lut()
        let clen = content.len()
        let mut sb = StringBuilder.new()
        sb.write("static const char {var_name}[] = \{")
        if clen > 0 {
            sb.write("{content.byte_at(0)}")
            let mut i = 1
            while i < clen {
                sb.write(embed_byte_lut.get(content.byte_at(i)).unwrap())
                i = i + 1
            }
        }
        sb.write(",0};")
        emit_line(sb.to_str())
        expr_result_str = var_name
        expr_result_type = CT_STRING
        publish_result_tid(node)
        return
    }

    if kind == NodeKind.NamedArg {
        let inner = node_value(node)
        emit_expr(inner)
        return
    }

    expr_result_str = "0"
    expr_result_type = CT_VOID
    publish_result_tid(node)
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_handler_expr(node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let effect_name = node_name(node)
    let methods_sl = node_methods(node)
    let handler_idx = cg_handler_counter
    cg_handler_counter = cg_handler_counter + 1

    let vtable_type = resolve_effect_vtable(effect_name)
    let vtable_field = resolve_effect_field(effect_name)
    let is_user_effect = resolve_effect_is_ue(effect_name)

    if vtable_type == "" {
        emit_line("/* handler for unknown effect: {effect_name} */")
        expr_result_str = "0"
        expr_result_type = CT_VOID
        publish_result_tid(node)
        return
    }

    // Emit a static global for the saved outer vtable (for default delegation)
    let outer_ptr_name = "__handler_{handler_idx}_outer"
    cg_closure_defs.push("static {vtable_type}* {outer_ptr_name} = NULL;")
    cg_closure_defs.push("")

    // Analyze captures across all handler methods.
    // Builtin and user effects share this: both vtable shapes carry a per-op userdata slot.
    let mut handler_caps: List[HandlerCapture] = []
    if methods_sl != -1 && sublist_length(methods_sl) > 0 {
        let mut mci = 0
        while mci < sublist_length(methods_sl) {
            let mc = sublist_get(methods_sl, mci)
            let mc_body = node_body(mc)
            let mc_params = node_params(mc)
            let mc_caps = analyze_captures(mc_body, mc_params)
            let mut cci = 0
            while cci < mc_caps.len() {
                let cname = mc_caps.get(cci).unwrap()
                let mut already = 0
                let mut aci = 0
                while aci < handler_caps.len() {
                    if handler_caps.get(aci).unwrap().name == cname {
                        already = 1
                        break
                    }
                    aci = aci + 1
                }
                // A module-level `let` is NOT a capture. analyze_captures reports every free
                // name that is a scope var, and module globals are scope vars, so without this
                // filter `handler IO { fn log(m: Str) { _target.push(m) } }` over a file-scope
                // `_target` would box the global into the per-op userdata slot — unnecessary,
                // since the static handler fn can see a file-scope C static directly, and wrong:
                // a captured value is a snapshot taken at handler-construction time, so a global
                // mutated after install would read stale through the capture.
                if already == 0 && is_module_global(cname) == 0 {
                    handler_caps.push(HandlerCapture { name: cname, tp_id: get_var_type(cname), struct_name: get_var_struct(cname) })
                }
                cci = cci + 1
            }
            mci = mci + 1
        }
    }
    let has_handler_caps = handler_caps.len() > 0

    // Emit capture struct if multiple captures needed
    let cap_struct_name = "__handler_{handler_idx}_caps"
    if handler_caps.len() > 1 {
        cg_closure_defs.push("typedef struct \{")
        let mut csi = 0
        while csi < handler_caps.len() {
            let cap = handler_caps.get(csi).unwrap()
            let cn = cap.name
            let cap_ct_s = handler_cap_c_type(cap)
            ctype_probe_at(cg_expr_mono_tid(get_var_ty(cn)), "expr_handler_cap_field", cn, cap_ct_s, -1)
            cg_closure_defs.push("    {cap_ct_s} {c_safe_name(cn)};")
            csi = csi + 1
        }
        cg_closure_defs.push("} {cap_struct_name};")
        cg_closure_defs.push("")
    }

    if methods_sl != -1 && sublist_length(methods_sl) > 0 {
        let mut mi = 0
        while mi < sublist_length(methods_sl) {
            let m = sublist_get(methods_sl, mi)
            let mname = node_name(m)
            let static_name = "__handler_{handler_idx}_{mname}"
            let mut param_str = ""
            let params_sl = node_params(m)
            if params_sl != -1 {
                let mut pi = 0
                while pi < sublist_length(params_sl) {
                    if pi > 0 {
                        param_str = param_str.concat(", ")
                    }
                    let p = sublist_get(params_sl, pi)
                    let pname = node_name(p)
                    let ptype = node_type_name(p)
                    let ct = type_from_name(ptype)
                    ctype_probe_at(cg_expr_node_mono_tid(p), "expr_handler_param", pname, c_type_str(ct), p)
                    param_str = param_str.concat("{c_type_str(ct)} {pname}")
                    pi = pi + 1
                }
            }
            if param_str == "" {
                param_str = "void"
            }
            let ret_str = node_return_type(m)
            let ret_type = type_from_name(ret_str)
            let ann_ret_c = resolve_ret_type_from_ann(m)
            let ret_flat = if ann_ret_c != "" { ann_ret_c } else { c_type_str(ret_type) }
            ctype_probe_at(cg_fn_ret_tid(m), "expr_handler_ret", node_name(m), ret_flat, node_type_ann(m))
            let mut ret_c = ret_flat
            let ue_opt_inner_struct = if is_user_effect != 0 && ret_type == CT_OPTION { ue_handler_option_inner_name(m) } else { "" }
            let ue_opt_transparent = ue_opt_inner_struct != "" && is_transparent_newtype(ue_opt_inner_struct) != 0
            let ue_needs_ptr = is_user_effect != 0 && ret_type == CT_OPTION && resolve_option_inner_from_ann(m) == CT_VOID && ue_opt_transparent == 0
            if ue_needs_ptr {
                ret_c = option_c_type(CT_PTR)
            } else if ue_opt_transparent {
                // A transparent newtype has no heap pointer to erase: its Option carrier is a scalar
                // struct, so the wrapper returns the concrete carrier by identity, exactly like a
                // non-UE fn returning Option[Errno]. No boundary boxing.
                ensure_struct_option_type(ue_opt_inner_struct)
                ret_c = struct_option_c_type(ue_opt_inner_struct)
            }
            let mut ue_result_opt_ptr = 0
            if is_user_effect != 0 && ret_type == CT_RESULT {
                let _ta = node_type_ann(m)
                if _ta != -1 {
                    let _elems = node_elements(_ta)
                    if _elems != -1 && sublist_length(_elems) >= 2 {
                        let _ok_ann = sublist_get(_elems, 0)
                        let _ok_name = node_name(_ok_ann)
                        let _ok_t = type_from_name(_ok_name)
                        if _ok_t == CT_OPTION {
                            let _ok_elems = node_elements(_ok_ann)
                            if _ok_elems != -1 && sublist_length(_ok_elems) > 0 {
                                let _elem_ann = sublist_get(_ok_elems, 0)
                                let _elem_name = node_name(_elem_ann)
                                let _elem_ct = type_from_name(_elem_name)
                                if _elem_ct == CT_VOID && _elem_name != "" {
                                    let _err_ann = sublist_get(_elems, 1)
                                    let _err_name = node_name(_err_ann)
                                    let _err_t = type_from_name(_err_name)
                                    let _err_tag = resolve_result_inner_tag(_err_ann, _err_name, _err_t)
                                    let _err_t_tag = if _err_tag != "" { canonical_struct_tag(_err_tag) } else { c_type_tag(_err_t) }
                                    ret_c = "blink_Result_Option_ptr_{_err_t_tag}"
                                    ue_result_opt_ptr = 1
                                }
                            }
                        }
                    }
                }
            }
            let fn_line = "static {ret_c} {static_name}({param_str}) \{"
            cg_closure_defs.push(fn_line)
            let saved_lines = cg_lines
            let saved_indent = cg_indent
            let saved_in_handler = cg_in_handler_body
            let saved_handler_vt = cg_handler_body_vtable_type
            let saved_handler_field = cg_handler_body_field
            let saved_handler_ue = cg_handler_body_is_ue
            let saved_handler_hidx = cg_handler_body_idx
            let saved_fn_ret = cg_current_fn_ret
            let saved_fn_option_inner = cg_current_fn_option_inner
            let saved_fn_option_inner_struct = cg_current_fn_option_inner_struct
            let saved_handler_ret_opt_erased = cg_handler_ret_option_erased
            let saved_fn_name = cg_current_fn_name
            let saved_fn_has_ev_h = cg_current_fn_has_ev
            let saved_handler_caps = cg_handler_caps
            let saved_in_traced = cg_in_traced_fn
            // An inline handler body is its own C function; it must not inherit
            // the enclosing test/assert_panics elaboration, or a `?` inside it
            // would emit `__blink_test_set_propagate; return` (wrong frame) or
            // `goto __ap_returned_<n>` into a label that lives in the test
            // function, not this static fn. Mirrors the closure emitter.
            let saved_in_test_h = cg_in_test_body
            let saved_in_ap_h = cg_in_assert_panics
            cg_in_test_body = 0
            cg_in_assert_panics = 0
            cg_in_traced_fn = 0
            cg_lines = []
            cg_indent = 1
            cg_in_handler_body = 1
            cg_handler_body_vtable_type = vtable_type
            cg_handler_body_field = vtable_field
            cg_handler_body_is_ue = is_user_effect
            cg_handler_body_idx = handler_idx
            cg_handler_caps = handler_caps
            cg_current_fn_ret = ret_type
            cg_current_fn_name = static_name
            cg_current_fn_has_ev = 0
            if ret_type == CT_RESULT {
                reg_fn_ret_from_ann(static_name, m)
                if ue_result_opt_ptr != 0 {
                    let _fsi_cur = get_fn_ret_struct_inner(static_name)
                    reg_fn_ret_struct_inner(static_name, "Option_ptr", _fsi_cur.err_struct)
                }
            }
            cg_handler_ret_option_erased = 0
            if ue_opt_transparent {
                // Mirror the non-UE Option[Errno] fn: inner CT_VOID + the newtype name so the
                // Some(...) construction builds the scalar carrier; nothing is ptr-erased.
                cg_current_fn_option_inner = resolve_option_inner_from_ann(m)
                cg_current_fn_option_inner_struct = ue_opt_inner_struct
            } else if ue_needs_ptr {
                let _ue_inner_struct = ue_handler_option_inner_name(m)
                if _ue_inner_struct != "" {
                    // Erase-only-at-boundary: the inner is a genuine heap-boxed struct/enum, so
                    // keep the in-body Option carrier CONCRETE (inner CT_VOID + the struct name)
                    // and every value — struct field, tuple element, if/match arm — is a
                    // well-typed blink_Option_<Struct>. The C return signature stays
                    // blink_Option_ptr (the shared vtable ABI); emit_return_with_trace boxes the
                    // heap pointer concrete->ptr once at the boundary. A transparent newtype never
                    // reaches here — ue_needs_ptr excludes it.
                    cg_current_fn_option_inner = CT_VOID
                    cg_current_fn_option_inner_struct = _ue_inner_struct
                    cg_handler_ret_option_erased = 1
                } else {
                    // Un-nameable inner (typevar/alias): the concrete blink_Option_<Struct> carrier
                    // does not apply, so fall back to the uniform in-body ptr erasure that
                    // heap-boxes each value per construction.
                    cg_current_fn_option_inner = CT_PTR
                }
            } else if ue_result_opt_ptr != 0 {
                cg_current_fn_option_inner = CT_PTR
            } else if ret_type == CT_OPTION {
                cg_current_fn_option_inner = resolve_option_inner_from_ann(m)
            } else {
                cg_current_fn_option_inner = 0
            }
            push_scope()
            if params_sl != -1 {
                let mut pi = 0
                while pi < sublist_length(params_sl) {
                    let p = sublist_get(params_sl, pi)
                    let pname = node_name(p)
                    let ptype = node_type_name(p)
                    set_var(pname, type_from_name(ptype), 0)
                    pi = pi + 1
                }
            }
            if has_handler_caps {
                let cap_ev_fld = if is_user_effect != 0 { ev_field("ue_{vtable_field}") } else { ev_field(vtable_field) }
                if handler_caps.len() == 1 {
                    let cap0 = handler_caps.get(0).unwrap()
                    let cn = cap0.name
                    let ct = cap0.tp_id
                    let safe_cn = c_safe_name(cn)
                    let cap_ct_s = handler_cap_c_type(cap0)
                    ctype_probe_at(cg_expr_mono_tid(get_var_ty(cn)), "expr_handler_unbox1", cn, cap_ct_s, -1)
                    if ct == CT_STRING {
                        emit_line("{cap_ct_s} {safe_cn} = (const char*){cap_ev_fld}->__userdata_{mname};")
                    } else {
                        emit_line("{cap_ct_s} {safe_cn} = ({cap_ct_s})(uintptr_t){cap_ev_fld}->__userdata_{mname};")
                    }
                    set_var(cn, ct, 0)
                    if cap0.struct_name != "" { set_var_struct(cn, cap0.struct_name) }
                } else {
                    emit_line("{cap_struct_name}* __caps = ({cap_struct_name}*){cap_ev_fld}->__userdata_{mname};")
                    let mut uci = 0
                    while uci < handler_caps.len() {
                        let cap = handler_caps.get(uci).unwrap()
                        let cn = cap.name
                        let ct = cap.tp_id
                        let safe_cn = c_safe_name(cn)
                        let cap_ct_s = handler_cap_c_type(cap)
                        ctype_probe_at(cg_expr_mono_tid(get_var_ty(cn)), "expr_handler_unboxN", cn, cap_ct_s, -1)
                        emit_line("{cap_ct_s} {safe_cn} = __caps->{safe_cn};")
                        set_var(cn, ct, 0)
                        if cap.struct_name != "" { set_var_struct(cn, cap.struct_name) }
                        uci = uci + 1
                    }
                }
            }
            emit_fn_body(node_body(m), ret_type)
            pop_scope()
            let mut li = 0
            while li < cg_lines.len() {
                cg_closure_defs.push(cg_lines.get(li).unwrap())
                li = li + 1
            }
            cg_closure_defs.push("}")
            cg_closure_defs.push("")
            cg_lines = saved_lines
            cg_indent = saved_indent
            cg_in_handler_body = saved_in_handler
            cg_handler_body_vtable_type = saved_handler_vt
            cg_handler_body_field = saved_handler_field
            cg_handler_body_is_ue = saved_handler_ue
            cg_handler_body_idx = saved_handler_hidx
            cg_handler_caps = saved_handler_caps
            cg_current_fn_ret = saved_fn_ret
            cg_current_fn_option_inner = saved_fn_option_inner
            cg_current_fn_option_inner_struct = saved_fn_option_inner_struct
            cg_handler_ret_option_erased = saved_handler_ret_opt_erased
            cg_current_fn_name = saved_fn_name
            cg_current_fn_has_ev = saved_fn_has_ev_h
            cg_in_traced_fn = saved_in_traced
            cg_in_test_body = saved_in_test_h
            cg_in_assert_panics = saved_in_ap_h
            mi = mi + 1
        }
    }

    // Save current vtable as outer before installing new handler
    let vt_name = "__handler_vt_{handler_idx}"
    if is_user_effect != 0 {
        let ue_ev_fld = ev_field("ue_{vtable_field}")
        emit_line("{outer_ptr_name} = {ue_ev_fld};")
    } else {
        let bi_ev_fld = ev_field(vtable_field)
        emit_line("{outer_ptr_name} = {bi_ev_fld};")
    }
    emit_line("{vtable_type} {vt_name} = *{outer_ptr_name};")
    if methods_sl != -1 {
        let mut mi = 0
        while mi < sublist_length(methods_sl) {
            let m = sublist_get(methods_sl, mi)
            let mname = node_name(m)
            let static_name = "__handler_{handler_idx}_{mname}"
            emit_line("{vt_name}.{mname} = {static_name};")
            mi = mi + 1
        }
    }
    let vt_ptr = "__handler_ptr_{handler_idx}"
    emit_line("{vtable_type}* {vt_ptr} = ({vtable_type}*)blink_alloc(sizeof({vtable_type}));")
    emit_line("*{vt_ptr} = {vt_name};")
    if has_handler_caps {
        // This handler's captures back every op it defines. Store the same caps
        // value into the per-op userdata slot of each overridden op, so each op's
        // static fn reads it back from its own slot; ops NOT defined here keep the
        // slot copied from the outer vtable and delegate to the outer captures
        // (saf1hh). A single shared slot would give an inherited op this inner
        // handler's captures — wrong data, or a wild deref on a type mismatch.
        let mut caps_val = ""
        if handler_caps.len() == 1 {
            let cap0 = handler_caps.get(0).unwrap()
            let ct = cap0.tp_id
            let safe_cn = c_safe_name(cap0.name)
            if ct == CT_STRING {
                caps_val = "(void*){safe_cn}"
            } else {
                caps_val = "(void*)(uintptr_t){safe_cn}"
            }
        } else {
            let cap_alloc = fresh_temp("__hcaps_")
            emit_line("{cap_struct_name}* {cap_alloc} = ({cap_struct_name}*)blink_alloc(sizeof({cap_struct_name}));")
            let mut sci = 0
            while sci < handler_caps.len() {
                let safe_cn = c_safe_name(handler_caps.get(sci).unwrap().name)
                emit_line("{cap_alloc}->{safe_cn} = {safe_cn};")
                sci = sci + 1
            }
            caps_val = "(void*){cap_alloc}"
        }
        if methods_sl != -1 {
            let mut umi = 0
            while umi < sublist_length(methods_sl) {
                let mname_u = node_name(sublist_get(methods_sl, umi))
                emit_line("{vt_ptr}->__userdata_{mname_u} = {caps_val};")
                umi = umi + 1
            }
        }
    }
    expr_result_str = vt_ptr
    expr_result_type = CT_HANDLER
    publish_result_tid(node)
    cg_handler_vtable_type = vtable_type
    cg_handler_vtable_field = vtable_field
    cg_handler_is_user_effect = is_user_effect
}

@allow(UnrestoredMutation, IncompleteStateRestore)
pub fn emit_async_spawn_closure(closure_node: Int, spawn_node: Int, wrapper_idx: Int, wrapper_name: Str, task_fn_name: Str) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let cl_params_sl = node_params(closure_node)
    let captures = analyze_captures(node_body(closure_node), cl_params_sl)
    let cap_start = closure_captures.len()
    let mut cap_i = 0
    while cap_i < captures.len() {
        let cap_name = captures.get(cap_i).unwrap()
        if is_emitted_let(cap_name) != 0 {
            diag_error_at("CloseableEscapesScope", CLOSEABLE_ESCAPES_SCOPE, "scoped binding '{cap_name}' from with...as block cannot be captured by async.spawn", closure_node, "remove the capture or move the work inside the with block")
        }
        let cap_tp = get_var_tp(cap_name)
        let cap_mut = if list_contains_str(mut_captured_vars, cap_name) != 0 { 1 } else { 0 }
        closure_captures.push(CaptureEntry { name: cap_name, is_mut: cap_mut, tp_id: cap_tp, tid: get_var_ty(cap_name), inner1: get_var_inner1(cap_name), inner2: get_var_inner2(cap_name) })
        cap_i = cap_i + 1
    }
    closure_cap_infos.push(ClosureCapInfo { start: cap_start, count: captures.len() })

    cg_closure_defs.push("typedef struct \{")
    cg_closure_defs.push("    blink_handle* handle;")
    if captures.len() > 0 {
        cg_closure_defs.push("    void** captures;")
        cg_closure_defs.push("    int64_t capture_count;")
    }
    cg_closure_defs.push("} __async_arg_{wrapper_idx}_t;")
    cg_closure_defs.push("")

    let cl_body = node_body(closure_node)
    let cl_ret_str = node_return_type(closure_node)
    let mut cl_ret_type = type_from_name(cl_ret_str)
    let mut task_ret_c = c_type_str(cl_ret_type)
    let mut task_ret_struct = ""
    let mut body_ret = cl_ret_type
    // The spawn's authoritative Handle tid: its child(0) is the task's return type. Pinned once at
    // typecheck (the async.spawn memo), so it survives mono lowering — unlike a codegen-time re-walk
    // of the body, which is unstable. Used to recover an un-annotated closure's compound return.
    let mut spawn_inner_tid = -1
    let sp_htid = tc_lookup_node_tid(spawn_node)
    if sp_htid >= 0 && tc_tid_ct(sp_htid) == CT_HANDLE {
        spawn_inner_tid = cg_bind_mono_tid(tc_tid_child(sp_htid, 0))
    }
    let mut recovered_opt_inner = -1
    let mut recovered_opt_inner_struct = ""

    if cl_ret_type == CT_OPTION {
        let ret_ann = node_type_ann(closure_node)
        if ret_ann != -1 {
            let elems_sl = node_elements(ret_ann)
            if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
                let inner_ann = sublist_get(elems_sl, 0)
                let inner_name = node_name(inner_ann)
                let inner_ct = type_from_name(inner_name)
                if inner_ct == CT_VOID && is_struct_or_enum_type(inner_name) != 0 {
                    ensure_struct_option_type(inner_name)
                    task_ret_c = struct_option_c_type(inner_name)
                } else if is_compound_ct(inner_ct) != 0 {
                    let compound_name = compound_name_from_ann(inner_ann)
                    ensure_struct_option_type(compound_name)
                    task_ret_c = struct_option_c_type(compound_name)
                } else {
                    ensure_option_type(inner_ct)
                    task_ret_c = option_c_type(inner_ct)
                }
            }
        }
    } else if cl_ret_type == CT_RESULT {
        let ret_ann = node_type_ann(closure_node)
        if ret_ann != -1 {
            let elems_sl = node_elements(ret_ann)
            if elems_sl != -1 && sublist_length(elems_sl) >= 2 {
                let ok_ann = sublist_get(elems_sl, 0)
                let err_ann = sublist_get(elems_sl, 1)
                let ok_name = node_name(ok_ann)
                let err_name = node_name(err_ann)
                let ok_ct = type_from_name(ok_name)
                let err_ct = type_from_name(err_name)
                let ok_struct = if ok_ct == CT_VOID && is_struct_or_enum_type(ok_name) != 0 { ok_name } else { "" }
                let err_struct = if err_ct == CT_VOID && is_struct_or_enum_type(err_name) != 0 { err_name } else { "" }
                ensure_mixed_result_type(ok_ct, err_ct, ok_struct, err_struct)
                task_ret_c = result_c_type_mixed(ok_ct, err_ct, ok_struct, err_struct)
            }
        }
    } else if cl_ret_type == CT_VOID && cl_ret_str != "Void" && cl_ret_str != "" {
        if is_struct_type(cl_ret_str) != 0 {
            task_ret_c = c_type_c_name(cl_ret_str)
            task_ret_struct = cl_ret_str
        } else if is_enum_type(cl_ret_str) != 0 {
            task_ret_c = c_type_c_name(cl_ret_str)
        }
    }

    // Probe here, not at the raw cl_ret_type: the recovery chain above turns the pre-recovery
    // spelling (a user struct/Option/Result surfaces as "void" from c_type_str(cl_ret_type)) into
    // the real task_ret_c the wrapper emits. Compare the tid against THAT so the gate measures the
    // final emitted identity, not the stale intermediate. The int64_t void-ABI override below is an
    // orthogonal representation rule (unit tasks carry an int64_t placeholder), not a type identity.
    ctype_probe_at(cg_fn_ret_tid(closure_node), "expr_task_ret", cl_ret_str, task_ret_c, node_type_ann(closure_node))

    // A user struct/enum body surfaces as CT_VOID to infer_block_type (the codegen block-type
    // re-walk), so trust the authoritative Handle tid for the void decision when it is populated —
    // the same re-walk instability the recovery below is pinned against would otherwise skip the
    // recovery and force an int64_t task fn that the await unbox disagrees with. The re-walk stays
    // the fallback only when the tid is unavailable. Ask the tid's kind, not tc_tid_ct: the latter
    // collapses TyKind.Void onto CT_VOID and then to -1, so a Void inner is indistinguishable from
    // an unresolved/typevar tid there.
    let is_void_ret = cl_ret_str == "Void" || (cl_ret_str == "" && (if spawn_inner_tid >= 0 { tc_tid_kind(spawn_inner_tid) == TyKind.Void } else { infer_block_type(cl_body) == CT_VOID }))
    if is_void_ret {
        task_ret_c = "int64_t"
    } else if cl_ret_str == "" {
        // Un-annotated non-void closure: the annotation-driven recovery above never fired
        // (node_type_ann is -1). Take the task's return type from the authoritative Handle tid so
        // a compound body (Result/Option) keeps its real C type instead of an int64_t placeholder
        // that the wrapper's boxing and the await unbox would then disagree with. Recover each
        // carrier arm by its NOMINAL name off the tid children — the same name-then-type_from_name
        // logic the annotated path (above) runs on the annotation node — so a transparent-newtype
        // arm (Errno) keeps its nominal carrier tag instead of peeling to its int base, which the
        // await side does not do; peeling here would spell a carrier the consumer never declares.
        let ict = if spawn_inner_tid >= 0 { tc_tid_ct(spawn_inner_tid) } else { -1 }
        if ict == CT_RESULT {
            let ok_name = tc_tid_name(tc_tid_child(spawn_inner_tid, 0))
            let err_name = tc_tid_name(tc_tid_child(spawn_inner_tid, 1))
            let ok_ct = type_from_name(ok_name)
            let err_ct = type_from_name(err_name)
            let ok_struct = if ok_ct == CT_VOID && is_struct_or_enum_type(ok_name) != 0 { ok_name } else { "" }
            let err_struct = if err_ct == CT_VOID && is_struct_or_enum_type(err_name) != 0 { err_name } else { "" }
            ensure_mixed_result_type(ok_ct, err_ct, ok_struct, err_struct)
            task_ret_c = result_c_type_mixed(ok_ct, err_ct, ok_struct, err_struct)
            cl_ret_type = CT_RESULT
            body_ret = CT_RESULT
        } else if ict == CT_OPTION {
            let inner_name = tc_tid_name(tc_tid_child(spawn_inner_tid, 0))
            let inner_ct = type_from_name(inner_name)
            if inner_ct == CT_VOID && is_struct_or_enum_type(inner_name) != 0 {
                ensure_struct_option_type(inner_name)
                task_ret_c = struct_option_c_type(inner_name)
                recovered_opt_inner_struct = inner_name
            } else {
                ensure_option_type(inner_ct)
                task_ret_c = option_c_type(inner_ct)
                recovered_opt_inner = inner_ct
            }
            cl_ret_type = CT_OPTION
            body_ret = CT_OPTION
        } else if ict == CT_STRUCT || ict == CT_ENUM {
            let sname = tc_tid_name(spawn_inner_tid)
            if is_transparent_newtype(sname) != 0 {
                // A transparent newtype travels as its bare scalar (int64_t — the codegen
                // convention for transparent newtypes), not the aggregate c_type_c_name spells:
                // the task body returns the raw scalar, so a by-value struct return would mis-type
                // the task fn. The await side erases the newtype the same way, so both land on
                // int64_t.
                task_ret_c = "int64_t"
                body_ret = CT_INT
            } else if ict == CT_STRUCT && is_struct_type(sname) != 0 {
                task_ret_c = c_type_c_name(sname)
                task_ret_struct = sname
                cl_ret_type = CT_STRUCT
                body_ret = CT_INT
            } else {
                // Bare data enum: the await side has no enum-by-value unbox, so it cannot
                // round-trip through async.spawn (the annotated path fails identically). Fall back
                // to the int64_t placeholder rather than an aggregate the wrapper cannot box.
                task_ret_c = "int64_t"
                body_ret = CT_INT
            }
        } else if ict >= 0 && ict != CT_VOID {
            task_ret_c = c_type_str(ict)
            cl_ret_type = ict
            body_ret = ict
        } else {
            task_ret_c = "int64_t"
            body_ret = CT_INT
        }
    }

    if task_ret_struct != "" || (cl_ret_type == CT_VOID && cl_ret_str != "Void" && cl_ret_str != "" && (is_struct_type(cl_ret_str) != 0 || is_enum_type(cl_ret_str) != 0)) {
        body_ret = CT_INT
    }

    let saved_in_traced = cg_in_traced_fn
    cg_in_traced_fn = 0
    let saved_lines = cg_lines
    let saved_indent = cg_indent
    let saved_temp = cg_temp_counter
    let saved_cap_start = cg_closure_cap_start
    let saved_cap_count = cg_closure_cap_count
    let saved_fn_name = cg_current_fn_name
    let saved_fn_has_ev = cg_current_fn_has_ev
    let saved_fn_ret = cg_current_fn_ret
    let saved_fn_option_inner = cg_current_fn_option_inner
    // The spawned task is its own static C function, never a UE handler-op return boundary, so it
    // must not inherit the enclosing handler's erase-at-boundary state — otherwise a task body
    // returning Option would trip emit_return_with_trace's concrete->ptr box with the outer
    // handler's leaked struct name.
    let saved_fn_option_inner_struct = cg_current_fn_option_inner_struct
    let saved_handler_ret_opt_erased = cg_handler_ret_option_erased
    cg_current_fn_option_inner_struct = ""
    cg_handler_ret_option_erased = 0
    // The spawned task is its own static C function; it must not inherit the
    // enclosing test/assert_panics elaboration, or a `?` inside it would emit a
    // test-propagation `return` or `goto __ap_returned_<n>` into a frame/label
    // that lives in the test function, not this fn. Mirrors emit_handler_expr.
    let saved_in_test = cg_in_test_body
    let saved_in_ap = cg_in_assert_panics
    cg_in_test_body = 0
    cg_in_assert_panics = 0
    cg_lines = []
    cg_indent = 0
    cg_temp_counter = 0
    cg_closure_cap_start = cap_start
    cg_closure_cap_count = captures.len()
    cg_current_fn_name = task_fn_name
    cg_current_fn_has_ev = 0
    cg_current_fn_ret = body_ret
    if cl_ret_type == CT_OPTION {
        cg_current_fn_option_inner = if recovered_opt_inner >= 0 { recovered_opt_inner } else { resolve_option_inner_from_ann(closure_node) }
        // A recovered Option[Struct] task needs its inner struct name so a bare `None` in the body
        // emits the struct-option carrier (matching task_ret_c), not the int-option fallback.
        if recovered_opt_inner_struct != "" {
            cg_current_fn_option_inner_struct = recovered_opt_inner_struct
        }
    } else {
        cg_current_fn_option_inner = 0
    }

    push_scope()

    let mut task_params = "const blink_closure* __self"
    emit_line("static {task_ret_c} {task_fn_name}({task_params}) \{")
    cg_indent = cg_indent + 1

    let mut mc_i = 0
    while mc_i < captures.len() {
        let mc_e = closure_captures.get(cap_start + mc_i).unwrap()
        if mc_e.is_mut != 0 {
            ctype_probe_at(cg_expr_mono_tid(mc_e.tid), "expr_task_mutcap", mc_e.name, c_type_str(tp_get_kind(mc_e.tp_id)), -1)
            let mc_ts = c_type_str(tp_get_kind(mc_e.tp_id))
            emit_line("{mc_ts}* {mc_e.name}_cell = ({mc_ts}*)blink_closure_get_capture(__self, {mc_i});")
        }
        mc_i = mc_i + 1
    }

    if task_ret_struct != "" {
        reg_fn_struct_ret(task_fn_name, task_ret_struct)
    }
    reg_fn_ret_from_ann(task_fn_name, closure_node)

    if is_void_ret {
        emit_fn_body(cl_body, CT_VOID)
        emit_line("return 0;")
    } else {
        emit_fn_body(cl_body, body_ret)
    }
    cg_indent = cg_indent - 1
    emit_line("}")
    emit_line("")

    pop_scope()

    let task_lines = cg_lines
    cg_lines = saved_lines
    cg_indent = saved_indent
    cg_temp_counter = saved_temp
    cg_closure_cap_start = saved_cap_start
    cg_closure_cap_count = saved_cap_count
    cg_current_fn_name = saved_fn_name
    cg_current_fn_has_ev = saved_fn_has_ev
    cg_current_fn_ret = saved_fn_ret
    cg_current_fn_option_inner = saved_fn_option_inner
    cg_current_fn_option_inner_struct = saved_fn_option_inner_struct
    cg_handler_ret_option_erased = saved_handler_ret_opt_erased
    cg_in_test_body = saved_in_test
    cg_in_assert_panics = saved_in_ap
    cg_in_traced_fn = saved_in_traced

    let mut tli = 0
    while tli < task_lines.len() {
        cg_closure_defs.push(task_lines.get(tli).unwrap())
        tli = tli + 1
    }

    let needs_boxing = cl_ret_type == CT_FLOAT || cl_ret_type == CT_OPTION || cl_ret_type == CT_RESULT || task_ret_struct != ""

    cg_closure_defs.push("static void {wrapper_name}(void* __arg) \{")
    cg_closure_defs.push("    __async_arg_{wrapper_idx}_t* __a = (__async_arg_{wrapper_idx}_t*)__arg;")
    cg_closure_defs.push("    blink_handle* __h = __a->handle;")
    if captures.len() > 0 {
        cg_closure_defs.push("    blink_closure __self_data = \{NULL, __a->captures, __a->capture_count};")
        cg_closure_defs.push("    {task_ret_c} __r = {task_fn_name}(&__self_data);")
    } else {
        cg_closure_defs.push("    {task_ret_c} __r = {task_fn_name}(NULL);")
    }
    if needs_boxing {
        cg_closure_defs.push("    {task_ret_c}* __bp = ({task_ret_c}*)blink_alloc(sizeof({task_ret_c}));")
        cg_closure_defs.push("    *__bp = __r;")
        cg_closure_defs.push("    blink_handle_set_result(__h, (void*)__bp);")
    } else if cl_ret_type == CT_STRING || cl_ret_type == CT_LIST || cl_ret_type == CT_MAP || cl_ret_type == CT_SET || cl_ret_type == CT_BYTES || cl_ret_type == CT_STRINGBUILDER {
        cg_closure_defs.push("    blink_handle_set_result(__h, (void*)__r);")
    } else {
        cg_closure_defs.push("    blink_handle_set_result(__h, (void*)(intptr_t)__r);")
    }
    cg_closure_defs.push("    GC_FREE(__arg);")
    cg_closure_defs.push("}")
    cg_closure_defs.push("")
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_await_expr(node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    emit_expr(node_obj(node))
    let handle_str = expr_result_str
    let inner_type = get_var_handle_inner(handle_str)
    let handle_sname = get_var_handle_sname(handle_str)
    let tmp = fresh_temp("__await_")
    emit_line("void* {tmp} = blink_handle_await({handle_str});")
    if inner_type == CT_INT {
        expr_result_str = "(int64_t)(intptr_t){tmp}"
        expr_result_type = CT_INT
        publish_result_tid(node)
    } else if inner_type == CT_STRING {
        expr_result_str = "(const char*){tmp}"
        expr_result_type = CT_STRING
        publish_result_tid(node)
    } else if inner_type == CT_FLOAT {
        expr_result_str = "*(double*){tmp}"
        expr_result_type = CT_FLOAT
        publish_result_tid(node)
    } else if inner_type == CT_BOOL {
        expr_result_str = "(int)(intptr_t){tmp}"
        expr_result_type = CT_BOOL
        publish_result_tid(node)
    } else if inner_type == CT_LIST {
        expr_result_str = "(blink_list*){tmp}"
        expr_result_type = CT_LIST
        publish_result_tid(node)
    } else if inner_type == CT_MAP {
        expr_result_str = "(blink_map*){tmp}"
        expr_result_type = CT_MAP
        publish_result_tid(node)
    } else if inner_type == CT_SET {
        expr_result_str = "(blink_set*){tmp}"
        expr_result_type = CT_SET
        publish_result_tid(node)
    } else if inner_type == CT_BYTES {
        expr_result_str = "(blink_bytes*){tmp}"
        expr_result_type = CT_BYTES
        publish_result_tid(node)
    } else if inner_type == CT_OPTION {
        let inner2 = get_var_handle_inner2(handle_str)
        let opt_c_type = if inner2 >= 0 {
            let inner_ct = type_from_name(handle_sname)
            if (inner_ct == CT_VOID || inner_ct == CT_STRUCT || inner_ct == CT_ENUM) && (is_struct_type(handle_sname) != 0 || is_enum_type(handle_sname) != 0) {
                struct_option_c_type(handle_sname)
            } else {
                option_c_type(inner2)
            }
        } else {
            option_c_type(CT_INT)
        }
        let unboxed = fresh_temp("__uopt_")
        emit_line("{opt_c_type} {unboxed} = *({opt_c_type}*){tmp};")
        expr_result_str = unboxed
        expr_result_type = CT_OPTION
        publish_result_tid(node)
        expr_option_inner = if get_var_handle_inner2(handle_str) >= 0 { get_var_handle_inner2(handle_str) } else { CT_INT }
    } else if inner_type == CT_RESULT {
        let inner2 = get_var_handle_inner2(handle_str)
        let sname2 = get_var_handle_sname2(handle_str)
        let ok_ct = type_from_name(handle_sname)
        let err_ct = if inner2 >= 0 { inner2 } else { CT_STRING }
        let ok_struct = if (ok_ct == CT_VOID || ok_ct == CT_STRUCT || ok_ct == CT_ENUM) && is_struct_or_enum_type(handle_sname) != 0 { handle_sname } else { "" }
        let err_struct = if sname2 != "" && is_struct_or_enum_type(sname2) != 0 { sname2 } else { "" }
        // The whole-carrier spelling is the authoritative tid's, so an await materializes the same
        // struct type the awaited value was produced with; the flat reconstruction only fills scalar
        // carriers whose tid does not spell a registered Result carrier.
        let res_tid_c = c_type_from_tid(cg_node_mono_tid(node))
        let res_c_type = if res_tid_c.starts_with("blink_Result_") { res_tid_c } else { result_c_type_mixed(ok_ct, err_ct, ok_struct, err_struct) }
        let unboxed = fresh_temp("__ures_")
        emit_line("{res_c_type} {unboxed} = *({res_c_type}*){tmp};")
        set_var_result_struct(unboxed, ok_ct, err_ct, ok_struct, err_struct)
        expr_result_str = unboxed
        expr_result_type = CT_RESULT
        publish_result_tid(node)
        expr_result_ok_type = ok_ct
        expr_result_err_type = err_ct
        expr_result_ok_struct = ok_struct
        expr_result_err_struct = err_struct
    } else if inner_type == CT_STRUCT && handle_sname != "" && is_struct_type(handle_sname) != 0 {
        let struct_c = c_type_c_name(handle_sname)
        let unboxed = fresh_temp("__ust_")
        emit_line("{struct_c} {unboxed} = *({struct_c}*){tmp};")
        expr_result_str = unboxed
        expr_result_type = CT_STRUCT
        publish_result_tid(node)
        set_var_struct(unboxed, handle_sname)
    } else {
        expr_result_str = "(int64_t)(intptr_t){tmp}"
        expr_result_type = CT_INT
        publish_result_tid(node)
    }
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_async_scope(node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    cg_uses_async = 1
    let scope_idx = cg_async_scope_counter
    cg_async_scope_counter = cg_async_scope_counter + 1
    let list_name = "__scope_handles_{scope_idx}"
    emit_line("blink_list* {list_name} = blink_list_new();")
    cg_async_scope_stack.push(list_name)
    emit_block_expr(node_body(node))
    let saved_str = expr_result_str
    let saved_type = expr_result_type
    cg_async_scope_stack.pop()
    let iter_var = fresh_temp("__si_")
    emit_line("for (int64_t {iter_var} = 0; {iter_var} < blink_list_len({list_name}); {iter_var}++) \{")
    cg_indent = cg_indent + 1
    let handle_var = fresh_temp("__sh_")
    emit_line("blink_handle* {handle_var} = (blink_handle*)blink_list_get({list_name}, {iter_var});")
    emit_line("if ({handle_var}->status == BLINK_HANDLE_RUNNING) \{")
    cg_indent = cg_indent + 1
    emit_line("blink_handle_await({handle_var});")
    cg_indent = cg_indent - 1
    emit_line("}")
    cg_indent = cg_indent - 1
    emit_line("}")
    emit_line("blink_list_free({list_name});")
    expr_result_str = saved_str
    expr_result_type = saved_type
    publish_result_tid(node)
}

// Mirrors codegen_stmt.bl:strip_outer_parens. Duplicated rather than
// shared because the import direction is codegen_stmt -> codegen_expr;
// keep the body byte-identical so a fix in one stays trivially
// portable to the other.
fn strip_outer_parens_expr(s: Str) -> Str {
    if s.starts_with("(") && s.ends_with(")") {
        let inner = s.substring(1, s.len() - 2)
        let mut depth = 0
        let mut i = 0
        let mut balanced = 1
        while i < inner.len() {
            let ch = inner.byte_at(i)
            if ch == 40 { // '('
                depth = depth + 1
            } else if ch == 41 { // ')'
                if depth == 0 {
                    balanced = 0
                }
                depth = depth - 1
            }
            i = i + 1
        }
        if balanced != 0 && depth == 0 {
            return inner
        }
    }
    s
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_binop(node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let op = node_op(node)
    if op == "??" {
        emit_expr(node_left(node))
        let left_str = expr_result_str
        let left_type = expr_result_type
        let opt_inner = expr_option_inner
        let opt_inner_s = expr_option_inner_struct
        let opt_erased = expr_option_erased
        if left_type == CT_BOOL || left_type == CT_FLOAT || left_type == CT_STRING || left_type == CT_LIST || left_type == CT_RESULT || left_type == CT_CLOSURE {
            diag_error_at("CoalesceRequiresOption", COALESCE_REQUIRES_OPT, "the ?? operator requires an Option value but got a non-Option type in function '{cg_current_fn_name}'", node, "")
        }
        emit_expr(node_right(node))
        let right_str = expr_result_str
        let right_type = expr_result_type
        // Gate on the STRUCTURAL shape of the operand, not expr_option_is_none: that
        // global reflects the LAST nested None emitted, so a non-None operand whose
        // subtree ends in a None (e.g. `x ?? g(None)`) would leave it spuriously set.
        // A bare None is always an Ident named "None" (parens are transparent here).
        let nr = node_right(node)
        let right_is_none = if node_kind(nr) == NodeKind.Ident && node_name(nr) == "None" { 1 } else { 0 }
        let tmp = fresh_temp("__opt")
        if opt_inner_s != "" {
            // A bare `None` default has no carrier context of its own, so it lowered to
            // `(blink_Option_int){.tag=0}` — a hard cc mismatch against the left inner's
            // structured carrier. The default's type is fixed by the left Option's inner,
            // so spell it in that carrier (c_type_c_name(opt_inner_s)), the same type the
            // struct arms below declare the result with.
            let none_default = if right_is_none != 0 {
                "({c_type_c_name(opt_inner_s)})\{.tag = 0}"
            } else {
                right_str
            }
            // A ptr-erased left carries a blink_Option_ptr box with a void* payload;
            // spell the erased carrier and cast the payload back to the true struct.
            let opt_c = if opt_erased != 0 {
                ensure_option_type(CT_PTR)
                option_c_type(CT_PTR)
            } else {
                struct_option_c_type(opt_inner_s)
            }
            emit_line("{opt_c} {tmp} = {left_str};")
            let val_tmp = fresh_temp("__optv")
            let inner_c = c_type_from_tag(opt_inner_s)
            if is_opaque_type(opt_inner_s) != 0 {
                // NPO: the Option IS the handle pointer (NULL = None), so coalesce is a
                // null test yielding the handle — no `.tag`/`.value` carrier read. Guard
                // ahead of the pointer arm below, which the opaque cname also matches.
                let handle_c = opaque_handle_c_name(opt_inner_s)
                emit_line("{handle_c} {val_tmp} = ({tmp} != NULL) ? {tmp} : {right_str};")
                set_var(val_tmp, CT_STRUCT, 0)
                set_var_struct(val_tmp, opt_inner_s)
                expr_result_type = CT_STRUCT
                publish_result_tid(node)
            } else if inner_c.ends_with("*") {
                emit_line("{inner_c} {val_tmp} = {tmp}.tag == 1 ? {tmp}.value : {right_str};")
                set_var(val_tmp, opt_inner, 0)
                expr_result_type = opt_inner
                publish_result_tid(node)
            } else if opt_erased != 0 {
                emit_line("{c_type_c_name(opt_inner_s)} {val_tmp} = {tmp}.tag == 1 ? *({c_type_c_name(opt_inner_s)}*){tmp}.value : {none_default};")
                set_var_struct(val_tmp, opt_inner_s)
                expr_result_type = right_type
                publish_result_tid(node)
            } else if is_payloadless_enum(opt_inner_s) != 0 {
                // By-value nominal carrier (blink_Option_<enum>): the ordinal lives
                // inline, so read {tmp}.value directly — the boxed deref below would
                // treat the ordinal as a pointer. A bare-None default never reaches this
                // arm (`?? None` only types when the inner is itself an Option), so this
                // keeps the raw operand string.
                emit_line("{c_type_c_name(opt_inner_s)} {val_tmp} = {tmp}.tag == 1 ? {tmp}.value : {right_str};")
                set_var_struct(val_tmp, opt_inner_s)
                expr_result_type = right_type
                publish_result_tid(node)
            } else if is_transparent_newtype(opt_inner_s) != 0 {
                // Transparent newtype (Errno): the carrier holds a bare int64_t
                // inline and the default operand also lowers to that scalar, so read
                // {tmp}.value by identity — the boxed deref below would treat it as a
                // pointer. The match resolves the variant from its arm (like unwrap).
                emit_line("int64_t {val_tmp} = {tmp}.tag == 1 ? {tmp}.value : {right_str};")
                set_var(val_tmp, CT_INT, 0)
                expr_result_type = CT_INT
                publish_result_tid(node)
            } else {
                emit_line("{c_type_c_name(opt_inner_s)} {val_tmp} = {tmp}.tag == 1 ? *{tmp}.value : {none_default};")
                set_var_struct(val_tmp, opt_inner_s)
                expr_result_type = right_type
                publish_result_tid(node)
            }
            expr_result_str = val_tmp
        } else if opt_inner == CT_LIST {
            let opt_c = option_c_type(CT_LIST)
            emit_line("{opt_c} {tmp} = {left_str};")
            let val_tmp = fresh_temp("__optv")
            emit_line("blink_list* {val_tmp} = {tmp}.tag == 1 ? {tmp}.value : {right_str};")
            set_var(val_tmp, CT_LIST, 0)
            let inner2 = expr_option_inner_list_elem
            if inner2 >= 0 {
                set_list_elem_type(val_tmp, inner2)
                expr_list_elem_type = inner2
            }
            let inner2_s = expr_option_inner_list_struct
            if inner2_s != "" {
                set_list_elem_struct(val_tmp, inner2_s)
            }
            expr_result_str = val_tmp
            expr_result_type = CT_LIST
            publish_result_tid(node)
        } else if opt_inner == CT_SET {
            // The generic opt_inner>=0 fallback below mints no temp
            // var — it returns a bare ternary expression string — so there is
            // nothing to attach the Set's own element metadata to. Mirror the
            // CT_LIST arm above: mint val_tmp and carry the element off
            // left_str's flat inner2 channel (stamped by the .get()/.pop()
            // CT_SET arms), not a transient global.
            ensure_option_type(CT_SET)
            let opt_c = option_c_type(CT_SET)
            emit_line("{opt_c} {tmp} = {left_str};")
            let val_tmp = fresh_temp("__optv")
            emit_line("blink_set* {val_tmp} = {tmp}.tag == 1 ? {tmp}.value : {right_str};")
            set_var(val_tmp, CT_SET, 0)
            let nested = get_var_option_inner2(left_str)
            let nested_s = get_var_option_inner2_struct(left_str)
            if nested != -1 {
                set_set_elem_type(val_tmp, nested)
            }
            if nested_s != "" {
                set_set_elem_struct(val_tmp, nested_s)
            }
            if nested == -1 && nested_s == "" {
                // left_str's inner2 channel is only populated for a
                // registered Option scope var (a `let`-bound or param name) --
                // a struct-field left operand (`b.inner ?? fallback`) has no
                // such registration, so fall back to the ?? node's own tid,
                // same last resort the unannotated let-binding path uses.
                recover_set_elem_from_tid(node, val_tmp)
            }
            expr_result_str = val_tmp
            expr_result_type = CT_SET
            publish_result_tid(node)
        } else if opt_inner >= 0 {
            let opt_c = option_c_type(opt_inner)
            emit_line("{opt_c} {tmp} = {left_str};")
            expr_result_str = "({tmp}.tag == 1 ? {tmp}.value : {right_str})"
            expr_result_type = right_type
            publish_result_tid(node)
        } else {
            emit_line("const int64_t {tmp} = (int64_t){left_str};")
            expr_result_str = "({tmp}.tag == 1 ? {tmp}.value : {right_str})"
            expr_result_type = right_type
            publish_result_tid(node)
        }
        return
    }
    emit_expr(node_left(node))
    let left_str = expr_result_str
    let left_type = expr_result_type
    let left_opt_inner = expr_option_inner
    let left_opt_inner_struct = expr_option_inner_struct

    if op == "&&" || op == "||" {
        let pre_len = cg_lines.len()
        emit_expr(node_right(node))
        let right_str = expr_result_str
        let post_len = cg_lines.len()
        if post_len > pre_len {
            let mut rhs_lines: List[Str] = []
            let mut ri = pre_len
            while ri < post_len {
                rhs_lines.push(cg_lines.get(ri).unwrap())
                ri = ri + 1
            }
            let mut pi = post_len - 1
            while pi >= pre_len {
                cg_lines.pop()
                pi = pi - 1
            }
            let sc_tmp = fresh_temp("__sc")
            emit_line("int64_t {sc_tmp};")
            let left_cond = strip_outer_parens_expr(left_str)
            if op == "&&" {
                emit_line("if ({left_cond}) \{")
            } else {
                emit_line("if (!({left_cond})) \{")
            }
            cg_indent = cg_indent + 1
            let mut si = 0
            while si < rhs_lines.len() {
                cg_lines.push(rhs_lines.get(si).unwrap())
                si = si + 1
            }
            emit_line("{sc_tmp} = ({right_str}) ? 1 : 0;")
            cg_indent = cg_indent - 1
            if op == "&&" {
                emit_line("} else \{ {sc_tmp} = 0; }")
            } else {
                emit_line("} else \{ {sc_tmp} = 1; }")
            }
            expr_result_str = sc_tmp
            expr_result_type = CT_BOOL
            publish_result_tid(node)
        } else {
            expr_result_str = "({left_str} {op} {right_str})"
            expr_result_type = CT_BOOL
            publish_result_tid(node)
        }
        return
    }

    emit_expr(node_right(node))
    let right_str = expr_result_str
    let right_type = expr_result_type

    if (op == "==" || op == "!=") && left_type == CT_OPTION && right_type == CT_OPTION && left_opt_inner_struct == "" && expr_option_inner_struct == "" && left_opt_inner == expr_option_inner {
        let opt_c = option_c_type(left_opt_inner)
        let ltmp = fresh_temp("__oeql")
        let rtmp = fresh_temp("__oeqr")
        emit_line("{opt_c} {ltmp} = {left_str};")
        emit_line("{opt_c} {rtmp} = {right_str};")
        if op == "==" {
            expr_result_str = "({ltmp}.tag == {rtmp}.tag && ({ltmp}.tag == 0 || {ltmp}.value == {rtmp}.value))"
        } else {
            expr_result_str = "({ltmp}.tag != {rtmp}.tag || ({ltmp}.tag != 0 && {ltmp}.value != {rtmp}.value))"
        }
        expr_result_type = CT_BOOL
        publish_result_tid(node)
        return
    }

    if op == "==" && left_type == CT_STRING && right_type == CT_STRING {
        let eq_fn = c_fn_name("str_eq")
        expr_result_str = "{eq_fn}({left_str}, {right_str})"
        expr_result_type = CT_BOOL
        publish_result_tid(node)
        return
    }
    if op == "!=" && left_type == CT_STRING && right_type == CT_STRING {
        let eq_fn = c_fn_name("str_eq")
        expr_result_str = "(!{eq_fn}({left_str}, {right_str}))"
        expr_result_type = CT_BOOL
        publish_result_tid(node)
        return
    }
    if (op == "<" || op == "<=" || op == ">" || op == ">=") && left_type == CT_STRING && right_type == CT_STRING {
        expr_result_str = "(blink_str_cmp({left_str}, {right_str}) {op} 0)"
        expr_result_type = CT_BOOL
        publish_result_tid(node)
        return
    }
    if op == "<<" || op == ">>" {
        let sh_tid = cg_expr_node_mono_tid(node_left(node))
        let sh_flat = c_type_str(left_type)
        ctype_probe_at(sh_tid, "expr_shift_operand", "shift", sh_flat, node_left(node))
        let sh_spelled = c_type_from_tid(sh_tid)
        let lc = if sh_spelled != "" && sh_spelled != "void" { sh_spelled } else { sh_flat }
        let rhs_node = node_right(node)
        if rhs_node != -1 && node_kind(rhs_node) == NodeKind.IntLit {
            expr_result_str = "(({lc})({left_str}) {op} (uint32_t){right_str})"
        } else {
            let bw = ct_bit_width(left_type)
            let amt = fresh_temp("__sh_amt")
            let val = fresh_temp("__sh_val")
            let loc_line = panic_line_str(node)
            let file = panic_file_for_fmt(node)
            emit_line("uint32_t {amt} = (uint32_t)({right_str});")
            emit_line("if ({amt} >= {bw}) \{ {emit_panic_site(\"panic: shift amount %u exceeds bit width {bw} at {file}:{loc_line}\", \", {amt}\")} }")
            emit_line("{lc} {val} = ({lc})({left_str}) {op} {amt};")
            expr_result_str = val
        }
        expr_result_type = left_type
        publish_result_tid(node)
        return
    }

    // Sized-integer arithmetic: trap on overflow per spec §03_types.md:739-760.
    if is_sized_int_ct(left_type) && (op == "+" || op == "-" || op == "*" || op == "/" || op == "%") {
        let sov_tid = cg_expr_node_mono_tid(node_left(node))
        let sov_flat = c_type_str(left_type)
        ctype_probe_at(sov_tid, "expr_sized_arith", "sov", sov_flat, node_left(node))
        let sov_spelled = c_type_from_tid(sov_tid)
        let lc = if sov_spelled != "" && sov_spelled != "void" { sov_spelled } else { sov_flat }
        let tname = type_name_from_ct(left_type)
        let loc_line = panic_line_str(node)
        let file = panic_file_for_fmt(node)
        let result_tmp = fresh_temp("__sov")
        let lhs_tmp = fresh_temp("__sov_l")
        let rhs_tmp = fresh_temp("__sov_r")
        // The panic message is a printf format; `%` (modulo) is a literal here
        // and must be escaped as `%%` so vsnprintf/fprintf don't read it as a
        // conversion spec (the message is matched by assert_panics).
        let op_msg = if op == "%" { "%%" } else { op }
        emit_line("{lc} {lhs_tmp} = ({lc})({left_str});")
        emit_line("{lc} {rhs_tmp} = ({lc})({right_str});")
        if op == "/" || op == "%" {
            emit_line("if ({rhs_tmp} == 0) \{ {emit_panic_site(\"panic: {tname} division by zero at {file}:{loc_line}\", \"\")} }")
            // Signed INT_MIN / -1 traps as overflow.
            if left_type == CT_I8 {
                emit_line("if ({lhs_tmp} == (int8_t)0x80 && {rhs_tmp} == -1) \{ {emit_panic_site(\"panic: {tname} overflow in {op_msg} at {file}:{loc_line}\", \"\")} }")
            } else if left_type == CT_I16 {
                emit_line("if ({lhs_tmp} == (int16_t)0x8000 && {rhs_tmp} == -1) \{ {emit_panic_site(\"panic: {tname} overflow in {op_msg} at {file}:{loc_line}\", \"\")} }")
            } else if left_type == CT_I32 {
                emit_line("if ({lhs_tmp} == (int32_t)0x80000000 && {rhs_tmp} == -1) \{ {emit_panic_site(\"panic: {tname} overflow in {op_msg} at {file}:{loc_line}\", \"\")} }")
            }
            emit_line("{lc} {result_tmp} = {lhs_tmp} {op} {rhs_tmp};")
        } else {
            // +, -, * use __builtin_*_overflow.
            let builtin_name = if op == "+" { "add" } else if op == "-" { "sub" } else { "mul" }
            emit_line("{lc} {result_tmp};")
            emit_line("if (__builtin_{builtin_name}_overflow({lhs_tmp}, {rhs_tmp}, &{result_tmp})) \{ {emit_panic_site(\"panic: {tname} overflow in {op_msg} (%lld {op_msg} %lld) at {file}:{loc_line}\", \", (long long){lhs_tmp}, (long long){rhs_tmp}\")} }")
        }
        expr_result_str = result_tmp
        expr_result_type = left_type
        publish_result_tid(node)
        return
    }

    // Plain Int / I64 (CT_INT) WRAP for +,-,* (they fall through below to raw C),
    // so they are NOT checked types. But `/0` and `INT64_MIN / -1` are genuine C
    // UB (SIGFPE) -- guard only those two like the sized ints. I64 is an
    // alias for CT_INT, so this covers both; the message reads "Int" for both.
    if left_type == CT_INT && (op == "/" || op == "%") {
        let iov_tid = cg_expr_node_mono_tid(node_left(node))
        let iov_flat = c_type_str(left_type)
        ctype_probe_at(iov_tid, "expr_int_divmod", "iov", iov_flat, node_left(node))
        let iov_spelled = c_type_from_tid(iov_tid)
        let lc = if iov_spelled != "" && iov_spelled != "void" { iov_spelled } else { iov_flat }
        let tname = type_name_from_ct(left_type)
        let loc_line = panic_line_str(node)
        let file = panic_file_for_fmt(node)
        let result_tmp = fresh_temp("__iov")
        let lhs_tmp = fresh_temp("__iov_l")
        let rhs_tmp = fresh_temp("__iov_r")
        // `%` (modulo) is literal in the message and must be escaped as `%%` so
        // vsnprintf/fprintf don't read it as a conversion spec.
        let op_msg = if op == "%" { "%%" } else { op }
        emit_line("{lc} {lhs_tmp} = ({lc})({left_str});")
        emit_line("{lc} {rhs_tmp} = ({lc})({right_str});")
        emit_line("if ({rhs_tmp} == 0) \{ {emit_panic_site(\"panic: {tname} division by zero at {file}:{loc_line}\", \"\")} }")
        emit_line("if ({lhs_tmp} == (int64_t)0x8000000000000000 && {rhs_tmp} == -1) \{ {emit_panic_site(\"panic: {tname} overflow in {op_msg} at {file}:{loc_line}\", \"\")} }")
        emit_line("{lc} {result_tmp} = {lhs_tmp} {op} {rhs_tmp};")
        expr_result_str = result_tmp
        expr_result_type = left_type
        publish_result_tid(node)
        return
    }

    // Comparison operators desugar to Eq.eq / Ord.cmp for types whose
    // C representation has no usable raw `==`/`<` (structs, Bytes, builtin
    // Instant/Duration, data enums). Simple enums lower to integer tags, so they
    // fall through to raw C below. Typecheck (Stage 4) has already validated
    // that both operands share the type and carry the required impl.
    let is_cmp = op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">="
    if is_cmp {
        // Instant/Duration: `{ int64_t nanos; }` — compare the field directly.
        if left_type == CT_INSTANT || left_type == CT_DURATION {
            expr_result_str = "(({left_str}).nanos {op} ({right_str}).nanos)"
            expr_result_type = CT_BOOL
            publish_result_tid(node)
            return
        }
        // Bytes: runtime structural comparison.
        if left_type == CT_BYTES && right_type == CT_BYTES {
            if op == "==" {
                expr_result_str = "(blink_bytes_eq({left_str}, {right_str}))"
            } else if op == "!=" {
                expr_result_str = "(!blink_bytes_eq({left_str}, {right_str}))"
            } else {
                expr_result_str = "(blink_bytes_cmp({left_str}, {right_str}) {op} 0)"
            }
            expr_result_type = CT_BOOL
            publish_result_tid(node)
            return
        }
        // Struct, or data-enum carrying a custom Eq/Ord: route to the eq/cmp
        // function. The name resolves through the user impl first (mangled,
        // trait-qualified) then the @derive-synthesized `{T}_eq`/`{T}_cmp`.
        let cmp_tname = cmp_operand_type_name(left_type, left_str, right_str)
        if cmp_tname != "" {
            let relational = op != "==" && op != "!="
            if relational == 0 {
                let eq_call = cmp_eq_call(cmp_tname, left_str, right_str)
                if eq_call != "" {
                    expr_result_str = if op == "==" { eq_call } else { "(!{eq_call})" }
                    expr_result_type = CT_BOOL
                    publish_result_tid(node)
                    return
                }
            } else {
                let cmp_call = cmp_cmp_call(cmp_tname, left_str, right_str)
                if cmp_call != "" {
                    let ord_t = c_type_c_name("Ordering")
                    let ct = fresh_temp("__ord")
                    emit_line("{ord_t} {ct} = {cmp_call};")
                    // Desugar table (03_types.md:1804-1807).
                    if op == "<" {
                        expr_result_str = "({ct} == {ord_t}_Less)"
                    } else if op == ">" {
                        expr_result_str = "({ct} == {ord_t}_Greater)"
                    } else if op == "<=" {
                        expr_result_str = "({ct} != {ord_t}_Greater)"
                    } else {
                        expr_result_str = "({ct} != {ord_t}_Less)"
                    }
                    expr_result_type = CT_BOOL
                    publish_result_tid(node)
                    return
                }
            }
        }
    }

    expr_result_str = "({left_str} {op} {right_str})"
    if op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=" {
        expr_result_type = CT_BOOL
        publish_result_tid(node)
    } else {
        expr_result_type = left_type
        publish_result_tid(node)
    }
}

// The struct/data-enum type name a comparison should dispatch through,
// or "" to fall through to raw C. Simple enums (int tags) return "" — raw C
// works. A struct/data-enum returns its name only when it actually carries an
// Eq/Ord (user impl or @derive); otherwise "" (typecheck already rejected the
// genuinely-uncomparable cases, so this just guards the dispatch).
fn cmp_operand_type_name(lt: Int, ls: Str, rs: Str) -> Str {
    if lt == CT_STRUCT {
        let n = get_var_struct(ls)
        if n != "" { return n }
        let nr = get_var_struct(rs)
        if nr != "" { return nr }
    }
    if lt == CT_ENUM {
        let n = get_var_enum(ls)
        // Only data-enums with a real Eq/Ord need dispatch; simple enums and
        // un-derived data-enums fall through (raw tag compare / typecheck-gated).
        if n != "" && is_data_enum(n) != 0 {
            if has_derive_method(n, "eq") != 0 || lookup_impl_method(n, "eq") != 0 {
                return n
            }
        }
    }
    ""
}

// C call for `a.eq(b)`. User `impl Eq` wins (trait-qualified mangled
// symbol); else the @derive-synthesized `{T}_eq`. "" if neither exists.
fn cmp_eq_call(tname: Str, ls: Str, rs: Str) -> Str {
    if lookup_impl_method(tname, "eq") != 0 {
        let reg = impl_method_reg_name(tname, "eq")
        let owner = if impl_type_implements_trait_method(reg, "Eq", "eq") != 0 { "Eq" } else { impl_trait_for_method(reg, "eq") }
        let mangled = if owner != "" { mangle_impl_method_q(reg, owner, "eq") } else { "{reg}_eq" }
        return "{c_fn_name(mangled)}({ls}, {rs})"
    }
    if has_derive_method(tname, "eq") != 0 {
        return "{derive_method_cname(tname, "eq")}({ls}, {rs})"
    }
    ""
}

// C call for `a.cmp(b)` -> Ordering. User `impl Ord` wins; else the
// @derive-synthesized `{T}_cmp`. "" if neither exists.
fn cmp_cmp_call(tname: Str, ls: Str, rs: Str) -> Str {
    if lookup_impl_method(tname, "cmp") != 0 {
        let reg = impl_method_reg_name(tname, "cmp")
        let owner = if impl_type_implements_trait_method(reg, "Ord", "cmp") != 0 { "Ord" } else { impl_trait_for_method(reg, "cmp") }
        let mangled = if owner != "" { mangle_impl_method_q(reg, owner, "cmp") } else { "{reg}_cmp" }
        return "{c_fn_name(mangled)}({ls}, {rs})"
    }
    if has_derive_method(tname, "cmp") != 0 {
        return "{derive_method_cname(tname, "cmp")}({ls}, {rs})"
    }
    ""
}

fn emit_arena_expr_unwind() ! Codegen.Emit {
    let mut di = cg_arena_expr_tmp_stack.len() - 1
    while di >= 0 {
        let inner_tmp = cg_arena_expr_tmp_stack.get(di).unwrap()
        let inner_prev = cg_arena_expr_prev_stack.get(di).unwrap()
        emit_line("__blink_current_arena = {inner_prev};")
        emit_line("blink_arena_destroy({inner_tmp});")
        di = di - 1
    }
}

// Shared emission for the test `skip(reason)` intrinsic, reached from
// both the bare-Ident call path (emit_call) and the qualified `testing.skip(...)`
// path (emit_method_call). Plain `return` (not longjmp) so __attribute__((cleanup))
// destructors fire for in-scope `with` bindings. Typecheck (E0827, §2.20
// test-only fence) guarantees skip() only reaches codegen from inside a test.
// NOTE: a codegen-side re-check of cg_in_test_body is NOT a valid backstop —
// cg_in_test_body is deliberately reset to 0 inside closure bodies (spec §3c.2,
// codegen_closures.bl), yet skip() inside a test-nested closure (e.g.
// testing.for_each's case body) is legal, so such a guard would reject valid
// code. Enforcement lives at typecheck.
pub fn emit_skip_intrinsic(reason_arg: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    emit_expr(reason_arg)
    emit_line("__blink_test_set_skipped({expr_result_str});")
    emit_arena_expr_unwind()
    emit_line("return;")
    expr_result_str = ""
    expr_result_type = CT_VOID
    publish_result_tid(-1)
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_unaryop(node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    emit_expr(node_left(node))
    let operand_str = expr_result_str
    let operand_type = expr_result_type
    // A ptr-erased Option operand carries a blink_Option_ptr box with a void*
    // payload; `?` must spell the erased carrier and cast the payload back.
    let operand_erased = expr_option_erased
    let op = node_op(node)
    if op == "-" {
        if is_sized_int_ct(operand_type) {
            let sneg_tid = cg_expr_node_mono_tid(node_left(node))
            let sneg_flat = c_type_str(operand_type)
            ctype_probe_at(sneg_tid, "expr_unary_neg", "sneg", sneg_flat, node_left(node))
            let sneg_spelled = c_type_from_tid(sneg_tid)
            let lc = if sneg_spelled != "" && sneg_spelled != "void" { sneg_spelled } else { sneg_flat }
            let tname = type_name_from_ct(operand_type)
            let loc_line = panic_line_str(node)
            let file = panic_file_for_fmt(node)
            let result_tmp = fresh_temp("__sneg")
            let in_tmp = fresh_temp("__sneg_in")
            emit_line("{lc} {in_tmp} = ({lc})({operand_str});")
            if operand_type == CT_U8 || operand_type == CT_U16 || operand_type == CT_U32 || operand_type == CT_U64 {
                emit_line("if ({in_tmp} != 0) \{ {emit_panic_site(\"panic: {tname} overflow in unary - at {file}:{loc_line}\", \"\")} }")
                emit_line("{lc} {result_tmp} = 0;")
            } else {
                emit_line("{lc} {result_tmp};")
                emit_line("if (__builtin_sub_overflow(({lc})0, {in_tmp}, &{result_tmp})) \{ {emit_panic_site(\"panic: {tname} overflow in unary - at {file}:{loc_line}\", \"\")} }")
            }
            expr_result_str = result_tmp
            expr_result_type = operand_type
            publish_result_tid(node)
            return
        }
        expr_result_str = "(-{operand_str})"
        expr_result_type = operand_type
        publish_result_tid(node)
    } else if op == "!" {
        expr_result_str = "(!{operand_str})"
        expr_result_type = CT_BOOL
        publish_result_tid(node)
    } else if op == "~" {
        expr_result_str = "(~({operand_str}))"
        expr_result_type = operand_type
        publish_result_tid(node)
    } else if op == "?" {
        let tmp = fresh_temp("__res")
        if operand_type == CT_RESULT {
            if cg_in_test_body != 0 {
                // Spec §2.20: test body using `?` is elaborated to
                // Result[Void, TestError]. Result-sentinel propagation
                // (set globals + plain `return`) so __attribute__((cleanup))
                // destructors run on the way out.
                let rok = expr_result_ok_type
                let rerr = expr_result_err_type
                let rok_s = expr_result_ok_struct
                let rerr_s = expr_result_err_struct
                let res_c = result_c_type_mixed(rok, rerr, rok_s, rerr_s)
                emit_line("{res_c} {tmp} = {operand_str};")
                // WHY raw node_line here (no panic_line_str defensive fallback):
                // __blink_test_set_propagate takes a typed Int line, not a
                // string-formatted location. The UnaryOp `?` node is created
                // only by the parser (src/parser.bl: parse postfix), and the
                // parser always inherits the line from a real inner
                // expression, so node_line(node) > 0 here.
                // If a future transform synthesizes a `?` node, it must
                // propagate a real line (or this site + the runtime helper
                // need a sentinel like -1 mapped to "<synthesized>").
                let qm_line = node_line(node)
                let qm_col = node_col(node)
                let qm_file = panic_file_for(node)
                // C2: a struct-typed err arm is boxed by pointer; deref to render.
                let err_val_expr = if is_boxed_struct_err(rerr_s) != 0 { "*{tmp}.err" } else { "{tmp}.err" }
                let err_msg_expr = test_render_err_message(rerr, rerr_s, err_val_expr)
                let err_type_name = test_err_type_display_name(rerr, rerr_s)
                emit_line("if ({tmp}.tag == 1) \{")
                cg_indent = cg_indent + 1
                if cg_in_assert_panics != 0 {
                    // §2.20: a `?`-propagated Err exiting the body WITHOUT a
                    // panic is E0831 (body returned). Jump to the block's E0831
                    // landing label instead of propagating to the runner.
                    emit_arena_expr_unwind()
                    emit_line("goto __ap_returned_{cg_in_assert_panics};")
                } else {
                    emit_line("__blink_test_set_propagate({err_msg_expr}, \"{err_type_name}\", \"{qm_file}\", {qm_line}, {qm_col});")
                    emit_arena_expr_unwind()
                    emit_line("return;")
                }
                cg_indent = cg_indent - 1
                emit_line("}")
                reseat_after_q_on_result(tmp, rok, rok_s)
            } else if cg_current_fn_ret != CT_RESULT {
                diag_error_at("QuestionMarkResultInNonResult", QM_RESULT_IN_NON_RESULT, "'?' on Result in function '{cg_current_fn_name}' which does not return Result", node, "change the return type to Result")
                diag_set_last_fix("replace", "-> Result[T, E]")
                expr_result_str = "0"
                expr_result_type = CT_INT
                publish_result_tid(node)
            } else {
                let rok = expr_result_ok_type
                let rerr = expr_result_err_type
                let rok_s = expr_result_ok_struct
                let rerr_s = expr_result_err_struct
                let fn_rt = get_fn_ret_type(cg_current_fn_name)
                let fn_fsi = get_fn_ret_struct_inner(cg_current_fn_name)
                let res_c = result_c_type_mixed(rok, rerr, rok_s, rerr_s)
                let fn_res_c = result_c_type_mixed(tp_child1_kind(fn_rt.tp_id), tp_child2_kind(fn_rt.tp_id), fn_fsi.ok_struct, fn_fsi.err_struct)
                emit_line("{res_c} {tmp} = {operand_str};")
                let depth = cg_arena_expr_tmp_stack.len()
                if depth == 0 {
                    emit_line("if ({tmp}.tag == 1) return ({fn_res_c})\{.tag = 1, .err = {tmp}.err};")
                } else {
                    let outer_prev = cg_arena_expr_prev_stack.get(0).unwrap()
                    let err_desc = ct_to_descriptor(rerr, rerr_s)
                    emit_line("if ({tmp}.tag == 1) \{")
                    cg_indent = cg_indent + 1
                    let mut err_expr = "{tmp}.err"
                    if is_boxed_struct_err(rerr_s) != 0 {
                        // C2: a boxed struct err is a heap pointer that blink_alloc
                        // may have landed in an arena about to be torn down below.
                        // Re-box in the surviving outer arena and deep-copy the
                        // pointee, or the returned .err dangles.
                        let box_mangle = descriptor_mangle(err_desc)
                        queue_promote_type(err_desc)
                        let ec = c_type_from_tag(rerr_s)
                        let btmp = fresh_temp("__arena_errbox_")
                        emit_line("{ec}* {btmp} = ({ec}*)blink_promote_alloc({outer_prev}, sizeof({ec}));")
                        emit_line("*{btmp} = blink_promote_{box_mangle}({outer_prev}, *{tmp}.err);")
                        err_expr = btmp
                    } else if err_desc == "P:Str" {
                        let etmp = fresh_temp("__arena_err_")
                        emit_line("const char* {etmp} = blink_promote_str({outer_prev}, {tmp}.err);")
                        err_expr = etmp
                    } else if err_desc != "" && !err_desc.starts_with("P:") {
                        let mangle = descriptor_mangle(err_desc)
                        queue_promote_type(err_desc)
                        let etmp = fresh_temp("__arena_err_")
                        let ec = c_type_from_tag(rerr_s)
                        emit_line("{ec} {etmp} = blink_promote_{mangle}({outer_prev}, {tmp}.err);")
                        err_expr = etmp
                    }
                    let mut di = depth - 1
                    while di >= 0 {
                        let inner_tmp = cg_arena_expr_tmp_stack.get(di).unwrap()
                        let inner_prev = cg_arena_expr_prev_stack.get(di).unwrap()
                        emit_line("__blink_current_arena = {inner_prev};")
                        emit_line("blink_arena_destroy({inner_tmp});")
                        di = di - 1
                    }
                    emit_line("return ({fn_res_c})\{.tag = 1, .err = {err_expr}};")
                    cg_indent = cg_indent - 1
                    emit_line("}")
                }
                reseat_after_q_on_result(tmp, rok, rok_s)
            }
        } else if operand_type == CT_OPTION {
            if cg_in_test_body != 0 {
                // Spec §2.20: test-scope ? on Option None propagates
                // via the Result-sentinel path so cleanup destructors run.
                let opt_inner = expr_option_inner
                let opt_inner_s = expr_option_inner_struct
                // NPO: an Option[@ffi.opaque] operand is the bare handle (NULL = None).
                let operand_is_opaque = opt_inner_s != "" && is_opaque_type(opt_inner_s) != 0
                if opt_inner_s != "" {
                    let opt_c = if operand_erased != 0 {
                        ensure_option_type(CT_PTR)
                        option_c_type(CT_PTR)
                    } else {
                        struct_option_c_type(opt_inner_s)
                    }
                    emit_line("{opt_c} {tmp} = {operand_str};")
                } else {
                    let inner = if opt_inner >= 0 { opt_inner } else { CT_INT }
                    let opt_c = option_c_type(inner)
                    emit_line("{opt_c} {tmp} = {operand_str};")
                }
                // WHY raw node_line here: same invariant as the Result `?`
                // site above — UnaryOp `?` is parser-only and always inherits
                // a real line. See the longer comment above.
                let qm_line = node_line(node)
                let qm_col = node_col(node)
                let qm_file = panic_file_for(node)
                let none_cond = if operand_is_opaque { "{tmp} == NULL" } else { "{tmp}.tag == 0" }
                emit_line("if ({none_cond}) \{")
                cg_indent = cg_indent + 1
                if cg_in_assert_panics != 0 {
                    // §2.20: a `?`-propagated None exiting the body WITHOUT a
                    // panic is E0831 (body returned). Jump to the block's E0831
                    // landing label instead of propagating to the runner.
                    emit_arena_expr_unwind()
                    emit_line("goto __ap_returned_{cg_in_assert_panics};")
                } else {
                    emit_line("__blink_test_set_propagate(\"None\", \"Option\", \"{qm_file}\", {qm_line}, {qm_col});")
                    emit_arena_expr_unwind()
                    emit_line("return;")
                }
                cg_indent = cg_indent - 1
                emit_line("}")
                if opt_inner_s != "" {
                    let inner_c = c_type_from_tag(opt_inner_s)
                    if operand_is_opaque {
                        // NPO: the Some value is the handle itself by identity — no
                        // `.value` read. Guard ahead of the pointer arm, which the
                        // opaque cname also matches.
                        expr_result_str = tmp
                        expr_result_type = CT_STRUCT
                        publish_result_tid(node)
                        set_var_struct(tmp, opt_inner_s)
                    } else if inner_c.ends_with("*") {
                        expr_result_str = "{tmp}.value"
                        expr_result_type = opt_inner
                        publish_result_tid(node)
                    } else if operand_erased != 0 {
                        expr_result_str = "(*({c_type_c_name(opt_inner_s)}*){tmp}.value)"
                        expr_result_type = CT_INT
                        publish_result_tid(node)
                        set_var_struct(expr_result_str, opt_inner_s)
                    } else if is_payloadless_enum(opt_inner_s) != 0 {
                        // By-value ordinal carrier: read {tmp}.value directly. The
                        // boxed deref below would treat the inline ordinal as a pointer.
                        expr_result_str = "{tmp}.value"
                        expr_result_type = CT_INT
                        publish_result_tid(node)
                        set_var_struct(expr_result_str, opt_inner_s)
                    } else if is_transparent_newtype(opt_inner_s) != 0 {
                        // Transparent newtype (Errno): the carrier holds a bare
                        // int64_t inline — read {tmp}.value by identity, no deref.
                        expr_result_str = "{tmp}.value"
                        expr_result_type = CT_INT
                        publish_result_tid(node)
                    } else {
                        expr_result_str = "(*{tmp}.value)"
                        expr_result_type = CT_INT
                        publish_result_tid(node)
                        set_var_struct(expr_result_str, opt_inner_s)
                    }
                } else {
                    let inner = if opt_inner >= 0 { opt_inner } else { CT_INT }
                    expr_result_str = "{tmp}.value"
                    expr_result_type = inner
                    publish_result_tid(node)
                }
                expr_option_inner = -1
                expr_option_inner_struct = ""
            } else if cg_current_fn_ret != CT_OPTION {
                diag_error_at("QuestionMarkOptionInNonOption", QM_OPTION_IN_NON_OPTION, "'?' on Option in function '{cg_current_fn_name}' which does not return Option", node, "change the return type to Option")
                diag_set_last_fix("replace", "-> Option[T]")
                expr_result_str = "0"
                expr_result_type = CT_INT
                publish_result_tid(node)
            } else {
                let opt_inner = expr_option_inner
                let opt_inner_s = expr_option_inner_struct
                let fsi = get_fn_ret_struct_inner(cg_current_fn_name)
                // A `?`-propagated None emits its OWN inline `return`, bypassing the boundary box in
                // emit_return_with_trace. In an erase-only-at-boundary handler op the C return type is
                // the shared blink_Option_ptr ABI, so the None sentinel must spell that carrier.
                let fn_opt_c = if cg_handler_ret_option_erased != 0 {
                    ensure_option_type(CT_PTR)
                    option_c_type(CT_PTR)
                } else if fsi.ok_struct != "" {
                    struct_option_c_type(fsi.ok_struct)
                } else {
                    let fn_inner = if cg_current_fn_option_inner != 0 { cg_current_fn_option_inner } else { CT_INT }
                    option_c_type(fn_inner)
                }
                // The None value the enclosing fn returns. When the fn itself returns
                // Option[@ffi.opaque], {fn_opt_c} is the bare handle (`FILE*`) and its
                // None is the NULL niche — never a `{.tag = 0}` carrier initializer,
                // which is invalid against a pointer type. Keyed on the ENCLOSING fn's
                // return, independent of whether the `?` operand is opaque.
                let fn_ret_opaque = cg_handler_ret_option_erased == 0 && fsi.ok_struct != "" && is_opaque_type(fsi.ok_struct) != 0
                let fn_none_return = if fn_ret_opaque { "(({fn_opt_c})0)" } else { "({fn_opt_c})\{.tag = 0}" }
                if opt_inner_s != "" {
                    let opt_c = if operand_erased != 0 {
                        ensure_option_type(CT_PTR)
                        option_c_type(CT_PTR)
                    } else {
                        struct_option_c_type(opt_inner_s)
                    }
                    emit_line("{opt_c} {tmp} = {operand_str};")
                } else {
                    let inner = if opt_inner >= 0 { opt_inner } else { CT_INT }
                    let opt_c = option_c_type(inner)
                    emit_line("{opt_c} {tmp} = {operand_str};")
                }
                // NPO: an Option[@ffi.opaque] operand IS the handle pointer, so None is
                // the NULL niche, not a `.tag` carrier.
                let operand_is_opaque = opt_inner_s != "" && is_opaque_type(opt_inner_s) != 0
                let none_cond = if operand_is_opaque { "{tmp} == NULL" } else { "{tmp}.tag == 0" }
                let odepth = cg_arena_expr_tmp_stack.len()
                if odepth == 0 {
                    emit_line("if ({none_cond}) return {fn_none_return};")
                } else {
                    emit_line("if ({none_cond}) \{")
                    cg_indent = cg_indent + 1
                    let mut odi = odepth - 1
                    while odi >= 0 {
                        let inner_tmp = cg_arena_expr_tmp_stack.get(odi).unwrap()
                        let inner_prev = cg_arena_expr_prev_stack.get(odi).unwrap()
                        emit_line("__blink_current_arena = {inner_prev};")
                        emit_line("blink_arena_destroy({inner_tmp});")
                        odi = odi - 1
                    }
                    emit_line("return {fn_none_return};")
                    cg_indent = cg_indent - 1
                    emit_line("}")
                }
                if opt_inner_s != "" {
                    let inner_c = c_type_from_tag(opt_inner_s)
                    if operand_is_opaque {
                        // NPO: the Some value is the handle itself by identity — no
                        // `.value` read. Guard ahead of the pointer arm, which the
                        // opaque cname also matches.
                        expr_result_str = tmp
                        expr_result_type = CT_STRUCT
                        publish_result_tid(node)
                        set_var_struct(tmp, opt_inner_s)
                    } else if inner_c.ends_with("*") {
                        expr_result_str = "{tmp}.value"
                        expr_result_type = opt_inner
                        publish_result_tid(node)
                    } else if operand_erased != 0 {
                        expr_result_str = "(*({c_type_c_name(opt_inner_s)}*){tmp}.value)"
                        expr_result_type = CT_INT
                        publish_result_tid(node)
                        set_var_struct(expr_result_str, opt_inner_s)
                    } else if is_payloadless_enum(opt_inner_s) != 0 {
                        // By-value ordinal carrier: read {tmp}.value directly. The
                        // boxed deref below would treat the inline ordinal as a pointer.
                        expr_result_str = "{tmp}.value"
                        expr_result_type = CT_INT
                        publish_result_tid(node)
                        set_var_struct(expr_result_str, opt_inner_s)
                    } else if is_transparent_newtype(opt_inner_s) != 0 {
                        // Transparent newtype (Errno): the carrier holds a bare
                        // int64_t inline — read {tmp}.value by identity, no deref.
                        expr_result_str = "{tmp}.value"
                        expr_result_type = CT_INT
                        publish_result_tid(node)
                    } else {
                        expr_result_str = "(*{tmp}.value)"
                        expr_result_type = CT_INT
                        publish_result_tid(node)
                        set_var_struct(expr_result_str, opt_inner_s)
                    }
                } else {
                    let inner = if opt_inner >= 0 { opt_inner } else { CT_INT }
                    expr_result_str = "{tmp}.value"
                    expr_result_type = inner
                    publish_result_tid(node)
                }
                expr_option_inner = -1
                expr_option_inner_struct = ""
            }
        } else {
            diag_error_at("QuestionMarkInvalidOperand", QM_INVALID_OPERAND, "'?' requires a Result or Option value", node, "")
            expr_result_str = "0"
            expr_result_type = CT_INT
            publish_result_tid(node)
        }
    } else {
        expr_result_str = "({op}{operand_str})"
        expr_result_type = operand_type
        publish_result_tid(node)
    }
}

let mut reorder_result: List[Int] = []

fn reorder_named_args(fn_name: Str, args_sl: Int, call_node: Int) ! Diag.Report {
    reorder_result = []
    if args_sl == -1 {
        return
    }
    let argc = sublist_length(args_sl)
    if argc == 0 {
        return
    }
    let mut positional_end = -1
    let mut i = 0
    while i < argc {
        let arg = sublist_get(args_sl, i)
        if node_kind(arg) == NodeKind.NamedArg {
            positional_end = i
            i = argc
        }
        i = i + 1
    }
    if positional_end == -1 {
        return
    }
    let fn_node = get_fn_node(fn_name)
    if fn_node == -1 {
        return
    }
    let params_sl = node_params(fn_node)
    if params_sl == -1 {
        return
    }
    let param_count = sublist_length(params_sl)
    i = positional_end
    while i < argc {
        let arg = sublist_get(args_sl, i)
        if node_kind(arg) == NodeKind.NamedArg {
            let label = node_name(arg)
            let mut valid = 0
            let mut k = 0
            while k < param_count {
                let pk = sublist_get(params_sl, k)
                if node_name(pk) == label {
                    valid = 1
                    k = param_count
                }
                k = k + 1
            }
            if valid == 0 {
                diag_error_at("InvalidKeywordArg", INVALID_KEYWORD_ARG, "no parameter named '{label}' in function '{fn_name}'", call_node, "check the function signature")
                return
            }
        } else {
            diag_error_at("InvalidKeywordArg", INVALID_KEYWORD_ARG, "positional argument after named argument in call to '{fn_name}'", call_node, "place all positional arguments before named arguments")
            return
        }
        i = i + 1
    }
    let mut result: List[Int] = []
    i = 0
    while i < positional_end {
        result.push(sublist_get(args_sl, i))
        i = i + 1
    }
    i = positional_end
    while i < param_count {
        let param_node = sublist_get(params_sl, i)
        let param_name = node_name(param_node)
        let mut found = 0
        let mut j = positional_end
        while j < argc {
            let arg = sublist_get(args_sl, j)
            if node_kind(arg) == NodeKind.NamedArg {
                let label = node_name(arg)
                if label == param_name {
                    result.push(arg)
                    found = 1
                    j = argc
                }
            }
            j = j + 1
        }
        if found == 0 {
            diag_error_at("MissingKeywordArg", MISSING_KEYWORD_ARG, "missing keyword argument '{param_name}' in call to '{fn_name}'", call_node, "add '{param_name}: <value>'")
            return
        }
        i = i + 1
    }
    reorder_result = result
}

// For a one-level decomposition of an assert(...) condition, we render each
// operand's value via a printf-style format. Falls back to a long-long cast
// for types we cannot pretty-print so the assert still produces a handle.
fn pa_fmt_for_ct(c_expr: Str, ct: Int) -> Str {
    if ct == CT_BOOL {
        return "(({c_expr}) ? \"true\" : \"false\")"
    }
    if ct == CT_FLOAT {
        return "(double)({c_expr})"
    }
    if ct == CT_STRING {
        return "({c_expr}) ? ({c_expr}) : \"\""
    }
    if ct == CT_CHAR {
        return "(int)({c_expr})"
    }
    return "(long long)({c_expr})"
}

fn pa_fmt_spec_for_ct(ct: Int) -> Str {
    if ct == CT_BOOL { return "%s" }
    if ct == CT_FLOAT { return "%g" }
    if ct == CT_STRING { return "\\\"%s\\\"" }
    if ct == CT_CHAR { return "%d" }
    return "%lld"
}

// Build the snprintf format chunk for one introspection line: "  <src> = <fmt>".
// escape_c_string covers backslash + quote; identifiers don't carry % and we
// don't decompose into string-literal interiors, so the source text is safe to
// embed in the snprintf format directly.
fn pa_intro_line(src_text: Str, ct: Int) -> Str {
    "  {escape_c_string(src_text)} = {pa_fmt_spec_for_ct(ct)}"
}

// Renderable binop ops for one-level introspection (comparisons + logical).
// Arithmetic ops at the assert top level are unusual and rendering them
// would require care for division-by-zero etc., so we keep the set tight.
fn pa_op_renderable(op: Str) -> Int {
    if op == "==" || op == "!=" { return 1 }
    if op == "<" || op == "<=" { return 1 }
    if op == ">" || op == ">=" { return 1 }
    if op == "&&" || op == "||" { return 1 }
    0
}

// A CT whose value the assert predicate-analysis can decompose into a
// raw-C comparison + %-formatted intro line. Structs, enums, Option, Bytes,
// Instant/Duration carry no usable raw `==`/`<` and no scalar %-format, so an
// assert over them must emit the whole (already-desugared) condition instead.
fn pa_ct_renderable(ct: Int) -> Int {
    if ct == CT_INT || ct == CT_BOOL || ct == CT_FLOAT || ct == CT_CHAR || ct == CT_STRING { return 1 }
    if ct == CT_I8 || ct == CT_I16 || ct == CT_I32 { return 1 }
    if ct == CT_U8 || ct == CT_U16 || ct == CT_U32 || ct == CT_U64 { return 1 }
    0
}

// Carrier type for one side of a Result/Option from a type-annotation element
// name: a struct/enum name carries as CT_INT with struct_name set; everything
// else carries as `fallback` with no struct.
fn carrier_from_elem_name(name: Str, fallback: Int, ann_node: Int) -> CarrierInfo {
    if is_struct_type(name) != 0 || is_enum_type(name) != 0 {
        // A generic struct INSTANCE side (Box[Int]) must carry its recursive mono
        // stem (Box_Int) by value, not the erased bare head (Box) — otherwise the
        // carrier typedef embeds `blink_Box ok`, which is never typedef'd.
        // The type-args live in ann_node's elements, invisible to the head name, so
        // recurse the annotation exactly like resolve_result_inner_tag. Thread the
        // ACTIVE mono context so a carrier inner that is a generic-struct instance whose
        // type arg is the enclosing struct's binder (`RB[T] { r: Result[Inner[T], Str] }`,
        // built as `RB[Int]`) substitutes T→Int here and spells `Inner_0Int` — the same
        // stem the def-side typedef uses — instead of the erased `Inner_0T`.
        let mono = mono_name_from_ann(strip_module_qualifier(name), ann_node, cg_mono_tparams_sl, segs_from_arg_tids(cg_mono_arg_tids))
        if mono != "" { return CarrierInfo { type_const: CT_INT, struct_name: mono } }
        return CarrierInfo { type_const: CT_INT, struct_name: name }
    }
    CarrierInfo { type_const: fallback, struct_name: "" }
}

// Carrier for one side of a Result whose annotation is a compound (`Result[Option[T],
// E]`, `Result[Map[K,V], E]`, ...). carrier_from_elem_name leaves such a side's
// struct_name empty because the annotation name ("Option"/"Result"/"Map") is neither a
// struct nor an enum, which erases the carrier member's tag to
// `blink_Result_option_…`/`blink_Result_map_…` — the member is embedded by value (or,
// for a Map, is a uniform `blink_map*`), so it needs the structured `Option_T` /
// `Result_.._..` / `Map_{k}_{v}` tag.
//
// The Map side is spelled STRUCTURED (`Map_{key}_{val}`) too, matching the annotation
// path (param_c_type → resolve_result_inner_tag → compound_name_from_ann) and the tid
// path. Because the C layout is identical (the
// `blink_map*` member is the same regardless of tag), spelling the Map side structured
// keeps cross-constructor assignment legal AND lets the shape ride the tid path. Every
// Map-result construction site (Ok / Err / reassignment) routes through here, so they all
// agree on the structured name. Non-compound sides are returned unchanged.
fn upgrade_compound_carrier(c: CarrierInfo, ann_node: Int) -> CarrierInfo {
    if c.struct_name != "" { return c }
    if ann_node == -1 { return c }
    let ct = type_from_name(node_name(ann_node))
    if ct != CT_OPTION && ct != CT_RESULT && ct != CT_MAP { return c }
    CarrierInfo { type_const: ct, struct_name: compound_name_from_ann(ann_node) }
}

// Select the kops element carrier from the ctor NODE's memoized tid, which
// typecheck already pinned: a bare Map()/Set() passed directly to a
// generic param has its metavar key/elem bound in place by
// tc_pin_generic_args_from_binds, so the resolving accessors surface the real
// concrete type. Mirrors recover_elem_ct_from_arg (the insert-site sibling):
// a named @derive(Hash,Eq) struct key -> {CT_STRUCT-carrier, sname} but only
// when kops_is_struct_key confirms it registered; else a resolved scalar CT;
// else {CT_VOID, ""} meaning "no claim — fall through to the annotation path".
// Tuple keys decline here (tid_inner_struct returns "" for TyKind.Tuple, tid_inner_ct
// returns -1) so resolve_ctor_kops_elem's tuple branch registers them.
fn ctor_kops_elem_from_node_tid(node: Int, container: Str) -> CarrierInfo ! Codegen.Emit {
    // A bare Map()/Set() ctor LOCAL to a generic fn's own body (e.g. `fn mk_key[T](v: T)
    // { let mut m: Map[HBox[HBox[T]], Int] = Map() ... }`) has its K/V typechecked
    // ONCE, polymorphically — the node's own memoized tid still carries the fn's
    // bare typevar T, not this instantiation's concrete arg. tc_tid_subst_mono
    // rewrites it through the ACTIVE mono context, mirroring recover_map_kv_from_tid's
    // identical rationale; a no-op outside a
    // mono body or when nothing needs rewriting.
    let raw_tid = tc_lookup_node_tid(node)
    let tid = tc_tid_subst_mono(raw_tid, cg_mono_tparams_sl, cg_mono_arg_tids)
    let sname = if container == "Map" { tc_tid_map_key_struct_resolved(tid) } else { tc_tid_set_elem_struct_resolved(tid) }
    // A generic-struct instance key (e.g. "HBox_0Int") joins derive_hash_types/
    // derive_eq_types here, on first use, when its declared base derives Hash/Eq —
    // mirrors ensure_tuple_carrier_from_tid's tuple-key twin.
    ensure_struct_derive_kops_key(sname)
    if kops_is_struct_key(sname) {
        return CarrierInfo { type_const: type_from_name(sname), struct_name: sname }
    }
    let ct = if container == "Map" { tc_tid_map_key_ct_resolved(tid) } else { tc_tid_set_elem_ct_resolved(tid) }
    if ct >= 0 {
        return CarrierInfo { type_const: ct, struct_name: "" }
    }
    CarrierInfo { type_const: CT_VOID, struct_name: "" }
}

// One tuple element's registration encoding: the CT stored in the TupleEntry's
// elem_types slot, the by-value carrier tag stored in its elem_structs slot ("" for a
// scalar, which encodes as "-"), whether this element is encodable from a tid at
// all, and the resolved NAME stored in the TupleEntry's elem_names slot ("" for
// every element except a genuine Void, which is "Void", mirroring
// resolve_tuple_ann's elem_names_enc). `ok: false` means "decline the whole tuple" —
// see ensure_tuple_carrier_from_tid.
type TidTupleElem { ct: Int, struct_tag: Str, ok: Bool, name: Str }

// Register the tuple CARRIER a tid names — the TupleEntry plus its Hash/Eq derive —
// from the TID rather than from an annotation, returning the registered C tag ("" when
// the tid is not a tuple, or an element is not encodable here).
//
// The annotation twin is key_struct_sname_from_ann -> resolve_tuple_ann, which the
// DIRECT `let s: Set[(Int, Int)] = Set()` ctor uses. A tuple that reaches the ctor
// THROUGH a type param has no annotation to read: `GT[(Int, Int)] { s: Set() }` spells
// the field's `Set[T]` element by resolving T off the instance tid, and a
// generic-fn mono over a tuple key does the same. Unregistered,
// find_tuple_entry misses, ensure_tuple_kops_key returns 0, and the ctor keeps
// blink_kops_str — an Int-keyed tuple hashed as a C string, wearing a fully correct
// mono name. Registering at the ctor is the symmetric fix: it is
// exactly where the annotation path registers too.
//
// The NAME comes from tc_tid_tuple_sname (== tc_tid_tuple_tag), the same speller
// tc_tid_to_c_tag used for the enclosing mono args, so the carrier registered here is by
// construction the one the caller goes on to name.
//
// The per-element encoding mirrors resolve_tuple_ann arm for arm, producing for the
// direct `Set[..] = Set()` C: Int -> (CT_INT, "-"),
// List[Str] -> (CT_LIST, "-"), (Int,Int) -> (CT_VOID, "Tuple2_int_int"),
// Option[Str] -> (CT_OPTION, "Option_str"), Map[Str,Int] -> (CT_MAP, "Map_str_int"),
// Pt -> (CT_VOID, "Pt"). That parity is load-bearing: ensure_tuple_type is name-keyed and
// idempotent, so when a later tuple LITERAL of the same shape re-registers, whichever ran
// first defines the C field types for both.
//
// Declining ("") is for shapes NEITHER path can spell. It is not a safe fallback for a
// shape the mono namer already spelled: this fn's caller then names the carrier anyway
// and kops_table_name emits its BLINK_COMPILER_BUG sentinel, which reaches cc as an
// undeclared identifier with no source span. Keep the admission set here in step with
// tc_tid_tuple_elem_faithful, the gate that decides which slots get here at all.
pub fn ensure_tuple_carrier_from_tid(tid: Int) -> Str {
    let c_name = tc_tid_tuple_sname(tid)
    // "" and a bare ICE_SEG_* sentinel (tc_tid_tuple_sname can answer one for a tuple
    // with a non-genuine element) both mean "cannot register a
    // real carrier under this name" — decline rather than typedef'ing the sentinel.
    if c_name == "" || diag_is_ice_seg(c_name) { return "" }
    if find_tuple_entry(c_name) >= 0 {
        ensure_tuple_kops_key(c_name)
        return c_name
    }
    let arity = tc_tid_tuple_arity(tid)
    let mut elem_types = ""
    let mut elem_structs = ""
    let mut elem_names = ""
    let mut i = 0
    while i < arity {
        let enc = tid_tuple_elem_enc(tc_tid_tuple_elem_tid(tid, i))
        if !enc.ok { return "" }
        if i > 0 {
            elem_types = elem_types.concat(",")
            elem_structs = elem_structs.concat(",")
            elem_names = elem_names.concat(",")
        }
        elem_types = elem_types.concat("{enc.ct}")
        elem_structs = elem_structs.concat(if enc.struct_tag != "" { enc.struct_tag } else { "-" })
        elem_names = elem_names.concat(enc.name)
        i = i + 1
    }
    ensure_tuple_type(c_name, arity, elem_types, elem_structs, elem_names)
    ensure_tuple_kops_key(c_name)
    c_name
}

fn tid_tuple_elem_enc(tid0: Int) -> TidTupleElem {
    // Resolve bound metavars up front, as tc_tid_to_c_tag / tc_tid_inner_tag do: the
    // kind reads below (tc_tid_tuple_sname, tc_tid_struct, tc_tid_ct) are all
    // NON-resolving, so a pinned α would read TyKind.Unknown and decline the whole tuple.
    let tid = tc_tid_resolved(tid0)
    // A nested tuple element is embedded BY VALUE, so its own carrier must be
    // registered first — emit_tuple_typedef's dep loop then emits the inner typedef
    // ahead of the outer one. Recurse before anything else: tc_tid_ct has no TyKind.Tuple
    // arm (it would read -1 and decline).
    let tuple_sname = tc_tid_tuple_sname(tid)
    // Non-"" does not by itself mean "a real tuple carrier":
    // tc_tid_tuple_sname recurses tc_tid_inner_tag, which can answer a bare
    // ICE_SEG_* sentinel for a non-genuine element — decline rather than register a
    // typedef under that name.
    if tuple_sname != "" && !diag_is_ice_seg(tuple_sname) {
        let inner = ensure_tuple_carrier_from_tid(tid)
        if inner == "" || diag_is_ice_seg(inner) { return TidTupleElem { ct: CT_VOID, struct_tag: "", ok: false, name: "" } }
        return TidTupleElem { ct: CT_VOID, struct_tag: inner, ok: true, name: "" }
    }
    // A transparent newtype (Errno) element lowers to a bare int64_t, so its tuple
    // field is a plain scalar — not the boxed enum the struct arm below would spell.
    // Matches resolve_tuple_ann's is_tnt arm and emit_tuple_lit's inferred path;
    // Result keeps its nominal Errno tag, so this stays tuple-specific.
    if tc_tid_struct(tid) != "" && is_transparent_newtype(tc_tid_inner_tag(tid)) != 0 {
        return TidTupleElem { ct: CT_INT, struct_tag: "", ok: true, name: "" }
    }
    // Struct or enum (tc_tid_struct covers both kinds): embedded by value under
    // tc_tid_inner_tag's tag, which is c_type_tag_for_struct / the mono stem — the same
    // spelling resolve_tuple_ann's struct/enum arm produces.
    if tc_tid_struct(tid) != "" {
        let tag = tc_tid_inner_tag(tid)
        // Decline on "" (unreachable today — kept for symmetry) or on a bare ICE_SEG_*
        // sentinel (tc_tid_inner_tag can answer one instead of
        // erasing to "void") — either way this element isn't a real spellable carrier.
        if tag == "" || diag_is_ice_seg(tag) { return TidTupleElem { ct: CT_VOID, struct_tag: "", ok: false, name: "" } }
        return TidTupleElem { ct: CT_VOID, struct_tag: tag, ok: true, name: "" }
    }
    let ct = tc_tid_ct(tid)
    if ct == CT_OPTION || ct == CT_RESULT {
        let tag = tc_tid_inner_tag(tid)
        // Decline on an unspellable inner, symmetrically with the struct arm above. An
        // empty tag would encode as "-" (the scalar spelling) while ct still said
        // CT_OPTION, so emit_tuple_typedef would emit a carrier-typed field with no
        // carrier registered for it. A bare ICE_SEG_* sentinel is the
        // same class of non-spellable inner and declines the same way.
        if tag == "" || diag_is_ice_seg(tag) { return TidTupleElem { ct: CT_VOID, struct_tag: "", ok: false, name: "" } }
        ensure_carrier_from_tag(tag)
        return TidTupleElem { ct: ct, struct_tag: tag, ok: true, name: "" }
    }
    // Scalars, and the containers whose tuple field is a uniform pointer
    // (Map/List/Set/Bytes/Iterator): tc_tid_tag_at's TAGPOS_INNER arm and c_type_tag agree on
    // the tag, and
    // the field type comes from the CT alone. tc_tid_ct maps TyKind.Void onto CT_VOID and
    // then to -1 (tc_tid_ct cannot distinguish a genuine Void from an unsolved
    // metavar by CT alone, in typecheck.bl), so a genuine Void is admitted here by
    // KIND via tc_tid_inner_tag, which answers the literal string "void" only for
    // TyKind.Void, the tid twin of resolve_tuple_ann's elem_name == "Void"
    // check. An unsolved metavar is foreclosed before codegen by E0301, so it never
    // reaches this arm.
    if ct < 0 {
        if tc_tid_inner_tag(tid) == "void" {
            return TidTupleElem { ct: CT_VOID, struct_tag: "", ok: true, name: "Void" }
        }
        return TidTupleElem { ct: CT_VOID, struct_tag: "", ok: false, name: "" }
    }
    TidTupleElem { ct: ct, struct_tag: "", ok: true, name: "" }
}

// Fail-closed backstop. Reached only when every earlier
// tier — the tid-native answer, the def-side return annotation, and the
// value-context annotation — has declined and tier 2 (resolve_ctor_kops_elem)
// fell all the way through to its CT_STRING/"" default. That default is
// legitimate at the countless non-tail sites where an unresolved typevar's kops
// choice is corrected downstream by recover_elem_ct_from_arg
// — this tier must not disturb any of them, so it fires only when BOTH:
//   (1) this ctor is the enclosing fn's tail value (struct_lit_is_fn_tail_value)
//       — the one position with no downstream call-arg/insert-site correction to
//       catch a wrong guess,
//   (2) `fallback` IS tier 2's decline default ({CT_STRING, ""}) and not a real
//       answer — tier C (ctor_ret_ann_kops_elem) resolves impl methods, closures
//       and generic-fn-mono instances by reading the def-side annotation
//       directly, entirely bypassing typecheck's own tid pin, so a real answer
//       from tier C must win here even though the tid below still reads
//       unsolved, or this backstop would over-fire on a case tier C already
//       resolved correctly, and
//   (3) the ctor's own memoized tid PROVES the kops-deciding slot is still an
//       unbound metavar (tc_tid_kops_slot_unsolved) — not merely "no tier
//       answered", which would also slander a real TyKind.Typevar or the shared
//       TYPE_UNKNOWN singleton.
// Mirrors emit_struct_lit's own I0001 chokepoint: diag_ice_at then
// CONTINUE — "ice" severity already exits blinkc with 101 before any C is
// written, so the fallback this returns only keeps the rest of emit_call's
// control flow well-typed, not because the fallback ever reaches a linker.
fn ctor_kops_fail_closed(container: Str, node: Int, fallback: CarrierInfo) -> CarrierInfo ! Diag.Report {
    if struct_lit_is_fn_tail_value(node) == 0 { return fallback }
    if fallback.type_const != CT_STRING || fallback.struct_name != "" { return fallback }
    let tid = tc_lookup_node_tid(node)
    if tc_tid_kops_slot_unsolved(tid, container) == 0 { return fallback }
    diag_ice_at("UnsolvedTypeVarAtCodegen", UNSOLVED_TYPEVAR_AT_CODEGEN,
        "{container}()'s key/element type reached construction unsolved",
        node,
        "this is a compiler bug — the type should have been inferred, or reported as error[CannotInferType]")
    fallback
}

// Shared decoder behind resolve_ctor_kops_elem and the def-side twin
// ctor_ret_ann_kops_elem: given an annotation node already known to be the right
// container ("Set"/"Map"), decode its element arg into the kops carrier. Declining
// (no evidence at all) is spelled {CT_VOID, ""} — the same sentinel
// ctor_kops_elem_from_node_tid uses at its own decline — so a caller can tell "this
// tier has nothing to say" apart from a real answer and fall through to the next
// tier. The two tuple branches below return {CT_VOID, non-empty}, and the concrete
// branch can return {CT_STRING, "Str"} for a genuine Str key — both distinguishable
// from the decline sentinel by the (kind, name) pair together, never by kind alone.
fn kops_elem_from_container_ann(ann: Int, container: Str) -> CarrierInfo ! Codegen.Emit {
    if ann == -1 || node_name(ann) != container { return CarrierInfo { type_const: CT_VOID, struct_name: "" } }
    let ta_elems = node_elements(ann)
    if ta_elems == -1 || sublist_length(ta_elems) < 1 { return CarrierInfo { type_const: CT_VOID, struct_name: "" } }
    let e_ann = sublist_get(ta_elems, 0)
    let e_raw = node_name(e_ann)
    let e_name = resolve_tparam_via_tid(e_raw, cg_mono_tparams_sl, cg_mono_arg_tids)
    // Resolved, so the tid's tuple tag is the one tc_tid_to_c_tag (and therefore e_name)
    // spelled — tc_tid_to_c_tag resolves bound metavars, tc_tid_tuple_sname does not.
    let e_tid = tc_tid_resolved(tparam_tid_via_mono(e_raw, cg_mono_tparams_sl, cg_mono_arg_tids))
    let e_tuple = tc_tid_tuple_sname(e_tid)
    // Gated on dbg_channel_on, per ast.bl's note: the message is interpolated EAGERLY, and
    // this runs at every Set()/Map() ctor in every compiled program (the compiler's own
    // bootstrap included), so an ungated tap is not the "zero cost when unset" CLAUDE.md
    // documents.
    if dbg_channel_on("kopsctor") != 0 {
        dbg_trace("kopsctor", "container={container} raw={e_raw} e_name={e_name} tid={e_tid} tuple={e_tuple}")
    }
    if e_name == "Tuple" {
        return CarrierInfo { type_const: CT_VOID, struct_name: key_struct_sname_from_ann(e_ann, cg_mono_tparams_sl, segs_from_arg_tids(cg_mono_arg_tids)) }
    }
    // The element reached us THROUGH a type param, already spelled as a tuple carrier
    // ("Tuple2_int_int"), so the literal-"Tuple" branch above never sees it. Two ways in:
    // a generic-fn mono over a tuple key, and a generic STRUCT whose type arg
    // is a tuple — `GT[(Int, Int)] { s: Set() }` — where the field loop's mono
    // context resolves T off the instance tid.
    //
    // This must precede kops_elem_is_concrete, which says FALSE for a tuple carrier name
    // (neither a primitive nor an is_named_type) and so would fall through to the
    // decline default — an Int-keyed tuple hashed as a C string, a
    // collision under a fully correct mono name.
    //
    // Decided on the TID's kind, not on the name's shape: a name test would be a
    // "Tuple"-prefix guess that a user type could satisfy, and the tid is what
    // ensure_tuple_carrier_from_tid needs anyway. Claiming the carrier UNCONDITIONALLY
    // once the tid says tuple is deliberate — if registration declined, kops_table_name
    // emits its BLINK_COMPILER_BUG sentinel and the C compiler stops, which is the right
    // failure for a shape we cannot hash. Falling through to the decline default here
    // would be silent corruption instead.
    // Name the carrier that was actually REGISTERED rather than assuming the two
    // spellers agree: e_name comes from tc_seg_from_tid and the registration from
    // tc_tid_tuple_sname, and a silent divergence between two tid spellers is a
    // documented hazard. kops_table_name is keyed on this name, so it must
    // be the registered one. On a decline ("") keep e_name, which resolves to the
    // BLINK_COMPILER_BUG sentinel — "" would read as a scalar void instead.
    if e_tuple != "" {
        let reg = ensure_tuple_carrier_from_tid(e_tid)
        return CarrierInfo { type_const: CT_VOID, struct_name: if reg != "" { reg } else { e_name } }
    }
    // e_name reached us as a bare DECLARED generic struct/enum head ("HBox"), not a
    // literal tparam binder or an already-resolved instance — resolve_tparam_via_tid
    // only matches a name that IS a tparam, never a struct's own name that merely
    // NESTS one in its type args (`HBox[HBox[T]]`). mono_name_from_ann is the
    // existing recursive annotation walker (used at the def-side return/param
    // signature seam) that spells the full mangled instance through the ACTIVE mono
    // context; it declines ("") for a non-generic struct, so this falls through to
    // the concrete branch unchanged for every shape that already worked. Must
    // precede kops_elem_is_concrete, which would otherwise treat the
    // bare unmangled head as if it were the final key name and register nothing
    // useful for it (lookup_mono_base("HBox") finds no instance).
    if is_struct_type(e_name) != 0 || is_enum_type(e_name) != 0 {
        let mono_name = mono_name_from_ann(strip_module_qualifier(e_name), e_ann, cg_mono_tparams_sl, segs_from_arg_tids(cg_mono_arg_tids))
        if mono_name != "" {
            ensure_struct_derive_kops_key_for_base(mono_name, e_name)
            return CarrierInfo { type_const: CT_VOID, struct_name: mono_name }
        }
    }
    if kops_elem_is_concrete(e_name) {
        // A no-op for anything that isn't a derived-generic-struct instance name
        // (lookup_mono_base declines); see ctor_kops_elem_from_node_tid's twin call.
        ensure_struct_derive_kops_key(e_name)
        return CarrierInfo { type_const: type_from_name(e_name), struct_name: e_name }
    }
    CarrierInfo { type_const: CT_VOID, struct_name: "" }
}

// Def-side return-annotation tier for a Map()/Set() ctor's kops element — the
// container-shaped twin of struct_ret_ann_arg_tids, both answering "what does the
// enclosing fn's OWN return annotation say" rather than a per-value-context oracle.
// Covers the def-side gap tier 1 (ctor_kops_elem_from_node_tid) and tier 2
// (resolve_ctor_kops_elem) both miss: an impl method's declared return never
// reaches lookup_fnsig, an annotated closure's own declared return, a tuple
// key on a generic-fn mono instance, and any
// generic-fn return whose type param the enclosing mono context has bound.
//
// Gated on struct_lit_is_fn_tail_value exactly as struct_ret_ann_arg_tids is — a
// return annotation is in scope for the WHOLE fn body, so ungated this would stamp
// the return type onto an unrelated same-shaped Map()/Set() anywhere in the body.
//
// Unlike struct_ret_ann_arg_tids, a non-binder concrete annotation arg (a plain
// `-> Map[Int, Str]`, no type param at all) is exactly the case this tier exists
// for — do not bail on it. kops_elem_from_container_ann already resolves a
// concrete name straight through (kops_elem_is_concrete), and resolves a binder
// via resolve_tparam_via_tid/tparam_tid_via_mono when the fn IS generic.
fn ctor_ret_ann_kops_elem(container: Str, node: Int) -> CarrierInfo ! Codegen.Emit {
    let tracing = dbg_channel_on("retann")
    if struct_lit_is_fn_tail_value(node) == 0 {
        if tracing != 0 { dbg_trace("retann", "{container} ctor: not the enclosing fn's tail value") }
        return CarrierInfo { type_const: CT_VOID, struct_name: "" }
    }
    // No separate cg_current_fn_node == -1 check needed: struct_lit_is_fn_tail_value
    // already returns 0 in that case (it's the first thing it checks), so reaching
    // here guarantees cg_current_fn_node is a valid node.
    let ann = node_type_ann(cg_current_fn_node)
    if ann == -1 {
        if tracing != 0 { dbg_trace("retann", "{container} ctor: enclosing fn has no return annotation") }
        return CarrierInfo { type_const: CT_VOID, struct_name: "" }
    }
    if node_name(ann) != container {
        if tracing != 0 { dbg_trace("retann", "{container} ctor: return annotation names {node_name(ann)}") }
        return CarrierInfo { type_const: CT_VOID, struct_name: "" }
    }
    kops_elem_from_container_ann(ann, container)
}

// Select the kops element carrier (ct + sname) for a Set()/Map() constructor from
// its declared container annotation. `container` is "Set" or "Map". A struct-field
// initializer or call-arg supplies the type via cg_expect_arg_ann, not
// cg_let_target_ann; prefer it, but only when it actually names the
// container — a let-RHS block-expr inside a call arg leaves cg_expect_arg_ann on the
// OUTER param (e.g. Int), which must not shadow the block-local `let s: Set[..] =`'s
// target. The string default (CT_STRING/"") is kept for an unresolved typevar
// (generic-struct field Set[T]/Map[K,_], which typecheck never monomorphizes);
// recover_elem_ct_from_arg corrects the kops downstream.
fn resolve_ctor_kops_elem(container: Str) -> CarrierInfo ! Codegen.Emit {
    let ann = if cg_expect_arg_ann != -1 && node_name(cg_expect_arg_ann) == container { cg_expect_arg_ann } else { cg_let_target_ann }
    let dec = kops_elem_from_container_ann(ann, container)
    if dec.type_const == CT_VOID && dec.struct_name == "" { return CarrierInfo { type_const: CT_STRING, struct_name: "" } }
    dec
}

// The full four-tier kops-carrier resolution for a Map()/Set() ctor, shared by
// emit_call's "Map" and "Set" arms (which previously duplicated this exact chain
// verbatim per container): the ctor's own memoized tid, the enclosing fn's own
// return annotation, the value-context annotation, and — only once every earlier
// tier has declined — the fail-closed I0001 backstop.
fn resolve_kops_carrier(container: Str, node: Int) -> CarrierInfo ! Codegen.Emit, Diag.Report {
    let nt = ctor_kops_elem_from_node_tid(node, container)
    let rt = if nt.type_const != CT_VOID || nt.struct_name != "" { nt } else { ctor_ret_ann_kops_elem(container, node) }
    let ec0 = if rt.type_const != CT_VOID || rt.struct_name != "" { rt } else { resolve_ctor_kops_elem(container) }
    ctor_kops_fail_closed(container, node, ec0)
}

// Carrier for a just-emitted argument expression. Used when the carrier's
// annotation name is an unresolved generic param (e.g. the `E` in
// `Result[Int, E]`), so it can't name the concrete type — we recover it from
// the emitted value: a struct/enum value carries its name via get_var_struct/
// get_var_enum, everything else carries its scalar kind. Lets a generic
// `Result[T,E]` param infer E from the `Err(...)` arg's actual payload.
fn carrier_from_emitted(expr_str: Str, ct: Int) -> CarrierInfo {
    if ct == CT_STRUCT {
        let sn = get_var_struct(expr_str)
        if sn != "" { return CarrierInfo { type_const: CT_INT, struct_name: sn } }
    }
    if ct == CT_ENUM {
        let en = get_var_enum(expr_str)
        if en != "" { return CarrierInfo { type_const: CT_INT, struct_name: en } }
    }
    CarrierInfo { type_const: ct, struct_name: "" }
}

// Resolves the inner struct/enum name from the expected call-argument annotation
// (cg_expect_arg_ann) when it is `Option[Struct]`/`Result[Struct, _]`. Lets bare
// carrier constructors at a call site pick the parameter's expected carrier.
// Returns "" when there is no struct-typed carrier to adopt.
fn expect_arg_option_inner_struct() -> Str {
    if cg_expect_arg_ann == -1 { return "" }
    if node_name(cg_expect_arg_ann) != "Option" { return "" }
    let elems = node_elements(cg_expect_arg_ann)
    if elems == -1 || sublist_length(elems) < 1 { return "" }
    let inner_ann = sublist_get(elems, 0)
    let inner = node_name(inner_ann)
    if is_struct_type(inner) != 0 || is_enum_type(inner) != 0 {
        // A generic-struct-instance inner (`Option[Inner[T]]` on a mono struct built
        // as `OB[Int]`) must spell its recursive mono stem (`Inner_0Int`) from the
        // ACTIVE mono context, matching the def-side field typedef — not the erased
        // bare head (`Inner`), which spells a `blink_Option_Inner` that mismatches the
        // field's `blink_Option_Inner_0Int` when a bare `None` adopts this carrier.
        let mono = mono_name_from_ann(strip_module_qualifier(inner), inner_ann, cg_mono_tparams_sl, segs_from_arg_tids(cg_mono_arg_tids))
        if mono != "" { return mono }
        return inner
    }
    if is_compound_ct(type_from_name(inner)) != 0 || inner == "Tuple" {
        return compound_name_from_ann(inner_ann)
    }
    ""
}

// Returns the declared type-annotation node for field `fname` from a struct's
// field-def sublist `td_flds`, or -1 if the sublist is empty or the field
// isn't found. Used by emit_struct_lit to thread the field's expected carrier
// (e.g. Option[Str]) into emit_expr via cg_expect_arg_ann so a bare `None`
// field adopts it. Callers resolve `td_flds` once via
// `node_fields(find_type_def_node(sname))` rather than per field.
fn struct_field_type_ann(td_flds: Int, fname: Str) -> Int {
    if td_flds == -1 { return -1 }
    let mut fi = 0
    while fi < sublist_length(td_flds) {
        let f = sublist_get(td_flds, fi)
        if node_name(f) == fname {
            return node_value(f)
        }
        fi = fi + 1
    }
    -1
}

// The field's declared type annotation RESOLVED AT THIS INSTANTIATION — the annotation the
// field-annotation retarget hands to a nested emission.
//
// A field declared with a bare type-param binder (`value: T`) has an annotation node that
// carries no type information at all, so retargeting to it literally would hand the nested
// value a blank context. Descend ONE LEVEL instead: take the value-context annotation that
// names THIS struct and read its matching type argument. For
//     let x: Box[Box[Option[Str]]] = Box { value: Box { value: None } }
// the outer literal's `value: T` resolves to `Box[Option[Str]]`, so the inner literal sees
// the annotation describing ITSELF rather than its parent — which is what makes the retarget
// LEVEL-CORRECT rather than merely level-shifted. Without the descent the inner literal has
// neither an annotation nor a usable own tid (a bare `None` reverse-infers Option[metavar],
// an unencodable slot) and the instantiation reaches monomorphization as
// BLINK_I0001_erased_slot.
//
// Channel precedence mirrors tid_native_struct_inst_tid and struct_concrete_args_from_target
// exactly — cg_expect_arg_ann first, then cg_let_target_ann, both matched by bare struct
// name — so the annotation descended through is the SAME one those consumers would have read
// for this literal. Only a BARE binder is descended: an annotation carrying type arguments of
// its own (`next: Option[Node[T]]`) already describes the field, and a non-binder name is
// already concrete.
//
// Every failure to descend faithfully falls back to the declared annotation — no
// value-context annotation names this struct, an arity disagreement, a name that is not a
// binder here. That fallback can still SPELL a type-param binder, which is why the
// cg_let_target_ann half of the retarget is gated on value_ctx_ann_spellable below.
fn field_ann_at_instance(td_flds: Int, td_tparams: Int, sname: Str, fname: Str) -> Int {
    descend_field_ann(struct_field_type_ann(td_flds, fname), td_tparams, sname)
}

// Emit the fi-th positional argument of a data-enum variant constructor with the
// value-context annotation retargeted to that variant field's declared type, so a
// compound arg (`V(Result[P, Int])` → the `Ok(...)` value) adopts the declared
// payload type instead of reverse-inferring its own slots (err defaulted to str,
// ok to int) and minting a carrier that mismatches the declared field. Returns the
// emitted C expression. Shared by the bare-Call (`V(..)`) and qualified (`E.V(..)`)
// positional ctor paths; the struct-style path retargets via field_ann_at_instance
// directly. Mirrors the field-annotation retarget's channel discipline exactly:
// cg_expect_arg_ann unconditionally, cg_let_target_ann only when spellable.
@allow(UnrestoredMutation, IncompleteStateRestore)
pub fn emit_variant_positional_arg(arg_node: Int, enum_name: Str, variant_name: Str, fi: Int) -> Str ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let enum_td = find_type_def_node(enum_name)
    let enum_tparams = if enum_td != -1 { node_type_params(enum_td) } else { -1 }
    let mut variant_flds = -1
    if enum_td != -1 {
        let variants_sl = node_fields(enum_td)
        if variants_sl != -1 {
            let mut vj = 0
            while vj < sublist_length(variants_sl) {
                let vnode = sublist_get(variants_sl, vj)
                if node_name(vnode) == variant_name {
                    variant_flds = node_fields(vnode)
                    break
                }
                vj = vj + 1
            }
        }
    }
    let vf_node = if variant_flds != -1 && fi < sublist_length(variant_flds) { sublist_get(variant_flds, fi) } else { -1 }
    let vf_ann = if vf_node != -1 { descend_field_ann(node_value(vf_node), enum_tparams, enum_name) } else { -1 }
    let saved_arg_ann = cg_expect_arg_ann
    let saved_let_ann = cg_let_target_ann
    let saved_fa_ctx = cg_fa_receiver_ctx
    cg_expect_arg_ann = vf_ann
    if value_ctx_ann_spellable(vf_ann) != 0 { cg_let_target_ann = vf_ann }
    cg_fa_receiver_ctx = false
    emit_expr(arg_node)
    cg_fa_receiver_ctx = saved_fa_ctx
    cg_expect_arg_ann = saved_arg_ann
    cg_let_target_ann = saved_let_ann
    expr_result_str
}

// The instance-resolved annotation for a field whose declared annotation node is
// `f_ann` — the descent half of field_ann_at_instance, factored out so the
// positional variant-ctor path (whose fields are indexed, not named) can reuse it
// with an annotation node it fetched by index.
fn descend_field_ann(f_ann: Int, td_tparams: Int, sname: Str) -> Int {
    if f_ann == -1 { return -1 }
    if td_tparams == -1 { return f_ann }
    let nparams = sublist_length(td_tparams)
    if nparams == 0 { return f_ann }
    let own_elems = node_elements(f_ann)
    if own_elems != -1 && sublist_length(own_elems) > 0 { return f_ann }
    let mut slot = -1
    let mut pi = 0
    while pi < nparams {
        if node_name(sublist_get(td_tparams, pi)) == node_name(f_ann) {
            slot = pi
            break
        }
        pi = pi + 1
    }
    if slot < 0 { return f_ann }
    let mut ann = -1
    if cg_expect_arg_ann != -1 && strip_module_qualifier(node_name(cg_expect_arg_ann)) == sname {
        ann = cg_expect_arg_ann
    } else if cg_let_target_ann != -1 && strip_module_qualifier(node_name(cg_let_target_ann)) == sname {
        ann = cg_let_target_ann
    }
    if ann == -1 { return f_ann }
    let elems = node_elements(ann)
    if elems == -1 || sublist_length(elems) != nparams { return f_ann }
    let descended = sublist_get(elems, slot)
    // The descended element is spelled in the ENCLOSING scope's type-param vocabulary, but both
    // channels are read while cg_mono_tparams_sl holds THIS struct's tparams. A binder surviving
    // in it is therefore not merely uninformative — it is resolved by NAME against the wrong list
    // and silently answers with another slot's type. See the vocabulary note on
    // value_ctx_ann_spellable.
    if value_ctx_ann_spellable(descended) == 0 { return f_ann }
    descended
}

// Whether `ann` names a concrete type end to end — every name in the tree resolves to a
// struct, an enum, a builtin, Void, or a tuple. An unknown bare identifier is a type-param
// BINDER, and a binder makes the whole annotation unspellable.
//
// This is the gate on the cg_let_target_ann half of the field-annotation retarget, and it exists
// because that channel's consumers treat a binder as NO INFORMATION and fall back to a
// hardcoded default rather than to the annotation they would otherwise have read. Two
// measured cases where writing a binder into the channel is strictly worse than leaving the
// enclosing annotation in place:
//
//   resolve_ctor_kops_elem falls through to cg_let_target_ann for a Set()/Map() ctor in a
//   struct-literal field. Under `let s: Set[Int] = (Box { value: Set() }).value` nothing
//   names Box, so field_ann_at_instance answers with the bare `T`; the channel had held
//   `Set[Int]` and answered kops_i64, and `T` drops it to kops_str — int keys hashed through
//   the STRING vtable, silent at cc time.
//
//   resolve_ptr_inner_c reads cg_let_target_ann with no name gate and no arity check. For
//   `type GW[T] { p: Ptr[T] }` the declared annotation already carries an element, so
//   field_ann_at_instance returns it undescended and the element is still `T`;
//   ptr_inner_c_type falls through to "void" and `calloc(1, sizeof(void))` allocates ONE byte
//   for an 8-byte Pollfd.
//
// So the rule is asymmetric on purpose: cg_expect_arg_ann is retargeted unconditionally,
// because every one of its consumers gates on a head name that a binder cannot match, so a
// binder there is inert. cg_let_target_ann is retargeted only when this returns nonzero.
// A stale-but-concrete annotation carries more information than a binder does.
//
// That "a binder is inert in cg_expect_arg_ann" argument holds only for a BARE binder, and it is
// why field_ann_at_instance ALSO gates its descent result on this predicate. A descended element
// can be CONCRETE-HEADED and still carry a binder as an element (`Set[K]`): the head matches a
// consumer's name gate, so the annotation is not inert at all, and the element is then resolved by
// name against cg_mono_tparams_sl — which holds the STRUCT's tparams, while `K` was spelled in the
// enclosing FN's vocabulary. Resolving it there can silently match an unrelated slot by name
// coincidence, or fail loudly with a BLINK_COMPILER_BUG_kops_unsupported sentinel when no slot
// matches — both keyed on the caller's cosmetic choice of type-param name, not on anything the
// field-annotation retarget can see. The vocabulary boundary is what the descent crosses, and the
// mono-context globals do not cross with it.
//
// CT_VOID is not sufficient as the unspellable test on its own: type_from_name maps "" and
// every unknown name onto it as well, so genuine Void has to be admitted by name — the same
// distinction c_field_type_str keeps for exactly the same reason.
fn value_ctx_ann_spellable(ann: Int) -> Int {
    if ann == -1 { return 0 }
    let name = strip_module_qualifier(node_name(ann))
    if name == "" { return 0 }
    if name != "Void" && name != "Tuple" && is_struct_or_enum_type(name) == 0 && type_from_name(name) == CT_VOID {
        return 0
    }
    let elems = node_elements(ann)
    if elems == -1 { return 1 }
    let n = sublist_length(elems)
    let mut i = 0
    while i < n {
        if value_ctx_ann_spellable(sublist_get(elems, i)) == 0 { return 0 }
        i = i + 1
    }
    1
}

// When cg_expect_arg_ann is `Option[Prim]` with a primitive (non-struct,
// non-enum, non-compound) inner, returns that inner's C-type kind. Returns
// CT_VOID otherwise — including when the inner is a struct/enum (handled by
// expect_arg_option_inner_struct) or when there is no annotation. Lets a bare
// `None` adopt e.g. `Option[Str]`'s carrier instead of defaulting to int.
fn expect_arg_option_inner_ct() -> Int {
    if cg_expect_arg_ann == -1 { return CT_VOID }
    if node_name(cg_expect_arg_ann) != "Option" { return CT_VOID }
    let elems = node_elements(cg_expect_arg_ann)
    if elems == -1 || sublist_length(elems) < 1 { return CT_VOID }
    let inner_ann = sublist_get(elems, 0)
    let inner = node_name(inner_ann)
    if is_struct_or_enum_type(inner) != 0 { return CT_VOID }
    let inner_ct = type_from_name(inner)
    if is_compound_ct(inner_ct) != 0 { return CT_VOID }
    inner_ct
}

// Returns the closure-signature string for the i-th formal when it has a
// `fn(...)` type, otherwise "". Used by the Call-arg loops to hint the
// Ident arm that a bare-fn reference should be shimmed.
pub fn arg_fn_value_hint(params_sl: Int, i: Int) -> Str {
    if params_sl == -1 {
        return ""
    }
    if i < 0 || i >= sublist_length(params_sl) {
        return ""
    }
    let p = sublist_get(params_sl, i)
    if node_type_name(p) != "Fn" {
        return ""
    }
    let ta = node_type_ann(p)
    if ta == -1 {
        return ""
    }
    build_closure_sig_from_type_ann(ta)
}

// Returns the i-th callee parameter's type-annotation node, or -1.
pub fn arg_type_ann_at(params_sl: Int, i: Int) -> Int {
    if params_sl == -1 { return -1 }
    if i < 0 || i >= sublist_length(params_sl) { return -1 }
    node_type_ann(sublist_get(params_sl, i))
}

// Returns the element type-annotation of the enclosing `let`-target when it is
// `List[Elem]`. Used by emit_list_lit to thread the declared element
// carrier into cg_expect_arg_ann so a bare `None`/`Ok`/`Err` literal element
// adopts it. Returns -1 when there is no List-typed let target.
fn list_lit_elem_ann() -> Int {
    if cg_let_target_ann == -1 { return -1 }
    if node_name(cg_let_target_ann) != "List" { return -1 }
    let elems = node_elements(cg_let_target_ann)
    if elems == -1 || sublist_length(elems) < 1 { return -1 }
    sublist_get(elems, 0)
}

// When cg_expect_arg_ann is `Result[Ok, Err]`, returns the element annotation at
// `slot` (0 = Ok, 1 = Err), else -1. Lets Ok/Err constructors at a call site
// adopt the parameter's expected Result inner types.
fn expect_arg_result_elem(slot: Int) -> Int {
    let ann = if cg_expect_arg_ann != -1 { cg_expect_arg_ann } else { cg_let_target_ann }
    if ann == -1 { return -1 }
    if node_name(ann) != "Result" { return -1 }
    let elems = node_elements(ann)
    if elems == -1 || sublist_length(elems) < 2 { return -1 }
    sublist_get(elems, slot)
}

// Bind a generic fn's struct/tuple return into a temp so the caller's
// `let x = call()` sees a concrete struct type, and write the expr_result
// globals. Shared by the tuple-return and plain struct/enum-return paths.
fn emit_generic_struct_ret_temp(mangled: Str, struct_name: Str, temp_prefix: Str, call_args: Str, node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope {
    reg_fn_struct_ret(mangled, struct_name)
    let g_tmp = fresh_temp(temp_prefix)
    emit_line("{c_type_c_name(struct_name)} {g_tmp} = {c_fn_name(mangled)}({call_args});")
    set_var(g_tmp, CT_STRUCT, 0)
    set_var_struct(g_tmp, struct_name)
    // This temp has no typecheck node of its own, so let_binding_tid never stamps
    // it — its struct/tuple name lived only on the flat sname channel. The call
    // node's mono tid is the value's type; stamp it so the tid leads, gated on the
    // reader's own round-trip (tid_struct_name == struct_name), so a tid that spells
    // a different shape — or none (a generic-enum return, the nested-generic bug) —
    // keeps the flat spelling.
    if node >= 0 {
        let g_tid = cg_expr_node_mono_tid(node)
        if tid_spells_struct(g_tid, struct_name) != 0 { set_var_ty(g_tmp, g_tid) }
    }
    expr_result_str = g_tmp
    expr_result_type = CT_STRUCT
    publish_result_tid(-1)
}

// Slot-aligned resolver for building a mono-args CSV element-by-element off a
// struct/tuple/return INSTANCE tid. `slot_tids` comes from
// mono_instance_arg_tids_from_tid, which is aligned to the ANNOTATION's arg
// positions (slot i = the type's i-th `[...]` arg) — NOT to the enclosing fn's
// tparams_sl. So index it by the element position `ai`, not by the type-param's
// position; using resolve_tparam_via_tid here would misread the tid when the
// annotation permutes the fn's type params (e.g. `fn f[A,B]() -> Pair[B,A]`).
// Byte-parity: for an encodable slot tc_seg_from_tid reproduces the CSV segment
// mangling used; an unencodable one passes the raw element name through unchanged.
fn resolve_arg_seg_via_slot_tid(ai: Int, raw_name: Str, slot_tids: List[Int]) -> Str {
    if ai < slot_tids.len() {
        let seg = tc_seg_from_tid(slot_tids.get(ai).unwrap())
        if seg.is_some() {
            return seg.unwrap()
        }
    }
    raw_name
}

// Lower an arg_tids list (aligned to a fn/type's tparams_sl) into the pre-resolved
// segment list the codegen_types trio (resolve_tuple_ann / mono_name_from_ann /
// struct_concrete_args_from_target) consumes via resolve_tparam_seg. Slot pi holds
// the concrete C-tag segment when arg_tids[pi] is encodable, else "" (the trio then
// passes that param name through unchanged). Lives here — not in codegen_types —
// because tc_seg_from_tid is a typecheck fn and codegen_types sits below typecheck
// in the import graph. Byte-parity: tc_seg_from_tid reproduces the CSV segment that
// mangling used for every encodable slot, so feeding these segments to the trio
// spells the same name the mono key does (the invariant resolve_tparam_via_tid also
// relies on).
pub fn segs_from_arg_tids(arg_tids: List[Int]) -> List[Str] {
    let mut segs: List[Str] = []
    let mut i = 0
    while i < arg_tids.len() {
        let seg = tc_seg_from_tid(arg_tids.get(i).unwrap())
        if seg.is_some() {
            segs.push(seg.unwrap())
        } else {
            segs.push("")
        }
        i = i + 1
    }
    segs
}

// Is `node` the value of the enclosing fn's tail statement? The def-side return-
// annotation tier below is gated on it, and the gate is the whole safety argument:
// a return annotation is in scope for a fn's ENTIRE body, unlike cg_expect_arg_ann /
// cg_let_target_ann which are set and restored per value context, true at the struct-field
// seam because of the field-annotation retarget. Ungated, every
// same-named literal anywhere in the body would silently adopt the return type's
// args — `fn f() -> RGT[Int] { let y = RGT { s: Set() }; ...}` would stamp `Int`
// onto `y` on no evidence at all. A wrong guess replacing a loud ICE is strictly
// worse than the ICE.
fn struct_lit_is_fn_tail_value(node: Int) -> Int {
    if cg_current_fn_node == -1 { return 0 }
    let body = node_body(cg_current_fn_node)
    if body == -1 || node_kind(body) != NodeKind.Block { return 0 }
    let stmts_sl = node_stmts(body)
    if stmts_sl == -1 || sublist_length(stmts_sl) == 0 { return 0 }
    let last = sublist_get(stmts_sl, sublist_length(stmts_sl) - 1)
    let k = node_kind(last)
    let val = if k == NodeKind.ExprStmt || k == NodeKind.Return { node_value(last) } else { last }
    if val == node { return 1 }
    0
}

// The DEF-side twin of struct_concrete_args_from_target. Both answer
// "which concrete type args does this struct literal instantiate?"; they differ only
// in which annotation is the oracle. The target version reads the enclosing VALUE
// context; this one reads the enclosing fn's RETURN annotation, resolved through the
// mono context the enclosing generic fn was instantiated with.
//
// It exists because the call-site mint solves only half of `fn mk[T]() -> RGT[T] {
// RGT { s: Set() } }`. With `let e: RGT[Int] = mk()` the call site now knows T:=Int
// and mangles blink_mk_Int correctly — but inside mk's monomorphized body the literal
// has no value context whatsoever (no let target, no call-arg annotation, and `Set()`
// has no element VALUE to infer from), so it reached the mono chokepoint with T
// unsolved. The return annotation is the only channel that carries T there, and by
// then cg_mono_tparams_sl/cg_mono_arg_tids already hold T:=Int for this instantiation.
// Precedent for reading node_type_ann(cg_current_fn_node) as a codegen tier:
// emit_tuple_lit does exactly this.
//
// Every bail is load-bearing. Bare-name and arity mismatch mean the annotation is
// about a different type. A compound arg flattens lossily through node_name — the
// same reason struct_concrete_args_from_target bails on one.
//
// ONE LENS, DELIBERATELY. It returns TIDS and the caller spells the CSV from them via
// segs_from_arg_tids, so the name it registers and the arg_tids it installs can never
// disagree. The CSV drives the mono NAME while the tids drive the field ctor's kops
// vtable — if those two ever named the type differently, a correctly-named struct could
// still hash an Int-keyed Set as a string: silent collision or data loss under plain gcc,
// or an ASAN-only stack-buffer-overflow read for keys with no zero byte, not a guaranteed
// crash.
//
// Every annotation arg must be a BINDER of the enclosing mono context. A non-binder arg
// (`fn f[T]() -> Pair[T, Int]`) is not this tier's business: an already-concrete slot
// means the return instance tid is nameable, which is the tid-native path's job, and
// answering it a second way here would be a second, disagreeing lens. An unresolvable
// binder likewise bails — a "" / "Void" / bare-binder segment is an erasure, and emitting
// one trades a loud I0001 for a miscompile.
fn struct_ret_ann_arg_tids(sname: Str, node: Int) -> List[Int] {
    let none: List[Int] = []
    // Gated on dbg_channel_on, per ast.bl's note and the kopsctor tap above: dbg_trace's
    // message argument is interpolated EAGERLY, and this function runs for every struct
    // literal in the program.
    let tracing = dbg_channel_on("retann")
    if struct_lit_is_fn_tail_value(node) == 0 {
        if tracing != 0 { dbg_trace("retann", "{sname}: not the enclosing fn's tail value") }
        return none
    }
    let td = find_type_def_node(sname)
    if td == -1 { return none }
    let td_tparams = node_type_params(td)
    if td_tparams == -1 { return none }
    let nparams = sublist_length(td_tparams)
    if nparams == 0 { return none }
    let ann = node_type_ann(cg_current_fn_node)
    if ann == -1 {
        if tracing != 0 { dbg_trace("retann", "{sname}: enclosing fn has no return annotation") }
        return none
    }
    if strip_module_qualifier(node_name(ann)) != sname {
        if tracing != 0 { dbg_trace("retann", "{sname}: return annotation names {node_name(ann)}") }
        return none
    }
    let elems = node_elements(ann)
    if elems == -1 || sublist_length(elems) != nparams {
        if tracing != 0 { dbg_trace("retann", "{sname}: return annotation has the wrong arity for {nparams} type params") }
        return none
    }
    let mut tids: List[Int] = []
    let mut ai = 0
    while ai < sublist_length(elems) {
        let elem = sublist_get(elems, ai)
        let sub = node_elements(elem)
        if sub != -1 && sublist_length(sub) > 0 {
            if tracing != 0 { dbg_trace("retann", "{sname} slot {ai}: compound annotation arg") }
            return none
        }
        let tid = tparam_tid_via_mono(node_name(elem), cg_mono_tparams_sl, cg_mono_arg_tids)
        if tid < 0 {
            if tracing != 0 { dbg_trace("retann", "{sname} slot {ai}: '{node_name(elem)}' is not a binder of the enclosing mono context") }
            return none
        }
        let seg = tc_seg_from_tid(tid)
        if seg.is_none() {
            if tracing != 0 { dbg_trace("retann", "{sname} slot {ai}: tid {tid} is unencodable") }
            return none
        }
        // "Void" is NOT declined here: a genuine Void type argument is an
        // ordinary encodable answer (decisions/under-determined-types.md:39, 6-0), and
        // declining it routed `Box[Void]` off this tier onto a producer that then erased
        // the slot. Only an EMPTY segment or a BLINK_I0001_* sentinel is an erasure.
        if seg.unwrap() == "" || diag_is_ice_seg(seg.unwrap()) {
            if tracing != 0 { dbg_trace("retann", "{sname} slot {ai}: erased segment '{seg.unwrap()}'") }
            return none
        }
        tids.push(tid)
        ai = ai + 1
    }
    if tracing != 0 { dbg_trace("retann", "{sname}: return annotation resolves to '{struct_mono_from_fn_ret_ann(tids)}'") }
    tids
}

// The CSV spelling of struct_ret_ann_arg_tids, through the SAME lens the tids carry.
fn struct_mono_from_fn_ret_ann(tids: List[Int]) -> Str {
    if tids.len() == 0 { return "" }
    let segs = segs_from_arg_tids(tids)
    let mut args = ""
    let mut i = 0
    while i < segs.len() {
        if i > 0 { args = args.concat(",") }
        args = args.concat(segs.get(i).unwrap())
        i = i + 1
    }
    args
}

// Returns 0 if type-arg inference yields None so the caller can fall through
// to non-generic handling; on success registers the monomorphization, writes
// expr_result_str / expr_result_type plus container inner-type globals, and
// returns 1.
@allow(UnrestoredMutation, IncompleteStateRestore)
pub fn emit_generic_fn_call_tail(node: Int, fn_name: Str, args_str: Str) -> Int ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let gfn_node = get_generic_fn_node(fn_name)
    let tparams_sl = node_type_params(gfn_node)
    // A callee with no type params is not a monomorphization at all — return 0 so the
    // caller falls through to non-generic handling. This replaces the old
    // `type_args.is_none()` bail: tc_mono_csv returned None here, and the string
    // fallback returned None too, so the two agreed. Now that the CSV is TOTAL the
    // condition has to be tested directly rather than inferred from a None.
    let num_tparams = if tparams_sl == -1 { 0 } else { sublist_length(tparams_sl) }
    if num_tparams == 0 {
        return 0
    }
    // The tid is the SOLE producer of the mono CSV. There is no string-based walker to
    // defer to and no parity constraint to satisfy: tc_resolve_tparam_tid handles
    // mono-calls-mono substitution, the List[Tuple[..T..]] slot arm, and
    // closure-annotation reading, none of which a string walk over node names can do.
    //
    // This runs before the CSV and the mangle. It only calls tc_mono_tids_subst and
    // listop_slot_tid, neither of which emits, so ordering it first is safe.
    let raw_tids = tc_mono_tids_subst(node, gfn_node, cg_mono_tparams_sl, cg_mono_arg_tids)
    let mut arg_tids: List[Int] = []
    let mut ti = 0
    while ti < raw_tids.len() {
        arg_tids.push(listop_slot_tid(raw_tids.get(ti).unwrap()))
        ti = ti + 1
    }
    // tc_mono_tids_core returns an EMPTY list — not a short one — for its structural
    // early-outs (no params sublist, no args sublist). `fn f[T]() -> Int` called as `f()`
    // is the reachable one, and the string used to mangle it `blink_f_Void`: a valid C
    // identifier that silently collapsed f[Int] and f[Str] onto one symbol. Padding the
    // missing slots keeps the segment count equal to the tparam count so the chokepoint
    // below sees them and raises I0001 instead. That is the outcome the chokepoint's own
    // comment asks for, not a new refusal.
    while arg_tids.len() < num_tparams {
        arg_tids.push(-1)
    }
    let ta_str = mono_csv_from_arg_tids(arg_tids)
    // I0001 chokepoint for the generic-FN path, the twin of emit_struct_lit's
    // below. Every generic-fn call's mono name funnels through here, at the point where
    // that name is finalized and before it is mangled and registered.
    //
    // Like the struct chokepoint, this does NOT abort: diag_ice_at only increments
    // diag_ice_count, so register_mono_fn/register_mono_instance below still run on the
    // rejected name. That is harmless rather than merely tolerated — "ice" severity
    // bypasses @allow and blinkc exits 101 without writing any C, so nothing downstream
    // ever observes the registration. Raising here rather than aborting keeps a single
    // run reporting every bad name instead of only the first.
    //
    // The struct half of this invariant has been loud for a while; the fn half was
    // SILENT. `fn f[T]() -> Int { 1 }` called as `f()` mangled `blink_f_Void` and exited
    // 0 with zero diagnostics, because an erased mono name is a perfectly valid C
    // identifier — so it compiled, linked, and collapsed `f[Int]` and `f[Str]` onto one
    // symbol. Silent wrong C is strictly worse than an ICE.
    //
    // Same predicate as the struct chokepoint on purpose: mono_args_has_void_seg is
    // generic over (csv, tparams_sublist), not struct-specific, and it rejects the
    // bare-binder passthrough (`blink_f_T`) as well as the literal "Void" — the spelling
    // the `_Void` grep structurally cannot see.
    //
    // Not E0301: that rule is binding-scoped (reported from nr_pop_scope via
    // tc_report_under_determined), and for the shape above `_x : Int` is fully concrete,
    // so there is no under-determined binding and no metavar to latch onto. A real
    // declaration-site diagnostic is the right long-term answer, with this demoted to a
    // backstop; until then a phantom tparam surfaces as the compiler bug it is.
    if mono_args_has_void_seg(ta_str, tparams_sl) {
        diag_ice_at("UnsolvedTypeVarAtCodegen", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "type parameter of fn '{fn_name}' reached monomorphization unsolved (mono args '{ta_str}')",
            node,
            "this is a compiler bug — the type should have been inferred, or reported as error[CannotInferType]")
    }
    let mangled = mangle_generic_name(fn_name, ta_str)
    // arg_tids and ta_str are produced TOGETHER, above — the same list, rendered. With
    // one producer, the mangled symbol and the def-side param/field types cannot
    // disagree, so there is no slot ordering to reconcile.
    register_mono_fn(fn_name, ta_str, arg_tids)
    register_mono_instance(fn_name, ta_str, arg_tids)
    let segs = segs_from_arg_tids(arg_tids)
    let ret_str = node_return_type(gfn_node)
    let resolved_ret = resolve_tparam_via_tid(ret_str, tparams_sl, arg_tids)
    // A bare-typevar return (`-> T`/`-> U`) bound to a compound resolves through
    // the string tag to a carrier name (Option_int / Result_int_str / Map_..)
    // whose type_from_name is CT_VOID — the tag has no `[` so the whole string
    // is its base (codegen_types.bl `_ => CT_VOID`). typecheck already computed
    // the correct substituted return tid and memoized it on the call node, so
    // reroute ret_type off CT_VOID onto the real carrier CT. Only fires when the
    // string path failed AND the tid is a compound — every already-working shape (the
    // annotated `-> Option[T]` path below, tuples, structs) keeps its CT.
    let ret_tid = tc_lookup_node_tid(node)
    let tid_ct = tc_tid_ct(ret_tid)
    let ret_name_ct = type_from_name(resolved_ret)
    // `rerouted` records that ret_type was recovered from the memoized tid (bare
    // typevar bound to a compound), NOT from a genuine `-> Option`/`-> Result`/
    // `-> Map` annotation. The tid-recovery else branches below gate on it: a
    // bracketless `-> Option` (resolved_ret == "Option", type_from_name already
    // CT_OPTION) must stay the old no-op, not run tid recovery against a node
    // whose tid isn't an Option — else it would register a carrier keyed on the
    // -1 sentinel where the old code registered nothing.
    // CT_STRUCT joins the reroute set, but ONLY for a BARE-TYPEVAR return `-> T`
    // bound to a struct INSTANCE (`unbox(outer)` : Box[Int]): the string tag lowers
    // it to the mono name `Box_Int` whose type_from_name is CT_VOID (no `[`), so the
    // caller would type the result `void`. typecheck substitutes T to the concrete
    // instance and memoizes it, so the tid says CT_STRUCT; reroute onto it and emit
    // a struct-typed temp below (mirrors the Option/Result/Map recovery above). The
    // `resolved_ret != ret_str` guard confines this
    // to `-> T` (the resolver substituted the whole return type): an ANNOTATED
    // struct return `-> Wrapper[T]` keeps ret_str=="Wrapper" unchanged and MUST stay
    // on the CT_VOID annotated-elements path below (which builds Wrapper_Int from the
    // annotation), not this arm (which would emit the bare base "Wrapper").
    let struct_reroute = tid_ct == CT_STRUCT && resolved_ret != ret_str
    let rerouted = ret_name_ct == CT_VOID && (tid_ct == CT_OPTION || tid_ct == CT_RESULT || tid_ct == CT_MAP || struct_reroute)
    let ret_type = if rerouted { tid_ct } else { ret_name_ct }
    let fn_eff_sl = node_effects(gfn_node)
    let fn_trusted = has_annotation(gfn_node, "trusted")
    reg_fn_with_effects(mangled, ret_type, fn_eff_sl, fn_trusted)
    let call_args = append_ev_arg(mangled, args_str)
    let mut map_ret_val_struct = ""
    let mut map_ret_key_struct = ""
    if ret_type == CT_OPTION {
        let ret_ann = node_type_ann(gfn_node)
        let ann_elems = if ret_ann != -1 { node_elements(ret_ann) } else { -1 }
        if ann_elems != -1 && sublist_length(ann_elems) >= 1 {
            let inner_ann = sublist_get(ann_elems, 0)
            let inner_name_raw = node_name(inner_ann)
            let inner_name = resolve_tparam_via_tid(inner_name_raw, tparams_sl, arg_tids)
            let inner_ct = type_from_name(inner_name)
            expr_option_inner = inner_ct
            ensure_option_type(inner_ct)
            let opt_carrier_tid = if tc_tid_ct(ret_tid) == CT_OPTION { ret_tid } else { -1 }
            reg_fn_ret_type_tp(mangled, CT_OPTION, inner_ct, -1, sv_tp(CT_OPTION, inner_ct, -1, ""), opt_carrier_tid)
            // A bare-typevar Option inner (`-> Option[T]`, T→LocBox[Int]) resolves
            // through the string tag to the mono-instance name `LocBox_Int`, which
            // is NOT is_struct_or_enum_type (only the bare `LocBox` is registered as
            // a struct) — so also admit a registered mono struct instance, else the
            // Option inner erases and the caller types the result Option_void.
            // is_mono_struct_instance recovers the registered instance.
            if inner_ct == CT_VOID && (is_struct_or_enum_type(inner_name) != 0 || is_mono_struct_instance(inner_name) != 0) {
                ensure_struct_option_type(inner_name)
                expr_option_inner_struct = inner_name
            } else {
                // A non-struct inner must CLEAR the struct channel, exactly as the
                // CT_RESULT sibling below does in its own else. expr_option_inner_struct is a
                // transient global: leaving it alone here does not mean "no answer", it means
                // the LAST compound-Option producer's answer survives, and a later call can
                // borrow an unrelated carrier temp from an earlier one.
                expr_option_inner_struct = ""
            }
        } else if rerouted {
            // Bare-typevar return `-> T` bound to Option[..]: no compound child
            // in the annotation, so recover the inner from the memoized tid,
            // mirroring the annotation path above. A struct/enum
            // inner MUST be normalized to CT_VOID + a non-empty struct name, EXACTLY
            // as the annotation path does (type_from_name(struct)==CT_VOID there):
            // tc_tid_option_inner_ct returns CT_STRUCT for a struct, which would
            // put a different inner CT into expr_option_inner / the fn-ret ledger
            // than the annotated path for the same shape.
            let raw_inner_ct = tc_tid_option_inner_ct(ret_tid)
            let inner_struct = tc_tid_option_inner_struct(ret_tid)
            let inner_ct = if inner_struct != "" { CT_VOID } else { raw_inner_ct }
            expr_option_inner = inner_ct
            ensure_option_type(inner_ct)
            reg_fn_ret_type_tp(mangled, CT_OPTION, inner_ct, -1, sv_tp(CT_OPTION, inner_ct, -1, ""), ret_tid)
            if inner_struct != "" {
                ensure_struct_option_type(inner_struct)
                expr_option_inner_struct = inner_struct
            }
        }
    } else if ret_type == CT_RESULT {
        let ret_ann = node_type_ann(gfn_node)
        let ann_elems = if ret_ann != -1 { node_elements(ret_ann) } else { -1 }
        if ann_elems != -1 && sublist_length(ann_elems) >= 2 {
            let ok_ann = sublist_get(ann_elems, 0)
            let err_ann = sublist_get(ann_elems, 1)
            let ok_name = resolve_tparam_via_tid(node_name(ok_ann), tparams_sl, arg_tids)
            let err_name = resolve_tparam_via_tid(node_name(err_ann), tparams_sl, arg_tids)
            let ok_ct = type_from_name(ok_name)
            let err_ct = type_from_name(err_name)
            expr_result_ok_type = ok_ct
            expr_result_err_type = err_ct
            // Admit a registered mono struct instance (LocBox_Int) as a struct-typed
            // ok/err, symmetric to the Option branch: a bare-typevar Result inner
            // bound to a struct instance resolves to the mono-instance name, which
            // is not is_struct_or_enum_type (only the bare head is registered).
            let ok_is_type = is_struct_or_enum_type(ok_name) != 0 || is_mono_struct_instance(ok_name) != 0
            let err_is_type = is_struct_or_enum_type(err_name) != 0 || is_mono_struct_instance(err_name) != 0
            if ok_is_type || err_is_type {
                let ok_s = if ok_is_type { ok_name } else { "" }
                let err_s = if err_is_type { err_name } else { "" }
                reg_fn_ret_struct_inner(mangled, ok_s, err_s)
                ensure_mixed_result_type(ok_ct, err_ct, ok_s, err_s)
                expr_result_ok_struct = ok_s
                expr_result_err_struct = err_s
            } else {
                ensure_result_type(ok_ct, err_ct)
                expr_result_ok_struct = ""
                expr_result_err_struct = ""
            }
            let res_carrier_tid = if tc_tid_ct(ret_tid) == CT_RESULT { ret_tid } else { -1 }
            reg_fn_ret_type_tp(mangled, CT_RESULT, ok_ct, err_ct, sv_tp(CT_RESULT, ok_ct, err_ct, ""), res_carrier_tid)
        } else if rerouted {
            // Bare-typevar return `-> T` bound to Result[..]: recover ok/err
            // from the memoized tid, mirroring the annotation path above. As in
            // the Option else, a struct/enum ok/err inner is normalized to CT_VOID
            // + a non-empty struct name so the ledger + expr_* globals match the
            // annotation path (which computes type_from_name(struct)==CT_VOID).
            let ok_s = tc_tid_result_ok_struct(ret_tid)
            let err_s = tc_tid_result_err_struct(ret_tid)
            let ok_ct = if ok_s != "" { CT_VOID } else { tc_tid_result_ok_ct(ret_tid) }
            let err_ct = if err_s != "" { CT_VOID } else { tc_tid_result_err_ct(ret_tid) }
            expr_result_ok_type = ok_ct
            expr_result_err_type = err_ct
            if ok_s != "" || err_s != "" {
                reg_fn_ret_struct_inner(mangled, ok_s, err_s)
                ensure_mixed_result_type(ok_ct, err_ct, ok_s, err_s)
                expr_result_ok_struct = ok_s
                expr_result_err_struct = err_s
            } else {
                ensure_result_type(ok_ct, err_ct)
                expr_result_ok_struct = ""
                expr_result_err_struct = ""
            }
            reg_fn_ret_type_tp(mangled, CT_RESULT, ok_ct, err_ct, sv_tp(CT_RESULT, ok_ct, err_ct, ""), ret_tid)
        }
    } else if ret_type == CT_LIST {
        let ret_ann = node_type_ann(gfn_node)
        if ret_ann != -1 {
            let elems_sl = node_elements(ret_ann)
            if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
                let inner_ann = sublist_get(elems_sl, 0)
                let inner_name_raw = node_name(inner_ann)
                let inner_name = resolve_tparam_via_tid(inner_name_raw, tparams_sl, arg_tids)
                expr_list_elem_type = type_from_name(inner_name)
            }
        }
    } else if ret_type == CT_MAP {
        let ret_ann = node_type_ann(gfn_node)
        let ann_elems = if ret_ann != -1 { node_elements(ret_ann) } else { -1 }
        if ann_elems != -1 && sublist_length(ann_elems) >= 2 {
            let k_ann = sublist_get(ann_elems, 0)
            let v_ann = sublist_get(ann_elems, 1)
            let k_name = resolve_tparam_via_tid(node_name(k_ann), tparams_sl, arg_tids)
            let v_name = resolve_tparam_via_tid(node_name(v_ann), tparams_sl, arg_tids)
            expr_map_key_type = type_from_name(k_name)
            expr_map_val_type = type_from_name(v_name)
            // An annotated generic Map return whose value is a struct INSTANCE
            // (`-> Map[Str, Box[T]]`) erases the value to bare "Box" otherwise, so
            // name.get(k) reads the pointer payload as a by-value struct.
            // Recover the recursive value/key stems from the annotation's mono, in
            // the fn's mono context (tparams_sl/ta_str resolves the T binding).
            // is_struct_type/is_enum_type are string checks on v_name, which the tid
            // resolves to the mono instance name (`Box_Int`) — a name no base-type
            // registry holds, so the gate fails closed for a struct-INSTANCE value and
            // a DIRECT call site (no intervening let to re-register) loses the value
            // struct. The tid is authoritative: admit the value when its slot names a
            // struct instance, using the same key the selector's own walk reads.
            let val_slot_tid = tc_tid_map_val_tid(ret_tid)
            if is_struct_type(v_name) != 0 || is_enum_type(v_name) != 0 || tc_tid_struct(val_slot_tid) != "" {
                // Tid-first selector: the tid tier's dry-walk wins when it can spell
                // the slot (a nested instance like Box[Box[T]]), falling back to
                // mono_name_from_ann's annotation walk + register_map_elem_struct_mono's
                // registration only when the tid tier declines. The selector always
                // registers, so either tier's typedef is guaranteed to exist.
                map_ret_val_struct = map_elem_mono_selector(val_slot_tid, strip_module_qualifier(v_name), v_ann, tparams_sl, arg_tids, segs)
            }
            let key_slot_tid = tc_tid_map_key_tid(ret_tid)
            if is_struct_type(k_name) != 0 || is_enum_type(k_name) != 0 || tc_tid_struct(key_slot_tid) != "" {
                map_ret_key_struct = map_elem_mono_selector(key_slot_tid, strip_module_qualifier(k_name), k_ann, tparams_sl, arg_tids, segs)
            }
        } else if tid_ct == CT_MAP {
            // Bare-typevar return `-> T` bound to Map[K,V]: recover key/value
            // CTs from the memoized tid. Unlike Option/Result, a bare
            // typevar bound to Map does NOT reroute — Map's top-level carrier tag
            // erases to bare "Map", so type_from_name already yields CT_MAP and
            // `rerouted` is false. The distinguisher from a genuine unparameterized
            // `-> Map` is the tid: gate on tid_ct == CT_MAP (a real Map tid).
            // A blink_map* is element-agnostic at the C level, but expr_map_*_type
            // drives downstream method key boxing, so thread the real CTs through.
            // tc_tid_map_key_ct returns -1 for an unmappable key, matching the
            // "unset" default the downstream >= 0 gates already expect.
            expr_map_key_type = tc_tid_map_key_ct(ret_tid)
            expr_map_val_type = tc_tid_map_val_ct(ret_tid)
            // A generic-struct-INSTANCE Map value (Map[Str, Box[Int]] through a
            // bare-typevar return) loses its value struct otherwise, so `m2.get(k)`
            // returns Option_int and reads the pointer payload as a by-value struct.
            // Register the recovered val/key structs on the map result string; the
            // let-binding's copy_map_value_meta carries them onto the var.
            // Tid-first selector: tc_tid_map_val_struct/tc_tid_map_key_struct can
            // answer a plausible bare-head name without an instance ever being
            // registered for it, so the published name and the registered instance
            // could disagree. The selector's own tier-1 walk is the registrar,
            // so they can't.
            map_ret_val_struct = map_elem_mono_selector(tc_tid_map_val_tid(ret_tid), "", -1, tparams_sl, arg_tids, segs)
            map_ret_key_struct = map_elem_mono_selector(tc_tid_map_key_tid(ret_tid), "", -1, tparams_sl, arg_tids, segs)
        }
    } else if ret_type == CT_SET {
        // A generic fn returning `-> Set[T]` needs its element recovered explicitly:
        // unlike Option/Result/List/Map/struct/tuple, a Set carries no CT-level slot
        // to read the element from, so a caller's `for x in first_set(d)` would
        // otherwise reach codegen with nothing recorded.
        //
        // The element comes from the call node's memoized tid, not from the return annotation
        // the way the CT_LIST/CT_MAP arms above read theirs: the annotation names the type
        // PARAM (`Set[T]`), while typecheck has already substituted T on the call node. Keyed
        // on the call string because that is what expr_result_str becomes below, and what the
        // for-in lowering looks the element up by. recover_set_elem_from_tid declines whole on
        // a tid that cannot name the element, so this only ever ADDS an answer, and it uses
        // the _resolved accessors — an unannotated `Set()` inside the callee has a metavar
        // element bound in place by a later `.insert`.
        recover_set_elem_from_tid(node, "{c_fn_name(mangled)}({call_args})")
    } else if ret_type == CT_STRUCT && rerouted {
        // Bare-typevar return `-> T` bound to a struct INSTANCE (unbox(outer) :
        // Box[Int]): the string mono path already resolved the return spelling to
        // the concrete mono name (`resolved_ret` == "Box_Int", the same symbol the
        // fn was mangled under). Emit a struct-typed temp so the caller's
        // `let got = call()` sees CT_STRUCT + the mono struct name, exactly like the
        // non-generic struct-value reference path — instead of falling through to a
        // `void` binding. Mirrors emit_generic_struct_ret_temp's use at
        // the annotated-tuple/plain-T sites below.
        emit_generic_struct_ret_temp(mangled, resolved_ret, "_gsr", call_args, node)
        return 1
    } else if ret_type == CT_VOID && resolved_ret != "Void" && resolved_ret != "" {
        let ret_ann = node_type_ann(gfn_node)
        // Generic fn returning a tuple: route through resolve_tuple_ann so the
        // caller binds the canonical tuple name (with Option[T] preserved)
        // instead of treating it as a generic struct and dropping the type arg.
        if resolved_ret == "Tuple" && ret_ann != -1 {
            let tup_opt = resolve_tuple_ann(ret_ann, tparams_sl, segs)
            if tup_opt.is_some() {
                emit_generic_struct_ret_temp(mangled, tup_opt.unwrap(), "_gtr", call_args, node)
                return 1
            }
        }
        let mut ret_struct_name = ""
        if ret_ann != -1 {
            let ret_elems = node_elements(ret_ann)
            if ret_elems != -1 && sublist_length(ret_elems) > 0 {
                let ret_arg_tids = mono_instance_arg_tids_from_tid(ret_tid, resolved_ret, sublist_length(ret_elems))
                let mut mono_args = ""
                let mut binder_seg = 0
                let mut ai = 0
                while ai < sublist_length(ret_elems) {
                    let elem = sublist_get(ret_elems, ai)
                    let raw_name = node_name(elem)
                    let mut resolved_arg = resolve_arg_seg_via_slot_tid(ai, raw_name, ret_arg_tids)
                    // The return tid can come back unresolved, leaving the element
                    // spelled as the bare binder. `segs` holds THIS call's own
                    // concrete args, aligned to the callee's tparams, so a binder
                    // still resolves there as a fallback.
                    if resolved_arg == raw_name {
                        resolved_arg = resolve_tparam_seg(raw_name, tparams_sl, segs)
                    }
                    if tparams_sl_contains(tparams_sl, resolved_arg) != 0 {
                        binder_seg = 1
                    }
                    if ai > 0 {
                        mono_args = mono_args.concat(",")
                    }
                    mono_args = mono_args.concat(resolved_arg)
                    ai = ai + 1
                }
                // Still a declared type-param after both resolvers means the caller is
                // itself generic with no concrete binding here; registering would mint a
                // typevar-named instance (`blink_Box_T` with a `void` field). Defer to the
                // bare path below, matching register_map_elem_struct_mono's guard.
                if binder_seg == 0 {
                    ret_struct_name = register_mono_instance(resolved_ret, mono_args, ret_arg_tids)
                    let call_key = "{c_fn_name(mangled)}({call_args})"
                    set_var_struct(call_key, ret_struct_name)
                    // Carry the call node's tid so sv_struct_tid_first recovers the
                    // returned generic instance from the tid, not the flat sname. Gate
                    // on the reader's exact mono-name round-trip, so a tid that names a
                    // different instance keeps the flat spelling.
                    let call_tid = cg_expr_node_mono_tid(node)
                    if call_tid >= 0 && tc_tid_struct_mono_name(cg_bind_mono_tid(call_tid)) == ret_struct_name {
                        set_var_ty(call_key, call_tid)
                    }
                }
            }
        }
        // Plain T → user struct/enum: emit a temp + struct binding so the
        // caller's `let x = call()` sees a concrete struct type.
        if ret_struct_name == "" && is_struct_or_enum_type(resolved_ret) != 0 {
            emit_generic_struct_ret_temp(mangled, resolved_ret, "_gsr", call_args, node)
            return 1
        }
    }
    expr_result_str = "{c_fn_name(mangled)}({call_args})"
    expr_result_type = ret_type
    publish_result_tid(node)
    // Always publish the map value/key struct globals (empty for a non-map or a
    // scalar-valued map) so a struct-valued map call never leaks its stem into the
    // NEXT map binding — mirrors the plain-fn path's unconditional struct resets
    // (expr_result_ok_struct/expr_option_inner_struct) at emit_call.
    expr_map_val_struct = map_ret_val_struct
    expr_map_key_struct = map_ret_key_struct
    1
}

// Emit `int <eq_var> = 1;` followed by per-field comparisons for a struct payload
// reached via the C accessor prefix `lhs`/`rhs` (e.g. "_left.ok" / "_left.value").
// `accessor_op` is "." for inline struct values (Result arms) or "->" for pointer
// payloads (struct Option). Comparator per field:
//   - CT_STRING        → blink_str_eq (content, not the char* pointer)
//   - nested aggregate → per-field memcmp (sf.stype != "": the field is an inline
//                        struct/data-enum value; C `!=` is illegal on aggregates,
//                        so shallow-compare its bytes — matches the old behavior)
//   - scalar/ptr       → `!=`
fn emit_struct_field_eq(eq_var: Str, struct_name: Str, lhs: Str, rhs: Str, accessor_op: Str) ! Codegen.Emit {
    emit_line("int {eq_var} = 1;")
    let mut si = 0
    while si < sf_entries.len() {
        let sf = sf_entries.get(si).unwrap()
        if sf.struct_name == struct_name {
            let lf = "{lhs}{accessor_op}{sf.field_name}"
            let rf = "{rhs}{accessor_op}{sf.field_name}"
            if sf.field_type == CT_STRING {
                emit_line("if (!blink_str_eq({lf}, {rf})) {eq_var} = 0;")
            } else if sf.stype != "" {
                emit_line("if (memcmp(&{lf}, &{rf}, sizeof({lf})) != 0) {eq_var} = 0;")
            } else {
                emit_line("if ({lf} != {rf}) {eq_var} = 0;")
            }
        }
        si = si + 1
    }
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_call(node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let func_node = node_left(node)
    let func_kind = node_kind(func_node)
    // A live push tid (List[Result[..]].push) is consumed only by the Ok/Err
    // branches below. Capture it and clear the global so it cannot leak through
    // any arg loop in this function into a nested call's own Ok/Err arguments.
    let entry_expect_tid = cg_expect_arg_tid
    cg_expect_arg_tid = -1
    if func_kind == NodeKind.Ident {
        let fn_name = resolve_import_alias(node_name(func_node))
        let call_line = node_line(func_node)

        if fn_name == "Raw" {
            let args_sl = node_args(node)
            if args_sl != -1 && sublist_length(args_sl) > 0 {
                emit_expr(sublist_get(args_sl, 0))
            }
            return
        }

        if fn_name == "skip" {
            emit_skip_intrinsic(sublist_get(node_args(node), 0))
            return
        }

        if fn_name == "assert" {
            let args_sl = node_args(node)
            if args_sl != -1 && sublist_length(args_sl) > 0 {
                let cond_node = sublist_get(args_sl, 0)
                let cond_kind = node_kind(cond_node)
                let cond_op = if cond_kind == NodeKind.BinOp { node_op(cond_node) } else { "" }
                let decompose = if cond_kind == NodeKind.BinOp { pa_op_renderable(cond_op) } else { 0 }

                let assert_src = "assert({format_expr(cond_node)})"
                let assert_src_lit = escape_c_string(assert_src)
                let file_lit = panic_file_for(func_node)
                let call_col = node_col(func_node)

                emit_line("\{")
                cg_indent = cg_indent + 1

                let mut intro_fmt = ""
                let mut intro_arg_list = ""
                let mut cond_c_expr = ""

                if decompose != 0 {
                    let lhs = node_left(cond_node)
                    let rhs = node_right(cond_node)
                    let lhs_src = format_expr(lhs)
                    let rhs_src = format_expr(rhs)

                    // Emit operands speculatively to learn their CTs.
                    let pre_len = cg_lines.len()
                    emit_expr(lhs)
                    let lhs_c = expr_result_str
                    let lhs_ct = expr_result_type
                    let lhs_tid = expr_result_tid
                    emit_expr(rhs)
                    let rhs_c = expr_result_str
                    let rhs_ct = expr_result_type
                    let rhs_tid = expr_result_tid

                    // Only decompose a relational/equality comparison when both
                    // operands are scalar/Str-renderable. Aggregate operands
                    // (struct, enum, Option, Bytes, Instant/Duration) have no
                    // raw-C compare and no %-format, so the whole (already
                    // Eq/Ord-desugared) condition must be emitted instead — &&/||
                    // always decompose.
                    let renderable = pa_ct_renderable(lhs_ct) != 0 && pa_ct_renderable(rhs_ct) != 0
                    let logical = cond_op == "&&" || cond_op == "||"
                    if renderable != 0 || logical != 0 {
                        let lhs_tmp = fresh_temp("_pa_l")
                        let rhs_tmp = fresh_temp("_pa_r")
                        // The assert-operand decomposition stores the ALREADY-elaborated
                        // value (e.g. `_ounw_N.value`, an unwrapped Option inner). Its temp
                        // type comes from the PHYSICAL result tid published by emit_expr, not
                        // the operand NODE's tid — the node tid describes the pre-elaboration
                        // expression (Option-outer / logical) and mis-spells an erased scalar
                        // slot. Every operand that reaches this branch is scalar (pa_ct_renderable
                        // or a &&/|| bool), so the tid is the canonical scalar singleton and
                        // c_type_from_tid agrees with the physical value.
                        emit_line("{c_type_from_tid(lhs_tid)} {lhs_tmp} = ({lhs_c});")
                        emit_line("{c_type_from_tid(rhs_tid)} {rhs_tmp} = ({rhs_c});")

                        if lhs_ct == CT_STRING && rhs_ct == CT_STRING && (cond_op == "==" || cond_op == "!=") {
                            let neg = if cond_op == "!=" { "!" } else { "" }
                            cond_c_expr = "{neg}blink_str_eq({lhs_tmp}, {rhs_tmp})"
                        } else if lhs_ct == CT_STRING && rhs_ct == CT_STRING && (cond_op == "<" || cond_op == "<=" || cond_op == ">" || cond_op == ">=") {
                            cond_c_expr = "(blink_str_cmp({lhs_tmp}, {rhs_tmp}) {cond_op} 0)"
                        } else {
                            cond_c_expr = "({lhs_tmp}) {cond_op} ({rhs_tmp})"
                        }

                        intro_fmt = "{pa_intro_line(lhs_src, lhs_ct)}\\n{pa_intro_line(rhs_src, rhs_ct)}"
                        intro_arg_list = ", {pa_fmt_for_ct(lhs_tmp, lhs_ct)}, {pa_fmt_for_ct(rhs_tmp, rhs_ct)}"
                    } else {
                        // Discard the speculative operand emission and emit the
                        // full condition through emit_binop (Eq/Ord desugaring).
                        let mut di = cg_lines.len() - 1
                        while di >= pre_len {
                            cg_lines.pop()
                            di = di - 1
                        }
                        emit_expr(cond_node)
                        cond_c_expr = expr_result_str
                    }
                } else {
                    emit_expr(cond_node)
                    cond_c_expr = expr_result_str
                }

                emit_line("int64_t _val = (int64_t)({cond_c_expr});")
                emit_line("if (!_val) \{")
                cg_indent = cg_indent + 1

                let mut user_msg_c = "\"\""
                if sublist_length(args_sl) >= 2 {
                    emit_expr(sublist_get(args_sl, 1))
                    user_msg_c = expr_result_str
                }

                if intro_fmt != "" {
                    let intro_tmp = fresh_temp("_pa_intro")
                    emit_line("char {intro_tmp}[BLINK_PA_INTRO_BUF_SIZE];")
                    emit_line("snprintf({intro_tmp}, BLINK_PA_INTRO_BUF_SIZE, \"{intro_fmt}\"{intro_arg_list});")
                    emit_line("__blink_assert_fail_intro(\"{assert_src_lit}\", {intro_tmp}, \"{file_lit}\", {call_line}, {call_col}, {user_msg_c});")
                } else {
                    emit_line("__blink_assert_fail_intro(\"{assert_src_lit}\", \"\", \"{file_lit}\", {call_line}, {call_col}, {user_msg_c});")
                }
                cg_indent = cg_indent - 1
                emit_line("}")
                cg_indent = cg_indent - 1
                emit_line("}")
            }
            expr_result_str = ""
            expr_result_type = CT_VOID
            publish_result_tid(node)
            return
        }

        if fn_name == "debug_assert" {
            let args_sl = node_args(node)
            if cg_debug_mode == 0 {
                expr_result_str = ""
                expr_result_type = CT_VOID
                publish_result_tid(node)
                return
            }
            if args_sl != -1 && sublist_length(args_sl) > 0 {
                emit_expr(sublist_get(args_sl, 0))
                let cond_str = expr_result_str
                emit_line("\{")
                cg_indent = cg_indent + 1
                emit_line("int64_t _dbg_val = (int64_t)({cond_str});")
                emit_line("if (!_dbg_val) \{")
                cg_indent = cg_indent + 1
                let mut msg_str = "\"debug assertion failed\""
                if sublist_length(args_sl) >= 2 {
                    emit_expr(sublist_get(args_sl, 1))
                    msg_str = expr_result_str
                }
                let dbg_file = panic_file_for(func_node)
                emit_line("__blink_debug_assert_fail(\"{dbg_file}\", {call_line}, \"{cg_current_fn_name}\", \"{cond_str}\", {msg_str});")
                cg_indent = cg_indent - 1
                emit_line("}")
                cg_indent = cg_indent - 1
                emit_line("}")
            }
            expr_result_str = ""
            expr_result_type = CT_VOID
            publish_result_tid(node)
            return
        }

        if fn_name == "assert_eq" {
            let args_sl = node_args(node)
            if args_sl != -1 && sublist_length(args_sl) >= 2 {
                emit_expr(sublist_get(args_sl, 0))
                let left_str = expr_result_str
                let left_type = expr_result_type
                let left_ok = expr_result_ok_type
                let left_err = expr_result_err_type
                let left_ok_s = expr_result_ok_struct
                let left_err_s = expr_result_err_struct
                let left_opt_inner = expr_option_inner
                let left_opt_inner_s = expr_option_inner_struct
                let left_struct = get_var_struct(left_str)
                emit_expr(sublist_get(args_sl, 1))
                let right_str = expr_result_str
                emit_line("\{")
                cg_indent = cg_indent + 1
                if left_type == CT_STRING {
                    emit_line("const char* _left = {left_str};")
                    emit_line("const char* _right = {right_str};")
                    emit_line("if (!blink_str_eq(_left, _right)) \{")
                    cg_indent = cg_indent + 1
                    let msg_tmp1 = fresh_temp("_msg")
                    let exp_tmp1 = fresh_temp("_exp")
                    let act_tmp1 = fresh_temp("_act")
                    emit_line("char {msg_tmp1}[512];")
                    emit_line("snprintf({msg_tmp1}, 512, \"ASSERT_EQ FAILED: \\\"%%s\\\" != \\\"%%s\\\"\", _left, _right);")
                    emit_line("char {exp_tmp1}[256]; char {act_tmp1}[256];")
                    emit_line("snprintf({exp_tmp1}, 256, \"%%s\", _right);")
                    emit_line("snprintf({act_tmp1}, 256, \"%%s\", _left);")
                    emit_line("__blink_assert_fail_eq({msg_tmp1}, {exp_tmp1}, {act_tmp1}, {call_line});")
                    cg_indent = cg_indent - 1
                    emit_line("}")
                } else if left_type == CT_FLOAT {
                    emit_line("double _left = (double)({left_str});")
                    emit_line("double _right = (double)({right_str});")
                    emit_line("if (_left != _right) \{")
                    cg_indent = cg_indent + 1
                    let msg_tmp3 = fresh_temp("_msg")
                    let exp_tmp3 = fresh_temp("_exp")
                    let act_tmp3 = fresh_temp("_act")
                    emit_line("char {msg_tmp3}[256];")
                    emit_line("snprintf({msg_tmp3}, 256, \"ASSERT_EQ FAILED: %%f != %%f\", _left, _right);")
                    emit_line("char {exp_tmp3}[256]; char {act_tmp3}[256];")
                    emit_line("snprintf({exp_tmp3}, 256, \"%%f\", _right);")
                    emit_line("snprintf({act_tmp3}, 256, \"%%f\", _left);")
                    emit_line("__blink_assert_fail_eq({msg_tmp3}, {exp_tmp3}, {act_tmp3}, {call_line});")
                    cg_indent = cg_indent - 1
                    emit_line("}")
                } else if left_type == CT_RESULT {
                    let res_c = if left_ok_s != "" || left_err_s != "" {
                        result_c_type_mixed(left_ok, left_err, left_ok_s, left_err_s)
                    } else {
                        result_c_type(left_ok, left_err)
                    }
                    emit_line("{res_c} _left = {left_str};")
                    emit_line("{res_c} _right = {right_str};")
                    // Tag-first, then compare only the ACTIVE arm. A
                    // whole-struct memcmp over the union reads junk in the
                    // inactive arm and falsely reports equal values unequal. Pick
                    // the comparator per arm type: String → blink_str_eq, struct →
                    // field-wise (a whole-struct memcmp would compare Str fields'
                    // char* pointers, not their contents), other scalar/ptr/void →
                    // `!=`. (Ok = tag 0, Err = tag 1; CT_VOID arms lower to int64_t
                    // storage so the scalar `!=` form is correct for them.)
                    if left_ok_s != "" || left_err_s != "" {
                        // A struct arm needs field-wise comparison, which
                        // is statements not an expression — emit a tag-first
                        // dispatch and fold the active arm's result into _eq.
                        let eq_v = fresh_temp("_eq")
                        emit_line("int {eq_v} = 1;")
                        emit_line("if (_left.tag != _right.tag) \{ {eq_v} = 0; \}")
                        emit_line("else if (_left.tag == 0) \{")
                        cg_indent = cg_indent + 1
                        if left_ok_s != "" {
                            let eq_ok = fresh_temp("_eqok")
                            emit_struct_field_eq(eq_ok, left_ok_s, "_left.ok", "_right.ok", ".")
                            emit_line("if (!{eq_ok}) {eq_v} = 0;")
                        } else if left_ok == CT_STRING {
                            emit_line("if (!blink_str_eq(_left.ok, _right.ok)) {eq_v} = 0;")
                        } else {
                            emit_line("if (_left.ok != _right.ok) {eq_v} = 0;")
                        }
                        cg_indent = cg_indent - 1
                        emit_line("} else \{")
                        cg_indent = cg_indent + 1
                        if left_err_s != "" {
                            let eq_err = fresh_temp("_eqerr")
                            // C2: a struct-typed err arm is boxed by pointer; reach
                            // through it with `->`, mirroring the boxed-Option payload
                            // compare, instead of an inline `.` field access.
                            let err_op = if is_boxed_struct_err(left_err_s) != 0 { "->" } else { "." }
                            emit_struct_field_eq(eq_err, left_err_s, "_left.err", "_right.err", err_op)
                            emit_line("if (!{eq_err}) {eq_v} = 0;")
                        } else if left_err == CT_STRING {
                            emit_line("if (!blink_str_eq(_left.err, _right.err)) {eq_v} = 0;")
                        } else {
                            emit_line("if (_left.err != _right.err) {eq_v} = 0;")
                        }
                        cg_indent = cg_indent - 1
                        emit_line("}")
                        emit_line("if (!{eq_v}) \{")
                    } else {
                        let ok_cmp = if left_ok == CT_STRING {
                            "!blink_str_eq(_left.ok, _right.ok)"
                        } else {
                            "_left.ok != _right.ok"
                        }
                        let err_cmp = if left_err == CT_STRING {
                            "!blink_str_eq(_left.err, _right.err)"
                        } else {
                            "_left.err != _right.err"
                        }
                        emit_line("if (_left.tag != _right.tag || (_left.tag == 0 ? ({ok_cmp}) : ({err_cmp}))) \{")
                    }
                    cg_indent = cg_indent + 1
                    let msg_tmp4 = fresh_temp("_msg")
                    let exp_tmp4 = fresh_temp("_exp")
                    let act_tmp4 = fresh_temp("_act")
                    emit_line("char {msg_tmp4}[256];")
                    emit_line("snprintf({msg_tmp4}, 256, \"ASSERT_EQ FAILED: Result values differ (tag %%lld vs %%lld)\", (long long)_left.tag, (long long)_right.tag);")
                    emit_line("char {exp_tmp4}[256]; char {act_tmp4}[256];")
                    emit_line("snprintf({exp_tmp4}, 256, \"Result tag %%lld\", (long long)_right.tag);")
                    emit_line("snprintf({act_tmp4}, 256, \"Result tag %%lld\", (long long)_left.tag);")
                    emit_line("__blink_assert_fail_eq({msg_tmp4}, {exp_tmp4}, {act_tmp4}, {call_line});")
                    cg_indent = cg_indent - 1
                    emit_line("}")
                } else if left_type == CT_OPTION {
                    let opt_c = if left_opt_inner_s != "" {
                        struct_option_c_type(left_opt_inner_s)
                    } else {
                        option_c_type(left_opt_inner)
                    }
                    emit_line("{opt_c} _left = {left_str};")
                    emit_line("{opt_c} _right = {right_str};")
                    if left_opt_inner_s != "" {
                        // A struct Some payload is a pointer (inner_c* value),
                        // so deref with -> and compare field-wise — only when both
                        // are Some (tag 1), since a None has no payload to deref.
                        // memcmp here compared the char* pointers of Str fields, not
                        // their contents, falsely reporting content-equal unequal.
                        let eq_v = fresh_temp("_eq")
                        emit_line("int {eq_v} = 1;")
                        emit_line("if (_left.tag != _right.tag) \{ {eq_v} = 0; \}")
                        emit_line("else if (_left.tag == 1) \{")
                        cg_indent = cg_indent + 1
                        let eq_val = fresh_temp("_eqv")
                        emit_struct_field_eq(eq_val, left_opt_inner_s, "_left.value", "_right.value", "->")
                        emit_line("if (!{eq_val}) {eq_v} = 0;")
                        cg_indent = cg_indent - 1
                        emit_line("}")
                        emit_line("if (!{eq_v}) \{")
                    } else {
                        // Tag-first, then compare only the active (Some)
                        // arm's scalar value. A whole-struct memcmp reads junk in
                        // the `value` slot of a None (tag 0) and falsely reports
                        // two Nones unequal. Scalar branch ⇒ scalar inner, so `!=`
                        // is valid (mirrors the float != path).
                        emit_line("if (_left.tag != _right.tag || (_left.tag == 1 && _left.value != _right.value)) \{")
                    }
                    cg_indent = cg_indent + 1
                    let msg_tmp5 = fresh_temp("_msg")
                    let exp_tmp5 = fresh_temp("_exp")
                    let act_tmp5 = fresh_temp("_act")
                    emit_line("char {msg_tmp5}[256];")
                    emit_line("snprintf({msg_tmp5}, 256, \"ASSERT_EQ FAILED: Option values differ (tag %%lld vs %%lld)\", (long long)_left.tag, (long long)_right.tag);")
                    emit_line("char {exp_tmp5}[256]; char {act_tmp5}[256];")
                    emit_line("snprintf({exp_tmp5}, 256, \"Option tag %%lld\", (long long)_right.tag);")
                    emit_line("snprintf({act_tmp5}, 256, \"Option tag %%lld\", (long long)_left.tag);")
                    emit_line("__blink_assert_fail_eq({msg_tmp5}, {exp_tmp5}, {act_tmp5}, {call_line});")
                    cg_indent = cg_indent - 1
                    emit_line("}")
                } else if left_struct != "" && is_struct_type(left_struct) != 0 {
                    let struct_c = c_type_c_name(left_struct)
                    emit_line("{struct_c} _left = {left_str};")
                    emit_line("{struct_c} _right = {right_str};")
                    emit_line("int _eq = 1;")
                    let mut si = 0
                    while si < sf_entries.len() {
                        let sf = sf_entries.get(si).unwrap()
                        if sf.struct_name == left_struct {
                            if sf.field_type == CT_STRING {
                                emit_line("if (!blink_str_eq(_left.{sf.field_name}, _right.{sf.field_name})) _eq = 0;")
                            } else {
                                emit_line("if (_left.{sf.field_name} != _right.{sf.field_name}) _eq = 0;")
                            }
                        }
                        si = si + 1
                    }
                    emit_line("if (!_eq) \{")
                    cg_indent = cg_indent + 1
                    let msg_tmp6 = fresh_temp("_msg")
                    emit_line("char {msg_tmp6}[256];")
                    emit_line("snprintf({msg_tmp6}, 256, \"ASSERT_EQ FAILED: {left_struct} values differ\");")
                    // No per-field Display rendering is available at this site, so
                    // there is no distinct expected/actual to emit — identical
                    // placeholders would be noise (spec §8.10 wants discriminating
                    // values). Fall back to the plain path, which clears
                    // expected/actual so the JSON omits them.
                    emit_line("__blink_assert_fail({msg_tmp6}, {call_line});")
                    cg_indent = cg_indent - 1
                    emit_line("}")
                } else {
                    emit_line("int64_t _left = (int64_t)({left_str});")
                    emit_line("int64_t _right = (int64_t)({right_str});")
                    emit_line("if (_left != _right) \{")
                    cg_indent = cg_indent + 1
                    let msg_tmp2 = fresh_temp("_msg")
                    let exp_tmp2 = fresh_temp("_exp")
                    let act_tmp2 = fresh_temp("_act")
                    emit_line("char {msg_tmp2}[256];")
                    emit_line("snprintf({msg_tmp2}, 256, \"ASSERT_EQ FAILED: %%lld != %%lld\", (long long)_left, (long long)_right);")
                    emit_line("char {exp_tmp2}[256]; char {act_tmp2}[256];")
                    emit_line("snprintf({exp_tmp2}, 256, \"%%lld\", (long long)_right);")
                    emit_line("snprintf({act_tmp2}, 256, \"%%lld\", (long long)_left);")
                    emit_line("__blink_assert_fail_eq({msg_tmp2}, {exp_tmp2}, {act_tmp2}, {call_line});")
                    cg_indent = cg_indent - 1
                    emit_line("}")
                }
                cg_indent = cg_indent - 1
                emit_line("}")
            }
            expr_result_str = ""
            expr_result_type = CT_VOID
            publish_result_tid(node)
            return
        }

        if fn_name == "assert_ne" {
            let args_sl = node_args(node)
            if args_sl != -1 && sublist_length(args_sl) >= 2 {
                emit_expr(sublist_get(args_sl, 0))
                let left_str = expr_result_str
                let left_type = expr_result_type
                let left_ne_struct = get_var_struct(left_str)
                emit_expr(sublist_get(args_sl, 1))
                let right_str = expr_result_str
                emit_line("\{")
                cg_indent = cg_indent + 1
                if left_type == CT_STRING {
                    emit_line("const char* _left = {left_str};")
                    emit_line("const char* _right = {right_str};")
                    emit_line("if (blink_str_eq(_left, _right)) \{")
                    cg_indent = cg_indent + 1
                    let msg_tmp1 = fresh_temp("_msg")
                    emit_line("char {msg_tmp1}[512];")
                    emit_line("snprintf({msg_tmp1}, 512, \"ASSERT_NE FAILED: \\\"%%s\\\" == \\\"%%s\\\"\", _left, _right);")
                    emit_line("__blink_assert_fail({msg_tmp1}, {call_line});")
                    cg_indent = cg_indent - 1
                    emit_line("}")
                } else if left_type == CT_FLOAT {
                    emit_line("double _left = (double)({left_str});")
                    emit_line("double _right = (double)({right_str});")
                    emit_line("if (_left == _right) \{")
                    cg_indent = cg_indent + 1
                    let msg_tmp3 = fresh_temp("_msg")
                    emit_line("char {msg_tmp3}[256];")
                    emit_line("snprintf({msg_tmp3}, 256, \"ASSERT_NE FAILED: %%f == %%f\", _left, _right);")
                    emit_line("__blink_assert_fail({msg_tmp3}, {call_line});")
                    cg_indent = cg_indent - 1
                    emit_line("}")
                } else if left_ne_struct != "" && is_struct_type(left_ne_struct) != 0 {
                    let struct_c = c_type_c_name(left_ne_struct)
                    emit_line("{struct_c} _left = {left_str};")
                    emit_line("{struct_c} _right = {right_str};")
                    emit_line("int _eq = 1;")
                    let mut si = 0
                    while si < sf_entries.len() {
                        let sf = sf_entries.get(si).unwrap()
                        if sf.struct_name == left_ne_struct {
                            let ft = sf.field_type
                            if ft == CT_STRING {
                                emit_line("if (!blink_str_eq(_left.{sf.field_name}, _right.{sf.field_name})) _eq = 0;")
                            } else {
                                emit_line("if (_left.{sf.field_name} != _right.{sf.field_name}) _eq = 0;")
                            }
                        }
                        si = si + 1
                    }
                    emit_line("if (_eq) \{")
                    cg_indent = cg_indent + 1
                    let msg_tmp6 = fresh_temp("_msg")
                    emit_line("char {msg_tmp6}[256];")
                    emit_line("snprintf({msg_tmp6}, 256, \"ASSERT_NE FAILED: {left_ne_struct} values are equal\");")
                    emit_line("__blink_assert_fail({msg_tmp6}, {call_line});")
                    cg_indent = cg_indent - 1
                    emit_line("}")
                } else {
                    emit_line("int64_t _left = (int64_t)({left_str});")
                    emit_line("int64_t _right = (int64_t)({right_str});")
                    emit_line("if (_left == _right) \{")
                    cg_indent = cg_indent + 1
                    let msg_tmp2 = fresh_temp("_msg")
                    emit_line("char {msg_tmp2}[256];")
                    emit_line("snprintf({msg_tmp2}, 256, \"ASSERT_NE FAILED: %%lld == %%lld\", (long long)_left, (long long)_right);")
                    emit_line("__blink_assert_fail({msg_tmp2}, {call_line});")
                    cg_indent = cg_indent - 1
                    emit_line("}")
                }
                cg_indent = cg_indent - 1
                emit_line("}")
            }
            expr_result_str = ""
            expr_result_type = CT_VOID
            publish_result_tid(node)
            return
        }

        let variant_enum = resolve_variant(fn_name)
        if variant_enum != "" && is_transparent_newtype(variant_enum) != 0 {
            // Transparent newtype: the constructor lowers to its bare
            // scalar payload — `Errno(rc)` emits `rc` (an int64_t), not a tagged
            // struct. The carrier wrapping (`.err = <payload>`) then stores the
            // bare value into the transparent `int64_t err` member.
            let t_args = node_args(node)
            if t_args != -1 && sublist_length(t_args) > 0 {
                emit_expr(sublist_get(t_args, 0))
                expr_result_type = CT_INT
                publish_result_tid(node)
                return
            }
        }
        if variant_enum != "" && is_data_enum(variant_enum) != 0 {
            let vidx = get_variant_index(variant_enum, fn_name)
            let tag = get_variant_tag(variant_enum, fn_name)
            let fcount = get_variant_field_count(vidx)
            let args_sl = node_args(node)
            // A generic-enum instance (`Leaf(1)` → Tree[Int]) mono's to blink_Tree_Int;
            // mono_name is the STEM (Tree_Int) or "" for a non-generic enum, which keeps
            // the bare variant_enum name. Variant metadata (tag/field types) stays keyed
            // on the bare name. The node tid is bare for an annotation-only instance
            // (`let r: Box[Int] = Pair(..)`), so fall back to the let/arg annotation
            // channel — mirroring the qualified ctor and nullary FieldAccess paths.
            let node_mono = register_mono_enum_from_node(node, variant_enum)
            let mono_name = if node_mono != "" { node_mono } else { register_mono_enum_from_ann(node, variant_enum) }
            let sname = if mono_name != "" { mono_name } else { variant_enum }
            let enum_c_name = c_type_c_name(sname)
            let mut init_str = "({enum_c_name})\{.tag = {tag}"
            if fcount > 0 && args_sl != -1 {
                init_str = init_str.concat(", .data.{fn_name} = \{")
                let mut fi = 0
                while fi < sublist_length(args_sl) && fi < fcount {
                    if fi > 0 {
                        init_str = init_str.concat(", ")
                    }
                    let field_name = get_variant_field_name(vidx, fi).unwrap()
                    let field_type = get_variant_field_type_str(vidx, fi).unwrap()
                    let arg_str = emit_variant_positional_arg(sublist_get(args_sl, fi), variant_enum, fn_name, fi)
                    if strip_generic_args(field_type) == variant_enum {
                        let box_tmp = fresh_temp("_ebox")
                        emit_line("{enum_c_name}* {box_tmp} = ({enum_c_name}*)blink_alloc(sizeof({enum_c_name}));")
                        emit_line("*{box_tmp} = {arg_str};")
                        init_str = init_str.concat(".{field_name} = (int64_t)(intptr_t){box_tmp}")
                    } else if tc_variant_field_is_selfrec_tuple(variant_enum, fn_name, field_name) != 0 {
                        // Self-recursive tuple field: the union member is a boxed
                        // int64_t (see emit_mono_enum_typedef). Heap-copy the tuple
                        // value and store its pointer. __typeof__ spells the mono
                        // tuple carrier without recomputing its name here.
                        let val_tmp = fresh_temp("_tval")
                        let box_tmp = fresh_temp("_tbox")
                        emit_line("__typeof__({arg_str}) {val_tmp} = {arg_str};")
                        emit_line("__typeof__({val_tmp})* {box_tmp} = blink_alloc(sizeof({val_tmp}));")
                        emit_line("*{box_tmp} = {val_tmp};")
                        init_str = init_str.concat(".{field_name} = (int64_t)(intptr_t){box_tmp}")
                    } else {
                        init_str = init_str.concat(".{field_name} = {arg_str}")
                    }
                    fi = fi + 1
                }
                init_str = init_str.concat("}")
            }
            init_str = init_str.concat("}")
            expr_result_str = init_str
            expr_result_type = CT_STRUCT
            publish_result_tid(node)
            set_var_struct(init_str, sname)
            return
        }
        if fn_name == "Some" {
            let args_sl = node_args(node)
            if args_sl != -1 && sublist_length(args_sl) > 0 {
                // Resolve a transparent-newtype inner (e.g. Some(Errno(rc))) from
                // the arg node BEFORE emit_expr collapses its type to CT_INT. The
                // carrier stays Option_Errno with a bare int64_t value member (no
                // box), mirroring the transparent Result treatment.
                let mut transparent_enum = transparent_newtype_arg_enum(sublist_get(args_sl, 0))
                emit_expr(sublist_get(args_sl, 0))
                let inner_str = expr_result_str
                let inner_type = expr_result_type
                let inner_is_none = expr_option_is_none
                expr_option_is_none = 0
                // When the arg is a transparent-typed VARIABLE (e.g. `let e =
                // Errno(5); Some(e)`) the carve-out at emit_let_binding already
                // lowered `e` to a bare int64_t and cleared its enum tracking, so
                // transparent_newtype_arg_enum sees only a CT_INT Ident. Recover
                // the inner from the enclosing function's Option[Errno] return
                // annotation so the carrier still resolves to Option_Errno rather
                // than Option_int.
                if transparent_enum == "" && inner_type == CT_INT && cg_current_fn_node != -1 {
                    let ann_inner = option_inner_struct_from_fn(cg_current_fn_node)
                    if ann_inner != "" && is_transparent_newtype(ann_inner) != 0 {
                        transparent_enum = ann_inner
                    }
                }
                // Consult the live let-target annotation (`let x: Option[..] =
                // Some(..)`). emit_let_binding derives a STRUCTURED carrier name
                // from this same annotation for the declaration; the RHS Some cast
                // must match it or C reports "invalid initializer" over two
                // byte-identical-but-differently-named carriers.
                // The Ok/Err path already consults the annotation this way; this
                // brings Some to parity. Only fires when the annotation is present
                // (fn-return / bare-scalar paths leave ann_inner_name empty, so
                // their existing output is byte-identical).
                let mut ann_inner_name = ""
                if cg_let_target_ann != -1 && node_name(cg_let_target_ann) == "Option" {
                    let lt_elems = node_elements(cg_let_target_ann)
                    if lt_elems != -1 && sublist_length(lt_elems) >= 1 {
                        let lt_inner_ann = sublist_get(lt_elems, 0)
                        let lt_inner_name = node_name(lt_inner_ann)
                        let lt_inner_ct = type_from_name(lt_inner_name)
                        // Transparent-newtype scalar inner: the arg reached
                        // Some as a CT_INT variable, so transparent_newtype_arg_enum
                        // and the fn-return recovery both missed it. Recover from the
                        // annotation using the UN-STRIPPED node_name — exactly what
                        // option_inner_struct_from_fn returns — so this mints the same
                        // carrier token as the enclosing-fn recovery above.
                        if transparent_enum == "" && inner_type == CT_INT && is_transparent_newtype(lt_inner_name) != 0 {
                            transparent_enum = lt_inner_name
                        } else if is_compound_ct(lt_inner_ct) != 0 || lt_inner_name == "Tuple" {
                            // Compound/Tuple inner: compute the STRUCTURED
                            // name (Map_int_int, Option_int, ...) to feed the compound
                            // branch's carrier-name chain as its first preference.
                            ann_inner_name = compound_name_from_ann(lt_inner_ann)
                        }
                    }
                }
                if transparent_enum != "" {
                    ensure_struct_option_type(transparent_enum)
                    let opt_type = struct_option_c_type(transparent_enum)
                    expr_result_str = "({opt_type})\{.tag = 1, .value = {inner_str}}"
                    expr_result_type = CT_OPTION
                    publish_result_tid(node)
                    expr_option_inner = inner_type
                    expr_option_inner_struct = transparent_enum
                    return
                }
                // @ffi.opaque inner: the Option is niche-optimized to the bare
                // handle pointer (NULL = None), so Some(h) IS the handle — no tag,
                // no heap box. Resolve the opaque inner name from the arg's own
                // var-struct, the let-target annotation, or the enclosing fn return
                // (the same three channels the transparent/scalar paths consult).
                // Only a non-compound inner can be the bare handle: for Some(Some(h))
                // the inner Some(h) already NPO'd to `h`, whose var-struct still reads
                // CFile — but the OUTER inner_type is CT_OPTION and must stay a tagged
                // carrier, so gate the whole NPO probe on a non-compound inner_type.
                let mut opaque_inner = ""
                if is_compound_ct(inner_type) == 0 {
                    let some_vs = get_var_struct(inner_str)
                    if some_vs != "" && is_opaque_type(some_vs) != 0 {
                        opaque_inner = some_vs
                    }
                }
                if opaque_inner == "" && is_compound_ct(inner_type) == 0 && cg_let_target_ann != -1 && node_name(cg_let_target_ann) == "Option" {
                    let oi_elems = node_elements(cg_let_target_ann)
                    if oi_elems != -1 && sublist_length(oi_elems) >= 1 {
                        let oi_name = node_name(sublist_get(oi_elems, 0))
                        if is_opaque_type(oi_name) != 0 { opaque_inner = oi_name }
                    }
                }
                if opaque_inner == "" && is_compound_ct(inner_type) == 0 && cg_current_fn_node != -1 {
                    let fr_inner = option_inner_struct_from_fn(cg_current_fn_node)
                    if fr_inner != "" && is_opaque_type(fr_inner) != 0 { opaque_inner = fr_inner }
                }
                if opaque_inner != "" {
                    expr_result_str = inner_str
                    expr_result_type = CT_OPTION
                    publish_result_tid(node)
                    expr_option_inner = inner_type
                    expr_option_inner_struct = opaque_inner
                    return
                }
                // A CT_OPTION/CT_RESULT/CT_MAP inner must route to the compound
                // branch below — its structured carrier (Option_Map_str_int) comes
                // from the annotation-consult (ann_inner_name), NOT get_var_struct.
                // An Option[Map] var carries "Map_str_int" in its var-struct slot
                // (the INNER carrier tag), so an unguarded struct branch would spell
                // the value carrier one level short (blink_Option_Map_str_int instead
                // of blink_Option_Option_Map_str_int) and box the inner as a bare
                // blink_map*. The struct branch is for genuine struct/enum
                // inners (Some(point)); gate it on a non-compound inner_type.
                let mut inner_s = if is_compound_ct(inner_type) == 0 { get_var_struct(inner_str) } else { "" }
                if inner_s == "" && is_compound_ct(inner_type) == 0 {
                    let ve_name = get_var_enum(inner_str)
                    if ve_name != "" && is_enum_type(ve_name) != 0 {
                        inner_s = ve_name
                    }
                }
                if inner_s == "" {
                    // Both channels above are keyed on the emitted C EXPRESSION
                    // STRING, so they only answer for a named variable — `Some(Duration.ms(50))`
                    // has no ScopeVar for its inner at all. The flat CT does answer, and for
                    // these two types it names a declared struct, so this is the last resort
                    // that keeps an Instant/Duration inner off the scalar branch below (where
                    // c_type_tag has no arm and the carrier became the never-typedef'd
                    // blink_Option_void). Ordered last so a real struct/enum name still wins.
                    inner_s = builtin_struct_name_for_ct(inner_type)
                }
                if inner_s != "" {
                    if cg_in_handler_body != 0 && cg_handler_body_is_ue != 0 && cg_current_fn_option_inner == CT_PTR {
                        ensure_option_type(CT_PTR)
                        let opt_type = option_c_type(CT_PTR)
                        let struct_c = c_type_c_name(inner_s)
                        let heap_tmp = fresh_temp("__ue_heap_")
                        emit_line("{struct_c}* {heap_tmp} = ({struct_c}*)blink_alloc(sizeof({struct_c}));")
                        emit_line("*{heap_tmp} = {inner_str};")
                        expr_result_str = "({opt_type})\{.tag = 1, .value = (void*){heap_tmp}}"
                        expr_result_type = CT_OPTION
                        publish_result_tid(node)
                        // The logical inner stays TRUE (the tid says Item); only the physical
                        // carrier is the blink_Option_ptr box. The erased bit — not an erased
                        // inner — tells each consumer to reassert the ptr carrier and cast the
                        // void* payload back to the true struct.
                        expr_option_inner = inner_type
                        expr_option_inner_struct = inner_s
                        expr_option_erased = 1
                    } else if is_payloadless_enum(inner_s) != 0 {
                        // Payload-less enum: by-value nominal carrier, no heap box —
                        // mirrors the transparent-newtype construct above and the
                        // Result err-enum arm. The ordinal is stored inline in .value.
                        ensure_struct_option_type(inner_s)
                        let opt_type = struct_option_c_type(inner_s)
                        expr_result_str = "({opt_type})\{.tag = 1, .value = {inner_str}}"
                        expr_result_type = CT_OPTION
                        publish_result_tid(node)
                        expr_option_inner = inner_type
                        expr_option_inner_struct = inner_s
                    } else {
                        ensure_struct_option_type(inner_s)
                        let opt_type = struct_option_c_type(inner_s)
                        let struct_c = c_type_c_name(inner_s)
                        let box_tmp = fresh_temp("_sbox_")
                        emit_line("{struct_c}* {box_tmp} = ({struct_c}*)blink_alloc(sizeof({struct_c}));")
                        emit_line("*{box_tmp} = {inner_str};")
                        expr_result_str = "({opt_type})\{.tag = 1, .value = {box_tmp}}"
                        expr_result_type = CT_OPTION
                        publish_result_tid(node)
                        expr_option_inner = inner_type
                        expr_option_inner_struct = inner_s
                    }
                } else if is_compound_ct(inner_type) != 0 {
                    let compound_name = if ann_inner_name != "" {
                        ann_inner_name
                    } else if inner_type == CT_OPTION && inner_is_none != 0 && expr_option_inner_struct != "" {
                        // A bare inner `None` already publishes its OWN carrier tag
                        // (Option_CFile) in expr_option_inner_struct — that IS the inner
                        // value's type tag, so use it directly.
                        expr_option_inner_struct
                    } else if inner_type == CT_OPTION && expr_option_inner_struct != "" {
                        // A real inner `Some(..)`/Option var publishes its INNER struct
                        // (Point, CFile), so THIS carrier is one Option deeper:
                        // Option[Option[Point]] over an inner "Point" is "Option_Point".
                        // canonical_struct_tag re-wraps an already-tagged inner
                        // (Option[Option[Option[X]]]) and passes a bare opaque/struct name through.
                        "Option_{canonical_struct_tag(expr_option_inner_struct)}"
                    } else if inner_type == CT_OPTION {
                        let opt_tag = c_type_tag(expr_option_inner)
                        "Option_{opt_tag}"
                    } else if inner_type == CT_RESULT {
                        let ok_tag = if expr_result_ok_struct != "" { canonical_struct_tag(expr_result_ok_struct) } else { c_type_tag(expr_result_ok_type) }
                        let err_tag = if expr_result_err_struct != "" { canonical_struct_tag(expr_result_err_struct) } else { c_type_tag(expr_result_err_type) }
                        "Result_{ok_tag}_{err_tag}"
                    } else if inner_type == CT_MAP {
                        // Map is an erased carrier: one blink_map* backs every K/V, so the
                        // Option value carrier is the bare blink_Option_map (matching the tid
                        // path and compound_option_inner_name). K/V are recovered per-use from
                        // the tid, never spelled into the carrier name.
                        "map"
                    } else {
                        compound_option_inner_name(inner_type, inner_str)
                    }
                    ensure_struct_option_type(compound_name)
                    let opt_type = struct_option_c_type(compound_name)
                    let compound_c = c_type_from_tag(compound_name)
                    let mut actual_inner = inner_str
                    if inner_type == CT_OPTION && inner_is_none != 0 {
                        // A nested inner Option[@ffi.opaque] is NPO'd to the bare handle, so its
                        // None is the null handle ((FILE*)0) — never a tagged carrier literal over
                        // the suppressed, undeclared blink_Option_<opaque>.
                        let inner_opaque = opaque_option_carrier_cname(compound_name)
                        if inner_opaque != "" {
                            actual_inner = "(({inner_opaque})0)"
                        } else {
                            actual_inner = "(blink_{compound_name})\{.tag = 0}"
                        }
                    }
                    if compound_c.ends_with("*") {
                        expr_result_str = "({opt_type})\{.tag = 1, .value = {actual_inner}}"
                    } else {
                        let box_tmp = fresh_temp("_cbox_")
                        emit_line("{compound_c}* {box_tmp} = ({compound_c}*)blink_alloc(sizeof({compound_c}));")
                        emit_line("*{box_tmp} = {actual_inner};")
                        expr_result_str = "({opt_type})\{.tag = 1, .value = {box_tmp}}"
                    }
                    expr_result_type = CT_OPTION
                    publish_result_tid(node)
                    expr_option_inner = inner_type
                    expr_option_inner_struct = compound_name
                    if inner_type == CT_MAP {
                        let mvs = get_map_value_struct(inner_str)
                        if mvs != "" {
                            expr_option_inner_map_val_struct = mvs
                        }
                        let mvle = get_map_value_list_elem(inner_str)
                        if mvle >= 0 {
                            expr_option_inner_map_val_list_elem = mvle
                        }
                    }
                    if inner_type == CT_LIST {
                        let le = get_list_elem_type(inner_str)
                        if le >= 0 {
                            expr_option_inner_list_elem = le
                        }
                        let les = get_list_elem_struct(inner_str)
                        if les != "" {
                            expr_option_inner_list_struct = les
                        }
                    }
                } else {
                    ensure_option_type(inner_type)
                    let opt_type = option_c_type(inner_type)
                    expr_result_str = "({opt_type})\{.tag = 1, .value = {inner_str}}"
                    expr_result_type = CT_OPTION
                    publish_result_tid(node)
                    expr_option_inner = inner_type
                    expr_option_inner_struct = ""
                }
                return
            }
        }
        if fn_name == "Ok" {
            let args_sl = node_args(node)
            let arity = if args_sl != -1 { sublist_length(args_sl) } else { 0 }
            let exp_ok_ann = expect_arg_result_elem(0)
            let ok_exp_res_tid = tc_tid_resolved(entry_expect_tid)
            if exp_ok_ann == -1 && arity > 0 && tc_tid_ct(ok_exp_res_tid) == CT_RESULT {
                let ok_s = tc_tid_result_ok_struct(ok_exp_res_tid)
                let err_s = tc_tid_result_err_struct(ok_exp_res_tid)
                let ok_ct = tc_tid_result_ok_ct(ok_exp_res_tid)
                let err_ct = tc_tid_result_err_ct(ok_exp_res_tid)
                if result_push_side_namable(ok_ct, ok_s) && result_push_side_namable(err_ct, err_s) {
                    let saved_tid = cg_expect_arg_tid
                    let saved_arg_ann = cg_expect_arg_ann
                    let saved_let_ann = cg_let_target_ann
                    cg_expect_arg_ann = -1
                    cg_let_target_ann = -1
                    cg_expect_arg_tid = tc_tid_result_ok_tid(ok_exp_res_tid)
                    emit_expr(sublist_get(args_sl, 0))
                    cg_expect_arg_tid = saved_tid
                    cg_expect_arg_ann = saved_arg_ann
                    cg_let_target_ann = saved_let_ann
                    let ok_str = expr_result_str
                    emit_ok_result(ok_str, result_push_side_ct(ok_ct, ok_s), result_push_side_ct(err_ct, err_s), ok_s, err_s)
                    return
                }
            }
            if exp_ok_ann != -1 && arity > 0 {
                let exp_err_ann = expect_arg_result_elem(1)
                let ok_name = node_name(exp_ok_ann)
                let err_name = node_name(exp_err_ann)
                let saved_arg_ann = cg_expect_arg_ann
                let saved_let_ann = cg_let_target_ann
                // Narrow the value context to the Ok payload's own annotation
                // before recursing. Merely clearing cg_expect_arg_ann leaves the
                // OUTER cg_let_target_ann live, so a nested compound payload
                // (Ok(Ok(x)) → Result[Result[..],..]) would emit the inner Ok with
                // the OUTER carrier type. Pushing exp_ok_ann makes the
                // inner constructor's expect_arg_result_elem see its real type.
                cg_expect_arg_ann = -1
                cg_let_target_ann = exp_ok_ann
                emit_expr(sublist_get(args_sl, 0))
                cg_expect_arg_ann = saved_arg_ann
                cg_let_target_ann = saved_let_ann
                let ok_str = expr_result_str
                let ok_inner_ct = expr_result_type
                let ok_inner_struct = get_var_struct(ok_str)
                let mut ok_c = carrier_from_elem_name(ok_name, ok_inner_ct, exp_ok_ann)
                // When the expected ok ann is a generic type-param (e.g.
                // `Result[T, Str]`), carrier_from_elem_name leaves struct_name empty
                // (it only sets it for a concrete struct/enum) — recover the
                // carrier from the emitted argument's own struct/enum so the
                // Ok payload keeps its real type. Do NOT fire when the ok side is
                // itself a compound (Option/Result): get_var_struct returns the
                // compound's INNER struct ("Item" for Option[Item]), and stamping
                // it here would make upgrade_compound_carrier's `struct_name != ""`
                // guard early-return, erasing the carrier to blink_Result_Item_str
                // instead of blink_Result_Option_Item_str. Let
                // upgrade_compound_carrier build the compound tag from exp_ok_ann.
                if ok_c.struct_name == "" && ok_inner_struct != "" && ok_name != "Option" && ok_name != "Result" {
                    ok_c = CarrierInfo { type_const: CT_INT, struct_name: ok_inner_struct }
                }
                // A compound ok/err annotation (`Result[Option[T], E]` etc.)
                // carries no struct/enum name; upgrade both sides so the carrier
                // embeds the inner compound by value instead of erasing to
                // `void ok`/`void err`. emit_expr above ensured the ok payload's
                // inner typedef; ensure the (non-emitted) err side's too.
                ok_c = upgrade_compound_carrier(ok_c, exp_ok_ann)
                let mut err_c = carrier_from_elem_name(err_name, type_from_name(err_name), exp_err_ann)
                err_c = upgrade_compound_carrier(err_c, exp_err_ann)
                if err_c.struct_name != "" { ensure_carrier_from_tag(err_c.struct_name) }
                emit_ok_result(ok_str, ok_c.type_const, err_c.type_const, ok_c.struct_name, err_c.struct_name)
                return
            }
            if arity == 0 {
                let fn_rt = get_fn_ret_type(cg_current_fn_name)
                let mut ok_type = CT_VOID
                if fn_rt.kind == CT_RESULT { ok_type = fn_rt.inner1 }
                let fsi = get_fn_ret_struct_inner(cg_current_fn_name)
                let mut ok_s = fsi.ok_struct
                let mut err_s = fsi.err_struct
                let mut err_type = if err_s != "" { CT_INT } else if fn_rt.kind == CT_RESULT { fn_rt.inner2 } else { CT_STRING }
                if fsi.ok_struct.starts_with("Result_") {
                    let split = split_result_compound(fsi.ok_struct)
                    if split.second != "" {
                        let inner_err_ct = type_from_name_tag(split.second)
                        if is_struct_type(split.second) != 0 || is_enum_type(split.second) != 0 {
                            err_s = split.second
                            err_type = CT_INT
                        } else {
                            err_s = ""
                            err_type = inner_err_ct
                        }
                    }
                    ok_s = ""
                }
                emit_ok_result("0", ok_type, err_type, ok_s, err_s)
                return
            }
            if args_sl != -1 && sublist_length(args_sl) > 0 {
                emit_expr(sublist_get(args_sl, 0))
                let ok_str = expr_result_str
                let mut ok_type = expr_result_type
                // Reassignment (`r = Ok(m)`) adopts the target var's declared Result
                // carrier, symmetric with the Err path — the fn-return fallback below
                // has no annotation and would erase the ok side. The ok payload type
                // (ok_type) still comes from the emitted arg; only the carrier NAME
                // (ok_s/err_s) is taken from the target.
                if cg_assign_target_name != "" && get_var_type(cg_assign_target_name) == CT_RESULT {
                    let t_ok_s = get_var_result_ok_tag(cg_assign_target_name)
                    let t_err_t = get_var_result_err(cg_assign_target_name)
                    let t_err_s = get_var_result_err_tag(cg_assign_target_name)
                    emit_ok_result(ok_str, ok_type, t_err_t, t_ok_s, t_err_s)
                    return
                }
                let fn_rt = get_fn_ret_type(cg_current_fn_name)
                if fn_rt.kind == CT_RESULT && fn_rt.inner1 == CT_VOID {
                    ok_type = CT_VOID
                }
                let ok_var_s = get_var_struct(ok_str)
                let fsi = get_fn_ret_struct_inner(cg_current_fn_name)
                // When the Ok payload is itself compound (CT_OPTION or
                // CT_RESULT), get_var_struct returns the inner struct (e.g.
                // "Item" for Option[Item]) which would be the wrong Ok-tag.
                // Prefer the function-stated fsi.ok_struct (which may be a
                // generic placeholder like "Option_ptr" for effect handlers);
                // fall back to synthesizing the compound tag.
                let compound_ok_s = if ok_type == CT_OPTION {
                    let opt_s = expr_option_inner_struct
                    if opt_s != "" {
                        "Option_{opt_s}"
                    } else {
                        "Option_{c_type_tag(expr_option_inner)}"
                    }
                } else if ok_type == CT_RESULT {
                    let ok_tag = if expr_result_ok_struct != "" { expr_result_ok_struct } else { c_type_tag(expr_result_ok_type) }
                    let err_tag = if expr_result_err_struct != "" { expr_result_err_struct } else { c_type_tag(expr_result_err_type) }
                    "Result_{ok_tag}_{err_tag}"
                } else if ok_type == CT_MAP {
                    // Map is an erased carrier: the Result ok side is the bare blink_Result_map_...
                    // (one blink_map* per K/V, matching the tid path). K/V are recovered per-use
                    // from the tid, never spelled into the carrier name.
                    "map"
                } else {
                    ""
                }
                let mut ok_s = if fsi.ok_struct != "" {
                    fsi.ok_struct
                } else if compound_ok_s != "" {
                    compound_ok_s
                } else {
                    ok_var_s
                }
                let mut err_s = fsi.err_struct
                let mut err_type = if err_s != "" { CT_INT } else if fn_rt.kind == CT_RESULT { fn_rt.inner2 } else { CT_STRING }
                if ok_type != CT_RESULT && fsi.ok_struct.starts_with("Result_") {
                    let split = split_result_compound(fsi.ok_struct)
                    if split.second != "" {
                        let inner_err_ct = type_from_name_tag(split.second)
                        if is_struct_type(split.second) != 0 || is_enum_type(split.second) != 0 {
                            err_s = split.second
                            err_type = CT_INT
                        } else {
                            err_s = ""
                            err_type = inner_err_ct
                        }
                    }
                    ok_s = ""
                }
                emit_ok_result(ok_str, ok_type, err_type, ok_s, err_s)
                return
            }
        }
        if fn_name == "Err" {
            let args_sl = node_args(node)
            let exp_err_result_ann = expect_arg_result_elem(0)
            let err_exp_res_tid = tc_tid_resolved(entry_expect_tid)
            if exp_err_result_ann == -1 && args_sl != -1 && sublist_length(args_sl) > 0 && tc_tid_ct(err_exp_res_tid) == CT_RESULT {
                let ok_s = tc_tid_result_ok_struct(err_exp_res_tid)
                let err_s = tc_tid_result_err_struct(err_exp_res_tid)
                let ok_ct = tc_tid_result_ok_ct(err_exp_res_tid)
                let err_ct = tc_tid_result_err_ct(err_exp_res_tid)
                if result_push_side_namable(ok_ct, ok_s) && result_push_side_namable(err_ct, err_s) {
                    let saved_tid = cg_expect_arg_tid
                    let saved_arg_ann = cg_expect_arg_ann
                    let saved_let_ann = cg_let_target_ann
                    cg_expect_arg_ann = -1
                    cg_let_target_ann = -1
                    cg_expect_arg_tid = tc_tid_result_err_tid(err_exp_res_tid)
                    emit_expr(sublist_get(args_sl, 0))
                    cg_expect_arg_tid = saved_tid
                    cg_expect_arg_ann = saved_arg_ann
                    cg_let_target_ann = saved_let_ann
                    let err_str = expr_result_str
                    emit_err_result(err_str, result_push_side_ct(ok_ct, ok_s), result_push_side_ct(err_ct, err_s), ok_s, err_s)
                    return
                }
            }
            if exp_err_result_ann != -1 && args_sl != -1 && sublist_length(args_sl) > 0 {
                let exp_err_ann = expect_arg_result_elem(1)
                let ok_name = node_name(exp_err_result_ann)
                let err_name = node_name(exp_err_ann)
                let saved_arg_ann = cg_expect_arg_ann
                let saved_let_ann = cg_let_target_ann
                // Narrow to the Err payload's annotation (symmetric with the Ok
                // path). Without this a nested Err(Ok(x)) → Result[.., Result[..]]
                // emits the inner constructor with the OUTER carrier type.
                cg_expect_arg_ann = -1
                cg_let_target_ann = exp_err_ann
                emit_expr(sublist_get(args_sl, 0))
                cg_expect_arg_ann = saved_arg_ann
                cg_let_target_ann = saved_let_ann
                let err_str = expr_result_str
                let mut ok_c = carrier_from_elem_name(ok_name, type_from_name(ok_name), exp_err_result_ann)
                // The ok side is not emitted in an Err construction; upgrade a
                // compound ok annotation and ensure its inner typedef so the
                // carrier matches the Ok-construction of the same Result type.
                ok_c = upgrade_compound_carrier(ok_c, exp_err_result_ann)
                if ok_c.struct_name != "" { ensure_carrier_from_tag(ok_c.struct_name) }
                let mut err_c = carrier_from_elem_name(err_name, expr_result_type, exp_err_ann)
                if err_c.struct_name == "" {
                    err_c = carrier_from_emitted(err_str, expr_result_type)
                }
                err_c = upgrade_compound_carrier(err_c, exp_err_ann)
                emit_err_result(err_str, ok_c.type_const, err_c.type_const, ok_c.struct_name, err_c.struct_name)
                return
            }
            if args_sl != -1 && sublist_length(args_sl) > 0 {
                emit_expr(sublist_get(args_sl, 0))
                let err_str = expr_result_str
                let err_type = expr_result_type
                // A statement-level reassignment (`r = Err(3)`) has no RHS annotation,
                // so adopt the target var's declared Result carrier — otherwise the
                // fsi/fn-return fallback below mints a scalar carrier
                // (blink_Result_int_int) that C rejects against the target's structured
                // type (blink_Result_Map_str_int_int). Mirrors the annotation path's
                // emit_err_result with the target's recorded ok/err type+struct.
                if cg_assign_target_name != "" && get_var_type(cg_assign_target_name) == CT_RESULT {
                    let t_ok_t = get_var_result_ok(cg_assign_target_name)
                    let t_err_t = get_var_result_err(cg_assign_target_name)
                    let t_ok_s = get_var_result_ok_tag(cg_assign_target_name)
                    let t_err_s = get_var_result_err_tag(cg_assign_target_name)
                    emit_err_result(err_str, t_ok_t, t_err_t, t_ok_s, t_err_s)
                    return
                }
                let err_enum = get_var_enum(err_str)
                let fsi = get_fn_ret_struct_inner(cg_current_fn_name)
                let mut err_s = if err_enum != "" { err_enum } else { fsi.err_struct }
                let mut ok_s = fsi.ok_struct
                let fn_rt = get_fn_ret_type(cg_current_fn_name)
                let mut ok_type = if ok_s != "" { CT_INT } else if fn_rt.kind == CT_RESULT { fn_rt.inner1 } else { CT_INT }
                if fsi.ok_struct.starts_with("Result_") {
                    let split = split_result_compound(fsi.ok_struct)
                    if split.second != "" {
                        let inner_err_ct = type_from_name_tag(split.second)
                        let inner_ok_ct = type_from_name_tag(split.first)
                        if err_type == inner_err_ct {
                            if is_struct_type(split.first) != 0 || is_enum_type(split.first) != 0 {
                                ok_s = split.first
                                ok_type = CT_INT
                            } else {
                                ok_s = ""
                                ok_type = inner_ok_ct
                            }
                            err_s = if err_enum != "" { err_enum } else { "" }
                        }
                    }
                }
                let err_val = box_struct_err(err_str, err_s)
                if ok_s != "" || err_s != "" {
                    ensure_mixed_result_type(ok_type, err_type, ok_s, err_s)
                    let res_type = result_c_type_mixed(ok_type, err_type, ok_s, err_s)
                    expr_result_str = "({res_type})\{.tag = 1, .err = {err_val}}"
                    expr_result_type = CT_RESULT
                    publish_result_tid(node)
                    expr_result_ok_type = ok_type
                    expr_result_err_type = err_type
                    expr_result_ok_struct = ok_s
                    expr_result_err_struct = err_s
                } else {
                    ensure_result_type(ok_type, err_type)
                    let res_type = result_c_type(ok_type, err_type)
                    expr_result_str = "({res_type})\{.tag = 1, .err = {err_val}}"
                    expr_result_type = CT_RESULT
                    publish_result_tid(node)
                    expr_result_ok_type = ok_type
                    expr_result_err_type = err_type
                    expr_result_ok_struct = ""
                    expr_result_err_struct = ""
                }
                return
            }
        }
        if fn_name == "Map" {
            let ec = resolve_kops_carrier("Map", node)
            let kops = kops_table_name(ec.type_const, ec.struct_name)
            expr_result_str = "blink_map_new(&{kops})"
            expr_result_type = CT_MAP
            publish_result_tid(node)
            // A bare `Map()` literal carries no key/value type of its own -- the
            // binding's annotation branch (emit_let_binding's CT_MAP arm) derives
            // and stamps the real types separately. Without resetting these here,
            // a stale expr_map_key_type/expr_map_val_type left over from an
            // unrelated earlier CT_MAP-producing expression (e.g. a prior
            // statement's generic-fn call returning Map[K,V]) reads as "fresh" to
            // apply_map_binding_meta's `>= 0` guard and clobbers the just-stamped
            // types with garbage.
            expr_map_key_type = -1
            expr_map_val_type = -1
            expr_map_key_struct = ""
            expr_map_val_struct = ""
            return
        }
        if fn_name == "Set" {
            let ec = resolve_kops_carrier("Set", node)
            let kops = kops_table_name(ec.type_const, ec.struct_name)
            expr_result_str = "blink_set_new(&{kops})"
            expr_result_type = CT_SET
            publish_result_tid(node)
            // A fresh set carries no element type via the global; the let-block
            // records it from the annotation. Clear so a stale value from a
            // prior expression can't leak into an unannotated `let s = Set()`.
            expr_list_elem_type = -1
            expr_list_elem_struct = ""
            return
        }
        if fn_name == "Bytes" {
            expr_result_str = "blink_bytes_new()"
            expr_result_type = CT_BYTES
            publish_result_tid(node)
            return
        }
        if fn_name == "StringBuilder" {
            let args_sl = node_args(node)
            if args_sl != -1 && sublist_length(args_sl) > 0 {
                emit_expr(sublist_get(args_sl, 0))
                let cap_str = expr_result_str
                expr_result_str = "blink_sb_with_capacity({cap_str})"
            } else {
                expr_result_str = "blink_sb_new()"
            }
            expr_result_type = CT_STRINGBUILDER
            publish_result_tid(node)
            return
        }
        if fn_name == "Channel" {
            let args_sl = node_args(node)
            if args_sl != -1 && sublist_length(args_sl) > 0 {
                emit_expr(sublist_get(args_sl, 0))
                let cap_str = expr_result_str
                expr_result_str = "blink_channel_new({cap_str})"
            } else {
                expr_result_str = "blink_channel_new(16)"
            }
            expr_result_type = CT_CHANNEL
            publish_result_tid(node)
            return
        }
        if fn_name == "alloc_ptr" {
            let inner_c = resolve_ptr_inner_c()
            expr_result_str = "({inner_c}*)malloc(sizeof({inner_c}))"
            expr_result_type = CT_PTR
            publish_result_tid(node)
            return
        }
        if fn_name == "null_ptr" {
            let inner_c = resolve_ptr_inner_c()
            expr_result_str = "(({inner_c}*)NULL)"
            expr_result_type = CT_PTR
            publish_result_tid(node)
            return
        }
        // Check if this is a closure-typed variable
        let closure_sig = get_var_closure_sig(fn_name)
        if closure_sig != "" {
            let cap_idx_cls = get_capture_index(fn_name)
            let mut cls_expr = c_safe_name(fn_name)
            if cap_idx_cls >= 0 {
                let cap_entry_cls = closure_captures.get(cg_closure_cap_start + cap_idx_cls).unwrap()
                if cap_entry_cls.is_mut != 0 {
                    cls_expr = "(*{c_safe_name(fn_name)}_cell)"
                } else {
                    cls_expr = "((blink_closure*)blink_closure_get_capture(__self, {cap_idx_cls}))"
                }
            } else if list_contains_str(mut_captured_vars, fn_name) != 0 {
                let mut is_closure_param_cc = 0
                let mut cpi_cc = 0
                while cpi_cc < closure_param_names.len() {
                    if closure_param_names.get(cpi_cc).unwrap() == fn_name {
                        is_closure_param_cc = 1
                    }
                    cpi_cc = cpi_cc + 1
                }
                if is_closure_param_cc == 0 {
                    cls_expr = "(*{c_safe_name(fn_name)}_cell)"
                }
            }
            let args_sl = node_args(node)
            let mut args_str = cls_expr
            if args_sl != -1 {
                let mut i = 0
                while i < sublist_length(args_sl) {
                    args_str = args_str.concat(", ")
                    emit_expr(sublist_get(args_sl, i))
                    args_str = args_str.concat(expr_result_str)
                    i = i + 1
                }
            }
            let ret_part = closure_sig_ret_part(closure_sig)
            // The tid leads for the container kinds, whose C spelling is shared by
            // every instantiation and therefore unrecoverable from the string below. No overlap
            // with the tag reseat that follows — a recognized tag is an Option/Result carrier or
            // a struct name, never a container head — so first-wins here is not a precedence
            // choice between two answers, it is the only answer.
            let ret_ct_tid = closure_ret_direct_ct(node)
            if ret_ct_tid >= 0 {
                expr_result_str = "(({closure_sig}){cls_expr}->fn_ptr)({args_str})"
                expr_result_type = ret_ct_tid
                publish_result_tid(node)
                return
            }
            // Option[@ffi.opaque] is NPO'd to the bare handle (`FILE*`), a tag-less
            // spelling closure_ret_tag_is_recognized cannot decode, so the tid restores
            // the Option-ness here. The temp holds the handle; the reseat marks it an
            // Option so downstream .is_none()/.unwrap()/match dispatch to the NULL niche.
            let opaque_opt_inner = closure_ret_opaque_option_inner(node)
            if opaque_opt_inner != "" {
                let tmp = fresh_temp("_cls_ret_")
                emit_line("{ret_part} {tmp} = (({closure_sig}){cls_expr}->fn_ptr)({args_str});")
                set_var(tmp, CT_OPTION, 0)
                set_var_option_struct(tmp, CT_STRUCT, opaque_opt_inner)
                expr_result_str = tmp
                expr_result_type = CT_OPTION
                expr_option_inner = CT_STRUCT
                expr_option_inner_struct = opaque_opt_inner
                publish_result_tid(node)
                return
            }
            if ret_part.starts_with("blink_") {
                let sname = strip_blink_prefix(ret_part)
                // Decode compound returns (Option_/Result_/Map_) BEFORE
                // falling back to struct resolution — resolve_struct_from_c_name
                // would otherwise misread "Option_UserRow" as the struct "UserRow".
                if closure_ret_tag_is_recognized(sname) != 0 {
                    let tmp = fresh_temp("_cls_ret_")
                    emit_line("{ret_part} {tmp} = (({closure_sig}){cls_expr}->fn_ptr)({args_str});")
                    reseat_from_closure_ret_tag(sname, tmp)
                    return
                }
            }
            expr_result_str = "(({closure_sig}){cls_expr}->fn_ptr)({args_str})"
            expr_result_type = closure_ret_ct(ret_part)
            publish_result_tid(node)
            return
        }
        let args_sl = node_args(node)
        let mut args_str = ""
        let is_generic = is_generic_fn(fn_name)
        let callee_params_sl = get_callee_params_sl(fn_name)
        reorder_named_args(fn_name, args_sl, node)
        if reorder_result.len() > 0 {
            let mut i = 0
            while i < reorder_result.len() {
                if i > 0 {
                    args_str = args_str.concat(", ")
                }
                let arg_node = reorder_result.get(i).unwrap()
                let mut actual = arg_node
                if node_kind(arg_node) == NodeKind.NamedArg {
                    actual = node_value(arg_node)
                }
                let saved_hint = cg_expect_fn_value_sig
                cg_expect_fn_value_sig = arg_fn_value_hint(callee_params_sl, i)
                let saved_arg_ann = cg_expect_arg_ann
                cg_expect_arg_ann = arg_type_ann_at(callee_params_sl, i)
                emit_expr(actual)
                cg_expect_arg_ann = saved_arg_ann
                cg_expect_fn_value_sig = saved_hint
                args_str = args_str.concat(expr_result_str)
                i = i + 1
            }
        } else if args_sl != -1 {
            let mut i = 0
            while i < sublist_length(args_sl) {
                if i > 0 {
                    args_str = args_str.concat(", ")
                }
                let arg_node_i = sublist_get(args_sl, i)
                let saved_hint = cg_expect_fn_value_sig
                cg_expect_fn_value_sig = arg_fn_value_hint(callee_params_sl, i)
                let saved_arg_ann = cg_expect_arg_ann
                cg_expect_arg_ann = arg_type_ann_at(callee_params_sl, i)
                emit_expr(arg_node_i)
                cg_expect_arg_ann = saved_arg_ann
                cg_expect_fn_value_sig = saved_hint
                args_str = args_str.concat(expr_result_str)
                i = i + 1
            }
        }
        args_str = append_ev_arg(fn_name, args_str)
        if is_generic != 0 {
            let handled = emit_generic_fn_call_tail(node, fn_name, args_str)
            if handled != 0 {
                return
            }
        }
        if is_fn_registered(fn_name) == 0 && is_generic_fn(fn_name) == 0 {
            diag_error_at("UndefinedFunction", UNDEFINED_FUNCTION, "undefined function '{fn_name}' called in '{cg_current_fn_name}'", node, "")
            emit_line("/* undefined: {fn_name} */")
            expr_result_str = "0"
            expr_result_type = CT_INT
            publish_result_tid(node)
            return
        }
        expr_result_type = get_fn_ret(fn_name)
        publish_result_tid(node)
        if expr_result_type == CT_VOID || expr_result_type == CT_STRUCT || expr_result_type == CT_ENUM {
            let fn_sret = get_fn_ret_struct(fn_name)
            if fn_sret != "" {
                let s_tmp = fresh_temp("_sr")
                emit_line("{c_type_c_name(fn_sret)} {s_tmp} = {c_fn_name(fn_name)}({args_str});")
                set_var(s_tmp, CT_STRUCT, 0)
                set_var_struct(s_tmp, fn_sret)
                // A call-result temp has no typecheck node, so let_binding_tid never
                // stamps it — its struct name lived only on the flat sname channel.
                // The call node's tid is the value's type; stamp it so the tid leads,
                // but only when that tid round-trips to the same struct name the C
                // decl carries — never retype the temp when the two diverge.
                let sr_tid = cg_node_mono_tid(node)
                if tid_spells_struct(sr_tid, fn_sret) != 0 { set_var_ty(s_tmp, sr_tid) }
                expr_result_str = s_tmp
                expr_result_type = CT_STRUCT
                publish_result_tid(node)
            } else {
                expr_result_str = "{c_fn_name(fn_name)}({args_str})"
            }
        } else {
            expr_result_str = "{c_fn_name(fn_name)}({args_str})"
        }
        let rt = get_fn_ret_type(fn_name)
        expr_result_ok_struct = ""
        expr_result_err_struct = ""
        expr_option_inner_struct = ""
        expr_list_elem_struct = ""
        expr_map_val_struct = ""
        expr_map_key_struct = ""
        // The declared return type's tid (from the annotation node) is the sole
        // authority for carrier args. Every carrier producer (reg_fn_ret_from_ann,
        // covering Result/Option/List/Map/Set) stamps this tid, so a carrier return
        // always arrives with rt.tid >= 0; a scalar/struct return has no carrier arg
        // to fill and skips every branch below regardless of its tid.
        if rt.tid >= 0 {
            let ret_tid = rt.tid
            if expr_result_type == CT_RESULT {
                expr_result_ok_type = carrier_slot_ct(tc_tid_result_ok_ct(ret_tid))
                expr_result_err_type = carrier_slot_ct(tc_tid_result_err_ct(ret_tid))
                let fsi = get_fn_ret_struct_inner(fn_name)
                expr_result_ok_struct = fsi.ok_struct
                expr_result_err_struct = fsi.err_struct
                let ok_tid = tc_tid_result_ok_tid(ret_tid)
                if expr_result_ok_type == CT_LIST && ok_tid >= 0 {
                    expr_list_elem_type = carrier_slot_ct(tc_tid_list_elem_ct(ok_tid))
                    expr_list_elem_struct = tc_tid_list_elem_struct(ok_tid)
                }
            }
            if expr_result_type == CT_OPTION {
                expr_option_inner = carrier_slot_ct(tc_tid_option_inner_ct(ret_tid))
                let fsi = get_fn_ret_struct_inner(fn_name)
                expr_option_inner_struct = fsi.ok_struct
                let inner_tid = tc_tid_option_inner_tid(ret_tid)
                if expr_option_inner == CT_LIST && inner_tid >= 0 {
                    expr_option_inner_list_elem = carrier_slot_ct(tc_tid_list_elem_ct(inner_tid))
                    let ls = tc_tid_list_elem_struct(inner_tid)
                    if ls != "" {
                        expr_option_inner_list_struct = ls
                    }
                }
                if expr_option_inner == CT_MAP && inner_tid >= 0 {
                    let val_tid = tc_tid_map_val_tid(inner_tid)
                    if val_tid >= 0 {
                        let mvk = tc_tid_ct(val_tid)
                        if mvk == CT_LIST {
                            expr_option_inner_map_val_list_elem = carrier_slot_ct(tc_tid_list_elem_ct(val_tid))
                        }
                        let mvs = tc_tid_map_val_struct(inner_tid)
                        if mvs != "" {
                            expr_option_inner_map_val_struct = mvs
                        }
                    }
                }
            }
            if expr_result_type == CT_LIST {
                expr_list_elem_type = carrier_slot_ct(tc_tid_list_elem_ct(ret_tid))
                let fsi = get_fn_ret_struct_inner(fn_name)
                expr_list_elem_struct = fsi.ok_struct
            }
            if expr_result_type == CT_MAP {
                expr_map_key_type = tc_tid_map_key_ct(ret_tid)
                expr_map_val_type = tc_tid_map_val_ct(ret_tid)
                // A plain (non-generic) fn returning Map[K, Box[Int]] carries the value
                // struct on the return tid's value child; without this a struct-instance
                // Map value erases to the bare generic head at the call site. Mirrors the
                // CT_LIST/CT_OPTION struct recovery three lines above.
                let mvs = tc_tid_map_val_struct(ret_tid)
                if mvs != "" { expr_map_val_struct = mvs }
                let mks = tc_tid_map_key_struct(ret_tid)
                if mks != "" { expr_map_key_struct = mks }
            }
            if expr_result_type == CT_SET {
                expr_list_elem_type = tc_tid_set_elem_ct(ret_tid)
            }
        }
        if expr_result_type == CT_HANDLER {
            let h_info = get_fn_ret_handler(fn_name)
            if h_info.vtable_type != "" {
                cg_handler_vtable_type = h_info.vtable_type
                cg_handler_vtable_field = h_info.vtable_field
                cg_handler_is_user_effect = h_info.is_ue
            }
        }
        return
    }
    // Qualified trait call: Trait.method(x, ...)
    if func_kind == NodeKind.FieldAccess {
        let trait_obj = node_obj(func_node)
        if node_kind(trait_obj) == NodeKind.Ident {
            let trait_name = node_name(trait_obj)
            if is_trait_type(trait_name) != 0 {
                let method = node_name(func_node)
                let args_sl = node_args(node)
                // First arg determines the type
                if args_sl != -1 && sublist_length(args_sl) > 0 {
                    emit_expr(sublist_get(args_sl, 0))
                    let first_str = expr_result_str
                    let type_name = get_var_struct(first_str)
                    if type_name != "" && lookup_impl_method(type_name, method) != 0 {
                        // Qualified call (Trait.method form). The named trait
                        // may be a sibling that doesn't own the method (e.g.
                        // ListOps.is_empty when is_empty lives in Sized), so
                        // resolve the trait that actually defines it before
                        // building the trait-qualified symbol. Gated on
                        // a real user impl so sealed builtin ops-traits skip this.
                        let reg_name = impl_method_reg_name(type_name, method)
                        let owner_trait = if impl_type_implements_trait_method(reg_name, trait_name, method) != 0 { trait_name } else { impl_trait_for_method(reg_name, method) }
                        let mangled = if owner_trait != "" { mangle_impl_method_q(reg_name, owner_trait, method) } else { "{reg_name}_{method}" }
                        let mut args_str = first_str
                        let mut i = 1
                        while i < sublist_length(args_sl) {
                            args_str = args_str.concat(", ")
                            emit_expr(sublist_get(args_sl, i))
                            args_str = args_str.concat(expr_result_str)
                            i = i + 1
                        }
                        args_str = append_ev_arg(mangled, args_str)
                        expr_result_str = "{c_fn_name(mangled)}({args_str})"
                        expr_list_elem_type = -1
                        expr_list_elem_struct = ""
                        expr_result_type = get_impl_method_ret_q(type_name, owner_trait, method)
                        publish_result_tid(node)
                        return
                    }
                }
            }
        }
    }
    emit_expr(func_node)
    let func_str = expr_result_str
    let func_cls_sig = expr_closure_sig
    let args_sl = node_args(node)
    let mut args_str = ""
    if func_cls_sig != "" {
        args_str = func_str
        if args_sl != -1 {
            let mut i = 0
            while i < sublist_length(args_sl) {
                args_str = args_str.concat(", ")
                emit_expr(sublist_get(args_sl, i))
                args_str = args_str.concat(expr_result_str)
                i = i + 1
            }
        }
        expr_result_str = "(({func_cls_sig}){func_str}->fn_ptr)({args_str})"
        // The same tid lead as the by-name call site above: the string chain here
        // guesses wrong in the other direction, falling an unrecognized `blink_*` return
        // to a blanket CT_STRUCT rather than to CT_VOID.
        let ret_ct_tid = closure_ret_direct_ct(node)
        if ret_ct_tid >= 0 {
            expr_result_type = ret_ct_tid
            publish_result_tid(node)
            return
        }
        let ret_part = closure_sig_ret_part(func_cls_sig)
        if ret_part.starts_with("blink_") {
            let sname = strip_blink_prefix(ret_part)
            // Decode compound returns (Option_/Result_/Map_) BEFORE
            // falling back to struct resolution — resolve_struct_from_c_name
            // would otherwise misread "Option_UserRow" as the struct "UserRow".
            if closure_ret_tag_is_recognized(sname) != 0 {
                let tmp = fresh_temp("_cls_ret_")
                emit_line("{ret_part} {tmp} = (({func_cls_sig}){func_str}->fn_ptr)({args_str});")
                reseat_from_closure_ret_tag(sname, tmp)
            } else {
                expr_result_type = CT_STRUCT
                publish_result_tid(node)
            }
        } else {
            expr_result_type = closure_ret_ct(ret_part)
            publish_result_tid(node)
        }
    } else {
        if args_sl != -1 {
            let mut i = 0
            while i < sublist_length(args_sl) {
                if i > 0 {
                    args_str = args_str.concat(", ")
                }
                emit_expr(sublist_get(args_sl, i))
                args_str = args_str.concat(expr_result_str)
                i = i + 1
            }
        }
        expr_result_str = "{func_str}({args_str})"
        expr_result_type = CT_VOID
        publish_result_tid(node)
    }
}

// Resolve the owning source file for a node and escape it for embedding
// into emitted C string literals. Falls back to diag_source_file when the
// node has no registered range (e.g. synthesized nodes).
pub fn panic_file_for(node: Int) -> Str {
    let raw = diag_file_for_node(node)
    let resolved = if raw != "" { raw } else { diag_source_file }
    escape_c_string(resolved)
}

// Like panic_file_for, but additionally escapes `%` as `%%` so the path is safe
// to embed in a printf/vsnprintf FORMAT string (the msg_fmt_c of emit_panic_site).
// A path with a literal `%` would otherwise become an unmatched conversion spec
// with no vararg -> UB. Use ONLY for panic format strings; path
// arguments passed verbatim to runtime helpers must keep panic_file_for.
pub fn panic_file_for_fmt(node: Int) -> Str {
    escape_fmt_percent(panic_file_for(node))
}

// Render the line-number portion of a runtime panic location.
// Returns the decimal line for real source nodes; for synthesized nodes
// whose line did not propagate (line <= 0) returns "<synthesized>" so
// the embedded panic message does not lie about a source position.
pub fn panic_line_str(node: Int) -> Str {
    let l = node_line(node)
    if l <= 0 { "<synthesized>" } else { "{l}" }
}

// Lower a panic site. `msg_fmt_c` is a C printf format WITHOUT a trailing
// newline; `fmt_args_c` is the comma-prefixed argument list (e.g.
// ", (long long)x") or "" when the format is literal. In a non-test build
// this emits the historic inline `fprintf(stderr, "...\n"...); exit(1);` —
// byte-identical to before, so non-test panic sites stay zero-cost. In a test
// build (cg_test_mode) it routes to the thread-local catch dispatch so an
// armed assert_panics can consume the panic (spec §2.20). The caller keeps the
// surrounding `if (cond) { ... }` guard. Returns the C statement string.
pub fn emit_panic_site(msg_fmt_c: Str, fmt_args_c: Str) -> Str {
    if cg_test_mode != 0 {
        "__blink_panic_dispatchf(\"{msg_fmt_c}\"{fmt_args_c});"
    } else {
        "fprintf(stderr, \"{msg_fmt_c}\\n\"{fmt_args_c}); exit(1);"
    }
}

pub fn escape_c_string(s: Str) -> Str {
    let mut sb = StringBuilder.new()
    let mut i = 0
    while i < s.len() {
        let ch = s.byte_at(i)
        if ch == 92 {
            sb.write("\\\\")
        } else if ch == 34 {
            sb.write("\\\"")
        } else if ch == 10 {
            sb.write("\\n")
        } else if ch == 13 {
            sb.write("\\r")
        } else if ch == 9 {
            sb.write("\\t")
        } else if ch == 8 {
            sb.write("\\b")
        } else if ch == 12 {
            sb.write("\\f")
        } else if ch == 63 {
            sb.write("\\?")
        } else {
            sb.write(s.substring(i, 1))
        }
        i = i + 1
    }
    sb.to_str()
}

fn escape_fmt_percent(s: Str) -> Str {
    let mut sb = StringBuilder.new()
    let mut i = 0
    while i < s.len() {
        let ch = s.byte_at(i)
        if ch == 37 {
            if i + 1 < s.len() && s.byte_at(i + 1) == 37 {
                sb.write("%%")
                i = i + 2
            } else {
                sb.write("%%")
                i = i + 1
            }
        } else {
            sb.write(s.substring(i, 1))
            i = i + 1
        }
    }
    sb.to_str()
}

// A single interpolated value's contribution to the blink_str_format call:
// `fmt` is the printf-format fragment, `arg` the matching vararg expression
// (empty when the fragment carries no %-specifier, e.g. an inlined literal).
type InterpFrag {
    fmt: Str
    arg: Str
}

// Render one C value expression `e_str` of C-type `e_type` for interpolation.
// Scalars map to a printf specifier + coerced arg; user structs/enums route
// through their synthesized Display.display(); tuples expand inline to
// "(e0, e1, ...)" by recursing per element (spec §3.6 structural tuple
// Display). The E0523 typecheck gate guarantees every value is Display, so the
// no-Display branch is defensive and emits a placeholder literal — NEVER the
// raw aggregate into %s (which would SIGSEGV).
fn interp_render_value(e_str: Str, e_type: Int, known_struct: Str) -> InterpFrag ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    if e_type == CT_INT || e_type == CT_I8 || e_type == CT_I16 || e_type == CT_I32 {
        return InterpFrag { fmt: "%lld", arg: "(long long)".concat(e_str) }
    }
    if e_type == CT_U8 || e_type == CT_U16 || e_type == CT_U32 || e_type == CT_U64 {
        return InterpFrag { fmt: "%llu", arg: "(unsigned long long)".concat(e_str) }
    }
    if e_type == CT_FLOAT {
        return InterpFrag { fmt: "%g", arg: e_str }
    }
    if e_type == CT_BOOL {
        return InterpFrag { fmt: "%s", arg: e_str.concat(" ? \"true\" : \"false\"") }
    }
    if e_type == CT_CHAR {
        return InterpFrag { fmt: "%s", arg: "blink_char_to_str((int64_t)".concat(e_str).concat(")") }
    }
    if e_type == CT_STRUCT || e_type == CT_ENUM || e_type == CT_VOID {
        // `known_struct` is the tag supplied by a tuple-element recursion —
        // `e_str` there is a field-access expr (e.g. `t._1`) that get_var_struct
        // cannot resolve, so trust the caller's tag. Top-level calls pass "".
        let sname = if known_struct != "" {
            known_struct
        } else if get_var_struct(e_str) != "" {
            get_var_struct(e_str)
        } else if is_data_enum(get_var_enum(e_str)) != 0 {
            get_var_enum(e_str)
        } else {
            ""
        }
        // Anonymous tuple: no impl Display, render structurally as (e0, e1, ...).
        let arity = if sname != "" { tuple_struct_arity(sname) } else { -1 }
        if arity >= 0 {
            let mut tfmt = "("
            let mut targ = ""
            let mut ti = 0
            while ti < arity {
                if ti > 0 { tfmt = tfmt.concat(", ") }
                let elem_struct = tuple_elem_struct(sname, ti)
                let elem_ct = if elem_struct != "" { CT_STRUCT } else { tuple_elem_ct(sname, ti) }
                let elem_expr = e_str.concat("._{ti}")
                let sub = interp_render_value(elem_expr, elem_ct, elem_struct)
                tfmt = tfmt.concat(sub.fmt)
                if sub.arg != "" {
                    if targ != "" { targ = targ.concat(", ") }
                    targ = targ.concat(sub.arg)
                }
                ti = ti + 1
            }
            tfmt = tfmt.concat(")")
            return InterpFrag { fmt: tfmt, arg: targ }
        }
        let disp = if sname != "" { synthesized_display_call(sname, e_str) } else { "" }
        if disp != "" {
            return InterpFrag { fmt: "%s", arg: disp }
        }
        let tag = if sname != "" { sname } else { "value" }
        return InterpFrag { fmt: "%s", arg: "\"<".concat(tag).concat(">\"") }
    }
    // CT_STRING is a genuine const char* — raw %s is correct.
    if e_type == CT_STRING {
        return InterpFrag { fmt: "%s", arg: e_str }
    }
    // Any other CT reaching here is a non-Display aggregate the typecheck gate
    // should have rejected (e.g. a List/Map/Option element inside a tuple typed
    // via an un-substituted generic typevar — E0523 fails open on typevars).
    // NEVER pass such a value to %s: that reinterprets its bytes as a char*
    // (type confusion / SIGSEGV). Emit a safe placeholder literal instead so
    // codegen can never crash on it.
    InterpFrag { fmt: "%s", arg: "\"<value>\"" }
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_interp_string(node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let parts_sl = node_elements(node)
    if parts_sl == -1 {
        expr_result_str = "\"\""
        expr_result_type = CT_STRING
        publish_result_tid(node)
        return
    }

    // Fast path: if all parts are literal, emit a simple string constant
    let mut all_literal = 1
    let mut ai = 0
    while ai < sublist_length(parts_sl) {
        let part = sublist_get(parts_sl, ai)
        let pk = node_kind(part)
        if !(pk == NodeKind.Ident && node_str_val(part) == node_name(part)) {
            all_literal = 0
        }
        ai = ai + 1
    }
    if all_literal != 0 {
        let mut concat_str = ""
        let mut ci = 0
        while ci < sublist_length(parts_sl) {
            let part = sublist_get(parts_sl, ci)
            concat_str = concat_str.concat(escape_c_string(node_str_val(part)))
            ci = ci + 1
        }
        expr_result_str = "\"".concat(concat_str).concat("\"")
        expr_result_type = CT_STRING
        publish_result_tid(node)
        return
    }

    // Slow path: build the interpolated string with blink_str_format, a
    // GC-allocating variadic helper that sizes the buffer exactly (vsnprintf
    // two-pass). Spec §2.4: interpolation is concatenation with no length cap,
    // so no fixed buffer may be used here.
    let mut fmt = ""
    let mut args = ""
    let mut has_args = 0
    let mut i = 0
    while i < sublist_length(parts_sl) {
        let part = sublist_get(parts_sl, i)
        let pk = node_kind(part)
        // Literal string parts: parser stores them as NodeKind.Ident with str_val == name
        // Expression parts: NodeKind.Ident with str_val == "" (or other node kinds)
        if pk == NodeKind.Ident && node_str_val(part) == node_name(part) {
            fmt = fmt.concat(escape_fmt_percent(escape_c_string(node_str_val(part))))
        } else {
            // Expression part
            emit_expr(part)
            let frag = interp_render_value(expr_result_str, expr_result_type, "")
            fmt = fmt.concat(frag.fmt)
            if frag.arg != "" {
                if has_args {
                    args = args.concat(", ")
                }
                args = args.concat(frag.arg)
                has_args = 1
            }
        }
        i = i + 1
    }
    if has_args {
        expr_result_str = "blink_str_format(\"".concat(fmt).concat("\", ").concat(args).concat(")")
    } else {
        expr_result_str = "blink_str_format(\"".concat(fmt).concat("\")")
    }
    expr_result_type = CT_STRING
    publish_result_tid(node)
}

fn is_raw_call(node: Int) -> Int {
    if node_kind(node) != NodeKind.Call { return 0 }
    let left = node_left(node)
    if left == -1 { return 0 }
    if node_kind(left) != NodeKind.Ident { return 0 }
    if node_name(left) != "Raw" { return 0 }
    let args_sl = node_args(node)
    if args_sl == -1 { return 0 }
    if sublist_length(args_sl) != 1 { return 0 }
    1
}

// If `arg` is a transparent-newtype variant constructor call (e.g. `Errno(rc)`),
// return the enum name (so the Option carrier can stay Option_Errno with a bare
// scalar member). Otherwise "". This must be checked BEFORE emit_expr flattens
// the constructor's expr_result_type to CT_INT (the transparent carve-out at the
// top of the Call handler), which erases the type signal the Some wrapper needs.
fn transparent_newtype_arg_enum(arg: Int) -> Str {
    if node_kind(arg) != NodeKind.Call { return "" }
    let callee = node_left(arg)
    if callee == -1 || node_kind(callee) != NodeKind.Ident { return "" }
    let variant_enum = resolve_variant(node_name(callee))
    if variant_enum != "" && is_transparent_newtype(variant_enum) != 0 {
        return variant_enum
    }
    ""
}

// Inner element NAME of a function's `Option[T]` return annotation, or "" if the
// function does not return an Option. Parallels resolve_option_inner_from_ann
// (which discards the name down to a CT const) — the Some construction path needs
// the name to keep a transparent-newtype carrier (Option_Errno) when the payload
// reaches it as a bare scalar variable rather than a literal constructor call.
fn option_inner_struct_from_fn(fn_node: Int) -> Str {
    if node_return_type(fn_node) != "Option" { return "" }
    let ta = node_type_ann(fn_node)
    if ta == -1 { return "" }
    let elems_sl = node_elements(ta)
    if elems_sl == -1 || sublist_length(elems_sl) < 1 { return "" }
    node_name(sublist_get(elems_sl, 0))
}

fn flush_template_part(tpl: Str, raw_prefix: Str, current_literal: Str) ! Codegen.Emit {
    if raw_prefix != "" {
        emit_line("blink_list_push({tpl}->parts, (void*)blink_str_format(\"%s%s\", {raw_prefix}, \"{current_literal}\"));")
    } else {
        emit_line("blink_list_push({tpl}->parts, (void*)\"{current_literal}\");")
    }
}

@allow(UnrestoredMutation, IncompleteStateRestore)
pub fn emit_template_construction(node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let parts_sl = node_elements(node)
    let tpl = fresh_temp("_tpl_")

    // Count expression parts to determine num_values (Raw() calls don't count)
    let mut num_values = 0
    if parts_sl != -1 {
        let mut ci = 0
        while ci < sublist_length(parts_sl) {
            let part = sublist_get(parts_sl, ci)
            let pk = node_kind(part)
            if !(pk == NodeKind.Ident && node_str_val(part) == node_name(part)) {
                if is_raw_call(part) == 0 {
                    num_values = num_values + 1
                }
            }
            ci = ci + 1
        }
    }

    emit_line("blink_template* {tpl} = blink_template_new({num_values});")

    if parts_sl == -1 {
        emit_line("blink_list_push({tpl}->parts, (void*)\"\");")
        expr_result_str = tpl
        expr_result_type = CT_TEMPLATE
        publish_result_tid(node)
        return
    }

    let mut current_literal = ""
    let mut raw_prefix = ""
    let mut i = 0
    while i < sublist_length(parts_sl) {
        let part = sublist_get(parts_sl, i)
        let pk = node_kind(part)
        if pk == NodeKind.Ident && node_str_val(part) == node_name(part) {
            current_literal = current_literal.concat(escape_c_string(node_str_val(part)))
        } else if is_raw_call(part) != 0 {
            // cg_current_fn_node is -1 when there is no enclosing user fn (a test
            // body, or a clean top level) — has_annotation → node_or_die(-1) would
            // exit(2). No fn means no @trusted to find, so Raw() is untrusted and the
            // warning must fire; guard the read and treat -1 as not-trusted.
            if cg_current_fn_node == -1 || has_annotation(cg_current_fn_node, "trusted") == 0 {
                diag_warn_at("RawBypassesParam", RAW_BYPASSES_PARAM, "Raw() bypasses query parameterization", part, "add @trusted(audit: \"AUDIT-ID\") to suppress")
            }
            let inner = sublist_get(node_args(part), 0)
            emit_expr(inner)
            let raw_str = expr_result_str
            let raw_type = expr_result_type
            let coerced = coerce_to_c_str(raw_str, raw_type)
            if raw_prefix != "" {
                raw_prefix = "blink_str_format(\"%s%s%s\", ".concat(raw_prefix).concat(", \"").concat(current_literal).concat("\", ").concat(coerced).concat(")")
            } else {
                raw_prefix = "blink_str_format(\"%s%s\", \"".concat(current_literal).concat("\", ").concat(coerced).concat(")")
            }
            current_literal = ""
        } else {
            flush_template_part(tpl, raw_prefix, current_literal)
            raw_prefix = ""
            current_literal = ""
            // Emit expression value
            emit_expr(part)
            let e_str = expr_result_str
            let e_type = expr_result_type
            if e_type == CT_INT {
                emit_line("blink_list_push({tpl}->values, (void*)(intptr_t){e_str});")
                emit_line("blink_list_push({tpl}->types, (void*)(intptr_t)BLINK_TPL_INT);")
            } else if e_type == CT_FLOAT {
                let ftmp = fresh_temp("_tplf_")
                emit_line("void* {ftmp}; memcpy(&{ftmp}, &(double)\{{e_str}}, sizeof(double));")
                emit_line("blink_list_push({tpl}->values, {ftmp});")
                emit_line("blink_list_push({tpl}->types, (void*)(intptr_t)BLINK_TPL_FLOAT);")
            } else if e_type == CT_BOOL {
                emit_line("blink_list_push({tpl}->values, (void*)(intptr_t){e_str});")
                emit_line("blink_list_push({tpl}->types, (void*)(intptr_t)BLINK_TPL_BOOL);")
            } else {
                emit_line("blink_list_push({tpl}->values, (void*){e_str});")
                emit_line("blink_list_push({tpl}->types, (void*)(intptr_t)BLINK_TPL_STR);")
            }
        }
        i = i + 1
    }
    flush_template_part(tpl, raw_prefix, current_literal)

    expr_result_str = tpl
    expr_result_type = CT_TEMPLATE
    publish_result_tid(node)
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_list_lit(node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let tmp = fresh_temp("_l")
    emit_line("blink_list* {tmp} = blink_list_new();")
    let elems_sl = node_elements(node)
    let mut first_elem_type = -1
    let mut first_elem_struct = ""
    let mut first_elem_str = ""
    if elems_sl != -1 {
        let mut i = 0
        while i < sublist_length(elems_sl) {
            let elem_node = sublist_get(elems_sl, i)
            if node_kind(elem_node) == NodeKind.SpreadExpr {
                emit_expr(node_value(elem_node))
                let src_str = expr_result_str
                emit_line("blink_list_extend({tmp}, {src_str});")
                if i == 0 {
                    // The OPERAND's tid is the authority here, not the flat
                    // table. get_list_elem_type/_struct below are keyed on the EMITTED C
                    // EXPRESSION STRING, which is a variable name for a variable source
                    // (hits) and a fresh temp for a CALL (misses -> -1 -> the element
                    // silently defaults to Int; a Str element then prints as a pointer).
                    // recover_list_elem_from_tid stamps the element straight onto tmp from
                    // the operand's per-node tid memo — including the CT_OPTION/CT_RESULT/
                    // CT_MAP/CT_SET deep-carrier arms, which a (ct, sname) pair could not
                    // carry across at all — and DECLINES (no stamp) when the tid cannot
                    // spell the element faithfully, which is what leaves the flat read
                    // below as the fallback rather than the authority.
                    recover_list_elem_from_tid(node_value(elem_node), tmp)
                    first_elem_type = get_list_elem_type(tmp)
                    first_elem_struct = get_list_elem_struct(tmp)
                    if first_elem_type < 0 && first_elem_struct == "" {
                        first_elem_type = get_list_elem_type(src_str)
                        first_elem_struct = get_list_elem_struct(src_str)
                    }
                }
            } else {
                // Thread the list's declared element annotation (from
                // `let xs: List[Option[T]]` via cg_let_target_ann) so a bare
                // `None`/`Ok`/`Err` element adopts the right carrier instead
                // of defaulting to blink_Option_int.
                let saved_arg_ann = cg_expect_arg_ann
                let elem_ann = list_lit_elem_ann()
                if elem_ann != -1 {
                    cg_expect_arg_ann = elem_ann
                }
                emit_expr(elem_node)
                cg_expect_arg_ann = saved_arg_ann
                let e_str = expr_result_str
                let e_type = expr_result_type
                if i == 0 {
                    let pushed_s = resolve_push_struct(e_str, tmp)
                    // An Instant/Duration element presents as (CT_STRUCT, name)
                    // here, which is the one element shape every downstream reader handles —
                    // `.get()`'s first arm, `for-in`, pop. Its own flat CT would reach none of
                    // them and the element would come back a bare int64_t. resolve_push_struct
                    // cannot answer for it: all three of its channels are keyed on a ScopeVar
                    // and the element is a call.
                    let bs_s = if pushed_s == "" { builtin_struct_name_for_ct(e_type) } else { "" }
                    first_elem_type = if bs_s != "" { CT_STRUCT } else { e_type }
                    first_elem_struct = if bs_s != "" { bs_s } else { pushed_s }
                    first_elem_str = e_str
                }
                let e_struct = resolve_push_struct(e_str, tmp)
                // For a struct literal element whose type isn't recorded on a
                // temp yet, recover its name from the StructLit node.
                let box_struct = if e_type == CT_STRUCT && e_struct == "" && node_kind(elem_node) == NodeKind.StructLit {
                    strip_module_qualifier(node_type_name(elem_node))
                } else {
                    e_struct
                }
                emit_boxed_container_store("blink_list_push({tmp}, ", e_str, e_type, box_struct, tmp)
            }
            i = i + 1
        }
    }
    if first_elem_type >= 0 {
        expr_list_elem_type = first_elem_type
    } else {
        expr_list_elem_type = -1
    }
    if first_elem_struct != "" {
        set_list_elem_type(tmp, CT_VOID)
        set_list_elem_struct(tmp, first_elem_struct)
        expr_list_elem_struct = first_elem_struct
        // get_list_elem_struct names a struct/data-enum/tuple element from the tid
        // (mono stem for a generic instance, tc_tid_tuple_sname for a tuple), so stamp
        // the List tid here for an inline/unbound literal whose temp carries none yet.
        // A non-generic struct already has its tid stamped by set_list_elem_struct above
        // (its name resolves in set_list_elem_struct_raw), so the guard makes this a
        // no-op there; the tuple and generic-instance elements are the ones it reaches.
        let lt = cg_expr_node_mono_tid(node)
        if lt >= 0 && tc_tid_ct(lt) == CT_LIST && get_var_ty(tmp) < 0 {
            set_var_ty(tmp, lt)
        }
    } else {
        expr_list_elem_struct = ""
    }
    // A Set first element carries only its own kind (CT_SET) via the
    // expr_list_elem_type global above — the LET-BINDING consumer
    // (codegen_stmt.bl) recovers the Set's OWN element by reading
    // get_list_nested_elem_type(tmp), which requires tmp to already be a
    // registered CT_LIST scope var (set_list_nested_elem_type has no push
    // fallback, unlike set_list_elem_type). Register tmp and carry the
    // element off the first element's own var, mirroring the push() fix in
    // emit_list_method.
    if first_elem_type == CT_SET {
        set_list_elem_type(tmp, CT_SET)
        let nested = get_set_elem_type(first_elem_str)
        if nested >= 0 {
            set_list_nested_elem_type(tmp, nested)
        }
    }
    expr_result_str = tmp
    expr_result_type = CT_LIST
    publish_result_tid(node)
}

fn infer_struct_type_args(type_name: Str, field_types: List[Int], field_structs: List[Str]) -> Option[Str] {
    let types_sl = node_fields(cg_program_node)
    if types_sl == -1 {
        return None
    }
    let mut td = -1
    let mut ti = 0
    while ti < sublist_length(types_sl) {
        let candidate = sublist_get(types_sl, ti)
        if node_name(candidate) == type_name {
            td = candidate
        }
        ti = ti + 1
    }
    if td == -1 {
        return None
    }
    let tparams_sl = node_type_params(td)
    if tparams_sl == -1 {
        return None
    }
    let num_params = sublist_length(tparams_sl)
    if num_params == 0 {
        return None
    }
    let td_flds_sl = node_fields(td)
    if td_flds_sl == -1 {
        return None
    }
    let mut args = ""
    let mut pi = 0
    while pi < num_params {
        let param_name = node_name(sublist_get(tparams_sl, pi))
        // "" not "Void": an unmatched param must be a DETECTABLE no-answer,
        // not a plausible-looking type name. The old initializer made every gap in the
        // arm coverage below (no CT_MAP/CT_SET case, so a Map[K,V]-typed field falls
        // straight through) silently mint blink_GKV_Void_Void — a valid C identifier
        // that compiles, links, and collides sibling instances under one typedef guard.
        // Normalized to "Void" before returning so the struct-lit chokepoint raises
        // I0001 on it, rather than enumerating every missing CT arm here.
        let mut resolved = ""
        let mut fi = 0
        while fi < sublist_length(td_flds_sl) && fi < field_types.len() {
            let f = sublist_get(td_flds_sl, fi)
            let type_ann_node = node_value(f)
            if type_ann_node != -1 {
                let ann_name = node_name(type_ann_node)
                if ann_name == param_name {
                    let fct = field_types.get(fi).unwrap()
                    let fstruct = field_structs.get(fi).unwrap()
                    // A struct/enum-instance field carries its concrete mono name
                    // (e.g. "Box_Int") captured at the literal site; type_name_from_ct
                    // has no CT_STRUCT/CT_ENUM case and would yield "Void", collapsing
                    // Box[Box[Int]] to Box_Void with a `void value;` field.
                    if (fct == CT_STRUCT || fct == CT_ENUM) && fstruct != "" {
                        resolved = fstruct
                    } else {
                        resolved = type_arg_name_from_ct(fct)
                    }
                } else {
                    let sub_elems = node_elements(type_ann_node)
                    if sub_elems != -1 {
                        let mut si = 0
                        while si < sublist_length(sub_elems) {
                            let sub_ann = sublist_get(sub_elems, si)
                            if node_name(sub_ann) == param_name {
                                let ft = field_types.get(fi).unwrap()
                                if ft == CT_OPTION {
                                    resolved = type_arg_name_from_ct(expr_option_inner)
                                } else if ft == CT_RESULT {
                                    if si == 0 {
                                        resolved = type_arg_name_from_ct(expr_result_ok_type)
                                    } else {
                                        resolved = type_arg_name_from_ct(expr_result_err_type)
                                    }
                                }
                            }
                            si = si + 1
                        }
                    }
                }
            }
            fi = fi + 1
        }
        // An unmatched param still occupies its CSV slot, so the segment count stays
        // equal to num_params and mono_args_has_void_seg can see it — I0001 at the
        // literal, never a half-spelled mono name. Returning None here instead would
        // leave mono_args "" and fall through to the bare `blink_W`, a typedef never
        // declared for a generic struct (a location-less C `unknown type name`).
        //
        // DEFENSIVE, not load-bearing on any known input: for every phantom/unspellable
        // shape probed (`type W[T] { n: Int }`, a scalar-only twin, and a matched-but-
        // unspellable `a: T` bound to Option[Int]), tid_native_struct_mono already
        // declines (the erased segment is an ICE_SEG_ERASED_SLOT sentinel, not the
        // string "Void") and this function is never consulted — I0001 fires identically
        // with or without this normalization. Kept because the None path is not provably
        // unreachable and its failure mode is an undiagnosed C error.
        //
        // Normalizes to the erasure SENTINEL, not to "Void": conflating the two would make
        // a hand-written `Box[Void]` indistinguishable from an unresolved slot and get it
        // refused as if its slot had never been resolved.
        if resolved == "" {
            resolved = ICE_SEG_ERASED_SLOT
        }
        if pi > 0 {
            args = args.concat(",")
        }
        args = args.concat(resolved)
        pi = pi + 1
    }
    Some(args)
}

// Tid-native mono-args for a struct literal whose concrete inner is a COMPOUND
// carrier (`Box[Option[Int]]`), the shape the string path (struct_concrete_args_from_target
// bail + infer_struct_type_args' compound-blind bare-typevar branch) collapses to
// "Void". Reads the instance tid typecheck memoized on the literal node
// (tc_struct_lit_instance_tid) and lowers each slot via tc_tid_to_c_tag —
// Option[Int] → "Option_int", byte-identical to the
// blink_Option_int typedef the field value emits.
//
// Returns "" (defer to the string path, unchanged) unless the instance is a concrete
// same-base struct AND at least one slot is a faithful compound-of-scalar AND every
// slot is either a plain scalar or a faithful compound. A struct-INSTANCE slot
// (`Box[Box[Int]]`) or a compound-of-struct slot keeps the string path authoritative
// (tc_tid_to_c_tag would erase their inner). The at-least-one-compound guard confines
// the change to the previously-broken shapes: a pure-scalar instance keeps its exact
// current string output (byte-identity for every working shape).
// The struct-INSTANCE tid backing a struct literal, resolved with the same
// precedence tid_native_struct_mono uses so a caller filling parallel
// arg_tids agrees byte-for-byte on which instance was named. Prefer the
// enclosing annotation's instance tid (`let oi: Box[Option[Int]]`) over the
// literal's own reverse-inferred tid: a bare `None` / `Ok(x)` field value infers
// the compound inner as UNKNOWN (Box[Option[?]]), but the annotation names the
// concrete inner. resolve_type_ann memoized the concrete Box[Option[Int]]
// instance onto the annotation node (tc_produce_struct_instance_tid).
// cg_expect_arg_ann wins when it names this struct (a call-arg position);
// otherwise cg_let_target_ann. Falls back to the literal node's own tid.
// Returns -1 when no memoized tid names this struct.
// cg_fa_receiver_ctx suppresses the ann-based branch entirely while
// resolving a literal's OWN identity in FieldAccess receiver position — there,
// both channels describe the RESULT of the access (one nesting level too high)
// and a same-named bare match would wrongly adopt it. emit_struct_lit suspends
// the flag around every nested recursive emission, so this only ever narrows
// the receiver literal's own top-level resolution, never anything nested inside it.
fn tid_native_struct_inst_tid(node: Int, sname: Str) -> Int {
    let mut inst_tid = -1
    if !cg_fa_receiver_ctx {
        if cg_expect_arg_ann != -1 && strip_module_qualifier(node_name(cg_expect_arg_ann)) == sname {
            inst_tid = tc_lookup_node_tid(cg_expect_arg_ann)
        } else if cg_let_target_ann != -1 && strip_module_qualifier(node_name(cg_let_target_ann)) == sname {
            inst_tid = tc_lookup_node_tid(cg_let_target_ann)
        }
    }
    if inst_tid < 0 || tc_tid_struct(inst_tid) != sname {
        inst_tid = tc_lookup_node_tid(node)
    }
    if inst_tid < 0 { return -1 }
    if tc_tid_struct(inst_tid) != sname { return -1 }
    inst_tid
}

// The mono-args CSV for a struct-INSTANCE tid, spelled through tc_tid_to_c_tag.
// Extracted so there is exactly ONE speller: a caller that compares two instances
// (or a trace that reports what this path WOULD have answered) cannot read a
// different lens than the path that returns the name.
fn tid_instance_mono_args_csv(inst_tid: Int, count: Int) -> Str {
    let mut args = ""
    let mut j = 0
    while j < count {
        if j > 0 { args = args.concat(",") }
        args = args.concat(tc_tid_to_c_tag(tc_tid_struct_arg_tid(inst_tid, j)))
        j = j + 1
    }
    args
}

// The two outputs of the tid-native monomorphization tier, returned together so a
// caller cannot read the CSV from the substituted instance while recovering slot tids
// from the raw one. `inst_tid` is the RAW instance tid unless the
// substituted retry is what produced a non-empty `csv`.
type TidNativeMono {
    csv: Str,
    inst_tid: Int
}

fn tid_native_struct_mono_slots(inst_tid: Int, sname: Str, tracing: Int) -> Str {
    let count = tc_tid_struct_arg_count(inst_tid)
    if count < 1 {
        if tracing != 0 { dbg_trace("retmono", "sname={sname} inst_tid={inst_tid} decline=bare_base count={count}") }
        return ""
    }
    // ONE PREDICATE PER SLOT: tc_struct_slot_encodable is the sole admission gate,
    // answering "can this tier spell this slot the same way the string path did?"
    // for every slot. The parallel arg_tids recovery (mono_instance_arg_tids_from_tid)
    // gates on this same function, so the CSV lens and the arg_tids lens can never
    // diverge on what they consider encodable.
    //
    // tc_tid_resolved FIRST is mandatory: a metavar bound IN PLACE by
    // tc_pin_generic_args_from_binds keeps kind TyKind.Unknown until resolved, so a raw
    // read would call an already-concrete slot unencodable.
    //
    // The predicate admits scalars, sized ints, struct/enum (bare, instance, or
    // module-qualified), Option/Result/Tuple/Map/Set/List over encodable inners, and
    // TyKind.Void — a genuine Void is an ordinary inhabited encodable type (DECISIONS.md:342,
    // decisions/under-determined-types.md:38-42). The residual decline is exactly
    // !tc_struct_slot_encodable = typevar / unknown / iterator / handle / channel / fn,
    // i.e. genuinely unspellable.
    //
    // TRAP for anyone widening this further: do NOT reach for the slot's CT. tk_to_ct maps
    // TyKind.Void, TyKind.Typevar, TyKind.Unknown and TyKind.Fn all onto CT_VOID, so a
    // CT-keyed gate would admit unsolved metavars as if they were Void. The predicate
    // must key on the KIND, not the CT.
    let mut i = 0
    while i < count {
        let slot = tc_tid_struct_arg_tid(inst_tid, i)
        if !tc_struct_slot_encodable(tc_tid_resolved(slot)) {
            // The single decline. Report the slot's own kind-ish view, because the slot is
            // the whole diagnosis: an unencodable slot is a still-unsubstituted typevar, an
            // unsolved metavar, or an iterator/handle/channel/fn the encoder has no
            // faithful segment for.
            if tracing != 0 { dbg_trace("retmono", "sname={sname} inst_tid={inst_tid} slot={slot} idx={i} decline=slot_unencodable ct={tc_tid_ct(slot)}") }
            return ""
        }
        i = i + 1
    }
    let csv = tid_instance_mono_args_csv(inst_tid, count)
    // The tid outranks the string CSV when the two disagree on a struct-instance
    // slot's spelling (e.g. a type alias vs. its underlying type): there is no
    // separate nesting-level check here, because the field loop in emit_struct_lit
    // already retargets cg_let_target_ann/cg_expect_arg_ann to each field's OWN
    // annotation before recursing into a nested literal.
    if tracing != 0 { dbg_trace("retmono", "sname={sname} inst_tid={inst_tid} count={count} admit=slot_encodable csv={csv}") }
    csv
}

// The tid-native tier. Classifies the instance tid the literal's value context names;
// on a decline, RETRIES against that tid with the enclosing monomorphized generic's
// binders substituted away, which is what lets `GT[(T, Int)]` inside
// `fn wrap[T]` be spelled as GT_Tuple2_int_int.
//
// Ordered retry-after-decline, not substitute-first, so every shape a tier already
// answers keeps its exact current output: tc_tid_subst_mono is a no-op outside a mono
// body and on any tid with no typevar, so the retry only runs where the raw pass had
// already given up.
fn tid_native_struct_mono(node: Int, sname: Str) -> TidNativeMono {
    let raw = tid_native_struct_inst_tid(node, sname)
    // Gated on dbg_channel_on, per ast.bl's note and the kopsctor tap above: the
    // message is interpolated EAGERLY, and this runs at every struct literal in every
    // compiled program (the compiler's own bootstrap included), so the gate is what
    // keeps the string building out of an untraced build.
    //
    // What the gate no longer buys is avoided COMPUTATION. Every tap here reports
    // tid_native_struct_mono_slots' own return value, computed whether or not
    // anyone is tracing.
    let tracing = dbg_channel_on("retmono")
    // Which of this tier's several declines a caller actually hit. The two that look
    // alike from outside — "no instance tid names this struct" (raw < 0 / count < 1,
    // i.e. the memo holds only the BARE base) versus "the instance is concrete but one
    // slot is unencodable" — produce the identical observable, an I0001 spelling the
    // string path's answer. Distinguishing them is the difference between a typecheck
    // memo bug and a tc_struct_slot_encodable gap to close in the producer, and it is
    // not inferable from the ICE text.
    if raw < 0 {
        if tracing != 0 { dbg_trace("retmono", "sname={sname} decline=no_inst_tid") }
        return TidNativeMono { csv: "", inst_tid: raw }
    }
    let csv = tid_native_struct_mono_slots(raw, sname, tracing)
    if csv != "" { return TidNativeMono { csv: csv, inst_tid: raw } }
    // cg_fn_mono_tparams_sl/cg_fn_mono_arg_tids, NOT cg_mono_tparams_sl/cg_mono_arg_tids:
    // this retry recovers the binders of the ENCLOSING GENERIC FUNCTION currently being
    // emitted. The latter pair gets transiently swapped by this same function's OWN
    // field-loop below (and by any enclosing struct literal's field loop we are nested
    // inside) to the CONTAINING STRUCT's tparams, for resolving bare-binder field ctors.
    // When a struct's own declared tparam shares a name with the enclosing fn's tparam
    // (`type Box[T]` built inside `fn mk[T]`), substituting against the swapped pair
    // resolves "T" against Box's bind instead of mk's, and a nested Box-in-Box literal
    // silently inherits the outer instance's tid.
    let sub = tc_tid_subst_mono(raw, cg_fn_mono_tparams_sl, cg_fn_mono_arg_tids)
    if sub != raw && sub >= 0 {
        if tracing != 0 { dbg_trace("retmono", "sname={sname} raw={raw} sub={sub} retry=mono_subst") }
        let sub_csv = tid_native_struct_mono_slots(sub, sname, tracing)
        if sub_csv != "" { return TidNativeMono { csv: sub_csv, inst_tid: sub } }
    }
    TidNativeMono { csv: "", inst_tid: raw }
}

// Recover the per-slot arg tids for a struct-INSTANCE tid, gated on
// tc_struct_slot_encodable exactly like register_struct_instance_from_tid
// (in codegen.bl): an encodable scalar / bare struct slot carries its real
// tid, an unencodable slot (struct-instance, module-qualified, typevar) stores -1.
// Returns [] unless the tid names `expected_base` with exactly `expected_count`
// args, so a mismatched or absent memoized tid yields nothing rather than
// half-lowering a mismatched instance.
//
// A -1 slot used to mean "the def side will read the string CSV instead"; that
// resolver is gone, so a -1 now genuinely means UNKNOWN and the def side
// spells the binder through — a hard `cc` error, not a silent erasure. The one
// producer that cannot compute tids at all routes around this via MonoInstance.ann
// (see mono_arg_tids_with_ann in codegen_stmt), which calls back into this fn.
pub fn mono_instance_arg_tids_from_tid(inst_tid: Int, expected_base: Str, expected_count: Int) -> List[Int] {
    let mut out: List[Int] = []
    if inst_tid < 0 { return out }
    if tc_tid_struct(inst_tid) != expected_base { return out }
    let count = tc_tid_struct_arg_count(inst_tid)
    if count != expected_count { return out }
    let mut i = 0
    while i < count {
        // RESOLVED, matching the gate in tid_native_struct_mono_slots above: a metavar
        // that tc_pin_generic_args_from_binds bound IN PLACE keeps kind TyKind.Unknown and
        // stashes its solution in inner1, so a raw read calls the slot unencodable and
        // stores -1 — sending the def side back to the string CSV for a slot the
        // mono_args half already spelled concretely. Resolving here is the identity on
        // everything that is not a bound metavar, so only that shape changes.
        let slot = tc_tid_resolved(tc_tid_struct_arg_tid(inst_tid, i))
        if tc_struct_slot_encodable(slot) {
            out.push(slot)
        } else {
            out.push(-1)
        }
        i = i + 1
    }
    out
}

// Register the mono instance for a generic-enum construction (`Branch(Leaf(1),…)`)
// and return its mono C-name STEM (`Tree_Int`), so ctor/match can emit the mono
// typedef name (blink_Tree_Int) instead of the erased bare `Tree`. Reads the
// enum-instance tid typecheck memoized onto the construction node (tc_lookup_node_tid);
// returns "" (defer to the bare path) when the node carries no concretely-encodable
// generic-enum instance. Mirrors register_enum_instance_from_tid but lives here to
// avoid a codegen_expr→codegen_stmt import cycle. `expected_base` guards against a
// mismatched memoized tid — the registered instance must name this variant's enum.
pub fn register_mono_enum_from_node(node: Int, expected_base: Str) -> Str ! Codegen.Register {
    register_mono_enum_from_tid(tc_lookup_node_tid(node), expected_base)
}

// A nullary variant constructor (`LL.Nil`) carries only the bare enum on its own
// node — infer_type returns the base enum, not the instance — so its concrete args
// live on the let/arg annotation. Read that channel when the node tid is bare so the
// mono instance registers and the cast spells the stem, matching the Call form.
pub fn register_mono_enum_from_ann(node: Int, expected_base: Str) -> Str ! Codegen.Register {
    register_mono_enum_from_tid(tid_native_struct_inst_tid(node, expected_base), expected_base)
}

fn register_mono_enum_from_tid(inst_tid: Int, expected_base: Str) -> Str ! Codegen.Register {
    if inst_tid < 0 { return "" }
    if tc_tid_is_enum(inst_tid) == 0 { return "" }
    if tc_tid_struct(inst_tid) != expected_base { return "" }
    let count = tc_tid_struct_arg_count(inst_tid)
    if count < 1 { return "" }
    // Require the whole instance to spell concretely (mono name non-empty) — an
    // unencodable slot (an unsubstituted typevar) keeps the bare path.
    if tc_tid_struct_mono_name(inst_tid) == "" { return "" }
    let mut args = ""
    let mut arg_tids: List[Int] = []
    let mut i = 0
    while i < count {
        let slot = tc_tid_struct_arg_tid(inst_tid, i)
        let mut seg = ""
        if tc_tid_struct_arg_count(slot) >= 1 {
            seg = tc_tid_struct_mono_name(slot)
        } else {
            seg = tc_tid_struct_slot_seg(slot)
        }
        if seg == "" { return "" }
        if i > 0 { args = args.concat(",") }
        args = args.concat(seg)
        if tc_struct_slot_encodable(slot) {
            arg_tids.push(slot)
        } else {
            arg_tids.push(-1)
        }
        i = i + 1
    }
    register_mono_instance(expected_base, args, arg_tids)
}

// Whether any per-tparam segment of a mono-args CSV names an ERASED slot. Two
// spellings qualify, and both are equally fatal:
//
//   a BLINK_I0001_* SENTINEL — what every producer that could not name a slot now
//           writes. The tripwire "must key on the *kind*, not the
//           resulting \"Void\" tag, so a genuine GKV[Void, Void] is unaffected"
//           (DECISIONS.md:342). Void is "an ordinary INHABITED, encodable type"
//           (decisions/under-determined-types.md:39), so a segment reading "Void" is
//           now a legitimate answer and this predicate must say false to it — see the
//           two polarity rows in tests/test_hsgsbp_void_vs_erasure.bl.
//   a BINDER of this very struct ("T") — what the tid producers leave behind when
//           tc_seg_from_tid declines a slot and the name passes through unchanged.
//           `blink_Box_T` is just as valid a C identifier as `blink_Box_Void`, and
//           collapses sibling instantiations exactly the same way. It also emits a
//           `void` field, so it usually surfaces as an inscrutable C error rather
//           than a compiler diagnostic — worse than the ICE.
//
// Checked per DECLARED tparam (via nth_type_arg, the same naive comma split the rest
// of the mono machinery uses) rather than as a substring, so a sentinel appearing inside
// some non-tparam position can't trip it. A user type that genuinely SHARES a name with a binder (`type Box[T]` alongside
// `type T {..}`, so `Box[T]` is concrete) is excluded by the is_struct_or_enum_type
// check. Returns false when the struct declares no tparams — a monomorphic struct's
// mono_args is not a type-param CSV at all.
// `pub` FOR THE TEST ONLY — its single non-test caller is emit_struct_lit's chokepoint just
// below. Same precedent as resolve_mono_slot (src/codegen_stmt.bl): the predicate's two
// polarities (a sentinel is fatal, a genuine "Void" is NOT) are the whole point of this
// function, and no Blink program in the corpus reaches the fatal one, so a unit row driving it
// directly is the only positive test available.
pub fn mono_args_has_void_seg(mono_args: Str, tparams_sl: Int) -> Bool {
    if tparams_sl == -1 { return false }
    let count = sublist_length(tparams_sl)
    if count < 1 { return false }
    let mut i = 0
    while i < count {
        let seg = nth_type_arg(mono_args, i)
        // A string test inside a change whose whole point is to stop keying on a type
        // NAME. That is deliberate and is not a precedent: BLINK_I0001_ is a
        // mangler-internal prefix that no producer writes for any other purpose, so this
        // tests for a marker the compiler itself wrote, not for a type the user named.
        // (It is not literally unspellable — see src/diagnostics.bl.)
        //
        // NOT tested here: seg == "". A bare empty segment mangles to `blink_Box_`, which is
        // valid C and silent — the same failure class — but a generic base whose mono_args is
        // legitimately empty reaches this loop too (the "memo holds only the bare base" state
        // the retmono channel reports), so arming it needs the measurement pass first rather
        // than a guess. Tracked separately.
        if diag_is_ice_seg(seg) { return true }
        if tparams_sl_contains(tparams_sl, seg) != 0 && is_struct_or_enum_type(seg) == 0 {
            return true
        }
        i = i + 1
    }
    false
}

// Whether `name` is one of the declared type-params in tparams_sl — i.e. still an
// unresolved typevar after type-param resolution (the caller is generic).
pub fn tparams_sl_contains(tparams_sl: Int, name: Str) -> Int {
    if tparams_sl == -1 { return 0 }
    let mut i = 0
    while i < sublist_length(tparams_sl) {
        if node_name(sublist_get(tparams_sl, i)) == name { return 1 }
        i = i + 1
    }
    0
}

// Register the mono instance for a generic Map's value/key struct at the generic-fn
// call tail. The Map-return branch computes the value-struct NAME
// (Box_Int) but, without this, never registers a mono instance for it — so the
// struct typedef is never emitted, struct_reg_set lacks it, and
// emit_struct_option_typedef falls through to `void* value`. register_mono_instance
// dedups on (phys_base, args), so this is byte-neutral when the body already
// registered the same instance.
//
// ANNOTATED branch: build mono_args the SAME way mono_name_from_ann does (the
// annotation's elements through resolve_tparam_seg), so the registered c_name
// byte-matches the map_ret_val_struct name the annotated branch already published.
// Skips when the type has no tparams / the annotation has no elements / an arg is
// still an unresolved typevar (a caller that itself is generic — the pure-generic
// caller edge is out of scope, tracked separately). arg_tids come off the return
// tid's matching slot so encodable slots lower off tids.
fn register_map_elem_struct_mono(base: Str, ann: Int, tparams_sl: Int, slot_tid: Int, fn_arg_tids: List[Int]) ! Codegen.Register {
    let td = find_type_def_node(base)
    if td == -1 { return }
    let td_tparams = node_type_params(td)
    if td_tparams == -1 || sublist_length(td_tparams) == 0 { return }
    if ann == -1 { return }
    let elems = node_elements(ann)
    if elems == -1 || sublist_length(elems) == 0 { return }
    // Per-element concrete tids off the slot instance, hoisted above the loop so
    // each arg resolves tid-first (byte-identical to the CSV segment mangling used
    // for every encodable slot) and reuse the same list for the
    // register_mono_instance call below. arg_tids is aligned to the ANNOTATION's
    // arg positions, so resolve by element index (resolve_arg_seg_via_slot_tid),
    // NOT by type-param position.
    let mut arg_tids = mono_instance_arg_tids_from_tid(slot_tid, base, sublist_length(elems))
    // A generic-fn return `-> Map[Str, Box[T]]` erases its value slot to the bare
    // base `Box` at annotation time (tc_produce_struct_instance_tid skips an
    // all-typevar instance per the interning rule), so slot_tid is the bare base and
    // the recovery above returns [] — the def-side then has no tid for the slot.
    // Recover each element's tid from the fn-level binds instead: an
    // element that is a bare tparam (`Box[T]` → `T`) resolves to fn_arg_tids[pi], the
    // concrete tid inference bound for that tparam. This mirrors resolve_tparam_via_tid,
    // so an encodable slot carries a real tid and a non-tparam / unencodable element
    // stays -1 — passing that element's name through unchanged, which is what the
    // pre-tid CSV also spelled (per-slot parity is enforced inline by
    // resolve_arg_seg_via_slot_tid; see the note above the register call below).
    if arg_tids.len() == 0 {
        let mut recovered: List[Int] = []
        let mut ri = 0
        while ri < sublist_length(elems) {
            recovered.push(map_elem_tparam_tid(node_name(sublist_get(elems, ri)), tparams_sl, fn_arg_tids))
            ri = ri + 1
        }
        arg_tids = recovered
    }
    let mut mono_args = ""
    let mut ai = 0
    while ai < sublist_length(elems) {
        let elem = sublist_get(elems, ai)
        let resolved_arg = resolve_arg_seg_via_slot_tid(ai, node_name(elem), arg_tids)
        // An arg still spelled as a declared type-param means the caller is itself
        // generic (no concrete binding here); registering would produce a bogus
        // typevar-named instance. Defer instead.
        if tparams_sl_contains(tparams_sl, resolved_arg) != 0 { return }
        if ai > 0 { mono_args = mono_args.concat(",") }
        mono_args = mono_args.concat(resolved_arg)
        ai = ai + 1
    }
    // Per-slot parity is enforced INLINE: resolve_arg_seg_via_slot_tid (above) spells each
    // slot from tc_seg_from_tid(arg_tids[ai]) when the recovered tid is encodable, and
    // passes the element name through otherwise. Since tc_seg_from_tid reproduces the CSV
    // segment mangling used for every encodable slot (the regen-enforced invariant),
    // mono_args equals the CSV string byte-for-byte and every stored tid already
    // agrees with the segment it produced. mono_args is DERIVED from arg_tids here, so
    // there is no independent CSV to cross-check against.
    register_mono_instance(base, mono_args, arg_tids)
}

// The concrete tid an annotation element resolves to under a fn's tparam binds: when
// `elem_name` is a declared type-param (`Box[T]` → element `T`), its fn-level bound
// tid (fn_arg_tids[pi]); else -1 (a non-tparam element like a nested compound, whose
// tid the caller recovers structurally or leaves to the string seg). Mirrors the
// tparam-name → arg_tids[pi] lookup in resolve_tparam_via_tid.
fn map_elem_tparam_tid(elem_name: Str, tparams_sl: Int, fn_arg_tids: List[Int]) -> Int {
    if tparams_sl == -1 { return -1 }
    let mut pi = 0
    while pi < sublist_length(tparams_sl) {
        if node_name(sublist_get(tparams_sl, pi)) == elem_name {
            if pi < fn_arg_tids.len() {
                return fn_arg_tids.get(pi).unwrap()
            }
            return -1
        }
        pi = pi + 1
    }
    -1
}

// Register the mono instance for a generic Map's value/key struct off the raw slot
// tid (the bare-typevar `-> T` branch). The slot tid carries the full
// concrete instance shape, so the args CSV is built via tc_tid_struct_slot_seg —
// byte-identical to how tc_tid_struct_mono_name (which produced the published
// map_ret_val_struct name) spells each slot. A nested instance slot (Box[Box[Int]])
// is registered RECURSIVELY first so its typedef precedes the outer that embeds it,
// mirroring register_struct_instance_from_tid (codegen.bl) — that superset lives in
// codegen.bl, above this module in the import graph, so it can't be shared without a
// cycle. A non-instance slot (scalar value, bare generic
// base, absent tid) has arg_count 0 → no-op.
pub fn register_map_elem_struct_mono_from_tid(slot_tid: Int) ! Codegen.Register {
    let _name = register_map_elem_struct_mono_from_tid_named(slot_tid)
}

// Shared tier selector for a generic Map return's key/value struct name+registration
// used by BOTH the annotated arm and the bare-typevar arm of
// emit_generic_fn_call_tail's CT_MAP branch, for both the value and the key slot.
//
// Tier order: tid (dry-walk, then register) -> annotation -> bare-head fallback.
// Tier 1's name is map_elem_struct_mono_walk's OWN return, never
// tc_tid_map_val_struct/tc_tid_map_key_struct — those can answer a bare-head name
// that LOOKS like a full stem even when the tid can't actually spell one, which
// would split the published name from the registered instance. The selector's
// own walk is the registrar, so they can't diverge.
//
// `ann`/`ann_base` are -1/"" from the bare-typevar arm (no annotation to fall back
// to there); the annotated arm passes its resolved element name and node.
fn map_elem_mono_selector(slot_tid: Int, ann_base: Str, ann: Int, tparams_sl: Int, fn_arg_tids: List[Int], segs: List[Str]) -> Str ! Codegen.Register {
    let tid_name = map_elem_struct_mono_walk(slot_tid, 0)
    if tid_name != "" {
        let _reg = map_elem_struct_mono_walk(slot_tid, 1)
        return tid_name
    }
    if ann != -1 && ann_base != "" {
        let ann_name = mono_name_from_ann(ann_base, ann, tparams_sl, segs)
        if ann_name != "" {
            register_map_elem_struct_mono(ann_base, ann, tparams_sl, slot_tid, fn_arg_tids)
            return ann_name
        }
    }
    if ann_base != "" { return ann_base }
    tc_tid_struct(slot_tid)
}

// Walks a struct-instance slot (and its nested instances, inner-first) and RETURNS
// its mono name — the CSV segment a parent embeds. A nested instance slot
// (Box[Box[Int]]) recurses so the inner typedef precedes the outer that embeds it,
// mirroring register_struct_instance_from_tid (codegen.bl); that superset lives
// above this module in the import graph, so it can't be shared without a cycle.
// Returns "" for an unencodable/non-instance slot (scalar,
// bare generic base, typevar, module-qualified) so the parent bails identically to
// the def-side string path.
//
// `do_register` toggles whether a REAL instance is registered on the way back up
// (1) or the name is only computed (0). The recursion registers inner instances
// before the caller's own `seg == ""` check can decline, so a second,
// independently-written pure predicate would be two lenses on one question — the
// exact failure mode tid_native_struct_mono_slots' own comment above warns
// against. A dry run (do_register=0) answers "would this tier
// spell it" through the SAME walk that registers, so the published name and the
// registered instance can never disagree.
fn map_elem_struct_mono_walk(slot_tid: Int, do_register: Int) -> Str ! Codegen.Register {
    if slot_tid < 0 { return "" }
    let base = tc_tid_struct(slot_tid)
    if base == "" { return "" }
    let count = tc_tid_struct_arg_count(slot_tid)
    if count < 1 { return "" }
    let mut mono_args = ""
    let mut i = 0
    while i < count {
        let slot = tc_tid_struct_arg_tid(slot_tid, i)
        let seg = if tc_tid_struct_arg_count(slot) >= 1 {
            map_elem_struct_mono_walk(slot, do_register)
        } else {
            tc_tid_struct_slot_seg(slot)
        }
        if seg == "" { return "" }
        // A bare ICE_SEG_* sentinel must not be concatenated mid-identifier, which
        // would bury it past diag_is_ice_seg's prefix test. Decline to the next
        // tier instead — an existing I0001 chokepoint elsewhere is the reporter.
        if diag_is_ice_seg(seg) { return "" }
        if i > 0 { mono_args = mono_args.concat(",") }
        mono_args = mono_args.concat(seg)
        i = i + 1
    }
    if do_register != 0 {
        let arg_tids = mono_instance_arg_tids_from_tid(slot_tid, base, count)
        return register_mono_instance(base, mono_args, arg_tids)
    }
    mangle_generic_name(mono_phys_base(base), mono_args)
}

fn register_map_elem_struct_mono_from_tid_named(slot_tid: Int) -> Str ! Codegen.Register {
    map_elem_struct_mono_walk(slot_tid, 1)
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_struct_lit(node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let raw_sname = node_type_name(node)
    let sname = strip_module_qualifier(raw_sname)

    // raw_sname contains a dot when this is Enum.Variant { ... }; sname is the variant name only.
    // A BARE name (no dot) may still be a struct-style enum-variant construction — resolve_variant
    // maps it to its enum. We take the tagged-union path for both qualified and resolvable-bare
    // variants so bare and qualified emit byte-identical C; otherwise a bare variant would fall
    // through to a plain struct initializer below (wrong output).
    let dot_pos = raw_sname.index_of(".")
    let resolved_variant = resolve_variant(sname)
    if dot_pos >= 0 || resolved_variant != "" {
        // The QUALIFIER WINS. resolve_variant is a global variant-name -> enum
        // map, so for a name shared by two enums it answers whichever was declared first;
        // preferring it made `Right.Item { v: 2 }` emit a blink_Left, silently, and
        // 03_types.md:1063 says "No path ever silently picks a winner". 03_types.md:1040
        // rule 1 makes the prefix authoritative when the site is written `Enum.Variant`.
        // Only fall back to the global map when the prefix does not name an enum carrying
        // this variant — that keeps the module-qualified struct literal (`mod.Type { .. }`,
        // prefix is a module) falling through to the plain-struct path below, and keeps a
        // qualified name whose enum lacks the variant behaving exactly as before.
        let qual_enum = if dot_pos >= 0 { raw_sname.substr(0, dot_pos) } else { "" }
        let variant_enum = if qual_enum != "" && get_variant_index(qual_enum, sname) >= 0 {
            qual_enum
        } else {
            if resolved_variant != "" { resolved_variant } else { qual_enum }
        }
        let vidx = get_variant_index(variant_enum, sname)
        if variant_enum != "" && is_data_enum(variant_enum) != 0 && vidx >= 0 {
            let tag = get_variant_tag(variant_enum, sname)
            let flds_sl_sv = node_fields(node)
            // A generic-enum struct-style ctor (`First { value: 42 }` → Choice[Int,Str])
            // mono's to blink_Choice_Int_Str, mirroring the call-style paths. Without
            // this the struct-lit path emitted the erased bare enum (blink_Choice) —
            // undeclared for a generic enum. "" (non-generic) keeps bare.
            let node_mono = register_mono_enum_from_node(node, variant_enum)
            let mono_name = if node_mono != "" { node_mono } else { register_mono_enum_from_ann(node, variant_enum) }
            let enum_type_name = if mono_name != "" { mono_name } else { variant_enum }
            let enum_c_name = c_type_c_name(enum_type_name)
            // Resolve this variant's field-def sublist so bare `None` fields
            // adopt their declared Option[T] carrier instead of defaulting to
            // Option[int]. node_fields(vnode) is the same shape
            // struct_field_type_ann consumes in typecheck.bl.
            let enum_td = find_type_def_node(variant_enum)
            let mut variant_flds = -1
            let enum_tparams = if enum_td != -1 { node_type_params(enum_td) } else { -1 }
            if enum_td != -1 {
                let variants_sl = node_fields(enum_td)
                if variants_sl != -1 {
                    let mut vj = 0
                    while vj < sublist_length(variants_sl) {
                        let vnode = sublist_get(variants_sl, vj)
                        if node_name(vnode) == sname {
                            variant_flds = node_fields(vnode)
                            break
                        }
                        vj = vj + 1
                    }
                }
            }
            let mut init_str = "({enum_c_name})\{.tag = {tag}"
            if flds_sl_sv != -1 && sublist_length(flds_sl_sv) > 0 {
                init_str = init_str.concat(", .data.{sname} = \{")
                let mut fi = 0
                while fi < sublist_length(flds_sl_sv) {
                    if fi > 0 {
                        init_str = init_str.concat(", ")
                    }
                    let sf = sublist_get(flds_sl_sv, fi)
                    let field_name = node_name(sf)
                    // Retarget the value-context channels to the variant field's
                    // annotation, under the same spellability asymmetry as the
                    // sibling struct-field loop below; leaving one of two sibling loops
                    // unretargeted is the "partial lens" pattern this file's tid-authority
                    // comments elsewhere exist to stop.
                    // The binder descent keys on the ENUM (variant_enum + the enum's own
                    // tparams), not on the variant: a value-context annotation for a
                    // struct-style variant literal spells `Choice[Int,Str]`, i.e. it names
                    // the enum, and the binders a variant field can mention are the enum's.
                    let vf_ann = field_ann_at_instance(variant_flds, enum_tparams, variant_enum, field_name)
                    let saved_arg_ann = cg_expect_arg_ann
                    let saved_let_ann = cg_let_target_ann
                    cg_expect_arg_ann = vf_ann
                    if value_ctx_ann_spellable(vf_ann) != 0 { cg_let_target_ann = vf_ann }
                    // This nested emission is not the receiver's own identity
                    // resolution, so it must see normal ann-eligible semantics even when
                    // the enclosing enum-variant literal itself sits in receiver position.
                    let saved_fa_ctx_vf = cg_fa_receiver_ctx
                    cg_fa_receiver_ctx = false
                    emit_expr(node_value(sf))
                    cg_fa_receiver_ctx = saved_fa_ctx_vf
                    cg_expect_arg_ann = saved_arg_ann
                    cg_let_target_ann = saved_let_ann
                    let arg_str = expr_result_str
                    let field_type = get_variant_field_type_str(vidx, fi)
                    // strip_generic_args so a self-referential generic-enum variant
                    // (`Branch(Tree[T], Tree[T])`) heap-boxes its recursive payload
                    // (field_type "Tree[T]" vs enum "Tree"), matching the bare-Call
                    // and qualified paths. Without it the recursive field emits inline
                    // into an int64_t pointer slot — a C type error.
                    if field_type.is_some() && strip_generic_args(field_type.unwrap()) == variant_enum {
                        let box_tmp = fresh_temp("_ebox")
                        emit_line("{enum_c_name}* {box_tmp} = ({enum_c_name}*)blink_alloc(sizeof({enum_c_name}));")
                        emit_line("*{box_tmp} = {arg_str};")
                        init_str = init_str.concat(".{field_name} = (int64_t)(intptr_t){box_tmp}")
                    } else if tc_variant_field_is_selfrec_tuple(variant_enum, sname, field_name) != 0 {
                        // Self-recursive tuple field (`Pair { p: (Box[T], Box[T]) }`): the
                        // union member is a boxed int64_t, so heap-copy the tuple and store
                        // its pointer. Mirrors the positional qualified/bare ctor paths.
                        let val_tmp = fresh_temp("_tval")
                        let box_tmp = fresh_temp("_tbox")
                        emit_line("__typeof__({arg_str}) {val_tmp} = {arg_str};")
                        emit_line("__typeof__({val_tmp})* {box_tmp} = blink_alloc(sizeof({val_tmp}));")
                        emit_line("*{box_tmp} = {val_tmp};")
                        init_str = init_str.concat(".{field_name} = (int64_t)(intptr_t){box_tmp}")
                    } else {
                        init_str = init_str.concat(".{field_name} = {arg_str}")
                    }
                    fi = fi + 1
                }
                init_str = init_str.concat("}")
            }
            init_str = init_str.concat("}")
            expr_result_str = init_str
            expr_result_type = CT_STRUCT
            publish_result_tid(node)
            set_var_struct(init_str, enum_type_name)
            return
        }
    }

    let mut c_type = c_type_c_name(sname)
    let tmp = fresh_temp("_s")
    let flds_sl = node_fields(node)
    let td = find_type_def_node(sname)
    let td_flds = if td != -1 { node_fields(td) } else { -1 }
    // When the enclosing `let` target names this struct with concrete type
    // arguments (`let b: GKV[Int, Str] = ..`), push them as the mono context for
    // the duration of the field loop. A container field built from an empty
    // ctor (`m: Map()`) has no field VALUE to infer its element type from, so
    // resolve_ctor_kops_elem would see the field's key/elem typevar unresolved
    // and fall to the string kops default → int keys hashed as strings collide.
    // With the struct's tparams bound here, resolution maps K→Int
    // at the ctor and the right kops vtable is selected. (No-op when the target
    // isn't annotated; the field-value inference below still runs as fallback.)
    let target_args = struct_concrete_args_from_target(sname, segs_from_arg_tids(cg_mono_arg_tids))
    // Hoisted above the field loop because the field-loop mono context below needs it
    // too. Reads only the memoized instance tid plus cg_expect_arg_ann /
    // cg_let_target_ann, and the field loop save/restores BOTH channels per field,
    // so evaluating it here is identical to evaluating it at the mono_args selector.
    // Both outputs of the tid-native tier together: when the mono-context substitution
    // retry is what answered, the CSV is spelled from the SUBSTITUTED instance tid, and
    // every slot-tid recovery below must read that same tid or the instance gets the
    // right name over a wrong kops vtable.
    let tid_native = tid_native_struct_mono(node, sname)
    let tid_native_args = tid_native.csv
    // Computed HERE, before cg_mono_arg_tids is cleared below: it reads the ENCLOSING
    // fn's mono context, not this literal's.
    let ret_ann_tids = struct_ret_ann_arg_tids(sname, node)
    let td_tparams = if td != -1 { node_type_params(td) } else { -1 }
    // THE selector for this literal's monomorphization, named ONCE and read at both
    // sites below — the field-loop mono context and the mono-NAME selector. They are one
    // decision seen from two sides: a CSV/inst_tid split between them names the instance
    // one way while resolving its field ctors another — a correct mono name over a wrong
    // kops vtable, clean `cc`, wrong at runtime.
    //
    // THE TID IS AUTHORITATIVE. Whenever the tid-native tier can spell this
    // instance it wins outright; the string target is the fallback for what the tid
    // cannot name. This is step 4 of decisions/compiler-type-representation.md:99-105
    // ("remove writes to old fields; type_id is authoritative") at this seam.
    //
    // The polarity is only HALF the change, and on its own it would have been a provable
    // no-op: measured over the 734-file corpus at Stage 0, there was not one site where
    // both tiers could answer (N_both == 0). The tiers partitioned the population because
    // tid_native_struct_mono_slots implemented the SAME polarity a second time, internally,
    // by vetoing its own has_ret_target admission whenever a string target was in scope.
    // Dropping that veto (see the admission block in tid_native_struct_mono_slots) is what
    // gives this selector anything to decide, which is why the two land together.
    let tid_wins = tid_native_args != ""
    // The string tier's own guard, unchanged. Still needed as the SECOND tier: a generic
    // struct whose args the tid cannot spell is still named off the annotation.
    let string_target_wins = target_args != "" && td_tparams != -1 && sublist_length(td_tparams) > 0
    let saved_mono_tparams = cg_mono_tparams_sl
    // Struct-lit field emission derives its mono context from the string target
    // args — the ENCLOSING fn's cg_mono_arg_tids (a stale tid list keyed on the
    // enclosing generic's tparams) must not leak into a ctor/compound-inner site
    // reached during the field loop, so we never keep it. When the target names
    // this struct's concrete tparams (target_args != ""), recover THIS instance's
    // own slot tids off the memoized annotation tid and install them alongside the
    // struct's tparams, so a container-field ctor (`Set[T]` where T→Int) resolves
    // its element via the structured tid (resolve_tparam_via_tid) — closing a
    // SetField/MapField/GKV capture gap. An absent /
    // base-mismatched / arity-mismatched tid still yields [] (that is
    // mono_instance_arg_tids_from_tid's own contract), which is the
    // unconditional clear.
    let saved_mono_arg_tids = cg_mono_arg_tids
    cg_mono_arg_tids = []
    // Which spelling of this instance's args the field loop resolves against. The
    // string target args when they exist; otherwise the tid-native namer.
    // struct_concrete_args_from_target bails on EVERY compound annotation arg by
    // design (node_name flattens `(Int, Int)` to the bare head "Tuple"), so a tuple
    // type arg reached the field loop with no mono context at all: the `s: Set()`
    // ctor saw T unresolved and fell to blink_kops_str for a tuple key. That is a
    // silent-hash miscompile wearing a CORRECT mono name — fixing the mono-name half
    // (tc_tid_compound_slot_faithful's TyKind.Tuple arm) does not fix it, which is why
    // test_fqthkv_generic_tuple_slot_mono.bl asserts the runtime round-trip and not
    // just the name.
    let field_ctx_args = if tid_wins { tid_native_args } else { target_args }
    if field_ctx_args != "" && td_tparams != -1 && sublist_length(td_tparams) > 0 {
        cg_mono_tparams_sl = td_tparams
        // Read the tid the tid-native tier actually spelled from, but ONLY when that
        // tier is what supplied field_ctx_args. When the string target answered
        // (target_args != "") this must stay the raw tid: a substituted tid there would
        // start carrying real slot tids where the recovery previously stored -1, which
        // changes emitted C for shapes that already work. tid_native.inst_tid IS the raw
        // tid whenever the substitution retry did not win, so this is byte-identical
        // outside the newly-answered shapes.
        //
        // Installed UNCONDITIONALLY: no parity veto against field_ctx_args. On the
        // tid_wins arm that would be CIRCULAR — field_ctx_args is tid_native_args,
        // spelled from this same inst_tid through the same tc_tid_to_c_tag, so the
        // two can never disagree — and on the string arm the tid is authoritative
        // when it and a string-chosen CSV disagree, so a divergence there is an
        // aliased spelling to accept, not a second opinion to reject.
        let inst_tid = if tid_wins { tid_native.inst_tid } else { tid_native_struct_inst_tid(node, sname) }
        cg_mono_arg_tids = mono_instance_arg_tids_from_tid(inst_tid, sname, tc_tid_struct_arg_count(inst_tid))
    } else if ret_ann_tids.len() > 0 {
        // Last tier: the enclosing fn's return annotation. Only reached when
        // neither the value context nor the memoized instance tid could name this literal
        // — i.e. exactly the def-side body of a monomorphized generic fn, whose alternative
        // is the I0001 at the mono chokepoint below.
        //
        // Installed DIRECTLY, not re-derived through mono_instance_arg_tids_from_tid: that
        // recovery reads the literal's own memoized instance tid, which in this body still
        // holds the unsolved binder — the very reason we are in this branch. The tids here
        // came from the enclosing mono context, which is already concrete, and the CSV the
        // selector spells below comes from these same tids, so name and vtable cannot split.
        //
        // field_ctx_args is deliberately NOT updated: this branch is only reached when it
        // is "". Here the tids ARE the source and the CSV is derived from them.
        cg_mono_tparams_sl = td_tparams
        cg_mono_arg_tids = ret_ann_tids
    }
    let mut inits = ""
    let mut field_types: List[Int] = []
    let mut field_structs: List[Str] = []
    let mut provided_fields: List[Str] = []
    let mut _init_count = 0
    let mut spread_tmp = ""
    if flds_sl != -1 {
        let mut i = 0
        while i < sublist_length(flds_sl) {
            let sf = sublist_get(flds_sl, i)
            if node_kind(sf) == NodeKind.SpreadExpr {
                // NOT retargeted, and deliberately not cleared either. A spread
                // source is a WHOLE-STRUCT value of THIS struct's type, so an enclosing
                // annotation naming this struct is the annotation that correctly describes
                // it — the one case where the adoption the retarget exists to stop is not an
                // adoption at all. Clearing to -1 would throw that away and buy nothing:
                // every corpus spread source is an Ident, which reads no annotation channel.
                // tests/test_htxpmh_field_loop_value_ctx.bl row 9 pins the Ident case.
                // Suspended for the same reason as the field-value and
                // defaults sites below — this is a nested emission, not this literal's
                // own receiver-position identity resolution.
                let saved_fa_ctx_spread = cg_fa_receiver_ctx
                cg_fa_receiver_ctx = false
                emit_expr(node_value(sf))
                cg_fa_receiver_ctx = saved_fa_ctx_spread
                spread_tmp = expr_result_str
                i = i + 1
                continue
            }
            let fname = node_name(sf)
            provided_fields.push(fname)
            // THE FIELD-ANNOTATION RETARGET. Both value-context channels move to the field's own
            // annotation for the nested emission, because the consumers read them under
            // DIFFERENT rules and cg_expect_arg_ann alone cannot shadow cg_let_target_ann:
            // tid_native_struct_inst_tid matches either channel by BARE STRUCT NAME (so a
            // nested literal of the same struct adopted the outer instance's type args),
            // resolve_ptr_inner_c reads cg_let_target_ann with NO name gate at all, and
            // emit_tuple_lit's parent_tuple_ann / the Some-carrier consult gate on the head
            // name plus arity, which a sibling instantiation satisfies. emit_tuple_lit
            // already retargets both per slot; this brings the struct-field loop to parity.
            //
            // Via field_ann_at_instance, so a field declared as a bare binder (`value: T`)
            // retargets to the type argument THIS instantiation gives it rather than to the
            // information-free binder node — the descent is what makes the retarget
            // level-correct instead of merely level-shifted. See that function.
            //
            // The two channels are gated ASYMMETRICALLY: cg_let_target_ann moves only when
            // the resolved annotation is spellable end to end, because its consumers read a
            // binder as no-information and fall back to a default instead of to the
            // annotation they would have read. See value_ctx_ann_spellable for the two
            // measured shapes where writing a binder here is worse than writing nothing.
            let f_ann = field_ann_at_instance(td_flds, td_tparams, sname, fname)
            let saved_arg_ann = cg_expect_arg_ann
            let saved_let_ann = cg_let_target_ann
            cg_expect_arg_ann = f_ann
            if value_ctx_ann_spellable(f_ann) != 0 { cg_let_target_ann = f_ann }
            // A field VALUE nested inside a receiver-position literal is not
            // that literal's own identity resolution — suspend so it gets normal
            // ann-eligible semantics (needed e.g. for a nested Set()/Map() ctor's kops).
            let saved_fa_ctx_fv = cg_fa_receiver_ctx
            cg_fa_receiver_ctx = false
            emit_expr(node_value(sf))
            cg_fa_receiver_ctx = saved_fa_ctx_fv
            cg_expect_arg_ann = saved_arg_ann
            cg_let_target_ann = saved_let_ann
            let mut val_str = expr_result_str
            // A genuine Void field value (e.g.
            // `Holder { v: nothing() }` where `v: Void`) is `void`-valued in
            // C -- `.v = blink_u_nothing()` is an illegal void initializer.
            // Discard it as a statement first, same two-signal guard as
            // emit_let_binding (codegen_stmt.bl), and substitute the int64_t
            // placeholder into the designated initializer.
            if expr_result_type == CT_VOID && tc_tid_to_c_tag(tc_lookup_node_tid(node_value(sf))) == "Void" {
                if val_str != "" && val_str != "0" {
                    emit_line("(void){val_str};")
                }
                val_str = "0"
            }
            field_types.push(expr_result_type)
            // Capture the struct-instance's already-registered mono name (e.g.
            // "Box_Int") so a struct-valued generic field infers its concrete
            // inner instead of collapsing to type_name_from_ct(CT_STRUCT)="Void".
            // Reuses the exact string the field's own literal
            // registered via set_var_struct, so no re-spelling divergence.
            if expr_result_type == CT_STRUCT {
                field_structs.push(get_var_struct(val_str))
            } else {
                field_structs.push("")
            }
            if _init_count > 0 {
                inits = inits.concat(", ")
            }
            inits = inits.concat(".{fname} = {val_str}")
            _init_count = _init_count + 1
            i = i + 1
        }
    }
    if spread_tmp != "" {
        // The spread source is a whole-struct value of THIS struct's type, and its
        // own registered name IS the mono instance whose fields we copy (Box_Int for
        // a generic, Box for a non-generic). sf_entries rows for a generic instance
        // are keyed under that mono name, not the bare `sname` the literal carries,
        // so match the source's name and fall back to sname only when it is unset.
        let spread_src_sname = get_var_struct(spread_tmp)
        let spread_match = if spread_src_sname != "" { spread_src_sname } else { sname }
        let mut si = 0
        while si < sf_entries.len() {
            let sfe = sf_entries.get(si).unwrap()
            if sfe.struct_name == spread_match {
                let mut found = 0
                let mut pi = 0
                while pi < provided_fields.len() {
                    if provided_fields.get(pi).unwrap() == sfe.field_name {
                        found = 1
                        break
                    }
                    pi = pi + 1
                }
                if found == 0 {
                    if _init_count > 0 {
                        inits = inits.concat(", ")
                    }
                    inits = inits.concat(".{sfe.field_name} = {spread_tmp}.{sfe.field_name}")
                    provided_fields.push(sfe.field_name)
                    field_types.push(sfe.field_type)
                    if sfe.field_type == CT_STRUCT {
                        field_structs.push(sfe.stype)
                    } else {
                        field_structs.push("")
                    }
                    _init_count = _init_count + 1
                }
            }
            si = si + 1
        }
    }
    let mut di = 0
    while di < struct_field_defaults.len() {
        let dfl = struct_field_defaults.get(di).unwrap()
        if dfl.struct_name == sname {
            let mut found = 0
            let mut pi = 0
            while pi < provided_fields.len() {
                if provided_fields.get(pi).unwrap() == dfl.field_name {
                    found = 1
                    break
                }
                pi = pi + 1
            }
            if found == 0 {
                // Retarget. This is the strongest of the sites:
                // dfl.default_node belongs to the TYPE DEFINITION, not to any use site, so
                // ANY enclosing value-context annotation is categorically wrong here. Same
                // spellability asymmetry as the field loop — an unspellable answer leaves
                // cg_let_target_ann alone rather than replacing it with a binder.
                let dfl_ann = field_ann_at_instance(td_flds, td_tparams, sname, dfl.field_name)
                let saved_dfl_arg_ann = cg_expect_arg_ann
                let saved_dfl_let_ann = cg_let_target_ann
                cg_expect_arg_ann = dfl_ann
                if value_ctx_ann_spellable(dfl_ann) != 0 { cg_let_target_ann = dfl_ann }
                // Same suspension as the field-value site — a default value
                // belongs to the type definition, not to this literal's own identity.
                let saved_fa_ctx_dfl = cg_fa_receiver_ctx
                cg_fa_receiver_ctx = false
                emit_expr(dfl.default_node)
                cg_fa_receiver_ctx = saved_fa_ctx_dfl
                cg_expect_arg_ann = saved_dfl_arg_ann
                cg_let_target_ann = saved_dfl_let_ann
                let mut dval = expr_result_str
                // Same genuine-Void guard as the provided-field loop above --
                // a Void-typed field's default value node is just as
                // `void`-valued in C.
                if expr_result_type == CT_VOID && tc_tid_to_c_tag(tc_lookup_node_tid(dfl.default_node)) == "Void" {
                    if dval != "" && dval != "0" {
                        emit_line("(void){dval};")
                    }
                    dval = "0"
                }
                field_types.push(expr_result_type)
                if expr_result_type == CT_STRUCT {
                    field_structs.push(get_var_struct(dval))
                } else {
                    field_structs.push("")
                }
                if _init_count > 0 {
                    inits = inits.concat(", ")
                }
                inits = inits.concat(".{dfl.field_name} = {dval}")
                _init_count = _init_count + 1
            }
        }
        di = di + 1
    }
    cg_mono_tparams_sl = saved_mono_tparams
    cg_mono_arg_tids = saved_mono_arg_tids
    // The declared let-target args are authoritative when present (they name the
    // instantiation directly); field-VALUE inference is the fallback for an
    // unannotated `let b = GKV { .. }`. Preferring target_args also lets an empty
    // container field (Map()/Set()) monomorphize the struct — register_mono_field_types
    // then records the field's concrete key/value type so per-op recovery agrees
    // with the ctor's kops choice.
    let mut mono_args = ""
    // Parallel to mono_args: the concrete arg tids for this instance, filled only
    // when the tid-native branch below wins (the string branches leave it [] and
    // the def-side emitter falls back to the string seg). Gated on
    // tc_struct_slot_encodable — an unencodable slot stores -1.
    let mut mono_arg_tids: List[Int] = []
    // TIER ORDER, highest first: tid-native → string target → field-value inference →
    // enclosing-fn return annotation.
    if tid_wins {
        // Tid-native path won: recover the parallel slot tids off the SAME instance tid
        // it resolved, so the def-side typedef emitter can lower off tids for the
        // encodable slots. tid_native.inst_tid is that tid — the raw one unless the
        // mono-context substitution retry is what produced this CSV.
        mono_args = tid_native_args
        mono_arg_tids = mono_instance_arg_tids_from_tid(tid_native.inst_tid, sname, tc_tid_struct_arg_count(tid_native.inst_tid))
    } else if string_target_wins {
        mono_args = target_args
    } else {
        // A compound-valued generic field (`Box[Option[Int]]`) is lost by both string
        // seams (struct_concrete_args_from_target bails on a compound annotation arg;
        // infer_struct_type_args' bare-typevar-field branch has no compound case →
        // "Void"), which is why the tid tier above outranks them both.
        // This tier only runs after both higher tiers have declined, and in practice
        // it is a near-total no-op: the rare Some it does produce goes through the
        // pre-existing CT_STRUCT/fstruct or scalar type_arg_name_from_ct arms, never
        // through CT_MAP/CT_SET/CT_LIST. A compound-valued field that reaches here
        // falls through to ICE_SEG_ERASED_SLOT, which the I0001 chokepoint below
        // reports correctly, so leaving the compound arms unimplemented is not a
        // correctness gap. The function stays: the CT_STRUCT/scalar hits are real,
        // so it is not dead code.
        let type_args = infer_struct_type_args(sname, field_types, field_structs)
        if type_args.is_some() {
            dbg_trace("sta4ak9ff", "sname={sname} some=1 val={type_args.unwrap()}")
        } else {
            dbg_trace("sta4ak9ff", "sname={sname} some=0 val=<none>")
        }
        if type_args.is_some() { mono_args = type_args.unwrap() }
        // LAST, and only after field-value inference declined or erased.
        // Ordered here so this tier can never displace an answer another producer
        // reached — the alternative it replaces is the I0001 below, never a name.
        // mono_args_has_void_seg is the same predicate the chokepoint uses, so
        // "inference erased a slot" is decided by one rule, not two.
        if ret_ann_tids.len() > 0 {
            if mono_args == "" || mono_args_has_void_seg(mono_args, td_tparams) {
                mono_args = struct_mono_from_fn_ret_ann(ret_ann_tids)
                mono_arg_tids = ret_ann_tids
            }
        }
    }
    // Class-A recovery: the string branches (target_args and
    // infer_struct_type_args) leave mono_arg_tids [], so register_mono_instance
    // captures an empty arg_tids list and every def-side resolve_tparam_via_tid for
    // this instance has no tid to lower from. Recover the parallel slot tids off the
    // construction node's memoized instance tid — the SAME call the tid-native branch
    // above already makes. mono_instance_arg_tids_from_tid is a strict superset: it
    // returns [] when the memoized tid is absent / base-mismatched / arity-mismatched
    // (degrading to exactly today's empty-list fallback, byte-identical) and stores -1
    // per unencodable slot; only provably-encodable scalar/struct-instance slots start
    // carrying real tids so arg_tids can key the def-side tid lowering.
    if mono_args != "" && mono_arg_tids.len() == 0 {
        let inst_tid = tid_native_struct_inst_tid(node, sname)
        // Installed UNCONDITIONALLY: the tid is authoritative, so a divergence
        // between the recovered tid and mono_args is never treated as a contradiction
        // to arbitrate. tid_native_struct_inst_tid matches an outer let/arg annotation
        // by BARE struct name, so this must run after emit_struct_lit's field loop has
        // already retargeted cg_let_target_ann/cg_expect_arg_ann to the field's own
        // annotation — otherwise a nested inner literal (`Box{value:42}` inside a
        // `let b: Box[Box[Int]]`) could recover the OUTER instance's tid by matching
        // the outer annotation's bare name instead of its own.
        mono_arg_tids = mono_instance_arg_tids_from_tid(inst_tid, sname, tc_tid_struct_arg_count(inst_tid))
    }
    let mut struct_key = sname
    if mono_args != "" {
        // I0001 chokepoint. Every generic-struct literal's mono name funnels
        // through here, so this is where an unsolved type param becomes observable —
        // and the one place that already carries Diag.Report, so raising the ICE needs
        // no effect threading through the 85+ resolve_tparam_via_tid callers.
        //
        // A BLINK_I0001_* segment is never a legitimate answer for a declared type param:
        // it means some producer erased a slot it could not spell. Spelling the erasure as
        // this sentinel, rather than as "Void", keeps an erased slot from producing a
        // VALID C identifier (blink_GKV_Void_Void) that would compile and link while
        // silently collapsing sibling instances onto one typedef — and lets a GENUINE
        // `Box[Void]` still compile, per DECISIONS.md:342 (6-0): the tripwire keys on the
        // KIND, so a real GKV[Void, Void] is unaffected. Fail loudly on the sentinel
        // instead: "ice" severity bypasses @allow and blinkc exits 101 before writing any
        // C. The front end should have reported CannotInferType (E0301) first if the
        // program were genuinely under-determined; reaching here means it did not, so
        // this is a compiler bug, not a user error.
        if mono_args_has_void_seg(mono_args, td_tparams) {
            diag_ice_at("UnsolvedTypeVarAtCodegen", UNSOLVED_TYPEVAR_AT_CODEGEN,
                "type parameter of '{sname}' reached monomorphization unsolved (mono args '{mono_args}')",
                node,
                "this is a compiler bug — the type should have been inferred, or reported as error[CannotInferType]")
        }
        let mono_name = register_mono_instance(sname, mono_args, mono_arg_tids)
        c_type = c_type_c_name(mono_name)
        struct_key = mono_name
        register_mono_field_types(sname, mono_name, mono_arg_tids, node)
    }
    emit_line("{c_type} {tmp} = \{ {inits} };")
    set_var_struct(tmp, struct_key)
    // Carry the literal's tid so sv_struct_tid_first recovers the generic mono
    // instance from the tid, not the flat sname. Gate on the reader's exact
    // mono-name round-trip, so a tid that names a different instance keeps the
    // flat spelling instead of borrowing a mismatched carrier.
    let lit_tid = cg_expr_node_mono_tid(node)
    if lit_tid >= 0 && tc_tid_struct_mono_name(cg_bind_mono_tid(lit_tid)) == struct_key {
        set_var_ty(tmp, lit_tid)
    }
    let mut ii = 0
    while ii < struct_invariants.len() {
        let inv = struct_invariants.get(ii).unwrap()
        if inv.struct_name == sname {
            let old_self = cg_where_self_var
            cg_where_self_var = tmp
            emit_expr(inv.expr_node)
            let inv_cond = expr_result_str
            emit_line("if (!({inv_cond})) \{ fprintf(stderr, \"invariant violated: @invariant on %s\\n\", \"{sname}\"); exit(1); }")
            cg_where_self_var = old_self
        }
        ii = ii + 1
    }
    expr_result_str = tmp
    expr_result_type = CT_STRUCT
    publish_result_tid(node)
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_tuple_lit(node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let elems_sl = node_elements(node)
    if elems_sl == -1 {
        expr_result_str = "0"
        expr_result_type = CT_VOID
        publish_result_tid(node)
        return
    }
    let arity = sublist_length(elems_sl)

    // Plumb per-slot Option[T] target into the fn-level channels: fn return is
    // Tuple (not Option), so cg_current_fn_option_inner stays 0 and a bare None
    // slot would default to Option[int]. Derive parent ann from let-target or
    // fn return-ann; per-slot override drives the bare-None branch in emit_expr.
    let mut parent_elems_sl: Int = -1
    let mut parent_tuple_ann: Int = -1
    if cg_let_target_ann != -1 && node_name(cg_let_target_ann) == "Tuple" {
        let cand = node_elements(cg_let_target_ann)
        if cand != -1 && sublist_length(cand) == arity {
            parent_elems_sl = cand
            parent_tuple_ann = cg_let_target_ann
        }
    }
    if parent_elems_sl == -1 && cg_current_fn_node != -1 && node_return_type(cg_current_fn_node) == "Tuple" {
        let ret_ann = node_type_ann(cg_current_fn_node)
        if ret_ann != -1 {
            let cand = node_elements(ret_ann)
            if cand != -1 && sublist_length(cand) == arity {
                parent_elems_sl = cand
                parent_tuple_ann = ret_ann
            }
        }
    }

    let saved_fn_option_inner = cg_current_fn_option_inner
    let saved_fn_option_inner_struct = cg_current_fn_option_inner_struct
    let mut val_strs: List[Str] = []
    let mut val_types: List[Int] = []
    let mut val_structs: List[Str] = []
    let mut val_compound_tags: List[Str] = []
    let mut i = 0
    while i < arity {
        cg_current_fn_option_inner = saved_fn_option_inner
        cg_current_fn_option_inner_struct = saved_fn_option_inner_struct
        if parent_elems_sl != -1 {
            let slot_ann = sublist_get(parent_elems_sl, i)
            if node_name(slot_ann) == "Option" {
                let slot_inner_elems = node_elements(slot_ann)
                if slot_inner_elems != -1 && sublist_length(slot_inner_elems) >= 1 {
                    let inner_ann = sublist_get(slot_inner_elems, 0)
                    let inner_name = node_name(inner_ann)
                    if is_named_typedef_tag(inner_name) != 0 {
                        cg_current_fn_option_inner = CT_INT
                        cg_current_fn_option_inner_struct = inner_name
                    } else {
                        cg_current_fn_option_inner = type_from_name(inner_name)
                        cg_current_fn_option_inner_struct = ""
                    }
                }
            }
        }
        let saved_arg_ann = cg_expect_arg_ann
        // A nested-tuple slot literal reads its own C type from cg_let_target_ann.
        // Retarget it to the slot annotation for the recursion so the inner literal
        // resolves to the inner tuple type, not the still-live OUTER let target
        // (which coincidentally shares arity). Mirrors the Ok/Err payload retarget
        // above. Restore both channels after.
        let saved_let_ann = cg_let_target_ann
        if parent_elems_sl != -1 {
            let slot_ann = sublist_get(parent_elems_sl, i)
            cg_expect_arg_ann = slot_ann
            // Promote to cg_let_target_ann for a compound slot too. The
            // Some/Ok/Err constructor derives its STRUCTURED value carrier from
            // cg_let_target_ann (the annotation consult), so a
            // Some(m)/Ok(m) whose inner is a Map or nested compound must see the slot
            // annotation on THAT channel — else it falls to compound_option_inner_name's
            // bare "map" and the value carrier (blink_Option_map) diverges from the
            // structured tuple field (blink_Option_Map_str_int) minted below. Tuple
            // slots were already promoted for the same reason (nested-tuple carrier).
            let slot_nm = node_name(slot_ann)
            if slot_nm == "Tuple" || slot_nm == "Option" || slot_nm == "Result" {
                cg_let_target_ann = slot_ann
            }
        }
        emit_expr(sublist_get(elems_sl, i))
        cg_expect_arg_ann = saved_arg_ann
        cg_let_target_ann = saved_let_ann
        val_strs.push(expr_result_str)
        val_types.push(expr_result_type)
        let mut sn = get_var_struct(expr_result_str)
        if sn == "" {
            sn = get_var_enum(expr_result_str)
        }
        let elem_tid = tc_lookup_node_tid(sublist_get(elems_sl, i))
        // The value path must ride the tid-structured spelling EXACTLY when the typecheck
        // gate (tc_tid_tuple_elem_faithful) says the generic-fn mono will — otherwise the
        // value-constructed tuple and the mono param diverge → void-erased param. Consult
        // the SAME predicate so the two paths can never drift: an Option carrier
        // over a Map or nested faithful compound rides; a Result carrier with a DIRECT Map
        // inner (the upgrade_compound_carrier assignment-compat carve-out) and any
        // struct/enum leaf stay on the string CSV. Only meaningful for a compound carrier.
        let elem_rides_tid = elem_tid >= 0 && is_compound_ct(expr_result_type) != 0 && tc_tid_tuple_elem_faithful(elem_tid)
        // For a BARE-VAR compound-carrier element (`let a: Option[Map[Str,Int]] = ...;
        // (a, 7)`), get_var_struct returns the carrier's INNER struct tag (Map_str_int),
        // NOT the carrier — so it would drop the Option/Result wrapper and win over the
        // structured ctag below. When the element rides the tid path, clear sn so the
        // tid-driven ctag path spells the full carrier (Option_Map_str_int). A deferred
        // element keeps its sn and rides the string CSV — no regression.
        if sn != "" && elem_rides_tid { sn = "" }
        // A by-value struct/enum leaf whose value is a bare call-expr has no scope-var
        // binding, so get_var_struct/get_var_enum spell nothing and the element erases to
        // a "void" field. c_type_tag has no arm for a dedicated-ctype struct (Instant is
        // CT_INSTANT, not CT_STRUCT) and defaults to "void" — a module-qualified element
        // (std.time.Instant) hits this. The ctype is the wrong authority; recover the name
        // from the element tid, the SAME speller the tid path uses (tid_tuple_elem_enc's
        // struct/enum arm): tc_tid_inner_tag gives the single-prefix tag / mono stem. Fires
        // only when the value path gave nothing, so a generic instance the value path
        // already named (Box_0Int) is untouched; tc_tid_struct != "" excludes compound
        // carriers (handled by the ctag path above) and transparent newtypes are declined.
        if sn == "" && elem_tid >= 0 && is_compound_ct(expr_result_type) == 0 {
            let rtid = tc_tid_resolved(elem_tid)
            if tc_tid_struct(rtid) != "" {
                let stag = tc_tid_inner_tag(rtid)
                if stag != "" && !diag_is_ice_seg(stag) && is_transparent_newtype(stag) == 0 { sn = stag }
            }
        }
        val_structs.push(sn)
        let mut ctag = ""
        // The memoized element tid is the structured recursion source: it exists for
        // every node (infer_type memoizes tc_node_tid) and is byte-identical to the tid
        // path by construction. For an Option/Result carrier whose inner is itself a
        // compound (a Map, or a nested Option/Result over faithful leaves), the flat
        // c_type_tag below spells only ONE level (bare "map"/"option"/"result") and would
        // diverge from the tid path (tc_tid_inner_tag recurses) → void-erased mono param.
        // When the element RIDES the tid path (elem_rides_tid = tc_tid_tuple_elem_faithful,
        // the SAME gate the generic-fn mono consults), spell the inner structurally via
        // tc_tid_inner_tag — the SAME speller the tid path uses. Otherwise fall through to
        // the existing one-level spelling (defends un-memoized nodes, deferred cases:
        // struct/enum inners, the Result-direct-Map carve-out → still ride the string CSV).
        // Reads only the tid — no scope or expr_* globals — so the kops-sensitive CT_MAP
        // arm below is untouched. Reconciles the value path with the tid/annotation
        // majority in lockstep with the typecheck gate.
        if sn == "" && is_compound_ct(expr_result_type) != 0 {
            if expr_result_type == CT_OPTION {
                if elem_rides_tid && tc_tid_ct(elem_tid) == CT_OPTION {
                    // Collapse, never interpolate: tc_tid_inner_tag can
                    // answer a bare ICE_SEG_* sentinel; embedding it in "Option_{...}"
                    // would hide it from diag_is_ice_seg's prefix test at the mono-CSV
                    // chokepoints downstream.
                    let inner = tc_tid_inner_tag(tc_tid_option_inner_tid(elem_tid))
                    ctag = if diag_is_ice_seg(inner) { inner } else { "Option_{inner}" }
                } else {
                    let inner_tag = if expr_option_inner_struct != "" { canonical_struct_tag(expr_option_inner_struct) } else { c_type_tag(expr_option_inner) }
                    ctag = "Option_{inner_tag}"
                }
            } else if expr_result_type == CT_RESULT {
                if elem_rides_tid && tc_tid_ct(elem_tid) == CT_RESULT {
                    // Collapse, never interpolate — same rule as the
                    // Option arm above.
                    let ok = tc_tid_inner_tag(tc_tid_result_ok_tid(elem_tid))
                    let err = tc_tid_inner_tag(tc_tid_result_err_tid(elem_tid))
                    ctag = if diag_is_ice_seg(ok) { ok } else if diag_is_ice_seg(err) { err } else { "Result_{ok}_{err}" }
                } else {
                    let ok_tag = if expr_result_ok_struct != "" { canonical_struct_tag(expr_result_ok_struct) } else { c_type_tag(expr_result_ok_type) }
                    let err_tag = if expr_result_err_struct != "" { canonical_struct_tag(expr_result_err_struct) } else { c_type_tag(expr_result_err_type) }
                    ctag = "Result_{ok_tag}_{err_tag}"
                }
            }
            // A Map element sets no ctag on purpose: Map is an erased carrier stored by
            // POINTER (blink_map*), not a by-value carrier like Option/Result. It rides the
            // scalar branch below (tag "map" via c_type_tag, elem_struct "-"), so the field
            // lowers through c_field_type_str(CT_MAP) → blink_map* — matching List/Set and
            // the annotation path (resolve_tuple_ann's scalar arm). K/V come from the tid.
        }
        val_compound_tags.push(ctag)
        i = i + 1
    }
    let mut tags = ""
    let mut elem_types_enc = ""
    let mut elem_structs_enc = ""
    let mut elem_names_enc = ""
    let mut inits = ""
    i = 0
    while i < arity {
        if i > 0 {
            tags = tags.concat("_")
            elem_types_enc = elem_types_enc.concat(",")
            elem_structs_enc = elem_structs_enc.concat(",")
            elem_names_enc = elem_names_enc.concat(",")
            inits = inits.concat(", ")
        }
        let vs = val_structs.get(i).unwrap()
        let ctag = val_compound_tags.get(i).unwrap()
        let vt = val_types.get(i).unwrap()
        if vs != "" {
            tags = tags.concat(vs)
            elem_structs_enc = elem_structs_enc.concat(vs)
        } else if ctag != "" {
            tags = tags.concat(ctag)
            elem_structs_enc = elem_structs_enc.concat(ctag)
        } else {
            tags = tags.concat(c_type_tag(vt))
            elem_structs_enc = elem_structs_enc.concat("-")
            // Unlike a mono struct field's erased T, this element is a fresh,
            // directly-typechecked sub-expression of the literal itself — CT_VOID
            // here can only mean a genuinely Void value, never an erased unknown,
            // so it's always safe to name it.
            if vt == CT_VOID {
                elem_names_enc = elem_names_enc.concat("Void")
            }
        }
        elem_types_enc = elem_types_enc.concat("{vt}")
        inits = inits.concat("._{i} = {val_strs.get(i).unwrap()}")
        i = i + 1
    }
    cg_current_fn_option_inner = saved_fn_option_inner
    cg_current_fn_option_inner_struct = saved_fn_option_inner_struct
    // Prefer the canonical tuple name from the parent annotation so Option[T]'s
    // T is preserved; the per-element value tags drop it (get_var_struct returns
    // the inner struct for an Option-typed var), yielding e.g. Tuple2_Model_Cmd
    // with a bare-Cmd field. The inits stay valid — only
    // the type name + field tags now come from the annotation.
    let mut tup_name = ""
    if parent_tuple_ann != -1 {
        let tup_opt = resolve_tuple_ann(parent_tuple_ann, cg_mono_tparams_sl, segs_from_arg_tids(cg_mono_arg_tids))
        if tup_opt.is_some() { tup_name = tup_opt.unwrap() }
    }
    if tup_name == "" {
        tup_name = tuple_c_type_name(tags, arity)
        ensure_tuple_type(tup_name, arity, elem_types_enc, elem_structs_enc, elem_names_enc)
    }
    let tmp = fresh_temp("_tup")
    emit_line("{c_type_c_name(tup_name)} {tmp} = \{ {inits} };")
    set_var_struct(tmp, tup_name)
    // Carry the literal's tid so sv_struct_tid_first recovers the tuple carrier from
    // the tid, not the flat sname. Gate on the reader's exact round-trip: stamp only
    // when the tid names the SAME registered carrier the flat write spells, so a
    // module-qualified element (where resolve_tuple_ann and tc_tid_tuple_sname can
    // diverge) keeps its flat spelling instead of borrowing a mismatched tag.
    let tup_tid = cg_expr_node_mono_tid(node)
    if tup_tid >= 0 && find_tuple_entry(tup_name) >= 0 && tc_tid_tuple_sname(cg_bind_mono_tid(tup_tid)) == tup_name {
        set_var_ty(tmp, tup_tid)
    }
    expr_result_str = tmp
    expr_result_type = CT_STRUCT
    publish_result_tid(node)
}
