// Arg offset for trait-qualified builtin calls: MapOps.contains_key(m, k) has receiver at args[0]
let mut btc_arg_offset: Int = 0

// vbhc4x: recover a Set element / Map key CT from the method-argument node's
// memoized tid, for the case where the container is a generic-struct field
// (Box[T] { s: Set[T] }). typecheck does NOT monomorphize struct instances, so
// the FieldAccess tid for `b.s` is Set[<typevar>] and get_set_elem_type returns
// the erased default (CT_STRING). The concrete element type lives only on the
// argument node (`insert(3)` → 3 infers TYPE_INT). Fire ONLY when the element is
// still that erased default (cur_ct == CT_STRING && cur_sname == "" for a Set,
// or CT_VOID && "" for a Map key) — never override an already-resolved element
// (protects Set[Str], concrete Set[Int] via node-tid, struct elements). Returns
// the recovered (ct, sname); (-1, "") means "no recovery, keep the caller's".
type ElemRecovery { ct: Int, sname: Str }
fn recover_elem_ct_from_arg(node: Int, arg_pos: Int, is_erased_default: Bool) -> ElemRecovery ! Codegen.Register {
    if !is_erased_default { return ElemRecovery { ct: -1, sname: "" } }
    let args_sl = node_args(node)
    if args_sl == -1 || arg_pos >= sublist_length(args_sl) { return ElemRecovery { ct: -1, sname: "" } }
    let atid = tc_lookup_node_tid(sublist_get(args_sl, arg_pos))
    // mmegcb: a tuple element (Set[(Int,Str)] through a tuple boundary) has no
    // scalar CT — tc_tid_ct returns -1 for TK_TUPLE. Recover its mangled carrier
    // and route through the kops-struct box path (CT_STRUCT + sname), the same
    // path the direct Set[(Int,Str)] uses. Guard on kops_is_struct_key so we
    // only claim it when the tuple carrier is actually a registered kops key
    // (the Set's construction registered it) — otherwise keep the -1 no-op.
    let tup_sname = tc_tid_tuple_sname(atid)
    if tup_sname != "" && kops_is_struct_key(tup_sname) {
        return ElemRecovery { ct: CT_STRUCT, sname: tup_sname }
    }
    let act = tc_tid_ct(atid)
    if act < 0 { return ElemRecovery { ct: -1, sname: "" } }
    ElemRecovery { ct: act, sname: tc_tid_struct(atid) }
}

fn emit_panic_tag_check(tmp: Str, tag_val: Int, msg: Str, node: Int) ! Codegen.Emit {
    let file = panic_file_for_fmt(node)
    let loc = panic_line_str(node)
    emit_line("if ({tmp}.tag == {tag_val}) \{ {emit_panic_site(\"panic: {msg} at {file}:{loc}\", \"\")} }")
}

// Same guard as emit_panic_tag_check, but embeds the Display-rendered value of
// the panicked-on arm: `rendered_expr` is a `const char*` C expression (from
// render_result_arm_value) passed as the `%s` printf vararg. Used by the
// Result unwrap/unwrap_err panic path; the Option/None path keeps the
// payload-free emit_panic_tag_check.
fn emit_panic_tag_check_render(tmp: Str, tag_val: Int, msg_prefix: Str, rendered_expr: Str, node: Int) ! Codegen.Emit {
    let file = panic_file_for_fmt(node)
    let loc = panic_line_str(node)
    emit_line("if ({tmp}.tag == {tag_val}) \{ {emit_panic_site(\"panic: {msg_prefix}: %s at {file}:{loc}\", \", {rendered_expr}\")} }")
}

// ms4ctb: build the concrete type-args CSV for a poly-impl call on a builtin
// List receiver. The canonical form `impl[T] Trait[T] for List[T]` has each
// impl binder appear as the List's element type, so every binder resolves to
// the receiver list's concrete element type. Struct/enum elements use their
// CANONICAL C tag (c_type_tag_for_struct — dot-free, module-qualified so a
// cross-module element yields a valid C identifier, br dwhm4v); scalars use the
// CT-derived name. This CSV feeds mangle_generic_name and the mono-registry
// (the PHYSICAL symbol), so it must be the dot-free physical spelling. The CSV
// order follows binder order (mangle_generic_name indexes positionally by
// binder). Return-type substitution does NOT read this CSV — it lowers the element
// name from the interned tids via poly_impl_ret_arg_tids + resolve_tparam_via_tid.
fn poly_impl_concrete_args(im: Int, obj_str: Str, recv_node: Int) -> Str {
    let binders_sl = node_impl_binders(im)
    let elem_ct = get_list_elem_type(obj_str)
    let elem_struct = get_list_elem_struct(obj_str)
    // br 4c3gts: a COMPOUND element (`List[Option[Int]]`) has no struct name and
    // its CT (CT_OPTION/CT_RESULT/CT_MAP) has no type_name_from_ct arm, so the
    // string path below spells it "Void" — collapsing every compound instance to
    // the single symbol `..._Void` (a C-level collision + Void-return miscompile).
    // When the element tid is poly-slot-encodable (a same-module compound over
    // bare inners), spell it via the tid path (tc_seg_from_tid → "Option_int"),
    // which is the SAME segment poly_impl_concrete_arg_tids carries and the
    // def-side resolve_tparam_via_tid resolves — byte-identical by construction.
    // A cross-module compound stays unencodable and keeps the string spelling
    // (defers to the tk8qbv path). tc_tid_to_c_tag already erases a scalar / bare
    // struct element to the same tag the string path spells, so an encodable
    // scalar/struct element is also safe here (no behavior change for those).
    let elem_tid = tc_tid_list_elem(tc_lookup_node_tid(recv_node))
    let tid_seg = if tc_poly_elem_slot_encodable(elem_tid) { tc_seg_from_tid(elem_tid) } else { None }
    let elem_name = if tid_seg.is_some() {
        tid_seg.unwrap()
    } else if elem_struct != "" {
        c_type_tag_for_struct(elem_struct)
    } else {
        type_name_from_ct(elem_ct)
    }
    build_binder_csv(binders_sl, elem_name)
}

fn build_binder_csv(binders_sl: Int, elem_name: Str) -> Str {
    let mut csv = ""
    let mut bi = 0
    while bi < sublist_length(binders_sl) {
        if bi > 0 { csv = csv.concat(",") }
        csv = csv.concat(elem_name)
        bi = bi + 1
    }
    csv
}

// tid twin of poly_impl_concrete_args: the concrete element tid per binder. The
// canonical `impl[T] Trait[T] for List[T]` binds every binder to the receiver
// list's element type, so each binder's tid is inner1 of the receiver List tid
// (memoized on the call's object node). Positionally aligned with
// poly_impl_concrete_args' CSV.
//
// Only carry the element tid when it is slot-encodable — a scalar or a bare
// unqualified struct/enum, where tc_tid_to_c_tag round-trips to the same segment
// the CSV twin spells via type_name_from_ct / get_list_elem_struct. Store -1 for
// every other element (a struct-INSTANCE like Box[Int], or a compound like
// Option[Int]): the mangling twin spells those as the bare carrier / "Void", so the
// tid path's inner-carrying tag (tc_tid_to_c_tag -> "Box" / tc_seg_from_tid ->
// "Option_int") would DIVERGE from the mangled symbol. -1 keeps the def side off the
// tid path for that slot, matching the mangled name exactly (br ec5qgb; mirrors the
// register_struct_instance_from_tid gate). Also -1 when the receiver tid is not a
// resolvable List (tc_tid_list_elem = -1), so both cases stay byte-safe.
//
// NOTE: -1 is no longer a free "defer to the string resolver" — that resolver is gone.
// Only the two mono TYPEDEF emitters still recover a -1 slot, from the concrete_args
// CSV via resolve_mono_field_type (br w4c0py). Everywhere else a -1 slot leaves the
// name passing through unchanged, so a slot that is a BINDER must not reach a C
// symbol; the emit_struct_lit I0001 chokepoint is what catches it.
fn poly_impl_concrete_arg_tids(im: Int, recv_node: Int) -> List[Int] {
    let mut tids: List[Int] = []
    let binders_sl = node_impl_binders(im)
    let elem_tid = tc_tid_list_elem(tc_lookup_node_tid(recv_node))
    // tc_POLY_elem_slot_encodable, not the general tc_struct_slot_encodable: the
    // poly-impl CSV twin (poly_impl_concrete_args) spells a cross-module element via
    // the raw QUALIFIED get_list_elem_struct (br dwhm4v), which does not round-trip
    // through tc_seg_from_tid — so a module-qualified element must store -1 here even
    // though q4etvt relaxed the general slot gate to admit it (br q4etvt).
    let carried = if tc_poly_elem_slot_encodable(elem_tid) { elem_tid } else { -1 }
    let mut bi = 0
    while bi < sublist_length(binders_sl) {
        tids.push(carried)
        bi = bi + 1
    }
    tids
}

// pktmea: the RETURN-path twin of poly_impl_concrete_arg_tids. The four RETURN-type
// substitution sites in emit_poly_impl_call recover the concrete element name for a
// bare-T / compound-over-T return; this carries the concrete element tid per binder
// so resolve_tparam_via_tid can lower that name from the interned type_id pool
// (tc_seg_from_tid). This is the only path now — the dotted string CSV it replaced
// (poly_impl_resolution_args) is deleted.
//
// Unlike poly_impl_concrete_arg_tids, this does NOT apply the strict
// tc_poly_elem_slot_encodable gate: that gate exists to keep the MANGLING CSV twin
// byte-identical to the physical symbol, whereas the RETURN path only needs a valid
// downstream name and BARE is the established convention (matching the 7 other
// bare-storing RETURN-path producers). So carry the raw element tid and let
// resolve_tparam_via_tid's tc_seg_from_tid admission decide: an encodable tid
// (scalar / bare struct / struct instance) yields its bare-or-physical segment; an
// unencodable tid (or -1 when the receiver is not a resolvable List) returns None and
// the name passes through unchanged — there is no string path left to fall back to.
// tc_seg_from_tid guards tid<0 internally.
fn poly_impl_return_elem_tids(im: Int, recv_node: Int) -> List[Int] {
    let mut tids: List[Int] = []
    let binders_sl = node_impl_binders(im)
    let elem_tid = tc_tid_list_elem(tc_lookup_node_tid(recv_node))
    let mut bi = 0
    while bi < sublist_length(binders_sl) {
        tids.push(elem_tid)
        bi = bi + 1
    }
    tids
}

// 0n07he: byte-exact slot-tid admission guard shared by every mono-registration
// site that carries per-slot tids alongside a string CSV (the stdlib list-ops
// list_fold/for_each/any/all here, and emit_generic_fn_call_tail's free-fn path in
// codegen_expr). A slot keeps its concrete tid ONLY when tc_seg_from_tid reproduces
// the CSV segment (`csv_seg`) that mangling actually used, byte-for-byte. Any
// divergence — an element the CT-tag path spelled "Void", an unencodable tid, a -1
// from an unresolvable receiver, or an infer-CSV slot the tid can't reach — stores
// -1, which the def-side resolver reports by passing the binder name through
// unchanged. With the string tail gone that would spell a bare binder into a C
// symbol, so a -1 here has to stay unreachable in practice; the _Void grep in
// CLAUDE.md is the guard. The Gen1==Gen2 fixed-point gate proves the equality.
pub fn listop_slot_tid(tid: Int, csv_seg: Str) -> Int {
    let seg = tc_seg_from_tid(tid)
    if seg.is_some() && seg.unwrap() == csv_seg {
        return tid
    }
    -1
}

// 6mhzya: the canonical type-param resolver, home to all three codegen layers
// (stmt/expr/methods) after the three byte-identical twins collapsed here.
// codegen_methods is the only safe home: it already imports typecheck for
// tc_seg_from_tid, and it sits below both codegen_expr (imports methods) and
// codegen_stmt (imports expr, plus a shortcut import of methods for this name) in the
// DAG — so no import cycle. When `param_name` is a binder and arg_tids captured a
// concrete tid for its position, lower the segment from the structured tid via
// tc_seg_from_tid, which returns Some only when the tid is encodable and spells a bare
// struct BARE / a struct instance as its physical mono stem — the established
// convention (bare for a plain struct, matching descriptor_mangle / the free-fn
// carrier producers).
//
// Otherwise the name passes through unchanged. That covers the two non-binder roles
// the deleted string resolver also served (no tparams at all; a name that is already a
// concrete type) AND, now that there is no CSV tail, the binder-with-no-usable-tid
// case: that one would spell a bare binder into a C symbol.
//
// That last case is NOT hypothetical and the `_Void` grep does NOT guard it — a bare
// binder mangles to `blink_Box_T`, which contains no "Void" (br pt4hsy, br w4c0py).
// The real guards are, in order:
//   - the callers: register_map_elem_struct_mono and the CT_VOID struct-return arm of
//     emit_generic_call both refuse to register an instance whose args CSV still holds
//     a binder (tparams_sl_contains);
//   - resolve_mono_field_type (codegen_stmt), which recovers a def-side typedef field
//     from the concrete_args CSV when the producer could not supply a tid;
//   - emit_struct_lit's I0001 chokepoint, which now treats a binder segment as erased
//     exactly like "Void".
pub fn resolve_tparam_via_tid(param_name: Str, tparams_sl: Int, arg_tids: List[Int]) -> Str {
    let tid = tparam_tid_via_mono(param_name, tparams_sl, arg_tids)
    if tid >= 0 {
        let seg = tc_seg_from_tid(tid)
        if seg.is_some() { return seg.unwrap() }
    }
    param_name
}

// The tid twin of resolve_tparam_via_tid — and its shared FIRST HALF: the twin above
// delegates the lookup here and only adds the spelling, so there is exactly one copy of
// the positional-binder rule. It hands back the interned tid instead of its spelled
// segment, which is what a caller that must read the resolved type STRUCTURALLY — a
// tuple's arity and element tids, to register its carrier from the tid
// (ensure_tuple_carrier_from_tid, br fqthkv) — needs: the segment string is a name and
// not a type. Returns -1 when `param_name` is not a binder here, or when arg_tids
// captured nothing for its position.
//
// Deliberately UNGATED (no tc_seg_from_tid admission, unlike its twin): the twin's gate
// exists to keep a spelled segment byte-identical to a mangled symbol, and a caller that
// only inspects the shape has no symbol to match. Callers that go on to NAME the type
// must still take that name from the twin.
pub fn tparam_tid_via_mono(param_name: Str, tparams_sl: Int, arg_tids: List[Int]) -> Int {
    if tparams_sl == -1 { return -1 }
    let mut pi = 0
    while pi < sublist_length(tparams_sl) {
        if node_name(sublist_get(tparams_sl, pi)) == param_name {
            if pi < arg_tids.len() { return arg_tids.get(pi).unwrap() }
            return -1
        }
        pi = pi + 1
    }
    -1
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_poly_impl_call(node: Int, composed_base: Str, obj_str: Str) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let im = poly_impl_block_node.get(composed_base).unwrap()
    let m_def = poly_impl_method_node.get(composed_base).unwrap()
    let tparams_sl = node_impl_binders(im)
    let concrete_args = poly_impl_concrete_args(im, obj_str, node_obj(node))
    let arg_tids = poly_impl_concrete_arg_tids(im, node_obj(node))
    let ret_tids = poly_impl_return_elem_tids(im, node_obj(node))
    let mangled = mangle_generic_name(composed_base, concrete_args)
    register_mono_fn(composed_base, concrete_args, arg_tids)
    register_mono_instance(composed_base, concrete_args, arg_tids)

    // Resolve the return type through the binder substitution so the result
    // temp carries the concrete C type (a bare-T return becomes the element's
    // concrete type, not void). Prefer the interned type_id pool
    // (resolve_tparam_via_tid over ret_tids): tc_seg_from_tid spells a bare
    // cross-module struct BARE (CmgPoint) — which type_from_name / is_struct_type
    // recover directly from struct_reg_set without a `.` to split — and a struct
    // instance as its physical mono stem. The dotted string CSV this replaced
    // (poly_impl_resolution_args) is what the head relied on before pktmea (br dwhm4v);
    // it is now deleted. Bare is not just equivalent but MORE correct: the dotted
    // spelling flowed into descriptor_mangle and produced the invalid promote symbol
    // `blink_promote_helper.CmgPoint` for a with-arena tail (latent bug fixed here).
    let ret_str_raw = node_return_type(m_def)
    let ret_str = resolve_tparam_via_tid(ret_str_raw, tparams_sl, ret_tids)
    // A bare-binder return (`-> T`) instantiated at a COMPOUND element
    // (`List[Option[Int]]`) resolves ret_str to the inner-carrying carrier tag
    // (`Option_int` / `Result_int_str` / `Map_int_str`) via the tid RETURN path
    // (poly_impl_return_elem_tids -> tc_seg_from_tid). type_from_name of a carrier
    // tag is CT_VOID (a tag is not a head name), so the result temp would carry
    // CT_VOID and any chained method (`.first().unwrap()`) would fail to resolve
    // (br 4c3gts). Reroute the CT off the tag exactly as the free-fn twin
    // mono_fn_signature does (is_compound_tag -> compound_tag_ct), so the
    // Option/Result carrier-threading branches below fire and the caller sees the
    // concrete compound type. `canon_ret` canonicalizes a module-qualified inner so
    // the emitted C name matches the typedef ensure_carrier_from_tag emits.
    let ret_name_ct = type_from_name(ret_str)
    let rerouted = ret_name_ct == CT_VOID && is_compound_tag(ret_str) != 0
    let ret_ct = if rerouted { compound_tag_ct(ret_str) } else { ret_name_ct }
    let canon_ret = if rerouted { canonical_struct_tag(ret_str) } else { ret_str }
    let fn_eff_sl = node_effects(m_def)
    let fn_trusted = has_annotation(m_def, "trusted")
    reg_fn_with_effects(mangled, ret_ct, fn_eff_sl, fn_trusted)

    // Emit args with the same carrier hints the single-symbol path uses. The
    // method node's params include `self` at index 0, so call arg i maps to
    // method param i + self_offset.
    let args_sl = node_args(node)
    let m_params_sl = node_params(m_def)
    let self_offset = if impl_method_self_name(m_def) != "" { 1 } else { 0 }
    let mut args_str = obj_str
    if args_sl != -1 {
        let mut i = 0
        while i < sublist_length(args_sl) {
            args_str = args_str.concat(", ")
            let saved_hint = cg_expect_fn_value_sig
            cg_expect_fn_value_sig = arg_fn_value_hint(m_params_sl, i + self_offset)
            let saved_arg_ann = cg_expect_arg_ann
            cg_expect_arg_ann = arg_type_ann_at(m_params_sl, i + self_offset)
            emit_expr(sublist_get(args_sl, i))
            cg_expect_arg_ann = saved_arg_ann
            cg_expect_fn_value_sig = saved_hint
            args_str = args_str.concat(expr_result_str)
            i = i + 1
        }
    }

    expr_list_elem_type = -1
    expr_list_elem_struct = ""

    // A compound-over-binder return (`-> Option[T]` / `-> Result[T, E]`) needs
    // the concrete inner threaded into the caller's carrier globals, or the
    // enclosing `let` binds the default `blink_Option_int` while the def side
    // monomorphized `blink_Option_LocalPoint` — an invalid-initializer mismatch
    // (br wkwj7e). node_return_type gives only the HEAD ("Option"), so read the
    // return annotation's inner child(ren) and substitute through the same
    // resolver the head used (resolve_tparam_via_tid over ret_tids, dotted-
    // string fallback). The tid path spells a bare cross-module inner BARE, which
    // is the carrier convention the free-fn emit_generic_fn_call_tail and the 7
    // other RETURN-path producers already store (strip_module_qualifier); the
    // caller-side unwrap_carrier strips internally anyway, so bare is safe. Recovers
    // struct instances with is_mono_struct_instance (br bd4mg6). Runs AFTER the
    // arg-emission loop: emit_expr on the args clobbers these same expr_* carrier
    // globals, so setting them earlier would be overwritten (the free-fn path
    // receives args_str pre-emitted for the same reason).
    if ret_ct == CT_OPTION {
        let ret_ann = node_type_ann(m_def)
        let ann_elems = if ret_ann != -1 { node_elements(ret_ann) } else { -1 }
        if rerouted {
            // Bare-binder `-> T` bound to an Option element: the return annotation
            // is the typevar node (no compound children), so recover the carrier +
            // inner from the canonicalized tag, mirroring mono_fn_signature's
            // rerouted branch. ensure_carrier_from_tag emits the typedef;
            // option_inner_*_from_tag recover the inner CT / struct (br 4c3gts).
            ensure_carrier_from_tag(canon_ret)
            let inner_ct = option_inner_ct_from_tag(canon_ret)
            let inner_struct = option_inner_struct_from_tag(canon_ret)
            expr_option_inner = inner_ct
            expr_option_inner_struct = inner_struct
            reg_fn_ret_type(mangled, CT_OPTION, inner_ct, -1)
        } else if ann_elems != -1 && sublist_length(ann_elems) >= 1 {
            let inner_ann = sublist_get(ann_elems, 0)
            let inner_name = resolve_tparam_via_tid(node_name(inner_ann), tparams_sl, ret_tids)
            let inner_ct = type_from_name(inner_name)
            expr_option_inner = inner_ct
            expr_option_inner_struct = ""
            ensure_option_type(inner_ct)
            reg_fn_ret_type(mangled, CT_OPTION, inner_ct, -1)
            if inner_ct == CT_VOID && (is_struct_or_enum_type(inner_name) != 0 || is_mono_struct_instance(inner_name) != 0) {
                ensure_struct_option_type(inner_name)
                expr_option_inner_struct = inner_name
            }
        }
    } else if ret_ct == CT_RESULT {
        let ret_ann = node_type_ann(m_def)
        let ann_elems = if ret_ann != -1 { node_elements(ret_ann) } else { -1 }
        if rerouted {
            // Bare-binder `-> T` bound to a Result element: derive both inners from
            // the canonicalized tag (br 4c3gts), mirroring the Option branch above.
            // split_result_compound splits `Result_int_str` into ok/err segments;
            // a segment naming a struct/enum typedef tag (typedef_tag_or_empty)
            // threads through the mixed-struct carrier globals so the caller binds
            // the correctly-named carrier, matching the def side.
            ensure_carrier_from_tag(canon_ret)
            let parts = split_result_compound(canon_ret)
            let ok_struct = typedef_tag_or_empty(parts.first)
            let err_struct = typedef_tag_or_empty(parts.second)
            let ok_ct = type_from_name_tag(parts.first)
            let err_ct = type_from_name_tag(parts.second)
            expr_result_ok_type = ok_ct
            expr_result_err_type = err_ct
            expr_result_ok_struct = ok_struct
            expr_result_err_struct = err_struct
            if ok_struct != "" || err_struct != "" {
                reg_fn_ret_struct_inner(mangled, ok_struct, err_struct)
            }
            reg_fn_ret_type(mangled, CT_RESULT, ok_ct, err_ct)
        } else if ann_elems != -1 && sublist_length(ann_elems) >= 2 {
            let ok_ann = sublist_get(ann_elems, 0)
            let err_ann = sublist_get(ann_elems, 1)
            let ok_name = resolve_tparam_via_tid(node_name(ok_ann), tparams_sl, ret_tids)
            let err_name = resolve_tparam_via_tid(node_name(err_ann), tparams_sl, ret_tids)
            let ok_ct = type_from_name(ok_name)
            let err_ct = type_from_name(err_name)
            expr_result_ok_type = ok_ct
            expr_result_err_type = err_ct
            let ok_is_type = is_struct_or_enum_type(ok_name) != 0 || is_mono_struct_instance(ok_name) != 0
            let err_is_type = is_struct_or_enum_type(err_name) != 0 || is_mono_struct_instance(err_name) != 0
            if ok_is_type || err_is_type {
                let ok_s = if ok_is_type { ok_name } else { "" }
                let err_s = if err_is_type { err_name } else { "" }
                reg_fn_ret_struct_inner(mangled, ok_s, err_s)
                ensure_mixed_result_type(ok_ct, err_ct, ok_s, err_s)
                expr_result_ok_struct = ok_s
                expr_result_err_struct = err_s
            } else {
                ensure_result_type(ok_ct, err_ct)
                expr_result_ok_struct = ""
                expr_result_err_struct = ""
            }
            reg_fn_ret_type(mangled, CT_RESULT, ok_ct, err_ct)
        }
    }

    // Bind a struct/enum return into a temp so the caller sees a concrete type.
    if ret_ct == CT_VOID && ret_str != "" && ret_str != "Void" {
        if is_struct_type(ret_str) != 0 || is_enum_type(ret_str) != 0 || is_mono_struct_instance(ret_str) != 0 {
            let s_tmp = fresh_temp("_psr")
            emit_line("{c_type_c_name(ret_str)} {s_tmp} = {c_fn_name(mangled)}({args_str});")
            set_var(s_tmp, CT_STRUCT, 0)
            set_var_struct(s_tmp, ret_str)
            expr_result_str = s_tmp
            expr_result_type = CT_STRUCT
            return
        }
    }
    expr_result_str = "{c_fn_name(mangled)}({args_str})"
    expr_result_type = ret_ct
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_user_impl_call(node: Int, type_name: Str, method: Str, obj_str: Str) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    // Resolve the owning trait so the symbol matches the trait-qualified
    // definition (sb3125). Ambiguous calls are rejected at typecheck, so a
    // resolved trait here is unique; "" (e.g. inherent/synthesized paths) keeps
    // the bare symbol.
    let call_trait = impl_trait_for_method(type_name, method)
    let mangled = if call_trait != "" { mangle_impl_method_q(type_name, call_trait, method) } else { "{type_name}_{method}" }
    // ms4ctb: a polymorphic impl on a builtin generic receiver
    // (`impl[T] Trait[T] for List[T]`) is monomorphized per concrete T at the
    // use site — registered here, emitted by the deferred mono pass — exactly
    // like a generic free fn. Routed before the single-symbol path below.
    if call_trait != "" && is_poly_impl_base(mangled) != 0 {
        emit_poly_impl_call(node, mangled, obj_str)
        return
    }
    let args_sl = node_args(node)
    let mut args_str = obj_str
    // Callee param sublist for carrier hints. The method node's params include
    // `self` at index 0, so call arg i maps to method param i + self_offset.
    let m_def = find_impl_method_node(type_name, method)
    let m_params_sl = if m_def != -1 { node_params(m_def) } else { -1 }
    let self_offset = if m_def != -1 && impl_method_self_name(m_def) != "" { 1 } else { 0 }
    if args_sl != -1 {
        let mut i = 0
        while i < sublist_length(args_sl) {
            args_str = args_str.concat(", ")
            let saved_hint = cg_expect_fn_value_sig
            cg_expect_fn_value_sig = arg_fn_value_hint(m_params_sl, i + self_offset)
            let saved_arg_ann = cg_expect_arg_ann
            cg_expect_arg_ann = arg_type_ann_at(m_params_sl, i + self_offset)
            emit_expr(sublist_get(args_sl, i))
            cg_expect_arg_ann = saved_arg_ann
            cg_expect_fn_value_sig = saved_hint
            args_str = args_str.concat(expr_result_str)
            i = i + 1
        }
    }
    expr_list_elem_type = -1
    expr_list_elem_struct = ""
    let ret_ct = get_impl_method_ret(type_name, method)
    // When the impl method returns a user-defined struct/enum,
    // type_from_name() returns CT_VOID. Detect that here and bind a
    // temporary so the resulting variable carries the correct C type.
    if ret_ct == CT_VOID {
        let m_node = m_def
        if m_node != -1 {
            let ret_str = node_return_type(m_node)
            if ret_str != "" && ret_str != "Void" {
                if is_transparent_newtype(ret_str) != 0 {
                    // Transparent newtype (Errno): the method returns a bare
                    // int64_t, so the temp must be a bare int — matching the
                    // bare let-binding lowering — not a boxed enum struct. The
                    // temp is NOT registered as an enum var: a `match` on the
                    // result binds `Errno(rc)` by bare-int identity, and a
                    // var->enum entry would make downstream get_var_enum lookups
                    // (e.g. tuple/struct field emit) treat the bare int as a
                    // boxed blink_Errno field, producing invalid C.
                    let s_tmp = fresh_temp("_sr")
                    emit_line("{c_type_from_tag(ret_str)} {s_tmp} = {c_fn_name(mangled)}({args_str});")
                    set_var(s_tmp, CT_INT, 0)
                    expr_result_str = s_tmp
                    expr_result_type = CT_INT
                    return
                }
                if is_struct_type(ret_str) != 0 || is_enum_type(ret_str) != 0 {
                    // A concrete generic-struct instance method return
                    // (`-> Box[Str]`) must give the temp its mono carrier
                    // (blink_Box_Str) and bind that mono name so `.value`
                    // reads resolve the concrete inner — not the bare,
                    // never-typedef'd `blink_Box`. Read the instance tid off
                    // the return annotation and expand to the mono stem,
                    // mirroring the def-side seams. Empty stem (bare/typevar/
                    // enum) falls back unchanged (br ns7qdm).
                    let ret_stem = tc_tid_struct_mono_name(tc_lookup_node_tid(node_type_ann(m_node)))
                    let ret_carrier = if ret_stem != "" { ret_stem } else { ret_str }
                    let s_tmp = fresh_temp("_sr")
                    emit_line("{c_type_c_name(ret_carrier)} {s_tmp} = {c_fn_name(mangled)}({args_str});")
                    set_var(s_tmp, CT_STRUCT, 0)
                    set_var_struct(s_tmp, ret_carrier)
                    expr_result_str = s_tmp
                    expr_result_type = CT_STRUCT
                    return
                }
            }
        }
    }
    expr_result_str = "{c_fn_name(mangled)}({args_str})"
    expr_result_type = ret_ct
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_result_unwrap_inner(
    obj_str: Str, node: Int,
    inner_t: Int, inner_s: Str,
    field: Str,
    elem_kind: Int, elem_sname: Str,
    propagate_option: Int,
    other_t: Int, other_s: Str
) ! Codegen.Emit, Codegen.Scope {
    let is_ok = field == "ok"
    let panic_tag = if is_ok { 1 } else { 0 }
    let panic_msg = if is_ok { "unwrap called on Err" } else { "unwrap_err called on Ok" }
    let tmp = fresh_temp(if is_ok { "_runw_" } else { "_ruew_" })
    emit_line("__typeof__({obj_str}) {tmp} = {obj_str};")
    // The panicked-on arm is the OTHER arm: `.unwrap()` panics on Err, so we
    // render `tmp.err`; `.unwrap_err()` panics on Ok, so we render `tmp.ok`.
    let panic_field = if is_ok { "err" } else { "ok" }
    let rendered = render_result_arm_value(other_t, other_s, "{tmp}.{panic_field}")
    // The guard is byte-identical across every inner-type branch and always
    // precedes the value binding, so emit it once here. Branches differ only in
    // how they bind and type the success value.
    emit_panic_tag_check_render(tmp, panic_tag, panic_msg, rendered, node)
    if inner_s != "" && is_compound_ct(inner_t) == 0 {
        let val_tmp = fresh_temp(if is_ok { "_runv_" } else { "_ruerr_" })
        emit_line("{c_type_c_name(inner_s)} {val_tmp} = {tmp}.{field};")
        set_var_struct(val_tmp, inner_s)
        expr_result_str = val_tmp
        expr_result_type = CT_VOID
    } else if inner_t == CT_STRING {
        expr_result_str = "{tmp}.{field}"
        expr_result_type = CT_STRING
    } else if inner_t == CT_LIST {
        let val_tmp = fresh_temp(if is_ok { "_runv_" } else { "_ruerr_" })
        emit_line("blink_list* {val_tmp} = {tmp}.{field};")
        set_var(val_tmp, CT_LIST, 0)
        if elem_kind >= 0 {
            set_list_elem_type(val_tmp, elem_kind)
            expr_list_elem_type = elem_kind
        }
        if elem_sname != "" {
            set_list_elem_struct(val_tmp, elem_sname)
        }
        expr_result_str = val_tmp
        expr_result_type = CT_LIST
    } else if inner_t == CT_MAP {
        let val_tmp = fresh_temp(if is_ok { "_runv_" } else { "_ruerr_" })
        emit_line("blink_map* {val_tmp} = {tmp}.{field};")
        set_var(val_tmp, CT_MAP, 0)
        expr_result_str = val_tmp
        expr_result_type = CT_MAP
    } else if inner_t == CT_SET {
        let val_tmp = fresh_temp(if is_ok { "_runv_" } else { "_ruerr_" })
        emit_line("blink_set* {val_tmp} = {tmp}.{field};")
        set_var(val_tmp, CT_SET, 0)
        expr_result_str = val_tmp
        expr_result_type = CT_SET
    } else if inner_t == CT_BYTES {
        let val_tmp = fresh_temp(if is_ok { "_runv_" } else { "_ruerr_" })
        emit_line("blink_bytes* {val_tmp} = {tmp}.{field};")
        set_var(val_tmp, CT_BYTES, 0)
        expr_result_str = val_tmp
        expr_result_type = CT_BYTES
    } else if propagate_option != 0 && inner_t == CT_OPTION && inner_s != "" {
        let val_tmp = fresh_temp(if is_ok { "_runv_" } else { "_ruerr_" })
        emit_line("{c_type_c_name(inner_s)} {val_tmp} = {tmp}.{field};")
        set_var(val_tmp, CT_OPTION, 0)
        if inner_s.starts_with("Option_") {
            set_var_option_from_struct_tag(val_tmp, inner_s)
        } else {
            set_var_option_struct(val_tmp, CT_INT, inner_s)
        }
        expr_option_inner = get_var_option_inner(val_tmp)
        expr_option_inner_struct = get_var_option_inner_struct(val_tmp)
        expr_result_str = val_tmp
        expr_result_type = CT_OPTION
    } else {
        expr_result_str = "{tmp}.{field}"
        if inner_t == CT_FLOAT {
            expr_result_type = CT_FLOAT
        } else if inner_t == CT_CHAR {
            expr_result_type = CT_CHAR
        } else {
            expr_result_type = CT_INT
        }
    }
}

pub fn resolve_push_struct(val_str: Str, list_name: Str) -> Str {
    let s = get_var_struct(val_str)
    if s != "" {
        return s
    }
    let ve = get_var_enum(val_str)
    if ve != "" && is_data_enum(ve) != 0 {
        return ve
    }
    get_list_elem_struct(list_name)
}

// Heap-box a value already evaluated into the expr_result_* globals and emit the
// container write. `emit_prefix` is the C insert call up to (but not including)
// the value argument — e.g. "blink_list_push(_l0, " / "blink_list_set(xs, 0, " /
// "blink_map_set(m, key, " — so the helper closes it with the boxed pointer
// (or the inline int form) and a trailing ");".
//
// Single source of truth for compound-element boxing across list.push,
// list.set, map.insert, and list-literal (br 4yzsfc): compound values
// (struct/enum/Option/Result) must be heap-allocated and stored behind a void*,
// never cast struct-to-pointer directly (cc rejects that). Mirrors the branch
// structure of the list.push reference. `elem_container` is the list name to
// record element metadata on (set_list_elem_struct/type); pass "" for map
// values, which track their value type separately.
//
// `val_struct` is the pre-resolved struct/enum name for the CT_STRUCT case
// (callers resolve it differently: resolve_push_struct for push/set/map, the
// StructLit fallback for list literals), or "" if none applies.
pub fn emit_boxed_container_store(emit_prefix: Str, val_str: Str, val_type: Int, val_struct: Str, elem_container: Str) ! Codegen.Emit, Codegen.Register {
    if (val_type == CT_STRUCT || val_type == CT_VOID) && val_struct != "" {
        if elem_container != "" {
            set_list_elem_struct(elem_container, val_struct)
            set_list_elem_type(elem_container, CT_VOID)
        }
        let box_tmp = fresh_temp("_box")
        emit_line("{c_type_c_name(val_struct)}* {box_tmp} = ({c_type_c_name(val_struct)}*)blink_alloc(sizeof({c_type_c_name(val_struct)}));")
        emit_line("*{box_tmp} = {val_str};")
        emit_line("{emit_prefix}(void*){box_tmp});")
    } else if val_type == CT_INT {
        emit_line("{emit_prefix}(void*)(intptr_t){val_str});")
    } else if val_type == CT_FLOAT {
        let box_tmp = fresh_temp("_fbox")
        emit_line("double* {box_tmp} = (double*)blink_alloc(sizeof(double));")
        emit_line("*{box_tmp} = {val_str};")
        emit_line("{emit_prefix}(void*){box_tmp});")
    } else if val_type == CT_OPTION {
        let opt_inner_s = expr_option_inner_struct
        let opt_tag = if opt_inner_s != "" { canonical_struct_tag(opt_inner_s) } else { c_type_tag(expr_option_inner) }
        let opt_sname = "Option_{opt_tag}"
        if opt_inner_s != "" {
            ensure_struct_option_type(opt_inner_s)
        } else {
            ensure_option_type(expr_option_inner)
        }
        if elem_container != "" {
            set_list_elem_struct(elem_container, opt_sname)
            set_list_elem_type(elem_container, CT_VOID)
        }
        let opt_c = c_type_c_name(opt_sname)
        let box_tmp = fresh_temp("_obox")
        emit_line("{opt_c}* {box_tmp} = ({opt_c}*)blink_alloc(sizeof({opt_c}));")
        emit_line("*{box_tmp} = {val_str};")
        emit_line("{emit_prefix}(void*){box_tmp});")
    } else if val_type == CT_RESULT {
        let res_ok_s = expr_result_ok_struct
        let res_err_s = expr_result_err_struct
        let ok_tag = if res_ok_s != "" { canonical_struct_tag(res_ok_s) } else { c_type_tag(expr_result_ok_type) }
        let err_tag = if res_err_s != "" { canonical_struct_tag(res_err_s) } else { c_type_tag(expr_result_err_type) }
        let res_sname = "Result_{ok_tag}_{err_tag}"
        ensure_mixed_result_type(expr_result_ok_type, expr_result_err_type, res_ok_s, res_err_s)
        if elem_container != "" {
            set_list_elem_struct(elem_container, res_sname)
            set_list_elem_type(elem_container, CT_VOID)
        }
        let res_c = c_type_c_name(res_sname)
        let box_tmp = fresh_temp("_rbox")
        emit_line("{res_c}* {box_tmp} = ({res_c}*)blink_alloc(sizeof({res_c}));")
        emit_line("*{box_tmp} = {val_str};")
        emit_line("{emit_prefix}(void*){box_tmp});")
    } else {
        emit_line("{emit_prefix}(void*){val_str});")
    }
}

// Sub-issue A (br 4yzsfc): a bare `None` written into List[Option[X]] via
// push/set defaults its carrier to blink_Option_int (codegen_expr.bl None path)
// because no expected annotation is threaded. When the receiver list already
// records its element carrier as an `Option_X` tag, reseat the just-emitted
// bare-None result to that carrier so emit_boxed_container_store allocates the
// right struct. No-op when the value isn't a defaulted bare None or the list
// has no recorded Option carrier yet (the empty-list-then-None-first residual
// gap is tracked separately). Returns nothing; mutates expr_result_* globals.
@allow(UnrestoredMutation, IncompleteStateRestore)
fn reseat_bare_none_from_list_elem(obj_str: Str) ! Codegen.Register {
    if expr_option_is_none == 0 { return }
    // Only correct a carrier that defaulted to plain int with no struct inner.
    if expr_option_inner_struct != "" || expr_option_inner != CT_INT { return }
    let elem_tag = get_list_elem_struct(obj_str)
    if !elem_tag.starts_with("Option_") { return }
    let inner_ct = option_inner_ct_from_tag(elem_tag)
    let inner_s = option_inner_struct_from_tag(elem_tag)
    if inner_s != "" {
        ensure_struct_option_type(inner_s)
        let opt_type = struct_option_c_type(inner_s)
        expr_result_str = "({opt_type})\{.tag = 0}"
        expr_option_inner = CT_INT
        expr_option_inner_struct = inner_s
    } else {
        // Same-carrier no-op guard: already Option_int, nothing to change.
        if inner_ct == CT_INT { return }
        ensure_option_type(inner_ct)
        let opt_type = option_c_type(inner_ct)
        expr_result_str = "({opt_type})\{.tag = 0}"
        expr_option_inner = inner_ct
        expr_option_inner_struct = ""
    }
    expr_result_type = CT_OPTION
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_str_method(node: Int, obj_str: Str, _obj_node: Int, method: Str) -> Int ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    if method == "as_cstr" {
        expr_result_str = "blink_strdup({obj_str})"
        expr_result_type = CT_PTR
        return 1
    }
    if method == "len" {
        expr_result_str = "blink_str_len({obj_str})"
        expr_result_type = CT_INT
        return 1
    }
    if method == "is_empty" {
        expr_result_str = "(blink_str_len({obj_str}) == 0)"
        expr_result_type = CT_BOOL
        return 1
    }
    if method == "byte_at" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let i_str = expr_result_str
        expr_result_str = "blink_str_char_at({obj_str}, {i_str})"
        expr_result_type = CT_INT
        return 1
    }
    if method == "char_at" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let i_str = expr_result_str
        expr_result_str = "blink_std_str_str_char_at_opt({obj_str}, {i_str})"
        expr_result_type = CT_OPTION
        expr_option_inner = CT_CHAR
        expr_option_inner_struct = ""
        return 1
    }
    if method == "contains" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let n_str = expr_result_str
        expr_result_str = "(blink_str_contains({obj_str}, {n_str}) != 0)"
        expr_result_type = CT_BOOL
        return 1
    }
    if method == "starts_with" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let n_str = expr_result_str
        expr_result_str = "(blink_str_starts_with({obj_str}, {n_str}) != 0)"
        expr_result_type = CT_BOOL
        return 1
    }
    if method == "ends_with" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let n_str = expr_result_str
        expr_result_str = "(blink_str_ends_with({obj_str}, {n_str}) != 0)"
        expr_result_type = CT_BOOL
        return 1
    }
    if method == "index_of" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let n_str = expr_result_str
        expr_result_str = "blink_str_index_of({obj_str}, {n_str})"
        expr_result_type = CT_INT
        return 1
    }
    if method == "substring" || method == "substr" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let s_str = expr_result_str
        emit_expr(sublist_get(args_sl, 1 + btc_arg_offset))
        let l_str = expr_result_str
        expr_result_str = "blink_str_substr({obj_str}, {s_str}, {l_str})"
        expr_result_type = CT_STRING
        return 1
    }
    if method == "slice" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let s_str = expr_result_str
        emit_expr(sublist_get(args_sl, 1 + btc_arg_offset))
        let e_str = expr_result_str
        expr_result_str = "blink_str_slice({obj_str}, {s_str}, {e_str})"
        expr_result_type = CT_STRING
        return 1
    }
    if method == "concat" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let o_str = expr_result_str
        expr_result_str = "blink_str_concat({obj_str}, {o_str})"
        expr_result_type = CT_STRING
        return 1
    }
    if method == "trim" {
        expr_result_str = "blink_std_str_str_trim({obj_str})"
        expr_result_type = CT_STRING
        return 1
    }
    if method == "trim_left" {
        expr_result_str = "blink_std_str_str_trim_left({obj_str})"
        expr_result_type = CT_STRING
        return 1
    }
    if method == "trim_right" {
        expr_result_str = "blink_std_str_str_trim_right({obj_str})"
        expr_result_type = CT_STRING
        return 1
    }
    if method == "to_upper" {
        expr_result_str = "blink_std_str_str_to_upper({obj_str})"
        expr_result_type = CT_STRING
        return 1
    }
    if method == "to_lower" {
        expr_result_str = "blink_std_str_str_to_lower({obj_str})"
        expr_result_type = CT_STRING
        return 1
    }
    if method == "replace" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let n_str = expr_result_str
        emit_expr(sublist_get(args_sl, 1 + btc_arg_offset))
        let r_str = expr_result_str
        expr_result_str = "blink_std_str_str_replace({obj_str}, {n_str}, {r_str})"
        expr_result_type = CT_STRING
        return 1
    }
    if method == "split" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let d_str = expr_result_str
        expr_result_str = "blink_std_str_str_split({obj_str}, {d_str})"
        expr_result_type = CT_LIST
        expr_list_elem_type = CT_STRING
        return 1
    }
    if method == "lines" {
        expr_result_str = "blink_std_str_str_lines({obj_str})"
        expr_result_type = CT_LIST
        expr_list_elem_type = CT_STRING
        return 1
    }
    if method == "parse_int" || method == "to_int" {
        expr_result_str = "blink_std_num_parse_int({obj_str})"
        expr_result_type = CT_INT
        return 1
    }
    if method == "parse_float" {
        expr_result_str = "blink_std_num_parse_float({obj_str})"
        expr_result_type = CT_FLOAT
        return 1
    }
    0
}

// j0cdey: the C expression for a HOF iterator's current ELEMENT value. For a
// scalar element it's the carrier's `.value`; for a pointer-boxed COMPOUND
// (ifs_carrier_tag set by iter_from_source) the `.value` is an intptr_t to the
// boxed carrier, so deref it back to the carrier by value — the closures/adapters
// take the element (`Option[T]`/`Result[T,E]`) by value, matching for-in/get.
fn hof_elem_value(next_var: Str) -> Str {
    if ifs_carrier_tag != "" {
        let carrier_c = c_type_from_tag(ifs_carrier_tag)
        return "(*({carrier_c}*)(intptr_t){next_var}.value)"
    }
    "{next_var}.value"
}

// 44xww4: one slot of an enumerate/zip pair, described for the Tuple2 struct that
// materializes the pair. `carrier` is the pointer-boxed compound tag (Option_int,
// Result_int_str) or "" for a scalar; `next_var`.value holds the carrier's value.
// tag: tuple-name / elem_structs token (Option_int, or "int" for a scalar).
// ct: elem_types CSV entry — CT_VOID for a compound, the scalar CT otherwise.
// struct_tag: elem_structs token — the carrier tag for a compound, "" for a scalar.
// value: C expression for the slot value, BY VALUE.
type EnumZipSlot { tag: Str, ct: Int, struct_tag: Str, value: Str }

// 44xww4: describe an enumerate/zip pair slot fed by a `.value`-carrying iterator
// `next` result. A compound source (carrier != "") boxes the carrier behind an
// intptr_t, so deref it back BY VALUE for a plain struct-field assignment — the
// s663bm multi-eightbyte RETURN concern does NOT apply to a field store. A scalar
// slot keys on its CT directly.
fn enum_zip_slot(next_var: Str, elem_type: Int, carrier: Str) -> EnumZipSlot {
    if carrier != "" {
        let carrier_c = c_type_from_tag(carrier)
        return EnumZipSlot { tag: carrier, ct: CT_VOID, struct_tag: carrier, value: "(*({carrier_c}*)(intptr_t){next_var}.value)" }
    }
    EnumZipSlot { tag: c_type_tag(elem_type), ct: elem_type, struct_tag: "", value: "{next_var}.value" }
}

// The slot's elem_structs CSV token for ensure_tuple_type: the carrier tag for a
// compound, or the "-" no-struct sentinel for a scalar.
fn enum_zip_slot_struct_csv(slot: EnumZipSlot) -> Str {
    if slot.struct_tag != "" { slot.struct_tag } else { "-" }
}

// 44xww4: stamp `result_list` as a List of `tuple_tag` structs (mirrors
// emit_list_lit's struct-element path) and set the expr_* result channels so the
// caller's `.get()` returns Option[tuple_tag] and `for (i,x)` destructures it.
fn finish_enum_zip_result(result_list: Str, tuple_tag: Str) {
    set_list_elem_type(result_list, CT_VOID)
    set_list_elem_struct(result_list, tuple_tag)
    expr_result_str = result_list
    expr_result_type = CT_LIST
    expr_list_elem_type = CT_VOID
    expr_list_elem_struct = tuple_tag
}

// j0cdey: copy a source List's COMPOUND element type onto a destination list
// (a HOF that produces a new List[Option[T]]/List[Result[T,E]], e.g. collect over
// a compound source). Reuses the source's stored deep inner tp so a nested
// container element — `List[Option[Map]]` — keeps its type params on the result.
fn copy_list_compound_elem(src: Str, dst: Str) {
    let elem_ct = get_list_elem_type(src)
    if elem_ct == CT_OPTION {
        let oi_tp = get_list_elem_option_inner_tp(src)
        if oi_tp >= 0 {
            set_list_elem_option_tp(dst, oi_tp)
        } else {
            set_list_elem_option(dst, get_list_elem_option_inner(src), get_list_elem_option_inner_struct(src))
        }
    } else if elem_ct == CT_RESULT {
        let rok_tp = get_list_elem_result_ok_tp(src)
        let rerr_tp = get_list_elem_result_err_tp(src)
        if rok_tp >= 0 && rerr_tp >= 0 {
            set_list_elem_result_tp(dst, rok_tp, rerr_tp)
        } else {
            set_list_elem_result(dst, get_list_elem_result_ok(src), get_list_elem_result_ok_struct(src), get_list_elem_result_err(src), get_list_elem_result_err_struct(src))
        }
    }
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_list_method(node: Int, obj_str: Str, obj_node: Int, method: Str) -> Int ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    if method == "push" {
        let mut push_var_name = ""
        if node_kind(obj_node) == NodeKind.Ident {
            push_var_name = node_name(obj_node)
        }
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        reseat_bare_none_from_list_elem(obj_str)
        let val_str = expr_result_str
        let val_type = expr_result_type
        // d7es5j: capture the list's recorded element-map K/V BEFORE
        // set_list_elem_type(CT_MAP) collapses them (the flat slot can't hold
        // list→map→{k,v}). Used below to preserve an annotated List[Map[K,V]]
        // value type when an untyped `Map()` is pushed.
        let pre_list_map_k = if val_type == CT_MAP { get_list_elem_map_key_type(obj_str) } else { -1 }
        let pre_list_map_v = if val_type == CT_MAP { get_list_elem_map_val_type(obj_str) } else { -1 }
        let pre_list_map_vs = if val_type == CT_MAP { get_list_elem_map_val_struct(obj_str) } else { "" }
        if val_type != CT_INT {
            set_list_elem_type(obj_str, val_type)
        }
        // wx184m: a plain set_list_elem_type(CT_MAP) collapses the element map's
        // value type to the default Int (the flat slot can't hold list→map→{k,v}).
        // Carry the pushed map's scalar key+value through so List[Map[K,V]].get()
        // keeps V instead of defaulting to Int.
        // d7es5j: an empty `Map()` literal is genuinely untyped (raw k/v == -1),
        // so its default Int value must NOT clobber the list's annotated value
        // type. Prefer the pushed map's types only where it actually has them;
        // otherwise restore the list's pre-collapse element-map types.
        if val_type == CT_MAP {
            let pushed_k_raw = get_map_key_type_raw(val_str)
            let pushed_v_raw = get_map_value_type_raw(val_str)
            let pushed_vs = get_map_value_struct(val_str)
            let use_k = if pushed_k_raw >= 0 { pushed_k_raw } else { pre_list_map_k }
            let use_v = if pushed_v_raw >= 0 { pushed_v_raw } else { pre_list_map_v }
            let use_vs = if pushed_vs != "" { pushed_vs } else { pre_list_map_vs }
            if use_vs != "" {
                set_list_elem_map_types(obj_str, use_k, CT_STRUCT, use_vs)
            } else if use_v >= 0 && is_map_scalar_ct(use_v) != 0 {
                set_list_elem_map_types(obj_str, use_k, use_v, "")
            } else if pre_list_map_k >= 0 || pre_list_map_v >= 0 {
                set_list_elem_map_types(obj_str, pre_list_map_k, pre_list_map_v, pre_list_map_vs)
            }
        }
        let val_struct = resolve_push_struct(val_str, obj_str)
        emit_boxed_container_store("blink_list_push({obj_str}, ", val_str, val_type, val_struct, obj_str)
        if push_var_name != "" {
            emit_trace_state(push_var_name, "push", val_str, val_type)
        }
        expr_result_str = "0"
        expr_result_type = CT_VOID
        return 1
    }
    if method == "pop" {
        let mut elem_type = get_list_elem_type(obj_str)
        let mut elem_struct = get_list_elem_struct(obj_str)
        if elem_struct == "" && elem_type < 0 && expr_list_elem_struct != "" {
            elem_struct = expr_list_elem_struct
            elem_type = CT_VOID
        }
        let res = fresh_temp("_lpop_")
        if (elem_type == CT_VOID || elem_type == CT_STRUCT || elem_type == CT_ENUM) && elem_struct != "" {
            ensure_struct_option_type(elem_struct)
            let opt_type = struct_option_c_type(elem_struct)
            emit_line("{opt_type} {res};")
            emit_line("if (blink_list_len({obj_str}) > 0) \{")
            emit_line("    {res}.tag = 1; {res}.value = ({c_type_c_name(elem_struct)}*)blink_list_pop({obj_str});")
            emit_line("} else \{ {res}.tag = 0; }")
            set_var_option_struct(res, CT_VOID, elem_struct)
            expr_result_str = res
            expr_result_type = CT_OPTION
            expr_option_inner = CT_VOID
            expr_option_inner_struct = elem_struct
        } else if elem_type == CT_STRING {
            ensure_option_type(CT_STRING)
            let opt_type = option_c_type(CT_STRING)
            emit_line("{opt_type} {res};")
            emit_line("if (blink_list_len({obj_str}) > 0) \{")
            emit_line("    {res}.tag = 1; {res}.value = (const char*)blink_list_pop({obj_str});")
            emit_line("} else \{ {res}.tag = 0; }")
            set_var_option(res, CT_STRING)
            expr_result_str = res
            expr_result_type = CT_OPTION
            expr_option_inner = CT_STRING
            expr_option_inner_struct = ""
        } else if elem_type == CT_FLOAT {
            ensure_option_type(CT_FLOAT)
            let opt_type = option_c_type(CT_FLOAT)
            emit_line("{opt_type} {res};")
            emit_line("if (blink_list_len({obj_str}) > 0) \{")
            emit_line("    {res}.tag = 1; {res}.value = *(double*)blink_list_pop({obj_str});")
            emit_line("} else \{ {res}.tag = 0; }")
            set_var_option(res, CT_FLOAT)
            expr_result_str = res
            expr_result_type = CT_OPTION
            expr_option_inner = CT_FLOAT
            expr_option_inner_struct = ""
        } else if elem_type == CT_LIST {
            ensure_option_type(CT_LIST)
            let opt_type = option_c_type(CT_LIST)
            emit_line("{opt_type} {res};")
            emit_line("if (blink_list_len({obj_str}) > 0) \{")
            emit_line("    {res}.tag = 1; {res}.value = (blink_list*)blink_list_pop({obj_str});")
            emit_line("} else \{ {res}.tag = 0; }")
            set_var_option(res, CT_LIST)
            let pop_nested = get_list_nested_elem_type(obj_str)
            if pop_nested != -1 {
                set_var_option_inner2(res, pop_nested)
            }
            let pop_nested_s = get_list_nested_elem_struct(obj_str)
            if pop_nested_s != "" {
                set_var_option_inner2_struct(res, pop_nested_s)
            }
            expr_result_str = res
            expr_result_type = CT_OPTION
            expr_option_inner = CT_LIST
            expr_option_inner_struct = ""
            expr_option_inner_list_elem = pop_nested
            expr_option_inner_list_struct = pop_nested_s
        } else if elem_type == CT_MAP {
            let pop_map_k = get_list_elem_map_key_type(obj_str)
            let pop_map_v = get_list_elem_map_val_type(obj_str)
            let pop_map_vs = get_list_elem_map_val_struct(obj_str)
            let k_tag = if pop_map_k >= 0 { c_type_tag(pop_map_k) } else { "str" }
            // mvfd3m: mirror the .get() path — a struct map value tags the carrier
            // by struct name and forwards the value-struct through inner2_struct.
            let v_tag = if pop_map_vs != "" { c_type_tag_for_struct(pop_map_vs) } else if pop_map_v >= 0 { c_type_tag(pop_map_v) } else { "int" }
            let map_struct = "Map_{k_tag}_{v_tag}"
            ensure_struct_option_type(map_struct)
            let opt_type = struct_option_c_type(map_struct)
            emit_line("{opt_type} {res};")
            emit_line("if (blink_list_len({obj_str}) > 0) \{")
            emit_line("    {res}.tag = 1; {res}.value = (blink_map*)blink_list_pop({obj_str});")
            emit_line("} else \{ {res}.tag = 0; }")
            set_var_option_struct(res, CT_MAP, map_struct)
            if pop_map_vs != "" {
                set_var_option_inner2_struct(res, pop_map_vs)
                expr_option_inner_map_val_struct = pop_map_vs
            }
            expr_result_str = res
            expr_result_type = CT_OPTION
            expr_option_inner = CT_MAP
            expr_option_inner_struct = map_struct
        } else if elem_type == CT_OPTION {
            // gemr3z: List[Option[T]].pop() -> Option[Option[T]] — mirror the .get()
            // CT_OPTION branch (the element Option is pointer-boxed on the list).
            // whg65a: carrier tag + inner tp threading matches .get() so a nested
            // container inner survives pop() as well.
            let oi_ct = get_list_elem_option_inner(obj_str)
            let oi_struct = get_list_elem_option_inner_struct(obj_str)
            let oi_tp = get_list_elem_option_inner_tp(obj_str)
            let opt_carrier = if oi_tp >= 0 { "Option_{tp_carrier_tag(oi_tp)}" } else if oi_struct != "" { "Option_{c_type_tag_for_struct(oi_struct)}" } else if oi_ct >= 0 { "Option_{c_type_tag(oi_ct)}" } else { "Option_int" }
            ensure_struct_option_type(opt_carrier)
            let opt_type = struct_option_c_type(opt_carrier)
            emit_line("{opt_type} {res};")
            emit_line("if (blink_list_len({obj_str}) > 0) \{")
            emit_line("    {res}.tag = 1; {res}.value = ({c_type_from_tag(opt_carrier)}*)blink_list_pop({obj_str});")
            emit_line("} else \{ {res}.tag = 0; }")
            set_var_option_struct(res, CT_OPTION, opt_carrier)
            set_var_option_inner2(res, if oi_ct >= 0 { oi_ct } else { CT_INT })
            if oi_struct != "" {
                set_var_option_inner2_struct(res, oi_struct)
            }
            // whg65a: store res's full deep tp (`Option[Option[Map]]`) so a later
            // unwrap recovers the element Option[Map] with its nested type intact —
            // mirrors the .get() CT_OPTION branch.
            if oi_tp >= 0 && (tp_get_kind(oi_tp) == CT_LIST || tp_get_kind(oi_tp) == CT_MAP) {
                set_var_option_inner_tp(res, type_option(oi_tp))
            }
            expr_result_str = res
            expr_result_type = CT_OPTION
            expr_option_inner = CT_OPTION
            expr_option_inner_struct = opt_carrier
            expr_option_inner_tp = oi_tp
        } else if elem_type == CT_RESULT {
            // gemr3z: List[Result[T,E]].pop() -> Option[Result[T,E]] — the Result twin.
            // whg65a: ok/err tags from each side's full inner tp (nested-container safe).
            let rok_ct = get_list_elem_result_ok(obj_str)
            let rerr_ct = get_list_elem_result_err(obj_str)
            let rok_struct = get_list_elem_result_ok_struct(obj_str)
            let rerr_struct = get_list_elem_result_err_struct(obj_str)
            let rok_tp = get_list_elem_result_ok_tp(obj_str)
            let rerr_tp = get_list_elem_result_err_tp(obj_str)
            let ok_tag = if rok_tp >= 0 { tp_carrier_tag(rok_tp) } else if rok_struct != "" { c_type_tag_for_struct(rok_struct) } else if rok_ct >= 0 { c_type_tag(rok_ct) } else { "int" }
            let err_tag = if rerr_tp >= 0 { tp_carrier_tag(rerr_tp) } else if rerr_struct != "" { c_type_tag_for_struct(rerr_struct) } else if rerr_ct >= 0 { c_type_tag(rerr_ct) } else { "str" }
            let res_carrier = "Result_{ok_tag}_{err_tag}"
            ensure_struct_option_type(res_carrier)
            let opt_type = struct_option_c_type(res_carrier)
            emit_line("{opt_type} {res};")
            emit_line("if (blink_list_len({obj_str}) > 0) \{")
            emit_line("    {res}.tag = 1; {res}.value = ({c_type_from_tag(res_carrier)}*)blink_list_pop({obj_str});")
            emit_line("} else \{ {res}.tag = 0; }")
            set_var_option_struct(res, CT_RESULT, res_carrier)
            expr_result_str = res
            expr_result_type = CT_OPTION
            expr_option_inner = CT_RESULT
            expr_option_inner_struct = res_carrier
        } else {
            ensure_option_type(CT_INT)
            let opt_type = option_c_type(CT_INT)
            emit_line("{opt_type} {res};")
            emit_line("if (blink_list_len({obj_str}) > 0) \{")
            emit_line("    {res}.tag = 1; {res}.value = (int64_t)(intptr_t)blink_list_pop({obj_str});")
            emit_line("} else \{ {res}.tag = 0; }")
            set_var_option(res, CT_INT)
            expr_result_str = res
            expr_result_type = CT_OPTION
            expr_option_inner = CT_INT
            expr_option_inner_struct = ""
        }
        return 1
    }
    if method == "contains" {
        // Element membership by linear scan. MVP covers primitive element
        // types (Int, Bool, Str, Float) — the equality types the language
        // already defines. Struct/enum/nested-collection elements fall
        // through to UnresolvedMethod (kk0mv7: deep collection/struct
        // equality is a separate concern; `==` on boxed structs is pointer
        // identity today, so a field-wise `.contains` would diverge from it).
        let elem_type = get_list_elem_type(obj_str)
        if elem_type != CT_INT && elem_type != CT_BOOL && elem_type != CT_STRING && elem_type != CT_FLOAT {
            return 0
        }
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let needle = expr_result_str
        let res = fresh_temp("_lc_")
        let idx = fresh_temp("_lci_")
        let n = fresh_temp("_lcn_")
        emit_line("int {res} = 0;")
        emit_line("int64_t {n} = blink_list_len({obj_str});")
        emit_line("for (int64_t {idx} = 0; {idx} < {n}; {idx}++) \{")
        if elem_type == CT_STRING {
            emit_line("    if (blink_str_eq((const char*)blink_list_get({obj_str}, {idx}), {needle})) \{ {res} = 1; break; }")
        } else if elem_type == CT_FLOAT {
            emit_line("    if (*(double*)blink_list_get({obj_str}, {idx}) == ({needle})) \{ {res} = 1; break; }")
        } else {
            emit_line("    if ((int64_t)(intptr_t)blink_list_get({obj_str}, {idx}) == ({needle})) \{ {res} = 1; break; }")
        }
        emit_line("}")
        expr_result_str = res
        expr_result_type = CT_BOOL
        return 1
    }
    if method == "get" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let idx_str = expr_result_str
        let mut elem_type = get_list_elem_type(obj_str)
        let mut elem_struct = get_list_elem_struct(obj_str)
        if elem_struct == "" && elem_type < 0 && expr_list_elem_struct != "" {
            elem_struct = expr_list_elem_struct
            elem_type = CT_VOID
        }
        let idx_tmp = fresh_temp("_lgi_")
        emit_line("int64_t {idx_tmp} = {idx_str};")
        let res = fresh_temp("_lget_")
        if (elem_type == CT_VOID || elem_type == CT_STRUCT || elem_type == CT_ENUM) && elem_struct != "" {
            ensure_struct_option_type(elem_struct)
            let opt_type = struct_option_c_type(elem_struct)
            emit_line("{opt_type} {res};")
            emit_line("if (blink_list_in_bounds({obj_str}, {idx_tmp})) \{")
            emit_line("    {res}.tag = 1; {res}.value = ({c_type_c_name(elem_struct)}*)blink_list_get({obj_str}, {idx_tmp});")
            emit_line("} else \{ {res}.tag = 0; }")
            set_var_option_struct(res, CT_VOID, elem_struct)
            expr_result_str = res
            expr_result_type = CT_OPTION
            expr_option_inner = CT_VOID
            expr_option_inner_struct = elem_struct
        } else if elem_type == CT_STRING {
            ensure_option_type(CT_STRING)
            let opt_type = option_c_type(CT_STRING)
            emit_line("{opt_type} {res};")
            emit_line("if (blink_list_in_bounds({obj_str}, {idx_tmp})) \{")
            emit_line("    {res}.tag = 1; {res}.value = (const char*)blink_list_get({obj_str}, {idx_tmp});")
            emit_line("} else \{ {res}.tag = 0; }")
            set_var_option(res, CT_STRING)
            expr_result_str = res
            expr_result_type = CT_OPTION
            expr_option_inner = CT_STRING
            expr_option_inner_struct = ""
        } else if elem_type == CT_FLOAT {
            ensure_option_type(CT_FLOAT)
            let opt_type = option_c_type(CT_FLOAT)
            emit_line("{opt_type} {res};")
            emit_line("if (blink_list_in_bounds({obj_str}, {idx_tmp})) \{")
            emit_line("    {res}.tag = 1; {res}.value = *(double*)blink_list_get({obj_str}, {idx_tmp});")
            emit_line("} else \{ {res}.tag = 0; }")
            set_var_option(res, CT_FLOAT)
            expr_result_str = res
            expr_result_type = CT_OPTION
            expr_option_inner = CT_FLOAT
            expr_option_inner_struct = ""
        } else if elem_type == CT_LIST {
            ensure_option_type(CT_LIST)
            let opt_type = option_c_type(CT_LIST)
            emit_line("{opt_type} {res};")
            emit_line("if (blink_list_in_bounds({obj_str}, {idx_tmp})) \{")
            emit_line("    {res}.tag = 1; {res}.value = (blink_list*)blink_list_get({obj_str}, {idx_tmp});")
            emit_line("} else \{ {res}.tag = 0; }")
            set_var_option(res, CT_LIST)
            let nested_et = get_list_nested_elem_type(obj_str)
            if nested_et != -1 {
                set_var_option_inner2(res, nested_et)
            }
            let nested_es = get_list_nested_elem_struct(obj_str)
            if nested_es != "" {
                set_var_option_inner2_struct(res, nested_es)
            }
            expr_result_str = res
            expr_result_type = CT_OPTION
            expr_option_inner = CT_LIST
            expr_option_inner_struct = ""
            expr_option_inner_list_elem = nested_et
            expr_option_inner_list_struct = nested_es
        } else if elem_type == CT_MAP {
            let map_k = get_list_elem_map_key_type(obj_str)
            let map_v = get_list_elem_map_val_type(obj_str)
            let map_vs = get_list_elem_map_val_struct(obj_str)
            let k_tag = if map_k >= 0 { c_type_tag(map_k) } else { "str" }
            // mvfd3m: a struct map value names the carrier by its struct tag
            // (Map_{k}_{Point}) and forwards the value-struct name through the
            // option's inner2_struct channel so the later unwrap recovers it.
            let v_tag = if map_vs != "" { c_type_tag_for_struct(map_vs) } else if map_v >= 0 { c_type_tag(map_v) } else { "int" }
            let map_struct = "Map_{k_tag}_{v_tag}"
            ensure_struct_option_type(map_struct)
            let opt_type = struct_option_c_type(map_struct)
            emit_line("{opt_type} {res};")
            emit_line("if (blink_list_in_bounds({obj_str}, {idx_tmp})) \{")
            emit_line("    {res}.tag = 1; {res}.value = (blink_map*)blink_list_get({obj_str}, {idx_tmp});")
            emit_line("} else \{ {res}.tag = 0; }")
            set_var_option_struct(res, CT_MAP, map_struct)
            if map_vs != "" {
                set_var_option_inner2_struct(res, map_vs)
                expr_option_inner_map_val_struct = map_vs
            }
            expr_result_str = res
            expr_result_type = CT_OPTION
            expr_option_inner = CT_MAP
            expr_option_inner_struct = map_struct
        } else if elem_type == CT_OPTION {
            // gemr3z: List[Option[T]].get() returns Option[Option[T]]. The element
            // Option is boxed by POINTER on the list (like a struct/map element), so
            // read it back as a `blink_<carrier>*` and carry it in a struct-option
            // whose inner IS the element's carrier tag. Mirrors the CT_MAP branch;
            // the inner Option's own inner (T) is threaded via
            // expr_option_inner + set_var_option_inner2 so the caller's match on the
            // unwrapped `Option[T]` decodes T instead of the flattened default.
            //
            // whg65a: the carrier tag comes from the element Option's full inner tp
            // (tp_carrier_tag), so a NESTED container inner — `Option[Map[Int,Str]]`
            // → `Option_Map_int_str`, not the lossy `Option_map` — keeps its K/V. The
            // inner tp is threaded via expr_option_inner_tp so the arm that unwraps
            // to the Map stamps its value type.
            let oi_ct = get_list_elem_option_inner(obj_str)
            let oi_struct = get_list_elem_option_inner_struct(obj_str)
            let oi_tp = get_list_elem_option_inner_tp(obj_str)
            let opt_carrier = if oi_tp >= 0 { "Option_{tp_carrier_tag(oi_tp)}" } else if oi_struct != "" { "Option_{c_type_tag_for_struct(oi_struct)}" } else if oi_ct >= 0 { "Option_{c_type_tag(oi_ct)}" } else { "Option_int" }
            ensure_struct_option_type(opt_carrier)
            let opt_type = struct_option_c_type(opt_carrier)
            emit_line("{opt_type} {res};")
            emit_line("if (blink_list_in_bounds({obj_str}, {idx_tmp})) \{")
            emit_line("    {res}.tag = 1; {res}.value = ({c_type_from_tag(opt_carrier)}*)blink_list_get({obj_str}, {idx_tmp});")
            emit_line("} else \{ {res}.tag = 0; }")
            set_var_option_struct(res, CT_OPTION, opt_carrier)
            let use_oi_ct = if oi_ct >= 0 { oi_ct } else { CT_INT }
            set_var_option_inner2(res, use_oi_ct)
            if oi_struct != "" {
                set_var_option_inner2_struct(res, oi_struct)
            }
            // whg65a: for a nested-container inner, store res's full deep tp
            // (`Option[Option[List[Int]]]`) so `.unwrap()` recovers the element
            // Option[List[Int]] with its List element type intact — the carrier tag
            // `Option_list` is element-agnostic and can't round-trip it.
            if oi_tp >= 0 && (tp_get_kind(oi_tp) == CT_LIST || tp_get_kind(oi_tp) == CT_MAP) {
                set_var_option_inner_tp(res, type_option(oi_tp))
            }
            expr_result_str = res
            expr_result_type = CT_OPTION
            expr_option_inner = CT_OPTION
            expr_option_inner_struct = opt_carrier
            expr_option_inner_tp = oi_tp
        } else if elem_type == CT_RESULT {
            // gemr3z: List[Result[T,E]].get() returns Option[Result[T,E]] — the Result
            // twin of the CT_OPTION branch. The element Result carrier is pointer-boxed
            // on the list; carry it in a struct-option keyed on the Result carrier tag.
            //
            // whg65a: ok/err tags come from each side's full inner tp (tp_carrier_tag)
            // so a nested container — `Result[Map[Int,Str],Str]` →
            // `Result_Map_int_str_str` — keeps its K/V.
            let rok_ct = get_list_elem_result_ok(obj_str)
            let rerr_ct = get_list_elem_result_err(obj_str)
            let rok_struct = get_list_elem_result_ok_struct(obj_str)
            let rerr_struct = get_list_elem_result_err_struct(obj_str)
            let rok_tp = get_list_elem_result_ok_tp(obj_str)
            let rerr_tp = get_list_elem_result_err_tp(obj_str)
            let ok_tag = if rok_tp >= 0 { tp_carrier_tag(rok_tp) } else if rok_struct != "" { c_type_tag_for_struct(rok_struct) } else if rok_ct >= 0 { c_type_tag(rok_ct) } else { "int" }
            let err_tag = if rerr_tp >= 0 { tp_carrier_tag(rerr_tp) } else if rerr_struct != "" { c_type_tag_for_struct(rerr_struct) } else if rerr_ct >= 0 { c_type_tag(rerr_ct) } else { "str" }
            let res_carrier = "Result_{ok_tag}_{err_tag}"
            ensure_struct_option_type(res_carrier)
            let opt_type = struct_option_c_type(res_carrier)
            emit_line("{opt_type} {res};")
            emit_line("if (blink_list_in_bounds({obj_str}, {idx_tmp})) \{")
            emit_line("    {res}.tag = 1; {res}.value = ({c_type_from_tag(res_carrier)}*)blink_list_get({obj_str}, {idx_tmp});")
            emit_line("} else \{ {res}.tag = 0; }")
            set_var_option_struct(res, CT_RESULT, res_carrier)
            expr_result_str = res
            expr_result_type = CT_OPTION
            expr_option_inner = CT_RESULT
            expr_option_inner_struct = res_carrier
        } else {
            ensure_option_type(CT_INT)
            let opt_type = option_c_type(CT_INT)
            emit_line("{opt_type} {res};")
            emit_line("if (blink_list_in_bounds({obj_str}, {idx_tmp})) \{")
            emit_line("    {res}.tag = 1; {res}.value = (int64_t)(intptr_t)blink_list_get({obj_str}, {idx_tmp});")
            emit_line("} else \{ {res}.tag = 0; }")
            set_var_option(res, CT_INT)
            expr_result_str = res
            expr_result_type = CT_OPTION
            expr_option_inner = CT_INT
            expr_option_inner_struct = ""
        }
        return 1
    }
    if method == "set" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let idx_str = expr_result_str
        emit_expr(sublist_get(args_sl, 1 + btc_arg_offset))
        reseat_bare_none_from_list_elem(obj_str)
        let val_str2 = expr_result_str
        let val_type2 = expr_result_type
        let val_struct2 = resolve_push_struct(val_str2, obj_str)
        emit_boxed_container_store("blink_list_set({obj_str}, {idx_str}, ", val_str2, val_type2, val_struct2, obj_str)
        expr_result_str = "0"
        expr_result_type = CT_VOID
        return 1
    }
    if method == "join" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let delim_str = expr_result_str
        expr_result_str = "{c_fn_name(\"str_join\")}({obj_str}, {delim_str})"
        expr_result_type = CT_STRING
        return 1
    }
    if method == "concat" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let other_str = expr_result_str
        expr_result_str = "{c_fn_name(\"list_concat\")}({obj_str}, {other_str})"
        expr_result_type = CT_LIST
        return 1
    }
    if method == "slice" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let start_str = expr_result_str
        emit_expr(sublist_get(args_sl, 1 + btc_arg_offset))
        let end_str = expr_result_str
        expr_result_str = "{c_fn_name(\"list_slice\")}({obj_str}, {start_str}, {end_str})"
        expr_result_type = CT_LIST
        return 1
    }
    0
}

/// Materialize a Map key for the v2 + kops runtime API:
///   - Str keys: pass the const char* pointer directly (inline_key=0).
///   - Inline keys (Int and friends, Bool, Char): bind to a stack temp and pass &tmp.
///     blink_map_* hashes/eq's `key_size` bytes starting at the pointer.
/// Returns the C expression to pass as the `const void* key` argument.
// MapPure + Sized methods that codegen routes through emit_map_method
// (direct blink_map_* calls), bypassing the stdlib trait impl which
// only handles Str keys. Single source of truth — keep both dispatch
// sites in emit_method_call in sync via this predicate.
fn is_map_builtin_intercept(ct: Int, method: Str) -> Bool {
    ct == CT_MAP && (method == "clear" || method == "contains_key" || method == "contains" || method == "remove" || method == "len" || method == "is_empty")
}

// CT_SET methods codegen routes through emit_set_method (direct blink_set_*
// calls with kops-boxed elements), bypassing the str-only SetPure/Sized trait
// impls. Single source of truth — both dispatch sites in emit_method_call use it.
fn is_set_builtin_intercept(ct: Int, method: Str) -> Bool {
    ct == CT_SET && (method == "insert" || method == "contains" || method == "remove" || method == "len" || method == "is_empty" || method == "union")
}

fn map_key_expr_inner(key_str: Str, key_ct: Int, key_sname: Str, for_insert: Bool) -> Str ! Codegen.Emit, Codegen.Register {
    if kops_is_struct_key(key_sname) {
        let key_c = c_type_c_name(key_sname)
        let tmp = fresh_temp("_mkey")
        if for_insert {
            // Insert stores the pointer in the slot — needs stable GC memory.
            emit_line("{key_c}* {tmp} = ({key_c}*)blink_alloc(sizeof({key_c}));")
            emit_line("*{tmp} = {key_str};")
            return "{tmp}"
        }
        emit_line("{key_c} {tmp} = {key_str};")
        return "&{tmp}"
    }
    if kops_is_inline_key(key_ct) == 0 {
        return "{key_str}"
    }
    let key_c = c_type_str(key_ct)
    let tmp = fresh_temp("_mkey")
    emit_line("{key_c} {tmp} = ({key_c})({key_str});")
    "&{tmp}"
}

fn map_key_expr(key_str: Str, key_ct: Int, key_sname: Str) -> Str ! Codegen.Emit, Codegen.Register {
    map_key_expr_inner(key_str, key_ct, key_sname, true)
}

fn map_key_expr_lookup(key_str: Str, key_ct: Int, key_sname: Str) -> Str ! Codegen.Emit, Codegen.Register {
    map_key_expr_inner(key_str, key_ct, key_sname, false)
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_map_method(node: Int, obj_str: Str, obj_node: Int, method: Str) -> Int ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let mut map_var_name = obj_str
    if node_kind(obj_node) == NodeKind.Ident {
        map_var_name = node_name(obj_node)
    }
    let base_key_ct = get_map_key_type(map_var_name)
    let base_key_sname = if base_key_ct == CT_VOID || base_key_ct == CT_STRUCT { get_map_key_struct(map_var_name) } else { "" }
    // vbhc4x: a generic-struct field Map[K,V] erases its key. The erased key CT
    // is CT_VOID when the field's key is a typevar (tp_child1_kind yields the
    // typevar's void kind) or CT_STRING when the key CT is entirely unset — both
    // are the "no concrete key" default. Recover the concrete key from the key
    // argument's memoized tid for the key-taking methods, ONLY at that erased
    // default (with no struct name) — so Map[Str,_] and a resolved Map[Int,_]
    // stay untouched. The key is arg 0 (at btc_arg_offset) for insert/get/
    // contains/contains_key/remove.
    let map_key_erased_default = (base_key_ct == CT_STRING || base_key_ct == CT_VOID) && base_key_sname == ""
    let key_taking = method == "insert" || method == "get" || method == "contains" || method == "contains_key" || method == "remove"
    let key_rec = if key_taking { recover_elem_ct_from_arg(node, btc_arg_offset, map_key_erased_default) } else { ElemRecovery { ct: -1, sname: "" } }
    let key_ct = if key_rec.ct >= 0 { key_rec.ct } else { base_key_ct }
    let key_sname = if key_rec.ct >= 0 { key_rec.sname } else { base_key_sname }

    if method == "insert" {
        let mut set_var_name = ""
        if node_kind(obj_node) == NodeKind.Ident {
            set_var_name = node_name(obj_node)
        }
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let key_str = expr_result_str
        let key_expr = map_key_expr(key_str, key_ct, key_sname)
        emit_expr(sublist_get(args_sl, 1 + btc_arg_offset))
        let val_str2 = expr_result_str
        let val_type2 = expr_result_type
        let val_list_elem = expr_list_elem_type
        let val_struct = if val_type2 == CT_STRUCT { resolve_push_struct(val_str2, "") } else { "" }
        emit_boxed_container_store("blink_map_set({obj_str}, {key_expr}, ", val_str2, val_type2, val_struct, "")
        if set_var_name != "" {
            emit_trace_state(set_var_name, "insert", val_str2, val_type2)
        }
        let map_name_for_set = if set_var_name != "" { set_var_name } else { obj_str }
        set_map_types(map_name_for_set, key_ct, val_type2, "")
        if val_struct != "" {
            set_map_value_struct(map_name_for_set, val_struct)
        }
        if val_type2 == CT_LIST && val_list_elem >= 0 {
            set_map_value_list_elem(map_name_for_set, val_list_elem)
        }
        expr_result_str = "0"
        expr_result_type = CT_VOID
        return 1
    }
    if method == "get" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let key_str = expr_result_str
        let key_expr = map_key_expr_lookup(key_str, key_ct, key_sname)
        let vtype = get_map_value_type(map_var_name)
        let vstruct = get_map_value_struct(map_var_name)
        let res = fresh_temp("_mgetopt_")
        if vstruct != "" {
            ensure_struct_option_type(vstruct)
            let opt_type = struct_option_c_type(vstruct)
            emit_line("{opt_type} {res};")
            emit_line("if (blink_map_has({obj_str}, {key_expr})) \{")
            emit_line("    {res}.tag = 1; {res}.value = ({c_type_c_name(vstruct)}*)blink_map_get({obj_str}, {key_expr});")
            emit_line("} else \{ {res}.tag = 0; }")
            set_var_option_struct(res, CT_VOID, vstruct)
            expr_result_str = res
            expr_result_type = CT_OPTION
            expr_option_inner = CT_VOID
            expr_option_inner_struct = vstruct
        } else if vtype == CT_STRING {
            ensure_option_type(CT_STRING)
            let opt_type = option_c_type(CT_STRING)
            emit_line("{opt_type} {res};")
            emit_line("if (blink_map_has({obj_str}, {key_expr})) \{")
            emit_line("    {res}.tag = 1; {res}.value = (const char*)blink_map_get({obj_str}, {key_expr});")
            emit_line("} else \{ {res}.tag = 0; }")
            set_var_option(res, CT_STRING)
            expr_result_str = res
            expr_result_type = CT_OPTION
            expr_option_inner = CT_STRING
            expr_option_inner_struct = ""
        } else if vtype == CT_LIST {
            ensure_option_type(CT_LIST)
            let opt_type = option_c_type(CT_LIST)
            emit_line("{opt_type} {res};")
            emit_line("if (blink_map_has({obj_str}, {key_expr})) \{")
            emit_line("    {res}.tag = 1; {res}.value = (blink_list*)blink_map_get({obj_str}, {key_expr});")
            emit_line("} else \{ {res}.tag = 0; }")
            set_var_option(res, CT_LIST)
            let list_elem = get_map_value_list_elem(map_var_name)
            if list_elem >= 0 {
                set_var_option_inner2(res, list_elem)
            }
            expr_result_str = res
            expr_result_type = CT_OPTION
            expr_option_inner = CT_LIST
            expr_option_inner_struct = ""
            expr_option_inner_list_elem = list_elem
        } else if vtype == CT_MAP {
            ensure_option_type(CT_MAP)
            let opt_type = option_c_type(CT_MAP)
            emit_line("{opt_type} {res};")
            emit_line("if (blink_map_has({obj_str}, {key_expr})) \{")
            emit_line("    {res}.tag = 1; {res}.value = (blink_map*)blink_map_get({obj_str}, {key_expr});")
            emit_line("} else \{ {res}.tag = 0; }")
            set_var_option(res, CT_MAP)
            let map_val_struct = get_map_value_struct(map_var_name)
            if map_val_struct != "" {
                set_var_option_inner2_struct(res, map_val_struct)
                expr_option_inner_map_val_struct = map_val_struct
            }
            let map_val_list_elem = get_map_value_list_elem(map_var_name)
            if map_val_list_elem >= 0 {
                set_var_option_inner2(res, map_val_list_elem)
                expr_option_inner_map_val_list_elem = map_val_list_elem
            }
            expr_result_str = res
            expr_result_type = CT_OPTION
            expr_option_inner = CT_MAP
            expr_option_inner_struct = ""
        } else if vtype == CT_FLOAT {
            ensure_option_type(CT_FLOAT)
            let opt_type = option_c_type(CT_FLOAT)
            emit_line("{opt_type} {res};")
            emit_line("if (blink_map_has({obj_str}, {key_expr})) \{")
            emit_line("    {res}.tag = 1; {res}.value = *(double*)blink_map_get({obj_str}, {key_expr});")
            emit_line("} else \{ {res}.tag = 0; }")
            set_var_option(res, CT_FLOAT)
            expr_result_str = res
            expr_result_type = CT_OPTION
            expr_option_inner = CT_FLOAT
            expr_option_inner_struct = ""
        } else {
            ensure_option_type(CT_INT)
            let opt_type = option_c_type(CT_INT)
            emit_line("{opt_type} {res};")
            emit_line("if (blink_map_has({obj_str}, {key_expr})) \{")
            emit_line("    {res}.tag = 1; {res}.value = (int64_t)(intptr_t)blink_map_get({obj_str}, {key_expr});")
            emit_line("} else \{ {res}.tag = 0; }")
            set_var_option(res, CT_INT)
            expr_result_str = res
            expr_result_type = CT_OPTION
            expr_option_inner = CT_INT
            expr_option_inner_struct = ""
        }
        return 1
    }
    if method == "contains_key" || method == "contains" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let key_str = expr_result_str
        let key_expr = map_key_expr_lookup(key_str, key_ct, key_sname)
        expr_result_str = "(blink_map_has({obj_str}, {key_expr}) != 0)"
        expr_result_type = CT_BOOL
        return 1
    }
    if method == "remove" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let key_str = expr_result_str
        let key_expr = map_key_expr_lookup(key_str, key_ct, key_sname)
        expr_result_str = "(blink_map_remove({obj_str}, {key_expr}) != 0)"
        expr_result_type = CT_BOOL
        return 1
    }
    if method == "len" {
        expr_result_str = "blink_map_len({obj_str})"
        expr_result_type = CT_INT
        return 1
    }
    if method == "is_empty" {
        expr_result_str = "(blink_map_len({obj_str}) == 0)"
        expr_result_type = CT_BOOL
        return 1
    }
    if method == "clear" {
        emit_line("blink_map_clear({obj_str});")
        expr_result_str = "0"
        expr_result_type = CT_VOID
        return 1
    }
    if method == "keys" {
        expr_result_str = "blink_map_keys({obj_str})"
        expr_result_type = CT_LIST
        expr_list_elem_type = key_ct
        return 1
    }
    if method == "values" {
        let vtype = get_map_value_type(map_var_name)
        expr_result_str = "blink_map_values({obj_str})"
        expr_result_type = CT_LIST
        expr_list_elem_type = vtype
        return 1
    }
    0
}

// Set elements box identically to Map keys (an element is a key with no value):
// Str → raw pointer; inline scalar (Int/Char/bool/sized-int) → `T tmp = (T)key;
// &tmp`; struct → heap-alloc for insert / stack tmp for lookup. Reuses
// map_key_expr / map_key_expr_lookup so both surfaces share one boxing path.
@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_set_method(node: Int, obj_str: Str, obj_node: Int, method: Str) -> Int ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let mut set_var_name = obj_str
    if node_kind(obj_node) == NodeKind.Ident {
        set_var_name = node_name(obj_node)
    }
    let elem_ct = get_set_elem_type(set_var_name)
    let elem_sname = if elem_ct == CT_VOID || elem_ct == CT_STRUCT { get_set_elem_struct(set_var_name) } else { "" }

    // vbhc4x: a generic-struct field Set[T] erases its element. Like the Map key
    // (emit_map_method), the erased element CT is CT_STRING (unknown field
    // default) or CT_VOID (typevar element kind) — both mean "no concrete
    // element". Recover from the insert/contains/remove argument's memoized tid,
    // ONLY at that erased default with no struct name (so Set[Str] and a resolved
    // Set[Int]/Set[Struct] are untouched). Scoped to these three element-taking
    // methods — union/len/is_empty do not box an element.
    let set_erased_default = (elem_ct == CT_STRING || elem_ct == CT_VOID) && elem_sname == ""
    if method == "insert" {
        let args_sl = node_args(node)
        let rec = recover_elem_ct_from_arg(node, btc_arg_offset, set_erased_default)
        let use_ct = if rec.ct >= 0 { rec.ct } else { elem_ct }
        let use_sname = if rec.ct >= 0 { rec.sname } else { elem_sname }
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let elem_str = expr_result_str
        let elem_expr = map_key_expr(elem_str, use_ct, use_sname)
        expr_result_str = "(blink_set_insert({obj_str}, {elem_expr}) != 0)"
        expr_result_type = CT_BOOL
        return 1
    }
    if method == "contains" {
        let args_sl = node_args(node)
        let rec = recover_elem_ct_from_arg(node, btc_arg_offset, set_erased_default)
        let use_ct = if rec.ct >= 0 { rec.ct } else { elem_ct }
        let use_sname = if rec.ct >= 0 { rec.sname } else { elem_sname }
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let elem_str = expr_result_str
        let elem_expr = map_key_expr_lookup(elem_str, use_ct, use_sname)
        expr_result_str = "(blink_set_contains({obj_str}, {elem_expr}) != 0)"
        expr_result_type = CT_BOOL
        return 1
    }
    if method == "remove" {
        let args_sl = node_args(node)
        let rec = recover_elem_ct_from_arg(node, btc_arg_offset, set_erased_default)
        let use_ct = if rec.ct >= 0 { rec.ct } else { elem_ct }
        let use_sname = if rec.ct >= 0 { rec.sname } else { elem_sname }
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let elem_str = expr_result_str
        let elem_expr = map_key_expr_lookup(elem_str, use_ct, use_sname)
        expr_result_str = "(blink_set_remove({obj_str}, {elem_expr}) != 0)"
        expr_result_type = CT_BOOL
        return 1
    }
    if method == "len" {
        expr_result_str = "blink_set_len({obj_str})"
        expr_result_type = CT_INT
        return 1
    }
    if method == "is_empty" {
        expr_result_str = "(blink_set_len({obj_str}) == 0)"
        expr_result_type = CT_BOOL
        return 1
    }
    if method == "union" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let other_str = expr_result_str
        expr_result_str = "blink_set_union({obj_str}, {other_str})"
        expr_result_type = CT_SET
        expr_list_elem_type = elem_ct
        // Carry the struct/tuple element tag onto the union result so an
        // unannotated binding (`let u = a.union(b)`) recovers it — else a
        // struct-element set would box through the broken inline-scalar path.
        expr_list_elem_struct = elem_sname
        return 1
    }
    0
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_sb_method(node: Int, obj_str: Str, _obj_node: Int, method: Str) -> Int ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    if method == "write" {
        let args_sl = node_args(node)
        let arg_node = sublist_get(args_sl, btc_arg_offset)
        let arg_kind = node_kind(arg_node)
        if arg_kind == NodeKind.InterpString {
            let parts_sl = node_elements(arg_node)
            if parts_sl != -1 {
                let mut pi = 0
                while pi < sublist_length(parts_sl) {
                    let part = sublist_get(parts_sl, pi)
                    let pk = node_kind(part)
                    if pk == NodeKind.Ident && node_str_val(part) == node_name(part) {
                        let lit = node_str_val(part)
                        if lit != "" {
                            emit_line("blink_sb_write({obj_str}, \"{escape_c_string(lit)}\");")
                        }
                    } else {
                        emit_expr(part)
                        let e_str = expr_result_str
                        let e_type = expr_result_type
                        if e_type == CT_INT {
                            emit_line("blink_sb_write_int({obj_str}, {e_str});")
                        } else if e_type == CT_FLOAT {
                            emit_line("blink_sb_write_float({obj_str}, {e_str});")
                        } else if e_type == CT_BOOL {
                            emit_line("blink_sb_write_bool({obj_str}, {e_str});")
                        } else {
                            emit_line("blink_sb_write({obj_str}, {e_str});")
                        }
                    }
                    pi = pi + 1
                }
            }
        } else {
            emit_expr(arg_node)
            let arg_str = expr_result_str
            emit_line("blink_sb_write({obj_str}, {arg_str});")
        }
        expr_result_str = "0"
        expr_result_type = CT_VOID
        return 1
    }
    if method == "write_char" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let ch_str = expr_result_str
        let ch_type = expr_result_type
        // blink_sb_write_char takes const char*. A Str arg passes straight
        // through; a Char arg (br 78b3jr) lowers to int32_t, so render it
        // via blink_char_to_str like the Char.fmt path does.
        if ch_type == CT_CHAR {
            emit_line("blink_sb_write_char({obj_str}, blink_char_to_str((int64_t){ch_str}));")
        } else {
            emit_line("blink_sb_write_char({obj_str}, {ch_str});")
        }
        expr_result_str = "0"
        expr_result_type = CT_VOID
        return 1
    }
    if method == "to_str" {
        expr_result_str = "blink_sb_to_str({obj_str})"
        expr_result_type = CT_STRING
        return 1
    }
    if method == "len" {
        expr_result_str = "blink_sb_len({obj_str})"
        expr_result_type = CT_INT
        return 1
    }
    if method == "is_empty" {
        expr_result_str = "(blink_sb_is_empty({obj_str}) != 0)"
        expr_result_type = CT_BOOL
        return 1
    }
    if method == "capacity" {
        expr_result_str = "blink_sb_capacity({obj_str})"
        expr_result_type = CT_INT
        return 1
    }
    if method == "clear" {
        emit_line("blink_sb_clear({obj_str});")
        expr_result_str = "0"
        expr_result_type = CT_VOID
        return 1
    }
    0
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_template_method(node: Int, obj_str: Str, _obj_node: Int, method: Str) -> Int ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    if method == "parts" {
        expr_result_str = "{obj_str}->parts"
        expr_result_type = CT_LIST
        set_list_elem_type(expr_result_str, CT_STRING)
        expr_list_elem_type = CT_STRING
        return 1
    }
    if method == "count" {
        expr_result_str = "{obj_str}->count"
        expr_result_type = CT_INT
        return 1
    }
    if method == "type_tag" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let idx_str = expr_result_str
        expr_result_str = "(int64_t)(intptr_t)blink_list_get({obj_str}->types, {idx_str})"
        expr_result_type = CT_INT
        return 1
    }
    if method == "get_str" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let idx_str = expr_result_str
        expr_result_str = "(const char*)blink_list_get({obj_str}->values, {idx_str})"
        expr_result_type = CT_STRING
        return 1
    }
    if method == "get_int" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let idx_str = expr_result_str
        expr_result_str = "(int64_t)(intptr_t)blink_list_get({obj_str}->values, {idx_str})"
        expr_result_type = CT_INT
        return 1
    }
    if method == "get_float" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let idx_str = expr_result_str
        let tmp = fresh_temp("_tplv_")
        let ftmp = fresh_temp("_tplf_")
        emit_line("void* {tmp} = blink_list_get({obj_str}->values, {idx_str});")
        emit_line("double {ftmp}; memcpy(&{ftmp}, &{tmp}, sizeof(double));")
        expr_result_str = ftmp
        expr_result_type = CT_FLOAT
        return 1
    }
    if method == "get_bool" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let idx_str = expr_result_str
        expr_result_str = "(int64_t)(intptr_t)blink_list_get({obj_str}->values, {idx_str})"
        expr_result_type = CT_BOOL
        return 1
    }
    0
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_bytes_method(node: Int, obj_str: Str, _obj_node: Int, method: Str) -> Int ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    if method == "len" {
        expr_result_str = "blink_bytes_len({obj_str})"
        expr_result_type = CT_INT
        return 1
    }
    if method == "is_empty" {
        expr_result_str = "(blink_bytes_is_empty({obj_str}) != 0)"
        expr_result_type = CT_BOOL
        return 1
    }
    if method == "push" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let b_str = expr_result_str
        emit_line("blink_bytes_push({obj_str}, {b_str});")
        expr_result_str = "0"
        expr_result_type = CT_VOID
        return 1
    }
    if method == "set" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let i_str = expr_result_str
        emit_expr(sublist_get(args_sl, 1 + btc_arg_offset))
        let v_str = expr_result_str
        emit_line("blink_bytes_set({obj_str}, {i_str}, {v_str});")
        expr_result_str = "0"
        expr_result_type = CT_VOID
        return 1
    }
    if method == "get" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let i_str = expr_result_str
        expr_result_str = "blink_std_bytes_bytes_get_opt({obj_str}, {i_str})"
        expr_result_type = CT_OPTION
        expr_option_inner = CT_INT
        expr_option_inner_struct = ""
        return 1
    }
    if method == "slice" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let s_str = expr_result_str
        emit_expr(sublist_get(args_sl, 1 + btc_arg_offset))
        let e_str = expr_result_str
        expr_result_str = "blink_bytes_slice({obj_str}, {s_str}, {e_str})"
        expr_result_type = CT_BYTES
        return 1
    }
    if method == "concat" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let o_str = expr_result_str
        expr_result_str = "blink_bytes_concat({obj_str}, {o_str})"
        expr_result_type = CT_BYTES
        return 1
    }
    if method == "to_hex" {
        expr_result_str = "blink_bytes_to_hex({obj_str})"
        expr_result_type = CT_STRING
        return 1
    }
    if method == "to_str" {
        expr_result_str = "blink_bytes_to_str_result({obj_str})"
        expr_result_type = CT_RESULT
        expr_result_ok_type = CT_STRING
        expr_result_ok_struct = ""
        expr_result_err_type = CT_STRING
        expr_result_err_struct = ""
        return 1
    }
    if method == "read_u16_be" || method == "read_u32_be" || method == "read_i32_be" ||
       method == "read_i64_be" || method == "read_u16_le" || method == "read_u32_le" ||
       method == "read_i32_le" || method == "read_i64_le" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let off_str = expr_result_str
        expr_result_str = "blink_std_bytes_bytes_{method}({obj_str}, {off_str})"
        expr_result_type = CT_RESULT
        expr_result_ok_type = CT_INT
        expr_result_ok_struct = ""
        expr_result_err_type = CT_STRING
        expr_result_err_struct = ""
        return 1
    }
    if method == "write_u16_be" || method == "write_u32_be" || method == "write_i32_be" ||
       method == "write_i64_be" || method == "write_u16_le" || method == "write_u32_le" ||
       method == "write_i32_le" || method == "write_i64_le" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let v_str = expr_result_str
        // write_* append unchecked (Void), so they bind straight to the raw
        // @ffi target; read_*/set_* route through bounds-checked Result
        // wrappers (blink_std_bytes_bytes_*) instead.
        emit_line("blinkrt_bytes_{method}({obj_str}, {v_str});")
        expr_result_str = "0"
        expr_result_type = CT_VOID
        return 1
    }
    if method == "set_u16_be" || method == "set_u32_be" || method == "set_i16_be" ||
       method == "set_i32_be" || method == "set_u64_be" || method == "set_i64_be" ||
       method == "set_u16_le" || method == "set_u32_le" || method == "set_i16_le" ||
       method == "set_i32_le" || method == "set_u64_le" || method == "set_i64_le" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, btc_arg_offset))
        let off_str = expr_result_str
        emit_expr(sublist_get(args_sl, 1 + btc_arg_offset))
        let v_str = expr_result_str
        expr_result_str = "blink_std_bytes_bytes_{method}({obj_str}, {off_str}, {v_str})"
        expr_result_type = CT_RESULT
        expr_result_ok_type = CT_VOID
        expr_result_ok_struct = ""
        expr_result_err_type = CT_STRING
        expr_result_err_struct = ""
        return 1
    }
    0
}

fn emit_builtin_trait_method(node: Int, obj_str: Str, obj_type: Int, obj_node: Int, method: Str) -> Int ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    if lookup_builtin_trait_impl("StrOps", obj_type) != 0 {
        if emit_str_method(node, obj_str, obj_node, method) != 0 { return 1 }
    }
    if lookup_builtin_trait_impl("ListOps", obj_type) != 0 {
        if emit_list_method(node, obj_str, obj_node, method) != 0 { return 1 }
    }
    if lookup_builtin_trait_impl("MapOps", obj_type) != 0 {
        if emit_map_method(node, obj_str, obj_node, method) != 0 { return 1 }
    }
    if lookup_builtin_trait_impl("SetOps", obj_type) != 0 {
        if emit_set_method(node, obj_str, obj_node, method) != 0 { return 1 }
    }
    if lookup_builtin_trait_impl("StringBuildOps", obj_type) != 0 {
        if emit_sb_method(node, obj_str, obj_node, method) != 0 { return 1 }
    }
    if lookup_builtin_trait_impl("BytesOps", obj_type) != 0 {
        if emit_bytes_method(node, obj_str, obj_node, method) != 0 { return 1 }
    }
    if lookup_builtin_trait_impl("TemplateOps", obj_type) != 0 {
        if emit_template_method(node, obj_str, obj_node, method) != 0 { return 1 }
    }
    0
}

// Emit a direct C printf/fprintf call with type dispatch.
// fmt_prefix is the C call prefix before the format string, e.g. "printf(" or "fprintf(stderr, ".
// prefix is an optional string prepended to the output, e.g. "[LOG] " or "".
fn emit_io_typed_direct(fmt_prefix: Str, arg_str: Str, arg_type: Int, newline: Int, prefix: Str) ! Codegen.Emit {
    let nl = if newline != 0 { "\\n" } else { "" }
    if arg_type == CT_INT {
        emit_line("{fmt_prefix}\"{prefix}%%lld{nl}\", (long long){arg_str});")
    } else if arg_type == CT_FLOAT {
        emit_line("{fmt_prefix}\"{prefix}%%g{nl}\", {arg_str});")
    } else if arg_type == CT_BOOL {
        emit_line("{fmt_prefix}\"{prefix}%%s{nl}\", {arg_str} ? \"true\" : \"false\");")
    } else {
        emit_line("{fmt_prefix}\"{prefix}%%s{nl}\", {arg_str});")
    }
}

// Emit snprintf + vtable call with type dispatch (for non-handler IO paths).
// vtable_method is the C vtable call, e.g. "__blink_ev.io->print" or "__ev->io->print".
fn emit_io_typed_vtable(vtable_method: Str, arg_str: Str, arg_type: Int, tmp_prefix: Str) ! Codegen.Emit {
    if arg_type == CT_INT {
        let tmp = fresh_temp(tmp_prefix)
        emit_line("char {tmp}[64]; snprintf({tmp}, 64, \"%%lld\", (long long){arg_str});")
        emit_line("{vtable_method}({tmp});")
    } else if arg_type == CT_FLOAT {
        let tmp = fresh_temp(tmp_prefix)
        emit_line("char {tmp}[64]; snprintf({tmp}, 64, \"%%g\", {arg_str});")
        emit_line("{vtable_method}({tmp});")
    } else if arg_type == CT_BOOL {
        emit_line("{vtable_method}({arg_str} ? \"true\" : \"false\");")
    } else {
        emit_line("{vtable_method}({arg_str});")
    }
}

// Unified IO output method emitter. Parameters:
// - trace_op: trace label (e.g. "io.println"), empty = no trace
// - direct_prefix: C call prefix for direct mode (e.g. "printf(" or "fprintf(stderr, ")
// - newline: 1 = append \n, 0 = no newline
// - vtable_method: vtable call (e.g. "__blink_ev.io->print"), empty = always direct
// - vtable_tmp: temp prefix for vtable snprintf buffers, empty if no vtable
// - direct_text_prefix: text prefix in direct mode (e.g. "[LOG] "), usually empty
// - zero_arg_direct: C statement for zero-arg call in handler body, empty = no-op
// - zero_arg_vtable: C statement for zero-arg call outside handler body, empty = no-op
@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_io_output(node: Int, trace_op: Str, direct_prefix: Str, newline: Int, vtable_method: Str, vtable_tmp: Str, direct_text_prefix: Str, zero_arg_direct: Str, zero_arg_vtable: Str) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let args_sl = node_args(node)
    if args_sl != -1 && sublist_length(args_sl) > 0 {
        emit_expr(sublist_get(args_sl, 0))
        let arg_str = expr_result_str
        let arg_type = expr_result_type
        if trace_op != "" {
            emit_trace_effect_typed("IO", trace_op, "msg", arg_str, arg_type)
        }
        if vtable_method != "" && cg_in_handler_body == 0 {
            emit_io_typed_vtable(vtable_method, arg_str, arg_type, vtable_tmp)
        } else {
            emit_io_typed_direct(direct_prefix, arg_str, arg_type, newline, direct_text_prefix)
        }
    } else if zero_arg_direct != "" || zero_arg_vtable != "" {
        if cg_in_handler_body != 0 || zero_arg_vtable == "" {
            if zero_arg_direct != "" {
                emit_line(zero_arg_direct)
            }
        } else {
            emit_line(zero_arg_vtable)
        }
    }
    expr_result_str = "0"
    expr_result_type = CT_VOID
}

@allow(UnrestoredMutation, IncompleteStateRestore)
pub fn emit_method_call(node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let obj_node = node_obj(node)
    let method = node_method(node)
    let mut mc_obj_is_local = 0
    if node_kind(obj_node) == NodeKind.Ident {
        if is_scope_var(node_name(obj_node)) != 0 {
            mc_obj_is_local = 1
        }
    }

    // Static derive method dispatch: Type.from_json(str)
    if node_kind(obj_node) == NodeKind.Ident {
        let static_type_name = node_name(obj_node)
        if method == "from_json" && has_derive_method(static_type_name, "from_json") != 0 {
            let args_sl = node_args(node)
            if args_sl != -1 && sublist_length(args_sl) > 0 {
                emit_expr(sublist_get(args_sl, 0))
                let arg_str = expr_result_str
                let tmp = fresh_temp("_deser_")
                let type_cname = c_type_c_name(static_type_name)
                let cs_tag = canonical_struct_tag(static_type_name)
                emit_line("blink_Result_{cs_tag}_str {tmp} = {type_cname}_from_json({arg_str});")
                set_var_struct(tmp, "Result_{static_type_name}_str")
                set_var(tmp, CT_VOID, 0)
                set_var_result_struct(tmp, CT_VOID, CT_STRING, static_type_name, "")
                expr_result_str = tmp
                expr_result_type = CT_RESULT
                expr_result_ok_type = CT_VOID
                expr_result_ok_struct = static_type_name
                expr_result_err_type = CT_STRING
                expr_result_err_struct = ""
                return
            }
        }
        if method == "from_str" && is_str_backed_enum(static_type_name) != 0 {
            let args_sl = node_args(node)
            if args_sl != -1 && sublist_length(args_sl) > 0 {
                emit_expr(sublist_get(args_sl, 0))
                let arg_str = expr_result_str
                let tmp = fresh_temp("_fromstr_")
                let cs_tag = canonical_struct_tag(static_type_name)
                emit_line("blink_Option_{cs_tag} {tmp} = {c_fn_name("{static_type_name}_from_str")}({arg_str});")
                set_var_struct(tmp, "Option_{static_type_name}")
                set_var(tmp, CT_OPTION, 0)
                set_var_option(tmp, CT_VOID)
                set_var_option_struct(tmp, CT_VOID, static_type_name)
                expr_result_str = tmp
                expr_result_type = CT_OPTION
                expr_result_ok_type = CT_VOID
                return
            }
        }
    }

    // Data-carrying enum variant constructor: Shape.Circle(5.0)
    if node_kind(obj_node) == NodeKind.Ident {
        let mc_obj_name = node_name(obj_node)
        if is_enum_type(mc_obj_name) != 0 && is_data_enum(mc_obj_name) != 0 {
            let vidx = get_variant_index(mc_obj_name, method)
            if vidx >= 0 {
                let tag = get_variant_tag(mc_obj_name, method)
                let fcount = get_variant_field_count(vidx)
                let args_sl = node_args(node)
                // A generic-enum qualified ctor (`Either.Left(42)` → Either[Int,Str])
                // mono's to blink_Either_Int_Str, mirroring the bare-Call path
                // (emit_expr's data-enum branch). Without this the qualified path
                // emitted the erased bare enum (blink_Either) — undeclared for a
                // generic enum (br 7q3aj0). "" (non-generic enum) keeps the bare name.
                let mono_name = register_mono_enum_from_node(node, mc_obj_name)
                let sname = if mono_name != "" { mono_name } else { mc_obj_name }
                let enum_c_name = c_type_c_name(sname)
                let mut init_str = "({enum_c_name})\{.tag = {tag}"
                if fcount > 0 && args_sl != -1 {
                    init_str = init_str.concat(", .data.{method} = \{")
                    let mut fi = 0
                    while fi < sublist_length(args_sl) && fi < fcount {
                        if fi > 0 {
                            init_str = init_str.concat(", ")
                        }
                        let field_name = get_variant_field_name(vidx, fi).unwrap()
                        let field_type = get_variant_field_type_str(vidx, fi).unwrap()
                        emit_expr(sublist_get(args_sl, fi))
                        let arg_str = expr_result_str
                        // strip_generic_args so a self-referential generic-enum variant
                        // (`Branch(Tree[T], Tree[T])`) heap-boxes its recursive payload:
                        // field_type is "Tree[T]", the enum is "Tree". Matches the
                        // bare-Call reference (emit_expr) — without the strip the box
                        // branch is skipped and the recursive field emits inline into an
                        // int64_t pointer slot (C type error) (br 7q3aj0).
                        if strip_generic_args(field_type) == mc_obj_name {
                            let box_tmp = fresh_temp("_ebox")
                            emit_line("{enum_c_name}* {box_tmp} = ({enum_c_name}*)blink_alloc(sizeof({enum_c_name}));")
                            emit_line("*{box_tmp} = {arg_str};")
                            init_str = init_str.concat(".{field_name} = (int64_t)(intptr_t){box_tmp}")
                        } else {
                            init_str = init_str.concat(".{field_name} = {arg_str}")
                        }
                        fi = fi + 1
                    }
                    init_str = init_str.concat("}")
                }
                init_str = init_str.concat("}")
                expr_result_str = init_str
                // CT_STRUCT (not CT_VOID) so a `let a: Either[Int,Str] = Either.Left(42)`
                // binding derives its LHS C type off the mono struct tag (emit_let_binding
                // gates enum_mono pickup on val_type == CT_STRUCT) — matching the bare-Call
                // path, which already returns CT_STRUCT. Otherwise the LHS erased to the
                // bare blink_Either while the RHS was the mono instance (br 7q3aj0).
                expr_result_type = CT_STRUCT
                set_var_struct(init_str, sname)
                return
            }
        }
    }

    // Bytes.new(), Bytes.from_str(s), Bytes.zeroed(n) — static constructors
    if node_kind(obj_node) == NodeKind.Ident && node_name(obj_node) == "Bytes" {
        if method == "new" {
            expr_result_str = "blink_bytes_new()"
            expr_result_type = CT_BYTES
            return
        }
        if method == "from_str" {
            let args_sl = node_args(node)
            if args_sl != -1 && sublist_length(args_sl) > 0 {
                emit_expr(sublist_get(args_sl, 0))
                let arg_str = expr_result_str
                expr_result_str = "blink_bytes_from_str({arg_str})"
                expr_result_type = CT_BYTES
                return
            }
            expr_result_str = "blink_bytes_new()"
            expr_result_type = CT_BYTES
            return
        }
        if method == "zeroed" {
            let args_sl = node_args(node)
            if args_sl != -1 && sublist_length(args_sl) > 0 {
                emit_expr(sublist_get(args_sl, 0))
                let arg_str = expr_result_str
                expr_result_str = "blink_bytes_zeroed({arg_str})"
                expr_result_type = CT_BYTES
                return
            }
        }
    }

    // Char static constructors
    if node_kind(obj_node) == NodeKind.Ident && node_name(obj_node) == "Char" {
        if method == "from_code_point" {
            let args_sl = node_args(node)
            if args_sl != -1 && sublist_length(args_sl) > 0 {
                emit_expr(sublist_get(args_sl, 0))
                let arg_str = expr_result_str
                let tmp = fresh_temp("_chcp_")
                let res_tmp = fresh_temp("_chres_")
                ensure_struct_result_type("char", "ConversionError")
                let res_type = struct_result_c_type("char", "ConversionError")
                emit_line("int64_t {tmp} = blink_char_validate_code_point({arg_str});")
                emit_line("{res_type} {res_tmp};")
                emit_line("if ({tmp} >= 0) \{ {res_tmp}.tag = 0; {res_tmp}.ok = (int32_t){tmp}; } else \{ {res_tmp}.tag = 1; {res_tmp}.err = ({c_type_c_name(\"ConversionError\")})\{.message = \"not a valid Unicode scalar value\", .source_type = \"Int\", .target_type = \"Char\"}; }")
                set_var_result_struct(res_tmp, CT_CHAR, CT_STRUCT, "", "ConversionError")
                expr_result_str = res_tmp
                expr_result_type = CT_RESULT
                expr_result_ok_type = CT_CHAR
                expr_result_err_type = CT_STRUCT
                expr_result_ok_struct = ""
                expr_result_err_struct = "ConversionError"
                return
            }
        }
    }

    // StringBuilder.new() and StringBuilder.with_capacity(n) — static constructors
    if node_kind(obj_node) == NodeKind.Ident && node_name(obj_node) == "StringBuilder" {
        if method == "new" {
            expr_result_str = "blink_sb_new()"
            expr_result_type = CT_STRINGBUILDER
            return
        }
        if method == "with_capacity" {
            let args_sl = node_args(node)
            if args_sl != -1 && sublist_length(args_sl) > 0 {
                emit_expr(sublist_get(args_sl, 0))
                let cap_str = expr_result_str
                expr_result_str = "blink_sb_with_capacity({cap_str})"
            } else {
                expr_result_str = "blink_sb_new()"
            }
            expr_result_type = CT_STRINGBUILDER
            return
        }
    }

    // Duration static constructors: Duration.nanos(n), Duration.ms(n), etc.
    if node_kind(obj_node) == NodeKind.Ident && node_name(obj_node) == "Duration" {
        let args_sl = node_args(node)
        if args_sl != -1 && sublist_length(args_sl) > 0 {
            emit_expr(sublist_get(args_sl, 0))
            let arg_str = expr_result_str
            if method == "nanos" {
                expr_result_str = "{c_fn_name(\"Duration_nanos\")}({arg_str})"
                expr_result_type = CT_DURATION
                return
            }
            if method == "ms" {
                expr_result_str = "{c_fn_name(\"Duration_ms\")}({arg_str})"
                expr_result_type = CT_DURATION
                return
            }
            if method == "seconds" {
                expr_result_str = "{c_fn_name(\"Duration_seconds\")}({arg_str})"
                expr_result_type = CT_DURATION
                return
            }
            if method == "minutes" {
                expr_result_str = "{c_fn_name(\"Duration_minutes\")}({arg_str})"
                expr_result_type = CT_DURATION
                return
            }
            if method == "hours" {
                expr_result_str = "{c_fn_name(\"Duration_hours\")}({arg_str})"
                expr_result_type = CT_DURATION
                return
            }
        }
    }

    // Instant.from_epoch_secs(n) — static constructor
    if node_kind(obj_node) == NodeKind.Ident && node_name(obj_node) == "Instant" {
        let args_sl = node_args(node)
        if method == "from_epoch_secs" && args_sl != -1 && sublist_length(args_sl) > 0 {
            emit_expr(sublist_get(args_sl, 0))
            let arg_str = expr_result_str
            expr_result_str = "{c_fn_name(\"Instant_from_epoch_secs\")}({arg_str})"
            expr_result_type = CT_INSTANT
            return
        }
    }

    // io.* output methods — unified dispatch
    if node_kind(obj_node) == NodeKind.Ident && node_name(obj_node) == "io" && mc_obj_is_local == 0 {
        let io_pfx = ev_field("io")
        if method == "println" {
            emit_io_output(node, "io.println", "printf(", 1, "{io_pfx}->print", "_io_", "", "printf(\"\\n\");", "{io_pfx}->print(\"\");")
            return
        }
        if method == "print" {
            emit_io_output(node, "io.print", "printf(", 0, "{io_pfx}->print_no_nl", "_io_nonl_", "", "", "")
            return
        }
        if method == "print_raw" {
            emit_io_output(node, "", "printf(", 0, "", "", "", "", "")
            return
        }
        if method == "eprintln" {
            emit_io_output(node, "io.eprintln", "fprintf(stderr, ", 1, "{io_pfx}->eprint", "_epr_", "", "fprintf(stderr, \"\\n\");", "{io_pfx}->eprint(\"\");")
            return
        }
        if method == "eprint" {
            emit_io_output(node, "io.eprint", "fprintf(stderr, ", 0, "{io_pfx}->eprint_no_nl", "_epr_nonl_", "", "", "")
            return
        }
        if method == "eprint_raw" {
            emit_io_output(node, "", "fprintf(stderr, ", 0, "", "", "", "", "")
            return
        }
        if method == "log" {
            emit_io_output(node, "io.log", "fprintf(stderr, ", 1, "{io_pfx}->log", "_log_", "[LOG] ", "", "")
            return
        }
        if method == "read_line" {
            let tmp = fresh_temp("_rline_")
            emit_line("const char* {tmp} = blink_stdin_read_line();")
            expr_result_str = tmp
            expr_result_type = CT_STRING
            return
        }
        if method == "read_bytes" {
            let args_sl = node_args(node)
            if args_sl != -1 && sublist_length(args_sl) > 0 {
                emit_expr(sublist_get(args_sl, 0))
                let n_str = expr_result_str
                let tmp = fresh_temp("_rbytes_")
                emit_line("blink_bytes* {tmp} = blink_stdin_read_bytes({n_str});")
                expr_result_str = tmp
            } else {
                expr_result_str = "blink_bytes_new()"
            }
            expr_result_type = CT_BYTES
            return
        }
        if method == "write" {
            let args_sl = node_args(node)
            if args_sl != -1 && sublist_length(args_sl) > 0 {
                emit_expr(sublist_get(args_sl, 0))
                emit_line("blink_stdout_write({expr_result_str});")
            }
            expr_result_str = "0"
            expr_result_type = CT_VOID
            return
        }
        if method == "write_bytes" {
            let args_sl = node_args(node)
            if args_sl != -1 && sublist_length(args_sl) > 0 {
                emit_expr(sublist_get(args_sl, 0))
                emit_line("blink_stdout_write_bytes({expr_result_str});")
            }
            expr_result_str = "0"
            expr_result_type = CT_VOID
            return
        }
    }

    // time.* methods — unified dispatch
    if node_kind(obj_node) == NodeKind.Ident && node_name(obj_node) == "time" && mc_obj_is_local == 0 {
        let time_pfx = ev_field("time")
        if method == "read" {
            expr_result_str = "({c_type_c_name(\"Instant\")})\{.nanos = {time_pfx}->read().nanos}"
            expr_result_type = CT_INSTANT
            return
        }
        if method == "sleep" {
            let args_sl = node_args(node)
            if args_sl != -1 && sublist_length(args_sl) > 0 {
                emit_expr(sublist_get(args_sl, 0))
                let dur_str = expr_result_str
                emit_line("{time_pfx}->sleep((blink_duration_struct)\{.nanos = {dur_str}.nanos});")
            }
            expr_result_str = "0"
            expr_result_type = CT_VOID
            return
        }
    }

    // ffi.scope() — intrinsic namespace constructor for a scoped FFI arena.
    // Valid only as a `with`-resource (§07:257); the WithResource codegen wires
    // the attribute((cleanup)) destructor that frees the arena on block exit.
    // Outside `with`, nothing wires cleanup and every allocation leaks, so a
    // bare `let s = ffi.scope()` binding is rejected (E0819).
    if node_kind(obj_node) == NodeKind.Ident && node_name(obj_node) == "ffi" && mc_obj_is_local == 0 && method == "scope" {
        let in_with = cg_in_ffi_scope_resource
        cg_in_ffi_scope_resource = 0
        if in_with == 0 {
            diag_error_at("FfiScopeNotWithResource", FFI_SCOPE_NOT_WITH_RESOURCE, "ffi.scope() is only valid as a `with`-resource — its allocations are freed at block exit", node, "use `with ffi.scope() as scope \{ ... }`")
        }
        expr_result_str = "blink_ffi_scope_new()"
        expr_result_type = CT_FFI_SCOPE
        return
    }

    // ── net.* operations — old blocks removed, see blink_tcp_* blocks below ──

    // net.read_line(fd) — read line from socket (unix socket primitive)
    if node_kind(obj_node) == NodeKind.Ident && node_name(obj_node) == "net" && mc_obj_is_local == 0 && method == "read_line" {
        let args_sl = node_args(node)
        if args_sl != -1 && sublist_length(args_sl) > 0 {
            emit_expr(sublist_get(args_sl, 0))
            let fd_str = expr_result_str
            let tmp = fresh_temp("__rline_")
            emit_line("const char* {tmp} = blink_socket_read_line({fd_str});")
            expr_result_str = tmp
        } else {
            expr_result_str = "\"\""
        }
        expr_result_type = CT_STRING
        return
    }

    // async.spawn(closure) — spawn async task on thread pool
    if node_kind(obj_node) == NodeKind.Ident && node_name(obj_node) == "async" && mc_obj_is_local == 0 && method == "spawn" {
        cg_uses_async = 1
        let args_sl = node_args(node)
        if args_sl != -1 && sublist_length(args_sl) > 0 {
            let spawn_arg_node = sublist_get(args_sl, 0)
            let wrapper_idx = cg_async_wrapper_counter
            cg_async_wrapper_counter = cg_async_wrapper_counter + 1
            let wrapper_name = "__async_wrapper_{wrapper_idx}"
            let task_fn_name = "__async_task_{wrapper_idx}"
            let handle_tmp = fresh_temp("__handle_")
            let arg_tmp = fresh_temp("__spawn_arg_")

            if node_kind(spawn_arg_node) == NodeKind.Closure {
                let cap_reg_idx = closure_cap_infos.len()
                emit_async_spawn_closure(spawn_arg_node, wrapper_idx, wrapper_name, task_fn_name)

                emit_line("blink_handle* {handle_tmp} = blink_handle_new();")
                emit_line("__async_arg_{wrapper_idx}_t* {arg_tmp} = (__async_arg_{wrapper_idx}_t*)blink_alloc(sizeof(__async_arg_{wrapper_idx}_t));")
                emit_line("{arg_tmp}->handle = {handle_tmp};")
                let ac_info = closure_cap_infos.get(cap_reg_idx).unwrap()
                if ac_info.count > 0 {
                    let caps_var = "__acaps_{wrapper_idx}"
                    emit_line("void** {caps_var} = (void**)blink_alloc(sizeof(void*) * {ac_info.count});")
                    let mut ci2 = 0
                    while ci2 < ac_info.count {
                        let cap_e = closure_captures.get(ac_info.start + ci2).unwrap()
                        let cap_kind = tp_get_kind(cap_e.tp_id)
                        if cap_e.is_mut != 0 {
                            emit_line("{caps_var}[{ci2}] = (void*){cap_e.name}_cell;")
                        } else if cap_kind == CT_INT {
                            emit_line("{caps_var}[{ci2}] = (void*)(intptr_t){cap_e.name};")
                        } else if cap_kind == CT_FLOAT {
                            let fp_tmp = fresh_temp("__fp_")
                            emit_line("\{double* {fp_tmp} = (double*)blink_alloc(sizeof(double)); *{fp_tmp} = {cap_e.name}; {caps_var}[{ci2}] = (void*){fp_tmp};}")
                        } else if cap_kind == CT_BOOL {
                            emit_line("{caps_var}[{ci2}] = (void*)(intptr_t){cap_e.name};")
                        } else if cap_kind == CT_STRUCT {
                            let st_tmp = fresh_temp("__st_")
                            let st_name = tp_get_sname(cap_e.tp_id)
                            let c_name = c_type_c_name(st_name)
                            emit_line("\{{c_name}* {st_tmp} = ({c_name}*)blink_alloc(sizeof({c_name})); *{st_tmp} = {cap_e.name}; {caps_var}[{ci2}] = (void*){st_tmp};}")
                        } else {
                            emit_line("{caps_var}[{ci2}] = (void*){cap_e.name};")
                        }
                        ci2 = ci2 + 1
                    }
                    emit_line("{arg_tmp}->captures = {caps_var};")
                    emit_line("{arg_tmp}->capture_count = {ac_info.count};")
                }
                emit_line("blink_threadpool_submit(__blink_pool, {wrapper_name}, (void*){arg_tmp});")
            } else {
                emit_expr(spawn_arg_node)
                let closure_str = expr_result_str
                cg_closure_defs.push("typedef struct \{")
                cg_closure_defs.push("    blink_closure* closure;")
                cg_closure_defs.push("    blink_handle* handle;")
                cg_closure_defs.push("} __async_arg_{wrapper_idx}_t;")
                cg_closure_defs.push("")
                cg_closure_defs.push("static void {wrapper_name}(void* __arg) \{")
                cg_closure_defs.push("    __async_arg_{wrapper_idx}_t* __a = (__async_arg_{wrapper_idx}_t*)__arg;")
                cg_closure_defs.push("    blink_closure* __cl = __a->closure;")
                cg_closure_defs.push("    blink_handle* __h = __a->handle;")
                cg_closure_defs.push("    int64_t __r = ((int64_t(*)(const blink_closure*))__cl->fn_ptr)(__cl);")
                cg_closure_defs.push("    blink_handle_set_result(__h, (void*)(intptr_t)__r);")
                cg_closure_defs.push("    GC_FREE(__arg);")
                cg_closure_defs.push("}")
                cg_closure_defs.push("")

                emit_line("blink_handle* {handle_tmp} = blink_handle_new();")
                emit_line("__async_arg_{wrapper_idx}_t* {arg_tmp} = (__async_arg_{wrapper_idx}_t*)blink_alloc(sizeof(__async_arg_{wrapper_idx}_t));")
                emit_line("{arg_tmp}->closure = {closure_str};")
                emit_line("{arg_tmp}->handle = {handle_tmp};")
                emit_line("blink_threadpool_submit(__blink_pool, {wrapper_name}, (void*){arg_tmp});")
            }

            if cg_async_scope_stack.len() > 0 {
                let scope_list = cg_async_scope_stack.get(cg_async_scope_stack.len() - 1).unwrap()
                emit_line("blink_list_push({scope_list}, (void*){handle_tmp});")
            }

            let spawn_ret_str = node_return_type(spawn_arg_node)
            let spawn_ret_ct = type_from_name(spawn_ret_str)
            if spawn_ret_ct == CT_RESULT {
                let ret_ann = node_type_ann(spawn_arg_node)
                if ret_ann != -1 {
                    let elems_sl = node_elements(ret_ann)
                    if elems_sl != -1 && sublist_length(elems_sl) >= 2 {
                        let ok_ann = sublist_get(elems_sl, 0)
                        let err_ann = sublist_get(elems_sl, 1)
                        let ok_name = node_name(ok_ann)
                        let err_name = node_name(err_ann)
                        let err_ct = type_from_name(err_name)
                        set_var_handle_full(handle_tmp, CT_RESULT, err_ct, ok_name, err_name)
                    } else {
                        set_var_handle(handle_tmp, CT_RESULT)
                    }
                } else {
                    set_var_handle(handle_tmp, CT_RESULT)
                }
            } else if spawn_ret_ct == CT_OPTION {
                let ret_ann = node_type_ann(spawn_arg_node)
                if ret_ann != -1 {
                    let elems_sl = node_elements(ret_ann)
                    if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
                        let inner_ann = sublist_get(elems_sl, 0)
                        let inner_name = node_name(inner_ann)
                        let inner_ct = type_from_name(inner_name)
                        set_var_handle_full(handle_tmp, CT_OPTION, inner_ct, inner_name, "")
                    } else {
                        set_var_handle(handle_tmp, CT_OPTION)
                    }
                } else {
                    set_var_handle(handle_tmp, CT_OPTION)
                }
            } else if (spawn_ret_ct == CT_VOID || spawn_ret_ct == CT_STRUCT || spawn_ret_ct == CT_ENUM) && spawn_ret_str != "Void" && spawn_ret_str != "" && (is_struct_type(spawn_ret_str) != 0 || is_enum_type(spawn_ret_str) != 0) {
                set_var_handle_full(handle_tmp, CT_STRUCT, -1, spawn_ret_str, "")
            } else if spawn_ret_str == "" || spawn_ret_str == "Void" {
                set_var_handle(handle_tmp, CT_INT)
            } else {
                set_var_handle(handle_tmp, spawn_ret_ct)
            }
            expr_result_str = handle_tmp
            expr_result_type = CT_HANDLE
        } else {
            expr_result_str = "0"
            expr_result_type = CT_VOID
        }
        return
    }

    // fs.read — read file contents
    if node_kind(obj_node) == NodeKind.Ident && node_name(obj_node) == "fs" && mc_obj_is_local == 0 && method == "read" {
        let args_sl = node_args(node)
        if args_sl != -1 && sublist_length(args_sl) > 0 {
            emit_expr(sublist_get(args_sl, 0))
            let arg_str = expr_result_str
            emit_trace_effect_str("FS.Read", "fs.read", "path", arg_str)
            expr_result_str = "blink_read_file({arg_str})"
            expr_result_type = CT_STRING
        } else {
            expr_result_str = "\"\""
            expr_result_type = CT_STRING
        }
        return
    }

    // fs.write — write file contents
    if node_kind(obj_node) == NodeKind.Ident && node_name(obj_node) == "fs" && mc_obj_is_local == 0 && method == "write" {
        let args_sl = node_args(node)
        if args_sl != -1 && sublist_length(args_sl) >= 2 {
            emit_expr(sublist_get(args_sl, 0))
            let path_str = expr_result_str
            emit_expr(sublist_get(args_sl, 1))
            let content_str = expr_result_str
            emit_trace_effect_str("FS.Write", "fs.write", "path", path_str)
            emit_line("blink_write_file({path_str}, {content_str});")
        }
        expr_result_str = "0"
        expr_result_type = CT_VOID
        return
    }

    // fs.list_dir — list directory contents
    if node_kind(obj_node) == NodeKind.Ident && node_name(obj_node) == "fs" && mc_obj_is_local == 0 && method == "list_dir" {
        let args_sl = node_args(node)
        if args_sl != -1 && sublist_length(args_sl) >= 1 {
            emit_expr(sublist_get(args_sl, 0))
            let arg_str = expr_result_str
            expr_result_str = "blink_list_dir({arg_str})"
            expr_result_type = CT_LIST
            expr_list_elem_type = CT_STRING
        } else {
            expr_result_str = "blink_list_new()"
            expr_result_type = CT_LIST
            expr_list_elem_type = CT_STRING
        }
        return
    }

    if node_kind(obj_node) == NodeKind.Ident && node_name(obj_node) == "fs" && mc_obj_is_local == 0 && method == "remove" {
        let args_sl = node_args(node)
        if args_sl != -1 && sublist_length(args_sl) >= 1 {
            emit_expr(sublist_get(args_sl, 0))
            let path_str = expr_result_str
            emit_trace_effect_str("FS.Delete", "fs.remove", "path", path_str)
            emit_line("blink_fs_remove({path_str});")
        }
        expr_result_str = "0"
        expr_result_type = CT_VOID
        return
    }

    // env.args — return List[Str] of command-line arguments
    if node_kind(obj_node) == NodeKind.Ident && node_name(obj_node) == "env" && mc_obj_is_local == 0 && method == "args" {
        let tmp = fresh_temp("_args_")
        emit_line("blink_list* {tmp} = blink_list_new();")
        emit_line("for (int __ai = 0; __ai < blink_g_argc; __ai++) \{")
        emit_line("    blink_list_push({tmp}, (void*)blink_g_argv[__ai]);")
        emit_line("}")
        set_list_elem_type(tmp, CT_STRING)
        expr_result_str = tmp
        expr_result_type = CT_LIST
        expr_list_elem_type = CT_STRING
        return
    }

    // env.* methods — unified dispatch
    if node_kind(obj_node) == NodeKind.Ident && node_name(obj_node) == "env" && mc_obj_is_local == 0 {
        let env_pfx = ev_field("env")
        if method == "var" {
            let args_sl = node_args(node)
            emit_expr(sublist_get(args_sl, 0))
            let arg_str = expr_result_str
            emit_trace_effect_str("Env.Read", "env.var", "name", arg_str)
            ensure_option_type(CT_STRING)
            let opt_type = option_c_type(CT_STRING)
            let tmp = fresh_temp("_env_")
            let res = fresh_temp("_env_opt_")
            emit_line("const char* {tmp} = {env_pfx}->read({arg_str});")
            emit_line("{opt_type} {res} = {tmp} ? ({opt_type})\{.tag = 1, .value = {tmp}} : ({opt_type})\{.tag = 0};")
            set_var_option(res, CT_STRING)
            expr_result_str = res
            expr_result_type = CT_OPTION
            expr_option_inner = CT_STRING
            expr_option_inner_struct = ""
            return
        }
        if method == "cwd" {
            emit_trace_effect_str("Env.Read", "env.cwd", "op", "\"cwd\"")
            let tmp = fresh_temp("_cwd_")
            emit_line("const char* {tmp} = {env_pfx}->cwd();")
            expr_result_str = tmp
            expr_result_type = CT_STRING
            return
        }
        if method == "set_var" {
            let args_sl = node_args(node)
            emit_expr(sublist_get(args_sl, 0))
            let name_str = expr_result_str
            emit_expr(sublist_get(args_sl, 1))
            let val_str = expr_result_str
            emit_trace_effect_str("Env.Write", "env.set_var", "name", name_str)
            emit_line("{env_pfx}->write({name_str}, {val_str});")
            expr_result_str = "0"
            expr_result_type = CT_VOID
            return
        }
        if method == "remove_var" {
            let args_sl = node_args(node)
            emit_expr(sublist_get(args_sl, 0))
            let arg_str = expr_result_str
            emit_trace_effect_str("Env.Write", "env.remove_var", "name", arg_str)
            emit_line("{env_pfx}->remove({arg_str});")
            expr_result_str = "0"
            expr_result_type = CT_VOID
            return
        }
        if method == "exit" {
            let args_sl = node_args(node)
            emit_expr(sublist_get(args_sl, 0))
            let arg_str = expr_result_str
            emit_trace_effect_typed("Env", "env.exit", "code", arg_str, CT_INT)
            emit_line("{env_pfx}->exit_fn((int){arg_str});")
            expr_result_str = "0"
            expr_result_type = CT_VOID
            return
        }
    }

    // default.method(args) — delegate to outer handler inside handler body
    if node_kind(obj_node) == NodeKind.Ident && node_name(obj_node) == "default" && mc_obj_is_local == 0 && cg_in_handler_body != 0 {
        let outer_name = "__handler_{cg_handler_body_idx}_outer"
        let args_sl = node_args(node)
        let mut args_str = ""
        if args_sl != -1 {
            let mut ai = 0
            while ai < sublist_length(args_sl) {
                if ai > 0 {
                    args_str = args_str.concat(", ")
                }
                emit_expr(sublist_get(args_sl, ai))
                args_str = args_str.concat(expr_result_str)
                ai = ai + 1
            }
        }
        expr_result_str = "{outer_name}->{method}({args_str})"
        expr_result_type = CT_VOID
        return
    }

    // User-defined effect handle dispatch: handle.method(args) -> __blink_ev.ue_handle->method(args)
    if node_kind(obj_node) == NodeKind.Ident {
        let handle_name = node_name(obj_node)
        if is_user_effect_handle(handle_name) != 0 {
            // db.connect(path) — special-case: opens handle, creates handler, and sets up cleanup
            if handle_name == "db" && method == "connect" {
                let args_sl = node_args(node)
                if args_sl != -1 && sublist_length(args_sl) > 0 {
                    emit_expr(sublist_get(args_sl, 0))
                    let path_str = expr_result_str
                    let h_tmp = fresh_temp("__db_handle_")
                    let close_fn = c_fn_name("sqlite_close")
                    emit_line("void* {h_tmp} = {c_fn_name(\"sqlite_open\")}({path_str});")
                    let tmp = fresh_temp("__db_conn_")
                    emit_line("blink_ue_db_vtable* {tmp} = {c_fn_name(\"sqlite_handler\")}({h_tmp});")
                    expr_result_str = tmp
                    expr_result_type = CT_HANDLER
                    cg_handler_vtable_type = "blink_ue_db_vtable"
                    cg_handler_vtable_field = "db"
                    cg_handler_is_user_effect = 1
                    cg_handler_cleanup_var = h_tmp
                    cg_handler_cleanup_fn = close_fn
                    return
                }
            }
            // Single lookup: extract param_types + return info from UeMethod
            let mut matched_uem_param_types: List[Int] = []
            let mut ue_ret_type = CT_VOID
            let mut ue_ret_inner = CT_VOID
            let mut ue_ret_inner_struct = ""
            let mut ue_ret_inner2 = CT_VOID
            let mut ue_ret_inner_struct2 = ""
            let mut ue_ret_c = ""
            let mut ue_ok_elem_ct = CT_VOID
            let mut ue_ok_elem_struct = ""
            let mut mi = 0
            while mi < ue_methods.len() {
                let uem = ue_methods.get(mi).unwrap()
                if uem.effect_handle == handle_name && uem.name == method {
                    matched_uem_param_types = uem.param_types
                    ue_ret_type = uem.ret_ct
                    ue_ret_inner = uem.ret_inner_ct
                    ue_ret_inner_struct = uem.ret_inner_struct
                    ue_ret_inner2 = uem.ret_inner_ct2
                    ue_ret_inner_struct2 = uem.ret_inner_struct2
                    ue_ret_c = uem.ret
                    ue_ok_elem_ct = uem.ret_ok_elem_ct
                    ue_ok_elem_struct = uem.ret_ok_elem_struct
                    break
                }
                mi = mi + 1
            }
            let args_sl = node_args(node)
            let mut args_str = ""
            if args_sl != -1 {
                let mut ai = 0
                while ai < sublist_length(args_sl) {
                    if ai > 0 {
                        args_str = args_str.concat(", ")
                    }
                    let arg_node = sublist_get(args_sl, ai)
                    let mut is_template_param = 0
                    if ai < matched_uem_param_types.len() {
                        if matched_uem_param_types.get(ai).unwrap() == CT_TEMPLATE {
                            is_template_param = 1
                        }
                    }
                    if is_template_param != 0 {
                        let arg_kind = node_kind(arg_node)
                        if arg_kind == NodeKind.InterpString {
                            emit_template_construction(arg_node)
                        } else {
                            diag_error_at("TemplateMismatch", TEMPLATE_MISMATCH, "expected Template, found Str — pass a string literal directly", arg_node, "use an interpolated string literal at the call site")
                            emit_expr(arg_node)
                        }
                    } else {
                        emit_expr(arg_node)
                    }
                    args_str = args_str.concat(expr_result_str)
                    ai = ai + 1
                }
            }
            let ue_dpfx = ev_field("ue_{handle_name}")
            if ue_ret_type == CT_VOID {
                emit_line("{ue_dpfx}->{method}({args_str});")
                expr_result_str = "0"
            } else if ue_ret_type == CT_LIST {
                let tmp = fresh_temp("__ue_ret_")
                emit_line("blink_list* {tmp} = {ue_dpfx}->{method}({args_str});")
                if ue_ret_inner_struct != "" {
                    set_list_elem_type(tmp, CT_VOID)
                    set_list_elem_struct(tmp, ue_ret_inner_struct)
                } else {
                    set_list_elem_type(tmp, ue_ret_inner)
                }
                expr_result_str = tmp
                expr_list_elem_type = ue_ret_inner
                expr_list_elem_struct = ue_ret_inner_struct
            } else if ue_ret_type == CT_OPTION {
                let opt_type = option_c_type(ue_ret_inner)
                let tmp = fresh_temp("__ue_ret_")
                emit_line("{opt_type} {tmp} = {ue_dpfx}->{method}({args_str});")
                if ue_ret_inner_struct != "" {
                    let concrete_opt = struct_option_c_type(ue_ret_inner_struct)
                    let conv = fresh_temp("__ue_conv_")
                    let struct_c = c_type_c_name(ue_ret_inner_struct)
                    emit_line("{concrete_opt} {conv};")
                    emit_line("{conv}.tag = {tmp}.tag;")
                    emit_line("if ({tmp}.tag == 1) \{ {conv}.value = ({struct_c}*){tmp}.value; }")
                    set_var_option(conv, CT_VOID)
                    expr_result_str = conv
                } else {
                    set_var_option(tmp, ue_ret_inner)
                    expr_result_str = tmp
                }
                expr_option_inner = ue_ret_inner
                expr_option_inner_struct = ue_ret_inner_struct
            } else if ue_ret_type == CT_RESULT {
                let tmp = fresh_temp("__ue_ret_")
                emit_line("{ue_ret_c} {tmp} = {ue_dpfx}->{method}({args_str});")
                if ue_ret_inner == CT_OPTION && ue_ok_elem_struct != "" {
                    let concrete_opt = struct_option_c_type(ue_ok_elem_struct)
                    let struct_c = c_type_c_name(ue_ok_elem_struct)
                    let ok_cs_tag = canonical_struct_tag(ue_ok_elem_struct)
                    let err_tag = if ue_ret_inner_struct2 != "" { canonical_struct_tag(ue_ret_inner_struct2) } else { c_type_tag(ue_ret_inner2) }
                    let concrete_res = "blink_Result_Option_{ok_cs_tag}_{err_tag}"
                    ensure_struct_option_type(ue_ok_elem_struct)
                    ensure_struct_result_type("Option_{ok_cs_tag}", err_tag)
                    let conv = fresh_temp("__ue_conv_")
                    emit_line("{concrete_res} {conv};")
                    emit_line("{conv}.tag = {tmp}.tag;")
                    emit_line("if ({tmp}.tag == 0) \{")
                    let opt_conv = fresh_temp("__ue_optc_")
                    emit_line("    {concrete_opt} {opt_conv};")
                    emit_line("    {opt_conv}.tag = {tmp}.ok.tag;")
                    emit_line("    if ({tmp}.ok.tag == 1) \{ {opt_conv}.value = ({struct_c}*){tmp}.ok.value; }")
                    emit_line("    {conv}.ok = {opt_conv};")
                    emit_line("} else \{")
                    if ue_ret_inner_struct2 != "" {
                        emit_line("    memcpy(&{conv}.err, &{tmp}.err, sizeof({tmp}.err));")
                    } else {
                        emit_line("    {conv}.err = {tmp}.err;")
                    }
                    emit_line("}")
                    set_var_result_struct(conv, ue_ret_inner, ue_ret_inner2, ue_ret_inner_struct, ue_ret_inner_struct2)
                    expr_result_str = conv
                } else {
                    if ue_ret_inner_struct != "" || ue_ret_inner_struct2 != "" {
                        set_var_result_struct(tmp, ue_ret_inner, ue_ret_inner2, ue_ret_inner_struct, ue_ret_inner_struct2)
                    } else {
                        set_var_result(tmp, ue_ret_inner, ue_ret_inner2)
                    }
                    if ue_ret_inner == CT_LIST && (ue_ok_elem_ct != CT_VOID || ue_ok_elem_struct != "") {
                        set_var_result_ok_elem(tmp, ue_ok_elem_ct, ue_ok_elem_struct)
                    }
                    expr_result_str = tmp
                }
                expr_result_ok_type = ue_ret_inner
                expr_result_err_type = ue_ret_inner2
                expr_result_ok_struct = ue_ret_inner_struct
                expr_result_err_struct = ue_ret_inner_struct2
                if ue_ret_inner == CT_LIST {
                    expr_list_elem_type = ue_ok_elem_ct
                    expr_list_elem_struct = ue_ok_elem_struct
                }
            } else {
                expr_result_str = "{ue_dpfx}->{method}({args_str})"
            }
            expr_result_type = ue_ret_type
            return
        }
    }

    // Qualified trait call: Trait.method(args) parsed as MethodCall(obj=Trait, method=method)
    if node_kind(obj_node) == NodeKind.Ident {
        let trait_name = node_name(obj_node)
        if is_trait_type(trait_name) != 0 {
            let args_sl = node_args(node)
            if args_sl != -1 && sublist_length(args_sl) > 0 {
                emit_expr(sublist_get(args_sl, 0))
                let first_str = expr_result_str
                let first_type = expr_result_type
                let type_name = get_var_struct(first_str)
                // Sealed builtin ops-traits (StrOps/ListOps/BytesOps/…) on a
                // builtin receiver dispatch to codegen intrinsics, not to a user
                // impl symbol — check this FIRST so the trait-qualified user path
                // below never claims a builtin (sb3125 regression).
                if lookup_builtin_trait_impl(trait_name, first_type) != 0 {
                    btc_arg_offset = 1
                    let bt_handled = emit_builtin_trait_method(node, first_str, first_type, obj_node, method)
                    btc_arg_offset = 0
                    if bt_handled != 0 { return }
                }
                // Genuine user impl: build the trait-qualified symbol — this is
                // the escape hatch that selects between two traits sharing a
                // method name (sb3125). The qualifier names the intended trait,
                // but only honor it when that trait actually defines the method;
                // otherwise (e.g. ListOps.is_empty, where is_empty lives in
                // Sized) resolve the real owner so the symbol matches the def.
                if type_name != "" && lookup_impl_method(type_name, method) != 0 {
                    let reg_name = impl_method_reg_name(type_name, method)
                    let owner_trait = if impl_type_implements_trait_method(reg_name, trait_name, method) != 0 { trait_name } else { impl_trait_for_method(reg_name, method) }
                    let mangled = if owner_trait != "" { mangle_impl_method_q(reg_name, owner_trait, method) } else { "{reg_name}_{method}" }
                    let mut args_str = first_str
                    let mut i = 1
                    while i < sublist_length(args_sl) {
                        args_str = args_str.concat(", ")
                        emit_expr(sublist_get(args_sl, i))
                        args_str = args_str.concat(expr_result_str)
                        i = i + 1
                    }
                    expr_result_str = "{c_fn_name(mangled)}({args_str})"
                    expr_list_elem_type = -1
                    expr_list_elem_struct = ""
                    expr_result_type = get_impl_method_ret(type_name, method)
                    return
                }
                if is_map_builtin_intercept(first_type, method) {
                    btc_arg_offset = 1
                    let mh = emit_map_method(node, first_str, obj_node, method)
                    btc_arg_offset = 0
                    if mh != 0 { return }
                }
                if is_set_builtin_intercept(first_type, method) {
                    btc_arg_offset = 1
                    let sh = emit_set_method(node, first_str, obj_node, method)
                    btc_arg_offset = 0
                    if sh != 0 { return }
                }
                // User trait impl on a builtin receiver wins over the codegen-emitted
                // builtin methods, so a stdlib `impl SomeTrait for Str` gets used here too.
                let bi_recv_name = builtin_receiver_type_name(first_type)
                if bi_recv_name != "" && lookup_impl_method(bi_recv_name, method) != 0 {
                    // The qualifier may name a sibling trait that doesn't own the
                    // method (ListOps.is_empty, where is_empty lives in Sized);
                    // resolve the real owner so the symbol matches the definition.
                    let bi_owner_trait = if impl_type_implements_trait_method(bi_recv_name, trait_name, method) != 0 { trait_name } else { impl_trait_for_method(bi_recv_name, method) }
                    let mangled = if bi_owner_trait != "" { mangle_impl_method_q(bi_recv_name, bi_owner_trait, method) } else { "{bi_recv_name}_{method}" }
                    let mut args_str = first_str
                    let mut bi_i = 1
                    while bi_i < sublist_length(args_sl) {
                        args_str = args_str.concat(", ")
                        emit_expr(sublist_get(args_sl, bi_i))
                        args_str = args_str.concat(expr_result_str)
                        bi_i = bi_i + 1
                    }
                    expr_result_str = "{c_fn_name(mangled)}({args_str})"
                    expr_list_elem_type = -1
                    expr_list_elem_struct = ""
                    expr_result_type = get_impl_method_ret(bi_recv_name, method)
                    return
                }
            }
        }
    }

    // Static From / TryFrom dispatch: Type.from(value) / Type.try_from(value)
    if node_kind(obj_node) == NodeKind.Ident && (method == "from" || method == "try_from") {
        let target_type = node_name(obj_node)
        let target_is_named = is_struct_type(target_type) != 0 || is_enum_type(target_type) != 0 || type_from_name(target_type) != CT_VOID
        if target_is_named {
            let args_sl = node_args(node)
            if args_sl != -1 && sublist_length(args_sl) > 0 {
                emit_expr(sublist_get(args_sl, 0))
                let arg_str = expr_result_str
                let arg_type = expr_result_type
                let arg_struct = get_var_struct(arg_str)
                let mut src = type_name_from_ct(arg_type)
                if arg_struct != "" {
                    src = arg_struct
                }
                let methods = if method == "from" { find_from_impl(src, target_type) } else { find_tryfrom_impl(src, target_type) }
                if methods != -1 && sublist_length(methods) > 0 {
                    let impl_fn = sublist_get(methods, 0)
                    let mangled = mangle_from_method(src, target_type, node_name(impl_fn))
                    expr_result_str = "{c_fn_name(mangled)}({arg_str})"
                    expr_result_type = get_fn_ret(mangled)
                    if method == "from" {
                        if expr_result_type == CT_VOID {
                            set_var_struct(expr_result_str, target_type)
                        }
                    } else {
                        let tf_rt = get_fn_ret_type(mangled)
                        let tf_c1 = tp_child1_kind(tf_rt.tp_id)
                        let tf_c2 = tp_child2_kind(tf_rt.tp_id)
                        if tf_c1 != -1 && tf_c2 != -1 {
                            expr_result_ok_type = tf_c1
                            expr_result_err_type = tf_c2
                            let tf_fsi = get_fn_ret_struct_inner(mangled)
                            expr_result_ok_struct = tf_fsi.ok_struct
                            expr_result_err_struct = tf_fsi.err_struct
                            if tf_fsi.ok_struct != "" || tf_fsi.err_struct != "" {
                                set_var_result_struct(expr_result_str, tf_c1, tf_c2, tf_fsi.ok_struct, tf_fsi.err_struct)
                            } else {
                                set_var_result(expr_result_str, tf_c1, tf_c2)
                            }
                        }
                    }
                    return
                }
            }
        }
    }

    // brvx89: qualified `testing.skip(reason)` is the test-skip intrinsic, not a
    // plain call to the no-op stdlib `skip`. Intercept it before the
    // module-qualified path routes it through the stdlib fn. mc_obj_is_local == 0
    // so a local named `testing` is not hijacked (mirrors the net.* guards).
    if node_kind(obj_node) == NodeKind.Ident && node_name(obj_node) == "testing" && mc_obj_is_local == 0 && method == "skip" {
        emit_skip_intrinsic(sublist_get(node_args(node), 0))
        return
    }

    // Module-qualified function call: module.function(args)
    if node_kind(obj_node) == NodeKind.Ident {
        let mq_mod_name = node_name(obj_node)
        let mq_is_intrinsic = is_intrinsic_method(mq_mod_name, method)
        if is_scope_var(mq_mod_name) == 0 && mq_is_intrinsic == 0 && is_trait_type(mq_mod_name) == 0 && is_struct_type(mq_mod_name) == 0 && is_enum_type(mq_mod_name) == 0 && is_import_module_name(mq_mod_name) != 0 {
            let mq_fn_name = resolve_import_alias(method)
            let mq_is_generic = is_generic_fn(mq_fn_name)
            if is_fn_registered(mq_fn_name) != 0 || mq_is_generic != 0 {
                let args_sl = node_args(node)
                let mut mq_args_str = ""
                let mut mq_arg_types: List[Int] = []
                let mut mq_arg_elem_types: List[Int] = []
                let mut mq_arg_err_elem_types: List[Int] = []
                let mut mq_arg_closure_sigs: List[Str] = []
                let mut mq_arg_struct_names: List[Str] = []
                let mut mq_arg_err_struct_names: List[Str] = []
                let mut mq_arg_map_key_types: List[Int] = []
                let mut mq_arg_map_key_structs: List[Str] = []
                let mut mq_arg_map_val_types: List[Int] = []
                let mut mq_arg_map_val_structs: List[Str] = []
                let mq_callee_params_sl = get_callee_params_sl(mq_fn_name)
                if args_sl != -1 {
                    let mut mqi = 0
                    while mqi < sublist_length(args_sl) {
                        if mqi > 0 {
                            mq_args_str = mq_args_str.concat(", ")
                        }
                        let mq_arg_node = sublist_get(args_sl, mqi)
                        let mq_saved_hint = cg_expect_fn_value_sig
                        cg_expect_fn_value_sig = arg_fn_value_hint(mq_callee_params_sl, mqi)
                        let mq_saved_arg_ann = cg_expect_arg_ann
                        cg_expect_arg_ann = arg_type_ann_at(mq_callee_params_sl, mqi)
                        emit_expr(mq_arg_node)
                        cg_expect_arg_ann = mq_saved_arg_ann
                        cg_expect_fn_value_sig = mq_saved_hint
                        mq_args_str = mq_args_str.concat(expr_result_str)
                        if mq_is_generic != 0 {
                            mq_arg_types.push(expr_result_type)
                            mq_arg_elem_types.push(arg_elem_type_for(expr_result_type, expr_list_elem_type))
                            mq_arg_err_elem_types.push(arg_err_elem_type_for(expr_result_type))
                            mq_arg_closure_sigs.push(expr_closure_sig)
                            mq_arg_struct_names.push(arg_struct_name_for(expr_result_type, expr_result_str, expr_list_elem_struct))
                            mq_arg_err_struct_names.push(arg_err_struct_name_for(expr_result_type))
                            let mq_map_info = arg_map_info_for(mq_arg_node, expr_result_type)
                            mq_arg_map_key_types.push(mq_map_info.kt)
                            mq_arg_map_key_structs.push(mq_map_info.ks)
                            mq_arg_map_val_types.push(mq_map_info.vt)
                            mq_arg_map_val_structs.push(mq_map_info.vs)
                        }
                        mqi = mqi + 1
                    }
                }
                mq_args_str = append_ev_arg(mq_fn_name, mq_args_str)
                if mq_is_generic != 0 {
                    let mq_ca = GenericCallArgs {
                        types: mq_arg_types,
                        elem_types: mq_arg_elem_types,
                        err_elem_types: mq_arg_err_elem_types,
                        closure_sigs: mq_arg_closure_sigs,
                        struct_names: mq_arg_struct_names,
                        err_struct_names: mq_arg_err_struct_names,
                        map_key_types: mq_arg_map_key_types,
                        map_key_structs: mq_arg_map_key_structs,
                        map_val_types: mq_arg_map_val_types,
                        map_val_structs: mq_arg_map_val_structs,
                    }
                    let mq_handled = emit_generic_fn_call_tail(node, mq_fn_name, mq_args_str, mq_ca)
                    if mq_handled != 0 {
                        return
                    }
                }
                expr_result_str = "{c_fn_name(mq_fn_name)}({mq_args_str})"
                expr_result_type = get_fn_ret(mq_fn_name)
                if expr_result_type == CT_VOID {
                    let mq_sret = get_fn_ret_struct(mq_fn_name)
                    if mq_sret != "" {
                        let mq_tmp = fresh_temp("_mqr")
                        // Resolve the return struct against the CALLEE's module,
                        // not the caller's ambient cg_current_module: when two
                        // modules share the bare type name (`Ngx`), the caller's
                        // context would pick the wrong module's C symbol (last
                        // writer of the bare mod_type_prefix key) — br eczcwr.
                        let mq_callee_mod = tc_qualifier_to_module_or_self(mq_mod_name)
                        emit_line("{c_type_c_name_in(mq_sret, mq_callee_mod)} {mq_tmp} = {c_fn_name(mq_fn_name)}({mq_args_str});")
                        set_var_struct(mq_tmp, mq_sret)
                        expr_result_str = mq_tmp
                    }
                }
                let mq_rt = get_fn_ret_type(mq_fn_name)
                expr_result_ok_struct = ""
                expr_result_err_struct = ""
                expr_option_inner_struct = ""
                expr_list_elem_struct = ""
                if expr_result_type == CT_RESULT {
                    expr_result_ok_type = tp_child1_kind(mq_rt.tp_id)
                    expr_result_err_type = tp_child2_kind(mq_rt.tp_id)
                    let mq_fsi = get_fn_ret_struct_inner(mq_fn_name)
                    expr_result_ok_struct = mq_fsi.ok_struct
                    expr_result_err_struct = mq_fsi.err_struct
                }
                if expr_result_type == CT_OPTION {
                    expr_option_inner = tp_child1_kind(mq_rt.tp_id)
                    let mq_fsi = get_fn_ret_struct_inner(mq_fn_name)
                    expr_option_inner_struct = mq_fsi.ok_struct
                }
                if expr_result_type == CT_LIST {
                    expr_list_elem_type = tp_child1_kind(mq_rt.tp_id)
                    let mq_fsi = get_fn_ret_struct_inner(mq_fn_name)
                    expr_list_elem_struct = mq_fsi.ok_struct
                }
                if expr_result_type == CT_MAP {
                    expr_map_key_type = tp_child1_kind(mq_rt.tp_id)
                    expr_map_val_type = tp_child2_kind(mq_rt.tp_id)
                }
                if expr_result_type == CT_SET {
                    expr_list_elem_type = tp_child1_kind(mq_rt.tp_id)
                }
                return
            }
        }
    }

    // net.request(req) -> Result[Response, NetError] — redirects to Blink stdlib
    if node_kind(obj_node) == NodeKind.Ident && node_name(obj_node) == "net" && mc_obj_is_local == 0 && method == "request" {
        let args_sl = node_args(node)
        if args_sl != -1 && sublist_length(args_sl) > 0 {
            emit_expr(sublist_get(args_sl, 0))
            let req_str = expr_result_str
            ensure_struct_result_type("Response", "NetError")
            let result_type = struct_result_c_type("Response", "NetError")
            let result_tmp = fresh_temp("__http_result_")
            emit_line("{result_type} {result_tmp} = {c_fn_name("http_do_request")}({req_str});")
            set_var_struct(result_tmp, "")
            set_var_result_struct(result_tmp, CT_VOID, CT_VOID, "Response", "NetError")
            expr_result_str = result_tmp
            expr_result_type = CT_RESULT
            expr_result_ok_type = CT_VOID
            expr_result_err_type = CT_VOID
            expr_result_ok_struct = "Response"
            expr_result_err_struct = "NetError"
        }
        return
    }

    // net.get/post/put/delete/head/patch — handled by Blink stdlib (http_client.bl)
    // Users should use http_client.get(), http_client.post(), etc.

    // net.listen(host, port) -> Int
    if node_kind(obj_node) == NodeKind.Ident && node_name(obj_node) == "net" && mc_obj_is_local == 0 && method == "listen" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, 0))
        let host_str = expr_result_str
        emit_expr(sublist_get(args_sl, 1))
        let port_str = expr_result_str
        expr_result_str = "blink_tcp_listen({host_str}, {port_str})"
        expr_result_type = CT_INT
        return
    }

    // net.accept(fd) -> Int
    if node_kind(obj_node) == NodeKind.Ident && node_name(obj_node) == "net" && mc_obj_is_local == 0 && method == "accept" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, 0))
        let fd_str = expr_result_str
        expr_result_str = "blink_tcp_accept({fd_str})"
        expr_result_type = CT_INT
        return
    }

    // net.read(fd, max_bytes) -> Str
    if node_kind(obj_node) == NodeKind.Ident && node_name(obj_node) == "net" && mc_obj_is_local == 0 && method == "read" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, 0))
        let fd_str = expr_result_str
        emit_expr(sublist_get(args_sl, 1))
        let max_str = expr_result_str
        expr_result_str = "blink_tcp_read({fd_str}, {max_str})"
        expr_result_type = CT_STRING
        return
    }

    // net.write(fd, data)
    if node_kind(obj_node) == NodeKind.Ident && node_name(obj_node) == "net" && mc_obj_is_local == 0 && method == "write" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, 0))
        let fd_str = expr_result_str
        emit_expr(sublist_get(args_sl, 1))
        let data_str = expr_result_str
        emit_line("blink_tcp_write({fd_str}, {data_str});")
        expr_result_str = "0"
        expr_result_type = CT_VOID
        return
    }

    // net.close(fd)
    if node_kind(obj_node) == NodeKind.Ident && node_name(obj_node) == "net" && mc_obj_is_local == 0 && method == "close" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, 0))
        let fd_str = expr_result_str
        emit_line("blink_tcp_close({fd_str});")
        expr_result_str = "0"
        expr_result_type = CT_VOID
        return
    }

    // net.connect(host, port) -> Int
    if node_kind(obj_node) == NodeKind.Ident && node_name(obj_node) == "net" && mc_obj_is_local == 0 && method == "connect" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, 0))
        let host_str = expr_result_str
        emit_expr(sublist_get(args_sl, 1))
        let port_str = expr_result_str
        expr_result_str = "blink_tcp_connect({host_str}, {port_str})"
        expr_result_type = CT_INT
        return
    }

    // net.set_timeout(fd, ms)
    if node_kind(obj_node) == NodeKind.Ident && node_name(obj_node) == "net" && mc_obj_is_local == 0 && method == "set_timeout" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, 0))
        let fd_str = expr_result_str
        emit_expr(sublist_get(args_sl, 1))
        let ms_str = expr_result_str
        emit_line("blink_tcp_set_timeout({fd_str}, {ms_str});")
        expr_result_str = "0"
        expr_result_type = CT_VOID
        return
    }

    // net.read_all(fd) -> Str
    if node_kind(obj_node) == NodeKind.Ident && node_name(obj_node) == "net" && mc_obj_is_local == 0 && method == "read_all" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, 0))
        let fd_str = expr_result_str
        expr_result_str = "blink_tcp_read_all({fd_str})"
        expr_result_type = CT_STRING
        return
    }

    // net.read_bytes(fd, max_bytes) -> Bytes (NULL on error)
    if node_kind(obj_node) == NodeKind.Ident && node_name(obj_node) == "net" && mc_obj_is_local == 0 && method == "read_bytes" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, 0))
        let fd_str = expr_result_str
        emit_expr(sublist_get(args_sl, 1))
        let max_str = expr_result_str
        expr_result_str = "blink_tcp_read_bytes({fd_str}, {max_str})"
        expr_result_type = CT_BYTES
        return
    }

    // net.write_bytes(fd, data) -> Int (0 on success, -1 on error)
    if node_kind(obj_node) == NodeKind.Ident && node_name(obj_node) == "net" && mc_obj_is_local == 0 && method == "write_bytes" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, 0))
        let fd_str = expr_result_str
        emit_expr(sublist_get(args_sl, 1))
        let data_str = expr_result_str
        expr_result_str = "blink_tcp_write_bytes({fd_str}, {data_str})"
        expr_result_type = CT_INT
        return
    }

    // term.isatty(fd) -> Int
    if node_kind(obj_node) == NodeKind.Ident && node_name(obj_node) == "term" && mc_obj_is_local == 0 && method == "isatty" {
        let args_sl = node_args(node)
        emit_expr(sublist_get(args_sl, 0))
        let fd_str = expr_result_str
        expr_result_str = "blink_term_isatty({fd_str})"
        expr_result_type = CT_INT
        return
    }

    // term.width() -> Int
    if node_kind(obj_node) == NodeKind.Ident && node_name(obj_node) == "term" && mc_obj_is_local == 0 && method == "width" {
        expr_result_str = "blink_term_width()"
        expr_result_type = CT_INT
        return
    }

    // term.height() -> Int
    if node_kind(obj_node) == NodeKind.Ident && node_name(obj_node) == "term" && mc_obj_is_local == 0 && method == "height" {
        expr_result_str = "blink_term_height()"
        expr_result_type = CT_INT
        return
    }

    emit_expr(obj_node)
    let obj_str = expr_result_str
    let obj_type = expr_result_type

    if obj_type == CT_BYTES && method == "with_ptr" {
        let args_sl = node_args(node)
        if args_sl != -1 && sublist_length(args_sl) >= 1 {
            let cls_node = sublist_get(args_sl, 0)
            if node_kind(cls_node) == NodeKind.Closure {
                let params_sl = node_params(cls_node)
                let mut user_p = ""
                if params_sl != -1 && sublist_length(params_sl) >= 1 {
                    user_p = node_name(sublist_get(params_sl, 0))
                }
                let p_c = if user_p != "" { user_p } else { fresh_temp("__wp_p_") }
                emit_line("void* {p_c} = (void*)({obj_str})->data;")
                push_scope()
                if user_p != "" {
                    set_var(user_p, CT_PTR, 0)
                }
                let body = node_body(cls_node)
                let stmts_sl = node_stmts(body)
                let mut handled = 0
                if stmts_sl != -1 {
                    let scount = sublist_length(stmts_sl)
                    if scount == 1 {
                        let only = sublist_get(stmts_sl, 0)
                        if node_kind(only) == NodeKind.ExprStmt {
                            emit_expr(node_value(only))
                            handled = 1
                        } else if is_block_bearing(node_kind(only)) != 0 {
                            // A single block-bearing expression (match/if/with) is
                            // a bare statement node, not ExprStmt-wrapped; emit it
                            // directly as the closure's single-expression value.
                            emit_expr(only)
                            handled = 1
                        }
                    }
                }
                if handled == 0 {
                    diag_error_at("WithPtrBodyTooComplex", WITH_PTR_BODY_TOO_COMPLEX, "Bytes.with_ptr body must be a single expression — extract complex logic into a helper that takes Ptr[U8]", cls_node, "use a single expression in the closure body")
                    expr_result_str = "0"
                    expr_result_type = CT_VOID
                }
                pop_scope()
                return
            }
        }
    }

    if (method == "read" || method == "write") && node_kind(obj_node) == NodeKind.FieldAccess {
        let fa_inner = node_obj(obj_node)
        if node_kind(fa_inner) == NodeKind.Ident && get_var_ffi_ptr_struct(node_name(fa_inner)) != "" {
            if method == "read" {
                expr_result_str = "({obj_str})"
                expr_result_type = obj_type
                return
            }
            let args_sl = node_args(node)
            emit_expr(sublist_get(args_sl, 0))
            let val_str = expr_result_str
            emit_line("{obj_str} = ({val_str});")
            expr_result_str = "0"
            expr_result_type = CT_VOID
            return
        }
    }

    if is_map_builtin_intercept(obj_type, method) {
        if emit_map_method(node, obj_str, obj_node, method) != 0 { return }
    }

    if is_set_builtin_intercept(obj_type, method) {
        if emit_set_method(node, obj_str, obj_node, method) != 0 { return }
    }

    // User trait impl on a builtin receiver wins over hardcoded builtin emitters,
    // including conversion methods like to_string, so users can override or extend.
    let bi_recv_name = builtin_receiver_type_name(obj_type)
    if bi_recv_name != "" && lookup_impl_method(bi_recv_name, method) != 0 {
        emit_user_impl_call(node, bi_recv_name, method, obj_str)
        return
    }

    // .into() dispatch — infer target type from assignment context
    if method == "into" {
        let target = cg_let_target_type
        if target == CT_FLOAT && obj_type == CT_INT {
            expr_result_str = "(double){obj_str}"
            expr_result_type = CT_FLOAT
            return
        }
        if target == CT_INT && obj_type == CT_FLOAT {
            expr_result_str = "(int64_t){obj_str}"
            expr_result_type = CT_INT
            return
        }
        if target == CT_STRING && obj_type == CT_INT {
            expr_result_str = "{c_fn_name(\"int_to_str\")}({obj_str})"
            expr_result_type = CT_STRING
            return
        }
        if target == CT_STRING && obj_type == CT_FLOAT {
            expr_result_str = "{c_fn_name(\"float_to_str\")}({obj_str})"
            expr_result_type = CT_STRING
            return
        }
        let mut src_name = type_name_from_ct(obj_type)
        let src_struct = get_var_struct(obj_str)
        if src_struct != "" {
            src_name = src_struct
        }
        let mut tgt_name = type_name_from_ct(target)
        if target == CT_VOID && cg_let_target_name != "" {
            tgt_name = cg_let_target_name
        }
        let from_methods = find_from_impl(src_name, tgt_name)
        if from_methods != -1 && sublist_length(from_methods) > 0 {
            let from_fn = sublist_get(from_methods, 0)
            let from_name = node_name(from_fn)
            let mangled = mangle_from_method(src_name, tgt_name, from_name)
            expr_result_str = "{c_fn_name(mangled)}({obj_str})"
            expr_result_type = target
            return
        }
        emit_line("/* into() conversion not found */")
        expr_result_str = obj_str
        expr_result_type = obj_type
        return
    }

    // Numeric conversion methods
    if method == "to_float" && obj_type == CT_INT {
        expr_result_str = "(double){obj_str}"
        expr_result_type = CT_FLOAT
        return
    }
    if method == "to_int" && obj_type == CT_FLOAT {
        expr_result_str = "(int64_t){obj_str}"
        expr_result_type = CT_INT
        return
    }
    // Sized int conversion methods: Int/sized -> sized, sized -> Int
    let is_sized_type = is_sized_int_ct(obj_type) != 0
    let is_int_compat = obj_type == CT_INT || is_sized_type
    if is_int_compat {
        if method == "to_i8" {
            expr_result_str = "(int8_t){obj_str}"
            expr_result_type = CT_I8
            return
        }
        if method == "to_i16" {
            expr_result_str = "(int16_t){obj_str}"
            expr_result_type = CT_I16
            return
        }
        if method == "to_i32" {
            expr_result_str = "(int32_t){obj_str}"
            expr_result_type = CT_I32
            return
        }
        if method == "to_u8" {
            expr_result_str = "(uint8_t){obj_str}"
            expr_result_type = CT_U8
            return
        }
        if method == "to_u16" {
            expr_result_str = "(uint16_t){obj_str}"
            expr_result_type = CT_U16
            return
        }
        if method == "to_u32" {
            expr_result_str = "(uint32_t){obj_str}"
            expr_result_type = CT_U32
            return
        }
        if method == "to_u64" {
            expr_result_str = "(uint64_t){obj_str}"
            expr_result_type = CT_U64
            return
        }
    }
    if is_sized_type && method == "to_int" {
        expr_result_str = "(int64_t){obj_str}"
        expr_result_type = CT_INT
        return
    }
    // Sized int wrapping arithmetic — modular ops that never panic on overflow.
    // C's unsigned arithmetic already wraps; signed wrapping is achieved by
    // round-tripping through the unsigned type at the same bit width.
    if is_sized_type {
        let args_sl = node_args(node)
        if method == "wrapping_add" || method == "wrapping_sub" || method == "wrapping_mul" {
            if args_sl != -1 && sublist_length(args_sl) > 0 {
                emit_expr(sublist_get(args_sl, 0))
                let rhs_str = expr_result_str
                let c_op = if method == "wrapping_add" { "+" } else if method == "wrapping_sub" { "-" } else { "*" }
                let target_c = c_type_str(obj_type)
                let unsigned_c = wrapping_unsigned_c_type(obj_type)
                expr_result_str = "({target_c})((({unsigned_c})({obj_str})) {c_op} (({unsigned_c})({rhs_str})))"
                expr_result_type = obj_type
                return
            }
        }
        if method == "wrapping_div" || method == "wrapping_rem" {
            if args_sl != -1 && sublist_length(args_sl) > 0 {
                emit_expr(sublist_get(args_sl, 0))
                let rhs_str = expr_result_str
                let c_op = if method == "wrapping_div" { "/" } else { "%" }
                let target_c = c_type_str(obj_type)
                let tname = type_name_from_ct(obj_type)
                let result_tmp = fresh_temp("__wdv")
                let lhs_tmp = fresh_temp("__wdv_l")
                let rhs_tmp = fresh_temp("__wdv_r")
                let loc_line = panic_line_str(node)
                let dz_file = panic_file_for_fmt(node)
                emit_line("{target_c} {lhs_tmp} = ({target_c})({obj_str});")
                emit_line("{target_c} {rhs_tmp} = ({target_c})({rhs_str});")
                emit_line("if ({rhs_tmp} == 0) \{ {emit_panic_site(\"panic: {tname} division by zero at {dz_file}:{loc_line}\", \"\")} }")
                emit_line("{target_c} {result_tmp} = {lhs_tmp} {c_op} {rhs_tmp};")
                expr_result_str = result_tmp
                expr_result_type = obj_type
                return
            }
        }
        if method == "wrapping_neg" {
            let target_c = c_type_str(obj_type)
            let unsigned_c = wrapping_unsigned_c_type(obj_type)
            expr_result_str = "({target_c})(-(({unsigned_c})({obj_str})))"
            expr_result_type = obj_type
            return
        }
    }
    if method == "to_string" {
        if obj_type == CT_INT {
            expr_result_str = "{c_fn_name(\"int_to_str\")}({obj_str})"
            expr_result_type = CT_STRING
            return
        }
        if obj_type == CT_FLOAT {
            expr_result_str = "{c_fn_name(\"float_to_str\")}({obj_str})"
            expr_result_type = CT_STRING
            return
        }
    }

    if obj_type == CT_CHAR {
        if method == "to_int" {
            expr_result_str = "(int64_t){obj_str}"
            expr_result_type = CT_INT
            return
        }
        if method == "to_str" {
            expr_result_str = "blink_char_to_str((int64_t){obj_str})"
            expr_result_type = CT_STRING
            return
        }
    }

    // 4q2etk: replaced by mwxtyj — builtin scalar Display: display() -> Str
    // and fmt(sb) on Int/Float/Bool/Str/Char. Uses the same helpers as
    // string interpolation. A user trait impl on the builtin receiver wins
    // (it is intercepted earlier). Simple enums lower to CT_INT, so the
    // enum guard keeps their Display impls routed to trait resolution below.
    if method == "display" && get_var_enum(obj_str) == "" {
        if obj_type == CT_INT {
            expr_result_str = "{c_fn_name("int_to_str")}({obj_str})"
            expr_result_type = CT_STRING
            return
        }
        if obj_type == CT_FLOAT {
            expr_result_str = "{c_fn_name("float_to_str")}({obj_str})"
            expr_result_type = CT_STRING
            return
        }
        if obj_type == CT_BOOL {
            expr_result_str = "(({obj_str}) ? \"true\" : \"false\")"
            expr_result_type = CT_STRING
            return
        }
        if obj_type == CT_CHAR {
            expr_result_str = "blink_char_to_str((int64_t){obj_str})"
            expr_result_type = CT_STRING
            return
        }
        if obj_type == CT_STRING {
            expr_result_str = "({obj_str})"
            expr_result_type = CT_STRING
            return
        }
    }
    if method == "fmt" && get_var_enum(obj_str) == "" && (obj_type == CT_INT || obj_type == CT_FLOAT || obj_type == CT_BOOL || obj_type == CT_CHAR || obj_type == CT_STRING) {
        let fmt_args_sl = node_args(node)
        if fmt_args_sl != -1 && sublist_length(fmt_args_sl) > 0 {
            emit_expr(sublist_get(fmt_args_sl, 0))
            let fmt_sb_str = expr_result_str
            if obj_type == CT_INT {
                emit_line("blink_sb_write_int({fmt_sb_str}, {obj_str});")
            } else if obj_type == CT_FLOAT {
                emit_line("blink_sb_write_float({fmt_sb_str}, {obj_str});")
            } else if obj_type == CT_BOOL {
                emit_line("blink_sb_write_bool({fmt_sb_str}, {obj_str});")
            } else if obj_type == CT_CHAR {
                // blink_sb_write_char takes const char* (see br ticket for
                // the Char-arg write_char bug); render via blink_char_to_str.
                emit_line("blink_sb_write({fmt_sb_str}, blink_char_to_str((int64_t){obj_str}));")
            } else {
                emit_line("blink_sb_write({fmt_sb_str}, {obj_str});")
            }
            expr_result_str = "0"
            expr_result_type = CT_VOID
            return
        }
    }

    // Trait-based builtin method dispatch
    if emit_builtin_trait_method(node, obj_str, obj_type, obj_node, method) != 0 {
        return
    }

    // Iterator adapter and consumer methods — work on both CT_LIST and CT_ITERATOR
    if (obj_type == CT_LIST || obj_type == CT_ITERATOR) && (method == "count" || method == "collect" || method == "for_each" || method == "any" || method == "all" || method == "find" || method == "fold" || method == "map" || method == "filter" || method == "take" || method == "skip" || method == "chain" || method == "flat_map" || method == "enumerate" || method == "zip") {

        // Set element type hint for closure param type inference
        if obj_type == CT_LIST {
            let hint_elem = get_list_elem_type(obj_str)
            if hint_elem != -1 {
                cg_closure_param_type_hint = hint_elem
            }
        } else if obj_type == CT_ITERATOR {
            let hint_elem = get_var_iterator_inner(obj_str)
            if hint_elem > 0 {
                cg_closure_param_type_hint = hint_elem
            }
        }

        // --- Adapter methods: return CT_ITERATOR ---

        // z9gkt3: the lazy ADAPTER HOFs .map/.filter/.take/.skip/.chain/.flat_map
        // over a List[compound] route through per-carrier adapter iterators
        // (blink_MapIterator_Option_int, …) that deref the pointer-boxed carrier.
        // 44xww4: .enumerate/.zip over a List[compound] now flow through the same
        // Tuple2-struct materialization as directly-constructed tuples — the pair's
        // compound slot rides the struct field's stype (Option_int), so .0/.1 access
        // and for (i,x) destructuring re-decode it with no extra plumbing.

        // msm1k3: iter_from_source has NO struct/enum-name channel — it lowers a
        // struct-element list to blink_list_into_iter_void / blink_Option_void, so
        // c_type_tag(elem_type) spells the pair slot "void" and the Tuple2 field
        // erases (a silent cc miscompile). This is a pre-existing iter_from_source
        // limitation shared by EVERY HOF (map/collect/take/… over List[Struct] fail
        // identically), not specific to enumerate/zip. Until msm1k3 gives
        // iter_from_source a struct channel, fail LOUDLY here rather than emit a
        // confusing C error. Fires only for a DIRECT List whose element is a real
        // struct/enum (a compound carrier tag like Option_int is not a struct type,
        // so the compound path above is unaffected).
        if obj_type == CT_LIST && (method == "enumerate" || method == "zip") {
            let es = get_list_elem_struct(obj_str)
            if es != "" && (is_struct_type(es) != 0 || is_enum_type(es) != 0) {
                diag_error_at("UnresolvedMethod", UNRESOLVED_METHOD, "'.{method}' over a List of struct/enum elements is not yet supported (br msm1k3)", node, "collect into a concrete list first, or destructure via an explicit for-loop")
                expr_result_str = "0"
                expr_result_type = CT_VOID
                return
            }
        }

        if method == "map" {
            let args_sl = node_args(node)
            emit_expr(sublist_get(args_sl, 0))
            let fn_str = expr_result_str
            let map_ret_part = closure_sig_ret_part(expr_closure_sig)
            iter_from_source(obj_str, obj_type)
            let src_var = ifs_iter_var
            let src_next = ifs_next_fn
            let elem_type = ifs_elem_type
            let carrier = ifs_carrier_tag
            if carrier != "" {
                // z9gkt3: a compound source. The adapter derefs the boxed carrier
                // for the closure INPUT; its forward element keys on the closure
                // RETURN (a scalar in the tested surface), carried as CT_INT in
                // blink_Option_int exactly as the scalar map coerces every return
                // to int64 (r1s7g2 re-derives the collect result type).
                //
                // s663bm: that int64 coercion is only sound for a single-register
                // return (int64_t / double / const char* / int). A BY-VALUE
                // multi-eightbyte return — a struct or a compound carrier
                // (blink_Option_*, blink_Result_*) — is returned in RAX:RDX under
                // SysV; the int64 cast captures only RAX and drops the payload
                // eightbyte, so the collected element is garbage and the read-back
                // deref segfaults. The SCALAR map path has the same latent bug
                // (s663bm) but is shielded by a typecheck mismatch there; the
                // compound path lost the old loud guard, so re-guard THIS case
                // loudly rather than extend a silent miscompile. Remove once s663bm
                // boxes the by-value return.
                if map_ret_part.starts_with("blink_") {
                    diag_error_at("UnresolvedMethod", UNRESOLVED_METHOD, "'.map' over a List of Option/Result elements with a by-value struct/compound closure return is not yet supported (br s663bm)", node, "return a scalar (Int/Bool/Str/Float) from the closure, or collect first then map")
                    expr_result_str = "0"
                    expr_result_type = CT_VOID
                    return
                }
                ensure_map_iter_c(carrier)
                let adapter_var = fresh_temp("__map_")
                emit_line("blink_MapIterator_{carrier} {adapter_var} = \{ .source = &{src_var}, .source_next = ({ifs_opt_type} (*)(void*)){src_next}, .fn = {fn_str} };")
                set_var_iterator(adapter_var, CT_INT, "blink_MapIterator_{carrier}_next")
                expr_result_str = adapter_var
                expr_result_type = CT_ITERATOR
                expr_iter_next_fn = "blink_MapIterator_{carrier}_next"
                expr_list_elem_type = CT_INT
                return
            }
            let tag = c_type_tag(elem_type)
            ensure_map_iter(elem_type)
            let adapter_var = fresh_temp("__map_")
            emit_line("blink_MapIterator_{tag} {adapter_var} = \{ .source = &{src_var}, .source_next = ({ifs_opt_type} (*)(void*)){src_next}, .fn = {fn_str} };")
            set_var_iterator(adapter_var, elem_type, "blink_MapIterator_{tag}_next")
            expr_result_str = adapter_var
            expr_result_type = CT_ITERATOR
            expr_iter_next_fn = "blink_MapIterator_{tag}_next"
            expr_list_elem_type = elem_type
            return
        }
        if method == "filter" {
            let args_sl = node_args(node)
            emit_expr(sublist_get(args_sl, 0))
            let fn_str = expr_result_str
            iter_from_source(obj_str, obj_type)
            let src_var = ifs_iter_var
            let src_next = ifs_next_fn
            let elem_type = ifs_elem_type
            let carrier = ifs_carrier_tag
            if carrier != "" {
                // z9gkt3: predicate takes the derefed carrier by value; the boxed
                // carrier passes through unchanged, so the result element is still
                // the compound. Store the carrier on the iterator var so a chained
                // adapter or terminal collect/for-in re-decodes it.
                ensure_filter_iter_c(carrier)
                let adapter_var = fresh_temp("__filter_")
                emit_line("blink_FilterIterator_{carrier} {adapter_var} = \{ .source = &{src_var}, .source_next = ({ifs_opt_type} (*)(void*)){src_next}, .fn = {fn_str} };")
                set_var_iterator(adapter_var, CT_INT, "blink_FilterIterator_{carrier}_next")
                set_var_iter_carrier(adapter_var, carrier)
                expr_result_str = adapter_var
                expr_result_type = CT_ITERATOR
                expr_iter_next_fn = "blink_FilterIterator_{carrier}_next"
                expr_list_elem_type = compound_tag_ct(carrier)
                return
            }
            let tag = c_type_tag(elem_type)
            ensure_filter_iter(elem_type)
            let adapter_var = fresh_temp("__filter_")
            emit_line("blink_FilterIterator_{tag} {adapter_var} = \{ .source = &{src_var}, .source_next = ({ifs_opt_type} (*)(void*)){src_next}, .fn = {fn_str} };")
            set_var_iterator(adapter_var, elem_type, "blink_FilterIterator_{tag}_next")
            expr_result_str = adapter_var
            expr_result_type = CT_ITERATOR
            expr_iter_next_fn = "blink_FilterIterator_{tag}_next"
            expr_list_elem_type = elem_type
            return
        }
        if method == "take" {
            let args_sl = node_args(node)
            emit_expr(sublist_get(args_sl, 0))
            let n_str = expr_result_str
            iter_from_source(obj_str, obj_type)
            let src_var = ifs_iter_var
            let src_next = ifs_next_fn
            let elem_type = ifs_elem_type
            let carrier = ifs_carrier_tag
            if carrier != "" {
                // z9gkt3: no closure — forward the boxed carrier verbatim (only the
                // typedef NAME differs from the scalar _int, so a same-TU scalar
                // take can't collide). Carrier stored on the var for the downstream.
                ensure_take_iter_c(carrier)
                let adapter_var = fresh_temp("__take_")
                emit_line("blink_TakeIterator_{carrier} {adapter_var} = \{ .source = &{src_var}, .source_next = ({ifs_opt_type} (*)(void*)){src_next}, .limit = {n_str}, .count = 0 };")
                set_var_iterator(adapter_var, CT_INT, "blink_TakeIterator_{carrier}_next")
                set_var_iter_carrier(adapter_var, carrier)
                expr_result_str = adapter_var
                expr_result_type = CT_ITERATOR
                expr_iter_next_fn = "blink_TakeIterator_{carrier}_next"
                expr_list_elem_type = compound_tag_ct(carrier)
                return
            }
            let tag = c_type_tag(elem_type)
            ensure_take_iter(elem_type)
            let adapter_var = fresh_temp("__take_")
            emit_line("blink_TakeIterator_{tag} {adapter_var} = \{ .source = &{src_var}, .source_next = ({ifs_opt_type} (*)(void*)){src_next}, .limit = {n_str}, .count = 0 };")
            set_var_iterator(adapter_var, elem_type, "blink_TakeIterator_{tag}_next")
            expr_result_str = adapter_var
            expr_result_type = CT_ITERATOR
            expr_iter_next_fn = "blink_TakeIterator_{tag}_next"
            expr_list_elem_type = elem_type
            return
        }
        if method == "skip" {
            let args_sl = node_args(node)
            emit_expr(sublist_get(args_sl, 0))
            let n_str = expr_result_str
            iter_from_source(obj_str, obj_type)
            let src_var = ifs_iter_var
            let src_next = ifs_next_fn
            let elem_type = ifs_elem_type
            let carrier = ifs_carrier_tag
            if carrier != "" {
                ensure_skip_iter_c(carrier)
                let adapter_var = fresh_temp("__skip_")
                emit_line("blink_SkipIterator_{carrier} {adapter_var} = \{ .source = &{src_var}, .source_next = ({ifs_opt_type} (*)(void*)){src_next}, .skip_n = {n_str}, .skipped = 0 };")
                set_var_iterator(adapter_var, CT_INT, "blink_SkipIterator_{carrier}_next")
                set_var_iter_carrier(adapter_var, carrier)
                expr_result_str = adapter_var
                expr_result_type = CT_ITERATOR
                expr_iter_next_fn = "blink_SkipIterator_{carrier}_next"
                expr_list_elem_type = compound_tag_ct(carrier)
                return
            }
            let tag = c_type_tag(elem_type)
            ensure_skip_iter(elem_type)
            let adapter_var = fresh_temp("__skip_")
            emit_line("blink_SkipIterator_{tag} {adapter_var} = \{ .source = &{src_var}, .source_next = ({ifs_opt_type} (*)(void*)){src_next}, .skip_n = {n_str}, .skipped = 0 };")
            set_var_iterator(adapter_var, elem_type, "blink_SkipIterator_{tag}_next")
            expr_result_str = adapter_var
            expr_result_type = CT_ITERATOR
            expr_iter_next_fn = "blink_SkipIterator_{tag}_next"
            expr_list_elem_type = elem_type
            return
        }
        if method == "chain" {
            let args_sl = node_args(node)
            emit_expr(sublist_get(args_sl, 0))
            let other_str = expr_result_str
            let other_type = expr_result_type
            iter_from_source(obj_str, obj_type)
            let src_a_var = ifs_iter_var
            let next_a = ifs_next_fn
            let elem_type = ifs_elem_type
            let opt_t = ifs_opt_type
            let carrier = ifs_carrier_tag
            let tag = c_type_tag(elem_type)
            iter_from_source(other_str, other_type)
            let src_b_var = ifs_iter_var
            let next_b = ifs_next_fn
            if carrier != "" {
                // z9gkt3: both sources are the same List[compound] carrier and their
                // pointer iterators both yield blink_Option_int, so a single
                // carrier-keyed chain iter forwards the boxed carrier verbatim. opt_t
                // is blink_Option_int (from the compound iter_from_source) for both.
                ensure_chain_iter_c(carrier)
                let adapter_var = fresh_temp("__chain_")
                emit_line("blink_ChainIterator_{carrier} {adapter_var} = \{ .source_a = &{src_a_var}, .next_a = ({opt_t} (*)(void*)){next_a}, .source_b = &{src_b_var}, .next_b = ({opt_t} (*)(void*)){next_b}, .phase = 0 };")
                set_var_iterator(adapter_var, CT_INT, "blink_ChainIterator_{carrier}_next")
                set_var_iter_carrier(adapter_var, carrier)
                expr_result_str = adapter_var
                expr_result_type = CT_ITERATOR
                expr_iter_next_fn = "blink_ChainIterator_{carrier}_next"
                expr_list_elem_type = compound_tag_ct(carrier)
                return
            }
            ensure_chain_iter(elem_type)
            let adapter_var = fresh_temp("__chain_")
            emit_line("blink_ChainIterator_{tag} {adapter_var} = \{ .source_a = &{src_a_var}, .next_a = ({opt_t} (*)(void*)){next_a}, .source_b = &{src_b_var}, .next_b = ({opt_t} (*)(void*)){next_b}, .phase = 0 };")
            set_var_iterator(adapter_var, elem_type, "blink_ChainIterator_{tag}_next")
            expr_result_str = adapter_var
            expr_result_type = CT_ITERATOR
            expr_iter_next_fn = "blink_ChainIterator_{tag}_next"
            expr_list_elem_type = elem_type
            return
        }
        if method == "flat_map" {
            let args_sl = node_args(node)
            emit_expr(sublist_get(args_sl, 0))
            let fn_str = expr_result_str
            iter_from_source(obj_str, obj_type)
            let src_var = ifs_iter_var
            let src_next = ifs_next_fn
            let elem_type = ifs_elem_type
            let carrier = ifs_carrier_tag
            if carrier != "" {
                // z9gkt3: the callback takes the derefed carrier and returns a
                // flattened List; the buffer elements are the flattened scalars
                // (CT_INT slot in blink_Option_int), so the forward element is CT_INT
                // — no compound carrier survives the flatten.
                ensure_flat_map_iter_c(carrier)
                let adapter_var = fresh_temp("__flatmap_")
                emit_line("blink_FlatMapIterator_{carrier} {adapter_var} = \{ .source = &{src_var}, .source_next = ({ifs_opt_type} (*)(void*)){src_next}, .fn = {fn_str}, .buffer = NULL, .buf_idx = 0 };")
                set_var_iterator(adapter_var, CT_INT, "blink_FlatMapIterator_{carrier}_next")
                expr_result_str = adapter_var
                expr_result_type = CT_ITERATOR
                expr_iter_next_fn = "blink_FlatMapIterator_{carrier}_next"
                expr_list_elem_type = CT_INT
                return
            }
            let tag = c_type_tag(elem_type)
            ensure_flat_map_iter(elem_type)
            let adapter_var = fresh_temp("__flatmap_")
            emit_line("blink_FlatMapIterator_{tag} {adapter_var} = \{ .source = &{src_var}, .source_next = ({ifs_opt_type} (*)(void*)){src_next}, .fn = {fn_str}, .buffer = NULL, .buf_idx = 0 };")
            set_var_iterator(adapter_var, elem_type, "blink_FlatMapIterator_{tag}_next")
            expr_result_str = adapter_var
            expr_result_type = CT_ITERATOR
            expr_iter_next_fn = "blink_FlatMapIterator_{tag}_next"
            expr_list_elem_type = elem_type
            return
        }
        if method == "enumerate" {
            iter_from_source(obj_str, obj_type)
            let src_var = ifs_iter_var
            let src_next = ifs_next_fn
            let elem_type = ifs_elem_type
            let opt_t = ifs_opt_type
            // 44xww4: enumerate() yields genuine (Int, T) tuples (spec §3.8/§3c).
            // The pair materializes as a Tuple2_int_<T> struct so per-slot compound
            // metadata (.1 = Option/Result), .0/.1 field access, and for (i,x)
            // destructuring all flow through the tuple-struct infra — the compound
            // case needs no extra plumbing (a scalar slot keys on its CT).
            let result_list = fresh_temp("__enum_")
            let next_var = fresh_temp("__enum_next_")
            let i_var = fresh_temp("__enum_i_")
            let slot1 = enum_zip_slot(next_var, elem_type, ifs_carrier_tag)
            let tuple_tag = "Tuple2_int_{slot1.tag}"
            ensure_tuple_type(tuple_tag, 2, "{CT_INT},{slot1.ct}", "-,{enum_zip_slot_struct_csv(slot1)}")
            let tuple_c = c_type_c_name(tuple_tag)
            emit_line("blink_list* {result_list} = blink_list_new();")
            emit_line("int64_t {i_var} = 0;")
            emit_line("while (1) \{")
            cg_indent = cg_indent + 1
            emit_line("{opt_t} {next_var} = (({opt_t} (*)(void*)){src_next})(&{src_var});")
            emit_line("if ({next_var}.tag == 0) break;")
            let pair_var = fresh_temp("__enum_pair_")
            emit_line("{tuple_c} {pair_var} = \{ ._0 = {i_var}, ._1 = {slot1.value} };")
            emit_boxed_container_store("blink_list_push({result_list}, ", pair_var, CT_VOID, tuple_tag, "")
            emit_line("{i_var}++;")
            cg_indent = cg_indent - 1
            emit_line("}")
            finish_enum_zip_result(result_list, tuple_tag)
            return
        }
        if method == "zip" {
            let args_sl = node_args(node)
            emit_expr(sublist_get(args_sl, 0))
            let other_str = expr_result_str
            let other_type = expr_result_type
            iter_from_source(obj_str, obj_type)
            let src_a_var = ifs_iter_var
            let next_a = ifs_next_fn
            let elem_type_a = ifs_elem_type
            let opt_a = ifs_opt_type
            // Capture side A's carrier before the second iter_from_source clobbers
            // ifs_carrier_tag (mirrors the next_a/opt_a capture above).
            let carrier_a = ifs_carrier_tag
            iter_from_source(other_str, other_type)
            let src_b_var = ifs_iter_var
            let next_b = ifs_next_fn
            let elem_type_b = ifs_elem_type
            let opt_b = ifs_opt_type
            let carrier_b = ifs_carrier_tag
            // 44xww4: zip() yields genuine (T, U) tuples (spec §3.8/§3c) — same
            // Tuple2 materialization as enumerate, one value slot per side.
            let result_list = fresh_temp("__zip_")
            let next_a_var = fresh_temp("__zip_na_")
            let next_b_var = fresh_temp("__zip_nb_")
            let slot_a = enum_zip_slot(next_a_var, elem_type_a, carrier_a)
            let slot_b = enum_zip_slot(next_b_var, elem_type_b, carrier_b)
            let tuple_tag = "Tuple2_{slot_a.tag}_{slot_b.tag}"
            ensure_tuple_type(tuple_tag, 2, "{slot_a.ct},{slot_b.ct}", "{enum_zip_slot_struct_csv(slot_a)},{enum_zip_slot_struct_csv(slot_b)}")
            let tuple_c = c_type_c_name(tuple_tag)
            emit_line("blink_list* {result_list} = blink_list_new();")
            emit_line("while (1) \{")
            cg_indent = cg_indent + 1
            emit_line("{opt_a} {next_a_var} = (({opt_a} (*)(void*)){next_a})(&{src_a_var});")
            emit_line("if ({next_a_var}.tag == 0) break;")
            emit_line("{opt_b} {next_b_var} = (({opt_b} (*)(void*)){next_b})(&{src_b_var});")
            emit_line("if ({next_b_var}.tag == 0) break;")
            let pair_var = fresh_temp("__zip_pair_")
            emit_line("{tuple_c} {pair_var} = \{ ._0 = {slot_a.value}, ._1 = {slot_b.value} };")
            emit_boxed_container_store("blink_list_push({result_list}, ", pair_var, CT_VOID, tuple_tag, "")
            cg_indent = cg_indent - 1
            emit_line("}")
            finish_enum_zip_result(result_list, tuple_tag)
            return
        }

        // --- Consumer methods: drive an iterator to completion ---

        if method == "collect" {
            iter_from_source(obj_str, obj_type)
            let src_var = ifs_iter_var
            let src_next = ifs_next_fn
            let elem_type = ifs_elem_type
            let opt_t = ifs_opt_type
            let carrier = ifs_carrier_tag
            let result_list = fresh_temp("__collect_")
            let next_var = fresh_temp("__collect_next_")
            emit_line("blink_list* {result_list} = blink_list_new();")
            emit_line("while (1) \{")
            cg_indent = cg_indent + 1
            emit_line("{opt_t} {next_var} = (({opt_t} (*)(void*)){src_next})(&{src_var});")
            emit_line("if ({next_var}.tag == 0) break;")
            if elem_type == CT_INT {
                // j0cdey: a compound element's `.value` is already the intptr_t to the
                // boxed carrier — push it through unchanged (keeps the pointer boxing);
                // the result list's element type is re-stamped from the source below.
                emit_line("blink_list_push({result_list}, (void*)(intptr_t){next_var}.value);")
            } else {
                emit_line("blink_list_push({result_list}, (void*){next_var}.value);")
            }
            cg_indent = cg_indent - 1
            emit_line("}")
            if carrier != "" {
                // z9gkt3: a direct List source has full element metadata to copy; a
                // var-iterator source (a chained lazy adapter — filter().collect())
                // carries only the carrier tag on its sname, so re-stamp from the tag.
                if obj_type == CT_LIST {
                    copy_list_compound_elem(obj_str, result_list)
                } else {
                    set_list_elem_compound_from_tag(result_list, carrier)
                }
                expr_result_str = result_list
                expr_result_type = CT_LIST
                expr_list_elem_type = compound_tag_ct(carrier)
                return
            }
            set_list_elem_type(result_list, elem_type)
            expr_result_str = result_list
            expr_result_type = CT_LIST
            expr_list_elem_type = elem_type
            return
        }
        if method == "count" {
            iter_from_source(obj_str, obj_type)
            let src_var = ifs_iter_var
            let src_next = ifs_next_fn
            let opt_t = ifs_opt_type
            let count_var = fresh_temp("__count_")
            let next_var = fresh_temp("__count_next_")
            emit_line("int64_t {count_var} = 0;")
            emit_line("while (1) \{")
            cg_indent = cg_indent + 1
            emit_line("{opt_t} {next_var} = (({opt_t} (*)(void*)){src_next})(&{src_var});")
            emit_line("if ({next_var}.tag == 0) break;")
            emit_line("{count_var}++;")
            cg_indent = cg_indent - 1
            emit_line("}")
            expr_result_str = count_var
            expr_result_type = CT_INT
            return
        }
        if obj_type == CT_LIST && (method == "for_each" || method == "any" || method == "all" || method == "fold") {
            let elem_ct = get_list_elem_type(obj_str)
            let elem_name = type_name_from_ct(elem_ct)
            if elem_name != "Void" {
                ensure_option_type(elem_ct)
                let stdlib_name = "list_{method}"
                let args_sl = node_args(node)
                // 0n07he Step 2a: recover the element binder's concrete tid from the
                // receiver list (tc_tid_list_elem over the object node's memoized tid),
                // carried through listop_slot_tid so it is fed as arg_tids ONLY when it
                // byte-matches the type_name_from_ct CSV segment (else -1 → string seg,
                // exactly as before). The reachable elements are scalars OR bare
                // containers (List/Map/Set/Bytes) — the `elem_name != "Void"` guard above
                // only excludes struct/enum (type_name_from_ct has no CT_STRUCT/CT_ENUM
                // case → "Void"). For both admitted kinds tc_tid_to_c_tag spells a bare
                // tag matching type_name_from_ct, so the byte-match holds; do NOT assume
                // a scalar-only shape here (a List[List[Int]].fold carries elem_name
                // "List"). The guard is what keeps every slot safe, not the element kind.
                let elem_tid = tc_tid_list_elem(tc_lookup_node_tid(node_obj(node)))
                if method == "fold" {
                    emit_expr(sublist_get(args_sl, 0))
                    let init_str = expr_result_str
                    let init_type = expr_result_type
                    let init_name = type_name_from_ct(init_type)
                    let init_tid = tc_lookup_node_tid(sublist_get(args_sl, 0))
                    emit_expr(sublist_get(args_sl, 1))
                    let fn_str = expr_result_str
                    let ta_str = "{elem_name},{init_name}"
                    let arg_tids = [listop_slot_tid(elem_tid, elem_name), listop_slot_tid(init_tid, init_name)]
                    let mangled = mangle_generic_name(stdlib_name, ta_str)
                    register_mono_fn(stdlib_name, ta_str, arg_tids)
                    register_mono_instance(stdlib_name, ta_str, arg_tids)
                    reg_fn(mangled, init_type)
                    let result_var = fresh_temp("__fold_")
                    emit_line("{c_type_str(init_type)} {result_var} = {c_fn_name(mangled)}({obj_str}, {init_str}, {fn_str});")
                    expr_result_str = result_var
                    expr_result_type = init_type
                } else {
                    emit_expr(sublist_get(args_sl, 0))
                    let fn_str = expr_result_str
                    let ta_str = elem_name
                    let arg_tids = [listop_slot_tid(elem_tid, elem_name)]
                    let mangled = mangle_generic_name(stdlib_name, ta_str)
                    register_mono_fn(stdlib_name, ta_str, arg_tids)
                    register_mono_instance(stdlib_name, ta_str, arg_tids)
                    if method == "for_each" {
                        reg_fn(mangled, CT_VOID)
                        emit_line("{c_fn_name(mangled)}({obj_str}, {fn_str});")
                        expr_result_str = "0"
                        expr_result_type = CT_VOID
                    } else {
                        reg_fn(mangled, CT_BOOL)
                        let result_var = fresh_temp("__{method}_")
                        emit_line("int {result_var} = {c_fn_name(mangled)}({obj_str}, {fn_str});")
                        expr_result_str = result_var
                        expr_result_type = CT_BOOL
                    }
                }
                return
            }
        }
        if method == "for_each" {
            let args_sl = node_args(node)
            emit_expr(sublist_get(args_sl, 0))
            let fn_str = expr_result_str
            let fn_sig = expr_closure_sig
            iter_from_source(obj_str, obj_type)
            let src_var = ifs_iter_var
            let src_next = ifs_next_fn
            let opt_t = ifs_opt_type

            let next_var = fresh_temp("__fe_next_")
            emit_line("while (1) \{")
            cg_indent = cg_indent + 1
            emit_line("{opt_t} {next_var} = (({opt_t} (*)(void*)){src_next})(&{src_var});")
            emit_line("if ({next_var}.tag == 0) break;")
            emit_line("(({fn_sig}){fn_str}->fn_ptr)({fn_str}, {hof_elem_value(next_var)});")
            cg_indent = cg_indent - 1
            emit_line("}")
            expr_result_str = "0"
            expr_result_type = CT_VOID
            return
        }
        if method == "any" {
            let args_sl = node_args(node)
            emit_expr(sublist_get(args_sl, 0))
            let fn_str = expr_result_str
            let fn_sig = expr_closure_sig
            iter_from_source(obj_str, obj_type)
            let src_var = ifs_iter_var
            let src_next = ifs_next_fn
            let opt_t = ifs_opt_type

            let result_var = fresh_temp("__any_")
            let next_var = fresh_temp("__any_next_")
            emit_line("int {result_var} = 0;")
            emit_line("while (1) \{")
            cg_indent = cg_indent + 1
            emit_line("{opt_t} {next_var} = (({opt_t} (*)(void*)){src_next})(&{src_var});")
            emit_line("if ({next_var}.tag == 0) break;")
            emit_line("if ((({fn_sig}){fn_str}->fn_ptr)({fn_str}, {hof_elem_value(next_var)})) \{ {result_var} = 1; break; }")
            cg_indent = cg_indent - 1
            emit_line("}")
            expr_result_str = result_var
            expr_result_type = CT_BOOL
            return
        }
        if method == "all" {
            let args_sl = node_args(node)
            emit_expr(sublist_get(args_sl, 0))
            let fn_str = expr_result_str
            let fn_sig = expr_closure_sig
            iter_from_source(obj_str, obj_type)
            let src_var = ifs_iter_var
            let src_next = ifs_next_fn
            let opt_t = ifs_opt_type

            let result_var = fresh_temp("__all_")
            let next_var = fresh_temp("__all_next_")
            emit_line("int {result_var} = 1;")
            emit_line("while (1) \{")
            cg_indent = cg_indent + 1
            emit_line("{opt_t} {next_var} = (({opt_t} (*)(void*)){src_next})(&{src_var});")
            emit_line("if ({next_var}.tag == 0) break;")
            emit_line("if (!(({fn_sig}){fn_str}->fn_ptr)({fn_str}, {hof_elem_value(next_var)})) \{ {result_var} = 0; break; }")
            cg_indent = cg_indent - 1
            emit_line("}")
            expr_result_str = result_var
            expr_result_type = CT_BOOL
            return
        }
        if method == "find" {
            let args_sl = node_args(node)
            emit_expr(sublist_get(args_sl, 0))
            let fn_str = expr_result_str
            let fn_sig = expr_closure_sig
            iter_from_source(obj_str, obj_type)
            let src_var = ifs_iter_var
            let src_next = ifs_next_fn
            let elem_type = ifs_elem_type
            let opt_t = ifs_opt_type
            let carrier = ifs_carrier_tag
            // j0cdey: find over List[Option[T]] returns Option[Option[T]] — the found
            // element (itself a compound) is pointer-boxed, so the result carries the
            // pointer in a struct-option keyed on the element carrier tag. The closure
            // predicate still receives the element by value (hof_elem_value derefs).
            let next_var = fresh_temp("__find_next_")
            if carrier != "" {
                // result is Option[<element>] where <element> is the compound carrier
                // (Option_int / Result_int_str). struct_option_c_type(carrier) already
                // wraps one Option level → blink_Option_Option_int; the found element's
                // pointer is stored verbatim.
                ensure_struct_option_type(carrier)
                let res_opt_t = struct_option_c_type(carrier)
                let carrier_c = c_type_from_tag(carrier)
                let result_var = fresh_temp("__find_")
                emit_line("{res_opt_t} {result_var} = ({res_opt_t})\{.tag = 0};")
                emit_line("while (1) \{")
                cg_indent = cg_indent + 1
                emit_line("{opt_t} {next_var} = (({opt_t} (*)(void*)){src_next})(&{src_var});")
                emit_line("if ({next_var}.tag == 0) break;")
                emit_line("if ((({fn_sig}){fn_str}->fn_ptr)({fn_str}, {hof_elem_value(next_var)})) \{ {result_var} = ({res_opt_t})\{.tag = 1, .value = ({carrier_c}*)(intptr_t){next_var}.value}; break; }")
                cg_indent = cg_indent - 1
                emit_line("}")
                // The found element's own kind is the carrier's CT (CT_OPTION for an
                // Option_ carrier, CT_RESULT for a Result_ carrier) — mirror .get()/
                // collect, which both derive it from compound_tag_ct. Hardcoding
                // CT_OPTION mis-registered a List[Result].find() element as an Option.
                let inner_ct = compound_tag_ct(carrier)
                set_var_option_struct(result_var, inner_ct, carrier)
                expr_result_str = result_var
                expr_result_type = CT_OPTION
                expr_option_inner = inner_ct
                expr_option_inner_struct = carrier
                return
            }
            ensure_option_type(elem_type)
            let result_var = fresh_temp("__find_")
            emit_line("{opt_t} {result_var} = ({opt_t})\{.tag = 0};")
            emit_line("while (1) \{")
            cg_indent = cg_indent + 1
            emit_line("{opt_t} {next_var} = (({opt_t} (*)(void*)){src_next})(&{src_var});")
            emit_line("if ({next_var}.tag == 0) break;")
            emit_line("if ((({fn_sig}){fn_str}->fn_ptr)({fn_str}, {next_var}.value)) \{ {result_var} = ({opt_t})\{.tag = 1, .value = {next_var}.value}; break; }")
            cg_indent = cg_indent - 1
            emit_line("}")
            set_var_option(result_var, elem_type)
            expr_result_str = result_var
            expr_result_type = CT_OPTION
            expr_option_inner = elem_type
            expr_option_inner_struct = ""
            return
        }
        if method == "fold" {
            let args_sl = node_args(node)
            emit_expr(sublist_get(args_sl, 0))
            let init_str = expr_result_str
            let init_type = expr_result_type
            emit_expr(sublist_get(args_sl, 1))
            let fn_str = expr_result_str
            let fn_sig = expr_closure_sig
            iter_from_source(obj_str, obj_type)
            let src_var = ifs_iter_var
            let src_next = ifs_next_fn
            let opt_t = ifs_opt_type
            let acc_var = fresh_temp("__fold_acc_")
            let next_var = fresh_temp("__fold_next_")
            emit_line("{c_type_str(init_type)} {acc_var} = {init_str};")
            emit_line("while (1) \{")
            cg_indent = cg_indent + 1
            emit_line("{opt_t} {next_var} = (({opt_t} (*)(void*)){src_next})(&{src_var});")
            emit_line("if ({next_var}.tag == 0) break;")
            emit_line("{acc_var} = (({fn_sig}){fn_str}->fn_ptr)({fn_str}, {acc_var}, {hof_elem_value(next_var)});")
            cg_indent = cg_indent - 1
            emit_line("}")
            expr_result_str = acc_var
            expr_result_type = init_type
            return
        }
        cg_closure_param_type_hint = -1
    }

    // Channel methods
    if obj_type == CT_CHANNEL {
        if method == "send" {
            let args_sl = node_args(node)
            emit_expr(sublist_get(args_sl, 0))
            let val_str = expr_result_str
            let val_type = expr_result_type
            if val_type == CT_INT {
                emit_line("blink_channel_send({obj_str}, (void*)(intptr_t){val_str});")
            } else {
                emit_line("blink_channel_send({obj_str}, (void*){val_str});")
            }
            expr_result_str = "0"
            expr_result_type = CT_INT
            return
        }
        if method == "recv" {
            let recv_tmp = fresh_temp("__recv_")
            let ch_inner = get_var_channel_inner(obj_str)
            emit_line("void* {recv_tmp} = blink_channel_recv({obj_str});")
            if ch_inner == CT_STRING {
                expr_result_str = "(const char*){recv_tmp}"
                expr_result_type = CT_STRING
            } else {
                expr_result_str = "(int64_t)(intptr_t){recv_tmp}"
                expr_result_type = CT_INT
            }
            return
        }
        if method == "close" {
            emit_line("blink_channel_close({obj_str});")
            expr_result_str = "0"
            expr_result_type = CT_VOID
            return
        }
    }

    // Instant methods
    if obj_type == CT_INSTANT {
        if method == "elapsed" {
            expr_result_str = "({c_type_c_name(\"Duration\")})\{.nanos = blink_Instant_elapsed((blink_instant_struct)\{.nanos = {obj_str}.nanos}).nanos}"
            expr_result_type = CT_DURATION
            return
        }
        if method == "since" {
            let args_sl = node_args(node)
            emit_expr(sublist_get(args_sl, 0))
            let other_str = expr_result_str
            expr_result_str = "{c_fn_name(\"Instant_since\")}({obj_str}, {other_str})"
            expr_result_type = CT_DURATION
            return
        }
        if method == "add" {
            let args_sl = node_args(node)
            emit_expr(sublist_get(args_sl, 0))
            let dur_str = expr_result_str
            expr_result_str = "{c_fn_name(\"Instant_add\")}({obj_str}, {dur_str})"
            expr_result_type = CT_INSTANT
            return
        }
        if method == "to_rfc3339" {
            expr_result_str = "blink_Instant_to_rfc3339((blink_instant_struct)\{.nanos = {obj_str}.nanos})"
            expr_result_type = CT_STRING
            return
        }
        if method == "to_unix_ms" {
            expr_result_str = "{c_fn_name(\"Instant_to_unix_ms\")}({obj_str})"
            expr_result_type = CT_INT
            return
        }
        if method == "to_unix_secs" {
            expr_result_str = "{c_fn_name(\"Instant_to_unix_secs\")}({obj_str})"
            expr_result_type = CT_INT
            return
        }
    }

    // Duration methods
    if obj_type == CT_DURATION {
        if method == "to_ms" {
            expr_result_str = "{c_fn_name(\"Duration_to_ms\")}({obj_str})"
            expr_result_type = CT_INT
            return
        }
        if method == "to_seconds" {
            expr_result_str = "{c_fn_name(\"Duration_to_seconds\")}({obj_str})"
            expr_result_type = CT_INT
            return
        }
        if method == "to_nanos" {
            expr_result_str = "{c_fn_name(\"Duration_to_nanos\")}({obj_str})"
            expr_result_type = CT_INT
            return
        }
        if method == "add" {
            let args_sl = node_args(node)
            emit_expr(sublist_get(args_sl, 0))
            let other_str = expr_result_str
            expr_result_str = "{c_fn_name(\"Duration_add\")}({obj_str}, {other_str})"
            expr_result_type = CT_DURATION
            return
        }
        if method == "sub" {
            let args_sl = node_args(node)
            emit_expr(sublist_get(args_sl, 0))
            let other_str = expr_result_str
            expr_result_str = "{c_fn_name(\"Duration_sub\")}({obj_str}, {other_str})"
            expr_result_type = CT_DURATION
            return
        }
        if method == "scale" {
            let args_sl = node_args(node)
            emit_expr(sublist_get(args_sl, 0))
            let n_str = expr_result_str
            expr_result_str = "{c_fn_name(\"Duration_scale\")}({obj_str}, {n_str})"
            expr_result_type = CT_DURATION
            return
        }
        if method == "is_zero" {
            expr_result_str = "{c_fn_name(\"Duration_is_zero\")}({obj_str})"
            expr_result_type = CT_BOOL
            return
        }
    }

    // Ptr methods
    if obj_type == CT_PTR {
        if method == "deref" {
            expr_result_str = "(*({obj_str}))"
            expr_result_type = CT_INT
            return
        }
        if method == "write" {
            let args_sl = node_args(node)
            emit_expr(sublist_get(args_sl, 0))
            let val_str = expr_result_str
            emit_line("*({obj_str}) = {val_str};")
            expr_result_str = "0"
            expr_result_type = CT_VOID
            return
        }
        if method == "is_null" {
            expr_result_str = "({obj_str} == NULL)"
            expr_result_type = CT_BOOL
            return
        }
        if method == "addr" {
            expr_result_str = "((int64_t)(intptr_t){obj_str})"
            expr_result_type = CT_INT
            return
        }
        if method == "offset" {
            let mut struct_name = ""
            if node_kind(obj_node) == NodeKind.Ident {
                let recv_name = node_name(obj_node)
                struct_name = get_var_ffi_ptr_struct(recv_name)
                if is_ffi_ptr_array_var(recv_name) == 0 && struct_name != "" {
                    diag_error_at("FfiOffsetOnSingleton", FFI_OFFSET_ON_SINGLETON, "Ptr.offset() called on Ptr from scope.alloc[T]() — use scope.alloc_n[T](n) for arrays", node, "use scope.alloc_n[T](n) instead of scope.alloc[T]()")
                }
            } else {
                // Chained call (e.g. p.offset(1).offset(2)): inner offset already
                // populated ffi_offset_pending_struct.
                struct_name = ffi_offset_pending_struct
            }
            if struct_name == "" {
                diag_error_at("FfiOffsetUnknownStride", FFI_OFFSET_UNKNOWN_STRIDE, "Ptr.offset() requires a Ptr to an @ffi.struct typedef so the stride is known", node, "use a Ptr[T] where T is annotated @ffi.struct")
            }
            let inner_c = if struct_name != "" { c_type_c_name(struct_name) } else { "char" }
            let args_sl = node_args(node)
            emit_expr(sublist_get(args_sl, 0))
            let i_str = expr_result_str
            expr_result_str = "(({inner_c}*)({obj_str}) + ({i_str}))"
            expr_result_type = CT_PTR
            ffi_offset_pending_struct = struct_name
            return
        }
        if method == "to_str" {
            ensure_option_type(CT_STRING)
            let opt_type = option_c_type(CT_STRING)
            let res = fresh_temp("_tostr_opt_")
            emit_line("{opt_type} {res} = ({obj_str} != NULL) ? ({opt_type})\{.tag = 1, .value = blink_strdup((const char*){obj_str})} : ({opt_type})\{.tag = 0};")
            set_var_option(res, CT_STRING)
            expr_result_str = res
            expr_result_type = CT_OPTION
            expr_option_inner = CT_STRING
            expr_option_inner_struct = ""
            return
        }
    }

    if obj_type == CT_FFI_SCOPE {
        if method == "alloc" {
            let inner_c = resolve_ptr_inner_c()
            expr_result_str = "({inner_c}*)blink_ffi_scope_track({obj_str}, calloc(1, sizeof({inner_c})))"
            expr_result_type = CT_PTR
            return
        }
        if method == "alloc_n" {
            let inner_c = resolve_ptr_inner_c()
            let args_sl = node_args(node)
            emit_expr(sublist_get(args_sl, 0))
            let n_str = expr_result_str
            expr_result_str = "({inner_c}*)blink_ffi_scope_track({obj_str}, calloc((size_t)({n_str}), sizeof({inner_c})))"
            expr_result_type = CT_PTR
            ffi_alloc_n_pending = 1
            return
        }
        if method == "cstr" {
            let args_sl = node_args(node)
            emit_expr(sublist_get(args_sl, 0))
            let arg_str = expr_result_str
            expr_result_str = "(uint8_t*)blink_ffi_scope_cstr({obj_str}, {arg_str})"
            expr_result_type = CT_PTR
            return
        }
        if method == "take" {
            let args_sl = node_args(node)
            emit_expr(sublist_get(args_sl, 0))
            let arg_str = expr_result_str
            expr_result_str = "blink_ffi_scope_take({obj_str}, {arg_str})"
            expr_result_type = CT_PTR
            return
        }
    }

    // Option methods: unwrap, is_some, is_none
    if obj_type == CT_OPTION {
        if method == "unwrap" {
            let sv_inner = get_var_option_inner(obj_str)
            let inner = if sv_inner != -1 { sv_inner } else { expr_option_inner }
            let sv_inner_s = get_var_option_inner_struct(obj_str)
            let inner_s = if sv_inner_s != "" { sv_inner_s } else { expr_option_inner_struct }
            let tmp = fresh_temp("_ounw_")
            if inner_s != "" && is_compound_ct(inner) == 0 {
                let opt_c = struct_option_c_type(inner_s)
                emit_line("{opt_c} {tmp} = {obj_str};")
                emit_panic_tag_check(tmp, 0, "unwrap called on None", node)
                let val_tmp = fresh_temp("_ounv_")
                emit_line("{c_type_c_name(inner_s)} {val_tmp} = *{tmp}.value;")
                set_var(val_tmp, CT_STRUCT, 0)
                set_var_struct(val_tmp, inner_s)
                expr_result_str = val_tmp
                expr_result_type = CT_STRUCT
            } else if inner == CT_STRING {
                let opt_c = option_c_type(CT_STRING)
                emit_line("{opt_c} {tmp} = {obj_str};")
                emit_panic_tag_check(tmp, 0, "unwrap called on None", node)
                expr_result_str = "{tmp}.value"
                expr_result_type = CT_STRING
            } else if inner == CT_LIST {
                let opt_c = option_c_type(CT_LIST)
                emit_line("{opt_c} {tmp} = {obj_str};")
                emit_panic_tag_check(tmp, 0, "unwrap called on None", node)
                let val_tmp = fresh_temp("_ounv_")
                emit_line("blink_list* {val_tmp} = {tmp}.value;")
                set_var(val_tmp, CT_LIST, 0)
                // The flat inner2 / inner2_struct channels are the established
                // Option[List[T]] element carrier (used by the ordinary
                // List[List[T]].get()/for-in path). Prefer them.
                let nested = get_var_option_inner2(obj_str)
                let nested_s = get_var_option_inner2_struct(obj_str)
                if nested != -1 {
                    set_list_elem_type(val_tmp, nested)
                    expr_list_elem_type = nested
                    if nested_s != "" {
                        set_list_elem_struct(val_tmp, nested_s)
                    }
                } else {
                    // whg65a: only when the flat channel is empty do we consult the
                    // deep inner tp — this is the `List[Option[List[T]]]` element case
                    // where set_var_option_inner_tp stored the element and the flat
                    // inner2 slot was never populated.
                    let deep_list_tp = get_var_option_inner_tp(obj_str)
                    if deep_list_tp >= 0 && tp_get_kind(deep_list_tp) == CT_LIST {
                        let le = tp_child1_kind(deep_list_tp)
                        set_list_elem_type(val_tmp, le)
                        expr_list_elem_type = le
                        let les = tp_child1_sname(deep_list_tp)
                        if les != "" {
                            set_list_elem_struct(val_tmp, les)
                        }
                    } else {
                        set_list_elem_type(val_tmp, CT_INT)
                        expr_list_elem_type = CT_INT
                        if nested_s != "" {
                            set_list_elem_struct(val_tmp, nested_s)
                        }
                    }
                }
                expr_result_str = val_tmp
                expr_result_type = CT_LIST
            } else if inner == CT_MAP && inner_s != "" {
                let opt_c = struct_option_c_type(inner_s)
                emit_line("{opt_c} {tmp} = {obj_str};")
                emit_panic_tag_check(tmp, 0, "unwrap called on None", node)
                let val_tmp = fresh_temp("_ounv_")
                emit_line("blink_map* {val_tmp} = {tmp}.value;")
                set_var(val_tmp, CT_MAP, 0)
                let map_nested = get_var_option_inner2(obj_str)
                if map_nested >= 0 {
                    set_map_value_list_elem(val_tmp, map_nested)
                }
                let map_nested_s = get_var_option_inner2_struct(obj_str)
                if map_nested_s != "" {
                    set_map_value_struct(val_tmp, map_nested_s)
                }
                // wx184m: recover the scalar Map key+value types from the option's
                // struct tag (`Map_<ktag>_<vtag>`) so a later `.get(k)` returns the
                // right Option[V]. Without this the value defaults to Int and the
                // key to Str, breaking non-Int values (`?? "x"`) and non-Str keys.
                // Scalar-only; list/struct value types stay on the paths above. The
                // let-binding carries this onto the bound name via copy_map_value_meta.
                if map_nested < 0 && map_nested_s == "" {
                    let kv = map_struct_scalar_kv(inner_s)
                    if kv.first >= 0 {
                        set_map_types(val_tmp, kv.first, kv.second, "")
                    }
                }
                expr_result_str = val_tmp
                expr_result_type = CT_MAP
            } else if inner == CT_OPTION && inner_s != "" {
                let opt_c = struct_option_c_type(inner_s)
                emit_line("{opt_c} {tmp} = {obj_str};")
                emit_panic_tag_check(tmp, 0, "unwrap called on None", node)
                let val_tmp = fresh_temp("_ounv_")
                emit_line("{c_type_c_name(inner_s)} {val_tmp} = *{tmp}.value;")
                set_var(val_tmp, CT_OPTION, 0)
                if inner_s.starts_with("Option_") {
                    set_var_option_from_struct_tag(val_tmp, inner_s)
                } else {
                    set_var_option_struct(val_tmp, CT_INT, inner_s)
                }
                // whg65a: a `List` inner's element type can't ride the carrier tag
                // (`Option_list` is element-agnostic), so recover it from the source
                // Option[Option[List]]'s stored deep tp (its child1 is the element
                // Option[List], whose child1 is the List with its element). Only for
                // the List case — a Map inner is already fully recovered from its tag
                // (`Option_Map_int_str`) by set_var_option_from_struct_tag above, and
                // overriding it here with the source's flat map would erase V.
                if inner_s == "Option_list" {
                    let src_inner_tp = get_var_option_inner_tp(obj_str)
                    if src_inner_tp >= 0 && tp_get_kind(src_inner_tp) == CT_OPTION {
                        set_var_option_inner_tp(val_tmp, tp_get_child1(src_inner_tp))
                    }
                }
                expr_result_str = val_tmp
                expr_result_type = CT_OPTION
                // fcqfhf: refresh the option-inner ledger to describe the
                // unwrapped result (one level shallower). Without this a chained
                // `.unwrap().unwrap()` re-reads the stale outer-level struct tag
                // and mis-emits the outer carrier for the second unwrap.
                expr_option_inner = get_var_option_inner(val_tmp)
                expr_option_inner_struct = get_var_option_inner_struct(val_tmp)
                // whg65a: surface the unwrapped Option's deep inner tp (a nested
                // Map/List) so the let-binding that captures `inner` re-stamps it —
                // otherwise the flat set_var_option_struct rebind drops the element.
                expr_option_inner_tp = get_var_option_inner_tp(val_tmp)
            } else if inner == CT_RESULT && inner_s != "" {
                // gemr3z: Option[Result[T,E]].unwrap() -> Result[T,E]. The inner
                // Result carrier (inner_s = Result_<ok>_<err>) is pointer-boxed in the
                // struct-option value; deref it and rebuild the Result ledger from the
                // carrier tag so a downstream match/unwrap on the Result decodes ok/err.
                // Mirrors the CT_OPTION branch above (List[Result[T,E]].get().unwrap()).
                let opt_c = struct_option_c_type(inner_s)
                emit_line("{opt_c} {tmp} = {obj_str};")
                emit_panic_tag_check(tmp, 0, "unwrap called on None", node)
                let val_tmp = fresh_temp("_ounv_")
                emit_line("{c_type_c_name(inner_s)} {val_tmp} = *{tmp}.value;")
                set_var(val_tmp, CT_RESULT, 0)
                let parts = split_result_compound(canonical_struct_tag(inner_s))
                let ok_struct = typedef_tag_or_empty(parts.first)
                let err_struct = typedef_tag_or_empty(parts.second)
                let ok_ct = type_from_name_tag(parts.first)
                let err_ct = type_from_name_tag(parts.second)
                set_var_result(val_tmp, ok_ct, err_ct)
                if ok_struct != "" || err_struct != "" {
                    set_var_result_struct(val_tmp, ok_ct, err_ct, ok_struct, err_struct)
                }
                expr_result_str = val_tmp
                expr_result_type = CT_RESULT
                expr_result_ok_type = ok_ct
                expr_result_err_type = err_ct
                expr_result_ok_struct = ok_struct
                expr_result_err_struct = err_struct
            } else if inner == CT_BYTES {
                let opt_c = option_c_type(CT_BYTES)
                emit_line("{opt_c} {tmp} = {obj_str};")
                emit_panic_tag_check(tmp, 0, "unwrap called on None", node)
                let val_tmp = fresh_temp("_ounv_")
                emit_line("blink_bytes* {val_tmp} = {tmp}.value;")
                set_var(val_tmp, CT_BYTES, 0)
                expr_result_str = val_tmp
                expr_result_type = CT_BYTES
            } else if inner == CT_SET {
                // Set carrier member is a bare blink_set* (c_type_str(CT_SET)), never
                // boxed — mirror the CT_BYTES branch. Without this Option[Set].unwrap()
                // falls to the scalar else and erases to CT_INT, so `.contains`/`.len`
                // on the unwrapped set report unresolved-method (br 7s0vaj, mirror of
                // the emit_result_unwrap_inner CT_SET seam).
                let opt_c = option_c_type(CT_SET)
                emit_line("{opt_c} {tmp} = {obj_str};")
                emit_panic_tag_check(tmp, 0, "unwrap called on None", node)
                let val_tmp = fresh_temp("_ounv_")
                emit_line("blink_set* {val_tmp} = {tmp}.value;")
                set_var(val_tmp, CT_SET, 0)
                expr_result_str = val_tmp
                expr_result_type = CT_SET
            } else {
                if inner == CT_FLOAT {
                    let opt_c = option_c_type(CT_FLOAT)
                    emit_line("{opt_c} {tmp} = {obj_str};")
                    emit_panic_tag_check(tmp, 0, "unwrap called on None", node)
                    expr_result_str = "{tmp}.value"
                    expr_result_type = CT_FLOAT
                } else if inner == CT_CHAR {
                    let opt_c = option_c_type(CT_CHAR)
                    emit_line("{opt_c} {tmp} = {obj_str};")
                    emit_panic_tag_check(tmp, 0, "unwrap called on None", node)
                    expr_result_str = "{tmp}.value"
                    expr_result_type = CT_CHAR
                } else {
                    let opt_c = option_c_type(CT_INT)
                    emit_line("{opt_c} {tmp} = {obj_str};")
                    emit_panic_tag_check(tmp, 0, "unwrap called on None", node)
                    expr_result_str = "{tmp}.value"
                    expr_result_type = CT_INT
                }
            }
            return
        }
        if method == "is_some" {
            expr_result_str = "({obj_str}.tag == 1)"
            expr_result_type = CT_BOOL
            return
        }
        if method == "is_none" {
            expr_result_str = "({obj_str}.tag == 0)"
            expr_result_type = CT_BOOL
            return
        }
    }

    // Result methods: unwrap, unwrap_err, is_ok, is_err
    if obj_type == CT_RESULT {
        if method == "unwrap" {
            let sv_ok = get_var_result_ok(obj_str)
            let ok_t = if sv_ok != -1 { sv_ok } else { expr_result_ok_type }
            let sv_ok_s = get_var_result_ok_struct(obj_str)
            let ok_s = if sv_ok_s != "" { sv_ok_s } else { expr_result_ok_struct }
            let sv_elem = get_var_result_ok_elem(obj_str)
            let ok_elem = if sv_elem != -1 { sv_elem } else { expr_list_elem_type }
            let sv_elem_s = get_var_result_ok_elem_struct(obj_str)
            let ok_elem_s = if sv_elem_s != "" { sv_elem_s } else { expr_list_elem_struct }
            // The panicked-on arm is the err arm; fetch its type/struct to render
            // the value embedded in the panic message.
            let sv_err = get_var_result_err(obj_str)
            let err_t = if sv_err != -1 { sv_err } else { expr_result_err_type }
            let sv_err_s = get_var_result_err_struct(obj_str)
            let err_s = if sv_err_s != "" { sv_err_s } else { expr_result_err_struct }
            emit_result_unwrap_inner(
                obj_str, node, ok_t, ok_s, "ok", ok_elem, ok_elem_s, 1,
                err_t, err_s,
            )
            return
        }
        if method == "unwrap_err" {
            let sv_err = get_var_result_err(obj_str)
            let err_t = if sv_err != -1 { sv_err } else { expr_result_err_type }
            let sv_err_s = get_var_result_err_struct(obj_str)
            let err_s = if sv_err_s != "" { sv_err_s } else { expr_result_err_struct }
            // The panicked-on arm is the ok arm; fetch its type/struct to render
            // the value embedded in the panic message.
            let sv_ok = get_var_result_ok(obj_str)
            let ok_t = if sv_ok != -1 { sv_ok } else { expr_result_ok_type }
            let sv_ok_s = get_var_result_ok_struct(obj_str)
            let ok_s = if sv_ok_s != "" { sv_ok_s } else { expr_result_ok_struct }
            emit_result_unwrap_inner(
                obj_str, node, err_t, err_s, "err", -1, "", 0,
                ok_t, ok_s,
            )
            return
        }
        if method == "is_ok" {
            expr_result_str = "({obj_str}.tag == 0)"
            expr_result_type = CT_BOOL
            return
        }
        if method == "is_err" {
            expr_result_str = "({obj_str}.tag == 1)"
            expr_result_type = CT_BOOL
            return
        }
    }

    // Derived method dispatch (Serialize/Deserialize/Eq/Clone)
    let derive_struct = get_var_struct(obj_str)
    if derive_struct != "" && has_derive_method(derive_struct, method) != 0 {
        if method == "to_json" {
            expr_result_str = "{derive_method_cname(derive_struct, "to_json")}({obj_str})"
            expr_result_type = CT_STRING
            return
        }
        if method == "debug" {
            expr_result_str = "{derive_method_cname(derive_struct, "debug")}({obj_str})"
            expr_result_type = CT_STRING
            return
        }
        if method == "eq" {
            let args_sl = node_args(node)
            if args_sl != -1 && sublist_length(args_sl) > 0 {
                emit_expr(sublist_get(args_sl, 0))
                let other_str = expr_result_str
                expr_result_str = "{derive_method_cname(derive_struct, "eq")}({obj_str}, {other_str})"
                expr_result_type = CT_BOOL
                return
            }
        }
        // vfgp72: derived Ord.cmp -> Ordering. The result is a simple-enum value
        // (int-repped); tag the temp as Ordering so a `let o = a.cmp(b)` binding
        // resolves variants in a following `match o`.
        if method == "cmp" {
            let args_sl = node_args(node)
            if args_sl != -1 && sublist_length(args_sl) > 0 {
                emit_expr(sublist_get(args_sl, 0))
                let other_str = expr_result_str
                let tmp = fresh_temp("_cmp_")
                emit_line("{c_type_c_name("Ordering")} {tmp} = {derive_method_cname(derive_struct, "cmp")}({obj_str}, {other_str});")
                set_var(tmp, CT_INT, 0)
                var_enums.push(VarEnumEntry { name: tmp, enum_type: "Ordering" })
                expr_result_str = tmp
                expr_result_type = CT_INT
                return
            }
        }
        if method == "clone" {
            let tmp = fresh_temp("_clone_")
            emit_line("{c_type_c_name(derive_struct)} {tmp} = {derive_method_cname(derive_struct, "clone")}({obj_str});")
            set_var(tmp, CT_VOID, 0)
            set_var_struct(tmp, derive_struct)
            expr_result_str = tmp
            expr_result_type = CT_VOID
            return
        }
    }
    let derive_enum = get_var_enum(obj_str)
    if derive_enum != "" && has_derive_method(derive_enum, method) != 0 {
        if method == "to_json" {
            expr_result_str = "{derive_method_cname(derive_enum, "to_json")}({obj_str})"
            expr_result_type = CT_STRING
            return
        }
        if method == "debug" {
            expr_result_str = "{derive_method_cname(derive_enum, "debug")}({obj_str})"
            expr_result_type = CT_STRING
            return
        }
        if method == "to_str" && is_str_backed_enum(derive_enum) != 0 {
            expr_result_str = "{c_fn_name("{derive_enum}_to_str")}({obj_str})"
            expr_result_type = CT_STRING
            return
        }
        if method == "eq" {
            let args_sl = node_args(node)
            if args_sl != -1 && sublist_length(args_sl) > 0 {
                emit_expr(sublist_get(args_sl, 0))
                let other_str = expr_result_str
                expr_result_str = "{derive_method_cname(derive_enum, "eq")}({obj_str}, {other_str})"
                expr_result_type = CT_BOOL
                return
            }
        }
        // vfgp72: derived Ord.cmp on an enum -> Ordering (see struct branch).
        if method == "cmp" {
            let args_sl = node_args(node)
            if args_sl != -1 && sublist_length(args_sl) > 0 {
                emit_expr(sublist_get(args_sl, 0))
                let other_str = expr_result_str
                let tmp = fresh_temp("_cmp_")
                emit_line("{c_type_c_name("Ordering")} {tmp} = {derive_method_cname(derive_enum, "cmp")}({obj_str}, {other_str});")
                set_var(tmp, CT_INT, 0)
                var_enums.push(VarEnumEntry { name: tmp, enum_type: "Ordering" })
                expr_result_str = tmp
                expr_result_type = CT_INT
                return
            }
        }
        if method == "clone" {
            if is_data_enum(derive_enum) != 0 {
                let tmp = fresh_temp("_clone_")
                emit_line("{c_type_c_name(derive_enum)} {tmp} = {derive_method_cname(derive_enum, "clone")}({obj_str});")
                set_var(tmp, CT_VOID, 0)
                set_var_struct(tmp, derive_enum)
                expr_result_str = tmp
                expr_result_type = CT_VOID
            } else {
                expr_result_str = "{derive_method_cname(derive_enum, "clone")}({obj_str})"
                expr_result_type = CT_INT
                var_enums.push(VarEnumEntry { name: expr_result_str, enum_type: derive_enum })
            }
            return
        }
    }

    // Trait impl method resolution
    let mut struct_type = get_var_struct(obj_str)
    if struct_type == "" {
        struct_type = get_var_enum(obj_str)
    }
    // 4q2etk: replaced by mwxtyj — synthesized sealed Display.display().
    // Resolves before lookup_impl_method: E0731 guarantees the Display impl
    // itself never defines display, and a display owned by a DIFFERENT impl
    // block keeps the symbol (synthesis is skipped), so it falls through.
    if struct_type != "" && method == "display" {
        let disp_call = synthesized_display_call(struct_type, obj_str)
        if disp_call != "" {
            expr_result_str = disp_call
            expr_result_type = CT_STRING
            return
        }
    }
    if struct_type != "" && lookup_impl_method(struct_type, method) != 0 {
        // Params typed `mod.Type` store a qualified var-struct, but impls
        // register under the bare type name — resolve the registered key so
        // mangling and ret-type lookup hit the same entry.
        emit_user_impl_call(node, impl_method_reg_name(struct_type, method), method, obj_str)
        return
    }

    // Closure field dispatch: struct.closure_field(args)
    if struct_type != "" {
        let cls_field_type = get_struct_field_type(struct_type, method)
        if cls_field_type == CT_CLOSURE {
            let cls_sig = get_struct_field_closure_sig(struct_type, method)
            if cls_sig != "" {
                let cls_ptr = "{obj_str}.{method}"
                let args_sl = node_args(node)
                let mut args_str = cls_ptr
                if args_sl != -1 {
                    let mut i = 0
                    while i < sublist_length(args_sl) {
                        args_str = args_str.concat(", ")
                        emit_expr(sublist_get(args_sl, i))
                        args_str = args_str.concat(expr_result_str)
                        i = i + 1
                    }
                }
                expr_result_str = "(({cls_sig}){cls_ptr}->fn_ptr)({args_str})"
                let ret_part = closure_sig_ret_part(cls_sig)
                if ret_part.starts_with("blink_") {
                    let sname = strip_blink_prefix(ret_part)
                    let resolved = resolve_struct_from_c_name(sname)
                    if resolved != "" {
                        let tmp = fresh_temp("_cls_ret_")
                        emit_line("{ret_part} {tmp} = (({cls_sig}){cls_ptr}->fn_ptr)({args_str});")
                        set_var(tmp, CT_VOID, 0)
                        set_var_struct(tmp, resolved)
                        expr_result_str = tmp
                        expr_result_type = CT_VOID
                    } else {
                        expr_result_type = CT_VOID
                    }
                } else {
                    expr_result_type = closure_ret_ct(ret_part)
                }
                return
            }
        }
    }

    // 66g7ep: a confirmed module-qualified call (`module.member`) that reached
    // this backstop is a member that does not exist on the module — every real
    // member, intrinsic, and namespace handler above has already returned. Frame
    // it as a module-member error (not "method on type") and offer a did-you-mean.
    // The scope-var / not-a-type guards mirror line 2320, so a local that shadows
    // an import qualifier (e.g. `sb` vs `import std.sb`) keeps the generic message.
    if node_kind(obj_node) == NodeKind.Ident {
        let mm_name = node_name(obj_node)
        if is_scope_var(mm_name) == 0 && is_trait_type(mm_name) == 0 && is_struct_type(mm_name) == 0 && is_enum_type(mm_name) == 0 && is_import_module_name(mm_name) != 0 && is_intrinsic_method(mm_name, method) == 0 {
            let mm_resolved_mod = tc_qualifier_to_module_or_self(mm_name)
            let mm_suggestion = suggest_module_member(mm_resolved_mod, method)
            let mm_help = if mm_suggestion != "" {
                "did you mean '{mm_name}.{mm_suggestion}'?"
            } else {
                ""
            }
            diag_error_at("UnresolvedMethod", UNRESOLVED_METHOD, "no member '{method}' on module '{mm_name}'", node, mm_help)
            expr_result_str = "(void)0"
            expr_result_type = CT_VOID
            return
        }
    }

    // Generic fallback — emit diagnostic and produce safe placeholder
    let recv_type_name = type_name_from_ct(obj_type)
    // br j2xxyd: `.display()` on a struct/enum with no `impl Display` lands
    // here. Suggest the impl (per the 4q2etk Display design) instead of an
    // empty help string; every other unresolved method keeps the bare help.
    let fallback_help = if method == "display" && struct_type != "" {
        "add an `impl Display for {struct_type}` (with `fn fmt(self, sb: StringBuilder)`)"
    } else {
        ""
    }
    diag_error_at("UnresolvedMethod", UNRESOLVED_METHOD, "unresolved method '.{method}' on type {recv_type_name} in '{cg_current_fn_name}'", node, fallback_help)
    expr_result_str = "(void)0"
    expr_result_type = CT_VOID
}
