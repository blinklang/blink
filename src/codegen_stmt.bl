fn strip_outer_parens(s: Str) -> Str {
    if s.starts_with("(") && s.ends_with(")") {
        let inner = s.substring(1, s.len() - 2)
        let mut depth = 0
        let mut i = 0
        let mut balanced = 1
        while i < inner.len() {
            let ch = inner.byte_at(i)
            if ch == 40 { // '('
                depth = depth + 1
            } else if ch == 41 { // ')'
                if depth == 0 {
                    balanced = 0
                }
                depth = depth - 1
            }
            i = i + 1
        }
        if balanced != 0 && depth == 0 {
            return inner
        }
    }
    s
}

fn propagate_map_list_elem(var_name: Str, val_ct: Int, val_ann: Int) {
    if val_ct == CT_LIST {
        let val_elems = node_elements(val_ann)
        if val_elems != -1 && sublist_length(val_elems) > 0 {
            let inner_ann = sublist_get(val_elems, 0)
            let inner_name = node_name(inner_ann)
            set_map_value_list_elem(var_name, type_from_name(inner_name))
        }
    }
}

// Stamp a List[Map[K,V]] element-map's key+value types from the `Map[K,V]`
// element annotation onto the list var. Shared by every List[T] annotation-lowering
// site (let / top-level let / fn + impl + mono params) so the value type survives
// get()/pop() instead of defaulting to Int.
fn set_list_elem_map_ann(var_name: Str, elem_ann: Int) {
    let map_sl = node_elements(elem_ann)
    if map_sl != -1 && sublist_length(map_sl) >= 2 {
        let mk_ann = sublist_get(map_sl, 0)
        let mv_ann = sublist_get(map_sl, 1)
        let mk_name = resolve_tparam_via_tid(node_name(mk_ann), cg_mono_tparams_sl, cg_mono_arg_tids)
        let mv_name = resolve_tparam_via_tid(node_name(mv_ann), cg_mono_tparams_sl, cg_mono_arg_tids)
        set_list_elem_map_types(var_name, type_from_name(mk_name), type_from_name(mv_name), mv_name)
    }
}

// Build a fully-recursive tp node from a type annotation, substituting
// mono typevars via the current cg_mono_* context. The tparam-resolving twin of
// tp_from_ann (codegen_types.bl) — that one runs BELOW the mono resolver in the
// module DAG so it can't call resolve_tparam_via_tid; this one lives alongside
// the resolver and is the deep builder for a List's compound element inner, so
// `List[Option[Map[K,V]]]` records list→option→map→{k,v} instead of collapsing
// the Map's K/V to the sv_tp default (Str/Int). Handles the container ctypes it
// can descend into; anything else lowers to the resolved scalar/struct.
fn deep_tp_from_ann(ann: Int) -> Int ! Codegen.Register {
    let resolved = resolve_tparam_via_tid(node_name(ann), cg_mono_tparams_sl, cg_mono_arg_tids)
    let ct = type_from_name(resolved)
    let elems = node_elements(ann)
    let n = if elems != -1 { sublist_length(elems) } else { 0 }
    if ct == CT_OPTION && n >= 1 {
        return type_option(deep_tp_from_ann(sublist_get(elems, 0)))
    }
    if ct == CT_RESULT && n >= 2 {
        return type_result(deep_tp_from_ann(sublist_get(elems, 0)), deep_tp_from_ann(sublist_get(elems, 1)))
    }
    if ct == CT_MAP && n >= 2 {
        return type_map(deep_tp_from_ann(sublist_get(elems, 0)), deep_tp_from_ann(sublist_get(elems, 1)))
    }
    if ct == CT_LIST && n >= 1 {
        return type_list(deep_tp_from_ann(sublist_get(elems, 0)))
    }
    if ct == CT_SET && n >= 1 {
        return type_set(deep_tp_from_ann(sublist_get(elems, 0)))
    }
    if ct == CT_ITERATOR && n >= 1 {
        return type_iterator(deep_tp_from_ann(sublist_get(elems, 0)))
    }
    if is_struct_or_enum_type(resolved) != 0 {
        // A bare generic head (`resolved` alone, e.g. `QBox`) is never typedef'd
        // on its own; only mono instances are. A nested struct/enum leaf must
        // spell the mono STEM (`QBox_Int`), mirroring the declared List[T]
        // element branch below. register_carrier_inner_mono_instance emits
        // that instance's typedef so the stem this returns actually exists in C.
        let stem = mono_name_from_ann(strip_module_qualifier(resolved), ann, -1, [])
        let _reg = register_carrier_inner_mono_instance(resolved, ann)
        return type_struct(if stem != "" { stem } else { resolved })
    }
    sv_tp(ct, -1, -1, "")
}

// Stamp a List[Option[T]] / List[Result[T,E]] element's INNER
// type(s) from the element annotation onto the list var (the compound-element
// twin of set_list_elem_map_ann). Without this, the plain
// set_list_elem_type(CT_OPTION) at each annotation site defaults the Option inner
// to Int and get()/for-in emit the undefined `blink_Option_option`. Builds the
// element's inner as a FULLY-RECURSIVE tp (deep_tp_from_ann) so a container
// nested inside the compound — `List[Option[Map[K,V]]]`, `List[Result[Map,..]]`,
// `List[Option[List[T]]]` — keeps its own type params. Records via the
// deep set_list_elem_option_tp / set_list_elem_result_tp.
// Returns 1 when it handled the element (Option/Result), 0 otherwise so the caller
// keeps its existing dispatch for non-compound elements.
fn set_list_elem_compound_ann(var_name: Str, elem_ann: Int, elem_ct: Int) -> Int ! Codegen.Register {
    if elem_ct == CT_OPTION {
        let inner_sl = node_elements(elem_ann)
        if inner_sl != -1 && sublist_length(inner_sl) >= 1 {
            set_list_elem_option_tp(var_name, deep_tp_from_ann(sublist_get(inner_sl, 0)))
        }
        return 1
    }
    if elem_ct == CT_RESULT {
        let inner_sl = node_elements(elem_ann)
        if inner_sl != -1 && sublist_length(inner_sl) >= 2 {
            let ok_tp = deep_tp_from_ann(sublist_get(inner_sl, 0))
            let err_tp = deep_tp_from_ann(sublist_get(inner_sl, 1))
            set_list_elem_result_tp(var_name, ok_tp, err_tp)
        }
        return 1
    }
    0
}

fn infer_node_struct_name(node: Int) -> Str {
    if node == -1 {
        return ""
    }
    let kind = node_kind(node)
    if kind == NodeKind.StructLit {
        return node_type_name(node)
    }
    if kind == NodeKind.ExprStmt {
        let inner = node_value(node)
        if node_kind(inner) == NodeKind.StructLit {
            return node_type_name(inner)
        }
        if node_kind(inner) == NodeKind.MethodCall || node_kind(inner) == NodeKind.Call {
            return infer_node_struct_name(inner)
        }
    }
    if kind == NodeKind.Call {
        let func_node = node_left(node)
        if node_kind(func_node) == NodeKind.Ident {
            return get_fn_ret_struct(resolve_import_alias(node_name(func_node)))
        }
        return ""
    }
    if kind == NodeKind.Block {
        let stmts_sl = node_stmts(node)
        if stmts_sl != -1 {
            let count = sublist_length(stmts_sl)
            if count > 0 {
                return infer_node_struct_name(sublist_get(stmts_sl, count - 1))
            }
        }
    }
    if kind == NodeKind.IfExpr {
        let r = infer_node_struct_name(node_then_body(node))
        if r != "" {
            return r
        }
        return infer_node_struct_name(node_else_body(node))
    }
    if kind == NodeKind.MethodCall {
        // Chained .unwrap / .unwrap_err on Option/Result need the struct
        // payload threaded through for if-expr tail materialization.
        let mc_method = node_method(node)
        let mc_obj = node_obj(node)
        if mc_method == "unwrap" || mc_method == "unwrap_or" {
            return infer_carrier_inner_struct(mc_obj, 1)
        }
        if mc_method == "unwrap_err" {
            return infer_carrier_inner_struct(mc_obj, 2)
        }
    }
    ""
}

// Single shared dispatch for infer_carrier_inner / infer_carrier_inner_struct:
// resolves an Option[T] / Result[T, E] expression's inner1 (which=1) or
// inner2 (which=2). At each leaf it computes both the inner CT (CT_VOID on
// failure) and the inner struct-payload name ("" on failure) using each
// original helper's leaf logic verbatim.
fn walk_carrier_receiver(node: Int, which: Int) -> CarrierInfo {
    if node == -1 {
        return CarrierInfo { type_const: CT_VOID, struct_name: "" }
    }
    let k = node_kind(node)
    if k == NodeKind.Ident {
        let obj_name = node_name(node)
        let obj_type = get_var_type(obj_name)
        let is_option_inner1 = obj_type == CT_OPTION && which == 1
        let mut tc = CT_VOID
        let mut sn = ""
        if is_option_inner1 {
            let inner = get_var_option_inner(obj_name)
            if inner != -1 { tc = inner }
            sn = get_var_option_inner_struct(obj_name)
        } else if obj_type == CT_RESULT {
            if which == 1 {
                let ok_t = get_var_result_ok(obj_name)
                if ok_t != -1 { tc = ok_t }
                sn = get_var_result_ok_struct(obj_name)
            } else {
                let err_t = get_var_result_err(obj_name)
                if err_t != -1 { tc = err_t }
                sn = get_var_result_err_struct(obj_name)
            }
        }
        return CarrierInfo { type_const: tc, struct_name: sn }
    }
    if k == NodeKind.Call {
        let func_node = node_left(node)
        let mut tc = CT_VOID
        let mut sn = ""
        if node_kind(func_node) == NodeKind.Ident {
            let rt = get_fn_ret_type(node_name(func_node))
            if rt.kind == CT_OPTION && which == 1 && rt.inner1 != -1 { tc = rt.inner1 }
            if rt.kind == CT_RESULT {
                if which == 1 && rt.inner1 != -1 { tc = rt.inner1 }
                if which == 2 && rt.inner2 != -1 { tc = rt.inner2 }
            }
            let fsi = get_fn_ret_struct_inner(node_name(func_node))
            if which == 1 { sn = fsi.ok_struct } else { sn = fsi.err_struct }
        }
        return CarrierInfo { type_const: tc, struct_name: sn }
    }
    if k == NodeKind.MethodCall {
        let mc_obj2 = node_obj(node)
        let mc_method2 = node_method(node)
        let mut tc = CT_VOID
        let mut sn = ""
        // Map.get returns Option[V] — inner1 is V.
        if mc_method2 == "get" && which == 1 && mc_obj2 != -1 && node_kind(mc_obj2) == NodeKind.Ident {
            if get_var_type(node_name(mc_obj2)) == CT_MAP {
                let v_t = get_map_value_type(node_name(mc_obj2))
                if v_t >= 0 && v_t != CT_VOID { tc = v_t }
                sn = get_map_value_struct(node_name(mc_obj2))
            }
        }
        // Struct method returning Option/Result — chase its registered return type.
        if mc_obj2 != -1 && node_kind(mc_obj2) == NodeKind.Ident {
            let obj_struct2 = get_var_struct(node_name(mc_obj2))
            if obj_struct2 != "" {
                let rt2 = get_fn_ret_type("{obj_struct2}_{mc_method2}")
                if rt2.kind == CT_OPTION && which == 1 && rt2.inner1 != -1 { tc = rt2.inner1 }
                if rt2.kind == CT_RESULT {
                    if which == 1 && rt2.inner1 != -1 { tc = rt2.inner1 }
                    if which == 2 && rt2.inner2 != -1 { tc = rt2.inner2 }
                }
                let fsi2 = get_fn_ret_struct_inner("{obj_struct2}_{mc_method2}")
                if which == 1 { sn = fsi2.ok_struct } else { sn = fsi2.err_struct }
            }
        }
        return CarrierInfo { type_const: tc, struct_name: sn }
    }
    if k == NodeKind.IfExpr {
        let tb = walk_carrier_receiver(node_then_body(node), which)
        let eb = walk_carrier_receiver(node_else_body(node), which)
        let tc = if tb.type_const != CT_VOID { tb.type_const } else { eb.type_const }
        let sn = if tb.struct_name != "" { tb.struct_name } else { eb.struct_name }
        return CarrierInfo { type_const: tc, struct_name: sn }
    }
    if k == NodeKind.Block {
        let stmts_sl = node_stmts(node)
        if stmts_sl != -1 {
            let count = sublist_length(stmts_sl)
            if count > 0 {
                let last = sublist_get(stmts_sl, count - 1)
                if node_kind(last) == NodeKind.ExprStmt {
                    return walk_carrier_receiver(node_value(last), which)
                }
                return walk_carrier_receiver(last, which)
            }
        }
        return CarrierInfo { type_const: CT_VOID, struct_name: "" }
    }
    CarrierInfo { type_const: CT_VOID, struct_name: "" }
}

// Companion to infer_carrier_inner: resolves the struct-payload name of an
// Option[T] / Result[T, E] expression's inner1 (which=1) or inner2 (which=2).
// Returns "" when not a struct or unable to resolve.
fn infer_carrier_inner_struct(node: Int, which: Int) -> Str {
    walk_carrier_receiver(node, which).struct_name
}

fn infer_block_struct_name(block: Int) -> Str {
    infer_node_struct_name(block)
}

// Snapshot of the carrier-shaping `expr_*` globals taken immediately after an
// `emit_expr`/`emit_block_value`/`emit_arm_value` call. These globals are
// overwritten by the next emit, so a branch/arm whose value is Option[T] or
// Result[T, E] must be captured before its sibling is emitted. `ct` is the
// post-emit `expr_result_type` — when `?` reseats a Result branch to its Ok
// type (e.g. `read_one()?` → CT_BYTES) the snapshot reflects the unwrapped
// type, not the carrier, so the caller falls through to the scalar/struct path.
type IfCarrier {
    ct: Int
    option_inner: Int
    option_inner_struct: Str
    option_is_none: Int
    ok_type: Int
    ok_struct: Str
    err_type: Int
    err_struct: Str
}

fn snapshot_carrier() -> IfCarrier {
    IfCarrier {
        ct: expr_result_type,
        option_inner: expr_option_inner,
        option_inner_struct: expr_option_inner_struct,
        option_is_none: expr_option_is_none,
        ok_type: expr_result_ok_type,
        ok_struct: expr_result_ok_struct,
        err_type: expr_result_err_type,
        err_struct: expr_result_err_struct,
    }
}

// True when this snapshot carries a concrete Option element — i.e. a real
// `Some(value)` whose inner type is known, not a placeholder bare `None`.
fn carrier_option_concrete(ci: IfCarrier) -> Int {
    if ci.ct == CT_OPTION && ci.option_is_none == 0 { 1 } else { 0 }
}

// True when this snapshot carries a Result with a resolved struct ok/err
// payload — preferred over a bare Ok/Err whose struct names are empty.
fn carrier_result_concrete(ci: IfCarrier) -> Int {
    if ci.ct == CT_RESULT && (ci.ok_struct != "" || ci.err_struct != "") { 1 } else { 0 }
}

// Fallback carrier derived from the enclosing fn's return type, used when both
// branches/arms of a carrier-typed if/match are placeholders (bare Ok/Err/Some
// /None). In that case the only authority for the inner type is the fn's
// declared return. Mirrors the historical fn-return hint path.
fn carrier_from_fn_ret_option() -> IfCarrier {
    let rt = get_fn_ret_type(cg_current_fn_name)
    let fsi = get_fn_ret_struct_inner(cg_current_fn_name)
    let rt_c1 = if rt.tid >= 0 { carrier_slot_ct(tc_tid_option_inner_ct(rt.tid)) } else { tp_child1_kind(rt.tp_id) }
    let mut inner = if rt_c1 >= 0 { rt_c1 } else { cg_current_fn_option_inner }
    if inner == 0 { inner = CT_INT }
    let inner_struct = if fsi.ok_struct != "" { fsi.ok_struct } else { cg_current_fn_option_inner_struct }
    IfCarrier { ct: CT_OPTION, option_inner: inner, option_inner_struct: inner_struct, option_is_none: 0, ok_type: -1, ok_struct: "", err_type: -1, err_struct: "" }
}

fn carrier_from_fn_ret_result() -> IfCarrier {
    let rt = get_fn_ret_type(cg_current_fn_name)
    let fsi = get_fn_ret_struct_inner(cg_current_fn_name)
    let rt_c1 = if rt.tid >= 0 { carrier_slot_ct(tc_tid_result_ok_ct(rt.tid)) } else { tp_child1_kind(rt.tp_id) }
    let rt_c2 = if rt.tid >= 0 { carrier_slot_ct(tc_tid_result_err_ct(rt.tid)) } else { tp_child2_kind(rt.tp_id) }
    let ok_t = if rt_c1 >= 0 { rt_c1 } else { CT_INT }
    let err_t = if rt_c2 >= 0 { rt_c2 } else { CT_STRING }
    IfCarrier { ct: CT_RESULT, option_inner: -1, option_inner_struct: "", option_is_none: 0, ok_type: ok_t, err_type: err_t, ok_struct: fsi.ok_struct, err_struct: fsi.err_struct }
}

// The physical Option carrier inside a ptr-erased context (UE handler body
// returning Option[Struct]): every Option is represented as blink_Option_ptr.
fn carrier_ptr_option() -> IfCarrier {
    IfCarrier { ct: CT_OPTION, option_inner: CT_PTR, option_inner_struct: "", option_is_none: 0, ok_type: -1, ok_struct: "", err_type: -1, err_struct: "" }
}

// A carrier read off a tid instead of off emitted values. option_is_none is 0 because a tid states
// the carrier's element type outright, so there is no bare-None placeholder to distinguish.
fn carrier_from_tid(tid: Int) -> IfCarrier {
    if tc_tid_kind(tid) == TyKind.Result {
        return IfCarrier { ct: CT_RESULT, option_inner: -1, option_inner_struct: "", option_is_none: 0, ok_type: tc_tid_result_ok_ct(tid), ok_struct: tc_tid_result_ok_struct(tid), err_type: tc_tid_result_err_ct(tid), err_struct: tc_tid_result_err_struct(tid) }
    }
    IfCarrier { ct: CT_OPTION, option_inner: tc_tid_option_inner_ct(tid), option_inner_struct: tc_tid_option_inner_struct(tid), option_is_none: 0, ok_type: -1, ok_struct: "", err_type: -1, err_struct: "" }
}

// True when a bare CT spells this kind completely — i.e. a tid can hand its answer to a flat
// `ctype` channel and lose nothing. The four excluded kinds each keep the rest of their identity in
// a separate channel a CT cannot carry: struct and enum need a name, a handler needs its effect,
// and a closure keeps its signature as a C string.
fn ct_names_kind_completely(k: TyKind) -> Int {
    if k == TyKind.Struct || k == TyKind.Enum || k == TyKind.Handler || k == TyKind.Fn { return 0 }
    1
}

@allow(UnrestoredMutation, IncompleteStateRestore)
pub fn emit_if_expr(node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    // An else-less `if` whose value is DISCARDED (unpublished node tid — no consumer memoized a
    // type for it) is a statement of type (): emit it as one so a diverging then-branch
    // (`if c { return X }`) can't fabricate a result temp from the returned type. An else-less `if`
    // whose value is still consumed is left to the value path below, which preserves its type from
    // the flat channel — rejecting that shape is §2.9's expression-context missing-else error, a
    // typecheck concern, not codegen's to silently erase.
    if node_else_body(node) == -1 && cg_node_mono_tid(node) < 0 {
        emit_if_stmt(node)
        expr_result_str = "0"
        expr_result_type = CT_VOID
        return
    }
    let tmp = fresh_temp("_if_")
    let then_type = infer_block_type(node_then_body(node))
    if then_type == CT_VOID || then_type == CT_STRUCT || then_type == CT_RESULT || then_type == CT_OPTION {
        // The pre-pass (infer_block_type) leaves CT_VOID for builtin heap
        // constructors (Bytes.new(), Map(), StringBuilder.new(), ...) and for
        // user structs it can't resolve. It is also blind to `?`, which unwraps
        // a Result/Option branch to its inner type (read_one()? : Bytes, not
        // Result). Buffer-emit both branches to read the authoritative result
        // type and carrier shape from the values that actually flow out, instead
        // of trusting the pre-pass or the enclosing fn's return type. Same idiom
        // as flush_mono_fns_with_typedefs.
        let saved_lines = cg_lines
        let saved_temp_before = cg_temp_counter
        cg_lines = []
        cg_indent = cg_indent + 1
        let mut then_val = emit_block_value(node_then_body(node))
        cg_indent = cg_indent - 1
        let real_type = expr_result_type
        let then_carrier = snapshot_carrier()
        let needs_struct = real_type == CT_VOID || real_type == CT_STRUCT
        let elem_type = expr_list_elem_type
        let elem_struct = expr_list_elem_struct
        let map_key_type = expr_map_key_type
        let map_val_type = expr_map_val_type
        let mut then_lines = cg_lines

        // Buffer-emit the else branch too so its carrier shape is observable
        // before we declare the temp. A bare-`None`/bare-`Ok` branch yields a
        // placeholder carrier; the concrete sibling (Some(value)/struct Ok)
        // wins. Both buffers are replayed below so values emit exactly once.
        let mut else_val = ""
        let mut else_lines: List[Str] = []
        let mut else_carrier = then_carrier
        let has_else = node_else_body(node) != -1
        if has_else {
            cg_lines = []
            cg_indent = cg_indent + 1
            else_val = emit_block_value(node_else_body(node))
            cg_indent = cg_indent - 1
            else_carrier = snapshot_carrier()
            else_lines = cg_lines
        }
        cg_lines = saved_lines

        // Determine the temp's C type from the emitted value. A struct value is
        // CT_VOID with a non-empty struct name (set_var convention); the fn's
        // return struct is a last-resort fallback only when the branch itself
        // produced no struct, never before it.
        let mut struct_name = if needs_struct { get_var_struct(then_val) } else { "" }
        if needs_struct && struct_name == "" {
            struct_name = infer_block_struct_name(node_then_body(node))
            if struct_name == "" && node_else_body(node) != -1 {
                struct_name = infer_block_struct_name(node_else_body(node))
            }
            if struct_name == "" {
                struct_name = get_fn_ret_struct(cg_current_fn_name)
            }
        }
        if real_type == CT_VOID && struct_name == "" {
            emit_if_stmt(node)
            expr_result_str = "0"
            expr_result_type = CT_VOID
            return
        }

        // For a carrier result, pick the branch that actually carries a concrete
        // payload: for Option prefer the non-`None` branch; for Result prefer the
        // struct-bearing Ok/Err. When neither branch is concrete (bare Ok/Err/Some
        // /None on both sides) fall back to the enclosing fn's return type.
        //
        // Exception: a ptr-erased Option context (UE handler bodies returning
        // Option[Struct] — cg_current_fn_option_inner == CT_PTR) physically
        // represents every Option as blink_Option_ptr regardless of the branch's
        // logical struct inner. Following the branch carrier there would declare
        // blink_Option_<Struct> while the branches emit blink_Option_ptr. Keep the
        // fn-return (ptr) carrier so declaration and values agree.
        let ptr_erased_option = real_type == CT_OPTION && cg_current_fn_option_inner == CT_PTR
        let mut carrier = then_carrier
        if real_type == CT_OPTION {
            if ptr_erased_option {
                carrier = carrier_ptr_option()
            } else {
                if carrier_option_concrete(then_carrier) == 0 && carrier_option_concrete(else_carrier) != 0 {
                    carrier = else_carrier
                }
                if carrier_option_concrete(carrier) == 0 {
                    carrier = carrier_from_fn_ret_option()
                }
            }
        } else if real_type == CT_RESULT {
            if carrier_result_concrete(then_carrier) == 0 && carrier_result_concrete(else_carrier) != 0 {
                carrier = else_carrier
            }
            if carrier_result_concrete(carrier) == 0 {
                carrier = carrier_from_fn_ret_result()
            }
        }

        // A bare-`None` branch was emitted during discovery against whatever
        // carrier context was in scope (often the default Option[int]); now that
        // the concrete sibling has revealed the real inner type, re-emit both
        // branches with that inner installed so the `None` literal adopts the
        // matching `blink_Option_<T>` instead of the placeholder. Reset the temp
        // counter first so the replayed numbering matches the discovery pass.
        if real_type == CT_OPTION && (then_carrier.option_is_none != 0 || else_carrier.option_is_none != 0) {
            let saved_inner = cg_current_fn_option_inner
            let saved_inner_struct = cg_current_fn_option_inner_struct
            cg_current_fn_option_inner = carrier.option_inner
            cg_current_fn_option_inner_struct = carrier.option_inner_struct
            cg_temp_counter = saved_temp_before
            cg_lines = []
            cg_indent = cg_indent + 1
            then_val = emit_block_value(node_then_body(node))
            cg_indent = cg_indent - 1
            then_lines = cg_lines
            if has_else {
                cg_lines = []
                cg_indent = cg_indent + 1
                else_val = emit_block_value(node_else_body(node))
                cg_indent = cg_indent - 1
                else_lines = cg_lines
            }
            cg_lines = saved_lines
            cg_current_fn_option_inner = saved_inner
            cg_current_fn_option_inner_struct = saved_inner_struct
        }

        let decl_type = if struct_name != "" {
            c_type_c_name(struct_name)
        } else if real_type == CT_OPTION {
            if carrier.option_inner_struct != "" { struct_option_c_type(carrier.option_inner_struct) } else { option_c_type(carrier.option_inner) }
        } else if real_type == CT_RESULT {
            result_c_type_mixed(carrier.ok_type, carrier.err_type, carrier.ok_struct, carrier.err_struct)
        } else {
            c_type_str(real_type)
        }

        // Two cells, not one: an if-expression declares its result temp on either this path or the
        // bare-CT one below, and they are mutually exclusive. Measuring them together would average
        // a path that reads a carrier's shape from the buffered branch values against one that has
        // only a CT to spell from.
        ctype_probe_at(cg_node_mono_tid(node), "if.result_carrier", tmp, decl_type, node)

        emit_expr(node_condition(node))
        let cond_str = strip_outer_parens(expr_result_str)
        emit_line("{decl_type} {tmp};")
        emit_line("if ({cond_str}) \{")
        cg_indent = cg_indent + 1
        let mut li = 0
        while li < then_lines.len() {
            cg_lines.push(then_lines.get(li).unwrap())
            li = li + 1
        }
        emit_line("{tmp} = {then_val};")
        cg_indent = cg_indent - 1
        if has_else {
            emit_line("} else \{")
            cg_indent = cg_indent + 1
            let mut ei = 0
            while ei < else_lines.len() {
                cg_lines.push(else_lines.get(ei).unwrap())
                ei = ei + 1
            }
            emit_line("{tmp} = {else_val};")
            cg_indent = cg_indent - 1
        }
        emit_line("}")
        if struct_name != "" {
            set_var(tmp, CT_VOID, 1)
            set_var_struct(tmp, struct_name)
            expr_result_str = tmp
            expr_result_type = CT_VOID
            return
        }
        if real_type == CT_OPTION {
            set_var(tmp, CT_OPTION, 1)
            if carrier.option_inner_struct != "" {
                set_var_option_struct(tmp, carrier.option_inner, carrier.option_inner_struct)
                expr_option_inner_struct = carrier.option_inner_struct
            } else {
                set_var_option(tmp, carrier.option_inner)
                expr_option_inner_struct = ""
            }
            expr_option_inner = carrier.option_inner
            expr_result_str = tmp
            expr_result_type = CT_OPTION
            return
        }
        if real_type == CT_RESULT {
            set_var(tmp, CT_RESULT, 1)
            if carrier.ok_struct != "" || carrier.err_struct != "" {
                set_var_result_struct(tmp, carrier.ok_type, carrier.err_type, carrier.ok_struct, carrier.err_struct)
            } else {
                set_var_result(tmp, carrier.ok_type, carrier.err_type)
            }
            expr_result_ok_type = carrier.ok_type
            expr_result_err_type = carrier.err_type
            expr_result_ok_struct = carrier.ok_struct
            expr_result_err_struct = carrier.err_struct
            expr_result_str = tmp
            expr_result_type = CT_RESULT
            return
        }
        set_var(tmp, real_type, 1)
        if real_type == CT_LIST && elem_type >= 0 {
            set_list_elem_type(tmp, elem_type)
            if elem_struct != "" {
                set_list_elem_struct(tmp, elem_struct)
            }
        }
        if real_type == CT_MAP && map_key_type >= 0 {
            set_map_types(tmp, map_key_type, map_val_type, "")
        }
        expr_result_str = tmp
        expr_result_type = real_type
        return
    }
    // infer_block_type is the flat pre-pass this function's own header calls blind to `?` and to
    // unresolvable structs, and nothing stamps an enum's NAME on a temp — so this declaration fell
    // through to `c_type_str(CT_ENUM)` and threw away what the temp holds. The tid leads.
    //
    // Safe here in a way it is NOT on the carrier path above: every carrier kind is routed to that
    // path, so what reaches this one is a scalar or a pointer, and those convert implicitly in C
    // even where the position's physical type is an erased vtable slot. Two struct types do not,
    // which is why the same flip on the carrier path would break a handler implementation.
    let if_flat_c = c_type_str(then_type)
    let if_tid = cg_node_mono_tid(node)
    ctype_probe_at(if_tid, "if.result_flat", tmp, if_flat_c, node)
    let if_spelled = c_type_from_tid(if_tid)
    // A temp is a STORAGE position, so a genuine Void keeps the flat placeholder.
    let if_ts = if if_spelled != "" && if_spelled != "void" { if_spelled } else { if_flat_c }
    emit_line("{if_ts} {tmp};")
    emit_expr(node_condition(node))
    let cond_str = strip_outer_parens(expr_result_str)
    emit_line("if ({cond_str}) \{")
    cg_indent = cg_indent + 1
    let then_val = emit_block_value(node_then_body(node))
    emit_line("{tmp} = {then_val};")
    cg_indent = cg_indent - 1
    if node_else_body(node) != -1 {
        emit_line("} else \{")
        cg_indent = cg_indent + 1
        let else_val = emit_block_value(node_else_body(node))
        emit_line("{tmp} = {else_val};")
        cg_indent = cg_indent - 1
    }
    emit_line("}")
    set_var(tmp, then_type, 1)
    expr_result_str = tmp
    expr_result_type = then_type
}

// True when any arm's pattern reads the scrutinee as a struct (`.tag`/`.data`/
// members) rather than as a scalar. The scalar-bind path in emit_match_expr
// materializes `<scalar> _scrut = <scrutinee>` and has each arm test the temp;
// an arm that then reads `_scrut.tag`/`.data` would not compile against a scalar
// temp. So only fieldless (plain, C-style) enum variants -- which compare as
// ints -- are safe; data-enum variants and aggregate patterns disqualify the
// scalar-bind.
fn match_arm_pattern_needs_struct(pat: Int) -> Int {
    let pk = node_kind(pat)
    if pk == NodeKind.StructPattern || pk == NodeKind.TuplePattern || pk == NodeKind.ListPattern {
        return 1
    }
    if pk == NodeKind.EnumPattern {
        // A qualified variant pattern needs a struct scrutinee only when the enum
        // carries payloads (a data enum) or the pattern destructures fields. A
        // plain (C-style) enum variant (`Col.Red`) only compares a scalar tag, so
        // it must not block the scalar-scrutinee temp -- otherwise a side-effecting
        // scrutinee is re-embedded and re-evaluated once per arm tested. Mirrors
        // the IdentPattern is_data_enum test below.
        let ep_enum = node_name(pat)
        if ep_enum != "" && is_data_enum(ep_enum) != 0 { return 1 }
        // node_name is the enum only for the qualified form; a bare payload
        // variant (`Branch(l, r)`) names the *variant*, which is_data_enum can't
        // see -- the field check is what disqualifies those, so keep it.
        let ep_flds = node_fields(pat)
        if ep_flds != -1 && sublist_length(ep_flds) > 0 { return 1 }
        return 0
    }
    if pk == NodeKind.AsPattern {
        return match_arm_pattern_needs_struct(node_pattern(pat))
    }
    if pk == NodeKind.OrPattern {
        let subs = node_elements(pat)
        if subs != -1 {
            let mut si = 0
            while si < sublist_length(subs) {
                if match_arm_pattern_needs_struct(sublist_get(subs, si)) != 0 { return 1 }
                si = si + 1
            }
        }
        return 0
    }
    if pk == NodeKind.IdentPattern {
        let en = resolve_variant(node_name(pat))
        if en != "" && is_data_enum(en) != 0 { return 1 }
    }
    0
}

fn match_arms_need_struct(arms_sl: Int) -> Int {
    if arms_sl == -1 { return 0 }
    let mut i = 0
    while i < sublist_length(arms_sl) {
        if match_arm_pattern_needs_struct(node_pattern(sublist_get(arms_sl, i))) != 0 { return 1 }
        i = i + 1
    }
    0
}

// The two-signal genuine-Void discriminator, factored out so every call
// site reuses it instead of re-deriving it inline. See emit_let_binding's
// Void-RHS handling for the full rationale.
fn rhs_is_genuine_void(val_type: Int, val_node: Int) -> Int {
    if val_type != CT_VOID { return 0 }
    if tc_tid_to_c_tag(tc_lookup_node_tid(val_node)) == "Void" { return 1 }
    0
}

// The tuple carrier tag of an enum variant's field, or `fallback` when the
// field isn't a tuple or its carrier isn't registered (e.g. a generic-enum
// instance whose payload tid still holds typevars). The tag drives the nested
// TuplePattern expansion in the match-binder.
fn tuple_field_carrier_tag(enum_name: Str, variant_name: Str, field_name: Str, fallback: Str) -> Str {
    let ftid = tc_variant_field_tid_by_name(enum_name, variant_name, field_name)
    if ftid < 0 { return fallback }
    let rtid = tc_tid_resolved(ftid)
    if tc_tid_kind(rtid) != TyKind.Tuple { return fallback }
    let tag = tc_tid_tuple_sname(rtid)
    if tag != "" && tuple_struct_arity(tag) >= 0 { tag } else { fallback }
}

// Substituting twin of tuple_field_carrier_tag. On a generic-enum instance the
// variant field tid still holds the enum's typevars (`(T,T)`), so its raw carrier
// isn't registered; substitute against the scrutinee's mono args first so the tag
// resolves to the concrete carrier (`Tuple2_P_P`). Falls back to the raw lookup.
fn tuple_field_carrier_tag_mono(enum_name: Str, variant_name: Str, field_name: Str, scrut_mono: Str, fallback: Str) -> Str {
    let ftid = tc_variant_field_tid_by_name(enum_name, variant_name, field_name)
    if ftid >= 0 && scrut_mono != "" {
        let rtid = tc_tid_resolved(subst_variant_field_binder_tid(ftid, enum_name, scrut_mono))
        if tc_tid_kind(rtid) == TyKind.Tuple {
            let tag = tc_tid_tuple_sname(rtid)
            if tag != "" && tuple_struct_arity(tag) >= 0 { return tag }
        }
    }
    tuple_field_carrier_tag(enum_name, variant_name, field_name, fallback)
}

// The mono tuple carrier of a SELF-RECURSIVE tuple field, resolved from the
// field's ANNOTATION exactly as emit_mono_enum_typedef spells its typedef. The
// tid path cannot serve here: a self-referring tuple element is stored arg-less
// (bare `Box`, not `Box[T]`), so tc_tid_tuple_sname yields the erased
// `Tuple2_Box_Box` — never the registered `Tuple2_Box_0Int_Box_0Int`. Reads the
// enum's tparams and the scrutinee-mono arg tids so `(Box[T], Box[T])` on a
// Box[Int] resolves to the same carrier the typedef emitter registered.
fn selfrec_tuple_field_carrier(enum_name: Str, variant_name: Str, field_name: Str, scrut_mono: Str) -> Str {
    let td = find_type_def(enum_name)
    if td == -1 { return "" }
    let tparams_sl = node_type_params(td)
    // A non-generic enum has no typevars to substitute; resolve the tuple carrier
    // from the bare annotation with empty segs, exactly as emit_enum_typedef does.
    let segs = if tparams_sl == -1 { [] } else { segs_from_arg_tids(lookup_mono_base(scrut_mono).arg_tids) }
    let flds_sl = node_fields(td)
    if flds_sl == -1 { return "" }
    let mut i = 0
    while i < sublist_length(flds_sl) {
        let v = sublist_get(flds_sl, i)
        if node_name(v) == variant_name {
            let vflds = node_fields(v)
            if vflds != -1 {
                let mut fi = 0
                while fi < sublist_length(vflds) {
                    let vf = sublist_get(vflds, fi)
                    if node_name(vf) == field_name {
                        let ann = node_value(vf)
                        if ann != -1 && node_name(ann) == "Tuple" {
                            let tup = resolve_tuple_ann(ann, tparams_sl, segs)
                            if tup.is_some() { return tup.unwrap() }
                        }
                        return ""
                    }
                    fi = fi + 1
                }
            }
        }
        i = i + 1
    }
    ""
}

// Materialize a tuple scrutinee into one temp and push one `._i` field-access
// entry per element onto match_scruts, so a TuplePattern arm can index
// scrut_off + j per element. Element types/carrier metadata come from the
// tuple's registered fields. Shared by the top-level tuple-scrutinee fast path
// and the nested tuple sub-pattern expansion (an enum variant Tuple payload).
fn expand_tuple_scrut_entry(tup_tag: Str, base_expr: Str) ! Codegen.Emit, Codegen.Scope {
    let scrut_tmp = fresh_temp("_scrut_")
    emit_line("{c_type_c_name(tup_tag)} {scrut_tmp} = {base_expr};")
    set_var(scrut_tmp, CT_STRUCT, 1)
    set_var_struct(scrut_tmp, tup_tag)
    push_tuple_elem_scruts(tup_tag, scrut_tmp)
}

@allow(UnrestoredMutation, IncompleteStateRestore)
pub fn emit_match_expr(node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let scrut = node_scrutinee(node)

    // Build list of scrutinee values (multiple if tuple literal)
    match_scruts = []
    match_scrut_enum = ""

    if node_kind(scrut) == NodeKind.TupleLit {
        let elems_sl = node_elements(scrut)
        if elems_sl != -1 {
            let mut ei = 0
            while ei < sublist_length(elems_sl) {
                let match_tuple_elem_node = sublist_get(elems_sl, ei)
                emit_expr(match_tuple_elem_node)
                let tmp = fresh_temp("_tup_")
                let elem_sname = if expr_result_type == CT_STRUCT { get_var_struct(expr_result_str) } else { "" }
                if elem_sname != "" {
                    emit_line("{c_type_c_name(elem_sname)} {tmp} = {expr_result_str};")
                    set_var(tmp, CT_STRUCT, 1)
                    set_var_struct(tmp, elem_sname)
                    // The tuple-element temp has no typecheck node, so its struct name
                    // lived only on the flat sname channel. The element expr's tid is
                    // the value's type; stamp it so the tid leads, but only when that
                    // tid round-trips to the same name the C decl carries.
                    let elem_tid = cg_node_mono_tid(match_tuple_elem_node)
                    if tid_spells_struct(elem_tid, elem_sname) != 0 { set_var_ty(tmp, elem_tid) }
                    match_scruts.push(MatchScrutEntry { str_val: tmp, scrut_type: expr_result_type, scrut_sname: elem_sname })
                } else if expr_result_type == CT_OPTION {
                    let oi = expr_option_inner
                    let oi_s = expr_option_inner_struct
                    // A compound inner (`Option[Map[K,V]]`) erases through the flat
                    // oi/oi_s channels — they carry only a one-level inner and spell
                    // blink_Option_map. The element tid holds the full inner, so lead
                    // with it for exactly that shape, mirroring the non-tuple scrutinee.
                    let opt_elem_tid_r = tc_tid_resolved(cg_node_mono_tid(match_tuple_elem_node))
                    let opt_elem_tid_c = c_type_from_tid(cg_node_mono_tid(match_tuple_elem_node))
                    let opt_elem_compound = is_compound_ct(tc_tid_option_inner_ct(opt_elem_tid_r)) != 0
                    let opt_c = if opt_elem_compound && opt_elem_tid_c.starts_with("blink_Option_") { opt_elem_tid_c } else if oi_s != "" { struct_option_c_type(oi_s) } else { option_c_type(oi) }
                    // Build the carrier tag from the captured expr metadata (oi_s
                    // is the canonical inner tag), mirroring the CT_RESULT branch's
                    // res_tag. compound_option_inner_name re-derives it from a
                    // scope-var lookup on expr_result_str, which is "" for a
                    // non-registered element expression (e.g. a call result).
                    let opt_tag = if oi_s != "" { "Option_{oi_s}" } else { "Option_{c_type_tag(oi)}" }
                    emit_line("{opt_c} {tmp} = {expr_result_str};")
                    set_var(tmp, CT_OPTION, 1)
                    set_var_option(tmp, oi)
                    if oi_s != "" { set_var_option_struct(tmp, oi, oi_s) }
                    match_scruts.push(MatchScrutEntry { str_val: tmp, scrut_type: expr_result_type, scrut_sname: opt_tag })
                } else if expr_result_type == CT_RESULT {
                    let rok = expr_result_ok_type
                    let rerr = expr_result_err_type
                    let rok_s = expr_result_ok_struct
                    let rerr_s = expr_result_err_struct
                    // A compound ok/err inner (`Result[Map[K,V], E]`) erases through the
                    // flat rok/rerr channels — they carry only a one-level inner and spell
                    // blink_Result_map_str. The element tid holds the full inner, so lead
                    // with it for exactly that shape, mirroring the non-tuple scrutinee.
                    let res_elem_tid_r = tc_tid_resolved(cg_node_mono_tid(match_tuple_elem_node))
                    let res_elem_tid_c = c_type_from_tid(cg_node_mono_tid(match_tuple_elem_node))
                    let res_elem_compound = is_compound_ct(tc_tid_result_ok_ct(res_elem_tid_r)) != 0 || is_compound_ct(tc_tid_result_err_ct(res_elem_tid_r)) != 0
                    let res_c = if res_elem_compound && res_elem_tid_c.starts_with("blink_Result_") { res_elem_tid_c } else if rok_s != "" || rerr_s != "" { result_c_type_mixed(rok, rerr, rok_s, rerr_s) } else { result_c_type(rok, rerr) }
                    let ok_tag = if rok_s != "" { rok_s } else { c_type_tag(rok) }
                    let err_tag = if rerr_s != "" { rerr_s } else { c_type_tag(rerr) }
                    let res_tag = "Result_{ok_tag}_{err_tag}"
                    emit_line("{res_c} {tmp} = {expr_result_str};")
                    set_var(tmp, CT_RESULT, 1)
                    set_var_result(tmp, rok, rerr)
                    if rok_s != "" || rerr_s != "" { set_var_result_struct(tmp, rok, rerr, rok_s, rerr_s) }
                    match_scruts.push(MatchScrutEntry { str_val: tmp, scrut_type: expr_result_type, scrut_sname: res_tag })
                } else {
                    // A genuinely Void tuple element (e.g. `match (nothing(), 1) {
                    // ... }`) must not materialize as `void _tup_0 = ...;`. Use
                    // the same two-signal guard as emit_let_binding.
                    let mte_is_void = rhs_is_genuine_void(expr_result_type, match_tuple_elem_node) != 0
                    if mte_is_void {
                        if expr_result_str != "" && expr_result_str != "0" {
                            emit_line("(void){expr_result_str};")
                        }
                        emit_line("int64_t {tmp} = 0;")
                    } else {
                        let tup_flat_c = c_type_str(expr_result_type)
                        let tup_tid = cg_node_mono_tid(match_tuple_elem_node)
                        ctype_probe_at(tup_tid, "tuple_scrut_elem", tmp, tup_flat_c, match_tuple_elem_node)
                        let tup_spelled = c_type_from_tid(tup_tid)
                        // The genuine-Void case is handled by the branch above, so a "void" here is
                        // the tid declining rather than a real Void, and the flat spelling stands.
                        let tup_ts = if tup_spelled != "" && tup_spelled != "void" { tup_spelled } else { tup_flat_c }
                        emit_line("{tup_ts} {tmp} = {expr_result_str};")
                    }
                    set_var(tmp, expr_result_type, 1)
                    match_scruts.push(MatchScrutEntry { str_val: tmp, scrut_type: expr_result_type })
                }
                ei = ei + 1
            }
        }
    } else {
        if node_kind(scrut) == NodeKind.Ident {
            match_scrut_enum = get_var_enum(node_name(scrut))
        } else if node_kind(scrut) == NodeKind.FieldAccess {
            match_scrut_enum = infer_enum_from_node(scrut)
        }
        emit_expr(scrut)
        if match_scrut_enum == "" && expr_result_type == CT_STRUCT {
            let scrut_s = get_var_struct(expr_result_str)
            if scrut_s != "" && is_data_enum(scrut_s) != 0 {
                match_scrut_enum = scrut_s
            } else if scrut_s != "" && is_mono_struct_instance(scrut_s) != 0 {
                // Inline generic-enum scrutinee (`match Branch(Leaf(1), Leaf(2)) {…}`):
                // the ctor tagged the value string with the mono stem (Tree_Int), which
                // is NOT in enum_reg_set at body-codegen time (only the typedef pass
                // registers it). Recover the BARE base via lookup_mono_base so
                // match_scrut_enum drives variant lookups; the mono C type comes from
                // get_var_struct below.
                let base = lookup_mono_base(scrut_s).base
                if base != "" && is_data_enum(base) != 0 {
                    match_scrut_enum = base
                }
            }
        }
        if match_scrut_enum != "" && is_data_enum(match_scrut_enum) != 0 {
            let scrut_tmp = fresh_temp("_scrut_")
            // A generic-enum scrutinee (`match t {…}` where t: Tree[Int]) declares the
            // scrutinee temp with the mono instance C type (blink_Tree_Int), recovered
            // from the scrutinee var's tracked struct name; match_scrut_enum itself stays
            // BARE (`Tree`) so variant tag/field lookups keep working. A named
            // scrutinee (`match t`) reads the var's tracked struct; a non-Ident one
            // (`match Branch(Leaf(1), Leaf(2))` inline) recovers the mono from the emitted
            // value string, which the ctor tagged via set_var_struct.
            let scrut_mono = if node_kind(scrut) == NodeKind.Ident { get_var_struct(node_name(scrut)) } else { get_var_struct(expr_result_str) }
            // The tid LEADS over both recoveries above. Both read a NAME — the var's
            // tracked struct, or the emitted value string's — and a scrutinee whose
            // instance was fixed by an ANNOTATION rather than by its constructor
            // arguments has the bare base recorded under that name. So `match t`
            // where `t: ITree[Int] = INone` would declare the temp `blink_ITree`, a
            // typedef that is never emitted. The tid reads the NODE and is
            // indifferent to how the scrutinee was spelled.
            //
            // match_scrut_enum still stays BARE — it is the variant tag/field lookup
            // key, not a C type — and so does the scrut_sname recorded below, for
            // the same reason.
            let scrut_tid_c = enum_instance_c_from_tid(tc_lookup_node_tid(scrut))
            let scrut_c = if scrut_tid_c != "" {
                scrut_tid_c
            } else if scrut_mono != "" && is_mono_struct_instance(scrut_mono) != 0 {
                c_type_from_tag(scrut_mono)
            } else {
                c_type_from_tag(match_scrut_enum)
            }
            emit_line("{scrut_c} {scrut_tmp} = {expr_result_str};")
            set_var(scrut_tmp, CT_INT, 1)
            if scrut_mono != "" && is_mono_struct_instance(scrut_mono) != 0 { set_var_struct(scrut_tmp, scrut_mono) }
            match_scruts.push(MatchScrutEntry { str_val: scrut_tmp, scrut_type: expr_result_type, scrut_sname: scrut_mono })
        } else if expr_result_type == CT_RESULT || expr_result_type == CT_OPTION {
            let scrut_tmp = fresh_temp("_scrut_")
            let rok = expr_result_ok_type
            let rerr = expr_result_err_type
            if expr_result_type == CT_RESULT {
                let rok_s = expr_result_ok_struct
                let rerr_s = expr_result_err_struct
                // A compound ok/err inner (`Result[Map[K,V], E]`) erases through the
                // flat rok/rerr channels — they carry only a one-level inner and spell
                // blink_Result_map_str. The scrutinee tid holds the full inner, so lead
                // with it for exactly that shape, mirroring the CT_OPTION branch below.
                // For a NON-compound inner the split flips: a generic-struct instance
                // (`Result[Inner[T], Str]`) erases through the tid to the bare head
                // (blink_Result_Inner_str), while the flat channel keeps the mono stem
                // (Inner_0Int) — so lead with the tid only when the inner is compound.
                let res_scrut_tid_r = tc_tid_resolved(cg_node_mono_tid(scrut))
                let res_scrut_tid_c = c_type_from_tid(cg_node_mono_tid(scrut))
                let res_scrut_compound = is_compound_ct(tc_tid_result_ok_ct(res_scrut_tid_r)) != 0 || is_compound_ct(tc_tid_result_err_ct(res_scrut_tid_r)) != 0
                if res_scrut_compound && res_scrut_tid_c.starts_with("blink_Result_") {
                    emit_line("{res_scrut_tid_c} {scrut_tmp} = {expr_result_str};")
                } else if rok_s != "" || rerr_s != "" {
                    let res_c = result_c_type_mixed(rok, rerr, rok_s, rerr_s)
                    emit_line("{res_c} {scrut_tmp} = {expr_result_str};")
                } else if res_scrut_tid_c.starts_with("blink_Result_") {
                    emit_line("{res_scrut_tid_c} {scrut_tmp} = {expr_result_str};")
                } else {
                    let res_c = result_c_type(rok, rerr)
                    emit_line("{res_c} {scrut_tmp} = {expr_result_str};")
                }
            } else {
                let oi = expr_option_inner
                let oi_s = expr_option_inner_struct
                let oi_erased = expr_option_erased
                if oi_erased != 0 {
                    // A ptr-erased scrutinee is a blink_Option_ptr box; the true struct
                    // rides oi_s and the payload is recovered by the Some(x) arm. Record
                    // the true struct + erased bit on scrut_tmp so bind_pattern_vars casts
                    // the void* payload back — the transient expr_option_erased global is
                    // clobbered by the intervening arm-condition emits.
                    ensure_option_type(CT_PTR)
                    let opt_c = option_c_type(CT_PTR)
                    emit_line("{opt_c} {scrut_tmp} = {expr_result_str};")
                    set_var_option_struct(scrut_tmp, oi, oi_s)
                    set_var_option_erased(scrut_tmp, 1)
                } else if is_compound_ct(tc_tid_option_inner_ct(tc_tid_resolved(cg_node_mono_tid(scrut)))) != 0 && c_type_from_tid(cg_node_mono_tid(scrut)).starts_with("blink_Option_") {
                    // A compound inner (`Option[Map[K,V]]`, `Option[Option[T]]`) erases
                    // through the flat oi/oi_s channels, which drop the nested args; the
                    // tid carries the full inner, so lead with it for exactly that shape.
                    // For a NON-compound inner the split flips (mirrors the CT_RESULT arm
                    // above): a generic-struct instance erases through the tid to the bare
                    // head (blink_Option_Inner), while the flat channel keeps the mono
                    // stem (Inner_0Int) — so the flat branch below must win.
                    let opt_c = c_type_from_tid(cg_node_mono_tid(scrut))
                    emit_line("{opt_c} {scrut_tmp} = {expr_result_str};")
                } else if oi_s != "" {
                    let opt_c = struct_option_c_type(oi_s)
                    emit_line("{opt_c} {scrut_tmp} = {expr_result_str};")
                    // An @ffi.opaque inner is niche-optimized to the bare handle
                    // pointer; record it on the copy so the arm test and binder read
                    // the NULL niche instead of a `.tag`/`.value` carrier.
                    if is_opaque_type(oi_s) != 0 {
                        set_var(scrut_tmp, CT_OPTION, 1)
                        set_var_option(scrut_tmp, oi)
                        set_var_option_struct(scrut_tmp, oi, oi_s)
                        // The arm-condition and binder read the inner nominal through the
                        // TID accessors (get_var_option_inner_nominal), not the flat sname,
                        // so carry the scrutinee's Option[opaque] tid onto the copy.
                        set_var_ty(scrut_tmp, cg_node_mono_tid(scrut))
                    }
                } else if c_type_from_tid(cg_node_mono_tid(scrut)).starts_with("blink_Option_") {
                    let opt_c = c_type_from_tid(cg_node_mono_tid(scrut))
                    emit_line("{opt_c} {scrut_tmp} = {expr_result_str};")
                } else {
                    let opt_c = option_c_type(oi)
                    emit_line("{opt_c} {scrut_tmp} = {expr_result_str};")
                }
                // The materialized scrut_tmp is a bare C copy with no scope-var
                // metadata of its own — unwrap_carrier reads the still-live transient
                // globals for inner_ct/inner_struct, but a CT_SET inner's OWN element
                // rides the source var's flat inner2 channel, which the copy above
                // does not carry. Copy it explicitly (mirrors the CT_LIST branch's
                // get_list_elem_type(src_name) carry) before expr_result_str moves on,
                // so bind_pattern_vars's Some(x) arm can read it off scrut_tmp.
                if oi == CT_SET {
                    // set_var_option_inner2 only mutates an EXISTING CT_OPTION
                    // scope_vars entry (no push fallback, unlike set_var_option) —
                    // scrut_tmp has no entry at all on this branch, so register it
                    // first or the inner2 write below is a silent no-op.
                    set_var_option(scrut_tmp, oi)
                    let set_nested = get_var_option_inner2(expr_result_str)
                    if set_nested != -1 {
                        set_var_option_inner2(scrut_tmp, set_nested)
                    }
                }
            }
            match_scruts.push(MatchScrutEntry { str_val: scrut_tmp, scrut_type: expr_result_type })
        } else if expr_result_type == CT_LIST {
            let scrut_tmp = fresh_temp("_scrut_")
            emit_line("blink_list* {scrut_tmp} = {expr_result_str};")
            set_var(scrut_tmp, CT_LIST, 1)
            // Carry the scrutinee's list tid onto the temp so a list-pattern arm can
            // read each element back off the authoritative element tid — a boxed
            // carrier/struct element needs `*(T*)blink_list_get(...)`, which only the
            // tid can spell; the flat elem channels below cannot.
            let scrut_list_tid = cg_node_mono_tid(scrut)
            if scrut_list_tid >= 0 {
                set_var_ty(scrut_tmp, scrut_list_tid)
            }
            let mut src_name = expr_result_str
            if node_kind(scrut) == NodeKind.Ident {
                src_name = node_name(scrut)
            }
            let lelem = get_list_elem_type(src_name)
            if lelem >= 0 {
                set_list_elem_type(scrut_tmp, lelem)
            }
            let lstruct = get_list_elem_struct(src_name)
            if lstruct != "" {
                set_list_elem_struct(scrut_tmp, lstruct)
            }
            match_scruts.push(MatchScrutEntry { str_val: scrut_tmp, scrut_type: CT_LIST })
        } else if expr_result_type == CT_STRING {
            // Bind a string scrutinee to a temp so each arm's condition
            // (blink_str_eq({scrut}, "x")) re-reads a variable instead of
            // re-embedding the scrutinee expression. An interpolated string
            // lowers to a side-effecting blink_str_format(...) call, so without
            // this its interpolants would run once per arm tested.
            let scrut_tmp = fresh_temp("_scrut_")
            emit_line("const char* {scrut_tmp} = {expr_result_str};")
            set_var(scrut_tmp, CT_STRING, 1)
            match_scruts.push(MatchScrutEntry { str_val: scrut_tmp, scrut_type: CT_STRING })
        } else if c_type_str(expr_result_type) != "void" && expr_result_type != CT_STRUCT && expr_result_type != CT_ENUM && expr_result_type != CT_VOID && match_arms_need_struct(node_arms(node)) == 0 {
            // Bind a scalar scrutinee (Int/Float/Bool/Char + sized ints) to a
            // temp so each arm's condition (e.g. `({scrut} == {pat})`) re-reads
            // a variable instead of re-embedding the scrutinee expression. A
            // side-effecting scrutinee (a fn call) would otherwise run once per
            // arm tested. Mirrors the String branch above. The `!= "void"` gate
            // is primary — c_type_str maps only genuine scalar CTs to real C
            // types; struct/enum/void CTs fall through to the raw-push fallback.
            // The `!= CT_STRUCT` gate also excludes data-enum-returning calls:
            // get_fn_ret reports those as CT_STRUCT, so they route to the
            // data-enum branch above (via match_scrut_enum) rather than being
            // mis-bound as scalars here. The match_arms_need_struct guard stays
            // as defence-in-depth for any residual variant-pattern arm that
            // reads `.tag` on a scrutinee that still reports a scalar CT.
            let scrut_tmp = fresh_temp("_scrut_")
            let scrut_flat_c = c_type_str(expr_result_type)
            let scrut_tid = cg_node_mono_tid(scrut)
            ctype_probe_at(scrut_tid, "match.scrut_scalar", scrut_tmp, scrut_flat_c, scrut)
            // The gate above excludes CT_ENUM, so an enum only arrives here already erased to a
            // scalar CT and the flat spelling has no name left to give. The tid still has it.
            //
            // Safe for the same reason as the two result temps: every carrier kind is routed to an
            // earlier branch, so what reaches this one is a scalar or a pointer, and those convert
            // implicitly in C even where the position's physical type is an erased vtable slot.
            let scrut_spelled = c_type_from_tid(scrut_tid)
            // A temp is a STORAGE position, so a genuine Void keeps the flat placeholder.
            let scrut_ts = if scrut_spelled != "" && scrut_spelled != "void" { scrut_spelled } else { scrut_flat_c }
            emit_line("{scrut_ts} {scrut_tmp} = {expr_result_str};")
            set_var(scrut_tmp, expr_result_type, 1)
            match_scruts.push(MatchScrutEntry { str_val: scrut_tmp, scrut_type: expr_result_type })
        } else if expr_result_type == CT_STRUCT && tuple_struct_arity(get_var_struct(expr_result_str)) >= 0 {
            // A tuple-typed NON-literal scrutinee (call/ident/field). The
            // TupleLit fast path splits a literal into one match_scruts entry per
            // element; a tuple-returning call/ident falls here as CT_STRUCT and
            // would otherwise push a single whole-tuple entry, so a TuplePattern
            // arm indexing scrut_off + j past element 0 unwraps a None
            // match_scruts entry. Materialize the tuple into one temp
            // (no re-evaluation of a side-effecting call) and push one `._i`
            // field-access entry per element, mirroring the fast path. Element
            // types/carrier metadata come from the tuple's registered fields,
            // exactly as emit_tuple_destructure resolves them.
            expand_tuple_scrut_entry(get_var_struct(expr_result_str), expr_result_str)
        } else {
            match_scruts.push(MatchScrutEntry { str_val: expr_result_str, scrut_type: expr_result_type })
        }
    }

    let saved_ok_type = expr_result_ok_type
    let saved_err_type = expr_result_err_type
    let saved_option_inner = expr_option_inner
    let saved_ok_struct = expr_result_ok_struct
    let saved_err_struct = expr_result_err_struct
    let saved_option_inner_struct = expr_option_inner_struct
    let saved_option_inner_map_val_struct = expr_option_inner_map_val_struct
    let saved_option_inner_map_val_list_elem = expr_option_inner_map_val_list_elem
    // Preserve the scrutinee Option's deep inner tp (a nested Map/List)
    // across each arm so the Some(mm)/Ok(mm) binding recovers the container's own
    // K/V — the arm loop below clobbers the transient global while inferring arm
    // types, exactly like the map_val channels above.
    let saved_option_inner_tp = expr_option_inner_tp
    let saved_list_elem_type = expr_list_elem_type
    let saved_list_elem_struct = expr_list_elem_struct

    let arms_sl = node_arms(node)
    if arms_sl == -1 {
        expr_result_str = "0"
        expr_result_type = CT_VOID
        return
    }

    let first_arm = sublist_get(arms_sl, 0)
    let mut result_type = infer_arm_type(first_arm)
    let result_var = fresh_temp("_match_")

    // Buffer-emit pre-pass: harvest each arm's authoritative post-emit carrier.
    // The static infer_arm_type pre-pass is blind to `?` (which unwraps a
    // Result/Option arm to its inner type — read_one()? : Bytes, not Result) and
    // to builtin-heap constructors (Bytes.new() : CT_VOID), so it would declare
    // the wrong result temp. We emit each arm value
    // into a throwaway buffer, snapshot the carrier, then discard the lines and
    // reset the temp counter so the real loop below re-emits identically.
    // bind_pattern_vars mutates scope, so the whole pre-pass is scoped.
    let saved_pp_lines = cg_lines
    let saved_pp_temp = cg_temp_counter
    push_scope()
    let mut pp_type = CT_VOID
    let mut pp_carrier = snapshot_carrier()
    let mut pp_all_value = 1
    let mut ppi = 0
    while ppi < sublist_length(arms_sl) {
        expr_result_ok_type = saved_ok_type
        expr_result_err_type = saved_err_type
        expr_option_inner = saved_option_inner
        expr_result_ok_struct = saved_ok_struct
        expr_result_err_struct = saved_err_struct
        expr_option_inner_struct = saved_option_inner_struct
        expr_option_inner_map_val_struct = saved_option_inner_map_val_struct
        expr_option_inner_map_val_list_elem = saved_option_inner_map_val_list_elem
        expr_option_inner_tp = saved_option_inner_tp
        expr_list_elem_type = saved_list_elem_type
        expr_list_elem_struct = saved_list_elem_struct
        let pp_arm = sublist_get(arms_sl, ppi)
        cg_lines = []
        cg_indent = cg_indent + 1
        let saved_pp_scruts = match_scruts
        let saved_pp_scrut_enum = match_scrut_enum
        bind_pattern_vars(node_pattern(pp_arm), 0, match_scruts.len())
        let pp_arm_val = emit_arm_value(node_body(pp_arm))
        match_scruts = saved_pp_scruts
        match_scrut_enum = saved_pp_scrut_enum
        cg_indent = cg_indent - 1
        let arm_carrier = snapshot_carrier()
        // An arm that yields no value (empty, or a body that only assigns) means
        // the match is in statement position — keep it void so the existing
        // `(void)arm_val` discard path runs unchanged. Use a structural check
        // (arm_body_is_valueless) rather than a `pp_arm_val == "0"` string compare:
        // a literal `0` in value position (`None => 0`) also emits "0" but is a
        // genuine value.
        if arm_carrier.ct == CT_VOID || pp_arm_val == "" || arm_body_is_valueless(node_body(pp_arm)) != 0 {
            pp_all_value = 0
        }
        if pp_type == CT_VOID && arm_carrier.ct != CT_VOID {
            pp_type = arm_carrier.ct
            pp_carrier = arm_carrier
        } else if pp_type != CT_VOID {
            if pp_type == CT_OPTION && carrier_option_concrete(pp_carrier) == 0 && carrier_option_concrete(arm_carrier) != 0 {
                pp_carrier = arm_carrier
            } else if pp_type == CT_RESULT && carrier_result_concrete(pp_carrier) == 0 && carrier_result_concrete(arm_carrier) != 0 {
                pp_carrier = arm_carrier
            }
        }
        ppi = ppi + 1
    }
    pop_scope()
    cg_lines = saved_pp_lines
    cg_temp_counter = saved_pp_temp

    // Resolve a struct-valued match (arms produce a user struct) exactly as
    // before, against the static result_type. This must run before the harvest
    // override so the override never demotes a genuine struct match to a scalar:
    // the pre-pass emits a struct arm whose tail is a pattern-bound ident (e.g.
    // `Ok(b) => { b }`) as CT_INT (the binding isn't typed in the throwaway
    // scope), which would otherwise mislead the harvest.
    // A match whose value is USED has a published node tid — a consumer (let/return/arg) memoized
    // it during typecheck. An unpublished tid means the value is discarded: a statement match. It
    // yields no value, so it must declare no result temp; forcing the result to Void here stops the
    // struct/flat fallbacks below from fabricating one (get_fn_ret_struct leaking the enclosing fn's
    // return struct, or infer_arm_type's guess) from a type the match does not have.
    let match_is_stmt = cg_node_mono_tid(node) < 0
    if match_is_stmt {
        result_type = CT_VOID
    }

    let mut match_struct_name = ""
    if (result_type == CT_STRUCT || result_type == CT_VOID) && match_is_stmt == 0 {
        match_struct_name = infer_arm_struct_name(first_arm)
        if match_struct_name == "" {
            match_struct_name = get_fn_ret_struct(cg_current_fn_name)
        }
        if match_struct_name == "" && saved_ok_struct != "" {
            let first_body = node_body(first_arm)
            if first_body != -1 {
                let fb_kind = node_kind(first_body)
                let mut check_node = first_body
                if fb_kind == NodeKind.ExprStmt {
                    check_node = node_value(first_body)
                }
                if node_kind(check_node) == NodeKind.Ident {
                    let ib_type = infer_arm_body_from_pattern(first_arm, check_node)
                    if ib_type >= 0 {
                        match_struct_name = saved_ok_struct
                    }
                }
            }
        }
    }

    // The harvested type overrides the static guess only for a non-struct match
    // where every arm produced a value of the same concrete carrier/scalar — i.e.
    // the match is genuinely value-producing and the static guess was wrong about
    // the element type. This fires for `?`-unwrapped arms (CT_VOID guess →
    // concrete scalar) and carrier arms whose inner type must come
    // from the values, not the fn return. Struct-valued and statement-position
    // matches are left untouched.
    if match_struct_name == "" && pp_type != CT_VOID && pp_all_value != 0 && pp_type != CT_STRUCT && (result_type == CT_VOID || result_type == CT_RESULT || result_type == CT_OPTION) {
        result_type = pp_type
    }

    // Both authorities above read the arms' emitted values, and neither can type an arm whose value
    // IS a pattern-bound ident: infer_arm_type answers its CT_INT default for an ident it cannot
    // name, and the pre-pass re-emits the arm in a throwaway scope where the binding carries no
    // type. Since CT_INT is also a legitimate answer, the harvest gate above cannot tell the two
    // apart and keeps the default — so `Ok(b) => { b }` mistyped the result temp and the enclosing
    // let together. The match's own tid is not derived from the arms, so it decides.
    //
    // Left alone where a struct name is already in hand: more specific than any CT, on a channel a
    // CT cannot carry.
    let m_tid = cg_node_mono_tid(node)
    let mut use_tid_carrier = 0
    if match_struct_name == "" && match_is_stmt == 0 {
        let m_kind = tc_tid_kind(m_tid)
        if m_kind == TyKind.Struct {
            // Deliberately not gated on pp_all_value. A struct value rides the carrier as CT_VOID,
            // so at the harvest an arm yielding a struct and an arm yielding nothing are the same
            // signal; a struct tid says outright that the match evaluates to a value.
            let m_stem = tc_tid_struct_mono_name(m_tid)
            match_struct_name = if m_stem != "" { m_stem } else { tc_tid_struct(m_tid) }
        } else if pp_all_value != 0 && ct_names_kind_completely(m_kind) != 0 {
            let m_ct = tc_tid_ct(m_tid)
            if m_ct >= 0 {
                result_type = m_ct
                if m_ct == CT_OPTION && tc_tid_option_inner_ct(m_tid) >= 0 { use_tid_carrier = 1 }
                if m_ct == CT_RESULT && tc_tid_result_ok_ct(m_tid) >= 0 && tc_tid_result_err_ct(m_tid) >= 0 { use_tid_carrier = 1 }
            }
        }
    }

    // The carrier shaping the result temp: the tid when it states a resolvable element, else
    // harvested from the arms when concrete, else the enclosing fn's return type (the bare
    // Ok/Err/Some/None fallback). A ptr-erased Option context (UE handler returning Option[Struct])
    // keeps the physical blink_Option_ptr representation — same exception as emit_if_expr.
    let mut mcarrier = if use_tid_carrier != 0 { carrier_from_tid(m_tid) } else { pp_carrier }
    if result_type == CT_OPTION {
        if cg_current_fn_option_inner == CT_PTR {
            mcarrier = carrier_ptr_option()
        } else if use_tid_carrier == 0 && carrier_option_concrete(pp_carrier) == 0 {
            mcarrier = carrier_from_fn_ret_option()
        }
    } else if result_type == CT_RESULT {
        if use_tid_carrier == 0 && carrier_result_concrete(pp_carrier) == 0 {
            mcarrier = carrier_from_fn_ret_result()
        }
    }

    // The result temp's spelling, assembled from the harvest before it is printed so the probe can
    // measure the same string the emit uses. A CT_VOID result declares no temp at all, which is why
    // the empty string gates both the probe and the emit rather than only the emit.
    let mut result_decl_c = ""
    let mut result_is_flat = 0
    if match_struct_name != "" {
        // c_type_c_name answers the bare generic base for an instance, and the base has no
        // typedef. The if-expression sibling that builds the same temp already leads with the
        // tid; without this the two result temps in one function spell one type two ways.
        let m_struct_mono = struct_instance_c_from_tid(cg_node_mono_tid(node))
        result_decl_c = if m_struct_mono != "" { m_struct_mono } else { c_type_c_name(match_struct_name) }
    } else if result_type == CT_RESULT {
        result_decl_c = result_c_type_mixed(mcarrier.ok_type, mcarrier.err_type, mcarrier.ok_struct, mcarrier.err_struct)
    } else if result_type == CT_OPTION {
        if mcarrier.option_inner_struct != "" {
            result_decl_c = struct_option_c_type(mcarrier.option_inner_struct)
        } else {
            result_decl_c = option_c_type(mcarrier.option_inner)
        }
    } else if result_type != CT_VOID {
        result_decl_c = c_type_str(result_type)
        result_is_flat = 1
    }
    if result_decl_c != "" {
        let m_decl_tid = cg_node_mono_tid(node)
        if result_is_flat == 0 {
            // A carrier or struct result keeps the physical spelling assembled above. Inside a
            // handler implementation that spelling is the effect slot's erased one, and the two
            // are different structs, so the tid's logical answer cannot be substituted here.
            ctype_probe_at(m_decl_tid, "match.result_carrier", result_var, result_decl_c, node)
        } else {
            // Nothing stamps a name on this temp: the harvest carries a CT, so an enum-valued match
            // declared int64_t and lost the fact. Safe where the carrier branch is not — every
            // carrier kind takes that branch, so what reaches here is a scalar or a pointer, and
            // those convert implicitly in C.
            ctype_probe_at(m_decl_tid, "match.result_flat", result_var, result_decl_c, node)
            let m_spelled = c_type_from_tid(m_decl_tid)
            // A temp is a STORAGE position, so a genuine Void keeps the flat placeholder.
            if m_spelled != "" && m_spelled != "void" { result_decl_c = m_spelled }
        }
        emit_line("{result_decl_c} {result_var};")
    }

    let mut has_guards = 0
    let mut gi = 0
    while gi < sublist_length(arms_sl) {
        if node_guard(sublist_get(arms_sl, gi)) != -1 {
            has_guards = 1
        }
        gi = gi + 1
    }

    if has_guards {
        emit_line("int _mg_ = 0;")
    }

    // Install the harvested Option inner so a bare-`None` arm emits the matching
    // blink_Option_<T> instead of the default placeholder (mirrors the if-expr
    // bare-None re-emit). Restored after the arm loop.
    let saved_loop_option_inner = cg_current_fn_option_inner
    let saved_loop_option_inner_struct = cg_current_fn_option_inner_struct
    if result_type == CT_OPTION {
        cg_current_fn_option_inner = mcarrier.option_inner
        cg_current_fn_option_inner_struct = mcarrier.option_inner_struct
    }

    // Tracks whether any arm absorbs every remaining scrutinee unconditionally
    // (`_` or a plain binding, no guard). Its absence is what makes the
    // fail-closed tail below necessary — see the backstop comment at the chain
    // close.
    let mut saw_catch_all = 0
    let mut _first = 1
    let mut i = 0
    while i < sublist_length(arms_sl) {
        expr_result_ok_type = saved_ok_type
        expr_result_err_type = saved_err_type
        expr_option_inner = saved_option_inner
        expr_result_ok_struct = saved_ok_struct
        expr_result_err_struct = saved_err_struct
        expr_option_inner_struct = saved_option_inner_struct
        expr_option_inner_map_val_struct = saved_option_inner_map_val_struct
        expr_option_inner_map_val_list_elem = saved_option_inner_map_val_list_elem
        expr_option_inner_tp = saved_option_inner_tp
        expr_list_elem_type = saved_list_elem_type
        expr_list_elem_struct = saved_list_elem_struct
        let arm = sublist_get(arms_sl, i)
        let pat = node_pattern(arm)

        let pat_cond = pattern_condition(pat, 0, match_scruts.len())
        let guard_node = node_guard(arm)
        let is_wildcard = pat_cond == "" && guard_node == -1

        if has_guards {
            if pat_cond == "" {
                if guard_node == -1 { saw_catch_all = 1 }
                if _first {
                    emit_line("if (!_mg_) \{")
                } else {
                    emit_line("} if (!_mg_) \{")
                }
            } else if _first {
                emit_line("if (!_mg_ && {pat_cond}) \{")
            } else {
                emit_line("} if (!_mg_ && {pat_cond}) \{")
            }
            cg_indent = cg_indent + 1
            bind_pattern_vars(pat, 0, match_scruts.len())
            if guard_node != -1 {
                emit_expr(guard_node)
                let guard_str = expr_result_str
                emit_line("if ({guard_str}) \{")
                cg_indent = cg_indent + 1
                let arm_val = emit_arm_value(node_body(arm))
                if (result_type != CT_VOID || match_struct_name != "") && !(match_struct_name != "" && arm_val == "0") {
                    emit_line("{result_var} = {arm_val};")
                } else if arm_val != "0" && arm_val != "" {
                    emit_line("(void){arm_val};")
                }
                emit_line("_mg_ = 1;")
                cg_indent = cg_indent - 1
                emit_line("}")
            } else {
                let arm_val = emit_arm_value(node_body(arm))
                if (result_type != CT_VOID || match_struct_name != "") && !(match_struct_name != "" && arm_val == "0") {
                    emit_line("{result_var} = {arm_val};")
                } else if arm_val != "0" && arm_val != "" {
                    emit_line("(void){arm_val};")
                }
                emit_line("_mg_ = 1;")
            }
            cg_indent = cg_indent - 1
        } else {
            if is_wildcard {
                saw_catch_all = 1
                if _first {
                    emit_line("\{")
                } else {
                    emit_line("} else \{")
                }
            } else if _first {
                emit_line("if ({strip_outer_parens(pat_cond)}) \{")
            } else {
                emit_line("} else if ({strip_outer_parens(pat_cond)}) \{")
            }
            cg_indent = cg_indent + 1
            let saved_match_scruts = match_scruts
            let saved_match_scrut_enum = match_scrut_enum
            bind_pattern_vars(pat, 0, match_scruts.len())
            let arm_val = emit_arm_value(node_body(arm))
            match_scruts = saved_match_scruts
            match_scrut_enum = saved_match_scrut_enum
            if (result_type != CT_VOID || match_struct_name != "") && !(match_struct_name != "" && arm_val == "0") {
                emit_line("{result_var} = {arm_val};")
            } else if arm_val != "0" && arm_val != "" {
                emit_line("(void){arm_val};")
            }
            cg_indent = cg_indent - 1
            if is_wildcard {
                break
            }
        }

        _first = 0
        i = i + 1
    }

    // Fail-closed backstop. A value-producing match declares
    // `result_var` uninitialized; if no arm runs, every reader of it is UB —
    // pre-backstop this printed a stack address. E0004 rejects the one shape
    // typecheck can PROVE non-exhaustive (a declared-enum scrutinee) and
    // deliberately stays silent on the rest (Int/Str ranges, Option/Result arm
    // sets, refutable sub-patterns); that under-approximation is only sound
    // because the unmatched path traps here instead of reading garbage.
    //
    // A STATEMENT-position match is untouched: falling through without running
    // an arm produces no value to be read, so trapping would be a behaviour
    // change rather than a safety fix.
    //
    // Emitted as `else` on the plain if/else-if chain and as an `if (!_mg_)`
    // tail on the guarded form, since guarded arms are sibling blocks rather
    // than a chain.
    let produces_value = result_type != CT_VOID || match_struct_name != ""
    let needs_backstop = produces_value && saw_catch_all == 0 && _first == 0
    if needs_backstop && has_guards == 0 {
        emit_line("} else \{")
        cg_indent = cg_indent + 1
        emit_line(emit_panic_site("panic: non-exhaustive match at {panic_file_for_fmt(node)}:{panic_line_str(node)}", ""))
        cg_indent = cg_indent - 1
    }
    emit_line("}")
    if needs_backstop && has_guards != 0 {
        emit_line("if (!_mg_) \{")
        cg_indent = cg_indent + 1
        emit_line(emit_panic_site("panic: non-exhaustive match at {panic_file_for_fmt(node)}:{panic_line_str(node)}", ""))
        cg_indent = cg_indent - 1
        emit_line("}")
    }
    cg_current_fn_option_inner = saved_loop_option_inner
    cg_current_fn_option_inner_struct = saved_loop_option_inner_struct
    if match_struct_name != "" {
        set_var(result_var, CT_VOID, 1)
        // Registering the bare base leaves every field on this temp typed by a typevar, so a
        // read of it interpolates as `<value>`. Read the stem from the tid the declaration
        // above was spelled from, so the C type and the registered name cannot disagree.
        let m_stem = tc_tid_struct_mono_name(cg_node_mono_tid(node))
        set_var_struct(result_var, if m_stem != "" { m_stem } else { match_struct_name })
        expr_result_str = result_var
        expr_result_type = CT_VOID
    } else if result_type == CT_RESULT {
        set_var(result_var, result_type, 1)
        if mcarrier.ok_struct != "" || mcarrier.err_struct != "" {
            set_var_result_struct(result_var, mcarrier.ok_type, mcarrier.err_type, mcarrier.ok_struct, mcarrier.err_struct)
            expr_result_ok_struct = mcarrier.ok_struct
            expr_result_err_struct = mcarrier.err_struct
        } else {
            set_var_result(result_var, mcarrier.ok_type, mcarrier.err_type)
            expr_result_ok_struct = ""
            expr_result_err_struct = ""
        }
        expr_result_ok_type = mcarrier.ok_type
        expr_result_err_type = mcarrier.err_type
        expr_result_str = result_var
        expr_result_type = result_type
    } else if result_type == CT_OPTION {
        set_var(result_var, result_type, 1)
        if mcarrier.option_inner_struct != "" {
            set_var_option_struct(result_var, mcarrier.option_inner, mcarrier.option_inner_struct)
            expr_option_inner_struct = mcarrier.option_inner_struct
        } else {
            set_var_option(result_var, mcarrier.option_inner)
            expr_option_inner_struct = ""
        }
        expr_option_inner = mcarrier.option_inner
        expr_result_str = result_var
        expr_result_type = result_type
    } else if result_type != CT_VOID {
        set_var(result_var, result_type, 1)
        expr_result_str = result_var
        expr_result_type = result_type
    } else {
        expr_result_str = "0"
        expr_result_type = result_type
    }
}

// Resolve the C-level payload carrier for Some/Ok/Err unwrap.
// `enum_name` must be one of "Some" / "Ok" / "Err"; `scrut_type` is the
// scrutinee's compound carrier (CT_OPTION / CT_RESULT). Returns the field
// name on the carrier ("value" / "ok" / "err"), the inner CT, the inner
// struct name (or ""), and the payload expression — a heap-boxed data-enum
// payload is auto-dereferenced for "value"; transparent newtypes and
// payload-less enums are stored inline and read by value.
type UnwrapCarrier {
    field: Str
    inner_ct: Int
    inner_struct: Str
    payload_expr: Str
}

fn unwrap_carrier(enum_name: Str, scrut: Str, scrut_type: Int) -> UnwrapCarrier {
    let field = if enum_name == "Some" { "value" } else if enum_name == "Ok" { "ok" } else { "err" }
    let mut inner_ct = CT_VOID
    let mut inner_struct = ""
    if enum_name == "Some" && scrut_type == CT_OPTION {
        inner_ct = expr_option_inner
        inner_struct = expr_option_inner_struct
    } else if enum_name == "Ok" && scrut_type == CT_RESULT {
        inner_ct = expr_result_ok_type
        inner_struct = expr_result_ok_struct
    } else if enum_name == "Err" && scrut_type == CT_RESULT {
        inner_ct = expr_result_err_type
        inner_struct = expr_result_err_struct
    }
    let inner_is_enum = inner_struct != "" && is_enum_type(inner_struct) != 0
    let inner_is_transparent = inner_struct != "" && is_transparent_newtype(inner_struct) != 0
    let inner_is_opaque = inner_struct != "" && is_opaque_type(inner_struct) != 0
    let payload_expr = if field == "value" && inner_is_opaque {
        // NPO: the whole Option carrier is the bare handle pointer, so the Some
        // payload is the scrutinee itself — no `.value` member exists.
        "{scrut}"
    } else if field == "value" && inner_is_transparent {
        // Transparent newtype (e.g. Option[Errno]): the carrier's `.value` member
        // is a bare int64_t, not a boxed enum pointer — read it directly without
        // the *(blink_Errno*) deref the boxed path uses.
        "{scrut}.value"
    } else if field == "value" && inner_struct != "" && is_payloadless_enum(inner_struct) != 0 {
        // Payload-less enum (e.g. Option[Cmd]): emit_struct_option_typedef stores
        // the ordinal inline as a bare `{Cmd} value`, mirroring the transparent
        // newtype above — read it directly. The boxed deref below would treat the
        // inline ordinal as a pointer and fault.
        "{scrut}.value"
    } else if field == "value" && inner_is_enum {
        "(*({c_type_c_name(inner_struct)}*){scrut}.value)"
    } else if field == "value" {
        "{scrut}.value"
    } else if field == "err" && inner_struct != "" && is_boxed_struct_err(inner_struct) != 0 {
        // C2: a struct-typed err arm is boxed by pointer; deref for the payload.
        "(*{scrut}.{field})"
    } else {
        "{scrut}.{field}"
    }
    UnwrapCarrier { field: field, inner_ct: inner_ct, inner_struct: inner_struct, payload_expr: payload_expr }
}

// Re-derive the carrier-shape globals (expr_result_ok/err_*, expr_option_inner_*)
// for an INNER compound carrier when descending a collapsed nested pattern
// (`Ok(Ok(v))`, `Some(Some(v))`, …). `unwrap_carrier` reads these globals to
// decide the inner payload's C type; without this refresh the recursion sees the
// OUTER carrier's shape and mistypes the innermost binder as the intermediate
// carrier. `inner_ct`/`inner_tag` are the just-unwrapped carrier's
// ct + struct tag (`Result_int_str`, `Option_int`, …). Mirrors the tuple-access
// decomposition in codegen_expr.bl.
fn set_carrier_globals_from_inner(inner_ct: Int, inner_tag: Str) {
    if inner_ct == CT_RESULT && inner_tag.starts_with("Result_") {
        let rparts = split_result_compound(canonical_struct_tag(inner_tag))
        let ok_ct = type_from_name_tag(rparts.first)
        let err_ct = type_from_name_tag(rparts.second)
        expr_result_ok_type = ok_ct
        expr_result_err_type = err_ct
        expr_result_ok_struct = if ok_ct == CT_VOID && (is_struct_type(rparts.first) != 0 || is_enum_type(rparts.first) != 0) { rparts.first } else { typedef_tag_or_empty(rparts.first) }
        expr_result_err_struct = if err_ct == CT_VOID && (is_struct_type(rparts.second) != 0 || is_enum_type(rparts.second) != 0) { rparts.second } else { typedef_tag_or_empty(rparts.second) }
    } else if inner_ct == CT_OPTION && inner_tag.starts_with("Option_") {
        expr_option_inner = option_inner_ct_from_tag(inner_tag)
        expr_option_inner_struct = option_inner_struct_from_tag(inner_tag)
    }
}

// Resolve the owning enum of a bare (unqualified) variant pattern.
// Prefer the statically-known scrutinee enum when it genuinely owns the
// variant; only then is the global bare-name registry safe to consult.
// This is the single rule for bare-variant resolution — when two enums share
// a variant name, `resolve_variant` (first-writer-wins on the bare key) would
// otherwise pick the wrong enum, gating arms on the wrong tag and binding the
// wrong union member.
fn resolve_arm_enum(variant: Str) -> Str {
    if match_scrut_enum != "" && get_variant_index(match_scrut_enum, variant) >= 0 {
        return match_scrut_enum
    }
    resolve_variant(variant)
}

// Condition for a transparent-newtype enum pattern (`Errno(<sub>)`). The
// scrutinee at scrut_off is already the bare int64_t payload, so the condition
// is entirely the inner sub-pattern's condition against that scrutinee:
// `Errno(rc)`/`Errno(_)` → "" (always match); `Errno(11)` → `(scrut == 11)`.
fn transparent_payload_condition(pat: Int, scrut_off: Int) -> Str {
    let flds_sl = node_fields(pat)
    if flds_sl == -1 || sublist_length(flds_sl) == 0 { return "" }
    let sub_pat = sublist_get(flds_sl, 0)
    let sub_pk = node_kind(sub_pat)
    if sub_pk == NodeKind.IdentPattern || sub_pk == NodeKind.WildcardPattern { return "" }
    // Literal / range / nested sub-pattern: recurse against the bare scrutinee.
    let scrut = match_scruts.get(scrut_off).unwrap().str_val
    let saved_scruts = match_scruts
    let saved_enum = match_scrut_enum
    match_scruts = [MatchScrutEntry { str_val: scrut, scrut_type: CT_INT }]
    match_scrut_enum = ""
    let cond = pattern_condition(sub_pat, 0, 1)
    match_scruts = saved_scruts
    match_scrut_enum = saved_enum
    cond
}

// Push one `._i` field-access entry per tuple element onto match_scruts, reading
// each element's type/carrier metadata from the tuple's registered fields. A
// nested tuple element carries its own carrier tag on scrut_sname, so a
// TuplePattern arm can self-expand it again. base_expr is any lvalue naming the
// tuple (a temp on the binder side, a direct field access on the condition side).
fn push_tuple_elem_scruts(tup_tag: Str, base_expr: Str) {
    let arity = tuple_struct_arity(tup_tag)
    let mut ti = 0
    while ti < arity {
        let field_name = "_{ti}"
        let ft = get_struct_field_type(tup_tag, field_name)
        let fs = get_struct_field_stype(tup_tag, field_name)
        let elem_expr = "{base_expr}.{field_name}"
        if fs != "" {
            match_scruts.push(MatchScrutEntry { str_val: elem_expr, scrut_type: CT_STRUCT, scrut_sname: fs })
        } else {
            match_scruts.push(MatchScrutEntry { str_val: elem_expr, scrut_type: ft })
        }
        ti = ti + 1
    }
}

// Shared named-sub-field gating loop for the two struct-style spellings — bare
// `Variant { .. }` (StructPattern) and qualified `Type.Variant { .. }`
// (EnumPattern int_val:1). Routing both through one loop keeps them emitting
// identical code, the duality spec §3.5 requires. For an enum field the declared
// type is looked up BY NAME (struct-style fields may be reordered) so each
// sub-field carries the same context the positional loop threads: the CT (nested
// Option/Result carriers gate), the field's own enum name for match_scrut_enum
// (a nested bare variant resolves against it), and a tuple field's carrier tag
// (the TuplePattern arm self-expands it instead of unwrapping a missing scrut).
// The mono stem a self-recursive field's nested pattern reads against: the
// scrutinee's own mono when it names one (a directly self-recursive field shares
// the instance's type args), else the bare enum. Returns "" when the field is
// not self-recursive. Threaded onto the nested MatchScrutEntry.scrut_sname so a
// deeper level recovers the mono and derefs correctly.
fn selfrec_field_mono(field_base: Str, resolved_enum: Str, scrut_mono: Str) -> Str {
    if field_base != resolved_enum { return "" }
    if scrut_mono != "" && is_mono_struct_instance(scrut_mono) != 0 { return scrut_mono }
    resolved_enum
}

// The C scrutinee expression for a variant field read by a nested sub-pattern.
// A self-recursive field (`tail: LL[T]`) is stored boxed as int64_t, so it must
// be dereferenced through the instance's mono C type before the nested pattern
// reads its tag/payload; every other field is read directly. Shared by the
// struct-style and positional condition and binding paths so all four lower the
// box identically.
fn variant_field_scrut_expr(scrut: Str, variant: Str, fname: Str, field_base: Str, resolved_enum: Str, scrut_mono: Str) -> Str {
    let raw = "{scrut}.data.{variant}.{fname}"
    let stem = selfrec_field_mono(field_base, resolved_enum, scrut_mono)
    if stem == "" { return raw }
    "(*({c_type_c_name(stem)}*)(intptr_t){raw})"
}

fn struct_style_subfield_conditions(flds_sl: Int, scrut: Str, is_enum: Bool, resolved_enum: Str, variant: Str, scrut_mono: Str) -> Str {
    let vidx = if is_enum { get_variant_index(resolved_enum, variant) } else { -1 }
    let mut parts = ""
    let mut n = 0
    let mut j = 0
    while j < sublist_length(flds_sl) {
        let sf = sublist_get(flds_sl, j)
        let fname = node_name(sf)
        let fpat = node_pattern(sf)
        if fpat != -1 {
            let mut field_ct = CT_VOID
            let mut field_enum = ""
            let mut tup_tag = ""
            let mut field_base = ""
            if vidx >= 0 {
                let ft = variant_field_type_by_name(vidx, fname)
                field_base = strip_generic_args(ft)
                field_ct = type_from_name(ft)
                field_enum = if is_enum_type(field_base) != 0 { field_base } else { "" }
                if node_kind(fpat) == NodeKind.TuplePattern {
                    tup_tag = tuple_field_carrier_tag_mono(resolved_enum, variant, fname, scrut_mono, "")
                }
            }
            let field_scrut = if is_enum { variant_field_scrut_expr(scrut, variant, fname, field_base, resolved_enum, scrut_mono) } else { "{scrut}.{fname}" }
            let saved_scruts = match_scruts
            // A self-recursive field carries its mono stem so a deeper nested
            // condition can deref its own box; other fields keep their tuple tag.
            let cond_sname = selfrec_field_mono(field_base, resolved_enum, scrut_mono)
            match_scruts = [MatchScrutEntry { str_val: field_scrut, scrut_type: field_ct, scrut_sname: if cond_sname != "" { cond_sname } else { tup_tag } }]
            let saved_enum = match_scrut_enum
            match_scrut_enum = field_enum
            let sub_cond = pattern_condition(fpat, 0, 1)
            match_scrut_enum = saved_enum
            match_scruts = saved_scruts
            if sub_cond != "" {
                if n > 0 {
                    parts = parts.concat(" && ")
                }
                parts = parts.concat(sub_cond)
                n = n + 1
            }
        }
        j = j + 1
    }
    parts
}

// The C condition for a data-enum POSITIONAL constructor pattern: gate on the
// variant tag AND every refutable payload sub-pattern read through
// `{scrut}.data.{variant}.{field}`. Each field's declared type supplies the CT
// (so nested Option/Result carriers gate) and the enum name for match_scrut_enum
// (so a nested bare variant resolves against the field's own enum, not the
// outer one); a tuple field carries its carrier tag so the TuplePattern arm
// self-expands it. A qualified struct-style variant pattern (`E.V { x: 5 }`)
// parses as an EnumPattern with int_val:1 + StructLitField children; it gates
// each named sub-field through the shared struct-style loop.
fn positional_payload_condition(pat: Int, resolved_enum: Str, resolved_variant: Str, scrut: Str, tag: Int, scrut_mono: Str) -> Str {
    let base = "({scrut}.tag == {tag})"
    if node_int_val(pat) != 0 {
        let ss_flds = node_fields(pat)
        if ss_flds == -1 {
            return base
        }
        let ss_sub = struct_style_subfield_conditions(ss_flds, scrut, true, resolved_enum, resolved_variant, scrut_mono)
        if ss_sub != "" {
            return "{base} && {ss_sub}"
        }
        return base
    }
    let flds_sl = node_fields(pat)
    if flds_sl == -1 {
        return base
    }
    let vidx = get_variant_index(resolved_enum, resolved_variant)
    if vidx < 0 {
        return base
    }
    let fcount = get_variant_field_count(vidx)
    let mut parts = base
    let mut fi = 0
    while fi < sublist_length(flds_sl) && fi < fcount {
        let sub_pat = sublist_get(flds_sl, fi)
        let field_name = get_variant_field_name(vidx, fi).unwrap()
        let field_type_raw = get_variant_field_type_str(vidx, fi).unwrap()
        let field_base = strip_generic_args(field_type_raw)
        let field_ct = type_from_name(field_type_raw)
        let field_expr = variant_field_scrut_expr(scrut, resolved_variant, field_name, field_base, resolved_enum, scrut_mono)
        let tup_tag = if node_kind(sub_pat) == NodeKind.TuplePattern { tuple_field_carrier_tag_mono(resolved_enum, resolved_variant, field_name, scrut_mono, "") } else { "" }
        // A self-recursive field carries its mono stem so a deeper nested
        // condition can deref its own box; other fields keep their tuple tag.
        let cond_sname = selfrec_field_mono(field_base, resolved_enum, scrut_mono)
        let saved_scruts = match_scruts
        let saved_enum = match_scrut_enum
        match_scruts = [MatchScrutEntry { str_val: field_expr, scrut_type: field_ct, scrut_sname: if cond_sname != "" { cond_sname } else { tup_tag } }]
        match_scrut_enum = if is_enum_type(field_base) != 0 { field_base } else { "" }
        let sub_cond = pattern_condition(sub_pat, 0, 1)
        match_scrut_enum = saved_enum
        match_scruts = saved_scruts
        if sub_cond != "" {
            parts = "({parts} && {sub_cond})"
        }
        fi = fi + 1
    }
    parts
}

// Build a C condition string for a pattern.
// scrut_off/scrut_len index into match_scruts.
// Returns "" when the pattern always matches (wildcard/ident).
// The nested-carrier branch saves and restores the carrier-shape globals around
// its recursion; the analyzer can't see the restore across the
// set_carrier_globals_from_inner call, hence the allow.
// The opaque inner name when the match scrutinee at `scrut_off` is a
// null-pointer-optimized Option[@ffi.opaque] (its whole carrier is a bare handle
// pointer, NULL = None), else "". Reads the carrier-tag channel (tuple-element
// scrutinees) then the materialized copy's var metadata (single scrutinees).
fn scrut_opaque_inner(scrut_off: Int) -> Str {
    let e = match_scruts.get(scrut_off).unwrap()
    if e.scrut_type != CT_OPTION { return "" }
    if e.scrut_sname != "" && e.scrut_sname.starts_with("Option_") && opaque_option_carrier_cname(e.scrut_sname) != "" {
        return e.scrut_sname.slice(7, e.scrut_sname.len())
    }
    let vs = get_var_option_inner_nominal(e.str_val)
    if vs != "" && is_opaque_type(vs) != 0 { return vs }
    ""
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn pattern_condition(pat: Int, scrut_off: Int, scrut_len: Int) -> Str {
    let pk = node_kind(pat)
    if pk == NodeKind.WildcardPattern {
        return ""
    }
    if pk == NodeKind.IdentPattern {
        let pat_name = node_name(pat)
        // Bare `None` is the Option carrier (tag 0) only for a real Option scrutinee;
        // a user enum reusing `None` resolves to its own variant tag below.
        if pat_name == "None" && match_scruts.get(scrut_off).unwrap().scrut_type == CT_OPTION {
            if scrut_opaque_inner(scrut_off) != "" {
                return "({match_scruts.get(scrut_off).unwrap().str_val} == NULL)"
            }
            return "({match_scruts.get(scrut_off).unwrap().str_val}.tag == 0)"
        }
        let enum_name = resolve_arm_enum(pat_name)
        if enum_name != "" {
            if is_data_enum(enum_name) != 0 {
                let tag = get_variant_tag(enum_name, pat_name)
                return "({match_scruts.get(scrut_off).unwrap().str_val}.tag == {tag})"
            }
            return "({match_scruts.get(scrut_off).unwrap().str_val} == {c_type_c_name(enum_name)}_{pat_name})"
        }
        return ""
    }
    if pk == NodeKind.IntPattern {
        let pat_val = node_str_val(pat)
        return "({match_scruts.get(scrut_off).unwrap().str_val} == {pat_val})"
    }
    if pk == NodeKind.StringPattern {
        let pat_val = node_str_val(pat)
        return "(blink_str_eq({match_scruts.get(scrut_off).unwrap().str_val}, \"{pat_val}\"))"
    }
    if pk == NodeKind.RangePattern {
        let lo = node_str_val(pat)
        let hi = node_name(pat)
        let scrut = match_scruts.get(scrut_off).unwrap().str_val
        if node_inclusive(pat) != 0 {
            return "({scrut} >= {lo} && {scrut} <= {hi})"
        }
        return "({scrut} >= {lo} && {scrut} < {hi})"
    }
    if pk == NodeKind.EnumPattern {
        let enum_name = node_name(pat)
        let variant_name = node_type_name(pat)
        // Ok/Err/Some are the builtin Result/Option carrier variants ONLY when the
        // scrutinee is actually a Result/Option. A user enum that reuses one of
        // these names (scrut_type is the enum's own CT, not CT_RESULT/CT_OPTION)
        // must fall through to the normal user-variant path below.
        let ep_scrut_type = match_scruts.get(scrut_off).unwrap().scrut_type
        let is_result_carrier = (enum_name == "Ok" || enum_name == "Err") && ep_scrut_type == CT_RESULT
        let is_option_carrier = enum_name == "Some" && ep_scrut_type == CT_OPTION
        if is_option_carrier && scrut_opaque_inner(scrut_off) != "" {
            // NPO: Some matches a non-null handle. The opaque handle is inert, so
            // there is no nested sub-pattern to recurse into.
            return "({match_scruts.get(scrut_off).unwrap().str_val} != NULL)"
        }
        if is_result_carrier || is_option_carrier {
            let tag = if enum_name == "Err" { 1 } else if enum_name == "Some" { 1 } else { 0 }
            let scrut = match_scruts.get(scrut_off).unwrap().str_val
            let mut base = "({scrut}.tag == {tag})"
            let ep_flds_sl2 = node_fields(pat)
            if ep_flds_sl2 != -1 && sublist_length(ep_flds_sl2) >= 1 {
                let sub_pat2 = sublist_get(ep_flds_sl2, 0)
                let sub_pk2 = node_kind(sub_pat2)
                if sub_pk2 == NodeKind.EnumPattern || sub_pk2 == NodeKind.IntPattern || sub_pk2 == NodeKind.StringPattern {
                    let scrut_type = match_scruts.get(scrut_off).unwrap().scrut_type
                    let uc = unwrap_carrier(enum_name, scrut, scrut_type)
                    let inner_is_enum = uc.inner_struct != "" && is_enum_type(uc.inner_struct) != 0
                    let saved_scruts = match_scruts
                    // Re-derive the carrier-shape globals for the inner carrier
                    // before recursing — otherwise the deeper
                    // unwrap_carrier reads the OUTER carrier's shape.
                    let saved_ok_type = expr_result_ok_type
                    let saved_err_type = expr_result_err_type
                    let saved_ok_struct = expr_result_ok_struct
                    let saved_err_struct = expr_result_err_struct
                    let saved_opt_inner = expr_option_inner
                    let saved_opt_struct = expr_option_inner_struct
                    match_scruts = [MatchScrutEntry { str_val: uc.payload_expr, scrut_type: uc.inner_ct }]
                    let saved_enum = match_scrut_enum
                    if inner_is_enum {
                        match_scrut_enum = uc.inner_struct
                    } else {
                        match_scrut_enum = ""
                    }
                    if (uc.inner_ct == CT_RESULT || uc.inner_ct == CT_OPTION) && uc.inner_struct != "" {
                        set_carrier_globals_from_inner(uc.inner_ct, uc.inner_struct)
                    }
                    let sub_cond = pattern_condition(sub_pat2, 0, 1)
                    match_scruts = saved_scruts
                    match_scrut_enum = saved_enum
                    expr_result_ok_type = saved_ok_type
                    expr_result_err_type = saved_err_type
                    expr_result_ok_struct = saved_ok_struct
                    expr_result_err_struct = saved_err_struct
                    expr_option_inner = saved_opt_inner
                    expr_option_inner_struct = saved_opt_struct
                    if sub_cond != "" {
                        base = "({base} && {sub_cond})"
                    }
                }
            }
            return base
        }
        if variant_name != "" {
            // Transparent newtype: single variant, no tag — the scrutinee
            // IS the bare int64_t payload, so there is no `.tag` to test. The pattern
            // matches on its inner sub-pattern: `Errno(rc)`/`Errno(_)` always match
            // (empty condition), but `Errno(11)` must still gate on `scrut == 11`.
            if is_transparent_newtype(enum_name) != 0 {
                return transparent_payload_condition(pat, scrut_off)
            }
            if is_data_enum(enum_name) != 0 {
                let tag = get_variant_tag(enum_name, variant_name)
                return positional_payload_condition(pat, enum_name, variant_name, match_scruts.get(scrut_off).unwrap().str_val, tag, match_scruts.get(scrut_off).unwrap().scrut_sname)
            }
            return "({match_scruts.get(scrut_off).unwrap().str_val} == {c_type_c_name(enum_name)}_{variant_name})"
        }
        let pat_name = node_name(pat)
        let resolved = resolve_arm_enum(pat_name)
        if resolved != "" && is_transparent_newtype(resolved) != 0 {
            return transparent_payload_condition(pat, scrut_off)
        }
        if resolved != "" && is_data_enum(resolved) != 0 {
            let tag = get_variant_tag(resolved, pat_name)
            return positional_payload_condition(pat, resolved, pat_name, match_scruts.get(scrut_off).unwrap().str_val, tag, match_scruts.get(scrut_off).unwrap().scrut_sname)
        }
        return ""
    }
    if pk == NodeKind.StructPattern {
        let flds_sl = node_fields(pat)
        if flds_sl == -1 {
            return ""
        }
        let scrut = match_scruts.get(scrut_off).unwrap().str_val
        // A bare `Variant { .. }` pattern is parsed as StructPattern; when the
        // name resolves to a data-enum variant, gate on the tag and read any
        // sub-field conditions through the variant member.
        let sp_variant = node_type_name(pat)
        let sp_enum = resolve_arm_enum(sp_variant)
        let sp_is_enum = sp_enum != "" && is_data_enum(sp_enum) != 0
        let mut parts = ""
        let mut _parts_n = 0
        if sp_is_enum {
            let tag = get_variant_tag(sp_enum, sp_variant)
            parts = "({scrut}.tag == {tag})"
            _parts_n = 1
        }
        let sp_scrut_mono = match_scruts.get(scrut_off).unwrap().scrut_sname
        let sp_sub = struct_style_subfield_conditions(flds_sl, scrut, sp_is_enum, sp_enum, sp_variant, sp_scrut_mono)
        if sp_sub != "" {
            if _parts_n > 0 {
                parts = parts.concat(" && ")
            }
            parts = parts.concat(sp_sub)
        }
        return parts
    }
    if pk == NodeKind.OrPattern {
        let alts_sl = node_elements(pat)
        if alts_sl == -1 {
            return ""
        }
        let mut parts = ""
        let mut _parts_n = 0
        let mut j = 0
        while j < sublist_length(alts_sl) {
            let sub_pat = sublist_get(alts_sl, j)
            let sub_cond = pattern_condition(sub_pat, scrut_off, scrut_len)
            if sub_cond != "" {
                if _parts_n > 0 {
                    parts = parts.concat(" || ")
                }
                parts = parts.concat(sub_cond)
                _parts_n = _parts_n + 1
            }
            j = j + 1
        }
        return parts
    }
    if pk == NodeKind.AsPattern {
        let inner = node_pattern(pat)
        return pattern_condition(inner, scrut_off, scrut_len)
    }
    if pk == NodeKind.TuplePattern {
        let elems_sl = node_elements(pat)
        if elems_sl == -1 {
            return ""
        }
        let n_elems = sublist_length(elems_sl)
        // One whole-tuple entry carrying a carrier tag (a tuple payload field, or
        // a nested tuple element): expand into per-element entries and gate each,
        // the same way bind_pattern_vars' TuplePattern arm does. Without this a
        // nested tuple would index scrut_off + j past the single entry.
        if scrut_len == 1 && n_elems > 1 {
            let whole = match_scruts.get(scrut_off).unwrap()
            if whole.scrut_sname != "" && tuple_struct_arity(whole.scrut_sname) >= 0 {
                let saved = match_scruts
                match_scruts = []
                push_tuple_elem_scruts(whole.scrut_sname, whole.str_val)
                let mut eparts = ""
                let mut _eparts_n = 0
                let mut ej = 0
                while ej < n_elems {
                    let ec = pattern_condition(sublist_get(elems_sl, ej), ej, 1)
                    if ec != "" {
                        if _eparts_n > 0 {
                            eparts = eparts.concat(" && ")
                        }
                        eparts = eparts.concat(ec)
                        _eparts_n = _eparts_n + 1
                    }
                    ej = ej + 1
                }
                match_scruts = saved
                return eparts
            }
        }
        let mut parts = ""
        let mut _parts_n = 0
        let mut j = 0
        while j < n_elems {
            let sub_pat = sublist_get(elems_sl, j)
            let sub_cond = pattern_condition(sub_pat, scrut_off + j, 1)
            if sub_cond != "" {
                if _parts_n > 0 {
                    parts = parts.concat(" && ")
                }
                parts = parts.concat(sub_cond)
                _parts_n = _parts_n + 1
            }
            j = j + 1
        }
        return parts
    }
    if pk == NodeKind.ListPattern {
        let elems_sl = node_elements(pat)
        let has_rest = node_inclusive(pat)
        let scrut = match_scruts.get(scrut_off).unwrap().str_val
        let mut elem_count = 0
        if elems_sl != -1 {
            elem_count = sublist_length(elems_sl)
        }
        let mut parts = ""
        let mut _parts_n = 0
        if has_rest != 0 {
            parts = "(blink_list_len({scrut}) >= {elem_count})"
        } else {
            parts = "(blink_list_len({scrut}) == {elem_count})"
        }
        _parts_n = 1
        if elems_sl != -1 {
            let mut j = 0
            while j < sublist_length(elems_sl) {
                let sub_pat = sublist_get(elems_sl, j)
                let saved_scruts = match_scruts
                let elem_type = get_list_elem_type(scrut)
                let elem_struct = get_list_elem_struct(scrut)
                let mut cast = "(int64_t)(intptr_t)"
                let mut sub_scrut_type = CT_STRING
                if elem_type == CT_STRING {
                    cast = "(const char*)"
                    sub_scrut_type = CT_STRING
                } else if elem_struct != "" {
                    cast = "({c_type_c_name(elem_struct)})(intptr_t)"
                    sub_scrut_type = CT_INT
                } else if elem_type >= 0 {
                    sub_scrut_type = elem_type
                }
                // A boxed carrier element (List[Option[T]]/List[Result[T,E]]) has to be
                // read as a struct VALUE off the list's element tid, or the Some/Ok/Err
                // sub-match spells `.tag`/payload on a scalar. The carrier globals feed
                // unwrap_carrier's inner-type resolution for a nested inner sub-pattern
                // (`Some(7)`); save/restore around the recursion.
                let mut carrier_read = ""
                let cc_saved_oi = expr_option_inner
                let cc_saved_ois = expr_option_inner_struct
                let cc_saved_rok = expr_result_ok_type
                let cc_saved_rerr = expr_result_err_type
                let cc_saved_roks = expr_result_ok_struct
                let cc_saved_rerrs = expr_result_err_struct
                if elem_type == CT_OPTION || elem_type == CT_RESULT {
                    let cc_elem_tid = get_list_elem_tid(scrut)
                    let cread = list_elem_unbox_from_tid(cc_elem_tid, "blink_list_get({scrut}, {j})")
                    if cread != "" {
                        // Parenthesize: the carrier arm appends `.tag`/`.value`, which binds
                        // tighter than the `*` deref in `*(T*)…`.
                        carrier_read = "({cread})"
                        sub_scrut_type = elem_type
                        set_carrier_globals_from_inner(elem_type, tc_tid_to_c_tag(cg_bind_mono_tid(cc_elem_tid)))
                    }
                }
                let cc_str = if carrier_read != "" { carrier_read } else { "{cast}blink_list_get({scrut}, {j})" }
                match_scruts = [MatchScrutEntry { str_val: cc_str, scrut_type: sub_scrut_type }]
                let saved_enum = match_scrut_enum
                match_scrut_enum = if elem_struct != "" && is_enum_type(elem_struct) != 0 { elem_struct } else { "" }
                let sub_cond = pattern_condition(sub_pat, 0, 1)
                match_scrut_enum = saved_enum
                match_scruts = saved_scruts
                expr_option_inner = cc_saved_oi
                expr_option_inner_struct = cc_saved_ois
                expr_result_ok_type = cc_saved_rok
                expr_result_err_type = cc_saved_rerr
                expr_result_ok_struct = cc_saved_roks
                expr_result_err_struct = cc_saved_rerrs
                if sub_cond != "" {
                    if _parts_n > 0 {
                        parts = parts.concat(" && ")
                    }
                    parts = parts.concat(sub_cond)
                    _parts_n = _parts_n + 1
                }
                j = j + 1
            }
        }
        return parts
    }
    ""
}

// Bind the named fields of a struct-style enum variant pattern
// (`Variant { field, field2: pat, .. }`) through the variant member
// (`{scrut}.data.{variant}.{field}`). Shared by the qualified
// `Type.Variant { .. }` EnumPattern path and the bare `Variant { .. }`
// StructPattern path so both lower identically.
@allow(UnrestoredMutation, IncompleteStateRestore)
fn bind_struct_style_variant_fields(vidx: Int, fcount: Int, resolved_enum: Str, resolved_variant: Str, scrut: Str, flds_sl: Int, scrut_mono: Str) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let mut sfi = 0
    while sfi < sublist_length(flds_sl) {
        let sf_node = sublist_get(flds_sl, sfi)
        let field_name = node_name(sf_node)
        let fpat_node = node_pattern(sf_node)
        let mut found_ft = ""
        let mut vfi = 0
        while vfi < fcount {
            let vfn = get_variant_field_name(vidx, vfi)
            if vfn.is_some() && vfn.unwrap() == field_name {
                let vft = get_variant_field_type_str(vidx, vfi)
                if vft.is_some() {
                    found_ft = vft.unwrap()
                }
                break
            }
            vfi = vfi + 1
        }
        // A generic-enum instance carries its mono stem on scrut_mono; a field whose
        // declared type is a typevar (`val: T`) resolves against it so the binder gets
        // the concrete C type instead of the erased `void`. Mirrors the positional path.
        let res_ft = resolve_variant_field_type_mono(found_ft, resolved_enum, scrut_mono)
        let field_ct = type_from_name(res_ft)
        if fpat_node != -1 && strip_generic_args(res_ft) == resolved_enum && (node_kind(fpat_node) == NodeKind.IdentPattern || node_kind(fpat_node) == NodeKind.WildcardPattern) {
            // A self-recursive field (`tail: LL[T]`) renamed to an ident is stored boxed as
            // int64_t; the recursion path can only plain-assign, so deref here through the
            // mono type. Mirrors the positional path: set_var_struct publishes the mono stem
            // so a downstream fn call or nested match on the binder recovers the instance.
            if node_kind(fpat_node) == NodeKind.IdentPattern && node_name(fpat_node) != "_" {
                let bn = node_name(fpat_node)
                let c_bind = c_safe_name(bn)
                let fc_type = if scrut_mono != "" && is_mono_struct_instance(scrut_mono) != 0 { scrut_mono } else { resolved_enum }
                let fc_name = c_type_c_name(fc_type)
                emit_line("{fc_name} {c_bind} = *({fc_name}*)(intptr_t){scrut}.data.{resolved_variant}.{field_name};")
                set_var(bn, CT_VOID, 0)
                set_var_struct(bn, fc_type)
                var_enums.push(VarEnumEntry { name: bn, enum_type: resolved_enum })
            }
        } else if fpat_node != -1 {
            let saved_scruts = match_scruts
            // A tuple payload has no struct/enum name; publish its carrier tag so the
            // TuplePattern arm can expand the single whole-tuple entry per element. A
            // struct/enum field publishes its resolved name so the recursed IdentPattern
            // binder spells the concrete type when its own typevar tid cannot.
            let fld_base = strip_generic_args(res_ft)
            let fld_is_selfrec = fld_base == resolved_enum
            // A self-recursive field is boxed; the nested sub-pattern must read
            // through the mono deref, and its stem is the scrutinee's own mono.
            let sr_mono = selfrec_field_mono(fld_base, resolved_enum, scrut_mono)
            // A self-recursive tuple field (`Pair { p: (l, r) }`) is boxed; deref
            // through its arg-full carrier so the TuplePattern arm expands the real
            // tuple, mirroring the positional path.
            let ss_sr_tuple_tag = if node_kind(fpat_node) == NodeKind.TuplePattern && tc_variant_field_is_selfrec_tuple(resolved_enum, resolved_variant, field_name) != 0 { selfrec_tuple_field_carrier(resolved_enum, resolved_variant, field_name, scrut_mono) } else { "" }
            if node_kind(fpat_node) == NodeKind.TuplePattern && tc_variant_field_is_selfrec_tuple(resolved_enum, resolved_variant, field_name) != 0 && ss_sr_tuple_tag == "" {
                diag_ice_at("SelfrecTupleCarrierUnresolved", UNSOLVED_TYPEVAR_AT_CODEGEN,
                    "self-recursive tuple field '{field_name}' of '{resolved_enum}.{resolved_variant}' reached codegen without a resolvable tuple carrier",
                    fpat_node,
                    "this is a compiler bug — the boxed tuple carrier should resolve from the field annotation")
            } else if ss_sr_tuple_tag != "" {
                let ss_c = c_type_c_name(ss_sr_tuple_tag)
                match_scruts = [MatchScrutEntry { str_val: "(*({ss_c}*)(intptr_t){scrut}.data.{resolved_variant}.{field_name})", scrut_type: field_ct, scrut_sname: ss_sr_tuple_tag }]
                let saved_enum = match_scrut_enum
                match_scrut_enum = ""
                bind_pattern_vars(fpat_node, 0, 1)
                match_scrut_enum = saved_enum
            } else {
                let ss_entry_sname =
                    if node_kind(fpat_node) == NodeKind.TuplePattern { tuple_field_carrier_tag_mono(resolved_enum, resolved_variant, field_name, scrut_mono, "") }
                    else if fld_is_selfrec { sr_mono }
                    else if res_ft != "" && (is_struct_type(res_ft) != 0 || is_enum_type(res_ft) != 0) { res_ft }
                    else { "" }
                match_scruts = [MatchScrutEntry { str_val: variant_field_scrut_expr(scrut, resolved_variant, field_name, fld_base, resolved_enum, scrut_mono), scrut_type: field_ct, scrut_sname: ss_entry_sname }]
                let saved_enum = match_scrut_enum
                match_scrut_enum = if fld_is_selfrec { resolved_enum } else if res_ft != "" && is_enum_type(res_ft) != 0 { res_ft } else { "" }
                bind_pattern_vars(fpat_node, 0, 1)
                match_scrut_enum = saved_enum
            }
            match_scruts = saved_scruts
        } else {
            let c_bind = c_safe_name(field_name)
            if strip_generic_args(res_ft) == resolved_enum {
                // A self-recursive field (`tail: LL[T]`) is stored boxed as int64_t, so the
                // binder derefs through the mono C type. Mirrors the positional path:
                // set_var_struct publishes the mono stem for downstream recovery.
                let fc_type = if scrut_mono != "" && is_mono_struct_instance(scrut_mono) != 0 { scrut_mono } else { resolved_enum }
                let fc_name = c_type_c_name(fc_type)
                emit_line("{fc_name} {c_bind} = *({fc_name}*)(intptr_t){scrut}.data.{resolved_variant}.{field_name};")
                set_var(field_name, CT_VOID, 0)
                set_var_struct(field_name, fc_type)
                var_enums.push(VarEnumEntry { name: field_name, enum_type: resolved_enum })
            } else if is_struct_type(res_ft) != 0 {
                emit_line("{c_type_c_name(res_ft)} {c_bind} = {scrut}.data.{resolved_variant}.{field_name};")
                set_var(field_name, CT_VOID, 0)
                set_var_struct(field_name, res_ft)
            } else if is_enum_type(res_ft) != 0 {
                emit_line("{c_type_c_name(res_ft)} {c_bind} = {scrut}.data.{resolved_variant}.{field_name};")
                set_var(field_name, CT_INT, 0)
                var_enums.push(VarEnumEntry { name: field_name, enum_type: res_ft })
            } else if field_ct == CT_LIST {
                emit_line("blink_list* {c_bind} = {scrut}.data.{resolved_variant}.{field_name};")
                set_var(field_name, CT_LIST, 0)
                let bracket_pos = res_ft.index_of("[")
                if bracket_pos > 0 {
                    let inner_name = res_ft.substr(bracket_pos + 1, res_ft.len() - bracket_pos - 2)
                    let inner_ct = type_from_name(inner_name)
                    if inner_ct != CT_VOID {
                        set_list_elem_type(field_name, inner_ct)
                    } else if is_enum_type(inner_name) != 0 || is_struct_type(inner_name) != 0 {
                        set_list_elem_struct(field_name, inner_name)
                        set_list_elem_type(field_name, CT_VOID)
                    }
                }
            } else if field_ct == CT_OPTION || field_ct == CT_RESULT {
                emit_line("__typeof__({scrut}.data.{resolved_variant}.{field_name}) {c_bind} = {scrut}.data.{resolved_variant}.{field_name};")
                set_var(field_name, field_ct, 0)
                register_var_compound_inner_from_str(field_name, res_ft)
                // Stamp the Option/Result binder tid so its inner (`p.x` after `Some(v)`)
                // reads through the tid rather than the flat sname fallback. Same field-pattern
                // tid the else-branch uses; a decline or a mismatched carrier keeps the flat path.
                let opt_binder_tid = subst_variant_field_binder_tid(pat_binder_tid(sf_node), resolved_enum, scrut_mono)
                if tc_tid_ct(opt_binder_tid) == field_ct { set_var_ty(field_name, opt_binder_tid) }
            } else if tc_variant_field_is_selfrec_tuple(resolved_enum, resolved_variant, field_name) != 0 {
                // Self-recursive tuple field (`Pair { p }` shorthand): stored boxed as
                // an int64_t pointer (see the ctor), so deref through the mono tuple
                // carrier and publish its tag so `p.0` reads. Mirrors the positional path.
                let tup_tag = selfrec_tuple_field_carrier(resolved_enum, resolved_variant, field_name, scrut_mono)
                if tup_tag == "" {
                    diag_ice_at("SelfrecTupleCarrierUnresolved", UNSOLVED_TYPEVAR_AT_CODEGEN,
                        "self-recursive tuple field '{field_name}' of '{resolved_enum}.{resolved_variant}' reached codegen without a resolvable tuple carrier",
                        sf_node,
                        "this is a compiler bug — the boxed tuple carrier should resolve from the field annotation")
                } else {
                    let tup_c = c_type_c_name(tup_tag)
                    emit_line("{tup_c} {c_bind} = *({tup_c}*)(intptr_t){scrut}.data.{resolved_variant}.{field_name};")
                    set_var(field_name, field_ct, 0)
                    set_var_struct(field_name, tup_tag)
                }
            } else {
                let sf_flat_c = c_type_str(field_ct)
                // The struct-style sibling of match_binder.variant_field: the binder reaches here
                // from a declared field type, so its tid is read off the field-pattern node itself
                // (published by the EnumPattern/StructPattern typecheck arms). The tid leads; a
                // genuine void or a decline keeps the flat placeholder, since this is a storage decl.
                let sf_binder_tid = subst_variant_field_binder_tid(pat_binder_tid(sf_node), resolved_enum, scrut_mono)
                ctype_probe_at(sf_binder_tid, "variant_field_struct_style", field_name, sf_flat_c, sf_node)
                let sf_spelled = c_type_from_tid(sf_binder_tid)
                let sf_c = if sf_spelled != "" && sf_spelled != "void" { sf_spelled } else { sf_flat_c }
                emit_line("{sf_c} {c_bind} = {scrut}.data.{resolved_variant}.{field_name};")
                set_var(field_name, field_ct, 0)
                let sf_res_tid = tc_tid_resolved(sf_binder_tid)
                if tc_tid_kind(sf_res_tid) == TyKind.Tuple {
                    let tup_tag = tc_tid_tuple_sname(sf_res_tid)
                    if tup_tag != "" { set_var_struct(field_name, tup_tag) }
                }
            }
        }
        sfi = sfi + 1
    }
}

// Resolve a generic-enum variant field's declared type NAME (`T`, `Tree`) to its
// concrete type under the scrutinee's mono args. `scrut_mono` is the
// scrutinee's mono instance stem (`Tree_Int`); recovers the concrete args via
// lookup_mono_base and substitutes the field typevar through the enum's tparam list.
// Returns the resolved type name (e.g. `T` → `Int`) or the input unchanged when
// scrut_mono is not a mono instance / the field type is not a tparam.
fn resolve_variant_field_type_mono(field_type_name: Str, bare_enum: Str, scrut_mono: Str) -> Str {
    if scrut_mono == "" { return field_type_name }
    let ml = lookup_mono_base(scrut_mono)
    if ml.base == "" { return field_type_name }
    let td = find_type_def(bare_enum)
    if td == -1 { return field_type_name }
    let tparams_sl = node_type_params(td)
    if tparams_sl == -1 { return field_type_name }
    resolve_tparam_via_tid(field_type_name, tparams_sl, ml.arg_tids)
}

// The binder-tid twin of resolve_variant_field_type_mono. A variant-field binder over a
// generic-enum instance carries the enum-def's own typevar tid, which the enclosing fn's mono
// context cannot resolve; substitute it against the scrutinee instance's arg binds so
// c_type_from_tid spells the concrete instance type instead of declining to the flat field.
fn subst_variant_field_binder_tid(tid: Int, bare_enum: Str, scrut_mono: Str) -> Int {
    if scrut_mono == "" { return tid }
    let ml = lookup_mono_base(scrut_mono)
    if ml.base == "" { return tid }
    let td = find_type_def(bare_enum)
    if td == -1 { return tid }
    let tparams_sl = node_type_params(td)
    if tparams_sl == -1 { return tid }
    tc_tid_subst_mono(tid, tparams_sl, ml.arg_tids)
}

// The divergence tap for a match-arm pattern binder.
//
// `bind_pattern_vars` stamps through ~28 `set_var` calls spread over its arms, but a binder's NAME
// is decided in only four places: the generic `NodeKind.IdentPattern` arm that every recursed
// sub-pattern re-enters the function to reach, and the three carrier fast paths that handle an
// IdentPattern inline without recursing. Tapping those four covers the family. A tap per arm would
// cover it today and rot tomorrow, because an arm added later would be silently unmeasured — the
// same reason `params_measure` sits after the whole param loop instead of inside its branches.
//
// The tid is typecheck's, not a second derivation: `tc_check_pattern_types` already decomposes the
// binding hint one level per arm (Option/Result unwrap, tuple element, list element, variant field)
// and now publishes each leaf's answer on the leaf node. Substituted through the instance's binds
// for the same reason the for-in and param taps are — inside a monomorphized body a binder over a
// `List[T]` element publishes `T`, and comparing a typevar against a concrete flat spelling reports
// a divergence that is only the tap failing to look up what T is bound to.
//
// A struct-style shorthand field (`match p { Pt { x, y } => ... }`) is NOT measured here: it has no
// IdentPattern node, so it never reaches this tap. It is bound and measured by
// `bind_struct_style_variant_fields` instead, under its own `variant_field_struct_style` tap.
// Typecheck's StructPattern and EnumPattern struct-style arms publish each field's declared type on
// the field node, so that tap has a real tid to read.
// `site` is a parameter and not a constant because the two callers are different declaration
// families that happen to share a mechanism: a match arm and a tuple destructure. Collapsing them
// under one key would lose the attribution the cell map is read through.
fn pat_measure_at(bind_name: Str, pat: Int, site: Str) {
    if bind_name == "" { return }
    if bind_name == "_" { return }
    let tid = tc_tid_subst_mono(tc_tid_resolved(tc_lookup_node_tid(pat)), cg_mono_tparams_sl, cg_mono_arg_tids)
    if tid >= 0 && tc_tid_kind(tid) != TyKind.Unknown {
        set_var_ty(bind_name, tid)
        // A CONTAINER binder's element channels are filled by the arm above from the
        // transient expr_option_* / expr_result_* globals, or by reading the SCRUTINEE's own flat
        // channels under its C name. A call-returned scrutinee is a temp with no ScopeVar, so both
        // answer nothing and sv_tp fabricates — `Map[Str, Int]` for a pair it never saw, `List[Int]`
        // for a `List[Str]`, and for a Set the loud SetElementTypeUnknownAtCodegen. The binder's own
        // tid is right here, at the one place every binder passes through. Fill-only: an arm that
        // already had an answer keeps it.
        let _filled = stamp_binder_elems_from_tid_if_unset(tid, bind_name)
    }
    let _measured = sv_ty_or_flat_at(bind_name, site, pat)
}

fn pat_measure(bind_name: Str, pat: Int) {
    pat_measure_at(bind_name, pat, "match_pattern.bind")
}

// The tid a binder's C DECLARATION is spelled from — the same expression `pat_measure_at` measures
// the binder's metadata through, so the two cannot drift onto different tids for one binder.
//
// The metadata channel and the spelling channel are separate axes and both are needed: the metadata
// says what `mm.get(k)` decodes to, the spelling says what C type holds `mm`. A binder can be right
// on one and wrong on the other.
fn pat_binder_tid(pat: Int) -> Int {
    cg_node_mono_tid(pat)
}

// The tid any node's C spelling and metadata are read through: resolved past metavars, then
// substituted for the enclosing mono instance. Kept as one definition so a second reader cannot
// arrive at a differently-resolved tid for the same node.
pub fn cg_node_mono_tid(n: Int) -> Int {
    tc_tid_subst_mono(tc_tid_resolved(tc_lookup_node_tid(n)), cg_mono_tparams_sl, cg_mono_arg_tids)
}

// The mono-bound return tid of a function signature. An un-annotated signature returns
// Void, so its tid is TYPE_VOID rather than the -1 an absent annotation node yields — that
// lets c_type_from_tid spell "void" at the scalar signature sites instead of declining.
pub fn cg_fn_ret_tid(fn_node: Int) -> Int {
    let ann = node_type_ann(fn_node)
    if ann < 0 { return tc_void_tid() }
    cg_node_mono_tid(ann)
}

// Read element `i` out of a `blink_list*` as its declared C type.
//
// A list stores every element as `void*`, and how one is read back depends on the element's
// PHYSICAL shape: a pointer type IS the slot, an int-like scalar is stuffed inline through
// intptr_t, and everything else — a double, a struct, an Option/Result/Tuple carrier — is
// boxed and read through a deref. That is the same rule emit_option_typedef applies to decide
// `T value` vs `T* value`, so the two agree on what is boxed.
//
// A two-cell (elem_type, elem_struct) pair cannot express the distinction: it spelled every
// non-scalar as `(T)(intptr_t)`, which is a cc error for an aggregate and a pointer-from-integer
// warning for a pointer. Declines with "" on a tid c_type_from_tid cannot spell, so a caller
// keeps whatever it does today rather than trading one wrong cast for another.
//
// codegen_methods' `.get` emitter answers the same question with a per-shape ladder of its own.
fn list_elem_unbox_from_tid(elem_tid: Int, expr: Str) -> Str {
    let c = c_type_from_tid(elem_tid)
    if c == "" || c == "void" { return "" }
    if c.ends_with("*") { return "({c}){expr}" }
    match tc_tid_kind(tc_tid_resolved(elem_tid)) {
        TyKind.Int => "(int64_t)(intptr_t){expr}"
        TyKind.Bool => "(int64_t)(intptr_t){expr}"
        TyKind.Char => "(int64_t)(intptr_t){expr}"
        TyKind.I8 => "(int64_t)(intptr_t){expr}"
        TyKind.I16 => "(int64_t)(intptr_t){expr}"
        TyKind.I32 => "(int64_t)(intptr_t){expr}"
        TyKind.U8 => "(int64_t)(intptr_t){expr}"
        TyKind.U16 => "(int64_t)(intptr_t){expr}"
        TyKind.U32 => "(int64_t)(intptr_t){expr}"
        TyKind.U64 => "(int64_t)(intptr_t){expr}"
        // A transparent newtype (`type Errno(Int)`) spells int64_t but reports TyKind.Enum, so
        // the spelling — not the kind — has to decide it. Every other enum is either a plain
        // int64_t or a boxed aggregate, and both are answered correctly by the same test.
        _ => if c == "int64_t" { "(int64_t)(intptr_t){expr}" } else { "*({c}*){expr}" }
    }
}

// Bind a WHOLE-value binder over a pre-expanded tuple scrutinee: a bare whole-ident binder, or an
// `as` pattern's name, which name the undecomposed tuple. The top-level tuple-scrutinee fast path
// pre-expands the tuple into one match_scruts entry per element (scrut_len == n_elems), so no single
// whole-tuple entry survives -- reconstruct it from the per-element scruts as a compound literal.
// The carrier name comes from the binder tid via ensure_tuple_carrier_from_tid, which also REGISTERS
// the typedef (a literal scrutinee never materializes the tuple value, so its typedef is otherwise
// never emitted) and returns "" for an ICE_SEG / unspellable element, ceding rather than naming an
// undeclared C type. stamp_whole_binder_from_tid's tuple arm stamps the tid channel that
// sv_struct_tid_first reads to spell field access, so no flat sname write is needed. Returns whether
// it bound the value.
fn bind_whole_tuple_from_scruts(pat: Int, bind_name: Str, scrut_off: Int, scrut_len: Int) -> Bool ! Codegen.Emit, Codegen.Scope {
    let whole_tid = pat_binder_tid(pat)
    let whole_tag = ensure_tuple_carrier_from_tid(whole_tid)
    if whole_tag == "" { return false }
    let c_bind = c_safe_name(bind_name)
    let mut inits = ""
    let mut j = 0
    while j < scrut_len {
        if j > 0 { inits = inits.concat(", ") }
        let elem = match_scruts.get(scrut_off + j).unwrap()
        inits = inits.concat("._{j} = {elem.str_val}")
        j = j + 1
    }
    emit_line("{c_type_c_name(whole_tag)} {c_bind} = \{ {inits} };")
    // whole_tag != "" means ensure_tuple_carrier_from_tid registered the carrier, so the tuple arm
    // of stamp_whole_binder_from_tid (same tid, same find_tuple_entry gate) always fires here.
    let _ = stamp_whole_binder_from_tid(whole_tid, bind_name, 1)
    pat_measure(bind_name, pat)
    true
}

// Emit C variable bindings for ident sub-patterns within a pattern.
// scrut_off/scrut_len index into match_scruts.
@allow(UnrestoredMutation, IncompleteStateRestore)
fn bind_pattern_vars(pat: Int, scrut_off: Int, scrut_len: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let pk = node_kind(pat)
    if pk == NodeKind.EnumPattern {
        let enum_name = node_name(pat)
        let variant_name = node_type_name(pat)
        let ep_flds_sl = node_fields(pat)
        // Carrier binding only applies when the scrutinee is a real Result/Option;
        // a user enum reusing Ok/Err/Some binds its own variant fields below.
        let ep_scrut_type = match_scruts.get(scrut_off).unwrap().scrut_type
        let is_result_carrier = (enum_name == "Ok" || enum_name == "Err") && ep_scrut_type == CT_RESULT
        let is_option_carrier = enum_name == "Some" && ep_scrut_type == CT_OPTION
        if (is_result_carrier || is_option_carrier) && ep_flds_sl != -1 && sublist_length(ep_flds_sl) >= 1 {
            let sub_pat = sublist_get(ep_flds_sl, 0)
            let sub_pk = node_kind(sub_pat)
            let scrut = match_scruts.get(scrut_off).unwrap().str_val
            let scrut_type = match_scruts.get(scrut_off).unwrap().scrut_type
            let bind_erased = get_var_option_erased(scrut)
            if sub_pk == NodeKind.IdentPattern {
                let bind_name = node_name(sub_pat)
                if bind_name != "_" {
                    let c_bind = c_safe_name(bind_name)
                    let uc = unwrap_carrier(enum_name, scrut, scrut_type)
                    let field = uc.field
                    let inner_ct = uc.inner_ct
                    let inner_struct = uc.inner_struct
                    let opaque_bind = if enum_name == "Some" && scrut_type == CT_OPTION {
                        let obvs = get_var_option_inner_nominal(scrut)
                        let cand = if obvs != "" { obvs } else { inner_struct }
                        if cand != "" && is_opaque_type(cand) != 0 { cand } else { "" }
                    } else {
                        ""
                    }
                    if opaque_bind != "" {
                        // NPO: the carrier IS the handle pointer, so Some(g) binds it
                        // by identity — no `.value` deref.
                        emit_line("{c_type_c_name(opaque_bind)} {c_bind} = {scrut};")
                        set_var(bind_name, CT_STRUCT, 0)
                        set_var_struct(bind_name, opaque_bind)
                    } else if inner_struct != "" && inner_ct == CT_RESULT {
                        if field == "value" {
                            emit_line("{c_type_c_name(inner_struct)} {c_bind} = *{scrut}.{field};")
                        } else {
                            emit_line("{c_type_c_name(inner_struct)} {c_bind} = {scrut}.{field};")
                        }
                        set_var(bind_name, CT_RESULT, 0)
                        if inner_struct.starts_with("Result_") {
                            set_var_result_from_struct_tag(bind_name, inner_struct)
                            let split = split_result_compound(inner_struct)
                            if split.second != "" {
                                expr_result_ok_type = get_var_result_ok(bind_name)
                                expr_result_err_type = get_var_result_err(bind_name)
                                expr_result_ok_struct = get_var_result_ok_struct(bind_name)
                                expr_result_err_struct = get_var_result_err_struct(bind_name)
                            } else {
                                set_var_result(bind_name, expr_result_ok_type, expr_result_err_type)
                            }
                        } else {
                            set_var_result(bind_name, expr_result_ok_type, expr_result_err_type)
                        }
                    } else if inner_struct != "" && inner_ct == CT_OPTION {
                        let inner_opaque_handle = opaque_option_carrier_cname(inner_struct)
                        if inner_opaque_handle != "" {
                            // Option[Option[opaque]]: the inner Option[opaque] is NPO'd to the
                            // bare handle word, so the outer carrier's `.value` IS that handle --
                            // bind it by identity, no deref over the (suppressed) inner carrier.
                            emit_line("{inner_opaque_handle} {c_bind} = {scrut}.{field};")
                        } else if field == "value" {
                            emit_line("{c_type_c_name(inner_struct)} {c_bind} = *{scrut}.{field};")
                        } else {
                            emit_line("{c_type_c_name(inner_struct)} {c_bind} = {scrut}.{field};")
                        }
                        set_var(bind_name, CT_OPTION, 0)
                        if inner_struct.starts_with("Option_") {
                            set_var_option_from_struct_tag(bind_name, inner_struct)
                        } else {
                            set_var_option_struct(bind_name, CT_INT, inner_struct)
                        }
                    } else if inner_struct != "" && inner_ct == CT_MAP {
                        emit_line("blink_map* {c_bind} = {scrut}.{field};")
                        set_var(bind_name, CT_MAP, 0)
                        // A Map unwrapped from a `List[Option[Map[K,V]]]`
                        // element (`match item { Some(mm) => mm.get(k) }`) needs its
                        // scalar K/V so `mm.get(k)` decodes V — the single-slot
                        // expr_option_inner_map_val_* channels only carry a struct/list
                        // value, never a scalar V (Str), which is what erased to Int.
                        // The carrier tag (`Map_int_str`) encodes both scalar sides;
                        // recover them from the tag itself (stateless — unlike the
                        // transient expr_option_inner_tp, which a nested scope can
                        // revert). Fire only when a scalar V hasn't already been set.
                        let mkv = map_struct_scalar_kv(inner_struct)
                        if mkv.first >= 0 && expr_option_inner_map_val_struct == "" && expr_option_inner_map_val_list_elem < 0 {
                            set_map_types(bind_name, mkv.first, mkv.second, "")
                        }
                        if expr_option_inner_map_val_struct != "" {
                            set_map_value_struct(bind_name, expr_option_inner_map_val_struct)
                        }
                        if expr_option_inner_map_val_list_elem >= 0 {
                            set_map_value_list_elem(bind_name, expr_option_inner_map_val_list_elem)
                        }
                        // The three flat recoveries above reach back through the transient
                        // expr_option_inner_map_val_* globals, which a prior unrelated Option[Map]
                        // emission in the same function leaves holding its value struct/element --
                        // an erased carrier tag (`map`) cannot displace them the way a structured
                        // `Map_k_v` tag once did. The binder's own tid is the authority: it clears
                        // the stale value meta and writes K/V whole, so a scalar Map value out of a
                        // List element stops reading back a foreign struct.
                        stamp_map_from_map_tid(pat_binder_tid(sub_pat), bind_name)
                    } else if inner_struct != "" && inner_ct == CT_LIST {
                        emit_line("blink_list* {c_bind} = {scrut}.{field};")
                        set_var(bind_name, CT_LIST, 0)
                        // A List unwrapped from a `List[Option[List[T]]]`
                        // element carries its element type in expr_option_inner_tp
                        // (the inner List tp node). Prefer it so `li.get(i)` decodes T.
                        if expr_option_inner_tp >= 0 && tp_get_kind(expr_option_inner_tp) == CT_LIST {
                            set_list_elem_type(bind_name, tp_child1_kind(expr_option_inner_tp))
                            let les = tp_child1_sname(expr_option_inner_tp)
                            if les != "" {
                                set_list_elem_struct(bind_name, les)
                            }
                        } else if expr_option_inner_list_elem >= 0 {
                            set_list_elem_type(bind_name, expr_option_inner_list_elem)
                        } else if expr_list_elem_type >= 0 {
                            set_list_elem_type(bind_name, expr_list_elem_type)
                        }
                        if expr_option_inner_list_struct != "" {
                            set_list_elem_struct(bind_name, expr_option_inner_list_struct)
                        } else if expr_list_elem_struct != "" {
                            set_list_elem_struct(bind_name, expr_list_elem_struct)
                        }
                    } else if inner_struct != "" {
                        if is_transparent_newtype(inner_struct) != 0 {
                            // Transparent newtype (Errno): the carrier arm is a bare
                            // int64_t, so a whole-value binder is int64_t too (flat
                            // source, flat destination). Still registered as the enum
                            // type — no struct box — so a nested `match e { Errno(rc) }`
                            // binds rc by identity.
                            emit_line("int64_t {c_bind} = {scrut}.{field};")
                            set_var(bind_name, CT_INT, 0)
                            var_enums.push(VarEnumEntry { name: bind_name, enum_type: inner_struct })
                        } else {
                            if field == "value" && bind_erased != 0 {
                                // Erased box: .value is a void* to the true struct.
                                emit_line("{c_type_c_name(inner_struct)} {c_bind} = *({c_type_c_name(inner_struct)}*){scrut}.{field};")
                            } else if field == "value" && is_payloadless_enum(inner_struct) != 0 {
                                // Payload-less enum Option carrier is by-value (mirrors
                                // the err arm's is_boxed_struct_err): bind by identity,
                                // no deref.
                                emit_line("{c_type_c_name(inner_struct)} {c_bind} = {scrut}.{field};")
                            } else if field == "value" {
                                emit_line("{c_type_c_name(inner_struct)} {c_bind} = *{scrut}.{field};")
                            } else if field == "err" && is_boxed_struct_err(inner_struct) != 0 {
                                // C2: a struct-typed err arm is boxed by pointer; the
                                // whole-value binder copies the struct out of the box.
                                emit_line("{c_type_c_name(inner_struct)} {c_bind} = *{scrut}.{field};")
                            } else {
                                emit_line("{c_type_c_name(inner_struct)} {c_bind} = {scrut}.{field};")
                            }
                            set_var(bind_name, CT_INT, 0)
                            set_var_struct(bind_name, inner_struct)
                            if is_enum_type(inner_struct) != 0 {
                                var_enums.push(VarEnumEntry { name: bind_name, enum_type: inner_struct })
                            }
                        }
                    } else {
                        let payload_tid = pat_binder_tid(sub_pat)
                        let payload_c = c_type_str(inner_ct)
                        ctype_probe_at(payload_tid, "match_binder.carrier_payload", bind_name, payload_c, sub_pat)
                        let payload_spelled = c_type_from_tid(payload_tid)
                        let payload_ts = if payload_spelled != "" && payload_spelled != "void" { payload_spelled } else { payload_c }
                        // A compound inner (Option/Result) under an Option's `.value`
                        // is boxed by pointer, so the whole-value binder derefs — same
                        // rule the inner_struct != "" arms above use. Reached here when
                        // the flat inner-struct channel was erased and the tid recovered
                        // the payload type; without the deref the binder assigns a
                        // pointer to a by-value struct.
                        if field == "value" && (inner_ct == CT_OPTION || inner_ct == CT_RESULT) {
                            emit_line("{payload_ts} {c_bind} = *{scrut}.{field};")
                        } else {
                            emit_line("{payload_ts} {c_bind} = {scrut}.{field};")
                        }
                        set_var(bind_name, inner_ct, 0)
                        if inner_ct == CT_LIST {
                            // A plain `Option[List[T]]` (no struct name)
                            // unwrapped from a List[compound] element carries T on
                            // expr_option_inner_tp (the inner List tp). Prefer it so
                            // `li.get(i)` decodes T — the list-elem globals below are
                            // stale here (they described the outer list).
                            if expr_option_inner_tp >= 0 && tp_get_kind(expr_option_inner_tp) == CT_LIST {
                                set_list_elem_type(bind_name, tp_child1_kind(expr_option_inner_tp))
                                let les = tp_child1_sname(expr_option_inner_tp)
                                if les != "" {
                                    set_list_elem_struct(bind_name, les)
                                }
                            } else if expr_option_inner_list_elem >= 0 {
                                set_list_elem_type(bind_name, expr_option_inner_list_elem)
                            } else if expr_list_elem_type >= 0 {
                                set_list_elem_type(bind_name, expr_list_elem_type)
                            }
                            if expr_option_inner_list_struct != "" {
                                set_list_elem_struct(bind_name, expr_option_inner_list_struct)
                            } else if expr_list_elem_struct != "" {
                                set_list_elem_struct(bind_name, expr_list_elem_struct)
                            }
                        } else if inner_ct == CT_SET {
                            // match d.get(0) { Some(inner) => ... } — mirror the
                            // CT_LIST branch above. The Set's own element rides the
                            // scrutinee's flat inner2 channel (stamped by the .get()/.pop()
                            // CT_SET arms), never a transient global.
                            let set_nested = get_var_option_inner2(scrut)
                            if set_nested != -1 {
                                set_set_elem_type(bind_name, set_nested)
                            }
                            let set_nested_s = get_var_option_inner2_struct(scrut)
                            if set_nested_s != "" {
                                set_set_elem_struct(bind_name, set_nested_s)
                            }
                        } else if inner_ct == CT_MAP {
                            // The carrier's ok/value struct slot was erased (a compound
                            // Map inner sets no rok_s), so unwrap_carrier reported no
                            // inner_struct and the Map reached this branch with only its
                            // head CT. The Map C type is pointer-erased anyway, so only
                            // the key/value metadata is at stake — and the binder's own
                            // tid is the authority for it. Without this, `Map[Str, Point]`
                            // read its value back as Int (`inner.get(k).value.<field>`).
                            stamp_map_from_map_tid(pat_binder_tid(sub_pat), bind_name)
                        }
                    }
                    pat_measure(bind_name, sub_pat)
                }
            } else if sub_pk == NodeKind.WildcardPattern {
                let _skip = 0
            } else if sub_pk == NodeKind.EnumPattern {
                // Nested EnumPattern inside Ok/Err/Some: recurse with the unwrapped
                // payload as scrutinee so the inner variant's field bindings emit.
                let uc = unwrap_carrier(enum_name, scrut, scrut_type)
                let inner_is_enum = uc.inner_struct != "" && is_enum_type(uc.inner_struct) != 0
                let saved_scruts = match_scruts
                let saved_enum = match_scrut_enum
                // Re-derive the carrier-shape globals for the inner carrier before
                // recursing — unwrap_carrier reads them, and leaving the OUTER
                // shape live mistypes the innermost binder.
                let saved_ok_type = expr_result_ok_type
                let saved_err_type = expr_result_err_type
                let saved_ok_struct = expr_result_ok_struct
                let saved_err_struct = expr_result_err_struct
                let saved_opt_inner = expr_option_inner
                let saved_opt_struct = expr_option_inner_struct
                match_scruts = [MatchScrutEntry { str_val: uc.payload_expr, scrut_type: uc.inner_ct }]
                if inner_is_enum {
                    match_scrut_enum = uc.inner_struct
                } else {
                    match_scrut_enum = ""
                }
                if (uc.inner_ct == CT_RESULT || uc.inner_ct == CT_OPTION) && uc.inner_struct != "" {
                    set_carrier_globals_from_inner(uc.inner_ct, uc.inner_struct)
                }
                bind_pattern_vars(sub_pat, 0, 1)
                match_scruts = saved_scruts
                match_scrut_enum = saved_enum
                expr_result_ok_type = saved_ok_type
                expr_result_err_type = saved_err_type
                expr_result_ok_struct = saved_ok_struct
                expr_result_err_struct = saved_err_struct
                expr_option_inner = saved_opt_inner
                expr_option_inner_struct = saved_opt_struct
            }
            return
        }
        let mut resolved_enum = enum_name
        let mut resolved_variant = variant_name
        if variant_name == "" {
            resolved_variant = enum_name
            resolved_enum = resolve_arm_enum(enum_name)
        }
        if resolved_enum != "" && is_data_enum(resolved_enum) != 0 && ep_flds_sl != -1 {
            let vidx = get_variant_index(resolved_enum, resolved_variant)
            if vidx >= 0 {
                let fcount = get_variant_field_count(vidx)
                let scrut = match_scruts.get(scrut_off).unwrap().str_val
                let is_struct_pat = node_int_val(pat)
                if is_transparent_newtype(resolved_enum) != 0 {
                    // A transparent newtype like `Errno(rc)` binds its single
                    // scalar payload by IDENTITY — the scrutinee IS the bare int64_t
                    // (e.g. `_scrut.err`), not a tagged struct, so read it directly
                    // rather than `.data.Errno._0`.
                    if sublist_length(ep_flds_sl) > 0 {
                        let sub_pat0 = sublist_get(ep_flds_sl, 0)
                        if node_kind(sub_pat0) == NodeKind.IdentPattern {
                            let bn = node_name(sub_pat0)
                            if bn != "_" {
                                emit_line("int64_t {c_safe_name(bn)} = {scrut};")
                                set_var(bn, CT_INT, 0)
                                pat_measure(bn, sub_pat0)
                            }
                        }
                    }
                    return
                }
                if is_struct_pat != 0 {
                    bind_struct_style_variant_fields(vidx, fcount, resolved_enum, resolved_variant, scrut, ep_flds_sl, match_scruts.get(scrut_off).unwrap().scrut_sname)
                } else {
                    // A generic-enum scrutinee (Tree[Int]) carries its mono stem on the
                    // scrutinee entry; payload fields whose declared type is a typevar
                    // (`Leaf.value: T`) or the self-recursive enum (`Branch.left: Tree[T]`)
                    // resolve against it so bindings get the concrete C type instead of
                    // the erased `void`.
                    let scrut_mono = match_scruts.get(scrut_off).unwrap().scrut_sname
                    let mut fi = 0
                    while fi < sublist_length(ep_flds_sl) && fi < fcount {
                        let sub_pat = sublist_get(ep_flds_sl, fi)
                        let sub_pk = node_kind(sub_pat)
                        let field_name = get_variant_field_name(vidx, fi).unwrap()
                        let field_type_raw = get_variant_field_type_str(vidx, fi).unwrap()
                        // Self-recursive field (`Tree[T]`) keeps the enum name (base
                        // matches); a typevar field resolves to its concrete arg.
                        let field_type_name = if strip_generic_args(field_type_raw) == resolved_enum { resolved_enum } else { resolve_variant_field_type_mono(field_type_raw, resolved_enum, scrut_mono) }
                        let field_ct = type_from_name(field_type_name)
                        if sub_pk == NodeKind.IdentPattern {
                            let bind_name = node_name(sub_pat)
                            if bind_name != "_" {
                                let c_bind = c_safe_name(bind_name)
                                if field_type_name == resolved_enum {
                                    // Recursive-enum field: unbox with the scrutinee's
                                    // mono C type (blink_Tree_Int) so `l`/`r` are typed
                                    // Tree[Int], not the erased bare Tree. set_var_struct
                                    // publishes the mono stem so a downstream fn call
                                    // (leaf_value(l)) resolves the arg C type.
                                    let fc_type = if scrut_mono != "" && is_mono_struct_instance(scrut_mono) != 0 { scrut_mono } else { field_type_name }
                                    let fc_name = c_type_c_name(fc_type)
                                    emit_line("{fc_name} {c_bind} = *({fc_name}*)(intptr_t){scrut}.data.{resolved_variant}.{field_name};")
                                    set_var(bind_name, CT_VOID, 0)
                                    set_var_struct(bind_name, fc_type)
                                    var_enums.push(VarEnumEntry { name: bind_name, enum_type: resolved_enum })
                                } else if is_struct_type(field_type_name) != 0 {
                                    emit_line("{c_type_c_name(field_type_name)} {c_bind} = {scrut}.data.{resolved_variant}.{field_name};")
                                    set_var(bind_name, CT_VOID, 0)
                                    set_var_struct(bind_name, field_type_name)
                                } else if is_enum_type(field_type_name) != 0 {
                                    emit_line("{c_type_c_name(field_type_name)} {c_bind} = {scrut}.data.{resolved_variant}.{field_name};")
                                    set_var(bind_name, CT_INT, 0)
                                    var_enums.push(VarEnumEntry { name: bind_name, enum_type: field_type_name })
                                } else if field_ct == CT_LIST {
                                    emit_line("blink_list* {c_bind} = {scrut}.data.{resolved_variant}.{field_name};")
                                    set_var(bind_name, CT_LIST, 0)
                                    let bracket_pos = field_type_name.index_of("[")
                                    if bracket_pos > 0 {
                                        let inner_name = field_type_name.substr(bracket_pos + 1, field_type_name.len() - bracket_pos - 2)
                                        let inner_ct = type_from_name(inner_name)
                                        if inner_ct != CT_VOID {
                                            set_list_elem_type(bind_name, inner_ct)
                                        } else if is_enum_type(inner_name) != 0 || is_struct_type(inner_name) != 0 {
                                            set_list_elem_struct(bind_name, inner_name)
                                            set_list_elem_type(bind_name, CT_VOID)
                                        }
                                    }
                                } else if field_ct == CT_OPTION || field_ct == CT_RESULT {
                                    emit_line("__typeof__({scrut}.data.{resolved_variant}.{field_name}) {c_bind} = {scrut}.data.{resolved_variant}.{field_name};")
                                    set_var(bind_name, field_ct, 0)
                                    register_var_compound_inner_from_str(bind_name, field_type_name)
                                } else if tc_variant_field_is_selfrec_tuple(resolved_enum, resolved_variant, field_name) != 0 {
                                    // Self-recursive tuple field: stored boxed as an
                                    // int64_t pointer (see the ctor), so deref through the
                                    // mono tuple carrier and publish its tag so `p.0` reads.
                                    let tup_tag = selfrec_tuple_field_carrier(resolved_enum, resolved_variant, field_name, scrut_mono)
                                    if tup_tag == "" {
                                        diag_ice_at("SelfrecTupleCarrierUnresolved", UNSOLVED_TYPEVAR_AT_CODEGEN,
                                            "self-recursive tuple field '{field_name}' of '{resolved_enum}.{resolved_variant}' reached codegen without a resolvable tuple carrier",
                                            sub_pat,
                                            "this is a compiler bug — the boxed tuple carrier should resolve from the field annotation")
                                    } else {
                                        let tup_c = c_type_c_name(tup_tag)
                                        emit_line("{tup_c} {c_bind} = *({tup_c}*)(intptr_t){scrut}.data.{resolved_variant}.{field_name};")
                                        set_var(bind_name, field_ct, 0)
                                        set_var_struct(bind_name, tup_tag)
                                    }
                                } else {
                                    let vfield_tid = subst_variant_field_binder_tid(pat_binder_tid(sub_pat), resolved_enum, scrut_mono)
                                    let vfield_c = c_type_str(field_ct)
                                    ctype_probe_at(vfield_tid, "match_binder.variant_field", bind_name, vfield_c, sub_pat)
                                    let vfield_spelled = c_type_from_tid(vfield_tid)
                                    let vfield_ts = if vfield_spelled != "" && vfield_spelled != "void" { vfield_spelled } else { vfield_c }
                                    emit_line("{vfield_ts} {c_bind} = {scrut}.data.{resolved_variant}.{field_name};")
                                    set_var(bind_name, field_ct, 0)
                                    // A tuple payload has no struct/enum name, so publish its
                                    // carrier tag on the binding; without it a positional read
                                    // (`t.0`) can't find the tuple entry and renders <value>.
                                    let vfield_res_tid = tc_tid_resolved(vfield_tid)
                                    if tc_tid_kind(vfield_res_tid) == TyKind.Tuple {
                                        let tup_tag = tc_tid_tuple_sname(vfield_res_tid)
                                        if tup_tag != "" { set_var_struct(bind_name, tup_tag) }
                                    }
                                }
                                pat_measure(bind_name, sub_pat)
                            }
                        } else if sub_pk == NodeKind.WildcardPattern {
                            let _skip = 0
                        } else {
                            let saved_scruts = match_scruts
                            // Carry the field's mono stem so a nested pattern over a
                            // generic-enum-instance field resolves its own payload types.
                            // A self-recursive field (Tree[T]) resolved to the
                            // scrutinee's own mono earlier; a distinct generic-enum field
                            // resolves to its instance stem when that names a mono. The
                            // bare enum name is used for match_scrut_enum's variant lookups.
                            // A self-recursive field is boxed; its stem is the scrutinee's
                            // own mono (field_type_name was normalized to the bare enum above,
                            // so it never names a mono directly).
                            let sr_mono = selfrec_field_mono(strip_generic_args(field_type_name), resolved_enum, scrut_mono)
                            let nested_mono = if sr_mono != "" { sr_mono } else if is_mono_struct_instance(field_type_name) != 0 { field_type_name } else { "" }
                            // A self-recursive tuple field (`Pair((l, r))`) is boxed; deref
                            // through its arg-full carrier so the TuplePattern arm expands the
                            // real tuple, not the raw pointer bits (else the erased carrier is
                            // unregistered and the expander unwraps a missing scrut).
                            let sr_tuple_tag = if sub_pk == NodeKind.TuplePattern && tc_variant_field_is_selfrec_tuple(resolved_enum, resolved_variant, field_name) != 0 { selfrec_tuple_field_carrier(resolved_enum, resolved_variant, field_name, scrut_mono) } else { "" }
                            if sub_pk == NodeKind.TuplePattern && tc_variant_field_is_selfrec_tuple(resolved_enum, resolved_variant, field_name) != 0 && sr_tuple_tag == "" {
                                diag_ice_at("SelfrecTupleCarrierUnresolved", UNSOLVED_TYPEVAR_AT_CODEGEN,
                                    "self-recursive tuple field '{field_name}' of '{resolved_enum}.{resolved_variant}' reached codegen without a resolvable tuple carrier",
                                    sub_pat,
                                    "this is a compiler bug — the boxed tuple carrier should resolve from the field annotation")
                            } else if sr_tuple_tag != "" {
                                let sr_c = c_type_c_name(sr_tuple_tag)
                                match_scruts = [MatchScrutEntry { str_val: "(*({sr_c}*)(intptr_t){scrut}.data.{resolved_variant}.{field_name})", scrut_type: field_ct, scrut_sname: sr_tuple_tag }]
                                let saved_enum = match_scrut_enum
                                match_scrut_enum = ""
                                bind_pattern_vars(sub_pat, 0, 1)
                                match_scrut_enum = saved_enum
                            } else {
                                // A tuple payload has no struct/enum name; publish its carrier tag so
                                // the TuplePattern arm can expand the single whole-tuple entry into
                                // one per-element entry rather than indexing past the only entry.
                                let pos_entry_sname = if sub_pk == NodeKind.TuplePattern { tuple_field_carrier_tag_mono(resolved_enum, resolved_variant, field_name, scrut_mono, nested_mono) } else { nested_mono }
                                match_scruts = [MatchScrutEntry { str_val: variant_field_scrut_expr(scrut, resolved_variant, field_name, strip_generic_args(field_type_name), resolved_enum, scrut_mono), scrut_type: field_ct, scrut_sname: pos_entry_sname }]
                                let saved_enum = match_scrut_enum
                                match_scrut_enum = if field_type_name != "" && is_enum_type(strip_generic_args(field_type_name)) != 0 { strip_generic_args(field_type_name) } else { "" }
                                bind_pattern_vars(sub_pat, 0, 1)
                                match_scrut_enum = saved_enum
                            }
                            match_scruts = saved_scruts
                        }
                        fi = fi + 1
                    }
                }
            }
        }
        return
    }
    if pk == NodeKind.StringPattern {
        return
    }
    if pk == NodeKind.RangePattern {
        return
    }
    if pk == NodeKind.IntPattern {
        return
    }
    if pk == NodeKind.OrPattern {
        let alts_sl = node_elements(pat)
        if alts_sl != -1 && sublist_length(alts_sl) > 0 {
            bind_pattern_vars(sublist_get(alts_sl, 0), scrut_off, scrut_len)
        }
        return
    }
    if pk == NodeKind.StructPattern {
        let flds_sl = node_fields(pat)
        if flds_sl == -1 {
            return
        }
        let scrut = match_scruts.get(scrut_off).unwrap().str_val
        let stype_name = node_type_name(pat)
        // A bare `Variant { .. }` pattern is parsed as StructPattern; route it
        // through the variant member when the name resolves to a data-enum variant.
        let sp_enum = resolve_arm_enum(stype_name)
        if sp_enum != "" && is_data_enum(sp_enum) != 0 {
            let vidx = get_variant_index(sp_enum, stype_name)
            if vidx >= 0 {
                let fcount = get_variant_field_count(vidx)
                bind_struct_style_variant_fields(vidx, fcount, sp_enum, stype_name, scrut, flds_sl, match_scruts.get(scrut_off).unwrap().scrut_sname)
            }
            return
        }
        let mut j = 0
        while j < sublist_length(flds_sl) {
            let sf = sublist_get(flds_sl, j)
            let fname = node_name(sf)
            let c_fname = c_safe_name(fname)
            let fpat = node_pattern(sf)
            let ftype = get_struct_field_type(stype_name, fname)
            let fstype = get_struct_field_stype(stype_name, fname)
            if fpat != -1 {
                // A `field: pat` sub-pattern types its binder from the declared field
                // type, the same as the shorthand branch below; the enum sname lets a
                // nested variant pattern resolve against the field's enum.
                let saved_scruts = match_scruts
                match_scruts = [MatchScrutEntry { str_val: "{scrut}.{fname}", scrut_type: ftype, scrut_sname: fstype }]
                let saved_enum = match_scrut_enum
                match_scrut_enum = if fstype != "" && is_enum_type(fstype) != 0 { fstype } else { "" }
                bind_pattern_vars(fpat, 0, 1)
                match_scrut_enum = saved_enum
                match_scruts = saved_scruts
            } else {
                emit_line("__typeof__({scrut}.{fname}) {c_fname} = {scrut}.{fname};")
                set_var(fname, ftype, 0)
                if fstype != "" {
                    set_var_struct(fname, fstype)
                }
            }
            j = j + 1
        }
        return
    }
    if pk == NodeKind.AsPattern {
        let bind_name = node_name(pat)
        if scrut_len > 1 {
            // `x as y` over a pre-expanded tuple scrutinee binds BOTH names to the whole tuple.
            // The as-name is reconstructed here; node_pattern(pat) (the inner binder) is bound by
            // the recursion below. Element 0 alone would mis-declare a whole-tuple bind.
            bind_whole_tuple_from_scruts(pat, bind_name, scrut_off, scrut_len)
            bind_pattern_vars(node_pattern(pat), scrut_off, scrut_len)
            return
        }
        let c_bind = c_safe_name(bind_name)
        let entry = match_scruts.get(scrut_off).unwrap()
        let st = entry.scrut_type
        let sn = entry.scrut_sname
        let scrut_str = entry.str_val
        if match_scrut_enum != "" {
            // This branch spells from a name rather than from a bare CT, so it never had the `void`
            // defect its two siblings did. Routed on the same template anyway, so the enum arm is not
            // the one place a binder's C type still comes from somewhere else.
            let as_enum_tid = pat_binder_tid(pat)
            let as_enum_c = c_type_c_name(match_scrut_enum)
            ctype_probe_at(as_enum_tid, "match_binder.as_enum", bind_name, as_enum_c, pat)
            let as_enum_spelled = c_type_from_tid(as_enum_tid)
            let as_enum_ts = if as_enum_spelled != "" && as_enum_spelled != "void" { as_enum_spelled } else { as_enum_c }
            emit_line("{as_enum_ts} {c_bind} = {scrut_str};")
            set_var(bind_name, CT_INT, 1)
            var_enums.push(VarEnumEntry { name: bind_name, enum_type: match_scrut_enum })
        } else if sn != "" {
            let as_tid = pat_binder_tid(pat)
            let as_sn_c = c_type_c_name(sn)
            ctype_probe_at(as_tid, "match_binder.as_sname", bind_name, as_sn_c, pat)
            let as_sn_spelled = c_type_from_tid(as_tid)
            let as_sn_ts = if as_sn_spelled != "" && as_sn_spelled != "void" { as_sn_spelled } else { as_sn_c }
            emit_line("{as_sn_ts} {c_bind} = {scrut_str};")
            if !stamp_whole_binder_from_tid(as_tid, bind_name, 1) {
                if sn.starts_with("Option_") {
                    set_var(bind_name, CT_OPTION, 1)
                    set_var_option_from_struct_tag(bind_name, sn)
                } else if sn.starts_with("Result_") {
                    set_var(bind_name, CT_RESULT, 1)
                    set_var_result_from_struct_tag(bind_name, sn)
                } else {
                    set_var(bind_name, CT_VOID, 1)
                    set_var_struct(c_bind, sn)
                    if is_data_enum(sn) != 0 {
                        var_enums.push(VarEnumEntry { name: bind_name, enum_type: sn })
                    }
                }
            }
        } else {
            // The `sn == ""` branch is where an `as` binder over a carrier or a struct lands, and
            // `c_type_str` of a bare CT answers `void` for both: a carrier is only nameable WITH its
            // inner, and a struct needs its name. Neither is recoverable from the flat pair, so the
            // tid is not an improvement here but the only source of a correct declaration.
            let as_tid = pat_binder_tid(pat)
            let as_c = c_type_str(st)
            ctype_probe_at(as_tid, "match_binder.as_scalar", bind_name, as_c, pat)
            let as_spelled = c_type_from_tid(as_tid)
            let as_ts = if as_spelled != "" && as_spelled != "void" { as_spelled } else { as_c }
            emit_line("{as_ts} {c_bind} = {scrut_str};")
            if !stamp_whole_binder_from_tid(as_tid, bind_name, 1) {
                set_var(bind_name, st, 1)
            }
        }
        bind_pattern_vars(node_pattern(pat), scrut_off, scrut_len)
        return
    }
    if pk == NodeKind.IdentPattern {
        let bind_name = node_name(pat)
        if bind_name == "None" {
            return
        }
        let enum_name = resolve_arm_enum(bind_name)
        if enum_name != "" {
            return
        }
        if scrut_len == 1 {
            let c_bind = c_safe_name(bind_name)
            let entry = match_scruts.get(scrut_off).unwrap()
            let st = entry.scrut_type
            let sn = entry.scrut_sname
            if sn != "" {
                let ident_sn_tid = pat_binder_tid(pat)
                let ident_sn_c = c_type_c_name(sn)
                ctype_probe_at(ident_sn_tid, "match_binder.ident_sname", bind_name, ident_sn_c, pat)
                let ident_sn_spelled = c_type_from_tid(ident_sn_tid)
                let ident_sn_ts = if ident_sn_spelled != "" && ident_sn_spelled != "void" { ident_sn_spelled } else { ident_sn_c }
                emit_line("{ident_sn_ts} {c_bind} = {entry.str_val};")
                // Tid first, tag second. `sn` is the tuple field's struct-name slot, which
                // emit_tuple_typedef also uses as a dumping ground for compound tags, so a
                // Map element arrives here indistinguishable from a struct. The
                // chain below decodes only `Option_`/`Result_` and would file it as a struct
                // named `Map_str_int`.
                if !stamp_binder_from_tid(pat, bind_name, 1) {
                    if sn.starts_with("Option_") {
                        set_var(bind_name, CT_OPTION, 1)
                        set_var_option_from_struct_tag(bind_name, sn)
                    } else if sn.starts_with("Result_") {
                        set_var(bind_name, CT_RESULT, 1)
                        set_var_result_from_struct_tag(bind_name, sn)
                    } else {
                        set_var(bind_name, CT_VOID, 1)
                        set_var_struct(c_bind, sn)
                        if is_data_enum(sn) != 0 {
                            var_enums.push(VarEnumEntry { name: bind_name, enum_type: sn })
                        }
                    }
                }
            } else {
                let ident_tid = pat_binder_tid(pat)
                let ident_c = c_type_str(st)
                ctype_probe_at(ident_tid, "match_binder.ident_scalar", bind_name, ident_c, pat)
                let ident_spelled = c_type_from_tid(ident_tid)
                let ident_ts = if ident_spelled != "" && ident_spelled != "void" { ident_spelled } else { ident_c }
                emit_line("{ident_ts} {c_bind} = {entry.str_val};")
                // The scalar branch needs the tid too, and for a different erasure: a container
                // element keeps its own CT here and loses its ELEMENT, which is a silent wrong
                // answer rather than a missing method.
                if !stamp_binder_from_tid(pat, bind_name, 1) {
                    set_var(bind_name, st, 1)
                }
            }
            pat_measure(bind_name, pat)
        }
        if scrut_len > 1 {
            // A whole-value ident binder over a tuple scrutinee.
            bind_whole_tuple_from_scruts(pat, bind_name, scrut_off, scrut_len)
        }
        return
    }
    if pk == NodeKind.TuplePattern {
        let elems_sl = node_elements(pat)
        if elems_sl != -1 {
            let n_elems = sublist_length(elems_sl)
            // Two shapes reach here. The top-level tuple-scrutinee fast path
            // pre-expands the tuple into one entry per element (scrut_len ==
            // n_elems). A nested tuple sub-pattern (an enum variant Tuple
            // payload) arrives as a SINGLE whole-tuple entry whose scrut_sname
            // names the tuple carrier; expand it the same way before indexing
            // per element, else scrut_off + j past element 0 unwraps a None.
            if scrut_len == 1 && n_elems > 1 {
                let whole = match_scruts.get(scrut_off).unwrap()
                if whole.scrut_sname != "" && tuple_struct_arity(whole.scrut_sname) >= 0 {
                    let saved_scruts = match_scruts
                    match_scruts = []
                    expand_tuple_scrut_entry(whole.scrut_sname, whole.str_val)
                    let mut je = 0
                    while je < n_elems {
                        bind_pattern_vars(sublist_get(elems_sl, je), je, 1)
                        je = je + 1
                    }
                    match_scruts = saved_scruts
                    return
                }
            }
            let mut j = 0
            while j < n_elems {
                let sub_pat = sublist_get(elems_sl, j)
                bind_pattern_vars(sub_pat, scrut_off + j, 1)
                j = j + 1
            }
        }
        return
    }
    if pk == NodeKind.ListPattern {
        let elems_sl = node_elements(pat)
        if elems_sl != -1 {
            let scrut = match_scruts.get(scrut_off).unwrap().str_val
            let elem_type = get_list_elem_type(scrut)
            let elem_struct = get_list_elem_struct(scrut)
            let mut j = 0
            while j < sublist_length(elems_sl) {
                let sub_pat = sublist_get(elems_sl, j)
                let saved_scruts = match_scruts
                let mut cast = "(int64_t)(intptr_t)"
                let mut bind_ct = CT_INT
                if elem_type == CT_STRING {
                    cast = "(const char*)"
                    bind_ct = CT_STRING
                } else if elem_struct != "" {
                    cast = "({c_type_c_name(elem_struct)})(intptr_t)"
                    bind_ct = CT_INT
                } else if elem_type >= 0 {
                    bind_ct = elem_type
                }
                // A carrier sub-pattern (`Some(a)`/`Ok(a)`/`Err(m)`) has no spellable node
                // tid, so the sub-pattern-tid read below declines and the flat cast reads a
                // scalar — the carrier arm then binds `.value`/`.ok`/`.err` off it. For a
                // carrier element, read the struct VALUE off the LIST's element tid instead
                // and feed unwrap_carrier's inner-type globals from the element channels.
                let mut carrier_read = ""
                let bc_saved_oi = expr_option_inner
                let bc_saved_ois = expr_option_inner_struct
                let bc_saved_rok = expr_result_ok_type
                let bc_saved_rerr = expr_result_err_type
                let bc_saved_roks = expr_result_ok_struct
                let bc_saved_rerrs = expr_result_err_struct
                if elem_type == CT_OPTION || elem_type == CT_RESULT {
                    let bc_elem_tid = get_list_elem_tid(scrut)
                    let cread = list_elem_unbox_from_tid(bc_elem_tid, "blink_list_get({scrut}, {j})")
                    if cread != "" {
                        // Parenthesize: unwrap_carrier appends `.value`/`.ok`/`.err`, which
                        // binds tighter than the `*` deref in `*(T*)…`.
                        carrier_read = "({cread})"
                        bind_ct = elem_type
                        set_carrier_globals_from_inner(elem_type, tc_tid_to_c_tag(cg_bind_mono_tid(bc_elem_tid)))
                    }
                }
                // The IdentPattern arm below spells the binder's DECLARATION from this
                // sub-pattern's own tid, so the initializer has to be read off the same tid or
                // the two halves of one line disagree — `blink_list* b = (int64_t)(intptr_t)…`.
                // The flat chain above stays as the fallback for a tid that cannot be spelled.
                let sub_tid = pat_binder_tid(sub_pat)
                let elem_read = list_elem_unbox_from_tid(sub_tid, "blink_list_get({scrut}, {j})")
                let scrut_str = if carrier_read != "" { carrier_read } else if elem_read != "" { elem_read } else { "{cast}blink_list_get({scrut}, {j})" }
                // The sibling TuplePattern arm recurses on the ORIGINAL match_scruts, so its
                // binders keep the scrutinee's struct name; this arm rebuilds the entry and
                // dropped it, leaving a struct binder registered under no name at all — a field
                // read on it rendered as the `<value>` placeholder. Struct/Enum only: the
                // IdentPattern arm treats a non-empty sname as a compound TAG for every other
                // kind, which is a different channel with a different grammar.
                let sub_k = tc_tid_kind(tc_tid_resolved(sub_tid))
                let sub_sname = if sub_k == TyKind.Struct || sub_k == TyKind.Enum { tc_tid_struct(sub_tid) } else { "" }
                match_scruts = [MatchScrutEntry { str_val: scrut_str, scrut_type: bind_ct, scrut_sname: sub_sname }]
                let saved_enum = match_scrut_enum
                match_scrut_enum = if elem_struct != "" && is_enum_type(elem_struct) != 0 { elem_struct } else { "" }
                bind_pattern_vars(sub_pat, 0, 1)
                match_scrut_enum = saved_enum
                match_scruts = saved_scruts
                expr_option_inner = bc_saved_oi
                expr_option_inner_struct = bc_saved_ois
                expr_result_ok_type = bc_saved_rok
                expr_result_err_type = bc_saved_rerr
                expr_result_ok_struct = bc_saved_roks
                expr_result_err_struct = bc_saved_rerrs
                j = j + 1
            }
        }
        return
    }
}

@allow(UnrestoredMutation, IncompleteStateRestore)
pub fn emit_block_expr(node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    // A Block in primary-expression position (let RHS, async-scope body) must
    // thread its tail value, identically to an if/match arm body. Delegate to
    // emit_block_value rather than re-implementing a partial copy: a
    // hand-rolled copy that only handles an ExprStmt tail forces void for
    // IfExpr/MatchExpr/WithBlock tails, declaring `void` let-bindings.
    let v = emit_block_value(node)
    expr_result_str = v
    // emit_block_value leaves expr_result_type set by the tail's value-emit for
    // ExprStmt/IfExpr/MatchExpr/WithBlock tails. For empty blocks / non-value
    // statement tails (loop, assignment, bare return) it returns "0" without
    // setting the type — force void to match a value-less block.
    if v == "0" && infer_block_type(node) == CT_VOID {
        expr_result_type = CT_VOID
    }
}

fn emit_arm_value(body: Int) -> Str ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    if body == -1 {
        return "0"
    }
    let kind = node_kind(body)
    if kind == NodeKind.Block {
        return emit_block_value(body)
    }
    if kind == NodeKind.ExprStmt {
        emit_expr(node_value(body))
        return expr_result_str
    }
    if kind == NodeKind.Assignment || kind == NodeKind.CompoundAssign {
        emit_stmt(body)
        return "0"
    }
    emit_expr(body)
    expr_result_str
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_block_value(block: Int) -> Str ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    if block == -1 {
        return "0"
    }
    let stmts_sl = node_stmts(block)
    if stmts_sl == -1 {
        return "0"
    }
    let count = sublist_length(stmts_sl)
    if count == 0 {
        return "0"
    }
    let mut i = 0
    while i < count - 1 {
        emit_stmt(sublist_get(stmts_sl, i))
        i = i + 1
    }
    let last = sublist_get(stmts_sl, count - 1)
    let last_kind = node_kind(last)
    if last_kind == NodeKind.ExprStmt {
        emit_expr(node_value(last))
        return expr_result_str
    }
    if last_kind == NodeKind.IfExpr {
        emit_if_expr(last)
        return expr_result_str
    }
    if last_kind == NodeKind.MatchExpr {
        emit_match_expr(last)
        return expr_result_str
    }
    if last_kind == NodeKind.WithBlock {
        emit_with_block_expr(last)
        return expr_result_str
    }
    if last_kind == NodeKind.Return {
        if node_value(last) != -1 {
            emit_expr(node_value(last))
            emit_return_with_trace(expr_result_str, cg_current_fn_ret, node_value(last))
        } else {
            emit_trace_exit_void()
            emit_line("return;")
        }
        return "0"
    }
    emit_stmt(last)
    "0"
}

// The value expression of a block's tail ExprStmt, or -1 if the block is empty
// or does not end in an ExprStmt.
fn block_tail_expr(block: Int) -> Int {
    if block == -1 {
        return -1
    }
    let stmts_sl = node_stmts(block)
    if stmts_sl == -1 {
        return -1
    }
    let count = sublist_length(stmts_sl)
    if count == 0 {
        return -1
    }
    let last = sublist_get(stmts_sl, count - 1)
    if node_kind(last) == NodeKind.ExprStmt {
        return node_value(last)
    }
    -1
}

// Structural test for a match arm body that produces no value (statement
// position), so `emit_match_expr`'s harvest override must not treat the match as
// value-producing. Mirrors emit_block_expr's `v == "0" && infer_block_type ==
// CT_VOID` precedent rather than string-comparing the emitted arm text against
// "0" — a literal `0` in value position (`None => 0`) also emits "0" but IS a
// value. An assignment/compound-assignment arm, or a block whose tail is
// value-less, is genuinely void.
fn arm_body_is_valueless(body: Int) -> Int {
    if body == -1 { return 1 }
    let k = node_kind(body)
    if k == NodeKind.Assignment || k == NodeKind.CompoundAssign { return 1 }
    if k == NodeKind.Block {
        if infer_block_type(body) == CT_VOID { return 1 }
    }
    0
}

pub fn infer_block_type(block: Int) -> Int {
    if block == -1 {
        return CT_VOID
    }
    let stmts_sl = node_stmts(block)
    if stmts_sl == -1 {
        return CT_VOID
    }
    let count = sublist_length(stmts_sl)
    if count == 0 {
        return CT_VOID
    }
    let last = sublist_get(stmts_sl, count - 1)
    let last_kind = node_kind(last)
    if last_kind == NodeKind.ExprStmt {
        return infer_expr_type(node_value(last))
    }
    if last_kind == NodeKind.IfExpr {
        return infer_expr_type(last)
    }
    if last_kind == NodeKind.MatchExpr {
        return infer_arm_type(sublist_get(node_arms(last), 0))
    }
    CT_VOID
}

fn infer_arm_struct_name(arm: Int) -> Str {
    infer_node_struct_name(node_body(arm))
}

fn infer_arm_type(arm: Int) -> Int {
    let body = node_body(arm)
    if body == -1 {
        return CT_VOID
    }
    let kind = node_kind(body)
    if kind == NodeKind.Block {
        // A block tail that is a pattern-bound identifier (Some(v) => { v }) is
        // not yet in scope at inference time, so infer_block_type's get_var_type
        // lookup defaults to CT_INT — wrong for non-Int payloads. Resolve the
        // tail against the arm pattern FIRST, matching the bare-arm precedence
        // below; fall back to infer_block_type only when the pattern can't.
        let tail = block_tail_expr(body)
        if tail != -1 {
            let pt = infer_arm_body_from_pattern(arm, tail)
            if pt >= 0 {
                return pt
            }
        }
        return infer_block_type(body)
    }
    if kind == NodeKind.ExprStmt {
        let inner = node_value(body)
        let inner_type = infer_arm_body_from_pattern(arm, inner)
        if inner_type >= 0 {
            return inner_type
        }
        return infer_expr_type(inner)
    }
    let pat_type = infer_arm_body_from_pattern(arm, body)
    if pat_type >= 0 {
        return pat_type
    }
    infer_expr_type(body)
}

fn infer_arm_body_from_pattern(arm: Int, body_node: Int) -> Int {
    if node_kind(body_node) != NodeKind.Ident {
        return -1
    }
    let body_name = node_name(body_node)
    let pat = node_pattern(arm)
    if pat == -1 || node_kind(pat) != NodeKind.EnumPattern {
        return -1
    }
    let binding_name = infer_enum_pattern_binding(pat)
    let enum_name = node_name(pat)
    if binding_name == body_name {
        if enum_name == "Some" {
            return expr_option_inner
        } else if enum_name == "Ok" {
            return expr_result_ok_type
        } else if enum_name == "Err" {
            return expr_result_err_type
        }
    }
    let variant_name = node_type_name(pat)
    let mut resolved_enum = enum_name
    let mut resolved_variant = variant_name
    if variant_name == "" {
        resolved_variant = enum_name
        resolved_enum = resolve_variant(enum_name)
    }
    if resolved_enum == "" || is_data_enum(resolved_enum) == 0 {
        return -1
    }
    let vidx = get_variant_index(resolved_enum, resolved_variant)
    if vidx < 0 {
        return -1
    }
    let flds_sl = node_fields(pat)
    if flds_sl == -1 {
        return -1
    }
    let fcount = get_variant_field_count(vidx)
    let mut fi = 0
    while fi < sublist_length(flds_sl) && fi < fcount {
        let sub = sublist_get(flds_sl, fi)
        if node_kind(sub) == NodeKind.IdentPattern {
            if node_name(sub) == body_name {
                let ft = get_variant_field_type_str(vidx, fi)
                if ft.is_some() {
                    return type_from_name(ft.unwrap())
                }
            }
        }
        fi = fi + 1
    }
    -1
}

fn infer_enum_pattern_binding(pat: Int) -> Str {
    let flds_sl = node_fields(pat)
    if flds_sl != -1 && sublist_length(flds_sl) >= 1 {
        let sub = sublist_get(flds_sl, 0)
        if node_kind(sub) == NodeKind.IdentPattern {
            return node_name(sub)
        }
    }
    ""
}

// Resolves the inner carrier element type for an expression whose value is
// Option[T] or Result[T, E]. `which` selects: 1 = inner1 (Option's T or
// Result's OK), 2 = inner2 (Result's ERR). Returns CT_VOID on failure.
fn infer_carrier_inner(node: Int, which: Int) -> Int {
    walk_carrier_receiver(node, which).type_const
}

fn infer_expr_type(node: Int) -> Int {
    if node == -1 {
        return CT_VOID
    }
    let kind = node_kind(node)
    if kind == NodeKind.IntLit { return CT_INT }
    if kind == NodeKind.FloatLit { return CT_FLOAT }
    if kind == NodeKind.BoolLit { return CT_BOOL }
    if kind == NodeKind.InterpString { return CT_STRING }
    if kind == NodeKind.ListLit { return CT_LIST }
    if kind == NodeKind.Ident {
        let iname = node_name(node)
        if iname == "None" {
            return CT_OPTION
        }
        let variant_enum = resolve_variant(iname)
        if variant_enum != "" {
            // A bare variant of a NON-transparent data enum is value-typed as a
            // struct (blink_<Enum>) so infer_block_type / emit_if_expr open their
            // struct-discovery gate for a data-enum branch. Plain
            // C-like/str-backed enums and the transparent newtype Errno stay
            // CT_INT (bare int64_t).
            if is_data_enum(variant_enum) != 0 && is_transparent_newtype(variant_enum) == 0 {
                return CT_STRUCT
            }
            return CT_INT
        }
        // This runs as a PRE-pass — emit_if_expr calls it to decide whether to open its
        // buffered carrier-discovery path at all, before either branch has been emitted — so a
        // block-local (`{ let boxed = Some(x)  boxed }`) is not in scope yet and get_var_type
        // falls through to its CT_INT default. That is the same trap infer_arm_type names for a
        // pattern binder, solved there by re-reading the arm pattern; here typecheck already
        // holds the answer on the node. Only consulted when scope has none, so an in-scope
        // variable keeps whatever the flat side says.
        if is_scope_var(iname) == 0 {
            let ident_ct = tc_tid_ct(tc_tid_resolved(tc_lookup_node_tid(node)))
            if ident_ct >= 0 {
                return ident_ct
            }
        }
        return get_var_type(iname)
    }
    if kind == NodeKind.FieldAccess {
        let fa_obj = node_obj(node)
        let fa_field = node_name(node)
        if node_kind(fa_obj) == NodeKind.Ident {
            let obj_name = node_name(fa_obj)
            if is_enum_type(obj_name) != 0 {
                return CT_INT
            }
            let stype = get_var_struct(obj_name)
            if stype != "" {
                return get_struct_field_type(stype, fa_field)
            }
        }
        return CT_VOID
    }
    if kind == NodeKind.IfExpr {
        let t = infer_block_type(node_then_body(node))
        if t != CT_VOID { return t }
        let e = node_else_body(node)
        if e != -1 { return infer_block_type(e) }
        return CT_VOID
    }
    if kind == NodeKind.Call {
        let func_node = node_left(node)
        if node_kind(func_node) == NodeKind.Ident {
            let call_name = node_name(func_node)
            if call_name == "Ok" || call_name == "Err" {
                return CT_RESULT
            }
            if call_name == "Some" {
                return CT_OPTION
            }
            return get_fn_ret(call_name)
        }
    }
    if kind == NodeKind.MethodCall {
        let mc_method = node_method(node)
        if mc_method == "concat" || mc_method == "trim" || mc_method == "replace" || mc_method == "substr" || mc_method == "to_lower" || mc_method == "to_upper" || mc_method == "strip" || mc_method == "strip_prefix" || mc_method == "strip_suffix" || mc_method == "repeat" || mc_method == "pad_left" || mc_method == "pad_right" || mc_method == "join" {
            return CT_STRING
        }
        if mc_method == "len" || mc_method == "index_of" || mc_method == "count" || mc_method == "insert" {
            return CT_INT
        }
        if mc_method == "starts_with" || mc_method == "ends_with" || mc_method == "contains" || mc_method == "is_empty" || mc_method == "has" || mc_method == "is_some" || mc_method == "is_none" || mc_method == "is_ok" || mc_method == "is_err" {
            return CT_BOOL
        }
        if mc_method == "split" || mc_method == "lines" || mc_method == "chars" || mc_method == "keys" || mc_method == "values" {
            return CT_LIST
        }
        let mc_obj = node_obj(node)
        if mc_method == "get" {
            if node_kind(mc_obj) == NodeKind.Ident {
                let obj_type = get_var_type(node_name(mc_obj))
                if obj_type == CT_MAP {
                    let vt = get_map_value_type(node_name(mc_obj))
                    if vt >= 0 { return vt }
                }
            }
        }
        if mc_method == "unwrap" || mc_method == "unwrap_or" {
            // Threads inner type for any receiver kind (Ident, Call, MethodCall,
            // IfExpr, Block) — not just the Ident path the older code covered.
            let inner = infer_carrier_inner(mc_obj, 1)
            if inner != CT_VOID { return inner }
        }
        if mc_method == "unwrap_err" {
            let err_t = infer_carrier_inner(mc_obj, 2)
            if err_t != CT_VOID { return err_t }
        }
        if mc_obj != -1 && node_kind(mc_obj) == NodeKind.Ident {
            let obj_name = node_name(mc_obj)
            let obj_struct = get_var_struct(obj_name)
            if obj_struct != "" {
                let struct_method_ret = get_fn_ret("{obj_struct}_{mc_method}")
                if struct_method_ret != CT_VOID {
                    return struct_method_ret
                }
            } else if is_scope_var(obj_name) == 0 && is_intrinsic_method(obj_name, mc_method) == 0 && is_trait_type(obj_name) == 0 && is_struct_type(obj_name) == 0 && is_enum_type(obj_name) == 0 && is_import_module_name(obj_name) != 0 {
                let resolved_method = resolve_import_alias(mc_method)
                let method_ret = get_fn_ret(resolved_method)
                if method_ret != CT_VOID {
                    return method_ret
                }
            }
        }
    }
    if kind == NodeKind.UnaryOp {
        let op = node_op(node)
        if op == "!" {
            return CT_BOOL
        }
        return infer_expr_type(node_left(node))
    }
    if kind == NodeKind.BinOp {
        let op = node_op(node)
        if op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=" || op == "&&" || op == "||" {
            return CT_BOOL
        }
        let left_t = infer_expr_type(node_left(node))
        if left_t == CT_STRING { return CT_STRING }
        if op == "+" {
            let right_t = infer_expr_type(node_right(node))
            if right_t == CT_STRING { return CT_STRING }
        }
        return left_t
    }
    CT_VOID
}

// ── Statement codegen ───────────────────────────────────────────────

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_stmt(node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let kind = node_kind(node)

    if kind == NodeKind.ExprStmt {
        emit_expr(node_value(node))
        let s = expr_result_str
        if s != "" && s != "0" {
            emit_line("(void){s};")
        }
        return
    }

    if kind == NodeKind.LetBinding {
        emit_let_binding(node)
        return
    }

    if kind == NodeKind.Assignment {
        let assign_target_node = node_target(node)
        emit_expr(assign_target_node)
        let target_str = expr_result_str
        // Thread the reassigned var's name so a bare compound RHS (`r = Err(3)`,
        // `o = None`) adopts the target's declared carrier — a statement-level
        // reassignment has no RHS annotation node, so the ctors would otherwise mint
        // a scalar carrier (blink_Result_int_int) that C rejects against the target's
        // structured type (blink_Result_Map_str_int_int / blink_Option_P). Only for an
        // Ident target whose scope var is a compound; cleared right after the RHS.
        let saved_assign_target = cg_assign_target_name
        if node_kind(assign_target_node) == NodeKind.Ident {
            cg_assign_target_name = node_name(assign_target_node)
        }
        let rhs_node = node_value(node)
        emit_expr(rhs_node)
        cg_assign_target_name = saved_assign_target
        let val_str = expr_result_str
        let val_type = expr_result_type
        // The plain-assignment twin of emit_let_binding's Void
        // placeholder rule -- `m = nothing()` reassigning a genuine
        // Void-typed var has a `void`-valued RHS in C. The target already holds
        // the int64_t placeholder from its own `let`, and Void has exactly one
        // value, so there is nothing to write back; only the RHS's side effect
        // (the call itself) needs to survive. Same two-signal guard as emit_let_binding's.
        if rhs_is_genuine_void(val_type, rhs_node) != 0 {
            // Same empty-val_str guard as emit_let_binding's twin branch --
            // a Void-returning builtin already emitted its own statement(s)
            // and left val_str=="".
            if val_str != "" && val_str != "0" {
                emit_line("(void){val_str};")
            }
        } else {
            emit_line("{target_str} = {val_str};")
        }
        if node_kind(assign_target_node) == NodeKind.Ident {
            let var_name = node_name(assign_target_node)
            // Assignment twin of emit_let_binding's Ident-target map-meta stamp --
            // an Assignment's target has no type annotation node (node_target is
            // the LHS ident, not an ann), so this always takes
            // carry_map_binding_meta's no-annotation branch and carries the RHS
            // map's value struct across. Without this the target keeps whatever
            // meta it had before the reassignment (or the CT_INT floor if never
            // stamped), erasing a struct-instance Map value.
            if val_type == CT_MAP && expr_map_key_type >= 0 {
                apply_map_binding_meta(var_name)
            }
            if val_type == CT_MAP {
                let assign_val_orig_name = if node_kind(rhs_node) == NodeKind.Ident { node_name(rhs_node) } else { "" }
                carry_map_binding_meta(val_str, assign_val_orig_name, var_name, -1)
            }
            emit_trace_state(var_name, "assign", target_str, val_type)
        }
        return
    }

    if kind == NodeKind.CompoundAssign {
        let assign_target_node = node_target(node)
        emit_expr(assign_target_node)
        let target_str = expr_result_str
        let target_type = expr_result_type
        let ca_rhs_node = node_value(node)
        emit_expr(ca_rhs_node)
        let val_str = expr_result_str
        let val_type = expr_result_type
        let op = node_op(node)
        // Same two-signal guard as the Assignment arm above -- `m += nothing()`
        // has a `void`-valued RHS in C; there is nothing to compound-assign,
        // only the RHS's side effect survives.
        if rhs_is_genuine_void(val_type, ca_rhs_node) != 0 {
            if val_str != "" && val_str != "0" {
                emit_line("(void){val_str};")
            }
        } else {
            emit_line("{target_str} {op}= {val_str};")
        }
        if node_kind(assign_target_node) == NodeKind.Ident {
            emit_trace_state(node_name(assign_target_node), "assign", target_str, target_type)
        }
        return
    }

    if kind == NodeKind.Return {
        if node_value(node) != -1 {
            emit_expr(node_value(node))
            emit_return_with_trace(expr_result_str, cg_current_fn_ret, node_value(node))
        } else {
            emit_trace_exit_void()
            emit_line("return;")
        }
        return
    }

    if kind == NodeKind.ForIn {
        emit_for_in(node)
        return
    }

    if kind == NodeKind.WhileLoop {
        let pre_len = cg_lines.len()
        emit_expr(node_condition(node))
        let cond_str = strip_outer_parens(expr_result_str)
        let post_len = cg_lines.len()
        if post_len > pre_len {
            let mut cond_setup: List[Str] = []
            let mut ci = pre_len
            while ci < post_len {
                cond_setup.push(cg_lines.get(ci).unwrap())
                ci = ci + 1
            }
            let mut ri = post_len - 1
            while ri >= pre_len {
                cg_lines.pop()
                ri = ri - 1
            }
            emit_line("while (1) \{")
            cg_indent = cg_indent + 1
            let mut si = 0
            while si < cond_setup.len() {
                cg_lines.push(cond_setup.get(si).unwrap())
                si = si + 1
            }
            emit_line("if (!({cond_str})) break;")
            emit_block(node_body(node))
            cg_indent = cg_indent - 1
            emit_line("}")
        } else {
            emit_line("while ({cond_str}) \{")
            cg_indent = cg_indent + 1
            emit_block(node_body(node))
            cg_indent = cg_indent - 1
            emit_line("}")
        }
        return
    }

    if kind == NodeKind.LoopExpr {
        emit_line("while (1) \{")
        cg_indent = cg_indent + 1
        emit_block(node_body(node))
        cg_indent = cg_indent - 1
        emit_line("}")
        return
    }

    if kind == NodeKind.Break {
        emit_line("break;")
        return
    }

    if kind == NodeKind.Continue {
        emit_line("continue;")
        return
    }

    if kind == NodeKind.IfExpr {
        emit_if_stmt(node)
        return
    }

    if kind == NodeKind.MatchExpr {
        emit_match_expr(node)
        return
    }

    if kind == NodeKind.WithBlock {
        emit_with_block(node)
        return
    }

    if kind == NodeKind.AssertPanics {
        emit_assert_panics(node)
        return
    }

    // Fallback: treat as expression
    emit_expr(node)
    let s = expr_result_str
    if s != "" {
        emit_line("{s};")
    }
}

// Emit an `assert_panics { ... }` block (spec §2.20). Arms the thread-local
// catch frame, emits the body inline so in-body `with` setup can push onto the
// cleanup-stack, and lands E0831 (body returned) / E0832 (message mismatch).
@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_assert_panics(node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    cg_assert_panics_counter = cg_assert_panics_counter + 1
    let n = cg_assert_panics_counter
    let body = node_body(node)
    let match_node = node_value(node)
    let file = panic_file_for(node)
    let line = node_line(node)
    let col = node_col(node)
    let mark_var = "__ap_mark_{n}"

    // Evaluate the matching substring (if any) BEFORE arming, so its own
    // evaluation can never be caught by this frame.
    let mut match_c = ""
    if match_node != -1 {
        emit_expr(match_node)
        match_c = expr_result_str
    }

    emit_line("\{")
    cg_indent = cg_indent + 1
    emit_line("__blink_panic_armed++;")
    emit_line("size_t {mark_var} = __blink_cleanup_depth();")
    emit_line("size_t __ap_prev_mark_{n} = __blink_panic_cleanup_mark;")
    emit_line("__blink_panic_cleanup_mark = {mark_var};")
    emit_line("if (setjmp(__blink_panic_jmp) == 0) \{")
    cg_indent = cg_indent + 1

    let prev_in_ap = cg_in_assert_panics
    cg_in_assert_panics = n
    emit_block(body)
    cg_in_assert_panics = prev_in_ap

    // Fall-through (body returned normally) and the `?`-Err `goto` both land
    // here: the body exited WITHOUT panicking → E0831. Disarm + restore the
    // mark at the label so both entry paths run them. The dead `if (0) goto`
    // keeps the label "used" when the body has no `?` (silences -Wunused-label).
    emit_line("if (0) goto __ap_returned_{n};")
    emit_line("__ap_returned_{n}: ;")
    emit_line("__blink_panic_armed--;")
    emit_line("__blink_panic_cleanup_mark = __ap_prev_mark_{n};")
    emit_line("__blink_assert_panics_returned(\"{file}\", {line}, {col});")
    cg_indent = cg_indent - 1
    emit_line("} else \{")
    cg_indent = cg_indent + 1
    // Caught path: dispatch already ran the in-body cleanup down to the mark.
    emit_line("__blink_panic_armed--;")
    emit_line("__blink_panic_cleanup_mark = __ap_prev_mark_{n};")
    if match_node != -1 {
        emit_line("if (!strstr(__blink_panic_msg, {match_c})) \{")
        cg_indent = cg_indent + 1
        emit_line("__blink_assert_panics_mismatch({match_c}, __blink_panic_msg, \"{file}\", {line}, {col});")
        cg_indent = cg_indent - 1
        emit_line("}")
    }
    // pass: the expected panic was consumed; test status stays "passed".
    cg_indent = cg_indent - 1
    emit_line("}")
    cg_indent = cg_indent - 1
    emit_line("}")
}

fn infer_enum_from_node(val_node: Int) -> Str {
    let vk = node_kind(val_node)
    if vk == NodeKind.FieldAccess {
        let obj = node_obj(val_node)
        if node_kind(obj) == NodeKind.Ident {
            let obj_name = node_name(obj)
            if is_enum_type(obj_name) != 0 {
                return obj_name
            }
        }
    }
    if vk == NodeKind.Ident {
        return resolve_variant(node_name(val_node))
    }
    if vk == NodeKind.Call {
        let func = node_left(val_node)
        if node_kind(func) == NodeKind.Ident {
            let fn_name = node_name(func)
            // A CALL resolves to a builtin before a variant, matching typecheck's
            // order in infer_type. Without this, a module declaring a
            // payload-less variant named `Map` typed every `Map()` local as that
            // enum, which made an empty Map unconstructible there — `Map()` is the
            // only way to build one. The bare-Ident arm above stays unguarded: with
            // no parens, `Map` genuinely is the variant.
            if is_builtin_fn(fn_name) == 0 {
                let resolved = resolve_variant(fn_name)
                if resolved != "" {
                    return resolved
                }
            }
        }
    }
    if vk == NodeKind.MethodCall {
        let mc_obj = node_obj(val_node)
        if node_kind(mc_obj) == NodeKind.Ident {
            let mc_name = node_name(mc_obj)
            if is_enum_type(mc_name) != 0 {
                return mc_name
            }
            // `let o = x.cmp(y)` yields Ordering when x derives Ord
            // (or has a user Ord impl). The receiver var carries its struct/enum
            // name in the codegen scope; cmp on such a receiver returns Ordering.
            if node_name_is_cmp_on_ord(val_node) != 0 {
                return "Ordering"
            }
        }
    }
    ""
}

// Is `val_node` a `.cmp(...)` call on a receiver whose type derives
// Ord (struct or enum)? Used to tag the result of `let o = a.cmp(b)`.
fn node_name_is_cmp_on_ord(val_node: Int) -> Int {
    if node_method(val_node) != "cmp" { return 0 }
    let mc_obj = node_obj(val_node)
    let recv = node_name(mc_obj)
    let rs = get_var_struct(recv)
    if rs != "" && has_derive_method(rs, "cmp") != 0 { return 1 }
    let re = get_var_enum(recv)
    if re != "" && has_derive_method(re, "cmp") != 0 { return 1 }
    0
}

fn emit_tuple_destructure(pat_node: Int, source_var: Str, struct_name: Str, is_mut: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope {
    let elems_sl = node_elements(pat_node)
    if elems_sl == -1 { return }
    let mut di = 0
    while di < sublist_length(elems_sl) {
        let sub_pat = sublist_get(elems_sl, di)
        if node_kind(sub_pat) == NodeKind.WildcardPattern {
            di = di + 1
            continue
        }
        let elem_name = node_name(sub_pat)
        let field_name = "_{di}"
        let ft = get_struct_field_type(struct_name, field_name)
        let fs = get_struct_field_stype(struct_name, field_name)
        let c_elem = c_safe_name(elem_name)
        if fs != "" {
            emit_line("{c_type_c_name(fs)} {c_elem} = {source_var}.{field_name};")
            // Tid first, tag second — same argument as the match-arm binder above: for a Map
            // element `fs` holds a COMPOUND TAG rather than a struct name, and the two-tag chain
            // below would register the binder as a struct called `Map_str_int`.
            if !stamp_binder_from_tid(sub_pat, elem_name, is_mut) {
                if fs.starts_with("Option_") {
                    set_var(elem_name, CT_OPTION, is_mut)
                    set_var_option_from_struct_tag(elem_name, fs)
                } else if fs.starts_with("Result_") {
                    set_var(elem_name, CT_RESULT, is_mut)
                    set_var_result_from_struct_tag(elem_name, fs)
                } else {
                    set_var(elem_name, CT_VOID, is_mut)
                    set_var_struct(c_elem, fs)
                }
            }
        } else {
            // Mirror emit_tuple_typedef's own scalar branch -- a genuine Void
            // tuple element read (`let (_, v) = t` where v: Void) must lower
            // through c_field_type_str, not bare c_type_str, or this emits
            // `void v = t._1;`. Reachable from both `let (a,b) = tup` and
            // `for (a,b) in list_of_tuples` (both route through this fn).
            let elem_nm = tuple_elem_name(struct_name, di)
            emit_line("{c_field_type_str(ft, elem_nm)} {c_elem} = {source_var}.{field_name};")
            // A container element arrives here with its own CT intact and its ELEMENT gone, which
            // reaches the user as a wrong value rather than as a diagnostic — `List[Str]` reads
            // its `const char*` slot as `int64_t`.
            if !stamp_binder_from_tid(sub_pat, elem_name, is_mut) {
                set_var(elem_name, ft, is_mut)
            }
        }
        // This one function is the whole family: both `let (a, b) = t` and
        // `for (k, v) in <iterable>` route here, so a tap here is not a copy
        // of the match-arm tap even though both measure a pattern binder. The
        // two paths differ in what they can report — typecheck decomposes a
        // for-in tuple pattern and publishes each leaf's type, but does NOT
        // decompose a LetBinding one, so a `let` destructure lands in the
        // `missing` bucket. The tap must not paper over that asymmetry by
        // re-deriving the element from `struct_name`.
        pat_measure_at(elem_name, sub_pat, "tuple_destructure.elem")
        di = di + 1
    }
}

// Stamp a Map let-binding target `name` with the current expr_map_* carrier meta,
// then clear those globals so they can't leak into the next binding. A generic-
// struct-INSTANCE Map value (Map[Str, Box[Int]] through a bare-typevar generic-fn
// return) carries its value struct in expr_map_val_struct so name.get(k) returns
// Option[Box_Int] instead of Option_int. Shared by emit_let_binding and
// emit_top_level_let.
fn apply_map_binding_meta(name: Str) {
    set_map_types(name, expr_map_key_type, expr_map_val_type, expr_map_val_struct)
    if expr_map_val_struct != "" { set_map_value_struct(name, expr_map_val_struct) }
    if expr_map_key_struct != "" { set_map_key_struct(name, expr_map_key_struct) }
    expr_map_key_type = -1
    expr_map_val_type = -1
    expr_map_val_struct = ""
    expr_map_key_struct = ""
}

// With no explicit annotation, carry the RHS map's scalar key+value
// across (e.g. recovered through List[Map[K,V]].get().unwrap()) so
// `name.get(k)` returns Option[V] (not Option[Int]) and boxes the key per
// its real type. Only adopt the RHS key/value when genuinely recovered (raw
// >= 0); a generic-fn call's return is never a registered ScopeVar, so a
// miss falls back to `name`'s own value if it's scalar, else the CT_INT
// floor every unstamped map already reads. Shared by emit_let_binding and
// emit_top_level_let.
// AL1-sibling (A1): a closure-captured Map alias (`let alias = m` where `m` is
// captured) lowers val_str to a capture-read C expression that matches
// neither scope_vars nor closure_captures by name, so the raw lookups below
// always miss and use_val falls to the CT_INT floor. val_orig_name is the
// RHS's own Blink-level identifier (empty when the RHS isn't a bare Ident) —
// closure_captures is keyed on that original name, so it recovers what
// val_str's lowered text cannot.
fn carry_map_binding_meta(val_str: Str, val_orig_name: Str, name: Str, type_ann: Int) {
    copy_map_value_meta(val_str, name)
    if type_ann == -1 {
        let mut src_val_raw = get_map_value_type_raw(val_str)
        if src_val_raw < 0 && val_orig_name != "" { src_val_raw = get_map_value_type_raw(val_orig_name) }
        let use_val = if src_val_raw >= 0 {
            src_val_raw
        } else {
            let own_val_raw = get_map_value_type_raw(name)
            if is_map_scalar_ct(own_val_raw) != 0 { own_val_raw } else { CT_INT }
        }
        if is_map_scalar_ct(use_val) != 0 {
            let mut src_key_raw = get_map_key_type_raw(val_str)
            if src_key_raw < 0 && val_orig_name != "" { src_key_raw = get_map_key_type_raw(val_orig_name) }
            let use_key = if src_key_raw >= 0 { src_key_raw } else { get_map_key_type(name) }
            set_map_types(name, use_key, use_val, "")
        }
    }
}

// The tid for a `let`. The LET NODE is the authority: typecheck publishes its own
// `final_tid` there (declared annotation, else inferred initializer — see its LetBinding
// arm), so codegen reads one answer instead of re-deriving the choice.
//
// The two fallbacks are measurement scaffolding, not a second opinion. They exist so a let
// that typecheck left UNKNOWN still reports a comparable shape rather than a blanket
// Missing, which would make the Stage 2 cell map read as "codegen never stamped anything"
// where the truth is "typecheck had no answer either".
//
// The initializer fallback was the WEAKEST of the three because `let m: Map[Str, List[Int]]
// = Map()` left the ctor at `Map[α, β]` with both metavars unbound — the declared type was
// compared against the initializer and never unified into it. For a Map/Set head, the
// LetBinding arm now pins a builtin container ctor too, not just a generic fn call, so for
// those the ordering below is no longer compensating for a typecheck bug. It still is for
// the shapes that pin deliberately refuses — a declared type carrying a bare typevar or a
// transparent alias, and the struct/enum heads that stayed mint-gated — so treat the
// fallback as live, not vestigial. Keep the ordering regardless: the let node is the only
// source that carries the BINDING's type, and for an unannotated `let` the initializer is
// the same tid by construction. One known case reaches the fallback with nothing to offer —
// a `let` inside a block expression in CALL-ARGUMENT position is never walked by the
// LetBinding arm at all, so neither the let node nor the annotation carries a tid and the
// ctor keeps its metavars.
fn let_binding_tid(node: Int, type_ann: Int, val_node: Int) -> Int {
    let own = tc_lookup_node_tid(node)
    if own >= 0 { return own }
    if type_ann != -1 {
        let ann_tid = tc_lookup_node_tid(type_ann)
        if ann_tid >= 0 { return ann_tid }
    }
    if val_node != -1 { return tc_lookup_node_tid(val_node) }
    -1
}

// The C typedef of a unit-only enum local, spelled from the tid — "" when the tid
// cannot improve on what the flat path already prints.
//
// `infer_enum_from_node` recognises an enum by looking at the RHS *syntax* (a variant
// construction, a field read), so it goes blank the moment the value arrives through a plain
// call or an anonymous C temporary — and the declaration then falls to `c_type_str(CT_ENUM)`,
// which is `int64_t`. The tid knows the type in every one of those positions.
//
// One decline, load-bearing: a TRANSPARENT NEWTYPE spells `int64_t`, which is what
// the flat path already prints, so declining on equality leaves that decision exactly where it is.
//
// A generic enum INSTANCE also answers here — c_type_from_tid spells `blink_Tree_0Int` for an
// instance, not just a bare enum, mirroring the per-instantiation spelling the `enum_mono` arm
// above uses. That does not change which arm wins: this helper is only consulted from the arm
// ORDERED AFTER the enum/enum_mono one, and that arm leads with enum_instance_c_from_tid, which
// is the same answer reached one branch earlier.
fn enum_c_from_tid(tid: Int) -> Str {
    if tid < 0 { return "" }
    if tc_tid_kind(tc_tid_resolved(tid)) != TyKind.Enum { return "" }
    let c = c_type_from_tid(tid)
    if c == "int64_t" { return "" }
    c
}

// The shape that needs enum_instance_c_from_tid (typecheck.bl) here is an
// annotation-only instance whose RHS is a payload-LESS variant: `let t: ITree[Int] = INone`.
// enum_mono is derived from the RHS value's ScopeVar, and a bare variant has no mono stem to read
// there, so the args live only on the annotation's tid.

// The pointee of a `Ptr` local, spelled from the tid — "" when the tid cannot
// improve on what the flat path already prints.
//
// The decline on `void*` is deliberate and keeps this flip minimal: `void*` is exactly what
// `c_type_str(CT_PTR)` answers, so a tid that knows no more than the flat fields must not take
// authority away from them. Only a tid that carries a real pointee (`uint8_t*`, `int64_t*`,
// `blink_Pollfd*`) changes a declaration, which is what makes the emitted-C diff for this
// sub-step exactly the set of rows the ctypediv sweep named.
fn ptr_c_from_tid(tid: Int) -> Str {
    if tid < 0 { return "" }
    if tc_tid_kind(tc_tid_resolved(tid)) != TyKind.Ptr { return "" }
    let c = c_type_from_tid(tid)
    if c == "void*" { return "" }
    c
}

// The vtable type of a handler binding, spelled from the tid — "" when the tid does not
// name a handler, or names an effect that resolves to no vtable.
//
// There is no equality decline here, unlike ptr_c_from_tid's `void*` and enum_c_from_tid's
// `int64_t`, and the difference is what this helper is for: those two guard against a tid that
// knows no more than the flat fields, but the flat path cannot spell a vtable type AT ALL unless it
// already took the CT_HANDLER arm — and that arm is ordered before this one, so a binding reaching
// here has no flat answer to protect. Every non-"" answer is a binding that would otherwise have
// been declared from an ERASED CT (`int64_t`, from a container element).
fn handler_c_from_tid(tid: Int) -> Str {
    if tid < 0 { return "" }
    let r = tc_tid_resolved(tid)
    if tc_tid_kind(r) != TyKind.Handler { return "" }
    c_type_from_tid(r)
}

// The CT of a sized-integer local, read from the tid — `-1` when the tid does not name
// one of the seven.
//
// This one returns a CT and not a C string, and that difference is the whole point. The other two
// helpers here correct a DECLARATION; a sized integer's type governs three more things that read
// the recorded CT instead of the emitted spelling:
//
//   - whether `/`, `<` and `>` are the signed or the unsigned operator;
//   - whether `+` emits the overflow TRAP the spec promises for sized ints
//     ("Arithmetic on sized ints traps on overflow") or plain 64-bit arithmetic;
//   - whether `.wrapping_add` and the other modular escape hatches resolve at all.
//
// So the answer is fed back into `val_type` before `set_var`, upstream of every one of them,
// rather than into the declaration chain below.
fn sized_int_ct_from_tid(tid: Int) -> Int {
    if tid < 0 { return -1 }
    match tc_tid_kind(tc_tid_resolved(tid)) {
        TyKind.I8 => CT_I8
        TyKind.I16 => CT_I16
        TyKind.I32 => CT_I32
        TyKind.U8 => CT_U8
        TyKind.U16 => CT_U16
        TyKind.U32 => CT_U32
        TyKind.U64 => CT_U64
        _ => -1
    }
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_let_binding(node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let val_node = node_value(node)
    let mut enum_type = infer_enum_from_node(val_node)
    let type_ann = node_target(node)
    if enum_type == "" && type_ann != -1 {
        let ann_name = node_name(type_ann)
        if is_enum_type(ann_name) != 0 {
            enum_type = ann_name
        }
    }
    let saved_let_target = cg_let_target_type
    let saved_let_target_name = cg_let_target_name
    let saved_let_target_ann = cg_let_target_ann
    // A let-RHS is a fresh value context described by cg_let_target_ann; an
    // outer call's cg_expect_arg_ann must not leak in (a block-expr let-RHS
    // inside a call arg would otherwise inherit the OUTER param annotation and
    // mis-select e.g. a Set()/Map() kops table).
    let saved_expect_arg_ann = cg_expect_arg_ann
    cg_expect_arg_ann = -1
    let mut ann_ct = 0
    if type_ann != -1 {
        ann_ct = type_from_name(node_name(type_ann))
        cg_let_target_type = ann_ct
        cg_let_target_name = node_name(type_ann)
        cg_let_target_ann = type_ann
        // A body-local carrier over struct instances (`let r: Result[RBox[Int],
        // RBox[Str]] = Ok(..)`) is named in no signature, so the pre-fn pass never
        // registered its leaves; a leaf appearing in no RHS literal (the RBox[Str]
        // err arm above) is otherwise never registered at all and erases to `void`.
        // Register the carrier's struct-instance leaves from the annotation tid
        // before the RHS emits the carrier typedef. No-op for a scalar
        // carrier or a non-carrier annotation (tid -1 / kind mismatch).
        register_carrier_struct_instance_leaves(tc_lookup_node_tid(type_ann))
    } else {
        cg_let_target_type = 0
        cg_let_target_name = ""
        cg_let_target_ann = -1
    }
    // This clear is a BUG FIX rather than tidying — the same fix made on
    // the `with` operand, for the same reason and one statement kind later. The three
    // cg_handler_* globals are set only by a handler CONSTRUCTION, and the CT_HANDLER block below
    // read them without clearing first, so a binding whose RHS constructs nothing inherited
    // whatever the last handler expression anywhere earlier in the function had left behind.
    // Clearing here is what makes the channel mean "what THIS RHS set".
    cg_handler_vtable_type = ""
    cg_handler_vtable_field = ""
    cg_handler_is_user_effect = 0
    emit_expr(val_node)
    cg_let_target_type = saved_let_target
    cg_let_target_name = saved_let_target_name
    cg_let_target_ann = saved_let_target_ann
    cg_expect_arg_ann = saved_expect_arg_ann
    let val_str = expr_result_str
    let mut val_type = expr_result_type
    if val_type == CT_RESULT {
        enum_type = ""
    }
    // A generic-enum construction (`let t = Branch(…)` → Tree[Int]) mono's the RHS to
    // blink_Tree_Int and tracks that mono STEM on the value string. enum_type stays the
    // BARE base (`Tree`) so var_enums / match variant lookups keep working; enum_mono is
    // the mono name (or "") used only for the LHS C declaration type, so the var is
    // declared blink_Tree_Int instead of the erased bare blink_Tree.
    let mut enum_mono = ""
    if enum_type != "" && val_type == CT_STRUCT {
        let mono_s = get_var_struct(val_str)
        if mono_s != "" && strip_module_qualifier(mono_s) != strip_module_qualifier(enum_type) && is_mono_struct_instance(mono_s) != 0 {
            enum_mono = mono_s
        }
    }
    // A transparent newtype lowers to a bare int64_t even as a
    // standalone binding — `let e = Errno(5)` is `int64_t e = 5`, not the boxed
    // struct. Clear the inferred enum_type so the var is declared as Int,
    // matching the construction (CT_INT) and the identity match-binding.
    if enum_type != "" && is_transparent_newtype(enum_type) != 0 {
        enum_type = ""
        val_type = CT_INT
    }
    if val_type == CT_INT && (ann_ct == CT_I8 || ann_ct == CT_I16 || ann_ct == CT_I32 || ann_ct == CT_U8 || ann_ct == CT_U16 || ann_ct == CT_U32 || ann_ct == CT_U64) {
        val_type = ann_ct
    }
    // The other direction of the same rule — the ANNOTATION governs an integer local's
    // declaration — which had nothing to reach until `deref()` started answering the pointee's
    // own CT. `let n: Int = p.deref()` on a `Ptr[U8]` otherwise declares `n` as
    // `uint8_t` under an `Int` annotation, taking the local's arithmetic (signedness, the
    // overflow trap, `.wrapping_*`) with it. typecheck records that local at the ANNOTATION's
    // Int, so the tid and the emitted C would disagree without this fix.
    //
    // typecheck signs `.deref()` as the pointee T, so `let n: Int = p.deref()` on a `Ptr[U8]`
    // is already a TypeError there (like the explicit `let u: U8 = 200` then `let n: Int = u`,
    // since sized ints are nominally distinct from Int). This rule handles only the honest
    // widening path — `let n: Int = p.deref().to_int()` — where the annotation legitimately
    // governs an Int local carrying a value that arrived through a sized CT.
    if ann_ct == CT_INT && (val_type == CT_I8 || val_type == CT_I16 || val_type == CT_I32 || val_type == CT_U8 || val_type == CT_U16 || val_type == CT_U32 || val_type == CT_U64) {
        val_type = CT_INT
    }
    // The tid twin of the annotation rule directly above, for the case that rule
    // cannot reach: a binding with NO annotation. `expr_result_type` is CT_INT whenever the value
    // arrives through an anonymous carrier temp (`l.get(0).unwrap()`, `m.get(k).unwrap()`,
    // `r.unwrap()`), because those carriers are spelled with the Int member and nothing stamps the
    // sized type back onto the temp. The local then loses signedness, the overflow trap and its
    // modular methods all at once — `255 + 1` on an erased U8 answers 256 where the annotated
    // form panics, which is a promise of the spec silently withdrawn.
    //
    // Substituted through the enclosing monomorphisation first, like every other tid consumer in
    // codegen: a `U64` bound to a typevar `K` inside a mono'd generic fn would otherwise have an
    // unsubstituted read see `K` and decline exactly there.
    let binding_tid = let_binding_tid(node, type_ann, val_node)
    if val_type == CT_INT && type_ann == -1 {
        let sized_ct = sized_int_ct_from_tid(tc_tid_subst_mono(binding_tid, cg_mono_tparams_sl, cg_mono_arg_tids))
        if sized_ct != -1 {
            val_type = sized_ct
        }
    }
    let mut name = node_name(node)
    if name == "_destructure" {
        name = fresh_temp("_destr")
    }
    if name == "_" {
        name = fresh_temp("_unused")
    }
    let is_mut = node_is_mut(node)
    set_var(name, val_type, is_mut)
    // Stage 2: stamp typecheck's tid at the earliest possible point, immediately after the
    // binding exists and BEFORE the ~40 set_var_* refinements below. Any later and the
    // refinements would be measured against an unstamped var, so every read would report
    // Missing and the instrument would measure its own late arrival. The refinements carry
    // `ty` across untouched by design (src/codegen_types.bl ScopeVar.ty).
    set_var_ty(name, binding_tid)
    if enum_type != "" {
        var_enums.push(VarEnumEntry { name: name, enum_type: enum_type })
    }
    if val_type == CT_PTR && type_ann != -1 {
        let pelems_ann = node_elements(type_ann)
        if pelems_ann != -1 && sublist_length(pelems_ann) > 0 {
            let inner_ann_name = node_name(sublist_get(pelems_ann, 0))
            let inner_td = find_type_def_node(inner_ann_name)
            if inner_td != -1 && has_annotation(inner_td, "ffi.struct") != 0 {
                let is_array = if ffi_alloc_n_pending != 0 { 1 } else { 0 }
                set_var_ffi_ptr_extra(name, inner_ann_name, is_array)
            }
        }
    }
    if val_type == CT_PTR && ffi_offset_pending_struct != "" {
        set_var_ffi_ptr_extra(name, ffi_offset_pending_struct, 1)
    }
    ffi_alloc_n_pending = 0
    if val_type == CT_HANDLER {
        let mut h_vtt = cg_handler_vtable_type
        let mut h_vtf = cg_handler_vtable_field
        let mut h_is_ue = cg_handler_is_user_effect
        if h_vtf == "" && type_ann != -1 {
            let ann_name = node_name(type_ann)
            if ann_name == "Handler" {
                let ann_elems = node_elements(type_ann)
                if ann_elems != -1 && sublist_length(ann_elems) >= 1 {
                    let effect_ann = sublist_get(ann_elems, 0)
                    let effect_name = node_name(effect_ann)
                    h_vtt = resolve_effect_vtable(effect_name)
                    h_vtf = resolve_effect_field(effect_name)
                    h_is_ue = resolve_effect_is_ue(effect_name)
                }
            }
        }
        // Ordered LAST: the construction global above owns every binding whose RHS built the
        // handler, the annotation owns the ones that name their effect, and this only catches
        // what both left blank — a handler read out of a container (`hs.get(0).unwrap()`),
        // which constructs nothing and is rarely annotated.
        //
        // Once `.get` carries a CT_HANDLER result instead of CT_INT, a container read reaches
        // this block instead of skipping it, and without this arm it would be registered with
        // an EMPTY vtable field — which is not a spelling problem but a dispatch one:
        // `get_var_handler_vtable_field` is what the `with` operand asks first.
        if h_vtf == "" {
            let h_eff = tc_tid_handler_effect(tc_tid_resolved(tc_tid_subst_mono(binding_tid, cg_mono_tparams_sl, cg_mono_arg_tids)))
            if h_eff != "" {
                h_vtt = resolve_effect_vtable(h_eff)
                h_vtf = resolve_effect_field(h_eff)
                h_is_ue = resolve_effect_is_ue(h_eff)
            }
        }
        set_var_handler(name, h_vtt, h_vtf, h_is_ue)
        cg_handler_vtable_type = ""
        cg_handler_vtable_field = ""
        cg_handler_is_user_effect = 0
    }
    if val_type == CT_CLOSURE {
        // Ordered the same way as the handler arm above: `expr_closure_sig` owns
        // every binding whose RHS or annotation spelled a `fn(..) -> ..` node, and the tid only
        // fills in where both left it blank — a closure read out of a container
        // (`fs.get(0).unwrap()`), returned from a plain fn (`let h = mk()`), or unwrapped from an
        // Option. Those bindings were DECLARED correctly (`blink_closure* h = ..`) and registered
        // with an EMPTY sig, which is not a spelling problem but a dispatch one: an empty sig is
        // exactly what `get_var_closure_sig` returns for a name that is not a closure at all, so
        // the call site read the binding as an unknown FUNCTION and reported UndefinedFunction
        // against a variable the type checker had fully typed.
        let cls_tid = tc_tid_subst_mono(binding_tid, cg_mono_tparams_sl, cg_mono_arg_tids)
        let mut cls_sig = expr_closure_sig
        if cls_sig == "" {
            cls_sig = closure_sig_from_tid(cls_tid)
        }
        set_var_closure(name, cls_sig, cls_tid)
    }
    if val_type == CT_OPTION {
        let mut opt_inner_ct = expr_option_inner
        let mut opt_inner_s = expr_option_inner_struct
        if type_ann != -1 {
            let ann_name = node_name(type_ann)
            if ann_name == "Option" {
                let ann_elems = node_elements(type_ann)
                if ann_elems != -1 && sublist_length(ann_elems) >= 1 {
                    let inner_ann = sublist_get(ann_elems, 0)
                    let inner_name = node_name(inner_ann)
                    let inner_ct = type_from_name(inner_name)
                    if is_struct_type(inner_name) != 0 || is_enum_type(inner_name) != 0 {
                        // A generic struct INSTANCE inner (Option[Box[Int]]) must
                        // carry its recursive mono stem (Box_Int), not the erased
                        // bare head (Box) — otherwise the option carrier embeds a
                        // never-typedef'd blink_Box*. Prefer the RHS-provided
                        // struct (expr_option_inner_struct, already the fully-recursive
                        // Box_Box_Int from the emitted Some payload) exactly as the
                        // Result path prefers expr_result_ok_struct; only fall to the
                        // annotation's one-level mono_name_from_ann when the RHS gave
                        // nothing. Mirror resolve_ann_tag's fallback for the bare case.
                        if opt_inner_s == "" {
                            let mono = mono_name_from_ann(strip_module_qualifier(inner_name), inner_ann, -1, [])
                            opt_inner_s = if mono != "" { mono } else { inner_name }
                        }
                        // Register the mono INSTANCE (QBox_Int) so the Option
                        // carrier typedef's value member resolves to blink_QBox_Int (not
                        // void*) when the carrier flush runs. Registration is idempotent
                        // (dedups on phys_base+args); a bare struct / typevar is a no-op.
                        let _reg = register_carrier_inner_mono_instance(inner_name, inner_ann)
                        opt_inner_ct = inner_ct
                    } else if is_compound_ct(inner_ct) != 0 || inner_name == "Tuple" {
                        opt_inner_s = compound_name_from_ann(inner_ann)
                        opt_inner_ct = inner_ct
                    } else {
                        opt_inner_ct = inner_ct
                        opt_inner_s = ""
                    }
                }
            }
        }
        if opt_inner_s != "" {
            set_var_option_struct(name, opt_inner_ct, opt_inner_s)
            ensure_struct_option_type(opt_inner_s)
        } else {
            set_var_option(name, opt_inner_ct)
            ensure_option_type(opt_inner_ct)
        }
        set_var_option_erased(name, expr_option_erased)
        if expr_option_inner == CT_LIST && expr_option_inner_list_elem != -1 {
            set_var_option_inner2(name, expr_option_inner_list_elem)
            expr_option_inner_list_elem = -1
            expr_option_inner_list_struct = ""
        }
        if expr_option_inner == CT_MAP {
            if expr_option_inner_map_val_list_elem >= 0 {
                set_var_option_inner2(name, expr_option_inner_map_val_list_elem)
                expr_option_inner_map_val_list_elem = -1
            }
            expr_option_inner_map_val_struct = ""
        }
        // A CT_SET inner carries its own element on the RHS temp's flat
        // inner2 channel (stamped directly by the .get()/.pop() CT_SET arms, never
        // through the CT_LIST-only expr_option_inner_list_elem global). Copy it
        // straight off val_str rather than adding a parallel global, so
        // `let o = d.get(0)` doesn't lose the element.
        if expr_option_inner == CT_SET {
            let set_nested = get_var_option_inner2(val_str)
            if set_nested != -1 {
                set_var_option_inner2(name, set_nested)
            }
        }
        // Preserve a DIRECT Option[container]'s deep inner tp across the
        // let-binding (the flat set_var_option_struct rebind above drops a Map's V /
        // a List's element). Only for a Map/List inner — an Option[Option[..]] or
        // Option[Result[..]] keeps its carrier-tag flat storage, which the later
        // unwrap round-trips losslessly (`Option_Map_int_str`); re-stamping those
        // through a bare inner tp would erase the inner carrier's struct name.
        //
        // Source the deep tp ONLY from the RHS var's own stored tp_id
        // (get_var_option_inner_tp) — never the transient expr_option_inner_tp
        // global, which producers that aren't a List[compound] readback leave stale
        // and would corrupt an unrelated `let o = f()`. The RHS temp reliably
        // carries its deep tp: .get()/.pop() stamp `Option[Option[container]]` and
        // .unwrap() re-stamps the peeled result. Copy ANY container inner
        // (Map/List/Result/Option/Set) so a doubly-nested `let x = pairs.get(0)`
        // (Option[Option[List]]) also round-trips.
        let rhs_deep = get_var_option_inner_tp(val_str)
        if rhs_deep >= 0 {
            set_var_option_inner_tp(name, rhs_deep)
        } else if type_ann != -1 && node_name(type_ann) == "Option" {
            // A CONSTRUCTED `let x: Option[Option[List[Int]]] =
            // Some(Some(inner))` has no RHS var to source the deep tp from — the
            // Some(Some(..)) temp carries none — so the flat set_var_option_struct
            // above collapses x to Option[Option[Int]]. When the annotation itself
            // spells the full depth AND the inner is a container (matching
            // get_var_option_inner_tp's own guard), rebuild the deep inner tp
            // losslessly from the annotation via deep_tp_from_ann.
            let ann_elems = node_elements(type_ann)
            if ann_elems != -1 && sublist_length(ann_elems) >= 1 {
                let inner_ann = sublist_get(ann_elems, 0)
                let inner_deep = deep_tp_from_ann(inner_ann)
                let inner_k = tp_get_kind(inner_deep)
                if inner_k == CT_MAP || inner_k == CT_LIST || inner_k == CT_RESULT || inner_k == CT_OPTION || inner_k == CT_SET {
                    set_var_option_inner_tp(name, inner_deep)
                }
            }
        }
    }
    if val_type == CT_RESULT {
        let mut rok_t = expr_result_ok_type
        let mut rerr_t = expr_result_err_type
        let mut rok_s = expr_result_ok_struct
        let mut rerr_s = expr_result_err_struct
        if type_ann != -1 && node_name(type_ann) == "Result" {
            let ann_elems = node_elements(type_ann)
            if ann_elems != -1 && sublist_length(ann_elems) >= 2 {
                if rok_s == "" {
                    let ok_ann = sublist_get(ann_elems, 0)
                    let ok_name = node_name(ok_ann)
                    // A struct/enum or a Tuple ok side is carried by its tag as a
                    // by-value member (rok_t=CT_INT). Map/Option/List inners keep
                    // their own CT/struct from expr_result_ok_* — do NOT override
                    // them to CT_INT (that erases the Map/List element type).
                    if is_struct_type(ok_name) != 0 || is_enum_type(ok_name) != 0 {
                        let ok_mono = mono_name_from_ann(strip_module_qualifier(ok_name), ok_ann, -1, [])
                        rok_s = if ok_mono != "" { ok_mono } else { ok_name }
                        rok_t = CT_INT
                    } else if ok_name == "Tuple" {
                        let ok_tag = resolve_result_inner_tag(ok_ann, ok_name, type_from_name(ok_name))
                        if ok_tag != "" {
                            rok_s = ok_tag
                            rok_t = CT_INT
                        }
                    }
                }
                if rerr_s == "" {
                    let err_ann = sublist_get(ann_elems, 1)
                    let err_name = node_name(err_ann)
                    if is_struct_type(err_name) != 0 || is_enum_type(err_name) != 0 {
                        let err_mono = mono_name_from_ann(strip_module_qualifier(err_name), err_ann, -1, [])
                        rerr_s = if err_mono != "" { err_mono } else { err_name }
                        rerr_t = CT_INT
                    } else if err_name == "Tuple" {
                        let err_tag = resolve_result_inner_tag(err_ann, err_name, type_from_name(err_name))
                        if err_tag != "" {
                            rerr_s = err_tag
                            rerr_t = CT_INT
                        }
                    }
                }
            }
        }
        if rok_s != "" || rerr_s != "" {
            set_var_result_struct(name, rok_t, rerr_t, rok_s, rerr_s)
        } else {
            set_var_result(name, rok_t, rerr_t)
        }
    }
    if val_type == CT_HANDLE {
        let inner = get_var_handle_inner(val_str)
        let h_sname = get_var_handle_sname(val_str)
        let h_sname2 = get_var_handle_sname2(val_str)
        let h_inner2 = get_var_handle_inner2(val_str)
        if h_sname != "" || h_sname2 != "" || h_inner2 >= 0 {
            set_var_handle_full(name, if inner >= 0 { inner } else { CT_INT }, h_inner2)
        } else if inner >= 0 {
            set_var_handle(name, inner)
        } else {
            set_var_handle(name, CT_INT)
        }
    }
    if val_type == CT_CHANNEL {
        // `val_str` is the emitted C expression for the initializer
        // (`blink_channel_new(4)`), NOT a variable name, so for every CONSTRUCTED channel
        // this lookup misses and the CT_INT default below became the element type of every
        // channel in every program. The binding's own tid knows the element, so ask it
        // first; the flat lookup and its default stay for a channel with no tid to read.
        let ch_inner = get_var_channel_inner(val_str)
        let tid_inner = tc_channel_elem_ct(get_var_ty(name))
        if tid_inner >= 0 {
            set_var_channel(name, tid_inner)
        } else if ch_inner >= 0 {
            set_var_channel(name, ch_inner)
        } else {
            set_var_channel(name, CT_INT)
        }
    }
    // The generic struct-fallback propagates the RHS var's `sname` onto a
    // struct-typed binding via get_var_struct -> set_var_struct, which rebuilds
    // tp_id through the lossy 2-level sv_tp bridge. For an Option whose inner is
    // itself a CONTAINER, that RHS sname is a CARRIER TAG (`Option_list`) and the
    // rebuild re-collapses the deep tp (`Option[Option[List[Int]]]` ->
    // `Option[Option[Int]]`) that the CT_OPTION block above just restored, losing
    // the inner List's element. Skip the fallback ONLY in that narrow case
    // (get_var_option_inner_tp(name) >= 0 iff the restored inner is a container);
    // a compound over a real struct/enum inner (`Option[Status]`) has no deep
    // container tp, so the fallback still runs and legitimately stamps the inner's
    // struct name — no regression.
    let skip_struct_fallback = (val_type == CT_OPTION && get_var_option_inner_tp(name) >= 0)
    if skip_struct_fallback == 0 {
        if node_kind(val_node) == NodeKind.StructLit {
            let expr_struct = get_var_struct(val_str)
            if expr_struct != "" {
                set_var_struct(name, expr_struct)
            } else {
                let sname = node_type_name(val_node)
                if is_struct_type(sname) != 0 {
                    set_var_struct(name, sname)
                }
            }
        } else if type_ann != -1 {
            let ann_name = node_name(type_ann)
            if is_struct_type(ann_name) != 0 {
                let ann_mono = mono_name_from_ann(strip_module_qualifier(ann_name), type_ann, -1, [])
                let _reg = register_carrier_inner_mono_instance(ann_name, type_ann)
                set_var_struct(name, if ann_mono != "" { ann_mono } else { ann_name })
            } else if ann_name == "Tuple" {
                let tup_name = resolve_tuple_ann(type_ann, -1, []).unwrap()
                set_var_struct(name, tup_name)
            } else {
                let expr_struct = get_var_struct(val_str)
                if expr_struct != "" {
                    set_var_struct(name, expr_struct)
                }
            }
        } else {
            let expr_struct = get_var_struct(val_str)
            if expr_struct != "" {
                set_var_struct(name, expr_struct)
            }
        }
    }
    if val_type == CT_LIST && type_ann != -1 {
        let ann_name = node_name(type_ann)
        if ann_name == "List" {
            let elems_sl = node_elements(type_ann)
            if elems_sl != -1 && sublist_length(elems_sl) > 0 {
                let elem_ann = sublist_get(elems_sl, 0)
                let elem_name = node_name(elem_ann)
                let elem_ct = type_from_name(elem_name)
                set_list_elem_type(name, elem_ct)
                if elem_ct == CT_VOID && (is_named_type(elem_name) != 0) {
                    // A generic element (`List[Tree[Int]]`) must carry its mono stem
                    // (Tree_Int), not the bare head (Tree): the bare head is never
                    // typedef'd on its own (only mono instances of a generic type
                    // are), so a bare-head spelling here names an unemitted C type.
                    // Mirrors the declared-struct-annotation branch
                    // above for the LET variable's own type.
                    let elem_mono = mono_name_from_ann(strip_module_qualifier(elem_name), elem_ann, -1, [])
                    let _reg = register_carrier_inner_mono_instance(elem_name, elem_ann)
                    set_list_elem_struct(name, if elem_mono != "" { elem_mono } else { elem_name })
                } else if elem_ct == CT_VOID && elem_name == "Tuple" {
                    let tup_opt = resolve_tuple_ann(elem_ann, -1, [])
                    if tup_opt.is_some() {
                        set_list_elem_struct(name, tup_opt.unwrap())
                    }
                }
                if elem_ct == CT_LIST {
                    let nested_sl = node_elements(elem_ann)
                    if nested_sl != -1 && sublist_length(nested_sl) > 0 {
                        let nested_ann = sublist_get(nested_sl, 0)
                        let nested_name = node_name(nested_ann)
                        let nested_ct = type_from_name(nested_name)
                        set_list_nested_elem_type(name, nested_ct)
                    }
                }
                if elem_ct == CT_SET {
                    let nested_sl = node_elements(elem_ann)
                    if nested_sl != -1 && sublist_length(nested_sl) > 0 {
                        let nested_ann = sublist_get(nested_sl, 0)
                        let nested_name = node_name(nested_ann)
                        let nested_ct = type_from_name(nested_name)
                        set_list_nested_elem_type(name, nested_ct)
                    }
                }
                if elem_ct == CT_MAP {
                    set_list_elem_map_ann(name, elem_ann)
                }
                let _ = set_list_elem_compound_ann(name, elem_ann, elem_ct)
            }
        }
    }
    if val_type == CT_MAP && type_ann != -1 {
        let ann_name = node_name(type_ann)
        if ann_name == "Map" {
            let elems_sl = node_elements(type_ann)
            if elems_sl != -1 && sublist_length(elems_sl) >= 2 {
                let key_ann = sublist_get(elems_sl, 0)
                let val_ann = sublist_get(elems_sl, 1)
                let key_name = resolve_tparam_via_tid(node_name(key_ann), cg_mono_tparams_sl, cg_mono_arg_tids)
                let val_name = resolve_tparam_via_tid(node_name(val_ann), cg_mono_tparams_sl, cg_mono_arg_tids)
                let key_ct = type_from_name(key_name)
                let val_ct = type_from_name(val_name)
                set_map_types(name, key_ct, val_ct, val_name)
                let key_struct = key_struct_sname_from_ann(key_ann, cg_mono_tparams_sl, segs_from_arg_tids(cg_mono_arg_tids))
                if key_struct != "" {
                    set_map_key_struct(name, key_struct)
                } else if key_ct == CT_VOID && is_named_type(key_name) != 0 {
                    set_map_key_struct(name, key_name)
                }
                propagate_map_list_elem(name, val_ct, val_ann)
            }
        }
    }
    if val_type == CT_SET && type_ann != -1 {
        let ann_name = node_name(type_ann)
        if ann_name == "Set" {
            let elems_sl = node_elements(type_ann)
            if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
                let elem_ann = sublist_get(elems_sl, 0)
                let elem_name = resolve_tparam_via_tid(node_name(elem_ann), cg_mono_tparams_sl, cg_mono_arg_tids)
                let elem_ct = type_from_name(elem_name)
                set_set_elem_type(name, elem_ct)
                let elem_struct = key_struct_sname_from_ann(elem_ann, cg_mono_tparams_sl, segs_from_arg_tids(cg_mono_arg_tids))
                if elem_struct != "" {
                    set_set_elem_struct(name, elem_struct)
                } else if elem_ct == CT_VOID && is_named_type(elem_name) != 0 {
                    set_set_elem_struct(name, elem_name)
                }
            }
        }
    } else if val_type == CT_SET {
        // No annotation: carry the RHS set's element type across. Prefer copying
        // from the source var (`let alias = some_set`); fall back to a freshly
        // set expr_list_elem_type (union results). Always clear the global so a
        // stale value from a prior expression can't leak into a later binding.
        let src_elem = get_set_elem_type(val_str)
        if src_elem >= 0 || get_set_elem_struct(val_str) != "" {
            set_set_elem_type(name, src_elem)
            let src_struct = get_set_elem_struct(val_str)
            if src_struct != "" {
                set_set_elem_struct(name, src_struct)
            }
        } else if expr_list_elem_type >= 0 {
            set_set_elem_type(name, expr_list_elem_type)
            if expr_list_elem_struct != "" {
                set_set_elem_struct(name, expr_list_elem_struct)
            }
        } else {
            // No annotation, no alias source, no adapter carry -- the
            // last resort is typecheck's own tid for the RHS (Set() mints a
            // metavar that HM inference has already pinned by this point for
            // any well-typed program; genuinely unconstrained is E0301 well
            // before codegen).
            recover_set_elem_from_tid(val_node, name)
        }
        expr_list_elem_type = -1
        expr_list_elem_struct = ""
    }
    if val_type == CT_MAP && expr_map_key_type >= 0 {
        apply_map_binding_meta(name)
    }
    if val_type == CT_MAP {
        let val_orig_name = if node_kind(val_node) == NodeKind.Ident { node_name(val_node) } else { "" }
        carry_map_binding_meta(val_str, val_orig_name, name, type_ann)
    }
    // The three inputs that decide which arm of the list ladder below fires. A lost element
    // looks identical whether the RHS carried no element (expr_elem=-1) or carried a nameless
    // one (expr_elem=23, CT_STRUCT, with no sname); only tracing the three together tells them apart.
    if dbg_channel_on("listelem") != 0 {
        dbg_trace("listelem", "letladder var={name} val_type={val_type} ann={type_ann} expr_elem={expr_list_elem_type} sv_elem={get_list_elem_type(name)}")
    }
    if val_type == CT_LIST && expr_list_elem_type >= 0 && type_ann == -1 {
        set_list_elem_type(name, expr_list_elem_type)
        // A compound element (Option/Result/Map) recovered onto val_str by
        // recover_list_elem_from_tid (a field-access temp) carries its deep tp_id —
        // the flat set_list_elem_type above only stamps the shallow CT marker, so
        // without this the deep inner dies with val_str when `name` re-binds it.
        if expr_list_elem_type == CT_OPTION || expr_list_elem_type == CT_RESULT || expr_list_elem_type == CT_MAP {
            copy_list_compound_elem(val_str, name)
            // The copy reads its source by variable NAME, so an RHS that is a CALL --
            // `let e = loptmap()`, val_str = `blink_u_f_loptmap()` -- has no ScopeVar to read, and
            // the compound element keeps only the shallow CT stamped two lines above, losing its inner.
            // The tid stamp below is the only authority that can tell a lost inner apart from a
            // genuine `List[Option[Int]]`: set_list_elem_type routes through sv_tp, which FABRICATES
            // a default inner for either case, so the flat fields alone cannot distinguish them.
            //
            // Precedence, stated: the copy runs first and the tid stamp runs second, so the tid
            // wins when it has an answer and the copy's answer survives when it does not.
            // stamp_list_elem_from_tid declines by itself for anything it cannot spell faithfully
            // (deep_tp_from_tid's -1 contract, and an abstract typevar in a generic body reads as
            // unspellable), so an unrepresentable inner stays honestly erased rather than being
            // traded for a different fabrication.
            stamp_list_elem_from_tid(val_node, name)
        }
        // A CT_SET or CT_LIST element also needs the tid stamp, not just Option/Result/Map:
        // without it, `let g = f()` for an `f() -> List[Set[Int]]` keeps the element's head and
        // loses its inner, so a Set[Int] is spelled as a Set[Set[?]]. stamp_list_elem_from_tid
        // already spells both kinds faithfully, so this is the same authority flip one gate wider,
        // not a new recovery path. It fires at the END of the branch, after the flat nested channels
        // below, so for exactly these two kinds the tid is the last writer and the flat nested pair
        // cannot overwrite a faithful inner with an erased one.
        let entry_elem_ct = expr_list_elem_type
        expr_list_elem_type = -1
        let src_struct = get_list_elem_struct(val_str)
        if src_struct != "" {
            set_list_elem_struct(name, src_struct)
        } else if expr_list_elem_struct != "" {
            set_list_elem_struct(name, expr_list_elem_struct)
        }
        expr_list_elem_struct = ""
        let src_nested = get_list_nested_elem_type(val_str)
        if src_nested != -1 {
            set_list_nested_elem_type(name, src_nested)
        }
        if entry_elem_ct == CT_SET || entry_elem_ct == CT_LIST {
            stamp_list_elem_from_tid(val_node, name)
        }
    } else if val_type == CT_LIST && expr_list_elem_type >= 0 {
        expr_list_elem_type = -1
        expr_list_elem_struct = ""
    }
    // The ladder above can leave the element UNSPELLABLE -- either absent, or a
    // CT_STRUCT/CT_ENUM/CT_VOID marker with no struct name to go with it, which is the shape an
    // unannotated `let` bound to a CALL returning `List[(A, B)]` produces: the RHS carries
    // expr_list_elem_type = CT_STRUCT (a tuple IS a struct here) but no sname, and val_str is a C
    // call expression, so neither get_list_elem_struct(val_str) nor expr_list_elem_struct can
    // supply one. The result is a list whose element is a nameless struct, i.e. Void.
    //
    // The last resort is typecheck's own tid for the RHS, exactly as the CT_SET branch above
    // already does for a set element. Guarded on the element being unspellable, so this
    // fires only where the code above left nothing usable; recover_list_elem_from_tid itself
    // declines when the tid has no nameable element either.
    if val_type == CT_LIST && type_ann == -1 && list_elem_unspellable(name) {
        recover_list_elem_from_tid(val_node, name)
        expr_list_elem_type = -1
        expr_list_elem_struct = ""
    }
    // Last, because it has to win over the ladder above: a STRUCT key list's element is
    // pointer-boxed, and the ladder above can leave it named but scalar-tagged. See
    // map_keys_boxed_elem, which declines every inline key including a payload-less enum.
    if val_type == CT_LIST {
        let keys_elem = map_keys_boxed_elem(val_node)
        if keys_elem != "" {
            set_list_elem_named_boxed(name, keys_elem)
        }
    }
    if val_type == CT_ITERATOR {
        set_var_alias(name, val_str)
        let iter_inner = get_var_iterator_inner(val_str)
        let iter_next = get_var_iter_next_fn(val_str)
        if iter_inner >= 0 {
            set_var_iterator(name, iter_inner, iter_next)
        }
        return
    }
    let struct_type = get_var_struct(name)
    let cname = c_safe_name(name)
    // Stage 2 measurement, immediately ahead of the declaration chain below — the single
    // decision that turns a variable's type into C. The answer is DISCARDED: the flat
    // `val_type` still governs every branch, which is what keeps the emitted C byte-identical
    // while the counter enumerates the cells Stage 3 has to lower from the tid instead.
    // `node` is threaded so the sweep row can name the declaration (`at=module:line`).
    // Without it a row identifies only the variable and the ENTRY file, and neither locates the
    // `let`: every test compile re-emits the whole stdlib, so one stdlib binding is blamed on
    // ~90 entry files at once.
    let decl_tid = tc_tid_subst_mono(sv_ty_or_flat_at(name, "emit_let_binding.decl", node), cg_mono_tparams_sl, cg_mono_arg_tids)
    // Stage 3 measurement, the string twin of the line above. Each arm of the chain below
    // records the C TYPE it printed and which arm printed it; the ctypediv probe after the
    // chain compares that against c_type_from_tid's answer for the same variable. The flat
    // fields still govern every branch — nothing here changes what is emitted — so the cell
    // map that comes out is the enumerated list of what the authority flip would change.
    let mut decl_c = ""
    let mut decl_branch = ""
    // A genuine Void RHS (`let x = nothing()`, a Void-typed field
    // read, a generic fn returning its Void type argument) must not decay to
    // `const void x = ...;` -- illegal C, since `()` is an
    // ordinary inhabited, encodable type, not a construct ban like `while`/
    // `loop`. Checked FIRST, ahead of every
    // other branch below (including struct_type != "", which a pre-existing
    // sname-tagging quirk in tp_from_ann/get_struct_field_stype can leave set
    // to the literal string "Void" for a genuinely Void field -- see
    // tp_from_ann's `ct == CT_VOID -> sv_tp(CT_VOID, -1, -1, name)` catch-all,
    // which stamps sname=name even when name IS "Void", not just when it's an
    // unrecognized/erased name; that sname then rides get_var_struct into this
    // function's own `struct_type` local via the no-annotation fallback.
    //
    // TWO independent signals must both agree, not one:
    //  - tc_tid_to_c_tag(tid) == "Void" recovers the literal name from the RHS
    //    node's typecheck-side tid. This alone is not enough: `.pop()`/
    //    `.clear()` on a List are typecheck-side special-cased to TYPE_VOID
    //    even though codegen's OWN method-call handler computes their
    //    real type as CT_OPTION (the Option[T] pop() actually returns) --
    //    typecheck and codegen disagree about this one node's type, and
    //    trusting the tid alone would silently discard a real `.pop()` result.
    //  - val_type == CT_VOID is codegen's OWN computed type for this RHS
    //    (expr_result_type), already correct for `.pop()` (CT_OPTION, so this
    //    guard alone already excludes it) but NOT enough on its own either:
    //    an ERASED carrier slot also collapses to CT_VOID at codegen
    //    (type_from_name collapses "" and every unknown name onto it too), so
    //    a CT-only check would silently swallow an erased carrier into a
    //    well-typed int64_t and disarm the loud `void x;` tripwire R9 depends
    //    on -- an erased slot's tid still resolves to its true carrier tag
    //    (e.g. "Option_int"), never to "Void", so requiring the tid to ALSO
    //    say "Void" keeps that case falling through to the loud failure below.
    //
    // Only where BOTH agree is the RHS discarded for effect (its C type is
    // genuinely `void` for a Void-returning call -- there is no value to read
    // it into) and the local a constant int64_t placeholder, mirroring the
    // field lowering c_field_type_str already applies to a Void struct field
    // / Result leaf.
    if rhs_is_genuine_void(val_type, val_node) != 0 {
        // A Void-returning builtin (assert/debug_assert/skip) already emitted
        // its own full C statement(s) as a side effect inside emit_expr and
        // signals "nothing left to emit" via val_str=="", mirroring
        // emit_stmt's ExprStmt arm -- wrapping an empty val_str here would
        // emit the illegal bare `(void);`.
        if val_str != "" && val_str != "0" {
            emit_line("(void){val_str};")
        }
        // The placeholder, not a type: a genuine `void` local is illegal C, so this arm is a
        // POSITION rule (c_field_type_str owns the same rule for a field). c_type_from_tid
        // answers "void" here and that disagreement is the rule working, not a defect —
        // which is exactly why the probe is keyed by branch.
        decl_c = "int64_t"
        decl_branch = "void_placeholder"
        if is_mut != 0 {
            emit_line("int64_t {cname} = 0;")
        } else {
            emit_line("const int64_t {cname} = 0;")
        }
    } else if val_type == CT_OPTION {
        let opt_inner = get_var_option_inner(name)
        let opt_inner_s = get_var_option_inner_tag(name)
        let opt_c_inner = opt_inner
        // A compound inner (`Option[Map[K,V]]`, `Option[Option[T]]`, `Option[Result[..]]`)
        // erases through the flat channels: option_c_type_mixed sees only a one-level inner
        // and drops the args (`blink_Option_map`). The tid carries the full inner, so lead
        // with it for exactly that shape — gated on the inner being compound and the tid
        // spelling a well-formed Option carrier — while a scalar/struct inner keeps the flat
        // spelling byte-for-byte. Leading with the tid unconditionally would erase a
        // non-compound generic-struct instance (`Option[Inner[Int]]`) to its bare head
        // (blink_Option_Inner), dropping the mono stem (Inner_0Int) the flat channel still
        // carries. The typedef is registered by the producer's signature and
        // return-expression, which the same TU always emits.
        let opt_tid_c = c_type_from_tid(decl_tid)
        let opt_inner_compound = is_compound_ct(tc_tid_option_inner_ct(tc_tid_resolved(decl_tid))) != 0
        // Mirrors the CT_RESULT arm: the flat sname leads only when it holds a mono stem
        // the tid dropped (generic-struct instance). An empty flat sname means the tid is
        // at least as specific, so it leads and recovers a payloadless-enum nominal
        // (`Option[Errno]`) the CT-only mixed spelling would void out.
        let opt_flat_has_sname = opt_inner_s != ""
        let opt_use_tid = opt_tid_c.starts_with("blink_Option_") && (opt_inner_compound || opt_flat_has_sname == false)
        // A ptr-erased Option (UE-handler ABI) carries its TRUE logical inner in
        // the flat channels, but its physical value is a blink_Option_ptr box — the
        // declaration must spell the erased carrier to accept it.
        let opt_c = if get_var_option_erased(name) != 0 {
            ensure_option_type(CT_PTR)
            option_c_type(CT_PTR)
        } else if opt_use_tid {
            opt_tid_c
        } else {
            option_c_type_mixed(opt_c_inner, opt_inner_s)
        }
        decl_c = opt_c
        decl_branch = if get_var_option_erased(name) == 0 && opt_use_tid { "option_tid" } else { "option" }
        if val_str.ends_with("\{.tag = 0}") {
            // Option[@ffi.opaque] is null-pointer-optimized: None is the NULL handle,
            // never a `{.tag = 0}` struct initializer against the bare pointer type.
            if opt_inner_s != "" && is_opaque_type(opt_inner_s) != 0 {
                val_str = "(({opt_c})0)"
            } else {
                val_str = "({opt_c})\{.tag = 0}"
            }
        }
        // A null-pointer-optimized Option[@ffi.opaque] spells a bare `cname *`; a
        // leading const would qualify the POINTEE, not the binding, so exempt any
        // trailing-star spelling exactly as the flat arm below does.
        if is_mut != 0 || opt_c.ends_with("*") {
            emit_line("{opt_c} {cname} = {val_str};")
        } else {
            emit_line("const {opt_c} {cname} = {val_str};")
        }
    } else if val_type == CT_RESULT {
        let rok = get_var_result_ok(name)
        let rerr = get_var_result_err(name)
        let rok_s = get_var_result_ok_tag(name)
        let rerr_s = get_var_result_err_tag(name)
        // A compound ok/err inner whose carrier tag embeds args (`Result[Map[K,V], E]`,
        // `Result[Option[T], E]`) erases through the flat channels: result_c_type_mixed
        // sees only a one-level inner and drops the args (`blink_Result_map_str`). The
        // tid carries the full inner, so lead with it for exactly that shape — gated on
        // an inner being compound and the tid spelling a well-formed Result carrier —
        // while a scalar/struct inner keeps the flat spelling byte-for-byte. Leading with
        // the tid unconditionally would erase a non-compound generic-struct instance
        // (`Result[Inner[Int], Str]`) to its bare head (blink_Result_Inner_str), dropping
        // the mono stem (Inner_0Int) the flat channel still carries. Mirrors the
        // CT_OPTION arm above.
        let res_tid_r = tc_tid_resolved(decl_tid)
        let res_tid_c = c_type_from_tid(decl_tid)
        let res_inner_compound = is_compound_ct(tc_tid_result_ok_ct(res_tid_r)) != 0 || is_compound_ct(tc_tid_result_err_ct(res_tid_r)) != 0
        // The flat sname channel leads only when it carries a mono stem the tid dropped:
        // a non-compound generic-struct instance (`Result[Inner[Int], Str]`) keeps
        // `Inner_0Int` in the flat sname while the tid erases to the bare head
        // `blink_Result_Inner_str`. When both flat snames are empty the flat channel has
        // nothing more specific to add, so a well-formed tid leads and recovers a concrete
        // nominal the CT-only mixed spelling would void out (`Result[Errno, Str]`).
        let res_flat_has_sname = rok_s != "" || rerr_s != ""
        let res_use_tid = res_tid_c.starts_with("blink_Result_") && (res_inner_compound || res_flat_has_sname == false)
        let res_c = if res_use_tid { res_tid_c } else { result_c_type_mixed(rok, rerr, rok_s, rerr_s) }
        decl_c = res_c
        decl_branch = if res_use_tid { "result_tid" } else { "result" }
        if is_mut != 0 {
            emit_line("{res_c} {cname} = {val_str};")
        } else {
            emit_line("const {res_c} {cname} = {val_str};")
        }
    } else if enum_type != "" {
        // Declare with the mono instance C type (blink_Tree_Int) when the RHS was a
        // generic-enum construction; else the bare enum type.
        //
        // The tid LEADS over both, because the flat pair answers the bare base for an
        // annotation-only instance — `let t: ITree[Int] = INone` emitted `const blink_ITree t`,
        // a typedef that is never registered, while `blink_ITree_0Int` sat emitted a few hundred
        // lines above. The two agree wherever enum_mono is non-empty, so leading with the tid
        // changes only the rows where the flat side had nothing; enum_instance_c_from_tid is
        // gated on the tid carrying args so it cannot reach any other enum binding.
        let tid_mono = enum_instance_c_from_tid(decl_tid)
        let enum_tid_bare = enum_c_from_tid(decl_tid)
        let enum_decl_c = if tid_mono != "" {
            tid_mono
        } else if enum_mono != "" {
            c_type_c_name(enum_mono)
        } else if enum_tid_bare != "" {
            // Reader migration: a bare (non-mono) enum binding leads with the tid instead of
            // the flat sname. enum_c_from_tid answers the same nominal typedef the flat sname
            // did (blink_<Enum>), so this is byte-identical wherever the flat path already
            // named the enum — it only removes a flat-sname reader. The flat name survives as
            // the fallback for any binding whose tid declined.
            enum_tid_bare
        } else {
            c_type_c_name(enum_type)
        }
        decl_c = enum_decl_c
        // Four labels now, so the census still says which authority governed: a row that
        // moves from `enum` to `enum_mono_tid` is a bare base corrected, one that moves from
        // `enum_mono` is the tid agreeing with a stem the flat path had already found, and
        // `enum_bare_tid` is the tid taking over a bare enum the flat sname used to spell.
        decl_branch = if tid_mono != "" { "enum_mono_tid" } else if enum_mono != "" { "enum_mono" } else if enum_tid_bare != "" { "enum_bare_tid" } else { "enum" }
        if is_mut != 0 {
            emit_line("{enum_decl_c} {cname} = {val_str};")
        } else {
            emit_line("const {enum_decl_c} {cname} = {val_str};")
        }
    } else if val_type == CT_HANDLER {
        let h_vtt = get_var_handler_vtable_type(name)
        decl_branch = "handler"
        if h_vtt != "" {
            decl_c = "{h_vtt}*"
            emit_line("{h_vtt}* {cname} = ({h_vtt}*){val_str};")
        } else {
            decl_c = "void*"
            emit_line("void* {cname} = {val_str};")
        }
    } else if struct_type != "" {
        // Same lead, same gate as the enum arm above: c_type_c_name answers the bare generic
        // base for an instance, and the base has no typedef. Gated on the tid carrying args,
        // so it reaches no other struct binding.
        let s_tid_mono = struct_instance_c_from_tid(decl_tid)
        let struct_decl_c = if s_tid_mono != "" { s_tid_mono } else { c_type_c_name(struct_type) }
        decl_c = struct_decl_c
        decl_branch = if s_tid_mono != "" { "struct_mono_tid" } else { "struct" }
        // An @ffi.opaque handle reaches this arm through struct_type but spells a
        // bare `cname *`; a leading const would qualify the POINTEE, not the
        // binding, so exempt any trailing-star spelling exactly as the flat arm
        // below does. Real structs spell `blink_Foo` and keep the const.
        if is_mut != 0 || struct_decl_c.ends_with("*") {
            emit_line("{struct_decl_c} {cname} = {val_str};")
        } else {
            emit_line("const {struct_decl_c} {cname} = {val_str};")
        }
    } else if val_type == CT_PTR && type_ann != -1 {
        // The tid LEADS the annotation here. Both channels describe the same binding, so
        // they agree wherever the annotation's own mapping has an arm — but `ptr_inner_c_type`
        // is a fixed name table whose fallback is `_ => "void"`, so a pointee it does not list (`Bool` is one)
        // declared as `void*` and then even `p.write(true)` was *invalid use of void
        // expression*. ptr_c_from_tid declines on `void*`, so the annotation keeps every
        // binding the tid cannot improve on, including the deliberate `Ptr[Void]`.
        let mut ptr_c_type = ptr_c_from_tid(decl_tid)
        decl_branch = "ptr_ann_tid"
        if ptr_c_type == "" {
            let pelems = node_elements(type_ann)
            ptr_c_type = "void*"
            if pelems != -1 && sublist_length(pelems) > 0 {
                ptr_c_type = "{ptr_inner_c_type(node_name(sublist_get(pelems, 0)))}*"
            }
            decl_branch = "ptr_ann"
        }
        decl_c = ptr_c_type
        emit_line("{ptr_c_type} {cname} = {val_str};")
    } else if val_type == CT_PTR && ffi_offset_pending_struct != "" {
        decl_c = "{c_type_c_name(ffi_offset_pending_struct)}*"
        decl_branch = "ptr_ffi"
        emit_line("{c_type_c_name(ffi_offset_pending_struct)}* {cname} = {val_str};")
    } else if enum_c_from_tid(decl_tid) != "" {
        // Deliberately placed AFTER every branch that already spells an enum — the
        // `enum`/`enum_mono` arm above owns the bindings whose flat `enum_type` survived, and
        // this arm only catches the ones where it went blank. Ordering it earlier would take
        // those bindings away from arms already wired correctly, which is a regression no
        // failing row would reveal.
        let enum_c = enum_c_from_tid(decl_tid)
        decl_c = enum_c
        decl_branch = "enum_tid"
        if is_mut != 0 {
            emit_line("{enum_c} {cname} = {val_str};")
        } else {
            emit_line("const {enum_c} {cname} = {val_str};")
        }
    } else if val_type == CT_PTR && ptr_c_from_tid(decl_tid) != "" {
        // The first site where the tid GOVERNS rather than being measured.
        // The two branches above read a pointee out of the binding's own annotation and out of
        // `ffi_offset_pending_struct`; neither can see the pointee of an UNANNOTATED binding
        // whose RHS is a call (`let p = s.as_cstr()`). That fell through to the flat `else`
        // below and printed `c_type_str(CT_PTR)` = `void*`, which makes every later `deref()`
        // a C-compiler error with no Blink span to report it against. The tid has held the
        // pointee all along, so ask it. The flat fields keep governing every other branch.
        let ptr_c = ptr_c_from_tid(decl_tid)
        decl_c = ptr_c
        decl_branch = "ptr_tid"
        emit_line("{ptr_c} {cname} = {val_str};")
    } else if handler_c_from_tid(decl_tid) != "" {
        // The CT_HANDLER arm far above owns every binding whose flat `val_type` survived, and
        // this arm only catches the ones where it was ERASED — a handler read out of a container
        // (`hs.get(0).unwrap()`, `m.get(k).unwrap()`) arrives as CT_INT, skips that arm, and
        // fell through to the `flat` else below, which
        // printed `int64_t`. The `with` that then used the binding failed in the C compiler
        // ("assignment to 'blink_io_vtable *' from 'int64_t' … makes pointer from integer without a
        // cast") with no Blink span to report it against.
        //
        // The CAST is not optional and not cosmetic: a container stores the handler pointer through
        // an `(int64_t)(intptr_t)` slot, so the initializer really is an integer expression at this
        // point and the declaration is where it comes back to a vtable pointer. This mirrors the
        // CT_HANDLER arm, which casts for the same reason.
        let h_tid_c = handler_c_from_tid(decl_tid)
        decl_c = h_tid_c
        decl_branch = "handler_tid"
        emit_line("{h_tid_c} {cname} = ({h_tid_c}){val_str};")
    } else {
        // The last branch of the chain, and the most-reached declaration site in the compiler. The
        // tid LEADS here and the flat spelling survives only where it declines.
        //
        // A declaration is a STORAGE position, so a genuine `void` falls through to the flat
        // spelling: c_type_from_tid answers Void deliberately and leaves the position rule to its
        // caller.
        let flat = c_type_str(val_type)
        let spelled = c_type_from_tid(decl_tid)
        let ts = if spelled != "" && spelled != "void" { spelled } else { flat }
        // `decl_c` is the probe's `emitted` argument and is deliberately the FLAT CANDIDATE rather
        // than the line about to be printed. Feeding the chosen spelling back in would compare the
        // tid against itself and report agreement unconditionally, which destroys the one number
        // that says whether this branch still needs the flat arm.
        decl_c = flat
        decl_branch = "flat"
        // A leading `const` on a pointer spelling (e.g. an @ffi.opaque handle
        // lowered to `FILE*`) qualifies the POINTEE, not the binding, so the
        // value no longer matches a plain `T*` parameter. Every pointer-lowered
        // CT_ type is already exempted for this reason; a `*`-tailed spelling
        // that reaches this flat arm gets the same treatment.
        if is_mut != 0 || ts.ends_with("*") || val_type == CT_STRING || val_type == CT_LIST || val_type == CT_MAP || val_type == CT_SET || val_type == CT_BYTES || val_type == CT_CLOSURE || val_type == CT_ITERATOR || val_type == CT_HANDLE || val_type == CT_CHANNEL || val_type == CT_PTR || val_type == CT_STRINGBUILDER || val_type == CT_FFI_SCOPE {
            emit_line("{ts} {cname} = {val_str};")
        } else {
            emit_line("const {ts} {cname} = {val_str};")
        }
    }
    // The tid is substituted through the enclosing monomorphisation first, exactly as every
    // other tid consumer in codegen does: inside a mono'd generic fn a local's memoized tid is
    // still the typevar `T`, which c_type_from_tid rightly declines, and measuring that as a
    // decline would report the mono machinery as a hole in the speller.
    ctype_probe_at(decl_tid, decl_branch, name, decl_c, node)
    ffi_offset_pending_struct = ""
    if name.starts_with("_") {
        emit_line("(void){cname};")
    }
    if list_contains_str(mut_captured_vars, name) != 0 {
        // The cell must agree with the declaration just emitted for `{cname}`, or this reduces to
        // `void* x_cell = (void*)blink_alloc(sizeof(void));` — a zero-sized alloc followed by an
        // illegal void-lvalue assignment. capture_cell_c_type is shared with the rehydration inside
        // the closure body, which declares the same cell, and carries the Void-position rule.
        let cell_type = capture_cell_c_type(get_var_ty(name), get_var_tp(name), if rhs_is_genuine_void(val_type, val_node) != 0 { "Void" } else { "" })
        emit_line("{cell_type}* {cname}_cell = ({cell_type}*)blink_alloc(sizeof({cell_type}));")
        emit_line("*{cname}_cell = {cname};")
    }
    // A pattern NODE, not a sublist — node_elements answers a sublist id for some node kinds and a
    // child node id for others, and nothing in the types distinguishes them. Naming it `_sl` would
    // misread a node id as a sublist id and measure a two-element pattern's arity as 1.
    let destr_pat_node = node_elements(node)
    if destr_pat_node != -1 {
        let tup_struct = get_var_struct(cname)
        if tup_struct != "" {
            emit_tuple_destructure(destr_pat_node, cname, tup_struct, is_mut)
        }
    }
}

// The BY-VALUE C expression for a Map value read from `m->values[i]` (a bare
// void*), for embedding into a Tuple2 `._1` field (`for (k, v) in
// map`). Mirrors emit_map_method's "get" dispatch exactly, so a
// Map value materializes here the same way it already does through `.get()` —
// no new value-representation support, just the same boxing convention read
// back inline instead of behind an Option.
fn map_pair_value_read_expr(value_expr: Str, val_ct: Int, val_struct: Str) -> Str {
    if val_struct != "" && is_opaque_type(val_struct) != 0 {
        // An @ffi.opaque handle is stored inline in the map slot, so recover it with a
        // single cast -- never deref like a heap-boxed struct value.
        return "({c_type_c_name(val_struct)})(intptr_t){value_expr}"
    }
    if val_struct != "" {
        return "*({c_type_c_name(val_struct)}*){value_expr}"
    }
    if val_ct == CT_STRING { return "(const char*){value_expr}" }
    if val_ct == CT_LIST { return "(blink_list*){value_expr}" }
    if val_ct == CT_MAP { return "(blink_map*){value_expr}" }
    if val_ct == CT_SET { return "(blink_set*){value_expr}" }
    if val_ct == CT_FLOAT { return "*(double*){value_expr}" }
    "(int64_t)(intptr_t){value_expr}"
}

// `m.keys()` does not hand back a push-built list. It hands back the map's KEYS, and a
// user STRUCT key is stored kops-POINTER-boxed (its kops sets inline_key = 0), so blink_map_keys
// pushes the pointer as-is and those slots mean "deref this". The name is not published anywhere
// else — emit_map_method's `keys` arm records the element's CT but no sname — so it has to be
// recovered here, at the node, where the producer is still visible.
//
// The receiver's tid saying Map is the gate a user method named `keys` cannot forge. Answers the
// key type's name, or "" when the slots are NOT pointer-boxed — a Str, an Int, a sized int and
// a payload-less enum are all inline_key = 1, and the runtime packs the value
// straight into the list slot (see blink_map_keys), which is what a nameless element means here.
fn map_keys_boxed_elem(n: Int) -> Str {
    if node_kind(n) != NodeKind.MethodCall { return "" }
    if node_method(n) != "keys" { return "" }
    if tc_tid_kind(tc_tid_resolved(tc_lookup_node_tid(node_obj(n)))) != TyKind.Map { return "" }
    let ktid = tc_tid_subst_mono(tc_tid_resolved(tc_tid_iter_elem(tc_tid_resolved(tc_lookup_node_tid(n)))), cg_mono_tparams_sl, cg_mono_arg_tids)
    let elem = named_elem_of_elem_tid(ktid)
    if elem.plain_enum { return "" }
    elem.name
}

// Stage 2's dual-write for a for-in loop variable, and the tap that measures it.
// Called from every arm of emit_for_in once the loop variable's ScopeVar exists and before the
// body is emitted, i.e. with exactly the type the body will read.
//
// Advisory, like every other Stage 2 dual-write: the answer is DISCARDED and the flat fields
// still govern every branch, so the emitted C does not change. What changes is that the counter
// can see the site.
//
// The stamp is gated on a KNOWN element: tc_tid_iter_elem answers TYPE_UNKNOWN for the iterables
// whose element typecheck does not publish yet (Str, Bytes, Iterator, Channel, Range), and
// stamping that would report a divergence against a flat field that is in fact correct. Left
// unstamped, the tap answers `missing` instead — a bucket that says "no tid here", which is the
// honest reading and also the inventory of the iterables still to be typed.
fn forin_measure_var(var_name: Str, iter_node: Int, node: Int) {
    if var_name == "" { return }
    // Substituted through the instance's binds for the same reason emit_let_binding.decl does it:
    // inside a monomorphized body `for x in xs` over a `List[T]` publishes `T`, and
    // comparing a typevar against the concrete flat spelling reports a divergence that is only
    // the tap failing to look up what T is bound to.
    let elem_tid = tc_tid_subst_mono(tc_tid_resolved(tc_tid_iter_elem(tc_tid_resolved(tc_lookup_node_tid(iter_node)))), cg_mono_tparams_sl, cg_mono_arg_tids)
    if elem_tid >= 0 && tc_tid_kind(elem_tid) != TyKind.Unknown {
        set_var_ty(var_name, elem_tid)
    }
    let _measured = sv_ty_or_flat_at(var_name, "emit_for_in.var", node)
}

// The ctype half of the same measurement, and the DECIDER for the two for-in
// binder declarations. forin_measure_var compares the two type REPRESENTATIONS; this compares the
// two C SPELLINGS, which is what Stage 3's flip actually changes: a binder declared from the flat
// `elem_type` alone can only ever be spelled at depth 1, and the erasures that bite here
// (`blink_Option_int` for an `Option[Map[Str, Int]]` element) are invisible to a
// representation-level comparison that both sides answer CT_OPTION for.
//
// The tid LEADS and the flat spelling survives only where the tid
// declines. `flat` is passed in rather than re-derived because the two declaration sites reach
// c_type_str through different locals, and a decider that recomputed the spelling would be
// choosing against its own idea of the flat answer instead of against the line the site would
// otherwise have printed.
//
// READING THE CENSUS AFTER A FLIP. The probe's `emitted` column is documented as "what the caller
// is about to print", and at a flipped site that is no longer the flat candidate — so `diverge`
// here now counts CORRECTIONS the tid applied, not defects, and it does not go to zero. The
// number that must reach zero before Stage 4 can delete the flat arm is `missing`: a decline is
// the only remaining case in which the flat spelling still governs the output.
fn forin_binder_ctype(var_name: Str, iter_node: Int, node: Int, site: Str, flat: Str) -> Str {
    if var_name == "" { return flat }
    let elem_tid = tc_tid_subst_mono(tc_tid_resolved(tc_tid_iter_elem(tc_tid_resolved(tc_lookup_node_tid(iter_node)))), cg_mono_tparams_sl, cg_mono_arg_tids)
    ctype_probe_at(elem_tid, site, var_name, flat, node)
    let spelled = c_type_from_tid(elem_tid)
    if spelled == "" { return flat }
    // A binder is a STORAGE position and `void` is legal only in a return one — c_type_from_tid
    // answers a genuine Void deliberately and leaves the position rule to its caller. The corpus
    // has no such row (missing=0, and all 15 divergences were the plain-enum cell), so this is a
    // guard against a shape the sweep did not contain rather than an observed cell: declining
    // keeps the pre-flip output instead of emitting a `void x = …` that would not compile.
    if spelled == "void" { return flat }
    spelled
}

// The same dual-write for a function parameter, which is the larger population: four
// registration loops — plain fn, prototype, monomorphized fn, poly impl — build a param's ScopeVar
// from `node_type_name(p)`, a NAME put through type_from_name, while the annotation node carries
// the whole tree.
//
// Called once per loop, AFTER the loop, rather than inside its arms. Each loop stamps through
// several branches with an early `continue`, and what the counter has to compare is the type the
// BODY will read — i.e. the state after every arm has run. Re-walking the sublist costs one pass
// and cannot miss an arm that was added without a tap.
//
// tparams_sl/arg_tids are the mono binds (cg_fn_mono_*, the stable twins — params are registered
// at fn entry, before any struct-literal swap), so a generic param is compared as the concrete
// type this instance was emitted for instead of as a bare typevar against a concrete flat
// spelling. -1/[] outside a mono body makes tc_tid_subst_mono a no-op.
fn params_measure(params_sl: Int, tparams_sl: Int, arg_tids: List[Int]) {
    if params_sl == -1 { return }
    let mut i = 0
    while i < sublist_length(params_sl) {
        let p = sublist_get(params_sl, i)
        let pname = node_name(p)
        // The PARAM node, not its annotation: typecheck publishes the param's resolved type
        // there (tc_publish_node_tid), and the annotation node carries a tid only for the
        // struct-instance shapes that walk it. The annotation is the fallback, not the source.
        let mut praw = tc_lookup_node_tid(p)
        if praw < 0 { praw = tc_lookup_node_tid(node_type_ann(p)) }
        if pname != "" {
            let ptid = tc_tid_subst_mono(tc_tid_resolved(praw), tparams_sl, arg_tids)
            if ptid >= 0 && tc_tid_kind(ptid) != TyKind.Unknown {
                set_var_ty(pname, ptid)
            }
            let _measured = sv_ty_or_flat_at(pname, "emit_fn_params.param", p)
        }
        i = i + 1
    }
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_for_in(node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let var_name = node_var_name(node)
    let c_var_name = c_safe_name(var_name)
    let iter_node = node_iterable(node)
    let iter_kind = node_kind(iter_node)

    if iter_kind == NodeKind.RangeLit {
        ensure_range_iter()
        emit_expr(node_start(iter_node))
        let start_str = expr_result_str
        emit_expr(node_end(iter_node))
        let end_str = expr_result_str
        let mut incl_val = "0"
        if node_inclusive(iter_node) != 0 {
            incl_val = "1"
        }
        let iter_var = fresh_temp("__iter_")
        let next_var = fresh_temp("__next_")
        let opt_type = option_c_type(CT_INT)
        emit_line("blink_RangeIterator {iter_var} = \{ .current = {start_str}, .end = {end_str}, .is_inclusive = {incl_val} };")
        emit_line("while (1) \{")
        cg_indent = cg_indent + 1
        emit_line("{opt_type} {next_var} = blink_RangeIterator_next(&{iter_var});")
        emit_line("if ({next_var}.tag == 0) break;")
        emit_line("int64_t {c_var_name} = {next_var}.value;")
        push_scope()
        set_var(var_name, CT_INT, 1)
        forin_measure_var(var_name, iter_node, node)
        emit_block(node_body(node))
        pop_scope()
        cg_indent = cg_indent - 1
        emit_line("}")
    } else {
        emit_expr(iter_node)
        let mut iter_str = expr_result_str
        let mut iter_type = expr_result_type
        // Container metadata (get_set_elem_type/get_map_key_type/etc.) is keyed in
        // scope_vars by the RAW Blink identifier a container was declared under, but
        // expr_result_str for a mut-captured Ident can diverge from that name (e.g.
        // "(*name_cell)" -- codegen_expr.bl's mut_captured_vars rewrite). Mirror
        // emit_map_method's defensive override so a lookup
        // against the raw AST name is used instead of the possibly-rewritten C
        // expression string; a miss here silently falls back to a wrong element/key/
        // value CT with no diagnostic.
        let mut lookup_name = iter_str
        if node_kind(iter_node) == NodeKind.Ident {
            lookup_name = node_name(iter_node)
        }
        // Set only when the CT_MAP normalizer below finds a List/Set-valued Map (e.g.
        // `Map[K, List[V]]`) with tracked nested-element info, so `for (k, v) in map`
        // can propagate it onto the destructured `v` -- otherwise a later `for x in v`
        // would find nothing recorded on `v` and (List) silently read -1 or (Set, below)
        // fail loud, neither of which fabricates a CT_STRING default
        // anymore.
        let mut map_val_ct = -1
        let mut map_val_nested_ct = -1
        // The element's STRUCT name, which the flat `extra` channel cannot hold (it is
        // one integer). Without it `for (k, v) in (Map[Str, List[Pt]])` bound `v` with an element
        // ct and no name, and `v.get(0).unwrap().x` rendered as the `<value>` placeholder.
        let mut map_val_nested_struct = ""
        if iter_type == CT_SET {
            // blink_set_to_list normalizes the set into a blink_list* up front so
            // the loop below reuses the CT_LIST arm verbatim, rather than a second
            // loop emitter. Do NOT route this through iter_from_source
            // instead: its only two branches are CT_LIST
            // and an else that treats everything else as CT_ITERATOR, so a bare
            // CT_SET would fall into the else and call
            // get_var_iter_next_fn(<set var>) — an empty/garbage function name —
            // producing a silently wrong or uncompilable call.
            let set_elem_ct = get_set_elem_type(lookup_name)
            let set_elem_struct = get_set_elem_struct(lookup_name)
            if set_elem_ct < 0 && set_elem_struct == "" {
                // get_set_elem_type now reports -1 truthfully instead of
                // fabricating CT_STRING. Every Set binding site is stamped from
                // typecheck's HM-resolved element (Stage A) and E0301 rejects a
                // genuinely unconstrained Set() before codegen runs, so reaching
                // this point with no element recorded is a compiler bug, not the
                // user's fault -- fail loud rather than guess.
                diag_ice_at("SetElementTypeUnknownAtCodegen", UNHANDLED_ITERABLE_AT_CODEGEN,
                    "for-in over Set variable '{lookup_name}' has no element type recorded at codegen",
                    iter_node,
                    "this is a compiler bug — please report it with the smallest reproducing program")
                // diag_ice_at only records the diagnostic; it does not abort. Bail
                // out now rather than falling through to the CT_LIST conversion
                // below and its `elem_type == -1 -> CT_INT` fallback,
                // which would silently box a Str/struct element as int64.
                return
            }
            let lst = fresh_temp("_setl_")
            emit_line("blink_list* {lst} = blink_set_to_list({iter_str});")
            set_var(lst, CT_LIST, 0)
            set_list_elem_type(lst, set_elem_ct)
            if set_elem_struct != "" {
                // One call, because a set element is now boxed the same way a push-built
                // list boxes it — a struct or a data enum by pointer, a payload-less enum as the
                // ordinal it is (its kops sets inline_key = 1, so blink_set_to_list packs it into
                // the slot). set_list_elem_struct's plain-enum reject is therefore right here too.
                set_list_elem_struct(lst, set_elem_struct)
            }
            expr_list_elem_type = set_elem_ct
            expr_list_elem_struct = set_elem_struct
            iter_str = lst
            iter_type = CT_LIST
        }
        if iter_type == CT_MAP {
            // Same normalize-then-reuse-CT_LIST shape as the CT_SET block above,
            // but a Map has no runtime-fn analogue of blink_set_to_list — the
            // (K, V) pair must materialize as an emitted Tuple2_<k>_<v> struct
            // (there is no generic pair type in the runtime), so this walks the
            // map's buckets directly (mirrors emit_debug_map_fn) and builds the pair list in
            // emitted C. finish_enum_zip_result then stamps elem_struct=tuple_tag, so the
            // CT_LIST arm's existing elem_struct sub-arm gives `for (k, v) in m`
            // tuple destructuring for free (emit_tuple_destructure), the same way
            // enumerate()'s (i, x) pairs already do.
            // The receiver's tid names both halves and the value's element; see
            // map_pair_from_recv (codegen_types.bl) for why the heads and the element are gated
            // differently. `flat_silent` is the honest signal — NEITHER half has a ScopeVar under
            // this name, which for a call/method-chain receiver is always true, and which the
            // non-raw accessors below now also report this as -1 (they no longer fabricate a
            // CT_STRING/CT_INT). When the flat pool does have an answer it keeps it: those spellings work
            // today and this cell is not the place to re-decide them.
            let mpt = map_pair_from_recv(iter_node)
            let flat_silent = get_map_key_type_raw(lookup_name) < 0 && get_map_value_type_raw(lookup_name) < 0
            let tid_heads = mpt.ok != 0 && flat_silent
            dbg_trace("mappair", "forin name={lookup_name} mpt_ok={mpt.ok} flat_silent={flat_silent} tid_heads={tid_heads}")
            let key_ct = if tid_heads { mpt.key_ct } else { get_map_key_type(lookup_name) }
            let key_struct = if tid_heads { mpt.key_struct } else { get_map_key_struct(lookup_name) }
            // The flat value channel can record an Option/Result value's HEAD
            // (tp_child2_kind = CT_OPTION) but never a carrier NAME, and a carrier's C type is
            // only nameable WITH its inner — c_type_str has no arm for a bare CT_OPTION, so it
            // falls through to "void" and the pair tuple is emitted with `void _1;`: the loudest
            // useless failure available, a cc error with no Blink span. The tid names the
            // value whole, so read the carrier off the receiver and put its TAG in the tuple's
            // elem_structs slot, exactly as resolve_tuple_ann does for an annotated
            // `(Int, Option[Int])`: the field is then emitted BY VALUE as `blink_Option_int _1;`
            // and map_pair_value_read_expr's struct arm reads it back as
            // `*(blink_Option_int*)values[i]` — which is what emit_boxed_container_store has been
            // storing for this value all along.
            //
            // Only CT_OPTION / CT_RESULT are taken here, because only they have no nameable field
            // type. A Map, a Set, a List, a struct and a scalar value all name their tuple field
            // correctly, and for a container that field is a POINTER (`blink_list*`), not a
            // by-value carrier — routing them through the carrier arm would change a working
            // spelling. Their INNER is handled by mpt above instead: the head
            // spelling stays exactly as it was, and only the element — which no flat channel can
            // hold — comes from the tid. Declining likewise leaves the flat spelling in charge;
            // what must never happen again is spelling the absence as `void`.
            let mvc = map_val_carrier_from_recv(iter_node)
            let carrier_val = mvc.ct == CT_OPTION || mvc.ct == CT_RESULT
            // Canonicalized because resolve_tuple_ann canonicalizes too, and an annotated
            // `(Str, Option[Int])` elsewhere in the program registers the SAME Tuple2 c_name:
            // ensure_tuple_type keeps whichever registration arrives first, so the two callers
            // must spell the tag and the type slot identically or one shape silently shadows the
            // other.
            let carrier_tag = canonical_struct_tag(mvc.tag)
            // The carrier arm keeps first refusal: it is the only one that spells an
            // Option/Result value at all (both its ct AND a nameable tag), and it reads the same
            // receiver tid, so agreeing with it costs nothing and overriding it would lose that.
            let val_ct = if carrier_val { mvc.ct } else if tid_heads { mpt.val_ct } else { get_map_value_type(lookup_name) }
            let val_struct = if carrier_val { carrier_tag } else if tid_heads { mpt.val_struct } else { get_map_value_struct(lookup_name) }
            if carrier_val {
                ensure_carrier_from_tag(carrier_tag)
            }
            if val_ct == CT_LIST || val_ct == CT_SET {
                map_val_ct = val_ct
                // Unconditionally tid-led, unlike the heads: `extra` is a single integer, so the
                // flat pool can spell this element's ct and never its struct name. It stays as the
                // fallback for a receiver with no tid memo, where a ct alone still beats nothing.
                if mpt.ok != 0 && (mpt.val_elem_ct >= 0 || mpt.val_elem_struct != "") {
                    map_val_nested_ct = mpt.val_elem_ct
                    map_val_nested_struct = mpt.val_elem_struct
                } else {
                    map_val_nested_ct = get_map_value_list_elem(lookup_name)
                }
                dbg_trace("mappair", "forin nested val_ct={val_ct} nested_ct={map_val_nested_ct} nested_struct={map_val_nested_struct}")
            }
            let key_tag = if key_struct != "" { key_struct } else { c_type_tag(key_ct) }
            let val_tag = if val_struct != "" { val_struct } else { c_type_tag(val_ct) }
            let tuple_tag = "Tuple2_{key_tag}_{val_tag}"
            let key_type_csv = if key_struct != "" { "{CT_VOID}" } else { "{key_ct}" }
            // A carrier keeps its real CT in the type slot (CT_OPTION / CT_RESULT), matching
            // resolve_tuple_ann's `compound_tag_ct(carrier_tag)`; only a struct/enum element takes
            // the CT_VOID-plus-name convention.
            let val_type_csv = if carrier_val { "{mvc.ct}" } else if val_struct != "" { "{CT_VOID}" } else { "{val_ct}" }
            let key_struct_csv = if key_struct != "" { key_struct } else { "-" }
            let val_struct_csv = if val_struct != "" { val_struct } else { "-" }
            // The erased-recovery-failure default is now -1 (get_map_key_type /
            // get_map_value_type no longer fabricate CT_STRING / CT_INT) — never
            // CT_VOID — so a scalar CT_VOID reading here can only be a genuinely
            // Void key/value type, safe to name.
            let key_name_csv = if key_struct == "" && key_ct == CT_VOID { "Void" } else { "" }
            let val_name_csv = if val_struct == "" && val_ct == CT_VOID { "Void" } else { "" }
            ensure_tuple_type(tuple_tag, 2, "{key_type_csv},{val_type_csv}", "{key_struct_csv},{val_struct_csv}", "{key_name_csv},{val_name_csv}")
            let tuple_c = c_type_c_name(tuple_tag)
            let lst = fresh_temp("_mapl_")
            let stride_var = fresh_temp("_mstride_")
            let i_var = fresh_temp("_mi_")
            let map_var = fresh_temp("_mapv_")
            // `iter_str` may be a non-trivial expression (a call, a method chain) --
            // it is referenced 5x below (kops, cap, states, key slot, values), so it
            // must be evaluated into a temp exactly once rather than re-spliced
            // verbatim, or a side-effecting/allocating iterable (e.g. `for (k, v) in
            // make_map()`) would re-run once per reference and each reference could
            // observe a different underlying map.
            emit_line("blink_map* {map_var} = {iter_str};")
            emit_line("blink_list* {lst} = blink_list_new();")
            emit_line("size_t {stride_var} = blink_kops_stride({map_var}->kops);")
            emit_line("for (int64_t {i_var} = 0; {i_var} < {map_var}->cap; {i_var}++) \{")
            cg_indent = cg_indent + 1
            emit_line("if ({map_var}->states[{i_var}] != 1) continue;")
            let slot_expr = "blink_map_key_slot({map_var}, {i_var}, {stride_var})"
            let key_read = map_pair_key_read_expr(slot_expr, key_ct, key_struct)
            let val_read = map_pair_value_read_expr("{map_var}->values[{i_var}]", val_ct, val_struct)
            let pair_var = fresh_temp("_mpair_")
            emit_line("{tuple_c} {pair_var} = \{ ._0 = {key_read}, ._1 = {val_read} };")
            emit_boxed_container_store("blink_list_push({lst}, ", pair_var, CT_VOID, tuple_tag, "")
            cg_indent = cg_indent - 1
            emit_line("}")
            finish_enum_zip_result(lst, tuple_tag)
            // _mapl_ is a synthesized List[(K,V)] temp; finish_enum_zip_result set its
            // element tuple only on the flat sname2 (a tuple names no list_tid). The map
            // node's iteration element is the interned (K,V) pair tuple, so wrap it in a
            // list tid and stamp the temp — the tid then leads in get_list_elem_struct,
            // which spells the same tuple via find_tuple_entry and cedes to the flat
            // channel otherwise. Mirrors stamp_enum_zip_result_tid on the eager sibling.
            let mapl_elem = tc_tid_subst_mono(tc_tid_resolved(tc_tid_iter_elem(tc_tid_resolved(tc_lookup_node_tid(iter_node)))), cg_mono_tparams_sl, cg_mono_arg_tids)
            if mapl_elem >= 0 { set_var_ty(lst, make_list_type(mapl_elem)) }
            iter_str = lst
            iter_type = CT_LIST
        }
        if iter_type == CT_LIST {
            let mut elem_type = expr_list_elem_type
            if elem_type == -1 { elem_type = get_list_elem_type(iter_str) }
            if elem_type == -1 { elem_type = CT_INT }
            let mut elem_struct = get_list_elem_struct(iter_str)
            // `for k in m.keys()` iterates the producer directly, with no ScopeVar in between; the
            // let-bound spelling is stamped in emit_let_binding. Both read the same predicate.
            let keys_elem = map_keys_boxed_elem(iter_node)
            if keys_elem != "" {
                elem_type = CT_VOID
                elem_struct = keys_elem
            }
            // A PLAIN (payload-less) enum element is the one named element kind the flat
            // pair cannot spell honestly. A list slot holds it VALUE-boxed, exactly like an Int
            // (`blink_list_push(l, (void*)(intptr_t)blink_Col_Red)`), because the variant
            // expression evaluates as CT_INT with no struct name. set_list_elem_struct now
            // records that boxing (CT_INT, no name) rather than the pointer-boxing a name
            // asserts, so the flat pair alone can no longer separate this element from an Int —
            // and the loop variable's ENUM IDENTITY still has to reach method dispatch, since
            // `.to_str()` on a str-backed variant reads it off var_enums. Only the tid holds
            // both facts at once, so ask it, and register the name without moving the storage.
            let mut plain_enum_name = ""
            // `elem_struct == ""` is the whole gate on the value-boxing repair: after the
            // set_list_elem_struct reject, a plain enum can only carry a name here when a caller
            // recorded genuine pointer boxing on purpose (set_list_elem_named_boxed), and that
            // record has to win. No producer does that for a plain enum, but the gate
            // stays because it is the reject's own invariant, not a statement about producers.
            if elem_struct == "" && (elem_type == CT_INT || elem_type == CT_VOID || elem_type == CT_ENUM || elem_type == CT_STRUCT) {
                let mut ne = list_named_elem_of(iter_str)
                if ne.name == "" {
                    // A struct FIELD (`for c in h.cols`) is not a variable, so iter_str is a C
                    // expression with no ScopeVar behind it and the name probe answers nothing.
                    // A Set arrives here as a temp list too (blink_set_to_list, above), and that
                    // temp has no tid either. The iterable's element tid reaches both.
                    let etid = tc_tid_subst_mono(tc_tid_resolved(tc_tid_iter_elem(tc_tid_resolved(tc_lookup_node_tid(iter_node)))), cg_mono_tparams_sl, cg_mono_arg_tids)
                    ne = named_elem_of_elem_tid(etid)
                }
                if ne.plain_enum {
                    elem_type = CT_INT
                    elem_struct = ""
                    plain_enum_name = ne.name
                } else if ne.name != "" {
                    // The recovery answers {tag, name, plain_enum} and the plain-enum arm above
                    // reads one field of it. A struct element answers a name here, and dropping
                    // it leaves the gate's `elem_struct == ""` still true, so the iterator is
                    // emitted over `void`. Only reachable where the flat channels held nothing,
                    // so this adds an answer rather than overriding one.
                    elem_type = CT_STRUCT
                    elem_struct = ne.name
                }
            }
            // A COMPOUND element (`for item in (List[Option[T]])`) is boxed by
            // POINTER on the list. Iterate via the generic pointer iterator
            // (blink_list_into_iter_int, values = intptr_t) and materialize each `item`
            // as the concrete carrier, binding it as CT_OPTION/CT_RESULT so a body
            // `match item { Some(v) => .. }` decodes the inner. Without this the bare
            // `else` below keys the iterator on c_type_tag(CT_OPTION)="option" and
            // emits the undefined blink_Option_option / blink_ListIterator_option_next.
            if elem_type == CT_OPTION || elem_type == CT_RESULT {
                // The element's inner tp(s) drive the carrier tag
                // (tp_carrier_tag) so a nested container — `for m in
                // (List[Option[Map[K,V]]])` — spells `Option_Map_int_str`, not the
                // lossy `Option_map`. The Option inner tp is also stamped onto the
                // loop var so a body `match item { Some(mm) => mm.get(k) }` decodes V.
                let oi_tp = get_list_elem_option_inner_tp(iter_str)
                let rok_tp = get_list_elem_result_ok_tp(iter_str)
                let rerr_tp = get_list_elem_result_err_tp(iter_str)
                let carrier = if elem_type == CT_OPTION {
                    let oi_ct = get_list_elem_option_inner(iter_str)
                    let oi_struct = get_list_elem_option_inner_struct(iter_str)
                    if oi_tp >= 0 { "Option_{tp_carrier_tag(oi_tp)}" } else if oi_struct != "" { "Option_{c_type_tag_for_struct(oi_struct)}" } else if oi_ct >= 0 { "Option_{c_type_tag(oi_ct)}" } else { "Option_int" }
                } else {
                    let rok_ct = get_list_elem_result_ok(iter_str)
                    let rerr_ct = get_list_elem_result_err(iter_str)
                    let rok_struct = get_list_elem_result_ok_struct(iter_str)
                    let rerr_struct = get_list_elem_result_err_struct(iter_str)
                    let ok_tag = if rok_tp >= 0 { tp_carrier_tag(rok_tp) } else if rok_struct != "" { c_type_tag_for_struct(rok_struct) } else if rok_ct >= 0 { c_type_tag(rok_ct) } else { "int" }
                    let err_tag = if rerr_tp >= 0 { tp_carrier_tag(rerr_tp) } else if rerr_struct != "" { c_type_tag_for_struct(rerr_struct) } else if rerr_ct >= 0 { c_type_tag(rerr_ct) } else { "str" }
                    "Result_{ok_tag}_{err_tag}"
                }
                ensure_carrier_from_tag(carrier)
                ensure_iter_type(CT_INT)
                let li_type = list_iter_c_type(CT_INT)
                let opt_type = option_c_type(CT_INT)
                let iter_var = fresh_temp("__iter_")
                let next_var = fresh_temp("__next_")
                emit_line("{li_type} {iter_var} = blink_list_into_iter_int({iter_str});")
                emit_line("while (1) \{")
                cg_indent = cg_indent + 1
                emit_line("{opt_type} {next_var} = {li_type}_next(&{iter_var});")
                emit_line("if ({next_var}.tag == 0) break;")
                let carrier_c = c_type_from_tag(carrier)
                emit_line("{carrier_c} {c_var_name} = *({carrier_c}*)(intptr_t){next_var}.value;")
                push_scope()
                if elem_type == CT_OPTION {
                    let oi_ct = get_list_elem_option_inner(iter_str)
                    let oi_struct = get_list_elem_option_inner_struct(iter_str)
                    set_var(var_name, CT_OPTION, 0)
                    // A nested container inner (Map/List) binds the loop var
                    // through the full carrier tag (`Option_Map_int_str`) so a body
                    // `match item { Some(mm) => mm.get(k) }` reads the Map struct tag
                    // and recovers K/V. The flat set_var_option(CT_MAP) path would
                    // leave the var as the lossy `Option_map` and re-erase V to Int.
                    if oi_tp >= 0 && (tp_get_kind(oi_tp) == CT_MAP || tp_get_kind(oi_tp) == CT_LIST) {
                        set_var_option_from_struct_tag(var_name, carrier)
                        set_var_option_inner_tp(var_name, oi_tp)
                    } else if oi_struct != "" {
                        set_var_option_struct(var_name, CT_INT, oi_struct)
                    } else {
                        set_var_option(var_name, if oi_ct >= 0 { oi_ct } else { CT_INT })
                    }
                } else {
                    set_var(var_name, CT_RESULT, 0)
                    let rok_ct = get_list_elem_result_ok(iter_str)
                    let rerr_ct = get_list_elem_result_err(iter_str)
                    let rok_struct = get_list_elem_result_ok_struct(iter_str)
                    let rerr_struct = get_list_elem_result_err_struct(iter_str)
                    // A nested container on either side binds the loop var
                    // through the full Result carrier tag (`Result_Map_int_str_str`)
                    // so a body `match item { Ok(mm) => mm.get(k) }` reads the correct
                    // side carrier. The flat set_var_result(CT_MAP,..) path leaves the
                    // var as the lossy `Result_map_str`.
                    let ok_is_container = rok_tp >= 0 && (tp_get_kind(rok_tp) == CT_MAP || tp_get_kind(rok_tp) == CT_LIST)
                    let err_is_container = rerr_tp >= 0 && (tp_get_kind(rerr_tp) == CT_MAP || tp_get_kind(rerr_tp) == CT_LIST)
                    if ok_is_container || err_is_container {
                        set_var_result_from_struct_tag(var_name, carrier)
                    } else if rok_struct != "" || rerr_struct != "" {
                        set_var_result_struct(var_name, if rok_ct >= 0 { rok_ct } else { CT_INT }, if rerr_ct >= 0 { rerr_ct } else { CT_STRING }, rok_struct, rerr_struct)
                    } else {
                        set_var_result(var_name, if rok_ct >= 0 { rok_ct } else { CT_INT }, if rerr_ct >= 0 { rerr_ct } else { CT_STRING })
                    }
                }
                forin_measure_var(var_name, iter_node, node)
                emit_block(node_body(node))
                pop_scope()
                cg_indent = cg_indent - 1
                emit_line("}")
            } else if elem_struct != "" {
                ensure_iter_type(CT_INT)
                let li_type = list_iter_c_type(CT_INT)
                let opt_type = option_c_type(CT_INT)
                let iter_var = fresh_temp("__iter_")
                let next_var = fresh_temp("__next_")
                emit_line("{li_type} {iter_var} = blink_list_into_iter_int({iter_str});")
                emit_line("while (1) \{")
                cg_indent = cg_indent + 1
                emit_line("{opt_type} {next_var} = {li_type}_next(&{iter_var});")
                emit_line("if ({next_var}.tag == 0) break;")
                let struct_c = c_type_c_name(elem_struct)
                if is_opaque_type(elem_struct) != 0 {
                    // An @ffi.opaque handle rides the list slot inline (one machine word),
                    // so recover it with a single cast -- never deref like a heap-boxed struct.
                    emit_line("{struct_c} {c_var_name} = ({struct_c})(intptr_t){next_var}.value;")
                } else {
                    emit_line("{struct_c} {c_var_name} = *({struct_c}*)(intptr_t){next_var}.value;")
                }
                push_scope()
                // A push/.set-built compound list records the element via
                // the struct-tag convention (elem_struct = "Option_int", elem_type
                // CT_VOID) rather than the nested-tp convention the compound branch
                // above keys on. The materialized item IS the compound carrier, so bind
                // it as CT_OPTION/CT_RESULT (not a plain struct) so a body `match item`
                // decodes the inner. ensure_carrier_from_tag guarantees the typedef.
                if is_compound_tag(elem_struct) != 0 {
                    ensure_carrier_from_tag(canonical_struct_tag(elem_struct))
                    if elem_struct.starts_with("Option_") {
                        let oi_ct = option_inner_ct_from_tag(elem_struct)
                        let oi_struct = option_inner_struct_from_tag(elem_struct)
                        set_var(var_name, CT_OPTION, 0)
                        if oi_struct != "" {
                            set_var_option_struct(var_name, CT_INT, oi_struct)
                        } else {
                            set_var_option(var_name, oi_ct)
                        }
                    } else if elem_struct.starts_with("Result_") {
                        let parts = split_result_compound(elem_struct)
                        let ok_struct = typedef_tag_or_empty(parts.first)
                        let err_struct = typedef_tag_or_empty(parts.second)
                        let ok_ct = type_from_name_tag(parts.first)
                        let err_ct = type_from_name_tag(parts.second)
                        set_var(var_name, CT_RESULT, 0)
                        set_var_result(var_name, ok_ct, err_ct)
                        if ok_struct != "" || err_struct != "" {
                            set_var_result_struct(var_name, ok_ct, err_ct, ok_struct, err_struct)
                        }
                    } else {
                        set_var(var_name, CT_VOID, 0)
                        set_var_struct(c_var_name, elem_struct)
                    }
                    forin_measure_var(var_name, iter_node, node)
                    emit_block(node_body(node))
                    pop_scope()
                    cg_indent = cg_indent - 1
                    emit_line("}")
                } else {
                set_var(var_name, CT_VOID, 0)
                set_var_struct(c_var_name, elem_struct)
                if is_enum_type(elem_struct) != 0 {
                    var_enums.push(VarEnumEntry { name: var_name, enum_type: elem_struct })
                }
                let for_pat_node = node_elements(node)
                if for_pat_node != -1 {
                    emit_tuple_destructure(for_pat_node, c_var_name, elem_struct, 0)
                    // `for (k, v) in <Map[K, List[V]] or Map[K, Set[V]]>`: emit_tuple_destructure
                    // binds `v` as a bare CT_LIST/CT_SET with no nested-element channel of its
                    // own, so propagate the Map's own tracked nested type here -- otherwise a
                    // body `for x in v` would fall back to get_list_elem_type/get_set_elem_type's
                    // weak default instead of the Map's real value element type.
                    // Two corrections to the propagation above:
                    //
                    //  1. node_elements(<ForIn>) answers the tuple-pattern NODE, not that node's
                    //     element sublist — emit_tuple_destructure re-derives the sublist itself,
                    //     which is why passing the node to it is right. sublist_length/sublist_get
                    //     would otherwise read a node id as a sublist id, misreading the arity of
                    //     `for (k, v) in m` and rejecting every two-element pattern.
                    //  2. A struct/enum element carries its ct in the CT_VOID-plus-name
                    //     convention, so the ct alone reads as -1 and the name is the whole answer
                    //     — hence the `|| map_val_nested_struct != ""` half of the guard. Writing
                    //     the name is what turns `v.get(0).unwrap().x` from the `<value>`
                    //     placeholder into a field read.
                    let pat_elems_sl = node_elements(for_pat_node)
                    let have_nested = map_val_nested_ct >= 0 || map_val_nested_struct != ""
                    if have_nested && pat_elems_sl != -1 && sublist_length(pat_elems_sl) > 1 {
                        let val_pat = sublist_get(pat_elems_sl, 1)
                        if node_kind(val_pat) != NodeKind.WildcardPattern {
                            let val_name = node_name(val_pat)
                            if map_val_ct == CT_LIST {
                                if map_val_nested_ct >= 0 { set_list_elem_type(val_name, map_val_nested_ct) }
                                if map_val_nested_struct != "" { set_list_elem_struct(val_name, map_val_nested_struct) }
                            } else if map_val_ct == CT_SET {
                                if map_val_nested_ct >= 0 { set_set_elem_type(val_name, map_val_nested_ct) }
                                if map_val_nested_struct != "" { set_set_elem_struct(val_name, map_val_nested_struct) }
                            }
                        }
                    }
                }
                forin_measure_var(var_name, iter_node, node)
                emit_block(node_body(node))
                pop_scope()
                cg_indent = cg_indent - 1
                emit_line("}")
                }
            } else {
                ensure_iter_type(elem_type)
                let tag = c_type_tag(elem_type)
                let li_type = list_iter_c_type(elem_type)
                let opt_type = option_c_type(elem_type)
                let iter_var = fresh_temp("__iter_")
                let next_var = fresh_temp("__next_")
                emit_line("{li_type} {iter_var} = blink_list_into_iter_{tag}({iter_str});")
                emit_line("while (1) \{")
                cg_indent = cg_indent + 1
                emit_line("{opt_type} {next_var} = {li_type}_next(&{iter_var});")
                emit_line("if ({next_var}.tag == 0) break;")
                let binder_c = forin_binder_ctype(var_name, iter_node, node, "forin.binder", c_type_str(elem_type))
                emit_line("{binder_c} {c_var_name} = {next_var}.value;")
                push_scope()
                set_var(var_name, elem_type, 0)
                // The loop var of a plain-enum element is an ordinal, but it still needs
                // its enum recorded so a body's BARE match variant (`Red =>`) resolves — the
                // struct branch above does the same for a data enum.
                if plain_enum_name != "" {
                    var_enums.push(VarEnumEntry { name: var_name, enum_type: plain_enum_name })
                }
                // A CONTAINER element binds the loop var to a Map, a List or a Set, and
                // every flat channel below reads the ITERABLE's ScopeVar. A call, a method result or
                // a struct field has no ScopeVar, so those reads answer -1 and sv_tp fabricates —
                // `Map[Str, Int]` for the pair it never saw. The binder's own type is the iterable's
                // element tid, which typecheck has whole, so ask it. It runs BEFORE the flat copies
                // so a stamp that declines leaves them their answer, and after set_var, which
                // rebuilds the var's tp and would discard an earlier write.
                if elem_type == CT_MAP || elem_type == CT_LIST || elem_type == CT_SET {
                    let binder_tid = tc_tid_subst_mono(tc_tid_resolved(tc_tid_iter_elem(tc_tid_resolved(tc_lookup_node_tid(iter_node)))), cg_mono_tparams_sl, cg_mono_arg_tids)
                    stamp_binder_from_binder_tid(binder_tid, var_name, 0)
                }
                if elem_type == CT_LIST {
                    let nested_et = get_list_nested_elem_type(iter_str)
                    if nested_et != -1 {
                        set_list_elem_type(var_name, nested_et)
                    }
                    let nested_es = get_list_nested_elem_struct(iter_str)
                    if nested_es != "" {
                        set_list_elem_struct(var_name, nested_es)
                    }
                } else if elem_type == CT_SET {
                    // A List[Set[T]] for-in materializes each element as a Set: carry
                    // the inner Set's own element type/struct (stamped at declare time,
                    // see the elem_ct == CT_SET branch below) so a nested `for x in
                    // inner_set` finds the real element instead of hitting the
                    // loud SetElementTypeUnknownAtCodegen ICE.
                    let nested_et = get_list_nested_elem_type(iter_str)
                    if nested_et != -1 {
                        set_set_elem_type(var_name, nested_et)
                    }
                    let nested_es = get_list_nested_elem_struct(iter_str)
                    if nested_es != "" {
                        set_set_elem_struct(var_name, nested_es)
                    }
                }
                forin_measure_var(var_name, iter_node, node)
                emit_block(node_body(node))
                pop_scope()
                cg_indent = cg_indent - 1
                emit_line("}")
            }
        } else if iter_type == CT_ITERATOR {
            let elem_type = get_var_iterator_inner(iter_str)
            let next_fn = get_var_iter_next_fn(iter_str)
            let opt_type = option_c_type(elem_type)
            let _iter_var = fresh_temp("__iter_")
            let next_var = fresh_temp("__next_")
            emit_line("while (1) \{")
            cg_indent = cg_indent + 1
            emit_line("{opt_type} {next_var} = (({opt_type} (*)(void*)){next_fn})(&{iter_str});")
            emit_line("if ({next_var}.tag == 0) break;")
            // A lazy adapter over a List of a NAMED BY-VALUE element (`for p in
            // l.filter(..)`) yields the pointer-boxed element through a CT_INT iterator and
            // carries the element's identity on the iterator var's carrier tag. Without the
            // deref the loop var binds as int64_t and the body's `p.x` reaches cc as a member
            // read on a non-struct. Scoped to a named tag: a COMPOUND carrier here is rejected
            // earlier by typecheck (`.unwrap()` on the loop var reports unresolved), so wiring
            // it would be unexercised surface.
            let iter_carrier = get_var_iter_carrier(iter_str)
            let named_carrier = if iter_carrier != "" && is_compound_tag(iter_carrier) == 0 { iter_carrier } else { "" }
            if named_carrier != "" {
                let carrier_c = c_type_from_tag(named_carrier)
                emit_line("{carrier_c} {c_var_name} = *({carrier_c}*)(intptr_t){next_var}.value;")
                push_scope()
                set_var(var_name, CT_VOID, 0)
                set_var_struct(var_name, named_carrier)
            } else {
                let adapter_binder_c = forin_binder_ctype(var_name, iter_node, node, "forin.adapter_binder", c_type_str(elem_type))
                emit_line("{adapter_binder_c} {c_var_name} = {next_var}.value;")
                push_scope()
                set_var(var_name, elem_type, 0)
                // The STORAGE of a plain-enum element is an ordinal and the iterator
                // yields it correctly here, but its IDENTITY reaches the body only through
                // var_enums — that is what `.to_str()` on a str-backed variant and a bare match
                // variant read. Same split, and the same fix, as the direct list arm above; only
                // the tid holds the name once the element is boxed like an Int.
                let adapter_elem = named_elem_of_elem_tid(tc_tid_subst_mono(tc_tid_resolved(tc_tid_iter_elem(tc_tid_resolved(tc_lookup_node_tid(iter_node)))), cg_mono_tparams_sl, cg_mono_arg_tids))
                if adapter_elem.plain_enum {
                    var_enums.push(VarEnumEntry { name: var_name, enum_type: adapter_elem.name })
                }
            }
            forin_measure_var(var_name, iter_node, node)
            emit_block(node_body(node))
            pop_scope()
            cg_indent = cg_indent - 1
            emit_line("}")
        } else if iter_type == CT_CHANNEL {
            let ch_inner = get_var_channel_inner(iter_str)
            // The element type comes from the ITERABLE's tid, with the flat field kept
            // as the fallback for a channel whose element nothing knows. The
            // NULL test below is the end-of-stream signal and is sound only because `send`
            // boxes — a raw `(void*)(intptr_t)0` element is indistinguishable from it, which
            // would drop a sent 0 and every value behind it. Both fallback arms below dereference
            // the box for the same reason, so every channel keeps that invariant.
            let ch_tid = tc_lookup_node_tid(iter_node)
            let elem_ct = tc_channel_elem_ct(ch_tid)
            let recv_tmp = fresh_temp("__chrecv_")
            emit_line("while (1) \{")
            cg_indent = cg_indent + 1
            emit_line("void* {recv_tmp} = blink_channel_recv({iter_str});")
            emit_line("if ({recv_tmp} == NULL) break;")
            if elem_ct >= 0 {
                let elem_sname = tc_channel_elem_struct(ch_tid)
                let elem_c = chan_elem_c_type(elem_ct, elem_sname)
                emit_line("{elem_c} {c_var_name} = *({elem_c}*){recv_tmp};")
                push_scope()
                set_var(var_name, elem_ct, 0)
                if elem_ct == CT_STRUCT {
                    set_var_struct(var_name, elem_sname)
                }
            } else if ch_inner == CT_STRING {
                // Unwrap the box the send fallback writes before reinterpreting. No NULL guard
                // is needed here — unlike the `.recv()` twin, the `if (recv_tmp == NULL) break;`
                // above has already left the loop, and the box address is never NULL, so a sent 0
                // does not read as end-of-stream and truncate the drain.
                emit_line("const char* {c_var_name} = (const char*)*(void**){recv_tmp};")
                push_scope()
                set_var(var_name, CT_STRING, 0)
            } else {
                emit_line("int64_t {c_var_name} = (int64_t)(intptr_t)*(void**){recv_tmp};")
                push_scope()
                set_var(var_name, CT_INT, 0)
            }
            forin_measure_var(var_name, iter_node, node)
            emit_block(node_body(node))
            pop_scope()
            cg_indent = cg_indent - 1
            emit_line("}")
        } else if iter_type == CT_STRING {
            ensure_str_iter()
            let iter_var = fresh_temp("__str_iter_")
            let next_var = fresh_temp("__str_next_")
            let opt_type = option_c_type(CT_STRING)
            emit_line("blink_StrIterator {iter_var} = \{ .str = {iter_str}, .index = 0, .len = blink_str_len({iter_str}) };")
            emit_line("while (1) \{")
            cg_indent = cg_indent + 1
            emit_line("{opt_type} {next_var} = blink_StrIterator_next(&{iter_var});")
            emit_line("if ({next_var}.tag == 0) break;")
            emit_line("const char* {c_var_name} = {next_var}.value;")
            push_scope()
            set_var(var_name, CT_STRING, 0)
            forin_measure_var(var_name, iter_node, node)
            emit_block(node_body(node))
            pop_scope()
            cg_indent = cg_indent - 1
            emit_line("}")
        } else {
            diag_ice_at("UnhandledIterableAtCodegen", UNHANDLED_ITERABLE_AT_CODEGEN,
                "for-in over '{type_name_from_ct(iter_type)}' passed the front-end iterable check but has no codegen loop emitter",
                iter_node,
                "this is a compiler bug — please report it with the smallest reproducing program")
        }
    }
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_if_stmt(node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    emit_expr(node_condition(node))
    let cond_str = strip_outer_parens(expr_result_str)
    emit_line("if ({cond_str}) \{")
    cg_indent = cg_indent + 1
    emit_block(node_then_body(node))
    cg_indent = cg_indent - 1
    if node_else_body(node) != -1 {
        let else_b = node_else_body(node)
        let else_stmts = node_stmts(else_b)
        // Check for else-if chain
        if else_stmts != -1 && sublist_length(else_stmts) == 1 {
            let inner = sublist_get(else_stmts, 0)
            if node_kind(inner) == NodeKind.IfExpr {
                let saved_lines2 = cg_lines
                cg_lines = []
                emit_expr(node_condition(inner))
                let hoisted_lines = cg_lines
                cg_lines = saved_lines2
                if hoisted_lines.len() > 0 {
                    emit_line("} else \{")
                    cg_indent = cg_indent + 1
                    emit_if_stmt(inner)
                    cg_indent = cg_indent - 1
                } else {
                    let inner_cond = strip_outer_parens(expr_result_str)
                    emit_line("} else if ({inner_cond}) \{")
                    cg_indent = cg_indent + 1
                    emit_block(node_then_body(inner))
                    cg_indent = cg_indent - 1
                    if node_else_body(inner) != -1 {
                        emit_line("} else \{")
                        cg_indent = cg_indent + 1
                        emit_block(node_else_body(inner))
                        cg_indent = cg_indent - 1
                    }
                }
                emit_line("}")
                return
            }
        }
        emit_line("} else \{")
        cg_indent = cg_indent + 1
        emit_block(else_b)
        cg_indent = cg_indent - 1
    }
    emit_line("}")
}

pub fn emit_block(block: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    if block == -1 {
        return
    }
    let stmts_sl = node_stmts(block)
    if stmts_sl == -1 {
        return
    }
    let mut i = 0
    while i < sublist_length(stmts_sl) {
        emit_stmt(sublist_get(stmts_sl, i))
        i = i + 1
    }
}

// __ With-block codegen __

fn emit_bh_setup(struct_name: Str, handler_str: Str, binding: Str, ctx_tid: Int, ctx_node: Int, bh_state_vars: List[Str]) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    emit_bh_cleanup_for_type(struct_name)
    let c_type = c_type_c_name(struct_name)
    let enter_fn = c_fn_name(mangle_impl_method_q(struct_name, "BlockHandler", "enter"))
    let bh_tmp = fresh_temp("__bh_")
    emit_line("{c_type} {bh_tmp} = {handler_str};")
    let st_var = fresh_temp("__bh_st_")
    emit_line("__blink_bh_state_{c_type} {st_var} __attribute__((cleanup(__blink_bh_cleanup_{c_type}))) = \{ .handler = {bh_tmp}, .ok = 0, .entered = 0, .done = 0 };")
    if binding != "" {
        let ctx_type_name = lookup_assoc_type(struct_name, "Context")
        if ctx_type_name != "" {
            let ctx_c_type = if is_struct_type(ctx_type_name) != 0 {
                // A struct Context keeps its physical spelling — the tid's logical answer
                // cannot be substituted where the storage type is a struct.
                c_type_c_name(ctx_type_name)
            } else {
                let flat = c_type_str(type_from_name(ctx_type_name))
                ctype_probe_at(ctx_tid, "bh_context_flat", binding, flat, ctx_node)
                let spelled = c_type_from_tid(ctx_tid)
                // The binder is a STORAGE position, so a genuine Void keeps the flat placeholder.
                // The binder tid also FALLS BACK to the resource tid whenever the Context is Void
                // or a carrier the name channel cannot reconstruct (Option/Result/Tuple) — see
                // tc_with_binder_tid — so a tid that spells the resource's own type is that
                // fallback, not a Context answer, and must keep the flat spelling.
                if spelled != "" && spelled != "void" && spelled != c_type { spelled } else { flat }
            }
            emitted_let_names.push(binding)
            emitted_let_set.insert(binding, 1)
            emit_line("{ctx_c_type} {binding} = {enter_fn}({bh_tmp});")
            set_var(binding, type_from_name(ctx_type_name), 0)
            if is_struct_type(ctx_type_name) != 0 {
                set_var_struct(binding, ctx_type_name)
            }
        } else {
            emit_line("{enter_fn}({bh_tmp});")
        }
    } else {
        emit_line("{enter_fn}({bh_tmp});")
    }
    emit_line("{st_var}.entered = 1;")
    if cg_in_assert_panics != 0 {
        // §2.20 cleanup-on-caught-panic: register this handler so the
        // assert_panics dispatch runs its exit(false) on the longjmp (C
        // __attribute__((cleanup)) does NOT fire on longjmp). The normal-exit
        // attribute-cleanup pops this entry; `done` prevents a double exit.
        emit_line("__blink_cleanup_push((void*)&{st_var}, __blink_bh_run_{c_type}, &{st_var}.done);")
    }
    bh_state_vars.push(st_var)
}

pub fn emit_with_block(node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    emit_with_block_core(node, 0, "")
}

// Shared body emission for `with { … }` in both statement and expression form.
// is_expr=1 requests capture-and-promote at the end: the body's tail expression
// is copied into `result_sink` (a caller-allocated C variable) via the walker
// for `result_desc`, after which the inner arena is torn down manually rather
// than via the __attribute__((cleanup)) path. For is_expr=0 the arena handler
// uses the RAII cleanup attribute as before.
@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_with_block_core(node: Int, is_expr: Int, result_sink: Str) -> Str ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let handlers_sl = node_handlers(node)
    let body = node_body(node)
    if handlers_sl == -1 {
        emit_block(body)
        return ""
    }
    let count = sublist_length(handlers_sl)
    let mut num_installed_fields = 0
    let mut bh_state_vars: List[Str] = []
    let mut arena_tmp = ""
    let mut arena_prev = ""
    let mut has_arena_handler = 0
    emit_line("\{")
    cg_indent = cg_indent + 1
    let ev_copy = fresh_temp("__ev_with_")
    let mut ev_copy_emitted = 0
    let mut i = 0
    while i < count {
        let item = sublist_get(handlers_sl, i)
        let item_kind = node_kind(item)
        if item_kind == NodeKind.Ident && node_name(item) == "arena" {
            has_arena_handler = 1
            if is_expr != 0 {
                // Manual arena lifecycle: defer destroy until after promotion.
                let ar_tmp = fresh_temp("__arena_")
                let ar_prev = fresh_temp("__arena_prev_")
                emit_line("blink_arena_t* {ar_tmp} = blink_arena_create(BLINK_ARENA_DEFAULT_CHUNK_SIZE);")
                emit_line("blink_arena_t* {ar_prev} = __blink_current_arena;")
                emit_line("__blink_current_arena = {ar_tmp};")
                arena_tmp = ar_tmp
                arena_prev = ar_prev
            } else {
                emit_arena_restore_helper()
                let ar_tmp = fresh_temp("__arena_")
                let ar_st = fresh_temp("__arena_st_")
                emit_line("blink_arena_t* {ar_tmp} = blink_arena_create(BLINK_ARENA_DEFAULT_CHUNK_SIZE);")
                emit_line("__blink_arena_restore_t {ar_st} __attribute__((cleanup(__blink_arena_restore))) = \{ .prev = __blink_current_arena, .arena = {ar_tmp} };")
                emit_line("__blink_current_arena = {ar_tmp};")
            }
            i = i + 1
            continue
        }
        if item_kind == NodeKind.WithResource {
            let binding = node_name(item)
            let res_expr = node_value(item)
            cg_in_ffi_scope_resource = 1
            emit_expr(res_expr)
            cg_in_ffi_scope_resource = 0
            let res_str = expr_result_str
            let res_type = expr_result_type
            let res_struct = get_var_struct(res_str)
            let tmp = fresh_temp("_wr_")
            let mut c_decl = ""
            let mut wr_is_flat = 0
            if res_struct != "" {
                c_decl = c_type_c_name(res_struct)
            } else {
                c_decl = c_type_str(res_type)
                wr_is_flat = 1
            }
            let wr_tid = cg_node_mono_tid(res_expr)
            if wr_is_flat == 0 {
                // A struct resource keeps its own spelling: inside a handler implementation that
                // spelling is the effect slot's erased one, and the two are different structs, so
                // the tid's logical answer cannot be substituted here.
                ctype_probe_at(wr_tid, "with_resource_struct", tmp, c_decl, res_expr)
            } else {
                ctype_probe_at(wr_tid, "with_resource_flat", tmp, c_decl, res_expr)
                let wr_spelled = c_type_from_tid(wr_tid)
                // Both the temp and the binding below are STORAGE positions, so a genuine Void
                // keeps the flat placeholder.
                if wr_spelled != "" && wr_spelled != "void" { c_decl = wr_spelled }
            }
            if res_struct != "" && lookup_impl_type_for_trait("BlockHandler", res_struct) == 1 {
                emit_bh_setup(res_struct, res_str, binding, tc_lookup_node_tid(item), item, bh_state_vars)
            } else if res_struct != "" && lookup_impl_type_for_trait("Closeable", res_struct) == 1 {
                emit_cl_cleanup_for_type(res_struct)
                let cl_c_type = c_type_c_name(res_struct)
                emit_line("{c_decl} {tmp} = {res_str};")
                let cl_st = fresh_temp("__cl_st_")
                emit_line("__blink_cl_state_{cl_c_type} {cl_st} __attribute__((cleanup(__blink_cl_cleanup_{cl_c_type}))) = \{ .resource = {tmp}, .done = 0 };")
                if cg_in_assert_panics != 0 {
                    // §2.20 cleanup-on-caught-panic: register so the dispatch
                    // runs close() on the longjmp (attribute-cleanup won't).
                    emit_line("__blink_cleanup_push((void*)&{cl_st}, __blink_cl_run_{cl_c_type}, &{cl_st}.done);")
                }
                emitted_let_names.push(binding)
                emitted_let_set.insert(binding, 1)
                emit_line("{c_decl} {binding} = {tmp};")
                set_var(binding, res_type, 0)
                set_var_struct(binding, res_struct)
            } else if res_type == CT_FFI_SCOPE {
                // Spec §07:274 — scope frees on every exit path (fall-through,
                // return, ? early return, caught panic). Ride the same
                // attribute((cleanup)) + longjmp dispatch the Closeable path
                // uses; a tail-emitted cleanup would be dead code after a return.
                emit_line("{c_decl} {tmp} = {res_str};")
                let fs_st = fresh_temp("__fs_st_")
                emit_line("__blink_ffi_scope_state {fs_st} __attribute__((cleanup(__blink_ffi_scope_attr_cleanup))) = \{ .scope = {tmp}, .done = 0 };")
                if cg_in_assert_panics != 0 {
                    emit_line("__blink_cleanup_push((void*)&{fs_st}, __blink_ffi_scope_run, &{fs_st}.done);")
                }
                emitted_let_names.push(binding)
                emitted_let_set.insert(binding, 1)
                emit_line("{c_decl} {binding} = {tmp};")
                set_var(binding, res_type, 0)
            } else {
                emit_line("{c_decl} {tmp} = {res_str};")
                emitted_let_names.push(binding)
                emitted_let_set.insert(binding, 1)
                emit_line("{c_decl} {binding} = {tmp};")
                set_var(binding, res_type, 0)
                if res_struct != "" {
                    set_var_struct(binding, res_struct)
                }
            }
            // Stage 2 dual-write for the resource binder. Typecheck publishes the
            // BINDER's tid on the WithResource node, so the ScopeVar the four paths above just
            // built can READ its type instead of leaving `ty` unstamped. Advisory only while the
            // flat fields still govern every emit decision.
            set_var_ty(binding, tc_lookup_node_tid(item))
            // The tap that makes the stamp above countable. There is no `catch` binder to
            // tap alongside it: Blink has no catch clause, effects and Result carry failure.
            let _measured = sv_ty_or_flat_at(binding, "with_resource.bind", item)
        } else {
            // This clear is a BUG FIX rather than tidying. cg_handler_vtable_field is
            // set by emit_expr when the operand is a handler CONSTRUCTION, and it was read below
            // before being cleared — so an operand that sets nothing inherited whatever the last
            // handler expression anywhere earlier in the function had left behind. For example:
            //
            //     let ios = [mk_io()]      // emit_expr leaves field="io"
            //     let ms = [mk_metrics()]  // …then field="metrics", is_ue=1, and nothing clears it:
            //                              //   the `let` only clears on the CT_HANDLER path, and
            //                              //   these two bindings are CT_LIST
            //     let hi = ios.get(0).unwrap()
            //     let hm = ms.get(0).unwrap()
            //     with hi, hm { … }
            //
            // `hi` — the IO handler — read the stale "metrics" and was installed into the
            // `ue_metrics` SLOT, then the clear below emptied the channel so `hm` fell to the
            // `emit_line("{handler_str};")` arm and was discarded as a bare statement: the
            // wrong-vtable-in-a-slot shape, reached with no annotation lie anywhere in the program —
            // `metrics.counter` would dispatch by slot index through an IO vtable. Two things stop
            // it being a crash today — the CT_HANDLER gate below, and `-Wint-conversion` being an
            // error — and neither is a Blink diagnostic.
            //
            // Clearing BEFORE the call is what makes the channel mean "what this operand set". Only
            // the two fields read here are cleared: cg_handler_cleanup_var / cleanup_fn have the
            // same leak shape but govern resource cleanup and are handled separately.
            cg_handler_vtable_field = ""
            cg_handler_is_user_effect = 0
            emit_expr(item)
            let handler_str = expr_result_str
            let handler_type = expr_result_type
            let mut vtable_field = cg_handler_vtable_field
            let mut is_ue = cg_handler_is_user_effect
            let cleanup_var = cg_handler_cleanup_var
            let cleanup_fn = cg_handler_cleanup_fn
            cg_handler_vtable_type = ""
            cg_handler_vtable_field = ""
            cg_handler_is_user_effect = 0
            cg_handler_cleanup_var = ""
            cg_handler_cleanup_fn = ""
            if vtable_field == "" && handler_type == CT_HANDLER {
                vtable_field = get_var_handler_vtable_field(handler_str)
                is_ue = get_var_handler_is_ue(handler_str)
            }
            // The two channels above are both flat and both fail on the same shape: the
            // global is only set by a handler CONSTRUCTION, and the name-keyed recovery is gated on
            // `handler_type == CT_HANDLER`, which a container element's erased CT is not. So a
            // handler read out of a `List` or a `Map` reached neither, fell to the
            // `emit_line("{handler_str};")` arm below and was DISCARDED — its effect never installed,
            // and the `with` body then dispatched through whatever the ambient vtable was.
            //
            // Ordered last: the tid is asked only where the flat channels went
            // blank, so it cannot take an operand away from an arm that already resolved it.
            //
            // Read off the OPERAND NODE's tid, not the binding's: for `with e.h` the operand is the
            // C expression `e.h`, which is not a name in any ScopeVar table, so a binding-keyed
            // lookup misses, the field stays empty, and the operand falls to the
            // `emit_line("{handler_str};")` arm below — a `with` that compiles, runs, exits 0 and
            // installs NOTHING, dispatching the block to the ambient default vtable. Typecheck
            // memoizes the operand node directly, so its tid subsumes what a binding-keyed lookup
            // could answer plus the field-access cases it could not.
            if vtable_field == "" {
                let n_eff = tc_tid_handler_effect(tc_tid_resolved(tc_tid_subst_mono(tc_lookup_node_tid(item), cg_mono_tparams_sl, cg_mono_arg_tids)))
                if n_eff != "" {
                    vtable_field = resolve_effect_field(n_eff)
                    is_ue = resolve_effect_is_ue(n_eff)
                }
            }
            if vtable_field != "" {
                let field_c = if is_ue != 0 { "ue_{vtable_field}" } else { vtable_field }
                if ev_copy_emitted == 0 {
                    let ev_src = if cg_current_fn_has_ev != 0 { "*__ev" } else { "__blink_ev" }
                    emit_line("blink_ev {ev_copy} = {ev_src};")
                    ev_copy_emitted = 1
                    emit_ev_restore_helper()
                }
                emit_line("{ev_copy}.{field_c} = {handler_str};")
                let restore_var = fresh_temp("__ev_restore_")
                emit_line("__blink_ev_restore_t {restore_var} __attribute__((cleanup(__blink_ev_restore))) = \{ .slot = (void**)&__blink_ev.{field_c}, .saved = (void*)__blink_ev.{field_c} };")
                emit_line("__blink_ev.{field_c} = {handler_str};")
                num_installed_fields = num_installed_fields + 1
                if cleanup_var != "" && cleanup_fn != "" {
                    emit_handle_cleanup(cleanup_fn)
                    let cl_tmp = fresh_temp("__hcl_")
                    emit_line("__blink_hcl_state_{cleanup_fn} {cl_tmp} __attribute__((cleanup(__blink_hcl_cleanup_{cleanup_fn}))) = \{ .handle = {cleanup_var} };")
                }
            } else {
                let h_struct = get_var_struct(handler_str)
                if h_struct != "" && lookup_impl_type_for_trait("BlockHandler", h_struct) == 1 {
                    emit_bh_setup(h_struct, handler_str, "", -1, -1, bh_state_vars)
                } else if handler_str != "" {
                    emit_line("{handler_str};")
                }
            }
        }
        i = i + 1
    }
    let saved_has_ev = cg_current_fn_has_ev
    if num_installed_fields > 0 {
        emit_line("blink_ev* __ev = &{ev_copy};")
        cg_current_fn_has_ev = 1
    }
    let mut actual_desc = ""
    if has_arena_handler != 0 {
        cg_with_arena_depth = cg_with_arena_depth + 1
    }
    let pushed_expr_arena = has_arena_handler != 0 && is_expr != 0 && arena_tmp != ""
    if pushed_expr_arena {
        cg_arena_expr_tmp_stack.push(arena_tmp)
        cg_arena_expr_prev_stack.push(arena_prev)
    }
    if is_expr != 0 {
        let target_expr = if arena_prev != "" { arena_prev } else { "NULL" }
        emit_and_log_promote_phase("begin", target_expr, "", node)
        actual_desc = emit_block_then_capture(body, result_sink, arena_prev)
        emit_and_log_promote_phase("end", target_expr, actual_desc, node)
    } else {
        emit_block(body)
    }
    if pushed_expr_arena {
        cg_arena_expr_tmp_stack.pop()
        cg_arena_expr_prev_stack.pop()
    }
    if has_arena_handler != 0 {
        cg_with_arena_depth = cg_with_arena_depth - 1
    }
    cg_current_fn_has_ev = saved_has_ev
    let mut bhi = 0
    while bhi < bh_state_vars.len() {
        emit_line("{bh_state_vars.get(bhi).unwrap()}.ok = 1;")
        bhi = bhi + 1
    }
    if is_expr != 0 && arena_tmp != "" {
        emit_line("__blink_current_arena = {arena_prev};")
        emit_line("blink_arena_destroy({arena_tmp});")
    }
    cg_indent = cg_indent - 1
    emit_line("}")
    actual_desc
}

@allow(UnrestoredMutation)
fn descriptor_from_expr_state() -> Str {
    let ct = expr_result_type
    if ct == CT_INT || ct == CT_FLOAT || ct == CT_BOOL || ct == CT_STRING {
        return ct_to_descriptor(ct, "")
    }
    if ct == CT_STRUCT || ct == CT_VOID {
        let sname = get_var_struct(expr_result_str)
        if sname != "" { return "S:{sname}" }
        return ""
    }
    if ct == CT_LIST {
        let et = if expr_list_elem_type >= 0 { expr_list_elem_type } else { get_list_elem_type(expr_result_str) }
        let es = if expr_list_elem_struct != "" { expr_list_elem_struct } else { get_list_elem_struct(expr_result_str) }
        return "L:{ct_to_descriptor(et, es)}"
    }
    if ct == CT_MAP {
        let kt = if expr_map_key_type >= 0 { expr_map_key_type } else { get_map_key_type(expr_result_str) }
        let vt = if expr_map_val_type >= 0 { expr_map_val_type } else { get_map_value_type(expr_result_str) }
        let vs = get_map_value_struct(expr_result_str)
        return "M:{ct_to_descriptor(kt, "")}|{ct_to_descriptor(vt, vs)}"
    }
    if ct == CT_OPTION {
        let inner_ct = expr_option_inner
        let inner_s = expr_option_inner_struct
        if inner_s != "" {
            ensure_struct_option_type(inner_s)
            return "O:S:{inner_s}"
        }
        ensure_option_type(inner_ct)
        return "O:{payload_desc_for(inner_ct, "")}"
    }
    if ct == CT_RESULT {
        let ok_t = expr_result_ok_type
        let err_t = expr_result_err_type
        let ok_s = expr_result_ok_struct
        let err_s = expr_result_err_struct
        if ok_s != "" || err_s != "" {
            let ok_tag = if ok_s != "" { ok_s } else { c_type_tag(ok_t) }
            let err_tag = if err_s != "" { err_s } else { c_type_tag(err_t) }
            ensure_struct_result_type(ok_tag, err_tag)
        } else {
            ensure_result_type(ok_t, err_t)
        }
        let ok_d = payload_desc_for(ok_t, ok_s)
        let err_d = payload_desc_for(err_t, err_s)
        return "R:{ok_d}|{err_d}"
    }
    ""
}

// Option/Result payloads hold a compound literal for expr_result_str (not a
// var), so list/map metadata can only be read from the last-published globals.
fn payload_desc_for(ct: Int, sname: Str) -> Str {
    if sname != "" { return "S:{sname}" }
    if ct == CT_LIST {
        let et = if expr_list_elem_type >= 0 { expr_list_elem_type } else { -1 }
        let es = expr_list_elem_struct
        return "L:{ct_to_descriptor(et, es)}"
    }
    if ct == CT_MAP {
        let kt = if expr_map_key_type >= 0 { expr_map_key_type } else { CT_STRING }
        let vt = if expr_map_val_type >= 0 { expr_map_val_type } else { -1 }
        return "M:{ct_to_descriptor(kt, "")}|{ct_to_descriptor(vt, "")}"
    }
    ct_to_descriptor(ct, "")
}

// Returns "" for unsupported kinds (caller maps to an E0702 variant).
pub fn descriptor_from_capture(entry: CaptureEntry) -> Str {
    let k = capture_ct(entry.tid, entry.tp_id)
    if k == CT_INT { return "P:Int" }
    if k == CT_BOOL { return "P:Bool" }
    if k == CT_FLOAT { return "P:Float" }
    if k == CT_STRING { return "P:Str" }
    if k == CT_STRUCT {
        let sn = capture_sname(entry.tid, entry.tp_id)
        if sn != "" { return "S:{sn}" }
        return ""
    }
    // tp_to_descriptor walks this same tp_id recursively and produces identical leaves, so
    // spelling the children by hand here bought nothing and reached exactly one level:
    // ct_to_descriptor has no List/Map/Option arm, so an inner container fell through to
    // "P:Int". The arena runtime drives its deep copy off this string, and a slot described as
    // an inline int64_t is bit-copied instead of recursed into — which leaves a nested
    // container, a boxed Option, and a boxed struct element pointing at the ORIGINAL, so far
    // only harmless because E0700 rejects nesting an arena-allocated value into a container.
    if k == CT_LIST || k == CT_MAP || k == CT_OPTION {
        // The tid first: the flat child cell carries no struct name for a capture, so a
        // `List[Point]` element — BOXED in the list, therefore a pointer that must be promoted
        // rather than bit-copied — reached the runtime as "P:Int" through either flat speller.
        let from_tid = tid_to_descriptor(entry.tid)
        if from_tid != "" { return from_tid }
        return tp_to_descriptor(entry.tp_id)
    }
    if k == CT_CLOSURE {
        let sig = tp_get_sname(entry.tp_id)
        return "C:{closure_sig_hash(sig)}"
    }
    ""
}

// `closure_src` must be a C expression of type `blink_closure*` pointing at
// the inner-arena closure. Returns 1 on success, 0 if a carve-out E0702*
// diagnostic was reported instead.
@allow(UnrestoredMutation)
fn emit_closure_tail_promotion(
    closure_src: Str,
    cap_idx: Int,
    tail_node: Int,
    result_sink: Str,
    arena_prev: Str,
    block_local_muts: List[Str],
) -> Int ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let info = closure_cap_infos.get(cap_idx).unwrap()
    let target = if arena_prev != "" { arena_prev } else { "NULL" }

    let mut ci = 0
    while ci < info.count {
        let e = closure_captures.get(info.start + ci).unwrap()
        if descriptor_from_capture(e) == "" {
            diag_error_at(
                "ArenaClosureUnsupportedCapture", ARENA_CLOSURE_UNSUPPORTED_CAP,
                "cannot promote closure tail of 'with arena \{ expr }': capture of unsupported kind",
                tail_node,
                "construct the closure outside the 'with arena \{ }' block"
            )
            return 0
        }
        ci = ci + 1
    }

    // Bind closure_src to a temp — it may be an rvalue (e.g. blink_closure_new_typed(...))
    // and we reference it repeatedly below.
    let src_tmp = fresh_temp("__acl_src_")
    emit_line("blink_closure* {src_tmp} = {closure_src};")

    if info.count == 0 {
        emit_line("{result_sink} = blink_closure_new_typed({src_tmp}->fn_ptr, NULL, NULL, 0, {src_tmp}->promoter);")
        return 1
    }

    let p_caps = fresh_temp("__acl_caps_")
    emit_line("void** {p_caps} = (void**)blink_promote_alloc({target}, sizeof(void*) * {info.count});")
    emit_line("\{")
    cg_indent = cg_indent + 1
    // emit_promote_elem_into's struct/list/map walkers reference a local
    // `target` identifier, mirroring the @derive promote functions they inline.
    emit_line("blink_arena_t* target = {target};")
    emit_line("blink_arena_t* __acl_save = __blink_current_arena;")
    emit_line("__blink_current_arena = target;")
    let mut i = 0
    while i < info.count {
        let e = closure_captures.get(info.start + i).unwrap()
        let desc = descriptor_from_capture(e)
        queue_promote_type(desc)
        emit_trace_arena_capture("tail", i, desc, tail_node)
        let declared_in_block = if e.is_mut != 0 { list_contains_str(block_local_muts, e.name) } else { 0 }
        emit_promote_capture_slot("{src_tmp}->captures[{i}]", "{p_caps}[{i}]", desc, e.is_mut, declared_in_block, e.tp_id)
        i = i + 1
    }
    emit_line("{result_sink} = blink_closure_new_typed({src_tmp}->fn_ptr, {p_caps}, {src_tmp}->capture_descs, {info.count}, {src_tmp}->promoter);")
    emit_line("__blink_current_arena = __acl_save;")
    cg_indent = cg_indent - 1
    emit_line("}")
    1
}

// declared_in_block=0 aliases an outside-block mut cell to preserve spec §2.8
// shared-cell semantics; =1 deep-copies a block-local cell.
pub fn emit_promote_capture_slot(src_slot: Str, dst_slot: Str, desc: Str, is_mut: Int, declared_in_block: Int, tp_id: Int) ! Codegen.Emit {
    let ct = desc_primary_ct(desc)
    if is_mut != 0 {
        if declared_in_block != 0 {
            let cell_c = if ct == CT_STRUCT { c_type_c_name(tp_get_sname(tp_id)) } else { descriptor_c_type(desc) }
            let src_cell = fresh_temp("__acl_sc_")
            let new_cell = fresh_temp("__acl_nc_")
            emit_line("{cell_c}* {src_cell} = ({cell_c}*){src_slot};")
            emit_line("{cell_c}* {new_cell} = ({cell_c}*)blink_promote_alloc(target, sizeof({cell_c}));")
            if ct == CT_INT || ct == CT_BOOL || ct == CT_FLOAT {
                emit_line("*{new_cell} = *{src_cell};")
            } else if ct == CT_STRING {
                emit_line("*{new_cell} = blink_promote_str(target, *{src_cell});")
            } else {
                let mangle = descriptor_mangle(desc)
                emit_line("*{new_cell} = blink_promote_{mangle}(target, *{src_cell});")
            }
            emit_line("{dst_slot} = (void*){new_cell};")
        } else {
            emit_line("{dst_slot} = {src_slot};")
        }
        return
    }
    let stored = emit_promote_elem_into(src_slot, ct, desc)
    emit_line("{dst_slot} = {stored};")
}

pub fn emit_trace_arena_capture(op: Str, slot: Int, desc: Str, _node: Int) ! Codegen.Emit {
    if cg_trace_codegen == 0 { return }
    emit_line("blink_trace_arena_event(\"{cg_current_fn_name}\", \"{cg_current_module}\", __blink_trace.depth, \"{op}\", (int64_t){slot}, \"{desc}\", 0, 0);")
}

fn emit_and_log_promote_phase(phase: Str, target_expr: Str, desc: Str, node: Int) ! Codegen.Emit {
    if cg_trace_codegen == 0 { return }
    let rel_path = trace_relative_path(diag_file_for_node(node))
    let line = node_line(node)
    let col = node_col(node)
    emit_line("blink_trace_arena_promote(\"{cg_current_fn_name}\", \"{cg_current_module}\", __blink_trace.depth, \"{phase}\", ({target_expr}) ? \"outer arena\" : \"GC heap\", \"{desc}\", \"{rel_path}\", {line}, {col});")
    trace("codegen", "arena.promote {phase} desc={desc} at {rel_path}:{line}:{col}")
}

// Emit the body of an expression-form `with { … }`: run leading statements,
// evaluate the tail expression with the inner arena still active, then
// promote into `result_sink`. Returns the promote descriptor actually used
// so the caller can publish correct metadata.
@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_block_then_capture(block: Int, result_sink: Str, arena_prev: Str) -> Str ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    if block == -1 {
        return ""
    }
    let stmts_sl = node_stmts(block)
    if stmts_sl == -1 {
        return ""
    }
    let count = sublist_length(stmts_sl)
    if count == 0 {
        return ""
    }
    // Block-local `let x = <ClosureLit>` aliases let a tail Ident resolve to
    // its originating literal for the cap-info lookup below.
    let mut let_alias_names: List[Str] = []
    let mut let_alias_nodes: List[Int] = []
    // Names of `let mut` bindings introduced *inside* this block. Only these
    // are safe to promote as closure-tail mut captures — an outside-block
    // binding may still be referenced after the with-arena block ends.
    let mut block_local_muts: List[Str] = []
    let mut i = 0
    while i < count - 1 {
        let stmt = sublist_get(stmts_sl, i)
        if node_kind(stmt) == NodeKind.LetBinding {
            let init = node_value(stmt)
            if init != -1 && node_kind(init) == NodeKind.Closure {
                let_alias_names.push(node_name(stmt))
                let_alias_nodes.push(init)
            }
            if node_is_mut(stmt) != 0 {
                block_local_muts.push(node_name(stmt))
            }
        }
        emit_stmt(stmt)
        i = i + 1
    }
    let last = sublist_get(stmts_sl, count - 1)
    let last_kind = node_kind(last)
    let tail_node = if last_kind == NodeKind.ExprStmt { node_value(last) } else { last }
    emit_expr(tail_node)
    let tail_str = expr_result_str
    if expr_result_type == CT_CLOSURE {
        let mut lit_node = -1
        let tk = node_kind(tail_node)
        if tk == NodeKind.Closure {
            lit_node = tail_node
        } else if tk == NodeKind.Ident {
            let tname = node_name(tail_node)
            let mut ai = 0
            while ai < let_alias_names.len() {
                if let_alias_names.get(ai).unwrap() == tname {
                    lit_node = let_alias_nodes.get(ai).unwrap()
                }
                ai = ai + 1
            }
            // Ident lookup doesn't populate expr_closure_sig; fetch it from the
            // var table so the outer let binding can record the right call sig.
            let sig_from_var = get_var_closure_sig(tname)
            if sig_from_var != "" {
                expr_closure_sig = sig_from_var
            }
        }
        let cap_idx = if lit_node == -1 { -1 } else { lookup_closure_lit_cap_idx(lit_node) }
        if cap_idx == -1 {
            diag_error_at(
                "ArenaClosureTailNonLiteral", ARENA_CLOSURE_TAIL_NONLITERAL,
                "cannot promote closure tail of 'with arena \{ expr }' whose origin is not a closure literal bound in this block",
                tail_node,
                "construct the closure outside the 'with arena \{ }' block, or bind it via `let <name> = fn(…) \{ … }` immediately inside this block"
            )
            return ""
        }
        if result_sink == "" {
            return ""
        }
        let ok = emit_closure_tail_promotion(tail_str, cap_idx, tail_node, result_sink, arena_prev, block_local_muts)
        if ok == 0 {
            return ""
        }
        return "C:Closure"
    }
    let desc = descriptor_from_expr_state()
    if result_sink != "" && desc != "" {
        let target = if arena_prev != "" { arena_prev } else { "NULL" }
        if desc == "P:Str" {
            emit_line("{result_sink} = blink_promote_str({target}, {tail_str});")
        } else if desc.starts_with("P:") {
            emit_line("{result_sink} = {tail_str};")
        } else {
            let mangle = descriptor_mangle(desc)
            queue_promote_type(desc)
            emit_line("{result_sink} = blink_promote_{mangle}({target}, {tail_str});")
        }
    }
    desc
}

@allow(UnrestoredMutation, IncompleteStateRestore)
pub fn emit_with_block_expr(node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let sink = fresh_temp("__with_result_")
    // Buffer the body emission so we can discover the tail descriptor,
    // then prepend a correctly-typed sink declaration.
    let saved_lines = cg_lines
    cg_lines = []
    let desc = emit_with_block_core(node, 1, sink)
    let body_lines = cg_lines
    cg_lines = saved_lines
    if desc == "" {
        // Not promotion-eligible — emit as statement form and publish void.
        let mut bi = 0
        while bi < body_lines.len() {
            cg_lines.push(body_lines.get(bi).unwrap())
            bi = bi + 1
        }
        expr_result_str = "0"
        expr_result_type = CT_VOID
        return
    }
    emit_line("{descriptor_c_type(desc)} {sink};")
    let mut bi = 0
    while bi < body_lines.len() {
        cg_lines.push(body_lines.get(bi).unwrap())
        bi = bi + 1
    }
    expr_result_str = sink
    publish_descriptor_as_var(sink, desc)
}

fn prim_desc_ct(desc: Str) -> Int {
    let ct = desc_primary_ct(desc)
    if ct == CT_BOOL { return CT_INT }
    ct
}

@allow(UnrestoredMutation)
fn publish_descriptor_as_var(sink: Str, desc: Str) ! Codegen.Register, Codegen.Scope {
    let ct = desc_primary_ct(desc)
    if ct == CT_INT || ct == CT_FLOAT || ct == CT_STRING {
        expr_result_type = ct
        return
    }
    if ct == CT_BOOL {
        expr_result_type = CT_INT
        return
    }
    if ct == CT_CLOSURE {
        expr_result_type = CT_CLOSURE
        set_var(sink, CT_CLOSURE, 0)
        if expr_closure_sig != "" {
            set_var_closure(sink, expr_closure_sig, -1)
        }
        return
    }
    if ct == CT_STRUCT {
        expr_result_type = CT_VOID
        set_var(sink, CT_VOID, 1)
        set_var_struct(sink, desc.slice(2, desc.len()))
        return
    }
    if ct == CT_LIST {
        expr_result_type = CT_LIST
        set_var(sink, CT_LIST, 1)
        let inner = inner_desc_of(desc)
        let et = prim_desc_ct(inner)
        expr_list_elem_type = et
        set_list_elem_type(sink, et)
        if inner.starts_with("S:") {
            let sn = inner.slice(2, inner.len())
            expr_list_elem_struct = sn
            set_list_elem_struct(sink, sn)
        }
        return
    }
    if ct == CT_MAP {
        expr_result_type = CT_MAP
        set_var(sink, CT_MAP, 1)
        let rest = desc.slice(2, desc.len())
        let bar = rest.index_of("|")
        let k = rest.slice(0, bar)
        let v = rest.slice(bar + 1, rest.len())
        let kt = prim_desc_ct(k)
        let vt = prim_desc_ct(v)
        let mut vs: Str = ""
        if v.starts_with("S:") { vs = v.slice(2, v.len()) }
        expr_map_key_type = kt
        expr_map_val_type = vt
        set_map_types(sink, kt, vt, vs)
        if vs != "" { set_map_value_struct(sink, vs) }
        return
    }
    if ct == CT_OPTION {
        expr_result_type = CT_OPTION
        let inner = desc.slice(2, desc.len())
        let inner_ct = prim_desc_ct(inner)
        let mut inner_s: Str = ""
        if inner.starts_with("S:") { inner_s = inner.slice(2, inner.len()) }
        if inner_s != "" {
            set_var_option_struct(sink, inner_ct, inner_s)
        } else {
            set_var_option(sink, inner_ct)
        }
        expr_option_inner = inner_ct
        expr_option_inner_struct = inner_s
        return
    }
    if ct == CT_RESULT {
        expr_result_type = CT_RESULT
        let rest = desc.slice(2, desc.len())
        let bar = rest.index_of("|")
        let ok_d = rest.slice(0, bar)
        let err_d = rest.slice(bar + 1, rest.len())
        let ok_t = prim_desc_ct(ok_d)
        let err_t = prim_desc_ct(err_d)
        let mut ok_s: Str = ""
        let mut err_s: Str = ""
        if ok_d.starts_with("S:") { ok_s = ok_d.slice(2, ok_d.len()) }
        if err_d.starts_with("S:") { err_s = err_d.slice(2, err_d.len()) }
        if ok_s != "" || err_s != "" {
            set_var_result_struct(sink, ok_t, err_t, ok_s, err_s)
        } else {
            set_var_result(sink, ok_t, err_t)
        }
        expr_result_ok_type = ok_t
        expr_result_err_type = err_t
        expr_result_ok_struct = ok_s
        expr_result_err_struct = err_s
        return
    }
    expr_result_type = CT_VOID
}


// ── Function codegen ────────────────────────────────────────────────

pub fn ann_str_val(node: Int) -> Str {
    let parts_sl = node_elements(node)
    if parts_sl != -1 && sublist_length(parts_sl) > 0 {
        return node_str_val(sublist_get(parts_sl, 0))
    }
    node_name(node)
}

// Pick the i-th positional string arg from an annotation arg sublist, skipping named args
// like `header: "poll.h"`. Returns "" if no such positional arg exists. Named string args
// get their label written into node_name by the parser; positional ones leave it empty.
pub fn positional_str_arg(args_sl: Int, idx: Int) -> Str {
    if args_sl == -1 { return "" }
    let len = sublist_length(args_sl)
    let mut i = 0
    let mut seen = 0
    while i < len {
        let arg = sublist_get(args_sl, i)
        if node_kind(arg) == NodeKind.InterpString && node_name(arg) == "" {
            if seen == idx { return ann_str_val(arg) }
            seen = seen + 1
        }
        i = i + 1
    }
    ""
}

pub fn positional_str_arg_count(args_sl: Int) -> Int {
    if args_sl == -1 { return 0 }
    let len = sublist_length(args_sl)
    let mut i = 0
    let mut count = 0
    while i < len {
        let arg = sublist_get(args_sl, i)
        if node_kind(arg) == NodeKind.InterpString && node_name(arg) == "" {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// When `cast_ffi_struct_ptrs` is set, each `Ptr[T]` arg whose T is an `@ffi.struct` with a
// known system C struct name is cast to `(struct <c_name>*)`. Used by FFI wrappers calling
// a system-header symbol, since `blink_T` and `struct <c_name>` are layout-equivalent but
// distinct C types.
fn format_param_names(fn_node: Int, cast_ffi_struct_ptrs: Int) -> Str {
    let params_sl = node_params(fn_node)
    if params_sl == -1 {
        return ""
    }
    let count = sublist_length(params_sl)
    if count == 0 {
        return ""
    }
    let mut result = ""
    let mut i = 0
    while i < count {
        let p = sublist_get(params_sl, i)
        let pname = c_safe_name(node_name(p))
        if i > 0 {
            result = result.concat(", ")
        }
        let mut emitted = ""
        if cast_ffi_struct_ptrs != 0 && node_type_name(p) == "Ptr" {
            let pta = node_type_ann(p)
            if pta != -1 {
                let pelems_sl = node_elements(pta)
                if pelems_sl != -1 && sublist_length(pelems_sl) > 0 {
                    let inner_name = node_name(sublist_get(pelems_sl, 0))
                    match ffi_struct_c_name.get(inner_name) {
                        Some(cname) => {
                            emitted = "(struct {cname}*){pname}"
                        }
                        None => {}
                    }
                }
            }
        }
        if emitted == "" {
            emitted = pname
        }
        result = result.concat(emitted)
        i = i + 1
    }
    result
}

fn get_ffi_ann(fn_node: Int) -> Int {
    get_annotation(fn_node, "ffi")
}

// Resolves the C type string (no parameter name) for a single function
// parameter `p` whose already-resolved (self/tparam-substituted) type name is
// `ptype`. Centralizes compound-carrier resolution (Option/Result/Ptr/Tuple/
// Handler/Fn) so every param-emitting path — top-level fns, impl methods, and
// generic monomorphization — agrees on the lowering. Falls back to
// c_type_str(type_from_name(ptype)) for plain scalar/builtin types.
pub fn param_c_type(p: Int, ptype: Str) -> Str {
    if ptype == "Fn" {
        return "blink_closure*"
    } else if ptype == "Ptr" {
        let pta = node_type_ann(p)
        if pta != -1 {
            let pelems_sl = node_elements(pta)
            if pelems_sl != -1 && sublist_length(pelems_sl) > 0 {
                let inner_ann = sublist_get(pelems_sl, 0)
                let inner_name = node_name(inner_ann)
                return "{ptr_inner_c_type(inner_name)}*"
            }
        }
        return "void*"
    } else if ptype == "Tuple" {
        let ta = node_type_ann(p)
        if ta != -1 {
            let tup_name = resolve_tuple_ann(ta, -1, []).unwrap()
            return c_type_c_name(tup_name)
        }
        return "void"
    } else if is_enum_type(ptype) != 0 {
        // A concrete generic-enum INSTANCE param (`t: Tree[Int]`) lowers to its mono
        // carrier (blink_Tree_Int), read from the instance tid typecheck memoized onto
        // the annotation node — mirroring the struct-instance branch below.
        // Empty stem (bare/monomorphic enum) keeps c_type_from_tag unchanged.
        let emono = ann_mono_c_type(node_type_ann(p))
        if emono != "" {
            return emono
        }
        return c_type_from_tag(ptype)
    } else if is_struct_type(ptype) != 0 {
        // A concrete generic-struct INSTANCE param (`b: Box[Str]`) must lower to
        // its monomorphized carrier (blink_Box_Str), not the bare, never-typedef'd
        // `blink_Box`. Read the struct-instance tid typecheck memoized onto the
        // annotation node and expand it to the full mono stem; this also
        // gets nesting (Box[Box[Int]] -> blink_Box_Box_Int) right, where the
        // string helper drops the inner. Empty stem (bare/typevar/module-qualified)
        // falls back to the bare-name string path unchanged.
        let smono = ann_mono_c_type(node_type_ann(p))
        if smono != "" {
            return smono
        }
        return c_type_c_name(ptype)
    } else if ptype == "Result" {
        let ta = node_type_ann(p)
        if ta != -1 {
            let elems_sl = node_elements(ta)
            if elems_sl != -1 && sublist_length(elems_sl) >= 2 {
                let ok_ann = sublist_get(elems_sl, 0)
                let err_ann = sublist_get(elems_sl, 1)
                let ok_name = node_name(ok_ann)
                let err_name = node_name(err_ann)
                let ok_t = type_from_name(ok_name)
                let err_t = type_from_name(err_name)
                let ok_tag = resolve_result_inner_tag(ok_ann, ok_name, ok_t)
                let err_tag = resolve_result_inner_tag(err_ann, err_name, err_t)
                if ok_tag != "" || err_tag != "" {
                    let ok_t_tag = if ok_tag != "" { canonical_struct_tag(ok_tag) } else { c_type_tag(ok_t) }
                    let err_t_tag = if err_tag != "" { canonical_struct_tag(err_tag) } else { c_type_tag(err_t) }
                    ensure_struct_result_type(ok_t_tag, err_t_tag)
                    return "blink_Result_{ok_t_tag}_{err_t_tag}"
                }
                return result_c_type(ok_t, err_t)
            }
            return result_c_type(CT_INT, CT_STRING)
        }
        return result_c_type(CT_INT, CT_STRING)
    } else if ptype == "Option" {
        let ta = node_type_ann(p)
        if ta != -1 {
            let elems_sl = node_elements(ta)
            if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
                let inner_ann = sublist_get(elems_sl, 0)
                let inner_name = node_name(inner_ann)
                let inner_t = type_from_name(inner_name)
                if is_opaque_type(inner_name) != 0 {
                    // Option[@ffi.opaque] is null-pointer-optimized to the bare handle
                    // (NULL = None); it has no carrier struct (spec §9.1.4).
                    return opaque_handle_c_name(inner_name)
                }
                if is_struct_type(inner_name) != 0 || is_enum_type(inner_name) != 0 {
                    // A generic-struct INSTANCE param inner (Option[QBox[Int]])
                    // spells the mono stem (QBox_Int) so the carrier matches the tid path;
                    // the bare head is the fallback for a non-generic struct / typevar.
                    let mono = mono_name_from_ann(strip_module_qualifier(inner_name), inner_ann, -1, [])
                    let tag = if mono != "" { mono } else { inner_name }
                    return "blink_Option_{canonical_struct_tag(tag)}"
                }
                if is_compound_ct(inner_t) != 0 || inner_name == "Tuple" {
                    let cn = compound_name_from_ann(inner_ann)
                    ensure_struct_option_type(cn)
                    return struct_option_c_type(cn)
                }
                return option_c_type(inner_t)
            }
            return option_c_type(CT_INT)
        }
        return option_c_type(CT_INT)
    } else if ptype == "Handler" {
        let ta = node_type_ann(p)
        if ta != -1 {
            let elems_sl = node_elements(ta)
            if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
                let effect_ann = sublist_get(elems_sl, 0)
                let effect_name = node_name(effect_ann)
                let vt = resolve_effect_vtable(effect_name)
                if vt != "" {
                    return "{vt}*"
                }
            }
        }
        return "void*"
    }
    c_type_str(type_from_name(ptype))
}

// Carrier C type for an Option/Result parameter in a monomorphized generic
// function. Unlike param_c_type (which reads the annotation's inner names
// verbatim), this resolves type-param inners against the concrete args first
// — e.g. `Result[T, Str]` with T=SomeStruct lowers to
// blink_Result_SomeStruct_str — and queues the carrier typedef so it is
// emitted. Mirrors the mono return-type resolution above.
fn mono_option_result_param_c_type(p: Int, ptype: Str, tparams_sl: Int, arg_tids: List[Int]) -> Str {
    let ta = node_type_ann(p)
    if ta == -1 {
        if ptype == "Option" { return option_c_type(CT_INT) }
        return result_c_type(CT_INT, CT_STRING)
    }
    let elems_sl = node_elements(ta)
    if ptype == "Option" {
        if elems_sl == -1 || sublist_length(elems_sl) < 1 {
            return option_c_type(CT_INT)
        }
        let inner_ann = sublist_get(elems_sl, 0)
        let inner_name = resolve_tparam_via_tid(node_name(inner_ann), tparams_sl, arg_tids)
        let inner_ct = type_from_name(inner_name)
        if is_struct_type(inner_name) != 0 || is_enum_type(inner_name) != 0 {
            ensure_struct_option_type(inner_name)
            return struct_option_c_type(inner_name)
        }
        if is_compound_ct(inner_ct) != 0 || node_name(inner_ann) == "Tuple" {
            let cn = compound_name_from_ann(inner_ann)
            ensure_struct_option_type(cn)
            return struct_option_c_type(cn)
        }
        ensure_option_type(inner_ct)
        return option_c_type(inner_ct)
    }
    if elems_sl == -1 || sublist_length(elems_sl) < 2 {
        return result_c_type(CT_INT, CT_STRING)
    }
    let ok_ann = sublist_get(elems_sl, 0)
    let err_ann = sublist_get(elems_sl, 1)
    let ok_name = resolve_tparam_via_tid(node_name(ok_ann), tparams_sl, arg_tids)
    let err_name = resolve_tparam_via_tid(node_name(err_ann), tparams_sl, arg_tids)
    let ok_t = type_from_name(ok_name)
    let err_t = type_from_name(err_name)
    let ok_tag = resolve_result_inner_tag(ok_ann, ok_name, ok_t)
    let err_tag = resolve_result_inner_tag(err_ann, err_name, err_t)
    if ok_tag != "" || err_tag != "" {
        let ok_t_tag = if ok_tag != "" { canonical_struct_tag(ok_tag) } else { c_type_tag(ok_t) }
        let err_t_tag = if err_tag != "" { canonical_struct_tag(err_tag) } else { c_type_tag(err_t) }
        ensure_struct_result_type(ok_t_tag, err_t_tag)
        return "blink_Result_{ok_t_tag}_{err_t_tag}"
    }
    ensure_result_type(ok_t, err_t)
    result_c_type(ok_t, err_t)
}

fn format_params(fn_node: Int) -> Str {
    let is_ffi = if get_ffi_ann(fn_node) != -1 { 1 } else { 0 }
    let has_ev = fn_node_has_effects(fn_node) != 0 && is_ffi == 0
    let params_sl = node_params(fn_node)
    if params_sl == -1 {
        if has_ev {
            return "blink_ev* __ev"
        }
        return "void"
    }
    let count = sublist_length(params_sl)
    if count == 0 {
        if has_ev {
            return "blink_ev* __ev"
        }
        return "void"
    }
    let mut result = ""
    let mut i = 0
    while i < count {
        let p = sublist_get(params_sl, i)
        let pname = c_safe_name(node_name(p))
        let ptype = node_type_name(p)
        if i > 0 {
            result = result.concat(", ")
        }
        let p_flat = param_c_type(p, ptype)
        let ptid = cg_node_mono_tid(p)
        let p_spelled = c_type_from_tid(ptid)
        // A non-FFI param's tid leads as before. An FFI param's tid leads only when it
        // spells exactly the flat C type: the FFI raw-pointer lowering (Bytes -> uint8_t*,
        // Ptr -> inner*) is authoritative and the tid cannot yet spell it, so keep the flat
        // there. Emitted C is unchanged either way.
        let tid_leads = p_spelled != "" && p_spelled != "void" && (is_ffi == 0 || p_spelled == p_flat)
        let p_c = if tid_leads { p_spelled } else { p_flat }
        ctype_probe_at(ptid, "param_fmt", pname, p_flat, p)
        result = result.concat("{p_c} {pname}")
        i = i + 1
    }
    if has_ev {
        if result == "" {
            result = "blink_ev* __ev"
        } else {
            result = result.concat(", blink_ev* __ev")
        }
    }
    result
}

pub fn format_impl_params(fn_node: Int, impl_type: Str) -> Str {
    let is_ffi = if get_ffi_ann(fn_node) != -1 { 1 } else { 0 }
    let params_sl = node_params(fn_node)
    let self_name = impl_method_self_name(fn_node)
    let mut result = ""
    if self_name != "" {
        let impl_ct = type_from_name(impl_type)
        if builtin_receiver_type_name(impl_ct) != "" {
            result = "{c_type_str(impl_ct)} {self_name}"
        } else {
            result = "{c_type_c_name(impl_type)} {self_name}"
        }
    }
    let mut _first = 1
    if self_name != "" {
        _first = 0
    }
    if params_sl != -1 {
        let mut i = 0
        while i < sublist_length(params_sl) {
            let p = sublist_get(params_sl, i)
            let pname_raw = node_name(p)
            if pname_raw != "self" && pname_raw != "_self" {
                let pname = c_safe_name(pname_raw)
                let ptype_raw = node_type_name(p)
                let ptype = resolve_self_type(ptype_raw, impl_type)
                if _first == 0 {
                    result = result.concat(", ")
                }
                _first = 0
                let p_flat = param_c_type(p, ptype)
                let ptid = cg_node_mono_tid(p)
                let p_spelled = c_type_from_tid(ptid)
                // Held in lockstep with format_params: an FFI param's tid leads only when it
                // spells exactly the flat, so the raw-pointer lowering (Bytes, Ptr) stays flat.
                let tid_leads = p_spelled != "" && p_spelled != "void" && (is_ffi == 0 || p_spelled == p_flat)
                let p_c = if tid_leads { p_spelled } else { p_flat }
                ctype_probe_at(ptid, "param_impl", pname, p_flat, p)
                result = result.concat("{p_c} {pname}")
            }
            i = i + 1
        }
    }
    if result == "" {
        result = "void"
    }
    result
}

fn emit_unused_param_voids(params_sl: Int) ! Codegen.Emit {
    if params_sl != -1 {
        let mut j = 0
        while j < sublist_length(params_sl) {
            let p = sublist_get(params_sl, j)
            let pname = node_name(p)
            if pname.starts_with("_") {
                emit_line("(void){c_safe_name(pname)};")
            }
            j = j + 1
        }
    }
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_requires_assertions(fn_node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let anns_sl = node_handlers(fn_node)
    if anns_sl == -1 {
        return
    }
    let mut i = 0
    while i < sublist_length(anns_sl) {
        let ann = sublist_get(anns_sl, i)
        let ann_name = node_name(ann)
        if ann_name == "requires" {
            let args_sl = node_args(ann)
            if args_sl != -1 && sublist_length(args_sl) > 0 {
                let expr_node = sublist_get(args_sl, 0)
                emit_expr(expr_node)
                let cond = expr_result_str
                emit_line("if (!({cond})) \{ fprintf(stderr, \"precondition failed: @requires in %s\\n\", \"{cg_current_fn_name}\"); exit(1); }")
            }
        }
        i = i + 1
    }
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn collect_old_snapshots(expr: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    if expr == -1 { return }
    let k = node_kind(expr)
    if k == NodeKind.Call {
        let callee = node_left(expr)
        if callee != -1 && node_name(callee) == "old" {
            let args_sl = node_args(expr)
            if args_sl != -1 && sublist_length(args_sl) > 0 {
                let inner = sublist_get(args_sl, 0)
                emit_expr(inner)
                let v = expr_result_str
                let snap = fresh_temp("__old_")
                emit_line("int64_t {snap} = (int64_t)({v});")
                cg_old_snapshot_vars.insert("{expr}", snap)
            }
            return
        }
        // Walk args of non-old calls.
        let args_sl = node_args(expr)
        if args_sl != -1 {
            let mut i = 0
            while i < sublist_length(args_sl) {
                collect_old_snapshots(sublist_get(args_sl, i))
                i = i + 1
            }
        }
        return
    }
    if k == NodeKind.MethodCall {
        collect_old_snapshots(node_obj(expr))
        let m_args_sl = node_args(expr)
        if m_args_sl != -1 {
            let mut i = 0
            while i < sublist_length(m_args_sl) {
                collect_old_snapshots(sublist_get(m_args_sl, i))
                i = i + 1
            }
        }
        return
    }
    if k == NodeKind.BinOp {
        collect_old_snapshots(node_left(expr))
        collect_old_snapshots(node_right(expr))
        return
    }
    if k == NodeKind.UnaryOp {
        collect_old_snapshots(node_left(expr))
        return
    }
    if k == NodeKind.FieldAccess {
        collect_old_snapshots(node_obj(expr))
        return
    }
    if k == NodeKind.IndexExpr {
        collect_old_snapshots(node_obj(expr))
        collect_old_snapshots(node_index(expr))
        return
    }
    if k == NodeKind.RangeLit {
        collect_old_snapshots(node_start(expr))
        collect_old_snapshots(node_end(expr))
        return
    }
    if k == NodeKind.IfExpr {
        collect_old_snapshots(node_condition(expr))
        collect_old_snapshots(node_then_body(expr))
        collect_old_snapshots(node_else_body(expr))
        return
    }
    if k == NodeKind.MatchExpr {
        collect_old_snapshots(node_scrutinee(expr))
        let arms_sl = node_arms(expr)
        if arms_sl != -1 {
            let mut i = 0
            while i < sublist_length(arms_sl) {
                let arm = sublist_get(arms_sl, i)
                let g = node_guard(arm)
                if g != -1 { collect_old_snapshots(g) }
                collect_old_snapshots(node_body(arm))
                i = i + 1
            }
        }
        return
    }
    if k == NodeKind.Block {
        let stmts_sl = node_stmts(expr)
        if stmts_sl != -1 {
            let mut i = 0
            while i < sublist_length(stmts_sl) {
                collect_old_snapshots(sublist_get(stmts_sl, i))
                i = i + 1
            }
        }
        return
    }
    if k == NodeKind.ExprStmt {
        collect_old_snapshots(node_value(expr))
        return
    }
}

pub fn fn_has_ensures(fn_node: Int) -> Int {
    has_annotation(fn_node, "ensures")
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_old_snapshots(fn_node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let anns_sl = node_handlers(fn_node)
    if anns_sl == -1 { return }
    let mut i = 0
    while i < sublist_length(anns_sl) {
        let ann = sublist_get(anns_sl, i)
        if node_name(ann) == "ensures" {
            let args_sl = node_args(ann)
            if args_sl != -1 && sublist_length(args_sl) > 0 {
                collect_old_snapshots(sublist_get(args_sl, 0))
            }
        }
        i = i + 1
    }
}

@allow(UnrestoredMutation, IncompleteStateRestore)
pub fn emit_ensures_assertions(fn_node: Int, result_var_c: Str) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let anns_sl = node_handlers(fn_node)
    if anns_sl == -1 { return }
    let saved_result = cg_ensures_result_var
    cg_ensures_result_var = result_var_c
    let mut i = 0
    while i < sublist_length(anns_sl) {
        let ann = sublist_get(anns_sl, i)
        if node_name(ann) == "ensures" {
            let args_sl = node_args(ann)
            if args_sl != -1 && sublist_length(args_sl) > 0 {
                let pred_node = sublist_get(args_sl, 0)
                emit_expr(pred_node)
                let cond = expr_result_str
                emit_line("if (!({cond})) \{ fprintf(stderr, \"postcondition failed: @ensures in %s\\n\", \"{cg_current_fn_name}\"); exit(1); }")
            }
        }
        i = i + 1
    }
    cg_ensures_result_var = saved_result
}

@allow(UnrestoredMutation, IncompleteStateRestore)
pub fn emit_where_assert(type_name: Str, c_val: Str) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    if !type_where_preds.contains_key(type_name) { return }
    let pred = type_where_preds.get(type_name).unwrap()
    let saved_self = cg_where_self_var
    cg_where_self_var = c_val
    emit_expr(pred)
    let cond = expr_result_str
    emit_line("if (!({cond})) \{ fprintf(stderr, \"refinement violated: @where on %s\\n\", \"{type_name}\"); exit(1); }")
    cg_where_self_var = saved_self
}

@allow(UnrestoredMutation, IncompleteStateRestore)
pub fn emit_param_where_checks(fn_node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let params_sl = node_params(fn_node)
    if params_sl == -1 { return }
    let mut i = 0
    while i < sublist_length(params_sl) {
        let p = sublist_get(params_sl, i)
        let ptype = node_type_name(p)
        if type_where_preds.contains_key(ptype) {
            let pname = c_safe_name(node_name(p))
            emit_where_assert(ptype, pname)
        }
        i = i + 1
    }
}

@allow(UnrestoredMutation, IncompleteStateRestore)
pub fn emit_impl_method_def(fn_node: Int, impl_type: Str, im_node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    push_scope()
    cg_temp_counter = 0
    cg_handler_vtable_type = ""
    cg_handler_vtable_field = ""
    cg_handler_is_user_effect = 0
    cg_current_module = node_source_module(fn_node)
    let mname = node_name(fn_node)
    let mangled = mangle_impl_method(im_node, impl_type, mname)
    cg_current_fn_name = mangled
    cg_current_fn_has_ev = if fn_node_has_effects(fn_node) != 0 { 1 } else { 0 }
    let ret_str_raw = node_return_type(fn_node)
    let ret_str = resolve_self_type(ret_str_raw, impl_type)
    let ret_type = type_from_name(ret_str)
    cg_current_fn_ret = ret_type
    if ret_type == CT_OPTION {
        cg_current_fn_option_inner = resolve_option_inner_from_ann(fn_node)
    } else {
        cg_current_fn_option_inner = 0
    }
    let params = format_impl_params(fn_node, impl_type)
    let enum_ret = get_fn_enum_ret(mangled)
    let ret_tid = cg_fn_ret_tid(fn_node)
    let mut sig = ""
    if enum_ret != "" {
        // Mono carrier for a generic-enum INSTANCE method return
        // (blink_Tree_Int), mirroring the free-fn seam. Empty stem keeps c_type_from_tag.
        let ret_stem = ann_mono_stem(node_type_ann(fn_node))
        let ret_c = if ret_stem != "" { c_type_c_name(ret_stem) } else { c_type_from_tag(enum_ret) }
        sig = "{ret_c} {c_fn_name(mangled)}({params})"
    } else if is_struct_type(ret_str) != 0 || is_enum_type(ret_str) != 0 {
        // Concrete generic-struct/enum instance method return (`-> Box[Str]` /
        // `-> Tree[Int]`): mono carrier off the return-annotation tid, mirroring the
        // free-fn seam and the param path above. tc_tid_struct_mono_name is kind-agnostic,
        // so the enum method return rides too. `-> Self`
        // resolves to a plain struct with no instance tid → empty stem → ret_str fallback.
        let ret_stem = ann_mono_stem(node_type_ann(fn_node))
        let ret_carrier = if ret_stem != "" { ret_stem } else { ret_str }
        sig = "{c_type_c_name(ret_carrier)} {c_fn_name(mangled)}({params})"
    } else {
        let resolved = resolve_ret_type_from_ann(fn_node)
        if resolved != "" {
            // Return position: void is a legal flat answer, so the tid leads only
            // when it spells something; an empty decline keeps the flat carrier.
            // Mirrors the free-fn emit_fn_def seam (sig_ret_def_resolved).
            let r_spelled = c_type_from_tid(ret_tid)
            let r_c = if r_spelled != "" { r_spelled } else { resolved }
            ctype_probe_at(ret_tid, "impl_sig_ret_resolved", mangled, resolved, fn_node)
            sig = "{r_c} {c_fn_name(mangled)}({params})"
        } else {
            let ret_c = c_type_str(ret_type)
            let s_spelled = c_type_from_tid(ret_tid)
            let s_c = if s_spelled != "" { s_spelled } else { ret_c }
            ctype_probe_at(ret_tid, "impl_sig_ret_scalar", mangled, ret_c, fn_node)
            sig = "{s_c} {c_fn_name(mangled)}({params})"
        }
    }

    let self_name = impl_method_self_name(fn_node)
    if self_name != "" {
        let impl_ct = type_from_name(impl_type)
        if builtin_receiver_type_name(impl_ct) != "" {
            set_var(self_name, impl_ct, 0)
        } else {
            set_var(self_name, CT_VOID, 0)
            set_var_struct(self_name, impl_type)
        }
    }

    let params_sl = node_params(fn_node)
    if params_sl != -1 {
        let mut i = 0
        while i < sublist_length(params_sl) {
            let p = sublist_get(params_sl, i)
            let pname = node_name(p)
            if pname != "self" && pname != "_self" {
                let ptype_raw = node_type_name(p)
                let ptype = resolve_self_type(ptype_raw, impl_type)
                if ptype == "Fn" {
                    set_var(pname, CT_CLOSURE, 1)
                    let ta = node_type_ann(p)
                    if ta != -1 {
                        let sig_str = build_closure_sig_from_type_ann(ta)
                        set_var_closure(pname, sig_str, tc_lookup_node_tid(p))
                    }
                } else {
                    let param_ct = if is_enum_type(ptype) != 0 { CT_INT } else { type_from_name(ptype) }
                    set_var(pname, param_ct, 1)
                    if is_struct_type(ptype) != 0 {
                        // Mirror emit_fn_def / param_c_type: a struct-instance param
                        // binds to its mono struct name so field reads resolve the
                        // concrete inner, not the bare generic base.
                        let inst_stem = ann_mono_stem(node_type_ann(p))
                        let struct_name = if inst_stem != "" { inst_stem } else { ptype }
                        set_var_struct(pname, struct_name)
                        let param_tid = tc_lookup_node_tid(node_type_ann(p))
                        if param_tid >= 0 && tc_tid_struct_mono_name(cg_bind_mono_tid(param_tid)) == struct_name {
                            set_var_ty(pname, param_tid)
                        }
                    }
                    if is_enum_type(ptype) != 0 {
                        var_enums.push(VarEnumEntry { name: pname, enum_type: ptype })
                        // Mirror emit_fn_def: a generic-enum instance param registers
                        // its mono instance and tracks the mono stem.
                        let einst = tc_lookup_node_tid(node_type_ann(p))
                        let einst_stem = tc_tid_struct_mono_name(einst)
                        if einst_stem != "" {
                            register_enum_instance_from_tid(einst)
                            set_var_struct(pname, einst_stem)
                        }
                    }
                    if ptype == "List" {
                        let ta = node_type_ann(p)
                        if ta != -1 {
                            let elems_sl = node_elements(ta)
                            if elems_sl != -1 && sublist_length(elems_sl) > 0 {
                                let elem_ann = sublist_get(elems_sl, 0)
                                let elem_name = node_name(elem_ann)
                                let elem_ct = type_from_name(elem_name)
                                set_list_elem_type(pname, elem_ct)
                                if elem_ct == CT_VOID && (is_named_type(elem_name) != 0) {
                                    set_list_elem_struct(pname, elem_name)
                                } else if elem_ct == CT_VOID && elem_name == "Tuple" {
                                    let tup_opt = resolve_tuple_ann(elem_ann, -1, [])
                                    if tup_opt.is_some() {
                                        set_list_elem_struct(pname, tup_opt.unwrap())
                                    }
                                }
                                if elem_ct == CT_LIST {
                                    let nested_sl = node_elements(elem_ann)
                                    if nested_sl != -1 && sublist_length(nested_sl) > 0 {
                                        let nested_ann = sublist_get(nested_sl, 0)
                                        let nested_name = node_name(nested_ann)
                                        let nested_ct = type_from_name(nested_name)
                                        set_list_nested_elem_type(pname, nested_ct)
                                    }
                                }
                                if elem_ct == CT_SET {
                                    let nested_sl = node_elements(elem_ann)
                                    if nested_sl != -1 && sublist_length(nested_sl) > 0 {
                                        let nested_ann = sublist_get(nested_sl, 0)
                                        let nested_name = node_name(nested_ann)
                                        let nested_ct = type_from_name(nested_name)
                                        set_list_nested_elem_type(pname, nested_ct)
                                    }
                                }
                                if elem_ct == CT_MAP {
                                    set_list_elem_map_ann(pname, elem_ann)
                                }
                                let _ = set_list_elem_compound_ann(pname, elem_ann, elem_ct)
                            }
                        }
                    }
                    if ptype == "Map" {
                        let ta = node_type_ann(p)
                        if ta != -1 {
                            let elems_sl = node_elements(ta)
                            if elems_sl != -1 && sublist_length(elems_sl) >= 2 {
                                let key_ann = sublist_get(elems_sl, 0)
                                let val_ann = sublist_get(elems_sl, 1)
                                let val_head = node_name(val_ann)
                                let val_ct = type_from_name(val_head)
                                // Mirror emit_fn_def's Map param fix: a
                                // generic-struct-INSTANCE value ("Box[Int]") must
                                // resolve to its mono stem, not the bare head.
                                let val_inst_stem = ann_mono_stem(val_ann)
                                let val_name = if val_inst_stem != "" { val_inst_stem } else { val_head }
                                set_map_types(pname, type_from_name(node_name(key_ann)), val_ct, val_name)
                                if val_inst_stem != "" {
                                    // See emit_fn_def's Map param fix for why this
                                    // must be unconditional: struct_reg_set race at bind time.
                                    set_map_value_struct(pname, val_inst_stem)
                                    register_map_elem_struct_mono_from_tid(tc_lookup_node_tid(val_ann))
                                }
                                propagate_map_list_elem(pname, val_ct, val_ann)
                            }
                        }
                    }
                    if ptype == "Set" {
                        let ta = node_type_ann(p)
                        if ta != -1 {
                            let elems_sl = node_elements(ta)
                            if elems_sl != -1 && sublist_length(elems_sl) > 0 {
                                let elem_ann = sublist_get(elems_sl, 0)
                                let elem_name = node_name(elem_ann)
                                let elem_ct = type_from_name(elem_name)
                                if elem_ct >= 0 && elem_ct != CT_VOID {
                                    set_set_elem_type(pname, elem_ct)
                                } else {
                                    // A raw type-parameter letter (e.g. "T") or a
                                    // struct-element name both read CT_VOID from
                                    // type_from_name -- recover the mono-substituted
                                    // element (scalar or struct) from the annotation's
                                    // own tid instead of leaving it unstamped.
                                    recover_set_elem_from_tid(ta, pname)
                                }
                            }
                        }
                    }
                    if ptype == "Tuple" {
                        let ta = node_type_ann(p)
                        if ta != -1 {
                            let tup_name = resolve_tuple_ann(ta, -1, []).unwrap()
                            set_var_struct(pname, tup_name)
                        }
                    }
                }
            }
            i = i + 1
        }
    }
    params_measure(params_sl, -1, [])

    let mut body_ret = ret_type
    if ret_needs_struct_body(ret_str) != 0 {
        body_ret = CT_INT
    }
    let saved_fn_node_im = cg_current_fn_node
    cg_current_fn_node = fn_node
    let saved_trace_fn = cg_trace_fn_qualified
    let saved_trace_mod = cg_trace_module
    let saved_in_traced = cg_in_traced_fn
    cg_in_traced_fn = 0
    emit_line("{sig} \{")
    cg_indent = cg_indent + 1

    emit_unused_param_voids(params_sl)

    let trace_file = diag_file_for_node(fn_node)
    emit_trace_enter(fn_node, mname, cg_current_module, trace_file)

    emit_requires_assertions(fn_node)
    emit_param_where_checks(fn_node)
    if fn_has_ensures(fn_node) != 0 {
        cg_old_snapshot_vars = Map()
        emit_old_snapshots(fn_node)
    }
    emit_fn_body(node_body(fn_node), body_ret)
    if ret_type == CT_VOID {
        emit_trace_exit_void()
    }
    cg_indent = cg_indent - 1
    emit_line("}")
    cg_trace_fn_qualified = saved_trace_fn
    cg_trace_module = saved_trace_mod
    cg_in_traced_fn = saved_in_traced
    cg_current_fn_node = saved_fn_node_im
    pop_scope()
}

fn ffi_c_ret_type(fn_node: Int) -> Str {
    let ret_str = node_return_type(fn_node)
    let ret_type = type_from_name(ret_str)
    if is_struct_type(ret_str) != 0 || is_enum_type(ret_str) != 0 {
        return c_type_from_tag(ret_str)
    }
    let resolved = resolve_ret_type_from_ann(fn_node)
    if resolved != "" { return resolved }
    c_type_str(ret_type)
}

// Visibility storage class for a top-level fn. Returns "static " when the fn
// must not escape its TU under per-module .o linkage, "" when it crosses TU
// boundaries. Carve-outs:
//   - main is always external
//   - FFI fns are external by definition
//   - stdlib fns under any archive mode: the monolith and user TU both
//     emit/consume these as external, since effectful fns peel into the
//     user TU and may call private pure fns left in the monolith
// Header mode skips the prefix — header lines get rewritten by prepend_extern_*.
fn fn_storage_class(fn_node: Int, name: Str) -> Str {
    if cg_archive_header_mode != 0 { return "" }
    if name == "main" { return "" }
    if get_ffi_ann(fn_node) != -1 { return "" }
    if node_is_pub(fn_node) != 0 { return "" }
    if (cg_archive_build_mode != 0 || cg_user_tu_mode != 0) &&
        is_stdlib_source_module(node_source_module(fn_node)) { return "" }
    "static "
}

// Storage class for emitted generic-mono fn definitions. Generic monos
// don't have a fixed home TU — every TU that instantiates with a given
// type-arg set emits its own copy under the same mangled name. Under
// per-module .o linkage that produces duplicate-symbol errors, so prefix
// `static inline ` and let the linker merge / discard duplicates.
// Whole-program (single TU), archive-monolith, and header passes all
// keep the extern default.
fn mono_storage_class(_fn_node: Int) -> Str {
    if in_per_module_object() { "static inline " } else { "" }
}

// Same rationale as fn_storage_class for top-level lets. archive_build_mode
// drops `static` so the monolith's symbols are visible to user TUs as
// `extern` via libblink_std.h.
fn let_storage_class(node: Int) -> Str {
    if node_is_pub(node) != 0 { return "" }
    // Non-pub lets in monolith.c stay file-local so they can't collide
    // with same-named user-side identifiers post-link.
    if cg_archive_build_mode != 0 { return "static " }
    if cg_user_tu_mode != 0 && is_stdlib_source_module(node_source_module(node)) { return "" }
    "static "
}

pub fn emit_fn_decl(fn_node: Int) ! Codegen.Emit {
    let name = node_name(fn_node)
    let ffi_ann = get_ffi_ann(fn_node)
    if ffi_ann != -1 {
        let ffi_args_sl = node_args(ffi_ann)
        let mut ffi_symbol = name
        if ffi_args_sl != -1 {
            let ffi_argc = positional_str_arg_count(ffi_args_sl)
            if ffi_argc >= 2 {
                ffi_symbol = positional_str_arg(ffi_args_sl, 1)
            } else if ffi_argc == 1 {
                ffi_symbol = positional_str_arg(ffi_args_sl, 0)
            }
        }
        let c_name = c_fn_name(name)
        if c_name != ffi_symbol || !is_runtime_header_fn(ffi_symbol) {
            let params = format_params(fn_node)
            let c_ret = ffi_c_ret_type(fn_node)
            emit_line("{c_ret} {c_name}({params});")
        }
        return
    }
    if name == "main" {
        emit_line("void blink_main(blink_ev* __ev);")
        return
    }
    let storage = fn_storage_class(fn_node, name)
    let params = format_params(fn_node)
    let enum_ret = get_fn_enum_ret(name)
    let ret_tid = cg_fn_ret_tid(fn_node)
    if enum_ret != "" {
        // Mono carrier for a generic-enum INSTANCE return
        // (blink_Tree_Int), mirroring emit_fn_def. Empty stem keeps c_type_from_tag.
        let ret_stem = ann_mono_stem(node_type_ann(fn_node))
        let ret_c = if ret_stem != "" { c_type_c_name(ret_stem) } else { c_type_from_tag(enum_ret) }
        ctype_probe_at(ret_tid, "sig_ret_decl_enum", name, ret_c, fn_node)
        emit_line("{storage}{ret_c} {c_fn_name(name)}({params});")
    } else {
        let ret_str = node_return_type(fn_node)
        if is_struct_type(ret_str) != 0 || is_enum_type(ret_str) != 0 {
            // Mono carrier for a concrete generic-struct/enum instance return; see
            // emit_fn_def seam. tc_tid_struct_mono_name
            // is kind-agnostic, so a `-> Tree[Int]` return spells blink_Tree_Int
            // instead of the erased bare blink_Tree.
            let ret_stem = ann_mono_stem(node_type_ann(fn_node))
            let ret_carrier = if ret_stem != "" { ret_stem } else { ret_str }
            let ret_c = c_type_c_name(ret_carrier)
            ctype_probe_at(ret_tid, "sig_ret_decl_carrier", name, ret_c, fn_node)
            emit_line("{storage}{ret_c} {c_fn_name(name)}({params});")
        } else {
            let resolved = resolve_ret_type_from_ann(fn_node)
            if resolved != "" {
                // Return position: void is a legal answer, so the tid leads only when
                // it spells something (empty decline falls back to the flat carrier).
                let r_spelled = c_type_from_tid(ret_tid)
                let r_c = if r_spelled != "" { r_spelled } else { resolved }
                ctype_probe_at(ret_tid, "sig_ret_decl_resolved", name, resolved, fn_node)
                emit_line("{storage}{r_c} {c_fn_name(name)}({params});")
            } else {
                let ret_type = type_from_name(ret_str)
                let ret_c = c_type_str(ret_type)
                let s_spelled = c_type_from_tid(ret_tid)
                let s_c = if s_spelled != "" { s_spelled } else { ret_c }
                ctype_probe_at(ret_tid, "sig_ret_decl_scalar", name, ret_c, fn_node)
                emit_line("{storage}{s_c} {c_fn_name(name)}({params});")
            }
        }
    }
}

// ── Trace helpers ────────────────────────────────────────────────────

let mut cg_trace_fn_qualified: Str = ""
let mut cg_trace_module: Str = ""
pub let mut cg_in_traced_fn: Int = 0

fn trace_format_spec(ptype: Str) -> Str {
    if ptype == "Int" { return "%lld" }
    if ptype == "Float" { return "%g" }
    if ptype == "Bool" { return "%s" }
    if ptype == "Str" { return "%s" }
    "<{ptype}>"
}

fn trace_c_arg_expr(pname: Str, ptype: Str) -> Str {
    let c_name = c_safe_name(pname)
    if ptype == "Int" { return "(long long){c_name}" }
    if ptype == "Float" { return "(double){c_name}" }
    if ptype == "Bool" { return "{c_name} ? \"true\" : \"false\"" }
    if ptype == "Str" { return "{c_name} ? {c_name} : \"null\"" }
    "\"{ptype}\""
}

fn trace_ret_is_primitive(ret_str: Str) -> Int {
    if ret_str == "Int" || ret_str == "Float" || ret_str == "Bool" || ret_str == "Str" {
        return 1
    }
    0
}

fn trace_relative_path(file_path: Str) -> Str {
    let idx = file_path.index_of("src/")
    if idx >= 0 {
        return file_path.substring(idx, file_path.len() - idx)
    }
    let idx2 = file_path.index_of("lib/")
    if idx2 >= 0 {
        return file_path.substring(idx2, file_path.len() - idx2)
    }
    file_path
}

fn emit_trace_enter(fn_node: Int, fn_name: Str, module_name: Str, file_path: Str) ! Codegen.Emit {
    if cg_trace_codegen == 0 { return }
    let line = node_line(fn_node)
    let col = node_col(fn_node)
    let rel_path = trace_relative_path(file_path)
    let qualified = if module_name != "" && module_name != "__main__" { "{module_name}.{fn_name}" } else { fn_name }
    let mod_str = if module_name != "" { module_name } else { "__main__" }

    cg_trace_fn_qualified = qualified
    cg_trace_module = mod_str
    cg_in_traced_fn = 1

    emit_line("int64_t __trace_enter_ts = 0;")

    let params_sl = node_params(fn_node)
    let has_params = params_sl != -1 && sublist_length(params_sl) > 0

    if has_params {
        emit_line("char __trace_args_buf[1024];")
        let mut fmt_str = ""
        let mut arg_exprs = ""
        let mut pi = 0
        let param_count = sublist_length(params_sl)
        while pi < param_count {
            let p = sublist_get(params_sl, pi)
            let pname = node_name(p)
            let ptype = node_type_name(p)
            if pi > 0 {
                fmt_str = fmt_str.concat(",")
            }
            let escaped_name = pname.replace("\"", "\\\"")
            let spec = trace_format_spec(ptype)
            fmt_str = fmt_str.concat("\\\"").concat(escaped_name).concat("\\\":\\\"").concat(spec).concat("\\\"")
            arg_exprs = arg_exprs.concat(", ").concat(trace_c_arg_expr(pname, ptype))
            pi = pi + 1
        }
        emit_line("if (__blink_trace.active && blink_trace_match(\"{qualified}\", \"{mod_str}\", __blink_trace.depth)) \{")
        cg_indent = cg_indent + 1
        emit_line("__trace_enter_ts = blink_trace_ts_us();")
        emit_line("snprintf(__trace_args_buf, sizeof(__trace_args_buf), \"{fmt_str}\"{arg_exprs});")
        emit_line("blink_trace_enter(\"{qualified}\", \"{mod_str}\", __blink_trace.depth, \"{rel_path}\", {line}, {col}, __trace_args_buf);")
        emit_line("__blink_trace.depth++;")
        cg_indent = cg_indent - 1
        emit_line("}")
    } else {
        emit_line("if (__blink_trace.active && blink_trace_match(\"{qualified}\", \"{mod_str}\", __blink_trace.depth)) \{")
        cg_indent = cg_indent + 1
        emit_line("__trace_enter_ts = blink_trace_ts_us();")
        emit_line("blink_trace_enter(\"{qualified}\", \"{mod_str}\", __blink_trace.depth, \"{rel_path}\", {line}, {col}, NULL);")
        emit_line("__blink_trace.depth++;")
        cg_indent = cg_indent - 1
        emit_line("}")
    }
}

pub fn emit_trace_exit_void() ! Codegen.Emit {
    if cg_in_traced_fn == 0 { return }
    emit_line("if (__trace_enter_ts) \{")
    cg_indent = cg_indent + 1
    emit_line("__blink_trace.depth--;")
    emit_line("blink_trace_exit(\"{cg_trace_fn_qualified}\", \"{cg_trace_module}\", __blink_trace.depth, __trace_enter_ts, \"()\");")
    cg_indent = cg_indent - 1
    emit_line("}")
}

fn emit_trace_exit_with_val(val_expr: Str, ret_str: Str) ! Codegen.Emit {
    if cg_in_traced_fn == 0 { return }
    emit_line("if (__trace_enter_ts) \{")
    cg_indent = cg_indent + 1
    emit_line("__blink_trace.depth--;")
    if trace_ret_is_primitive(ret_str) != 0 {
        let spec = trace_format_spec(ret_str)
        emit_line("char __trace_ret_buf[256];")
        if ret_str == "Int" {
            emit_line("snprintf(__trace_ret_buf, sizeof(__trace_ret_buf), \"{spec}\", (long long){val_expr});")
        } else if ret_str == "Float" {
            emit_line("snprintf(__trace_ret_buf, sizeof(__trace_ret_buf), \"{spec}\", (double){val_expr});")
        } else if ret_str == "Bool" {
            emit_line("snprintf(__trace_ret_buf, sizeof(__trace_ret_buf), \"{spec}\", {val_expr} ? \"true\" : \"false\");")
        } else if ret_str == "Str" {
            emit_line("snprintf(__trace_ret_buf, sizeof(__trace_ret_buf), \"%s\", {val_expr} ? {val_expr} : \"null\");")
        }
        emit_line("blink_trace_exit(\"{cg_trace_fn_qualified}\", \"{cg_trace_module}\", __blink_trace.depth, __trace_enter_ts, __trace_ret_buf);")
    } else {
        emit_line("blink_trace_exit(\"{cg_trace_fn_qualified}\", \"{cg_trace_module}\", __blink_trace.depth, __trace_enter_ts, \"<{ret_str}>\");")
    }
    cg_indent = cg_indent - 1
    emit_line("}")
}

// E0601 PtrEscapesFfiScope (§07:276) now lives in the dedicated escape pass
// (src/escape.bl analyze_escapes), so it fires consistently across
// check/build/LSP.

@allow(UnrestoredMutation)
pub fn emit_return_with_trace(val_str: Str, ret_type: Int, retval_node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let mut actual_val = val_str
    if cg_in_handler_body != 0 && cg_handler_body_is_ue != 0 && ret_type == CT_RESULT && cg_current_fn_option_inner == CT_PTR {
        let fsi = get_fn_ret_struct_inner(cg_current_fn_name)
        if fsi.ok_struct == "Option_ptr" && expr_result_ok_type == CT_OPTION && expr_result_ok_struct != "" && expr_result_ok_struct != "Option_ptr" {
            let mut concrete_struct = expr_result_ok_struct
            if concrete_struct.starts_with("Option_") {
                concrete_struct = concrete_struct.substring(7, concrete_struct.len() - 7)
            }
            let src = fresh_temp("__hret_src_")
            let dst = fresh_temp("__hret_dst_")
            let err_cs_tag = canonical_struct_tag(fsi.err_struct)
            let concrete_cs_tag = canonical_struct_tag(concrete_struct)
            let ret_c_name = "blink_Result_Option_ptr_{err_cs_tag}"
            let concrete_type = "blink_Result_Option_{concrete_cs_tag}_{err_cs_tag}"
            emit_line("{concrete_type} {src} = {val_str};")
            emit_line("{ret_c_name} {dst};")
            emit_line("{dst}.tag = {src}.tag;")
            emit_line("if ({src}.tag == 0) \{")
            emit_line("    blink_Option_ptr __hret_opt;")
            emit_line("    __hret_opt.tag = {src}.ok.tag;")
            emit_line("    if ({src}.ok.tag == 1) \{")
            emit_line("        {c_type_c_name(concrete_struct)}* __hret_p = ({c_type_c_name(concrete_struct)}*)blink_alloc(sizeof({c_type_c_name(concrete_struct)}));")
            emit_line("        *__hret_p = *{src}.ok.value;")
            emit_line("        __hret_opt.value = (void*)__hret_p;")
            emit_line("    }")
            emit_line("    {dst}.ok = __hret_opt;")
            emit_line("} else \{")
            emit_line("    memcpy(&{dst}.err, &{src}.err, sizeof({src}.err));")
            emit_line("}")
            actual_val = dst
        }
    }
    if cg_in_handler_body != 0 && cg_handler_body_is_ue != 0 && ret_type == CT_OPTION && cg_handler_ret_option_erased != 0 && cg_current_fn_option_inner_struct != "" {
        // Erase-only-at-boundary: the in-body value is a concrete blink_Option_<Struct>; the vtable
        // slot ABI is the shared blink_Option_ptr box. Box the concrete option into the ptr carrier
        // exactly once, here. The struct payload is already a heap pointer (Some boxes it), so the
        // ptr carrier just reinterprets it; a None keeps a null payload.
        ensure_option_type(CT_PTR)
        let concrete_opt_c = struct_option_c_type(cg_current_fn_option_inner_struct)
        let src = fresh_temp("__hret_opt_")
        let dst = fresh_temp("__hret_optp_")
        emit_line("{concrete_opt_c} {src} = {actual_val};")
        emit_line("blink_Option_ptr {dst};")
        if is_opaque_type(cg_current_fn_option_inner_struct) != 0 {
            // NPO: {src} is the bare handle word (NULL is the None niche). Box it into the
            // erased vtable carrier by nullness — it has no .tag/.value of its own.
            emit_line("{dst}.tag = ({src} != ((void*)0));")
            emit_line("{dst}.value = (void*){src};")
        } else {
            emit_line("{dst}.tag = {src}.tag;")
            emit_line("{dst}.value = {src}.tag == 1 ? (void*){src}.value : ((void*)0);")
        }
        actual_val = dst
    }
    let ret_name = type_name_from_ct(ret_type)
    let mut ret_alias = ""
    let mut has_ensures = 0
    if cg_current_fn_node != -1 {
        let rname = node_return_type(cg_current_fn_node)
        if type_where_preds.contains_key(rname) { ret_alias = rname }
        has_ensures = fn_has_ensures(cg_current_fn_node)
    }
    // The temp stores the return VALUE, so its type is the value expression's, read off the node
    // the caller emitted — a resolved expression node, unlike the return annotation, which carries
    // no published tid. A handler-body rewrite above reassigns actual_val to a different erased
    // carrier type, so its tid no longer matches; that path only fires for CT_RESULT, which the
    // flat arm spells "void" and the flip below leaves on the flat path anyway.
    let rv_tid = if retval_node != -1 { cg_node_mono_tid(retval_node) } else { -1 }
    if cg_in_traced_fn != 0 && trace_ret_is_primitive(ret_name) != 0 {
        let ret_tmp = fresh_temp("__trace_rv_")
        let trv_flat_c = c_type_str(ret_type)
        ctype_probe_at(rv_tid, "trace_rv_flat", ret_tmp, trv_flat_c, retval_node)
        // Reached only for a primitive return type, so the flat arm is always a scalar and the tid
        // agrees: the flip is byte-identical. A decline or void keeps the flat placeholder.
        let trv_spelled = c_type_from_tid(rv_tid)
        let trv_c = if trv_spelled != "" && trv_spelled != "void" { trv_spelled } else { trv_flat_c }
        emit_line("{trv_c} {ret_tmp} = {actual_val};")
        if ret_alias != "" {
            emit_where_assert(ret_alias, ret_tmp)
        }
        if has_ensures != 0 {
            emit_ensures_assertions(cg_current_fn_node, ret_tmp)
        }
        emit_trace_exit_with_val(ret_tmp, ret_name)
        emit_line("return {ret_tmp};")
    } else {
        let mut rv_var = actual_val
        if has_ensures != 0 || ret_alias != "" {
            let ret_tmp2 = fresh_temp("__ens_rv_")
            let ens_flat_c = c_type_str(ret_type)
            ctype_probe_at(rv_tid, "ens_rv_flat", ret_tmp2, ens_flat_c, retval_node)
            // Unlike __trace_rv_ this temp is reached for any return type, so a struct/enum/carrier
            // arrives with a flat spelling of "void" (c_type_str has no name for it) and — inside a
            // handler body — a physical type that is the effect slot's erased spelling the tid does
            // not know. Per the flat-vs-carrier licence only a scalar/pointer flat arm flips; a
            // "void" flat arm (every carrier kind) is left to the flat path.
            let ens_spelled = c_type_from_tid(rv_tid)
            let ens_c = if ens_spelled != "" && ens_spelled != "void" && ens_flat_c != "void" { ens_spelled } else { ens_flat_c }
            emit_line("{ens_c} {ret_tmp2} = {actual_val};")
            if ret_alias != "" {
                emit_where_assert(ret_alias, ret_tmp2)
            }
            if has_ensures != 0 {
                emit_ensures_assertions(cg_current_fn_node, ret_tmp2)
            }
            rv_var = ret_tmp2
        }
        emit_trace_exit_with_val(rv_var, ret_name)
        emit_line("return {rv_var};")
    }
}

fn emit_trace_effect(eff_name: Str, op: Str, args_json_expr: Str) ! Codegen.Emit {
    if cg_trace_codegen == 0 { return }
    if cg_in_traced_fn == 0 { return }
    emit_line("if (__blink_trace.active && blink_trace_match_effect(\"{cg_trace_fn_qualified}\", \"{cg_trace_module}\", __blink_trace.depth, \"{eff_name}\")) \{")
    cg_indent = cg_indent + 1
    emit_line("blink_trace_effect(\"{cg_trace_fn_qualified}\", \"{cg_trace_module}\", __blink_trace.depth, \"{eff_name}\", \"{op}\", {args_json_expr});")
    cg_indent = cg_indent - 1
    emit_line("}")
}

pub fn emit_trace_effect_str(eff_name: Str, op: Str, key: Str, val_expr: Str) ! Codegen.Emit {
    if cg_trace_codegen == 0 { return }
    if cg_in_traced_fn == 0 { return }
    let tbuf = fresh_temp("__te_")
    emit_line("char {tbuf}[256]; snprintf({tbuf}, 256, \"\\\"{key}\\\":\\\"%%.200s\\\"\", {val_expr} ? {val_expr} : \"null\");")
    emit_trace_effect(eff_name, op, tbuf)
}

pub fn emit_trace_effect_typed(eff_name: Str, op: Str, key: Str, val_expr: Str, val_type: Int) ! Codegen.Emit {
    if cg_trace_codegen == 0 { return }
    if cg_in_traced_fn == 0 { return }
    let tbuf = fresh_temp("__te_")
    if val_type == CT_INT {
        emit_line("char {tbuf}[64]; snprintf({tbuf}, 64, \"\\\"{key}\\\":\\\"%lld\\\"\", (long long){val_expr});")
    } else if val_type == CT_FLOAT {
        emit_line("char {tbuf}[64]; snprintf({tbuf}, 64, \"\\\"{key}\\\":\\\"%g\\\"\", (double){val_expr});")
    } else if val_type == CT_BOOL {
        emit_line("char {tbuf}[64]; snprintf({tbuf}, 64, \"\\\"{key}\\\":\\\"%s\\\"\", {val_expr} ? \"true\" : \"false\");")
    } else {
        emit_line("char {tbuf}[256]; snprintf({tbuf}, 256, \"\\\"{key}\\\":\\\"%%.200s\\\"\", {val_expr} ? {val_expr} : \"null\");")
    }
    emit_trace_effect(eff_name, op, tbuf)
}

pub fn emit_trace_state(var_name: Str, op: Str, val_expr: Str, val_type: Int) ! Codegen.Emit {
    if cg_trace_codegen == 0 { return }
    if cg_in_traced_fn == 0 { return }
    let tbuf = fresh_temp("__ts_")
    if val_type == CT_INT {
        emit_line("char {tbuf}[64]; snprintf({tbuf}, 64, \"%lld\", (long long){val_expr});")
    } else if val_type == CT_FLOAT {
        emit_line("char {tbuf}[64]; snprintf({tbuf}, 64, \"%g\", (double){val_expr});")
    } else if val_type == CT_BOOL {
        emit_line("char {tbuf}[64]; snprintf({tbuf}, 64, \"%s\", {val_expr} ? \"true\" : \"false\");")
    } else if val_type == CT_STRING {
        emit_line("char {tbuf}[256]; snprintf({tbuf}, 256, \"%%.200s\", {val_expr} ? {val_expr} : \"null\");")
    } else {
        emit_line("const char* {tbuf} = \"<{type_name_from_ct(val_type)}>\";")
    }
    emit_line("if (__blink_trace.active && blink_trace_match_state(\"{cg_trace_fn_qualified}\", \"{cg_trace_module}\", __blink_trace.depth, \"{var_name}\")) \{")
    cg_indent = cg_indent + 1
    emit_line("blink_trace_state_event(\"{cg_trace_fn_qualified}\", \"{cg_trace_module}\", __blink_trace.depth, \"{var_name}\", \"{op}\", {tbuf});")
    cg_indent = cg_indent - 1
    emit_line("}")
}

fn emit_trace_state_str(var_name: Str, op: Str, val_expr: Str) ! Codegen.Emit {
    if cg_trace_codegen == 0 { return }
    if cg_in_traced_fn == 0 { return }
    let tbuf = fresh_temp("__ts_")
    emit_line("char {tbuf}[256]; snprintf({tbuf}, 256, \"%%.200s\", {val_expr} ? {val_expr} : \"null\");")
    emit_line("if (__blink_trace.active && blink_trace_match_state(\"{cg_trace_fn_qualified}\", \"{cg_trace_module}\", __blink_trace.depth, \"{var_name}\")) \{")
    cg_indent = cg_indent + 1
    emit_line("blink_trace_state_event(\"{cg_trace_fn_qualified}\", \"{cg_trace_module}\", __blink_trace.depth, \"{var_name}\", \"{op}\", {tbuf});")
    cg_indent = cg_indent - 1
    emit_line("}")
}

@allow(UnrestoredMutation, IncompleteStateRestore)
pub fn emit_fn_def(fn_node: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    push_scope()
    cg_temp_counter = 0
    cg_handler_vtable_type = ""
    cg_handler_vtable_field = ""
    cg_handler_is_user_effect = 0
    cg_current_module = node_source_module(fn_node)
    let name = node_name(fn_node)
    if cg_archive_build_mode != 0 && name == "main" {
        pop_scope()
        return
    }
    cg_current_fn_name = name
    cg_current_fn_has_ev = if fn_node_has_effects(fn_node) != 0 && get_ffi_ann(fn_node) == -1 { 1 } else { 0 }
    let ret_str = node_return_type(fn_node)
    let ret_type = type_from_name(ret_str)
    cg_current_fn_ret = ret_type
    if ret_type == CT_OPTION {
        cg_current_fn_option_inner = resolve_option_inner_from_ann(fn_node)
    } else {
        cg_current_fn_option_inner = 0
    }
    let ffi_ann = get_ffi_ann(fn_node)
    if ffi_ann != -1 {
        let ffi_args_sl = node_args(ffi_ann)
        let mut ffi_lib = ""
        let mut ffi_symbol = name
        if ffi_args_sl != -1 {
            let ffi_argc = positional_str_arg_count(ffi_args_sl)
            if ffi_argc >= 2 {
                ffi_lib = positional_str_arg(ffi_args_sl, 0)
                ffi_symbol = positional_str_arg(ffi_args_sl, 1)
            } else if ffi_argc == 1 {
                ffi_symbol = positional_str_arg(ffi_args_sl, 0)
            }
        }
        if ffi_lib != "" && !cg_ffi_lib_set.contains_key(ffi_lib) {
            cg_ffi_libs.push(ffi_lib)
            cg_ffi_lib_set.insert(ffi_lib, 1)
        }
        let dep_name = stdlib_native_dep_name_by_ffi_symbol(ffi_symbol)
        if dep_name != "" {
            cg_used_native_deps.insert(dep_name, 1)
        }
        let params = format_params(fn_node)
        let ffi_header = get_str_named_arg(ffi_ann, "header")
        let mut header_provides_decl = 0
        if ffi_header != "" && ffi_includes_emitted.contains_key(ffi_header) != 0 {
            header_provides_decl = 1
        }
        let param_names = format_param_names(fn_node, header_provides_decl)
        let c_ret = ffi_c_ret_type(fn_node)
        let c_name = c_fn_name(name)
        let is_header_fn = is_runtime_header_fn(ffi_symbol)
        if !is_header_fn && header_provides_decl == 0 {
            emit_line("extern {c_ret} {ffi_symbol}({params});")
        }
        if !(c_name == ffi_symbol && is_header_fn) {
            // Gate on the resolved C return string, not `ret_type == CT_VOID`. A
            // struct/enum/opaque return lowers to CT_VOID with a type name, so the
            // old tag test wrongly emitted a `void` body and dropped `return`,
            // discarding the FFI call's result. `c_ret` is the single authority.
            if c_ret == "void" {
                if params == "void" {
                    emit_line("void {c_name}(void) \{ {ffi_symbol}(); }")
                } else {
                    emit_line("void {c_name}({params}) \{ {ffi_symbol}({param_names}); }")
                }
            } else if params == "void" {
                emit_line("{c_ret} {c_name}(void) \{ return {ffi_symbol}(); }")
            } else {
                emit_line("{c_ret} {c_name}({params}) \{ return {ffi_symbol}({param_names}); }")
            }
        }
        emit_line("")
        pop_scope()
        return
    }

    let mut sig = ""
    if name == "main" {
        sig = "void blink_main(blink_ev* __ev)"
    } else {
        let storage = fn_storage_class(fn_node, name)
        let params = format_params(fn_node)
        let enum_ret = get_fn_enum_ret(name)
        let ret_tid = cg_fn_ret_tid(fn_node)
        if enum_ret != "" {
            // A generic-enum INSTANCE return (`-> Tree[Int]`) spells
            // the mono carrier (blink_Tree_Int) off the return-annotation instance tid,
            // not the bare blink_Tree that fn_enum_rets stored (it records the bare head
            // for value-typing). Empty stem (non-generic enum) keeps c_type_from_tag.
            let ret_stem = ann_mono_stem(node_type_ann(fn_node))
            let ret_c = if ret_stem != "" { c_type_c_name(ret_stem) } else { c_type_from_tag(enum_ret) }
            ctype_probe_at(ret_tid, "sig_ret_def_enum", name, ret_c, fn_node)
            sig = "{storage}{ret_c} {c_fn_name(name)}({params})"
        } else if is_struct_type(ret_str) != 0 || is_enum_type(ret_str) != 0 {
            // Concrete generic-struct/enum instance return (`-> Box[Str]` / `-> Tree[Int]`):
            // lower to the mono carrier off the return-annotation tid, not the bare,
            // never-typedef'd `blink_Box`/`blink_Tree`. Same helper + input node as the
            // pre-scan and registration seams ⇒ byte-identical carrier name by
            // construction. tc_tid_struct_mono_name is kind-agnostic, so the enum
            // return rides the same path. Empty stem falls back to ret_str.
            let ret_stem = ann_mono_stem(node_type_ann(fn_node))
            let ret_carrier = if ret_stem != "" { ret_stem } else { ret_str }
            let ret_c = c_type_c_name(ret_carrier)
            ctype_probe_at(ret_tid, "sig_ret_def_carrier", name, ret_c, fn_node)
            sig = "{storage}{ret_c} {c_fn_name(name)}({params})"
        } else {
            let resolved = resolve_ret_type_from_ann(fn_node)
            if resolved != "" {
                // Return position: void is a legal answer, so the tid leads only when
                // it spells something (empty decline falls back to the flat carrier).
                let r_spelled = c_type_from_tid(ret_tid)
                let r_c = if r_spelled != "" { r_spelled } else { resolved }
                ctype_probe_at(ret_tid, "sig_ret_def_resolved", name, resolved, fn_node)
                sig = "{storage}{r_c} {c_fn_name(name)}({params})"
            } else {
                let ret_c = c_type_str(ret_type)
                let s_spelled = c_type_from_tid(ret_tid)
                let s_c = if s_spelled != "" { s_spelled } else { ret_c }
                ctype_probe_at(ret_tid, "sig_ret_def_scalar", name, ret_c, fn_node)
                sig = "{storage}{s_c} {c_fn_name(name)}({params})"
            }
        }
    }

    // Register params in scope
    let params_sl = node_params(fn_node)
    if params_sl != -1 {
        let mut i = 0
        while i < sublist_length(params_sl) {
            let p = sublist_get(params_sl, i)
            let pname = node_name(p)
            let ptype = node_type_name(p)
            if ptype == "Fn" {
                set_var(pname, CT_CLOSURE, 1)
                let ta = node_type_ann(p)
                if ta != -1 {
                    let sig_str = build_closure_sig_from_type_ann(ta)
                    set_var_closure(pname, sig_str, tc_lookup_node_tid(p))
                }
            } else {
                let param_ct = if is_enum_type(ptype) != 0 { CT_INT } else { type_from_name(ptype) }
                set_var(pname, param_ct, 1)
                if is_struct_type(ptype) != 0 {
                    // Match the monomorphized carrier the signature emits (above):
                    // a struct-instance param binds its var to the mono struct name
                    // (Box_Str / Box_Box_Int) so field reads resolve the concrete
                    // inner, not the bare generic `Box`.
                    let inst_stem = ann_mono_stem(node_type_ann(p))
                    let struct_name = if inst_stem != "" { inst_stem } else { ptype }
                    set_var_struct(pname, struct_name)
                    let param_tid = tc_lookup_node_tid(node_type_ann(p))
                    if param_tid >= 0 && tc_tid_struct_mono_name(cg_bind_mono_tid(param_tid)) == struct_name {
                        set_var_ty(pname, param_tid)
                    }
                }
                if is_enum_type(ptype) != 0 {
                    var_enums.push(VarEnumEntry { name: pname, enum_type: ptype })
                    // A generic-enum INSTANCE param (`t: Tree[Int]`) registers its mono
                    // instance (so the blink_Tree_Int typedef is emitted even when this
                    // fn is the only site naming it) and tracks the mono stem so a
                    // `match t {…}` body reads the mono type via get_var_struct.
                    let einst = tc_lookup_node_tid(node_type_ann(p))
                    let einst_stem = tc_tid_struct_mono_name(einst)
                    if einst_stem != "" {
                        register_enum_instance_from_tid(einst)
                        set_var_struct(pname, einst_stem)
                    }
                }
                if ptype == "List" {
                    let ta = node_type_ann(p)
                    if ta != -1 {
                        let elems_sl = node_elements(ta)
                        if elems_sl != -1 && sublist_length(elems_sl) > 0 {
                            let elem_ann = sublist_get(elems_sl, 0)
                            let elem_name = node_name(elem_ann)
                            let elem_ct = type_from_name(elem_name)
                            set_list_elem_type(pname, elem_ct)
                            if elem_ct == CT_VOID && (is_named_type(elem_name) != 0) {
                                set_list_elem_struct(pname, elem_name)
                            } else if elem_ct == CT_VOID && elem_name == "Tuple" {
                                let tup_opt = resolve_tuple_ann(elem_ann, -1, [])
                                if tup_opt.is_some() {
                                    set_list_elem_struct(pname, tup_opt.unwrap())
                                }
                            }
                            if elem_ct == CT_LIST {
                                let nested_sl = node_elements(elem_ann)
                                if nested_sl != -1 && sublist_length(nested_sl) > 0 {
                                    let nested_ann = sublist_get(nested_sl, 0)
                                    let nested_name = node_name(nested_ann)
                                    let nested_ct = type_from_name(nested_name)
                                    set_list_nested_elem_type(pname, nested_ct)
                                }
                            }
                            if elem_ct == CT_SET {
                                let nested_sl = node_elements(elem_ann)
                                if nested_sl != -1 && sublist_length(nested_sl) > 0 {
                                    let nested_ann = sublist_get(nested_sl, 0)
                                    let nested_name = node_name(nested_ann)
                                    let nested_ct = type_from_name(nested_name)
                                    set_list_nested_elem_type(pname, nested_ct)
                                }
                            }
                            if elem_ct == CT_MAP {
                                set_list_elem_map_ann(pname, elem_ann)
                            }
                            let _ = set_list_elem_compound_ann(pname, elem_ann, elem_ct)
                        }
                    }
                }
                if ptype == "Map" {
                    let ta = node_type_ann(p)
                    if ta != -1 {
                        let elems_sl = node_elements(ta)
                        if elems_sl != -1 && sublist_length(elems_sl) >= 2 {
                            let key_ann = sublist_get(elems_sl, 0)
                            let val_ann = sublist_get(elems_sl, 1)
                            let val_head = node_name(val_ann)
                            let val_ct = type_from_name(val_head)
                            // Match the struct-param handling three branches up: the
                            // bare head ("Box") is never declared in C when the value
                            // is a generic-struct INSTANCE ("Box[Int]" -> "Box_Int").
                            let val_inst_stem = ann_mono_stem(val_ann)
                            let val_name = if val_inst_stem != "" { val_inst_stem } else { val_head }
                            set_map_types(pname, type_from_name(node_name(key_ann)), val_ct, val_name)
                            if val_inst_stem != "" {
                                // set_map_types's own struct-name gate requires
                                // is_named_type(value_name), which is_struct_type-backed
                                // and false for a mono INSTANCE stem not yet in
                                // struct_reg_set at param-binding time (its typedef
                                // flushes later). tc_tid_struct_mono_name already
                                // proved this is a genuine resolved instance, so stamp
                                // it unconditionally.
                                set_map_value_struct(pname, val_inst_stem)
                                // Nothing else in this fn necessarily constructs/consumes
                                // a Box_Int directly, so without registering the mono
                                // instance here its typedef never gets emitted even
                                // though every read site now correctly names it.
                                register_map_elem_struct_mono_from_tid(tc_lookup_node_tid(val_ann))
                            }
                            if val_ct == CT_LIST {
                                let val_elems = node_elements(val_ann)
                                if val_elems != -1 && sublist_length(val_elems) > 0 {
                                    let inner_ann = sublist_get(val_elems, 0)
                                    let inner_name = node_name(inner_ann)
                                    set_map_value_list_elem(pname, type_from_name(inner_name))
                                }
                            }
                        }
                    }
                }
                if ptype == "Set" {
                    let ta = node_type_ann(p)
                    if ta != -1 {
                        let elems_sl = node_elements(ta)
                        if elems_sl != -1 && sublist_length(elems_sl) > 0 {
                            let elem_ann = sublist_get(elems_sl, 0)
                            let elem_name = node_name(elem_ann)
                            let elem_ct = type_from_name(elem_name)
                            if elem_ct >= 0 && elem_ct != CT_VOID {
                                set_set_elem_type(pname, elem_ct)
                            } else {
                                // See the twin block in emit_impl_method_def: recover
                                // the mono-substituted element from the annotation's
                                // tid rather than leaving it unstamped.
                                recover_set_elem_from_tid(ta, pname)
                            }
                        }
                    }
                }
                if ptype == "Tuple" {
                    let ta = node_type_ann(p)
                    if ta != -1 {
                        let tup_name = resolve_tuple_ann(ta, -1, []).unwrap()
                        set_var_struct(pname, tup_name)
                    }
                }
                if ptype == "Result" {
                    let ta = node_type_ann(p)
                    if ta != -1 {
                        let elems_sl = node_elements(ta)
                        if elems_sl != -1 && sublist_length(elems_sl) >= 2 {
                            let ok_ann = sublist_get(elems_sl, 0)
                            let err_ann = sublist_get(elems_sl, 1)
                            let ok_name = node_name(ok_ann)
                            let err_name = node_name(err_ann)
                            let mut ok_t = type_from_name(ok_name)
                            let mut err_t = type_from_name(err_name)
                            let mut ok_s = ""
                            let mut err_s = ""
                            // A Tuple ok/err side is carried by its tag as a by-value
                            // member (ct=CT_INT); mirrors emit_let_binding's Tuple path.
                            // A compound (Map/Option/Result) side records its STRUCTURED
                            // tag while keeping its CT so the scope-var speller
                            // (result_c_type_mixed, the match scrutinee) matches the
                            // structured carrier construction and the annotation param
                            // type param_c_type declares — otherwise a Result[Map,_]
                            // param's scrutinee erases to blink_Result_map_int while
                            // the value is blink_Result_Map_str_int_int.
                            if is_struct_or_enum_type(ok_name) != 0 {
                                // Bind the mono stem (QBox_Int) so the body binding
                                // matches param_c_type's signature spelling; register
                                // the instance.
                                let ok_mono = register_carrier_inner_mono_instance(ok_name, ok_ann)
                                ok_s = if ok_mono != "" { ok_mono } else { ok_name }
                            } else if ok_name == "Tuple" {
                                let ok_tag = resolve_result_inner_tag(ok_ann, ok_name, ok_t)
                                if ok_tag != "" {
                                    ok_s = ok_tag
                                    ok_t = CT_INT
                                }
                            } else if is_compound_ct(ok_t) != 0 {
                                ok_s = compound_name_from_ann(ok_ann)
                            }
                            if is_struct_or_enum_type(err_name) != 0 {
                                let err_mono = register_carrier_inner_mono_instance(err_name, err_ann)
                                err_s = if err_mono != "" { err_mono } else { err_name }
                            } else if err_name == "Tuple" {
                                let err_tag = resolve_result_inner_tag(err_ann, err_name, err_t)
                                if err_tag != "" {
                                    err_s = err_tag
                                    err_t = CT_INT
                                }
                            } else if is_compound_ct(err_t) != 0 {
                                err_s = compound_name_from_ann(err_ann)
                            }
                            if ok_s != "" || err_s != "" {
                                set_var_result_struct(pname, ok_t, err_t, ok_s, err_s)
                            } else {
                                set_var_result(pname, ok_t, err_t)
                            }
                        }
                    }
                }
                if ptype == "Option" {
                    let ta = node_type_ann(p)
                    if ta != -1 {
                        let elems_sl = node_elements(ta)
                        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
                            let inner_ann = sublist_get(elems_sl, 0)
                            let inner_name = node_name(inner_ann)
                            let inner_t = type_from_name(inner_name)
                            if is_struct_or_enum_type(inner_name) != 0 {
                                // Bind the mono stem (QBox_Int) so the param body's
                                // scrutinee C type matches param_c_type's signature
                                // (blink_Option_QBox_Int), not the bare blink_Option_QBox.
                                // register_carrier_inner_mono_instance also registers the
                                // instance so the member lowers to blink_QBox_Int. "" (bare
                                // struct/enum / typevar) keeps the bare head.
                                let mono = register_carrier_inner_mono_instance(inner_name, inner_ann)
                                let inner_s = if mono != "" { mono } else { inner_name }
                                set_var_option_struct(pname, inner_t, inner_s)
                            } else if is_compound_ct(inner_t) != 0 || inner_name == "Tuple" {
                                set_var_option_struct(pname, inner_t, compound_name_from_ann(inner_ann))
                            } else if inner_name == "Set" {
                                // CT_SET is deliberately not in is_compound_ct, so the
                                // arm above never fires -- the Set's OWN element rides
                                // the option's flat inner2 slot instead (get_var_option_inner2),
                                // mirroring the bare `Set[T]` param arm below.
                                set_var_option(pname, inner_t)
                                let set_elems_sl = node_elements(inner_ann)
                                if set_elems_sl != -1 && sublist_length(set_elems_sl) > 0 {
                                    let set_elem_ann = sublist_get(set_elems_sl, 0)
                                    let set_elem_ct = type_from_name(node_name(set_elem_ann))
                                    if set_elem_ct >= 0 && set_elem_ct != CT_VOID {
                                        set_var_option_inner2(pname, set_elem_ct)
                                    } else {
                                        recover_option_set_elem_from_tid(inner_ann, pname)
                                    }
                                }
                            } else {
                                set_var_option(pname, inner_t)
                            }
                        }
                    }
                }
                if ptype == "Handler" {
                    let ta = node_type_ann(p)
                    if ta != -1 {
                        let elems_sl = node_elements(ta)
                        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
                            let effect_ann = sublist_get(elems_sl, 0)
                            let effect_name = node_name(effect_ann)
                            let h_vtt = resolve_effect_vtable(effect_name)
                            let h_vtf = resolve_effect_field(effect_name)
                            let h_is_ue = resolve_effect_is_ue(effect_name)
                            set_var_handler(pname, h_vtt, h_vtf, h_is_ue)
                        }
                    }
                }
            }
            i = i + 1
        }
    }
    params_measure(params_sl, -1, [])

    mut_captured_vars = []
    prescan_mut_captures(node_body(fn_node))

    let mut body_ret = ret_type
    if ret_needs_struct_body(ret_str) != 0 {
        body_ret = CT_INT
    }
    let saved_fn_node_fd = cg_current_fn_node
    cg_current_fn_node = fn_node
    let saved_trace_fn = cg_trace_fn_qualified
    let saved_trace_mod = cg_trace_module
    let saved_in_traced = cg_in_traced_fn
    cg_in_traced_fn = 0
    emit_line("{sig} \{")
    cg_indent = cg_indent + 1

    emit_unused_param_voids(params_sl)

    let trace_file = diag_file_for_node(fn_node)
    emit_trace_enter(fn_node, name, cg_current_module, trace_file)

    emit_requires_assertions(fn_node)
    emit_param_where_checks(fn_node)
    if fn_has_ensures(fn_node) != 0 {
        cg_old_snapshot_vars = Map()
        emit_old_snapshots(fn_node)
    }
    emit_fn_body(node_body(fn_node), body_ret)
    if ret_type == CT_VOID {
        emit_trace_exit_void()
    }
    cg_indent = cg_indent - 1
    emit_line("}")
    cg_trace_fn_qualified = saved_trace_fn
    cg_trace_module = saved_trace_mod
    cg_in_traced_fn = saved_in_traced
    cg_current_fn_node = saved_fn_node_fd
    pop_scope()
}

// A fn whose return type is a struct, enum, or tuple uses the struct-return
// calling convention: emit_fn_body must return the tail expression as a value,
// so body_ret is forced to a non-void carrier (CT_INT). Shared by the generic
// (emit_mono_fn_def) and non-generic fn/method emitters.
pub fn ret_needs_struct_body(ret_str: Str) -> Int {
    // A type alias is transparent: `-> PT` where `type PT = Point` returns a
    // struct body exactly like `-> Point`, so follow the alias chain to its
    // underlying type before deciding. Otherwise the struct-literal/variant/
    // tuple tail is emitted as a bare statement with no return.
    let base = resolve_alias_chain_name(ret_str)
    if is_struct_type(base) != 0 || is_enum_type(base) != 0 || base == "Tuple" { 1 } else { 0 }
}

@allow(UnrestoredMutation, IncompleteStateRestore)
pub fn emit_fn_body(block: Int, ret_type: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    if block == -1 {
        return
    }
    let stmts_sl = node_stmts(block)
    if stmts_sl == -1 {
        return
    }
    let count = sublist_length(stmts_sl)
    if count == 0 {
        return
    }
    let mut i = 0
    while i < count - 1 {
        emit_stmt(sublist_get(stmts_sl, i))
        i = i + 1
    }
    let last = sublist_get(stmts_sl, count - 1)
    let last_kind = node_kind(last)
    if ret_type != CT_VOID && last_kind == NodeKind.ExprStmt {
        emit_expr(node_value(last))
        emit_return_with_trace(expr_result_str, cg_current_fn_ret, node_value(last))
    } else if ret_type != CT_VOID && last_kind == NodeKind.IfExpr {
        emit_if_expr(last)
        emit_return_with_trace(expr_result_str, cg_current_fn_ret, last)
    } else if ret_type != CT_VOID && last_kind == NodeKind.MatchExpr {
        emit_match_expr(last)
        emit_return_with_trace(expr_result_str, cg_current_fn_ret, last)
    } else if ret_type != CT_VOID && last_kind == NodeKind.WithBlock {
        emit_with_block_expr(last)
        emit_return_with_trace(expr_result_str, cg_current_fn_ret, last)
    } else {
        emit_stmt(last)
    }
}

// ── Type definition codegen ─────────────────────────────────────────

pub fn find_type_def(name: Str) -> Int {
    let types_sl = node_fields(cg_program_node)
    if types_sl == -1 {
        return -1
    }
    let mut i = 0
    while i < sublist_length(types_sl) {
        let td = sublist_get(types_sl, i)
        if node_name(td) == name {
            return td
        }
        i = i + 1
    }
    -1
}

// A type alias is transparent: follow the alias chain from a field/variant-payload
// type annotation to its concrete target annotation, which carries the real mono
// args the bare alias reference drops. Returns the original ann for a non-alias
// (or an alias whose def can't be resolved), so annotation-driven consumers lower
// `m: MB` exactly as if the user wrote the target type. The 64-step guard bounds a
// malformed self-referential alias.
pub fn resolve_alias_ann(ann: Int) -> Int {
    let mut cur = ann
    let mut guard = 0
    while guard < 64 {
        if type_alias_base.contains_key(node_name(cur)) == 0 { return cur }
        let atd = find_type_def(node_name(cur))
        if atd == -1 || node_fields(atd) != -1 || node_value(atd) == -1 { return cur }
        cur = node_value(atd)
        guard = guard + 1
    }
    cur
}

// `ann` is the source node whose memoized tid the recovery net may read — the
// struct-literal construction node at the sole caller. This function and its
// sibling emit_mono_struct_typedef both run mono_arg_tids_with_ann, but not
// off the same node: this site gets the construction node, while the typedef
// emitter gets MonoInstance.ann, which is -1 for every instance registered
// through register_mono_instance (emit_struct_lit passes no ann). A hole this
// node's tid can fill but the registry's cannot still leaves a field type
// here that the emitted typedef does not have.
pub fn register_mono_field_types(base_name: Str, mono_name: Str, arg_tids0: List[Int], ann: Int) ! Diag.Report, Codegen.Emit, Codegen.Register {
    // A struct instance minted here may itself be a Hash/Eq-derived generic
    // struct's instance, embedded BY VALUE as another instance's field (e.g.
    // HBox_0Int nested inside HBox_0HBox_10Int's `value` field).
    // It need not ever be used directly as a Map/Set key to require its OWN
    // {mono_name}_hash/{mono_name}_eq definitions — the ENCLOSING instance's
    // derived body calls them directly (has_derive_method's mono-base
    // fallback). Idempotent, so safe to call whether or not mono_name is new.
    ensure_struct_derive_kops_key(mono_name)
    // Check if already registered
    let mut check = 0
    while check < sf_entries.len() {
        if sf_entries.get(check).unwrap().struct_name == mono_name {
            return
        }
        check = check + 1
    }
    let td = find_type_def(base_name)
    if td == -1 {
        return
    }
    let tparams_sl = node_type_params(td)
    if tparams_sl == -1 {
        return
    }
    let arg_tids = mono_arg_tids_with_ann(arg_tids0, ann, base_name, sublist_length(tparams_sl))
    let flds_sl = node_fields(td)
    if flds_sl == -1 {
        return
    }
    let mut i = 0
    while i < sublist_length(flds_sl) {
        let f = sublist_get(flds_sl, i)
        let fname = node_name(f)
        let type_ann_node = node_value(f)
        if type_ann_node != -1 {
            let type_name = node_name(type_ann_node)
            let field_tid = tc_tid_subst_mono(tc_tid_resolved(tc_lookup_node_tid(type_ann_node)), tparams_sl, arg_tids)
            let resolved = resolve_mono_slot(type_name, tparams_sl, arg_tids, "register_mono_field_types", "{mono_name}.{fname}", type_ann_node)
            // A struct-INSTANCE concrete arg (e.g. Box[Box[Int]] → field arg
            // "Box_Int") has not yet entered struct_reg_set at construction time
            // (that happens at the final typedef flush), so is_struct_type is
            // still false. Recognize it as a registered mono instance so the
            // field carries CT_STRUCT + its concrete mono stype rather than
            // collapsing to CT_VOID. Require the instance's base to resolve to
            // a TYPE DEF: mono_rev_idx is shared with generic-function
            // instances, so a bare non-empty base would false-positive a mono-fn
            // mangled name as a struct type.
            let resolved_mono_base = lookup_mono_base(resolved).base
            let resolved_is_mono_struct = resolved_mono_base != "" && find_type_def(resolved_mono_base) != -1
            if is_transparent_newtype(resolved) != 0 {
                // Transparent newtype (Errno): bare int64_t field, honest CT_INT
                // metadata. Mirrors emit_mono_struct_typedef; must precede the
                // is_enum_type arm, which would record it as a boxed CT_STRUCT.
                reg_sf_entry(mono_name, fname, CT_INT, "", sv_tp(CT_INT, -1, -1, ""), field_tid)
            } else if is_struct_type(resolved) != 0 || is_enum_type(resolved) != 0 || resolved_is_mono_struct {
                reg_sf_entry(mono_name, fname, CT_STRUCT, resolved, sv_tp(CT_STRUCT, -1, -1, resolved), field_tid)
            } else if is_compound_tag(resolved) != 0 {
                // A bare-typevar field (`value: T`) whose concrete arg is a COMPOUND
                // carrier (`Box[Option[Int]]` → resolved "Option_int"): the field
                // annotation carries no inner_elems (it is just `T`), so the branches
                // below — which read the compound shape from the ANNOTATION — cannot
                // fire. Decode the carrier CT + scalar inners from the arg tag instead,
                // so the field records CT_OPTION/RESULT/MAP rather than the CT_VOID
                // default. The tid-native mono-args gate admits only
                // compound-of-scalar slots, so the inner tag decoders are exact here.
                let cct = compound_tag_ct(resolved)
                if cct == CT_OPTION {
                    let inner_ct = option_inner_ct_from_tag(resolved)
                    let inner_sname = option_inner_struct_from_tag(resolved)
                    reg_sf_entry(mono_name, fname, cct, "", sv_tp(cct, inner_ct, -1, inner_sname), field_tid)
                } else if cct == CT_RESULT {
                    let split = split_result_compound(resolved)
                    let ok_ct = type_from_name_tag(split.first)
                    let err_ct = type_from_name_tag(split.second)
                    reg_sf_entry(mono_name, fname, cct, "", sv_tp(cct, ok_ct, err_ct, ""), field_tid)
                } else {
                    let kv = map_struct_scalar_kv(resolved)
                    reg_sf_entry(mono_name, fname, cct, "", sv_tp(cct, kv.first, kv.second, ""), field_tid)
                }
            } else {
                let ct = type_from_name(resolved)
                let inner_elems = node_elements(type_ann_node)
                if (ct == CT_OPTION || ct == CT_LIST) && inner_elems != -1 && sublist_length(inner_elems) >= 1 {
                    let inner_ann = sublist_get(inner_elems, 0)
                    let inner_stem = carrier_inner_instance_stem(inner_ann, tparams_sl, arg_tids)
                    let inner_name = if inner_stem != "" { inner_stem } else { resolve_mono_slot(node_name(inner_ann), tparams_sl, arg_tids, "register_mono_field_types_inner", "{mono_name}.{fname}", type_ann_node) }
                    let inner_ct = type_from_name(inner_name)
                    let inner_sname = if is_struct_type(inner_name) != 0 || is_enum_type(inner_name) != 0 || is_mono_struct_instance(inner_name) != 0 { inner_name } else { "" }
                    reg_sf_entry(mono_name, fname, ct, "", sv_tp(ct, inner_ct, -1, inner_sname), field_tid)
                } else if ct == CT_MAP && inner_elems != -1 && sublist_length(inner_elems) >= 2 {
                    let key_name = resolve_mono_slot(node_name(sublist_get(inner_elems, 0)), tparams_sl, arg_tids, "register_mono_field_types_inner", "{mono_name}.{fname}", type_ann_node)
                    let val_name = resolve_mono_slot(node_name(sublist_get(inner_elems, 1)), tparams_sl, arg_tids, "register_mono_field_types_inner", "{mono_name}.{fname}", type_ann_node)
                    let key_ct = type_from_name(key_name)
                    let val_ct = type_from_name(val_name)
                    let val_sname = if is_struct_type(val_name) != 0 || is_enum_type(val_name) != 0 { val_name } else { "" }
                    reg_sf_entry(mono_name, fname, ct, "", sv_tp(ct, key_ct, val_ct, val_sname), field_tid)
                } else if ct == CT_RESULT && inner_elems != -1 && sublist_length(inner_elems) >= 2 {
                    let ok_name = resolve_mono_slot(node_name(sublist_get(inner_elems, 0)), tparams_sl, arg_tids, "register_mono_field_types_inner", "{mono_name}.{fname}", type_ann_node)
                    let err_name = resolve_mono_slot(node_name(sublist_get(inner_elems, 1)), tparams_sl, arg_tids, "register_mono_field_types_inner", "{mono_name}.{fname}", type_ann_node)
                    let ok_ct = type_from_name(ok_name)
                    let err_ct = type_from_name(err_name)
                    reg_sf_entry(mono_name, fname, ct, "", sv_tp(ct, ok_ct, err_ct, ""), field_tid)
                } else {
                    reg_sf_entry(mono_name, fname, ct, "", sv_tp(ct, -1, -1, ""), field_tid)
                }
            }
        } else {
            reg_sf_entry(mono_name, fname, CT_INT, "", sv_tp(CT_INT, -1, -1, ""), -1)
        }
        i = i + 1
    }
}

// Register the mono struct instance(s) a struct-instance tid names, INNER-FIRST,
// so emit_mono_typedefs_from (which walks mono_instances in push order) emits the
// inner typedef before the outer that embeds it by value (`Box[Box[Int]]` →
// blink_Box_Int before blink_Box_Box_Int). Returns the outer mono name
// (Box_Str / Box_Box_Int / Pair_Str_Int), or "" for a non-instance / bare /
// non-encodable tid (the caller then keeps the bare-name string path).
//
// The def-side producer: a NON-generic fn's / impl method's signature names
// the instance carrier (param_c_type reading tc_tid_struct_mono_name), so
// that carrier's typedef must be queued before the fn decl. Each slot's CSV
// segment matches tc_tid_struct_mono_name / mangle_generic_name exactly, so
// the registered mono name is byte-identical to the signature's — the same
// key the call-site struct-lit path (register_mono_instance at
// emit_struct_lit) mints, so the two dedup to one. Lives here (not
// codegen.bl) so both the pre-fn signature pass AND the body-local let pass
// (emit_let_binding) can register carrier leaves.
pub fn register_struct_instance_from_tid(tid: Int) -> Str ! Codegen.Register {
    let base = tc_tid_struct(tid)
    if base == "" { return "" }
    let count = tc_tid_struct_arg_count(tid)
    if count < 1 { return "" }
    let mut args = ""
    let mut arg_tids: List[Int] = []
    let mut i = 0
    while i < count {
        let slot = tc_tid_struct_arg_tid(tid, i)
        let mut seg = ""
        if tc_tid_struct_arg_count(slot) >= 1 {
            // Nested instance (Box[Box[Int]]): register the inner FIRST so its
            // typedef precedes the outer that embeds it, and reuse its mono name.
            seg = register_struct_instance_from_tid(slot)
        } else {
            seg = tc_tid_struct_slot_seg(slot)
        }
        if seg == "" { return "" }
        if i > 0 { args = args.concat(",") }
        args = args.concat(seg)
        // Carry the slot tid when it is slot-encodable. That includes a
        // same-module struct-INSTANCE slot (Box[Box[Int]] -> inner Box[Int],
        // params_count>=1): tc_tid_to_c_tag recurses its args to the full
        // mono stem (Box_Int), so the def-side reader (tc_seg_from_tid)
        // round-trips to `seg` byte-identically, and arg_tids can key the
        // mono dedup. A genuinely unencodable slot (module-qualified
        // struct/enum, or a typevar/unknown) still stores -1 so the def-side
        // emitter falls back to the string seg.
        if tc_struct_slot_encodable(slot) {
            arg_tids.push(slot)
        } else {
            arg_tids.push(-1)
        }
        i = i + 1
    }
    register_mono_instance(base, args, arg_tids)
}

// The enum analogue of register_struct_instance_from_tid: register the mono
// instance for a generic-enum INSTANCE tid (`Tree[Int]`) so its tagged-union
// typedef (blink_Tree_Int) is emitted and c_type_from_tag / is_mono_struct_instance
// recognize it. tc_tid_struct is kind-agnostic (returns the base for TyKind.Enum
// too), as are tc_tid_struct_arg_* and tc_tid_struct_slot_seg — so this is a
// near-verbatim copy. Returns the mono c_name (`blink_Tree_Int`) or "" when the
// tid is not a concretely-encodable enum instance.
pub fn register_enum_instance_from_tid(tid: Int) -> Str ! Codegen.Register {
    let base = tc_tid_struct(tid)
    if base == "" { return "" }
    let count = tc_tid_struct_arg_count(tid)
    if count < 1 { return "" }
    let mut args = ""
    let mut arg_tids: List[Int] = []
    let mut i = 0
    while i < count {
        let slot = tc_tid_struct_arg_tid(tid, i)
        let mut seg = ""
        if tc_tid_struct_arg_count(slot) >= 1 {
            // Nested generic instance (a Tree[Int] arg to another generic): register
            // it inner-first so its typedef precedes the outer, reusing its mono name.
            if tc_tid_is_enum(slot) != 0 {
                seg = register_enum_instance_from_tid(slot)
            } else {
                seg = register_struct_instance_from_tid(slot)
            }
        } else {
            seg = tc_tid_struct_slot_seg(slot)
        }
        if seg == "" { return "" }
        if i > 0 { args = args.concat(",") }
        args = args.concat(seg)
        if tc_struct_slot_encodable(slot) {
            arg_tids.push(slot)
        } else {
            arg_tids.push(-1)
        }
        i = i + 1
    }
    register_mono_instance(base, args, arg_tids)
}

// Register any generic-struct INSTANCE leaves reachable inside an Option/Result
// carrier tid, inner-first, so the carrier typedef that embeds them by value
// (blink_Result_RBox_Int_RBox_Str) sees blink_RBox_Int/blink_RBox_Str already in
// the mono registry — making is_mono_struct_instance recognize the member (else it
// erases to `void`) and emit_mono_typedefs_from flush their typedefs ahead of the
// carrier. Registration is TID-driven (register_struct_instance_from_tid),
// so a multi-type-param leaf (Pair[Int,Str]) keeps its structured args — the mono
// name string tag alone cannot recover the comma boundaries. A non-carrier / scalar
// -leaf tid registers nothing. Recurses so a nested carrier
// (Option[Result[RBox[Int],Str]]) is covered.
pub fn register_carrier_struct_instance_leaves(tid: Int) ! Codegen.Register {
    if tid < 0 { return }
    let ok_tid = tc_tid_result_ok_tid(tid)
    if ok_tid >= 0 {
        register_carrier_leaf_or_instance(ok_tid)
        register_carrier_leaf_or_instance(tc_tid_result_err_tid(tid))
        return
    }
    let opt_tid = tc_tid_option_inner_tid(tid)
    if opt_tid >= 0 {
        register_carrier_leaf_or_instance(opt_tid)
        return
    }
    // A TUPLE over struct instances (`(PBox[Int], Int)`) embeds blink_PBox_Int by
    // value; register each element leaf so its typedef precedes the tuple typedef,
    // covering the param/return-only case that no construction registers.
    let arity = tc_tid_tuple_arity(tid)
    let mut i = 0
    while i < arity {
        register_carrier_leaf_or_instance(tc_tid_tuple_elem_tid(tid, i))
        i = i + 1
    }
}

// Register `leaf` when it is a struct instance; otherwise recurse in case it is
// itself a nested carrier over instances.
fn register_carrier_leaf_or_instance(leaf: Int) ! Codegen.Register {
    if leaf < 0 { return }
    if tc_tid_struct(leaf) != "" {
        register_struct_instance_from_tid(leaf)
    } else {
        register_carrier_struct_instance_leaves(leaf)
    }
}

// Fill the -1 slots register_carrier_inner_mono_instance had to leave.
//
// That producer registers the inner of a carrier annotation (`-> Option[QBox[Int]]`)
// from codegen_types, below typecheck in the import DAG, so it cannot reach a single
// tid accessor and pushes -1 for every slot. It records the source annotation node
// instead (MonoInstance.ann), and here — above typecheck — the real instance tid is
// one lookup away: tc_produce_struct_instance_tid / _enum_ already memoized
// `QBox[Int]` onto that node. So the slot is recovered as a tid, not re-parsed out
// of the concrete_args string.
//
// Without this a bare-typevar field emits `void v;` (a hard C error) and, worse, a
// compound one emits `blink_Option_void v;` inside a correctly-named blink_QBox_Int:
// a silent erasure the `_Void` grep does not see, because only the field type
// erases while the mono name stays concrete.
//
// A slot that already carries a tid wins — this only ever fills holes. A missing,
// mismatched, or still-generic annotation tid leaves the list exactly as it was;
// this function never invents a tid, so a genuinely generic instance is left to
// erase at emission rather than mint a typevar-named instance (blink_Box_T with a
// void field).
//
// The four bails, all silent from outside: `ann == -1`; no -1 hole; an empty
// arg_tids (no hole to find — strictly worse than all -1, since merge_arg_tids
// treats arity as information); and an arity mismatch against the recovered list.
// The `monofield` dbg_trace channel reports each one.
fn has_arg_tid_hole(arg_tids: List[Int]) -> Int {
    let mut i = 0
    while i < arg_tids.len() {
        if arg_tids.get(i).unwrap() == -1 { return 1 }
        i = i + 1
    }
    0
}

fn mono_arg_tids_with_ann(arg_tids: List[Int], ann: Int, base_name: Str, count: Int) -> List[Int] {
    if ann == -1 {
        // Only reported when there is actually something to recover: an all-concrete list
        // with no ann is the overwhelmingly common case and is not a bail worth a line.
        if has_arg_tid_hole(arg_tids) != 0 {
            dbg_trace("monofield", "bail=no_ann base={base_name} arg_tids=len{arg_tids.len()}")
        }
        return arg_tids
    }
    if arg_tids.len() == 0 {
        // Strictly worse than all- -1: there is no hole to FIND, so this net cannot help even
        // with a good ann in hand. This bail is reachable: merge_arg_tids does no widening
        // of its own ([] ⊔ [] is still []), it only lets a SAME-KEY registration that does
        // carry arity restore it. A key registered nowhere else still arrives here empty.
        dbg_trace("monofield", "bail=empty_arg_tids base={base_name} ann={ann} count={count}")
        return arg_tids
    }
    if has_arg_tid_hole(arg_tids) == 0 { return arg_tids }
    let recovered = mono_instance_arg_tids_from_tid(tc_lookup_node_tid(ann), strip_module_qualifier(base_name), count)
    if recovered.len() != arg_tids.len() {
        dbg_trace("monofield", "bail=arity base={base_name} ann={ann} arg_tids=len{arg_tids.len()} recovered=len{recovered.len()}")
        return arg_tids
    }
    let mut out: List[Int] = []
    let mut j = 0
    while j < arg_tids.len() {
        let have = arg_tids.get(j).unwrap()
        out.push(if have != -1 { have } else { recovered.get(j).unwrap() })
        j = j + 1
    }
    out
}

// The one place a def-side mono slot is resolved AND the resolved-vs-unchanged
// distinction is kept. resolve_tparam_via_tid returns a bare `Str` at every
// call site, so each one silently discards whether the tid answered or the
// BINDER NAME passed through; there is no CSV tail left to catch the second
// case, so it erases — as `void v;` (a loud cc error) or, under a
// correct-looking mono name, as `blink_Option_void v;` (a silent miscompile).
//
// The predicate is the SAME PAIR emit_struct_lit's chokepoint already uses on
// the args CSV (mono_args_has_void_seg, codegen_expr.bl) — both spellings are
// equally fatal:
//   a declared binder of THIS type that names no struct or enum — the tid
//     producers' spelling when tc_seg_from_tid declines a slot and the name
//     passes through unchanged. The is_struct_or_enum_type half matters
//     because a type param may legitimately be shadowed by a same-named
//     concrete type (decisions/under-determined-types.md Q5;
//     sections/03_types.md:1136-1192).
//   a BLINK_I0001_* SENTINEL — reachable HERE and not only on the CSV,
//     because tc_tid_to_c_tag answers with one for an out-of-range tid and
//     for a kind it has no arm for, and tc_seg_from_tid threads that answer
//     straight through. The binder half is blind to it (a sentinel is not a
//     declared tparam name), so without this arm a located I0001 would
//     downgrade into an opaque `cc` error with no source span.
//
//     Unlike the binder half, this one is NOT gated on
//     tparams_sl_contains(param_name). A binder name can legitimately appear
//     in a non-generic position, so that half needs the gate; a sentinel is
//     a marker the compiler wrote about its own failure and is never
//     legitimate in ANY position. This predicate does not treat
//     `resolved == "Void"` as an error: DECISIONS.md:342 established that
//     Void is an ordinary inhabited, encodable type
//     (decisions/under-determined-types.md:39), so a slot resolving to
//     "Void" is a correct answer and falls through clean.
//
// DELIBERATELY NOT NAMED resolve_mono_field_type. That identifier has never
// denoted anything in this codebase and would misdescribe both the name and
// the mechanism of the real net.
//
// BLIND SPOT, by construction: when the unresolvable slot is a TUPLE STEM
// rather than a binder (`Box[(Box[Int], Int)]`), tparams_sl_contains is
// false and this returns clean while `blink_Box_Tuple2_Box_Int_int` still
// gets a `void v;` field. A binder-keyed predicate cannot see that class; do
// not read a silent monofield sweep as covering it.
// `node` is what the ICE is anchored to; each call site passes the nearest
// node that locates the offending slot in source (the field's type
// annotation, the variant payload annotation, the fn node). `pub` so a unit
// test can drive the guard directly — there is no Blink program in the
// corpus that reaches it, so a unit row is the only positive test available.
pub fn resolve_mono_slot(param_name: Str, tparams_sl: Int, arg_tids: List[Int], site: Str, owner: Str, node: Int) -> Str ! Diag.Report {
    let resolved = resolve_tparam_via_tid(param_name, tparams_sl, arg_tids)
    let binder_survived = tparams_sl_contains(tparams_sl, resolved) != 0 && is_struct_or_enum_type(resolved) == 0
    // No tparams_sl_contains gate, deliberately — see the SENTINEL paragraph above.
    let ice_seg_survived = diag_is_ice_seg(resolved)
    if binder_survived || ice_seg_survived {
        dbg_trace("monofield", "binder-survived site={site} owner={owner} param={param_name} resolved={resolved} arg_tids=len{arg_tids.len()}")
        // `owner` is in the MESSAGE and `site` only in the help, deliberately: diag_seen dedups on
        // (severity|code|file|line|col|message), so the two def-side resolvers that describe the
        // same instance field — register_mono_field_types and the typedef emitter — coalesce into
        // one report instead of double-reporting a single underlying bug.
        diag_ice_at("UnsolvedTypeVarAtCodegen", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "type parameter '{param_name}' of '{owner}' reached monomorphization unsolved",
            node,
            "this is a compiler bug — the type should have been inferred, or reported as error[CannotInferType]; the def-side slot resolved to '{resolved}' (codegen site '{site}'), which would erase to a void or _Void field")
    }
    resolved
}

// A carrier inner that is a generic-struct INSTANCE bound by the ENCLOSING mono struct
// (`Inner[T]` field of `RB[T]`, emitted as RB[Int]): resolve_mono_slot substitutes only a
// whole-name binder, so the bare head `Inner` erased the child and the carrier was spelled
// three divergent ways (Inner_0T literal / Inner erased / Inner_0Int correct). Bind each of
// the inner's type args through the enclosing arg_tids and register the instance from those
// tids, so its mono stem (Inner_0Int) and typedef match the tid path. Returns "" when the
// inner is not a fully-bound generic instance, and the caller keeps its prior spelling.
fn carrier_inner_instance_stem(inner_ann: Int, tparams_sl: Int, arg_tids: List[Int]) -> Str ! Codegen.Register {
    if inner_ann == -1 { return "" }
    let base = strip_module_qualifier(node_name(inner_ann))
    let td = find_type_def(base)
    if td == -1 { return "" }
    let tp = node_type_params(td)
    if tp == -1 || sublist_length(tp) == 0 { return "" }
    let elems = node_elements(inner_ann)
    if elems == -1 || sublist_length(elems) != sublist_length(tp) { return "" }
    let mut inner_tids: List[Int] = []
    let mut i = 0
    while i < sublist_length(elems) {
        let t = tparam_tid_via_mono(node_name(sublist_get(elems, i)), tparams_sl, arg_tids)
        if t < 0 { return "" }
        inner_tids.push(t)
        i = i + 1
    }
    register_mono_instance(base, mono_csv_from_arg_tids(inner_tids), inner_tids)
}

// Force the typedef of a carrier inner that is a mono generic INSTANCE (`Inner_0Int`),
// before the enclosing struct's typedef opens. carrier_inner_instance_stem registers such an
// inner LATE (appended after the outer struct in mono_instances), so its typedef would
// otherwise flush AFTER the carrier that embeds it by value — a cc forward reference.
// emit_tuple_typedef_for_tag is a no-op here (it only knows tuples), so emit the instance's
// own typedef directly, dispatching struct vs enum on the base's first field exactly as
// emit_all_mono_typedefs does: is_mono_struct_instance also admits enum-based instances
// (Tree_0Int), and routing those to the struct emitter would emit an EMPTY struct that wins
// the shared include guard and suppresses the real tagged-union typedef. The struct emitter's
// struct_reg_set membership check (name inserted before its own field pre-emit loop) and the
// enum emitter's own guard both dedup the later flush and break self-referential recursion.
// A non-instance tag returns early.
fn force_mono_instance_typedef(tag: Str) ! Codegen.Emit, Diag.Report, Codegen.Register {
    if tag == "" || is_mono_struct_instance(tag) == 0 { return }
    let ml = lookup_mono_base(tag)
    if ml.base == "" { return }
    let td = find_type_def(ml.base)
    if td == -1 { return }
    let flds_sl = node_fields(td)
    if flds_sl == -1 || sublist_length(flds_sl) == 0 { return }
    if node_kind(sublist_get(flds_sl, 0)) != NodeKind.TypeVariant {
        if struct_reg_set.contains_key(tag) != 0 { return }
        emit_mono_struct_typedef(ml.base, ml.args, ml.arg_tids, -1)
    } else {
        emit_mono_enum_typedef(ml.base, ml.args, ml.arg_tids, -1)
    }
}

fn emit_mono_struct_typedef(base_name: Str, concrete_args: Str, arg_tids0: List[Int], ann: Int) ! Codegen.Emit, Diag.Report, Codegen.Register {
    let td = find_type_def(base_name)
    if td == -1 {
        return
    }
    let tparams_sl = node_type_params(td)
    if tparams_sl == -1 {
        return
    }
    let arg_tids = mono_arg_tids_with_ann(arg_tids0, ann, base_name, sublist_length(tparams_sl))
    // c_name uses the PHYSICAL base so the typedef name byte-matches the c_name
    // register_mono_instance minted (blink_<mod>_Box_Int for a cross-module
    // instance); find_type_def above keeps using the LOGICAL base_name. For a
    // fn/same-module base mono_phys_base is a no-op, so this is unchanged.
    let c_name = mangle_generic_name(mono_phys_base(base_name), concrete_args)
    let flds_sl = node_fields(td)
    if flds_sl == -1 {
        return
    }
    struct_reg_names.push(c_name)
    struct_reg_set.insert(c_name, 1)
    // A tuple-stem field (e.g. `v: T` resolving to "Tuple2_int_int") must have its
    // own typedef forced BEFORE this struct's own `typedef struct {` opens below —
    // emit_tuple_typedef_for_tag emits directly via emit_line, so calling it from
    // inside the field loop (after the outer typedef is already open) would nest
    // one `typedef struct {...}` textually inside another, illegal C. Mirrors
    // emit_struct_option_typedef, which forces the same dependency before
    // opening ITS OWN typedef, at the same (outer) nesting level.
    let mut j = 0
    while j < sublist_length(flds_sl) {
        let f0 = sublist_get(flds_sl, j)
        let type_ann_orig0 = node_value(f0)
        if type_ann_orig0 != -1 {
            let type_ann_node0 = resolve_alias_ann(type_ann_orig0)
            let resolved0 = resolve_mono_slot(node_name(type_ann_node0), tparams_sl, arg_tids, "struct_typedef_field", "{c_name}.{node_name(f0)}", type_ann_node0)
            if is_struct_type(resolved0) != 0 || is_enum_type(resolved0) != 0 || is_mono_struct_instance(resolved0) != 0 {
                emit_tuple_typedef_for_tag(resolved0)
            } else if resolved0 == "Option" {
                // The field's own resolved type isn't a tuple, but it may WRAP one
                // (`v: Option[(Int,Int)]`) — the Option carrier the main loop below
                // registers for this field embeds the tuple BY VALUE, so the tuple's
                // typedef must precede the carrier's, and the carrier's typedef is
                // flushed later, outside this function. Force it here too, same
                // reasoning as the direct-tuple-field case above.
                let inner_elems0 = node_elements(type_ann_node0)
                if inner_elems0 != -1 && sublist_length(inner_elems0) >= 1 {
                    let inner_ann0 = sublist_get(inner_elems0, 0)
                    let inner_stem0 = carrier_inner_instance_stem(inner_ann0, tparams_sl, arg_tids)
                    let inner_resolved0 = if inner_stem0 != "" { inner_stem0 } else { resolve_mono_slot(node_name(inner_ann0), tparams_sl, arg_tids, "struct_typedef_field_inner", "{c_name}.{node_name(f0)}", inner_ann0) }
                    if is_struct_type(inner_resolved0) != 0 || is_mono_struct_instance(inner_resolved0) != 0 {
                        emit_tuple_typedef_for_tag(inner_resolved0)
                        force_mono_instance_typedef(inner_resolved0)
                    }
                }
                // The Option CARRIER itself (blink_Option_set, blink_Option_double) is
                // embedded in this struct BY VALUE. The main loop only QUEUES it for a
                // later flush, so a carrier that isn't already pre-emitted lands after
                // this struct's own typedef, which references it — a cc forward
                // reference. Force it here, at the outer level, like the tuple dep above.
                emit_carrier_typedef_for_tag(compound_name_from_ann_ctx(type_ann_node0, tparams_sl, arg_tids, segs_from_arg_tids(arg_tids)))
            } else if resolved0 == "Result" {
                let inner_elems0 = node_elements(type_ann_node0)
                if inner_elems0 != -1 && sublist_length(inner_elems0) >= 2 {
                    let ok_ann0 = sublist_get(inner_elems0, 0)
                    let err_ann0 = sublist_get(inner_elems0, 1)
                    let ok_stem0 = carrier_inner_instance_stem(ok_ann0, tparams_sl, arg_tids)
                    let err_stem0 = carrier_inner_instance_stem(err_ann0, tparams_sl, arg_tids)
                    let ok_resolved0 = if ok_stem0 != "" { ok_stem0 } else { resolve_mono_slot(node_name(ok_ann0), tparams_sl, arg_tids, "struct_typedef_field_inner", "{c_name}.{node_name(f0)}", ok_ann0) }
                    let err_resolved0 = if err_stem0 != "" { err_stem0 } else { resolve_mono_slot(node_name(err_ann0), tparams_sl, arg_tids, "struct_typedef_field_inner", "{c_name}.{node_name(f0)}", err_ann0) }
                    if is_struct_type(ok_resolved0) != 0 || is_mono_struct_instance(ok_resolved0) != 0 {
                        emit_tuple_typedef_for_tag(ok_resolved0)
                        force_mono_instance_typedef(ok_resolved0)
                    }
                    if is_struct_type(err_resolved0) != 0 || is_mono_struct_instance(err_resolved0) != 0 {
                        emit_tuple_typedef_for_tag(err_resolved0)
                        force_mono_instance_typedef(err_resolved0)
                    }
                }
                emit_carrier_typedef_for_tag(compound_name_from_ann_ctx(type_ann_node0, tparams_sl, arg_tids, segs_from_arg_tids(arg_tids)))
            } else if is_compound_tag(resolved0) != 0 {
                // A bare-typevar field (`v: T`) whose concrete arg is a compound
                // carrier resolves to the carrier TAG ("Option_int", "Result_double_str")
                // rather than the bracketed "Option"/"Result" above. Same by-value
                // forward reference; force the carrier from the tag directly.
                emit_carrier_typedef_for_tag(resolved0)
            }
        }
        j = j + 1
    }
    emit_td_guard_open(c_type_c_name(c_name))
    emit_line("typedef struct \{")
    cg_indent = cg_indent + 1
    let mut i = 0
    while i < sublist_length(flds_sl) {
        let f = sublist_get(flds_sl, i)
        let fname = node_name(f)
        let type_ann_orig = node_value(f)
        if type_ann_orig != -1 {
            let field_tid = tc_tid_subst_mono(tc_tid_resolved(tc_lookup_node_tid(type_ann_orig)), tparams_sl, arg_tids)
            let type_ann_node = resolve_alias_ann(type_ann_orig)
            let type_name = node_name(type_ann_node)
            let resolved = resolve_mono_slot(type_name, tparams_sl, arg_tids, "struct_typedef_field", "{c_name}.{fname}", type_ann_node)
            // is_enum_type / is_mono_struct_instance widen the same admission
            // emit_mono_enum_typedef's payload loop already uses — a bare
            // struct/enum-name check alone misses a resolved MONO STEM (e.g. a
            // `v: T` field resolving to "Tree_Int", an enum instance not yet in
            // struct_reg_set/enum_reg_set at typedef-emit time), which falls
            // through every branch below to the CT_VOID default and erases the
            // field to `void` while the field's VALUE still constructs the real
            // payload.
            if is_transparent_newtype(resolved) != 0 {
                // Transparent newtype (Errno): bare int64_t, honest CT_INT metadata.
                // Must precede the is_enum_type arm, which would box it.
                emit_line("int64_t {fname};")
                reg_sf_entry(c_name, fname, CT_INT, "", sv_tp(CT_INT, -1, -1, ""), field_tid)
            } else if is_struct_type(resolved) != 0 || is_enum_type(resolved) != 0 || is_mono_struct_instance(resolved) != 0 {
                emit_line("{c_type_c_name(resolved)} {fname};")
                reg_sf_entry(c_name, fname, CT_VOID, resolved, sv_tp(CT_VOID, -1, -1, resolved), field_tid)
            } else if resolved == "Option" {
                let inner_elems = node_elements(type_ann_node)
                if inner_elems != -1 && sublist_length(inner_elems) >= 1 {
                    let inner_ann = sublist_get(inner_elems, 0)
                    let inner_raw = node_name(inner_ann)
                    let inner_stem = carrier_inner_instance_stem(inner_ann, tparams_sl, arg_tids)
                    let inner_resolved = if inner_stem != "" { inner_stem } else { resolve_mono_slot(inner_raw, tparams_sl, arg_tids, "struct_typedef_field_inner", "{c_name}.{fname}", inner_ann) }
                    let inner_ct = type_from_name(inner_resolved)
                    if is_struct_type(inner_resolved) != 0 || is_enum_type(inner_resolved) != 0 || is_mono_struct_instance(inner_resolved) != 0 {
                        ensure_struct_option_type(inner_resolved)
                        let opt_c = struct_option_c_type(inner_resolved)
                        emit_line("{opt_c} {fname};")
                        reg_sf_entry(c_name, fname, CT_OPTION, opt_c, sv_tp(CT_OPTION, inner_ct, -1, inner_resolved), field_tid)
                    } else if is_compound_ct(inner_ct) != 0 {
                        let compound_name = compound_name_from_ann(inner_ann)
                        ensure_struct_option_type(compound_name)
                        let opt_c = struct_option_c_type(compound_name)
                        emit_line("{opt_c} {fname};")
                        reg_sf_entry(c_name, fname, CT_OPTION, opt_c, sv_tp(CT_OPTION, inner_ct, -1, compound_name), field_tid)
                    } else {
                        ensure_option_type(inner_ct)
                        let opt_c = option_c_type(inner_ct)
                        emit_line("{opt_c} {fname};")
                        reg_sf_entry(c_name, fname, CT_OPTION, "", sv_tp(CT_OPTION, inner_ct, -1, ""), field_tid)
                    }
                } else {
                    ensure_option_type(CT_INT)
                    let opt_c = option_c_type(CT_INT)
                    emit_line("{opt_c} {fname};")
                    reg_sf_entry(c_name, fname, CT_OPTION, "", sv_tp(CT_OPTION, CT_INT, -1, ""), field_tid)
                }
            } else if resolved == "Result" {
                let inner_elems = node_elements(type_ann_node)
                if inner_elems != -1 && sublist_length(inner_elems) >= 2 {
                    let ok_ann = sublist_get(inner_elems, 0)
                    let err_ann = sublist_get(inner_elems, 1)
                    let ok_raw = node_name(ok_ann)
                    let err_raw = node_name(err_ann)
                    let ok_stem = carrier_inner_instance_stem(ok_ann, tparams_sl, arg_tids)
                    let err_stem = carrier_inner_instance_stem(err_ann, tparams_sl, arg_tids)
                    let ok_resolved = if ok_stem != "" { ok_stem } else { resolve_mono_slot(ok_raw, tparams_sl, arg_tids, "struct_typedef_field_inner", "{c_name}.{fname}", ok_ann) }
                    let err_resolved = if err_stem != "" { err_stem } else { resolve_mono_slot(err_raw, tparams_sl, arg_tids, "struct_typedef_field_inner", "{c_name}.{fname}", err_ann) }
                    let ok_ct = type_from_name(ok_resolved)
                    let err_ct = type_from_name(err_resolved)
                    let ok_is_type = is_struct_type(ok_resolved) != 0 || is_enum_type(ok_resolved) != 0 || is_mono_struct_instance(ok_resolved) != 0
                    let err_is_type = is_struct_type(err_resolved) != 0 || is_enum_type(err_resolved) != 0 || is_mono_struct_instance(err_resolved) != 0
                    if ok_is_type || err_is_type {
                        let ok_tag = if ok_is_type { ok_resolved } else { c_type_tag(ok_ct) }
                        let err_tag = if err_is_type { err_resolved } else { c_type_tag(err_ct) }
                        ensure_struct_result_type(ok_tag, err_tag)
                        let res_c = struct_result_c_type(ok_tag, err_tag)
                        emit_line("{res_c} {fname};")
                        reg_sf_entry(c_name, fname, CT_RESULT, res_c, sv_tp(CT_RESULT, ok_ct, err_ct, ""), field_tid)
                    } else {
                        ensure_result_type(ok_ct, err_ct)
                        let res_c = result_c_type(ok_ct, err_ct)
                        emit_line("{res_c} {fname};")
                        reg_sf_entry(c_name, fname, CT_RESULT, "", sv_tp(CT_RESULT, ok_ct, err_ct, ""), field_tid)
                    }
                } else {
                    ensure_result_type(CT_INT, CT_STRING)
                    let res_c = result_c_type(CT_INT, CT_STRING)
                    emit_line("{res_c} {fname};")
                    reg_sf_entry(c_name, fname, CT_RESULT, "", sv_tp(CT_RESULT, CT_INT, CT_STRING, ""), field_tid)
                }
            } else if is_compound_tag(resolved) != 0 {
                // A bare-typevar field (`value: T`) whose concrete arg is a COMPOUND
                // carrier: `resolved` is the carrier TAG ("Option_int"), not the
                // bracketed annotation "Option" the branches above match, so emit the
                // carrier C type directly (blink_Option_int) instead of the CT_VOID
                // default `void value;` that mismatches the field value.
                // ensure_carrier_from_tag makes the typedef self-contained (the field
                // VALUE also emits it, so this is idempotent). Gate admits only
                // compound-of-scalar tags, so the tag→CT decode is exact.
                ensure_carrier_from_tag(resolved)
                let cct = compound_tag_ct(resolved)
                emit_line("{c_type_c_name(resolved)} {fname};")
                if cct == CT_OPTION {
                    reg_sf_entry(c_name, fname, cct, "", sv_tp(cct, option_inner_ct_from_tag(resolved), -1, option_inner_struct_from_tag(resolved)), field_tid)
                } else if cct == CT_RESULT {
                    let split = split_result_compound(resolved)
                    reg_sf_entry(c_name, fname, cct, "", sv_tp(cct, type_from_name_tag(split.first), type_from_name_tag(split.second), ""), field_tid)
                } else {
                    let kv = map_struct_scalar_kv(resolved)
                    reg_sf_entry(c_name, fname, cct, "", sv_tp(cct, kv.first, kv.second, ""), field_tid)
                }
            } else {
                let ct = type_from_name(resolved)
                emit_line("{c_field_type_str(ct, resolved)} {fname};")
                reg_sf_entry(c_name, fname, ct, "", sv_tp(ct, -1, -1, ""), field_tid)
            }
        } else {
            emit_line("int64_t {fname};")
            reg_sf_entry(c_name, fname, CT_INT, "", sv_tp(CT_INT, -1, -1, ""), -1)
        }
        i = i + 1
    }
    cg_indent = cg_indent - 1
    emit_line("} {c_type_c_name(c_name)};")
    emit_td_guard_close()
    emit_line("")
}

// The enum analogue of emit_mono_struct_typedef: emit a per-instance
// tagged-union typedef (`blink_Tree_Int`) for a generic-enum instance, resolving
// each variant payload field's type under T-substitution via resolve_tparam_via_tid
// — the substitution the base emitter (emit_enum_typedef) can't do because it lacks
// tparams_sl / arg_tids. Also registers the mono name in enum_reg_set so is_data_enum
// / c_type_from_tag recognize the instance, and emits the per-variant `_TAG` macros
// keyed on the mono C name.
fn emit_mono_enum_typedef(base_name: Str, concrete_args: Str, arg_tids0: List[Int], ann: Int) ! Codegen.Emit, Diag.Report {
    let td = find_type_def(base_name)
    if td == -1 { return }
    let tparams_sl = node_type_params(td)
    if tparams_sl == -1 { return }
    let arg_tids = mono_arg_tids_with_ann(arg_tids0, ann, base_name, sublist_length(tparams_sl))
    let segs = segs_from_arg_tids(arg_tids)
    let flds_sl = node_fields(td)
    if flds_sl == -1 { return }
    let c_name = mangle_generic_name(mono_phys_base(base_name), concrete_args)
    let td_cname = c_type_c_name(c_name)
    if enum_typedef_emitted.contains_key(td_cname) != 0 { return }
    enum_typedef_emitted.insert(td_cname, 1)
    // Register the mono name so is_data_enum(c_name) / c_type_from_tag recognize it.
    // The variant metadata itself stays keyed on the BARE base (emit_enum_typedef
    // populated it), which ctor/match reach by recovering the base via lookup_mono_base.
    enum_reg_set.insert(c_name, 1)

    // A Tuple variant-field carrier (e.g. `pair: (T,T)` -> Tuple2_P_P) must have
    // its own typedef forced BEFORE this enum's `typedef struct {` opens below —
    // emit_tuple_typedef_for_tag emits directly, so calling it inside the open
    // union would nest one typedef textually inside another (illegal C), and the
    // later top-level tuple flush lands AFTER this enum typedef that names it.
    // Mirrors emit_mono_struct_typedef's dependency pre-pass.
    //
    // EXCEPTION: a tuple whose elements reference THIS enum (`Pair(p: (Box[T],
    // Box[T]))`) embeds the enum by value and so forward-references it — its
    // typedef must come AFTER the enum, which boxes the field to int64_t below.
    // Defer those tags to a post-pass emitted once the enum typedef is closed.
    let mut deferred_selfrec_tuples: List[Str] = []
    let mut pv = 0
    while pv < sublist_length(flds_sl) {
        let pvnode = sublist_get(flds_sl, pv)
        let pvflds = node_fields(pvnode)
        if pvflds != -1 {
            let mut pf = 0
            while pf < sublist_length(pvflds) {
                let pvf = sublist_get(pvflds, pf)
                let pvf_ann_orig = node_value(pvf)
                if pvf_ann_orig != -1 {
                    let pvf_ann = resolve_alias_ann(pvf_ann_orig)
                    if node_name(pvf_ann) == "Tuple" {
                        let ptup = resolve_tuple_ann(pvf_ann, tparams_sl, segs)
                        if ptup.is_some() {
                            if tc_variant_field_is_selfrec_tuple(base_name, node_name(pvnode), node_name(pvf)) != 0 {
                                deferred_selfrec_tuples.push(ptup.unwrap())
                            } else {
                                emit_tuple_typedef_for_tag(ptup.unwrap())
                            }
                        }
                    } else {
                        // A typevar field (`One(x: T)`) bound to a tuple type-arg
                        // resolves to a registered tuple carrier; force its typedef
                        // too. A non-tuple resolution is a no-op in the emitter.
                        let presolved = resolve_mono_slot(node_name(pvf_ann), tparams_sl, arg_tids, "enum_typedef_tuple_prepass", "{c_name}.{node_name(pvnode)}.{node_name(pvf)}", pvf_ann)
                        emit_tuple_typedef_for_tag(presolved)
                    }
                }
                pf = pf + 1
            }
        }
        pv = pv + 1
    }

    emit_td_guard_open(td_cname)
    emit_line("typedef struct \{")
    cg_indent = cg_indent + 1
    emit_line("int tag;")
    emit_line("union \{")
    cg_indent = cg_indent + 1
    let mut i = 0
    while i < sublist_length(flds_sl) {
        let v = sublist_get(flds_sl, i)
        let vname = node_name(v)
        let vflds = node_fields(v)
        if vflds != -1 && sublist_length(vflds) > 0 {
            emit_line("struct \{")
            cg_indent = cg_indent + 1
            let mut fi = 0
            while fi < sublist_length(vflds) {
                let vf = sublist_get(vflds, fi)
                let vf_name = node_name(vf)
                let vf_type_ann_orig = node_value(vf)
                let mut vf_c_type = "int64_t"
                if vf_type_ann_orig != -1 {
                    let vf_type_ann = resolve_alias_ann(vf_type_ann_orig)
                    let vf_type_name = node_name(vf_type_ann)
                    let resolved = resolve_mono_slot(vf_type_name, tparams_sl, arg_tids, "enum_typedef_payload", "{c_name}.{vname}.{vf_name}", vf_type_ann)
                    if vf_type_name == "Tuple" {
                        if tc_variant_field_is_selfrec_tuple(base_name, vname, vf_name) != 0 {
                            // Self-recursive tuple field (`Pair(p: (Box[T], Box[T]))`):
                            // boxed as a heap pointer, so the union member is a bare
                            // int64_t (mirrors the direct self-recursive field below).
                            vf_c_type = "int64_t"
                        } else {
                            // Tuple payload: spell the tuple carrier under typevar
                            // substitution so `(T, T)` on an E[P] lowers to
                            // blink_Tuple2_P_P, not the erased/void fall-through.
                            let tup_opt = resolve_tuple_ann(vf_type_ann, tparams_sl, segs)
                            if tup_opt.is_some() {
                                vf_c_type = c_type_c_name(tup_opt.unwrap())
                            } else {
                                vf_c_type = c_field_type_str(type_from_name(vf_type_name), vf_type_name)
                            }
                        }
                    } else if resolved == base_name {
                        // Self-recursive field (`Branch(left: Tree[T], …)`): the ctor
                        // boxes it as (int64_t)(intptr_t)ptr, so the union member is a
                        // bare int64_t (mirrors emit_enum_typedef's vf_type_name==name).
                        vf_c_type = "int64_t"
                    } else if is_struct_type(resolved) != 0 || is_enum_type(resolved) != 0 || is_mono_struct_instance(resolved) != 0 {
                        vf_c_type = c_type_c_name(resolved)
                    } else {
                        let vf_ct = type_from_name(resolved)
                        if vf_ct == CT_OPTION {
                            // Resolve the Option inner under T-substitution so
                            // `Some(x: Option[T])` on a Tree[Int] spells blink_Option_int,
                            // not the erased blink_Option_T that compound_name_from_ann
                            // would read off the un-substituted annotation.
                            let inner_elems = node_elements(vf_type_ann)
                            if inner_elems != -1 && sublist_length(inner_elems) >= 1 {
                                let inner_ann = sublist_get(inner_elems, 0)
                                let inner_resolved = resolve_mono_slot(node_name(inner_ann), tparams_sl, arg_tids, "enum_typedef_payload_inner", "{c_name}.{vname}.{vf_name}", inner_ann)
                                let inner_ct = type_from_name(inner_resolved)
                                if is_struct_type(inner_resolved) != 0 || is_enum_type(inner_resolved) != 0 || is_mono_struct_instance(inner_resolved) != 0 {
                                    ensure_struct_option_type(inner_resolved)
                                    vf_c_type = struct_option_c_type(inner_resolved)
                                } else {
                                    ensure_option_type(inner_ct)
                                    vf_c_type = option_c_type(inner_ct)
                                }
                            } else {
                                ensure_option_type(CT_INT)
                                vf_c_type = option_c_type(CT_INT)
                            }
                        } else if vf_ct == CT_RESULT {
                            let inner_elems = node_elements(vf_type_ann)
                            if inner_elems != -1 && sublist_length(inner_elems) >= 2 {
                                let ok_resolved = resolve_mono_slot(node_name(sublist_get(inner_elems, 0)), tparams_sl, arg_tids, "enum_typedef_payload_inner", "{c_name}.{vname}.{vf_name}", sublist_get(inner_elems, 0))
                                let err_resolved = resolve_mono_slot(node_name(sublist_get(inner_elems, 1)), tparams_sl, arg_tids, "enum_typedef_payload_inner", "{c_name}.{vname}.{vf_name}", sublist_get(inner_elems, 1))
                                let ok_ct = type_from_name(ok_resolved)
                                let err_ct = type_from_name(err_resolved)
                                ensure_result_type(ok_ct, err_ct)
                                vf_c_type = result_c_type(ok_ct, err_ct)
                            } else {
                                ensure_result_type(CT_INT, CT_STRING)
                                vf_c_type = result_c_type(CT_INT, CT_STRING)
                            }
                        } else {
                            vf_c_type = c_field_type_str(vf_ct, resolved)
                        }
                    }
                }
                emit_line("{vf_c_type} {vf_name};")
                fi = fi + 1
            }
            cg_indent = cg_indent - 1
            emit_line("} {vname};")
        }
        i = i + 1
    }
    cg_indent = cg_indent - 1
    emit_line("} data;")
    cg_indent = cg_indent - 1
    emit_line("} {td_cname};")
    emit_td_guard_close()
    emit_line("")
    // Now that the enum typedef is complete, emit the self-recursive tuple
    // carriers it boxes (`Tuple2_Box_0Int_Box_0Int`), which embed this enum by
    // value and therefore had to wait for it. The ctor/match-binder reference
    // them from function bodies emitted far below, so this ordering suffices.
    let mut dt = 0
    while dt < deferred_selfrec_tuples.len() {
        emit_tuple_typedef_for_tag(deferred_selfrec_tuples.get(dt).unwrap())
        dt = dt + 1
    }
    i = 0
    while i < sublist_length(flds_sl) {
        let v = sublist_get(flds_sl, i)
        let vname = node_name(v)
        emit_line("#ifndef {td_cname}_{vname}_TAG")
        emit_line("#define {td_cname}_{vname}_TAG {i}")
        emit_line("#endif")
        i = i + 1
    }
    emit_line("")
}

pub fn emit_all_mono_typedefs() ! Codegen.Emit, Diag.Report, Codegen.Register {
    let mut i = 0
    while i < mono_instances.len() {
        let mi = mono_instances.get(i).unwrap()
        let td = find_type_def(mi.base)
        if td != -1 {
            let flds_sl = node_fields(td)
            if flds_sl != -1 && sublist_length(flds_sl) > 0 {
                if node_kind(sublist_get(flds_sl, 0)) != NodeKind.TypeVariant {
                    emit_mono_struct_typedef(mi.base, mi.args, mi.arg_tids, mi.ann)
                } else {
                    emit_mono_enum_typedef(mi.base, mi.args, mi.arg_tids, mi.ann)
                }
            }
        }
        i = i + 1
    }
}

fn build_closure_sig_resolved_mono(ta: Int, tparams_sl: Int, arg_tids: List[Int]) -> Str {
    let segs = segs_from_arg_tids(arg_tids)
    let ret_raw = node_return_type(ta)
    let ret_name = resolve_tparam_via_tid(ret_raw, tparams_sl, arg_tids)
    let ret_type = type_from_name(ret_name)
    let elems_sl = node_elements(ta)
    let mut sig_params = "const blink_closure*"
    if elems_sl != -1 && sublist_length(elems_sl) > 0 {
        let mut i = 0
        while i < sublist_length(elems_sl) {
            let elem = sublist_get(elems_sl, i)
            let ename_raw = node_name(elem)
            let ename = resolve_tparam_via_tid(ename_raw, tparams_sl, arg_tids)
            sig_params = sig_params.concat(", ")
            if is_enum_type(ename) != 0 {
                sig_params = sig_params.concat(c_type_c_name(ename))
            } else if is_struct_type(ename) != 0 {
                sig_params = sig_params.concat(c_type_c_name(ename))
            } else if ename == "Tuple" {
                let tup_opt = resolve_tuple_ann(elem, tparams_sl, segs)
                if tup_opt.is_some() {
                    sig_params = sig_params.concat(c_type_c_name(tup_opt.unwrap()))
                } else {
                    sig_params = sig_params.concat("void")
                }
            } else {
                sig_params = sig_params.concat(c_type_str(type_from_name(ename)))
            }
            i = i + 1
        }
    }
    let mut ret_str = c_type_str(ret_type)
    if is_struct_type(ret_name) != 0 {
        ret_str = c_type_c_name(ret_name)
    } else if is_enum_type(ret_name) != 0 {
        ret_str = c_type_c_name(ret_name)
    } else if ret_name == "Tuple" {
        let ret_ann = node_type_ann(ta)
        if ret_ann != -1 {
            let tup_opt = resolve_tuple_ann(ret_ann, tparams_sl, segs)
            if tup_opt.is_some() {
                ret_str = c_type_c_name(tup_opt.unwrap())
            }
        }
    }
    "{ret_str}(*)({sig_params})"
}

type MonoSig {
    sig: Str
    storage: Str
    ret_c_str: Str
    params_c: Str
    mangled: Str
    ret_type: Int
    resolved_ret: Str
}

// Build the C signature for a monomorphized fn instance. Shared by the forward
// decl and the def so the two never drift. Runs the idempotent ensure_* type
// registrations and sets cg_current_fn_option_inner* as a side effect (the def
// body reads them; the decl pass overwrites them harmlessly).
@allow(UnrestoredMutation, IncompleteStateRestore)
fn mono_fn_signature(fn_node: Int, concrete_args: Str, arg_tids: List[Int]) -> MonoSig ! Codegen.Register, Diag.Report {
    cg_handler_vtable_type = ""
    cg_handler_vtable_field = ""
    cg_handler_is_user_effect = 0
    cg_current_fn_option_inner_struct = ""
    cg_current_module = node_source_module(fn_node)
    let base_name = node_name(fn_node)
    let mangled = mangle_generic_name(base_name, concrete_args)
    let tparams_sl = node_type_params(fn_node)
    let segs = segs_from_arg_tids(arg_tids)
    let storage = mono_storage_class(fn_node)

    // Resolve return type
    let ret_str = node_return_type(fn_node)
    let resolved_ret = resolve_mono_slot(ret_str, tparams_sl, arg_tids, "mono_fn_signature_ret", "{node_name(fn_node)}/{concrete_args}", fn_node)
    // A bare-typevar return (`-> T`) bound to a compound resolves to the carrier
    // tag (Option_int / Result_int_str / Map_..), whose type_from_name is
    // CT_VOID (the tag has no `[`). No call node / tid exists here (this is the
    // mono-registry-driven def side), so decode the carrier tag directly — the
    // same precedent as the compound-param branch below and resolve_tuple_ann.
    // Reroute ret_type off CT_VOID so the arm fires. The return annotation for
    // a bare `-> T` is the typevar node with no compound children, so the
    // arms' annotation reads fall through to the tag-derived else branch.
    let ret_name_ct = type_from_name(resolved_ret)
    // `rerouted` marks that ret_type came from a bare-typevar compound carrier
    // tag (Option_int / Result_..), NOT a genuine `-> Option`/`-> Result`. Only
    // the tag-recovery else branches below run under it — a bracketless
    // `-> Option` (resolved_ret == "Option", is_compound_tag == 0) never reroutes
    // and keeps its prior behavior.
    let rerouted = ret_name_ct == CT_VOID && is_compound_tag(resolved_ret) != 0
    let ret_type = if rerouted { compound_tag_ct(resolved_ret) } else { ret_name_ct }
    // The resolved carrier tag has module-qualified struct/enum inners
    // STRIPPED (e.g. `Option_Row`, not `Option_std_db_row_Row`). ensure_carrier_
    // from_tag + the call site both canonicalize via canonical_struct_tag, but
    // c_type_from_tag's compound branch emits `blink_{tag}` RAW — so the fn
    // signature would name a carrier that was never typedef'd for a module-
    // defined inner. Canonicalize the tag first so the emitted C name matches the
    // typedef and the caller-side carrier.
    let canon_ret = if rerouted { canonical_struct_tag(resolved_ret) } else { resolved_ret }
    let mut ret_c_str = c_type_str(ret_type)
    if ret_type == CT_OPTION {
        let ret_ann = node_type_ann(fn_node)
        let ann_elems = if ret_ann != -1 { node_elements(ret_ann) } else { -1 }
        if ann_elems != -1 && sublist_length(ann_elems) >= 1 {
            let inner_ann = sublist_get(ann_elems, 0)
            let inner_name_raw = node_name(inner_ann)
            let inner_name = resolve_tparam_via_tid(inner_name_raw, tparams_sl, arg_tids)
            let inner_ct = type_from_name(inner_name)
            if inner_ct == CT_VOID && is_struct_or_enum_type(inner_name) != 0 {
                ensure_struct_option_type(inner_name)
                ret_c_str = struct_option_c_type(inner_name)
                cg_current_fn_option_inner_struct = inner_name
            } else if is_compound_ct(inner_ct) != 0 {
                // A type-param inner (`-> Option[Map[K,V]]`) erases through the plain
                // annotation decoder — compound_name_from_ann reads K,V as bare names and
                // spells `Map_void_void`, so the signature named a carrier the body and
                // caller never use. The def-side arg_tids ARE the type-param bindings, so
                // segs spells the inner concretely (`Map_str_int`), matching both.
                let compound_name = compound_name_from_ann_ctx(inner_ann, tparams_sl, arg_tids, segs)
                ensure_struct_option_type(compound_name)
                ret_c_str = struct_option_c_type(compound_name)
                cg_current_fn_option_inner_struct = compound_name
            } else {
                ensure_option_type(inner_ct)
                ret_c_str = option_c_type(inner_ct)
                cg_current_fn_option_inner_struct = ""
            }
            cg_current_fn_option_inner = inner_ct
        } else if rerouted {
            // Bare-typevar `-> T` bound to Option[..]: derive the carrier + inner
            // from the canonicalized tag. c_type_from_tag names the
            // carrier (blink_Option_int / blink_Option_<canonical-struct>);
            // ensure_carrier_from_tag emits the typedef; option_inner_*_from_tag
            // recover the inner CT / struct for cg_current_fn_option_inner*.
            ensure_carrier_from_tag(canon_ret)
            ret_c_str = c_type_from_tag(canon_ret)
            cg_current_fn_option_inner = option_inner_ct_from_tag(canon_ret)
            cg_current_fn_option_inner_struct = option_inner_struct_from_tag(canon_ret)
        }
    } else if ret_type == CT_RESULT {
        let ret_ann = node_type_ann(fn_node)
        let ann_elems = if ret_ann != -1 { node_elements(ret_ann) } else { -1 }
        if ann_elems != -1 && sublist_length(ann_elems) >= 2 {
            let ok_ann = sublist_get(ann_elems, 0)
            let err_ann = sublist_get(ann_elems, 1)
            let ok_name = resolve_tparam_via_tid(node_name(ok_ann), tparams_sl, arg_tids)
            let err_name = resolve_tparam_via_tid(node_name(err_ann), tparams_sl, arg_tids)
            let ok_ct = type_from_name(ok_name)
            let err_ct = type_from_name(err_name)
            // A struct/enum inner has CT_VOID/CT_STRUCT that result_c_type
            // can't name, so it emitted `blink_Result_void_str` for the fn's
            // return type while the body + call site used the correctly-named
            // carrier — an invalid-initializer mismatch. Thread the struct
            // names through the mixed carrier, mirroring the CT_OPTION branch
            // above (a generic fn returning Result[UserStruct, _]). A COMPOUND
            // inner (`-> Result[Map[K,V], E]`) erases the same way — the flat
            // channel spells `Result_map_str` — so recover the concrete inner
            // stem from the annotation's mono, in the fn's segs context.
            let ok_struct = if is_struct_or_enum_type(ok_name) != 0 { ok_name } else if is_compound_ct(ok_ct) != 0 { compound_name_from_ann_ctx(ok_ann, tparams_sl, arg_tids, segs) } else { "" }
            let err_struct = if is_struct_or_enum_type(err_name) != 0 { err_name } else if is_compound_ct(err_ct) != 0 { compound_name_from_ann_ctx(err_ann, tparams_sl, arg_tids, segs) } else { "" }
            if ok_struct != "" || err_struct != "" {
                ensure_mixed_result_type(ok_ct, err_ct, ok_struct, err_struct)
                ret_c_str = result_c_type_mixed(ok_ct, err_ct, ok_struct, err_struct)
            } else {
                ensure_result_type(ok_ct, err_ct)
                ret_c_str = result_c_type(ok_ct, err_ct)
            }
        } else if rerouted {
            // Bare-typevar `-> T` bound to Result[..]: derive the carrier from
            // the canonicalized tag, mirroring the compound-param branch.
            // canon_ret canonicalizes module-qualified struct/enum inners so the
            // emitted C name matches the typedef ensure_carrier_from_tag emits.
            ensure_carrier_from_tag(canon_ret)
            ret_c_str = c_type_from_tag(canon_ret)
        }
    } else if is_struct_type(resolved_ret) != 0 || is_enum_type(resolved_ret) != 0 {
        let mono_name = mono_name_from_ann(resolved_ret, node_type_ann(fn_node), tparams_sl, segs)
        if mono_name != "" {
            ret_c_str = c_type_c_name(mono_name)
        } else {
            ret_c_str = c_type_c_name(resolved_ret)
        }
    } else if resolved_ret == "Tuple" {
        // Generic fn returning a tuple: route through resolve_tuple_ann so the
        // canonical name (with Option[T]'s T preserved) is used instead of the
        // CT_VOID default of `void`.
        let tup_opt = resolve_tuple_ann(node_type_ann(fn_node), tparams_sl, segs)
        if tup_opt.is_some() { ret_c_str = c_type_c_name(tup_opt.unwrap()) }
    }

    // Build parameter string with substituted types
    let params_sl = node_params(fn_node)
    let mono_has_ev = fn_node_has_effects(fn_node) != 0 && get_ffi_ann(fn_node) == -1
    let mut params_c = "void"
    if params_sl != -1 && sublist_length(params_sl) > 0 {
        params_c = ""
        let mut i = 0
        while i < sublist_length(params_sl) {
            let p = sublist_get(params_sl, i)
            let pname = c_safe_name(node_name(p))
            let ptype = node_type_name(p)
            let resolved_ptype = resolve_tparam_via_tid(ptype, tparams_sl, arg_tids)
            if i > 0 {
                params_c = params_c.concat(", ")
            }
            if is_struct_type(resolved_ptype) != 0 {
                let p_mono_name = mono_name_from_ann(resolved_ptype, node_type_ann(p), tparams_sl, segs)
                let p_c_type = if p_mono_name != "" { c_type_c_name(p_mono_name) } else { c_type_c_name(resolved_ptype) }
                params_c = params_c.concat("{p_c_type} {pname}")
            } else if is_enum_type(resolved_ptype) != 0 {
                // A generic-enum INSTANCE param (`t: Tree[T]` with T=Int)
                // spells the mono enum name (blink_Tree_Int), mirroring the struct arm
                // above — else the bare blink_Tree is emitted (undeclared) and the
                // mangled fn is blink_count_Void. "" falls back to the bare head for a
                // non-generic enum param.
                let p_mono_name = mono_name_from_ann(resolved_ptype, node_type_ann(p), tparams_sl, segs)
                let p_c_type = if p_mono_name != "" { c_type_c_name(p_mono_name) } else { c_type_c_name(resolved_ptype) }
                params_c = params_c.concat("{p_c_type} {pname}")
            } else if is_compound_tag(resolved_ptype) != 0 {
                // Bare typevar param `x: T` bound to a whole Option/Result: the
                // resolved name is the inner-carrying tag (Option_str, ...), not
                // "Option". Emit its parameterized carrier directly (Map tags
                // still fall to blink_map* via c_type_c_name).
                ensure_carrier_from_tag(resolved_ptype)
                params_c = params_c.concat("{c_type_c_name(resolved_ptype)} {pname}")
            } else if resolved_ptype == "Option" || resolved_ptype == "Result" {
                let p_c_type = mono_option_result_param_c_type(p, resolved_ptype, tparams_sl, arg_tids)
                params_c = params_c.concat("{p_c_type} {pname}")
            } else {
                let ct = type_from_name(resolved_ptype)
                params_c = params_c.concat("{c_type_str(ct)} {pname}")
            }
            i = i + 1
        }
    }
    if mono_has_ev {
        if params_c == "void" || params_c == "" {
            params_c = "blink_ev* __ev"
        } else {
            params_c = params_c.concat(", blink_ev* __ev")
        }
    }

    MonoSig {
        sig: "{storage}{ret_c_str} {c_fn_name(mangled)}({params_c})",
        storage: storage,
        ret_c_str: ret_c_str,
        params_c: params_c,
        mangled: mangled,
        ret_type: ret_type,
        resolved_ret: resolved_ret,
    }
}

fn emit_mono_fn_decl(fn_node: Int, concrete_args: Str, arg_tids: List[Int]) ! Codegen.Emit, Codegen.Register, Diag.Report {
    let sig = mono_fn_signature(fn_node, concrete_args, arg_tids)
    emit_line("{sig.sig};")
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_mono_fn_def(fn_node: Int, concrete_args: Str, arg_tids: List[Int]) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let sig = mono_fn_signature(fn_node, concrete_args, arg_tids)
    let storage = sig.storage
    let ret_c_str = sig.ret_c_str
    let params_c = sig.params_c
    let mangled = sig.mangled
    let ret_type = sig.ret_type
    let resolved_ret = sig.resolved_ret
    let tparams_sl = node_type_params(fn_node)
    let segs = segs_from_arg_tids(arg_tids)
    let params_sl = node_params(fn_node)

    // Forward decl carries the same storage class as the def below;
    // otherwise C rejects `static inline` following a non-static proto.
    emit_line("{sig.sig};")

    // Register params in scope
    push_scope()
    cg_temp_counter = 0
    if params_sl != -1 {
        let mut i = 0
        while i < sublist_length(params_sl) {
            let p = sublist_get(params_sl, i)
            let pname = node_name(p)
            let ptype = node_type_name(p)
            let resolved_ptype = resolve_tparam_via_tid(ptype, tparams_sl, arg_tids)
            if resolved_ptype == "Fn" {
                set_var(pname, CT_CLOSURE, 1)
                let ta = node_type_ann(p)
                if ta != -1 {
                    let sig_str = build_closure_sig_resolved_mono(ta, tparams_sl, arg_tids)
                    set_var_closure(pname, sig_str, tc_tid_subst_mono(tc_lookup_node_tid(p), tparams_sl, arg_tids))
                }
            } else if type_from_name(resolved_ptype) == CT_VOID && is_compound_tag(resolved_ptype) != 0 && is_struct_type(resolved_ptype) == 0 && is_enum_type(resolved_ptype) == 0 {
                // A bare-typevar param (`x: T`) bound to a whole Option/Result
                // resolves to the carrier tag (Option_int, ...), reaching the
                // same outcome as mono_fn_signature's own compound-param arm
                // above so the local's scope CT agrees with the signature's C
                // type by construction — though that arm excludes struct/enum
                // by ARM ORDERING, not by an explicit clause the way this one
                // does. The `type_from_name(...) == CT_VOID` guard (absent
                // from that arm, a pre-existing gap shared with it) keeps a
                // type ALIAS literally spelled like a carrier tag (`type
                // Result_x = Int`) on its normal scalar/struct path instead of
                // being misrouted into the carrier decoder.
                //
                // RAW, not canonicalized -- mirrors mono_fn_signature exactly,
                // which also calls ensure_carrier_from_tag on the raw tag. The
                // poly-impl twin below canonicalizes first because its own
                // signature builder does; see the comment there.
                register_var_compound_from_tag(pname, resolved_ptype, 1)
            } else {
                let param_ct = if is_enum_type(resolved_ptype) != 0 { CT_INT } else { type_from_name(resolved_ptype) }
                set_var(pname, param_ct, 1)
                if is_struct_type(resolved_ptype) != 0 {
                    let p_mono_name = mono_name_from_ann(resolved_ptype, node_type_ann(p), tparams_sl, segs)
                    let mono_struct_name = if p_mono_name != "" { p_mono_name } else { resolved_ptype }
                    set_var_struct(pname, mono_struct_name)
                    // Carry the tid, pre-substituted through this mono's own tparams so
                    // it is already concrete (cg_fn_mono_* is not set until body emit).
                    // A concrete tid round-trips as identity at read time and is also
                    // right for non-rebinding readers. Gate on the reader's mono
                    // round-trip; enums keep the flat channel (own increment).
                    let raw_ptid = tc_lookup_node_tid(node_type_ann(p))
                    let mono_ptid = tc_tid_subst_mono(tc_tid_resolved(raw_ptid), tparams_sl, arg_tids)
                    if mono_ptid >= 0 && tc_tid_is_enum(mono_ptid) == 0 && tc_tid_struct_mono_name(mono_ptid) == mono_struct_name {
                        set_var_ty(pname, mono_ptid)
                    }
                }
                if is_enum_type(resolved_ptype) != 0 {
                    // A generic-enum INSTANCE param (`t: Tree[T]`, T=Int). Two
                    // bindings, exactly as the match-materialization path reads
                    // them: var_enums carries the BARE base (Tree) so variant
                    // tag/field lookups (get_var_enum → match_scrut_enum, kept bare)
                    // work, and set_var_struct carries the MONO stem (Tree_Int) so the
                    // scrutinee temp and recursive-field bindings get the concrete C
                    // type (blink_Tree_Int) instead of the erased bare blink_Tree. ""
                    // (non-generic enum) keeps the bare head on both.
                    var_enums.push(VarEnumEntry { name: pname, enum_type: resolved_ptype })
                    let p_mono_name = mono_name_from_ann(resolved_ptype, node_type_ann(p), tparams_sl, segs)
                    if p_mono_name != "" {
                        set_var_struct(pname, p_mono_name)
                    }
                }
                if resolved_ptype == "List" {
                    let ta = node_type_ann(p)
                    if ta != -1 {
                        let elems_sl = node_elements(ta)
                        if elems_sl != -1 && sublist_length(elems_sl) > 0 {
                            let elem_ann = sublist_get(elems_sl, 0)
                            let elem_name_raw = node_name(elem_ann)
                            let elem_name = resolve_tparam_via_tid(elem_name_raw, tparams_sl, arg_tids)
                            let elem_ct = type_from_name(elem_name)
                            set_list_elem_type(pname, elem_ct)
                            if elem_ct != CT_VOID {
                                ensure_option_type(elem_ct)
                            }
                            if elem_ct == CT_VOID && (is_named_type(elem_name) != 0) {
                                set_list_elem_struct(pname, elem_name)
                            } else if elem_ct == CT_VOID && elem_name == "Tuple" {
                                let tup_opt = resolve_tuple_ann(elem_ann, tparams_sl, segs)
                                if tup_opt.is_some() {
                                    set_list_elem_struct(pname, tup_opt.unwrap())
                                }
                            }
                            if elem_ct == CT_LIST {
                                let nested_sl = node_elements(elem_ann)
                                if nested_sl != -1 && sublist_length(nested_sl) > 0 {
                                    let nested_ann = sublist_get(nested_sl, 0)
                                    let nested_name = node_name(nested_ann)
                                    let nested_ct = type_from_name(nested_name)
                                    set_list_nested_elem_type(pname, nested_ct)
                                }
                            }
                            if elem_ct == CT_SET {
                                let nested_sl = node_elements(elem_ann)
                                if nested_sl != -1 && sublist_length(nested_sl) > 0 {
                                    let nested_ann = sublist_get(nested_sl, 0)
                                    let nested_name_raw = node_name(nested_ann)
                                    let nested_name = resolve_tparam_via_tid(nested_name_raw, tparams_sl, arg_tids)
                                    let nested_ct = type_from_name(nested_name)
                                    set_list_nested_elem_type(pname, nested_ct)
                                }
                            }
                            if elem_ct == CT_MAP {
                                set_list_elem_map_ann(pname, elem_ann)
                            }
                            let _ = set_list_elem_compound_ann(pname, elem_ann, elem_ct)
                            // Every branch above spells the element from the ANNOTATION, and
                            // only its OUTER name goes through resolve_tparam_via_tid — a
                            // COMPOUND element's inner is read raw (set_list_elem_compound_ann
                            // → deep_tp_from_ann on the `T` node). Left alone, a mono instance
                            // of `xs: List[Option[T]]` would bind its element as an Option
                            // over nothing (`blink_Option_void`), and `List[Result[T, Str]]`
                            // would return a `blink_Result_void_str` where a `Result_int_str`
                            // was expected. The tid does carry T substituted once it is
                            // rewritten through THIS instance's binder, so the ladder below
                            // spells every element kind faithfully or declines whole, and the
                            // annotation's answer survives only where it declines — the same
                            // ordering the let-binding ladders use. tparams_sl/arg_tids are
                            // passed explicitly because cg_mono_* is not switched to this
                            // instance until emit_fn_body, further down.
                            //
                            // The PARAM node, not its annotation, is where typecheck publishes the
                            // resolved type; the annotation carries a tid only for the shapes that
                            // walk it, so it is the fallback. Same rule params_measure states.
                            let mut praw = tc_lookup_node_tid(p)
                            if praw < 0 { praw = tc_lookup_node_tid(ta) }
                            // Records what the annotation had already written, so a corpus sweep can
                            // tell the three outcomes apart: the stamp declined (the annotation still
                            // governs), it agreed, or it OVERRODE. Only the third is a behavior
                            // change, and it is the one that has to be attributed shape by shape.
                            //
                            // tp_display of the WHOLE var type, not the (ct, sname) pair the stamp
                            // returns: a compound element's inner lives in tp_id, so `List[Option[T]]`
                            // and `List[Option[Int]]` both read back as ct=CT_OPTION with an empty
                            // sname and the pair cannot tell them apart — which is the exact defect
                            // being measured.
                            let mono_tracing = dbg_channel_on("monoparam")
                            let pre_tp = if mono_tracing != 0 { tp_display(get_var_tp(pname)) } else { "" }
                            let st = stamp_list_elem_from_list_tid(tc_tid_subst_mono(tc_tid_resolved(praw), tparams_sl, arg_tids), pname)
                            if mono_tracing != 0 {
                                dbg_trace("monoparam", "fn={mangled} param={pname} declined={st.ct} pre={pre_tp} post={tp_display(get_var_tp(pname))}")
                            }
                        }
                    }
                }
                if resolved_ptype == "Map" {
                    let ta = node_type_ann(p)
                    if ta != -1 {
                        let elems_sl = node_elements(ta)
                        if elems_sl != -1 && sublist_length(elems_sl) >= 2 {
                            let key_ann = sublist_get(elems_sl, 0)
                            let val_ann = sublist_get(elems_sl, 1)
                            let key_name_raw = node_name(key_ann)
                            let key_name = resolve_tparam_via_tid(key_name_raw, tparams_sl, arg_tids)
                            let key_ct = type_from_name(key_name)
                            let val_name_raw = node_name(val_ann)
                            // resolve_tparam_via_tid only substitutes a BARE binder
                            // ("V" -> "Box"); a nested generic-struct instance written
                            // literally in the annotation ("Box[T]") still needs its
                            // own type-arg substituted via the annotation's own tid
                            // before falling back to the bare-binder path.
                            let val_inst_stem = ann_mono_stem(val_ann)
                            let val_name = if val_inst_stem != "" { val_inst_stem } else { resolve_tparam_via_tid(val_name_raw, tparams_sl, arg_tids) }
                            let val_ct = type_from_name(val_name)
                            set_map_types(pname, key_ct, val_ct, val_name)
                            if val_inst_stem != "" {
                                // See emit_fn_def's Map param handling for why this
                                // must be unconditional: struct_reg_set race at bind time.
                                set_map_value_struct(pname, val_inst_stem)
                                register_map_elem_struct_mono_from_tid(tc_lookup_node_tid(val_ann))
                            }
                            if key_ct == CT_VOID && is_named_type(key_name) != 0 {
                                set_map_key_struct(pname, key_name)
                            }
                            if val_ct == CT_LIST {
                                let val_elems = node_elements(val_ann)
                                if val_elems != -1 && sublist_length(val_elems) > 0 {
                                    let inner_ann = sublist_get(val_elems, 0)
                                    let inner_name_raw = node_name(inner_ann)
                                    let inner_name = resolve_tparam_via_tid(inner_name_raw, tparams_sl, arg_tids)
                                    set_map_value_list_elem(pname, type_from_name(inner_name))
                                }
                            }
                        }
                    }
                }
                if resolved_ptype == "Tuple" {
                    let ta = node_type_ann(p)
                    if ta != -1 {
                        let tup_name = resolve_tuple_ann(ta, tparams_sl, segs).unwrap()
                        set_var_struct(pname, tup_name)
                    }
                }
                if resolved_ptype == "Option" {
                    let ta = node_type_ann(p)
                    if ta != -1 {
                        let elems_sl = node_elements(ta)
                        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
                            let inner_ann = sublist_get(elems_sl, 0)
                            let inner_name = resolve_tparam_via_tid(node_name(inner_ann), tparams_sl, arg_tids)
                            let inner_ct = type_from_name(inner_name)
                            if is_struct_type(inner_name) != 0 || is_enum_type(inner_name) != 0 {
                                set_var_option_struct(pname, CT_INT, inner_name)
                            } else if inner_name == "Set" {
                                // See the twin block in emit_fn_def -- the Set's own
                                // element rides the option's inner2 slot, not
                                // is_compound_ct (CT_SET is deliberately excluded there).
                                set_var_option(pname, inner_ct)
                                let set_elems_sl = node_elements(inner_ann)
                                if set_elems_sl != -1 && sublist_length(set_elems_sl) > 0 {
                                    let set_elem_ann = sublist_get(set_elems_sl, 0)
                                    let set_elem_name = resolve_tparam_via_tid(node_name(set_elem_ann), tparams_sl, arg_tids)
                                    let set_elem_ct = type_from_name(set_elem_name)
                                    if set_elem_ct >= 0 && set_elem_ct != CT_VOID {
                                        set_var_option_inner2(pname, set_elem_ct)
                                    } else {
                                        recover_option_set_elem_from_tid(inner_ann, pname)
                                    }
                                }
                            } else {
                                set_var_option(pname, inner_ct)
                            }
                        }
                    }
                }
                if resolved_ptype == "Result" {
                    let ta = node_type_ann(p)
                    if ta != -1 {
                        let elems_sl = node_elements(ta)
                        if elems_sl != -1 && sublist_length(elems_sl) >= 2 {
                            let ok_name = resolve_tparam_via_tid(node_name(sublist_get(elems_sl, 0)), tparams_sl, arg_tids)
                            let err_name = resolve_tparam_via_tid(node_name(sublist_get(elems_sl, 1)), tparams_sl, arg_tids)
                            let ok_ct = type_from_name(ok_name)
                            let err_ct = type_from_name(err_name)
                            let ok_s = if is_struct_type(ok_name) != 0 || is_enum_type(ok_name) != 0 { ok_name } else { "" }
                            let err_s = if is_struct_type(err_name) != 0 || is_enum_type(err_name) != 0 { err_name } else { "" }
                            if ok_s != "" || err_s != "" {
                                set_var_result_struct(pname, ok_ct, err_ct, ok_s, err_s)
                            } else {
                                set_var_result(pname, ok_ct, err_ct)
                            }
                        }
                    }
                }
                if resolved_ptype == "Set" {
                    let ta = node_type_ann(p)
                    if ta != -1 {
                        let elems_sl = node_elements(ta)
                        if elems_sl != -1 && sublist_length(elems_sl) > 0 {
                            let elem_ann = sublist_get(elems_sl, 0)
                            let elem_name_raw = node_name(elem_ann)
                            let elem_name = resolve_tparam_via_tid(elem_name_raw, tparams_sl, arg_tids)
                            let elem_ct = type_from_name(elem_name)
                            if elem_ct >= 0 && elem_ct != CT_VOID {
                                set_set_elem_type(pname, elem_ct)
                            } else {
                                // See the twin block in emit_impl_method_def: recover
                                // the mono-substituted element from the annotation's
                                // tid rather than leaving it unstamped.
                                recover_set_elem_from_tid(ta, pname)
                            }
                        }
                    }
                }
            }
            i = i + 1
        }
    }
    params_measure(params_sl, tparams_sl, arg_tids)

    let saved_trace_fn = cg_trace_fn_qualified
    let saved_trace_mod = cg_trace_module
    let saved_in_traced = cg_in_traced_fn
    cg_in_traced_fn = 0
    let saved_fn_name = cg_current_fn_name
    let saved_fn_has_ev = cg_current_fn_has_ev
    let saved_fn_ret = cg_current_fn_ret
    let saved_fn_option_inner = cg_current_fn_option_inner
    let saved_fn_node = cg_current_fn_node
    cg_current_fn_name = mangled
    cg_current_fn_has_ev = if fn_node_has_effects(fn_node) != 0 { 1 } else { 0 }
    cg_current_fn_ret = ret_type
    cg_current_fn_node = fn_node
    emit_line("{storage}{ret_c_str} {c_fn_name(mangled)}({params_c}) \{")
    cg_indent = cg_indent + 1

    emit_unused_param_voids(params_sl)

    let trace_mod = node_source_module(fn_node)
    let trace_file = diag_file_for_node(fn_node)
    emit_trace_enter(fn_node, mangled, trace_mod, trace_file)

    let mut body_ret = ret_type
    if ret_needs_struct_body(resolved_ret) != 0 {
        body_ret = CT_INT
    }
    let saved_mono_tparams = cg_mono_tparams_sl
    let saved_mono_arg_tids = cg_mono_arg_tids
    let saved_fn_mono_tparams = cg_fn_mono_tparams_sl
    let saved_fn_mono_arg_tids = cg_fn_mono_arg_tids
    cg_mono_tparams_sl = tparams_sl
    cg_mono_arg_tids = arg_tids
    cg_fn_mono_tparams_sl = tparams_sl
    cg_fn_mono_arg_tids = arg_tids
    emit_fn_body(node_body(fn_node), body_ret)
    cg_mono_tparams_sl = saved_mono_tparams
    cg_mono_arg_tids = saved_mono_arg_tids
    cg_fn_mono_tparams_sl = saved_fn_mono_tparams
    cg_fn_mono_arg_tids = saved_fn_mono_arg_tids
    if ret_type == CT_VOID && body_ret == CT_VOID {
        emit_trace_exit_void()
    }
    cg_indent = cg_indent - 1
    emit_line("}")
    emit_line("")
    cg_current_fn_name = saved_fn_name
    cg_current_fn_has_ev = saved_fn_has_ev
    cg_current_fn_ret = saved_fn_ret
    cg_current_fn_option_inner = saved_fn_option_inner
    cg_current_fn_node = saved_fn_node
    cg_trace_fn_qualified = saved_trace_fn
    cg_trace_module = saved_trace_mod
    cg_in_traced_fn = saved_in_traced
    pop_scope()
}

// Register the element type of a poly-impl `self`/List[T] param from
// the resolved element NAME (a resolve_tparam_via_tid result). A scalar or a
// struct/enum element registers exactly as before (byte-identical). A COMPOUND
// element resolves to a carrier tag (Option_int / Result_int_str / Map_int_str)
// whose type_from_name is CT_VOID; recover the real CT via compound_tag_ct and
// stamp the list element as that compound so body method calls on the receiver
// see the concrete element rather than a Void.
fn register_poly_list_elem(pname: Str, elem_name: Str) ! Codegen.Register {
    let name_ct = type_from_name(elem_name)
    if name_ct == CT_VOID && is_compound_tag(elem_name) != 0 {
        // A COMPOUND element (carrier tag Option_str / Result_int_str): decode the
        // carrier's inner(s) from the tag and store the FULL nested element type via
        // set_list_elem_option / set_list_elem_result. The flat
        // set_list_elem_type(CT_OPTION) would default the inner to Int, erasing a
        // `List[Option[Str]]` element back to `List[Option[Int]]`.
        let canon = canonical_struct_tag(elem_name)
        ensure_carrier_from_tag(canon)
        if elem_name.starts_with("Option_") {
            let inner_struct = option_inner_struct_from_tag(canon)
            // A struct/enum inner must route sv_tp through its CT_STRUCT case (which
            // carries the name); passing the option_inner_ct_from_tag sentinel CT_INT
            // would drop the struct name. Scalars keep their real CT.
            let inner_ct = if inner_struct != "" { CT_STRUCT } else { option_inner_ct_from_tag(canon) }
            set_list_elem_option(pname, inner_ct, inner_struct)
        } else if elem_name.starts_with("Result_") {
            let parts = split_result_compound(canon)
            let ok_struct = typedef_tag_or_empty(parts.first)
            let err_struct = typedef_tag_or_empty(parts.second)
            let ok_ct = if ok_struct != "" { CT_STRUCT } else { type_from_name_tag(parts.first) }
            let err_ct = if err_struct != "" { CT_STRUCT } else { type_from_name_tag(parts.second) }
            set_list_elem_result(pname, ok_ct, ok_struct, err_ct, err_struct)
        } else {
            // Map_ carrier: keep the existing bare CT_MAP registration (the flat
            // slot + set_list_elem_map already handle Map via its own annotation path).
            set_list_elem_type(pname, compound_tag_ct(elem_name))
        }
        return
    }
    set_list_elem_type(pname, name_ct)
    if name_ct != CT_VOID {
        ensure_option_type(name_ct)
    }
    if name_ct == CT_VOID && is_named_type(elem_name) != 0 {
        set_list_elem_struct(pname, elem_name)
    }
}

// Build the C signature for a monomorphized poly-impl method
// (`impl[T] Trait[T] for List[T]`). Like mono_fn_signature, but the type
// params are the impl binders (node_impl_binders), not the fn's own tparams,
// and the `self: List[T]` receiver lowers to `blink_list*` through the scalar
// branch. Option/Result params and returns route through
// mono_option_result_param_c_type so their carrier typedefs are queued before
// the body (flush_mono_fns_with_typedefs orders typedefs → decls → bodies).
fn poly_impl_method_signature(im: Int, method_node: Int, concrete_args: Str, arg_tids: List[Int]) -> MonoSig ! Codegen.Register, Diag.Report {
    cg_handler_vtable_type = ""
    cg_handler_vtable_field = ""
    cg_handler_is_user_effect = 0
    cg_current_fn_option_inner_struct = ""
    cg_current_module = node_source_module(method_node)
    let composed = mangle_impl_method_q(node_name(im), node_trait_name(im), node_name(method_node))
    let mangled = mangle_generic_name(composed, concrete_args)
    let tparams_sl = node_impl_binders(im)
    let segs = segs_from_arg_tids(arg_tids)
    let storage = mono_storage_class(method_node)

    let ret_str = node_return_type(method_node)
    let resolved_ret = resolve_tparam_via_tid(ret_str, tparams_sl, arg_tids)
    // A bare-binder return (`-> T`) bound to a COMPOUND element resolves
    // to the carrier tag (Option_int / Result_int_str / Map_int_str), whose
    // type_from_name is CT_VOID (a tag is not a head name) — so the def-side
    // signature would emit `void` while the call site expects the compound carrier.
    // Reroute the CT off the tag exactly as the free-fn twin mono_fn_signature does,
    // and emit the parameterized carrier C type (canonicalize a module-qualified
    // inner so the name matches the typedef ensure_carrier_from_tag emits).
    let ret_name_ct = type_from_name(resolved_ret)
    let ret_rerouted = ret_name_ct == CT_VOID && is_compound_tag(resolved_ret) != 0
    let ret_type = if ret_rerouted { compound_tag_ct(resolved_ret) } else { ret_name_ct }
    let mut ret_c_str = c_type_str(ret_type)
    if ret_rerouted {
        let canon = canonical_struct_tag(resolved_ret)
        ensure_carrier_from_tag(canon)
        ret_c_str = c_type_from_tag(canon)
    } else if ret_type == CT_OPTION || ret_type == CT_RESULT {
        ret_c_str = mono_option_result_param_c_type(method_node, resolved_ret, tparams_sl, arg_tids)
    } else if is_struct_type(resolved_ret) != 0 || is_enum_type(resolved_ret) != 0 {
        ret_c_str = c_type_c_name(resolved_ret)
    }

    let params_sl = node_params(method_node)
    let mono_has_ev = fn_node_has_effects(method_node) != 0 && get_ffi_ann(method_node) == -1
    let mut params_c = "void"
    if params_sl != -1 && sublist_length(params_sl) > 0 {
        params_c = ""
        let recv_ct = type_from_name(node_name(im))
        let mut i = 0
        while i < sublist_length(params_sl) {
            let p = sublist_get(params_sl, i)
            let raw_pname = node_name(p)
            let pname = c_safe_name(raw_pname)
            if i > 0 {
                params_c = params_c.concat(", ")
            }
            if raw_pname == "self" || raw_pname == "_self" {
                // The receiver `self: List[T]` lowers to the builtin C type
                // (blink_list*), exactly as format_impl_params does for the
                // single-symbol path.
                params_c = params_c.concat("{c_type_str(recv_ct)} {pname}")
                i = i + 1
                continue
            }
            let ptype = resolve_tparam_via_tid(node_type_name(p), tparams_sl, arg_tids)
            if is_struct_type(ptype) != 0 {
                // A generic-struct INSTANCE param (`b: Box[T]`, T=Int) must spell
                // the mono name (blink_Box_Int); the bare head (blink_Box) is
                // never typedef'd. Mirrors mono_fn_signature's struct arm.
                let p_mono_name = mono_name_from_ann(ptype, node_type_ann(p), tparams_sl, segs)
                let p_c_type = if p_mono_name != "" { c_type_c_name(p_mono_name) } else { c_type_c_name(ptype) }
                params_c = params_c.concat("{p_c_type} {pname}")
            } else if is_enum_type(ptype) != 0 {
                // A generic-enum INSTANCE param (`t: Tree[T]`, T=Int) must spell
                // the mono name (blink_Tree_Int); the bare head (blink_Tree) is
                // never typedef'd. Mirrors mono_fn_signature's enum arm.
                let p_mono_name = mono_name_from_ann(ptype, node_type_ann(p), tparams_sl, segs)
                let p_c_type = if p_mono_name != "" { c_type_c_name(p_mono_name) } else { c_type_c_name(ptype) }
                params_c = params_c.concat("{p_c_type} {pname}")
            } else if is_compound_tag(ptype) != 0 {
                // A bare-binder param (`x: T`) bound to a COMPOUND element
                // resolves to the carrier tag (Option_int, ...), not "Option". Emit
                // its parameterized carrier directly, mirroring mono_fn_signature's
                // compound-param branch. c_type_from_tag names a Map tag as
                // blink_map*; ensure_carrier_from_tag emits the Option/Result typedef.
                let canon = canonical_struct_tag(ptype)
                ensure_carrier_from_tag(canon)
                params_c = params_c.concat("{c_type_from_tag(canon)} {pname}")
            } else if ptype == "Option" || ptype == "Result" {
                let p_c_type = mono_option_result_param_c_type(p, ptype, tparams_sl, arg_tids)
                params_c = params_c.concat("{p_c_type} {pname}")
            } else {
                let ct = type_from_name(ptype)
                params_c = params_c.concat("{c_type_str(ct)} {pname}")
            }
            i = i + 1
        }
    }
    if mono_has_ev {
        if params_c == "void" || params_c == "" {
            params_c = "blink_ev* __ev"
        } else {
            params_c = params_c.concat(", blink_ev* __ev")
        }
    }

    MonoSig {
        sig: "{storage}{ret_c_str} {c_fn_name(mangled)}({params_c})",
        storage: storage,
        ret_c_str: ret_c_str,
        params_c: params_c,
        mangled: mangled,
        ret_type: ret_type,
        resolved_ret: resolved_ret,
    }
}

fn emit_poly_impl_method_decl(im: Int, method_node: Int, concrete_args: Str, arg_tids: List[Int]) ! Codegen.Emit, Codegen.Register, Diag.Report {
    let sig = poly_impl_method_signature(im, method_node, concrete_args, arg_tids)
    emit_line("{sig.sig};")
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_poly_impl_method_def(im: Int, method_node: Int, concrete_args: Str, arg_tids: List[Int]) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let sig = poly_impl_method_signature(im, method_node, concrete_args, arg_tids)
    let storage = sig.storage
    let ret_c_str = sig.ret_c_str
    let params_c = sig.params_c
    let mangled = sig.mangled
    let ret_type = sig.ret_type
    let resolved_ret = sig.resolved_ret
    let tparams_sl = node_impl_binders(im)
    let params_sl = node_params(method_node)
    let segs = segs_from_arg_tids(arg_tids)

    emit_line("{sig.sig};")

    push_scope()
    cg_temp_counter = 0
    // The receiver's concrete element type (the impl binder's concrete arg),
    // used to register both `self` and any List[T] param.
    let recv_elem_name = if sublist_length(tparams_sl) > 0 { resolve_tparam_via_tid(node_name(sublist_get(tparams_sl, 0)), tparams_sl, arg_tids) } else { "" }
    if params_sl != -1 {
        let mut i = 0
        while i < sublist_length(params_sl) {
            let p = sublist_get(params_sl, i)
            let pname = node_name(p)
            if pname == "self" || pname == "_self" {
                // `self: List[T]` — register as a List with the resolved element
                // type so body method calls on self see the concrete element.
                set_var(pname, CT_LIST, 0)
                register_poly_list_elem(pname, recv_elem_name)
                i = i + 1
                continue
            }
            let ptype = resolve_tparam_via_tid(node_type_name(p), tparams_sl, arg_tids)
            if ptype == "Fn" {
                set_var(pname, CT_CLOSURE, 1)
                let ta = node_type_ann(p)
                if ta != -1 {
                    let sig_str = build_closure_sig_resolved_mono(ta, tparams_sl, arg_tids)
                    set_var_closure(pname, sig_str, tc_tid_subst_mono(tc_lookup_node_tid(p), tparams_sl, arg_tids))
                }
            } else if ptype == "List" {
                // The `self: List[T]` receiver (and any other List[T] param):
                // register the resolved element type so body method calls on it
                // see the concrete element, not a bare tparam.
                set_var(pname, CT_LIST, 1)
                let ta = node_type_ann(p)
                if ta != -1 {
                    let elems_sl = node_elements(ta)
                    if elems_sl != -1 && sublist_length(elems_sl) > 0 {
                        let elem_name = resolve_tparam_via_tid(node_name(sublist_get(elems_sl, 0)), tparams_sl, arg_tids)
                        register_poly_list_elem(pname, elem_name)
                    }
                }
            } else if type_from_name(ptype) == CT_VOID && is_compound_tag(ptype) != 0 && is_struct_type(ptype) == 0 && is_enum_type(ptype) == 0 {
                // Poly-impl twin of the emit_mono_fn_def arm above -- a non-self
                // bare-binder param (`x: T`) bound to a whole Option/Result
                // resolves to the carrier tag, reaching the same outcome as
                // poly_impl_method_signature's own compound-param arm so the
                // local's scope CT agrees with the signature's C type by
                // construction — though that arm excludes struct/enum by ARM
                // ORDERING, not by an explicit clause the way this one does.
                // The `type_from_name(...) == CT_VOID` guard (absent from that
                // arm, a pre-existing gap shared with it) keeps a type ALIAS
                // literally spelled like a carrier tag (`type Result_x = Int`)
                // on its normal scalar/struct path instead of being misrouted
                // into the carrier decoder.
                //
                // Canonicalize BEFORE handing off, unlike the mono call site
                // below: the two signature builders disagree with each other on
                // this axis -- mono_fn_signature calls ensure_carrier_from_tag
                // on the RAW tag, but poly_impl_method_signature canonicalizes
                // first. register_var_compound_from_tag's own
                // `ensure_carrier_from_tag` call must receive the SAME string
                // its paired signature builder fed it, or the two can
                // independently split a Result tag's ok/err segment differently
                // (canonical_struct_tag's backward scan vs
                // ensure_carrier_from_tag's internal forward splitter are not
                // the same algorithm) and register a scope decode for a typedef
                // the signature never emitted.
                register_var_compound_from_tag(pname, canonical_struct_tag(ptype), 1)
            } else {
                let param_ct = if is_enum_type(ptype) != 0 { CT_INT } else { type_from_name(ptype) }
                set_var(pname, param_ct, 1)
                if is_struct_type(ptype) != 0 {
                    // Register the mono instance name (Box_Int), not the bare head,
                    // so field access on the param resolves; mirrors the flat side
                    // of emit_mono_fn_def's struct arm and the signature above.
                    let p_mono_name = mono_name_from_ann(ptype, node_type_ann(p), tparams_sl, segs)
                    let mono_struct_name = if p_mono_name != "" { p_mono_name } else { ptype }
                    set_var_struct(pname, mono_struct_name)
                    // Carry the tid, pre-substituted through the impl binders so it
                    // is already concrete (cg_fn_mono_* is not set until body emit).
                    // A concrete tid round-trips as identity at read time. Gate on
                    // the reader's mono round-trip; enums keep the flat channel.
                    let raw_ptid = tc_lookup_node_tid(node_type_ann(p))
                    let mono_ptid = tc_tid_subst_mono(tc_tid_resolved(raw_ptid), tparams_sl, arg_tids)
                    if mono_ptid >= 0 && tc_tid_is_enum(mono_ptid) == 0 && tc_tid_struct_mono_name(mono_ptid) == mono_struct_name {
                        set_var_ty(pname, mono_ptid)
                    }
                }
                if is_enum_type(ptype) != 0 {
                    // Bind the bare base in var_enums (for variant tag/field
                    // lookup) plus the mono stem via set_var_struct (concrete C
                    // type for the scrutinee temp). Mirrors emit_mono_fn_def.
                    var_enums.push(VarEnumEntry { name: pname, enum_type: ptype })
                    let p_mono_name = mono_name_from_ann(ptype, node_type_ann(p), tparams_sl, segs)
                    if p_mono_name != "" {
                        set_var_struct(pname, p_mono_name)
                    }
                }
                if ptype == "Option" {
                    let ta = node_type_ann(p)
                    if ta != -1 {
                        let elems_sl = node_elements(ta)
                        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
                            let inner_ann = sublist_get(elems_sl, 0)
                            let inner_name = resolve_tparam_via_tid(node_name(inner_ann), tparams_sl, arg_tids)
                            let inner_ct = type_from_name(inner_name)
                            if is_struct_type(inner_name) != 0 || is_enum_type(inner_name) != 0 {
                                set_var_option_struct(pname, CT_INT, inner_name)
                            } else if inner_name == "Set" {
                                // See the twin block in emit_fn_def -- the Set's own
                                // element rides the option's inner2 slot, not
                                // is_compound_ct (CT_SET is deliberately excluded there).
                                set_var_option(pname, inner_ct)
                                let set_elems_sl = node_elements(inner_ann)
                                if set_elems_sl != -1 && sublist_length(set_elems_sl) > 0 {
                                    let set_elem_ann = sublist_get(set_elems_sl, 0)
                                    let set_elem_name = resolve_tparam_via_tid(node_name(set_elem_ann), tparams_sl, arg_tids)
                                    let set_elem_ct = type_from_name(set_elem_name)
                                    if set_elem_ct >= 0 && set_elem_ct != CT_VOID {
                                        set_var_option_inner2(pname, set_elem_ct)
                                    } else {
                                        recover_option_set_elem_from_tid(inner_ann, pname)
                                    }
                                }
                            } else {
                                set_var_option(pname, inner_ct)
                            }
                        }
                    }
                }
                if ptype == "Result" {
                    let ta = node_type_ann(p)
                    if ta != -1 {
                        let elems_sl = node_elements(ta)
                        if elems_sl != -1 && sublist_length(elems_sl) >= 2 {
                            let ok_name = resolve_tparam_via_tid(node_name(sublist_get(elems_sl, 0)), tparams_sl, arg_tids)
                            let err_name = resolve_tparam_via_tid(node_name(sublist_get(elems_sl, 1)), tparams_sl, arg_tids)
                            let ok_ct = type_from_name(ok_name)
                            let err_ct = type_from_name(err_name)
                            let ok_s = if is_struct_type(ok_name) != 0 || is_enum_type(ok_name) != 0 { ok_name } else { "" }
                            let err_s = if is_struct_type(err_name) != 0 || is_enum_type(err_name) != 0 { err_name } else { "" }
                            if ok_s != "" || err_s != "" {
                                set_var_result_struct(pname, ok_ct, err_ct, ok_s, err_s)
                            } else {
                                set_var_result(pname, ok_ct, err_ct)
                            }
                        }
                    }
                }
            }
            i = i + 1
        }
    }
    params_measure(params_sl, tparams_sl, arg_tids)

    let saved_trace_fn = cg_trace_fn_qualified
    let saved_trace_mod = cg_trace_module
    let saved_in_traced = cg_in_traced_fn
    cg_in_traced_fn = 0
    let saved_fn_name = cg_current_fn_name
    let saved_fn_has_ev = cg_current_fn_has_ev
    let saved_fn_ret = cg_current_fn_ret
    let saved_fn_option_inner = cg_current_fn_option_inner
    let saved_fn_node = cg_current_fn_node
    cg_current_fn_name = mangled
    cg_current_fn_has_ev = if fn_node_has_effects(method_node) != 0 { 1 } else { 0 }
    cg_current_fn_ret = ret_type
    cg_current_fn_node = method_node
    emit_line("{storage}{ret_c_str} {c_fn_name(mangled)}({params_c}) \{")
    cg_indent = cg_indent + 1

    emit_unused_param_voids(params_sl)

    let trace_mod = node_source_module(method_node)
    let trace_file = diag_file_for_node(method_node)
    emit_trace_enter(method_node, mangled, trace_mod, trace_file)

    let mut body_ret = ret_type
    if ret_needs_struct_body(resolved_ret) != 0 {
        body_ret = CT_INT
    }
    let saved_mono_tparams = cg_mono_tparams_sl
    let saved_mono_arg_tids = cg_mono_arg_tids
    let saved_fn_mono_tparams = cg_fn_mono_tparams_sl
    let saved_fn_mono_arg_tids = cg_fn_mono_arg_tids
    cg_mono_tparams_sl = tparams_sl
    cg_mono_arg_tids = arg_tids
    cg_fn_mono_tparams_sl = tparams_sl
    cg_fn_mono_arg_tids = arg_tids
    emit_fn_body(node_body(method_node), body_ret)
    cg_mono_tparams_sl = saved_mono_tparams
    cg_mono_arg_tids = saved_mono_arg_tids
    cg_fn_mono_tparams_sl = saved_fn_mono_tparams
    cg_fn_mono_arg_tids = saved_fn_mono_arg_tids
    if ret_type == CT_VOID && body_ret == CT_VOID {
        emit_trace_exit_void()
    }
    cg_indent = cg_indent - 1
    emit_line("}")
    emit_line("")
    cg_current_fn_name = saved_fn_name
    cg_current_fn_has_ev = saved_fn_has_ev
    cg_current_fn_ret = saved_fn_ret
    cg_current_fn_option_inner = saved_fn_option_inner
    cg_current_fn_node = saved_fn_node
    cg_trace_fn_qualified = saved_trace_fn
    cg_trace_module = saved_trace_mod
    cg_in_traced_fn = saved_in_traced
    pop_scope()
}

// Emit one mono_fns entry, routing poly-impl bases (registered in
// poly_impl_method_node) to the poly emitter and everything else to the
// generic-fn emitter. A poly base has no generic-fn node, so it MUST branch
// here or get_generic_fn_node would return -1 and silently drop the body.
fn emit_mono_fn_entry_def(base: Str, args: Str, arg_tids: List[Int]) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    if is_poly_impl_base(base) != 0 {
        let im = poly_impl_block_node.get(base).unwrap()
        let method_node = poly_impl_method_node.get(base).unwrap()
        emit_poly_impl_method_def(im, method_node, args, arg_tids)
        return
    }
    let fn_node = get_generic_fn_node(base)
    if fn_node != -1 {
        emit_mono_fn_def(fn_node, args, arg_tids)
    }
}

pub fn emit_all_mono_fns() ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    let mut i = 0
    while i < mono_fns.len() {
        let mf = mono_fns.get(i).unwrap()
        emit_mono_fn_entry_def(mf.base, mf.args, mf.arg_tids)
        i = i + 1
    }
}

pub fn emit_mono_typedefs_from(start: Int) ! Codegen.Emit, Diag.Report, Codegen.Register {
    let mut i = start
    while i < mono_instances.len() {
        let mi = mono_instances.get(i).unwrap()
        let td = find_type_def(mi.base)
        if td != -1 {
            let flds_sl = node_fields(td)
            if flds_sl != -1 && sublist_length(flds_sl) > 0 {
                if node_kind(sublist_get(flds_sl, 0)) != NodeKind.TypeVariant {
                    emit_mono_struct_typedef(mi.base, mi.args, mi.arg_tids, mi.ann)
                } else {
                    emit_mono_enum_typedef(mi.base, mi.args, mi.arg_tids, mi.ann)
                }
            }
        }
        i = i + 1
    }
}

// Per-index snapshot of the arg_tids each mono_fns entry's BODY was emitted
// with, taken by emit_mono_fns_from. A later registration can land strictly between one
// entry's body-emission and its own decl-emission and upgrade (merge_arg_tids) the stored
// mono_fns[i].arg_tids in place — reading that LIVE value at decl time could then disagree
// with what the def actually used, producing a `cc: conflicting types` error.
// Indexed by absolute mono_fns position (offset by mono_fn_body_tids_start) rather than
// returned from emit_mono_fns_from, since this stays a global, append-only list.
let mut mono_fn_body_tids: List[List[Int]] = []
let mut mono_fn_body_tids_start: Int = 0

fn copy_int_list(xs: List[Int]) -> List[Int] {
    let mut out: List[Int] = []
    let mut i = 0
    while i < xs.len() {
        out.push(xs.get(i).unwrap())
        i = i + 1
    }
    out
}

// The decl pass's authoritative arg_tids for mono_fns[i] — the BODY-TIME snapshot, not
// `live` (mono_fns[i].arg_tids read now). Sourcing the decl from the snapshot closes the
// drift class by construction; `live` is still compared here purely to MEASURE how often
// the two would have disagreed had the decl kept reading the live value.
fn mono_fn_decl_tids(i: Int, base: Str, args: Str, live: List[Int]) -> List[Int] {
    let idx = i - mono_fn_body_tids_start
    if idx < 0 || idx >= mono_fn_body_tids.len() { return live }
    let snapshot = mono_fn_body_tids.get(idx).unwrap()
    if arg_tids_differ(snapshot, live) {
        mono_fn_decl_tid_drift = mono_fn_decl_tid_drift + 1
        if mono_csv_from_arg_tids(snapshot) != mono_csv_from_arg_tids(live) {
            mono_fn_decl_seg_drift = mono_fn_decl_seg_drift + 1
            dbg_trace("monodedup", "decl-drift-VIOLATION base={base} args={args} snapshot={mono_csv_from_arg_tids(snapshot)} live={mono_csv_from_arg_tids(live)}")
        }
    }
    snapshot
}

pub fn emit_mono_fns_from(start: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    mono_fn_body_tids.clear()
    mono_fn_body_tids_start = start
    let mut i = start
    while i < mono_fns.len() {
        let mf = mono_fns.get(i).unwrap()
        mono_fn_body_tids.push(copy_int_list(mf.arg_tids))
        emit_mono_fn_entry_def(mf.base, mf.args, mf.arg_tids)
        i = i + 1
    }
}

pub fn emit_mono_fn_decls_range(start: Int, end: Int) ! Codegen.Emit, Codegen.Register, Diag.Report {
    let mut i = start
    while i < end {
        let mf = mono_fns.get(i).unwrap()
        let decl_tids = mono_fn_decl_tids(i, mf.base, mf.args, mf.arg_tids)
        // Poly-impl bases branch to the poly decl emitter; otherwise the
        // generic-fn path returns -1 for the missing fn node and the prototype
        // is dropped, leaving the body referencing an undeclared symbol.
        if is_poly_impl_base(mf.base) != 0 {
            let im = poly_impl_block_node.get(mf.base).unwrap()
            let method_node = poly_impl_method_node.get(mf.base).unwrap()
            emit_poly_impl_method_decl(im, method_node, mf.args, decl_tids)
        } else {
            let fn_node = get_generic_fn_node(mf.base)
            if fn_node != -1 {
                emit_mono_fn_decl(fn_node, mf.args, decl_tids)
            }
        }
        i = i + 1
    }
}

let mut struct_typedef_emitted: Map[Str, Int] = Map()
let mut ffi_includes_emitted: Map[Str, Int] = Map()

// Maps a Blink @ffi.struct type name to the system C struct name from `name: "..."`.
// Used to cast Ptr[T] args to `struct <c_name>*` when calling the system header symbol,
// since `blink_T` and `struct <c_name>` are layout-equivalent but distinct C types.
pub let mut ffi_struct_c_name: Map[Str, Str] = Map()

// Module-resolved C name for a struct/enum typedef. Resolves against the type
// node's OWN defining module (mangling_module) rather than the ambient
// cg_current_module, so the name is identical no matter which caller triggers
// the emit — the type-def emit loop (module set) or the early UE-vtable pass
// (module unset). Used for BOTH the dedup key AND the emitted guard/typedef/tag
// names, so a typedef's dedup identity, its `#ifndef` guard, and every self
// reference in its body stay mutually consistent regardless of caller context.
// Two modules' same-named types therefore key distinctly and both emit their
// typedef under their own module-prefixed symbol.
fn typedef_c_name(td_node: Int, name: Str) -> Str {
    let td_mod = mangling_module(td_node)
    let mod_ctx = if td_mod != "__main__" { td_mod } else { "" }
    c_type_c_name_in(name, mod_ctx)
}

pub fn emit_struct_typedef(td_node: Int) ! Codegen.Emit, Codegen.Register, Diag.Report {
    let name = node_name(td_node)
    // Resolve the C name against the TYPE'S OWN defining module (not the ambient
    // cg_current_module) and use it for the dedup key, the `#ifndef` guard, and
    // every self reference below. Two modules may each define a struct named
    // `Ngx` (legal per §03_types.md:1038); keying/emitting on the bare name
    // skipped the second module's typedef and mis-shaped its symbol → "has no
    // member". Deriving from the defining module makes emission
    // independent of the caller — the type-def loop (module set) and the early
    // UE-vtable pass (module unset) both produce the same, correct symbol.
    let td_cname = typedef_c_name(td_node, name)
    if struct_typedef_emitted.contains_key(td_cname) != 0 { return }
    struct_typedef_emitted.insert(td_cname, 1)
    // W0812 flags an @ffi header the user must pin in blink.toml. A stdlib @ffi
    // type rides a compiler-managed native dep (§07:415) the user never declares
    // (§07:833 scopes W0812 at user @ffi *outside* stdlib), so it is exempt.
    let ffi_hdr_is_stdlib = is_stdlib_source_module(node_source_module(td_node))
    // ConversionError's C typedef lives in runtime_core.h — skip emission to avoid duplication.
    if name == "ConversionError" { return }
    // ProcessResult's C typedef lives in runtime_process.h — skip emission to avoid duplication.
    if name == "ProcessResult" { return }
    // An @ffi.opaque handle emits only the system header that declares its
    // pointee. The type itself lowers to `<c_name>*` at every seam (see
    // c_type_c_name_in), so there is no struct body and — because the pointee is
    // incomplete by design — no sizeof/offsetof _Static_assert. This is the
    // deliberate contrast with @ffi.struct, which does emit a body and asserts.
    let opaque_ann = get_annotation(td_node, "ffi.opaque")
    if opaque_ann != -1 {
        let opaque_header = get_str_named_arg(opaque_ann, "header")
        if opaque_header != "" && ffi_includes_emitted.contains_key(opaque_header) == 0 {
            ffi_includes_emitted.insert(opaque_header, 1)
            emit_line("#include <{opaque_header}>")
            if manifest_name != "" && manifest_header_is_declared(opaque_header) == 0 && !ffi_hdr_is_stdlib {
                diag_warn_at(
                    "MissingCanonicalHeader",
                    MISSING_CANONICAL_HEADER,
                    "@ffi.opaque '{name}' declares header '{opaque_header}' but no [native-dependencies] entry in blink.toml lists it",
                    td_node,
                    "add the header to blink.toml: [native-dependencies] <dep>.headers = [\"{opaque_header}\"]"
                )
            }
        }
        return
    }
    let flds_sl = node_fields(td_node)
    if flds_sl == -1 {
        return
    }
    let ffi_ann = get_annotation(td_node, "ffi.struct")
    if ffi_ann != -1 {
        let header = get_str_named_arg(ffi_ann, "header")
        if header != "" && ffi_includes_emitted.contains_key(header) == 0 {
            ffi_includes_emitted.insert(header, 1)
            emit_line("#include <{header}>")
            emit_line("#include <stddef.h>")
            if manifest_name != "" && manifest_header_is_declared(header) == 0 && !ffi_hdr_is_stdlib {
                diag_warn_at(
                    "MissingCanonicalHeader",
                    MISSING_CANONICAL_HEADER,
                    "@ffi.struct '{name}' declares header '{header}' but no [native-dependencies] entry in blink.toml lists it",
                    td_node,
                    "add the header to blink.toml: [native-dependencies] <dep>.headers = [\"{header}\"]"
                )
            }
        }
    }
    // Check if this is a variant-only type (enum), skip for now
    if sublist_length(flds_sl) > 0 {
        let first = sublist_get(flds_sl, 0)
        if node_kind(first) == NodeKind.TypeVariant {
            return
        }
    }
    // Skip generic types — they get monomorphized instances instead. Field
    // defaults still register under the bare base name: the default value node
    // belongs to the type definition (T-independent), and emit_struct_lit's
    // defaults loop keys on the bare name. Without this a generic struct's
    // defaults never apply and the field is left zero-initialized.
    let tparams_sl = node_type_params(td_node)
    if tparams_sl != -1 && sublist_length(tparams_sl) > 0 {
        let mut gi = 0
        while gi < sublist_length(flds_sl) {
            let gf = sublist_get(flds_sl, gi)
            let gdef = node_condition(gf)
            if gdef != -1 {
                struct_field_defaults.push(StructFieldDefault { struct_name: name, field_name: node_name(gf), default_node: gdef })
            }
            gi = gi + 1
        }
        return
    }
    emit_td_guard_open(td_cname)
    emit_line("typedef struct \{")
    cg_indent = cg_indent + 1
    let mut i = 0
    while i < sublist_length(flds_sl) {
        let f = sublist_get(flds_sl, i)
        let fname = node_name(f)
        let type_ann_orig = node_value(f)
        if type_ann_orig != -1 {
            let field_tid = tc_tid_resolved(tc_lookup_node_tid(type_ann_orig))
            let type_ann_node = resolve_alias_ann(type_ann_orig)
            let type_name = node_name(type_ann_node)
            if type_name == "Fn" {
                emit_line("blink_closure* {fname};")
                reg_sf_entry(name, fname, CT_CLOSURE, "", sv_tp(CT_CLOSURE, -1, -1, ""), field_tid)
                let sig = build_closure_sig_from_type_ann(type_ann_node)
                sf_closure_sigs.push(StructFieldClosureSig { struct_name: name, field_name: fname, sig: sig })
            } else if type_name == name {
                emit_line("int64_t {fname};")
                reg_sf_entry(name, fname, CT_INT, "", sv_tp(CT_INT, -1, -1, ""), field_tid)
            } else if is_struct_type(type_name) != 0 {
                // A generic-struct INSTANCE field (`b: Box[Int]`) must spell the
                // mono stem (Box_0Int), not the bare base: the base names a C type
                // that is never typedef'd. A field annotation carries no node tid,
                // so recover+register the instance from the annotation (idempotent;
                // preflush_field_carrier_typedefs registers the same node earlier so
                // the instance typedef precedes this one).
                let inst_stem = register_carrier_inner_mono_instance(type_name, type_ann_node)
                let field_sname = if inst_stem != "" { inst_stem } else { type_name }
                emit_line("{c_type_c_name(field_sname)} {fname};")
                reg_sf_entry(name, fname, CT_VOID, field_sname, sv_tp(CT_VOID, -1, -1, field_sname), field_tid)
            } else if is_enum_type(type_name) != 0 {
                if is_transparent_newtype(type_name) != 0 {
                    // A transparent newtype (Errno) is a bare int64_t at every
                    // seam. Boxing it in the field decl while construct/read stay
                    // flat silently loses the value and emits invalid C on read-back.
                    emit_line("int64_t {fname};")
                    reg_sf_entry(name, fname, CT_INT, "", sv_tp(CT_INT, -1, -1, ""), field_tid)
                } else {
                    // A generic-enum INSTANCE field (`m: Maybe[Int]`) spells the mono
                    // stem, not the bare base — same recovery as the struct arm above.
                    let enum_stem = register_carrier_inner_mono_instance(type_name, type_ann_node)
                    let field_ename = if enum_stem != "" { enum_stem } else { type_name }
                    if is_data_enum(type_name) != 0 {
                        emit_line("{c_type_c_name(field_ename)} {fname};")
                    } else {
                        emit_line("int64_t {fname};")
                    }
                    reg_sf_entry(name, fname, CT_VOID, field_ename, sv_tp(CT_VOID, -1, -1, field_ename), field_tid)
                }
            } else if type_name == "Tuple" {
                let tup_opt = resolve_tuple_ann(type_ann_node, -1, [])
                if tup_opt.is_some() {
                    let tup_tag = tup_opt.unwrap()
                    emit_line("{c_type_c_name(tup_tag)} {fname};")
                    reg_sf_entry(name, fname, CT_VOID, tup_tag, sv_tp(CT_VOID, -1, -1, tup_tag), field_tid)
                } else {
                    let ct = type_from_name(type_name)
                    emit_line("{c_field_type_str(ct, type_name)} {fname};")
                    reg_sf_entry(name, fname, ct, "", tp_from_ann(type_ann_node), field_tid)
                }
            } else {
                let ct = type_from_name(type_name)
                let field_tp = tp_from_ann(type_ann_node)
                if ct == CT_OPTION || ct == CT_RESULT {
                    ensure_compound_type_from_ann(type_ann_node)
                    emit_line("{c_type_c_name(compound_name_from_ann(type_ann_node))} {fname};")
                } else {
                    emit_line("{c_field_type_str(ct, type_name)} {fname};")
                }
                reg_sf_entry(name, fname, ct, "", field_tp, field_tid)
            }
        } else {
            emit_line("int64_t {fname};")
            reg_sf_entry(name, fname, CT_INT, "", sv_tp(CT_INT, -1, -1, ""), -1)
        }
        let default_node = node_condition(f)
        if default_node != -1 {
            struct_field_defaults.push(StructFieldDefault { struct_name: name, field_name: fname, default_node: default_node })
        }
        i = i + 1
    }
    cg_indent = cg_indent - 1
    emit_line("} {td_cname};")
    emit_td_guard_close()
    emit_line("")
    if ffi_ann != -1 {
        let c_struct_name = get_str_named_arg(ffi_ann, "name")
        if c_struct_name != "" {
            ffi_struct_c_name.insert(name, c_struct_name)
            let blink_t = td_cname
            emit_line("_Static_assert(sizeof({blink_t}) == sizeof(struct {c_struct_name}), \"{blink_t} size mismatch with C struct {c_struct_name}\");")
            let mut fi = 0
            while fi < sublist_length(flds_sl) {
                let f = sublist_get(flds_sl, fi)
                let fname = node_name(f)
                emit_line("_Static_assert(offsetof({blink_t}, {fname}) == offsetof(struct {c_struct_name}, {fname}), \"{blink_t}.{fname} offset mismatch with C struct {c_struct_name}\");")
                fi = fi + 1
            }
            emit_line("")
        }
    }
    let inv_anns_sl = node_handlers(td_node)
    if inv_anns_sl != -1 {
        let mut ai = 0
        while ai < sublist_length(inv_anns_sl) {
            let ann = sublist_get(inv_anns_sl, ai)
            let ann_name = node_name(ann)
            if ann_name == "invariant" {
                let args_sl = node_args(ann)
                if args_sl != -1 && sublist_length(args_sl) > 0 {
                    let expr_node = sublist_get(args_sl, 0)
                    struct_invariants.push(StructInvariant { struct_name: name, expr_node: expr_node })
                }
            }
            ai = ai + 1
        }
    }
}

fn build_type_name_from_ann(ann: Int) -> Str {
    let name = node_name(ann)
    let elems = node_elements(ann)
    if elems == -1 || sublist_length(elems) == 0 {
        return name
    }
    let mut params = ""
    let mut i = 0
    while i < sublist_length(elems) {
        if i > 0 {
            params = params.concat(", ")
        }
        let inner = sublist_get(elems, i)
        params = params.concat(build_type_name_from_ann(inner))
        i = i + 1
    }
    "{name}[{params}]"
}

let mut enum_typedef_emitted: Map[Str, Int] = Map()

pub fn reset_typedef_emitted_stmt() {
    struct_typedef_emitted = Map()
    enum_typedef_emitted = Map()
    ffi_includes_emitted = Map()
}

pub fn emit_enum_typedef(td_node: Int) ! Codegen.Emit {
    let name = node_name(td_node)
    // Same module-resolved C name as emit_struct_typedef, used for the dedup
    // key, guard, and every self reference below, so two modules' same-named
    // enums each emit their own typedef consistently regardless of the caller's
    // ambient module.
    let td_cname = typedef_c_name(td_node, name)
    if enum_typedef_emitted.contains_key(td_cname) != 0 { return }
    enum_typedef_emitted.insert(td_cname, 1)
    let flds_sl = node_fields(td_node)
    if flds_sl == -1 {
        return
    }
    let enum_idx = enum_regs.len()

    let mut has_data = 0
    let mut str_backed_count = 0
    let mut variant_count = 0
    let mut i = 0
    while i < sublist_length(flds_sl) {
        let v = sublist_get(flds_sl, i)
        let vflds = node_fields(v)
        if vflds != -1 && sublist_length(vflds) > 0 {
            has_data = 1
        }
        let vstr = node_str_val(v)
        if vstr != "" {
            str_backed_count = str_backed_count + 1
        }
        variant_count = variant_count + 1
        i = i + 1
    }
    let is_sb = if str_backed_count > 0 && str_backed_count == variant_count { 1 } else { 0 }
    enum_regs.push(EnumReg { name: name, has_data: has_data, is_str_backed: is_sb })
    enum_reg_set.insert(name, has_data)
    if is_sb != 0 {
        enum_str_backed_set.insert(name, 1)
    }

    i = 0
    while i < sublist_length(flds_sl) {
        let v = sublist_get(flds_sl, i)
        let vname = node_name(v)
        let vflds = node_fields(v)
        let ev_str = node_str_val(v)
        if vflds != -1 && sublist_length(vflds) > 0 {
            let mut field_names = ""
            let mut field_types = ""
            let mut fi = 0
            while fi < sublist_length(vflds) {
                let vf = sublist_get(vflds, fi)
                let vf_name = node_name(vf)
                let vf_type_ann = node_value(vf)
                let mut vf_type_name = "Int"
                if vf_type_ann != -1 {
                    vf_type_name = build_type_name_from_ann(vf_type_ann)
                }
                if fi > 0 {
                    field_names = field_names.concat(",")
                    field_types = field_types.concat(",")
                }
                field_names = field_names.concat(vf_name)
                field_types = field_types.concat(vf_type_name)
                fi = fi + 1
            }
            enum_variants.push(EnumVariant { name: vname, enum_idx: enum_idx, field_names: field_names, field_types: field_types, field_count: sublist_length(vflds), str_value: ev_str, tag: i })
        } else {
            enum_variants.push(EnumVariant { name: vname, enum_idx: enum_idx, field_names: "", field_types: "", field_count: 0, str_value: ev_str, tag: i })
        }
        let gidx = enum_variants.len() - 1
        if !enum_variant_name_idx.contains_key(vname) {
            enum_variant_name_idx.insert(vname, name)
        }
        enum_variant_full_idx.insert(name.concat("|").concat(vname), gidx)
        i = i + 1
    }

    // Generic enum (`type Tree[T] {…}`): the variant metadata above is populated on
    // the BARE name (`Tree`) so ctor/match lookups keep working, but the erased base
    // typedef is skipped — per-instance mono typedefs (`blink_Tree_Int`) are emitted
    // by emit_mono_enum_typedef instead, mirroring emit_struct_typedef's skip.
    let tparams_sl = node_type_params(td_node)
    if tparams_sl != -1 && sublist_length(tparams_sl) > 0 {
        return
    }

    if has_data == 0 {
        let mut variants_str = ""
        i = 0
        while i < sublist_length(flds_sl) {
            let v = sublist_get(flds_sl, i)
            let vname = node_name(v)
            if i > 0 {
                variants_str = variants_str.concat(", ")
            }
            variants_str = variants_str.concat("{td_cname}_{vname}")
            i = i + 1
        }
        emit_td_guard_open(td_cname)
        emit_line("typedef enum \{ {variants_str} } {td_cname};")
        emit_td_guard_close()
        emit_line("")
    } else {
        emit_td_guard_open(td_cname)
        emit_line("typedef struct \{")
        cg_indent = cg_indent + 1
        emit_line("int tag;")
        emit_line("union \{")
        cg_indent = cg_indent + 1
        i = 0
        while i < sublist_length(flds_sl) {
            let v = sublist_get(flds_sl, i)
            let vname = node_name(v)
            let vflds = node_fields(v)
            if vflds != -1 && sublist_length(vflds) > 0 {
                emit_line("struct \{")
                cg_indent = cg_indent + 1
                let mut fi = 0
                while fi < sublist_length(vflds) {
                    let vf = sublist_get(vflds, fi)
                    let vf_name = node_name(vf)
                    let vf_type_ann_orig = node_value(vf)
                    let mut vf_c_type = "int64_t"
                    if vf_type_ann_orig != -1 {
                        let vf_type_ann = resolve_alias_ann(vf_type_ann_orig)
                        let vf_type_name = node_name(vf_type_ann)
                        if vf_type_name == name {
                            vf_c_type = "int64_t"
                        } else if is_struct_type(vf_type_name) != 0 {
                            vf_c_type = "{c_type_c_name(vf_type_name)}"
                        } else if is_enum_type(vf_type_name) != 0 {
                            if is_data_enum(vf_type_name) != 0 {
                                vf_c_type = "{c_type_c_name(vf_type_name)}"
                            } else {
                                vf_c_type = "{c_type_c_name(vf_type_name)}"
                            }
                        } else if vf_type_name == "Tuple" {
                            if tc_variant_field_is_selfrec_tuple(name, vname, vf_name) != 0 {
                                // Self-recursive tuple field (`Pair(p: (Box, Box))`):
                                // boxed as a heap pointer, so the union member is a bare
                                // int64_t (mirrors emit_mono_enum_typedef and the direct
                                // self-recursive field above).
                                vf_c_type = "int64_t"
                            } else {
                                let tup_opt = resolve_tuple_ann(vf_type_ann, -1, [])
                                if tup_opt.is_some() {
                                    vf_c_type = c_type_c_name(tup_opt.unwrap())
                                } else {
                                    vf_c_type = c_field_type_str(type_from_name(vf_type_name), vf_type_name)
                                }
                            }
                        } else {
                            let vf_ct = type_from_name(vf_type_name)
                            if vf_ct == CT_OPTION || vf_ct == CT_RESULT {
                                ensure_compound_type_from_ann(vf_type_ann)
                                vf_c_type = c_type_c_name(compound_name_from_ann(vf_type_ann))
                            } else {
                                vf_c_type = c_field_type_str(vf_ct, vf_type_name)
                            }
                        }
                    }
                    emit_line("{vf_c_type} {vf_name};")
                    fi = fi + 1
                }
                cg_indent = cg_indent - 1
                emit_line("} {vname};")
            }
            i = i + 1
        }
        cg_indent = cg_indent - 1
        emit_line("} data;")
        cg_indent = cg_indent - 1
        emit_line("} {td_cname};")
        emit_td_guard_close()
        emit_line("")
        i = 0
        while i < sublist_length(flds_sl) {
            let v = sublist_get(flds_sl, i)
            let vname = node_name(v)
            emit_line("#ifndef {td_cname}_{vname}_TAG")
            emit_line("#define {td_cname}_{vname}_TAG {i}")
            emit_line("#endif")
            i = i + 1
        }
        emit_line("")
    }

    if is_sb != 0 {
        let cn = td_cname
        emit_line("const char* {c_fn_name("{name}_to_str")}({cn} self) \{")
        cg_indent = cg_indent + 1
        emit_line("switch (self) \{")
        cg_indent = cg_indent + 1
        i = 0
        while i < enum_variants.len() {
            let evar = enum_variants.get(i).unwrap()
            if evar.enum_idx == enum_idx {
                emit_line("case {cn}_{evar.name}: return \"{evar.str_value}\";")
            }
            i = i + 1
        }
        emit_line("default: return \"\";")
        cg_indent = cg_indent - 1
        emit_line("}")
        cg_indent = cg_indent - 1
        emit_line("}")
        emit_line("")

        emit_struct_option_typedef(name)
        let cs_tag = canonical_struct_tag(name)
        emit_line("blink_Option_{cs_tag} {c_fn_name("{name}_from_str")}(const char* s) \{")
        cg_indent = cg_indent + 1
        emit_line("blink_Option_{cs_tag} _r;")
        let mut first = 1
        i = 0
        while i < enum_variants.len() {
            let evar = enum_variants.get(i).unwrap()
            if evar.enum_idx == enum_idx {
                if first == 1 {
                    emit_line("if (blink_str_eq(s, \"{evar.str_value}\")) \{")
                    first = 0
                } else {
                    emit_line("} else if (blink_str_eq(s, \"{evar.str_value}\")) \{")
                }
                cg_indent = cg_indent + 1
                if is_payloadless_enum(name) != 0 {
                    // Payload-less enum: the carrier holds the ordinal by value
                    // (emit_struct_option_typedef spells `{cn} value`), so store it
                    // inline — the box path would assign a pointer to a value member.
                    emit_line("_r.tag = 1; _r.value = {cn}_{evar.name};")
                } else {
                    let box_tmp = fresh_temp("_ebox_")
                    emit_line("{cn}* {box_tmp} = ({cn}*)blink_alloc(sizeof({cn})); *{box_tmp} = {cn}_{evar.name};")
                    emit_line("_r.tag = 1; _r.value = {box_tmp};")
                }
                cg_indent = cg_indent - 1
            }
            i = i + 1
        }
        emit_line("} else \{")
        cg_indent = cg_indent + 1
        emit_line("_r.tag = 0;")
        cg_indent = cg_indent - 1
        emit_line("}")
        emit_line("return _r;")
        cg_indent = cg_indent - 1
        emit_line("}")
        emit_line("")

        derive_method_entries.push(DeriveMethodEntry { type_name: name, method_name: "to_str", ret_type: CT_STRING })
        derive_method_entries.push(DeriveMethodEntry { type_name: name, method_name: "from_str", ret_type: CT_VOID })
    }
}

// ── Top-level: generate ─────────────────────────────────────────────

@allow(UnrestoredMutation, IncompleteStateRestore)
// The spelling of a module-level `let`, shared by the archive-header `extern` and the definition.
// These are two declarations of ONE C object emitted on different runs, so they must not be able to
// drift: a header that spells a global differently from its definition is a link-time type error.
//
// Two tid channels, in this order. The top-level walk records an ANNOTATED binding's tid in a
// module-keyed map and never touches the value node; it memoizes the value node only for a bare
// literal. Reading either alone reports the other's population as untyped.
fn top_level_let_tid(node: Int, name: Str) -> Int {
    let map_tid = tc_top_level_let_tid(node_module(node), name)
    if map_tid >= 0 { return map_tid }
    cg_node_mono_tid(node_value(node))
}

fn top_level_let_type_str(node: Int, name: Str, tuple_struct: Str, val_type: Int, cell: Str) -> Str {
    let flat = if tuple_struct != "" { c_type_c_name(tuple_struct) } else { c_type_str(val_type) }
    let tid = top_level_let_tid(node, name)
    ctype_probe_at(tid, cell, name, flat, node)
    // A tuple-struct global keeps its own spelling for the same reason the match carrier does: two
    // struct types do not convert implicitly, so the tid's logical answer cannot be substituted.
    if tuple_struct != "" { return flat }
    let spelled = c_type_from_tid(tid)
    // A global is a STORAGE position, so a genuine Void keeps the flat placeholder.
    if spelled != "" && spelled != "void" { return spelled }
    flat
}

pub fn emit_top_level_let(node: Int, extern_only: Int) ! Codegen.Emit, Codegen.Register, Codegen.Scope, Diag.Report {
    if cg_archive_header_mode != 0 && skip_private_in_module_header(node) {
        return
    }
    let saved_lines = cg_lines
    cg_lines = []
    // Thread the binding's type annotation so constructors that key off it
    // (e.g. `Map()` choosing key-ops) see Map[K, V] instead of defaulting to
    // string key-ops — mirrors emit_let_binding for local bindings.
    let saved_let_target_ann = cg_let_target_ann
    cg_let_target_ann = node_target(node)
    emit_expr(node_value(node))
    cg_let_target_ann = saved_let_target_ann
    let val_str = expr_result_str
    let val_type = expr_result_type
    let helper_lines = cg_lines
    cg_lines = saved_lines
    let name = node_name(node)
    let is_mut = node_is_mut(node)
    let type_ann = node_target(node)
    // A tuple global's C type is a dynamically-generated struct, so c_type_str
    // (which maps CT_STRUCT to "void") would emit `void <name>;`. Resolve the
    // tuple annotation to its real C type name up front and use it for every
    // decl site (header extern, extern_only forward-decl, definition) so they
    // all agree — a mismatch breaks the monolith cc. resolve_tuple_ann also
    // registers/emits the typedef via ensure_tuple_type (idempotent). Mirrors
    // emit_let_binding's local path.
    let mut tuple_struct = ""
    if val_type == CT_STRUCT && type_ann != -1 && node_name(type_ann) == "Tuple" {
        // Eagerly emit this tuple's typedef BEFORE the var decl below — the
        // global-let loop runs after the main typedef pass, so the typedef
        // (registered by resolve_tuple_ann but emitted in the later catch-all
        // flush) would otherwise land after this decl references it. A tuple
        // element that is Option[T]/Result[T,E] embeds its carrier typedef BY
        // VALUE, so that carrier must precede the tuple typedef too. The carrier
        // is often registered before we get here (e.g. by emit_expr on the
        // value above), so a from-index snapshot would miss it — flush ALL
        // registered option/result carriers (from 0); every emit dedups via its
        // BLINK_TD_ guard, so this and the later catch-all flush are no-ops on
        // anything already emitted.
        let tup_opt = resolve_tuple_ann(type_ann, -1, [])
        if tup_opt.is_some() {
            tuple_struct = tup_opt.unwrap()
            emit_option_result_types_from(0, 0, 0, 0)
            emit_tuple_typedef_for_tag(tuple_struct)
        }
    }
    // A generic struct/enum global has the same ordering problem the tuple arm above solves:
    // top_level_let_type_str spells the decl from the tid, so it can name a mono typedef that
    // the later pass has not emitted yet. Register from the same tid that speller reads, then
    // flush; every emit dedups via its BLINK_TD_ guard.
    let inst_tid = top_level_let_tid(node, name)
    if inst_tid >= 0 && tuple_struct == "" {
        if register_struct_instance_from_tid(inst_tid) != "" {
            emit_mono_typedefs_from(0)
        } else if register_enum_instance_from_tid(inst_tid) != "" {
            emit_mono_typedefs_from(0)
        }
    }
    // Header mode: emit decl-only and bail before any of the var/type
    // tracking side effects below — those are body-emission state, not
    // header concerns.
    if cg_archive_header_mode != 0 {
        let ts_h = top_level_let_type_str(node, name, tuple_struct, val_type, "top_level_let_header")
        let cname_h = c_safe_name(name)
        let needs_init_h = helper_lines.len() > 0 || val_type == CT_LIST || val_type == CT_MAP || val_type == CT_SET || val_type == CT_CHANNEL
        let const_q_h = if is_mut == 0 && !needs_init_h && val_type != CT_STRING { "const " } else { "" }
        emit_line("extern {const_q_h}{ts_h} {cname_h};")
        return
    }
    set_var(name, val_type, is_mut)
    // Stamp the binding's type id, mirroring emit_let_binding's local-path stamp
    // (set_var_ty at the earliest point). A top-level map global was created here
    // with ty=-1, so its value/key type could only be answered from the flat
    // channels; carry the tid so the tid-sole-authority readers see it too.
    if val_type == CT_MAP && inst_tid >= 0 {
        set_var_ty(name, inst_tid)
    }
    reg_module_global(name)
    if tuple_struct != "" {
        set_var_struct(name, tuple_struct)
        // Carry the binding's tid so sv_struct_tid_first recovers the tuple carrier
        // from the tid, not the flat sname. Gate on the reader's exact round-trip so
        // a mismatched tid keeps the flat spelling instead of borrowing a wrong tag.
        if inst_tid >= 0 && find_tuple_entry(tuple_struct) >= 0 && tc_tid_tuple_sname(cg_bind_mono_tid(inst_tid)) == tuple_struct {
            set_var_ty(name, inst_tid)
        }
    } else if inst_tid >= 0 {
        // Without this a struct or enum global carries its CT with no name, so every field
        // read on it resolves to nothing and falls back to the `<value>` placeholder — the
        // local path registers it, which is why the same annotation works as a local. Read
        // from the tid the decl was spelled from, so the two cannot disagree.
        let g_stem = tc_tid_struct_mono_name(inst_tid)
        let g_name = if g_stem != "" { g_stem } else { tc_tid_struct(inst_tid) }
        if g_name != "" {
            set_var_struct(name, g_name)
            // Carry the binding's tid for the mono struct-instance case, gated on
            // the reader's exact mono round-trip so a mismatch keeps the flat
            // spelling. Enums stay on the flat channel (own increment).
            let g_bound = cg_bind_mono_tid(inst_tid)
            if tc_tid_is_enum(g_bound) == 0 && tc_tid_struct_mono_name(g_bound) == g_name {
                set_var_ty(name, inst_tid)
            }
        }
    }
    // Track list element type from annotation
    if val_type == CT_LIST && type_ann != -1 {
        let ann_name = node_name(type_ann)
        if ann_name == "List" {
            let elems_sl = node_elements(type_ann)
            if elems_sl != -1 && sublist_length(elems_sl) > 0 {
                let elem_ann = sublist_get(elems_sl, 0)
                let elem_name = node_name(elem_ann)
                let elem_ct = type_from_name(elem_name)
                set_list_elem_type(name, elem_ct)
                if elem_ct == CT_VOID && (is_named_type(elem_name) != 0) {
                    // A generic element (`List[Tree[Int]]`) must carry its mono stem
                    // (Tree_Int), not the bare head (Tree): the bare head is never
                    // typedef'd on its own (only mono instances of a generic type
                    // are), so a bare-head spelling here names an unemitted C type.
                    // Mirrors the declared-struct-annotation branch
                    // above for the LET variable's own type.
                    let elem_mono = mono_name_from_ann(strip_module_qualifier(elem_name), elem_ann, -1, [])
                    let _reg = register_carrier_inner_mono_instance(elem_name, elem_ann)
                    set_list_elem_struct(name, if elem_mono != "" { elem_mono } else { elem_name })
                } else if elem_ct == CT_VOID && elem_name == "Tuple" {
                    let tup_opt = resolve_tuple_ann(elem_ann, -1, [])
                    if tup_opt.is_some() {
                        set_list_elem_struct(name, tup_opt.unwrap())
                    }
                }
                if elem_ct == CT_LIST {
                    let nested_sl = node_elements(elem_ann)
                    if nested_sl != -1 && sublist_length(nested_sl) > 0 {
                        let nested_ann = sublist_get(nested_sl, 0)
                        let nested_name = node_name(nested_ann)
                        let nested_ct = type_from_name(nested_name)
                        set_list_nested_elem_type(name, nested_ct)
                    }
                }
                if elem_ct == CT_SET {
                    let nested_sl = node_elements(elem_ann)
                    if nested_sl != -1 && sublist_length(nested_sl) > 0 {
                        let nested_ann = sublist_get(nested_sl, 0)
                        let nested_name = node_name(nested_ann)
                        let nested_ct = type_from_name(nested_name)
                        set_list_nested_elem_type(name, nested_ct)
                    }
                }
                if elem_ct == CT_MAP {
                    set_list_elem_map_ann(name, elem_ann)
                }
                let _ = set_list_elem_compound_ann(name, elem_ann, elem_ct)
            }
        }
    }
    if val_type == CT_MAP && type_ann != -1 {
        let ann_name = node_name(type_ann)
        if ann_name == "Map" {
            let elems_sl = node_elements(type_ann)
            if elems_sl != -1 && sublist_length(elems_sl) >= 2 {
                let key_ann = sublist_get(elems_sl, 0)
                let val_ann = sublist_get(elems_sl, 1)
                let key_name = resolve_tparam_via_tid(node_name(key_ann), cg_mono_tparams_sl, cg_mono_arg_tids)
                let val_name = resolve_tparam_via_tid(node_name(val_ann), cg_mono_tparams_sl, cg_mono_arg_tids)
                let key_ct = type_from_name(key_name)
                let val_ct = type_from_name(val_name)
                set_map_types(name, key_ct, val_ct, val_name)
                let key_struct = key_struct_sname_from_ann(key_ann, cg_mono_tparams_sl, segs_from_arg_tids(cg_mono_arg_tids))
                if key_struct != "" {
                    set_map_key_struct(name, key_struct)
                } else if key_ct == CT_VOID && is_named_type(key_name) != 0 {
                    set_map_key_struct(name, key_name)
                }
                propagate_map_list_elem(name, val_ct, val_ann)
            }
        }
    }
    if val_type == CT_SET && type_ann != -1 {
        let ann_name = node_name(type_ann)
        if ann_name == "Set" {
            let elems_sl = node_elements(type_ann)
            if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
                let elem_ann = sublist_get(elems_sl, 0)
                let elem_name = resolve_tparam_via_tid(node_name(elem_ann), cg_mono_tparams_sl, cg_mono_arg_tids)
                let elem_ct = type_from_name(elem_name)
                set_set_elem_type(name, elem_ct)
                let elem_struct = key_struct_sname_from_ann(elem_ann, cg_mono_tparams_sl, segs_from_arg_tids(cg_mono_arg_tids))
                if elem_struct != "" {
                    set_set_elem_struct(name, elem_struct)
                } else if elem_ct == CT_VOID && is_named_type(elem_name) != 0 {
                    set_set_elem_struct(name, elem_name)
                }
            }
        }
    } else if val_type == CT_SET {
        // No annotation: carry the RHS set's element type across. Prefer copying
        // from the source var (`let alias = some_set`); fall back to a freshly
        // set expr_list_elem_type (union results). Always clear the global so a
        // stale value from a prior expression can't leak into a later binding.
        let src_elem = get_set_elem_type(val_str)
        if src_elem >= 0 || get_set_elem_struct(val_str) != "" {
            set_set_elem_type(name, src_elem)
            let src_struct = get_set_elem_struct(val_str)
            if src_struct != "" {
                set_set_elem_struct(name, src_struct)
            }
        } else if expr_list_elem_type >= 0 {
            set_set_elem_type(name, expr_list_elem_type)
            if expr_list_elem_struct != "" {
                set_set_elem_struct(name, expr_list_elem_struct)
            }
        } else {
            // No annotation, no alias source, no adapter carry -- the
            // last resort is typecheck's own tid for the RHS (see the twin
            // comment on the local-let path).
            recover_set_elem_from_tid(node_value(node), name)
        }
        expr_list_elem_type = -1
        expr_list_elem_struct = ""
    }
    if val_type == CT_MAP && expr_map_key_type >= 0 {
        apply_map_binding_meta(name)
    }
    if val_type == CT_MAP {
        let val_orig_name = if node_kind(node_value(node)) == NodeKind.Ident { node_name(node_value(node)) } else { "" }
        carry_map_binding_meta(val_str, val_orig_name, name, type_ann)
    }
    if val_type == CT_LIST && expr_list_elem_type >= 0 && type_ann == -1 {
        set_list_elem_type(name, expr_list_elem_type)
        // A compound element (Option/Result/Map) recovered onto val_str by
        // recover_list_elem_from_tid (a field-access temp) carries its deep tp_id —
        // the flat set_list_elem_type above only stamps the shallow CT marker, so
        // without this the deep inner dies with val_str when `name` re-binds it.
        if expr_list_elem_type == CT_OPTION || expr_list_elem_type == CT_RESULT || expr_list_elem_type == CT_MAP {
            copy_list_compound_elem(val_str, name)
            // Same hole as emit_let_binding's ladder — see the full note there.
            stamp_list_elem_from_tid(node_value(node), name)
        }
        // Same one-gate-wider flip as emit_let_binding's ladder — see the full note there.
        let entry_elem_ct = expr_list_elem_type
        expr_list_elem_type = -1
        let src_struct = get_list_elem_struct(val_str)
        if src_struct != "" {
            set_list_elem_struct(name, src_struct)
        } else if expr_list_elem_struct != "" {
            set_list_elem_struct(name, expr_list_elem_struct)
        }
        expr_list_elem_struct = ""
        let src_nested = get_list_nested_elem_type(val_str)
        if src_nested != -1 {
            set_list_nested_elem_type(name, src_nested)
        }
        if entry_elem_ct == CT_SET || entry_elem_ct == CT_LIST {
            stamp_list_elem_from_tid(node_value(node), name)
        }
    } else if val_type == CT_LIST && expr_list_elem_type >= 0 {
        expr_list_elem_type = -1
        expr_list_elem_struct = ""
    }
    // The ladder above can leave the element UNSPELLABLE -- either absent, or a
    // CT_STRUCT/CT_ENUM/CT_VOID marker with no struct name to go with it, which is the shape an
    // unannotated `let` bound to a CALL returning `List[(A, B)]` produces: the RHS carries
    // expr_list_elem_type = CT_STRUCT (a tuple IS a struct here) but no sname, and val_str is a C
    // call expression, so neither get_list_elem_struct(val_str) nor expr_list_elem_struct can
    // supply one. The result is a list whose element is a nameless struct, i.e. Void.
    //
    // The last resort is typecheck's own tid for the RHS, exactly as the CT_SET branch above
    // already does for a set element. Guarded on the element being unspellable, so this
    // fires only where the code above left nothing usable; recover_list_elem_from_tid itself
    // declines when the tid has no nameable element either.
    if val_type == CT_LIST && type_ann == -1 && list_elem_unspellable(name) {
        recover_list_elem_from_tid(node_value(node), name)
        expr_list_elem_type = -1
        expr_list_elem_struct = ""
    }
    // A module-level `let` is a separate declaration chain from emit_let_binding's, so it gets its
    // own cell rather than riding the local one.
    let ts = top_level_let_type_str(node, name, tuple_struct, val_type, "top_level_let")
    let cname = c_safe_name(name)
    let needs_init = helper_lines.len() > 0 || val_type == CT_LIST || val_type == CT_MAP || val_type == CT_SET || val_type == CT_CHANNEL
    let is_const = is_mut == 0 && !needs_init && val_type != CT_STRING
    if extern_only != 0 {
        let const_q_e = if is_mut == 0 && !needs_init && val_type != CT_STRING { "const " } else { "" }
        emit_line("extern {const_q_e}{ts} {cname};")
        return
    }
    let storage = "BLINK_UNUSED ".concat(let_storage_class(node))
    let const_q = if is_const { "const " } else { "" }
    if needs_init {
        emit_line("{storage}{ts} {cname};")
        let mut hi = 0
        while hi < helper_lines.len() {
            cg_global_inits.push(helper_lines.get(hi).unwrap())
            hi = hi + 1
        }
        cg_global_inits.push("    ".concat(cname).concat(" = ").concat(val_str).concat(";"))
    } else if is_mut != 0 {
        emit_line(storage.concat(ts).concat(" ").concat(cname).concat(" = ").concat(val_str).concat(";"))
    } else {
        emit_line(storage.concat(const_q).concat(ts).concat(" ").concat(cname).concat(" = ").concat(val_str).concat(";"))
    }
}
