// ROLE-1 carrier-tag accessors: the struct-name halves that result_c_type_mixed expects,
// recovered from the authoritative tid and admitting scalar-erased nominals. The value-access
// readers (get_var_result_ok_struct / _err_struct) still decline those so an unwrapped value
// stays by-value; the roles diverge only for a transparent newtype / payloadless enum inner.
pub fn get_var_result_ok_tag(name: Str) -> Str {
    let t = get_sv_ty(name, CT_RESULT)
    if t >= 0 { sev_result_ok_tag(cg_bind_mono_tid(t)) } else { "" }
}

