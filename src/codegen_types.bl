    let mut i = 0
    while i < sf_closure_sigs.len() {
        let e = sf_closure_sigs.get(i).unwrap()
        if e.struct_name == struct_name && e.field_name == field_name {
            return e.sig
        }
        i = i + 1
    }
    ""
}

pub fn build_closure_sig_from_type_ann(ta: Int) -> Str {
    let ret_name = node_return_type(ta)
    let ret_type = type_from_name(ret_name)
    let elems_sl = node_elements(ta)
    let mut sig_params = "const blink_closure*"
    if elems_sl != -1 && sublist_length(elems_sl) > 0 {
        let mut i = 0
        while i < sublist_length(elems_sl) {
            let elem = sublist_get(elems_sl, i)
            let ename = node_name(elem)
            sig_params = sig_params.concat(", ")
            if is_enum_type(ename) != 0 {
                sig_params = sig_params.concat(c_type_c_name(ename))
            } else if is_struct_type(ename) != 0 {
                sig_params = sig_params.concat(c_type_c_name(ename))
            } else if ename == "Tuple" {
                sig_params = sig_params.concat(tuple_c_name_from_ann(elem, "void"))
            } else {
                sig_params = sig_params.concat(c_type_str(type_from_name(ename)))
            }
            i = i + 1
        }
    }
    let mut ret_str = resolve_ret_type_from_ann(ta)
    if ret_str == "" {
        ret_str = c_type_str(ret_type)
        if is_struct_type(ret_name) != 0 {
            ret_str = c_type_c_name(ret_name)
        } else if is_enum_type(ret_name) != 0 {
            ret_str = c_type_c_name(ret_name)
        }
    }
    "{ret_str}(*)({sig_params})"
}

pub fn is_generic_fn(name: Str) -> Int {
    generic_fns_by_name.contains_key(name)
}

pub fn get_generic_fn_node(name: Str) -> Int {
    match generic_fns_by_name.get(name) {
        Some(v) => { return v }
        None => {}
    }
    -1
}

// Resolves the callee's params sublist for a Blink-name lookup, preferring
// the generic-fn registry (templates) before the concrete-fn registry.
// Returns -1 when the name is unknown to both registries OR the looked-up
// node id is -1 (since node_params(-1) panics). Asymmetry note:
// is_fn_registered may return 1 while get_fn_node returns -1, so callers
// must always treat -1 as "no usable params" rather than reading from it.
pub fn get_callee_params_sl(fn_name: Str) -> Int {
    if is_generic_fn(fn_name) != 0 {
        let gfn = get_generic_fn_node(fn_name)
        if gfn != -1 {
            return node_params(gfn)
        }
        return -1
    }
    if is_fn_registered(fn_name) != 0 {
        let cfn = get_fn_node(fn_name)
        if cfn != -1 {
            return node_params(cfn)
        }
    }
    -1
}

// Slot contradictions seen by merge_arg_tids: two DIFFERENT tid NUMBERS offered for one slot
// of one (base, args) key. NOT unreachable — MEASURED at 43 hits across 13 fixtures on the
// 700-fixture corpus. A count alone cannot be triaged, because two unrelated mechanisms land
// on it, and they are told apart by comparing the two tids STRUCTURALLY (tc_tid_same_type),
// never by their numbers and never by the `args` spelling. Measured split, 25 / 18:
//
//   25 SAME-TYPE (19 of them over 12 fixtures: Box_Int, Result_Box_Int_str, LocBox_Int,
//   Option_Box_Int, Option_int, Option_Cmd, Tuple2_Option_int_int, …) — ty_pool does not
//   intern compound types, so a second Option[Box[Int]] mints a second tid for the same
//   type. Harmless: either tid lowers identically. (br v76b0b)
//
//   18 DIFF-TYPE (all in tests/test_jkdywb_tuple_inline_container.bl) — THE `args` CSV KEY IS
//   NON-INJECTIVE. Its `fn wrap[T](x: T) -> (T, Int)` is instantiated at Set[Int], Set[Str]
//   and Set[Point], all of which spell the bare segment "Set", so all three share the one
//   mono key "wrap"/"Set" while carrying three distinct tids (same for the three Map
//   instantiations). That collapse predates this counter and has nothing to do with the join;
//   the join merely made it OBSERVABLE. (The fixture passes because the def side keeps those
//   instantiations apart through the tid memo threaded at the tuple boundary, not through
//   this registry's arg_tids.)
//
// A DIFF-TYPE hit is NOT automatically a bug: sharing one entry is CORRECT when the segment
// is representation-keyed, since Set[Int] and Set[Str] are both blink_set* and share one C
// symbol. What must not happen is a consumer reading per-instantiation IDENTITY off such a
// slot — tc_tid_seg_injective is the predicate for that, and br qnpb2d is the consumer it
// gates. A DIFF-TYPE hit on a segment that DOES name its own type arguments would instead be
// the q4etvt non-canonical-interning class, a genuine bug; the corpus shows none.
//
// The tie-break is arbitrary and provably so: rebuilding the whole corpus with `max` instead
// of `min` emits byte-identical C for all 709 files, so no conflicting slot is load-bearing
// today. That is a statement about today's corpus, not a guarantee — see the ticket note, and
// br qnpb2d in particular, where making the tid path AUTHORITATIVE over the string path would
// turn one of these collapsed keys into a real miscompile.
pub let mut mono_arg_tid_conflicts: Int = 0
// Arity disagreements between two populated lists for one key. MEASURED at zero across the
// corpus and both compiler entry points, as expected: arg_tids are positionally aligned with
// the `args` CSV segments and `args` is half the dedup key, so one key cannot disagree on
// arity even when it is non-injective about segment CONTENT.
pub let mut mono_arg_tid_arity_conflicts: Int = 0

// One recorded slot contradiction, awaiting CLASSIFICATION by a reader that can spell
// tids (tc_classify_mono_conflicts, in typecheck.bl).
//
// The counter above says only HOW MANY contradictions there were, and that number cannot
// be triaged: "two handles on the SAME type" (harmless — ty_pool never interns compound
// types, so a second Option[Box[Int]] mints a second tid) and "two DIFFERENT types
// sharing one non-injective CSV segment" (a latent miscompile the moment the tid becomes
// authoritative) both land on it. Telling them apart requires comparing the two tids
// STRUCTURALLY, which merge_arg_tids may not do: it sits BELOW typecheck in the DAG and
// its purity is a requirement (see the note on merge_arg_tids). So it records the raw
// pair here — Int/Str data only, no tid accessor reached — and typecheck classifies.
pub type MonoSlotConflict {
    base: Str
    args: Str
    slot: Int
    stored: Int
    incoming: Int
}
// Drained by tc_classify_mono_conflicts at the end of generate(). Bounded by the number
// of contradictions, which is 31 across the whole 700-fixture corpus.
pub let mut mono_slot_conflicts: List[MonoSlotConflict] = []
// Classification results, filled by tc_classify_mono_conflicts.
//
// `same_type` is the interning artefact: harmless today and harmless under br qnpb2d,
// because the two tids denote the same type, so either one lowers identically.
// `diff_type` is the load-bearing one: one (base, args) key genuinely collapsed two
// DIFFERENT types, so a single stored tid cannot be per-instantiation identity for both.
// A nonzero `diff_type` is not automatically a bug — the collapse is CORRECT when the key
// is representation-keyed (Set[Int] and Set[Str] are both blink_set*, share one C symbol,
// and must therefore share one registry entry; tc_tid_seg_injective is the predicate for
// that) — but it is exactly the population br qnpb2d must not read identity out of.
pub let mut mono_slot_conflicts_same_type: Int = 0
pub let mut mono_slot_conflicts_diff_type: Int = 0

// The subset of `diff_type` that is an actual DECISIONS.md:343 violation, and the only
// one of these three counters with a real floor of 0.
//
// `diff_type` cannot be asserted == 0 because the collapse is CORRECT whenever the key is
// representation-keyed: Set[Int] and Set[Str] are both blink_set*, share one C symbol, and
// must therefore share one registry entry. This counts only the conflicts where BOTH tids'
// segments NAME their own type arguments (tc_tid_seg_injective) — two genuinely distinct
// instantiations that the key nevertheless collapsed, which is the q4etvt class.
//
// tc_tid_seg_injective is consulted here purely as an ADJUDICATOR of a conflict that
// already happened. Its header forbids using it as a GATE to degrade a slot, and this is
// not that.
//
// Limit: only conflicts registered within ONE compilation unit are visible. Cross-TU
// collapse does not reach this counter.
pub let mut mono_slot_conflicts_diff_type_injective: Int = 0

// The LATTICE JOIN of two arg_tids lists for the same (base, args) key (br p7014w).
//
// Both register fns dedup on (base, args); before this, the loser's arg_tids was simply
// discarded, so EMISSION ORDER — not tid quality — decided what the def side got. A join
// makes the stored payload a function of the SET of registrations instead of their order,
// which is what decisions/compiler-type-representation.md:47 (Q3, 5-0) requires of anything
// behind a canonical key: "Compound types constructed in different orders must produce the
// same key."
//
// It must be a JOIN and not a compare-and-replace. "Take whichever list is more concrete"
// has no answer for stored [t1,-1] against incoming [-1,t2] — the two are INCOMPARABLE, so
// first-arrival wins and the orders disagree on exactly the case that matters most.
// Element-wise join has an answer: [t1,t2].
//
// Per slot: bottom = -1, every concrete tid >= 0 an incomparable atom.
// Per list: bottom = [], and EVERY populated list is strictly above it INCLUDING AN
// ALL- -1 LIST, because arity is information. Widening [] to all- -1 is a no-op for every
// consumer EXCEPT the hole-filler: resolve_tparam_seg (:2419-2424) treats an out-of-range
// slot and a "" seg identically, tparam_tid_via_mono (codegen_methods.bl:374-375) returns
// -1 for both, and segs_from_arg_tids (codegen_expr.bl:3079-3092) maps -1 to "". The sole
// behavioural delta is that mono_arg_tids_with_ann (codegen_stmt.bl) starts working:
// it needs a -1 HOLE to fill and an empty list has none, so [] is unrecoverable even with a
// tid-bearing annotation in hand while [-1] is recoverable.
//
// PURITY IS A REQUIREMENT, NOT AN ACCIDENT. This is Int/List[Int]/Str arithmetic only, so it
// reaches no tid accessor and respects codegen_types' position BELOW typecheck in the DAG.
// The predicate may only ever ask "is this slot -1?", never "is this tid encodable?".
pub fn merge_arg_tids(stored: List[Int], incoming: List[Int], base: Str, args: Str) -> List[Int] {
    if incoming.len() == 0 { return stored }
    if stored.len() == 0 {
        dbg_trace("monodedup", "upgrade base={base} args={args} stored=[] incoming=len{incoming.len()} merged=incoming")
        return incoming
    }
    let mut width = stored.len()
    if stored.len() != incoming.len() {
        mono_arg_tid_arity_conflicts = mono_arg_tid_arity_conflicts + 1
        dbg_trace("monodedup", "arity-conflict base={base} args={args} stored=len{stored.len()} incoming=len{incoming.len()}")
        // Resolve by LENGTH, never by arrival order — otherwise the tie-break reintroduces
        // the order dependence this whole function exists to remove. But take only the
        // ARITY from the longer list, not its contents: the longer list can hold a -1
        // where the shorter holds a concrete tid, and returning it whole would DEGRADE
        // that slot. The overlap is joined element-wise below, with a missing slot read
        // as the per-slot bottom (-1), which is what makes this branch a join too.
        if incoming.len() > width { width = incoming.len() }
    }
    let mut out: List[Int] = []
    let mut upgraded = 0
    let mut i = 0
    while i < width {
        let s = arg_tid_slot(stored, i)
        let n = arg_tid_slot(incoming, i)
        if s == n {
            out.push(s)
        } else if s < 0 {
            upgraded = 1
            out.push(n)
        } else if n < 0 {
            out.push(s)
        } else {
            // Both concrete and different. Not a degradation — either the two tids are two
            // handles on the SAME type (ty_pool does not intern compounds) or the CSV
            // segment collapsed two DIFFERENT types. Which one cannot be decided here: it
            // takes a structural comparison of the two tids, and this fn may not spell a
            // tid. Record the pair for tc_classify_mono_conflicts and keep going; the fix
            // for either is at the TID SOURCE or the KEY, never here.
            mono_arg_tid_conflicts = mono_arg_tid_conflicts + 1
            mono_slot_conflicts.push(MonoSlotConflict { base: base, args: args, slot: i, stored: s, incoming: n })
            dbg_trace("monodedup", "slot-conflict base={base} args={args} slot={i} stored={s} incoming={n}")
            // `min` purely so the join stays commutative and associative; a join is what
            // makes the result a function of the registration SET. DO NOT TUNE THIS — the
            // choice is measured to be C-neutral, so tuning it can only ever look like it
            // fixed something.
            out.push(if s < n { s } else { n })
        }
        i = i + 1
    }
    if upgraded != 0 {
        if dbg_channel_on("monodedup") != 0 {
            dbg_trace("monodedup", "upgrade base={base} args={args} stored={arg_tids_dbg(stored)} incoming={arg_tids_dbg(incoming)} merged={arg_tids_dbg(out)}")
        }
    }
    out
}

// A slot of an arg_tids list, with an out-of-range index reading as the per-slot bottom.
// Only merge_arg_tids' arity-conflict branch can index past a list's end, and treating the
// missing slot as -1 is what keeps that branch a join rather than a replacement.
fn arg_tid_slot(t: List[Int], i: Int) -> Int {
    if i < t.len() { return t.get(i).unwrap() }
    -1
}

fn arg_tids_differ(a: List[Int], b: List[Int]) -> Bool {
    if a.len() != b.len() { return true }
    let mut i = 0
    while i < a.len() {
        if a.get(i).unwrap() != b.get(i).unwrap() { return true }
        i = i + 1
    }
    false
}

fn arg_tids_dbg(t: List[Int]) -> Str {
    let mut s = "["
    let mut i = 0
    while i < t.len() {
        if i > 0 { s = s.concat(",") }
        s = s.concat("{t.get(i).unwrap()}")
        i = i + 1
    }
    s.concat("]")
}

pub fn register_mono_fn(base: Str, args: Str, arg_tids: List[Int]) ! Codegen.Register {
    let mut i = 0
    while i < mono_fns.len() {
        let mf = mono_fns.get(i).unwrap()
        if mf.base == base && mf.args == args {
            // Not a bare `return` — the incoming arg_tids used to be discarded here, making
            // registration order decide what the def side got (br p7014w). Join instead.
            mono_fns.set(i, MonoFnInstance { base: mf.base, args: mf.args, arg_tids: merge_arg_tids(mf.arg_tids, arg_tids, base, args) })
            return
        }
        i = i + 1
    }
    mono_fns.push(MonoFnInstance { base: base, args: args, arg_tids: arg_tids })
}

fn infer_closure_param_type(sig: Str, param_idx: Int) -> Int {
    if sig == "" { return CT_VOID }
    let star_pos = sig.index_of("*)")
    if star_pos < 0 { return CT_VOID }
    let params_start = star_pos + 2
    let close_pos = sig.len() - 1
    if params_start >= close_pos { return CT_VOID }
    let params_str = sig.substring(params_start + 1, close_pos - params_start - 1)
    let parts = params_str.split(", ")
    let actual_idx = param_idx + 1
    if actual_idx >= parts.len() { return CT_VOID }
    let ctype = parts.get(actual_idx).unwrap()
    ct_from_c_type(ctype)
}

fn infer_closure_ret_type(sig: Str) -> Int {
    if sig == "" { return CT_VOID }
    let paren_pos = sig.index_of("(")
    if paren_pos <= 0 { return CT_VOID }
    let ret_str = sig.substring(0, paren_pos)
    ct_from_c_type(ret_str)
}

fn ct_from_c_type(ctype: Str) -> Int {
    if ctype == "int64_t" { CT_INT }
    else if ctype == "double" { CT_FLOAT }
    else if ctype == "const char*" { CT_STRING }
    else if ctype == "int" { CT_BOOL }
    else if ctype == "blink_list*" { CT_LIST }
    else if ctype == "blink_map*" { CT_MAP }
    else if ctype == "blink_set*" { CT_SET }
    else { CT_VOID }
}

pub fn type_name_from_ct(ct: Int) -> Str {
    if ct == CT_INT { "Int" }
    else if ct == CT_FLOAT { "Float" }
    else if ct == CT_BOOL { "Bool" }
    else if ct == CT_STRING { "Str" }
    else if ct == CT_LIST { "List" }
    else if ct == CT_ITERATOR { "Iterator" }
    else if ct == CT_HANDLE { "Handle" }
    else if ct == CT_CHANNEL { "Channel" }
    else if ct == CT_MAP { "Map" }
    else if ct == CT_SET { "Set" }
    else if ct == CT_BYTES { "Bytes" }
    else if ct == CT_STRINGBUILDER { "StringBuilder" }
    else if ct == CT_PTR { "Ptr" }
    else if ct == CT_CLOSURE { "Fn" }
    else if ct == CT_HANDLER { "Handler" }
    else if ct == CT_I8 { "I8" }
    else if ct == CT_I16 { "I16" }
    else if ct == CT_I32 { "I32" }
    else if ct == CT_U8 { "U8" }
    else if ct == CT_U16 { "U16" }
    else if ct == CT_U32 { "U32" }
    else if ct == CT_U64 { "U64" }
    else if ct == CT_CHAR { "Char" }
    // Ten CTs reach this bare else — CT_VOID, CT_OPTION, CT_RESULT, CT_TAGGED_ENUM,
    // CT_INSTANT, CT_DURATION, CT_FFI_SCOPE, CT_TEMPLATE, CT_STRUCT and CT_ENUM — and
    // "Void" is NOT an erasure sentinel for them, because several CONSUMERS depend on this
    // exact string as a load-bearing dispatch signal, not as a type name:
    //   codegen_methods.bl's list-HOF guard (`if elem_name != "Void"`) uses it to exclude a
    //     struct/enum element from the stdlib path — and says so in its own comment.
    //   codegen_closures.bl / codegen_methods.bl / codegen_expr.bl compare a closure or
    //     method return name against "Void" to decide void-return lowering.
    // br hsgsbp deliberately did NOT change this arm. Erasure in a type-arg CSV is a
    // DIFFERENT question from "what do I call this CT", and it is answered by
    // type_arg_name_from_ct below. Changing this else would silently disarm ~16 guards
    // across four modules that have nothing to do with monomorphization.
    else { "Void" }
}

// The TYPE-ARGUMENT spelling of a CT, for the mono-CSV producers only — which since
// br 3fc3pn means infer_struct_type_args alone, the fn-call twin having been deleted
// with the rest of the string CSV. Same answers as
// type_name_from_ct for every CT that HAS a name; the difference is what it says when
// there is none.
//
// br hsgsbp: type_name_from_ct answers "Void" both for a genuine CT_VOID and for nine CTs
// it simply cannot name. In a type-arg CSV those two are opposites — the first is a real
// type argument that must lower, the second is an ERASURE that must fail closed — and
// collapsing them is what made a genuine `Box[Void]` raise I0001 while
// `blink_GKV_Void_Void` compiled and linked silently. Splitting them HERE rather than in
// type_name_from_ct keeps the blast radius inside the mono machinery, which is the only
// audience that reads these strings as type arguments.
//
// Structured as "delegate, then disambiguate the one ambiguous answer" on purpose: every
// real arm is inherited automatically, so a CT that gains a name in type_name_from_ct
// gains it here too, and this function cannot drift out of sync with it.
pub fn type_arg_name_from_ct(ct: Int) -> Str {
    let name = type_name_from_ct(ct)
    if name != "Void" {
        return name
    }
    // A GENUINE Void type argument. Void is "an ordinary INHABITED, encodable type"
    // (decisions/under-determined-types.md:39, 6-0), so it is spelled, not refused — this
    // is the arm that makes `Box[Void]` compile, and the string path's answer here
    // byte-matches the tid path's tc_tid_to_c_tag TK_VOID arm.
    if ct == CT_VOID {
        return "Void"
    }
    // Genuinely unnameable: no arm exists and none is inherited. Answer with a sentinel that
    // is greppable and that cannot be confused with a real type's name the way "Void" was.
    // The LOCATED I0001 is raised downstream by the chokepoints that have a node
    // (mono_args_has_void_seg, resolve_mono_slot), both of which detect it via
    // diag_is_ice_seg — the chokepoints, NOT the spelling, are the guarantee. The sentinel
    // is a legal C identifier, so an escape into a mangled symbol name would be silent; see
    // the header comment in src/diagnostics.bl.
    ICE_SEG_ERASED_SLOT
}

pub fn mangle_generic_name(base: Str, args: Str) -> Str {
    let mut result = base
    let mut i = 0
    let mut _seg_start = 0
    while i <= args.len() {
        if i == args.len() || args.byte_at(i) == 44 { // ','
            let seg = args.substr(_seg_start, i - _seg_start)
            result = result.concat("_").concat(seg)
            _seg_start = i + 1
        }
        i = i + 1
    }
    result
}

/// Compute the mangled C name for an impl method.
/// The trait name is part of the symbol so two traits that define the same
/// method for one type (§3c rule-3) get distinct symbols and the qualified
/// escape hatch `Trait.method(x)` can select between them.
///
/// From/TryFrom are excepted: they are one trait with many source-typed
/// instances (`From[I8] for Int`, `From[I16] for Int`, ...), already
/// disambiguated by the source type via their own def+call path
/// (mangle_from_method). Routing them through the trait-qualified form would
/// collide (all share trait `From`, method `from`), so they keep their proven
/// `{target}_{method}_{source}` scheme.
pub fn mangle_impl_method(im: Int, impl_type: Str, mname: Str) -> Str {
    let trait_name = node_trait_name(im)
    if trait_name == "From" || trait_name == "TryFrom" {
        let trait_tparams = node_type_params(im)
        if trait_tparams != -1 && sublist_length(trait_tparams) > 0 {
            let src = node_name(sublist_get(trait_tparams, 0))
            return mangle_from_method(src, impl_type, mname)
        }
    }
    mangle_impl_method_q(impl_type, trait_name, mname)
}

// Symbol builder keyed on the resolved trait name. Call sites that know the
// trait (qualified calls; unqualified calls after impl_trait_for_method) build
// the symbol through this; `mangle_impl_method` is the impl-node wrapper.
// Not for From/TryFrom (see mangle_impl_method).
pub fn mangle_impl_method_q(impl_type: Str, trait_name: Str, mname: Str) -> Str {
    "{impl_type}_{trait_name}_{mname}"
}

pub fn mangle_from_method(source: Str, target: Str, mname: Str) -> Str {
    "{target}_{mname}_{source}"
}

pub fn register_mono_instance(base: Str, args: Str, arg_tids: List[Int]) -> Str ! Codegen.Register {
    register_mono_instance_ann(base, args, arg_tids, -1)
}

// register_mono_instance plus the source annotation node, for the one producer that
// cannot compute arg_tids itself (see MonoInstance.ann). On a dedup hit an incoming
// annotation is ATTACHED to the existing entry when that entry has none: registration
// order is not controlled, so the tid-bearing annotation may well arrive second, and
// dropping it would leave the def side with the same all- -1 slots this exists to fix.
//
// The incoming arg_tids is JOINED into the existing entry in that SAME lookup (br p7014w) —
// it used to be dropped outright, so registration order decided the def side's slots. Note
// this deliberately does NOT sit under an `ann != -1` guard: every tid-BEARING producer
// arrives through register_mono_instance with ann == -1, and it is precisely those that must
// be able to upgrade a degraded entry. `ann` keeps its own fill-a-hole rule, which is sound
// for a single node id because two annotations naming one instance memoize the same interned
// tid (that residual "first non- -1 wins" is recorded on the ticket as benign).
pub fn register_mono_instance_ann(base: Str, args: Str, arg_tids: List[Int], ann: Int) -> Str ! Codegen.Register {
    let existing = lookup_mono_instance(base, args)
    if existing != "" {
        match mono_rev_idx.get(existing) {
            Some(idx) => {
                let m = mono_instances.get(idx).unwrap()
                let merged = merge_arg_tids(m.arg_tids, arg_tids, base, args)
                let keep_ann = if m.ann == -1 { ann } else { m.ann }
                // The overwhelmingly common dedup hit is a second identical registration
                // (ann == -1, same arg_tids), where the join is the identity — skip the
                // rewrite so a repeated struct literal does not rebuild the entry.
                if keep_ann != m.ann || arg_tids_differ(merged, m.arg_tids) {
                    mono_instances.set(idx, MonoInstance { base: m.base, args: m.args, c_name: m.c_name, arg_tids: merged, ann: keep_ann })
                }
            }
            None => {}
        }
        return existing
    }
    // The C symbol is built off the PHYSICAL base (module-prefixed for a
    // cross-module generic struct), and so is the dedup key — else two modules'
    // `Box[Int]` (bare-equal base+args) would merge to one entry (br q4etvt). The
    // logical `base` is still stored for find_type_def / field-resolution. For fns
    // and same-module structs phys_base == base, so both the symbol and the key are
    // byte-identical to before.
    let phys_base = mono_phys_base(base)
    let c_name = mangle_generic_name(phys_base, args)
    mono_idx.insert(phys_base.concat("\t").concat(args), mono_instances.len())
    mono_rev_idx.insert(c_name, mono_instances.len())
    mono_instances.push(MonoInstance { base: base, args: args, c_name: c_name, arg_tids: arg_tids, ann: ann })
    c_name
}

pub type MonoLookup {
    base: Str
    args: Str
    arg_tids: List[Int]
}

pub fn lookup_mono_base(c_name: Str) -> MonoLookup {
    match mono_rev_idx.get(c_name) {
        Some(idx) => {
            let m = mono_instances.get(idx).unwrap()
            return MonoLookup { base: m.base, args: m.args, arg_tids: m.arg_tids }
        }
        None => {}
    }
    MonoLookup { base: "", args: "", arg_tids: [] }
}

pub fn find_type_def_node(name: Str) -> Int {
    let types_sl = node_fields(cg_program_node)
    if types_sl == -1 {
        return -1
    }
    let mut i = 0
    while i < sublist_length(types_sl) {
        let td = sublist_get(types_sl, i)
        if node_name(td) == name {
            return td
        }
        i = i + 1
    }
    -1
}

// Build a mono struct name from a generic-struct type annotation.
// Returns the mangled name (e.g. "Box_Int") if `base_name` is a generic
// user-defined type and `ann_node` carries its type-arg annotations.
// Returns "" if `base_name` isn't generic or the annotation lacks type args.
pub fn mono_name_from_ann(base_name: Str, ann_node: Int, tparams_sl: Int, segs: List[Str]) -> Str {
    let td = find_type_def_node(base_name)
    if td == -1 { return "" }
    let td_tparams = node_type_params(td)
    if td_tparams == -1 || sublist_length(td_tparams) == 0 { return "" }
    if ann_node == -1 { return "" }
    let elems = node_elements(ann_node)
    if elems == -1 || sublist_length(elems) == 0 { return "" }
    let mut mono_args = ""
    let mut ai = 0
    while ai < sublist_length(elems) {
        let elem = sublist_get(elems, ai)
        let raw_name = node_name(elem)
        let resolved_arg = resolve_tparam_seg(raw_name, tparams_sl, segs)
        // An arg annotation that itself carries structure must spell its own full stem,
        // not the flat head resolve_tparam_seg yields: the head names a C type that is
        // never typedef'd. Two such args, and both diverge from the tid-native
        // tc_tid_struct_mono_name / register_struct_instance_from_tid that the
        // construction+typedef side uses. resolved_arg (bare head / substituted
        // concrete) stays the fallback for both.
        let mut arg_seg = resolved_arg
        // A TUPLE arg (`GT[(Int, Int)]`) flattens to "Tuple", and neither arm below can
        // pick it up: type_from_name("Tuple") is CT_VOID and is_struct_type("Tuple") is
        // 0, because only the mangled Tuple2_int_int is ever registered
        // (ensure_tuple_type). resolve_tuple_ann spells it and registers that typedef as
        // an idempotent side effect — the same delegation resolve_ann_tag (:5609) makes,
        // except that this call passes the mono context, as the struct recursion below
        // does: resolve_tuple_tag's context-free -1/[] would decline a tuple whose
        // elements are typevars instead of resolving them. Keyed on the RAW name,
        // matching resolve_tuple_ann:2465 — a typevar already substituted to a tuple
        // arrives as the mangled tag and needs no recursion. Left flat, the name diverges
        // from the tid path's GT_Tuple2_int_int, and as a carrier payload the field
        // ERASES to `void ok` (br 23tfxg, the w4c0py spelling).
        if raw_name == "Tuple" {
            let tup = resolve_tuple_ann(elem, tparams_sl, segs)
            if tup.is_some() { arg_seg = tup.unwrap() }
        } else if (is_struct_type(resolved_arg) != 0 || is_enum_type(resolved_arg) != 0) {
            // A NESTED generic-struct-instance arg (`Box[Box[Int]]` → outer arg
            // `Box[Int]`) recurses for its own stem (Box_Int); a flat `Box` is one level
            // short and names a type that is never typedef'd (br 637sy9).
            let nested = mono_name_from_ann(strip_module_qualifier(resolved_arg), elem, tparams_sl, segs)
            if nested != "" { arg_seg = nested }
        }
        if ai > 0 {
            mono_args = mono_args.concat(",")
        }
        mono_args = mono_args.concat(arg_seg)
        ai = ai + 1
    }
    // PHYSICAL base so this C-symbol producer byte-matches register_mono_instance's
    // c_name for a cross-module instance (the carrier/typedef-order consumers feed
    // the result to c_type_c_name); no-op for fn/same-module bases (q4etvt).
    mangle_generic_name(mono_phys_base(base_name), mono_args)
}

// br bee854: an Option/Result carrier over a generic-struct INSTANCE inner
// (`Option[QBox[Int]]`) must spell its value member with the mono stem (QBox_Int),
// not the bare head (QBox) — else emit_struct_option_typedef's c_type_from_tag hits
// the is_struct_type branch and emits an undeclared `blink_QBox*` member, minting a
// divergent bare `blink_Option_QBox` carrier alongside the tid-path's
// `blink_Option_QBox_Int`.
//
// This computes the mono stem for `inner_ann` over generic struct/enum `inner_name`
// AND registers the instance into the mono registry, so is_mono_struct_instance
// recognizes the tag when the carrier typedef emits its member (c_type_from_tag →
// `blink_QBox_Int`). Registration is annotation-driven (codegen_types cannot reach
// the tid accessors — typecheck imports it, not the reverse), mirroring
// mono_name_from_ann's arg loop; a NESTED generic-instance arg is registered
// inner-first (its typedef must precede the outer that names it). Returns the mono
// stem (`QBox_Int`) or "" when inner_name isn't a generic instance (bare struct /
// typevar) — the caller then keeps its existing bare-head spelling.
//
// Because no tid is reachable here, this registers the SOURCE ANNOTATION alongside
// the all- -1 arg_tids (MonoInstance.ann) and the def-side typedef emitter recovers
// the real slots from it above typecheck. Do not "fix" the -1s by parsing the
// concrete_args string: that resolver was deleted (0n07he) and reinstating it is
// exactly what decisions/compiler-type-representation.md step 4 forbids.
pub fn register_carrier_inner_mono_instance(inner_name: Str, inner_ann: Int) -> Str ! Codegen.Register {
    let base = strip_module_qualifier(inner_name)
    let td = find_type_def_node(base)
    if td == -1 { return "" }
    let td_tparams = node_type_params(td)
    if td_tparams == -1 || sublist_length(td_tparams) == 0 { return "" }
    if inner_ann == -1 { return "" }
    let elems = node_elements(inner_ann)
    if elems == -1 || sublist_length(elems) == 0 { return "" }
    let mut args = ""
    let mut arg_tids: List[Int] = []
    let mut ai = 0
    while ai < sublist_length(elems) {
        let elem = sublist_get(elems, ai)
        let raw_name = node_name(elem)
        let resolved = resolve_tparam_seg(raw_name, -1, [])
        let mut arg_seg = resolved
        // A tuple arg spells its mangled stem, exactly as mono_name_from_ann's arm does
        // and for the same reason (br 23tfxg): the bare head "Tuple" is neither a
        // compound CT nor a registered struct, so leaving it flat REGISTERS a second
        // divergent instance (`GT_Tuple`) alongside the tid path's GT_Tuple2_int_int —
        // one Blink type, two C typedefs, exit 0. resolve_tuple_tag is resolve_tuple_ann
        // with no mono context, which is all this loop has: its resolve_tparam_seg call
        // above passes -1/[] for the same reason (no tid or mono state is reachable from
        // codegen_types — see this function's header).
        if raw_name == "Tuple" {
            let tup = resolve_tuple_tag(elem)
            if tup != "" { arg_seg = tup }
        } else if is_struct_type(resolved) != 0 || is_enum_type(resolved) != 0 {
            // A nested generic-instance arg (`QBox[QBox[Int]]`) registers inner-first and
            // reuses its own full mono stem, matching mono_name_from_ann's recursion.
            let nested = register_carrier_inner_mono_instance(resolved, elem)
            if nested != "" { arg_seg = nested }
        }
        if ai > 0 { args = args.concat(",") }
        args = args.concat(arg_seg)
        // No tid is computable HERE: codegen_types sits below typecheck in the module
        // DAG, so the tid accessors are out of reach. Registering the source annotation
        // (below) hands the def-side emitter the node whose memoized instance tid it can
        // read for itself — see MonoInstance.ann. This used to say the def side would
        // recover the slot from the concrete_args STRING; that resolver is gone (0n07he),
        // and the premise outliving it is what erased these fields to `void` (br w4c0py).
        arg_tids.push(-1)
        ai = ai + 1
    }
    register_mono_instance_ann(base, args, arg_tids, inner_ann)
}

// Concrete type-args CSV for a struct instance whose enclosing value context
// names it with type arguments (e.g. `let b: GKV[Int, Str] = GKV { .. }`, or a
// call arg `f(GKV { .. })` where f's param is `GKV[Int, Str]`). Each argument
// name is resolved through the current fn's mono context so a nested
// `GKV[T, Str]` inside a generic fn picks up T's concrete binding. Returns ""
// when no in-scope annotation names this struct with the right arity.
//
// Prefers cg_expect_arg_ann (the call-arg/struct-field context) over
// cg_let_target_ann, mirroring resolve_ctor_kops_elem (br 6ph073): a struct
// literal nested inside a CALL ARG leaves the OUTER let's cg_let_target_ann set,
// so keying off it alone would wrongly stamp the outer instantiation onto the
// inner literal (e.g. `let b: GKV[Int,_] = f(GKV { m: Map() })` where f wants
// GKV[Str,_] — the inner must NOT become GKV[Int,_]). The arity check guards
// against a same-named-but-different-shape annotation and a malformed target.
//
// Note the call-arg qualifier is load-bearing: at the STRUCT-FIELD site this is no longer
// true, because br htxpmh's field loop retargets cg_let_target_ann to the field's own
// annotation. The preference order still matters for the call-arg case above.
//
// Lets emit_struct_lit monomorphize a struct built from an empty container
// field (Map()/Set()) — whose element type can't be inferred from field VALUES
// — off the declared target, so the container ctor selects the right kops
// vtable instead of the erased-typevar string default (hnyqe4).
pub fn struct_concrete_args_from_target(sname: Str, segs: List[Str]) -> Str {
    let td = find_type_def_node(sname)
    if td == -1 { return "" }
    let td_tparams = node_type_params(td)
    if td_tparams == -1 { return "" }
    let nparams = sublist_length(td_tparams)
    if nparams == 0 { return "" }
    let mut ann = -1
    if cg_expect_arg_ann != -1 && strip_module_qualifier(node_name(cg_expect_arg_ann)) == sname {
        ann = cg_expect_arg_ann
    } else if cg_let_target_ann != -1 && strip_module_qualifier(node_name(cg_let_target_ann)) == sname {
        ann = cg_let_target_ann
    }
    if ann == -1 { return "" }
    let elems = node_elements(ann)
    if elems == -1 || sublist_length(elems) != nparams { return "" }
    let mut args = ""
    let mut ai = 0
    while ai < sublist_length(elems) {
        let elem = sublist_get(elems, ai)
        // A compound arg (tuple `(Int,Str)`, `List[Int]`, `Map[..]`, `Option[..]`)
        // flattens lossily here — node_name yields only the head ("Tuple"/"List"),
        // dropping the inner types. That produces a wrong/undefined mono name and,
        // for a compound Map key, an undeclared kops symbol. Bail so these fall back
        // to field-value inference (mono tuple/struct-key support is br 0sh55p).
        let sub = node_elements(elem)
        if sub != -1 && sublist_length(sub) > 0 { return "" }
        // Strip module qualifiers so the mono name matches the one the field-value
        // inference path (type_name_from_ct) and field-access recovery compute for
        // the same instantiation — else `GKV_othermod.Foo_Str` vs `GKV_Foo_Str`
        // would register two divergent instances.
        let resolved = strip_module_qualifier(resolve_tparam_seg(node_name(elem), cg_mono_tparams_sl, segs))
        if ai > 0 { args = args.concat(",") }
        args = args.concat(resolved)
        ai = ai + 1
    }
    args
}

pub fn lookup_mono_instance(base: Str, args: Str) -> Str {
    // Key on the PHYSICAL base to match register_mono_instance's keying (q4etvt);
    // phys_base == base for fns and same-module structs, so unchanged for them.
    let key = mono_phys_base(base).concat("\t").concat(args)
    match mono_idx.get(key) {
        Some(idx) => return mono_instances.get(idx).unwrap().c_name
        None => {}
    }
    ""
}

pub fn is_trait_type(name: Str) -> Int {
    let mut i = 0
    while i < trait_entries.len() {
        if trait_entries.get(i).unwrap().name == name {
            return 1
        }
        i = i + 1
    }
    0
}

pub fn lookup_impl_method(type_name: Str, method: Str) -> Int {
    if impl_method_idx.contains_key(type_name.concat("\t").concat(method)) { return 1 }
    let bare = strip_module_qualifier(type_name)
    if bare != type_name && impl_method_idx.contains_key(bare.concat("\t").concat(method)) { return 1 }
    0
}

// The name under which `method`'s impl is registered for receiver `type_name`:
// the qualified name if registered there, else the bare name (impls register
// under the bare `node_name(im)`). Callers mangle the C symbol from this, so a
// `mod.Type` receiver resolves to the same symbol as the bare impl.
pub fn impl_method_reg_name(type_name: Str, method: Str) -> Str {
    if impl_method_idx.contains_key(type_name.concat("\t").concat(method)) { return type_name }
    strip_module_qualifier(type_name)
}

// Count how many distinct traits define `method` for receiver `type_name`,
// and (out) capture the names of the colliding traits. Drives both symbol
// resolution (count==1 ⇒ unique owner) and the E0522 ambiguity diagnostic
// (count>=2). Iterates impl_entries, which stores trait per (trait,type) entry.
pub fn impl_traits_with_method(type_name: Str, method: Str) -> List[Str] {
    let bare = strip_module_qualifier(type_name)
    let mut out: List[Str] = []
    let mut i = 0
    while i < impl_entries.len() {
        let ie = impl_entries.get(i).unwrap()
        if ie.type_name == type_name || ie.type_name == bare {
            let mut j = 0
            while j < sublist_length(ie.methods_sl) {
                if node_name(sublist_get(ie.methods_sl, j)) == method {
                    out.push(ie.trait_name)
                    j = sublist_length(ie.methods_sl)
                } else {
                    j = j + 1
                }
            }
        }
        i = i + 1
    }
    out
}

// The unique trait that defines `method` for `type_name`, or "" if zero or
// more than one (ambiguous) own it. Unqualified call sites use this to build
// the trait-qualified C symbol; ambiguity is rejected upstream at typecheck.
pub fn impl_trait_for_method(type_name: Str, method: Str) -> Str {
    let traits = impl_traits_with_method(type_name, method)
    if traits.len() == 1 { return traits.get(0).unwrap() }
    ""
}

// Does `type_name` implement `method` specifically via `trait_name`? Lets a
// qualified call (Trait.method(x)) confirm the named trait truly owns the
// method before building the trait-qualified symbol from that name.
pub fn impl_type_implements_trait_method(type_name: Str, trait_name: Str, method: Str) -> Int {
    let traits = impl_traits_with_method(type_name, method)
    let mut i = 0
    while i < traits.len() {
        if traits.get(i).unwrap() == trait_name { return 1 }
        i = i + 1
    }
    0
}

pub fn lookup_impl_type_for_trait(trait_name: Str, type_name: Str) -> Int {
    let mut i = 0
    while i < impl_entries.len() {
        let ie = impl_entries.get(i).unwrap()
        if ie.trait_name == trait_name && ie.type_name == type_name {
            return 1
        }
        i = i + 1
    }
    0
}

// C call expression for a struct/enum's synthesized sealed `{T}_display`,
// or "" if `type_name` has no usable Display impl. The `lookup_impl_method
// == 0` clause skips synthesis when a `display` from a DIFFERENT impl block
// owns the symbol (see emit_display_fn_defs / E0731). Sole resolution point
// for "call this type's Display" — method dispatch and test-body `?` rendering
// both route through here.
pub fn synthesized_display_call(type_name: Str, value_expr: Str) -> Str {
    let disp_reg = impl_method_reg_name(type_name, "fmt")
    if lookup_impl_type_for_trait("Display", disp_reg) != 0 && lookup_impl_method(type_name, "display") == 0 {
        return "{c_fn_name(mangle_impl_method_q(disp_reg, "Display", "display"))}({value_expr})"
    }
    ""
}

// Coerce a C value expression of CT `ct` to a `const char*` C expression for
// embedding into a `%s` printf vararg. Scalars are snprintf'd into a fresh
// buffer (emitted before the return); Str passes through. Non-coercible types
// fall through unchanged (caller must guard).
pub fn coerce_to_c_str(expr: Str, ct: Int) -> Str ! Codegen.Emit {
    if ct == CT_STRING {
        return expr
    }
    if ct == CT_INT {
        let tmp = fresh_temp("_rci_")
        emit_line("char {tmp}[32]; snprintf({tmp}, 32, \"%lld\", (long long){expr});")
        return tmp
    }
    if ct == CT_FLOAT {
        let tmp = fresh_temp("_rcf_")
        emit_line("char {tmp}[64]; snprintf({tmp}, 64, \"%g\", {expr});")
        return tmp
    }
    if ct == CT_BOOL {
        return "({expr} ? \"true\" : \"false\")"
    }
    if ct == CT_CHAR {
        return "blink_char_to_str((int64_t){expr})"
    }
    expr
}

// Render a Result arm value (the panicked-on arm of an unwrap/unwrap_err, or
// the propagated err of a test-body `?`) to a `const char*` C expression for a
// `%s` printf vararg. Builtin scalars coerce directly; struct/enum arms with an
// `impl Display` render through the synthesized sealed `{T}_display`. An arm
// type with no usable Display falls back to a literal `"<TypeName>"` — this is
// intentionally non-fatal: `.unwrap()` has no Display gate (unlike test-body
// `?`, whose E0514 guarantees a Display impl exists upstream).
pub fn render_result_arm_value(ct: Int, struct_name: Str, value_expr: Str) -> Str ! Codegen.Emit {
    if ct == CT_STRING || ct == CT_INT || ct == CT_FLOAT || ct == CT_BOOL || ct == CT_CHAR {
        return coerce_to_c_str(value_expr, ct)
    }
    if struct_name != "" {
        let disp_call = synthesized_display_call(struct_name, value_expr)
        if disp_call != "" { return disp_call }
    }
    let tag = if struct_name != "" { struct_name } else { "<error>" }
    "\"<{tag}>\""
}

pub fn lookup_builtin_trait_impl(trait_name: Str, ct_type: Int) -> Int {
    let mut i = 0
    while i < builtin_trait_impls.len() {
        let bt = builtin_trait_impls.get(i).unwrap()
        if bt.trait_name == trait_name && bt.ct_type == ct_type {
            return 1
        }
        i = i + 1
    }
    0
}

// Canonical receiver name for builtin CT_* types eligible for user trait impls.
// Returns "" for cts that cannot be a trait impl receiver yet.
pub fn builtin_receiver_type_name(ct: Int) -> Str {
    if ct == CT_STRING { "Str" }
    else if ct == CT_LIST { "List" }
    else if ct == CT_MAP { "Map" }
    else if ct == CT_SET { "Set" }
    else if ct == CT_BYTES { "Bytes" }
    else if ct == CT_STRINGBUILDER { "StringBuilder" }
    else if ct == CT_TEMPLATE { "Template" }
    else if ct == CT_FLOAT { "Float" }
    else { "" }
}

pub fn find_impl_method_node(type_name: Str, method: Str) -> Int {
    let key = type_name.concat("\t").concat(method)
    match impl_method_idx.get(key) {
        Some(v) => return v
        None => {}
    }
    -1
}

pub fn get_impl_method_ret(type_name: Str, method: Str) -> Int {
    let m = find_impl_method_node(type_name, method)
    if m == -1 { return CT_VOID }
    let ret_str = node_return_type(m)
    let ret_ct = type_from_name(ret_str)
    let ta = node_type_ann(m)
    if ta != -1 {
        if ret_str == "Result" {
            let elems_sl = node_elements(ta)
            if elems_sl != -1 && sublist_length(elems_sl) >= 2 {
                let ok_ann = sublist_get(elems_sl, 0)
                let err_ann = sublist_get(elems_sl, 1)
                let ok_name = node_name(ok_ann)
                let err_name = node_name(err_ann)
                expr_result_ok_type = type_from_name(ok_name)
                expr_result_err_type = type_from_name(err_name)
                if is_struct_type(ok_name) != 0 || is_enum_type(ok_name) != 0 {
                    expr_result_ok_struct = strip_module_qualifier(ok_name)
                } else {
                    expr_result_ok_struct = ""
                }
                if is_struct_type(err_name) != 0 || is_enum_type(err_name) != 0 {
                    expr_result_err_struct = strip_module_qualifier(err_name)
                } else {
                    expr_result_err_struct = ""
                }
            }
        } else if ret_str == "Option" {
            let elems_sl = node_elements(ta)
            if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
                let inner_ann = sublist_get(elems_sl, 0)
                let inner_name = node_name(inner_ann)
                let inner_t = type_from_name(inner_name)
                expr_option_inner = inner_t
                if is_struct_type(inner_name) != 0 || is_enum_type(inner_name) != 0 {
                    expr_option_inner_struct = strip_module_qualifier(inner_name)
                } else if is_compound_ct(inner_t) != 0 {
                    expr_option_inner_struct = compound_name_from_ann(inner_ann)
                } else {
                    expr_option_inner_struct = ""
                }
            }
        } else if ret_str == "List" {
            let elems_sl = node_elements(ta)
            if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
                let inner_ann = sublist_get(elems_sl, 0)
                let inner_name = node_name(inner_ann)
                let inner_t = type_from_name(inner_name)
                expr_list_elem_type = inner_t
                if is_struct_type(inner_name) != 0 || is_enum_type(inner_name) != 0 {
                    expr_list_elem_struct = strip_module_qualifier(inner_name)
                } else {
                    expr_list_elem_struct = ""
                }
            }
        }
    }
    ret_ct
}

pub fn find_from_impl(source: Str, target: Str) -> Int {
    let mut i = 0
    while i < from_entries.len() {
        let fe = from_entries.get(i).unwrap()
        if fe.source == source && fe.target == target {
            return fe.method_sl
        }
        i = i + 1
    }
    -1
}

pub fn find_tryfrom_impl(source: Str, target: Str) -> Int {
    let mut i = 0
    while i < tryfrom_entries.len() {
        let te = tryfrom_entries.get(i).unwrap()
        if te.source == source && te.target == target {
            return te.method_sl
        }
        i = i + 1
    }
    -1
}

pub fn impl_method_has_self(fn_node: Int) -> Int {
    if impl_method_self_name(fn_node) != "" {
        return 1
    }
    0
}

pub fn impl_method_self_name(fn_node: Int) -> Str {
    let params_sl = node_params(fn_node)
    if params_sl != -1 {
        let mut i = 0
        while i < sublist_length(params_sl) {
            let p = sublist_get(params_sl, i)
            let name = node_name(p)
            if name == "self" || name == "_self" {
                return name
            }
            i = i + 1
        }
    }
    ""
}

pub fn lookup_assoc_type(impl_type: Str, assoc_name: Str) -> Str {
    let mut i = 0
    while i < assoc_type_bindings.len() {
        let b = assoc_type_bindings.get(i).unwrap()
        if b.impl_type == impl_type && b.assoc_name == assoc_name {
            return b.concrete_type
        }
        i = i + 1
    }
    ""
}

pub fn resolve_self_type(ret_str: Str, impl_type: Str) -> Str {
    if ret_str == "Self" {
        return impl_type
    }
    if ret_str.starts_with("Self.") {
        let assoc_name = ret_str.substring(5, ret_str.len() - 5)
        let resolved = lookup_assoc_type(impl_type, assoc_name)
        if resolved != "" {
            return resolved
        }
    }
    ret_str
}

pub fn is_emitted_let(name: Str) -> Int {
    emitted_let_set.contains_key(name)
}

pub fn is_emitted_fn(name: Str) -> Int {
    emitted_fn_set.contains_key(name)
}

// ── Helpers ─────────────────────────────────────────────────────────

pub fn c_type_str(ct: Int) -> Str {
    if ct == CT_INT { "int64_t" }
    else if ct == CT_FLOAT { "double" }
    else if ct == CT_BOOL { "int" }
    else if ct == CT_STRING { "const char*" }
    else if ct == CT_LIST { "blink_list*" }
    else if ct == CT_CLOSURE { "blink_closure*" }
    else if ct == CT_ITERATOR { "void*" }
    else if ct == CT_HANDLE { "blink_handle*" }
    else if ct == CT_CHANNEL { "blink_channel*" }
    else if ct == CT_MAP { "blink_map*" }
    else if ct == CT_SET { "blink_set*" }
    else if ct == CT_BYTES { "blink_bytes*" }
    else if ct == CT_INSTANT { c_type_c_name("Instant") }
    else if ct == CT_DURATION { c_type_c_name("Duration") }
    else if ct == CT_PTR { "void*" }
    else if ct == CT_FFI_SCOPE { "blink_list*" }
    else if ct == CT_STRINGBUILDER { "blink_sb*" }
    else if ct == CT_HANDLER { "void*" }
    else if ct == CT_TEMPLATE { "blink_template*" }
    else if ct == CT_I8 { "int8_t" }
    else if ct == CT_I16 { "int16_t" }
    else if ct == CT_I32 { "int32_t" }
    else if ct == CT_U8 { "uint8_t" }
    else if ct == CT_U16 { "uint16_t" }
    else if ct == CT_U32 { "uint32_t" }
    else if ct == CT_U64 { "uint64_t" }
    else if ct == CT_CHAR { "int32_t" }
    else { "void" }
}

// c_type_str for a position that must have STORAGE — a struct field or an enum variant
// payload field. Identical to c_type_str except for a field whose type annotation
// resolved to the NAME "Void", where `void` is a legal return type but an illegal field
// type (`void v;` is a hard C error).
//
// br hsgsbp: Void is "an ordinary INHABITED, encodable type"
// (decisions/under-determined-types.md:39, 6-0), so `type P { v: Void }` and
// `Box[T=Void]` are both legal Blink and both have to lower. The placeholder is int64_t,
// NOT a second placeholder rule: the Result typedef emitter below already lowers a Void
// ok/err leaf to int64_t for exactly this reason, so a Void reached through
// `Result[Void, E]` and a Void reached through a field now agree.
//
// KEYED ON THE NAME, not on the CT, and that is the whole point of the second parameter.
// type_from_name collapses "Void", "" and every UNKNOWN name onto CT_VOID, so a CT-only
// predicate would also swallow an ERASED slot — turning today's loud `void v;` C error
// into a silent int64_t field. CLAUDE.md calls that loudness load-bearing ("a `void` field
// errors loudly but an erased carrier field does not"), and br 3aa3je's tuple-stem blind
// spot is detectable only because of it. So: exactly the name "Void" lowers; anything else
// that lands on CT_VOID keeps failing the C compile.
//
// Only the five emitters that declare a NAMED field route through here. A tuple element
// (emit_tuple_typedef) deliberately does not — it has no resolved name to key on, so it
// keeps c_type_str and stays loud; a Void tuple element is out of scope for br hsgsbp.
// Every other c_type_str caller is a return type, a parameter, or a local, where `void` is
// either correct (a void-returning fn) or a separate bug (`let x = void_fn()` emits
// `const void x = ...`, broken independently of anything generic — br 296hpm).
pub fn c_field_type_str(ct: Int, tname: Str) -> Str {
    if ct == CT_VOID && tname == "Void" { return "int64_t" }
    c_type_str(ct)
}

/// Return the static const blink_kops table name for a Map key.
/// For built-in K types: references runtime tables like blink_kops_i64.
/// For user struct K (with @derive(Hash, Eq)): references the
/// per-type kops_<mangled> table that codegen_derive emits.
pub fn kops_table_name(ct: Int, sname: Str) -> Str {
    if ct == CT_STRING { return "blink_kops_str" }
    if ct == CT_INT { return "blink_kops_i64" }
    if ct == CT_I8 { return "blink_kops_i8" }
    if ct == CT_I16 { return "blink_kops_i16" }
    if ct == CT_I32 { return "blink_kops_i32" }
    if ct == CT_U8 { return "blink_kops_u8" }
    if ct == CT_U16 { return "blink_kops_u16" }
    if ct == CT_U32 { return "blink_kops_u32" }
    if ct == CT_U64 { return "blink_kops_u64" }
    if ct == CT_BOOL { return "blink_kops_bool" }
    if ct == CT_CHAR { return "blink_kops_char" }
    if sname != "" && list_contains_str(derive_hash_types, sname) != 0 {
        return "kops_{c_type_c_name(sname)}"
    }
    // typecheck E1400 should have rejected unsupported K (Float/Double,
    // or a struct without @derive(Hash)). Reaching here means typecheck
    // and codegen disagree — emit an undefined C symbol so the C compiler
    // surfaces the broken site.
    "BLINK_COMPILER_BUG_kops_unsupported_K_ct{ct}_{sname}"
}

pub fn kops_is_struct_key(sname: Str) -> Bool {
    sname != "" && list_contains_str(derive_hash_types, sname) != 0
}

// True when a resolved Set/Map element name denotes a concrete type whose kops
// table can be selected at the Set()/Map() ctor site: a recognized primitive
// (type_from_name != CT_VOID) or a named struct/enum. Returns false for an
// unresolved typevar (e.g. a generic-struct field's `Set[T]`, which typecheck
// never monomorphizes) so the ctor keeps the string default and downstream
// recover_elem_ct_from_arg picks the real kops (br 6ph073/vbhc4x).
pub fn kops_elem_is_concrete(name: Str) -> Bool {
    if type_from_name(name) != CT_VOID { return true }
    is_named_type(name) != 0
}

/// Resolve a Map key type annotation to the C struct sname used by the kops
/// machinery, or "" for built-in K types (Str/Int/Bool/etc).
///
/// For tuple K (e.g. (Str, Int)): synthesizes the tuple struct via
/// resolve_tuple_ann and auto-registers it into derive_hash_types and
/// derive_eq_types so emit_struct_hash / emit_struct_eq pick it up and
/// the kops_<mangled> adapter table is emitted. Per spec §3.8: tuple Hash/Eq
/// are auto-derived structurally when all element types are themselves
/// Hash + Eq, with no user annotation required.
pub fn key_struct_sname_from_ann(k_ann: Int) -> Str ! Codegen.Emit {
    if k_ann == -1 { return "" }
    let kname = node_name(k_ann)
    if kname == "Tuple" {
        let opt = resolve_tuple_ann(k_ann, -1, [])
        if opt.is_none() { return "" }
        let c_name = opt.unwrap()
        let cn = c_type_c_name(c_name)
        if list_contains_str(derive_hash_types, c_name) == 0 {
            derive_hash_types.push(c_name)
            // Tuple K registration can happen mid fn-body codegen, after
            // emit_derive_forward_decls. Inject an extern decl at the use
            // site (valid in C block scope) so the kops symbol resolves;
            // emit_kops_adapters_late() emits the definition after fn bodies.
            emit_line("extern const blink_kops kops_{cn};")
        }
        if list_contains_str(derive_eq_types, c_name) == 0 {
            derive_eq_types.push(c_name)
        }
        return c_name
    }
    if is_named_type(kname) != 0 {
        return kname
    }
    // Non-data (C-style) enums are not in is_named_type but can serve as
    // Map keys when @derive(Hash, Eq) is present. They're already in
    // derive_hash_types thanks to register_derive_annotations.
    if is_enum_type(kname) != 0 {
        return kname
    }
    ""
}

// Register an already-resolved tuple C-name (e.g. "Tuple2_int_int") as a kops
// key when it isn't yet in derive_hash_types. The annotation path
// (key_struct_sname_from_ann) registers a tuple K from its `Tuple` annotation,
// but a generic-fn mono over a tuple key reaches the Set()/Map() ctor with the
// key already resolved to its C-name (the typevar substituted away), so that
// path is skipped and the tuple never joins the hash/eq derive lists — leaving
// kops_table_name to emit the BLINK_COMPILER_BUG sentinel (0sh55p, transitive
// case). Registering here triggers emit_struct_hash/eq + the kops adapter emit.
// Returns 1 when the name denotes a known tuple (registered or already present),
// 0 otherwise (leaves non-tuple names to the caller's existing handling).
pub fn ensure_tuple_kops_key(c_name: Str) -> Int {
    if find_tuple_entry(c_name) < 0 { return 0 }
    if list_contains_str(derive_hash_types, c_name) == 0 {
        derive_hash_types.push(c_name)
    }
    if list_contains_str(derive_eq_types, c_name) == 0 {
        derive_eq_types.push(c_name)
    }
    1
}

/// 1 if the kops table stores keys inline (key copied into slot, e.g. integers);
/// 0 if the slot holds a pointer (e.g. Str). Used to decide whether to materialize
/// a temp at insert/get/has/remove sites.
pub fn kops_is_inline_key(ct: Int) -> Int {
    if ct == CT_STRING { return 0 }
    1
}

pub fn ct_bit_width(ct: Int) -> Int {
    if ct == CT_I8 || ct == CT_U8 { 8 }
    else if ct == CT_I16 || ct == CT_U16 { 16 }
    else if ct == CT_I32 || ct == CT_U32 || ct == CT_CHAR { 32 }
    else { 64 }
}

/// C type name for unsigned arithmetic at the same bit width as `ct`.
/// Used by wrapping_* methods — round-trip values through the unsigned type to
/// get well-defined modular C semantics.
pub fn wrapping_unsigned_c_type(ct: Int) -> Str {
    if ct == CT_I8 || ct == CT_U8 { "uint8_t" }
    else if ct == CT_I16 || ct == CT_U16 { "uint16_t" }
    else if ct == CT_I32 || ct == CT_U32 { "uint32_t" }
    else { "uint64_t" }
}

pub fn is_sized_int_ct(ct: Int) -> Int {
    if ct == CT_I8 || ct == CT_I16 || ct == CT_I32 { return 1 }
    if ct == CT_U8 || ct == CT_U16 || ct == CT_U32 || ct == CT_U64 { return 1 }
    0
}

pub fn is_hash_scalar_ct(ct: Int) -> Int {
    if ct == CT_INT || ct == CT_BOOL || ct == CT_CHAR { return 1 }
    is_sized_int_ct(ct)
}

pub fn ptr_inner_c_type(name: Str) -> Str {
    if is_struct_type(name) != 0 {
        return c_type_c_name(name)
    }
    match name {
        "Void" => "void"
        "U8" => "uint8_t"
        "U16" => "uint16_t"
        "U32" => "uint32_t"
        "U64" => "uint64_t"
        "I8" => "int8_t"
        "I16" => "int16_t"
        "I32" => "int32_t"
        "I64" => "int64_t"
        "Int" => "int64_t"
        "Float" => "double"
        _ => "void"
    }
}

pub fn resolve_ptr_inner_c() -> Str {
    if cg_let_target_ann != -1 {
        let ta_elems = node_elements(cg_let_target_ann)
        if ta_elems != -1 && sublist_length(ta_elems) > 0 {
            return ptr_inner_c_type(node_name(sublist_get(ta_elems, 0)))
        }
    }
    "void"
}

pub fn strip_module_qualifier(name: Str) -> Str {
    let dot_pos = name.index_of(".")
    if dot_pos >= 0 {
        return name.substr(dot_pos + 1, name.len() - dot_pos - 1)
    }
    name
}

// The base name of a possibly-generic type-name string: `Tree[T]` → `Tree`,
// `Tree` → `Tree`. The enum variant-field registry stores a self-recursive field's
// type via build_type_name_from_ann (which keeps the `[T]` args), so the ctor/match
// self-recursion checks compare on the base alone (jjhnf3). Shared by codegen_expr
// (ctor) and codegen_stmt (match).
pub fn strip_generic_args(name: Str) -> Str {
    let bracket_pos = name.index_of("[")
    if bracket_pos < 0 { return name }
    name.substr(0, bracket_pos)
}

// Canonical carrier-tag for a struct/enum named `name`. Derives from the
// canonical C name (`c_type_c_name`) so that user-defined `Row` (no module
// prefix → "Row") and stdlib `std.db.row.Row` (prefix → "std_db_row_Row")
// yield DISTINCT compound-carrier tags. Used in `blink_Option_<tag>`,
// `blink_Result_<tag>_<tag>` and `blink_List_<tag>` so the same Blink
// unqualified name in two modules does not collide at link time.
//
// Idempotent: if `name` is already a canonical tag (e.g. "std_db_row_Row"),
// `c_type_c_name` strips no prefix and we return the input unchanged.
pub fn strip_blink_prefix(c_name: Str) -> Str {
    if c_name.starts_with("blink_") {
        return c_name.slice(6, c_name.len())
    }
    c_name
}

pub fn c_type_tag_for_struct(name: Str) -> Str {
    strip_blink_prefix(c_type_c_name(name))
}

pub fn type_from_name(name: Str) -> Int {
    let bracket_pos = name.index_of("[")
    let mut base = name
    if bracket_pos >= 0 {
        base = name.substr(0, bracket_pos)
    }
    base = strip_module_qualifier(base)
    if type_alias_base.contains_key(base) {
        base = type_alias_base.get(base).unwrap()
    }
    match base {
        "Int" => CT_INT
        "Str" => CT_STRING
        "Float" => CT_FLOAT
        "Bool" => CT_BOOL
        "List" => CT_LIST
        "Option" => CT_OPTION
        "Result" => CT_RESULT
        "Iterator" => CT_ITERATOR
        "Map" => CT_MAP
        "Set" => CT_SET
        "Bytes" => CT_BYTES
        "Instant" => CT_INSTANT
        "Duration" => CT_DURATION
        "Ptr" => CT_PTR
        "StringBuilder" => CT_STRINGBUILDER
        "Fn" => CT_CLOSURE
        "Channel" => CT_CHANNEL
        "Handle" => CT_HANDLE
        "Handler" => CT_HANDLER
        "Template" => CT_TEMPLATE
        "I8" => CT_I8
        "I16" => CT_I16
        "I32" => CT_I32
        "I64" => CT_INT
        "U8" => CT_U8
        "U16" => CT_U16
        "U32" => CT_U32
        "U64" => CT_U64
        "Char" => CT_CHAR
        _ => CT_VOID
    }
}

pub fn option_c_type(inner: Int) -> Str {
    "blink_Option_{c_type_tag(inner)}"
}

pub fn struct_option_c_type(struct_name: Str) -> Str {
    "blink_Option_{canonical_struct_tag(struct_name)}"
}

pub fn result_c_type(ok_t: Int, err_t: Int) -> Str {
    "blink_Result_{c_type_tag(ok_t)}_{c_type_tag(err_t)}"
}

pub fn struct_result_c_type(ok_name: Str, err_name: Str) -> Str {
    "blink_Result_{canonical_struct_tag(ok_name)}_{canonical_struct_tag(err_name)}"
}

pub fn result_c_type_mixed(ok_t: Int, err_t: Int, ok_struct: Str, err_struct: Str) -> Str {
    let ok_tag = if ok_struct != "" { canonical_struct_tag(ok_struct) } else { c_type_tag(ok_t) }
    let err_tag = if err_struct != "" { canonical_struct_tag(err_struct) } else { c_type_tag(err_t) }
    "blink_Result_{ok_tag}_{err_tag}"
}

pub fn option_c_type_mixed(inner: Int, inner_struct: Str) -> Str {
    if inner_struct != "" {
        "blink_Option_{canonical_struct_tag(inner_struct)}"
    } else {
        "blink_Option_{c_type_tag(inner)}"
    }
}

pub fn option_inner_struct_from_tag(tag: Str) -> Str {
    if !tag.starts_with("Option_") { return "" }
    typedef_tag_or_empty(tag.slice(7, tag.len()))
}

pub fn option_inner_ct_from_tag(tag: Str) -> Int {
    if !tag.starts_with("Option_") { return CT_VOID }
    let inner = tag.slice(7, tag.len())
    if is_struct_type(inner) != 0 || is_enum_type(inner) != 0 { return CT_INT }
    if inner.starts_with("Option_") { return CT_OPTION }
    if inner.starts_with("Result_") { return CT_RESULT }
    if inner.starts_with("Map_") { return CT_MAP }
    type_from_name_tag(inner)
}

pub fn canonical_struct_tag(tag: Str) -> Str {
    if tag == "" { return tag }
    if tag.starts_with("Option_") {
        let inner = tag.slice(7, tag.len())
        return "Option_{canonical_struct_tag(inner)}"
    }
    if tag.starts_with("Result_") {
        let rest = tag.slice(7, tag.len())
        let mut k = rest.len() - 1
        let mut sep = -1
        while k > 0 {
            if rest.byte_at(k) == 95 {
                let candidate_err = rest.slice(k + 1, rest.len())
                if is_named_typedef_tag(candidate_err) != 0 || type_from_name_tag(candidate_err) != CT_VOID {
                    sep = k
                    k = 0
                }
            }
            k = k - 1
        }
        if sep < 0 {
            let mut j = rest.len() - 1
            while j > 0 {
                if rest.byte_at(j) == 95 {
                    sep = j
                    j = 0
                } else {
                    j = j - 1
                }
            }
        }
        if sep > 0 {
            let ok = rest.slice(0, sep)
            let err = rest.slice(sep + 1, rest.len())
            return "Result_{canonical_struct_tag(ok)}_{canonical_struct_tag(err)}"
        }
        return tag
    }
    if tag.starts_with("Map_") { return tag }
    if is_struct_type(tag) != 0 || is_enum_type(tag) != 0 {
        return c_type_tag_for_struct(tag)
    }
    tag
}

pub fn tuple_c_type_name(elem_tags: Str, arity: Int) -> Str {
    "Tuple{arity}_{elem_tags}"
}

pub fn find_tuple_entry(c_name: Str) -> Int {
    if emitted_tuple_set.contains_key(c_name) == 0 {
        return -1
    }
    emitted_tuple_set.get(c_name).unwrap()
}

// Element count of an emitted tuple struct tag, or -1 when the tag names no
// known tuple. Lets a caller split a tuple-typed scrutinee into per-element
// `._i` field accesses without importing the TupleEntry internals.
pub fn tuple_struct_arity(c_name: Str) -> Int {
    let idx = find_tuple_entry(c_name)
    if idx < 0 { return -1 }
    emitted_tuple_entries.get(idx).unwrap().arity
}

// Element CT of tuple tag `c_name` at position `idx`, or CT_VOID if unknown.
pub fn tuple_elem_ct(c_name: Str, idx: Int) -> Int {
    let e = find_tuple_entry(c_name)
    if e < 0 { return CT_VOID }
    get_tuple_entry_elem_type(emitted_tuple_entries.get(e).unwrap().elem_types, idx)
}

// Element struct/compound tag of tuple tag `c_name` at position `idx`, or ""
// when the element is a scalar (no named struct).
pub fn tuple_elem_struct(c_name: Str, idx: Int) -> Str {
    let e = find_tuple_entry(c_name)
    if e < 0 { return "" }
    get_tuple_entry_elem_struct(emitted_tuple_entries.get(e).unwrap().elem_structs, idx)
}

pub fn ensure_tuple_type(c_name: Str, arity: Int, elem_types: Str, elem_structs: Str) {
    if emitted_tuple_set.contains_key(c_name) != 0 {
        return
    }
    emitted_tuple_set.insert(c_name, emitted_tuple_entries.len())
    emitted_tuple_entries.push(TupleEntry { c_name: c_name, arity: arity, elem_types: elem_types, elem_structs: elem_structs })
    struct_reg_names.push(c_name)
    struct_reg_set.insert(c_name, 1)
    let mut i = 0
    while i < arity {
        let et = get_tuple_entry_elem_type(elem_types, i)
        let es = get_tuple_entry_elem_struct(elem_structs, i)
        let fname = "_{i}"
        if es != "" {
            reg_sf_entry(c_name, fname, CT_VOID, es, sv_tp(CT_VOID, -1, -1, es))
        } else {
            reg_sf_entry(c_name, fname, et, "", sv_tp(et, -1, -1, ""))
        }
        i = i + 1
    }
}

pub let mut tuple_typedef_emitted: Map[Str, Int] = Map()

// A struct-result/option typedef embeds its inner tag BY VALUE, so when that
// inner is a tuple the tuple's typedef must precede it in the C output. The
// global emit order (option/result before tuples) handles the common case of
// a tuple embedding a compound, but not the reverse. Emit the tuple eagerly
// here; the BLINK_TD_ guard + this set keep it idempotent regardless of order.
pub fn emit_tuple_typedef_for_tag(tag: Str) ! Codegen.Emit {
    match emitted_tuple_set.get(tag) {
        Some(idx) => emit_tuple_typedef(emitted_tuple_entries.get(idx).unwrap())
        None => {}
    }
}

// A tuple element that is Option[T]/Result[T,E] embeds its carrier typedef
// (blink_Option_Cmd / blink_Result_int_str) BY VALUE, so that carrier must be
// declared before the tuple typedef. The global flush emits option/result
// carriers before tuples, but the per-flush passes (flush_mono_fns_with_typedefs,
// the fn-body flush) emit tuples first, and a carrier may be registered in the
// same window; so recurse into the carrier the way emit_tuple_typedef already
// recurses into nested-tuple deps. Mirrors the reverse dependency already coded
// in emit_struct_option/result_typedef (which emit their inner tuple). Each
// emitter dedups via option/result_typedef_emitted, so this is idempotent
// regardless of emit order (mn55f7).
fn emit_carrier_typedef_for_tag(tag: Str) ! Codegen.Emit {
    if tag.starts_with("Option_") {
        let inner = tag.slice(7, tag.len())
        let inner_ct = type_from_name_tag(inner)
        // Take the scalar emit_option_typedef path ONLY when the inner is a
        // NON-compound scalar with a concrete CT. A compound inner (Map_str_int,
        // Option_int, Result_list_int) has type_from_name_tag → CT_MAP/CT_OPTION/
        // CT_RESULT (non-VOID), which the old inner_ct != CT_VOID gate wrongly sent
        // down the scalar path — emitting a bare blink_Option_map / blink_Option_option
        // and NEVER the structured blink_Option_Map_str_int, so the by-value member
        // stayed undeclared (read as int) in the enclosing tuple (br yavhwc). Mirrors
        // the Result branch's both_scalar gate below; emit_struct_option_typedef
        // recurses into the inner compound carrier first.
        if inner_ct != CT_VOID && is_compound_tag(inner) == 0 {
            emit_option_typedef(inner_ct)
        } else {
            emit_struct_option_typedef(inner)
        }
    } else if tag.starts_with("Result_") {
        let parts = split_result_compound(canonical_struct_tag(tag))
        if parts.second != "" {
            // Take the scalar emit_result_typedef path ONLY when both parts are
            // non-compound scalars with a concrete CT. A compound-inner part (e.g.
            // Option_Box_Int) has type_from_name_tag → CT_OPTION (non-VOID), which
            // the old ok_ct != CT_VOID gate wrongly sent down the scalar path —
            // emitting a bogus blink_Result_option_str and never recursing into the
            // inner carrier. A struct-instance part (CT_VOID) likewise needs the
            // struct path. Everything else routes to emit_struct_result_typedef,
            // whose compound recursion (br gw4cyh) emits the inner carrier first.
            let ok_ct = type_from_name_tag(parts.first)
            let err_ct = type_from_name_tag(parts.second)
            let both_scalar = is_compound_tag(parts.first) == 0 && is_compound_tag(parts.second) == 0 && ok_ct != CT_VOID && err_ct != CT_VOID
            if both_scalar {
                emit_result_typedef(ok_ct, err_ct)
            } else {
                emit_struct_result_typedef(parts.first, parts.second)
            }
        }
    }
}

fn emit_tuple_typedef(entry: TupleEntry) ! Codegen.Emit {
    if tuple_typedef_emitted.contains_key(entry.c_name) != 0 { return }
    tuple_typedef_emitted.insert(entry.c_name, 1)
    // A nested-tuple element is embedded BY VALUE (its c_name lands in the `es`
    // slot), so its typedef must precede this one. The global catch-all flush
    // iterates in insertion order (inner registered before outer), but eager
    // callers (emit_top_level_let, emit_struct_result/option_typedef) emit a
    // single tag out of that order, leaving the by-value inner undeclared. Recurse
    // into embedded tuples first; the BLINK_TD_ guard keeps it idempotent.
    let mut d = 0
    while d < entry.arity {
        let dep = get_tuple_entry_elem_struct(entry.elem_structs, d)
        if dep != "" && find_tuple_entry(dep) >= 0 {
            emit_tuple_typedef(emitted_tuple_entries.get(find_tuple_entry(dep)).unwrap())
        } else if dep != "" && (dep.starts_with("Option_") || dep.starts_with("Result_")) {
            // An Option[T]/Result[T,E] element embeds its carrier typedef by
            // value; emit the carrier before this tuple (mn55f7).
            emit_carrier_typedef_for_tag(dep)
        }
        d = d + 1
    }
    emit_td_guard_open(c_type_c_name(entry.c_name))
    emit_line("typedef struct \{")
    cg_indent = cg_indent + 1
    let mut i = 0
    while i < entry.arity {
        let et = get_tuple_entry_elem_type(entry.elem_types, i)
        let es = get_tuple_entry_elem_struct(entry.elem_structs, i)
        let fname = "_{i}"
        if es != "" {
            emit_line("{c_type_c_name(es)} {fname};")
        } else {
            emit_line("{c_type_str(et)} {fname};")
        }
        i = i + 1
    }
    cg_indent = cg_indent - 1
    emit_line("} {c_type_c_name(entry.c_name)};")
    emit_td_guard_close()
    emit_line("")
}

pub fn emit_all_tuple_types() ! Codegen.Emit {
    let mut i = 0
    while i < emitted_tuple_entries.len() {
        emit_tuple_typedef(emitted_tuple_entries.get(i).unwrap())
        i = i + 1
    }
}

pub fn emit_tuple_types_from(start: Int) ! Codegen.Emit {
    let mut i = start
    while i < emitted_tuple_entries.len() {
        emit_tuple_typedef(emitted_tuple_entries.get(i).unwrap())
        i = i + 1
    }
}

fn get_tuple_entry_elem_type(encoded: Str, idx: Int) -> Int {
    let mut sep_count = 0
    let mut start = 0
    let mut i = 0
    while i < encoded.len() {
        if encoded.byte_at(i) == 44 { // ','
            if sep_count == idx {
                let part = encoded.substring(start, i - start)
                return part.to_int()
            }
            sep_count = sep_count + 1
            start = i + 1
        }
        i = i + 1
    }
    if sep_count == idx {
        let part = encoded.substring(start, encoded.len() - start)
        return part.to_int()
    }
    CT_VOID
}

fn get_tuple_entry_elem_struct(encoded: Str, idx: Int) -> Str {
    let mut sep_count = 0
    let mut start = 0
    let mut i = 0
    while i < encoded.len() {
        if encoded.byte_at(i) == 44 { // ','
            if sep_count == idx {
                let part = encoded.substring(start, i - start)
                if part == "-" { return "" }
                return part
            }
            sep_count = sep_count + 1
            start = i + 1
        }
        i = i + 1
    }
    if sep_count == idx {
        let part = encoded.substring(start, encoded.len() - start)
        if part == "-" { return "" }
        return part
    }
    ""
}

pub fn c_type_tag(ct: Int) -> Str {
    if ct == CT_INT { "int" }
    else if ct == CT_FLOAT { "double" }
    else if ct == CT_BOOL { "bool" }
    else if ct == CT_STRING { "str" }
    else if ct == CT_LIST { "list" }
    else if ct == CT_ITERATOR { "iter" }
    else if ct == CT_HANDLE { "handle" }
    else if ct == CT_CHANNEL { "channel" }
    else if ct == CT_MAP { "map" }
    else if ct == CT_SET { "set" }
    else if ct == CT_BYTES { "bytes" }
    else if ct == CT_STRINGBUILDER { "stringbuilder" }
    else if ct == CT_PTR { "ptr" }
    else if ct == CT_OPTION { "option" }
    else if ct == CT_RESULT { "result" }
    else if ct == CT_TEMPLATE { "template" }
    else if ct == CT_I8 { "i8" }
    else if ct == CT_I16 { "i16" }
    else if ct == CT_I32 { "i32" }
    else if ct == CT_U8 { "u8" }
    else if ct == CT_U16 { "u16" }
    else if ct == CT_U32 { "u32" }
    else if ct == CT_U64 { "u64" }
    else if ct == CT_CHAR { "char" }
    else { "void" }
}

pub fn is_compound_ct(ct: Int) -> Int {
    if ct == CT_OPTION || ct == CT_RESULT || ct == CT_MAP {
        1
    } else {
        0
    }
}

// whg65a: the carrier tag for a tp node, recursing into nested containers so a
// deep element type spells its full layout — `Option[Map[Int,Str]]` →
// `Option_Map_int_str`, `Result[Map[Int,Str],Str]` → `Result_Map_int_str_str`,
// `Option[List[Int]]` → `Option_list`. The tp_pool twin of typecheck's
// tc_tid_inner_tag (which walks the ty_pool). This is the single source of the
// carrier name for `List[compound]` get()/pop()/for-in and the HOF iterator path,
// replacing the lossy one-level `c_type_tag(inner_ct)` spellings (which erase a
// Map's K/V to the bare `map` tag). A struct/enum node uses its C struct tag; a
// bare scalar its c_type_tag.
pub fn tp_carrier_tag(id: Int) -> Str {
    if id < 0 { return "void" }
    let kind = tp_get_kind(id)
    let sname = tp_get_sname(id)
    if kind == CT_STRUCT || kind == CT_ENUM {
        if sname != "" { return c_type_tag_for_struct(sname) }
        return "void"
    }
    if kind == CT_OPTION {
        return "Option_{tp_carrier_tag(tp_get_child1(id))}"
    }
    if kind == CT_RESULT {
        return "Result_{tp_carrier_tag(tp_get_child1(id))}_{tp_carrier_tag(tp_get_child2(id))}"
    }
    if kind == CT_MAP {
        return "Map_{tp_carrier_tag(tp_get_child1(id))}_{tp_carrier_tag(tp_get_child2(id))}"
    }
    // List/Set/Iterator and all scalars are pointer-boxed / by-value under a
    // single flat tag — the inner element travels via the var's map/list-elem
    // metadata channels, not the carrier tag (mirrors the existing `Option_list`
    // spelling for List[Option[List[T]]]).
    c_type_tag(kind)
}

// Canonical tuple tag (e.g. `Tuple2_int_bytes`) for a tuple annotation, or ""
// if `ann` isn't a tuple. type_from_name("Tuple") is CT_VOID, so the compound
// resolvers can't recognize tuples by CT — they dispatch on the annotation
// node name and delegate here. Also registers the tuple struct as a side
// effect (resolve_tuple_ann → ensure_tuple_type), matching the non-? path.
fn resolve_tuple_tag(ann: Int) -> Str {
    if node_name(ann) != "Tuple" { return "" }
    let opt = resolve_tuple_ann(ann, -1, [])
    if opt.is_some() { return opt.unwrap() }
    ""
}

fn resolve_ann_tag(ann: Int, name: Str) -> Str {
    let ct = type_from_name(name)
    if node_name(ann) == "Tuple" {
        let t = resolve_tuple_tag(ann)
        if t != "" { return t }
        return c_type_tag(ct)
    }
    if is_compound_ct(ct) != 0 {
        return compound_name_from_ann(ann)
    }
    if is_struct_type(name) != 0 || is_enum_type(name) != 0 {
        let mono = mono_name_from_ann(strip_module_qualifier(name), ann, -1, [])
        if mono != "" { return mono }
        return strip_module_qualifier(name)
    }
    c_type_tag(ct)
}

pub fn compound_name_from_ann(ann_node: Int) -> Str {
    let name = node_name(ann_node)
    let ct = type_from_name(name)
    if ct == CT_RESULT {
        let inner_elems = node_elements(ann_node)
        if inner_elems != -1 && sublist_length(inner_elems) >= 2 {
            let ok_ann = sublist_get(inner_elems, 0)
            let err_ann = sublist_get(inner_elems, 1)
            let ok_name = node_name(ok_ann)
            let err_name = node_name(err_ann)
            let ok_tag = resolve_ann_tag(ok_ann, ok_name)
            let err_tag = resolve_ann_tag(err_ann, err_name)
            return "Result_{ok_tag}_{err_tag}"
        }
        "Result_int_str"
    } else if ct == CT_OPTION {
        let inner_elems = node_elements(ann_node)
        if inner_elems != -1 && sublist_length(inner_elems) >= 1 {
            let inner_ann2 = sublist_get(inner_elems, 0)
            let inner_name2 = node_name(inner_ann2)
            let inner_tag = resolve_ann_tag(inner_ann2, inner_name2)
            return "Option_{inner_tag}"
        }
        "Option_int"
    } else if ct == CT_MAP {
        let inner_elems = node_elements(ann_node)
        if inner_elems != -1 && sublist_length(inner_elems) >= 2 {
            let key_ann = sublist_get(inner_elems, 0)
            let val_ann = sublist_get(inner_elems, 1)
            let key_name = node_name(key_ann)
            let val_name = node_name(val_ann)
            let key_tag = resolve_ann_tag(key_ann, key_name)
            let val_tag = resolve_ann_tag(val_ann, val_name)
            return "Map_{key_tag}_{val_tag}"
        }
        "map"
    } else if name == "Tuple" {
        let t = resolve_tuple_tag(ann_node)
        if t != "" { return t }
        return c_type_tag(ct)
    } else {
        c_type_tag(ct)
    }
}

pub fn compound_option_inner_name(inner_type: Int, inner_str: Str) -> Str {
    if inner_type == CT_RESULT {
        let ok_t = get_var_result_ok(inner_str)
        let err_t = get_var_result_err(inner_str)
        let ok_s = get_var_result_ok_struct(inner_str)
        let err_s = get_var_result_err_struct(inner_str)
        let ok_tag = if ok_s != "" { ok_s } else { c_type_tag(ok_t) }
        let err_tag = if err_s != "" { err_s } else { c_type_tag(err_t) }
        "Result_{ok_tag}_{err_tag}"
    } else if inner_type == CT_OPTION {
        let opt_inner = get_var_option_inner(inner_str)
        let opt_inner_s = get_var_option_inner_struct(inner_str)
        let inner_tag = if opt_inner_s != "" { opt_inner_s } else { c_type_tag(opt_inner) }
        "Option_{inner_tag}"
    } else if inner_type == CT_MAP {
        "map"
    } else {
        c_type_tag(inner_type)
    }
}

fn ct_from_str(s: Str) -> Int {
    if s == "0" { CT_INT }
    else if s == "1" { CT_FLOAT }
    else if s == "2" { CT_BOOL }
    else if s == "3" { CT_STRING }
    else if s == "4" { CT_LIST }
    else if s == "5" { CT_VOID }
    else if s == "7" { CT_OPTION }
    else if s == "8" { CT_RESULT }
    else if s == "9" { CT_ITERATOR }
    else if s == "10" { CT_HANDLE }
    else if s == "11" { CT_CHANNEL }
    else if s == "13" { CT_MAP }
    else if s == "14" { CT_BYTES }
    else if s == "17" { CT_PTR }
    else if s == "19" { CT_STRINGBUILDER }
    else if s == "20" { CT_SET }
    else { CT_INT }
}

pub fn ensure_option_type(inner: Int) {
    let key = "{inner}"
    if emitted_option_set.contains_key(key) != 0 {
        return
    }
    emitted_option_set.insert(key, 1)
    emitted_option_types.push(inner)
}

// Ensure the carrier typedef for a canonical compound tag (Option_<inner>,
// Result_<ok>_<err>) is registered for emission. Used when a generic typevar is
// bound to a whole Option/Result: the resolved name is the tag, not an
// annotation node. A SCALAR inner must route to the inline ensurer
// (ensure_option_type / ensure_result_type) so the carrier keeps `int64_t
// value`; only a struct/enum inner uses the pointer-boxing struct-carrier path.
// The two paths share the `blink_Option_int` typedef name under one dedup guard,
// so mis-routing a scalar to the struct path would emit `int64_t* value` and
// diverge from every scalar Option construct/unwrap. Map tags need no ensure
// (uniform blink_map*). Idempotent via the ensure_* dedup sets.
pub fn ensure_carrier_from_tag(tag: Str) {
    if tag.starts_with("Option_") {
        let inner = tag.slice(7, tag.len())
        let inner_ct = type_from_name_tag(inner)
        if inner_ct != CT_VOID {
            ensure_option_type(inner_ct)
        } else {
            ensure_struct_option_type(inner)
        }
    } else if tag.starts_with("Result_") {
        let parts = split_result_compound(canonical_struct_tag(tag))
        if parts.second != "" {
            let ok_ct = type_from_name_tag(parts.first)
            let err_ct = type_from_name_tag(parts.second)
            if ok_ct != CT_VOID && err_ct != CT_VOID {
                ensure_result_type(ok_ct, err_ct)
            } else {
                ensure_struct_result_type(parts.first, parts.second)
            }
        }
    }
}

pub fn ensure_struct_option_type(struct_name: Str) {
    let tag = canonical_struct_tag(struct_name)
    let key = "s_{tag}"
    if emitted_option_set.contains_key(key) != 0 {
        return
    }
    emitted_option_set.insert(key, 1)
    emitted_struct_option_types.push(tag)
}

pub fn ensure_result_type(ok_t: Int, err_t: Int) {
    let key = "{ok_t}_{err_t}"
    if emitted_result_set.contains_key(key) != 0 {
        return
    }
    emitted_result_set.insert(key, 1)
    emitted_result_types.push(key)
}

pub fn ensure_struct_result_type(ok_name: Str, err_name: Str) {
    let ok_tag = canonical_struct_tag(ok_name)
    let err_tag = canonical_struct_tag(err_name)
    // Use '~' separator (invalid in C identifiers) so multi-underscore
    // canonical tags like `std_db_row_Row` don't ambiguously split on `_`.
    let key = "s~{ok_tag}~{err_tag}"
    if emitted_result_set.contains_key(key) != 0 {
        return
    }
    emitted_result_set.insert(key, 1)
    emitted_struct_result_types.push(key)
    let ok_ct = type_from_name_tag(ok_tag)
    let err_ct = type_from_name_tag(err_tag)
    if ok_ct != CT_VOID && err_ct != CT_VOID {
        let prim_key = "{ok_ct}_{err_ct}"
        emitted_result_set.insert(prim_key, 1)
    }
}

pub fn ensure_mixed_result_type(ok_t: Int, err_t: Int, ok_struct: Str, err_struct: Str) {
    if ok_struct != "" || err_struct != "" {
        let ok_tag = if ok_struct != "" { ok_struct } else { c_type_tag(ok_t) }
        let err_tag = if err_struct != "" { err_struct } else { c_type_tag(err_t) }
        ensure_struct_result_type(ok_tag, err_tag)
    } else {
        ensure_result_type(ok_t, err_t)
    }
}

fn ensure_mixed_option_type(inner: Int, inner_struct: Str) {
    if inner_struct != "" {
        ensure_struct_option_type(inner_struct)
    } else {
        ensure_option_type(inner)
    }
}

pub fn resolve_result_inner_tag(ann: Int, name: Str, ct: Int) -> Str {
    if node_name(ann) == "Tuple" {
        // A tuple OK/Err side would otherwise fall through to "" and erase its
        // element types; "" is also the correct sentinel if it's not a tuple.
        return resolve_tuple_tag(ann)
    }
    if is_compound_ct(ct) != 0 {
        return compound_name_from_ann(ann)
    }
    if is_struct_type(name) != 0 || is_enum_type(name) != 0 {
        let mono = mono_name_from_ann(strip_module_qualifier(name), ann, -1, [])
        if mono != "" { return mono }
        return strip_module_qualifier(name)
    }
    ""
}

pub fn ensure_compound_type_from_ann(ann_node: Int) {
    let name = node_name(ann_node)
    let ct = type_from_name(name)
    if ct == CT_OPTION {
        let inner_elems = node_elements(ann_node)
        if inner_elems != -1 && sublist_length(inner_elems) >= 1 {
            let inner_ann = sublist_get(inner_elems, 0)
            let inner_name = node_name(inner_ann)
            let inner_t = type_from_name(inner_name)
            if is_struct_type(inner_name) != 0 || is_enum_type(inner_name) != 0 {
                // br bee854: queue the carrier under the mono stem (QBox_Int) so the
                // typedef name matches the tid path; "" keeps the bare head.
                let mono = mono_name_from_ann(strip_module_qualifier(inner_name), inner_ann, -1, [])
                let tag = if mono != "" { mono } else { strip_module_qualifier(inner_name) }
                ensure_struct_option_type(tag)
            } else if is_compound_ct(inner_t) != 0 {
                ensure_compound_type_from_ann(inner_ann)
                ensure_struct_option_type(compound_name_from_ann(inner_ann))
            } else if inner_name == "Tuple" {
                let tuple_tag = resolve_tuple_tag(inner_ann)
                if tuple_tag != "" {
                    ensure_struct_option_type(tuple_tag)
                } else {
                    ensure_option_type(inner_t)
                }
            } else {
                ensure_option_type(inner_t)
            }
        }
    } else if ct == CT_RESULT {
        let inner_elems = node_elements(ann_node)
        if inner_elems != -1 && sublist_length(inner_elems) >= 2 {
            let ok_ann = sublist_get(inner_elems, 0)
            let err_ann = sublist_get(inner_elems, 1)
            let ok_name = node_name(ok_ann)
            let err_name = node_name(err_ann)
            let ok_t = type_from_name(ok_name)
            let err_t = type_from_name(err_name)
            if is_compound_ct(ok_t) != 0 {
                ensure_compound_type_from_ann(ok_ann)
            }
            if is_compound_ct(err_t) != 0 {
                ensure_compound_type_from_ann(err_ann)
            }
            let ok_r = resolve_result_inner_tag(ok_ann, ok_name, ok_t)
            let err_r = resolve_result_inner_tag(err_ann, err_name, err_t)
            let ok_tag = if ok_r != "" { ok_r } else { c_type_tag(ok_t) }
            let err_tag = if err_r != "" { err_r } else { c_type_tag(err_t) }
            ensure_struct_result_type(ok_tag, err_tag)
        }
    }
}

pub fn set_var_option(name: Str, inner: Int) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_OPTION {
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: inner, inner2: sv.inner2, sname: sv.sname, sname2: sv.sname2, extra: sv.extra, tp_id: sv_tp(sv.ctype, inner, sv.inner2, sv.sname) })
            return
        }
        i = i - 1
    }
    push_scope_var(ScopeVar { name: name, ctype: CT_OPTION, is_mut: 0, inner1: inner, inner2: -1, sname: "", sname2: "", extra: "", tp_id: sv_tp(CT_OPTION, inner, -1, "") })
}

pub fn set_var_option_inner2(name: Str, val: Int) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_OPTION {
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: sv.inner1, inner2: val, sname: sv.sname, sname2: sv.sname2, extra: sv.extra, tp_id: sv_tp(sv.ctype, sv.inner1, val, sv.sname) })
            return
        }
        i = i - 1
    }
}

pub fn get_var_option_inner2(name: Str) -> Int {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_OPTION {
            return sv.inner2
        }
        i = i - 1
    }
    let blink_name = c_blink_name(name)
    if blink_name != name {
        i = scope_vars.len() - 1
        while i >= 0 {
            let sv = scope_vars.get(i).unwrap()
            if sv.name == blink_name && tp_get_kind(sv.tp_id) == CT_OPTION {
                return sv.inner2
            }
            i = i - 1
        }
    }
    -1
}

pub fn set_var_option_inner2_struct(name: Str, struct_name: Str) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_OPTION {
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: sv.inner1, inner2: sv.inner2, sname: sv.sname, sname2: sv.sname2, extra: struct_name, tp_id: sv.tp_id })
            return
        }
        i = i - 1
    }
}

// whg65a: stamp a deep inner tp onto an Option var by rebuilding its tp_id as
// `type_option(<inner_tp>)`. Lets `Option[Map[K,V]]` / `Option[List[T]]` keep the
// inner container's full type params on the var itself, so a later Ident-read can
// restore expr_option_inner_tp and the match arm decodes the Map's V / List's T.
// The flat set_var_option/_struct path can only store one inner CT/struct.
pub fn set_var_option_inner_tp(name: Str, inner_tp: Int) {
    if inner_tp < 0 { return }
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_OPTION {
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: sv.inner1, inner2: sv.inner2, sname: sv.sname, sname2: sv.sname2, extra: sv.extra, tp_id: type_option(inner_tp) })
            return
        }
        i = i - 1
    }
}

// whg65a: the deep inner tp NODE of an Option var (child1 of its option tp_id),
// but ONLY when that inner is itself a container (Map/List/Result) — a plain
// scalar/struct inner is already carried by the flat inner1/extra channels, so
// return -1 there to avoid disturbing the existing paths.
pub fn get_var_option_inner_tp(name: Str) -> Int {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_OPTION {
            let c1 = tp_get_child1(sv.tp_id)
            if c1 >= 0 {
                let k = tp_get_kind(c1)
                if k == CT_MAP || k == CT_LIST || k == CT_RESULT || k == CT_OPTION || k == CT_SET {
                    return c1
                }
            }
            return -1
        }
        i = i - 1
    }
    -1
}

pub fn get_var_option_inner2_struct(name: Str) -> Str {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_OPTION && sv.extra != "" {
            return sv.extra
        }
        i = i - 1
    }
    let blink_name = c_blink_name(name)
    if blink_name != name {
        i = scope_vars.len() - 1
        while i >= 0 {
            let sv = scope_vars.get(i).unwrap()
            if sv.name == blink_name && tp_get_kind(sv.tp_id) == CT_OPTION && sv.extra != "" {
                return sv.extra
            }
            i = i - 1
        }
    }
    ""
}

pub fn set_var_option_struct(name: Str, inner: Int, struct_name: Str) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_OPTION {
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: inner, inner2: sv.inner2, sname: struct_name, sname2: sv.sname2, extra: sv.extra, tp_id: sv_tp(sv.ctype, inner, sv.inner2, struct_name) })
            return
        }
        i = i - 1
    }
    push_scope_var(ScopeVar { name: name, ctype: CT_OPTION, is_mut: 0, inner1: inner, inner2: -1, sname: struct_name, sname2: "", extra: "", tp_id: sv_tp(CT_OPTION, inner, -1, struct_name) })
}

pub fn get_var_option_inner(name: Str) -> Int {
    get_sv_inner1(name, CT_OPTION)
}

pub fn get_var_option_inner_struct(name: Str) -> Str {
    get_sv_sname(name, CT_OPTION)
}

pub fn set_var_result(name: Str, ok_t: Int, err_t: Int) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_RESULT {
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: ok_t, inner2: err_t, sname: sv.sname, sname2: sv.sname2, extra: sv.extra, tp_id: sv_tp(sv.ctype, ok_t, err_t, sv.sname) })
            return
        }
        i = i - 1
    }
    push_scope_var(ScopeVar { name: name, ctype: CT_RESULT, is_mut: 0, inner1: ok_t, inner2: err_t, sname: "", sname2: "", extra: "", tp_id: sv_tp(CT_RESULT, ok_t, err_t, "") })
}

pub fn set_var_result_struct(name: Str, ok_t: Int, err_t: Int, ok_s: Str, err_s: Str) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_RESULT {
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: ok_t, inner2: err_t, sname: ok_s, sname2: err_s, extra: sv.extra, tp_id: sv_tp(sv.ctype, ok_t, err_t, ok_s) })
            return
        }
        i = i - 1
    }
    push_scope_var(ScopeVar { name: name, ctype: CT_RESULT, is_mut: 0, inner1: ok_t, inner2: err_t, sname: ok_s, sname2: err_s, extra: "", tp_id: sv_tp(CT_RESULT, ok_t, err_t, ok_s) })
}

// Precondition: fs.starts_with("Option_")
pub fn set_var_option_from_struct_tag(name: Str, fs: Str) {
    let inner_tag = fs.slice(7, fs.len())
    let inner_ct = type_from_name_tag(inner_tag)
    // whg65a: a `Map_<k>_<v>` inner carries its scalar K/V in the tag itself.
    // Rebuild the var's tp as `option(map(k,v))` so the unwrapped Option keeps the
    // Map's value type (a later `mm.get(k)` decodes V) — set_var_option_struct's
    // flat sv_tp path would default V to Int. Only fires for scalar-recoverable
    // K/V; struct/nested values keep the existing struct-tag path.
    if inner_ct == CT_MAP && inner_tag.starts_with("Map_") {
        let kv = map_struct_scalar_kv(inner_tag)
        if kv.first >= 0 {
            set_var_option_struct(name, CT_MAP, inner_tag)
            set_var_option_inner_tp(name, type_map(type_from_tag_node(kv.first), type_from_tag_node(kv.second)))
            return
        }
    }
    if is_named_typedef_tag(inner_tag) != 0 {
        set_var_option_struct(name, inner_ct, inner_tag)
    } else {
        set_var_option(name, inner_ct)
    }
}

// whg65a: a scalar CT to its leaf tp node (Int→type_int, Str→type_string, else a
// bare sv_tp of that CT). Used to rebuild a Map inner tp from recovered K/V CTs.
fn type_from_tag_node(ct: Int) -> Int {
    if ct == CT_INT { return type_int() }
    if ct == CT_STRING { return type_string() }
    sv_tp(ct, -1, -1, "")
}

// Precondition: fs.starts_with("Result_"). Malformed tags (no second segment)
// leave inner types unset — caller's prior set_var establishes CT_RESULT.
pub fn set_var_result_from_struct_tag(name: Str, fs: Str) {
    let split = split_result_compound(fs)
    if split.second != "" {
        let ok_ct = type_from_name_tag(split.first)
        let err_ct = type_from_name_tag(split.second)
        let ok_s = typedef_tag_or_empty(split.first)
        let err_s = typedef_tag_or_empty(split.second)
        if ok_s != "" || err_s != "" {
            set_var_result_struct(name, ok_ct, err_ct, ok_s, err_s)
        } else {
            set_var_result(name, ok_ct, err_ct)
        }
    }
}

// Convert an annotation-form type string (`Option[Str]`, `Result[Int, Str]`,
// `Map[Str, Str]`, `Foo`, `Int`) into its carrier/struct tag form
// (`Option_str`, `Result_int_str`, `Map_str_str`, `Foo`, `int`). Recurses on
// nested compound inners so the tag matches the emitted typedef.
fn compound_tag_from_type_str(s: Str) -> Str {
    let ct = type_from_name(s)
    let bracket_pos = s.index_of("[")
    if is_compound_ct(ct) != 0 && bracket_pos > 0 {
        let inner = s.substr(bracket_pos + 1, s.len() - bracket_pos - 2)
        let parts = split_top_level_commas(inner)
        if ct == CT_OPTION && parts.len() >= 1 {
            return "Option_{compound_tag_from_type_str(parts.get(0).unwrap())}"
        } else if ct == CT_RESULT && parts.len() >= 2 {
            return "Result_{compound_tag_from_type_str(parts.get(0).unwrap())}_{compound_tag_from_type_str(parts.get(1).unwrap())}"
        } else if ct == CT_MAP && parts.len() >= 2 {
            return "Map_{compound_tag_from_type_str(parts.get(0).unwrap())}_{compound_tag_from_type_str(parts.get(1).unwrap())}"
        }
    }
    let bare = strip_module_qualifier(s)
    if is_struct_type(bare) != 0 || is_enum_type(bare) != 0 {
        return bare
    }
    c_type_tag(ct)
}

fn split_top_level_commas(s: Str) -> List[Str] {
    let mut out: List[Str] = []
    let mut seg_start = 0
    let mut depth = 0
    let mut i = 0
    while i < s.len() {
        let b = s.byte_at(i)
        if b == 91 {
            depth = depth + 1
        } else if b == 93 {
            depth = depth - 1
        } else if b == 44 && depth == 0 {
            out.push(s.substr(seg_start, i - seg_start).trim())
            seg_start = i + 1
        }
        i = i + 1
    }
    out.push(s.substr(seg_start, s.len() - seg_start).trim())
    out
}

// Register compound-carrier inner-type metadata on a bound variable from its
// annotation-form field type string (`Option[Str]`, `Result[Int, Str]`).
pub fn register_var_compound_inner_from_str(name: Str, type_str: Str) {
    let ct = type_from_name(type_str)
    let tag = compound_tag_from_type_str(type_str)
    if ct == CT_OPTION && tag.starts_with("Option_") {
        set_var_option_from_struct_tag(name, tag)
    } else if ct == CT_RESULT && tag.starts_with("Result_") {
        set_var_result_from_struct_tag(name, tag)
    }
}

pub fn get_var_result_ok(name: Str) -> Int {
    get_sv_inner1(name, CT_RESULT)
}

pub fn get_var_result_err(name: Str) -> Int {
    get_sv_inner2(name, CT_RESULT)
}

pub fn get_var_result_ok_struct(name: Str) -> Str {
    get_sv_sname(name, CT_RESULT)
}

pub fn get_var_result_err_struct(name: Str) -> Str {
    get_sv_sname2(name, CT_RESULT)
}

pub fn set_var_result_ok_elem(name: Str, elem_type: Int, elem_struct: Str) {
    let encoded = "{elem_type}:{elem_struct}"
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_RESULT {
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: sv.inner1, inner2: sv.inner2, sname: sv.sname, sname2: sv.sname2, extra: encoded, tp_id: sv.tp_id })
            return
        }
        i = i - 1
    }
}

pub fn get_var_result_ok_elem(name: Str) -> Int {
    let extra = get_sv_extra(name, CT_RESULT)
    if extra == "" { return -1 }
    let idx = extra.index_of(":")
    if idx < 0 { return -1 }
    extra.slice(0, idx).to_int()
}

pub fn get_var_result_ok_elem_struct(name: Str) -> Str {
    let extra = get_sv_extra(name, CT_RESULT)
    if extra == "" { return "" }
    let idx = extra.index_of(":")
    if idx < 0 { return "" }
    extra.slice(idx + 1, extra.len())
}

pub fn set_var_iterator(name: Str, inner: Int, next_fn: Str) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_ITERATOR {
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: inner, inner2: sv.inner2, sname: sv.sname, sname2: sv.sname2, extra: next_fn, tp_id: sv_tp(sv.ctype, inner, sv.inner2, sv.sname) })
            return
        }
        i = i - 1
    }
    push_scope_var(ScopeVar { name: name, ctype: CT_ITERATOR, is_mut: 0, inner1: inner, inner2: -1, sname: "", sname2: "", extra: next_fn, tp_id: sv_tp(CT_ITERATOR, inner, -1, "") })
}

pub fn get_var_iterator_inner(name: Str) -> Int {
    get_sv_inner1(name, CT_ITERATOR)
}

pub fn get_var_iter_next_fn(name: Str) -> Str {
    get_sv_extra(name, CT_ITERATOR)
}

// z9gkt3: an adapter over a List[compound] source keys its typedef on the carrier
// tag but reports its element CT as CT_INT (pointer-boxed). Stash the carrier tag
// on the CT_ITERATOR var's otherwise-unused `sname` slot so a chained downstream
// adapter (via iter_from_source's var-iterator branch) or a collect/for-in
// re-derives the deref and re-stamps the compound result element. Empty for a
// scalar iterator.
pub fn set_var_iter_carrier(name: Str, carrier: Str) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_ITERATOR {
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: sv.inner1, inner2: sv.inner2, sname: carrier, sname2: sv.sname2, extra: sv.extra, tp_id: sv.tp_id })
            return
        }
        i = i - 1
    }
}

pub fn get_var_iter_carrier(name: Str) -> Str {
    get_sv_sname(name, CT_ITERATOR)
}

pub fn set_var_alias(name: Str, target: Str) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name {
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: sv.inner1, inner2: sv.inner2, sname: sv.sname, sname2: target, extra: sv.extra, tp_id: sv.tp_id })
            return
        }
        i = i - 1
    }
}

pub fn get_var_alias(name: Str) -> Str {
    if scope_ct_count(CT_ITERATOR) <= 0 { return "" }
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_ITERATOR {
            return sv.sname2
        }
        i = i - 1
    }
    ""
}

pub fn set_var_handle(name: Str, inner: Int) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_HANDLE {
