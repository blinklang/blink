    if t >= 0 { sev_result_err_nominal(cg_bind_mono_tid(t)) } else { "" }
}

pub fn get_var_result_ok_elem(name: Str) -> Int {
    let t = get_sv_ty(name, CT_RESULT)
    if t >= 0 {
        return tc_tid_list_elem_ct_resolved(tc_tid_result_ok_tid(cg_bind_mono_tid(t)))
    }
    -1
}

pub fn get_var_result_ok_elem_struct(name: Str) -> Str {
    let t = get_sv_ty(name, CT_RESULT)
    if t >= 0 {
        return tc_tid_list_elem_struct_mono(tc_tid_result_ok_tid(cg_bind_mono_tid(t)))
    }
    ""
