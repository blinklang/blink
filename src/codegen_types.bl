import parser.{
    node_effects, node_elements, node_fields, node_impl_binders, node_impl_where_bounds, node_is_pub, node_methods, node_module, node_name, node_params, node_return_type,
    node_source_module, node_trait_name, node_type_ann, node_type_name, node_type_params,
    node_value,
    sublist_get, sublist_length
}
import ast.{dbg_channel_on, dbg_trace}
import diagnostics.{
    Diag, diag_error_no_loc, diag_ice_no_loc, diag_set_last_fix, diag_is_ice_seg,
    UNDECLARED_EFFECT, ICE_SEG_ERASED_SLOT, MAP_TAG_REACHED_CARRIER_SCOPE,
}

effect Codegen {
    effect Emit
    effect Register
    effect Scope
}

fn collect_type_ann_names(ann: Int, out: List[Str]) {
    if ann == -1 { return }
    let n = node_name(ann)
    if n != "" { out.push(n) }
    let elems = node_elements(ann)
    if elems != -1 {
        let mut i = 0
        while i < sublist_length(elems) {
            collect_type_ann_names(sublist_get(elems, i), out)
            i = i + 1
        }
    }
    // A fn-type annotation stores its parameters in `elements` but its return
    // type in `type_ann`, so the return binder is only reachable this way.
    if n == "Fn" {
        collect_type_ann_names(node_type_ann(ann), out)
    }
}

// True when an impl over a builtin container lowers to identical C for every
// concrete element type: no impl binder is bounded, and no binder name appears
// in any method signature (parameter or return type). Such an impl treats
// elements as opaque handles, so it routes through the single-symbol eager path
// instead of per-element monomorphization. An unbounded, signature-agnostic
// binder cannot cross a method boundary by value nor be operated on, so the
// emitted C is provably element-independent.
pub fn impl_is_element_agnostic(im: Int) -> Int {
    let binders_sl = node_impl_binders(im)
    if binders_sl == -1 { return 1 }
    let nb = sublist_length(binders_sl)
    if nb == 0 { return 1 }
    // A where-clause bounds a binder just as an inline `[T: Bound]` does; a
    // bounded binder can materialize an element value the C would branch on.
    let where_sl = node_impl_where_bounds(im)
    if where_sl != -1 && sublist_length(where_sl) != 0 { return 0 }
    let mut bnames: List[Str] = []
    let mut bi = 0
    while bi < nb {
        let b = sublist_get(binders_sl, bi)
        if node_elements(b) != -1 { return 0 }
        bnames.push(node_name(b))
        bi = bi + 1
    }
    let methods_sl = node_methods(im)
    if methods_sl == -1 { return 1 }
    let mut j = 0
    while j < sublist_length(methods_sl) {
        let m = sublist_get(methods_sl, j)
        let mut names: List[Str] = []
        collect_type_ann_names(node_type_ann(m), names)
        let params_sl = node_params(m)
        if params_sl != -1 {
            let mut pi = 0
            while pi < sublist_length(params_sl) {
                collect_type_ann_names(node_type_ann(sublist_get(params_sl, pi)), names)
                pi = pi + 1
            }
        }
        let mut ni = 0
        while ni < names.len() {
            let nm = names.get(ni).unwrap()
            let mut bk = 0
            while bk < bnames.len() {
                if nm == bnames.get(bk).unwrap() { return 0 }
                bk = bk + 1
            }
            ni = ni + 1
        }
        j = j + 1
    }
    1
}

// codegen_types.bl — Type constants, global state, scope/registry helpers
//
// Minimal subset: enough to compile hello_compiled.bl via the
// Python C backend. Reads the AST node pool (List[AstNode]) produced
// by parser.bl and emits C source as a list of strings.
//
// Constraints: no closures, no imports. Constants duplicated for
// self-contained compilation.

// ── C type constants ────────────────────────────────────────────────
// Instead of enums, plain ints.

pub let CT_INT = 0
pub let CT_FLOAT = 1
pub let CT_BOOL = 2
pub let CT_STRING = 3
pub let CT_LIST = 4
pub let CT_VOID = 5
pub let CT_CLOSURE = 6
pub let CT_OPTION = 7
pub let CT_RESULT = 8
pub let CT_ITERATOR = 9
pub let CT_HANDLE = 10
pub let CT_CHANNEL = 11
let CT_TAGGED_ENUM = 12
pub let CT_MAP = 13
pub let CT_BYTES = 14
pub let CT_INSTANT = 15
pub let CT_DURATION = 16
pub let CT_PTR = 17
pub let CT_FFI_SCOPE = 18
pub let CT_STRINGBUILDER = 19
pub let CT_SET = 20
pub let CT_HANDLER = 21
pub let CT_TEMPLATE = 22
pub let CT_STRUCT = 23
pub let CT_ENUM = 24
pub let CT_I8 = 25
pub let CT_I16 = 26
pub let CT_I32 = 27
pub let CT_U8 = 28
pub let CT_U16 = 29
pub let CT_U32 = 30
pub let CT_U64 = 31
pub let CT_CHAR = 32

// ── Type node pool (interned, struct pool) ──────────────────────────
// Recursive type representation: each type is an integer handle into
// tp_pool. Constructed bottom-up, interned for O(1) equality.
// Coexists with CT_* during migration; will eventually replace it.

type TypeNode {
    kind: Int
    child1: Int
    child2: Int
    sname: Str
}
let mut tp_pool: List[TypeNode] = []
let mut tp_intern: Map[Str, Int] = Map()

fn tp_intern_key(kind: Int, c1: Int, c2: Int, sname: Str) -> Str {
    "{kind}|{c1}|{c2}|{sname}"
}

fn tp_alloc(kind: Int, c1: Int, c2: Int, sname: Str) -> Int {
    let key = tp_intern_key(kind, c1, c2, sname)
    match tp_intern.get(key) {
        Some(v) => return v
        None => {}
    }
    let id = tp_pool.len()
    tp_pool.push(TypeNode { kind: kind, child1: c1, child2: c2, sname: sname })
    tp_intern.insert(key, id)
    id
}

pub fn type_int() -> Int {
    tp_alloc(CT_INT, -1, -1, "")
}

fn type_float() -> Int {
    tp_alloc(CT_FLOAT, -1, -1, "")
}

fn type_bool() -> Int {
    tp_alloc(CT_BOOL, -1, -1, "")
}

pub fn type_string() -> Int {
    tp_alloc(CT_STRING, -1, -1, "")
}

fn type_void() -> Int {
    tp_alloc(CT_VOID, -1, -1, "")
}

fn type_bytes() -> Int {
    tp_alloc(CT_BYTES, -1, -1, "")
}

fn type_instant() -> Int {
    tp_alloc(CT_INSTANT, -1, -1, "")
}

fn type_duration() -> Int {
    tp_alloc(CT_DURATION, -1, -1, "")
}

pub fn type_list(elem: Int) -> Int {
    tp_alloc(CT_LIST, elem, -1, "")
}

pub fn type_option(inner: Int) -> Int {
    tp_alloc(CT_OPTION, inner, -1, "")
}

pub fn type_result(ok: Int, err: Int) -> Int {
    tp_alloc(CT_RESULT, ok, err, "")
}

pub fn type_map(key: Int, value: Int) -> Int {
    tp_alloc(CT_MAP, key, value, "")
}

pub fn type_set(elem: Int) -> Int {
    tp_alloc(CT_SET, elem, -1, "")
}

pub fn type_iterator(inner: Int) -> Int {
    tp_alloc(CT_ITERATOR, inner, -1, "")
}

fn type_handle(inner: Int) -> Int {
    tp_alloc(CT_HANDLE, inner, -1, "")
}

fn type_channel(inner: Int) -> Int {
    tp_alloc(CT_CHANNEL, inner, -1, "")
}

fn type_closure(sig: Str) -> Int {
    tp_alloc(CT_CLOSURE, -1, -1, sig)
}

pub fn type_struct(name: Str) -> Int {
    tp_alloc(CT_STRUCT, -1, -1, name)
}

fn type_enum(name: Str) -> Int {
    tp_alloc(CT_ENUM, -1, -1, name)
}

fn type_ptr(inner: Int) -> Int {
    tp_alloc(CT_PTR, inner, -1, "")
}

fn type_ffi_scope() -> Int {
    tp_alloc(CT_FFI_SCOPE, -1, -1, "")
}

fn type_stringbuilder() -> Int {
    tp_alloc(CT_STRINGBUILDER, -1, -1, "")
}

pub fn tp_get_kind(id: Int) -> Int {
    tp_pool.get(id).unwrap().kind
}

pub fn tp_get_child1(id: Int) -> Int {
    tp_pool.get(id).unwrap().child1
}

pub fn tp_get_child2(id: Int) -> Int {
    tp_pool.get(id).unwrap().child2
}

pub fn tp_get_sname(id: Int) -> Str {
    tp_pool.get(id).unwrap().sname
}

pub fn tp_child1_kind(id: Int) -> Int {
    let c1 = tp_pool.get(id).unwrap().child1
    if c1 >= 0 { return tp_get_kind(c1) }
    -1
}

pub fn tp_child2_kind(id: Int) -> Int {
    let c2 = tp_pool.get(id).unwrap().child2
    if c2 >= 0 { return tp_get_kind(c2) }
    -1
}

pub fn tp_child1_sname(id: Int) -> Str {
    let c1 = tp_pool.get(id).unwrap().child1
    if c1 >= 0 { return tp_get_sname(c1) }
    ""
}

pub fn tp_child2_sname(id: Int) -> Str {
    let c2 = tp_pool.get(id).unwrap().child2
    if c2 >= 0 { return tp_get_sname(c2) }
    ""
}

// Renders a tp_id (codegen's flat-derived pool) for human consumption. `pub` for the divergence
// instrument, which pairs it with tc_type_str to show HOW the two type universes disagree at a
// site. Row text only — never compared for equality; the two renderers use different vocabularies.
pub fn tp_display(id: Int) -> Str {
    if id < 0 {
        return "?"
    }
    let e = tp_pool.get(id).unwrap()
    let k = e.kind
    if k == CT_INT { return "Int" }
    if k == CT_FLOAT { return "Float" }
    if k == CT_BOOL { return "Bool" }
    if k == CT_STRING { return "Str" }
    if k == CT_VOID { return "Void" }
    if k == CT_I8 { return "I8" }
    if k == CT_I16 { return "I16" }
    if k == CT_I32 { return "I32" }
    if k == CT_U8 { return "U8" }
    if k == CT_U16 { return "U16" }
    if k == CT_U32 { return "U32" }
    if k == CT_U64 { return "U64" }
    if k == CT_CHAR { return "Char" }
    if k == CT_BYTES { return "Bytes" }
    if k == CT_INSTANT { return "Instant" }
    if k == CT_DURATION { return "Duration" }
    if k == CT_FFI_SCOPE { return "FFIScope" }
    if k == CT_STRINGBUILDER { return "StringBuilder" }
    let c1 = e.child1
    let c2 = e.child2
    let sn = e.sname
    if k == CT_LIST { return "List[{tp_display(c1)}]" }
    if k == CT_OPTION { return "Option[{tp_display(c1)}]" }
    if k == CT_RESULT { return "Result[{tp_display(c1)}, {tp_display(c2)}]" }
    if k == CT_MAP { return "Map[{tp_display(c1)}, {tp_display(c2)}]" }
    // An erased Set element still renders as "?" via the c1 < 0 path, so a recorded element and
    // an unknown one stay distinguishable here.
    if k == CT_SET { return "Set[{tp_display(c1)}]" }
    if k == CT_ITERATOR { return "Iterator[{tp_display(c1)}]" }
    if k == CT_HANDLE { return "Handle[{tp_display(c1)}]" }
    if k == CT_CHANNEL { return "Channel[{tp_display(c1)}]" }
    if k == CT_PTR { return "Ptr[{tp_display(c1)}]" }
    if k == CT_CLOSURE { return "Fn({sn})" }
    if k == CT_STRUCT || k == CT_ENUM { return sn }
    "Unknown"
}

// ── Codegen state ───────────────────────────────────────────────────

pub let mut cg_lines: List[Str] = []
pub let mut cg_indent: Int = 0
pub let mut cg_temp_counter: Int = 0
pub let mut cg_global_inits: List[Str] = []
pub let mut closure_param_names: List[Str] = []
pub let mut struct_reg_names: List[Str] = []
pub type EnumReg {
    name: Str
    has_data: Int
    is_str_backed: Int
}

pub type EnumVariant {
    name: Str
    enum_idx: Int
    field_names: Str
    field_types: Str
    field_count: Int
    str_value: Str
    tag: Int
}

pub let mut enum_regs: List[EnumReg] = []
pub let mut enum_variants: List[EnumVariant] = []
pub let mut enum_variant_name_idx: Map[Str, Str] = Map()
pub let mut enum_variant_full_idx: Map[Str, Int] = Map()
pub let mut enum_str_backed_set: Map[Str, Int] = Map()
pub type VarEnumEntry {
    name: Str
    enum_type: Str
}
pub let mut var_enums: List[VarEnumEntry] = []
pub let mut var_enum_frame_starts: List[Int] = []
pub type FnEnumRetEntry {
    name: Str
    enum_type: Str
}
pub let mut fn_enum_rets: List[FnEnumRetEntry] = []
pub let mut emitted_let_names: List[Str] = []
pub let mut emitted_fn_names: List[Str] = []
pub let mut struct_reg_set: Map[Str, Int] = Map()
pub let mut enum_reg_set: Map[Str, Int] = Map()
pub let mut emitted_fn_set: Map[Str, Int] = Map()
pub let mut fn_reg_set: Map[Str, Int] = Map()
pub let mut cg_emit_only_module: Str = ""
// Inverse of cg_emit_only_module: source-module keys whose decls are
// elided. Map[Str, Int] used as a set, matching the *_set convention
// of sibling globals here. Both filters compose.
pub let mut cg_skip_modules: Map[Str, Int] = Map()
pub let mut cg_archive_header_mode: Int = 0
// When set under cg_archive_header_mode, generate() uses this string as the
// include-guard symbol (e.g. "BLINK_MOD_FOO_H") instead of the default
// "BLINK_LIBBLINK_STD_H". Empty = use the default. Set by
// generate_module_header() for per-module .h emission; the archive monolith
// path leaves this empty so its existing header output is unchanged.
pub let mut cg_module_header_guard: Str = ""
// When non-zero, this TU does not own __blink_ev: emit `extern blink_ev
// __blink_ev;` instead of the typedef + default-initializer + definition.
// The owner TU keeps the flag at 0 and emits the storage. Default 0
// preserves whole-program behavior (single TU owns __blink_ev).
pub let mut cg_blink_ev_extern_only: Int = 0
// When non-zero under per-module emission, generate() prepends an
// `#include "<cg_module_object_self_header>"` so the .c references its own
// extern decls/typedefs. Mutually exclusive with archive modes.
pub let mut cg_module_object_self_header: Str = ""
// When non-zero, we're producing the stdlib archive's monolith.o itself —
// so the C `int main` wrapper and the synthesized `fn main()`'s blink_main
// body are suppressed (the archive has no entry point; the user's TU
// owns main()).
pub let mut cg_archive_build_mode: Int = 0
// When non-zero, we're compiling a user translation unit that links against
// the prebuilt stdlib archive (blinkc --link-archive / `blink build`). The
// emitted .c includes `libblink_std.h` for shared typedefs + extern decls,
// externs runtime storage (defined in the archive monolith), and keeps
// effectful stdlib fns inline. The standalone path (legacy single-TU
// blinkc with no --link-archive) leaves this at 0.
pub let mut cg_user_tu_mode: Int = 0
// When non-zero, this is a test build (`blink test`): panic sites lower to the
// thread-local catch dispatch (__blink_panic_dispatch) instead of the historic
// inline `fprintf; exit(1)`, and the generated C `#define`s BLINK_TEST_BUILD so
// the runtime_core.h trap sites switch to the dispatch too. A non-test build
// leaves this 0 and emits byte-identical panic sites + a BLINK_TEST_BUILD-free
// runtime (the assert_panics zero-cost guarantee, spec §2.20).
pub let mut cg_test_mode: Int = 0
pub let mut emitted_let_set: Map[Str, Int] = Map()
// Module-level `let` names, so a capture analysis can tell "free in this function" from
// "file-scope C static". A global needs no capture at all — the static function CAN see it —
// and capturing one is actively wrong for a `let mut`, because the capture is a copy of the
// value at handler-construction time. Written by emit_top_level_let, which runs before any
// function body.
pub let mut cg_module_global_set: Map[Str, Int] = Map()
pub let mut emitted_option_set: Map[Str, Int] = Map()
pub let mut emitted_result_set: Map[Str, Int] = Map()
pub let mut emitted_iter_set: Map[Str, Int] = Map()
pub let mut cg_closure_defs: List[Str] = []
pub let mut cg_closure_promoter_defs: List[Str] = []
pub let mut cg_closure_counter: Int = 0
pub let mut cg_closure_param_type_hint: Int = -1
// The element tid behind the CT hint above — set by the same HOF sites so an unannotated
// closure param can be spelled from its tid, not the bare CT (which loses struct identity).
pub let mut cg_closure_param_type_hint_tid: Int = -1

// Per-arg hint set by Call-arg loops before each emit_expr. Empty when the
// formal isn't `fn(...)`; otherwise holds the formal's closure-signature
// string so the Ident arm can detect a bare-fn ref and synthesize an ABI
// shim + blink_closure_new_typed wrapper. Always saved/restored around
// recursive emit_expr calls (per-arg, not per-expression-tree).
pub let mut cg_expect_fn_value_sig: Str = ""

// Dedup table for bare-fn-as-value shims, keyed by mangled C target symbol.
// Cleared per generate() like other typedef caches.
pub let mut cg_fn_shim_emitted: Map[Str, Str] = Map()

pub let mut cg_bh_cleanup_set: Map[Str, Int] = Map()
pub let mut cg_cl_cleanup_set: Map[Str, Int] = Map()
pub let mut cg_ev_restore_emitted: Int = 0
pub let mut cg_arena_helper_emitted: Int = 0

pub let mut cg_ffi_libs: List[Str] = []
pub let mut cg_ffi_lib_set: Map[Str, Int] = Map()

pub let mut mod_fn_prefix: Map[Str, Str] = Map()
pub let mut mod_type_prefix: Map[Str, Str] = Map()
// Maps a Blink @ffi.opaque type name to the incomplete C type from `name: "..."`.
// The bare handle lowers to `<c_name>*` (one machine word); Ptr[T] adds a second
// star (the out-param shape). No `blink_` struct is emitted — the pointee is
// incomplete by design, the deliberate contrast with @ffi.struct.
pub let mut ffi_opaque_c_name: Map[Str, Str] = Map()
// Built-in types defined by the runtime (e.g. ConversionError, ProcessResult)
// keep their bare `blink_<name>` mangling regardless of whether a Blink-source
// declaration of the same name lives in some module's source_module bucket.
pub let mut builtin_type_set: Map[Str, Int] = Map()

// Mangling key for a top-level decl: always the file-derived source_module
// so per-file .o builds get distinct C symbols. Runtime-bridged types whose
// bare `blink_<name>` symbol must survive (e.g. ConversionError, ProcessResult)
// are registered in `builtin_type_set` at codegen init and bypass this prefix.
pub fn mangling_module(node: Int) -> Str {
    node_source_module(node)
}

pub fn is_stdlib_source_module(module_name: Str) -> Bool {
    module_name.starts_with("std_")
}

pub fn skip_private_in_module_header(node: Int) -> Bool {
    // Only when we're actually emitting a module header (.h). Per-module
    // object emission (.c) must keep private fns/lets so their forward
    // decls and definitions land in the same TU.
    in_per_module_header() && node_is_pub(node) == 0
}

// True when emitting a single module's .h (per-module header pass).
pub fn in_per_module_header() -> Bool {
    cg_emit_only_module != "" && cg_archive_header_mode != 0
}

// True when emitting a single module's .c (per-module object pass).
pub fn in_per_module_object() -> Bool {
    cg_emit_only_module != "" && cg_archive_header_mode == 0
}

pub let mut type_alias_base: Map[Str, Str] = Map()
pub let mut type_where_preds: Map[Str, Int] = Map()
pub let mut cg_where_self_var: Str = ""

// When emitting an @ensures predicate, holds the C variable name carrying
// the function's return value, so the Blink identifier `result` resolves
// to it inside the predicate.
pub let mut cg_ensures_result_var: Str = ""

// Maps the AST node id of a Call(old, [e]) inside an @ensures predicate
// to the C variable name that snapshotted `e` at function entry.
// Populated by emit_old_snapshots before emit_fn_body.
pub let mut cg_old_snapshot_vars: Map[Str, Str] = Map()

// C reserved words and problematic libc names — identifiers that must be mangled
let mut c_reserved_set: Map[Str, Int] = Map()
let mut c_reserved_init_done: Int = 0

// Bare names that collide with blink_* runtime C identifiers when prefixed
let mut blink_reserved_set: Map[Str, Int] = Map()
let mut blink_reserved_init_done: Int = 0

fn init_c_reserved() {
    if c_reserved_init_done != 0 {
        return
    }
    c_reserved_init_done = 1
    // C keywords
    c_reserved_set.insert("auto", 1)
    c_reserved_set.insert("break", 1)
    c_reserved_set.insert("case", 1)
    c_reserved_set.insert("char", 1)
    c_reserved_set.insert("const", 1)
    c_reserved_set.insert("continue", 1)
    c_reserved_set.insert("default", 1)
    c_reserved_set.insert("do", 1)
    c_reserved_set.insert("double", 1)
    c_reserved_set.insert("else", 1)
    c_reserved_set.insert("enum", 1)
    c_reserved_set.insert("extern", 1)
    c_reserved_set.insert("float", 1)
    c_reserved_set.insert("for", 1)
    c_reserved_set.insert("goto", 1)
    c_reserved_set.insert("if", 1)
    c_reserved_set.insert("inline", 1)
    c_reserved_set.insert("int", 1)
    c_reserved_set.insert("long", 1)
    c_reserved_set.insert("register", 1)
    c_reserved_set.insert("restrict", 1)
    c_reserved_set.insert("return", 1)
    c_reserved_set.insert("short", 1)
    c_reserved_set.insert("signed", 1)
    c_reserved_set.insert("sizeof", 1)
    c_reserved_set.insert("static", 1)
    c_reserved_set.insert("struct", 1)
    c_reserved_set.insert("switch", 1)
    c_reserved_set.insert("typedef", 1)
    c_reserved_set.insert("union", 1)
    c_reserved_set.insert("unsigned", 1)
    c_reserved_set.insert("void", 1)
    c_reserved_set.insert("volatile", 1)
    c_reserved_set.insert("while", 1)
    // C99/C11
    c_reserved_set.insert("_Bool", 1)
    c_reserved_set.insert("_Complex", 1)
    c_reserved_set.insert("_Imaginary", 1)
    c_reserved_set.insert("_Alignas", 1)
    c_reserved_set.insert("_Alignof", 1)
    c_reserved_set.insert("_Atomic", 1)
    c_reserved_set.insert("_Generic", 1)
    c_reserved_set.insert("_Noreturn", 1)
    c_reserved_set.insert("_Static_assert", 1)
    c_reserved_set.insert("_Thread_local", 1)
    // Common libc/POSIX names that would conflict
    c_reserved_set.insert("errno", 1)
    c_reserved_set.insert("stdin", 1)
    c_reserved_set.insert("stdout", 1)
    c_reserved_set.insert("stderr", 1)
    c_reserved_set.insert("printf", 1)
