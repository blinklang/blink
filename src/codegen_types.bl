// 4q2etk: replaced by mwxtyj — types with an `impl Display`; the compiler
// synthesizes a sealed `{T}_display` fn (fmt rendered through a fresh
// StringBuilder) for each.
pub let mut display_impl_types: List[Str] = []

pub type DeriveMethodEntry {
    type_name: Str
    method_name: Str
    ret_type: Int
}
pub let mut derive_method_entries: List[DeriveMethodEntry] = []

pub fn has_derive_method(type_name: Str, method: Str) -> Int {
    let mut i = 0
    while i < derive_method_entries.len() {
        let e = derive_method_entries.get(i).unwrap()
        if e.type_name == type_name && e.method_name == method {
            return 1
        }
        i = i + 1
    }
    0
}

fn get_derive_method_ret(type_name: Str, method: Str) -> Int {
    let mut i = 0
    while i < derive_method_entries.len() {
        let e = derive_method_entries.get(i).unwrap()
        if e.type_name == type_name && e.method_name == method {
            return e.ret_type
        }
        i = i + 1
    }
    CT_VOID
}

// Function AST node registry: fn_name -> fn_node for all functions.
// First registration wins; later reg_fn_node calls with the same name
// are no-ops (matches legacy linear-scan semantics that returned the
// first match).
let mut fn_node_registry: Map[Str, Int] = Map()

pub fn codegen_types_pool_len() -> Int {
    tp_pool.len()
}

pub fn codegen_fn_registry_len() -> Int {
    fn_node_registry.len()
}

pub fn reset_fn_node_registry() {
    fn_node_registry.clear()
}

pub fn reset_closure_codegen_state() {
    closure_captures.clear()
    closure_cap_infos.clear()
    closure_lit_cap_idx.clear()
}

pub fn reg_fn_node(name: Str, node: Int) {
    if !fn_node_registry.contains_key(name) {
        fn_node_registry.insert(name, node)
    }
}

pub fn get_fn_node(name: Str) -> Int {
    match fn_node_registry.get(name) {
        Some(v) => { return v }
        None => {}
    }
    -1
}

// Generic function definition registry: fn_name -> fn_node for generic fns
pub type GenericFnEntry {
    name: Str
    node: Int
}
pub let mut generic_fns: List[GenericFnEntry] = []
// Parallel name->node index over generic_fns for O(1) is_generic_fn /
// get_generic_fn_node lookups. Kept in lockstep with generic_fns.
pub let mut generic_fns_by_name: Map[Str, Int] = Map()

// Mono function instances to emit: (base_fn_name, concrete_args)
// arg_tids: the per-tparam concrete type-ids that produced `args`, positionally
// aligned with the CSV segments (codegen-structured-tids D1b, br ec5qgb). Empty
// when the registering call site had no tid in scope (string-derived paths).
//
// "AN EMPTY LIST IS ALWAYS SAFE" USED TO BE CLAIMED HERE AND IS FALSE. It rested on a
// def-side fall back to the `args` string that NO LONGER EXISTS: since br 0n07he deleted the
// string-CSV type-param resolver, emit_mono_struct_typedef / emit_mono_enum_typedef /
// mono_fn_signature use concrete_args ONLY to build the c_name and resolve every field and
// param through resolve_tparam_via_tid, which returns the BINDER NAME UNCHANGED on a -1 or
// absent slot. A degraded arg_tids therefore erases with no compensation whatsoever, in one
// of two shapes neither of which the `_Void` grep can see (CLAUDE.md): a bare binder in a C
// symbol (blink_Box_T), or an erased field under a correct mono name
// (blink_QBox_Int { blink_Option_void v; }, br w4c0py).
//
// Worse, [] is strictly less recoverable than an all- -1 list of the right arity, because the
// recovery net mono_arg_tids_with_ann (codegen_stmt.bl) fills -1 HOLES and an empty list
// has none. merge_arg_tids treats arity as information for exactly that reason (br p7014w).
type MonoFnInstance {
    base: Str
    args: Str
    arg_tids: List[Int]
}
pub let mut mono_fns: List[MonoFnInstance] = []

// Generic monomorphic instance registry
type MonoInstance {
    base: Str
    args: Str
    c_name: Str
    arg_tids: List[Int]
    // The type ANNOTATION node this instance was registered from, or -1. Only
    // register_carrier_inner_mono_instance sets it, because that producer runs in
    // codegen_types — BELOW typecheck in the module DAG — and so cannot read the
    // instance tid it needs for arg_tids. The tid does exist:
    // tc_produce_struct_instance_tid / _enum_ memoized the full instance onto this
    // very node. Carrying the node id (a plain Int, no typecheck surface required)
    // lets the def-side typedef emitter, which runs ABOVE typecheck, recover it.
    ann: Int
}

// The PHYSICAL C-symbol stem for a mono base. For a generic STRUCT/ENUM base
// (find_type_def_node hit) this is c_type_tag_for_struct(base) — the file-derived,
// module-prefixed tag — so a cross-module generic instance (`helper.CmgBox[Int]`)
// mangles by its DEFINING module (blink_helper_CmgBox_Int) and two same-named
// generics in different modules stay distinct C types (br q4etvt). For a fn base
// (not a type def) or a same-module/unqualified struct, c_type_tag_for_struct is a
// no-op that returns `base` unchanged — so fn symbols and same-module struct
// symbols are byte-identical to the pre-q4etvt bare spelling. The LOGICAL base
// (MonoInstance.base) is kept separately for find_type_def / field-resolution,
// which key on the type def's logical name; only the C-symbol stem goes physical.
pub fn mono_phys_base(base: Str) -> Str {
    if find_type_def_node(base) == -1 { return base }
    c_type_tag_for_struct(base)
}
pub let mut mono_instances: List[MonoInstance] = []
pub let mut mono_idx: Map[Str, Int] = Map()
pub let mut mono_rev_idx: Map[Str, Int] = Map()

// ms4ctb: polymorphic-impl template registry. Keyed on the trait-qualified
// composed base `mangle_impl_method_q(recv, trait, method)` (e.g.
// "List_Echoable_echo"), these map a poly-impl method back to its FnDef node
// and owning ImplBlock node so the deferred mono pass can substitute the impl
// binders per concrete T. A base present here is a poly-impl base: the mono
// pass routes it through emit_poly_impl_method_def instead of the generic-fn
// emitter. Populated during impl registration (codegen.bl), cleared per
// generate().
pub let mut poly_impl_method_node: Map[Str, Int] = Map()
pub let mut poly_impl_block_node: Map[Str, Int] = Map()

pub fn is_poly_impl_base(base: Str) -> Int {
    poly_impl_method_node.contains_key(base)
}

