fn has_str_in_list(lst: List[Str], val: Str) -> Bool {
    let mut i = 0
    while i < lst.len() {
        if lst.get(i).unwrap() == val {
            return true
        }
        i = i + 1
    }
    false
}

// z9gkt3: register a per-carrier compound adapter. The carrier typedef the adapter
// derefs is ensured (ensure_carrier_from_tag), and the boxed-pointer option the
// iterator carries is blink_Option_int (the list stores compound elements as
// intptr, iterated via the CT_INT pointer iterator).
pub fn ensure_map_iter_c(carrier: Str) {
    if has_str_in_list(emitted_map_iters_c, carrier) { return }
    emitted_map_iters_c.push(carrier)
    ensure_carrier_from_tag(carrier)
    ensure_option_type(CT_INT)
}

