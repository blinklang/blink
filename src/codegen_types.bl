    c_reserved_set.insert("sprintf", 1)
    c_reserved_set.insert("snprintf", 1)
    c_reserved_set.insert("scanf", 1)
    c_reserved_set.insert("malloc", 1)
    c_reserved_set.insert("calloc", 1)
    c_reserved_set.insert("realloc", 1)
    c_reserved_set.insert("free", 1)
    c_reserved_set.insert("exit", 1)
    c_reserved_set.insert("abort", 1)
    c_reserved_set.insert("strlen", 1)
    c_reserved_set.insert("strcmp", 1)
    c_reserved_set.insert("strcpy", 1)
    c_reserved_set.insert("strcat", 1)
    c_reserved_set.insert("memcpy", 1)
    c_reserved_set.insert("memset", 1)
    c_reserved_set.insert("memmove", 1)
    c_reserved_set.insert("memcmp", 1)
    c_reserved_set.insert("strncmp", 1)
