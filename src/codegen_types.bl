pub fn get_var_channel_inner(name: Str) -> Int {
    get_sv_inner1(name, CT_CHANNEL)
}

pub let mut option_typedef_emitted: Map[Str, Int] = Map()
let mut result_typedef_emitted: Map[Str, Int] = Map()

pub fn reset_result_typedef_emitted() {
    result_typedef_emitted = Map()
    tuple_typedef_emitted = Map()
}

// Wrap each typedef in #ifndef/#define/#endif guards so the same typedef
// can appear in libblink_std.h (when the archive header is generated) and
// in user .c files (regular compile path) without redeclaration errors.
pub fn emit_td_guard_open(tname: Str) ! Codegen.Emit {
    emit_line("#ifndef BLINK_TD_{tname}")
    emit_line("#define BLINK_TD_{tname}")
}
pub fn emit_td_guard_close() ! Codegen.Emit {
    emit_line("#endif")
}

// Same as emit_td_guard_*, but appends to cg_lines directly (call sites
// that build their own un-indented lines via cg_lines.push instead of
// going through emit_line).
pub fn push_td_guard_open(tname: Str) {
    cg_lines.push("#ifndef BLINK_TD_{tname}")
    cg_lines.push("#define BLINK_TD_{tname}")
}
pub fn push_td_guard_close() {
    cg_lines.push("#endif")
}

// KNOWN GAP, carrier-position Void (br dq15j7 / vbcw1e). This fn emits NOTHING for a
// CT_VOID inner — the three early returns immediately below — while option_c_type still
// NAMES the type blink_Option_void. So `type QBox[T] { v: Option[T] }` instantiated at
// Void references a typedef that was never defined. Until that is closed, the encodability
// gates REFUSE a genuine Void carrier inner on purpose: admitting it trades a located
// I0001 for an opaque cc error.
//
// emit_result_typedef's int64_t leaf (:6481-6482) is NOT a template to copy here. It keys
// on CT_VOID alone, and because type_from_name collapses every unknown name onto CT_VOID,
// a CT-keyed rule in a CARRIER position would swallow an ERASED inner into a well-typed
// field instead of failing the C compile — losing the `void <name>;` tripwire CLAUDE.md
// describes as load-bearing.
//
// There is a SECOND defect behind the same gate that this typedef is not the whole of: the
// struct literal spelled `None` at T=Void as blink_Option_int, a mistyped carrier from a
// different speller. Carrier-position Void is its own mechanism and its own ticket.
//
// (This note used to live on tc_poly_inner_encodable in typecheck.bl. That gate existed
// only to keep the tid CSV byte-matching the string CSV twin and died with it in br
// 3fc3pn, so the rationale was moved to the emitter it actually describes.)
pub fn emit_option_typedef(inner: Int) ! Codegen.Emit {
    if inner == CT_VOID { return }
    let tag = c_type_tag(inner)
    if tag == "void" || tag == "" { return }
    let tname = "blink_Option_{tag}"
    if option_typedef_emitted.contains_key(tname) != 0 { return }
    option_typedef_emitted.insert(tname, 1)
    let c_inner = c_type_str(inner)
    if c_inner == "void" { return }
    emit_td_guard_open(tname)
    emit_line("typedef struct \{ int tag; {c_inner} value; } {tname};")
    emit_td_guard_close()
    emit_line("")
}

fn emit_result_typedef(ok_t: Int, err_t: Int) ! Codegen.Emit {
    let ok_tag = c_type_tag(ok_t)
    let err_tag = c_type_tag(err_t)
    let tname = "blink_Result_{ok_tag}_{err_tag}"
    if result_typedef_emitted.contains_key(tname) != 0 { return }
    result_typedef_emitted.insert(tname, 1)
    if tname == "blink_Result_str_str" {
        // Pre-declared in runtime_core.h so runtime helpers can return it.
        return
    }
    let c_ok = if ok_t == CT_VOID { "int64_t" } else { c_type_str(ok_t) }
    let c_err = if err_t == CT_VOID { "int64_t" } else { c_type_str(err_t) }
    emit_td_guard_open(tname)
    emit_line("typedef struct \{ int tag; union \{ {c_ok} ok; {c_err} err; }; } {tname};")
    emit_td_guard_close()
    emit_line("")
}

pub fn emit_struct_option_typedef(struct_name: Str) ! Codegen.Emit {
    if struct_name == "void" || struct_name == "Void" || struct_name == "" { return }
    let tag = canonical_struct_tag(struct_name)
    let tname = "blink_Option_{tag}"
    if option_typedef_emitted.contains_key(tname) != 0 { return }
    option_typedef_emitted.insert(tname, 1)
    // The carrier stores the inner by-value tuple through a pointer; the tuple's
    // own typedef must precede this one or C reads the unknown name as `int`.
    // Idempotent + a no-op if `tag` isn't a registered tuple.
    emit_tuple_typedef_for_tag(tag)
    // Symmetric to the tuple recursion: an inner COMPOUND carrier leaf (e.g.
    // Option[Result[Box[Int],Str]] whose inner tag is Result_Box_Int_str) must
    // have its own carrier typedef emitted before this Option references it, or C
    // reads the still-undeclared member as `int *` (br gw4cyh). The category flush
    // otherwise emits struct-options before struct-results, inverting the
    // outer→inner dependency. Idempotent via result/option_typedef_emitted.
    if is_compound_tag(tag) != 0 {
        emit_carrier_typedef_for_tag(tag)
    }
    let inner_c = c_type_from_tag(tag)
    emit_td_guard_open(tname)
    if is_transparent_newtype(tag) != 0 {
        // Transparent newtype (e.g. Errno): the payload is a bare int64_t, never
        // boxed — mirror the Result carrier which stores the scalar inline. The
        // else-branch's int64_t* boxing would force a heap pointer the construct
        // and match paths don't allocate (br e8n2n3).
        emit_line("typedef struct \{ int tag; {inner_c} value; } {tname};")
    } else if inner_c.ends_with("*") {
        emit_line("typedef struct \{ int tag; {inner_c} value; } {tname};")
    } else {
        emit_line("typedef struct \{ int tag; {inner_c}* value; } {tname};")
    }
    emit_td_guard_close()
    emit_line("")
}

pub fn is_compound_tag(tag: Str) -> Int {
    if tag.starts_with("Option_") || tag.starts_with("Result_") || tag.starts_with("Map_") {
        1
    } else {
        0
    }
}

// The CT_* kind a canonical compound carrier tag denotes (Option_str → CT_OPTION).
pub fn compound_tag_ct(tag: Str) -> Int {
    if tag.starts_with("Option_") { CT_OPTION }
    else if tag.starts_with("Result_") { CT_RESULT }
    else if tag.starts_with("Map_") { CT_MAP }
    else { CT_VOID }
}

// True when `tag` names a registered monomorphized struct/enum INSTANCE (e.g.
// `Box_Int`) — one whose mono base resolves to a struct/enum type. The mono
// registry (mono_rev_idx) is populated at registration time, EARLIER than the
// mono struct typedef is physically emitted into struct_reg_set. A consumer that
// runs during statement emission before the typedef flush (a match arm binding a
// carrier-of-struct-instance payload, br gw4cyh) therefore can't rely on
// is_struct_type — but the instance is already in the registry, so this recovers
// it. Excludes generic-FN mono instances (base is not a struct/enum).
pub fn is_mono_struct_instance(tag: Str) -> Int {
    let base = lookup_mono_base(tag).base
    if base == "" { return 0 }
    if is_struct_type(base) != 0 || is_enum_type(base) != 0 { return 1 }
    0
}

pub fn is_named_typedef_tag(tag: Str) -> Int {
    if is_compound_tag(tag) != 0 { return 1 }
    if is_struct_type(tag) != 0 || is_enum_type(tag) != 0 { return 1 }
    if is_canonical_struct_tag(tag) != 0 { return 1 }
    if is_mono_struct_instance(tag) != 0 { return 1 }
    0
}

pub fn typedef_tag_or_empty(tag: Str) -> Str {
    if is_named_typedef_tag(tag) != 0 { tag } else { "" }
}

// A transparent newtype lowers to a bare `int64_t` wherever it appears as an
// Option/Result carrier member, instead of its boxed tagged-enum struct, so the
// syscall return path carries no box/tag over the Int (br ja9jev, panel 6-0
// "transparent / zero-cost" invariant). Scoped to the literal name `Errno` for
// v1 — a general "any single-scalar single-variant enum is transparent" rule
// would silently change the ABI of other enums (e.g. Pid-style breakage).
// Generalize only when a second transparent newtype actually lands (YAGNI).
pub fn is_transparent_newtype(tag: Str) -> Int {
    // Name gate (v1, scoped to `Errno`): accept the bare name, a dot-qualified
    // form (`std.errno.Errno`), and the canonical underscore-prefixed carrier tag
    // (`std_errno_Errno`, produced by c_type_c_name for a stdlib-module type) so
    // the Result typedef member and the construct/match lowering always agree.
    let mut name_ok = 0
    if tag == "Errno" { name_ok = 1 }
    else if strip_module_qualifier(tag) == "Errno" { name_ok = 1 }
    else if tag.ends_with("_Errno") { name_ok = 1 }
    if name_ok == 0 { return 0 }
    // Shape gate: the transparency lowering (bare int64_t, no tag, identity
    // binding) is only sound for the intended single-variant single-Int-payload
    // enum. A user-defined `Errno` of any other shape (multi-variant, non-Int or
    // multi-field payload) must fall through to normal boxed enum codegen — name
    // alone would otherwise silently miscompile it.
    let vidx = get_variant_index("Errno", "Errno")
    if vidx < 0 { return 0 }
    let ev = enum_variants.get(vidx).unwrap()
    if ev.field_count != 1 { return 0 }
    // Exactly one variant in the enum (no sibling variants sharing its enum_idx).
    let mut sibling_count = 0
    let mut i = 0
    while i < enum_variants.len() {
        if enum_variants.get(i).unwrap().enum_idx == ev.enum_idx {
            sibling_count = sibling_count + 1
        }
        i = i + 1
    }
    if sibling_count != 1 { return 0 }
    // Single payload must be Int.
    match get_variant_field_type_str(vidx, 0) {
        Some(ft) => if ft != "Int" { return 0 }
        None => return 0
    }
    1
}

pub fn c_type_from_tag(tag: Str) -> Str {
    if is_transparent_newtype(tag) != 0 {
        // Transparent: the carrier member is a bare int64_t, never blink_Errno.
        "int64_t"
    } else if is_struct_type(tag) != 0 || is_enum_type(tag) != 0 {
        // Bare tag — defer to c_type_c_name so module prefix propagates.
        c_type_c_name(tag)
    } else if tag.starts_with("Map_") {
        "blink_map*"
    } else if is_compound_tag(tag) != 0 {
        "blink_{tag}"
    } else if is_canonical_struct_tag(tag) != 0 {
        // Canonical tag (e.g. `std_db_row_Row`) already carries the module
        // prefix — the C name is just `blink_<tag>`.
        "blink_{tag}"
    } else if is_mono_struct_instance(tag) != 0 {
        // A registered monomorphized struct/enum INSTANCE (e.g. `RBox_Int`): the
        // bare head (`RBox`) is a struct type but the arg-carrying tag is not, so
        // the is_struct_type branch above misses it and it would fall to the
        // CT_VOID default. The instance is in the mono registry (the carrier's
        // struct-instance leaves are pre-registered from their annotation tid —
        // register_carrier_struct_instance_leaves), so recover its C name directly:
        // the typedef is `blink_<tag>` (br f9mqbq). Without this a struct-instance
        // carrier member (Result[RBox[Int],RBox[Str]]) erases to `void`, violating
        // the monomorphization guarantee (§03_types.md:2066).
        "blink_{tag}"
    } else {
        c_type_str(type_from_name_tag(tag))
    }
}

// Recognizes module-prefixed canonical struct tags like `std_db_row_Row`.
// True when the tag's trailing component after the LAST `_` is a registered
// struct or enum AND the preceding prefix matches the entry in
// `mod_type_prefix` for that bare name.
pub fn is_canonical_struct_tag(tag: Str) -> Int {
    let mut i = tag.len() - 1
    while i > 0 {
        if tag.byte_at(i) == 95 { // '_'
            let bare = tag.substring(i + 1, tag.len() - i - 1)
            let prefix = tag.substring(0, i)
            if struct_reg_set.contains_key(bare) != 0 || enum_reg_set.contains_key(bare) != 0 {
                // Composite key first: when two modules share the bare name, the
                // bare mod_type_prefix entry only holds the last writer's prefix,
                // so a tag prefixed by the OTHER module would miss. The composite
                // "{prefix}:{bare}" entry is written for every defining module,
                // so it recognizes both (br eczcwr).
                if mod_type_prefix.contains_key("{prefix}:{bare}") != 0 { return 1 }
                match mod_type_prefix.get(bare) {
                    Some(p) => {
                        if p == prefix { return 1 }
                    }
                    None => {}
                }
            }
        }
        i = i - 1
    }
    0
}

pub fn emit_struct_result_typedef(ok_tag: Str, err_tag: Str) ! Codegen.Emit {
    let tname = "blink_Result_{ok_tag}_{err_tag}"
    if result_typedef_emitted.contains_key(tname) != 0 { return }
    result_typedef_emitted.insert(tname, 1)
    if tname == "blink_Result_str_str" {
        // Pre-declared in runtime_core.h so runtime helpers can return it.
        return
    }
    // A struct-result carries its ok/err tuple BY VALUE, so emit those tuple
    // typedefs now rather than relying on the global emit order (which puts
    // option/result before tuples — correct only for the reverse nesting). See
    // tests/test_295z9x and test_tuple_destr_q_propagate.
    emit_tuple_typedef_for_tag(ok_tag)
    emit_tuple_typedef_for_tag(err_tag)
    // Symmetric to the tuple recursion: an ok/err leaf that is itself a COMPOUND
    // carrier (e.g. Result[Option[Box[Int]],Str] whose ok_tag is Option_Box_Int)
    // must have its own carrier typedef precede this one, or C reads the
    // undeclared member as `int *` (br gw4cyh). Idempotent via the emitted guards.
    if is_compound_tag(ok_tag) != 0 {
        emit_carrier_typedef_for_tag(ok_tag)
    }
    if is_compound_tag(err_tag) != 0 {
        emit_carrier_typedef_for_tag(err_tag)
    }
    let c_ok = if ok_tag == "void" || ok_tag == "Void" { "int64_t" } else { c_type_from_tag(ok_tag) }
    let c_err = if err_tag == "void" || err_tag == "Void" { "int64_t" } else { c_type_from_tag(err_tag) }
    emit_td_guard_open(tname)
    emit_line("typedef struct \{ int tag; union \{ {c_ok} ok; {c_err} err; }; } {tname};")
    emit_td_guard_close()
    emit_line("")
}

pub fn type_from_name_tag(tag: Str) -> Int {
    // Compound carrier tags (Option_.., Result_.., Map_..) name a nested
    // container, not a scalar. Recognize their CT so a nested inner (e.g.
    // Option[Option[Int]] whose inner tag is "Option_int") records the right
    // compound CT instead of falling to the CT_VOID default — otherwise the
    // middle .unwrap() dispatch guard (is_compound_ct == 0) mis-routes into the
    // struct branch and the method is reported unresolved (msqtkd issue 2).
    // Scoped to the same tags is_compound_tag / compound_tag_ct recognize.
    if is_compound_tag(tag) != 0 { return compound_tag_ct(tag) }
    if tag == "int" { CT_INT }
    else if tag == "str" { CT_STRING }
    else if tag == "double" { CT_FLOAT }
    else if tag == "bool" { CT_BOOL }
    else if tag == "list" { CT_LIST }
    else if tag == "iter" { CT_ITERATOR }
    else if tag == "handle" { CT_HANDLE }
    else if tag == "channel" { CT_CHANNEL }
    else if tag == "map" { CT_MAP }
    else if tag == "set" { CT_SET }
    else if tag == "bytes" { CT_BYTES }
    else if tag == "stringbuilder" { CT_STRINGBUILDER }
    else if tag == "ptr" { CT_PTR }
    else if tag == "char" { CT_CHAR }
    else if tag == "i8" { CT_I8 }
    else if tag == "i16" { CT_I16 }
    else if tag == "i32" { CT_I32 }
    else if tag == "u8" { CT_U8 }
    else if tag == "u16" { CT_U16 }
    else if tag == "u32" { CT_U32 }
    else if tag == "u64" { CT_U64 }
    else { CT_VOID }
}

pub type MapKvCt {
    first: Int
    second: Int
}

// Decode the key+value CT of a scalar `Map_<ktag>_<vtag>` struct tag, as built
// by `Map_{c_type_tag(k)}_{c_type_tag(v)}`. Returns first = -1 when the tag is
// not a scalar two-field map (e.g. struct/nested value types whose tag has a
// different shape) so callers can fall back to their existing recovery paths.
pub fn map_struct_scalar_kv(tag: Str) -> MapKvCt {
    if tag.starts_with("Map_") == false { return MapKvCt { first: -1, second: -1 } }
    let rest = tag.slice(4, tag.len())
    let mut sep = -1
    let mut i = 0
    while i < rest.len() {
        if rest.byte_at(i) == 95 { // '_'
            sep = i
            i = rest.len()
        } else {
            i = i + 1
        }
    }
    if sep <= 0 { return MapKvCt { first: -1, second: -1 } }
    let k_tag = rest.slice(0, sep)
    let v_tag = rest.slice(sep + 1, rest.len())
    let k_ct = type_from_name_tag(k_tag)
    let v_ct = type_from_name_tag(v_tag)
    if k_ct == CT_VOID || v_ct == CT_VOID {
        return MapKvCt { first: -1, second: -1 }
    }
    // Only scalar key+value are recoverable from the tag alone; compound types
    // (list/map/bytes/ptr/option/result) carry extra metadata that the tag does
    // not encode, so leave those to the caller's other recovery paths.
    if is_map_scalar_ct(k_ct) == 0 || is_map_scalar_ct(v_ct) == 0 {
        return MapKvCt { first: -1, second: -1 }
    }
    MapKvCt { first: k_ct, second: v_ct }
}

pub fn is_map_scalar_ct(ct: Int) -> Int {
    if ct == CT_INT || ct == CT_STRING || ct == CT_FLOAT || ct == CT_BOOL || ct == CT_CHAR { return 1 }
    if is_sized_int_ct(ct) != 0 { return 1 }
    0
}

pub type CompoundSplit {
    first: Str
    second: Str
}

// Byte length of the FIRST complete compound-tag token at the start of `s`. A tag
// is one of: a nested carrier (Map_K_V consumes two sub-tags; Option_T one; Result_O_E
// two) or a leaf (a scalar word like "int"/"str", or a registered struct/enum name that
// may itself contain underscores). Recursive-descent over the same grammar
// tc_tid_inner_tag emits, so it splits `Result_int_Map_str_int` correctly (ok="int",
// err="Map_str_int") where a naive rightmost-underscore scan mis-splits on the trailing
// "_int" of the Map (br e3js70). Returns s.len() when the whole string is one tag.
fn first_tag_len(s: Str) -> Int {
    if s.starts_with("Map_") {
        let after = s.slice(4, s.len())
        let k_len = first_tag_len(after)
        // after = "{K}_{V}..." ; skip K and its trailing '_', then consume V.
        let rest_v = after.slice(k_len + 1, after.len())
        let v_len = first_tag_len(rest_v)
        return 4 + k_len + 1 + v_len
    }
    if s.starts_with("Option_") {
        let after = s.slice(7, s.len())
        return 7 + first_tag_len(after)
    }
    if s.starts_with("Result_") {
        let after = s.slice(7, s.len())
        let ok_len = first_tag_len(after)
        let rest_e = after.slice(ok_len + 1, after.len())
        let e_len = first_tag_len(rest_e)
        return 7 + ok_len + 1 + e_len
    }
    // Leaf: a registered struct/enum name may span multiple underscore-groups
    // (std_db_row_Row). Take the LONGEST prefix that names a known struct/enum; else
    // fall back to a single scalar underscore-group (up to the first '_' or end).
    let mut best = -1
    let mut i = s.len()
    while i > 0 {
        let cand = s.slice(0, i)
        if is_struct_type(cand) != 0 || is_enum_type(cand) != 0 || is_mono_struct_instance(cand) != 0 || is_canonical_struct_tag(cand) != 0 {
            best = i
            i = 0
        } else {
            i = i - 1
        }
    }
    if best > 0 { return best }
    let mut j = 0
    while j < s.len() {
        if s.byte_at(j) == 95 { return j }
        j = j + 1
    }
    s.len()
}

pub fn split_result_compound(compound: Str) -> CompoundSplit {
    let rest = compound.slice(7, compound.len())
    let ok_len = first_tag_len(rest)
    if ok_len < rest.len() {
        CompoundSplit { first: rest.slice(0, ok_len), second: rest.slice(ok_len + 1, rest.len()) }
    } else {
        CompoundSplit { first: rest, second: "" }
    }
}

pub fn ensure_iter_type(inner: Int) {
    let key = "{inner}"
    if emitted_iter_set.contains_key(key) != 0 {
        return
    }
    emitted_iter_set.insert(key, 1)
    emitted_iter_types.push(inner)
    ensure_option_type(inner)
}

pub fn ensure_range_iter() {
    if emitted_range_iter != 0 {
        return
    }
    emitted_range_iter = 1
    ensure_option_type(CT_INT)
}

pub fn ensure_str_iter() {
    if emitted_str_iter != 0 {
        return
    }
    emitted_str_iter = 1
    ensure_option_type(CT_STRING)
}

pub fn emit_range_iter_typedef() ! Codegen.Emit {
    emit_td_guard_open("blink_RangeIterator")
    emit_line("typedef struct \{ int64_t current; int64_t end; int is_inclusive; } blink_RangeIterator;")
    emit_td_guard_close()
    emit_line("")
    emit_line("static blink_Option_int blink_RangeIterator_next(blink_RangeIterator* self) \{")
    emit_line("    int in_range = self->is_inclusive ? (self->current <= self->end) : (self->current < self->end);")
    emit_line("    if (in_range) \{")
    emit_line("        int64_t val = self->current;")
    emit_line("        self->current++;")
    emit_line("        return (blink_Option_int)\{ .tag = 1, .value = val };")
    emit_line("    }")
    emit_line("    return (blink_Option_int)\{ .tag = 0 };")
    emit_line("}")
    emit_line("")
}

pub fn emit_str_iter_typedef() ! Codegen.Emit {
    emit_td_guard_open("blink_StrIterator")
    emit_line("typedef struct \{ const char* str; int64_t index; int64_t len; } blink_StrIterator;")
    emit_td_guard_close()
    emit_line("")
    emit_line("static blink_Option_str blink_StrIterator_next(blink_StrIterator* self) \{")
    emit_line("    if (self->index < self->len) \{")
    emit_line("        const char* val = blink_str_from_char_code((int64_t)(unsigned char)self->str[self->index]);")
    emit_line("        self->index++;")
    emit_line("        return (blink_Option_str)\{ .tag = 1, .value = val };")
    emit_line("    }")
    emit_line("    return (blink_Option_str)\{ .tag = 0 };")
    emit_line("}")
    emit_line("")
}

pub fn list_iter_c_type(inner: Int) -> Str {
    "blink_ListIterator_{c_type_tag(inner)}"
}

fn emit_list_iter_typedef(inner: Int) ! Codegen.Emit {
    let tag = c_type_tag(inner)
    let tname = "blink_ListIterator_{tag}"
    let opt_name = option_c_type(inner)
    let c_inner = c_type_str(inner)
    emit_td_guard_open(tname)
    emit_line("typedef struct \{ blink_list* items; int64_t index; } {tname};")
    emit_td_guard_close()
    emit_line("")
    emit_line("static {opt_name} {tname}_next({tname}* self) \{")
    emit_line("    if (self->index < blink_list_len(self->items)) \{")
    if inner == CT_INT {
        emit_line("        int64_t val = (int64_t)(intptr_t)blink_list_get(self->items, self->index);")
    } else if inner == CT_STRING {
        emit_line("        const char* val = (const char*)blink_list_get(self->items, self->index);")
    } else if inner == CT_FLOAT {
        emit_line("        double val = *(double*)blink_list_get(self->items, self->index);")
    } else {
        emit_line("        {c_inner} val = ({c_inner})(intptr_t)blink_list_get(self->items, self->index);")
    }
    emit_line("        self->index++;")
    emit_line("        return ({opt_name})\{ .tag = 1, .value = val };")
    emit_line("    }")
    emit_line("    return ({opt_name})\{ .tag = 0 };")
    emit_line("}")
    emit_line("")
    emit_line("static {tname} blink_list_into_iter_{tag}(blink_list* self) \{")
    emit_line("    return ({tname})\{ .items = self, .index = 0 };")
    emit_line("}")
    emit_line("")
}

pub fn emit_all_iter_types() ! Codegen.Emit {
    if emitted_range_iter != 0 {
        emit_range_iter_typedef()
    }
    if emitted_str_iter != 0 {
        emit_str_iter_typedef()
    }
    let mut i = 0
    while i < emitted_iter_types.len() {
        emit_list_iter_typedef(emitted_iter_types.get(i).unwrap())
        i = i + 1
    }
    i = 0
    while i < emitted_map_iters.len() {
        emit_map_iter_typedef(emitted_map_iters.get(i).unwrap())
        i = i + 1
    }
    i = 0
    while i < emitted_filter_iters.len() {
        emit_filter_iter_typedef(emitted_filter_iters.get(i).unwrap())
        i = i + 1
    }
    i = 0
    while i < emitted_take_iters.len() {
        emit_take_iter_typedef(emitted_take_iters.get(i).unwrap())
        i = i + 1
    }
    i = 0
    while i < emitted_skip_iters.len() {
        emit_skip_iter_typedef(emitted_skip_iters.get(i).unwrap())
        i = i + 1
    }
    i = 0
    while i < emitted_chain_iters.len() {
        emit_chain_iter_typedef(emitted_chain_iters.get(i).unwrap())
        i = i + 1
    }
    i = 0
    while i < emitted_flat_map_iters.len() {
        emit_flat_map_iter_typedef(emitted_flat_map_iters.get(i).unwrap())
        i = i + 1
    }
    // z9gkt3: the per-carrier compound adapters (main pass drains from 0).
    i = 0
    while i < emitted_map_iters_c.len() {
        emit_map_iter_typedef_c(emitted_map_iters_c.get(i).unwrap())
        i = i + 1
    }
    i = 0
    while i < emitted_filter_iters_c.len() {
        emit_filter_iter_typedef_c(emitted_filter_iters_c.get(i).unwrap())
        i = i + 1
    }
    i = 0
    while i < emitted_take_iters_c.len() {
        emit_take_iter_typedef_c(emitted_take_iters_c.get(i).unwrap())
        i = i + 1
    }
    i = 0
    while i < emitted_skip_iters_c.len() {
        emit_skip_iter_typedef_c(emitted_skip_iters_c.get(i).unwrap())
        i = i + 1
    }
    i = 0
    while i < emitted_chain_iters_c.len() {
        emit_chain_iter_typedef_c(emitted_chain_iters_c.get(i).unwrap())
        i = i + 1
    }
    i = 0
    while i < emitted_flat_map_iters_c.len() {
        emit_flat_map_iter_typedef_c(emitted_flat_map_iters_c.get(i).unwrap())
        i = i + 1
    }
}

pub fn emit_iter_types_from(list_start: Int, map_start: Int, filter_start: Int, take_start: Int, skip_start: Int, chain_start: Int, flat_map_start: Int, map_c_start: Int, filter_c_start: Int, take_c_start: Int, skip_c_start: Int, chain_c_start: Int, flat_map_c_start: Int) ! Codegen.Emit {
    let mut i = list_start
    while i < emitted_iter_types.len() {
        emit_list_iter_typedef(emitted_iter_types.get(i).unwrap())
        i = i + 1
    }
    i = map_start
    while i < emitted_map_iters.len() {
        emit_map_iter_typedef(emitted_map_iters.get(i).unwrap())
        i = i + 1
    }
    i = filter_start
    while i < emitted_filter_iters.len() {
        emit_filter_iter_typedef(emitted_filter_iters.get(i).unwrap())
        i = i + 1
    }
    i = take_start
    while i < emitted_take_iters.len() {
        emit_take_iter_typedef(emitted_take_iters.get(i).unwrap())
        i = i + 1
    }
    i = skip_start
    while i < emitted_skip_iters.len() {
        emit_skip_iter_typedef(emitted_skip_iters.get(i).unwrap())
        i = i + 1
    }
    i = chain_start
    while i < emitted_chain_iters.len() {
        emit_chain_iter_typedef(emitted_chain_iters.get(i).unwrap())
        i = i + 1
    }
    i = flat_map_start
    while i < emitted_flat_map_iters.len() {
        emit_flat_map_iter_typedef(emitted_flat_map_iters.get(i).unwrap())
        i = i + 1
    }
    // z9gkt3: the per-carrier compound adapters (the static _next fn is emitted
    // OUTSIDE the #ifndef typedef guard, so re-emitting a compound iter in the same
    // TU is a C redefinition error — drain from the per-test snapshot, not 0).
    i = map_c_start
    while i < emitted_map_iters_c.len() {
        emit_map_iter_typedef_c(emitted_map_iters_c.get(i).unwrap())
        i = i + 1
    }
    i = filter_c_start
    while i < emitted_filter_iters_c.len() {
        emit_filter_iter_typedef_c(emitted_filter_iters_c.get(i).unwrap())
        i = i + 1
    }
    i = take_c_start
    while i < emitted_take_iters_c.len() {
        emit_take_iter_typedef_c(emitted_take_iters_c.get(i).unwrap())
        i = i + 1
    }
    i = skip_c_start
    while i < emitted_skip_iters_c.len() {
        emit_skip_iter_typedef_c(emitted_skip_iters_c.get(i).unwrap())
        i = i + 1
    }
    i = chain_c_start
    while i < emitted_chain_iters_c.len() {
        emit_chain_iter_typedef_c(emitted_chain_iters_c.get(i).unwrap())
        i = i + 1
    }
    i = flat_map_c_start
    while i < emitted_flat_map_iters_c.len() {
        emit_flat_map_iter_typedef_c(emitted_flat_map_iters_c.get(i).unwrap())
        i = i + 1
    }
}

fn has_int_in_list(lst: List[Int], val: Int) -> Bool {
    let mut i = 0
    while i < lst.len() {
        if lst.get(i).unwrap() == val {
            return true
        }
        i = i + 1
    }
    false
}

pub fn ensure_map_iter(inner: Int) {
    if has_int_in_list(emitted_map_iters, inner) { return }
    emitted_map_iters.push(inner)
    ensure_option_type(inner)
}

pub fn ensure_filter_iter(inner: Int) {
    if has_int_in_list(emitted_filter_iters, inner) { return }
    emitted_filter_iters.push(inner)
    ensure_option_type(inner)
}

