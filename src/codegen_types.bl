pub fn reg_sf_entry(struct_name: Str, field_name: Str, field_type: Int, stype: Str, tp_id: Int, tid: Int) {
    let key = struct_name.concat("\t").concat(field_name)
    if !sf_entries_idx.contains_key(key) {
        sf_entries_idx.insert(key, sf_entries.len())
    }
    sf_entries.push(StructFieldEntry { struct_name: struct_name, field_name: field_name, field_type: field_type, stype: stype, tp_id: tp_id, tid: tid })
}

