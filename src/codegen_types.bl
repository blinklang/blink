fn emit_map_iter_typedef(inner: Int) ! Codegen.Emit {
    let tag = c_type_tag(inner)
    let opt = option_c_type(inner)
    let c_inner = c_type_str(inner)
    emit_td_guard_open("blink_MapIterator_{tag}")
    emit_line("typedef struct \{ void* source; {opt} (*source_next)(void*); blink_closure* fn; } blink_MapIterator_{tag};")
    emit_td_guard_close()
    emit_line("")
    emit_line("static {opt} blink_MapIterator_{tag}_next(void* __self) \{")
    emit_line("    blink_MapIterator_{tag}* self = (blink_MapIterator_{tag}*)__self;")
    emit_line("    {opt} __src = self->source_next(self->source);")
    emit_line("    if (__src.tag == 0) return ({opt})\{ .tag = 0 };")
    emit_line("    {c_inner} __val = (({c_inner} (*)(const blink_closure*, {c_inner}))self->fn->fn_ptr)(self->fn, __src.value);")
    emit_line("    return ({opt})\{ .tag = 1, .value = __val };")
    emit_line("}")
    emit_line("")
}

fn emit_filter_iter_typedef(inner: Int) ! Codegen.Emit {
    let tag = c_type_tag(inner)
    let opt = option_c_type(inner)
    let c_inner = c_type_str(inner)
    emit_td_guard_open("blink_FilterIterator_{tag}")
    emit_line("typedef struct \{ void* source; {opt} (*source_next)(void*); blink_closure* fn; } blink_FilterIterator_{tag};")
    emit_td_guard_close()
    emit_line("")
    emit_line("static {opt} blink_FilterIterator_{tag}_next(void* __self) \{")
    emit_line("    blink_FilterIterator_{tag}* self = (blink_FilterIterator_{tag}*)__self;")
    emit_line("    while (1) \{")
    emit_line("        {opt} __src = self->source_next(self->source);")
    emit_line("        if (__src.tag == 0) return ({opt})\{ .tag = 0 };")
    emit_line("        if (((int (*)(const blink_closure*, {c_inner}))self->fn->fn_ptr)(self->fn, __src.value)) \{")
    emit_line("            return __src;")
    emit_line("        }")
    emit_line("    }")
    emit_line("}")
    emit_line("")
}

fn emit_take_iter_typedef(inner: Int) ! Codegen.Emit {
    let tag = c_type_tag(inner)
    let opt = option_c_type(inner)
    emit_td_guard_open("blink_TakeIterator_{tag}")
    emit_line("typedef struct \{ void* source; {opt} (*source_next)(void*); int64_t limit; int64_t count; } blink_TakeIterator_{tag};")
    emit_td_guard_close()
    emit_line("")
    emit_line("static {opt} blink_TakeIterator_{tag}_next(void* __self) \{")
    emit_line("    blink_TakeIterator_{tag}* self = (blink_TakeIterator_{tag}*)__self;")
    emit_line("    if (self->count >= self->limit) return ({opt})\{ .tag = 0 };")
    emit_line("    {opt} __src = self->source_next(self->source);")
    emit_line("    if (__src.tag == 0) return __src;")
    emit_line("    self->count++;")
    emit_line("    return __src;")
    emit_line("}")
    emit_line("")
}

fn emit_skip_iter_typedef(inner: Int) ! Codegen.Emit {
    let tag = c_type_tag(inner)
    let opt = option_c_type(inner)
    emit_td_guard_open("blink_SkipIterator_{tag}")
    emit_line("typedef struct \{ void* source; {opt} (*source_next)(void*); int64_t skip_n; int64_t skipped; } blink_SkipIterator_{tag};")
    emit_td_guard_close()
    emit_line("")
    emit_line("static {opt} blink_SkipIterator_{tag}_next(void* __self) \{")
    emit_line("    blink_SkipIterator_{tag}* self = (blink_SkipIterator_{tag}*)__self;")
    emit_line("    while (self->skipped < self->skip_n) \{")
    emit_line("        {opt} __src = self->source_next(self->source);")
    emit_line("        if (__src.tag == 0) return __src;")
    emit_line("        self->skipped++;")
    emit_line("    }")
    emit_line("    return self->source_next(self->source);")
    emit_line("}")
    emit_line("")
}

fn emit_chain_iter_typedef(inner: Int) ! Codegen.Emit {
    let tag = c_type_tag(inner)
    let opt = option_c_type(inner)
    emit_td_guard_open("blink_ChainIterator_{tag}")
    emit_line("typedef struct \{ void* source_a; {opt} (*next_a)(void*); void* source_b; {opt} (*next_b)(void*); int phase; } blink_ChainIterator_{tag};")
    emit_td_guard_close()
    emit_line("")
    emit_line("static {opt} blink_ChainIterator_{tag}_next(void* __self) \{")
    emit_line("    blink_ChainIterator_{tag}* self = (blink_ChainIterator_{tag}*)__self;")
    emit_line("    if (self->phase == 0) \{")
    emit_line("        {opt} __src = self->next_a(self->source_a);")
    emit_line("        if (__src.tag != 0) return __src;")
    emit_line("        self->phase = 1;")
    emit_line("    }")
    emit_line("    return self->next_b(self->source_b);")
    emit_line("}")
    emit_line("")
}

fn emit_flat_map_iter_typedef(inner: Int) ! Codegen.Emit {
    let tag = c_type_tag(inner)
    let opt = option_c_type(inner)
    let c_inner = c_type_str(inner)
    emit_td_guard_open("blink_FlatMapIterator_{tag}")
    emit_line("typedef struct \{ void* source; {opt} (*source_next)(void*); blink_closure* fn; blink_list* buffer; int64_t buf_idx; } blink_FlatMapIterator_{tag};")
    emit_td_guard_close()
    emit_line("")
    emit_line("static {opt} blink_FlatMapIterator_{tag}_next(void* __self) \{")
    emit_line("    blink_FlatMapIterator_{tag}* self = (blink_FlatMapIterator_{tag}*)__self;")
    emit_line("    while (1) \{")
    emit_line("        if (self->buffer && self->buf_idx < blink_list_len(self->buffer)) \{")
    if inner == CT_INT {
        emit_line("            {c_inner} val = (int64_t)(intptr_t)blink_list_get(self->buffer, self->buf_idx);")
    } else if inner == CT_STRING {
        emit_line("            {c_inner} val = (const char*)blink_list_get(self->buffer, self->buf_idx);")
    } else if inner == CT_FLOAT {
        emit_line("            double val = *(double*)blink_list_get(self->buffer, self->buf_idx);")
    } else {
        emit_line("            {c_inner} val = ({c_inner})(intptr_t)blink_list_get(self->buffer, self->buf_idx);")
    }
    emit_line("            self->buf_idx++;")
    emit_line("            return ({opt})\{ .tag = 1, .value = val };")
    emit_line("        }")
    emit_line("        {opt} __src = self->source_next(self->source);")
    emit_line("        if (__src.tag == 0) return ({opt})\{ .tag = 0 };")
    emit_line("        self->buffer = ((blink_list* (*)(const blink_closure*, {c_inner}))self->fn->fn_ptr)(self->fn, __src.value);")
    emit_line("        self->buf_idx = 0;")
    emit_line("    }")
    emit_line("}")
    emit_line("")
}

// z9gkt3: the per-carrier compound adapter typedef emitters. Each names the
// typedef `blink_<Kind>Iterator_<carrier>` (distinct from the scalar `_int`),
// carries the boxed-pointer option `blink_Option_int` throughout, and — where the
// scalar template reads `__src.value` as the raw element — derefs the boxed
// carrier by value with `(*(blink_<carrier>*)(intptr_t)__src.value)` (the
// hof_elem_value pattern) before handing it to the closure. take/skip/chain have
// no closure — only the typedef NAME changes; they forward `__src` verbatim so the
// boxed carrier survives to a downstream collect/for-in.
fn emit_map_iter_typedef_c(carrier: Str) ! Codegen.Emit {
    let opt = option_c_type(CT_INT)
    let carrier_c = c_type_from_tag(carrier)
    emit_td_guard_open("blink_MapIterator_{carrier}")
    emit_line("typedef struct \{ void* source; {opt} (*source_next)(void*); blink_closure* fn; } blink_MapIterator_{carrier};")
    emit_td_guard_close()
    emit_line("")
    emit_line("static {opt} blink_MapIterator_{carrier}_next(void* __self) \{")
    emit_line("    blink_MapIterator_{carrier}* self = (blink_MapIterator_{carrier}*)__self;")
    emit_line("    {opt} __src = self->source_next(self->source);")
    emit_line("    if (__src.tag == 0) return ({opt})\{ .tag = 0 };")
    emit_line("    int64_t __val = ((int64_t (*)(const blink_closure*, {carrier_c}))self->fn->fn_ptr)(self->fn, (*({carrier_c}*)(intptr_t)__src.value));")
    emit_line("    return ({opt})\{ .tag = 1, .value = __val };")
    emit_line("}")
    emit_line("")
}

fn emit_filter_iter_typedef_c(carrier: Str) ! Codegen.Emit {
    let opt = option_c_type(CT_INT)
    let carrier_c = c_type_from_tag(carrier)
    emit_td_guard_open("blink_FilterIterator_{carrier}")
    emit_line("typedef struct \{ void* source; {opt} (*source_next)(void*); blink_closure* fn; } blink_FilterIterator_{carrier};")
    emit_td_guard_close()
    emit_line("")
    emit_line("static {opt} blink_FilterIterator_{carrier}_next(void* __self) \{")
    emit_line("    blink_FilterIterator_{carrier}* self = (blink_FilterIterator_{carrier}*)__self;")
    emit_line("    while (1) \{")
    emit_line("        {opt} __src = self->source_next(self->source);")
    emit_line("        if (__src.tag == 0) return ({opt})\{ .tag = 0 };")
    emit_line("        if (((int (*)(const blink_closure*, {carrier_c}))self->fn->fn_ptr)(self->fn, (*({carrier_c}*)(intptr_t)__src.value))) \{")
    emit_line("            return __src;")
    emit_line("        }")
    emit_line("    }")
    emit_line("}")
    emit_line("")
}

fn emit_take_iter_typedef_c(carrier: Str) ! Codegen.Emit {
    let opt = option_c_type(CT_INT)
    emit_td_guard_open("blink_TakeIterator_{carrier}")
    emit_line("typedef struct \{ void* source; {opt} (*source_next)(void*); int64_t limit; int64_t count; } blink_TakeIterator_{carrier};")
    emit_td_guard_close()
    emit_line("")
    emit_line("static {opt} blink_TakeIterator_{carrier}_next(void* __self) \{")
    emit_line("    blink_TakeIterator_{carrier}* self = (blink_TakeIterator_{carrier}*)__self;")
    emit_line("    if (self->count >= self->limit) return ({opt})\{ .tag = 0 };")
    emit_line("    {opt} __src = self->source_next(self->source);")
    emit_line("    if (__src.tag == 0) return __src;")
    emit_line("    self->count++;")
    emit_line("    return __src;")
    emit_line("}")
    emit_line("")
}

fn emit_skip_iter_typedef_c(carrier: Str) ! Codegen.Emit {
    let opt = option_c_type(CT_INT)
    emit_td_guard_open("blink_SkipIterator_{carrier}")
    emit_line("typedef struct \{ void* source; {opt} (*source_next)(void*); int64_t skip_n; int64_t skipped; } blink_SkipIterator_{carrier};")
    emit_td_guard_close()
    emit_line("")
    emit_line("static {opt} blink_SkipIterator_{carrier}_next(void* __self) \{")
    emit_line("    blink_SkipIterator_{carrier}* self = (blink_SkipIterator_{carrier}*)__self;")
    emit_line("    while (self->skipped < self->skip_n) \{")
    emit_line("        {opt} __src = self->source_next(self->source);")
    emit_line("        if (__src.tag == 0) return __src;")
    emit_line("        self->skipped++;")
    emit_line("    }")
    emit_line("    return self->source_next(self->source);")
    emit_line("}")
    emit_line("")
}

fn emit_chain_iter_typedef_c(carrier: Str) ! Codegen.Emit {
    let opt = option_c_type(CT_INT)
    emit_td_guard_open("blink_ChainIterator_{carrier}")
    emit_line("typedef struct \{ void* source_a; {opt} (*next_a)(void*); void* source_b; {opt} (*next_b)(void*); int phase; } blink_ChainIterator_{carrier};")
    emit_td_guard_close()
    emit_line("")
    emit_line("static {opt} blink_ChainIterator_{carrier}_next(void* __self) \{")
    emit_line("    blink_ChainIterator_{carrier}* self = (blink_ChainIterator_{carrier}*)__self;")
    emit_line("    if (self->phase == 0) \{")
    emit_line("        {opt} __src = self->next_a(self->source_a);")
    emit_line("        if (__src.tag != 0) return __src;")
    emit_line("        self->phase = 1;")
    emit_line("    }")
    emit_line("    return self->next_b(self->source_b);")
    emit_line("}")
    emit_line("")
}

fn emit_flat_map_iter_typedef_c(carrier: Str) ! Codegen.Emit {
    let opt = option_c_type(CT_INT)
    let carrier_c = c_type_from_tag(carrier)
    emit_td_guard_open("blink_FlatMapIterator_{carrier}")
    emit_line("typedef struct \{ void* source; {opt} (*source_next)(void*); blink_closure* fn; blink_list* buffer; int64_t buf_idx; } blink_FlatMapIterator_{carrier};")
    emit_td_guard_close()
    emit_line("")
    emit_line("static {opt} blink_FlatMapIterator_{carrier}_next(void* __self) \{")
    emit_line("    blink_FlatMapIterator_{carrier}* self = (blink_FlatMapIterator_{carrier}*)__self;")
    emit_line("    while (1) \{")
    emit_line("        if (self->buffer && self->buf_idx < blink_list_len(self->buffer)) \{")
    emit_line("            int64_t val = (int64_t)(intptr_t)blink_list_get(self->buffer, self->buf_idx);")
    emit_line("            self->buf_idx++;")
    emit_line("            return ({opt})\{ .tag = 1, .value = val };")
    emit_line("        }")
    emit_line("        {opt} __src = self->source_next(self->source);")
    emit_line("        if (__src.tag == 0) return ({opt})\{ .tag = 0 };")
    emit_line("        self->buffer = ((blink_list* (*)(const blink_closure*, {carrier_c}))self->fn->fn_ptr)(self->fn, (*({carrier_c}*)(intptr_t)__src.value));")
    emit_line("        self->buf_idx = 0;")
    emit_line("    }")
    emit_line("}")
    emit_line("")
}

pub fn emit_all_option_result_types() ! Codegen.Emit {
    let mut i = 0
    while i < emitted_option_types.len() {
        emit_option_typedef(emitted_option_types.get(i).unwrap())
        i = i + 1
    }
    i = 0
    while i < emitted_result_types.len() {
        let key = emitted_result_types.get(i).unwrap()
        let mut sep = 0
        let mut j = 0
        while j < key.len() {
            if key.byte_at(j) == 95 { // '_'
                sep = j
            }
            j = j + 1
        }
        let ok_str = key.substring(0, sep)
        let err_str = key.substring(sep + 1, key.len() - sep - 1)
        let ok_t = ct_from_str(ok_str)
        let err_t = ct_from_str(err_str)
        emit_result_typedef(ok_t, err_t)
        i = i + 1
    }
    i = 0
    while i < emitted_struct_option_types.len() {
        emit_struct_option_typedef(emitted_struct_option_types.get(i).unwrap())
        i = i + 1
    }
    i = 0
    while i < emitted_struct_result_types.len() {
        let parts = split_struct_result_key(emitted_struct_result_types.get(i).unwrap())
        emit_struct_result_typedef(parts.first, parts.second)
        i = i + 1
    }
}

// Decode an `s~{ok_tag}~{err_tag}` struct-result key. The '~' separator
// (invalid in C identifiers) lets multi-underscore canonical tags like
// `std_db_row_Row` round-trip unambiguously.
fn split_struct_result_key(key: Str) -> CompoundSplit {
    let stripped = key.substring(2, key.len() - 2)
    let mut sep = -1
    let mut j = 0
    while j < stripped.len() {
        if stripped.byte_at(j) == 126 {
            sep = j
            j = stripped.len()
        } else {
            j = j + 1
        }
    }
    CompoundSplit {
        first: stripped.substring(0, sep),
        second: stripped.substring(sep + 1, stripped.len() - sep - 1),
    }
}

pub fn emit_option_result_types_from(opt_start: Int, res_start: Int, s_opt_start: Int, s_res_start: Int) ! Codegen.Emit {
    let mut i = opt_start
    while i < emitted_option_types.len() {
        emit_option_typedef(emitted_option_types.get(i).unwrap())
        i = i + 1
    }
    i = res_start
    while i < emitted_result_types.len() {
        let key = emitted_result_types.get(i).unwrap()
        let mut sep = 0
        let mut j = 0
        while j < key.len() {
            if key.byte_at(j) == 95 { // '_'
                sep = j
            }
            j = j + 1
        }
        let ok_str = key.substring(0, sep)
        let err_str = key.substring(sep + 1, key.len() - sep - 1)
        let ok_t = ct_from_str(ok_str)
        let err_t = ct_from_str(err_str)
        emit_result_typedef(ok_t, err_t)
        i = i + 1
    }
    i = s_opt_start
    while i < emitted_struct_option_types.len() {
        emit_struct_option_typedef(emitted_struct_option_types.get(i).unwrap())
        i = i + 1
    }
    i = s_res_start
    while i < emitted_struct_result_types.len() {
        let parts = split_struct_result_key(emitted_struct_result_types.get(i).unwrap())
        emit_struct_result_typedef(parts.first, parts.second)
        i = i + 1
    }
}

pub fn is_intrinsic_method(namespace: Str, method: Str) -> Int {
    if namespace == "net" {
        if method == "connect" || method == "close" || method == "read" || method == "write" || method == "read_all" || method == "read_line" || method == "set_timeout" || method == "listen" || method == "accept" || method == "request" || method == "read_bytes" || method == "write_bytes" {
            return 1
        }
    }
    if namespace == "io" {
        if method == "println" || method == "print" || method == "eprintln" || method == "debug" || method == "read_line" {
            return 1
        }
    }
    if namespace == "fs" {
        if method == "read" || method == "write" || method == "list_dir" || method == "remove" {
            return 1
        }
    }
    if namespace == "term" {
        if method == "isatty" || method == "width" || method == "height" {
            return 1
        }
    }
    if namespace == "env" {
        if method == "args" {
            return 1
        }
    }
    if namespace == "time" {
        if method == "read" || method == "sleep" {
            return 1
        }
    }
    if namespace == "async" {
        if method == "spawn" {
            return 1
        }
    }
    if namespace == "ffi" {
        if method == "scope" {
            return 1
        }
    }
    0
}

pub fn fresh_temp(prefix: Str) -> Str {
    let n = cg_temp_counter
    cg_temp_counter = cg_temp_counter + 1
    "{prefix}{n}"
}

pub fn emit_line(line: Str) ! Codegen.Emit {
    if line == "" {
        cg_lines.push("")
    } else {
        let mut pad = ""
        let mut i = 0
        while i < cg_indent {
            pad = pad.concat("    ")
            i = i + 1
        }
        cg_lines.push(pad.concat(line))
    }
}

pub fn join_lines() -> Str ! Codegen.Emit {
    cg_lines.join("\n")
}

pub fn emit_bh_cleanup_for_type(struct_name: Str) ! Codegen.Emit {
    if cg_bh_cleanup_set.contains_key(struct_name) {
        return
    }
    cg_bh_cleanup_set.insert(struct_name, 1)
    let c_type = c_type_c_name(struct_name)
    let exit_fn = c_fn_name(mangle_impl_method_q(struct_name, "BlockHandler", "exit"))
    cg_closure_defs.push("typedef struct \{")
    cg_closure_defs.push("    {c_type} handler;")
    cg_closure_defs.push("    int64_t ok;")
    cg_closure_defs.push("    int64_t entered;")
    cg_closure_defs.push("    int done;")
    cg_closure_defs.push("} __blink_bh_state_{c_type};")
    cg_closure_defs.push("")
    // Run-once exit: shared by the normal-exit attribute-cleanup and the
    // assert_panics longjmp dispatch (spec §2.20). `done` guarantees exactly
    // one exit() per handler regardless of which path fires first.
    cg_closure_defs.push("static void __blink_bh_run_{c_type}(void* p, int ok) \{")
    cg_closure_defs.push("    __blink_bh_state_{c_type}* st = (__blink_bh_state_{c_type}*)p;")
    cg_closure_defs.push("    if (st->done) \{ return; }")
    cg_closure_defs.push("    st->done = 1;")
    cg_closure_defs.push("    if (st->entered) \{ {exit_fn}(st->handler, ok); }")
    cg_closure_defs.push("}")
    cg_closure_defs.push("static void __blink_bh_cleanup_{c_type}(__blink_bh_state_{c_type}* st) \{")
    // Normal scope exit: pop our own cleanup-stack entry (if we pushed one
    // while armed) so a sibling's dispatch never re-runs it, then exit.
    cg_closure_defs.push("    __blink_cleanup_pop((void*)st);")
    cg_closure_defs.push("    __blink_bh_run_{c_type}((void*)st, (int)st->ok);")
    cg_closure_defs.push("}")
    cg_closure_defs.push("")
}

pub fn emit_cl_cleanup_for_type(struct_name: Str) ! Codegen.Emit {
    if cg_cl_cleanup_set.contains_key(struct_name) {
        return
    }
    cg_cl_cleanup_set.insert(struct_name, 1)
    let c_type = c_type_c_name(struct_name)
    let close_fn = c_fn_name(mangle_impl_method_q(struct_name, "Closeable", "close"))
    cg_closure_defs.push("typedef struct \{")
    cg_closure_defs.push("    {c_type} resource;")
    cg_closure_defs.push("    int done;")
    cg_closure_defs.push("} __blink_cl_state_{c_type};")
    cg_closure_defs.push("")
    // Run-once close: shared by the normal-exit attribute-cleanup and the
    // assert_panics longjmp dispatch (spec §2.20). Closeable.close() ignores
    // the ok flag, so the `ok` parameter is unused here.
    cg_closure_defs.push("static void __blink_cl_run_{c_type}(void* p, int ok) \{")
    cg_closure_defs.push("    (void)ok;")
    cg_closure_defs.push("    __blink_cl_state_{c_type}* st = (__blink_cl_state_{c_type}*)p;")
    cg_closure_defs.push("    if (st->done) \{ return; }")
    cg_closure_defs.push("    st->done = 1;")
    cg_closure_defs.push("    {close_fn}(st->resource);")
    cg_closure_defs.push("}")
    cg_closure_defs.push("static void __blink_cl_cleanup_{c_type}(__blink_cl_state_{c_type}* st) \{")
    cg_closure_defs.push("    __blink_cleanup_pop((void*)st);")
    cg_closure_defs.push("    __blink_cl_run_{c_type}((void*)st, 0);")
    cg_closure_defs.push("}")
    cg_closure_defs.push("")
}

pub fn emit_ev_restore_helper() ! Codegen.Emit {
    if cg_ev_restore_emitted != 0 {
        return
    }
    cg_ev_restore_emitted = 1
    cg_closure_defs.push("typedef struct \{ void** slot; void* saved; } __blink_ev_restore_t;")
    cg_closure_defs.push("static void __blink_ev_restore(__blink_ev_restore_t* st) \{")
    cg_closure_defs.push("    *st->slot = st->saved;")
    cg_closure_defs.push("}")
    cg_closure_defs.push("")
}

pub fn emit_arena_restore_helper() ! Codegen.Emit {
    if cg_arena_helper_emitted != 0 {
        return
    }
    cg_arena_helper_emitted = 1
    cg_closure_defs.push("typedef struct \{ blink_arena_t* prev; blink_arena_t* arena; } __blink_arena_restore_t;")
    cg_closure_defs.push("static void __blink_arena_restore(__blink_arena_restore_t* st) \{")
    cg_closure_defs.push("    __blink_current_arena = st->prev;")
    cg_closure_defs.push("    blink_arena_destroy(st->arena);")
    cg_closure_defs.push("}")
    cg_closure_defs.push("")
}

pub fn emit_handle_cleanup(close_fn: Str) ! Codegen.Emit {
    let key = "hcl:{close_fn}"
    if cg_cl_cleanup_set.contains_key(key) {
        return
    }
    cg_cl_cleanup_set.insert(key, 1)
    cg_closure_defs.push("typedef struct \{ void* handle; } __blink_hcl_state_{close_fn};")
    cg_closure_defs.push("static void __blink_hcl_cleanup_{close_fn}(__blink_hcl_state_{close_fn}* st) \{")
    cg_closure_defs.push("    {close_fn}(st->handle);")
    cg_closure_defs.push("}")
    cg_closure_defs.push("")
}

pub fn c_type_for_alias(base_name: Str) -> Str {
    if base_name == "Int" { return "int64_t" }
    if base_name == "Float" { return "double" }
    if base_name == "Bool" { return "int64_t" }
    if base_name == "Str" { return "const char*" }
    return "blink_{base_name}"
}
