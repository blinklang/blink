pub let mut enum_regs: List[EnumReg] = []
pub let mut enum_variants: List[EnumVariant] = []
pub let mut enum_variant_name_idx: Map[Str, Str] = Map()
pub let mut enum_variant_full_idx: Map[Str, Int] = Map()
pub let mut enum_str_backed_set: Map[Str, Int] = Map()
pub type VarEnumEntry {
    name: Str
    enum_type: Str
}
pub let mut var_enums: List[VarEnumEntry] = []
pub let mut var_enum_frame_starts: List[Int] = []
pub type FnEnumRetEntry {
    name: Str
    enum_type: Str
}
pub let mut fn_enum_rets: List[FnEnumRetEntry] = []
pub let mut emitted_let_names: List[Str] = []
pub let mut emitted_fn_names: List[Str] = []
pub let mut struct_reg_set: Map[Str, Int] = Map()
pub let mut enum_reg_set: Map[Str, Int] = Map()
pub let mut emitted_fn_set: Map[Str, Int] = Map()
pub let mut fn_reg_set: Map[Str, Int] = Map()
pub let mut cg_emit_only_module: Str = ""
// Inverse of cg_emit_only_module: source-module keys whose decls are
// elided. Map[Str, Int] used as a set, matching the *_set convention
// of sibling globals here. Both filters compose.
pub let mut cg_skip_modules: Map[Str, Int] = Map()
pub let mut cg_archive_header_mode: Int = 0
// When set under cg_archive_header_mode, generate() uses this string as the
// include-guard symbol (e.g. "BLINK_MOD_FOO_H") instead of the default
// "BLINK_LIBBLINK_STD_H". Empty = use the default. Set by
// generate_module_header() for per-module .h emission; the archive monolith
// path leaves this empty so its existing header output is unchanged.
pub let mut cg_module_header_guard: Str = ""
// When non-zero, this TU does not own __blink_ev: emit `extern blink_ev
// __blink_ev;` instead of the typedef + default-initializer + definition.
// The owner TU keeps the flag at 0 and emits the storage. Default 0
// preserves whole-program behavior (single TU owns __blink_ev).
pub let mut cg_blink_ev_extern_only: Int = 0
// When non-zero under per-module emission, generate() prepends an
// `#include "<cg_module_object_self_header>"` so the .c references its own
// extern decls/typedefs. Mutually exclusive with archive modes.
pub let mut cg_module_object_self_header: Str = ""
// When non-zero, we're producing the stdlib archive's monolith.o itself —
// so the C `int main` wrapper and the synthesized `fn main()`'s blink_main
// body are suppressed (the archive has no entry point; the user's TU
// owns main()).
pub let mut cg_archive_build_mode: Int = 0
// When non-zero, we're compiling a user translation unit that links against
// the prebuilt stdlib archive (blinkc --link-archive / `blink build`). The
// emitted .c includes `libblink_std.h` for shared typedefs + extern decls,
// externs runtime storage (defined in the archive monolith), and keeps
// effectful stdlib fns inline. The standalone path (legacy single-TU
// blinkc with no --link-archive) leaves this at 0.
pub let mut cg_user_tu_mode: Int = 0
// When non-zero, this is a test build (`blink test`): panic sites lower to the
// thread-local catch dispatch (__blink_panic_dispatch) instead of the historic
// inline `fprintf; exit(1)`, and the generated C `#define`s BLINK_TEST_BUILD so
// the runtime_core.h trap sites switch to the dispatch too. A non-test build
// leaves this 0 and emits byte-identical panic sites + a BLINK_TEST_BUILD-free
// runtime (the assert_panics zero-cost guarantee, spec §2.20).
pub let mut cg_test_mode: Int = 0
pub let mut emitted_let_set: Map[Str, Int] = Map()
pub let mut emitted_option_set: Map[Str, Int] = Map()
pub let mut emitted_result_set: Map[Str, Int] = Map()
pub let mut emitted_iter_set: Map[Str, Int] = Map()
pub let mut cg_closure_defs: List[Str] = []
pub let mut cg_closure_promoter_defs: List[Str] = []
pub let mut cg_closure_counter: Int = 0
pub let mut cg_closure_param_type_hint: Int = -1

// Per-arg hint set by Call-arg loops before each emit_expr. Empty when the
// formal isn't `fn(...)`; otherwise holds the formal's closure-signature
// string so the Ident arm can detect a bare-fn ref and synthesize an ABI
// shim + blink_closure_new_typed wrapper. Always saved/restored around
// recursive emit_expr calls (per-arg, not per-expression-tree).
pub let mut cg_expect_fn_value_sig: Str = ""

// Dedup table for bare-fn-as-value shims, keyed by mangled C target symbol.
// Cleared per generate() like other typedef caches.
pub let mut cg_fn_shim_emitted: Map[Str, Str] = Map()

pub let mut cg_bh_cleanup_set: Map[Str, Int] = Map()
pub let mut cg_cl_cleanup_set: Map[Str, Int] = Map()
pub let mut cg_ev_restore_emitted: Int = 0
pub let mut cg_arena_helper_emitted: Int = 0

pub let mut cg_ffi_libs: List[Str] = []
pub let mut cg_ffi_lib_set: Map[Str, Int] = Map()

pub let mut mod_fn_prefix: Map[Str, Str] = Map()
pub let mut mod_type_prefix: Map[Str, Str] = Map()
// Built-in types defined by the runtime (e.g. ConversionError, ProcessResult)
// keep their bare `blink_<name>` mangling regardless of whether a Blink-source
// declaration of the same name lives in some module's source_module bucket.
pub let mut builtin_type_set: Map[Str, Int] = Map()

// Mangling key for a top-level decl: always the file-derived source_module
// so per-file .o builds get distinct C symbols. Runtime-bridged types whose
// bare `blink_<name>` symbol must survive (e.g. ConversionError, ProcessResult)
// are registered in `builtin_type_set` at codegen init and bypass this prefix.
pub fn mangling_module(node: Int) -> Str {
    node_source_module(node)
}

pub fn is_stdlib_source_module(module_name: Str) -> Bool {
    module_name.starts_with("std_")
}

pub fn skip_private_in_module_header(node: Int) -> Bool {
    // Only when we're actually emitting a module header (.h). Per-module
    // object emission (.c) must keep private fns/lets so their forward
    // decls and definitions land in the same TU.
    in_per_module_header() && node_is_pub(node) == 0
}

// True when emitting a single module's .h (per-module header pass).
pub fn in_per_module_header() -> Bool {
    cg_emit_only_module != "" && cg_archive_header_mode != 0
}

// True when emitting a single module's .c (per-module object pass).
pub fn in_per_module_object() -> Bool {
    cg_emit_only_module != "" && cg_archive_header_mode == 0
}

