    let t = get_sv_ty(name, CT_RESULT)
    if t >= 0 { sev_result_err_tag(cg_bind_mono_tid(t)) } else { "" }
}

// VALUE-ACCESS nominals: the raw ok/err nominal for EVERY nominal inner, transparent newtypes
// included (which the carrier-tag twins erase). Value-access unwrap/match-bind reads these to
// pick deref-vs-scalar handling and name the bound value; "" only for a primitive scalar.
fn sev_result_ok_nominal(bt: Int) -> Str {
    let mono = tc_tid_result_ok_struct_mono(bt)
    if mono != "" { return mono }
    let s = tc_tid_result_ok_struct(bt)
    if s != "" { return s }
    sev_nested_carrier_tag(tc_tid_result_ok_tid(bt))
}

