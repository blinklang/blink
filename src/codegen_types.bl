// Current function being emitted (for effect propagation checking)
pub let mut cg_current_fn_name: Str = ""
pub let mut cg_current_fn_ret: Int = 0
pub let mut cg_current_fn_node: Int = -1
pub let mut cg_current_fn_option_inner: Int = 0
pub let mut cg_current_fn_option_inner_struct: Str = ""
// Set to 1 while emitting the body of a `test "..." { ... }` block.
// Causes `?` lowering to call __blink_test_propagate_result / _option
// instead of emitting `return ...` (test fns are still void per the
// runtime descriptor — propagation goes through longjmp into the runner).
pub let mut cg_in_test_body: Int = 0
// Nonzero while emitting the inline body of an `assert_panics { ... }` block.
// Holds the label suffix (n) of the enclosing block's E0831 landing label
// `__ap_returned_<n>`. A `?`-propagated Err inside the body means the body
// exited WITHOUT panicking, which is E0831 (spec §2.20) — so the `?` lowering
// redirects its sentinel exit to `goto __ap_returned_<n>` instead of `return`.
// 0 = not inside an assert_panics body.
pub let mut cg_in_assert_panics: Int = 0
pub let mut cg_assert_panics_counter: Int = 0

// Set while emitting a `with`-resource expression so the ffi.scope() handler
// can reject a bare `let s = ffi.scope()` binding (§07:257 — scope is valid
// ONLY as a with-resource; outside `with`, nothing wires cleanup and the
// arena leaks). The handler consumes (clears) it so a nested ffi.scope() in an
// argument position is not mistaken for the top-level resource.
pub let mut cg_in_ffi_scope_resource: Int = 0

// > 0 inside a `with arena { }` body; suppresses `! Arena` propagation
// to the enclosing fn (decisions/arena-expression-form-semantics.md Q5).
pub let mut cg_with_arena_depth: Int = 0

// Stacks tracking manual-teardown `with arena { }` expression-form arenas
// live on the current codegen path. Needed so `?` early-returns can
// replicate the arena.exit(false) sequence that the tail-path emits
// (decisions/arena-expression-form-semantics.md §5.2.1 clause 2).
// Each active expression-form arena pushes its inner/prev C var names;
// non-expr arenas rely on __attribute__((cleanup)) and are not tracked.
pub let mut cg_arena_expr_tmp_stack: List[Str] = []
pub let mut cg_arena_expr_prev_stack: List[Str] = []

// Scratch space for tuple match scrutinee temps
pub let mut cg_program_node: Int = 0
pub let mut cg_uses_async: Int = 0
// Set of native-dep names (per src/stdlib_native_deps.bl) used by the
// current TU. Keys are NativeDep.name (e.g. "sqlite3"); presence => used.
// Triggers `#define BLINK_USE_<gate_macro> 1` prepend at TU prologue and
// drives the CLI's link-step source resolution (resolve_vendored_objects).
pub let mut cg_used_native_deps: Map[Str, Int] = Map()
pub let mut cg_async_wrapper_counter: Int = 0
pub let mut cg_current_fn_has_ev: Int = 0

// Async scope tracking: stack of scope handle list variable names
pub let mut cg_async_scope_stack: List[Str] = []
pub let mut cg_async_scope_counter: Int = 0

pub type MatchScrutEntry {
    str_val: Str
    scrut_type: Int
    scrut_sname: Str = ""
}
pub let mut match_scruts: List[MatchScrutEntry] = []
pub let mut match_scrut_enum: Str = ""

// Debug mode: 0 = release (strip debug_assert), 1 = debug (emit checks)
pub let mut cg_debug_mode: Int = 0

// Trace mode: 0 = no trace instrumentation, 1 = emit trace enter/exit calls
pub let mut cg_trace_codegen: Int = 0

// Deterministic mode: 0 = seed hash from time^pid (or $BLINK_MAP_SEED) at startup,
// 1 = pin seed = 0 in generated main(). Set from --deterministic at CLI parse time.
pub let mut cg_deterministic: Int = 0

pub fn push_scope() ! Codegen.Scope {
    scope_frame_starts.push(scope_vars.len())
    var_enum_frame_starts.push(var_enums.len())
}

pub fn pop_scope() ! Codegen.Scope {
    let start = scope_frame_starts.get(scope_frame_starts.len() - 1).unwrap()
    scope_frame_starts.pop()
    while scope_vars.len() > start {
        let sv = scope_vars.get(scope_vars.len() - 1).unwrap()
        bump_scope_ct(sv.ctype, -1)
        match scope_name_idx.get(sv.name) {
            Some(stack) => { stack.pop() }
            None => {}
        }
        scope_vars.pop()
    }
    let ve_start = var_enum_frame_starts.get(var_enum_frame_starts.len() - 1).unwrap()
    var_enum_frame_starts.pop()
    while var_enums.len() > ve_start {
        var_enums.pop()
    }
}

pub fn set_var(name: Str, ctype: Int, is_mut: Int) ! Codegen.Scope {
    push_scope_var(ScopeVar { name: name, ctype: ctype, is_mut: is_mut, inner1: -1, inner2: -1, sname: "", sname2: "", extra: "", tp_id: sv_tp(ctype, -1, -1, "") })
}

pub fn get_var_tp(name: Str) -> Int {
    let idx = find_scope_var(name)
    if idx >= 0 {
        return scope_vars.get(idx).unwrap().tp_id
    }
    type_int()
}

pub fn is_scope_var(name: Str) -> Int {
    if find_scope_var(name) >= 0 { 1 } else { 0 }
}

pub fn get_var_type(name: Str) -> Int {
    tp_get_kind(get_var_tp(name))
}

fn get_var_mut(name: Str) -> Int {
    let idx = find_scope_var(name)
    if idx >= 0 {
        return scope_vars.get(idx).unwrap().is_mut
    }
    0
}

fn get_sv_inner1(name: Str, ctype: Int) -> Int {
    if scope_ct_count(ctype) <= 0 { return -1 }
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == ctype {
            return tp_child1_kind(sv.tp_id)
        }
        i = i - 1
    }
    let blink_name = c_blink_name(name)
    if blink_name != name {
        i = scope_vars.len() - 1
        while i >= 0 {
            let sv = scope_vars.get(i).unwrap()
            if sv.name == blink_name && tp_get_kind(sv.tp_id) == ctype {
                return tp_child1_kind(sv.tp_id)
            }
            i = i - 1
        }
    }
    -1
}

