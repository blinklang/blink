// get_generic_fn_node lookups. Kept in lockstep with generic_fns.
pub let mut generic_fns_by_name: Map[Str, Int] = Map()

// Mono function instances to emit: (base_fn_name, concrete_args)
// arg_tids: the per-tparam concrete type-ids that produced `args`, positionally aligned with
// the CSV segments. An EMPTY list is not safe: the def side resolves every field and param
// through resolve_tparam_via_tid, which returns the binder name unchanged on a -1 or absent
// slot, so a degraded arg_tids erases with no compensation — either a bare binder in a C
// symbol (blink_Box_T) or an erased field under a correct mono name. An all- -1 list of the
// right arity is strictly more recoverable than [], because mono_arg_tids_with_ann fills -1
// HOLES; that is why merge_arg_tids treats arity as information.
type MonoFnInstance {
    base: Str
    args: Str
    arg_tids: List[Int]
}
pub let mut mono_fns: List[MonoFnInstance] = []

// Generic monomorphic instance registry
type MonoInstance {
    base: Str
    args: Str
    c_name: Str
    arg_tids: List[Int]
    // The type ANNOTATION node this instance was registered from, or -1. Only
    // register_carrier_inner_mono_instance sets it, because that producer runs in
    // codegen_types — BELOW typecheck in the module DAG — and so cannot read the
    // instance tid it needs for arg_tids. The tid does exist:
    // tc_produce_struct_instance_tid / _enum_ memoized the full instance onto this
    // very node. Carrying the node id (a plain Int, no typecheck surface required)
    // lets the def-side typedef emitter, which runs ABOVE typecheck, recover it.
    ann: Int
}

// The PHYSICAL C-symbol stem for a mono base. For a generic STRUCT/ENUM base
// (find_type_def_node hit) this is c_type_tag_for_struct(base) — the file-derived,
// module-prefixed tag — so a cross-module generic instance (`helper.CmgBox[Int]`)
// mangles by its DEFINING module (blink_helper_CmgBox_Int) and two same-named
// generics in different modules stay distinct C types. For a fn base
// (not a type def) or a same-module/unqualified struct, c_type_tag_for_struct is a
// no-op that returns `base` unchanged — so fn symbols and same-module struct
// symbols are byte-identical to the bare spelling. The LOGICAL base
// (MonoInstance.base) is kept separately for find_type_def / field-resolution,
// which key on the type def's logical name; only the C-symbol stem goes physical.
pub fn mono_phys_base(base: Str) -> Str {
    if find_type_def_node(base) == -1 { return base }
    c_type_tag_for_struct(base)
}
pub let mut mono_instances: List[MonoInstance] = []
pub let mut mono_idx: Map[Str, Int] = Map()
// count of newly minted c_names that collided with an EXISTING different
// (base, args) entry's c_name — a mangle_generic_name collision slipping past the escape
// fix. Must be 0 corpus-wide; see register_mono_instance_ann and dbg_trace channel
// "monodedup".
pub let mut mono_cname_collisions: Int = 0

// Polymorphic-impl template registry. Keyed on the trait-qualified
