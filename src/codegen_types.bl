pub fn set_list_elem_struct(name: Str, struct_name: Str) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_LIST {
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: sv.inner1, inner2: sv.inner2, sname: sv.sname, sname2: struct_name, extra: sv.extra, tp_id: sv.tp_id })
            return
        }
        i = i - 1
    }
    push_scope_var(ScopeVar { name: name, ctype: CT_LIST, is_mut: 0, inner1: -1, inner2: -1, sname: "", sname2: struct_name, extra: "", tp_id: sv_tp(CT_LIST, -1, -1, "") })
}

pub fn get_list_elem_struct(name: Str) -> Str {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_LIST && sv.sname2 != "" {
            return sv.sname2
        }
        i = i - 1
    }
    let alt = c_blink_name(name)
    if alt != name {
        let mut j = scope_vars.len() - 1
        while j >= 0 {
            let sv = scope_vars.get(j).unwrap()
            if sv.name == alt && tp_get_kind(sv.tp_id) == CT_LIST && sv.sname2 != "" {
                return sv.sname2
            }
            j = j - 1
        }
    }
    ""
}

pub fn set_set_elem_type(name: Str, elem_type: Int) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_SET {
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: elem_type, inner2: -1, sname: sv.sname, sname2: sv.sname2, extra: sv.extra, tp_id: sv_tp(sv.ctype, elem_type, -1, sv.sname) })
            return
        }
        i = i - 1
    }
    push_scope_var(ScopeVar { name: name, ctype: CT_SET, is_mut: 0, inner1: elem_type, inner2: -1, sname: "", sname2: "", extra: "", tp_id: sv_tp(CT_SET, elem_type, -1, "") })
}

pub fn get_set_elem_type(name: Str) -> Int {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_SET {
            let c1k = tp_child1_kind(sv.tp_id)
            if c1k >= 0 { return c1k }
            return CT_STRING
        }
        i = i - 1
    }
    if cg_closure_cap_start >= 0 {
        let mut ci = 0
        while ci < cg_closure_cap_count {
            let cap = closure_captures.get(cg_closure_cap_start + ci).unwrap()
            if cap.name == name && tp_get_kind(cap.tp_id) == CT_SET {
                let c1k = tp_child1_kind(cap.tp_id)
                if c1k >= 0 { return c1k }
                return CT_STRING
            }
            ci = ci + 1
        }
    }
    CT_STRING
}

// Struct/tuple element tag of a Set scope var (parallels get_map_key_struct),
// or "" when the element is a scalar. Lets emit_set_method box a struct/tuple
// element via the same kops-struct path Map uses for struct keys.
pub fn get_set_elem_struct(name: Str) -> Str {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_SET {
            return tp_child1_sname(sv.tp_id)
        }
        i = i - 1
    }
    if cg_closure_cap_start >= 0 {
        let mut ci = 0
        while ci < cg_closure_cap_count {
            let cap = closure_captures.get(cg_closure_cap_start + ci).unwrap()
            if cap.name == name && tp_get_kind(cap.tp_id) == CT_SET {
                return tp_child1_sname(cap.tp_id)
            }
            ci = ci + 1
        }
    }
    ""
}

// Record a struct/tuple element tag on a Set scope var (parallels
// set_map_key_struct). Rebuilds the tp_id with the element carrying `sname`.
pub fn set_set_elem_struct(name: Str, struct_name: Str) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_SET {
            let new_tp = type_set(type_struct(struct_name))
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: sv.inner1, inner2: sv.inner2, sname: sv.sname, sname2: sv.sname2, extra: sv.extra, tp_id: new_tp })
            return
        }
        i = i - 1
    }
}

pub fn set_map_types(name: Str, key_type: Int, value_type: Int, value_name: Str) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_MAP {
            let prior_k_sname = tp_child1_sname(sv.tp_id)
            // 37h7n3: a re-emitted generic-struct field Map[K,V] carries an erased
            // typevar value (CT_VOID, no struct name). Never let it clobber a
            // value already resolved on this var — CT_VOID is not a storable map
            // value, so an incoming erased-void with no name is always a
            // re-registration, not a genuine reset. Mirrors the prior_k_sname
            // key preservation above.
            let prior_v = tp_child2_kind(sv.tp_id)
            let val_erased = value_type == CT_VOID && value_name == ""
            let eff_value_type = if val_erased && prior_v >= 0 && prior_v != CT_VOID { prior_v } else { value_type }
            let new_tp = if prior_k_sname != "" {
                let new_v = if eff_value_type >= 0 { sv_tp(eff_value_type, -1, -1, sv.sname2) } else { type_int() }
                type_map(type_struct(prior_k_sname), new_v)
            } else {
                sv_tp(sv.ctype, key_type, eff_value_type, sv.sname)
            }
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: key_type, inner2: eff_value_type, sname: sv.sname, sname2: sv.sname2, extra: sv.extra, tp_id: new_tp })
            if (value_type == CT_VOID || value_type == CT_STRUCT || value_type == CT_ENUM) && value_name != "" && is_named_type(value_name) != 0 {
                set_map_value_struct(name, value_name)
            }
            return
        }
        i = i - 1
    }
    push_scope_var(ScopeVar { name: name, ctype: CT_MAP, is_mut: 0, inner1: key_type, inner2: value_type, sname: "", sname2: "", extra: "", tp_id: sv_tp(CT_MAP, key_type, value_type, "") })
    if (value_type == CT_VOID || value_type == CT_STRUCT || value_type == CT_ENUM) && value_name != "" && is_named_type(value_name) != 0 {
        set_map_value_struct(name, value_name)
    }
}

// Raw map key type: the tp child1 kind, or -1 when the key type was never set.
// Unlike get_map_key_type this does NOT mask an unset key as CT_STRING, so callers
// can tell a genuinely-recovered key apart from the default (wx184m).
pub fn get_map_key_type_raw(name: Str) -> Int {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_MAP {
            return tp_child1_kind(sv.tp_id)
        }
        i = i - 1
    }
    -1
}

// d7es5j: the map's value kind with NO Int default — -1 when unset (an empty
// `Map()` literal). Distinguishes a genuinely-typed Map[K,Int] from an untyped
// Map() so the push carry doesn't downgrade a list's annotated element-map
// value type to the default. Mirrors get_map_key_type_raw.
pub fn get_map_value_type_raw(name: Str) -> Int {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_MAP {
            if sv.extra != "" {
                return CT_LIST
            }
            if sv.sname2 != "" {
                return CT_VOID
            }
            return tp_child2_kind(sv.tp_id)
        }
        i = i - 1
    }
    -1
}

pub fn get_map_key_type(name: Str) -> Int {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_MAP {
            let c1k = tp_child1_kind(sv.tp_id)
            if c1k >= 0 { return c1k }
            return CT_STRING
        }
        i = i - 1
    }
    if cg_closure_cap_start >= 0 {
        let mut ci = 0
        while ci < cg_closure_cap_count {
            let cap = closure_captures.get(cg_closure_cap_start + ci).unwrap()
            if cap.name == name && tp_get_kind(cap.tp_id) == CT_MAP {
                let c1k = tp_child1_kind(cap.tp_id)
                if c1k >= 0 { return c1k }
                return CT_STRING
            }
            ci = ci + 1
        }
    }
    CT_STRING
}

pub fn get_map_key_struct(name: Str) -> Str {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_MAP {
            return tp_child1_sname(sv.tp_id)
        }
        i = i - 1
    }
    if cg_closure_cap_start >= 0 {
        let mut ci = 0
        while ci < cg_closure_cap_count {
            let cap = closure_captures.get(cg_closure_cap_start + ci).unwrap()
            if cap.name == name && tp_get_kind(cap.tp_id) == CT_MAP {
                return tp_child1_sname(cap.tp_id)
            }
            ci = ci + 1
        }
    }
    ""
}

pub fn set_map_key_struct(name: Str, struct_name: Str) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_MAP {
            let v = if sv.inner2 >= 0 { sv.inner2 } else { CT_INT }
            let new_k = type_struct(struct_name)
            let new_v = if v >= 0 { sv_tp(v, -1, -1, sv.sname2) } else { type_int() }
            let new_tp = type_map(new_k, new_v)
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: sv.inner1, inner2: sv.inner2, sname: sv.sname, sname2: sv.sname2, extra: sv.extra, tp_id: new_tp })
            return
        }
        i = i - 1
    }
}

pub fn get_map_value_type(name: Str) -> Int {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_MAP {
            if sv.extra != "" {
                return CT_LIST
            }
            if sv.sname2 != "" {
                return CT_VOID
            }
            let c2k = tp_child2_kind(sv.tp_id)
            if c2k >= 0 { return c2k }
            return sv.inner2
        }
        i = i - 1
    }
    if cg_closure_cap_start >= 0 {
        let mut ci = 0
        while ci < cg_closure_cap_count {
            let cap = closure_captures.get(cg_closure_cap_start + ci).unwrap()
            if cap.name == name && tp_get_kind(cap.tp_id) == CT_MAP {
                let c2k = tp_child2_kind(cap.tp_id)
                if c2k >= 0 { return c2k }
                return CT_INT
            }
            ci = ci + 1
        }
    }
    CT_INT
}

pub fn set_map_value_struct(name: Str, struct_name: Str) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_MAP {
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: sv.inner1, inner2: sv.inner2, sname: sv.sname, sname2: struct_name, extra: sv.extra, tp_id: sv.tp_id })
            return
        }
        i = i - 1
    }
}

pub fn get_map_value_struct(name: Str) -> Str {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_MAP {
            return sv.sname2
        }
        i = i - 1
    }
    ""
}

pub fn set_map_value_list_elem(name: Str, elem_type: Int) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_MAP {
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: sv.inner1, inner2: sv.inner2, sname: sv.sname, sname2: sv.sname2, extra: "{elem_type}", tp_id: sv.tp_id })
            return
        }
        i = i - 1
    }
}

pub fn get_map_value_list_elem(name: Str) -> Int {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_MAP && sv.extra != "" {
            return sv.extra.to_int()
        }
        i = i - 1
    }
    -1
}

pub fn copy_map_value_meta(src: Str, dst: Str) {
    let mvle = get_map_value_list_elem(src)
    if mvle >= 0 {
        set_map_value_list_elem(dst, mvle)
    }
    let mvs = get_map_value_struct(src)
    if mvs != "" {
        set_map_value_struct(dst, mvs)
    }
}

pub fn is_struct_type(name: Str) -> Int {
    if struct_reg_set.contains_key(name) != 0 { return 1 }
    let bare = strip_module_qualifier(name)
    if bare != name { return struct_reg_set.contains_key(bare) }
    0
}

pub fn is_named_type(name: Str) -> Int {
    if is_struct_type(name) != 0 { return 1 }
    if is_data_enum(name) != 0 { return 1 }
    0
}

pub fn closure_sig_ret_part(sig: Str) -> Str {
    let mut ret_end = 0
    while ret_end < sig.len() && sig.byte_at(ret_end) != 40 {
        ret_end = ret_end + 1
    }
    sig.substring(0, ret_end)
}

pub fn closure_ret_ct(ret_part: Str) -> Int {
    if ret_part == "int64_t" { return CT_INT }
    if ret_part == "double" { return CT_FLOAT }
    if ret_part == "const char*" { return CT_STRING }
    if ret_part == "int" { return CT_BOOL }
    CT_VOID
}

pub fn resolve_struct_from_c_name(cname: Str) -> Str {
    if struct_reg_set.contains_key(cname) { return cname }
    let mut i = 0
    while i < cname.len() {
        if cname.byte_at(i) == 95 { // '_'
            let suffix = cname.substring(i + 1, cname.len() - i - 1)
            if struct_reg_set.contains_key(suffix) {
                return suffix
            }
        }
        i = i + 1
    }
    ""
}

pub fn is_enum_type(name: Str) -> Int {
    if enum_reg_set.contains_key(name) != 0 { return 1 }
    let bare = strip_module_qualifier(name)
    if bare != name { return enum_reg_set.contains_key(bare) }
    0
}

pub fn is_struct_or_enum_type(name: Str) -> Int {
    if is_struct_type(name) != 0 { return 1 }
    if is_enum_type(name) != 0 { return 1 }
    0
}

pub fn resolve_variant(name: Str) -> Str {
    match enum_variant_name_idx.get(name) {
        Some(enum_name) => return enum_name
        None => {}
    }
    ""
}

pub fn get_var_enum(name: Str) -> Str {
    let mut i = var_enums.len() - 1
    while i >= 0 {
        let ve = var_enums.get(i).unwrap()
        if ve.name == name {
            return ve.enum_type
        }
        i = i - 1
    }
    let blink_name = c_blink_name(name)
    if blink_name != name {
        i = var_enums.len() - 1
        while i >= 0 {
            let ve = var_enums.get(i).unwrap()
            if ve.name == blink_name {
                return ve.enum_type
            }
            i = i - 1
        }
    }
    ""
}

pub fn is_data_enum(name: Str) -> Int {
    match enum_reg_set.get(name) {
        Some(v) => return v
        None => {}
    }
    let bare = strip_module_qualifier(name)
    if bare != name {
        match enum_reg_set.get(bare) {
            Some(v) => return v
            None => {}
        }
    }
    0
}

pub fn is_str_backed_enum(name: Str) -> Int {
    if enum_str_backed_set.contains_key(name) != 0 { return 1 }
    0
}

pub fn get_variant_index(enum_name: Str, variant_name: Str) -> Int {
    let key = enum_name.concat("|").concat(variant_name)
    match enum_variant_full_idx.get(key) {
        Some(idx) => return idx
        None => {}
    }
    -1
}

pub fn get_variant_tag(enum_name: Str, variant_name: Str) -> Int {
    let key = enum_name.concat("|").concat(variant_name)
    match enum_variant_full_idx.get(key) {
        Some(idx) => return enum_variants.get(idx).unwrap().tag
        None => {}
    }
    -1
}

pub fn get_variant_field_count(variant_idx: Int) -> Int {
    if variant_idx < 0 || variant_idx >= enum_variants.len() {
        return 0
    }
    enum_variants.get(variant_idx).unwrap().field_count
}

pub fn get_variant_field_name(variant_idx: Int, field_idx: Int) -> Option[Str] {
    let names_str = enum_variants.get(variant_idx).unwrap().field_names
    if names_str == "" {
        return None
    }
    let mut _seg_start = 0
    let mut _seg_idx = 0
    let mut i = 0
    while i <= names_str.len() {
        if i == names_str.len() || names_str.byte_at(i) == 44 { // ','
            if _seg_idx == field_idx {
                return Some(names_str.substr(_seg_start, i - _seg_start))
            }
            _seg_start = i + 1
            _seg_idx = _seg_idx + 1
        }
        i = i + 1
    }
    None
}

pub fn get_variant_field_type_str(variant_idx: Int, field_idx: Int) -> Option[Str] {
    let types_str = enum_variants.get(variant_idx).unwrap().field_types
    if types_str == "" {
        return None
    }
    let mut _seg_start = 0
    let mut _seg_idx = 0
    let mut bracket_depth = 0
    let mut i = 0
    while i <= types_str.len() {
        if i == types_str.len() {
            if _seg_idx == field_idx {
                return Some(types_str.substr(_seg_start, i - _seg_start))
            }
            _seg_start = i + 1
            _seg_idx = _seg_idx + 1
        } else if types_str.byte_at(i) == 91 {
            bracket_depth = bracket_depth + 1
        } else if types_str.byte_at(i) == 93 {
            bracket_depth = bracket_depth - 1
        } else if types_str.byte_at(i) == 44 && bracket_depth == 0 { // ','
            if _seg_idx == field_idx {
                return Some(types_str.substr(_seg_start, i - _seg_start))
            }
            _seg_start = i + 1
            _seg_idx = _seg_idx + 1
        }
        i = i + 1
    }
    None
}

pub fn get_fn_enum_ret(name: Str) -> Str {
    let resolved = resolve_fn_lookup(name)
    let mut i = 0
    while i < fn_enum_rets.len() {
        let fe = fn_enum_rets.get(i).unwrap()
        if fe.name == resolved {
            return fe.enum_type
        }
        i = i + 1
    }
    ""
}

pub fn set_var_struct(name: Str, type_name: Str) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) != CT_CLOSURE {
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: sv.inner1, inner2: sv.inner2, sname: type_name, sname2: sv.sname2, extra: sv.extra, tp_id: sv_tp(sv.ctype, sv.inner1, sv.inner2, type_name) })
            return
        }
        i = i - 1
    }
    push_scope_var(ScopeVar { name: name, ctype: CT_VOID, is_mut: 0, inner1: -1, inner2: -1, sname: type_name, sname2: "", extra: "", tp_id: sv_tp(CT_VOID, -1, -1, type_name) })
}

pub fn get_var_struct(name: Str) -> Str {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) != CT_CLOSURE && tp_get_kind(sv.tp_id) != CT_HANDLER {
            return sv.sname
        }
        i = i - 1
    }
    let blink_name = c_blink_name(name)
    if blink_name != name {
        i = scope_vars.len() - 1
        while i >= 0 {
            let sv = scope_vars.get(i).unwrap()
            if sv.name == blink_name && tp_get_kind(sv.tp_id) != CT_CLOSURE && tp_get_kind(sv.tp_id) != CT_HANDLER {
                return sv.sname
            }
            i = i - 1
        }
    }
    ""
}

