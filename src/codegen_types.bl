// instead of into derive_hash_types/derive_eq_types at parse time. Each mono
// instance (e.g. "HBox_0Int") joins the real lists on demand, at the ctor site
// that actually needs its kops table — see ensure_struct_derive_kops_key.
pub let mut derive_hash_generic_bases: List[Str] = []
pub let mut derive_eq_generic_bases: List[Str] = []
// Debug/Ord/Clone/Serialize follow the same generic-base routing as Hash/Eq: a
// generic type's bare name is never typedef'd, so it goes here and each mono
// instance joins the real emission list on demand — see
// ensure_struct_derive_kops_key_for_base.
pub let mut derive_debug_generic_bases: List[Str] = []
pub let mut derive_ord_generic_bases: List[Str] = []
pub let mut derive_clone_generic_bases: List[Str] = []
pub let mut derive_serialize_generic_bases: List[Str] = []

