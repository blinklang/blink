fn update_sv_sname(name: Str, ctype: Int, val: Str) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == ctype {
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: sv.inner1, inner2: sv.inner2, sname: val, sname2: sv.sname2, extra: sv.extra, tp_id: sv_tp(sv.ctype, sv.inner1, sv.inner2, val) })
            return
        }
        i = i - 1
    }
}

fn update_sv_sname2(name: Str, ctype: Int, val: Str) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == ctype {
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: sv.inner1, inner2: sv.inner2, sname: sv.sname, sname2: val, extra: sv.extra, tp_id: sv.tp_id })
            return
        }
        i = i - 1
    }
}

pub fn list_contains_str(lst: List[Str], val: Str) -> Int {
    let mut i = 0
    while i < lst.len() {
        if lst.get(i).unwrap() == val {
            return 1
        }
        i = i + 1
    }
    0
}

pub fn get_capture_index(name: Str) -> Int {
    if cg_closure_cap_start < 0 {
        return -1
    }
    let mut i = 0
    while i < cg_closure_cap_count {
        if closure_captures.get(cg_closure_cap_start + i).unwrap().name == name {
            return i
        }
        i = i + 1
    }
    -1
}

pub fn capture_cast_expr(idx: Int) -> Str {
    let ct = tp_get_kind(closure_captures.get(cg_closure_cap_start + idx).unwrap().tp_id)
    if ct == CT_INT {
        "(int64_t)(intptr_t)blink_closure_get_capture(__self, {idx})"
    } else if ct == CT_I8 {
        "(int8_t)(intptr_t)blink_closure_get_capture(__self, {idx})"
    } else if ct == CT_I16 {
        "(int16_t)(intptr_t)blink_closure_get_capture(__self, {idx})"
    } else if ct == CT_I32 {
        "(int32_t)(intptr_t)blink_closure_get_capture(__self, {idx})"
    } else if ct == CT_U8 {
        "(uint8_t)(uintptr_t)blink_closure_get_capture(__self, {idx})"
    } else if ct == CT_U16 {
        "(uint16_t)(uintptr_t)blink_closure_get_capture(__self, {idx})"
    } else if ct == CT_U32 {
        "(uint32_t)(uintptr_t)blink_closure_get_capture(__self, {idx})"
    } else if ct == CT_U64 {
        "(uint64_t)(uintptr_t)blink_closure_get_capture(__self, {idx})"
    } else if ct == CT_CHAR {
        "(int32_t)(intptr_t)blink_closure_get_capture(__self, {idx})"
    } else if ct == CT_FLOAT {
        "*(double*)blink_closure_get_capture(__self, {idx})"
    } else if ct == CT_STRING {
        "(const char*)blink_closure_get_capture(__self, {idx})"
    } else if ct == CT_BOOL {
        "(int)(intptr_t)blink_closure_get_capture(__self, {idx})"
    } else if ct == CT_LIST {
        "(blink_list*)blink_closure_get_capture(__self, {idx})"
    } else if ct == CT_MAP {
        "(blink_map*)blink_closure_get_capture(__self, {idx})"
    } else if ct == CT_BYTES {
        "(blink_bytes*)blink_closure_get_capture(__self, {idx})"
    } else if ct == CT_CLOSURE {
        "(blink_closure*)blink_closure_get_capture(__self, {idx})"
    } else if ct == CT_STRUCT {
        let sname = tp_get_sname(closure_captures.get(cg_closure_cap_start + idx).unwrap().tp_id)
        if sname != "" {
            "(*(({c_type_c_name(sname)}*)blink_closure_get_capture(__self, {idx})))"
        } else {
            "blink_closure_get_capture(__self, {idx})"
        }
    } else {
        "blink_closure_get_capture(__self, {idx})"
    }
}

pub let mut ffi_fn_set: Map[Str, Int] = Map()

pub fn reg_fn_as_ffi(name: Str) {
    ffi_fn_set.insert(name, 1)
}

pub fn is_fn_ffi(name: Str) -> Int {
    if ffi_fn_set.contains_key(name) {
        return 1
    }
    0
}

pub fn reg_fn(name: Str, ret: Int) ! Codegen.Register {
    if !fn_regs_idx.contains_key(name) {
        fn_regs_idx.insert(name, fn_regs.len())
    }
    fn_regs.push(FnRegEntry { name: name, ret: ret, effect_sl: -1, tp_id: sv_tp(ret, -1, -1, ""), is_trusted: 0 })
}

pub fn reg_fn_with_effects(name: Str, ret: Int, effects_sl: Int, is_trusted: Int) ! Codegen.Register {
    if !fn_regs_idx.contains_key(name) {
        fn_regs_idx.insert(name, fn_regs.len())
    }
    fn_regs.push(FnRegEntry { name: name, ret: ret, effect_sl: effects_sl, tp_id: sv_tp(ret, -1, -1, ""), is_trusted: is_trusted })
}

fn get_fn_effect_sl(name: Str) -> Int {
    let resolved = resolve_fn_lookup(name)
    match fn_regs_idx.get(resolved) {
        Some(idx) => return fn_regs.get(idx).unwrap().effect_sl
        None => {}
    }
    -1
}

fn is_fn_trusted(name: Str) -> Int {
    let resolved = resolve_fn_lookup(name)
    match fn_regs_idx.get(resolved) {
        Some(idx) => return fn_regs.get(idx).unwrap().is_trusted
        None => {}
    }
    0
}

pub fn fn_node_has_effects(fn_node: Int) -> Int {
    let eff_sl = node_effects(fn_node)
    if eff_sl != -1 && sublist_length(eff_sl) > 0 {
        return 1
    }
    0
}

pub fn fn_name_has_effects(name: Str) -> Int {
    let sl = get_fn_effect_sl(name)
    if sl != -1 && sublist_length(sl) > 0 {
        return 1
    }
    0
}

pub fn ev_arg_for_callee(callee: Str) -> Str {
    if fn_name_has_effects(callee) == 0 || is_fn_ffi(callee) != 0 {
        return ""
    }
    if cg_current_fn_has_ev != 0 {
        return "__ev"
    }
    "&__blink_ev"
}

pub fn append_ev_arg(callee: Str, args_str: Str) -> Str ! Diag.Report {
    check_effect_propagation(callee)
    let ev_arg = ev_arg_for_callee(callee)
    if ev_arg == "" {
        return args_str
    }
    if args_str == "" {
        return ev_arg
    }
    args_str.concat(", {ev_arg}")
}

pub fn ev_field(field: Str) -> Str {
    if cg_current_fn_has_ev != 0 {
        return "__ev->{field}"
    }
    "__blink_ev.{field}"
}

pub fn reg_fn_struct_ret(name: Str, stype: Str) ! Codegen.Register {
    fn_ret_structs_idx.insert(name, fn_ret_structs.len())
    fn_ret_structs.push(FnRetStructEntry { name: name, stype: stype })
}

pub fn get_fn_ret_struct(name: Str) -> Str {
    let resolved = resolve_fn_lookup(name)
    match fn_ret_structs_idx.get(resolved) {
        Some(idx) => return fn_ret_structs.get(idx).unwrap().stype
        None => {}
    }
    ""
}

pub fn reg_fn_ret_type(name: Str, kind: Int, inner1: Int, inner2: Int) ! Codegen.Register {
    fn_ret_types_idx.insert(name, fn_ret_types.len())
    fn_ret_types.push(RetType { name: name, kind: kind, inner1: inner1, inner2: inner2, tp_id: sv_tp(kind, inner1, inner2, "") })
}

pub fn reg_fn_ret_type_tp(name: Str, kind: Int, inner1: Int, inner2: Int, tp_id: Int) ! Codegen.Register {
    fn_ret_types_idx.insert(name, fn_ret_types.len())
    fn_ret_types.push(RetType { name: name, kind: kind, inner1: inner1, inner2: inner2, tp_id: tp_id })
}

pub fn tp_from_ann(ann: Int) -> Int {
    let name = node_name(ann)
    let ct = type_from_name(name)
    if ct == CT_LIST {
        let elems_sl = node_elements(ann)
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            return type_list(tp_from_ann(sublist_get(elems_sl, 0)))
        }
        return type_list(type_int())
    }
    if ct == CT_OPTION {
        let elems_sl = node_elements(ann)
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            return type_option(tp_from_ann(sublist_get(elems_sl, 0)))
        }
        return type_option(type_int())
    }
    if ct == CT_RESULT {
        let elems_sl = node_elements(ann)
        if elems_sl != -1 && sublist_length(elems_sl) >= 2 {
            let ok_tp = tp_from_ann(sublist_get(elems_sl, 0))
            let err_tp = tp_from_ann(sublist_get(elems_sl, 1))
            return type_result(ok_tp, err_tp)
        }
        return type_result(type_int(), type_string())
    }
    if ct == CT_MAP {
        let elems_sl = node_elements(ann)
        if elems_sl != -1 && sublist_length(elems_sl) >= 2 {
            let key_tp = tp_from_ann(sublist_get(elems_sl, 0))
            let val_tp = tp_from_ann(sublist_get(elems_sl, 1))
            return type_map(key_tp, val_tp)
        }
        return type_map(type_string(), type_int())
    }
    if ct == CT_SET {
        let elems_sl = node_elements(ann)
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            return type_set(tp_from_ann(sublist_get(elems_sl, 0)))
        }
        return type_set(type_string())
    }
    if ct == CT_ITERATOR {
        let elems_sl = node_elements(ann)
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            return type_iterator(tp_from_ann(sublist_get(elems_sl, 0)))
        }
        return type_iterator(type_int())
    }
    if name == "Tuple" {
        let tup_opt = resolve_tuple_ann(ann, -1, [])
        if tup_opt.is_some() {
            return sv_tp(CT_VOID, -1, -1, tup_opt.unwrap())
        }
    }
    if ct == CT_VOID {
        return sv_tp(CT_VOID, -1, -1, name)
    }
    sv_tp(ct, -1, -1, "")
}

pub fn get_fn_ret_type(name: Str) -> RetType {
    let resolved = resolve_fn_lookup(name)
    match fn_ret_types_idx.get(resolved) {
        Some(idx) => return fn_ret_types.get(idx).unwrap()
        None => {}
    }
    RetType { name: "", kind: CT_VOID, inner1: -1, inner2: -1, tp_id: sv_tp(CT_VOID, -1, -1, "") }
}

pub fn reg_fn_ret_handler(name: Str, vtable_type: Str, vtable_field: Str, is_ue: Int) {
    fn_ret_handlers_idx.insert(name, fn_ret_handlers.len())
    fn_ret_handlers.push(FnRetHandlerEntry { name: name, vtable_type: vtable_type, vtable_field: vtable_field, is_ue: is_ue })
}

pub fn get_fn_ret_handler(name: Str) -> FnRetHandlerEntry {
    let resolved = resolve_fn_lookup(name)
    match fn_ret_handlers_idx.get(resolved) {
        Some(idx) => return fn_ret_handlers.get(idx).unwrap()
        None => {}
    }
    FnRetHandlerEntry { name: "", vtable_type: "", vtable_field: "", is_ue: 0 }
}

pub fn resolve_option_inner_from_ann(fn_node: Int) -> Int {
    let ta = node_type_ann(fn_node)
    if ta != -1 {
        let elems_sl = node_elements(ta)
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            let inner_ann = sublist_get(elems_sl, 0)
            let inner_name = node_name(inner_ann)
            return type_from_name(inner_name)
        }
    }
    CT_INT
}

pub fn resolve_ret_type_from_ann(fn_node: Int) -> Str {
    let ret_str = node_return_type(fn_node)
    let ta = node_type_ann(fn_node)
    if ret_str == "Result" {
        if ta != -1 {
            let elems_sl = node_elements(ta)
            if elems_sl != -1 && sublist_length(elems_sl) >= 2 {
                let ok_ann = sublist_get(elems_sl, 0)
                let err_ann = sublist_get(elems_sl, 1)
                let ok_name = node_name(ok_ann)
                let err_name = node_name(err_ann)
                let ok_t = type_from_name(ok_name)
                let err_t = type_from_name(err_name)
                let ok_tag = resolve_result_inner_tag(ok_ann, ok_name, ok_t)
                let err_tag = resolve_result_inner_tag(err_ann, err_name, err_t)
                if ok_tag != "" || err_tag != "" {
                    let ok_t_tag = if ok_tag != "" { canonical_struct_tag(ok_tag) } else { c_type_tag(ok_t) }
                    let err_t_tag = if err_tag != "" { canonical_struct_tag(err_tag) } else { c_type_tag(err_t) }
                    return "blink_Result_{ok_t_tag}_{err_t_tag}"
                }
                return result_c_type(ok_t, err_t)
            }
        }
        return result_c_type(CT_INT, CT_STRING)
    }
    if ret_str == "Option" {
        if ta != -1 {
            let elems_sl = node_elements(ta)
            if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
                let inner_ann = sublist_get(elems_sl, 0)
                let inner_name = node_name(inner_ann)
                let inner_t = type_from_name(inner_name)
                if is_struct_type(inner_name) != 0 || is_enum_type(inner_name) != 0 {
                    // br bee854: a generic-struct INSTANCE inner spells the mono stem
                    // (QBox_Int), matching the tid path; the bare head is the fallback
                    // for a non-generic struct / typevar (mono_name_from_ann → "").
                    let mono = mono_name_from_ann(strip_module_qualifier(inner_name), inner_ann, -1, [])
                    let tag = if mono != "" { mono } else { strip_module_qualifier(inner_name) }
                    return "blink_Option_{canonical_struct_tag(tag)}"
                }
                if is_compound_ct(inner_t) != 0 || inner_name == "Tuple" {
                    let compound_name = compound_name_from_ann(inner_ann)
                    ensure_struct_option_type(compound_name)
                    return struct_option_c_type(compound_name)
                }
                return option_c_type(inner_t)
            }
        }
        return option_c_type(CT_INT)
    }
    if ret_str == "Tuple" {
        if ta != -1 {
            let tn_opt = resolve_tuple_ann(ta, -1, [])
            if tn_opt.is_some() {
                return c_type_c_name(tn_opt.unwrap())
            }
        }
    }
    if ret_str == "Ptr" {
        if ta != -1 {
            let elems_sl = node_elements(ta)
            if elems_sl != -1 && sublist_length(elems_sl) > 0 {
                let inner_ann = sublist_get(elems_sl, 0)
                let inner_name = node_name(inner_ann)
                return "{ptr_inner_c_type(inner_name)}*"
            }
        }
        return "void*"
    }
    if ret_str == "Handler" {
        if ta != -1 {
            let elems_sl = node_elements(ta)
            if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
                let effect_ann = sublist_get(elems_sl, 0)
                let effect_name = node_name(effect_ann)
                let vt = resolve_effect_vtable(effect_name)
                if vt != "" {
                    return "{vt}*"
                }
            }
        }
        return "void*"
    }
    ""
}

pub fn nth_type_arg(args_csv: Str, idx: Int) -> Str {
    let mut seg_start = 0
    let mut seg_idx = 0
    let mut ci = 0
    while ci <= args_csv.len() {
        if ci == args_csv.len() || args_csv.byte_at(ci) == 44 {
            if seg_idx == idx {
                return args_csv.substring(seg_start, ci - seg_start)
            }
            seg_idx = seg_idx + 1
            seg_start = ci + 1
        }
        ci = ci + 1
    }
    ""
}

// Type-param resolver for the codegen_types trio (resolve_tuple_ann /
// mono_name_from_ann / struct_concrete_args_from_target). `segs` is a pre-lowered
// segment list ALIGNED TO tparams_sl (segs[pi] = the concrete C-tag segment for the
// pi-th type param, or "" when that slot has no encodable tid). The caller lowers it
// via segs_from_arg_tids (codegen_expr) because codegen_types sits BELOW typecheck in
// the import graph and cannot reach tc_seg_from_tid itself. A param that matches an
// encodable slot returns that segment; everything else — no tparams, a name that is
// not a binder, empty/short segs, or an unencodable slot ("") — returns the param name
// unchanged, which is also what the caller wants for an already-concrete type name.
pub fn resolve_tparam_seg(param_name: Str, tparams_sl: Int, segs: List[Str]) -> Str {
    if tparams_sl != -1 {
        let mut pi = 0
        while pi < sublist_length(tparams_sl) {
            if node_name(sublist_get(tparams_sl, pi)) == param_name {
                if pi < segs.len() {
                    let seg = segs.get(pi).unwrap()
                    if seg != "" {
                        return seg
                    }
                }
                break
            }
            pi = pi + 1
        }
    }
    param_name
}

pub fn tuple_c_name_from_ann(ta: Int, fallback: Str) -> Str {
    if ta == -1 { return fallback }
    let opt = resolve_tuple_ann(ta, -1, [])
    if opt.is_some() { c_type_c_name(opt.unwrap()) } else { fallback }
}

pub fn resolve_tuple_ann(ta: Int, tparams_sl: Int, segs: List[Str]) -> Option[Str] {
    let elems_sl = node_elements(ta)
    if elems_sl == -1 {
        return None
    }
    let arity = sublist_length(elems_sl)
    let mut tags = ""
    let mut elem_types_enc = ""
    let mut elem_structs_enc = ""
    let mut i = 0
    while i < arity {
        let elem_ann = sublist_get(elems_sl, i)
        let elem_name_raw = node_name(elem_ann)
        let elem_name = resolve_tparam_seg(elem_name_raw, tparams_sl, segs)
        // A typevar substituted to a whole Option/Result arrives as the canonical
        // carrier tag (Option_str, Result_int_str) rather than an annotation with
        // child nodes. Recognize it so the tuple slot gets the parameterized
        // carrier (blink_Option_str) instead of bailing (type_from_name → CT_VOID
        // → None) or lowering to `void`. Map tags stay bare ("Map") and fall to
        // the uniform blink_map* scalar path below. (qm01e7)
        let carrier_tag = if elem_name.starts_with("Option_") || elem_name.starts_with("Result_") { elem_name } else { "" }
        // A nested-tuple element arrives as an annotation node named "Tuple" with
        // no matching scalar/struct/enum type. Recurse to register the inner tuple
        // typedef, then embed its C type BY VALUE (like a struct element). The
        // recursion's own ensure_tuple_type runs before the outer one below, so the
        // inner typedef is registered first; the BLINK_TD_ guard keeps emit order safe.
        let nested_tuple = if carrier_tag == "" && elem_name_raw == "Tuple" { resolve_tuple_ann(elem_ann, tparams_sl, segs) } else { None }
        let elem_t = if carrier_tag != "" { compound_tag_ct(carrier_tag) } else { type_from_name(elem_name) }
        if carrier_tag == "" && nested_tuple.is_none() && elem_t == CT_VOID && is_struct_type(elem_name) == 0 && is_enum_type(elem_name) == 0 {
            return None
        }
        if i > 0 {
            tags = tags.concat("_")
            elem_types_enc = elem_types_enc.concat(",")
            elem_structs_enc = elem_structs_enc.concat(",")
        }
        if nested_tuple.is_some() {
            let inner_c_name = nested_tuple.unwrap()
            tags = tags.concat(inner_c_name)
            elem_structs_enc = elem_structs_enc.concat(inner_c_name)
        } else if carrier_tag != "" {
            let canon = canonical_struct_tag(carrier_tag)
            ensure_carrier_from_tag(canon)
            tags = tags.concat(canon)
            elem_structs_enc = elem_structs_enc.concat(canon)
        } else if is_struct_type(elem_name) != 0 || is_enum_type(elem_name) != 0 {
            // A struct/enum-INSTANCE element (`(LocBox[Int], Int)`) must carry its
            // concrete type-args into the tuple field type (LocBox_Int), not the
            // bare arg-erased head (LocBox) — else the field is typed blink_LocBox
            // (never typedef'd) while the value is blink_LocBox_Int (br 637sy9).
            // mono_name_from_ann recurses elem_ann's type-args through the current
            // mono context, mirroring resolve_result_inner_tag. Falls back to the
            // bare head for a truly generic element (unsubstituted typevar / no args).
            let mono = mono_name_from_ann(strip_module_qualifier(elem_name), elem_ann, tparams_sl, segs)
            let struct_tag = if mono != "" { mono } else { c_type_tag_for_struct(elem_name) }
            tags = tags.concat(struct_tag)
            elem_structs_enc = elem_structs_enc.concat(struct_tag)
        } else if is_compound_ct(elem_t) != 0 && elem_name == elem_name_raw {
            // Annotation genuinely spells the compound (e.g. `Map[Str, Int]`):
            // read its inner shape from the node's child anns.
            ensure_compound_type_from_ann(elem_ann)
            let compound_name = canonical_struct_tag(compound_name_from_ann(elem_ann))
            tags = tags.concat(compound_name)
            elem_structs_enc = elem_structs_enc.concat(compound_name)
        } else {
            // Scalar, OR a typevar substituted to a bare compound (`T` → `Map`).
            // In the latter case the raw ann is the bare typevar node with no
            // inner anns, so compound_name_from_ann would decode "void"; and the
            // inner types were erased to the bare name upstream anyway (same as
            // the param, which emits `blink_map*`). Use the type-erased tag so
            // the tuple field type matches the parameter.
            tags = tags.concat(c_type_tag(elem_t))
            elem_structs_enc = elem_structs_enc.concat("-")
        }
        elem_types_enc = elem_types_enc.concat("{elem_t}")
        i = i + 1
    }
    let tup_name = tuple_c_type_name(tags, arity)
    ensure_tuple_type(tup_name, arity, elem_types_enc, elem_structs_enc)
    Some(tup_name)
}

pub fn reg_fn_ret_from_ann(name: Str, fn_node: Int) ! Codegen.Register {
    let ret_str = node_return_type(fn_node)
    let ta = node_type_ann(fn_node)
    if ret_str == "Result" {
        if ta != -1 {
            let elems_sl = node_elements(ta)
            if elems_sl != -1 && sublist_length(elems_sl) >= 2 {
                let ok_ann = sublist_get(elems_sl, 0)
                let err_ann = sublist_get(elems_sl, 1)
                let ok_name = node_name(ok_ann)
                let err_name = node_name(err_ann)
                let ok_t = type_from_name(ok_name)
                let err_t = type_from_name(err_name)
                let bare_ok = resolve_result_inner_tag(ok_ann, ok_name, ok_t)
                let bare_err = resolve_result_inner_tag(err_ann, err_name, err_t)
                reg_fn_ret_type_tp(name, CT_RESULT, ok_t, err_t, tp_from_ann(ta))
                if bare_ok != "" || bare_err != "" {
                    if is_compound_ct(ok_t) != 0 {
                        ensure_compound_type_from_ann(ok_ann)
                    }
                    if is_compound_ct(err_t) != 0 {
                        ensure_compound_type_from_ann(err_ann)
                    }
                    reg_fn_ret_struct_inner(name, bare_ok, bare_err)
                    let ok_tag = if bare_ok != "" { bare_ok } else { c_type_tag(ok_t) }
                    let err_tag = if bare_err != "" { bare_err } else { c_type_tag(err_t) }
                    ensure_struct_result_type(ok_tag, err_tag)
                } else {
                    ensure_result_type(ok_t, err_t)
                }
            }
        } else {
            reg_fn_ret_type(name, CT_RESULT, CT_INT, CT_STRING)
            ensure_result_type(CT_INT, CT_STRING)
        }
    }
    if ret_str == "Option" {
        if ta != -1 {
            let elems_sl = node_elements(ta)
            if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
                let inner_ann = sublist_get(elems_sl, 0)
                let inner_name = node_name(inner_ann)
                let inner_t = type_from_name(inner_name)
                reg_fn_ret_type_tp(name, CT_OPTION, inner_t, -1, tp_from_ann(ta))
                if is_struct_type(inner_name) != 0 || is_enum_type(inner_name) != 0 {
                    // br bee854: register the mono INSTANCE (QBox_Int) so the carrier
                    // typedef's value member resolves to blink_QBox_Int, not an
                    // undeclared blink_QBox. "" falls back to the bare head.
                    let mono = register_carrier_inner_mono_instance(inner_name, inner_ann)
                    let bare_inner = if mono != "" { mono } else { strip_module_qualifier(inner_name) }
                    reg_fn_ret_struct_inner(name, bare_inner, "")
                    ensure_struct_option_type(bare_inner)
                } else if is_compound_ct(inner_t) != 0 {
                    ensure_compound_type_from_ann(inner_ann)
                    let compound_name = compound_name_from_ann(inner_ann)
                    reg_fn_ret_struct_inner(name, compound_name, "")
                    ensure_struct_option_type(compound_name)
                } else {
                    ensure_option_type(inner_t)
                }
            }
        } else {
            reg_fn_ret_type(name, CT_OPTION, CT_INT, -1)
            ensure_option_type(CT_INT)
        }
    }
    if ret_str == "List" && ta != -1 {
        let elems_sl = node_elements(ta)
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            let elem_ann = sublist_get(elems_sl, 0)
            let elem_name = node_name(elem_ann)
            let elem_t = type_from_name(elem_name)
            reg_fn_ret_type_tp(name, CT_LIST, elem_t, -1, tp_from_ann(ta))
            if is_struct_type(elem_name) != 0 || is_enum_type(elem_name) != 0 {
                reg_fn_ret_struct_inner(name, strip_module_qualifier(elem_name), "")
            }
        }
    }
    if ret_str == "Map" && ta != -1 {
        let elems_sl = node_elements(ta)
        if elems_sl != -1 && sublist_length(elems_sl) >= 2 {
            let key_ann = sublist_get(elems_sl, 0)
            let val_ann = sublist_get(elems_sl, 1)
            let key_t = type_from_name(node_name(key_ann))
            let val_t = type_from_name(node_name(val_ann))
            reg_fn_ret_type_tp(name, CT_MAP, key_t, val_t, tp_from_ann(ta))
        }
    }
    if ret_str == "Tuple" && ta != -1 {
        let tup_c_name = resolve_tuple_ann(ta, -1, [])
        if tup_c_name.is_some() {
            reg_fn_struct_ret(name, tup_c_name.unwrap())
        }
    }
    if ret_str == "Handler" && ta != -1 {
        let elems_sl = node_elements(ta)
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            let effect_ann = sublist_get(elems_sl, 0)
            let effect_name = node_name(effect_ann)
            let vtt = resolve_effect_vtable(effect_name)
            let vtf = resolve_effect_field(effect_name)
            let is_ue = resolve_effect_is_ue(effect_name)
            reg_fn_ret_handler(name, vtt, vtf, is_ue)
        }
    }
}

pub fn reg_fn_ret_struct_inner(name: Str, ok_s: Str, err_s: Str) {
    fn_ret_struct_inners_idx.insert(name, fn_ret_struct_inners.len())
    fn_ret_struct_inners.push(FnRetStructInner { name: name, ok_struct: ok_s, err_struct: err_s })
}

pub fn get_fn_ret_struct_inner(name: Str) -> FnRetStructInner {
    let resolved = resolve_fn_lookup(name)
    match fn_ret_struct_inners_idx.get(resolved) {
        Some(idx) => return fn_ret_struct_inners.get(idx).unwrap()
        None => {}
    }
    FnRetStructInner { name: "", ok_struct: "", err_struct: "" }
}

pub fn reg_effect(name: Str, parent: Int) -> Int ! Codegen.Register {
    let idx = effect_entries.len()
    effect_entries.push(EffectEntry { name: name, parent: parent })
    idx
}

fn get_effect_idx(name: Str) -> Int {
    let mut i = 0
    while i < effect_entries.len() {
        if effect_entries.get(i).unwrap().name == name {
            return i
        }
        i = i + 1
    }
    -1
}

fn effect_satisfies(caller_effect: Str, callee_effect: Str) -> Int {
    if caller_effect == callee_effect {
        return 1
    }
    let callee_idx = get_effect_idx(callee_effect)
    if callee_idx == -1 {
        return 0
    }
    let parent_idx = effect_entries.get(callee_idx).unwrap().parent
    if parent_idx == -1 {
        return 0
    }
    let parent_name = effect_entries.get(parent_idx).unwrap().name
    if parent_name == caller_effect {
        return 1
    }
    0
}

pub fn check_effect_propagation(callee_name: Str) ! Diag.Report {
    if cg_current_fn_name == "main" || cg_current_fn_name.starts_with("__test_") || cg_current_fn_name.starts_with("__async_task_") {
        return
    }
    let callee_sl = get_fn_effect_sl(callee_name)
    if callee_sl == -1 {
        return
    }
    let callee_count = sublist_length(callee_sl)
    if callee_count == 0 {
        return
    }
    let callee_trusted = is_fn_trusted(callee_name)
    let caller_sl = get_fn_effect_sl(cg_current_fn_name)
    let mut ci = 0
    while ci < callee_count {
        let callee_eff_node = sublist_get(callee_sl, ci)
        let callee_eff = node_name(callee_eff_node)
        if callee_eff == "FFI" && callee_trusted != 0 {
            ci = ci + 1
            continue
        }
        // Q5 escape boundary: `with arena { }` discharges `! Arena` from the
        // enclosing fn. Skip propagation for the Arena effect only while we
        // are inside such a block. Other effects still propagate.
        if cg_with_arena_depth > 0 && callee_eff == "Arena" {
            ci = ci + 1
            continue
        }
        let mut satisfied = 0
        if caller_sl != -1 {
            let caller_count = sublist_length(caller_sl)
            let mut ki = 0
            while ki < caller_count {
                let caller_eff_node = sublist_get(caller_sl, ki)
                let caller_eff = node_name(caller_eff_node)
                if effect_satisfies(caller_eff, callee_eff) != 0 {
                    satisfied = 1
                }
                ki = ki + 1
            }
        }
        if satisfied == 0 {
            diag_error_no_loc("UndeclaredEffect", UNDECLARED_EFFECT, "function '{callee_name}' requires effect '{callee_eff}' but caller '{cg_current_fn_name}' does not declare it", "add '! {callee_eff}' to the function signature of '{cg_current_fn_name}'")
            diag_set_last_fix("insert", "! {callee_eff}")
        }
        ci = ci + 1
    }
}

pub fn init_builtin_effects() ! Codegen.Register {
    let io_idx = reg_effect("IO", -1)
    reg_effect("IO.Print", io_idx)
    reg_effect("IO.Log", io_idx)
    reg_effect("IO.Eprint", io_idx)
    let fs_idx = reg_effect("FS", -1)
    reg_effect("FS.Read", fs_idx)
    reg_effect("FS.Write", fs_idx)
    reg_effect("FS.Delete", fs_idx)
    reg_effect("FS.Watch", fs_idx)
    let net_idx = reg_effect("Net", -1)
    reg_effect("Net.Connect", net_idx)
    reg_effect("Net.Listen", net_idx)
    reg_effect("Net.DNS", net_idx)
    let env_idx = reg_effect("Env", -1)
    reg_effect("Env.Read", env_idx)
    reg_effect("Env.Write", env_idx)
    let time_idx = reg_effect("Time", -1)
    reg_effect("Time.Read", time_idx)
    reg_effect("Time.Sleep", time_idx)
    reg_effect("Rand", -1)
    let crypto_idx = reg_effect("Crypto", -1)
    reg_effect("Crypto.Hash", crypto_idx)
    reg_effect("Crypto.Sign", crypto_idx)
    reg_effect("Crypto.Encrypt", crypto_idx)
    reg_effect("Crypto.Decrypt", crypto_idx)
    let proc_idx = reg_effect("Process", -1)
    reg_effect("Process.Spawn", proc_idx)
    reg_effect("Process.Signal", proc_idx)
    let async_idx = reg_effect("Async", -1)
    reg_effect("Async.Spawn", async_idx)
    reg_effect("Async.Channel", async_idx)
}

fn get_ue_handle(effect_name: Str) -> Str {
    let mut i = 0
    while i < ue_effects.len() {
        let ue = ue_effects.get(i).unwrap()
        if ue.name == effect_name {
            return ue.handle
        }
        i = i + 1
    }
    ""
}

fn get_ue_top_for_handle(handle: Str) -> Str {
    let mut i = 0
    while i < ue_effects.len() {
        let ue = ue_effects.get(i).unwrap()
        if ue.handle == handle {
            return ue.name
        }
        i = i + 1
    }
    ""
}

pub fn is_user_effect_handle(name: Str) -> Int {
    let mut i = 0
    while i < ue_effects.len() {
        if ue_effects.get(i).unwrap().handle == name {
            return 1
        }
        i = i + 1
    }
    0
}

fn ue_has_method(handle: Str, method: Str) -> Int {
    let mut i = 0
    while i < ue_methods.len() {
        let uem = ue_methods.get(i).unwrap()
        if uem.effect_handle == handle && uem.name == method {
            return 1
        }
        i = i + 1
    }
    0
}

pub fn is_fn_registered(name: Str) -> Int {
    let resolved = resolve_fn_lookup(name)
    if fn_regs_idx.contains_key(resolved) { return 1 }
    0
}

pub fn get_fn_ret(name: Str) -> Int {
    let resolved = resolve_fn_lookup(name)
    match fn_regs_idx.get(resolved) {
        Some(idx) => {
            return tp_get_kind(fn_regs.get(idx).unwrap().tp_id)
        }
        None => {}
    }
    CT_VOID
}

pub fn set_list_elem_type(name: Str, elem_type: Int) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_LIST {
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: elem_type, inner2: sv.inner2, sname: sv.sname, sname2: sv.sname2, extra: sv.extra, tp_id: sv_tp(sv.ctype, elem_type, sv.inner2, sv.sname) })
            return
        }
        i = i - 1
    }
    push_scope_var(ScopeVar { name: name, ctype: CT_LIST, is_mut: 0, inner1: elem_type, inner2: -1, sname: "", sname2: "", extra: "", tp_id: sv_tp(CT_LIST, elem_type, -1, "") })
}

pub fn get_list_elem_type(name: Str) -> Int {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_LIST {
            return tp_child1_kind(sv.tp_id)
        }
        i = i - 1
    }
    let alt = c_blink_name(name)
    if alt != name {
        let mut j = scope_vars.len() - 1
        while j >= 0 {
            let sv = scope_vars.get(j).unwrap()
            if sv.name == alt && tp_get_kind(sv.tp_id) == CT_LIST {
                return tp_child1_kind(sv.tp_id)
            }
            j = j - 1
        }
    }
    -1
}

pub fn set_list_nested_elem_type(name: Str, nested_type: Int) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_LIST {
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: sv.inner1, inner2: nested_type, sname: sv.sname, sname2: sv.sname2, extra: sv.extra, tp_id: sv_tp(sv.ctype, sv.inner1, nested_type, sv.sname) })
            return
        }
        i = i - 1
    }
}

pub fn get_list_nested_elem_type(name: Str) -> Int {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_LIST {
            let c1 = tp_get_child1(sv.tp_id)
            if c1 >= 0 && tp_get_kind(c1) == CT_LIST {
                return tp_child1_kind(c1)
            }
            return -1
        }
        i = i - 1
    }
    -1
}

pub fn set_list_nested_elem_struct(name: Str, struct_name: Str) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_LIST {
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: sv.inner1, inner2: sv.inner2, sname: sv.sname, sname2: sv.sname2, extra: struct_name, tp_id: sv.tp_id })
            return
        }
        i = i - 1
    }
    push_scope_var(ScopeVar { name: name, ctype: CT_LIST, is_mut: 0, inner1: -1, inner2: -1, sname: "", sname2: "", extra: struct_name, tp_id: sv_tp(CT_LIST, -1, -1, "") })
}

pub fn get_list_nested_elem_struct(name: Str) -> Str {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_LIST && sv.extra != "" {
            return sv.extra
        }
        i = i - 1
    }
    ""
}

pub fn get_list_elem_map_key_type(name: Str) -> Int {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_LIST {
            let c1 = tp_get_child1(sv.tp_id)
            if c1 >= 0 && tp_get_kind(c1) == CT_MAP {
                return tp_child1_kind(c1)
            }
            return -1
        }
        i = i - 1
    }
    -1
}

pub fn get_list_elem_map_val_type(name: Str) -> Int {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_LIST {
            let c1 = tp_get_child1(sv.tp_id)
            if c1 >= 0 && tp_get_kind(c1) == CT_MAP {
                return tp_child2_kind(c1)
            }
            return -1
        }
        i = i - 1
    }
    -1
}

// mvfd3m: the struct NAME of a List[Map[K,Struct]] element-map value, or "" when
// the value is scalar/unset. Walks tp_id → child1 (map node) → child2 sname,
// the channel set_list_elem_map_types records via sv_tp's CT_STRUCT case.
pub fn get_list_elem_map_val_struct(name: Str) -> Str {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_LIST {
            let c1 = tp_get_child1(sv.tp_id)
            if c1 >= 0 && tp_get_kind(c1) == CT_MAP {
                return tp_child2_sname(c1)
            }
            return ""
        }
        i = i - 1
    }
    ""
}

// wx184m: record a List's element-map key+value types as a full nested type
// (`type_list(type_map(k, v))`). The flat inner1/inner2 ScopeVar slots can't
// hold three type params (list→map→{k,v}); set_list_elem_type(CT_MAP) lowers
// the map value to the default Int. Building the tp_id directly preserves V so
// List[Map[K,V]].get()/pop() carry the right value type.
//
// mvfd3m: a struct map value (val_ct == CT_STRUCT, val_name non-empty) flows
// through sv_tp's CT_STRUCT case as type_struct(val_name), so the struct name
// survives on the map node's child2 sname — recovered by
// get_list_elem_map_val_struct. Scalar values (val_name == "") are unchanged.
pub fn set_list_elem_map_types(name: Str, key_ct: Int, val_ct: Int, val_name: Str) {
    let map_tp = sv_tp(CT_MAP, key_ct, val_ct, val_name)
    let list_tp = type_list(map_tp)
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_LIST {
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: CT_MAP, inner2: sv.inner2, sname: sv.sname, sname2: sv.sname2, extra: sv.extra, tp_id: list_tp })
            return
        }
        i = i - 1
    }
    push_scope_var(ScopeVar { name: name, ctype: CT_LIST, is_mut: 0, inner1: CT_MAP, inner2: -1, sname: "", sname2: "", extra: "", tp_id: list_tp })
}

// gemr3z: record a List's element-OPTION inner as a full nested type
// (`type_list(type_option(inner))`). Like set_list_elem_map_types (wx184m), the
// flat inner1/inner2 slots can't hold list→option→inner: the plain
// set_list_elem_type(CT_OPTION) chain lowers the Option inner to the default Int.
// Building the tp_id directly preserves the concrete inner (Str / a struct) so
// List[Option[T]].get()/for-in carry the right inner type. `inner_struct` names a
// struct/enum inner (routed through sv_tp's CT_STRUCT case); scalars pass "".
// whg65a: core write-side that stamps a pre-built list tp (`type_list(<inner>)`)
// onto the var. `inner_marker` is the element's own CT (CT_OPTION/CT_RESULT) kept
// in the flat inner1 slot for the legacy callers that still read it. The inner tp
// is arbitrarily deep — this is how `List[Option[Map[Int,Str]]]` stores its full
// list→option→map→{k,v} shape (the flat sv_tp path collapses the Map's K/V).
fn set_list_elem_compound_tp(name: Str, list_tp: Int, inner_marker: Int) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_LIST {
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: inner_marker, inner2: sv.inner2, sname: sv.sname, sname2: sv.sname2, extra: sv.extra, tp_id: list_tp })
            return
        }
        i = i - 1
    }
    push_scope_var(ScopeVar { name: name, ctype: CT_LIST, is_mut: 0, inner1: inner_marker, inner2: -1, sname: "", sname2: "", extra: "", tp_id: list_tp })
}

// whg65a: record a List's element-OPTION from a pre-built inner tp
// (`type_option(<deep inner tp>)`). The deep-tp caller
// (set_list_elem_compound_ann) passes the fully-recursive inner so a nested
// container inside the Option — `List[Option[Map[K,V]]]`,
// `List[Option[List[T]]]` — keeps its own type params.
pub fn set_list_elem_option_tp(name: Str, inner_tp: Int) {
    set_list_elem_compound_tp(name, type_list(type_option(inner_tp)), CT_OPTION)
}

// gemr3z: record a List's element-OPTION inner as a full nested type
// (`type_list(type_option(inner))`). The scalar/bare-struct convenience twin of
// set_list_elem_option_tp — `inner_struct` names a struct/enum inner ("" for
// scalars), routed through sv_tp's CT_STRUCT case. Passes the Option's INNER tp
// (`sv_tp(inner_ct, …)`) — set_list_elem_option_tp adds the single Option wrap; a
// double sv_tp(CT_OPTION, …) here would nest the element as Option[Option[T]].
pub fn set_list_elem_option(name: Str, inner_ct: Int, inner_struct: Str) {
    set_list_elem_option_tp(name, sv_tp(inner_ct, -1, -1, inner_struct))
}

// z9gkt3: re-stamp a destination list's COMPOUND element from a carrier tag alone
// (the iterator-source analogue of copy_list_compound_elem, which reads LIST
// metadata a var-iterator doesn't have). Used by `collect` after a lazy adapter
// over a List[compound] — the adapter forwarded the boxed carrier verbatim and
// stored only its tag. The tag is lossless for Option/Result of scalars, structs,
// and Maps (tp_carrier_tag spells those fully); a List/Set inner is intentionally
// flat in the tag (`Option_list`), so its own element defaults — collect-then-
// decode of a List/Set inner through an adapter is not reachable in the tested
// surface and would need the source list's metadata, not the tag.
pub fn set_list_elem_compound_from_tag(name: Str, carrier: Str) {
    if carrier.starts_with("Option_") {
        let inner_tag = carrier.slice(7, carrier.len())
        let inner_ct = type_from_name_tag(inner_tag)
        if is_compound_tag(inner_tag) != 0 {
            set_list_elem_option_tp(name, sv_tp(inner_ct, -1, -1, inner_tag))
        } else if is_struct_type(inner_tag) != 0 || is_enum_type(inner_tag) != 0 {
            set_list_elem_option(name, CT_INT, inner_tag)
        } else {
            set_list_elem_option(name, inner_ct, "")
        }
    } else if carrier.starts_with("Result_") {
        let parts = split_result_compound(canonical_struct_tag(carrier))
        if parts.second != "" {
            let ok_ct = type_from_name_tag(parts.first)
            let err_ct = type_from_name_tag(parts.second)
            let ok_struct = if is_struct_type(parts.first) != 0 || is_enum_type(parts.first) != 0 { parts.first } else { "" }
            let err_struct = if is_struct_type(parts.second) != 0 || is_enum_type(parts.second) != 0 { parts.second } else { "" }
            set_list_elem_result(name, ok_ct, ok_struct, err_ct, err_struct)
        }
    }
}

// whg65a: the Result twin of set_list_elem_option_tp — record
// `type_list(type_result(ok_tp, err_tp))` from pre-built ok/err inner tps so a
// nested container inside either side (`List[Result[Map[K,V], E]]`) survives.
pub fn set_list_elem_result_tp(name: Str, ok_tp: Int, err_tp: Int) {
    set_list_elem_compound_tp(name, type_list(type_result(ok_tp, err_tp)), CT_RESULT)
}

// gemr3z: the Result twin of set_list_elem_option — record
// `type_list(type_result(ok, err))` so List[Result[T,E]].get()/for-in carry both
// concrete inners. ok_struct/err_struct name a struct/enum inner ("" for scalars).
pub fn set_list_elem_result(name: Str, ok_ct: Int, ok_struct: Str, err_ct: Int, err_struct: Str) {
    set_list_elem_result_tp(name, sv_tp(ok_ct, -1, -1, ok_struct), sv_tp(err_ct, -1, -1, err_struct))
}

// The element Option's inner CT (List[Option[Int]] → CT_INT). -1 when the list is
// not List[Option[..]] or the inner is absent. Walks tp_id: list node → child1
// (option node) → child1 (inner).
pub fn get_list_elem_option_inner(name: Str) -> Int {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_LIST {
            let c1 = tp_get_child1(sv.tp_id)
            if c1 >= 0 && tp_get_kind(c1) == CT_OPTION {
                return tp_child1_kind(c1)
            }
            return -1
        }
        i = i - 1
    }
    -1
}

// whg65a: the element Option's INNER tp NODE (List[Option[Map[Int,Str]]] → the
// `Map[Int,Str]` tp), or -1. Unlike get_list_elem_option_inner (which flattens to
// a single CT), this returns the whole subtree so a nested container inner keeps
// its K/V — the readback walks it via tp_carrier_tag + the map/list-elem getters.
pub fn get_list_elem_option_inner_tp(name: Str) -> Int {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_LIST {
            let c1 = tp_get_child1(sv.tp_id)
            if c1 >= 0 && tp_get_kind(c1) == CT_OPTION {
                return tp_get_child1(c1)
            }
            return -1
        }
        i = i - 1
    }
    -1
}

// whg65a: the element Result's OK / ERR inner tp NODE
// (List[Result[Map[Int,Str],Str]] → the `Map[Int,Str]` tp for ok, `Str` for err),
// or -1. The Result twin of get_list_elem_option_inner_tp.
pub fn get_list_elem_result_ok_tp(name: Str) -> Int {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && tp_get_kind(sv.tp_id) == CT_LIST {
            let c1 = tp_get_child1(sv.tp_id)
            if c1 >= 0 && tp_get_kind(c1) == CT_RESULT {
                return tp_get_child1(c1)
            }
            return -1
        }
        i = i - 1
    }
    -1
}

