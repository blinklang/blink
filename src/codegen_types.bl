// Assignment context for .into() type inference
pub let mut cg_let_target_type: Int = 0
pub let mut cg_let_target_name: Str = ""
pub let mut cg_let_target_ann: Int = -1

// br qah9tx: true only while resolving a struct literal's OWN identity (name/mono args)
// when it sits directly in a FieldAccess receiver (`fa_obj` in emit_expr's FieldAccess
// arm) — the enclosing cg_let_target_ann / cg_expect_arg_ann there describe the RESULT
// of the access, one nesting level too high, and tid_native_struct_inst_tid's bare-name
// match cannot tell the difference on its own. emit_struct_lit suspends this back to
// false around every nested recursive emission (field values, defaults, spread) so it
// never leaks past the receiver's own top-level resolution.
pub let mut cg_fa_receiver_ctx: Bool = false

// The scope-var name being reassigned (`r = Err(3)`), or "" outside an assignment
// RHS. A statement-level reassignment has no annotation node on the RHS, so a bare
// compound constructor (Ok/Err/Some/None) can't consult cg_let_target_ann to pick
// the target's carrier — it would fall back to a scalar carrier (blink_Result_int_int)
// and diverge from the target's declared type (blink_Result_Map_str_int_int). The
// ctors' annotation-less fallbacks consult this var's recorded compound carrier
// (get_var_result_* / get_var_option_*) instead, so the RHS spells the target's exact
// carrier. Keyed by var name, mirroring get_fn_ret_struct_inner(cg_current_fn_name).
pub let mut cg_assign_target_name: Str = ""

// Call-argument context: the callee parameter's type annotation node for the
// argument currently being emitted. Lets bare carrier constructors (None / Ok /
// Err) at a call site adopt the parameter's expected Option/Result inner struct
// instead of defaulting to a scalar carrier. (Some carries its inner value's
// type, so it needs no hint.) -1 when not in a call arg.
pub let mut cg_expect_arg_ann: Int = -1

// Monomorphization context: set while emitting a generic fn body so deeply
// nested codegen sites (like Map() literals) can substitute tparams.
pub let mut cg_mono_tparams_sl: Int = -1
// The concrete arg type-ids for the generic instance currently being emitted, so
// compound-inner sites can resolve a typevar via its structured tid
// (resolve_tparam_via_tid). Empty ([]) at any site → the name passes through
// unchanged. (The string CSV twin this used to shadow, cg_mono_concrete_args, went
// with the string resolver: after that deletion nothing ever read it back.)
pub let mut cg_mono_arg_tids: List[Int] = []

