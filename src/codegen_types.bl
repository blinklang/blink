fn init_blink_reserved() {
    if blink_reserved_init_done != 0 {
        return
    }
    blink_reserved_init_done = 1
    blink_reserved_set.insert("list", 1)
    blink_reserved_set.insert("map", 1)
    blink_reserved_set.insert("set", 1)
    blink_reserved_set.insert("bytes", 1)
    blink_reserved_set.insert("sb", 1)
    blink_reserved_set.insert("closure", 1)
    blink_reserved_set.insert("ctx", 1)
    blink_reserved_set.insert("task", 1)
    blink_reserved_set.insert("threadpool", 1)
    blink_reserved_set.insert("handle", 1)
    blink_reserved_set.insert("channel", 1)
    blink_reserved_set.insert("alloc", 1)
    blink_reserved_set.insert("strdup", 1)
    blink_reserved_set.insert("ProcessResult", 1)
    blink_reserved_set.insert("duration_struct", 1)
    blink_reserved_set.insert("instant_struct", 1)
}

fn is_blink_reserved(name: Str) -> Int {
    init_blink_reserved()
    if blink_reserved_set.contains_key(name) {
        return 1
    }
    0
}

let mut runtime_header_fns: Map[Str, Int] = Map()
let mut runtime_header_init_done: Int = 0

fn init_runtime_header_fns() {
    if runtime_header_init_done != 0 {
        return
    }
    runtime_header_init_done = 1
    // Functions from headers included by runtime.h that must not get duplicate extern declarations
    // stdio.h
    runtime_header_fns.insert("printf", 1)
    runtime_header_fns.insert("fprintf", 1)
    runtime_header_fns.insert("sprintf", 1)
    runtime_header_fns.insert("snprintf", 1)
    runtime_header_fns.insert("fopen", 1)
    runtime_header_fns.insert("fclose", 1)
    runtime_header_fns.insert("fread", 1)
    runtime_header_fns.insert("fwrite", 1)
    runtime_header_fns.insert("fgets", 1)
    runtime_header_fns.insert("fputs", 1)
    runtime_header_fns.insert("puts", 1)
    runtime_header_fns.insert("scanf", 1)
    runtime_header_fns.insert("fflush", 1)
    runtime_header_fns.insert("fseek", 1)
    runtime_header_fns.insert("ftell", 1)
    runtime_header_fns.insert("rewind", 1)
    runtime_header_fns.insert("remove", 1)
    runtime_header_fns.insert("rename", 1)
    runtime_header_fns.insert("perror", 1)
    // stdlib.h
    runtime_header_fns.insert("malloc", 1)
    runtime_header_fns.insert("calloc", 1)
    runtime_header_fns.insert("realloc", 1)
    runtime_header_fns.insert("free", 1)
    runtime_header_fns.insert("exit", 1)
    runtime_header_fns.insert("abort", 1)
    runtime_header_fns.insert("atoi", 1)
    runtime_header_fns.insert("atol", 1)
