pub fn is_runtime_header_fn(name: Str) -> Bool {
    init_runtime_header_fns()
    runtime_header_fns.contains_key(name)
}

pub fn c_safe_name(name: Str) -> Str {
    init_c_reserved()
    if c_reserved_set.contains_key(name) {
        return "_blink_{name}"
    }
    name
}

pub fn c_blink_name(name: Str) -> Str {
    if name.starts_with("_blink_") {
        let stripped = name.substring(7, name.len() - 7)
        init_c_reserved()
        if c_reserved_set.contains_key(stripped) {
            return stripped
        }
    }
    name
}

pub fn resolve_import_alias(name: Str) -> Str {
    match tc_alias_to_original.get(name) {
        Some(v) => return v
        None => {}
    }
    name
}

pub let mut cg_current_module: Str = ""

pub fn make_emit_key(fn_mod: Str, fn_name: Str) -> Str {
    if fn_mod != "" { "{fn_mod}:{fn_name}" } else { fn_name }
}

fn resolve_fn_lookup(name: Str) -> Str {
    if cg_current_module != "" {
        let qualified = "{cg_current_module}:{name}"
        if fn_regs_idx.contains_key(qualified) {
            return qualified
        }
    }
    name
}

pub fn c_fn_name(name: Str) -> Str {
    c_fn_name_in(name, cg_current_module)
}

fn c_fn_name_in(name: Str, caller_module: Str) -> Str {
    let resolved = resolve_import_alias(name)
    // FFI declarations bind directly to a runtime-provided C symbol; never
    // mangle them with a module prefix.
    if is_fn_ffi(resolved) != 0 {
        return "blink_{resolved}"
    }
    if caller_module != "" {
        let qualified = "{caller_module}:{resolved}"
        match mod_fn_prefix.get(qualified) {
            Some(prefix) => {
                if prefix != "" {
                    return "blink_{prefix}_{resolved}"
                }
            }
            None => {}
        }
    }
    match mod_fn_prefix.get(resolved) {
        Some(prefix) => {
            if prefix != "" {
                return "blink_{prefix}_{resolved}"
            }
        }
        None => {}
    }
    if is_blink_reserved(resolved) != 0 {
        return "blink_u_{resolved}"
    }
    "blink_{resolved}"
}

pub fn c_type_c_name(name: Str) -> Str {
    c_type_c_name_in(name, cg_current_module)
}

// Module-aware core of c_type_c_name (mirrors c_fn_name_in). Two modules may
// each define a struct/enum with the SAME bare name (`Ngx`) — LEGAL per
// §03_types.md:1038 (the collision rule is struct-vs-variant only). Their C
// symbols must stay DISTINCT (§07:1801-1816: `blink_<module_path>_<item>`).
// mod_type_prefix keyed by bare name alone collapses them (last writer wins),
// so consult the COMPOSITE key `"{caller_module}:{resolved}"` FIRST — populated
// alongside the bare key at the type-registration sites — then fall back to the
// bare key (same-module / single-definition callers unchanged). (br eczcwr)
pub fn c_type_c_name_in(name: Str, caller_module: Str) -> Str {
    // A Map_K_V tag is an IDENTITY mangling only — every Map lowers to the single
    // runtime type blink_map* regardless of its key/value (no per-instantiation
    // carrier struct is emitted, unlike Option/Result). So a Map tag as a field type
    // must resolve to blink_map*, NOT blink_Map_K_V (which is never typedef'd). (br 6kqgnp)
    if name.starts_with("Map_") {
        return "blink_map*"
    }
    // Compound carrier name (Option_X, Result_X_Y) — canonicalize the nested
    // struct/enum tags so the C type matches the actual emitted typedef.
    if name.starts_with("Option_") || name.starts_with("Result_") {
        return "blink_{canonical_struct_tag(name)}"
    }
    let bare = strip_module_qualifier(name)
    let resolved = resolve_import_alias(bare)
    // Built-in types live as runtime typedefs with no module prefix even if a
    // Blink-source declaration of the same name appears in a stdlib module.
    if builtin_type_set.contains_key(resolved) {
        return "blink_{resolved}"
    }
    if caller_module != "" {
        let qualified = "{caller_module}:{resolved}"
        match mod_type_prefix.get(qualified) {
            Some(prefix) => {
                if prefix != "" {
                    return "blink_{prefix}_{resolved}"
                }
            }
            None => {}
        }
    }
    match mod_type_prefix.get(resolved) {
        Some(prefix) => {
            if prefix != "" {
                return "blink_{prefix}_{resolved}"
            }
        }
        None => {}
    }
    "blink_{resolved}"
}

// C symbol for a derived, type-owned method (eq/cmp/clone/hash/to_json/debug/
// from_json). Derived methods are emitted (definition + forward-decl) under the
// TYPE's module prefix via `{c_type_c_name(T)}_<method>`. The call sites must use
// the SAME construction — building it as `c_fn_name("{T}_eq")` keys the FN prefix
// table on the whole "T_eq" string (never a match) and falls through to a bare
// `blink_T_eq`, which mismatches the prefixed definition for any non-__main__
// type (br znad0f).
pub fn derive_method_cname(tname: Str, method: Str) -> Str {
    "{c_type_c_name(tname)}_{method}"
}

// Capture analysis: per-capture info (flat list) and per-closure start/count
pub type CaptureEntry {
    name: Str
    is_mut: Int
    tp_id: Int
}

pub type ClosureCapInfo {
    start: Int
    count: Int
}

pub let mut closure_captures: List[CaptureEntry] = []
pub let mut closure_cap_infos: List[ClosureCapInfo] = []

// Closure AST node id → ClosureCapInfo index.
pub let mut closure_lit_cap_idx: Map[Int, Int] = Map()

// Deterministic structural hash of a closure sig string (djb2), rendered as
// 16 hex chars. Same sig → same hash from any module — mirrors the S:<name>
// convention for structs and is used for the C:<hash> descriptor variant.
pub fn closure_sig_hash(sig: Str) -> Str {
    let mut h: Int = 5381
    let mut i = 0
    let n = sig.len()
    while i < n {
        h = h * 33 + sig.byte_at(i)
        i = i + 1
    }
    if h < 0 { h = 0 - h }
    let hex_chars = "0123456789abcdef"
    let mut out = ""
    let mut rem = h
    let mut k = 0
    while k < 16 {
        let nib = rem % 16
        out = hex_chars.slice(nib, nib + 1).concat(out)
        rem = rem / 16
        k = k + 1
    }
    out
}

pub fn lookup_closure_lit_cap_idx(node: Int) -> Int {
    if closure_lit_cap_idx.contains_key(node) {
        return closure_lit_cap_idx.get(node).unwrap()
    }
    -1
}

// Active closure context: set while emitting a closure body, -1 otherwise
pub let mut cg_closure_cap_start: Int = -1
pub let mut cg_closure_cap_count: Int = 0

// Variables in the outer scope that are heap-boxed because a closure captures them mutably
pub let mut mut_captured_vars: List[Str] = []

// Trait registry: maps trait name -> method names
pub type TraitEntry {
    name: Str
    method_sl: Int
}
pub let mut trait_entries: List[TraitEntry] = []

// Impl registry: maps (trait, type) -> method FnDef nodes
pub type ImplEntry {
    trait_name: Str
    type_name: Str
    methods_sl: Int
}
pub let mut impl_entries: List[ImplEntry] = []
pub let mut impl_method_idx: Map[Str, Int] = Map()

pub fn reg_impl_entry(trait_name: Str, type_name: Str, methods_sl: Int) {
    impl_entries.push(ImplEntry { trait_name: trait_name, type_name: type_name, methods_sl: methods_sl })
    let mut j = 0
    while j < sublist_length(methods_sl) {
        let m = sublist_get(methods_sl, j)
        let method = node_name(m)
        let key = type_name.concat("\t").concat(method)
        impl_method_idx.insert(key, m)
        j = j + 1
    }
}

