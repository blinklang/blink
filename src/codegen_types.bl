// Assignment context for .into() type inference
pub let mut cg_let_target_type: Int = 0
pub let mut cg_let_target_name: Str = ""
pub let mut cg_let_target_ann: Int = -1

// true only while resolving a struct literal's OWN identity (name/mono args)
// when it sits directly in a FieldAccess receiver (`fa_obj` in emit_expr's FieldAccess
// arm) — the enclosing cg_let_target_ann / cg_expect_arg_ann there describe the RESULT
// of the access, one nesting level too high, and tid_native_struct_inst_tid's bare-name
// match cannot tell the difference on its own. emit_struct_lit suspends this back to
// false around every nested recursive emission (field values, defaults, spread) so it
// never leaks past the receiver's own top-level resolution.
pub let mut cg_fa_receiver_ctx: Bool = false

// The scope-var name being reassigned (`r = Err(3)`), or "" outside an assignment
// RHS. A statement-level reassignment has no annotation node on the RHS, so a bare
// compound constructor (Ok/Err/Some/None) can't consult cg_let_target_ann to pick
// the target's carrier — it would fall back to a scalar carrier (blink_Result_int_int)
// and diverge from the target's declared type (blink_Result_Map_str_int_int). The
// ctors' annotation-less fallbacks consult this var's recorded compound carrier
// (get_var_result_* / get_var_option_*) instead, so the RHS spells the target's exact
// carrier. Keyed by var name, mirroring get_fn_ret_struct_inner(cg_current_fn_name).
pub let mut cg_assign_target_name: Str = ""

// Call-argument context: the callee parameter's type annotation node for the
// argument currently being emitted. Lets bare carrier constructors (None / Ok /
// Err) at a call site adopt the parameter's expected Option/Result inner struct
// instead of defaulting to a scalar carrier. (Some carries its inner value's
// type, so it needs no hint.) -1 when not in a call arg.
pub let mut cg_expect_arg_ann: Int = -1

// The expected type-id for the argument currently being emitted, when only a tid
// (not an annotation node) is available — a builtin `List[Result[..]].push(Err(s))`
// carries its element type in the list tid, and the generic `push(self, elem: T)`
// param annotation is the bare typevar `T`, not the concrete `Result[Int, Point]`.
// The Ok/Err ctors read this to spell the pushed carrier from the authoritative
// element tid instead of the annotation-less fallback, which erases the struct
// side to `void`. -1 when no tid expectation is in force.
pub let mut cg_expect_arg_tid: Int = -1

// Monomorphization context: set while emitting a generic fn body so deeply
// nested codegen sites (like Map() literals) can substitute tparams.
pub let mut cg_mono_tparams_sl: Int = -1
// The concrete arg type-ids for the generic instance currently being emitted, so
// compound-inner sites can resolve a typevar via its structured tid
// (resolve_tparam_via_tid). Empty ([]) at any site → the name passes through
// unchanged.
pub let mut cg_mono_arg_tids: List[Int] = []

// Stable twin of the pair above: set ONCE per monomorphized-fn-body emission
// (codegen_stmt.bl, both the generic-fn and poly-impl entry points) and never
// touched again until that body finishes. cg_mono_tparams_sl/cg_mono_arg_tids
// get transiently swapped by emit_struct_lit for the duration of a struct
// literal's OWN field loop (so a field declared as a bare binder resolves
// against THIS INSTANCE's args). When a struct literal appears as another
// struct literal's field value, its own tid_native_struct_mono substitution
// retry runs INSIDE that swapped window — and if the nested struct's own
// declared type-param happens to share a NAME with the enclosing generic
// function's type-param (`type Box[T]` nested inside `fn mk[T]`), the retry
// resolves "T" against Box's swapped bind instead of mk's, silently reusing
// the outer instance's tid for the inner literal. tid_native_struct_mono's
// retry needs the enclosing FUNCTION's own binds, which this pair holds
// steady through any number of nested struct-literal field-loop swaps.
pub let mut cg_fn_mono_tparams_sl: Int = -1
pub let mut cg_fn_mono_arg_tids: List[Int] = []

pub let mut ffi_alloc_n_pending: Int = 0
pub let mut ffi_offset_pending_struct: Str = ""

// Handler vtable metadata set by emit_handler_expr for emit_with_block / let binding
pub let mut cg_handler_vtable_type: Str = ""
pub let mut cg_handler_vtable_field: Str = ""
pub let mut cg_handler_is_user_effect: Int = 0
// Cleanup metadata: when a handler expression also needs resource cleanup (e.g. db.connect)
pub let mut cg_handler_cleanup_var: Str = ""
pub let mut cg_handler_cleanup_fn: Str = ""
// Global handler index counter — must never reset (handler IDs are globally unique across compilation)
pub let mut cg_handler_counter: Int = 0
// Tracks the current handler's vtable type and field for default delegation
pub let mut cg_in_handler_body: Int = 0
pub let mut cg_handler_body_vtable_type: Str = ""
pub let mut cg_handler_body_field: Str = ""
pub let mut cg_handler_body_is_ue: Int = 0
pub let mut cg_handler_body_idx: Int = 0
pub type HandlerCapture {
    name: Str
    tp_id: Int
    struct_name: Str
}

// The C declaration type for a handler capture. An @ffi.opaque capture carries
// its type only in `struct_name` (its CT erases to CT_VOID → `void`), so spell the
// bare handle from the name; every other capture uses its CT.
pub fn handler_cap_c_type(cap: HandlerCapture) -> Str {
    if cap.struct_name != "" && is_opaque_type(cap.struct_name) != 0 {
        return opaque_handle_c_name(cap.struct_name)
    }
    c_type_str(cap.tp_id)
}
pub let mut cg_handler_caps: List[HandlerCapture] = []

pub fn resolve_effect_vtable(effect_name: Str) -> Str {
    if effect_name == "IO" || effect_name == "IO.Print" || effect_name == "IO.Log" || effect_name == "IO.Eprint" {
        return "blink_io_vtable"
    } else if effect_name == "FS" || effect_name == "FS.Read" || effect_name == "FS.Write" || effect_name == "FS.Delete" || effect_name == "FS.Watch" {
        return "blink_fs_vtable"
    } else if effect_name == "Net" || effect_name == "Net.Connect" || effect_name == "Net.Listen" || effect_name == "Net.DNS" {
        return "blink_net_vtable"
    } else if effect_name == "Crypto" || effect_name == "Crypto.Hash" || effect_name == "Crypto.Sign" || effect_name == "Crypto.Encrypt" || effect_name == "Crypto.Decrypt" {
        return "blink_crypto_vtable"
    } else if effect_name == "Rand" {
        return "blink_rand_vtable"
    } else if effect_name == "Time" || effect_name == "Time.Read" || effect_name == "Time.Sleep" {
        return "blink_time_vtable"
    } else if effect_name == "Env" || effect_name == "Env.Read" || effect_name == "Env.Write" {
        return "blink_env_vtable"
    } else if effect_name == "Process" || effect_name == "Process.Spawn" || effect_name == "Process.Signal" {
        return "blink_process_vtable"
    }
    let mut uei = 0
    while uei < ue_effects.len() {
        let ue = ue_effects.get(uei).unwrap()
        if effect_name == ue.name || effect_name.starts_with("{ue.name}.") {
            return "blink_ue_{ue.handle}_vtable"
        }
        uei = uei + 1
    }
    ""
}

pub fn resolve_effect_field(effect_name: Str) -> Str {
    if effect_name == "IO" || effect_name == "IO.Print" || effect_name == "IO.Log" || effect_name == "IO.Eprint" {
        return "io"
    } else if effect_name == "FS" || effect_name == "FS.Read" || effect_name == "FS.Write" || effect_name == "FS.Delete" || effect_name == "FS.Watch" {
        return "fs"
    } else if effect_name == "Net" || effect_name == "Net.Connect" || effect_name == "Net.Listen" || effect_name == "Net.DNS" {
        return "net"
    } else if effect_name == "Crypto" || effect_name == "Crypto.Hash" || effect_name == "Crypto.Sign" || effect_name == "Crypto.Encrypt" || effect_name == "Crypto.Decrypt" {
        return "crypto"
    } else if effect_name == "Rand" {
        return "rand"
    } else if effect_name == "Time" || effect_name == "Time.Read" || effect_name == "Time.Sleep" {
        return "time"
    } else if effect_name == "Env" || effect_name == "Env.Read" || effect_name == "Env.Write" {
        return "env"
    } else if effect_name == "Process" || effect_name == "Process.Spawn" || effect_name == "Process.Signal" {
        return "process"
    }
    let mut uei = 0
    while uei < ue_effects.len() {
        let ue = ue_effects.get(uei).unwrap()
        if effect_name == ue.name || effect_name.starts_with("{ue.name}.") {
            return ue.handle
        }
        uei = uei + 1
    }
    ""
}

pub fn resolve_effect_is_ue(effect_name: Str) -> Int {
    if resolve_effect_vtable(effect_name) != "" {
        if effect_name == "IO" || effect_name == "IO.Print" || effect_name == "IO.Log" || effect_name == "IO.Eprint" { return 0 }
        if effect_name == "FS" || effect_name.starts_with("FS.") { return 0 }
        if effect_name == "Net" || effect_name.starts_with("Net.") { return 0 }
        if effect_name == "Crypto" || effect_name.starts_with("Crypto.") { return 0 }
        if effect_name == "Rand" { return 0 }
        if effect_name == "Time" || effect_name.starts_with("Time.") { return 0 }
        if effect_name == "Env" || effect_name.starts_with("Env.") { return 0 }
        if effect_name == "Process" || effect_name.starts_with("Process.") { return 0 }
        return 1
    }
    0
}

// Scope: unified variable tracking with parameterized type info.
// inner1: List elem, Option inner, Result ok, Map key, Iterator/Handle/Channel inner
// inner2: Result err, Map value
// sname: struct type, closure sig, Option inner_struct, Result ok_struct
// sname2: alias target (iter), list elem struct, Result err_struct, Map value_struct
type ScopeVar {
    name: Str
    ctype: Int
    is_mut: Int
    inner1: Int
    inner2: Int
    sname: Str
    sname2: Str
    tp_id: Int
    // typecheck's tid for this binding, or -1 if nothing stamped one. NOT a tp_id: this
    // is an index into typecheck's ty_pool, the authoritative recursive tree, whereas
    // tp_id indexes codegen's second pool which sv_tp derives FROM the lossy flat fields
    // above; where the two disagree is what the divergence counter measures.
    //
    // Preserved (never invalidated) across the 34 mutation sites on purpose: a codegen
    // "refinement" of the flat fields that contradicts the stamped tid is exactly the divergence
    // the counter must report, so resetting to -1 there would blind the instrument.
    ty: Int
}

// Per-var codegen SCRATCH state, held in `scope_var_scratch` index-aligned with `scope_vars`
// (row i belongs to scope_vars[i]). This is where NON-type per-var state lives so the tid
// (`ScopeVar.ty`) can be the sole authority for a var's type: every field here is codegen state
// that no type can spell — a physical-carrier flag, an emitted C symbol name, an adapter tag.
// Each field names exactly one concern (no channel is reused across ctypes, unlike the flat
// ScopeVar fields it replaces). Fields are added as each flat scratch channel is migrated here.
type ScopeVarScratch {
    opt_erased: Int        // CT_OPTION: physical ptr-erasure bit (blink_Option_ptr carrier)
    ptr_struct: Str        // CT_PTR: @ffi.struct typedef name the pointer points to (or "")
    ptr_is_array: Int      // CT_PTR: 1 for scope.alloc_n[T](n), 0 for a singleton
    iter_next_fn: Str      // CT_ITERATOR: emitted C name of the source's next() thunk
    iter_carrier: Str      // CT_ITERATOR: List[compound] adapter carrier tag (or "")
    iter_alias: Str        // CT_ITERATOR: source var this iterator var aliases (or "")
    handler_vtable_type: Str  // CT_HANDLER: effect vtable C type name
    handler_vtable_field: Str // CT_HANDLER: effect vtable field the `with` operand dispatches on
    handler_is_ue: Int        // CT_HANDLER: 1 for a user-defined effect, 0 for a builtin
}

// Bridge: compute tp pool ID from CT_* flat fields
pub fn sv_tp(ctype: Int, inner1: Int, inner2: Int, sname: Str) -> Int {
    if ctype == CT_LIST {
        if inner1 >= 0 { return type_list(sv_tp(inner1, inner2, -1, sname)) }
        return type_list(type_int())
    }
    if ctype == CT_OPTION {
        if inner1 >= 0 { return type_option(sv_tp(inner1, inner2, -1, sname)) }
        return type_option(type_int())
    }
    if ctype == CT_RESULT {
        let ok = if inner1 >= 0 { sv_tp(inner1, -1, -1, "") } else { type_int() }
        let err = if inner2 >= 0 { sv_tp(inner2, -1, -1, "") } else { type_string() }
        return type_result(ok, err)
    }
    if ctype == CT_MAP {
        // Mirror the CT_SET arm below: an unknown key/value must NOT fabricate a
        // concrete CT_STRING/CT_INT. typecheck resolves a Map's key and value by
        // metavar inference (or errors E0301 when under-determined), so -1 passes
        // through and get_map_key_type/get_map_value_type report "unknown" rather
        // than a plausible-but-wrong default.
        let k = if inner1 >= 0 { sv_tp(inner1, -1, -1, "") } else { -1 }
        let v = if inner2 >= 0 { sv_tp(inner2, -1, -1, sname) } else { -1 }
        return type_map(k, v)
    }
    if ctype == CT_SET {
        // Unlike the sibling container arms above, an unknown Set element must NOT fabricate a
        // concrete type: typecheck resolves every Set's element by metavar inference, so -1 passes
        // through and get_set_elem_type's reader reports "unknown" instead of a wrong answer.
        let elem = if inner1 >= 0 { sv_tp(inner1, -1, -1, sname) } else { -1 }
        return type_set(elem)
    }
    if ctype == CT_ITERATOR {
        if inner1 >= 0 { return type_iterator(sv_tp(inner1, inner2, -1, sname)) }
        return type_iterator(type_int())
    }
    if ctype == CT_HANDLE {
        if inner1 >= 0 { return type_handle(sv_tp(inner1, inner2, -1, sname)) }
        return type_handle(type_int())
    }
    if ctype == CT_CHANNEL {
        if inner1 >= 0 { return type_channel(sv_tp(inner1, inner2, -1, sname)) }
        return type_channel(type_int())
    }
    if ctype == CT_CLOSURE { return type_closure(sname) }
    if ctype == CT_TAGGED_ENUM || ctype == CT_VOID || ctype == CT_STRUCT || ctype == CT_ENUM {
        if sname != "" { return type_struct(sname) }
        return tp_alloc(ctype, -1, -1, "")
    }
    if ctype == CT_PTR {
        if inner1 >= 0 { return type_ptr(sv_tp(inner1, inner2, -1, sname)) }
        return type_ptr(type_int())
    }
    tp_alloc(ctype, -1, -1, "")
}
pub let mut scope_vars: List[ScopeVar] = []
pub let mut scope_frame_starts: List[Int] = []
// Index-aligned with scope_vars (same length, row i is scope_vars[i]'s scratch). Maintained
// only in push_scope_var / pop_scope / reset_scope_state — the sole scope_vars length-mutators.
pub let mut scope_var_scratch: List[ScopeVarScratch] = []

fn scratch_default() -> ScopeVarScratch {
    ScopeVarScratch { opt_erased: 0, ptr_struct: "", ptr_is_array: 0, iter_next_fn: "", iter_carrier: "", iter_alias: "", handler_vtable_type: "", handler_vtable_field: "", handler_is_ue: 0 }
}
// Per-ctype counts of entries currently in scope_vars. Lets the get_sv_*
// helpers and get_var_alias short-circuit when zero (the common case for
// rare ctypes like CT_CLOSURE / CT_ITERATOR / CT_HANDLE).
let mut scope_ct_counts: List[Int] = []
// Side-index: name -> stack of scope_vars indices (most recent last). Lets
// get_var_*/is_scope_var avoid linear-scanning scope_vars on every lookup.
// Invariant: the top of the stack is the most-recently-pushed binding for
// that name (shadowing semantics). Maintained by push_scope_var/pop_scope/
// reset_scope_state.
let mut scope_name_idx: Map[Str, List[Int]] = Map()

fn scope_ct_count(ctype: Int) -> Int {
    if ctype < 0 || ctype >= scope_ct_counts.len() { return 0 }
    scope_ct_counts.get(ctype).unwrap()
}

fn bump_scope_ct(ctype: Int, delta: Int) {
    if ctype < 0 { return }
    while scope_ct_counts.len() <= ctype {
        scope_ct_counts.push(0)
    }
    scope_ct_counts.set(ctype, scope_ct_counts.get(ctype).unwrap() + delta)
}

// Push a ScopeVar and bump its per-ctype counter atomically. Always use
// this instead of scope_vars.push to keep scope_ct_counts in sync.
fn push_scope_var(sv: ScopeVar) {
    let idx = scope_vars.len()
    let name = sv.name
    scope_vars.push(sv)
    scope_var_scratch.push(scratch_default())
    bump_scope_ct(sv.ctype, 1)
    match scope_name_idx.get(name) {
        Some(stack) => { stack.push(idx) }
        None => {
            let s: List[Int] = [idx]
            scope_name_idx.insert(name, s)
        }
    }
}

pub fn reset_scope_state() {
    scope_vars.clear()
    scope_var_scratch.clear()
    scope_frame_starts.clear()
    scope_ct_counts.clear()
    scope_name_idx.clear()
}

// Topmost scope_vars index bound to `name`, or -1 if none. O(1) via scope_name_idx.
fn find_scope_var(name: Str) -> Int {
    match scope_name_idx.get(name) {
        Some(stack) => {
            let n = stack.len()
            if n == 0 { return -1 }
            return stack.get(n - 1).unwrap()
        }
        None => {}
    }
    -1
}

// CT_PTR scratch (ptr_struct, ptr_is_array) lives in scope_var_scratch:
//   ptr_struct: @ffi.struct typedef name the pointer points to (or "")
//   ptr_is_array: 1 for scope.alloc_n[T](n), 0 for a singleton

pub fn set_var_ffi_ptr_extra(name: Str, struct_name: Str, is_array: Int) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_PTR {
            let s = scope_var_scratch.get(i).unwrap()
            scope_var_scratch.set(i, ScopeVarScratch { opt_erased: s.opt_erased, ptr_struct: struct_name, ptr_is_array: is_array, iter_next_fn: s.iter_next_fn, iter_carrier: s.iter_carrier, iter_alias: s.iter_alias, handler_vtable_type: s.handler_vtable_type, handler_vtable_field: s.handler_vtable_field, handler_is_ue: s.handler_is_ue })
            return
        }
        i = i - 1
    }
}

pub fn set_var_ffi_ptr_struct(name: Str, struct_name: Str) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_PTR {
            let s = scope_var_scratch.get(i).unwrap()
            scope_var_scratch.set(i, ScopeVarScratch { opt_erased: s.opt_erased, ptr_struct: struct_name, ptr_is_array: s.ptr_is_array, iter_next_fn: s.iter_next_fn, iter_carrier: s.iter_carrier, iter_alias: s.iter_alias, handler_vtable_type: s.handler_vtable_type, handler_vtable_field: s.handler_vtable_field, handler_is_ue: s.handler_is_ue })
            return
        }
        i = i - 1
    }
}

pub fn get_var_ffi_ptr_struct(name: Str) -> Str {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_PTR {
            return scope_var_scratch.get(i).unwrap().ptr_struct
        }
        i = i - 1
    }
    ""
}

pub fn set_var_ffi_ptr_array(name: Str) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_PTR {
            let s = scope_var_scratch.get(i).unwrap()
            scope_var_scratch.set(i, ScopeVarScratch { opt_erased: s.opt_erased, ptr_struct: s.ptr_struct, ptr_is_array: 1, iter_next_fn: s.iter_next_fn, iter_carrier: s.iter_carrier, iter_alias: s.iter_alias, handler_vtable_type: s.handler_vtable_type, handler_vtable_field: s.handler_vtable_field, handler_is_ue: s.handler_is_ue })
            return
        }
        i = i - 1
    }
}

pub fn is_ffi_ptr_array_var(name: Str) -> Int {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_PTR {
            return scope_var_scratch.get(i).unwrap().ptr_is_array
        }
        i = i - 1
    }
    0
}

