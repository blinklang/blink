pub let mut ue_effects: List[UeEffect] = []
pub let mut ue_methods: List[UeMethod] = []

// Current function being emitted (for effect propagation checking)
pub let mut cg_current_fn_name: Str = ""
pub let mut cg_current_fn_ret: Int = 0
pub let mut cg_current_fn_node: Int = -1
pub let mut cg_current_fn_option_inner: Int = 0
pub let mut cg_current_fn_option_inner_struct: Str = ""
// Set to 1 while emitting a user-effect handler op whose declared return is
// `Option[Struct/Enum]`. The C ABI of the vtable slot is the shared, erased
// `blink_Option_ptr` box, but the in-body inner stays CONCRETE (cg_current_fn_option_inner*
// name the true struct) so every aggregate slot — struct field, tuple/list element — is
// well typed. The concrete->ptr box happens once, at the return boundary
// (emit_return_with_trace), instead of per constructed value.
pub let mut cg_handler_ret_option_erased: Int = 0
// Set to 1 while emitting the body of a `test "..." { ... }` block.
// Causes `?` lowering to call __blink_test_propagate_result / _option
// instead of emitting `return ...` (test fns are still void per the
// runtime descriptor — propagation goes through longjmp into the runner).
pub let mut cg_in_test_body: Int = 0
// Nonzero while emitting the inline body of an `assert_panics { ... }` block.
// Holds the label suffix (n) of the enclosing block's E0831 landing label
// `__ap_returned_<n>`. A `?`-propagated Err inside the body means the body
// exited WITHOUT panicking, which is E0831 (spec §2.20) — so the `?` lowering
// redirects its sentinel exit to `goto __ap_returned_<n>` instead of `return`.
// 0 = not inside an assert_panics body.
pub let mut cg_in_assert_panics: Int = 0
pub let mut cg_assert_panics_counter: Int = 0

// Set while emitting a `with`-resource expression so the ffi.scope() handler
// can reject a bare `let s = ffi.scope()` binding (§07:257 — scope is valid
// ONLY as a with-resource; outside `with`, nothing wires cleanup and the
// arena leaks). The handler consumes (clears) it so a nested ffi.scope() in an
// argument position is not mistaken for the top-level resource.
pub let mut cg_in_ffi_scope_resource: Int = 0

// > 0 inside a `with arena { }` body; suppresses `! Arena` propagation
// to the enclosing fn (decisions/arena-expression-form-semantics.md Q5).
pub let mut cg_with_arena_depth: Int = 0

// Stacks tracking manual-teardown `with arena { }` expression-form arenas
// live on the current codegen path. Needed so `?` early-returns can
// replicate the arena.exit(false) sequence that the tail-path emits
// (decisions/arena-expression-form-semantics.md §5.2.1 clause 2).
// Each active expression-form arena pushes its inner/prev C var names;
// non-expr arenas rely on __attribute__((cleanup)) and are not tracked.
pub let mut cg_arena_expr_tmp_stack: List[Str] = []
pub let mut cg_arena_expr_prev_stack: List[Str] = []

// Scratch space for tuple match scrutinee temps
pub let mut cg_program_node: Int = 0
pub let mut cg_uses_async: Int = 0
// Set of native-dep names (per src/stdlib_native_deps.bl) used by the
// current TU. Keys are NativeDep.name (e.g. "sqlite3"); presence => used.
// Triggers `#define BLINK_USE_<gate_macro> 1` prepend at TU prologue and
// drives the CLI's link-step source resolution (resolve_vendored_objects).
pub let mut cg_used_native_deps: Map[Str, Int] = Map()
pub let mut cg_async_wrapper_counter: Int = 0
pub let mut cg_current_fn_has_ev: Int = 0

// Async scope tracking: stack of scope handle list variable names
pub let mut cg_async_scope_stack: List[Str] = []
pub let mut cg_async_scope_counter: Int = 0

pub type MatchScrutEntry {
    str_val: Str
    scrut_type: Int
    scrut_sname: Str = ""
}
pub let mut match_scruts: List[MatchScrutEntry] = []
pub let mut match_scrut_enum: Str = ""

// Debug mode: 0 = release (strip debug_assert), 1 = debug (emit checks)
pub let mut cg_debug_mode: Int = 0

// Trace mode: 0 = no trace instrumentation, 1 = emit trace enter/exit calls
pub let mut cg_trace_codegen: Int = 0

// Deterministic mode: 0 = seed hash from time^pid (or $BLINK_MAP_SEED) at startup,
// 1 = pin seed = 0 in generated main(). Set from --deterministic at CLI parse time.
pub let mut cg_deterministic: Int = 0

pub fn push_scope() ! Codegen.Scope {
    scope_frame_starts.push(scope_vars.len())
    var_enum_frame_starts.push(var_enums.len())
}

pub fn pop_scope() ! Codegen.Scope {
    let start = scope_frame_starts.get(scope_frame_starts.len() - 1).unwrap()
    scope_frame_starts.pop()
    while scope_vars.len() > start {
        let sv = scope_vars.get(scope_vars.len() - 1).unwrap()
        bump_scope_ct(sv.ctype, -1)
        match scope_name_idx.get(sv.name) {
            Some(stack) => { stack.pop() }
            None => {}
        }
        scope_vars.pop()
        scope_var_scratch.pop()
    }
    let ve_start = var_enum_frame_starts.get(var_enum_frame_starts.len() - 1).unwrap()
    var_enum_frame_starts.pop()
    while var_enums.len() > ve_start {
        var_enums.pop()
    }
}

pub fn set_var(name: Str, ctype: Int, is_mut: Int) ! Codegen.Scope {
    push_scope_var(ScopeVar { name: name, ctype: ctype, is_mut: is_mut, inner1: -1, inner2: -1, sname: "", sname2: "", ty: -1, tp_id: sv_tp(ctype, -1, -1, "") })
}

// ── The tid stamping seam ───────────────────────────────────────────────────
//
// The 34 setters below take flat data (name, ctype, inner, sname), never a node, so none of them
// can look a tid up for themselves. Stamping therefore needs its own entry point, called from the
// emit sites where a node IS in hand. Keeping it separate leaves all 34 untouched, so stamping
// cannot perturb the flat fields that still govern every emit decision.
pub fn set_var_ty(name: Str, tid: Int) {
    let idx = find_scope_var(name)
    if idx < 0 { return }
    let sv = scope_vars.get(idx).unwrap()
    scope_vars.set(idx, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: sv.inner1, inner2: sv.inner2, sname: sv.sname, sname2: sv.sname2, ty: tid, tp_id: sv.tp_id })
}

// -1 when unstamped or unknown. Callers must treat -1 as "ask the flat fields", NOT as a
// type — that conflation is what sv_tp does.
pub fn get_var_ty(name: Str) -> Int {
    let idx = find_scope_var(name)
    if idx < 0 { return -1 }
    scope_vars.get(idx).unwrap().ty
}

pub fn get_var_tp(name: Str) -> Int {
    let idx = find_scope_var(name)
    if idx >= 0 {
        return scope_vars.get(idx).unwrap().tp_id
    }
    type_int()
}

pub fn is_scope_var(name: Str) -> Int {
    if find_scope_var(name) >= 0 { 1 } else { 0 }
}

pub fn get_var_type(name: Str) -> Int {
    tp_get_kind(get_var_tp(name))
}

fn get_var_mut(name: Str) -> Int {
    let idx = find_scope_var(name)
    if idx >= 0 {
        return scope_vars.get(idx).unwrap().is_mut
    }
    0
}

fn get_sv_inner1(name: Str, ctype: Int) -> Int {
    if scope_ct_count(ctype) <= 0 { return -1 }
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == ctype {
            return tp_child1_kind(sv.tp_id)
        }
        i = i - 1
    }
    let blink_name = c_blink_name(name)
    if blink_name != name {
        i = scope_vars.len() - 1
        while i >= 0 {
            let sv = scope_vars.get(i).unwrap()
            if sv.name == blink_name && sv.ctype == ctype {
                return tp_child1_kind(sv.tp_id)
            }
            i = i - 1
        }
    }
    -1
}

// The authoritative tid of the ctype-matched var, matched exactly as the flat
// get_sv_* readers do (kind + c_blink_name fallback) so a tid-first accessor and
// its flat fallback always resolve the same ScopeVar. -1 when unstamped/absent.
fn get_sv_ty(name: Str, ctype: Int) -> Int {
    if scope_ct_count(ctype) <= 0 { return -1 }
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == ctype {
            return sv.ty
        }
        i = i - 1
    }
    let blink_name = c_blink_name(name)
    if blink_name != name {
        i = scope_vars.len() - 1
        while i >= 0 {
            let sv = scope_vars.get(i).unwrap()
            if sv.name == blink_name && sv.ctype == ctype {
                return sv.ty
            }
            i = i - 1
        }
    }
    -1
}

fn get_sv_inner2(name: Str, ctype: Int) -> Int {
    if scope_ct_count(ctype) <= 0 { return -1 }
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == ctype {
            return tp_child2_kind(sv.tp_id)
        }
        i = i - 1
    }
    let blink_name = c_blink_name(name)
    if blink_name != name {
        i = scope_vars.len() - 1
        while i >= 0 {
            let sv = scope_vars.get(i).unwrap()
            if sv.name == blink_name && sv.ctype == ctype {
                return tp_child2_kind(sv.tp_id)
            }
            i = i - 1
        }
    }
    -1
}

pub fn list_contains_str(lst: List[Str], val: Str) -> Int {
    let mut i = 0
    while i < lst.len() {
        if lst.get(i).unwrap() == val {
            return 1
        }
        i = i + 1
    }
    0
}

pub fn get_capture_index(name: Str) -> Int {
    if cg_closure_cap_start < 0 {
        return -1
    }
    let mut i = 0
    while i < cg_closure_cap_count {
        if closure_captures.get(cg_closure_cap_start + i).unwrap().name == name {
            return i
        }
        i = i + 1
    }
    -1
}

// Capture boxing, rehydration, and promotion read a captured value's kind and struct name.
// An as-pattern whole binder is stamped tid-only (stamp_whole_binder_from_tid), so its tp is the
// CT_VOID placeholder and these flat reads answer nothing — the value falls to a void* passthrough
// and the emitted C is wrong. These recover kind/name from the authoritative tid, but only when the
// flat channel is the placeholder, so every already-populated capture keeps its flat answer verbatim.
// Shares sv_struct_tid_first's tid→name contract: a mono instance spells its stem, a
// non-generic struct/enum spells its bare name, and the two shapes the name cannot faithfully
// carry — a transparent newtype (a bare scalar, no aggregate) and an under-populated generic base
// (only the flat channel holds its mono suffix) — decline so the flat channel stands.
pub fn capture_sname(tid: Int, tp_id: Int) -> Str {
    let flat = tp_get_sname(tp_id)
    if flat != "" { return flat }
    let m = cg_bind_mono_tid(tid)
    let mono = tc_tid_struct_mono_name(m)
    if mono != "" { return mono }
    let nm = tc_tid_struct(m)
    if nm != "" && is_transparent_newtype(nm) == 0 && struct_def_is_generic(nm) == 0 { return nm }
    ""
}

pub fn capture_ct(tid: Int, tp_id: Int) -> Int {
    let flat = tp_get_kind(tp_id)
    if flat != CT_VOID { return flat }
    // A named struct or data enum binder boxes as a by-value aggregate (a data enum lowers to a C
    // struct); a transparent newtype declines above and stays a scalar, never mis-boxed as CT_STRUCT.
    if capture_sname(tid, tp_id) != "" { return CT_STRUCT }
    flat
}

pub fn capture_cast_expr(idx: Int) -> Str {
    let cap_e0 = closure_captures.get(cg_closure_cap_start + idx).unwrap()
    let ct = capture_ct(cap_e0.tid, cap_e0.tp_id)
    if ct == CT_INT {
        "(int64_t)(intptr_t)blink_closure_get_capture(__self, {idx})"
    } else if ct == CT_I8 {
        "(int8_t)(intptr_t)blink_closure_get_capture(__self, {idx})"
    } else if ct == CT_I16 {
        "(int16_t)(intptr_t)blink_closure_get_capture(__self, {idx})"
    } else if ct == CT_I32 {
        "(int32_t)(intptr_t)blink_closure_get_capture(__self, {idx})"
    } else if ct == CT_U8 {
        "(uint8_t)(uintptr_t)blink_closure_get_capture(__self, {idx})"
    } else if ct == CT_U16 {
        "(uint16_t)(uintptr_t)blink_closure_get_capture(__self, {idx})"
    } else if ct == CT_U32 {
        "(uint32_t)(uintptr_t)blink_closure_get_capture(__self, {idx})"
    } else if ct == CT_U64 {
        "(uint64_t)(uintptr_t)blink_closure_get_capture(__self, {idx})"
    } else if ct == CT_CHAR {
        "(int32_t)(intptr_t)blink_closure_get_capture(__self, {idx})"
    } else if ct == CT_FLOAT {
        "*(double*)blink_closure_get_capture(__self, {idx})"
    } else if ct == CT_STRING {
        "(const char*)blink_closure_get_capture(__self, {idx})"
    } else if ct == CT_BOOL {
        "(int)(intptr_t)blink_closure_get_capture(__self, {idx})"
    } else if ct == CT_LIST {
        "(blink_list*)blink_closure_get_capture(__self, {idx})"
    } else if ct == CT_MAP {
        "(blink_map*)blink_closure_get_capture(__self, {idx})"
    } else if ct == CT_BYTES {
        "(blink_bytes*)blink_closure_get_capture(__self, {idx})"
    } else if ct == CT_CLOSURE {
        "(blink_closure*)blink_closure_get_capture(__self, {idx})"
    } else if ct == CT_STRUCT {
        let sname = capture_sname(cap_e0.tid, cap_e0.tp_id)
        if sname != "" {
            "(*(({c_type_c_name(sname)}*)blink_closure_get_capture(__self, {idx})))"
        } else {
            "blink_closure_get_capture(__self, {idx})"
        }
    } else {
        "blink_closure_get_capture(__self, {idx})"
    }
}

pub let mut ffi_fn_set: Map[Str, Int] = Map()

pub fn reg_fn_as_ffi(name: Str) {
    ffi_fn_set.insert(name, 1)
}

pub fn is_fn_ffi(name: Str) -> Int {
    if ffi_fn_set.contains_key(name) {
        return 1
    }
    0
}

pub fn reg_fn(name: Str, ret: Int) ! Codegen.Register {
    if !fn_regs_idx.contains_key(name) {
        fn_regs_idx.insert(name, fn_regs.len())
    }
    fn_regs.push(FnRegEntry { name: name, ret: ret, effect_sl: -1, tp_id: sv_tp(ret, -1, -1, ""), is_trusted: 0 })
}

pub fn reg_fn_with_effects(name: Str, ret: Int, effects_sl: Int, is_trusted: Int) ! Codegen.Register {
    if !fn_regs_idx.contains_key(name) {
        fn_regs_idx.insert(name, fn_regs.len())
    }
    fn_regs.push(FnRegEntry { name: name, ret: ret, effect_sl: effects_sl, tp_id: sv_tp(ret, -1, -1, ""), is_trusted: is_trusted })
}

fn get_fn_effect_sl(name: Str) -> Int {
    let resolved = resolve_fn_lookup(name)
    match fn_regs_idx.get(resolved) {
        Some(idx) => return fn_regs.get(idx).unwrap().effect_sl
        None => {}
    }
    -1
}

fn is_fn_trusted(name: Str) -> Int {
    let resolved = resolve_fn_lookup(name)
    match fn_regs_idx.get(resolved) {
        Some(idx) => return fn_regs.get(idx).unwrap().is_trusted
        None => {}
    }
    0
}

pub fn fn_node_has_effects(fn_node: Int) -> Int {
    let eff_sl = node_effects(fn_node)
    if eff_sl != -1 && sublist_length(eff_sl) > 0 {
        return 1
    }
    0
}

pub fn fn_name_has_effects(name: Str) -> Int {
    let sl = get_fn_effect_sl(name)
    if sl != -1 && sublist_length(sl) > 0 {
        return 1
    }
    0
}

pub fn ev_arg_for_callee(callee: Str) -> Str {
    if fn_name_has_effects(callee) == 0 || is_fn_ffi(callee) != 0 {
        return ""
    }
    if cg_current_fn_has_ev != 0 {
        return "__ev"
    }
    "&__blink_ev"
}

pub fn append_ev_arg(callee: Str, args_str: Str) -> Str ! Diag.Report {
    check_effect_propagation(callee)
    let ev_arg = ev_arg_for_callee(callee)
    if ev_arg == "" {
        return args_str
    }
    if args_str == "" {
        return ev_arg
    }
    args_str.concat(", {ev_arg}")
}

pub fn ev_field(field: Str) -> Str {
    if cg_current_fn_has_ev != 0 {
        return "__ev->{field}"
    }
    "__blink_ev.{field}"
}

pub fn reg_fn_struct_ret(name: Str, stype: Str) ! Codegen.Register {
    fn_ret_structs_idx.insert(name, fn_ret_structs.len())
    fn_ret_structs.push(FnRetStructEntry { name: name, stype: stype })
}

pub fn get_fn_ret_struct(name: Str) -> Str {
    let resolved = resolve_fn_lookup(name)
    match fn_ret_structs_idx.get(resolved) {
        Some(idx) => return fn_ret_structs.get(idx).unwrap().stype
        None => {}
    }
    ""
}

pub fn reg_fn_ret_type(name: Str, kind: Int, inner1: Int, inner2: Int) ! Codegen.Register {
    fn_ret_types_idx.insert(name, fn_ret_types.len())
    fn_ret_types.push(RetType { name: name, kind: kind, inner1: inner1, inner2: inner2, tp_id: sv_tp(kind, inner1, inner2, ""), tid: -1 })
}

pub fn reg_fn_ret_type_tp(name: Str, kind: Int, inner1: Int, inner2: Int, tp_id: Int, tid: Int) ! Codegen.Register {
    fn_ret_types_idx.insert(name, fn_ret_types.len())
    fn_ret_types.push(RetType { name: name, kind: kind, inner1: inner1, inner2: inner2, tp_id: tp_id, tid: tid })
}

pub fn tp_from_ann(ann: Int) -> Int ! Codegen.Register {
    let name = node_name(ann)
    let ct = type_from_name(name)
    if ct == CT_LIST {
        let elems_sl = node_elements(ann)
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            return type_list(tp_from_ann(sublist_get(elems_sl, 0)))
        }
        return type_list(type_int())
    }
    if ct == CT_OPTION {
        let elems_sl = node_elements(ann)
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            return type_option(tp_from_ann(sublist_get(elems_sl, 0)))
        }
        return type_option(type_int())
    }
    if ct == CT_RESULT {
        let elems_sl = node_elements(ann)
        if elems_sl != -1 && sublist_length(elems_sl) >= 2 {
            let ok_tp = tp_from_ann(sublist_get(elems_sl, 0))
            let err_tp = tp_from_ann(sublist_get(elems_sl, 1))
            return type_result(ok_tp, err_tp)
        }
        return type_result(type_int(), type_string())
    }
    if ct == CT_MAP {
        let elems_sl = node_elements(ann)
        if elems_sl != -1 && sublist_length(elems_sl) >= 2 {
            let key_tp = tp_from_ann(sublist_get(elems_sl, 0))
            let val_tp = tp_from_ann(sublist_get(elems_sl, 1))
            return type_map(key_tp, val_tp)
        }
        return type_map(type_string(), type_int())
    }
    if ct == CT_SET {
        let elems_sl = node_elements(ann)
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            return type_set(tp_from_ann(sublist_get(elems_sl, 0)))
        }
        return type_set(type_string())
    }
    if ct == CT_ITERATOR {
        let elems_sl = node_elements(ann)
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            return type_iterator(tp_from_ann(sublist_get(elems_sl, 0)))
        }
        return type_iterator(type_int())
    }
    if name == "Tuple" {
        let tup_opt = resolve_tuple_ann(ann, -1, [])
        if tup_opt.is_some() {
            return sv_tp(CT_VOID, -1, -1, tup_opt.unwrap())
        }
    }
    if ct == CT_VOID {
        // sv_tp's CT_VOID arm routes a non-empty sname through
        // type_struct(sname), which hardcodes kind=CT_STRUCT — correct for the
        // common case here (an unresolved head name IS a real struct/enum, and
        // callers want CT_STRUCT+sname back). A field/element literally
        // annotated `Void` hits this same branch and loses its CT_VOID kind to
        // that collapse, so a later get_struct_field_type/get_struct_elem_type
        // read reports CT_STRUCT for a genuinely Void slot (mirrors
        // resolve_type_name's own `name == "Void" || name == ""` check).
        // Every other name keeps the existing behavior. Resolve a
        // single-level type alias (`type Unit = Void`) before the name check,
        // mirroring type_from_name's own type_alias_base lookup -- otherwise
        // an aliased Void name reaches sv_tp with the alias spelling, not
        // "Void", and rides the type_struct(sname) collapse this branch
        // exists to avoid.
        let mut resolved_name = name
        if type_alias_base.contains_key(name) {
            resolved_name = type_alias_base.get(name).unwrap()
        }
        if resolved_name == "Void" || resolved_name == "" {
            return sv_tp(CT_VOID, -1, -1, "")
        }
        // A generic-struct/enum INSTANCE annotation (`Box[Int]`) must carry its
        // mono stem (Box_Int), not the bare head `name` — the bare head is never
        // typedef'd, so reading it back erases to an undeclared `blink_Box`. Registers
        // the instance too, so its typedef gets emitted. "" (bare struct/enum,
        // typevar, or non-generic) keeps the existing bare-head spelling.
        if is_struct_type(name) != 0 || is_enum_type(name) != 0 {
            let inst_stem = register_carrier_inner_mono_instance(name, ann)
            if inst_stem != "" {
                return sv_tp(CT_VOID, -1, -1, inst_stem)
            }
        }
        return sv_tp(CT_VOID, -1, -1, name)
    }
    sv_tp(ct, -1, -1, "")
}

pub fn get_fn_ret_type(name: Str) -> RetType {
    let resolved = resolve_fn_lookup(name)
    match fn_ret_types_idx.get(resolved) {
        Some(idx) => return fn_ret_types.get(idx).unwrap()
        None => {}
    }
    RetType { name: "", kind: CT_VOID, inner1: -1, inner2: -1, tp_id: sv_tp(CT_VOID, -1, -1, ""), tid: -1 }
}

pub fn reg_fn_ret_handler(name: Str, vtable_type: Str, vtable_field: Str, is_ue: Int) {
    fn_ret_handlers_idx.insert(name, fn_ret_handlers.len())
    fn_ret_handlers.push(FnRetHandlerEntry { name: name, vtable_type: vtable_type, vtable_field: vtable_field, is_ue: is_ue })
}

pub fn get_fn_ret_handler(name: Str) -> FnRetHandlerEntry {
    let resolved = resolve_fn_lookup(name)
    match fn_ret_handlers_idx.get(resolved) {
        Some(idx) => return fn_ret_handlers.get(idx).unwrap()
        None => {}
    }
    FnRetHandlerEntry { name: "", vtable_type: "", vtable_field: "", is_ue: 0 }
}

pub fn resolve_option_inner_from_ann(fn_node: Int) -> Int {
    let ta = node_type_ann(fn_node)
    if ta != -1 {
        let elems_sl = node_elements(ta)
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            let inner_ann = sublist_get(elems_sl, 0)
            let inner_name = node_name(inner_ann)
            return type_from_name(inner_name)
        }
    }
    CT_INT
}

// The concrete struct/enum NAME of a `-> Option[Struct]` handler op's inner, suitable for
// struct_option_c_type (a generic-struct INSTANCE spells its mono stem, e.g. QBox_Int, matching
// resolve_ret_type_from_ann; a plain struct/enum spells its module-stripped head). Empty when the
// inner is not a struct/enum. Feeds the erase-only-at-boundary box in emit_return_with_trace.
pub fn ue_handler_option_inner_name(fn_node: Int) -> Str {
    let ta = node_type_ann(fn_node)
    if ta == -1 { return "" }
    let elems_sl = node_elements(ta)
    if elems_sl == -1 || sublist_length(elems_sl) < 1 { return "" }
    let inner_ann = sublist_get(elems_sl, 0)
    let inner_name = node_name(inner_ann)
    if is_struct_type(inner_name) == 0 && is_enum_type(inner_name) == 0 { return "" }
    let mono = mono_name_from_ann(strip_module_qualifier(inner_name), inner_ann, -1, [])
    if mono != "" { mono } else { strip_module_qualifier(inner_name) }
}

pub fn resolve_ret_type_from_ann(fn_node: Int) -> Str {
    let ret_str = node_return_type(fn_node)
    let ta = node_type_ann(fn_node)
    if ret_str == "Result" {
        if ta != -1 {
            let elems_sl = node_elements(ta)
            if elems_sl != -1 && sublist_length(elems_sl) >= 2 {
                let ok_ann = sublist_get(elems_sl, 0)
                let err_ann = sublist_get(elems_sl, 1)
                let ok_name = node_name(ok_ann)
                let err_name = node_name(err_ann)
                let ok_t = type_from_name(ok_name)
                let err_t = type_from_name(err_name)
                let ok_tag = resolve_result_inner_tag(ok_ann, ok_name, ok_t)
                let err_tag = resolve_result_inner_tag(err_ann, err_name, err_t)
                if ok_tag != "" || err_tag != "" {
                    let ok_t_tag = if ok_tag != "" { canonical_struct_tag(ok_tag) } else { c_type_tag(ok_t) }
                    let err_t_tag = if err_tag != "" { canonical_struct_tag(err_tag) } else { c_type_tag(err_t) }
                    return "blink_Result_{ok_t_tag}_{err_t_tag}"
                }
                return result_c_type(ok_t, err_t)
            }
        }
        return result_c_type(CT_INT, CT_STRING)
    }
    if ret_str == "Option" {
        if ta != -1 {
            let elems_sl = node_elements(ta)
            if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
                let inner_ann = sublist_get(elems_sl, 0)
                let inner_name = node_name(inner_ann)
                let inner_t = type_from_name(inner_name)
                if is_opaque_type(inner_name) != 0 {
                    // Option[@ffi.opaque] is null-pointer-optimized to the bare handle
                    // (NULL = None); it has no carrier struct (spec §9.1.4).
                    return opaque_handle_c_name(inner_name)
                }
                if is_struct_type(inner_name) != 0 || is_enum_type(inner_name) != 0 {
                    // a generic-struct INSTANCE inner spells the mono stem
                    // (QBox_Int), matching the tid path; the bare head is the fallback
                    // for a non-generic struct / typevar (mono_name_from_ann → "").
                    let mono = mono_name_from_ann(strip_module_qualifier(inner_name), inner_ann, -1, [])
                    let tag = if mono != "" { mono } else { strip_module_qualifier(inner_name) }
                    return "blink_Option_{canonical_struct_tag(tag)}"
                }
                if is_compound_ct(inner_t) != 0 || inner_name == "Tuple" {
                    let compound_name = compound_name_from_ann(inner_ann)
                    ensure_struct_option_type(compound_name)
                    return struct_option_c_type(compound_name)
                }
                return option_c_type(inner_t)
            }
        }
        return option_c_type(CT_INT)
    }
    if ret_str == "Tuple" {
        if ta != -1 {
            let tn_opt = resolve_tuple_ann(ta, -1, [])
            if tn_opt.is_some() {
                return c_type_c_name(tn_opt.unwrap())
            }
        }
    }
    if ret_str == "Ptr" {
        if ta != -1 {
            let elems_sl = node_elements(ta)
            if elems_sl != -1 && sublist_length(elems_sl) > 0 {
                let inner_ann = sublist_get(elems_sl, 0)
                let inner_name = node_name(inner_ann)
                return "{ptr_inner_c_type(inner_name)}*"
            }
        }
        return "void*"
    }
    if ret_str == "Handler" {
        if ta != -1 {
            let elems_sl = node_elements(ta)
            if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
                let effect_ann = sublist_get(elems_sl, 0)
                let effect_name = node_name(effect_ann)
                let vt = resolve_effect_vtable(effect_name)
                if vt != "" {
                    return "{vt}*"
                }
            }
        }
        return "void*"
    }
    ""
}

pub fn nth_type_arg(args_csv: Str, idx: Int) -> Str {
    let mut seg_start = 0
    let mut seg_idx = 0
    let mut ci = 0
    while ci <= args_csv.len() {
        if ci == args_csv.len() || args_csv.byte_at(ci) == 44 {
            if seg_idx == idx {
                return args_csv.substring(seg_start, ci - seg_start)
            }
            seg_idx = seg_idx + 1
            seg_start = ci + 1
        }
        ci = ci + 1
    }
    ""
}

// Type-param resolver for the codegen_types trio (resolve_tuple_ann /
// mono_name_from_ann / struct_concrete_args_from_target). `segs` is a pre-lowered
// segment list ALIGNED TO tparams_sl (segs[pi] = the concrete C-tag segment for the
// pi-th type param, or "" when that slot has no encodable tid). The caller lowers it
// via segs_from_arg_tids (codegen_expr) because codegen_types sits BELOW typecheck in
// the import graph and cannot reach tc_seg_from_tid itself. A param that matches an
// encodable slot returns that segment; everything else — no tparams, a name that is
// not a binder, empty/short segs, or an unencodable slot ("") — returns the param name
// unchanged, which is also what the caller wants for an already-concrete type name.
pub fn resolve_tparam_seg(param_name: Str, tparams_sl: Int, segs: List[Str]) -> Str {
    if tparams_sl != -1 {
        let mut pi = 0
        while pi < sublist_length(tparams_sl) {
            if node_name(sublist_get(tparams_sl, pi)) == param_name {
                if pi < segs.len() {
                    let seg = segs.get(pi).unwrap()
                    if seg != "" {
                        return seg
                    }
                }
                break
            }
            pi = pi + 1
        }
    }
    param_name
}

pub fn tuple_c_name_from_ann(ta: Int, fallback: Str) -> Str {
    if ta == -1 { return fallback }
    let opt = resolve_tuple_ann(ta, -1, [])
    if opt.is_some() { c_type_c_name(opt.unwrap()) } else { fallback }
}

pub fn resolve_tuple_ann(ta: Int, tparams_sl: Int, segs: List[Str]) -> Option[Str] {
    let elems_sl = node_elements(ta)
    if elems_sl == -1 {
        return None
    }
    let arity = sublist_length(elems_sl)
    let mut tags = ""
    let mut elem_types_enc = ""
    let mut elem_structs_enc = ""
    let mut elem_names_enc = ""
    let mut i = 0
    while i < arity {
        let elem_ann = sublist_get(elems_sl, i)
        let elem_name_raw = node_name(elem_ann)
        let elem_name = resolve_tparam_seg(elem_name_raw, tparams_sl, segs)
        // A typevar substituted to a whole Option/Result arrives as the canonical
        // carrier tag (Option_str, Result_int_str) rather than an annotation with
        // child nodes. Recognize it so the tuple slot gets the parameterized
        // carrier (blink_Option_str) instead of bailing (type_from_name → CT_VOID
        // → None) or lowering to `void`. Map tags stay bare ("Map") and fall to
        // the uniform blink_map* scalar path below.
        let carrier_tag = if elem_name.starts_with("Option_") || elem_name.starts_with("Result_") { elem_name } else { "" }
        // A nested-tuple element arrives as an annotation node named "Tuple" with
        // no matching scalar/struct/enum type. Recurse to register the inner tuple
        // typedef, then embed its C type BY VALUE (like a struct element). The
        // recursion's own ensure_tuple_type runs before the outer one below, so the
        // inner typedef is registered first; the BLINK_TD_ guard keeps emit order safe.
        let nested_tuple = if carrier_tag == "" && elem_name_raw == "Tuple" { resolve_tuple_ann(elem_ann, tparams_sl, segs) } else { None }
        // A transparent newtype (Errno) lowers to a bare int64_t everywhere, so
        // the tuple field must be `int` — the same erasure the inferred path
        // (emit_tuple_lit) applies and the field read expects. Naming it by the
        // boxed enum tag emits a `blink_Errno` field the int read cannot assign.
        let is_tnt = carrier_tag == "" && nested_tuple.is_none() && is_transparent_newtype(elem_name) != 0
        let elem_t = if carrier_tag != "" { compound_tag_ct(carrier_tag) } else if is_tnt { CT_INT } else { type_from_name(elem_name) }
        // A genuine Void element (elem_name literally "Void", the same discriminant
        // c_field_type_str keys on) is admitted rather than declined. Every
        // other unresolved/unknown name still declines: type_from_name collapses "" and
        // any unrecognized name onto CT_VOID too, and only the exact name "Void" has a
        // placeholder lowering downstream.
        if carrier_tag == "" && nested_tuple.is_none() && elem_t == CT_VOID && elem_name != "Void" && is_struct_type(elem_name) == 0 && is_enum_type(elem_name) == 0 {
            return None
        }
        if i > 0 {
            tags = tags.concat("_")
            elem_types_enc = elem_types_enc.concat(",")
            elem_structs_enc = elem_structs_enc.concat(",")
            elem_names_enc = elem_names_enc.concat(",")
        }
        if is_tnt {
            tags = tags.concat(c_type_tag(CT_INT))
            elem_structs_enc = elem_structs_enc.concat("-")
        } else if nested_tuple.is_some() {
            let inner_c_name = nested_tuple.unwrap()
            tags = tags.concat(inner_c_name)
            elem_structs_enc = elem_structs_enc.concat(inner_c_name)
        } else if carrier_tag != "" {
            let canon = canonical_struct_tag(carrier_tag)
            ensure_carrier_from_tag(canon)
            tags = tags.concat(canon)
            elem_structs_enc = elem_structs_enc.concat(canon)
        } else if is_struct_type(elem_name) != 0 || is_enum_type(elem_name) != 0 {
            // A struct/enum-INSTANCE element (`(LocBox[Int], Int)`) must carry its
            // concrete type-args into the tuple field type (LocBox_Int), not the
            // bare arg-erased head (LocBox) — else the field is typed blink_LocBox
            // (never typedef'd) while the value is blink_LocBox_Int.
            // mono_name_from_ann recurses elem_ann's type-args through the current
            // mono context, mirroring resolve_result_inner_tag. Falls back to the
            // bare head for a truly generic element (unsubstituted typevar / no args).
            let mono = mono_name_from_ann(strip_module_qualifier(elem_name), elem_ann, tparams_sl, segs)
            let struct_tag = if mono != "" { mono } else { c_type_tag_for_struct(elem_name) }
            tags = tags.concat(struct_tag)
            elem_structs_enc = elem_structs_enc.concat(struct_tag)
        } else if (elem_t == CT_OPTION || elem_t == CT_RESULT) && elem_name == elem_name_raw {
            // Annotation genuinely spells a by-value carrier (e.g. `Option[Int]`):
            // read its inner shape from the node's child anns and embed the carrier
            // struct by value. Map is NOT here — it is a POINTER carrier (blink_map*),
            // stored erased through the scalar branch below like List/Set.
            ensure_compound_type_from_ann(elem_ann)
            let compound_name = canonical_struct_tag(compound_name_from_ann(elem_ann))
            tags = tags.concat(compound_name)
            elem_structs_enc = elem_structs_enc.concat(compound_name)
        } else {
            // Scalar, a pointer carrier (Map/List/Set — genuine `Map[Str, Int]` or a
            // typevar `T` → `Map`), or a typevar substituted to a bare compound. The
            // inner types are erased to the bare pointer (blink_map*) regardless of K/V,
            // matching the param and the tid path; the field lowers through
            // c_field_type_str(elem_t) with an empty elem_struct. Use the type-erased tag.
            tags = tags.concat(c_type_tag(elem_t))
            elem_structs_enc = elem_structs_enc.concat("-")
        }
        elem_types_enc = elem_types_enc.concat("{elem_t}")
        elem_names_enc = elem_names_enc.concat(if elem_name == "Void" { "Void" } else { "" })
        i = i + 1
    }
    let tup_name = tuple_c_type_name(tags, arity)
    ensure_tuple_type(tup_name, arity, elem_types_enc, elem_structs_enc, elem_names_enc)
    Some(tup_name)
}

// A type alias to a carrier (type MB = Option[Point]) is transparent: peel the
// return annotation to its underlying carrier node so the branches below fire on
// the real head + type args instead of the erased alias name. Mirrors
// resolve_alias_ann, but stays local to codegen_types (find_type_def_node).
fn peel_ret_alias_ann(ann: Int) -> Int {
    let mut cur = ann
    let mut guard = 0
    while guard < 64 {
        if cur == -1 { return cur }
        if type_alias_base.contains_key(node_name(cur)) == 0 { return cur }
        let atd = find_type_def_node(node_name(cur))
        if atd == -1 || node_fields(atd) != -1 || node_value(atd) == -1 { return cur }
        cur = node_value(atd)
        guard = guard + 1
    }
    cur
}

pub fn reg_fn_ret_from_ann(name: Str, fn_node: Int) ! Codegen.Register {
    // The tid is read from ta0 (the written annotation node), not the alias-peeled ta:
    // typecheck stamps the tid on the annotation node it saw (the alias name), so an
    // alias return (MB = Option[Point]) has its tid on ta0. The pool node still needs the
    // peeled ta to walk the real carrier shape.
    let ta0 = node_type_ann(fn_node)
    let ta = peel_ret_alias_ann(ta0)
    let ret_str = if ta != ta0 && ta != -1 { node_name(ta) } else { node_return_type(fn_node) }
    if ret_str == "Result" {
        if ta != -1 {
            let elems_sl = node_elements(ta)
            if elems_sl != -1 && sublist_length(elems_sl) >= 2 {
                let ok_ann = sublist_get(elems_sl, 0)
                let err_ann = sublist_get(elems_sl, 1)
                let ok_name = node_name(ok_ann)
                let err_name = node_name(err_ann)
                let ok_t = type_from_name(ok_name)
                let err_t = type_from_name(err_name)
                let bare_ok = resolve_result_inner_tag(ok_ann, ok_name, ok_t)
                let bare_err = resolve_result_inner_tag(err_ann, err_name, err_t)
                reg_fn_ret_type_tp(name, CT_RESULT, ok_t, err_t, tp_from_ann(ta), tc_lookup_node_tid(ta0))
                if bare_ok != "" || bare_err != "" {
                    if is_compound_ct(ok_t) != 0 {
                        ensure_compound_type_from_ann(ok_ann)
                    }
                    if is_compound_ct(err_t) != 0 {
                        ensure_compound_type_from_ann(err_ann)
                    }
                    reg_fn_ret_struct_inner(name, bare_ok, bare_err)
                    let ok_tag = if bare_ok != "" { bare_ok } else { c_type_tag(ok_t) }
                    let err_tag = if bare_err != "" { bare_err } else { c_type_tag(err_t) }
                    ensure_struct_result_type(ok_tag, err_tag)
                } else {
                    ensure_result_type(ok_t, err_t)
                }
            }
        } else {
            reg_fn_ret_type_tp(name, CT_RESULT, CT_INT, CT_STRING, sv_tp(CT_RESULT, CT_INT, CT_STRING, ""), make_result_type(tc_scalar_tid_for_ct(CT_INT), tc_scalar_tid_for_ct(CT_STRING)))
            ensure_result_type(CT_INT, CT_STRING)
        }
    }
    if ret_str == "Option" {
        if ta != -1 {
            let elems_sl = node_elements(ta)
            if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
                let inner_ann = sublist_get(elems_sl, 0)
                let inner_name = node_name(inner_ann)
                let inner_t = type_from_name(inner_name)
                reg_fn_ret_type_tp(name, CT_OPTION, inner_t, -1, tp_from_ann(ta), tc_lookup_node_tid(ta0))
                if is_struct_type(inner_name) != 0 || is_enum_type(inner_name) != 0 {
                    // register the mono INSTANCE (QBox_Int) so the carrier
                    // typedef's value member resolves to blink_QBox_Int, not an
                    // undeclared blink_QBox. "" falls back to the bare head.
                    let mono = register_carrier_inner_mono_instance(inner_name, inner_ann)
                    let bare_inner = if mono != "" { mono } else { strip_module_qualifier(inner_name) }
                    reg_fn_ret_struct_inner(name, bare_inner, "")
                    ensure_struct_option_type(bare_inner)
                } else if is_compound_ct(inner_t) != 0 {
                    ensure_compound_type_from_ann(inner_ann)
                    let compound_name = compound_name_from_ann(inner_ann)
                    reg_fn_ret_struct_inner(name, compound_name, "")
                    ensure_struct_option_type(compound_name)
                } else {
                    ensure_option_type(inner_t)
                }
            }
        } else {
            reg_fn_ret_type_tp(name, CT_OPTION, CT_INT, -1, sv_tp(CT_OPTION, CT_INT, -1, ""), make_option_type(tc_scalar_tid_for_ct(CT_INT)))
            ensure_option_type(CT_INT)
        }
    }
    if ret_str == "List" && ta != -1 {
        let elems_sl = node_elements(ta)
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            let elem_ann = sublist_get(elems_sl, 0)
            let elem_name = node_name(elem_ann)
            let elem_t = type_from_name(elem_name)
            reg_fn_ret_type_tp(name, CT_LIST, elem_t, -1, tp_from_ann(ta), tc_lookup_node_tid(ta0))
            if is_struct_type(elem_name) != 0 || is_enum_type(elem_name) != 0 {
                reg_fn_ret_struct_inner(name, strip_module_qualifier(elem_name), "")
            } else if is_compound_ct(elem_t) != 0 {
                ensure_compound_type_from_ann(elem_ann)
            }
        }
    }
    if ret_str == "Set" && ta != -1 {
        // Only the tid is registered, no reg_fn_ret_struct_inner: the CT_SET consumer
        // in emit_call fills just the element-kind field off this tid and has no
        // struct-inner slot (unlike List). A struct-element set names its element from
        // the set var's own tid at the use site, not this fn-return channel.
        let elems_sl = node_elements(ta)
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            let elem_ann = sublist_get(elems_sl, 0)
            let elem_t = type_from_name(node_name(elem_ann))
            reg_fn_ret_type_tp(name, CT_SET, elem_t, -1, tp_from_ann(ta), tc_lookup_node_tid(ta0))
        }
    }
    if ret_str == "Map" && ta != -1 {
        let elems_sl = node_elements(ta)
        if elems_sl != -1 && sublist_length(elems_sl) >= 2 {
            let key_ann = sublist_get(elems_sl, 0)
            let val_ann = sublist_get(elems_sl, 1)
            let key_name = node_name(key_ann)
            let val_name = node_name(val_ann)
            let key_t = type_from_name(key_name)
            let val_t = type_from_name(val_name)
            reg_fn_ret_type_tp(name, CT_MAP, key_t, val_t, tp_from_ann(ta), tc_lookup_node_tid(ta0))
            // Mirror the Option branch above: a struct/enum-instance Map
            // value (Box[Int]) needs its mono INSTANCE registered here too, or its
            // typedef never gets emitted when nothing else in the compile unit
            // directly constructs one -- the declaration-time registration point,
            // not a call/assign site.
            if is_struct_type(val_name) != 0 || is_enum_type(val_name) != 0 {
                register_carrier_inner_mono_instance(val_name, val_ann)
            }
            if is_struct_type(key_name) != 0 || is_enum_type(key_name) != 0 {
                register_carrier_inner_mono_instance(key_name, key_ann)
            }
        }
    }
    if ret_str == "Tuple" && ta != -1 {
        let tup_c_name = resolve_tuple_ann(ta, -1, [])
        if tup_c_name.is_some() {
            reg_fn_struct_ret(name, tup_c_name.unwrap())
        }
    }
    if ret_str == "Handler" && ta != -1 {
        let elems_sl = node_elements(ta)
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            let effect_ann = sublist_get(elems_sl, 0)
            let effect_name = node_name(effect_ann)
            let vtt = resolve_effect_vtable(effect_name)
            let vtf = resolve_effect_field(effect_name)
            let is_ue = resolve_effect_is_ue(effect_name)
            reg_fn_ret_handler(name, vtt, vtf, is_ue)
        }
    }
}

pub fn reg_fn_ret_struct_inner(name: Str, ok_s: Str, err_s: Str) {
    fn_ret_struct_inners_idx.insert(name, fn_ret_struct_inners.len())
    fn_ret_struct_inners.push(FnRetStructInner { name: name, ok_struct: ok_s, err_struct: err_s })
}

pub fn get_fn_ret_struct_inner(name: Str) -> FnRetStructInner {
    let resolved = resolve_fn_lookup(name)
    match fn_ret_struct_inners_idx.get(resolved) {
        Some(idx) => return fn_ret_struct_inners.get(idx).unwrap()
        None => {}
    }
    FnRetStructInner { name: "", ok_struct: "", err_struct: "" }
}

pub fn reg_effect(name: Str, parent: Int) -> Int ! Codegen.Register {
    let idx = effect_entries.len()
    effect_entries.push(EffectEntry { name: name, parent: parent })
    idx
}

fn get_effect_idx(name: Str) -> Int {
    let mut i = 0
    while i < effect_entries.len() {
        if effect_entries.get(i).unwrap().name == name {
            return i
        }
        i = i + 1
    }
    -1
}

fn effect_satisfies(caller_effect: Str, callee_effect: Str) -> Int {
    if caller_effect == callee_effect {
        return 1
    }
    let callee_idx = get_effect_idx(callee_effect)
    if callee_idx == -1 {
        return 0
    }
    let parent_idx = effect_entries.get(callee_idx).unwrap().parent
    if parent_idx == -1 {
        return 0
    }
    let parent_name = effect_entries.get(parent_idx).unwrap().name
    if parent_name == caller_effect {
        return 1
    }
    0
}

pub fn check_effect_propagation(callee_name: Str) ! Diag.Report {
    if cg_current_fn_name == "main" || cg_current_fn_name.starts_with("__test_") || cg_current_fn_name.starts_with("__async_task_") {
        return
    }
    let callee_sl = get_fn_effect_sl(callee_name)
    if callee_sl == -1 {
        return
    }
    let callee_count = sublist_length(callee_sl)
    if callee_count == 0 {
        return
    }
    let callee_trusted = is_fn_trusted(callee_name)
    let caller_sl = get_fn_effect_sl(cg_current_fn_name)
    let mut ci = 0
    while ci < callee_count {
        let callee_eff_node = sublist_get(callee_sl, ci)
        let callee_eff = node_name(callee_eff_node)
        if callee_eff == "FFI" && callee_trusted != 0 {
            ci = ci + 1
            continue
        }
        // Q5 escape boundary: `with arena { }` discharges `! Arena` from the
        // enclosing fn. Skip propagation for the Arena effect only while we
        // are inside such a block. Other effects still propagate.
        if cg_with_arena_depth > 0 && callee_eff == "Arena" {
            ci = ci + 1
            continue
        }
        let mut satisfied = 0
        if caller_sl != -1 {
            let caller_count = sublist_length(caller_sl)
            let mut ki = 0
            while ki < caller_count {
                let caller_eff_node = sublist_get(caller_sl, ki)
                let caller_eff = node_name(caller_eff_node)
                if effect_satisfies(caller_eff, callee_eff) != 0 {
                    satisfied = 1
                }
                ki = ki + 1
            }
        }
        if satisfied == 0 {
            diag_error_no_loc("UndeclaredEffect", UNDECLARED_EFFECT, "function '{callee_name}' requires effect '{callee_eff}' but caller '{cg_current_fn_name}' does not declare it", "add '! {callee_eff}' to the function signature of '{cg_current_fn_name}'")
            diag_set_last_fix("insert", "! {callee_eff}")
        }
        ci = ci + 1
    }
}

pub fn init_builtin_effects() ! Codegen.Register {
    let io_idx = reg_effect("IO", -1)
    reg_effect("IO.Print", io_idx)
    reg_effect("IO.Log", io_idx)
    reg_effect("IO.Eprint", io_idx)
    let fs_idx = reg_effect("FS", -1)
    reg_effect("FS.Read", fs_idx)
    reg_effect("FS.Write", fs_idx)
    reg_effect("FS.Delete", fs_idx)
    reg_effect("FS.Watch", fs_idx)
    let net_idx = reg_effect("Net", -1)
    reg_effect("Net.Connect", net_idx)
    reg_effect("Net.Listen", net_idx)
    reg_effect("Net.DNS", net_idx)
    let env_idx = reg_effect("Env", -1)
    reg_effect("Env.Read", env_idx)
    reg_effect("Env.Write", env_idx)
    let time_idx = reg_effect("Time", -1)
    reg_effect("Time.Read", time_idx)
    reg_effect("Time.Sleep", time_idx)
    reg_effect("Rand", -1)
    let crypto_idx = reg_effect("Crypto", -1)
    reg_effect("Crypto.Hash", crypto_idx)
    reg_effect("Crypto.Sign", crypto_idx)
    reg_effect("Crypto.Encrypt", crypto_idx)
    reg_effect("Crypto.Decrypt", crypto_idx)
    let proc_idx = reg_effect("Process", -1)
    reg_effect("Process.Spawn", proc_idx)
    reg_effect("Process.Signal", proc_idx)
    let async_idx = reg_effect("Async", -1)
    reg_effect("Async.Spawn", async_idx)
    reg_effect("Async.Channel", async_idx)
}

fn get_ue_handle(effect_name: Str) -> Str {
    let mut i = 0
    while i < ue_effects.len() {
        let ue = ue_effects.get(i).unwrap()
        if ue.name == effect_name {
            return ue.handle
        }
        i = i + 1
    }
    ""
}

fn get_ue_top_for_handle(handle: Str) -> Str {
    let mut i = 0
    while i < ue_effects.len() {
        let ue = ue_effects.get(i).unwrap()
        if ue.handle == handle {
            return ue.name
        }
        i = i + 1
    }
    ""
}

pub fn is_user_effect_handle(name: Str) -> Int {
    let mut i = 0
    while i < ue_effects.len() {
        if ue_effects.get(i).unwrap().handle == name {
            return 1
        }
        i = i + 1
    }
    0
}

fn ue_has_method(handle: Str, method: Str) -> Int {
    let mut i = 0
    while i < ue_methods.len() {
        let uem = ue_methods.get(i).unwrap()
        if uem.effect_handle == handle && uem.name == method {
            return 1
        }
        i = i + 1
    }
    0
}

pub fn is_fn_registered(name: Str) -> Int {
    let resolved = resolve_fn_lookup(name)
    if fn_regs_idx.contains_key(resolved) { return 1 }
    0
}

pub fn get_fn_ret(name: Str) -> Int {
    let resolved = resolve_fn_lookup(name)
    match fn_regs_idx.get(resolved) {
        Some(idx) => {
            return fn_regs.get(idx).unwrap().ret
        }
        None => {}
    }
    CT_VOID
}

pub fn set_list_elem_type(name: Str, elem_type: Int) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_LIST {
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: elem_type, inner2: sv.inner2, sname: sv.sname, sname2: sv.sname2, ty: sv.ty, tp_id: sv_tp(sv.ctype, elem_type, sv.inner2, sv.sname) })
            return
        }
        i = i - 1
    }
    push_scope_var(ScopeVar { name: name, ctype: CT_LIST, is_mut: 0, inner1: elem_type, inner2: -1, sname: "", sname2: "", ty: -1, tp_id: sv_tp(CT_LIST, elem_type, -1, "") })
}

// the list element with NO Int default — -1 when nothing ever recorded one.
//
// `get_list_elem_type` below cannot report that, and not by oversight: it reads
// `tp_child1_kind`, and `sv_tp(CT_LIST, -1, ..)` answers `type_list(type_int())`. A list whose
// element was lost and a genuine `List[Int]` are the same pool entry, bit for bit, so every
// question asked through the pool comes back "Int" and a fill-only stamp would decline forever.
// The raw flat `inner1` field is kept alongside `tp_id` by every setter and still says -1, which
// makes it the only place the distinction survives. Mirrors get_map_key_type_raw.
//
// Falls back to the pool answer for a name that is not a scope var (a closure capture carries a
// tp_id and no flat fields), because a missing answer must read as SET there: declining is a
// no-op, while writing over a capture's real element would be a new silent-wrong.
pub fn get_list_elem_type_raw(name: Str) -> Int {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_LIST {
            return sv.inner1
        }
        i = i - 1
    }
    let alt = c_blink_name(name)
    if alt != name {
        let mut j = scope_vars.len() - 1
        while j >= 0 {
            let sv = scope_vars.get(j).unwrap()
            if sv.name == alt && sv.ctype == CT_LIST {
                return sv.inner1
            }
            j = j - 1
        }
    }
    get_list_elem_type(name)
}

pub fn get_list_elem_type(name: Str) -> Int {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_LIST {
            if sv.ty >= 0 {
                let e = tc_tid_list_elem_ct_resolved(cg_bind_mono_tid(sv.ty))
                // An enum element is name-carried and stored by ordinal; the flat
                // CT drives the plain-enum ordinal arm, so decline CT_ENUM and let
                // the flat answer stand (identity comes from get_list_elem_struct).
                if e >= 0 && e != CT_ENUM { return e }
            }
            // Container-sname invariant: no list setter bakes a struct into the
            // element child, so the pool child1 kind equals the flat inner1.
            return sv.inner1
        }
        i = i - 1
    }
    let alt = c_blink_name(name)
    if alt != name {
        let mut j = scope_vars.len() - 1
        while j >= 0 {
            let sv = scope_vars.get(j).unwrap()
            if sv.name == alt && sv.ctype == CT_LIST {
                if sv.ty >= 0 {
                    let e = tc_tid_list_elem_ct_resolved(cg_bind_mono_tid(sv.ty))
                    if e >= 0 && e != CT_ENUM { return e }
                }
                return sv.inner1
            }
            j = j - 1
        }
    }
    -1
}

// The RESOLVED element tid of a list var (or -1 when the var has no tid). Unlike
// get_list_elem_type (which flattens to a single CT), this returns the whole tid so
// a caller can spell the element's C type via c_type_from_tid — needed to read a
// boxed carrier/struct element back as a VALUE (`*(blink_Option_int*)…`) rather than
// a scalar handle.
pub fn get_list_elem_tid(name: Str) -> Int {
    let lt = get_sv_ty(name, CT_LIST)
    if lt >= 0 {
        return tc_tid_list_elem(cg_bind_mono_tid(lt))
    }
    -1
}

pub fn set_list_nested_elem_type(name: Str, nested_type: Int) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_LIST {
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: sv.inner1, inner2: nested_type, sname: sv.sname, sname2: sv.sname2, ty: sv.ty, tp_id: sv_tp(sv.ctype, sv.inner1, nested_type, sv.sname) })
            return
        }
        i = i - 1
    }
}

pub fn get_list_nested_elem_type(name: Str) -> Int {
    let lt = get_sv_ty(name, CT_LIST)
    if lt >= 0 {
        let et = tc_tid_list_elem(cg_bind_mono_tid(lt))
        let ek = tc_tid_ct(et)
        if ek == CT_LIST {
            let c = tc_tid_list_elem_ct(et)
            // Tid leads for a leaf-scalar inner-list element; struct/container
            // inners ride the pool child below (mirrors get_list_elem_result_ok).
            if c >= 0 && is_leaf_scalar_ct(c) != 0 { return c }
        } else if ek == CT_SET {
            let c = tc_tid_set_elem_ct(et)
            if c >= 0 && is_leaf_scalar_ct(c) != 0 { return c }
        }
    }
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_LIST {
            let c1 = tp_get_child1(sv.tp_id)
            if c1 >= 0 && (tp_get_kind(c1) == CT_LIST || tp_get_kind(c1) == CT_SET) {
                return tp_child1_kind(c1)
            }
            return -1
        }
        i = i - 1
    }
    -1
}

pub fn get_list_nested_elem_struct(name: Str) -> Str {
    let lt = get_sv_ty(name, CT_LIST)
    if lt >= 0 {
        let et = tc_tid_list_elem(cg_bind_mono_tid(lt))
        let ek = tc_tid_ct(et)
        if ek == CT_LIST {
            let sm = tc_tid_list_elem_struct_mono(et)
            if sm != "" { return sm }
            let sp = tc_tid_list_elem_struct(et)
            if sp != "" && is_transparent_newtype(sp) == 0 && struct_def_is_generic(sp) == 0 { return sp }
        } else if ek == CT_SET {
            let sm = tc_tid_set_elem_struct_mono(et)
            if sm != "" { return sm }
            let sp = tc_tid_set_elem_struct(et)
            if sp != "" && is_transparent_newtype(sp) == 0 && struct_def_is_generic(sp) == 0 { return sp }
        }
    }
    ""
}

pub fn get_list_elem_map_key_type(name: Str) -> Int {
    let lt = get_sv_ty(name, CT_LIST)
    if lt >= 0 {
        let et = tc_tid_list_elem(cg_bind_mono_tid(lt))
        if tc_tid_ct(et) == CT_MAP {
            let c = tc_tid_map_key_ct(et)
            // Tid leads for a leaf-scalar key; struct/enum keys ride the pool child
            // below (mirrors get_list_elem_result_ok).
            if c >= 0 && is_leaf_scalar_ct(c) != 0 { return c }
        }
    }
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_LIST {
            let c1 = tp_get_child1(sv.tp_id)
            if c1 >= 0 && tp_get_kind(c1) == CT_MAP {
                return tp_child1_kind(c1)
            }
            return -1
        }
        i = i - 1
    }
    -1
}

pub fn get_list_elem_map_val_type(name: Str) -> Int {
    let lt = get_sv_ty(name, CT_LIST)
    if lt >= 0 {
        let et = tc_tid_list_elem(cg_bind_mono_tid(lt))
        if tc_tid_ct(et) == CT_MAP {
            let c = tc_tid_map_val_ct(et)
            // Tid leads for a leaf-scalar value; struct/enum/container values ride the
            // pool child below (mirrors get_list_elem_result_ok).
            if c >= 0 && is_leaf_scalar_ct(c) != 0 { return c }
        }
    }
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_LIST {
            let c1 = tp_get_child1(sv.tp_id)
            if c1 >= 0 && tp_get_kind(c1) == CT_MAP {
                return tp_child2_kind(c1)
            }
            return -1
        }
        i = i - 1
    }
    -1
}

// The struct/tuple NAME of a List[Map[K,V]] element-map value, or "" when the
// value is scalar/unset. Tid-only, mirroring get_map_value_struct: the mono stem
// (generic instances), then the struct/enum head (plain named structs the mono
// step declines), then the tuple tag. A projection temp (a fn return, a tuple
// element) carries the list tid too — emit_list_method stamps it from the node
// tid before this runs — so the flat pool child2_sname fallback is gone.
pub fn get_list_elem_map_val_struct(name: Str) -> Str {
    let lt = get_sv_ty(name, CT_LIST)
    if lt >= 0 {
        let et = tc_tid_list_elem(cg_bind_mono_tid(lt))
        if tc_tid_ct(et) == CT_MAP {
            let mono = tc_tid_map_val_struct_mono(et)
            if mono != "" { return mono }
            let nm = tc_tid_map_val_struct_head(et)
            if nm != "" { return nm }
            let tup = tc_tid_map_val_tuple(et)
            if tup != "" { return tup }
        }
    }
    ""
}

// Record a List's element-map key+value types as a full nested type
// (`type_list(type_map(k, v))`). The flat inner1/inner2 ScopeVar slots can't
// hold three type params (list→map→{k,v}); set_list_elem_type(CT_MAP) lowers
// the map value to the default Int. Building the tp_id directly preserves V so
// List[Map[K,V]].get()/pop() carry the right value type.
//
// A struct map value (val_ct == CT_STRUCT, val_name non-empty) flows
// through sv_tp's CT_STRUCT case as type_struct(val_name), so the struct name
// survives on the map node's child2 sname — recovered by
// get_list_elem_map_val_struct. Scalar values (val_name == "") are unchanged.
pub fn set_list_elem_map_types(name: Str, key_ct: Int, val_ct: Int, val_name: Str) {
    let map_tp = sv_tp(CT_MAP, key_ct, val_ct, val_name)
    let list_tp = type_list(map_tp)
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_LIST {
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: CT_MAP, inner2: sv.inner2, sname: sv.sname, sname2: sv.sname2, ty: sv.ty, tp_id: list_tp })
            return
        }
        i = i - 1
    }
    push_scope_var(ScopeVar { name: name, ctype: CT_LIST, is_mut: 0, inner1: CT_MAP, inner2: -1, sname: "", sname2: "", ty: -1, tp_id: list_tp })
}

// Record a List's element-OPTION inner as a full nested type
// (`type_list(type_option(inner))`). Like set_list_elem_map_types, the
// flat inner1/inner2 slots can't hold list→option→inner: the plain
// set_list_elem_type(CT_OPTION) chain lowers the Option inner to the default Int.
// Building the tp_id directly preserves the concrete inner (Str / a struct) so
// List[Option[T]].get()/for-in carry the right inner type. `inner_struct` names a
// struct/enum inner (routed through sv_tp's CT_STRUCT case); scalars pass "".
// Core write-side that stamps a pre-built list tp (`type_list(<inner>)`)
// onto the var. `inner_marker` is the element's own CT (CT_OPTION/CT_RESULT) kept
// in the flat inner1 slot for the legacy callers that still read it. The inner tp
// is arbitrarily deep — this is how `List[Option[Map[Int,Str]]]` stores its full
// list→option→map→{k,v} shape (the flat sv_tp path collapses the Map's K/V).
fn set_list_elem_compound_tp(name: Str, list_tp: Int, inner_marker: Int) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_LIST {
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: inner_marker, inner2: sv.inner2, sname: sv.sname, sname2: sv.sname2, ty: sv.ty, tp_id: list_tp })
            return
        }
        i = i - 1
    }
    push_scope_var(ScopeVar { name: name, ctype: CT_LIST, is_mut: 0, inner1: inner_marker, inner2: -1, sname: "", sname2: "", ty: -1, tp_id: list_tp })
}

// Record a List's element-OPTION from a pre-built inner tp
// (`type_option(<deep inner tp>)`). The deep-tp caller
// (set_list_elem_compound_ann) passes the fully-recursive inner so a nested
// container inside the Option — `List[Option[Map[K,V]]]`,
// `List[Option[List[T]]]` — keeps its own type params.
pub fn set_list_elem_option_tp(name: Str, inner_tp: Int) {
    set_list_elem_compound_tp(name, type_list(type_option(inner_tp)), CT_OPTION)
}

// Record a List's element-OPTION inner as a full nested type
// (`type_list(type_option(inner))`). The scalar/bare-struct convenience twin of
// set_list_elem_option_tp — `inner_struct` names a struct/enum inner ("" for
// scalars), routed through sv_tp's CT_STRUCT case. Passes the Option's INNER tp
// (`sv_tp(inner_ct, …)`) — set_list_elem_option_tp adds the single Option wrap; a
// double sv_tp(CT_OPTION, …) here would nest the element as Option[Option[T]].
pub fn set_list_elem_option(name: Str, inner_ct: Int, inner_struct: Str) {
    set_list_elem_option_tp(name, sv_tp(inner_ct, -1, -1, inner_struct))
}

// What a List's element is, when that element is a NAMED BY-VALUE type — a struct, a
// tuple, or an enum. `iter_from_source` needs this because the flat element pair cannot answer
// it: a struct/tuple element reads `(CT_VOID, sname)` and a PLAIN (payload-less) enum element
// reads `(CT_VOID, "")`, and `c_type_tag(CT_VOID)` is "void", so the iterator family keys itself
// on `blink_ListIterator_void`.
//
// The two answers are not one answer, because the two are not stored the same way in a list slot.
// A struct, a tuple, and a DATA enum are POINTER-boxed (`blink_alloc` + `(void*)box`), so they
// need a pointer carrier tag exactly like an Option or a Result element. A plain enum is
// VALUE-boxed like an Int — `blink_list_push(l, (void*)(intptr_t)blink_Col_Red)` — because the
// variant expression itself evaluates as CT_INT with no struct name, and `.get()` reads it back
// through `blink_Option_int`. Giving it a pointer carrier would deref an ordinal.
// `tag` is the POINTER carrier tag and is "" for a plain enum, so a caller that reads only the
// tag takes the scalar path by default rather than dereferencing an ordinal. `name` is the raw
// type name either way, for the var_enums registration a bare match variant needs.
pub type ListNamedElem { tag: Str, name: Str, plain_enum: Bool }

fn no_named_elem() -> ListNamedElem {
    ListNamedElem { tag: "", name: "", plain_enum: false }
}

pub fn list_named_elem_of(name: Str) -> ListNamedElem {
    if name == "" { return no_named_elem() }
    // Tid first, flat pair second. The tid is the only one of the two that can name a plain-enum
    // element at all, and it is also the one that survives an unannotated `let`.
    let mut es = ""
    let tid = get_var_ty(name)
    if tid >= 0 {
        let ect = tc_tid_list_elem_ct(tid)
        // CT_STRUCT / CT_ENUM name themselves; a tuple element answers ct < 0 (no CT names a
        // tuple) and carries its whole type in the tag.
        if ect == CT_STRUCT || ect == CT_ENUM || ect < 0 {
            es = tc_tid_list_elem_struct(tid)
        }
    }
    if es == "" { es = get_list_elem_struct(name) }
    named_elem_from_name(es)
}

// The same classification asked of the ELEMENT's own tid, for an iterable that is not a
// variable — a struct FIELD (`for c in h.cols`), a call result, an index. Those receivers have no
// ScopeVar, so list_named_elem_of has no name to look up and answers nothing; the tid is the only
// authority that reaches them.
//
// The input is the ELEMENT tid, not the container's, because the container is not always a List:
// a Set normalizes into a temp list (blink_set_to_list) whose element the flat pair erases the
// same way, and tc_tid_iter_elem answers for both. tc_tid_struct is the whole gate — it names
// only a Struct or an Enum, and named_elem_from_name declines everything else.
pub fn named_elem_of_elem_tid(elem_tid: Int) -> ListNamedElem {
    if elem_tid < 0 { return no_named_elem() }
    named_elem_from_name(tc_tid_struct(elem_tid))
}

fn named_elem_from_name(es: Str) -> ListNamedElem {
    if es == "" { return no_named_elem() }
    // A compound tag is the pre-existing carrier path's business, not this one.
    if is_compound_tag(es) != 0 { return no_named_elem() }
    if is_enum_type(es) != 0 && is_data_enum(es) == 0 {
        return ListNamedElem { tag: "", name: es, plain_enum: true }
    }
    ListNamedElem { tag: c_type_tag_for_struct(es), name: es, plain_enum: false }
}

// Re-stamp a destination list's COMPOUND element from a carrier tag alone
// (the iterator-source analogue of copy_list_compound_elem, which reads LIST
// metadata a var-iterator doesn't have). Used by `collect` after a lazy adapter
// over a List[compound] — the adapter forwarded the boxed carrier verbatim and
// stored only its tag. The tag is lossless for Option/Result of scalars, structs,
// and Maps (tp_carrier_tag spells those fully); a List/Set inner is intentionally
// flat in the tag (`Option_list`), so its own element defaults — collect-then-
// decode of a List/Set inner through an adapter is not reachable in the tested
// surface and would need the source list's metadata, not the tag.
pub fn set_list_elem_compound_from_tag(name: Str, carrier: Str) {
    if carrier.starts_with("Option_") {
        let inner_tag = carrier.slice(7, carrier.len())
        let inner_ct = type_from_name_tag(inner_tag)
        if is_compound_tag(inner_tag) != 0 {
            set_list_elem_option_tp(name, sv_tp(inner_ct, -1, -1, inner_tag))
        } else if is_struct_type(inner_tag) != 0 || is_enum_type(inner_tag) != 0 {
            set_list_elem_option(name, CT_INT, inner_tag)
        } else {
            set_list_elem_option(name, inner_ct, "")
        }
    } else if carrier.starts_with("Result_") {
        let parts = split_result_compound(canonical_struct_tag(carrier))
        if parts.second != "" {
            let ok_ct = type_from_name_tag(parts.first)
            let err_ct = type_from_name_tag(parts.second)
            let ok_struct = if is_struct_type(parts.first) != 0 || is_enum_type(parts.first) != 0 { parts.first } else { "" }
            let err_struct = if is_struct_type(parts.second) != 0 || is_enum_type(parts.second) != 0 { parts.second } else { "" }
            set_list_elem_result(name, ok_ct, ok_struct, err_ct, err_struct)
        }
    } else if is_compound_tag(carrier) == 0 && is_named_typedef_tag(carrier) != 0 {
        // A NAMED BY-VALUE carrier — a struct, a tuple's generated struct tag, or a
        // DATA enum. Those are pointer-boxed into a list slot, and (CT_VOID, tag) is the pair
        // that records it: exactly what emit_boxed_container_store writes on the push side and
        // what `.get()` and for-in read back with a deref. Nothing here is lossy, unlike the
        // Option/Result arms above — the tag IS the element's whole type. The is_compound_tag
        // guard keeps a `Map_` carrier out: is_named_typedef_tag admits it, but a Map element
        // is a pointer type whose key/value channels this pair cannot spell.
        set_list_elem_type(name, CT_VOID)
        set_list_elem_struct(name, carrier)
    }
}

// The Result twin of set_list_elem_option_tp — record
// `type_list(type_result(ok_tp, err_tp))` from pre-built ok/err inner tps so a
// nested container inside either side (`List[Result[Map[K,V], E]]`) survives.
pub fn set_list_elem_result_tp(name: Str, ok_tp: Int, err_tp: Int) {
    set_list_elem_compound_tp(name, type_list(type_result(ok_tp, err_tp)), CT_RESULT)
}

// The Map twin of set_list_elem_option_tp/set_list_elem_result_tp, for a
// List element recovered from a tid rather than an annotation
// (recover_list_elem_from_tid): records `type_list(type_map(key_tp, val_tp))` from
// pre-built key/value inner tps so a container nested in either side
// (`List[Map[Str, List[Int]]]`) keeps its own type params. set_list_elem_map_types
// above is the flat, one-level twin (fed from an annotation via
// set_list_elem_map_ann); this one is the deep twin, matching
// set_list_elem_option_tp/set_list_elem_result_tp's shape.
pub fn set_list_elem_map_tp(name: Str, key_tp: Int, val_tp: Int) {
    set_list_elem_compound_tp(name, type_list(type_map(key_tp, val_tp)), CT_MAP)
}

// What a List element's flat (CT, sname) pair is, according to typecheck's tid for the node
// that produced the list — and the scope-var writes that record it. Moved here from
// codegen_expr (where it was recover_list_elem_from_tid's body) because it is a ScopeVar
// writer over the tp pool, and both live in THIS file: codegen_expr sits downstream of
// codegen_methods, so nothing in codegen_methods could reach it there. codegen_methods needs
// it for a list that is an EXPRESSION rather than a variable.
//
// The returned pair is what the caller should mirror onto its own channel; ct == -1 means
// this declined to answer and the caller must leave the element erased. Do not fabricate a
// default from a -1: an erased element surfaces later as an honest diagnostic, a guessed one
// is a confident wrong claim (the same sentinel contract deep_tp_from_tid states below).
pub type ListElemStamp {
    ct: Int,
    sname: Str
}

fn no_list_elem_stamp() -> ListElemStamp {
    ListElemStamp { ct: -1, sname: "" }
}

// "the recorded element cannot be spelled in C". Two shapes, both of which reach cc as
// an erasure rather than as a Blink diagnostic: no element at all, or a marker whose C name lives
// in the companion struct slot (CT_STRUCT, CT_ENUM, and the List house convention's CT_VOID pair)
// with that slot empty. Anything else -- CT_INT, CT_OPTION, a named struct -- is spellable and must
// be left exactly as the flat path recorded it.
//
// NOT a general "the flat path lost the element" test, and the CT_VOID arm is why. (CT_VOID, "")
// is a REAL spelling as well as an erasure: it is how a by-value plain-enum element is recorded,
// which is what the declared path stamps for an annotated `let l: List[Col]`. This function is
// only correct where a nameless CT_VOID cannot mean that -- at the unannotated let-binding ladder
// it was measured against, whose declared-path sibling never reaches it. A caller that might see
// an annotated list must gate on "no element recorded at all" instead
// (`get_list_elem_type(name) < 0 && get_list_elem_struct(name) == ""`); re-stamping a by-value
// enum promotes it to the struct-pointer convention and the reader dereferences an integer.
//
// Where it does apply it gates stamp_list_elem_from_tid above, so the tid is consulted only where
// the flat path left nothing usable and a spellable flat answer still wins. That precedence
// reverses once the tid governs; for now it keeps each shape measurable one at a time.
pub fn list_elem_unspellable(name: Str) -> Bool {
    let ect = get_list_elem_type(name)
    if ect < 0 {
        return true
    }
    if ect == CT_STRUCT || ect == CT_ENUM || ect == CT_VOID {
        return get_list_elem_struct(name) == ""
    }
    false
}

// Build a fully-recursive tp node from a tid (typecheck's ty_pool tree), the
// tid-side twin of deep_tp_from_ann. That one walks an annotation AST and
// resolves mono typevars via cg_mono_*; this one walks a tid already
// substituted by typecheck (tc_lookup_node_tid at a concrete use site), so
// it does NOT call tc_tid_resolved at entry or in any recursive step —
// composing a resolver into a non-resolving reader is a standing trap here,
// as it is in codegen_stmt.bl's analogous walker.
//
// Sentinel contract (load-bearing): returns -1 — NOT a tp id — for any tid naming
// no faithfully representable type (an unencodable struct/enum slot, or a
// container this builder can't descend into: Set/Iterator/Handle/Channel/Ptr).
// Every caller MUST bail on -1 and leave the element erased. Fabricating a
// default here would be a confident wrong claim about the element's shape;
// an erased element is a visible unknown that surfaces as an honest
// diagnostic later.
fn deep_tp_from_tid(tid: Int) -> Int {
    let ct = tc_tid_ct(tid)
    if ct == CT_OPTION {
        let inner = deep_tp_from_tid(tc_tid_option_inner_tid(tid))
        if inner == -1 { return -1 }
        return type_option(inner)
    }
    if ct == CT_RESULT {
        let ok = deep_tp_from_tid(tc_tid_result_ok_tid(tid))
        let err = deep_tp_from_tid(tc_tid_result_err_tid(tid))
        if ok == -1 || err == -1 { return -1 }
        return type_result(ok, err)
    }
    if ct == CT_MAP {
        let key = deep_tp_from_tid(tc_tid_map_key_tid(tid))
        let val = deep_tp_from_tid(tc_tid_map_val_tid(tid))
        if key == -1 || val == -1 { return -1 }
        return type_map(key, val)
    }
    if ct == CT_LIST {
        let inner = deep_tp_from_tid(tc_tid_list_elem(tid))
        if inner == -1 { return -1 }
        return type_list(inner)
    }
    // No raw-tid accessor descends into these, so a flat sv_tp write has nothing faithful to
    // recurse into; erasing is the honest answer.
    if ct == CT_SET || ct == CT_ITERATOR || ct == CT_HANDLE || ct == CT_CHANNEL || ct == CT_PTR {
        return -1
    }
    if ct == CT_STRUCT || ct == CT_ENUM {
        let stem = tc_tid_struct_mono_name(tid)
        let name = if stem != "" { stem } else { tc_tid_struct(tid) }
        if name == "" { return -1 }
        return type_struct(name)
    }
    if ct < 0 { return -1 }
    sv_tp(ct, -1, -1, "")
}

// there is deliberately NO `list_elem_compound_inner_missing(name)` companion to
// list_elem_unspellable above, and the reason is worth more than the function would have been.
// "The element's outer kind is recorded, its inner is not" is not an observable state of this
// pool: set_list_elem_type routes through sv_tp, and sv_tp FABRICATES an unknown inner
// (`sv_tp(CT_OPTION, -1, ..)` = `type_option(type_int())`, line 1564; the Result and Map arms
// default likewise). A lost inner and a genuine `List[Option[Int]]` are the same pool state, bit
// for bit, so any predicate written over it would answer the same for both. Callers that need
// the distinction must consult the tid, which is why codegen_stmt's compound branch lets
// stamp_list_elem_from_tid lead rather than filling in behind a gate.

// The full comment for this rule, including why a struct/enum element writes (CT_VOID, sname)
// rather than a bare CT_STRUCT and why Iterator/Handle/Channel/Bytes stay erased on purpose,
// is on the codegen_expr wrapper recover_list_elem_from_tid.
pub fn stamp_list_elem_from_tid(node: Int, var_name: Str) -> ListElemStamp {
    // A generic FUNCTION body's own tid memo is written once at typecheck with
    // its tparams abstract (typecheck never re-runs per instantiation) -- inside
    // a mono instance's body, `List[Set[T]]` still reads back with T a bare
    // typevar unless it is rewritten through THIS call's binder, exactly what
    // tc_tid_subst_mono exists for. No-op outside a mono body or when node's tid
    // is already concrete.
    stamp_list_elem_from_list_tid(tc_tid_subst_mono(tc_lookup_node_tid(node), cg_mono_tparams_sl, cg_mono_arg_tids), var_name)
}

// the same stamp for a var that has no node of its own. A `for` BINDER is not an
// expression, so there is no memoized tid to look up for it — its type is the ITERABLE's element,
// which the caller already has in hand. Splitting the tid out of the lookup is what lets the binder
// reuse this instead of growing a second, weaker copy of the ladder.
pub fn stamp_list_elem_from_list_tid(etid: Int, var_name: Str) -> ListElemStamp {
    let ect = tc_tid_list_elem_ct(etid)
    let tracing = dbg_channel_on("listelem")
    if ect < 0 {
        // a TUPLE element has no CT to name it — tk_to_ct answers CT_VOID for
        // TyKind.Tuple and tid_inner_ct turns that into -1 — but it does have a generated
        // tag, and it is what the ANNOTATED path already spells here as the same
        // (CT_VOID, sname) pair the struct arm below writes. Still gated on a nameable tag,
        // so a Fn, typevar or genuinely-unknown element keeps declining: tid_inner_struct
        // answers "" for all three.
        let tuple_tag = tc_tid_list_elem_struct(etid)
        if tuple_tag == "" {
            if tracing != 0 { dbg_trace("listelem", "stamp ect={ect} var={var_name} arm=bail_unnameable") }
            return no_list_elem_stamp()
        }
        if tracing != 0 { dbg_trace("listelem", "stamp ect={ect} var={var_name} arm=tuple tag={tuple_tag}") }
        set_list_elem_type(var_name, CT_VOID)
        // Stamp the List[Tuple] tid so get_list_elem_struct names the element from
        // the tid (tc_tid_tuple_sname) instead of the flat sname2. Never overwrite an
        // existing tid; a var that already carries its own annotated List[T] keeps it.
        if get_var_ty(var_name) < 0 { set_var_ty(var_name, etid) }
        set_list_elem_struct(var_name, tuple_tag)
        return ListElemStamp { ct: CT_VOID, sname: tuple_tag }
    }
    if ect == CT_OPTION {
        let elem_tid = tc_tid_list_elem(etid)
        let inner_tp = deep_tp_from_tid(tc_tid_option_inner_tid(elem_tid))
        if inner_tp == -1 {
            if tracing != 0 { dbg_trace("listelem", "stamp ect={ect} var={var_name} arm=bail_unfaithful") }
            return no_list_elem_stamp()
        }
        if tracing != 0 { dbg_trace("listelem", "stamp ect={ect} var={var_name} arm=option inner_tp={inner_tp}") }
        set_list_elem_type(var_name, ect)
        set_list_elem_option_tp(var_name, inner_tp)
        return ListElemStamp { ct: ect, sname: "" }
    }
    if ect == CT_RESULT {
        let elem_tid = tc_tid_list_elem(etid)
        let ok_tp = deep_tp_from_tid(tc_tid_result_ok_tid(elem_tid))
        let err_tp = deep_tp_from_tid(tc_tid_result_err_tid(elem_tid))
        if ok_tp == -1 || err_tp == -1 {
            if tracing != 0 { dbg_trace("listelem", "stamp ect={ect} var={var_name} arm=bail_unfaithful") }
            return no_list_elem_stamp()
        }
        if tracing != 0 { dbg_trace("listelem", "stamp ect={ect} var={var_name} arm=result inner_tp={ok_tp}") }
        set_list_elem_type(var_name, ect)
        set_list_elem_result_tp(var_name, ok_tp, err_tp)
        return ListElemStamp { ct: ect, sname: "" }
    }
    if ect == CT_MAP {
        let elem_tid = tc_tid_list_elem(etid)
        let key_tp = deep_tp_from_tid(tc_tid_map_key_tid(elem_tid))
        let val_tp = deep_tp_from_tid(tc_tid_map_val_tid(elem_tid))
        if key_tp == -1 || val_tp == -1 {
            if tracing != 0 { dbg_trace("listelem", "stamp ect={ect} var={var_name} arm=bail_unfaithful") }
            return no_list_elem_stamp()
        }
        if tracing != 0 { dbg_trace("listelem", "stamp ect={ect} var={var_name} arm=map inner_tp={val_tp}") }
        set_list_elem_type(var_name, ect)
        set_list_elem_map_tp(var_name, key_tp, val_tp)
        return ListElemStamp { ct: ect, sname: "" }
    }
    // A Set element is always a flat hashable scalar/struct/tuple (E1400 forecloses a
    // container element), so no deep_tp_from_tid tree is needed. Gate on the element being
    // nameable so a genuinely-unresolved typevar keeps declining loudly instead of committing
    // to a partial (elem-type-known, nested-elem-unknown) answer.
    if ect == CT_SET {
        let elem_tid = tc_tid_list_elem(etid)
        let set_ct = tc_tid_set_elem_ct(elem_tid)
        let set_struct = tc_tid_set_elem_struct(elem_tid)
        if set_ct < 0 && set_struct == "" {
            if tracing != 0 { dbg_trace("listelem", "stamp ect={ect} var={var_name} arm=set_bail_unfaithful") }
            return no_list_elem_stamp()
        }
        if tracing != 0 { dbg_trace("listelem", "stamp ect={ect} var={var_name} arm=set set_ct={set_ct} set_struct={set_struct}") }
        set_list_elem_type(var_name, ect)
        if set_ct >= 0 {
            set_list_nested_elem_type(var_name, set_ct)
        }
        return ListElemStamp { ct: ect, sname: "" }
    }
    // §2: Iterator/Handle/Channel/Bytes elements have no parity target — flipping
    // the element to one of these would redirect for-in to a never-emitted iterator type,
    // trading a loud `.get()` error for a link error in a different construct. Stay erased.
    if ect == CT_ITERATOR || ect == CT_HANDLE || ect == CT_CHANNEL || ect == CT_BYTES {
        if tracing != 0 { dbg_trace("listelem", "stamp ect={ect} var={var_name} arm=no_parity_target") }
        return no_list_elem_stamp()
    }
    if ect == CT_STRUCT || ect == CT_ENUM {
        let es = tc_tid_list_elem_struct(etid)
        if es == "" { return no_list_elem_stamp() }
        // A PLAIN (payload-less) enum element is not stored the way the (CT_VOID, name)
        // pair implies. The variant expression evaluates as CT_INT with no struct name, so the
        // push side value-boxes the ordinal — `(void*)(intptr_t)blink_Col_Red` — exactly like an
        // Int. Naming it here would make every read deref that ordinal as a pointer
        // (`blink_Option_Col` and `*_ounw.value`). CT_INT with no name is the faithful stamp, and
        // it is what the annotated path already produces; `match`/`==` on the bound value both
        // work through it, because a plain enum IS its ordinal.
        if is_enum_type(es) != 0 && is_data_enum(es) == 0 {
            if tracing != 0 { dbg_trace("listelem", "stamp ect={ect} var={var_name} arm=plain_enum es={es}") }
            set_list_elem_type(var_name, CT_INT)
            return ListElemStamp { ct: CT_INT, sname: "" }
        }
        if tracing != 0 { dbg_trace("listelem", "stamp ect={ect} var={var_name} arm=named_byvalue es={es}") }
        set_list_elem_type(var_name, CT_VOID)
        // Stamp the List tid too so get_list_elem_struct names this struct/data-enum
        // element from the tid (its mono stem for a generic instance, its head for a
        // plain one) instead of the flat sname2 — mirroring the tuple arm above. Never
        // overwrite an existing tid.
        if get_var_ty(var_name) < 0 { set_var_ty(var_name, etid) }
        set_list_elem_struct(var_name, es)
        return ListElemStamp { ct: CT_VOID, sname: es }
    }
    if tracing != 0 { dbg_trace("listelem", "stamp ect={ect} var={var_name} arm=tail") }
    set_list_elem_type(var_name, ect)
    if ect != CT_LIST { return ListElemStamp { ct: ect, sname: "" } }
    let inner_tid = tc_tid_list_elem(etid)
    let nect = tc_tid_list_elem_ct(inner_tid)
    // Carries only the KIND at 2 levels deep, not the inner container's own element at 3
    // levels deep, so a for-in 2 levels down still needs its own recovery.
    if nect < 0 || nect == CT_OPTION || nect == CT_RESULT || nect == CT_MAP || nect == CT_ITERATOR || nect == CT_HANDLE || nect == CT_CHANNEL || nect == CT_BYTES || nect == CT_LIST {
        return ListElemStamp { ct: ect, sname: "" }
    }
    if nect == CT_STRUCT || nect == CT_ENUM {
        let nes = tc_tid_list_elem_struct(inner_tid)
        if nes != "" {
            set_list_nested_elem_type(var_name, CT_VOID)
        }
        return ListElemStamp { ct: ect, sname: "" }
    }
    set_list_nested_elem_type(var_name, nect)
    ListElemStamp { ct: ect, sname: "" }
}

// stamp a Map var's key and value from `node`'s tid. The Map twin of
// stamp_list_elem_from_tid, and it exists for the same reason that one does: the
// state it repairs is not observable in this pool. A map ScopeVar spells its value
// across exactly three flat channels — tp_child2_kind (the value's CT), sname2 (a
// struct value's name) and extra (a LIST value's element ct) — and set_var(name,
// CT_MAP) builds the tp through sv_tp, whose CT_MAP arm answers
// `type_map(type_string(), type_int())` for an unknown pair (line 1573). So a Map
// whose value was never recorded and a genuine `Map[Str, Int]` read back
// identically, and no predicate over the flat fields can tell a caller which one it
// holds. The tid can, so the tid leads — the same argument as the missing
// list_elem_compound_inner_missing companion note above.
//
// DECLINES rather than half-answers, on the same contract as its list sibling:
//   - not a Map tid at all, or either side unfaithful under deep_tp_from_tid's -1
//     sentinel (an unsubstituted typevar in a generic body reads that way);
//   - a value kind the three channels cannot hold — an Option, Map or Result value. That is
//     a missing CHANNEL, not a missing authority: writing the value's CT with nowhere to put
//     its inner trades a value floored to Int for a value claimed to be an Option of Int,
//     which is a different wrong answer and a louder one.
// Answers whether it stamped, so a caller can keep its own fallback for the decline.
pub fn stamp_map_from_tid(node: Int, var_name: Str) -> Bool {
    stamp_map_from_map_tid(tc_tid_subst_mono(tc_lookup_node_tid(node), cg_mono_tparams_sl, cg_mono_arg_tids), var_name)
}

// the tid-taking core, for a var with no node of its own — see
// stamp_list_elem_from_list_tid for why a `for` binder needs one.
pub fn stamp_map_from_map_tid(mtid: Int, var_name: Str) -> Bool {
    if tc_tid_ct(mtid) != CT_MAP { return false }
    let key_tp = deep_tp_from_tid(tc_tid_map_key_tid(mtid))
    let val_tp = deep_tp_from_tid(tc_tid_map_val_tid(mtid))
    if key_tp == -1 || val_tp == -1 { return false }
    let key_ct = tp_get_kind(key_tp)
    let val_ct = tp_get_kind(val_tp)
    let val_sname = tc_tid_map_val_struct(mtid)
    let val_holdable = is_map_scalar_ct(val_ct) != 0 || val_sname != "" || val_ct == CT_LIST
    if !val_holdable { return false }
    // This recovery path has the authoritative map tid; stamp it so the var is tid-carrying,
    // the way the binder funnel already stamps map binder vars. The flat writes below are then
    // a redundant backstop the tid-lead readers no longer need to reach.
    set_var_ty(var_name, mtid)
    let tracing = dbg_channel_on("listelem")
    if tracing != 0 { dbg_trace("listelem", "stampmap var={var_name} key_ct={key_ct} val_ct={val_ct} val_sname={val_sname}") }
    // A struct/enum value goes in as (CT_VOID, name): set_map_types routes exactly
    // that pair to set_map_value_struct, and CT_VOID is the by-pointer convention
    // the value carrier already uses for a named type.
    let decl_val_ct = if val_sname != "" { CT_VOID } else { val_ct }
    // Clear BEFORE writing, and clear even though this stamp is about to write the same
    // three channels itself: two of them are only written CONDITIONALLY below (a struct
    // name, a list element), so an unconditional write is not enough to displace an
    // earlier guess. `Option[Map[Str, Str]].unwrap()` is the measured case — the branch
    // above it reads the option's inner2 slot, gets a stray 0, and files it as "the value
    // is a List of Int". Nothing here writes `extra` for a Str value, so without the
    // clear, get_map_value_type_raw keeps answering CT_LIST off the stale field and this
    // stamp's correct answer is never reached. See clear_map_value_meta for the ordering.
    clear_map_value_meta(var_name)
    set_map_types(var_name, key_ct, decl_val_ct, val_sname)
    let key_sname = tc_tid_map_key_struct(mtid)
    if key_sname != "" { set_map_key_struct(var_name, key_sname) }
    if val_ct == CT_LIST && val_sname == "" {
        let ve = tp_child1_kind(val_tp)
        if ve >= 0 { set_map_value_list_elem(var_name, ve) }
    }
    true
}

// Register a tuple-pattern binder from the element's own tid, one arm per kind. Both binder sites
// (bind_pattern_vars' IdentPattern arm and emit_tuple_destructure) call this ahead of their flat
// ladders, in both branches, because TWO different erasures live between a tuple element and its
// binder:
//
//   - a COMPOUND-TAG element loses its CT outright. emit_tuple_typedef registers any tagged tuple
//     field as `(CT_VOID, <tag>)` and both binder sites decode only `Option_`/`Result_` out of it,
//     so a Map element is filed as "a struct called Map_str_int" and lookup_impl_method misses.
//     The emitted C is right; only the ScopeVar registration is wrong.
//   - a CONTAINER element keeps its outer CT and loses its ELEMENT, so reads decode against
//     sv_tp's fabrication — a silent wrong answer, right only when the fabrication happens to
//     match.
//
// Reads the TID rather than growing the tag chain, because a tag cannot carry what either erasure
// needs: `Map[Str, Map[Int, Bool]]` tags as `Map_str_map`, `List[Map[Str, Int]]` as plain `list`.
//
// The CT_MAP arm differs from stamp_map_from_tid on one point, deliberately: an unholdable VALUE
// does not abandon the KEY. stamp_map_from_tid answers "are both channels mine?" for a caller that
// keeps its own value recoveries; a binder has none, so a wholesale decline would leave
// `let (m, n) = t` erroring on `m.len()` where the same map bound by a `let` annotation works.
pub fn stamp_binder_from_tid(node: Int, var_name: Str, is_mut: Int) -> Bool ! Codegen.Scope {
    stamp_binder_from_binder_tid(tc_tid_subst_mono(tc_lookup_node_tid(node), cg_mono_tparams_sl, cg_mono_arg_tids), var_name, is_mut)
}

// the tid-taking core. A `for` binder over a list of CONTAINERS reaches here with the
// iterable's ELEMENT tid, because the binder has no node whose tid could be looked up. The three
// kinds it covers fail three different ways without it — a Map value silently fabricated to Int, a
// List element silently erased, a Set element loud as SetElementTypeUnknownAtCodegen — all from the
// same cause: the flat channels are copied off the iterable's ScopeVar, and a call, a method result
// or a struct field has none.
pub fn stamp_binder_from_binder_tid(mtid: Int, var_name: Str, is_mut: Int) -> Bool ! Codegen.Scope {
    let ct = tc_tid_ct(mtid)
    if dbg_channel_on("binder") != 0 { dbg_trace("binder", "stamp var={var_name} tid={mtid} ct={ct} mut={is_mut}") }
    if ct == CT_MAP {
        set_var(var_name, CT_MAP, is_mut)
        // Guarantee the tid: this binder has no node to look up, so mtid is the
        // only carrier of the map's shape. The flat channels below cannot hold an
        // unholdable value (key-only fallback), but the tid can — stamp it so the
        // tid-first accessor branches answer from the authoritative shape.
        set_var_ty(var_name, mtid)
        if stamp_map_from_map_tid(mtid, var_name) { return true }
        // The value is a kind the three channels cannot hold. Stamp the key on its own: the key
        // is what selects the kops vtable, and leaving it unset is not a floor but a
        // BLINK_COMPILER_BUG_kops_unsupported at the first insert.
        let key_tp = deep_tp_from_tid(tc_tid_map_key_tid(mtid))
        if key_tp != -1 {
            set_map_types(var_name, tp_get_kind(key_tp), get_map_value_type_raw(var_name), get_map_value_struct(var_name))
            let key_sname = tc_tid_map_key_struct(mtid)
            if key_sname != "" { set_map_key_struct(var_name, key_sname) }
        }
        return true
    }
    if ct == CT_LIST {
        // set_var first: it rebuilds the var's tp through sv_tp, so a stamp written before it
        // would be discarded. stamp_list_elem_from_tid then declines on its own terms for an
        // element it cannot spell faithfully, leaving the element erased rather than fabricated.
        set_var(var_name, CT_LIST, is_mut)
        set_var_ty(var_name, mtid)
        stamp_list_elem_from_list_tid(mtid, var_name)
        return true
    }
    // A `for st in <List[Set[T]]>` binder arrives with the CT and nothing else, and reading through
    // it hits the loud SetElementTypeUnknownAtCodegen. E1400 forecloses a container element, so no
    // deep tree is needed and these two flat channels are the faithful answer.
    if ct == CT_SET {
        set_var(var_name, CT_SET, is_mut)
        set_var_ty(var_name, mtid)
        let set_ct = tc_tid_set_elem_ct(mtid)
        let set_struct = tc_tid_set_elem_struct(mtid)
        if set_ct < 0 && set_struct == "" { return false }
        if set_ct >= 0 { set_set_elem_type(var_name, set_ct) }
        if set_struct != "" { set_set_elem_struct(var_name, set_struct) }
        return true
    }
    // NO arm for the remaining kinds: a StringBuilder / Bytes / Channel binder reaches here through
    // the scalar branch already carrying the CT the tid names, so an arm for them would be dead
    // weight. No measured shape, no arm.
    false
}

// Register a WHOLE-value binder — an `as` pattern's name, which binds the scrutinee undecomposed.
//
// Every other binder holds a DECOMPOSED value, and its carrier and struct cases are served by the
// enclosing arm's struct-name slot, which the decomposition filled. A whole-value binder's slot is
// empty because nothing decomposed anything to fill it, so the three kinds a bare CT cannot name —
// a carrier, which is only nameable WITH its inner, and a struct, which needs its name — have
// nothing to fall back on and must come from the tid.
//
// Containers first, through the shared writer form: that is the same answer for a whole binder as
// for a decomposed one.
pub fn stamp_whole_binder_from_tid(mtid: Int, var_name: Str, is_mut: Int) -> Bool ! Codegen.Scope {
    if stamp_binder_from_binder_tid(mtid, var_name, is_mut) { return true }
    let ct = tc_tid_ct(mtid)
    if ct == CT_OPTION {
        set_var(var_name, CT_OPTION, is_mut)
        set_var_ty(var_name, mtid)
        set_var_option_struct(var_name, tc_tid_option_inner_ct(mtid), tc_tid_option_inner_struct(mtid))
        // A compound inner needs the tp too: the two flat slots above hold a CT and a name, so
        // `Option[Map[Str, Int]]` would keep the carrier and lose the pair.
        let inner_tp = deep_tp_from_tid(tc_tid_option_inner_tid(mtid))
        if inner_tp != -1 { set_var_option_inner_tp(var_name, inner_tp) }
        return true
    }
    if ct == CT_RESULT {
        set_var(var_name, CT_RESULT, is_mut)
        set_var_ty(var_name, mtid)
        set_var_result_struct(var_name, tc_tid_result_ok_ct(mtid), tc_tid_result_err_ct(mtid), tc_tid_result_ok_struct(mtid), tc_tid_result_err_struct(mtid))
        return true
    }
    let sname = tc_tid_struct(mtid)
    if sname != "" {
        set_var(var_name, CT_VOID, is_mut)
        // The tid is the authoritative name channel: sv_struct_tid_first spells this binder's
        // struct/enum name from it, so a whole-binder needs no flat sname write.
        set_var_ty(var_name, mtid)
        // A data enum reaches here only when the scrutinee's enum name was not already in hand;
        // the binder still needs its variant registration to match on.
        if is_data_enum(sname) != 0 {
            var_enums.push(VarEnumEntry { name: var_name, enum_type: sname })
        }
        return true
    }
    // A tuple binds undecomposed too, but tc_tid_struct declines tuples, so it needs its own arm.
    // The carrier name comes from the dedicated tuple speller and must already be registered — the
    // caller reconstructs the value (which registers the typedef via ensure_tuple_type) before
    // stamping — so gate on find_tuple_entry, the same gate sv_struct_tid_first uses to decide it
    // may spell the field from the tid; an unregistered name cedes to the flat channel. Like the
    // struct arm, the tid is the authoritative name channel, so no flat sname write.
    let tup = tc_tid_tuple_sname(mtid)
    if tup != "" && find_tuple_entry(tup) >= 0 {
        set_var(var_name, CT_VOID, is_mut)
        set_var_ty(var_name, mtid)
        return true
    }
    false
}

// fill a container binder's element channels from its tid, but ONLY where the flat
// side has no answer of its own.
//
// stamp_binder_from_binder_tid above is the WRITER form: it calls set_var, which rebuilds the
// var's tp from scratch, so it has to run before whatever flat copies follow it. A match-arm
// binder cannot be served that way — `bind_pattern_vars` emits its declaration inside one of ~28
// arms, each doing its own element copy afterwards, and the single place that sees every binder
// runs LAST, where writing would overrule arms that were already right.
//
// So this form asks first. An unset element channel reads -1 / "" (get_map_*_type_raw exists for
// exactly this reason), which is the only honest signal available: a SET channel holding the
// erased default is indistinguishable from a genuine `Map[Str, Int]`, so "already set" has to
// mean "leave it alone". The tid fills holes; it does not arbitrate.
//
// The head CT must agree before anything is written. A binder whose flat head says List while the
// tid says Set is a different defect — a contaminated head, not a missing element — and stamping
// an element through the disagreement would write the Set's element onto a List var's channel,
// which is a new silent-wrong rather than a fix.
pub fn stamp_binder_elems_from_tid_if_unset(mtid: Int, var_name: Str) -> Bool {
    let ct = tc_tid_ct(mtid)
    if ct != get_var_type(var_name) { return false }
    if ct == CT_SET {
        if get_set_elem_type(var_name) >= 0 { return false }
        if get_set_elem_struct(var_name) != "" { return false }
        let e_ct = tc_tid_set_elem_ct(mtid)
        let e_sn = tc_tid_set_elem_struct(mtid)
        if e_ct < 0 && e_sn == "" { return false }
        if e_ct >= 0 { set_set_elem_type(var_name, e_ct) }
        if e_sn != "" { set_set_elem_struct(var_name, e_sn) }
        return true
    }
    if ct == CT_LIST {
        if get_list_elem_type_raw(var_name) >= 0 { return false }
        if get_list_elem_struct(var_name) != "" { return false }
        let st = stamp_list_elem_from_list_tid(mtid, var_name)
        return st.ct >= 0 || st.sname != ""
    }
    if ct == CT_MAP {
        if get_map_key_type_raw(var_name) >= 0 { return false }
        if get_map_value_type_raw(var_name) >= 0 { return false }
        if get_map_value_struct(var_name) != "" { return false }
        return stamp_map_from_map_tid(mtid, var_name)
    }
    // A closure binder's "element" is its SIGNATURE — the C function-pointer cast the call site
    // needs — and it goes missing for the same reason the container elements above do: no arm of
    // bind_pattern_vars has a `fn(..) -> ..` annotation to read for `Some(h)`. An empty sig is
    // indistinguishable from "not a closure", so the call reports UndefinedFunction against a
    // variable the type checker had fully typed. Keyed on the CT and ordered last, so it catches
    // only what the flat answer left unset.
    if ct == CT_CLOSURE {
        if get_var_closure_sig(var_name) != "" { return false }
        let sig = closure_sig_from_tid(mtid)
        if sig == "" { return false }
        set_var_closure(var_name, sig, mtid)
        return true
    }
    false
}

pub fn stamp_binder_elems_from_node_if_unset(node: Int, var_name: Str) -> Bool {
    stamp_binder_elems_from_tid_if_unset(tc_tid_subst_mono(tc_lookup_node_tid(node), cg_mono_tparams_sl, cg_mono_arg_tids), var_name)
}

// the carrier a `Map[K, V].get(k)` must return when V is a kind the Map's three
// flat value channels cannot hold — an Option, a Result, a Set, or a nested Map.
//
// This deliberately does NOT add a fourth flat channel, and the reason is the same one written
// out on stamp_map_from_tid: the value's kind and the value's inner would have to be stored on
// the MAP var, where `sv_tp(CT_MAP, ..)` fabricates `Map[Str, Int]` for an unknown pair, so a
// stored-and-lost value cannot be told from a genuine one. The value type does not need to live
// on the Map at all — it only has to reach the Option that `.get` returns, and the tid at the
// call site holds it whole. So this reads the tid and hands the emitter a carrier, and the
// existing `.unwrap()` arms (which already decode `Option_<inner>` / `Result_<ok>_<err>` /
// `Map_<k>_<v>` carrier tags for LIST elements) consume it unchanged.
//
// DECLINES with ct = -1 rather than half-answering, on deep_tp_from_tid's -1 contract: an
// unsubstituted typevar in a generic body, an unnameable struct, or a value whose own inner is a
// Set/Iterator/Handle/Channel/Ptr reads that way. The flat ladder then keeps its answer, which
// is what a decline has to mean — a fabricated carrier tag names a C typedef that the write side
// never boxed into, and cc reports that as an unknown type in generated code with no Blink span.
pub type MapValCarrier {
    ct: Int,
    tag: Str,
    inner_tp: Int,
    inner_ct: Int,
    inner_sname: Str
}

pub fn no_map_val_carrier() -> MapValCarrier {
    MapValCarrier { ct: -1, tag: "", inner_tp: -1, inner_ct: -1, inner_sname: "" }
}

pub fn map_val_carrier_from_tid(get_node: Int, obj_node: Int) -> MapValCarrier {
    // The RECEIVER's tid leads, because a Map tid names its value definitionally — `.get`'s own
    // tid says `Option[V]`, and reading V back out of it means assuming the memo is the call's
    // result and not the value itself, which would silently strip one Option from an
    // Option-valued Map. The call node is the fallback for a receiver with no memo (a synthesized
    // or rewritten node reads -1). Both go through the mono binder for the same reason
    // stamp_list_elem_from_tid does: a generic body's tid memo is written once, with its tparams
    // still abstract.
    let otid = tc_tid_subst_mono(tc_lookup_node_tid(obj_node), cg_mono_tparams_sl, cg_mono_arg_tids)
    let mut vtid = -1
    if tc_tid_ct(otid) == CT_MAP {
        vtid = tc_tid_map_val_tid(otid)
    }
    if vtid < 0 {
        let gtid = tc_tid_subst_mono(tc_lookup_node_tid(get_node), cg_mono_tparams_sl, cg_mono_arg_tids)
        if tc_tid_ct(gtid) != CT_OPTION { return no_map_val_carrier() }
        vtid = tc_tid_option_inner_tid(gtid)
    }
    map_val_carrier_from_vtid(vtid)
}

// map ITERATION materializes the (K, V) pair tuple straight from the receiver — there
// is no `.get` call node to fall back to — so it needs the receiver-only entry point. Same
// decline contract; a receiver whose tid is not a Map answers "no carrier" and the flat channels
// keep their spelling.
pub fn map_val_carrier_from_recv(obj_node: Int) -> MapValCarrier {
    let otid = tc_tid_subst_mono(tc_lookup_node_tid(obj_node), cg_mono_tparams_sl, cg_mono_arg_tids)
    if tc_tid_ct(otid) != CT_MAP { return no_map_val_carrier() }
    map_val_carrier_from_vtid(tc_tid_map_val_tid(otid))
}

pub fn map_val_carrier_from_vtid(vtid: Int) -> MapValCarrier {
    // Resolve before the non-resolving tc_tid_ct/tc_tid_*_tid reads: a push-built Map whose
    // value is a carrier holds it as a bound metavar (kind Unknown, inner1 -> solution), so the
    // raw value tid answers CT_VOID and declines the carrier, erasing Map[K,Option[V]] /
    // Map[K,Result[..]] on get().unwrap(). Thread the resolved tid through every child read.
    let rt = tc_tid_resolved(vtid)
    let vct = tc_tid_ct(rt)
    if vct == CT_OPTION {
        // Resolve the child too: a Result carrier's ok/err (and, symmetrically, an Option's inner)
        // is bound across separate insert sites, so a push-built value's child tid is itself a
        // bound metavar. deep_tp_from_tid does not resolve, so a raw metavar reads -1 and declines
        // the whole carrier, erasing it back to the ladder's `blink_Option_result`.
        let inner_tp = deep_tp_from_tid(tc_tid_resolved(tc_tid_option_inner_tid(rt)))
        if inner_tp == -1 { return no_map_val_carrier() }
        return MapValCarrier { ct: CT_OPTION, tag: "Option_{tp_carrier_tag(inner_tp)}", inner_tp: inner_tp, inner_ct: tc_tid_option_inner_ct(rt), inner_sname: tc_tid_option_inner_struct(rt) }
    }
    if vct == CT_RESULT {
        let ok_tp = deep_tp_from_tid(tc_tid_resolved(tc_tid_result_ok_tid(rt)))
        let err_tp = deep_tp_from_tid(tc_tid_resolved(tc_tid_result_err_tid(rt)))
        if ok_tp == -1 || err_tp == -1 { return no_map_val_carrier() }
        return MapValCarrier { ct: CT_RESULT, tag: "Result_{tp_carrier_tag(ok_tp)}_{tp_carrier_tag(err_tp)}", inner_tp: -1, inner_ct: -1, inner_sname: "" }
    }
    if vct == CT_MAP {
        // A Map-valued Map rides the erased carrier: one blink_map* backs every K/V, so
        // the tag drops K/V (`map`, matching tp_carrier_tag). K/V come from the tid.
        return MapValCarrier { ct: CT_MAP, tag: "map", inner_tp: -1, inner_ct: -1, inner_sname: "" }
    }
    // A Set value has no deep_tp_from_tid tree (that builder answers -1 for Set on purpose) and
    // needs none: E1400 forecloses a container element, so the element is a flat scalar/struct
    // and the Set rides the ordinary `blink_Option_set` carrier with its element on the option's
    // inner2 channels — the same shape emit_list_method's CT_SET element arm uses.
    if vct == CT_SET {
        let ect = tc_tid_set_elem_ct(rt)
        let es = tc_tid_set_elem_struct(rt)
        if ect < 0 && es == "" { return no_map_val_carrier() }
        return MapValCarrier { ct: CT_SET, tag: "", inner_tp: -1, inner_ct: ect, inner_sname: es }
    }
    // A List value: the tid names the element definitionally, so `.get` dispatches on CT_LIST
    // straight from the tid instead of the flat get_map_value_type — which floors an unholdable
    // deep element (Map[Str, List[Point]]) to a scalar. The element ct/struct ride the option's
    // inner2 channels, same as Set; the mono struct-name twin declines to "" on a genuinely erased
    // element and cedes to the flat sname channel there.
    if vct == CT_LIST {
        let ect = tc_tid_list_elem_ct(rt)
        // Prefer the mono STEM (a generic-instance element `Box[Int]` is `Box_0Int`, not the bare
        // `Box`), but a plain non-generic struct (params_count 0) has no stem, so the mono twin
        // declines to "" there — fall back to the bare head, which IS its C symbol.
        let mut es = tc_tid_list_elem_struct_mono(rt)
        if es == "" { es = tc_tid_list_elem_struct(rt) }
        if ect < 0 && es == "" { return no_map_val_carrier() }
        return MapValCarrier { ct: CT_LIST, tag: "", inner_tp: -1, inner_ct: ect, inner_sname: es }
    }
    no_map_val_carrier()
}

// The leaf-scalar value CT of a Map, read off the tid — the scalar twin of
// map_val_carrier_from_tid, which covers only the container value kinds. The flat
// get_map_value_type channel floors a mono struct-field Map's value to the erased
// sv_tp default (CT_INT); the tid is authoritative, keeping producer and the tid-led
// consumer on the same carrier. Declines (ct = -1) for a container value (those ride
// map_val_carrier_from_tid), an abstract tid, or a non-Map/Option receiver, so the
// flat ladder keeps its answer.
pub type MapValScalar {
    ct: Int,
    sname: Str
}

pub fn map_val_scalar_from_tid(get_node: Int, obj_node: Int) -> MapValScalar {
    let otid = tc_tid_subst_mono(tc_lookup_node_tid(obj_node), cg_mono_tparams_sl, cg_mono_arg_tids)
    if tc_tid_ct(otid) == CT_MAP {
        return map_val_scalar_of_ct(tc_tid_map_val_ct_resolved(otid))
    }
    // A chained receiver (foo().get(k)) has no Map tid to read; fall back to the
    // `.get` call's own Option[V] result tid, mirroring map_val_carrier_from_tid.
    let gtid = tc_tid_subst_mono(tc_lookup_node_tid(get_node), cg_mono_tparams_sl, cg_mono_arg_tids)
    if tc_tid_ct(gtid) == CT_OPTION {
        return map_val_scalar_of_ct(tc_tid_option_inner_ct(gtid))
    }
    MapValScalar { ct: -1, sname: "" }
}

// A leaf scalar carries as a single blink_Option_<tag>: any CT that is not a
// struct/enum (those are name-carried through the flat sname channel — the tid's
// plain resolved name is the bare head `Box`, not the mono stem `Box_0Int`) and not
// a container (List/Set/Option/Result/Map, which ride the carrier ladders).
pub fn is_leaf_scalar_ct(ct: Int) -> Int {
    if ct < 0 || ct == CT_STRUCT || ct == CT_ENUM || ct == CT_LIST || ct == CT_SET || is_compound_ct(ct) != 0 {
        return 0
    }
    1
}

// A pure scalar value CT leads (sname always ""); a struct/enum or container value
// declines so the flat channel keeps its answer.
fn map_val_scalar_of_ct(ct: Int) -> MapValScalar {
    if is_leaf_scalar_ct(ct) == 0 {
        return MapValScalar { ct: -1, sname: "" }
    }
    MapValScalar { ct: ct, sname: "" }
}

// both halves of a Map's (K, V) pair, read off the RECEIVER's tid, for map
// iteration's pair-tuple materialization (emit_for_in). Two distinct holes need it, and they
// need it for opposite reasons:
//
//   1. A call/expression receiver (`for pair in mkm()`) has no ScopeVar to key the flat
//      channels on, so get_map_key_type / get_map_value_type have nothing to answer from. They
//      once fabricated (CT_STRING / CT_INT) here and now decline (-1) instead. The pair for a
//      `Map[Str, List[Int]]` was therefore built as `Tuple2_str_int`, and `pair.1.get(0)` hit
//      codegen's UnresolvedMethod backstop — whose message prints the TID-derived type name, so
//      it read `'.get' on type List[Int]`, naming the type it was not using.
//   2. The value's ELEMENT (`Map[K, List[E]]`), on EVERY receiver including a plain Ident. The
//      flat pool has no channel for it: `extra` holds one integer, so it can spell the
//      element's ct and never its struct name. `for (k, v) in m` over a `Map[Str, List[Pt]]`
//      read `<value>` and over `Map[Str, List[Str]]` read a raw pointer as an int.
//
// So the two answers are gated differently at the call site: the key/value HEADS only stand in
// where the flat channels have no answer at all (raw < 0 — the one honest signal the flat pool
// has), while the element is taken whenever the tid names it, because nothing else can.
pub type MapPairTid {
    ok: Int,
    key_ct: Int,
    key_struct: Str,
    val_ct: Int,
    val_struct: Str,
    val_elem_ct: Int,
    val_elem_struct: Str
}

pub fn no_map_pair_tid() -> MapPairTid {
    MapPairTid { ok: 0, key_ct: -1, key_struct: "", val_ct: -1, val_struct: "", val_elem_ct: -1, val_elem_struct: "" }
}

pub fn map_pair_from_recv(obj_node: Int) -> MapPairTid {
    // Same mono binder and same decline-whole contract as map_val_carrier_from_recv above: a
    // receiver whose tid is not a Map, or a Map that cannot name a half, answers ok=0 and leaves
    // the flat spelling in charge rather than half-overriding it.
    let raw_tid = tc_lookup_node_tid(obj_node)
    let otid = tc_tid_subst_mono(raw_tid, cg_mono_tparams_sl, cg_mono_arg_tids)
    if tc_tid_ct(otid) != CT_MAP {
        dbg_trace("mappair", "recv bail=not_map raw_tid={raw_tid} otid={otid} ct={tc_tid_ct(otid)}")
        return no_map_pair_tid()
    }
    let kct = tc_tid_map_key_ct_resolved(otid)
    let ks = tc_tid_map_key_struct_resolved(otid)
    let vct = tc_tid_map_val_ct_resolved(otid)
    let vs = tc_tid_map_val_struct_resolved(otid)
    if kct < 0 && ks == "" {
        dbg_trace("mappair", "recv bail=unnameable_key otid={otid}")
        return no_map_pair_tid()
    }
    if vct < 0 && vs == "" {
        dbg_trace("mappair", "recv bail=unnameable_val otid={otid} kct={kct}")
        return no_map_pair_tid()
    }
    let vtid = tc_tid_resolved(tc_tid_map_val_tid(otid))
    let mut ect = -1
    let mut es = ""
    if vct == CT_LIST {
        ect = tc_tid_list_elem_ct(vtid)
        es = tc_tid_list_elem_struct(vtid)
    } else if vct == CT_SET {
        ect = tc_tid_set_elem_ct(vtid)
        es = tc_tid_set_elem_struct(vtid)
    }
    dbg_trace("mappair", "recv ok kct={kct} ks={ks} vct={vct} vs={vs} ect={ect} es={es}")
    MapPairTid { ok: 1, key_ct: kct, key_struct: ks, val_ct: vct, val_struct: vs, val_elem_ct: ect, val_elem_struct: es }
}

// The Result twin of set_list_elem_option — record
// `type_list(type_result(ok, err))` so List[Result[T,E]].get()/for-in carry both
// concrete inners. ok_struct/err_struct name a struct/enum inner ("" for scalars).
pub fn set_list_elem_result(name: Str, ok_ct: Int, ok_struct: Str, err_ct: Int, err_struct: Str) {
    set_list_elem_result_tp(name, sv_tp(ok_ct, -1, -1, ok_struct), sv_tp(err_ct, -1, -1, err_struct))
}

// The element Option's inner CT (List[Option[Int]] → CT_INT). -1 when the list is
// not List[Option[..]] or the inner is absent. Walks tp_id: list node → child1
// (option node) → child1 (inner).
pub fn get_list_elem_option_inner(name: Str) -> Int {
    let lt = get_sv_ty(name, CT_LIST)
    if lt >= 0 {
        let et = tc_tid_list_elem(cg_bind_mono_tid(lt))
        if tc_tid_ct(et) == CT_OPTION {
            let c = tc_tid_option_inner_ct(et)
            // Leaf-scalar inner only; a struct/enum/container inner returns -1 here on
            // purpose and callers recover it from the inner tp channel
            // (get_list_elem_option_inner_tp) or the struct-name channel
            // (get_list_elem_option_inner_struct). By the identical CT_OPTION gate,
            // that tp channel is >= 0 in exactly the cases the flat pool answered.
            if c >= 0 && is_leaf_scalar_ct(c) != 0 { return c }
        }
    }
    -1
}

// The element Option's inner SCALAR CT of a List RECEIVER, read off the node tid
// (List[Option[Str]] → CT_STRING). The flat get_list_elem_option_inner reads the
// tp_pool's child-of-child, which a mono/field-bound List erases to the CT_INT
// default; the tid is authoritative. Keying on the receiver NODE (not a name)
// answers for field accesses (`h.xs`) and chained receivers, which no scope_vars
// name-scan can reach. Declines (-1) for a non-Option element or a non-leaf inner
// (struct/enum name-carried, container owned by the oi_tp path), so the flat
// channel keeps its answer there.
pub fn list_elem_option_inner_scalar_ct_from_tid(obj_node: Int) -> Int {
    let ltid = tc_tid_subst_mono(tc_lookup_node_tid(obj_node), cg_mono_tparams_sl, cg_mono_arg_tids)
    if tc_tid_ct(ltid) != CT_LIST {
        return -1
    }
    let et = tc_tid_list_elem(ltid)
    if tc_tid_ct(et) != CT_OPTION {
        return -1
    }
    let c = tc_tid_option_inner_ct(et)
    if is_leaf_scalar_ct(c) != 0 {
        return c
    }
    -1
}

// The element Option's full carrier TAG spelled from the tid
// (`List[Option[Map[Str,Int]]]` → `Option_map`), or "" when the obj tid is not a
// List[Option[..]] or the tag declines. The tid twin of the flat oi_tp/oi_struct
// chain: it recovers a CONTAINER inner (Map/List) the tp_id pool erased two
// carriers deep, so `.get()` spells `blink_Option_Option_map` — the type the
// consumer's `.unwrap()` already reads off the node tid — instead of the defaulted
// `_int`.
pub fn list_elem_option_carrier_tag_from_tid(obj_node: Int) -> Str {
    let ltid = tc_tid_subst_mono(tc_lookup_node_tid(obj_node), cg_mono_tparams_sl, cg_mono_arg_tids)
    if tc_tid_ct(ltid) != CT_LIST { return "" }
    let et = tc_tid_list_elem(ltid)
    if tc_tid_ct(et) != CT_OPTION { return "" }
    let tag = tc_tid_inner_tag(et)
    // Same decline contract as c_type_from_tid (the authoritative carrier speller):
    // "" → an ICE sentinel → an unsubstituted typevar `<tv>`. Declining keeps a
    // sentinel out of the emitted C carrier name.
    if tag == "" || diag_is_ice_seg(tag) || tag.contains("<") { return "" }
    tag
}

// The element Result's full carrier TAG spelled from the tid
// (`List[Result[Map[Str,Int],Str]]` → `Result_map_str`), or "" when the obj tid
// is not a List[Result[..]] or the tag declines. The Result twin of
// list_elem_option_carrier_tag_from_tid: the flat rok_/rerr_ channels erase each
// side independently (a container Ok defaults to the bare "int"), but the node tid
// spells both sides at once — the carrier the `.unwrap()` consumer reads back —
// so `.get()` stops emitting the erased `Result_int_str`.
pub fn list_elem_result_carrier_tag_from_tid(obj_node: Int) -> Str {
    let ltid = tc_tid_subst_mono(tc_lookup_node_tid(obj_node), cg_mono_tparams_sl, cg_mono_arg_tids)
    if tc_tid_ct(ltid) != CT_LIST { return "" }
    let et = tc_tid_list_elem(ltid)
    if tc_tid_ct(et) != CT_RESULT { return "" }
    let tag = tc_tid_inner_tag(et)
    if tag == "" || diag_is_ice_seg(tag) || tag.contains("<") { return "" }
    tag
}

// The element Option's INNER tp NODE (List[Option[Map[Int,Str]]] → the
// `Map[Int,Str]` tp), or -1. Unlike get_list_elem_option_inner (which flattens to
// a single CT), this returns the whole subtree so a nested container inner keeps
// its K/V — the readback walks it via tp_carrier_tag + the map/list-elem getters.
pub fn get_list_elem_option_inner_tp(name: Str) -> Int {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_LIST {
            let c1 = tp_get_child1(sv.tp_id)
            if c1 >= 0 && tp_get_kind(c1) == CT_OPTION {
                return tp_get_child1(c1)
            }
            return -1
        }
        i = i - 1
    }
    -1
}

// The element Result's OK / ERR inner tp NODE
// (List[Result[Map[Int,Str],Str]] → the `Map[Int,Str]` tp for ok, `Str` for err),
// or -1. The Result twin of get_list_elem_option_inner_tp.
pub fn get_list_elem_result_ok_tp(name: Str) -> Int {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_LIST {
            let c1 = tp_get_child1(sv.tp_id)
            if c1 >= 0 && tp_get_kind(c1) == CT_RESULT {
                return tp_get_child1(c1)
            }
            return -1
        }
        i = i - 1
    }
    -1
}

pub fn get_list_elem_result_err_tp(name: Str) -> Int {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_LIST {
            let c1 = tp_get_child1(sv.tp_id)
            if c1 >= 0 && tp_get_kind(c1) == CT_RESULT {
                return tp_get_child2(c1)
            }
            return -1
        }
        i = i - 1
    }
    -1
}

// The element Map's KEY / VALUE inner tp NODE
// (List[Map[Str,List[Int]]] → the `List[Int]` tp for val), or -1. The Map twin
// of get_list_elem_option_inner_tp/get_list_elem_result_ok_tp — used by
// copy_list_compound_elem to carry a deep Map element across a `let g = <list-expr>`
// re-binding the way it already does for Option/Result.
pub fn get_list_elem_map_key_tp(name: Str) -> Int {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_LIST {
            let c1 = tp_get_child1(sv.tp_id)
            if c1 >= 0 && tp_get_kind(c1) == CT_MAP {
                return tp_get_child1(c1)
            }
            return -1
        }
        i = i - 1
    }
    -1
}

pub fn get_list_elem_map_val_tp(name: Str) -> Int {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_LIST {
            let c1 = tp_get_child1(sv.tp_id)
            if c1 >= 0 && tp_get_kind(c1) == CT_MAP {
                return tp_get_child2(c1)
            }
            return -1
        }
        i = i - 1
    }
    -1
}

// The struct/enum/tuple NAME of a List[Option[T]] element-option inner, or "" when
// the inner is scalar/unset. Resolves from the list tid alone — the mono stem
// (generic instances), the struct/enum head (plain named structs the mono step
// declines), then the tuple tag — because the flat pool erases a mono/field-bound
// list's deep inner. A projection temp (a fn return, a tuple element) carries the
// list tid too: emit_list_method stamps it from the node tid before this runs.
pub fn get_list_elem_option_inner_struct(name: Str) -> Str {
    let lt = get_sv_ty(name, CT_LIST)
    if lt >= 0 {
        let et = tc_tid_list_elem(cg_bind_mono_tid(lt))
        if tc_tid_ct(et) == CT_OPTION {
            let mono = tc_tid_option_inner_struct_mono(et)
            if mono != "" { return mono }
            let nm = tc_tid_option_inner_struct_head(et)
            if nm != "" { return nm }
            let tup = tc_tid_option_inner_tuple(et)
            if tup != "" { return tup }
        }
    }
    ""
}

pub fn get_list_elem_result_ok(name: Str) -> Int {
    let lt = get_sv_ty(name, CT_LIST)
    if lt >= 0 {
        let et = tc_tid_list_elem(cg_bind_mono_tid(lt))
        if tc_tid_ct(et) == CT_RESULT {
            let c = tc_tid_result_ok_ct(et)
            // Answer only a leaf-scalar Ok inner as a bare CT. A struct/enum/container
            // inner returns -1 here on purpose: every caller shadows this CT with the
            // Ok tp channel (get_list_elem_result_ok_tp) or the struct-name channel
            // (get_list_elem_result_ok_struct), both of which spell the non-scalar
            // inner faithfully.
            if c >= 0 && is_leaf_scalar_ct(c) != 0 { return c }
        }
    }
    -1
}

pub fn get_list_elem_result_err(name: Str) -> Int {
    let lt = get_sv_ty(name, CT_LIST)
    if lt >= 0 {
        let et = tc_tid_list_elem(cg_bind_mono_tid(lt))
        if tc_tid_ct(et) == CT_RESULT {
            let c = tc_tid_result_err_ct(et)
            // Leaf-scalar Err inner only; a struct/enum/container inner returns -1
            // here on purpose and callers recover it from the Err tp/struct channel
            // (see get_list_elem_result_ok).
            if c >= 0 && is_leaf_scalar_ct(c) != 0 { return c }
        }
    }
    -1
}

pub fn get_list_elem_result_ok_struct(name: Str) -> Str {
    let lt = get_sv_ty(name, CT_LIST)
    if lt >= 0 {
        let et = tc_tid_list_elem(cg_bind_mono_tid(lt))
        if tc_tid_ct(et) == CT_RESULT {
            let mono = tc_tid_result_ok_struct_mono(et)
            if mono != "" { return mono }
            let nm = tc_tid_result_ok_struct_head(et)
            if nm != "" { return nm }
            let tup = tc_tid_result_ok_tuple(et)
            if tup != "" { return tup }
        }
    }
    ""
}

pub fn get_list_elem_result_err_struct(name: Str) -> Str {
    let lt = get_sv_ty(name, CT_LIST)
    if lt >= 0 {
        let et = tc_tid_list_elem(cg_bind_mono_tid(lt))
        if tc_tid_ct(et) == CT_RESULT {
            let mono = tc_tid_result_err_struct_mono(et)
            if mono != "" { return mono }
            let nm = tc_tid_result_err_struct_head(et)
            if nm != "" { return nm }
            let tup = tc_tid_result_err_tuple(et)
            if tup != "" { return tup }
        }
    }
    ""
}

// A payload-less enum element is VALUE-boxed in a list, exactly like an Int:
// `blink_list_push(l, (void*)(intptr_t)blink_Col_Red)`, because the variant
// expression is an ordinal with no struct behind it. A name in this slot asserts
// the OPPOSITE -- every consumer reads a named element as pointer-boxed and emits
// `*(blink_Col*)(intptr_t)value`, a deref of an ordinal. So the one place a name
// enters the flat pair is the one place to reject it: record the boxing that
// actually happens. A DATA enum keeps its name (propagate_enum_struct gives it a
// real struct and it is genuinely pointer-boxed), and so does a str-backed one's
// C enum -- that is still an ordinal.
pub fn set_list_elem_struct(name: Str, struct_name: Str) {
    if struct_name != "" && is_enum_type(struct_name) != 0 && is_data_enum(struct_name) == 0 {
        set_list_elem_type(name, CT_INT)
        return
    }
    set_list_elem_struct_raw(name, struct_name)
}

// The reject above is a fact about the lists the COMPILER builds by push, .set and literal, not
// about every `blink_list*`. blink_map_keys / blink_set_to_list hand back a list of the container's
// KEYS, and a STRUCT key is pointer-boxed (blink_alloc + kops, inline_key = 0). A caller that knows
// its slots hold pointers records the pair through here, so (CT_VOID, name) keeps meaning exactly
// one thing — "deref this" — on both kinds of list. A payload-less enum key does NOT come here: it
// is an inline key, so its slots hold ordinals like every other producer's.
pub fn set_list_elem_named_boxed(name: Str, struct_name: Str) {
    set_list_elem_type(name, CT_VOID)
    set_list_elem_struct_raw(name, struct_name)
}

fn set_list_elem_struct_raw(name: Str, struct_name: Str) {
    // Carry the List[Elem] tid on a plain-struct-element list so get_list_elem_struct
    // names the element from the tid. sname2 is no longer written here: get_list_elem_struct
    // reads the element name from the tid alone. Same guards as set_var_struct: a generic
    // base, transparent newtype, mangled instance name, or aliased/re-exported name resolves
    // to -1, so the tid arm declines and the element goes unnamed (get_list_elem_struct
    // returns "" — the right answer, as the old sname2 name named no declared C typedef for
    // those shapes). Never overwrite an existing tid (an annotated List[T] already carries
    // its own). With the tid set, get_list_elem_type now answers CT_STRUCT (not CT_VOID)
    // for a boxed struct element;
    // safe because every list-element reader treats CT_STRUCT/CT_VOID/CT_ENUM alike when
    // a struct name accompanies the element (list slots are always pointer-boxed).
    let elem = lookup_named_type(struct_name)
    let bare = strip_module_qualifier(struct_name)
    let list_tid = if elem >= 0 && is_transparent_newtype(bare) == 0 && struct_def_is_generic(bare) == 0 && tc_tid_struct(elem) == bare { make_list_type(elem) } else { -1 }
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_LIST {
            let newty = if sv.ty >= 0 { sv.ty } else { list_tid }
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: sv.inner1, inner2: sv.inner2, sname: sv.sname, sname2: sv.sname2, ty: newty, tp_id: sv.tp_id })
            return
        }
        i = i - 1
    }
    push_scope_var(ScopeVar { name: name, ctype: CT_LIST, is_mut: 0, inner1: -1, inner2: -1, sname: "", sname2: "", ty: list_tid, tp_id: sv_tp(CT_LIST, -1, -1, "") })
}

pub fn get_list_elem_struct(name: Str) -> Str {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_LIST {
            if sv.ty >= 0 {
                let bt = cg_bind_mono_tid(sv.ty)
                // A plain enum element is name-carried by the tid but stored by
                // ordinal, so its struct name must NOT surface here — it would type
                // the `.get` carrier as a by-pointer struct box and deref the
                // ordinal as a pointer. Decline CT_ENUM and let the empty return stand.
                // The struct name comes from the mono STEM (never the bare-head
                // fallback): an erased generic-fn-return element has no recoverable
                // stem, and its bare head would emit an undeclared C symbol.
                // See tc_tid_list_elem_struct_mono.
                if tc_tid_list_elem_ct_resolved(bt) != CT_ENUM {
                    let s = tc_tid_list_elem_struct_mono(bt)
                    if s != "" { return s }
                    // Then the plain struct HEAD (enums already excluded above):
                    // a non-generic struct element the mono stem declines is named
                    // by the tid here, mirroring get_map_value_struct. Tuples and
                    // transparent newtypes decline and return "" below.
                    let head = tc_tid_list_elem_struct_head(bt)
                    if head != "" && is_transparent_newtype(head) == 0 && struct_def_is_generic(head) == 0 { return head }
                    // A tuple element carries its carrier name on the element tid,
                    // spelled by the dedicated tuple speller (not the bare Tuple2 tag).
                    // Gate on find_tuple_entry: trust the tid spelling only when it
                    // names a registered typedef -- a module-qualified element can
                    // diverge from resolve_tuple_ann's flat spelling, and an
                    // unspellable element yields an ICE_SEG sentinel; both name no
                    // registered carrier, so we decline and return "" below.
                    let tup = tc_tid_tuple_sname(tc_tid_list_elem(bt))
                    if find_tuple_entry(tup) >= 0 { return tup }
                } else {
                    // A data enum carries a payload and is stored BOXED, so its
                    // struct name must surface (unlike a plain ordinal enum, which
                    // stays by ordinal — is_data_enum head == 0 declines it).
                    let es = tc_tid_list_elem_struct_head(bt)
                    if es != "" && is_data_enum(es) != 0 {
                        if struct_def_is_generic(es) != 0 {
                            // A generic data-enum instance (Tree[Int]) names its mono
                            // stem (Tree_0Int). An unencodable instance (bare typevar /
                            // module-qualified arg) has no stem, so the mono speller
                            // declines and the read returns "" — never the bare head,
                            // which has no declared C typedef.
                            let esm = tc_tid_list_elem_struct_mono(bt)
                            if esm != "" { return esm }
                        } else {
                            // A plain data enum or a transparent newtype (Errno): the
                            // head IS the declared C name.
                            return es
                        }
                    }
                }
            }
        }
        i = i - 1
    }
    let alt = c_blink_name(name)
    if alt != name {
        let mut j = scope_vars.len() - 1
        while j >= 0 {
            let sv = scope_vars.get(j).unwrap()
            if sv.name == alt && sv.ctype == CT_LIST {
                if sv.ty >= 0 {
                    let bt = cg_bind_mono_tid(sv.ty)
                    if tc_tid_list_elem_ct_resolved(bt) != CT_ENUM {
                        let s = tc_tid_list_elem_struct_mono(bt)
                        if s != "" { return s }
                        let head = tc_tid_list_elem_struct_head(bt)
                        if head != "" && is_transparent_newtype(head) == 0 && struct_def_is_generic(head) == 0 { return head }
                        let tup = tc_tid_tuple_sname(tc_tid_list_elem(bt))
                        if find_tuple_entry(tup) >= 0 { return tup }
                    } else {
                        let es = tc_tid_list_elem_struct_head(bt)
                        if es != "" && is_data_enum(es) != 0 {
                            if struct_def_is_generic(es) != 0 {
                                let esm = tc_tid_list_elem_struct_mono(bt)
                                if esm != "" { return esm }
                            } else {
                                return es
                            }
                        }
                    }
                }
            }
            j = j - 1
        }
    }
    ""
}

// Unlike set_var_option_inner2 (mutate-only -- silently a no-op if
// `name` isn't already a registered CT_OPTION var), this pushes a fresh
// ScopeVar when no CT_SET entry exists yet. Callers that only ever expect to
// annotate an already-live Set var still get a write; callers relying on this
// push as their FIRST registration of `name` must not assume any other kind
// (e.g. CT_OPTION) also gets stamped by the same call.
pub fn set_set_elem_type(name: Str, elem_type: Int) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_SET {
            // A set var is always (CT_SET, sname=""); the pool key needs no flat-field read here,
            // so the fresh element alone reconstructs the same entry.
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: elem_type, inner2: -1, sname: sv.sname, sname2: sv.sname2, ty: sv.ty, tp_id: sv_tp(CT_SET, elem_type, -1, "") })
            return
        }
        i = i - 1
    }
    push_scope_var(ScopeVar { name: name, ctype: CT_SET, is_mut: 0, inner1: elem_type, inner2: -1, sname: "", sname2: "", ty: -1, tp_id: sv_tp(CT_SET, elem_type, -1, "") })
}

// A binding-site tid (ScopeVar.ty / CaptureEntry.tid) is the RAW declared tid: inside a
// monomorphized generic-fn body its typevars are still bare, so a nested struct element/key
// would read back as its bare base name (HBox, not HBox_0HBox_10Int) and miss the kops
// struct-key registry. Substitute the active mono binders first so the tid spells its concrete
// stem. Its free typevars are the ENCLOSING FN's tparams, so bind against cg_fn_mono_*, NOT
// cg_mono_*: the latter is transiently swapped to the containing struct's tparams during a
// struct-literal field loop, so a binding-site read reached there would bind against the wrong
// (or empty) pair and silently drop back to the bare-name miss. A no-op outside a mono body or
// on a typevar-free tid.
// Resolve bound metavars before substituting: a var whose type was pinned by a
// later use (an inferred `let mut xs = []` element bound via `xs.push`) reaches
// codegen as a metavar tid, and every carrier accessor wraps its tid through here.
// Following the binding at this one chokepoint spells the real carrier inner from
// the tid rather than ceding to the flat channel.
pub fn cg_bind_mono_tid(ty: Int) -> Int {
    tc_tid_subst_mono(tc_tid_resolved(ty), cg_fn_mono_tparams_sl, cg_fn_mono_arg_tids)
}

// -1 means "no element recorded" — callers must treat that as unknown (loud diagnostic
// downstream), never assume CT_STRING. A struct/tuple element legitimately reads -1 here too, so
// check get_set_elem_struct before concluding "truly unknown".
pub fn get_set_elem_type(name: Str) -> Int {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_SET {
            if sv.ty >= 0 {
                let e = tc_tid_set_elem_ct_resolved(cg_bind_mono_tid(sv.ty))
                // An enum element is name-carried: c_type_str spells CT_ENUM
                // "void" and emit_set_method's CT guard omits CT_ENUM, so let it
                // fall through to the flat CT (CT_VOID) and pick up the identity
                // from get_set_elem_struct's tid-first sname instead.
                if e >= 0 && e != CT_ENUM { return e }
            }
            // No tid (a set var registered only via set_set_elem_type, ty<0): read
            // the element off the flat field, not the derived tp_* pool — sv_tp
            // built that pool child straight from inner1 at the same setter, so the
            // two agree, and an erased-typevar element reads CT_VOID either way.
            return sv.inner1
        }
        i = i - 1
    }
    if cg_closure_cap_start >= 0 {
        let mut ci = 0
        while ci < cg_closure_cap_count {
            let cap = closure_captures.get(cg_closure_cap_start + ci).unwrap()
            if cap.name == name && tp_get_kind(cap.tp_id) == CT_SET {
                if cap.tid >= 0 {
                    let e = tc_tid_set_elem_ct_resolved(cg_bind_mono_tid(cap.tid))
                    if e >= 0 && e != CT_ENUM { return e }
                }
                // A capture carries no flat element field, only its source var's
                // tid (get_var_ty at capture time). This fallback is unreachable
                // for the element read: closure bodies emit inline, so the source
                // var is still live in scope_vars and the SCOPE branch above
                // answers first (a Set param carries ty<0, so the tid branch here
                // would NOT). -1 ("no element recorded") is the honest fallback
                // rather than a read off the derived tp_* pool.
                -1
            }
            ci = ci + 1
        }
    }
    -1
}

// Struct/tuple element tag of a Set scope var (parallels get_map_key_struct),
// or "" when the element is a scalar. Lets emit_set_method box a struct/tuple
// element via the same kops-struct path Map uses for struct keys.
pub fn get_set_elem_struct(name: Str) -> Str {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_SET {
            if sv.ty >= 0 {
                let s = tc_tid_set_elem_struct_resolved(cg_bind_mono_tid(sv.ty))
                if s != "" { return s }
            }
            return ""
        }
        i = i - 1
    }
    if cg_closure_cap_start >= 0 {
        let mut ci = 0
        while ci < cg_closure_cap_count {
            let cap = closure_captures.get(cg_closure_cap_start + ci).unwrap()
            if cap.name == name && tp_get_kind(cap.tp_id) == CT_SET {
                if cap.tid >= 0 {
                    let s = tc_tid_set_elem_struct_resolved(cg_bind_mono_tid(cap.tid))
                    if s != "" { return s }
                }
                return ""
            }
            ci = ci + 1
        }
    }
    ""
}

// Record a struct/tuple element tag on a Set scope var (parallels
// set_map_key_struct). Rebuilds the tp_id with the element carrying `sname`.
pub fn set_set_elem_struct(name: Str, struct_name: Str) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_SET {
            let new_tp = type_set(type_struct(struct_name))
            // A synthesized receiver (a union temp, a generic-struct field, a
            // tuple element) reaches here on ty<0, its concrete element known
            // only now as `struct_name`. Intern it as a real Set tid so the
            // element reads back off the authoritative tid channel, not the flat
            // pool. A var that already carries a tid keeps it — the tid is richer.
            let new_ty = if sv.ty < 0 { make_set_type(make_struct_instance_type(struct_name, [])) } else { sv.ty }
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: sv.inner1, inner2: sv.inner2, sname: sv.sname, sname2: sv.sname2, ty: new_ty, tp_id: new_tp })
            return
        }
        i = i - 1
    }
}

pub fn set_map_types(name: Str, key_type: Int, value_type: Int, value_name: Str) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_MAP {
            let prior_k_sname = tp_child1_sname(sv.tp_id)
            // A re-emitted generic-struct field Map[K,V] carries an erased
            // typevar value (CT_VOID, no struct name). Never let it clobber a
            // value already resolved on this var — CT_VOID is not a storable map
            // value, so an incoming erased-void with no name is always a
            // re-registration, not a genuine reset. Mirrors the prior_k_sname
            // key preservation above.
            let prior_v = tp_child2_kind(sv.tp_id)
            let val_erased = value_type == CT_VOID && value_name == ""
            let eff_value_type = if val_erased && prior_v >= 0 && prior_v != CT_VOID { prior_v } else { value_type }
            let new_tp = if prior_k_sname != "" {
                let new_v = if eff_value_type >= 0 { sv_tp(eff_value_type, -1, -1, sv.sname2) } else { type_int() }
                type_map(type_struct(prior_k_sname), new_v)
            } else {
                sv_tp(sv.ctype, key_type, eff_value_type, sv.sname)
            }
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: key_type, inner2: eff_value_type, sname: sv.sname, sname2: sv.sname2, ty: sv.ty, tp_id: new_tp })
            if (value_type == CT_VOID || value_type == CT_STRUCT || value_type == CT_ENUM) && value_name != "" && is_named_type(value_name) != 0 {
                set_map_value_struct(name, value_name)
            }
            return
        }
        i = i - 1
    }
    push_scope_var(ScopeVar { name: name, ctype: CT_MAP, is_mut: 0, inner1: key_type, inner2: value_type, sname: "", sname2: "", ty: -1, tp_id: sv_tp(CT_MAP, key_type, value_type, "") })
    if (value_type == CT_VOID || value_type == CT_STRUCT || value_type == CT_ENUM) && value_name != "" && is_named_type(value_name) != 0 {
        set_map_value_struct(name, value_name)
    }
}

// Raw map key type: the tp child1 kind, or -1 when the key type was never set.
// Unlike get_map_key_type this does NOT mask an unset key as CT_STRING, so callers
// can tell a genuinely-recovered key apart from the default.
pub fn get_map_key_type_raw(name: Str) -> Int {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_MAP {
            return tp_child1_kind(sv.tp_id)
        }
        i = i - 1
    }
    if cg_closure_cap_start >= 0 {
        let mut ci = 0
        while ci < cg_closure_cap_count {
            let cap = closure_captures.get(cg_closure_cap_start + ci).unwrap()
            if cap.name == name && tp_get_kind(cap.tp_id) == CT_MAP {
                return tp_child1_kind(cap.tp_id)
            }
            ci = ci + 1
        }
    }
    -1
}

// The map's value kind with NO Int default — -1 when unset (an empty
// `Map()` literal). Distinguishes a genuinely-typed Map[K,Int] from an untyped
// Map() so the push carry doesn't downgrade a list's annotated element-map
// value type to the default. Mirrors get_map_key_type_raw.
pub fn get_map_value_type_raw(name: Str) -> Int {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_MAP {
            if sv.ty >= 0 {
                // Struct/enum values are name-carried: lead with the tid and answer
                // CT_VOID (the name rides get_map_value_struct). A push-only inferred
                // map (inner2 unset) reaches here with only the tid populated, so this
                // recovers the CT_VOID before the flat inner2 kind below.
                let vt = cg_bind_mono_tid(sv.ty)
                let c = tc_tid_map_val_ct_resolved(vt)
                if c == CT_STRUCT || c == CT_ENUM { return CT_VOID }
                // A tuple value is name-carried too (its C type is a generated
                // struct spelled by get_map_value_struct); tid_inner_ct erases
                // Tuple to -1, so detect it via the tuple speller and answer CT_VOID.
                if tc_tid_map_val_tuple(vt) != "" { return CT_VOID }
            }
            // Read the flat value kind directly. A List value now carries CT_LIST
            // in inner2 (set_map_value_list_elem stamps it alongside the `extra`
            // element carrier), so the value kind rides inner2 like every other
            // shape — the `extra` short-circuit that once outranked it is retired.
            // A key-only binder stamp can bake a placeholder CT_INT into the pool
            // value child while leaving inner2 -1; that Int was a fabricated
            // default, so prefer inner2's -1 ("unknown") — this function's
            // documented contract for an unset value. A scalar value kind is NOT
            // led from the tid here: raw must keep returning -1 when the flat kind
            // is genuinely unset, so callers can tell an annotated Map[K,Int] from
            // an untyped Map() (the get_map_value_type sibling leads scalars).
            return sv.inner2
        }
        i = i - 1
    }
    if cg_closure_cap_start >= 0 {
        let mut ci = 0
        while ci < cg_closure_cap_count {
            let cap = closure_captures.get(cg_closure_cap_start + ci).unwrap()
            if cap.name == name && tp_get_kind(cap.tp_id) == CT_MAP {
                if cap.tid >= 0 {
                    // Mirror the scope-var branch: a tid-spelled struct/enum value
                    // answers CT_VOID (name-carried) rather than the off-convention
                    // CT_STRUCT tp_child2_kind can hold on the recover path.
                    let c = tc_tid_map_val_ct_resolved(cg_bind_mono_tid(cap.tid))
                    if c == CT_STRUCT || c == CT_ENUM { return CT_VOID }
                }
                return tp_child2_kind(cap.tp_id)
            }
            ci = ci + 1
        }
    }
    -1
}

pub fn get_map_key_type(name: Str) -> Int {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_MAP {
            if sv.ty >= 0 {
                let k = tc_tid_map_key_ct_resolved(cg_bind_mono_tid(sv.ty))
                // An enum key is name-carried (see get_set_elem_type): map_key_expr_inner's
                // CT branch spells CT_ENUM "void", so fall through to the flat CT and let
                // the identity ride get_map_key_struct's tid-first sname instead.
                if k >= 0 && k != CT_ENUM { return k }
            }
            // No CT_STRING fabrication: an unset key kind returns -1 (mirrors
            // get_set_elem_type) so a consumer can tell a genuinely-recovered
            // Str key from "key unknown" instead of trusting a plausible default.
            return tp_child1_kind(sv.tp_id)
        }
        i = i - 1
    }
    if cg_closure_cap_start >= 0 {
        let mut ci = 0
        while ci < cg_closure_cap_count {
            let cap = closure_captures.get(cg_closure_cap_start + ci).unwrap()
            if cap.name == name && tp_get_kind(cap.tp_id) == CT_MAP {
                if cap.tid >= 0 {
                    let k = tc_tid_map_key_ct_resolved(cg_bind_mono_tid(cap.tid))
                    if k >= 0 && k != CT_ENUM { return k }
                }
                return tp_child1_kind(cap.tp_id)
            }
            ci = ci + 1
        }
    }
    -1
}

pub fn get_map_key_struct(name: Str) -> Str {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_MAP {
            if sv.ty >= 0 {
                let s = tc_tid_map_key_struct_resolved(cg_bind_mono_tid(sv.ty))
                if s != "" { return s }
            }
            return ""
        }
        i = i - 1
    }
    if cg_closure_cap_start >= 0 {
        let mut ci = 0
        while ci < cg_closure_cap_count {
            let cap = closure_captures.get(cg_closure_cap_start + ci).unwrap()
            if cap.name == name && tp_get_kind(cap.tp_id) == CT_MAP {
                if cap.tid >= 0 {
                    let s = tc_tid_map_key_struct_resolved(cg_bind_mono_tid(cap.tid))
                    if s != "" { return s }
                }
                return ""
            }
            ci = ci + 1
        }
    }
    ""
}

pub fn set_map_key_struct(name: Str, struct_name: Str) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_MAP {
            let v = if sv.inner2 >= 0 { sv.inner2 } else { CT_INT }
            let new_k = type_struct(struct_name)
            let new_v = if v >= 0 { sv_tp(v, -1, -1, sv.sname2) } else { type_int() }
            let new_tp = type_map(new_k, new_v)
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: sv.inner1, inner2: sv.inner2, sname: sv.sname, sname2: sv.sname2, ty: sv.ty, tp_id: new_tp })
            return
        }
        i = i - 1
    }
}

pub fn get_map_value_type(name: Str) -> Int {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_MAP {
            if sv.ty >= 0 {
                let vt = cg_bind_mono_tid(sv.ty)
                let c = tc_tid_map_val_ct_resolved(vt)
                // Struct/enum VALUES are name-carried: the emitter wants CT_VOID
                // here and reads the name from get_map_value_struct, unlike struct
                // KEYS which it handles as CT_STRUCT. Lead with the tid — when it
                // spells a struct/enum value, answer CT_VOID directly. A List value
                // rides the tid (CT_LIST) or, on a recovery path, inner2 below.
                if c == CT_STRUCT || c == CT_ENUM { return CT_VOID }
                // A tuple value is name-carried too (its C type is a generated
                // struct spelled by get_map_value_struct); tid_inner_ct erases
                // Tuple to -1, so detect it via the tuple speller and answer
                // CT_VOID, matching the raw sibling.
                if tc_tid_map_val_tuple(vt) != "" { return CT_VOID }
                if c >= 0 { return c }
            }
            // Read the flat value kind directly. A List value carries CT_LIST in
            // inner2 now, so the retired `extra` short-circuit no longer fronts this.
            // A key-only binder stamp can bake a placeholder CT_INT into the pool
            // value child while leaving inner2 -1; that Int was a fabricated default,
            // so prefer inner2's -1 ("unknown") over the pool's plausible Int. The
            // real value type, when known, is recovered upstream from the tid.
            return sv.inner2
        }
        i = i - 1
    }
    if cg_closure_cap_start >= 0 {
        let mut ci = 0
        while ci < cg_closure_cap_count {
            let cap = closure_captures.get(cg_closure_cap_start + ci).unwrap()
            if cap.name == name && tp_get_kind(cap.tp_id) == CT_MAP {
                if cap.tid >= 0 {
                    let c = tc_tid_map_val_ct_resolved(cg_bind_mono_tid(cap.tid))
                    // Mirror the scope-var branch: a tid-spelled struct/enum value
                    // answers CT_VOID (name-carried), keeping the captured-map CT the
                    // same as the enclosing scope's. Without this, a value stamped
                    // CT_STRUCT at tp child2 by recover_map_kv_from_tid would leak an
                    // off-convention CT_STRUCT here.
                    if c == CT_STRUCT || c == CT_ENUM { return CT_VOID }
                    if c >= 0 { return c }
                }
                return tp_child2_kind(cap.tp_id)
            }
            ci = ci + 1
        }
    }
    -1
}

pub fn set_map_value_struct(name: Str, struct_name: Str) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_MAP {
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: sv.inner1, inner2: sv.inner2, sname: sv.sname, sname2: struct_name, ty: sv.ty, tp_id: sv.tp_id })
            return
        }
        i = i - 1
    }
}

pub fn get_map_value_struct(name: Str) -> Str {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_MAP {
            if sv.ty >= 0 {
                let m = cg_bind_mono_tid(sv.ty)
                // Tid-first, mirroring sv_struct_tid_first: mono stem, then the
                // struct/enum head. An erased generic value (Box) reads back as its
                // bare head — the same inert non-empty name flat sname2 recovered
                // (the concrete mono is registered return-side; only non-emptiness
                // is consumed here), so the tid head answers it too. A transparent
                // newtype still declines: it erases to a scalar with no struct name.
                let mono = tc_tid_map_val_struct_mono(m)
                if mono != "" { return mono }
                // The head names a struct, enum, or transparent newtype value alike:
                // a transparent newtype keeps its Enum tid, so tc_tid_struct spells its
                // head the same name the flat sname2 channel once carried. The caller
                // does its own is_transparent_newtype check on the name to pick the cast.
                let nm = tc_tid_map_val_struct_head(m)
                if nm != "" { return nm }
                // A tuple value carries its tag on the tid; the struct-head reader
                // declines tuples, so spell it here rather than ceding to flat sname2.
                let tup = tc_tid_map_val_tuple(m)
                if tup != "" { return tup }
            }
            return ""
        }
        i = i - 1
    }
    ""
}

pub fn set_map_value_list_elem(name: Str, _elem_type: Int) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_MAP {
            // Recording a value-list element means the value kind IS a List, so stamp
            // inner2 = CT_LIST — the authoritative flat value kind get_map_value_type_raw
            // reads. Recovery paths (copy_map_value_meta, Option/Result unwrap) reach here
            // without a prior set_map_types. The element kind itself now rides the map tid,
            // recovered by get_map_value_list_elem, so it no longer writes the `extra` channel.
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: sv.inner1, inner2: CT_LIST, sname: sv.sname, sname2: sv.sname2, ty: sv.ty, tp_id: sv.tp_id })
            return
        }
        i = i - 1
    }
}

// The element kind of a `List[E]` map value, recovered from the authoritative map tid
// (value tid -> list element ct). The tid answers for every element kind — scalar, struct,
// enum or nested container — so the flat `extra` channel no longer backs this, mirroring
// the struct sibling get_map_value_list_elem_struct.
pub fn get_map_value_list_elem(name: Str) -> Int {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_MAP && sv.ty >= 0 {
            let vtid = tc_tid_map_val_tid(cg_bind_mono_tid(sv.ty))
            let c = tc_tid_list_elem_ct(vtid)
            if c >= 0 { return c }
            return -1
        }
        i = i - 1
    }
    -1
}

// The struct name of a `List[Struct]` map value's element. The flat `extra` channel holds
// only the element KIND, so a struct element loses its name; recover it from the
// authoritative map tid (value tid -> list element struct) instead of widening the channel.
pub fn get_map_value_list_elem_struct(name: Str) -> Str {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_MAP && sv.ty >= 0 {
            let vtid = tc_tid_map_val_tid(cg_bind_mono_tid(sv.ty))
            let es_mono = tc_tid_list_elem_struct_mono(vtid)
            if es_mono != "" { return es_mono }
            return tc_tid_list_elem_struct(vtid)
        }
        i = i - 1
    }
    ""
}

// empty BOTH value side-channels on a Map var, so a caller that knows the
// whole value type can state it without an older, narrower write masking the answer.
// get_map_value_type_raw answers CT_VOID whenever sname2 is set (a struct value name),
// which masks the tid-derived value kind. set_map_types preserves sname2 as its
// re-registration guard, which is right for a re-registration and wrong for an
// authoritative restatement, so the restatement clears sname2 first.
pub fn clear_map_value_meta(name: Str) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_MAP {
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: sv.inner1, inner2: sv.inner2, sname: sv.sname, sname2: "", ty: sv.ty, tp_id: sv.tp_id })
            return
        }
        i = i - 1
    }
}

pub fn copy_map_value_meta(src: Str, dst: Str) {
    let mvle = get_map_value_list_elem(src)
    if mvle >= 0 {
        set_map_value_list_elem(dst, mvle)
    }
    let mvs = get_map_value_struct(src)
    if mvs != "" {
        set_map_value_struct(dst, mvs)
    }
}

pub fn is_struct_type(name: Str) -> Int {
    if struct_reg_set.contains_key(name) != 0 { return 1 }
    let bare = strip_module_qualifier(name)
    if bare != name { return struct_reg_set.contains_key(bare) }
    0
}

pub fn is_named_type(name: Str) -> Int {
    if is_struct_type(name) != 0 { return 1 }
    if is_data_enum(name) != 0 { return 1 }
    0
}

pub fn closure_sig_ret_part(sig: Str) -> Str {
    let mut ret_end = 0
    while ret_end < sig.len() && sig.byte_at(ret_end) != 40 {
        ret_end = ret_end + 1
    }
    sig.substring(0, ret_end)
}

pub fn closure_ret_ct(ret_part: Str) -> Int {
    if ret_part == "int64_t" { return CT_INT }
    if ret_part == "double" { return CT_FLOAT }
    if ret_part == "const char*" { return CT_STRING }
    if ret_part == "int" { return CT_BOOL }
    CT_VOID
}

// A closure CALL's result type, read from the type typecheck memoized on the call node instead of
// re-parsed out of the emitted C signature string above — that string recognizes four spellings and
// answers CT_VOID for everything else, and `blink_list*`/`blink_map*`/`blink_set*`/`blink_bytes*`
// are shared by every instantiation, so they are unrecoverable from it by construction.
//
// -1 means "typecheck memoized nothing here", which is the only case the string parse still has to
// cover. It is NOT the same as CT_VOID: tc_tid_ct answers -1 for a Void tid too, and a
// void-returning closure must keep reaching the string path that spells it.
pub fn closure_ret_tid(node: Int) -> Int {
    let raw = tc_lookup_node_tid(node)
    if raw == -1 { return -1 }
    tc_tid_subst_mono(raw, cg_mono_tparams_sl, cg_mono_arg_tids)
}

// The tid-led head CT for a closure call result. Seating the head CT is the whole job for every
// kind but the three excluded below: a scalar needs nothing else, and a container's value is one
// shared runtime pointer whose element types are recovered downstream from this same tid.
//
// Option and Result must register a per-instantiation carrier typedef and emit a temp to hold it,
// and Struct must attach a NAME to a temp, so those three keep the existing string-driven reseat
// paths. An exclusion rather than a whitelist because the string parse erased every kind it could
// not spell alike — Char, I32, StringBuilder, Channel and the containers together.
//
// Takes a CALL node, whose tid IS the result. A closure LITERAL answers its own Closure tid
// here, so every kind test below reads CT_CLOSURE and a genuine Void cannot report itself —
// use closure_lit_ret_ct for that side.
pub fn closure_ret_direct_ct(node: Int) -> Int {
    let tid = closure_ret_tid(node)
    if tid == -1 { return -1 }
    let ct = tc_tid_ct(tid)
    if ct == CT_OPTION || ct == CT_RESULT || ct == CT_STRUCT { return -1 }
    ct
}

// The opaque inner struct name of a closure CALL whose result is Option[@ffi.opaque],
// else "". NPO spells that return as the bare handle (`FILE*`), a tag-less C type the
// string-driven reseat cannot recognize (closure_ret_tag_is_recognized only knows
// `blink_`-prefixed carriers), so the tid is the sole authority for restoring the
// Option-ness onto the call result.
pub fn closure_ret_opaque_option_inner(node: Int) -> Str {
    let raw = closure_ret_tid(node)
    if raw == -1 { return "" }
    let tid = tc_tid_resolved(raw)
    if tc_tid_ct(tid) != CT_OPTION { return "" }
    let inner_s = tc_tid_option_inner_struct(tid)
    if inner_s != "" && is_opaque_type(inner_s) != 0 { return inner_s }
    ""
}

// The C return spelling of a closure LITERAL, read off its Fn tid; "" when there is no tid or it
// does not name a Fn. A closure call is emitted `((sig)cls->fn_ptr)(cls, args..)`, so the CAST has
// to name the same C type the declaration does, and the annotation-string chain that builds the sig
// answers `void` for every kind c_type_str cannot spell. DECLINES rather than half-spelling: the
// string it feeds is a cast, so a half-answer either fails to compile or compiles against the wrong
// ABI.
pub fn closure_lit_ret_c(node: Int) -> Str {
    let raw = tc_lookup_node_tid(node)
    if raw == -1 { return "" }
    let t = tc_tid_resolved(tc_tid_subst_mono(raw, cg_mono_tparams_sl, cg_mono_arg_tids))
    if tc_tid_ct(t) != CT_CLOSURE { return "" }
    c_type_from_tid(tc_tid_child(t, 0))
}

// The C spelling of closure LITERAL parameter `i`, read off its Fn tid; "" when there is no
// tid, it does not name a Fn, or the slot is out of range.
//
// The same pairing as the return above, for the other half of the signature: the definition's
// parameter list and the call-site cast are one ABI. Declines on a `void` answer because that
// is not a legal parameter — an unspellable slot has to leave both sides on the string chain
// together rather than repair one of them.
pub fn closure_lit_param_c(node: Int, i: Int) -> Str {
    let raw = tc_lookup_node_tid(node)
    if raw == -1 { return "" }
    let t = tc_tid_resolved(tc_tid_subst_mono(raw, cg_mono_tparams_sl, cg_mono_arg_tids))
    if tc_tid_ct(t) != CT_CLOSURE { return "" }
    // Child 0 is the return and the params follow it (tc_tid_child's Fn arm).
    if i + 1 >= tc_tid_child_count(t) { return "" }
    let p_c = c_type_from_tid(tc_tid_child(t, i + 1))
    if p_c == "void" { return "" }
    p_c
}

// The tid of closure param i, read off the closure's own Fn tid — the same producer
// closure_lit_param_c spells the C type from. typecheck publishes the param types only
// on the closure node (make_fn_type), never on the param node or its annotation, so this
// is the reachable source for stamping a compound param's element metadata. -1 when the
// node has no closure tid or the position is absent.
pub fn closure_lit_param_tid(node: Int, i: Int) -> Int {
    let raw = tc_lookup_node_tid(node)
    if raw == -1 { return -1 }
    let t = tc_tid_resolved(tc_tid_subst_mono(raw, cg_mono_tparams_sl, cg_mono_arg_tids))
    if tc_tid_ct(t) != CT_CLOSURE { return -1 }
    if i + 1 >= tc_tid_child_count(t) { return -1 }
    tc_tid_child(t, i + 1)
}

// Spell an unannotated closure param from the call-site element tid the HOF publishes.
// The closure literal's own tid carries no type for a param the body only infers, so
// closure_lit_param_c declines there; the list/iterator element tid is the reachable
// source. Declines (empty) for an unset or unspellable hint, keeping the flat CT.
pub fn closure_hint_c(hint_tid: Int) -> Str {
    if hint_tid == -1 { return "" }
    let c = c_type_from_tid(hint_tid)
    if c == "void" { return "" }
    c
}

// The head CT of that same return, for the body emitter that decides whether the tail is
// returned or discarded. Paired with closure_lit_ret_c on purpose: the signature and the body
// are two halves of one ABI, and a body repaired from a different producer can disagree with
// the head it is emitted under. closure_ret_direct_ct is NOT that producer — it reads the tid
// of the node it is given as the result, which is true of a CALL node but makes a closure
// LITERAL answer CT_CLOSURE, so a genuine Void never reports itself.
pub fn closure_lit_ret_ct(node: Int) -> Int {
    let raw = tc_lookup_node_tid(node)
    if raw == -1 { return -1 }
    let t = tc_tid_resolved(tc_tid_subst_mono(raw, cg_mono_tparams_sl, cg_mono_arg_tids))
    if tc_tid_ct(t) != CT_CLOSURE { return -1 }
    tc_tid_ct(tc_tid_child(t, 0))
}

// The mono stem of the struct/enum INSTANCE a type annotation names; "" when it names none.
//
// The sole producer for every position that spells a struct/enum annotation, this one or
// ann_mono_c_type below. node_name / node_type_name on a `Box[Int]` annotation answer the generic
// BASE, which has no typedef of its own, so a by-name spelling of an annotation names a C symbol
// that was never emitted. resolve_type_parts memoizes the instance tid onto the annotation node,
// and tc_tid_struct_mono_name is the stem producer byte-matched to the def side's
// mangle_generic_name. Declines ("") for a bare generic base, an unsubstituted typevar slot or a
// module-qualified head, leaving the caller on its by-name spelling.
pub fn ann_mono_stem(ta: Int) -> Str {
    tc_tid_struct_mono_name(tc_lookup_node_tid(ta))
}

// The same answer as a C type name rather than a stem, for the signature spellers.
pub fn ann_mono_c_type(ta: Int) -> Str {
    let stem = ann_mono_stem(ta)
    if stem == "" { return "" }
    c_type_c_name(stem)
}

// A fn-like node's own RETURN annotation carries the tid, so the return position reads the same
// producer as the params.
pub fn closure_ret_mono_stem(node: Int) -> Str {
    ann_mono_stem(node_type_ann(node))
}

// The struct name field resolution should use for a C type name; "" when the name is not a
// struct's. A generic struct INSTANCE's C name is in mono_instances, never in struct_reg_set —
// that registry holds generic BASES — and the answer for an instance is the instance name itself,
// not the base, whose declaration types every generic field as its typevar.
pub fn resolve_struct_from_c_name(cname: Str) -> Str {
    if struct_reg_set.contains_key(cname) { return cname }
    let mono = lookup_mono_base(cname)
    if mono.base != "" && is_struct_type(mono.base) != 0 { return cname }
    let mut i = 0
    while i < cname.len() {
        if cname.byte_at(i) == 95 { // '_'
            let suffix = cname.substring(i + 1, cname.len() - i - 1)
            if struct_reg_set.contains_key(suffix) {
                return suffix
            }
        }
        i = i + 1
    }
    ""
}

pub fn is_enum_type(name: Str) -> Int {
    if enum_reg_set.contains_key(name) != 0 { return 1 }
    let bare = strip_module_qualifier(name)
    if bare != name { return enum_reg_set.contains_key(bare) }
    0
}

pub fn is_struct_or_enum_type(name: Str) -> Int {
    if is_struct_type(name) != 0 { return 1 }
    if is_enum_type(name) != 0 { return 1 }
    0
}

pub fn resolve_variant(name: Str) -> Str {
    match enum_variant_name_idx.get(name) {
        Some(enum_name) => return enum_name
        None => {}
    }
    ""
}

pub fn get_var_enum(name: Str) -> Str {
    let mut i = var_enums.len() - 1
    while i >= 0 {
        let ve = var_enums.get(i).unwrap()
        if ve.name == name {
            return ve.enum_type
        }
        i = i - 1
    }
    let blink_name = c_blink_name(name)
    if blink_name != name {
        i = var_enums.len() - 1
        while i >= 0 {
            let ve = var_enums.get(i).unwrap()
            if ve.name == blink_name {
                return ve.enum_type
            }
            i = i - 1
        }
    }
    ""
}

pub fn is_data_enum(name: Str) -> Int {
    match enum_reg_set.get(name) {
        Some(v) => return v
        None => {}
    }
    let bare = strip_module_qualifier(name)
    if bare != name {
        match enum_reg_set.get(bare) {
            Some(v) => return v
            None => {}
        }
    }
    0
}

pub fn is_str_backed_enum(name: Str) -> Int {
    if enum_str_backed_set.contains_key(name) != 0 { return 1 }
    0
}

// The logical enum name a type-spelling denotes, or "" when it is not an enum.
// Accepts the bare name, a dot-qualified form, and the canonical underscore-joined
// carrier tag (`test_mod_Cmd`) that emit_struct_option_typedef and the other
// carrier-tag seams carry — enum_reg_set is keyed on the bare logical name, so a
// C tag must be walked back to it (mirrors resolve_struct_from_c_name, longest
// suffix first) or the two-namespace split makes the typedef and constructor
// disagree on by-value vs boxed.
pub fn enum_logical_name(name: Str) -> Str {
    if enum_reg_set.contains_key(name) != 0 { return name }
    let bare = strip_module_qualifier(name)
    if bare != name && enum_reg_set.contains_key(bare) != 0 { return bare }
    // A compound carrier tag (Result_/Option_/Map_) merely CONTAINS an enum
    // component; it is not the enum itself. The suffix-walk below would
    // false-match that component (mirrors is_transparent_newtype's guard).
    if is_compound_tag(name) != 0 { return "" }
    // A tag that resolves to a struct/mono-struct instance is not an enum; the
    // suffix-walk would otherwise match a trailing enum-named component of a
    // struct's C tag (e.g. `Foo_Bar` with a sibling enum `Bar`).
    if resolve_struct_from_c_name(name) != "" { return "" }
    let mut i = 0
    while i < name.len() {
        if name.byte_at(i) == 95 { // '_'
            let suffix = name.substring(i + 1, name.len() - i - 1)
            if enum_reg_set.contains_key(suffix) != 0 { return suffix }
        }
        i = i + 1
    }
    ""
}

// A payload-less enum (every variant nullary) lowers to a bare ordinal, so its
// Option/List carrier holds the enum BY VALUE — the same treatment
// is_boxed_struct_err gives a payload-less enum err arm, never a heap box.
pub fn is_payloadless_enum(name: Str) -> Int {
    let logical = enum_logical_name(name)
    if logical == "" { return 0 }
    if is_data_enum(logical) != 0 { return 0 }
    1
}

pub fn get_variant_index(enum_name: Str, variant_name: Str) -> Int {
    let key = enum_name.concat("|").concat(variant_name)
    match enum_variant_full_idx.get(key) {
        Some(idx) => return idx
        None => {}
    }
    -1
}

pub fn get_variant_tag(enum_name: Str, variant_name: Str) -> Int {
    let key = enum_name.concat("|").concat(variant_name)
    match enum_variant_full_idx.get(key) {
        Some(idx) => return enum_variants.get(idx).unwrap().tag
        None => {}
    }
    -1
}

pub fn get_variant_field_count(variant_idx: Int) -> Int {
    if variant_idx < 0 || variant_idx >= enum_variants.len() {
        return 0
    }
    enum_variants.get(variant_idx).unwrap().field_count
}

pub fn get_variant_field_name(variant_idx: Int, field_idx: Int) -> Option[Str] {
    let names_str = enum_variants.get(variant_idx).unwrap().field_names
    if names_str == "" {
        return None
    }
    let mut _seg_start = 0
    let mut _seg_idx = 0
    let mut i = 0
    while i <= names_str.len() {
        if i == names_str.len() || names_str.byte_at(i) == 44 { // ','
            if _seg_idx == field_idx {
                return Some(names_str.substr(_seg_start, i - _seg_start))
            }
            _seg_start = i + 1
            _seg_idx = _seg_idx + 1
        }
        i = i + 1
    }
    None
}

pub fn get_variant_field_type_str(variant_idx: Int, field_idx: Int) -> Option[Str] {
    let types_str = enum_variants.get(variant_idx).unwrap().field_types
    if types_str == "" {
        return None
    }
    let mut _seg_start = 0
    let mut _seg_idx = 0
    let mut bracket_depth = 0
    let mut i = 0
    while i <= types_str.len() {
        if i == types_str.len() {
            if _seg_idx == field_idx {
                return Some(types_str.substr(_seg_start, i - _seg_start))
            }
            _seg_start = i + 1
            _seg_idx = _seg_idx + 1
        } else if types_str.byte_at(i) == 91 {
            bracket_depth = bracket_depth + 1
        } else if types_str.byte_at(i) == 93 {
            bracket_depth = bracket_depth - 1
        } else if types_str.byte_at(i) == 44 && bracket_depth == 0 { // ','
            if _seg_idx == field_idx {
                return Some(types_str.substr(_seg_start, i - _seg_start))
            }
            _seg_start = i + 1
            _seg_idx = _seg_idx + 1
        }
        i = i + 1
    }
    None
}

// Declared type string of a variant field looked up BY NAME (struct-style
// patterns may reorder fields), or "" when the variant has no such field.
pub fn variant_field_type_by_name(variant_idx: Int, field_name: Str) -> Str {
    let fcount = get_variant_field_count(variant_idx)
    let mut fi = 0
    while fi < fcount {
        let vfn = get_variant_field_name(variant_idx, fi)
        if vfn.is_some() && vfn.unwrap() == field_name {
            let vft = get_variant_field_type_str(variant_idx, fi)
            if vft.is_some() {
                return vft.unwrap()
            }
            return ""
        }
        fi = fi + 1
    }
    ""
}

pub fn get_fn_enum_ret(name: Str) -> Str {
    let resolved = resolve_fn_lookup(name)
    let mut i = 0
    while i < fn_enum_rets.len() {
        let fe = fn_enum_rets.get(i).unwrap()
        if fe.name == resolved {
            return fe.enum_type
        }
        i = i + 1
    }
    ""
}

// Reverse-resolve a mangled generic-mono INSTANCE name (Box_0Int, Tree_0Int) back to its
// interned instance tid. lookup_named_type misses these — the mangled name is not in the
// name->tid registry, so set_var_struct would leave such a var on ty=-1 and force every
// reader onto the flat sname (the class-1 population gap). lookup_mono_base recovers the
// LOGICAL base + concrete arg tids the def side registered the instance with, and
// make_*_instance_type re-interns the SAME entry the def side minted (interning dedups).
//
// The struct/enum KIND comes from the base's def via is_enum_type: every top-level type is
// registered before any function body runs (where every set_var_struct caller lives), so the
// kind here matches the one the def side interned with. The round-trip is kind-AGNOSTIC —
// tc_tid_struct_mono_name spells a Struct and an Enum instance identically — so it validates
// only the NAME/args, not the kind: it spells the args recursively, so a stale or arg-less
// MonoInstance row (arg_tids empty, or an unsubstituted typevar slot) spells a different name
// and declines to -1, leaving the var on the flat sname. When it matches, tid_struct_name
// spells this var byte-identically to the sname it replaces, and tc_tid_ct answers the same
// CT_STRUCT/CT_ENUM the flat head already carries — so the stamp only ever confirms the name,
// never retypes the var.
fn mono_instance_tid(c_name: Str) -> Int {
    let ml = lookup_mono_base(c_name)
    if ml.base == "" { return -1 }
    let inst = if is_enum_type(ml.base) != 0 {
        make_enum_instance_type(ml.base, ml.arg_tids)
    } else {
        make_struct_instance_type(ml.base, ml.arg_tids)
    }
    if tc_tid_struct_mono_name(inst) == c_name { return inst }
    -1
}

// Reverse-resolve a nominal type name to its canonical tid: a declared, non-generic,
// non-transparent struct/enum via the name->tid registry, else a mangled generic-mono
// instance name (Box_0Int) via the mono registry. Returns -1 for a generic-def head, a
// transparent newtype, an alias/re-export whose tid names a different type, or a name
// absent from both registries — the caller then keeps the flat sname channel.
fn nominal_struct_tid(type_name: Str) -> Int {
    let resolved = lookup_named_type(type_name)
    let bare = strip_module_qualifier(type_name)
    let plain = if resolved >= 0 && is_transparent_newtype(bare) == 0 && struct_def_is_generic(bare) == 0 && tc_tid_struct(resolved) == bare { resolved } else { -1 }
    if plain >= 0 { plain } else { mono_instance_tid(type_name) }
}

pub fn set_var_struct(name: Str, type_name: Str) {
    // A declared, non-generic, non-transparent struct/enum name resolves to its
    // canonical tid via the name->tid registry, so a plain struct/enum var can
    // carry its type on sv.ty instead of only the flat sname channel. A generic
    // base (Box), a transparent newtype, and a mangled instance name (Box_0Int,
    // absent from the registry) resolve to -1 or are guarded out and keep riding
    // sname. Only stamp a plain value var (Struct/Enum/Void); a compound carrier
    // (Option/Result/Ptr) keeps sname as its INNER name and must not have its tid
    // overwritten with the bare inner struct. Never overwrite an existing tid. The
    // round-trip check adopts the tid only when it spells back the same bare name,
    // so an alias or re-export whose tid names a different type stays on sname. A
    // mangled mono-instance name that the plain lookup misses is recovered from the
    // mono registry through the same round-trip guard.
    let stamp = nominal_struct_tid(type_name)
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype != CT_CLOSURE {
            // A container never carries a struct name in the field-1 `sname` slot:
            // its element/key/value identities live in sname2/extra and the tid.
            // Writing one here would jam the name into sv_tp's element slot and
            // collapse the child kind to a bogus CT_STRUCT. Leave containers untouched.
            if sv.ctype == CT_MAP || sv.ctype == CT_SET || sv.ctype == CT_LIST {
                return
            }
            let is_plain_value = sv.ctype == CT_STRUCT || sv.ctype == CT_ENUM || sv.ctype == CT_VOID
            let newty = if sv.ty >= 0 { sv.ty } else { if is_plain_value { stamp } else { -1 } }
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: sv.inner1, inner2: sv.inner2, sname: type_name, sname2: sv.sname2, ty: newty, tp_id: sv_tp(sv.ctype, sv.inner1, sv.inner2, type_name) })
            return
        }
        i = i - 1
    }
    push_scope_var(ScopeVar { name: name, ctype: CT_VOID, is_mut: 0, inner1: -1, inner2: -1, sname: type_name, sname2: "", ty: stamp, tp_id: sv_tp(CT_VOID, -1, -1, type_name) })
}

// A tid's struct name — the authoritative channel — or "" when the tid names no
// struct shape yet. A fully-instantiated generic mono instance (Inner_0Int,
// Tree_0Int) is spelled from tc_tid_struct_mono_name, which is byte-matched to the
// def side's mangle_generic_name. A non-generic struct or data/payloadless enum
// names itself from tc_tid_struct — the same name the C type carries. The
// transparent Errno newtype is the one Struct/Enum tid that lowers to a bare
// scalar, so it must NOT name a struct here. Returns "" for a shape the tid cannot
// yet spell (a bare generic instance without its args, which mono_name declines and
// tc_tid_struct would wrongly spell as the bare base) so the caller can fall back.
fn tid_struct_name(ty: Int) -> Str {
    let m = cg_bind_mono_tid(ty)
    let mono = tc_tid_struct_mono_name(m)
    if mono != "" { return mono }
    let nm = tc_tid_struct(m)
    if nm != "" && is_transparent_newtype(nm) == 0 && struct_def_is_generic(nm) == 0 { return nm }
    // A tuple var carries its carrier name (Tuple2_int_int) on its own tid, spelled
    // by the DEDICATED tuple speller (full carrier name, not tid_inner_struct's bare
    // Tuple2 tag). tc_tid_struct declines tuples, so without this a registered tuple
    // var returns "". Gate on find_tuple_entry so a module-qualified element that
    // diverges from the flat spelling (or an ICE_SEG sentinel) names no registered
    // carrier and returns "" — its C type is spelled structurally by c_type_from_tid,
    // not by this nominal-struct name, so "" is correct.
    let tup = tc_tid_tuple_sname(m)
    if find_tuple_entry(tup) >= 0 { return tup }
    // A carrier var surfaces its INNER (Ok) struct name through this generic reader:
    // set_var_option_struct/set_var_result_struct store that name on the flat sname,
    // and callers of get_var_struct on an Option[Point]/Result[Point,E] var read it.
    // Recover it from the carrier tid via the nominal inner spellers, which name every
    // nominal inner (concrete struct, data enum, payloadless-enum Cmd, transparent-
    // newtype Errno, generic-mono stem Box_0Int spelled through the _struct_mono arm)
    // exactly as the flat sname does. This closes the population gap where the flat
    // sname is empty but the tid is populated, and leaves the populated case byte-
    // identical. Each speller is kind-guarded (declines a non-Option/non-Result tid to
    // ""), so the tid alone selects the carrier — no ctype read is needed to pick
    // between them.
    let oi = sev_option_inner_nominal(m)
    if oi != "" { return oi }
    let ri = sev_result_ok_nominal(m)
    if ri != "" { return ri }
    ""
}

// True when `ty`, run through the same tid arms the struct reader uses, spells
// exactly `flat`. A producer checks this round-trip before stamping a call-result
// temp's tid, so the stamp can only ever confirm the name the flat sname already
// carries — never silently retype the temp when the tid and the C decl diverge.
pub fn tid_spells_struct(ty: Int, flat: Str) -> Int {
    if tid_struct_name(ty) == flat { return 1 }
    0
}

// True when a populated tid names a GENERIC struct/enum instance the tid could not
// spell — mono_name declined and only the bare generic base remains — so the flat
// sname still carries the real nominal name. Reached only after tid_struct_name
// returned "": a non-generic empty answer there is authoritative (a scalar/container,
// a carrier over one, a transparent newtype, or a tuple spelled structurally by
// c_type_from_tid), but a generic instance is the one empty answer that hides a name.
fn tid_names_unspellable_generic(ty: Int) -> Int {
    let base = tc_tid_struct(cg_bind_mono_tid(ty))
    if base != "" && struct_def_is_generic(base) == 1 { return 1 }
    0
}

// A scope var's struct name, read tid-first — the authoritative channel. The flat
// sname is consulted ONLY when the tid cannot answer: a var whose tid is still
// unpopulated (ty < 0), or one whose tid names an unspellable generic instance. When
// a populated tid CAN answer, its answer is authoritative even when that answer is ""
// — a carrier over a container/scalar inner, or a tuple, has no nominal struct name,
// so "" is the correct spelling, not a failure the flat marker should override.
fn sv_struct_tid_first(sv: ScopeVar) -> Str {
    let nm = tid_struct_name(sv.ty)
    if nm != "" { return nm }
    if sv.ty >= 0 && tid_names_unspellable_generic(sv.ty) == 0 { return "" }
    sv.sname
}

pub fn get_var_struct(name: Str) -> Str {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype != CT_CLOSURE && sv.ctype != CT_HANDLER {
            return sv_struct_tid_first(sv)
        }
        i = i - 1
    }
    let blink_name = c_blink_name(name)
    if blink_name != name {
        i = scope_vars.len() - 1
        while i >= 0 {
            let sv = scope_vars.get(i).unwrap()
            if sv.name == blink_name && sv.ctype != CT_CLOSURE && sv.ctype != CT_HANDLER {
                return sv_struct_tid_first(sv)
            }
            i = i - 1
        }
    }
    ""
}

pub fn set_var_handler(name: Str, vtable_type: Str, vtable_field: Str, is_ue: Int) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_HANDLER {
            let s = scope_var_scratch.get(i).unwrap()
            scope_var_scratch.set(i, ScopeVarScratch { opt_erased: s.opt_erased, ptr_struct: s.ptr_struct, ptr_is_array: s.ptr_is_array, iter_next_fn: s.iter_next_fn, iter_carrier: s.iter_carrier, iter_alias: s.iter_alias, handler_vtable_type: vtable_type, handler_vtable_field: vtable_field, handler_is_ue: is_ue })
            return
        }
        i = i - 1
    }
}

pub fn get_var_handler_vtable_type(name: Str) -> Str {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_HANDLER {
            return scope_var_scratch.get(i).unwrap().handler_vtable_type
        }
        i = i - 1
    }
    ""
}

pub fn get_var_handler_vtable_field(name: Str) -> Str {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_HANDLER {
            return scope_var_scratch.get(i).unwrap().handler_vtable_field
        }
        i = i - 1
    }
    ""
}

pub fn get_var_handler_is_ue(name: Str) -> Int {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_HANDLER {
            return scope_var_scratch.get(i).unwrap().handler_is_ue
        }
        i = i - 1
    }
    0
}

pub fn get_struct_field_type(sname: Str, fname: Str) -> Int {
    let key = sname.concat("\t").concat(fname)
    match sf_entries_idx.get(key) {
        Some(idx) => {
            return tp_get_kind(sf_entries.get(idx).unwrap().tp_id)
        }
        None => {}
    }
    CT_VOID
}

pub fn get_struct_field_stype(sname: Str, fname: Str) -> Str {
    let key = sname.concat("\t").concat(fname)
    match sf_entries_idx.get(key) {
        Some(idx) => return tp_get_sname(sf_entries.get(idx).unwrap().tp_id)
        None => {}
    }
    ""
}

pub fn get_struct_field_tp_id(sname: Str, fname: Str) -> Int {
    let key = sname.concat("\t").concat(fname)
    match sf_entries_idx.get(key) {
        Some(idx) => return sf_entries.get(idx).unwrap().tp_id
        None => {}
    }
    -1
}

pub fn get_struct_field_type_tid(sname: Str, fname: Str) -> Int {
    let key = sname.concat("\t").concat(fname)
    match sf_entries_idx.get(key) {
        Some(idx) => return sf_entries.get(idx).unwrap().tid
        None => {}
    }
    -1
}

// The Fn `tid` is the authoritative signature channel that get_var_closure_sig reads first; the
// flat `sig` string is the fallback for the sites that still cannot supply a tid. A -1 tid keeps
// whatever ty the var already had rather than clobbering a good tid a fresh caller could not recover.
pub fn set_var_closure(name: Str, sig: Str, tid: Int) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_CLOSURE {
            let keep_ty = if tid >= 0 { tid } else { sv.ty }
            // A closure var is always (CT_CLOSURE, inner1=-1, inner2=-1); the pool key needs no
            // flat-field read here, so the sig alone reconstructs the same entry.
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: sv.inner1, inner2: sv.inner2, sname: sig, sname2: sv.sname2, ty: keep_ty, tp_id: sv_tp(CT_CLOSURE, -1, -1, sig) })
            return
        }
        i = i - 1
    }
    push_scope_var(ScopeVar { name: name, ctype: CT_CLOSURE, is_mut: 0, inner1: -1, inner2: -1, sname: sig, sname2: "", ty: tid, tp_id: sv_tp(CT_CLOSURE, -1, -1, sig) })
}

pub fn get_var_closure_sig(name: Str) -> Str {
    if scope_ct_count(CT_CLOSURE) <= 0 { return "" }
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_CLOSURE {
            let from_tid = closure_sig_from_tid(sv.ty)
            if from_tid != "" { return from_tid }
            return tp_get_sname(sv.tp_id)
        }
        i = i - 1
    }
    ""
}

pub fn get_struct_field_closure_sig(struct_name: Str, field_name: Str) -> Str {
    let mut i = 0
    while i < sf_closure_sigs.len() {
        let e = sf_closure_sigs.get(i).unwrap()
        if e.struct_name == struct_name && e.field_name == field_name {
            return e.sig
        }
        i = i + 1
    }
    ""
}

pub fn build_closure_sig_from_type_ann(ta: Int) -> Str {
    let ret_name = node_return_type(ta)
    let ret_type = type_from_name(ret_name)
    let elems_sl = node_elements(ta)
    let mut sig_params = "const blink_closure*"
    if elems_sl != -1 && sublist_length(elems_sl) > 0 {
        let mut i = 0
        while i < sublist_length(elems_sl) {
            let elem = sublist_get(elems_sl, i)
            let ename = node_name(elem)
            sig_params = sig_params.concat(", ")
            if is_enum_type(ename) != 0 || is_struct_type(ename) != 0 {
                let mono = ann_mono_c_type(elem)
                sig_params = sig_params.concat(if mono != "" { mono } else { c_type_c_name(ename) })
            } else if ename == "Tuple" {
                sig_params = sig_params.concat(tuple_c_name_from_ann(elem, "void"))
            } else {
                sig_params = sig_params.concat(c_type_str(type_from_name(ename)))
            }
            i = i + 1
        }
    }
    let mut ret_str = resolve_ret_type_from_ann(ta)
    if ret_str == "" {
        ret_str = c_type_str(ret_type)
        if is_struct_type(ret_name) != 0 || is_enum_type(ret_name) != 0 {
            let ret_mono = ann_mono_c_type(node_type_ann(ta))
            ret_str = if ret_mono != "" { ret_mono } else { c_type_c_name(ret_name) }
        }
    }
    "{ret_str}(*)({sig_params})"
}

pub fn is_generic_fn(name: Str) -> Int {
    generic_fns_by_name.contains_key(name)
}

pub fn get_generic_fn_node(name: Str) -> Int {
    match generic_fns_by_name.get(name) {
        Some(v) => { return v }
        None => {}
    }
    -1
}

// Resolves the callee's params sublist for a Blink-name lookup, preferring
// the generic-fn registry (templates) before the concrete-fn registry.
// Returns -1 when the name is unknown to both registries OR the looked-up
// node id is -1 (since node_params(-1) panics). Asymmetry note:
// is_fn_registered may return 1 while get_fn_node returns -1, so callers
// must always treat -1 as "no usable params" rather than reading from it.
pub fn get_callee_params_sl(fn_name: Str) -> Int {
    if is_generic_fn(fn_name) != 0 {
        let gfn = get_generic_fn_node(fn_name)
        if gfn != -1 {
            return node_params(gfn)
        }
        return -1
    }
    if is_fn_registered(fn_name) != 0 {
        let cfn = get_fn_node(fn_name)
        if cfn != -1 {
            return node_params(cfn)
        }
    }
    -1
}

// Slot contradictions seen by merge_arg_tids: two DIFFERENT tid NUMBERS offered for one slot of one
// (base, args) key. Not unreachable, and the count alone cannot be triaged, because two unrelated
// mechanisms land on it and they are told apart only by comparing the two tids STRUCTURALLY, never
// by their numbers and never by the `args` spelling:
//
//   - two handles on the SAME type, from a compound built over a metavar that bound later and so
//     was never re-keyed. Harmless: either tid lowers identically.
//   - two DIFFERENT types sharing one non-injective `args` segment (`Set[Int]`, `Set[Str]` and
//     `Set[Point]` all spell the bare segment "Set"). Sharing one entry is CORRECT when the segment
//     is representation-keyed, since all three are blink_set* and share one C symbol. What must not
//     happen is a consumer reading per-instantiation IDENTITY off such a slot;
//     tc_tid_seg_injective is the predicate that gates that.
//
// The tie-break between conflicting tids is arbitrary: rebuilding the corpus with `max` instead of
// `min` emits byte-identical C, so no conflicting slot is load-bearing today. That is a statement
// about today's corpus, not a guarantee.
pub let mut mono_arg_tid_conflicts: Int = 0
// Arity disagreements between two populated lists for one key. Must read zero: arg_tids are
// positionally aligned with the `args` CSV segments and `args` is half the dedup key, so one key
// cannot disagree on arity even when it is non-injective about segment CONTENT.
pub let mut mono_arg_tid_arity_conflicts: Int = 0

// One recorded slot contradiction, awaiting CLASSIFICATION by a reader that can spell tids
// (tc_classify_mono_conflicts, in typecheck.bl). Telling the two mechanisms above apart requires
// comparing the tids structurally, which merge_arg_tids may not do: it sits BELOW typecheck in the
// DAG and its purity is a requirement. So it records the raw pair here — Int/Str data only, no tid
// accessor reached — and typecheck classifies.
pub type MonoSlotConflict {
    base: Str
    args: Str
    slot: Int
    stored: Int
    incoming: Int
}
// Drained by tc_classify_mono_conflicts at the end of generate(). Bounded by the number
// of contradictions, which is 31 across the whole 700-fixture corpus.
pub let mut mono_slot_conflicts: List[MonoSlotConflict] = []
// Classification results, filled by tc_classify_mono_conflicts. `same_type` is the interning
// artefact: both tids denote one type, so either lowers identically. `diff_type` is the
// load-bearing one — one key genuinely collapsed two DIFFERENT types, so a single stored tid
// cannot be per-instantiation identity for both. Nonzero `diff_type` is not automatically a bug
// (the collapse is correct for a representation-keyed segment), but it is exactly the population a
// tid-authoritative consumer must not read identity out of.
pub let mut mono_slot_conflicts_same_type: Int = 0
pub let mut mono_slot_conflicts_diff_type: Int = 0

// The subset of `diff_type` that is an actual DECISIONS.md:343 violation, and the only
// one of these three counters with a real floor of 0.
//
// `diff_type` cannot be asserted == 0 because the collapse is CORRECT whenever the key is
// representation-keyed: Set[Int] and Set[Str] are both blink_set*, share one C symbol, and
// must therefore share one registry entry. This counts only the conflicts where BOTH tids'
// segments NAME their own type arguments (tc_tid_seg_injective) — two genuinely distinct
// instantiations that the key nevertheless collapsed.
//
// tc_tid_seg_injective is consulted here purely as an ADJUDICATOR of a conflict that
// already happened. Its header forbids using it as a GATE to degrade a slot, and this is
// not that.
//
// Limit: only conflicts registered within ONE compilation unit are visible. Cross-TU
// collapse does not reach this counter.
pub let mut mono_slot_conflicts_diff_type_injective: Int = 0

// Decl/def signature drift at a mono-fn's TWO independent C emission sites (declaration
// vs definition body). Both derive `args` from the same `arg_tids` snapshot
// key, but the snapshot itself can be TAKEN at two different times: the body pass runs
// during the main flush and the decl pass runs later, after further registrations may
// have upgraded (merge_arg_tids) the stored arg_tids for that same key. A later upgrade
// changing a -1 slot to a concrete tid is expected and harmless AS LONG AS the rendered
// CSV segment is unchanged (an upgrade that only fills a hole `tc_seg_from_tid` already
// read as "" for both tids). `mono_fn_decl_tid_drift` counts every such benign case.
pub let mut mono_fn_decl_tid_drift: Int = 0
// The violation: the upgrade changed the RENDERED CSV segment between the two sites, so
// the emitted declaration and definition disagree on a parameter's mangled type — the
// `cc: conflicting types` failure. Must read 0 corpus-wide; see the
// snapshot machinery in codegen_stmt.bl (mono_fn_body_tids) for how it is measured.
pub let mut mono_fn_decl_seg_drift: Int = 0

// The LATTICE JOIN of two arg_tids lists for the same (base, args) key. Both register fns dedup on
// that key, so without a join the loser's arg_tids is discarded and EMISSION ORDER decides what the
// def side gets — decisions/compiler-type-representation.md:47 requires the stored payload to be a
// function of the SET of registrations, not their order.
//
// It must be a join, not a compare-and-replace: "take whichever list is more concrete" has no answer
// for stored [t1,-1] against incoming [-1,t2], so first-arrival would win on exactly the case that
// matters. Element-wise join answers [t1,t2].
//
// Per slot: bottom = -1, every concrete tid an incomparable atom. Per list: bottom = [], and every
// populated list is strictly above it INCLUDING an all- -1 list, because arity is information —
// mono_arg_tids_with_ann fills -1 HOLES, so [] is unrecoverable even with a tid-bearing annotation
// in hand while [-1] is recoverable. Every other consumer treats an out-of-range slot and a -1 slot
// identically.
//
// PURITY IS A REQUIREMENT: Int/List[Int]/Str arithmetic only, reaching no tid accessor, because this
// sits BELOW typecheck in the DAG. The predicate may only ask "is this slot -1?", never "is this tid
// encodable?".
pub fn merge_arg_tids(stored: List[Int], incoming: List[Int], base: Str, args: Str) -> List[Int] {
    if incoming.len() == 0 { return stored }
    if stored.len() == 0 {
        dbg_trace("monodedup", "upgrade base={base} args={args} stored=[] incoming=len{incoming.len()} merged=incoming")
        return incoming
    }
    let mut width = stored.len()
    if stored.len() != incoming.len() {
        mono_arg_tid_arity_conflicts = mono_arg_tid_arity_conflicts + 1
        dbg_trace("monodedup", "arity-conflict base={base} args={args} stored=len{stored.len()} incoming=len{incoming.len()}")
        // Resolve by LENGTH, never by arrival order — otherwise the tie-break reintroduces
        // the order dependence this whole function exists to remove. But take only the
        // ARITY from the longer list, not its contents: the longer list can hold a -1
        // where the shorter holds a concrete tid, and returning it whole would DEGRADE
        // that slot. The overlap is joined element-wise below, with a missing slot read
        // as the per-slot bottom (-1), which is what makes this branch a join too.
        if incoming.len() > width { width = incoming.len() }
    }
    let mut out: List[Int] = []
    let mut upgraded = 0
    let mut i = 0
    while i < width {
        let s = arg_tid_slot(stored, i)
        let n = arg_tid_slot(incoming, i)
        if s == n {
            out.push(s)
        } else if s < 0 {
            upgraded = 1
            out.push(n)
        } else if n < 0 {
            out.push(s)
        } else {
            // Both concrete and different. Not a degradation — either the two tids are two
            // handles on the SAME type (a compound built over a metavar that later bound is
            // not re-keyed) or the CSV
            // segment collapsed two DIFFERENT types. Which one cannot be decided here: it
            // takes a structural comparison of the two tids, and this fn may not spell a
            // tid. Record the pair for tc_classify_mono_conflicts and keep going; the fix
            // for either is at the TID SOURCE or the KEY, never here.
            mono_arg_tid_conflicts = mono_arg_tid_conflicts + 1
            mono_slot_conflicts.push(MonoSlotConflict { base: base, args: args, slot: i, stored: s, incoming: n })
            dbg_trace("monodedup", "slot-conflict base={base} args={args} slot={i} stored={s} incoming={n}")
            // `min` purely so the join stays commutative and associative; a join is what
            // makes the result a function of the registration SET. DO NOT TUNE THIS — the
            // choice is measured to be C-neutral, so tuning it can only ever look like it
            // fixed something.
            out.push(if s < n { s } else { n })
        }
        i = i + 1
    }
    if upgraded != 0 {
        if dbg_channel_on("monodedup") != 0 {
            dbg_trace("monodedup", "upgrade base={base} args={args} stored={arg_tids_dbg(stored)} incoming={arg_tids_dbg(incoming)} merged={arg_tids_dbg(out)}")
        }
    }
    out
}

// A slot of an arg_tids list, with an out-of-range index reading as the per-slot bottom.
// Only merge_arg_tids' arity-conflict branch can index past a list's end, and treating the
// missing slot as -1 is what keeps that branch a join rather than a replacement.
fn arg_tid_slot(t: List[Int], i: Int) -> Int {
    if i < t.len() { return t.get(i).unwrap() }
    -1
}

pub fn arg_tids_differ(a: List[Int], b: List[Int]) -> Bool {
    if a.len() != b.len() { return true }
    let mut i = 0
    while i < a.len() {
        if a.get(i).unwrap() != b.get(i).unwrap() { return true }
        i = i + 1
    }
    false
}

fn arg_tids_dbg(t: List[Int]) -> Str {
    let mut s = "["
    let mut i = 0
    while i < t.len() {
        if i > 0 { s = s.concat(",") }
        s = s.concat("{t.get(i).unwrap()}")
        i = i + 1
    }
    s.concat("]")
}

pub fn register_mono_fn(base: Str, args: Str, arg_tids: List[Int]) ! Codegen.Register {
    let mut i = 0
    while i < mono_fns.len() {
        let mf = mono_fns.get(i).unwrap()
        if mf.base == base && mf.args == args {
            // Not a bare `return`: discarding the incoming arg_tids here would let registration
            // order decide what the def side got.
            mono_fns.set(i, MonoFnInstance { base: mf.base, args: mf.args, arg_tids: merge_arg_tids(mf.arg_tids, arg_tids, base, args) })
            return
        }
        i = i + 1
    }
    mono_fns.push(MonoFnInstance { base: base, args: args, arg_tids: arg_tids })
}

fn infer_closure_param_type(sig: Str, param_idx: Int) -> Int {
    if sig == "" { return CT_VOID }
    let star_pos = sig.index_of("*)")
    if star_pos < 0 { return CT_VOID }
    let params_start = star_pos + 2
    let close_pos = sig.len() - 1
    if params_start >= close_pos { return CT_VOID }
    let params_str = sig.substring(params_start + 1, close_pos - params_start - 1)
    let parts = params_str.split(", ")
    let actual_idx = param_idx + 1
    if actual_idx >= parts.len() { return CT_VOID }
    let ctype = parts.get(actual_idx).unwrap()
    ct_from_c_type(ctype)
}

fn infer_closure_ret_type(sig: Str) -> Int {
    if sig == "" { return CT_VOID }
    let paren_pos = sig.index_of("(")
    if paren_pos <= 0 { return CT_VOID }
    let ret_str = sig.substring(0, paren_pos)
    ct_from_c_type(ret_str)
}

fn ct_from_c_type(ctype: Str) -> Int {
    if ctype == "int64_t" { CT_INT }
    else if ctype == "double" { CT_FLOAT }
    else if ctype == "const char*" { CT_STRING }
    else if ctype == "int" { CT_BOOL }
    else if ctype == "blink_list*" { CT_LIST }
    else if ctype == "blink_map*" { CT_MAP }
    else if ctype == "blink_set*" { CT_SET }
    else { CT_VOID }
}

pub fn type_name_from_ct(ct: Int) -> Str {
    if ct == CT_INT { "Int" }
    else if ct == CT_FLOAT { "Float" }
    else if ct == CT_BOOL { "Bool" }
    else if ct == CT_STRING { "Str" }
    else if ct == CT_LIST { "List" }
    else if ct == CT_ITERATOR { "Iterator" }
    else if ct == CT_HANDLE { "Handle" }
    else if ct == CT_CHANNEL { "Channel" }
    else if ct == CT_MAP { "Map" }
    else if ct == CT_SET { "Set" }
    else if ct == CT_BYTES { "Bytes" }
    else if ct == CT_STRINGBUILDER { "StringBuilder" }
    else if ct == CT_PTR { "Ptr" }
    else if ct == CT_CLOSURE { "Fn" }
    else if ct == CT_HANDLER { "Handler" }
    else if ct == CT_I8 { "I8" }
    else if ct == CT_I16 { "I16" }
    else if ct == CT_I32 { "I32" }
    else if ct == CT_U8 { "U8" }
    else if ct == CT_U16 { "U16" }
    else if ct == CT_U32 { "U32" }
    else if ct == CT_U64 { "U64" }
    else if ct == CT_CHAR { "Char" }
    // Ten CTs reach this bare else — CT_VOID, CT_OPTION, CT_RESULT, CT_TAGGED_ENUM,
    // CT_INSTANT, CT_DURATION, CT_FFI_SCOPE, CT_TEMPLATE, CT_STRUCT and CT_ENUM — and
    // "Void" is NOT an erasure sentinel for them, because several CONSUMERS depend on this
    // exact string as a load-bearing dispatch signal, not as a type name:
    //   codegen_methods.bl's list-HOF guard (`if elem_name != "Void"`) uses it to exclude a
    //     struct/enum element from the stdlib path — and says so in its own comment.
    //   codegen_closures.bl / codegen_methods.bl / codegen_expr.bl compare a closure or
    //     method return name against "Void" to decide void-return lowering.
    // This arm stays. Erasure in a type-arg CSV is a DIFFERENT question from "what do I call
    // this CT", and it is answered by type_arg_name_from_ct below. Changing this else
    // would silently disarm ~16 guards
    // across four modules that have nothing to do with monomorphization.
    else { "Void" }
}

// The TYPE-ARGUMENT spelling of a CT, for the mono-CSV producers only — which since
// means infer_struct_type_args alone, the fn-call twin having been deleted
// with the rest of the string CSV. Same answers as
// type_name_from_ct for every CT that HAS a name; the difference is what it says when
// there is none.
//
// type_name_from_ct answers "Void" both for a genuine CT_VOID and for nine CTs
// it simply cannot name. In a type-arg CSV those two are opposites — the first is a real
// type argument that must lower, the second is an ERASURE that must fail closed — and
// collapsing them is what made a genuine `Box[Void]` raise I0001 while
// `blink_GKV_Void_Void` compiled and linked silently. Splitting them HERE rather than in
// type_name_from_ct keeps the blast radius inside the mono machinery, which is the only
// audience that reads these strings as type arguments.
//
// Structured as "delegate, then disambiguate the one ambiguous answer" on purpose: every
// real arm is inherited automatically, so a CT that gains a name in type_name_from_ct
// gains it here too, and this function cannot drift out of sync with it.
pub fn type_arg_name_from_ct(ct: Int) -> Str {
    let name = type_name_from_ct(ct)
    if name != "Void" {
        return name
    }
    // A GENUINE Void type argument. Void is "an ordinary INHABITED, encodable type"
    // (decisions/under-determined-types.md:39, 6-0), so it is spelled, not refused — this
    // is the arm that makes `Box[Void]` compile, and the string path's answer here
    // byte-matches the tid path's tc_tid_to_c_tag TyKind.Void arm.
    if ct == CT_VOID {
        return "Void"
    }
    // Genuinely unnameable: no arm exists and none is inherited. Answer with a sentinel that
    // is greppable and that cannot be confused with a real type's name the way "Void" was.
    // The LOCATED I0001 is raised downstream by the chokepoints that have a node
    // (mono_args_has_void_seg, resolve_mono_slot), both of which detect it via
    // diag_is_ice_seg — the chokepoints, NOT the spelling, are the guarantee. The sentinel
    // is a legal C identifier, so an escape into a mangled symbol name would be silent; see
    // the header comment in src/diagnostics.bl.
    ICE_SEG_ERASED_SLOT
}

// Escapes a single mangle_generic_name segment (the base, or one comma-split `args` segment) so
// that joining segments is INJECTIVE. Plain concatenation with "_" collapses distinct (base, args)
// pairs the moment either side contains an underscore: ("A","B,C,D"), ("A_B","C,D"), ("A","B_C,D")
// and ("A","B,C_D") all join to "A_B_C_D".
//
// The scheme: escape a literal "_" to "_1", and join segments with "_0". A single "_" byte in the
// output is then always followed by "0" (separator) or "1" (one escaped literal), so decoding never
// reasons about run lengths. Doubling the underscore and joining with a bare "_" was tried and is
// NOT injective across a segment boundary — mangle("Box_", "Int") and mangle("Box", "_Int") both
// give "Box___Int", two different splits of the same 3-run. Length-prefixing is injective too, with
// the same "changes every name" cost and no offsetting advantage. Renaming only the colliding
// segment is not a pure function of (base, args), which breaks
// decisions/generic-mono-ownership-per-module.md:74-79: two modules instantiating the same generic
// must mangle it identically or the linker cannot merge the two TUs' copies.
//
// Pure Str arithmetic only — this sits below typecheck in the DAG, the same constraint
// merge_arg_tids documents above.
pub fn escape_mono_seg(s: Str) -> Str {
    if s.index_of("_") < 0 {
        return s
    }
    let mut result = ""
    let mut i = 0
    while i < s.len() {
        if s.byte_at(i) == 95 { // '_'
            result = result.concat("_1")
        } else {
            result = result.concat(s.substr(i, 1))
        }
        i = i + 1
    }
    result
}

pub fn mangle_generic_name(base: Str, args: Str) -> Str {
    let mut result = escape_mono_seg(base)
    let mut i = 0
    let mut _seg_start = 0
    while i <= args.len() {
        if i == args.len() || args.byte_at(i) == 44 { // ','
            let seg = args.substr(_seg_start, i - _seg_start)
            result = result.concat("_0").concat(escape_mono_seg(seg))
            _seg_start = i + 1
        }
        i = i + 1
    }
    result
}

/// Compute the mangled C name for an impl method.
/// The trait name is part of the symbol so two traits that define the same
/// method for one type (§3c rule-3) get distinct symbols and the qualified
/// escape hatch `Trait.method(x)` can select between them.
///
/// From/TryFrom are excepted: they are one trait with many source-typed
/// instances (`From[I8] for Int`, `From[I16] for Int`, ...), already
/// disambiguated by the source type via their own def+call path
/// (mangle_from_method). Routing them through the trait-qualified form would
/// collide (all share trait `From`, method `from`), so they keep their proven
/// `{target}_{method}_{source}` scheme.
pub fn mangle_impl_method(im: Int, impl_type: Str, mname: Str) -> Str {
    let trait_name = node_trait_name(im)
    if trait_name == "From" || trait_name == "TryFrom" {
        let trait_tparams = node_type_params(im)
        if trait_tparams != -1 && sublist_length(trait_tparams) > 0 {
            let src = node_name(sublist_get(trait_tparams, 0))
            return mangle_from_method(src, impl_type, mname)
        }
    }
    mangle_impl_method_q(impl_type, trait_name, mname)
}

// Symbol builder keyed on the resolved trait name. Call sites that know the
// trait (qualified calls; unqualified calls after impl_trait_for_method) build
// the symbol through this; `mangle_impl_method` is the impl-node wrapper.
// Not for From/TryFrom (see mangle_impl_method).
pub fn mangle_impl_method_q(impl_type: Str, trait_name: Str, mname: Str) -> Str {
    "{impl_type}_{trait_name}_{mname}"
}

pub fn mangle_from_method(source: Str, target: Str, mname: Str) -> Str {
    "{target}_{mname}_{source}"
}

pub fn register_mono_instance(base: Str, args: Str, arg_tids: List[Int]) -> Str ! Codegen.Register {
    register_mono_instance_ann(base, args, arg_tids, -1)
}

// register_mono_instance plus the source annotation node, for the one producer that
// cannot compute arg_tids itself (see MonoInstance.ann). On a dedup hit an incoming
// annotation is ATTACHED to the existing entry when that entry has none: registration
// order is not controlled, so the tid-bearing annotation may well arrive second, and
// dropping it would leave the def side with the same all- -1 slots this exists to fix.
//
// The incoming arg_tids is JOINED into the existing entry in that SAME lookup, or registration
// order would decide the def side's slots. This deliberately does NOT sit under an
// `ann != -1` guard: every tid-BEARING producer
// arrives through register_mono_instance with ann == -1, and it is precisely those that must
// be able to upgrade a degraded entry. `ann` keeps its own fill-a-hole rule, which is sound
// for a single node id because two annotations naming one instance memoize the same interned
// tid (that residual "first non- -1 wins" is recorded on the ticket as benign).
pub fn register_mono_instance_ann(base: Str, args: Str, arg_tids: List[Int], ann: Int) -> Str ! Codegen.Register {
    let idx = lookup_mono_instance_idx(base, args)
    if idx != -1 {
        // update the entry the injective mono_idx lookup ALREADY found, rather
        // than re-deriving it through mangle_generic_name's c_name (the old mono_rev_idx
        // detour). c_name is not guaranteed injective before the escape fix in
        // mangle_generic_name, and even after it, re-deriving an index through a second
        // map is a needless indirection this dedup hit has no reason to take.
        let m = mono_instances.get(idx).unwrap()
        let merged = merge_arg_tids(m.arg_tids, arg_tids, base, args)
        let keep_ann = if m.ann == -1 { ann } else { m.ann }
        // The overwhelmingly common dedup hit is a second identical registration
        // (ann == -1, same arg_tids), where the join is the identity — skip the
        // rewrite so a repeated struct literal does not rebuild the entry.
        if keep_ann != m.ann || arg_tids_differ(merged, m.arg_tids) {
            mono_instances.set(idx, MonoInstance { base: m.base, args: m.args, c_name: m.c_name, arg_tids: merged, ann: keep_ann })
        }
        return m.c_name
    }
    // The C symbol is built off the PHYSICAL base (module-prefixed for a
    // cross-module generic struct), and so is the dedup key — else two modules'
    // `Box[Int]` (bare-equal base+args) would merge to one entry. The
    // logical `base` is still stored for find_type_def / field-resolution. For fns
    // and same-module structs phys_base == base, so both the symbol and the key are
    // byte-identical to before.
    let phys_base = mono_phys_base(base)
    let c_name = mangle_generic_name(phys_base, args)
    // tripwire: a newly minted c_name that already names a DIFFERENT
    // (base, args) entry would be a mangle_generic_name collision slipping through the
    // escape fix. Checked via the same linear scan lookup_mono_base uses; a reverse index keyed
    // on the c_name cannot answer it correctly. Must read 0 corpus-wide.
    let prior = lookup_mono_base(c_name)
    if prior.base != "" {
        mono_cname_collisions = mono_cname_collisions + 1
        dbg_trace("monodedup", "cname-collision c_name={c_name} new_base={base} new_args={args} existing_base={prior.base} existing_args={prior.args}")
    }
    mono_idx.insert(phys_base.concat("\t").concat(args), mono_instances.len())
    mono_instances.push(MonoInstance { base: base, args: args, c_name: c_name, arg_tids: arg_tids, ann: ann })
    c_name
}

pub type MonoLookup {
    base: Str
    args: Str
    arg_tids: List[Int]
}

// Linear scan on c_name, first match wins. NOT a map keyed on mangle_generic_name's output,
// which is not guaranteed injective independent of the escape fix in mangle_generic_name (two
// different (base, args) registrations could in principle mangle to the same c_name — the escape
// fix makes that far rarer but a linear scan is the only form that CANNOT itself introduce
// a second non-injective index on top of the fix). Mirrors register_mono_fn's existing
// linear-scan precedent (:4349) instead of adding a second, differently-shaped registry
// design. Measured cost: see task ci-profile; is_mono_struct_instance is the warm-ish
// caller.
pub fn lookup_mono_base(c_name: Str) -> MonoLookup {
    let mut i = 0
    while i < mono_instances.len() {
        let m = mono_instances.get(i).unwrap()
        if m.c_name == c_name {
            return MonoLookup { base: m.base, args: m.args, arg_tids: m.arg_tids }
        }
        i = i + 1
    }
    MonoLookup { base: "", args: "", arg_tids: [] }
}

pub fn find_type_def_node(name: Str) -> Int {
    let types_sl = node_fields(cg_program_node)
    if types_sl == -1 {
        return -1
    }
    let mut i = 0
    while i < sublist_length(types_sl) {
        let td = sublist_get(types_sl, i)
        if node_name(td) == name {
            return td
        }
        i = i + 1
    }
    -1
}

// Does the struct/enum DEFINITION declare type parameters? A generic base whose tid carries no
// args (the population gap) is indistinguishable from a non-generic type by mono-name alone —
// both decline — so a tid-first name reader must consult the def to know it may NOT spell the
// bare base (Inner) where only the flat channel holds the mono name (Inner_0Int).
pub fn struct_def_is_generic(name: Str) -> Int {
    let td = find_type_def_node(name)
    if td == -1 { return 0 }
    let tp = node_type_params(td)
    if tp == -1 { return 0 }
    if sublist_length(tp) > 0 { return 1 }
    0
}

// Build a mono struct name from a generic-struct type annotation.
// Returns the mangled name (e.g. "Box_Int") if `base_name` is a generic
// user-defined type and `ann_node` carries its type-arg annotations.
// Returns "" if `base_name` isn't generic or the annotation lacks type args.
pub fn mono_name_from_ann(base_name: Str, ann_node: Int, tparams_sl: Int, segs: List[Str]) -> Str {
    let td = find_type_def_node(base_name)
    if td == -1 { return "" }
    let td_tparams = node_type_params(td)
    if td_tparams == -1 || sublist_length(td_tparams) == 0 { return "" }
    if ann_node == -1 { return "" }
    let elems = node_elements(ann_node)
    if elems == -1 || sublist_length(elems) == 0 { return "" }
    let mut mono_args = ""
    let mut ai = 0
    while ai < sublist_length(elems) {
        let elem = sublist_get(elems, ai)
        let raw_name = node_name(elem)
        let resolved_arg = resolve_tparam_seg(raw_name, tparams_sl, segs)
        // An arg annotation that itself carries structure must spell its own full stem,
        // not the flat head resolve_tparam_seg yields: the head names a C type that is
        // never typedef'd. Two such args, and both diverge from the tid-native
        // tc_tid_struct_mono_name / register_struct_instance_from_tid that the
        // construction+typedef side uses. resolved_arg (bare head / substituted
        // concrete) stays the fallback for both.
        let mut arg_seg = resolved_arg
        // A TUPLE arg (`GT[(Int, Int)]`) flattens to "Tuple", and neither arm below can
        // pick it up: type_from_name("Tuple") is CT_VOID and is_struct_type("Tuple") is
        // 0, because only the mangled Tuple2_int_int is ever registered
        // (ensure_tuple_type). resolve_tuple_ann spells it and registers that typedef as
        // an idempotent side effect — the same delegation resolve_ann_tag makes,
        // except that this call passes the mono context, as the struct recursion below
        // does: resolve_tuple_tag's context-free -1/[] would decline a tuple whose
        // elements are typevars instead of resolving them. Keyed on the RAW name,
        // matching resolve_tuple_ann — a typevar already substituted to a tuple
        // arrives as the mangled tag and needs no recursion. Left flat, the name diverges
        // from the tid path's GT_Tuple2_int_int, and as a carrier payload the field
        // ERASES to `void ok`.
        if raw_name == "Tuple" {
            let tup = resolve_tuple_ann(elem, tparams_sl, segs)
            if tup.is_some() { arg_seg = tup.unwrap() }
        } else if (is_struct_type(resolved_arg) != 0 || is_enum_type(resolved_arg) != 0) {
            // A NESTED generic-struct-instance arg (`Box[Box[Int]]` → outer arg
            // `Box[Int]`) recurses for its own stem (Box_Int); a flat `Box` is one level
            // short and names a type that is never typedef'd.
            let nested = mono_name_from_ann(strip_module_qualifier(resolved_arg), elem, tparams_sl, segs)
            if nested != "" { arg_seg = nested }
        }
        if ai > 0 {
            mono_args = mono_args.concat(",")
        }
        mono_args = mono_args.concat(arg_seg)
        ai = ai + 1
    }
    // PHYSICAL base so this C-symbol producer byte-matches register_mono_instance's
    // c_name for a cross-module instance (the carrier/typedef-order consumers feed
    // the result to c_type_c_name); no-op for fn/same-module bases.
    mangle_generic_name(mono_phys_base(base_name), mono_args)
}

// An Option/Result carrier over a generic-struct INSTANCE inner (`Option[QBox[Int]]`) must spell its
// value member with the mono stem (QBox_Int), not the bare head — else the typedef emitter emits an
// undeclared `blink_QBox*` member and mints a divergent bare `blink_Option_QBox` carrier alongside
// the tid path's `blink_Option_QBox_Int`.
//
// Computes that stem for `inner_ann` AND registers the instance, so is_mono_struct_instance
// recognizes the tag when the carrier typedef emits its member. Registration is annotation-driven
// because codegen_types cannot reach the tid accessors (typecheck imports it, not the reverse); a
// nested generic-instance arg is registered inner-first, since its typedef must precede the outer
// one that names it. Returns "" when inner_name is not a generic instance, and the caller then keeps
// its bare-head spelling.
//
// With no tid reachable, this stores the SOURCE ANNOTATION alongside all- -1 arg_tids
// (MonoInstance.ann) and the def-side emitter recovers the real slots from it above typecheck. Do
// not "fix" the -1s by parsing the concrete_args string: that resolver was deleted, and reinstating
// it is what decisions/compiler-type-representation.md step 4 forbids.
pub fn register_carrier_inner_mono_instance(inner_name: Str, inner_ann: Int) -> Str ! Codegen.Register {
    let base = strip_module_qualifier(inner_name)
    let td = find_type_def_node(base)
    if td == -1 { return "" }
    let td_tparams = node_type_params(td)
    if td_tparams == -1 || sublist_length(td_tparams) == 0 { return "" }
    if inner_ann == -1 { return "" }
    let elems = node_elements(inner_ann)
    if elems == -1 || sublist_length(elems) == 0 { return "" }
    let mut args = ""
    let mut arg_tids: List[Int] = []
    let mut ai = 0
    while ai < sublist_length(elems) {
        let elem = sublist_get(elems, ai)
        let raw_name = node_name(elem)
        let resolved = resolve_tparam_seg(raw_name, -1, [])
        let mut arg_seg = resolved
        // A tuple arg spells its mangled stem, exactly as mono_name_from_ann's arm does
        // and for the same reason: the bare head "Tuple" is neither a
        // compound CT nor a registered struct, so leaving it flat REGISTERS a second
        // divergent instance (`GT_Tuple`) alongside the tid path's GT_Tuple2_int_int —
        // one Blink type, two C typedefs, exit 0. resolve_tuple_tag is resolve_tuple_ann
        // with no mono context, which is all this loop has: its resolve_tparam_seg call
        // above passes -1/[] for the same reason (no tid or mono state is reachable from
        // codegen_types — see this function's header).
        if raw_name == "Tuple" {
            let tup = resolve_tuple_tag(elem)
            if tup != "" { arg_seg = tup }
        } else if is_struct_type(resolved) != 0 || is_enum_type(resolved) != 0 {
            // A nested generic-instance arg (`QBox[QBox[Int]]`) registers inner-first and
            // reuses its own full mono stem, matching mono_name_from_ann's recursion.
            let nested = register_carrier_inner_mono_instance(resolved, elem)
            if nested != "" { arg_seg = nested }
        }
        if ai > 0 { args = args.concat(",") }
        args = args.concat(arg_seg)
        // No tid is computable HERE: codegen_types sits below typecheck in the module
        // DAG, so the tid accessors are out of reach. Registering the source annotation
        // (below) hands the def-side emitter the node whose memoized instance tid it can
        // read for itself — see MonoInstance.ann. The def side canNOT recover the slot from the
        // concrete_args STRING: that resolver is gone, and assuming otherwise erases these
        // fields to `void`.
        arg_tids.push(-1)
        ai = ai + 1
    }
    register_mono_instance_ann(base, args, arg_tids, inner_ann)
}

// Concrete type-args CSV for a struct instance whose enclosing value context
// names it with type arguments (e.g. `let b: GKV[Int, Str] = GKV { .. }`, or a
// call arg `f(GKV { .. })` where f's param is `GKV[Int, Str]`). Each argument
// name is resolved through the current fn's mono context so a nested
// `GKV[T, Str]` inside a generic fn picks up T's concrete binding. Returns ""
// when no in-scope annotation names this struct with the right arity.
//
// Prefers cg_expect_arg_ann (the call-arg/struct-field context) over cg_let_target_ann, mirroring
// resolve_ctor_kops_elem: a struct literal nested inside a CALL ARG leaves the OUTER let's
// cg_let_target_ann set, so keying off it alone would stamp the outer instantiation onto the inner
// literal. The arity check guards against a same-named-but-different-shape annotation and a
// malformed target. At the STRUCT-FIELD site the qualifier no longer holds — the field loop
// retargets cg_let_target_ann to the field's own annotation — but the preference order still
// matters for the call-arg case.
//
// Lets emit_struct_lit monomorphize a struct built from an empty container
// field (Map()/Set()) — whose element type can't be inferred from field VALUES
// — off the declared target, so the container ctor selects the right kops
// vtable instead of the erased-typevar string default.
pub fn struct_concrete_args_from_target(sname: Str, segs: List[Str]) -> Str {
    let td = find_type_def_node(sname)
    if td == -1 { return "" }
    let td_tparams = node_type_params(td)
    if td_tparams == -1 { return "" }
    let nparams = sublist_length(td_tparams)
    if nparams == 0 { return "" }
    let mut ann = -1
    if cg_expect_arg_ann != -1 && strip_module_qualifier(node_name(cg_expect_arg_ann)) == sname {
        ann = cg_expect_arg_ann
    } else if cg_let_target_ann != -1 && strip_module_qualifier(node_name(cg_let_target_ann)) == sname {
        ann = cg_let_target_ann
    }
    if ann == -1 { return "" }
    let elems = node_elements(ann)
    if elems == -1 || sublist_length(elems) != nparams { return "" }
    let mut args = ""
    let mut ai = 0
    while ai < sublist_length(elems) {
        let elem = sublist_get(elems, ai)
        // A compound arg (tuple `(Int,Str)`, `List[Int]`, `Map[..]`, `Option[..]`)
        // flattens lossily here — node_name yields only the head ("Tuple"/"List"),
        // dropping the inner types. That produces a wrong/undefined mono name and,
        // for a compound Map key, an undeclared kops symbol. Bail so these fall back
        // to field-value inference; mono tuple/struct keys are not supported here yet.
        let sub = node_elements(elem)
        if sub != -1 && sublist_length(sub) > 0 { return "" }
        // Strip module qualifiers so the mono name matches the one the field-value
        // inference path (type_name_from_ct) and field-access recovery compute for
        // the same instantiation — else `GKV_othermod.Foo_Str` vs `GKV_Foo_Str`
        // would register two divergent instances.
        let resolved = strip_module_qualifier(resolve_tparam_seg(node_name(elem), cg_mono_tparams_sl, segs))
        if ai > 0 { args = args.concat(",") }
        args = args.concat(resolved)
        ai = ai + 1
    }
    args
}

// the injective mono_idx lookup, as a raw index rather than a c_name — the
// index register_mono_instance_ann needs to update an existing entry directly, without
// re-deriving it through the non-injective c_name, which is how one instance's arg_tids ends up
// written into another's. Returns -1 on a miss.
pub fn lookup_mono_instance_idx(base: Str, args: Str) -> Int {
    // Key on the PHYSICAL base to match register_mono_instance's keying;
    // phys_base == base for fns and same-module structs, so unchanged for them.
    let key = mono_phys_base(base).concat("\t").concat(args)
    match mono_idx.get(key) {
        Some(idx) => return idx
        None => {}
    }
    -1
}

pub fn lookup_mono_instance(base: Str, args: Str) -> Str {
    let idx = lookup_mono_instance_idx(base, args)
    if idx == -1 { return "" }
    mono_instances.get(idx).unwrap().c_name
}

pub fn is_trait_type(name: Str) -> Int {
    let mut i = 0
    while i < trait_entries.len() {
        if trait_entries.get(i).unwrap().name == name {
            return 1
        }
        i = i + 1
    }
    0
}

pub fn lookup_impl_method(type_name: Str, method: Str) -> Int {
    if impl_method_idx.contains_key(type_name.concat("\t").concat(method)) { return 1 }
    let bare = strip_module_qualifier(type_name)
    if bare != type_name && impl_method_idx.contains_key(bare.concat("\t").concat(method)) { return 1 }
    0
}

// The name under which `method`'s impl is registered for receiver `type_name`:
// the qualified name if registered there, else the bare name (impls register
// under the bare `node_name(im)`). Callers mangle the C symbol from this, so a
// `mod.Type` receiver resolves to the same symbol as the bare impl.
pub fn impl_method_reg_name(type_name: Str, method: Str) -> Str {
    if impl_method_idx.contains_key(type_name.concat("\t").concat(method)) { return type_name }
    strip_module_qualifier(type_name)
}

// Count how many distinct traits define `method` for receiver `type_name`,
// and (out) capture the names of the colliding traits. Drives both symbol
// resolution (count==1 ⇒ unique owner) and the E0522 ambiguity diagnostic
// (count>=2). Iterates impl_entries, which stores trait per (trait,type) entry.
pub fn impl_traits_with_method(type_name: Str, method: Str) -> List[Str] {
    let bare = strip_module_qualifier(type_name)
    let mut out: List[Str] = []
    let mut i = 0
    while i < impl_entries.len() {
        let ie = impl_entries.get(i).unwrap()
        if ie.type_name == type_name || ie.type_name == bare {
            let mut j = 0
            while j < sublist_length(ie.methods_sl) {
                if node_name(sublist_get(ie.methods_sl, j)) == method {
                    out.push(ie.trait_name)
                    j = sublist_length(ie.methods_sl)
                } else {
                    j = j + 1
                }
            }
        }
        i = i + 1
    }
    out
}

// The unique trait that defines `method` for `type_name`, or "" if zero or
// more than one (ambiguous) own it. Unqualified call sites use this to build
// the trait-qualified C symbol; ambiguity is rejected upstream at typecheck.
pub fn impl_trait_for_method(type_name: Str, method: Str) -> Str {
    let traits = impl_traits_with_method(type_name, method)
    if traits.len() == 1 { return traits.get(0).unwrap() }
    ""
}

// Does `type_name` implement `method` specifically via `trait_name`? Lets a
// qualified call (Trait.method(x)) confirm the named trait truly owns the
// method before building the trait-qualified symbol from that name.
pub fn impl_type_implements_trait_method(type_name: Str, trait_name: Str, method: Str) -> Int {
    let traits = impl_traits_with_method(type_name, method)
    let mut i = 0
    while i < traits.len() {
        if traits.get(i).unwrap() == trait_name { return 1 }
        i = i + 1
    }
    0
}

pub fn lookup_impl_type_for_trait(trait_name: Str, type_name: Str) -> Int {
    let mut i = 0
    while i < impl_entries.len() {
        let ie = impl_entries.get(i).unwrap()
        if ie.trait_name == trait_name && ie.type_name == type_name {
            return 1
        }
        i = i + 1
    }
    0
}

// C call expression for a struct/enum's synthesized sealed `{T}_display`,
// or "" if `type_name` has no usable Display impl. The `lookup_impl_method
// == 0` clause skips synthesis when a `display` from a DIFFERENT impl block
// owns the symbol (see emit_display_fn_defs / E0731). Sole resolution point
// for "call this type's Display" — method dispatch and test-body `?` rendering
// both route through here.
pub fn synthesized_display_call(type_name: Str, value_expr: Str) -> Str {
    let disp_reg = impl_method_reg_name(type_name, "fmt")
    if lookup_impl_type_for_trait("Display", disp_reg) != 0 && lookup_impl_method(type_name, "display") == 0 {
        return "{c_fn_name(mangle_impl_method_q(disp_reg, "Display", "display"))}({value_expr})"
    }
    ""
}

// Coerce a C value expression of CT `ct` to a `const char*` C expression for
// embedding into a `%s` printf vararg. Scalars are snprintf'd into a fresh
// buffer (emitted before the return); Str passes through. Non-coercible types
// fall through unchanged (caller must guard).
pub fn coerce_to_c_str(expr: Str, ct: Int) -> Str ! Codegen.Emit {
    if ct == CT_STRING {
        return expr
    }
    if ct == CT_INT {
        let tmp = fresh_temp("_rci_")
        emit_line("char {tmp}[32]; snprintf({tmp}, 32, \"%lld\", (long long){expr});")
        return tmp
    }
    if ct == CT_FLOAT {
        let tmp = fresh_temp("_rcf_")
        emit_line("char {tmp}[64]; snprintf({tmp}, 64, \"%g\", {expr});")
        return tmp
    }
    if ct == CT_BOOL {
        return "({expr} ? \"true\" : \"false\")"
    }
    if ct == CT_CHAR {
        return "blink_char_to_str((int64_t){expr})"
    }
    expr
}

// Render a Result arm value (the panicked-on arm of an unwrap/unwrap_err, or
// the propagated err of a test-body `?`) to a `const char*` C expression for a
// `%s` printf vararg. Builtin scalars coerce directly; struct/enum arms with an
// `impl Display` render through the synthesized sealed `{T}_display`. An arm
// type with no usable Display falls back to a literal `"<TypeName>"` — this is
// intentionally non-fatal: `.unwrap()` has no Display gate (unlike test-body
// `?`, whose E0514 guarantees a Display impl exists upstream).
pub fn render_result_arm_value(ct: Int, struct_name: Str, value_expr: Str) -> Str ! Codegen.Emit {
    if ct == CT_STRING || ct == CT_INT || ct == CT_FLOAT || ct == CT_BOOL || ct == CT_CHAR {
        return coerce_to_c_str(value_expr, ct)
    }
    if struct_name != "" {
        let disp_call = synthesized_display_call(struct_name, value_expr)
        if disp_call != "" { return disp_call }
    }
    let tag = if struct_name != "" { struct_name } else { "<error>" }
    "\"<{tag}>\""
}

pub fn lookup_builtin_trait_impl(trait_name: Str, ct_type: Int) -> Int {
    let mut i = 0
    while i < builtin_trait_impls.len() {
        let bt = builtin_trait_impls.get(i).unwrap()
        if bt.trait_name == trait_name && bt.ct_type == ct_type {
            return 1
        }
        i = i + 1
    }
    0
}

// Canonical receiver name for builtin CT_* types eligible for user trait impls.
// Returns "" for cts that cannot be a trait impl receiver yet.
pub fn builtin_receiver_type_name(ct: Int) -> Str {
    if ct == CT_STRING { "Str" }
    else if ct == CT_LIST { "List" }
    else if ct == CT_MAP { "Map" }
    else if ct == CT_SET { "Set" }
    else if ct == CT_BYTES { "Bytes" }
    else if ct == CT_STRINGBUILDER { "StringBuilder" }
    else if ct == CT_TEMPLATE { "Template" }
    else if ct == CT_FLOAT { "Float" }
    else { "" }
}

pub fn find_impl_method_node(type_name: Str, method: Str) -> Int {
    let key = type_name.concat("\t").concat(method)
    match impl_method_idx.get(key) {
        Some(v) => return v
        None => {}
    }
    -1
}

// The trait-qualified twin: a qualified call `Trait.method(x)` knows which trait
// it named, and must read the return type through it, because the bare (type, method) index
// keeps only ONE of two same-named methods. Falls back to the bare lookup so a trait whose
// impl registered under a different scheme (From/TryFrom's source-typed key) is unaffected.
pub fn find_impl_method_node_q(type_name: Str, trait_name: Str, method: Str) -> Int {
    let key = type_name.concat("\t").concat(trait_name).concat("\t").concat(method)
    match impl_method_idx.get(key) {
        Some(v) => return v
        None => {}
    }
    -1
}

pub fn get_impl_method_ret_q(type_name: Str, trait_name: Str, method: Str) -> Int {
    let mq = find_impl_method_node_q(type_name, trait_name, method)
    if mq != -1 { return get_impl_method_ret_of(mq) }
    get_impl_method_ret(type_name, method)
}

pub fn get_impl_method_ret(type_name: Str, method: Str) -> Int {
    get_impl_method_ret_of(find_impl_method_node(type_name, method))
}

// The shared body: both spellings resolve a method node first, then read its return
// annotation (and, for Result/Option/List, publish the inner types through the expr_* side
// channels the callers read straight after).
pub fn get_impl_method_ret_of(m: Int) -> Int {
    if m == -1 { return CT_VOID }
    let ret_str = node_return_type(m)
    let ret_ct = type_from_name(ret_str)
    let ta = node_type_ann(m)
    if ta != -1 {
        if ret_str == "Result" {
            let elems_sl = node_elements(ta)
            if elems_sl != -1 && sublist_length(elems_sl) >= 2 {
                let ok_ann = sublist_get(elems_sl, 0)
                let err_ann = sublist_get(elems_sl, 1)
                let ok_name = node_name(ok_ann)
                let err_name = node_name(err_ann)
                expr_result_ok_type = type_from_name(ok_name)
                expr_result_err_type = type_from_name(err_name)
                if is_struct_type(ok_name) != 0 || is_enum_type(ok_name) != 0 {
                    expr_result_ok_struct = strip_module_qualifier(ok_name)
                } else {
                    expr_result_ok_struct = ""
                }
                if is_struct_type(err_name) != 0 || is_enum_type(err_name) != 0 {
                    expr_result_err_struct = strip_module_qualifier(err_name)
                } else {
                    expr_result_err_struct = ""
                }
            }
        } else if ret_str == "Option" {
            let elems_sl = node_elements(ta)
            if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
                let inner_ann = sublist_get(elems_sl, 0)
                let inner_name = node_name(inner_ann)
                let inner_t = type_from_name(inner_name)
                expr_option_inner = inner_t
                if is_struct_type(inner_name) != 0 || is_enum_type(inner_name) != 0 {
                    expr_option_inner_struct = strip_module_qualifier(inner_name)
                } else if is_compound_ct(inner_t) != 0 {
                    expr_option_inner_struct = compound_name_from_ann(inner_ann)
                } else {
                    expr_option_inner_struct = ""
                }
            }
        } else if ret_str == "List" {
            let elems_sl = node_elements(ta)
            if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
                let inner_ann = sublist_get(elems_sl, 0)
                let inner_name = node_name(inner_ann)
                let inner_t = type_from_name(inner_name)
                expr_list_elem_type = inner_t
                if is_struct_type(inner_name) != 0 || is_enum_type(inner_name) != 0 {
                    expr_list_elem_struct = strip_module_qualifier(inner_name)
                } else {
                    expr_list_elem_struct = ""
                }
            }
        }
    }
    ret_ct
}

pub fn find_from_impl(source: Str, target: Str) -> Int {
    let mut i = 0
    while i < from_entries.len() {
        let fe = from_entries.get(i).unwrap()
        if fe.source == source && fe.target == target {
            return fe.method_sl
        }
        i = i + 1
    }
    -1
}

pub fn find_tryfrom_impl(source: Str, target: Str) -> Int {
    let mut i = 0
    while i < tryfrom_entries.len() {
        let te = tryfrom_entries.get(i).unwrap()
        if te.source == source && te.target == target {
            return te.method_sl
        }
        i = i + 1
    }
    -1
}

pub fn impl_method_has_self(fn_node: Int) -> Int {
    if impl_method_self_name(fn_node) != "" {
        return 1
    }
    0
}

pub fn impl_method_self_name(fn_node: Int) -> Str {
    let params_sl = node_params(fn_node)
    if params_sl != -1 {
        let mut i = 0
        while i < sublist_length(params_sl) {
            let p = sublist_get(params_sl, i)
            let name = node_name(p)
            if name == "self" || name == "_self" {
                return name
            }
            i = i + 1
        }
    }
    ""
}

pub fn lookup_assoc_type(impl_type: Str, assoc_name: Str) -> Str {
    let mut i = 0
    while i < assoc_type_bindings.len() {
        let b = assoc_type_bindings.get(i).unwrap()
        if b.impl_type == impl_type && b.assoc_name == assoc_name {
            return b.concrete_type
        }
        i = i + 1
    }
    ""
}

pub fn resolve_self_type(ret_str: Str, impl_type: Str) -> Str {
    if ret_str == "Self" {
        return impl_type
    }
    if ret_str.starts_with("Self.") {
        let assoc_name = ret_str.substring(5, ret_str.len() - 5)
        let resolved = lookup_assoc_type(impl_type, assoc_name)
        if resolved != "" {
            return resolved
        }
    }
    ret_str
}

pub fn is_emitted_let(name: Str) -> Int {
    emitted_let_set.contains_key(name)
}

pub fn reg_module_global(name: Str) ! Codegen.Register {
    cg_module_global_set.insert(name, 1)
}

pub fn is_module_global(name: Str) -> Int {
    cg_module_global_set.contains_key(name)
}

pub fn is_emitted_fn(name: Str) -> Int {
    emitted_fn_set.contains_key(name)
}

// ── Helpers ─────────────────────────────────────────────────────────

pub fn c_type_str(ct: Int) -> Str {
    if ct == CT_INT { "int64_t" }
    else if ct == CT_FLOAT { "double" }
    else if ct == CT_BOOL { "int" }
    else if ct == CT_STRING { "const char*" }
    else if ct == CT_LIST { "blink_list*" }
    else if ct == CT_CLOSURE { "blink_closure*" }
    else if ct == CT_ITERATOR { "void*" }
    else if ct == CT_HANDLE { "blink_handle*" }
    else if ct == CT_CHANNEL { "blink_channel*" }
    else if ct == CT_MAP { "blink_map*" }
    else if ct == CT_SET { "blink_set*" }
    else if ct == CT_BYTES { "blink_bytes*" }
    else if ct == CT_INSTANT { c_type_c_name("Instant") }
    else if ct == CT_DURATION { c_type_c_name("Duration") }
    else if ct == CT_PTR { "void*" }
    else if ct == CT_FFI_SCOPE { "blink_list*" }
    else if ct == CT_STRINGBUILDER { "blink_sb*" }
    else if ct == CT_HANDLER { "void*" }
    else if ct == CT_TEMPLATE { "blink_template*" }
    else if ct == CT_I8 { "int8_t" }
    else if ct == CT_I16 { "int16_t" }
    else if ct == CT_I32 { "int32_t" }
    else if ct == CT_U8 { "uint8_t" }
    else if ct == CT_U16 { "uint16_t" }
    else if ct == CT_U32 { "uint32_t" }
    else if ct == CT_U64 { "uint64_t" }
    else if ct == CT_CHAR { "int32_t" }
    else { "void" }
}

// c_type_str for a (ct, struct name) pair, which is what a channel element is answered as
// by typecheck's tc_channel_elem_ct / tc_channel_elem_struct. CT_STRUCT covers
// both a struct and a data enum — both travel as their typedef, by value — and c_type_str
// spells everything else. One function because the three channel seams (send, recv, the
// for-in drain) must agree on the C type down to the character: the box the sender writes is
// dereferenced by the receiver, so a disagreement is undefined behaviour, not a wrong tag.
pub fn chan_elem_c_type(elem_ct: Int, elem_sname: Str) -> Str {
    if elem_ct == CT_STRUCT { return c_type_c_name(elem_sname) }
    c_type_str(elem_ct)
}

// c_type_str for a position that must have STORAGE — a struct field or an enum variant payload
// field. Identical to c_type_str except for a field whose annotation resolved to the NAME "Void",
// where `void` is a legal return type but an illegal field type (`void v;` is a hard C error).
//
// Void is an ordinary inhabited, encodable type (decisions/under-determined-types.md:39), so
// `type P { v: Void }` and `Box[T=Void]` are legal Blink and both have to lower. The placeholder is
// int64_t, matching what the Result typedef emitter already does for a Void ok/err leaf.
//
// KEYED ON THE NAME, not on the CT, which is the whole point of the second parameter: type_from_name
// collapses "Void", "" and every unknown name onto CT_VOID, so a CT-only predicate would also
// swallow an ERASED slot, turning a loud `void v;` C error into a silent int64_t field. Exactly the
// name "Void" lowers; anything else landing on CT_VOID keeps failing the C compile.
//
// The five emitters that declare a named struct/enum field route through here, and so does
// emit_tuple_typedef's scalar branch — TupleEntry carries a per-element resolved name so a tuple
// element gets the identical name-keyed lowering. Every other c_type_str caller is a return type, a
// parameter or a local, where `void` is either correct or a separate bug.
pub fn c_field_type_str(ct: Int, tname: Str) -> Str {
    // A transparent newtype (Errno) is a bare int64_t at every storage seam.
    // Boxing it here while construct/read stay flat silently loses the value and
    // emits invalid C. (Enum-payload and tuple-element seams box earlier, before
    // reaching this helper — tracked separately.)
    if is_transparent_newtype(tname) != 0 { return "int64_t" }
    if ct == CT_VOID && tname == "Void" { return "int64_t" }
    c_type_str(ct)
}

// The C type of a mut-captured local's heap cell. The cell holds a copy of the variable, so its
// type IS the variable's declared C type — and a kind whose C name needs a struct NAME or a carrier
// typedef cannot come from the CT alone, which is what made a struct / tuple / Option / Result cell
// `void*` and every use of it a void-pointer dereference in both scopes.
//
// Two seams declare that cell and they spell the same object: the declaration in the enclosing scope
// (codegen_stmt) and the rehydration at the top of the closure body (codegen_closures). They read
// this rather than deriving it apiece, so they cannot disagree. `tname` carries c_field_type_str's
// Void-position rule for the caller that has it.
//
// The tid LEADS and the flat chain below survives only where it declines. The flat chain composes
// a carrier's tag from the inner CT alone, which holds no arguments of its own — so a carrier over
// another carrier came out at depth 1 (`blink_Option_map` for an `Option[Map[Str, Int]]`), naming a
// C type no emitter typedef'd while the variable itself was declared at full depth.
//
// A cell is a STORAGE position, so a genuine `void` falls through: c_type_from_tid answers Void
// deliberately and leaves the position rule to its caller, which here is the flat chain's
// c_field_type_str tail.
//
// The flat answer is computed BEFORE the tid is consulted so the probe can report the line this
// site would otherwise have printed. Computing it only in the fallback would leave a decline here
// invisible, and a decline is the one case in which the flat spelling still governs the output —
// the number that gates deleting the flat arm.
pub fn capture_cell_c_type(tid: Int, tp_id: Int, tname: Str) -> Str {
    let flat = capture_cell_c_type_flat(tp_id, tname)
    ctype_probe_at(tid, "capture_cell", "", flat, -1)
    let spelled = c_type_from_tid(tid)
    if spelled != "" && spelled != "void" { return spelled }
    flat
}

fn capture_cell_c_type_flat(tp_id: Int, tname: Str) -> Str {
    let k = tp_get_kind(tp_id)
    if k == CT_STRUCT {
        let sn = tp_get_sname(tp_id)
        if sn != "" { return c_type_c_name(sn) }
    }
    if k == CT_OPTION {
        return option_c_type_mixed(tp_child1_kind(tp_id), tp_child1_sname(tp_id))
    }
    if k == CT_RESULT {
        return result_c_type_mixed(tp_child1_kind(tp_id), tp_child2_kind(tp_id), tp_child1_sname(tp_id), tp_child2_sname(tp_id))
    }
    c_field_type_str(k, tname)
}

/// Return the static const blink_kops table name for a Map key.
/// For built-in K types: references runtime tables like blink_kops_i64.
/// For user struct K (with @derive(Hash, Eq)): references the
/// per-type kops_<mangled> table that codegen_derive emits.
pub fn kops_table_name(ct: Int, sname: Str) -> Str {
    if ct == CT_STRING { return "blink_kops_str" }
    if ct == CT_INT { return "blink_kops_i64" }
    if ct == CT_I8 { return "blink_kops_i8" }
    if ct == CT_I16 { return "blink_kops_i16" }
    if ct == CT_I32 { return "blink_kops_i32" }
    if ct == CT_U8 { return "blink_kops_u8" }
    if ct == CT_U16 { return "blink_kops_u16" }
    if ct == CT_U32 { return "blink_kops_u32" }
    if ct == CT_U64 { return "blink_kops_u64" }
    if ct == CT_BOOL { return "blink_kops_bool" }
    if ct == CT_CHAR { return "blink_kops_char" }
    if sname != "" && list_contains_str(derive_hash_types, sname) != 0 {
        return "kops_{c_type_c_name(sname)}"
    }
    // typecheck E1400 should have rejected unsupported K (Float/Double,
    // or a struct without @derive(Hash)). Reaching here means typecheck
    // and codegen disagree — emit an undefined C symbol so the C compiler
    // surfaces the broken site.
    "BLINK_COMPILER_BUG_kops_unsupported_K_ct{ct}_{sname}"
}

pub fn kops_is_struct_key(sname: Str) -> Bool {
    sname != "" && list_contains_str(derive_hash_types, sname) != 0
}

// A payload-less (plain) enum key is stored INLINE in the map/set slot — its kops sets
// inline_key = 1 — because a plain enum is an ordinal, and an ordinal is what every other
// producer of a `List[<Enum>]` puts in a list slot (`blink_list_push(l,
// (void*)(intptr_t)blink_Col_Red)`). Boxing it by pointer here would give one type two physical
// layouts, and a consumer that cannot see which producer built the list — a fn parameter, an
// index, a lazy adapter — has no way to pick the right one.
//
// A DATA enum is not inline: its C struct carries a payload, so it boxes by pointer exactly like
// a struct, which is also how a push-built list holds it. Same rule, opposite answer.
pub fn kops_is_inline_enum_key(sname: Str) -> Bool {
    kops_is_struct_key(sname) && is_enum_type(sname) != 0 && is_data_enum(sname) == 0
}

// True when a resolved Set/Map element name denotes a concrete type whose kops
// table can be selected at the Set()/Map() ctor site: a recognized primitive
// (type_from_name != CT_VOID) or a named struct/enum. Returns false for an
// unresolved typevar (e.g. a generic-struct field's `Set[T]`, which typecheck
// never monomorphizes) so the ctor keeps the string default and downstream
// recover_elem_ct_from_arg picks the real kops.
pub fn kops_elem_is_concrete(name: Str) -> Bool {
    if type_from_name(name) != CT_VOID { return true }
    is_named_type(name) != 0
}

/// Resolve a Map key type annotation to the C struct sname used by the kops
/// machinery, or "" for built-in K types (Str/Int/Bool/etc).
///
/// For tuple K (e.g. (Str, Int)): synthesizes the tuple struct via
/// resolve_tuple_ann and auto-registers it into derive_hash_types and
/// derive_eq_types so emit_struct_hash / emit_struct_eq pick it up and
/// the kops_<mangled> adapter table is emitted. Per spec §3.8: tuple Hash/Eq
/// are auto-derived structurally when all element types are themselves
/// Hash + Eq, with no user annotation required.
// tparams_sl/segs are the same pre-lowered mono-context pair mono_name_from_ann
// takes (see resolve_tparam_seg's note above: codegen_types sits BELOW typecheck
// in the import graph and cannot lower arg_tids to segs itself, so every caller
// passes segs_from_arg_tids(cg_mono_arg_tids)/cg_mono_tparams_sl already computed).
// Outside a generic-fn mono body, callers pass -1/[] (mono_name_from_ann's own
// no-context contract), so this is a no-op there — every existing call site keeps
// its current behavior.
pub fn key_struct_sname_from_ann(k_ann: Int, tparams_sl: Int, segs: List[Str]) -> Str ! Codegen.Emit {
    if k_ann == -1 { return "" }
    let kname = node_name(k_ann)
    if kname == "Tuple" {
        let opt = resolve_tuple_ann(k_ann, -1, [])
        if opt.is_none() { return "" }
        let c_name = opt.unwrap()
        let cn = c_type_c_name(c_name)
        if list_contains_str(derive_hash_types, c_name) == 0 {
            derive_hash_types.push(c_name)
            // Tuple K registration can happen mid fn-body codegen, after
            // emit_derive_forward_decls. Inject an extern decl at the use
            // site (valid in C block scope) so the kops symbol resolves;
            // emit_kops_adapters_late() emits the definition after fn bodies.
            emit_line("extern const blink_kops kops_{cn};")
        }
        if list_contains_str(derive_eq_types, c_name) == 0 {
            derive_eq_types.push(c_name)
        }
        return c_name
    }
    // A bare DECLARED generic struct/enum head ("HBox" from `HBox[HBox[T]]`) needs
    // its type args resolved through the mono context before it names a real C
    // type — is_named_type("HBox") is already true (a plain declared type), so
    // without this branch the caller below would return the unmangled head and
    // the kops adapter lookup for it would never match a registered instance.
    // mono_name_from_ann declines ("") for a non-generic
    // struct/enum, so this is a no-op for every shape that already worked.
    if is_struct_type(kname) != 0 || is_enum_type(kname) != 0 {
        let mono_name = mono_name_from_ann(strip_module_qualifier(kname), k_ann, tparams_sl, segs)
        if mono_name != "" {
            ensure_struct_derive_kops_key_for_base(mono_name, kname)
            return mono_name
        }
    }
    if is_named_type(kname) != 0 {
        return kname
    }
    // Non-data (C-style) enums are not in is_named_type but can serve as
    // Map keys when @derive(Hash, Eq) is present. They're already in
    // derive_hash_types thanks to register_derive_annotations.
    if is_enum_type(kname) != 0 {
        return kname
    }
    ""
}

// Register an already-resolved tuple C-name (e.g. "Tuple2_int_int") as a kops
// key when it isn't yet in derive_hash_types. The annotation path
// (key_struct_sname_from_ann) registers a tuple K from its `Tuple` annotation,
// but a generic-fn mono over a tuple key reaches the Set()/Map() ctor with the
// key already resolved to its C-name (the typevar substituted away), so that
// path is skipped and the tuple never joins the hash/eq derive lists — leaving
// kops_table_name to emit the BLINK_COMPILER_BUG sentinel in that transitive
// case. Registering here triggers emit_struct_hash/eq + the kops adapter emit.
// Returns 1 when the name denotes a known tuple (registered or already present),
// 0 otherwise (leaves non-tuple names to the caller's existing handling).
pub fn ensure_tuple_kops_key(c_name: Str) -> Int {
    if find_tuple_entry(c_name) < 0 { return 0 }
    if list_contains_str(derive_hash_types, c_name) == 0 {
        derive_hash_types.push(c_name)
    }
    if list_contains_str(derive_eq_types, c_name) == 0 {
        derive_eq_types.push(c_name)
    }
    1
}

// The struct-instance twin of ensure_tuple_kops_key: a resolved
// mono struct instance name (e.g. "HBox_0HBox_10Int") used as a Map/Set key/elem
// joins derive_hash_types/derive_eq_types only here, on demand, when its declared
// base is in derive_hash_generic_bases/derive_eq_generic_bases. register_derive_
// annotations cannot register the instance itself — at parse time no mono
// instance exists yet, only the generic declaration. Mirrors the tuple path's
// inline extern decl for the case where emit_derive_forward_decls already
// flushed by the time this instance mints (mid fn-body emission); the definition
// itself comes later from emit_kops_adapters_late's "_from" flush.
// Returns 1 when the base wants Hash and/or Eq (registered or already present),
// 0 for an ordinary (non-derived) struct instance.
pub fn ensure_struct_derive_kops_key(c_name: Str) -> Int ! Codegen.Emit {
    ensure_struct_derive_kops_key_for_base(c_name, lookup_mono_base(c_name).base)
}

// The explicit-base twin of ensure_struct_derive_kops_key, for a caller that
// already knows the instance's declared base from walking the ANNOTATION
// (e.g. kops_elem_from_container_ann resolving a Map key's `HBox[HBox[T]]`
// annotation via mono_name_from_ann) rather than from a REGISTERED instance's
// reverse lookup. lookup_mono_base can't be used at that call site: a Map/Set
// ctor statement routinely runs BEFORE the first struct literal of its own key
// type does (you need an empty container before you can insert into it), so
// mono_instances has no row yet — lookup_mono_base(c_name).base would read ""
// and silently decline a key that does derive Hash/Eq.
pub fn ensure_struct_derive_kops_key_for_base(c_name: Str, base: Str) -> Int ! Codegen.Emit {
    if base == "" { return 0 }
    let mut did = 0
    if list_contains_str(derive_hash_generic_bases, base) != 0 {
        if list_contains_str(derive_hash_types, c_name) == 0 {
            derive_hash_types.push(c_name)
            emit_line("extern const blink_kops kops_{c_type_c_name(c_name)};")
        }
        did = 1
    }
    if list_contains_str(derive_eq_generic_bases, base) != 0 {
        if list_contains_str(derive_eq_types, c_name) == 0 {
            derive_eq_types.push(c_name)
        }
        did = 1
    }
    if list_contains_str(derive_debug_generic_bases, base) != 0 {
        if list_contains_str(derive_debug_types, c_name) == 0 {
            derive_debug_types.push(c_name)
        }
        did = 1
    }
    if list_contains_str(derive_ord_generic_bases, base) != 0 {
        if list_contains_str(derive_ord_types, c_name) == 0 {
            derive_ord_types.push(c_name)
        }
        did = 1
    }
    if list_contains_str(derive_clone_generic_bases, base) != 0 {
        if list_contains_str(derive_clone_types, c_name) == 0 {
            derive_clone_types.push(c_name)
        }
        did = 1
    }
    if list_contains_str(derive_serialize_generic_bases, base) != 0 {
        if list_contains_str(derive_serialize_types, c_name) == 0 {
            derive_serialize_types.push(c_name)
        }
        did = 1
    }
    did
}

/// 1 if the kops table stores keys inline (key copied into slot, e.g. integers);
/// 0 if the slot holds a pointer (e.g. Str). Used to decide whether to materialize
/// a temp at insert/get/has/remove sites.
pub fn kops_is_inline_key(ct: Int) -> Int {
    if ct == CT_STRING { return 0 }
    1
}

pub fn ct_bit_width(ct: Int) -> Int {
    if ct == CT_I8 || ct == CT_U8 { 8 }
    else if ct == CT_I16 || ct == CT_U16 { 16 }
    else if ct == CT_I32 || ct == CT_U32 || ct == CT_CHAR { 32 }
    else { 64 }
}

/// C type name for unsigned arithmetic at the same bit width as `ct`.
/// Used by wrapping_* methods — round-trip values through the unsigned type to
/// get well-defined modular C semantics.
pub fn wrapping_unsigned_c_type(ct: Int) -> Str {
    if ct == CT_I8 || ct == CT_U8 { "uint8_t" }
    else if ct == CT_I16 || ct == CT_U16 { "uint16_t" }
    else if ct == CT_I32 || ct == CT_U32 { "uint32_t" }
    else { "uint64_t" }
}

pub fn is_sized_int_ct(ct: Int) -> Int {
    if ct == CT_I8 || ct == CT_I16 || ct == CT_I32 { return 1 }
    if ct == CT_U8 || ct == CT_U16 || ct == CT_U32 || ct == CT_U64 { return 1 }
    0
}

// Which inner CT the Option-unwrap tail names its temp's carrier from (sole caller:
// emit_option_method's `unwrap` scalar tail). An inner with no carrier typedef of its own keeps the
// Int carrier, because `blink_Option_enum` and friends are names nothing emits.
//
// The predicate is DERIVED, not enumerated: an enumerated list went stale once already, erasing
// every pointer-shaped inner (Handle, StringBuilder, Channel, Iterator, Ptr, Template) that had no
// dedicated arm — a cc error for Handle, and for StringBuilder a lost type and an UnresolvedMethod
// with no C compiler involved. What the tail needs is "an inner whose carrier
// `blink_Option_{c_type_tag(ct)}` is really emitted", and emit_option_typedef declines on precisely
// `c_type_tag(ct) == "void"`, so asking c_type_tag makes the two agree by construction.
//
// The floor still stands for an inner c_type_tag does not name, which keeps Instant/Duration/Enum
// correct: those are genuinely int64_t-shaped and must keep being floored.
pub fn unwrap_scalar_ct(ct: Int) -> Int {
    if c_type_tag(ct) != "void" { return ct }
    CT_INT
}

// The cast prefix for storing a container-slot value (returned as void* by
// blink_list_get / blink_map_get / blink_list_pop) into a scalar Option carrier.
// A pointer-backed scalar (Bytes, Ptr, …) casts straight to its pointer c_type,
// mirroring the CT_STRING arm; an int-like scalar rides the intptr round-trip.
pub fn scalar_carrier_cast(ct: Int) -> Str {
    if c_type_str(ct).ends_with("*") {
        return "({c_type_str(ct)})"
    }
    "(int64_t)(intptr_t)"
}

pub fn is_hash_scalar_ct(ct: Int) -> Int {
    if ct == CT_INT || ct == CT_BOOL || ct == CT_CHAR { return 1 }
    is_sized_int_ct(ct)
}

pub fn ptr_inner_c_type(name: Str) -> Str {
    if is_struct_type(name) != 0 {
        return c_type_c_name(name)
    }
    match name {
        "Void" => "void"
        "U8" => "uint8_t"
        "U16" => "uint16_t"
        "U32" => "uint32_t"
        "U64" => "uint64_t"
        "I8" => "int8_t"
        "I16" => "int16_t"
        "I32" => "int32_t"
        "I64" => "int64_t"
        "Int" => "int64_t"
        "Float" => "double"
        _ => "void"
    }
}

pub fn resolve_ptr_inner_c() -> Str {
    if cg_let_target_ann != -1 {
        let ta_elems = node_elements(cg_let_target_ann)
        if ta_elems != -1 && sublist_length(ta_elems) > 0 {
            return ptr_inner_c_type(node_name(sublist_get(ta_elems, 0)))
        }
    }
    "void"
}

pub fn strip_module_qualifier(name: Str) -> Str {
    let dot_pos = name.index_of(".")
    if dot_pos >= 0 {
        return name.substr(dot_pos + 1, name.len() - dot_pos - 1)
    }
    name
}

// The base name of a possibly-generic type-name string: `Tree[T]` → `Tree`,
// `Tree` → `Tree`. The enum variant-field registry stores a self-recursive field's
// type via build_type_name_from_ann (which keeps the `[T]` args), so the ctor/match
// self-recursion checks compare on the base alone. Shared by codegen_expr
// (ctor) and codegen_stmt (match).
pub fn strip_generic_args(name: Str) -> Str {
    let bracket_pos = name.index_of("[")
    if bracket_pos < 0 { return name }
    name.substr(0, bracket_pos)
}

// Canonical carrier-tag for a struct/enum named `name`. Derives from the
// canonical C name (`c_type_c_name`) so that user-defined `Row` (no module
// prefix → "Row") and stdlib `std.db.row.Row` (prefix → "std_db_row_Row")
// yield DISTINCT compound-carrier tags. Used in `blink_Option_<tag>`,
// `blink_Result_<tag>_<tag>` and `blink_List_<tag>` so the same Blink
// unqualified name in two modules does not collide at link time.
//
// Idempotent: if `name` is already a canonical tag (e.g. "std_db_row_Row"),
// `c_type_c_name` strips no prefix and we return the input unchanged.
pub fn strip_blink_prefix(c_name: Str) -> Str {
    if c_name.starts_with("blink_") {
        return c_name.slice(6, c_name.len())
    }
    c_name
}

pub fn c_type_tag_for_struct(name: Str) -> Str {
    // An @ffi.opaque handle lowers to a bare `<cname>*` pointer with no carrier struct. Its
    // C name carries a `*` that cannot appear inside a carrier identifier (folding it in
    // spells `blink_Result_FILE*_MyErr` etc.), so the tag is the identifier-safe nominal
    // name; c_type_from_tag maps it back to the pointer.
    if is_opaque_type(name) != 0 { return strip_module_qualifier(name) }
    strip_blink_prefix(c_type_c_name(name))
}

// the two builtin types that are BOTH a declared struct and a flat CT.
// `Instant` and `Duration` are ordinary `pub type` declarations (lib/std/time.bl:21,:25)
// whose methods are ordinary value-receiver free functions, and codegen ALSO gives them
// CT_INSTANT/CT_DURATION so `time.read().to_unix_ms()` lowers to a direct call.
//
// Every carrier and container-boxing site decides struct-vs-scalar by asking whether a
// struct NAME is present, and these two never presented one — so they took the scalar side,
// where the Option carrier is named from c_type_tag (which has no arm for either and
// answers its `else { "void" }` default) and a list/map element is cast struct-to-pointer,
// which cc rejects outright. Naming them here routes both through the struct machinery that
// already works for `Some(some_point)` and `[some_point]`, instead of inventing a
// by-value carrier with a struct-derived tag that no container path supports.
//
// This is the inverse of type_from_name's own "Instant"/"Duration" arms below, and the two
// must stay in step: the carrier stores the name, and the method blocks recover the flat CT
// from it.
pub fn builtin_struct_name_for_ct(ct: Int) -> Str {
    if ct == CT_INSTANT { return "Instant" }
    if ct == CT_DURATION { return "Duration" }
    ""
}

// The reverse direction: a retrieved Instant/Duration arrives as CT_STRUCT plus
// the name the carrier boxed it under, and the method blocks are gated on the flat CT.
// Answers -1 for every other struct so a genuine user struct is untouched.
pub fn builtin_struct_ct_for_name(name: Str) -> Int {
    if name == "Instant" { return CT_INSTANT }
    if name == "Duration" { return CT_DURATION }
    -1
}

// Reduce a type-name string to the underlying name codegen decides on: drop any
// generic-argument brackets and module qualifier, then follow the type-alias chain
// to its fixpoint. A type alias is transparent, so `Outer = Inner = Int` must reach
// `Int`, not stall on the first link. Shared by type_from_name (CT-code mapping) and
// ret_needs_struct_body (struct-return decision) so both agree on where a chain ends.
pub fn resolve_alias_chain_name(name: Str) -> Str {
    let bracket_pos = name.index_of("[")
    let mut base = name
    if bracket_pos >= 0 {
        base = name.substr(0, bracket_pos)
    }
    base = strip_module_qualifier(base)
    let mut guard = 0
    while guard < 64 {
        if type_alias_base.contains_key(base) == 0 { break }
        base = type_alias_base.get(base).unwrap()
        guard = guard + 1
    }
    base
}

pub fn type_from_name(name: Str) -> Int {
    let base = resolve_alias_chain_name(name)
    match base {
        "Int" => CT_INT
        "Str" => CT_STRING
        "Float" => CT_FLOAT
        "Bool" => CT_BOOL
        "List" => CT_LIST
        "Option" => CT_OPTION
        "Result" => CT_RESULT
        "Iterator" => CT_ITERATOR
        "Map" => CT_MAP
        "Set" => CT_SET
        "Bytes" => CT_BYTES
        "Instant" => CT_INSTANT
        "Duration" => CT_DURATION
        "Ptr" => CT_PTR
        "StringBuilder" => CT_STRINGBUILDER
        "Fn" => CT_CLOSURE
        "Channel" => CT_CHANNEL
        "Handle" => CT_HANDLE
        "Handler" => CT_HANDLER
        "Template" => CT_TEMPLATE
        "I8" => CT_I8
        "I16" => CT_I16
        "I32" => CT_I32
        "I64" => CT_INT
        "U8" => CT_U8
        "U16" => CT_U16
        "U32" => CT_U32
        "U64" => CT_U64
        "Char" => CT_CHAR
        _ => CT_VOID
    }
}

pub fn option_c_type(inner: Int) -> Str {
    "blink_Option_{c_type_tag(inner)}"
}

pub fn struct_option_c_type(struct_name: Str) -> Str {
    // An @ffi.opaque inner has no carrier struct: Option is the bare handle
    // pointer with NULL as the None niche. Every declaration and temp spelled
    // through this producer must agree, so intercept here.
    let oc = opaque_handle_c_name(struct_name)
    if oc != "" { return oc }
    "blink_Option_{canonical_struct_tag(struct_name)}"
}

pub fn result_c_type(ok_t: Int, err_t: Int) -> Str {
    "blink_Result_{c_type_tag(ok_t)}_{c_type_tag(err_t)}"
}

pub fn struct_result_c_type(ok_name: Str, err_name: Str) -> Str {
    "blink_Result_{canonical_struct_tag(ok_name)}_{canonical_struct_tag(err_name)}"
}

pub fn result_c_type_mixed(ok_t: Int, err_t: Int, ok_struct: Str, err_struct: Str) -> Str {
    let ok_tag = if ok_struct != "" { canonical_struct_tag(ok_struct) } else { c_type_tag(ok_t) }
    let err_tag = if err_struct != "" { canonical_struct_tag(err_struct) } else { c_type_tag(err_t) }
    "blink_Result_{ok_tag}_{err_tag}"
}

pub fn option_c_type_mixed(inner: Int, inner_struct: Str) -> Str {
    if inner_struct != "" {
        let oc = opaque_handle_c_name(inner_struct)
        if oc != "" { return oc }
        "blink_Option_{canonical_struct_tag(inner_struct)}"
    } else {
        "blink_Option_{c_type_tag(inner)}"
    }
}

pub fn option_inner_struct_from_tag(tag: Str) -> Str {
    if !tag.starts_with("Option_") { return "" }
    typedef_tag_or_empty(tag.slice(7, tag.len()))
}

pub fn option_inner_ct_from_tag(tag: Str) -> Int {
    if !tag.starts_with("Option_") { return CT_VOID }
    let inner = tag.slice(7, tag.len())
    if is_struct_type(inner) != 0 || is_enum_type(inner) != 0 { return CT_INT }
    if inner.starts_with("Option_") { return CT_OPTION }
    if inner.starts_with("Result_") { return CT_RESULT }
    if inner.starts_with("Map_") { return CT_MAP }
    type_from_name_tag(inner)
}

// The incomplete C pointer type an `Option_<opaque>` carrier lowers to under
// guaranteed null-pointer optimization, or "" when the inner is not opaque.
// The whole Option is one machine word (`FILE*`, `sqlite3*`): NULL is the None
// niche and a present handle is the non-null pointer — never a tagged carrier.
// Result carriers are excluded: they need both an ok and an err channel, so no
// unused value is available for a niche.
pub fn opaque_option_carrier_cname(tag: Str) -> Str {
    if !tag.starts_with("Option_") { return "" }
    opaque_handle_c_name(tag.slice(7, tag.len()))
}

// True when `name` is an @ffi.opaque handle type. Its bare handle and its
// Option both lower to the incomplete C pointer, so the value seams read this
// to take the null-pointer-optimized path instead of a `.tag`/`.value` carrier.
pub fn is_opaque_type(name: Str) -> Int {
    if opaque_handle_c_name(name) != "" { 1 } else { 0 }
}

// The bare incomplete C pointer an @ffi.opaque handle lowers to (`FILE*`), or ""
// when `name` is not opaque.
pub fn opaque_handle_c_name(name: Str) -> Str {
    match ffi_opaque_c_name.get(resolve_import_alias(strip_module_qualifier(name))) {
        Some(ocname) => "{ocname}*"
        None => ""
    }
}

pub fn canonical_struct_tag(tag: Str) -> Str {
    if tag == "" { return tag }
    if tag.starts_with("Option_") {
        let inner = tag.slice(7, tag.len())
        return "Option_{canonical_struct_tag(inner)}"
    }
    if tag.starts_with("Result_") {
        let rest = tag.slice(7, tag.len())
        let mut k = rest.len() - 1
        let mut sep = -1
        while k > 0 {
            if rest.byte_at(k) == 95 {
                let candidate_err = rest.slice(k + 1, rest.len())
                if is_named_typedef_tag(candidate_err) != 0 || type_from_name_tag(candidate_err) != CT_VOID {
                    sep = k
                    k = 0
                }
            }
            k = k - 1
        }
        if sep < 0 {
            let mut j = rest.len() - 1
            while j > 0 {
                if rest.byte_at(j) == 95 {
                    sep = j
                    j = 0
                } else {
                    j = j - 1
                }
            }
        }
        if sep > 0 {
            let ok = rest.slice(0, sep)
            let err = rest.slice(sep + 1, rest.len())
            return "Result_{canonical_struct_tag(ok)}_{canonical_struct_tag(err)}"
        }
        return tag
    }
    if tag.starts_with("Map_") { return tag }
    if is_struct_type(tag) != 0 || is_enum_type(tag) != 0 {
        return c_type_tag_for_struct(tag)
    }
    tag
}

pub fn tuple_c_type_name(elem_tags: Str, arity: Int) -> Str {
    "Tuple{arity}_{elem_tags}"
}

pub fn find_tuple_entry(c_name: Str) -> Int {
    if emitted_tuple_set.contains_key(c_name) == 0 {
        return -1
    }
    emitted_tuple_set.get(c_name).unwrap()
}

// Element count of an emitted tuple struct tag, or -1 when the tag names no
// known tuple. Lets a caller split a tuple-typed scrutinee into per-element
// `._i` field accesses without importing the TupleEntry internals.
pub fn tuple_struct_arity(c_name: Str) -> Int {
    let idx = find_tuple_entry(c_name)
    if idx < 0 { return -1 }
    emitted_tuple_entries.get(idx).unwrap().arity
}

// Element CT of tuple tag `c_name` at position `idx`, or CT_VOID if unknown.
pub fn tuple_elem_ct(c_name: Str, idx: Int) -> Int {
    let e = find_tuple_entry(c_name)
    if e < 0 { return CT_VOID }
    get_tuple_entry_elem_type(emitted_tuple_entries.get(e).unwrap().elem_types, idx)
}

// Element struct/compound tag of tuple tag `c_name` at position `idx`, or ""
// when the element is a scalar (no named struct).
pub fn tuple_elem_struct(c_name: Str, idx: Int) -> Str {
    let e = find_tuple_entry(c_name)
    if e < 0 { return "" }
    get_tuple_entry_elem_struct(emitted_tuple_entries.get(e).unwrap().elem_structs, idx)
}

// Element resolved name of tuple tag `c_name` at position `idx` -- "Void" for a
// genuine Void element, "" otherwise (or when the tag is unknown). Lets
// emit_tuple_destructure route a scalar element through c_field_type_str
// exactly as emit_tuple_typedef already does, without importing TupleEntry
// internals -- mirrors tuple_elem_struct's shape.
pub fn tuple_elem_name(c_name: Str, idx: Int) -> Str {
    let e = find_tuple_entry(c_name)
    if e < 0 { return "" }
    get_tuple_entry_elem_name(emitted_tuple_entries.get(e).unwrap().elem_names, idx)
}

// Per-position merge for repeat ensure_tuple_type calls on the SAME c_name:
// elem_types/elem_structs are safe as pure first-writer-wins because
// c_name is derived from them (two callers registering the same c_name always
// agree on shape), but elem_names is not — several call sites (bare tuple
// literals, enum-zip/map-iteration synthetic tuples) mint "" per position
// because they have no resolved annotation/tid in hand at that call, while a
// later, better-informed caller for the SAME stem may know a position is
// genuinely Void. Without this merge, whichever caller registers first wins
// outright, and an uninformed "" can permanently shadow the correct "Void" —
// silently reintroducing the illegal `void _0;` field, now as an unlocated,
// call-order-dependent `cc` failure.
fn merge_tuple_elem_names(old_names: Str, new_names: Str, arity: Int) -> Str {
    let mut out = ""
    let mut i = 0
    while i < arity {
        let on = get_tuple_entry_elem_name(old_names, i)
        let picked = if on != "" { on } else { get_tuple_entry_elem_name(new_names, i) }
        out = if i == 0 { picked } else { "{out},{picked}" }
        i = i + 1
    }
    out
}

pub fn ensure_tuple_type(c_name: Str, arity: Int, elem_types: Str, elem_structs: Str, elem_names: Str) {
    match emitted_tuple_set.get(c_name) {
        Some(idx) => {
            let existing = emitted_tuple_entries.get(idx).unwrap()
            let merged = merge_tuple_elem_names(existing.elem_names, elem_names, arity)
            if merged != existing.elem_names {
                emitted_tuple_entries.set(idx, TupleEntry { c_name: existing.c_name, arity: existing.arity, elem_types: existing.elem_types, elem_structs: existing.elem_structs, elem_names: merged })
            }
            return
        }
        None => {}
    }
    emitted_tuple_set.insert(c_name, emitted_tuple_entries.len())
    emitted_tuple_entries.push(TupleEntry { c_name: c_name, arity: arity, elem_types: elem_types, elem_structs: elem_structs, elem_names: elem_names })
    struct_reg_names.push(c_name)
    struct_reg_set.insert(c_name, 1)
    let mut i = 0
    while i < arity {
        let et = get_tuple_entry_elem_type(elem_types, i)
        let es = get_tuple_entry_elem_struct(elem_structs, i)
        let fname = "_{i}"
        if es != "" {
            reg_sf_entry(c_name, fname, CT_VOID, es, sv_tp(CT_VOID, -1, -1, es), -1)
        } else {
            reg_sf_entry(c_name, fname, et, "", sv_tp(et, -1, -1, ""), -1)
        }
        i = i + 1
    }
}

pub let mut tuple_typedef_emitted: Map[Str, Int] = Map()

// A struct-result/option typedef embeds its inner tag BY VALUE, so when that
// inner is a tuple the tuple's typedef must precede it in the C output. The
// global emit order (option/result before tuples) handles the common case of
// a tuple embedding a compound, but not the reverse. Emit the tuple eagerly
// here; the BLINK_TD_ guard + this set keep it idempotent regardless of order.
pub fn emit_tuple_typedef_for_tag(tag: Str) ! Codegen.Emit {
    match emitted_tuple_set.get(tag) {
        Some(idx) => emit_tuple_typedef(emitted_tuple_entries.get(idx).unwrap())
        None => {}
    }
}

// A tuple element that is Option[T]/Result[T,E] embeds its carrier typedef
// (blink_Option_Cmd / blink_Result_int_str) BY VALUE, so that carrier must be
// declared before the tuple typedef. The global flush emits option/result
// carriers before tuples, but the per-flush passes (flush_mono_fns_with_typedefs,
// the fn-body flush) emit tuples first, and a carrier may be registered in the
// same window; so recurse into the carrier the way emit_tuple_typedef already
// recurses into nested-tuple deps. Mirrors the reverse dependency already coded
// in emit_struct_option/result_typedef (which emit their inner tuple). Each
// emitter dedups via option/result_typedef_emitted, so this is idempotent
// regardless of emit order.
pub fn emit_carrier_typedef_for_tag(tag: Str) ! Codegen.Emit {
    if tag.starts_with("Option_") {
        let inner = tag.slice(7, tag.len())
        let inner_ct = type_from_name_tag(inner)
        // Take the scalar emit_option_typedef path ONLY when the inner is a
        // NON-compound scalar with a concrete CT. A compound inner (Map_str_int,
        // Option_int, Result_list_int) has type_from_name_tag → CT_MAP/CT_OPTION/
        // CT_RESULT (non-VOID), which the old inner_ct != CT_VOID gate wrongly sent
        // down the scalar path — emitting a bare blink_Option_map / blink_Option_option
        // and NEVER the structured blink_Option_Map_str_int, so the by-value member
        // stayed undeclared (read as int) in the enclosing tuple. Mirrors
        // the Result branch's both_scalar gate below; emit_struct_option_typedef
        // recurses into the inner compound carrier first.
        if inner_ct != CT_VOID && is_compound_tag(inner) == 0 {
            emit_option_typedef(inner_ct)
        } else {
            emit_struct_option_typedef(inner)
        }
    } else if tag.starts_with("Result_") {
        let parts = split_result_compound(canonical_struct_tag(tag))
        if parts.second != "" {
            // Take the scalar emit_result_typedef path ONLY when both parts are
            // non-compound scalars with a concrete CT. A compound-inner part (e.g.
            // Option_Box_Int) has type_from_name_tag → CT_OPTION (non-VOID), which
            // the old ok_ct != CT_VOID gate wrongly sent down the scalar path —
            // emitting a bogus blink_Result_option_str and never recursing into the
            // inner carrier. A struct-instance part (CT_VOID) likewise needs the
            // struct path. Everything else routes to emit_struct_result_typedef,
            // whose compound recursion emits the inner carrier first.
            let ok_ct = type_from_name_tag(parts.first)
            let err_ct = type_from_name_tag(parts.second)
            let both_scalar = is_compound_tag(parts.first) == 0 && is_compound_tag(parts.second) == 0 && ok_ct != CT_VOID && err_ct != CT_VOID
            if both_scalar {
                emit_result_typedef(ok_ct, err_ct)
            } else {
                emit_struct_result_typedef(parts.first, parts.second)
            }
        }
    }
}

fn emit_tuple_typedef(entry: TupleEntry) ! Codegen.Emit {
    if tuple_typedef_emitted.contains_key(entry.c_name) != 0 { return }
    tuple_typedef_emitted.insert(entry.c_name, 1)
    // A nested-tuple element is embedded BY VALUE (its c_name lands in the `es`
    // slot), so its typedef must precede this one. The global catch-all flush
    // iterates in insertion order (inner registered before outer), but eager
    // callers (emit_top_level_let, emit_struct_result/option_typedef) emit a
    // single tag out of that order, leaving the by-value inner undeclared. Recurse
    // into embedded tuples first; the BLINK_TD_ guard keeps it idempotent.
    let mut d = 0
    while d < entry.arity {
        let dep = get_tuple_entry_elem_struct(entry.elem_structs, d)
        if dep != "" && find_tuple_entry(dep) >= 0 {
            emit_tuple_typedef(emitted_tuple_entries.get(find_tuple_entry(dep)).unwrap())
        } else if dep != "" && (dep.starts_with("Option_") || dep.starts_with("Result_")) {
            // An Option[T]/Result[T,E] element embeds its carrier typedef by
            // value; emit the carrier before this tuple.
            emit_carrier_typedef_for_tag(dep)
        }
        d = d + 1
    }
    emit_td_guard_open(c_type_c_name(entry.c_name))
    emit_line("typedef struct \{")
    cg_indent = cg_indent + 1
    let mut i = 0
    while i < entry.arity {
        let et = get_tuple_entry_elem_type(entry.elem_types, i)
        let es = get_tuple_entry_elem_struct(entry.elem_structs, i)
        let fname = "_{i}"
        if es != "" {
            emit_line("{c_type_c_name(es)} {fname};")
        } else {
            // c_field_type_str lowers a genuine Void element (name "Void") to an int64_t
            // placeholder, exactly as a named struct field already did; every other
            // position's name is "" and this is byte-identical to the old c_type_str(et)
            // call.
            let nm = get_tuple_entry_elem_name(entry.elem_names, i)
            emit_line("{c_field_type_str(et, nm)} {fname};")
        }
        i = i + 1
    }
    cg_indent = cg_indent - 1
    emit_line("} {c_type_c_name(entry.c_name)};")
    emit_td_guard_close()
    emit_line("")
}

pub fn emit_all_tuple_types() ! Codegen.Emit {
    let mut i = 0
    while i < emitted_tuple_entries.len() {
        emit_tuple_typedef(emitted_tuple_entries.get(i).unwrap())
        i = i + 1
    }
}

pub fn emit_tuple_types_from(start: Int) ! Codegen.Emit {
    let mut i = start
    while i < emitted_tuple_entries.len() {
        emit_tuple_typedef(emitted_tuple_entries.get(i).unwrap())
        i = i + 1
    }
}

fn get_tuple_entry_elem_type(encoded: Str, idx: Int) -> Int {
    let mut sep_count = 0
    let mut start = 0
    let mut i = 0
    while i < encoded.len() {
        if encoded.byte_at(i) == 44 { // ','
            if sep_count == idx {
                let part = encoded.substring(start, i - start)
                return part.to_int()
            }
            sep_count = sep_count + 1
            start = i + 1
        }
        i = i + 1
    }
    if sep_count == idx {
        let part = encoded.substring(start, encoded.len() - start)
        return part.to_int()
    }
    CT_VOID
}

// The name decode is byte-identical to elem_structs' (a bare "-" would decode to "", but a
// name position is only ever "" or "Void" and never "-"), so this delegates rather than
// duplicating the split loop a third time.
fn get_tuple_entry_elem_name(encoded: Str, idx: Int) -> Str {
    get_tuple_entry_elem_struct(encoded, idx)
}

fn get_tuple_entry_elem_struct(encoded: Str, idx: Int) -> Str {
    let mut sep_count = 0
    let mut start = 0
    let mut i = 0
    while i < encoded.len() {
        if encoded.byte_at(i) == 44 { // ','
            if sep_count == idx {
                let part = encoded.substring(start, i - start)
                if part == "-" { return "" }
                return part
            }
            sep_count = sep_count + 1
            start = i + 1
        }
        i = i + 1
    }
    if sep_count == idx {
        let part = encoded.substring(start, encoded.len() - start)
        if part == "-" { return "" }
        return part
    }
    ""
}

// A by-value carrier slot (Result ok/err, Option/List inner) reads its CT from
// the tid vocabulary, where a Void, tuple, or otherwise unnameable leaf answers
// -1. The flat carrier channel (sv_tp, c_type_tag) spells that leaf as CT_VOID;
// a bare -1 there is fabricated to `int` by sv_tp's default arm. Convert at the
// tid->flat boundary so a `Result[Void, E]` ok slot or a `List[(A,B)]` element
// keeps its void spelling instead of collapsing to int.
pub fn carrier_slot_ct(ct: Int) -> Int {
    if ct < 0 { CT_VOID } else { ct }
}

pub fn c_type_tag(ct: Int) -> Str {
    if ct == CT_INT { "int" }
    else if ct == CT_FLOAT { "double" }
    else if ct == CT_BOOL { "bool" }
    else if ct == CT_STRING { "str" }
    else if ct == CT_LIST { "list" }
    else if ct == CT_ITERATOR { "iter" }
    else if ct == CT_HANDLE { "handle" }
    else if ct == CT_CHANNEL { "channel" }
    // The EFFECT IS DROPPED, on the precedent set three lines up: every parameterized non-struct
    // kind here drops its parameter (Handle[T] → "handle", Channel[T] → "channel", Ptr[T] → "ptr"),
    // so a per-effect `Option_Handler_io` would be the odd one out. It costs nothing observable
    // because the precision lives in the TID — the unwrapped binding re-spells as
    // `blink_io_vtable*` from c_type_from_tid's Handler arm, and c_type_str(CT_HANDLER) is "void*",
    // so the carrier stores and yields a vtable without a cast.
    //
    // An arm is needed at all because the `else { "void" }` default below names the carrier
    // `blink_Option_void`, and emit_option_typedef returns early on exactly tag == "void" — so the
    // name is REFERENCED and never TYPEDEF'D. That default is why this function is weaker than its
    // tid twin: tc_tid_tag_at fails CLOSED on an unhandled kind, while here a missing arm silently
    // becomes a Void. Instant and Duration are deliberately NOT armed here — both are declared
    // structs, so they present as (CT_STRUCT, name) at every carrier boundary and their carriers
    // are named by canonical_struct_tag, which is what the tid twin answers for them too.
    else if ct == CT_HANDLER { "handler" }
    // THE SIGNATURE IS DROPPED, on the same precedent as CT_HANDLER above — and here
    // the drop is not merely conventional but exact. Every closure, whatever it takes and
    // returns, is one `blink_closure*` (runtime_core.h:2309: fn_ptr + userdata + promoter), so
    // `blink_Option_closure`'s member type is identical for every signature and a per-signature
    // carrier name would name distinct typedefs with byte-identical bodies. The signature stays
    // recoverable from the tid, and from the ScopeVar `sname` the closure paths already read.
    //
    // Its absence was the last kind in the `else { "void" }` default below (see the CT_HANDLER
    // comment, which named it), and it failed two ways, not one. `Some(closure)` named the
    // never-typedef'd `blink_Option_void` — a cc error. `Ok(closure)` in a Result was WORSE:
    // emit_result_typedef lowers a `void` leaf to an `int64_t` placeholder field, so
    // `blink_Result_void_str` really was declared and a closure pointer was narrowed into an
    // int64_t member. Only -Wint-conversion stood between that and a silent miscompile.
    //
    // unwrap_scalar_ct (:6479) is derived from this function rather than enumerated, so this arm
    // also stops it flooring a closure inner to CT_INT — which is what its own comment asked
    // for ("Widen c_type_tag first if a closure inner ever needs it").
    //
    // Only the INNER tag position gets this. The tid twin's TOP position (tc_tid_to_c_tag) is the
    // mono-instance mangling speller, where dropping the signature would make two instantiations
    // over different closure types share one mangled name and one body — so TyKind.Fn keeps
    // failing CLOSED there. See the note on tc_tid_tag_at's TyKind.Fn INNER arm.
    else if ct == CT_CLOSURE { "closure" }
    else if ct == CT_MAP { "map" }
    else if ct == CT_SET { "set" }
    else if ct == CT_BYTES { "bytes" }
    else if ct == CT_STRINGBUILDER { "stringbuilder" }
    else if ct == CT_PTR { "ptr" }
    else if ct == CT_OPTION { "option" }
    else if ct == CT_RESULT { "result" }
    else if ct == CT_TEMPLATE { "template" }
    else if ct == CT_I8 { "i8" }
    else if ct == CT_I16 { "i16" }
    else if ct == CT_I32 { "i32" }
    else if ct == CT_U8 { "u8" }
    else if ct == CT_U16 { "u16" }
    else if ct == CT_U32 { "u32" }
    else if ct == CT_U64 { "u64" }
    else if ct == CT_CHAR { "char" }
    else { "void" }
}

pub fn is_compound_ct(ct: Int) -> Int {
    if ct == CT_OPTION || ct == CT_RESULT || ct == CT_MAP {
        1
    } else {
        0
    }
}

// The carrier tag for a tp node, recursing into nested by-value carriers so a
// deep element type spells its full layout — `Option[Option[Int]]` →
// `Option_Option_int`, `Result[Option[Int],Str]` → `Result_Option_int_str`,
// `Option[List[Int]]` → `Option_list`, `Option[Map[Int,Str]]` → `Option_map`.
// The tp_pool twin of typecheck's tc_tid_inner_tag (which walks the ty_pool). This
// is the single source of the carrier name for `List[compound]` get()/pop()/for-in
// and the HOF iterator path. Map/List/Set are ERASED carriers (one blink_map*/
// blink_list*/blink_set* per shape), so their K/V element(s) drop out of the tag; a
// struct/enum node uses its C struct tag; a bare scalar its c_type_tag.
pub fn tp_carrier_tag(id: Int) -> Str {
    if id < 0 { return "void" }
    let kind = tp_get_kind(id)
    let sname = tp_get_sname(id)
    if kind == CT_STRUCT || kind == CT_ENUM {
        if sname != "" { return c_type_tag_for_struct(sname) }
        return "void"
    }
    if kind == CT_OPTION {
        return "Option_{tp_carrier_tag(tp_get_child1(id))}"
    }
    if kind == CT_RESULT {
        return "Result_{tp_carrier_tag(tp_get_child1(id))}_{tp_carrier_tag(tp_get_child2(id))}"
    }
    // Map/List/Set/Iterator and all scalars are pointer-boxed / by-value under a
    // single flat tag — the inner element travels via the var's map/list-elem
    // metadata channels, not the carrier tag. Map erases its K/V here exactly like
    // List/Set (`Map[Int,Str]` → `map`, `Option[Map[Int,Str]]` → `Option_map`): one
    // blink_map* backs every shape, so K/V are recovered per-use from the tid.
    c_type_tag(kind)
}

// Canonical tuple tag (e.g. `Tuple2_int_bytes`) for a tuple annotation, or ""
// if `ann` isn't a tuple. type_from_name("Tuple") is CT_VOID, so the compound
// resolvers can't recognize tuples by CT — they dispatch on the annotation
// node name and delegate here. Also registers the tuple struct as a side
// effect (resolve_tuple_ann → ensure_tuple_type), matching the non-? path.
fn resolve_tuple_tag(ann: Int) -> Str {
    if node_name(ann) != "Tuple" { return "" }
    let opt = resolve_tuple_ann(ann, -1, [])
    if opt.is_some() { return opt.unwrap() }
    ""
}

fn resolve_ann_tag(ann: Int, name: Str) -> Str {
    resolve_ann_tag_ctx(ann, name, -1, [], [])
}

// The tid a type-param binder is bound to in this mono, or -1. Inlines the positional
// lookup (tparam_tid_via_mono in codegen_methods) so codegen_types keeps no upward
// dependency — arg_tids is aligned to tparams_sl exactly as that helper reads it.
fn tparam_bound_tid_local(name: Str, tparams_sl: Int, arg_tids: List[Int]) -> Int {
    if tparams_sl == -1 { return -1 }
    let mut pi = 0
    while pi < sublist_length(tparams_sl) {
        if node_name(sublist_get(tparams_sl, pi)) == name {
            if pi < arg_tids.len() { return arg_tids.get(pi).unwrap() }
            return -1
        }
        pi = pi + 1
    }
    -1
}

// Substituting twin of resolve_ann_tag. When a leaf name is a type-param binder, spell it
// from its bound TID with tc_tid_inner_tag — the INNER-position speller the carrier path
// uses (scalar → lowercase `int`, struct/enum → capital mono stem, nested compound
// recursively). resolve_tparam_seg is NOT used for the leaf: it hands back the TOP-position
// tag (`Int`), which the carrier typedef and caller never spell. `segs` still feeds the
// struct-with-typevar-args branch (mono_name_from_ann needs the mangle segment there). With
// tparams_sl=-1 / arg_tids=[] / segs=[] this is byte-identical to the pre-substitution path.
fn resolve_ann_tag_ctx(ann: Int, name: Str, tparams_sl: Int, arg_tids: List[Int], segs: List[Str]) -> Str {
    let bt = tparam_bound_tid_local(name, tparams_sl, arg_tids)
    if bt >= 0 {
        let t = tc_tid_inner_tag(bt)
        if t != "" && !t.contains("<") { return t }
    }
    // A transparent alias leaf (struct-alias or multi-hop chain) is spelled from its
    // canonical underlying tid, not from type_from_name — which single-hops the alias and
    // erases a struct-alias or chain key to `void`, diverging from the signature path.
    let atid = tc_resolve_transparent_alias_name(name)
    if atid >= 0 {
        let t = tc_tid_inner_tag(atid)
        if t != "" && !t.contains("<") { return t }
    }
    let ct = type_from_name(name)
    if node_name(ann) == "Tuple" {
        let t = resolve_tuple_ann(ann, tparams_sl, segs)
        if t.is_some() { return t.unwrap() }
        return c_type_tag(ct)
    }
    if is_compound_ct(ct) != 0 {
        return compound_name_from_ann_ctx(ann, tparams_sl, arg_tids, segs)
    }
    if is_struct_type(name) != 0 || is_enum_type(name) != 0 {
        let mono = mono_name_from_ann(strip_module_qualifier(name), ann, tparams_sl, segs)
        if mono != "" { return mono }
        return strip_module_qualifier(name)
    }
    c_type_tag(ct)
}

pub fn compound_name_from_ann(ann_node: Int) -> Str {
    compound_name_from_ann_ctx(ann_node, -1, [], [])
}

// Substituting twin of compound_name_from_ann: threads (tparams_sl, arg_tids, segs) into
// each inner so a type-param inner (`Option[Map[K,V]]`, `Option[Option[T]]`,
// `Option[Result[T,E]]`) spells its concrete args instead of erasing them to `void`. A
// generic fn's def-side mono has no call node to read a tid off, but its arg_tids ARE the
// type-param bindings (aligned to tparams_sl), so resolve_ann_tag_ctx spells each leaf from
// the bound tid. `segs` is the mangle-segment twin for the struct-with-typevar-args branch.
// The wrapper above passes (-1, [], []) and is byte-identical to the pre-substitution path.
pub fn compound_name_from_ann_ctx(ann_node: Int, tparams_sl: Int, arg_tids: List[Int], segs: List[Str]) -> Str {
    let name = node_name(ann_node)
    let ct = type_from_name(name)
    if ct == CT_RESULT {
        let inner_elems = node_elements(ann_node)
        if inner_elems != -1 && sublist_length(inner_elems) >= 2 {
            let ok_ann = sublist_get(inner_elems, 0)
            let err_ann = sublist_get(inner_elems, 1)
            let ok_name = node_name(ok_ann)
            let err_name = node_name(err_ann)
            let ok_tag = resolve_ann_tag_ctx(ok_ann, ok_name, tparams_sl, arg_tids, segs)
            let err_tag = resolve_ann_tag_ctx(err_ann, err_name, tparams_sl, arg_tids, segs)
            return "Result_{ok_tag}_{err_tag}"
        }
        // A Result annotation with no type arguments is under-determined: its Ok/Err
        // types were never pinned. This arm is unreachable for any program that reaches
        // codegen: typecheck rejects the under-determined value as error[CannotInferType]
        // (E0301) at every materialization boundary, and a bare `Result` annotation is
        // rejected earlier still by the type-argument-arity check (E0303)
        // (decisions/under-determined-sum-variant-parameter.md). It answers the ICE_SEG
        // sentinel — never the old fabricated `Result_int_str` carrier (an invented
        // `const char* err`, a latent miscompile and an ODR hazard under --link-archive):
        // a fabricated concrete name is silently wrong, whereas the sentinel is a
        // defense-in-depth backstop that surfaces as a hard compile error (an undefined
        // C type name, or a located I0001 at a mono chokepoint that tests diag_is_ice_seg)
        // if a future typecheck regression ever let one through. Keyed on the MISSING
        // arguments, never on a concrete tag, so a genuine `Result[Int, Str]` (spelled by
        // the branch above) is untouched. Same contract as type_arg_name_from_ct's
        // unnameable-sentinel arm.
        ICE_SEG_ERASED_SLOT
    } else if ct == CT_OPTION {
        let inner_elems = node_elements(ann_node)
        if inner_elems != -1 && sublist_length(inner_elems) >= 1 {
            let inner_ann2 = sublist_get(inner_elems, 0)
            let inner_name2 = node_name(inner_ann2)
            let inner_tag = resolve_ann_tag_ctx(inner_ann2, inner_name2, tparams_sl, arg_tids, segs)
            return "Option_{inner_tag}"
        }
        // The Option twin of the Result arm above: a bare `Option` with no inner type is
        // under-determined and unreachable at codegen (E0301 on the value, E0303 on the
        // annotation). Answer the ICE_SEG defense-in-depth sentinel rather than fabricating
        // `Option_int`. Keyed on the missing argument, not a concrete tag.
        ICE_SEG_ERASED_SLOT
    } else if ct == CT_MAP {
        // Map is an erased carrier, exactly like List and Set (which have no arm here
        // and fall to c_type_tag → "list"/"set"): one blink_map* serves every key/value
        // pair, so the C tag drops K/V at every annotation position. K/V are recovered
        // per-use from the authoritative tid, never spelled into the C type.
        "map"
    } else if name == "Tuple" {
        let t = resolve_tuple_ann(ann_node, tparams_sl, segs)
        if t.is_some() { return t.unwrap() }
        return c_type_tag(ct)
    } else {
        c_type_tag(ct)
    }
}

pub fn compound_option_inner_name(inner_type: Int, inner_str: Str) -> Str {
    if inner_type == CT_RESULT {
        let ok_t = get_var_result_ok(inner_str)
        let err_t = get_var_result_err(inner_str)
        let ok_s = get_var_result_ok_tag(inner_str)
        let err_s = get_var_result_err_tag(inner_str)
        let ok_tag = if ok_s != "" { ok_s } else { c_type_tag(ok_t) }
        let err_tag = if err_s != "" { err_s } else { c_type_tag(err_t) }
        "Result_{ok_tag}_{err_tag}"
    } else if inner_type == CT_OPTION {
        let opt_inner = get_var_option_inner(inner_str)
        let opt_inner_s = get_var_option_inner_tag(inner_str)
        let inner_tag = if opt_inner_s != "" { opt_inner_s } else { c_type_tag(opt_inner) }
        "Option_{inner_tag}"
    } else if inner_type == CT_MAP {
        "map"
    } else {
        c_type_tag(inner_type)
    }
}

// Decode one half of an `ensure_result_type` registry key. The key is the DECIMAL STRING of
// the two CT_* integers, so the decode is a plain integer parse and nothing else.
//
// NOT a hand-written ladder. One that ends at a fixed CT_* answers CT_INT for every kind past it,
// so `Result[U64, Str]` recorded the right pair, emitted `blink_Result_int_str`, and left the name
// the declaration used undeclared. Extending such a ladder by hand leaves the same trap one entry
// longer; parsing is exact for every CT_* that exists now or later.
fn ct_from_str(s: Str) -> Int {
    s.to_int()
}

pub fn ensure_option_type(inner: Int) {
    let key = "{inner}"
    if emitted_option_set.contains_key(key) != 0 {
        return
    }
    emitted_option_set.insert(key, 1)
    emitted_option_types.push(inner)
}

// Ensure the carrier typedef for a canonical compound tag (Option_<inner>,
// Result_<ok>_<err>) is registered for emission. Used when a generic typevar is
// bound to a whole Option/Result: the resolved name is the tag, not an
// annotation node. A SCALAR inner must route to the inline ensurer
// (ensure_option_type / ensure_result_type) so the carrier keeps `int64_t
// value`; only a struct/enum inner uses the pointer-boxing struct-carrier path.
// The two paths share the `blink_Option_int` typedef name under one dedup guard,
// so mis-routing a scalar to the struct path would emit `int64_t* value` and
// diverge from every scalar Option construct/unwrap. Map tags need no ensure
// (uniform blink_map*). Idempotent via the ensure_* dedup sets.
pub fn ensure_carrier_from_tag(tag: Str) {
    if tag.starts_with("Option_") {
        let inner = tag.slice(7, tag.len())
        let inner_ct = type_from_name_tag(inner)
        if inner_ct != CT_VOID {
            ensure_option_type(inner_ct)
        } else {
            ensure_struct_option_type(inner)
        }
    } else if tag.starts_with("Result_") {
        let parts = split_result_compound(canonical_struct_tag(tag))
        if parts.second != "" {
            let ok_ct = type_from_name_tag(parts.first)
            let err_ct = type_from_name_tag(parts.second)
            if ok_ct != CT_VOID && err_ct != CT_VOID {
                ensure_result_type(ok_ct, err_ct)
            } else {
                ensure_struct_result_type(parts.first, parts.second)
            }
        }
    }
}

pub fn ensure_struct_option_type(struct_name: Str) {
    // Option[@ffi.opaque] is null-pointer-optimized to a bare `<cname>*` word (NULL = None)
    // and has NO carrier struct (spec §9.1.4). This is the one chokepoint that still sees the
    // Blink name ("CFile"); canonical_struct_tag below would resolve it to the incomplete C
    // name ("FILE*"), after which the emit-time guard can no longer recognize it as opaque.
    if is_opaque_type(struct_name) != 0 { return }
    let tag = canonical_struct_tag(struct_name)
    let key = "s_{tag}"
    if emitted_option_set.contains_key(key) != 0 {
        return
    }
    emitted_option_set.insert(key, 1)
    emitted_struct_option_types.push(tag)
}

pub fn ensure_result_type(ok_t: Int, err_t: Int) {
    let key = "{ok_t}_{err_t}"
    if emitted_result_set.contains_key(key) != 0 {
        return
    }
    emitted_result_set.insert(key, 1)
    emitted_result_types.push(key)
}

pub fn ensure_struct_result_type(ok_name: Str, err_name: Str) {
    let ok_tag = canonical_struct_tag(ok_name)
    let err_tag = canonical_struct_tag(err_name)
    // Use '~' separator (invalid in C identifiers) so multi-underscore
    // canonical tags like `std_db_row_Row` don't ambiguously split on `_`.
    let key = "s~{ok_tag}~{err_tag}"
    if emitted_result_set.contains_key(key) != 0 {
        return
    }
    emitted_result_set.insert(key, 1)
    emitted_struct_result_types.push(key)
    let ok_ct = type_from_name_tag(ok_tag)
    let err_ct = type_from_name_tag(err_tag)
    if ok_ct != CT_VOID && err_ct != CT_VOID {
        let prim_key = "{ok_ct}_{err_ct}"
        emitted_result_set.insert(prim_key, 1)
    }
}

pub fn ensure_mixed_result_type(ok_t: Int, err_t: Int, ok_struct: Str, err_struct: Str) {
    if ok_struct != "" || err_struct != "" {
        let ok_tag = if ok_struct != "" { ok_struct } else { c_type_tag(ok_t) }
        let err_tag = if err_struct != "" { err_struct } else { c_type_tag(err_t) }
        ensure_struct_result_type(ok_tag, err_tag)
    } else {
        ensure_result_type(ok_t, err_t)
    }
}

fn ensure_mixed_option_type(inner: Int, inner_struct: Str) {
    if inner_struct != "" {
        ensure_struct_option_type(inner_struct)
    } else {
        ensure_option_type(inner)
    }
}

pub fn resolve_result_inner_tag(ann: Int, name: Str, ct: Int) -> Str {
    if node_name(ann) == "Tuple" {
        // A tuple OK/Err side would otherwise fall through to "" and erase its
        // element types; "" is also the correct sentinel if it's not a tuple.
        return resolve_tuple_tag(ann)
    }
    if is_compound_ct(ct) != 0 {
        return compound_name_from_ann(ann)
    }
    if is_struct_type(name) != 0 || is_enum_type(name) != 0 {
        let mono = mono_name_from_ann(strip_module_qualifier(name), ann, -1, [])
        if mono != "" { return mono }
        return strip_module_qualifier(name)
    }
    ""
}

// Register every generic-struct/enum INSTANCE reachable through a struct/enum
// FIELD type annotation — the field itself (`b: Box[Int]`) or an instance nested
// under a carrier (`rows: List[Option[Box[Int]]]`). This is annotation-driven,
// not tid-driven: typecheck does not stamp a node tid onto a field type
// annotation, so the tid path (register_carrier_struct_instance_leaves) cannot
// reach here. A carrier over such an instance emits its value member in the
// type-def prologue, BEFORE any construction site registers the instance, so
// without this the member erases to `void` (see is_mono_struct_instance /
// c_type_from_tag). ensure_compound_type_from_ann only NAMES the carrier via
// mono_name_from_ann and cannot itself register (it is reached from pure
// name-resolution contexts like resolve_tuple_ann that carry no Codegen effect).
// Idempotent via the mono registry; a non-instance annotation registers nothing.
pub fn register_field_ann_mono_instances(inner_ann: Int) ! Codegen.Register {
    if inner_ann == -1 { return }
    let inner_name = node_name(inner_ann)
    if is_struct_type(inner_name) != 0 || is_enum_type(inner_name) != 0 {
        register_carrier_inner_mono_instance(inner_name, inner_ann)
    } else {
        register_carrier_mono_instances_from_ann(inner_ann)
    }
}

// Descend a compound annotation (List/Option/Set/Result/Map) into its type
// arguments, registering each argument's reachable generic instances.
fn register_carrier_mono_instances_from_ann(ann_node: Int) ! Codegen.Register {
    if ann_node == -1 { return }
    let ct = type_from_name(node_name(ann_node))
    let elems = node_elements(ann_node)
    if elems == -1 { return }
    if ct == CT_OPTION || ct == CT_LIST || ct == CT_SET {
        if sublist_length(elems) >= 1 {
            register_field_ann_mono_instances(sublist_get(elems, 0))
        }
    } else if ct == CT_RESULT || ct == CT_MAP {
        if sublist_length(elems) >= 2 {
            register_field_ann_mono_instances(sublist_get(elems, 0))
            register_field_ann_mono_instances(sublist_get(elems, 1))
        }
    }
}

pub fn ensure_compound_type_from_ann(ann_node: Int) {
    let name = node_name(ann_node)
    let ct = type_from_name(name)
    if ct == CT_OPTION {
        let inner_elems = node_elements(ann_node)
        if inner_elems != -1 && sublist_length(inner_elems) >= 1 {
            let inner_ann = sublist_get(inner_elems, 0)
            let inner_name = node_name(inner_ann)
            let inner_t = type_from_name(inner_name)
            if is_struct_type(inner_name) != 0 || is_enum_type(inner_name) != 0 {
                // queue the carrier under the mono stem (QBox_Int) so the
                // typedef name matches the tid path; "" keeps the bare head.
                let mono = mono_name_from_ann(strip_module_qualifier(inner_name), inner_ann, -1, [])
                let tag = if mono != "" { mono } else { strip_module_qualifier(inner_name) }
                ensure_struct_option_type(tag)
            } else if is_compound_ct(inner_t) != 0 {
                ensure_compound_type_from_ann(inner_ann)
                ensure_struct_option_type(compound_name_from_ann(inner_ann))
            } else if inner_name == "Tuple" {
                let tuple_tag = resolve_tuple_tag(inner_ann)
                if tuple_tag != "" {
                    ensure_struct_option_type(tuple_tag)
                } else {
                    ensure_option_type(inner_t)
                }
            } else {
                ensure_option_type(inner_t)
            }
        }
    } else if ct == CT_RESULT {
        let inner_elems = node_elements(ann_node)
        if inner_elems != -1 && sublist_length(inner_elems) >= 2 {
            let ok_ann = sublist_get(inner_elems, 0)
            let err_ann = sublist_get(inner_elems, 1)
            let ok_name = node_name(ok_ann)
            let err_name = node_name(err_ann)
            let ok_t = type_from_name(ok_name)
            let err_t = type_from_name(err_name)
            if is_compound_ct(ok_t) != 0 {
                ensure_compound_type_from_ann(ok_ann)
            }
            if is_compound_ct(err_t) != 0 {
                ensure_compound_type_from_ann(err_ann)
            }
            let ok_r = resolve_result_inner_tag(ok_ann, ok_name, ok_t)
            let err_r = resolve_result_inner_tag(err_ann, err_name, err_t)
            let ok_tag = if ok_r != "" { ok_r } else { c_type_tag(ok_t) }
            let err_tag = if err_r != "" { err_r } else { c_type_tag(err_t) }
            ensure_struct_result_type(ok_tag, err_tag)
        }
    } else if ct == CT_LIST {
        let inner_elems = node_elements(ann_node)
        if inner_elems != -1 && sublist_length(inner_elems) >= 1 {
            let elem_ann = sublist_get(inner_elems, 0)
            let elem_t = type_from_name(node_name(elem_ann))
            if is_compound_ct(elem_t) != 0 {
                ensure_compound_type_from_ann(elem_ann)
            }
        }
    }
}

pub fn set_var_option(name: Str, inner: Int) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_OPTION {
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: inner, inner2: sv.inner2, sname: sv.sname, sname2: sv.sname2, ty: sv.ty, tp_id: sv_tp(sv.ctype, inner, sv.inner2, sv.sname) })
            return
        }
        i = i - 1
    }
    push_scope_var(ScopeVar { name: name, ctype: CT_OPTION, is_mut: 0, inner1: inner, inner2: -1, sname: "", sname2: "", ty: -1, tp_id: sv_tp(CT_OPTION, inner, -1, "") })
}

pub fn set_var_option_inner2(name: Str, val: Int) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_OPTION {
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: sv.inner1, inner2: val, sname: sv.sname, sname2: sv.sname2, ty: sv.ty, tp_id: sv_tp(sv.ctype, sv.inner1, val, sv.sname) })
            return
        }
        i = i - 1
    }
}

pub fn get_var_option_inner2(name: Str) -> Int {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_OPTION {
            return sv.inner2
        }
        i = i - 1
    }
    let blink_name = c_blink_name(name)
    if blink_name != name {
        i = scope_vars.len() - 1
        while i >= 0 {
            let sv = scope_vars.get(i).unwrap()
            if sv.name == blink_name && sv.ctype == CT_OPTION {
                return sv.inner2
            }
            i = i - 1
        }
    }
    -1
}

// Stamp a deep inner tp onto an Option var by rebuilding its tp_id as
// `type_option(<inner_tp>)`. Lets `Option[Map[K,V]]` / `Option[List[T]]` keep the
// inner container's full type params on the var itself, so a later Ident-read can
// restore expr_option_inner_tp and the match arm decodes the Map's V / List's T.
// The flat set_var_option/_struct path can only store one inner CT/struct.
pub fn set_var_option_inner_tp(name: Str, inner_tp: Int) {
    if inner_tp < 0 { return }
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_OPTION {
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: sv.inner1, inner2: sv.inner2, sname: sv.sname, sname2: sv.sname2, ty: sv.ty, tp_id: type_option(inner_tp) })
            return
        }
        i = i - 1
    }
}

// The deep inner tp NODE of an Option var (child1 of its option tp_id),
// but ONLY when that inner is itself a container (Map/List/Result) — a plain
// scalar/struct inner is already carried by the flat inner1 channel and the
// option tid, so return -1 there to avoid disturbing the existing paths.
pub fn get_var_option_inner_tp(name: Str) -> Int {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_OPTION {
            let c1 = tp_get_child1(sv.tp_id)
            if c1 >= 0 {
                let k = tp_get_kind(c1)
                if k == CT_MAP || k == CT_LIST || k == CT_RESULT || k == CT_OPTION || k == CT_SET {
                    return c1
                }
            }
            return -1
        }
        i = i - 1
    }
    -1
}

// The struct held inside an Option var's List/Map inner, read from the tid — the sole authority.
// An Option[List[S]] / Option[Map[K,S]] carries the nested S two levels down in its tid
// (option -> inner container -> element/value struct). A generic instance inner (Box[Int]) is
// spelled from the *_mono stem, byte-matched to the def-side mangle; a non-generic struct/enum
// inner from the plain head, but a transparent newtype (a bare scalar, no struct) or a bare-erased
// generic base is declined under the same guard sv_struct_tid_first uses. Any other inner (a scalar,
// a Set, or a tid that names no nested struct) answers "", and every caller guards that sentinel —
// a Set inner, for one, recovers its element struct from the consuming node's own tid downstream.
fn sv_option_inner2_struct_tid_first(sv: ScopeVar) -> Str {
    let inner = tc_tid_option_inner_tid(cg_bind_mono_tid(sv.ty))
    let lm = tc_tid_list_elem_struct_mono(inner)
    if lm != "" { return lm }
    let mm = tc_tid_map_val_struct_mono(inner)
    if mm != "" { return mm }
    let ls = tc_tid_list_elem_struct(inner)
    if ls != "" && is_transparent_newtype(ls) == 0 && struct_def_is_generic(ls) == 0 { return ls }
    let ms = tc_tid_map_val_struct(inner)
    if ms != "" && is_transparent_newtype(ms) == 0 && struct_def_is_generic(ms) == 0 { return ms }
    ""
}

pub fn get_var_option_inner2_struct(name: Str) -> Str {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_OPTION {
            let s = sv_option_inner2_struct_tid_first(sv)
            if s != "" { return s }
        }
        i = i - 1
    }
    let blink_name = c_blink_name(name)
    if blink_name != name {
        i = scope_vars.len() - 1
        while i >= 0 {
            let sv = scope_vars.get(i).unwrap()
            if sv.name == blink_name && sv.ctype == CT_OPTION {
                let s = sv_option_inner2_struct_tid_first(sv)
                if s != "" { return s }
            }
            i = i - 1
        }
    }
    ""
}

// Reconstruct an Option carrier's tid from its flat inner-struct name, for the
// population gap where set_var_option_struct is called on a fresh binder without a
// preceding tid stamp — the common Option[Struct] local, whose inner CT is erased to
// CT_VOID and whose struct name rides struct_name. Reverse-resolve that name to the
// inner tid and wrap it in an Option so the carrier readers can spell the var from its
// tid instead of only the flat channel. Restricted to a PLAIN, non-generic struct
// inner: those are the shape where the value-access and carrier-tag inner-name readers
// agree on the recovered name, so activating the tid path cannot diverge from the flat
// name. A transparent newtype, an enum, a generic-def head, a compound inner
// (Option/Result/Map), or a bare scalar has no plain struct name here and declines to
// -1, leaving the binder on ty=-1. Guarded by a round-trip: adopt the carrier only when
// its inner-name speller reproduces the exact flat struct_name, so a mis-resolved name
// declines rather than retyping the carrier.
fn option_carrier_tid_from_flat(struct_name: Str) -> Int {
    if struct_name == "" { return -1 }
    if is_struct_type(struct_name) == 0 { return -1 }
    if struct_def_is_generic(struct_name) != 0 { return -1 }
    let inner = nominal_struct_tid(struct_name)
    if inner < 0 { return -1 }
    let carrier = make_option_type(inner)
    if sev_option_inner_name(cg_bind_mono_tid(carrier)) == struct_name { carrier } else { -1 }
}

pub fn set_var_option_struct(name: Str, inner: Int, struct_name: Str) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_OPTION {
            // Update keeps the prior tid; only a fresh push reconstructs from the flat name.
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: inner, inner2: sv.inner2, sname: struct_name, sname2: sv.sname2, ty: sv.ty, tp_id: sv_tp(sv.ctype, inner, sv.inner2, struct_name) })
            return
        }
        i = i - 1
    }
    push_scope_var(ScopeVar { name: name, ctype: CT_OPTION, is_mut: 0, inner1: inner, inner2: -1, sname: struct_name, sname2: "", ty: option_carrier_tid_from_flat(struct_name), tp_id: sv_tp(CT_OPTION, inner, -1, struct_name) })
}

pub fn get_var_option_inner(name: Str) -> Int {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_OPTION {
            if sv.ty >= 0 {
                let c = tc_tid_option_inner_ct(cg_bind_mono_tid(sv.ty))
                // A struct/enum inner is name-carried through
                // get_var_option_inner_struct; decline it so the flat sname channel
                // keeps identity, mirroring get_list_elem_type's CT_ENUM decline.
                if c >= 0 && c != CT_STRUCT && c != CT_ENUM { return c }
            }
            return sv.inner1
        }
        i = i - 1
    }
    let alt = c_blink_name(name)
    if alt != name {
        let mut j = scope_vars.len() - 1
        while j >= 0 {
            let sv = scope_vars.get(j).unwrap()
            if sv.name == alt && sv.ctype == CT_OPTION {
                if sv.ty >= 0 {
                    let c = tc_tid_option_inner_ct(cg_bind_mono_tid(sv.ty))
                    if c >= 0 && c != CT_STRUCT && c != CT_ENUM { return c }
                }
                return sv.inner1
            }
            j = j - 1
        }
    }
    -1
}

// The struct-name channel is a struct-OR-enum name carrier: get_var_option_inner/_result_ok/_err
// decline a struct/enum inner CT so this string owns its identity, and consumers gate on != ""
// (never CT_STRUCT). tc_tid_option_inner_struct (via tid_inner_struct) spells a struct/enum/tuple
// inner as the BARE name that canonical_struct_tag's is_struct_type/is_enum_type gate expects; a
// nested Option/Result inner carries its carrier tag; a bare collection/scalar inner stays empty
// and routes through the CT_*/tid channels instead.
fn sev_nested_carrier_tag(inner_tid: Int) -> Str {
    // Resolve before composing the non-resolving tc_tid_ct/tc_tid_inner_tag: a
    // push-built List[Option[T]]/List[Result[..]] carries its element as a bound
    // metavar, so a `.get()`/`.pop()` result's inner1 is that metavar (kind Unknown),
    // not the Option/Result it solves to. Reading kind off the raw metavar declines to
    // "", erasing a let-bound double carrier's inner nominal on unwrap.
    let rt = tc_tid_resolved(inner_tid)
    let ick = tc_tid_ct(rt)
    if ick == CT_OPTION || ick == CT_RESULT { tc_tid_inner_tag(rt) } else { "" }
}

// Decline the names that are not usable as a by-value struct tag on this channel, so the flat
// channel stays authoritative for them: a generic-def bare head (Box) is the ERASED name (flat
// carries the mono stem Box_0Int; a resolved stem is not a generic-def name and passes); a
// payloadless enum and a transparent newtype are stored scalar (by ordinal / as a bare int),
// not as a struct with a .value payload, so name-carrying them mis-spells the carrier. A data
// enum has a real payload struct and passes.
fn sev_plain_struct(s: Str) -> Str {
    if s != "" && struct_def_is_generic(s) == 0 && is_transparent_newtype(s) == 0 && (is_enum_type(s) == 0 || is_data_enum(s) != 0) { s } else { "" }
}

// A payloadless enum stores its ordinal in a bare int, so sev_plain_struct declines it (a
// value-access reader keeps the value a scalar). Its CARRIER TAG still needs the nominal, because
// a payloadless enum is a distinct C type (blink_Grade) and the carrier is blink_Result_int_Grade
// with a `blink_Grade` field — so the carrier-tag accessors admit it here where the value readers
// decline. A TRANSPARENT newtype is NOT admitted here: its carrier tag DOES keep the nominal
// (blink_Result_Errno_str, over a bare int64_t field), but that nominal is recovered through the
// tid/flat channel, so this scalar-nominal channel declines it to avoid double-sourcing the name. A
// generic-def bare head also declines (its mono stem is the tag; a bare head erases the args).
fn sev_scalar_nominal_name(s: Str) -> Str {
    if s != "" && struct_def_is_generic(s) == 0 && is_transparent_newtype(s) == 0 && is_enum_type(s) != 0 && is_data_enum(s) == 0 { s } else { "" }
}

fn sev_option_inner_name(bt: Int) -> Str {
    let mono = tc_tid_option_inner_struct_mono(bt)
    if mono != "" { return mono }
    let s = sev_plain_struct(tc_tid_option_inner_struct(bt))
    if s != "" { return s }
    sev_nested_carrier_tag(tc_tid_option_inner_tid(bt))
}

pub fn get_var_option_inner_struct(name: Str) -> Str {
    let t = get_sv_ty(name, CT_OPTION)
    if t >= 0 { sev_option_inner_name(cg_bind_mono_tid(t)) } else { "" }
}

// Carrier-tag twin of sev_option_inner_name: identical, except it admits a scalar-erased
// nominal (transparent newtype / payloadless enum) that the value-access twin declines, so an
// Option[Code] carrier is named blink_Option_std_x_Code rather than losing the tag.
fn sev_option_inner_tag(bt: Int) -> Str {
    let mono = tc_tid_option_inner_struct_mono(bt)
    if mono != "" { return mono }
    let s = tc_tid_option_inner_struct(bt)
    let plain = sev_plain_struct(s)
    if plain != "" { return plain }
    let nominal = sev_scalar_nominal_name(s)
    if nominal != "" { return nominal }
    sev_nested_carrier_tag(tc_tid_option_inner_tid(bt))
}

// ROLE-1 carrier-tag accessor: the struct-name half that option_c_type_mixed expects, recovered
// from the authoritative tid and admitting scalar-erased nominals. The value-access reader
// (get_var_option_inner_struct) still declines those so a value stays by-value; these two roles
// diverge only for a transparent newtype / payloadless enum inner.
pub fn get_var_option_inner_tag(name: Str) -> Str {
    let t = get_sv_ty(name, CT_OPTION)
    if t >= 0 { sev_option_inner_tag(cg_bind_mono_tid(t)) } else { "" }
}

// VALUE-ACCESS nominal: the raw inner nominal for EVERY nominal inner — struct, data enum,
// payloadless enum AND transparent newtype (which the carrier-tag twin erases). An unwrap /
// match-bind reads this to pick deref-vs-scalar handling and to name the bound value's type;
// it must see the transparent newtype ("Errno") to take the scalar branch, and the payloadless
// enum ("Cmd") to take the boxed branch. Answers "" only for a genuine primitive scalar.
fn sev_option_inner_nominal(bt: Int) -> Str {
    let mono = tc_tid_option_inner_struct_mono(bt)
    if mono != "" { return mono }
    let s = tc_tid_option_inner_struct(bt)
    if s != "" { return s }
    sev_nested_carrier_tag(tc_tid_option_inner_tid(bt))
}

pub fn get_var_option_inner_nominal(name: Str) -> Str {
    let t = get_sv_ty(name, CT_OPTION)
    if t >= 0 { sev_option_inner_nominal(cg_bind_mono_tid(t)) } else { "" }
}

// Mark an Option var as physically ptr-erased to the shared handler-vtable ABI.
// The logical inner1/sname stay TRUE (aligned with the tid); this bit records that
// the stored value is a blink_Option_ptr box, so every physical speller reasserts the
// erased carrier and casts the void* payload back to the true struct.
pub fn set_var_option_erased(name: Str, e: Int) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_OPTION {
            let s = scope_var_scratch.get(i).unwrap()
            scope_var_scratch.set(i, ScopeVarScratch { opt_erased: e, ptr_struct: s.ptr_struct, ptr_is_array: s.ptr_is_array, iter_next_fn: s.iter_next_fn, iter_carrier: s.iter_carrier, iter_alias: s.iter_alias, handler_vtable_type: s.handler_vtable_type, handler_vtable_field: s.handler_vtable_field, handler_is_ue: s.handler_is_ue })
            return
        }
        i = i - 1
    }
}

pub fn get_var_option_erased(name: Str) -> Int {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_OPTION {
            return scope_var_scratch.get(i).unwrap().opt_erased
        }
        i = i - 1
    }
    let blink_name = c_blink_name(name)
    if blink_name != name {
        i = scope_vars.len() - 1
        while i >= 0 {
            let sv = scope_vars.get(i).unwrap()
            if sv.name == blink_name && sv.ctype == CT_OPTION {
                return scope_var_scratch.get(i).unwrap().opt_erased
            }
            i = i - 1
        }
    }
    0
}

pub fn set_var_result(name: Str, ok_t: Int, err_t: Int) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_RESULT {
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: ok_t, inner2: err_t, sname: sv.sname, sname2: sv.sname2, ty: sv.ty, tp_id: sv_tp(sv.ctype, ok_t, err_t, sv.sname) })
            return
        }
        i = i - 1
    }
    push_scope_var(ScopeVar { name: name, ctype: CT_RESULT, is_mut: 0, inner1: ok_t, inner2: err_t, sname: "", sname2: "", ty: -1, tp_id: sv_tp(CT_RESULT, ok_t, err_t, "") })
}

// One slot of a Result carrier, reverse-resolved from its flat CT + struct name to a tid.
// An empty sname is a bare scalar (its singleton tid); a non-empty sname is a PLAIN,
// non-generic struct (its nominal tid). Anything else — an enum, a transparent newtype, a
// generic head, a compound inner, or an unresolvable scalar — declines to -1. A CT_VOID
// scalar slot declines too: a bare-Void slot is the erasure ambiguity, not a Result[Void, _].
fn result_slot_tid_from_flat(ct: Int, sname: Str) -> Int {
    if sname == "" {
        if ct == CT_VOID { return -1 }
        return tc_scalar_tid_for_ct(ct)
    }
    if is_struct_type(sname) == 0 { return -1 }
    if struct_def_is_generic(sname) != 0 { return -1 }
    nominal_struct_tid(sname)
}

// Per-slot round-trip on the reconstructed carrier. The guard is slot-shape-aware because the
// value-access CT reader (get_var_result_*) declines CT_STRUCT/CT_ENUM and keeps flat inner1:
// a struct slot only needs its name reproduced (the CT is preserved regardless), a scalar slot
// needs its CT reproduced and its name to stay empty, so activating the tid path cannot diverge.
fn result_slot_roundtrip_ok(sname: Str, ct: Int, back_name: Str, back_ct: Int) -> Int {
    if sname != "" {
        if back_name == sname { 1 } else { 0 }
    } else {
        if back_ct == ct && back_name == "" { 1 } else { 0 }
    }
}

// Reconstruct a Result carrier's tid from its flat ok/err slots, the Result twin of
// option_carrier_tid_from_flat, for the same fresh-push population gap where
// set_var_result_struct lands on a binder with no preceding tid stamp. Unlike the Option
// sibling — whose flat inner is only ever a struct — a Result slot is routinely a bare scalar
// (Result[Int, Str]), so each slot reconstructs scalar and plain-struct shapes alike. Both
// slots must reconstruct and both must round-trip, or the whole carrier declines to -1 and the
// binder stays on ty=-1, where the ok/err struct-name readers answer "" (no flat-name fallback).
fn result_carrier_tid_from_flat(ok_t: Int, err_t: Int, ok_s: Str, err_s: Str) -> Int {
    let ok_tid = result_slot_tid_from_flat(ok_t, ok_s)
    if ok_tid < 0 { return -1 }
    let err_tid = result_slot_tid_from_flat(err_t, err_s)
    if err_tid < 0 { return -1 }
    let carrier = make_result_type(ok_tid, err_tid)
    let bound = cg_bind_mono_tid(carrier)
    if result_slot_roundtrip_ok(ok_s, ok_t, sev_result_ok_name(bound), tc_tid_result_ok_ct(bound)) == 0 { return -1 }
    if result_slot_roundtrip_ok(err_s, err_t, sev_result_err_name(bound), tc_tid_result_err_ct(bound)) == 0 { return -1 }
    carrier
}

pub fn set_var_result_struct(name: Str, ok_t: Int, err_t: Int, ok_s: Str, err_s: Str) {
    let mut i = scope_vars.len() - 1
    while i >= 0 {
        let sv = scope_vars.get(i).unwrap()
        if sv.name == name && sv.ctype == CT_RESULT {
            // Update keeps the prior tid; only a fresh push reconstructs the tid from the flat names.
            // The err name rides the tid (get_var_result_err_struct reads it there), so sname2 is left
            // untouched; sname keeps ok_s only because it feeds the pool key below.
            scope_vars.set(i, ScopeVar { name: sv.name, ctype: sv.ctype, is_mut: sv.is_mut, inner1: ok_t, inner2: err_t, sname: ok_s, sname2: sv.sname2, ty: sv.ty, tp_id: sv_tp(CT_RESULT, ok_t, err_t, ok_s) })
            return
        }
        i = i - 1
    }
    push_scope_var(ScopeVar { name: name, ctype: CT_RESULT, is_mut: 0, inner1: ok_t, inner2: err_t, sname: ok_s, sname2: "", ty: result_carrier_tid_from_flat(ok_t, err_t, ok_s, err_s), tp_id: sv_tp(CT_RESULT, ok_t, err_t, ok_s) })
}

// Precondition: fs.starts_with("Option_")
pub fn set_var_option_from_struct_tag(name: Str, fs: Str) {
    let inner_tag = fs.slice(7, fs.len())
    let inner_ct = type_from_name_tag(inner_tag)
    if is_named_typedef_tag(inner_tag) != 0 {
        set_var_option_struct(name, inner_ct, inner_tag)
    } else {
        set_var_option(name, inner_ct)
    }
}

// Precondition: fs.starts_with("Result_"). Malformed tags (no second segment)
// leave inner types unset — caller's prior set_var establishes CT_RESULT.
pub fn set_var_result_from_struct_tag(name: Str, fs: Str) {
    let split = split_result_compound(fs)
    if split.second != "" {
        let ok_ct = type_from_name_tag(split.first)
        let err_ct = type_from_name_tag(split.second)
        let ok_s = typedef_tag_or_empty(split.first)
        let err_s = typedef_tag_or_empty(split.second)
        if ok_s != "" || err_s != "" {
            set_var_result_struct(name, ok_ct, err_ct, ok_s, err_s)
        } else {
            set_var_result(name, ok_ct, err_ct)
        }
    }
}

// Convert an annotation-form type string (`Option[Str]`, `Result[Int, Str]`,
// `Map[Str, Str]`, `Foo`, `Int`) into its carrier/struct tag form
// (`Option_str`, `Result_int_str`, `map`, `Foo`, `int`). Recurses on nested
// by-value compound inners (Option/Result) so the tag matches the emitted
// typedef; Map is an erased carrier (one blink_map* per shape) so it drops K/V
// and falls to the flat `map` tag like List/Set.
fn compound_tag_from_type_str(s: Str) -> Str {
    let ct = type_from_name(s)
    let bracket_pos = s.index_of("[")
    if is_compound_ct(ct) != 0 && bracket_pos > 0 {
        let inner = s.substr(bracket_pos + 1, s.len() - bracket_pos - 2)
        let parts = split_top_level_commas(inner)
        if ct == CT_OPTION && parts.len() >= 1 {
            return "Option_{compound_tag_from_type_str(parts.get(0).unwrap())}"
        } else if ct == CT_RESULT && parts.len() >= 2 {
            return "Result_{compound_tag_from_type_str(parts.get(0).unwrap())}_{compound_tag_from_type_str(parts.get(1).unwrap())}"
        }
    }
    let bare = strip_module_qualifier(s)
    if is_struct_type(bare) != 0 || is_enum_type(bare) != 0 {
        return bare
    }
    c_type_tag(ct)
}

fn split_top_level_commas(s: Str) -> List[Str] {
    let mut out: List[Str] = []
    let mut seg_start = 0
    let mut depth = 0
    let mut i = 0
    while i < s.len() {
        let b = s.byte_at(i)
        if b == 91 {
            depth = depth + 1
        } else if b == 93 {
            depth = depth - 1
        } else if b == 44 && depth == 0 {
            out.push(s.substr(seg_start, i - seg_start).trim())
            seg_start = i + 1
        }
        i = i + 1
    }
    out.push(s.substr(seg_start, s.len() - seg_start).trim())
    out
}

// Register compound-carrier inner-type metadata on a bound variable from its
// annotation-form field type string (`Option[Str]`, `Result[Int, Str]`).
pub fn register_var_compound_inner_from_str(name: Str, type_str: Str) {
    let ct = type_from_name(type_str)
    let tag = compound_tag_from_type_str(type_str)
    if ct == CT_OPTION && tag.starts_with("Option_") {
        set_var_option_from_struct_tag(name, tag)
    } else if ct == CT_RESULT && tag.starts_with("Result_") {
        set_var_result_from_struct_tag(name, tag)
    }
}

// Register a variable bound to a whole compound CARRIER TAG (`Option_int`, `Result_int_str`) — the
// tag-form twin of register_var_compound_inner_from_str above, which takes an annotation STRING. A
// bare-typevar param `x: T` bound to a compound resolves to the carrier tag rather than a head
// name, so type_from_name alone answers CT_VOID.
//
// set_var must run BEFORE the set_var_*_from_struct_tag decoders: both decoders PUSH their own
// fully-populated ScopeVar when they find none to attach to, and find_scope_var returns the topmost
// push, so decoding first would shadow the decoders' correctly-typed var under a bare
// CT_OPTION/CT_RESULT one with no inner metadata.
//
// ensure_carrier_from_tag runs on the RAW tag, not `canon`: its Result branch re-canonicalizes
// internally with a different splitter, so feeding it an already-canonical tag double-applies a
// non-idempotent transform and can register a different typedef than the signature side emitted for
// the identical source tag.
//
// No Map arm. It is unreachable — tc_tid_to_c_tag spells a Map as the bare "Map", never "Map_k_v" —
// and unsafe to add speculatively: every Map lowers to one `blink_map*`, and set_map_types would
// need K/V the tag cannot always supply, so calling it with the -1 sentinel swaps a loud `void` for
// a silently wrong `.get()`/`.insert()`. The CT_MAP arm below is a backstop for that invariant, not
// a Map implementation: if it fires, the tc_tid_to_c_tag invariant has broken elsewhere.
pub fn register_var_compound_from_tag(name: Str, tag: Str, is_mut: Int) ! Codegen.Scope, Diag.Report {
    ensure_carrier_from_tag(tag)
    let canon = canonical_struct_tag(tag)
    let ct = compound_tag_ct(canon)
    set_var(name, ct, is_mut)
    if ct == CT_OPTION {
        set_var_option_from_struct_tag(name, canon)
    } else if ct == CT_RESULT {
        set_var_result_from_struct_tag(name, canon)
    } else if ct == CT_MAP {
        diag_ice_no_loc("MapTagReachedCarrierScope", MAP_TAG_REACHED_CARRIER_SCOPE,
            "Map-shaped compound tag '{tag}' reached register_var_compound_from_tag's scope registration",
            "tc_tid_to_c_tag should never spell TyKind.Map structurally — this invariant broke")
    }
}

pub fn get_var_result_ok(name: Str) -> Int {
    let t = get_sv_ty(name, CT_RESULT)
    if t >= 0 {
        let c = tc_tid_result_ok_ct(cg_bind_mono_tid(t))
        // A struct/enum Ok is name-carried via get_var_result_ok_struct; decline it
        // so the flat sname channel keeps identity, mirroring get_var_option_inner.
        if c >= 0 && c != CT_STRUCT && c != CT_ENUM { return c }
    }
    get_sv_inner1(name, CT_RESULT)
}

pub fn get_var_result_err(name: Str) -> Int {
    let t = get_sv_ty(name, CT_RESULT)
    if t >= 0 {
        let c = tc_tid_result_err_ct(cg_bind_mono_tid(t))
        if c >= 0 && c != CT_STRUCT && c != CT_ENUM { return c }
    }
    get_sv_inner2(name, CT_RESULT)
}

fn sev_result_ok_name(bt: Int) -> Str {
    let mono = tc_tid_result_ok_struct_mono(bt)
    if mono != "" { return mono }
    let s = sev_plain_struct(tc_tid_result_ok_struct(bt))
    if s != "" { return s }
    sev_nested_carrier_tag(tc_tid_result_ok_tid(bt))
}

fn sev_result_err_name(bt: Int) -> Str {
    let mono = tc_tid_result_err_struct_mono(bt)
    if mono != "" { return mono }
    let s = sev_plain_struct(tc_tid_result_err_struct(bt))
    if s != "" { return s }
    sev_nested_carrier_tag(tc_tid_result_err_tid(bt))
}

pub fn get_var_result_ok_struct(name: Str) -> Str {
    let t = get_sv_ty(name, CT_RESULT)
    if t >= 0 { sev_result_ok_name(cg_bind_mono_tid(t)) } else { "" }
}

pub fn get_var_result_err_struct(name: Str) -> Str {
    let t = get_sv_ty(name, CT_RESULT)
    if t >= 0 { sev_result_err_name(cg_bind_mono_tid(t)) } else { "" }
}

// Carrier-tag twins of sev_result_ok_name / sev_result_err_name: identical, except they admit a
// scalar-erased nominal (transparent newtype / payloadless enum) that the value-access twins
// decline, so a Result[Int, Code] err carrier is named blink_Result_int_std_x_Code, not _void.
fn sev_result_ok_tag(bt: Int) -> Str {
    let mono = tc_tid_result_ok_struct_mono(bt)
    if mono != "" { return mono }
    let s = tc_tid_result_ok_struct(bt)
    let plain = sev_plain_struct(s)
    if plain != "" { return plain }
    let nominal = sev_scalar_nominal_name(s)
    if nominal != "" { return nominal }
    sev_nested_carrier_tag(tc_tid_result_ok_tid(bt))
}

fn sev_result_err_tag(bt: Int) -> Str {
    let mono = tc_tid_result_err_struct_mono(bt)
    if mono != "" { return mono }
    let s = tc_tid_result_err_struct(bt)
    let plain = sev_plain_struct(s)
    if plain != "" { return plain }
    let nominal = sev_scalar_nominal_name(s)
    if nominal != "" { return nominal }
