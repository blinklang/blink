import std.path.{path_join}

fn resolve_blink_root() -> Str {
    env.var("BLINK_ROOT") ?? ""
}

fn blinkc_path() -> Str {
    let root = resolve_blink_root()
    if root != "" {
        let p = path_join(root, "build/blinkc")
        if file_exists(p) == 1 {
            return p
        }
    }
    "build/blinkc"
}

fn archive_dir() -> Str {
    let root = resolve_blink_root()
    if root != "" {
        let candidate = path_join(root, "build/libblink_std.a")
        if file_exists(candidate) == 1 {
            return path_join(root, "build")
        }
    }
    "build"
}

fn run_compile(path: Str, src: Str) -> Str {
    write_file(path, src)
    let args = [path, "/dev/null", "--format", "json"]
    let result = process_run(blinkc_path(), args)
    let output = "{result.out}{result.err_out}"
    fs_remove(path)
    output
}

// Compile `source` and return the compiler's DIAGNOSTIC OUTPUT — stdout plus stderr, in
// --format json. The emitted C goes to /dev/null and is never returned.
//
// So an assertion on this string can only ever see a diagnostic. Asserting that emitted C
// lacks a codegen sentinel (BLINK_COMPILER_BUG_kops_unsupported, a `_Void` mono name, a
// `void` field) against this output is VACUOUS — the needle could not appear whether or not
// codegen produced it. Use compile_and_emit_c for any claim about emitted C, and note that it
// read_file()s the output unconditionally, so it aborts the whole test binary when the
// program does not reach codegen. A row asserting on a program that is rejected before
// codegen must therefore use this function and assert on the DIAGNOSTIC.
//
// The one sentinel spelling that legitimately appears here is BLINK_I0001_*: the
// UnsolvedTypeVarAtCodegen diagnostic embeds the erased mono name in its message text.
pub fn compile_and_capture(source: Str, tag: Str) -> Str {
    run_compile(".tmp/{tag}.bl", source)
}

// These four print the label and then assert. The print is what names WHICH check failed —
// the assertion message alone cannot, since every row funnels through the same line here.
// They must assert: `blink test` does not scan stdout, so a print-only helper makes every row
// built on it pass whatever the compiler does.
pub fn expect_error(output: Str, code: Str, label: Str) {
    let ok = output.contains(code)
    if ok {
        io.println("PASS: {label}")
    } else {
        io.println("FAIL: {label} — expected {code} in output")
    }
    assert(ok)
}

pub fn expect_contains(output: Str, needle: Str, label: Str) {
    let ok = output.contains(needle)
    if ok {
        io.println("PASS: {label}")
    } else {
        io.println("FAIL: {label} — expected '{needle}' in output")
    }
    assert(ok)
}

pub fn expect_warning(output: Str, code: Str, label: Str) {
    let ok = output.contains(code) && output.contains("\"severity\":\"warning\"")
    if ok {
        io.println("PASS: {label}")
    } else {
        io.println("FAIL: {label} — expected {code} at severity warning in output")
    }
    assert(ok)
}

pub fn expect_clean(output: Str, label: Str) {
    let dirty = output.contains("E0900") || output.contains("E0901") || output.contains("E0902") || output.contains("E0903") || output.contains("E0905")
    if dirty {
        io.println("FAIL: {label} — unexpected trait contract error in output")
    } else {
        io.println("PASS: {label}")
    }
    assert(!dirty)
}

pub fn expect_compile_error(src: Str, tag: Str, error_code: Str) {
    let output = run_compile(".tmp/_test_{tag}.bl", src)
    assert(output.contains(error_code))
}

pub fn expect_no_error(src: Str, tag: Str, error_code: Str) {
    let output = run_compile(".tmp/_test_{tag}.bl", src)
    assert(!output.contains(error_code))
}

// Stage a two-file package under .tmp/<tag>/ (with a blink.toml so imports resolve),
// compile the entry, and assert the diagnostic `error_code` appears. Used for
// whole-program / cross-module checks that a single-file compile cannot exercise.
pub fn expect_compile_error_xmod(entry_src: Str, helper_name: Str, helper_src: Str, tag: Str, error_code: Str) {
    let root = ".tmp/{tag}"
    let src_dir = "{root}/src"
    let _mk = process_run("mkdir", ["-p", src_dir])
    write_file("{root}/blink.toml", "[package]\nname = \"{tag}\"\nversion = \"0.1.0\"\n")
    write_file("{src_dir}/{helper_name}.bl", helper_src)
    let entry_path = "{src_dir}/{tag}.bl"
    write_file(entry_path, entry_src)
    let result = process_run(blinkc_path(), [entry_path, "/dev/null", "--format", "json"])
    let output = "{result.out}{result.err_out}"
    assert(output.contains(error_code))
}

// Inverse of expect_compile_error_xmod: stage a two-file package and assert the
// entry compiles WITHOUT errors and that `error_code` in particular is absent.
// The compile-clean check (no "severity":"error") prevents a false green where an
// UNRELATED error makes the code-absence assertion pass vacuously. Used to lock
// no-false-positive guarantees (e.g. a pub item reached via a qualified form).
pub fn expect_no_error_xmod(entry_src: Str, helper_name: Str, helper_src: Str, tag: Str, error_code: Str) {
    let root = ".tmp/{tag}"
    let src_dir = "{root}/src"
    let _mk = process_run("mkdir", ["-p", src_dir])
    write_file("{root}/blink.toml", "[package]\nname = \"{tag}\"\nversion = \"0.1.0\"\n")
    write_file("{src_dir}/{helper_name}.bl", helper_src)
    let entry_path = "{src_dir}/{tag}.bl"
    write_file(entry_path, entry_src)
    let result = process_run(blinkc_path(), [entry_path, "/dev/null", "--format", "json"])
    let output = "{result.out}{result.err_out}"
    assert(!output.contains("\"severity\":\"error\""))
    assert(!output.contains(error_code))
}

// Stage a two-file package under .tmp/<tag>/ and return the diagnostic JSON, so a
// caller can assert on message text (not just the presence of a code).
pub fn compile_xmod_capture(entry_src: Str, helper_name: Str, helper_src: Str, tag: Str) -> Str {
    let root = ".tmp/{tag}"
    let src_dir = "{root}/src"
    let _mk = process_run("mkdir", ["-p", src_dir])
    write_file("{root}/blink.toml", "[package]\nname = \"{tag}\"\nversion = \"0.1.0\"\n")
    write_file("{src_dir}/{helper_name}.bl", helper_src)
    let entry_path = "{src_dir}/{tag}.bl"
    write_file(entry_path, entry_src)
    let result = process_run(blinkc_path(), [entry_path, "/dev/null", "--format", "json"])
    "{result.out}{result.err_out}"
}

// Stage a single-file package under .tmp/<tag>/ whose blink.toml carries a
// [lints] section, compile the entry with cwd at the repo root (so the
// manifest must be resolved from the package root of the compiled file,
// not the cwd), and return the diagnostic JSON.
pub fn compile_pkg_and_capture(src: Str, lints: Str, tag: Str) -> Str {
    let root = ".tmp/{tag}"
    let src_dir = "{root}/src"
    let _mk = process_run("mkdir", ["-p", src_dir])
    write_file("{root}/blink.toml", "[package]\nname = \"{tag}\"\nversion = \"0.1.0\"\n\n[lints]\n{lints}\n")
    let entry_path = "{src_dir}/{tag}.bl"
    write_file(entry_path, src)
    let result = process_run(blinkc_path(), [entry_path, "/dev/null", "--format", "json"])
    "{result.out}{result.err_out}"
}

// Stage a two-file package under .tmp/<tag>/ and drive the FULL pipeline
// (compile -> C -> link -> run) via `build/blink run`. Returns the run result so
// a caller can assert exit code / stdout. Needed for cross-module codegen bugs
// (e.g. znad0f) whose symptom is a C link error the `--format json` stage cannot
// observe, since blinkc only emits C and never invokes the C compiler.
// `helper_dir` is the package subdir (e.g. "om") so the file lands at
// src/<helper_dir>/<helper_base>.bl, mirroring the import path `helper_dir.helper_base`.
pub fn run_xmod(entry_src: Str, helper_dir: Str, helper_base: Str, helper_src: Str, tag: Str) -> RunResult {
    let root = ".tmp/{tag}"
    let src_dir = "{root}/src"
    let _mk = process_run("mkdir", ["-p", "{src_dir}/{helper_dir}"])
    write_file("{root}/blink.toml", "[package]\nname = \"{tag}\"\nversion = \"0.1.0\"\n")
    write_file("{src_dir}/{helper_dir}/{helper_base}.bl", helper_src)
    let entry_path = "{src_dir}/main.bl"
    write_file(entry_path, entry_src)
    let r = process_run("build/blink", ["run", entry_path])
    RunResult { exit_code: r.exit_code, out: r.out, err_out: r.err_out }
}

pub fn check_via_cli(src: Str, tag: Str) -> Str {
    let path = ".tmp/_chk_{tag}.bl"
    write_file(path, src)
    let result = process_run("build/blink", ["check", path, "--format", "json"])
    let output = "{result.out}{result.err_out}"
    fs_remove(path)
    output
}

// Drive `blink audit --ffi [--json] <path>` over `src` and return its stdout.
// Used to exercise the FFI audit report (e.g. the bytes-bridge / byte-pin
// subcategory) end to end through the real CLI.
pub fn audit_ffi_via_cli(src: Str, tag: Str, json: Int) -> Str {
    let path = ".tmp/_audit_{tag}.bl"
    write_file(path, src)
    let args = if json != 0 { ["audit", "--ffi", "--json", path] } else { ["audit", "--ffi", path] }
    let result = process_run("build/blink", args)
    let output = "{result.out}{result.err_out}"
    fs_remove(path)
    output
}

pub fn verify_catalog_entry(code: Str, short_name: Str) {
    let res = process_run("build/blink", ["explain", code])
    assert_eq(res.exit_code, 0)
    assert(res.out.contains(code))
    assert(res.out.contains(short_name))
}

// Scan emitted C for struct/enum typedef names beginning with `blink_{base}`
// (an exact match on `base` itself, or `base` followed by `_`) and return
// every distinct one found, in first-seen order. Each typedef's closing line
// has the shape `} blink_<name>;` (see emit_mono_struct_typedef /
// emit_mono_enum_typedef, src/codegen_stmt.bl) regardless of how <name>'s
// tail is mangled — this reads the STRUCTURE of that line, not a specific
// mangling scheme's spelling, so it survives future mangler changes
// without every caller needing to hardcode an exact mangled name.
//
// Deliberately does not care WHAT comes after `blink_{base}` — that is
// exactly the part a caller should assert about relationally (distinct
// instantiations produce distinct entries here) rather than by literal
// spelling.
pub fn mono_typedef_names(c: Str, base: Str) -> List[Str] {
    let prefix = "} blink_{base}"
    let prefix_len = prefix.len()
    let lines = c.lines()
    let mut out: List[Str] = []
    let mut i = 0
    while i < lines.len() {
        let line = lines.get(i).unwrap()
        let trimmed = line.trim()
        if trimmed.starts_with(prefix) {
            // trimmed = "} blink_{base}<tail>;" — the char right after the
            // prefix must be end-of-name (';', an exact match) or '_' (a
            // separator into the mangled tail); anything else means `base`
            // is only a PREFIX of some other base's name (e.g. "Box" vs
            // "BoxOfBoxes") and this line must be skipped.
            let next_byte = trimmed.byte_at(prefix_len)
            if next_byte == 59 || next_byte == 95 {
                let name_start = 2
                let semi = trimmed.index_of(";")
                if semi > name_start {
                    let name = trimmed.substring(name_start, semi - name_start)
                    if !out.contains(name) {
                        out.push(name)
                    }
                }
            }
        }
        i = i + 1
    }
    out
}

// True iff at least one typedef named `blink_{base}...` was emitted for `base`.
pub fn has_mono_instance(c: Str, base: Str) -> Int {
    if mono_typedef_names(c, base).len() > 0 { 1 } else { 0 }
}

// Every byte of `s` except '_' (95), concatenated. Used to compare a `base` against a
// mangled candidate name while being agnostic to any underscore-escaping scheme the
// mangler applies — an escape scheme only ever inserts/rewrites '_' bytes, so stripping
// them from both sides before comparing survives a scheme change without knowing what
// the scheme is.
fn strip_underscores(s: Str) -> Str {
    let mut result = ""
    let mut i = 0
    while i < s.len() {
        if s.byte_at(i) != 95 {
            result = result.concat(s.substring(i, 1))
        }
        i = i + 1
    }
    result
}

// The last occurrence of `needle` in `s` at or before byte offset `before` (exclusive),
// or -1 if none. Used to find the `blink_` that starts the FUNCTION NAME on a definition
// line, as opposed to one that starts the RETURN TYPE — a monomorphized struct/enum return
// type (`blink_RGT_0Int blink_mk_0Int(void) {`) also spells `blink_`, and it comes first,
// so the naive "first blink_ before the paren" scan picks the return type's name instead
// of the function's own name. The function name is always the LAST `blink_` immediately
// preceding the parameter list's `(`, so scanning from the right is unambiguous.
fn last_index_of_before(s: Str, needle: Str, before: Int) -> Int {
    let needle_len = needle.len()
    let mut result = -1
    let mut start = 0
    while start + needle_len <= before {
        if s.substring(start, needle_len) == needle {
            result = start
        }
        start = start + 1
    }
    result
}

// The function-symbol twin of mono_typedef_names, for a monomorphized generic FN or
// poly-impl method (e.g. a `impl[T] Trait[T] for List[T]` method, whose base is itself
// a compound name like "List_Echoable_echo" — already containing "_" before any
// mangling happens at all, so a literal "blink_{base}" prefix match would miss it the
// moment the mangler escapes those pre-existing underscores). A definition line has the
// shape `<ret-type> blink_<mangled-name>(<params>) {` (see e.g. emit_fn_def /
// emit_poly_impl_call, src/codegen_stmt.bl / codegen_methods.bl) — this reads that
// structure, comparing underscore-STRIPPED names, so it survives future mangler changes
// without needing to know what escaping scheme (if any) is in play.
//
// Uses the LAST `blink_` before the paren, not the first — a monomorphized-struct return
// type (e.g. `blink_RGT_0Int blink_mk_0Int(void) {`) also spells `blink_`, and it precedes
// the function name's own `blink_`, so the first-match scan a prior version of this
// function used would misidentify the return type as the function name and never find
// the real one (a real, reproduced defect — see tests/test_cr4gqk_mono_typedef_names_helper.bl's
// "mono_fn_names: a monomorphized struct return type does not shadow the fn name" row).
pub fn mono_fn_names(c: Str, base: Str) -> List[Str] {
    let stripped_base = strip_underscores(base)
    let lines = c.lines()
    let mut out: List[Str] = []
    let mut i = 0
    while i < lines.len() {
        let line = lines.get(i).unwrap()
        let trimmed = line.trim()
        let paren = trimmed.index_of("(")
        if paren > 0 && trimmed.ends_with(") \{") {
            let blink_at = last_index_of_before(trimmed, "blink_", paren)
            if blink_at >= 0 && blink_at < paren {
                let name = trimmed.substring(blink_at, paren - blink_at)
                let tail = trimmed.substring(blink_at + 6, paren - blink_at - 6)
                let stripped_tail = strip_underscores(tail)
                if stripped_tail.starts_with(stripped_base) {
                    if !out.contains(name) {
                        out.push(name)
                    }
                }
            }
        }
        i = i + 1
    }
    out
}

// True iff at least one function named `blink_{base}...` was DEFINED (not merely
// declared/prototyped) for `base`.
pub fn has_mono_fn_instance(c: Str, base: Str) -> Int {
    if mono_fn_names(c, base).len() > 0 { 1 } else { 0 }
}

// KNOWN COUPLING: unlike mono_typedef_names/mono_fn_names, this helper DOES
// assume today's _0/_1 escape scheme (src/codegen_types.bl:escape_mono_seg).
// It exists only because a poly-impl-on-builtin base (e.g. "List_Echoable_echo")
// already contains '_' before mangling, and underscore-stripping alone can't
// disambiguate escaped digits from real name characters. If escape_mono_seg's
// scheme changes, THIS helper (and only this one) needs a matching update.
//
// Rather than reverse-engineer the mangled tail, this forward-applies the same
// escape (`_` -> `_1`) to `base` locally, then does a literal `blink_{escaped}`
// prefix match on a function-definition line — the same line shape mono_fn_names
// scans. Reimplemented locally (not imported from codegen_types) to avoid pulling
// compile_test_helpers.bl into codegen_types.bl's whole-program-merge free-load
// hazard (it reads globals like tc_alias_to_original outside its own import list).
fn escape_mono_seg_for_test(s: Str) -> Str {
    let mut result = ""
    let mut i = 0
    while i < s.len() {
        if s.byte_at(i) == 95 {
            result = result.concat("_1")
        } else {
            result = result.concat(s.substring(i, 1))
        }
        i = i + 1
    }
    result
}

pub fn poly_impl_fn_names(c: Str, base: Str) -> List[Str] {
    let prefix = "blink_{escape_mono_seg_for_test(base)}"
    let prefix_len = prefix.len()
    let lines = c.lines()
    let mut out: List[Str] = []
    let mut i = 0
    while i < lines.len() {
        let line = lines.get(i).unwrap()
        let trimmed = line.trim()
        let paren = trimmed.index_of("(")
        if paren > 0 && trimmed.ends_with(") \{") {
            // Same shadow hazard mono_fn_names has: a monomorphized-struct return
            // type can also match `prefix` and precede the fn name on the line, so
            // find the LAST match before the paren, not the first.
            let blink_at = last_index_of_before(trimmed, prefix, paren)
            if blink_at >= 0 && blink_at < paren {
                let after = trimmed.byte_at(blink_at + prefix_len)
                if after == 40 || after == 95 {
                    let name = trimmed.substring(blink_at, paren - blink_at)
                    if !out.contains(name) {
                        out.push(name)
                    }
                }
            }
        }
        i = i + 1
    }
    out
}

// True iff at least one function named `blink_{escaped base}...` was DEFINED
// for `base`, under today's _0/_1 escape scheme. See poly_impl_fn_names.
pub fn has_poly_impl_fn_instance(c: Str, base: Str) -> Int {
    if poly_impl_fn_names(c, base).len() > 0 { 1 } else { 0 }
}

// Compile `src` to a real .c file and return the emitted C source. Used
// to inspect what codegen produced for a given construct without running
// the compiled binary.
pub fn compile_and_emit_c(src: Str, tag: Str) -> Str {
    let bl_path = ".tmp/{tag}.bl"
    let c_path = ".tmp/{tag}.c"
    write_file(bl_path, src)
    let args = [bl_path, c_path]
    let _result = process_run(blinkc_path(), args)
    let c_src = read_file(c_path)
    fs_remove(bl_path)
    fs_remove(c_path)
    c_src
}

// Compile `src` to a binary, run it, and return (exit_code, stderr).
pub type RunResult {
    exit_code: Int
    out: Str
    err_out: Str
}

pub fn compile_and_run(src: Str, tag: Str) -> RunResult {
    let bl_path = ".tmp/{tag}.bl"
    let c_path = ".tmp/{tag}.c"
    let bin_path = ".tmp/{tag}_bin"
    write_file(bl_path, src)
    let arc_dir = archive_dir()
    let cargs = ["--link-archive", path_join(arc_dir, "libblink_std.h"), bl_path, c_path]
    let cresult = process_run(blinkc_path(), cargs)
    if cresult.exit_code != 0 {
        fs_remove(bl_path)
        return RunResult { exit_code: cresult.exit_code, out: cresult.out, err_out: cresult.err_out }
    }
    let lnk = process_run("cc", ["-I{arc_dir}", "-o", bin_path, c_path, path_join(arc_dir, "libblink_std.a"), "-lm", "-lgc", "-pthread", "-Wl,--gc-sections"])
    if lnk.exit_code != 0 {
        fs_remove(bl_path)
        fs_remove(c_path)
        return RunResult { exit_code: lnk.exit_code, out: lnk.out, err_out: lnk.err_out }
    }
    let r = process_run(bin_path, [])
    fs_remove(bl_path)
    fs_remove(c_path)
    fs_remove(bin_path)
    RunResult { exit_code: r.exit_code, out: r.out, err_out: r.err_out }
}

// Compile a fixture that contains `test` blocks (so codegen auto-enables test
// mode and the panic catch dispatch), then run the test binary with
// --test-json and return its output. Used to exercise assert_panics emit-site
// behavior (E0831/E0832, pass-consumes-panic) by asserting on the runner's
// own JSON, since a failing assert_panics cannot be observed from a passing
// test in the same run.
pub fn compile_and_run_test_json(src: Str, tag: Str) -> RunResult {
    let bl_path = ".tmp/{tag}.bl"
    let c_path = ".tmp/{tag}.c"
    let bin_path = ".tmp/{tag}_bin"
    write_file(bl_path, src)
    let arc_dir = archive_dir()
    let cargs = ["--link-archive", path_join(arc_dir, "libblink_std.h"), bl_path, c_path]
    let cresult = process_run(blinkc_path(), cargs)
    if cresult.exit_code != 0 {
        fs_remove(bl_path)
        return RunResult { exit_code: cresult.exit_code, out: cresult.out, err_out: cresult.err_out }
    }
    let lnk = process_run("cc", ["-I{arc_dir}", "-o", bin_path, c_path, path_join(arc_dir, "libblink_std.a"), "-lm", "-lgc", "-pthread", "-Wl,--gc-sections"])
    if lnk.exit_code != 0 {
        fs_remove(bl_path)
        fs_remove(c_path)
        return RunResult { exit_code: lnk.exit_code, out: lnk.out, err_out: lnk.err_out }
    }
    let r = process_run(bin_path, ["--test-json"])
    fs_remove(bl_path)
    fs_remove(c_path)
    fs_remove(bin_path)
    RunResult { exit_code: r.exit_code, out: r.out, err_out: r.err_out }
}
