import std.path.{path_join, path_basename}
import std.process.{ProcessResult, ChildEnd}
import std.fs.{FsErrorExt}

// Whether there is anything at path. A stat that fails for another reason than a missing
// entry counts as there, so the read that follows reports that error.
pub fn path_exists(path: Str) -> Bool ! FS.Read {
    match fs.stat(path) {
        Ok(_) => true
        Err(e) => !e.not_found()
    }
}

// The text at path, or "" when there is none, as for the output of a compile that failed.
// Any other read error stops the test.
fn read_if_there(path: Str) -> Str ! FS.Read {
    match fs.read(path) {
        Ok(text) => text
        Err(e) => {
            if !e.not_found() { panic("{e}") }
            ""
        }
    }
}

fn resolve_blink_root() -> Str ! Env.Read {
    env.var("BLINK_ROOT") ?? ""
}

fn blinkc_path() -> Str ! FS.Read, Env.Read {
    let root = resolve_blink_root()
    if root != "" {
        let p = path_join(root, "build/blinkc")
        if path_exists(p) {
            return p
        }
    }
    "build/blinkc"
}

fn archive_dir() -> Str ! FS.Read, Env.Read {
    let root = resolve_blink_root()
    if root != "" {
        let candidate = path_join(root, "build/libblink_std.a")
        if path_exists(candidate) {
            return path_join(root, "build")
        }
    }
    "build"
}

// The directory a test process writes its scratch files under. `blink test` names one per
// test binary in BLINK_TEST_SCRATCH_DIR and removes it when the binary ends. Without that
// (a binary run by hand, or by the corpus, which gives each file its own TMPDIR), the
// directory is one per process below $TMPDIR (or /tmp when that is unset or empty). A process
// id is unique among live processes, so parallel test binaries, a corpus sweep and a gate in
// another worktree never share a directory. Same process, same path, so no state is kept
// between calls.
pub fn scratch_root() -> Str ! Env.Read, Process.Spawn {
    let named = env.var("BLINK_TEST_SCRATCH_DIR") ?? ""
    let dir = if named != "" {
        named
    } else {
        let tmp = env.var("TMPDIR") ?? ""
        let base = if tmp == "" { "/tmp" } else { tmp }
        "{base}/blink-test-{getpid()}"
    }
    let _mk = process.run("mkdir", ["-p", dir]).unwrap()
    dir
}

// Copies, mtime kept, the objects in the native cache of the tree at root into the one of the
// tree at dir. A build skips compiling a native dep such as sqlite3 when its cache holds an
// object no older than the source, so a seeded tree spares that compile.
pub fn seed_native_cache(root: Str, dir: Str) ! Process.Spawn {
    let _mk = process.run("mkdir", ["-p", "{dir}/build/native-cache"]).unwrap()
    let _cp = process.run("sh", ["-c", "for o in {root}/build/native-cache/*.o; do [ -f \"$o\" ] && cp -p \"$o\" {dir}/build/native-cache/; done; true"]).unwrap()
}

fn run_compile(path: Str, src: Str) -> Str ! FS.Write, Process.Spawn, FS.Delete, FS.Read, Env.Read {
    fs.write(path, src).unwrap()
    let args = [path, "/dev/null", "--format", "json"]
    let result = process.run(blinkc_path(), args).unwrap()
    let output = "{result.out}{result.err_out}"
    let _ = fs.delete(path)
    output
}

// Compile `source` and return the compiler's DIAGNOSTIC OUTPUT — stdout plus stderr, in
// --format json. The emitted C goes to /dev/null and is never returned.
//
// So an assertion on this string can only ever see a diagnostic. Asserting that emitted C
// lacks a codegen sentinel (BLINK_COMPILER_BUG_kops_unsupported, a `_Void` mono name, a
// `void` field) against this output is VACUOUS — the needle could not appear whether or not
// codegen produced it. Use compile_and_emit_c for any claim about emitted C, and note that it
// answers "" when the program does not reach codegen, so a needle it lacks proves nothing
// there either. A row asserting on a program that is rejected before codegen must therefore
// use this function and assert on the DIAGNOSTIC.
//
// The one sentinel spelling that legitimately appears here is BLINK_I0001_*: the
// UnsolvedTypeVarAtCodegen diagnostic embeds the erased mono name in its message text.
pub fn compile_and_capture(source: Str, tag: Str) -> Str ! FS.Delete, FS.Write, Process.Spawn, FS.Read, Env.Read {
    run_compile("{scratch_root()}/{tag}.bl", source)
}

// These four print the label and then assert. The print is what names WHICH check failed —
// the assertion message alone cannot, since every row funnels through the same line here.
// They must assert: `blink test` does not scan stdout, so a print-only helper makes every row
// built on it pass whatever the compiler does.
pub fn expect_error(output: Str, code: Str, label: Str) ! IO.Print {
    let ok = output.contains(code)
    if ok {
        io.println("PASS: {label}")
    } else {
        io.println("FAIL: {label} — expected {code} in output")
    }
    assert(ok)
}

pub fn expect_contains(output: Str, needle: Str, label: Str) ! IO.Print {
    let ok = output.contains(needle)
    if ok {
        io.println("PASS: {label}")
    } else {
        io.println("FAIL: {label} — expected '{needle}' in output")
    }
    assert(ok)
}

pub fn expect_warning(output: Str, code: Str, label: Str) ! IO.Print {
    let ok = output.contains(code) && output.contains("\"severity\":\"warning\"")
    if ok {
        io.println("PASS: {label}")
    } else {
        io.println("FAIL: {label} — expected {code} at severity warning in output")
    }
    assert(ok)
}

pub fn expect_clean(output: Str, label: Str) ! IO.Print {
    let dirty = output.contains("E0900") || output.contains("E0901") || output.contains("E0902") || output.contains("E0903") || output.contains("E0905")
    if dirty {
        io.println("FAIL: {label} — unexpected trait contract error in output")
    } else {
        io.println("PASS: {label}")
    }
    assert(!dirty)
}

// Asserts the program drew NO error of any code. expect_clean above is narrower on
// purpose — it names the five trait-contract codes — so a row that means "this program
// must compile" cannot use it: any other error, a parse error included, would leave the
// row green and the claim unproven.
pub fn expect_compiles_clean(output: Str, label: Str) ! IO.Print {
    let dirty = output.contains("\"severity\":\"error\"")
    if dirty {
        io.println("FAIL: {label} — expected a clean compile, got an error")
    } else {
        io.println("PASS: {label}")
    }
    assert(!dirty)
}

pub fn expect_compile_error(src: Str, tag: Str, error_code: Str) ! FS.Delete, FS.Write, Process.Spawn, FS.Read, Env.Read {
    let output = run_compile("{scratch_root()}/_test_{tag}.bl", src)
    assert(output.contains(error_code))
}

pub fn expect_no_error(src: Str, tag: Str, error_code: Str) ! FS.Delete, FS.Write, Process.Spawn, FS.Read, Env.Read {
    let output = run_compile("{scratch_root()}/_test_{tag}.bl", src)
    assert(!output.contains(error_code))
}

// Stage a two-file package under <scratch>/<tag>/ (with a blink.toml so imports resolve),
// compile the entry, and assert the diagnostic `error_code` appears. Used for
// whole-program / cross-module checks that a single-file compile cannot exercise.
pub fn expect_compile_error_xmod(entry_src: Str, helper_name: Str, helper_src: Str, tag: Str, error_code: Str) ! Process.Spawn, FS.Write, FS.Read, Env.Read {
    let root = "{scratch_root()}/{tag}"
    let src_dir = "{root}/src"
    let _mk = process.run("mkdir", ["-p", src_dir]).unwrap()
    fs.write("{root}/blink.toml", "[package]\nname = \"{tag}\"\nversion = \"0.1.0\"\n").unwrap()
    fs.write("{src_dir}/{helper_name}.bl", helper_src).unwrap()
    let entry_path = "{src_dir}/{tag}.bl"
    fs.write(entry_path, entry_src).unwrap()
    let result = process.run(blinkc_path(), [entry_path, "/dev/null", "--format", "json"]).unwrap()
    let output = "{result.out}{result.err_out}"
    assert(output.contains(error_code))
}

// Inverse of expect_compile_error_xmod: stage a two-file package and assert the
// entry compiles WITHOUT errors and that `error_code` in particular is absent.
// The compile-clean check (no "severity":"error") prevents a false green where an
// UNRELATED error makes the code-absence assertion pass vacuously. Used to lock
// no-false-positive guarantees (e.g. a pub item reached via a qualified form).
pub fn expect_no_error_xmod(entry_src: Str, helper_name: Str, helper_src: Str, tag: Str, error_code: Str) ! Process.Spawn, FS.Write, FS.Read, Env.Read {
    let root = "{scratch_root()}/{tag}"
    let src_dir = "{root}/src"
    let _mk = process.run("mkdir", ["-p", src_dir]).unwrap()
    fs.write("{root}/blink.toml", "[package]\nname = \"{tag}\"\nversion = \"0.1.0\"\n").unwrap()
    fs.write("{src_dir}/{helper_name}.bl", helper_src).unwrap()
    let entry_path = "{src_dir}/{tag}.bl"
    fs.write(entry_path, entry_src).unwrap()
    let result = process.run(blinkc_path(), [entry_path, "/dev/null", "--format", "json"]).unwrap()
    let output = "{result.out}{result.err_out}"
    assert(!output.contains("\"severity\":\"error\""))
    assert(!output.contains(error_code))
}

// Stage a two-file package under <scratch>/<tag>/ and return the diagnostic JSON, so a
// caller can assert on message text (not just the presence of a code).
pub fn compile_xmod_capture(entry_src: Str, helper_name: Str, helper_src: Str, tag: Str) -> Str ! Process.Spawn, FS.Write, FS.Read, Env.Read {
    let root = "{scratch_root()}/{tag}"
    let src_dir = "{root}/src"
    let _mk = process.run("mkdir", ["-p", src_dir]).unwrap()
    fs.write("{root}/blink.toml", "[package]\nname = \"{tag}\"\nversion = \"0.1.0\"\n").unwrap()
    fs.write("{src_dir}/{helper_name}.bl", helper_src).unwrap()
    let entry_path = "{src_dir}/{tag}.bl"
    fs.write(entry_path, entry_src).unwrap()
    let result = process.run(blinkc_path(), [entry_path, "/dev/null", "--format", "json"]).unwrap()
    "{result.out}{result.err_out}"
}

// Stage a single-file package under <scratch>/<tag>/ whose blink.toml carries a
// [lints] section, compile the entry with cwd at the repo root (so the
// manifest must be resolved from the package root of the compiled file,
// not the cwd), and return the diagnostic JSON.
pub fn compile_pkg_and_capture(src: Str, lints: Str, tag: Str) -> Str ! Process.Spawn, FS.Write, FS.Read, Env.Read {
    let root = "{scratch_root()}/{tag}"
    let src_dir = "{root}/src"
    let _mk = process.run("mkdir", ["-p", src_dir]).unwrap()
    fs.write("{root}/blink.toml", "[package]\nname = \"{tag}\"\nversion = \"0.1.0\"\n\n[lints]\n{lints}\n").unwrap()
    let entry_path = "{src_dir}/{tag}.bl"
    fs.write(entry_path, src).unwrap()
    let result = process.run(blinkc_path(), [entry_path, "/dev/null", "--format", "json"]).unwrap()
    "{result.out}{result.err_out}"
}

// Stage a two-file package under <scratch>/<tag>/ and drive the FULL pipeline
// (compile -> C -> link -> run) via `build/blink run`. Returns the run result so
// a caller can assert exit code / stdout. Needed for cross-module codegen bugs
// whose symptom is a C link error the `--format json` stage cannot
// observe, since blinkc only emits C and never invokes the C compiler.
// `helper_dir` is the package subdir (e.g. "om") so the file lands at
// src/<helper_dir>/<helper_base>.bl, mirroring the import path `helper_dir.helper_base`.
pub fn run_xmod(entry_src: Str, helper_dir: Str, helper_base: Str, helper_src: Str, tag: Str) -> RunResult ! Process.Spawn, FS.Write, Env.Read {
    let root = "{scratch_root()}/{tag}"
    let src_dir = "{root}/src"
    let _mk = process.run("mkdir", ["-p", "{src_dir}/{helper_dir}"]).unwrap()
    fs.write("{root}/blink.toml", "[package]\nname = \"{tag}\"\nversion = \"0.1.0\"\n").unwrap()
    fs.write("{src_dir}/{helper_dir}/{helper_base}.bl", helper_src).unwrap()
    let entry_path = "{src_dir}/main.bl"
    fs.write(entry_path, entry_src).unwrap()
    // Every caller's entry is main.bl, and `blink run` writes build/<basename> in the cwd, so
    // parallel callers would share build/main. Keep the binary under this fixture's root.
    let r = process.run("build/blink", ["run", "-o", "{root}/main", entry_path]).unwrap()
    RunResult { exit_code: run_code(r.end), out: r.out, err_out: r.err_out }
}

// Drive `blink audit --ffi [--json]` over a two-module package: a helper module
// under `{helper_dir}/{helper_base}` plus a `main.bl` entry that imports it, then
// return the audit stdout. Mirrors run_xmod, but runs the audit (which merges the
// imported modules via compile_to_program) instead of executing the program — so
// a cross-module qualified type reference reaches the audit exactly as a real
// multi-module build would present it.
pub fn audit_ffi_xmod(entry_src: Str, helper_dir: Str, helper_base: Str, helper_src: Str, tag: Str, json: Int) -> Str ! Process.Spawn, FS.Write, Env.Read {
    let root = "{scratch_root()}/{tag}"
    let src_dir = "{root}/src"
    let _mk = process.run("mkdir", ["-p", "{src_dir}/{helper_dir}"]).unwrap()
    fs.write("{root}/blink.toml", "[package]\nname = \"{tag}\"\nversion = \"0.1.0\"\n").unwrap()
    fs.write("{src_dir}/{helper_dir}/{helper_base}.bl", helper_src).unwrap()
    let entry_path = "{src_dir}/main.bl"
    fs.write(entry_path, entry_src).unwrap()
    let args = if json != 0 { ["audit", "--ffi", "--json", entry_path] } else { ["audit", "--ffi", entry_path] }
    let result = process.run("build/blink", args).unwrap()
    "{result.out}{result.err_out}"
}

pub fn check_via_cli(src: Str, tag: Str) -> Str ! FS.Write, Process.Spawn, FS.Delete, Env.Read {
    let path = "{scratch_root()}/_chk_{tag}.bl"
    fs.write(path, src).unwrap()
    let result = process.run("build/blink", ["check", path, "--format", "json"]).unwrap()
    let output = "{result.out}{result.err_out}"
    let _ = fs.delete(path)
    output
}

// Drive `blink audit --ffi [--json] <path>` over `src` and return its stdout.
// Used to exercise the FFI audit report (e.g. the bytes-bridge / byte-pin
// subcategory) end to end through the real CLI.
pub fn audit_ffi_via_cli(src: Str, tag: Str, json: Int) -> Str ! FS.Write, Process.Spawn, FS.Delete, Env.Read {
    let path = "{scratch_root()}/_audit_{tag}.bl"
    fs.write(path, src).unwrap()
    let args = if json != 0 { ["audit", "--ffi", "--json", path] } else { ["audit", "--ffi", path] }
    let result = process.run("build/blink", args).unwrap()
    let output = "{result.out}{result.err_out}"
    let _ = fs.delete(path)
    output
}

pub fn verify_catalog_entry(code: Str, short_name: Str) ! Process.Spawn {
    let res = process.run("build/blink", ["explain", code]).unwrap()
    assert_eq(res.end, ChildEnd.Exited(0))
    assert(res.out.contains(code))
    assert(res.out.contains(short_name))
}

// Scan emitted C for struct/enum typedef names beginning with `blink_{base}`
// (an exact match on `base` itself, or `base` followed by `_`) and return
// every distinct one found, in first-seen order. Each typedef's closing line
// has the shape `} blink_<name>;` (see emit_mono_struct_typedef /
// emit_mono_enum_typedef, src/codegen_stmt.bl) regardless of how <name>'s
// tail is mangled — this reads the STRUCTURE of that line, not a specific
// mangling scheme's spelling, so it survives future mangler changes
// without every caller needing to hardcode an exact mangled name.
//
// Deliberately does not care WHAT comes after `blink_{base}` — that is
// exactly the part a caller should assert about relationally (distinct
// instantiations produce distinct entries here) rather than by literal
// spelling.
pub fn mono_typedef_names(c: Str, base: Str) -> List[Str] {
    let prefix = "} blink_{base}"
    let prefix_len = prefix.byte_len()
    let lines = c.lines()
    let mut out: List[Str] = []
    let mut i = 0
    while i < lines.len() {
        let line = lines.get(i).unwrap()
        let trimmed = line.trim()
        if trimmed.starts_with(prefix) {
            // trimmed = "} blink_{base}<tail>;" — the char right after the
            // prefix must be end-of-name (';', an exact match) or '_' (a
            // separator into the mangled tail); anything else means `base`
            // is only a PREFIX of some other base's name (e.g. "Box" vs
            // "BoxOfBoxes") and this line must be skipped.
            let next_byte = trimmed.byte_at(prefix_len)
            if next_byte == 59 || next_byte == 95 {
                let name_start = 2
                match trimmed.byte_index_of(";", 0) {
                    Some(semi) => {
                        if semi > name_start {
                            let name = trimmed.byte_slice(name_start, semi)
                            if !out.contains(name) {
                                out.push(name)
                            }
                        }
                    }
                    None => {}
                }
            }
        }
        i = i + 1
    }
    out
}

// True iff at least one typedef named `blink_{base}...` was emitted for `base`.
pub fn has_mono_instance(c: Str, base: Str) -> Int {
    if mono_typedef_names(c, base).len() > 0 { 1 } else { 0 }
}

// Every byte of `s` except '_' (95), concatenated. Used to compare a `base` against a
// mangled candidate name while being agnostic to any underscore-escaping scheme the
// mangler applies — an escape scheme only ever inserts/rewrites '_' bytes, so stripping
// them from both sides before comparing survives a scheme change without knowing what
// the scheme is.
fn strip_underscores(s: Str) -> Str {
    s.replace("_", "")
}

// The last occurrence of `needle` in `s` at or before byte offset `before` (exclusive),
// or -1 if none. Used to find the `blink_` that starts the FUNCTION NAME on a definition
// line, as opposed to one that starts the RETURN TYPE — a monomorphized struct/enum return
// type (`blink_RGT_0Int blink_mk_0Int(void) {`) also spells `blink_`, and it comes first,
// so the naive "first blink_ before the paren" scan picks the return type's name instead
// of the function's own name. The function name is always the LAST `blink_` immediately
// preceding the parameter list's `(`, so scanning from the right is unambiguous.
fn last_index_of_before(s: Str, needle: Str, before: Int) -> Int {
    let needle_len = needle.byte_len()
    if needle_len == 0 { return before }
    let mut result = -1
    let mut from = 0
    loop {
        match s.byte_index_of(needle, from) {
            Some(at) => {
                if at + needle_len > before { break }
                result = at
                from = at + needle_len
            }
            None => { break }
        }
    }
    result
}

// The function-symbol twin of mono_typedef_names, for a monomorphized generic FN or
// poly-impl method (e.g. a `impl[T] Trait[T] for List[T]` method, whose base is itself
// a compound name like "List_Echoable_echo" — already containing "_" before any
// mangling happens at all, so a literal "blink_{base}" prefix match would miss it the
// moment the mangler escapes those pre-existing underscores). A definition line has the
// shape `<ret-type> blink_<mangled-name>(<params>) {` (see e.g. emit_fn_def /
// emit_poly_impl_call, src/codegen_stmt.bl / codegen_methods.bl) — this reads that
// structure, comparing underscore-STRIPPED names, so it survives future mangler changes
// without needing to know what escaping scheme (if any) is in play.
//
// Uses the LAST `blink_` before the paren, not the first — a monomorphized-struct return
// type (e.g. `blink_RGT_0Int blink_mk_0Int(void) {`) also spells `blink_`, and it precedes
// the function name's own `blink_`, so the first-match scan a prior version of this
// function used would misidentify the return type as the function name and never find
// the real one (a real, reproduced defect — see tests/test_monomorphized_typedef_names_helper.bl's
// "mono_fn_names: a monomorphized struct return type does not shadow the fn name" row).
pub fn mono_fn_names(c: Str, base: Str) -> List[Str] {
    let stripped_base = strip_underscores(base)
    let lines = c.lines()
    let mut out: List[Str] = []
    let mut i = 0
    while i < lines.len() {
        let line = lines.get(i).unwrap()
        let trimmed = line.trim()
        match trimmed.byte_index_of("(", 0) {
            Some(paren) => {
                if paren > 0 && trimmed.ends_with(") \{") {
                    let blink_at = last_index_of_before(trimmed, "blink_", paren)
                    if blink_at >= 0 && blink_at < paren {
                        let name = trimmed.byte_slice(blink_at, paren)
                        let tail = trimmed.byte_slice(blink_at + 6, paren)
                        let stripped_tail = strip_underscores(tail)
                        if stripped_tail.starts_with(stripped_base) {
                            if !out.contains(name) {
                                out.push(name)
                            }
                        }
                    }
                }
            }
            None => {}
        }
        i = i + 1
    }
    out
}

// True iff at least one function named `blink_{base}...` was DEFINED (not merely
// declared/prototyped) for `base`.
pub fn has_mono_fn_instance(c: Str, base: Str) -> Int {
    if mono_fn_names(c, base).len() > 0 { 1 } else { 0 }
}

// KNOWN COUPLING: unlike mono_typedef_names/mono_fn_names, this helper DOES
// assume today's _0/_1 escape scheme (src/cname.bl:mono_stem).
// It exists only because a poly-impl-on-builtin base (e.g. "List_Echoable_echo")
// already contains '_' before mangling, and underscore-stripping alone can't
// disambiguate escaped digits from real name characters. If mono_stem's
// scheme changes, THIS helper (and only this one) needs a matching update.
// `base` is the generic's C stem, whose name parts are already escaped: a fn
// `sum_list` is "sum_1list".
//
// Rather than reverse-engineer the mangled tail, this forward-applies the same
// escape (`_` -> `_1`) to `base` locally, then does a literal `blink_{escaped}`
// prefix match on a function-definition line — the same line shape mono_fn_names
// scans. It copies typecheck's tc_sym_escape rather than importing it, so that a
// test using these helpers does not compile the whole checker.
fn escape_mono_seg_for_test(s: Str) -> Str {
    s.replace("_", "_1")
}

pub fn poly_impl_fn_names(c: Str, base: Str) -> List[Str] {
    let prefix = "blink_{escape_mono_seg_for_test(base)}"
    let prefix_len = prefix.byte_len()
    let lines = c.lines()
    let mut out: List[Str] = []
    let mut i = 0
    while i < lines.len() {
        let line = lines.get(i).unwrap()
        let trimmed = line.trim()
        match trimmed.byte_index_of("(", 0) {
            Some(paren) => {
                if paren > 0 && trimmed.ends_with(") \{") {
                    // Same shadow hazard mono_fn_names has: a monomorphized-struct return
                    // type can also match `prefix` and precede the fn name on the line, so
                    // find the LAST match before the paren, not the first.
                    let blink_at = last_index_of_before(trimmed, prefix, paren)
                    if blink_at >= 0 && blink_at < paren {
                        let after = trimmed.byte_at(blink_at + prefix_len)
                        if after == 40 || after == 95 {
                            let name = trimmed.byte_slice(blink_at, paren)
                            if !out.contains(name) {
                                out.push(name)
                            }
                        }
                    }
                }
            }
            None => {}
        }
        i = i + 1
    }
    out
}

// True iff at least one function named `blink_{escaped base}...` was DEFINED
// for `base`, under today's _0/_1 escape scheme. See poly_impl_fn_names.
pub fn has_poly_impl_fn_instance(c: Str, base: Str) -> Int {
    if poly_impl_fn_names(c, base).len() > 0 { 1 } else { 0 }
}

// Compile `src` to a real .c file and return the emitted C source. Used
// to inspect what codegen produced for a given construct without running
// the compiled binary.
pub fn compile_and_emit_c(src: Str, tag: Str) -> Str ! FS.Delete, FS.Write, Process.Spawn, FS.Read, Env.Read {
    emit_c_with(src, tag, [])
}

// The same for the build `blink test` makes, the only build that writes the test bodies.
pub fn compile_and_emit_test_c(src: Str, tag: Str) -> Str ! FS.Delete, FS.Write, Process.Spawn, FS.Read, Env.Read {
    emit_c_with(src, tag, ["--test-build"])
}

fn emit_c_with(src: Str, tag: Str, flags: List[Str]) -> Str ! FS.Write, Process.Spawn, FS.Delete, FS.Read, Env.Read {
    let bl_path = "{scratch_root()}/{tag}.bl"
    let c_path = "{scratch_root()}/{tag}.c"
    fs.write(bl_path, src).unwrap()
    let mut args = flags
    args.push(bl_path)
    args.push(c_path)
    let _result = process.run(blinkc_path(), args).unwrap()
    let c_src = read_if_there(c_path)
    let _ = fs.delete(bl_path)
    let _ = fs.delete(c_path)
    c_src
}

// Compile `src` to a binary, run it, and return (exit_code, stderr).
pub type RunResult {
    exit_code: Int
    out: Str
    err_out: Str
}

// RunResult keeps the number its readers were written against: the exit status, or 128 plus
// the signal number, as a shell reports it. No run here sets a limit, so Limit does not occur.
fn run_code(end: ChildEnd) -> Int {
    match end {
        ChildEnd.Exited(code) => code
        ChildEnd.Signaled(n) => 128 + n
        ChildEnd.Limit(_) => -1
    }
}

pub fn compile_and_run(src: Str, tag: Str) -> RunResult ! FS.Delete, FS.Write, Process.Spawn, FS.Read, Env.Read {
    compile_and_run_opt(src, tag, "")
}

// The same, with the C compiler at optimisation level `opt` ("" for its default), as a
// release build compiles it.
pub fn compile_and_run_opt(src: Str, tag: Str, opt: Str) -> RunResult ! FS.Write, Process.Spawn, FS.Delete, FS.Read, Env.Read {
    compile_and_run_built(src, tag, [], opt)
}

// The same, as a debug build: `debug_assert` is checked.
pub fn compile_and_run_debug(src: Str, tag: Str) -> RunResult ! FS.Write, Process.Spawn, FS.Delete, FS.Read, Env.Read {
    compile_and_run_built(src, tag, ["--debug"], "")
}

fn compile_and_run_built(src: Str, tag: Str, flags: List[Str], opt: Str) -> RunResult ! FS.Write, Process.Spawn, FS.Delete, FS.Read, Env.Read {
    let bl_path = "{scratch_root()}/{tag}.bl"
    let c_path = "{scratch_root()}/{tag}.c"
    let bin_path = "{scratch_root()}/{tag}_bin"
    fs.write(bl_path, src).unwrap()
    let arc_dir = archive_dir()
    let mut cargs = flags
    for a in ["--link-archive", path_join(arc_dir, "libblink_std.h"), bl_path, c_path] { cargs.push(a) }
    let cresult = process.run(blinkc_path(), cargs).unwrap()
    if !cresult.success() {
        let _ = fs.delete(bl_path)
        return RunResult { exit_code: run_code(cresult.end), out: cresult.out, err_out: cresult.err_out }
    }
    let mut largs: List[Str] = []
    if opt != "" { largs.push(opt) }
    for a in ["-I{arc_dir}", "-o", bin_path, c_path, path_join(arc_dir, "libblink_std.a"), "-lm", "-lgc", "-pthread", "-Wl,--gc-sections"] {
        largs.push(a)
    }
    let lnk = process.run("cc", largs).unwrap()
    if !lnk.success() {
        let _ = fs.delete(bl_path)
        let _ = fs.delete(c_path)
        return RunResult { exit_code: run_code(lnk.end), out: lnk.out, err_out: lnk.err_out }
    }
    let r = process.run(bin_path, []).unwrap()
    let _ = fs.delete(bl_path)
    let _ = fs.delete(c_path)
    let _ = fs.delete(bin_path)
    RunResult { exit_code: run_code(r.end), out: r.out, err_out: r.err_out }
}

// Compile a fixture that contains `test` blocks (so codegen auto-enables test
// mode and the panic catch dispatch), then run the test binary with
// --test-json and return its output. Used to exercise assert_panics emit-site
// behavior (E0831/E0832, pass-consumes-panic) by asserting on the runner's
// own JSON, since a failing assert_panics cannot be observed from a passing
// test in the same run.
pub fn compile_and_run_test_json(src: Str, tag: Str) -> RunResult ! FS.Delete, FS.Write, Process.Spawn, FS.Read, Env.Read {
    compile_and_run_test_json_opt(src, tag, "")
}

// The same, with the C compiler at optimisation level `opt` ("" for its default). A
// miscompile that only shows once locals live in registers, such as a local changed
// between setjmp and longjmp, passes at -O0 and needs this to be seen.
pub fn compile_and_run_test_json_opt(src: Str, tag: Str, opt: Str) -> RunResult ! FS.Write, Process.Spawn, FS.Delete, FS.Read, Env.Read {
    compile_and_run_test_json_built(src, tag, [], opt)
}

// The same, as `blink test` builds it: every build that `blink test` makes is a debug build.
pub fn compile_and_run_test_json_debug(src: Str, tag: Str) -> RunResult ! FS.Write, Process.Spawn, FS.Delete, FS.Read, Env.Read {
    compile_and_run_test_json_built(src, tag, ["--debug"], "")
}

fn compile_and_run_test_json_built(src: Str, tag: Str, flags: List[Str], opt: Str) -> RunResult ! FS.Write, Process.Spawn, FS.Delete, FS.Read, Env.Read {
    let bl_path = "{scratch_root()}/{tag}.bl"
    let c_path = "{scratch_root()}/{tag}.c"
    let bin_path = "{scratch_root()}/{tag}_bin"
    fs.write(bl_path, src).unwrap()
    let arc_dir = archive_dir()
    let mut cargs = flags
    for a in ["--test-build", "--link-archive", path_join(arc_dir, "libblink_std.h"), bl_path, c_path] { cargs.push(a) }
    let cresult = process.run(blinkc_path(), cargs).unwrap()
    if !cresult.success() {
        let _ = fs.delete(bl_path)
        return RunResult { exit_code: run_code(cresult.end), out: cresult.out, err_out: cresult.err_out }
    }
    let mut largs: List[Str] = []
    if opt != "" { largs.push(opt) }
    for a in ["-I{arc_dir}", "-o", bin_path, c_path, path_join(arc_dir, "libblink_std.a"), "-lm", "-lgc", "-pthread", "-Wl,--gc-sections"] {
        largs.push(a)
    }
    let lnk = process.run("cc", largs).unwrap()
    if !lnk.success() {
        let _ = fs.delete(bl_path)
        let _ = fs.delete(c_path)
        return RunResult { exit_code: run_code(lnk.end), out: lnk.out, err_out: lnk.err_out }
    }
    let r = process.run(bin_path, ["--test-json"]).unwrap()
    let _ = fs.delete(bl_path)
    let _ = fs.delete(c_path)
    let _ = fs.delete(bin_path)
    RunResult { exit_code: run_code(r.end), out: r.out, err_out: r.err_out }
}


// Compile and run `src` through the real CLI, so a flag is exercised end to end on the
// path a user actually runs — argument parsing included, not just the codegen global the
// flag eventually sets.
pub fn run_via_cli(src: Str, tag: Str, flag: Str) -> RunResult ! FS.Write, Process.Spawn, FS.Delete, Env.Read {
    let path = "{scratch_root()}/_runcli_{tag}.bl"
    fs.write(path, src).unwrap()
    let args = if flag != "" { ["run", flag, path] } else { ["run", path] }
    let result = process.run("build/blink", args).unwrap()
    let _ = fs.delete(path)
    RunResult { exit_code: run_code(result.end), out: result.out, err_out: result.err_out }
}

// The binary of a plain build of the test file at `path`, which runs its main. A test that runs
// its own program as a child needs this build: the binary of a test build runs the tests and
// never main, so it would only run the tests again. Built once per process.
pub fn main_binary_of(path: Str) -> Str ! Process.Spawn, IO, FS.Read, Env.Read {
    let out = "{scratch_root()}/_main_of_{path_basename(path)}"
    if path_exists(out) { return out }
    let r = process.run("build/blink", ["build", path, "-o", out]).unwrap()
    if !r.success() || !path_exists(out) {
        io.println("FAIL: the plain build of {path} ended with {r.end}\n{r.out}{r.err_out}")
    }
    assert(r.success() && path_exists(out))
    out
}

// The emitted C for `src` as the real CLI produces it. `blink build --emit c` writes
// to build/<basename>.c, so the tag must stay unique across the suite. Answers "" when
// the compile never reached codegen, so a caller asserting on a needle fails on the
// assertion rather than aborting the whole test binary on a missing file.
pub fn emit_c_via_cli(src: Str, tag: Str, flag: Str) -> Str ! FS.Write, Process.Spawn, FS.Delete, FS.Read, Env.Read {
    let path = "{scratch_root()}/_emitc_{tag}.bl"
    fs.write(path, src).unwrap()
    let args = if flag != "" { ["build", "--emit", "c", flag, path] } else { ["build", "--emit", "c", path] }
    let _result = process.run("build/blink", args).unwrap()
    let _ = fs.delete(path)
    let c_path = "build/_emitc_{tag}.c"
    let c_src = read_if_there(c_path)
    let _ = fs.delete(c_path)
    c_src
}

// The trimmed stdout of `sh -c cmd`.
pub fn sh(cmd: Str) -> Str ! Process.Spawn {
    process.run("sh", ["-c", cmd]).unwrap().out.trim()
}

// Whether path exists within secs seconds.
pub fn appears(path: Str, secs: Int) -> Bool ! Process.Spawn {
    process.run("sh", ["-c", "for i in $(seq 1 {secs * 20}); do [ -e {path} ] && exit 0; sleep 0.05; done; exit 1"]).unwrap().success()
}

// How a command ended, from the status its shell wrote: a shell reports a child that signal
// n killed as 128 + n.
pub fn end_of_shell_status(rc: Int) -> ChildEnd {
    if rc > 128 { ChildEnd.Signaled(rc - 128) } else { ChildEnd.Exited(rc) }
}

// What a command run in the background by a shell ended with. The shell writes the command's
// stdout to {tree}/{tag}.out, its stderr to {tag}.err and, last, its status to {tag}.rc. A
// command that has not ended in 300 s fails the test here, so a hang does not read as an exit.
pub fn bg_result(tree: Str, tag: Str) -> ProcessResult ! FS.Read, Process.Spawn {
    bg_result_within(tree, tag, 300)
}

// The same, waiting at most secs seconds.
pub fn bg_result_within(tree: Str, tag: Str, secs: Int) -> ProcessResult ! FS.Read, Process.Spawn {
    if !appears("{tree}/{tag}.rc", secs) {
        panic("the background command {tree}/{tag} has not ended in {secs} s")
    }
    let rc = sh("cat {tree}/{tag}.rc").to_int()
    ProcessResult { out: fs.read("{tree}/{tag}.out").unwrap(), err_out: fs.read("{tree}/{tag}.err").unwrap(), end: end_of_shell_status(rc) }
}

// Builds src with `blink build` and the given flags into its own scratch directory, named by
// stem, and gives the path of the binary. A build that fails or warns stops the test, so a
// run of the binary checks only what the program does.
pub fn build_bin(src: Str, stem: Str, flags: List[Str]) -> Str ! FS.Write, Process.Spawn, Env.Read {
    let dir = "{scratch_root()}/{stem}"
    sh("mkdir -p {dir}")
    let path = "{dir}/{stem}.bl"
    let bin = "{dir}/{stem}_bin"
    fs.write(path, src).unwrap()
    let mut args = ["build"]
    for f in flags { args.push(f) }
    args.push(path)
    args.push("-o")
    args.push(bin)
    let b = process.run("build/blink", args).unwrap()
    assert_eq(b.err_out, "")
    assert(b.success())
    bin
}

// Removes the scratch directory of build_bin, with the binary and what its build wrote.
pub fn clean_bin(stem: Str) ! Process.Spawn, Env.Read {
    sh("rm -rf {scratch_root()}/{stem}")
}

// Stage a two-file package under <scratch>/<tag>/, src/<helper_name>.bl and src/main.bl, and
// build it with `blink build`. Gives the path of the binary, so a caller can run it with the
// env it needs; clean_bin(tag) removes the package. A build that fails or warns stops the test.
pub fn build_bin_xmod(entry_src: Str, helper_name: Str, helper_src: Str, tag: Str) -> Str ! FS.Write, Process.Spawn, Env.Read {
    let root = "{scratch_root()}/{tag}"
    sh("mkdir -p {root}/src")
    fs.write("{root}/blink.toml", "[package]\nname = \"{tag}\"\nversion = \"0.1.0\"\n").unwrap()
    fs.write("{root}/src/{helper_name}.bl", helper_src).unwrap()
    fs.write("{root}/src/main.bl", entry_src).unwrap()
    let bin = "{root}/main_bin"
    let b = process.run("build/blink", ["build", "{root}/src/main.bl", "-o", bin]).unwrap()
    assert_eq(b.err_out, "", "{b.out}{b.err_out}")
    assert(b.success(), "{b.out}{b.err_out}")
    bin
}

// The fn of each enter event in a --trace stream, joined by a space.
pub fn trace_enter_fns(text: Str) -> Str {
    let mut names: List[Str] = []
    for line in text.split("\n") {
        if !line.contains("\"event\":\"enter\"") { continue }
        let after = line.split("\"fn\":\"").get(1) ?? ""
        let parts = after.split("\"")
        assert(parts.len() >= 2)
        names.push(parts.get(0).unwrap())
    }
    names.join(" ")
}
