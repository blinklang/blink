// compiler.bl — Self-hosting Blink compiler driver
//
// Ties together lexer, parser, and codegen into a complete compiler.
// Reads a .bl source file, lexes, parses, generates C, and writes output.
//
// Usage (once compiled): ./blinkc <source.bl> [output.c]
// If no output file given, writes to stdout.

// Set by cli.bl when --strict-struct-layout is passed; escalates W0812
// (MissingCanonicalHeader) to error. Applied after manifest [lints]
// overrides so the flag wins regardless of manifest configuration.
pub let mut compiler_strict_struct_layout: Int = 0

// Collections while modules load free almost nothing, since the AST they mark only grows,
// so collection stays off from the first lex until every module is parsed. Past this many
// AST nodes it comes back on, so the garbage the lexer and parser leave stays bounded on a
// very large input. The compiler itself loads about 300k.
let LOAD_PHASE_GC_OFF_MAX_NODES: Int = 1000000

@ffi("GC_disable", header: "gc.h")
@trusted(audit: "Increments the collector's disable counter; takes and returns nothing. load_phase_begin holds at most one.")
fn gc_disable() ! FFI {}

@ffi("GC_enable", header: "gc.h")
@trusted(audit: "Decrements the collector's disable counter; takes and returns nothing. load_phase_end calls it only while the counter is held.")
fn gc_enable() ! FFI {}

@ffi("GC_is_disabled", header: "gc.h")
@trusted(audit: "Reads the collector's disable counter; takes no arguments and returns an int.")
fn gc_is_disabled() -> I32 ! FFI {}

@ffi("GC_set_free_space_divisor", header: "gc.h")
@trusted(audit: "Sets the collector's free-space divisor; takes a GC_word and returns nothing. Called with a positive constant only.")
fn gc_set_free_space_divisor(divisor: U64) ! FFI {}

// The compiler is a short batch process that allocates several hundred MB. libgc's default
// divisor of 3 collects too often for it; 1 cuts about 5% of cycles on the compiler's own
// source for under 15% more RSS, and does not slow or grow a small compile. User programs
// keep libgc's default.
pub let COMPILER_FREE_SPACE_DIVISOR: Int = 1

// libgc reads GC_FREE_SPACE_DIVISOR before main runs; whoever set it chose a divisor, so the
// compiler does not override it.
pub fn compiler_sets_free_space_divisor(env_divisor: Option[Str]) -> Bool {
    env_divisor.is_none()
}

// Called first in each compiler binary's main with env.var("GC_FREE_SPACE_DIVISOR").
pub fn tune_compiler_gc(env_divisor: Option[Str]) {
    if compiler_sets_free_space_divisor(env_divisor) {
        gc_set_free_space_divisor(COMPILER_FREE_SPACE_DIVISOR.to_u64())
    }
}

pub fn load_phase_keeps_gc_off(nodes: Int) -> Bool {
    nodes <= LOAD_PHASE_GC_OFF_MAX_NODES
}

// Nothing else in the compiler turns collection off, so the collector's own counter says
// whether a phase holds it. A phase that never reached its end leaves one disable behind,
// and the next begin reuses it instead of stacking a second.
pub fn load_phase_begin() {
    if gc_is_disabled() == 0 {
        gc_disable()
    }
}

// Called before each module is lexed, with the nodes parsed so far.
pub fn load_phase_check(nodes: Int) {
    if !load_phase_keeps_gc_off(nodes) {
        load_phase_end()
    }
}

pub fn load_phase_end() {
    if gc_is_disabled() != 0 {
        gc_enable()
    }
}

// Holds the load phase for one `with` scope, so a panic that unwinds out of the scope cannot
// leave collection off in a process that goes on compiling. `held` is never read: a type with
// no fields does not yet lower to valid C.
pub type LoadPhase {
    held: Bool
}

impl BlockHandler for LoadPhase {
    type Context = Void
    fn enter(self) -> Void {
        let _ = self
        load_phase_begin()
    }
    fn exit(self, ok: Bool) {
        let _ = self
        let _ = ok
        load_phase_end()
    }
}

pub fn load_phase() -> LoadPhase {
    LoadPhase { held: true }
}

pub fn set_strict_struct_layout(flag: Int) {
    compiler_strict_struct_layout = flag
}

// Load [lints] overrides from the blink.toml sibling to `src_root`
// (falling back to cwd for loose files, src_root == ""). No caching: other
// callers of manifest_load() (resolver, pathdeps, cli) repopulate
// lint_names/lint_levels with a different manifest's contents, so a cache
// keyed on this file's mtime could re-apply stale overrides.
pub fn load_lint_overrides(src_root: Str) ! Diag.Report {
    let manifest_path = manifest_path_for_src_root(src_root)
    if probe_file(manifest_path) {
        manifest_clear()
        note_config_file(manifest_path)
        // The compile reports the issues of this load through diag, so the lib must not print
        // them too. The flag goes back as it was for a caller that still relies on the lib.
        let print_was = manifest_print_warnings
        manifest_print_warnings = false
        let load_rc = manifest_load(manifest_path)
        manifest_print_warnings = print_was
        if load_rc == 0 {
            apply_manifest_lints(manifest_path)
        }
    }
    if compiler_strict_struct_layout != 0 {
        lint_set_override("MissingCanonicalHeader", "error")
    }
}

// Each command reports blink.toml issues through diag, on stderr. The lib would print them as
// well, on stdout, which carries the `check --json` status line and the LSP frames, so each
// binary turns that print off at its start.
pub fn quiet_manifest_lib() {
    manifest_print_warnings = false
}

// The notes E1200 adds for each unknown section that W1001 reported in this compile: the
// dependencies of a misspelled [dependencies] are not loaded, so the import of one fails far
// from the cause (spec §8.9.8). A W1001 that [lints] turned off is not in the sink, so it
// adds no note.
fn unknown_section_notes() -> List[Str] {
    let mut notes: List[Str] = []
    for d in diag_entries {
        if d.code == UNKNOWN_MANIFEST_SECTION {
            notes.push("blink does not load the dependencies under the unknown section at {d.file}:{d.line}:{d.col}")
        }
    }
    notes
}

// Sets the [lints] levels of the manifest that the last manifest_load read from path, then
// reports its issues. The levels go first, so a [lints] entry governs W1001 whatever the order
// of the sections.
pub fn apply_manifest_lints(path: Str) ! Diag.Report {
    let mut i = 0
    while i < lint_names.len() {
        lint_set_override(lint_names.get(i).unwrap(), lint_levels.get(i).unwrap())
        i = i + 1
    }
    // The build workers of `blink test` load the manifest again after the command reported it.
    if (env.var("BLINK_MANIFEST_REPORTED") ?? "") == "1" {
        return
    }
    let file = display_config_path(path)
    for issue in manifest_issues {
        match issue.kind {
            ManifestIssueKind.InvalidLintLevel => {
                diag_emit_in_file("error", "InvalidLintLevel", INVALID_LINT_LEVEL,
                    "invalid lint level `{issue.level}` for `{issue.key}`",
                    file, issue.line, issue.col, issue.end_line, issue.end_col,
                    "a lint level is one of \"off\", \"warn\" or \"error\"")
            }
            ManifestIssueKind.UnknownManifestSection => {
                let help = match issue.suggestion {
                    Some(s) => "did you mean `[{s}]`?"
                    None => ""
                }
                diag_emit_in_file("warning", "UnknownManifestSection", UNKNOWN_MANIFEST_SECTION,
                    "unknown section `[{issue.section}]` in blink.toml",
                    file, issue.line, issue.col, issue.end_line, issue.end_col, help)
            }
            // gen0 compiles this file against a library without UnknownManifestKey, so the arm
            // that reports it waits for a gen0 pin that has it.
            _ => {}
        }
    }
}

// Notes the package root of a loaded file: the directory of the blink.toml its src root
// belongs to. The standard library and the toolchain packages resolve K only against their
// own records, never against the audits.toml of the program that imports them. A file with
// no blink.toml over it is in no package, so it has no records.
pub fn note_audit_dir(file_path: Str) {
    if is_toolchain_file(file_path) { return }
    let root = find_src_root(file_path)
    if root == "" { return }
    let manifest = manifest_path_for_src_root(root)
    if probe_file(manifest) {
        loaded_inputs.audit_dirs.insert(file_path, path_dirname(manifest))
    }
}

// Whether resolve_module_path found a file in the toolchain's own lib/std or lib/pkg. A local
// src/pkg/x.bl that an import `pkg.x` loads is the program's file, and so is not one.
fn is_toolchain_file(file_path: Str) -> Bool {
    if file_path.starts_with("<embedded:") { return true }
    let compiler_dir = path_dirname(get_arg(0))
    if under_toolchain_lib(file_path, compiler_dir) { return true }
    let blink_root = env.var("BLINK_ROOT") ?? ""
    blink_root != "" && under_toolchain_lib(file_path, blink_root)
}

fn under_toolchain_lib(file_path: Str, root: Str) -> Bool {
    file_path.starts_with(path_join(root, "lib/std/")) || file_path.starts_with(path_join(root, "lib/pkg/"))
}

// Reads the audits.toml at each package root a loaded file belongs to, once per root, and
// reports each record key the schema does not allow. A root with no audits.toml has no
// records, which is not an error: only a `@trusted(audit: K)` that names a missing K is.
pub fn load_audit_records() ! Diag.Report {
    for f in loaded_inputs.files {
        let dir = loaded_inputs.audit_dirs.get(f) ?? ""
        if dir == "" || loaded_inputs.audit_records.contains_key(dir) { continue }
        let path = path_join(dir, "audits.toml")
        if !probe_file(path) {
            loaded_inputs.audit_records.insert(dir, audit_records_empty())
            continue
        }
        let recs = audit_records_parse(note_config_text(path, read_file(path)))
        loaded_inputs.audit_records.insert(dir, recs)
        report_audit_record_issues(path, recs)
    }
}

fn report_audit_record_issues(path: Str, recs: AuditRecords) ! Diag.Report {
    let file = display_config_path(path)
    for issue in recs.issues {
        let near = nearest_name(issue.key, ["claim", "pins"])
        let help = if near != "" { "did you mean `{near}`?" } else { "" }
        diag_error_in_file_label_notes("AuditRecordUnknownKey", AUDIT_RECORD_UNKNOWN_KEY,
            "unknown key `{issue.key}` in audit record `{issue.record}`",
            file, issue.span.line, issue.span.col, issue.span.end_line, issue.span.end_col,
            "a record holds only `claim` and `pins`", help,
            ["put ticket links and authorship in the `claim` text; version control records who wrote it"])
    }
}

// A config file path as a diagnostic names it: `./blink.toml` reads as `blink.toml`.
fn display_config_path(path: Str) -> Str {
    if path.starts_with("./") { path.byte_slice(2, path.byte_len()) } else { path }
}

// Whether a file is at path, noted in loaded_inputs. A probe that resolution acts on goes
// through here, so the probes list every path whose answer could change the program loaded.
fn probe_file(path: Str) -> Bool {
    let found = file_exists(path) == 1
    if !loaded_inputs.probe_found.contains_key(path) {
        loaded_inputs.probe_paths.push(path)
        loaded_inputs.probe_found.insert(path, found)
    }
    found
}

pub fn check_file_exists(path: Str) {
    if !file_exists(path) {
        io.eprintln("error: file not found: {path}")
        env.exit(1)
    }
}

// Every `#embed` of every file this program loaded, checked and read once the loading is
// done. The path is read relative to the file that holds the `#embed`, so each node answers
// for its own file. The expression stage embeds the bytes read here. A `blink check` stops
// before that stage, so without this a check answered ok on a program no build could produce.
fn check_embed_targets() ! Diag.Report {
    // In load order, which a recheck that kept nodes does not hold to in node id order, so
    // the errors and embed_paths read as a cold check's.
    let ranges = parser_live_ranges()
    let mut r = 0
    while r + 1 < ranges.len() {
        let mut id = ranges.get(r).unwrap()
        while id < ranges.get(r + 1).unwrap() {
            if node_kind(id) == NodeKind.EmbedExpr {
                let path = embed_path_of(id)
                if !probe_file(path) {
                    diag_error_at("FileNotFound", FILE_NOT_FOUND, "#embed file not found: {path}", id,
                        "the path is read relative to the file that holds the #embed, not the directory the compiler runs in")
                } else if !loaded_inputs.embed_texts.contains_key(path) {
                    loaded_inputs.embed_paths.push(path)
                    loaded_inputs.embed_texts.insert(path, read_file(path))
                }
            }
            id = id + 1
        }
        r = r + 2
    }
}

pub fn compile_to_program(file_path: Str, use_prelude: Int) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report {
    compile_entry_to_program(file_path, use_prelude, true)
}

// `package_root` is false for an entry file the toolchain writes, such as the stdlib archive's
// synthesized main: it sits in a build dir, so the package found above it is not its package
// and that package's audits.toml is not its records.
pub fn compile_entry_to_program(file_path: Str, use_prelude: Int, package_root: Bool) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report {
    check_file_exists(file_path)
    reset_compiler_state()
    diag_reset()
    let src_root = find_src_root(file_path)
    load_lint_overrides(src_root)
    diag_source_file = file_path

    let source = read_file(file_path)
    loaded_inputs.source_paths.push(file_path)
    loaded_inputs.source_texts.push(source)
    let mut program = 0
    let mut imported_programs: List[Int] = []
    with load_phase() {
        let parsed = parse_source(file_path, source)
        program = parsed.program
        loaded_inputs.files.push(file_path)
        if package_root { note_audit_dir(file_path) }
        record_source_nodes("__main__", parsed)

        reject_empty_module_annotation(program)

        collect_root_imports(program)
        current_import_file = file_path
        collect_imports(program, src_root, imported_programs)
        if use_prelude != 0 {
            inject_prelude(src_root, imported_programs)
        }
    }
    end_source_load()
    build_reexport_map(imported_programs)

    check_embed_targets()
    load_audit_records()

    let cycle_path = detect_package_cycles()
    if cycle_path != "" {
        diag_error_no_loc("CircularPackageDep", CIRCULAR_DEPENDENCY, "circular package dependency: {cycle_path}", "extract shared types into a common package")
    }

    let mut final_program = program
    if imported_programs.len() > 0 {
        final_program = merge_programs(program, imported_programs, import_map_nodes)
    }
    resolve_root_import_qualifiers()
    tc_import_modules = import_map_modules
    tc_import_qualifiers = import_map_qualifiers
    tc_import_nodes = import_map_nodes
    final_program
}

fn dots_to_slashes(s: Str) -> Str {
    s.replace(".", "/")
}

fn read_module_ann(anns_sl: Int) -> Option[Str] {
    if anns_sl == -1 {
        return None
    }
    let mut ai = 0
    while ai < sublist_length(anns_sl) {
        let ann = sublist_get(anns_sl, ai)
        let ann_name = node_name(ann)
        if ann_name == "module" {
            let ann_args_sl = node_args(ann)
            if ann_args_sl != -1 && sublist_length(ann_args_sl) > 0 {
                let arg_nd = sublist_get(ann_args_sl, 0)
                let arg_parts = node_elements(arg_nd)
                if arg_parts == -1 || sublist_length(arg_parts) == 0 {
                    return Some("")
                }
                let val = node_name(sublist_get(arg_parts, 0))
                return Some(val)
            }
        }
        ai = ai + 1
    }
    None
}

pub fn find_module_annotation(prog: Int) -> Option[Str] {
    // The parser attaches the file-level @module annotation to whichever
    // top-level declaration comes first. Probe every declaration kind
    // that can carry a leading annotation so authors aren't constrained
    // to put a fn or trait first in the file.
    let result = read_module_ann(node_handlers(prog))
    if result.is_some() {
        return result
    }
    let fns_sl = node_params(prog)
    if fns_sl != -1 && sublist_length(fns_sl) > 0 {
        let r = read_module_ann(node_handlers(sublist_get(fns_sl, 0)))
        if r.is_some() {
            return r
        }
    }
    let types_sl = node_fields(prog)
    if types_sl != -1 && sublist_length(types_sl) > 0 {
        let r = read_module_ann(node_handlers(sublist_get(types_sl, 0)))
        if r.is_some() {
            return r
        }
    }
    let traits_sl = node_arms(prog)
    if traits_sl != -1 && sublist_length(traits_sl) > 0 {
        let r = read_module_ann(node_handlers(sublist_get(traits_sl, 0)))
        if r.is_some() {
            return r
        }
    }
    let lets_sl = node_stmts(prog)
    if lets_sl != -1 && sublist_length(lets_sl) > 0 {
        let r = read_module_ann(node_handlers(sublist_get(lets_sl, 0)))
        if r.is_some() {
            return r
        }
    }
    None
}

pub fn reject_empty_module_annotation(prog: Int) ! Diag.Report {
    let ann = find_module_annotation(prog)
    if ann.is_some() && ann.unwrap() == "" {
        diag_error_no_loc("InvalidModuleAnnotation", INVALID_MODULE_ANNOTATION, "@module(\"\") is not a valid module name — empty string is not spec-authorized", "remove the @module(\"\") annotation")
    }
}

fn leaf_module_name(dotted_path: Str) -> Str {
    let mut last_dot = -1
    let mut i = 0
    while i < dotted_path.byte_len() {
        if dotted_path.byte_at(i) == 46 { // '.'
            last_dot = i
        }
        i = i + 1
    }
    if last_dot >= 0 {
        return dotted_path.byte_slice(last_dot + 1, dotted_path.byte_len())
    }
    dotted_path
}

fn dots_to_underscores(s: Str) -> Str {
    s.replace(".", "_")
}

pub fn find_src_root(source_path: Str) -> Str {
    match source_path.byte_index_of("/src/", 0) {
        Some(at) => { return source_path.byte_slice(0, at + 5) }
        None => {}
    }
    if source_path.byte_len() >= 4 && source_path.byte_slice(0, 4) == "src/" {
        return "src/"
    }
    // For files outside src/ (e.g. tests/), walk up to find the package root
    // via blink.toml. No fallback — orphan files (no enclosing blink.toml)
    // return "" and the resolver rejects bare external imports with E1010.
    let mut dir = path_dirname(source_path)
    while dir != "" && dir != "." && dir != "/" {
        if probe_file(path_join(dir, "blink.toml")) {
            return path_join(dir, "src/")
        }
        dir = path_dirname(dir)
    }
    if probe_file("blink.toml") {
        return "src/"
    }
    ""
}

fn read_pkg_name_from_toml(path: Str) -> Str {
    if !probe_file(path) {
        return ""
    }
    let content = note_config_text(path, read_file(path))
    toml_read_value(content, "package", "name") ?? ""
}

// A manifest or lockfile the loader is about to read. The loader reads it again itself, so
// these bytes are a second read, and the units a build records do not rest on them: a
// manifest or lockfile changes the emit only through which file an import loads, which the
// loaded files show, and through [lints], which the lint levels in force show.
fn note_config_file(path: Str) {
    let _ = note_config_text(path, read_file(path))
}

// A config file the loader read, with the bytes it read; returns those bytes.
fn note_config_text(path: Str, text: Str) -> Str {
    loaded_inputs.config_paths.push(path)
    loaded_inputs.config_texts.push(text)
    text
}

// Given a src_root like "examples/with_deps/mathlib/src/", return the path
// of the sibling blink.toml. Falls back to cwd "blink.toml" for loose files
// (src_root == "").
fn manifest_path_for_src_root(src_root: Str) -> Str {
    if src_root == "" {
        return "blink.toml"
    }
    let mut pkg_dir = src_root
    if pkg_dir.ends_with("/") {
        pkg_dir = pkg_dir.byte_slice(0, pkg_dir.byte_len() - 1)
    }
    // Match /src as a path boundary, not a suffix, so "foosrc" doesn't walk up.
    if pkg_dir == "src" || pkg_dir.ends_with("/src") {
        pkg_dir = path_parent(pkg_dir)
    }
    if pkg_dir == "" {
        pkg_dir = "."
    }
    path_join(pkg_dir, "blink.toml")
}

// Given a src_root like "examples/with_deps/mathlib/src/", return the
// package name from the sibling blink.toml. Returns "" if no manifest.
fn entry_pkg_for_src_root(src_root: Str) -> Str {
    if src_root == "" {
        return ""
    }
    read_pkg_name_from_toml(manifest_path_for_src_root(src_root))
}

fn validate_lockfile_versions() ! Diag.Report {
    let mut i = 0
    while i < lock_pkg_names.len() {
        let name = lock_pkg_names.get(i).unwrap()
        let version = lock_pkg_versions.get(i).unwrap()
        let mut j = i + 1
        while j < lock_pkg_names.len() {
            if lock_pkg_names.get(j).unwrap() == name {
                let other_version = lock_pkg_versions.get(j).unwrap()
                if other_version != version {
                    diag_error_no_loc("VersionConflict", VERSION_CONFLICT, "dependency version conflict for `{name}`: version {version} and version {other_version} both required — only one version per package is allowed", "run `blink update` to resolve, or pin dependencies to compatible versions")
                    return
                }
            }
            j = j + 1
        }
        i = i + 1
    }
}

let mut lockfile_loaded: Int = 0

fn ensure_lockfile_loaded(src_root: Str) ! Diag.Report {
    if lockfile_loaded == 1 {
        return
    }
    lockfile_loaded = 1
    let mut project_root = src_root
    if src_root.ends_with("src/") {
        project_root = src_root.byte_slice(0, src_root.byte_len() - 4)
    }
    if project_root == "" {
        project_root = "."
    }
    let lock_path_new = path_join(project_root, "blink.lock")
    if probe_file(lock_path_new) {
        note_config_file(lock_path_new)
        lockfile_load(lock_path_new)
        validate_lockfile_versions()
        return
    }
    let lock_path = path_join(project_root, "pact.lock")
    if probe_file(lock_path) {
        note_config_file(lock_path)
        lockfile_load(lock_path)
        validate_lockfile_versions()
        return
    }
    // Walk up from src_root looking for blink.lock / pact.lock
    let mut dir = src_root
    if dir.ends_with("/") {
        dir = dir.byte_slice(0, dir.byte_len() - 1)
    }
    let mut depth = 0
    while depth < 20 {
        let parent = path_dirname(dir)
        if parent == dir || parent == "" {
            return
        }
        let candidate_new = path_join(parent, "blink.lock")
        if probe_file(candidate_new) {
            note_config_file(candidate_new)
            lockfile_load(candidate_new)
            validate_lockfile_versions()
            return
        }
        let candidate = path_join(parent, "pact.lock")
        if probe_file(candidate) {
            note_config_file(candidate)
            lockfile_load(candidate)
            validate_lockfile_versions()
            return
        }
        dir = parent
        depth = depth + 1
    }
}

fn compiler_get_home() -> Str {
    env.var("HOME") ?? ""
}

fn resolve_from_lockfile(dotted_path: Str, _src_root: Str) -> Option[Str] ! Diag.Report {
    if lockfile_pkg_count() == 0 {
        return None
    }

    // Strategy: try progressively shorter prefixes of the dotted path
    // as package names, with the rest being the submodule path
    //
    // "import std.http" → package "std/http"
    // "import std.http.client" → package "std/http", submodule "client"
    // "import mylib" → package "mylib"
    // "import mylib.utils" → package "mylib", submodule "utils"

    let mut pkg_name = ""
    let mut sub_path = ""

    // Try the whole dotted path converted to slash-separated package name
    let full_pkg = dots_to_slashes(dotted_path)
    let idx_full = lockfile_find_pkg(full_pkg)
    if idx_full >= 0 {
        pkg_name = full_pkg
        sub_path = ""
    }

    // Try first segment as package name
    if pkg_name == "" {
        let mut dot_pos = -1
        let mut i = 0
        while i < dotted_path.byte_len() {
            if dotted_path.byte_at(i) == 46 { // '.'
                dot_pos = i
                i = dotted_path.byte_len()
            }
            i = i + 1
        }
        if dot_pos > 0 {
            let first = dotted_path.byte_slice(0, dot_pos)
            let rest = dotted_path.byte_slice(dot_pos + 1, dotted_path.byte_len())
            let idx_first = lockfile_find_pkg(first)
            if idx_first >= 0 {
                pkg_name = first
                sub_path = rest
            }
        } else {
            let idx_single = lockfile_find_pkg(dotted_path)
            if idx_single >= 0 {
                pkg_name = dotted_path
                sub_path = ""
            }
        }
    }

    // Try two-segment package name: "std.http.client" → "std/http" + "client"
    if pkg_name == "" {
        let mut _first_dot = -1
        let mut second_dot = -1
        let mut i = 0
        while i < dotted_path.byte_len() {
            if dotted_path.byte_at(i) == 46 { // '.'
                if _first_dot == -1 {
                    _first_dot = i
                } else if second_dot == -1 {
                    second_dot = i
                }
            }
            i = i + 1
        }
        if second_dot > 0 {
            let two_seg = dotted_path.byte_slice(0, second_dot)
            let two_pkg = dots_to_slashes(two_seg)
            let rest = dotted_path.byte_slice(second_dot + 1, dotted_path.byte_len())
            let idx_two = lockfile_find_pkg(two_pkg)
            if idx_two >= 0 {
                pkg_name = two_pkg
                sub_path = rest
            }
        }
    }

    if pkg_name == "" {
        return None
    }

    // Found a matching package — resolve to its source path
    let pkg_idx = lockfile_find_pkg(pkg_name)
    let source = lock_pkg_sources.get(pkg_idx).unwrap()

    let mut base_dir = ""
    if source.starts_with("path:") {
        base_dir = source.byte_slice(5, source.byte_len())
    } else if source.starts_with("git:") {
        let home = compiler_get_home()
        let mut url_part = source.byte_slice(4, source.byte_len())
        // Strip #commit suffix
        let mut hash_pos = -1
        let mut i = 0
        while i < url_part.byte_len() {
            if url_part.byte_at(i) == 35 { // '#'
                hash_pos = i
            }
            i = i + 1
        }
        let mut commit_hash = ""
        if hash_pos > 0 {
            commit_hash = url_part.byte_slice(hash_pos + 1, url_part.byte_len())
            url_part = url_part.byte_slice(0, hash_pos)
        }
        // Convert URL to cache dir name (replace non-alphanumeric with _)
        let mut cache_name = ""
        i = 0
        while i < url_part.byte_len() {
            let ch = url_part.byte_at(i)
            if (ch >= 97 && ch <= 122) || (ch >= 65 && ch <= 90) || (ch >= 48 && ch <= 57) { // 'a'..'z', 'A'..'Z', '0'..'9'
                cache_name = cache_name.concat(url_part.byte_slice(i, i + 1))
            } else {
                cache_name = cache_name.concat("_")
            }
            i = i + 1
        }
        base_dir = path_join(home, path_join(".blink/cache/git", path_join(cache_name, commit_hash)))
    }

    if base_dir == "" {
        return None
    }

    if sub_path == "" {
        // Spec §10.5: the bare-package entry file is <pkg-root>/src/<name>.bl
        // where <name> is [package].name from the package's blink.toml.
        // Fall back to the lockfile-recorded name if the package has no
        // manifest at base_dir (e.g. cached registry entries that ship
        // without a full manifest in their tree).
        let manifest_path = path_join(base_dir, "blink.toml")
        let mut entry_name = ""
        if probe_file(manifest_path) {
            entry_name = read_pkg_name_from_toml(manifest_path)
        }
        if entry_name == "" {
            entry_name = pkg_name
        }
        if entry_name == "" {
            return None
        }
        // entry_name comes either from validate_package_name'd manifest or
        // from the lockfile; in both cases dots are forbidden, so no
        // dots-to-slashes translation is needed here.
        let entry_path = path_join(base_dir, path_join("src", entry_name.concat(".bl")))
        if probe_file(entry_path) {
            return Some(entry_path)
        }
        diag_error_no_loc("PackageEntryNotFound", PACKAGE_ENTRY_NOT_FOUND, "package entry not found: `{dotted_path}` — expected `{entry_path}`", "create `{entry_path}`, or check the `name` field in `{manifest_path}`")
        return Some("")
    }

    let sub_rel = dots_to_slashes(sub_path)
    let resolved_bl = path_join(base_dir, path_join("src", sub_rel.concat(".bl")))
    if probe_file(resolved_bl) {
        return Some(resolved_bl)
    }
    let resolved = path_join(base_dir, path_join("src", sub_rel.concat(".pact")))
    if probe_file(resolved) {
        return Some(resolved)
    }
    None
}

// The reserved `blink.*` namespace (§07:1659) names compiler-internal
// pseudo-modules — `blink.ffi` (FFI pointer types + intrinsic namespace) and
// `blink.core` (ConversionError et al). These are part of the language
// definition, not distributable packages, so they resolve to no file: the
// `ffi` namespace and the `blink.core` types are compiler-known and usable
// WITHOUT any import. `import blink.ffi[.{...}]` / `import blink.core[.{...}]`
// are OPTIONAL documentation markers that must resolve as recognized inert
// no-ops — never ModuleNotFound (6-0 panel decision; the two real FFI gates are
// PtrOutsideFfiContext/E0811 and the #275 native-dependencies manifest requirement).
fn is_blink_pseudo_module(dotted_path: Str) -> Int {
    if dotted_path == "blink.ffi" { return 1 }
    if dotted_path == "blink.core" { return 1 }
    0
}

pub fn resolve_module_path(dotted_path: Str, src_root: Str) -> Str ! Diag.Report {
    let is_std_ns = dotted_path.starts_with("std.")
    let is_pkg_ns = dotted_path.starts_with("pkg.")

    // Reserved blink.* pseudo-modules resolve to an inert sentinel before the
    // orphan-file guard, so `import blink.ffi` from a file with no enclosing
    // blink.toml is accepted (it names a compiler-internal module, not an
    // external package). Nothing is loaded or parsed for this sentinel.
    if is_blink_pseudo_module(dotted_path) {
        return "<blink-pseudo:{dotted_path}>"
    }

    // Orphan-file guard: a source file with no enclosing blink.toml has
    // src_root == "". Bare external imports from such a file are E1010 —
    // only stdlib (std.*) and bundled package-manager modules (pkg.*) are
    // allowed without a package context.
    if src_root == "" && !is_std_ns && !is_pkg_ns {
        diag_error_no_loc("OrphanFile", ORPHAN_FILE, "import `{dotted_path}` is not allowed — file has no enclosing blink.toml so it is not part of any package", "create a blink.toml above this file, or import only std.* / pkg.* modules")
        return ""
    }

    let rel = dots_to_slashes(dotted_path)
    let full_bl = path_join(src_root, rel.concat(".bl"))
    let bl_exists = probe_file(full_bl)
    let full_pact = path_join(src_root, rel.concat(".pact"))
    let full = if bl_exists { full_bl } else { full_pact }

    // Step 1: Check local src/ (skip for std.* — reserved stdlib namespace)
    let local_exists = if is_std_ns { 0 } else if bl_exists { 1 } else { probe_file(full_pact) }

    // Step 2: Check dependencies via blink.lock
    ensure_lockfile_loaded(src_root)
    let dep_path = resolve_from_lockfile(dotted_path, src_root)

    // If local exists, use it (but warn if it shadows a dependency)
    if local_exists {
        if dep_path.is_some() && dep_path.unwrap() != "" {
            // The span is the shadowing file, as in the spec, so the repeat check of the sink
            // keeps one report per check however many files import it or however often it
            // resolves.
            diag_warn_in_file_notes("ShadowedDependency", SHADOWED_DEPENDENCY, "local module shadows dependency", full, 1, 1,
                "this is allowed but may confuse consumers expecting the library",
                ["shadows package `{dotted_path}` from blink.toml"])
        }
        return full
    }

    // Use dependency path if found
    if dep_path.is_some() {
        return dep_path.unwrap()
    }

    // Step 3: Check pkg. prefix (bundled package-manager modules)
    if dotted_path.starts_with("pkg.") {
        let compiler_dir = path_dirname(get_arg(0))
        let pkg_rel = dots_to_slashes(dotted_path.byte_slice(4, dotted_path.byte_len()))
        let pkg_full_bl = path_join(compiler_dir, path_join("lib/pkg", pkg_rel.concat(".bl")))
        if probe_file(pkg_full_bl) {
            return pkg_full_bl
        }
        let pkg_full = path_join(compiler_dir, path_join("lib/pkg", pkg_rel.concat(".pact")))
        if probe_file(pkg_full) {
            return pkg_full
        }
        let blink_root = env.var("BLINK_ROOT") ?? ""
        if blink_root != "" {
            let pkg_root_bl = path_join(blink_root, path_join("lib/pkg", pkg_rel.concat(".bl")))
            if probe_file(pkg_root_bl) {
                return pkg_root_bl
            }
            let pkg_root = path_join(blink_root, path_join("lib/pkg", pkg_rel.concat(".pact")))
            if probe_file(pkg_root) {
                return pkg_root
            }
        }
        let pkg_key = "pkg/".concat(dots_to_underscores(dotted_path.byte_slice(4, dotted_path.byte_len())))
        if embedded_contains(pkg_key) != 0 {
            return "<embedded:{pkg_key}>"
        }
    }

    // Step 4: Check std. prefix (bundled stdlib)
    if dotted_path.starts_with("std.") {
        let compiler_dir = path_dirname(get_arg(0))
        let std_rel = dots_to_slashes(dotted_path.byte_slice(4, dotted_path.byte_len()))
        let std_key = "std/".concat(dots_to_underscores(dotted_path.byte_slice(4, dotted_path.byte_len())))
        let mut std_resolved = ""
        let std_full_bl = path_join(compiler_dir, path_join("lib/std", std_rel.concat(".bl")))
        if probe_file(std_full_bl) {
            std_resolved = std_full_bl
        }
        if std_resolved == "" {
            let std_full = path_join(compiler_dir, path_join("lib/std", std_rel.concat(".pact")))
            if probe_file(std_full) {
                std_resolved = std_full
            }
        }
        if std_resolved == "" {
            let blink_root = env.var("BLINK_ROOT") ?? ""
            if blink_root != "" {
                let std_root_bl = path_join(blink_root, path_join("lib/std", std_rel.concat(".bl")))
                if probe_file(std_root_bl) {
                    std_resolved = std_root_bl
                }
                if std_resolved == "" {
                    let std_root = path_join(blink_root, path_join("lib/std", std_rel.concat(".pact")))
                    if probe_file(std_root) {
                        std_resolved = std_root
                    }
                }
            }
        }
        if std_resolved == "" {
            if embedded_contains(std_key) != 0 {
                std_resolved = "<embedded:{std_key}>"
            }
        }
        if std_resolved != "" {
            return std_resolved
        }
    }

    let npkgs = lockfile_pkg_count()
    if npkgs > 0 {
        diag_error_no_loc_notes("ModuleNotFound", MODULE_NOT_FOUND, "module not found: {dotted_path} (looked at: {full_bl}, checked {npkgs} lockfile packages)", "", unknown_section_notes())
    } else {
        diag_error_no_loc_notes("ModuleNotFound", MODULE_NOT_FOUND, "module not found: {dotted_path} (looked at: {full_bl}; no dependencies - run `blink add` to add packages)", "", unknown_section_notes())
    }
    ""
}

fn should_import_item(item: Int, import_node: Int) -> Int {
    let names_sl = node_args(import_node)
    if names_sl == -1 {
        return 1
    }
    let item_name = node_name(item)
    let mut i = 0
    while i < sublist_length(names_sl) {
        let name_node = sublist_get(names_sl, i)
        if node_name(name_node) == item_name {
            return 1
        }
        i = i + 1
    }
    0
}

pub fn merge_programs(main_prog: Int, imported: List[Int], _import_nodes_list: List[Int]) -> Int ! Parse.Build {
    let mut all_fns: List[Int] = []
    let mut all_types: List[Int] = []
    let mut all_lets: List[Int] = []
    let mut all_traits: List[Int] = []
    let mut all_impls: List[Int] = []
    let mut all_effects: List[Int] = []
    // Each effect name → the module that first declared it. A second module's effect of that
    // name is dropped, as before; a repeat in one module is kept so name resolution reports it.
    let mut seen_effects: Map[Str, Str] = Map()

    let mut pi = 0
    while pi < imported.len() {
        let prog = imported.get(pi).unwrap()
        let mod_name = import_map_modules.get(pi).unwrap()
        let source_mod = import_map_source_modules.get(pi).unwrap()

        let fns_sl = node_params(prog)
        let mut fi = 0
        while fi < sublist_length(fns_sl) {
            let fn_node = sublist_get(fns_sl, fi)
            node_set_module(fn_node, mod_name)
            record_source_module(fn_node, source_mod)
            all_fns.push(fn_node)
            fi = fi + 1
        }

        let types_sl = node_fields(prog)
        let mut ti = 0
        while ti < sublist_length(types_sl) {
            let type_node = sublist_get(types_sl, ti)
            node_set_module(type_node, mod_name)
            record_source_module(type_node, source_mod)
            all_types.push(type_node)
            ti = ti + 1
        }

        let lets_sl = node_stmts(prog)
        let mut li = 0
        while li < sublist_length(lets_sl) {
            let let_node = sublist_get(lets_sl, li)
            node_set_module(let_node, mod_name)
            record_source_module(let_node, source_mod)
            all_lets.push(let_node)
            li = li + 1
        }

        let traits_sl = node_arms(prog)
        let mut tri = 0
        while tri < sublist_length(traits_sl) {
            let trait_node = sublist_get(traits_sl, tri)
            node_set_module(trait_node, mod_name)
            record_source_module(trait_node, source_mod)
            all_traits.push(trait_node)
            tri = tri + 1
        }

        let impls_sl = node_methods(prog)
        let mut ii = 0
        while ii < sublist_length(impls_sl) {
            let impl_node = sublist_get(impls_sl, ii)
            node_set_module(impl_node, mod_name)
            record_source_module(impl_node, source_mod)
            all_impls.push(impl_node)
            ii = ii + 1
        }

        let effects_sl = node_args(prog)
        if effects_sl != -1 {
            let mut edi = 0
            while edi < sublist_length(effects_sl) {
                let eff_node = sublist_get(effects_sl, edi)
                let eff_name = node_name(eff_node)
                let first_mod = seen_effects.get(eff_name) ?? mod_name
                if first_mod == mod_name {
                    node_set_module(eff_node, mod_name)
                    record_source_module(eff_node, source_mod)
                    all_effects.push(eff_node)
                    seen_effects.insert(eff_name, mod_name)
                }
                edi = edi + 1
            }
        }

        pi = pi + 1
    }

    let main_mod = "__main__"
    diag_module_files.insert(main_mod, diag_source_file)
    tc_record_module_package(main_mod, module_package_id("", diag_source_file))

    let main_fns = node_params(main_prog)
    let mut fi = 0
    while fi < sublist_length(main_fns) {
        let fn_node = sublist_get(main_fns, fi)
        node_set_module(fn_node, main_mod)
        all_fns.push(fn_node)
        fi = fi + 1
    }
    let main_types = node_fields(main_prog)
    let mut ti = 0
    while ti < sublist_length(main_types) {
        let type_node = sublist_get(main_types, ti)
        node_set_module(type_node, main_mod)
        all_types.push(type_node)
        ti = ti + 1
    }
    let main_lets = node_stmts(main_prog)
    let mut li = 0
    while li < sublist_length(main_lets) {
        let let_node = sublist_get(main_lets, li)
        node_set_module(let_node, main_mod)
        all_lets.push(let_node)
        li = li + 1
    }
    let main_traits = node_arms(main_prog)
    let mut tri = 0
    while tri < sublist_length(main_traits) {
        let trait_node = sublist_get(main_traits, tri)
        node_set_module(trait_node, main_mod)
        all_traits.push(trait_node)
        tri = tri + 1
    }
    let main_impls = node_methods(main_prog)
    let mut ii = 0
    while ii < sublist_length(main_impls) {
        let impl_node = sublist_get(main_impls, ii)
        node_set_module(impl_node, main_mod)
        all_impls.push(impl_node)
        ii = ii + 1
    }
    let main_effects = node_args(main_prog)
    if main_effects != -1 {
        let mut edi = 0
        while edi < sublist_length(main_effects) {
            let eff_node = sublist_get(main_effects, edi)
            let eff_name = node_name(eff_node)
            let first_mod = seen_effects.get(eff_name) ?? main_mod
            if first_mod == main_mod {
                node_set_module(eff_node, main_mod)
                all_effects.push(eff_node)
                seen_effects.insert(eff_name, main_mod)
            }
            edi = edi + 1
        }
    }

    let merged_fns = new_sublist()
    fi = 0
    while fi < all_fns.len() {
        sublist_push(merged_fns, all_fns.get(fi).unwrap())
        fi = fi + 1
    }
    finalize_sublist(merged_fns)

    let merged_types = new_sublist()
    ti = 0
    while ti < all_types.len() {
        sublist_push(merged_types, all_types.get(ti).unwrap())
        ti = ti + 1
    }
    finalize_sublist(merged_types)

    let merged_lets = new_sublist()
    li = 0
    while li < all_lets.len() {
        sublist_push(merged_lets, all_lets.get(li).unwrap())
        li = li + 1
    }
    finalize_sublist(merged_lets)

    let merged_traits = new_sublist()
    tri = 0
    while tri < all_traits.len() {
        sublist_push(merged_traits, all_traits.get(tri).unwrap())
        tri = tri + 1
    }
    finalize_sublist(merged_traits)

    let merged_impls = new_sublist()
    ii = 0
    while ii < all_impls.len() {
        sublist_push(merged_impls, all_impls.get(ii).unwrap())
        ii = ii + 1
    }
    finalize_sublist(merged_impls)

    let mut merged_effects = -1
    if all_effects.len() > 0 {
        merged_effects = new_sublist()
        let mut edi = 0
        while edi < all_effects.len() {
            sublist_push(merged_effects, all_effects.get(edi).unwrap())
            edi = edi + 1
        }
        finalize_sublist(merged_effects)
    }

    let merged = new_node(NodeKind.Program)
    node_set_params(merged, merged_fns)
    node_set_fields(merged, merged_types)
    node_set_stmts(merged, merged_lets)
    node_set_arms(merged, merged_traits)
    node_set_methods(merged, merged_impls)
    node_set_args(merged, merged_effects)
    let main_tests = node_captures(main_prog)
    node_set_captures(merged, main_tests)
    let main_anns = node_handlers(main_prog)
    node_set_handlers(merged, main_anns)
    merged
}

// What the loader read for the program it last loaded.
pub type LoadedInputs {
    // Each file the loader took, so no file loads twice.
    files: List[Str]
    // Each file the loader lexed and the text it lexed, in load order. The per-module build
    // keys its reuse of the last build's units on these bytes, not on a later read of the
    // file, which an edit since the load could make differ from what this build compiled.
    source_paths: List[Str]
    source_texts: List[Str]
    // Parallel to source_paths: the module each source is part of, and the nodes the parser
    // built for it as [first, end). A per-module build keys each unit on the sources whose
    // nodes the unit's IR spans.
    source_modules: List[Str]
    source_first_nodes: List[Int]
    source_end_nodes: List[Int]
    // Parallel to source_paths: each source but for its fn bodies, as the parser gives it. A
    // unit that read no body or position of a source keys on this text alone.
    source_interfaces: List[Str]
    // Parallel to source_paths while the loader defers the interface texts: what each text is
    // written from, until fill_source_interfaces writes it. Empty otherwise.
    interface_parts: List[List[Str]]
    // Each manifest and lockfile the loader read, and its text.
    config_paths: List[Str]
    config_texts: List[Str]
    // Each `#embed` file in the order the loader first read it, and its bytes by path. The
    // expression stage embeds these bytes, so the program holds the bytes the input record
    // names, not those of a later read.
    embed_paths: List[Str]
    embed_texts: Map[Str, Str]
    // Each path the loader asked about to decide which file an import, a manifest, a lockfile
    // or an `#embed` names, in the order it first asked, and whether a file was there. The
    // files above say what the loader read; these say what it would have read instead, so a
    // new file that an import now finds, or that now shadows the one it found, shows here.
    probe_paths: List[Str]
    probe_found: Map[Str, Bool]
    // The package root of each loaded file, whose audits.toml its `@trusted(audit: K)` resolves
    // against, and the records read from each root's audits.toml (§9.1). A file of the
    // standard library or of a toolchain package has no root here.
    audit_dirs: Map[Str, Str]
    audit_records: Map[Str, AuditRecords]
}

fn loaded_inputs_empty() -> LoadedInputs {
    LoadedInputs { files: [], source_paths: [], source_texts: [], source_modules: [], source_first_nodes: [], source_end_nodes: [], source_interfaces: [], interface_parts: [], config_paths: [], config_texts: [], embed_paths: [], embed_texts: Map(), probe_paths: [], probe_found: Map(), audit_dirs: Map(), audit_records: Map() }
}

pub let mut loaded_inputs: LoadedInputs = loaded_inputs_empty()
pub let mut import_map_paths: List[Str] = []
pub let mut import_map_nodes: List[Int] = []
pub let mut import_map_modules: List[Str] = []
pub let mut import_map_qualifiers: List[Str] = []
// Parallel to import_map_modules: dotted-path-derived module key.
// Populated for every imported file; archive codegen uses it to
// identify a decl's source-of-origin.
pub let mut import_map_source_modules: List[Str] = []
let mut root_import_nodes: List[Int] = []
let mut root_import_modules: List[Str] = []
let mut root_import_qualifiers: List[Str] = []
let mut embedded_stdlib: Map[Str, Str] = Map()

pub fn register_embedded(key: Str, source: Str) {
    embedded_stdlib.insert(key, source)
}

pub fn embedded_contains(key: Str) -> Int {
    embedded_stdlib.contains_key(key)
}

pub fn embedded_get_source(key: Str) -> Str {
    embedded_stdlib.get(key).unwrap()
}

pub fn embedded_keys() -> List[Str] {
    embedded_stdlib.keys()
}

// The package of each cross-package import and the package it imports, by index.
type PkgEdges {
    importers: List[Str]
    imported: List[Str]
}

let mut pkg_edges: PkgEdges = PkgEdges { importers: [], imported: [] }
let mut current_import_file: Str = ""
let mut current_import_module: Str = "__main__"

fn extract_package(file_path: Str, src_root: Str) -> Str {
    if file_path.starts_with("<embedded:") {
        return ""
    }
    if !file_path.starts_with(src_root) {
        return ""
    }
    let rel = file_path.byte_slice(src_root.byte_len(), file_path.byte_len())
    let mut i = 0
    while i < rel.byte_len() {
        if rel.byte_at(i) == 47 { // '/'
            return rel.byte_slice(0, i)
        }
        i = i + 1
    }
    "__root__"
}

fn detect_package_cycles() -> Str {
    let mut all_pkgs: Map[Str, Int] = Map()
    let mut adj: Map[Str, List[Str]] = Map()
    let mut i = 0
    while i < pkg_edges.importers.len() {
        let from = pkg_edges.importers.get(i).unwrap()
        let to = pkg_edges.imported.get(i).unwrap()
        all_pkgs.insert(from, 1)
        all_pkgs.insert(to, 1)
        if adj.contains_key(from) == 0 {
            let mut neighbors: List[Str] = []
            neighbors.push(to)
            adj.insert(from, neighbors)
        } else {
            let mut neighbors = adj.get(from).unwrap()
            let mut already = 0
            let mut j = 0
            while j < neighbors.len() {
                if neighbors.get(j).unwrap() == to {
                    already = 1
                }
                j = j + 1
            }
            if already == 0 {
                neighbors.push(to)
                adj.insert(from, neighbors)
            }
        }
        i = i + 1
    }

    let pkg_list = all_pkgs.keys()
    let mut visited: Map[Str, Int] = Map()
    let mut in_stack: Map[Str, Int] = Map()
    let mut stack: List[Str] = []
    let mut cycle_path = ""

    let mut pi = 0
    while pi < pkg_list.len() {
        let pkg = pkg_list.get(pi).unwrap()
        if visited.contains_key(pkg) == 0 {
            stack.clear()
            let result = dfs_detect_cycle(pkg, adj, visited, in_stack, stack)
            if result != "" {
                cycle_path = result
                return cycle_path
            }
        }
        pi = pi + 1
    }
    ""
}

fn dfs_detect_cycle(node: Str, adj: Map[Str, List[Str]], visited: Map[Str, Int], in_stack: Map[Str, Int], stack: List[Str]) -> Str {
    visited.insert(node, 1)
    in_stack.insert(node, 1)
    stack.push(node)

    if adj.contains_key(node) != 0 {
        let neighbors = adj.get(node).unwrap()
        let mut i = 0
        while i < neighbors.len() {
            let neighbor = neighbors.get(i).unwrap()
            if in_stack.contains_key(neighbor) != 0 {
                let mut cycle_parts: List[Str] = []
                let mut j = 0
                let mut found_start = 0
                while j < stack.len() {
                    if stack.get(j).unwrap() == neighbor {
                        found_start = 1
                    }
                    if found_start != 0 {
                        cycle_parts.push(stack.get(j).unwrap())
                    }
                    j = j + 1
                }
                cycle_parts.push(neighbor)
                let sb = StringBuilder.new()
                let mut k = 0
                while k < cycle_parts.len() {
                    if k > 0 {
                        sb.write(" -> ")
                    }
                    sb.write(cycle_parts.get(k).unwrap())
                    k = k + 1
                }
                return sb.to_str()
            }
            if visited.contains_key(neighbor) == 0 {
                let result = dfs_detect_cycle(neighbor, adj, visited, in_stack, stack)
                if result != "" {
                    return result
                }
            }
            i = i + 1
        }
    }

    in_stack.remove(node)
    stack.pop()
    ""
}

pub fn reset_compiler_state() {
    let cold = source_keep.cold_next
    source_keep = SourceKeep { next: kept_sources_empty(), reused: 0, redo: false, dirty: false, cold_next: false, emptied: true, ..source_keep }
    if !cold && parser_has_parsed_end() && source_keep.kept.paths.len() > 0 && kept_sources_live() * 2 >= parser_parsed_end() {
        parser_rewind()
        source_keep.emptied = false
    } else {
        source_keep.kept = kept_sources_empty()
        parser_reset()
    }
    loaded_inputs = loaded_inputs_empty()
    import_map_paths.clear()
    import_map_nodes.clear()
    import_map_modules.clear()
    import_map_source_modules.clear()
    import_map_qualifiers.clear()
    clear_module_imports()
    root_import_nodes.clear()
    root_import_modules.clear()
    root_import_qualifiers.clear()
    tc_reexport_source.clear()
    tc_reexport_modules.clear()
    pkg_edges = PkgEdges { importers: [], imported: [] }
    current_import_file = ""
    current_import_module = "__main__"
    lockfile_loaded = 0
    // A load that finds no lockfile keeps whatever packages are loaded, so in a process that
    // loads again, a deleted lockfile would still resolve its packages.
    lockfile_clear()
}

fn find_module_key(file_path: Str) -> Str {
    let display = diag_normalize_path(file_path)
    let mut i = 0
    while i < import_map_paths.len() {
        if import_map_paths.get(i).unwrap() == display {
            return import_map_modules.get(i).unwrap()
        }
        i = i + 1
    }
    ""
}

// The module and node range of the source pushed last, which the parser has just parsed or
// the loader kept from the last load.
fn record_source_nodes(module: Str, parsed: ParsedSource) {
    loaded_inputs.source_modules.push(module)
    loaded_inputs.source_first_nodes.push(parsed.first)
    loaded_inputs.source_end_nodes.push(parsed.end)
    // An embedded source comes with the compiler, which the inputs name by its sha, so its
    // interface could tell a build nothing the inputs do not.
    let path = loaded_inputs.source_paths.get(loaded_inputs.source_paths.len() - 1) ?? ""
    let wanted = !path.starts_with("<embedded:")
    let deferred = parser_interface_text_deferred()
    let mut parts: List[Str] = []
    let mut text = ""
    if parsed.kept >= 0 {
        parts = source_keep.kept.parts.get(parsed.kept).unwrap()
        text = source_keep.kept.interfaces.get(parsed.kept).unwrap()
    } else if deferred {
        parts = parsed_interface_parts(wanted)
    } else {
        text = parsed_interface_text(wanted)
    }
    if deferred {
        loaded_inputs.source_interfaces.push("")
        loaded_inputs.interface_parts.push(parts)
    } else {
        loaded_inputs.source_interfaces.push(text)
    }
    if parsed.cacheable {
        source_keep.next.paths.push(path)
        source_keep.next.texts.push(loaded_inputs.source_texts.get(loaded_inputs.source_texts.len() - 1) ?? "")
        source_keep.next.programs.push(parsed.program)
        source_keep.next.firsts.push(parsed.first)
        source_keep.next.ends.push(parsed.end)
        source_keep.next.anns_in.push(parsed.anns_in)
        source_keep.next.anns_out.push(parsed.anns_out)
        source_keep.next.parts.push(parts)
        source_keep.next.interfaces.push(text)
    }
}

// A daemon recheck keeps the nodes of each source whose bytes did not change since the last
// load: the parser rewinds them to what the parse wrote, and the loader parses only the
// sources that changed, at the end of the pool. A kept source carries what its parse left
// beyond its nodes: its interface text, and the program-level annotations the parse handed
// on to the parses after it. A parse reads the ones handed to it, so they are part of its key.
type KeptSources {
    paths: List[Str]
    texts: List[Str]
    programs: List[Int]
    firsts: List[Int]
    ends: List[Int]
    anns_in: List[List[Int]]
    anns_out: List[List[Int]]
    parts: List[List[Str]]
    interfaces: List[Str]
    // How the parser was asked for interface texts, which the kept ones were written for.
    wanted: Bool
    deferred: Bool
    // The paths of every source of the load, kept or not, in load order.
    order: List[Str]
}

fn kept_sources_empty() -> KeptSources {
    KeptSources { paths: [], texts: [], programs: [], firsts: [], ends: [], anns_in: [], anns_out: [], parts: [], interfaces: [], wanted: false, deferred: false, order: [] }
}

// The sources the last load left to keep, and those this load leaves for the next.
type SourceKeep {
    kept: KeptSources
    next: KeptSources
    // How many sources this load kept, and whether it must run again with none kept.
    reused: Int
    redo: Bool
    // Whether a parse of this load reported anything.
    dirty: Bool
    // Whether the next load parses every source. A load that runs again for redo is one; so
    // is each load after a parse that reported anything, so a source with a parse error never
    // runs beside kept nodes and a check that keeps failing to parse pays for one load, not two.
    cold_next: Bool
    // Whether this load started from an empty node pool. One that undid the last load in place
    // gives its nodes other ids than a cold load, even when it keeps no source.
    emptied: Bool
}

let mut source_keep: SourceKeep = SourceKeep { kept: kept_sources_empty(), next: kept_sources_empty(), reused: 0, redo: false, dirty: false, cold_next: false, emptied: true }

// One source of a load: its program node, its nodes as [first, end), the index of the kept
// source it took them from or -1, and whether the next load may keep them.
type ParsedSource {
    program: Int
    first: Int
    end: Int
    kept: Int
    cacheable: Bool
    anns_in: List[Int]
    anns_out: List[Int]
}

fn kept_source_index(path: Str, text: Str, anns_in: List[Int]) -> Int {
    if !parser_has_parsed_end() { return -1 }
    if source_keep.kept.wanted != parser_interface_text_wanted() || source_keep.kept.deferred != parser_interface_text_deferred() { return -1 }
    let mut i = 0
    while i < source_keep.kept.paths.len() {
        if source_keep.kept.paths.get(i).unwrap() == path {
            if source_keep.kept.texts.get(i).unwrap() != text || source_keep.kept.anns_in.get(i).unwrap() != anns_in { return -1 }
            return i
        }
        i = i + 1
    }
    -1
}

// What the diagnostics hold so far, which only grows: entries, ices and lex cutoffs.
fn diag_tally() -> List[Int] {
    [diag_entry_count(), diag_ice_count, diag_cutoff_count()]
}

fn parse_source(path: Str, source: Str) -> ParsedSource ! Lex.Tokenize, Parse, Diag.Report {
    let anns_in = parser_program_annotations()
    let k = kept_source_index(path, source, anns_in)
    if k >= 0 {
        source_keep.reused = source_keep.reused + 1
        parser_set_program_annotations(source_keep.kept.anns_out.get(k).unwrap())
        return ParsedSource { program: source_keep.kept.programs.get(k).unwrap(), first: source_keep.kept.firsts.get(k).unwrap(), end: source_keep.kept.ends.get(k).unwrap(), kept: k, cacheable: true, anns_in: anns_in, anns_out: source_keep.kept.anns_out.get(k).unwrap() }
    }
    // A source whose parse reported anything is parsed again, so the next load reports it too.
    let before = diag_tally()
    lex(source)
    pos = 0
    let first = node_count()
    let program = parse_program()
    attach_comments_pass(program, first)
    let end = node_count()
    parser_mark_parsed()
    let clean = diag_tally() == before
    if !clean { source_keep.dirty = true }
    ParsedSource { program: program, first: first, end: end, kept: -1, cacheable: clean && parser_keeps_parsed(), anns_in: anns_in, anns_out: parser_program_annotations() }
}

// The sources of this load become the kept ones. A load that kept a source but read other
// sources, or the same ones in another order, must run again with none kept: the merge and
// every pass after it read the program in load order, which only a cold load is known to give.
fn end_source_load() {
    let mut order: List[Str] = []
    for p in loaded_inputs.source_paths { order.push(p) }
    if source_keep.reused > 0 && (order != source_keep.kept.order || source_keep.dirty) {
        source_keep.redo = true
    }
    source_keep.cold_next = source_keep.redo || source_keep.dirty
    let kept = KeptSources { order: order, wanted: parser_interface_text_wanted(), deferred: parser_interface_text_deferred(), ..source_keep.next }
    source_keep = SourceKeep { kept: kept, next: kept_sources_empty(), ..source_keep }
    parser_set_load_order(loaded_inputs.source_first_nodes, loaded_inputs.source_end_nodes)
}

// Whether the loader keeps parsed sources from one load to the next. Either way it drops
// what it kept.
pub fn loader_keep_sources(on: Bool) {
    parser_keep_parsed(on)
    source_keep.kept = kept_sources_empty()
}

// Stops keeping sources, as loader_keep_sources(false) does, for a build from the last load:
// it loads nothing again, but reads the order that load put the sources in.
pub fn loader_keep_sources_for_build() {
    parser_keep_load_order_only()
    source_keep.kept = kept_sources_empty()
}

// The next load parses every source.
pub fn loader_load_cold_next() {
    source_keep.cold_next = true
}

pub fn loader_keeps_sources() -> Bool { parser_keeps_parsed() }

pub fn loader_reused_sources() -> Int { source_keep.reused }

pub fn loader_must_redo() -> Bool { source_keep.redo }

pub fn loader_load_was_cold() -> Bool { source_keep.emptied }

// The nodes the kept sources hold. The rest below the parsed end are dead, and once they
// outnumber these, the next load starts again from an empty pool.
fn kept_sources_live() -> Int {
    let mut n = 0
    let mut i = 0
    while i < source_keep.kept.firsts.len() {
        n = n + source_keep.kept.ends.get(i).unwrap() - source_keep.kept.firsts.get(i).unwrap()
        i = i + 1
    }
    n
}

// Writes each interface text the loader deferred.
pub fn fill_source_interfaces() {
    let mut i = 0
    while i < loaded_inputs.interface_parts.len() && i < loaded_inputs.source_interfaces.len() {
        loaded_inputs.source_interfaces.set(i, interface_text_of(loaded_inputs.interface_parts.get(i).unwrap()))
        i = i + 1
    }
    loaded_inputs.interface_parts = []
}

fn is_file_loaded(path: Str) -> Int {
    let mut i = 0
    while i < loaded_inputs.files.len() {
        if loaded_inputs.files.get(i).unwrap() == path {
            return 1
        }
        i = i + 1
    }
    0
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn load_module(dotted_path: Str, file_path: Str, src_root: Str, all_programs: List[Int], imp_node: Int, label: Str) ! Lex.Tokenize, Parse, Diag.Report {
    loaded_inputs.files.push(file_path)
    note_audit_dir(file_path)
    if trace_mode != "" { trace("parse", "{label} {dotted_path} -> {file_path}") }
    let mut source = ""
    if file_path.starts_with("<embedded:") {
        let key = embedded_inner_key(file_path)
        source = embedded_get_source(key)
    } else {
        source = read_file(file_path)
    }
    loaded_inputs.source_paths.push(file_path)
    loaded_inputs.source_texts.push(source)
    load_phase_check(node_count())
    // Lexer and parser diagnostics take their file from diag_source_file, which names the
    // entry file until this module's text is the one being read.
    let display_path = diag_normalize_path(file_path)
    let entry_diag_file = diag_source_file
    diag_source_file = display_path
    let parsed = parse_source(file_path, source)
    diag_source_file = entry_diag_file
    let imported_prog = parsed.program
    diag_register_file_range(parsed.first, parsed.end, display_path)
    let mut mod_key = dots_to_underscores(dotted_path)
    let source_mod_key = mod_key
    let mut qualifier = leaf_module_name(dotted_path)
    let override_key = find_module_annotation(imported_prog)
    if override_key.is_some() {
        let ann_val = override_key.unwrap()
        if ann_val == "" {
            let saved_diag = diag_source_file
            diag_source_file = display_path
            reject_empty_module_annotation(imported_prog)
            diag_source_file = saved_diag
        }
        if ann_val != "" {
            let pkg = extract_package(file_path, src_root)
            if pkg != "" && pkg != "__root__" && ann_val != pkg {
                let saved_diag = diag_source_file
                diag_source_file = display_path
                diag_error_no_loc("InvalidModuleAnnotation", INVALID_MODULE_ANNOTATION, "@module(\"{ann_val}\") is invalid — file is in package `{pkg}`, @module can only use the parent package name `{pkg}`", "use @module(\"{pkg}\") or remove the annotation")
                diag_source_file = saved_diag
            } else {
                // Spec §10.5: the package entry file is <root>/src/<name>.bl.
                // If this file's basename matches its own package's
                // [package].name, it IS the entry file — its @module argument
                // must equal the package name. Non-entry files remain
                // unconstrained at the root level. Works whether the file is
                // in the current package (pkg == "__root__") or in a
                // dependency (pkg == "" because file_path is outside src_root).
                let own_src_root = find_src_root(file_path)
                let entry_pkg = entry_pkg_for_src_root(own_src_root)
                if entry_pkg != "" {
                    let basename = path_stem(file_path)
                    if basename == entry_pkg && ann_val != entry_pkg {
                        let saved_diag = diag_source_file
                        diag_source_file = display_path
                        diag_error_no_loc("InvalidModuleAnnotation", INVALID_MODULE_ANNOTATION, "@module(\"{ann_val}\") is invalid — entry file of package `{entry_pkg}` must declare @module(\"{entry_pkg}\") or omit the annotation", "use @module(\"{entry_pkg}\") or remove the annotation")
                        diag_source_file = saved_diag
                    }
                }
            }
            qualifier = ann_val
        } else {
            qualifier = ""
        }
        mod_key = ann_val
    }
    // Before collect_imports, whose loads push sources of their own.
    record_source_nodes(mod_key, parsed)
    let saved_import_file = current_import_file
    let saved_import_module = current_import_module
    current_import_file = file_path
    current_import_module = mod_key
    collect_imports(imported_prog, src_root, all_programs)
    current_import_file = saved_import_file
    current_import_module = saved_import_module
    all_programs.push(imported_prog)
    import_map_paths.push(display_path)
    import_map_nodes.push(imp_node)
    import_map_modules.push(mod_key)
    import_map_source_modules.push(source_mod_key)
    import_map_qualifiers.push(qualifier)
    diag_module_files.insert(mod_key, display_path)
    tc_record_module_package(mod_key, module_package_id(dotted_path, file_path))
}

// The package a loaded file belongs to: the bundled stdlib, one bundled package, or the
// source root of a package on disk. A file under no source root is a package of its own.
fn module_package_id(dotted_path: Str, file_path: Str) -> Str {
    if dotted_path.starts_with("std.") { return "std" }
    if dotted_path.starts_with("pkg.") {
        let rest = dotted_path.byte_slice(4, dotted_path.byte_len())
        let head = match rest.byte_index_of(".", 0) {
            Some(at) => rest.byte_slice(0, at)
            None => rest
        }
        return "pkg.{head}"
    }
    let root = find_src_root(file_path)
    if root != "" { root } else { file_path }
}

pub fn collect_imports(program: Int, src_root: Str, all_programs: List[Int]) ! Lex.Tokenize, Parse, Diag.Report {
    let imports_sl = node_elements(program)
    if imports_sl == -1 {
        return
    }
    let src_pkg = extract_package(current_import_file, src_root)
    let mut i = 0
    while i < sublist_length(imports_sl) {
        let imp_node = sublist_get(imports_sl, i)
        let dotted_path = node_str_val(imp_node)
        let file_path = resolve_module_path(dotted_path, src_root)
        // blink.* pseudo-modules resolve to an inert sentinel with no backing
        // source — record the import for selective-name resolution but never
        // load/parse a file for it.
        let is_pseudo = file_path.starts_with("<blink-pseudo:")
        if file_path != "" && is_pseudo == 0 {
            let tgt_pkg = extract_package(file_path, src_root)
            if src_pkg != "" && tgt_pkg != "" && src_pkg != tgt_pkg {
                pkg_edges.importers.push(src_pkg)
                pkg_edges.imported.push(tgt_pkg)
            }
            if is_file_loaded(file_path) == 0 {
                load_module(dotted_path, file_path, src_root, all_programs, imp_node, "import")
            }
        }
        let mut target_mod = ""
        if file_path != "" && is_pseudo == 0 {
            // The program's own file is loaded first and its declarations carry "__main__".
            target_mod = if file_path == (loaded_inputs.files.get(0) ?? "") { "__main__" } else { find_module_key(file_path) }
        }
        if target_mod == "" {
            target_mod = dots_to_underscores(dotted_path)
        }
        let names_sl = node_args(imp_node)
        if names_sl == -1 {
            record_module_import(current_import_module, target_mod, -1)
        } else {
            record_module_import(current_import_module, target_mod, imp_node)
        }
        i = i + 1
    }
}

pub fn collect_root_imports(program: Int) {
    root_import_nodes = []
    root_import_modules = []
    root_import_qualifiers = []
    let imports_sl = node_elements(program)
    if imports_sl == -1 {
        return
    }
    let mut i = 0
    while i < sublist_length(imports_sl) {
        let imp_node = sublist_get(imports_sl, i)
        let dotted_path = node_str_val(imp_node)
        root_import_nodes.push(imp_node)
        root_import_modules.push(dotted_path)
        root_import_qualifiers.push(leaf_module_name(dotted_path))
        i = i + 1
    }
}

pub fn resolve_root_import_qualifiers() {
    let mut i = 0
    while i < root_import_modules.len() {
        let dotted_path = root_import_modules.get(i).unwrap()
        let imp_node = root_import_nodes.get(i).unwrap()
        let mangled = dots_to_underscores(dotted_path)
        let mut found = 0
        let mut j = 0
        // First: match by node identity (handles first-time loads)
        while j < import_map_nodes.len() {
            if import_map_nodes.get(j).unwrap() == imp_node && imp_node != -1 {
                root_import_qualifiers.set(i, import_map_qualifiers.get(j).unwrap())
                root_import_modules.set(i, import_map_modules.get(j).unwrap())
                found = 1
                j = import_map_nodes.len()
            } else {
                j = j + 1
            }
        }
        // Fallback: match by mangled module key (handles already-loaded modules)
        if found == 0 {
            j = 0
            while j < import_map_modules.len() {
                if import_map_modules.get(j).unwrap() == mangled {
                    if j < import_map_qualifiers.len() {
                        root_import_qualifiers.set(i, import_map_qualifiers.get(j).unwrap())
                    }
                    root_import_modules.set(i, mangled)
                    found = 1
                    j = import_map_modules.len()
                } else {
                    j = j + 1
                }
            }
        }
        if found == 0 {
            root_import_modules.set(i, mangled)
        }
        i = i + 1
    }
}

pub fn build_reexport_map(imported_programs: List[Int]) {
    let mut pi = 0
    while pi < imported_programs.len() {
        let prog = imported_programs.get(pi).unwrap()
        let reexporter_mod = import_map_modules.get(pi).unwrap()
        let imports_sl = node_elements(prog)
        if imports_sl != -1 {
            let mut ii = 0
            while ii < sublist_length(imports_sl) {
                let imp_node = sublist_get(imports_sl, ii)
                if node_is_pub(imp_node) != 0 {
                    let source_dotted = node_str_val(imp_node)
                    let source_mod = dots_to_underscores(source_dotted)
                    let names_sl = node_args(imp_node)
                    if names_sl == -1 {
                        tc_reexport_source.insert("{reexporter_mod}:*:{source_mod}", source_mod)
                        tc_reexport_modules.insert(reexporter_mod, 1)
                    } else {
                        let mut ni = 0
                        while ni < sublist_length(names_sl) {
                            let name_node = sublist_get(names_sl, ni)
                            let item_name = node_name(name_node)
                            tc_reexport_source.insert("{reexporter_mod}:{item_name}", source_mod)
                            ni = ni + 1
                        }
                        tc_reexport_modules.insert(reexporter_mod, 1)
                    }
                }
                ii = ii + 1
            }
        }
        pi = pi + 1
    }
}

// The modules injected into every program's scope. Single source of truth —
// both inject_prelude and is_prelude_module read it so they can't drift.
//
// Per §10.6 + §03c_protocols.md:762 + decisions/module-prelude.md the prelude
// provides all compiler-known *types, constructors, and traits* (Sized,
// Contains, StrOps/ListOps/MapOps/SetOps/StringBuildOps/BytesOps, From/Into/
// TryFrom, Closeable, BlockHandler, Instant/Duration/ConversionError, …) and
// their builtin-type impls. These modules are loaded so those traits + impls +
// types register and built-in method dispatch resolves without an import.
//
// What §3.2.3 forbids in the prelude is stdlib *free functions* (list_map,
// parse_int, str_trim). Those are filtered out of name-resolution scope by
// nr_check_selective_access (tc_prelude_free_fn) so a bare call without an
// explicit `import` is E0504 — while the traits/types stay visible.
pub fn prelude_module_list() -> List[Str] {
    ["std.num", "std.time", "std.str", "std.sb", "std.bytes", "std.list", "std.map", "std.set", "std.traits", "std.int_conv", "std.char", "std.iter"]
}

// std.io_read holds the bodies of IO.Read's derived operations. Its functions take the
// evidence vector, so a program that loads it compiles them itself; only a handler of IO or
// IO.Read can run them, so a program loads it only when some module writes one.
fn program_writes_io_read_handler() -> Bool {
    let mut i = 0
    while i < node_count() {
        if node_kind(i) == NodeKind.HandlerExpr && handles_io_read(node_name(i)) { return true }
        i = i + 1
    }
    false
}

// std.process holds the default body and the signature of each process.* operation, so a
// program that performs one or writes a Process handler loads it, import or not. Loading it
// does not import it: ProcessError and the free functions stay out of scope without one.
fn program_names_process_handle() -> Bool {
    let mut i = 0
    while i < node_count() {
        let k = node_kind(i)
        if k == NodeKind.HandlerExpr && tc_handler_effect_root(node_name(i)) == "Process" { return true }
        if k == NodeKind.MethodCall {
            let obj = node_obj(i)
            if obj >= 0 && node_kind(obj) == NodeKind.Ident && node_name(obj) == "process" && is_intrinsic_method("process", node_method(i)) != 0 { return true }
        }
        i = i + 1
    }
    false
}

// Accepts either the dotted form ("std.traits") or the mangled module key
// ("std_traits") that tc_symbol_module stores.
pub fn is_prelude_module(mod_name: Str) -> Int {
    let mods = prelude_module_list()
    let mut i = 0
    while i < mods.len() {
        let m = mods.get(i).unwrap()
        if m == mod_name || dots_to_underscores(m) == mod_name { return 1 }
        i = i + 1
    }
    0
}

pub fn inject_prelude(src_root: Str, all_programs: List[Int]) ! Lex.Tokenize, Parse, Diag.Report {
    let prelude_modules = prelude_module_list()
    // Tell the typechecker which modules are prelude modules (underscore form,
    // matching node_module / tc_symbol_module) so it can keep their
    // types/traits/impls visible while filtering their free functions out of
    // name-resolution scope (§3.2.3).
    let mut keys: List[Str] = []
    let mut ki = 0
    while ki < prelude_modules.len() {
        keys.push(dots_to_underscores(prelude_modules.get(ki).unwrap()))
        ki = ki + 1
    }
    // Its free functions stay out of scope like a prelude module's, whether or not it loads.
    keys.push(dots_to_underscores(io_read_module()))
    tc_set_prelude_modules(keys)
    let mut pi = 0
    while pi < prelude_modules.len() {
        let dotted_path = prelude_modules.get(pi).unwrap()
        let file_path = resolve_module_path(dotted_path, src_root)
        // A blink.* pseudo-module resolves to an inert sentinel with no source;
        // never hand it to load_module/read_file. (The prelude list is std.*
        // today, so this is a defensive guard against a future prelude entry.)
        if file_path != "" && !file_path.starts_with("<blink-pseudo:") && is_file_loaded(file_path) == 0 {
            load_module(dotted_path, file_path, src_root, all_programs, -1, "prelude")
        }
        pi = pi + 1
    }
    if program_writes_io_read_handler() {
        let file_path = resolve_module_path(io_read_module(), src_root)
        if file_path != "" && is_file_loaded(file_path) == 0 {
            load_module(io_read_module(), file_path, src_root, all_programs, -1, "prelude")
        }
    }
    if program_names_process_handle() {
        let process_module = builtin_op_module("Process")
        let file_path = resolve_module_path(process_module, src_root)
        if file_path != "" && is_file_loaded(file_path) == 0 {
            load_module(process_module, file_path, src_root, all_programs, -1, "prelude")
        }
    }
}

// A selective import (`import mod.{a, b}`) is redundant rather than dead when
// every listed name is already prelude-visible. Bare `import mod` is
// not covered — node_args is -1 — so a genuinely-unused module still warns.
fn selective_import_all_prelude(imp_node: Int) -> Int {
    let names_sl = node_args(imp_node)
    if names_sl == -1 { return 0 }
    let n = sublist_length(names_sl)
    if n == 0 { return 0 }
    let mut i = 0
    while i < n {
        let name = node_name(sublist_get(names_sl, i))
        if is_prelude_module(tc_get_symbol_module(name)) == 0 { return 0 }
        i = i + 1
    }
    1
}

pub fn check_unused_imports() ! Diag.Report {
    if tc_main_module_has_duplicates() { return }
    let mut ii = 0
    while ii < root_import_modules.len() {
        let mod_key = root_import_modules.get(ii).unwrap()
        let qualifier = root_import_qualifiers.get(ii).unwrap()
        if mod_key == "" && qualifier == "" {
            ii = ii + 1
            continue
        }
        if tc_is_module_used(mod_key) == 0 && tc_is_module_used(qualifier) == 0 {
            let imp_node = root_import_nodes.get(ii).unwrap()
            // blink.* pseudo-modules are OPTIONAL documentation markers (§9.1.1)
            // — the `ffi` namespace and blink.core types are usable
            // without them, so such an import is never "unused" in a way worth
            // warning about.
            let is_pseudo = is_blink_pseudo_module(node_str_val(imp_node))
            if node_is_pub(imp_node) == 0 && selective_import_all_prelude(imp_node) == 0 && is_pseudo == 0 {
                let display_name = if qualifier != "" { qualifier } else { mod_key }
                diag_warn_at("UnusedImport", UNUSED_IMPORT, "module `{display_name}` is imported but not used", imp_node, "remove the unused import")
                diag_set_last_fix("Remove unused import", "")
            }
        }
        ii = ii + 1
    }
}

