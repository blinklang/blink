import symbol_index.{si_build, si_reset, si_sym_count, si_file_count}
import query.{query_dispatch}
import diagnostics.{Diag, diag_count, diag_warn_count, diag_ice_count, diag_render}
import std.json.{json_clear, json_new_object, json_new_bool, json_set, json_new_str, json_new_int, json_encode, json_parse, json_get, json_as_str, json_as_int, json_at, json_len}
import std.path.{path_join, path_dirname}
import lexer.{Lex}
import parser.{Parse, parser_want_interface_text}
import typecheck.{TypeCheck}
import std.libc.{Pollfd, poll, read_bytes}
import check_pipeline.{FrontEndReport, check_source_reporting, checked_inputs_changed, checked_inputs_reset, checked_probes_changed, checked_input_files, check_exit_code, check_status_line}
import build_objcache.{sorted_strs}

effect Daemon {
    effect Serve
}

// daemon.bl — Persistent compiler service with Unix socket IPC
//
// The front end keeps its state in globals, so one process holds one checked program. The
// daemon is a router, which runs no front end, and one worker per entry file, which the router
// forks the first time a client names that entry. The router replies to a check, build or
// query with the name of the entry's worker, and the client sends the request there
// (daemon_send), so the router serves on while a worker checks or builds.
// A worker is a single-threaded event loop: accept connection, read JSON request,
// dispatch (check/build/query/status/stop), respond, check file watcher.
// A check runs check_pipeline.check_source, the check `blink check` runs.
// A build runs in a child the worker forks, which builds from the program the last check
// holds, and the loop serves on while the child runs. Builds of two entries can write the
// same files (one -o, units dir or obj cache), so a worker builds only while it holds the
// router's one build turn.

// ── State ───────────────────────────────────────────────────────────

let mut daemon_running: Int = 0
let mut daemon_socket_fd: Int = -1
let mut daemon_pid_path: Str = ""
let mut daemon_sock_path: Str = ""
let mut daemon_source_path: Str = ""
let mut daemon_start_time: Int = 0
let mut daemon_check_count: Int = 0
// A diagnostic spells its file as the entry path was typed, relative to the working
// directory, so a worker checks in the client's directory with the client's spelling, and
// checks again when either differs from its last check's. A build also reads the compiler
// binary, the environment and the settings the front end reads, so the daemon builds only
// for a client whose identity and settings are its own.
type DaemonOrigin {
    cwd: Str
    identity: Str
    settings: Str
    // Whether its checks parse for the interface texts a build that may take units compares.
    interface_text: Bool
    builds: Int
    // In a worker: the router's pid, and the directory, absolute since the worker changes its
    // working directory, that holds the worker's socket and the files its checks and builds
    // print to. In the router, 0 and "".
    router: Int
    files: Str
    // In a worker: its end of the connection the router opened to it before the fork, on which
    // it asks for the build turn and gives it back. The worker never reads from it, so the
    // router, which asks a worker for its status and waits for the reply, never waits on a
    // worker that waits on the router. In the router, -1.
    chan: Int
}

let mut daemon_origin: DaemonOrigin = DaemonOrigin { cwd: "", identity: "", settings: "", interface_text: false, builds: 0, router: 0, files: "", chan: -1 }

// The findings of a check, rendered both ways a client can ask for, since the diagnostics
// themselves do not outlive the next check.
type DaemonCheck {
    human: Str
    json: Str
    errors: Int
    warnings: Int
    ices: Int
    // The program the check left, which a build compiles, and what the build prints first.
    program: Int
    front: FrontEndReport
    // What the check printed itself, apart from its diagnostics, such as the loader's note on
    // a local module that shadows a dependency; captured false when the daemon could not
    // capture it, so a build would print less than a cold one.
    out: Str
    err: Str
    captured: Bool
    // The mtime and size of each file the check read, from just after it. The poll compares
    // bytes only once one of them moves. Empty when an edit landed during the check.
    stats: List[Int]
}

// The last check, which holds until an input changes.
let mut daemon_last: Option[DaemonCheck] = None

// A build child the daemon forked and has not reaped, and what it owes the client: the files
// the child prints to and the connection the reply goes to.
type DaemonChild {
    pid: Int
    client_fd: Int
    out: Str
    err: Str
    declined: Str
}

// A request the daemon holds until its build child ends, with the connection it came on.
type DaemonHeld {
    request: Str
    client_fd: Int
}

// What the loop holds about builds. child is the one it forked and has not reaped. Two builds
// can write the same units dir and program, and a client sent to build cold would write them
// beside the child, so a build waits in queue, oldest first, until the worker holds the
// router's build turn and has no child. turn is 0 while the worker neither holds nor asked for
// it, 1 once it asked, 2 while it holds it. A turn runs one build, so the entries take turns.
// stops came while a child ran; the daemon answers them and ends once the child does. seq
// numbers each build's files, so no reply reads another build's output.
type DaemonBuilds {
    child: Option[DaemonChild]
    queue: List[DaemonHeld]
    stops: List[Int]
    seq: Int
    turn: Int
}

// ── Extract request type ────────────────────────────────────────────

fn daemon_extract_type(request: Str) -> Option[Str] {
    json_clear()
    let root = json_parse(request)
    if root < 0 {
        return None
    }
    Some(json_as_str(json_get(root, "type")))
}

// ── Handle: check ───────────────────────────────────────────────────

// Each check sees the whole program: mono and the mutation passes judge across functions,
// so a recheck of only the changed functions could miss what an edit broke elsewhere.
fn daemon_check_program() -> DaemonCheck ! IO, Lex.Tokenize, Parse, Parse.Build, TypeCheck, Diag.Report {
    let out_path = path_join(daemon_origin.files, "check.out")
    let err_path = path_join(daemon_origin.files, "check.err")
    let saved = capture_output(out_path, err_path)
    parser_want_interface_text(daemon_origin.interface_text)
    let (program, front) = check_source_reporting(daemon_source_path)
    parser_want_interface_text(false)
    let captured = restore_output(saved)
    let out = if captured { read_file(out_path) } else { "" }
    let err = if captured { read_file(err_path) } else { "" }
    // An edit after the loader read a file and before this stat leaves no stat change for a
    // poll to see. The bytes show it, so one compare here closes that gap.
    let taken = daemon_input_stats()
    let stats = if checked_inputs_changed(daemon_source_path) { [] } else { taken }
    si_reset()
    si_build(program, daemon_source_path, "main")
    // Each check leaves its whole working set as garbage. Whether libgc collects it or grows
    // the heap instead is not stable: it turns on how much the last collections freed, so
    // the same edit can leave a small heap or a large one. Every build child is a fork of
    // this heap, and pays for the garbage it carries, so the worker forces the collection
    // here, where the check is all that stays live, and each fork is as small as the
    // program it builds.
    daemon_gc_collect()
    DaemonCheck {
        human: diag_render(0),
        json: diag_render(1),
        errors: diag_count,
        warnings: diag_warn_count,
        ices: diag_ice_count,
        program: program,
        front: front,
        out: out,
        err: err,
        captured: captured,
        stats: stats,
    }
}

// The mtime and size of each file the last check read, -1 for one it can not stat or open.
// A same-size edit inside one mtime tick, or one whose mtime was set back, leaves these as
// they were, so they only tell the poll when to compare bytes. A build compares bytes itself.
fn daemon_input_stats() -> List[Int] ! IO {
    let mut stats: List[Int] = []
    for p in checked_input_files() {
        stats.push(file_mtime(p))
        stats.push(daemon_file_size(p))
    }
    stats
}

fn daemon_file_size(path: Str) -> Int ! IO {
    let mut size = -1
    with ffi.scope() as scope {
        let file = daemon_open(scope.cstr(path), 0.to_i32()).to_int()
        if file >= 0 {
            size = daemon_lseek(file.to_i32(), 0, 2.to_i32())
            unix_socket_close(file)
        }
    }
    size
}

// ── Access ──────────────────────────────────────────────────────────

// A client sends the daemon the environment it runs under, and the daemon builds and runs
// what a client asks, so each daemon directory and socket is its user's alone, whatever the
// umask. An existing directory is closed too, as an older daemon may have made it open to
// its group. Only the daemon uses .blink/, so closing it takes nothing from anyone. False
// when the directory is not the user's to close.
fn daemon_private_dir(path: Str) -> Bool ! IO {
    let mut ok = false
    with ffi.scope() as scope {
        let p = scope.cstr(path)
        // 448 is 0700. An existing directory makes mkdir fail; the chmod decides.
        let _ = daemon_mkdir(p, 448.to_u32())
        ok = daemon_chmod(p, 448.to_u32()).to_int() == 0
    }
    ok
}

// A socket listening at path that only its user may connect to: 384 is 0600. The directory
// it is in is closed already; this closes the socket where a directory can not be.
fn daemon_listen_private(path: Str) -> Int ! IO {
    let fd = unix_socket_listen(path)
    if fd < 0 { return fd }
    let mut ok = false
    with ffi.scope() as scope {
        ok = daemon_chmod(scope.cstr(path), 384.to_u32()).to_int() == 0
    }
    if !ok {
        unix_socket_close(fd)
        return -1
    }
    fd
}

// Whether SOL_SOCKET is 1 and SO_PEERCRED is 17 here. The FFI can not read a C macro, and the
// values differ by arch: SO_PEERCRED is 21 on powerpc and 18 on mips. They were checked
// against the C headers for x86_64 and aarch64 Linux. The arch is the one this binary is built
// for, from its ELF header, which /proc/self/exe holds on every Linux; a 32-bit build on a
// 64-bit kernel has its own. It is read on each ask, an open and a read of 20 bytes, and not
// kept in a module-level `let mut`, as scripts/ratchet.sh holds their count from going up.
fn daemon_peer_check_supported() -> Bool ! IO {
    let mut file = -1
    with ffi.scope() as scope {
        file = daemon_open(scope.cstr("/proc/self/exe"), 0.to_i32()).to_int()
    }
    if file < 0 { return false }
    let mut known = false
    match read_bytes(file, 20) {
        Ok(h) => {
            // "\x7fELF", 64-bit, little-endian, then e_machine at 18: 62 is x86_64, 183 aarch64.
            if h.len() == 20 && h.get(0).unwrap() == 127 && h.get(1).unwrap() == 69 && h.get(2).unwrap() == 76 && h.get(3).unwrap() == 70 && h.get(4).unwrap() == 2 && h.get(5).unwrap() == 1 {
                let machine = h.get(18).unwrap() + h.get(19).unwrap() * 256
                known = machine == 62 || machine == 183
            }
        }
        Err(_) => {}
    }
    unix_socket_close(file)
    known
}

// The uid of the process at the other end of a Unix socket, or None where the peer check is
// not supported or the kernel did not say. struct ucred is pid, uid and gid, 4 bytes each, on
// every Linux; the length the kernel gives back is checked all the same. The uid is read
// little-endian, as the check is supported only on little-endian arches.
pub fn daemon_peer_uid(fd: Int) -> Option[Int] ! IO {
    if !daemon_peer_check_supported() { return None }
    let cred = Bytes.zeroed(12)
    let mut rc = -1
    let mut len = 0
    with ffi.scope() as scope {
        let len_cell = scope.alloc[U32]()
        len_cell.write(12.to_u32())
        rc = cred.with_ptr(fn(p) -> I32 { daemon_getsockopt(fd.to_i32(), 1.to_i32(), 17.to_i32(), p, len_cell) }).to_int()
        len = len_cell.deref().to_int()
    }
    if rc != 0 || len != 12 { return None }
    Some(cred.get(4).unwrap() + cred.get(5).unwrap() * 256 + cred.get(6).unwrap() * 65536 + cred.get(7).unwrap() * 16777216)
}

pub fn daemon_own_uid() -> Int {
    daemon_getuid().to_int()
}

// Whether the daemon may serve a connection: one from its own user, or any where the peer
// check is not supported, as there only the closed directory keeps others out.
fn daemon_peer_allowed(fd: Int) -> Bool ! IO {
    if !daemon_peer_check_supported() { return true }
    match daemon_peer_uid(fd) {
        Some(uid) => uid == daemon_own_uid()
        None => false
    }
}

// A connection accepted on fd within timeout_ms that the daemon may serve, or -1. Another
// user's connection is closed unread.
fn daemon_accept_own(fd: Int, timeout_ms: Int) -> Int ! IO {
    let client_fd = unix_socket_accept_timeout(fd, timeout_ms)
    if client_fd >= 0 && !daemon_peer_allowed(client_fd) {
        unix_socket_close(client_fd)
        return -1
    }
    client_fd
}

// The compiler this process runs and the environment it runs under, as /proc names them, for
// the daemon to compare with its own; None where /proc can not say, or where the peer check is
// not supported, and the caller hashes them in a shell instead. It starts no process, as a
// client pays for each one on every build.
//
// The compiler is the device and inode its image is mapped from, with the size and mtime of
// that inode. The device and inode alone tell a changed compiler only because the kernel
// refuses a write to a file a process runs (ETXTBSY): the daemon runs its compiler for as long
// as it lives, so a rebuild or a copy reaches the daemon's path only as another inode,
// whatever its size and mtime, and the kernel gives that inode number to no other file while
// the daemon holds it. The size and mtime are kept for a file system that does not refuse the
// write.
//
// The environment goes whole, not hashed, as the runtime has no hash safe from collisions. It
// goes only where the peer check is supported, as the client then sends it to no other user's
// daemon (daemon_send), and the daemon only compares it. Each variable is one record after its
// length, so no value can stand for two variables, and the records are sorted, as a shell
// lists them in an order that changes as it sets them. /proc holds the environment the process
// started with; nothing before this call changes it.
pub fn daemon_proc_identity(compiler: Str) -> Option[Str] ! IO {
    if !daemon_peer_check_supported() { return None }
    let image = match daemon_mapped_image(compiler) {
        Some(s) => s
        None => return None
    }
    let environ = match daemon_read_all("/proc/self/environ") {
        Some(b) => b
        None => return None
    }
    let mut vars: List[Str] = []
    let n = environ.len()
    let mut start = 0
    let mut i = 0
    while i <= n {
        if i == n || environ.get(i).unwrap() == 0 {
            if i > start {
                match environ.slice(start, i).to_str() {
                    Ok(v) => {
                        if !daemon_shell_own_var(v) { vars.push(v) }
                    }
                    Err(_) => return None
                }
            }
            start = i + 1
        }
        i = i + 1
    }
    let mut sb = StringBuilder.new()
    sb.write("{image} {daemon_file_size("/proc/self/exe")} {file_mtime("/proc/self/exe")}\n")
    for v in sorted_strs(vars) {
        sb.write("{v.byte_len()}\n{v}\n")
    }
    Some(sb.to_str())
}

// A shell keeps these for itself, as the command it ran, how deep it runs and the directory it
// was in, so two shells differ in them, and a build reads none of them. PWD differs in each
// directory of a project; a build request carries it, and the daemon's build sets it.
fn daemon_shell_own_var(v: Str) -> Bool {
    v.starts_with("_=") || v.starts_with("SHLVL=") || v.starts_with("OLDPWD=") || v.starts_with("PWD=")
}

// "<dev> <inode>" of the file mapped at offset 0 from path, from /proc/self/maps.
fn daemon_mapped_image(path: Str) -> Option[Str] ! IO {
    let maps = match daemon_read_all("/proc/self/maps") {
        Some(b) => b
        None => return None
    }
    let text = match maps.to_str() {
        Ok(t) => t
        Err(_) => return None
    }
    // Each line is "<address> <perms> <offset> <dev> <inode>", then spaces and the path, which
    // may itself hold a space.
    for line in text.lines() {
        let mut fields: List[Str] = []
        let mut rest = line
        while fields.len() < 5 {
            rest = rest.trim_left()
            match rest.byte_index_of(" ", 0) {
                Some(at) => {
                    fields.push(rest.byte_slice(0, at))
                    rest = rest.byte_slice(at + 1, rest.byte_len())
                }
                None => break
            }
        }
        if fields.len() == 5 && fields.get(2).unwrap() == "00000000" && rest.trim_left() == path {
            return Some("{fields.get(3).unwrap()} {fields.get(4).unwrap()}")
        }
    }
    None
}

// The whole of a file whose size stat does not give, as for a file under /proc.
fn daemon_read_all(path: Str) -> Option[Bytes] ! IO {
    let mut file = -1
    with ffi.scope() as scope {
        file = daemon_open(scope.cstr(path), 0.to_i32()).to_int()
    }
    if file < 0 {
        return None
    }
    let mut all = Bytes.new()
    loop {
        match read_bytes(file, 65536) {
            Ok(b) => {
                if b.len() == 0 { break }
                all = all.concat(b)
            }
            Err(_) => {
                unix_socket_close(file)
                return None
            }
        }
    }
    unix_socket_close(file)
    Some(all)
}

fn daemon_not_served(why: Str) -> Str {
    json_clear()
    let reply = json_new_object()
    json_set(reply, "ok", json_new_bool(0))
    json_set(reply, "served", json_new_int(0))
    json_set(reply, "error", json_new_str(why))
    json_encode(reply)
}

// Makes cwd and path the worker's working directory and entry spelling, so its next check
// reads and prints as a cold check in the client would. The router sends a worker only the
// spellings of its one entry file, but the check does not trust that: a new spelling drops
// the last check. False when the worker can not change to cwd.
fn daemon_enter(cwd: Str, path: Str) -> Bool ! IO {
    if cwd == daemon_origin.cwd && path == daemon_source_path {
        return true
    }
    let mut ok = false
    with ffi.scope() as scope {
        ok = daemon_chdir(scope.cstr(cwd)).to_int() == 0
    }
    if !ok {
        return false
    }
    daemon_origin = DaemonOrigin { cwd: cwd, ..daemon_origin }
    daemon_source_path = path
    daemon_last = None
    true
}

// The reply carries what a cold `blink check` would print on stdout and stderr and the code
// it would exit with, so the client prints the bytes and needs no rendering of its own.
// With no input changed, the last answer still holds, so the daemon gives it again rather
// than an empty list that would read as clean.
fn daemon_handle_check(request: Str) -> Str ! Daemon.Serve, IO, Lex.Tokenize, Parse, Parse.Build, TypeCheck, Diag.Report {
    json_clear()
    let root = json_parse(request)
    let cwd = json_as_str(json_get(root, "cwd"))
    let path = json_as_str(json_get(root, "path"))
    let json_status = json_as_int(json_get(root, "json"))
    let diag_json = json_as_int(json_get(root, "diag_json"))
    let strict = json_as_int(json_get(root, "strict"))
    if !daemon_enter(cwd, path) {
        return daemon_not_served("the daemon could not change to {cwd}")
    }
    // The loader exits on a missing entry file, which would take the daemon down with it.
    if file_exists(daemon_source_path) != 1 {
        daemon_last = None
        return daemon_not_served("source file not found: {daemon_source_path}")
    }
    daemon_check_count = daemon_check_count + 1
    let mut changed = 0
    if daemon_last.is_none() || checked_inputs_changed(daemon_source_path) {
        daemon_last = Some(daemon_check_program())
        changed = 1
    }
    let c = daemon_last.unwrap()
    let status = check_status_line(daemon_source_path, json_status, strict, c.ices, c.errors, c.warnings)
    json_clear()
    let reply = json_new_object()
    json_set(reply, "ok", json_new_bool(1))
    json_set(reply, "served", json_new_int(1))
    json_set(reply, "changed", json_new_int(changed))
    json_set(reply, "exit", json_new_int(check_exit_code(strict, c.ices, c.errors, c.warnings)))
    json_set(reply, "stdout", json_new_str(status.concat("\n")))
    json_set(reply, "stderr", json_new_str(if diag_json == 1 { c.json } else { c.human }))
    json_encode(reply)
}

// ── Handle: build ───────────────────────────────────────────────────

// An @ffi function's C name has no module part, so these carry the module in their own names,
// apart from std.libc's bindings over the same calls.
@ffi("fork", header: "unistd.h")
@trusted(audit: "Wraps fork(2). A GC with parallel marking (the system libgc) takes its locks across the fork through its fork handlers and resets them in the child; the vendored GC has no parallel marking.")
fn daemon_fork() -> I32 ! FFI {}

// The GC's marker threads do not live through a fork, and the GC turns off its parallel
// marking in the child; a worker lives as long as the daemon and rechecks on each edit, so it
// starts them again.
@ffi("GC_start_mark_threads")
@trusted(audit: "Wraps GC_start_mark_threads from the GC the runtime links. It takes no argument, and is a no-op in a GC built without parallel marking, as the vendored one is.")
fn daemon_gc_start_markers() ! FFI {}

@ffi("GC_gcollect")
@trusted(audit: "Wraps GC_gcollect from the GC the runtime links. It takes no argument and returns nothing; the worker calls it from its one thread, between requests.")
fn daemon_gc_collect() ! FFI {}

@ffi("waitpid", header: "sys/wait.h")
@trusted(audit: "Wraps waitpid(2). status is one I32 cell from ffi.scope(); options is fixed to WNOHANG, 1 on every host.")
fn daemon_waitpid(pid: I32, status: Ptr[I32], options: I32) -> I32 ! FFI {}

@ffi("open", header: "fcntl.h")
@trusted(audit: "Wraps open(2) with no mode. path is a NUL-terminated copy from ffi.scope(); flags is O_RDONLY or O_WRONLY, 0 and 1 on every host.")
fn daemon_open(path: Ptr[U8], flags: I32) -> I32 ! FFI {}

@ffi("mkdir", header: "sys/stat.h")
@trusted(audit: "Wraps mkdir(2). path is a NUL-terminated copy from ffi.scope(); mode is 0700.")
fn daemon_mkdir(path: Ptr[U8], mode: U32) -> I32 ! FFI {}

@ffi("chmod", header: "sys/stat.h")
@trusted(audit: "Wraps chmod(2). path is a NUL-terminated copy from ffi.scope(); mode is 0700 or 0600.")
fn daemon_chmod(path: Ptr[U8], mode: U32) -> I32 ! FFI {}

@ffi("getsockopt", header: "sys/socket.h")
@trusted(audit: "Wraps getsockopt(2) for SO_PEERCRED only, on an arch whose SOL_SOCKET and SO_PEERCRED values were checked. value is a 12-byte Bytes buffer pinned by with_ptr, the size of struct ucred; len is one U32 cell that holds 12.")
fn daemon_getsockopt(fd: I32, level: I32, name: I32, value: Ptr[U8], len: Ptr[U32]) -> I32 ! FFI {}

@ffi("getuid", header: "unistd.h")
@trusted(audit: "Wraps getuid(2). It takes nothing and can not fail.")
fn daemon_getuid() -> U32 ! FFI {}

@ffi("lseek", header: "unistd.h")
@trusted(audit: "Wraps lseek(2). fd is one daemon_open returned; whence is fixed to SEEK_END, 2 on every host.")
fn daemon_lseek(fd: I32, offset: Int, whence: I32) -> Int ! FFI {}

@ffi("dup", header: "unistd.h")
@trusted(audit: "Wraps dup(2). fd is 1 or 2, which the daemon holds open.")
fn daemon_dup(fd: I32) -> I32 ! FFI {}

@ffi("dup2", header: "unistd.h")
@trusted(audit: "Wraps dup2(2). Both descriptors are the process's own: one open or dup returned, and 1 or 2.")
fn daemon_dup2(old_fd: I32, new_fd: I32) -> I32 ! FFI {}

@ffi("setpgid", header: "unistd.h")
@trusted(audit: "Wraps setpgid(2). The router passes the pid of a worker it just forked as both pid and group; the worker passes 0 and 0. It takes and returns ints.")
fn daemon_setpgid(pid: I32, pgid: I32) -> I32 ! FFI {}

@ffi("kill", header: "signal.h")
@trusted(audit: "Wraps kill(2). The router sends only to the process group of a worker it forked: SIGKILL while the worker is not yet reaped, so its pid still names that group, and then signal 0, which sends nothing.")
fn daemon_kill(pid: I32, sig: I32) -> I32 ! FFI {}

@ffi("blink_errno_get")
@trusted(audit: "Wraps the runtime blink_errno_get(), which returns errno. Read right after a failed waitpid.")
fn daemon_errno() -> Int ! FFI {}

@ffi("chdir", header: "unistd.h")
@trusted(audit: "Wraps chdir(2). path is a NUL-terminated copy from ffi.scope(), the working directory a client sent.")
fn daemon_chdir(path: Ptr[U8]) -> I32 ! FFI {}

@ffi("realpath", header: "stdlib.h")
@trusted(audit: "Wraps realpath(3). path is a NUL-terminated copy from ffi.scope(); resolved is a 4096-byte buffer from ffi.scope(), PATH_MAX or more on every host, which realpath fills on success.")
fn daemon_realpath(path: Ptr[U8], resolved: Ptr[U8]) -> Ptr[U8] ! FFI {}

@ffi("getppid", header: "unistd.h")
@trusted(audit: "Wraps getppid(2), which takes nothing and can not fail.")
fn daemon_getppid() -> I32 ! FFI {}

// What the child the daemon forked for a build runs: the client's command line, from the
// program the daemon checked last. declined names the file the child makes when the build
// needs a step a cold build takes first, such as a rebuilt stdlib archive, which the child can
// not take with the program already loaded; the client then builds cold.
pub type DaemonBuild {
    argv: List[Str]
    program: Int
    front: FrontEndReport
    out: Str
    err: Str
    declined: Str
}

// What a build request leaves the daemon's loop with: the reply to send, nothing yet while the
// child it forked runs, or, in that child, the build to run.
type BuildTurn {
    Reply(text: Str)
    Started(child: DaemonChild)
    Child(build: DaemonBuild)
}

// Points fd at an empty file at path, or false when it cannot. write_file makes the file, so
// open needs only O_WRONLY, which is 1 on every host, where O_CREAT and O_TRUNC differ.
fn redirect_to(path: Str, fd: Int) -> Bool ! IO {
    write_file(path, "")
    let mut ok = false
    with ffi.scope() as scope {
        let file = daemon_open(scope.cstr(path), 1.to_i32()).to_int()
        if file >= 0 {
            ok = daemon_dup2(file.to_i32(), fd.to_i32()).to_int() == fd
            if file != fd { unix_socket_close(file) }
        }
    }
    ok
}

// Points stdout and stderr at the files at out_path and err_path; the descriptors they had,
// for restore_output, or -1 for one it could not save.
fn capture_output(out_path: Str, err_path: Str) -> (Int, Int) ! IO {
    // What stdout holds unflushed belongs to the daemon's own output, not to the capture.
    io.write("")
    let saved_out = daemon_dup(1.to_i32()).to_int()
    let saved_err = daemon_dup(2.to_i32()).to_int()
    if saved_out < 0 || saved_err < 0 {
        return (saved_out, saved_err)
    }
    if !redirect_to(out_path, 1) || !redirect_to(err_path, 2) {
        return (-1, saved_err)
    }
    (saved_out, saved_err)
}

// Points stdout and stderr back where capture_output found them; whether both files hold
// all that was printed between the two calls.
fn restore_output(saved: (Int, Int)) -> Bool ! IO {
    io.write("")
    let (saved_out, saved_err) = saved
    let mut ok = saved_out >= 0 && saved_err >= 0
    if saved_out >= 0 {
        ok = daemon_dup2(saved_out.to_i32(), 1.to_i32()).to_int() == 1 && ok
        unix_socket_close(saved_out)
    }
    if saved_err >= 0 {
        ok = daemon_dup2(saved_err.to_i32(), 2.to_i32()).to_int() == 2 && ok
        unix_socket_close(saved_err)
    }
    ok
}

// The code the shell would report for a child that ended with status: its exit code, or 128
// plus the signal that killed it.
fn exit_code_of(status: Int) -> Int {
    let sig = status & 127
    if sig == 0 { (status >> 8) & 255 } else { 128 + sig }
}

// Reaps pid if it ended: the status it ended with, -1 when there is no such child, or -2
// while it runs.
fn reap(pid: Int) -> Int ! IO {
    let mut status = -1
    // WNOHANG is 1 on every host the daemon runs on.
    let options = 1
    with ffi.scope() as scope {
        let cell = scope.alloc[I32]()
        loop {
            let r = daemon_waitpid(pid.to_i32(), cell, options.to_i32()).to_int()
            if r == pid {
                status = cell.deref().to_int()
                break
            }
            if r == 0 {
                status = -2
                break
            }
            // EINTR is 4 on every host the daemon runs on.
            if r > 0 || daemon_errno() != 4 { break }
        }
    }
    status
}

// Sends text and closes the connection. A client that went away takes only its own
// connection with it; the daemon serves on.
fn daemon_reply(client_fd: Int, text: Str) {
    if socket_write(client_fd, text.concat("\n")) < 0 {
        io.eprintln("daemon: could not send the reply, so it dropped the connection")
    }
    unix_socket_close(client_fd)
}

// A build runs the client's command line in a child of the daemon, from the program the
// daemon's last check left, rechecked first when an input changed, so it skips the front end
// a cold build runs. The child's stdout and stderr go to files that the reply carries, with
// the code the child exited with, so the client prints what a cold build would print and
// exits with its code. The daemon builds only where a cold build in the client would read
// the same: the same compiler, environment and front-end settings. The child builds in the
// client's directory with the client's PWD, which the identity leaves out, as each directory
// of a project has its own. Anything else is not served, and the client builds cold. The daemon serves on while the child runs
// and replies to the client once the child ends (daemon_end_child).
fn daemon_handle_build(request: Str, client_fd: Int, builds: DaemonBuilds) -> BuildTurn ! Daemon.Serve, IO, Lex.Tokenize, Parse, Parse.Build, TypeCheck, Diag.Report {
    json_clear()
    let root = json_parse(request)
    let cwd = json_as_str(json_get(root, "cwd"))
    let path = json_as_str(json_get(root, "path"))
    let identity = json_as_str(json_get(root, "identity"))
    let settings = json_as_str(json_get(root, "settings"))
    let pwd = json_as_str(json_get(root, "pwd"))
    let pwd_set = json_as_int(json_get(root, "pwd_set")) == 1
    let argv_node = json_get(root, "argv")
    let mut argv: List[Str] = []
    let mut i = 0
    while i < json_len(argv_node) {
        argv.push(json_as_str(json_at(argv_node, i)))
        i = i + 1
    }
    if identity != daemon_origin.identity || argv.len() < 2 {
        return BuildTurn.Reply(daemon_not_served("the client runs another compiler or environment than the daemon"))
    }
    if settings != daemon_origin.settings {
        return BuildTurn.Reply(daemon_not_served("the client sets what the front end reads otherwise than the daemon"))
    }
    if !daemon_enter(cwd, path) {
        return BuildTurn.Reply(daemon_not_served("the daemon could not change to {cwd}"))
    }
    // The loader exits on a missing entry file, which would take the daemon down with it.
    if file_exists(daemon_source_path) != 1 {
        daemon_last = None
        return BuildTurn.Reply(daemon_not_served("source file not found: {daemon_source_path}"))
    }
    if daemon_last.is_none() || checked_inputs_changed(daemon_source_path) {
        daemon_last = Some(daemon_check_program())
    }
    let c = daemon_last.unwrap()
    if !c.captured {
        return BuildTurn.Reply(daemon_not_served("the daemon could not capture what its check printed"))
    }
    let out_path = path_join(daemon_origin.files, "build-{builds.seq}.out")
    let err_path = path_join(daemon_origin.files, "build-{builds.seq}.err")
    let declined = path_join(daemon_origin.files, "build-{builds.seq}.declined")
    shell_exec("rm -f {declined}")
    // The child inherits what stdout holds unflushed, and would print it again.
    io.write("")
    let pid = daemon_fork().to_int()
    if pid < 0 {
        return BuildTurn.Reply(daemon_not_served("the daemon could not fork a build"))
    }
    if pid == 0 {
        // The child keeps no socket, so each client hears from the daemon alone, and a stop
        // that removes the socket file is the daemon's.
        unix_socket_close(client_fd)
        for h in builds.queue {
            unix_socket_close(h.client_fd)
        }
        for s in builds.stops {
            unix_socket_close(s)
        }
        unix_socket_close(daemon_socket_fd)
        daemon_socket_fd = -1
        if daemon_origin.chan >= 0 { unix_socket_close(daemon_origin.chan) }
        daemon_origin = DaemonOrigin { chan: -1, ..daemon_origin }
        daemon_running = 0
        if !redirect_to(out_path, 1) || !redirect_to(err_path, 2) {
            write_file(declined, "")
            exit(1)
        }
        if pwd_set { env.set_var("PWD", pwd) } else { env.remove_var("PWD") }
        return BuildTurn.Child(DaemonBuild { argv: argv, program: c.program, front: c.front, out: c.out, err: c.err, declined: declined })
    }
    BuildTurn.Started(DaemonChild { pid: pid, client_fd: client_fd, out: out_path, err: err_path, declined: declined })
}

// Replies to the client of the build child that ended with status, and removes the child's
// files, whether it built, declined or died.
fn daemon_end_child(child: DaemonChild, status: Int) ! IO {
    let out = read_file(child.out)
    let err = read_file(child.err)
    let declined = file_exists(child.declined) == 1
    shell_exec("rm -f {child.out} {child.err} {child.declined}")
    if status < 0 || declined {
        daemon_reply(child.client_fd, daemon_not_served("the daemon's build did not run"))
        return
    }
    daemon_origin = DaemonOrigin { builds: daemon_origin.builds + 1, ..daemon_origin }
    json_clear()
    let reply = json_new_object()
    json_set(reply, "ok", json_new_bool(1))
    json_set(reply, "served", json_new_int(1))
    json_set(reply, "exit", json_new_int(exit_code_of(status)))
    json_set(reply, "stdout", json_new_str(out))
    json_set(reply, "stderr", json_new_str(err))
    daemon_reply(child.client_fd, json_encode(reply))
}

// Runs a build request with the next number for its files, and leaves a child it forked in
// builds. Returns the reply to send, or in the child the build to run.
fn daemon_start_build(builds: DaemonBuilds, request: Str, client_fd: Int) -> (DaemonBuilds, Option[Str], Option[DaemonBuild]) ! Daemon.Serve, IO, Lex.Tokenize, Parse, Parse.Build, TypeCheck, Diag.Report {
    let mut next = DaemonBuilds { seq: builds.seq + 1, ..builds }
    match daemon_handle_build(request, client_fd, next) {
        Reply(text) => (next, Some(text), None)
        Started(child) => {
            next.child = Some(child)
            (next, None, None)
        }
        Child(build) => (next, None, Some(build))
    }
}

// Sends the router one line on the worker's connection to it. False once the router is gone.
fn daemon_tell_router(text: Str) -> Bool {
    daemon_origin.chan >= 0 && socket_write(daemon_origin.chan, text.concat("\n")) >= 0
}

// Sends each held build to build cold, with why.
fn daemon_send_cold(builds: DaemonBuilds, why: Str) -> DaemonBuilds {
    for h in builds.queue {
        daemon_reply(h.client_fd, daemon_not_served(why))
    }
    DaemonBuilds { queue: [], ..builds }
}

// Asks the router for the build turn for the held builds, unless the worker holds it, has
// asked, or has a child whose end gives it back.
fn daemon_ask_turn(builds: DaemonBuilds) -> DaemonBuilds {
    if builds.turn != 0 || builds.child.is_some() || builds.queue.len() == 0 {
        return builds
    }
    if !daemon_tell_router("\{\"type\":\"turn\"}") {
        return daemon_send_cold(builds, "the daemon could not ask its router for the build turn")
    }
    DaemonBuilds { turn: 1, ..builds }
}

// Gives the turn back, and asks again when builds still wait.
fn daemon_end_turn(builds: DaemonBuilds) -> DaemonBuilds {
    let more = if builds.queue.len() > 0 { 1 } else { 0 }
    if !daemon_tell_router("\{\"type\":\"done\",\"more\":{more}}") {
        return daemon_send_cold(DaemonBuilds { turn: 0, ..builds }, "the daemon could not ask its router for the build turn")
    }
    DaemonBuilds { turn: more, ..builds }
}

// The router gave the worker the turn: the oldest held build runs. A build the worker answers
// at once does not hold the turn, so the next one runs, and the turn goes back once none is
// left. Returns the build to run in a child forked for one.
fn daemon_take_turn(builds: DaemonBuilds) -> (DaemonBuilds, Option[DaemonBuild]) ! Daemon.Serve, IO, Lex.Tokenize, Parse, Parse.Build, TypeCheck, Diag.Report {
    let mut b = DaemonBuilds { turn: 2, ..builds }
    while b.child.is_none() && b.queue.len() > 0 {
        let h = b.queue.get(0).unwrap()
        b.queue = b.queue.slice(1, b.queue.len())
        let (next, reply, build) = daemon_start_build(b, h.request, h.client_fd)
        b = next
        if build.is_some() {
            return (b, build)
        }
        match reply {
            Some(text) => daemon_reply(h.client_fd, text)
            None => {}
        }
    }
    if b.child.is_none() {
        b = daemon_end_turn(b)
    }
    (b, None)
}

// Once the build child ends: a stop that came meanwhile sends each held build to build cold,
// now that nothing else writes its files, answers the stop and ends the loop; else the turn
// goes back to the router, which gives it to the entry that asked first.
fn daemon_after_child(builds: DaemonBuilds) -> DaemonBuilds {
    let mut b = builds
    if b.stops.len() > 0 {
        b = daemon_send_cold(b, "the daemon is stopping")
        for s in b.stops {
            let text = daemon_handle_stop()
            // -1 stands for the router, which ended without asking.
            if s >= 0 { daemon_reply(s, text) }
        }
        let _ = daemon_tell_router("\{\"type\":\"done\",\"more\":0}")
        return DaemonBuilds { stops: [], turn: 0, ..b }
    }
    daemon_end_turn(b)
}

// ── Handle: query ───────────────────────────────────────────────────

fn daemon_handle_query(request: Str) -> Str {
    query_dispatch(request)
}

// ── Handle: status ──────────────────────────────────────────────────

fn daemon_handle_status(builds: DaemonBuilds) -> Str {
    let now = time_ms()
    let uptime = now - daemon_start_time
    let sym_count = si_sym_count
    let file_count = si_file_count
    let checks = daemon_check_count
    let served = daemon_origin.builds
    let building = if builds.child.is_some() { 1 } else { 0 }
    let queued = builds.queue.len()
    let stopping = if builds.stops.len() > 0 { 1 } else { 0 }
    "\{\"ok\":true,\"uptime_ms\":{uptime},\"symbols\":{sym_count},\"files\":{file_count},\"building\":{building},\"queued\":{queued},\"stopping\":{stopping},\"builds\":{served},\"checks\":{checks}}"
}

// ── Handle: stop ────────────────────────────────────────────────────

// The counts go to the router, which adds them to its status once this worker is gone.
fn daemon_handle_stop() -> Str {
    daemon_running = 0
    "\{\"ok\":true,\"message\":\"daemon stopping\",\"builds\":{daemon_origin.builds},\"checks\":{daemon_check_count}}"
}

// ── Event loop ──────────────────────────────────────────────────────

// While no client asks, the daemon rechecks a program whose inputs changed, so the build or
// check after an edit finds the check done. Each time the accept waits out, an unchanged
// program costs a stat of each input and each probed path; only a moved stat or probe costs
// a byte compare. A missed edit costs a recheck at the next request, never a stale answer:
// a check or build compares bytes before it uses the last check.
fn daemon_recheck_if_changed() ! IO, Lex.Tokenize, Parse, Parse.Build, TypeCheck, Diag.Report {
    // The loader exits on a missing entry file, which would take the daemon down with it.
    if daemon_last.is_none() || file_exists(daemon_source_path) != 1 {
        return
    }
    let mut c = daemon_last.unwrap()
    // Taken before the compare, so an edit after it moves a stat for the next poll.
    let stats = daemon_input_stats()
    if stats == c.stats && !checked_probes_changed() {
        return
    }
    if checked_inputs_changed(daemon_source_path) {
        daemon_last = Some(daemon_check_program())
    } else {
        // A touch, or an edit undone: the next poll needs no compare.
        c.stats = stats
        daemon_last = Some(c)
    }
}

// Returns the build to run in a child forked for one, and None in the daemon once it stops.
// While a build child runs, the accept waits 1 ms at most and each turn reaps the child if it
// ended, so the daemon serves other requests meanwhile and its build client waits at most
// that, plus the one request being served then, past the child's end. The runtime has no wait
// on both the socket and the child.
fn daemon_loop() -> Option[DaemonBuild] ! Daemon.Serve, IO, Lex.Tokenize, Parse, Parse.Build, TypeCheck, Diag.Report {
    let mut builds = DaemonBuilds { child: None, queue: [], stops: [], seq: 0, turn: 0 }
    while daemon_running == 1 {
        // A worker whose router is gone serves no one, as no client finds its socket: it ends
        // as on a stop, after its build child, if one runs.
        if daemon_origin.router > 0 && daemon_getppid().to_int() != daemon_origin.router {
            if builds.child.is_none() {
                break
            }
            if builds.stops.len() == 0 {
                builds.stops.push(-1)
            }
        }
        let mut client_fd = -1
        match builds.child {
            Some(child) => {
                let status = reap(child.pid)
                if status != -2 {
                    daemon_end_child(child, status)
                    builds.child = None
                    builds = daemon_after_child(builds)
                    if daemon_running != 1 {
                        break
                    }
                }
                if builds.child.is_some() {
                    client_fd = daemon_accept_own(daemon_socket_fd, 1)
                }
            }
            None => {
                client_fd = daemon_accept_own(daemon_socket_fd, 500)
                if client_fd < 0 {
                    daemon_recheck_if_changed()
                }
            }
        }
        if client_fd < 0 {
            continue
        }

        let request = socket_read_line(client_fd)
        let req_type = daemon_extract_type(request) ?? ""

        let mut response = ""
        let mut held = false
        if req_type == "check" {
            response = daemon_handle_check(request)
        } else if req_type == "build" {
            builds.queue.push(DaemonHeld { request: request, client_fd: client_fd })
            held = true
            builds = daemon_ask_turn(builds)
        } else if req_type == "turn" {
            // The router's grant; it waits for no reply.
            unix_socket_close(client_fd)
            held = true
            let (next, build) = daemon_take_turn(builds)
            builds = next
            if build.is_some() {
                return build
            }
        } else if req_type == "query" {
            response = daemon_handle_query(request)
        } else if req_type == "status" {
            response = daemon_handle_status(builds)
        } else if req_type == "stop" {
            // A killed build would leave its cc and ld writing the files the client's cold
            // build writes next, so the daemon lets the build end first.
            if builds.child.is_some() {
                builds.stops.push(client_fd)
                held = true
            } else {
                // The router stops a worker whose builds wait for the turn only once no build
                // of the daemon runs.
                builds = daemon_send_cold(builds, "the daemon is stopping")
                response = daemon_handle_stop()
            }
        } else {
            response = "\{\"ok\":false,\"error\":\"unknown request type: {req_type}\"}"
        }

        if !held {
            daemon_reply(client_fd, response)
        }
    }
    None
}

// ── Router ──────────────────────────────────────────────────────────

// A worker the router forked: the entry it serves, keyed by its absolute path, and when a
// client last named it, in requests routed. name is the directory under .blink/ that holds
// its socket and files. The home worker serves the entry the daemon started on, which a
// query reads, so the router never ends it to make room. stop_fd is the connection a stop
// went to the worker on, open until the router reaps it, else -1. chan is the router's end of
// the connection on which the worker asks for the build turn, -1 once the worker closed it.
// killed is when the router killed the worker's process group, once chan closed, else 0.
type DaemonEntry {
    name: Str
    key: Str
    pid: Int
    home: Bool
    used: Int
    stop_fd: Int
    chan: Int
    killed: Int
}

// What a worker the router forks starts on: its name, the entry spelled as the client
// spelled it from its directory, its files, its listening socket, and the router's pid.
type DaemonSpawn {
    name: Str
    cwd: Str
    path: Str
    files: Str
    fd: Int
    router: Int
    chan: Int
}

// What the router holds. entries are the workers that serve; ended are those it stopped to
// make room, whose counts it holds in retired_*, until it reaps them. stops are the clients
// of a stop, held until every worker ends, and held the builds that came meanwhile, which then
// go to build cold, once no build of the daemon writes beside them. turn names the worker
// that holds the build turn, or is "", and waiting the workers that asked for it, oldest
// first. told names the workers a stop went to.
type DaemonRoute {
    entries: List[DaemonEntry]
    ended: List[DaemonEntry]
    next: Int
    seq: Int
    max: Int
    home_cwd: Str
    home_path: Str
    root: Str
    retired_checks: Int
    retired_builds: Int
    stops: List[Int]
    held: List[Int]
    turn: Str
    waiting: List[Str]
    told: List[Str]
}

// What routing a request leaves the router with: the reply to send, the worker to send the
// client to, or, in a worker it forked, the entry to serve.
type RouteTurn {
    Answer(text: Str)
    Redirect(name: Str)
    Serve(spawn: DaemonSpawn)
}

// The entry path as one string for every spelling of it from every directory: its real path,
// with each symbolic link resolved, so a link and its target, and a path through a linked
// directory, are one entry, and two files never are. A path realpath can not resolve, such as
// a missing file, falls back to the absolute path with no `.`, `..` or empty parts.
fn daemon_entry_key(cwd: Str, path: Str) -> Str {
    let full = if path.starts_with("/") { path } else { "{cwd}/{path}" }
    let mut real: Option[Str] = None
    with ffi.scope() as scope {
        let buf = scope.alloc_n[U8](4096)
        if !daemon_realpath(scope.cstr(full), buf).is_null() {
            real = buf.to_str()
        }
    }
    match real {
        Some(p) => return p
        None => {}
    }
    let mut parts: List[Str] = []
    for part in full.split("/") {
        if part == ".." {
            if parts.len() > 0 {
                parts = parts.slice(0, parts.len() - 1)
            }
        } else if part != "" && part != "." {
            parts.push(part)
        }
    }
    "/".concat(parts.join("/"))
}

// Sends request to the worker named name and returns its reply, or "" when none came.
fn daemon_ask_worker(name: Str, request: Str) -> Str {
    let fd = unix_socket_connect(path_join(daemon_dir(), "{name}/daemon.sock"))
    if fd < 0 {
        return ""
    }
    if socket_write(fd, request.concat("\n")) < 0 {
        unix_socket_close(fd)
        return ""
    }
    let reply = socket_read_line(fd)
    unix_socket_close(fd)
    reply
}

// Forks a worker for the entry at key, as path from cwd. Its socket listens before the fork,
// so a client the router sends there waits for the worker's first check rather than finding
// no socket. The router connects to that socket before the fork too, so the worker's first
// accept is the router's connection, and neither ever waits to connect to the other. In the
// worker, the router's own connections are closed. The worker's directory
// is named for the router's pid too: a worker of a daemon killed before ends only once it sees
// its router is gone, and then removes its directory, which must not be this daemon's.
fn daemon_spawn(route: DaemonRoute, key: Str, cwd: Str, path: Str, home: Bool, client_fd: Int) -> (DaemonRoute, Option[DaemonSpawn], Str) ! IO {
    let mut r = route
    let router = getpid()
    let name = "w{router}-{r.next}"
    r.next = r.next + 1
    let dir = path_join(daemon_dir(), name)
    if !daemon_private_dir(dir) {
        return (r, None, "the daemon could not make {dir} private to its user")
    }
    let fd = daemon_listen_private(path_join(dir, "daemon.sock"))
    let chan = if fd >= 0 { unix_socket_connect(path_join(dir, "daemon.sock")) } else { -1 }
    if chan < 0 {
        if fd >= 0 { unix_socket_close(fd) }
        shell_exec("rm -rf {dir}")
        return (r, None, "the daemon could not make a socket for {path}")
    }
    // The worker inherits what stdout holds unflushed, and would print it again.
    io.write("")
    let pid = daemon_fork().to_int()
    if pid < 0 {
        unix_socket_close(fd)
        unix_socket_close(chan)
        shell_exec("rm -rf {dir}")
        return (r, None, "the daemon could not fork a worker for {path}")
    }
    // The worker leads a process group of its own, which its build children and each process
    // they start join, so the router can end all of them once the worker is gone. Both sides
    // set it, so the group stands before either acts on it.
    if pid == 0 {
        let _ = daemon_setpgid(0.to_i32(), 0.to_i32())
        daemon_gc_start_markers()
        daemon_close_router_fds(r)
        unix_socket_close(chan)
        let worker_chan = unix_socket_accept(fd)
        if client_fd >= 0 { unix_socket_close(client_fd) }
        let files = if dir.starts_with("/") { dir } else { path_join(env.cwd(), dir) }
        return (r, Some(DaemonSpawn { name: name, cwd: cwd, path: path, files: files, fd: fd, router: router, chan: worker_chan }), "")
    }
    let _ = daemon_setpgid(pid.to_i32(), pid.to_i32())
    unix_socket_close(fd)
    r.entries.push(DaemonEntry { name: name, key: key, pid: pid, home: home, used: r.seq, stop_fd: -1, chan: chan, killed: 0 })
    (r, None, "")
}

// In a child of the router: closes the connections the router holds, so a client or worker
// at the other end sees its close when the router closes it.
fn daemon_close_router_fds(r: DaemonRoute) {
    unix_socket_close(daemon_socket_fd)
    for s in r.stops { unix_socket_close(s) }
    for h in r.held { unix_socket_close(h) }
    for e in r.entries {
        if e.stop_fd >= 0 { unix_socket_close(e.stop_fd) }
        if e.chan >= 0 { unix_socket_close(e.chan) }
    }
    for e in r.ended {
        if e.stop_fd >= 0 { unix_socket_close(e.stop_fd) }
        if e.chan >= 0 { unix_socket_close(e.chan) }
    }
}

// The reply that sends a client to the worker named name. It says not served, so a client
// that does not follow it checks or builds cold.
fn daemon_redirect(name: Str) -> Str {
    json_clear()
    let reply = json_new_object()
    json_set(reply, "ok", json_new_bool(0))
    json_set(reply, "served", json_new_int(0))
    json_set(reply, "worker", json_new_str(name))
    json_encode(reply)
}

// Ends the worker used longest ago, past the home one, while the router holds max of them,
// so the new one makes no more than max. A worker that builds, or holds builds, is passed
// over: its clients wait on it. With none left to end, the router serves one entry more
// than max until one is.
fn daemon_make_room(route: DaemonRoute) -> DaemonRoute ! IO {
    let mut r = route
    let mut passed: List[Str] = []
    while r.entries.len() >= r.max {
        let mut pick = -1
        let mut i = 0
        while i < r.entries.len() {
            let e = r.entries.get(i).unwrap()
            if !e.home && !passed.contains(e.name) {
                if pick < 0 || e.used < r.entries.get(pick).unwrap().used {
                    pick = i
                }
            }
            i = i + 1
        }
        if pick < 0 {
            break
        }
        let e = r.entries.get(pick).unwrap()
        let status = daemon_ask_worker(e.name, "\{\"type\":\"status\"}")
        json_clear()
        let root = json_parse(status)
        if root < 0 || json_as_int(json_get(root, "building")) != 0 || json_as_int(json_get(root, "queued")) != 0 {
            passed.push(e.name)
            continue
        }
        let stopped = daemon_ask_worker(e.name, "\{\"type\":\"stop\"}")
        json_clear()
        let counts = json_parse(stopped)
        if counts >= 0 {
            r.retired_checks = r.retired_checks + json_as_int(json_get(counts, "checks"))
            r.retired_builds = r.retired_builds + json_as_int(json_get(counts, "builds"))
        }
        r.ended.push(e)
        r.entries = r.entries.filter(fn(x) { x.name != e.name })
    }
    r
}

// Sends a check, build or query to the worker of its entry, forked first if none serves it.
// A query reads the symbols of the entry the daemon started on.
fn daemon_route_request(route: DaemonRoute, req_type: Str, request: Str, client_fd: Int) -> (DaemonRoute, RouteTurn) ! IO {
    let mut r = route
    let mut cwd = r.home_cwd
    let mut path = r.home_path
    if req_type != "query" {
        json_clear()
        let root = json_parse(request)
        cwd = json_as_str(json_get(root, "cwd"))
        path = json_as_str(json_get(root, "path"))
        // The worker checks the same, but a client it would not serve must not cost a worker.
        if req_type == "build" {
            if json_as_str(json_get(root, "identity")) != daemon_origin.identity {
                return (r, RouteTurn.Answer(daemon_not_served("the client runs another compiler or environment than the daemon")))
            }
            if json_as_str(json_get(root, "settings")) != daemon_origin.settings {
                return (r, RouteTurn.Answer(daemon_not_served("the client sets what the front end reads otherwise than the daemon")))
            }
        }
    }
    let key = daemon_entry_key(cwd, path)
    // A file outside the project root may belong to another project, with a blink.toml of its
    // own, so the daemon leaves it to a cold check or build. Both sides are real paths, so a
    // link in the project to a file outside it is outside.
    // The entry the daemon started on is served wherever it lies.
    let home = key == daemon_entry_key(r.home_cwd, r.home_path)
    if !home && !key.starts_with(r.root.concat("/")) {
        return (r, RouteTurn.Answer(daemon_not_served("outside the project at {r.root}: {path}")))
    }
    r.seq = r.seq + 1
    let mut found = ""
    let mut kept: List[DaemonEntry] = []
    for e in r.entries {
        if e.key == key {
            found = e.name
            kept.push(DaemonEntry { used: r.seq, ..e })
        } else {
            kept.push(e)
        }
    }
    r.entries = kept
    if found != "" {
        return (r, RouteTurn.Redirect(found))
    }
    // The loader exits on a missing entry file, which would end the worker on its first check.
    if file_exists(key) != 1 {
        return (r, RouteTurn.Answer(daemon_not_served("source file not found: {path}")))
    }
    if !home {
        r = daemon_make_room(r)
    }
    let (next, spawn, why) = daemon_spawn(r, key, cwd, path, home, client_fd)
    r = next
    match spawn {
        Some(s) => return (r, RouteTurn.Serve(s))
        None => {}
    }
    if why != "" {
        return (r, RouteTurn.Answer(daemon_not_served(why)))
    }
    (r, RouteTurn.Redirect(r.entries.get(r.entries.len() - 1).unwrap().name))
}

// The daemon's status: the router's own fields, and the sum of its workers' counts, with the
// symbols and files of the home worker, which a query reads. entries counts the workers that
// serve.
fn daemon_route_status(r: DaemonRoute) -> Str {
    let uptime = time_ms() - daemon_start_time
    let mut symbols = 0
    let mut files = 0
    let mut building = 0
    let mut queued = 0
    let mut served = r.retired_builds
    let mut checks = r.retired_checks
    for e in r.entries {
        let reply = daemon_ask_worker(e.name, "\{\"type\":\"status\"}")
        json_clear()
        let root = json_parse(reply)
        if root >= 0 {
            building = building + json_as_int(json_get(root, "building"))
            queued = queued + json_as_int(json_get(root, "queued"))
            served = served + json_as_int(json_get(root, "builds"))
            checks = checks + json_as_int(json_get(root, "checks"))
            if e.home {
                symbols = json_as_int(json_get(root, "symbols"))
                files = json_as_int(json_get(root, "files"))
            }
        }
    }
    let stopping = if r.stops.len() > 0 { 1 } else { 0 }
    let entries = r.entries.len()
    "\{\"ok\":true,\"uptime_ms\":{uptime},\"symbols\":{symbols},\"files\":{files},\"building\":{building},\"queued\":{queued},\"stopping\":{stopping},\"entries\":{entries},\"builds\":{served},\"checks\":{checks}}"
}

// Reaps each worker that ended, and removes its files, once no process of its group is left.
// Until then it holds the build turn if it held it: a build child of a dead worker may still
// write the files the next build of its entry writes. A worker that ended waits for the turn
// no more.
fn daemon_reap_workers(route: DaemonRoute) -> DaemonRoute ! IO {
    let mut r = route
    let mut gone: List[Str] = []
    let mut ending: List[DaemonEntry] = []
    for e in r.ended {
        if e.chan >= 0 || !daemon_group_gone(e) {
            ending.push(e)
        } else {
            daemon_forget_worker(e)
            gone.push(e.name)
        }
    }
    r.ended = ending
    if gone.len() == 0 {
        return r
    }
    r.waiting = r.waiting.filter(fn(w) { !gone.contains(w) })
    if gone.contains(r.turn) {
        r.turn = ""
    }
    daemon_grant_turn(r)
}

// A worker closes its end of chan only as it exits, so the close is when the router ends the
// rest of its group. The kill comes before the reap: until then the worker's pid, which names
// the group, can name no other process.
fn daemon_end_group(e: DaemonEntry) -> DaemonEntry {
    unix_socket_close(e.chan)
    // SIGKILL is 9 on every host the daemon runs on.
    let _ = daemon_kill((0 - e.pid).to_i32(), 9.to_i32())
    DaemonEntry { chan: -1, killed: time_ms(), ..e }
}

// Reaps the worker e, and any process of its group the router came to parent, and says
// whether the group is gone. A killed process can not write once it is a zombie, but only its
// parent reaps it, and an init that reaps none would hold the group forever; so 10 s after the
// kill the group counts as gone.
fn daemon_group_gone(e: DaemonEntry) -> Bool ! IO {
    with ffi.scope() as scope {
        let cell = scope.alloc[I32]()
        loop {
            // WNOHANG is 1 on every host the daemon runs on.
            let w = daemon_waitpid((0 - e.pid).to_i32(), cell, 1.to_i32()).to_int()
            // EINTR is 4 on every host the daemon runs on.
            if w <= 0 && (w == 0 || daemon_errno() != 4) { break }
        }
    }
    daemon_kill((0 - e.pid).to_i32(), 0.to_i32()).to_int() != 0 || time_ms() - e.killed >= 10000
}

fn daemon_forget_worker(e: DaemonEntry) ! IO {
    if e.stop_fd >= 0 {
        unix_socket_close(e.stop_fd)
    }
    if e.chan >= 0 {
        unix_socket_close(e.chan)
    }
    shell_exec("rm -rf {path_join(daemon_dir(), e.name)}")
}

// Gives the free build turn to the worker that asked first. A worker the grant does not reach
// is gone, and the next one gets it. While a stop waits, no build starts, and once the turn
// is free the stop goes to every worker.
fn daemon_grant_turn(route: DaemonRoute) -> DaemonRoute {
    let mut r = route
    if r.turn != "" {
        return r
    }
    if r.stops.len() > 0 {
        return daemon_stop_workers(r)
    }
    while r.turn == "" && r.waiting.len() > 0 {
        let name = r.waiting.get(0).unwrap()
        r.waiting = r.waiting.slice(1, r.waiting.len())
        let fd = unix_socket_connect(path_join(daemon_dir(), "{name}/daemon.sock"))
        if fd < 0 {
            continue
        }
        if socket_write(fd, "\{\"type\":\"turn\"}\n") >= 0 {
            r.turn = name
        }
        unix_socket_close(fd)
    }
    r
}

// A line a worker sent on its connection to the router: it asks for the build turn, or gives
// it back, with more 1 when it has more builds to run.
fn daemon_route_turn(route: DaemonRoute, name: Str, line: Str) -> DaemonRoute {
    let mut r = route
    json_clear()
    let root = json_parse(line)
    if root < 0 {
        return r
    }
    let kind = json_as_str(json_get(root, "type"))
    let ask = kind == "turn" || (kind == "done" && json_as_int(json_get(root, "more")) == 1)
    if kind == "done" && r.turn == name {
        r.turn = ""
    }
    if ask && r.turn != name && !r.waiting.contains(name) {
        r.waiting.push(name)
    }
    daemon_grant_turn(r)
}

// Reads what each worker sent on its connection to the router, as polled. A worker that closed
// it is gone or going: the router ends its group, serves its entry from a new worker, and
// frees what it held once its reap does.
fn daemon_read_chans(route: DaemonRoute, ready: List[Int]) -> DaemonRoute {
    let mut r = route
    let mut names: List[Str] = []
    let mut lines: List[Str] = []
    let mut kept: List[DaemonEntry] = []
    let mut dead: List[DaemonEntry] = []
    for e in r.entries {
        if e.chan >= 0 && ready.contains(e.chan) {
            let line = socket_read_line(e.chan)
            if line == "" {
                dead.push(daemon_end_group(e))
                continue
            }
            names.push(e.name)
            lines.push(line)
        }
        kept.push(e)
    }
    r.entries = kept
    let mut ending: List[DaemonEntry] = []
    for e in r.ended {
        if e.chan >= 0 && ready.contains(e.chan) {
            let line = socket_read_line(e.chan)
            if line == "" {
                ending.push(daemon_end_group(e))
                continue
            }
            names.push(e.name)
            lines.push(line)
        }
        ending.push(e)
    }
    for e in dead {
        ending.push(e)
    }
    r.ended = ending
    let mut i = 0
    while i < names.len() {
        r = daemon_route_turn(r, names.get(i).unwrap(), lines.get(i).unwrap())
        i = i + 1
    }
    r
}

// Waits up to wait ms for a client or a line from a worker, reads the lines, and returns the
// client's connection, or -1.
fn daemon_route_wait(route: DaemonRoute, wait: Int) -> (DaemonRoute, Int) ! IO {
    let mut fds: List[Pollfd] = [Pollfd { fd: daemon_socket_fd.to_i32(), events: 1.to_i16(), revents: 0.to_i16() }]
    for e in route.entries {
        if e.chan >= 0 { fds.push(Pollfd { fd: e.chan.to_i32(), events: 1.to_i16(), revents: 0.to_i16() }) }
    }
    for e in route.ended {
        if e.chan >= 0 { fds.push(Pollfd { fd: e.chan.to_i32(), events: 1.to_i16(), revents: 0.to_i16() }) }
    }
    let polled = match poll(fds, wait) {
        Ok(out) => out
        // An interrupted poll reports nothing ready; the loop polls again.
        Err(_) => return (route, -1)
    }
    let mut ready: List[Int] = []
    let mut i = 1
    while i < polled.len() {
        let p = polled.get(i).unwrap()
        if p.revents.to_int() != 0 { ready.push(p.fd.to_int()) }
        i = i + 1
    }
    let r = if ready.len() > 0 { daemon_read_chans(route, ready) } else { route }
    if polled.get(0).unwrap().revents.to_int() == 0 {
        return (r, -1)
    }
    (r, daemon_accept_own(daemon_socket_fd, 0))
}

// Holds the stop and sends it to the workers. The router replies to it once it has reaped
// them all.
fn daemon_route_stop(route: DaemonRoute, client_fd: Int) -> DaemonRoute {
    let mut r = route
    r.stops.push(client_fd)
    daemon_stop_workers(r)
}

// Sends a stop to each worker it has not gone to. A worker ends at once, or once its build
// child does. A worker sends the builds it holds to build cold as it stops, which must not
// happen beside a build, so while one worker holds the build turn the stop goes to it alone,
// and to the rest once it gives the turn back or ends.
fn daemon_stop_workers(route: DaemonRoute) -> DaemonRoute {
    let mut r = route
    let mut sent: List[DaemonEntry] = []
    for e in r.entries {
        if r.told.contains(e.name) || (r.turn != "" && e.name != r.turn) {
            sent.push(e)
            continue
        }
        r.told.push(e.name)
        let fd = unix_socket_connect(path_join(daemon_dir(), "{e.name}/daemon.sock"))
        if fd >= 0 && socket_write(fd, "\{\"type\":\"stop\"}\n") < 0 {
            unix_socket_close(fd)
            sent.push(e)
            continue
        }
        sent.push(DaemonEntry { stop_fd: fd, ..e })
    }
    r.entries = sent
    r
}

// Returns, in a worker it forked, the entry to serve, and None in the router once it stops.
// The router waits for a client and for the lines its workers send at once, so a worker gets
// the build turn as soon as it is free. While a stop waits on its workers, or a worker it
// ended has yet to be reaped, the wait is 1 ms at most, so the stop ends as soon as the last
// of them does.
fn daemon_route(max: Int) -> Option[DaemonSpawn] ! IO {
    let mut r = DaemonRoute { entries: [], ended: [], next: 1, seq: 0, max: max, home_cwd: daemon_origin.cwd, home_path: daemon_source_path, root: daemon_entry_key(env.cwd(), path_dirname(daemon_dir())), retired_checks: 0, retired_builds: 0, stops: [], held: [], turn: "", waiting: [], told: [] }
    // The home worker checks the entry at once, so the first request finds it checked.
    let home_key = daemon_entry_key(r.home_cwd, r.home_path)
    let (first, home, why) = daemon_spawn(r, home_key, r.home_cwd, r.home_path, true, -1)
    r = first
    if home.is_some() {
        return home
    }
    if why != "" {
        io.eprintln("daemon: {why}")
    }
    while daemon_running == 1 {
        r = daemon_reap_workers(r)
        if r.stops.len() > 0 && r.entries.len() == 0 && r.ended.len() == 0 {
            for h in r.held {
                daemon_reply(h, daemon_not_served("the daemon is stopping"))
            }
            for s in r.stops {
                daemon_reply(s, "\{\"ok\":true,\"message\":\"daemon stopping\"}")
            }
            break
        }
        let wait = if r.stops.len() > 0 || r.ended.len() > 0 { 1 } else { 500 }
        let (polled, client_fd) = daemon_route_wait(r, wait)
        r = polled
        if client_fd < 0 {
            continue
        }
        let request = socket_read_line(client_fd)
        let req_type = daemon_extract_type(request) ?? ""
        if req_type == "check" || req_type == "build" || req_type == "query" {
            if r.stops.len() > 0 {
                if req_type == "build" {
                    r.held.push(client_fd)
                } else {
                    daemon_reply(client_fd, daemon_not_served("the daemon is stopping"))
                }
                continue
            }
            let (next, turn) = daemon_route_request(r, req_type, request, client_fd)
            r = next
            match turn {
                Serve(s) => return Some(s)
                Redirect(name) => daemon_reply(client_fd, daemon_redirect(name))
                Answer(text) => daemon_reply(client_fd, text)
            }
        } else if req_type == "status" {
            daemon_reply(client_fd, daemon_route_status(r))
        } else if req_type == "stop" {
            r = daemon_route_stop(r, client_fd)
        } else {
            daemon_reply(client_fd, "\{\"ok\":false,\"error\":\"unknown request type: {req_type}\"}")
        }
    }
    None
}

// Serves the entry a worker was forked for until a stop, then removes its files and ends the
// worker. In a child forked for a build it returns the build instead.
fn daemon_serve(s: DaemonSpawn) -> Option[DaemonBuild] ! Daemon.Serve, IO, Lex.Tokenize, Parse, Parse.Build, TypeCheck, Diag.Report {
    daemon_socket_fd = s.fd
    daemon_origin = DaemonOrigin { router: s.router, files: s.files, chan: s.chan, ..daemon_origin }
    // The router's files are the router's to remove.
    daemon_pid_path = ""
    daemon_sock_path = ""
    if daemon_enter(s.cwd, s.path) && file_exists(daemon_source_path) == 1 {
        daemon_last = Some(daemon_check_program())
    }
    daemon_running = 1
    let build = daemon_loop()
    if build.is_some() {
        return build
    }
    daemon_stop()
    shell_exec("rm -rf {daemon_origin.files}")
    // The end of main joins the threads of the process's pool, which the router started and
    // the fork did not copy, so a return from main would wait on them forever.
    exit(0)
    None
}

// ── Shutdown ────────────────────────────────────────────────────────

fn daemon_stop() ! Daemon.Serve {
    if daemon_socket_fd >= 0 {
        unix_socket_close(daemon_socket_fd)
        daemon_socket_fd = -1
    }
    if daemon_pid_path != "" {
        shell_exec("rm -f {daemon_pid_path}")
    }
    if daemon_sock_path != "" {
        shell_exec("rm -f {daemon_sock_path}")
    }
    si_reset()
    checked_inputs_reset()
    daemon_last = None
    daemon_running = 0
}

// ── Socket location ─────────────────────────────────────────────────

// A project has one daemon. It keeps its socket and pid file in .blink/ at the project root:
// the nearest directory at or above the cwd that holds blink.toml, else the cwd. Every daemon
// subcommand and client asks this one function, so they agree on whether a daemon runs. The
// path stays relative to the cwd, since bind refuses a socket path over 107 bytes.
fn daemon_dir() -> Str {
    let mut abs = env.cwd()
    let mut rel = ""
    while file_exists(path_join(rel, "blink.toml")) != 1 {
        let up = path_dirname(abs)
        if up == abs {
            return ".blink"
        }
        abs = up
        rel = path_join(rel, "..")
    }
    path_join(rel, ".blink")
}

pub fn daemon_socket_path() -> Str {
    path_join(daemon_dir(), "daemon.sock")
}

// Sends request on fd, a connection to the project's daemon, closes fd, and returns the reply,
// or "" when none came. The router replies to a check, build or query with the name of the
// worker that serves its entry, and the request goes there once. A socket another user
// listens on, a worker that is gone by then, or a second redirect gives "", and the client
// runs cold.
pub fn daemon_send(fd: Int, request: Str) -> Str ! IO {
    let line = request.concat("\n")
    // A request carries the client's environment, so a socket another user listens on gets none.
    if !daemon_peer_allowed(fd) || socket_write(fd, line) < 0 {
        unix_socket_close(fd)
        return ""
    }
    let reply = socket_read_line(fd)
    unix_socket_close(fd)
    let worker = daemon_worker_of(reply)
    if worker == "" {
        return reply
    }
    let worker_fd = unix_socket_connect(path_join(daemon_dir(), "{worker}/daemon.sock"))
    if worker_fd < 0 {
        return ""
    }
    if !daemon_peer_allowed(worker_fd) || socket_write(worker_fd, line) < 0 {
        unix_socket_close(worker_fd)
        return ""
    }
    let answer = socket_read_line(worker_fd)
    unix_socket_close(worker_fd)
    if daemon_worker_of(answer) != "" { "" } else { answer }
}

// The worker a reply sends the client to, or "". A name with a `/` or `..` is no worker of
// this daemon's .blink/.
fn daemon_worker_of(reply: Str) -> Str {
    if !reply.contains("\"worker\"") {
        return ""
    }
    json_clear()
    let root = json_parse(reply)
    let name = if root < 0 { "" } else { json_as_str(json_get(root, "worker")) }
    if name.contains("/") || name.contains("..") { "" } else { name }
}

// ── Startup ─────────────────────────────────────────────────────────

// Serves until a stop, then returns None. In a child forked for a build it returns the build
// instead, for the caller to run. identity names the compiler and the environment, and
// settings what the front end reads, which a client must share for the daemon to build for it.
// max_entries is how many entry files the daemon keeps checked at once, each in a worker.
pub fn daemon_start(source: Str, identity: Str, settings: Str, interface_text: Bool, max_entries: Int) -> Option[DaemonBuild] ! Daemon.Serve, IO, Lex.Tokenize, Parse, Parse.Build, TypeCheck, Diag.Report {
    daemon_source_path = source
    daemon_origin = DaemonOrigin { cwd: env.cwd(), identity: identity, settings: settings, interface_text: interface_text, builds: 0, router: 0, files: "", chan: -1 }
    daemon_start_time = time_ms()

    let blink_dir = daemon_dir()
    if !daemon_private_dir(blink_dir) {
        io.eprintln("daemon: could not make {blink_dir} private to its user")
        return None
    }

    // Write PID file
    daemon_pid_path = path_join(blink_dir, "daemon.pid")
    let pid = getpid()
    write_file(daemon_pid_path, "{pid}")

    // Create Unix socket
    daemon_sock_path = daemon_socket_path()
    daemon_socket_fd = daemon_listen_private(daemon_sock_path)
    if daemon_socket_fd < 0 {
        io.eprintln("daemon: failed to create socket at {daemon_sock_path}")
        return None
    }

    io.eprintln("daemon: listening on {daemon_sock_path} (pid {pid})")
    daemon_running = 1
    match daemon_route(max_entries) {
        Some(spawn) => daemon_serve(spawn)
        None => {
            daemon_stop()
            None
        }
    }
}
