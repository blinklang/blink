import symbol_index.{si_build, si_reset, si_sym_count, si_file_count}
import query.{query_dispatch}
import diagnostics.{Diag, diag_count, diag_warn_count, diag_ice_count, diag_render}
import std.json.{json_clear, json_new_object, json_new_bool, json_set, json_new_str, json_new_int, json_encode, json_parse, json_get, json_as_str, json_as_int, json_at, json_len}
import std.path.{path_join, path_dirname}
import lexer.{Lex}
import parser.{Parse, parser_want_interface_text}
import typecheck.{TypeCheck}
import check_pipeline.{FrontEndReport, check_source_reporting, checked_inputs_changed, checked_inputs_reset, checked_probes_changed, checked_input_files, check_exit_code, check_status_line}

effect Daemon {
    effect Serve
}

// daemon.bl — Persistent compiler service with Unix socket IPC
//
// The front end keeps its state in globals, so one process holds one checked program. The
// daemon is a router, which runs no front end, and one worker per entry file, which the router
// forks the first time a client names that entry. The router hands a check, build or query to
// a relay it forks, which sends it to the entry's worker and copies the reply back, so a
// client speaks to one socket and the router serves on while a worker checks or builds.
// A worker is a single-threaded event loop: accept connection, read JSON request,
// dispatch (check/build/query/status/stop), respond, check file watcher.
// A check runs check_pipeline.check_source, the check `blink check` runs.
// A build runs in a child the worker forks, which builds from the program the last check
// holds, and the loop serves on while the child runs.

// ── State ───────────────────────────────────────────────────────────

let mut daemon_running: Int = 0
let mut daemon_socket_fd: Int = -1
let mut daemon_pid_path: Str = ""
let mut daemon_sock_path: Str = ""
let mut daemon_source_path: Str = ""
let mut daemon_start_time: Int = 0
let mut daemon_check_count: Int = 0
// A diagnostic spells its file as the entry path was typed, relative to the working
// directory, so a worker checks in the client's directory with the client's spelling, and
// checks again when either differs from its last check's. A build also reads the compiler
// binary, the environment and the settings the front end reads, so the daemon builds only
// for a client whose identity and settings are its own.
type DaemonOrigin {
    cwd: Str
    identity: Str
    settings: Str
    // Whether its checks parse for the interface texts a build that may take units compares.
    interface_text: Bool
    builds: Int
    // In a worker: the router's pid, and the directory, absolute since the worker changes its
    // working directory, that holds the worker's socket and the files its checks and builds
    // print to. In the router, 0 and "".
    router: Int
    files: Str
}

let mut daemon_origin: DaemonOrigin = DaemonOrigin { cwd: "", identity: "", settings: "", interface_text: false, builds: 0, router: 0, files: "" }

// The findings of a check, rendered both ways a client can ask for, since the diagnostics
// themselves do not outlive the next check.
type DaemonCheck {
    human: Str
    json: Str
    errors: Int
    warnings: Int
    ices: Int
    // The program the check left, which a build compiles, and what the build prints first.
    program: Int
    front: FrontEndReport
    // What the check printed itself, apart from its diagnostics, such as the loader's note on
    // a local module that shadows a dependency; captured false when the daemon could not
    // capture it, so a build would print less than a cold one.
    out: Str
    err: Str
    captured: Bool
    // The mtime and size of each file the check read, from just after it. The poll compares
    // bytes only once one of them moves. Empty when an edit landed during the check.
    stats: List[Int]
}

// The last check, which holds until an input changes.
let mut daemon_last: Option[DaemonCheck] = None

// A build child the daemon forked and has not reaped, and what it owes the client: the files
// the child prints to and the connection the reply goes to.
type DaemonChild {
    pid: Int
    client_fd: Int
    out: Str
    err: Str
    declined: Str
}

// A request the daemon holds until its build child ends, with the connection it came on.
type DaemonHeld {
    request: Str
    client_fd: Int
}

// What the loop holds about builds. child is the one it forked and has not reaped. Two builds
// of one entry write the same units dir and program, and a client sent to build cold would
// write them beside the child, so a build that comes while a child runs waits in queue, oldest
// first, for its turn. stops came while a child ran; the daemon answers them and ends once the
// child does. seq numbers each build's files, so no reply reads another build's output.
type DaemonBuilds {
    child: Option[DaemonChild]
    queue: List[DaemonHeld]
    stops: List[Int]
    seq: Int
}

// ── Extract request type ────────────────────────────────────────────

fn daemon_extract_type(request: Str) -> Option[Str] {
    json_clear()
    let root = json_parse(request)
    if root < 0 {
        return None
    }
    Some(json_as_str(json_get(root, "type")))
}

// ── Handle: check ───────────────────────────────────────────────────

// Each check sees the whole program: mono and the mutation passes judge across functions,
// so a recheck of only the changed functions could miss what an edit broke elsewhere.
fn daemon_check_program() -> DaemonCheck ! IO, Lex.Tokenize, Parse, Parse.Build, TypeCheck, Diag.Report {
    let out_path = path_join(daemon_origin.files, "check.out")
    let err_path = path_join(daemon_origin.files, "check.err")
    let saved = capture_output(out_path, err_path)
    parser_want_interface_text(daemon_origin.interface_text)
    let (program, front) = check_source_reporting(daemon_source_path)
    parser_want_interface_text(false)
    let captured = restore_output(saved)
    let out = if captured { read_file(out_path) } else { "" }
    let err = if captured { read_file(err_path) } else { "" }
    // An edit after the loader read a file and before this stat leaves no stat change for a
    // poll to see. The bytes show it, so one compare here closes that gap.
    let taken = daemon_input_stats()
    let stats = if checked_inputs_changed(daemon_source_path) { [] } else { taken }
    si_reset()
    si_build(program, daemon_source_path, "main")
    DaemonCheck {
        human: diag_render(0),
        json: diag_render(1),
        errors: diag_count,
        warnings: diag_warn_count,
        ices: diag_ice_count,
        program: program,
        front: front,
        out: out,
        err: err,
        captured: captured,
        stats: stats,
    }
}

// The mtime and size of each file the last check read, -1 for one it can not stat or open.
// A same-size edit inside one mtime tick, or one whose mtime was set back, leaves these as
// they were, so they only tell the poll when to compare bytes. A build compares bytes itself.
fn daemon_input_stats() -> List[Int] ! IO {
    let mut stats: List[Int] = []
    for p in checked_input_files() {
        stats.push(file_mtime(p))
        stats.push(daemon_file_size(p))
    }
    stats
}

fn daemon_file_size(path: Str) -> Int ! IO {
    let mut size = -1
    with ffi.scope() as scope {
        let file = daemon_open(scope.cstr(path), 0.to_i32()).to_int()
        if file >= 0 {
            size = daemon_lseek(file.to_i32(), 0, 2.to_i32())
            unix_socket_close(file)
        }
    }
    size
}

fn daemon_not_served(why: Str) -> Str {
    json_clear()
    let reply = json_new_object()
    json_set(reply, "ok", json_new_bool(0))
    json_set(reply, "served", json_new_int(0))
    json_set(reply, "error", json_new_str(why))
    json_encode(reply)
}

// Makes cwd and path the worker's working directory and entry spelling, so its next check
// reads and prints as a cold check in the client would. The router sends a worker only the
// spellings of its one entry file, but the check does not trust that: a new spelling drops
// the last check. False when the worker can not change to cwd.
fn daemon_enter(cwd: Str, path: Str) -> Bool ! IO {
    if cwd == daemon_origin.cwd && path == daemon_source_path {
        return true
    }
    let mut ok = false
    with ffi.scope() as scope {
        ok = daemon_chdir(scope.cstr(cwd)).to_int() == 0
    }
    if !ok {
        return false
    }
    daemon_origin = DaemonOrigin { cwd: cwd, ..daemon_origin }
    daemon_source_path = path
    daemon_last = None
    true
}

// The reply carries what a cold `blink check` would print on stdout and stderr and the code
// it would exit with, so the client prints the bytes and needs no rendering of its own.
// With no input changed, the last answer still holds, so the daemon gives it again rather
// than an empty list that would read as clean.
fn daemon_handle_check(request: Str) -> Str ! Daemon.Serve, IO, Lex.Tokenize, Parse, Parse.Build, TypeCheck, Diag.Report {
    json_clear()
    let root = json_parse(request)
    let cwd = json_as_str(json_get(root, "cwd"))
    let path = json_as_str(json_get(root, "path"))
    let json_status = json_as_int(json_get(root, "json"))
    let diag_json = json_as_int(json_get(root, "diag_json"))
    let strict = json_as_int(json_get(root, "strict"))
    if !daemon_enter(cwd, path) {
        return daemon_not_served("the daemon could not change to {cwd}")
    }
    // The loader exits on a missing entry file, which would take the daemon down with it.
    if file_exists(daemon_source_path) != 1 {
        daemon_last = None
        return daemon_not_served("source file not found: {daemon_source_path}")
    }
    daemon_check_count = daemon_check_count + 1
    let mut changed = 0
    if daemon_last.is_none() || checked_inputs_changed(daemon_source_path) {
        daemon_last = Some(daemon_check_program())
        changed = 1
    }
    let c = daemon_last.unwrap()
    let status = check_status_line(daemon_source_path, json_status, strict, c.ices, c.errors, c.warnings)
    json_clear()
    let reply = json_new_object()
    json_set(reply, "ok", json_new_bool(1))
    json_set(reply, "served", json_new_int(1))
    json_set(reply, "changed", json_new_int(changed))
    json_set(reply, "exit", json_new_int(check_exit_code(strict, c.ices, c.errors, c.warnings)))
    json_set(reply, "stdout", json_new_str(status.concat("\n")))
    json_set(reply, "stderr", json_new_str(if diag_json == 1 { c.json } else { c.human }))
    json_encode(reply)
}

// ── Handle: build ───────────────────────────────────────────────────

// An @ffi function's C name has no module part, so these carry the module in their own names,
// apart from std.libc's bindings over the same calls.
@ffi("fork", header: "unistd.h")
@trusted(audit: "Wraps fork(2). The daemon is single-threaded and the GC runs no marker threads, so the child holds no lock another thread took.")
fn daemon_fork() -> I32 ! FFI {}

@ffi("waitpid", header: "sys/wait.h")
@trusted(audit: "Wraps waitpid(2). status is one I32 cell from ffi.scope(); options is fixed to WNOHANG, 1 on every host.")
fn daemon_waitpid(pid: I32, status: Ptr[I32], options: I32) -> I32 ! FFI {}

@ffi("open", header: "fcntl.h")
@trusted(audit: "Wraps open(2) with no mode. path is a NUL-terminated copy from ffi.scope(); flags is O_RDONLY or O_WRONLY, 0 and 1 on every host.")
fn daemon_open(path: Ptr[U8], flags: I32) -> I32 ! FFI {}

@ffi("lseek", header: "unistd.h")
@trusted(audit: "Wraps lseek(2). fd is one daemon_open returned; whence is fixed to SEEK_END, 2 on every host.")
fn daemon_lseek(fd: I32, offset: Int, whence: I32) -> Int ! FFI {}

@ffi("dup", header: "unistd.h")
@trusted(audit: "Wraps dup(2). fd is 1 or 2, which the daemon holds open.")
fn daemon_dup(fd: I32) -> I32 ! FFI {}

@ffi("dup2", header: "unistd.h")
@trusted(audit: "Wraps dup2(2). Both descriptors are the process's own: one open or dup returned, and 1 or 2.")
fn daemon_dup2(old_fd: I32, new_fd: I32) -> I32 ! FFI {}

@ffi("blink_errno_get")
@trusted(audit: "Wraps the runtime blink_errno_get(), which returns errno. Read right after a failed waitpid.")
fn daemon_errno() -> Int ! FFI {}

@ffi("chdir", header: "unistd.h")
@trusted(audit: "Wraps chdir(2). path is a NUL-terminated copy from ffi.scope(), the working directory a client sent.")
fn daemon_chdir(path: Ptr[U8]) -> I32 ! FFI {}

@ffi("getppid", header: "unistd.h")
@trusted(audit: "Wraps getppid(2), which takes nothing and can not fail.")
fn daemon_getppid() -> I32 ! FFI {}

// What the child the daemon forked for a build runs: the client's command line, from the
// program the daemon checked last. declined names the file the child makes when the build
// needs a step a cold build takes first, such as a rebuilt stdlib archive, which the child can
// not take with the program already loaded; the client then builds cold.
pub type DaemonBuild {
    argv: List[Str]
    program: Int
    front: FrontEndReport
    out: Str
    err: Str
    declined: Str
}

// What a build request leaves the daemon's loop with: the reply to send, nothing yet while the
// child it forked runs, or, in that child, the build to run.
type BuildTurn {
    Reply(text: Str)
    Started(child: DaemonChild)
    Child(build: DaemonBuild)
}

// Points fd at an empty file at path, or false when it cannot. write_file makes the file, so
// open needs only O_WRONLY, which is 1 on every host, where O_CREAT and O_TRUNC differ.
fn redirect_to(path: Str, fd: Int) -> Bool ! IO {
    write_file(path, "")
    let mut ok = false
    with ffi.scope() as scope {
        let file = daemon_open(scope.cstr(path), 1.to_i32()).to_int()
        if file >= 0 {
            ok = daemon_dup2(file.to_i32(), fd.to_i32()).to_int() == fd
            if file != fd { unix_socket_close(file) }
        }
    }
    ok
}

// Points stdout and stderr at the files at out_path and err_path; the descriptors they had,
// for restore_output, or -1 for one it could not save.
fn capture_output(out_path: Str, err_path: Str) -> (Int, Int) ! IO {
    // What stdout holds unflushed belongs to the daemon's own output, not to the capture.
    io.write("")
    let saved_out = daemon_dup(1.to_i32()).to_int()
    let saved_err = daemon_dup(2.to_i32()).to_int()
    if saved_out < 0 || saved_err < 0 {
        return (saved_out, saved_err)
    }
    if !redirect_to(out_path, 1) || !redirect_to(err_path, 2) {
        return (-1, saved_err)
    }
    (saved_out, saved_err)
}

// Points stdout and stderr back where capture_output found them; whether both files hold
// all that was printed between the two calls.
fn restore_output(saved: (Int, Int)) -> Bool ! IO {
    io.write("")
    let (saved_out, saved_err) = saved
    let mut ok = saved_out >= 0 && saved_err >= 0
    if saved_out >= 0 {
        ok = daemon_dup2(saved_out.to_i32(), 1.to_i32()).to_int() == 1 && ok
        unix_socket_close(saved_out)
    }
    if saved_err >= 0 {
        ok = daemon_dup2(saved_err.to_i32(), 2.to_i32()).to_int() == 2 && ok
        unix_socket_close(saved_err)
    }
    ok
}

// The code the shell would report for a child that ended with status: its exit code, or 128
// plus the signal that killed it.
fn exit_code_of(status: Int) -> Int {
    let sig = status & 127
    if sig == 0 { (status >> 8) & 255 } else { 128 + sig }
}

// Reaps pid if it ended: the status it ended with, -1 when there is no such child, or -2
// while it runs.
fn reap(pid: Int) -> Int ! IO {
    let mut status = -1
    // WNOHANG is 1 on every host the daemon runs on.
    let options = 1
    with ffi.scope() as scope {
        let cell = scope.alloc[I32]()
        loop {
            let r = daemon_waitpid(pid.to_i32(), cell, options.to_i32()).to_int()
            if r == pid {
                status = cell.deref().to_int()
                break
            }
            if r == 0 {
                status = -2
                break
            }
            // EINTR is 4 on every host the daemon runs on.
            if r > 0 || daemon_errno() != 4 { break }
        }
    }
    status
}

// Sends text and closes the connection. A client that went away takes only its own
// connection with it; the daemon serves on.
fn daemon_reply(client_fd: Int, text: Str) {
    if socket_write(client_fd, text.concat("\n")) < 0 {
        io.eprintln("daemon: could not send the reply, so it dropped the connection")
    }
    unix_socket_close(client_fd)
}

// A build runs the client's command line in a child of the daemon, from the program the
// daemon's last check left, rechecked first when an input changed, so it skips the front end
// a cold build runs. The child's stdout and stderr go to files that the reply carries, with
// the code the child exited with, so the client prints what a cold build would print and
// exits with its code. The daemon builds only where a cold build in the client would read
// the same: the same compiler, environment and front-end settings. The child builds in the
// client's directory with the client's PWD, which the identity leaves out, as each directory
// of a project has its own. Anything else is not served, and the client builds cold. The daemon serves on while the child runs
// and replies to the client once the child ends (daemon_end_child).
fn daemon_handle_build(request: Str, client_fd: Int, builds: DaemonBuilds) -> BuildTurn ! Daemon.Serve, IO, Lex.Tokenize, Parse, Parse.Build, TypeCheck, Diag.Report {
    json_clear()
    let root = json_parse(request)
    let cwd = json_as_str(json_get(root, "cwd"))
    let path = json_as_str(json_get(root, "path"))
    let identity = json_as_str(json_get(root, "identity"))
    let settings = json_as_str(json_get(root, "settings"))
    let pwd = json_as_str(json_get(root, "pwd"))
    let pwd_set = json_as_int(json_get(root, "pwd_set")) == 1
    let argv_node = json_get(root, "argv")
    let mut argv: List[Str] = []
    let mut i = 0
    while i < json_len(argv_node) {
        argv.push(json_as_str(json_at(argv_node, i)))
        i = i + 1
    }
    if identity != daemon_origin.identity || argv.len() < 2 {
        return BuildTurn.Reply(daemon_not_served("the client runs another compiler or environment than the daemon"))
    }
    if settings != daemon_origin.settings {
        return BuildTurn.Reply(daemon_not_served("the client sets what the front end reads otherwise than the daemon"))
    }
    if !daemon_enter(cwd, path) {
        return BuildTurn.Reply(daemon_not_served("the daemon could not change to {cwd}"))
    }
    // The loader exits on a missing entry file, which would take the daemon down with it.
    if file_exists(daemon_source_path) != 1 {
        daemon_last = None
        return BuildTurn.Reply(daemon_not_served("source file not found: {daemon_source_path}"))
    }
    if daemon_last.is_none() || checked_inputs_changed(daemon_source_path) {
        daemon_last = Some(daemon_check_program())
    }
    let c = daemon_last.unwrap()
    if !c.captured {
        return BuildTurn.Reply(daemon_not_served("the daemon could not capture what its check printed"))
    }
    let out_path = path_join(daemon_origin.files, "build-{builds.seq}.out")
    let err_path = path_join(daemon_origin.files, "build-{builds.seq}.err")
    let declined = path_join(daemon_origin.files, "build-{builds.seq}.declined")
    shell_exec("rm -f {declined}")
    // The child inherits what stdout holds unflushed, and would print it again.
    io.write("")
    let pid = daemon_fork().to_int()
    if pid < 0 {
        return BuildTurn.Reply(daemon_not_served("the daemon could not fork a build"))
    }
    if pid == 0 {
        // The child keeps no socket, so each client hears from the daemon alone, and a stop
        // that removes the socket file is the daemon's.
        unix_socket_close(client_fd)
        for h in builds.queue {
            unix_socket_close(h.client_fd)
        }
        for s in builds.stops {
            unix_socket_close(s)
        }
        unix_socket_close(daemon_socket_fd)
        daemon_socket_fd = -1
        daemon_running = 0
        if !redirect_to(out_path, 1) || !redirect_to(err_path, 2) {
            write_file(declined, "")
            exit(1)
        }
        if pwd_set { env.set_var("PWD", pwd) } else { env.remove_var("PWD") }
        return BuildTurn.Child(DaemonBuild { argv: argv, program: c.program, front: c.front, out: c.out, err: c.err, declined: declined })
    }
    BuildTurn.Started(DaemonChild { pid: pid, client_fd: client_fd, out: out_path, err: err_path, declined: declined })
}

// Replies to the client of the build child that ended with status, and removes the child's
// files, whether it built, declined or died.
fn daemon_end_child(child: DaemonChild, status: Int) ! IO {
    let out = read_file(child.out)
    let err = read_file(child.err)
    let declined = file_exists(child.declined) == 1
    shell_exec("rm -f {child.out} {child.err} {child.declined}")
    if status < 0 || declined {
        daemon_reply(child.client_fd, daemon_not_served("the daemon's build did not run"))
        return
    }
    daemon_origin = DaemonOrigin { builds: daemon_origin.builds + 1, ..daemon_origin }
    json_clear()
    let reply = json_new_object()
    json_set(reply, "ok", json_new_bool(1))
    json_set(reply, "served", json_new_int(1))
    json_set(reply, "exit", json_new_int(exit_code_of(status)))
    json_set(reply, "stdout", json_new_str(out))
    json_set(reply, "stderr", json_new_str(err))
    daemon_reply(child.client_fd, json_encode(reply))
}

// Runs a build request with the next number for its files, and leaves a child it forked in
// builds. Returns the reply to send, or in the child the build to run.
fn daemon_start_build(builds: DaemonBuilds, request: Str, client_fd: Int) -> (DaemonBuilds, Option[Str], Option[DaemonBuild]) ! Daemon.Serve, IO, Lex.Tokenize, Parse, Parse.Build, TypeCheck, Diag.Report {
    let mut next = DaemonBuilds { seq: builds.seq + 1, ..builds }
    match daemon_handle_build(request, client_fd, next) {
        Reply(text) => (next, Some(text), None)
        Started(child) => {
            next.child = Some(child)
            (next, None, None)
        }
        Child(build) => (next, None, Some(build))
    }
}

// Once the build child ends: a stop that came meanwhile sends each held build to build cold,
// now that nothing else writes its files, answers the stop and ends the loop; else the oldest
// held build runs. Returns the build to run in a child forked for one.
fn daemon_after_child(builds: DaemonBuilds) -> (DaemonBuilds, Option[DaemonBuild]) ! Daemon.Serve, IO, Lex.Tokenize, Parse, Parse.Build, TypeCheck, Diag.Report {
    let mut b = builds
    if b.stops.len() > 0 {
        for h in b.queue {
            daemon_reply(h.client_fd, daemon_not_served("the daemon is stopping"))
        }
        for s in b.stops {
            let text = daemon_handle_stop()
            // -1 stands for the router, which ended without asking.
            if s >= 0 { daemon_reply(s, text) }
        }
        return (DaemonBuilds { queue: [], stops: [], ..b }, None)
    }
    while b.child.is_none() && b.queue.len() > 0 {
        let h = b.queue.get(0).unwrap()
        b.queue = b.queue.slice(1, b.queue.len())
        let (next, reply, build) = daemon_start_build(b, h.request, h.client_fd)
        b = next
        if build.is_some() {
            return (b, build)
        }
        match reply {
            Some(text) => daemon_reply(h.client_fd, text)
            None => {}
        }
    }
    (b, None)
}

// ── Handle: query ───────────────────────────────────────────────────

fn daemon_handle_query(request: Str) -> Str {
    query_dispatch(request)
}

// ── Handle: status ──────────────────────────────────────────────────

fn daemon_handle_status(builds: DaemonBuilds) -> Str {
    let now = time_ms()
    let uptime = now - daemon_start_time
    let sym_count = si_sym_count
    let file_count = si_file_count
    let checks = daemon_check_count
    let served = daemon_origin.builds
    let building = if builds.child.is_some() { 1 } else { 0 }
    let queued = builds.queue.len()
    let stopping = if builds.stops.len() > 0 { 1 } else { 0 }
    "\{\"ok\":true,\"uptime_ms\":{uptime},\"symbols\":{sym_count},\"files\":{file_count},\"building\":{building},\"queued\":{queued},\"stopping\":{stopping},\"builds\":{served},\"checks\":{checks}}"
}

// ── Handle: stop ────────────────────────────────────────────────────

// The counts go to the router, which adds them to its status once this worker is gone.
fn daemon_handle_stop() -> Str {
    daemon_running = 0
    "\{\"ok\":true,\"message\":\"daemon stopping\",\"builds\":{daemon_origin.builds},\"checks\":{daemon_check_count}}"
}

// ── Event loop ──────────────────────────────────────────────────────

// While no client asks, the daemon rechecks a program whose inputs changed, so the build or
// check after an edit finds the check done. Each time the accept waits out, an unchanged
// program costs a stat of each input and each probed path; only a moved stat or probe costs
// a byte compare. A missed edit costs a recheck at the next request, never a stale answer:
// a check or build compares bytes before it uses the last check.
fn daemon_recheck_if_changed() ! IO, Lex.Tokenize, Parse, Parse.Build, TypeCheck, Diag.Report {
    // The loader exits on a missing entry file, which would take the daemon down with it.
    if daemon_last.is_none() || file_exists(daemon_source_path) != 1 {
        return
    }
    let mut c = daemon_last.unwrap()
    // Taken before the compare, so an edit after it moves a stat for the next poll.
    let stats = daemon_input_stats()
    if stats == c.stats && !checked_probes_changed() {
        return
    }
    if checked_inputs_changed(daemon_source_path) {
        daemon_last = Some(daemon_check_program())
    } else {
        // A touch, or an edit undone: the next poll needs no compare.
        c.stats = stats
        daemon_last = Some(c)
    }
}

// Returns the build to run in a child forked for one, and None in the daemon once it stops.
// While a build child runs, the accept waits 1 ms at most and each turn reaps the child if it
// ended, so the daemon serves other requests meanwhile and its build client waits at most
// that, plus the one request being served then, past the child's end. The runtime has no wait
// on both the socket and the child.
fn daemon_loop() -> Option[DaemonBuild] ! Daemon.Serve, IO, Lex.Tokenize, Parse, Parse.Build, TypeCheck, Diag.Report {
    let mut builds = DaemonBuilds { child: None, queue: [], stops: [], seq: 0 }
    while daemon_running == 1 {
        // A worker whose router is gone serves no one, as no client finds its socket: it ends
        // as on a stop, after its build child, if one runs.
        if daemon_origin.router > 0 && daemon_getppid().to_int() != daemon_origin.router {
            if builds.child.is_none() {
                break
            }
            if builds.stops.len() == 0 {
                builds.stops.push(-1)
            }
        }
        let mut client_fd = -1
        match builds.child {
            Some(child) => {
                let status = reap(child.pid)
                if status != -2 {
                    daemon_end_child(child, status)
                    builds.child = None
                    let (next, build) = daemon_after_child(builds)
                    builds = next
                    if build.is_some() {
                        return build
                    }
                    if daemon_running != 1 {
                        break
                    }
                }
                if builds.child.is_some() {
                    client_fd = unix_socket_accept_timeout(daemon_socket_fd, 1)
                }
            }
            None => {
                client_fd = unix_socket_accept_timeout(daemon_socket_fd, 500)
                if client_fd < 0 {
                    daemon_recheck_if_changed()
                }
            }
        }
        if client_fd < 0 {
            continue
        }

        let request = socket_read_line(client_fd)
        let req_type = daemon_extract_type(request) ?? ""

        let mut response = ""
        let mut held = false
        if req_type == "check" {
            response = daemon_handle_check(request)
        } else if req_type == "build" {
            if builds.child.is_some() {
                builds.queue.push(DaemonHeld { request: request, client_fd: client_fd })
                held = true
            } else {
                let (next, reply, build) = daemon_start_build(builds, request, client_fd)
                builds = next
                if build.is_some() {
                    return build
                }
                match reply {
                    Some(text) => response = text
                    None => held = true
                }
            }
        } else if req_type == "query" {
            response = daemon_handle_query(request)
        } else if req_type == "status" {
            response = daemon_handle_status(builds)
        } else if req_type == "stop" {
            // A killed build would leave its cc and ld writing the files the client's cold
            // build writes next, so the daemon lets the build end first.
            if builds.child.is_some() {
                builds.stops.push(client_fd)
                held = true
            } else {
                response = daemon_handle_stop()
            }
        } else {
            response = "\{\"ok\":false,\"error\":\"unknown request type: {req_type}\"}"
        }

        if !held {
            daemon_reply(client_fd, response)
        }
    }
    None
}

// ── Router ──────────────────────────────────────────────────────────

// A worker the router forked: the entry it serves, keyed by its absolute path, and when a
// client last named it, in requests routed. name is the directory under .blink/ that holds
// its socket and files. The home worker serves the entry the daemon started on, which a
// query reads, so the router never ends it to make room. stop_fd is the connection a stop
// went to the worker on, open until the router reaps it, else -1.
type DaemonEntry {
    name: Str
    key: Str
    pid: Int
    home: Bool
    used: Int
    stop_fd: Int
}

// What a worker the router forks starts on: its name, the entry spelled as the client
// spelled it from its directory, its files, its listening socket, and the router's pid.
type DaemonSpawn {
    name: Str
    cwd: Str
    path: Str
    files: Str
    fd: Int
    router: Int
}

// What the router holds. entries are the workers that serve; ended are those it stopped to
// make room, whose counts it holds in retired_*, until it reaps them. stops are the clients
// of a stop, held until every worker and relay ends, and held the builds that came meanwhile,
// which then go to build cold, once no build of the daemon writes beside them. relays are the
// pids of the relays the router has yet to reap.
type DaemonRoute {
    entries: List[DaemonEntry]
    ended: List[DaemonEntry]
    next: Int
    seq: Int
    max: Int
    home_cwd: Str
    home_path: Str
    retired_checks: Int
    retired_builds: Int
    stops: List[Int]
    held: List[Int]
    relays: List[Int]
}

// What routing a request leaves the router with: the reply to send, the worker to relay the
// request to, or, in a worker it forked, the entry to serve.
type RouteTurn {
    Answer(text: Str)
    Relay(name: Str)
    Serve(spawn: DaemonSpawn)
}

// The entry path as one string for every spelling of it from every directory: absolute, with
// no `.`, `..` or empty parts. Symbolic links are left as named, so a link and its target are
// two entries, each checked on its own.
fn daemon_entry_key(cwd: Str, path: Str) -> Str {
    let full = if path.starts_with("/") { path } else { "{cwd}/{path}" }
    let mut parts: List[Str] = []
    for part in full.split("/") {
        if part == ".." {
            if parts.len() > 0 {
                parts = parts.slice(0, parts.len() - 1)
            }
        } else if part != "" && part != "." {
            parts.push(part)
        }
    }
    "/".concat(parts.join("/"))
}

// Sends request to the worker named name and returns its reply, or "" when none came.
fn daemon_ask_worker(name: Str, request: Str) -> Str {
    let fd = unix_socket_connect(path_join(daemon_dir(), "{name}/daemon.sock"))
    if fd < 0 {
        return ""
    }
    if socket_write(fd, request.concat("\n")) < 0 {
        unix_socket_close(fd)
        return ""
    }
    let reply = socket_read_line(fd)
    unix_socket_close(fd)
    reply
}

// Forks a worker for the entry at key, as path from cwd. Its socket listens before the fork,
// so a client the router sends there waits for the worker's first check rather than finding
// no socket. In the worker, the router's own connections are closed. The worker's directory
// is named for the router's pid too: a worker of a daemon killed before ends only once it sees
// its router is gone, and then removes its directory, which must not be this daemon's.
fn daemon_spawn(route: DaemonRoute, key: Str, cwd: Str, path: Str, home: Bool, client_fd: Int) -> (DaemonRoute, Option[DaemonSpawn], Str) ! IO {
    let mut r = route
    let router = getpid()
    let name = "w{router}-{r.next}"
    r.next = r.next + 1
    let dir = path_join(daemon_dir(), name)
    shell_exec("mkdir -p {dir}")
    let fd = unix_socket_listen(path_join(dir, "daemon.sock"))
    if fd < 0 {
        shell_exec("rm -rf {dir}")
        return (r, None, "the daemon could not make a socket for {path}")
    }
    // The worker inherits what stdout holds unflushed, and would print it again.
    io.write("")
    let pid = daemon_fork().to_int()
    if pid < 0 {
        unix_socket_close(fd)
        shell_exec("rm -rf {dir}")
        return (r, None, "the daemon could not fork a worker for {path}")
    }
    if pid == 0 {
        daemon_close_router_fds(r)
        if client_fd >= 0 { unix_socket_close(client_fd) }
        let files = if dir.starts_with("/") { dir } else { path_join(env.cwd(), dir) }
        return (r, Some(DaemonSpawn { name: name, cwd: cwd, path: path, files: files, fd: fd, router: router }), "")
    }
    unix_socket_close(fd)
    r.entries.push(DaemonEntry { name: name, key: key, pid: pid, home: home, used: r.seq, stop_fd: -1 })
    (r, None, "")
}

// In a child of the router: closes the connections the router holds, so a client or worker
// at the other end sees its close when the router closes it.
fn daemon_close_router_fds(r: DaemonRoute) {
    unix_socket_close(daemon_socket_fd)
    for s in r.stops { unix_socket_close(s) }
    for h in r.held { unix_socket_close(h) }
    for e in r.entries {
        if e.stop_fd >= 0 { unix_socket_close(e.stop_fd) }
    }
    for e in r.ended {
        if e.stop_fd >= 0 { unix_socket_close(e.stop_fd) }
    }
}

// Sends request to the worker named name, and its reply to the client, from a relay the
// router forks, so the router serves on while the worker checks or builds. A relay that gets
// no reply closes the client's connection with none, and the client then checks or builds
// cold.
fn daemon_relay(route: DaemonRoute, name: Str, request: Str, client_fd: Int) -> DaemonRoute ! IO {
    let mut r = route
    let worker_fd = unix_socket_connect(path_join(daemon_dir(), "{name}/daemon.sock"))
    if worker_fd < 0 {
        daemon_reply(client_fd, daemon_not_served("the daemon could not reach the worker of this entry"))
        return r
    }
    // The relay inherits what stdout holds unflushed, and would print it again.
    io.write("")
    let pid = daemon_fork().to_int()
    if pid == 0 {
        daemon_close_router_fds(r)
        let reply = if socket_write(worker_fd, request.concat("\n")) >= 0 { socket_read_line(worker_fd) } else { "" }
        unix_socket_close(worker_fd)
        if reply != "" {
            daemon_reply(client_fd, reply)
        } else {
            unix_socket_close(client_fd)
        }
        // As in a worker, main's epilogue would wait on pool threads that only the router has.
        exit(0)
    }
    unix_socket_close(worker_fd)
    if pid < 0 {
        daemon_reply(client_fd, daemon_not_served("the daemon could not fork a relay"))
        return r
    }
    unix_socket_close(client_fd)
    r.relays.push(pid)
    r
}

// Ends the worker used longest ago, past the home one, while the router holds max of them,
// so the new one makes no more than max. A worker that builds, or holds builds, is passed
// over: its clients wait on it. With none left to end, the router serves one entry more
// than max until one is.
fn daemon_make_room(route: DaemonRoute) -> DaemonRoute ! IO {
    let mut r = route
    let mut passed: List[Str] = []
    while r.entries.len() >= r.max {
        let mut pick = -1
        let mut i = 0
        while i < r.entries.len() {
            let e = r.entries.get(i).unwrap()
            if !e.home && !passed.contains(e.name) {
                if pick < 0 || e.used < r.entries.get(pick).unwrap().used {
                    pick = i
                }
            }
            i = i + 1
        }
        if pick < 0 {
            break
        }
        let e = r.entries.get(pick).unwrap()
        let status = daemon_ask_worker(e.name, "\{\"type\":\"status\"}")
        json_clear()
        let root = json_parse(status)
        if root < 0 || json_as_int(json_get(root, "building")) != 0 || json_as_int(json_get(root, "queued")) != 0 {
            passed.push(e.name)
            continue
        }
        let stopped = daemon_ask_worker(e.name, "\{\"type\":\"stop\"}")
        json_clear()
        let counts = json_parse(stopped)
        if counts >= 0 {
            r.retired_checks = r.retired_checks + json_as_int(json_get(counts, "checks"))
            r.retired_builds = r.retired_builds + json_as_int(json_get(counts, "builds"))
        }
        r.ended.push(e)
        r.entries = r.entries.filter(fn(x) { x.name != e.name })
    }
    r
}

// Sends a check, build or query to the worker of its entry, forked first if none serves it.
// A query reads the symbols of the entry the daemon started on.
fn daemon_route_request(route: DaemonRoute, req_type: Str, request: Str, client_fd: Int) -> (DaemonRoute, RouteTurn) ! IO {
    let mut r = route
    let mut cwd = r.home_cwd
    let mut path = r.home_path
    if req_type != "query" {
        json_clear()
        let root = json_parse(request)
        cwd = json_as_str(json_get(root, "cwd"))
        path = json_as_str(json_get(root, "path"))
    }
    let key = daemon_entry_key(cwd, path)
    r.seq = r.seq + 1
    let mut found = ""
    let mut kept: List[DaemonEntry] = []
    for e in r.entries {
        if e.key == key {
            found = e.name
            kept.push(DaemonEntry { used: r.seq, ..e })
        } else {
            kept.push(e)
        }
    }
    r.entries = kept
    if found != "" {
        return (r, RouteTurn.Relay(found))
    }
    // The loader exits on a missing entry file, which would end the worker on its first check.
    if file_exists(key) != 1 {
        return (r, RouteTurn.Answer(daemon_not_served("source file not found: {path}")))
    }
    let home = key == daemon_entry_key(r.home_cwd, r.home_path)
    if !home {
        r = daemon_make_room(r)
    }
    let (next, spawn, why) = daemon_spawn(r, key, cwd, path, home, client_fd)
    r = next
    match spawn {
        Some(s) => return (r, RouteTurn.Serve(s))
        None => {}
    }
    if why != "" {
        return (r, RouteTurn.Answer(daemon_not_served(why)))
    }
    (r, RouteTurn.Relay(r.entries.get(r.entries.len() - 1).unwrap().name))
}

// The daemon's status: the router's own fields, and the sum of its workers' counts, with the
// symbols and files of the home worker, which a query reads. entries counts the workers that
// serve.
fn daemon_route_status(r: DaemonRoute) -> Str {
    let uptime = time_ms() - daemon_start_time
    let mut symbols = 0
    let mut files = 0
    let mut building = 0
    let mut queued = 0
    let mut served = r.retired_builds
    let mut checks = r.retired_checks
    for e in r.entries {
        let reply = daemon_ask_worker(e.name, "\{\"type\":\"status\"}")
        json_clear()
        let root = json_parse(reply)
        if root >= 0 {
            building = building + json_as_int(json_get(root, "building"))
            queued = queued + json_as_int(json_get(root, "queued"))
            served = served + json_as_int(json_get(root, "builds"))
            checks = checks + json_as_int(json_get(root, "checks"))
            if e.home {
                symbols = json_as_int(json_get(root, "symbols"))
                files = json_as_int(json_get(root, "files"))
            }
        }
    }
    let stopping = if r.stops.len() > 0 { 1 } else { 0 }
    let entries = r.entries.len()
    "\{\"ok\":true,\"uptime_ms\":{uptime},\"symbols\":{symbols},\"files\":{files},\"building\":{building},\"queued\":{queued},\"stopping\":{stopping},\"entries\":{entries},\"builds\":{served},\"checks\":{checks}}"
}

// Reaps each worker that ended, and removes its files, and each relay that ended.
fn daemon_reap_workers(route: DaemonRoute) -> DaemonRoute ! IO {
    let mut r = route
    let mut live: List[DaemonEntry] = []
    for e in r.entries {
        if reap(e.pid) == -2 {
            live.push(e)
        } else {
            daemon_forget_worker(e)
        }
    }
    r.entries = live
    let mut ending: List[DaemonEntry] = []
    for e in r.ended {
        if reap(e.pid) == -2 {
            ending.push(e)
        } else {
            daemon_forget_worker(e)
        }
    }
    r.ended = ending
    let mut relaying: List[Int] = []
    for p in r.relays {
        if reap(p) == -2 {
            relaying.push(p)
        }
    }
    r.relays = relaying
    r
}

fn daemon_forget_worker(e: DaemonEntry) ! IO {
    if e.stop_fd >= 0 {
        unix_socket_close(e.stop_fd)
    }
    shell_exec("rm -rf {path_join(daemon_dir(), e.name)}")
}

// Sends each worker a stop. A worker ends at once, or once its build child does. The router
// replies to the stop once it has reaped them all.
fn daemon_route_stop(route: DaemonRoute, client_fd: Int) -> DaemonRoute {
    let mut r = route
    r.stops.push(client_fd)
    let mut sent: List[DaemonEntry] = []
    for e in r.entries {
        if e.stop_fd >= 0 {
            sent.push(e)
            continue
        }
        let fd = unix_socket_connect(path_join(daemon_dir(), "{e.name}/daemon.sock"))
        if fd >= 0 && socket_write(fd, "\{\"type\":\"stop\"}\n") < 0 {
            unix_socket_close(fd)
            sent.push(e)
            continue
        }
        sent.push(DaemonEntry { stop_fd: fd, ..e })
    }
    r.entries = sent
    r
}

// Returns, in a worker it forked, the entry to serve, and None in the router once it stops.
// While a stop waits on its workers and relays, or a worker it ended has yet to be reaped,
// the accept waits 1 ms at most, so the stop ends as soon as the last of them does.
fn daemon_route(max: Int) -> Option[DaemonSpawn] ! IO {
    let mut r = DaemonRoute { entries: [], ended: [], next: 1, seq: 0, max: max, home_cwd: daemon_origin.cwd, home_path: daemon_source_path, retired_checks: 0, retired_builds: 0, stops: [], held: [], relays: [] }
    // The home worker checks the entry at once, so the first request finds it checked.
    let home_key = daemon_entry_key(r.home_cwd, r.home_path)
    let (first, home, why) = daemon_spawn(r, home_key, r.home_cwd, r.home_path, true, -1)
    r = first
    if home.is_some() {
        return home
    }
    if why != "" {
        io.eprintln("daemon: {why}")
    }
    while daemon_running == 1 {
        r = daemon_reap_workers(r)
        if r.stops.len() > 0 && r.entries.len() == 0 && r.ended.len() == 0 && r.relays.len() == 0 {
            for h in r.held {
                daemon_reply(h, daemon_not_served("the daemon is stopping"))
            }
            for s in r.stops {
                daemon_reply(s, "\{\"ok\":true,\"message\":\"daemon stopping\"}")
            }
            break
        }
        let wait = if r.stops.len() > 0 || r.ended.len() > 0 { 1 } else { 500 }
        let client_fd = unix_socket_accept_timeout(daemon_socket_fd, wait)
        if client_fd < 0 {
            continue
        }
        let request = socket_read_line(client_fd)
        let req_type = daemon_extract_type(request) ?? ""
        if req_type == "check" || req_type == "build" || req_type == "query" {
            if r.stops.len() > 0 {
                if req_type == "build" {
                    r.held.push(client_fd)
                } else {
                    daemon_reply(client_fd, daemon_not_served("the daemon is stopping"))
                }
                continue
            }
            let (next, turn) = daemon_route_request(r, req_type, request, client_fd)
            r = next
            match turn {
                Serve(s) => return Some(s)
                Relay(name) => r = daemon_relay(r, name, request, client_fd)
                Answer(text) => daemon_reply(client_fd, text)
            }
        } else if req_type == "status" {
            daemon_reply(client_fd, daemon_route_status(r))
        } else if req_type == "stop" {
            r = daemon_route_stop(r, client_fd)
        } else {
            daemon_reply(client_fd, "\{\"ok\":false,\"error\":\"unknown request type: {req_type}\"}")
        }
    }
    None
}

// Serves the entry a worker was forked for until a stop, then removes its files and ends the
// worker. In a child forked for a build it returns the build instead.
fn daemon_serve(s: DaemonSpawn) -> Option[DaemonBuild] ! Daemon.Serve, IO, Lex.Tokenize, Parse, Parse.Build, TypeCheck, Diag.Report {
    daemon_socket_fd = s.fd
    daemon_origin = DaemonOrigin { router: s.router, files: s.files, ..daemon_origin }
    // The router's files are the router's to remove.
    daemon_pid_path = ""
    daemon_sock_path = ""
    if daemon_enter(s.cwd, s.path) && file_exists(daemon_source_path) == 1 {
        daemon_last = Some(daemon_check_program())
    }
    daemon_running = 1
    let build = daemon_loop()
    if build.is_some() {
        return build
    }
    daemon_stop()
    shell_exec("rm -rf {daemon_origin.files}")
    // The end of main joins the threads of the process's pool, which the router started and
    // the fork did not copy, so a return from main would wait on them forever.
    exit(0)
    None
}

// ── Shutdown ────────────────────────────────────────────────────────

fn daemon_stop() ! Daemon.Serve {
    if daemon_socket_fd >= 0 {
        unix_socket_close(daemon_socket_fd)
        daemon_socket_fd = -1
    }
    if daemon_pid_path != "" {
        shell_exec("rm -f {daemon_pid_path}")
    }
    if daemon_sock_path != "" {
        shell_exec("rm -f {daemon_sock_path}")
    }
    si_reset()
    checked_inputs_reset()
    daemon_last = None
    daemon_running = 0
}

// ── Socket location ─────────────────────────────────────────────────

// A project has one daemon. It keeps its socket and pid file in .blink/ at the project root:
// the nearest directory at or above the cwd that holds blink.toml, else the cwd. Every daemon
// subcommand and client asks this one function, so they agree on whether a daemon runs. The
// path stays relative to the cwd, since bind refuses a socket path over 107 bytes.
fn daemon_dir() -> Str {
    let mut abs = env.cwd()
    let mut rel = ""
    while file_exists(path_join(rel, "blink.toml")) != 1 {
        let up = path_dirname(abs)
        if up == abs {
            return ".blink"
        }
        abs = up
        rel = path_join(rel, "..")
    }
    path_join(rel, ".blink")
}

pub fn daemon_socket_path() -> Str {
    path_join(daemon_dir(), "daemon.sock")
}

// ── Startup ─────────────────────────────────────────────────────────

// Serves until a stop, then returns None. In a child forked for a build it returns the build
// instead, for the caller to run. identity names the compiler and the environment, and
// settings what the front end reads, which a client must share for the daemon to build for it.
// max_entries is how many entry files the daemon keeps checked at once, each in a worker.
pub fn daemon_start(source: Str, identity: Str, settings: Str, interface_text: Bool, max_entries: Int) -> Option[DaemonBuild] ! Daemon.Serve, IO, Lex.Tokenize, Parse, Parse.Build, TypeCheck, Diag.Report {
    daemon_source_path = source
    daemon_origin = DaemonOrigin { cwd: env.cwd(), identity: identity, settings: settings, interface_text: interface_text, builds: 0, router: 0, files: "" }
    daemon_start_time = time_ms()

    let blink_dir = daemon_dir()
    shell_exec("mkdir -p {blink_dir}")

    // Write PID file
    daemon_pid_path = path_join(blink_dir, "daemon.pid")
    let pid = getpid()
    write_file(daemon_pid_path, "{pid}")

    // Create Unix socket
    daemon_sock_path = daemon_socket_path()
    daemon_socket_fd = unix_socket_listen(daemon_sock_path)
    if daemon_socket_fd < 0 {
        io.eprintln("daemon: failed to create socket at {daemon_sock_path}")
        return None
    }

    io.eprintln("daemon: listening on {daemon_sock_path} (pid {pid})")
    daemon_running = 1
    match daemon_route(max_entries) {
        Some(spawn) => daemon_serve(spawn)
        None => {
            daemon_stop()
            None
        }
    }
}
