// The repair that *Repairs at a suppression site* gives for a live name, else "".
pub fn diag_catalog_repair(name: Str) -> Str {
    match name {
        "ContractUnverifiable" => "change `@verify(fallback: ...)`"
        "CapabilityBudgetExceeded" => "widen `@capabilities`"
        _ => ""
    }
}
