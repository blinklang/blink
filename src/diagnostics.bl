pub const WITH_PTR_BODY_TOO_COMPLEX = "E0816"
pub const BYTES_PTR_CAST_FORBIDDEN = "E0817"
pub const FFI_SCOPE_NOT_WITH_RESOURCE = "E0819"
pub const MISSING_NATIVE_DEP       = "E0820"
pub const NATIVE_DEP_UNAVAILABLE_CROSS = "E0821"
pub const FFI_OFFSET_UNKNOWN_STRIDE = "E0822"

// E0823+ — unwind / cleanup
pub const CLEANUP_PANICKED_DURING_UNWIND = "E0824"

// E0827, E0831-E0834 — test runner diagnostics (br cbk2wq)
// E0827 is the sole live code for "skip() called outside a test"; it is
// emitted at the typecheck site via the §2.20 test-only symbol fence
// (is_test_only_symbol / tc_fence_test_only_symbol in src/typecheck.bl).
pub const SKIP_OUTSIDE_TEST                = "E0827"
// E0831-E0834 reserved for assert_panics; assert_panics is not yet
// implemented in the parser/typecheck/stdlib (see decisions/std-testing-user-api.md Q4),
// so these consts are catalog-only until the feature lands.
pub const ASSERT_PANICS_BODY_RETURNED      = "E0831"
pub const ASSERT_PANICS_MESSAGE_MISMATCH   = "E0832"
pub const ASSERT_PANICS_OUTSIDE_TEST       = "E0833"
pub const ASSERT_PANICS_NESTED_EXPECT_PANIC = "E0834"
pub const XFAIL_MISSING_REASON              = "E0835"

// E0840+ — toolchain / link integrity
// Guards the ABI-skew class of bug where a stdlib archive that is stale
// relative to the linking compiler is silently linked into a user binary,
// producing a memory-corrupting executable (br 105z02). The installed
// archive carries a `.archive-id` stamp (runtime.h SHA | libblink_std.h SHA |
// blinkc SHA | version); do_link_target verifies both header SHAs before
// producing a binary.
pub const INCOMPATIBLE_STDLIB_ARCHIVE = "E0840"

// E0900–E0906 — trait contract (one short-name spans 7 codes)
pub const TRAIT_CONTRACT_900 = "E0900"
pub const TRAIT_CONTRACT_901 = "E0901"
pub const TRAIT_CONTRACT_902 = "E0902"
pub const TRAIT_CONTRACT_903 = "E0903"
pub const TRAIT_CONTRACT_904 = "E0904"
pub const TRAIT_CONTRACT_905 = "E0905"
