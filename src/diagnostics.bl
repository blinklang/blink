// W0xxx — warnings
pub const RAW_BYPASSES_PARAM      = "W0310"
pub const UNKNOWN_METHOD          = "W0501"
pub const INCOMPLETE_STATE_RESTORE = "W0550"
pub const UNRESTORED_MUTATION     = "W0551"
pub const UNUSED_VARIABLE         = "W0600"
pub const SET_BUT_NOT_READ        = "W0601"
pub const UNUSED_IMPORT           = "W0602"
pub const SHADOWED_VARIABLE       = "W0603"
pub const UNREACHABLE_CODE        = "W0700"
pub const ARENA_EFFECT_REDUNDANT  = "W0701"
pub const BITWISE_PRECEDENCE      = "W0702"
pub const UNAUDITED_FFI           = "W0800"
pub const MISSING_CANONICAL_HEADER = "W0812"
pub const DEPRECATED_USAGE        = "W2000"

// I0000+ — internal compiler errors (ICE). Unsuppressable (bypass lint
// overrides in diag_emit_range_notes). An ICE means a compiler invariant was
// violated — it should be unreachable from valid user input; if one fires, it
// is a compiler bug, never the user's fault.
// I0001: an unsolved metavariable / typevar reached a codegen chokepoint that
// must have a concrete type. The type-inference boundary check (E0301) is meant
// to catch every under-determined binding first, so this firing means a metavar
// escaped that net. Fails closed (never silently emits "Void").
pub const UNSOLVED_TYPEVAR_AT_CODEGEN = "I0001"
// I0002: a for-in target's runtime CT reached emit_for_in with no arm to handle it.
// The ForIn typecheck seam (NodeKind.ForIn, tc_check_node) rejects every non-iterable
// type before codegen runs, so this firing means the iterable IS one of the spec's
// built-in IntoIterator kinds (or the Channel receive extension) but codegen has not
// been armed for it yet — a missing-implementation bug, never the user's fault.
pub const UNHANDLED_ITERABLE_AT_CODEGEN = "I0002"
// I0003: a Map-shaped compound tag reached register_var_compound_from_tag's scope
// registration. tc_tid_to_c_tag spells TyKind.Map as the bare string "Map" (never
// "Map_k_v"), so this should be unreachable; if it fires, some producer started
// spelling Map structurally and the K/V-unaware carrier decode there would
// otherwise silently misregister CT_MAP with unset K/V.
pub const MAP_TAG_REACHED_CARRIER_SCOPE = "I0003"

// ── I0001 mangler sentinels ──────────────────────────────
//
// A type-name speller (tc_tid_to_c_tag, type_name_from_ct, …) has no node to anchor a
// diagnostic to and no `! Diag.Report` in its signature, so it cannot raise I0001 itself.
// Instead it returns one of these sentinels, and the LOCATED I0001 is raised downstream, at
// the two chokepoints that do have a node —
// mono_args_has_void_seg (src/codegen_expr.bl) and resolve_mono_slot
// (src/codegen_stmt.bl) — both of which detect a sentinel via diag_is_ice_seg.
//
// DO NOT rely on these failing closed if they escape a chokepoint.
// BLINK_I0001_erased_slot is a perfectly legal C identifier. Loudness is POSITION-DEPENDENT:
// as a field TYPE it is a hard cc error ("unknown type name"), but inside a mangled SYMBOL
// name it would compile and link silently — the way a collapsed symbol like
// blink_GKV_Void_Void would. The chokepoints are the guarantee; the spelling is only a
// greppable marker. Whether a chokepoint-free path to a mangled name exists is not
// established; until it is, treat an escaped sentinel as potentially silent.
//
// WHY THESE EXIST AT ALL: without this split, all four conditions below, plus a GENUINE
// Void, would spell the single string "Void". The two chokepoints would then have to
// string-key on "Void", which DECISIONS.md:342 (6-0) forbids — the tripwire "must key on
// the *kind*, not the resulting \"Void\" tag, so a genuine GKV[Void,Void] is unaffected".
// Without the split a genuine Box[Void] would raise I0001 too. Splitting the sentinels off
// leaves "Void" meaning ONLY genuine Void (decisions/under-determined-types.md:38-42 —
// Void is "an ordinary INHABITED, encodable type").
//
// NOT YET armed: the LOWERCASE twin "void" carries the same
// triple meaning in tc_tid_tag_at's TAGPOS_TOP and TAGPOS_INNER arms (the merged home of
// the former tc_tid_scalar_tag / tc_tid_inner_tag). Result[Void, Str] must still spell
// Result_void_str, matched at src/codegen_types.bl — but that string comes from the
// TAGPOS_TOP arm's explicit TyKind.Void case, not its unhandled-kind fall-through, so the
// fall-through (and the out-of-range guard) CAN be armed to these same sentinels without
// touching Result_void_str. See the comment on tc_tid_tag_at's TyKind.Void arm for the trace,
// and the "Collapse, never interpolate" comment on its TyKind.Option arm for the
// collapse-not-interpolate rule these arms must also follow.

// An unsolved metavariable / typevar (TyKind.Unknown) reached a speller. Bytes unchanged from
// the literal this const replaced, so every emitted symbol is byte-identical.
pub const ICE_SEG_UNSOLVED_TYPEVAR = "BLINK_I0001_unsolved_typevar_at_codegen"
// A tid whose kind has no arm in the speller (TyKind.Fn, any future kind). Was
// indistinguishable from a genuine Void.
pub const ICE_SEG_UNHANDLED_KIND = "BLINK_I0001_unhandled_kind"
// A negative or out-of-pool tid reached a speller. Was indistinguishable from a genuine Void.
pub const ICE_SEG_TID_OUT_OF_RANGE = "BLINK_I0001_tid_out_of_range"
// ERASURE: a type-arg slot that no producer could name. The string producers' old "Void"
// fallback — the spelling that made blink_GKV_Void_Void a valid C identifier which compiled
// and linked while collapsing sibling instantiations onto one typedef.
pub const ICE_SEG_ERASED_SLOT = "BLINK_I0001_erased_slot"

// Whether a spelled type-name segment is one of the I0001 sentinels above — i.e. a
// speller gave up. The two I0001 chokepoints use this instead of comparing against
// "Void".
//
// This is a STRING test inside a change that is otherwise about kind-keying, which looks
// like a contradiction. It is not: BLINK_I0001_ is a mangler-INTERNAL prefix that no producer
// writes for any other purpose, whereas "Void" is a real type's real name — that is the whole
// difference. Do not read this as a precedent for string-keying a diagnostic on a type NAME;
// this predicate deliberately does not do that.
//
// NOT "unspoofable". `type BLINK_I0001_erased_slot {}` is legal Blink, and a user type by
// that name would make this predicate fire on a legitimate segment. Nobody writes that by
// accident, so it is not worth defending against — but do not build anything on top of a
// guarantee that is not there. To make it real the prefix would have to contain a
// character no Blink identifier can hold.
pub fn diag_is_ice_seg(seg: Str) -> Bool {
    seg.starts_with("BLINK_I0001_")
}

// ── Diagnostic struct ────────────────────────────────────────────────

pub type DiagEntry {
    severity: Str
    name: Str
    code: Str
    message: Str
    file: Str
    line: Int
    col: Int
    help: Str
    end_line: Int
    end_col: Int
    fix_action: Str
    fix_text: Str
    notes: List[Str]
}

type FileRange {
    start: Int
    end: Int
    path: Str
}

pub let mut diag_entries: List[DiagEntry] = []
let mut file_ranges: List[FileRange] = []
let mut source_lines_cache: Map[Str, List[Str]] = Map()
// q21fh2: dedup byte-identical diagnostics. The two full passes over a fn body
// (nr + tc) both call infer_type, which emits, so a single erroring node fires
// twice. Keyed on the full tuple (severity|code|file|line|col|message) so
// genuinely distinct diagnostics on the same node survive. Reset per compile in
// diag_reset.
let mut diag_seen: Map[Str, Int] = Map()

// ── Configuration ────────────────────────────────────────────────────

pub let mut diag_format: Int = 0       // 0=human, 1=json
pub let mut diag_source_file: Str = ""
pub let mut diag_count: Int = 0
pub let mut diag_warn_count: Int = 0
pub let mut diag_ice_count: Int = 0
pub let mut diag_module_files: Map[Str, Str] = Map()

pub fn diag_register_file_range(start: Int, end: Int, path: Str) {
    file_ranges.push(FileRange { start: start, end: end, path: path })
}

// ── Lint severity overrides from [lints] in blink.toml ───────────────
let mut lint_overrides: Map[Str, Str] = Map()

// ── Per-function @allow suppression set ─────────────────────────────
let mut diag_allow_set: Map[Str, Int] = Map()

pub fn diag_push_allows(fn_node: Int) {
    let allow_ann = get_annotation(fn_node, "allow")
    if allow_ann == -1 {
        return
    }
    let args_sl = node_args(allow_ann)
    if args_sl == -1 {
        return
    }
    let mut i = 0
    while i < sublist_length(args_sl) {
        let arg_name = node_name(sublist_get(args_sl, i))
        diag_allow_set.insert(arg_name, 1)
        i = i + 1
    }
}

pub fn diag_clear_allows() {
    diag_allow_set = Map()
}

// ── Lint override helpers ────────────────────────────────────────────

pub fn lint_set_override(name: Str, level: Str) {
    lint_overrides.insert(name, level)
}

fn lint_apply_override(severity: Str, name: Str, code: Str) -> Str {
    if diag_allow_set.contains_key(name) != 0 {
        return "off"
    }
    // [lints] keys may be PascalCase names or W-codes (spec §4.16.8).
    let mut level = lint_overrides.get(name) ?? ""
    if level == "" {
        level = lint_overrides.get(code) ?? ""
    }
    if level == "" {
        return severity
    }
    if level == "off" {
        return "off"
    }
    if level == "error" && severity == "warning" {
        return "error"
    }
    if level == "warn" && severity == "error" {
        return "warning"
    }
    severity
}

pub fn embedded_inner_key(path: Str) -> Str {
    path.substring(10, path.len() - 11)
}

pub fn diag_normalize_path(path: Str) -> Str {
    let idx = path.index_of("lib/std/")
    if idx > 0 {
        return path.substring(idx, path.len() - idx)
    }
    let idx2 = path.index_of("lib/pkg/")
    if idx2 > 0 {
        return path.substring(idx2, path.len() - idx2)
    }
    if path.starts_with("<embedded:") && path.ends_with(">") {
        return "lib/{embedded_inner_key(path)}.bl"
    }
    path
}

// ── Emit helpers ─────────────────────────────────────────────────────

fn diag_emit(severity: Str, name: Str, code: Str, message: Str, line: Int, col: Int, help: Str) ! Diag.Report {
    diag_emit_range(severity, name, code, message, line, col, 0, 0, help)
}

pub fn diag_set_last_fix(action: Str, text: Str) {
    let idx = diag_entries.len() - 1
    if idx >= 0 {
        let d = diag_entries.get(idx).unwrap()
        diag_entries.set(idx, DiagEntry {
            severity: d.severity, name: d.name, code: d.code,
            message: d.message, file: d.file, line: d.line,
            col: d.col, help: d.help, end_line: d.end_line,
            end_col: d.end_col, fix_action: action, fix_text: text,
            notes: d.notes
        })
    }
}

pub fn diag_entry_count() -> Int {
    diag_entries.len()
}

// Roll back every diagnostic emitted after the first `n` entries. Used by
// the parser to collapse an error cascade (e.g. an unparseable string
// interpolation) into a single focused diagnostic.
pub fn diag_truncate(n: Int) {
    while diag_entries.len() > n {
        let d = diag_entries.pop().unwrap()
        // q21fh2: drop the dedup key too, so diag_seen mirrors diag_entries —
        // a popped cascade entry must not suppress a later distinct re-emission.
        let dkey = "{d.severity}|{d.code}|{d.file}|{d.line}|{d.col}|{d.message}"
        diag_seen.remove(dkey)
        if d.severity == "error" {
            diag_count = diag_count - 1
        } else if d.severity == "warning" {
            diag_warn_count = diag_warn_count - 1
        } else if d.severity == "ice" {
            diag_ice_count = diag_ice_count - 1
        }
    }
}

pub fn diag_error(name: Str, code: Str, message: Str, line: Int, col: Int, help: Str) ! Diag.Report {
    diag_emit("error", name, code, message, line, col, help)
}

pub fn diag_error_range(name: Str, code: Str, message: Str, line: Int, col: Int, end_col: Int, help: Str) ! Diag.Report {
    diag_emit_range("error", name, code, message, line, col, 0, end_col, help)
}

pub fn diag_error_no_loc(name: Str, code: Str, message: Str, help: Str) ! Diag.Report {
    diag_emit("error", name, code, message, 0, 0, help)
}

pub fn diag_file_for_node(node_id: Int) -> Str {
    let mod_name = node_module(node_id)
    if mod_name != "" {
        let f = diag_module_files.get(mod_name) ?? ""
        if f != "" {
            return f
        }
    }
    let mut ri = 0
    while ri < file_ranges.len() {
        let fr = file_ranges.get(ri).unwrap()
        if node_id >= fr.start && node_id < fr.end {
            return fr.path
        }
        ri = ri + 1
    }
    diag_source_file
}

@allow(UnrestoredMutation, IncompleteStateRestore)
pub fn diag_error_at(name: Str, code: Str, message: Str, node_id: Int, help: Str) ! Diag.Report {
    let line = node_line(node_id)
    let col = node_col(node_id)
    let saved_file = diag_source_file
    diag_source_file = diag_file_for_node(node_id)
    diag_emit("error", name, code, message, line, col, help)
    diag_source_file = saved_file
}

fn diag_warn(name: Str, code: Str, message: Str, line: Int, col: Int, help: Str) ! Diag.Report {
    diag_emit("warning", name, code, message, line, col, help)
}

fn diag_warn_no_loc(name: Str, code: Str, message: Str, help: Str) ! Diag.Report {
    diag_emit("warning", name, code, message, 0, 0, help)
}

@allow(UnrestoredMutation, IncompleteStateRestore)
pub fn diag_warn_at(name: Str, code: Str, message: Str, node_id: Int, help: Str) ! Diag.Report {
    let line = node_line(node_id)
    let col = node_col(node_id)
    let saved_file = diag_source_file
    diag_source_file = diag_file_for_node(node_id)
    diag_emit("warning", name, code, message, line, col, help)
    diag_source_file = saved_file
}

@allow(UnrestoredMutation, IncompleteStateRestore)
pub fn diag_warn_at_notes(name: Str, code: Str, message: Str, node_id: Int, help: Str, notes: List[Str]) ! Diag.Report {
    let line = node_line(node_id)
    let col = node_col(node_id)
    let saved_file = diag_source_file
    diag_source_file = diag_file_for_node(node_id)
    diag_emit_range_notes("warning", name, code, message, line, col, 0, 0, help, notes)
    diag_source_file = saved_file
}

// Error with secondary blame span(s) carried in `notes`: the primary caret sits
// at `node_id` (the binding), and each note points the reader at a
// contributing sub-expression (e.g. the empty `Map()` whose element is open).
@allow(UnrestoredMutation, IncompleteStateRestore)
pub fn diag_error_at_notes(name: Str, code: Str, message: Str, node_id: Int, help: Str, notes: List[Str]) ! Diag.Report {
    let line = node_line(node_id)
    let col = node_col(node_id)
    let saved_file = diag_source_file
    diag_source_file = diag_file_for_node(node_id)
    diag_emit_range_notes("error", name, code, message, line, col, 0, 0, help, notes)
    diag_source_file = saved_file
}

pub fn diag_ice(name: Str, code: Str, message: Str, line: Int, col: Int, help: Str) ! Diag.Report {
    diag_emit("ice", name, code, message, line, col, help)
}

pub fn diag_ice_no_loc(name: Str, code: Str, message: Str, help: Str) ! Diag.Report {
    diag_emit("ice", name, code, message, 0, 0, help)
}

@allow(UnrestoredMutation, IncompleteStateRestore)
pub fn diag_ice_at(name: Str, code: Str, message: Str, node_id: Int, help: Str) ! Diag.Report {
    let line = node_line(node_id)
    let col = node_col(node_id)
    let saved_file = diag_source_file
    diag_source_file = diag_file_for_node(node_id)
    diag_emit("ice", name, code, message, line, col, help)
    diag_source_file = saved_file
}

fn diag_emit_range(severity: Str, name: Str, code: Str, message: Str, line: Int, col: Int, end_line: Int, end_col: Int, help: Str) ! Diag.Report {
    diag_emit_range_notes(severity, name, code, message, line, col, end_line, end_col, help, [])
}

fn diag_emit_range_notes(severity: Str, name: Str, code: Str, message: Str, line: Int, col: Int, end_line: Int, end_col: Int, help: Str, notes: List[Str]) ! Diag.Report {
    let effective_severity = if severity == "ice" { severity } else { lint_apply_override(severity, name, code) }
    if effective_severity == "off" {
        return
    }
    let dkey = "{effective_severity}|{code}|{diag_source_file}|{line}|{col}|{message}"
    if diag_seen.contains_key(dkey) != 0 {
        return
    }
    diag_seen.insert(dkey, 1)
    diag_entries.push(DiagEntry {
        severity: effective_severity, name: name, code: code,
        message: message, file: diag_source_file, line: line,
        col: col, help: help, end_line: end_line, end_col: end_col,
        fix_action: "", fix_text: "", notes: notes
    })
    if effective_severity == "error" {
        diag_count = diag_count + 1
    } else if effective_severity == "warning" {
        diag_warn_count = diag_warn_count + 1
    } else if effective_severity == "ice" {
        diag_ice_count = diag_ice_count + 1
    }
}

// ── JSON string escaping ─────────────────────────────────────────────

pub fn json_escape(s: Str) -> Str {
    let mut sb = StringBuilder.new()
    let mut i = 0
    while i < s.len() {
        let ch = s.byte_at(i)
        if ch == 92 {
            sb.write("\\\\")
        } else if ch == 34 {
            sb.write("\\\"")
        } else if ch == 10 {
            sb.write("\\n")
        } else if ch == 13 {
            sb.write("\\r")
        } else if ch == 9 {
            sb.write("\\t")
        } else {
            sb.write(s.substring(i, 1))
        }
        i = i + 1
    }
    sb.to_str()
}

// ── Flush: emit all diagnostics ──────────────────────────────────────

pub fn diag_flush() ! Diag.Report {
    let mut i = 0
    while i < diag_entries.len() {
        if diag_format == 1 {
            diag_print_json(i)
        } else {
            diag_print_human(i)
        }
        i = i + 1
    }
    if diag_format == 1 {
        // no summary in json mode
    } else {
        if diag_ice_count > 0 {
            io.eprintln("{diag_ice_count} internal compiler error(s)")
        }
        if diag_count > 0 {
            io.eprintln("{diag_count} error(s) found")
        }
    }
}

fn diag_print_json(idx: Int) ! Diag.Report {
    let d = diag_entries.get(idx).unwrap()
    let sev = json_escape(d.severity)
    let name = json_escape(d.name)
    let code = json_escape(d.code)
    let msg = json_escape(d.message)
    let file = json_escape(d.file)
    let line = d.line
    let col = d.col
    let help = d.help
    let el = d.end_line
    let ec = d.end_col
    let mut span = "\"span\":\{\"file\":\"{file}\",\"line\":{line},\"col\":{col}"
    if el > 0 {
        span = span.concat(",\"end_line\":{el},\"end_col\":{ec}")
    }
    span = span.concat("}")
    let mut json = "\{\"severity\":\"{sev}\",\"name\":\"{name}\",\"code\":\"{code}\",\"message\":\"{msg}\",{span}"
    if help != "" {
        json = json.concat(",\"help\":\"").concat(json_escape(help)).concat("\"")
    }
    if d.notes.len() > 0 {
        json = json.concat(",\"notes\":[")
        let mut ni = 0
        while ni < d.notes.len() {
            if ni > 0 { json = json.concat(",") }
            json = json.concat("\"").concat(json_escape(d.notes.get(ni).unwrap())).concat("\"")
            ni = ni + 1
        }
        json = json.concat("]")
    }
    let fix_act = d.fix_action
    if fix_act != "" {
        let fix_txt = json_escape(d.fix_text)
        json = json.concat(",\"fix\":\{\"action\":\"{fix_act}\",\"text\":\"{fix_txt}\"}")
    }
    json = json.concat("}")
    io.eprintln(json)
}

fn source_get_line(file: Str, line: Int) -> Str {
    if file == "" {
        return ""
    }
    if source_lines_cache.contains_key(file) == false {
        if file_exists(file) == 0 {
            return ""
        }
        source_lines_cache.insert(file, read_file(file).split("\n"))
    }
    let lines = source_lines_cache.get(file).unwrap()
    let idx = line - 1
    if idx < 0 || idx >= lines.len() {
        return ""
    }
    lines.get(idx).unwrap()
}

fn str_repeat(s: Str, n: Int) -> Str {
    let mut result = ""
    let mut i = 0
    while i < n {
        result = result.concat(s)
        i = i + 1
    }
    result
}

fn int_digit_count(n: Int) -> Int {
    if n < 10 { return 1 }
    if n < 100 { return 2 }
    if n < 1000 { return 3 }
    if n < 10000 { return 4 }
    5
}

fn diag_print_human(idx: Int) ! Diag.Report {
    let d = diag_entries.get(idx).unwrap()
    let display_severity = if d.severity == "ice" { "internal compiler error" } else { d.severity }
    io.eprintln("{display_severity}[{d.name}]: {d.message}")
    if d.line > 0 {
        io.eprintln("  --> {d.file}:{d.line}:{d.col}")
        let src_line = source_get_line(d.file, d.line)
        if src_line != "" {
            let gutter_w = int_digit_count(d.line) + 1
            let gutter_pad = str_repeat(" ", gutter_w)
            io.eprintln("{gutter_pad}|")
            io.eprintln("{d.line} | {src_line}")
            let caret_len = if d.end_col > d.col { d.end_col - d.col } else { 1 }
            let caret_col = if d.col > 1 { d.col - 1 } else { 0 }
            let caret_pad = str_repeat(" ", caret_col)
            io.eprintln("{gutter_pad}| {caret_pad}{str_repeat("^", caret_len)}")
        }
    }
    let mut ni = 0
    while ni < d.notes.len() {
        io.eprintln("  note: {d.notes.get(ni).unwrap()}")
        ni = ni + 1
    }
    if d.severity == "ice" {
        if d.help != "" {
            io.eprintln("  help: {d.help}")
        }
        io.eprintln("  note: This is a compiler bug. Please report it at https://github.com/blinklang/blink/issues")
    } else if d.help != "" {
        io.eprintln("  help: {d.help}")
    }
    if d.fix_action != "" {
        io.eprintln("  fix: {d.fix_action} '{d.fix_text}'")
    }
}

// ── Reset ────────────────────────────────────────────────────────────

pub fn diag_reset() {
    diag_entries.clear()
    diag_count = 0
    diag_warn_count = 0
    diag_ice_count = 0
    diag_module_files.clear()
    file_ranges.clear()
    lint_overrides.clear()
    diag_allow_set.clear()
    source_lines_cache.clear()
    diag_seen.clear()
}

// ── Error catalog ─────────────────────────────────────────────────

pub fn diag_explain(code: Str) -> Str {
    if code == NON_EXHAUSTIVE_MATCH {
        return "E0004 -- NonExhaustiveMatch\n\nEvery `match` must cover all possible values of its scrutinee. This\none leaves at least one enum variant unhandled, and the compiler\nrejects it rather than letting the unmatched value fall through.\n\nFalling through is not a harmless default. In expression position\nthere is no value to produce, so an unhandled variant would read an\nuninitialized slot; in statement position it would silently skip the\nmatch. Neither is what the code says.\n\n  type Color \{ Red, Green, Blue \}\n\n  match c \{                 // E0004 -- missing pattern: `Blue`\n      Color.Red => \"r\"\n      Color.Green => \"g\"\n  \}\n\nFix: add an arm for each variant the message names.\n\n  match c \{                 // OK -- every variant covered\n      Color.Red => \"r\"\n      Color.Green => \"g\"\n      Color.Blue => \"b\"\n  \}\n\nA wildcard `_` arm, or a plain binding arm, also makes the match\nexhaustive -- but it silently absorbs variants added later, so prefer\nnaming variants when you want the compiler to find those sites.\n\n  match c \{\n      Color.Red => \"r\"\n      _ => \"other\"          // OK -- catch-all\n  \}\n\nA guard does NOT contribute to exhaustiveness: `Color.Blue if f` may\nbe false, so `Blue` still counts as unhandled."
    }
    if code == TYPE_ERROR {
        return "E0300 -- TypeError\n\nA type mismatch was detected during type checking.\n\nCommon causes:\n  - Passing a value of the wrong type to a function\n  - Using '?' in a function that does not return Result\n  - Assigning a value to a variable of incompatible type\n\nFix: check the expected and actual types in the error message and\nadjust your code to match.\n\n  fn add(a: Int, b: Int) -> Int \{ a + b \}\n  add(1, \"two\")  // E0300: expected Int, got Str"
    }
    if code == CANNOT_INFER_TYPE {
        return "E0301 -- CannotInferType\n\nEvery binding must resolve to a concrete type. This one is\nunder-determined: an empty container or bare None was never given\nan element type -- not by an annotation, and not by a later use\nthat would constrain it. There is no default type; the compiler\nreports it instead of guessing.\n\nA constraining use DOES fix it: pushing/inserting an element, or\npassing the value where a concrete type is expected.\n\n  let mut xs = []\n  xs.push(1)              // OK -- later use infers List[Int]\n\n  let x = []\n  let n = x.len()         // E0301 -- len() does not constrain the element\n\nFix: add a type annotation.\n\n  let x: List[Int] = []   // OK\n  let m: Map[Str, Int] = Map()\n  let o: Int? = None"
    }
    if code == NOT_ITERABLE {
        return "E0302 -- NotIterable\n\nA `for` loop's iterable is not one of Blink's built-in iterable\ntypes. Only these implement IntoIterator:\n\n  List[T]    -- yields T, in order\n  Set[T]     -- yields T, unspecified order\n  Map[K, V]  -- yields (K, V), unspecified order\n  Range[T]   -- yields T, lazy\n  Str        -- yields Char\n  Bytes      -- yields U8\n  Channel[T] -- yields T (receive)\n  Iterator[T] -- yields T (identity)\n\nFix: iterate one of the types above, or call `.into_iter()` /\n`.iter()` on a type that provides one.\n\n  for x in 5 \{ }              // E0302 -- Int is not iterable\n  for x in (List[Int]) \{ }    // OK"
    }
    if code == TYPE_ARG_ARITY {
        return "E0303 -- TypeArgArity\n\nA type constructor named in a type position must be applied to\nexactly its declared number of type arguments. A constructor of\narity n denotes a complete type only when it is given n arguments;\nwriting the wrong number -- including none -- does not name a type.\n\nUnder-application (too few, of which a bare name is the extreme) and\nover-application (too many) are the same failure and the same code.\n\n  fn relay(src: Channel, dst: Channel) \{ }   // E0303 -- Channel takes 1, 0 given\n  fn f(m: Map[Str]) \{ }                       // E0303 -- Map takes 2, 1 given\n  fn g(xs: List[Int, Str]) \{ }                // E0303 -- List takes 1, 2 given\n\nThe rule is uniform across builtins (Channel, List, Map, Set,\nOption, Result, Iterator, Handle), user generics, and 0-arity\nscalars (Int, Str, ...): a bare `Registry` is E0303 for the same\nreason a bare `Channel` is, and `Int[Str]` for the same reason\n`List[Int, Str]` is. It is decided at name\nresolution, from the declaration alone, before inference runs -- so\nit never co-fires with error[CannotInferType] (E0301) on the same\ntype expression.\n\nA trait name in a bound (`T: Ord`) or an impl header is NOT a type\nposition; its arguments are governed by error[TraitArgArity]\n(E0910), not this rule. An impl-header RECEIVER, however, is a type\nposition: `impl Show for Box` is E0303.\n\nFix: supply exactly the arguments the constructor declares.\n\n  fn relay[T](src: Channel[T], dst: Channel[T]) \{ }   // OK\n  fn f[K, V](m: Map[K, V]) \{ }                         // OK\n  impl[T] Show for Box[T] \{ ... }                      // OK"
    }
    if code == MISSING_ELSE {
        return "E0304 -- MissingElse\n\nAn `if` used as a VALUE must have an `else`. In expression context --\na let binding, a return, or an argument -- the `if` has to produce a\nvalue on every path, so both branches are required and must unify to\nthe same type. A missing `else` has no value when the condition is\nfalse, so the compiler rejects it rather than reading an\nuninitialized slot.\n\n  let x = if c \{ 1 }            // E0304 -- no value when c is false\n  let x = if c \{ 1 } else \{ 0 } // OK\n\nIn STATEMENT context the value is discarded, so `else` is optional and\nthe `if` has type ():\n\n  if c \{ log(\"hi\") }            // OK -- value discarded\n\nFix: add an `else` branch, or -- if you meant to run the branch for its\neffect only -- make the `if` a statement rather than binding its value."
    }
    if code == UNLICENSED_SELF_OP {
        return "E0305 -- UnlicensedSelfOperation\n\nInside a trait's default method body, `self` has the abstract type\n`Self`. `Self` is an implicit type parameter bounded by the trait's\nGUARANTEE SET: the methods the trait declares, plus every method of\neach trait named in its supertrait clause, transitively. An operator\n(which desugars to a trait method -- see Operator Desugaring) or a\nplain method call on a value of type `Self` is well-formed only when\nits backing trait is in the guarantee set. Any other operation is\nrejected at the trait DEFINITION, before any implementor exists.\n\n  trait Ranked: Ord \{                       // OK -- `<` -> Ord.cmp,\n      fn before(self, o: Self) -> Bool \{      //      Ord is a supertrait\n          self < o\n      \}\n  \}\n\n  trait Ranked \{                            // E0305 -- `<` needs Ord,\n      fn before(self, o: Self) -> Bool \{      //          not declared\n          self < o\n      \}\n  \}\n\nFix (open trait): declare the backing trait as a supertrait so every\nimplementor provides the operation -- `trait Ranked: Ord \{ ... \}`.\n\nThe arithmetic traits (Add, Sub, Mul, Div, Rem, Neg) are SEALED to the\nbuilt-in numeric types. A trait may still name one as a supertrait\n(`trait Doubler: Add`), but that restricts its implementors to the\nnumerics -- no user type can satisfy it -- so the diagnostic for a\nsealed backing trait does NOT suggest adding it. Make the method\nrequired instead, or use a concrete numeric type.\n\nA call to one of the trait's OWN methods is always licensed: that is\nwhat lets an `ne` default call `self.eq()`."
    }
    if code == TRAIT_BOUND_NOT_SATISFIED {
        return "E0306 -- TraitBoundNotSatisfied\n\nA type parameter may declare bounds -- `fn sum[T: Add](a: T, b: T)`\nsays every instantiation of `T` must implement Add. Bounds are\nchecked against the arguments AS WRITTEN. When a call's type argument\n(inferred from the arguments, or written explicitly) does not satisfy\nthe binder's bound, the call is rejected here -- at the call site,\nbefore code generation -- not left to fail later in the C backend.\nExplicitness never bypasses a bound.\n\n  fn sum[T: Add](a: T, b: T) -> T \{ a + b \}\n  sum(1, 2)        // OK   -- T := Int, and Int implements Add\n  sum(\"a\", \"b\")    // E0306 -- T := Str, and Str does not implement Add\n\nThe arithmetic traits (Add, Sub, Mul, Div, Rem, Neg) are SEALED to the\nbuilt-in numeric types, so a bounded `T` can only ever be a numeric\ntype -- passing a Str, Bool, or a user type is rejected. The modeled\ntraits also include Ord, Eq, Display, Debug, Hash, and Serialize.\n\nFix: pass an argument whose type satisfies the bound, or -- for a\nuser type -- derive or implement the required trait for it.\n\n  @derive(Ord) type Widget \{ x: Int \}   // now satisfies an Ord bound"
    }
    if code == UNSOLVED_TYPEVAR_AT_CODEGEN {
        return "I0001 -- UnsolvedTypeVarAtCodegen\n\nAn INTERNAL COMPILER ERROR. A generic type's parameter was still\nunsolved when code generation tried to monomorphize it, so the\ncompiler had no concrete type to emit for that slot.\n\nThis is a bug in the compiler, not in your program. One of two\nthings should have happened first and did not:\n\n  - the type should have been inferred from a use, or\n  - the front end should have reported error[CannotInferType]\n    (E0301) for a genuinely under-determined binding.\n\nThe compiler stops here rather than emitting a type-erased name,\nwhich would silently collapse distinct instantiations onto one C\ntype and miscompile.\n\nFix: please report this, ideally with the smallest program that\nreproduces it. As a workaround, adding an explicit type annotation\nat the reported location usually avoids the unsolved slot.\n\n  let b: GKV[Int, Str] = GKV \{ m: Map() \}   // annotated -- avoids it"
    }
    if code == UNHANDLED_ITERABLE_AT_CODEGEN {
        return "I0002 -- UnhandledIterableAtCodegen\n\nAn INTERNAL COMPILER ERROR. A `for` loop's iterable passed the\nfront-end's iterable check (error[NotIterable], E0302) but code\ngeneration has no loop emitter for its runtime type.\n\nThis is a bug in the compiler, not in your program: the type is\ngenuinely one of the built-in IntoIterator kinds (List/Set/Map/\nRange/Str/Iterator) or the Channel receive extension, but the\ncorresponding codegen arm has not been implemented yet. The\ncompiler stops here rather than silently emitting a loop that runs\nzero iterations.\n\nFix: please report this, ideally with the smallest program that\nreproduces it."
    }
    if code == UNDECLARED_EFFECT {
        return "E0500 -- UndeclaredEffect\n\nA function calls another function that requires an effect, but the\ncaller does not declare that effect in its signature.\n\nFix: add '! EffectName' to the calling function's signature.\n\n  fn greet() ! IO \{\n      io.println(\"hello\")  // IO effect declared\n  \}\n\n  fn bad() \{\n      io.println(\"hello\")  // E0500: requires IO but bad() has none\n  \}"
    }
    if code == CAPABILITY_BUDGET {
        return "E0501 -- CapabilityBudgetExceeded\n\nA function uses an effect that is not listed in its module's\n@capabilities budget. The budget caps which effects a module is\npermitted to use; calls that need an effect outside it are rejected.\n\nFix: add the effect to the @capabilities annotation at the top of\nyour module.\n\n  @capabilities(IO, Net)\n  fn fetch() ! IO, Net \{ ... \}  // OK -- both in budget"
    }
    if code == QM_INVALID_OPERAND {
        return "E0502 -- InvalidOperand for ? or ??\n\nThe '?' or '??' operator was used on a value that is not the\nexpected type. '?' requires Result or Option, '??' requires Option.\n\nCommon causes:\n  - Using '?' on a plain value instead of a Result or Option\n  - Using '??' on a Result instead of an Option\n\n  let val = some_option ?? \"default\"  // OK\n  let res = try_parse()?              // OK -- ? on Result\n  let inner = some_option?            // OK -- ? on Option (in Option-returning fn)"
    }
    if code == UNDEFINED_FUNCTION {
        return "E0504 -- UndefinedFunction\n\nA function was called that has not been defined or imported.\n\nCommon causes:\n  - Typo in the function name\n  - Forgetting to import the module that defines the function\n  - The function is private (not pub) in another module\n\nFix: check the function name spelling, or add the appropriate import.\n\n  import math\n  let x = math.sqrt(4.0)  // OK -- imported"
    }
    if code == UNRESOLVED_METHOD {
        return "E0505 -- UnresolvedMethod\n\nA method call could not be resolved for the receiver's type.\n\nCommon causes:\n  - Calling a method that does not exist on that type\n  - The variable's type is not what you expected\n  - Missing trait implementation\n\nFix: check the receiver type and available methods.\n\n  let x: Int = 42\n  x.contains(\"a\")  // E0505: Int has no .contains() method"
    }
    if code == UNDEFINED_VARIABLE {
        return "E0506 -- UndefinedVariable\n\nA variable was referenced that has not been declared in scope.\n\nCommon causes:\n  - Typo in the variable name\n  - Using a variable before it is declared\n  - Variable is out of scope (declared in a different block)\n\n  let name = \"Blink\"\n  io.println(nane)  // E0506: 'nane' -- did you mean 'name'?"
    }
    if code == UNKNOWN_TYPE {
        return "E0507 -- UnknownType\n\nA type name was used that the compiler does not recognize.\n\nCommon causes:\n  - Typo in the type name\n  - Forgetting to define or import the type\n  - Using a type from a module that is not imported\n\n  type Point \{ x: Int, y: Int \}\n  let p: Piont = ...  // E0507: unknown type 'Piont'"
    }
    if code == QM_RESULT_IN_NON_RESULT {
        return "E0508 -- QuestionMarkResultInNonResult\n\nThe '?' operator was used on a Result value inside a function that\ndoes not return Result.\n\nFix: change the function's return type to Result[T, E].\n\n  fn parse(s: Str) -> Result[Int, Str] \{ ... \}\n\n  fn caller() -> Result[Int, Str] \{\n      let n = parse(\"42\")?  // OK -- caller returns Result\n      Ok(n)\n  \}"
    }
    if code == QM_OPTION_IN_NON_OPTION {
        return "E0509 -- QuestionMarkOptionInNonOption\n\nThe '?' operator was used on an Option value inside a function that\ndoes not return Option.\n\nFix: change the function's return type to Option[T].\n\n  fn find(items: List[Str], key: Str) -> Option[Str] \{\n      items.get(0)?  // OK -- function returns Option\n  \}"
    }
    if code == QM_ERROR_MISMATCH {
        return "E0512 -- QuestionMarkErrorMismatch\n\nThe '?' operator was used on a Result whose error type does not\nmatch the enclosing function's return error type.\n\nFix: ensure both error types are the same, or convert the error.\n\n  fn parse(s: Str) -> Result[Int, ParseError] \{ ... \}\n\n  fn caller() -> Result[Str, ParseError] \{\n      let n = parse(\"42\")?  // OK -- both use ParseError\n      Ok(n.to_string())\n  \}"
    }
    if code == COALESCE_REQUIRES_OPT {
        return "E0513 -- CoalesceRequiresOption\n\nThe '??' operator requires its left operand to be an Option value.\nIt unwraps Some(v) to v, or substitutes the right-hand default for\nNone. Applying '??' to a non-Option type is rejected.\n\n  let val = maybe_name() ?? \"anonymous\"   // OK -- maybe_name returns Option[Str]\n  let bad = 42 ?? 0                         // E0513 -- 42 is Int, not Option\n\nFix: change the left operand to an Option, or remove the '??'."
    }
    if code == QM_TEST_DISPLAY_REQUIRED {
        return "E0514 -- QuestionMarkTestDisplayRequired\n\nThe '?' operator was used inside a test block on a Result whose error\ntype does not implement Display. Test bodies that use '?' are\nimplicitly elaborated to return Result[Void, TestError], and each\npropagated error is rendered via Display.display(e) for the runner's\nNDJSON output. The error type must therefore implement Display.\n\nFix: add 'impl Display for E' for the error type, or '.unwrap()' the\nResult explicitly inside the test.\n\n  type MyErr \{ msg: Str \}\n  impl Display for MyErr \{ fn fmt(self, sb: StringBuilder) \{ sb.write(self.msg) \} \}\n\n  test \"ok\" \{\n      let n = fallible()?  // OK once Display is implemented\n  \}"
    }
    if code == TEST_ANNOTATED_RETURN {
        return "E0515 -- AnnotatedTestReturnTypeRejected\n\nA test block declared an explicit return type with '->'. Test bodies\ndo not name their return type: if the body uses '?' anywhere, it is\nimplicitly elaborated to Result[Void, TestError]; otherwise the\nimplicit return type is Void. User-supplied return annotations are\nrejected to keep the rule unambiguous.\n\nFix: remove the '-> ...' annotation.\n\n  test \"x\" \{ ... \}                       // OK\n  test \"x\" -> Result[Void, Str] \{ ... \}  // E0515 -- drop the arrow"
    }
    if code == BARE_GENERIC_FN_AS_VALUE {
        return "E0517 -- BareGenericFnAsValue\n\nA generic function 'fn name[T](...)' was passed by bare name as a\nclosure-typed argument. Generic functions are templates and have no\nsingle C-level signature, so codegen cannot synthesize a closure\nshim for a bare reference without picking a specific instantiation.\n\nFix: wrap the call in a closure literal that names the type, which\nlets the type-args flow from context.\n\n  fn identity[T](x: T) -> T \{ x }\n  fn take(f: fn(Int) -> Int) -> Int \{ f(7) }\n\n  take(identity)             // E0517 -- bare generic fn as value\n  take(\{ x => identity(x) }) // OK -- closure literal monomorphizes\n\nNon-generic fns may be passed by bare name; only generics need the\nwrapping closure literal."
    }
    if code == NAME_COLLISION {
        return "E0518 -- NameCollision\n\nA struct type and an enum variant share the same name. Bare\nconstruction (`Name \{ ... }`) would be ambiguous: the compiler\ncould not tell whether you meant the struct or the variant, and\nsilently picking one would be a miscompile hazard.\n\nThis rule is narrow: it ONLY rejects a struct name equal to an enum\nvariant name. Two different enums may freely share a variant name\n(e.g. `Pending` in both `JobState` and `NetState`) — that case is\nlegal and resolved by the expected type at the use site.\n\nFix: rename either the struct or the variant.\n\n  type Status \{ code: Int }       // struct named 'Status'\n  type Job \{ Status \{ at: Int } }  // E0518 -- variant also named 'Status'"
    }
    if code == AMBIGUOUS_CONSTRUCTION {
        return "E0519 -- AmbiguousConstruction\n\nA bare struct-style construction `Name \{ ... }` names a variant that\nexists in more than one enum, and there is no expected type at the\nuse site to disambiguate. The compiler will not guess which enum you\nmeant.\n\nFix: qualify the construction with the enum name, or add a type\nannotation so the expected type pins the resolution.\n\n  type JobState \{ Pending, Done }\n  type NetState \{ Pending, Closed }\n\n  let s = Pending \{}              // E0519 -- 'Pending' is in two enums\n  let s = JobState.Pending \{}     // OK -- qualified\n  let s: JobState = Pending \{}    // OK -- annotation gives the hint"
    }
    if code == DERIVE_DEBUG_FIELD_NO_DEBUG {
        return "E0520 -- DeriveDebugFieldNoDebug\n\n@derive(Debug) generates a debug() that renders every field by\ncalling that field's own debug(). A field whose type is a user\nstruct or enum that does not itself derive (or implement) Debug has\nno debug() to call, so the derived method cannot be generated.\n\nFix: add @derive(Debug) to the field's type, or remove that field's\ntype from the Debug-derived type.\n\n  @derive(Debug)\n  type Inner \{ a: Int }            // OK -- Inner derives Debug\n  @derive(Debug)\n  type Outer \{ i: Inner }          // OK\n\n  type Plain \{ a: Int }            // does NOT derive Debug\n  @derive(Debug)\n  type Bad \{ p: Plain }            // E0520 -- field 'p' type 'Plain' has no Debug"
    }
    if code == STR_PLUS_UNSUPPORTED {
        return "E0521 -- StrPlusUnsupported\n\n'+' does not work on Str. Blink reserves '+' for numeric arithmetic;\nusing it to join strings encourages accidental O(n^2) build-up loops\nand creates ambiguity with numeric '+'. Str deliberately does not\nimplement Add.\n\nFix: use string interpolation to embed a value, or .concat() to join\ntwo strings.\n\n  let name = \"world\"\n  let greeting = \"hello \{name\}\"     // OK -- interpolation\n  let joined = a.concat(b)            // OK -- .concat()\n\n  let bad = a + b                     // E0521 -- '+' on Str\n  let mixed = \"x\" + 1                 // E0521 -- '+' on Str"
    }
    if code == AMBIGUOUS_METHOD_CALL {
        return "E0522 -- AmbiguousMethodCall\n\nAn unqualified method call `x.m()` resolved to a method `m` defined\nby two or more traits that the receiver's type implements. The\ncompiler cannot tell which trait's method you meant.\n\nFix: use a qualified call `Trait.m(receiver)` to name the trait.\n\n  trait Serializable \{ fn serialize(self) -> Str }\n  trait Debuggable   \{ fn serialize(self) -> Str }\n  impl Serializable for Config \{ fn serialize(self) -> Str \{ ... } }\n  impl Debuggable   for Config \{ fn serialize(self) -> Str \{ ... } }\n\n  c.serialize()                // E0522 -- found in two traits\n  Serializable.serialize(c)    // OK -- qualified\n  Debuggable.serialize(c)      // OK -- qualified"
    }
    if code == MISSING_DISPLAY_IMPL {
        return "E0523 -- MissingDisplayImpl\n\nAn interpolated expression '\{expr}' in a string literal requires its\ntype to implement Display. Interpolation renders the value via\nDisplay.display(); there is no fallback to Debug and no auto-\nsynthesis of a representation.\n\nBuiltins with a compiler-provided Display: Int, Float, Bool, Str,\nChar (and tuples of them). Collections such as List, Map and Option\nare Debug-only, not Display, so interpolating them is also an error.\n\nFix: add '@derive(Display)' or implement Display manually, or use\n'.debug()' for a structural representation.\n\n  @derive(Display)\n  type Point \{ x: Int, y: Int }\n  io.println(\"p = \{p}\")          // OK once Display exists\n\n  type Bare \{ x: Int }\n  io.println(\"p = \{b}\")          // E0523 -- no Display impl\n  io.println(\"p = \{b.debug()}\")  // OK -- structural via Debug"
    }
    if code == RESERVED_TYPE_NAME {
        return "E0524 -- ReservedTypeName\n\nA 'type' declaration used a name the compiler reserves for an\ninternal AST head-sentinel: 'Tuple', 'Fn', or 'Self'. These are not\nuser-facing prelude types (§10.6 does not list them) and the parser\noverloads their name internally to tag tuple, function, and\nself-type annotations. Declaring a user type with one of these names\nwould shadow the sentinel and mis-decode annotations that mention it\n-- e.g. 'type Tuple[X]' makes '(Int, Tuple[Int])' decode as a\nforbidden 1-arity tuple (§3 \"No 1-Tuples\").\n\nUnlike other prelude names, these three are un-shadowable because the\ncollision is not a value-vs-type ambiguity but a parser/codegen\nhead-name overload with no disambiguation path.\n\nFix: rename the type.\n\n  type Tuple[X] \{ val: X }   // E0524 -- reserved sentinel name\n  type Pair[X]  \{ val: X }   // OK"
    }
    if code == NO_SUCH_FIELD {
        return "E0525 -- NoSuchField\n\nA field access named a field the type does not declare. Member access\nis checked against the declared shape: sections/03_types.md:3305 makes\n'pair.2' on a two-element tuple a compile error, and the same rule\napplies to a struct field the declaration never lists. It also covers\nan @ffi.opaque handle, which has no body and therefore no fields\n(§9.1.4).\n\nBefore this check a nonexistent field silently inferred as an unknown\ntype and interpolated as the placeholder '<value>' at runtime.\n\nFix: use a declared field, or add the field to the type.\n\n  type P \{ a: Int }\n  let p = P \{ a: 1 }\n  p.zzz   // E0525 -- P has no field 'zzz'\n  p.a     // OK"
    }
    if code == ARENA_VALUE_ESCAPES {
        return "E0700 -- ArenaValueEscapes\n\nA value allocated inside a 'with arena \{ }' block escapes the\narena's scope. Arena-allocated memory is freed when the arena exits,\nso references that survive the block would dangle.\n\nCommon causes:\n  - Storing an arena value into a long-lived field or global\n  - Capturing an arena value in a closure that outlives the block\n  - Passing an arena value to a function that keeps it\n\nThe diagnostic prints the resolved promotion target — either\n'promoted into: outer arena' (when the escaping site is inside a\nnested 'with arena') or 'promoted into: GC heap' (outermost block) —\nso nested-arena escapes are debuggable without guessing the shape of\nthe enclosing scope.\n\nFix: remove '! Arena' and let the value be GC-managed, or copy the\nvalue explicitly before it leaves the arena scope."
    }
    if code == ARENA_CLOSURE_TAIL_UNSUPPORTED {
        return "E0702 -- ArenaClosureTailUnsupported\n\nThe tail expression of 'with arena \{ expr }' evaluates to a closure.\nPromoting a closure from an inner arena to the enclosing allocator\nrequires deep-copying the closure's captured cells, which the compiler\ndoes not yet support. Allowing it would leave the returned closure\npointing at captures freed when the inner arena is destroyed.\n\nFix: construct the closure outside the 'with arena \{ }' block, or\nreturn a non-closure value from the block and build the closure after."
    }
    if code == PRIVATE_ITEM_ACCESS {
        return "E1003 -- PrivateItemAccess\n\nAn attempt was made to access a private (non-pub) item from another\nmodule.\n\nFix: either mark the item as 'pub' in its module, or use the\nmodule's public API instead.\n\n  // in math.bl\n  pub fn sqrt(x: Float) -> Float \{ ... \}  // accessible\n  fn helper() \{ ... \}                      // private"
    }
    if code == VERSION_CONFLICT {
        return "E1004 -- VersionConflict\n\nTwo dependencies in the lockfile require different versions of the\nsame package. Blink enforces exactly one version per package.\n\n  myapp depends on http 0.5\n  auth 1.0 depends on http 0.6\n  → conflict: only one version of 'http' allowed\n\nFix: run 'blink update' to find a compatible version, or pin\ndependencies to use the same version in blink.toml."
    }
    if code == INVALID_MODULE_ANNOTATION {
        return "E1008 -- InvalidModuleAnnotation\n\nThe @module annotation tried to move a file into a different package.\n@module can only set the module name to the parent package name —\nyou cannot use it to move a file into an unrelated package.\n\n  // auth/login.bl\n  @module(\"auth\")     // OK — matches parent package 'auth'\n  @module(\"billing\")  // E1008 — file is in 'auth', not 'billing'\n\nFix: use @module with the parent package name, or remove the annotation."
    }
    if code == PACKAGE_ENTRY_NOT_FOUND {
        return "E1009 -- PackageEntryNotFound\n\nA bare `import <pkg>` resolved to a package whose entry file is\nmissing. The entry file is mandatory and must live at\n<pkg-root>/src/<name>.bl, where <name> is [package].name.\n\n  // libs/pg/blink.toml\n  // [package]\n  // name = \"pg\"\n  // libs/pg/src/pg.bl     <-- expected\n\nFix: create src/<name>.bl in the package, or correct the\n[package].name field in blink.toml."
    }
    if code == ORPHAN_FILE {
        return "E1010 -- OrphanFile\n\nA source file with no enclosing blink.toml is not part of any\npackage. Bare external imports from such a file are not allowed —\nonly stdlib (std.*) and bundled (pkg.*) imports work.\n\n  // /tmp/foo.bl  (no blink.toml ancestor)\n  import mylib    // E1010 — orphan file\n\nFix: create a blink.toml in an ancestor directory to declare the\npackage, or import only std.* / pkg.* modules."
    }
    if code == INVALID_PACKAGE_NAME {
        return "E1011 -- InvalidPackageName\n\nThe [package].name field violates the package-name grammar.\n[package].name must match [a-z][a-z0-9_]* — start with a lowercase\nletter, followed by lowercase letters, digits, or underscores.\nHyphens, dots, and uppercase letters are forbidden.\n\n  name = \"my_lib\"   // OK\n  name = \"My-Lib\"   // E1011 — uppercase + hyphen\n  name = \"1lib\"     // E1011 — leading digit\n\nFix: rename the package to satisfy the grammar."
    }
    if code == PACKAGE_NOT_DECLARED {
        return "E1052 -- PackageNotDeclared\n\nA Tier 2 stdlib package was imported without declaring it in blink.toml.\nTier 2 packages (std.http, std.db, std.log, std.config, std.net) require\nexplicit dependency declaration.\n\n  // blink.toml\n  [dependencies]\n  std/http = \"0.1\"\n\n  // then in your code:\n  import std.http  // OK with declaration\n\nTier 1 packages (std.json, std.toml, etc.) are always available."
    }
    if code == INLINE_MODULE_NOT_SUPPORTED {
        return "E1015 -- InlineModuleNotSupported\n\nInline modules (mod name \{ ... \}) are not supported in Blink.\nBlink uses file-based modules: one file = one module.\n\nFix: move the module contents into a separate file and use import.\n\n  // Instead of:\n  mod schema \{\n      fn validate() \{ ... \}\n  \}\n\n  // Create schema.bl with the contents and import it:\n  import schema\n  schema.validate()\n\nSee section 10.1 for details on Blink's module system."
    }
    if code == UNEXPECTED_TOKEN {
        return "E1100 -- UnexpectedToken\n\nThe parser encountered a token it did not expect at this position.\n\nCommon causes:\n  - Missing or extra braces, parentheses, or brackets\n  - Incorrect syntax for the current context\n  - Using an operator in the wrong position\n\nFix: check the line and column indicated and look for syntax errors."
    }
    if code == UNEXPECTED_TOKEN_STRING {
        return "E1101 -- UnexpectedToken in String\n\nThe parser encountered an unexpected token inside a string\ninterpolation.\n\nCommon causes:\n  - Malformed interpolation expression\n  - Unmatched braces inside a string\n\nFix: ensure interpolation expressions are valid Blink expressions."
    }
    if code == UNEXPECTED_TOKEN_PATTERN {
        return "E1102 -- UnexpectedToken in Pattern\n\nThe parser encountered an unexpected token inside a match pattern.\n\nCommon causes:\n  - Invalid pattern syntax in a match arm\n  - Using expressions where a pattern is expected\n\nFix: use valid pattern syntax: literals, identifiers, enum variants,\nor wildcard '_'."
    }
    if code == KEYWORD_AS_IDENTIFIER {
        return "E1103 -- KeywordAsIdentifier\n\nA language keyword was used where an identifier (variable or\nfunction name) was expected.\n\nKeywords: fn, let, if, else, match, while, return, type, trait,\nimport, pub, handler, effect, enum, for, in, mut, const, test\n\nFix: choose a different name that is not a reserved keyword.\n\n  let result = 42    // OK\n  let match = 42     // E1103: 'match' is a keyword"
    }
    if code == INTERP_PARSE_FAILURE {
        return "E1106 -- InterpParseFailure\n\nAn interpolation expression inside a \"...\" string failed to\nparse. Every unescaped '\{' in a \"...\" string starts an\ninterpolation expression — even between backticks, which have no\nspecial meaning in strings.\n\nFix: for a literal brace, escape it as '\\\{'. For prose-heavy\ntext, use an extended string #\"...\"# where braces are literal\nand interpolation uses #\{expr\}.\n\n  \"usage: `f() \\\{ ... \}`\"      // \\\{ escapes the brace\n  #\"usage: `f() \{ ... \}`\"#     // braces are literal"
    }
    if code == EMPTY_BRACE_EXPR {
        return "E1107 -- EmptyBraceExpr\n\nEmpty braces were used in expression position. Blink does not have\nempty-brace map syntax.\n\nFix: use Map() to construct an empty map.\n\n  let m: Map[Str, Int] = Map()  // OK"
    }
    if code == FILE_NOT_FOUND {
        return "E1108 -- FileNotFound\n\nAn #embed() compile-time intrinsic referenced a file that does not\nexist relative to the source file.\n\nFix: check that the file path is correct relative to the source\nfile.\n\n  const data: Str = #embed(\"data.txt\")  // file must exist"
    }
    if code == MUT_FIELD_NOT_SUPPORTED {
        return "E1109 -- MutFieldNotSupported\n\nThe 'mut' keyword was used on a struct field declaration. In Blink,\nmutability is a property of the binding, not the type or its fields.\nAll fields of a 'let mut' binding are mutable; all fields of a 'let'\nbinding are immutable.\n\nFix: remove 'mut' from the field and use 'let mut' when binding.\n\n  type Point \{ x: Float, y: Float \}\n  let mut p = Point \{ x: 1.0, y: 2.0 \}\n  p.x = 3.0  // OK — binding is mut"
    }
    if code == UNEXPECTED_ANNOTATION {
        return "E1110 -- UnexpectedAnnotation\n\nAn annotation was used in a position where it is not supported. For\nexample, only @where is permitted on type aliases.\n\nFix: remove the annotation or move it to a construct that supports\nit. For type aliases, use @where(predicate) for refinement\nconstraints."
    }
    if code == UNKNOWN_INTRINSIC {
        return "E1111 -- UnknownIntrinsic\n\nThe parser encountered a compile-time intrinsic (#name) that is not\nrecognized. The only currently-supported intrinsic is #embed.\n\nFix: use a supported intrinsic, or remove the call.\n\n  const data: Str = #embed(\"data.txt\")  // OK"
    }
    if code == UNEXPECTED_CHARACTER {
        return "E1113 -- UnexpectedCharacter\n\nThe lexer encountered a character it does not recognize as part of\nany Blink token. The most common cause is a stray `;` left over\nfrom another language — Blink uses newlines as statement terminators\nand spec section 2.5 explicitly forbids semicolons.\n\nFix: remove the offending character. If it is `;`, just delete it;\nthe newline that follows already terminates the statement.\n\n  let x = 3;        // E1113 -- delete the `;`\n  let x = 3         // OK"
    }
    if code == MODULE_NOT_FOUND {
        return "E1200 -- ModuleNotFound\n\nAn import statement referenced a module that could not be found.\n\nCommon causes:\n  - Typo in the module name\n  - Missing file: the module's .bl file does not exist\n  - Incorrect path in the module hierarchy\n\nFix: verify the module name matches a .bl file in your project or\nthe standard library.\n\n  import math       // looks for lib/std/math.bl or src/math.bl\n  import pkg.audit  // looks for lib/pkg/audit.bl"
    }
    if code == INVALID_STRING_BACKED_ENUM {
        return "E1201 -- InvalidStringBackedEnum\n\nA string-backed enum variant was assigned a value that is not a\nplain string literal. Only simple string literals are allowed for\nthe storage value of a string-backed enum.\n\nFix: use a plain string literal.\n\n  enum Status \{\n      Active = \"active\"        // OK\n      Frozen = \"frozen\"        // OK\n      // Bad = some_const      // E1201 -- not a literal\n  \}"
    }
    if code == UNKNOWN_METHOD {
        return "W0501 -- UnknownMethod\n\nA method was called that could not be verified during type checking.\nThe code will still compile, but may produce a C error.\n\nCommon causes:\n  - The variable's type is not fully known at check time\n  - A typo in the method name\n\nFix: verify the method name and receiver type."
    }
    if code == INCOMPLETE_STATE_RESTORE {
        return "W0550 -- IncompleteStateRestore\n\nA function call mutates global state but only some of the affected\nglobals are saved and restored around the call.\n\nCommon causes:\n  - Adding a new global to a function's write-set without updating\n    the save/restore pattern in the caller\n\nFix: save and restore all affected globals around the call, or\nverify the mutation is intentional."
    }
    if code == UNRESTORED_MUTATION {
        return "W0551 -- UnrestoredMutation\n\nA function call mutates globals with no save/restore pattern, but\nthe enclosing function uses save/restore elsewhere. This suggests\nthe call may need save/restore too.\n\nCommon causes:\n  - Calling a function with broad side effects speculatively\n  - Forgetting to wrap the call in a save/restore block\n\nFix: if the call is speculative (may need to be rolled back), save\nand restore the affected globals."
    }
    if code == UNUSED_VARIABLE {
        return "W0600 -- UnusedVariable\n\nA variable was declared but never read.\n\nCommon causes:\n  - Leftover variable from refactoring\n  - Variable assigned but result never used\n\nFix: remove the variable, or prefix its name with '_' to suppress\nthis warning.\n\n  let _unused = compute()  // OK -- prefixed with '_'"
    }
    if code == SET_BUT_NOT_READ {
        return "W0601 -- SetButNotRead\n\nA variable was assigned a value that was never read before being\noverwritten or going out of scope.\n\nCommon causes:\n  - Redundant assignment before reassignment\n  - Leftover intermediate computation\n\nFix: remove the unused assignment, or prefix with '_' to suppress.\n\n  let mut x = compute()  // W0601: value never read\n  x = other()\n  io.println(x)"
    }
    if code == UNUSED_IMPORT {
        return "W0602 -- UnusedImport\n\nA module was imported but no symbols from it are referenced.\n\nCommon causes:\n  - Leftover import from refactoring\n  - Import added for future use\n\nFix: remove the unused import statement.\n\n  import math    // W0602 if math.* never used\n  import strings // OK if strings.contains() is called"
    }
    if code == SHADOWED_VARIABLE {
        return "W0603 -- ShadowedVariable\n\nA variable in an inner scope shadows a variable with the same name\nin an outer scope.\n\nCommon causes:\n  - Accidentally reusing a variable name from an enclosing scope\n  - Copy-paste without renaming\n\nFix: rename the inner variable, or prefix with '_' to suppress\nthis warning.\n\n  let x = 10\n  if true \{\n      let _x = 20  // OK -- prefixed with '_'\n  \}"
    }
    if code == UNREACHABLE_CODE {
        return "W0700 -- UnreachableCode\n\nCode appears after an unconditional return, break, or continue\nstatement and will never execute.\n\nCommon causes:\n  - Leftover code from refactoring\n  - Early return added without removing subsequent code\n\nFix: remove the unreachable code or move it before the control\nflow statement."
    }
    if code == ARENA_EFFECT_REDUNDANT {
        return "W0701 -- ArenaEffectRedundant\n\nA function declares '! Arena' but every Arena-effectful call in its\nbody is already contained inside a 'with arena \{ }' block. Because\n'with arena \{ }' is the escape boundary for the '! Arena' marker,\nthe outer annotation adds no information.\n\nFix: remove '! Arena' from the function signature, or add\n@allow(ArenaEffectRedundant) if the annotation is intentional for\ndocumentation or API stability.\n\n  fn wrap() -> Int \{                     // OK -- no marker needed\n      with arena \{ consume([1, 2]) }\n  \}\n\n  fn wrap() -> Int ! Arena \{             // W0701\n      with arena \{ consume([1, 2]) }\n  \}"
    }
    if code == BITWISE_PRECEDENCE {
        return "W0702 -- BitwisePrecedence\n\nA bitwise operator (& or |) was applied to the result of a\ncomparison without parentheses. Because comparisons bind tighter\nthan bitwise operators in some languages and looser in others, the\ncombination is ambiguous to readers.\n\nFix: wrap the comparison or the bitwise operation in parentheses to\nmake the intent explicit.\n\n  let mask = (a == 0) & (b == 0)   // OK -- explicit grouping"
    }
    if code == UNAUDITED_FFI {
        return "W0800 -- UnauditedFFI\n\nAn @ffi function is not marked @trusted, meaning it has not been\naudited for safety.\n\nFix: audit the foreign function for memory safety and correctness,\nthen add @trusted to suppress this warning.\n\n  @ffi(\"puts\")\n  @trusted\n  fn c_puts(s: Ptr[U8]) -> Int ! FFI \{ \}"
    }
    if code == PUB_FFI {
        return "E0801 -- PubFFI\n\nAn @ffi function was declared as pub. FFI functions are unsafe and\nshould not be exposed in a module's public API.\n\nFix: remove 'pub' and wrap the FFI call in a safe public function.\n\n  @ffi(\"strlen\")\n  @trusted\n  fn c_strlen(s: Ptr[U8]) -> Int ! FFI \{ \}\n\n  pub fn string_length(s: Str) -> Int ! FFI \{\n      c_strlen(s.as_ptr())\n  \}"
    }
    if code == FFI_NO_EFFECTS {
        return "E0802 -- FFINoEffects\n\nAn @ffi function does not declare any effects. FFI calls are\ninherently side-effectful and must declare their effects.\n\nFix: add '! FFI' or appropriate effects to the function signature.\n\n  @ffi(\"puts\")\n  @trusted\n  fn c_puts(s: Ptr[U8]) -> Int ! FFI \{ \}"
    }
    if code == CONTRACT_ON_FFI {
        return "E0803 -- ContractOnFFI\n\nA @requires or @ensures annotation was used on an @ffi function.\nContracts cannot verify foreign code behavior.\n\nFix: remove the contract annotation from the FFI function. If you\nneed contracts, add them to a safe wrapper function instead.\n\n  @ffi(\"sqrt\")\n  @trusted\n  fn c_sqrt(x: Float) -> Float ! FFI \{ \}\n\n  @requires(x >= 0.0)\n  pub fn safe_sqrt(x: Float) -> Float ! FFI \{\n      c_sqrt(x)\n  \}"
    }
    if code == INVALID_PTR_TYPE {
        return "E0810 -- InvalidPtrType\n\nPtr[T] was used with an invalid type parameter. Only FFI-compatible\ntypes are allowed inside Ptr.\n\nValid types: Void, U8, U16, U32, U64, I8, I16, I32, I64, Int,\nFloat, Ptr\n\nFix: use one of the valid FFI-compatible types.\n\n  fn good(p: Ptr[U8]) ! FFI \{ \}   // OK\n  fn bad(p: Ptr[Str]) ! FFI \{ \}    // E0810: Str is not valid"
    }
    if code == PTR_OUTSIDE_FFI {
        return "E0811 -- PtrOutsideFFI\n\nPtr[T] was used in a function that is not marked @ffi. Pointer\ntypes are only valid in FFI contexts.\n\nFix: add @ffi to the function, or use a safe wrapper.\n\n  @ffi(\"malloc\")\n  @trusted\n  fn c_malloc(size: Int) -> Ptr[Void] ! FFI \{ \}"
    }
    if code == MISSING_CANONICAL_HEADER {
        return "W0812 -- MissingCanonicalHeader\n\nAn @ffi.struct annotation declares a canonical header that is not\nlisted in any [native-dependencies].<dep>.headers entry of\nblink.toml. Without that declaration the build cannot guarantee the\nheader will be available on the target system, so layout asserts\nmay fail to compile out-of-tree.\n\nFix: list the header in blink.toml:\n\n  [native-dependencies]\n  libname = \{ system = true, headers = [\"poll.h\"] \}\n\nUnder --strict-struct-layout the warning is escalated to error."
    }
    if code == FFI_STRUCT_GC_FIELD {
        return "E0812 -- FfiStructGcField\n\nAn @ffi.struct field uses a GC-managed or non-FFI-compatible type.\n@ffi.struct types must mirror C structs exactly, so fields must use\nsized FFI-compatible types only.\n\nValid field types: I8/I16/I32/I64, U8/U16/U32/U64, Int, Float, F32,\nF64, Bool, and (in future) other @ffi.struct types.\n\nRejected: Str, Bytes, List, Map, Set, Result, Option, traits, and\nany user-defined type without @ffi.struct.\n\nFix: use a sized integer/float/bool type, or wrap the GC-managed\nvalue in a Blink-side struct outside the @ffi boundary.\n\n  @ffi.struct(header: \"poll.h\", name: \"pollfd\")\n  pub type Pollfd \{\n      fd: I32,           // OK\n      events: I16,       // OK\n      revents: I16,      // OK\n      // name: Str,      // E0812\n  \}"
    }
    if code == FFI_OFFSET_ON_SINGLETON {
        return "E0813 -- FfiOffsetOnSingleton\n\nPtr.offset(i) was called on a Ptr produced by scope.alloc[T](),\nwhich allocates a single cell. Pointer arithmetic past cell 0 is\nundefined behavior.\n\nFix: allocate an array via scope.alloc_n[T](n), then use offset.\n\n  let p: Ptr[Pollfd] = scope.alloc_n(8)\n  let q = p.offset(3)   // OK"
    }
    if code == BYTES_GROW_IN_WITH_PTR {
        return "E0814 -- BytesGrowInWithPtr\n\nA growth-effecting method (push/append/concat/extend/clear/\ntruncate/resize/write_*_le/be) was called on the Bytes receiver\ninside its with_ptr closure. Growth would invalidate the pinned\nPtr[U8] aliasing the GC-managed buffer.\n\nFix: move the growth call outside the with_ptr closure.\n\n  b.with_ptr(fn(p) \{ c_read(fd, p, n) })  // OK\n  b.push(0)                                // OK after closure"
    }
    if code == PINNED_BYTES_ESCAPE {
        return "E0815 -- PinnedBytesEscape\n\nThe pinned Bytes receiver was passed as an argument inside its\nwith_ptr closure. Helper-function bodies are out of scope for the\nsyntactic no-grow check, so escapes are forbidden.\n\nFix: pass the Ptr[U8] 'p' or an integer slice instead.\n\n  b.with_ptr(fn(p) \{ helper_taking_ptr(p, b.len()) })   // OK"
    }
    if code == WITH_PTR_BODY_TOO_COMPLEX {
        return "E0816 -- WithPtrBodyTooComplex\n\nBytes.with_ptr currently requires the closure body to be a single\nexpression so the call site can be inlined safely. Multi-statement\nbodies are not supported.\n\nFix: extract complex logic into a helper function that takes\nPtr[U8] and call it from the closure body."
    }
    if code == BYTES_PTR_CAST_FORBIDDEN {
        return "E0817 -- BytesPtrCastForbidden\n\nBytes cannot be cast or coerced to Ptr[U8] outside a with_ptr\nclosure. Bytes is a GC-managed buffer and may be relocated by\nthe garbage collector; raw Ptr[U8] aliases would dangle.\n\nFix: use Bytes.with_ptr to pin the buffer for the duration of\nthe call, and pass the pinned pointer to the FFI:\n\n  b.with_ptr(fn(p) \{ c_read(fd, p, b.len()) })   // OK"
    }
    if code == FFI_SCOPE_NOT_WITH_RESOURCE {
        return "E0819 -- FfiScopeNotWithResource\n\nffi.scope() was bound directly (e.g. `let s = ffi.scope()`) instead\nof as a `with`-resource. A scope frees its allocations when the\nwith-block exits; outside a `with` there is no block to exit, so\nnothing would ever free the arena and every allocation leaks.\n\nFix: bind the scope with `with ... as`:\n\n  with ffi.scope() as scope \{\n      let p: Ptr[Pollfd] = scope.alloc()\n      // p is freed here, at block exit\n  \}"
    }
    if code == MISSING_NATIVE_DEP {
        return "E0820 -- MissingNativeDep\n\nAn @ffi annotation references a C library that is not declared in\nthe [native-dependencies] section of blink.toml.\n\nFix: add the library to blink.toml:\n\n  [native-dependencies]\n  libname = \{ system = true \}"
    }
    if code == NATIVE_DEP_UNAVAILABLE_CROSS {
        return "E0821 -- NativeDepUnavailableCrossTarget\n\nA native dependency declared as system-only cannot be resolved for\na cross-compilation target. Cross-compilation requires vendored\nsource or a static archive.\n\nFix: provide vendored source:\n  libname = \{ path = \"vendor/libname.c\" \}\n\nOr explicitly opt in to dynamic linking on the target:\n  libname = \{ system = true, link = \"dynamic\" \}"
    }
    if code == FFI_OFFSET_UNKNOWN_STRIDE {
        return "E0822 -- FfiOffsetUnknownStride\n\nPtr.offset(i) requires the pointer's element type to be an\n@ffi.struct typedef so the stride (size in bytes) is known at\ncompile time. Pointers to opaque or non-FFI types cannot be\nadvanced safely.\n\nFix: use Ptr[T] where T is annotated @ffi.struct.\n\n  @ffi.struct(header: \"poll.h\", name: \"pollfd\")\n  pub type Pollfd \{ fd: I32, events: I16, revents: I16 \}\n  let p: Ptr[Pollfd] = scope.alloc_n(8)\n  let q = p.offset(3)   // OK -- stride = sizeof(pollfd)"
    }
    if code == INCOMPATIBLE_STDLIB_ARCHIVE {
        return "E0840 -- IncompatibleStdlibArchive\n\nThe installed stdlib archive (libblink_std.a in\n<prefix>/share/blink/) was built by a different blink toolchain\nthan the one now linking your program. The archive and the freshly\nemitted C disagree on struct layout / runtime ABI; linking them\nwould produce a binary that reads boxed values at the wrong offsets\nand corrupts memory at runtime (dangling reads, SIGSEGV).\n\nThe archive carries a `.archive-id` stamp (runtime.h SHA |\nlibblink_std.h SHA | blinkc SHA | version). The decisive checks are\nthe two header SHAs -- runtime.h and libblink_std.h together define\nevery struct layout the user TU shares with the archive. When the\nlinking compiler's resolved headers do not match the stamp, the\nlink is rejected before a binary is produced. (An installed tree\nships no blinkc, so its SHA is recorded for forensics only.)\n\nFix: reinstall the stdlib so the archive matches the compiler:\n\n  task install\n\nOr rebuild against the current toolchain. If you see this from a\nrelease tarball, the tarball's bin/ and share/blink/ are mismatched\n-- reinstall a consistent release."
    }
    if code == CLEANUP_PANICKED_DURING_UNWIND {
        return "E0824 -- CleanupPanickedDuringUnwind\n\nA `BlockHandler.exit(false)` body or `Closeable.close()` body itself\npanicked while running on a catchable-unwind path (`?` propagation,\n`return`, assertion failure, or `skip()`). The original panic is the\nload-bearing failure — the test runner reports it as the test's\nresult and preserves it as the unwind cause. The cleanup panic is\nrecorded as a secondary warning on the same trace frame so the\nauthor can fix the cleanup bug without losing the primary cause.\n\nOn a stacked `with...as` chain, remaining handlers in the LIFO stack\nstill run (continue-drain ordering, per the multi-cleanup test\nregistrar decision); short-circuiting would leak resources held by\ndeeper-stacked handlers.\n\nFix: make the cleanup body robust to partially-initialized state.\nGuard mutating calls behind `if !ok \{ ... }` if they only make\nsense on the success path, and avoid raising new panics from inside\nan `exit`/`close` body.\n\n  type Tx \{ committed: Bool }\n  impl BlockHandler for Tx \{\n      fn exit(self, ok: Bool) \{\n          if ok \{ self.commit() } else \{ self.rollback() }\n          // a panic in commit/rollback here surfaces as E0824 warning\n      }\n  }"
    }
    if code == SKIP_OUTSIDE_TEST {
        return "E0827 -- SkipOutsideTest\n\nskip() is a test-only helper that marks the current test as skipped\nand triggers Result-sentinel propagation back to the test runner. It\nis only meaningful inside a 'test \{ ... }' block; calling it from\nmain(), a regular function, or any non-test context is rejected.\n\nFix: move the call into a test block, or use a different control-flow\nprimitive (return / Err / exit) outside tests.\n\n  test \"network-bound\" \{\n      if !have_network() \{ skip(\"requires network\") }\n      // ... test body ...\n  \}\n\n  fn helper() \{ skip(\"nope\") }  // E0827 -- not in a test body"
    }
    if code == ASSERT_PANICS_BODY_RETURNED {
        return "E0831 -- AssertPanicsBodyReturned\n\nThe `assert_panics` block returned normally instead of panicking.\n`assert_panics` requires its body to terminate with a panic\n(a failed `.unwrap()`, an out-of-bounds index, a sized-integer\noverflow, or any other runtime trap). A normal return is a test\nfailure. A `?`-propagated `Err` that exits the body without\npanicking is also a body-returned failure, not the expected panic.\n\nFix: ensure the body actually triggers the expected panic, or\nremove the `assert_panics` wrapper if no panic is expected.\n\n  test \"divides by zero panics\" \{\n      assert_panics \{\n          let xs: [Int] = []\n          let _ = xs.get(0).unwrap()   // expected panic\n      }\n  }"
    }
    if code == ASSERT_PANICS_MESSAGE_MISMATCH {
        return "E0832 -- AssertPanicsMessageMismatch\n\nThe `assert_panics(matching: \"...\")` block did panic, but the panic\nmessage did not contain the `matching:` substring. The failure\noutput renders the expected substring, the full actual panic\nmessage, and the source location where the panic fired, so you can\ncorrect either the pattern or the panic.\n\nFix: align the `matching:` substring with the actual panic message,\nor the panic message with the test's intent.\n\n  assert_panics(matching: \"index out of bounds\") \{\n      let xs: [Int] = []\n      let _ = xs.get(0).unwrap()\n  }"
    }
    if code == ASSERT_PANICS_OUTSIDE_TEST {
        return "E0833 -- AssertPanicsOutsideTest\n\n`assert_panics` is a test-only construct, like `skip()` and the\nother `assert_*` matchers. Using it in `main()`, a library\nfunction, or any non-test context is rejected at the typecheck\nlayer.\n\nFix: move it into a `test \{ ... }` block.\n\n  test \"bad input panics\" \{\n      assert_panics \{ parse(\"not a number\").unwrap() }\n  }\n\n  fn helper() \{ assert_panics \{ ... } }  // E0833 -- not in a test"
    }
    if code == ASSERT_PANICS_NESTED_EXPECT_PANIC {
        return "E0834 -- AssertPanicsNestedExpectPanic\n\nAn `assert_panics` block is lexically nested inside another\n`assert_panics` block. Nesting is rejected because the outer block\nwould swallow the inner's mechanism and the semantics of which\npanic counts as \"the\" expected panic become ambiguous.\n\nFix: split the assertions into two separate tests.\n\n  test \"a\" \{ assert_panics \{ foo() } }\n  test \"b\" \{ assert_panics \{ bar() } }     // not nested -- OK\n\n  test \"bad\" \{\n      assert_panics \{\n          assert_panics \{ baz() }          // E0834\n      }\n  }"
    }
    if code == XFAIL_MISSING_REASON {
        return "E0835 -- XfailMissingReason\n\n`test.failing(...)` requires both `reason:` and `ticket:` to be\nnon-empty string literals. `reason` documents why the test is\nexpected to fail today; `ticket` is a `br` id that the closed-ticket\nlint queries -- an empty or missing value on either breaks that\ncontract silently.\n\nFix: supply both as non-empty strings.\n\n  test.failing(\n      \"trait impl resolves through alias chain\",\n      reason: \"Phase 3 trait elaboration not yet implemented\",\n      ticket: \"btvqbf\",\n  ) \{\n      // ... test body, expected to fail today\n  }"
    }
    if code == DEPRECATED_USAGE {
        return "W2000 -- DeprecatedUsage\n\nA function or type marked @deprecated was used.\n\nThe @deprecated annotation signals that an API is scheduled for\nremoval. The warning includes the deprecation edition (if known)\nand a suggested replacement.\n\nFix: migrate to the replacement API shown in the help message.\n\n  @deprecated(replacement: \"new_fn\")\n  fn old_fn() \{ \}\n\n  fn main() \{\n      old_fn()   // W2000: use of deprecated function 'old_fn'\n                 // help: use 'new_fn' instead\n  \}"
    }
    if code == CONTRACT_PREDICATE_NOT_DECIDABLE {
        return "E1300 -- ContractPredicateNotDecidable\n\nA @requires/@ensures/@where predicate uses a construct outside the\nSMT-decidable subset. Predicates must be promotable to compile-time\nproofs, so they are restricted to: literals, identifiers, field/index\nreads, ranges, comparisons, boolean/arithmetic operators, if/match,\nand calls to @pure functions.\n\nDisallowed: let bindings, assignments, closures, loops, with-blocks,\nasync/await, channels, allocation, and `?`/try.\n\nFix: rewrite the predicate as a pure expression. Move side-effecting\nlogic into the function body."
    }
    if code == EFFECTFUL_CALL_IN_PREDICATE {
        return "E1301 -- EffectfulCallInPredicate\n\nA contract predicate calls a function that declares effects. Predicates\nmust be evaluable without side effects so they can be reasoned about\nstatically.\n\nFix: call only @pure functions inside predicates, or compute the value\nin the function body and reference it via `result`/`old(_)`."
    }
    if code == IMPURE_CALL_IN_PREDICATE {
        return "E1302 -- ImpureCallInPredicate\n\nA contract predicate calls a function that is not marked @pure. Even\nif the call has no declared effects, predicates must call only\nexplicitly @pure helpers (or a small bootstrap whitelist: len,\nis_empty, unwrap, abs).\n\nFix: mark the helper @pure if it qualifies, or inline the computation."
    }
    if code == LOOP_IN_PREDICATE {
        return "E1303 -- LoopInPredicate\n\nA contract predicate uses `while`, `for`, or `loop`. Loops can fail\nto terminate and have no first-order encoding, so predicates must be\nloop-free.\n\nFix: replace iteration with a recursive @pure helper or a quantifier-\nfree expression over the input."
    }
    if code == RESULT_OUTSIDE_ENSURES {
        return "E1304 -- ResultOutsideEnsures\n\nThe identifier `result` is reserved for use inside @ensures predicates,\nwhere it refers to the function's return value. It is not bound in\n@requires, @where, or function bodies.\n\nFix: use `result` only inside @ensures(...). Rename the local if you\nintended a regular variable."
    }
    if code == OLD_OUTSIDE_ENSURES {
        return "E1305 -- OldOutsideEnsures\n\n`old(expr)` is a postcondition-only construct that snapshots `expr` at\nfunction entry. It is meaningful only inside @ensures.\n\nFix: move the `old(_)` reference into an @ensures predicate, or\ncapture the entry value with a local binding before mutation."
    }
    if code == ASSIGNMENT_IN_PREDICATE {
        return "E1306 -- AssignmentInPredicate\n\nA contract predicate contains an assignment (`=` or compound `+=`\netc.). Predicates must be referentially transparent — they may not\nmutate state.\n\nFix: rewrite as a pure comparison. If the value is needed elsewhere,\nbind it before the contract or inside the function body."
    }
    if code == IMPURE_BODY_FOR_PURE_ANNOTATION {
        return "E1307 -- ImpureBodyForPureAnnotation\n\nA function marked @pure contains a construct that is not pure: an\nassignment, a mutating method call (push, pop, append, clear, insert,\nremove, set), a loop (while/for/loop), an FFI call, allocation of a\nList/Map/Set, or a call into another function that isn't @pure or on\nthe bootstrap whitelist (len, is_empty, unwrap, abs, fabs).\n\n@pure also forbids declared effects on the function signature.\n\nFix: rewrite the body without the offending construct, or remove\n@pure from the signature."
    }
    if code == MODIFIES_ARG_NOT_SIMPLE_PATH {
        return "E1308 -- ModifiesArgNotSimplePath\n\nAn @modifies argument is not a simple path. @modifies tracks which\nbindings a function may mutate, so each argument must name a path\nrooted at a parameter or self: `x`, `x.field`, `x.field.inner`.\n\nDisallowed: function calls, arithmetic, indexing with computed keys,\nor expressions that produce new values.\n\nFix: pass each mutated path explicitly, or restructure the contract\nto annotate the receiver and field separately.\n\n  @modifies(buf, buf.len)   // OK\n  @modifies(buf.get(i))     // E1308 -- call expression"
    }
    if code == MAP_KEY_NOT_HASHABLE {
        return "E1400 -- MapKeyNotHashable\n\nThe key type of a Map[K, V] (or the element type of a Set[T])\ndoes not implement Hash. Two distinct shapes trigger this:\n\nFloat/Double: not hashable in Blink — NaN does not compare equal to\nitself, and two distinct float bit patterns can compare equal, so\nthey cannot satisfy the Hash + Eq contract a key/element requires.\n\nContainers and other non-derivable builtins: List/Map/Set/Option/\nResult, Bytes, StringBuilder, and fn types have no Hash impl in v1\nand cannot gain one via @derive — only builtin scalars\n(Int/sized-int/Bool/Char/Str), a tuple of hashable types, and\nuser structs/enums with @derive(Hash, Eq) are hashable.\n\nFix: for a Float key, round it to an Int (or another integer width)\nor use a stable surrogate key. For a container/non-derivable key or\nelement, use a hashable scalar or a @derive(Hash, Eq) struct/enum\ninstead.\n\n  let m: Map[F64, Int] = Map()          // E1400 -- Float\n  let m: Map[Int, Int] = Map()          // OK\n  let s: Set[Option[Int]] = Set()       // E1400 -- Option has no Hash\n  let s: Set[Int] = Set()               // OK"
    }
    if code == NON_DERIVABLE_TRAIT {
        return "E1401 -- NonDerivableTrait\n\nA field of a @derive(Hash/Eq/Ord/Serialize) type has a type that does\nnot implement the derived trait, so the compiler cannot synthesize the\nmethod. For Hash/Eq/Ord: collection types (List/Map/Set/Option/Result)\nhave no value-equality/hash/ordering in v1 — `==` on them is pointer\nidentity — so they cannot appear under a derive; Float is not Hashable\n(NaN and bit-pattern hazards); Bool is not Orderable. For Serialize the\nv1 to_json emitter renders only Int/Float/Bool/Str, a List of a\nserializable element, and a struct/enum that itself derives Serialize —\nChar, the sized ints, F32/F64, a Ptr, an @ffi.opaque handle, or an\nOption/Map/Set/Result field is rejected rather than silently serialized\nto null. An enum-variant field is more restricted: no List, and only a\nstruct (not an enum) field may derive-recurse. A user type must itself\nderive (or impl) the same trait.\n\nFix: drop the offending field from the derive, implement the trait\nby hand, or give the field a type that derives it.\n\n  @derive(Hash)      type S \{ m: Map\\[Str, Int\\] \}   // E1401 -- Map not Hash\n  @derive(Ord)       type T \{ b: Bool \}             // E1401 -- Bool not Ord\n  @derive(Serialize) type W \{ p: Ptr\\[U8\\] \}         // E1401 -- Ptr not Serialize\n  @derive(Eq)        type U \{ n: Int \}              // OK"
    }
    if code == TEMPLATE_MISMATCH {
        return "E0310 -- TemplateMismatch\n\nA string template parameter type does not match the value supplied\nat the call site. Templates check parameter types like normal\nfunction calls.\n\nFix: convert the value to the expected type, or change the template\nparameter type to match.\n\n  let s = template\"hello \{name: Str\}\"\n  s.fill(name: 42)   // E0310 -- expected Str, got Int"
    }
    if code == MISSING_KEYWORD_ARG {
        return "E0510 -- MissingKeywordArg\n\nA call site did not supply a required keyword argument. Keyword\nparameters with no default must be passed explicitly.\n\nFix: add the missing argument by name, or give the parameter a\ndefault in the function declaration.\n\n  fn open(path: Str, mode: Str) \{ ... \}\n  open(path: \"f.txt\")           // E0510 -- 'mode' missing\n  open(path: \"f.txt\", mode: \"r\") // OK"
    }
    if code == INVALID_KEYWORD_ARG {
        return "E0511 -- InvalidKeywordArg\n\nA keyword argument at the call site does not correspond to any\nparameter on the called function. The name is misspelled or the\nfunction does not accept that keyword.\n\nFix: check the parameter list of the called function and correct\nthe argument name.\n\n  fn greet(name: Str) \{ ... \}\n  greet(nmae: \"Skippy\")   // E0511 -- did you mean 'name'?"
    }
    if code == CLOSEABLE_ESCAPES_SCOPE {
        return "E0601 -- CloseableEscapesScope / PtrEscapesFfiScope\n\nCloseableEscapesScope: a `Closeable` value escapes the `with ... as`\nblock that owns it. Closeable resources are released when the\nwith-block exits, so references that survive would be use-after-close.\n\nFix: keep the value inside the with-block, or copy out only the\ndata you need before the block ends.\n\n  with open(\"f.txt\") as f \{\n      let bytes = f.read_all()  // OK -- bytes is plain data\n      // return f               // E0601 -- f outlives the scope\n  \}\n\nPtrEscapesFfiScope: a `Ptr` allocated inside a `with ffi.scope() as\nscope` block escapes the block. The scope frees its allocations when\nthe block exits, so the escaped Ptr would dangle.\n\nFix: call `scope.take(p)` to detach the Ptr from the scope before it\nleaves the block.\n\n  with ffi.scope() as scope \{\n      let p: Ptr[Pollfd] = scope.alloc()\n      scope.take(p)             // OK -- detached, may now escape\n  \}"
    }
    if code == MUTATION_REQUIRES_MUT {
        return "E0610 -- MutationRequiresMut\n\nA mutating collection method was called on a binding declared with\nplain `let`. Mutating methods (List: `push`, `pop`, `set`, `clear`;\nMap: `insert`, `remove`, `clear`; Set: `insert`, `remove`) require\n`let mut`, so that every mutation source is visible at the binding.\n\nFix: declare the binding `let mut`, or build the new value with a\nnon-mutating method that returns a fresh collection (`concat`,\n`map`, `filter`).\n\n  let names = [\"Alice\"]\n  names.push(\"Dave\")       // E0610 -- names is not mut\n\n  let mut names = [\"Alice\"]\n  names.push(\"Dave\")       // OK"
    }
    if code == ARENA_TYPE_CONTAINS_CYCLE {
        return "E0701 -- ArenaTypeContainsCycle\n\nA value crossing the `with arena \{ \}` boundary has a type that\ncontains a reference cycle. The arena promotion walker copies\nreachable cells; a cycle would either loop forever or alias the\nsource.\n\nFix: break the cycle (e.g. via an Option indirection or a manual\ncopy step), or promote the value before exiting the arena.\n\n  type Node \{ next: Option[Node] \}   // OK -- Option breaks the cycle"
    }
    if code == ARENA_CLOSURE_TAIL_NONLITERAL {
        return "E0702a -- ArenaClosureTailNonLiteral\n\nThe tail of `with arena \{ ... \}` is a closure that is not bound by\na literal `fn \{ ... \}` inside the block. Promoting an existing\nclosure value out of the arena would require deep-copying its\ncaptured cells, which the descriptor walker does not yet support.\n\nFix: build the returned closure with a literal `fn` expression as\nthe tail, or move the closure construction outside the arena.\n\n  with arena \{\n      fn(x: Int) -> Int \{ x + 1 \}   // OK -- literal\n  \}"
    }
    if code == ARENA_CLOSURE_UNSUPPORTED_CAP {
        return "E0702d -- ArenaClosureUnsupportedCapture\n\nA closure returned from a `with arena \{ \}` block captures a value\nwhose kind the descriptor walker cannot promote (e.g. a mutable\nbinding, a Closeable, or a non-FFI struct with custom layout).\n\nFix: capture by value of a supported type, or restructure so the\nclosure is built outside the arena."
    }
    if code == SEALED_METHOD_OVERRIDE {
        return "E0731 -- SealedMethodOverride\n\nAn `impl` overrides a trait default method declared `final`. Sealed\ndefaults are derived views of the trait's required methods, so an\noverride could disagree with the method it derives from -- two\nvalues for the same observable property.\n\n`Display.display` is sealed: the compiler synthesizes\n`display() -> Str` from your `fmt` by rendering through a fresh\nStringBuilder. Defining `display` inside `impl Display` would let\n`x.display()` drift from what `x.fmt(sb)` writes.\n\nFix: implement the required method and delete the override.\n\n  impl Display for Point \{\n      fn fmt(self, sb: StringBuilder) \{ sb.write(\"...\") \}  // OK\n      // fn display(self) -> Str \{ ... \}                  // E0731\n  \}"
    }
    if code == TRAIT_CONTRACT_900 {
        return "E0900 -- TraitContractMissingMethod\n\nAn `impl Trait for Type` does not implement a method required by\nthe trait. Trait contracts enforce structural conformance: every\ntrait method must appear in the impl with a matching signature.\n\nFix: add the missing method to the impl, or remove the impl if it\nshould not satisfy the trait."
    }
    if code == TRAIT_CONTRACT_901 {
        return "E0901 -- TraitContractWrongArity\n\nA method in `impl Trait for Type` has a different number of\nparameters than the trait declares.\n\nFix: align the impl method's parameter list with the trait."
    }
    if code == TRAIT_CONTRACT_902 {
        return "E0902 -- TraitContractParamMismatch\n\nA parameter type in an impl method does not match the corresponding\nparameter in the trait declaration.\n\nFix: change the impl parameter type to match the trait, or change\nthe trait if the new type is intentional."
    }
    if code == TRAIT_CONTRACT_903 {
        return "E0903 -- TraitContractReturnMismatch\n\nAn impl method's return type does not match the trait's declared\nreturn type.\n\nFix: align the impl return type with the trait."
    }
    if code == TRAIT_CONTRACT_904 {
        return "E0904 -- TraitContractEffectMismatch\n\nAn impl method declares effects that differ from the trait. Impls\nmay declare a subset of the trait's effects but not a superset.\n\nFix: remove the extra effects from the impl, or widen the trait\nsignature if the new effects are intentional."
    }
    if code == TRAIT_CONTRACT_905 {
        return "E0905 -- TraitContractExtraMethod\n\nAn `impl Trait for Type` declares a method that is not part of the\ntrait. Impl blocks may only contain methods named by the trait.\n\nFix: move the extra method to a free `impl Type` block (inherent\nimpl), or add it to the trait declaration."
    }
    if code == TRAIT_CONTRACT_906 {
        return "E0906 -- TraitContractGenericMismatch\n\nAn impl method's generic-parameter list does not match the trait's\ngeneric-parameter list (count, kind, or bounds).\n\nFix: align the impl method's generics with the trait declaration."
    }
    if code == TRAIT_CONTRACT_907 {
        return "E0907 -- TraitContractSealedBuiltin\n\nTwo kinds of built-in are sealed and may not be implemented:\n\n1. The method-surface traits -- StrOps, BytesOps, StringBuildOps,\n   Sized, Contains, ListOps, MapOps, SetOps, Joinable -- are part\n   of the prelude. They back the built-in method dispatch on\n   Str/List/Map/Set/Bytes; user code may neither redefine one nor\n   write an `impl` of one.\n\n2. The sealed built-in TYPES -- Str, List, Map, Set, Bytes,\n   StringBuilder, Instant, Duration, Iterator (§3c.4), plus the\n   closed collection carrier Range -- are closed. `Iterator` is\n   opaque and lazy; naming one of these in the trait position of an\n   `impl` is a sealed-type violation, not an undefined trait.\n\nFix: choose a different name for your own trait, or define your own\ntrait with the methods you need and `impl` that instead.\n\n  trait StrOps \{ fn bogus(self) -> Int }   // E0907 -- redefines a sealed builtin\n  impl Contains for MyType \{ ... }          // E0907 -- impl of a sealed builtin trait\n  impl Iterator[Int] for MyType \{ ... }     // E0907 -- impl of a sealed builtin type"
    }
    if code == POLY_IMPL_UNSUPPORTED {
        return "E0908 -- PolyImplUnsupported\n\nA polymorphic impl header was found: `impl[T] Trait for Recv`,\n`impl Trait for Recv[Args]`, or a combination. Spec §3.6 defines\nthe canonical binding form `impl[T] Trait[T] for Recv[T]`, and the\nparser accepts it, but the compiler cannot yet generate code for\npolymorphic impls (tracked under project b1bdnh). Compilation stops\nbefore codegen so nothing miscompiles.\n\nFix: write a separate impl per concrete type for now.\n\n  impl[T] ListOps[T] for List[T] \{ ... }   // E0908 -- not yet compiled\n  impl Show for Box[Int] \{ ... }            // E0908 -- receiver type args\n  impl Show for IntBox \{ ... }              // OK -- concrete receiver"
    }
    if code == IMPL_BINDER_UNUSED {
        return "E0909 -- ImplBinderUnused\n\nA type-parameter binder declared after `impl` (e.g. `impl[T]`) is\nnot referenced anywhere in the impl header's type positions -- it\nappears in neither the trait's type arguments nor the receiver's\ntype arguments. An unused binder is unconstrained: no call site\ncould ever determine what type it stands for.\n\nFix: remove the binder, or use it in the header.\n\n  impl[T] Show for IntBox \{ ... }            // E0909 -- T never used\n  impl[T] Convert[T] for IntBox \{ ... }      // OK -- T binds the trait arg\n  impl[T] Show for Box[T] \{ ... }            // OK -- T binds the receiver arg"
    }
    if code == TRAIT_ARG_ARITY {
        return "E0910 -- TraitContractArgArity\n\nAn `impl` supplies the wrong number of type arguments for the\ntrait it implements. A trait declared `trait T[A, B]` has two type\nparameters, so an impl must write `impl T[X, Y] for Recv` -- one\nargument per parameter. Supplying too few leaves a trait type\nparameter unbound: the compiler has no type to check the method\nsignatures against, and cannot report a meaningful contract error.\n\nFix: supply one type argument per trait type parameter.\n\n  trait From2[T, U] \{ fn op(self, x: T, y: U) -> T }\n  impl[T] From2[T] for Box[T] \{ ... }        // E0910 -- 1 arg for 2 params\n  impl[T] From2[T, Int] for Box[T] \{ ... }   // OK -- both params bound"
    }
    if code == MISSING_SUPERTRAIT_IMPL {
        return "E0911 -- MissingSupertraitImpl\n\nA trait may declare supertraits: `trait Ranked: Ord` says every\ntype that implements Ranked must also implement Ord. This is the\nsoundness foundation of the licensing rule for `Self` in a default\nbody (E0305) -- a default body may call a supertrait's method on\n`Self` only because every implementor is guaranteed to provide it.\n\nSo an `impl` of a subtrait must satisfy each of the trait's\nsupertraits (transitively) for the receiver type. `@derive` counts\n(it auto-derives supertraits), as does an explicit `impl`. A\nbuilt-in receiver (Int, Str, ...) provides the built-in comparison\nand arithmetic traits intrinsically.\n\nFix: derive or implement the missing supertrait for the receiver.\n\n  trait Ranked: Ord \{ fn rank(self) -> Int }\n  type Foo \{ x: Int }\n  impl Ranked for Foo \{ ... }          // E0911 -- Foo does not implement Ord\n\n  @derive(Ord) type Foo \{ x: Int }     // OK -- derive provides Ord (and Eq)\n  impl Ranked for Int \{ ... }          // OK -- Int is Ord intrinsically"
    }
    if code == CIRCULAR_DEPENDENCY {
        return "E1002 -- CircularPackageDep\n\nThe lockfile contains a circular dependency between packages.\nPackage A depends on B, and B depends (transitively) on A.\n\nFix: break the cycle by extracting shared code into a third\npackage that both depend on, or remove the back-edge dependency.\n\n  // libs/A/blink.toml depends on B\n  // libs/B/blink.toml depends on A   // E1002 -- cycle"
    }
    if code == AMBIGUOUS_IMPORT {
        return "E1005 -- AmbiguousImport\n\nA bare imported name resolves to multiple modules. The compiler\ncannot pick one without explicit disambiguation.\n\nFix: rename one of the conflicting imports with `as`, or use a\nfully-qualified module path at the use site.\n\n  import http\n  import http2 as http   // E1005 -- both bind 'http'"
    }
    if code == IMPORT_NOT_SELECTED {
        return "E1006 -- ImportNotSelected\n\nA selective import (`import mod.\{a, b\}`) does not list the symbol\nbeing referenced. Selective imports are documentation: the listed\nsymbols are the ones explicitly used.\n\nFix: add the symbol to the import's brace list, or reference it\nvia the module name.\n\n  import std.list.\{push\}\n  push(xs, 1)   // OK\n  pop(xs)       // E1006 -- 'pop' not in list"
    }
    if code == MODULE_QUALIFIED_TYPE {
        return "E1007 -- ModuleQualifiedType\n\nA type was referenced via a module-qualified path that does not\nresolve to a public type in that module.\n\nFix: check the module path and the type name, and confirm the\ntype is `pub`.\n\n  let p: pkg.geom.Point = ...   // pkg.geom must export 'Point'"
    }
    if code == RAW_BYPASSES_PARAM {
        return "W0310 -- RawBypassesParam\n\n`Raw(...)` was used to inject text into a templated query, bypassing\nthe parameterization that prevents injection. Raw fragments must come\nfrom trusted sources.\n\nFix: pass user input through a parameter rather than `Raw`. Reserve\n`Raw` for compile-time-fixed fragments such as table or column names\nthat the parameterization machinery cannot represent.\n\n  let q = sql\"select * from \{Raw(table)\} where id = \{user_id\}\"\n\nIf the fragment is genuinely fixed and reviewed, suppress with\n`@trusted(audit: \"AUDIT-ID\")` on the enclosing function. This records\nan auditable trail, the same mechanism used for @ffi (W0800)."
    }
    ""
}
