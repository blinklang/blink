// E0840+ — toolchain / link integrity
// Guards the ABI-skew class of bug where a stdlib archive that is stale
// relative to the linking compiler is silently linked into a user binary,
// producing a memory-corrupting executable. The installed
// archive carries a `.archive-id` stamp (runtime.h SHA | libblink_std.h SHA |
// compiler SHA | version | monolith.c SHA); verify_installed_archive checks the
// two header SHAs, the compiler SHA and, when the stamp has it, the monolith.c
// SHA before producing a binary.
pub const INCOMPATIBLE_STDLIB_ARCHIVE = "E0840"
// A [lints] value that is not a level. A setting that could silence it could hide the very
// typo it reports, so nothing changes its severity (spec §4.16.8).
pub const INVALID_LINT_LEVEL = "E0843"

