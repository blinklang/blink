// emit_record.bl: the record that lets a per-module build reuse the last build's units.
//
// A per-module build always runs its front end, so it always resolves and loads the files of
// this build and reports their diagnostics. It then writes down everything the emit reads
// besides the program the front end built: the bytes of every file loaded and every file an
// `#embed` names, how each import resolved, the compiler, the build settings and the
// environment the compile path reads. These are the inputs. The emitted C is a function of
// them, so when the units directory holds a record of a build with the same inputs, and its
// files still hash as the record says, the build takes those files instead of emitting them.
// The units directory keeps the inputs as one text, and a build compares its own inputs to
// that text byte for byte: no hash of them can match while they differ.
//
// When the inputs differ, a build can still take some units. Beside each source's text, the
// inputs hold its interface text: its tokens without positions and without the inside of any
// fn body. The front end's facts about a node come from its own module's text and from the
// interfaces of the rest, as signatures, effects and types are declared. A unit's C is then a
// function of the inputs other than the texts of the program's own modules, of the headers
// every unit includes, and of the texts of the sources whose nodes its emit read beyond what
// an interface holds: the sources its IR spans, as a field default or a keyword-parameter
// default reaches a unit without a header, and each source whose fn body the emit lowers or
// reads, or whose node position it writes into the C. The emit marks that source at each
// point where it crosses into such a node (lower_fn, cc_forwarded_binding,
// unit_uses_async_scope, ir_line and ir_col); the node getters do not track reads, so a new
// crossing must mark its source too. The record lists, for each unit, the sources it read, and a
// build takes a unit when all of the rest is byte-equal to the last build's, every interface
// among it, and every source the unit read holds the same text. The entry unit reads every
// module's globals, so a build always emits it.
//
// A build writes its record into its private units directory only after its link succeeds,
// and that directory replaces the last one only after the record is in it. A build stopped
// part way leaves the last directory, whose record still describes its own files. A build
// whose emit reported a diagnostic writes no record, so the next build emits and reports it
// again.

import compiler.{loaded_inputs, import_map_paths, import_map_modules, import_map_source_modules, import_map_qualifiers, compiler_strict_struct_layout}
import diagnostics.{lint_override_lines}
import cg.{CgConfig}
import build_objcache
import build_fs

pub type EmittedUnit {
    module: Str
    c_bytes: Int
    // Every header in the units directory this unit includes, which its cache key covers.
    headers: List[Str]
    // The path of each loaded source whose nodes this unit's IR spanned, its own sources
    // among them. Empty when the build could not tell, and then no later build takes the
    // unit on its own.
    uses: List[Str]
    // The files cut off the unit, each compiled and cached as a unit is; the head, in
    // {module}.c, holds the rest. A build emits, or takes, all of a unit's files or none.
    chunks: List[UnitChunkFile]
}

pub type UnitChunkFile {
    stem: Str
    c_bytes: Int
    headers: List[Str]
}

// Every file of u, the head first.
pub fn unit_files(u: EmittedUnit) -> List[UnitChunkFile] {
    let mut out = [UnitChunkFile { stem: u.module, c_bytes: u.c_bytes, headers: u.headers }]
    for c in u.chunks { out.push(c) }
    out
}

// The units of a record this build took, and the shas of the files they are in, by the names
// build_objcache.unit_file_shas gives them.
pub type ReusedUnits {
    units: List[EmittedUnit]
    shas: Map[Str, Str]
}

let RECORD_NAME: Str = ".emit-record"
let RECORD_SCHEMA: Str = "emit-record-5"
let INPUTS_NAME: Str = ".emit-inputs"
// The last build's inputs text, linked into the new units directory, so the text a build
// compares is the one whose sha it checked against the record.
let LAST_INPUTS_NAME: Str = ".emit-inputs-last"

pub fn inputs_name() -> Str { INPUTS_NAME }

pub fn last_inputs_name() -> Str { LAST_INPUTS_NAME }

// The environment the compile path reads. BLINK_ROOT and HOME change where an import
// resolves, which the loaded files already show; the rest select another build or its
// parser, and are named so the record never has to argue that they could not matter.
let INPUT_ENV: List[Str] = ["BLINK_ROOT", "HOME", "BLINK_PARSER_PANIC_DUMP", "BLINK_SKIP_MODULES", "BLINK_ONLY_MODULE", "BLINK_COMPILER_ARCHIVE", "BLINK_PER_MODULE"]

// Each field carries its length, so no two different lists of fields give the same text.
fn add_input(sb: StringBuilder, tag: Str, value: Str) {
    sb.write("{tag} {value.byte_len()}\n")
    sb.write(value)
    sb.write("\n")
}

// The inputs of the emit of the program the front end last built, as one text.
pub fn inputs_text(source_path: Str, cfg: CgConfig, strict_mode: Int, compiler_sha: Str, argv0: Str, unit_chunk_decls: Int) -> Str {
    // On a large program the text is megabytes; reserved once, it leaves no garbage for the
    // collector from growing.
    let mut size = 4096
    for t in loaded_inputs.source_texts { size = size + t.byte_len() + 32 }
    for t in loaded_inputs.source_interfaces { size = size + t.byte_len() + 32 }
    for p in loaded_inputs.source_paths { size = size + p.byte_len() }
    for t in loaded_inputs.config_texts { size = size + t.byte_len() + 32 }
    for p in import_map_paths { size = size + p.byte_len() * 4 + 128 }
    for p in loaded_inputs.embed_paths { size = size + p.byte_len() + (loaded_inputs.embed_texts.get(p) ?? "").byte_len() + 32 }
    let sb = StringBuilder.with_capacity(size)
    add_input(sb, "schema", RECORD_SCHEMA)
    add_input(sb, "compiler", compiler_sha)
    add_input(sb, "argv0", argv0)
    add_input(sb, "cwd", env.cwd())
    add_input(sb, "source", source_path)
    add_input(sb, "debug", "{cfg.debug_mode}")
    add_input(sb, "trace_codegen", "{cfg.trace_codegen}")
    add_input(sb, "deterministic", "{cfg.deterministic}")
    add_input(sb, "emit_only_module", cfg.emit_only_module)
    add_input(sb, "user_tu_mode", "{cfg.user_tu_mode}")
    add_input(sb, "unit_chunk_decls", "{unit_chunk_decls}")
    add_input(sb, "strict", "{strict_mode}")
    add_input(sb, "strict_struct_layout", "{compiler_strict_struct_layout}")
    // A Map lists its keys in no fixed order, and the text must not change between builds.
    let mut skip: List[Str] = []
    for k in cfg.skip_modules.keys() { skip.push(k) }
    for k in build_objcache.sorted_strs(skip) {
        add_input(sb, "skip", k)
    }
    for name in INPUT_ENV {
        match env.var(name) {
            Some(v) => add_input(sb, "env {name}", v)
            None => add_input(sb, "unset", name)
        }
    }
    for line in build_objcache.sorted_strs(lint_override_lines()) {
        add_input(sb, "lint", line)
    }
    let mut i = 0
    while i < loaded_inputs.source_paths.len() {
        add_input(sb, "file", loaded_inputs.source_paths.get(i).unwrap())
        add_input(sb, "text", loaded_inputs.source_texts.get(i).unwrap())
        add_input(sb, "interface", loaded_inputs.source_interfaces.get(i) ?? "")
        i = i + 1
    }
    i = 0
    while i < loaded_inputs.config_paths.len() {
        add_input(sb, "config", loaded_inputs.config_paths.get(i).unwrap())
        add_input(sb, "config_text", loaded_inputs.config_texts.get(i).unwrap())
        i = i + 1
    }
    i = 0
    while i < import_map_paths.len() {
        add_input(sb, "import", import_map_paths.get(i).unwrap())
        add_input(sb, "module", import_map_modules.get(i) ?? "")
        add_input(sb, "source_module", import_map_source_modules.get(i) ?? "")
        add_input(sb, "qualifier", import_map_qualifiers.get(i) ?? "")
        i = i + 1
    }
    for p in loaded_inputs.embed_paths {
        add_input(sb, "embed", p)
        add_input(sb, "bytes", loaded_inputs.embed_texts.get(p) ?? "")
    }
    sb.to_str()
}

// The fields of an inputs text, in order.
type InputFields {
    tags: List[Str]
    values: List[Str]
}

// The fields of text, or None when it is not a whole inputs text.
fn parse_inputs(text: Str) -> Option[InputFields] {
    let mut tags: List[Str] = []
    let mut values: List[Str] = []
    let n = text.byte_len()
    let mut pos = 0
    while pos < n {
        let nl = match text.byte_index_of("\n", pos) {
            Some(i) => i
            None => return None
        }
        // A tag can hold a space ("env HOME"); the length is the last word.
        let words = text.byte_slice(pos, nl).split(" ")
        if words.len() < 2 { return None }
        let len_word = words.get(words.len() - 1).unwrap()
        let len = len_word.to_int()
        if len < 0 || "{len}" != len_word { return None }
        let start = nl + 1
        let end = start + len
        if end >= n || text.byte_slice(end, end + 1) != "\n" { return None }
        let mut tag_words: List[Str] = []
        let mut w = 0
        while w < words.len() - 1 {
            tag_words.push(words.get(w).unwrap())
            w = w + 1
        }
        tags.push(tag_words.join(" "))
        values.push(text.byte_slice(start, end))
        pos = end + 1
    }
    Some(InputFields { tags: tags, values: values })
}

// Writes the record of units into dir, whose .h and .c files shas names, with the inputs
// text beside it. A build that reused units, or hashed the text, already holds it in dir.
// False when the record was not written whole, and then no record is left in dir. A short
// inputs text is never taken, since a build compares all of it.
pub fn write_record(dir: Str, inputs: Str, units: List[EmittedUnit], shas: Map[Str, Str]) -> Bool {
    let inputs_path = "{dir}/{INPUTS_NAME}"
    if file_exists(inputs_path) != 1 {
        write_file(inputs_path, inputs)
    }
    let sb = StringBuilder.new()
    sb.write("{RECORD_SCHEMA}\ninputs {inputs.byte_len()} {shas.get(INPUTS_NAME) ?? "-"}\n")
    for u in units {
        sb.write("unit {u.module} {u.c_bytes} {u.headers.join(",")}\n")
        for c in u.chunks { sb.write("chunk {u.module} {c.stem} {c.c_bytes} {c.headers.join(",")}\n") }
        // A path is the rest of its line, so one that holds a line break cannot be read back,
        // and the unit is then left for a later build to emit.
        let mut whole = true
        for p in u.uses {
            if p.contains("\n") { whole = false }
        }
        if whole {
            for p in u.uses { sb.write("uses {u.module} {p}\n") }
        }
    }
    let mut files = 0
    // A Map lists its keys in an order its process's seed decides, and two builds of one tree
    // must write the same record.
    let mut names: List[Str] = []
    for name in shas.keys() { names.push(name) }
    for name in build_objcache.sorted_strs(names) {
        // The archive's files are named by path, and the inputs texts are not units; the
        // record holds only the units' files in dir.
        if name.contains("/") || name.starts_with(".") { continue }
        sb.write("file {name} {shas.get(name) ?? ""}\n")
        files = files + 1
    }
    sb.write("end\n")
    let path = "{dir}/{RECORD_NAME}"
    let text = sb.to_str()
    if files == 0 {
        return false
    }
    write_file(path, text)
    if file_exists(path) == 1 && read_file(path) == text {
        return true
    }
    shell_exec("rm -f \"{path}\"")
    false
}

type EmitRecord {
    inputs_len: Int
    // The sha of the inputs text beside the record, or "-" when the build did not hash it.
    inputs_sha: Str
    units: List[EmittedUnit]
    files: List[Str]
    shas: Map[Str, Str]
}

// The record in dir when it is whole. Only the inputs text beside it can show which inputs
// it records.
fn read_record(dir: Str) -> Option[EmitRecord] {
    let path = "{dir}/{RECORD_NAME}"
    if file_exists(path) != 1 {
        return None
    }
    let lines = read_file(path).split("\n")
    if lines.len() < 4 || lines.get(0).unwrap() != RECORD_SCHEMA {
        return None
    }
    let head = lines.get(1).unwrap().split(" ")
    if head.len() != 3 || head.get(0).unwrap() != "inputs" {
        return None
    }
    let mut units: List[EmittedUnit] = []
    let mut uses: Map[Str, List[Str]] = Map()
    let mut chunks: Map[Str, List[UnitChunkFile]] = Map()
    let mut files: List[Str] = []
    let mut shas: Map[Str, Str] = Map()
    let mut ended = false
    let mut i = 2
    while i < lines.len() {
        let line = lines.get(i).unwrap()
        i = i + 1
        if line == "" { continue }
        if ended { return None }
        if line == "end" {
            ended = true
            continue
        }
        if line.starts_with("uses ") {
            let sp = match line.byte_index_of(" ", 5) {
                Some(k) => k
                None => return None
            }
            let m = line.byte_slice(5, sp)
            let mut ps = uses.get(m) ?? []
            ps.push(line.byte_slice(sp + 1, line.byte_len()))
            uses.insert(m, ps)
            continue
        }
        let parts = line.split(" ")
        let kind = parts.get(0).unwrap()
        if kind == "unit" && parts.len() == 4 {
            let hs = parts.get(3).unwrap()
            units.push(EmittedUnit { module: parts.get(1).unwrap(), c_bytes: parts.get(2).unwrap().to_int(), headers: if hs == "" { [] } else { hs.split(",") }, uses: [], chunks: [] })
        } else if kind == "chunk" && parts.len() == 5 {
            let m = parts.get(1).unwrap()
            let hs = parts.get(4).unwrap()
            let mut cs = chunks.get(m) ?? []
            cs.push(UnitChunkFile { stem: parts.get(2).unwrap(), c_bytes: parts.get(3).unwrap().to_int(), headers: if hs == "" { [] } else { hs.split(",") } })
            chunks.insert(m, cs)
        } else if kind == "file" && parts.len() == 3 {
            files.push(parts.get(1).unwrap())
            shas.insert(parts.get(1).unwrap(), parts.get(2).unwrap())
        } else {
            return None
        }
    }
    if !ended || units.len() == 0 || files.len() == 0 {
        return None
    }
    let mut with_uses: List[EmittedUnit] = []
    for u0 in units {
        let u = EmittedUnit { uses: uses.get(u0.module) ?? [], chunks: chunks.get(u0.module) ?? [], ..u0 }
        for f in unit_files(u) {
            if !shas.contains_key("{f.stem}.c") { return None }
            for h in f.headers {
                if !shas.contains_key(h) { return None }
            }
        }
        with_uses.push(u)
    }
    Some(EmitRecord { inputs_len: head.get(1).unwrap().to_int(), inputs_sha: head.get(2).unwrap(), units: with_uses, files: files, shas: shas })
}

// Puts each of names from from_dir into to_dir, by a hard link or else by a copy. False when
// it could do neither.
fn link_or_copy(from_dir: Str, to_dir: Str, names: List[Str]) -> Bool ! IO {
    // A build never writes a file in a units directory once it replaced the last one, so
    // a hard link shares bytes that no longer change.
    let mut linked = true
    for n in names {
        if !build_fs.hard_link("{from_dir}/{n}", "{to_dir}/{n}") {
            linked = false
            break
        }
    }
    if linked { return true }
    // The copy is for a filesystem without hard links; it removes any link made first, since
    // a write would go through it. The files are C text, which holds no NUL byte, and the
    // caller hashes each where it lands.
    for n in names { fs_remove("{to_dir}/{n}") }
    for n in names {
        let src = "{from_dir}/{n}"
        let dst = "{to_dir}/{n}"
        if file_exists(src) != 1 { return false }
        write_file(dst, read_file(src))
        if file_exists(dst) != 1 { return false }
    }
    true
}

// The units of the record in from_dir whose inputs are `inputs`, with their files and the
// inputs text put in to_dir, which holds nothing else. Each file is hashed where it lands and
// must hash as the record says, and the inputs text is compared where it lands, so a file
// edited or replaced since the record was written is never taken. None, with to_dir left
// empty, when there is no such record or a file differs.
pub fn reuse(from_dir: Str, to_dir: Str, inputs: Str, arc_dir: Str) -> Option[ReusedUnits] ! IO {
    let rec = match read_record(from_dir) {
        Some(r) => r
        None => return None
    }
    if rec.inputs_len != inputs.byte_len() {
        return None
    }
    // Many edits keep the inputs as long as the last ones, and linking and hashing every file
    // only to find the text differs costs more than reading it.
    let last_inputs = "{from_dir}/{INPUTS_NAME}"
    if file_exists(last_inputs) != 1 || read_file(last_inputs) != inputs {
        return None
    }
    let mut names: List[Str] = []
    for f in rec.files { names.push(f) }
    names.push(INPUTS_NAME)
    let mut ok = link_or_copy(from_dir, to_dir, names)
    let mut shas: Map[Str, Str] = Map()
    if ok {
        match build_objcache.unit_file_shas_with(to_dir, arc_dir, [INPUTS_NAME]) {
            Some(s) => shas = s
            None => ok = false
        }
    }
    if ok {
        for f in rec.files {
            if (shas.get(f) ?? "") != (rec.shas.get(f) ?? "-") { ok = false }
        }
        if (shas.get(INPUTS_NAME) ?? "") != rec.inputs_sha { ok = false }
    }
    // Another build can replace from_dir between the read above and the link.
    if ok {
        let path = "{to_dir}/{INPUTS_NAME}"
        ok = file_exists(path) == 1 && read_file(path) == inputs
    }
    if !ok {
        for n in names { fs_remove("{to_dir}/{n}") }
        return None
    }
    Some(ReusedUnits { units: rec.units, shas: shas })
}

// The units a build takes from the last build's record while it emits the rest, what the
// files it took must hash as once they are in its units directory, and where place_taken
// puts the units' files from.
pub type TakenUnits {
    units: List[EmittedUnit]
    shas: Map[Str, Str]
    from_dir: Str
    to_dir: Str
    c_names: List[Str]
}

// Puts the files of the units taken into the units directory. False when it could not.
pub fn place_taken(taken: TakenUnits) -> Bool ! IO {
    link_or_copy(taken.from_dir, taken.to_dir, taken.c_names)
}

// The units of the record in from_dir, among candidates, that this build can take: the
// inputs other than the texts of the files in own (the sources of the program's modules)
// match the last build's, the headers in to_dir that names and texts give match the last
// build's, and every source each unit spanned holds the same text. The last build's inputs
// text, as the build read it, goes into to_dir as last_inputs_name(). The build runs
// place_taken on what it takes before it hashes to_dir, and checks in taken_units_hold that
// the files it took, the inputs text it read, and the headers it compared hash as the
// record says, so all a build compares is of one record. Nothing goes into to_dir before
// a unit is chosen, so a unit the build emits is never written through a link. None, with
// nothing written, when no unit can be taken.
pub fn take_units(from_dir: Str, to_dir: Str, inputs: Str, candidates: List[Str], own: Map[Str, Bool], names: List[Str], texts: List[Str]) -> Option[TakenUnits] {
    let rec = match read_record(from_dir) {
        Some(r) => r
        None => return None
    }
    if rec.inputs_sha == "-" { return None }
    let mut want: Map[Str, Bool] = Map()
    for m in candidates { want.insert(m, true) }
    let mut any = false
    for u in rec.units {
        if want.contains_key(u.module) && u.uses.len() > 0 { any = true }
    }
    if !any { return None }
    // The headers are what every unit reads of the modules it does not lower, so all of them
    // must be the last build's, and no more of them.
    let mut rec_headers = 0
    for f in rec.files {
        if f.ends_with(".h") { rec_headers = rec_headers + 1 }
    }
    if rec_headers != names.len() { return None }
    let mut i = 0
    while i < names.len() {
        let name = names.get(i).unwrap()
        if !rec.shas.contains_key(name) { return None }
        let path = "{from_dir}/{name}"
        if file_exists(path) != 1 || read_file(path) != texts.get(i).unwrap() { return None }
        i = i + 1
    }
    let last_inputs = "{from_dir}/{INPUTS_NAME}"
    if file_exists(last_inputs) != 1 { return None }
    let last_text = read_file(last_inputs)
    let both = match texts_if_same_but_own(last_text, inputs, own) {
        Some(t) => t
        None => return None
    }
    let texts_old = both.old
    let texts_new = both.new
    let mut taken: List[EmittedUnit] = []
    let mut c_names: List[Str] = []
    for u in rec.units {
        if !want.contains_key(u.module) || u.uses.len() == 0 { continue }
        let mut ok = true
        for p in u.uses {
            // A source no longer loaded has no text to match; one the other inputs hold
            // already matched with them.
            if !texts_new.contains_key(p) || texts_new.get(p) != texts_old.get(p) { ok = false }
        }
        if ok {
            taken.push(u)
            for f in unit_files(u) { c_names.push("{f.stem}.c") }
        }
    }
    if taken.len() == 0 { return None }
    // Written, not linked: these are the bytes the build compared, whatever from_dir holds by
    // the time it hashes them.
    write_file("{to_dir}/{LAST_INPUTS_NAME}", last_text)
    let mut shas: Map[Str, Str] = Map()
    for c in c_names { shas.insert(c, rec.shas.get(c) ?? "-") }
    for name in names { shas.insert(name, rec.shas.get(name) ?? "-") }
    shas.insert(LAST_INPUTS_NAME, rec.inputs_sha)
    Some(TakenUnits { units: taken, shas: shas, from_dir: from_dir, to_dir: to_dir, c_names: c_names })
}

// The text of each loaded source in two inputs texts, by its path.
type SourceTexts {
    old: Map[Str, Str]
    new: Map[Str, Str]
}

// The source texts of old_text and new_text when their fields are the same but for the text
// of each file own names. None when they differ anywhere else, or one is not whole.
fn texts_if_same_but_own(old_text: Str, new_text: Str, own: Map[Str, Bool]) -> Option[SourceTexts] {
    let o = match parse_inputs(old_text) {
        Some(f) => f
        None => return None
    }
    let n = match parse_inputs(new_text) {
        Some(f) => f
        None => return None
    }
    if o.tags.len() != n.tags.len() { return None }
    let mut texts_old: Map[Str, Str] = Map()
    let mut texts_new: Map[Str, Str] = Map()
    let mut i = 0
    while i < n.tags.len() {
        let tag = n.tags.get(i).unwrap()
        if o.tags.get(i).unwrap() != tag { return None }
        let is_text = tag == "text" && i > 0 && n.tags.get(i - 1).unwrap() == "file"
        let mut skip = false
        if is_text {
            // The file field before it already matched, so both texts are of one path.
            let path = n.values.get(i - 1).unwrap()
            texts_old.insert(path, o.values.get(i).unwrap())
            texts_new.insert(path, n.values.get(i).unwrap())
            skip = own.contains_key(path)
        }
        if !skip && o.values.get(i).unwrap() != n.values.get(i).unwrap() { return None }
        i = i + 1
    }
    Some(SourceTexts { old: texts_old, new: texts_new })
}

// Whether every file of taken hashes, in shas, as the record it came from says.
pub fn taken_units_hold(taken: TakenUnits, shas: Map[Str, Str]) -> Bool {
    for name in taken.shas.keys() {
        if (shas.get(name) ?? "") != (taken.shas.get(name) ?? "-") { return false }
    }
    true
}
