// emit_record.bl: the record that lets a per-module build reuse the last build's units.
//
// A per-module build always runs its front end, so it always resolves and loads the files of
// this build and reports their diagnostics. It then writes down everything the emit reads
// besides the program the front end built: the bytes of every file loaded and every file an
// `#embed` names, how each import resolved, the compiler, the build settings and the
// environment the compile path reads. These are the inputs. The emitted C is a function of
// them, so when the units directory holds a record of a build with the same inputs, and its
// files still hash as the record says, the build takes those files instead of emitting them.
// The units directory keeps the inputs as one text, and a build compares its own inputs to
// that text byte for byte: no hash of them can match while they differ.
//
// When the inputs differ, a build can still take some units. Beside each source's text, the
// inputs hold its interface text: its tokens without positions and without the inside of any
// fn body. The front end's facts about a node come from its own module's text and from the
// interfaces of the rest, as signatures, effects and types are declared. A unit's C is then a
// function of the inputs other than the texts of the program's own modules, of the headers
// every unit includes, and of the texts of the sources whose nodes its emit read beyond what
// an interface holds: the sources its IR spans, as a field default or a keyword-parameter
// default reaches a unit without a header, and each source whose fn body the emit lowers or
// reads, or whose node position it writes into the C. The emit marks that source at each
// point where it crosses into such a node (lower_fn, cc_forwarded_binding,
// unit_uses_async_scope, ir_line and ir_col); the node getters do not track reads, so a new
// crossing must mark its source too. The record lists, for each unit, the sources it read, and a
// build takes a unit when all of the rest is byte-equal to the last build's, and every source
// the unit read holds the same text. The entry unit's text also reads facts of the whole
// program no source span carries: main, spawns, the tests, the key tables, and the init call
// of each module with a run-time global, in module order. The record keeps their sha, and a
// build takes the entry unit only when they are the last build's.
//
// An interface may differ too, when only its imports and its items that are a fn under
// annotations that stay local, a trait with no annotation, a global or const with no
// annotation binding one name, or a test block differ. Blink has no wildcard import, and a fn
// or a global is found only by its name, so one an edit added, removed or changed can reach a
// unit's emit only through a source the unit read that holds its name as a word; such a unit
// is emitted. An annotation stays local when it changes only checks, the fn's own body, or the
// calls that name the fn (annotation_is_local). A trait prints no C; it reaches a unit through
// its impls and the bounds that name it, and through calls of its methods by name, so its own
// name and its methods' and associated types' names are its edited names. The traits the
// compiler reads by name from sources that never write it (Display for an interpolation, Eq
// for `==`, Closeable for `with`) take no unit. A unit prints another module's global only by
// its C name, and only the unit of the module that defines it lowers its initializer; whether
// it runs at start, and in what order, is in the entry unit's facts. A test block is in the
// program only when its module is the entry, whose tests the entry unit's facts list, so it
// adds no name. A type, an alias, an impl, an effect, any other annotation, or an annotated
// item that is not a fn still takes no unit: a type, an impl and an effect change the types
// header, an alias reorders declarations in the C of units that name nothing of it while no
// header changes, an impl reaches a unit through an operator or interpolation that names
// nothing, and an annotation can change what its item lowers to. What else the edit changes
// of the C a unit compiles is in the headers: the declaration lines the unit copies, and the
// types header. A unit is taken when the types header is byte-equal, its own module's
// headers are, it includes no changed header whole, and its files name no symbol whose
// declaration line an edited header added, removed, changed or moved. An import changes only
// how its own module resolves names, and that module's text changed, so its unit is emitted.
//
// Module m's headers are a function of m's declarations, the types header (which sets the
// typedef marks every header starts from) and the names of the instances m's generics have.
// A build that may take units keeps m's headers from the last build, by a link, when m's
// sources have the same interfaces and name no edited fn, global or const, and the types
// header and m's instance names, as one key, are what the record holds for m.
//
// A build writes its record into its private units directory only after its link succeeds,
// and that directory replaces the last one only after the record is in it. A build stopped
// part way leaves the last directory, whose record still describes its own files. A build
// whose emit reported a diagnostic writes no record, so the next build emits and reports it
// again.

import compiler.{loaded_inputs, import_map_paths, import_map_modules, import_map_source_modules, import_map_qualifiers, compiler_strict_struct_layout}
import ast.{dbg_trace}
import parser.{ITEM_MARK}
import build_unit_headers.{index_headers}
import cname.{c_module_header_name, c_module_private_header_name, c_program_types_header_name}
import diagnostics.{lint_override_lines}
import cg.{CgConfig}
import build_objcache
import std_cache_key
import build_fs

pub type EmittedUnit {
    module: Str
    c_bytes: Int
    // Every header in the units directory this unit includes, which its cache key covers.
    headers: List[Str]
    // The path of each loaded source whose nodes this unit's IR spanned, its own sources
    // among them. Empty when the build could not tell, and then no later build takes the
    // unit on its own.
    uses: List[Str]
    // The files cut off the unit, each compiled and cached as a unit is; the head, in
    // {module}.c, holds the rest. A build emits, or takes, all of a unit's files or none.
    chunks: List[UnitChunkFile]
}

pub type UnitChunkFile {
    stem: Str
    c_bytes: Int
    headers: List[Str]
}

// Every file of u, the head first.
pub fn unit_files(u: EmittedUnit) -> List[UnitChunkFile] {
    let mut out = [UnitChunkFile { stem: u.module, c_bytes: u.c_bytes, headers: u.headers }]
    for c in u.chunks { out.push(c) }
    out
}

// The units of a record this build took, and the shas of the files they are in, by the names
// build_objcache.unit_file_shas gives them.
pub type ReusedUnits {
    units: List[EmittedUnit]
    shas: Map[Str, Str]
    // The module headers in the order the units include them, and the key of each module's
    // headers, as the record holds them.
    order: Str
    header_keys: Map[Str, Str]
    entry_key: Str
}

let RECORD_NAME: Str = ".emit-record"
let RECORD_SCHEMA: Str = "emit-record-8"
let INPUTS_NAME: Str = ".emit-inputs"
// The last build's inputs text, linked into the new units directory, so the text a build
// compares is the one whose sha it checked against the record.
let LAST_INPUTS_NAME: Str = ".emit-inputs-last"

pub fn inputs_name() -> Str { INPUTS_NAME }

pub fn last_inputs_name() -> Str { LAST_INPUTS_NAME }

// The environment the compile path reads. BLINK_ROOT and HOME change where an import
// resolves, which the loaded files already show; the rest select another build or its
// parser, and are named so the record never has to argue that they could not matter.
let INPUT_ENV: List[Str] = ["BLINK_ROOT", "HOME", "BLINK_PARSER_PANIC_DUMP", "BLINK_SKIP_MODULES", "BLINK_ONLY_MODULE", "BLINK_COMPILER_ARCHIVE", "BLINK_PER_MODULE"]

// Each field carries its length, so no two different lists of fields give the same text.
fn add_input(sb: StringBuilder, tag: Str, value: Str) {
    sb.write("{tag} {value.byte_len()}\n")
    sb.write(value)
    sb.write("\n")
}

// The inputs of the emit of the program the front end last built, as one text.
pub fn inputs_text(source_path: Str, cfg: CgConfig, strict_mode: Int, compiler_sha: Str, argv0: Str, unit_chunk_decls: Int) -> Str {
    // On a large program the text is megabytes; reserved once, it leaves no garbage for the
    // collector from growing.
    let mut size = 4096
    for t in loaded_inputs.source_texts { size = size + t.byte_len() + 32 }
    for t in loaded_inputs.source_interfaces { size = size + t.byte_len() + 32 }
    for p in loaded_inputs.source_paths { size = size + p.byte_len() }
    for t in loaded_inputs.config_texts { size = size + t.byte_len() + 32 }
    for p in import_map_paths { size = size + p.byte_len() * 4 + 128 }
    for p in loaded_inputs.embed_paths { size = size + p.byte_len() + (loaded_inputs.embed_texts.get(p) ?? "").byte_len() + 32 }
    let sb = StringBuilder.with_capacity(size)
    add_input(sb, "schema", RECORD_SCHEMA)
    add_input(sb, "compiler", compiler_sha)
    add_input(sb, "argv0", argv0)
    add_input(sb, "cwd", env.cwd())
    add_input(sb, "source", source_path)
    add_input(sb, "debug", "{cfg.debug_mode}")
    add_input(sb, "test_build", "{cfg.test_build}")
    add_input(sb, "trace_codegen", "{cfg.trace_codegen}")
    add_input(sb, "deterministic", "{cfg.deterministic}")
    add_input(sb, "emit_only_module", cfg.emit_only_module)
    add_input(sb, "user_tu_mode", "{cfg.user_tu_mode}")
    add_input(sb, "unit_chunk_decls", "{unit_chunk_decls}")
    add_input(sb, "strict", "{strict_mode}")
    add_input(sb, "strict_struct_layout", "{compiler_strict_struct_layout}")
    // A Map lists its keys in no fixed order, and the text must not change between builds.
    let mut skip: List[Str] = []
    for k in cfg.skip_modules.keys() { skip.push(k) }
    for k in std_cache_key.sorted_strs(skip) {
        add_input(sb, "skip", k)
    }
    for name in INPUT_ENV {
        match env.var(name) {
            Some(v) => add_input(sb, "env {name}", v)
            None => add_input(sb, "unset", name)
        }
    }
    for line in std_cache_key.sorted_strs(lint_override_lines()) {
        add_input(sb, "lint", line)
    }
    let mut i = 0
    while i < loaded_inputs.source_paths.len() {
        add_input(sb, "file", loaded_inputs.source_paths.get(i).unwrap())
        add_input(sb, "text", loaded_inputs.source_texts.get(i).unwrap())
        add_input(sb, "interface", loaded_inputs.source_interfaces.get(i) ?? "")
        i = i + 1
    }
    i = 0
    while i < loaded_inputs.config_paths.len() {
        add_input(sb, "config", loaded_inputs.config_paths.get(i).unwrap())
        add_input(sb, "config_text", loaded_inputs.config_texts.get(i).unwrap())
        i = i + 1
    }
    i = 0
    while i < import_map_paths.len() {
        add_input(sb, "import", import_map_paths.get(i).unwrap())
        add_input(sb, "module", import_map_modules.get(i) ?? "")
        add_input(sb, "source_module", import_map_source_modules.get(i) ?? "")
        add_input(sb, "qualifier", import_map_qualifiers.get(i) ?? "")
        i = i + 1
    }
    for p in loaded_inputs.embed_paths {
        add_input(sb, "embed", p)
        add_input(sb, "bytes", loaded_inputs.embed_texts.get(p) ?? "")
    }
    sb.to_str()
}

// The fields of an inputs text, in order.
type InputFields {
    tags: List[Str]
    values: List[Str]
}

// The fields of text, or None when it is not a whole inputs text.
fn parse_inputs(text: Str) -> Option[InputFields] {
    let mut tags: List[Str] = []
    let mut values: List[Str] = []
    let n = text.byte_len()
    let mut pos = 0
    while pos < n {
        let nl = match text.byte_index_of("\n", pos) {
            Some(i) => i
            None => return None
        }
        // A tag can hold a space ("env HOME"); the length is the last word.
        let words = text.byte_slice(pos, nl).split(" ")
        if words.len() < 2 { return None }
        let len_word = words.get(words.len() - 1).unwrap()
        let len = len_word.to_int()
        if len < 0 || "{len}" != len_word { return None }
        let start = nl + 1
        let end = start + len
        if end >= n || text.byte_slice(end, end + 1) != "\n" { return None }
        let mut tag_words: List[Str] = []
        let mut w = 0
        while w < words.len() - 1 {
            tag_words.push(words.get(w).unwrap())
            w = w + 1
        }
        tags.push(tag_words.join(" "))
        values.push(text.byte_slice(start, end))
        pos = end + 1
    }
    Some(InputFields { tags: tags, values: values })
}

// Writes the record of units into dir, whose .h and .c files shas names, with the inputs
// text beside it. A build that reused units, or hashed the text, already holds it in dir.
// False when the record was not written whole, and then no record is left in dir. A short
// inputs text is never taken, since a build compares all of it.
pub fn write_record(dir: Str, inputs: Str, units: List[EmittedUnit], shas: Map[Str, Str], order: Str, header_keys: Map[Str, Str], entry_key: Str) -> Bool {
    let inputs_path = "{dir}/{INPUTS_NAME}"
    if file_exists(inputs_path) != 1 {
        write_file(inputs_path, inputs)
    }
    let sb = StringBuilder.new()
    sb.write("{RECORD_SCHEMA}\ninputs {inputs.byte_len()} {shas.get(INPUTS_NAME) ?? "-"}\n")
    sb.write("order {order}\n")
    if entry_key != "" && !entry_key.contains(" ") && !entry_key.contains("\n") {
        sb.write("entry {entry_key}\n")
    }
    let mut keyed: List[Str] = []
    for m in header_keys.keys() { keyed.push(m) }
    for m in std_cache_key.sorted_strs(keyed) {
        // A module key is one word, so one that is not is left out, and its headers are
        // generated again.
        if m.contains(" ") || m.contains("\n") { continue }
        sb.write("hkey {m} {header_keys.get(m) ?? ""}\n")
    }
    for u in units {
        sb.write("unit {u.module} {u.c_bytes} {u.headers.join(",")}\n")
        for c in u.chunks { sb.write("chunk {u.module} {c.stem} {c.c_bytes} {c.headers.join(",")}\n") }
        // A path is the rest of its line, so one that holds a line break cannot be read back,
        // and the unit is then left for a later build to emit.
        let mut whole = true
        for p in u.uses {
            if p.contains("\n") { whole = false }
        }
        if whole {
            for p in u.uses { sb.write("uses {u.module} {p}\n") }
        }
    }
    let mut files = 0
    // A Map lists its keys in an order its process's seed decides, and two builds of one tree
    // must write the same record.
    let mut names: List[Str] = []
    for name in shas.keys() { names.push(name) }
    for name in std_cache_key.sorted_strs(names) {
        // The archive's files are named by path, and the inputs texts are not units; the
        // record holds only the units' files in dir.
        if name.contains("/") || name.starts_with(".") { continue }
        sb.write("file {name} {shas.get(name) ?? ""}\n")
        files = files + 1
    }
    sb.write("end\n")
    let path = "{dir}/{RECORD_NAME}"
    let text = sb.to_str()
    if files == 0 {
        return false
    }
    write_file(path, text)
    if file_exists(path) == 1 && read_file(path) == text {
        return true
    }
    shell_exec("rm -f \"{path}\"")
    false
}

pub type EmitRecord {
    inputs_len: Int
    // The sha of the inputs text beside the record, or "-" when the build did not hash it.
    inputs_sha: Str
    units: List[EmittedUnit]
    files: List[Str]
    shas: Map[Str, Str]
    order: Str
    header_keys: Map[Str, Str]
    // The key of the facts the entry unit read that no source span carries, or "" when the
    // record holds none, and then no build takes the entry unit.
    entry_key: Str
}

// The record in dir when it is whole. Only the inputs text beside it can show which inputs
// it records.
fn read_record(dir: Str) -> Option[EmitRecord] {
    let path = "{dir}/{RECORD_NAME}"
    if file_exists(path) != 1 {
        return None
    }
    let lines = read_file(path).split("\n")
    if lines.len() < 4 || lines.get(0).unwrap() != RECORD_SCHEMA {
        return None
    }
    let head = lines.get(1).unwrap().split(" ")
    if head.len() != 3 || head.get(0).unwrap() != "inputs" {
        return None
    }
    let mut units: List[EmittedUnit] = []
    let mut uses: Map[Str, List[Str]] = Map()
    let mut chunks: Map[Str, List[UnitChunkFile]] = Map()
    let mut files: List[Str] = []
    let mut shas: Map[Str, Str] = Map()
    let mut order: Option[Str] = None
    let mut header_keys: Map[Str, Str] = Map()
    let mut entry_key = ""
    let mut ended = false
    let mut i = 2
    while i < lines.len() {
        let line = lines.get(i).unwrap()
        i = i + 1
        if line == "" { continue }
        if ended { return None }
        if line == "end" {
            ended = true
            continue
        }
        if line.starts_with("uses ") {
            let sp = match line.byte_index_of(" ", 5) {
                Some(k) => k
                None => return None
            }
            let m = line.byte_slice(5, sp)
            let mut ps = uses.get(m) ?? []
            ps.push(line.byte_slice(sp + 1, line.byte_len()))
            uses.insert(m, ps)
            continue
        }
        if line.starts_with("order ") {
            if order.is_some() { return None }
            order = Some(line.byte_slice(6, line.byte_len()))
            continue
        }
        let parts = line.split(" ")
        let kind = parts.get(0).unwrap()
        if kind == "unit" && parts.len() == 4 {
            let hs = parts.get(3).unwrap()
            units.push(EmittedUnit { module: parts.get(1).unwrap(), c_bytes: parts.get(2).unwrap().to_int(), headers: if hs == "" { [] } else { hs.split(",") }, uses: [], chunks: [] })
        } else if kind == "chunk" && parts.len() == 5 {
            let m = parts.get(1).unwrap()
            let hs = parts.get(4).unwrap()
            let mut cs = chunks.get(m) ?? []
            cs.push(UnitChunkFile { stem: parts.get(2).unwrap(), c_bytes: parts.get(3).unwrap().to_int(), headers: if hs == "" { [] } else { hs.split(",") } })
            chunks.insert(m, cs)
        } else if kind == "file" && parts.len() == 3 {
            files.push(parts.get(1).unwrap())
            shas.insert(parts.get(1).unwrap(), parts.get(2).unwrap())
        } else if kind == "hkey" && parts.len() == 3 {
            header_keys.insert(parts.get(1).unwrap(), parts.get(2).unwrap())
        } else if kind == "entry" && parts.len() == 2 && entry_key == "" {
            entry_key = parts.get(1).unwrap()
        } else {
            return None
        }
    }
    if !ended || units.len() == 0 || files.len() == 0 {
        return None
    }
    let order_text = match order {
        Some(o) => o
        None => return None
    }
    let mut with_uses: List[EmittedUnit] = []
    for u0 in units {
        let u = EmittedUnit { uses: uses.get(u0.module) ?? [], chunks: chunks.get(u0.module) ?? [], ..u0 }
        for f in unit_files(u) {
            if !shas.contains_key("{f.stem}.c") { return None }
            for h in f.headers {
                if !shas.contains_key(h) { return None }
            }
        }
        with_uses.push(u)
    }
    Some(EmitRecord { inputs_len: head.get(1).unwrap().to_int(), inputs_sha: head.get(2).unwrap(), units: with_uses, files: files, shas: shas, order: order_text, header_keys: header_keys, entry_key: entry_key })
}

// Puts each of names from from_dir into to_dir, by a hard link or else by a copy. False when
// it could do neither.
fn link_or_copy(from_dir: Str, to_dir: Str, names: List[Str]) -> Bool ! IO {
    // A build never writes a file in a units directory once it replaced the last one, so
    // a hard link shares bytes that no longer change.
    let mut linked = true
    for n in names {
        if !build_fs.hard_link("{from_dir}/{n}", "{to_dir}/{n}") {
            linked = false
            break
        }
    }
    if linked { return true }
    // The copy is for a filesystem without hard links; it removes any link made first, since
    // a write would go through it. The files are C text, which holds no NUL byte, and the
    // caller hashes each where it lands.
    for n in names { fs_remove("{to_dir}/{n}") }
    for n in names {
        let src = "{from_dir}/{n}"
        let dst = "{to_dir}/{n}"
        if file_exists(src) != 1 { return false }
        write_file(dst, read_file(src))
        if file_exists(dst) != 1 { return false }
    }
    true
}

// The units of the record in from_dir whose inputs are `inputs`, with their files and the
// inputs text put in to_dir, which holds nothing else. Each file is hashed where it lands and
// must hash as the record says, and the inputs text is compared where it lands, so a file
// edited or replaced since the record was written is never taken. None, with to_dir left
// empty, when there is no such record or a file differs.
pub fn reuse(from_dir: Str, to_dir: Str, inputs: Str, arc_dir: Str) -> Option[ReusedUnits] ! IO {
    let rec = match read_record(from_dir) {
        Some(r) => r
        None => return None
    }
    if rec.inputs_len != inputs.byte_len() {
        return None
    }
    // Many edits keep the inputs as long as the last ones, and linking and hashing every file
    // only to find the text differs costs more than reading it.
    let last_inputs = "{from_dir}/{INPUTS_NAME}"
    if file_exists(last_inputs) != 1 || read_file(last_inputs) != inputs {
        return None
    }
    let mut names: List[Str] = []
    for f in rec.files { names.push(f) }
    names.push(INPUTS_NAME)
    let mut ok = link_or_copy(from_dir, to_dir, names)
    let mut shas: Map[Str, Str] = Map()
    if ok {
        match build_objcache.unit_file_shas_with(to_dir, arc_dir, [INPUTS_NAME]) {
            Some(s) => shas = s
            None => ok = false
        }
    }
    if ok {
        for f in rec.files {
            if (shas.get(f) ?? "") != (rec.shas.get(f) ?? "-") { ok = false }
        }
        if (shas.get(INPUTS_NAME) ?? "") != rec.inputs_sha { ok = false }
    }
    // Another build can replace from_dir between the read above and the link.
    if ok {
        let path = "{to_dir}/{INPUTS_NAME}"
        ok = file_exists(path) == 1 && read_file(path) == inputs
    }
    if !ok {
        for n in names { fs_remove("{to_dir}/{n}") }
        return None
    }
    Some(ReusedUnits { units: rec.units, shas: shas, order: rec.order, header_keys: rec.header_keys, entry_key: rec.entry_key })
}

// The units a build takes from the last build's record while it emits the rest, what the
// files it took must hash as once they are in its units directory, and where place_taken
// puts the units' files from.
pub type TakenUnits {
    units: List[EmittedUnit]
    shas: Map[Str, Str]
    from_dir: Str
    to_dir: Str
    c_names: List[Str]
    // The files written beside the units only so that the build hashes what it compared. The
    // build removes them once it has.
    extras: List[Str]
}

// taken without unit m. The files written beside the units stay, so the build still removes
// them.
pub fn without_unit(taken: TakenUnits, m: Str) -> TakenUnits {
    let mut units: List[EmittedUnit] = []
    let mut gone: Map[Str, Bool] = Map()
    for u in taken.units {
        if u.module == m {
            for f in unit_files(u) { gone.insert("{f.stem}.c", true) }
        } else {
            units.push(u)
        }
    }
    let mut c_names: List[Str] = []
    for c in taken.c_names {
        if !gone.contains_key(c) { c_names.push(c) }
    }
    let mut shas: Map[Str, Str] = Map()
    for name in taken.shas.keys() {
        if !gone.contains_key(name) { shas.insert(name, taken.shas.get(name) ?? "-") }
    }
    TakenUnits { units: units, shas: shas, c_names: c_names, ..taken }
}

// Puts the files of the units taken into the units directory. False when it could not.
pub fn place_taken(taken: TakenUnits) -> Bool ! IO {
    link_or_copy(taken.from_dir, taken.to_dir, taken.c_names)
}

// How a build's inputs differ from the last build's.
pub type InputsDelta {
    // The text of each loaded source in the two inputs texts, by its path.
    texts_old: Map[Str, Str]
    texts_new: Map[Str, Str]
    // The name of each fn, global and const an edit added, removed or changed, once.
    names: List[Str]
    // Each source of the program's modules whose interface text differs.
    changed_interfaces: Map[Str, Bool]
}

// The last build, as a build that may take its units or headers compares it.
pub type LastBuild {
    from_dir: Str
    rec: EmitRecord
    // The inputs text beside the record, as this build read it.
    last_text: Str
    delta: InputsDelta
    // Each loaded source whose old or new text holds the name of an edited fn, global or const
    // as a word.
    hits: Map[Str, Bool]
}

// The record in from_dir, when this build's inputs differ from the ones it records only in
// the texts of the files own names, and in the items of their interfaces edited_names reads.
// builtin_traits are the trait names the compiler reads without a source writing them.
// None when there is no whole record, it names no sha of its inputs, or the inputs differ
// anywhere else.
pub fn last_build(from_dir: Str, inputs: Str, own: Map[Str, Bool], builtin_traits: List[Str]) -> Option[LastBuild] {
    let rec = match read_record(from_dir) {
        Some(r) => r
        None => return None
    }
    if rec.inputs_sha == "-" { return None }
    let last_inputs = "{from_dir}/{INPUTS_NAME}"
    if file_exists(last_inputs) != 1 { return None }
    let last_text = read_file(last_inputs)
    let delta = match inputs_delta(last_text, inputs, own, builtin_traits) {
        Some(d) => d
        None => {
            dbg_trace("build.units", "skip units: the inputs differ beyond plain items and imports")
            return None
        }
    }
    let mut hits: Map[Str, Bool] = Map()
    if delta.names.len() > 0 {
        dbg_trace("build.units", "edited names: {delta.names.join(",")}")
        for p in delta.texts_new.keys() {
            if names_any(delta.texts_new.get(p) ?? "", delta.names) || names_any(delta.texts_old.get(p) ?? "", delta.names) {
                hits.insert(p, true)
            }
        }
    }
    Some(LastBuild { from_dir: from_dir, rec: rec, last_text: last_text, delta: delta, hits: hits })
}

// The delta of new_text from old_text when their fields are the same but for the text of
// each file own names and the items of its interface edited_names reads. None when they
// differ anywhere else, or one is not whole.
fn inputs_delta(old_text: Str, new_text: Str, own: Map[Str, Bool], builtin_traits: List[Str]) -> Option[InputsDelta] {
    let o = match parse_inputs(old_text) {
        Some(f) => f
        None => return None
    }
    let n = match parse_inputs(new_text) {
        Some(f) => f
        None => return None
    }
    if o.tags.len() != n.tags.len() { return None }
    let mut texts_old: Map[Str, Str] = Map()
    let mut texts_new: Map[Str, Str] = Map()
    let mut names: List[Str] = []
    let mut named: Map[Str, Bool] = Map()
    let mut changed: Map[Str, Bool] = Map()
    let mut i = 0
    while i < n.tags.len() {
        let tag = n.tags.get(i).unwrap()
        if o.tags.get(i).unwrap() != tag { return None }
        let ov = o.values.get(i).unwrap()
        let nv = n.values.get(i).unwrap()
        // The file field before a text, and two before an interface, already matched, so both
        // values are of one path.
        let is_text = tag == "text" && i > 0 && n.tags.get(i - 1).unwrap() == "file"
        let is_interface = tag == "interface" && i > 1 && n.tags.get(i - 2).unwrap() == "file"
        let mut skip = false
        if is_text {
            let path = n.values.get(i - 1).unwrap()
            texts_old.insert(path, ov)
            texts_new.insert(path, nv)
            skip = own.contains_key(path)
        }
        if !skip && ov != nv {
            if !is_interface { return None }
            let path = n.values.get(i - 2).unwrap()
            if !own.contains_key(path) { return None }
            changed.insert(path, true)
            match edited_names(ov, nv, builtin_traits) {
                Some(fs) => {
                    for f in fs {
                        if !named.contains_key(f) {
                            named.insert(f, true)
                            names.push(f)
                        }
                    }
                }
                None => return None
            }
        }
        i = i + 1
    }
    Some(InputsDelta { texts_old: texts_old, texts_new: texts_new, names: names, changed_interfaces: changed })
}

// One top-level item of an interface text: the kind its mark gives, and its tokens.
type InterfaceItem {
    kind: Str
    text: Str
}

// The names of the fns, traits, globals and consts whose items differ between two interface
// texts of one source, taken as two multisets of items, so a moved item is not an edit. A
// trait gives its own name and the names of its methods and associated types. A test block
// adds no name: it is not in the program a build makes unless its module is the entry, whose
// tests the entry unit's facts list. None when an item that differs is not a fn under local
// annotations, a trait the compiler does not read by name, a global, const, test or import,
// or a text is not whole.
fn edited_names(old_text: Str, new_text: Str, builtin_traits: List[Str]) -> Option[List[Str]] {
    let o = match interface_items(old_text) {
        Some(items) => items
        None => return None
    }
    let n = match interface_items(new_text) {
        Some(items) => items
        None => return None
    }
    let mut count: Map[Str, Int] = Map()
    for it in o { count.insert(it.text, (count.get(it.text) ?? 0) + 1) }
    for it in n { count.insert(it.text, (count.get(it.text) ?? 0) - 1) }
    let mut all: List[InterfaceItem] = []
    for it in o { all.push(it) }
    for it in n { all.push(it) }
    let mut out: List[Str] = []
    for it in all {
        if (count.get(it.text) ?? 0) == 0 { continue }
        let words = it.kind.split(" ")
        let head = words.get(0) ?? ""
        if head == "fn" || head == "ann" {
            // "fn <name> @<annotation>..." or "ann <annotation> fn <name>".
            let name = if head == "fn" { words.get(1) ?? "" } else { words.get(3) ?? "" }
            let anns = if head == "fn" { words.slice(2, words.len()) } else { [words.get(1) ?? ""] }
            for a in anns {
                let ann = if a.starts_with("@") { a.byte_slice(1, a.byte_len()) } else { a }
                if !annotation_is_local(ann) {
                    dbg_trace("build.units", "skip units: fn {name} differs under @{ann}")
                    return None
                }
            }
            out.push(name)
        } else if head == "trait" {
            let name = words.get(1) ?? ""
            if builtin_traits.contains(name) {
                dbg_trace("build.units", "skip units: trait {name} differs, which the compiler reads by name")
                return None
            }
            for w in words.slice(1, words.len()) { out.push(w) }
        } else if head == "let" || head == "const" {
            out.push(words.get(1) ?? "")
        } else if it.kind != "import" && it.kind != "test" {
            dbg_trace("build.units", "skip units: an item of kind {it.kind} differs")
            return None
        }
    }
    Some(out)
}

// Whether an annotation on a fn reaches no unit but the fn's own and those that name the fn.
// @allow, @deprecated, @trusted, @pure and @modifies change checks and warnings, and print no
// C. @requires, @ensures and @verify print their checks in the fn's own body. @src prints
// nothing. @ffi changes the fn's own wrapper and how a call that names the fn is lowered; a
// binding over a native dependency's symbol changes the gates every unit reads, which reach
// the types header, so that edit takes no unit through the header check. The rest stay
// out: @tags feeds the test table of the entry unit, @expect_panic rewrites the body of the
// test that holds it, and an annotation not listed here may gain a reader anywhere.
fn annotation_is_local(name: Str) -> Bool {
    name == "allow" || name == "deprecated" || name == "trusted" || name == "pure" || name == "modifies" || name == "requires" || name == "ensures" || name == "verify" || name == "src" || name == "ffi"
}

// The items of an interface text, cut at each item mark the parser wrote, with the tokens
// before the first mark as one item of kind "lead". A comment changes no item, so its tokens
// are left out, and the line break it stood on with it.
fn interface_items(text: Str) -> Option[List[InterfaceItem]] {
    let mut out: List[InterfaceItem] = []
    let mut kind = "lead"
    let mut sb = StringBuilder.new()
    let mut last_newline = false
    let n = text.byte_len()
    let mut pos = 0
    while pos < n {
        let c1 = match text.byte_index_of(":", pos) {
            Some(c) => c
            None => return None
        }
        let klen_word = text.byte_slice(pos, c1)
        let klen = klen_word.to_int()
        if klen < 0 || "{klen}" != klen_word { return None }
        let kstart = c1 + 1
        let kend = kstart + klen
        if kend > n { return None }
        let c2 = match text.byte_index_of(":", kend) {
            Some(c) => c
            None => return None
        }
        let vlen_word = text.byte_slice(kend, c2)
        let vlen = vlen_word.to_int()
        if vlen < 0 || "{vlen}" != vlen_word { return None }
        let end = c2 + 1 + vlen
        if end > n { return None }
        let k = text.byte_slice(kstart, kend)
        if k == ITEM_MARK {
            out.push(InterfaceItem { kind: kind, text: sb.to_str() })
            kind = text.byte_slice(c2 + 1, end)
            sb = StringBuilder.new()
            last_newline = false
            sb.write(text.byte_slice(pos, end))
        } else if k != "COMMENT" && k != "DOC_COMMENT" && !(k == "NEWLINE" && last_newline) {
            last_newline = k == "NEWLINE"
            sb.write(text.byte_slice(pos, end))
        }
        pos = end
    }
    out.push(InterfaceItem { kind: kind, text: sb.to_str() })
    Some(out)
}

fn is_name_byte(b: U8) -> Bool {
    (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95
}

// Whether text holds one of names as a whole word. A match inside a string or a comment
// counts too, which costs only an emit.
pub fn names_any(text: Str, names: List[Str]) -> Bool {
    let n = text.byte_len()
    for name in names {
        if name == "" { continue }
        let mut from = 0
        while from < n {
            match text.byte_index_of(name, from) {
                Some(at) => {
                    let end = at + name.byte_len()
                    let starts = at == 0 || !is_name_byte(text.byte_at(at - 1))
                    let ends = end >= n || !is_name_byte(text.byte_at(end))
                    if starts && ends { return true }
                    // A name ends at a whole character, so `end` starts one.
                    from = end
                }
                None => from = n
            }
        }
    }
    false
}

// The names whose declaration line differs between two texts of one module header: each on
// a line one text has and the other lacks, or every name when the lines both have stand in
// another order. None when a text holds a line the scan cannot read, since every unit
// includes such a header whole.
fn changed_declarations(name: Str, old_text: Str, new_text: Str, types: Str) -> Option[List[Str]] {
    let od = match index_headers([name], [old_text], types).decls.get(name) {
        Some(ds) => ds
        None => return None
    }
    let nd = match index_headers([name], [new_text], types).decls.get(name) {
        Some(ds) => ds
        None => return None
    }
    let mut in_old: Map[Str, Bool] = Map()
    for d in od { in_old.insert(d.line, true) }
    let mut in_new: Map[Str, Bool] = Map()
    for d in nd { in_new.insert(d.line, true) }
    let mut out: List[Str] = []
    let mut common_old: List[Str] = []
    for d in od {
        if in_new.contains_key(d.line) { common_old.push(d.line) } else { out.push(d.name) }
    }
    let mut common_new: List[Str] = []
    for d in nd {
        if in_old.contains_key(d.line) { common_new.push(d.line) } else { out.push(d.name) }
    }
    // A unit copies the lines it uses in the header's order, so a move changes it too.
    if common_old.join("\n") != common_new.join("\n") {
        for d in od { out.push(d.name) }
        for d in nd { out.push(d.name) }
    }
    Some(out)
}

// Past this many changed declarations, scanning every taken unit for each costs more than
// it saves, so the build takes nothing.
let MAX_CHANGED_SYMBOLS: Int = 64

// The prefix of the copy of a changed header's last text that a build hashes, so that the
// text it compared is the one its record names.
let LAST_HEADER_PREFIX: Str = ".emit-last-"

// The units of the last build, among candidates, that this build can take. The inputs differ
// from the last build's at most as lb says. names and texts are the headers this build wrote
// into to_dir, the types header first, and same names those it linked from the last build
// as the record says they hash. The types header and the order of the module headers are the
// last build's. A unit is taken when every source it read holds the same text and none
// names an edited fn, global or const, its own module's headers are the last build's, and it
// includes no changed header whole, and its files in from_dir name no symbol whose
// declaration line a changed header added, removed or moved. The last build's inputs text, as
// the build read it, goes into to_dir as last_inputs_name(), with a copy of each changed
// header's last text. The build runs
// place_taken on what it takes before it hashes to_dir, and checks in taken_units_hold that
// the files it took, the texts it read, and the headers it compared hash as the record says,
// so all a build compares is of one record. Nothing goes into to_dir before a unit is
// chosen, so a unit the build emits is never written through a link. None, with nothing
// written, when no unit can be taken.
pub fn take_units(lb: LastBuild, to_dir: Str, candidates: List[Str], names: List[Str], texts: List[Str], order: List[Str], same: Map[Str, Bool]) -> Option[TakenUnits] {
    let rec = lb.rec
    let from_dir = lb.from_dir
    let mut want: Map[Str, Bool] = Map()
    for m in candidates { want.insert(m, true) }
    let mut any = false
    for u in rec.units {
        if want.contains_key(u.module) && u.uses.len() > 0 { any = true }
    }
    if !any { return None }
    if rec.order != order.join(",") {
        dbg_trace("build.units", "skip units: the module headers differ in name or order")
        return None
    }
    // The headers are what every unit reads of the modules it does not lower, so this build
    // must have the last build's headers, and no more of them.
    let mut rec_headers = 0
    for f in rec.files {
        if f.ends_with(".h") { rec_headers = rec_headers + 1 }
    }
    if rec_headers != names.len() { return None }
    let types = c_program_types_header_name()
    let mut changed: Map[Str, Bool] = Map()
    let mut changed_names: List[Str] = []
    let mut old_texts: List[Str] = []
    let mut symbols: List[Str] = []
    let mut seen_symbol: Map[Str, Bool] = Map()
    let mut i = 0
    while i < names.len() {
        let name = names.get(i).unwrap()
        i = i + 1
        if !rec.shas.contains_key(name) { return None }
        if same.contains_key(name) { continue }
        let path = "{from_dir}/{name}"
        if file_exists(path) != 1 { return None }
        let old = read_file(path)
        let text = texts.get(i - 1).unwrap()
        if old == text { continue }
        if name == types {
            dbg_trace("build.units", "skip units: the types header differs")
            return None
        }
        let ds = match changed_declarations(name, old, text, types) {
            Some(d) => d
            None => {
                dbg_trace("build.units", "skip units: every unit includes {name} whole")
                return None
            }
        }
        for d in ds {
            if !seen_symbol.contains_key(d) {
                seen_symbol.insert(d, true)
                symbols.push(d)
            }
        }
        changed.insert(name, true)
        changed_names.push(name)
        old_texts.push(old)
    }
    if symbols.len() > MAX_CHANGED_SYMBOLS {
        dbg_trace("build.units", "skip units: {symbols.len()} declarations changed")
        return None
    }
    let mut taken: List[EmittedUnit] = []
    let mut c_names: List[Str] = []
    for u in rec.units {
        if !want.contains_key(u.module) { continue }
        let mut why = unit_kept_from(lb, u, changed)
        // The files are scanned where they are, before any is placed; if from_dir changes
        // after, what the build places does not hash as the record says, and it is emitted.
        if why == "" && symbols.len() > 0 && unit_names_any(from_dir, u, symbols) {
            why = "it names a changed declaration"
        }
        if why != "" {
            dbg_trace("build.units", "skip unit {u.module}: {why}")
            continue
        }
        taken.push(u)
        for f in unit_files(u) { c_names.push("{f.stem}.c") }
    }
    if taken.len() == 0 { return None }
    // Written, not linked: these are the bytes the build compared, whatever from_dir holds by
    // the time it hashes them.
    write_file("{to_dir}/{LAST_INPUTS_NAME}", lb.last_text)
    let mut extras = [LAST_INPUTS_NAME]
    let mut shas: Map[Str, Str] = Map()
    for c in c_names { shas.insert(c, rec.shas.get(c) ?? "-") }
    for name in names {
        if !changed.contains_key(name) { shas.insert(name, rec.shas.get(name) ?? "-") }
    }
    let mut j = 0
    while j < changed_names.len() {
        let name = changed_names.get(j).unwrap()
        let copy = "{LAST_HEADER_PREFIX}{name}"
        write_file("{to_dir}/{copy}", old_texts.get(j).unwrap())
        extras.push(copy)
        shas.insert(copy, rec.shas.get(name) ?? "-")
        j = j + 1
    }
    shas.insert(LAST_INPUTS_NAME, rec.inputs_sha)
    Some(TakenUnits { units: taken, shas: shas, from_dir: from_dir, to_dir: to_dir, c_names: c_names, extras: extras })
}

// Why unit u of the last build cannot be taken, or "" when it can as far as the sources it
// read and the headers it includes go.
fn unit_kept_from(lb: LastBuild, u: EmittedUnit, changed: Map[Str, Bool]) -> Str {
    if u.uses.len() == 0 { return "the record lists no source it read" }
    for p in u.uses {
        // A source no longer loaded has no text to match; one the other inputs hold already
        // matched with them.
        if !lb.delta.texts_new.contains_key(p) || lb.delta.texts_new.get(p) != lb.delta.texts_old.get(p) {
            return "{p} changed"
        }
        if lb.hits.contains_key(p) { return "{p} names an edited name" }
    }
    // A module's own headers hold its instances, whose bodies its unit writes.
    if changed.contains_key(c_module_header_name(u.module)) || changed.contains_key(c_module_private_header_name(u.module)) {
        return "its own header changed"
    }
    for f in unit_files(u) {
        for h in f.headers {
            if changed.contains_key(h) { return "it includes {h} whole" }
        }
    }
    ""
}

// Whether a file of unit u in dir names one of symbols.
fn unit_names_any(dir: Str, u: EmittedUnit, symbols: List[Str]) -> Bool {
    for f in unit_files(u) {
        if names_any(read_file("{dir}/{f.stem}.c"), symbols) { return true }
    }
    false
}

// Whether module m's headers may be the last build's without being generated: no source of m
// changed its interface or names an edited fn, global or const, and key, which covers the
// types header and the instances of m's generics, is the one the record holds for m.
pub fn headers_unchanged(lb: LastBuild, m: Str, key: Str) -> Bool {
    if (lb.rec.header_keys.get(m) ?? "") != key { return false }
    let paths = loaded_inputs.source_paths
    let modules = loaded_inputs.source_modules
    let mut i = 0
    while i < paths.len() && i < modules.len() {
        if modules.get(i).unwrap() == m {
            let p = paths.get(i).unwrap()
            if lb.delta.changed_interfaces.contains_key(p) || lb.hits.contains_key(p) { return false }
        }
        i = i + 1
    }
    true
}

// The texts of names, put into to_dir from the last build's units directory. None, with none
// of them left in to_dir, when the record holds no sha for one or a link fails. The caller
// checks each against the record's sha when it hashes the whole directory, so no header is
// hashed twice.
pub fn link_last_files(lb: LastBuild, to_dir: Str, names: List[Str]) -> Option[List[Str]] ! IO {
    for n in names {
        if !lb.rec.shas.contains_key(n) { return None }
    }
    if !link_or_copy(lb.from_dir, to_dir, names) {
        for n in names { fs_remove("{to_dir}/{n}") }
        return None
    }
    let mut texts: List[Str] = []
    for n in names { texts.push(read_file("{to_dir}/{n}")) }
    Some(texts)
}

// Puts text into to_dir as name: a link to the file of the last units directory when that
// holds the same bytes, so a header whose text did not change keeps the last build's file,
// and else a file of its own.
pub fn keep_or_write(from_dir: Str, to_dir: Str, name: Str, text: Str) ! IO {
    let old = "{from_dir}/{name}"
    let path = "{to_dir}/{name}"
    if from_dir != "" && file_exists(old) == 1 && read_file(old) == text && build_fs.hard_link(old, path) {
        // Another build can replace from_dir between the read and the link.
        if read_file(path) == text { return }
        fs_remove(path)
    }
    write_file(path, text)
}

// Whether each header in kept hashes, in shas, as the last build's record says.
pub fn kept_headers_hold(lb: LastBuild, kept: Map[Str, Bool], shas: Map[Str, Str]) -> Bool {
    for name in kept.keys() {
        if (shas.get(name) ?? "") != (lb.rec.shas.get(name) ?? "-") { return false }
    }
    true
}

// Whether every file of taken hashes, in shas, as the record it came from says.
pub fn taken_units_hold(taken: TakenUnits, shas: Map[Str, Str]) -> Bool {
    for name in taken.shas.keys() {
        if (shas.get(name) ?? "") != (taken.shas.get(name) ?? "-") { return false }
    }
    true
}

// Why a unit the build wrote or took is not the unit a cold emit writes, for the verify
// error: each source the cold emit read that the unit's uses leave out, or, when none is left
// out, that the key of the entry unit leaves out a fact of the whole program; then the first
// line that differs.
pub fn verify_differ_reason(m: Str, taken_uses: List[Str], cold_uses: List[Str], built: Str, cold: Str) -> Str {
    let mut missing: List[Str] = []
    for p in cold_uses {
        if !taken_uses.contains(p) { missing.push(p) }
    }
    let why = if missing.len() > 0 {
        "the cold emit read {missing.join(", ")}, which the unit did not mark"
    } else if m == "__main__" {
        "every source the cold emit read is marked, so the entry key leaves out a fact of the whole program that differs"
    } else {
        "every source the cold emit read is marked"
    }
    "{why}; {first_differing_line(built, cold)}"
}

fn first_differing_line(built: Str, cold: Str) -> Str {
    let bl = built.split("\n")
    let cl = cold.split("\n")
    let mut i = 0
    while i < bl.len() || i < cl.len() {
        let b = bl.get(i)
        let c = cl.get(i)
        if b != c {
            return "line {i + 1} is {quoted_line(b)} here and {quoted_line(c)} in the cold emit"
        }
        i = i + 1
    }
    "no line differs"
}

fn quoted_line(line: Option[Str]) -> Str {
    match line {
        Some(s) => if s.byte_len() > 120 { "`{s.byte_slice(0, 120)}...`" } else { "`{s}`" }
        None => "past the end"
    }
}
