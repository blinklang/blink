import ast.{NodeKind}
import parser.{
    node_kind, node_name, node_left, node_right, node_body, node_condition,
    node_then_body, node_else_body, node_scrutinee, node_guard, node_value,
    node_target, node_iterable, node_obj, node_method, node_params, node_args,
    node_stmts, node_arms, node_fields, node_elements, node_handlers,
    node_type_name, node_effects, node_str_val, node_op, node_type_ann,
    node_pattern, node_for_binder, node_value_child_ids, sublist_get, sublist_length,
}
import diagnostics.{
    Diag, diag_error_at, diag_warn_at, diag_set_last_fix,
    diag_source_file, diag_file_for_node,
    diag_push_allows, diag_clear_allows,
    ARENA_VALUE_ESCAPES, ARENA_TYPE_CONTAINS_CYCLE, ARENA_EFFECT_REDUNDANT,
    ARENA_CLOSURE_TAIL_NONLITERAL, CLOSEABLE_ESCAPES_SCOPE,
}
import typecheck.{
    TyKind, tc_call_decl_is_fn, tc_call_decl_node, tc_fn_has_effect, tc_lookup_node_tid,
    tc_resolve, tc_tid_child, tc_tid_decl_node, tc_tid_kind,
    tc_ident_binder_node, tc_tid_is_pointer_bearing, tc_tid_reaches_itself, tc_type_str,
}
import free_names.{closure_read_idents, pattern_names, push_param_names}

// Arena escape analysis: classifies allocations inside `with arena { }` as
// promoted (tail-position return) or escaped (emits E0700).

let mut ea_promote_nodes: List[Int] = []
let mut ea_promote_types: List[Str] = []

fn find_promote_idx(node_id: Int) -> Int {
    let mut i = 0
    while i < ea_promote_nodes.len() {
        if ea_promote_nodes.get(i).unwrap() == node_id { return i }
        i = i + 1
    }
    -1
}

pub fn ea_is_promoted(node_id: Int) -> Int {
    if find_promote_idx(node_id) >= 0 { 1 } else { 0 }
}

pub fn ea_promoted_type(node_id: Int) -> Str {
    let idx = find_promote_idx(node_id)
    if idx < 0 { return "" }
    ea_promote_types.get(idx).unwrap()
}

fn record_promote(node_id: Int, type_name: Str) {
    if find_promote_idx(node_id) >= 0 {
        return
    }
    ea_promote_nodes.push(node_id)
    ea_promote_types.push(type_name)
}

// E0701: a value that crosses an arena boundary is copied out by a walker generated for
// its type, and a walker for a type that holds itself would never stop. The boundaries are
// a `with arena` value, and a `return` or `?` that leaves an arena of its own body, where
// the value crossing is the body's result type. Each body records that type and how many
// arena frames were open when it began, so a closure's `return` does not cross the arena
// the closure was written in.
let mut ea_body_ret_tids: List[Int] = []
let mut ea_body_frame_base: List[Int] = []
let mut ea_cycle_reported: Map[Int, Int] = Map()

fn ea_push_body(ret_tid: Int) {
    ea_body_ret_tids.push(ret_tid)
    ea_body_frame_base.push(ea_frames.len())
}

fn ea_pop_body() {
    let _ = ea_body_ret_tids.pop()
    let _ = ea_body_frame_base.pop()
}

// The result type of the innermost body when an arena of that body is open, else -1.
fn ea_exit_crossing_tid() -> Int {
    let n = ea_body_ret_tids.len()
    if n == 0 { return -1 }
    if ea_frames.len() <= ea_body_frame_base.get(n - 1).unwrap() { return -1 }
    ea_body_ret_tids.get(n - 1).unwrap()
}

fn check_promote_cycle(node: Int, tid: Int) ! Diag.Report {
    let _ = ea_refuse_recursive_crossing(node, tid)
}

// Whether `tid` holds itself, reporting E0701 at `node` the first time a type does. Code
// generation asks too, for the instances of a generic body: this pass sees the body once,
// over its type parameters, and a parameter can stand for a recursive type.
@allow(UnrestoredMutation, IncompleteStateRestore)
pub fn ea_refuse_recursive_crossing(node: Int, tid: Int) -> Bool ! Diag.Report {
    if tid < 0 { return false }
    let hit = tc_tid_reaches_itself(tid)
    if hit < 0 { return false }
    let decl = tc_tid_decl_node(hit)
    let key = if decl >= 0 { decl } else { hit }
    if ea_cycle_reported.contains_key(key) { return true }
    ea_cycle_reported.insert(key, 1)
    let crossing = tc_type_str(tc_resolve(tid))
    let owner = tc_type_str(hit)
    let saved = diag_source_file
    diag_source_file = diag_file_for_node(node)
    diag_error_at(
        "ArenaTypeContainsCycle", ARENA_TYPE_CONTAINS_CYCLE,
        "`{crossing}` leaves the arena, and type `{owner}` holds a value of its own type; arena promotion cannot copy a recursive type",
        node,
        "build this value outside the `with arena \{ }` block, or return a part of it whose type does not hold itself"
    )
    diag_source_file = saved
    true
}

let mut ea_safe_intrinsics: Map[Str, Int] = Map()

fn init_safe_intrinsics() {
    if ea_safe_intrinsics.len() > 0 { return }
    ea_safe_intrinsics.insert("print", 1)
    ea_safe_intrinsics.insert("println", 1)
    ea_safe_intrinsics.insert("eprintln", 1)
    ea_safe_intrinsics.insert("len", 1)
    ea_safe_intrinsics.insert("assert", 1)
    ea_safe_intrinsics.insert("assert_eq", 1)
    ea_safe_intrinsics.insert("assert_ne", 1)
    // Qualified safe sinks: io.* output methods consume their arg without
    // letting it escape, same as the bare println surface.
    ea_safe_intrinsics.insert("io.print", 1)
    ea_safe_intrinsics.insert("io.println", 1)
    ea_safe_intrinsics.insert("io.eprint", 1)
    ea_safe_intrinsics.insert("io.eprintln", 1)
    ea_safe_intrinsics.insert("io.log", 1)
}

// W0701 ArenaEffectRedundant state. `declares_arena` gates the hot-path
// effect lookup in walk_call so we only pay for fns that could raise W0701.
// ── Closure tails (§5.2.1 clause 7) ──────────────────────────────────────
//
// A closure that crosses an arena is copied out through its capture descriptors, so each
// capture needs a walker, and the closure must be a literal written in the block: a
// closure a call made carries captures this pass cannot see. A binder records the node
// its value came from, so `let b = a` leads back to the literal `a` names.

let mut ea_bind_names: List[Str] = []
let mut ea_bind_values: List[Int] = []
let mut ea_bind_depths: List[Int] = []
let mut ea_bind_marks: List[Int] = []

// The names assigned inside each open arena frame, parallel to ea_frames. A closing frame
// hands its names to its parent: an assignment in a nested arena is one in the outer too.
let mut ea_assigned: List[List[Str]] = []

// The first arena frame, counted from 1, that a tail at this point crosses; 0 for none.
let mut ea_tail_floor: Int = 0

let mut ea_promoted_closures: Map[Int, Int] = Map()
let mut ea_closure_parent: Map[Int, Int] = Map()
let mut ea_closure_stack: List[Int] = []

// A closure that captures a value allocated in the arena lets it escape unless the closure
// is promoted, which is known only once the tail is seen, so the report waits for the
// frame to close.
let mut ea_cc_owner: Int = -1
let mut ea_pending_idents: List[Int] = []
let mut ea_pending_owners: List[Int] = []
let mut ea_pending_depths: List[Int] = []

fn ea_reset_closure_state() {
    ea_bind_names = []
    ea_bind_values = []
    ea_bind_depths = []
    ea_bind_marks = []
    ea_assigned = []
    ea_tail_floor = 0
    ea_closure_stack = []
    ea_cc_owner = -1
    ea_pending_idents = []
    ea_pending_owners = []
    ea_pending_depths = []
}

fn ea_push_binds() {
    ea_bind_marks.push(ea_bind_names.len())
}

fn ea_pop_binds() {
    let mark = ea_bind_marks.pop() ?? 0
    while ea_bind_names.len() > mark {
        let _ = ea_bind_names.pop()
        let _ = ea_bind_values.pop()
        let _ = ea_bind_depths.pop()
    }
}

// `value` is the node the binder's value came from, or -1 for a parameter or a pattern.
fn ea_bind(name: Str, value: Int) {
    if name == "" { return }
    ea_bind_names.push(name)
    ea_bind_values.push(value)
    ea_bind_depths.push(ea_frames.len())
}

fn ea_bind_all(names: List[Str]) {
    for n in names { ea_bind(n, -1) }
}

fn ea_bind_pattern(pat: Int) {
    let mut names: List[Str] = []
    pattern_names(pat, names)
    ea_bind_all(names)
}

// The innermost binder of `name`, or -1 for a global, a function or a module.
fn ea_lookup_bind(name: Str) -> Int {
    let mut i = ea_bind_names.len() - 1
    while i >= 0 {
        if ea_bind_names.get(i).unwrap() == name { return i }
        i = i - 1
    }
    -1
}

fn ea_note_assigned(name: Str) {
    if ea_assigned.len() == 0 { return }
    let mut top = ea_assigned.get(ea_assigned.len() - 1).unwrap()
    if !top.contains(name) { top.push(name) }
}

fn ea_pop_assigned() {
    let names = ea_assigned.pop() ?? []
    if ea_assigned.len() == 0 { return }
    let mut parent = ea_assigned.get(ea_assigned.len() - 1).unwrap()
    for n in names {
        if !parent.contains(n) { parent.push(n) }
    }
}

fn ea_assigned_since(name: Str, floor: Int) -> Bool {
    let mut f = floor - 1
    while f < ea_assigned.len() {
        if f >= 0 && ea_assigned.get(f).unwrap().contains(name) { return true }
        f = f + 1
    }
    false
}

fn ea_tail_crosses() -> Bool {
    ea_tail_floor > 0 && ea_frames.len() >= ea_tail_floor
}

fn is_fn_typed(node: Int) -> Bool {
    let tid = tc_lookup_node_tid(node)
    if tid < 0 { return false }
    tc_tid_kind(tc_resolve(tid)) == TyKind.Fn
}

// Whether escape analysis promotes this closure literal out of an arena. Code generation
// asks when a capture of it has no walker, which this pass reports first.
pub fn ea_closure_is_promoted(closure: Int) -> Bool {
    ea_promoted_closures.contains_key(closure)
}

fn ea_closure_or_ancestor_promoted(closure: Int) -> Bool {
    let mut c = closure
    while c >= 0 {
        if ea_promoted_closures.contains_key(c) { return true }
        c = ea_closure_parent.get(c) ?? -1
    }
    false
}

// A tail that crosses the arena: a closure in it must be a literal bound in the block, and
// every literal the crossing value holds is promoted.
fn classify_tail(node: Int) ! Diag.Report {
    let k = node_kind(node)
    if k == NodeKind.TupleLit || k == NodeKind.ListLit {
        let sl = node_elements(node)
        let mut i = 0
        while sl != -1 && i < sublist_length(sl) {
            let _ = fn_origin_is_call(sublist_get(sl, i), ea_tail_floor)
            i = i + 1
        }
        return
    }
    if k == NodeKind.StructLit {
        let sl = node_fields(node)
        let mut i = 0
        while sl != -1 && i < sublist_length(sl) {
            let _ = fn_origin_is_call(node_value(sublist_get(sl, i)), ea_tail_floor)
            i = i + 1
        }
        return
    }
    if call_builds_variant(node) {
        let _ = variant_args_from_call(node, ea_tail_floor)
        return
    }
    let leaf = k == NodeKind.Closure || k == NodeKind.Ident || k == NodeKind.Call || k == NodeKind.MethodCall || k == NodeKind.FieldAccess || k == NodeKind.IndexExpr
    if !leaf || !is_fn_typed(node) { return }
    if fn_origin_is_call(node, ea_tail_floor) { emit_closure_tail_nonliteral(node) }
}

// Whether the value of `node` may be a closure a call made inside the crossed frames. A
// closure literal it reaches is promoted on the way. A binder from outside the block
// names a closure that was never arena memory, and a parameter or pattern binder inside
// names a value built elsewhere, so neither is a call's result here.
fn fn_origin_is_call(node: Int, floor: Int) -> Bool ! Diag.Report {
    if node == -1 { return false }
    let k = node_kind(node)
    if k == NodeKind.Closure {
        promote_closure_literal(node, floor)
        return false
    }
    if call_builds_variant(node) { return variant_args_from_call(node, floor) }
    if k == NodeKind.Call || k == NodeKind.MethodCall { return true }
    if k == NodeKind.Ident {
        let b = ea_lookup_bind(node_name(node))
        if b < 0 { return false }
        if ea_assigned_since(node_name(node), floor) { return true }
        if ea_bind_depths.get(b).unwrap() < floor { return false }
        return fn_origin_is_call(ea_bind_values.get(b).unwrap(), floor)
    }
    if k == NodeKind.FieldAccess || k == NodeKind.IndexExpr { return fn_origin_is_call(node_obj(node), floor) }
    if k == NodeKind.UnaryOp { return fn_origin_is_call(node_left(node), floor) }
    if k == NodeKind.ExprStmt { return fn_origin_is_call(node_value(node), floor) }
    if k == NodeKind.Block { return fn_origin_is_call(block_tail_node(node), floor) }
    if k == NodeKind.IfExpr {
        let a = fn_origin_is_call(node_then_body(node), floor)
        let b = fn_origin_is_call(node_else_body(node), floor)
        return a || b
    }
    if k == NodeKind.MatchExpr {
        let arms_sl = node_arms(node)
        let mut hit = false
        let mut i = 0
        while arms_sl != -1 && i < sublist_length(arms_sl) {
            if fn_origin_is_call(node_body(sublist_get(arms_sl, i)), floor) { hit = true }
            i = i + 1
        }
        return hit
    }
    false
}

// `Some(f)`, `Err(f)` and `Shape.Circle(f)` build their value from the arguments written
// here, so what they hold came from those arguments, not from a function body.
fn call_builds_variant(node: Int) -> Bool {
    let k = node_kind(node)
    if k == NodeKind.Call {
        let callee = node_left(node)
        if callee == -1 || node_kind(callee) != NodeKind.Ident { return false }
        if tc_call_decl_is_fn(node) { return false }
        let name = node_name(callee)
        if ea_lookup_bind(name) >= 0 { return false }
        if name == "Some" || name == "Ok" || name == "Err" { return true }
        let decl = tc_call_decl_node(node)
        if decl >= 0 && node_kind(decl) == NodeKind.TypeVariant { return true }
        return result_enum_declares(node, name)
    }
    if k == NodeKind.MethodCall {
        let obj = node_obj(node)
        if obj == -1 || node_kind(obj) != NodeKind.Ident { return false }
        if ea_lookup_bind(node_name(obj)) >= 0 { return false }
        return result_enum_declares(node, node_method(node))
    }
    false
}

fn result_enum_declares(node: Int, variant: Str) -> Bool {
    let tid = tc_lookup_node_tid(node)
    if tid < 0 { return false }
    let r = tc_resolve(tid)
    if tc_tid_kind(r) != TyKind.Enum { return false }
    let decl = tc_tid_decl_node(r)
    if decl < 0 { return false }
    let vars = node_fields(decl)
    let mut i = 0
    while vars != -1 && i < sublist_length(vars) {
        let v = sublist_get(vars, i)
        if node_kind(v) == NodeKind.TypeVariant && node_name(v) == variant { return true }
        i = i + 1
    }
    false
}

fn variant_args_from_call(node: Int, floor: Int) -> Bool ! Diag.Report {
    let args = node_args(node)
    let mut hit = false
    let mut i = 0
    while args != -1 && i < sublist_length(args) {
        if fn_origin_is_call(sublist_get(args, i), floor) { hit = true }
        i = i + 1
    }
    hit
}

// `x?` returns the Err of a Result from the body, across every arena of the body still
// open, so a closure there must be a literal bound in the block as a tail's must.
fn check_question_err_closure(node: Int) ! Diag.Report {
    let n = ea_body_frame_base.len()
    if n == 0 { return }
    let base = ea_body_frame_base.get(n - 1).unwrap()
    if ea_frames.len() <= base { return }
    let operand = node_left(node)
    let tid = tc_lookup_node_tid(operand)
    if tid < 0 { return }
    let r = tc_resolve(tid)
    if tc_tid_kind(r) != TyKind.Result { return }
    let err = tc_tid_child(r, 1)
    if err < 0 || tc_tid_kind(tc_resolve(err)) != TyKind.Fn { return }
    if fn_origin_is_call(operand, base + 1) { emit_closure_tail_nonliteral(node) }
}

// A promoted literal's captures are copied by walkers. Every kind has one, but a walker
// can not copy a type that holds itself, so that capture is refused. A capture that is
// itself a literal bound in the block is promoted with it.
fn promote_closure_literal(closure: Int, floor: Int) ! Diag.Report {
    if ea_promoted_closures.contains_key(closure) { return }
    ea_promoted_closures.insert(closure, 1)
    for ident in closure_read_idents(closure) {
        let b = ea_lookup_bind(node_name(ident))
        if b >= 0 {
            let tid = tc_lookup_node_tid(ident)
            let _ = ea_refuse_recursive_crossing(ident, tid)
            if is_fn_typed(ident) && ea_bind_depths.get(b).unwrap() >= floor {
                let _ = fn_origin_is_call(ea_bind_values.get(b).unwrap(), floor)
            }
        }
    }
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_closure_tail_nonliteral(node: Int) ! Diag.Report {
    let saved = diag_source_file
    diag_source_file = diag_file_for_node(node)
    diag_error_at(
        "ArenaClosureTailNonLiteral", ARENA_CLOSURE_TAIL_NONLITERAL,
        "the closure leaving `with arena \{ }` may be one a call made in the block; only a closure literal bound in the block can be promoted",
        node,
        "build the closure outside the `with arena \{ }` block, or bind it with `let f = fn(...) \{ ... }` inside the block"
    )
    diag_source_file = saved
}

// Reports the closure-capture escapes recorded in the frame about to close, leaving out
// those a promoted closure carries out.
fn flush_capture_escapes() ! Diag.Report {
    let depth = ea_frames.len()
    let mut idents: List[Int] = []
    let mut owners: List[Int] = []
    let mut depths: List[Int] = []
    let mut i = 0
    while i < ea_pending_idents.len() {
        let ident = ea_pending_idents.get(i).unwrap()
        let owner = ea_pending_owners.get(i).unwrap()
        let d = ea_pending_depths.get(i).unwrap()
        if d != depth {
            idents.push(ident)
            owners.push(owner)
            depths.push(d)
        } else if !ea_closure_or_ancestor_promoted(owner) {
            emit_escape(ident, "closure capture")
        }
        i = i + 1
    }
    ea_pending_idents = idents
    ea_pending_owners = owners
    ea_pending_depths = depths
}

let mut ea_fn_declares_arena: Int = 0
let mut ea_fn_arena_any_call: Int = 0
let mut ea_fn_arena_bare_call: Int = 0

// Arena frame scope stack: each frame owns the names allocated inside its
// `with arena { }` block. Popping a frame drops its names.
let mut ea_frames: List[Map[Str, Int]] = []

// Tracks `with X as name { }` bindings live inside the current arena frame,
// so §5.2.1 clause 6 can emit E0700 when the promoted tail captures them.
// Kept separate from `ea_frames` because scope lifetimes don't align —
// multiple WithResource scopes can stack inside one arena frame.
let mut ea_closeable_scopes: List[List[Str]] = []

fn ea_push_frame() {
    ea_frames.push(Map())
}

fn ea_pop_frame() {
    if ea_frames.len() == 0 { return }
    ea_frames.pop()
}

fn ea_push_closeable_scope() {
    let empty: List[Str] = []
    ea_closeable_scopes.push(empty)
}

fn ea_pop_closeable_scope() {
    if ea_closeable_scopes.len() == 0 { return }
    ea_closeable_scopes.pop()
}

fn ea_register_closeable(name: Str) {
    if name == "" { return }
    if ea_closeable_scopes.len() == 0 { return }
    let top = ea_closeable_scopes.len() - 1
    let mut scope = ea_closeable_scopes.get(top).unwrap()
    scope.push(name)
}

fn ea_is_closeable_binding(name: Str) -> Int {
    let mut si = 0
    while si < ea_closeable_scopes.len() {
        let scope = ea_closeable_scopes.get(si).unwrap()
        let mut i = 0
        while i < scope.len() {
            if scope.get(i).unwrap() == name { return 1 }
            i = i + 1
        }
        si = si + 1
    }
    0
}

// ── E0601 FFI-scope value-escape (PtrEscapesFfiScope) ──────────────────────
// A pointer-bearing value carries a scope tag (§9.1.1, Scope tags): the
// `with ffi.scope() as s` block whose exit frees its memory, or unscoped (-1).
// A tag is the binder NODE of that with-item, never its name — two nested
// blocks that both bind `s` are two tags. Reads resolve to their binder through
// typecheck's record, so no lookup here goes by spelling. A value leaves its
// block by `return` or `?` (any still-live local scope) or as the with-block's
// tail (only the scopes that block opened). This AST pass is the single source
// for E0601 across build/check/LSP.

// Per-with-block stack of the scope tags that block opened. The top is the
// innermost block's own scopes; flattened, it is every live local scope.
let mut ea_ffi_scope_blocks: List[List[Int]] = []

// Binder node -> tag of the value it binds, and closure literal -> innermost
// tag of the values it captures. Keyed by node, so a shadowing binder of the
// same name never reads or clobbers another's tag.
let mut ea_node_tags: Map[Int, Int] = Map()

fn ea_reset_ffi_scope_state() {
    ea_ffi_scope_blocks = []
    ea_node_tags = Map()
}

fn ea_push_ffi_scope_block() {
    let empty: List[Int] = []
    ea_ffi_scope_blocks.push(empty)
}

fn ea_pop_ffi_scope_block() {
    if ea_ffi_scope_blocks.len() == 0 { return }
    ea_ffi_scope_blocks.pop()
}

fn ea_register_ffi_scope(tag: Int) {
    if tag < 0 { return }
    if ea_ffi_scope_blocks.len() == 0 { return }
    let top = ea_ffi_scope_blocks.len() - 1
    let mut block = ea_ffi_scope_blocks.get(top).unwrap()
    block.push(tag)
}

// The scope tags opened by the innermost still-open ffi.scope block.
fn ea_current_block_scopes() -> List[Int] {
    if ea_ffi_scope_blocks.len() == 0 {
        let empty: List[Int] = []
        return empty
    }
    ea_ffi_scope_blocks.get(ea_ffi_scope_blocks.len() - 1).unwrap()
}

// The index of the open block that opened `tag`, or -1 once it has closed. The
// live tags form one chain, so a larger index is an inner block.
fn ea_scope_depth(tag: Int) -> Int {
    if tag < 0 { return -1 }
    let mut bi = 0
    while bi < ea_ffi_scope_blocks.len() {
        for own in ea_ffi_scope_blocks.get(bi).unwrap() {
            if own == tag { return bi }
        }
        bi = bi + 1
    }
    -1
}

fn ea_ffi_scope_live(tag: Int) -> Int {
    if ea_scope_depth(tag) >= 0 { 1 } else { 0 }
}

// The inner of two tags. A tag whose block has closed has no place in the live
// chain, so a live tag wins over it.
fn ea_innermost(a: Int, b: Int) -> Int {
    if a < 0 { return b }
    if b < 0 { return a }
    let da = ea_scope_depth(a)
    let db = ea_scope_depth(b)
    if db > da { b } else { a }
}

fn ea_set_binder_tag(binder: Int, tag: Int) {
    if binder < 0 { return }
    ea_node_tags.insert(binder, tag)
}

// Every binder in a pattern takes the tag of the whole value: a part of a
// tagged value may hold the pointer.
fn ea_tag_pattern(pat: Int, tag: Int) {
    if pat < 0 { return }
    ea_set_binder_tag(pat, tag)
    for kid in node_value_child_ids(pat) { ea_tag_pattern(kid, tag) }
}

// The live scope tag `node` names when it is a scope handle, else -1.
fn ffi_scope_handle_tag(node: Int) -> Int {
    if node == -1 { return -1 }
    if node_kind(node) != NodeKind.Ident { return -1 }
    let binder = tc_ident_binder_node(node)
    if ea_ffi_scope_live(binder) == 0 { return -1 }
    binder
}

// The tag of a value. Only a pointer-bearing value, or a closure that captures
// one, carries a tag; any other value is unscoped whatever it was built from.
fn ffi_tag_of(node: Int) -> Int {
    if node == -1 { return -1 }
    if node_kind(node) == NodeKind.Closure { return ea_node_tags.get(node) ?? -1 }
    let tid = tc_lookup_node_tid(node)
    if tid >= 0 && tc_tid_is_pointer_bearing(tid) == 0 { return -1 }
    ffi_raw_tag_of(node)
}

fn ffi_tags_of_list(sl: Int, acc: Int) -> Int {
    if sl == -1 { return acc }
    let mut tag = acc
    let mut i = 0
    while i < sublist_length(sl) {
        tag = ea_innermost(tag, ffi_tag_of(sublist_get(sl, i)))
        i = i + 1
    }
    tag
}

// The inference table of §9.1.1, without the pointer-bearing filter: a
// projection such as `p.field` forwards the tag of `p` before `.read()` gives
// the value.
fn ffi_raw_tag_of(node: Int) -> Int {
    let k = node_kind(node)
    if k == NodeKind.Ident {
        return ea_node_tags.get(tc_ident_binder_node(node)) ?? -1
    }
    if k == NodeKind.MethodCall {
        let method = node_method(node)
        let obj = node_obj(node)
        let scope_tag = ffi_scope_handle_tag(obj)
        if scope_tag != -1 {
            if method == "alloc" || method == "alloc_n" || method == "cstr" { return scope_tag }
            return -1
        }
        if method == "offset" || method == "deref" || method == "read" {
            return ffi_raw_tag_of(obj)
        }
        return ffi_tags_of_list(node_args(node), ffi_tag_of(obj))
    }
    if k == NodeKind.Call {
        return ffi_tags_of_list(node_args(node), -1)
    }
    if k == NodeKind.TupleLit || k == NodeKind.ListLit {
        return ffi_tags_of_list(node_elements(node), -1)
    }
    if k == NodeKind.StructLit {
        let fields_sl = node_fields(node)
        if fields_sl == -1 { return -1 }
        let mut tag = -1
        let mut i = 0
        while i < sublist_length(fields_sl) {
            tag = ea_innermost(tag, ffi_tag_of(node_value(sublist_get(fields_sl, i))))
            i = i + 1
        }
        return tag
    }
    if k == NodeKind.FieldAccess || k == NodeKind.IndexExpr {
        return ffi_raw_tag_of(node_obj(node))
    }
    if k == NodeKind.UnaryOp {
        if node_op(node) == "?" { return ffi_raw_tag_of(node_left(node)) }
        return -1
    }
    if k == NodeKind.BinOp {
        if node_op(node) == "??" { return ea_innermost(ffi_tag_of(node_left(node)), ffi_tag_of(node_right(node))) }
        return -1
    }
    if k == NodeKind.IfExpr {
        return ea_innermost(ffi_tag_of(node_then_body(node)), ffi_tag_of(node_else_body(node)))
    }
    if k == NodeKind.MatchExpr {
        let arms_sl = node_arms(node)
        if arms_sl == -1 { return -1 }
        let mut tag = -1
        let mut i = 0
        while i < sublist_length(arms_sl) {
            tag = ea_innermost(tag, ffi_tag_of(node_body(sublist_get(arms_sl, i))))
            i = i + 1
        }
        return tag
    }
    if k == NodeKind.Block {
        return ffi_tag_of(block_tail_node(node))
    }
    if k == NodeKind.WithBlock {
        return ffi_tag_of(block_tail_node(node_body(node)))
    }
    if k == NodeKind.ExprStmt {
        return ffi_tag_of(node_value(node))
    }
    -1
}

fn ea_in_arena() -> Int {
    if ea_frames.len() > 0 { 1 } else { 0 }
}

fn ea_mark_local(name: Str) {
    if ea_frames.len() == 0 { return }
    let top = ea_frames.len() - 1
    let mut frame = ea_frames.get(top).unwrap()
    frame.insert(name, 1)
}

fn ea_is_local_in_top(name: Str) -> Int {
    if ea_frames.len() == 0 { return 0 }
    let frame = ea_frames.get(ea_frames.len() - 1).unwrap()
    if frame.contains_key(name) { 1 } else { 0 }
}

fn ea_is_local_anywhere(name: Str) -> Int {
    let mut f = 0
    while f < ea_frames.len() {
        let frame = ea_frames.get(f).unwrap()
        if frame.contains_key(name) { return 1 }
        f = f + 1
    }
    0
}

fn is_alloc_expr(kind: Int) -> Int {
    if kind == NodeKind.StructLit { return 1 }
    if kind == NodeKind.ListLit { return 1 }
    if kind == NodeKind.TupleLit { return 1 }
    if kind == NodeKind.InterpString { return 1 }
    0
}

// True when an InterpString node is a pure (non-interpolated) string literal —
// every element is a literal text chunk, with no expression parts. Such a node
// codegens to a static C string constant (codegen_expr.bl `all_literal` fast
// path), not an arena allocation, so it must not be classified as an arena
// value. The discriminator mirrors codegen exactly: a literal text chunk is an
// Ident part whose str_val equals its name. An empty element list is the empty
// string, also a pure literal.
fn interp_is_pure_literal(node: Int) -> Int {
    let parts_sl = node_elements(node)
    if parts_sl == -1 { return 1 }
    let mut i = 0
    while i < sublist_length(parts_sl) {
        let part = sublist_get(parts_sl, i)
        if node_kind(part) != NodeKind.Ident { return 0 }
        if node_str_val(part) != node_name(part) { return 0 }
        i = i + 1
    }
    1
}

// Node-aware allocation classification: a pure-literal InterpString is a static
// constant, never an arena allocation. All other InterpStrings (interpolated)
// and the other literal kinds delegate to the kind-only `is_alloc_expr`.
fn node_is_alloc_expr(node: Int) -> Int {
    if node == -1 { return 0 }
    let k = node_kind(node)
    if k == NodeKind.InterpString {
        if interp_is_pure_literal(node) != 0 { return 0 }
        return 1
    }
    is_alloc_expr(k)
}

fn infer_alloc_type(node: Int) -> Str {
    let k = node_kind(node)
    if k == NodeKind.StructLit {
        let n = node_type_name(node)
        if n != "" { return n }
        return "?"
    }
    if k == NodeKind.ListLit { return "List" }
    if k == NodeKind.TupleLit { return "Tuple" }
    if k == NodeKind.InterpString { return "Str" }
    "?"
}

fn rhs_is_arena_value(rhs: Int) -> Int {
    if rhs == -1 { return 0 }
    let k = node_kind(rhs)
    if node_is_alloc_expr(rhs) != 0 { return 1 }
    if k == NodeKind.Ident {
        let n = node_name(rhs)
        if ea_is_local_in_top(n) != 0 { return 1 }
    }
    if k == NodeKind.IfExpr {
        if rhs_is_arena_value(node_then_body(rhs)) != 0 {
            if rhs_is_arena_value(node_else_body(rhs)) != 0 {
                return 1
            }
        }
    }
    if k == NodeKind.Block {
        let sl = node_stmts(rhs)
        if sl != -1 {
            let n = sublist_length(sl)
            if n > 0 {
                let last = sublist_get(sl, n - 1)
                let lk = node_kind(last)
                if lk == NodeKind.ExprStmt {
                    return rhs_is_arena_value(node_value(last))
                }
                return rhs_is_arena_value(last)
            }
        }
    }
    0
}

fn ea_promotion_target() -> Str {
    if ea_frames.len() > 1 { "outer arena" } else { "GC heap" }
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_escape(node: Int, category: Str) ! Diag.Report {
    let saved = diag_source_file
    diag_source_file = diag_file_for_node(node)
    let target = ea_promotion_target()
    diag_error_at(
        "ArenaValueEscapes", ARENA_VALUE_ESCAPES,
        "value allocated in `with arena \{ }` escapes via {category}; would be promoted into: {target}",
        node,
        "copy the value explicitly before it leaves the arena scope, or remove `! Arena` and let it be GC-managed"
    )
    diag_source_file = saved
}

fn expr_is_arena_value(node: Int) -> Int {
    if node == -1 { return 0 }
    let k = node_kind(node)
    if node_is_alloc_expr(node) != 0 { return 1 }
    if k == NodeKind.Ident {
        let n = node_name(node)
        if ea_is_local_in_top(n) != 0 { return 1 }
    }
    0
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn emit_ffi_scope_escape(node: Int, tag: Int) ! Diag.Report {
    let saved = diag_source_file
    diag_source_file = diag_file_for_node(node)
    let origin = node_name(tag)
    diag_error_at(
        "PtrEscapesFfiScope", CLOSEABLE_ESCAPES_SCOPE,
        "Ptr from `with ffi.scope() as {origin}` cannot escape the block — use {origin}.take(p) to detach it first",
        node,
        "wrap the escaping value in {origin}.take(...)"
    )
    diag_source_file = saved
}

// Function-return escape: a returned value tagged with ANY still-live local
// ffi.scope dangles once the function returns.
fn check_ffi_ptr_return_escape(val_node: Int) ! Diag.Report {
    let tag = ffi_tag_of(val_node)
    if ea_ffi_scope_live(tag) == 0 { return }
    emit_ffi_scope_escape(val_node, tag)
}

// `?` hands the Err value to the caller, so it leaves every live local scope.
// Only an Err payload that can hold a pointer carries the tag out: an Option
// propagates None, and a Result whose error type is pointer-free propagates no
// pointer.
fn check_ffi_ptr_question_escape(q_node: Int) ! Diag.Report {
    let operand = node_left(q_node)
    let tid = tc_resolve(tc_lookup_node_tid(operand))
    if tid < 0 { return }
    if tc_tid_kind(tid) != TyKind.Result { return }
    if tc_tid_is_pointer_bearing(tc_tid_child(tid, 1)) == 0 { return }
    let tag = ffi_raw_tag_of(operand)
    if ea_ffi_scope_live(tag) == 0 { return }
    emit_ffi_scope_escape(q_node, tag)
}

// With-expr tail escape: fire only when the tail's tag is one of the scopes
// THIS block opened — a value tagged by an outer still-live scope threaded
// through as an inner block's tail does not dangle.
fn check_ffi_ptr_tail_escape(val_node: Int, owning_scopes: List[Int]) ! Diag.Report {
    if owning_scopes.len() == 0 { return }
    let tag = ffi_tag_of(val_node)
    if tag < 0 { return }
    for own in owning_scopes {
        if own == tag {
            emit_ffi_scope_escape(val_node, tag)
            return
        }
    }
}

// True when `node` is a projection (FieldAccess / IndexExpr chain) whose
// root ident names an in-scope Closeable binding. Promoting such a value
// out of the arena would retain a reference into the resource's buffers
// after its close() runs — §5.2.1 clause 6 / E0700.
fn expr_captures_closeable(node: Int) -> Int {
    if node == -1 { return 0 }
    let k = node_kind(node)
    if k == NodeKind.Ident {
        if ea_is_closeable_binding(node_name(node)) != 0 { return 1 }
        return 0
    }
    if k == NodeKind.FieldAccess {
        return expr_captures_closeable(node_obj(node))
    }
    if k == NodeKind.IndexExpr {
        return expr_captures_closeable(node_obj(node))
    }
    0
}

fn walk_elements(sl: Int) ! Diag.Report {
    if sl == -1 { return }
    let mut i = 0
    while i < sublist_length(sl) {
        walk_expr(sublist_get(sl, i), 0)
        i = i + 1
    }
}

fn walk_assignment(node: Int) ! Diag.Report {
    let target = node_target(node)
    let val = node_value(node)
    if target != -1 && node_kind(target) == NodeKind.Ident { ea_note_assigned(node_name(target)) }
    if ea_in_arena() != 0 {
        if val != -1 {
            let rhs_arena = expr_is_arena_value(val)
            let rhs_closeable = expr_captures_closeable(val)
            if rhs_arena != 0 || rhs_closeable != 0 {
                if target != -1 {
                    let tk = node_kind(target)
                    if tk == NodeKind.Ident {
                        let tname = node_name(target)
                        if ea_is_local_in_top(tname) == 0 {
                            let cat = if rhs_closeable != 0 { "Closeable buffer" } else { "global assignment" }
                            emit_escape(node, cat)
                        }
                    }
                    if tk == NodeKind.FieldAccess || tk == NodeKind.IndexExpr {
                        let obj = node_obj(target)
                        if obj != -1 {
                            if node_kind(obj) == NodeKind.Ident {
                                if ea_is_local_in_top(node_name(obj)) == 0 {
                                    let cat = if rhs_closeable != 0 { "Closeable buffer" } else { "field store" }
                                    emit_escape(node, cat)
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    walk_expr(node_value(node), 0)
    if target != -1 {
        let tk = node_kind(target)
        if tk == NodeKind.FieldAccess || tk == NodeKind.IndexExpr {
            walk_expr(node_obj(target), 0)
        }
    }
}

fn walk_method_call(node: Int) ! Diag.Report {
    let obj = node_obj(node)
    walk_expr(obj, 0)
    let args_sl = node_args(node)
    if ea_in_arena() != 0 {
        if args_sl != -1 {
            let mut receiver_local = 0
            let mut is_safe_method = 0
            if obj != -1 {
                if node_kind(obj) == NodeKind.Ident {
                    let obj_name = node_name(obj)
                    if ea_is_local_in_top(obj_name) != 0 {
                        receiver_local = 1
                    }
                    let qualified = "{obj_name}.{node_method(node)}"
                    if ea_safe_intrinsics.contains_key(qualified) != 0 {
                        is_safe_method = 1
                    }
                }
            }
            if receiver_local == 0 && is_safe_method == 0 {
                let mut ai = 0
                while ai < sublist_length(args_sl) {
                    let arg = sublist_get(args_sl, ai)
                    if expr_is_arena_value(arg) != 0 {
                        emit_escape(arg, "function argument")
                    }
                    ai = ai + 1
                }
            }
        }
    }
    if args_sl != -1 {
        let mut ai = 0
        while ai < sublist_length(args_sl) {
            walk_expr(sublist_get(args_sl, ai), 0)
            ai = ai + 1
        }
    }
}

fn walk_call(node: Int) ! Diag.Report {
    let callee = node_left(node)
    let mut callee_name = ""
    if callee != -1 {
        if node_kind(callee) == NodeKind.Ident {
            callee_name = node_name(callee)
        }
    }
    let args_sl = node_args(node)
    if ea_fn_declares_arena != 0 && callee_name != "" {
        if tc_fn_has_effect(callee_name, "Arena") != 0 {
            ea_fn_arena_any_call = 1
            if ea_in_arena() == 0 {
                ea_fn_arena_bare_call = 1
            }
        }
    }
    if ea_in_arena() != 0 {
        if args_sl != -1 {
            if callee_name != "" {
                if ea_safe_intrinsics.contains_key(callee_name) == 0 {
                    if tc_fn_has_effect(callee_name, "Arena") == 0 {
                        let mut ai = 0
                        while ai < sublist_length(args_sl) {
                            let arg = sublist_get(args_sl, ai)
                            if expr_is_arena_value(arg) != 0 {
                                emit_escape(arg, "function argument")
                            }
                            ai = ai + 1
                        }
                    }
                }
            }
        }
    }
    walk_expr(callee, 0)
    if args_sl != -1 {
        let mut ai = 0
        while ai < sublist_length(args_sl) {
            walk_expr(sublist_get(args_sl, ai), 0)
            ai = ai + 1
        }
    }
}

fn walk_block_stmts(block_node: Int, tail_flag: Int) ! Diag.Report {
    walk_block_stmts_ffi(block_node, tail_flag, empty_tag_list())
}

fn empty_tag_list() -> List[Int] {
    let e: List[Int] = []
    e
}

// Walk a block's statements. `owning_scopes`, when non-empty, holds the
// ffi.scope tags this block opened; the tail's E0601 escape is checked against
// them while they are still live.
fn walk_block_stmts_ffi(block_node: Int, tail_flag: Int, owning_scopes: List[Int]) ! Diag.Report {
    let stmts_sl = node_stmts(block_node)
    if stmts_sl == -1 { return }
    let n = sublist_length(stmts_sl)
    ea_push_binds()
    let mut i = 0
    while i < n {
        let stmt = sublist_get(stmts_sl, i)
        let is_last = if i == n - 1 { 1 } else { 0 }
        let stmt_tail = if is_last != 0 { tail_flag } else { 0 }
        walk_expr(stmt, stmt_tail)
        i = i + 1
    }
    if owning_scopes.len() != 0 {
        check_ffi_ptr_tail_escape(block_tail_node(block_node), owning_scopes)
    }
    ea_pop_binds()
}

// True when a WithResource handler's value is an `ffi.scope()` call — i.e. the
// binding is a scope handle. Returns the binding name, or "" otherwise.
pub fn ffi_scope_resource_name(item: Int) -> Str {
    if item == -1 { return "" }
    if node_kind(item) != NodeKind.WithResource { return "" }
    let val = node_value(item)
    if val == -1 { return "" }
    if node_kind(val) != NodeKind.MethodCall { return "" }
    if node_method(val) != "scope" { return "" }
    let obj = node_obj(val)
    if obj == -1 { return "" }
    if node_kind(obj) != NodeKind.Ident { return "" }
    if node_name(obj) != "ffi" { return "" }
    node_name(item)
}

// The tail expression node of a `with`-block body, or -1. Mirrors codegen's
// emit_block_then_capture tail selection: the last statement's value (for an
// ExprStmt) or the statement itself.
fn block_tail_node(body: Int) -> Int {
    if body == -1 { return -1 }
    if node_kind(body) != NodeKind.Block { return -1 }
    let sl = node_stmts(body)
    if sl == -1 { return -1 }
    let n = sublist_length(sl)
    if n == 0 { return -1 }
    let last = sublist_get(sl, n - 1)
    if node_kind(last) == NodeKind.ExprStmt { return node_value(last) }
    last
}

fn walk_with_block(node: Int, outer_tail: Int) ! Diag.Report {
    let handlers_sl = node_handlers(node)
    let body = node_body(node)
    if handlers_sl != -1 {
        let mut hi = 0
        while hi < sublist_length(handlers_sl) {
            walk_expr(sublist_get(handlers_sl, hi), 0)
            hi = hi + 1
        }
    }
    let mut is_arena = 0
    if handlers_sl != -1 {
        let mut i = 0
        while i < sublist_length(handlers_sl) {
            let item = sublist_get(handlers_sl, i)
            if node_kind(item) == NodeKind.Ident {
                if node_name(item) == "arena" {
                    is_arena = 1
                }
            }
            i = i + 1
        }
    }
    if is_arena != 0 {
        check_promote_cycle(node, tc_lookup_node_tid(node))
        ea_push_frame()
        ea_assigned.push([])
        ea_push_closeable_scope()
        let saved_floor = ea_tail_floor
        ea_tail_floor = ea_frames.len()
        walk_expr(body, 1)
        ea_tail_floor = saved_floor
        flush_capture_escapes()
        ea_pop_closeable_scope()
        ea_pop_assigned()
        ea_pop_frame()
    } else {
        // Non-arena `with`: if we're inside an arena frame and any handler is a
        // WithResource `expr as name`, that binding names a Closeable whose
        // buffers must not be captured into the promoted tail (clause 6).
        // Independently, an `ffi.scope()` resource opens an FFI scope block whose
        // scope-minted Ptrs must not escape via the with-expr tail (E0601).
        let mut pushed_scope = 0
        let mut pushed_ffi = 0
        if handlers_sl != -1 {
            let mut hi2 = 0
            while hi2 < sublist_length(handlers_sl) {
                let item2 = sublist_get(handlers_sl, hi2)
                if node_kind(item2) == NodeKind.WithResource {
                    let bname = node_name(item2)
                    if bname != "" && ea_in_arena() != 0 {
                        if pushed_scope == 0 {
                            ea_push_closeable_scope()
                            pushed_scope = 1
                        }
                        ea_register_closeable(bname)
                    }
                    if ffi_scope_resource_name(item2) != "" {
                        if pushed_ffi == 0 {
                            ea_push_ffi_scope_block()
                            pushed_ffi = 1
                        }
                        ea_register_ffi_scope(item2)
                    }
                }
                hi2 = hi2 + 1
            }
        }
        // For an ffi.scope body, walk the statements directly so the with-expr
        // tail escape is checked while the block's own scopes are still live.
        ea_push_binds()
        if handlers_sl != -1 {
            let mut hi3 = 0
            while hi3 < sublist_length(handlers_sl) {
                let item3 = sublist_get(handlers_sl, hi3)
                if node_kind(item3) == NodeKind.WithResource { ea_bind(node_name(item3), -1) }
                hi3 = hi3 + 1
            }
        }
        if pushed_ffi != 0 && node_kind(body) == NodeKind.Block {
            walk_block_stmts_ffi(body, outer_tail, ea_current_block_scopes())
        } else {
            walk_expr(body, outer_tail)
        }
        ea_pop_binds()
        if pushed_ffi != 0 {
            ea_pop_ffi_scope_block()
        }
        if pushed_scope != 0 {
            ea_pop_closeable_scope()
        }
    }
}

fn walk_expr(node: Int, tail_flag: Int) ! Diag.Report {
    if node == -1 { return }
    let kind = node_kind(node)
    if tail_flag != 0 && ea_tail_crosses() { classify_tail(node) }

    if ea_in_arena() != 0 {
        if node_is_alloc_expr(node) != 0 {
            if tail_flag != 0 {
                record_promote(node, infer_alloc_type(node))
            }
        }
    }

    if kind == NodeKind.Assignment {
        walk_assignment(node)
        // Flow-insensitive: the binding may hold any value ever assigned to it.
        let target = node_target(node)
        if target != -1 && node_kind(target) == NodeKind.Ident {
            let binder = tc_ident_binder_node(target)
            if binder >= 0 {
                let prev = ea_node_tags.get(binder) ?? -1
                ea_set_binder_tag(binder, ea_innermost(prev, ffi_tag_of(node_value(node))))
            }
        }
        return
    }
    if kind == NodeKind.CompoundAssign {
        walk_assignment(node)
        return
    }
    if kind == NodeKind.MethodCall {
        walk_method_call(node)
        return
    }
    if kind == NodeKind.Call {
        walk_call(node)
        return
    }
    if kind == NodeKind.Closure {
        ea_closure_parent.insert(node, if ea_closure_stack.len() > 0 { ea_closure_stack.get(ea_closure_stack.len() - 1).unwrap() } else { -1 })
        if ea_in_arena() != 0 {
            check_closure_captures(node)
        }
        let fn_tid = tc_lookup_node_tid(node)
        ea_push_body(if fn_tid < 0 { -1 } else { tc_tid_child(tc_resolve(fn_tid), 0) })
        ea_closure_stack.push(node)
        ea_push_binds()
        let mut params: List[Str] = []
        push_param_names(node, params)
        ea_bind_all(params)
        walk_expr(node_body(node), 0)
        ea_pop_binds()
        let _ = ea_closure_stack.pop()
        ea_pop_body()
        let mut ctag = -1
        for cap in closure_read_idents(node) { ctag = ea_innermost(ctag, ffi_tag_of(cap)) }
        ea_node_tags.insert(node, ctag)
        return
    }
    if kind == NodeKind.BinOp {
        walk_expr(node_left(node), 0)
        walk_expr(node_right(node), 0)
        return
    }
    if kind == NodeKind.UnaryOp {
        if node_op(node) == "?" {
            check_promote_cycle(node, ea_exit_crossing_tid())
            check_question_err_closure(node)
        }
        walk_expr(node_left(node), 0)
        if node_op(node) == "?" { check_ffi_ptr_question_escape(node) }
        return
    }
    if kind == NodeKind.IfExpr {
        walk_expr(node_condition(node), 0)
        walk_expr(node_then_body(node), tail_flag)
        walk_expr(node_else_body(node), tail_flag)
        return
    }
    if kind == NodeKind.MatchExpr {
        walk_expr(node_scrutinee(node), 0)
        let arms_sl = node_arms(node)
        if arms_sl != -1 {
            let mut ai = 0
            while ai < sublist_length(arms_sl) {
                let arm = sublist_get(arms_sl, ai)
                ea_push_binds()
                ea_bind_pattern(node_pattern(arm))
                ea_tag_pattern(node_pattern(arm), ffi_tag_of(node_scrutinee(node)))
                walk_expr(node_guard(arm), 0)
                walk_expr(node_body(arm), tail_flag)
                ea_pop_binds()
                ai = ai + 1
            }
        }
        return
    }
    if kind == NodeKind.Block {
        walk_block_stmts(node, tail_flag)
        return
    }
    if kind == NodeKind.LetBinding {
        let val = node_value(node)
        walk_expr(val, 0)
        if ea_in_arena() != 0 {
            if rhs_is_arena_value(val) != 0 {
                let name = node_name(node)
                if name != "" {
                    ea_mark_local(name)
                }
            }
        }
        ea_bind(node_name(node), val)
        ea_bind_pattern(node_elements(node))
        let tag = ffi_tag_of(val)
        ea_set_binder_tag(node, tag)
        ea_tag_pattern(node_elements(node), tag)
        return
    }
    if kind == NodeKind.ExprStmt {
        walk_expr(node_value(node), tail_flag)
        return
    }
    if kind == NodeKind.Return {
        let rv = node_value(node)
        if rv != -1 { check_promote_cycle(node, ea_exit_crossing_tid()) }
        let saved_floor = ea_tail_floor
        ea_tail_floor = ea_body_frame_base.get(ea_body_frame_base.len() - 1).unwrap() + 1
        walk_expr(rv, 1)
        ea_tail_floor = saved_floor
        check_ffi_ptr_return_escape(rv)
        return
    }
    if kind == NodeKind.ForIn {
        walk_expr(node_iterable(node), 0)
        ea_push_binds()
        ea_bind_pattern(node_for_binder(node))
        ea_bind_pattern(node_elements(node))
        let iter_tag = ffi_tag_of(node_iterable(node))
        ea_set_binder_tag(node, iter_tag)
        ea_tag_pattern(node_for_binder(node), iter_tag)
        ea_tag_pattern(node_elements(node), iter_tag)
        walk_expr(node_body(node), 0)
        ea_pop_binds()
        return
    }
    if kind == NodeKind.WhileLoop {
        walk_expr(node_condition(node), 0)
        walk_expr(node_body(node), 0)
        return
    }
    if kind == NodeKind.LoopExpr {
        walk_expr(node_body(node), 0)
        return
    }
    if kind == NodeKind.FieldAccess {
        walk_expr(node_obj(node), 0)
        return
    }
    if kind == NodeKind.IndexExpr {
        walk_expr(node_obj(node), 0)
        walk_expr(node_right(node), 0)
        return
    }
    if kind == NodeKind.TupleLit {
        walk_elements(node_elements(node))
        return
    }
    if kind == NodeKind.ListLit {
        walk_elements(node_elements(node))
        return
    }
    if kind == NodeKind.StructLit {
        let fields_sl = node_fields(node)
        if fields_sl != -1 {
            let mut fi = 0
            while fi < sublist_length(fields_sl) {
                let fld = sublist_get(fields_sl, fi)
                walk_expr(node_value(fld), 0)
                fi = fi + 1
            }
        }
        return
    }
    if kind == NodeKind.InterpString {
        walk_elements(node_elements(node))
        return
    }
    if kind == NodeKind.RangeLit {
        walk_expr(node_left(node), 0)
        walk_expr(node_right(node), 0)
        return
    }
    if kind == NodeKind.WithBlock {
        walk_with_block(node, tail_flag)
        return
    }
}

fn cc_scan_elements(sl: Int, locals: List[Str]) ! Diag.Report {
    if sl == -1 { return }
    let mut i = 0
    while i < sublist_length(sl) {
        cc_scan(sublist_get(sl, i), locals)
        i = i + 1
    }
}

fn cc_recurse(node: Int, locals: List[Str]) ! Diag.Report {
    let k = node_kind(node)
    if k == NodeKind.Assignment {
        cc_scan(node_target(node), locals)
        cc_scan(node_value(node), locals)
        return
    }
    if k == NodeKind.CompoundAssign {
        cc_scan(node_target(node), locals)
        cc_scan(node_value(node), locals)
        return
    }
    if k == NodeKind.Call {
        cc_scan(node_left(node), locals)
        let args_sl = node_args(node)
        if args_sl != -1 {
            let mut i = 0
            while i < sublist_length(args_sl) {
                cc_scan(sublist_get(args_sl, i), locals)
                i = i + 1
            }
        }
        return
    }
    if k == NodeKind.MethodCall {
        cc_scan(node_obj(node), locals)
        let args_sl = node_args(node)
        if args_sl != -1 {
            let mut i = 0
            while i < sublist_length(args_sl) {
                cc_scan(sublist_get(args_sl, i), locals)
                i = i + 1
            }
        }
        return
    }
    if k == NodeKind.BinOp {
        cc_scan(node_left(node), locals)
        cc_scan(node_right(node), locals)
        return
    }
    if k == NodeKind.UnaryOp {
        cc_scan(node_left(node), locals)
        return
    }
    if k == NodeKind.IfExpr {
        cc_scan(node_condition(node), locals)
        cc_scan(node_then_body(node), locals)
        cc_scan(node_else_body(node), locals)
        return
    }
    if k == NodeKind.Return {
        cc_scan(node_value(node), locals)
        return
    }
    if k == NodeKind.ExprStmt {
        cc_scan(node_value(node), locals)
        return
    }
    if k == NodeKind.FieldAccess {
        cc_scan(node_obj(node), locals)
        return
    }
    if k == NodeKind.IndexExpr {
        cc_scan(node_obj(node), locals)
        cc_scan(node_right(node), locals)
        return
    }
    if k == NodeKind.TupleLit {
        cc_scan_elements(node_elements(node), locals)
        return
    }
    if k == NodeKind.ListLit {
        cc_scan_elements(node_elements(node), locals)
        return
    }
    if k == NodeKind.StructLit {
        let fields_sl = node_fields(node)
        if fields_sl != -1 {
            let mut i = 0
            while i < sublist_length(fields_sl) {
                cc_scan(node_value(sublist_get(fields_sl, i)), locals)
                i = i + 1
            }
        }
        return
    }
    if k == NodeKind.InterpString {
        cc_scan_elements(node_elements(node), locals)
        return
    }
    if k == NodeKind.MatchExpr {
        cc_scan(node_scrutinee(node), locals)
        let arms_sl = node_arms(node)
        if arms_sl != -1 {
            let mut i = 0
            while i < sublist_length(arms_sl) {
                let arm = sublist_get(arms_sl, i)
                cc_scan(node_body(arm), locals)
                i = i + 1
            }
        }
        return
    }
    if k == NodeKind.WhileLoop {
        cc_scan(node_condition(node), locals)
        cc_scan(node_body(node), locals)
        return
    }
    if k == NodeKind.ForIn {
        cc_scan(node_iterable(node), locals)
        cc_scan(node_body(node), locals)
        return
    }
    if k == NodeKind.LoopExpr {
        cc_scan(node_body(node), locals)
        return
    }
    if k == NodeKind.WithBlock {
        let hs = node_handlers(node)
        if hs != -1 {
            let mut i = 0
            while i < sublist_length(hs) {
                cc_scan(sublist_get(hs, i), locals)
                i = i + 1
            }
        }
        cc_scan(node_body(node), locals)
        return
    }
    if k == NodeKind.Closure {
        cc_scan(node_body(node), locals)
        return
    }
    if k == NodeKind.RangeLit {
        cc_scan(node_left(node), locals)
        cc_scan(node_right(node), locals)
        return
    }
}

fn cc_scan(node: Int, locals: List[Str]) ! Diag.Report {
    if node == -1 { return }
    let k = node_kind(node)
    if k == NodeKind.Ident {
        let n = node_name(node)
        if !locals.contains(n) {
            if ea_is_local_anywhere(n) != 0 {
                ea_pending_idents.push(node)
                ea_pending_owners.push(ea_cc_owner)
                ea_pending_depths.push(ea_frames.len())
            }
        }
        return
    }
    if k == NodeKind.Block {
        let sl = node_stmts(node)
        if sl == -1 { return }
        let mut cur_locals = locals
        let mut i = 0
        while i < sublist_length(sl) {
            let s = sublist_get(sl, i)
            if node_kind(s) == NodeKind.LetBinding {
                cc_scan(node_value(s), cur_locals)
                cur_locals.push(node_name(s))
            } else {
                cc_scan(s, cur_locals)
            }
            i = i + 1
        }
        return
    }
    cc_recurse(node, locals)
}

fn check_closure_captures(closure_node: Int) ! Diag.Report {
    let body = node_body(closure_node)
    if body == -1 { return }
    ea_cc_owner = closure_node
    let mut pnames: List[Str] = []
    let params_sl = node_params(closure_node)
    if params_sl != -1 {
        let mut pi = 0
        while pi < sublist_length(params_sl) {
            let p = sublist_get(params_sl, pi)
            pnames.push(node_name(p))
            pi = pi + 1
        }
    }
    cc_scan(body, pnames)
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn analyze_fn(fn_node: Int) ! Diag.Report {
    let saved_source = diag_source_file
    diag_source_file = diag_file_for_node(fn_node)
    diag_push_allows(fn_node)
    ea_frames = []
    ea_closeable_scopes = []
    ea_reset_ffi_scope_state()
    let arena_eff_node = find_arena_effect_node(fn_node)
    ea_fn_declares_arena = if arena_eff_node != -1 { 1 } else { 0 }
    ea_fn_arena_any_call = 0
    ea_fn_arena_bare_call = 0
    ea_body_ret_tids = []
    ea_body_frame_base = []
    ea_reset_closure_state()
    ea_push_binds()
    let mut params: List[Str] = []
    push_param_names(fn_node, params)
    ea_bind_all(params)
    let ann = node_type_ann(fn_node)
    ea_push_body(if ann == -1 { -1 } else { tc_lookup_node_tid(ann) })
    let body = node_body(fn_node)
    if body != -1 {
        walk_expr(body, 0)
    }
    ea_pop_body()
    check_redundant_arena_effect(fn_node, arena_eff_node)
    diag_clear_allows()
    diag_source_file = saved_source
}

// Returns the effect AST node (not a bool) so callers can report the
// source span — tc_fn_has_effect is the yes/no alternative.
fn find_arena_effect_node(fn_node: Int) -> Int {
    let effs_sl = node_effects(fn_node)
    if effs_sl == -1 { return -1 }
    let mut i = 0
    while i < sublist_length(effs_sl) {
        let eff = sublist_get(effs_sl, i)
        if node_name(eff) == "Arena" { return eff }
        i = i + 1
    }
    -1
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn check_redundant_arena_effect(fn_node: Int, arena_eff: Int) ! Diag.Report {
    if arena_eff == -1 { return }
    if ea_fn_arena_any_call == 0 { return }
    if ea_fn_arena_bare_call != 0 { return }
    let fname = node_name(fn_node)
    diag_warn_at(
        "ArenaEffectRedundant", ARENA_EFFECT_REDUNDANT,
        "function `{fname}` declares `! Arena` but every Arena-effectful call is already contained inside `with arena \{ }` — the marker is redundant",
        arena_eff,
        "remove `! Arena` from the signature of `{fname}`"
    )
    diag_set_last_fix("remove", "! Arena")
}

pub fn analyze_escapes(program: Int) ! Diag.Report {
    init_safe_intrinsics()
    ea_promote_nodes = []
    ea_promote_types = []
    ea_frames = []
    ea_closeable_scopes = []
    ea_reset_ffi_scope_state()
    ea_cycle_reported = Map()
    ea_promoted_closures = Map()
    ea_closure_parent = Map()

    let fns_sl = node_params(program)
    if fns_sl == -1 { return }
    let mut i = 0
    while i < sublist_length(fns_sl) {
        analyze_fn(sublist_get(fns_sl, i))
        i = i + 1
    }
}
