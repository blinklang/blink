// import_edit.bl — the edit that lets a file call a name from a module by its bare name
//
// A fix that rewrites `rand.shuffle(deck)` to `shuffle(deck)` must also import `shuffle`, or
// the fixed file does not compile. The edit works on the text of one file, so a fix and an
// editor completion can share it.

// Replace line:col..end_line:end_col with `text`. Lines and columns are 1-based, columns count
// bytes, and the end is exclusive, as in a diagnostic's fix span.
@derive(Eq, Debug)
pub type ImportEdit {
    line: Int
    col: Int
    end_line: Int
    end_col: Int
    text: Str
}

pub type ImportNeed {
    // The file already imports each name by its bare spelling.
    Present
    Add(ImportEdit)
    // The file imports the item under another spelling, or binds the name to another item, with
    // `as`. No edit gives the bare name without a second binding.
    Blocked
}

// An import statement of the file: lines first..last (0-based), and for an import of
// `module.{...}` or `module as q.{...}` the items of its list. `odd` says an item of that list
// reads as neither `name` nor `name as alias`.
type ImportDecl {
    first: Int
    last: Int
    of_module: Bool
    is_pub: Bool
    items: List[ImportItem]
    odd: Bool
}

// An item of an import list: the name it imports from the module, and the name it binds.
type ImportItem {
    orig: Str
    bound: Str
}

// The words of import text: each run of name characters, and each `.`, `{`, `}` and `,` on its
// own. Blanks only part the words, so a tab or a run of spaces reads as one space.
fn import_words(text: Str) -> List[Str] {
    let mut out: List[Str] = []
    let mut word = ""
    for c in text {
        let punct = c == '.' || c == '{' || c == '}' || c == ','
        if punct || c == ' ' || c == '\t' || c == '\r' || c == '\n' {
            if word != "" { out.push(word) }
            word = ""
            if punct { out.push(c.to_str()) }
        } else {
            word = word.concat(c.to_str())
        }
    }
    if word != "" { out.push(word) }
    out
}

// A word that can name an item: not a mark, and not the keyword `as`.
fn import_word_is_name(word: Str) -> Bool {
    word != "" && word != "as" && word != "." && word != "\{" && word != "}" && word != ","
}

// `line` up to a `//` comment. An import holds no string, so `//` always starts a comment.
fn code_of(line: Str) -> Str {
    match line.byte_index_of("//", 0) {
        Some(at) => line.byte_slice(0, at)
        None => line
    }
}

// The import statements of `lines` that start on the lines `starts` (0-based, in order), which
// the caller takes from the lexer or the parser: a line of a string literal can read as an
// import too. A brace list may run over more than one line.
fn import_stmts(lines: List[Str], starts: List[Int], module: Str) -> List[ImportDecl] {
    let mut out: List[ImportDecl] = []
    for start in starts {
        let mut i = start
        let first = i
        let mut text = code_of(lines.get(i) ?? "")
        if text.byte_index_of("\{", 0) != None {
            while text.byte_index_of("}", 0) == None && i + 1 < lines.len() {
                i = i + 1
                text = text.concat("\n").concat(code_of(lines.get(i).unwrap()))
            }
        }
        let words = import_words(text)
        let is_pub = (words.get(0) ?? "") == "pub"
        let mut w = if is_pub { 1 } else { 0 }
        if (words.get(w) ?? "") != "import" { continue }
        let mut path = words.get(w + 1) ?? ""
        w = w + 2
        while (words.get(w) ?? "") == "." && (words.get(w + 1) ?? "\{") != "\{" {
            path = "{path}.{words.get(w + 1).unwrap()}"
            w = w + 2
        }
        if (words.get(w) ?? "") == "as" { w = w + 2 }
        let of_module = path == module && (words.get(w) ?? "") == "." && (words.get(w + 1) ?? "") == "\{"
        let mut items: List[ImportItem] = []
        let mut odd = false
        // An item is `name` or `name as alias`, and the comma after it is optional, as in
        // parse_import_stmt.
        if of_module {
            w = w + 2
            while w < words.len() && words.get(w).unwrap() != "}" {
                let name = words.get(w).unwrap()
                if name == "," {
                    w = w + 1
                    continue
                }
                let mut bound = name
                if (words.get(w + 1) ?? "") == "as" {
                    bound = words.get(w + 2) ?? ""
                    w = w + 2
                }
                if !import_word_is_name(name) || !import_word_is_name(bound) {
                    odd = true
                    break
                }
                items.push(ImportItem { orig: name, bound: bound })
                w = w + 1
            }
        }
        out.push(ImportDecl { first: first, last: i, of_module: of_module, is_pub: is_pub, items: items, odd: odd })
    }
    out
}

// How `lines`, with import statements on the lines `starts`, comes to import each of `names`
// from `module` by its bare name: Present when it imports them all, Blocked when `as` binds one
// of them to another item, else one edit that imports the ones it lacks. An item imported only
// under an alias still lacks its bare name, and one item may be imported under two names. Two
// fixes in one file that each need an import of the same names then carry the same edit, which
// `blink fix` applies once. A one-line `import module.{...}`, or `import module as q.{...}`, gets
// the names added to its list; a `pub import` does not, as the fix must not export them.
// Otherwise a new import line goes after the last import, or, in a file with none, before the
// first line that is not a plain comment or blank, so that a doc comment stays with the item it
// documents.
pub fn import_need(lines: List[Str], starts: List[Int], module: Str, names: List[Str]) -> ImportNeed {
    let stmts = import_stmts(lines, starts, module)
    let mut merge = -1
    let mut present: List[Str] = []
    for s in stmts {
        if !s.of_module { continue }
        if s.odd { return ImportNeed.Blocked }
        for item in s.items {
            for name in names {
                if item.bound != name { continue }
                if item.orig != name { return ImportNeed.Blocked }
                present.push(name)
            }
        }
        if merge == -1 && s.first == s.last && !s.is_pub { merge = s.first }
    }
    let mut missing: List[Str] = []
    for name in names {
        if !present.contains(name) { missing.push(name) }
    }
    if missing.len() == 0 { return ImportNeed.Present }
    let list = missing.join(", ")
    if merge != -1 {
        let line = code_of(lines.get(merge).unwrap())
        let open = line.byte_index_of("\{", 0).unwrap()
        let close = line.byte_index_of("}", open).unwrap()
        let before = line.byte_slice(open + 1, close).trim_right()
        let at = open + 1 + before.byte_len()
        let text = if before.trim() == "" { list } else if before.ends_with(",") { " {list}" } else { ", {list}" }
        return ImportNeed.Add(ImportEdit { line: merge + 1, col: at + 1, end_line: merge + 1, end_col: at + 1, text: text })
    }
    ImportNeed.Add(new_import_edit(lines, stmts, "import {module}.\{{list}}"))
}

// The edit that adds `import module`, for a fix that calls through the module's qualifier. The
// caller has found that no import of the file binds that qualifier to the module.
pub fn import_module_edit(lines: List[Str], starts: List[Int], module: Str) -> ImportEdit {
    new_import_edit(lines, import_stmts(lines, starts, module), "import {module}")
}

// The edit that adds `new_line` after the last of `stmts`, or, in a file with none, before the
// first line that is not a plain comment or blank, so that a doc comment stays with the item it
// documents.
fn new_import_edit(lines: List[Str], stmts: List[ImportDecl], new_line: Str) -> ImportEdit {
    if stmts.len() > 0 {
        let last = stmts.get(stmts.len() - 1).unwrap().last
        let end = lines.get(last).unwrap().byte_len() + 1
        return ImportEdit { line: last + 1, col: end, end_line: last + 1, end_col: end, text: "\n{new_line}" }
    }
    let mut i = 0
    while i < lines.len() {
        let t = lines.get(i).unwrap().trim()
        let plain_comment = t.starts_with("//") && !t.starts_with("///")
        if t != "" && !plain_comment {
            return ImportEdit { line: i + 1, col: 1, end_line: i + 1, end_col: 1, text: "{new_line}\n\n" }
        }
        i = i + 1
    }
    ImportEdit { line: 1, col: 1, end_line: 1, end_col: 1, text: "{new_line}\n" }
}
