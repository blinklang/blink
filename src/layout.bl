// layout.bl: the one place a type id becomes a physical C answer.
//
// Every question here is asked of a tid and a Position and answered from the
// interned type tree plus the type declaration nodes. Nothing here reads a
// codegen table or a flat CT code. A tid this module cannot
// spell gets a decline (non-empty decline_reason, empty spelling), never a guess:
// the caller that needs a spelling turns a decline into I0001.
//
// This module decides storage. It spells no C symbol name of its own: every nominal
// name, carrier tag and runtime symbol comes from cname.bl, and a name cname refuses
// (an ICE_SEG_* sentinel) is a decline here.

import typecheck.{
    TyKind, tk_name, tc_tid_kind, tc_tid_child, tc_tid_child_count, tc_tid_name, tc_resolve,
    tc_is_unbound_metavar, tc_lookup_node_tid, tc_type_decl_nodes, tc_tid_decl_node,
    DECL_NODE_AMBIGUOUS, tc_resolve_transparent_alias_name, tc_type_has_display_impl, tc_type_str, tc_decl_derive_args,
    TYPE_I32,
}
import parser.{
    node_fields, node_name, node_value, node_kind, node_type_params,
    get_annotation, sublist_get, sublist_length,
}
import ast.{NodeKind}
import mono.{instances, node_tid_for_inst}
import diagnostics.{diag_ice_at, diag_is_ice_seg, UNSOLVED_TYPEVAR_AT_CODEGEN}
import cname.{
    c_typedef_name, c_type_decl_name, c_seg_inner, c_vtable_type_name, c_kops_table_name,
    td_guard_open_lines, td_guard_close_line, cname_reset, cname_mark_transparent_newtype,
    cname_mark_runtime_owned, cname_is_transparent_newtype,
}

pub type Position { Local, Field, Param, Return, ContainerSlot, VtableSlot, TupleElem }

// Inline: an aggregate held by value. InlineWord: a value that fits one machine word
// (scalar, pointer, ordinal). PointerBoxed: the slot holds a pointer to a heap copy.
pub type SlotForm { Inline, PointerBoxed, InlineWord }

// Whether the binder a name resolves to may be assigned. Unknown is what a bind site
// that does not record mutability leaves behind, so a reader that needs the answer
// refuses rather than guessing immutable.
pub type BinderMut { Unknown, Immutable, Mutable }

pub type Slot { Inner1, Inner2, Param(Int), Elem(Int) }

// A record answers a tid in a position. Whether a variant field is boxed because it
// reaches its own enum is a relation between the owner and the field, so it is not
// a record field; field_layout_of answers it.
// slot_word is set at Position.ContainerSlot only: the pointer-wide integer an integer
// word rides through to enter and leave a void* element slot (a list element, a map or
// channel value): "(void*)(slot_word)x" in, "(c_spelling)(slot_word)slot" out. It is
// empty when the element is a pointer already, boxed or not, because (void*)x is then
// the whole conversion. A map or set KEY is not a void* slot: the runtime copies it by
// address, so kops_inline_key governs it, not slot_word.
pub type LayoutRecord {
    c_spelling: Str
    slot_form: SlotForm
    carrier_tag: Str
    is_transparent: Int
    kops_table: Str
    kops_inline_key: Bool
    slot_word: Str
    decline_reason: Str
}

// The memo is a pure cache over (tid, position). The typedef buffer and guard set are
// the only side effects this module owns; the binder frames are the only scope state.
let mut layout_memo: Map[Str, LayoutRecord] = Map()
let mut typedef_buffer: List[Str] = []
let mut typedef_guard: Map[Str, Int] = Map()
let mut binder_frame_parent: List[Int] = []
let mut binder_frame_alive: List[Int] = []
let mut binder_frame_start: List[Int] = []
let mut binder_frame_stack: List[Int] = []
let mut binder_entry_frame: List[Int] = []
let mut binder_entry_name: List[Str] = []
let mut binder_entry_tid: List[Int] = []
let mut binder_entry_mut: List[BinderMut] = []

// check_types rebuilds the type pool, so every cached answer is stale after it. The
// cname marks are keyed on declaration nodes from the same build, so they are reset
// and re-marked with it.
pub fn layout_reset() {
    cname_reset()
    lo_mark_decl_facts()
    layout_memo = Map()
    typedef_buffer = []
    typedef_guard = Map()
    binder_frame_parent = []
    binder_frame_alive = []
    binder_frame_start = []
    binder_frame_stack = []
    binder_entry_frame = []
    binder_entry_name = []
    binder_entry_tid = []
    binder_entry_mut = []
    lo_current_inst = -1
}

// ── The eight questions ───────────────────────────────────────────────────

pub fn c_type_of(tid: Int, position: Position) -> Str {
    layout_of(tid, position).c_spelling
}

// The type of a tagged enum's discriminant. The typedef declares a 32-bit signed integer,
// which is narrower than a machine word, so a reader that wants the tag's value must ask
// here rather than assume the word type.
pub fn enum_tag_tid() -> Int { TYPE_I32 }

pub fn carrier_tag_of(tid: Int) -> Str {
    layout_of(tid, Position.Local).carrier_tag
}

// The declared Blink name, read from the declaration. A tid whose declaration cannot be
// found or is ambiguous has no nominal name to give.
pub fn nominal_name_of(tid: Int) -> Str {
    let r = lo_res(tid)
    let k = tc_tid_kind(r)
    if k != TyKind.Struct && k != TyKind.Enum { return "" }
    let decl = tc_tid_decl_node(r)
    if decl < 0 { return "" }
    node_name(decl)
}

pub fn child_tid(tid: Int, slot: Slot) -> Int {
    let r = lo_res(tid)
    let k = tc_tid_kind(r)
    match slot {
        Slot.Inner1 => {
            if k == TyKind.Tuple || k == TyKind.Struct || k == TyKind.Enum { return -1 }
            tc_tid_child(r, 0)
        }
        Slot.Inner2 => {
            if k != TyKind.Result && k != TyKind.Map { return -1 }
            tc_tid_child(r, 1)
        }
        Slot.Param(i) => {
            if k == TyKind.Fn { return tc_tid_child(r, i + 1) }
            if k != TyKind.Struct && k != TyKind.Enum { return -1 }
            tc_tid_child(r, i)
        }
        Slot.Elem(i) => {
            if k != TyKind.Tuple { return -1 }
            tc_tid_child(r, i)
        }
    }
}

// The monomorphised body being lowered. -1 is the root walk, whose nodes carry the types
// typecheck stamped; any other value indexes the instance table, where the same node
// carries the substituted type instead. The driver is the only caller, and it sets -1
// again on the way out of an instance body: a declaration node belongs to no instance, so
// reading one while an instance is current is an error rather than an answer. A lowering
// stage that wants a type asks tid_of_node and never needs to know which of the two
// answers it is getting.
let mut lo_current_inst: Int = -1

pub fn set_current_inst(inst_index: Int) {
    lo_current_inst = inst_index
}

// The body being lowered, for a stage that needs the body itself and not a type: which
// instance a generic call reaches is a fact about the call site, and one call node inside
// a generic body reaches a different instance for every instance of that body.
pub fn current_inst() -> Int {
    lo_current_inst
}

// A node with no recorded type is a compiler bug; report it and answer -1 so the caller
// can stop. Nothing here ever substitutes a default type.
pub fn tid_of_node(node: Int) -> Int ! Diag.Report {
    if lo_current_inst != -1 { return lo_tid_in_current_inst(node) }
    let tid = tc_lookup_node_tid(node)
    if tid >= 0 { return tid }
    diag_ice_at("NoTypeForNode", UNSOLVED_TYPEVAR_AT_CODEGEN,
        "node {node} reached layout with no recorded type", node,
        "typecheck must stamp every node codegen reads; this is a compiler bug")
    -1
}

// Inside an instance the substituted type is the only right answer, so a node the
// instance never recorded is an internal error rather than a read of the generic stamp.
// Only -1 means the root walk; any other number that is not a row of the table is a
// driver bug, and answering the generic stamp for it would be a silent wrong type.
fn lo_tid_in_current_inst(node: Int) -> Int ! Diag.Report {
    let table = instances()
    if lo_current_inst < 0 || lo_current_inst >= table.len() {
        diag_ice_at("NoInstanceForIndex", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "instance {lo_current_inst} is not in the instance table", node,
            "the driver must set the current instance from the table it is walking")
        return -1
    }
    node_tid_for_inst(table.get(lo_current_inst).unwrap(), node)
}

pub fn tid_of_binder(scope: Int, name: Str) -> Int {
    let entry = lo_binder_entry(scope, name)
    if entry < 0 { return -1 }
    binder_entry_tid.get(entry).unwrap()
}

// Whether the binder this name resolves to may be assigned, read off the same entry the
// type comes from. One resolution of the name answers both, so the two cannot drift.
pub fn binder_mutability_of(scope: Int, name: Str) -> BinderMut {
    let entry = lo_binder_entry(scope, name)
    if entry < 0 { return BinderMut.Unknown }
    binder_entry_mut.get(entry).unwrap()
}

pub fn layout_of(tid: Int, position: Position) -> LayoutRecord {
    let key = "{tid}:{lo_position_index(position)}"
    match layout_memo.get(key) {
        Some(rec) => return rec
        None => {}
    }
    let rec = lo_compute_layout(tid, position)
    layout_memo.insert(key, rec)
    rec
}

// The address of a value held at `position`: one word that points at the value, spelled
// as the value's spelling with one more `*`. A value that declines has no address, and a
// void-like value is not a place, so neither is guessed as void*.
pub fn address_layout_of(tid: Int, position: Position) -> LayoutRecord {
    let value = layout_of(tid, position)
    if value.decline_reason != "" { return value }
    let k = tc_tid_kind(lo_res(tid))
    if lo_is_void_like(k) { return lo_declined("void-like {tk_name(k)} has no address") }
    LayoutRecord {
        c_spelling: pointer_spelling(value.c_spelling), slot_form: SlotForm.InlineWord, carrier_tag: "",
        is_transparent: 0, kops_table: "", kops_inline_key: false, slot_word: "", decline_reason: "",
    }
}

// The one place the C pointer star is written: a pointer to a value spelled `pointee`.
pub fn pointer_spelling(pointee: Str) -> Str { "{pointee}*" }

// The receiver word every closure thunk takes first: the closure the call went through.
pub fn closure_self_spelling() -> Str { "const blink_closure*" }

// The C function-pointer type a closure's fn_ptr is cast to before a call: the result at
// its Return layout, then the receiver word, then each parameter at its Param layout, in
// declaration order. A Fn tid is one runtime pointer in every position, so this is the one
// question that spells the whole of it. A slot with no layout is an I0001 at `node` and an
// empty answer; nothing here ever spells a placeholder.
pub fn fn_pointer_spelling_of(tid: Int, node: Int) -> Str ! Diag.Report {
    let r = lo_res(tid)
    if tc_tid_kind(r) != TyKind.Fn {
        let why = lo_decline_reason_of(tid)
        let shown = if why != "" { why } else { tc_type_str(r) }
        diag_ice_at("NotAFnType", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "a function-pointer type was asked of {shown}, which is not a Fn type", node,
            "the call stage must ask this only of a callee whose tid is a Fn; this is a compiler bug")
        return ""
    }
    let ret = lo_fn_slot_spelling(child_tid(tid, Slot.Inner1), Position.Return, node)
    if ret == "" { return "" }
    let mut params = closure_self_spelling()
    let nparams = tc_tid_child_count(r) - 1
    let mut i = 0
    while i < nparams {
        let p = lo_fn_slot_spelling(child_tid(tid, Slot.Param(i)), Position.Param, node)
        if p == "" { return "" }
        params = "{params}, {p}"
        i = i + 1
    }
    "{ret}(*)({params})"
}

fn lo_fn_slot_spelling(tid: Int, position: Position, node: Int) -> Str ! Diag.Report {
    let rec = layout_of(tid, position)
    let why = rec.decline_reason
    if why != "" {
        diag_ice_at("UnspellableFnPointer", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "a Fn type's parameter or result has no C layout: {why}", node,
            "monomorphisation must resolve every type codegen reads; this is a compiler bug")
        return ""
    }
    rec.c_spelling
}

// A variant or struct field in its owner. A field that reaches its own enum by value
// (directly, or through a tuple at any depth) is stored boxed: the owner's C typedef is
// incomplete while its members are declared, so the member is an opaque int64_t word
// that holds the heap pointer. Any other field is its Field-position layout.
pub fn field_layout_of(owner_tid: Int, field_tid: Int) -> LayoutRecord {
    if !lo_embeds_owner(field_tid, owner_tid) { return layout_of(field_tid, Position.Field) }
    LayoutRecord {
        c_spelling: "int64_t", slot_form: SlotForm.PointerBoxed, carrier_tag: "",
        is_transparent: 0, kops_table: "", kops_inline_key: false, slot_word: "", decline_reason: "",
    }
}

// Emits the carrier typedef for an Option, Result or Tuple (inner carriers first) and
// answers its C name. Every other kind answers its spelling and emits nothing.
pub fn ensure_typedef_for(tid: Int) -> Str {
    let rec = layout_of(tid, Position.Local)
    if rec.decline_reason != "" { return "" }
    let r = lo_res(tid)
    let k = tc_tid_kind(r)
    if k == TyKind.Option {
        lo_emit_option_typedef(r, rec.c_spelling)
    } else if k == TyKind.Result {
        lo_emit_result_typedef(r, rec.c_spelling)
    } else if k == TyKind.Tuple {
        lo_emit_tuple_typedef(r, rec.c_spelling)
    }
    rec.c_spelling
}

// Drains the typedef buffer in emit order. Each entry is one guarded block.
pub fn layout_take_typedefs() -> List[Str] {
    let out = typedef_buffer
    typedef_buffer = []
    out
}

// What one carrier slot physically holds. This is NOT the slot's own Local layout:
// an Option payload that does not fit a word is stored by pointer, a Result ok arm is
// always by value, a Result err arm is by pointer only for a non-word struct, and every
// tuple element is by value. A Void or Ptr payload is erased the same way the typedef
// emitter erases it, so a wrap and the typedef always agree on the member's type.
pub fn carrier_member_layout(carrier_tid: Int, slot: Slot) -> LayoutRecord {
    let reason = lo_decline_reason_of(carrier_tid)
    if reason != "" { return lo_declined(reason) }
    let r = lo_res(carrier_tid)
    let inner = child_tid(r, slot)
    if inner < 0 { return lo_declined("carrier of kind {tk_name(tc_tid_kind(r))} has no such member slot") }
    let inner_reason = lo_decline_reason_of(inner)
    if inner_reason != "" { return lo_declined(inner_reason) }
    let ir = lo_res(inner)
    let spelling = lo_member_spelling(ir)
    if diag_is_ice_seg(spelling) { return lo_declined("cname refused the name: {spelling}") }
    lo_member_record(r, ir, slot, spelling)
}

fn lo_member_record(r: Int, ir: Int, slot: Slot, spelling: Str) -> LayoutRecord {
    let boxed = lo_member_is_boxed(r, ir, slot)
    let mut form = SlotForm.Inline
    if boxed {
        form = SlotForm.PointerBoxed
    } else if lo_fits_word(ir) {
        form = SlotForm.InlineWord
    }
    let mut member = spelling
    if boxed { member = pointer_spelling(spelling) }
    let table = lo_kops_of(ir)
    LayoutRecord {
        c_spelling: member,
        slot_form: form,
        carrier_tag: lo_tag_of(ir),
        is_transparent: if lo_is_transparent_newtype(ir) { 1 } else { 0 },
        kops_table: table,
        kops_inline_key: lo_kops_inline_key(ir, table),
        slot_word: "",
        decline_reason: "",
    }
}

fn lo_member_is_boxed(r: Int, ir: Int, slot: Slot) -> Bool {
    let k = tc_tid_kind(r)
    if k == TyKind.Option { return !lo_fits_word(ir) }
    if k != TyKind.Result { return false }
    match slot {
        Slot.Inner2 => lo_is_struct_by_pointer_err(ir)
        _ => false
    }
}

// ── The varargs boundary ──────────────────────────────────────────────────

// A value crossing `...` is not stored, it is converted, so this is a separate question
// from layout_of. C promotes every integer argument to at least int and every float to
// double, and the promoted type must match the conversion the format string names, or
// the read is undefined. `long long` is that ABI width, not a storage spelling, which is
// why it appears here and in no layout record.
//
// An empty spelling means the value passes unchanged. An empty spec means this tid has no
// printf form at all and the caller must render it some other way.
pub fn varargs_spelling(tid: Int) -> Str {
    let reason = lo_decline_reason_of(tid)
    if reason != "" { return "" }
    let r = lo_res(tid)
    if lo_is_transparent_newtype(r) { return "long long" }
    let k = tc_tid_kind(r)
    if lo_spec_is_signed(k) { return "long long" }
    if lo_spec_is_unsigned(k) { return "unsigned long long" }
    ""
}

pub fn format_spec_of(tid: Int) -> Str {
    let reason = lo_decline_reason_of(tid)
    if reason != "" { return "" }
    let r = lo_res(tid)
    // The integer is the newtype's storage, not its face. A Display impl says how the
    // type shows itself, so no conversion prints the raw word past it.
    if lo_is_transparent_newtype(r) {
        if lo_decl_has_display_impl(tc_tid_decl_node(r)) { return "" }
        return "%lld"
    }
    let k = tc_tid_kind(r)
    if lo_spec_is_signed(k) { return "%lld" }
    if lo_spec_is_unsigned(k) { return "%llu" }
    if k == TyKind.Float { return "%g" }
    if k == TyKind.Str { return "%s" }
    if k == TyKind.Bool { return "%s" }
    if k == TyKind.Char { return "%s" }
    ""
}

// A transparent newtype prints as the word it is. Char is signed but never printed as a
// number, so it is not listed here.
fn lo_spec_is_signed(k: TyKind) -> Bool {
    k == TyKind.Int || k == TyKind.I8 || k == TyKind.I16 || k == TyKind.I32
}

fn lo_spec_is_unsigned(k: TyKind) -> Bool {
    k == TyKind.U8 || k == TyKind.U16 || k == TyKind.U32 || k == TyKind.U64
}

// ── Binder scopes ─────────────────────────────────────────────────────────

pub fn binder_scope_push() -> Int {
    let id = binder_frame_parent.len()
    let parent = if binder_frame_stack.len() > 0 { binder_frame_stack.get(binder_frame_stack.len() - 1).unwrap() } else { -1 }
    binder_frame_parent.push(parent)
    binder_frame_start.push(binder_entry_frame.len())
    binder_frame_alive.push(1)
    binder_frame_stack.push(id)
    id
}

// Frames are LIFO, so every entry bound since the frame opened is dead with it.
pub fn binder_scope_pop() {
    if binder_frame_stack.len() == 0 { return }
    let top = binder_frame_stack.get(binder_frame_stack.len() - 1).unwrap()
    binder_frame_alive.set(top, 0)
    binder_frame_stack.pop()
    let start = binder_frame_start.get(top).unwrap()
    while binder_entry_frame.len() > start {
        binder_entry_frame.pop()
        binder_entry_name.pop()
        binder_entry_tid.pop()
        binder_entry_mut.pop()
    }
}

// The frame lowering is inside. The expression stage reads it to tell a binder in scope
// from a module-level name, so it needs no scope stack of its own to disagree with.
pub fn current_binder_scope() -> Int {
    if binder_frame_stack.len() == 0 { return -1 }
    binder_frame_stack.get(binder_frame_stack.len() - 1).unwrap()
}

// A bind site that does not know whether the name may be assigned records Unknown, so
// every site left unswitched refuses a capture instead of copying a shared binding.
pub fn bind_binder(scope: Int, name: Str, tid: Int) {
    lo_bind(scope, name, tid, BinderMut.Unknown)
}

pub fn bind_binder_mut(scope: Int, name: Str, tid: Int, is_mut: Bool) {
    lo_bind(scope, name, tid, if is_mut { BinderMut.Mutable } else { BinderMut.Immutable })
}

fn lo_bind(scope: Int, name: Str, tid: Int, m: BinderMut) {
    if scope < 0 || scope >= binder_frame_alive.len() { return }
    if binder_frame_alive.get(scope).unwrap() == 0 { return }
    binder_entry_frame.push(scope)
    binder_entry_name.push(name)
    binder_entry_tid.push(tid)
    binder_entry_mut.push(m)
}

// The entry a name resolves to from this scope, or -1.
fn lo_binder_entry(scope: Int, name: Str) -> Int {
    let mut frame = scope
    while frame >= 0 && frame < binder_frame_parent.len() {
        if binder_frame_alive.get(frame).unwrap() == 0 { return -1 }
        let hit = lo_binder_index_in_frame(frame, name)
        if hit >= 0 { return hit }
        frame = binder_frame_parent.get(frame).unwrap()
    }
    -1
}

fn lo_binder_index_in_frame(frame: Int, name: Str) -> Int {
    let mut i = binder_entry_frame.len() - 1
    while i >= 0 {
        if binder_entry_frame.get(i).unwrap() == frame && binder_entry_name.get(i).unwrap() == name {
            return i
        }
        i = i - 1
    }
    -1
}

// ── Layout computation ────────────────────────────────────────────────────

// Follows bound metavars, then a transparent `type A = X` alias to the type that owns
// the C spelling. An alias has no C identity of its own.
fn lo_res(tid: Int) -> Int {
    let r = tc_resolve(tid)
    if r < 0 { return r }
    let k = tc_tid_kind(r)
    if (k == TyKind.Struct || k == TyKind.Enum) && tc_tid_child_count(r) == 0 {
        let underlying = tc_resolve_transparent_alias_name(tc_tid_name(r))
        if underlying != -1 && underlying != r { return lo_res(underlying) }
    }
    r
}

fn lo_position_index(position: Position) -> Int {
    match position {
        Position.Local => 0
        Position.Field => 1
        Position.Param => 2
        Position.Return => 3
        Position.ContainerSlot => 4
        Position.VtableSlot => 5
        Position.TupleElem => 6
    }
}

fn lo_declined(reason: Str) -> LayoutRecord {
    LayoutRecord {
        c_spelling: "", slot_form: SlotForm.InlineWord, carrier_tag: "",
        is_transparent: 0, kops_table: "", kops_inline_key: false, slot_word: "", decline_reason: reason,
    }
}

fn lo_compute_layout(tid: Int, position: Position) -> LayoutRecord {
    let reason = lo_decline_reason_of(tid)
    if reason != "" { return lo_declined(reason) }
    let r = lo_res(tid)
    let k = tc_tid_kind(r)
    let transparent = if lo_is_transparent_newtype(r) { 1 } else { 0 }
    let word = lo_fits_word(r)
    let mut spelling = lo_spell(r)
    if diag_is_ice_seg(spelling) { return lo_declined("cname refused the name: {spelling}") }
    let mut form = if word { SlotForm.InlineWord } else { SlotForm.Inline }
    // A vtable slot holds an operation's answer, so it takes void for an operation that answers
    // nothing, the same as a plain return. The storage placeholder would give the slot a return
    // type that a handler function answering nothing cannot be assigned to.
    if lo_is_void_like(k) && (position == Position.Return || position == Position.VtableSlot) {
        spelling = "void"
        form = SlotForm.Inline
    } else if position == Position.ContainerSlot && (!word || k == TyKind.Float) {
        // The slot is a void*: an aggregate cannot fit, and a double must not be punned
        // through an integer, so both live behind a pointer the reader dereferences.
        form = SlotForm.PointerBoxed
        spelling = pointer_spelling(spelling)
    } else if position == Position.VtableSlot && k == TyKind.Option && lo_is_boxed_nominal(lo_res(tc_tid_child(r, 0))) {
        // Every handler of one effect shares one C signature, so an Option over a
        // nominal payload is erased to the pointer carrier in the vtable slot.
        spelling = "blink_Option_ptr"
    }
    let table = lo_kops_of(r)
    let slot_word = if position == Position.ContainerSlot && form == SlotForm.InlineWord { lo_slot_word(r, k) } else { "" }
    LayoutRecord {
        c_spelling: spelling, slot_form: form, carrier_tag: lo_tag_of(r),
        is_transparent: transparent, kops_table: table,
        kops_inline_key: lo_kops_inline_key(r, table),
        slot_word: slot_word,
        decline_reason: "",
    }
}

// The integer a word element is punned through into the void* slot. A pointer word needs
// none. U64 takes the unsigned bridge so a value above INT64_MAX survives the round trip.
// Struct and Enum here are the word-sized nominals: an opaque handle is a pointer, a
// transparent newtype or an ordinal enum is an integer.
fn lo_slot_word(r: Int, k: TyKind) -> Str {
    if k == TyKind.Struct || k == TyKind.Enum {
        if lo_is_transparent_newtype(r) { return "intptr_t" }
        return if lo_is_opaque(r) { "" } else { "intptr_t" }
    }
    match k {
        TyKind.Int => "intptr_t"
        TyKind.Bool => "intptr_t"
        TyKind.Char => "intptr_t"
        TyKind.I8 => "intptr_t"
        TyKind.I16 => "intptr_t"
        TyKind.I32 => "intptr_t"
        TyKind.U8 => "intptr_t"
        TyKind.U16 => "intptr_t"
        TyKind.U32 => "intptr_t"
        TyKind.U64 => "uintptr_t"
        TyKind.Void => "intptr_t"
        TyKind.Never => "intptr_t"
        _ => ""
    }
}

// Every container slot is one pointer-wide cell, so this is one spelling, not a question
// about a tid: the slot word says how a value travels through the cell, this says what it is.
pub fn container_slot_spelling() -> Str { "void*" }

// Does a field of this type embed its owner by value -- the owner itself, or a tuple that
// reaches it at any depth? The owner is named by its own tid and compared as one, not by
// its declaration: two instances of one declaration are two types, so a field at another
// instance of the very same declaration is finite and is held by value. A declaration
// shared by two types answers this correctly for the same reason, so nothing here needs to
// know whether the name was ambiguous; a tid whose declaration is ambiguous declines on its
// own in lo_decline_reason_of, where the field's Field-position layout asks.
fn lo_embeds_owner(field_tid: Int, owner_tid: Int) -> Bool {
    if owner_tid < 0 { return false }
    lo_embeds_tid(field_tid, lo_res(owner_tid))
}

fn lo_embeds_tid(field_tid: Int, owner: Int) -> Bool {
    let r = lo_res(field_tid)
    let k = tc_tid_kind(r)
    if k == TyKind.Struct || k == TyKind.Enum { return r == owner }
    if k != TyKind.Tuple { return false }
    let n = tc_tid_child_count(r)
    let mut i = 0
    while i < n {
        if lo_embeds_tid(tc_tid_child(r, i), owner) { return true }
        i = i + 1
    }
    false
}

// The reasons a tid has no C answer. A pointer container (List, Map, Set, Channel,
// Handle, Ptr, Fn) is one runtime type whatever its child, so it never declines here;
// its child declines on its own when asked.
fn lo_decline_reason_of(tid: Int) -> Str {
    if tid < 0 { return "negative type id" }
    let r = lo_res(tid)
    let k = tc_tid_kind(r)
    if k == TyKind.Unknown {
        if tc_is_unbound_metavar(r) != 0 { return "unbound metavariable" }
        return "unknown type"
    }
    if k == TyKind.Typevar { return "free type variable {tc_tid_name(r)}" }
    if k == TyKind.Struct || k == TyKind.Enum {
        let decl = tc_tid_decl_node(r)
        if decl == DECL_NODE_AMBIGUOUS { return "ambiguous declaration for {tc_tid_name(r)}" }
        if tc_tid_child_count(r) == 0 && lo_decl_is_generic(decl) { return "un-monomorphised generic {tc_tid_name(r)}" }
        let child = lo_instance_arg_decline(r)
        if child != "" { return child }
        return lo_first_child_decline(r, 0)
    }
    if k == TyKind.Option || k == TyKind.Result || k == TyKind.Tuple { return lo_first_child_decline(r, 0) }
    ""
}

// A mono stem has no segment grammar for a closure, template or ffi scope argument,
// and an undetermined type anywhere under an argument leaves the stem unspellable,
// even under a pointer container that would erase it in a plain slot.
fn lo_instance_arg_decline(r: Int) -> Str {
    let n = tc_tid_child_count(r)
    let mut i = 0
    while i < n {
        let reason = lo_arg_decline_deep(tc_tid_child(r, i))
        if reason != "" { return reason }
        i = i + 1
    }
    ""
}

fn lo_arg_decline_deep(tid: Int) -> Str {
    let reason = lo_decline_reason_of(tid)
    if reason != "" { return reason }
    let a = lo_res(tid)
    let k = tc_tid_kind(a)
    if k == TyKind.Fn || k == TyKind.Template || k == TyKind.FfiScope { return "instance argument of kind {tk_name(k)} has no mono segment" }
    let n = tc_tid_child_count(a)
    let mut i = 0
    while i < n {
        let child = lo_arg_decline_deep(tc_tid_child(a, i))
        if child != "" { return child }
        i = i + 1
    }
    ""
}

fn lo_first_child_decline(r: Int, from: Int) -> Str {
    let n = tc_tid_child_count(r)
    let mut i = from
    while i < n {
        let reason = lo_decline_reason_of(tc_tid_child(r, i))
        if reason != "" { return reason }
        i = i + 1
    }
    ""
}

fn lo_is_void_like(k: TyKind) -> Bool {
    k == TyKind.Void || k == TyKind.Never
}

// True when the value is one machine word: a scalar, a runtime pointer, an ordinal enum,
// a transparent newtype, an opaque handle or an Option over an opaque handle.
fn lo_fits_word(r: Int) -> Bool {
    let k = tc_tid_kind(r)
    if k == TyKind.Struct || k == TyKind.Enum {
        if lo_is_transparent_newtype(r) { return true }
        if lo_is_opaque(r) { return true }
        // A type argument does not add a payload: a generic enum whose variants carry no
        // fields is still one ordinal word.
        if k == TyKind.Enum { return !lo_decl_is_data_enum(tc_tid_decl_node(r)) }
        return false
    }
    if k == TyKind.Option { return lo_is_opaque(lo_res(tc_tid_child(r, 0))) }
    if k == TyKind.Result || k == TyKind.Tuple { return false }
    true
}

// A struct, data enum, instance, carrier or tuple: what an Option payload stores by
// pointer and what a vtable slot erases.
fn lo_is_boxed_nominal(r: Int) -> Bool {
    let k = tc_tid_kind(r)
    if k != TyKind.Struct && k != TyKind.Enum { return false }
    !lo_fits_word(r)
}

// ── Spelling ──────────────────────────────────────────────────────────────

// The C spelling of a resolved tid. Scalars and runtime containers are fixed runtime
// types; every nominal or carrier name is asked of cname.
fn lo_spell(r: Int) -> Str {
    let k = tc_tid_kind(r)
    let scalar = lo_spell_scalar(k)
    if scalar != "" { return scalar }
    match k {
        TyKind.Struct => lo_spell_nominal(r)
        TyKind.Enum => lo_spell_nominal(r)
        TyKind.Option => lo_spell_option(r)
        TyKind.Result => c_typedef_name(r)
        TyKind.Tuple => c_typedef_name(r)
        TyKind.Ptr => lo_spell_ptr(r)
        TyKind.Handler => lo_spell_handler(r)
        _ => ""
    }
}

// Kinds whose spelling does not depend on a child. Void here is the storage
// placeholder; Return replaces it with void in lo_compute_layout.
fn lo_spell_scalar(k: TyKind) -> Str {
    match k {
        TyKind.Int => "int64_t"
        TyKind.Float => "double"
        TyKind.Bool => "int"
        TyKind.Str => "const char*"
        TyKind.Char => "int32_t"
        TyKind.I8 => "int8_t"
        TyKind.I16 => "int16_t"
        TyKind.I32 => "int32_t"
        TyKind.U8 => "uint8_t"
        TyKind.U16 => "uint16_t"
        TyKind.U32 => "uint32_t"
        TyKind.U64 => "uint64_t"
        TyKind.Void => "int64_t"
        TyKind.Never => "int64_t"
        TyKind.List => "blink_list*"
        TyKind.FfiScope => "blink_list*"
        TyKind.Map => "blink_map*"
        TyKind.Set => "blink_set*"
        TyKind.Bytes => "blink_bytes*"
        TyKind.StringBuilder => "blink_sb*"
        TyKind.Channel => "blink_channel*"
        TyKind.Handle => "blink_handle*"
        TyKind.Iterator => "void*"
        TyKind.Fn => "blink_closure*"
        TyKind.Template => "blink_template*"
        _ => ""
    }
}

// A transparent newtype is its bare payload word. Everything else, an opaque handle
// included, is the typedef name cname spells for the tid.
fn lo_spell_nominal(r: Int) -> Str {
    if lo_is_transparent_newtype(r) { return "int64_t" }
    c_typedef_name(r)
}

// An Option over an opaque handle is the bare handle pointer: NULL is None.
fn lo_spell_option(r: Int) -> Str {
    let inner = lo_res(tc_tid_child(r, 0))
    let opaque = lo_opaque_decl(inner)
    if opaque >= 0 { return c_type_decl_name(opaque) }
    c_typedef_name(r)
}

// A pointee that cannot be spelled drops to void*; a Ptr never declines.
fn lo_spell_ptr(r: Int) -> Str {
    let pointee = lo_res(tc_tid_child(r, 0))
    if lo_decline_reason_of(pointee) != "" { return "void*" }
    let k = tc_tid_kind(pointee)
    if lo_is_void_like(k) { return "void*" }
    let inner = lo_spell(pointee)
    if diag_is_ice_seg(inner) { return inner }
    pointer_spelling(inner)
}

fn lo_spell_handler(r: Int) -> Str {
    let vt = c_vtable_type_name(r)
    if diag_is_ice_seg(vt) { return vt }
    pointer_spelling(vt)
}

// ── Carrier tags ──────────────────────────────────────────────────────────

// The segment a carrier name is built from, spelled by cname at INNER position. A kind
// that has no carrier segment (cname refuses it) has no tag.
fn lo_tag_of(r: Int) -> Str {
    let seg = c_seg_inner(r)
    if diag_is_ice_seg(seg) { return "" }
    seg
}

// ── Key operations ────────────────────────────────────────────────────────

// Why this key has no table, or "" when it has one. The sole producer of the answer:
// lo_kops_of is the same decision with the reason dropped. An empty table name used to
// mean two unrelated things — a type that correctly declines a table because it derives
// no Hash, and a key that is not a type yet at all — and a reader could not tell a
// legitimate refusal from a defect. A bare type parameter or an unsolved metavariable
// falls in the second group: it is a decline with a reason, never a fabricated name.
pub fn lo_kops_decline_of(r: Int) -> Str {
    let k = tc_tid_kind(r)
    if k == TyKind.Struct || k == TyKind.Enum {
        if !decl_has_derive(tc_tid_decl_node(r), "Hash") { return "no Hash derive on {tc_tid_name(r)}" }
    }
    let table = c_kops_table_name(r)
    if !diag_is_ice_seg(table) { return "" }
    let why = lo_decline_reason_of(r)
    if why != "" { return why }
    "no key operations for kind {tk_name(k)}"
}

// A builtin scalar key has a runtime table. A struct or enum key has a table only when
// it derives Hash; cname spells the symbol codegen_derive emits for it.
fn lo_kops_of(r: Int) -> Str {
    if lo_kops_decline_of(r) != "" { return "" }
    c_kops_table_name(r)
}

// Whether the runtime stores the key's own bytes in the map or set slot, or a pointer to
// a heap copy. A word-sized key is inline, which is also what every List[K] producer puts
// in a list slot, so blink_map_keys can pack the same way. Str is the runtime's exception:
// blink_kops_str reads the slot's pointer as the string itself. No table, no choice.
fn lo_kops_inline_key(r: Int, table: Str) -> Bool {
    if table == "" { return false }
    if tc_tid_kind(r) == TyKind.Str { return false }
    lo_fits_word(r)
}

// ── Declaration node facts ────────────────────────────────────────────────

fn lo_decl_is_generic(decl: Int) -> Bool {
    if decl < 0 { return false }
    let tps = node_type_params(decl)
    tps != -1 && sublist_length(tps) > 0
}

fn lo_decl_is_enum(decl: Int) -> Bool {
    if decl < 0 { return false }
    let flds = node_fields(decl)
    if flds == -1 || sublist_length(flds) == 0 { return false }
    node_kind(sublist_get(flds, 0)) == NodeKind.TypeVariant
}

fn lo_decl_is_data_enum(decl: Int) -> Bool {
    if !lo_decl_is_enum(decl) { return false }
    let vars = node_fields(decl)
    let mut i = 0
    while i < sublist_length(vars) {
        let vflds = node_fields(sublist_get(vars, i))
        if vflds != -1 && sublist_length(vflds) > 0 { return true }
        i = i + 1
    }
    false
}

fn lo_is_transparent_newtype(r: Int) -> Bool {
    if tc_tid_kind(r) != TyKind.Enum { return false }
    let decl = tc_tid_decl_node(r)
    decl >= 0 && cname_is_transparent_newtype(decl)
}

fn lo_is_opaque(r: Int) -> Bool { lo_opaque_decl(r) >= 0 }

// The declaration node of an @ffi.opaque struct or enum, else -1.
fn lo_opaque_decl(r: Int) -> Int {
    let k = tc_tid_kind(r)
    if k != TyKind.Struct && k != TyKind.Enum { return -1 }
    let decl = tc_tid_decl_node(r)
    if decl >= 0 && get_annotation(decl, "ffi.opaque") != -1 { return decl }
    -1
}

// A declaration carries a codegen fact, and the module that declares it is what decides
// the fact. The spelling never does: a user type is free to be named Errno, and it keeps
// the ordinary lowering.
type LoDeclFact {
    module_name: Str
    type_name: Str
    fact: Str
}

let LO_FACT_TRANSPARENT_NEWTYPE: Str = "transparent_newtype"
let LO_FACT_RUNTIME_OWNED: Str = "runtime_owned"

// The whole set, in one place. Errno with exactly one variant carrying exactly one Int
// is the transparent newtype that lowers to a bare int64_t. ConversionError and
// ProcessResult are declared in lib/std but defined by runtime.h, so they keep the bare
// blink_<Name> the runtime declares.
fn lo_decl_fact_table() -> List[LoDeclFact] {
    [
        LoDeclFact { module_name: "std_errno", type_name: "Errno", fact: LO_FACT_TRANSPARENT_NEWTYPE },
        LoDeclFact { module_name: "std_traits", type_name: "ConversionError", fact: LO_FACT_RUNTIME_OWNED },
        LoDeclFact { module_name: "std_process", type_name: "ProcessResult", fact: LO_FACT_RUNTIME_OWNED },
    ]
}

// Neither the node nor the tid carries these facts, so they are marked on cname once per
// build. Until an annotation or typecheck owns them, this pass is the interim owner.
//
// Each row is read through the QUALIFIED key. The bare-name index keeps only its last
// writer, so reading it by bare name hands a user namesake the stdlib declaration's mark
// and leaves the stdlib declaration bare, mis-lowering both.
fn lo_mark_decl_facts() {
    for row in lo_decl_fact_table() {
        let decl = tc_type_decl_nodes.get("{row.module_name}.{row.type_name}") ?? -1
        if decl >= 0 && node_name(decl) == row.type_name {
            if row.fact == LO_FACT_TRANSPARENT_NEWTYPE && lo_decl_is_int_newtype_shape(decl) {
                cname_mark_transparent_newtype(decl)
            }
            if row.fact == LO_FACT_RUNTIME_OWNED { cname_mark_runtime_owned(decl) }
        }
    }
}

fn lo_decl_is_int_newtype_shape(decl: Int) -> Bool {
    if !lo_decl_is_enum(decl) { return false }
    let vars = node_fields(decl)
    if sublist_length(vars) != 1 { return false }
    let vflds = node_fields(sublist_get(vars, 0))
    if vflds == -1 || sublist_length(vflds) != 1 { return false }
    let ann = node_value(sublist_get(vflds, 0))
    ann != -1 && node_name(ann) == "Int"
}

// An @ffi.opaque handle is a pointer to a foreign body this compiler cannot see, so
// nothing may read its shape and nothing may compare it by value. The handle's word
// form is a layout fact, so the question is answered here rather than by a second
// reader of the annotation.
pub fn tid_is_opaque_handle(tid: Int) -> Bool {
    lo_is_opaque(lo_res(tid))
}

// Whether a value of this tid keeps its discriminant in a member of its own C shape,
// rather than being that discriminant. A consumer picks between `x.tag` and `x` on this
// answer, and picking on the type's kind is what wrote `.tag` against one machine word: a
// payload-less enum, a transparent newtype and an Option over an opaque handle are each an
// Enum or a carrier by kind and one undecorated word by shape. Width already decides, so
// the answer is read off the same word test every spelling here is read off.
pub fn tid_holds_tag_member(tid: Int) -> Bool {
    let r = lo_res(tid)
    let k = tc_tid_kind(r)
    if k != TyKind.Option && k != TyKind.Result && k != TyKind.Enum { return false }
    !lo_fits_word(r)
}

// Every name written in every @derive on a declaration, as the annotation argument
// nodes. Typecheck owns the walk, because it also decides which names are legal and
// has to point a diagnostic at the same node this returns.
pub fn decl_derive_args(decl: Int) -> List[Int] {
    tc_decl_derive_args(decl)
}

// Typecheck owns which types have Display. A transparent newtype has no type arguments,
// so the impl registered under its bare name is the whole answer.
fn lo_decl_has_display_impl(decl: Int) -> Bool {
    decl >= 0 && tc_type_has_display_impl(node_name(decl)) != 0
}

// Whether a declaration carries one @derive name. Published because the call stage has
// to tell a derived method's symbol from a hand-written impl's, and reading the annotation
// a second time is how the two answers drift apart.
pub fn decl_has_derive(decl: Int, derive_name: Str) -> Bool {
    for a in decl_derive_args(decl) {
        if node_name(a) == derive_name { return true }
    }
    false
}

// ── Typedef emission ──────────────────────────────────────────────────────

fn lo_guard_and_push(name: Str, body: Str) {
    typedef_guard.insert(name, 1)
    let open = td_guard_open_lines(name)
    typedef_buffer.push("{open.get(0).unwrap()}\n{open.get(1).unwrap()}\n{body}\n{td_guard_close_line()}")
}

fn lo_is_carrier_kind(k: TyKind) -> Bool {
    k == TyKind.Option || k == TyKind.Result || k == TyKind.Tuple
}

// The C compiler must have seen a member's type before the struct that embeds it.
fn lo_ensure_child_typedef(child: Int) {
    let c = lo_res(child)
    if lo_is_carrier_kind(tc_tid_kind(c)) { let _ = ensure_typedef_for(c) }
}

// The Option payload: word-sized values and plain enums sit inline; a struct, data
// enum, instance, carrier or tuple sits behind a pointer.
fn lo_emit_option_typedef(r: Int, name: Str) {
    let inner = lo_res(tc_tid_child(r, 0))
    if lo_is_opaque(inner) { return }
    if typedef_guard.contains_key(name) != 0 { return }
    lo_ensure_child_typedef(inner)
    let member = if lo_fits_word(inner) { lo_member_spelling(inner) } else { pointer_spelling(lo_spell(inner)) }
    lo_guard_and_push(name, "typedef struct \{ int tag; {member} value; } {name};")
}

// The ok arm is by value; a struct-typed err arm is by pointer; a Void arm is an
// int64_t placeholder. blink_Result_str_str is declared by the runtime header.
fn lo_emit_result_typedef(r: Int, name: Str) {
    if typedef_guard.contains_key(name) != 0 { return }
    if name == "blink_Result_str_str" {
        typedef_guard.insert(name, 1)
        return
    }
    let ok = lo_res(tc_tid_child(r, 0))
    let err = lo_res(tc_tid_child(r, 1))
    lo_ensure_child_typedef(ok)
    lo_ensure_child_typedef(err)
    let ok_member = lo_member_spelling(ok)
    let mut err_member = lo_member_spelling(err)
    if lo_is_struct_by_pointer_err(err) { err_member = pointer_spelling(err_member) }
    lo_guard_and_push(name, "typedef struct \{ int tag; union \{ {ok_member} ok; {err_member} err; }; } {name};")
}

fn lo_is_struct_by_pointer_err(err: Int) -> Bool {
    let k = tc_tid_kind(err)
    if k != TyKind.Struct { return false }
    !lo_fits_word(err)
}

// Every tuple element is by value.
fn lo_emit_tuple_typedef(r: Int, name: Str) {
    if typedef_guard.contains_key(name) != 0 { return }
    let n = tc_tid_child_count(r)
    let mut i = 0
    while i < n {
        lo_ensure_child_typedef(tc_tid_child(r, i))
        i = i + 1
    }
    let mut body = "typedef struct \{\n"
    i = 0
    while i < n {
        body = "{body}    {lo_member_spelling(lo_res(tc_tid_child(r, i)))} _{i};\n"
        i = i + 1
    }
    lo_guard_and_push(name, "{body}} {name};")
}

// A carrier member drops the pointee or effect: one blink_Option_ptr must serve every
// Ptr[T] and one blink_Option_handler every effect, or two payload types would fight
// over one guarded typedef name.
fn lo_member_spelling(r: Int) -> Str {
    let k = tc_tid_kind(r)
    if lo_is_void_like(k) { return "int64_t" }
    if k == TyKind.Ptr || k == TyKind.Handler { return "void*" }
    lo_spell(r)
}
