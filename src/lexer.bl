import tokens.{Token, TokenKind, keyword_lookup}
import diagnostics.{Diag, diag_error_range, diag_error_span_notes, diag_cut_after, UNEXPECTED_CHARACTER, EMPTY_UNICODE_ESCAPE, UNICODE_ESCAPE_TOO_LONG, INVALID_UNICODE_ESCAPE_DIGIT, UNTERMINATED_UNICODE_ESCAPE, SURROGATE_ESCAPE, UNICODE_ESCAPE_OUT_OF_RANGE, UNICODE_ESCAPE_NEEDS_BRACES, HEX_ESCAPE_NOT_SUPPORTED, NUL_IN_STR, UNKNOWN_ESCAPE, EMPTY_CHAR_LITERAL, MULTI_CHAR_LITERAL, UNTERMINATED_LITERAL}
import std.str.{str_from_code_point}
import ast.{trace, trace_mode}

effect Lex {
    effect Tokenize
}

// lexer.bl — Self-hosting lexer for Blink, ported from Python
//
// Demonstrates: char_at / ASCII arithmetic, string interpolation scanning,
//               mode-stack-based string/normal interleaving.
//
// Token output is a column per Token field. Mode stack is parallel lists
// instead of tuples.

// ── Mode constants ───────────────────────────────────────────────────
let MODE_NORMAL = 0
let MODE_STRING = 1

// ── ASCII constants ──────────────────────────────────────────────────
let CH_TAB = 9
let CH_NEWLINE = 10
let CH_SPACE = 32
let CH_DQUOTE = 34
let CH_PERCENT = 37
let CH_LPAREN = 40
let CH_RPAREN = 41
let CH_STAR = 42
let CH_PLUS = 43
let CH_COMMA = 44
let CH_MINUS = 45
let CH_DOT = 46
let CH_SLASH = 47
let CH_0 = 48
let CH_9 = 57
let CH_COLON = 58
let CH_LESS = 60
let CH_EQUALS = 61
let CH_GREATER = 62
let CH_QUESTION = 63
let CH_AT = 64
let CH_A = 65
let CH_Z = 90
let CH_LBRACKET = 91
let CH_BACKSLASH = 92
let CH_RBRACKET = 93
let CH_UNDERSCORE = 95
let CH_a = 97
let CH_b = 98
let CH_f = 102
let CH_n = 110
let CH_r = 114
let CH_t = 116
let CH_Z_LOWER = 122
let CH_LBRACE = 123
let CH_PIPE = 124
let CH_RBRACE = 125
let CH_BANG = 33
let CH_HASH = 35
let CH_AMP = 38
let CH_SQUOTE = 39
let CH_BACKSPACE = 8
let CH_FORMFEED = 12
let CH_CARET = 94
let CH_TILDE = 126
let CH_DOLLAR = 36
let CH_D = 68
let CH_F = 70
let CH_S = 83
let CH_U = 85
let CH_W = 87
let CH_d = 100
let CH_e = 101
let CH_s = 115
let CH_u = 117
let CH_v = 118
let CH_w = 119
let CH_x = 120

// ── Character classification ─────────────────────────────────────────

fn is_alpha(c: Int) -> Int {
    (c >= CH_A && c <= CH_Z) || (c >= CH_a && c <= CH_Z_LOWER) || c == CH_UNDERSCORE
}

fn is_digit(c: Int) -> Int {
    c >= CH_0 && c <= CH_9
}

fn is_alnum(c: Int) -> Int {
    is_alpha(c) || is_digit(c)
}

fn is_whitespace(c: Int) -> Int {
    c == CH_SPACE || c == CH_TAB
}

// ── Peek helpers ─────────────────────────────────────────────────────

// Str.len() lowers to strlen() — a full O(N) scan of source. The lexer hot
// loop hits this >75 times per byte (direct .len() checks + peek/peek_at),
// turning lexing into O(N²). source_len is hoisted once in lex() and threaded
// through these helpers so the inner loop stays O(1) per byte.
fn peek(source: Str, source_len: Int, scan_pos: Int) -> Int {
    if scan_pos >= source_len {
        0
    } else {
        source.byte_at(scan_pos).to_int()
    }
}

// Offset just past the character that starts at pos. A byte that does not start a
// well-formed UTF-8 sequence is a character on its own, so a file that is not UTF-8 still
// lexes one byte at a time instead of swallowing the bytes after it.
fn codepoint_end(source: Str, source_len: Int, pos: Int) -> Int {
    let b = peek(source, source_len, pos)
    let w = if b >= 194 && b < 224 { 2 } else if b >= 224 && b < 240 { 3 } else if b >= 240 && b < 245 { 4 } else { 1 }
    if pos + w > source_len { return pos + 1 }
    let mut k = 1
    while k < w {
        let c = peek(source, source_len, pos + k)
        if c < 128 || c >= 192 { return pos + 1 }
        k = k + 1
    }
    pos + w
}

// The text of the character at pos..end, for a diagnostic. A byte that is not UTF-8 is
// spelled `\xNN`: it is not text, and slicing it out would cut a codepoint.
fn char_text(source: Str, pos: Int, end: Int) -> Str {
    let b = source.byte_at(pos).to_int()
    if end - pos > 1 || b < 128 { return source.byte_slice(pos, end) }
    let digits = "0123456789ABCDEF"
    "\\x".concat(digits.byte_slice(b / 16, b / 16 + 1)).concat(digits.byte_slice(b % 16, b % 16 + 1))
}

// The scalar value of the character at pos..end, which codepoint_end bounded. A byte that is
// not UTF-8 decodes to itself.
fn decode_codepoint(source: Str, pos: Int, end: Int) -> Int {
    let w = end - pos
    let b = source.byte_at(pos).to_int()
    if w < 2 { return b }
    let mut cp = if w == 2 { b % 32 } else if w == 3 { b % 16 } else { b % 8 }
    let mut k = 1
    while k < w {
        cp = cp * 64 + source.byte_at(pos + k).to_int() % 64
        k = k + 1
    }
    cp
}

// ` (U+XXXX)` for a multi-byte character at pos..end, so a diagnostic names a character that
// may not render; empty for ASCII and for a byte that is not UTF-8.
fn codepoint_label(source: Str, pos: Int, end: Int) -> Str {
    if end - pos < 2 { return "" }
    let mut cp = decode_codepoint(source, pos, end)
    let digits = "0123456789ABCDEF"
    let mut hex = ""
    while cp > 0 || hex.len() < 4 {
        hex = digits.byte_slice(cp % 16, cp % 16 + 1).concat(hex)
        cp = cp / 16
    }
    " (U+{hex})"
}

fn peek_at(source: Str, source_len: Int, scan_pos: Int, offset: Int) -> Int {
    peek(source, source_len, scan_pos + offset)
}

// ── Escapes ──────────────────────────────────────────────────────────

// One backslash escape in a string or char literal. A malformed escape still has an end, so
// the lexer reports it and goes on after it (sections/02_syntax.md §2.4, "Recovery").
type Escape {
    // Offset just past the escape. For an error, the span of the escape ends here too.
    end: Int
    // The scalar value the escape writes, or -1 when it writes nothing.
    cp: Int
    // All four are "" for a valid escape.
    name: Str
    code: Str
    message: Str
    help: Str
}

fn escape_ok(end: Int, cp: Int) -> Escape {
    Escape { end: end, cp: cp, name: "", code: "", message: "", help: "" }
}

fn escape_error(end: Int, cp: Int, name: Str, code: Str, message: Str, help: Str) -> Escape {
    Escape { end: end, cp: cp, name: name, code: code, message: message, help: help }
}

fn is_hex(c: Int) -> Bool {
    is_digit(c) || (c >= CH_a && c <= CH_f) || (c >= CH_A && c <= CH_F)
}

fn hex_value(c: Int) -> Int {
    if is_digit(c) { return c - CH_0 }
    if c >= CH_a { return c - CH_a + 10 }
    c - CH_A + 10
}

// The one spelling a help writes for the hex digits an author gave: lowercase, no leading zeros.
fn hex_spelling(digits: Str) -> Str {
    let mut sb = StringBuilder.new()
    let mut i = 0
    while i < digits.byte_len() {
        let c = digits.byte_at(i).to_int()
        if sb.len() > 0 || c != CH_0 {
            sb.write(if c >= CH_A && c <= CH_F { str_from_code_point(c + 32) } else { digits.byte_slice(i, i + 1) })
        }
        i = i + 1
    }
    if sb.len() == 0 { "0" } else { sb.to_str() }
}

// The escape at pos, a backslash with at least one character before limit after it. A
// numeric escape reads no further than limit, which is the end of a char literal's text.
fn scan_escape(source: Str, source_len: Int, pos: Int, limit: Int, in_char: Bool) -> Escape {
    let esc = peek(source, source_len, pos + 1)
    if esc == CH_n { return escape_ok(pos + 2, 10) }
    if esc == CH_r { return escape_ok(pos + 2, 13) }
    if esc == CH_t { return escape_ok(pos + 2, 9) }
    if esc == CH_BACKSLASH { return escape_ok(pos + 2, 92) }
    if esc == CH_b { return escape_ok(pos + 2, CH_BACKSPACE) }
    if esc == CH_f { return escape_ok(pos + 2, CH_FORMFEED) }
    if in_char {
        if esc == CH_SQUOTE { return escape_ok(pos + 2, CH_SQUOTE) }
        if esc == CH_0 { return escape_ok(pos + 2, 0) }
    } else {
        if esc == CH_DQUOTE { return escape_ok(pos + 2, CH_DQUOTE) }
        if esc == CH_LBRACE { return escape_ok(pos + 2, CH_LBRACE) }
        if esc == CH_RBRACE { return escape_ok(pos + 2, CH_RBRACE) }
    }
    if esc == CH_u && peek(source, source_len, pos + 2) == CH_LBRACE {
        return scan_unicode_escape(source, source_len, pos, limit, in_char)
    }
    if esc == CH_u || esc == CH_U || esc == CH_x {
        let max = if esc == CH_u { 4 } else if esc == CH_U { 8 } else { 2 }
        let mut end = pos + 2
        while end < limit && end - pos - 2 < max && is_hex(peek(source, source_len, end)) {
            end = end + 1
        }
        let digits = source.byte_slice(pos + 2, end)
        let fix = if digits == "" { "`\\u\{H\}` with 1 to 6 hex digits, such as `\\u\{41\}`" } else { "`\\u\{{hex_spelling(digits)}\}`" }
        if esc == CH_x {
            return escape_error(end, -1, "HexEscapeNotSupported", HEX_ESCAPE_NOT_SUPPORTED, "Blink has no `\\x` escape", "write {fix}")
        }
        return escape_error(end, -1, "UnicodeEscapeNeedsBraces", UNICODE_ESCAPE_NEEDS_BRACES, "Unicode escape needs braces", "write {fix}")
    }
    if esc == CH_0 {
        return escape_error(pos + 2, -1, "NulInStr", NUL_IN_STR, "a `Str` cannot hold NUL", "use `Bytes` for data that contains NUL")
    }
    // Recovery drops the whole malformed escape, the escaped character with its backslash.
    let esc_end = codepoint_end(source, source_len, pos + 1)
    let text = char_text(source, pos + 1, esc_end)
    let kind = if in_char { "char" } else { "string" }
    escape_error(esc_end, -1, "UnknownEscape", UNKNOWN_ESCAPE,
        "unknown escape sequence '\\{text}'{codepoint_label(source, pos + 1, esc_end)} in a {kind} literal",
        unknown_escape_help(esc, in_char, text))
}

// `\u{H}`, with pos at the backslash and `{` two characters after it. The text between the
// braces ends at the first character that cannot be part of it, so a missing `}` costs no
// more than the digits before that point.
fn scan_unicode_escape(source: Str, source_len: Int, pos: Int, limit: Int, in_char: Bool) -> Escape {
    let start = pos + 3
    let mut end = start
    while end < limit {
        let c = peek(source, source_len, end)
        if c == CH_RBRACE || c == CH_LBRACE || c == CH_DQUOTE || c == CH_SQUOTE || c == CH_BACKSLASH || c == CH_NEWLINE || is_whitespace(c) {
            break
        }
        end = codepoint_end(source, source_len, end)
    }
    let closed = end < limit && peek(source, source_len, end) == CH_RBRACE
    let span_end = if closed { end + 1 } else { end }
    let mut q = start
    while q < end && is_hex(peek(source, source_len, q)) {
        q = q + 1
    }
    if q < end {
        let bad = char_text(source, q, codepoint_end(source, source_len, q))
        return escape_error(span_end, -1, "InvalidUnicodeEscapeDigit", INVALID_UNICODE_ESCAPE_DIGIT, "`{bad}` is not a hex digit", "use only `0-9`, `a-f`, `A-F`")
    }
    let digits = source.byte_slice(start, end)
    if !closed {
        let fix = if digits == "" { "41" } else { digits }
        return escape_error(span_end, -1, "UnterminatedUnicodeEscape", UNTERMINATED_UNICODE_ESCAPE, "unterminated Unicode escape", "close the escape with `\}`: `\\u\{{fix}\}`")
    }
    if digits == "" {
        return escape_error(span_end, -1, "EmptyUnicodeEscape", EMPTY_UNICODE_ESCAPE, "empty Unicode escape", "write 1 to 6 hex digits: `\\u\{41\}`")
    }
    if digits.byte_len() > 6 {
        return escape_error(span_end, -1, "UnicodeEscapeTooLong", UNICODE_ESCAPE_TOO_LONG, "more than 6 hex digits", "write at most 6 hex digits")
    }
    let mut value = 0
    let mut i = 0
    while i < digits.byte_len() {
        value = value * 16 + hex_value(digits.byte_at(i).to_int())
        i = i + 1
    }
    if value >= 55296 && value <= 57343 {
        return escape_error(span_end, -1, "SurrogateEscape", SURROGATE_ESCAPE, "surrogate code point is not a Unicode scalar value", "surrogates 0xD800–0xDFFF cannot appear in a `Char` or `Str`")
    }
    if value > 1114111 {
        return escape_error(span_end, -1, "UnicodeEscapeOutOfRange", UNICODE_ESCAPE_OUT_OF_RANGE, "value is above 0x10FFFF", "the largest Unicode scalar value is `\\u\{10ffff\}`")
    }
    if value == 0 && !in_char {
        return escape_error(span_end, -1, "NulInStr", NUL_IN_STR, "a `Str` cannot hold NUL", "use `Bytes` for data that contains NUL")
    }
    escape_ok(span_end, value)
}

// The help for an unknown escape. Where the escape means something in another language, the
// Blink fix comes first, on a line of its own; the valid escapes for the literal kind follow.
fn unknown_escape_help(esc: Int, in_char: Bool, text: Str) -> Str {
    let valid = if in_char {
        "valid escapes in a char literal: \\n \\r \\t \\\\ \\b \\f \\0 \\u\{H\} \\'"
    } else {
        "valid escapes in a string literal: \\n \\r \\t \\\\ \\b \\f \\u\{H\} \\\" \\\{ \\\}"
    }
    let first = if esc == CH_e {
        "write `\\u\{1b\}` for ESC"
    } else if esc == CH_a {
        "write `\\u\{7\}` for BEL"
    } else if esc == CH_v {
        "write `\\u\{b\}` for a vertical tab"
    } else if !in_char && esc == CH_SQUOTE {
        "write a plain `'`: a string literal needs no escape for it"
    } else if in_char && esc == CH_DQUOTE {
        "write a plain `\"`: `'\"'`"
    } else if !in_char && is_regex_escape(esc) {
        "for a regex, use a raw string, where `\\` is literal: `#\"\\{text}\"#`"
    } else {
        ""
    }
    if first == "" { valid } else { "{first}\n{valid}" }
}

// A letter or symbol that a backslash escapes in a regex and not in a Blink string.
fn is_regex_escape(c: Int) -> Bool {
    if c == CH_d || c == CH_D || c == CH_w || c == CH_W || c == CH_s || c == CH_S { return true }
    if c == CH_DOT || c == CH_LPAREN || c == CH_RPAREN || c == CH_LBRACKET || c == CH_RBRACKET { return true }
    c == CH_PLUS || c == CH_STAR || c == CH_QUESTION || c == CH_PIPE || c == CH_CARET || c == CH_DOLLAR
}

// The text of a char literal written as a Str literal, for the MultiCharLiteral help: a quote
// the Str would end at, or a brace it would read as interpolation, gets its backslash, and
// `\'`, which a Str does not accept, loses its own.
fn char_text_as_str(text: Str) -> Str {
    let mut sb = StringBuilder.new()
    sb.write("\"")
    let mut i = 0
    while i < text.byte_len() {
        let c = text.byte_at(i).to_int()
        if c == CH_BACKSLASH && i + 1 < text.byte_len() {
            let n = text.byte_at(i + 1).to_int()
            if n == CH_SQUOTE { sb.write("'") } else { sb.write(text.byte_slice(i, i + 2)) }
            i = i + 2
            continue
        }
        if c == CH_DQUOTE {
            sb.write("\\\"")
        } else if c == CH_LBRACE {
            sb.write("\\\{")
        } else if c == CH_RBRACE {
            sb.write("\\}")
        } else {
            sb.write(text.byte_slice(i, i + 1))
        }
        i = i + 1
    }
    sb.write("\"")
    sb.to_str()
}

// ── Lexer output: module-level columns ────────────────────────────────
// Shared with parser and comment_attach via imports. A token is a row: one word in each
// column. A List[Token] boxes each record, so every token cost a collector allocation of
// its own; the kind and position columns hold no pointers, and lex() clears the columns in
// place, so a file reuses the storage the one before it grew.
pub type TokenColumns {
    kinds: List[TokenKind]
    values: List[Str]
    lines: List[Int]
    cols: List[Int]
    // Exclusive: the column of the first character after the token.
    end_cols: List[Int]
    // The text the columns index. A diagnostic that quotes code as written, such as a help that
    // adds parentheses, reads it here by line and byte column.
    source: Str
}

pub let mut tokens: TokenColumns = TokenColumns { kinds: [], values: [], lines: [], cols: [], end_cols: [], source: "" }

fn push_tok(kind: TokenKind, value: Str, line: Int, col: Int, end_col: Int) {
    tokens.kinds.push(kind)
    tokens.values.push(value)
    tokens.lines.push(line)
    tokens.cols.push(col)
    tokens.end_cols.push(end_col)
}

pub fn token_count() -> Int {
    tokens.kinds.len()
}

// One token as a record, for a reader that looks at a few tokens (the language server).
// It allocates, so a pass over every token reads the columns instead.
pub fn token_at(i: Int) -> Token {
    Token { kind: tokens.kinds.get(i).unwrap(), value: tokens.values.get(i).unwrap(), line: tokens.lines.get(i).unwrap(), col: tokens.cols.get(i).unwrap(), end_col: tokens.end_cols.get(i).unwrap() }
}

// ── Main lexer ───────────────────────────────────────────────────────

pub fn lex(source: Str) ! Lex.Tokenize, Diag.Report {
    let source_len = source.byte_len()
    if trace_mode != "" { trace("lex", "start ({source_len} bytes)") }
    // Reset output
    tokens.kinds.clear()
    tokens.values.clear()
    tokens.lines.clear()
    tokens.cols.clear()
    tokens.end_cols.clear()
    tokens.source = source

    // Scanner state
    let mut scan_pos = 0
    let mut line = 1
    let mut col = 1

    // Mode stack (parallel lists). Starts with one normal-mode entry.
    let mut mode_stack: List[Int] = []
    let mut brace_depth_stack: List[Int] = []
    let mut string_depth_stack: List[Int] = []
    // Where each open string's delimiter starts, prefix included, and how wide it is, for the
    // UnterminatedLiteral span when the file ends inside the string.
    let mut string_open_lines: List[Int] = []
    let mut string_open_cols: List[Int] = []
    let mut string_open_widths: List[Int] = []
    mode_stack.push(MODE_NORMAL)
    brace_depth_stack.push(0)

    // String buffer for MODE_STRING
    let mut string_buf = StringBuilder.new()
    let mut _run_start = -1

    // Last emitted token kind (-1 means none)
    let mut _last_kind: TokenKind = TokenKind.EOF

    // ── emit: push a token to all 4 output lists ──────────────────
    // Inlined as a block since we can't capture mut locals in closures.
    // We use a helper pattern: just push inline everywhere.
    // (Ugly, but the C backend doesn't support closures that capture.)

    // ── Main loop ─────────────────────────────────────────────────
    while scan_pos < source_len {
        let mode = mode_stack.get(mode_stack.len() - 1).unwrap()

        if mode == MODE_NORMAL {
            // ── NORMAL MODE ───────────────────────────────────────
            let brace_depth = brace_depth_stack.get(brace_depth_stack.len() - 1).unwrap()
            let ch = peek(source, source_len, scan_pos)

            // Skip whitespace (not newline)
            if is_whitespace(ch) {
                scan_pos = scan_pos + 1
                col = col + 1
                continue
            }

            // Comments: // or ///
            if ch == CH_SLASH && peek_at(source, source_len, scan_pos, 1) == CH_SLASH {
                let t_line = line
                let t_col = col
                let is_doc = peek_at(source, source_len, scan_pos, 2) == CH_SLASH
                if is_doc {
                    scan_pos = scan_pos + 3
                    col = col + 3
                } else {
                    scan_pos = scan_pos + 2
                    col = col + 2
                }
                let text_start = scan_pos
                while scan_pos < source_len && peek(source, source_len, scan_pos) != CH_NEWLINE {
                    scan_pos = scan_pos + 1
                    col = col + 1
                }
                let text = source.byte_slice(text_start, scan_pos)
                if is_doc {
                    push_tok(TokenKind.DocComment, text, t_line, t_col, col)
                    _last_kind = TokenKind.DocComment
                } else {
                    push_tok(TokenKind.Comment, text, t_line, t_col, col)
                    _last_kind = TokenKind.Comment
                }
                if scan_pos < source_len && peek(source, source_len, scan_pos) == CH_NEWLINE {
                    scan_pos = scan_pos + 1
                    line = line + 1
                    col = 1
                }
                continue
            }

            // Slash or /=
            if ch == CH_SLASH {
                let t_line = line
                let t_col = col
                scan_pos = scan_pos + 1
                col = col + 1
                if scan_pos < source_len && peek(source, source_len, scan_pos) == CH_EQUALS {
                    scan_pos = scan_pos + 1
                    col = col + 1
                    push_tok(TokenKind.SlashEq, "/=", t_line, t_col, col)
                    _last_kind = TokenKind.SlashEq
                } else {
                    push_tok(TokenKind.Slash, "/", t_line, t_col, col)
                    _last_kind = TokenKind.Slash
                }
                continue
            }

            // Newline
            if ch == CH_NEWLINE {
                let t_line = line
                let t_col = col
                scan_pos = scan_pos + 1
                line = line + 1
                col = 1
                if _last_kind != TokenKind.Newline {
                    push_tok(TokenKind.Newline, "\\n", t_line, t_col, col)
                    _last_kind = TokenKind.Newline
                }
                continue
            }

            // String start: "
            if ch == CH_DQUOTE {
                let t_line = line
                let t_col = col
                scan_pos = scan_pos + 1
                col = col + 1
                // `t"` lexes as the identifier `t` right before the quote; the span of an
                // unclosed template starts at the `t`.
                let n_tok = tokens.kinds.len()
                let templ = n_tok > 0 && tokens.kinds.get(n_tok - 1).unwrap() == TokenKind.Ident && tokens.values.get(n_tok - 1).unwrap() == "t" && tokens.lines.get(n_tok - 1).unwrap() == t_line && tokens.end_cols.get(n_tok - 1).unwrap() == t_col
                push_tok(TokenKind.StringStart, "\"", t_line, t_col, col)
                _last_kind = TokenKind.StringStart
                mode_stack.push(MODE_STRING)
                brace_depth_stack.push(0)
                string_depth_stack.push(0)
                string_open_lines.push(t_line)
                string_open_cols.push(if templ { t_col - 1 } else { t_col })
                string_open_widths.push(if templ { 2 } else { 1 })
                string_buf.clear()
                continue
            }

            // Char literal: 'x'. It cannot span lines: its text runs to the next `'` on the
            // line, or to the end of the line, and the lexer counts the scalars in that text
            // before it reads any of them (sections/02_syntax.md §2.4). Every outcome is one
            // CharLit token, U+FFFD after an error, so the parser sees an expression either way.
            if ch == CH_SQUOTE {
                let t_line = line
                let t_col = col
                let open = scan_pos
                let mut text_end = scan_pos + 1
                let mut closed = false
                while text_end < source_len {
                    let c = peek(source, source_len, text_end)
                    if c == CH_NEWLINE { break }
                    if c == CH_SQUOTE {
                        closed = true
                        break
                    }
                    if c == CH_BACKSLASH && text_end + 1 < source_len && peek(source, source_len, text_end + 1) != CH_NEWLINE {
                        text_end = text_end + 2
                    } else {
                        text_end = text_end + 1
                    }
                }
                let lit_end = if closed { text_end + 1 } else { text_end }
                let end_col = t_col + lit_end - open
                let mut count = 0
                let mut first = escape_ok(open + 1, -1)
                let mut first_pos = open + 1
                let mut q = open + 1
                while q < text_end {
                    let e = if peek(source, source_len, q) == CH_BACKSLASH && q + 1 < text_end {
                        scan_escape(source, source_len, q, text_end, true)
                    } else {
                        let qe = codepoint_end(source, source_len, q)
                        let raw = if qe - q > 1 || peek(source, source_len, q) < 128 { decode_codepoint(source, q, qe) } else { -1 }
                        escape_ok(qe, raw)
                    }
                    if count == 0 {
                        first = e
                        first_pos = q
                    }
                    count = count + 1
                    q = e.end
                }
                let mut value = 65533
                if closed && count == 0 {
                    diag_error_span_notes("EmptyCharLiteral", EMPTY_CHAR_LITERAL, "empty char literal", t_line, t_col, end_col,
                        "write one character between the quotes, such as `' '` or `'\\''`; an empty `Str` is `\"\"`", [])
                } else if count >= 2 {
                    let message = if closed { "char literal holds {count} characters" } else { "char literal has no closing `'` on its line, so it holds {count} characters" }
                    diag_error_span_notes("MultiCharLiteral", MULTI_CHAR_LITERAL, message, t_line, t_col, end_col,
                        "a char literal holds one character; use double quotes for a `Str`: `{char_text_as_str(source.byte_slice(open + 1, text_end))}`", [])
                } else if !closed {
                    diag_error_span_notes("UnterminatedLiteral", UNTERMINATED_LITERAL, "unterminated char literal", t_line, t_col, end_col,
                        "close the literal with `'`", ["the literal reaches the end of the line at line {t_line}, col {end_col}"])
                } else if first.code != "" {
                    let e_col = t_col + first_pos - open
                    diag_error_span_notes(first.name, first.code, first.message, t_line, e_col, e_col + first.end - first_pos, first.help, [])
                } else if first.cp < 0 {
                    let e_col = t_col + first_pos - open
                    diag_error_range("UnexpectedCharacter", UNEXPECTED_CHARACTER, "unexpected character `{char_text(source, first_pos, first.end)}` in char literal: source text must be UTF-8", t_line, e_col, e_col + 1, "")
                } else {
                    value = first.cp
                }
                // A literal open at the end of the file leaves the code around it unfinished, and
                // what the parser says about that is the same mistake again.
                if !closed && text_end >= source_len {
                    diag_cut_after(t_line, t_col)
                }
                scan_pos = lit_end
                col = end_col
                push_tok(TokenKind.CharLit, "{value}", t_line, t_col, col)
                _last_kind = TokenKind.CharLit
                continue
            }

            // Left brace
            if ch == CH_LBRACE {
                let t_line = line
                let t_col = col
                scan_pos = scan_pos + 1
                col = col + 1
                if brace_depth > 0 {
                    // Inside interpolation: track nested braces
                    brace_depth_stack.push(brace_depth + 1)
                    mode_stack.push(MODE_NORMAL)
                    // Replace top of stack by popping and re-pushing
                    // Actually we need to update the current entry.
                    // Since List has no set(), we pop and push.
                    // We just pushed, so undo and fix the original entry.
                    // Simpler: the brace_depth_stack top IS the one we
                    // just pushed. Pop it, pop the old, push updated old,
                    // then we don't push a new mode frame — we update in place.
                    //
                    // Let me reconsider the stack design:
                    // In Python, mode_stack[-1] = ("normal", brace_depth+1)
                    // means we UPDATE the current frame, not push a new one.
                    // So we should pop the extra push we just did, and update
                    // the existing top.
                    mode_stack.pop()
                    brace_depth_stack.pop()
                    // Now update the real top
                    brace_depth_stack.pop()
                    brace_depth_stack.push(brace_depth + 1)
                    push_tok(TokenKind.LBrace, "\{", t_line, t_col, col)
                    _last_kind = TokenKind.LBrace
                } else {
                    push_tok(TokenKind.LBrace, "\{", t_line, t_col, col)
                    _last_kind = TokenKind.LBrace
                }
                continue
            }

            // Right brace
            if ch == CH_RBRACE {
                let t_line = line
                let t_col = col
                scan_pos = scan_pos + 1
                col = col + 1
                if brace_depth > 1 {
                    // Nested brace inside interpolation
                    brace_depth_stack.pop()
                    brace_depth_stack.push(brace_depth - 1)
                    push_tok(TokenKind.RBrace, "\}", t_line, t_col, col)
                    _last_kind = TokenKind.RBrace
                } else if brace_depth == 1 {
                    // End of interpolation — pop back to string mode
                    mode_stack.pop()
                    brace_depth_stack.pop()
                    push_tok(TokenKind.InterpEnd, "\}", t_line, t_col, col)
                    _last_kind = TokenKind.InterpEnd
                    // Continue in string mode (loop will pick it up)
                } else {
                    push_tok(TokenKind.RBrace, "\}", t_line, t_col, col)
                    _last_kind = TokenKind.RBrace
                }
                continue
            }

            // Question mark: ? or ??
            if ch == CH_QUESTION {
                let t_line = line
                let t_col = col
                scan_pos = scan_pos + 1
                col = col + 1
                if scan_pos < source_len && peek(source, source_len, scan_pos) == CH_QUESTION {
                    scan_pos = scan_pos + 1
                    col = col + 1
                    push_tok(TokenKind.DoubleQuestion, "??", t_line, t_col, col)
                    _last_kind = TokenKind.DoubleQuestion
                } else {
                    push_tok(TokenKind.Question, "?", t_line, t_col, col)
                    _last_kind = TokenKind.Question
                }
                continue
            }

            // Minus: -, ->, -=, --
            if ch == CH_MINUS {
                let t_line = line
                let t_col = col
                if peek_at(source, source_len, scan_pos, 1) == CH_GREATER {
                    scan_pos = scan_pos + 2
                    col = col + 2
                    push_tok(TokenKind.Arrow, "->", t_line, t_col, col)
                    _last_kind = TokenKind.Arrow
                } else if peek_at(source, source_len, scan_pos, 1) == CH_EQUALS {
                    scan_pos = scan_pos + 2
                    col = col + 2
                    push_tok(TokenKind.MinusEq, "-=", t_line, t_col, col)
                    _last_kind = TokenKind.MinusEq
                } else if peek_at(source, source_len, scan_pos, 1) == CH_MINUS {
                    scan_pos = scan_pos + 2
                    col = col + 2
                    push_tok(TokenKind.DashDash, "--", t_line, t_col, col)
                    _last_kind = TokenKind.DashDash
                } else {
                    scan_pos = scan_pos + 1
                    col = col + 1
                    push_tok(TokenKind.Minus, "-", t_line, t_col, col)
                    _last_kind = TokenKind.Minus
                }
                continue
            }

            // Plus: +, +=
            if ch == CH_PLUS {
                let t_line = line
                let t_col = col
                scan_pos = scan_pos + 1
                col = col + 1
                if scan_pos < source_len && peek(source, source_len, scan_pos) == CH_EQUALS {
                    scan_pos = scan_pos + 1
                    col = col + 1
                    push_tok(TokenKind.PlusEq, "+=", t_line, t_col, col)
                    _last_kind = TokenKind.PlusEq
                } else {
                    push_tok(TokenKind.Plus, "+", t_line, t_col, col)
                    _last_kind = TokenKind.Plus
                }
                continue
            }

            // Star: *, *=
            if ch == CH_STAR {
                let t_line = line
                let t_col = col
                scan_pos = scan_pos + 1
                col = col + 1
                if scan_pos < source_len && peek(source, source_len, scan_pos) == CH_EQUALS {
                    scan_pos = scan_pos + 1
                    col = col + 1
                    push_tok(TokenKind.StarEq, "*=", t_line, t_col, col)
                    _last_kind = TokenKind.StarEq
                } else {
                    push_tok(TokenKind.Star, "*", t_line, t_col, col)
                    _last_kind = TokenKind.Star
                }
                continue
            }

            // Equals: =, ==, =>
            if ch == CH_EQUALS {
                let t_line = line
                let t_col = col
                scan_pos = scan_pos + 1
                col = col + 1
                if scan_pos < source_len && peek(source, source_len, scan_pos) == CH_GREATER {
                    scan_pos = scan_pos + 1
                    col = col + 1
                    push_tok(TokenKind.FatArrow, "=>", t_line, t_col, col)
                    _last_kind = TokenKind.FatArrow
                } else if scan_pos < source_len && peek(source, source_len, scan_pos) == CH_EQUALS {
                    scan_pos = scan_pos + 1
                    col = col + 1
                    push_tok(TokenKind.EqEq, "==", t_line, t_col, col)
                    _last_kind = TokenKind.EqEq
                } else {
                    push_tok(TokenKind.Equals, "=", t_line, t_col, col)
                    _last_kind = TokenKind.Equals
                }
                continue
            }

            // Dot: ., .., ..=
            if ch == CH_DOT && peek_at(source, source_len, scan_pos, 1) == CH_DOT {
                let t_line = line
                let t_col = col
                scan_pos = scan_pos + 2
                col = col + 2
                if scan_pos < source_len && peek(source, source_len, scan_pos) == CH_EQUALS {
                    scan_pos = scan_pos + 1
                    col = col + 1
                    push_tok(TokenKind.DotDoteq, "..=", t_line, t_col, col)
                    _last_kind = TokenKind.DotDoteq
                } else {
                    push_tok(TokenKind.DotDot, "..", t_line, t_col, col)
                    _last_kind = TokenKind.DotDot
                }
                continue
            }

            if ch == CH_DOT {
                let t_line = line
                let t_col = col
                scan_pos = scan_pos + 1
                col = col + 1
                push_tok(TokenKind.Dot, ".", t_line, t_col, col)
                _last_kind = TokenKind.Dot
                continue
            }

            // Bang: !, !=
            if ch == CH_BANG {
                let t_line = line
                let t_col = col
                scan_pos = scan_pos + 1
                col = col + 1
                if scan_pos < source_len && peek(source, source_len, scan_pos) == CH_EQUALS {
                    scan_pos = scan_pos + 1
                    col = col + 1
                    push_tok(TokenKind.NotEq, "!=", t_line, t_col, col)
                    _last_kind = TokenKind.NotEq
                } else {
                    push_tok(TokenKind.Bang, "!", t_line, t_col, col)
                    _last_kind = TokenKind.Bang
                }
                continue
            }

            // Less: <, <=, <<
            if ch == CH_LESS {
                let t_line = line
                let t_col = col
                scan_pos = scan_pos + 1
                col = col + 1
                if scan_pos < source_len && peek(source, source_len, scan_pos) == CH_EQUALS {
                    scan_pos = scan_pos + 1
                    col = col + 1
                    push_tok(TokenKind.LessEq, "<=", t_line, t_col, col)
                    _last_kind = TokenKind.LessEq
                } else if scan_pos < source_len && peek(source, source_len, scan_pos) == CH_LESS {
                    scan_pos = scan_pos + 1
                    col = col + 1
                    push_tok(TokenKind.Shl, "<<", t_line, t_col, col)
                    _last_kind = TokenKind.Shl
                } else {
                    push_tok(TokenKind.Less, "<", t_line, t_col, col)
                    _last_kind = TokenKind.Less
                }
                continue
            }

            // Greater: >, >=, >>
            if ch == CH_GREATER {
                let t_line = line
                let t_col = col
                scan_pos = scan_pos + 1
                col = col + 1
                if scan_pos < source_len && peek(source, source_len, scan_pos) == CH_EQUALS {
                    scan_pos = scan_pos + 1
                    col = col + 1
                    push_tok(TokenKind.GreaterEq, ">=", t_line, t_col, col)
                    _last_kind = TokenKind.GreaterEq
                } else if scan_pos < source_len && peek(source, source_len, scan_pos) == CH_GREATER {
                    scan_pos = scan_pos + 1
                    col = col + 1
                    push_tok(TokenKind.Shr, ">>", t_line, t_col, col)
                    _last_kind = TokenKind.Shr
                } else {
                    push_tok(TokenKind.Greater, ">", t_line, t_col, col)
                    _last_kind = TokenKind.Greater
                }
                continue
            }

            // Ampersand: &, &&
            if ch == CH_AMP {
                let t_line = line
                let t_col = col
                if peek_at(source, source_len, scan_pos, 1) == CH_AMP {
                    scan_pos = scan_pos + 2
                    col = col + 2
                    push_tok(TokenKind.And, "&&", t_line, t_col, col)
                    _last_kind = TokenKind.And
                } else {
                    scan_pos = scan_pos + 1
                    col = col + 1
                    push_tok(TokenKind.Amp, "&", t_line, t_col, col)
                    _last_kind = TokenKind.Amp
                }
                continue
            }

            // Caret: ^
            if ch == CH_CARET {
                let t_line = line
                let t_col = col
                scan_pos = scan_pos + 1
                col = col + 1
                push_tok(TokenKind.Caret, "^", t_line, t_col, col)
                _last_kind = TokenKind.Caret
                continue
            }

            // Tilde: ~
            if ch == CH_TILDE {
                let t_line = line
                let t_col = col
                scan_pos = scan_pos + 1
                col = col + 1
                push_tok(TokenKind.Tilde, "~", t_line, t_col, col)
                _last_kind = TokenKind.Tilde
                continue
            }

            // Pipe: |, ||, |>
            if ch == CH_PIPE {
                let t_line = line
                let t_col = col
                scan_pos = scan_pos + 1
                col = col + 1
                if scan_pos < source_len && peek(source, source_len, scan_pos) == CH_PIPE {
                    scan_pos = scan_pos + 1
                    col = col + 1
                    push_tok(TokenKind.Or, "||", t_line, t_col, col)
                    _last_kind = TokenKind.Or
                } else if scan_pos < source_len && peek(source, source_len, scan_pos) == CH_GREATER {
                    scan_pos = scan_pos + 1
                    col = col + 1
                    push_tok(TokenKind.PipeArrow, "|>", t_line, t_col, col)
                    _last_kind = TokenKind.PipeArrow
                } else {
                    push_tok(TokenKind.Pipe, "|", t_line, t_col, col)
                    _last_kind = TokenKind.Pipe
                }
                continue
            }

            // Single-char tokens: ( ) : , % [ ] @
            if ch == CH_LPAREN {
                let t_line = line
                let t_col = col
                scan_pos = scan_pos + 1
                col = col + 1
                push_tok(TokenKind.LParen, "(", t_line, t_col, col)
                _last_kind = TokenKind.LParen
                continue
            }
            if ch == CH_RPAREN {
                let t_line = line
                let t_col = col
                scan_pos = scan_pos + 1
                col = col + 1
                push_tok(TokenKind.RParen, ")", t_line, t_col, col)
                _last_kind = TokenKind.RParen
                continue
            }
            if ch == CH_COLON {
                let t_line = line
                let t_col = col
                scan_pos = scan_pos + 1
                col = col + 1
                push_tok(TokenKind.Colon, ":", t_line, t_col, col)
                _last_kind = TokenKind.Colon
                continue
            }
            if ch == CH_COMMA {
                let t_line = line
                let t_col = col
                scan_pos = scan_pos + 1
                col = col + 1
                push_tok(TokenKind.Comma, ",", t_line, t_col, col)
                _last_kind = TokenKind.Comma
                continue
            }
            if ch == CH_PERCENT {
                let t_line = line
                let t_col = col
                scan_pos = scan_pos + 1
                col = col + 1
                push_tok(TokenKind.Percent, "%", t_line, t_col, col)
                _last_kind = TokenKind.Percent
                continue
            }
            if ch == CH_LBRACKET {
                let t_line = line
                let t_col = col
                scan_pos = scan_pos + 1
                col = col + 1
                push_tok(TokenKind.LBracket, "[", t_line, t_col, col)
                _last_kind = TokenKind.LBracket
                continue
            }
            if ch == CH_RBRACKET {
                let t_line = line
                let t_col = col
                scan_pos = scan_pos + 1
                col = col + 1
                push_tok(TokenKind.RBracket, "]", t_line, t_col, col)
                _last_kind = TokenKind.RBracket
                continue
            }
            if ch == CH_AT {
                let t_line = line
                let t_col = col
                scan_pos = scan_pos + 1
                col = col + 1
                push_tok(TokenKind.At, "@", t_line, t_col, col)
                _last_kind = TokenKind.At
                continue
            }
            if ch == CH_HASH {
                let t_line = line
                let t_col = col
                // Count consecutive # chars
                let mut hash_count = 0
                while scan_pos + hash_count < source_len && peek(source, source_len, scan_pos + hash_count) == CH_HASH {
                    hash_count = hash_count + 1
                }
                // Check if followed by " — extended string start
                if hash_count <= 3 && scan_pos + hash_count < source_len && peek(source, source_len, scan_pos + hash_count) == CH_DQUOTE {
                    // Extended string: consume all # chars + the "
                    scan_pos = scan_pos + hash_count + 1
                    col = col + hash_count + 1
                    push_tok(TokenKind.StringStart, "\"", t_line, t_col, col)
                    _last_kind = TokenKind.StringStart
                    mode_stack.push(MODE_STRING)
                    brace_depth_stack.push(0)
                    string_depth_stack.push(hash_count)
                    string_open_lines.push(t_line)
                    string_open_cols.push(t_col)
                    string_open_widths.push(hash_count + 1)
                    string_buf.clear()
                    continue
                }
                // Not an extended string — emit Hash token (just one #)
                scan_pos = scan_pos + 1
                col = col + 1
                push_tok(TokenKind.Hash, "#", t_line, t_col, col)
                _last_kind = TokenKind.Hash
                continue
            }

            // Identifiers and keywords
            if is_alpha(ch) {
                let t_line = line
                let t_col = col
                let start = scan_pos
                while scan_pos < source_len && is_alnum(peek(source, source_len, scan_pos)) {
                    scan_pos = scan_pos + 1
                    col = col + 1
                }
                let word = source.byte_slice(start, scan_pos)
                let kind = keyword_lookup(word)
                push_tok(kind, word, t_line, t_col, col)
                _last_kind = kind
                continue
            }

            // Integer and float literals
            if is_digit(ch) {
                let t_line = line
                let t_col = col
                let start = scan_pos
                while scan_pos < source_len && is_digit(peek(source, source_len, scan_pos)) {
                    scan_pos = scan_pos + 1
                    col = col + 1
                }
                if scan_pos < source_len && peek(source, source_len, scan_pos) == CH_DOT && is_digit(peek_at(source, source_len, scan_pos, 1)) {
                    scan_pos = scan_pos + 1
                    col = col + 1
                    while scan_pos < source_len && is_digit(peek(source, source_len, scan_pos)) {
                        scan_pos = scan_pos + 1
                        col = col + 1
                    }
                    push_tok(TokenKind.Float, source.byte_slice(start, scan_pos), t_line, t_col, col)
                    _last_kind = TokenKind.Float
                } else {
                    push_tok(TokenKind.Int, source.byte_slice(start, scan_pos), t_line, t_col, col)
                    _last_kind = TokenKind.Int
                }
                continue
            }

            // Inside an interpolation `{ ... }`, accept `\"` as a redundant
            // escape for a literal `"` — drop the backslash so the next
            // iteration's `"` handler starts a nested string. The matching
            // closing `\"` is handled symmetrically in the MODE_STRING
            // backslash branch below.
            if ch == CH_BACKSLASH && brace_depth > 0 && peek_at(source, source_len, scan_pos, 1) == CH_DQUOTE {
                scan_pos = scan_pos + 1
                col = col + 1
                continue
            }

            // Recover by skipping the character so we can surface every bad
            // character in one pass rather than aborting on the first.
            let bad_end = codepoint_end(source, source_len, scan_pos)
            let bad_ch = char_text(source, scan_pos, bad_end)
            let bad_w = bad_end - scan_pos
            let hint = if bad_ch == ";" { "Blink uses newlines as statement terminators; delete the `;`" } else { "" }
            diag_error_range("UnexpectedCharacter", UNEXPECTED_CHARACTER, "unexpected character `{bad_ch}`{codepoint_label(source, scan_pos, bad_end)}", line, col, col + bad_w, hint)
            scan_pos = bad_end
            col = col + bad_w

        } else {
            // ── STRING MODE ───────────────────────────────────────
            let ch = peek(source, source_len, scan_pos)

            // Interpolation start: { (or #{...} for extended strings)
            if ch == CH_LBRACE {
                if _run_start != -1 {
                    string_buf.write(source.byte_slice(_run_start, scan_pos))
                    _run_start = -1
                }
                let t_line = line
                let t_col = col
                let sdepth = string_depth_stack.get(string_depth_stack.len() - 1).unwrap()
                if sdepth == 0 {
                    // Normal string: { starts interpolation
                    scan_pos = scan_pos + 1
                    col = col + 1
                    push_tok(TokenKind.StringPart, string_buf.to_str(), t_line, t_col, col)
                    _last_kind = TokenKind.StringPart
                    string_buf.clear()
                    push_tok(TokenKind.InterpStart, "\{", t_line, t_col, col)
                    _last_kind = TokenKind.InterpStart
                    mode_stack.push(MODE_NORMAL)
                    brace_depth_stack.push(1)
                    continue
                } else {
                    // Extended string: check if last sdepth chars in string_buf are all #
                    let buf_str = string_buf.to_str()
                    let buf_len = buf_str.byte_len()
                    if buf_len >= sdepth {
                        let mut all_hash = 1
                        let mut ci = 0
                        while ci < sdepth {
                            if buf_str.byte_at(buf_len - sdepth + ci).to_int() != CH_HASH {
                                all_hash = 0
                                break
                            }
                            ci = ci + 1
                        }
                        if all_hash == 1 {
                            // Remove trailing # chars from string_buf
                            let trimmed = buf_str.byte_slice(0, buf_len - sdepth)
                            scan_pos = scan_pos + 1
                            col = col + 1
                            push_tok(TokenKind.StringPart, trimmed, t_line, t_col, col)
                            _last_kind = TokenKind.StringPart
                            string_buf.clear()
                            push_tok(TokenKind.InterpStart, "\{", t_line, t_col, col)
                            _last_kind = TokenKind.InterpStart
                            mode_stack.push(MODE_NORMAL)
                            brace_depth_stack.push(1)
                            continue
                        }
                    }
                    // Not enough # before { — literal brace
                    string_buf.write("\{")
                    scan_pos = scan_pos + 1
                    col = col + 1
                    continue
                }
            }

            // String end: " (or "# / "## / "### for extended strings)
            if ch == CH_DQUOTE {
                if _run_start != -1 {
                    string_buf.write(source.byte_slice(_run_start, scan_pos))
                    _run_start = -1
                }
                let t_line = line
                let t_col = col
                let sdepth = string_depth_stack.get(string_depth_stack.len() - 1).unwrap()
                if sdepth == 0 {
                    // Normal string end
                    scan_pos = scan_pos + 1
                    col = col + 1
                    push_tok(TokenKind.StringPart, string_buf.to_str(), t_line, t_col, col)
                    _last_kind = TokenKind.StringPart
                    string_buf.clear()
                    push_tok(TokenKind.StringEnd, "\"", t_line, t_col, col)
                    _last_kind = TokenKind.StringEnd
                    mode_stack.pop()
                    brace_depth_stack.pop()
                    string_depth_stack.pop()
                    string_open_lines.pop()
                    string_open_cols.pop()
                    string_open_widths.pop()
                    continue
                } else {
                    // Extended string: check for exactly sdepth # chars after "
                    let mut match_count = 0
                    while match_count < sdepth && scan_pos + 1 + match_count < source_len && peek(source, source_len, scan_pos + 1 + match_count) == CH_HASH {
                        match_count = match_count + 1
                    }
                    let after_hashes = scan_pos + 1 + match_count
                    let next_is_brace = after_hashes < source_len && peek(source, source_len, after_hashes) == CH_LBRACE
                    if match_count == sdepth && next_is_brace == false {
                        // End of extended string: consume " + all # chars
                        scan_pos = scan_pos + 1 + sdepth
                        col = col + 1 + sdepth
                        push_tok(TokenKind.StringPart, string_buf.to_str(), t_line, t_col, col)
                        _last_kind = TokenKind.StringPart
                        string_buf.clear()
                        push_tok(TokenKind.StringEnd, "\"", t_line, t_col, col)
                        _last_kind = TokenKind.StringEnd
                        mode_stack.pop()
                        brace_depth_stack.pop()
                        string_depth_stack.pop()
                        string_open_lines.pop()
                        string_open_cols.pop()
                        string_open_widths.pop()
                        continue
                    } else {
                        // Not enough # — literal "
                        string_buf.write("\"")
                        scan_pos = scan_pos + 1
                        col = col + 1
                        continue
                    }
                }
            }

            // Escape sequences
            if ch == CH_BACKSLASH {
                if _run_start != -1 {
                    string_buf.write(source.byte_slice(_run_start, scan_pos))
                    _run_start = -1
                }
                let sdepth = string_depth_stack.get(string_depth_stack.len() - 1).unwrap()
                if sdepth > 0 {
                    // Extended string: backslash is literal
                    string_buf.write("\\")
                    scan_pos = scan_pos + 1
                    col = col + 1
                    continue
                }
                // Nested string opened from inside an interpolation: the
                // opening `\"` was lexed as a bare `"` (see MODE_NORMAL
                // branch above), so the matching closing `\"` must also be
                // treated as a bare `"`. Skip the backslash and let the
                // `"` handler emit StringEnd. mode_stack.len() > 2 means
                // this string sits inside at least one `{ ... }` frame.
                if mode_stack.len() > 2 && peek_at(source, source_len, scan_pos, 1) == CH_DQUOTE {
                    scan_pos = scan_pos + 1
                    col = col + 1
                    continue
                }
                // A backslash that ends the file is part of the unclosed literal, which the end of
                // the file reports.
                if scan_pos + 1 >= source_len {
                    scan_pos = scan_pos + 1
                    col = col + 1
                    continue
                }
                let e = scan_escape(source, source_len, scan_pos, source_len, false)
                if e.code != "" {
                    diag_error_span_notes(e.name, e.code, e.message, line, col, col + e.end - scan_pos, e.help, [])
                }
                if e.cp >= 0 {
                    string_buf.write(str_from_code_point(e.cp))
                }
                if peek(source, source_len, scan_pos + 1) == CH_NEWLINE {
                    line = line + 1
                    col = 1
                } else {
                    col = col + e.end - scan_pos
                }
                scan_pos = e.end
                continue
            }

            // A Str must hold UTF-8, so a byte that is not part of a well-formed sequence
            // cannot go into the literal; it is an error, spelled `\xNN`. A well-formed
            // sequence joins the run whole, so a later flush never ends inside it.
            if ch >= 128 {
                let cp_end = codepoint_end(source, source_len, scan_pos)
                if cp_end == scan_pos + 1 {
                    if _run_start != -1 {
                        string_buf.write(source.byte_slice(_run_start, scan_pos))
                        _run_start = -1
                    }
                    let bad_ch = char_text(source, scan_pos, cp_end)
                    diag_error_range("UnexpectedCharacter", UNEXPECTED_CHARACTER, "unexpected character `{bad_ch}` in string literal: source text must be UTF-8", line, col, col + 1, "")
                } else if _run_start == -1 {
                    _run_start = scan_pos
                }
                col = col + cp_end - scan_pos
                scan_pos = cp_end
                continue
            }

            // Regular character — track run start for batch append
            if _run_start == -1 {
                _run_start = scan_pos
            }
            scan_pos = scan_pos + 1
            if ch == CH_NEWLINE {
                line = line + 1
                col = 1
            } else {
                col = col + 1
            }
        }
    }

    // A string still open here ran to the end of the file. The outermost one is the mistake:
    // any string or hole inside it opened in text the author meant as code. Closing every
    // frame hands the parser a whole literal, so it has nothing to report at the end of the file.
    if string_depth_stack.len() > 0 {
        if _run_start != -1 {
            string_buf.write(source.byte_slice(_run_start, scan_pos))
            _run_start = -1
        }
        let o_line = string_open_lines.get(0).unwrap()
        let o_col = string_open_cols.get(0).unwrap()
        let o_width = string_open_widths.get(0).unwrap()
        let hashes = string_depth_stack.get(0).unwrap()
        let kind = if hashes > 0 { "raw string" } else if o_width == 2 { "template" } else { "string" }
        let mut closer = StringBuilder.new()
        closer.write("\"")
        let mut h = 0
        while h < hashes {
            closer.write("#")
            h = h + 1
        }
        diag_error_span_notes("UnterminatedLiteral", UNTERMINATED_LITERAL, "unterminated {kind} literal", o_line, o_col, o_col + o_width,
            "close the literal with `{closer.to_str()}`",["the literal reaches the end of the file at line {line}, col {col}"])
        diag_cut_after(o_line, o_col)
        while mode_stack.len() > 1 {
            if mode_stack.get(mode_stack.len() - 1).unwrap() == MODE_STRING {
                push_tok(TokenKind.StringPart, string_buf.to_str(), line, col, col)
                string_buf.clear()
                push_tok(TokenKind.StringEnd, "\"", line, col, col)
            } else {
                push_tok(TokenKind.InterpEnd, "\}", line, col, col)
            }
            mode_stack.pop()
        }
    }

    // Emit EOF
    push_tok(TokenKind.EOF, "", line, col, col)
    if trace_mode != "" { trace("lex", "done ({tokens.kinds.len()} tokens)") }
}
