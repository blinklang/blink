// Shared harness for tests/test_cg_expr_*.bl: compile a probe source in-process, then
// lower one expression of it and read the IR tree back.
//
// The tests assert structure, not text: ir_dump carries the AST node id of every value,
// which changes whenever the probe source gains a line, so a text golden would break for
// reasons that have nothing to do with lowering.

import typecheck.{check_types, tc_lookup_node_tid}
import parser.{node_kind, node_name, node_value, node_source_module, nodes}
import compiler.{compile_to_program}
import ast.{NodeKind, nk_of}
import layout.{layout_reset, binder_scope_push, bind_binder}
import ir.{
    ir_reset, ir_kind, ir_kind_name, ir_c_name, ir_c_spelling, ir_kid, ir_kid_count,
    ir_verify, IrKind,
}
import cg_expr.{cg_expr_reset}
import cg_reg.{cg_reg_reset, cg_reg_build, cg_reg_global_decls}
import diagnostics.{diag_entries, diag_ice_count}
import std.io

// The Program node of the compiled probe. A test that runs a later pass by hand needs it,
// so it is the answer rather than a cell another test could read stale.
pub fn probe(stem: Str, src: Str) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck {
    env.set_var("BLINK_ROOT", process_run("pwd", []).out.trim())
    let path = "build/{stem}_probe.bl"
    write_file(path, src)
    let program = compile_to_program(path, 1)
    let _rm = process_run("rm", ["-f", path])
    check_types(program)
    layout_reset()
    ir_reset()
    cg_expr_reset()
    cg_reg_reset()
    cg_reg_build(program)
    bind_probe_locals()
    program
}

// The probe's own module. Its sources compile against the whole stdlib graph, so a walk
// over every node has to tell the probe's lines from the library's.
let probe_module = "__main__"

// The binder frame the statement stage would have opened. A test lowers one expression
// without that stage, so the probe's locals are bound here at their own types; a name with
// no binder is refused by design, and every probe local would hit that refusal otherwise.
// Module-level `let`s stay out: they are globals, which a local is allowed to shadow.
fn bind_probe_locals() {
    let scope = binder_scope_push()
    let mut bound: Map[Str, Int] = Map()
    let mut i = 0
    while i < nodes.len() {
        if node_source_module(i) == probe_module && is_binder_node(i) {
            let tid = binder_tid(i)
            if tid >= 0 {
                let name = node_name(i)
                // One frame holds every function of the probe, so a name two of them
                // declare would answer with whichever was walked last. That is a silent
                // wrong type in whatever the test then asserts, so the probe must not do
                // it: give the two bindings different names.
                if bound.contains_key(name) {
                    io.println("FAIL: probe binds '{name}' twice; two frames would be needed")
                    assert(false)
                }
                bound.insert(name, tid)
                bind_binder(scope, name, tid)
            }
        }
        i = i + 1
    }
}

fn is_binder_node(node: Int) -> Bool {
    let k = nk_of(node_kind(node))
    if k == NodeKind.Param { return true }
    if k != NodeKind.LetBinding { return false }
    !is_module_global(node)
}

fn is_module_global(node: Int) -> Bool {
    let decls = cg_reg_global_decls()
    let mut i = 0
    while i < decls.len() {
        if decls.get(i).unwrap() == node { return true }
        i = i + 1
    }
    false
}

// A binder's own stamp where typecheck left one, else the type of what it binds. Read
// through typecheck rather than layout so a node with no stamp answers -1 instead of
// recording an internal error a test would then read as its own.
fn binder_tid(node: Int) -> Int {
    let own = tc_lookup_node_tid(node)
    if own >= 0 { return own }
    tc_lookup_node_tid(node_value(node))
}

// The `let <name> = ...` node itself. A test names a binding this way so it reads as the
// source line it is about rather than as a node index.
pub fn let_node_of(name: Str) -> Int {
    let mut i = 0
    while i < nodes.len() {
        if nk_of(node_kind(i)) == NodeKind.LetBinding && node_name(i) == name { return i }
        i = i + 1
    }
    io.println("FAIL: probe has no binding '{name}'")
    assert(false)
    -1
}

// The right-hand side of `let <name> = ...` in the probe. Each test names its bindings,
// so a test reads as the expression it is about rather than as a node index.
// The first `Ident` in the program that spells `name`. A probe picks a name nothing in the
// stdlib graph spells, so the hit is the probe's own line.
pub fn ident_node_of(name: Str) -> Int {
    let mut i = 0
    while i < nodes.len() {
        if nk_of(node_kind(i)) == NodeKind.Ident && node_name(i) == name { return i }
        i = i + 1
    }
    io.println("FAIL: probe has no name '{name}'")
    assert(false)
    -1
}

// The `fn <name>` declaration node. A generic declaration identifies its own monomorphised
// instances, which is how a test tells them from the rest of the stdlib graph's.
pub fn fn_decl_of(name: Str) -> Int {
    let mut i = 0
    while i < nodes.len() {
        if nk_of(node_kind(i)) == NodeKind.FnDef && node_name(i) == name { return i }
        i = i + 1
    }
    io.println("FAIL: probe has no function '{name}'")
    assert(false)
    -1
}

pub fn rhs_of(name: Str) -> Int {
    node_value(let_node_of(name))
}

pub fn assert_eq_str(label: Str, got: Str, want: Str) {
    if got != want { io.println("FAIL: {label}: got '{got}' want '{want}'") }
    assert_eq(got, want)
}

pub fn assert_kind(label: Str, id: Int, want: IrKind) {
    assert(id >= 0)
    assert_eq_str(label, ir_kind_name(ir_kind(id)), ir_kind_name(want))
}

// The kind tree of one IR node, written as `Kind(kid, kid)`. Spans stay out of it, so a
// probe can gain a line without breaking a test.
pub fn shape(id: Int) -> Str {
    if id < 0 { return "-" }
    if ir_kid_count(id) == 0 { return ir_kind_name(ir_kind(id)) }
    let mut out = "{ir_kind_name(ir_kind(id))}("
    let mut i = 0
    while i < ir_kid_count(id) {
        if i > 0 { out = out.concat(", ") }
        out = out.concat(shape(ir_kid(id, i)))
        i = i + 1
    }
    out.concat(")")
}

pub fn assert_shape(label: Str, id: Int, want: Str) {
    assert_eq_str(label, shape(id), want)
}

pub fn assert_verifies(label: Str, id: Int) {
    let problems = ir_verify(id)
    if problems.len() > 0 { io.println("FAIL: {label}: {problems.join("; ")}") }
    assert_eq(problems.len(), 0)
}

// ── Internal errors ───────────────────────────────────────────────────────

// The name of the last internal error recorded, or "" when none was. diag_ice_at records
// and returns rather than unwinding, so a test reads the record instead of catching.
pub fn last_ice() -> Str {
    let mut i = diag_entries.len()
    while i > 0 {
        i = i - 1
        let d = diag_entries.get(i).unwrap()
        if d.severity == "ice" { return d.name }
    }
    ""
}

pub fn ice_count() -> Int { diag_ice_count }

pub fn assert_ice(label: Str, got: Int, want_name: Str) {
    if got >= 0 { io.println("FAIL: {label}: lowering answered {got} instead of refusing") }
    assert(got < 0)
    assert_eq_str(label, last_ice(), want_name)
}
