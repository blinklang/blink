// lowering.bl — C-spelling layer: interned type id (tid) -> C type spelling.
// Sits above typecheck and below codegen so typecheck never depends on a codegen
// module (the tid -> C spellers pull is_transparent_newtype/c_type_c_name from
// codegen_types, which would otherwise invert the layering).

import ast.{
    NodeKind, dbg_channel_on, dbg_trace
}
import parser.{
    at, node_args, node_elements, node_fields, node_kind, node_line, node_name,
    node_params, node_return_type, node_source_module, node_type_ann, node_type_name,
    node_type_params, sublist_get, sublist_length
}
import diagnostics.{
    ICE_SEG_TID_OUT_OF_RANGE, ICE_SEG_UNHANDLED_KIND, ICE_SEG_UNSOLVED_TYPEVAR,
    diag_is_ice_seg
}
import codegen_types.{
    CT_BOOL, CT_BYTES, CT_CHANNEL, CT_CHAR, CT_CLOSURE, CT_ENUM, CT_FFI_SCOPE, CT_FLOAT,
    CT_HANDLE, CT_HANDLER, CT_I16, CT_I32, CT_I8, CT_INT, CT_ITERATOR, CT_LIST, CT_MAP,
    CT_OPTION, CT_PTR, CT_RESULT, CT_SET, CT_STRING, CT_STRINGBUILDER, CT_STRUCT,
    CT_TEMPLATE, CT_U16, CT_U32, CT_U64, CT_U8, CT_VOID, c_type_c_name,
    c_type_tag_for_struct, escape_mono_seg, is_opaque_type, is_transparent_newtype,
    mono_slot_conflicts, mono_slot_conflicts_diff_type,
    mono_slot_conflicts_diff_type_injective, mono_slot_conflicts_same_type,
    opaque_handle_c_name, resolve_effect_vtable, strip_module_qualifier
}
import typecheck.{
    TAGPOS_INNER, TAGPOS_TOP, TYPE_BOOL, TYPE_CHAR, TYPE_FLOAT, TYPE_I16, TYPE_I32,
    TYPE_I8, TYPE_INT, TYPE_STR, TYPE_U16, TYPE_U32, TYPE_U64, TYPE_U8, TYPE_VOID,
    TyKind, TypePoolEntry, resolve_alias_tid, substitute_typevar_tid,
    tc_is_unbound_metavar, tc_lookup_node_tid, tc_module_let_tid, tc_mono_binds_map,
    tc_resolve, tc_resolve_transparent_alias_name, tc_ret_mint_at, tc_struct_decl_nodes,
    tc_tid_child, tc_tid_child_count, tc_tid_handler_effect, tc_tid_kind, tc_tid_name,
    tc_tid_resolved, tc_tid_same_type, tc_tid_struct, tc_tid_struct_arg_count,
    tc_type_decl_nodes, tc_type_is_struct, tc_type_str, tk_name,
    ty_param_list, ty_pool, type_kind
}

fn tc_tid_tag_at(tid0: Int, tagpos: Int) -> Str {
    let tid = tc_resolve(tid0)
    if tid < 0 || tid >= ty_pool.len() {
        if tagpos == TAGPOS_TOP {
            dbg_trace("ctagvoid", "producer=out_of_range tid0={tid0} tid={tid} pool_len={ty_pool.len()}")
        } else {
            if dbg_channel_on("voidtwin") != 0 { dbg_trace("voidtwin", "producer=inner_out_of_range tid0={tid0} tid={tid} pool_len={ty_pool.len()}") }
        }
        return ICE_SEG_TID_OUT_OF_RANGE
    }
    let t = ty_pool.get(tid).unwrap()
    let k = t.kind
    if k == TyKind.Struct || k == TyKind.Enum {
        let stem = tc_tid_struct_mono_name(tid)
        if stem != "" { return stem }
        // Twin alias hop for both positions: the two spellers must agree on
        // every bare struct/enum, aliases included, or Option[MyInt]/List[MyInt]/
        // Map[K,MyInt]/Result[MyInt,_] keep leaking the alias spelling even after the
        // top-level slot is fixed.
        let underlying = tc_resolve_transparent_alias_name(t.name)
        if underlying != -1 { return tc_tid_tag_at(underlying, tagpos) }
        if tagpos == TAGPOS_TOP { return strip_module_qualifier(t.name) }
        return c_type_tag_for_struct(t.name)
    }
    // Collapse, never interpolate: a recursive call can itself answer
    // a bare ICE_SEG_* sentinel (out-of-range / unsolved metavar / unhandled kind).
    // Interpolating that into "Option_{inner}" would bury it where diag_is_ice_seg's
    // prefix test can no longer see it. Inner
    // recursion is always TAGPOS_INNER regardless of this call's own position (both
    // original callers already did this; it is why sharing tc_tid_tuple_tag is safe).
    if k == TyKind.Option {
        let inner = tc_tid_tag_at(t.inner1, TAGPOS_INNER)
        if diag_is_ice_seg(inner) { return inner }
        return "Option_{inner}"
    }
    if k == TyKind.Result {
        let ok = tc_tid_tag_at(t.inner1, TAGPOS_INNER)
        if diag_is_ice_seg(ok) { return ok }
        let err = tc_tid_tag_at(t.inner2, TAGPOS_INNER)
        if diag_is_ice_seg(err) { return err }
        return "Result_{ok}_{err}"
    }
    if k == TyKind.Tuple { return tc_tid_tuple_tag(t) }
    if k == TyKind.Typevar {
        if tagpos == TAGPOS_INNER {
            // Gated explicitly: an unresolved generic type param is a common inner in
            // generic-heavy code, so this must not build the message when the channel is off.
            if dbg_channel_on("voidtwin") != 0 { dbg_trace("voidtwin", "producer=inner_typevar tid={tid}") }
        }
        return "<tv>"
    }
    // Map is an ERASED carrier like List and Set: one blink_map* serves every key/value
    // pair, so a SOLVED K/V drops to the flat tag ("Map" at TOP, "map" at INNER) and is
    // recovered per-use from the authoritative tid, never spelled into the C type. Unlike
    // the pre-erasure Map_{k}_{v} speller, K/V no longer ride the tag, so there is nothing
    // for the sentinel to be buried inside. The K/V are still walked for ONE reason: an
    // unbound metavar in a key or value must collapse to the bare ICE_SEG_UNSOLVED_TYPEVAR
    // rather than silently spelling "map" — the I0001 defense-in-depth the under-determined
    // decision keeps (decisions/under-determined-types.md, DECISIONS.md:342). List/Set do
    // not walk their element here yet; tightening them the same way is a separate follow-up.
    if k == TyKind.Map {
        if tagpos == TAGPOS_TOP { return "Map" }
        let key = tc_tid_tag_at(t.inner1, TAGPOS_INNER)
        if diag_is_ice_seg(key) { return key }
        let val = tc_tid_tag_at(t.inner2, TAGPOS_INNER)
        if diag_is_ice_seg(val) { return val }
        return "map"
    }
    if tagpos == TAGPOS_TOP {
        if k == TyKind.Int { return "Int" }
        if k == TyKind.Float { return "Float" }
        if k == TyKind.Bool { return "Bool" }
        if k == TyKind.Str { return "Str" }
        if k == TyKind.List { return "List" }
        if k == TyKind.Iterator { return "Iterator" }
        if k == TyKind.Handle { return "Handle" }
        if k == TyKind.Channel { return "Channel" }
        // Mirrors codegen's two CT_PTR spellings — Pascal at the carrier position
        // (type_name_from_ct, codegen_types.bl:4518) and lowercase inside a segment
        // (c_type_tag, :6095). Both DROP the pointee, which is what makes Ptr non-injective as
        // a segment below.
        if k == TyKind.Ptr { return "Ptr" }
        // The twin of codegen's type_name_from_ct(CT_HANDLER) = "Handler"
        // (codegen_types.bl:5310), spelled at both positions so the tid path byte-matches the
        // string path for a Handler type arg. THE EFFECT IS DROPPED, like Handle's and Ptr's
        // parameters directly above — and here the drop is not merely conventional: TyKind.Handler
        // carries the effect in the entry's NAME slot rather than as a child tid, so
        // tc_tid_child_count is 0 and there is no inner tid to recurse into even in principle. The
        // effect-specific vtable type is recovered from the tid by c_type_from_tid's Handler arm,
        // which is the channel that keeps this lossless.
        if k == TyKind.Handler { return "Handler" }
        if k == TyKind.Set { return "Set" }
        if k == TyKind.Bytes { return "Bytes" }
        // Mirrors codegen's own two spellings for CT_STRINGBUILDER — Pascal at the
        // carrier position (type_name_from_ct, codegen_types.bl:4517) and lowercase
        // inside a segment (c_type_tag, :6094). Spelled on both sides so the tid path
        // byte-matches the string path for a StringBuilder type arg.
        if k == TyKind.StringBuilder { return "StringBuilder" }
        if k == TyKind.I8 { return "I8" }
        if k == TyKind.I16 { return "I16" }
        if k == TyKind.I32 { return "I32" }
        if k == TyKind.U8 { return "U8" }
        if k == TyKind.U16 { return "U16" }
        if k == TyKind.U32 { return "U32" }
        if k == TyKind.U64 { return "U64" }
        if k == TyKind.Char { return "Char" }
        // I0001: an unbound metavar (TyKind.Unknown) reaching C-tag emission means
        // an under-determined binding escaped the E0301 boundary check — a compiler
        // invariant violation. Fail CLOSED with an invalid-C-identifier sentinel so the C
        // compiler errors loudly, NEVER silently fall through to "Void" (the pre-decision
        // erased-default miscompile). Keys on KIND, per DECISIONS.md:342.
        if k == TyKind.Unknown { return ICE_SEG_UNSOLVED_TYPEVAR }
        // A GENUINE Void, answered deliberately rather than by fall-through. Void is "an
        // ordinary INHABITED, encodable type" (decisions/under-determined-types.md:38-42,
        // 6-0) and is genuinely distinct from an unsolved metavariable α (:51-54 —
        // substituting one for the other "is licensed by no typing rule"). The I0001
        // tripwire keys on the KIND "so a genuine GKV[Void, Void] is unaffected"
        // (:263-266, DECISIONS.md:342), which is only true if this arm exists: without
        // it, Void shares its spelling with the two failure buckets below and every
        // consumer that rejects one rejects all three. Byte-identical to the string
        // path, which also spells a Void type arg "Void".
        if k == TyKind.Void {
            dbg_trace("ctagvoid", "producer=genuine_void tid={tid} name={t.name}")
            return "Void"
        }
        // A kind with no arm above (TyKind.Fn, any kind added later). Fails
        // CLOSED rather than sharing the genuine Void's spelling directly above: this is
        // not a type name, it is "this encoder does not know how to spell this kind", and
        // letting it read as "Void" is what made the two indistinguishable. The floor is
        // measured at 0 across the corpus and both compiler entry points (ctagvoid,
        // CLAUDE.md), so arming it cannot regress a working program — it can only make a
        // future kind loud instead of silent.
        dbg_trace("ctagvoid", "producer=unhandled_kind tid={tid} k={tk_name(k)} name={t.name}")
        return ICE_SEG_UNHANDLED_KIND
    }
    // INNER: lowercase scalars, mirroring codegen_types.c_type_tag.
    if k == TyKind.Int { return "int" }
    if k == TyKind.Float { return "double" }
    if k == TyKind.Bool { return "bool" }
    if k == TyKind.Str { return "str" }
    if k == TyKind.List { return "list" }
    if k == TyKind.Iterator { return "iter" }
    if k == TyKind.Handle { return "handle" }
    if k == TyKind.Channel { return "channel" }
    if k == TyKind.Ptr { return "ptr" }
    // Byte-matches c_type_tag(CT_HANDLER) = "handler" (codegen_types.bl:6964), which is the
    // segment that makes `blink_Option_handler` a name emit_option_typedef will actually
    // declare.
    if k == TyKind.Handler { return "handler" }
    // Byte-matches c_type_tag(CT_CLOSURE) = "closure", the segment that makes
    // `blink_Option_closure` / `blink_Result_closure_str` names their emitters will declare.
    // A closure type is TyKind.Fn (there is no TyKind.Closure — it was deleted); its params and
    // return are dropped, which is EXACT rather than merely conventional here: every closure is
    // one `blink_closure*` member, so a per-signature carrier name would emit distinct typedefs
    // with byte-identical bodies.
    //
    // ONLY at INNER. TyKind.Fn deliberately keeps reaching ICE_SEG_UNHANDLED_KIND at TOP, where
    // this function's caller tc_tid_to_c_tag spells mono-instance names: dropping the signature
    // there would mangle `identity[fn(Int) -> Int]` and `identity[fn(Str) -> Str]` to one symbol
    // and one body — a silent collision, traded for a loud floor instead. That is a KNOWING
    // divergence from the Handle/Ptr/Handler precedent, which takes arms at both positions and
    // accepts pointee-dropping at TOP ("Both DROP the pointee, which is what makes Ptr
    // non-injective as a segment"). Non-injectivity is tolerable for a pointee that the mono
    // args CSV recovers elsewhere; a whole fn signature is not.
    if k == TyKind.Fn { return "closure" }
    if k == TyKind.Set { return "set" }
    if k == TyKind.Bytes { return "bytes" }
    if k == TyKind.StringBuilder { return "stringbuilder" }
    if k == TyKind.Option { return "option" }
    if k == TyKind.Result { return "result" }
    if k == TyKind.I8 { return "i8" }
    if k == TyKind.I16 { return "i16" }
    if k == TyKind.I32 { return "i32" }
    if k == TyKind.U8 { return "u8" }
    if k == TyKind.U16 { return "u16" }
    if k == TyKind.U32 { return "u32" }
    if k == TyKind.U64 { return "u64" }
    if k == TyKind.Char { return "char" }
    // A GENUINE Void, answered deliberately (the twin of the TOP arm's TyKind.Void case).
    //
    // THIS ARM IS LOAD-BEARING AND MUST NOT BE DELETED.
    //
    // tc_tid_tag_at's TOP-position TyKind.Result arm spells Result[Void, Str] as
    // "Result_{tc_tid_tag_at(inner1, INNER)}_{...}", and the INNER recursion on a Void
    // inner reaches THIS arm before it ever reaches the fall-through below — so
    // Result_void_str's "void" comes from here, full stop. src/codegen_types.bl's
    // result-typedef emitter MATCHES that literal tag (`if ok_tag == "void" || ok_tag ==
    // "Void"`) to lower the Void leaf to an int64_t placeholder field; deleting this arm
    // (or changing what it returns) would miss that match and emit an undeclared type.
    // Result[Void, E] is not a corner case: lib/std/ depends on it (bytes.bl,
    // db_sqlite.bl, traits.bl) and the compiler synthesizes it for EVERY `?`-bearing
    // `test` block. The fall-through below is a SEPARATE bucket (kinds with no arm at all)
    // that a genuine Void never reaches, so arming that bucket does not touch this one.
    if k == TyKind.Void {
        // Gated explicitly (not just relying on dbg_trace's own internal gate): this arm is
        // a hot path — Result[Void, E] is synthesized for every `?`-bearing test block —
        // so the message must not be built when the channel is off.
        if dbg_channel_on("voidtwin") != 0 { dbg_trace("voidtwin", "producer=scalar_genuine_void tid={tid}") }
        return "void"
    }
    // An unbound metavariable: this is the erased-default bucket DECISIONS.md:342 forbids —
    // an unsolved α reaching codegen must ICE, never silently spell "void" (which the same
    // kind DOES answer correctly at TOP position). It is reachable in principle only if some
    // future caller stops routing an unbound metavar away via tc_tid_encodable/
    // tc_tid_tuple_elem_faithful and lets it ride the tid path instead — exactly the failure
    // this arm now forecloses at the source.
    if k == TyKind.Unknown {
        if dbg_channel_on("voidtwin") != 0 { dbg_trace("voidtwin", "producer=scalar_unsolved_typevar tid={tid}") }
        return ICE_SEG_UNSOLVED_TYPEVAR
    }
    // Every kind with a real arm above is exhausted, and TyKind.Void/TyKind.Unknown are both
    // intercepted above too, so this is reached only by a kind this speller never learned
    // (TyKind.Fn). Safe to arm because, per the TyKind.Void arm's comment above, a genuine
    // Void can never reach this line — only a kind this speller genuinely never learned does.
    if dbg_channel_on("voidtwin") != 0 { dbg_trace("voidtwin", "producer=scalar_unhandled_kind tid={tid} k={tk_name(k)}") }
    ICE_SEG_UNHANDLED_KIND
}

// Codegen tag for the INNER of a compound carrier. Struct/enum → stripped name (module
// prefix KEPT), nested compound → recurse, else lowercase scalar tag. Mirrors
// codegen_types.resolve_ann_tag's inner behavior but reads the tid structurally instead
// of guessing from a flattened string. Thin wrapper over tc_tid_tag_at.
pub fn tc_tid_inner_tag(tid: Int) -> Str {
    tc_tid_tag_at(tid, TAGPOS_INNER)
}

fn tc_tid_tuple_tag(t: TypePoolEntry) -> Str {
    let start = t.params_start
    let count = t.params_count
    let mut tag = "Tuple{count}"
    let mut i = 0
    while i < count {
        // Collapse, never interpolate — same rule as the OPTION/RESULT/MAP arms above: an
        // ICE_SEG_* element must replace the whole tag, not get concatenated into it.
        // Elements are always TAGPOS_INNER regardless of the tuple's own position.
        let elem_raw = tc_tid_tag_at(ty_param_list.get(start + i).unwrap(), TAGPOS_INNER)
        if diag_is_ice_seg(elem_raw) { return elem_raw }
        // A transparent newtype (Errno) element lowers to a bare int64_t, so the
        // tuple carrier names it `int` — matching the annotated (resolve_tuple_ann)
        // and inferred (emit_tuple_lit) spellers. Result deliberately keeps its
        // nominal Errno tag, so this erasure stays tuple-specific, not in tc_tid_tag_at.
        let elem = if is_transparent_newtype(elem_raw) != 0 { "int" } else { elem_raw }
        tag = tag.concat("_").concat(elem)
        i = i + 1
    }
    tag
}

// Prints the counterfactual for a single gate rejection: what the armed tc_tid_inner_tag
// answers for `tid` when a caller's gate (tc_tid_encodable / tc_tid_inner_tag_faithful) has
// just declined to route it onto the tid path. tc_tid_inner_tag IS the ICE-or-genuine
// answer — no separate shadow predicate to keep in lockstep — so this only needs to call it
// and check diag_is_ice_seg on the result. Gated on
// the channel first so a cold run skips the extra structural walk on every rejection — every
// caller site is on a generic call's hot path pre-monomorphization.
//
// Callers narrow `tid` to a scalar/typevar/unknown leaf before its own gate check, with one
// exception: tc_tid_inner_tag_faithful's params_count!=0 branch also reaches a non-STRUCT/ENUM
// compound tid here (e.g. a TyKind.Tuple with arity>0, via its "faithful_reject_paramcount" call) —
// harmless, since tc_tid_tag_at's TyKind.Tuple arm spells it structurally rather than falling
// through to its TAGPOS_INNER scalar fallback, so diag_is_ice_seg never fires for a genuine compound. A
// struct/enum tid can also legitimately answer a non-ICE erased name here (the STRUCT/ENUM arm's
// own give-up path, a separate undischarged concern, not this probe's job to flag).
fn voidtwin_probe(gate: Str, tid: Int) {
    if dbg_channel_on("voidtwin") == 0 { return }
    let spelled = tc_tid_inner_tag(tid)
    if !diag_is_ice_seg(spelled) { return }
    dbg_trace("voidtwin", "probe=gate_reject gate={gate} tid={tid} k={tk_name(type_kind(tid))} would_ice={spelled}")
}

// TK_* → CT_* translation. The two numberings are NOT the same (e.g. TyKind.Map=18
// vs CT_MAP=13, TyKind.Struct=9 vs CT_STRUCT=23), so a cast would silently corrupt.
// Explicit switch; unknown kinds map to CT_VOID.
// Q2's translation layer between the two type universes, and slated for deletion
// once codegen reads the tid directly. Exhaustive by construction: six kinds have
// no CT at all and collapse onto CT_VOID, which is a LOSSY answer, not a correct
// one — CT_VOID here means "codegen's flat universe cannot say this", and callers
// that must not force a value to void re-read it as -1 (see tid_inner_ct below).
// Naming those six keeps the collapse legible instead of implicit in a
// fall-through, and makes a newly added kind a compile error here.
fn tk_to_ct(kind: TyKind) -> Int {
    match kind {
        TyKind.Int => CT_INT
        TyKind.Float => CT_FLOAT
        TyKind.Bool => CT_BOOL
        TyKind.Str => CT_STRING
        TyKind.List => CT_LIST
        TyKind.Option => CT_OPTION
        TyKind.Result => CT_RESULT
        TyKind.Struct => CT_STRUCT
        TyKind.Enum => CT_ENUM
        TyKind.Iterator => CT_ITERATOR
        TyKind.Handle => CT_HANDLE
        TyKind.Channel => CT_CHANNEL
        // Codegen has carried CT_HANDLER since handlers landed (codegen_types.bl:51) and keys
        // the vtable side-channel on it, so this arm makes the two universes AGREE rather than
        // adding knowledge — the same relationship the Template arm below has. The flat entry
        // also stores the vtable type name in `sname` and an is-user-effect flag in `inner1`
        // (codegen_types.bl:4841); the CT alone carries neither, which is why the tid is the
        // only side that can say WHICH effect.
        TyKind.Handler => CT_HANDLER
        TyKind.Ptr => CT_PTR
        TyKind.Map => CT_MAP
        TyKind.Bytes => CT_BYTES
        TyKind.Set => CT_SET
        TyKind.StringBuilder => CT_STRINGBUILDER
        // Codegen has always known this one: `"Template" => CT_TEMPLATE` (codegen_types.bl:5709)
        // maps the annotation NAME to it, and the 7 emitters key on it. Only the tid side was
        // missing, so this arm makes the two universes agree rather than adding knowledge.
        TyKind.Template => CT_TEMPLATE
        // Third arm of the same kind as Handler and Template above: CT_CLOSURE has existed since
        // closures landed (codegen_types.bl:36) and the flat side stamps it on every closure
        // binding, so this makes the two universes agree at the ROOT rather than adding knowledge.
        // It does NOT make a closure cell agree overall, and that is not a shortcoming of this arm:
        // the flat universe holds a closure's signature as a C STRING, not as tp children, so the
        // return and the params have no flat slot. The tid is the authority for those.
        TyKind.Fn => CT_CLOSURE
        TyKind.FfiScope => CT_FFI_SCOPE
        TyKind.I8 => CT_I8
        TyKind.I16 => CT_I16
        TyKind.I32 => CT_I32
        TyKind.U8 => CT_U8
        TyKind.U16 => CT_U16
        TyKind.U32 => CT_U32
        TyKind.U64 => CT_U64
        TyKind.Char => CT_CHAR
        // No CT exists for these. CT_VOID is the erasure, not a type.
        TyKind.Void => CT_VOID
        TyKind.Tuple => CT_VOID
        TyKind.Typevar => CT_VOID
        TyKind.Unknown => CT_VOID
    }
}

// ── C-spelling divergence counter (ctypediv) ───────────────────────────
//
// A shared per-site counter of how a tid's C SPELLING compares to the C codegen actually
// emitted at a site. ctype_probe_at feeds it; the ctypediv sweep (ty_divergence_dump) reads it.
//
// WHY IT LIVES IN typecheck.bl. It keys on c_type_from_tid, the tid speller this file owns, and
// every codegen module (codegen_expr / codegen_stmt / codegen_methods) imports typecheck, so a
// probe call anywhere in codegen can reach it.
//
// THREE BUCKETS, kept separate because they mean different things: Missing (the tid declines to
// spell the type at all), Diverge (the tid spells a different C string than codegen emitted), and
// Agree. A per-site zero is the exit criterion, so a QUERY must never create a row — an unreached
// site reads 0 as "never measured", which a sweep must not confuse with "clean".
pub type TyDiv { Agree, Diverge, Missing }

type TyDivRow {
    site: Str
    agree: Int
    diverge: Int
    missing: Int
}
// Deliberately NOT reset by reset_scope_state: that runs per function, and a per-function
// counter cannot answer a whole-corpus sweep. Reset is explicit only.
let mut ty_div_rows: List[TyDivRow] = []

fn ty_div_find(site: Str) -> Int {
    let mut i = 0
    while i < ty_div_rows.len() {
        if ty_div_rows.get(i).unwrap().site == site { return i }
        i = i + 1
    }
    -1
}

fn ty_div_bump(site: Str, b: TyDiv) {
    let idx = ty_div_find(site)
    if idx < 0 {
        ty_div_rows.push(TyDivRow { site: site, agree: 0, diverge: 0, missing: 0 })
        ty_div_bump(site, b)
        return
    }
    let r = ty_div_rows.get(idx).unwrap()
    match b {
        TyDiv.Agree => { ty_div_rows.set(idx, TyDivRow { agree: r.agree + 1, ..r }) }
        TyDiv.Diverge => { ty_div_rows.set(idx, TyDivRow { diverge: r.diverge + 1, ..r }) }
        TyDiv.Missing => { ty_div_rows.set(idx, TyDivRow { missing: r.missing + 1, ..r }) }
    }
}

// A query must never create a row: a sweep's zero has to mean "reached and clean", not
// "never reached" (the unexercised-tap failure mode).
pub fn ty_divergence_count(site: Str, b: TyDiv) -> Int {
    let idx = ty_div_find(site)
    if idx < 0 { return 0 }
    let r = ty_div_rows.get(idx).unwrap()
    match b {
        TyDiv.Agree => return r.agree
        TyDiv.Diverge => return r.diverge
        TyDiv.Missing => return r.missing
    }
}

pub fn ty_divergence_rows() -> List[Str] {
    let mut out: List[Str] = []
    let mut i = 0
    while i < ty_div_rows.len() {
        let r = ty_div_rows.get(i).unwrap()
        out.push("{r.site} agree={r.agree} diverge={r.diverge} missing={r.missing}")
        i = i + 1
    }
    out
}

// ── ctypediv instrument: the C SPELLING a tid answers vs the one codegen emitted ──────
//
// This compares the two C STRINGS an emit site could print: what c_type_from_tid answers for
// the authoritative tid, and what codegen actually emitted. Only the string comparison says
// whether reading the type off the tid at a site changes the output — a cell can spell the
// same C from either path (every container is one runtime pointer type) or disagree on the
// spelling (a mono stem, a Void placeholder, a Ptr pointee).
//
// Rows key on a `ctype.` site prefix. The bump is gated on the `ctypediv` channel, so a row
// cannot exist unless someone is measuring, and a row still cannot exist without having been
// reached — the property that lets a zero mean "clean" instead of "never ran".
//
// `emitted` is what the caller is ABOUT to print (or just printed) for this variable, and
// `branch` names which arm of the caller's chain produced it — the cell map is only actionable
// per branch, because a Void placeholder disagreeing with `void` is a position rule working
// correctly while a struct branch disagreeing is a real defect.
pub fn ctype_probe_at(tid: Int, branch: Str, name: Str, emitted: Str, node: Int) {
    if dbg_channel_on("ctypediv") == 0 { return }
    let site = "ctype.{branch}"
    let spelled = c_type_from_tid(tid)
    if spelled == "" {
        ty_div_bump(site, TyDiv.Missing)
        ctype_div_trace(site, "decline", name, tid, "-", emitted, node)
        return
    }
    if spelled == emitted {
        ty_div_bump(site, TyDiv.Agree)
        return
    }
    ty_div_bump(site, TyDiv.Diverge)
    ctype_div_trace(site, "diverge", name, tid, spelled, emitted, node)
}

// `at=` LAST, because both spellings can contain a space (`const char*`, `const blink_Box*`)
// and every sweep script gets at the cell by stripping the fixed trailing tokens (` at=…` and
// the harness's own ` file=…`).
fn ctype_div_trace(site: Str, bucket: Str, name: Str, tid: Int, spelled: Str, emitted: Str, node: Int) {
    let ty = if tid >= 0 { tc_type_str(tid) } else { "-" }
    // `at_str`, not `at`, as a WORKAROUND: a local `let at` resolves to parser.bl's PRIVATE
    // `fn at` and reports error[ImportNotSelected]. Rename back to `at` once that shadowing is fixed.
    let at_str = if node >= 0 { "{node_source_module(node)}:{node_line(node)}" } else { "-" }
    dbg_trace("ctypediv", "bucket={bucket} site={site} var={name} ty={ty} tidc={spelled} emitted={emitted} at={at_str}")
}

// A module-level `let`'s tid, which does NOT live on its value node. The top-level walk types an
// annotated binding through `resolve_type_ann` and only calls `infer_type` on a bare numeric or
// interpolated-string initializer, so the node memo answers for the literal case alone. This map is
// the channel that holds the rest. Returns -1 when the binding was registered as UNKNOWN, which is
// the genuinely untyped case rather than a lookup miss.
pub fn tc_top_level_let_tid(module_name: Str, name: Str) -> Int {
    match tc_module_let_tid.get("{module_name}.{name}") {
        Some(tid) => tid
        None => -1
    }
}

// The sweep's readout: one NDJSON-ish line per occurrence, carrying both renderings so the
// cell map says WHAT diverged and not merely where. Off by default, so the instrument costs
// a channel check per call when nobody is measuring.
// The sweep's per-site summary, emitted once at the end of a codegen run. Silent when the
// channel is off, and silent when no site was ever reached — an empty dump means "the
// instrument was not exercised", which is a different claim from "zero divergences", and
// keeping the two distinguishable is the whole reason a sweep can be trusted.
pub fn ty_divergence_dump() {
    if dbg_channel_on("ctypediv") == 0 { return }
    let rows = ty_divergence_rows()
    let mut i = 0
    while i < rows.len() {
        let row = rows.get(i).unwrap()
        dbg_trace("ctypediv", "summary {row}")
        i = i + 1
    }
}

// Inner-type accessors over a tid. A Set[T]/Map[K,V] element reached through a
// tuple/struct-field boundary loses its inner type in the type-erased carrier;
// codegen recovers it from the per-node tid memo (tc_lookup_node_tid) via these.
// Non-matching tids return a safe sentinel (-1 / "") so an un-memoized edge is a
// no-op fallback.
//
// -1, not CT_VOID, when the inner kind has no concrete SCALAR storage type
// (typevar/tuple/fn/closure/unknown all map to CT_VOID through tk_to_ct). A
// caller gating on `ct >= 0` must treat an unresolvable inner as a no-op instead
// of forcing the element to void, which would emit a `void _mkey` key box.
//
// An enum inner answers CT_ENUM here (not a decline): the List elem path stamps
// a plain enum its CT_INT ordinal off this CT, and recover_set_elem_from_tid
// gates its sname on `ct >= 0`. An enum is still name-carried through the paired
// sname accessor (tid_inner_struct), so a consumer whose CT guard omits CT_ENUM
// (the kops Set-key path, whose guard is CT_VOID/CT_STRUCT) must exclude CT_ENUM
// on its own side to fall through to that sname — see get_set_elem_type.
fn tid_inner_ct(inner0: Int) -> Int {
    if inner0 < 0 || inner0 >= ty_pool.len() { return -1 }
    // A transparent `type Port = Int` element hashes through its base type's
    // vtable, so peel the alias to its underlying tid before reading the CT —
    // the flat pool already stamps the resolved base at binding sites. A no-op
    // for non-aliases (resolve_alias_tid returns the tid unchanged).
    let inner = resolve_alias_tid(inner0)
    if inner < 0 || inner >= ty_pool.len() { return -1 }
    let kind = ty_pool.get(inner).unwrap().kind
    let ct = tk_to_ct(kind)
    if ct == CT_VOID { return -1 }
    ct
}

fn tid_inner_struct(inner0: Int) -> Str {
    if inner0 < 0 || inner0 >= ty_pool.len() { return "" }
    let inner = resolve_alias_tid(inner0)
    if inner < 0 || inner >= ty_pool.len() { return "" }
    let it = ty_pool.get(inner).unwrap()
    if it.kind == TyKind.Struct || it.kind == TyKind.Enum {
        // A generic struct INSTANCE inner (Box[Int]) must carry its recursive mono
        // stem (Box_Int), not the erased bare head (Box) — this feeds the generic-fn
        // bare-typevar-return recovery (emit_generic_fn_call_tail) that types the
        // receiving `let` variable's carrier. Mirror tc_tid_inner_tag / the top-level
        // branch; "" from tc_tid_struct_mono_name (bare base, typevar, module-qual)
        // keeps the bare fallback.
        //
        // An enum instance shares this path because tc_struct_slot_encodable /
        // tc_tid_encodable already admit one through this same
        // tc_tid_struct_mono_name.
        let stem = tc_tid_struct_mono_name(inner)
        if stem != "" { return stem }
        return strip_module_qualifier(it.name)
    }
    // A TUPLE inner answers its generated tag, on the same footing as a struct: a tuple's C
    // type IS a generated struct (`blink_Tuple2_int_int`), and codegen's List house convention
    // spells a tuple element the same way it spells a struct element, as the pair
    // `(CT_VOID, sname)` (codegen_expr.bl's recover_list_elem_from_tid tail, and the declared
    // LetBinding path it mirrors). Answering "" here instead would make an unannotated `let`
    // over a `List[(A, B)]`-returning call erase its element to Void. The Iterator / Handle /
    // Channel / Bytes kinds still decline because they have no parity target to name.
    // tk_to_ct answers CT_VOID for TyKind.Tuple, which stays correct — the tag is precisely
    // how a tuple is named when no CT can name it.
    if it.kind == TyKind.Tuple {
        return tc_tid_tuple_tag(it)
    }
    ""
}

pub fn tc_tid_set_elem_ct(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Set { return -1 }
    tid_inner_ct(t.inner1)
}

pub fn tc_tid_set_elem_struct(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Set { return "" }
    tid_inner_struct(t.inner1)
}

// The Set element slot's mono STEM only — declines (returns "") on a genuinely
// erased element rather than falling back to tid_inner_struct's bare head, so a
// caller can cede to the flat channel. The Set twin of tc_tid_list_elem_struct_mono.
pub fn tc_tid_set_elem_struct_mono(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Set { return "" }
    tc_tid_struct_mono_name(tc_resolve(t.inner1))
}

// The Set element TID (the whole subtree), the Set twin of tc_tid_list_elem.
// Resolves the container and the element so a late-bound `Set()` metavar is
// followed, letting deep_tp_from_tid descend a Set inner the way it descends a
// List inner instead of erasing it.
pub fn tc_tid_set_elem_tid(tid: Int) -> Int {
    let rt = tc_resolve(tid)
    if rt < 0 || rt >= ty_pool.len() { return -1 }
    let t = ty_pool.get(rt).unwrap()
    if t.kind != TyKind.Set { return -1 }
    tc_resolve(t.inner1)
}

// The Iterator element TID, the Iterator twin of tc_tid_set_elem_tid/tc_tid_list_elem.
// Resolves the element so deep_tp_from_tid follows a late-bound metavar instead of
// erasing it — tc_tid_iter_elem returns the slot raw, which every other consumer wraps
// in a resolver, so a non-resolving descent here would drop a knowable element type.
pub fn tc_tid_iter_elem_tid(tid: Int) -> Int {
    let rt = tc_resolve(tid)
    if rt < 0 || rt >= ty_pool.len() { return -1 }
    let t = ty_pool.get(rt).unwrap()
    if t.kind != TyKind.Iterator { return -1 }
    tc_resolve(t.inner1)
}

// The List twin of tc_tid_set_elem_ct/_struct above — same non-resolving
// contract, feeding recover_list_elem_from_tid's per-use recovery rather than a
// resolved/kops path (so no _resolved variant here, unlike tc_tid_set_elem_*_resolved).
pub fn tc_tid_list_elem_ct(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.List { return -1 }
    tid_inner_ct(t.inner1)
}

pub fn tc_tid_list_elem_struct(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.List { return "" }
    tid_inner_struct(t.inner1)
}

// The List element slot as a struct/enum HEAD only — the tc_tid_struct twin for
// the element slot. Declines a tuple element: tc_tid_struct restricts to
// Struct/Enum, so a tuple cedes to the flat sname2 rather than borrowing
// tid_inner_struct's bare Tuple tag. Pairs with tc_tid_list_elem_struct_mono the
// way tc_tid_map_val_struct_head pairs with tc_tid_map_val_struct_mono. Callers
// must still gate enums out separately where an ordinal-stored enum element must
// not surface a struct box (see get_list_elem_struct).
pub fn tc_tid_list_elem_struct_head(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.List { return "" }
    tc_tid_struct(tc_resolve(t.inner1))
}

// The List element slot's CT, resolved through metavars/aliases first — the
// binding-site twins the tid-first get_list_elem_type consult, mirroring the
// Set/Map resolved twins.
pub fn tc_tid_list_elem_ct_resolved(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.List { return -1 }
    tid_inner_ct(tc_resolve(t.inner1))
}

// The element CT/struct of a SEQUENCE carrier — a List OR an Iterator, which both store their
// element in inner1. The eager `list.map` returns List[out] and the lazy `iter.map` returns
// Iterator[out] (§3c.1); the codegen map arm recovers its output element from that node tid, so
// it must read either kind. Kept separate from tc_tid_list_elem_* so the many List-only callers
// (derive, type-emit) keep declining an Iterator tid.
pub fn tc_tid_seq_elem_ct_resolved(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.List && t.kind != TyKind.Iterator { return -1 }
    tid_inner_ct(tc_resolve(t.inner1))
}

pub fn tc_tid_seq_elem_struct(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.List && t.kind != TyKind.Iterator { return "" }
    tid_inner_struct(t.inner1)
}

// The List element slot's mono STEM only (Box_0Int) — never the bare-head
// fallback tid_inner_struct would give. A list whose element arrives genuinely
// erased (a bare-typevar generic-fn return whose inner1 reads back as the bare
// head) has no recoverable stem in the tid, and its bare name IS the undeclared
// C symbol; so this DECLINES (returns "") there and the caller cedes to the flat
// sname2 channel. A directly-annotated concrete instance keeps params_count>0, so
// tc_tid_struct_mono_name answers authoritatively and the tid — not sname2 —
// leads. Mirrors tc_tid_map_val_struct_mono; list elements are payload-carried
// like map values, not kops-keyed like set/map keys.
pub fn tc_tid_list_elem_struct_mono(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.List { return "" }
    tc_tid_struct_mono_name(tc_resolve(t.inner1))
}

pub fn tc_tid_map_key_ct(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Map { return -1 }
    tid_inner_ct(t.inner1)
}

pub fn tc_tid_map_key_struct(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Map { return "" }
    tid_inner_struct(t.inner1)
}

pub fn tc_tid_map_val_ct(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Map { return -1 }
    tid_inner_ct(t.inner2)
}

pub fn tc_tid_map_val_struct(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Map { return "" }
    tid_inner_struct(t.inner2)
}

// Resolving twins of the Set/Map element accessors above. The plain accessors
// read ty_pool.get(inner) WITHOUT tc_resolve, so a metavar that
// tc_pin_generic_args_from_binds bound IN PLACE (kind stays TyKind.Unknown, solution
// stashed in inner1) reads back as TyKind.Unknown -> CT_VOID -> -1/"". These wrap the
// inner in tc_resolve so a bound a_k := Int surfaces its real ct/sname.
// kops_table_name keys the vtable on the key ct and sname alone, so the Map value
// type doesn't affect it — but recover_map_kv_from_tid (codegen_expr.bl) DOES need
// the value's concrete ct/sname (to pick the right box/unbox shape at the read
// site), so the val twins below resolve too: using the plain, non-resolving val
// accessor there would let an in-place-bound value metavar read back as -1, bail
// the whole recovery, and leave the field at its erased CT_INT default while the
// map actually stored a boxed value of a different ct — a real box/unbox mismatch
// (segfault, not just a wrong value). Kept separate from the plain accessors:
// other callers still depend on the bound-but-typevar inner reading as -1/"".
pub fn tc_tid_map_key_ct_resolved(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Map { return -1 }
    tid_inner_ct(tc_resolve(t.inner1))
}

pub fn tc_tid_map_key_struct_resolved(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Map { return "" }
    tid_inner_struct(tc_resolve(t.inner1))
}

pub fn tc_tid_map_val_ct_resolved(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Map { return -1 }
    tid_inner_ct(tc_resolve(t.inner2))
}

pub fn tc_tid_map_val_struct_resolved(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Map { return "" }
    tid_inner_struct(tc_resolve(t.inner2))
}

// The Map VALUE slot's mono STEM only (Box_0Int) — never the bare-head fallback
// tc_tid_map_val_struct_resolved would give through tid_inner_struct. A value that
// arrives genuinely erased (a bare-typevar generic-fn return whose inner2 reads back
// as the bare head) has no recoverable stem in the tid, and its bare name IS the
// undeclared C symbol; so this DECLINES (returns "") there and the caller cedes to
// the flat sname2 channel, which holds whatever the annotation site could recover. A
// directly-annotated concrete instance keeps params_count>0, so tc_tid_struct_mono_name
// answers authoritatively and the tid — not sname2 — leads.
pub fn tc_tid_map_val_struct_mono(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Map { return "" }
    tc_tid_struct_mono_name(tc_resolve(t.inner2))
}

// The Map VALUE slot as a struct/enum HEAD only — the tc_tid_struct twin for the
// value slot. Declines a tuple value: tc_tid_struct restricts to Struct/Enum, so a
// tuple cedes to the flat sname2 rather than borrowing tid_inner_struct's bare
// Tuple2 tag. Pairs with tc_tid_map_val_struct_mono the way sv_struct_tid_first's
// nominal step pairs tc_tid_struct with the mono stem.
pub fn tc_tid_map_val_struct_head(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Map { return "" }
    tc_tid_struct(tc_resolve(t.inner2))
}

// The Map VALUE slot as a TUPLE tag ("Tuple2_int_int"), the tuple twin of
// tc_tid_map_val_struct_head. tc_tid_map_val_struct_head declines a tuple value
// (tc_tid_struct restricts to Struct/Enum) and historically ceded it to the flat
// sname2 channel; this accessor lets get_map_value_struct spell the tuple carrier
// tag from the authoritative map tid instead, so the flat sname2 tuple case no
// longer needs a fallback.
pub fn tc_tid_map_val_tuple(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Map { return "" }
    tc_tid_tuple_sname(tc_resolve(t.inner2))
}

pub fn tc_tid_set_elem_ct_resolved(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Set { return -1 }
    tid_inner_ct(tc_resolve(t.inner1))
}

pub fn tc_tid_set_elem_struct_resolved(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Set { return "" }
    tid_inner_struct(tc_resolve(t.inner1))
}

// Is a Map/Set tid's KOPS-DECIDING slot (the key for Map, the element for Set —
// inner1 either way) still a genuinely unbound metavar? The fail-closed backstop
// uses this, not tc_tid_has_unbound_metavar, because that predicate also descends
// the Map VALUE slot (inner2) — `Map[Int, ?v]` is a
// reachable, CORRECT state (the value type doesn't affect kops_table_name) and
// must not be misreported as unsolved. tc_is_unbound_metavar (not a bare kind
// check) is deliberate too: it excludes both a real TyKind.Typevar and the shared
// TYPE_UNKNOWN singleton, so neither is slandered as "unsolved" by this gate.
// Returns 0 — "no evidence", not "proof of a solved slot" — for a non-Map/Set
// tid, an out-of-range tid, or a container mismatch: absence of an unsolved
// metavar is not the same claim as absence of an answer.
pub fn tc_tid_kops_slot_unsolved(tid: Int, container: Str) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return 0 }
    let t = ty_pool.get(tid).unwrap()
    let want_kind = if container == "Map" { TyKind.Map } else { TyKind.Set }
    if t.kind != want_kind { return 0 }
    tc_is_unbound_metavar(tc_resolve(t.inner1))
}

// The raw value-slot tid for a Map tid — twin of tc_tid_map_val_struct but
// surfaces the whole slot tid (Box[Int] instance), not just the mono-name stem.
// The codegen bare-typevar CT_MAP return branch feeds this to
// mono_instance_arg_tids_from_tid so the value struct's mono instance registers
// with real arg tids, including nested value structs (Box[Box[Int]]). Same -1
// sentinel contract as tc_tid_struct_arg_tid: a non-Map tid yields -1.
pub fn tc_tid_map_val_tid(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Map { return -1 }
    t.inner2
}

// The raw key-slot tid for a Map tid — twin of tc_tid_map_val_tid for the key
// slot. Same -1 sentinel contract.
pub fn tc_tid_map_key_tid(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Map { return -1 }
    t.inner1
}

// Direct-tid accessors (not inner-of-a-compound): the CT and stripped
// struct/enum name for a tid taken as-is. Used by the codegen call-site to
// reroute a generic fn's bare-typevar return off the CT_VOID that
// type_from_name(carrier_tag) produces — the substituted return
// tid memoized on the call node (tc_lookup_node_tid) carries the real shape.
// Same -1 / "" sentinel contract as the inner accessors: tc_tid_ct returns -1
// for a tid tk_to_ct can't map to concrete storage (typevar/tuple/fn/unknown),
// and tc_tid_struct returns "" unless the tid is itself a struct/enum.
//
// THIS FUNCTION IS DELIBERATELY NON-RESOLVING, and that is load-bearing. It reads
// ty_pool.get(tid).kind directly, so a metavar that tc_pin_generic_args_from_binds
// bound IN PLACE (kind stays TyKind.Unknown, solution stashed in inner1) reads back
// TyKind.Unknown -> CT_VOID -> -1. Callers here depend on that -1: a bound-but-typevar
// tid must not masquerade as concrete storage. A caller that instead wants the real
// ct of a bound `a_k := Int` composes tc_tid_resolved with this, or uses one of the
// surviving resolving twins — tc_tid_set_elem_ct_resolved /
// tc_tid_map_key_ct_resolved (live at src/codegen_expr.bl:2607, the kops ctor).
// A direct resolving twin of THIS function existed and was deleted with its last caller;
// re-adding one is fine, folding resolution INTO this function is not.
//
// TRAP, and the reason this warning lives here rather than only at the seam: do NOT
// key a struct-slot admission gate on a CT at all. tk_to_ct maps TyKind.Void, TyKind.Typevar
// and TyKind.Unknown all onto CT_VOID, so a CT-keyed slot gate admits unsolved
// metavars as if they were a genuine Void — a Void/erasure inversion this gate must
// not reintroduce. Slot gates key on the KIND (tc_struct_slot_encodable); the same
// trap is restated at the seam itself, src/codegen_expr.bl:5669-5672.
pub fn tc_tid_ct(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let ct = tk_to_ct(ty_pool.get(tid).unwrap().kind)
    if ct == CT_VOID { return -1 }
    ct
}

// The resolved tid itself, so a codegen caller can compose the NON-resolving
// accessors above on a bound metavar without needing a resolving twin of each.
// -1 for an out-of-range input; otherwise tc_resolve's result, which is the identity
// on everything that is not a bound metavar (concrete types, typevars, TYPE_UNKNOWN,
// unbound metavars) and otherwise the solution it steps to. That is in-range unless a
// bound metavar's inner1 points outside the pool, which would be a pool-invariant
// violation, so callers get the same -1/in-range discipline as the accessors above.
fn tc_channel_elem_tid(chan_tid: Int) -> Int {
    let t = tc_tid_resolved(chan_tid)
    if t < 0 { return -1 }
    if tc_tid_kind(t) != TyKind.Channel { return -1 }
    if tc_tid_child_count(t) < 1 { return -1 }
    tc_tid_resolved(tc_tid_child(t, 0))
}

// The CT of a tid when a bare CT is a COMPLETE answer for it, and -1 when it is not — in
// which case the caller must keep its existing flat behaviour rather than trade one wrong
// answer for another. The gate and the answer are the same function on purpose: a kind that
// this cannot spell cannot be claimed as supported somewhere else. The match is exhaustive so
// a kind added later fails to compile here instead of falling through to a plausible CT.
//
// The rule dividing the arms is one line: a bare CT is complete exactly when the type's C
// spelling does not depend on children. Everything with children (List, Map, Set, Option,
// Result, Tuple, Ptr, and a generic struct/enum instance) needs metadata that only the flat
// side channels or the mono registry carry, so answering CT_LIST for a `List[Foo]` would move
// the wrong element type one level DOWN rather than fix it. Those decline.
//
// Two callers, one for a Channel's element and one for a Ptr's pointee. They ask the
// same question about a different child, so they share the answer rather than keeping
// two copies that can drift apart.
fn tc_tid_byvalue_ct(tid: Int) -> Int {
    let e = tc_tid_resolved(tid)
    if e < 0 { return -1 }
    let k = tc_tid_kind(e)
    // A struct or a data enum travels as its typedef, by value. A GENERIC instance is
    // excluded: its C name is the monomorphised spelling that only the mono registry can
    // produce, and emitting `blink_Box` for a `Box[Int]` element would name a type that was
    // never emitted. tc_tid_child_count reports 0 for a non-generic struct/enum and the arg
    // count for an instance, so the test is exact.
    if k == TyKind.Struct || k == TyKind.Enum {
        if tc_tid_child_count(e) != 0 { return -1 }
        if tc_tid_struct(e) == "" { return -1 }
        return CT_STRUCT
    }
    match k {
        TyKind.Int => CT_INT
        TyKind.Float => CT_FLOAT
        TyKind.Bool => CT_BOOL
        TyKind.Str => CT_STRING
        TyKind.Char => CT_CHAR
        TyKind.I8 => CT_I8
        TyKind.I16 => CT_I16
        TyKind.I32 => CT_I32
        TyKind.U8 => CT_U8
        TyKind.U16 => CT_U16
        TyKind.U32 => CT_U32
        TyKind.U64 => CT_U64
        // Two runtime handles with no element of their own, so nothing is lost by carrying
        // them: the value IS the handle and a bare CT describes it completely.
        TyKind.Bytes => CT_BYTES
        TyKind.StringBuilder => CT_STRINGBUILDER
        // The children cases. The VALUE travels fine — a `blink_list*` is a `blink_list*`
        // however it is reached; what does not travel is its own element/key/value metadata,
        // which lives in flat side fields that neither a `recv()` result nor a `deref()`
        // rvalue has any way to carry. Claiming these would move a wrong element type ONE
        // LEVEL DOWN rather than fix it, so they stay with the fallback until c_type_from_tid
        // makes the whole tree spellable at every consumer.
        //
        // TyKind.Ptr is in this list for that reason and not because a pointer is not a
        // by-value thing: `Ptr[Ptr[Int]]` derefs to a perfectly good pointer, but the pointee
        // of THAT pointer has nowhere to go, so the next `.deref()` would be back to
        // guessing. What the declared shape of a nested pointer should be is a spec question.
        TyKind.List => -1
        TyKind.Map => -1
        TyKind.Set => -1
        TyKind.Option => -1
        TyKind.Result => -1
        TyKind.Tuple => -1
        TyKind.Ptr => -1
        TyKind.Fn => -1
        TyKind.Handle => -1
        TyKind.Channel => -1
        TyKind.Iterator => -1
        TyKind.Template => -1
        // The one kind in this list that declines for a reason of its own rather than for a
        // child's sake: a handler's C spelling is `blink_io_vtable*` / `blink_ue_<h>_vtable*`,
        // chosen from the EFFECT, and a bare CT_HANDLER names none of them. The flat path
        // keeps this one because the vtable type name is what its `sname` slot holds.
        TyKind.Handler => -1
        TyKind.FfiScope => -1
        // Nothing to carry. `Channel[Void]` is not a thing, an unresolved metavar or a typevar
        // means the type is not known YET, and a bare `Channel(n)` reaches here through
        // TyKind.Unknown — that spelling names no element and is an inference task, not a
        // hole in this function. Void as a POINTEE is the deliberate `Ptr[Void]` opaque
        // handle, whose `void*` the flat path already prints.
        TyKind.Void => -1
        TyKind.Typevar => -1
        TyKind.Unknown => -1
        // Handled above, ahead of the match, because both need the arity test.
        TyKind.Struct => -1
        TyKind.Enum => -1
    }
}

pub fn tc_channel_elem_ct(chan_tid: Int) -> Int {
    tc_tid_byvalue_ct(tc_channel_elem_tid(chan_tid))
}

// The bare struct/enum name behind a CT_STRUCT element; "" for every other element. Paired
// with tc_channel_elem_ct — a caller that reads CT_STRUCT must read this too, or it has a
// nameless struct.
pub fn tc_channel_elem_struct(chan_tid: Int) -> Str {
    tc_tid_struct(tc_channel_elem_tid(chan_tid))
}

// ── Pointer pointee type, for `Ptr.deref()` ───────────────────────────────────────────
//
// `deref` hard-coded `expr_result_type = CT_INT`, so `*(p)` was an int64_t whatever p pointed
// at: `Ptr[Float]` truncated 1.5 to 1 with exit 0 and no diagnostic, and a struct pointee did
// not compile (`int64_t v = (*(s));`). Same shape as the channel pair above — the type was in
// the tid the whole time, and the pointee reached codegen only through the `let` annotation.
//
// Answers the pointee's CT, or -1 when a bare CT is not a complete answer for it, in which
// case the caller keeps CT_INT. This does NOT decide whether `.deref()` is spec'd as `T` or as
// `Option[T]` (sections/07_trust_modules_metadata.md:217 says the latter, codegen and
// lib/std/libc.bl the former) — that is a separate spec question, and publishing the pointee
// is orthogonal to it.
fn tc_ptr_pointee_tid(ptr_tid: Int) -> Int {
    let t = tc_tid_resolved(ptr_tid)
    if t < 0 { return -1 }
    if tc_tid_kind(t) != TyKind.Ptr { return -1 }
    if tc_tid_child_count(t) < 1 { return -1 }
    tc_tid_resolved(tc_tid_child(t, 0))
}

pub fn tc_ptr_pointee_ct(ptr_tid: Int) -> Int {
    tc_tid_byvalue_ct(tc_ptr_pointee_tid(ptr_tid))
}

// The bare struct/enum name behind a CT_STRUCT pointee; "" otherwise. Paired with
// tc_ptr_pointee_ct exactly as tc_channel_elem_struct is with tc_channel_elem_ct: a caller
// that reads CT_STRUCT must read this too, or it has a nameless struct.
pub fn tc_ptr_pointee_struct(ptr_tid: Int) -> Str {
    tc_tid_struct(tc_ptr_pointee_tid(ptr_tid))
}

// ── Stage 3: the C type of a tid, spelled recursively ────────────────────────────────
//
// The one function the collapse is FOR (decisions/compiler-type-representation.md Q2 step 5,
// 5-0; docs/plans/2026-08-11-tid-collapse-stage2-divergence-map.md Stage 3). Codegen's
// c_type_str is a flat `if` chain over a single CT_* integer, so it can only answer types
// whose C spelling does not depend on their children — and every type whose spelling DOES
// depend on its children (Option, Result, Tuple, Ptr) needs a separate side channel carrying
// the child, which is what the flat (CT_*, sname) pair cannot hold past depth 1 and what
// generated the whole bug family. This reads the children off the interned tree instead, so
// the depth is whatever the type actually has.
//
// THE DECLINE IS PART OF THE ANSWER, not an error path. "" means "this function cannot spell
// this tid faithfully", and a caller must then keep whatever it does today rather than trade
// one wrong C type for another — the same contract, for the same reason, as
// tc_channel_elem_ct's -1 above. Four things decline:
//
//   - A GENERIC struct/enum INSTANCE (`Box[Int]`, child_count != 0). Its C name is the
//     monomorphised spelling only the mono registry can produce; emitting `blink_Box` for it
//     would name a type that was never typedef'd. tc_tid_struct_mono_name owns that spelling
//     and is a separate seam.
//   - A TYPEVAR. An unsubstituted `T` has no C type; the caller must run tc_tid_subst_mono
//     first, and if that left a typevar the type is genuinely not yet known.
//   - An UNKNOWN (an unbound metavariable). Per DECISIONS.md:342 this must never
//     acquire a silent default — but the ICE is the AUTHORITATIVE caller's decision (I0001 at
//     the emit site), not this function's, so it declines rather than fabricating either a
//     spelling or a sentinel that would then be emitted as C.
//   - A compound whose tag speller answered an ICE_SEG_* sentinel, collapsed rather than
//     interpolated for the reason tc_tid_tag_at documents at length.
//
// A Ptr NEVER declines: its pointee is dropped to `void*` exactly as ptr_inner_c_type's own
// `_ => "void"` fallback already does, so the two agree on an unspellable pointee instead of
// this one going quiet.
//
// A Map is spelled from its KIND alone, not through its tag, because every Map lowers to the
// single runtime type blink_map* regardless of key and value (c_type_c_name_in says so
// explicitly). Routing it through the tag would make `Map[Str, T]` decline over an
// unresolved T that the C type does not depend on.
//
// WHAT THIS ANSWERS IS THE LOGICAL TYPE, and three POSITIONS have a physical rule that overrides
// it. A caller in one of them must not take this answer:
//   - storage — a genuine `void` local is illegal C, so a declaration keeps its placeholder
//   - a struct field / Result leaf — c_field_type_str owns that rule
//   - the body of a handler implementation — the physical type is the effect vtable slot's
//     erased spelling (`blink_Option_ptr` for an `Option[Item]`), and the call site converts
// Every such caller guards on its own; this function cannot see the position it is asked from.
pub fn c_type_from_tid(tid: Int) -> Str {
    let t = tc_tid_resolved(tid)
    if t < 0 { return "" }
    let k = tc_tid_kind(t)
    if k == TyKind.Struct || k == TyKind.Enum {
        // A monomorphized INSTANCE (`Box[Int]`, `Tree[Int]`) is spelled from its args, not
        // declined. tc_tid_struct_mono_name is the stem producer that is already byte-matched
        // to the def side's mangle_generic_name, so this position adds only the `blink_`
        // prefix — the same division of labour as the Option/Result/Tuple arm below, and for
        // the same reason: a second spelling here could drift from the typedef the emitters
        // registered, and a stem that drifts is a reference to a C symbol that was never
        // emitted rather than a wrong value.
        //
        // It declines on its own terms — a bare generic base (no args, which falls through to
        // the by-name spelling below), an unsubstituted typevar in a slot, or a
        // module-qualified head, which it defers on deliberately because tc_tid_to_c_tag
        // strips the qualifier and would diverge from the string path's file-derived prefix.
        // An ICE seg is collapsed rather than interpolated, matching the Option/Result/Tuple
        // arm: buried mid-identifier it would slip past diag_is_ice_seg at the downstream
        // chokepoints.
        if tc_tid_child_count(t) != 0 {
            let stem = tc_tid_struct_mono_name(t)
            if stem == "" { return "" }
            if diag_is_ice_seg(stem) { return "" }
            return "blink_{stem}"
        }
        // Transparent-alias hop, mirroring tc_tid_tag_at's twin alias hop: `type Port = Int`
        // lowers to a bare int64_t (project_type_alias_param_lowering), so the alias name must
        // resolve to the underlying type's spelling and not to a `blink_Port` typedef that is
        // never emitted.
        let underlying = tc_resolve_transparent_alias_name(tc_tid_name(t))
        if underlying != -1 { return c_type_from_tid(underlying) }
        let nm = tc_tid_struct(t)
        if nm == "" { return "" }
        // A transparent NEWTYPE is a different construct from the alias above — `type
        // Errno(Int)` is a real single-variant enum declaration that nonetheless lowers to a
        // bare int64_t everywhere, by panel decision ("transparent / zero-cost").
        // tc_alias_underlying has no entry for it, so the hop above cannot see it, and
        // spelling it `blink_Errno` would name the boxed tagged struct the transparency
        // decision exists to avoid. is_transparent_newtype is the codegen-side gate (name AND
        // shape) and is consulted rather than re-derived, so the two cannot drift apart.
        if is_transparent_newtype(nm) != 0 { return "int64_t" }
        return c_type_c_name(nm)
    }
    // The per-instantiation carrier typedefs. tc_tid_inner_tag is already the recursive
    // structural speller for these (Option_str, Result_int_str, Tuple2_int_str), so this
    // position needs no second spelling — only the `blink_` prefix the emitters use.
    //
    // NOT c_type_c_name(tag): c_type_c_name routes an Option_/Result_ tag through
    // canonical_struct_tag, which SPLITS `Result_<ok>_<err>` by scanning for an underscore
    // separator. That grammar is ambiguous as soon as either half carries a module prefix
    // (which itself contains underscores), so it re-applies c_type_tag_for_struct to an
    // already-prefixed half and DOUBLES the prefix:
    // `Result_std_net_tcp_TcpSocket_std_net_error_NetError` comes back as
    // `..._std_net_error_std_net_error_NetError` — a C type that was never typedef'd.
    // tc_tid_inner_tag already emits the canonical, alias-hopped, module-qualified tag, so
    // there is nothing left to canonicalize here — only to prefix.
    // Option[@ffi.opaque] has GUARANTEED null-pointer optimization: the carrier IS a bare
    // `<cname>*` word, C NULL being the None niche, never a tagged struct (spec §9.1.4). So it
    // must be spelled directly here and NEVER routed through the tc_tid_inner_tag carrier grammar
    // below — that would spell `blink_Option_<cname>*`, folding the opaque cname into a carrier
    // identifier that no emitter declares. Result is excluded: it needs both an ok and an err
    // channel, so a single pointer word has no niche for it.
    if k == TyKind.Option {
        let inner_r = tc_tid_resolved(tc_tid_child(t, 0))
        if inner_r >= 0 {
            if tc_tid_kind(inner_r) == TyKind.Struct {
                let inner_nm = tc_tid_struct(inner_r)
                if inner_nm != "" {
                    if is_opaque_type(inner_nm) != 0 { return opaque_handle_c_name(inner_nm) }
                }
            }
        }
    }
    if k == TyKind.Option || k == TyKind.Result || k == TyKind.Tuple {
        let tag = tc_tid_inner_tag(t)
        if tag == "" { return "" }
        if diag_is_ice_seg(tag) { return "" }
        // A typevar INNER is the one unspellable tag that is not an ICE seg, so
        // diag_is_ice_seg above cannot catch it: tc_tid_tag_at answers a bare "<tv>" for a
        // Typevar (an unsubstituted `T` inside a generic body is normal, not an internal
        // error) and the Option/Result/Tuple arms interpolate it, giving `Option_<tv>`.
        // Prefixed, that would be `blink_Option_<tv>` — not a C identifier at all. The
        // answer is the same one the TyKind.Typevar arm below gives: an unsubstituted
        // typevar has no C type, so decline and let the caller substitute first.
        if tag.contains("<") { return "" }
        return "blink_{tag}"
    }
    if k == TyKind.Ptr {
        let pointee = c_type_from_tid(tc_tid_child(t, 0))
        if pointee == "" { return "void*" }
        return "{pointee}*"
    }
    // A handler's C type is the VTABLE STRUCT of its effect. resolve_effect_vtable reads
    // codegen's `ue_effects` registry, and typecheck importing codegen_types (not the reverse)
    // is the import direction that makes the call LEGAL: this function already reaches
    // c_type_c_name and is_transparent_newtype across the same edge, so resolve_effect_vtable
    // is consulted here rather than reimplemented, the same discipline the transparent-newtype
    // arm above follows.
    //
    // The registry being populated DURING codegen is not a hazard either, for the reason it is not
    // one for is_transparent_newtype: every caller of this function is a codegen emit site or the
    // ctypediv probe that runs alongside them, so no caller can observe the empty registry. If one
    // ever did, the effect would resolve to no vtable and this declines — which is the correct
    // answer for "I cannot spell this yet" rather than a wrong C type.
    if k == TyKind.Handler {
        let vt = resolve_effect_vtable(tc_tid_handler_effect(t))
        if vt == "" { return "" }
        return "{vt}*"
    }
    // Exhaustive on purpose: a kind added later fails to COMPILE here rather than falling
    // through to a plausible-wrong C type, which is the whole reason Stage 0 made TyKind a
    // real enum. Every spelling below is the one c_type_str already answers for the
    // corresponding CT_*, verified against emitted C rather than read off the table.
    match k {
        TyKind.Int => "int64_t"
        TyKind.Float => "double"
        TyKind.Bool => "int"
        TyKind.Str => "const char*"
        TyKind.Char => "int32_t"
        TyKind.I8 => "int8_t"
        TyKind.I16 => "int16_t"
        TyKind.I32 => "int32_t"
        TyKind.U8 => "uint8_t"
        TyKind.U16 => "uint16_t"
        TyKind.U32 => "uint32_t"
        TyKind.U64 => "uint64_t"
        TyKind.List => "blink_list*"
        TyKind.Map => "blink_map*"
        TyKind.Set => "blink_set*"
        TyKind.Bytes => "blink_bytes*"
        TyKind.StringBuilder => "blink_sb*"
        TyKind.Template => "blink_template*"
        TyKind.Handle => "blink_handle*"
        TyKind.Channel => "blink_channel*"
        TyKind.Iterator => "void*"
        TyKind.FfiScope => "blink_list*"
        // A closure travels as the runtime closure box, which is what CT_CLOSURE spells.
        TyKind.Fn => "blink_closure*"
        // A GENUINE Void, answered deliberately (the twin of tc_tid_tag_at's TyKind.Void
        // arms). `void` is legal in a return position and illegal in a storage position;
        // c_field_type_str owns that second rule, and a caller in a storage position must
        // keep routing through it rather than expecting this to guess the position.
        TyKind.Void => "void"
        TyKind.Typevar => ""
        TyKind.Unknown => ""
        // All five handled above, ahead of the match.
        TyKind.Handler => ""
        TyKind.Ptr => ""
        TyKind.Option => ""
        TyKind.Result => ""
        TyKind.Tuple => ""
        TyKind.Struct => ""
        TyKind.Enum => ""
    }
}

// The C function-pointer cast a closure CALL needs, spelled from the tid — "" when the
// tid does not name a Fn, or names one whose return or a parameter has no C spelling.
//
// c_type_from_tid answers `blink_closure*` for a Fn, which is the type of the closure BOX and is
// all a declaration needs. A call needs one thing more: the callee's own signature, because a
// closure is invoked as `((sig)cls->fn_ptr)(cls, args...)`. Codegen had two builders for that
// string and both read an AST TYPE ANNOTATION — the `fn(Int) -> Int` node on the literal or on the
// binding. A binding whose initializer is a method call carries no such node
// (`let h = fs.get(0).unwrap()`), so the sig came back "" and the call fell through to codegen's
// UndefinedFunction backstop: a closure the type checker had fully typed was reported as an
// undefined FUNCTION, naming the variable.
//
// The `const blink_closure*` leading parameter is the closure's own self pointer and is part of
// the ABI, not of the Blink type — every emitter of a closure body writes it, so it is prepended
// here rather than derived, exactly as both annotation-driven builders do.
//
// DECLINES rather than half-spelling, and the decline is the safety property: this string is a
// CAST through which the call is made, so a parameter spelled `void` (or an unsubstituted typevar,
// which c_type_from_tid answers "" for) would produce a cast that either fails to compile or —
// worse — compiles against the wrong ABI. "" leaves the caller on whatever it did before.
pub fn closure_sig_from_tid(tid: Int) -> Str {
    if tid < 0 { return "" }
    let t = tc_tid_resolved(tid)
    if tc_tid_kind(t) != TyKind.Fn { return "" }
    // Child 0 is the return and the params follow it (tc_tid_child's Fn arm).
    let ret_c = c_type_from_tid(tc_tid_child(t, 0))
    if ret_c == "" { return "" }
    let mut sig_params = "const blink_closure*"
    let n = tc_tid_child_count(t)
    let mut i = 1
    while i < n {
        let p_c = c_type_from_tid(tc_tid_child(t, i))
        if p_c == "" { return "" }
        // Legal in the return position above, never in a parameter position.
        if p_c == "void" { return "" }
        sig_params = sig_params.concat(", ").concat(p_c)
        i = i + 1
    }
    "{ret_c}(*)({sig_params})"
}

// The mono-INSTANCE spelling of a generic-ENUM tid, or "".
//
// Narrower than c_type_from_tid on purpose, and the narrowness is the safety property: it
// answers only for an enum tid that carries type args, so a caller can let it lead without
// taking any other enum binding away from the flat spelling that already owns it — an ordering
// constraint restated as a gate instead of an arm order. The one thing it corrects is the bare
// generic base, which has no typedef of its own and so is a reference to a C symbol that was
// never emitted.
//
// Lives here rather than in codegen because three separate emitters need the same answer for one
// binding — the local's declaration, the variant construction's compound-literal cast, and the
// match scrutinee's temp — and a per-file copy of this gate is how a cell grows a fourth spelling
// that disagrees with the other three.
pub fn enum_instance_c_from_tid(tid: Int) -> Str {
    if tid < 0 { return "" }
    let r = tc_tid_resolved(tid)
    if tc_tid_kind(r) != TyKind.Enum { return "" }
    if tc_tid_struct_arg_count(r) == 0 { return "" }
    c_type_from_tid(r)
}

// The struct twin, same gate and same narrowness: it answers only for a struct tid carrying
// type args, so it corrects the bare generic base — a C symbol that was never typedef'd — and
// takes no other struct binding away from the by-name spelling that already owns it.
pub fn struct_instance_c_from_tid(tid: Int) -> Str {
    if tid < 0 { return "" }
    let r = tc_tid_resolved(tid)
    if tc_tid_kind(r) != TyKind.Struct { return "" }
    if tc_tid_struct_arg_count(r) == 0 { return "" }
    c_type_from_tid(r)
}

// Monomorphized-struct-instance accessors. Read the concrete
// type-args of a struct-instance tid built by make_struct_instance_type — the
// `Box[Int]` shape stored variadically in ty_param_list[params_start..]. These
// are the OFF-PATH seam the later reader-switch increments consume; nothing on
// the emit path calls them yet. Same -1 / "" sentinel contract as the inner
// accessors above: a non-struct tid, an out-of-range idx, or a generic base
// (params_count 0) yields 0 / -1 / "". A count of 0 distinguishes the bare
// generic base (`Box`) from an instance (`Box[Int]`, count 1).
pub fn tc_tid_struct_mono_name(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    // TyKind.Enum admitted: a generic-enum INSTANCE (`Tree[Int]`) spells the same
    // mono stem as a struct instance — c_type_tag_for_struct(base) + `_`-joined slot
    // segs — since both the head tag and tc_tid_struct_slot_seg are kind-agnostic. This
    // is what lets tc_tid_to_c_tag's shared TyKind.Struct|TyKind.Enum branch produce `Tree_Int`.
    // The 3 sibling gates (tc_tid_encodable / tc_tid_tuple_elem_faithful /
    // tc_struct_slot_encodable) admit an enum instance too, so widening this fn stays
    // in lockstep with them.
    if (t.kind != TyKind.Struct && t.kind != TyKind.Enum) || t.params_count == 0 { return "" }
    // escape_mono_seg on the base and every slot segment, and join with "_0" rather
    // than a bare "_", so this stem is byte-identical to what mangle_generic_name
    // (codegen_types.bl) produces for the same (base, args) — this fn is an
    // independent producer of a struct/enum mono instance's C name (the def side goes
    // through mangle_generic_name; this is a use-side producer feeding generic-fn return
    // type resolution). Def side and use side disagreeing on a mono name is a hard `cc`
    // failure (the def side's typedef and this fn's reference to it stop naming the
    // same C symbol) the moment either side's input contains an underscore.
    let mut result = escape_mono_seg(c_type_tag_for_struct(t.name))
    let mut i = 0
    while i < t.params_count {
        let slot = ty_param_list.get(t.params_start + i).unwrap()
        let seg = tc_tid_struct_slot_seg(slot)
        if seg == "" { return "" }
        // Collapse, never interpolate: tc_tid_struct_slot_seg can answer a bare
        // ICE_SEG_* sentinel (e.g. a TyKind.Fn slot via tc_tid_to_c_tag's unhandled-kind
        // arm). Concatenating it here would bury it mid-identifier (Box_int_BLINK_I0001_...),
        // past where diag_is_ice_seg's prefix test at the downstream chokepoints can see it,
        // the same hazard as for Option/Result/Map/Tuple, one struct level down.
        if diag_is_ice_seg(seg) { return seg }
        result = result.concat("_0").concat(escape_mono_seg(seg))
        i = i + 1
    }
    result
}

// The CSV segment a struct-instance arg SLOT contributes to the mono name: the
// full recursive stem for a nested struct instance (Box_Int), else the plain tag
// (Str/Int/Option_int) when the slot is faithfully encodable. Returns "" for an
// unencodable slot (unsubstituted typevar, module-qualified struct/enum) so both
// the codegen name-builder (tc_tid_struct_mono_name) and the def-side typedef
// registrar (register_struct_instance_from_tid) DEFER identically to the string
// path. Kept pub so codegen can gate without reaching the private
// tc_tid_encodable.
pub fn tc_tid_struct_slot_seg(slot: Int) -> Str {
    let nested = tc_tid_struct_mono_name(slot)
    if nested != "" { return nested }
    if !tc_tid_encodable(slot) { return "" }
    tc_tid_to_c_tag(slot)
}

// Whether a struct-instance ARG SLOT tid can be lowered by tc_tid_to_c_tag to a
// CSV segment that byte-matches the carrier the field VALUE emits. This is the
// compound analogue of tc_struct_slot_encodable (which governs the fn-arg slot
// path): here a compound (Option/Result/Map) whose inners are all scalars is
// ADMITTED, because tc_tid_to_c_tag then produces exactly the blink_Option_int /
// blink_Result_int_str carrier the field value registers. REJECTED:
//   - a compound whose inner is itself a struct/enum or another compound
//     (`Option[Box[Int]]`, `Option[Option[Int]]`): can diverge in the field-value
//     registration path; defer.
//   - a bare scalar slot: handled by the existing string path unchanged.
//
// A TUPLE slot is admitted, gated on tc_tid_tuple_elem_faithful — the SAME
// predicate the sibling gate tc_struct_slot_encodable uses for its own
// TyKind.Tuple arm, since tc_tid_to_c_tag's tuple spelling (tc_tid_tuple_tag ->
// Tuple2_int_int) byte-matches the struct-lit string path's registered tuple
// carrier segment.
//
// Permissive (tc_tid_tuple_elem_faithful) rather than scalar-elements-only, because both
// of the other halves of this seam are ALREADY permissive: the def side
// (tc_tid_struct_slot_seg -> tc_tid_encodable) and the parallel arg_tids recovery
// (mono_instance_arg_tids_from_tid -> tc_struct_slot_encodable). An asymmetric
// literal-side gate would recreate the same bail for shapes the compiler can spell
// on both other sides — and tc_tid_tag_at's TAGPOS_INNER arm already erases
// TyKind.List/TyKind.Set/TyKind.Bytes identically for all three, so `(Int, List[Str])` byte-matches
// everywhere.
//
// A STRUCT-OR-ENUM-INSTANCE slot is admitted iff tc_tid_struct_mono_name spells it —
// the very predicate the def-side slot speller (tc_tid_struct_slot_seg) and the
// mono registrar already consult first, so admitting on it cannot split the name
// from the typedef. The BARE generic base (params_count 0) is unaffected — its
// mono name is "" — and so is every already-working shape, because the string tier
// is consulted before this one at the mono_args selector.
pub fn tc_tid_inner_tag_faithful(tid: Int) -> Bool {
    if tid < 0 || tid >= ty_pool.len() { return false }
    // Exactly the scalar leaves (tc_tid_scalar_only) plus List/Set/Bytes — composed,
    // not re-enumerated, so a new scalar kind stays in lockstep with the scalar gate.
    if tc_tid_scalar_only(tid) { return true }
    let t = ty_pool.get(tid).unwrap()
    let k = t.kind
    if k == TyKind.List || k == TyKind.Set || k == TyKind.Bytes { return true }
    // The value path recurses (emit_tuple_lit reads the element tid and spells the
    // inner via the SAME tc_tid_inner_tag the tid path uses), so a Map inner
    // or a nested Option/Result inner is faithful WHENEVER its own leaves are faithful.
    // Recurse structurally — a Map key/val or an Option/Result sub-inner must each be
    // faithful, so the recursion bottoms out at scalar/List/Set/Bytes leaves and rejects
    // any struct/enum/tuple/typevar leaf (still spelled divergently, still deferred).
    if k == TyKind.Map { return tc_tid_inner_tag_faithful(t.inner1) && tc_tid_inner_tag_faithful(t.inner2) }
    if k == TyKind.Option { return tc_tid_inner_tag_faithful(t.inner1) }
    if k == TyKind.Result {
        // A Result carrier with a DIRECT Map ok/err side is faithful: the construction/
        // param/reassignment speller spells the Map side STRUCTURED
        // (Result_Map_str_int_int, identical C layout → assignment stays legal) rather
        // than the BARE "map" upgrade_compound_carrier would otherwise use for
        // uniform-blink_map* assignment compat, so it rides the tid path. Recurse
        // structurally — the Result's sides must each be faithful (a Map side bottoms
        // out at faithful scalar/List/Set/Bytes key/val), rejecting only a
        // struct/enum/tuple/typevar leaf.
        return tc_tid_inner_tag_faithful(t.inner1) && tc_tid_inner_tag_faithful(t.inner2)
    }
    // A BARE (params_count 0) struct/enum leaf is faithful. When the enclosing
    // Option/Result rides, emit_tuple_lit spells the inner via tc_tid_inner_tag
    // (codegen_expr.bl ~5626/5633) — the EXACT same speller the tid path uses — and for a bare
    // struct/enum that bottoms out at c_type_tag_for_struct on BOTH the value carrier and the
    // generic-fn mono param, byte-identical by construction. This is the same equivalence a
    // DIRECT (non-wrapped) bare-struct tuple element relies on; the Option/Result-wrapped
    // bare leaf reuses it since the ride branch delegates to the same function rather than the
    // divergent canonical_struct_tag fallback. Module qualifier is a non-issue: both sides call
    // tc_tid_inner_tag on the SAME tid, so they agree whatever it spells.
    //
    // A struct INSTANCE leaf (params_count != 0, e.g. QBox[Int]) is FAITHFUL too. When the
    // enclosing Option/Result rides, emit_tuple_lit spells the inner via tc_tid_inner_tag,
    // whose struct/enum arm returns tc_tid_struct_mono_name (the mono stem QBox_Int) —
    // byte-identical to the tid-path carrier (blink_Option_QBox_Int). The annotation-lowering
    // sites thread the mono stem and register the instance
    // (register_carrier_inner_mono_instance), so both paths converge on the single
    // blink_Option_QBox_Int (blink_QBox_Int* value) rather than a divergent bare
    // blink_Option_QBox carrier (void*/undeclared-blink_QBox member).
    //
    // A generic-enum INSTANCE (TyKind.Enum, params_count != 0) is admitted alongside
    // TyKind.Struct: the encodable gates (tc_tid_encodable, tc_struct_slot_encodable) already
    // spell it via tc_tid_struct_mono_name (Tree_Int), so it rides the tid path exactly like a
    // struct instance.
    if t.params_count != 0 {
        if k == TyKind.Struct || k == TyKind.Enum { return true }
        // Counterfactual probe: every DECLINE here is a slot that stays on the string CSV
        // path today. If a future caller routed it onto the tid path instead, this records
        // whether tc_tid_inner_tag would have silently spelled it "void" (a give-up) rather
        // than a real name — the erasure this gate currently prevents by declining, not by
        // detecting. Never changes the `false` returned above.
        voidtwin_probe("faithful_reject_paramcount", tid)
        return false
    }
    if k == TyKind.Struct || k == TyKind.Enum { return true }
    voidtwin_probe("faithful_reject", tid)
    false
}

// True iff `tid` is a plain scalar (int/float/bool/str/char/sized-int) — the shapes
// whose tc_tid_inner_tag is a lowercase Pascal tag that matches the carrier the
// field value emits. Excludes struct/enum (name erasure), compounds (nesting), and
// list/set/bytes/tuple (carrier spelling divergence).
fn tc_tid_scalar_only(tid: Int) -> Bool {
    if tid < 0 || tid >= ty_pool.len() { return false }
    let k = ty_pool.get(tid).unwrap().kind
    if k == TyKind.Int || k == TyKind.Float || k == TyKind.Bool || k == TyKind.Str || k == TyKind.Char { return true }
    if k == TyKind.I8 || k == TyKind.I16 || k == TyKind.I32 { return true }
    if k == TyKind.U8 || k == TyKind.U16 || k == TyKind.U32 || k == TyKind.U64 { return true }
    false
}

// Returns the mangled tuple carrier name (Tuple2_int_str) for a TyKind.Tuple tid,
// else "" (same sentinel contract as tc_tid_struct). A Set[(Int,Str)] element
// (or Map tuple key) reached through a tuple/struct-field boundary erases to
// CT_STRING (recover_elem_ct_from_arg's erased default); codegen recovers the
// concrete tuple element from the argument node's memoized tid. For SCALAR tuple
// elements the tag equals resolve_tuple_ann's tuple_c_type_name (tc_tid_tag_at's
// TAGPOS_INNER arm ≡ c_type_tag), so the recovered sname aliases the kops-struct
// carrier the Set's construction registered in derive_hash_types. Tuple elements
// that are themselves module-qualified structs/enums can diverge from
// resolve_tuple_ann's c_type_tag_for_struct spelling; recover_elem_ct_from_arg's
// kops_is_struct_key guard turns any such miss into a safe no-op (never a
// miscompile).
pub fn tc_tid_tuple_sname(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Tuple { return "" }
    tc_tid_tuple_tag(t)
}

// Tuple element-tid accessors so codegen can recurse a tuple's struct-instance
// elements back through register_struct_instance_from_tid — a tuple element that
// is a generic-struct instance (`(PBox[Int], Int)`) appearing only as a param/
// return type is otherwise never registered, so its by-value member type
// blink_PBox_Int is never typedef'd. Return -1 / 0 on kind mismatch.
pub fn tc_tid_tuple_arity(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return 0 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Tuple { return 0 }
    t.params_count
}

pub fn tc_tid_tuple_elem_tid(tid: Int, idx: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Tuple { return -1 }
    if idx < 0 || idx >= t.params_count { return -1 }
    ty_param_list.get(t.params_start + idx).unwrap()
}

// Option/Result inner-shape accessors over a tid, for the call-site fix. Mirror
// tc_tid_set_elem_ct's kind-guard + inner-accessor pattern. inner1 = Option
// value / Result Ok; inner2 = Result Err. Return the inner's CT (-1 sentinel)
// and stripped struct/enum name (""), so the codegen call-site can populate the
// expr_* carrier globals exactly as the annotation path does.
pub fn tc_tid_option_inner_ct(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Option { return -1 }
    tid_inner_ct(t.inner1)
}

// An inferred Option value slot can be a metavar bound by a later assignment
// (kind Unknown, inner1 -> the solution); the bare tid_inner_ct declines it (-1),
// so resolve the inner before taking its CT. Mirrors tc_tid_result_ok_ct_resolved.
pub fn tc_tid_option_inner_ct_resolved(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Option { return -1 }
    tid_inner_ct(tc_resolve(t.inner1))
}

// The element tid of a List tid, or -1 when the tid is not a List. Lets codegen
// project a receiver List[T]'s element tid without reaching into ty_pool (the
// poly-impl arg-tid path).
// Resolve both the list tid and its element: an inferred list's element is a
// metavar bound by a later `push`, and codegen must see the binding, not the α.
pub fn tc_tid_option_inner_struct(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Option { return "" }
    tid_inner_struct(t.inner1)
}

// Pure-mono-stem struct name for an Option's inner: answers "" (not the erased bare
// head) when the mono stem can't be spelled, so a variable accessor's flat sname
// channel stays authoritative in the erased generic-fn-return case. Mirrors
// tc_tid_map_val_struct_mono / tc_tid_result_ok_struct_mono.
pub fn tc_tid_option_inner_struct_mono(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Option { return "" }
    tc_tid_struct_mono_name(tc_resolve(t.inner1))
}

// The Option inner as a struct/enum HEAD only (tc_tid_struct declines a tuple),
// and as a TUPLE tag — the option-inner twins of tc_tid_map_val_struct_head /
// tc_tid_map_val_tuple. They spell a plain (non-generic) struct or a tuple inner
// from the authoritative list tid, which the pure-mono stem reader declines.
pub fn tc_tid_option_inner_struct_head(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Option { return "" }
    tc_tid_struct(tc_resolve(t.inner1))
}

pub fn tc_tid_option_inner_tuple(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Option { return "" }
    tc_tid_tuple_sname(tc_resolve(t.inner1))
}

pub fn tc_tid_result_ok_ct(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Result { return -1 }
    tid_inner_ct(t.inner1)
}

// The resolved twin of tc_tid_result_ok_ct: a Result carrier born from a partial
// literal (an Ok that names only the Ok side, then back-pinned) holds its inner as
// a BOUND metavar (kind Unknown, inner1 -> the solution), which tid_inner_ct's
// bare resolve_alias_tid does not peel. Resolving the inner first recovers the CT
// the retired flat inner1 channel used to supply. Mirrors tc_tid_set_elem_ct_resolved.
pub fn tc_tid_result_ok_ct_resolved(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Result { return -1 }
    tid_inner_ct(tc_resolve(t.inner1))
}

pub fn tc_tid_result_ok_struct(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Result { return "" }
    tid_inner_struct(t.inner1)
}

pub fn tc_tid_result_err_ct(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Result { return -1 }
    tid_inner_ct(t.inner2)
}

// The resolved twin of tc_tid_result_err_ct: a mut Result born Ok pins its err slot
// to a BOUND metavar on a later `x = Err(...)`, which the bare tid_inner_ct declines.
// Resolving the inner recovers the err CT the retired flat inner2 channel supplied.
pub fn tc_tid_result_err_ct_resolved(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Result { return -1 }
    tid_inner_ct(tc_resolve(t.inner2))
}

pub fn tc_tid_result_err_struct(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Result { return "" }
    tid_inner_struct(t.inner2)
}

// Pure-mono-stem struct name for a Result's Ok/Err inner: unlike
// tc_tid_result_ok_struct/err_struct (via tid_inner_struct), this answers "" instead of
// the erased bare head when the mono stem can't be spelled, so a variable accessor's flat
// sname channel stays authoritative in the erased generic case. Mirrors
// tc_tid_map_val_struct_mono.
pub fn tc_tid_result_ok_struct_mono(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Result { return "" }
    tc_tid_struct_mono_name(tc_resolve(t.inner1))
}

pub fn tc_tid_result_err_struct_mono(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Result { return "" }
    tc_tid_struct_mono_name(tc_resolve(t.inner2))
}

// The Result Ok/Err inner as a struct/enum HEAD only (tc_tid_struct declines a
// tuple), and as a TUPLE tag — the Result twins of tc_tid_option_inner_struct_head
// / tc_tid_option_inner_tuple. They spell a plain (non-generic) struct or a tuple
// inner from the authoritative list tid, which the pure-mono stem reader declines,
// so a push-built List[Result[Point, Str]] recovers its erased struct side.
//
// The head answers ONLY for a bare struct/enum (params_count 0): a generic instance
// (Box[Int], params_count>=1) needs its mono-mangled stem, which the mono reader ran
// first and either spelled or declined — declining so the flat sname channel stays
// authoritative. Answering the bare head here would erase Box[Int] to a wrong "Box"
// and short-circuit that channel. This is exactly tc_tid_encodable's struct/enum arm.
// The tuple twin rejects an ICE_SEG_* tag (an unencodable tuple element) so the
// sentinel never leaks out as if it were a real name.
fn tc_tid_result_inner_struct_head(inner0: Int) -> Str {
    let inner = tc_resolve(inner0)
    if inner < 0 || inner >= ty_pool.len() { return "" }
    let it = ty_pool.get(inner).unwrap()
    if it.params_count != 0 { return "" }
    tc_tid_struct(inner)
}

fn tc_tid_result_inner_tuple(inner0: Int) -> Str {
    let s = tc_tid_tuple_sname(tc_resolve(inner0))
    if diag_is_ice_seg(s) { return "" }
    s
}

pub fn tc_tid_result_ok_struct_head(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Result { return "" }
    tc_tid_result_inner_struct_head(t.inner1)
}

pub fn tc_tid_result_err_struct_head(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Result { return "" }
    tc_tid_result_inner_struct_head(t.inner2)
}

pub fn tc_tid_result_ok_tuple(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Result { return "" }
    tc_tid_result_inner_tuple(t.inner1)
}

pub fn tc_tid_result_err_tuple(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Result { return "" }
    tc_tid_result_inner_tuple(t.inner2)
}

// Inner-TID accessors (not just ct/struct name) so codegen can recurse a carrier's
// leaves back through register_struct_instance_from_tid — needed to register a
// struct-INSTANCE leaf (RBox[Int]) nested inside an Option/Result carrier
// (Result[RBox[Int],RBox[Str]]) before the carrier typedef names it, so the member
// resolves to blink_RBox_Int rather than erasing to `void`. The tid
// carries the structured type-args (a multi-param leaf Pair[Int,Str] keeps its two
// slots), which the mono-name string tag cannot unambiguously recover. inner1 =
// Option value / Result Ok; inner2 = Result Err. Return -1 on kind mismatch.
pub fn tc_tid_option_inner_tid(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Option { return -1 }
    t.inner1
}

pub fn tc_tid_result_ok_tid(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Result { return -1 }
    t.inner1
}

pub fn tc_tid_result_err_tid(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Result { return -1 }
    t.inner2
}

// TOP-LEVEL CSV-segment form for a tid: the string that, concatenated onto a
// generic base by mangle_generic_name, reproduces the current monomorphized C
// symbol. This is the SOLE per-segment resolution, not a twin of any other
// producer, so the answers DEFINE the symbol rather than having to agree with
// something else.
// Note the asymmetry vs tc_tid_inner_tag: a top-level Map segment erases to the
// bare carrier "Map", while a Map *inside* a compound keeps its Map_<k>_<v> tag.
// Both positions are one encoder with a `tagpos` parameter
// (tc_tid_tag_at) — see that function for the full per-kind rationale. Thin
// wrapper: no caller moves, no behavior changes.
pub fn tc_tid_to_c_tag(tid: Int) -> Str {
    tc_tid_tag_at(tid, TAGPOS_TOP)
}

// Whether tc_tid_to_c_tag can faithfully encode this tid into a CSV segment that
// byte-matches the string-tag path. False (→ defer to the old path) for any tid
// tc_tid_to_c_tag would lose or poison: an unsubstituted typevar or unknown
// (mono-calls-mono; substitution happens later at codegen mono-expansion), and
// any compound whose inner is itself unencodable (a nested typevar would leak
// "<tv>" into the symbol). Struct/enum/scalar/list/set/map are all encodable at
// the top level (list/set/map erase to their bare carrier).
//
// A top-level tuple is encodable only when every element is tuple-element-safe
// (tc_tid_tuple_elem_faithful): the tid path spells a struct/enum element with the
// module qualifier STRIPPED (tc_tid_inner_tag → strip_module_qualifier) while the
// string path's c_type_tag_for_struct KEEPS the module prefix, so a tuple that
// transitively contains a struct/enum would mangle to a different symbol. Those
// still defer to the string path.
fn tc_tid_encodable(tid0: Int) -> Bool {
    // Resolve bound metavars: a pinned α is encodable iff its solution
    // is; an unbound α resolves to itself (kind TyKind.Unknown) → false (defer to the
    // string path / boundary check reports E0301).
    let tid = tc_resolve(tid0)
    if tid < 0 || tid >= ty_pool.len() { return false }
    let t = ty_pool.get(tid).unwrap()
    let k = t.kind
    // Counterfactual measurement: TyKind.Unknown declining here is exactly the
    // routing this gate provides today in INNER position — the reason tc_tid_tag_at's
    // TAGPOS_INNER TyKind.Unknown fall-through is unreachable from any gated caller. Taps
    // the would-be-erasure without changing the `false` returned below.
    if k == TyKind.Unknown {
        voidtwin_probe("encodable", tid)
    }
    if k == TyKind.Typevar || k == TyKind.Unknown { return false }
    if k == TyKind.Tuple { return tc_tid_tuple_elem_faithful(tid) }
    if k == TyKind.Option { return tc_tid_encodable(t.inner1) }
    if k == TyKind.Result { return tc_tid_encodable(t.inner1) && tc_tid_encodable(t.inner2) }
    // A struct/enum INSTANCE (params_count>=1) is admitted only when
    // tc_tid_struct_mono_name can actually spell its full recursive stem — the exact
    // guard tc_struct_slot_encodable uses: a still-generic nested
    // instance like Box[T], one level inside an outer Box[Box[T]] LITERAL, cannot, so
    // admitting unconditionally on the strength of the comment two
    // paragraphs down would be wrong — that comment holds only when
    // tc_tid_struct_mono_name's recursion SUCCEEDS. When it declines (mono_name == ""),
    // tc_tid_to_c_tag's TyKind.Struct|TyKind.Enum
    // arm falls back to the BARE head name instead of declining, so admitting here would
    // let a slot spell as a plain, wrong "Box" — which tc_tid_struct_slot_seg
    // (this function's own caller, one struct level up) would then fold into ITS OWN parent's
    // mono name as a plausible-but-unsubstituted segment, short-circuiting
    // tid_native_struct_mono's substitution retry before it gets a chance to run.
    // A BARE struct/enum (params_count 0) still admits unconditionally.
    if k == TyKind.Struct || k == TyKind.Enum {
        if t.params_count == 0 { return true }
        let name = tc_tid_struct_mono_name(tid)
        return name != "" && !diag_is_ice_seg(name)
    }
    // A MAP slot (the List twin one carrier over):
    // tc_tid_to_c_tag erases Map to the bare carrier tag "Map" with no inner
    // spelling, exactly like Set/List, and tc_tid_seg_injective already groups
    // TyKind.Map alongside TyKind.Set/TyKind.List as non-injective — so an inner gate here
    // is a refusal with no referent, the identical parity argument made
    // for List. Falls through to TyKind.Set/TyKind.List at the tail `true` below.
    // A struct/enum INSTANCE (type-args present, params_count>=1, e.g. Box[Int]) is
    // ADMITTED above once tc_tid_struct_mono_name can spell it: the
    // mono-CSV consumer (tc_seg_from_tid →
    // tc_tid_to_c_tag) recurses its args to the full mono stem (Box_Int) via
    // tc_tid_struct_mono_name, byte-matching the string path's registered mono name
    // (blink_identity_Box_Int) instead of the erased bare head (blink_identity_Box).
    // Top-level struct/enum args reach this path once a generic
    // field access on a struct instance memoizes a concrete struct tid.
    //
    // A MODULE-QUALIFIED struct/enum is ADMITTED: the mono-
    // registry physical-base split means tc_tid_to_c_tag spells a cross-module struct
    // INSTANCE via tc_tid_struct_mono_name PHYSICALLY (blink_<mod>_Box_Int) — exactly
    // the c_name register_mono_instance mints — and a bare cross-module struct as
    // its bare head, matching the string path's bare arg segment. Either way the
    // mono-CSV segment byte-matches the string path, so the module-qualifier does not
    // force a defer.
    //
    // An ENUM INSTANCE (TyKind.Enum, params_count>=1) is ADMITTED too:
    // tc_tid_struct_mono_name spells TyKind.Enum the same way (c_type_tag_for_struct
    // base + kind-agnostic slot segs → Tree_Int), so tc_tid_to_c_tag's shared
    // TyKind.Struct|TyKind.Enum branch spells the full mono stem, byte-matching the string
    // path's registered mono name — the enum twin of the struct-instance case above. A
    // slot that is itself inexpressible still bottoms out at tc_tid_struct_slot_seg ""
    // (deferred there), so nothing on the string path diverges.
    //
    // COUNTERFACTUAL MEASUREMENT. This tap ships permanently: every row is a
    // site where adding TyKind.Void to the rejection set above would flip this answer to
    // false and route a genuine Void slot onto the -1/string path. Void is an ordinary
    // INHABITED, encodable type (decisions/under-determined-types.md:38-42, 6-0), so the
    // rejection is forbidden; the number here is what makes that a measurement instead of
    // an argument. Re-measure before reopening the question.
    if k == TyKind.Void {
        dbg_trace("ctagvoid", "probe=encodable_void tid={tid} name={t.name}")
    }
    true
}

// Whether the mono-CSV segment tc_tid_to_c_tag spells for `tid` NAMES ITS OWN TYPE
// ARGUMENTS — i.e. whether that segment may be read back as per-instantiation IDENTITY, or
// only as a REPRESENTATION tag.
//
// The mono registries dedup on (base, args) with `args` a CSV of these segments, so a
// non-injective segment COLLAPSES distinct instantiations onto one entry: `fn wrap[T]`
// called at Set[Int], Set[Str] and Set[Point] spells the bare segment "Set" three times
// and shares one key, hence one stored arg_tids. That collapse is CORRECT for naming —
// all three are blink_set*, so one C function serves all three and they MUST share the
// symbol — and it is exactly why the single stored tid cannot be per-instantiation type
// info for the others. This predicate is where that boundary is stated: false means "this
// slot's tid still lowers correctly (a Set is a Set), but the registry entry it keys is
// shared, so do not read identity out of it".
//
// KEYED ON THE KIND, never on the resulting string. Pattern-matching a spelling would be
// the erased-default guessing decisions/under-determined-types.md:264-266 forbids (a user
// struct legitimately named `Set` must not answer for the builtin), and a segment cannot
// be inverted anyway — losing the element is the whole point.
//
// It is the tid-side counterpart to the STRING-side erasure detector
// mono_args_has_void_seg (codegen_expr.bl), and answers a DIFFERENT question. That one
// asks "was this slot un-nameable" (a "Void" or bare-binder segment → I0001); this one
// asks "is the name FAITHFUL". Do not fold them together: a faithless name is valid C that
// compiles and links, which is why nothing else catches it.
//
// It must NOT be used to degrade a slot to -1. A -1 arg_tid means
// genuinely UNKNOWN, and the def side spells the binder through to a hard cc error
// (codegen_methods.bl resolve_mono_slot). The tid stays — it correctly spells blink_set*
// whatever the element is — only its use as IDENTITY is refused.
pub fn tc_tid_seg_injective(tid0: Int) -> Bool {
    let tid = tc_resolve(tid0)
    if tid < 0 || tid >= ty_pool.len() { return false }
    let t = ty_pool.get(tid).unwrap()
    let k = t.kind
    // The six kinds tc_tid_to_c_tag spells as a BARE carrier tag, dropping every type
    // argument: "List", "Set", "Map", "Iterator", "Handle", "Channel". Note TyKind.Map is
    // non-injective HERE but injective as an INNER (tc_tid_inner_tag spells Map_k_v) —
    // that is why this predicate is position-aware rather than one kind set.
    if k == TyKind.List || k == TyKind.Set || k == TyKind.Map { return false }
    if k == TyKind.Iterator || k == TyKind.Handle || k == TyKind.Channel { return false }
    // Ptr spells a bare "Ptr"/"ptr" and drops the pointee, so two different pointees collide on
    // one segment. Non-injective for the same reason List and Set are.
    if k == TyKind.Ptr { return false }
    // TyKind.Bytes has no type arguments at all, so its bare "Bytes" is fully faithful — it is
    // NOT part of the erasing set even though it shares their bare spelling.
    if k == TyKind.Bytes { return true }
    if k == TyKind.Option { return tc_tid_inner_seg_injective(t.inner1) }
    if k == TyKind.Result { return tc_tid_inner_seg_injective(t.inner1) && tc_tid_inner_seg_injective(t.inner2) }
    if k == TyKind.Tuple { return tc_tid_tuple_seg_injective(t) }
    if k == TyKind.Struct || k == TyKind.Enum { return tc_tid_struct_seg_injective(t) }
    // No name to be faithful TO: a typevar spells "<tv>" and an unbound metavar spells the
    // I0001 sentinel. Neither identifies a type, so neither may be read as identity. This
    // overlaps mono_args_has_void_seg's population by design — that detector reports it
    // (as a compiler bug), this one merely refuses to trust it.
    if k == TyKind.Typevar || k == TyKind.Unknown { return false }
    // Void is refused for a different reason: "Void" is also tc_tid_to_c_tag's fallthrough
    // for every kind it has no arm for, so the segment does not distinguish the real Void
    // from an unspellable type. Never identity.
    if k == TyKind.Void { return false }
    // Scalars (Int/Float/Bool/Str/Char/sized ints) each spell a unique fixed tag.
    if k == TyKind.Int || k == TyKind.Float || k == TyKind.Bool || k == TyKind.Str || k == TyKind.Char { return true }
    if k == TyKind.I8 || k == TyKind.I16 || k == TyKind.I32 { return true }
    if k == TyKind.U8 || k == TyKind.U16 || k == TyKind.U32 || k == TyKind.U64 { return true }
    // Anything else (TyKind.Fn, any future kind) has no tc_tid_to_c_tag arm and falls through
    // to "Void" there. Fail closed: an unhandled kind is not identity.
    false
}

// The struct/enum arm, shared by both positions because both spell an instance through
// tc_tid_struct_mono_name: head tag + `_`-joined per-slot segs, where each slot seg comes
// from tc_tid_struct_slot_seg → tc_tid_to_c_tag, i.e. the TOP-LEVEL rules. So
// `Box[Set[Int]]` spells Box_Set and is non-injective through its slot.
fn tc_tid_struct_seg_injective(t: TypePoolEntry) -> Bool {
    if t.params_count == 0 {
        // A bare head. For a monomorphic type the name IS the identity. For a GENERIC base
        // reaching here with zero recorded args the same spelling drops every argument —
        // an erased-bare-head shape — so refuse it, but only on POSITIVE proof
        // from the decl: ty_pool cannot tell the two apart on its own, and a decl the
        // checker never registered (a miss) must not silently condemn every plain struct
        // arg. This is the one branch whose answer is registry-dependent rather than
        // kind-dependent; the erased-bare-head class is separately visible as
        // tc_tid_struct_mono_name returning "" (which every mono tier already treats as
        // "defer to the string path").
        let decl = tc_struct_decl_nodes.get(strip_module_qualifier(t.name)) ?? -1
        if decl == -1 { return true }
        let tparams_sl = node_type_params(decl)
        if tparams_sl == -1 { return true }
        if sublist_length(tparams_sl) != 0 { return false }
        // A bare, non-generic head normally IS the identity — but a transparent
        // `type Alias = X` alias also takes this shape, and tc_tid_to_c_tag now spells
        // it through to X's own tag (tc_resolve_transparent_alias_name) rather than the
        // alias's bare name. If X itself erases its arguments (List/Set/Map/...), this
        // predicate must say so too, or `type IntList = List[Int]` reads as injective
        // while the tid path spells it down to the bare, non-injective "List" — the
        // exact class DECISIONS.md:343's diff-type-injective floor exists
        // to catch, reintroduced through the one branch that didn't ask the alias table.
        let underlying = tc_resolve_transparent_alias_name(t.name)
        if underlying != -1 { return tc_tid_seg_injective(underlying) }
        return true
    }
    let mut i = 0
    while i < t.params_count {
        if !tc_tid_seg_injective(ty_param_list.get(t.params_start + i).unwrap()) { return false }
        i = i + 1
    }
    true
}

fn tc_tid_tuple_seg_injective(t: TypePoolEntry) -> Bool {
    let mut i = 0
    while i < t.params_count {
        if !tc_tid_inner_seg_injective(ty_param_list.get(t.params_start + i).unwrap()) { return false }
        i = i + 1
    }
    true
}

// The INNER-position twin, mirroring tc_tid_inner_tag rather than tc_tid_to_c_tag. The two
// spellers erase DIFFERENTLY and the difference is not cosmetic: a Map spells its key and
// value here (Option[Map[Str,Int]] → Option_Map_str_int, injective) but erases to a bare
// "Map" at the top level. List/Set/Iterator/Handle/Channel erase in BOTH positions
// (tc_tid_inner_tag falls through to tc_tid_tag_at's shared scalar fallback → "list"/"set"/…).
fn tc_tid_inner_seg_injective(tid0: Int) -> Bool {
    let tid = tc_resolve(tid0)
    if tid < 0 || tid >= ty_pool.len() { return false }
    let t = ty_pool.get(tid).unwrap()
    let k = t.kind
    if k == TyKind.Struct || k == TyKind.Enum { return tc_tid_struct_seg_injective(t) }
    if k == TyKind.Option { return tc_tid_inner_seg_injective(t.inner1) }
    if k == TyKind.Result { return tc_tid_inner_seg_injective(t.inner1) && tc_tid_inner_seg_injective(t.inner2) }
    if k == TyKind.Map { return tc_tid_inner_seg_injective(t.inner1) && tc_tid_inner_seg_injective(t.inner2) }
    if k == TyKind.Tuple { return tc_tid_tuple_seg_injective(t) }
    if k == TyKind.List || k == TyKind.Set { return false }
    if k == TyKind.Iterator || k == TyKind.Handle || k == TyKind.Channel { return false }
    // Ptr spells a bare "Ptr"/"ptr" and drops the pointee, so two different pointees collide on
    // one segment. Non-injective for the same reason List and Set are.
    if k == TyKind.Ptr { return false }
    if k == TyKind.Bytes { return true }
    if k == TyKind.Typevar || k == TyKind.Unknown || k == TyKind.Void { return false }
    if k == TyKind.Int || k == TyKind.Float || k == TyKind.Bool || k == TyKind.Str || k == TyKind.Char { return true }
    if k == TyKind.I8 || k == TyKind.I16 || k == TyKind.I32 { return true }
    if k == TyKind.U8 || k == TyKind.U16 || k == TyKind.U32 || k == TyKind.U64 { return true }
    false
}

// A tuple is encodable iff every element's tc_tid_inner_tag is byte-identical to
// the string path's per-element tag. This slice deliberately allows only the
// element shapes PROVEN identical, deferring the rest:
//   - scalars (int/float/str/bool/sized-ints/char)   → same lowercase tag
//   - List / Set / Bytes                             → tc_tid_inner_tag erases to
//                                                       bare list/set/bytes, same
//                                                       as resolve_tuple_ann
//   - nested tuple over safe elements                → tc_tid_tuple_tag recurses
//                                                       to Tuple{n}_...; the mono
//                                                       binding matches the tuple's
//                                                       registered carrier name
//                                                       (verified byte-equal by A/B
//                                                       for value-constructed args).
//                                                       (A nested tuple in a `let`
//                                                       TYPE ANNOTATION is a separate
//                                                       pre-existing codegen crash,
//                                                       orthogonal here.)
// Admitted (in addition to the scalars/List/Set/Bytes/nested-tuple above):
//   - struct/enum : a BARE struct/enum, or a struct INSTANCE, is byte-identical
//                   (tc_tid_inner_tag → c_type_tag_for_struct / tc_tid_struct_mono_name
//                   == resolve_tuple_ann's element tag, both physical, both module-
//                   qualified). Only an ENUM INSTANCE
//                   (params_count>=1) DEFERS (tc_tid_struct_mono_name is STRUCT-only).
//   - Option/Result with a SCALAR inner: tc_tid_inner_tag spells
//                   Option_<scalar> / Result_<scalar>_<scalar>, byte-identical to
//                   both the value path (emit_tuple_lit) and the annotation path
//                   (resolve_tuple_ann). Result needs BOTH inners scalar. List/Map/
//                   struct/nested-compound inners still DEFER (below).
//   - Map with SCALAR key AND value: tc_tid_inner_tag spells
//                   Map_<scalar>_<scalar>, byte-identical to the value path
//                   (emit_tuple_lit's CT_MAP arm reads the map's key/val) and the
//                   annotation path (compound_name_from_ann → Map_{key}_{val}). A
//                   Map with a non-scalar inner, or a Map NESTED inside an
//                   Option/Result carrier, still DEFERS (the Option/Result arms
//                   require a scalar inner).
// Deferred (string path stays authoritative — the two tags DIVERGE):
//   - enum INSTANCE: tc_tid_struct_mono_name is STRUCT-only, so the encoder would
//                   erase the args to the bare head (latent — generic enums aren't
//                   constructible today; mirrors the tc_tid_tuple_elem_faithful arm).
//   - Option/Result with a List/Map/struct/nested-compound inner: tc_tid_inner_tag
//                   has no List/Set/Bytes arm (erases to bare list/set/bytes) and
//                   spells Map/struct/nested inners differently from the
//                   value-constructed string path (Option[List[Int]] tid → bare
//                   "list" vs string path's kept element).
//   - typevar/unknown: no concrete binding yet.
pub fn tc_tid_tuple_elem_faithful(tid: Int) -> Bool {
    if tid < 0 || tid >= ty_pool.len() { return false }
    let t = ty_pool.get(tid).unwrap()
    let k = t.kind
    if k == TyKind.Tuple {
        let start = t.params_start
        let count = t.params_count
        let mut i = 0
        while i < count {
            if !tc_tid_tuple_elem_faithful(ty_param_list.get(start + i).unwrap()) { return false }
            i = i + 1
        }
        return true
    }
    if k == TyKind.List || k == TyKind.Set || k == TyKind.Bytes { return true }
    if k == TyKind.Int || k == TyKind.Float || k == TyKind.Bool || k == TyKind.Str || k == TyKind.Char { return true }
    if k == TyKind.I8 || k == TyKind.I16 || k == TyKind.I32 { return true }
    if k == TyKind.U8 || k == TyKind.U16 || k == TyKind.U32 || k == TyKind.U64 { return true }
    // Option/Result tuple element with a SCALAR, List/Set/Bytes, Map, or nested
    // Option/Result inner: tc_tid_inner_tag spells Option_<inner> / Result_<i1>_<i2>,
    // byte-identical to the annotation path (resolve_tuple_ann → compound_name_from_ann →
    // resolve_ann_tag) AND the value path (emit_tuple_lit's CT_OPTION/CT_RESULT arms,
    // which recurse the element tid via the SAME tc_tid_inner_tag) whenever every inner is
    // tc_tid_inner_tag_faithful — covering a Map inner (Option[Map[Str,Int]] →
    // Option_Map_str_int) and a nested Option/Result inner (Option[Option[Int]] →
    // Option_Option_int) whose own leaves are faithful.
    //
    // Both arms delegate to tc_tid_inner_tag_faithful for their inners. A Result[Map,_]
    // value carrier is spelled STRUCTURED (Result_Map_str_int_int) by the
    // construction/param/reassignment speller — identical C layout to a bare "map"
    // (uniform blink_map* member), so assignment stays legal AND it matches the tid path
    // — so both the top-level Result arm here and the nested case (via the predicate's
    // TyKind.Result branch) ride.
    // Still DEFERS: a struct/enum leaf anywhere in the inner (tc_tid_inner_tag routes
    // through c_type_tag_for_struct / tc_tid_struct_mono_name vs the annotation path's
    // mono_name_from_ann — not proven byte-equal at THIS seam specifically, and stays
    // open as its own follow-up), as does a tuple inner.
    if k == TyKind.Option { return tc_tid_inner_tag_faithful(t.inner1) }
    if k == TyKind.Result {
        return tc_tid_inner_tag_faithful(t.inner1) && tc_tid_inner_tag_faithful(t.inner2)
    }
    // A Map tuple element: tc_tid_inner_tag spells the erased "map" at every depth (Map
    // is an erased carrier like List/Set), byte-identical to the value path (emit_tuple_lit's
    // CT_MAP arm) and the annotation path regardless of K/V — so the element always rides
    // the tid faithfully; the K/V are recovered per-use from the tid, never from the C tag.
    if k == TyKind.Map { return true }
    // A BARE (monomorphic) struct/enum tuple element: tc_tid_inner_tag spells it via
    // c_type_tag_for_struct (physical prefix), byte-identical to resolve_tuple_ann's
    // struct-element tag for BOTH same-module and cross-module names — this guard never
    // gated on the module qualifier. A STRUCT INSTANCE (params_count>=1) is also
    // byte-equal: tc_tid_inner_tag → tc_tid_struct_mono_name spells the full mono stem
    // PHYSICALLY, and resolve_tuple_ann's element arm recovers the same mono stem via
    // mono_name_from_ann (test_637sy9_*) instead of erasing to the bare head. An ENUM
    // INSTANCE (TyKind.Enum, params_count>=1) is ADMITTED too: tc_tid_struct_mono_name
    // spells enums the same way (c_type_tag_for_struct base + kind-agnostic slot segs), so
    // it spells the same full mono stem (Tree_Int) that resolve_tuple_ann's element arm
    // recovers via mono_name_from_ann — the enum twin of the struct-instance case above.
    if k == TyKind.Struct || k == TyKind.Enum { return true }
    // A genuine Void TUPLE ELEMENT is ADMITTED: emit_tuple_typedef (codegen_types.bl:5622)
    // spells a scalar element through c_field_type_str(et, name) instead of the bare
    // c_type_str(et), keyed on a resolved NAME threaded through TupleEntry's elem_names
    // field (codegen_types.bl:1312-1317) from all three registration sites (ensure_tuple_type,
    // resolve_tuple_ann, tid_tuple_elem_enc/ensure_tuple_carrier_from_tid) — the same
    // NAME-keyed mechanism a named struct/enum Void field already used
    // (c_field_type_str is keyed on the literal name "Void", not on CT_VOID, precisely so
    // an ERASED element — type_from_name collapses "" and every unknown name onto CT_VOID
    // too — keeps failing loudly instead of silently becoming a well-typed int64_t field).
    //
    // Admitting it here is correct in principle regardless of the emitter state: Void is
    // "an ordinary INHABITED, encodable type" (decisions/under-determined-types.md:39, 6-0).
    // tc_tid_ct maps TyKind.Void onto CT_VOID and then to -1 (:10677) — CT alone cannot
    // distinguish a genuine Void from an unsolved metavariable — so this checks the KIND
    // directly, mirroring tc_struct_slot_encodable's TyKind.Void arm above (:11797).
    if k == TyKind.Void { return true }
    // A kind with no arm above (TyKind.Typevar, TyKind.Unknown, TyKind.Fn): E0301 forecloses an
    // unsolved metavar before codegen reaches this gate, so this refusal exists for
    // defense in depth and for kinds with genuinely no tuple-element spelling.
    voidtwin_probe("tuple_elem", tid)
    false
}

// A binding tid resolves to a concrete CSV segment only when tc_tid_to_c_tag can
// encode it byte-identically to the string-tag path; otherwise defer (None), and
// the hybrid in emit_generic_fn_call_tail falls back to infer_fn_type_args_from_
// types for that call.
pub fn tc_seg_from_tid(tid: Int) -> Option[Str] {
    if !tc_tid_encodable(tid) { return None }
    Some(tc_tid_to_c_tag(tid))
}

// STRUCTURAL type equality over two tids: same kind, same nominal name where the name is
// load-bearing, same inners, same type-args element-wise.
//
// tid INEQUALITY IS NOT ALWAYS TYPE INEQUALITY, even after ty_pool interning:
// make_*_type interns canonically-constructed compounds behind ty_intern (see the
// comment above `new_type`), so two calls with the same (kind, name, inners, args) share
// one tid. What interning does NOT close: a compound built over a metavar that is later
// BOUND is not re-keyed, so `Option[alpha]` interned before `alpha := Int` binds remains a
// separate tid from a fresh `make_option_type(TYPE_INT)` call (needs tid-forwarding, not
// yet built). So `a == b` is still a sound but INCOMPLETE test of type
// equality. Anything that wants a complete answer must still ask STRUCTURALLY — never by
// comparing the erasing mono-CSV spellings (tc_tid_to_c_tag drops a container's element,
// so Set[Int] and Set[Str] both spell "Set").
//
// Deliberately conservative on the two axes where a wrong answer misleads:
//   - the nominal name is compared only for TyKind.Struct / TyKind.Enum / TyKind.Typevar, the kinds
//     where it distinguishes types. Every other kind's head is fixed by the kind itself,
//     and make_*_type's `name` for those is decorative — comparing it would report a
//     spurious difference for two spellings of one type.
//   - a metavar is resolved first (a pinned α is its solution), and an out-of-range tid
//     answers false: unknown provenance is never reported as sameness.
pub fn tc_classify_mono_conflicts() {
    let mut i = 0
    while i < mono_slot_conflicts.len() {
        let c = mono_slot_conflicts.get(i).unwrap()
        let same = tc_tid_same_type(c.stored, c.incoming)
        // A DIFF-TYPE row is only a DECISIONS.md:343 violation when BOTH segments name
        // their own type arguments. If either erases (Set/Map/List/... at a collapsing
        // position), one C symbol genuinely serves both and sharing the entry is correct.
        let injective = !same && tc_tid_seg_injective(c.stored) && tc_tid_seg_injective(c.incoming)
        if same {
            mono_slot_conflicts_same_type = mono_slot_conflicts_same_type + 1
        } else {
            mono_slot_conflicts_diff_type = mono_slot_conflicts_diff_type + 1
            if injective {
                mono_slot_conflicts_diff_type_injective = mono_slot_conflicts_diff_type_injective + 1
            }
        }
        if dbg_channel_on("monodedup") != 0 {
            let verdict = if same { "same-type" } else { "DIFF-TYPE" }
            // `class` is only meaningful on a DIFF-TYPE row; a same-type row is neither.
            let cls = if same { "n/a" } else { if injective { "VIOLATION" } else { "excusable" } }
            dbg_trace("monodedup", "slot-conflict-class base={c.base} args={c.args} slot={c.slot} verdict={verdict} class={cls} stored={c.stored}:{tc_type_str(c.stored)} incoming={c.incoming}:{tc_type_str(c.incoming)}")
        }
        i = i + 1
    }
    mono_slot_conflicts = []
}

// Whether a struct type-arg SLOT tid is one tc_tid_to_c_tag can spell at all — the
// slot-tid analogue of tc_tid_encodable, kept SEPARATE rather than folded into it
// because the two predicates deliberately diverge on two axes:
// this one does NOT tc_resolve a bound-but-unsolved metavar (so a raw slot reads
// back TyKind.Unknown and is refused even when its resolution is concrete — 9 of its
// 10 call sites rely on that), and it admits TyKind.Map/TyKind.Set/TyKind.List unconditionally
// where tc_tid_encodable recurses. The tid path is the sole authority for what the
// mono registry may key on, so each arm below is a decision about that, not a parity
// check against some other producer.
//   - scalars (int/float/str/bool/sized-ints/char) admit unconditionally.
//   - a BARE (params_count 0) struct/enum admits regardless of module qualifier:
//     tc_tid_to_c_tag spells it via strip_module_qualifier, and the
//     mono registrar's physical c_name agrees.
//   - a STRUCT INSTANCE slot (params_count>=1, `Box[Box[Int]]`) admits: tc_tid_to_c_tag
//     recurses via tc_tid_struct_mono_name to the full mono
//     stem (Box_Int), the same name register_mono_instance mints — closing the -1
//     hole so arg_tids can key the mono dedup.
//   - an ENUM INSTANCE (params_count>=1) admits too — see the
//     TyKind.Struct|TyKind.Enum branch's own comment below.
//   - Option/Result over encodable inners, Tuple (tc_tid_tuple_elem_faithful), Map,
//     and Set all admit: tc_tid_to_c_tag spells each via the tid tier's
//     one speller ("Option_int" / "Result_int_str" / "Tuple2_int_int" / bare
//     "Map"/"Set"), so carrying the real tid keys the mono dedup without changing
//     emitted C. Each shape's inner gate mirrors tc_tid_encodable's own arm. See
//     the per-shape arms below.
// Everything else refuses (return false):
//   - typevar/unknown — no concrete binding.
pub fn tc_struct_slot_encodable(tid: Int) -> Bool {
    if tid < 0 || tid >= ty_pool.len() { return false }
    let t = ty_pool.get(tid).unwrap()
    let k = t.kind
    if k == TyKind.Int || k == TyKind.Float || k == TyKind.Bool || k == TyKind.Str || k == TyKind.Char { return true }
    if k == TyKind.I8 || k == TyKind.I16 || k == TyKind.I32 { return true }
    if k == TyKind.U8 || k == TyKind.U16 || k == TyKind.U32 || k == TyKind.U64 { return true }
    // An ENUM INSTANCE (TyKind.Enum, params_count>=1) is ADMITTED:
    // tc_tid_struct_mono_name spells its full mono stem (Tree_Int) rather than erasing
    // to the bare head — the enum twin of the struct-instance slot admitted below.
    // A struct/enum slot is admitted regardless of module qualifier: the
    // mono-registry physical-base split makes both paths spell a cross-module slot
    // the SAME — a bare cross-module struct's segment is bare on both (tc_tid_to_c_tag
    // → strip_module_qualifier == the string path's bare arg segment), and a
    // cross-module struct INSTANCE's segment is PHYSICAL on both (tc_tid_struct_mono_name
    // == register_mono_instance's physical c_name). This is what lets a cross-module
    // instance SLOT carry a real tid so arg_tids can key the mono dedup.
    // A BARE struct/enum (params_count 0) admits unconditionally (above).
    // An INSTANCE (params_count>=1) admits only when tc_tid_struct_mono_name can
    // actually spell its full recursive stem — a still-generic nested instance
    // (Box[T] where T is this fn's own unbound typevar, one level inside an outer
    // Box[Box[T]] struct LITERAL) cannot, so admitting on recursion structure alone
    // would wave through it. When the stem is empty, tc_tid_tag_at's own
    // TyKind.Struct|TyKind.Enum arm falls back to the BARE head name for every
    // empty-stem cause, conflating "genuinely bare base" with "instance failed to
    // resolve" — declining here instead gives tid_native_struct_mono's
    // substitution retry (tc_tid_subst_mono) a chance to run. Also reject a bare
    // ICE_SEG_* sentinel spelling (diag_is_ice_seg) — non-"" but not a real name.
    if k == TyKind.Struct || k == TyKind.Enum {
        if t.params_count == 0 { return true }
        let name = tc_tid_struct_mono_name(tid)
        return name != "" && !diag_is_ice_seg(name)
    }
    // Compound slots: a struct type-arg SLOT that is itself an
    // Option/Result over encodable inners is ADMITTED. The string path spells the
    // slot via the SAME tc_tid_to_c_tag (tid_instance_mono_args_csv, the tid tier's one
    // speller → "Option_int" / "Result_int_str"), and the def-side reader (resolve_tparam_via_tid
    // → tc_seg_from_tid → tc_tid_to_c_tag) round-trips it byte-identically, so carrying
    // the real tid keys the mono dedup without changing emitted C. Gated on the general
    // tc_tid_encodable for the inner, exactly like tc_tid_to_c_tag's own recursion — a
    // nested typevar/unknown inner still defers. The Gen1==Gen2 fixed point is the
    // byte-equality proof; a shape that breaks it is a genuine divergence and reverts.
    if k == TyKind.Option { return tc_tid_encodable(t.inner1) }
    if k == TyKind.Result { return tc_tid_encodable(t.inner1) && tc_tid_encodable(t.inner2) }
    // A TUPLE slot (test_0sh55p T=Tuple2_int_int): admitted when every
    // element is tuple-element-safe (tc_tid_tuple_elem_faithful), the same gate the general
    // tc_tid_encodable uses. tc_tid_to_c_tag spells it via tc_tid_tuple_tag
    // (Tuple2_int_int), byte-matching the struct-lit string path's registered tuple
    // carrier segment.
    if k == TyKind.Tuple { return tc_tid_tuple_elem_faithful(tid) }
    // A MAP slot (the List twin one carrier over): tc_tid_to_c_tag
    // erases Map to the bare carrier tag "Map" (no inner spelling), matching the string
    // path's bare "Map" segment — the same top-level spelling as Set/List below, admitted
    // unconditionally for the identical parity reason (a refusal here has no referent:
    // tc_tid_seg_injective already groups TyKind.Map with TyKind.Set/TyKind.List as non-injective, so
    // no inner element can ever leak into the erased "Map" symbol). Admitting the slot
    // alone is NOT the whole fix: the def-side field storage erases every Map[K,V] field
    // identically regardless of K,V, so a per-USE key/value recovery —
    // recover_map_kv_from_tid, codegen_expr.bl — is required alongside this to avoid
    // silently mis-reading a Map[Str,Point] field as the erased-default Map[Str,Int].
    if k == TyKind.Map { return true }
    // A SET slot (test_kvn6w8 / test_qw7v90 T=Set): tc_tid_to_c_tag erases
    // Set to the bare carrier tag "Set", matching the string path's bare "Set" segment
    // — the twin of the Map arm above. tc_tid_encodable admits TyKind.Set unconditionally
    // (it erases to the bare carrier), so no inner gate is needed here.
    if k == TyKind.Set { return true }
    // A LIST slot: tc_tid_to_c_tag erases List to the bare carrier tag
    // "List", dropping every type argument — the same top-level spelling as Set/Map
    // above, admitted unconditionally for the identical reason. This needs a PARITY
    // ARGUMENT, not just an inner-encodable gate like Option/Result/Map/Tuple, because
    // the top-level spelling for List names no type argument at all. The argument that
    // survives is representation-sharing (DECISIONS.md:343 is satisfied by ONE C symbol
    // correctly serving every element, not by per-element symbols): since the top-level
    // spelling names no type argument, no inner element can ever leak into the symbol, so
    // an inner gate here would be a refusal with NO REFERENT — there is nothing it could
    // protect that Option/Map/Tuple's inner gates protect (a leaking unencodable inner
    // spelling). tc_tid_seg_injective is already false for TyKind.List (:11344), so the
    // mono-conflict tripwire (tc_classify_mono_conflicts) already classifies the
    // resulting cross-element sharing as `excusable`, not a violation. And refusing here
    // does not make the program safe: a decline just pushes the same under-determination
    // into a codegen-only I0001 (UnsolvedTypeVarAtCodegen), which is precisely the "no
    // rule enforced only at codegen" pattern DECISIONS.md §3.1 Diagnostic Discipline
    // forbids — an I0001 catches a violation of a rule, it is never itself the rule.
    // (Admitting the slot alone is NOT the whole fix: the def-side field storage erases
    // every List[T] field identically regardless of T, so a per-USE element recovery —
    // recover_list_elem_from_tid, codegen_expr.bl — is required alongside this to avoid
    // silently mis-reading a List[Str]/[Float]/[struct] field as a List[Int].)
    if k == TyKind.List { return true }
    // A genuine Void slot is ADMITTED — same reasoning as tc_tid_tuple_elem_faithful's
    // TyKind.Void arm above: both paths spell it "Void", so this is byte-neutral,
    // and an accidental fall-through to `false` would erase a real `Box[Void]`.
    if k == TyKind.Void { return true }
    voidtwin_probe("struct_slot", tid)
    false
}

// Resolve the CSV segment for type-arg slot `idx` of a struct-INSTANCE tid
// (`Box[Int]`, `Pair[Int,Str]` built by make_struct_instance_type). Reads the raw
// slot tid from ty_param_list — the same slot the dormant tc_tid_struct_arg_ct /
// _struct accessors read. Gates the slot on tc_struct_slot_encodable (the STRICT
// struct-slot spelling rule; NOT the general tc_tid_encodable, which would wrongly
// accept a nested struct instance / Option slot and emit a divergent symbol) before
// routing through tc_tid_to_c_tag. Yields None for a bare generic base (count 0),
// an out-of-range idx, or an unencodable slot — the caller then defers to the
// string path.
fn tc_type_is_enum(tname: Str) -> Int {
    let td = tc_type_decl_nodes.get(tname) ?? -1
    if td == -1 { return 0 }
    let flds = node_fields(td)
    if flds != -1 && sublist_length(flds) > 0 {
        if node_kind(sublist_get(flds, 0)) == NodeKind.TypeVariant { return 1 }
    }
    0
}

// The 0-based type-arg slot in generic-struct param `p`'s annotation
// (`Box[T]` → 0, `Pair[A, B]` → A=0 / B=1) that names `param_name`, or -1.
// A struct can mention the param in any slot; when several do, return the LAST
// match — this function's own choice, changing it changes emitted symbols directly.
fn tc_struct_param_binds(p: Int, param_name: Str) -> Int {
    let ta = node_type_ann(p)
    if ta == -1 { return -1 }
    let elems_sl = node_elements(ta)
    if elems_sl == -1 { return -1 }
    let mut which = -1
    let mut i = 0
    while i < sublist_length(elems_sl) {
        if node_name(sublist_get(elems_sl, i)) == param_name { which = i }
        i = i + 1
    }
    which
}

// For a `Fn(...) -> R` param annotation: -2 if the return slot names the param,
// else the 0-based Fn-param index that names it, else -1.
fn tc_fn_param_binds(p: Int, param_name: Str) -> Int {
    let ta = node_type_ann(p)
    if ta == -1 { return -1 }
    if node_return_type(ta) == param_name { return -2 }
    let elems_sl = node_elements(ta)
    if elems_sl == -1 { return -1 }
    let mut i = 0
    while i < sublist_length(elems_sl) {
        if node_name(sublist_get(elems_sl, i)) == param_name { return i }
        i = i + 1
    }
    -1
}

// Whether a type annotation names `param_name` anywhere in its element tree.
// Distinguishes "this position mentions the type-param but the tid can't express
// it" (-> defer via None) from "this position is unrelated" (-> keep scanning).
fn tc_ann_mentions_param(ann: Int, param_name: Str) -> Bool {
    if ann == -1 { return false }
    if node_name(ann) == param_name { return true }
    let elems_sl = node_elements(ann)
    if elems_sl == -1 { return false }
    let mut i = 0
    while i < sublist_length(elems_sl) {
        if tc_ann_mentions_param(sublist_get(elems_sl, i), param_name) { return true }
        i = i + 1
    }
    false
}

// COMPLETE walk of a type annotation for a type-param name — elements AND the
// nested `type_ann` slot. Deliberately NOT tc_ann_mentions_param, which walks only
// node_elements: parser.bl builds an `Fn` annotation with its PARAMS in `elements`
// and its RETURN in `type_ann`, so the elements-only walk cannot see the `U` in
// `f: fn(T) -> U`. `Fn` is the only TypeAnn kind that stores a nested annotation
// outside `elements`, which is what makes this walk complete rather than merely
// deeper.
//
// The distinction is load-bearing and asymmetric: the two existing users of
// tc_ann_mentions_param ask "does this position mention the param, so should I
// DEFER?", where under-reporting costs only a fallback to the string path. This
// asks "is this param unconstrained by every parameter, so should I MINT?", where
// under-reporting mints an α nothing can ever bind — E0301 at every call of
// lib/std/list.bl's list_map and lib/std/map.bl's map_map_values, the only two
// functions in the repo whose type param is named solely inside an `Fn`. A row in
// tests/test_3dpshm_generic_fn_ret_only_tparam.bl fails loudly if the two are
// confused; do not merge them.
fn tc_scalar_tid_from_name(name: Str) -> Int {
    if name == "Int" || name == "I64" { return TYPE_INT }
    if name == "Float" { return TYPE_FLOAT }
    if name == "Bool" { return TYPE_BOOL }
    if name == "Str" { return TYPE_STR }
    -1
}

// The canonical singleton tid for a SCALAR physical CT, or -1 for a kind whose C spelling
// needs more than the tag (struct/enum name, container element). It is the inverse of the
// scalar rows of c_type_str: c_type_from_tid(tc_scalar_tid_for_ct(ct)) == c_type_str(ct) for
// every ct it answers, which is what lets a codegen arm publish a PHYSICAL result tid off the
// flat CT it already computed without minting a fresh type. Void is a scalar answer here (a
// bare `void` return position); a storage position that lands on CT_VOID keeps routing through
// c_field_type_str, which this does not replace.
pub fn tc_scalar_tid_for_ct(ct: Int) -> Int {
    if ct == CT_INT { return TYPE_INT }
    if ct == CT_FLOAT { return TYPE_FLOAT }
    if ct == CT_BOOL { return TYPE_BOOL }
    if ct == CT_STRING { return TYPE_STR }
    if ct == CT_CHAR { return TYPE_CHAR }
    if ct == CT_VOID { return TYPE_VOID }
    if ct == CT_I8 { return TYPE_I8 }
    if ct == CT_I16 { return TYPE_I16 }
    if ct == CT_I32 { return TYPE_I32 }
    if ct == CT_U8 { return TYPE_U8 }
    if ct == CT_U16 { return TYPE_U16 }
    if ct == CT_U32 { return TYPE_U32 }
    if ct == CT_U64 { return TYPE_U64 }
    -1
}

// Bind a type param that sits at ANY DEPTH in a parameter's annotation, by walking
// the annotation tree and the argument's tid in lockstep.
//
// Every arm of the ladder below reads exactly ONE level — `List[T]` off inner1, `Map[K, _]` /
// `Result[_, E]` off inner1/inner2, one bespoke case for `List[(.., T, ..)]`. So a param named
// two levels down bound nothing and reached monomorphization as BLINK_I0001_erased_slot, making
// every such signature uncallable: `List[Set[T]]`, and equally `List[Option[T]]`,
// `List[Result[T, E]]`, `List[List[T]]`, `List[Map[K, V]]`, `Map[K, List[V]]`, `Option[List[T]]`.
// A fixed set of one-level readers cannot express depth >= 2, so this walks the structured tid
// rather than hand-write a cell per (head x slot). tc_tid_child indexes inner1 / inner2 / the
// params slice uniformly, in the same order the parser puts an annotation's `elements` in, which
// is what makes the lockstep walk a dozen lines instead of a ladder.
//
// It runs as the LAST resort, after every arm has declined, so it only ADDS answers: no slot an
// arm already resolved is re-decided, the struct/enum arms' deliberate hard -1 still fires first,
// and the Fn arm's own hard -1 is never reached from here.
//
// Three guards, each load-bearing:
//   - descend only into a child annotation that actually NAMES the param, so an unrelated
//     sibling slot cannot supply a binding;
//   - descend only when the annotation's head agrees with the tid's KIND, or an `Option[T]`
//     annotation against a `List[Int]` argument would bind T to the list's element;
//   - return only an ENCODABLE tid (tc_struct_slot_encodable), which is what keeps a typevar or
//     unknown from being spelled into a mono name — the same gate the struct and tuple arms use.
// Last-match-wins for a param named in several slots, matching tc_struct_param_binds' rule.
fn tc_tparam_tid_from_ann(ann: Int, tid: Int, param_name: Str) -> Int {
    if ann == -1 || tid < 0 { return -1 }
    if node_name(ann) == param_name {
        if tc_struct_slot_encodable(tid) { return tid }
        return -1
    }
    let elems_sl = node_elements(ann)
    if elems_sl == -1 { return -1 }
    if tc_ann_head_matches_tid(ann, tid) == false { return -1 }
    let n = sublist_length(elems_sl)
    let mut found = -1
    let mut i = 0
    while i < n {
        let child_ann = sublist_get(elems_sl, i)
        if tc_ann_mentions_param(child_ann, param_name) {
            let r = tc_tparam_tid_from_ann(child_ann, tc_tid_child(tid, i), param_name)
            if r >= 0 { found = r }
        }
        i = i + 1
    }
    found
}

// Whether a type annotation's head names the same constructor the tid's kind does.
//
// TyKind.Fn is deliberately `false`: an Fn annotation stores its params in `elements` and its
// RETURN in `type_ann`, so the element-index-to-child-index alignment tc_tparam_tid_from_ann
// relies on does not hold there, and that shape has its own arm. Enumerated rather than closed
// with a wildcard so a kind that gains an annotation spelling has to be decided here.
fn tc_ann_head_matches_tid(ann: Int, tid: Int) -> Bool {
    let nm = node_name(ann)
    match tc_tid_kind(tid) {
        TyKind.List => nm == "List"
        TyKind.Set => nm == "Set"
        TyKind.Map => nm == "Map"
        TyKind.Option => nm == "Option"
        TyKind.Result => nm == "Result"
        TyKind.Tuple => nm == "Tuple"
        TyKind.Struct => strip_module_qualifier(tc_tid_name(tid)) == nm
        TyKind.Enum => strip_module_qualifier(tc_tid_name(tid)) == nm
        TyKind.Fn => false
        TyKind.Int => false
        TyKind.Float => false
        TyKind.Bool => false
        TyKind.Str => false
        TyKind.Void => false
        TyKind.Bytes => false
        TyKind.StringBuilder => false
        TyKind.Typevar => false
        TyKind.Unknown => false
        TyKind.Iterator => nm == "Iterator"
        // The four one-child carriers. Each spells its inner as `elements[0]`
        // (resolve_type_parts' Handle/Channel/Ptr/Template arms) and stores it in inner1, which
        // tc_tid_child answers at index 0 — so the index alignment this function authorizes does
        // hold, and declining left `fn f[T](c: Channel[T])` with no argument position able to
        // supply T at all: I0001 at monomorphization, the signature uncallable.
        TyKind.Handle => nm == "Handle"
        TyKind.Channel => nm == "Channel"
        TyKind.Ptr => nm == "Ptr"
        TyKind.Template => nm == "Template"
        // `false` for the SAME reason TyKind.Fn is: the alignment this function exists to
        // authorize does not hold. A `Handler[E]` annotation puts the effect in `elements`, but
        // the effect is not a type and the tid has no children at all, so element 0 would be
        // aligned against child 0 = -1. A type parameter cannot appear in an effect position
        // either, so there is nothing here for tc_tparam_tid_from_ann to find.
        TyKind.Handler => false
        TyKind.FfiScope => false
        TyKind.I8 => false
        TyKind.I16 => false
        TyKind.I32 => false
        TyKind.U8 => false
        TyKind.U16 => false
        TyKind.U32 => false
        TyKind.U64 => false
        TyKind.Char => false
    }
}

// Return the concrete arg tid this type-param resolves to, or -1 when no argument
// position can supply it. This is the SOLE resolver: the whole mono CSV
// is rendered from the tids it produces, so "the segment" is by definition
// tc_seg_from_tid of what this returns and cannot disagree with it.
//
// `binds` (typevar-name → concrete tid) resolves the mono-calls-mono case: inside a
// monomorphized body the nested generic call's arg carries its ORIGINAL memoized tid,
// which still embeds the enclosing fn's abstract typevar (`run[M]`'s body calls
// `step(initial)` with initial:M; `outer_result[T]` calls `identity(r)` with
// r:Result[T,Str]). tc_lookup_node_tid then returns a TyKind.Typevar / typevar-embedding
// tid that tc_tid_encodable rejects, leaving the slot unresolvable. Substituting the arg tid
// through the enclosing instantiation's binding (built at the codegen call site, the
// only place the M→Model / T→Int map is known) concretizes it BEFORE the arm ladder
// reads it, so every downstream arm works unchanged. An EMPTY map is a no-op
// (substitute_typevar_tid returns the tid untouched) — the direct-call path.
fn tc_resolve_tparam_tid(param_name: Str, fn_params_sl: Int, args_sl: Int, binds: Map[Str, Int]) -> Int {
    let np = sublist_length(fn_params_sl)
    let na = sublist_length(args_sl)
    let mut fi = 0
    while fi < np && fi < na {
        let p = sublist_get(fn_params_sl, fi)
        let ptype = node_type_name(p)
        let arg_node = sublist_get(args_sl, fi)
        let arg_tid = substitute_typevar_tid(tc_lookup_node_tid(arg_node), binds)
        // monotid channel: the per-slot view of type-param resolution. When arg_tid
        // is -1 here, the tid was never memoized onto arg_node — an upstream capture
        // gap, not an encodability failure. (Its old companion, the csvresolve
        // channel on the string resolver, is retired along with that resolver.)
        // Gated behind dbg_channel_on because this is the hot per-slot
        // path and the interpolated message would otherwise be built on every
        // generic-call resolution even with tracing off.
        if dbg_channel_on("monotid") != 0 {
            dbg_trace("monotid", "param={param_name} ptype={ptype} fi={fi} arg_node={arg_node} arg_tid={arg_tid}")
        }
        if ptype == param_name {
            return arg_tid
        // The container heads (List/Map/Result/Option, and the List[(.., T, ..)] tuple
        // slot that std.testing.for_each is built on) carry no non-structural rule: each
        // just reads the child the annotation names off the arg tid. tc_tparam_tid_from_ann
        // at the tail does exactly that, walking the annotation tree against the tid's
        // children in lockstep, so a per-head arm here would only duplicate it. The two
        // arms that remain are the ones the tail walker CANNOT stand in for: Fn (a closure
        // signature it deliberately declines) and struct/enum (whose hard -1 must stop a
        // later param from adopting a slot the named one could not encode).
        } else if ptype == "Fn" {
            // `f: Fn(T) -> U` names a type-param in a closure position. The binding is
            // read off the literal's own annotations: the return_type string when the
            // param names the Fn return (tc_fn_param_binds == -2), otherwise the naming
            // Fn-param slot's declared type name. tc_scalar_tid_from_name admits only
            // the four scalars Int/Float/Bool/Str, so a non-scalar Fn param or return
            // (e.g. Box[T]) falls through to -1, which is now an I0001 ICE rather than
            // a fallback — there is no string path left to defer to.
            //
            // The closure literal's own node tid is a real TyKind.Fn whose return child
            // is an INSTANCE tid, not a name, so this arm could instead read
            // tc_lookup_node_tid(arg_node) and walk tc_tid_child to drop the four-scalar
            // restriction; it has not been widened that way yet.
            let fslot = tc_fn_param_binds(p, param_name)
            if fslot != -1 {
                if arg_node != -1 && node_kind(arg_node) == NodeKind.Closure {
                    if fslot == -2 {
                        return tc_scalar_tid_from_name(node_return_type(arg_node))
                    }
                    let cl_params = node_params(arg_node)
                    if cl_params != -1 && fslot < sublist_length(cl_params) {
                        return tc_scalar_tid_from_name(node_type_name(sublist_get(cl_params, fslot)))
                    }
                }
                return -1
            }
        } else if tc_type_is_struct(ptype) != 0 {
            if arg_tid >= 0 && arg_tid < ty_pool.len() {
                let arg_ty = ty_pool.get(arg_tid).unwrap()
                if arg_ty.kind == TyKind.Struct && tc_tid_struct_arg_count(arg_tid) >= 1 && strip_module_qualifier(arg_ty.name) == ptype {
                    let slot = tc_struct_param_binds(p, param_name)
                    if slot >= 0 && slot < tc_tid_struct_arg_count(arg_tid) {
                        let slot_tid = ty_param_list.get(ty_pool.get(arg_tid).unwrap().params_start + slot).unwrap()
                        if tc_struct_slot_encodable(slot_tid) { return slot_tid }
                    }
                }
            }
            if tc_ann_mentions_param(node_type_ann(p), param_name) {
                return -1
            }
        } else if tc_type_is_enum(ptype) != 0 {
            // Generic-enum param tid twin of the struct arm — read the
            // named slot's concrete tid off the arg's enum INSTANCE tid (TyKind.Enum), so
            // the def-side mono emitter re-derives blink_Tree_Int from the structured
            // tid rather than the "Void"-filled CSV.
            if arg_tid >= 0 && arg_tid < ty_pool.len() {
                let arg_ty = ty_pool.get(arg_tid).unwrap()
                if arg_ty.kind == TyKind.Enum && tc_tid_struct_arg_count(arg_tid) >= 1 && strip_module_qualifier(arg_ty.name) == ptype {
                    let slot = tc_struct_param_binds(p, param_name)
                    if slot >= 0 && slot < tc_tid_struct_arg_count(arg_tid) {
                        let slot_tid = ty_param_list.get(ty_pool.get(arg_tid).unwrap().params_start + slot).unwrap()
                        if tc_struct_slot_encodable(slot_tid) { return slot_tid }
                    }
                }
            }
            if tc_ann_mentions_param(node_type_ann(p), param_name) {
                return -1
            }
        }
        // The arms above all read one level. Anything deeper falls to here.
        let deep = tc_tparam_tid_from_ann(node_type_ann(p), arg_tid, param_name)
        if deep >= 0 { return deep }
        fi = fi + 1
    }
    -1
}

// The per-type-param concrete tids, and the ORIGIN of the mono CSV rather than
// something parallel to it: codegen renders the CSV from this list via
// mono_csv_from_arg_tids, so each entry's tc_seg_from_tid IS the segment. An entry is -1
// where no argument position could supply the param, which renders as
// ICE_SEG_ERASED_SLOT and is caught at the I0001 chokepoints. Stored
// on the mono registry (arg_tids) so the def-side emitters can re-derive that
// slot from the structured tid instead of re-parsing the CSV string.
//
// mono-calls-mono variant: the same per-tparam derivation, but with the enclosing
// instantiation's typevar bindings applied to each nested-call arg tid before the
// arm ladder reads it (see tc_resolve_tparam_tid). `mono_tparams_sl` are the
// ENCLOSING generic fn's type-param nodes and `mono_arg_tids` its concrete per-
// tparam tids (cg_mono_tparams_sl / cg_mono_arg_tids at the codegen call site);
// paired by position into the name→tid map. A -1 or out-of-range enclosing tid is
// simply not inserted, so an un-captured enclosing slot leaves that typevar
// abstract and the nested slot stays on the string path (never a wrong bind).
pub fn tc_mono_tids_subst(call_node: Int, fn_node: Int, mono_tparams_sl: Int, mono_arg_tids: List[Int]) -> List[Int] {
    tc_mono_tids_core(call_node, fn_node, tc_mono_binds_map(mono_tparams_sl, mono_arg_tids))
}

fn tc_mono_tids_core(call_node: Int, fn_node: Int, binds: Map[Str, Int]) -> List[Int] {
    let mut tids: List[Int] = []
    let tparams_sl = node_type_params(fn_node)
    if tparams_sl == -1 { return tids }
    let num_params = sublist_length(tparams_sl)
    if num_params == 0 { return tids }
    let fn_params_sl = node_params(fn_node)
    if fn_params_sl == -1 { return tids }
    let args_sl = node_args(call_node)
    if args_sl == -1 { return tids }
    let mut pi = 0
    while pi < num_params {
        let param_name = node_name(sublist_get(tparams_sl, pi))
        let mut tid = tc_resolve_tparam_tid(param_name, fn_params_sl, args_sl, binds)
        // -1 means no argument position could supply this slot — the same seam a
        // return-only type param falls through. Substitute the call site's solved
        // return type so the registered mono instance carries the concrete inner tid
        // every def-side arg_tids consumer reads, rather than -1 (which drops the
        // slot to the erasing string path). Only where the argument path already
        // gave up.
        if tid < 0 {
            let m = tc_ret_mint_at(call_node, num_params, pi)
            if m >= 0 && tc_tid_encodable(m) { tid = m }
        }
        tids.push(tid)
        pi = pi + 1
    }
    tids
}
