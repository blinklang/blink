import diagnostics.{DiagEntry, json_escape}

// lsp_protocol.bl — the Language Server Protocol frames blink-lsp writes
//
// diag_ice_abort writes the last frames of a server that an internal error stops, and the
// diagnostics module can not reach the server, so the frame builders live apart from it.

pub fn lsp_frame(body: Str) -> Str {
    let len = body.byte_len()
    "Content-Length: {len}\r\n\r\n{body}"
}

fn lsp_severity(sev: Str) -> Int {
    if sev == "ice" {
        return 1
    }
    if sev == "error" {
        return 1
    }
    if sev == "warning" {
        return 2
    }
    3
}

pub fn lsp_to_zero_based(n: Int) -> Int {
    if n > 0 {
        return n - 1
    }
    0
}

pub fn lsp_end_line(d: DiagEntry, fallback_line: Int) -> Int {
    if d.end_line > 0 { lsp_to_zero_based(d.end_line) } else { fallback_line }
}

pub fn lsp_end_col(d: DiagEntry, fallback_col: Int) -> Int {
    if d.end_line > 0 { lsp_to_zero_based(d.end_col) }
    else if d.end_col > d.col { lsp_to_zero_based(d.end_col) }
    else { fallback_col }
}

pub fn lsp_build_diagnostics_json(uri: Str, diags: List[DiagEntry]) -> Str {
    let mut sb = StringBuilder.new()
    let diag_hdr = "\{\"uri\":\""
    let diag_mid = "\",\"diagnostics\":["
    sb.write(diag_hdr)
    sb.write(uri)
    sb.write(diag_mid)
    let mut i = 0
    while i < diags.len() {
        let d = diags.get(i).unwrap()
        if i > 0 {
            sb.write(",")
        }
        let sev = lsp_severity(d.severity)
        let line = lsp_to_zero_based(d.line)
        let col = lsp_to_zero_based(d.col)
        let end_line = lsp_end_line(d, line)
        let end_col = lsp_end_col(d, col)
        let code = json_escape(d.code)
        let msg = json_escape(d.message)
        let entry = "\{\"range\":\{\"start\":\{\"line\":{line},\"character\":{col}\},\"end\":\{\"line\":{end_line},\"character\":{end_col}\}\},\"severity\":{sev},\"code\":\"{code}\",\"source\":\"blink\",\"message\":\"{msg}\"\}"
        sb.write(entry)
        i = i + 1
    }
    let diag_end = "]\}"
    sb.write(diag_end)
    sb.to_str()
}

// An internal error that stops the compiler (diag_ice_abort) ends the server in the middle of
// a check, with exit 101 as it ends a cold check. diag_ice_abort writes these frames just
// before that exit, so the editor shows the fault on the document it asked about and gets an
// answer to the request it waits on, not a server that went quiet. They are built from the
// fault itself, since only then is its code known.
pub fn lsp_abort_frames(uri: Str, request_id: Option[Int], name: Str, code: Str, message: Str) -> Str {
    let ice = DiagEntry {
        severity: "ice", name: name, code: code, file: "", line: 0, col: 0, help: "",
        message: "internal compiler error[{name}]: {message}; blink-lsp stops, and its log holds the fault",
        end_line: 0, end_col: 0, fix_action: "", fix_text: "", notes: [],
    }
    let published = lsp_frame("\{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{lsp_build_diagnostics_json(uri, [ice])}\}")
    match request_id {
        Some(id) => published.concat(lsp_frame("\{\"jsonrpc\":\"2.0\",\"id\":{id},\"error\":\{\"code\":-32603,\"message\":\"internal compiler error\"\}\}"))
        None => published
    }
}
