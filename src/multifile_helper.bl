pub fn helper_add(a: Int, b: Int) -> Int {
    a + b
}

pub fn helper_mul(a: Int, b: Int) -> Int {
    a * b
}

fn secret_internal() -> Int {
    42
}

pub let HELPER_CONST = 99

let private_val = 7

pub type HelperPoint {
    x: Int
    y: Int
}

type SecretData {
    value: Int
}

pub type Color {
    Red
    Green
    Blue
}

type InternalStatus {
    Active
    Inactive
}

pub trait Printable {
    fn display(self) -> Str
}

trait InternalCodec {
    fn encode(self) -> Str
}

// Cross-module GENERIC struct, for the poly-impl element-mangling fixture
// (tests/test_x8k2vp_poly_impl_xmod_generic_elem.bl). A cross-module generic
// INSTANCE is the one poly-impl element shape whose string spelling erased its
// type argument; it must live in another module to exercise that path.
pub type HelperBox[T] {
    v: T
}
