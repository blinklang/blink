import ast.{NodeKind}
import std.str.{str_join}
import parser.{
    node_kind, node_name, node_left, node_right, node_body, node_condition,
    node_then_body, node_else_body, node_scrutinee, node_guard, node_value,
    node_target, node_iterable, node_is_mut, node_start, node_end, node_obj,
    node_method, node_index, node_params, node_args, node_stmts, node_arms,
    node_fields, node_elements,
    sublist_get, sublist_length,
}
import diagnostics.{
    Diag, diag_warn_at_notes, diag_source_file, diag_file_for_node,
    diag_push_allows, diag_clear_allows,
    INCOMPLETE_STATE_RESTORE, UNRESTORED_MUTATION,
}

// mutation_analysis.bl — Tier 1 write-set inference for Blink modules
//
// Walks the AST after parsing to determine which module-level mutable
// bindings each function may write to (directly or transitively via
// intra-module calls). Results are stored for diagnostics/LSP.

// ── Parallel-array storage ────────────────────────────────────────────

let mut ma_fn_names: List[Str] = []
let mut ma_write_items: List[Str] = []
let mut ma_write_starts: List[Int] = []
let mut ma_write_counts: List[Int] = []

let mut ma_globals: List[Str] = []

// Call edges stored as indices (not names) for O(1) propagation
let mut ma_call_edges_from: List[Int] = []
let mut ma_call_edges_to: List[Int] = []

// Hash maps for O(1) lookups
let mut fn_name_map: Map[Str, Int] = Map()
let mut global_set: Map[Str, Int] = Map()
let mut global_idx_map: Map[Str, Int] = Map()

let mut mutating_method_set: Map[Str, Int] = Map()

pub fn ma_state_len() -> Int {
    ma_fn_names.len()
}

fn init_mutating_methods() {
    if mutating_method_set.len() > 0 {
        return
    }
    mutating_method_set.insert("push", 1)
    mutating_method_set.insert("pop", 1)
    mutating_method_set.insert("append", 1)
    mutating_method_set.insert("clear", 1)
    mutating_method_set.insert("insert", 1)
    mutating_method_set.insert("remove", 1)
    mutating_method_set.insert("set", 1)
}

fn is_mutating_method(name: Str) -> Int {
    mutating_method_set.contains_key(name)
}

fn is_global(name: Str) -> Int {
    global_set.contains_key(name)
}

fn fn_index(name: Str) -> Int {
    fn_name_map.get(name) ?? -1
}

fn global_index(name: Str) -> Int {
    global_idx_map.get(name) ?? -1
}

// Flat boolean matrix: writes_mat[fn_idx * num_globals + global_idx]
let mut writes_mat: List[Int] = []
let mut writes_mat_cols: Int = 0

// Sparse mirror of writes_mat so propagate_writes can iterate just
// the callee's writes (typically <5) instead of all globals.
let mut fn_writes_idx: List[List[Int]] = []

fn mat_has_write(fn_idx: Int, gi: Int) -> Int {
    writes_mat.get(fn_idx * writes_mat_cols + gi).unwrap()
}

fn mat_set_write(fn_idx: Int, gi: Int) {
    writes_mat.set(fn_idx * writes_mat_cols + gi, 1)
    fn_writes_idx.get(fn_idx).unwrap().push(gi)
}

fn fn_has_write(fn_idx: Int, global_name: Str) -> Int {
    let gi = global_index(global_name)
    if gi < 0 {
        return 0
    }
    mat_has_write(fn_idx, gi)
}

fn add_write(fn_idx: Int, global_name: Str) {
    let gi = global_index(global_name)
    if gi < 0 {
        return
    }
    if mat_has_write(fn_idx, gi) != 0 {
        return
    }
    mat_set_write(fn_idx, gi)
    ma_write_items.push(global_name)
    ma_write_counts.set(fn_idx, ma_write_counts.get(fn_idx).unwrap() + 1)
}

// ── AST walking ───────────────────────────────────────────────────────

fn extract_ident_name(node: Int) -> Option[Str] {
    if node == -1 {
        return None
    }
    if node_kind(node) == NodeKind.Ident {
        return Some(node_name(node))
    }
    None
}

fn walk_expr(node: Int, fn_idx: Int) {
    if node == -1 {
        return
    }
    let kind = node_kind(node)

    if kind == NodeKind.Assignment || kind == NodeKind.CompoundAssign {
        let target = node_target(node)
        if target != -1 {
            let tk = node_kind(target)
            if tk == NodeKind.Ident {
                let tname = node_name(target)
                if is_global(tname) != 0 {
                    add_write(fn_idx, tname)
                }
            }
            if tk == NodeKind.FieldAccess {
                let obj = node_obj(target)
                if obj != -1 && node_kind(obj) == NodeKind.Ident {
                    let oname = node_name(obj)
                    if is_global(oname) != 0 {
                        add_write(fn_idx, oname)
                    }
                }
            }
            if tk == NodeKind.IndexExpr {
                let obj = node_obj(target)
                if obj != -1 && node_kind(obj) == NodeKind.Ident {
                    let oname = node_name(obj)
                    if is_global(oname) != 0 {
                        add_write(fn_idx, oname)
                    }
                }
            }
        }
        walk_expr(node_value(node), fn_idx)
        return
    }

    if kind == NodeKind.MethodCall {
        let obj = node_obj(node)
        let method = node_method(node)
        if obj != -1 && node_kind(obj) == NodeKind.Ident {
            let oname = node_name(obj)
            if is_global(oname) != 0 && is_mutating_method(method) != 0 {
                add_write(fn_idx, oname)
            }
        }
        walk_expr(obj, fn_idx)
        let args_sl = node_args(node)
        if args_sl != -1 {
            let mut ai = 0
            while ai < sublist_length(args_sl) {
                walk_expr(sublist_get(args_sl, ai), fn_idx)
                ai = ai + 1
            }
        }
        return
    }

    if kind == NodeKind.Call {
        let callee = node_left(node)
        let callee_name = extract_ident_name(callee)
        if callee_name.is_some() {
            let callee_idx = fn_index(callee_name.unwrap())
            if callee_idx >= 0 {
                ma_call_edges_from.push(fn_idx)
                ma_call_edges_to.push(callee_idx)
            }
        }
        walk_expr(callee, fn_idx)
        let args_sl = node_args(node)
        if args_sl != -1 {
            let mut ai = 0
            while ai < sublist_length(args_sl) {
                walk_expr(sublist_get(args_sl, ai), fn_idx)
                ai = ai + 1
            }
        }
        return
    }

    if kind == NodeKind.BinOp {
        walk_expr(node_left(node), fn_idx)
        walk_expr(node_right(node), fn_idx)
        return
    }

    if kind == NodeKind.UnaryOp {
        walk_expr(node_left(node), fn_idx)
        return
    }

    if kind == NodeKind.IfExpr {
        walk_expr(node_condition(node), fn_idx)
        walk_expr(node_then_body(node), fn_idx)
        walk_expr(node_else_body(node), fn_idx)
        return
    }

    if kind == NodeKind.Block {
        walk_stmts(node_stmts(node), fn_idx)
        return
    }

    if kind == NodeKind.LetBinding {
        walk_expr(node_value(node), fn_idx)
        return
    }

    if kind == NodeKind.ExprStmt {
        walk_expr(node_value(node), fn_idx)
        return
    }

    if kind == NodeKind.Return {
        walk_expr(node_value(node), fn_idx)
        return
    }

    if kind == NodeKind.ForIn {
        walk_expr(node_iterable(node), fn_idx)
        walk_expr(node_body(node), fn_idx)
        return
    }

    if kind == NodeKind.WhileLoop {
        walk_expr(node_condition(node), fn_idx)
        walk_expr(node_body(node), fn_idx)
        return
    }

    if kind == NodeKind.LoopExpr {
        walk_expr(node_body(node), fn_idx)
        return
    }

    if kind == NodeKind.MatchExpr {
        walk_expr(node_scrutinee(node), fn_idx)
        let arms_sl = node_arms(node)
        if arms_sl != -1 {
            let mut ai = 0
            while ai < sublist_length(arms_sl) {
                let arm = sublist_get(arms_sl, ai)
                walk_expr(node_guard(arm), fn_idx)
                walk_expr(node_body(arm), fn_idx)
                ai = ai + 1
            }
        }
        return
    }

    if kind == NodeKind.FieldAccess {
        walk_expr(node_obj(node), fn_idx)
        return
    }

    if kind == NodeKind.IndexExpr {
        walk_expr(node_obj(node), fn_idx)
        walk_expr(node_index(node), fn_idx)
        return
    }

    if kind == NodeKind.TupleLit || kind == NodeKind.ListLit {
        let elems_sl = node_elements(node)
        if elems_sl != -1 {
            let mut ei = 0
            while ei < sublist_length(elems_sl) {
                walk_expr(sublist_get(elems_sl, ei), fn_idx)
                ei = ei + 1
            }
        }
        return
    }

    if kind == NodeKind.StructLit {
        let fields_sl = node_fields(node)
        if fields_sl != -1 {
            let mut fi = 0
            while fi < sublist_length(fields_sl) {
                let fld = sublist_get(fields_sl, fi)
                walk_expr(node_value(fld), fn_idx)
                fi = fi + 1
            }
        }
        return
    }

    if kind == NodeKind.Closure {
        walk_expr(node_body(node), fn_idx)
        return
    }

    if kind == NodeKind.InterpString {
        let parts_sl = node_elements(node)
        if parts_sl != -1 {
            let mut pi = 0
            while pi < sublist_length(parts_sl) {
                walk_expr(sublist_get(parts_sl, pi), fn_idx)
                pi = pi + 1
            }
        }
        return
    }

    if kind == NodeKind.RangeLit {
        walk_expr(node_start(node), fn_idx)
        walk_expr(node_end(node), fn_idx)
        return
    }

    if kind == NodeKind.WithBlock {
        walk_expr(node_body(node), fn_idx)
        return
    }
}

fn walk_stmts(stmts_sl: Int, fn_idx: Int) {
    if stmts_sl == -1 {
        return
    }
    let mut i = 0
    while i < sublist_length(stmts_sl) {
        walk_expr(sublist_get(stmts_sl, i), fn_idx)
        i = i + 1
    }
}

// ── Transitive closure ────────────────────────────────────────────────

fn propagate_writes() -> Int {
    let mut changed = 0
    let n_edges = ma_call_edges_from.len()
    let mut ei = 0
    while ei < n_edges {
        let caller_idx = ma_call_edges_from.get(ei).unwrap()
        let callee_idx = ma_call_edges_to.get(ei).unwrap()
        let callee_writes = fn_writes_idx.get(callee_idx).unwrap()
        let n_writes = callee_writes.len()
        // Snapshot length: caller==callee self-edges mutate the list
        // we're iterating, and we don't want to re-process new entries.
        let mut wi = 0
        while wi < n_writes {
            let gi = callee_writes.get(wi).unwrap()
            if mat_has_write(caller_idx, gi) == 0 {
                mat_set_write(caller_idx, gi)
                changed = 1
            }
            wi = wi + 1
        }
        ei = ei + 1
    }
    changed
}

fn rebuild_write_lists() {
    ma_write_items = []
    ma_write_starts = []
    ma_write_counts = []
    let num_globals = ma_globals.len()
    let mut fi = 0
    while fi < ma_fn_names.len() {
        let start = ma_write_items.len()
        ma_write_starts.push(start)
        let mut count = 0
        let mut gi = 0
        while gi < num_globals {
            if mat_has_write(fi, gi) != 0 {
                ma_write_items.push(ma_globals.get(gi).unwrap())
                count = count + 1
            }
            gi = gi + 1
        }
        ma_write_counts.push(count)
        fi = fi + 1
    }
}

// ── Entry point ───────────────────────────────────────────────────────

pub fn analyze_mutations(program: Int) {
    init_mutating_methods()

    ma_fn_names = []
    ma_write_items = []
    ma_write_starts = []
    ma_write_counts = []
    ma_globals = []
    ma_call_edges_from = []
    ma_call_edges_to = []
    fn_writes_idx = []
    fn_name_map = Map()
    global_set = Map()
    global_idx_map = Map()

    // Step 1: collect module-level let mut bindings
    let lets_sl = node_stmts(program)
    if lets_sl != -1 {
        let mut i = 0
        while i < sublist_length(lets_sl) {
            let let_node = sublist_get(lets_sl, i)
            if node_kind(let_node) == NodeKind.LetBinding && node_is_mut(let_node) != 0 {
                let gname = node_name(let_node)
                ma_globals.push(gname)
                global_set.insert(gname, 1)
                global_idx_map.insert(gname, ma_globals.len() - 1)
            }
            i = i + 1
        }
    }

    // Step 2: register all function names
    let fns_sl = node_params(program)
    if fns_sl != -1 {
        let mut i = 0
        while i < sublist_length(fns_sl) {
            let fn_node = sublist_get(fns_sl, i)
            let fname = node_name(fn_node)
            ma_fn_names.push(fname)
            fn_name_map.insert(fname, i)
            ma_write_starts.push(0)
            ma_write_counts.push(0)
            fn_writes_idx.push([])
            i = i + 1
        }
    }

    // Init boolean matrix: fns × globals
    writes_mat_cols = ma_globals.len()
    writes_mat = []
    let mat_size = ma_fn_names.len() * writes_mat_cols
    let mut mi = 0
    while mi < mat_size {
        writes_mat.push(0)
        mi = mi + 1
    }

    // Step 3: walk each function body to find direct writes and call edges
    if fns_sl != -1 {
        let mut i = 0
        while i < sublist_length(fns_sl) {
            let fn_node = sublist_get(fns_sl, i)
            let body = node_body(fn_node)
            walk_expr(body, i)
            i = i + 1
        }
    }

    // Step 4: transitive closure — propagate callee writes to callers
    let mut max_iters = ma_fn_names.len() + 1
    let mut iter = 0
    while iter < max_iters {
        if propagate_writes() == 0 {
            iter = max_iters
        }
        iter = iter + 1
    }

    // Step 5: rebuild write lists from matrix
    rebuild_write_lists()
}

// ── Query API ─────────────────────────────────────────────────────────

fn get_fn_write_count(name: Str) -> Int {
    let idx = fn_index(name)
    if idx >= 0 {
        return ma_write_counts.get(idx).unwrap()
    }
    0
}

fn get_fn_write_at(name: Str, wi: Int) -> Str {
    let idx = fn_index(name)
    if idx >= 0 {
        let start = ma_write_starts.get(idx).unwrap()
        return ma_write_items.get(start + wi).unwrap()
    }
    ""
}

fn get_all_globals() -> List[Str] {
    ma_globals
}

fn fn_writes_to(fn_name: Str, global_name: Str) -> Int {
    let idx = fn_index(fn_name)
    if idx >= 0 {
        return fn_has_write(idx, global_name)
    }
    0
}

// ── W0550/W0551 Save/Restore pattern detection ──────────────────────

// Per-block analysis scratch state. Only the saved globals are tracked: W0550's
// per-call gate reads sr_save_global, and W0551's function-scoped gate is
// precomputed by the sr_scan_for_patterns pre-pass (which owns its own scratch).
let mut sr_save_global: List[Str] = []
let mut sr_current_fn: Str = ""

// Function-scoped gating flag (§4.16.7): 1 if ANY block in the current function
// exhibits at least one save→restore pairing. W0551's gating predicate is
// function-wide ("save/restore patterns elsewhere in the function indicates
// speculative intent"), so this is computed in a pre-pass over the whole body
// before any call is checked, then read at each call site.
let mut sr_fn_has_pattern: Int = 0

fn sr_reset() {
    sr_save_global = []
    sr_fn_has_pattern = 0
}

fn sr_add_save(global_name: Str) {
    sr_save_global.push(global_name)
}

fn sr_is_saved_global(name: Str) -> Int {
    let mut i = 0
    while i < sr_save_global.len() {
        if sr_save_global.get(i).unwrap() == name {
            return 1
        }
        i = i + 1
    }
    0
}

// ── Function-scoped save/restore pattern pre-pass ───────────────────
//
// W0551 gates on whether the function is speculative (§4.16.7: "save/restore
// patterns elsewhere in the function"), but the emitting scan checks calls
// interleaved with its block walk — so a call in an early block can't yet know
// a save/restore pattern lives in a later block. This separate pre-pass settles
// sr_fn_has_pattern over the whole body first. It owns private scratch lists so
// it never disturbs the emitting scan's sr_save_global.

let mut srp_save_local: List[Str] = []
let mut srp_save_global: List[Str] = []

fn srp_is_save_local(name: Str) -> Str {
    let mut i = 0
    while i < srp_save_local.len() {
        if srp_save_local.get(i).unwrap() == name {
            return srp_save_global.get(i).unwrap()
        }
        i = i + 1
    }
    ""
}

// Block branch saves/restores srp_save_local/global around the nested scan;
// the recursive descent also sets sr_fn_has_pattern (the accumulated output of
// this pre-pass), an intended broad write outside that pattern.
@allow(UnrestoredMutation, IncompleteStateRestore)
fn sr_scan_for_patterns_block(stmts_sl: Int) {
    if stmts_sl == -1 {
        return
    }
    let outer_l = srp_save_local
    let outer_g = srp_save_global
    srp_save_local = []
    srp_save_global = []

    let num_stmts = sublist_length(stmts_sl)
    let mut i = 0
    while i < num_stmts {
        let stmt = sublist_get(stmts_sl, i)
        let kind = node_kind(stmt)

        if kind == NodeKind.LetBinding {
            let local_name = node_name(stmt)
            let val = node_value(stmt)
            if val != -1 && node_kind(val) == NodeKind.Ident {
                let val_name = node_name(val)
                if is_global(val_name) != 0 {
                    srp_save_local.push(local_name)
                    srp_save_global.push(val_name)
                }
            }
        }

        if kind == NodeKind.Assignment {
            let target = node_target(stmt)
            let val = node_value(stmt)
            if target != -1 && val != -1 {
                if node_kind(target) == NodeKind.Ident && node_kind(val) == NodeKind.Ident {
                    let tname = node_name(target)
                    let vname = node_name(val)
                    let mapped = srp_is_save_local(vname)
                    if mapped != "" && mapped == tname {
                        sr_fn_has_pattern = 1
                    }
                }
            }
        }

        i = i + 1
    }

    // Recurse into nested blocks so a pattern anywhere in the function is found.
    i = 0
    while i < num_stmts {
        sr_scan_for_patterns_node(sublist_get(stmts_sl, i))
        i = i + 1
    }

    srp_save_local = outer_l
    srp_save_global = outer_g
}

fn sr_scan_for_patterns_node(node: Int) {
    if node == -1 {
        return
    }
    let kind = node_kind(node)

    if kind == NodeKind.Block {
        sr_scan_for_patterns_block(node_stmts(node))
        return
    }

    if kind == NodeKind.IfExpr {
        sr_scan_for_patterns_node(node_then_body(node))
        sr_scan_for_patterns_node(node_else_body(node))
        return
    }

    if kind == NodeKind.WhileLoop {
        sr_scan_for_patterns_node(node_body(node))
        return
    }

    if kind == NodeKind.ForIn {
        sr_scan_for_patterns_node(node_body(node))
        return
    }

    if kind == NodeKind.LoopExpr {
        sr_scan_for_patterns_node(node_body(node))
        return
    }

    if kind == NodeKind.MatchExpr {
        let arms_sl = node_arms(node)
        if arms_sl != -1 {
            let mut ai = 0
            while ai < sublist_length(arms_sl) {
                let arm = sublist_get(arms_sl, ai)
                sr_scan_for_patterns_node(node_body(arm))
                ai = ai + 1
            }
        }
        return
    }
}

fn sr_check_call(call_node: Int, callee_name: Str) ! Diag.Report {
    let callee_idx = fn_index(callee_name)
    if callee_idx < 0 {
        return
    }
    let wcount = ma_write_counts.get(callee_idx).unwrap()
    if wcount == 0 {
        return
    }

    let wstart = ma_write_starts.get(callee_idx).unwrap()
    let mut write_items: List[Str] = []
    let mut unsaved: List[Str] = []
    let mut restored: List[Str] = []

    let mut wi = 0
    while wi < wcount {
        let gname = ma_write_items.get(wstart + wi).unwrap()
        write_items.push(gname)
        if sr_is_saved_global(gname) != 0 {
            restored.push(gname)
        } else {
            unsaved.push(gname)
        }
        wi = wi + 1
    }
    let saved_count = restored.len()

    if saved_count > 0 && unsaved.len() > 0 {
        let missing = str_join(unsaved, ", ")
        diag_warn_at_notes(
            "IncompleteStateRestore", INCOMPLETE_STATE_RESTORE,
            "call to '{callee_name}' in '{sr_current_fn}' mutates [{missing}] which are not saved/restored (write-set: {wcount} globals, saved: {saved_count})",
            call_node,
            "also save and restore [{missing}] around this call, or verify the mutation is intentional",
            ["`{callee_name}` writes \{{str_join(write_items, ", ")}}", "only [{str_join(restored, ", ")}] is restored after the call"]
        )
    }

    if saved_count == 0 && sr_fn_has_pattern != 0 {
        let all_writes = str_join(write_items, ", ")
        diag_warn_at_notes(
            "UnrestoredMutation", UNRESTORED_MUTATION,
            "call to '{callee_name}' in '{sr_current_fn}' mutates [{all_writes}]; these are not saved/restored for this call, though this function uses a save/restore pattern elsewhere",
            call_node,
            "if this call is speculative, save and restore the affected globals; otherwise verify the mutation is intentional",
            ["`{callee_name}` writes \{{all_writes}}"]
        )
    }
}

fn sr_scan_stmts(stmts_sl: Int) ! Diag.Report {
    if stmts_sl == -1 {
        return
    }
    let num_stmts = sublist_length(stmts_sl)
    let mut i = 0

    // Pass 1: collect the block's saves (`let local = global`). Restores are
    // not tracked here — W0550's per-call gate reads sr_save_global directly,
    // and W0551's function-scoped gate is precomputed by sr_scan_for_patterns.
    while i < num_stmts {
        let stmt = sublist_get(stmts_sl, i)
        let kind = node_kind(stmt)

        if kind == NodeKind.LetBinding {
            let val = node_value(stmt)
            if val != -1 && node_kind(val) == NodeKind.Ident {
                let val_name = node_name(val)
                if is_global(val_name) != 0 {
                    sr_add_save(val_name)
                }
            }
        }

        i = i + 1
    }

    // Pass 2: check each call against the save/restore sets
    i = 0
    while i < num_stmts {
        let stmt = sublist_get(stmts_sl, i)
        let kind = node_kind(stmt)

        if kind == NodeKind.ExprStmt {
            let inner = node_value(stmt)
            if inner != -1 {
                let ik = node_kind(inner)
                if ik == NodeKind.Call {
                    let callee = node_left(inner)
                    let cname = extract_ident_name(callee)
                    if cname.is_some() {
                        sr_check_call(inner, cname.unwrap())
                    }
                }
            }
        }

        if kind == NodeKind.Call {
            let callee = node_left(stmt)
            let cname = extract_ident_name(callee)
            if cname.is_some() {
                sr_check_call(stmt, cname.unwrap())
            }
        }

        i = i + 1
    }

    // Pass 3: recurse into nested blocks (if, while, match, etc.)
    i = 0
    while i < num_stmts {
        let stmt = sublist_get(stmts_sl, i)
        sr_scan_node(stmt)
        i = i + 1
    }
}

// Block branch saves/restores sr_save_global around the nested scan;
// sr_scan_stmts also writes diag_* globals outside that pattern, which the
// analyzer correctly flags.
@allow(UnrestoredMutation, IncompleteStateRestore)
fn sr_scan_node(node: Int) ! Diag.Report {
    if node == -1 {
        return
    }
    let kind = node_kind(node)

    if kind == NodeKind.Block {
        let outer_saves_g = sr_save_global
        sr_save_global = []
        sr_scan_stmts(node_stmts(node))
        sr_save_global = outer_saves_g
        return
    }

    if kind == NodeKind.IfExpr {
        sr_scan_node(node_then_body(node))
        sr_scan_node(node_else_body(node))
        return
    }

    if kind == NodeKind.WhileLoop {
        sr_scan_node(node_body(node))
        return
    }

    if kind == NodeKind.ForIn {
        sr_scan_node(node_body(node))
        return
    }

    if kind == NodeKind.LoopExpr {
        sr_scan_node(node_body(node))
        return
    }

    if kind == NodeKind.MatchExpr {
        let arms_sl = node_arms(node)
        if arms_sl != -1 {
            let mut ai = 0
            while ai < sublist_length(arms_sl) {
                let arm = sublist_get(arms_sl, ai)
                sr_scan_node(node_body(arm))
                ai = ai + 1
            }
        }
        return
    }
}

// Genuine save/restore of diag_source_file (saved 826, restored 842): the
// sibling broad-write calls (diag_push_allows/sr_reset/diag_clear_allows) write
// other globals outside that pattern, which the analyzer correctly flags.
@allow(UnrestoredMutation, IncompleteStateRestore)
fn sr_analyze_fn(fn_node: Int) ! Diag.Report {
    sr_current_fn = node_name(fn_node)
    let saved_source = diag_source_file
    diag_source_file = diag_file_for_node(fn_node)
    diag_push_allows(fn_node)
    sr_reset()
    let body = node_body(fn_node)
    if body == -1 {
        return
    }
    let body_kind = node_kind(body)
    if body_kind == NodeKind.Block {
        let body_stmts = node_stmts(body)
        // Pre-pass: determine whether the function is speculative (has any
        // save/restore pattern) before any call is checked, since the pattern
        // may live in a block scanned after an early call (§4.16.7).
        sr_scan_for_patterns_block(body_stmts)
        sr_scan_stmts(body_stmts)
    }
    diag_clear_allows()
    diag_source_file = saved_source
}

pub fn analyze_save_restore(program: Int) ! Diag.Report {
    let fns_sl = node_params(program)
    if fns_sl == -1 {
        return
    }
    let mut i = 0
    while i < sublist_length(fns_sl) {
        sr_analyze_fn(sublist_get(fns_sl, i))
        i = i + 1
    }
}
