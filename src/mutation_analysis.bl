import ast.{NodeKind}
import std.str.{str_join}
import parser.{
    node_kind, node_name, node_left, node_right, node_body, node_condition,
    node_then_body, node_else_body, node_scrutinee, node_guard, node_value,
    node_target, node_iterable, node_is_mut, node_start, node_end, node_obj,
    node_method, node_index, node_params, node_args, node_stmts, node_arms,
    node_fields, node_elements, node_line, node_col, node_binder_col,
    node_push_value_child_ids, sublist_get, sublist_length,
}
import typecheck.{
    tc_call_decl_is_fn, tc_call_decl_node, tc_call_declared_name, tc_global_decl_node,
    tc_ident_binder_node, tc_let_binder_is_discard, tc_prelude_carrier_of, tc_ticked_names,
}
import diagnostics.{
    Diag, diag_warn_at_notes, diag_source_file, diag_file_for_node,
    diag_push_allows, diag_clear_allows,
    INCOMPLETE_STATE_RESTORE, UNRESTORED_MUTATION,
}

// mutation_analysis.bl — Tier 1 write-set inference for Blink modules
//
// Walks the AST after parsing to determine which module-level mutable
// bindings each function may write to (directly or transitively via
// intra-module calls). Results are stored for diagnostics/LSP.

// ── Parallel-array storage ────────────────────────────────────────────

let mut ma_fn_names: List[Str] = []
let mut ma_write_items: List[Str] = []
let mut ma_write_starts: List[Int] = []
let mut ma_write_counts: List[Int] = []

let mut ma_globals: List[Str] = []

// Call edges stored as indices (not names) for O(1) propagation
let mut ma_call_edges_from: List[Int] = []
let mut ma_call_edges_to: List[Int] = []

// Hash maps for O(1) lookups
let mut fn_name_map: Map[Str, Int] = Map()
let mut global_set: Map[Str, Int] = Map()
let mut global_idx_map: Map[Str, Int] = Map()

let mut mutating_method_set: Map[Str, Int] = Map()

pub fn ma_state_len() -> Int {
    ma_fn_names.len()
}

fn init_mutating_methods() {
    if mutating_method_set.len() > 0 {
        return
    }
    mutating_method_set.insert("push", 1)
    mutating_method_set.insert("pop", 1)
    mutating_method_set.insert("append", 1)
    mutating_method_set.insert("clear", 1)
    mutating_method_set.insert("insert", 1)
    mutating_method_set.insert("remove", 1)
    mutating_method_set.insert("set", 1)
}

fn is_mutating_method(name: Str) -> Int {
    mutating_method_set.contains_key(name)
}

fn is_global(name: Str) -> Int {
    global_set.contains_key(name)
}

fn fn_index(name: Str) -> Int {
    fn_name_map.get(name) ?? -1
}

fn global_index(name: Str) -> Int {
    global_idx_map.get(name) ?? -1
}

// One bit per (fn, global), 64 globals to a word: writes_bits[fn_idx * writes_words + gi / 64].
// A dense Int per cell cost the compiler's own check about 1.6M cells to fill on every run.
// U64, not Int: a signed 1 << 63 lowers to a C shift into the sign bit, which C leaves undefined.
let mut writes_bits: List[U64] = []
let mut writes_words: Int = 0

// Sparse mirror of writes_bits so propagate_writes can iterate just
// the callee's writes (typically <5) instead of all globals.
let mut fn_writes_idx: List[List[Int]] = []

fn mat_has_write(fn_idx: Int, gi: Int) -> Int {
    let word = writes_bits.get(fn_idx * writes_words + gi / 64).unwrap()
    if (word & (1.to_u64() << (gi % 64).to_u32())) != 0.to_u64() {
        return 1
    }
    0
}

fn mat_set_write(fn_idx: Int, gi: Int) {
    let wi = fn_idx * writes_words + gi / 64
    writes_bits.set(wi, writes_bits.get(wi).unwrap() | (1.to_u64() << (gi % 64).to_u32()))
    fn_writes_idx.get(fn_idx).unwrap().push(gi)
}

fn fn_has_write(fn_idx: Int, global_name: Str) -> Int {
    let gi = global_index(global_name)
    if gi < 0 {
        return 0
    }
    mat_has_write(fn_idx, gi)
}

fn add_write(fn_idx: Int, global_name: Str) {
    let gi = global_index(global_name)
    if gi < 0 {
        return
    }
    if mat_has_write(fn_idx, gi) != 0 {
        return
    }
    mat_set_write(fn_idx, gi)
    ma_write_items.push(global_name)
    ma_write_counts.set(fn_idx, ma_write_counts.get(fn_idx).unwrap() + 1)
}

// ── AST walking ───────────────────────────────────────────────────────

fn extract_ident_name(node: Int) -> Option[Str] {
    if node == -1 {
        return None
    }
    if node_kind(node) == NodeKind.Ident {
        return Some(node_name(node))
    }
    None
}

fn walk_expr(node: Int, fn_idx: Int) {
    if node == -1 {
        return
    }
    let kind = node_kind(node)

    if kind == NodeKind.Assignment || kind == NodeKind.CompoundAssign {
        let target = node_target(node)
        if target != -1 {
            let tk = node_kind(target)
            if tk == NodeKind.Ident {
                let tname = node_name(target)
                if is_global(tname) != 0 {
                    add_write(fn_idx, tname)
                }
            }
            if tk == NodeKind.FieldAccess {
                let obj = node_obj(target)
                if obj != -1 && node_kind(obj) == NodeKind.Ident {
                    let oname = node_name(obj)
                    if is_global(oname) != 0 {
                        add_write(fn_idx, oname)
                    }
                }
            }
            if tk == NodeKind.IndexExpr {
                let obj = node_obj(target)
                if obj != -1 && node_kind(obj) == NodeKind.Ident {
                    let oname = node_name(obj)
                    if is_global(oname) != 0 {
                        add_write(fn_idx, oname)
                    }
                }
            }
        }
        walk_expr(node_value(node), fn_idx)
        return
    }

    if kind == NodeKind.MethodCall {
        let obj = node_obj(node)
        let method = node_method(node)
        if obj != -1 && node_kind(obj) == NodeKind.Ident {
            let oname = node_name(obj)
            if is_global(oname) != 0 && is_mutating_method(method) != 0 {
                add_write(fn_idx, oname)
            }
        }
        walk_expr(obj, fn_idx)
        let args_sl = node_args(node)
        if args_sl != -1 {
            let mut ai = 0
            while ai < sublist_length(args_sl) {
                walk_expr(sublist_get(args_sl, ai), fn_idx)
                ai = ai + 1
            }
        }
        return
    }

    if kind == NodeKind.Call {
        let callee = node_left(node)
        let callee_name = extract_ident_name(callee)
        if callee_name.is_some() {
            let callee_idx = fn_index(callee_name.unwrap())
            if callee_idx >= 0 {
                ma_call_edges_from.push(fn_idx)
                ma_call_edges_to.push(callee_idx)
            }
        }
        walk_expr(callee, fn_idx)
        let args_sl = node_args(node)
        if args_sl != -1 {
            let mut ai = 0
            while ai < sublist_length(args_sl) {
                walk_expr(sublist_get(args_sl, ai), fn_idx)
                ai = ai + 1
            }
        }
        return
    }

    if kind == NodeKind.BinOp {
        walk_expr(node_left(node), fn_idx)
        walk_expr(node_right(node), fn_idx)
        return
    }

    if kind == NodeKind.UnaryOp {
        walk_expr(node_left(node), fn_idx)
        return
    }

    if kind == NodeKind.IfExpr {
        walk_expr(node_condition(node), fn_idx)
        walk_expr(node_then_body(node), fn_idx)
        walk_expr(node_else_body(node), fn_idx)
        return
    }

    if kind == NodeKind.Block {
        walk_stmts(node_stmts(node), fn_idx)
        return
    }

    if kind == NodeKind.LetBinding {
        walk_expr(node_value(node), fn_idx)
        return
    }

    if kind == NodeKind.ExprStmt {
        walk_expr(node_value(node), fn_idx)
        return
    }

    if kind == NodeKind.Return {
        walk_expr(node_value(node), fn_idx)
        return
    }

    if kind == NodeKind.ForIn {
        walk_expr(node_iterable(node), fn_idx)
        walk_expr(node_body(node), fn_idx)
        return
    }

    if kind == NodeKind.WhileLoop {
        walk_expr(node_condition(node), fn_idx)
        walk_expr(node_body(node), fn_idx)
        return
    }

    if kind == NodeKind.LoopExpr {
        walk_expr(node_body(node), fn_idx)
        return
    }

    if kind == NodeKind.MatchExpr {
        walk_expr(node_scrutinee(node), fn_idx)
        let arms_sl = node_arms(node)
        if arms_sl != -1 {
            let mut ai = 0
            while ai < sublist_length(arms_sl) {
                let arm = sublist_get(arms_sl, ai)
                walk_expr(node_guard(arm), fn_idx)
                walk_expr(node_body(arm), fn_idx)
                ai = ai + 1
            }
        }
        return
    }

    if kind == NodeKind.FieldAccess {
        walk_expr(node_obj(node), fn_idx)
        return
    }

    if kind == NodeKind.IndexExpr {
        walk_expr(node_obj(node), fn_idx)
        walk_expr(node_index(node), fn_idx)
        return
    }

    if kind == NodeKind.TupleLit || kind == NodeKind.ListLit {
        let elems_sl = node_elements(node)
        if elems_sl != -1 {
            let mut ei = 0
            while ei < sublist_length(elems_sl) {
                walk_expr(sublist_get(elems_sl, ei), fn_idx)
                ei = ei + 1
            }
        }
        return
    }

    if kind == NodeKind.StructLit {
        let fields_sl = node_fields(node)
        if fields_sl != -1 {
            let mut fi = 0
            while fi < sublist_length(fields_sl) {
                let fld = sublist_get(fields_sl, fi)
                walk_expr(node_value(fld), fn_idx)
                fi = fi + 1
            }
        }
        return
    }

    if kind == NodeKind.Closure {
        walk_expr(node_body(node), fn_idx)
        return
    }

    if kind == NodeKind.InterpString {
        let parts_sl = node_elements(node)
        if parts_sl != -1 {
            let mut pi = 0
            while pi < sublist_length(parts_sl) {
                walk_expr(sublist_get(parts_sl, pi), fn_idx)
                pi = pi + 1
            }
        }
        return
    }

    if kind == NodeKind.RangeLit {
        walk_expr(node_start(node), fn_idx)
        walk_expr(node_end(node), fn_idx)
        return
    }

    if kind == NodeKind.WithBlock {
        walk_expr(node_body(node), fn_idx)
        return
    }
}

fn walk_stmts(stmts_sl: Int, fn_idx: Int) {
    if stmts_sl == -1 {
        return
    }
    let mut i = 0
    while i < sublist_length(stmts_sl) {
        walk_expr(sublist_get(stmts_sl, i), fn_idx)
        i = i + 1
    }
}

// ── Transitive closure ────────────────────────────────────────────────

// A worklist over reverse call edges: a fn is pushed to its callers once at the start and
// again only after its own set grows. Repeated sweeps over every edge cost one pass per link
// of the longest call chain. Both reach the least fixpoint, which does not depend on order.
fn propagate_writes() {
    let n_fns = ma_fn_names.len()
    let n_edges = ma_call_edges_from.len()
    let mut caller_starts: List[Int] = List.with_capacity(n_fns + 1)
    let mut fi = 0
    while fi <= n_fns {
        caller_starts.push(0)
        fi = fi + 1
    }
    let mut ei = 0
    while ei < n_edges {
        let callee_idx = ma_call_edges_to.get(ei).unwrap()
        caller_starts.set(callee_idx + 1, caller_starts.get(callee_idx + 1).unwrap() + 1)
        ei = ei + 1
    }
    fi = 0
    while fi < n_fns {
        caller_starts.set(fi + 1, caller_starts.get(fi + 1).unwrap() + caller_starts.get(fi).unwrap())
        fi = fi + 1
    }
    let mut fill: List[Int] = List.with_capacity(n_fns)
    let mut callers: List[Int] = List.with_capacity(n_edges)
    fi = 0
    while fi < n_fns {
        fill.push(caller_starts.get(fi).unwrap())
        fi = fi + 1
    }
    ei = 0
    while ei < n_edges {
        callers.push(0)
        ei = ei + 1
    }
    ei = 0
    while ei < n_edges {
        let callee_idx = ma_call_edges_to.get(ei).unwrap()
        let slot = fill.get(callee_idx).unwrap()
        callers.set(slot, ma_call_edges_from.get(ei).unwrap())
        fill.set(callee_idx, slot + 1)
        ei = ei + 1
    }

    let mut queue: List[Int] = []
    let mut queued: List[Int] = List.with_capacity(n_fns)
    fi = 0
    while fi < n_fns {
        if fn_writes_idx.get(fi).unwrap().len() > 0 {
            queue.push(fi)
            queued.push(1)
        } else {
            queued.push(0)
        }
        fi = fi + 1
    }
    let mut head = 0
    while head < queue.len() {
        let callee_idx = queue.get(head).unwrap()
        head = head + 1
        queued.set(callee_idx, 0)
        let callee_writes = fn_writes_idx.get(callee_idx).unwrap()
        // Snapshot length: a self edge grows the list being read.
        let n_writes = callee_writes.len()
        let mut ci = caller_starts.get(callee_idx).unwrap()
        let ci_end = caller_starts.get(callee_idx + 1).unwrap()
        while ci < ci_end {
            let caller_idx = callers.get(ci).unwrap()
            let mut grew = 0
            let mut wi = 0
            while wi < n_writes {
                let gi = callee_writes.get(wi).unwrap()
                if mat_has_write(caller_idx, gi) == 0 {
                    mat_set_write(caller_idx, gi)
                    grew = 1
                }
                wi = wi + 1
            }
            if grew != 0 && queued.get(caller_idx).unwrap() == 0 {
                queue.push(caller_idx)
                queued.set(caller_idx, 1)
            }
            ci = ci + 1
        }
    }
}

// Reads each fn's words low bit first, so every write list is in declaration order, the
// order W0550 and W0551 print.
fn rebuild_write_lists() {
    ma_write_items = []
    ma_write_starts = []
    ma_write_counts = []
    let mut fi = 0
    while fi < ma_fn_names.len() {
        let start = ma_write_items.len()
        ma_write_starts.push(start)
        let mut count = 0
        let mut wd = 0
        while wd < writes_words {
            let word = writes_bits.get(fi * writes_words + wd).unwrap()
            if word != 0.to_u64() {
                let mut b = 0
                while b < 64 {
                    if (word & (1.to_u64() << b.to_u32())) != 0.to_u64() {
                        ma_write_items.push(ma_globals.get(wd * 64 + b).unwrap())
                        count = count + 1
                    }
                    b = b + 1
                }
            }
            wd = wd + 1
        }
        ma_write_counts.push(count)
        fi = fi + 1
    }
}

// ── Entry point ───────────────────────────────────────────────────────

pub fn analyze_mutations(program: Int) {
    init_mutating_methods()

    ma_fn_names = []
    ma_write_items = []
    ma_write_starts = []
    ma_write_counts = []
    ma_globals = []
    ma_call_edges_from = []
    ma_call_edges_to = []
    fn_writes_idx = []
    fn_name_map = Map()
    global_set = Map()
    global_idx_map = Map()

    // Step 1: collect module-level let mut bindings
    let lets_sl = node_stmts(program)
    if lets_sl != -1 {
        let mut i = 0
        while i < sublist_length(lets_sl) {
            let let_node = sublist_get(lets_sl, i)
            if node_kind(let_node) == NodeKind.LetBinding && node_is_mut(let_node) != 0 {
                let gname = node_name(let_node)
                ma_globals.push(gname)
                global_set.insert(gname, 1)
                global_idx_map.insert(gname, ma_globals.len() - 1)
            }
            i = i + 1
        }
    }

    // Step 2: register all function names
    let fns_sl = node_params(program)
    if fns_sl != -1 {
        let mut i = 0
        while i < sublist_length(fns_sl) {
            let fn_node = sublist_get(fns_sl, i)
            let fname = node_name(fn_node)
            ma_fn_names.push(fname)
            fn_name_map.insert(fname, i)
            ma_write_starts.push(0)
            ma_write_counts.push(0)
            fn_writes_idx.push([])
            i = i + 1
        }
    }

    writes_words = (ma_globals.len() + 63) / 64
    let bits_size = ma_fn_names.len() * writes_words
    writes_bits = List.with_capacity(bits_size)
    let mut mi = 0
    while mi < bits_size {
        writes_bits.push(0.to_u64())
        mi = mi + 1
    }

    // Step 3: walk each function body to find direct writes and call edges
    if fns_sl != -1 {
        let mut i = 0
        while i < sublist_length(fns_sl) {
            let fn_node = sublist_get(fns_sl, i)
            let body = node_body(fn_node)
            walk_expr(body, i)
            i = i + 1
        }
    }

    // Step 4: transitive closure — propagate callee writes to callers
    propagate_writes()

    // Step 5: rebuild write lists from the bits
    rebuild_write_lists()
}

// ── Query API ─────────────────────────────────────────────────────────

fn get_fn_write_count(name: Str) -> Int {
    let idx = fn_index(name)
    if idx >= 0 {
        return ma_write_counts.get(idx).unwrap()
    }
    0
}

fn get_fn_write_at(name: Str, wi: Int) -> Str {
    let idx = fn_index(name)
    if idx >= 0 {
        let start = ma_write_starts.get(idx).unwrap()
        return ma_write_items.get(start + wi).unwrap()
    }
    ""
}

fn get_all_globals() -> List[Str] {
    ma_globals
}

fn fn_writes_to(fn_name: Str, global_name: Str) -> Int {
    let idx = fn_index(fn_name)
    if idx >= 0 {
        return fn_has_write(idx, global_name)
    }
    0
}

// ── W0550/W0551 Save/Restore pattern detection ──────────────────────
//
// §4.16.7 reads the text of one function. One walk records, in source order, each
// save, each assignment to a module global and each call. An event's index in the
// lists is its place in the text, so "after the save" and "before the restore"
// compare indexes. Pairs, their class and each call's check come from the events
// once the walk is done. Names resolve through typecheck's tables: a parameter, a
// pattern binder or a shadowing local spelled like a global or a fn is neither.

type SrEventKind {
    Save, Assign, Call,
}

type SrWalk {
    kinds: List[SrEventKind],
    // The global a save or an assignment names, or the module fn a call reaches ("" for
    // any other callee). Write sets are keyed by these names.
    names: List[Str],
    nodes: List[Int],
    // The declaration of the global a save or an assignment names, else -1.
    decls: List[Int],
    // For an assignment that restores: the index of the save event it restores.
    restores: List[Int],
    // The save event a save local still holds, keyed by the local's binder node.
    held: Map[Int, Int],
    // The program's fns, in the order the write-set tables index them.
    fns: Int,
}

fn sr_walk_new(fns: Int) -> SrWalk {
    SrWalk { kinds: [], names: [], nodes: [], decls: [], restores: [], held: Map(), fns: fns }
}

fn sr_push_event(w: SrWalk, kind: SrEventKind, name: Str, node: Int, decl: Int, restores: Int) {
    w.kinds.push(kind)
    w.names.push(name)
    w.nodes.push(node)
    w.decls.push(decl)
    w.restores.push(restores)
}

// The module `let mut` this ident reads or assigns, or -1.
fn sr_global_decl(ident: Int) -> Int {
    let decl = tc_global_decl_node(ident)
    if decl < 0 || is_global(node_name(decl)) == 0 {
        return -1
    }
    decl
}

// The global that a save's value reads: `G` or `G.clone()`, else -1.
fn sr_saved_global(val: Int) -> Int {
    if val == -1 {
        return -1
    }
    let kind = node_kind(val)
    if kind == NodeKind.Ident {
        return sr_global_decl(val)
    }
    if kind == NodeKind.MethodCall && node_method(val) == "clone" {
        let args = node_args(val)
        let obj = node_obj(val)
        if (args == -1 || sublist_length(args) == 0) && obj != -1 && node_kind(obj) == NodeKind.Ident {
            return sr_global_decl(obj)
        }
    }
    -1
}

// The module fn a call reaches, as the write-set tables name it, else "". A namesake in
// another module, a closure value or a builtin has no write set here.
fn sr_module_fn(w: SrWalk, call: Int) -> Str {
    if !tc_call_decl_is_fn(call) {
        return ""
    }
    let name = tc_call_declared_name(call)
    let idx = fn_index(name)
    if idx < 0 || sublist_get(w.fns, idx) != tc_call_decl_node(call) {
        return ""
    }
    name
}

fn sr_walk_children(w: SrWalk, node: Int, kids: List[Int]) {
    let base = kids.len()
    node_push_value_child_ids(node, kids)
    let end = kids.len()
    let mut i = base
    while i < end {
        sr_walk_node(w, kids.get(i).unwrap(), kids)
        i = i + 1
    }
    sr_drop_kids_to(kids, base)
}

fn sr_walk_let(w: SrWalk, node: Int, kids: List[Int]) {
    let val = node_value(node)
    sr_walk_node(w, val, kids)
    // A destructuring `let` and `let _` bind no one name that a restore could read.
    let local = node_name(node)
    if local == "" || local == "_destructure" || tc_let_binder_is_discard(node) != 0 {
        return
    }
    let decl = sr_saved_global(val)
    if decl >= 0 {
        w.held.insert(node, w.kinds.len())
        sr_push_event(w, SrEventKind.Save, node_name(decl), node, decl, -1)
    }
}

// The ident a place is rooted at: `x` for `x`, `x.f`, `x[i]` and `x.f[i].g`, else -1.
fn sr_place_root(place: Int) -> Int {
    let mut root = place
    while root != -1 && (node_kind(root) == NodeKind.FieldAccess || node_kind(root) == NodeKind.IndexExpr) {
        root = node_obj(root)
    }
    if root != -1 && node_kind(root) == NodeKind.Ident { root } else { -1 }
}

fn sr_walk_assign(w: SrWalk, node: Int, kids: List[Int]) {
    let target = node_target(node)
    let val = node_value(node)
    sr_walk_node(w, val, kids)
    if target == -1 {
        return
    }
    let whole = node_kind(target) == NodeKind.Ident
    if !whole {
        sr_walk_node(w, target, kids)
    }
    let root = sr_place_root(target)
    if root == -1 {
        return
    }
    let binder = tc_ident_binder_node(root)
    if binder >= 0 {
        // The local no longer holds the saved value, so `G = local` after this is no restore.
        let _ = w.held.remove(binder)
        return
    }
    let decl = sr_global_decl(root)
    if decl < 0 {
        return
    }
    // A field or element assignment gives G a new value too; only `G = x` restores.
    let mut restores = -1
    if whole && node_kind(node) == NodeKind.Assignment && val != -1 && node_kind(val) == NodeKind.Ident {
        let save = w.held.get(tc_ident_binder_node(val)) ?? -1
        if save >= 0 && w.decls.get(save).unwrap() == decl {
            restores = save
        }
    }
    sr_push_event(w, SrEventKind.Assign, node_name(decl), node, decl, restores)
}

fn sr_walk_node(w: SrWalk, node: Int, kids: List[Int]) {
    if node == -1 {
        return
    }
    let kind = node_kind(node)
    if sr_body_runs_later(kind) != 0 {
        return
    }
    if kind == NodeKind.Block {
        let stmts = node_stmts(node)
        if stmts != -1 {
            let mut i = 0
            while i < sublist_length(stmts) {
                sr_walk_node(w, sublist_get(stmts, i), kids)
                i = i + 1
            }
        }
        return
    }
    if kind == NodeKind.LetBinding {
        sr_walk_let(w, node, kids)
        return
    }
    if kind == NodeKind.Assignment || kind == NodeKind.CompoundAssign {
        sr_walk_assign(w, node, kids)
        return
    }
    // A call runs after its arguments, so its event comes after theirs.
    sr_walk_children(w, node, kids)
    if kind == NodeKind.MethodCall {
        sr_push_event(w, SrEventKind.Call, "", node, -1, -1)
    }
    if kind == NodeKind.Call && !sr_is_ctor(node) {
        sr_push_event(w, SrEventKind.Call, sr_module_fn(w, node), node, -1, -1)
    }
}

// A variant constructor builds a value and runs no code. A prelude variant resolves to no
// declaration, so its spelling decides unless a local takes that name.
fn sr_is_ctor(call: Int) -> Bool {
    let decl = tc_call_decl_node(call)
    if decl >= 0 {
        return node_kind(decl) == NodeKind.TypeVariant
    }
    let callee = node_left(call)
    callee != -1 && node_kind(callee) == NodeKind.Ident && tc_ident_binder_node(callee) < 0 && tc_prelude_carrier_of(node_name(callee)).is_some()
}

// A closure or nested fn body does not run where it is defined, so the saves
// around the definition do not cover the calls inside it.
fn sr_body_runs_later(kind: NodeKind) -> Int {
    if kind == NodeKind.Closure || kind == NodeKind.FnDef { 1 } else { 0 }
}

fn sr_drop_kids_to(kids: List[Int], base: Int) {
    while kids.len() > base {
        let _ = kids.pop()
    }
}

// The pairs of one function: pair i is the save at events[saves[i]] and the restore
// at events[restore_at[i]].
type SrPairs {
    saves: List[Int],
    restore_at: List[Int],
    // The first assignment to G after the save and before the restore, or -1.
    first_assign: List[Int],
    // The first call after the save and before the restore, or -1.
    first_call: List[Int],
}

fn sr_find_pairs(w: SrWalk) -> SrPairs {
    let p = SrPairs { saves: [], restore_at: [], first_assign: [], first_call: [] }
    let mut r = 0
    while r < w.kinds.len() {
        let s = w.restores.get(r).unwrap()
        if w.kinds.get(r).unwrap() == SrEventKind.Assign && s >= 0 {
            let decl = w.decls.get(s).unwrap()
            let mut first_assign = -1
            let mut first_call = -1
            let mut e = s + 1
            while e < r {
                let k = w.kinds.get(e).unwrap()
                if first_assign < 0 && k == SrEventKind.Assign && w.decls.get(e).unwrap() == decl {
                    first_assign = e
                }
                if first_call < 0 && k == SrEventKind.Call {
                    first_call = e
                }
                e = e + 1
            }
            p.saves.push(s)
            p.restore_at.push(r)
            p.first_assign.push(first_assign)
            p.first_call.push(first_call)
        }
        r = r + 1
    }
    p
}

fn sr_pair_around(p: SrPairs, i: Int, call: Int) -> Bool {
    p.saves.get(i).unwrap() < call && call < p.restore_at.get(i).unwrap()
}

fn sr_pair_in_binding_at(p: SrPairs, i: Int, call: Int) -> Bool {
    let a = p.first_assign.get(i).unwrap()
    sr_pair_around(p, i, call) && a >= 0 && a < call
}

// A binding pair has a call between and is in a binding at each such call; the
// first call decides, since a later call comes after the same assignment.
fn sr_pair_is_binding(p: SrPairs, i: Int) -> Bool {
    let a = p.first_assign.get(i).unwrap()
    let c = p.first_call.get(i).unwrap()
    c >= 0 && a >= 0 && a < c
}

fn sr_pos(node: Int) -> Str {
    "{node_line(node)}:{node_col(node)}"
}

// A save is placed at its binder, the name the restore reads back.
fn sr_save_pos(node: Int) -> Str {
    let col = node_binder_col(node)
    if col < 0 { sr_pos(node) } else { "{node_line(node)}:{col}" }
}

// The note that names a speculative pair and says why it is not a binding. `call` is
// the call the warning is at.
fn sr_pair_note(w: SrWalk, p: SrPairs, i: Int, call: Int) -> Str {
    let s = p.saves.get(i).unwrap()
    let global = w.names.get(s).unwrap()
    let head = "`{global}` is saved at {sr_save_pos(w.nodes.get(s).unwrap())} and restored at {sr_pos(w.nodes.get(p.restore_at.get(i).unwrap()).unwrap())}"
    let a = p.first_assign.get(i).unwrap()
    if a < 0 {
        return "{head} with no new value set between (speculative pair)"
    }
    let first_call = p.first_call.get(i).unwrap()
    if first_call < 0 {
        return "{head} with no call between (speculative pair)"
    }
    let early = if sr_pair_around(p, i, call) && call < a { call } else { first_call }
    "{head}, and the call at {sr_pos(w.nodes.get(early).unwrap())} comes before its new value at {sr_pos(w.nodes.get(a).unwrap())} (speculative pair)"
}

fn sr_help(unsaved: List[Str]) -> Str {
    "save and restore {tc_ticked_names(unsaved)} around the call\nif the function sets a global for this call, assign that global between its save and this call"
}

fn sr_check_call(w: SrWalk, p: SrPairs, ev: Int, fn_name: Str, speculative_pair: Int) ! Diag.Report {
    let callee = w.names.get(ev).unwrap()
    if callee == "" {
        return
    }
    let call_node = w.nodes.get(ev).unwrap()
    let callee_idx = fn_index(callee)
    let wcount = ma_write_counts.get(callee_idx).unwrap()
    if wcount == 0 {
        return
    }

    // Each call is checked only against the speculative pairs around it; a pair in a
    // binding here adds nothing, and the restore drops the callee's write to its G.
    let mut checked: List[Str] = []
    let mut bound: List[Str] = []
    // The W0551 note names the first speculative pair around this call; a call outside
    // every pair gets the function's first speculative pair, the one that armed the gate.
    let mut note_pair = speculative_pair
    // The W0550 note names the first speculative pair around this call that restores a
    // global the callee writes.
    let mut restored_pair = -1
    let mut i = 0
    while i < p.saves.len() {
        if sr_pair_around(p, i, ev) {
            let global = w.names.get(p.saves.get(i).unwrap()).unwrap()
            if sr_pair_in_binding_at(p, i, ev) {
                bound.push(global)
            } else {
                if checked.len() == 0 {
                    note_pair = i
                }
                if restored_pair < 0 && fn_has_write(callee_idx, global) != 0 {
                    restored_pair = i
                }
                checked.push(global)
            }
        }
        i = i + 1
    }

    let wstart = ma_write_starts.get(callee_idx).unwrap()
    let mut write_items: List[Str] = []
    let mut unsaved: List[Str] = []
    let mut restored: List[Str] = []
    let mut wi = 0
    while wi < wcount {
        let gname = ma_write_items.get(wstart + wi).unwrap()
        write_items.push(gname)
        if checked.contains(gname) {
            restored.push(gname)
        } else if !bound.contains(gname) {
            unsaved.push(gname)
        }
        wi = wi + 1
    }
    if unsaved.len() == 0 {
        return
    }
    let writes_note = "`{callee}` writes \{{str_join(write_items, ", ")}}"
    let missing = str_join(unsaved, ", ")

    if restored.len() > 0 {
        diag_warn_at_notes(
            "IncompleteStateRestore", INCOMPLETE_STATE_RESTORE,
            "call to `{callee}` in `{fn_name}` mutates [{missing}] which are not saved/restored (write-set: {wcount} globals, saved: {restored.len()})",
            call_node,
            sr_help(unsaved),
            [sr_pair_note(w, p, restored_pair, ev), writes_note, "only [{str_join(restored, ", ")}] is restored after the call"]
        )
        return
    }

    if speculative_pair < 0 {
        return
    }
    diag_warn_at_notes(
        "UnrestoredMutation", UNRESTORED_MUTATION,
        "call to `{callee}` in `{fn_name}` mutates [{missing}]; these are not saved/restored for this call, though this function uses a save/restore pattern elsewhere",
        call_node,
        sr_help(unsaved),
        [sr_pair_note(w, p, note_pair, ev), writes_note]
    )
}

// The value this function assigns to diag_source_file comes from a call, and §4.16.7
// reads a call in the assigned value as coming before the new value. So the pair is
// speculative, and the lint checks the calls that write the allow stack against it.
@allow(UnrestoredMutation, IncompleteStateRestore)
fn sr_analyze_fn(fn_node: Int, fns: Int) ! Diag.Report {
    let body = node_body(fn_node)
    if body == -1 || node_kind(body) != NodeKind.Block {
        return
    }
    let w = sr_walk_new(fns)
    let mut kids: List[Int] = []
    sr_walk_node(w, body, kids)
    let p = sr_find_pairs(w)

    // W0551's gate: the first speculative pair. With none, no call has a pair to be
    // checked against, so neither warning can fire.
    let mut speculative_pair = -1
    let mut i = 0
    while i < p.saves.len() && speculative_pair < 0 {
        if !sr_pair_is_binding(p, i) {
            speculative_pair = i
        }
        i = i + 1
    }
    if speculative_pair < 0 {
        return
    }

    let fn_name = node_name(fn_node)
    let saved_source = diag_source_file
    diag_source_file = diag_file_for_node(fn_node)
    diag_push_allows(fn_node)
    let mut ev = 0
    while ev < w.kinds.len() {
        if w.kinds.get(ev).unwrap() == SrEventKind.Call {
            sr_check_call(w, p, ev, fn_name, speculative_pair)
        }
        ev = ev + 1
    }
    diag_clear_allows()
    diag_source_file = saved_source
}

pub fn analyze_save_restore(program: Int) ! Diag.Report {
    let fns_sl = node_params(program)
    if fns_sl == -1 {
        return
    }
    let mut i = 0
    while i < sublist_length(fns_sl) {
        sr_analyze_fn(sublist_get(fns_sl, i), fns_sl)
        i = i + 1
    }
}
