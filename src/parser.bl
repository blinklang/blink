import tokens.{TokenKind, is_keyword, token_kind_name}
import ast.{NodeKind, AstNode}
import lexer.{tokens}
import diagnostics.{
    Diag, diag_error, diag_error_range, diag_source_file,
    diag_count, diag_entry_count, diag_truncate,
    INLINE_MODULE_NOT_SUPPORTED, UNEXPECTED_ANNOTATION, UNEXPECTED_TOKEN,
    UNEXPECTED_TOKEN_STRING, UNEXPECTED_TOKEN_PATTERN, KEYWORD_AS_IDENTIFIER,
    EMPTY_BRACE_EXPR, UNKNOWN_INTRINSIC, MUT_FIELD_NOT_SUPPORTED,
    INVALID_STRING_BACKED_ENUM, INTERP_PARSE_FAILURE,
    TEST_ANNOTATED_RETURN,
}

effect Parse {
    effect Advance
    effect Build
}

// parser.bl — Self-hosting recursive descent parser for Blink
//
// Port of src/pact/parser.py. Token input arrives as a List[Token]
// from the lexer. AST output is a node pool: List[AstNode] indexed
// by node ID.

// ── Node pool ──────────────────────────────────────────────────────
// Each node is an index into the nodes list. -1 means "no node".
pub let mut nodes: List[AstNode] = []

// Sublists: for lists of node references (params, args, stmts, etc.)
let mut sl_data: List[List[Int]] = []
let mut sl_stack: List[Int] = []

let mut annotation_nodes: List[Int] = []
let mut program_annotation_nodes: List[Int] = []

// `@expect_panic` desugars to a real AssertPanics node during parse so the
// compile path gets all the assert_panics machinery for free. The FORMAT path
// disables it (set to 0 before parse_program, restored after) so the formatter
// round-trips the original `@expect_panic` surface syntax instead of printing
// the desugared `assert_panics` body — which would otherwise double-wrap on the
// next format and is non-idempotent.
pub let mut parse_desugar_enabled: Int = 1

// Side table: dotted-path-derived module key per top-level decl node.
// Populated during merge_programs from the import graph. Used by
// codegen's archive-mode emission filter to route decls by source
// of origin. blink_map keys must be const char*, so the node id is
// stringified.
pub let mut source_module_for_node: Map[Str, Str] = Map()

pub fn parser_reset() {
    nodes.clear()
    sl_data.clear()
    sl_stack.clear()
    annotation_nodes.clear()
    program_annotation_nodes.clear()
    source_module_for_node.clear()
    pos = 0
    parse_desugar_enabled = 1
}

pub fn record_source_module(node_id: Int, key: Str) {
    source_module_for_node.insert("{node_id}", key)
}

pub fn node_source_module(id: Int) -> Str {
    match source_module_for_node.get("{id}") {
        Some(key) => key
        None => node_or_die(id, "node_source_module").module
    }
}

pub fn new_node(kind: NodeKind) -> Int ! Parse.Build {
    let id = node_count()
    nodes.push(AstNode { kind: kind, line: peek_line(), col: peek_col() })
    id
}

pub fn new_sublist() -> Int ! Parse.Build {
    let id = sl_data.len()
    let inner: List[Int] = []
    sl_data.push(inner)
    sl_stack.push(id)
    id
}

pub fn sublist_push(sl: Int, node_id: Int) ! Parse.Build {
    if sl_stack.len() == 0 {
        io.println("FATAL: sublist_push() called with no open sublist")
        exit(1)
    }
    let items = sl_data.get(sl).unwrap()
    items.push(node_id)
}

pub fn finalize_sublist(sl: Int) ! Parse.Build {
    if sl_stack.len() == 0 {
        io.println("FATAL: finalize_sublist() called with no open sublist")
        exit(1)
    }
    let top = sl_stack.get(sl_stack.len() - 1).unwrap()
    if top != sl {
        io.println("FATAL: finalize_sublist({sl}) but top of stack is {top}")
        exit(1)
    }
    sl_stack.pop()
}

pub fn sublist_get(sl: Int, idx: Int) -> Int {
    let items = sl_data.get(sl).unwrap()
    items.get(idx).unwrap()
}

pub fn sublist_length(sl: Int) -> Int {
    let items = sl_data.get(sl).unwrap()
    items.len()
}

pub fn get_annotation(node: Int, name: Str) -> Int {
    let anns_sl = node_handlers(node)
    if anns_sl == -1 {
        return -1
    }
    let mut i = 0
    while i < sublist_length(anns_sl) {
        let ann = sublist_get(anns_sl, i)
        if node_name(ann) == name {
            return ann
        }
        i = i + 1
    }
    -1
}

pub fn has_annotation(node: Int, name: Str) -> Int {
    if get_annotation(node, name) != -1 { 1 } else { 0 }
}

pub fn is_literal_string_part(part: Int) -> Int {
    if node_kind(part) == NodeKind.Ident && node_str_val(part) == node_name(part) { 1 } else { 0 }
}

pub fn get_str_named_arg(ann: Int, label: Str) -> Str {
    let args_sl = node_args(ann)
    if args_sl == -1 { return "" }
    let mut i = 0
    while i < sublist_length(args_sl) {
        let arg = sublist_get(args_sl, i)
        if node_kind(arg) == NodeKind.InterpString && node_name(arg) == label {
            let parts_sl = node_elements(arg)
            if parts_sl != -1 && sublist_length(parts_sl) == 1 {
                let part = sublist_get(parts_sl, 0)
                if is_literal_string_part(part) != 0 {
                    return node_str_val(part)
                }
            }
        }
        i = i + 1
    }
    ""
}

// ── Node accessor functions (migration bridge) ─────────────────────

pub fn node_count() -> Int { nodes.len() }

// Named-caller panic on bad id: a plain `.unwrap()` panic doesn't tell us
// which accessor was hit or how far out of bounds the id was, which makes
// concurrency or stale-id corruption nearly impossible to diagnose from
// a CI log.
fn node_or_die(id: Int, where: Str) -> AstNode {
    match nodes.get(id) {
        Some(n) => return n
        None => {}
    }
    io.eprintln("parser: {where}({id}) out of bounds; nodes.len()={nodes.len()}")
    // Forensic dump for w4y4n7: opt-in via BLINK_PARSER_PANIC_DUMP=1 so normal
    // panic output is unchanged in CI but the next sighting captures enough
    // state to localize the race.
    let dump = env.var("BLINK_PARSER_PANIC_DUMP") ?? ""
    if dump != "" {
        let nlen = nodes.len()
        let sl_len = sl_data.len()
        io.eprintln("parser-dump: pos={pos} src='{diag_source_file}' sl_data.len={sl_len}")
        // Tail of the node pool — last 32 kinds + line:col, oldest first.
        let mut start = nlen - 32
        if start < 0 { start = 0 }
        let mut i = start
        while i < nlen {
            let n = nodes.get(i).unwrap()
            let nk = n.kind
            let nl = n.line
            let nc = n.col
            io.eprintln("parser-dump: node[{i}] kind={nk} line={nl} col={nc}")
            i = i + 1
        }
        // Largest sublist sizes — useful if a sublist length looks insane.
        let mut j = 0
        let mut max_sl = 0
        let mut max_sl_idx = -1
        while j < sl_len {
            let items = sl_data.get(j).unwrap()
            let l = items.len()
            if l > max_sl {
                max_sl = l
                max_sl_idx = j
            }
            j = j + 1
        }
        io.eprintln("parser-dump: max_sublist_len={max_sl} at_index={max_sl_idx}")
    }
    exit(2)
    AstNode {}
}

