    if (mk & 134217728) != 0 {
        columns.ints.get(ic).unwrap().set(ij, n.methods)
        ij = ij + 1
    }
    if (mk & 268435456) != 0 {
        columns.ints.get(ic).unwrap().set(ij, n.type_params)
        ij = ij + 1
