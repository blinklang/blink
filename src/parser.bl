fn node_ints_drop(c: Int, n: Int) {
    let mut k = 0
    while k < n {
        let _ = columns.ints.get(c).unwrap().pop()
        k = k + 1
    }
}

fn node_strs_drop(c: Int, n: Int) {
    let mut k = 0
    while k < n {
        let _ = columns.strs.get(c).unwrap().pop()
        k = k + 1
    }
}

// The fields a node of `kind` holds from its push whatever their values: a later pass
// writes them on nearly every node of that kind (name resolution the module of each binding,
// comment attachment and pub marking a fn's), and a write outside the shape would move the
// node's payload into a chunk already full.
fn node_kind_fields(kind: Int) -> Int {
    if kind == NodeKind.FnDef { return 4644337115742208 }
    if kind == NodeKind.LetBinding || kind == NodeKind.Param || kind == NodeKind.ForIn { return 140737488355328 }
    0
}

// Appends `n` to the pool and returns its id.
pub fn node_push(n: AstNode) -> Int {
    let id = columns.count
    let c = id >> 12
    if (id & 4095) == 0 {
        let mut iroom = 12288
        let mut sroom = 4096
        if c > 0 {
            let iused = columns.ints.get(c - 1).unwrap().len() - 4096
            let sused = columns.strs.get(c - 1).unwrap().len()
            iroom = iused + iused / 8 + 256
            sroom = sused + sused / 8 + 64
        }
        columns.ints.push(List.with_capacity(4096 + iroom))
        let mut k = 0
        while k < 4096 {
            columns.ints.get(c).unwrap().push(0)
            k = k + 1
        }
        columns.strs.push(List.with_capacity(sroom))
        columns.child_at.push(List.with_capacity(4096))
    }
    let s = node_shape(node_mask(n) | node_kind_fields(n.kind), n.kind)
    columns.ints.get(c).unwrap().set(id & 4095, node_store(n, s, c))
    columns.kind.push(n.kind)
    let start = columns.child_slots.len()
    node_child_ids_into(n, ChildWalk.Slots, columns.child_slots)
    columns.child_at.get(c).unwrap().push(node_child_run(id, start))
    columns.count = id + 1
    id
}

// Drops the newest node, as a caller that made a scratch node does to give its id back.
// Its payload is given back only when it is still at its chunks' ends: a node written to
// after this one was pushed moved its payload past this one's.
pub fn node_pop() {
    if columns.count == 0 { return }
    let id = columns.count - 1
    if id < journal.floor {
        parser_limit_stop("node_pop() of node {id}, which a parse made and a rewind keeps")
    }
    let c = id >> 12
    let h = columns.ints.get(c).unwrap().get(id & 4095).unwrap()
    let s = h & 65535
    let ni = columns.shape_ints.get(s).unwrap()
    let ns = columns.shape_strs.get(s).unwrap()
    if ns > 0 && (h >> 40) + ns == columns.strs.get(c).unwrap().len() { node_strs_drop(c, ns) }
    if ni > 0 && ((h >> 16) & 16777215) + ni == columns.ints.get(c).unwrap().len() { node_ints_drop(c, ni) }
    let _ = columns.kind.pop()
    let at = columns.child_at.get(c).unwrap().pop() ?? 0
    columns.count = id
    if (id & 4095) == 0 {
        let _ = columns.ints.pop()
        let _ = columns.strs.pop()
        let _ = columns.child_at.pop()
    }
    if (at >> 8) + (at & 255) == columns.child_slots.len() {
        node_drop_child_slots_from(at >> 8)
    }
}

fn node_replace(id: Int, n: AstNode) {
    let c = id >> 12
    let j = id & 4095
    let h = columns.ints.get(c).unwrap().get(j).unwrap()
    let s = h & 65535
    let held = columns.shape_mask.get(s).unwrap()
    let m = node_mask(n)
    let kept = id < journal.floor
    if (m & held) == m && !kept {
        node_overwrite(n, s, h, c)
    } else {
        // A kept node takes a new payload, so the rewind restores it with its head word.
        if kept { journal_record(JOURNAL_INT, (c << 32) | j, h, 0, "") }
        let s2 = node_shape(m | held, n.kind)
        columns.ints.get(c).unwrap().set(j, node_store(n, s2, c))
    }
    if kept && columns.kind.get(id).unwrap() != n.kind { journal_record(JOURNAL_KIND, id, columns.kind.get(id).unwrap(), 0, "") }
    columns.kind.set(id, n.kind)
    // Most setters change a field that is not a child, so a run equal to the old one is
    // dropped again instead of growing the column on every write.
    let old = columns.child_at.get(c).unwrap().get(j).unwrap()
    let start = columns.child_slots.len()
    node_child_ids_into(n, ChildWalk.Slots, columns.child_slots)
    let at = node_child_run(id, start)
    if node_child_runs_equal(old, at) {
        node_drop_child_slots_from(at >> 8)
    } else {
        if kept { journal_record(JOURNAL_CHILD_AT, id, old, 0, "") }
        columns.child_at.get(c).unwrap().set(j, at)
    }
}

// Moves node `i`'s payload to a shape that also holds the field of mask bit `bit`, which
// reads its default.
fn node_widen(i: Int, bit: Int) {
    let c = i >> 12
    let j = i & 4095
    let s = columns.ints.get(c).unwrap().get(j).unwrap() & 65535
    let s2 = node_shape(columns.shape_mask.get(s).unwrap() | bit, columns.kind.get(i).unwrap())
    if i < journal.floor { journal_record(JOURNAL_INT, (c << 32) | j, columns.ints.get(c).unwrap().get(j).unwrap(), 0, "") }
    columns.ints.get(c).unwrap().set(j, node_store(node_or_die(i, "node_widen"), s2, c))
}

// `i` is checked; `f` is the field's index in mask-bit order, `bit` its mask bit and `dflt`
// its default.
fn node_write_int(i: Int, f: Int, bit: Int, dflt: Int, val: Int) {
    let c = i >> 12
    let j = i & 4095
    let mut h = columns.ints.get(c).unwrap().get(j).unwrap()
    let mut o = columns.shape_slot.get((h & 65535) * 56 + f).unwrap()
    if o < 0 {
        if val == dflt { return }
        node_widen(i, bit)
        h = columns.ints.get(c).unwrap().get(j).unwrap()
        o = columns.shape_slot.get((h & 65535) * 56 + f).unwrap()
    }
    let k = ((h >> 16) & 16777215) + o
    if i < journal.floor {
        let old = columns.ints.get(c).unwrap().get(k).unwrap()
        if old == val { return }
        journal_record(JOURNAL_INT, (c << 32) | k, old, 0, "")
    }
    columns.ints.get(c).unwrap().set(k, val)
}

fn node_write_str(i: Int, f: Int, bit: Int, dflt: Str, val: Str) {
    let c = i >> 12
    let j = i & 4095
    let mut h = columns.ints.get(c).unwrap().get(j).unwrap()
    let mut o = columns.shape_slot.get((h & 65535) * 56 + f).unwrap()
    if o < 0 {
        if val == dflt { return }
        node_widen(i, bit)
        h = columns.ints.get(c).unwrap().get(j).unwrap()
        o = columns.shape_slot.get((h & 65535) * 56 + f).unwrap()
    }
    let k = (h >> 40) + o
    if i < journal.floor {
        let old = columns.strs.get(c).unwrap().get(k).unwrap()
        if old == val { return }
        journal_record(JOURNAL_STR, (c << 32) | k, 0, 0, old)
    }
    columns.strs.get(c).unwrap().set(k, val)
}

// Field reads for node `i` (checked) through the field's `at` table.
fn node_get_int(i: Int, at: List[Int], dflt: Int) -> Int {
    let chunk = columns.ints.get(i >> 12).unwrap()
    let h = chunk.get(i & 4095).unwrap()
    let o = at.get(h & 65535).unwrap()
    if o < 0 { return dflt }
    chunk.get(((h >> 16) & 16777215) + o).unwrap()
}

fn node_get_str(i: Int, at: List[Int], dflt: Str) -> Str {
    let c = i >> 12
    let h = columns.ints.get(c).unwrap().get(i & 4095).unwrap()
    let o = at.get(h & 65535).unwrap()
    if o < 0 { return dflt }
    columns.strs.get(c).unwrap().get((h >> 40) + o).unwrap()
}

// The fields a setter writes in place: the child table reads none of them for any kind, so
// a write leaves the node's child slots right without a walk of the table. A field the table
// reads goes through node_replace, which walks the table again. A test runs every setter of
// these fields over every kind against the table.
type NodePlainInt {
    IntVal, IsPub, Line, Col, EndLine, EndCol, IsMut, IsConst, Inclusive
}

type NodePlainStr {
    StrVal, Module, TypeName, LeadingComments, TrailingComments, DocComment, Op, VarName, Method, ReturnType, TraitName
}

// `id` is already checked.
fn node_write_plain_int(id: Int, f: NodePlainInt, val: Int) {
    match f {
        NodePlainInt.IntVal => node_write_int(id, 0, 1, node_blank.int_val, val)
        NodePlainInt.IsPub => node_write_int(id, 14, 16384, node_blank.is_pub, val)
        NodePlainInt.Line => node_write_int(id, 33, 8589934592, node_blank.line, val)
        NodePlainInt.Col => node_write_int(id, 34, 17179869184, node_blank.col, val)
        NodePlainInt.EndLine => node_write_int(id, 35, 34359738368, node_blank.end_line, val)
        NodePlainInt.EndCol => node_write_int(id, 36, 68719476736, node_blank.end_col, val)
        NodePlainInt.IsMut => node_write_int(id, 13, 8192, node_blank.is_mut, val)
        NodePlainInt.IsConst => node_write_int(id, 15, 32768, node_blank.is_const, val)
        NodePlainInt.Inclusive => node_write_int(id, 16, 65536, node_blank.inclusive, val)
    }
}

// `id` is already checked.
fn node_write_plain_str(id: Int, f: NodePlainStr, val: Str) {
    match f {
        NodePlainStr.StrVal => node_write_str(id, 43, 8796093022208, node_blank.str_val, val)
        NodePlainStr.Module => node_write_str(id, 47, 140737488355328, node_blank.module, val)
        NodePlainStr.TypeName => node_write_str(id, 50, 1125899906842624, node_blank.type_name, val)
        NodePlainStr.LeadingComments => node_write_str(id, 52, 4503599627370496, node_blank.leading_comments, val)
        NodePlainStr.TrailingComments => node_write_str(id, 53, 9007199254740992, node_blank.trailing_comments, val)
        NodePlainStr.DocComment => node_write_str(id, 54, 18014398509481984, node_blank.doc_comment, val)
        NodePlainStr.Op => node_write_str(id, 45, 35184372088832, node_blank.op, val)
        NodePlainStr.VarName => node_write_str(id, 46, 70368744177664, node_blank.var_name, val)
        NodePlainStr.Method => node_write_str(id, 48, 281474976710656, node_blank.method, val)
        NodePlainStr.ReturnType => node_write_str(id, 49, 562949953421312, node_blank.return_type, val)
        NodePlainStr.TraitName => node_write_str(id, 51, 2251799813685248, node_blank.trait_name, val)
    }
}

// The packed start and count of the run of child slots that node `id`'s walk of the table
// appended from `start` to the tail of child_slots. The writers walk the table themselves:
// AstNode is passed by value, so each function it passes through copies all of it.
fn node_child_run(id: Int, start: Int) -> Int {
    let count = columns.child_slots.len() - start
    if count > 255 {
        parser_limit_stop("node {id} has {count} children; child_at packs at most 255")
    }
    (start << 8) | count
}

fn node_drop_child_slots_from(start: Int) {
    while columns.child_slots.len() > start {
        let _ = columns.child_slots.pop()
    }
}

fn node_child_runs_equal(a: Int, b: Int) -> Bool {
    let count = a & 255
    if count != (b & 255) { return false }
    let mut i = 0
    while i < count {
        if columns.child_slots.get((a >> 8) + i).unwrap() != columns.child_slots.get((b >> 8) + i).unwrap() { return false }
        i = i + 1
    }
    true
}

// Appends to `out` the children of `id` on one side, read from the node's run of child
// slots. `side` is 0 for value children and 2 for spellings, the slot's spelling bit.
fn node_push_slot_children(id: Int, side: Int, out: List[Int]) {
    let at = columns.child_at.get(id >> 12).unwrap().get(id & 4095).unwrap()
    let mut i = at >> 8
    let end = i + (at & 255)
    while i < end {
        let slot = columns.child_slots.get(i).unwrap()
        if (slot & 2) == side {
            if (slot & 1) == 0 {
                out.push(slot >> 2)
            } else {
                let sl = slot >> 2
                let s = sublists.start.get(sl).unwrap()
                let n = sublists.len.get(sl).unwrap()
                let mut k = 0
                while k < n {
                    let m = if s >= 0 { sublists.arena.get(s + k).unwrap() } else { sublist_get_slow(sl, k) }
                    if m != -1 { out.push(m) }
                    k = k + 1
                }
            }
        }
        i = i + 1
    }
}

pub fn new_sublist() -> Int ! Parse.Build {
    let id = sublists.start.len()
    let depth = sublists.open.len()
    if depth == sublists.scratch.len() {
        let items: List[Int] = []
        sublists.scratch.push(items)
    } else {
        let mut items = sublists.scratch.get(depth).unwrap()
        items.clear()
    }
    sublists.start.push(-2 - depth)
    sublists.len.push(0)
    sublists.open.push(id)
    id
}

pub fn sublist_push(sl: Int, node_id: Int) ! Parse.Build {
    if sublists.open.len() == 0 {
        parser_limit_stop("sublist_push() called with no open sublist")
    }
    sublist_add(sl, node_id)
}

pub fn finalize_sublist(sl: Int) ! Parse.Build {
    if sublists.open.len() == 0 {
        parser_limit_stop("finalize_sublist() called with no open sublist")
    }
    let top = sublists.open.get(sublists.open.len() - 1).unwrap()
    if top != sl {
        parser_limit_stop("finalize_sublist({sl}) but top of stack is {top}")
    }
    sublists.open.pop()
    let items = sublists.scratch.get(sublists.open.len()).unwrap()
    sublists.start.set(sl, sublists.arena.len())
    for m in items {
        sublists.arena.push(m)
    }
}

// One branch holds every check so the hot path stays small; the read of an open sublist and
// the error report live in sublist_get_slow.
pub fn sublist_get(sl: Int, idx: Int) -> Int {
    let s = sublists.start.get(sl).unwrap()
    if s < 0 || idx < 0 || idx >= sublists.len.get(sl).unwrap() {
        return sublist_get_slow(sl, idx)
    }
    sublists.arena.get(s + idx).unwrap()
}

pub fn sublist_length(sl: Int) -> Int {
    sublists.len.get(sl).unwrap()
}

fn sublist_get_slow(sl: Int, idx: Int) -> Int {
    let s = sublists.start.get(sl).unwrap()
    let n = sublists.len.get(sl).unwrap()
    if idx < 0 || idx >= n {
        parser_limit_stop("sublist_get({sl}, {idx}) out of bounds; sublist length is {n}")
    }
    if s >= 0 {
        return sublists.arena.get(s + idx).unwrap()
    }
    sublists.scratch.get(-2 - s).unwrap().get(idx).unwrap()
}

// An open sublist grows in its scratch list. A closed one grows at the arena end: in place
// when its run is already last, else after its run is copied there. The old run stays as
// dead space, which is cheap because growth after close is rare.
fn sublist_add(sl: Int, node_id: Int) {
    let s = sublists.start.get(sl).unwrap()
    let n = sublists.len.get(sl).unwrap()
    if s < 0 {
        let mut items = sublists.scratch.get(-2 - s).unwrap()
        items.push(node_id)
    } else {
        if sl < journal.sl_floor { journal_record(JOURNAL_SUBLIST, sl, s, n, "") }
        if s + n != sublists.arena.len() {
            let dest = sublists.arena.len()
            let mut k = 0
            while k < n {
                sublists.arena.push(sublists.arena.get(s + k).unwrap())
                k = k + 1
            }
            sublists.start.set(sl, dest)
        }
        sublists.arena.push(node_id)
    }
    sublists.len.set(sl, n + 1)
}

// Appends to `out` the children of `id` in VALUE position only. A pass that reasons about
// types walks these and stops at a spelling edge, where there is no value and so no type to
// find. A walker that runs over every node passes one list down and reuses it.
pub fn node_push_value_child_ids(id: Int, out: List[Int]) {
    node_push_slot_children(checked_node_id(id, "node_push_value_child_ids"), 0, out)
}

// Appends to `out` the children of `id` that spell a type: annotations, type parameters and
// explicit type arguments. The complement of node_push_value_child_ids.
pub fn node_push_spell_child_ids(id: Int, out: List[Int]) {
    node_push_slot_children(checked_node_id(id, "node_push_spell_child_ids"), 2, out)
}

// The children of `id` in VALUE position, as a new list.
pub fn node_value_child_ids(id: Int) -> List[Int] {
    let mut out: List[Int] = []
    node_push_value_child_ids(id, out)
    out
}

// The children of `id` that spell a type, as a new list.
pub fn node_spell_child_ids(id: Int) -> List[Int] {
    let mut out: List[Int] = []
    node_push_spell_child_ids(id, out)
    out
}

// The field name of a child that node `id`'s kind does not claim, or "" when the kind's arm
// covers every child the node holds.
pub fn node_unclaimed_child_field(id: Int) -> Str {
    node_unclaimed_child(node_or_die(id, "node_unclaimed_child_field"))
}

pub fn get_annotation(node: Int, name: Str) -> Int {
    let anns_sl = node_handlers(node)
    if anns_sl == -1 {
        return -1
    }
    let mut i = 0
    while i < sublist_length(anns_sl) {
        let ann = sublist_get(anns_sl, i)
        if node_name(ann) == name {
            return ann
        }
        i = i + 1
    }
    -1
}

pub fn has_annotation(node: Int, name: Str) -> Int {
    if get_annotation(node, name) != -1 { 1 } else { 0 }
}

pub fn is_literal_string_part(part: Int) -> Int {
    if node_kind(part) == NodeKind.Ident && node_str_val(part) == node_name(part) { 1 } else { 0 }
}

pub fn get_str_named_arg(ann: Int, label: Str) -> Str {
    let args_sl = node_args(ann)
    if args_sl == -1 { return "" }
    let mut i = 0
    while i < sublist_length(args_sl) {
        let arg = sublist_get(args_sl, i)
        if node_kind(arg) == NodeKind.InterpString && node_name(arg) == label {
            let parts_sl = node_elements(arg)
            if parts_sl != -1 && sublist_length(parts_sl) == 1 {
                let part = sublist_get(parts_sl, 0)
                if is_literal_string_part(part) != 0 {
                    return node_str_val(part)
                }
            }
        }
        i = i + 1
    }
    ""
}

// A struct declaration for a type this program never wrote. Typecheck mints a tid for a
// type the runtime defines -- process_run answers ProcessResult in a file that never
// imports std.process -- and every reader past typecheck reaches a struct through its
// declaration node, so the node has to exist. It is built here rather than in typecheck
// because the node pool and its sublists are this module's to extend. It holds no source
// position and joins no open sublist: there is no source and no parse in progress.
// `derives` becomes one @derive annotation, so the traits read the same as on the declaration
// lib/std would have given.
pub fn synth_struct_decl(name: Str, fnames: List[Str], ftypes: List[Str], derives: List[Str]) -> Int {
    let mut items: List[Int] = []
    let mut i = 0
    while i < fnames.len() {
        let ta = node_count()
        node_push(AstNode { kind: NodeKind.TypeAnn, name: ftypes.get(i).unwrap(), line: 0, col: 0 })
        let tf = node_count()
        node_push(AstNode { kind: NodeKind.TypeField, name: fnames.get(i).unwrap(), value: ta, condition: -1, line: 0, col: 0 })
        items.push(tf)
        i = i + 1
    }
    let flds = sublist_of(items)
    let mut anns = -1
    if derives.len() > 0 {
        let mut arg_items: List[Int] = []
        for d in derives {
            let a = node_count()
            node_push(AstNode { kind: NodeKind.Ident, name: d, line: 0, col: 0 })
            arg_items.push(a)
        }
        let args = sublist_of(arg_items)
        let ann = node_count()
        node_push(AstNode { kind: NodeKind.Annotation, name: "derive", args: args, line: 0, col: 0 })
        anns = sublist_of([ann])
    }
    let td = node_count()
    node_push(AstNode { kind: NodeKind.TypeDef, name: name, fields: flds, handlers: anns, line: 0, col: 0 })
    td
}

// A labelled argument no caller wrote. Typecheck fills a keyword parameter the call omitted
// from the declaration's own default expression, and every reader past typecheck reaches an
// argument through the call's argument list, so the node has to be in it. Built here for the
// same reason synth_struct_decl is: the node pool and its sublists are this module's to
// extend. The span is the call's, because that is the line a reader has to look at when the
// filled value turns out to be the wrong one.
pub fn synth_named_arg(label: Str, value: Int, line: Int, col: Int) -> Int {
    let nd = node_count()
    node_push(AstNode { kind: NodeKind.NamedArg, name: label, value: value, line: line, col: col })
    nd
}

// Append to a sublist that parsing already closed. sublist_push refuses once the sublist
// stack is empty, which is the right guard while a parse is running and the wrong one after
// it has finished.
pub fn sublist_append(sl: Int, node_id: Int) {
    sublist_add(sl, node_id)
}

// A sublist built after parsing, from members already in the pool. It stays off the sublist
// stack for the reason sublist_append does: no parse is open for it to belong to.
pub fn sublist_of(members: List[Int]) -> Int {
    let id = sublists.start.len()
    sublists.start.push(sublists.arena.len())
    sublists.len.push(members.len())
    for m in members {
        sublists.arena.push(m)
    }
    id
}

// ── Node accessor functions (migration bridge) ─────────────────────

pub fn node_count() -> Int { columns.count }

// A getter checks the id here, then reads its field's slot in its column.
fn checked_node_id(id: Int, where: Str) -> Int {
    if id < 0 || id >= columns.count { node_die(id, where) }
    id
}

// Whether the parser keeps the fn body token ranges that parsed_interface_text leaves out. A
// build turns it on only when it may take units from the last build, so no other compile
// pays for them.
pub fn parser_want_interface_text(on: Bool) {
    fn_bodies.wanted = on
}

// Whether the loader leaves each source interface text "" until fill_source_interfaces, so a
// daemon can answer a check before it pays for writing them. Only a build reads them, and the
// daemon fills them before it forks one.
pub fn parser_defer_interface_text(on: Bool) {
    fn_bodies.deferred = on
}

pub fn parser_interface_text_deferred() -> Bool {
    fn_bodies.deferred
}

pub fn parser_interface_text_wanted() -> Bool {
    fn_bodies.wanted
}

// The tokens of the source parsed last, but for those inside a fn body: what other modules
// see of it. Each token is its kind's name and its text, each after its length, so no two
// token lists give one text. Positions are left out: emit marks the source of each position
// it reads. Before the first token of each top-level item is a token of kind ITEM_MARK, which
// no token kind is named, whose text is the item's kind. "" when not wanted here or by the
// build.
pub fn parsed_interface_text(wanted: Bool) -> Str {
    interface_text_of(parsed_interface_parts(wanted))
}

// The tokens parsed_interface_text writes, as each one's kind name and then its text, not yet
// written out. Most of what the text costs is writing it, which a caller can so put off, as a
// daemon does until it has answered a check. Empty when not wanted here or by the build.
pub fn parsed_interface_parts(wanted: Bool) -> List[Str] {
    let mut parts: List[Str] = []
    if !wanted || !fn_bodies.wanted {
        clear_fn_bodies()
        return parts
    }
    let n = tokens.kinds.len()
    let b = fn_bodies
    let mut r = 0
    let mut q = 0
    let mut i = 0
    while i < n {
        if q < b.item_firsts.len() && i == b.item_firsts.get(q).unwrap() {
            parts.push(ITEM_MARK)
            parts.push(b.item_kinds.get(q).unwrap())
            q = q + 1
        }
        if r < b.tok_firsts.len() && i > b.tok_firsts.get(r).unwrap() {
            // Keep the closing brace, so the text still shows where each body was.
            i = b.tok_lasts.get(r).unwrap()
            r = r + 1
            continue
        }
        parts.push(token_kind_name(tokens.kinds.get(i).unwrap()))
        parts.push(tokens.values.get(i).unwrap())
        i = i + 1
    }
    // The end of the source can lie past the last token the lexer kept.
    while q < b.item_firsts.len() {
        parts.push(ITEM_MARK)
        parts.push(b.item_kinds.get(q).unwrap())
        q = q + 1
    }
    clear_fn_bodies()
    parts
}

// The interface text of what parsed_interface_parts gave.
pub fn interface_text_of(parts: List[Str]) -> Str {
    let sb = StringBuilder.new()
    let mut i = 0
    while i + 1 < parts.len() {
        let k = parts.get(i).unwrap()
        let v = parts.get(i + 1).unwrap()
        sb.write("{k.byte_len()}:{k}{v.byte_len()}:")
        sb.write(v)
        i = i + 2
    }
    sb.to_str()
}

pub let ITEM_MARK: Str = "@item"

fn clear_fn_bodies() {
    fn_bodies.tok_firsts.clear()
    fn_bodies.tok_lasts.clear()
    fn_bodies.item_firsts.clear()
    fn_bodies.item_kinds.clear()
}

// Item `at` is of kind, and no annotation precedes it.
fn mark_item(at: Int, kind: Str) {
    if at < fn_bodies.item_kinds.len() {
        fn_bodies.item_kinds.set(at, kind)
    }
}

// Item `at` is the fn f, under the annotations `anns` whose own items are `ann_items`. An
// annotation's item names its fn, so a build that sees one added or removed knows which fn it
// changes. A list that does not pair up leaves every item "other".
fn mark_fn_item(at: Int, f: Int, anns: List[Str], ann_items: List[Int]) {
    if anns.len() != ann_items.len() { return }
    let mut kind = "fn {node_name(f)}"
    for a in anns { kind = "{kind} @{a}" }
    mark_item(at, kind)
    let mut i = 0
    while i < anns.len() {
        mark_item(ann_items.get(i).unwrap(), "ann {anns.get(i).unwrap()} fn {node_name(f)}")
        i = i + 1
    }
}

fn pending_annotation_names() -> List[Str] {
    let mut out: List[Str] = []
    for ann in annotations.item { out.push(node_name(ann)) }
    out
}

// Item `at` is the trait tr, and no annotation precedes it. The kind lists every name the
// trait gives other sources to write, its methods and associated types, since a source reads
// a trait through those names. An annotation on a method leaves the item "other".
fn mark_trait_item(at: Int, tr: Int) {
    let mut kind = "trait {node_name(tr)}"
    let ms = node_methods(tr)
    let mut i = 0
    while ms != -1 && i < sublist_length(ms) {
        let m = sublist_get(ms, i)
        if node_handlers(m) != -1 { return }
        kind = "{kind} {node_name(m)}"
        i = i + 1
    }
    let ats = node_assoc_types(tr)
    i = 0
    while ats != -1 && i < sublist_length(ats) {
        kind = "{kind} {node_name(sublist_get(ats, i))}"
        i = i + 1
    }
    mark_item(at, kind)
}

// Item `at` is the global or const b, of keyword word, and no annotation precedes it. One that
// destructures or binds `_` names no single global, so it stays "other".
fn mark_binding_item(at: Int, word: Str, b: Int) {
    if node_elements(b) == -1 && node_name(b) != "" {
        mark_item(at, "{word} {node_name(b)}")
    }
}

fn node_or_die(id: Int, where: Str) -> AstNode {
    let i = checked_node_id(id, where)
    let ic = i >> 12
    let h = columns.ints.get(ic).unwrap().get(i & 4095).unwrap()
    let s = h & 65535
    let ij = (h >> 16) & 16777215
    let sc = ic
    let sj = h >> 40
    let o_str_val = columns.at_str_val.get(s).unwrap()
    let o_name = columns.at_name.get(s).unwrap()
    let o_op = columns.at_op.get(s).unwrap()
    let o_var_name = columns.at_var_name.get(s).unwrap()
    let o_module = columns.at_module.get(s).unwrap()
    let o_method = columns.at_method.get(s).unwrap()
    let o_return_type = columns.at_return_type.get(s).unwrap()
    let o_type_name = columns.at_type_name.get(s).unwrap()
    let o_trait_name = columns.at_trait_name.get(s).unwrap()
    let o_leading_comments = columns.at_leading_comments.get(s).unwrap()
    let o_trailing_comments = columns.at_trailing_comments.get(s).unwrap()
    let o_doc_comment = columns.at_doc_comment.get(s).unwrap()
    let o_xfail_reason = columns.at_xfail_reason.get(s).unwrap()
    let o_int_val = columns.at_int_val.get(s).unwrap()
    let o_left = columns.at_left.get(s).unwrap()
    let o_right = columns.at_right.get(s).unwrap()
    let o_body = columns.at_body.get(s).unwrap()
    let o_condition = columns.at_condition.get(s).unwrap()
    let o_then_body = columns.at_then_body.get(s).unwrap()
    let o_else_body = columns.at_else_body.get(s).unwrap()
    let o_scrutinee = columns.at_scrutinee.get(s).unwrap()
    let o_pattern = columns.at_pattern.get(s).unwrap()
    let o_guard = columns.at_guard.get(s).unwrap()
    let o_value = columns.at_value.get(s).unwrap()
    let o_target = columns.at_target.get(s).unwrap()
    let o_iterable = columns.at_iterable.get(s).unwrap()
    let o_is_mut = columns.at_is_mut.get(s).unwrap()
    let o_is_pub = columns.at_is_pub.get(s).unwrap()
    let o_is_const = columns.at_is_const.get(s).unwrap()
    let o_inclusive = columns.at_inclusive.get(s).unwrap()
    let o_start = columns.at_start.get(s).unwrap()
    let o_end = columns.at_end.get(s).unwrap()
    let o_obj = columns.at_obj.get(s).unwrap()
    let o_index = columns.at_index.get(s).unwrap()
    let o_params = columns.at_params.get(s).unwrap()
    let o_args = columns.at_args.get(s).unwrap()
    let o_stmts = columns.at_stmts.get(s).unwrap()
    let o_arms = columns.at_arms.get(s).unwrap()
    let o_fields = columns.at_fields.get(s).unwrap()
    let o_elements = columns.at_elements.get(s).unwrap()
    let o_methods = columns.at_methods.get(s).unwrap()
    let o_type_params = columns.at_type_params.get(s).unwrap()
    let o_effects = columns.at_effects.get(s).unwrap()
    let o_captures = columns.at_captures.get(s).unwrap()
    let o_type_ann = columns.at_type_ann.get(s).unwrap()
    let o_handlers = columns.at_handlers.get(s).unwrap()
    let o_line = columns.at_line.get(s).unwrap()
    let o_col = columns.at_col.get(s).unwrap()
    let o_end_line = columns.at_end_line.get(s).unwrap()
    let o_end_col = columns.at_end_col.get(s).unwrap()
    let o_assoc_types = columns.at_assoc_types.get(s).unwrap()
    let o_impl_binders = columns.at_impl_binders.get(s).unwrap()
    let o_recv_type_args = columns.at_recv_type_args.get(s).unwrap()
    let o_impl_where_bounds = columns.at_impl_where_bounds.get(s).unwrap()
    let o_for_binder = columns.at_for_binder.get(s).unwrap()
    let o_supertraits = columns.at_supertraits.get(s).unwrap()
    AstNode {
        str_val: if o_str_val < 0 { node_blank.str_val } else { columns.strs.get(sc).unwrap().get(sj + o_str_val).unwrap() },
        name: if o_name < 0 { node_blank.name } else { columns.strs.get(sc).unwrap().get(sj + o_name).unwrap() },
        op: if o_op < 0 { node_blank.op } else { columns.strs.get(sc).unwrap().get(sj + o_op).unwrap() },
        var_name: if o_var_name < 0 { node_blank.var_name } else { columns.strs.get(sc).unwrap().get(sj + o_var_name).unwrap() },
        module: if o_module < 0 { node_blank.module } else { columns.strs.get(sc).unwrap().get(sj + o_module).unwrap() },
        method: if o_method < 0 { node_blank.method } else { columns.strs.get(sc).unwrap().get(sj + o_method).unwrap() },
        return_type: if o_return_type < 0 { node_blank.return_type } else { columns.strs.get(sc).unwrap().get(sj + o_return_type).unwrap() },
        type_name: if o_type_name < 0 { node_blank.type_name } else { columns.strs.get(sc).unwrap().get(sj + o_type_name).unwrap() },
        trait_name: if o_trait_name < 0 { node_blank.trait_name } else { columns.strs.get(sc).unwrap().get(sj + o_trait_name).unwrap() },
        leading_comments: if o_leading_comments < 0 { node_blank.leading_comments } else { columns.strs.get(sc).unwrap().get(sj + o_leading_comments).unwrap() },
        trailing_comments: if o_trailing_comments < 0 { node_blank.trailing_comments } else { columns.strs.get(sc).unwrap().get(sj + o_trailing_comments).unwrap() },
        doc_comment: if o_doc_comment < 0 { node_blank.doc_comment } else { columns.strs.get(sc).unwrap().get(sj + o_doc_comment).unwrap() },
        xfail_reason: if o_xfail_reason < 0 { node_blank.xfail_reason } else { columns.strs.get(sc).unwrap().get(sj + o_xfail_reason).unwrap() },
        kind: columns.kind.get(i).unwrap(),
        int_val: if o_int_val < 0 { node_blank.int_val } else { columns.ints.get(ic).unwrap().get(ij + o_int_val).unwrap() },
        left: if o_left < 0 { node_blank.left } else { columns.ints.get(ic).unwrap().get(ij + o_left).unwrap() },
        right: if o_right < 0 { node_blank.right } else { columns.ints.get(ic).unwrap().get(ij + o_right).unwrap() },
        body: if o_body < 0 { node_blank.body } else { columns.ints.get(ic).unwrap().get(ij + o_body).unwrap() },
        condition: if o_condition < 0 { node_blank.condition } else { columns.ints.get(ic).unwrap().get(ij + o_condition).unwrap() },
        then_body: if o_then_body < 0 { node_blank.then_body } else { columns.ints.get(ic).unwrap().get(ij + o_then_body).unwrap() },
        else_body: if o_else_body < 0 { node_blank.else_body } else { columns.ints.get(ic).unwrap().get(ij + o_else_body).unwrap() },
        scrutinee: if o_scrutinee < 0 { node_blank.scrutinee } else { columns.ints.get(ic).unwrap().get(ij + o_scrutinee).unwrap() },
        pattern: if o_pattern < 0 { node_blank.pattern } else { columns.ints.get(ic).unwrap().get(ij + o_pattern).unwrap() },
        guard: if o_guard < 0 { node_blank.guard } else { columns.ints.get(ic).unwrap().get(ij + o_guard).unwrap() },
        value: if o_value < 0 { node_blank.value } else { columns.ints.get(ic).unwrap().get(ij + o_value).unwrap() },
        target: if o_target < 0 { node_blank.target } else { columns.ints.get(ic).unwrap().get(ij + o_target).unwrap() },
        iterable: if o_iterable < 0 { node_blank.iterable } else { columns.ints.get(ic).unwrap().get(ij + o_iterable).unwrap() },
        is_mut: if o_is_mut < 0 { node_blank.is_mut } else { columns.ints.get(ic).unwrap().get(ij + o_is_mut).unwrap() },
        is_pub: if o_is_pub < 0 { node_blank.is_pub } else { columns.ints.get(ic).unwrap().get(ij + o_is_pub).unwrap() },
        is_const: if o_is_const < 0 { node_blank.is_const } else { columns.ints.get(ic).unwrap().get(ij + o_is_const).unwrap() },
        inclusive: if o_inclusive < 0 { node_blank.inclusive } else { columns.ints.get(ic).unwrap().get(ij + o_inclusive).unwrap() },
        start: if o_start < 0 { node_blank.start } else { columns.ints.get(ic).unwrap().get(ij + o_start).unwrap() },
        end: if o_end < 0 { node_blank.end } else { columns.ints.get(ic).unwrap().get(ij + o_end).unwrap() },
        obj: if o_obj < 0 { node_blank.obj } else { columns.ints.get(ic).unwrap().get(ij + o_obj).unwrap() },
        index: if o_index < 0 { node_blank.index } else { columns.ints.get(ic).unwrap().get(ij + o_index).unwrap() },
        params: if o_params < 0 { node_blank.params } else { columns.ints.get(ic).unwrap().get(ij + o_params).unwrap() },
        args: if o_args < 0 { node_blank.args } else { columns.ints.get(ic).unwrap().get(ij + o_args).unwrap() },
        stmts: if o_stmts < 0 { node_blank.stmts } else { columns.ints.get(ic).unwrap().get(ij + o_stmts).unwrap() },
        arms: if o_arms < 0 { node_blank.arms } else { columns.ints.get(ic).unwrap().get(ij + o_arms).unwrap() },
        fields: if o_fields < 0 { node_blank.fields } else { columns.ints.get(ic).unwrap().get(ij + o_fields).unwrap() },
        elements: if o_elements < 0 { node_blank.elements } else { columns.ints.get(ic).unwrap().get(ij + o_elements).unwrap() },
        methods: if o_methods < 0 { node_blank.methods } else { columns.ints.get(ic).unwrap().get(ij + o_methods).unwrap() },
        type_params: if o_type_params < 0 { node_blank.type_params } else { columns.ints.get(ic).unwrap().get(ij + o_type_params).unwrap() },
        effects: if o_effects < 0 { node_blank.effects } else { columns.ints.get(ic).unwrap().get(ij + o_effects).unwrap() },
        captures: if o_captures < 0 { node_blank.captures } else { columns.ints.get(ic).unwrap().get(ij + o_captures).unwrap() },
        type_ann: if o_type_ann < 0 { node_blank.type_ann } else { columns.ints.get(ic).unwrap().get(ij + o_type_ann).unwrap() },
        handlers: if o_handlers < 0 { node_blank.handlers } else { columns.ints.get(ic).unwrap().get(ij + o_handlers).unwrap() },
        line: if o_line < 0 { node_blank.line } else { columns.ints.get(ic).unwrap().get(ij + o_line).unwrap() },
        col: if o_col < 0 { node_blank.col } else { columns.ints.get(ic).unwrap().get(ij + o_col).unwrap() },
        end_line: if o_end_line < 0 { node_blank.end_line } else { columns.ints.get(ic).unwrap().get(ij + o_end_line).unwrap() },
        end_col: if o_end_col < 0 { node_blank.end_col } else { columns.ints.get(ic).unwrap().get(ij + o_end_col).unwrap() },
        assoc_types: if o_assoc_types < 0 { node_blank.assoc_types } else { columns.ints.get(ic).unwrap().get(ij + o_assoc_types).unwrap() },
        impl_binders: if o_impl_binders < 0 { node_blank.impl_binders } else { columns.ints.get(ic).unwrap().get(ij + o_impl_binders).unwrap() },
        recv_type_args: if o_recv_type_args < 0 { node_blank.recv_type_args } else { columns.ints.get(ic).unwrap().get(ij + o_recv_type_args).unwrap() },
        impl_where_bounds: if o_impl_where_bounds < 0 { node_blank.impl_where_bounds } else { columns.ints.get(ic).unwrap().get(ij + o_impl_where_bounds).unwrap() },
        for_binder: if o_for_binder < 0 { node_blank.for_binder } else { columns.ints.get(ic).unwrap().get(ij + o_for_binder).unwrap() },
        supertraits: if o_supertraits < 0 { node_blank.supertraits } else { columns.ints.get(ic).unwrap().get(ij + o_supertraits).unwrap() },
    }
}

// The whole node at `id`, built from its payload. A pass that reads one or two fields uses
// their accessors instead.
pub fn node_at(id: Int) -> AstNode { node_or_die(id, "node_at") }

// The node pool or sublist stack can not hold what comes next, so the parser stops here.
fn parser_limit_stop(message: Str) {
    diag_ice_abort(PARSER_INTERNAL_LIMIT_NAME, PARSER_INTERNAL_LIMIT, message)
}

// Named-caller panic on bad id: a plain `.unwrap()` panic doesn't tell us
// which accessor was hit or how far out of bounds the id was, which makes
// concurrency or stale-id corruption nearly impossible to diagnose from
// a CI log.
fn node_die(id: Int, where: Str) {
    // Forensic dump for the node-index race: opt-in via BLINK_PARSER_PANIC_DUMP=1 so normal
    // panic output is unchanged in CI but the next sighting captures enough
    // state to localize the race.
    let dump = env.var("BLINK_PARSER_PANIC_DUMP") ?? ""
    if dump != "" {
        let nlen = columns.count
        let sl_len = sublists.start.len()
        io.eprintln("parser-dump: pos={pos} src='{diag_source_file}' sublists.len={sl_len}")
        // Tail of the node pool — last 32 kinds + line:col, oldest first.
        let mut start = nlen - 32
        if start < 0 { start = 0 }
        let mut i = start
        while i < nlen {
            let nk = columns.kind.get(i).unwrap()
            let nl = node_get_int(i, columns.at_line, node_blank.line)
            let nc = node_get_int(i, columns.at_col, node_blank.col)
            io.eprintln("parser-dump: node[{i}] kind={nk} line={nl} col={nc}")
            i = i + 1
        }
        // Largest sublist sizes — useful if a sublist length looks insane.
        let mut j = 0
        let mut max_sl = 0
        let mut max_sl_idx = -1
        while j < sl_len {
            let l = sublists.len.get(j).unwrap()
            if l > max_sl {
                max_sl = l
                max_sl_idx = j
            }
            j = j + 1
        }
        io.eprintln("parser-dump: max_sublist_len={max_sl} at_index={max_sl_idx}")
    }
    parser_limit_stop("parser: {where}({id}) out of bounds; nodes.len()={columns.count}")
}

