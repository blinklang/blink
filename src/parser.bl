// ── Token input ─────────────────────────────────────────────────────

pub let mut pos: Int = 0

// ── Token navigation ────────────────────────────────────────────────

fn peek_kind() -> TokenKind {
    if pos >= tokens.kinds.len() {
        return TokenKind.EOF
    }
    tokens.kinds.get(pos).unwrap()
}

fn peek_kind_at(p: Int) -> TokenKind {
    if p >= tokens.kinds.len() {
        return TokenKind.EOF
    }
    tokens.kinds.get(p).unwrap()
}

fn peek_value() -> Str {
    if pos >= tokens.values.len() {
        return ""
    }
    tokens.values.get(pos).unwrap()
}

fn peek_line() -> Int {
    let p = if pos >= tokens.lines.len() { tokens.lines.len() - 1 } else { pos }
    if p < 0 { return 1 }
    tokens.lines.get(p).unwrap()
}

fn peek_col() -> Int {
    let p = if pos >= tokens.cols.len() { tokens.cols.len() - 1 } else { pos }
    if p < 0 { return 1 }
    tokens.cols.get(p).unwrap()
}

fn peek_end_col() -> Int {
    let p = if pos >= tokens.end_cols.len() { tokens.end_cols.len() - 1 } else { pos }
    if p < 0 { return 1 }
    tokens.end_cols.get(p).unwrap()
}

fn at(kind: TokenKind) -> Int {
    peek_kind() == kind
}

fn advance() -> Int ! Parse.Advance {
    let old = pos
    pos = pos + 1
    old
}

fn advance_value() -> Str ! Parse.Advance {
    if pos >= tokens.values.len() {
        return ""
    }
    let v = tokens.values.get(pos).unwrap()
    pos = pos + 1
    v
}

fn expect(kind: TokenKind) -> Int ! Parse.Advance, Diag.Report {
    if peek_kind() != kind {
        diag_error_range("UnexpectedToken", UNEXPECTED_TOKEN, "expected {token_kind_name(kind)}, got {token_kind_name(peek_kind())}", peek_line(), peek_col(), peek_end_col(), "")
    }
    advance()
}

fn expect_value(kind: TokenKind) -> Str ! Parse.Advance, Diag.Report {
    if peek_kind() != kind {
        if kind == TokenKind.Ident && is_keyword(peek_kind()) {
            diag_error_range("KeywordAsIdentifier", KEYWORD_AS_IDENTIFIER, "`{peek_value()}` is a keyword and cannot be used as an identifier", peek_line(), peek_col(), peek_end_col(), "use a different name")
        } else {
            diag_error_range("UnexpectedToken", UNEXPECTED_TOKEN, "expected {token_kind_name(kind)}, got {token_kind_name(peek_kind())}", peek_line(), peek_col(), peek_end_col(), "")
        }
    }
    advance_value()
}

fn skip_newlines() ! Parse.Advance {
    while at(TokenKind.Newline) {
        advance()
    }
}

fn skip_newlines_and_comments() ! Parse.Advance {
    while at(TokenKind.Newline) || at(TokenKind.Comment) || at(TokenKind.DocComment) {
        advance()
    }
}

fn maybe_newline() ! Parse.Advance {
    if at(TokenKind.Newline) {
        advance()
    }
}

fn attach_pending_annotations(node: Int) ! Parse.Build {
    if annotations.item.len() > 0 {
        let anns_sl = new_sublist()
        let mut ai = 0
        while ai < annotations.item.len() {
            sublist_push(anns_sl, annotations.item.get(ai).unwrap())
            ai = ai + 1
        }
        finalize_sublist(anns_sl)
        node_set_handlers(node, anns_sl)
        annotations.item = []
    }
}

// Clearing the list keeps a rejected annotation off the next item that attaches pending ones.
fn reject_pending_annotations(what: Str, help: Str) ! Parse.Build, Diag.Report {
    for ann in annotations.item {
        diag_error("UnexpectedAnnotation", UNEXPECTED_ANNOTATION, "@{node_name(ann)} {what}", node_line(ann), node_col(ann), help)
    }
    annotations.item = []
}

// Skipping only up to the next item keeps one bad line to one error, and lets a method
// that follows the stray token on the same line (`pub fn m`) still register.
fn reject_body_token(owner: Str, in_trait: Int) ! Parse.Advance, Diag.Report {
    let v = peek_value()
    let text = if v != "" { v } else { token_kind_name(peek_kind()) }
    let line = peek_line()
    let col = peek_col()
    let end_col = peek_end_col()
    // sections/03_types.md 3.6: `final` is valid on a trait default method, but sealing is not
    // built, so accepting it would leave the method silently overridable.
    if in_trait == 1 && at(TokenKind.Ident) && text == "final" {
        diag_error_range("UnexpectedToken", UNEXPECTED_TOKEN, "`final` is not implemented yet: the method would not be sealed", line, col, end_col, "remove `final`; the method is then an open default that an impl may override")
    } else {
        let body = if in_trait == 1 { "a trait" } else { "an impl" }
        diag_error_range("UnexpectedToken", UNEXPECTED_TOKEN, "unexpected `{text}` in {owner}: {body} body holds only methods, associated types and annotations", line, col, end_col, "remove it, or move it out of the {owner} body")
    }
    advance()
    while !at(TokenKind.Newline) && !at(TokenKind.RBrace) && !at(TokenKind.Fn) && !at(TokenKind.Type) && !at(TokenKind.At) && !at(TokenKind.EOF) {
        advance()
    }
}

// First InterpString argument of an annotation, positional or `matching:`-named
// (both forms of `@expect_panic("sub")` / `@expect_panic(matching: "sub")`).
// Returns the arg expr node id, reusable directly as the assert_panics matching
// expr, or -1 when the annotation has no string argument (the bare form).
fn first_str_ann_arg(ann: Int) -> Int {
    let args_sl = node_args(ann)
    if args_sl == -1 { return -1 }
    let mut i = 0
    while i < sublist_length(args_sl) {
        let arg = sublist_get(args_sl, i)
        if node_kind(arg) == NodeKind.InterpString { return arg }
        i = i + 1
    }
    -1
}

// `@expect_panic`-desugar: rewrite, BEFORE typecheck, a fn or
// test decl carrying `@expect_panic[("sub")]` so its body is wrapped in a real
// AssertPanics node — `assert_panics { body }` (or `assert_panics(matching:
// "sub") { body }`). The whole assert_panics machinery (E0831/E0832/E0834,
// pass-consumes-panic) then applies for free. The AssertPanics span is the
// DECL's line/col so an E0831 "body returned" failure points at the decl, not
// the body interior. No-op when `@expect_panic` is absent or the decl has no
// body (a `?`-recovered/empty decl).
fn maybe_desugar_expect_panic(decl: Int) ! Parse.Build {
    if parse_desugar_enabled == 0 { return }
    let ann = get_annotation(decl, "expect_panic")
    if ann == -1 { return }
    let body = node_body(decl)
    if body == -1 { return }

    let match_expr = first_str_ann_arg(ann)
    let decl_line = node_line(decl)
    let decl_col = node_col(decl)
    let body_end_l = node_end_line(body)
    let body_end_c = node_end_col(body)

    let ap_id = node_count()
    node_push(AstNode {
        kind: NodeKind.AssertPanics,
        body: body, value: match_expr,
        line: decl_line, col: decl_col,
        end_line: body_end_l, end_col: body_end_c,
    })

    let stmts = new_sublist()
    sublist_push(stmts, ap_id)
    finalize_sublist(stmts)
    let block_id = node_count()
    node_push(AstNode {
        kind: NodeKind.Block, stmts: stmts,
        line: decl_line, col: decl_col,
        end_line: body_end_l, end_col: body_end_c,
    })
    node_set_body(decl, block_id)
}

// ── Import statements ────────────────────────────────────────────────

fn parse_import_stmt() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    // 'import' already consumed
    let mut path = expect_value(TokenKind.Ident)
    while at(TokenKind.Dot) {
        advance()
        if at(TokenKind.LBrace) {
            break
        }
        path = path.concat(".").concat(expect_value(TokenKind.Ident))
    }

    let imp_line = peek_line()
    let imp_col = peek_col()
    let mut names_sl = -1
    if at(TokenKind.LBrace) {
        advance()
        skip_newlines_and_comments()
        names_sl = new_sublist()
        while !at(TokenKind.RBrace) && !at(TokenKind.EOF) {
            let item_line = peek_line()
            let item_col = peek_col()
            let item_name = expect_value(TokenKind.Ident)
            let mut item_alias = ""
            if at(TokenKind.As) {
                advance()
                item_alias = expect_value(TokenKind.Ident)
            }
            let name_node = node_count()
            node_push(AstNode {
                kind: NodeKind.Ident, name: item_name, str_val: item_alias,
                line: item_line, col: item_col,
            })
            sublist_push(names_sl, name_node)
            skip_newlines_and_comments()
            if at(TokenKind.Comma) {
                advance()
                skip_newlines_and_comments()
            }
        }
        expect(TokenKind.RBrace)
        finalize_sublist(names_sl)
    }

    let node = node_count()
    node_push(AstNode {
        kind: NodeKind.ImportStmt, str_val: path, args: names_sl,
        line: imp_line, col: imp_col,
    })
    node
}

// Parses one `@name` or `@name(args)` at the cursor and returns its Annotation node.
fn parse_annotation() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    let ann_start_line = peek_line()
    let ann_start_col = peek_col()
    advance()
    let mut ann_name = if is_keyword(peek_kind()) { advance_value() } else { expect_value(TokenKind.Ident) }
    while at(TokenKind.Dot) {
        advance()
        let ann_part = if is_keyword(peek_kind()) { advance_value() } else { expect_value(TokenKind.Ident) }
        ann_name = ann_name.concat(".").concat(ann_part)
    }
    let mut ann_args_sl = -1
    if at(TokenKind.LParen) {
        advance()
        skip_newlines_and_comments()
        let mut ann_arg_nodes: List[Int] = []
        if ann_name == "requires" || ann_name == "ensures" || ann_name == "invariant" {
            let expr_nd = parse_expr()
            ann_arg_nodes.push(expr_nd)
            skip_newlines_and_comments()
        } else {
            while !at(TokenKind.RParen) && !at(TokenKind.EOF) {
                if at(TokenKind.StringStart) {
                    let str_nd = parse_interp_string()
                    ann_arg_nodes.push(str_nd)
                } else {
                    let arg_name = expect_value(TokenKind.Ident)
                    let mut full_arg = arg_name
                    if at(TokenKind.Colon) {
                        advance()
                        skip_newlines_and_comments()
                        if at(TokenKind.StringStart) {
                            let val_nd = parse_interp_string()
                            node_set_name(val_nd, full_arg)
                            ann_arg_nodes.push(val_nd)
                        } else {
                            let val_name = expect_value(TokenKind.Ident)
                            let kv_nd = node_count()
                            node_push(AstNode { kind: NodeKind.Ident, name: full_arg.concat(":").concat(val_name), line: peek_line(), col: peek_col() })
                            ann_arg_nodes.push(kv_nd)
                        }
                    } else {
                        if at(TokenKind.Dot) {
                            advance()
                            let child = expect_value(TokenKind.Ident)
                            full_arg = full_arg.concat(".").concat(child)
                        }
                        let arg_nd = node_count()
                        node_push(AstNode { kind: NodeKind.Ident, name: full_arg, line: peek_line(), col: peek_col() })
                        ann_arg_nodes.push(arg_nd)
                    }
                }
                skip_newlines_and_comments()
                if at(TokenKind.Comma) {
                    advance()
                    skip_newlines_and_comments()
                }
            }
        }
        expect(TokenKind.RParen)
        if ann_arg_nodes.len() > 0 {
            ann_args_sl = new_sublist()
            let mut ai = 0
            while ai < ann_arg_nodes.len() {
                sublist_push(ann_args_sl, ann_arg_nodes.get(ai).unwrap())
                ai = ai + 1
            }
            finalize_sublist(ann_args_sl)
        }
    }
    let ann_nd = node_count()
    node_push(AstNode {
        kind: NodeKind.Annotation, name: ann_name, args: ann_args_sl,
        line: ann_start_line, col: ann_start_col,
    })
    ann_nd
}

// ── Top-level ───────────────────────────────────────────────────────

// Dev knob: BLINK_DEV_PARSER_LIMIT=<name> stops the parse of a file that holds the identifier
// <name> as a parser internal limit does. No source program reaches a limit, so a test makes a
// daemon or language server meet one with this.
fn parser_dev_limit() {
    let name = env.var("BLINK_DEV_PARSER_LIMIT") ?? ""
    if name == "" { return }
    let mut i = 0
    while i < tokens.kinds.len() {
        if tokens.kinds.get(i).unwrap() == TokenKind.Ident && tokens.values.get(i).unwrap() == name {
            parser_limit_stop("BLINK_DEV_PARSER_LIMIT met `{name}`")
        }
        i = i + 1
    }
}

pub fn parse_program() -> Int ! Parse, Diag.Report {
    parser_dev_limit()
    if trace_mode != "" { trace("parse", "start ({tokens.kinds.len()} tokens)") }
    let mut fn_nodes: List[Int] = []
    let mut type_nodes: List[Int] = []
    let mut let_nodes: List[Int] = []
    let mut trait_nodes: List[Int] = []
    let mut impl_nodes: List[Int] = []
    let mut import_nodes: List[Int] = []
    let mut effect_decl_nodes: List[Int] = []
    let mut test_nodes: List[Int] = []
    annotations.item = []
    clear_fn_bodies()
    // The items of the annotations pending for the next item.
    let mut ann_items: List[Int] = []
    skip_newlines_and_comments()
    while !at(TokenKind.EOF) {
        skip_newlines_and_comments()
        if at(TokenKind.EOF) {
            break
        }
        let top_before = pos
        let item_at = fn_bodies.item_kinds.len()
        if fn_bodies.wanted {
            fn_bodies.item_firsts.push(pos)
            fn_bodies.item_kinds.push(if annotations.item.len() == 0 && at(TokenKind.Import) { "import" } else { "other" })
        }
        let is_annotation = at(TokenKind.At)
        if is_annotation {
            let ann_nd = parse_annotation()
            if node_name(ann_nd) == "capabilities" {
                annotations.program.push(ann_nd)
            } else {
                annotations.item.push(ann_nd)
                ann_items.push(item_at)
            }
            skip_newlines_and_comments()
        } else if at(TokenKind.Import) {
            advance()
            let imp = parse_import_stmt()
            import_nodes.push(imp)
            skip_newlines_and_comments()
        } else if at(TokenKind.Type) {
            let td = parse_type_def()
            attach_pending_annotations(td)
            type_nodes.push(td)
        } else if at(TokenKind.Trait) {
            let plain = annotations.item.len() == 0
            let tr = parse_trait_def()
            if plain { mark_trait_item(item_at, tr) }
            attach_pending_annotations(tr)
            trait_nodes.push(tr)
        } else if at(TokenKind.Impl) {
            let im = parse_impl_block()
            attach_pending_annotations(im)
            impl_nodes.push(im)
        } else if at(TokenKind.Let) {
            let plain = annotations.item.len() == 0
            let lb = parse_let_binding()
            if plain { mark_binding_item(item_at, "let", lb) }
            attach_pending_annotations(lb)
            let_nodes.push(lb)
        } else if at(TokenKind.Const) {
            let plain = annotations.item.len() == 0
            let cb = parse_const_binding()
            if plain { mark_binding_item(item_at, "const", cb) }
            attach_pending_annotations(cb)
            let_nodes.push(cb)
        } else if at(TokenKind.Pub) {
            advance()
            skip_newlines_and_comments()
            if at(TokenKind.Fn) {
                let anns = pending_annotation_names()
                let f = parse_fn_def()
                mark_fn_item(item_at, f, anns, ann_items)
                node_set_is_pub(f, 1)
                attach_pending_annotations(f)
                maybe_desugar_expect_panic(f)
                fn_nodes.push(f)
            } else if at(TokenKind.Type) {
                let td = parse_type_def()
                node_set_is_pub(td, 1)
                attach_pending_annotations(td)
                type_nodes.push(td)
            } else if at(TokenKind.Trait) {
                let plain = annotations.item.len() == 0
                let tr = parse_trait_def()
                if plain { mark_trait_item(item_at, tr) }
                node_set_is_pub(tr, 1)
                attach_pending_annotations(tr)
                trait_nodes.push(tr)
            } else if at(TokenKind.Let) {
                let plain = annotations.item.len() == 0
                let lb = parse_let_binding()
                if plain { mark_binding_item(item_at, "let", lb) }
                node_set_is_pub(lb, 1)
                attach_pending_annotations(lb)
                let_nodes.push(lb)
            } else if at(TokenKind.Const) {
                let plain = annotations.item.len() == 0
                let cb = parse_const_binding()
                if plain { mark_binding_item(item_at, "const", cb) }
                node_set_is_pub(cb, 1)
                attach_pending_annotations(cb)
                let_nodes.push(cb)
            } else if at(TokenKind.Effect) {
                let ed = parse_effect_decl()
                node_set_is_pub(ed, 1)
                attach_pending_annotations(ed)
                effect_decl_nodes.push(ed)
            } else if at(TokenKind.Import) {
                advance()
                let imp = parse_import_stmt()
                node_set_is_pub(imp, 1)
                attach_pending_annotations(imp)
                import_nodes.push(imp)
            } else {
                diag_error_range("UnexpectedToken", UNEXPECTED_TOKEN, "expected fn, type, trait, or effect after pub", peek_line(), peek_col(), peek_end_col(), "")
                advance()
            }
        } else if at(TokenKind.Effect) {
            let ed = parse_effect_decl()
            attach_pending_annotations(ed)
            effect_decl_nodes.push(ed)
        } else if at(TokenKind.Test) {
            if annotations.item.len() == 0 { mark_item(item_at, "test") }
            advance()
            if at(TokenKind.Dot) {
                advance()
                if at(TokenKind.Ident) && peek_value() == "failing" {
                    advance()
                    let tb = parse_test_failing_block()
                    // Deliberately NOT desugared via maybe_desugar_expect_panic:
                    // that wraps the body in assert_panics, which turns a matching
                    // panic into an ordinary pass for the enclosing test. That
                    // inverts test.failing's own semantics (body fails -> passed,
                    // body passes -> unexpected-pass failure) — the two mechanisms
                    // are incompatible, not just unwired. @expect_panic on
                    // test.failing is a no-op annotation for now.
                    attach_pending_annotations(tb)
                    test_nodes.push(tb)
                } else {
                    diag_error_range("UnexpectedToken", UNEXPECTED_TOKEN,
                        "expected `failing` after `test.`",
                        peek_line(), peek_col(), peek_end_col(), "")
                    advance()
                }
            } else {
                let tb = parse_test_block()
                attach_pending_annotations(tb)
                maybe_desugar_expect_panic(tb)
                test_nodes.push(tb)
            }
        } else if at(TokenKind.Fn) {
            let anns = pending_annotation_names()
            let f = parse_fn_def()
            mark_fn_item(item_at, f, anns, ann_items)
            attach_pending_annotations(f)
            maybe_desugar_expect_panic(f)
            fn_nodes.push(f)
        } else if at(TokenKind.Mod) {
            let mod_line = peek_line()
            let mod_col = peek_col()
            advance()
            if at(TokenKind.Ident) {
                advance()
            }
            skip_newlines_and_comments()
            if at(TokenKind.LBrace) {
                advance()
                let mut depth = 1
                while depth > 0 && !at(TokenKind.EOF) {
                    if at(TokenKind.LBrace) {
                        depth = depth + 1
                    } else if at(TokenKind.RBrace) {
                        depth = depth - 1
                    }
                    advance()
                }
            }
            diag_error("InlineModuleNotSupported", INLINE_MODULE_NOT_SUPPORTED, "inline modules are not supported; create a separate file and use `import` instead (see section 10.1.1)", mod_line, mod_col, "Blink uses file-based modules: one file = one module")
        } else {
            diag_error_range("UnexpectedToken", UNEXPECTED_TOKEN, "unexpected token at top level: {token_kind_name(peek_kind())}", peek_line(), peek_col(), peek_end_col(), "")
            advance()
        }
        if !is_annotation { ann_items = [] }
        skip_newlines_and_comments()
        // No-progress backstop (defense in depth, mirrors parse_block): a
        // top-level dispatch that consumed zero tokens would spin forever on
        // malformed input — force one advance to guarantee termination.
        if pos == top_before {
            advance()
        }
    }
    if fn_bodies.wanted {
        fn_bodies.item_firsts.push(pos)
        fn_bodies.item_kinds.push("end")
    }
    // Build sublists from collected node IDs
    let fns = new_sublist()
    let mut i = 0
    while i < fn_nodes.len() {
        sublist_push(fns, fn_nodes.get(i).unwrap())
        i = i + 1
    }
    finalize_sublist(fns)
    let types = new_sublist()
    i = 0
    while i < type_nodes.len() {
        sublist_push(types, type_nodes.get(i).unwrap())
        i = i + 1
    }
    finalize_sublist(types)
    let lets = new_sublist()
    i = 0
    while i < let_nodes.len() {
        sublist_push(lets, let_nodes.get(i).unwrap())
        i = i + 1
    }
    finalize_sublist(lets)
    let traits = new_sublist()
    i = 0
    while i < trait_nodes.len() {
        sublist_push(traits, trait_nodes.get(i).unwrap())
        i = i + 1
    }
    finalize_sublist(traits)
    let impls = new_sublist()
    i = 0
    while i < impl_nodes.len() {
        sublist_push(impls, impl_nodes.get(i).unwrap())
        i = i + 1
    }
    finalize_sublist(impls)
    let imports = new_sublist()
    i = 0
    while i < import_nodes.len() {
        sublist_push(imports, import_nodes.get(i).unwrap())
        i = i + 1
    }
    finalize_sublist(imports)
    let mut effect_decls = -1
    if effect_decl_nodes.len() > 0 {
        effect_decls = new_sublist()
        i = 0
        while i < effect_decl_nodes.len() {
            sublist_push(effect_decls, effect_decl_nodes.get(i).unwrap())
            i = i + 1
        }
        finalize_sublist(effect_decls)
    }
    let mut annotations_sl = -1
    if annotations.item.len() > 0 || annotations.program.len() > 0 {
        annotations_sl = new_sublist()
        i = 0
        while i < annotations.program.len() {
            sublist_push(annotations_sl, annotations.program.get(i).unwrap())
            i = i + 1
        }
        i = 0
        while i < annotations.item.len() {
            sublist_push(annotations_sl, annotations.item.get(i).unwrap())
            i = i + 1
        }
        finalize_sublist(annotations_sl)
    }
    // captures field on Program is reused to store collected test block nodes
    let mut tests_sl = -1
    if test_nodes.len() > 0 {
        tests_sl = new_sublist()
        i = 0
        while i < test_nodes.len() {
            sublist_push(tests_sl, test_nodes.get(i).unwrap())
            i = i + 1
        }
        finalize_sublist(tests_sl)
    }
    let prog = node_count()
    node_push(AstNode {
        kind: NodeKind.Program,
        params: fns, fields: types, stmts: lets, arms: traits,
        methods: impls, elements: imports, args: effect_decls,
        handlers: annotations_sl, captures: tests_sl,
        line: peek_line(), col: peek_col(),
    })
    if trace_mode != "" { trace("parse", "done ({fn_nodes.len()} fns, {type_nodes.len()} types, {import_nodes.len()} imports)") }
    prog
}

// ── Type parameters ──────────────────────────────────────────────────

fn parse_type_params() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    if !at(TokenKind.LBracket) {
        return -1
    }
    advance()
    let sl = new_sublist()
    let pname = expect_value(TokenKind.Ident)
    let mut bounds_sl = -1
    if at(TokenKind.Colon) {
        advance()
        bounds_sl = new_sublist()
        sublist_push(bounds_sl, parse_type_annotation())
        while at(TokenKind.Plus) {
            advance()
            skip_newlines()
            sublist_push(bounds_sl, parse_type_annotation())
        }
        finalize_sublist(bounds_sl)
    }
    let tp = node_count()
    node_push(AstNode {
        kind: NodeKind.TypeParam, name: pname, elements: bounds_sl,
        line: peek_line(), col: peek_col(),
    })
    sublist_push(sl, tp)
    while at(TokenKind.Comma) {
        advance()
        skip_newlines()
        let pn2 = expect_value(TokenKind.Ident)
        let mut bs2 = -1
        if at(TokenKind.Colon) {
            advance()
            bs2 = new_sublist()
            sublist_push(bs2, parse_type_annotation())
            while at(TokenKind.Plus) {
                advance()
                skip_newlines()
                sublist_push(bs2, parse_type_annotation())
            }
            finalize_sublist(bs2)
        }
        let tp2 = node_count()
        node_push(AstNode {
            kind: NodeKind.TypeParam, name: pn2, elements: bs2,
            line: peek_line(), col: peek_col(),
        })
        sublist_push(sl, tp2)
    }
    expect(TokenKind.RBracket)
    finalize_sublist(sl)
    sl
}

// Parse a single `where` constraint: `Ident: Bound (+ Bound)*`. Stored as a
// TypeParam node (name + bounds in `elements`), mirroring the `[T: Bound]`
// binder shape so the formatter can reuse format_type_param_binder.
fn parse_where_constraint() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    let cname = expect_value(TokenKind.Ident)
    let mut bounds_sl = -1
    if at(TokenKind.Colon) {
        advance()
        bounds_sl = new_sublist()
        sublist_push(bounds_sl, parse_type_annotation())
        while at(TokenKind.Plus) {
            advance()
            skip_newlines()
            sublist_push(bounds_sl, parse_type_annotation())
        }
        finalize_sublist(bounds_sl)
    }
    let tp = node_count()
    node_push(AstNode {
        kind: NodeKind.TypeParam, name: cname, elements: bounds_sl,
        line: peek_line(), col: peek_col(),
    })
    tp
}

// ── Type definitions ────────────────────────────────────────────────

fn parse_type_def() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    let td_start_line = peek_line()
    let td_start_col = peek_col()
    expect(TokenKind.Type)
    let name = expect_value(TokenKind.Ident)
    let tparams = parse_type_params()
    skip_newlines_and_comments()
    let mut flds = -1
    let mut td_end_line = -1
    let mut td_end_col = -1
    if at(TokenKind.Equals) {
        advance()
        let alias_type = parse_type_annotation()
        let mut where_expr = -1
        if at(TokenKind.At) {
            advance()
            let ann_name = expect_value(TokenKind.Ident)
            if ann_name == "where" {
                expect(TokenKind.LParen)
                skip_newlines()
                where_expr = parse_expr()
                skip_newlines()
                expect(TokenKind.RParen)
            } else {
                diag_error_range("UnexpectedAnnotation", UNEXPECTED_ANNOTATION, "only @where is supported on type aliases, got @{ann_name}", peek_line(), peek_col(), peek_end_col(), "use @where(predicate) to add a refinement constraint")
            }
        }
        let td = node_count()
        node_push(AstNode {
            kind: NodeKind.TypeDef,
            name: name, type_params: tparams,
            value: alias_type, condition: where_expr,
            line: td_start_line, col: td_start_col,
        })
        return td
    }
    if at(TokenKind.LBrace) {
        expect(TokenKind.LBrace)
        skip_newlines_and_comments()
        flds = new_sublist()
        while !at(TokenKind.RBrace) && !at(TokenKind.EOF) {
            if at(TokenKind.At) {
                advance()
                let _ann_name = expect_value(TokenKind.Ident)
                if at(TokenKind.LParen) {
                    advance()
                    skip_newlines_and_comments()
                    let mut depth = 1
                    while depth > 0 && !at(TokenKind.EOF) {
                        if at(TokenKind.LParen) {
                            depth = depth + 1
                        } else if at(TokenKind.RParen) {
                            depth = depth - 1
                            if depth == 0 {
                                break
                            }
                        }
                        advance()
                    }
                    expect(TokenKind.RParen)
                }
                skip_newlines_and_comments()
                continue
            }
            if at(TokenKind.EOF) {
                break
            }
            if at(TokenKind.Mut) {
                diag_error_range("MutFieldNotSupported", MUT_FIELD_NOT_SUPPORTED, "`mut` is not valid on struct fields — mutability is controlled by the binding (let mut)", peek_line(), peek_col(), peek_end_col(), "remove `mut` from the field declaration; use `let mut` when binding the struct")
                while at(TokenKind.Mut) {
                    advance()
                }
            }
            let fname = expect_value(TokenKind.Ident)
            if at(TokenKind.Colon) {
                advance()
                let type_ann = parse_type_annotation()
                let tf_line = peek_line()
                let tf_col = peek_col()
                let mut tf_default = -1
                if at(TokenKind.Equals) {
                    advance()
                    skip_newlines_and_comments()
                    tf_default = parse_expr()
                }
                let tf = node_count()
                node_push(AstNode {
                    kind: NodeKind.TypeField,
                    name: fname, value: type_ann, condition: tf_default,
                    line: tf_line, col: tf_col,
                })
                sublist_push(flds, tf)
            } else if at(TokenKind.LParen) {
                advance()
                skip_newlines_and_comments()
                let mut vflds = -1
                if !at(TokenKind.RParen) {
                    vflds = new_sublist()
                    // A variant's payload fields are either NAMED (`name: Type`) or
                    // POSITIONAL (`Type`); the two forms must not be mixed within one
                    // variant. Positional fields get synthesized names `_0`, `_1`, …
                    // so they flow through registration/construction/match exactly
                    // like named fields. Disambiguate per-field with one-token
                    // lookahead: `Ident` immediately followed by `:` is a name.
                    let mut vf_idx = 0
                    while !at(TokenKind.RParen) && !at(TokenKind.EOF) {
                        if at(TokenKind.Mut) {
                            diag_error_range("MutFieldNotSupported", MUT_FIELD_NOT_SUPPORTED, "`mut` is not valid on struct fields — mutability is controlled by the binding (let mut)", peek_line(), peek_col(), peek_end_col(), "remove `mut` from the field declaration; use `let mut` when binding the struct")
                            while at(TokenKind.Mut) {
                                advance()
                            }
                        }
                        let vf_line = peek_line()
                        let vf_col = peek_col()
                        let is_named = at(TokenKind.Ident) && peek_kind_at(pos + 1) == TokenKind.Colon
                        let mut vf_name = "_{vf_idx}"
                        if is_named != 0 {
                            vf_name = expect_value(TokenKind.Ident)
                            expect(TokenKind.Colon)
                        }
                        let vf_type = parse_type_annotation()
                        let vf = node_count()
                        // int_val marks a POSITIONAL field (synthesized `_N` name) so
                        // the formatter round-trips `Variant(Type)` rather than leaking
                        // the synthesized name as `Variant(_0: Type)`.
                        let is_positional = if is_named != 0 { 0 } else { 1 }
                        node_push(AstNode {
                            kind: NodeKind.TypeField, name: vf_name, value: vf_type,
                            int_val: is_positional,
                            line: vf_line, col: vf_col,
                        })
                        sublist_push(vflds, vf)
                        vf_idx = vf_idx + 1
                        skip_newlines_and_comments()
                        if at(TokenKind.Comma) {
                            advance()
                            skip_newlines_and_comments()
                        } else {
                            break
                        }
                    }
                    finalize_sublist(vflds)
                }
                skip_newlines_and_comments()
                expect(TokenKind.RParen)
                let tv = node_count()
                node_push(AstNode {
                    kind: NodeKind.TypeVariant, name: fname, fields: vflds,
                    line: peek_line(), col: peek_col(),
                })
                sublist_push(flds, tv)
            } else if at(TokenKind.LBrace) {
                // Struct-style variant: VariantName { field: Type, ... }
                advance()
                skip_newlines_and_comments()
                let mut vflds = new_sublist()
                while !at(TokenKind.RBrace) && !at(TokenKind.EOF) {
                    if at(TokenKind.Mut) {
                        diag_error_range("MutFieldNotSupported", MUT_FIELD_NOT_SUPPORTED, "`mut` is not valid on struct fields — mutability is controlled by the binding (let mut)", peek_line(), peek_col(), peek_end_col(), "remove `mut` from the field declaration; use `let mut` when binding the struct")
                        while at(TokenKind.Mut) {
                            advance()
                        }
                    }
                    let vf_name = expect_value(TokenKind.Ident)
                    expect(TokenKind.Colon)
                    let vf_type = parse_type_annotation()
                    let vf = node_count()
                    node_push(AstNode {
                        kind: NodeKind.TypeField, name: vf_name, value: vf_type,
                        line: peek_line(), col: peek_col(),
                    })
                    sublist_push(vflds, vf)
                    if at(TokenKind.Comma) {
                        advance()
                    }
                    skip_newlines_and_comments()
                }
                finalize_sublist(vflds)
                expect(TokenKind.RBrace)
                let tv = node_count()
                // int_val = 1: reuse shared AstNode flag to distinguish struct-style from tuple-style
                node_push(AstNode {
                    kind: NodeKind.TypeVariant, name: fname, fields: vflds, int_val: 1,
                    line: peek_line(), col: peek_col(),
                })
                sublist_push(flds, tv)
            } else {
                let tv_line = peek_line()
                let tv_col = peek_col()
                let mut tv_str = ""
                if at(TokenKind.Equals) {
                    advance()
                    skip_newlines_and_comments()
                    let str_node = parse_interp_string()
                    let parts_sl = node_elements(str_node)
                    if parts_sl != -1 && sublist_length(parts_sl) == 1 {
                        let part = sublist_get(parts_sl, 0)
                        tv_str = node_str_val(part)
                    } else {
                        diag_error_range("InvalidStringBackedEnum", INVALID_STRING_BACKED_ENUM, "string-backed enum values must be plain string literals", peek_line(), peek_col(), peek_end_col(), "use a simple string like = \"value\"")
                    }
                }
                let tv = node_count()
                node_push(AstNode {
                    kind: NodeKind.TypeVariant, name: fname, str_val: tv_str,
                    line: tv_line, col: tv_col,
                })
                sublist_push(flds, tv)
            }
            if at(TokenKind.Comma) {
                advance()
            }
            skip_newlines_and_comments()
        }
        td_end_line = peek_line()
        td_end_col = peek_col()
        expect(TokenKind.RBrace)
        finalize_sublist(flds)
    }
    let td = node_count()
    node_push(AstNode {
        kind: NodeKind.TypeDef,
        name: name, fields: flds, type_params: tparams,
        line: td_start_line, col: td_start_col,
        end_line: td_end_line, end_col: td_end_col,
    })
    td
}

fn parse_type_annotation() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    if at(TokenKind.LBracket) {
        advance()
        skip_newlines()
        let inner = parse_type_annotation()
        skip_newlines()
        expect(TokenKind.RBracket)
        let elems = new_sublist()
        sublist_push(elems, inner)
        finalize_sublist(elems)
        let ta = node_count()
        node_push(AstNode { kind: NodeKind.TypeAnn, name: "List", elements: elems, line: peek_line(), col: peek_col() })
        return ta
    }
    if at(TokenKind.LParen) {
        advance()
        skip_newlines()
        if at(TokenKind.RParen) {
            advance()
            // The unit type is the 0-tuple, and it is the type an omitted return type
            // already names, so it is spelled here the way that one is.
            let ua = node_count()
            node_push(AstNode { kind: NodeKind.TypeAnn, name: "Void", line: peek_line(), col: peek_col() })
            return ua
        }
        let elems = new_sublist()
        sublist_push(elems, parse_type_annotation())
        while at(TokenKind.Comma) {
            advance()
            skip_newlines()
            sublist_push(elems, parse_type_annotation())
        }
        skip_newlines()
        expect(TokenKind.RParen)
        finalize_sublist(elems)
        let ta = node_count()
        node_push(AstNode { kind: NodeKind.TypeAnn, name: "Tuple", elements: elems, line: peek_line(), col: peek_col() })
        return ta
    }
    if at(TokenKind.Fn) {
        advance()
        expect(TokenKind.LParen)
        skip_newlines()
        let mut elems = -1
        if !at(TokenKind.RParen) {
            elems = new_sublist()
            sublist_push(elems, parse_type_annotation())
            while at(TokenKind.Comma) {
                advance()
                skip_newlines()
                sublist_push(elems, parse_type_annotation())
            }
            finalize_sublist(elems)
        }
        skip_newlines()
        expect(TokenKind.RParen)
        let mut ret_name = "Void"
        let mut ret_ann = -1
        if at(TokenKind.Arrow) {
            advance()
            let rt = parse_type_annotation()
            ret_name = node_name(rt)
            ret_ann = rt
        }
        let ta = node_count()
        node_push(AstNode {
            kind: NodeKind.TypeAnn, name: "Fn", elements: elems,
            return_type: ret_name, type_ann: ret_ann,
            line: peek_line(), col: peek_col(),
        })
        return ta
    }
    if at(TokenKind.Handler) {
        advance()
        expect(TokenKind.LBracket)
        let eff_ann = parse_type_annotation()
        expect(TokenKind.RBracket)
        let elems = new_sublist()
        sublist_push(elems, eff_ann)
        finalize_sublist(elems)
        let ta = node_count()
        node_push(AstNode { kind: NodeKind.TypeAnn, name: "Handler", elements: elems, line: peek_line(), col: peek_col() })
        return ta
    }
    let mut name = expect_value(TokenKind.Ident)
    if at(TokenKind.Dot) {
        advance()
        let qualified = expect_value(TokenKind.Ident)
        name = name.concat(".").concat(qualified)
    }
    let mut elems = -1
    if at(TokenKind.LBracket) {
        advance()
        elems = new_sublist()
        sublist_push(elems, parse_type_annotation())
        while at(TokenKind.Comma) {
            advance()
            skip_newlines()
            sublist_push(elems, parse_type_annotation())
        }
        expect(TokenKind.RBracket)
        finalize_sublist(elems)
    }
    let ta = node_count()
    node_push(AstNode { kind: NodeKind.TypeAnn, name: name, elements: elems, line: peek_line(), col: peek_col() })
    if at(TokenKind.Question) {
        advance()
        let inner_sl = new_sublist()
        sublist_push(inner_sl, ta)
        finalize_sublist(inner_sl)
        let opt = node_count()
        node_push(AstNode { kind: NodeKind.TypeAnn, name: "Option", elements: inner_sl, line: peek_line(), col: peek_col() })
        return opt
    }
    ta
}

// ── Effect declarations ─────────────────────────────────────────────

fn parse_effect_op_sig() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    expect(TokenKind.Fn)
    let op_name = expect_value(TokenKind.Ident)
    expect(TokenKind.LParen)
    let params_sl = new_sublist()
    skip_newlines()
    if !at(TokenKind.RParen) {
        sublist_push(params_sl, parse_param())
        while at(TokenKind.Comma) {
            advance()
            skip_newlines()
            if at(TokenKind.RParen) {
                break
            }
            sublist_push(params_sl, parse_param())
        }
        skip_newlines()
    }
    expect(TokenKind.RParen)
    finalize_sublist(params_sl)
    let mut ret_str = ""
    let mut ret_ann = -1
    if at(TokenKind.Arrow) {
        advance()
        let rt = parse_type_annotation()
        ret_str = node_name(rt)
        ret_ann = rt
    }
    let nd = node_count()
    node_push(AstNode {
        kind: NodeKind.FnDef,
        name: op_name, params: params_sl,
        return_type: ret_str, type_ann: ret_ann,
        line: peek_line(), col: peek_col(),
    })
    nd
}

fn parse_effect_decl() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    let eff_start_line = peek_line()
    let eff_start_col = peek_col()
    expect(TokenKind.Effect)
    let name = expect_value(TokenKind.Ident)
    skip_newlines_and_comments()
    if at(TokenKind.LBrace) {
        advance()
        skip_newlines_and_comments()
        let children_sl = new_sublist()
        while !at(TokenKind.RBrace) && !at(TokenKind.EOF) {
            expect(TokenKind.Effect)
            let child_name = expect_value(TokenKind.Ident)
            skip_newlines_and_comments()
            let mut child_methods_sl = -1
            if at(TokenKind.LBrace) {
                advance()
                skip_newlines_and_comments()
                child_methods_sl = new_sublist()
                while !at(TokenKind.RBrace) && !at(TokenKind.EOF) {
                    sublist_push(child_methods_sl, parse_effect_op_sig())
                    skip_newlines_and_comments()
                }
                expect(TokenKind.RBrace)
                finalize_sublist(child_methods_sl)
            }
            let child = node_count()
            node_push(AstNode {
                kind: NodeKind.EffectDecl, name: child_name, methods: child_methods_sl,
                line: peek_line(), col: peek_col(),
            })
            sublist_push(children_sl, child)
            skip_newlines_and_comments()
            if at(TokenKind.Comma) {
                advance()
            }
            skip_newlines_and_comments()
        }
        expect(TokenKind.RBrace)
        finalize_sublist(children_sl)
        let nd = node_count()
        node_push(AstNode {
            kind: NodeKind.EffectDecl, name: name, elements: children_sl,
            line: eff_start_line, col: eff_start_col,
        })
        return nd
    }
    let nd = node_count()
    node_push(AstNode {
        kind: NodeKind.EffectDecl, name: name,
        line: eff_start_line, col: eff_start_col,
    })
    nd
}

// ── Function definitions ────────────────────────────────────────────

fn parse_fn_def() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    let fn_start_line = peek_line()
    let fn_start_col = peek_col()
    expect(TokenKind.Fn)
    let name = expect_value(TokenKind.Ident)
    let tparams = parse_type_params()
    expect(TokenKind.LParen)
    let params = new_sublist()
    let mut kw_only = 0
    skip_newlines()
    if at(TokenKind.DashDash) {
        advance()
        kw_only = 1
    }
    if !at(TokenKind.RParen) {
        let p = parse_param()
        if kw_only { node_set_int_val(p, 1) }
        sublist_push(params, p)
        while at(TokenKind.Comma) {
            advance()
            skip_newlines()
            if at(TokenKind.RParen) {
                break
            }
            if at(TokenKind.DashDash) {
                advance()
                kw_only = 1
            }
            let p2 = parse_param()
            if kw_only { node_set_int_val(p2, 1) }
            sublist_push(params, p2)
        }
        skip_newlines()
    }
    expect(TokenKind.RParen)
    finalize_sublist(params)
    let mut ret_str = ""
    let mut ret_ann = -1
    if at(TokenKind.Arrow) {
        advance()
        let rt = parse_type_annotation()
        ret_str = node_name(rt)
        ret_ann = rt
    }
    let mut effects_sl = -1
    if at(TokenKind.Bang) {
        advance()
        effects_sl = new_sublist()
        let mut eff_name = expect_value(TokenKind.Ident)
        if at(TokenKind.Dot) {
            advance()
            eff_name = eff_name.concat(".").concat(expect_value(TokenKind.Ident))
        }
        let eff = node_count()
        node_push(AstNode { kind: NodeKind.Ident, name: eff_name, line: peek_line(), col: peek_col() })
        sublist_push(effects_sl, eff)
        while at(TokenKind.Comma) {
            advance()
            skip_newlines_and_comments()
            let mut eff_name2 = expect_value(TokenKind.Ident)
            if at(TokenKind.Dot) {
                advance()
                eff_name2 = eff_name2.concat(".").concat(expect_value(TokenKind.Ident))
            }
            let eff2 = node_count()
            node_push(AstNode { kind: NodeKind.Ident, name: eff_name2, line: peek_line(), col: peek_col() })
            sublist_push(effects_sl, eff2)
        }
        finalize_sublist(effects_sl)
    }
    skip_newlines()
    let mut body_id = -1
    if at(TokenKind.LBrace) {
        let tok_first = pos
        fn_bodies.depth = fn_bodies.depth + 1
        body_id = parse_block()
        fn_bodies.depth = fn_bodies.depth - 1
        if fn_bodies.wanted && fn_bodies.depth == 0 {
            fn_bodies.tok_firsts.push(tok_first)
            fn_bodies.tok_lasts.push(pos - 1)
        }
    }
    let mut fn_end_l = -1
    let mut fn_end_c = -1
    if body_id != -1 {
        let el = node_end_line(body_id)
        if el != -1 {
            fn_end_l = el
            fn_end_c = node_end_col(body_id)
        }
    }
    let nd = node_count()
    node_push(AstNode {
        kind: NodeKind.FnDef,
        name: name, params: params, body: body_id,
        return_type: ret_str, type_params: tparams,
        effects: effects_sl, type_ann: ret_ann,
        line: fn_start_line, col: fn_start_col,
        end_line: fn_end_l, end_col: fn_end_c,
    })
    nd
}

// ── Test blocks ──────────────────────────────────────────────────────

fn parse_test_block() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    let test_start_line = peek_line()
    let test_start_col = peek_col()
    // 'test' already consumed — but we capture line from the string token
    let name_node = parse_interp_string()
    let name_parts_sl = node_elements(name_node)
    let mut test_name = ""
    if name_parts_sl != -1 && sublist_length(name_parts_sl) > 0 {
        test_name = node_str_val(sublist_get(name_parts_sl, 0))
    }
    skip_newlines_and_comments()
    if at(TokenKind.Arrow) {
        let arrow_l = peek_line()
        let arrow_c = peek_col()
        let arrow_ec = peek_end_col()
        advance()
        let _ = parse_type_annotation()   // consume + discard; do NOT store on node
        diag_error_range("AnnotatedTestReturnTypeRejected", TEST_ANNOTATED_RETURN,
            "test blocks cannot declare an explicit return type; it is inferred — Void, or Result[Void, TestError] when the body uses `?`",
            arrow_l, arrow_c, arrow_ec,
            "remove the `-> ...` annotation")
        skip_newlines_and_comments()      // handle optional newline before `{`
    }
    let body = parse_block()
    let mut tb_end_l = -1
    let mut tb_end_c = -1
    let el = node_end_line(body)
    if el != -1 {
        tb_end_l = el
        tb_end_c = node_end_col(body)
    }
    let nd = node_count()
    node_push(AstNode {
        kind: NodeKind.TestBlock,
        str_val: test_name, name: test_name, body: body,
        line: test_start_line, col: test_start_col,
        end_line: tb_end_l, end_col: tb_end_c,
    })
    nd
}

// test.failing("name", reason: "...") { ... } (§8.10.6).
// 'test' and '.failing' already consumed. Named-arg keyword form, hand-rolled
// like assert_panics(matching:). Any other argument, `ticket:` included, is
// refused. A missing `reason:` is not a parse error: the row keeps an empty
// reason and typecheck reports E0835 for it.
// Consumes a required Comma, but WITHOUT expect()'s auto-advance-on-mismatch —
// that behavior is exactly what causes a single missing comma to cascade into
// two diagnostics here: expect(Comma) would eat the very token (`reason`)
// the next check looks for, so the next check's failure fires a second,
// misleading diagnostic. Diagnose the missing comma without moving the cursor
// if the token positioned there is plausibly the next keyword.
fn expect_field_comma() -> Int ! Parse.Advance, Diag.Report {
    if at(TokenKind.Comma) {
        advance()
        return 1
    }
    diag_error_range("UnexpectedToken", UNEXPECTED_TOKEN,
        "expected `,` in test.failing(...)",
        peek_line(), peek_col(), peek_end_col(), "")
    0
}

// Extracts the literal text of a parse_interp_string() result, rejecting
// `{...}` splices (test.failing metadata must be static, so the reason a
// report shows is the one written in the source).
fn literal_interp_string_or_error(node: Int, field_label: Str) -> Str ! Diag.Report {
    let parts_sl = node_elements(node)
    if parts_sl == -1 || sublist_length(parts_sl) == 0 { return "" }
    if sublist_length(parts_sl) > 1 {
        diag_error_range("UnexpectedToken", UNEXPECTED_TOKEN,
            "test.failing {field_label} must be a plain string literal, not an interpolated string",
            node_line(node), node_col(node), node_end_col(node), "")
    }
    node_str_val(sublist_get(parts_sl, 0))
}

fn parse_test_failing_block() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    let tf_start_line = peek_line()
    let tf_start_col = peek_col()
    expect(TokenKind.LParen)
    skip_newlines_and_comments()
    let name_node = parse_interp_string()
    let test_name = literal_interp_string_or_error(name_node, "name")
    skip_newlines_and_comments()
    if !at(TokenKind.RParen) {
        expect_field_comma()
        skip_newlines_and_comments()
    }
    let mut reason = ""
    while at(TokenKind.Ident) && peek_value() == "reason" {
        advance()
        expect(TokenKind.Colon)
        skip_newlines_and_comments()
        reason = literal_interp_string_or_error(parse_interp_string(), "reason")
        skip_newlines_and_comments()
        if at(TokenKind.Comma) {
            advance()
            skip_newlines_and_comments()
        } else if !at(TokenKind.RParen) {
            expect_field_comma()
            skip_newlines_and_comments()
        }
    }
    if !at(TokenKind.RParen) && !at(TokenKind.EOF) {
        diag_error_range("UnexpectedToken", UNEXPECTED_TOKEN,
            "test.failing(...) takes only a name and `reason:`",
            peek_line(), peek_col(), peek_end_col(), "")
        // Resync on the closing paren so one stray argument is one diagnostic.
        while !at(TokenKind.RParen) && !at(TokenKind.EOF) && !at(TokenKind.LBrace) { advance() }
    }
    expect(TokenKind.RParen)
    skip_newlines_and_comments()
    let body = parse_block()
    let mut tf_end_l = -1
    let mut tf_end_c = -1
    let el = node_end_line(body)
    if el != -1 {
        tf_end_l = el
        tf_end_c = node_end_col(body)
    }
    let nd = node_count()
    node_push(AstNode {
        kind: NodeKind.TestBlock,
        str_val: test_name, name: test_name, body: body,
        xfail_reason: reason, int_val: 1,
        line: tf_start_line, col: tf_start_col,
        end_line: tf_end_l, end_col: tf_end_c,
    })
    nd
}

fn parse_param() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    let mut is_mut = 0
    if at(TokenKind.Mut) {
        is_mut = 1
        advance()
    }
    let mut name = ""
    if at(TokenKind.Self) {
        name = "self"
        advance()
    } else {
        name = expect_value(TokenKind.Ident)
    }
    let mut type_str = ""
    let mut type_ann_id = -1
    if at(TokenKind.Colon) {
        advance()
        let ta = parse_type_annotation()
        type_str = node_name(ta)
        type_ann_id = ta
    }
    // §2.13: a parameter may carry a default value. Whether this parameter is allowed one,
    // and whether the expression qualifies as const, are both decided in typecheck — the
    // separator that governs the first rule is read by the caller, not here.
    let mut default_id = -1
    if at(TokenKind.Equals) {
        advance()
        default_id = parse_expr()
    }
    let nd = node_count()
    node_push(AstNode {
        kind: NodeKind.Param,
        name: name, type_name: type_str,
        is_mut: is_mut, type_ann: type_ann_id,
        value: default_id,
        line: peek_line(), col: peek_col(),
    })
    nd
}

fn parse_closure() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    expect(TokenKind.Fn)
    expect(TokenKind.LParen)
    let params = new_sublist()
    let mut cl_kw_only = 0
    skip_newlines()
    if at(TokenKind.DashDash) {
        advance()
        cl_kw_only = 1
    }
    if !at(TokenKind.RParen) {
        let cp = parse_param()
        if cl_kw_only { node_set_int_val(cp, 1) }
        sublist_push(params, cp)
        while at(TokenKind.Comma) {
            advance()
            skip_newlines()
            if at(TokenKind.RParen) {
                break
            }
            if at(TokenKind.DashDash) {
                advance()
                cl_kw_only = 1
            }
            let cp2 = parse_param()
            if cl_kw_only { node_set_int_val(cp2, 1) }
            sublist_push(params, cp2)
        }
        skip_newlines()
    }
    expect(TokenKind.RParen)
    finalize_sublist(params)
    let mut ret_str = ""
    let mut ret_ann = -1
    if at(TokenKind.Arrow) {
        advance()
        let rt = parse_type_annotation()
        ret_str = node_name(rt)
        ret_ann = rt
    }
    skip_newlines_and_comments()
    let body_id = parse_block()
    let nd = node_count()
    node_push(AstNode {
        kind: NodeKind.Closure,
        params: params, body: body_id,
        return_type: ret_str, type_ann: ret_ann,
        line: peek_line(), col: peek_col(),
    })
    nd
}

// ── Trait definitions ────────────────────────────────────────────────

fn parse_trait_def() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    let trait_start_line = peek_line()
    let trait_start_col = peek_col()
    expect(TokenKind.Trait)
    let name = expect_value(TokenKind.Ident)
    let mut trait_type_args = -1
    if at(TokenKind.LBracket) {
        advance()
        trait_type_args = new_sublist()
        sublist_push(trait_type_args, parse_type_annotation())
        while at(TokenKind.Comma) {
            advance()
            skip_newlines()
            sublist_push(trait_type_args, parse_type_annotation())
        }
        expect(TokenKind.RBracket)
        finalize_sublist(trait_type_args)
    }
    // Optional supertrait clause: `trait Sub: Super1 + Super2 { ... }` (§3.6).
    // Each supertrait is a trait-name reference parsed as a type annotation, so a
    // parameterized supertrait (`Contains[T]`) keeps its args. A trait's guarantee
    // set is the closure over this list — see tc_push_self_frame in typecheck.
    let mut supertraits = -1
    if at(TokenKind.Colon) {
        advance()
        skip_newlines()
        supertraits = new_sublist()
        sublist_push(supertraits, parse_type_annotation())
        while at(TokenKind.Plus) {
            advance()
            skip_newlines()
            sublist_push(supertraits, parse_type_annotation())
        }
        finalize_sublist(supertraits)
    }
    skip_newlines_and_comments()
    expect(TokenKind.LBrace)
    skip_newlines_and_comments()
    let assoc_types = new_sublist()
    let methods = new_sublist()
    // The trait's own annotations stay pending until the caller attaches them.
    let trait_anns = annotations.item
    annotations.item = []
    while !at(TokenKind.RBrace) && !at(TokenKind.EOF) {
        if at(TokenKind.At) {
            annotations.item.push(parse_annotation())
        } else if at(TokenKind.Fn) {
            let fn_node = parse_fn_def()
            attach_pending_annotations(fn_node)
            sublist_push(methods, fn_node)
        } else if at(TokenKind.Type) {
            advance()
            let atype_name = expect_value(TokenKind.Ident)
            reject_pending_annotations("before associated type `{atype_name}`: an associated type takes no annotation", "remove the annotation, or move it above the method it belongs to")
            let at_node = node_count()
            node_push(AstNode { kind: NodeKind.AssocType, name: atype_name, line: peek_line(), col: peek_col() })
            sublist_push(assoc_types, at_node)
        } else {
            reject_body_token("trait `{name}`", 1)
        }
        skip_newlines_and_comments()
    }
    reject_pending_annotations("in trait `{name}` is not followed by a method", "move the annotation above the method it belongs to, or remove it")
    annotations.item = trait_anns
    let trait_end_line = peek_line()
    let trait_end_col = peek_col()
    expect(TokenKind.RBrace)
    finalize_sublist(methods)
    finalize_sublist(assoc_types)
    let nd = node_count()
    node_push(AstNode {
        kind: NodeKind.TraitDef,
        name: name, methods: methods, assoc_types: assoc_types,
        type_params: trait_type_args, supertraits: supertraits,
        line: trait_start_line, col: trait_start_col,
        end_line: trait_end_line, end_col: trait_end_col,
    })
    nd
}

// ── Impl blocks ─────────────────────────────────────────────────────

fn parse_impl_block() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    let impl_start_line = peek_line()
    let impl_start_col = peek_col()
    expect(TokenKind.Impl)
    // Optional binder list: `impl[T]` / `impl[T: Bound]` (spec §3.6).
    // parse_type_params returns -1 when no `[` follows.
    let impl_binders = parse_type_params()
    let trait_name = expect_value(TokenKind.Ident)
    let mut trait_type_args = -1
    if at(TokenKind.LBracket) {
        advance()
        trait_type_args = new_sublist()
        sublist_push(trait_type_args, parse_type_annotation())
        while at(TokenKind.Comma) {
            advance()
            skip_newlines()
            sublist_push(trait_type_args, parse_type_annotation())
        }
        expect(TokenKind.RBracket)
        finalize_sublist(trait_type_args)
    }
    skip_newlines_and_comments()
    let mut type_name = ""
    let mut recv_type_args = -1
    if at(TokenKind.For) {
        advance()
        skip_newlines_and_comments()
        type_name = expect_value(TokenKind.Ident)
        if at(TokenKind.LBracket) {
            advance()
            recv_type_args = new_sublist()
            sublist_push(recv_type_args, parse_type_annotation())
            while at(TokenKind.Comma) {
                advance()
                skip_newlines()
                sublist_push(recv_type_args, parse_type_annotation())
            }
            expect(TokenKind.RBracket)
            finalize_sublist(recv_type_args)
        }
    }
    skip_newlines_and_comments()
    // Optional `where` clause: `where T: Bound, U: A + B` (parse+store only;
    // enforcement of these bounds is follow-up work). `where` is not a lexer
    // keyword, so peek for the bare ident before the opening brace. Each
    // constraint mirrors a `[T: Bound]` binder, so reuse the TypeParam shape.
    let mut impl_where_bounds = -1
    if at(TokenKind.Ident) && peek_value() == "where" {
        advance()
        skip_newlines()
        impl_where_bounds = new_sublist()
        sublist_push(impl_where_bounds, parse_where_constraint())
        while at(TokenKind.Comma) {
            advance()
            skip_newlines()
            sublist_push(impl_where_bounds, parse_where_constraint())
        }
        finalize_sublist(impl_where_bounds)
        skip_newlines_and_comments()
    }
    expect(TokenKind.LBrace)
    skip_newlines_and_comments()
    let assoc_types = new_sublist()
    let methods = new_sublist()
    // The impl block's own annotations stay pending until the caller attaches them.
    let impl_anns = annotations.item
    annotations.item = []
    while !at(TokenKind.RBrace) && !at(TokenKind.EOF) {
        if at(TokenKind.At) {
            annotations.item.push(parse_annotation())
        } else if at(TokenKind.Fn) {
            let fn_node = parse_fn_def()
            attach_pending_annotations(fn_node)
            sublist_push(methods, fn_node)
        } else if at(TokenKind.Type) {
            advance()
            let atype_name = expect_value(TokenKind.Ident)
            reject_pending_annotations("before associated type `{atype_name}`: an associated type takes no annotation", "remove the annotation, or move it above the method it belongs to")
            expect(TokenKind.Equals)
            let ta = parse_type_annotation()
            let concrete_name = node_name(ta)
            let at_node = node_count()
            node_push(AstNode {
                kind: NodeKind.AssocType,
                name: atype_name, type_name: concrete_name, type_ann: ta,
                line: peek_line(), col: peek_col(),
            })
            sublist_push(assoc_types, at_node)
        } else {
            reject_body_token("impl `{trait_name} for {type_name}`", 0)
        }
        skip_newlines_and_comments()
    }
    reject_pending_annotations("in impl `{trait_name} for {type_name}` is not followed by a method", "move the annotation above the method it belongs to, or remove it")
    annotations.item = impl_anns
    let impl_end_line = peek_line()
    let impl_end_col = peek_col()
    expect(TokenKind.RBrace)
    finalize_sublist(methods)
    finalize_sublist(assoc_types)
    let nd = node_count()
    node_push(AstNode {
        kind: NodeKind.ImplBlock,
        trait_name: trait_name, name: type_name,
        methods: methods, assoc_types: assoc_types,
        type_params: trait_type_args,
        impl_binders: impl_binders, recv_type_args: recv_type_args,
        impl_where_bounds: impl_where_bounds,
        line: impl_start_line, col: impl_start_col,
        end_line: impl_end_line, end_col: impl_end_col,
    })
    nd
}

// ── Handler expressions ──────────────────────────────────────────────

fn parse_handler_expr() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    expect(TokenKind.Handler)
    let effect_name = expect_value(TokenKind.Ident)
    let mut full_name = effect_name
    if at(TokenKind.Dot) {
        advance()
        let child = expect_value(TokenKind.Ident)
        full_name = full_name.concat(".").concat(child)
    }
    skip_newlines_and_comments()
    expect(TokenKind.LBrace)
    skip_newlines_and_comments()
    let methods = new_sublist()
    while !at(TokenKind.RBrace) && !at(TokenKind.EOF) {
        if at(TokenKind.Fn) {
            sublist_push(methods, parse_fn_def())
        } else {
            advance()
        }
        skip_newlines_and_comments()
    }
    expect(TokenKind.RBrace)
    finalize_sublist(methods)
    let nd = node_count()
    node_push(AstNode {
        kind: NodeKind.HandlerExpr, name: full_name, methods: methods,
        line: peek_line(), col: peek_col(),
    })
    nd
}

// ── With blocks ─────────────────────────────────────────────────────

fn parse_with_item() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    let expr = parse_expr()
    if at(TokenKind.Equals) {
        let mut lhs_name = ""
        if node_kind(expr) != NodeKind.Ident {
            diag_error_range("UnexpectedToken", UNEXPECTED_TOKEN, "left side of `=` in with-clause must be an identifier", peek_line(), peek_col(), peek_end_col(), "")
        } else {
            lhs_name = node_name(expr)
        }
        advance()
        skip_newlines_and_comments()
        let rhs = parse_expr()
        if !at(TokenKind.As) {
            diag_error_range("UnexpectedToken", UNEXPECTED_TOKEN, "expected `as <name>` after `{lhs_name} = <expr>` in with-clause, got {token_kind_name(peek_kind())}", peek_line(), peek_col(), peek_end_col(), "")
            let wr = node_count()
            node_push(AstNode {
                kind: NodeKind.WithResource, value: rhs, name: lhs_name,
                line: peek_line(), col: peek_col(),
            })
            return wr
        }
        advance()
        let with_mut = at(TokenKind.Mut) && peek_kind_at(pos + 1) == TokenKind.Ident
        if with_mut { advance() }
        let mut binding = ""
        if at(TokenKind.Ident) {
            binding = advance_value()
            if with_mut { report_mut_after_with_as(pos - 1) }
        } else {
            diag_error_range("UnexpectedToken", UNEXPECTED_TOKEN, "expected identifier after `as` in with-clause, got {token_kind_name(peek_kind())}", peek_line(), peek_col(), peek_end_col(), "")
            binding = lhs_name
        }
        if binding != lhs_name && lhs_name != "" {
            diag_error_range("UnexpectedToken", UNEXPECTED_TOKEN, "with-clause binding name `{binding}` must match left side `{lhs_name}`", peek_line(), peek_col(), peek_end_col(), "")
        }
        let wr = node_count()
        node_push(AstNode {
            kind: NodeKind.WithResource, value: rhs, name: binding,
            line: peek_line(), col: peek_col(),
        })
        return wr
    }
    if at(TokenKind.As) {
        advance()
        let with_mut = at(TokenKind.Mut) && peek_kind_at(pos + 1) == TokenKind.Ident
        if with_mut { advance() }
        let binding = expect_value(TokenKind.Ident)
        if with_mut { report_mut_after_with_as(pos - 1) }
        let wr = node_count()
        node_push(AstNode {
            kind: NodeKind.WithResource, value: expr, name: binding,
            line: peek_line(), col: peek_col(),
        })
        return wr
    }
    expr
}

fn parse_with_block() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    expect(TokenKind.With)
    let handlers_sl = new_sublist()
    sublist_push(handlers_sl, parse_with_item())
    while at(TokenKind.Comma) {
        advance()
        skip_newlines_and_comments()
        sublist_push(handlers_sl, parse_with_item())
    }
    skip_newlines_and_comments()
    let body = parse_block()
    finalize_sublist(handlers_sl)
    let nd = node_count()
    node_push(AstNode {
        kind: NodeKind.WithBlock, handlers: handlers_sl, body: body,
        line: peek_line(), col: peek_col(),
    })
    nd
}

// ── Block ───────────────────────────────────────────────────────────

fn parse_block() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    let block_start_line = peek_line()
    let block_start_col = peek_col()
    expect(TokenKind.LBrace)
    skip_newlines_and_comments()
    let stmts = new_sublist()
    while !at(TokenKind.RBrace) && !at(TokenKind.EOF) {
        let before = pos
        let stmt = parse_stmt()
        sublist_push(stmts, stmt)
        skip_newlines_and_comments()
        // No-progress backstop: if an entire parse_stmt consumed zero tokens
        // (e.g. parked on a string-structural token that parse_primary returns
        // on without advancing), force one advance so a malformed input can
        // never spin into unbounded allocation (defense in depth).
        if pos == before {
            advance()
        }
    }
    let rbrace_line = peek_line()
    let rbrace_col = peek_col()
    expect(TokenKind.RBrace)
    finalize_sublist(stmts)
    let nd = node_count()
    node_push(AstNode {
        kind: NodeKind.Block, stmts: stmts,
        line: block_start_line, col: block_start_col,
        end_line: rbrace_line, end_col: rbrace_col,
    })
    nd
}

// ── Statements ──────────────────────────────────────────────────────

fn parse_stmt() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    if at(TokenKind.While) {
        let nd = parse_while_loop()
        return nd
    }
    if at(TokenKind.Loop) {
        let nd = parse_loop_expr()
        return nd
    }
    if at(TokenKind.Break) {
        advance()
        maybe_newline()
        let nd = new_node(NodeKind.Break)
        return nd
    }
    if at(TokenKind.Continue) {
        advance()
        maybe_newline()
        let nd = new_node(NodeKind.Continue)
        return nd
    }
    if at(TokenKind.Let) {
        let nd = parse_let_binding()
        return nd
    }
    if at(TokenKind.Const) {
        let nd = parse_const_binding()
        return nd
    }
    if at(TokenKind.For) {
        let nd = parse_for_in()
        return nd
    }
    if at(TokenKind.Return) {
        let nd = parse_return_stmt()
        return nd
    }
    if at(TokenKind.If) {
        let nd = parse_if_expr()
        maybe_newline()
        return nd
    }
    if at(TokenKind.With) {
        let nd = parse_with_block()
        maybe_newline()
        return nd
    }
    if at(TokenKind.Match) {
        let nd = parse_match_expr()
        maybe_newline()
        return nd
    }

    if at(TokenKind.Assert) || at(TokenKind.AssertEq) || at(TokenKind.AssertNe) {
        let assert_kind = peek_kind()
        let assert_start_line = peek_line()
        let assert_start_col = peek_col()
        let mut assert_name = "assert"
        if assert_kind == TokenKind.AssertEq {
            assert_name = "assert_eq"
        } else if assert_kind == TokenKind.AssertNe {
            assert_name = "assert_ne"
        }
        advance()
        expect(TokenKind.LParen)
        skip_newlines_and_comments()
        let args_sl = new_sublist()
        sublist_push(args_sl, parse_expr())
        while at(TokenKind.Comma) {
            advance()
            skip_newlines_and_comments()
            if at(TokenKind.RParen) {
                break
            }
            sublist_push(args_sl, parse_expr())
        }
        skip_newlines_and_comments()
        expect(TokenKind.RParen)
        finalize_sublist(args_sl)
        let fn_ident = node_count()
        node_push(AstNode { kind: NodeKind.Ident, name: assert_name, line: assert_start_line, col: assert_start_col })
        let call_nd = node_count()
        node_push(AstNode { kind: NodeKind.Call, left: fn_ident, args: args_sl, line: assert_start_line, col: assert_start_col })
        maybe_newline()
        let stmt_nd = node_count()
        node_push(AstNode { kind: NodeKind.ExprStmt, value: call_nd, line: assert_start_line, col: assert_start_col })
        return stmt_nd
    }

    if at(TokenKind.AssertPanics) {
        let ap_start_line = peek_line()
        let ap_start_col = peek_col()
        advance()
        skip_newlines_and_comments()
        let mut matching_expr = -1
        if at(TokenKind.LParen) {
            // The only legal paren group is `(matching: <Str>)`. A bare `(`
            // followed by anything else (a closure `fn() { }`, a `{` block,
            // or a positional expr) is the rejected call/closure form.
            advance()
            skip_newlines_and_comments()
            if at(TokenKind.Ident) && peek_value() == "matching" {
                advance()
                expect(TokenKind.Colon)
                skip_newlines_and_comments()
                matching_expr = parse_expr()
                skip_newlines_and_comments()
                expect(TokenKind.RParen)
            } else {
                diag_error_range("AssertPanicsCallForm", UNEXPECTED_TOKEN,
                    "assert_panics takes a brace block, not a call argument: write `assert_panics \{ ... }` or `assert_panics(matching: \"substr\") \{ ... }`",
                    ap_start_line, ap_start_col, peek_end_col(),
                    "remove the parentheses and wrap the panicking code in a `\{ ... }` block")
                // Recover: drain the balanced paren group (the `(` was already
                // consumed, so start at depth 1) so the rejected call/closure
                // tokens don't cascade into follow-on parse errors.
                let mut depth = 1
                while depth > 0 && !at(TokenKind.EOF) {
                    if at(TokenKind.LParen) { depth = depth + 1 }
                    else if at(TokenKind.RParen) { depth = depth - 1 }
                    advance()
                }
                maybe_newline()
                return new_node(NodeKind.AssertPanics)
            }
            skip_newlines_and_comments()
        }
        let ap_body = parse_block()
        let mut ap_end_l = -1
        let mut ap_end_c = -1
        let ap_el = node_end_line(ap_body)
        if ap_el != -1 {
            ap_end_l = ap_el
            ap_end_c = node_end_col(ap_body)
        }
        maybe_newline()
        let ap_nd = node_count()
        node_push(AstNode {
            kind: NodeKind.AssertPanics,
            body: ap_body, value: matching_expr,
            line: ap_start_line, col: ap_start_col,
            end_line: ap_end_l, end_col: ap_end_c,
        })
        return ap_nd
    }

    let expr = parse_expr()

    if at(TokenKind.Equals) {
        advance()
        skip_newlines_and_comments()
        let val = parse_expr()
        maybe_newline()
        let nd = node_count()
        node_push(AstNode {
            kind: NodeKind.Assignment, target: expr, value: val,
            line: node_line(expr), col: node_col(expr),
        })
        return nd
    }

    if at(TokenKind.PlusEq) || at(TokenKind.MinusEq) || at(TokenKind.StarEq) || at(TokenKind.SlashEq) {
        let op_kind = peek_kind()
        advance()
        skip_newlines_and_comments()
        let val = parse_expr()
        maybe_newline()
        let mut op_str = "+"
        if op_kind == TokenKind.MinusEq {
            op_str = "-"
        } else if op_kind == TokenKind.StarEq {
            op_str = "*"
        } else if op_kind == TokenKind.SlashEq {
            op_str = "/"
        }
        let nd = node_count()
        node_push(AstNode {
            kind: NodeKind.CompoundAssign, op: op_str,
            target: expr, value: val,
            line: node_line(expr), col: node_col(expr),
        })
        return nd
    }

    maybe_newline()
    let nd = node_count()
    node_push(AstNode {
        kind: NodeKind.ExprStmt, value: expr,
        line: node_line(expr), col: node_col(expr),
    })
    nd
}

fn parse_let_binding() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    let let_start_line = peek_line()
    let let_start_col = peek_col()
    expect(TokenKind.Let)
    // `mut` marks the one name after it. Before a tuple pattern, a struct pattern or `_` it
    // marks no name, which is E0613.
    let is_mut = parse_binder_mut()
    let mut name = ""
    let mut pat = -1
    if at(TokenKind.LParen) || at_mut_before_let_pattern() {
        pat = parse_pattern()
        name = "_destructure"
    } else {
        let mut_tok = if at(TokenKind.Mut) { advance() } else { -1 }
        let binder_line = peek_line()
        let binder_col = peek_col()
        name = expect_value(TokenKind.Ident)
        // `let _ = e` discards the value, so the binder names nothing. A pattern already
        // says that structurally -- `_` in a match mints a WildcardPattern and carries no
        // name -- and the `let` form now says it the same way, in the slot a destructuring
        // `let` uses for its pattern. A later pass asks the node what the binder is instead
        // of asking how it is spelled.
        if name == "_" {
            pat = node_count()
            node_push(AstNode { kind: NodeKind.WildcardPattern, line: binder_line, col: binder_col })
            name = ""
            if mut_tok != -1 { report_mut_on_pattern(mut_tok, pos - 1, pos - 1, pat) }
        }
    }
    let mut type_ann = -1
    if at(TokenKind.Colon) {
        advance()
        type_ann = parse_type_annotation()
    }
    expect(TokenKind.Equals)
    skip_newlines_and_comments()
    let val = parse_expr()
    maybe_newline()
    let mut let_elems = -1
    if pat != -1 {
        let_elems = pat
    }
    let nd = node_count()
    node_push(AstNode {
        kind: NodeKind.LetBinding,
        name: name, value: val, is_mut: is_mut, target: type_ann,
        elements: let_elems,
        line: let_start_line, col: let_start_col,
    })
    nd
}

// `let mut (` or `let mut Name {`: a `mut` before a pattern that a `let` takes apart.
fn at_mut_before_let_pattern() -> Bool {
    if !at(TokenKind.Mut) { return false }
    let next = peek_kind_at(pos + 1)
    next == TokenKind.LParen || (next == TokenKind.Ident && peek_kind_at(pos + 2) == TokenKind.LBrace)
}

fn parse_const_binding() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    let const_start_line = peek_line()
    let const_start_col = peek_col()
    expect(TokenKind.Const)
    let name = expect_value(TokenKind.Ident)
    let mut type_ann = -1
    if at(TokenKind.Colon) {
        advance()
        type_ann = parse_type_annotation()
    }
    expect(TokenKind.Equals)
    skip_newlines_and_comments()
    let val = parse_expr()
    maybe_newline()
    let nd = node_count()
    node_push(AstNode {
        kind: NodeKind.LetBinding,
        name: name, value: val, is_const: 1, target: type_ann,
        line: const_start_line, col: const_start_col,
    })
    nd
}

fn parse_embed_expr() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    expect(TokenKind.Hash)
    let intrinsic = expect_value(TokenKind.Ident)
    if intrinsic != "embed" {
        diag_error_range("UnknownIntrinsic", UNKNOWN_INTRINSIC, "unknown compile-time intrinsic `#{intrinsic}` (only #embed is supported)", peek_line(), peek_col(), peek_end_col(), "")
        let nd = new_node(NodeKind.IntLit)
        return nd
    }
    expect(TokenKind.LParen)
    skip_newlines()
    expect(TokenKind.StringStart)
    let path = expect_value(TokenKind.StringPart)
    expect(TokenKind.StringEnd)
    skip_newlines()
    expect(TokenKind.RParen)
    let nd = node_count()
    node_push(AstNode {
        kind: NodeKind.EmbedExpr, str_val: path,
        line: peek_line(), col: peek_col(),
    })
    nd
}

fn parse_return_stmt() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    let ret_start_line = peek_line()
    let ret_start_col = peek_col()
    expect(TokenKind.Return)
    if at(TokenKind.Newline) || at(TokenKind.RBrace) || at(TokenKind.EOF) {
        maybe_newline()
        let nd = node_count()
        node_push(AstNode { kind: NodeKind.Return, line: ret_start_line, col: ret_start_col })
        return nd
    }
    let val = parse_expr()
    maybe_newline()
    let nd = node_count()
    node_push(AstNode { kind: NodeKind.Return, value: val, line: ret_start_line, col: ret_start_col })
    nd
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn parse_if_expr() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    let if_start_line = peek_line()
    let if_start_col = peek_col()
    expect(TokenKind.If)
    skip_newlines_and_comments()
    let cond = parse_expr()
    skip_newlines_and_comments()
    let then_b = parse_block()
    let mut else_b = -1
    let mut peek_pos = pos
    while peek_pos < tokens.kinds.len() && (peek_kind_at(peek_pos) == TokenKind.Newline || peek_kind_at(peek_pos) == TokenKind.Comment || peek_kind_at(peek_pos) == TokenKind.DocComment) {
        peek_pos = peek_pos + 1
    }
    if peek_pos < tokens.kinds.len() && peek_kind_at(peek_pos) == TokenKind.Else {
        skip_newlines_and_comments()
    }
    if at(TokenKind.Else) {
        advance()
        skip_newlines_and_comments()
        if at(TokenKind.If) {
            let inner = parse_if_expr()
            let stmts = new_sublist()
            sublist_push(stmts, inner)
            finalize_sublist(stmts)
            let blk = node_count()
            node_push(AstNode { kind: NodeKind.Block, stmts: stmts, line: peek_line(), col: peek_col() })
            else_b = blk
        } else {
            else_b = parse_block()
        }
    }
    let nd = node_count()
    node_push(AstNode {
        kind: NodeKind.IfExpr,
        condition: cond, then_body: then_b, else_body: else_b,
        line: if_start_line, col: if_start_col,
    })
    nd
}

fn parse_while_loop() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    let while_start_line = peek_line()
    let while_start_col = peek_col()
    expect(TokenKind.While)
    skip_newlines_and_comments()
    let cond = parse_expr()
    skip_newlines_and_comments()
    let body = parse_block()
    let nd = node_count()
    node_push(AstNode {
        kind: NodeKind.WhileLoop, condition: cond, body: body,
        line: while_start_line, col: while_start_col,
    })
    nd
}

fn parse_loop_expr() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    let loop_start_line = peek_line()
    let loop_start_col = peek_col()
    expect(TokenKind.Loop)
    skip_newlines_and_comments()
    let body = parse_block()
    let nd = node_count()
    node_push(AstNode {
        kind: NodeKind.LoopExpr, body: body,
        line: loop_start_line, col: loop_start_col,
    })
    nd
}

fn parse_for_in() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    let for_start_line = peek_line()
    let for_start_col = peek_col()
    expect(TokenKind.For)
    let mut var = ""
    let mut pat = -1
    // The simple `for x in xs` binder gets its own IdentPattern node hung off `for_binder`
    // (NOT `elements` — codegen reads `elements != -1` as "destructure a tuple"), so typecheck
    // has a node to stamp the element tid onto. `var_name` still carries the raw name, so
    // codegen's scalar path is untouched.
    let mut simple_binder = -1
    let var_line = peek_line()
    let var_col = peek_col()
    let var_mut = parse_binder_mut()
    if at(TokenKind.LParen) || (at(TokenKind.Mut) && peek_kind_at(pos + 1) == TokenKind.LParen) {
        pat = parse_pattern()
        var = "_tuple"
    } else {
        let mut_tok = if at(TokenKind.Mut) { advance() } else { -1 }
        let first = pos
        var = expect_value(TokenKind.Ident)
        simple_binder = node_count()
        node_push(AstNode { kind: NodeKind.IdentPattern, name: var, is_mut: var_mut, line: var_line, col: var_col, end_line: tokens.lines.get(pos - 1).unwrap(), end_col: tokens.end_cols.get(pos - 1).unwrap() })
        if mut_tok != -1 { report_mut_on_pattern(mut_tok, first, pos - 1, simple_binder) }
    }
    expect(TokenKind.In)
    let iter = parse_expr()
    skip_newlines_and_comments()
    let body = parse_block()
    let mut for_elems = -1
    if pat != -1 {
        for_elems = pat
    }
    let nd = node_count()
    node_push(AstNode {
        kind: NodeKind.ForIn, var_name: var, iterable: iter, body: body,
        elements: for_elems, for_binder: simple_binder,
        line: for_start_line, col: for_start_col,
    })
    nd
}

// ── Expressions (precedence climbing) ───────────────────────────────

fn parse_expr() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    parse_nullcoalesce()
}

fn parse_nullcoalesce() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    let mut left = parse_or()
    while at(TokenKind.DoubleQuestion) {
        let op_line = peek_line()
        let op_col = peek_col()
        advance()
        skip_newlines()
        let right = parse_or()
        let nd = node_count()
        node_push(AstNode { kind: NodeKind.BinOp, op: "??", left: left, right: right, line: op_line, col: op_col })
        left = nd
    }
    left
}

fn parse_or() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    let mut left = parse_and()
    while at(TokenKind.Or) {
        let op_line = peek_line()
        let op_col = peek_col()
        advance()
        skip_newlines()
        let right = parse_and()
        let nd = node_count()
        node_push(AstNode { kind: NodeKind.BinOp, op: "||", left: left, right: right, line: op_line, col: op_col })
        left = nd
    }
    left
}

fn parse_and() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    let mut left = parse_equality()
    while at(TokenKind.And) {
        let op_line = peek_line()
        let op_col = peek_col()
        advance()
        skip_newlines()
        let right = parse_equality()
        let nd = node_count()
        node_push(AstNode { kind: NodeKind.BinOp, op: "&&", left: left, right: right, line: op_line, col: op_col })
        left = nd
    }
    left
}

fn parse_equality() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    let mut left = parse_comparison()
    while at(TokenKind.EqEq) || at(TokenKind.NotEq) {
        let op_line = peek_line()
        let op_col = peek_col()
        let op = advance_value()
        skip_newlines()
        let right = parse_comparison()
        let nd = node_count()
        node_push(AstNode { kind: NodeKind.BinOp, op: op, left: left, right: right, line: op_line, col: op_col })
        left = nd
    }
    left
}

fn parse_comparison() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    let mut left = parse_int_ops()
    while at(TokenKind.Less) || at(TokenKind.Greater) || at(TokenKind.LessEq) || at(TokenKind.GreaterEq) {
        let op_line = peek_line()
        let op_col = peek_col()
        let op = advance_value()
        skip_newlines()
        let right = parse_int_ops()
        let nd = node_count()
        node_push(AstNode { kind: NodeKind.BinOp, op: op, left: left, right: right, line: op_line, col: op_col })
        left = nd
    }
    left
}

// ── Integer operator groups (§2.19 level 7) ─────────────────────────
// Arithmetic, shift, `&`, `^` and `|` have no order among them, so a level-7 expression is read
// as a flat run of unary operands and operators and grouped once the whole run is known. A
// parenthesized operand comes back from parse_unary whole, so only a bare operator of a second
// group is a mix.

const OPS_ARITH = 1
const OPS_SHIFT = 2
const OPS_AND = 3
const OPS_XOR = 4
const OPS_OR = 5

pub fn int_op_group(op: Str) -> Int {
    if op == "*" || op == "/" || op == "%" || op == "+" || op == "-" { return OPS_ARITH }
    if op == "<<" || op == ">>" { return OPS_SHIFT }
    if op == "&" { return OPS_AND }
    if op == "^" { return OPS_XOR }
    if op == "|" { return OPS_OR }
    0
}

// Whether printing `child_op` bare as an operand of `parent_op` loses or hides its grouping, for
// the printers that rebuild source from the tree. A different integer group does not parse bare. A
// shift or bitwise operand of a comparison does, but C binds it the other way, so a reader from C
// would misread it.
pub fn int_operand_needs_parens(child_op: Str, parent_op: Str) -> Bool {
    let child = int_op_group(child_op)
    if child == 0 { return false }
    let parent = int_op_group(parent_op)
    if parent != 0 { return parent != child }
    if child == OPS_ARITH { return false }
    parent_op == "==" || parent_op == "!=" || parent_op == "<" || parent_op == ">" || parent_op == "<=" || parent_op == ">="
}

fn at_int_op() -> Bool {
    let k = peek_kind()
    k == TokenKind.Star || k == TokenKind.Slash || k == TokenKind.Percent || k == TokenKind.Plus || k == TokenKind.Minus || k == TokenKind.Shl || k == TokenKind.Shr || k == TokenKind.Amp || k == TokenKind.Caret || k == TokenKind.Pipe
}

// How tightly an operator binds when a run is grouped the way C groups it, or, with
// `reversed`, the opposite way between groups. `*` `/` `%` stay above `+` `-` either way,
// because the language itself orders them.
fn int_op_rank(op: Str, reversed: Bool) -> Int {
    let g = int_op_group(op)
    let mul = op == "*" || op == "/" || op == "%"
    if reversed {
        if g == OPS_ARITH {
            if mul { return 2 }
            return 1
        }
        return g + 1
    }
    if g == OPS_ARITH {
        if mul { return 6 }
        return 5
    }
    6 - g
}

// The operator that operands lo..hi split at: the loosest one, and the last of those because
// each group chains left.
fn int_ops_split(ops: List[Str], lo: Int, hi: Int, reversed: Bool) -> Int {
    let mut k = lo
    let mut i = lo + 1
    while i < hi {
        if int_op_rank(ops.get(i).unwrap(), reversed) <= int_op_rank(ops.get(k).unwrap(), reversed) {
            k = i
        }
        i = i + 1
    }
    k
}

fn int_ops_tree(operands: List[Int], ops: List[Str], op_toks: List[Int], lo: Int, hi: Int) -> Int ! Parse.Build {
    if lo == hi { return operands.get(lo).unwrap() }
    let k = int_ops_split(ops, lo, hi, false)
    let left = int_ops_tree(operands, ops, op_toks, lo, k)
    let right = int_ops_tree(operands, ops, op_toks, k + 1, hi)
    let tok = op_toks.get(k).unwrap()
    let nd = node_count()
    node_push(AstNode { kind: NodeKind.BinOp, op: ops.get(k).unwrap(), left: left, right: right, line: tokens.lines.get(tok).unwrap(), col: tokens.cols.get(tok).unwrap() })
    nd
}

// The run written with parentheses wherever an operand is an operation of another group.
fn int_ops_text(texts: List[Str], ops: List[Str], lo: Int, hi: Int, reversed: Bool, parent_group: Int) -> Str {
    if lo == hi { return texts.get(lo).unwrap() }
    let k = int_ops_split(ops, lo, hi, reversed)
    let g = int_op_group(ops.get(k).unwrap())
    let left = int_ops_text(texts, ops, lo, k, reversed, g)
    let right = int_ops_text(texts, ops, k + 1, hi, reversed, g)
    let text = "{left} {ops.get(k).unwrap()} {right}"
    if parent_group != 0 && parent_group != g {
        return "({text})"
    }
    text
}

// The byte offset of a token position, or -1 when the source does not reach it.
fn source_offset(line: Int, col: Int) -> Int {
    let mut off = 0
    let mut l = 1
    while l < line && off < tokens.source.byte_len() {
        if tokens.source.byte_at(off) == 10 {
            l = l + 1
        }
        off = off + 1
    }
    if l < line { return -1 }
    let at_col = off + col - 1
    if at_col > tokens.source.byte_len() { return -1 }
    at_col
}

// The source text of tokens first..last as written, or "" when it cannot be read back.
fn token_span_text(first: Int, last: Int) -> Str {
    if first < 0 || last < first || last >= tokens.kinds.len() { return "" }
    let start = source_offset(tokens.lines.get(first).unwrap(), tokens.cols.get(first).unwrap())
    let end = source_offset(tokens.lines.get(last).unwrap(), tokens.end_cols.get(last).unwrap())
    if start < 0 || end <= start { return "" }
    tokens.source.byte_slice(start, end)
}

// An operand as one line of text for the help. One written over several lines is rebuilt from
// its tokens, so a line break becomes a space and a comment drops out, while each line keeps
// its own spacing. A token that itself spans lines cannot be put on one line, so the operand
// reads as "".
fn operand_text(first: Int, last: Int) -> Str {
    if first < 0 || last < first || last >= tokens.kinds.len() { return "" }
    if tokens.lines.get(first).unwrap() == tokens.lines.get(last).unwrap() {
        let t = token_span_text(first, last)
        if t.contains("\n") { return "" }
        return t
    }
    let mut out = ""
    let mut prev = -1
    let mut t = first
    while t <= last {
        let k = peek_kind_at(t)
        if k != TokenKind.Newline && k != TokenKind.Comment && k != TokenKind.DocComment {
            let piece = token_span_text(t, t)
            if piece == "" || piece.contains("\n") { return "" }
            if prev == -1 {
                out = piece
            } else if tokens.lines.get(prev).unwrap() == tokens.lines.get(t).unwrap() {
                let span = token_span_text(prev, t)
                out = out.concat(span.byte_slice(token_span_text(prev, prev).byte_len(), span.byte_len()))
            } else if out.ends_with("(") || out.ends_with("[") || piece.starts_with(")") || piece.starts_with("]") || piece.starts_with(".") || piece.starts_with(",") {
                out = out.concat(piece)
            } else {
                out = out.concat(" ").concat(piece)
            }
            prev = t
        }
        t = t + 1
    }
    out
}

// The last token of an operand that ends before p: a lookahead past the operand may have
// stopped on a newline or a comment.
fn last_token_before(p: Int) -> Int {
    let mut q = p - 1
    while q > 0 && (peek_kind_at(q) == TokenKind.Newline || peek_kind_at(q) == TokenKind.Comment || peek_kind_at(q) == TokenKind.DocComment) {
        q = q - 1
    }
    q
}

fn report_mixed_operators(ops: List[Str], op_toks: List[Int], firsts: List[Int], lasts: List[Int], mix: Int) ! Diag.Report {
    let tok = op_toks.get(mix).unwrap()
    // Name first the operator C applies last, the outer one of the C grouping.
    let mut outer = ops.get(mix - 1).unwrap()
    let mut inner = ops.get(mix).unwrap()
    if int_op_rank(inner, false) < int_op_rank(outer, false) {
        outer = ops.get(mix).unwrap()
        inner = ops.get(mix - 1).unwrap()
    }
    let msg = "`{outer}` and `{inner}` have no order between them"
    let mut texts: List[Str] = []
    let mut readable = true
    let mut i = 0
    while i < firsts.len() {
        let t = operand_text(firsts.get(i).unwrap(), lasts.get(i).unwrap())
        if t == "" { readable = false }
        texts.push(t)
        i = i + 1
    }
    let mut help = "add parentheses around the operation that applies first"
    if readable {
        let c_order = int_ops_text(texts, ops, 0, ops.len(), false, 0)
        let other = int_ops_text(texts, ops, 0, ops.len(), true, 0)
        help = "write `{c_order}` (the grouping C uses) or `{other}`"
    }
    diag_error_range("MixedOperatorPrecedence", MIXED_OPERATOR_PRECEDENCE, msg, tokens.lines.get(tok).unwrap(), tokens.cols.get(tok).unwrap(), tokens.end_cols.get(tok).unwrap(), help)
}

fn parse_int_ops() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    let first_tok = pos
    let first = parse_unary()
    if !at_int_op() { return first }
    let mut operands: List[Int] = [first]
    let mut firsts: List[Int] = [first_tok]
    let mut lasts: List[Int] = [last_token_before(pos)]
    let mut ops: List[Str] = []
    let mut op_toks: List[Int] = []
    while at_int_op() {
        op_toks.push(pos)
        ops.push(advance_value())
        skip_newlines()
        firsts.push(pos)
        operands.push(parse_unary())
        lasts.push(last_token_before(pos))
    }
    let group = int_op_group(ops.get(0).unwrap())
    let mut mix = 1
    while mix < ops.len() && int_op_group(ops.get(mix).unwrap()) == group {
        mix = mix + 1
    }
    // One report per run; the tree is still built the C way so later passes see a whole node.
    if mix < ops.len() {
        report_mixed_operators(ops, op_toks, firsts, lasts, mix)
    }
    int_ops_tree(operands, ops, op_toks, 0, ops.len())
}

fn parse_unary() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    if at(TokenKind.Minus) {
        let op_line = peek_line()
        let op_col = peek_col()
        advance()
        let operand = parse_unary()
        let nd = node_count()
        node_push(AstNode { kind: NodeKind.UnaryOp, op: "-", left: operand, line: op_line, col: op_col })
        return nd
    }
    if at(TokenKind.Bang) {
        let op_line = peek_line()
        let op_col = peek_col()
        advance()
        let operand = parse_unary()
        let nd = node_count()
        node_push(AstNode { kind: NodeKind.UnaryOp, op: "!", left: operand, line: op_line, col: op_col })
        return nd
    }
    if at(TokenKind.Tilde) {
        let op_line = peek_line()
        let op_col = peek_col()
        advance()
        let operand = parse_unary()
        let nd = node_count()
        node_push(AstNode { kind: NodeKind.UnaryOp, op: "~", left: operand, line: op_line, col: op_col })
        return nd
    }
    parse_postfix()
}

// ── Postfix: calls, field access, index, method calls ───────────────

@allow(UnrestoredMutation, IncompleteStateRestore)
fn parse_postfix() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    let mut node = parse_primary()
    let mut running = 1
    while running {
        if at(TokenKind.Dot) {
            advance()
            let mut member = ""
            if at(TokenKind.Int) {
                member = peek_value()
                advance()
            } else {
                member = expect_value(TokenKind.Ident)
            }
            // async.scope { body }
            if member == "scope" && node_kind(node) == NodeKind.Ident && node_name(node) == "async" && at(TokenKind.LBrace) {
                let body = parse_block()
                let nd = node_count()
                node_push(AstNode { kind: NodeKind.AsyncScope, body: body, line: node_line(node), col: node_col(node) })
                node = nd
            // .await — postfix await on handles
            } else if member == "await" {
                let nd = node_count()
                node_push(AstNode { kind: NodeKind.AwaitExpr, obj: node, line: node_line(node), col: node_col(node) })
                node = nd
            // channel.new[T](buffer) — typed channel constructor
            } else if member == "new" && node_kind(node) == NodeKind.Ident && node_name(node) == "channel" && at(TokenKind.LBracket) {
                advance()
                skip_newlines()
                let mut tparams = -1
                if is_type_start(peek_kind()) {
                    tparams = parse_type_arg_list()
                } else {
                    diag_error_range("UnexpectedToken", UNEXPECTED_TOKEN, "expected the channel's element type, got {token_kind_name(peek_kind())}", peek_line(), peek_col(), peek_end_col(), "write the element type: channel.new[Int](buffer: 8)")
                    skip_to_close_bracket()
                    expect(TokenKind.RBracket)
                }
                expect(TokenKind.LParen)
                skip_newlines()
                let cn_args = new_sublist()
                if !at(TokenKind.RParen) {
                    sublist_push(cn_args, parse_maybe_named_arg())
                    while at(TokenKind.Comma) {
                        advance()
                        skip_newlines()
                        sublist_push(cn_args, parse_maybe_named_arg())
                    }
                }
                skip_newlines()
                expect(TokenKind.RParen)
                finalize_sublist(cn_args)
                let nd = node_count()
                node_push(AstNode { kind: NodeKind.ChannelNew, type_params: tparams, args: cn_args, line: node_line(node), col: node_col(node) })
                node = nd
            } else if at(TokenKind.LParen) {
                let args = parse_call_args()
                let nd = node_count()
                node_push(AstNode { kind: NodeKind.MethodCall, obj: node, method: member, args: args, line: node_line(node), col: node_col(node) })
                node = nd
            } else if at(TokenKind.LBracket) && brackets_then_call() && is_type_start(peek_kind_at(first_token_in_brackets())) {
                advance()
                skip_newlines()
                let targs = parse_type_arg_list()
                let args = parse_call_args()
                let nd = node_count()
                node_push(AstNode { kind: NodeKind.MethodCall, obj: node, method: member, args: args, type_params: targs, line: node_line(node), col: node_col(node) })
                node = nd
            } else {
                let nd = node_count()
                node_push(AstNode { kind: NodeKind.FieldAccess, obj: node, name: member, line: node_line(node), col: node_col(node) })
                node = nd
                // Check for struct literal after field access (e.g. Foo.Bar { ... })
                if at(TokenKind.LBrace) {
                    if looks_like_struct_lit() {
                        // Reconstruct dotted name
                        let dotted = flatten_field_access(node)
                        if dotted.is_some() {
                            node = parse_struct_lit(dotted.unwrap())
                        }
                    }
                }
            }
        } else if at(TokenKind.LParen) {
            let args = parse_call_args()
            let nd = node_count()
            node_push(AstNode { kind: NodeKind.Call, left: node, args: args, line: node_line(node), col: node_col(node) })
            node = nd
        } else if at(TokenKind.LBracket) {
            node = parse_bracket_suffix(node)
        } else if at(TokenKind.Question) {
            advance()
            let nd = node_count()
            node_push(AstNode { kind: NodeKind.UnaryOp, op: "?", left: node, line: node_line(node), col: node_col(node) })
            node = nd
        } else if at(TokenKind.Newline) || at(TokenKind.Comment) {
            let mut peek_pos = pos
            while peek_pos < tokens.kinds.len() && (peek_kind_at(peek_pos) == TokenKind.Newline || peek_kind_at(peek_pos) == TokenKind.Comment || peek_kind_at(peek_pos) == TokenKind.DocComment) {
                peek_pos = peek_pos + 1
            }
            if peek_pos < tokens.kinds.len() && peek_kind_at(peek_pos) == TokenKind.Dot {
                skip_newlines()
            } else {
                running = 0
            }
        } else {
            running = 0
        }
    }
    node
}

// A parenthesized argument list, from `(` through `)`.
fn parse_call_args() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    expect(TokenKind.LParen)
    let args = new_sublist()
    if !at(TokenKind.RParen) {
        skip_newlines()
        sublist_push(args, parse_maybe_named_arg())
        while at(TokenKind.Comma) {
            advance()
            skip_newlines()
            if at(TokenKind.RParen) {
                break
            }
            sublist_push(args, parse_maybe_named_arg())
        }
        skip_newlines()
    }
    expect(TokenKind.RParen)
    finalize_sublist(args)
    args
}

// Brackets after an expression are a type-argument list when a call follows the closing
// bracket (03_types.md:1297); only a bracket with no call is an index read. The scan from
// the `[` at pos to its match is what tells the two apart before either is parsed.
fn brackets_then_call() -> Bool {
    let mut p = pos
    let mut depth = 0
    while p < tokens.kinds.len() {
        let k = peek_kind_at(p)
        if k == TokenKind.LBracket {
            depth = depth + 1
        } else if k == TokenKind.RBracket {
            depth = depth - 1
            if depth == 0 { return peek_kind_at(p + 1) == TokenKind.LParen }
        }
        p = p + 1
    }
    false
}

// The first token inside the `[` at pos, past any line breaks.
fn first_token_in_brackets() -> Int {
    let mut p = pos + 1
    while peek_kind_at(p) == TokenKind.Newline { p = p + 1 }
    p
}

// The tokens parse_type_annotation can start with.
fn is_type_start(k: TokenKind) -> Bool {
    k == TokenKind.Ident || k == TokenKind.LBracket || k == TokenKind.LParen || k == TokenKind.Fn || k == TokenKind.Handler
}

// A value where a type argument belongs: whoever wrote it meant to index, so the report names
// element access.
fn report_value_in_type_args() ! Diag.Report {
    diag_error_range("UnexpectedToken", UNEXPECTED_TOKEN, "expected a type argument, got {token_kind_name(peek_kind())}", peek_line(), peek_col(), peek_end_col(), ELEMENT_ACCESS_HELP)
}

// Past the rest of a reported type-argument list, up to its closing bracket.
fn skip_to_close_bracket() ! Parse.Advance {
    let mut depth = 1
    while pos < tokens.kinds.len() {
        if at(TokenKind.LBracket) { depth = depth + 1 }
        if at(TokenKind.RBracket) {
            depth = depth - 1
            if depth == 0 { return }
        }
        advance()
    }
}

// The types between `[` and `]` of a call's type-argument list, with pos just past the `[`.
fn parse_type_arg_list() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    let sl = new_sublist()
    sublist_push(sl, parse_type_annotation())
    skip_newlines()
    while at(TokenKind.Comma) {
        advance()
        skip_newlines()
        if !is_type_start(peek_kind()) { break }
        sublist_push(sl, parse_type_annotation())
        skip_newlines()
    }
    if !at(TokenKind.RBracket) {
        report_value_in_type_args()
        skip_to_close_bracket()
    }
    expect(TokenKind.RBracket)
    finalize_sublist(sl)
    sl
}

// `[` after an expression: a call's type arguments when a call follows, else an index read.
// A value opening a list that a call follows is reported and then read as the index it was
// meant to be, so the checker adds nothing to the one report.
fn parse_bracket_suffix(obj: Int) -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    let then_call = brackets_then_call()
    advance()
    skip_newlines()
    if then_call && is_type_start(peek_kind()) {
        let targs = parse_type_arg_list()
        let args = parse_call_args()
        let nd = node_count()
        node_push(AstNode { kind: NodeKind.Call, left: obj, args: args, type_params: targs, line: node_line(obj), col: node_col(obj) })
        return nd
    }
    if then_call { report_value_in_type_args() }
    let idx = parse_expr()
    skip_newlines()
    expect(TokenKind.RBracket)
    let nd = node_count()
    node_push(AstNode { kind: NodeKind.IndexExpr, obj: obj, index: idx, line: node_line(obj), col: node_col(obj) })
    nd
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn skip_named_arg_label() ! Parse.Advance {
    if at(TokenKind.Ident) {
        let saved = pos
        advance()
        if at(TokenKind.Colon) {
            advance()
            skip_newlines()
        } else {
            pos = saved
        }
    }
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn parse_maybe_named_arg() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    if at(TokenKind.Ident) {
        let saved = pos
        let na_line = peek_line()
        let na_col = peek_col()
        let label = peek_value()
        advance()
        if at(TokenKind.Colon) {
            advance()
            skip_newlines()
            let inner = parse_expr()
            let nd = node_count()
            node_push(AstNode { kind: NodeKind.NamedArg, name: label, value: inner, line: na_line, col: na_col })
            return nd
        } else {
            pos = saved
        }
    }
    parse_expr()
}

fn flatten_field_access(node: Int) -> Option[Str] {
    let kind = node_kind(node)
    if kind == NodeKind.Ident {
        return Some(node_name(node))
    }
    if kind == NodeKind.FieldAccess {
        let base = flatten_field_access(node_obj(node))
        if base.is_some() {
            return Some(base.unwrap().concat(".").concat(node_name(node)))
        }
    }
    None
}

fn looks_like_struct_lit() -> Int {
    // Side-effect-free lookahead: peek past { and whitespace/comments
    // to check for "ident :" pattern without collecting comments
    let mut peek_pos = pos
    if peek_pos >= tokens.kinds.len() || peek_kind_at(peek_pos) != TokenKind.LBrace {
        return 0
    }
    peek_pos = peek_pos + 1
    while peek_pos < tokens.kinds.len() && (peek_kind_at(peek_pos) == TokenKind.Newline || peek_kind_at(peek_pos) == TokenKind.Comment || peek_kind_at(peek_pos) == TokenKind.DocComment) {
        peek_pos = peek_pos + 1
    }
    if peek_pos >= tokens.kinds.len() {
        return 0
    }
    if peek_kind_at(peek_pos) == TokenKind.RBrace {
        return 1
    }
    if peek_kind_at(peek_pos) == TokenKind.DotDot {
        return 1
    }
    if peek_kind_at(peek_pos) != TokenKind.Ident {
        return 0
    }
    peek_pos = peek_pos + 1
    if peek_pos < tokens.kinds.len() && peek_kind_at(peek_pos) == TokenKind.Colon {
        return 1
    }
    0
}

// ── Primary expressions ─────────────────────────────────────────────

fn parse_primary() -> Int ! Diag.Report, Parse.Advance, Parse.Build {
    let pm_line = peek_line()
    let pm_col = peek_col()
    if at(TokenKind.Match) {
        let next_pos = pos + 1
        let next_ok = next_pos < tokens.kinds.len() && peek_kind_at(next_pos) != TokenKind.RParen && peek_kind_at(next_pos) != TokenKind.RBrace && peek_kind_at(next_pos) != TokenKind.Comma && peek_kind_at(next_pos) != TokenKind.Dot && peek_kind_at(next_pos) != TokenKind.Newline && peek_kind_at(next_pos) != TokenKind.EOF && peek_kind_at(next_pos) != TokenKind.Equals && peek_kind_at(next_pos) != TokenKind.EqEq && peek_kind_at(next_pos) != TokenKind.RBracket && peek_kind_at(next_pos) != TokenKind.StringEnd && peek_kind_at(next_pos) != TokenKind.InterpEnd
        if next_ok {
            return parse_match_expr()
        }
        diag_error_range("KeywordAsIdentifier", KEYWORD_AS_IDENTIFIER, "`match` is a keyword and cannot be used as an identifier", peek_line(), peek_col(), peek_end_col(), "use a different name")
        advance()
        let nd = node_count()
        node_push(AstNode { kind: NodeKind.Ident, name: "match", line: pm_line, col: pm_col })
        return nd
    }
    if at(TokenKind.If) {
        let next_pos = pos + 1
        let next_ok = next_pos < tokens.kinds.len() && peek_kind_at(next_pos) != TokenKind.RParen && peek_kind_at(next_pos) != TokenKind.RBrace && peek_kind_at(next_pos) != TokenKind.Comma && peek_kind_at(next_pos) != TokenKind.Dot && peek_kind_at(next_pos) != TokenKind.Newline && peek_kind_at(next_pos) != TokenKind.EOF && peek_kind_at(next_pos) != TokenKind.Equals && peek_kind_at(next_pos) != TokenKind.EqEq && peek_kind_at(next_pos) != TokenKind.RBracket && peek_kind_at(next_pos) != TokenKind.StringEnd && peek_kind_at(next_pos) != TokenKind.InterpEnd
        if next_ok {
            return parse_if_expr()
        }
        diag_error_range("KeywordAsIdentifier", KEYWORD_AS_IDENTIFIER, "`if` is a keyword and cannot be used as an identifier", peek_line(), peek_col(), peek_end_col(), "use a different name")
        advance()
        let nd = node_count()
        node_push(AstNode { kind: NodeKind.Ident, name: "if", line: pm_line, col: pm_col })
        return nd
    }
    if at(TokenKind.Self) {
        advance()
        let nd = node_count()
        node_push(AstNode { kind: NodeKind.Ident, name: "self", line: pm_line, col: pm_col })
        return nd
    }

    if at(TokenKind.Fn) {
        let next_pos = pos + 1
        if next_pos < tokens.kinds.len() && peek_kind_at(next_pos) == TokenKind.LParen {
            return parse_closure()
        }
        diag_error_range("KeywordAsIdentifier", KEYWORD_AS_IDENTIFIER, "`fn` is a keyword and cannot be used as an identifier", peek_line(), peek_col(), peek_end_col(), "use a different name")
        advance()
        let nd = node_count()
        node_push(AstNode { kind: NodeKind.Ident, name: "fn", line: pm_line, col: pm_col })
        return nd
    }

    if at(TokenKind.Handler) {
        // Check if this is a handler expression (handler EffectName { ... })
        // vs a keyword used as a variable name (e.g. fn foo(handler: Int) { handler })
        let next_pos = pos + 1
        if next_pos < tokens.kinds.len() && peek_kind_at(next_pos) == TokenKind.Ident {
            return parse_handler_expr()
        }
        // Keyword used as identifier — emit error and treat as ident
        diag_error_range("KeywordAsIdentifier", KEYWORD_AS_IDENTIFIER, "`handler` is a keyword and cannot be used as an identifier", peek_line(), peek_col(), peek_end_col(), "use a different name")
        advance()
        let nd = node_count()
        node_push(AstNode { kind: NodeKind.Ident, name: "handler", line: pm_line, col: pm_col })
        return nd
    }

    if at(TokenKind.With) {
        let next_pos = pos + 1
        let next_ok = next_pos < tokens.kinds.len() && peek_kind_at(next_pos) != TokenKind.RParen && peek_kind_at(next_pos) != TokenKind.RBrace && peek_kind_at(next_pos) != TokenKind.Comma && peek_kind_at(next_pos) != TokenKind.Dot && peek_kind_at(next_pos) != TokenKind.Newline && peek_kind_at(next_pos) != TokenKind.EOF && peek_kind_at(next_pos) != TokenKind.Equals && peek_kind_at(next_pos) != TokenKind.EqEq && peek_kind_at(next_pos) != TokenKind.RBracket && peek_kind_at(next_pos) != TokenKind.StringEnd && peek_kind_at(next_pos) != TokenKind.InterpEnd
        if next_ok {
            return parse_with_block()
        }
        diag_error_range("KeywordAsIdentifier", KEYWORD_AS_IDENTIFIER, "`with` is a keyword and cannot be used as an identifier", peek_line(), peek_col(), peek_end_col(), "use a different name")
        advance()
        let nd = node_count()
        node_push(AstNode { kind: NodeKind.Ident, name: "with", line: pm_line, col: pm_col })
        return nd
    }

    if at(TokenKind.Ident) {
        let name = advance_value()
        if name == "true" {
            let nd = node_count()
            node_push(AstNode { kind: NodeKind.BoolLit, int_val: 1, line: pm_line, col: pm_col })
            return nd
        }
        if name == "false" {
            let nd = node_count()
            node_push(AstNode { kind: NodeKind.BoolLit, int_val: 0, line: pm_line, col: pm_col })
            return nd
        }
        if at(TokenKind.LBrace) && looks_like_struct_lit() {
            return parse_struct_lit(name)
        }
        let nd = node_count()
        node_push(AstNode { kind: NodeKind.Ident, name: name, line: pm_line, col: pm_col })
        return nd
    }

    if at(TokenKind.Int) {
        let val_str = advance_value()
        let nd = node_count()
        node_push(AstNode { kind: NodeKind.IntLit, str_val: val_str, line: pm_line, col: pm_col })
        // Check for range
        if at(TokenKind.DotDot) {
            advance()
            let end_nd = parse_primary()
            let rng = node_count()
            node_push(AstNode { kind: NodeKind.RangeLit, start: nd, end: end_nd, line: pm_line, col: pm_col })
            return rng
        }
        if at(TokenKind.DotDoteq) {
            advance()
            let end_nd = parse_primary()
            let rng = node_count()
            node_push(AstNode { kind: NodeKind.RangeLit, start: nd, end: end_nd, inclusive: 1, line: pm_line, col: pm_col })
            return rng
        }
        return nd
    }

    if at(TokenKind.Float) {
        let val_str = advance_value()
        let nd = node_count()
        node_push(AstNode { kind: NodeKind.FloatLit, str_val: val_str, line: pm_line, col: pm_col })
        return nd
    }

    if at(TokenKind.CharLit) {
        let val_str = advance_value()
        let nd = node_count()
        node_push(AstNode { kind: NodeKind.CharLit, str_val: val_str, line: pm_line, col: pm_col })
        return nd
    }

    if at(TokenKind.LParen) {
        advance()
        skip_newlines()
        if at(TokenKind.RParen) {
            advance()
            // Unit / empty tuple — empty TupleLit infers as Void; codegen emits 0.
            let nd = node_count()
            node_push(AstNode { kind: NodeKind.TupleLit, line: pm_line, col: pm_col })
            return nd
        }
        let first = parse_expr()
        if at(TokenKind.Comma) {
            let elems = new_sublist()
            sublist_push(elems, first)
            while at(TokenKind.Comma) {
                advance()
                skip_newlines()
                if at(TokenKind.RParen) {
                    break
                }
                sublist_push(elems, parse_expr())
            }
            expect(TokenKind.RParen)
            finalize_sublist(elems)
            let nd = node_count()
            node_push(AstNode { kind: NodeKind.TupleLit, elements: elems, line: pm_line, col: pm_col })
            return nd
        }
        skip_newlines()
        expect(TokenKind.RParen)
        return first
    }

    if at(TokenKind.Hash) {
        return parse_embed_expr()
    }

    if at(TokenKind.LBracket) {
        return parse_list_lit()
    }

    if at(TokenKind.StringStart) {
        return parse_interp_string()
    }

    if at(TokenKind.LBrace) {
        if tokens.kinds.get(pos + 1).unwrap() == TokenKind.RBrace {
            diag_error_range("EmptyBraceExpr", EMPTY_BRACE_EXPR, "empty `\{\}` is not a valid expression — use Map() for empty maps", peek_line(), peek_col(), peek_end_col(), "replace `\{\}` with `Map()`")
            advance()
            advance()
            return new_node(NodeKind.IntLit)
        }
        return parse_block()
    }

    if is_keyword(peek_kind()) {
        let kw_name = peek_value()
        diag_error_range("KeywordAsIdentifier", KEYWORD_AS_IDENTIFIER, "`{kw_name}` is a keyword and cannot be used as an identifier", peek_line(), peek_col(), peek_end_col(), "use a different name")
        advance()
        let nd = node_count()
        node_push(AstNode { kind: NodeKind.Ident, name: kw_name, line: pm_line, col: pm_col })
        return nd
    }

    diag_error_range("UnexpectedToken", UNEXPECTED_TOKEN, "unexpected token {token_kind_name(peek_kind())}", peek_line(), peek_col(), peek_end_col(), "")
    // String-structural tokens (InterpEnd/StringEnd/StringPart) only appear
    // inside interpolated-string lexing and are consumed solely by
    // parse_interp_string. Reaching parse_primary on one means a malformed
    // interpolation: do NOT advance, or we eat the closing `}` and the
    // interp recovery loop skips the next broken interp.
    if at(TokenKind.InterpEnd) || at(TokenKind.StringEnd) || at(TokenKind.StringPart) {
        return new_node(NodeKind.IntLit)
    }
    advance()
    new_node(NodeKind.IntLit)
}

fn parse_struct_lit(type_name: Str) -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    let sl_line = peek_line()
    let sl_col = peek_col()
    expect(TokenKind.LBrace)
    skip_newlines_and_comments()
    let flds = new_sublist()
    while !at(TokenKind.RBrace) && !at(TokenKind.EOF) {
        if at(TokenKind.DotDot) {
            let sp_line = peek_line()
            let sp_col = peek_col()
            advance()
            let spread_src = parse_expr()
            let sp = node_count()
            node_push(AstNode { kind: NodeKind.SpreadExpr, value: spread_src, line: sp_line, col: sp_col })
            sublist_push(flds, sp)
            if at(TokenKind.Comma) {
                advance()
            }
            skip_newlines_and_comments()
            break
        }
        let fld_line = peek_line()
        let fld_col = peek_col()
        let fname = expect_value(TokenKind.Ident)
        expect(TokenKind.Colon)
        skip_newlines()
        let fval = parse_expr()
        let sf = node_count()
        node_push(AstNode { kind: NodeKind.StructLitField, name: fname, value: fval, line: fld_line, col: fld_col })
        sublist_push(flds, sf)
        if at(TokenKind.Comma) {
            advance()
        }
        skip_newlines_and_comments()
    }
    expect(TokenKind.RBrace)
    finalize_sublist(flds)
    let nd = node_count()
    node_push(AstNode { kind: NodeKind.StructLit, type_name: type_name, fields: flds, line: sl_line, col: sl_col })
    nd
}

fn parse_list_lit() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    let ll_line = peek_line()
    let ll_col = peek_col()
    expect(TokenKind.LBracket)
    skip_newlines_and_comments()
    let elems = new_sublist()
    while !at(TokenKind.RBracket) && !at(TokenKind.EOF) {
        if at(TokenKind.DotDot) {
            let sp_line = peek_line()
            let sp_col = peek_col()
            advance()
            let spread_src = parse_expr()
            let sp = node_count()
            node_push(AstNode { kind: NodeKind.SpreadExpr, value: spread_src, line: sp_line, col: sp_col })
            sublist_push(elems, sp)
        } else {
            sublist_push(elems, parse_expr())
        }
        if at(TokenKind.Comma) {
            advance()
        }
        skip_newlines_and_comments()
    }
    expect(TokenKind.RBracket)
    finalize_sublist(elems)
    let nd = node_count()
    node_push(AstNode { kind: NodeKind.ListLit, elements: elems, line: ll_line, col: ll_col })
    nd
}

fn parse_interp_string() -> Int ! Diag.Report, Parse.Advance, Parse.Build {
    let is_line = peek_line()
    let is_col = peek_col()
    expect(TokenKind.StringStart)
    let parts = new_sublist()
    while !at(TokenKind.StringEnd) && !at(TokenKind.EOF) {
        if at(TokenKind.StringPart) {
            let sp_line = peek_line()
            let sp_col = peek_col()
            let s = advance_value()
            let sn = node_count()
            node_push(AstNode { kind: NodeKind.Ident, str_val: s, name: s, line: sp_line, col: sp_col })
            sublist_push(parts, sn)
        } else if at(TokenKind.InterpStart) {
            let br_line = peek_line()
            let br_col = peek_col()
            let br_end_col = peek_end_col()
            let errs_before = diag_count
            let entries_before = diag_entry_count()
            advance()
            let interp_expr = parse_expr()
            let mut interp_failed = 0
            // A mix of operator groups leaves a whole expression behind, so its E1127 stands
            // instead of collapsing into InterpParseFailure.
            if diag_count - errs_before > diag_errors_since(entries_before, MIXED_OPERATOR_PRECEDENCE) {
                interp_failed = 1
            } else if !at(TokenKind.InterpEnd) {
                interp_failed = 1
            }
            if interp_failed == 1 {
                // Collapse whatever cascade parse_expr produced into one
                // focused error at the opening brace, pointing at both
                // escape hatches (decisions/backticks-in-strings.md).
                diag_truncate(entries_before)
                diag_error_range("InterpParseFailure", INTERP_PARSE_FAILURE, "could not parse interpolation expression — `\{` starts interpolation inside \"...\" strings", br_line, br_col, br_end_col, "for a literal brace, escape it as `\\\{`; or use an extended string #\"...\"# where braces are literal")
                // Balance BOTH nested strings and nested interpolations while
                // skipping the broken body. A StringEnd is only the outer
                // string's terminator when str_depth == 0 — otherwise it closes
                // a nested escaped-quote string (e.g. `{"a","b"}`), and treating
                // it as the terminator would leave string-structural tokens
                // parked for parse_block to spin on. With no nested
                // strings str_depth stays 0 and this reduces to the original
                // `at(StringEnd) -> break` behavior, so multi-interp E1106
                // counts are preserved.
                let mut interp_depth = 0
                let mut str_depth = 0
                while !at(TokenKind.EOF) {
                    if at(TokenKind.StringStart) {
                        str_depth = str_depth + 1
                    } else if at(TokenKind.StringEnd) {
                        if str_depth == 0 {
                            break
                        }
                        str_depth = str_depth - 1
                    } else if at(TokenKind.InterpStart) {
                        interp_depth = interp_depth + 1
                    } else if at(TokenKind.InterpEnd) {
                        if interp_depth == 0 && str_depth == 0 {
                            break
                        }
                        interp_depth = interp_depth - 1
                    }
                    advance()
                }
                if at(TokenKind.InterpEnd) {
                    advance()
                }
            } else {
                sublist_push(parts, interp_expr)
                expect(TokenKind.InterpEnd)
            }
        } else {
            diag_error_range("UnexpectedToken", UNEXPECTED_TOKEN_STRING, "unexpected token in string: {token_kind_name(peek_kind())}", peek_line(), peek_col(), peek_end_col(), "")
            advance()
        }
    }
    expect(TokenKind.StringEnd)
    finalize_sublist(parts)
    let nd = node_count()
    node_push(AstNode { kind: NodeKind.InterpString, elements: parts, line: is_line, col: is_col })
    nd
}

// A literal text segment of an interpolated string, which parse_interp_string stores as
// an identifier whose text is its own name. Any other part is a hole, including an
// identifier with no text.
pub fn interp_part_is_literal(part: Int) -> Bool {
    if nk_of(node_kind(part)) != NodeKind.Ident { return false }
    node_str_val(part) == node_name(part)
}

// ── Match ───────────────────────────────────────────────────────────

fn parse_match_expr() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    let mx_line = peek_line()
    let mx_col = peek_col()
    expect(TokenKind.Match)
    let scrut = parse_expr()
    skip_newlines_and_comments()
    expect(TokenKind.LBrace)
    skip_newlines_and_comments()
    let arms = new_sublist()
    while !at(TokenKind.RBrace) && !at(TokenKind.EOF) {
        sublist_push(arms, parse_match_arm())
        skip_newlines_and_comments()
    }
    expect(TokenKind.RBrace)
    finalize_sublist(arms)
    let nd = node_count()
    node_push(AstNode { kind: NodeKind.MatchExpr, scrutinee: scrut, arms: arms, line: mx_line, col: mx_col })
    nd
}

fn parse_match_arm() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    let ma_line = peek_line()
    let ma_col = peek_col()
    let pat = parse_pattern()
    let mut guard = -1
    skip_newlines_and_comments()
    if at(TokenKind.If) {
        advance()
        guard = parse_expr()
    }
    skip_newlines_and_comments()
    expect(TokenKind.FatArrow)
    skip_newlines_and_comments()
    let mut body = -1
    if at(TokenKind.LBrace) {
        body = parse_block()
    } else {
        body = parse_stmt()
    }
    let nd = node_count()
    node_push(AstNode { kind: NodeKind.MatchArm, pattern: pat, body: body, guard: guard, line: ma_line, col: ma_col })
    nd
}

// Each pattern this returns carries the end of its last token, so a diagnostic can show the
// pattern as written.
fn parse_pattern() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    let pat = parse_pattern_alts()
    if node_end_line(pat) < 0 { node_set_end_pos(pat, tokens.lines.get(pos - 1).unwrap(), tokens.end_cols.get(pos - 1).unwrap()) }
    pat
}

fn parse_pattern_alts() -> Int ! Parse.Advance, Parse.Build, Diag.Report {
    let first = parse_single_pattern()
    if !at(TokenKind.Pipe) {
        return first
    }
    // Each alternative carries its own end, so a diagnostic can quote the one that is wrong.
    if node_end_line(first) < 0 { node_set_end_pos(first, tokens.lines.get(pos - 1).unwrap(), tokens.end_cols.get(pos - 1).unwrap()) }
    let alts = new_sublist()
    sublist_push(alts, first)
    while at(TokenKind.Pipe) {
        advance()
        skip_newlines()
        let alt = parse_single_pattern()
        if node_end_line(alt) < 0 { node_set_end_pos(alt, tokens.lines.get(pos - 1).unwrap(), tokens.end_cols.get(pos - 1).unwrap()) }
        sublist_push(alts, alt)
    }
    finalize_sublist(alts)
    let nd = node_count()
    node_push(AstNode { kind: NodeKind.OrPattern, elements: alts, line: node_line(first), col: node_col(first) })
    nd
}

// A punned field binds the field's own name, so `{ mut x }` is short for `{ x: mut x }`.
fn parse_field_mut() -> Int ! Parse.Advance {
    if !at(TokenKind.Mut) { return 0 }
    advance()
    1
}

// After an E0613 the compiler reads each name inside the pattern as `mut`, as the fix would
// mark it, so the one error brings no mutation error after it. The value differs from a
// written `mut` (1) so that typecheck does not report the name a second time.
pub const BINDER_MUT_RECOVERED = 2

// `mut` marks the one name right after it (§3.5 *Mutable Binders*). Answers 1 when it
// stands before a name the pattern binds, and consumes it then. A `mut` before anything
// else is left for parse_single_pattern to report as E0613.
fn parse_binder_mut() -> Int ! Parse.Advance {
    if !at(TokenKind.Mut) || !at_binder_name_at(pos + 1) { return 0 }
    advance()
    1
}

// A name that binds: not `_`, not a literal, and not the head of a variant or a
// constructor. A bare variant name such as `None` is told apart only once names
// resolve, so typecheck reports `mut` there.
fn at_binder_name_at(p: Int) -> Bool {
    if peek_kind_at(p) != TokenKind.Ident { return false }
    let v = tokens.values.get(p).unwrap()
    if v == "_" || v == "true" || v == "false" { return false }
    let next = peek_kind_at(p + 1)
    next != TokenKind.Dot && next != TokenKind.LParen && next != TokenKind.LBrace
}

// The names inside `pat` that a `mut` before it would mark, in source order: each binder
// with no `mut` of its own. A builtin variant such as `None` binds nothing; a user variant
// is told apart only once names resolve, so it is listed here.
fn mut_pattern_binders(pat: Int) -> List[Int] {
    let mut out: List[Int] = []
    collect_mut_pattern_binders(pat, out)
    out
}

fn collect_mut_pattern_binders(pat: Int, out: List[Int]) {
    if pat == -1 { return }
    let k = node_kind(pat)
    if k == NodeKind.IdentPattern {
        let n = node_name(pat)
        if node_is_mut(pat) == 0 && n != "_" && n != "None" && n != "Some" && n != "Ok" && n != "Err" {
            out.push(pat)
        }
        return
    }
    if k == NodeKind.AsPattern {
        if node_is_mut(pat) == 0 { out.push(pat) }
        collect_mut_pattern_binders(node_pattern(pat), out)
        return
    }
    if k == NodeKind.StructLitField {
        if node_pattern(pat) != -1 {
            collect_mut_pattern_binders(node_pattern(pat), out)
        } else if node_is_mut(pat) == 0 {
            out.push(pat)
        }
        return
    }
    let mut sl = -1
    if k == NodeKind.TuplePattern || k == NodeKind.ListPattern || k == NodeKind.OrPattern {
        sl = node_elements(pat)
    } else if k == NodeKind.EnumPattern || k == NodeKind.StructPattern {
        sl = node_fields(pat)
    }
    if sl == -1 { return }
    let mut i = 0
    while i < sublist_length(sl) {
        collect_mut_pattern_binders(sublist_get(sl, i), out)
        i = i + 1
    }
}

// The text of tokens first..last with `mut ` put before each of `binders`, which must lie
// inside that text in source order. Answers "" when the text cannot be read back or a
// binder's name is not written where its node says. A caller may pass only some of the
// binders, so this is the one place that writes `mut` into a pattern for a fix.
fn mut_pattern_fix_text(first: Int, last: Int, binders: List[Int]) -> Str {
    let text = token_span_text(first, last)
    if text == "" { return "" }
    let base = source_offset(tokens.lines.get(first).unwrap(), tokens.cols.get(first).unwrap())
    let sb = StringBuilder.new()
    let mut prev = 0
    for b in binders {
        let at_off = source_offset(node_line(b), node_col(b)) - base
        let name_end = at_off + node_name(b).byte_len()
        if at_off < prev || name_end > text.byte_len() { return "" }
        // A node that parse recovery made up has no name written at its place.
        if text.byte_slice(at_off, name_end) != node_name(b) { return "" }
        sb.write(text.byte_slice(prev, at_off))
        sb.write("mut ")
        prev = at_off
    }
    sb.write(text.byte_slice(prev, text.byte_len()))
    sb.to_str()
}

// What a `mut` stood before, for the E0613 message.
fn mut_pattern_what(pat: Int) -> Str {
    let k = node_kind(pat)
    if k == NodeKind.TuplePattern { return "a tuple pattern" }
    if k == NodeKind.ListPattern { return "a list pattern" }
    if k == NodeKind.StructPattern { return "a struct pattern" }
    if k == NodeKind.WildcardPattern { return "`_`" }
    if k == NodeKind.IntPattern || k == NodeKind.StringPattern { return "a literal" }
    if k == NodeKind.RangePattern { return "a range" }
    if k == NodeKind.IdentPattern && node_name(pat) == "_" { return "`_`" }
    if k == NodeKind.EnumPattern {
        if node_int_val(pat) == 1 { return "a struct pattern" }
        if node_fields(pat) != -1 { return "a constructor pattern" }
        return "the variant `{node_name(pat)}.{node_type_name(pat)}`"
    }
    "a pattern"
}

// E0613 over tokens mut_tok..last: the span is the text the fix replaces, so it runs from
// `mut` to the end of the pattern.
fn emit_mut_on_pattern(message: Str, mut_tok: Int, last: Int, help: Str, action: Str, fix: Str) ! Diag.Report {
    let before = diag_entry_count()
    let (line, col, end_line, end_col) = (tokens.lines.get(mut_tok).unwrap(), tokens.cols.get(mut_tok).unwrap(), tokens.lines.get(last).unwrap(), tokens.end_cols.get(last).unwrap())
    diag_error_span("MutOnPattern", MUT_ON_PATTERN, message, line, col, end_line, end_col, help)
    if fix != "" && diag_entry_count() > before { diag_set_last_fix_at(action, fix, line, col, end_line, end_col) }
}

fn mark_recovered_mut(binders: List[Int]) {
    for b in binders { node_set_is_mut(b, BINDER_MUT_RECOVERED) }
}

// `mut` at token mut_tok stood before `pat`, written as tokens first..last.
fn report_mut_on_pattern(mut_tok: Int, first: Int, last: Int, pat: Int) ! Diag.Report {
    let what = mut_pattern_what(pat)
    let message = "`mut` must come before a name, not {what}"
    let binders = mut_pattern_binders(pat)
    if binders.len() == 0 {
        emit_mut_on_pattern(message, mut_tok, last, "remove `mut`; {what} binds no name", "remove `mut`", token_span_text(first, last))
        return
    }
    let fixed = mut_pattern_fix_text(first, last, binders)
    let help = if fixed == "" { "put `mut` on each name inside the pattern that changes" } else { "put `mut` on each name that changes: `{fixed}`" }
    emit_mut_on_pattern(message, mut_tok, last, help, "put `mut` on each name", fixed)
    mark_recovered_mut(binders)
}

// In `{ x: px }` the `x` is a field label, not a name the pattern binds. The field runs
// over tokens label..last, and `mut` is the token before the label.
fn report_mut_on_field_label(fname: Str, label: Int, last: Int, fpat: Int) ! Diag.Report {
    let message = "`mut` must come before a name, not the field label `{fname}`"
    let binders = mut_pattern_binders(fpat)
    if binders.len() == 0 {
        emit_mut_on_pattern(message, label - 1, last, "remove `mut`; the field label `{fname}` binds no name, and neither does the pattern after it", "remove `mut`", token_span_text(label, last))
        return
    }
    let fixed = mut_pattern_fix_text(label, last, binders)
    let help = if fixed == "" { "put `mut` after the colon, before the name it marks" } else { "put `mut` after the colon, before the name it marks: `{fixed}`" }
    emit_mut_on_pattern(message, label - 1, last, help, "move `mut` after the colon", fixed)
    mark_recovered_mut(binders)
}

// `with e as mut f`: the name at token `name_tok` follows `mut` at token name_tok - 1.
fn report_mut_after_with_as(name_tok: Int) ! Diag.Report {
    emit_mut_on_pattern("`mut` cannot mark the name after `as` in `with`", name_tok - 1, name_tok,
        "remove `mut`; `close()` runs on the value that `with` acquired, so the name after `as` cannot be given a new value",
        "remove `mut`", token_span_text(name_tok, name_tok))
}

// A `mut` before a pattern that binds no name is reported here (E0613), and the pattern
// after it parses as written, so one stray `mut` does not hide the errors that follow it.
fn parse_single_pattern() -> Int ! Diag.Report, Parse.Advance, Parse.Build {
    if !at(TokenKind.Mut) || at_binder_name_at(pos + 1) {
        return parse_single_pattern_body()
    }
    let mut_tok = advance()
    let k = peek_kind()
    if k != TokenKind.LBracket && k != TokenKind.LParen && k != TokenKind.StringStart && k != TokenKind.Int && k != TokenKind.CharLit && k != TokenKind.Ident {
        diag_error_range("UnexpectedToken", UNEXPECTED_TOKEN_PATTERN, "expected a pattern after `mut`, got {token_kind_name(k)}", peek_line(), peek_col(), peek_end_col(), "")
        let nd = node_count()
        node_push(AstNode { kind: NodeKind.WildcardPattern, line: tokens.lines.get(mut_tok).unwrap(), col: tokens.cols.get(mut_tok).unwrap() })
        return nd
    }
    let first = pos
    let pat = parse_single_pattern_body()
    report_mut_on_pattern(mut_tok, first, pos - 1, pat)
    pat
}

fn parse_single_pattern_body() -> Int ! Diag.Report, Parse.Advance, Parse.Build {
    let sp_line = peek_line()
    let sp_col = peek_col()
    let binder_mut = parse_binder_mut()
    if at(TokenKind.LBracket) {
        advance()
        skip_newlines()
        if at(TokenKind.RBracket) {
            advance()
            let nd = node_count()
            node_push(AstNode { kind: NodeKind.ListPattern, line: sp_line, col: sp_col })
            return nd
        }
        let elems = new_sublist()
        let mut has_rest = 0
        sublist_push(elems, parse_pattern())
        while at(TokenKind.Comma) {
            advance()
            skip_newlines()
            if at(TokenKind.DotDot) {
                advance()
                if at(TokenKind.Dot) {
                    advance()
                }
                has_rest = 1
                skip_newlines()
                if at(TokenKind.Comma) {
                    advance()
                    skip_newlines()
                }
                break
            }
            if at(TokenKind.RBracket) {
                break
            }
            sublist_push(elems, parse_pattern())
        }
        skip_newlines()
        expect(TokenKind.RBracket)
        finalize_sublist(elems)
        let nd = node_count()
        node_push(AstNode { kind: NodeKind.ListPattern, elements: elems, inclusive: has_rest, line: sp_line, col: sp_col })
        return nd
    }
    if at(TokenKind.LParen) {
        advance()
        skip_newlines()
        let elems = new_sublist()
        sublist_push(elems, parse_pattern())
        while at(TokenKind.Comma) {
            advance()
            skip_newlines()
            sublist_push(elems, parse_pattern())
        }
        skip_newlines()
        expect(TokenKind.RParen)
        finalize_sublist(elems)
        let nd = node_count()
        node_push(AstNode { kind: NodeKind.TuplePattern, elements: elems, line: sp_line, col: sp_col })
        return nd
    }
    if at(TokenKind.StringStart) {
        let str_node = parse_interp_string()
        let parts_sl = node_elements(str_node)
        let mut str_val = ""
        if parts_sl != -1 && sublist_length(parts_sl) == 1 {
            str_val = node_str_val(sublist_get(parts_sl, 0))
        }
        let nd = node_count()
        node_push(AstNode { kind: NodeKind.StringPattern, str_val: str_val, line: sp_line, col: sp_col })
        return nd
    }
    if at(TokenKind.Int) {
        let v = advance_value()
        if at(TokenKind.DotDot) {
            advance()
            let hi = advance_value()
            let nd = node_count()
            node_push(AstNode { kind: NodeKind.RangePattern, str_val: v, name: hi, line: sp_line, col: sp_col })
            return nd
        }
        if at(TokenKind.DotDoteq) {
            advance()
            let hi = advance_value()
            let nd = node_count()
            node_push(AstNode { kind: NodeKind.RangePattern, str_val: v, name: hi, inclusive: 1, line: sp_line, col: sp_col })
            return nd
        }
        let nd = node_count()
        node_push(AstNode { kind: NodeKind.IntPattern, str_val: v, line: sp_line, col: sp_col })
        return nd
    }
    if at(TokenKind.CharLit) {
        let v = advance_value()
        if at(TokenKind.DotDot) {
            advance()
            let hi = advance_value()
            let nd = node_count()
            node_push(AstNode { kind: NodeKind.RangePattern, str_val: v, name: hi, line: sp_line, col: sp_col })
            return nd
        }
        if at(TokenKind.DotDoteq) {
            advance()
            let hi = advance_value()
            let nd = node_count()
            node_push(AstNode { kind: NodeKind.RangePattern, str_val: v, name: hi, inclusive: 1, line: sp_line, col: sp_col })
            return nd
        }
        let nd = node_count()
        node_push(AstNode { kind: NodeKind.IntPattern, str_val: v, line: sp_line, col: sp_col })
        return nd
    }
    if at(TokenKind.Ident) {
        let name = advance_value()
        if name == "_" {
            let nd = node_count()
            node_push(AstNode { kind: NodeKind.WildcardPattern, line: sp_line, col: sp_col })
            return nd
        }
        if name == "true" {
            let nd = node_count()
            node_push(AstNode { kind: NodeKind.IntPattern, str_val: "1", line: sp_line, col: sp_col })
            return nd
        }
        if name == "false" {
            let nd = node_count()
            node_push(AstNode { kind: NodeKind.IntPattern, str_val: "0", line: sp_line, col: sp_col })
            return nd
        }
        // Qualified variant: Type.Variant or Type.Variant(fields) or Type.Variant { fields }
        if at(TokenKind.Dot) {
            advance()
            let variant = advance_value()
            if at(TokenKind.LParen) {
                advance()
                skip_newlines()
                let flds = new_sublist()
                if !at(TokenKind.RParen) {
                    sublist_push(flds, parse_pattern())
                    while at(TokenKind.Comma) {
                        advance()
                        skip_newlines()
                        sublist_push(flds, parse_pattern())
                    }
                }
                skip_newlines()
                expect(TokenKind.RParen)
                finalize_sublist(flds)
                let nd = node_count()
                node_push(AstNode { kind: NodeKind.EnumPattern, name: name, type_name: variant, fields: flds, line: sp_line, col: sp_col })
                return nd
            }
            if at(TokenKind.LBrace) {
                // Struct-style variant pattern: Type.Variant { field, field2 } or Type.Variant { field: pat }
                advance()
                skip_newlines()
                let flds = new_sublist()
                let mut has_rest = 0
                while !at(TokenKind.RBrace) && !at(TokenKind.EOF) {
                    if at(TokenKind.DotDot) {
                        advance()
                        has_rest = 1
                        skip_newlines()
                        if at(TokenKind.Comma) {
                            advance()
                            skip_newlines()
                        }
                        break
                    }
                    let fld_line = peek_line()
                    let fld_col = peek_col()
                    let fld_mut = parse_field_mut()
                    let label = pos
                    let fname = expect_value(TokenKind.Ident)
                    if at(TokenKind.Colon) {
                        advance()
                        skip_newlines()
                        let fpat = parse_pattern()
                        if fld_mut == 1 { report_mut_on_field_label(fname, label, pos - 1, fpat) }
                        let sf = node_count()
                        node_push(AstNode { kind: NodeKind.StructLitField, name: fname, pattern: fpat, line: fld_line, col: fld_col })
                        sublist_push(flds, sf)
                    } else {
                        let sf = node_count()
                        node_push(AstNode { kind: NodeKind.StructLitField, name: fname, is_mut: fld_mut, line: fld_line, col: fld_col })
                        sublist_push(flds, sf)
                    }
                    if at(TokenKind.Comma) {
                        advance()
                        skip_newlines()
                    }
                }
                expect(TokenKind.RBrace)
                finalize_sublist(flds)
                let nd = node_count()
                node_push(AstNode { kind: NodeKind.EnumPattern, name: name, type_name: variant, fields: flds, int_val: 1, inclusive: has_rest, line: sp_line, col: sp_col })
                return nd
            }
            let nd = node_count()
            node_push(AstNode { kind: NodeKind.EnumPattern, name: name, type_name: variant, line: sp_line, col: sp_col })
            return nd
        }
        if at(TokenKind.LParen) {
            advance()
            skip_newlines()
            let flds = new_sublist()
            if !at(TokenKind.RParen) {
                sublist_push(flds, parse_pattern())
                while at(TokenKind.Comma) {
                    advance()
                    skip_newlines()
                    sublist_push(flds, parse_pattern())
                }
            }
            skip_newlines()
            expect(TokenKind.RParen)
            finalize_sublist(flds)
            let nd = node_count()
            node_push(AstNode { kind: NodeKind.EnumPattern, name: name, fields: flds, line: sp_line, col: sp_col })
            return nd
        }
        if at(TokenKind.LBrace) {
            advance()
            skip_newlines()
            let flds = new_sublist()
            let mut has_rest = 0
            while !at(TokenKind.RBrace) && !at(TokenKind.EOF) {
                if at(TokenKind.DotDot) {
                    advance()
                    has_rest = 1
                    skip_newlines()
                    if at(TokenKind.Comma) {
                        advance()
                        skip_newlines()
                    }
                    break
                }
                let fld_line = peek_line()
                let fld_col = peek_col()
                let fld_mut = parse_field_mut()
                let label = pos
                let fname = expect_value(TokenKind.Ident)
                if at(TokenKind.Colon) {
                    advance()
                    skip_newlines()
                    let fpat = parse_pattern()
                    if fld_mut == 1 { report_mut_on_field_label(fname, label, pos - 1, fpat) }
                    let sf = node_count()
                    node_push(AstNode { kind: NodeKind.StructLitField, name: fname, pattern: fpat, line: fld_line, col: fld_col })
                    sublist_push(flds, sf)
                } else {
                    let sf = node_count()
                    node_push(AstNode { kind: NodeKind.StructLitField, name: fname, is_mut: fld_mut, line: fld_line, col: fld_col })
                    sublist_push(flds, sf)
                }
                if at(TokenKind.Comma) {
                    advance()
                    skip_newlines()
                }
            }
            expect(TokenKind.RBrace)
            finalize_sublist(flds)
            let nd = node_count()
            node_push(AstNode { kind: NodeKind.StructPattern, type_name: name, fields: flds, inclusive: has_rest, line: sp_line, col: sp_col })
            return nd
        }
        if at(TokenKind.As) {
            advance()
            let inner = parse_pattern()
            let nd = node_count()
            node_push(AstNode { kind: NodeKind.AsPattern, name: name, pattern: inner, is_mut: binder_mut, line: sp_line, col: sp_col })
            return nd
        }
        // The span lets typecheck report a `mut` before a bare variant over `mut` through the name.
        let nd = node_count()
        node_push(AstNode { kind: NodeKind.IdentPattern, name: name, is_mut: binder_mut, line: sp_line, col: sp_col, end_line: tokens.lines.get(pos - 1).unwrap(), end_col: tokens.end_cols.get(pos - 1).unwrap() })
        return nd
    }
    diag_error_range("UnexpectedToken", UNEXPECTED_TOKEN_PATTERN, "unexpected token in pattern: {token_kind_name(peek_kind())}", peek_line(), peek_col(), peek_end_col(), "")
    advance()
    let nd = node_count()
    node_push(AstNode { kind: NodeKind.WildcardPattern, line: sp_line, col: sp_col })
    nd
}

// ── Annotation argument readers ────────────────────────────────────────────────
//
// An annotation argument is parsed as an InterpString node: its text sits in the
// first element, and a NAMED argument (`header: "poll.h"`) carries its label in
// node_name while a positional one leaves that empty. Readers of `@ffi` and
// friends need both facts, so they live beside the parser that produces them.

pub fn ann_str_val(node: Int) -> Str {
    let parts_sl = node_elements(node)
    if parts_sl != -1 && sublist_length(parts_sl) > 0 {
        return node_str_val(sublist_get(parts_sl, 0))
    }
    node_name(node)
}

// The i-th POSITIONAL string argument of an annotation arg sublist, skipping
// named ones. "" when there is no such argument.
pub fn positional_str_arg(args_sl: Int, idx: Int) -> Str {
    if args_sl == -1 { return "" }
    let len = sublist_length(args_sl)
    let mut i = 0
    let mut seen = 0
    while i < len {
        let arg = sublist_get(args_sl, i)
        if node_kind(arg) == NodeKind.InterpString && node_name(arg) == "" {
            if seen == idx { return ann_str_val(arg) }
            seen = seen + 1
        }
        i = i + 1
    }
    ""
}

pub fn positional_str_arg_count(args_sl: Int) -> Int {
    if args_sl == -1 { return 0 }
    let len = sublist_length(args_sl)
    let mut i = 0
    let mut count = 0
    while i < len {
        let arg = sublist_get(args_sl, i)
        if node_kind(arg) == NodeKind.InterpString && node_name(arg) == "" {
            count = count + 1
        }
        i = i + 1
    }
    count
}
