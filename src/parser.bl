import tokens.{TokenKind, is_keyword, token_kind_name}
import ast.{NodeKind, AstNode, ChildWalk, node_child_ids_into, node_unclaimed_child, nk_of, nk_is_typed, nk_bridge_gap, node_kind_name, trace, trace_mode, dbg_trace}
import lexer.{tokens}
import std.path.{path_dirname}
import diagnostics.{
    Diag, diag_error, diag_error_range, diag_source_file, diag_ice_abort, PARSER_INTERNAL_LIMIT, PARSER_INTERNAL_LIMIT_NAME,
    diag_count, diag_entry_count, diag_errors_since, diag_truncate, diag_file_for_node,
    INLINE_MODULE_NOT_SUPPORTED, UNEXPECTED_ANNOTATION, UNEXPECTED_TOKEN,
    UNEXPECTED_TOKEN_STRING, UNEXPECTED_TOKEN_PATTERN, KEYWORD_AS_IDENTIFIER,
    diag_error_span, diag_set_last_fix_at, MUT_ON_PATTERN,
    EMPTY_BRACE_EXPR, UNKNOWN_INTRINSIC, MUT_FIELD_NOT_SUPPORTED,
    INVALID_STRING_BACKED_ENUM, INTERP_PARSE_FAILURE,
    TEST_ANNOTATED_RETURN, ELEMENT_ACCESS_HELP, MIXED_OPERATOR_PRECEDENCE,
}

effect Parse {
    effect Advance
    effect Build
}

// parser.bl — Self-hosting recursive descent parser for Blink
//
// Port of src/pact/parser.py. Token input arrives as the lexer's token columns
// from the lexer. AST output is a node pool indexed by node ID.

// ── Node pool ──────────────────────────────────────────────────────
// Each node is an index into the pool. -1 means "no node".
// A node stores only the fields it holds: a field that still holds its AstNode default
// takes no space. Which fields a node holds is its shape, interned in a table. A node of most
// kinds holds three or four fields of the 57, and one kind has many sets of fields (a fn
// with or without a return type, pub or not), so a shape per node, not one per kind.
// `at_<field>[shape]` is the field's offset in the node's Int or Str payload, or -1 when the
// shape does not hold it and a read answers `node_blank`'s value.
// Nodes sit in chunks of 4096 ids. Chunk c of `ints` holds the head word of each of its
// nodes at [0, 4096) and their Int payloads after that, and chunk c of `strs` holds their
// Str payloads. A head word is (str_off << 40) | (int_off << 16) | shape, both offsets into
// the node's own chunks, so a read finds the chunk from the id alone and goes from the head
// word to the field with one more load: no load waits on a payload address read from
// another arena. Int and Str data stay in separate lists because a List[Int] buffer is
// allocated pointer-free, so the collector never scans the Int chunks.
// A chunk is made with room for its predecessor's payload and an eighth more, since a chunk
// that grows past its room is copied to one twice its size.
// A write that gives a node a field its shape does not hold moves the node's whole payload
// to its chunks' ends under a wider shape; the old payload stays unread. Shapes only widen,
// so a held field written back to its default keeps its slot. A field that a later pass
// writes on nearly every node of a kind is in the node's shape from its push
// (`node_kind_fields`), so that pass moves no payloads into chunks that are already full.
// `kind` is in one flat list since almost every walk of the tree reads it and a read through
// a chunk must load the chunk's own header first; `child_at` is in chunks of 4096.
// Only node_push, node_pop, node_replace, node_write_plain_int, node_write_plain_str,
// parser_reset and the helpers they call write the pool.
// `child_slots`: each node's children as ChildWalk.Slots writes them, one run per node. A
// sublist stays one slot and is expanded when read, so a member appended to a sublist after
// its owner exists is still seen.
// `child_at`: where node id's run in child_slots starts and how long it is, packed as
// start << 8 | count. A write that changes a node's children appends a new run and leaves
// the old one unread.
type NodeColumns {
    count: Int
    kind: List[Int]
    ints: List[List[Int]]
    strs: List[List[Str]]
    shape_mask: List[Int]
    shape_ints: List[Int]
    shape_strs: List[Int]
    // Offset of field f in shape s's payload at s * 56 + f, f in mask-bit order.
    shape_slot: List[Int]
    shape_of_mask: Map[Int, Int]
    // (mask, shape) of the last shape made for a kind, at (kind & 255) * 2: nodes of a kind
    // mostly repeat one shape, and the memo saves the map lookup for them.
    shape_memo: List[Int]
    at_str_val: List[Int]
    at_name: List[Int]
    at_op: List[Int]
    at_var_name: List[Int]
    at_module: List[Int]
    at_method: List[Int]
    at_return_type: List[Int]
    at_type_name: List[Int]
    at_trait_name: List[Int]
    at_leading_comments: List[Int]
    at_trailing_comments: List[Int]
    at_doc_comment: List[Int]
    at_xfail_reason: List[Int]
    at_int_val: List[Int]
    at_left: List[Int]
    at_right: List[Int]
    at_body: List[Int]
    at_condition: List[Int]
    at_then_body: List[Int]
    at_else_body: List[Int]
    at_scrutinee: List[Int]
    at_pattern: List[Int]
    at_guard: List[Int]
    at_value: List[Int]
    at_target: List[Int]
    at_iterable: List[Int]
    at_is_mut: List[Int]
    at_is_pub: List[Int]
    at_is_const: List[Int]
    at_inclusive: List[Int]
    at_start: List[Int]
    at_end: List[Int]
    at_obj: List[Int]
    at_index: List[Int]
    at_params: List[Int]
    at_args: List[Int]
    at_stmts: List[Int]
    at_arms: List[Int]
    at_fields: List[Int]
    at_elements: List[Int]
    at_methods: List[Int]
    at_type_params: List[Int]
    at_effects: List[Int]
    at_captures: List[Int]
    at_type_ann: List[Int]
    at_handlers: List[Int]
    at_line: List[Int]
    at_col: List[Int]
    at_end_line: List[Int]
    at_end_col: List[Int]
    at_assoc_types: List[Int]
    at_impl_binders: List[Int]
    at_recv_type_args: List[Int]
    at_impl_where_bounds: List[Int]
    at_for_binder: List[Int]
    at_supertraits: List[Int]
    child_at: List[List[Int]]
    child_slots: List[Int]
}

// The value of every field a node does not hold.
let node_blank: AstNode = AstNode {}

fn node_columns_empty() -> NodeColumns {
    let mut memo: List[Int] = List.with_capacity(512)
    while memo.len() < 512 { memo.push(-1) }
    NodeColumns { count: 0, kind: [], ints: [], strs: [], shape_mask: [], shape_ints: [], shape_strs: [], shape_slot: [], shape_of_mask: Map(), shape_memo: memo, at_str_val: [], at_name: [], at_op: [], at_var_name: [], at_module: [], at_method: [], at_return_type: [], at_type_name: [], at_trait_name: [], at_leading_comments: [], at_trailing_comments: [], at_doc_comment: [], at_xfail_reason: [], at_int_val: [], at_left: [], at_right: [], at_body: [], at_condition: [], at_then_body: [], at_else_body: [], at_scrutinee: [], at_pattern: [], at_guard: [], at_value: [], at_target: [], at_iterable: [], at_is_mut: [], at_is_pub: [], at_is_const: [], at_inclusive: [], at_start: [], at_end: [], at_obj: [], at_index: [], at_params: [], at_args: [], at_stmts: [], at_arms: [], at_fields: [], at_elements: [], at_methods: [], at_type_params: [], at_effects: [], at_captures: [], at_type_ann: [], at_handlers: [], at_line: [], at_col: [], at_end_line: [], at_end_col: [], at_assoc_types: [], at_impl_binders: [], at_recv_type_args: [], at_impl_where_bounds: [], at_for_binder: [], at_supertraits: [], child_at: [], child_slots: [] }
}

let mut columns: NodeColumns = node_columns_empty()

// Sublists: for lists of node references (params, args, stmts, etc.). Every closed sublist is
// a run of `arena`, so a read is one load chain, not one through a List per sublist; `start`
// and `len` hold the run of each sublist id. Sublists nest while a parse runs, so an open one
// cannot grow in place in the arena: it builds in `scratch` at its depth on the `open` stack,
// and its start reads -2 - depth until finalize_sublist copies it to the arena end. Its length
// stays live so a read before finalize still reads right.
type SublistPool {
    arena: List[Int]
    start: List[Int]
    len: List[Int]
    open: List[Int]
    scratch: List[List[Int]]
}

let mut sublists: SublistPool = SublistPool { arena: [], start: [], len: [], open: [], scratch: [] }

// The annotations read ahead of the next item, and the program-level ones.
type PendingAnnotations {
    item: List[Int]
    program: List[Int]
}

let mut annotations: PendingAnnotations = PendingAnnotations { item: [], program: [] }

// The token range of each top-level fn and method body in the source parsed last, kept only
// while a build wants each source's interface text. A body edit changes tokens inside these
// alone.
type FnBodies {
    wanted: Bool
    // Whether the loader keeps what each interface text is written from, for a caller to
    // write later, in place of the text.
    deferred: Bool
    depth: Int
    tok_firsts: List[Int]
    tok_lasts: List[Int]
    // The first token of each top-level item, and what the item is: "fn <name>" for a fn,
    // followed by " @<annotation>" for each annotation over it, "ann <annotation> fn <name>"
    // for each of those annotations, "trait <name>" followed by its methods and associated
    // types for a trait with no annotation over it or in it, "let <name>" and "const <name>"
    // for a global and a const with no annotation that bind one name, "test" for a test block
    // with no annotation, "import" for an import that is not pub, "end" for the end of the
    // source, and "other" for the rest. A build that compares two interfaces item by item can
    // then tell which fns, traits and globals an edit added, removed or changed, under which
    // annotations, and when it changed only a test.
    item_firsts: List[Int]
    item_kinds: List[Str]
}

let mut fn_bodies: FnBodies = FnBodies { wanted: false, deferred: false, depth: 0, tok_firsts: [], tok_lasts: [], item_firsts: [], item_kinds: [] }

// `@expect_panic` desugars to a real AssertPanics node during parse so the
// compile path gets all the assert_panics machinery for free. The FORMAT path
// disables it (set to 0 before parse_program, restored after) so the formatter
// round-trips the original `@expect_panic` surface syntax instead of printing
// the desugared `assert_panics` body — which would otherwise double-wrap on the
// next format and is non-idempotent.
pub let mut parse_desugar_enabled: Int = 1

// Side table: dotted-path-derived module key per top-level decl node.
// Populated during merge_programs from the import graph. Used by
// codegen's archive-mode emission filter to route decls by source
// of origin. blink_map keys must be const char*, so the node id is
// stringified.
pub let mut source_module_for_node: Map[Int, Str] = Map()

// A daemon recheck keeps the nodes of each source whose bytes did not change, so the pool must
// go back to what the parses wrote before each check. Every write to a node or a closed
// sublist below `floor`, the node count after the last parse, is recorded here with what it
// overwrote, and a rewind undoes the records newest first, then drops all that the check
// pushed past the parsed end. A write at or past `floor` belongs to a parse in progress, or to
// a node the rewind drops. `floor` stays 0 unless a caller keeps parsed nodes, so a one-shot
// compile records nothing.
type NodeJournal {
    keep: Bool
    floor: Int
    sl_floor: Int
    // One record per write: what (JOURNAL_INT, ...), where, and the old value or values.
    what: List[Int]
    at: List[Int]
    old: List[Int]
    old2: List[Int]
    old_str: List[Str]
    // The parsed end: the length of each Int and Str chunk, of child_slots and of the sublist
    // arena, and the sublist count, when the last parse ended. Empty before the first.
    marked: Bool
    end_ints: List[Int]
    end_strs: List[Int]
    end_child_slots: Int
    end_sublists: Int
    end_arena: Int
    // The node ranges of the loaded sources in load order, and where each starts in a load
    // that parsed every source in that order. Empty while ids are already in that order.
    order_firsts: List[Int]
    order_ends: List[Int]
    order_offsets: List[Int]
    order_live: Int
    // The parsed end the order was set at: where the nodes made after the parses start.
    order_floor: Int
}

let JOURNAL_INT = 0
let JOURNAL_STR = 1
let JOURNAL_KIND = 2
let JOURNAL_CHILD_AT = 3
let JOURNAL_SUBLIST = 4

fn node_journal_empty(keep: Bool) -> NodeJournal {
    NodeJournal { keep: keep, floor: 0, sl_floor: 0, what: [], at: [], old: [], old2: [], old_str: [], marked: false, end_ints: [], end_strs: [], end_child_slots: 0, end_sublists: 0, end_arena: 0, order_firsts: [], order_ends: [], order_offsets: [], order_live: 0, order_floor: 0 }
}

let mut journal: NodeJournal = node_journal_empty(false)

fn journal_record(what: Int, slot: Int, old: Int, old2: Int, old_str: Str) {
    journal.what.push(what)
    journal.at.push(slot)
    journal.old.push(old)
    journal.old2.push(old2)
    journal.old_str.push(old_str)
}

// Whether the parser keeps what each parse wrote across resets, so parser_rewind can return
// to it. Turning it off drops what was kept.
pub fn parser_keep_parsed(on: Bool) {
    if !on { journal = node_journal_empty(false) }
    journal.keep = on
}

// Stops keeping what each parse wrote, as parser_keep_parsed(false) does, but keeps the load
// order: a build from the last check loads nothing again, yet must visit and pick nodes as a
// build from a cold load would.
pub fn parser_keep_load_order_only() {
    let order = journal
    journal = node_journal_empty(false)
    journal.order_firsts = order.order_firsts
    journal.order_ends = order.order_ends
    journal.order_offsets = order.order_offsets
    journal.order_live = order.order_live
    journal.order_floor = order.order_floor
}

pub fn parser_keeps_parsed() -> Bool { journal.keep }

// Whether there is a parsed state to rewind to.
pub fn parser_has_parsed_end() -> Bool { journal.keep && journal.marked }

// The node count when the last parse ended.
pub fn parser_parsed_end() -> Int { journal.floor }

// Called once a source's parse and comment attachment are done: what they wrote is now
// parsed state, and every later write below here is recorded.
pub fn parser_mark_parsed() {
    if !journal.keep { return }
    journal.floor = columns.count
    journal.sl_floor = sublists.start.len()
    journal.marked = true
    journal.end_ints.clear()
    journal.end_strs.clear()
    let mut c = 0
    while c < columns.ints.len() {
        journal.end_ints.push(columns.ints.get(c).unwrap().len())
        journal.end_strs.push(columns.strs.get(c).unwrap().len())
        c = c + 1
    }
    journal.end_child_slots = columns.child_slots.len()
    journal.end_sublists = sublists.start.len()
    journal.end_arena = sublists.arena.len()
}

// Returns the pool to what the parses wrote, as parser_reset returns it to empty. Every
// record is undone, newest first, before the drop, since a record may name a slot past the
// parsed end.
pub fn parser_rewind() {
    let undone = journal.what.len()
    let before = columns.count
    let mut k = journal.what.len() - 1
    while k >= 0 {
        let what = journal.what.get(k).unwrap()
        let slot = journal.at.get(k).unwrap()
        if what == JOURNAL_INT {
            columns.ints.get(slot >> 32).unwrap().set(slot & 4294967295, journal.old.get(k).unwrap())
        } else if what == JOURNAL_STR {
            columns.strs.get(slot >> 32).unwrap().set(slot & 4294967295, journal.old_str.get(k).unwrap())
        } else if what == JOURNAL_KIND {
            columns.kind.set(slot, journal.old.get(k).unwrap())
        } else if what == JOURNAL_CHILD_AT {
            columns.child_at.get(slot >> 12).unwrap().set(slot & 4095, journal.old.get(k).unwrap())
        } else {
            sublists.start.set(slot, journal.old.get(k).unwrap())
            sublists.len.set(slot, journal.old2.get(k).unwrap())
        }
        k = k - 1
    }
    journal.what.clear()
    journal.at.clear()
    journal.old.clear()
    journal.old2.clear()
    journal.old_str.clear()
    let n = journal.floor
    let chunks = (n + 4095) >> 12
    while columns.ints.len() > chunks {
        let _ = columns.ints.pop()
        let _ = columns.strs.pop()
        let _ = columns.child_at.pop()
    }
    let mut c = 0
    while c < chunks {
        node_ints_drop(c, columns.ints.get(c).unwrap().len() - journal.end_ints.get(c).unwrap())
        node_strs_drop(c, columns.strs.get(c).unwrap().len() - journal.end_strs.get(c).unwrap())
        c = c + 1
    }
    if chunks > 0 {
        let last = chunks - 1
        let keep = n - (last << 12)
        while columns.child_at.get(last).unwrap().len() > keep {
            let _ = columns.child_at.get(last).unwrap().pop()
        }
    }
    while columns.kind.len() > n {
        let _ = columns.kind.pop()
    }
    columns.count = n
    node_drop_child_slots_from(journal.end_child_slots)
    while sublists.start.len() > journal.end_sublists {
        let _ = sublists.start.pop()
        let _ = sublists.len.pop()
    }
    while sublists.arena.len() > journal.end_arena {
        let _ = sublists.arena.pop()
    }
    sublists.open.clear()
    journal.sl_floor = journal.end_sublists
    journal.order_firsts = []
    journal.order_ends = []
    journal.order_offsets = []
    journal.order_live = 0
    journal.order_floor = 0
    annotations = PendingAnnotations { item: [], program: [] }
    fn_bodies = FnBodies { wanted: fn_bodies.wanted, deferred: fn_bodies.deferred, depth: 0, tok_firsts: [], tok_lasts: [], item_firsts: [], item_kinds: [] }
    source_module_for_node.clear()
    pos = 0
    parse_desugar_enabled = 1
    dbg_trace("journal", "undo undid {undone} writes, dropped {before - columns.count} nodes; pool {columns.count} nodes, parsed end {journal.floor}")
}

// The program-level annotations a parse leaves for the parses after it, which put them in
// their own program's annotations as well; a source that is not parsed again must hand on
// the ones its parse did.
pub fn parser_program_annotations() -> List[Int] {
    let mut out: List[Int] = []
    for a in annotations.program { out.push(a) }
    out
}

pub fn parser_set_program_annotations(anns: List[Int]) {
    let mut out: List[Int] = []
    for a in anns { out.push(a) }
    annotations.program = out
}

// The node ranges of the loaded sources in load order. A cold load parses them in that order,
// so a node's id there is where it is in this order; a pass that visits or picks nodes by id
// asks node_load_rank, so a load that kept nodes visits and picks as a cold one does.
pub fn parser_set_load_order(firsts: List[Int], ends: List[Int]) {
    journal.order_firsts = []
    journal.order_ends = []
    journal.order_offsets = []
    let mut live = 0
    let mut in_order = true
    let mut i = 0
    while i < firsts.len() {
        if firsts.get(i).unwrap() != live { in_order = false }
        journal.order_firsts.push(firsts.get(i).unwrap())
        journal.order_ends.push(ends.get(i).unwrap())
        journal.order_offsets.push(live)
        live = live + ends.get(i).unwrap() - firsts.get(i).unwrap()
        i = i + 1
    }
    if !journal.keep || (in_order && live == journal.floor) {
        journal.order_firsts = []
        journal.order_ends = []
        journal.order_offsets = []
    }
    journal.order_live = live
    journal.order_floor = journal.floor
}

// Whether ids are out of load order, so node_load_rank is not the id.
pub fn parser_load_order_moved() -> Bool { journal.order_firsts.len() > 0 }

// Where node `id` would be in a load that parsed every source in load order: its id there.
// A node made after the parses comes after them in the same order. -1 for a node no loaded
// source holds: the old parse of a source parsed again.
pub fn node_load_rank(id: Int) -> Int {
    if journal.order_firsts.len() == 0 { return id }
    if id >= journal.order_floor { return journal.order_live + id - journal.order_floor }
    let mut i = 0
    while i < journal.order_firsts.len() {
        if id >= journal.order_firsts.get(i).unwrap() && id < journal.order_ends.get(i).unwrap() {
            return journal.order_offsets.get(i).unwrap() + id - journal.order_firsts.get(i).unwrap()
        }
        i = i + 1
    }
    -1
}

// The ranges of parser_set_load_order, then the nodes made after the parses, as [first, end)
// pairs: every node a cold load would hold, in its order.
pub fn parser_live_ranges() -> List[Int] {
    let mut out: List[Int] = []
    if journal.order_firsts.len() == 0 {
        out.push(0)
        out.push(columns.count)
        return out
    }
    let mut i = 0
    while i < journal.order_firsts.len() {
        out.push(journal.order_firsts.get(i).unwrap())
        out.push(journal.order_ends.get(i).unwrap())
        i = i + 1
    }
    out.push(journal.order_floor)
    out.push(columns.count)
    out
}

// The path is written relative to the source file that holds the `#embed`, which is the only
// directory the author can reason about; the stdlib registry writes all of its paths that way.
pub fn embed_path_of(node: Int) -> Str {
    "{path_dirname(diag_file_for_node(node))}/{node_str_val(node)}"
}

pub fn parser_reset() {
    columns = node_columns_empty()
    sublists = SublistPool { arena: [], start: [], len: [], open: [], scratch: [] }
    annotations = PendingAnnotations { item: [], program: [] }
    // The build sets wanted before the front end, which resets the parser first.
    fn_bodies = FnBodies { wanted: fn_bodies.wanted, deferred: fn_bodies.deferred, depth: 0, tok_firsts: [], tok_lasts: [], item_firsts: [], item_kinds: [] }
    source_module_for_node.clear()
    pos = 0
    parse_desugar_enabled = 1
    journal = node_journal_empty(journal.keep)
}

pub fn record_source_module(node_id: Int, key: Str) {
    source_module_for_node.insert(node_id, key)
}

pub fn node_source_module(id: Int) -> Str {
    match source_module_for_node.get(id) {
        Some(key) => key
        None => {
            node_get_str(checked_node_id(id, "node_source_module"), columns.at_module, node_blank.module)
        }
    }
}

pub fn new_node(kind: NodeKind) -> Int ! Parse.Build {
    node_push(AstNode { kind: kind, line: peek_line(), col: peek_col() })
}

// The fields of `n` that differ from their default, one bit per field: Int fields from bit
// 0 in AstNode order, then Str fields from bit 43.
fn node_mask(n: AstNode) -> Int {
    let mut m = 0
    if n.int_val != node_blank.int_val { m = m | 1 }
    if n.left != node_blank.left { m = m | 2 }
    if n.right != node_blank.right { m = m | 4 }
    if n.body != node_blank.body { m = m | 8 }
    if n.condition != node_blank.condition { m = m | 16 }
    if n.then_body != node_blank.then_body { m = m | 32 }
    if n.else_body != node_blank.else_body { m = m | 64 }
    if n.scrutinee != node_blank.scrutinee { m = m | 128 }
    if n.pattern != node_blank.pattern { m = m | 256 }
    if n.guard != node_blank.guard { m = m | 512 }
    if n.value != node_blank.value { m = m | 1024 }
    if n.target != node_blank.target { m = m | 2048 }
    if n.iterable != node_blank.iterable { m = m | 4096 }
    if n.is_mut != node_blank.is_mut { m = m | 8192 }
    if n.is_pub != node_blank.is_pub { m = m | 16384 }
    if n.is_const != node_blank.is_const { m = m | 32768 }
    if n.inclusive != node_blank.inclusive { m = m | 65536 }
    if n.start != node_blank.start { m = m | 131072 }
    if n.end != node_blank.end { m = m | 262144 }
    if n.obj != node_blank.obj { m = m | 524288 }
    if n.index != node_blank.index { m = m | 1048576 }
    if n.params != node_blank.params { m = m | 2097152 }
    if n.args != node_blank.args { m = m | 4194304 }
    if n.stmts != node_blank.stmts { m = m | 8388608 }
    if n.arms != node_blank.arms { m = m | 16777216 }
    if n.fields != node_blank.fields { m = m | 33554432 }
    if n.elements != node_blank.elements { m = m | 67108864 }
    if n.methods != node_blank.methods { m = m | 134217728 }
    if n.type_params != node_blank.type_params { m = m | 268435456 }
    if n.effects != node_blank.effects { m = m | 536870912 }
    if n.captures != node_blank.captures { m = m | 1073741824 }
    if n.type_ann != node_blank.type_ann { m = m | 2147483648 }
    if n.handlers != node_blank.handlers { m = m | 4294967296 }
    if n.line != node_blank.line { m = m | 8589934592 }
    if n.col != node_blank.col { m = m | 17179869184 }
    if n.end_line != node_blank.end_line { m = m | 34359738368 }
    if n.end_col != node_blank.end_col { m = m | 68719476736 }
    if n.assoc_types != node_blank.assoc_types { m = m | 137438953472 }
    if n.impl_binders != node_blank.impl_binders { m = m | 274877906944 }
    if n.recv_type_args != node_blank.recv_type_args { m = m | 549755813888 }
    if n.impl_where_bounds != node_blank.impl_where_bounds { m = m | 1099511627776 }
    if n.for_binder != node_blank.for_binder { m = m | 2199023255552 }
    if n.supertraits != node_blank.supertraits { m = m | 4398046511104 }
    if n.str_val != node_blank.str_val { m = m | 8796093022208 }
    if n.name != node_blank.name { m = m | 17592186044416 }
    if n.op != node_blank.op { m = m | 35184372088832 }
    if n.var_name != node_blank.var_name { m = m | 70368744177664 }
    if n.module != node_blank.module { m = m | 140737488355328 }
    if n.method != node_blank.method { m = m | 281474976710656 }
    if n.return_type != node_blank.return_type { m = m | 562949953421312 }
    if n.type_name != node_blank.type_name { m = m | 1125899906842624 }
    if n.trait_name != node_blank.trait_name { m = m | 2251799813685248 }
    if n.leading_comments != node_blank.leading_comments { m = m | 4503599627370496 }
    if n.trailing_comments != node_blank.trailing_comments { m = m | 9007199254740992 }
    if n.doc_comment != node_blank.doc_comment { m = m | 18014398509481984 }
    if n.xfail_reason != node_blank.xfail_reason { m = m | 36028797018963968 }
    m
}

// The shape whose fields are the bits of `m`, made on first use.
fn node_shape(m: Int, kind: Int) -> Int {
    let k = (kind & 255) * 2
    if columns.shape_memo.get(k).unwrap() == m { return columns.shape_memo.get(k + 1).unwrap() }
    let s = match columns.shape_of_mask.get(m) {
        Some(found) => found
        None => node_shape_new(m)
    }
    columns.shape_memo.set(k, m)
    columns.shape_memo.set(k + 1, s)
    s
}

fn node_shape_new(m: Int) -> Int {
    let s = columns.shape_mask.len()
    if s > 65535 {
        parser_limit_stop("the node pool has more than 65536 shapes; head packs at most that")
    }
    let base = s * 56
    let mut bit = 1
    let mut ioff = 0
    let mut soff = 0
    let mut f = 0
    while f < 56 {
        if (m & bit) == 0 {
            columns.shape_slot.push(-1)
        } else if f < 43 {
            columns.shape_slot.push(ioff)
            ioff = ioff + 1
        } else {
            columns.shape_slot.push(soff)
            soff = soff + 1
        }
        bit = bit * 2
        f = f + 1
    }
    columns.shape_mask.push(m)
    columns.shape_ints.push(ioff)
    columns.shape_strs.push(soff)
    columns.at_str_val.push(columns.shape_slot.get(base + 43).unwrap())
    columns.at_name.push(columns.shape_slot.get(base + 44).unwrap())
    columns.at_op.push(columns.shape_slot.get(base + 45).unwrap())
    columns.at_var_name.push(columns.shape_slot.get(base + 46).unwrap())
    columns.at_module.push(columns.shape_slot.get(base + 47).unwrap())
    columns.at_method.push(columns.shape_slot.get(base + 48).unwrap())
    columns.at_return_type.push(columns.shape_slot.get(base + 49).unwrap())
    columns.at_type_name.push(columns.shape_slot.get(base + 50).unwrap())
    columns.at_trait_name.push(columns.shape_slot.get(base + 51).unwrap())
    columns.at_leading_comments.push(columns.shape_slot.get(base + 52).unwrap())
    columns.at_trailing_comments.push(columns.shape_slot.get(base + 53).unwrap())
    columns.at_doc_comment.push(columns.shape_slot.get(base + 54).unwrap())
    columns.at_xfail_reason.push(columns.shape_slot.get(base + 55).unwrap())
    columns.at_int_val.push(columns.shape_slot.get(base + 0).unwrap())
    columns.at_left.push(columns.shape_slot.get(base + 1).unwrap())
    columns.at_right.push(columns.shape_slot.get(base + 2).unwrap())
    columns.at_body.push(columns.shape_slot.get(base + 3).unwrap())
    columns.at_condition.push(columns.shape_slot.get(base + 4).unwrap())
    columns.at_then_body.push(columns.shape_slot.get(base + 5).unwrap())
    columns.at_else_body.push(columns.shape_slot.get(base + 6).unwrap())
    columns.at_scrutinee.push(columns.shape_slot.get(base + 7).unwrap())
    columns.at_pattern.push(columns.shape_slot.get(base + 8).unwrap())
    columns.at_guard.push(columns.shape_slot.get(base + 9).unwrap())
    columns.at_value.push(columns.shape_slot.get(base + 10).unwrap())
    columns.at_target.push(columns.shape_slot.get(base + 11).unwrap())
    columns.at_iterable.push(columns.shape_slot.get(base + 12).unwrap())
    columns.at_is_mut.push(columns.shape_slot.get(base + 13).unwrap())
    columns.at_is_pub.push(columns.shape_slot.get(base + 14).unwrap())
    columns.at_is_const.push(columns.shape_slot.get(base + 15).unwrap())
    columns.at_inclusive.push(columns.shape_slot.get(base + 16).unwrap())
    columns.at_start.push(columns.shape_slot.get(base + 17).unwrap())
    columns.at_end.push(columns.shape_slot.get(base + 18).unwrap())
    columns.at_obj.push(columns.shape_slot.get(base + 19).unwrap())
    columns.at_index.push(columns.shape_slot.get(base + 20).unwrap())
    columns.at_params.push(columns.shape_slot.get(base + 21).unwrap())
    columns.at_args.push(columns.shape_slot.get(base + 22).unwrap())
    columns.at_stmts.push(columns.shape_slot.get(base + 23).unwrap())
    columns.at_arms.push(columns.shape_slot.get(base + 24).unwrap())
    columns.at_fields.push(columns.shape_slot.get(base + 25).unwrap())
    columns.at_elements.push(columns.shape_slot.get(base + 26).unwrap())
    columns.at_methods.push(columns.shape_slot.get(base + 27).unwrap())
    columns.at_type_params.push(columns.shape_slot.get(base + 28).unwrap())
    columns.at_effects.push(columns.shape_slot.get(base + 29).unwrap())
    columns.at_captures.push(columns.shape_slot.get(base + 30).unwrap())
    columns.at_type_ann.push(columns.shape_slot.get(base + 31).unwrap())
    columns.at_handlers.push(columns.shape_slot.get(base + 32).unwrap())
    columns.at_line.push(columns.shape_slot.get(base + 33).unwrap())
    columns.at_col.push(columns.shape_slot.get(base + 34).unwrap())
    columns.at_end_line.push(columns.shape_slot.get(base + 35).unwrap())
    columns.at_end_col.push(columns.shape_slot.get(base + 36).unwrap())
    columns.at_assoc_types.push(columns.shape_slot.get(base + 37).unwrap())
    columns.at_impl_binders.push(columns.shape_slot.get(base + 38).unwrap())
    columns.at_recv_type_args.push(columns.shape_slot.get(base + 39).unwrap())
    columns.at_impl_where_bounds.push(columns.shape_slot.get(base + 40).unwrap())
    columns.at_for_binder.push(columns.shape_slot.get(base + 41).unwrap())
    columns.at_supertraits.push(columns.shape_slot.get(base + 42).unwrap())
    columns.shape_of_mask.insert(m, s)
    s
}

// Appends `n`'s fields of shape `s` to the ends of node chunk `c` and returns the head word
// that addresses them.
fn node_store(n: AstNode, s: Int, c: Int) -> Int {
    let mk = columns.shape_mask.get(s).unwrap()
    let ib = columns.ints.get(c).unwrap().len()
    let sb = columns.strs.get(c).unwrap().len()
    if ib + columns.shape_ints.get(s).unwrap() >= 16777216 || sb + columns.shape_strs.get(s).unwrap() >= 8388608 {
        parser_limit_stop("node chunk {c} holds more payload than a head word addresses")
    }
    if (mk & 8796093022208) != 0 { columns.strs.get(c).unwrap().push(n.str_val) }
    if (mk & 17592186044416) != 0 { columns.strs.get(c).unwrap().push(n.name) }
    if (mk & 35184372088832) != 0 { columns.strs.get(c).unwrap().push(n.op) }
    if (mk & 70368744177664) != 0 { columns.strs.get(c).unwrap().push(n.var_name) }
    if (mk & 140737488355328) != 0 { columns.strs.get(c).unwrap().push(n.module) }
    if (mk & 281474976710656) != 0 { columns.strs.get(c).unwrap().push(n.method) }
    if (mk & 562949953421312) != 0 { columns.strs.get(c).unwrap().push(n.return_type) }
    if (mk & 1125899906842624) != 0 { columns.strs.get(c).unwrap().push(n.type_name) }
    if (mk & 2251799813685248) != 0 { columns.strs.get(c).unwrap().push(n.trait_name) }
    if (mk & 4503599627370496) != 0 { columns.strs.get(c).unwrap().push(n.leading_comments) }
    if (mk & 9007199254740992) != 0 { columns.strs.get(c).unwrap().push(n.trailing_comments) }
    if (mk & 18014398509481984) != 0 { columns.strs.get(c).unwrap().push(n.doc_comment) }
    if (mk & 36028797018963968) != 0 { columns.strs.get(c).unwrap().push(n.xfail_reason) }
    if (mk & 1) != 0 { columns.ints.get(c).unwrap().push(n.int_val) }
    if (mk & 2) != 0 { columns.ints.get(c).unwrap().push(n.left) }
    if (mk & 4) != 0 { columns.ints.get(c).unwrap().push(n.right) }
    if (mk & 8) != 0 { columns.ints.get(c).unwrap().push(n.body) }
    if (mk & 16) != 0 { columns.ints.get(c).unwrap().push(n.condition) }
    if (mk & 32) != 0 { columns.ints.get(c).unwrap().push(n.then_body) }
    if (mk & 64) != 0 { columns.ints.get(c).unwrap().push(n.else_body) }
    if (mk & 128) != 0 { columns.ints.get(c).unwrap().push(n.scrutinee) }
    if (mk & 256) != 0 { columns.ints.get(c).unwrap().push(n.pattern) }
    if (mk & 512) != 0 { columns.ints.get(c).unwrap().push(n.guard) }
    if (mk & 1024) != 0 { columns.ints.get(c).unwrap().push(n.value) }
    if (mk & 2048) != 0 { columns.ints.get(c).unwrap().push(n.target) }
    if (mk & 4096) != 0 { columns.ints.get(c).unwrap().push(n.iterable) }
    if (mk & 8192) != 0 { columns.ints.get(c).unwrap().push(n.is_mut) }
    if (mk & 16384) != 0 { columns.ints.get(c).unwrap().push(n.is_pub) }
    if (mk & 32768) != 0 { columns.ints.get(c).unwrap().push(n.is_const) }
    if (mk & 65536) != 0 { columns.ints.get(c).unwrap().push(n.inclusive) }
    if (mk & 131072) != 0 { columns.ints.get(c).unwrap().push(n.start) }
    if (mk & 262144) != 0 { columns.ints.get(c).unwrap().push(n.end) }
    if (mk & 524288) != 0 { columns.ints.get(c).unwrap().push(n.obj) }
    if (mk & 1048576) != 0 { columns.ints.get(c).unwrap().push(n.index) }
    if (mk & 2097152) != 0 { columns.ints.get(c).unwrap().push(n.params) }
    if (mk & 4194304) != 0 { columns.ints.get(c).unwrap().push(n.args) }
    if (mk & 8388608) != 0 { columns.ints.get(c).unwrap().push(n.stmts) }
    if (mk & 16777216) != 0 { columns.ints.get(c).unwrap().push(n.arms) }
    if (mk & 33554432) != 0 { columns.ints.get(c).unwrap().push(n.fields) }
    if (mk & 67108864) != 0 { columns.ints.get(c).unwrap().push(n.elements) }
    if (mk & 134217728) != 0 { columns.ints.get(c).unwrap().push(n.methods) }
    if (mk & 268435456) != 0 { columns.ints.get(c).unwrap().push(n.type_params) }
    if (mk & 536870912) != 0 { columns.ints.get(c).unwrap().push(n.effects) }
    if (mk & 1073741824) != 0 { columns.ints.get(c).unwrap().push(n.captures) }
    if (mk & 2147483648) != 0 { columns.ints.get(c).unwrap().push(n.type_ann) }
    if (mk & 4294967296) != 0 { columns.ints.get(c).unwrap().push(n.handlers) }
    if (mk & 8589934592) != 0 { columns.ints.get(c).unwrap().push(n.line) }
    if (mk & 17179869184) != 0 { columns.ints.get(c).unwrap().push(n.col) }
    if (mk & 34359738368) != 0 { columns.ints.get(c).unwrap().push(n.end_line) }
    if (mk & 68719476736) != 0 { columns.ints.get(c).unwrap().push(n.end_col) }
    if (mk & 137438953472) != 0 { columns.ints.get(c).unwrap().push(n.assoc_types) }
    if (mk & 274877906944) != 0 { columns.ints.get(c).unwrap().push(n.impl_binders) }
    if (mk & 549755813888) != 0 { columns.ints.get(c).unwrap().push(n.recv_type_args) }
    if (mk & 1099511627776) != 0 { columns.ints.get(c).unwrap().push(n.impl_where_bounds) }
    if (mk & 2199023255552) != 0 { columns.ints.get(c).unwrap().push(n.for_binder) }
    if (mk & 4398046511104) != 0 { columns.ints.get(c).unwrap().push(n.supertraits) }
    (sb << 40) | (ib << 16) | s
}

// Writes every field shape `s` holds from `n`, over the payload that head word `h` of a
// node in chunk `c` addresses.
fn node_overwrite(n: AstNode, s: Int, h: Int, c: Int) {
    let mk = columns.shape_mask.get(s).unwrap()
    let ic = c
    let mut ij = (h >> 16) & 16777215
    if columns.shape_strs.get(s).unwrap() > 0 {
        let sc = c
        let mut sj = h >> 40
        if (mk & 8796093022208) != 0 {
            columns.strs.get(sc).unwrap().set(sj, n.str_val)
            sj = sj + 1
        }
        if (mk & 17592186044416) != 0 {
            columns.strs.get(sc).unwrap().set(sj, n.name)
            sj = sj + 1
        }
        if (mk & 35184372088832) != 0 {
            columns.strs.get(sc).unwrap().set(sj, n.op)
            sj = sj + 1
        }
        if (mk & 70368744177664) != 0 {
            columns.strs.get(sc).unwrap().set(sj, n.var_name)
            sj = sj + 1
        }
        if (mk & 140737488355328) != 0 {
            columns.strs.get(sc).unwrap().set(sj, n.module)
            sj = sj + 1
        }
        if (mk & 281474976710656) != 0 {
            columns.strs.get(sc).unwrap().set(sj, n.method)
            sj = sj + 1
        }
        if (mk & 562949953421312) != 0 {
            columns.strs.get(sc).unwrap().set(sj, n.return_type)
            sj = sj + 1
        }
        if (mk & 1125899906842624) != 0 {
            columns.strs.get(sc).unwrap().set(sj, n.type_name)
            sj = sj + 1
        }
        if (mk & 2251799813685248) != 0 {
            columns.strs.get(sc).unwrap().set(sj, n.trait_name)
            sj = sj + 1
        }
        if (mk & 4503599627370496) != 0 {
            columns.strs.get(sc).unwrap().set(sj, n.leading_comments)
            sj = sj + 1
        }
        if (mk & 9007199254740992) != 0 {
            columns.strs.get(sc).unwrap().set(sj, n.trailing_comments)
            sj = sj + 1
        }
        if (mk & 18014398509481984) != 0 {
            columns.strs.get(sc).unwrap().set(sj, n.doc_comment)
            sj = sj + 1
        }
        if (mk & 36028797018963968) != 0 {
            columns.strs.get(sc).unwrap().set(sj, n.xfail_reason)
            sj = sj + 1
        }
    }
    if (mk & 1) != 0 {
        columns.ints.get(ic).unwrap().set(ij, n.int_val)
        ij = ij + 1
    }
    if (mk & 2) != 0 {
        columns.ints.get(ic).unwrap().set(ij, n.left)
        ij = ij + 1
    }
    if (mk & 4) != 0 {
        columns.ints.get(ic).unwrap().set(ij, n.right)
        ij = ij + 1
    }
    if (mk & 8) != 0 {
        columns.ints.get(ic).unwrap().set(ij, n.body)
        ij = ij + 1
    }
    if (mk & 16) != 0 {
        columns.ints.get(ic).unwrap().set(ij, n.condition)
        ij = ij + 1
    }
    if (mk & 32) != 0 {
        columns.ints.get(ic).unwrap().set(ij, n.then_body)
        ij = ij + 1
    }
    if (mk & 64) != 0 {
        columns.ints.get(ic).unwrap().set(ij, n.else_body)
        ij = ij + 1
    }
    if (mk & 128) != 0 {
        columns.ints.get(ic).unwrap().set(ij, n.scrutinee)
        ij = ij + 1
    }
    if (mk & 256) != 0 {
        columns.ints.get(ic).unwrap().set(ij, n.pattern)
        ij = ij + 1
    }
    if (mk & 512) != 0 {
        columns.ints.get(ic).unwrap().set(ij, n.guard)
        ij = ij + 1
    }
    if (mk & 1024) != 0 {
        columns.ints.get(ic).unwrap().set(ij, n.value)
        ij = ij + 1
    }
    if (mk & 2048) != 0 {
        columns.ints.get(ic).unwrap().set(ij, n.target)
        ij = ij + 1
    }
    if (mk & 4096) != 0 {
        columns.ints.get(ic).unwrap().set(ij, n.iterable)
        ij = ij + 1
    }
    if (mk & 8192) != 0 {
        columns.ints.get(ic).unwrap().set(ij, n.is_mut)
        ij = ij + 1
