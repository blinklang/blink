import tokens.{TokenKind, is_keyword, token_kind_name}
import ast.{NodeKind, AstNode, ChildWalk, node_child_ids_into, node_unclaimed_child, nk_of, nk_is_typed, nk_bridge_gap, node_kind_name, trace, trace_mode}
import lexer.{tokens}
import diagnostics.{
    Diag, diag_error, diag_error_range, diag_source_file,
    diag_count, diag_entry_count, diag_truncate,
    INLINE_MODULE_NOT_SUPPORTED, UNEXPECTED_ANNOTATION, UNEXPECTED_TOKEN,
    UNEXPECTED_TOKEN_STRING, UNEXPECTED_TOKEN_PATTERN, KEYWORD_AS_IDENTIFIER,
    EMPTY_BRACE_EXPR, UNKNOWN_INTRINSIC, MUT_FIELD_NOT_SUPPORTED,
    INVALID_STRING_BACKED_ENUM, INTERP_PARSE_FAILURE,
    TEST_ANNOTATED_RETURN, ELEMENT_ACCESS_HELP,
}

effect Parse {
    effect Advance
    effect Build
}

// parser.bl — Self-hosting recursive descent parser for Blink
//
// Port of src/pact/parser.py. Token input arrives as a List[Token]
// from the lexer. AST output is a node pool indexed by node ID.

// ── Node pool ──────────────────────────────────────────────────────
// Each node is an index into the pool. -1 means "no node".
// A node stores only the fields it holds: a field that still holds its AstNode default
// takes no space. Which fields a node holds is its shape, interned in a table. A node of most
// kinds holds three or four fields of the 57, and one kind has many sets of fields (a fn
// with or without a return type, pub or not), so a shape per node, not one per kind.
// `at_<field>[shape]` is the field's offset in the node's Int or Str payload, or -1 when the
// shape does not hold it and a read answers `node_blank`'s value.
// Nodes sit in chunks of 4096 ids. Chunk c of `ints` holds the head word of each of its
// nodes at [0, 4096) and their Int payloads after that, and chunk c of `strs` holds their
// Str payloads. A head word is (str_off << 40) | (int_off << 16) | shape, both offsets into
// the node's own chunks, so a read finds the chunk from the id alone and goes from the head
// word to the field with one more load: no load waits on a payload address read from
// another arena. Int and Str data stay in separate lists because a List[Int] buffer is
// allocated pointer-free, so the collector never scans the Int chunks.
// A chunk is made with room for its predecessor's payload and an eighth more, since a chunk
// that grows past its room is copied to one twice its size.
// A write that gives a node a field its shape does not hold moves the node's whole payload
// to its chunks' ends under a wider shape; the old payload stays unread. Shapes only widen,
// so a held field written back to its default keeps its slot. A field that a later pass
// writes on nearly every node of a kind is in the node's shape from its push
// (`node_kind_fields`), so that pass moves no payloads into chunks that are already full.
// `kind` is in one flat list since almost every walk of the tree reads it and a read through
// a chunk must load the chunk's own header first; `child_at` is in chunks of 4096.
// Only node_push, node_pop, node_replace, node_write_plain_int, node_write_plain_str,
// parser_reset and the helpers they call write the pool.
// `child_slots`: each node's children as ChildWalk.Slots writes them, one run per node. A
// sublist stays one slot and is expanded when read, so a member appended to a sublist after
// its owner exists is still seen.
// `child_at`: where node id's run in child_slots starts and how long it is, packed as
// start << 8 | count. A write that changes a node's children appends a new run and leaves
// the old one unread.
type NodeColumns {
    count: Int
    kind: List[Int]
    ints: List[List[Int]]
    strs: List[List[Str]]
    shape_mask: List[Int]
    shape_ints: List[Int]
    shape_strs: List[Int]
    // Offset of field f in shape s's payload at s * 56 + f, f in mask-bit order.
    shape_slot: List[Int]
    shape_of_mask: Map[Int, Int]
    // (mask, shape) of the last shape made for a kind, at (kind & 255) * 2: nodes of a kind
    // mostly repeat one shape, and the memo saves the map lookup for them.
    shape_memo: List[Int]
    at_str_val: List[Int]
    at_name: List[Int]
    at_op: List[Int]
    at_var_name: List[Int]
    at_module: List[Int]
    at_method: List[Int]
    at_return_type: List[Int]
    at_type_name: List[Int]
    at_trait_name: List[Int]
    at_leading_comments: List[Int]
    at_trailing_comments: List[Int]
    at_doc_comment: List[Int]
    at_xfail_reason: List[Int]
    at_int_val: List[Int]
    at_left: List[Int]
    at_right: List[Int]
    at_body: List[Int]
    at_condition: List[Int]
    at_then_body: List[Int]
    at_else_body: List[Int]
    at_scrutinee: List[Int]
    at_pattern: List[Int]
    at_guard: List[Int]
    at_value: List[Int]
    at_target: List[Int]
    at_iterable: List[Int]
    at_is_mut: List[Int]
    at_is_pub: List[Int]
    at_is_const: List[Int]
    at_inclusive: List[Int]
    at_start: List[Int]
    at_end: List[Int]
    at_obj: List[Int]
    at_index: List[Int]
    at_params: List[Int]
    at_args: List[Int]
    at_stmts: List[Int]
    at_arms: List[Int]
    at_fields: List[Int]
    at_elements: List[Int]
    at_methods: List[Int]
    at_type_params: List[Int]
    at_effects: List[Int]
    at_captures: List[Int]
    at_type_ann: List[Int]
    at_handlers: List[Int]
    at_line: List[Int]
    at_col: List[Int]
    at_end_line: List[Int]
    at_end_col: List[Int]
    at_assoc_types: List[Int]
    at_impl_binders: List[Int]
    at_recv_type_args: List[Int]
    at_impl_where_bounds: List[Int]
    at_for_binder: List[Int]
    at_supertraits: List[Int]
    child_at: List[List[Int]]
    child_slots: List[Int]
}

// The value of every field a node does not hold.
let node_blank: AstNode = AstNode {}

fn node_columns_empty() -> NodeColumns {
    let mut memo: List[Int] = List.with_capacity(512)
    while memo.len() < 512 { memo.push(-1) }
    NodeColumns { count: 0, kind: [], ints: [], strs: [], shape_mask: [], shape_ints: [], shape_strs: [], shape_slot: [], shape_of_mask: Map(), shape_memo: memo, at_str_val: [], at_name: [], at_op: [], at_var_name: [], at_module: [], at_method: [], at_return_type: [], at_type_name: [], at_trait_name: [], at_leading_comments: [], at_trailing_comments: [], at_doc_comment: [], at_xfail_reason: [], at_int_val: [], at_left: [], at_right: [], at_body: [], at_condition: [], at_then_body: [], at_else_body: [], at_scrutinee: [], at_pattern: [], at_guard: [], at_value: [], at_target: [], at_iterable: [], at_is_mut: [], at_is_pub: [], at_is_const: [], at_inclusive: [], at_start: [], at_end: [], at_obj: [], at_index: [], at_params: [], at_args: [], at_stmts: [], at_arms: [], at_fields: [], at_elements: [], at_methods: [], at_type_params: [], at_effects: [], at_captures: [], at_type_ann: [], at_handlers: [], at_line: [], at_col: [], at_end_line: [], at_end_col: [], at_assoc_types: [], at_impl_binders: [], at_recv_type_args: [], at_impl_where_bounds: [], at_for_binder: [], at_supertraits: [], child_at: [], child_slots: [] }
}

let mut columns: NodeColumns = node_columns_empty()

// Sublists: for lists of node references (params, args, stmts, etc.). Every closed sublist is
// a run of `arena`, so a read is one load chain, not one through a List per sublist; `start`
// and `len` hold the run of each sublist id. Sublists nest while a parse runs, so an open one
// cannot grow in place in the arena: it builds in `scratch` at its depth on the `open` stack,
// and its start reads -2 - depth until finalize_sublist copies it to the arena end. Its length
// stays live so a read before finalize still reads right.
type SublistPool {
    arena: List[Int]
    start: List[Int]
    len: List[Int]
    open: List[Int]
    scratch: List[List[Int]]
}

let mut sublists: SublistPool = SublistPool { arena: [], start: [], len: [], open: [], scratch: [] }

let mut annotation_nodes: List[Int] = []
let mut program_annotation_nodes: List[Int] = []

// `@expect_panic` desugars to a real AssertPanics node during parse so the
// compile path gets all the assert_panics machinery for free. The FORMAT path
// disables it (set to 0 before parse_program, restored after) so the formatter
// round-trips the original `@expect_panic` surface syntax instead of printing
// the desugared `assert_panics` body — which would otherwise double-wrap on the
// next format and is non-idempotent.
pub let mut parse_desugar_enabled: Int = 1

// Side table: dotted-path-derived module key per top-level decl node.
// Populated during merge_programs from the import graph. Used by
// codegen's archive-mode emission filter to route decls by source
// of origin. blink_map keys must be const char*, so the node id is
// stringified.
pub let mut source_module_for_node: Map[Int, Str] = Map()

pub fn parser_reset() {
    columns = node_columns_empty()
    sublists = SublistPool { arena: [], start: [], len: [], open: [], scratch: [] }
    annotation_nodes.clear()
    program_annotation_nodes.clear()
    source_module_for_node.clear()
    pos = 0
    parse_desugar_enabled = 1
}

pub fn record_source_module(node_id: Int, key: Str) {
    source_module_for_node.insert(node_id, key)
}

pub fn node_source_module(id: Int) -> Str {
    match source_module_for_node.get(id) {
        Some(key) => key
        None => {
            node_get_str(checked_node_id(id, "node_source_module"), columns.at_module, node_blank.module)
        }
    }
}

pub fn new_node(kind: NodeKind) -> Int ! Parse.Build {
    node_push(AstNode { kind: kind, line: peek_line(), col: peek_col() })
}

// The fields of `n` that differ from their default, one bit per field: Int fields from bit
// 0 in AstNode order, then Str fields from bit 43.
fn node_mask(n: AstNode) -> Int {
    let mut m = 0
    if n.int_val != node_blank.int_val { m = m | 1 }
    if n.left != node_blank.left { m = m | 2 }
    if n.right != node_blank.right { m = m | 4 }
    if n.body != node_blank.body { m = m | 8 }
    if n.condition != node_blank.condition { m = m | 16 }
    if n.then_body != node_blank.then_body { m = m | 32 }
    if n.else_body != node_blank.else_body { m = m | 64 }
    if n.scrutinee != node_blank.scrutinee { m = m | 128 }
    if n.pattern != node_blank.pattern { m = m | 256 }
    if n.guard != node_blank.guard { m = m | 512 }
    if n.value != node_blank.value { m = m | 1024 }
    if n.target != node_blank.target { m = m | 2048 }
    if n.iterable != node_blank.iterable { m = m | 4096 }
    if n.is_mut != node_blank.is_mut { m = m | 8192 }
    if n.is_pub != node_blank.is_pub { m = m | 16384 }
    if n.is_const != node_blank.is_const { m = m | 32768 }
    if n.inclusive != node_blank.inclusive { m = m | 65536 }
    if n.start != node_blank.start { m = m | 131072 }
    if n.end != node_blank.end { m = m | 262144 }
    if n.obj != node_blank.obj { m = m | 524288 }
    if n.index != node_blank.index { m = m | 1048576 }
    if n.params != node_blank.params { m = m | 2097152 }
    if n.args != node_blank.args { m = m | 4194304 }
    if n.stmts != node_blank.stmts { m = m | 8388608 }
    if n.arms != node_blank.arms { m = m | 16777216 }
    if n.fields != node_blank.fields { m = m | 33554432 }
    if n.elements != node_blank.elements { m = m | 67108864 }
    if n.methods != node_blank.methods { m = m | 134217728 }
    if n.type_params != node_blank.type_params { m = m | 268435456 }
    if n.effects != node_blank.effects { m = m | 536870912 }
    if n.captures != node_blank.captures { m = m | 1073741824 }
    if n.type_ann != node_blank.type_ann { m = m | 2147483648 }
    if n.handlers != node_blank.handlers { m = m | 4294967296 }
    if n.line != node_blank.line { m = m | 8589934592 }
    if n.col != node_blank.col { m = m | 17179869184 }
    if n.end_line != node_blank.end_line { m = m | 34359738368 }
    if n.end_col != node_blank.end_col { m = m | 68719476736 }
    if n.assoc_types != node_blank.assoc_types { m = m | 137438953472 }
    if n.impl_binders != node_blank.impl_binders { m = m | 274877906944 }
    if n.recv_type_args != node_blank.recv_type_args { m = m | 549755813888 }
    if n.impl_where_bounds != node_blank.impl_where_bounds { m = m | 1099511627776 }
    if n.for_binder != node_blank.for_binder { m = m | 2199023255552 }
    if n.supertraits != node_blank.supertraits { m = m | 4398046511104 }
    if n.str_val != node_blank.str_val { m = m | 8796093022208 }
    if n.name != node_blank.name { m = m | 17592186044416 }
    if n.op != node_blank.op { m = m | 35184372088832 }
    if n.var_name != node_blank.var_name { m = m | 70368744177664 }
    if n.module != node_blank.module { m = m | 140737488355328 }
    if n.method != node_blank.method { m = m | 281474976710656 }
    if n.return_type != node_blank.return_type { m = m | 562949953421312 }
    if n.type_name != node_blank.type_name { m = m | 1125899906842624 }
    if n.trait_name != node_blank.trait_name { m = m | 2251799813685248 }
    if n.leading_comments != node_blank.leading_comments { m = m | 4503599627370496 }
    if n.trailing_comments != node_blank.trailing_comments { m = m | 9007199254740992 }
    if n.doc_comment != node_blank.doc_comment { m = m | 18014398509481984 }
    if n.xfail_reason != node_blank.xfail_reason { m = m | 36028797018963968 }
    m
}

// The shape whose fields are the bits of `m`, made on first use.
fn node_shape(m: Int, kind: Int) -> Int {
    let k = (kind & 255) * 2
    if columns.shape_memo[k] == m { return columns.shape_memo[k + 1] }
    let s = match columns.shape_of_mask.get(m) {
        Some(found) => found
        None => node_shape_new(m)
    }
    columns.shape_memo.set(k, m)
    columns.shape_memo.set(k + 1, s)
    s
}

fn node_shape_new(m: Int) -> Int {
    let s = columns.shape_mask.len()
    if s > 65535 {
        io.println("FATAL: the node pool has more than 65536 shapes; head packs at most that")
        exit(1)
    }
    let base = s * 56
    let mut bit = 1
    let mut ioff = 0
    let mut soff = 0
    let mut f = 0
    while f < 56 {
        if (m & bit) == 0 {
            columns.shape_slot.push(-1)
        } else if f < 43 {
            columns.shape_slot.push(ioff)
            ioff = ioff + 1
        } else {
            columns.shape_slot.push(soff)
            soff = soff + 1
        }
        bit = bit * 2
        f = f + 1
    }
    columns.shape_mask.push(m)
    columns.shape_ints.push(ioff)
    columns.shape_strs.push(soff)
    columns.at_str_val.push(columns.shape_slot[base + 43])
    columns.at_name.push(columns.shape_slot[base + 44])
    columns.at_op.push(columns.shape_slot[base + 45])
    columns.at_var_name.push(columns.shape_slot[base + 46])
    columns.at_module.push(columns.shape_slot[base + 47])
    columns.at_method.push(columns.shape_slot[base + 48])
    columns.at_return_type.push(columns.shape_slot[base + 49])
    columns.at_type_name.push(columns.shape_slot[base + 50])
    columns.at_trait_name.push(columns.shape_slot[base + 51])
    columns.at_leading_comments.push(columns.shape_slot[base + 52])
    columns.at_trailing_comments.push(columns.shape_slot[base + 53])
    columns.at_doc_comment.push(columns.shape_slot[base + 54])
    columns.at_xfail_reason.push(columns.shape_slot[base + 55])
    columns.at_int_val.push(columns.shape_slot[base + 0])
    columns.at_left.push(columns.shape_slot[base + 1])
    columns.at_right.push(columns.shape_slot[base + 2])
    columns.at_body.push(columns.shape_slot[base + 3])
    columns.at_condition.push(columns.shape_slot[base + 4])
    columns.at_then_body.push(columns.shape_slot[base + 5])
    columns.at_else_body.push(columns.shape_slot[base + 6])
    columns.at_scrutinee.push(columns.shape_slot[base + 7])
    columns.at_pattern.push(columns.shape_slot[base + 8])
    columns.at_guard.push(columns.shape_slot[base + 9])
    columns.at_value.push(columns.shape_slot[base + 10])
    columns.at_target.push(columns.shape_slot[base + 11])
    columns.at_iterable.push(columns.shape_slot[base + 12])
    columns.at_is_mut.push(columns.shape_slot[base + 13])
    columns.at_is_pub.push(columns.shape_slot[base + 14])
    columns.at_is_const.push(columns.shape_slot[base + 15])
    columns.at_inclusive.push(columns.shape_slot[base + 16])
    columns.at_start.push(columns.shape_slot[base + 17])
    columns.at_end.push(columns.shape_slot[base + 18])
    columns.at_obj.push(columns.shape_slot[base + 19])
    columns.at_index.push(columns.shape_slot[base + 20])
    columns.at_params.push(columns.shape_slot[base + 21])
    columns.at_args.push(columns.shape_slot[base + 22])
    columns.at_stmts.push(columns.shape_slot[base + 23])
    columns.at_arms.push(columns.shape_slot[base + 24])
    columns.at_fields.push(columns.shape_slot[base + 25])
    columns.at_elements.push(columns.shape_slot[base + 26])
    columns.at_methods.push(columns.shape_slot[base + 27])
    columns.at_type_params.push(columns.shape_slot[base + 28])
    columns.at_effects.push(columns.shape_slot[base + 29])
    columns.at_captures.push(columns.shape_slot[base + 30])
    columns.at_type_ann.push(columns.shape_slot[base + 31])
    columns.at_handlers.push(columns.shape_slot[base + 32])
    columns.at_line.push(columns.shape_slot[base + 33])
    columns.at_col.push(columns.shape_slot[base + 34])
    columns.at_end_line.push(columns.shape_slot[base + 35])
    columns.at_end_col.push(columns.shape_slot[base + 36])
    columns.at_assoc_types.push(columns.shape_slot[base + 37])
    columns.at_impl_binders.push(columns.shape_slot[base + 38])
    columns.at_recv_type_args.push(columns.shape_slot[base + 39])
    columns.at_impl_where_bounds.push(columns.shape_slot[base + 40])
    columns.at_for_binder.push(columns.shape_slot[base + 41])
    columns.at_supertraits.push(columns.shape_slot[base + 42])
    columns.shape_of_mask.insert(m, s)
    s
}

// Appends `n`'s fields of shape `s` to the ends of node chunk `c` and returns the head word
// that addresses them.
fn node_store(n: AstNode, s: Int, c: Int) -> Int {
    let mk = columns.shape_mask[s]
    let ib = columns.ints[c].len()
    let sb = columns.strs[c].len()
    if ib + columns.shape_ints[s] >= 16777216 || sb + columns.shape_strs[s] >= 8388608 {
        io.eprintln("FATAL: node chunk {c} holds more payload than a head word addresses")
        exit(1)
    }
    if (mk & 8796093022208) != 0 { columns.strs[c].push(n.str_val) }
    if (mk & 17592186044416) != 0 { columns.strs[c].push(n.name) }
    if (mk & 35184372088832) != 0 { columns.strs[c].push(n.op) }
    if (mk & 70368744177664) != 0 { columns.strs[c].push(n.var_name) }
    if (mk & 140737488355328) != 0 { columns.strs[c].push(n.module) }
    if (mk & 281474976710656) != 0 { columns.strs[c].push(n.method) }
    if (mk & 562949953421312) != 0 { columns.strs[c].push(n.return_type) }
    if (mk & 1125899906842624) != 0 { columns.strs[c].push(n.type_name) }
    if (mk & 2251799813685248) != 0 { columns.strs[c].push(n.trait_name) }
    if (mk & 4503599627370496) != 0 { columns.strs[c].push(n.leading_comments) }
    if (mk & 9007199254740992) != 0 { columns.strs[c].push(n.trailing_comments) }
    if (mk & 18014398509481984) != 0 { columns.strs[c].push(n.doc_comment) }
    if (mk & 36028797018963968) != 0 { columns.strs[c].push(n.xfail_reason) }
    if (mk & 1) != 0 { columns.ints[c].push(n.int_val) }
    if (mk & 2) != 0 { columns.ints[c].push(n.left) }
    if (mk & 4) != 0 { columns.ints[c].push(n.right) }
    if (mk & 8) != 0 { columns.ints[c].push(n.body) }
    if (mk & 16) != 0 { columns.ints[c].push(n.condition) }
    if (mk & 32) != 0 { columns.ints[c].push(n.then_body) }
    if (mk & 64) != 0 { columns.ints[c].push(n.else_body) }
    if (mk & 128) != 0 { columns.ints[c].push(n.scrutinee) }
    if (mk & 256) != 0 { columns.ints[c].push(n.pattern) }
    if (mk & 512) != 0 { columns.ints[c].push(n.guard) }
    if (mk & 1024) != 0 { columns.ints[c].push(n.value) }
    if (mk & 2048) != 0 { columns.ints[c].push(n.target) }
    if (mk & 4096) != 0 { columns.ints[c].push(n.iterable) }
    if (mk & 8192) != 0 { columns.ints[c].push(n.is_mut) }
    if (mk & 16384) != 0 { columns.ints[c].push(n.is_pub) }
    if (mk & 32768) != 0 { columns.ints[c].push(n.is_const) }
    if (mk & 65536) != 0 { columns.ints[c].push(n.inclusive) }
    if (mk & 131072) != 0 { columns.ints[c].push(n.start) }
    if (mk & 262144) != 0 { columns.ints[c].push(n.end) }
    if (mk & 524288) != 0 { columns.ints[c].push(n.obj) }
    if (mk & 1048576) != 0 { columns.ints[c].push(n.index) }
    if (mk & 2097152) != 0 { columns.ints[c].push(n.params) }
    if (mk & 4194304) != 0 { columns.ints[c].push(n.args) }
    if (mk & 8388608) != 0 { columns.ints[c].push(n.stmts) }
    if (mk & 16777216) != 0 { columns.ints[c].push(n.arms) }
    if (mk & 33554432) != 0 { columns.ints[c].push(n.fields) }
    if (mk & 67108864) != 0 { columns.ints[c].push(n.elements) }
    if (mk & 134217728) != 0 { columns.ints[c].push(n.methods) }
    if (mk & 268435456) != 0 { columns.ints[c].push(n.type_params) }
    if (mk & 536870912) != 0 { columns.ints[c].push(n.effects) }
    if (mk & 1073741824) != 0 { columns.ints[c].push(n.captures) }
    if (mk & 2147483648) != 0 { columns.ints[c].push(n.type_ann) }
    if (mk & 4294967296) != 0 { columns.ints[c].push(n.handlers) }
    if (mk & 8589934592) != 0 { columns.ints[c].push(n.line) }
    if (mk & 17179869184) != 0 { columns.ints[c].push(n.col) }
    if (mk & 34359738368) != 0 { columns.ints[c].push(n.end_line) }
    if (mk & 68719476736) != 0 { columns.ints[c].push(n.end_col) }
    if (mk & 137438953472) != 0 { columns.ints[c].push(n.assoc_types) }
    if (mk & 274877906944) != 0 { columns.ints[c].push(n.impl_binders) }
    if (mk & 549755813888) != 0 { columns.ints[c].push(n.recv_type_args) }
    if (mk & 1099511627776) != 0 { columns.ints[c].push(n.impl_where_bounds) }
    if (mk & 2199023255552) != 0 { columns.ints[c].push(n.for_binder) }
    if (mk & 4398046511104) != 0 { columns.ints[c].push(n.supertraits) }
    (sb << 40) | (ib << 16) | s
}

// Writes every field shape `s` holds from `n`, over the payload that head word `h` of a
// node in chunk `c` addresses.
fn node_overwrite(n: AstNode, s: Int, h: Int, c: Int) {
    let mk = columns.shape_mask[s]
    let ic = c
    let mut ij = (h >> 16) & 16777215
    if columns.shape_strs[s] > 0 {
        let sc = c
        let mut sj = h >> 40
        if (mk & 8796093022208) != 0 {
            columns.strs[sc].set(sj, n.str_val)
            sj = sj + 1
        }
        if (mk & 17592186044416) != 0 {
            columns.strs[sc].set(sj, n.name)
            sj = sj + 1
        }
        if (mk & 35184372088832) != 0 {
            columns.strs[sc].set(sj, n.op)
            sj = sj + 1
        }
        if (mk & 70368744177664) != 0 {
            columns.strs[sc].set(sj, n.var_name)
            sj = sj + 1
        }
        if (mk & 140737488355328) != 0 {
            columns.strs[sc].set(sj, n.module)
            sj = sj + 1
        }
        if (mk & 281474976710656) != 0 {
            columns.strs[sc].set(sj, n.method)
            sj = sj + 1
        }
        if (mk & 562949953421312) != 0 {
            columns.strs[sc].set(sj, n.return_type)
            sj = sj + 1
        }
        if (mk & 1125899906842624) != 0 {
            columns.strs[sc].set(sj, n.type_name)
            sj = sj + 1
        }
        if (mk & 2251799813685248) != 0 {
            columns.strs[sc].set(sj, n.trait_name)
            sj = sj + 1
        }
        if (mk & 4503599627370496) != 0 {
            columns.strs[sc].set(sj, n.leading_comments)
            sj = sj + 1
        }
        if (mk & 9007199254740992) != 0 {
            columns.strs[sc].set(sj, n.trailing_comments)
            sj = sj + 1
        }
        if (mk & 18014398509481984) != 0 {
            columns.strs[sc].set(sj, n.doc_comment)
            sj = sj + 1
        }
        if (mk & 36028797018963968) != 0 {
            columns.strs[sc].set(sj, n.xfail_reason)
            sj = sj + 1
        }
    }
    if (mk & 1) != 0 {
        columns.ints[ic].set(ij, n.int_val)
        ij = ij + 1
    }
    if (mk & 2) != 0 {
        columns.ints[ic].set(ij, n.left)
        ij = ij + 1
    }
    if (mk & 4) != 0 {
        columns.ints[ic].set(ij, n.right)
        ij = ij + 1
    }
    if (mk & 8) != 0 {
        columns.ints[ic].set(ij, n.body)
        ij = ij + 1
    }
    if (mk & 16) != 0 {
        columns.ints[ic].set(ij, n.condition)
        ij = ij + 1
    }
    if (mk & 32) != 0 {
        columns.ints[ic].set(ij, n.then_body)
        ij = ij + 1
    }
    if (mk & 64) != 0 {
        columns.ints[ic].set(ij, n.else_body)
        ij = ij + 1
    }
    if (mk & 128) != 0 {
        columns.ints[ic].set(ij, n.scrutinee)
        ij = ij + 1
    }
    if (mk & 256) != 0 {
        columns.ints[ic].set(ij, n.pattern)
        ij = ij + 1
    }
    if (mk & 512) != 0 {
        columns.ints[ic].set(ij, n.guard)
        ij = ij + 1
    }
    if (mk & 1024) != 0 {
        columns.ints[ic].set(ij, n.value)
        ij = ij + 1
    }
    if (mk & 2048) != 0 {
        columns.ints[ic].set(ij, n.target)
        ij = ij + 1
    }
    if (mk & 4096) != 0 {
        columns.ints[ic].set(ij, n.iterable)
        ij = ij + 1
    }
    if (mk & 8192) != 0 {
        columns.ints[ic].set(ij, n.is_mut)
        ij = ij + 1
    }
    if (mk & 16384) != 0 {
        columns.ints[ic].set(ij, n.is_pub)
        ij = ij + 1
    }
    if (mk & 32768) != 0 {
        columns.ints[ic].set(ij, n.is_const)
        ij = ij + 1
    }
    if (mk & 65536) != 0 {
        columns.ints[ic].set(ij, n.inclusive)
        ij = ij + 1
    }
    if (mk & 131072) != 0 {
        columns.ints[ic].set(ij, n.start)
        ij = ij + 1
    }
    if (mk & 262144) != 0 {
        columns.ints[ic].set(ij, n.end)
        ij = ij + 1
    }
    if (mk & 524288) != 0 {
        columns.ints[ic].set(ij, n.obj)
        ij = ij + 1
    }
    if (mk & 1048576) != 0 {
        columns.ints[ic].set(ij, n.index)
        ij = ij + 1
    }
    if (mk & 2097152) != 0 {
        columns.ints[ic].set(ij, n.params)
        ij = ij + 1
    }
    if (mk & 4194304) != 0 {
        columns.ints[ic].set(ij, n.args)
        ij = ij + 1
    }
    if (mk & 8388608) != 0 {
        columns.ints[ic].set(ij, n.stmts)
        ij = ij + 1
    }
    if (mk & 16777216) != 0 {
        columns.ints[ic].set(ij, n.arms)
        ij = ij + 1
    }
    if (mk & 33554432) != 0 {
        columns.ints[ic].set(ij, n.fields)
        ij = ij + 1
    }
    if (mk & 67108864) != 0 {
        columns.ints[ic].set(ij, n.elements)
        ij = ij + 1
    }
    if (mk & 134217728) != 0 {
        columns.ints[ic].set(ij, n.methods)
        ij = ij + 1
    }
    if (mk & 268435456) != 0 {
        columns.ints[ic].set(ij, n.type_params)
        ij = ij + 1
    }
    if (mk & 536870912) != 0 {
        columns.ints[ic].set(ij, n.effects)
        ij = ij + 1
    }
    if (mk & 1073741824) != 0 {
        columns.ints[ic].set(ij, n.captures)
        ij = ij + 1
    }
    if (mk & 2147483648) != 0 {
        columns.ints[ic].set(ij, n.type_ann)
        ij = ij + 1
    }
    if (mk & 4294967296) != 0 {
        columns.ints[ic].set(ij, n.handlers)
        ij = ij + 1
    }
    if (mk & 8589934592) != 0 {
        columns.ints[ic].set(ij, n.line)
        ij = ij + 1
    }
    if (mk & 17179869184) != 0 {
        columns.ints[ic].set(ij, n.col)
        ij = ij + 1
    }
    if (mk & 34359738368) != 0 {
        columns.ints[ic].set(ij, n.end_line)
        ij = ij + 1
    }
    if (mk & 68719476736) != 0 {
        columns.ints[ic].set(ij, n.end_col)
        ij = ij + 1
    }
    if (mk & 137438953472) != 0 {
        columns.ints[ic].set(ij, n.assoc_types)
        ij = ij + 1
    }
    if (mk & 274877906944) != 0 {
        columns.ints[ic].set(ij, n.impl_binders)
        ij = ij + 1
    }
    if (mk & 549755813888) != 0 {
        columns.ints[ic].set(ij, n.recv_type_args)
        ij = ij + 1
    }
    if (mk & 1099511627776) != 0 {
        columns.ints[ic].set(ij, n.impl_where_bounds)
        ij = ij + 1
    }
    if (mk & 2199023255552) != 0 {
        columns.ints[ic].set(ij, n.for_binder)
        ij = ij + 1
    }
    if (mk & 4398046511104) != 0 {
        columns.ints[ic].set(ij, n.supertraits)
        ij = ij + 1
    }
}

fn node_ints_drop(c: Int, n: Int) {
    let mut k = 0
    while k < n {
        let _ = columns.ints[c].pop()
        k = k + 1
    }
}

fn node_strs_drop(c: Int, n: Int) {
    let mut k = 0
    while k < n {
        let _ = columns.strs[c].pop()
        k = k + 1
    }
}

// The fields a node of `kind` holds from its push whatever their values: a later pass
// writes them on nearly every node of that kind (name resolution the module of each binding,
// comment attachment and pub marking a fn's), and a write outside the shape would move the
// node's payload into a chunk already full.
fn node_kind_fields(kind: Int) -> Int {
    if kind == NodeKind.FnDef { return 4644337115742208 }
    if kind == NodeKind.LetBinding || kind == NodeKind.Param || kind == NodeKind.ForIn { return 140737488355328 }
    0
}

// Appends `n` to the pool and returns its id.
pub fn node_push(n: AstNode) -> Int {
    let id = columns.count
    let c = id >> 12
    if (id & 4095) == 0 {
        let mut iroom = 12288
        let mut sroom = 4096
        if c > 0 {
            let iused = columns.ints[c - 1].len() - 4096
            let sused = columns.strs[c - 1].len()
            iroom = iused + iused / 8 + 256
            sroom = sused + sused / 8 + 64
        }
        columns.ints.push(List.with_capacity(4096 + iroom))
        let mut k = 0
        while k < 4096 {
            columns.ints[c].push(0)
            k = k + 1
        }
        columns.strs.push(List.with_capacity(sroom))
        columns.child_at.push(List.with_capacity(4096))
    }
    let s = node_shape(node_mask(n) | node_kind_fields(n.kind), n.kind)
    columns.ints[c].set(id & 4095, node_store(n, s, c))
    columns.kind.push(n.kind)
    let start = columns.child_slots.len()
    node_child_ids_into(n, ChildWalk.Slots, columns.child_slots)
    columns.child_at[c].push(node_child_run(id, start))
    columns.count = id + 1
    id
}

// Drops the newest node, as a caller that made a scratch node does to give its id back.
// Its payload is given back only when it is still at its chunks' ends: a node written to
// after this one was pushed moved its payload past this one's.
pub fn node_pop() {
    if columns.count == 0 { return }
    let id = columns.count - 1
    let c = id >> 12
    let h = columns.ints[c][id & 4095]
    let s = h & 65535
    let ni = columns.shape_ints[s]
    let ns = columns.shape_strs[s]
    if ns > 0 && (h >> 40) + ns == columns.strs[c].len() { node_strs_drop(c, ns) }
    if ni > 0 && ((h >> 16) & 16777215) + ni == columns.ints[c].len() { node_ints_drop(c, ni) }
    let _ = columns.kind.pop()
    let at = columns.child_at[c].pop() ?? 0
    columns.count = id
    if (id & 4095) == 0 {
        let _ = columns.ints.pop()
        let _ = columns.strs.pop()
        let _ = columns.child_at.pop()
    }
    if (at >> 8) + (at & 255) == columns.child_slots.len() {
        node_drop_child_slots_from(at >> 8)
    }
}

fn node_replace(id: Int, n: AstNode) {
    let c = id >> 12
    let j = id & 4095
    let h = columns.ints[c][j]
    let s = h & 65535
    let held = columns.shape_mask[s]
    let m = node_mask(n)
    if (m & held) == m {
        node_overwrite(n, s, h, c)
    } else {
        let s2 = node_shape(m | held, n.kind)
        columns.ints[c].set(j, node_store(n, s2, c))
    }
    columns.kind.set(id, n.kind)
    // Most setters change a field that is not a child, so a run equal to the old one is
    // dropped again instead of growing the column on every write.
    let old = columns.child_at[c][j]
    let start = columns.child_slots.len()
    node_child_ids_into(n, ChildWalk.Slots, columns.child_slots)
    let at = node_child_run(id, start)
    if node_child_runs_equal(old, at) {
        node_drop_child_slots_from(at >> 8)
    } else {
        columns.child_at[c].set(j, at)
    }
}

// Moves node `i`'s payload to a shape that also holds the field of mask bit `bit`, which
// reads its default.
fn node_widen(i: Int, bit: Int) {
    let c = i >> 12
    let j = i & 4095
    let s = columns.ints[c][j] & 65535
    let s2 = node_shape(columns.shape_mask[s] | bit, columns.kind[i])
    columns.ints[c].set(j, node_store(node_or_die(i, "node_widen"), s2, c))
}

// `i` is checked; `f` is the field's index in mask-bit order, `bit` its mask bit and `dflt`
// its default.
fn node_write_int(i: Int, f: Int, bit: Int, dflt: Int, val: Int) {
    let c = i >> 12
    let j = i & 4095
    let mut h = columns.ints[c][j]
    let mut o = columns.shape_slot[(h & 65535) * 56 + f]
    if o < 0 {
        if val == dflt { return }
        node_widen(i, bit)
        h = columns.ints[c][j]
        o = columns.shape_slot[(h & 65535) * 56 + f]
    }
    columns.ints[c].set(((h >> 16) & 16777215) + o, val)
}

fn node_write_str(i: Int, f: Int, bit: Int, dflt: Str, val: Str) {
    let c = i >> 12
    let j = i & 4095
    let mut h = columns.ints[c][j]
    let mut o = columns.shape_slot[(h & 65535) * 56 + f]
    if o < 0 {
        if val == dflt { return }
        node_widen(i, bit)
        h = columns.ints[c][j]
        o = columns.shape_slot[(h & 65535) * 56 + f]
    }
    columns.strs[c].set((h >> 40) + o, val)
}

// Field reads for node `i` (checked) through the field's `at` table.
fn node_get_int(i: Int, at: List[Int], dflt: Int) -> Int {
    let chunk = columns.ints[i >> 12]
    let h = chunk[i & 4095]
    let o = at[h & 65535]
    if o < 0 { return dflt }
    chunk[((h >> 16) & 16777215) + o]
}

fn node_get_str(i: Int, at: List[Int], dflt: Str) -> Str {
    let c = i >> 12
    let h = columns.ints[c][i & 4095]
    let o = at[h & 65535]
    if o < 0 { return dflt }
    columns.strs[c][(h >> 40) + o]
}

// The fields a setter writes in place: the child table reads none of them for any kind, so
// a write leaves the node's child slots right without a walk of the table. A field the table
// reads goes through node_replace, which walks the table again. A test runs every setter of
// these fields over every kind against the table.
type NodePlainInt {
    IntVal, IsPub, Line, Col, EndLine, EndCol, IsMut, IsConst, Inclusive
}

type NodePlainStr {
    StrVal, Module, TypeName, LeadingComments, TrailingComments, DocComment, Op, VarName, Method, ReturnType, TraitName
}

// `id` is already checked.
fn node_write_plain_int(id: Int, f: NodePlainInt, val: Int) {
    match f {
        NodePlainInt.IntVal => node_write_int(id, 0, 1, node_blank.int_val, val)
        NodePlainInt.IsPub => node_write_int(id, 14, 16384, node_blank.is_pub, val)
        NodePlainInt.Line => node_write_int(id, 33, 8589934592, node_blank.line, val)
        NodePlainInt.Col => node_write_int(id, 34, 17179869184, node_blank.col, val)
        NodePlainInt.EndLine => node_write_int(id, 35, 34359738368, node_blank.end_line, val)
        NodePlainInt.EndCol => node_write_int(id, 36, 68719476736, node_blank.end_col, val)
        NodePlainInt.IsMut => node_write_int(id, 13, 8192, node_blank.is_mut, val)
        NodePlainInt.IsConst => node_write_int(id, 15, 32768, node_blank.is_const, val)
        NodePlainInt.Inclusive => node_write_int(id, 16, 65536, node_blank.inclusive, val)
    }
}

// `id` is already checked.
fn node_write_plain_str(id: Int, f: NodePlainStr, val: Str) {
    match f {
        NodePlainStr.StrVal => node_write_str(id, 43, 8796093022208, node_blank.str_val, val)
        NodePlainStr.Module => node_write_str(id, 47, 140737488355328, node_blank.module, val)
        NodePlainStr.TypeName => node_write_str(id, 50, 1125899906842624, node_blank.type_name, val)
        NodePlainStr.LeadingComments => node_write_str(id, 52, 4503599627370496, node_blank.leading_comments, val)
        NodePlainStr.TrailingComments => node_write_str(id, 53, 9007199254740992, node_blank.trailing_comments, val)
        NodePlainStr.DocComment => node_write_str(id, 54, 18014398509481984, node_blank.doc_comment, val)
        NodePlainStr.Op => node_write_str(id, 45, 35184372088832, node_blank.op, val)
        NodePlainStr.VarName => node_write_str(id, 46, 70368744177664, node_blank.var_name, val)
        NodePlainStr.Method => node_write_str(id, 48, 281474976710656, node_blank.method, val)
        NodePlainStr.ReturnType => node_write_str(id, 49, 562949953421312, node_blank.return_type, val)
        NodePlainStr.TraitName => node_write_str(id, 51, 2251799813685248, node_blank.trait_name, val)
    }
}

// The packed start and count of the run of child slots that node `id`'s walk of the table
// appended from `start` to the tail of child_slots. The writers walk the table themselves:
// AstNode is passed by value, so each function it passes through copies all of it.
fn node_child_run(id: Int, start: Int) -> Int {
    let count = columns.child_slots.len() - start
    if count > 255 {
        io.println("FATAL: node {id} has {count} children; child_at packs at most 255")
        exit(1)
    }
    (start << 8) | count
}

fn node_drop_child_slots_from(start: Int) {
    while columns.child_slots.len() > start {
        let _ = columns.child_slots.pop()
    }
}

fn node_child_runs_equal(a: Int, b: Int) -> Bool {
    let count = a & 255
    if count != (b & 255) { return false }
    let mut i = 0
    while i < count {
        if columns.child_slots[(a >> 8) + i] != columns.child_slots[(b >> 8) + i] { return false }
        i = i + 1
    }
    true
}

// Appends to `out` the children of `id` on one side, read from the node's run of child
// slots. `side` is 0 for value children and 2 for spellings, the slot's spelling bit.
fn node_push_slot_children(id: Int, side: Int, out: List[Int]) {
    let at = columns.child_at[id >> 12][id & 4095]
    let mut i = at >> 8
    let end = i + (at & 255)
    while i < end {
        let slot = columns.child_slots[i]
        if (slot & 2) == side {
            if (slot & 1) == 0 {
                out.push(slot >> 2)
            } else {
                let sl = slot >> 2
                let s = sublists.start[sl]
                let n = sublists.len[sl]
                let mut k = 0
                while k < n {
                    let m = if s >= 0 { sublists.arena[s + k] } else { sublist_get_slow(sl, k) }
                    if m != -1 { out.push(m) }
                    k = k + 1
                }
            }
        }
        i = i + 1
    }
}

pub fn new_sublist() -> Int ! Parse.Build {
    let id = sublists.start.len()
    let depth = sublists.open.len()
    if depth == sublists.scratch.len() {
        let items: List[Int] = []
        sublists.scratch.push(items)
    } else {
        let mut items = sublists.scratch[depth]
        items.clear()
    }
    sublists.start.push(-2 - depth)
    sublists.len.push(0)
    sublists.open.push(id)
    id
}

pub fn sublist_push(sl: Int, node_id: Int) ! Parse.Build {
    if sublists.open.len() == 0 {
        io.println("FATAL: sublist_push() called with no open sublist")
        exit(1)
    }
    sublist_add(sl, node_id)
}

pub fn finalize_sublist(sl: Int) ! Parse.Build {
    if sublists.open.len() == 0 {
        io.println("FATAL: finalize_sublist() called with no open sublist")
        exit(1)
    }
    let top = sublists.open.get(sublists.open.len() - 1).unwrap()
    if top != sl {
        io.println("FATAL: finalize_sublist({sl}) but top of stack is {top}")
        exit(1)
    }
    sublists.open.pop()
    let items = sublists.scratch[sublists.open.len()]
    sublists.start.set(sl, sublists.arena.len())
    for m in items {
        sublists.arena.push(m)
    }
}

// One branch holds every check so the hot path stays small; the read of an open sublist and
// the error report live in sublist_get_slow.
pub fn sublist_get(sl: Int, idx: Int) -> Int {
    let s = sublists.start[sl]
    if s < 0 || idx < 0 || idx >= sublists.len[sl] {
        return sublist_get_slow(sl, idx)
    }
    sublists.arena[s + idx]
}

pub fn sublist_length(sl: Int) -> Int {
    sublists.len[sl]
}

fn sublist_get_slow(sl: Int, idx: Int) -> Int {
    let s = sublists.start[sl]
    let n = sublists.len[sl]
    if idx < 0 || idx >= n {
        io.eprintln("FATAL: sublist_get({sl}, {idx}) out of bounds; sublist length is {n}")
        exit(2)
    }
    if s >= 0 {
        return sublists.arena[s + idx]
    }
    sublists.scratch[-2 - s][idx]
}

// An open sublist grows in its scratch list. A closed one grows at the arena end: in place
// when its run is already last, else after its run is copied there. The old run stays as
// dead space, which is cheap because growth after close is rare.
fn sublist_add(sl: Int, node_id: Int) {
    let s = sublists.start[sl]
    let n = sublists.len[sl]
    if s < 0 {
        let mut items = sublists.scratch[-2 - s]
        items.push(node_id)
    } else {
        if s + n != sublists.arena.len() {
            let dest = sublists.arena.len()
            let mut k = 0
            while k < n {
                sublists.arena.push(sublists.arena[s + k])
                k = k + 1
            }
            sublists.start.set(sl, dest)
        }
        sublists.arena.push(node_id)
    }
    sublists.len.set(sl, n + 1)
}

// Appends to `out` the children of `id` in VALUE position only. A pass that reasons about
// types walks these and stops at a spelling edge, where there is no value and so no type to
// find. A walker that runs over every node passes one list down and reuses it.
pub fn node_push_value_child_ids(id: Int, out: List[Int]) {
    node_push_slot_children(checked_node_id(id, "node_push_value_child_ids"), 0, out)
}

// Appends to `out` the children of `id` that spell a type: annotations, type parameters and
// explicit type arguments. The complement of node_push_value_child_ids.
pub fn node_push_spell_child_ids(id: Int, out: List[Int]) {
    node_push_slot_children(checked_node_id(id, "node_push_spell_child_ids"), 2, out)
}

// The children of `id` in VALUE position, as a new list.
pub fn node_value_child_ids(id: Int) -> List[Int] {
    let mut out: List[Int] = []
    node_push_value_child_ids(id, out)
    out
}

// The children of `id` that spell a type, as a new list.
pub fn node_spell_child_ids(id: Int) -> List[Int] {
    let mut out: List[Int] = []
    node_push_spell_child_ids(id, out)
    out
}

// The field name of a child that node `id`'s kind does not claim, or "" when the kind's arm
// covers every child the node holds.
pub fn node_unclaimed_child_field(id: Int) -> Str {
    node_unclaimed_child(node_or_die(id, "node_unclaimed_child_field"))
}

pub fn get_annotation(node: Int, name: Str) -> Int {
    let anns_sl = node_handlers(node)
    if anns_sl == -1 {
        return -1
    }
    let mut i = 0
    while i < sublist_length(anns_sl) {
        let ann = sublist_get(anns_sl, i)
        if node_name(ann) == name {
            return ann
        }
        i = i + 1
    }
    -1
}

pub fn has_annotation(node: Int, name: Str) -> Int {
    if get_annotation(node, name) != -1 { 1 } else { 0 }
}

pub fn is_literal_string_part(part: Int) -> Int {
    if node_kind(part) == NodeKind.Ident && node_str_val(part) == node_name(part) { 1 } else { 0 }
}

pub fn get_str_named_arg(ann: Int, label: Str) -> Str {
    let args_sl = node_args(ann)
    if args_sl == -1 { return "" }
    let mut i = 0
    while i < sublist_length(args_sl) {
        let arg = sublist_get(args_sl, i)
        if node_kind(arg) == NodeKind.InterpString && node_name(arg) == label {
            let parts_sl = node_elements(arg)
            if parts_sl != -1 && sublist_length(parts_sl) == 1 {
                let part = sublist_get(parts_sl, 0)
                if is_literal_string_part(part) != 0 {
                    return node_str_val(part)
                }
            }
        }
        i = i + 1
    }
    ""
}

// A struct declaration for a type this program never wrote. Typecheck mints a tid for a
// type the runtime defines -- process_run answers ProcessResult in a file that never
// imports std.process -- and every reader past typecheck reaches a struct through its
// declaration node, so the node has to exist. It is built here rather than in typecheck
// because the node pool and its sublists are this module's to extend. It holds no source
// position and joins no open sublist: there is no source and no parse in progress.
// `derives` becomes one @derive annotation, so the traits read the same as on the declaration
// lib/std would have given.
pub fn synth_struct_decl(name: Str, fnames: List[Str], ftypes: List[Str], derives: List[Str]) -> Int {
    let mut items: List[Int] = []
    let mut i = 0
    while i < fnames.len() {
        let ta = node_count()
        node_push(AstNode { kind: NodeKind.TypeAnn, name: ftypes.get(i).unwrap(), line: 0, col: 0 })
        let tf = node_count()
        node_push(AstNode { kind: NodeKind.TypeField, name: fnames.get(i).unwrap(), value: ta, condition: -1, line: 0, col: 0 })
        items.push(tf)
        i = i + 1
    }
    let flds = sublist_of(items)
    let mut anns = -1
    if derives.len() > 0 {
        let mut arg_items: List[Int] = []
        for d in derives {
            let a = node_count()
            node_push(AstNode { kind: NodeKind.Ident, name: d, line: 0, col: 0 })
            arg_items.push(a)
        }
        let args = sublist_of(arg_items)
        let ann = node_count()
        node_push(AstNode { kind: NodeKind.Annotation, name: "derive", args: args, line: 0, col: 0 })
        anns = sublist_of([ann])
    }
    let td = node_count()
    node_push(AstNode { kind: NodeKind.TypeDef, name: name, fields: flds, handlers: anns, line: 0, col: 0 })
    td
}

// A labelled argument no caller wrote. Typecheck fills a keyword parameter the call omitted
// from the declaration's own default expression, and every reader past typecheck reaches an
// argument through the call's argument list, so the node has to be in it. Built here for the
// same reason synth_struct_decl is: the node pool and its sublists are this module's to
// extend. The span is the call's, because that is the line a reader has to look at when the
// filled value turns out to be the wrong one.
pub fn synth_named_arg(label: Str, value: Int, line: Int, col: Int) -> Int {
    let nd = node_count()
    node_push(AstNode { kind: NodeKind.NamedArg, name: label, value: value, line: line, col: col })
    nd
}

// Append to a sublist that parsing already closed. sublist_push refuses once the sublist
// stack is empty, which is the right guard while a parse is running and the wrong one after
// it has finished.
pub fn sublist_append(sl: Int, node_id: Int) {
    sublist_add(sl, node_id)
}

// A sublist built after parsing, from members already in the pool. It stays off the sublist
// stack for the reason sublist_append does: no parse is open for it to belong to.
pub fn sublist_of(members: List[Int]) -> Int {
    let id = sublists.start.len()
    sublists.start.push(sublists.arena.len())
    sublists.len.push(members.len())
    for m in members {
        sublists.arena.push(m)
    }
    id
}

// ── Node accessor functions (migration bridge) ─────────────────────

pub fn node_count() -> Int { columns.count }

// A getter checks the id here, then reads its field's slot in its column.
fn checked_node_id(id: Int, where: Str) -> Int {
    if id < 0 || id >= columns.count { node_die(id, where) }
    id
}

fn node_or_die(id: Int, where: Str) -> AstNode {
    let i = checked_node_id(id, where)
    let ic = i >> 12
    let h = columns.ints[ic][i & 4095]
    let s = h & 65535
    let ij = (h >> 16) & 16777215
    let sc = ic
    let sj = h >> 40
    let o_str_val = columns.at_str_val[s]
    let o_name = columns.at_name[s]
    let o_op = columns.at_op[s]
    let o_var_name = columns.at_var_name[s]
    let o_module = columns.at_module[s]
    let o_method = columns.at_method[s]
    let o_return_type = columns.at_return_type[s]
    let o_type_name = columns.at_type_name[s]
    let o_trait_name = columns.at_trait_name[s]
    let o_leading_comments = columns.at_leading_comments[s]
    let o_trailing_comments = columns.at_trailing_comments[s]
    let o_doc_comment = columns.at_doc_comment[s]
    let o_xfail_reason = columns.at_xfail_reason[s]
    let o_int_val = columns.at_int_val[s]
    let o_left = columns.at_left[s]
    let o_right = columns.at_right[s]
    let o_body = columns.at_body[s]
    let o_condition = columns.at_condition[s]
    let o_then_body = columns.at_then_body[s]
    let o_else_body = columns.at_else_body[s]
    let o_scrutinee = columns.at_scrutinee[s]
    let o_pattern = columns.at_pattern[s]
    let o_guard = columns.at_guard[s]
    let o_value = columns.at_value[s]
    let o_target = columns.at_target[s]
    let o_iterable = columns.at_iterable[s]
    let o_is_mut = columns.at_is_mut[s]
    let o_is_pub = columns.at_is_pub[s]
    let o_is_const = columns.at_is_const[s]
    let o_inclusive = columns.at_inclusive[s]
    let o_start = columns.at_start[s]
    let o_end = columns.at_end[s]
    let o_obj = columns.at_obj[s]
    let o_index = columns.at_index[s]
    let o_params = columns.at_params[s]
    let o_args = columns.at_args[s]
    let o_stmts = columns.at_stmts[s]
    let o_arms = columns.at_arms[s]
    let o_fields = columns.at_fields[s]
    let o_elements = columns.at_elements[s]
    let o_methods = columns.at_methods[s]
    let o_type_params = columns.at_type_params[s]
    let o_effects = columns.at_effects[s]
    let o_captures = columns.at_captures[s]
    let o_type_ann = columns.at_type_ann[s]
    let o_handlers = columns.at_handlers[s]
    let o_line = columns.at_line[s]
    let o_col = columns.at_col[s]
    let o_end_line = columns.at_end_line[s]
    let o_end_col = columns.at_end_col[s]
    let o_assoc_types = columns.at_assoc_types[s]
    let o_impl_binders = columns.at_impl_binders[s]
    let o_recv_type_args = columns.at_recv_type_args[s]
    let o_impl_where_bounds = columns.at_impl_where_bounds[s]
    let o_for_binder = columns.at_for_binder[s]
    let o_supertraits = columns.at_supertraits[s]
    AstNode {
        str_val: if o_str_val < 0 { node_blank.str_val } else { columns.strs[sc][sj + o_str_val] },
        name: if o_name < 0 { node_blank.name } else { columns.strs[sc][sj + o_name] },
        op: if o_op < 0 { node_blank.op } else { columns.strs[sc][sj + o_op] },
        var_name: if o_var_name < 0 { node_blank.var_name } else { columns.strs[sc][sj + o_var_name] },
        module: if o_module < 0 { node_blank.module } else { columns.strs[sc][sj + o_module] },
        method: if o_method < 0 { node_blank.method } else { columns.strs[sc][sj + o_method] },
        return_type: if o_return_type < 0 { node_blank.return_type } else { columns.strs[sc][sj + o_return_type] },
        type_name: if o_type_name < 0 { node_blank.type_name } else { columns.strs[sc][sj + o_type_name] },
        trait_name: if o_trait_name < 0 { node_blank.trait_name } else { columns.strs[sc][sj + o_trait_name] },
        leading_comments: if o_leading_comments < 0 { node_blank.leading_comments } else { columns.strs[sc][sj + o_leading_comments] },
        trailing_comments: if o_trailing_comments < 0 { node_blank.trailing_comments } else { columns.strs[sc][sj + o_trailing_comments] },
        doc_comment: if o_doc_comment < 0 { node_blank.doc_comment } else { columns.strs[sc][sj + o_doc_comment] },
        xfail_reason: if o_xfail_reason < 0 { node_blank.xfail_reason } else { columns.strs[sc][sj + o_xfail_reason] },
        kind: columns.kind[i],
        int_val: if o_int_val < 0 { node_blank.int_val } else { columns.ints[ic][ij + o_int_val] },
        left: if o_left < 0 { node_blank.left } else { columns.ints[ic][ij + o_left] },
        right: if o_right < 0 { node_blank.right } else { columns.ints[ic][ij + o_right] },
        body: if o_body < 0 { node_blank.body } else { columns.ints[ic][ij + o_body] },
        condition: if o_condition < 0 { node_blank.condition } else { columns.ints[ic][ij + o_condition] },
        then_body: if o_then_body < 0 { node_blank.then_body } else { columns.ints[ic][ij + o_then_body] },
        else_body: if o_else_body < 0 { node_blank.else_body } else { columns.ints[ic][ij + o_else_body] },
        scrutinee: if o_scrutinee < 0 { node_blank.scrutinee } else { columns.ints[ic][ij + o_scrutinee] },
        pattern: if o_pattern < 0 { node_blank.pattern } else { columns.ints[ic][ij + o_pattern] },
        guard: if o_guard < 0 { node_blank.guard } else { columns.ints[ic][ij + o_guard] },
        value: if o_value < 0 { node_blank.value } else { columns.ints[ic][ij + o_value] },
        target: if o_target < 0 { node_blank.target } else { columns.ints[ic][ij + o_target] },
        iterable: if o_iterable < 0 { node_blank.iterable } else { columns.ints[ic][ij + o_iterable] },
        is_mut: if o_is_mut < 0 { node_blank.is_mut } else { columns.ints[ic][ij + o_is_mut] },
        is_pub: if o_is_pub < 0 { node_blank.is_pub } else { columns.ints[ic][ij + o_is_pub] },
        is_const: if o_is_const < 0 { node_blank.is_const } else { columns.ints[ic][ij + o_is_const] },
        inclusive: if o_inclusive < 0 { node_blank.inclusive } else { columns.ints[ic][ij + o_inclusive] },
        start: if o_start < 0 { node_blank.start } else { columns.ints[ic][ij + o_start] },
        end: if o_end < 0 { node_blank.end } else { columns.ints[ic][ij + o_end] },
        obj: if o_obj < 0 { node_blank.obj } else { columns.ints[ic][ij + o_obj] },
        index: if o_index < 0 { node_blank.index } else { columns.ints[ic][ij + o_index] },
        params: if o_params < 0 { node_blank.params } else { columns.ints[ic][ij + o_params] },
        args: if o_args < 0 { node_blank.args } else { columns.ints[ic][ij + o_args] },
        stmts: if o_stmts < 0 { node_blank.stmts } else { columns.ints[ic][ij + o_stmts] },
        arms: if o_arms < 0 { node_blank.arms } else { columns.ints[ic][ij + o_arms] },
        fields: if o_fields < 0 { node_blank.fields } else { columns.ints[ic][ij + o_fields] },
        elements: if o_elements < 0 { node_blank.elements } else { columns.ints[ic][ij + o_elements] },
        methods: if o_methods < 0 { node_blank.methods } else { columns.ints[ic][ij + o_methods] },
        type_params: if o_type_params < 0 { node_blank.type_params } else { columns.ints[ic][ij + o_type_params] },
        effects: if o_effects < 0 { node_blank.effects } else { columns.ints[ic][ij + o_effects] },
        captures: if o_captures < 0 { node_blank.captures } else { columns.ints[ic][ij + o_captures] },
        type_ann: if o_type_ann < 0 { node_blank.type_ann } else { columns.ints[ic][ij + o_type_ann] },
        handlers: if o_handlers < 0 { node_blank.handlers } else { columns.ints[ic][ij + o_handlers] },
        line: if o_line < 0 { node_blank.line } else { columns.ints[ic][ij + o_line] },
        col: if o_col < 0 { node_blank.col } else { columns.ints[ic][ij + o_col] },
        end_line: if o_end_line < 0 { node_blank.end_line } else { columns.ints[ic][ij + o_end_line] },
        end_col: if o_end_col < 0 { node_blank.end_col } else { columns.ints[ic][ij + o_end_col] },
        assoc_types: if o_assoc_types < 0 { node_blank.assoc_types } else { columns.ints[ic][ij + o_assoc_types] },
        impl_binders: if o_impl_binders < 0 { node_blank.impl_binders } else { columns.ints[ic][ij + o_impl_binders] },
        recv_type_args: if o_recv_type_args < 0 { node_blank.recv_type_args } else { columns.ints[ic][ij + o_recv_type_args] },
        impl_where_bounds: if o_impl_where_bounds < 0 { node_blank.impl_where_bounds } else { columns.ints[ic][ij + o_impl_where_bounds] },
        for_binder: if o_for_binder < 0 { node_blank.for_binder } else { columns.ints[ic][ij + o_for_binder] },
        supertraits: if o_supertraits < 0 { node_blank.supertraits } else { columns.ints[ic][ij + o_supertraits] },
    }
}

// The whole node at `id`, built from its payload. A pass that reads one or two fields uses
// their accessors instead.
pub fn node_at(id: Int) -> AstNode { node_or_die(id, "node_at") }

// Named-caller panic on bad id: a plain `.unwrap()` panic doesn't tell us
// which accessor was hit or how far out of bounds the id was, which makes
// concurrency or stale-id corruption nearly impossible to diagnose from
// a CI log.
fn node_die(id: Int, where: Str) {
    io.eprintln("parser: {where}({id}) out of bounds; nodes.len()={columns.count}")
    // Forensic dump for the node-index race: opt-in via BLINK_PARSER_PANIC_DUMP=1 so normal
    // panic output is unchanged in CI but the next sighting captures enough
    // state to localize the race.
    let dump = env.var("BLINK_PARSER_PANIC_DUMP") ?? ""
    if dump != "" {
        let nlen = columns.count
        let sl_len = sublists.start.len()
        io.eprintln("parser-dump: pos={pos} src='{diag_source_file}' sublists.len={sl_len}")
        // Tail of the node pool — last 32 kinds + line:col, oldest first.
        let mut start = nlen - 32
        if start < 0 { start = 0 }
        let mut i = start
        while i < nlen {
            let nk = columns.kind[i]
            let nl = node_get_int(i, columns.at_line, node_blank.line)
            let nc = node_get_int(i, columns.at_col, node_blank.col)
            io.eprintln("parser-dump: node[{i}] kind={nk} line={nl} col={nc}")
            i = i + 1
        }
        // Largest sublist sizes — useful if a sublist length looks insane.
        let mut j = 0
        let mut max_sl = 0
        let mut max_sl_idx = -1
        while j < sl_len {
            let l = sublists.len[j]
            if l > max_sl {
                max_sl = l
                max_sl_idx = j
            }
            j = j + 1
        }
        io.eprintln("parser-dump: max_sublist_len={max_sl} at_index={max_sl_idx}")
    }
    exit(2)
}

