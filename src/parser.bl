import tokens.{TokenKind, is_keyword, token_kind_name}
import ast.{NodeKind, AstNode, ChildWalk, node_child_ids_into, node_unclaimed_child, nk_of, nk_is_typed, nk_bridge_gap, node_kind_name, trace, trace_mode}
import lexer.{tokens}
import diagnostics.{
    Diag, diag_error, diag_error_range, diag_source_file,
    diag_count, diag_entry_count, diag_truncate,
    INLINE_MODULE_NOT_SUPPORTED, UNEXPECTED_ANNOTATION, UNEXPECTED_TOKEN,
    UNEXPECTED_TOKEN_STRING, UNEXPECTED_TOKEN_PATTERN, KEYWORD_AS_IDENTIFIER,
    EMPTY_BRACE_EXPR, UNKNOWN_INTRINSIC, MUT_FIELD_NOT_SUPPORTED,
    INVALID_STRING_BACKED_ENUM, INTERP_PARSE_FAILURE,
    TEST_ANNOTATED_RETURN, ELEMENT_ACCESS_HELP,
}

effect Parse {
    effect Advance
    effect Build
}

// parser.bl — Self-hosting recursive descent parser for Blink
//
// Port of src/pact/parser.py. Token input arrives as a List[Token]
// from the lexer. AST output is a node pool indexed by node ID.

// ── Node pool ──────────────────────────────────────────────────────
// Each node is an index into the pool. -1 means "no node".
// The pool holds one column per AstNode field, so a read of one field loads that field and
// its neighbours' rather than the whole wide node, and a push allocates no per-node box.
// A column is a list of chunks of 4096 slots: node id's slot is chunk id >> 12, index
// id & 4095. One growing list per column would leave up to half of every column unused
// after a doubling, and copy every column at each one; a chunk wastes at most its own tail
// and never moves. 4096 slots of 8 bytes is 32 KiB per chunk, so the unused tail is under
// 2 MiB over all columns, and a column's chunk list stays small enough to sit in cache.
// `kind` is one flat list instead: almost every walk of the tree reads it, and a read through
// a chunk must load the chunk's own header before the slot, which costs about as much as the
// slot. One list of 8 bytes per node leaves at most a few MiB unused.
// Only node_push, node_pop, node_replace, node_write_plain_int, node_write_plain_str,
// parser_reset and the chunk and child-slot helpers they call write the columns. All but
// the two plain writers write every column, so all columns hold the same nodes.
// `child_slots`: each node's children as ChildWalk.Slots writes them, one run per node. A
// sublist stays one slot and is expanded when read, so a member appended to a sublist after
// its owner exists is still seen.
// `child_at`: where node id's run in child_slots starts and how long it is, packed as
// start << 8 | count. A write that changes a node's children appends a new run and leaves
// the old one unread.
type NodeColumns {
    count: Int
    str_val: List[List[Str]]
    name: List[List[Str]]
    op: List[List[Str]]
    var_name: List[List[Str]]
    module: List[List[Str]]
    method: List[List[Str]]
    return_type: List[List[Str]]
    type_name: List[List[Str]]
    trait_name: List[List[Str]]
    leading_comments: List[List[Str]]
    trailing_comments: List[List[Str]]
    doc_comment: List[List[Str]]
    xfail_reason: List[List[Str]]
    kind: List[Int]
    int_val: List[List[Int]]
    left: List[List[Int]]
    right: List[List[Int]]
    body: List[List[Int]]
    condition: List[List[Int]]
    then_body: List[List[Int]]
    else_body: List[List[Int]]
    scrutinee: List[List[Int]]
    pattern: List[List[Int]]
    guard: List[List[Int]]
    value: List[List[Int]]
    target: List[List[Int]]
    iterable: List[List[Int]]
    is_mut: List[List[Int]]
    is_pub: List[List[Int]]
    is_const: List[List[Int]]
    inclusive: List[List[Int]]
    start: List[List[Int]]
    end: List[List[Int]]
    obj: List[List[Int]]
    index: List[List[Int]]
    params: List[List[Int]]
    args: List[List[Int]]
    stmts: List[List[Int]]
    arms: List[List[Int]]
    fields: List[List[Int]]
    elements: List[List[Int]]
    methods: List[List[Int]]
    type_params: List[List[Int]]
    effects: List[List[Int]]
    captures: List[List[Int]]
    type_ann: List[List[Int]]
    handlers: List[List[Int]]
    line: List[List[Int]]
    col: List[List[Int]]
    end_line: List[List[Int]]
    end_col: List[List[Int]]
    assoc_types: List[List[Int]]
    impl_binders: List[List[Int]]
    recv_type_args: List[List[Int]]
    impl_where_bounds: List[List[Int]]
    for_binder: List[List[Int]]
    supertraits: List[List[Int]]
    child_at: List[List[Int]]
    child_slots: List[Int]
}

fn node_columns_empty() -> NodeColumns {
    NodeColumns { count: 0, str_val: [], name: [], op: [], var_name: [], module: [], method: [], return_type: [], type_name: [], trait_name: [], leading_comments: [], trailing_comments: [], doc_comment: [], xfail_reason: [], kind: [], int_val: [], left: [], right: [], body: [], condition: [], then_body: [], else_body: [], scrutinee: [], pattern: [], guard: [], value: [], target: [], iterable: [], is_mut: [], is_pub: [], is_const: [], inclusive: [], start: [], end: [], obj: [], index: [], params: [], args: [], stmts: [], arms: [], fields: [], elements: [], methods: [], type_params: [], effects: [], captures: [], type_ann: [], handlers: [], line: [], col: [], end_line: [], end_col: [], assoc_types: [], impl_binders: [], recv_type_args: [], impl_where_bounds: [], for_binder: [], supertraits: [], child_at: [], child_slots: [] }
}

let mut columns: NodeColumns = node_columns_empty()

// Sublists: for lists of node references (params, args, stmts, etc.). Every closed sublist is
// a run of `arena`, so a read is one load chain, not one through a List per sublist; `start`
// and `len` hold the run of each sublist id. Sublists nest while a parse runs, so an open one
// cannot grow in place in the arena: it builds in `scratch` at its depth on the `open` stack,
// and its start reads -2 - depth until finalize_sublist copies it to the arena end. Its length
// stays live so a read before finalize still reads right.
type SublistPool {
    arena: List[Int]
    start: List[Int]
    len: List[Int]
    open: List[Int]
    scratch: List[List[Int]]
}

let mut sublists: SublistPool = SublistPool { arena: [], start: [], len: [], open: [], scratch: [] }

let mut annotation_nodes: List[Int] = []
let mut program_annotation_nodes: List[Int] = []

// `@expect_panic` desugars to a real AssertPanics node during parse so the
// compile path gets all the assert_panics machinery for free. The FORMAT path
// disables it (set to 0 before parse_program, restored after) so the formatter
// round-trips the original `@expect_panic` surface syntax instead of printing
// the desugared `assert_panics` body — which would otherwise double-wrap on the
// next format and is non-idempotent.
pub let mut parse_desugar_enabled: Int = 1

// Side table: dotted-path-derived module key per top-level decl node.
// Populated during merge_programs from the import graph. Used by
// codegen's archive-mode emission filter to route decls by source
// of origin. blink_map keys must be const char*, so the node id is
// stringified.
pub let mut source_module_for_node: Map[Int, Str] = Map()

pub fn parser_reset() {
    columns = node_columns_empty()
    sublists = SublistPool { arena: [], start: [], len: [], open: [], scratch: [] }
    annotation_nodes.clear()
    program_annotation_nodes.clear()
    source_module_for_node.clear()
    pos = 0
    parse_desugar_enabled = 1
}

pub fn record_source_module(node_id: Int, key: Str) {
    source_module_for_node.insert(node_id, key)
}

pub fn node_source_module(id: Int) -> Str {
    match source_module_for_node.get(id) {
        Some(key) => key
        None => {
            let i = checked_node_id(id, "node_source_module")
            columns.module[i >> 12][i & 4095]
        }
    }
}

pub fn new_node(kind: NodeKind) -> Int ! Parse.Build {
    node_push(AstNode { kind: kind, line: peek_line(), col: peek_col() })
}

// Adds an empty chunk to the end of every chunked column, for the node that starts it.
// Each chunk is made at its full size, so filling it never regrows and copies it.
fn node_columns_open_chunk() {
    columns.str_val.push(List.with_capacity(4096))
    columns.name.push(List.with_capacity(4096))
    columns.op.push(List.with_capacity(4096))
    columns.var_name.push(List.with_capacity(4096))
    columns.module.push(List.with_capacity(4096))
    columns.method.push(List.with_capacity(4096))
    columns.return_type.push(List.with_capacity(4096))
    columns.type_name.push(List.with_capacity(4096))
    columns.trait_name.push(List.with_capacity(4096))
    columns.leading_comments.push(List.with_capacity(4096))
    columns.trailing_comments.push(List.with_capacity(4096))
    columns.doc_comment.push(List.with_capacity(4096))
    columns.xfail_reason.push(List.with_capacity(4096))
    columns.int_val.push(List.with_capacity(4096))
    columns.left.push(List.with_capacity(4096))
    columns.right.push(List.with_capacity(4096))
    columns.body.push(List.with_capacity(4096))
    columns.condition.push(List.with_capacity(4096))
    columns.then_body.push(List.with_capacity(4096))
    columns.else_body.push(List.with_capacity(4096))
    columns.scrutinee.push(List.with_capacity(4096))
    columns.pattern.push(List.with_capacity(4096))
    columns.guard.push(List.with_capacity(4096))
    columns.value.push(List.with_capacity(4096))
    columns.target.push(List.with_capacity(4096))
    columns.iterable.push(List.with_capacity(4096))
    columns.is_mut.push(List.with_capacity(4096))
    columns.is_pub.push(List.with_capacity(4096))
    columns.is_const.push(List.with_capacity(4096))
    columns.inclusive.push(List.with_capacity(4096))
    columns.start.push(List.with_capacity(4096))
    columns.end.push(List.with_capacity(4096))
    columns.obj.push(List.with_capacity(4096))
    columns.index.push(List.with_capacity(4096))
    columns.params.push(List.with_capacity(4096))
    columns.args.push(List.with_capacity(4096))
    columns.stmts.push(List.with_capacity(4096))
    columns.arms.push(List.with_capacity(4096))
    columns.fields.push(List.with_capacity(4096))
    columns.elements.push(List.with_capacity(4096))
    columns.methods.push(List.with_capacity(4096))
    columns.type_params.push(List.with_capacity(4096))
    columns.effects.push(List.with_capacity(4096))
    columns.captures.push(List.with_capacity(4096))
    columns.type_ann.push(List.with_capacity(4096))
    columns.handlers.push(List.with_capacity(4096))
    columns.line.push(List.with_capacity(4096))
    columns.col.push(List.with_capacity(4096))
    columns.end_line.push(List.with_capacity(4096))
    columns.end_col.push(List.with_capacity(4096))
    columns.assoc_types.push(List.with_capacity(4096))
    columns.impl_binders.push(List.with_capacity(4096))
    columns.recv_type_args.push(List.with_capacity(4096))
    columns.impl_where_bounds.push(List.with_capacity(4096))
    columns.for_binder.push(List.with_capacity(4096))
    columns.supertraits.push(List.with_capacity(4096))
    columns.child_at.push(List.with_capacity(4096))
}

// Drops the empty last chunk of every chunked column, once its first node is popped.
fn node_columns_close_chunk() {
    let _ = columns.str_val.pop()
    let _ = columns.name.pop()
    let _ = columns.op.pop()
    let _ = columns.var_name.pop()
    let _ = columns.module.pop()
    let _ = columns.method.pop()
    let _ = columns.return_type.pop()
    let _ = columns.type_name.pop()
    let _ = columns.trait_name.pop()
    let _ = columns.leading_comments.pop()
    let _ = columns.trailing_comments.pop()
    let _ = columns.doc_comment.pop()
    let _ = columns.xfail_reason.pop()
    let _ = columns.int_val.pop()
    let _ = columns.left.pop()
    let _ = columns.right.pop()
    let _ = columns.body.pop()
    let _ = columns.condition.pop()
    let _ = columns.then_body.pop()
    let _ = columns.else_body.pop()
    let _ = columns.scrutinee.pop()
    let _ = columns.pattern.pop()
    let _ = columns.guard.pop()
    let _ = columns.value.pop()
    let _ = columns.target.pop()
    let _ = columns.iterable.pop()
    let _ = columns.is_mut.pop()
    let _ = columns.is_pub.pop()
    let _ = columns.is_const.pop()
    let _ = columns.inclusive.pop()
    let _ = columns.start.pop()
    let _ = columns.end.pop()
    let _ = columns.obj.pop()
    let _ = columns.index.pop()
    let _ = columns.params.pop()
    let _ = columns.args.pop()
    let _ = columns.stmts.pop()
    let _ = columns.arms.pop()
    let _ = columns.fields.pop()
    let _ = columns.elements.pop()
    let _ = columns.methods.pop()
    let _ = columns.type_params.pop()
    let _ = columns.effects.pop()
    let _ = columns.captures.pop()
    let _ = columns.type_ann.pop()
    let _ = columns.handlers.pop()
    let _ = columns.line.pop()
    let _ = columns.col.pop()
    let _ = columns.end_line.pop()
    let _ = columns.end_col.pop()
    let _ = columns.assoc_types.pop()
    let _ = columns.impl_binders.pop()
    let _ = columns.recv_type_args.pop()
    let _ = columns.impl_where_bounds.pop()
    let _ = columns.for_binder.pop()
    let _ = columns.supertraits.pop()
    let _ = columns.child_at.pop()
}

// Appends `n` to the pool and returns its id.
pub fn node_push(n: AstNode) -> Int {
    let id = columns.count
    if (id & 4095) == 0 { node_columns_open_chunk() }
    let c = id >> 12
    columns.str_val[c].push(n.str_val)
    columns.name[c].push(n.name)
    columns.op[c].push(n.op)
    columns.var_name[c].push(n.var_name)
    columns.module[c].push(n.module)
    columns.method[c].push(n.method)
    columns.return_type[c].push(n.return_type)
    columns.type_name[c].push(n.type_name)
    columns.trait_name[c].push(n.trait_name)
    columns.leading_comments[c].push(n.leading_comments)
    columns.trailing_comments[c].push(n.trailing_comments)
    columns.doc_comment[c].push(n.doc_comment)
    columns.xfail_reason[c].push(n.xfail_reason)
    columns.kind.push(n.kind)
    columns.int_val[c].push(n.int_val)
    columns.left[c].push(n.left)
    columns.right[c].push(n.right)
    columns.body[c].push(n.body)
    columns.condition[c].push(n.condition)
    columns.then_body[c].push(n.then_body)
    columns.else_body[c].push(n.else_body)
    columns.scrutinee[c].push(n.scrutinee)
    columns.pattern[c].push(n.pattern)
    columns.guard[c].push(n.guard)
    columns.value[c].push(n.value)
    columns.target[c].push(n.target)
    columns.iterable[c].push(n.iterable)
    columns.is_mut[c].push(n.is_mut)
    columns.is_pub[c].push(n.is_pub)
    columns.is_const[c].push(n.is_const)
    columns.inclusive[c].push(n.inclusive)
    columns.start[c].push(n.start)
    columns.end[c].push(n.end)
    columns.obj[c].push(n.obj)
    columns.index[c].push(n.index)
    columns.params[c].push(n.params)
    columns.args[c].push(n.args)
    columns.stmts[c].push(n.stmts)
    columns.arms[c].push(n.arms)
    columns.fields[c].push(n.fields)
    columns.elements[c].push(n.elements)
    columns.methods[c].push(n.methods)
    columns.type_params[c].push(n.type_params)
    columns.effects[c].push(n.effects)
    columns.captures[c].push(n.captures)
    columns.type_ann[c].push(n.type_ann)
    columns.handlers[c].push(n.handlers)
    columns.line[c].push(n.line)
    columns.col[c].push(n.col)
    columns.end_line[c].push(n.end_line)
    columns.end_col[c].push(n.end_col)
    columns.assoc_types[c].push(n.assoc_types)
    columns.impl_binders[c].push(n.impl_binders)
    columns.recv_type_args[c].push(n.recv_type_args)
    columns.impl_where_bounds[c].push(n.impl_where_bounds)
    columns.for_binder[c].push(n.for_binder)
    columns.supertraits[c].push(n.supertraits)
    let start = columns.child_slots.len()
    node_child_ids_into(n, ChildWalk.Slots, columns.child_slots)
    columns.child_at[c].push(node_child_run(id, start))
    columns.count = id + 1
    id
}

// Drops the newest node, as a caller that made a scratch node does to give its id back.
pub fn node_pop() {
    if columns.count == 0 { return }
    let id = columns.count - 1
    let c = id >> 12
    let _ = columns.str_val[c].pop()
    let _ = columns.name[c].pop()
    let _ = columns.op[c].pop()
    let _ = columns.var_name[c].pop()
    let _ = columns.module[c].pop()
    let _ = columns.method[c].pop()
    let _ = columns.return_type[c].pop()
    let _ = columns.type_name[c].pop()
    let _ = columns.trait_name[c].pop()
    let _ = columns.leading_comments[c].pop()
    let _ = columns.trailing_comments[c].pop()
    let _ = columns.doc_comment[c].pop()
    let _ = columns.xfail_reason[c].pop()
    let _ = columns.kind.pop()
    let _ = columns.int_val[c].pop()
    let _ = columns.left[c].pop()
    let _ = columns.right[c].pop()
    let _ = columns.body[c].pop()
    let _ = columns.condition[c].pop()
    let _ = columns.then_body[c].pop()
    let _ = columns.else_body[c].pop()
    let _ = columns.scrutinee[c].pop()
    let _ = columns.pattern[c].pop()
    let _ = columns.guard[c].pop()
    let _ = columns.value[c].pop()
    let _ = columns.target[c].pop()
    let _ = columns.iterable[c].pop()
    let _ = columns.is_mut[c].pop()
    let _ = columns.is_pub[c].pop()
    let _ = columns.is_const[c].pop()
    let _ = columns.inclusive[c].pop()
    let _ = columns.start[c].pop()
    let _ = columns.end[c].pop()
    let _ = columns.obj[c].pop()
    let _ = columns.index[c].pop()
    let _ = columns.params[c].pop()
    let _ = columns.args[c].pop()
    let _ = columns.stmts[c].pop()
    let _ = columns.arms[c].pop()
    let _ = columns.fields[c].pop()
    let _ = columns.elements[c].pop()
    let _ = columns.methods[c].pop()
    let _ = columns.type_params[c].pop()
    let _ = columns.effects[c].pop()
    let _ = columns.captures[c].pop()
    let _ = columns.type_ann[c].pop()
    let _ = columns.handlers[c].pop()
    let _ = columns.line[c].pop()
    let _ = columns.col[c].pop()
    let _ = columns.end_line[c].pop()
    let _ = columns.end_col[c].pop()
    let _ = columns.assoc_types[c].pop()
    let _ = columns.impl_binders[c].pop()
    let _ = columns.recv_type_args[c].pop()
    let _ = columns.impl_where_bounds[c].pop()
    let _ = columns.for_binder[c].pop()
    let _ = columns.supertraits[c].pop()
    let at = columns.child_at[c].pop() ?? 0
    columns.count = id
    if (id & 4095) == 0 { node_columns_close_chunk() }
    if (at >> 8) + (at & 255) == columns.child_slots.len() {
        node_drop_child_slots_from(at >> 8)
    }
}

fn node_replace(id: Int, n: AstNode) {
    let c = id >> 12
    let j = id & 4095
    columns.str_val[c].set(j, n.str_val)
    columns.name[c].set(j, n.name)
    columns.op[c].set(j, n.op)
    columns.var_name[c].set(j, n.var_name)
    columns.module[c].set(j, n.module)
    columns.method[c].set(j, n.method)
    columns.return_type[c].set(j, n.return_type)
    columns.type_name[c].set(j, n.type_name)
    columns.trait_name[c].set(j, n.trait_name)
    columns.leading_comments[c].set(j, n.leading_comments)
    columns.trailing_comments[c].set(j, n.trailing_comments)
    columns.doc_comment[c].set(j, n.doc_comment)
    columns.xfail_reason[c].set(j, n.xfail_reason)
    columns.kind.set(id, n.kind)
    columns.int_val[c].set(j, n.int_val)
    columns.left[c].set(j, n.left)
    columns.right[c].set(j, n.right)
    columns.body[c].set(j, n.body)
    columns.condition[c].set(j, n.condition)
    columns.then_body[c].set(j, n.then_body)
    columns.else_body[c].set(j, n.else_body)
    columns.scrutinee[c].set(j, n.scrutinee)
    columns.pattern[c].set(j, n.pattern)
    columns.guard[c].set(j, n.guard)
    columns.value[c].set(j, n.value)
    columns.target[c].set(j, n.target)
    columns.iterable[c].set(j, n.iterable)
    columns.is_mut[c].set(j, n.is_mut)
    columns.is_pub[c].set(j, n.is_pub)
    columns.is_const[c].set(j, n.is_const)
    columns.inclusive[c].set(j, n.inclusive)
    columns.start[c].set(j, n.start)
    columns.end[c].set(j, n.end)
    columns.obj[c].set(j, n.obj)
    columns.index[c].set(j, n.index)
    columns.params[c].set(j, n.params)
    columns.args[c].set(j, n.args)
    columns.stmts[c].set(j, n.stmts)
    columns.arms[c].set(j, n.arms)
    columns.fields[c].set(j, n.fields)
    columns.elements[c].set(j, n.elements)
    columns.methods[c].set(j, n.methods)
    columns.type_params[c].set(j, n.type_params)
    columns.effects[c].set(j, n.effects)
    columns.captures[c].set(j, n.captures)
    columns.type_ann[c].set(j, n.type_ann)
    columns.handlers[c].set(j, n.handlers)
    columns.line[c].set(j, n.line)
    columns.col[c].set(j, n.col)
    columns.end_line[c].set(j, n.end_line)
    columns.end_col[c].set(j, n.end_col)
    columns.assoc_types[c].set(j, n.assoc_types)
    columns.impl_binders[c].set(j, n.impl_binders)
    columns.recv_type_args[c].set(j, n.recv_type_args)
    columns.impl_where_bounds[c].set(j, n.impl_where_bounds)
    columns.for_binder[c].set(j, n.for_binder)
    columns.supertraits[c].set(j, n.supertraits)
    // Most setters change a field that is not a child, so a run equal to the old one is
    // dropped again instead of growing the column on every write.
    let old = columns.child_at[c][j]
    let start = columns.child_slots.len()
    node_child_ids_into(n, ChildWalk.Slots, columns.child_slots)
    let at = node_child_run(id, start)
    if node_child_runs_equal(old, at) {
        node_drop_child_slots_from(at >> 8)
    } else {
        columns.child_at[c].set(j, at)
    }
}

// The fields a setter writes in place: the child table reads none of them for any kind, so
// a write leaves the node's child slots right without a walk of the table. A field the table
// reads goes through node_replace, which walks the table again. A test runs every setter of
// these fields over every kind against the table.
type NodePlainInt {
    IntVal, IsPub, Line, Col, EndLine, EndCol, IsMut, IsConst, Inclusive
}

type NodePlainStr {
    StrVal, Module, TypeName, LeadingComments, TrailingComments, DocComment, Op, VarName, Method, ReturnType, TraitName
}

// `id` is already checked.
fn node_write_plain_int(id: Int, f: NodePlainInt, val: Int) {
    let c = id >> 12
    let j = id & 4095
    match f {
        NodePlainInt.IntVal => columns.int_val[c].set(j, val)
        NodePlainInt.IsPub => columns.is_pub[c].set(j, val)
        NodePlainInt.Line => columns.line[c].set(j, val)
        NodePlainInt.Col => columns.col[c].set(j, val)
        NodePlainInt.EndLine => columns.end_line[c].set(j, val)
        NodePlainInt.EndCol => columns.end_col[c].set(j, val)
        NodePlainInt.IsMut => columns.is_mut[c].set(j, val)
        NodePlainInt.IsConst => columns.is_const[c].set(j, val)
        NodePlainInt.Inclusive => columns.inclusive[c].set(j, val)
    }
}

// `id` is already checked.
fn node_write_plain_str(id: Int, f: NodePlainStr, val: Str) {
    let c = id >> 12
    let j = id & 4095
    match f {
        NodePlainStr.StrVal => columns.str_val[c].set(j, val)
        NodePlainStr.Module => columns.module[c].set(j, val)
        NodePlainStr.TypeName => columns.type_name[c].set(j, val)
        NodePlainStr.LeadingComments => columns.leading_comments[c].set(j, val)
        NodePlainStr.TrailingComments => columns.trailing_comments[c].set(j, val)
        NodePlainStr.DocComment => columns.doc_comment[c].set(j, val)
        NodePlainStr.Op => columns.op[c].set(j, val)
        NodePlainStr.VarName => columns.var_name[c].set(j, val)
        NodePlainStr.Method => columns.method[c].set(j, val)
        NodePlainStr.ReturnType => columns.return_type[c].set(j, val)
        NodePlainStr.TraitName => columns.trait_name[c].set(j, val)
    }
}

// The packed start and count of the run of child slots that node `id`'s walk of the table
// appended from `start` to the tail of child_slots. The writers walk the table themselves:
// AstNode is passed by value, so each function it passes through copies all of it.
fn node_child_run(id: Int, start: Int) -> Int {
    let count = columns.child_slots.len() - start
    if count > 255 {
        io.println("FATAL: node {id} has {count} children; child_at packs at most 255")
        exit(1)
    }
    (start << 8) | count
}

fn node_drop_child_slots_from(start: Int) {
    while columns.child_slots.len() > start {
        let _ = columns.child_slots.pop()
    }
}

fn node_child_runs_equal(a: Int, b: Int) -> Bool {
    let count = a & 255
    if count != (b & 255) { return false }
    let mut i = 0
    while i < count {
        if columns.child_slots[(a >> 8) + i] != columns.child_slots[(b >> 8) + i] { return false }
        i = i + 1
    }
    true
}

// Appends to `out` the children of `id` on one side, read from the node's run of child
// slots. `side` is 0 for value children and 2 for spellings, the slot's spelling bit.
fn node_push_slot_children(id: Int, side: Int, out: List[Int]) {
    let at = columns.child_at[id >> 12][id & 4095]
    let mut i = at >> 8
    let end = i + (at & 255)
    while i < end {
        let slot = columns.child_slots[i]
        if (slot & 2) == side {
            if (slot & 1) == 0 {
                out.push(slot >> 2)
            } else {
                let sl = slot >> 2
                let s = sublists.start[sl]
                let n = sublists.len[sl]
                let mut k = 0
                while k < n {
                    let m = if s >= 0 { sublists.arena[s + k] } else { sublist_get_slow(sl, k) }
                    if m != -1 { out.push(m) }
                    k = k + 1
                }
            }
        }
        i = i + 1
    }
}

pub fn new_sublist() -> Int ! Parse.Build {
    let id = sublists.start.len()
    let depth = sublists.open.len()
    if depth == sublists.scratch.len() {
        let items: List[Int] = []
        sublists.scratch.push(items)
    } else {
        let mut items = sublists.scratch[depth]
        items.clear()
    }
    sublists.start.push(-2 - depth)
    sublists.len.push(0)
    sublists.open.push(id)
    id
}

pub fn sublist_push(sl: Int, node_id: Int) ! Parse.Build {
    if sublists.open.len() == 0 {
        io.println("FATAL: sublist_push() called with no open sublist")
        exit(1)
    }
    sublist_add(sl, node_id)
}

pub fn finalize_sublist(sl: Int) ! Parse.Build {
    if sublists.open.len() == 0 {
        io.println("FATAL: finalize_sublist() called with no open sublist")
        exit(1)
    }
    let top = sublists.open.get(sublists.open.len() - 1).unwrap()
    if top != sl {
        io.println("FATAL: finalize_sublist({sl}) but top of stack is {top}")
        exit(1)
    }
    sublists.open.pop()
    let items = sublists.scratch[sublists.open.len()]
    sublists.start.set(sl, sublists.arena.len())
    for m in items {
        sublists.arena.push(m)
    }
}

// One branch holds every check so the hot path stays small; the read of an open sublist and
// the error report live in sublist_get_slow.
pub fn sublist_get(sl: Int, idx: Int) -> Int {
    let s = sublists.start[sl]
    if s < 0 || idx < 0 || idx >= sublists.len[sl] {
        return sublist_get_slow(sl, idx)
    }
    sublists.arena[s + idx]
}

pub fn sublist_length(sl: Int) -> Int {
    sublists.len[sl]
}

fn sublist_get_slow(sl: Int, idx: Int) -> Int {
    let s = sublists.start[sl]
    let n = sublists.len[sl]
    if idx < 0 || idx >= n {
        io.eprintln("FATAL: sublist_get({sl}, {idx}) out of bounds; sublist length is {n}")
        exit(2)
    }
    if s >= 0 {
        return sublists.arena[s + idx]
    }
    sublists.scratch[-2 - s][idx]
}

// An open sublist grows in its scratch list. A closed one grows at the arena end: in place
// when its run is already last, else after its run is copied there. The old run stays as
// dead space, which is cheap because growth after close is rare.
fn sublist_add(sl: Int, node_id: Int) {
    let s = sublists.start[sl]
    let n = sublists.len[sl]
    if s < 0 {
        let mut items = sublists.scratch[-2 - s]
        items.push(node_id)
    } else {
        if s + n != sublists.arena.len() {
            let dest = sublists.arena.len()
            let mut k = 0
            while k < n {
                sublists.arena.push(sublists.arena[s + k])
                k = k + 1
            }
            sublists.start.set(sl, dest)
        }
        sublists.arena.push(node_id)
    }
    sublists.len.set(sl, n + 1)
}

// Appends to `out` the children of `id` in VALUE position only. A pass that reasons about
// types walks these and stops at a spelling edge, where there is no value and so no type to
// find. A walker that runs over every node passes one list down and reuses it.
pub fn node_push_value_child_ids(id: Int, out: List[Int]) {
    node_push_slot_children(checked_node_id(id, "node_push_value_child_ids"), 0, out)
}

// Appends to `out` the children of `id` that spell a type: annotations, type parameters and
// explicit type arguments. The complement of node_push_value_child_ids.
pub fn node_push_spell_child_ids(id: Int, out: List[Int]) {
    node_push_slot_children(checked_node_id(id, "node_push_spell_child_ids"), 2, out)
}

// The children of `id` in VALUE position, as a new list.
pub fn node_value_child_ids(id: Int) -> List[Int] {
    let mut out: List[Int] = []
    node_push_value_child_ids(id, out)
    out
}

// The children of `id` that spell a type, as a new list.
pub fn node_spell_child_ids(id: Int) -> List[Int] {
    let mut out: List[Int] = []
    node_push_spell_child_ids(id, out)
    out
}

// The field name of a child that node `id`'s kind does not claim, or "" when the kind's arm
// covers every child the node holds.
pub fn node_unclaimed_child_field(id: Int) -> Str {
    node_unclaimed_child(node_or_die(id, "node_unclaimed_child_field"))
}

pub fn get_annotation(node: Int, name: Str) -> Int {
    let anns_sl = node_handlers(node)
    if anns_sl == -1 {
        return -1
    }
    let mut i = 0
    while i < sublist_length(anns_sl) {
        let ann = sublist_get(anns_sl, i)
        if node_name(ann) == name {
            return ann
        }
        i = i + 1
    }
    -1
}

pub fn has_annotation(node: Int, name: Str) -> Int {
    if get_annotation(node, name) != -1 { 1 } else { 0 }
}

pub fn is_literal_string_part(part: Int) -> Int {
    if node_kind(part) == NodeKind.Ident && node_str_val(part) == node_name(part) { 1 } else { 0 }
}

pub fn get_str_named_arg(ann: Int, label: Str) -> Str {
    let args_sl = node_args(ann)
    if args_sl == -1 { return "" }
    let mut i = 0
    while i < sublist_length(args_sl) {
        let arg = sublist_get(args_sl, i)
        if node_kind(arg) == NodeKind.InterpString && node_name(arg) == label {
            let parts_sl = node_elements(arg)
            if parts_sl != -1 && sublist_length(parts_sl) == 1 {
                let part = sublist_get(parts_sl, 0)
                if is_literal_string_part(part) != 0 {
                    return node_str_val(part)
                }
            }
        }
        i = i + 1
    }
    ""
}

// A struct declaration for a type this program never wrote. Typecheck mints a tid for a
// type the runtime defines -- process_run answers ProcessResult in a file that never
// imports std.process -- and every reader past typecheck reaches a struct through its
// declaration node, so the node has to exist. It is built here rather than in typecheck
// because the node pool and its sublists are this module's to extend. It holds no source
// position and joins no open sublist: there is no source and no parse in progress.
// `derives` becomes one @derive annotation, so the traits read the same as on the declaration
// lib/std would have given.
pub fn synth_struct_decl(name: Str, fnames: List[Str], ftypes: List[Str], derives: List[Str]) -> Int {
    let mut items: List[Int] = []
    let mut i = 0
    while i < fnames.len() {
        let ta = node_count()
        node_push(AstNode { kind: NodeKind.TypeAnn, name: ftypes.get(i).unwrap(), line: 0, col: 0 })
        let tf = node_count()
        node_push(AstNode { kind: NodeKind.TypeField, name: fnames.get(i).unwrap(), value: ta, condition: -1, line: 0, col: 0 })
        items.push(tf)
        i = i + 1
    }
    let flds = sublist_of(items)
    let mut anns = -1
    if derives.len() > 0 {
        let mut arg_items: List[Int] = []
        for d in derives {
            let a = node_count()
            node_push(AstNode { kind: NodeKind.Ident, name: d, line: 0, col: 0 })
            arg_items.push(a)
        }
        let args = sublist_of(arg_items)
        let ann = node_count()
        node_push(AstNode { kind: NodeKind.Annotation, name: "derive", args: args, line: 0, col: 0 })
        anns = sublist_of([ann])
    }
    let td = node_count()
    node_push(AstNode { kind: NodeKind.TypeDef, name: name, fields: flds, handlers: anns, line: 0, col: 0 })
    td
}

// A labelled argument no caller wrote. Typecheck fills a keyword parameter the call omitted
// from the declaration's own default expression, and every reader past typecheck reaches an
// argument through the call's argument list, so the node has to be in it. Built here for the
// same reason synth_struct_decl is: the node pool and its sublists are this module's to
// extend. The span is the call's, because that is the line a reader has to look at when the
// filled value turns out to be the wrong one.
pub fn synth_named_arg(label: Str, value: Int, line: Int, col: Int) -> Int {
    let nd = node_count()
    node_push(AstNode { kind: NodeKind.NamedArg, name: label, value: value, line: line, col: col })
    nd
}

// Append to a sublist that parsing already closed. sublist_push refuses once the sublist
// stack is empty, which is the right guard while a parse is running and the wrong one after
// it has finished.
pub fn sublist_append(sl: Int, node_id: Int) {
    sublist_add(sl, node_id)
}

// A sublist built after parsing, from members already in the pool. It stays off the sublist
// stack for the reason sublist_append does: no parse is open for it to belong to.
pub fn sublist_of(members: List[Int]) -> Int {
    let id = sublists.start.len()
    sublists.start.push(sublists.arena.len())
    sublists.len.push(members.len())
    for m in members {
        sublists.arena.push(m)
    }
    id
}

// ── Node accessor functions (migration bridge) ─────────────────────

pub fn node_count() -> Int { columns.count }

// A getter checks the id here, then reads its field's slot in its column.
fn checked_node_id(id: Int, where: Str) -> Int {
    if id < 0 || id >= columns.count { node_die(id, where) }
    id
}

fn node_or_die(id: Int, where: Str) -> AstNode {
    let i = checked_node_id(id, where)
    let c = i >> 12
    let j = i & 4095
    AstNode {
        str_val: columns.str_val[c][j],
        name: columns.name[c][j],
        op: columns.op[c][j],
        var_name: columns.var_name[c][j],
        module: columns.module[c][j],
        method: columns.method[c][j],
        return_type: columns.return_type[c][j],
        type_name: columns.type_name[c][j],
        trait_name: columns.trait_name[c][j],
        leading_comments: columns.leading_comments[c][j],
        trailing_comments: columns.trailing_comments[c][j],
        doc_comment: columns.doc_comment[c][j],
        xfail_reason: columns.xfail_reason[c][j],
        kind: columns.kind[i],
        int_val: columns.int_val[c][j],
        left: columns.left[c][j],
        right: columns.right[c][j],
        body: columns.body[c][j],
        condition: columns.condition[c][j],
        then_body: columns.then_body[c][j],
        else_body: columns.else_body[c][j],
        scrutinee: columns.scrutinee[c][j],
        pattern: columns.pattern[c][j],
        guard: columns.guard[c][j],
        value: columns.value[c][j],
        target: columns.target[c][j],
        iterable: columns.iterable[c][j],
        is_mut: columns.is_mut[c][j],
        is_pub: columns.is_pub[c][j],
        is_const: columns.is_const[c][j],
        inclusive: columns.inclusive[c][j],
        start: columns.start[c][j],
        end: columns.end[c][j],
        obj: columns.obj[c][j],
        index: columns.index[c][j],
        params: columns.params[c][j],
        args: columns.args[c][j],
        stmts: columns.stmts[c][j],
        arms: columns.arms[c][j],
        fields: columns.fields[c][j],
        elements: columns.elements[c][j],
        methods: columns.methods[c][j],
        type_params: columns.type_params[c][j],
        effects: columns.effects[c][j],
        captures: columns.captures[c][j],
        type_ann: columns.type_ann[c][j],
        handlers: columns.handlers[c][j],
        line: columns.line[c][j],
        col: columns.col[c][j],
        end_line: columns.end_line[c][j],
        end_col: columns.end_col[c][j],
        assoc_types: columns.assoc_types[c][j],
        impl_binders: columns.impl_binders[c][j],
        recv_type_args: columns.recv_type_args[c][j],
        impl_where_bounds: columns.impl_where_bounds[c][j],
        for_binder: columns.for_binder[c][j],
        supertraits: columns.supertraits[c][j],
    }
}

// The whole node at `id`, built from its columns. A pass that reads one or two fields uses
// their accessors instead.
pub fn node_at(id: Int) -> AstNode { node_or_die(id, "node_at") }

// Named-caller panic on bad id: a plain `.unwrap()` panic doesn't tell us
// which accessor was hit or how far out of bounds the id was, which makes
// concurrency or stale-id corruption nearly impossible to diagnose from
// a CI log.
fn node_die(id: Int, where: Str) {
    io.eprintln("parser: {where}({id}) out of bounds; nodes.len()={columns.count}")
    // Forensic dump for the node-index race: opt-in via BLINK_PARSER_PANIC_DUMP=1 so normal
    // panic output is unchanged in CI but the next sighting captures enough
    // state to localize the race.
    let dump = env.var("BLINK_PARSER_PANIC_DUMP") ?? ""
    if dump != "" {
        let nlen = columns.count
        let sl_len = sublists.start.len()
        io.eprintln("parser-dump: pos={pos} src='{diag_source_file}' sublists.len={sl_len}")
        // Tail of the node pool — last 32 kinds + line:col, oldest first.
        let mut start = nlen - 32
        if start < 0 { start = 0 }
        let mut i = start
        while i < nlen {
            let nk = columns.kind[i]
            let nl = columns.line[i >> 12][i & 4095]
            let nc = columns.col[i >> 12][i & 4095]
            io.eprintln("parser-dump: node[{i}] kind={nk} line={nl} col={nc}")
            i = i + 1
        }
        // Largest sublist sizes — useful if a sublist length looks insane.
        let mut j = 0
        let mut max_sl = 0
        let mut max_sl_idx = -1
        while j < sl_len {
            let l = sublists.len[j]
            if l > max_sl {
                max_sl = l
                max_sl_idx = j
            }
            j = j + 1
        }
        io.eprintln("parser-dump: max_sublist_len={max_sl} at_index={max_sl_idx}")
    }
    exit(2)
}

pub fn node_kind(id: Int) -> Int {
    columns.kind[checked_node_id(id, "node_kind")]
}
pub fn node_int_val(id: Int) -> Int {
    let i = checked_node_id(id, "node_int_val")
    columns.int_val[i >> 12][i & 4095]
