import symbol_index.{si_sym_name, si_sym_kind, si_sym_module, si_sym_sig, si_sym_effects, si_sym_vis, si_sym_intent, si_sym_doc, si_sym_requires, si_sym_ensures, si_sym_end_line, si_sym_col, si_sym_end_col, si_sym_line, si_sym_file, si_sym_count, si_reset, si_build, SK_FN, VIS_PUB, sym_kind_name}
import std.json.{json_clear, json_encode, json_new_array, json_new_int, json_new_object, json_new_str, json_push, json_set}
import std.path.{path_basename}
import lexer.{Lex, lex}
import parser.{Parse, pos, parse_program, node_count}
import comment_attach.{attach_comments_pass}
import diagnostics.{Diag, diag_count, diag_source_file}

// query.bl — Query engine for the symbol index
//
// Filters the symbol index and returns JSON results.
// Supports: --layer intent|signature|contract|full, --effect, --pub --pure, --fn name.
// Output format per spec section 8.5.

// ── Effects string to JSON array ─────────────────────────────────────

fn effects_to_json_node(effects: Str) -> Int {
    let arr = json_new_array()
    if effects != "" {
        let mut _start = 0
        let mut i = 0
        while i <= effects.byte_len() {
            if i == effects.byte_len() || effects.byte_at(i) == 44 { // ','
                let part = effects.byte_slice(_start, i)
                json_push(arr, json_new_str(part))
                _start = i + 1
            }
            i = i + 1
        }
    }
    arr
}

// ── Visibility name ──────────────────────────────────────────────────

fn vis_name(vis: Int) -> Str {
    if vis == VIS_PUB {
        return "pub"
    }
    "private"
}

// ── Format a single symbol as a JSON object ──────────────────────────

fn symbol_to_json(idx: Int) -> Str {
    json_clear()
    let obj = json_new_object()
    json_set(obj, "name", json_new_str(si_sym_name.get(idx).unwrap()))
    json_set(obj, "kind", json_new_str(sym_kind_name(si_sym_kind.get(idx).unwrap())))
    json_set(obj, "module", json_new_str(si_sym_module.get(idx).unwrap()))
    json_set(obj, "signature", json_new_str(si_sym_sig.get(idx).unwrap()))
    json_set(obj, "effects", effects_to_json_node(si_sym_effects.get(idx).unwrap()))
    json_set(obj, "visibility", json_new_str(vis_name(si_sym_vis.get(idx).unwrap())))
    let intent = si_sym_intent.get(idx).unwrap()
    if intent != "" {
        json_set(obj, "intent", json_new_str(intent))
    }
    let doc = si_sym_doc.get(idx).unwrap()
    if doc != "" {
        json_set(obj, "doc", json_new_str(doc))
    }
    let req = si_sym_requires.get(idx).unwrap()
    if req != "" {
        json_set(obj, "requires", json_new_str(req))
    }
    let ens = si_sym_ensures.get(idx).unwrap()
    if ens != "" {
        json_set(obj, "ensures", json_new_str(ens))
    }
    let el = si_sym_end_line.get(idx).unwrap()
    if el > 0 {
        json_set(obj, "end_line", json_new_int(el))
    }
    let scol = si_sym_col.get(idx).unwrap()
    if scol > 0 {
        json_set(obj, "col", json_new_int(scol))
    }
    let ecol = si_sym_end_col.get(idx).unwrap()
    if ecol > 0 {
        json_set(obj, "end_col", json_new_int(ecol))
    }
    json_encode(obj)
}

// ── Wrap results array in envelope ───────────────────────────────────

fn wrap_results(items: Str) -> Str {
    "\{\"results\":[".concat(items).concat("]}")
}

// ── Check if comma-separated effects string contains a given effect ──

fn effects_contain(effects: Str, target: Str) -> Int {
    if effects == "" {
        return 0
    }
    let mut _start = 0
    let mut i = 0
    while i <= effects.byte_len() {
        if i == effects.byte_len() || effects.byte_at(i) == 44 { // ','
            let part = effects.byte_slice(_start, i)
            if part == target {
                return 1
            }
            _start = i + 1
        }
        i = i + 1
    }
    0
}

// ── Composable query: apply all filters in a single pass ─────────────

fn query_filtered(vis_filter: Int, module_filter: Str, effect_filter: Str, pure_only: Int, name_filter: Str) -> Str {
    let mut items = ""
    let mut _first = 1
    let mut i = 0
    while i < si_sym_count {
        if si_sym_kind.get(i).unwrap() != SK_FN {
            i = i + 1
            continue
        }
        if vis_filter == VIS_PUB && si_sym_vis.get(i).unwrap() != VIS_PUB {
            i = i + 1
            continue
        }
        if module_filter != "" && si_sym_module.get(i).unwrap() != module_filter {
            i = i + 1
            continue
        }
        if effect_filter != "" && effects_contain(si_sym_effects.get(i).unwrap(), effect_filter) == 0 {
            i = i + 1
            continue
        }
        if pure_only != 0 && si_sym_effects.get(i).unwrap() != "" {
            i = i + 1
            continue
        }
        if name_filter != "" && si_sym_name.get(i).unwrap() != name_filter {
            i = i + 1
            continue
        }
        if _first == 0 {
            items = items.concat(",")
        }
        items = items.concat(symbol_to_json(i))
        _first = 0
        i = i + 1
    }
    wrap_results(items)
}

// ── Layer: intent — minimal name + intent ────────────────────────────

fn symbol_to_intent_json(idx: Int) -> Str {
    json_clear()
    let obj = json_new_object()
    json_set(obj, "name", json_new_str(si_sym_name.get(idx).unwrap()))
    json_set(obj, "intent", json_new_str(si_sym_intent.get(idx).unwrap()))
    json_encode(obj)
}

// ── Layer: contract — signature + contracts ──────────────────────────

fn symbol_to_contract_json(idx: Int) -> Str {
    json_clear()
    let obj = json_new_object()
    json_set(obj, "name", json_new_str(si_sym_name.get(idx).unwrap()))
    json_set(obj, "signature", json_new_str(si_sym_sig.get(idx).unwrap()))
    json_set(obj, "effects", effects_to_json_node(si_sym_effects.get(idx).unwrap()))
    json_set(obj, "visibility", json_new_str(vis_name(si_sym_vis.get(idx).unwrap())))
    let req = si_sym_requires.get(idx).unwrap()
    if req != "" {
        json_set(obj, "requires", json_new_str(req))
    }
    let ens = si_sym_ensures.get(idx).unwrap()
    if ens != "" {
        json_set(obj, "ensures", json_new_str(ens))
    }
    json_encode(obj)
}

// ── Layer: full — everything including source text ───────────────────

fn extract_lines(content: Str, start_line: Int, end_line: Int) -> Str {
    let mut _line_num = 1
    let mut _line_start = 0
    let mut capture_start = -1
    let mut i = 0
    while i <= content.byte_len() {
        if i == content.byte_len() || content.byte_at(i) == 10 { // '\n'
            if _line_num == start_line {
                capture_start = _line_start
            }
            if _line_num == end_line {
                let capture_end = i
                if capture_start < 0 {
                    capture_start = _line_start
                }
                return content.byte_slice(capture_start, capture_end)
            }
            _line_num = _line_num + 1
            _line_start = i + 1
        }
        i = i + 1
    }
    if capture_start >= 0 {
        return content.byte_slice(capture_start, content.byte_len())
    }
    ""
}

fn symbol_to_full_json(idx: Int) -> Str {
    json_clear()
    let obj = json_new_object()
    json_set(obj, "name", json_new_str(si_sym_name.get(idx).unwrap()))
    json_set(obj, "kind", json_new_str(sym_kind_name(si_sym_kind.get(idx).unwrap())))
    json_set(obj, "module", json_new_str(si_sym_module.get(idx).unwrap()))
    json_set(obj, "signature", json_new_str(si_sym_sig.get(idx).unwrap()))
    json_set(obj, "effects", effects_to_json_node(si_sym_effects.get(idx).unwrap()))
    json_set(obj, "visibility", json_new_str(vis_name(si_sym_vis.get(idx).unwrap())))
    let intent = si_sym_intent.get(idx).unwrap()
    if intent != "" {
        json_set(obj, "intent", json_new_str(intent))
    }
    let doc = si_sym_doc.get(idx).unwrap()
    if doc != "" {
        json_set(obj, "doc", json_new_str(doc))
    }
    let req = si_sym_requires.get(idx).unwrap()
    if req != "" {
        json_set(obj, "requires", json_new_str(req))
    }
    let ens = si_sym_ensures.get(idx).unwrap()
    if ens != "" {
        json_set(obj, "ensures", json_new_str(ens))
    }
    let line = si_sym_line.get(idx).unwrap()
    json_set(obj, "line", json_new_int(line))
    let el = si_sym_end_line.get(idx).unwrap()
    if el > 0 {
        json_set(obj, "end_line", json_new_int(el))
        let file_path = si_sym_file.get(idx).unwrap()
        if file_path != "" {
            let file_content = read_file(file_path)
            if file_content != "" {
                let source = extract_lines(file_content, line, el)
                if source != "" {
                    json_set(obj, "source", json_new_str(source))
                }
            }
        }
    }
    let full_scol = si_sym_col.get(idx).unwrap()
    if full_scol > 0 {
        json_set(obj, "col", json_new_int(full_scol))
    }
    let full_ecol = si_sym_end_col.get(idx).unwrap()
    if full_ecol > 0 {
        json_set(obj, "end_col", json_new_int(full_ecol))
    }
    json_encode(obj)
}

// ── Composable query with layer selection ─────────────────────────────

fn format_symbol_for_layer(layer: Str, idx: Int) -> Str {
    if layer == "intent" {
        return symbol_to_intent_json(idx)
    }
    if layer == "contract" {
        return symbol_to_contract_json(idx)
    }
    if layer == "full" {
        return symbol_to_full_json(idx)
    }
    symbol_to_json(idx)
}

pub fn query_filtered_layer(layer: Str, vis_filter: Int, module_filter: Str, effect_filter: Str, pure_only: Int, name_filter: Str) -> Str {
    let mut items = ""
    let mut _first = 1
    let mut i = 0
    while i < si_sym_count {
        if si_sym_kind.get(i).unwrap() != SK_FN {
            i = i + 1
            continue
        }
        if vis_filter == VIS_PUB && si_sym_vis.get(i).unwrap() != VIS_PUB {
            i = i + 1
            continue
        }
        if module_filter != "" && si_sym_module.get(i).unwrap() != module_filter {
            i = i + 1
            continue
        }
        if effect_filter != "" && effects_contain(si_sym_effects.get(i).unwrap(), effect_filter) == 0 {
            i = i + 1
            continue
        }
        if pure_only != 0 && si_sym_effects.get(i).unwrap() != "" {
            i = i + 1
            continue
        }
        if name_filter != "" && si_sym_name.get(i).unwrap() != name_filter {
            i = i + 1
            continue
        }
        if _first == 0 {
            items = items.concat(",")
        }
        items = items.concat(format_symbol_for_layer(layer, i))
        _first = 0
        i = i + 1
    }
    wrap_results(items)
}

// ── The query `blink query` runs ─────────────────────────────────────

// The module a query names a file by: its file name without the extension.
pub fn query_module_of(source_path: Str) -> Str {
    let name = path_basename(source_path)
    if name.ends_with(".bl") {
        return name.byte_slice(0, name.byte_len() - 3)
    }
    if name.ends_with(".pact") {
        return name.byte_slice(0, name.byte_len() - 5)
    }
    name
}

// Indexes the symbols of source, the text of source_path, on its own: a query reads no
// import. A cold query and the daemon both index through here, so the daemon answers from
// the index a cold query builds. False when the lex or the parse reported an error; the
// index is then left as it was.
pub fn query_index_source(source_path: Str, source: Str) -> Bool ! Lex.Tokenize, Parse, Diag.Report {
    diag_source_file = source_path
    lex(source)
    pos = 0
    let first_node = node_count()
    let program = parse_program()
    attach_comments_pass(program, first_node)
    if diag_count > 0 {
        return false
    }
    si_reset()
    si_build(program, source_path, query_module_of(source_path))
    true
}

// What `blink query` prints for its flags, from the index of source_path. Without --module
// a query lists the file's own module, but a lookup by name looks in each.
pub fn query_answer(source_path: Str, layer: Str, pub_only: Bool, pure_only: Bool, effect_name: Str, module: Str, fn_name: Str) -> Str {
    let lay = if layer == "" { "signature" } else { layer }
    let vis = if pub_only { VIS_PUB } else { -1 }
    let mod_f = if module != "" { module } else if fn_name == "" { query_module_of(source_path) } else { "" }
    let pure = if pure_only { 1 } else { 0 }
    query_filtered_layer(lay, vis, mod_f, effect_name, pure, fn_name)
}
