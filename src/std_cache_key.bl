// The key the stdlib archive cache is stored under. It lives apart from build_stdlib
// so a test can import it: build_stdlib imports cli, whose fn main no test can link.

import sha256.{sha256_hex, sha256_file_hex}

// The archive's C is emitted in process, so the binary to hash is the running one, not a
// build/blinkc beside it: a compiler rebuild need not touch that file, and an installed
// tree has none. "" when the host does not say; a guess from argv[0] could hash a binary
// that is not the one running.
pub fn archive_compiler_path() -> Str {
    runtime_exe_path()
}

// The runtime asks the OS in process, so no child `readlink -f` is needed: macOS before
// 12.3 lacks it.
@ffi("blink_exe_path")
@trusted(audit: "Runtime function: takes no input and returns a GC-owned Str, never NULL.")
fn runtime_exe_path() -> Str ! FFI {}

pub fn sha256_of_file_first(path: Str) -> Str ! IO {
    if path == "" || file_exists(path) == 0 {
        return ""
    }
    return sha256_file_hex(path) ?? ""
}

// The 16-hex digest of a manifest text, ended by a newline when it has none. The keys on disk
// were made by feeding the text to sha256sum through a heredoc, which adds that newline.
pub fn sha256_of_manifest(text: Str) -> Str {
    let body = if text.ends_with("\n") { text } else { "{text}\n" }
    sha256_hex(body).byte_slice(0, 16)
}

// The directory part of a path, as dirname gives it.
fn dir_of(path: Str) -> Str {
    let parts = path.split("/")
    if parts.len() == 1 {
        return "."
    }
    let mut keep: List[Str] = []
    let mut i = 0
    while i < parts.len() - 1 {
        keep.push(parts.get(i).unwrap())
        i = i + 1
    }
    let dir = keep.join("/")
    if dir == "" { "/" } else { dir }
}

// One "<hex>  <path>" line, in the shape sha256sum prints, for each readable file in dir whose
// name starts with prefix and ends with suffix, by byte order. A dotfile is left out, as a glob does.
fn hash_lines(dir: Str, prefix: Str, suffix: Str, out: StringBuilder) ! IO {
    let mut names: List[Str] = []
    for name in list_dir(dir) {
        if name.starts_with(".") || !name.starts_with(prefix) || !name.ends_with(suffix) { continue }
        names.push(name)
    }
    for name in sorted_names(names) {
        add_hash_line("{dir}/{name}", out)
    }
}

fn add_hash_line(path: Str, out: StringBuilder) ! IO {
    match sha256_file_hex(path) {
        Some(hex) => out.write("{hex}  {path}\n")
        None => {}
    }
}

fn sorted_names(xs: List[Str]) -> List[Str] {
    let mut out: List[Str] = []
    for x in xs {
        out.push(x)
        let mut i = out.len() - 1
        while i > 0 && out.get(i - 1).unwrap() > x {
            out.set(i, out.get(i - 1).unwrap())
            i = i - 1
        }
        out.set(i, x)
    }
    out
}

// "" when the compiler binary is missing: a key without it would match an archive that any
// compiler emitted.
pub fn compute_cache_key(compiler: Str, std_dir: Str, rt_path: Str, manifest: Str) -> Str ! IO {
    if compiler == "" || file_exists(compiler) == 0 { return "" }
    // The source tree's runtime.h only includes its runtime_*.h siblings, so those are
    // hashed too. Names sort by byte, so the key does not depend on the locale.
    let mut text = StringBuilder.new()
    text.write("format=2\n")
    text.write(if manifest.ends_with("\n") { manifest } else { "{manifest}\n" })
    add_hash_line(compiler, text)
    hash_lines(std_dir, "", ".bl", text)
    if rt_path != "" {
        add_hash_line(rt_path, text)
        hash_lines(dir_of(rt_path), "runtime", ".h", text)
    }
    let cc = process_run("cc", ["--version"])
    let shown = if cc.out != "" { cc.out } else { cc.err_out }
    text.write("{shown.split("\n").get(0) ?? ""}\n")
    sha256_hex(text.to_str()).byte_slice(0, 16)
}
