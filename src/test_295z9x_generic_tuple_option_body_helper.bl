pub type Cmd { Quit }

// Generic fn that BUILDS and RETURNS a tuple containing Option[Cmd] in its
// body. The body tuple literal must lower to the same canonical name as the
// signature — blink_Tuple3_<M>_Option_<mod>_Cmd_int — or the C compiler
// rejects the return as a type mismatch (bug 295z9x body path).
//
// The tuple is arity-3 and Option-bearing on purpose: a 2-tuple shape collides
// with the common `upd: (M) -> (M, Option[Cmd])` callback whose stale
// cg_current_fn_node masked the bug (a matching-arity sibling annotation made
// the buggy value-driven naming fall back to a correct one). Arity-3 ensures
// no sibling annotation matches, so the fn's own return ann is the only source.
pub fn step[M](model: M, f: fn(M) -> (M, Option[Cmd])) -> (M, Option[Cmd], Int) {
    let mut m = model
    let mut last_cmd: Option[Cmd] = None
    let (m2, cmd) = f(m)
    m = m2
    match cmd {
        Some(_) => last_cmd = cmd
        None => {}
    }
    (m, last_cmd, 0)
}
