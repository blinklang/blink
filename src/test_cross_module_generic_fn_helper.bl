pub fn cmg_identity[T](x: T) -> T {
    x
}

pub fn cmg_first_of[T](a: T, _b: T) -> T {
    a
}

pub fn cmg_pair_first[A, B](a: A, _b: B) -> A {
    a
}

pub fn cmg_pair_second[A, B](_a: A, b: B) -> B {
    b
}

pub type CmgBox[T] { value: T }

pub fn cmg_make_box[T](v: T) -> CmgBox[T] {
    CmgBox { value: v }
}

pub fn cmg_unbox[T](b: CmgBox[T]) -> T {
    b.value
}

pub type CmgPoint { x: Int, y: Int }
