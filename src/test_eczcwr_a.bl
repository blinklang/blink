// eczcwr helper A: defines a struct named Ngx with field `a`.
// A SECOND module (test_eczcwr_b) defines a DIFFERENT struct also named Ngx.
// Per §03_types.md:1038 the name-collision rule is narrowly scoped to
// struct-vs-variant only; two modules each defining `Ngx` is LEGAL and must
// produce DISTINCT C symbols (§07:1801-1816). mod_type_prefix (keyed by bare
// name) collapsed them to one module's prefix (last wins) → "has no member".
pub type Ngx { a: Int }

pub fn make_a() -> Ngx {
    Ngx { a: 1 }
}
