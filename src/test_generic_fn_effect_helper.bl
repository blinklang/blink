// Helper for test_fm6z7n_generic_fn_effect.
// Provides a non-generic effecting fn that the generic monomorph calls.

pub effect FmTele {
    effect Emit {
        fn record(name: Str, value: Int)
    }
}

pub fn fm6_emit(name: Str, val: Int) ! FmTele.Emit {
    fmtele.record(name, val)
}

pub type FmPoint { x: Int, y: Int }
