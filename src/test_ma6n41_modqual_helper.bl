// Helper module for test_ma6n41_generic_typevar_compound_return.bl. A struct
// defined HERE (a non-__main__ module) makes canonical_struct_tag differ from
// the stripped tag, exercising the def-side carrier-name canonicalization fix
// (code-review A#1): a bare-typevar generic return bound to Option[ModStruct]
// must emit the canonical carrier name (blink_Option_<mod>_M9Thing), matching
// the typedef, not the raw stripped blink_Option_M9Thing.
pub type M9Thing { n: Int }
