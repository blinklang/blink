// Module-level `let`s whose type is NOT recoverable from the initializer alone: a
// module-qualified read (`helper.mln_names`) has to come from what typecheck recorded
// for the declaration. Carrier and container types are the ones that spell wrong in C
// when the reader loses the type.

pub let mln_count: Int = 7

pub let mln_names: List[Str] = ["ay", "bee", "see"]

pub let mln_maybe: Option[Int] = Some(41)

pub let mln_scores: Map[Str, Int] = Map()

pub let mln_lists: List[List[Int]] = [[1, 2], [3]]
