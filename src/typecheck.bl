effect TypeCheck {
    effect Register
    effect Resolve
    effect Report
}

// typecheck.bl — Type representation, registries, and type checking
//
// Phase 0: Type registries — registers struct/enum/fn/trait types into pools
// Phase 1: Name resolution — walks function bodies checking identifiers resolve
// Phase 2: Expression type inference — infers types, checks compatibility
//
// The pipeline: lex → parse → typecheck → codegen

// ── Type kinds ──────────────────────────────────────────────────────
// The discriminant of an interned type. A real enum, not a `let` Int: a kind
// reached by an `if k == ...` chain falls through silently to whatever default
// the chain ends in, which is how a speller comes to answer a plausible-wrong
// tag for TyKind.Fn. Typed as TyKind end to end — never
// stored back into an Int: widening an enum to Int throws exhaustiveness away.
pub type TyKind {
    Int, Float, Bool, Str, Void,
    List, Option, Result, Fn, Struct, Enum,
    Typevar, Unknown, Iterator, Handle, Channel, Ptr, Handler,
    Tuple, Map, Bytes, Set, StringBuilder, Template, FfiScope, Raw,
    I8, I16, I32, U8, U16, U32, U64, Char,
    Never
}

// Stable spelling of a kind, for the ty_intern key. A match, not Display: it is
// the one place the whole kind set must be enumerated, so a kind added without
// a spelling fails to compile here rather than colliding in the intern map.
pub fn tk_name(k: TyKind) -> Str {
    match k {
        TyKind.Int => "Int"
        TyKind.Float => "Float"
        TyKind.Bool => "Bool"
        TyKind.Str => "Str"
        TyKind.Void => "Void"
        TyKind.List => "List"
        TyKind.Option => "Option"
        TyKind.Result => "Result"
        TyKind.Fn => "Fn"
        TyKind.Struct => "Struct"
        TyKind.Enum => "Enum"
        TyKind.Typevar => "Typevar"
        TyKind.Unknown => "Unknown"
        TyKind.Iterator => "Iterator"
        TyKind.Handle => "Handle"
        TyKind.Handler => "Handler"
        TyKind.Channel => "Channel"
        TyKind.Ptr => "Ptr"
        TyKind.Tuple => "Tuple"
        TyKind.Map => "Map"
        TyKind.Bytes => "Bytes"
        TyKind.Set => "Set"
        TyKind.StringBuilder => "StringBuilder"
        TyKind.Template => "Template"
        TyKind.Raw => "Raw"
        TyKind.FfiScope => "FFIScope"
        TyKind.I8 => "I8"
        TyKind.I16 => "I16"
        TyKind.I32 => "I32"
        TyKind.U8 => "U8"
        TyKind.U16 => "U16"
        TyKind.U32 => "U32"
        TyKind.U64 => "U64"
        TyKind.Char => "Char"
        TyKind.Never => "Never"
    }
}

// ── Type pool ───────────────────────────────────────────────────────
pub type TypePoolEntry {
    kind: TyKind
    name: Str
    inner1: Int
    inner2: Int
    params_start: Int
    params_count: Int
}
pub let mut ty_pool: List[TypePoolEntry] = []
pub let mut ty_param_list: List[Int] = []
// node id → tid memo. Populated during infer_type in check_types and left
// resident so generate() can consume structured tids instead of re-deriving
// them from string tags. -1 = not-yet-inferred / out of range. Reset in
// init_types alongside ty_pool so a tid can never outlive its pool.
let mut tc_node_tid: List[Int] = []

// MethodCall node id → 1 when its obj Ident is a live VALUE binding (a local
// shadowing a trait/module name), so codegen/mono treat it as an instance call,
// not a qualified trait call. Captured during infer_type while scope is live;
// resident through generate(). Monotonic (only ever set to 1) so a later
// re-inference with scope torn down cannot un-mark it.
let mut tc_mc_obj_value_marks: List[Int] = []

// Ident node id → 1 when that Ident, standing in a callee or qualifier position,
// resolved to a live VALUE binding. Written only while nr scope is live, which is
// the only time the question can be asked; read by tc_stamp_name_child long after
// the scope is gone. Monotonic, like tc_mc_obj_value_marks and for the same reason: a
// later re-inference with the scope torn down must not un-mark what it can no
// longer see. Public so a test can bind a grafted node, which inference never sees.
pub let mut tc_name_position_is_value: List[Int] = []

// MethodCall node id -> 1 + the sublist of its arguments after the receiver, when inference
// typed it as a sealed ops trait's qualified call, `StrOps.len(s)`; 0 otherwise. The build
// rewrites exactly these into method form, so no later stage reads the qualifier. Presized
// and monotonic like tc_mc_obj_value_marks.
let mut tc_sealed_ops_call_marks: List[Int] = []

// The program the rewrite ran on, -1 before it runs, and the calls it rewrote. Both reset
// with the per-node tables, so a new check starts with no rewrite done.
let mut tc_sealed_ops_rewrite_program: Int = -1
let mut tc_sealed_ops_rewritten: Map[Int, Int] = Map()

// Call node → the metavars minted for that call's RETURN-ONLY type params.
// Presized to node_count() with -1 in init_types, exactly like tc_node_tid, so a
// stale index can never survive a pool reset.
//
// TWO LISTS, NOT A MAP, and MEMOIZED PER CALL NODE. infer_type calls
// infer_type_uncached unconditionally, so one call site's return type is
// instantiated many times; without the memo each visit would mint a DIFFERENT α and
// only the last one would ever be constrained — the node's memoized tid would carry
// a bound α while the mono lowering read a fresh unbound one. Sharing α across call
// sites is the opposite failure: `let a: RGT[Int] = mk(); let b: RGT[Str] = mk()`
// would bind whichever ran first and collapse both onto one C type.
//
// tc_ret_mint_start holds the offset of this call's group in tc_ret_mint_tids;
// each group is FULL ARITY, with -1 in the slots that were not minted, so a reader
// can index it positionally against the fn's type-param list with no second table.
let mut tc_ret_mint_start: List[Int] = []
let mut tc_ret_mint_tids: List[Int] = []

// ── Builtin type indices (populated by init_types) ──────────────────
pub let mut TYPE_INT: Int = -1
pub let mut TYPE_FLOAT: Int = -1
pub let mut TYPE_BOOL: Int = -1
pub let mut TYPE_STR: Int = -1
pub let mut TYPE_VOID: Int = -1
let mut TYPE_UNKNOWN: Int = -1
pub let mut TYPE_I8: Int = -1
pub let mut TYPE_I16: Int = -1
pub let mut TYPE_I32: Int = -1
pub let mut TYPE_U8: Int = -1
pub let mut TYPE_U16: Int = -1
pub let mut TYPE_U32: Int = -1
pub let mut TYPE_U64: Int = -1
pub let mut TYPE_CHAR: Int = -1
// The bottom type (sections/03_types.md §3.3). Produced only by a construct that
// PROVABLY diverges, so it is never the type of a value: it is a subtype of every
// type and satisfies any declared return.
pub let mut TYPE_NEVER: Int = -1

// ── Type registries ─────────────────────────────────────────────────
let mut named_type_names: List[Str] = []
let mut named_type_ids: List[Int] = []

type TcStructField {
    struct_id: Int
    name: Str
    type_id: Int
}
let mut sfield_pool: List[TcStructField] = []

type EnumVariantEntry {
    enum_id: Int
    name: Str
    tag: Int
    has_data: Int
    enum_decl: Int
}
let mut evar_pool: List[EnumVariantEntry] = []
// Flat side-table PARALLEL to evar_pool (same index, same length): the AST node that
// declared each variant. A constructor call resolves to a variant SLOT, so the slot is what
// carries the declaration back. The enum-level table cannot: it answers with the enum, and
// is first-declared-wins per bare variant name, so two enums sharing a variant name get one
// answer between them.
let mut evar_decl_nodes: List[Int] = []
// Every evar_pool slot per variant name, in declaration order. Name lookups run once per
// identifier, so they must not scan evar_pool, and a name two enums share must keep both.
let mut evar_slots_by_name: Map[Str, List[Int]] = Map()

fn tc_first_variant_slot(name: Str) -> Int {
    let slots = evar_slots_by_name.get(name) ?? []
    if slots.len() == 0 { return -1 }
    slots.get(0).unwrap()
}

// The enum declaration of the first-declared variant named `name`, or -1.
fn tc_variant_enum_decl_node(name: Str) -> Int {
    let i = tc_first_variant_slot(name)
    if i < 0 { return -1 }
    evar_pool.get(i).unwrap().enum_decl
}

fn tc_variant_decl_node(var_idx: Int) -> Int {
    if var_idx < 0 || var_idx >= evar_decl_nodes.len() { return -1 }
    evar_decl_nodes.get(var_idx).unwrap()
}

type EnumVariantFieldEntry {
    var_idx: Int
    name: Str
    type_id: Int
}
let mut evfield_pool: List[EnumVariantFieldEntry] = []

let mut named_type_map: Map[Str, Int] = Map()
let mut fnsig_map: Map[Str, Int] = Map()
// type name -> its declaration node, which is also the sole store of the @derive facts:
// a parallel table of derive bits would be a second authority to keep in sync, and it
// could not answer for a generic INSTANCE, where `Box[Int]` and `Box[NoHash]` share the
// base name and must not share a verdict. Read it through tc_type_name_derives
// (declaration-level) or tc_tid_derive_fact (per instance).
pub let mut tc_type_decl_nodes: Map[Str, Int] = Map()
// The same declarations keyed by their own tid, for a value whose type was inferred and
// carries no spelling to look up. Two modules may declare one bare name (spec
// sections/03_types.md:1038), which the map above cannot hold both of.
let mut tc_type_decl_node_by_tid: Map[Int, Int] = Map()
// Stored under a tid whose bare name is declared by more than one module. Type
// resolution is still module-blind — it mints ONE tid for every declaration of a bare
// name — so such a tid does not identify the declaration the user wrote and must not
// answer a question about it. Delete this the day resolution mints a tid per
// declaration; the tid then names its own node and there is nothing to be unsure of.
pub let DECL_NODE_AMBIGUOUS: Int = -2
// Bare names two modules both declared. tc_type_decl_nodes keeps only the last
// declaration under such a name, so a lookup that starts from a bare name (an
// INSTANCE tid carries nothing else) must consult this set before trusting it.
let mut tc_type_decl_ambiguous_names: Map[Str, Int] = Map()
// Type-parameter names in scope at the current resolution point, each mapped to a
// nesting count so an inner binder (a generic method of a generic type) can shadow
// an outer one and restore it on exit. A name in this map is a type VARIABLE, not a
// constructor — tc_ctor_arity reports no arity for it, so a binder that shadows a
// type or builtin (`fn f[Channel](x: Channel)`) is not mis-read as that constructor
// and E0303 does not fire on it (sections/03_types.md §3.4:1259).
let mut tc_active_tparams: Map[Str, Int] = Map()
// Which type parameters of a generic declaration reach a Map key or Set element position,
// one role per parameter. Hash is a property of the substituted type
// (sections/03_types.md:1940), so the check waits for the use that substitutes it. Keyed
// by declaration node, types and fns alike.
type HashRole { Free, SetElement, MapKey }
let mut tc_hash_oblig: Map[Int, List[HashRole]] = Map()
// One active type-parameter binding. A frame per binder — not a per-name count — so an
// inner binder that reuses an outer name shadows it: the innermost frame for a name wins.
// A name absent from the stack is not a type parameter (e.g. Self, or an unmodeled builtin
// that lowers to a typevar).
type TpFrame {
    name: Str
    // The NODE that binds this type parameter. A type parameter is identified by its
    // binder, not by its spelling, so `T` of `type Box[T]` and `T` of `fn pick[T, U]` are
    // two types that share a letter. The implicit `Self` frame binds nothing and carries
    // SELF_BINDER_NODE.
    binder: Int
    // The node whose bounds this frame adds: the binder itself, or the `where` constraint
    // that bounds it further. A bound's trait arguments are read off this node, as the
    // pipe-framed names below keep none.
    bounds_node: Int
    // The full trait-bound set (pipe-framed, e.g. "|Add|Ord|Eq|"), read by
    // reject_non_numeric_arith_operand and the E0305 check to decide whether an operation is
    // licensed on a type parameter.
    traits: Str
    // For the implicit `Self` frame of a trait default body, the guarantee-set METHOD names
    // ("|eq|ne|"); type-parameter frames carry an empty set. Read by the E0305 licensing
    // check for method calls on `Self` in a default body (sections/03_types.md "Operations
    // on `Self` in a Default Body").
    methods: Str
}
let mut tc_tp_frames: List[TpFrame] = []
// The trait whose default body is being checked, for the E0305 diagnostic; "" when no
// `Self` frame is active. tc_trait_node_idx maps each registered trait name to its AST node,
// so the guarantee-set closure can traverse user supertraits transitively and a call can read
// where a bound's trait is declared.
let mut tc_current_self_trait: Str = ""
let mut tc_trait_node_idx: Map[Str, Int] = Map()
// Each trait name → the pipe-framed set of its DIRECT declared supertraits, built in
// register_trait (which precedes validate_trait_impls). The E0911 supertrait-obligation
// check reads it to compute the transitive closure a subtrait impl must satisfy.
let mut tc_trait_supers_idx: Map[Str, Str] = Map()

type FnSigEntry {
    name: Str
    ret: Int
    params_start: Int
    params_count: Int
    type_params_start: Int
    type_params_count: Int
    effects_start: Int
    effects_count: Int
    // The declaration this signature was built from, or -1 for an intrinsic, which has
    // none. A call is resolved by finding the signature, so carrying the declaration here
    // is what lets the call record the SAME declaration the signature answered for. A
    // second lookup keyed on the spelling would not: one method name may be written in
    // several impls over one type, and several source-typed `from` impls share both the
    // type and the method name.
    decl: Int
}
let mut fnsig_pool: List[FnSigEntry] = []
// The signature each declaration registered, so a reader holding the declaration gets its
// types without a second lookup by spelling or a read of the declaration's own nodes.
let mut fnsig_by_decl: Map[Int, Int] = Map()
let mut fnsig_param_list: List[Int] = []
// Flat side-table PARALLEL to fnsig_param_list (same index, same length): each parameter's
// declared NAME, or "" for an intrinsic. A keyword argument names its parameter, so without
// this the only pairing available here is positional — and codegen reorders by name
// (reorder_named_args), so a reordered call was checked against one signature and emitted
// against another.
let mut fnsig_param_names: List[Str] = []
// Flat side-table PARALLEL to fnsig_param_list (same index, same length): 1 iff that
// parameter was declared after the `--` separator. The separator is what divides the two
// namespaces a call-site label resolves in, and it lives on the Param node, which no
// consumer of a signature can reach.
let mut fnsig_param_kw: List[Int] = []
// Flat side-table PARALLEL to fnsig_param_list (same index, same length): the NODE of that
// parameter's default value, or -1 when it declares none. A call that omits the argument is
// filled from this node, and the node lives on the declaration, which a call site cannot
// reach.
let mut fnsig_param_default: List[Int] = []
let mut fnsig_type_param_names: List[Str] = []
// Flat side-table PARALLEL to fnsig_type_param_names (same index, same length): the NODE
// that declares that type parameter. A name alone cannot tell two declarations' `T` apart.
let mut fnsig_tparam_nodes: List[Int] = []
// Flat side-table PARALLEL to fnsig_type_param_names (same index, same length):
// 1 iff that type param is RETURN-ONLY — named by the fn's return annotation and by
// no parameter annotation. Only those slots get a call-site metavar; every
// other slot keeps inferring from arguments exactly as before.
//
// It is a side-table rather than an FnSigEntry field because FnSigEntry is by-value
// and already carries the (start, count) pair that indexes the names, so a parallel
// list needs no new bookkeeping and no struct-shape change to a type the whole file
// destructures.
let mut fnsig_tparam_ret_only: List[Int] = []
// Parallel as above: 1 iff a parameter or the return annotation names that type param.
// A 0 slot is one no call can infer, so only written type arguments supply it
// (sections/03_types.md 3.4).
let mut fnsig_tparam_sourced: List[Int] = []
// Flat side-table PARALLEL to fnsig_type_param_names (same index, same length): the
// pipe-framed declared-bound set for that type param (e.g. `|Add|`, `|Ord|Eq|`), as
// produced by tparam_node_bound_traits. register_fn_sig discards the bound annotations
// otherwise, so this is the only channel the call-site bound check (E0306) can read.
let mut fnsig_tparam_bounds: List[Str] = []
let mut fnsig_effect_names: List[Str] = []

let mut tc_trait_names: List[Str] = []
let mut tc_trait_method_names: List[Str] = []
let mut tc_trait_assoc_names: List[Str] = []

// Types with an `impl Display`, for which the compiler synthesizes a sealed
// `display() -> Str`. Keyed on the receiver BASE name and still the sole driver
// of `.display()` resolvability (a name-level "is there any Display impl").
let mut tc_display_impl_types: List[Str] = []

// Parallel to tc_display_impl_types: base name -> the Display impl's node id
// (exact; <=1 per (Trait, base) by §3.6:2370). The node carries the impl's
// binders, receiver type-args and where-bounds, which is everything the
// per-instantiation resolver needs to decide whether a SPECIFIC generic instance
// (`Box[Int]` vs `Box[NoDisplay]`) actually satisfies Display — the base-name set
// above cannot tell those apart.
let mut tc_display_impl_nodes: Map[Str, List[Int]] = Map()

// Typecheck-phase index of which traits define a given method for a
// given type. Built while walking impls (the codegen impl_entries registry is
// empty during typecheck). Drives both the trait-qualified fnsig key and the
// E0522 ambiguity check. tc_method_trait_count holds the distinct-trait count;
// tc_method_trait_names holds " and "-joined names for the diagnostic message.
// Both keyed "{type}\t{method}".
let mut tc_method_trait_count_idx: Map[Str, Int] = Map()
let mut tc_method_trait_names_idx: Map[Str, Str] = Map()
// The same two answers counting each trait ONCE. One trait can own a method for one type
// through several impls: `From` reaches U8 from Int, U16, U32 and U64, four impls of one
// trait declaring one `try_from`. That is four rows in the pair above, which is the count
// the trait-qualified fnsig key wants, and it is not ambiguity -- the conversion keys
// tell those four impls apart, and a call picks one by the argument. Ambiguity is two DIFFERENT traits, so the
// ambiguity reports read these.
let mut tc_method_distinct_trait_count_idx: Map[Str, Int] = Map()
let mut tc_method_distinct_trait_names_idx: Map[Str, Str] = Map()
// Trait-level type-param count keyed by trait NAME, populated in
// register_trait for EVERY trait (methodless or not). validate_trait_impls
// reads this for the E0910 arg-arity check; deriving it from tc_tmsig_pool
// (per-method sigs) missed methodless traits, which have no sig entry.
let mut tc_trait_tparam_count_idx: Map[Str, Int] = Map()
// Binder-recovery index for the canonical monomorphized poly impl
// `impl[T] Trait[T] for List[T]`, keyed "List_{trait}_{method}" -> impl node.
// The MethodCall arm reads it to substitute the impl's `-> T` return type with
// the receiver's List element tid, so the method-call node memoizes a concrete
// tid instead of TYPE_UNKNOWN. Only the canonical shape
// (single binder == receiver's sole type arg, matching validate_trait_impls'
// poly_supported gate) ever registers; every other shape stays absent so the
// arm falls through to today's TYPE_UNKNOWN behavior unchanged.
let mut tc_poly_list_impl_node: Map[Str, Int] = Map()

fn tc_method_traits_key(tname: Str, method: Str) -> Str {
    "{tname}\t{method}"
}

fn tc_record_method_trait(tname: Str, method: Str, trait_name: Str) {
    let key = tc_method_traits_key(tname, method)
    let prev_n = tc_method_trait_count_idx.get(key) ?? 0
    tc_method_trait_count_idx.insert(key, prev_n + 1)
    let prev_names = tc_method_trait_names_idx.get(key) ?? ""
    if prev_names == "" {
        tc_method_trait_names_idx.insert(key, trait_name)
    } else {
        tc_method_trait_names_idx.insert(key, "{prev_names} and {trait_name}")
    }
    let prev_d_names = tc_method_distinct_trait_names_idx.get(key) ?? ""
    if tc_trait_names_list_has(prev_d_names, trait_name) == 0 {
        let d_names = if prev_d_names == "" { trait_name } else { "{prev_d_names} and {trait_name}" }
        tc_method_distinct_trait_names_idx.insert(key, d_names)
        let prev_d = tc_method_distinct_trait_count_idx.get(key) ?? 0
        tc_method_distinct_trait_count_idx.insert(key, prev_d + 1)
    }
}

// Whether a " and "-joined list of trait names already lists this one. Matched on the whole
// name between the joiners, never as a substring: `Ord` must not be found inside `Ordered`.
fn tc_trait_names_list_has(names: Str, one: Str) -> Int {
    if names == one { return 1 }
    if names.starts_with("{one} and ") != 0 { return 1 }
    if names.ends_with(" and {one}") != 0 { return 1 }
    if names.contains(" and {one} and ") != 0 { return 1 }
    0
}

// How many DIFFERENT traits declare `method` for `tname`. >=2 is ambiguity; several impls
// of one trait are not.
fn tc_method_distinct_trait_count(tname: Str, method: Str) -> Int {
    tc_method_distinct_trait_count_idx.get(tc_method_traits_key(tname, method)) ?? 0
}

fn tc_method_distinct_trait_names(tname: Str, method: Str) -> Str {
    tc_method_distinct_trait_names_idx.get(tc_method_traits_key(tname, method)) ?? ""
}

// Count of distinct traits defining `method` for `tname` (the synthesized
// sealed Display.display() is folded in at record time). >=2 ⇒ ambiguous.
fn tc_method_trait_count(tname: Str, method: Str) -> Int {
    tc_method_trait_count_idx.get(tc_method_traits_key(tname, method)) ?? 0
}

// The name a user `impl Trait for <builtin>` header writes for a builtin receiver — "Str",
// "List", "Float" — or "" for a receiver no impl header can name. Keyed on the KIND so the
// answer is the spelling the impl registered under, not a rendering of the whole type.
//
// The set is codegen's, one for one (builtin_receiver_type_name, codegen_types.bl). Answering
// for a kind codegen cannot dispatch — Int, Bool, Ptr, a carrier — would type a call here that
// falls through to the backstop there, moving the error out of typecheck instead of into it.
fn tc_builtin_receiver_name(tid: Int) -> Str {
    let k = type_kind(tid)
    if k == TyKind.Str || k == TyKind.List || k == TyKind.Map || k == TyKind.Set { return tk_name(k) }
    if k == TyKind.Bytes || k == TyKind.StringBuilder || k == TyKind.Template || k == TyKind.Float { return tk_name(k) }
    // The scalars. §3c "No Inherent Methods" gives a user trait to any receiver, and the
    // caller's own arm already names Int; without these three the arm skipped them, so the
    // call reached no arm at all, typed as unclaimed, and was refused at the back end.
    if k == TyKind.Int || k == TyKind.Bool || k == TyKind.Char { return tk_name(k) }
    ""
}

fn tc_method_trait_names(tname: Str, method: Str) -> Str {
    tc_method_trait_names_idx.get(tc_method_traits_key(tname, method)) ?? ""
}

// Whether an impl of `tr` written for `tname` records `method`. Matched by whole name, so a
// trait `MyEq` with an `eq` method is not taken for `Eq`.
fn tc_type_writes_trait_method(tname: Str, method: Str, tr: Str) -> Bool {
    tc_method_trait_names(tname, method).split(" and ").contains(tr)
}

// The sealed built-in List HOF surface (sections/03c_protocols.md:38,
// sections/03_types.md:531). A user poly-impl method reusing one of these names
// collides with the sealed method, so the name counts as one ambiguity owner.
pub fn tc_is_sealed_list_hof(method: Str) -> Int {
    if method == "fold" || method == "for_each" || method == "any" || method == "all" || method == "map" || method == "filter" { return 1 }
    0
}

// Eager List adapters are typed by the List dispatch block below, not the sealed
// HOF table above; mono and cg_call both read this one row so neither can drift.
pub fn tc_is_list_generic_adapter(method: Str) -> Int {
    if method == "skip" || method == "enumerate" || method == "zip" || method == "find" || method == "flat_map" { return 1 }
    if method == "sort" || method == "sort_by" { return 1 }
    0
}

// The std.map generic a Map method stands for, or "". mono and cg_call both read this one
// row so neither can drift.
pub fn tc_map_generic_adapter(kind: TyKind, method: Str) -> Str {
    if kind == TyKind.Map && method == "entries" { return "map_entries" }
    ""
}

pub fn tc_map_generic_adapter_module() -> Str { "std_map" }

// The Iterator methods codegen routes to std.iter's `iter_<method>` generics, matching the
// Iterator dispatch block below. mono and cg_call both read this row so neither can drift.
pub fn tc_is_iterator_method(method: Str) -> Int {
    if method == "map" || method == "filter" || method == "take" || method == "skip" || method == "chain" { return 1 }
    if method == "enumerate" || method == "zip" || method == "flat_map" || method == "collect" || method == "count" { return 1 }
    if method == "for_each" || method == "any" || method == "all" || method == "find" || method == "fold" { return 1 }
    0
}

// The fnsig key for an impl method, from the trait's identity. One type takes many From and
// TryFrom impls, so their keys hold the impl itself where the C stem holds the source. Every
// reader of the key has the impl in hand, and only cname spells the source: a second
// spelling here could name an alias source, or a source with binders, apart from the symbol.
// All other traits use the trait-qualified tc_impl_method_stem.
fn tc_mangle_impl_fnsig(impl_type: Str, trait_key: Str, mname: Str, im: Int) -> Str ! TypeCheck.Resolve, Diag.Report {
    if tc_is_conversion_trait(trait_key) {
        let src = tc_impl_conv_source_tid(im)
        if src >= 0 { return tc_impl_conv_stem(impl_type, trait_key, mname, "{im}") }
    }
    tc_impl_method_stem(impl_type, trait_key, mname)
}

pub fn tc_is_conversion_trait(trait_name: Str) -> Bool {
    trait_name == "From" || trait_name == "TryFrom"
}

// The type a conversion call converts to, read off the type the call answers: a TryFrom call
// answers Result[Target, ConversionError]. -1 when that is not yet a Result.
pub fn tc_conversion_target_of(trait_name: Str, answer: Int) -> Int {
    if trait_name != "TryFrom" { return answer }
    let t = tc_resolve(answer)
    if t < 0 || type_kind(t) != TyKind.Result { return -1 }
    tc_tid_child(t, 0)
}

// `.into()` is From read from the target's side (sections/03_types.md, `Into[T]`). Every pass
// reads the form here so the method name has one home.
pub fn tc_is_into_method(method: Str) -> Bool {
    method == "into"
}

// The trait a static conversion method belongs to, or "" for any other method. Typecheck and
// codegen both enter the source-typed rung through this, so the two ends name one set.
pub fn tc_conversion_trait_of(method: Str) -> Str {
    if method == "from" { return "From" }
    if method == "try_from" { return "TryFrom" }
    ""
}

// Resolved once per impl and on demand, because the fnsig registration loop needs it before
// validate_trait_impls records any receiver. The binders are pushed so `impl[T] From[T]`
// reads its own T; validation is off since the impl header was already checked.
@allow(UnrestoredMutation)
fn tc_impl_conv_source_tid(im: Int) -> Int ! TypeCheck.Resolve, Diag.Report {
    match tc_conv_source_tids.get(im) {
        Some(t) => return t
        None => {}
    }
    let tparams = node_type_params(im)
    if tparams == -1 || sublist_length(tparams) == 0 { return -1 }
    let binders_sl = node_impl_binders(im)
    tc_push_tparam_scope(binders_sl)
    let saved_suppress = tc_suppress_ann_validation
    tc_suppress_ann_validation = 1
    let t = resolve_type_ann(sublist_get(tparams, 0))
    tc_suppress_ann_validation = saved_suppress
    tc_pop_tparam_scope(binders_sl)
    tc_conv_source_tids.insert(im, t)
    t
}

// The source type a From/TryFrom impl converts from, or -1 for any other impl. Pure, so
// cname spells the impl's symbol from the type typecheck resolved and not from the head
// the header wrote: From[List[Int]] and From[List[Str]] are two symbols.
pub fn tc_impl_conv_source(im: Int) -> Int {
    tc_conv_source_tids.get(im) ?? -1
}

// What tc_conversion_impl_for answers for a From of a type to itself (section 3c.2): no impl
// is written for it, and the conversion is the value itself.
pub let CONVERSION_IS_IDENTITY: Int = -2

// What tc_conversion_impl_for answers when more than one impl matches. The no-overlap rule
// keeps two impls from matching one target type, but a bare generic qualifier (`Box.from(x)`)
// leaves the receiver's arguments open, and two impls can each fill them their own way.
pub let CONVERSION_IS_AMBIGUOUS: Int = -3

// The impl a conversion from `source` to `target` runs, CONVERSION_IS_IDENTITY,
// CONVERSION_IS_AMBIGUOUS, or -1 when none is declared. Matched on tids and never on
// spellings, so an alias converts as the type it names. Pure, so codegen reads the answer
// typecheck checked.
pub fn tc_conversion_impl_for(trait_name: Str, source: Int, target: Int) -> Int {
    if trait_name == "From" && tc_tid_same_type(source, target) { return CONVERSION_IS_IDENTITY }
    let found = tc_conversion_impls_matching(trait_name, source, target)
    if found.len() > 1 { return CONVERSION_IS_AMBIGUOUS }
    found.get(0) ?? -1
}

// Every impl of `trait_name` that converts `source` to `target`, in the order a cold load
// parsed them, whatever ids a recheck that kept nodes gave. An impl whose bound definitely
// fails at the call's types does not match, by the judge the overlap check used to let it
// stand beside another impl.
fn tc_conversion_impls_matching(trait_name: Str, source: Int, target: Int) -> List[Int] {
    tc_conversion_impls_matching_at(trait_name, source, target, false)
}

// With `open`, an unbound metavariable in the call's types matches whatever the impl holds
// there: the impls inference could still pick once the call's types settle.
fn tc_conversion_impls_matching_at(trait_name: Str, source: Int, target: Int, open: Bool) -> List[Int] {
    let mut found: List[Int] = []
    for im in tc_conv_source_tids.keys() {
        if tc_impl_trait_id(im) != trait_name { continue }
        let binds = match tc_conversion_match_binds_at(im, source, target, open) {
            Some(b) => b
            None => { continue }
        }
        if tc_impl_bounds_rule_out(im, binds) { continue }
        let mut at = found.len()
        while at > 0 && node_load_rank(found.get(at - 1).unwrap()) > node_load_rank(im) { at = at - 1 }
        found.insert(at, im)
    }
    found
}

// How a diagnostic spells a conversion impl's head: `impl From[List[T]] for Box[T]`, and the
// compiler-provided identity `impl From[T] for T`.
fn tc_conversion_impl_head(im: Int) -> Str {
    if im == CONVERSION_IS_IDENTITY { return "impl From[T] for T" }
    "impl {tc_impl_trait_id(im)}[{tc_type_str(tc_impl_conv_source(im))}] for {tc_type_str(tc_impl_recv_tids.get(im) ?? -1)}"
}

// The binds under which impl `im` converts `source` to `target`, or None when it does not. The
// impl's binders are filled from the source, then from the target, and the heads they fill
// must then be the call's own types, so the two sides cannot fill one binder two ways. A
// static call names a generic receiver bare (`Box.from(xs)`); an impl whose receiver
// arguments are all its binders answers for every instance of it, so the source decides.
pub fn tc_conversion_match_binds(im: Int, source0: Int, target0: Int) -> Option[Map[Str, Int]] {
    tc_conversion_match_binds_at(im, source0, target0, false)
}

fn tc_conversion_match_binds_at(im: Int, source0: Int, target0: Int, open: Bool) -> Option[Map[Str, Int]] {
    let src = tc_conv_source_tids.get(im) ?? -1
    let recv = tc_impl_recv_tids.get(im) ?? -1
    if src < 0 || recv < 0 { return None }
    let no_binds: Map[Str, Int] = Map()
    let source = substitute_typevar_tid(source0, no_binds)
    let target = substitute_typevar_tid(target0, no_binds)
    let mut binds: Map[Str, Int] = Map()
    unify_typevar_binds(src, source, binds)
    let target_decl = tc_tid_decl_node(target)
    let bare_target = target_decl >= 0 && target_decl == tc_tid_decl_node(recv) && tc_tid_struct_arg_count(tc_resolve(target)) == 0
    let bare = tc_impl_is_poly_user(im) && bare_target
    if !bare { unify_typevar_binds(recv, target, binds) }
    let holes: Map[Int, Int] = Map()
    if !tc_tid_same_type_at(substitute_typevar_tid(src, binds), source, open, holes) { return None }
    if !bare && !tc_tid_same_type_at(substitute_typevar_tid(recv, binds), target, open, holes) { return None }
    Some(binds)
}

// A From or TryFrom impl with binders over a declared type, compiled once per instance:
// `impl[T] From[List[T]] for X`, or `for Box[T]` when the receiver's arguments are the binders
// in order. Every binder must appear in the source or the receiver, or no call could say what
// it is. Pure, so mono and codegen read the one decision typecheck made.
pub fn tc_impl_is_poly_conversion(im: Int) -> Bool {
    if !tc_is_conversion_trait(tc_impl_trait_id(im)) { return false }
    let binders = node_impl_binders(im)
    if binders == -1 || sublist_length(binders) == 0 { return false }
    let src = tc_conv_source_tids.get(im) ?? -1
    let recv = tc_impl_recv_tids.get(im) ?? -1
    if src < 0 || recv < 0 { return false }
    if tc_tid_decl_node(recv) < 0 { return false }
    if tc_impl_is_poly_user(im) { return true }
    if tc_tid_struct_arg_count(tc_resolve(recv)) != 0 { return false }
    let mut i = 0
    while i < sublist_length(binders) {
        if !tc_tid_mentions_binder(src, sublist_get(binders, i)) { return false }
        i = i + 1
    }
    true
}

fn tc_tid_mentions_binder(tid0: Int, binder: Int) -> Bool {
    let tid = tc_resolve(tid0)
    if tid < 0 || tid >= ty_pool.len() { return false }
    if type_kind(tid) == TyKind.Typevar { return tc_tid_binder(tid) == binder }
    let n = tc_tid_child_count(tid)
    let mut i = 0
    while i < n {
        if tc_tid_mentions_binder(tc_tid_child(tid, i), binder) { return true }
        i = i + 1
    }
    false
}

// Bare type names declared by more than one module, each with the modules that declare it
// as "|m1|m2|". Only these carry a module in their nominal name; every other type keeps its
// bare spelling, so a program without a namesake registers exactly as before.
let mut tc_namesake_type_modules: Map[Str, Str] = Map()

fn tc_is_namesake_type_name(bare: Str) -> Int {
    if tc_namesake_type_modules.contains_key(bare) { 1 } else { 0 }
}

fn tc_collect_namesake_type_names(types_sl: Int) {
    tc_namesake_type_modules = Map()
    let mut first_module: Map[Str, Str] = Map()
    let mut i = 0
    while i < sublist_length(types_sl) {
        let td = sublist_get(types_sl, i)
        let bare = node_name(td)
        let m = node_module(td)
        match first_module.get(bare) {
            Some(prev) => {
                if prev != m {
                    let mods = tc_namesake_type_modules.get(bare) ?? "|{prev}|"
                    if mods.contains("|{m}|") == 0 {
                        tc_namesake_type_modules.insert(bare, "{mods}{m}|")
                    }
                }
            }
            None => first_module.insert(bare, m)
        }
        i = i + 1
    }
}

// A single-file build tags the program's own nodes "", a package build "__main__".
fn tc_module_key_is_main(m: Str) -> Int {
    if m == "" || m == "__main__" { 1 } else { 0 }
}

// The name a declaration is known by in the type pool: its bare name, or `module.bare` when
// another module declares the same bare name. The main file keeps the bare spelling.
fn tc_nominal_type_name(td: Int) -> Str {
    let bare = node_name(td)
    if tc_is_namesake_type_name(bare) == 0 { return bare }
    let m = node_module(td)
    if tc_module_key_is_main(m) != 0 { return bare }
    "{m}.{bare}"
}

// The pool key of a type name as WRITTEN in the module under check (`Point`, `alpha.Point`).
// Only a namesake goes through lookup; every other name is its own key.
fn tc_written_type_nominal(name: Str) -> Str {
    let segs = name.split(".")
    let bare = segs.get(segs.len() - 1) ?? name
    if tc_is_namesake_type_name(bare) == 0 { return name }
    let t = lookup_named_type(name)
    if t == -1 { return name }
    tc_tid_name(t)
}

// The tid of a STRUCT declared under the bare name `bare` in any module, or -1. A namesake
// is registered only under its module-qualified key, so each declaring module is tried.
fn tc_struct_tid_declared_as(bare: Str) -> Int {
    let mods = match tc_namesake_type_modules.get(bare) {
        Some(v) => v
        None => {
            let t = named_type_map.get(bare) ?? -1
            if t != -1 && type_kind(t) == TyKind.Struct { return t }
            return -1
        }
    }
    for m in mods.split("|") {
        let key = if tc_module_key_is_main(m) != 0 { bare } else { "{m}.{bare}" }
        let t = named_type_map.get(key) ?? -1
        if t != -1 && type_kind(t) == TyKind.Struct { return t }
    }
    -1
}

// What the bare type name `bare` means inside module `reader`: the module's own declaration,
// else the one its import list selects, else a prelude module's, else the bare spelling (the
// main file's, if any).
fn tc_nominal_type_name_in(bare: Str, reader: Str) -> Str {
    let mods = match tc_namesake_type_modules.get(bare) {
        Some(v) => v
        None => return bare
    }
    if tc_module_key_is_main(reader) != 0 {
        if mods.contains("|__main__|") != 0 || mods.contains("||") != 0 { return bare }
    } else if mods.contains("|{reader}|") != 0 {
        return "{reader}.{bare}"
    }
    for source_mod in mods.split("|") {
        if source_mod == "" { continue }
        if is_selected_import(bare, reader, source_mod) != 0 { return "{source_mod}.{bare}" }
    }
    // A prelude module's type is in every module's scope (sections/07 §10.6); a namesake
    // another module declares, the main file's included, is not.
    for source_mod in mods.split("|") {
        if tc_prelude_modules.contains_key(source_mod) { return "{source_mod}.{bare}" }
    }
    bare
}

// The home of a compiler-known type name that a declaration may shadow, as an import path
// names it, and the name as the table of sections/07_trust_modules_metadata.md §10.6 writes
// it, or ("", "") for any other name. This is the one list: is_primitive_type, the shadow
// check, the alias import and W1010 all read it.
fn tc_shadowable_type(name: Str) -> (Str, Str) {
    match name {
        "List" => ("blink.core", "List[T]")
        "Map" => ("blink.core", "Map[K, V]")
        "Set" => ("blink.core", "Set[T]")
        "Option" => ("blink.core", "Option[T]")
        "Result" => ("blink.core", "Result[T, E]")
        "Ordering" => ("blink.core", "Ordering")
        "Iterator" => ("blink.core", "Iterator[T]")
        "Never" => ("blink.core", "Never")
        "Bytes" => ("blink.core", "Bytes")
        "StringBuilder" => ("blink.core", "StringBuilder")
        "Handle" => ("blink.core", "Handle[T]")
        "Channel" => ("blink.core", "Channel[T]")
        "Template" => ("blink.core", "Template[C]")
        "Raw" => ("blink.core", "Raw[Str]")
        "TemplateValue" => ("blink.core", "TemplateValue")
        "ConversionError" => ("blink.core", "ConversionError")
        "Range" => ("blink.core", "Range[T]")
        "Handler" => ("blink.core", "Handler[E]")
        "Ptr" => ("blink.ffi", "Ptr[T]")
        "Buf" => ("blink.ffi", "Buf[T]")
        _ => ("", "")
    }
}

fn tc_shadowable_type_home(name: Str) -> Str {
    tc_shadowable_type(name).0
}

// Whether a declaration may take `name` only by shadowing the compiler-known type.
pub fn tc_is_shadowable_type_name(name: Str) -> Bool {
    tc_shadowable_type_home(name) != ""
}

// The compiler-known type names no declaration may take: literals and `self` produce them in
// every module, so a shadow could not be escaped (sections/07 §10.6).
fn tc_type_name_is_reserved(name: Str) -> Bool {
    match name {
        "Self" => true
        "Int" => true
        "I8" => true
        "I16" => true
        "I32" => true
        "I64" => true
        "U8" => true
        "U16" => true
        "U32" => true
        "U64" => true
        "Float" => true
        "F32" => true
        "F64" => true
        "Str" => true
        "Char" => true
        "Bool" => true
        "Void" => true
        _ => false
    }
}

// `FfiScope` is not a name (§10.6), so a declaration takes it like any other. Written with
// none in scope, it is the scope type misplaced, which FfiScopeNotWithResource explains.
fn tc_is_undeclared_ffi_scope(name: Str) -> Bool {
    name == "FfiScope" && tc_type_declared_in_scope(name) == 0
}

// Whether the module under check has a `type` declaration of a shadowable compiler-known name
// in scope, its own or one its imports select. Where it does, the declaration is what the name
// means and the builtin does not answer (sections/03_types.md, Type Name Resolution). Every
// site that treats the name as the builtin asks this, so resolution and the checks agree.
// A prelude module's declaration of the name (Ordering, ConversionError) is the builtin itself.
fn tc_declaration_shadows_builtin(name: Str) -> Int {
    if tc_shadowable_type_home(name) == "" { return 0 }
    tc_type_declared_in_scope(name)
}

// Whether a `type` declaration of `name` outside the prelude is in scope in the module under
// check, its own or one its imports select.
fn tc_type_declared_in_scope(name: Str) -> Int {
    let cur = nr_current_module
    if tc_prelude_modules.contains_key(cur) { return 0 }
    match tc_namesake_type_modules.get(name) {
        Some(mods) => {
            let meant = tc_nominal_type_name_in(name, cur)
            if meant != name {
                let td = tc_type_decl_nodes.get(meant) ?? -1
                if td != -1 && tc_prelude_modules.contains_key(node_module(td)) { return 0 }
                return 1
            }
            if tc_module_key_is_main(cur) == 0 { return 0 }
            if mods.contains("|__main__|") != 0 || mods.contains("||") != 0 { 1 } else { 0 }
        }
        None => {
            let td = tc_type_decl_nodes.get(name) ?? -1
            if td == -1 { return 0 }
            let m = node_module(td)
            if tc_prelude_modules.contains_key(m) { return 0 }
            if tc_module_key_is_main(m) != 0 { return tc_module_key_is_main(cur) }
            if m == cur { return 1 }
            if is_filtered_for_module(name, m, cur) == 0 { 1 } else { 0 }
        }
    }
}

// The compiler-known type an annotation means, or "" when it means a declaration. A
// parser-built annotation (`T?`, `fn(A) -> B`, `(A, B)`, `handler[E]`) and a name imported
// from the type's home under another name (`import blink.core.{Option as CoreOption}`) mean
// the builtin whatever the module declares; a written shadowable name means it only where no
// declaration takes the name. `ann_node` is -1 where no annotation node exists.
fn tc_compiler_known_type_meant(name: Str, ann_node: Int) -> Str {
    if ann_node != -1 && node_is_compiler_known_type_ann(ann_node) { return name }
    let core = tc_core_type_alias_target(name, nr_current_module)
    if core != "" { return core }
    if tc_shadowable_type_home(name) == "" {
        if tc_type_name_is_undeclarable(name) { return name }
        return if tc_is_undeclared_ffi_scope(name) { name } else { "" }
    }
    if tc_declaration_shadows_builtin(name) != 0 { "" } else { name }
}

// The type an impl header names, resolved in the impl's own module.
fn tc_impl_target_name(im: Int) -> Str {
    let written = node_name(im)
    let spelled = tc_impl_recv_spelling(im)
    if spelled != written { return spelled }
    tc_nominal_type_name_in(written, node_module(im))
}

// The type name an impl header writes, with a name imported from a compiler-known type's home
// under another name read as that type: `impl Tally for CoreList[T]` extends List.
pub fn tc_impl_recv_spelling(im: Int) -> Str {
    let written = node_name(im)
    let core = tc_core_type_alias_target(written, tc_body_module(im))
    if core != "" { core } else { written }
}

// The declaration an impl header names, read in the impl's own module, or -1 when it names a
// compiler-known type: a main-file `type Bytes` is not what `impl Sized for Bytes` in
// lib/std extends.
pub fn tc_impl_owner_decl(im: Int) -> Int {
    let name = node_name(im)
    if name == "" { return -1 }
    let saved = tc_enter_body_module(im)
    let meant = tc_compiler_known_type_meant(name, -1)
    let tid = if meant != "" { -1 } else { lookup_named_type(name) }
    tc_leave_body_module(saved)
    if meant != "" { return tc_prelude_type_decl(meant) }
    if tid < 0 { return -1 }
    tc_tid_decl_node(tid)
}

// The declaration a prelude module gives the compiler-known `name` (ConversionError,
// Ordering), or -1 for one no module declares (List, Bytes).
fn tc_prelude_type_decl(name: Str) -> Int {
    for m in tc_prelude_modules.keys() {
        let td = tc_type_decl_nodes.get(tc_nominal_type_name_in(name, m)) ?? -1
        if td != -1 && tc_prelude_modules.contains_key(node_module(td)) { return td }
    }
    -1
}

// The tid a declaration node registered.
pub fn tc_decl_tid(td: Int) -> Int {
    named_type_map.get(tc_nominal_type_name(td)) ?? -1
}

// The tid of the compiler-known type `name` by the prelude declaration's identity, -1 when
// the program does not load it. A desugaring must reach the builtin through this, not by
// spelling: a module that declares a namesake shadows only what it writes (§10.6).
pub fn tc_compiler_known_tid(name: Str) -> Int {
    let td = tc_prelude_type_decl(name)
    if td == -1 { -1 } else { tc_decl_tid(td) }
}

// Index a declaration under its bare name, under `<module>.<bare>`, and under its tid.
// The bare key is what an unqualified annotation looks up, but it holds only ONE
// declaration, so a second module declaring the same bare name would otherwise answer
// for the first. The qualified key resolves a written `m.Point`; the tid key resolves a
// value whose type was inferred, where no spelling survives to look up.
fn tc_register_type_decl_node(bare: Str, name: Str, tid: Int, td: Int) {
    // Read the previous declaration of this name BEFORE overwriting either key.
    let prev = tc_type_decl_nodes.get(name) ?? -1
    let prev_tid = named_type_map.get(name) ?? -1
    if prev != -1 && prev != td {
        tc_type_decl_node_by_tid.insert(tid, DECL_NODE_AMBIGUOUS)
        if prev_tid != -1 { tc_type_decl_node_by_tid.insert(prev_tid, DECL_NODE_AMBIGUOUS) }
        tc_type_decl_ambiguous_names.insert(name, 1)
    } else {
        tc_type_decl_node_by_tid.insert(tid, td)
    }
    tc_type_decl_nodes.insert(name, td)
    let m = node_source_module(td)
    if m != "" { tc_type_decl_nodes.insert("{m}.{bare}", td) }
}

// The declaration node behind a struct/enum tid: the node registered for the base tid,
// else the node its name indexes (an INSTANCE tid `Box[Int]` is minted per use and never
// registered, so it reaches its base through the name the pool entry carries). -1 when
// no declaration exists; DECL_NODE_AMBIGUOUS when two declarations share one nominal name.
pub fn tc_tid_decl_node(tid0: Int) -> Int {
    let tid = tc_resolve(tid0)
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Struct && t.kind != TyKind.Enum { return -1 }
    let by_tid = tc_type_decl_node_by_tid.get(tid) ?? -1
    if by_tid != -1 { return by_tid }
    if tc_type_decl_ambiguous_names.contains_key(t.name) != 0 { return DECL_NODE_AMBIGUOUS }
    tc_type_decl_nodes.get(t.name) ?? -1
}

// The declaration node for the type `tname`, or -1. The qualified spelling is tried
// FIRST and the bare name only as a fallback: two modules may each declare a type with
// the same bare name (spec sections/03_types.md:1038), and the bare key holds whichever
// registered last, so `m.Point` must resolve through its own module's key or it reads a
// namesake's declaration. The fallback serves an unqualified annotation and a tid base.
fn tc_decl_node_for_type(tname: Str) -> Int {
    let td = tc_type_decl_nodes.get(tname) ?? -1
    if td != -1 { return td }
    tc_type_decl_nodes.get(strip_module_qualifier(tname)) ?? -1
}

// Does the DECLARED type `tname` carry `@derive(tr)`? This is a DECLARATION-level fact:
// for a generic base it says only that the derive is written, which is the whole answer
// for a 0-arg type and merely a precondition for an instance (tc_tid_derive_fact).
fn tc_type_name_derives(tname: Str, tr: Str) -> Int {
    let td = tc_decl_node_for_type(tname)
    if td == -1 { return 0 }
    tc_decl_derives(td, tr)
}

// Does `tname` carry an Eq impl usable by the `==`/`!=` operators?
// Covers BOTH a derive that obliges Eq (Eq itself, or Ord or Hash through their
// supertrait) and a user `impl Eq for T`. The user-impl signal is the trait→method
// index above: an `impl Eq for T` records method `eq` under trait `Eq` for `T`.
fn tc_type_has_eq_impl(tname: Str) -> Int {
    let td = tc_type_decl_nodes.get(tname) ?? -1
    if td != -1 {
        if tc_decl_derives(td, "Eq") != 0 { return 1 }
    }
    if tc_type_writes_trait_method(tname, "eq", "Eq") { return 1 }
    0
}

// Does `tname` carry an Ord impl usable by `<`/`>`/`<=`/`>=`?
// Covers @derive(Ord) and a user `impl Ord for T` (records `cmp` under `Ord`).
fn tc_type_has_ord_impl(tname: Str) -> Int {
    let td = tc_type_decl_nodes.get(tname) ?? -1
    if td != -1 {
        if tc_decl_derives(td, "Ord") != 0 { return 1 }
    }
    if tc_type_writes_trait_method(tname, "cmp", "Ord") { return 1 }
    0
}

pub fn tc_type_has_display_impl(tname: Str) -> Int {
    let mut i = 0
    while i < tc_display_impl_types.len() {
        if tc_display_impl_types.get(i).unwrap() == tname { return 1 }
        i = i + 1
    }
    0
}

// The DIRECT supertraits `trait_name` obliges an impl to satisfy: its declared
// user supers (tc_trait_supers_idx) plus its own built-in super (builtin_trait_supers,
// e.g. Ord → Eq). Pipe-framed. Transitive supers are covered without re-listing them:
// each supertrait's own impl is independently subject to this same check, so the deeper
// obligation is reported against that impl, not stacked onto this one.
fn tc_trait_direct_supers(trait_name: Str) -> Str {
    let mut acc = "|"
    acc = tc_pipe_merge(acc, tc_trait_supers_idx.get(trait_name) ?? "|")
    acc = tc_pipe_add(acc, builtin_trait_supers(trait_name))
    acc
}

// Is there an explicit `impl {sname} for {tname}` among the program's impls?
fn tc_impl_exists(impls_sl: Int, sname: Str, tname: Str) -> Int {
    if impls_sl == -1 { return 0 }
    let mut i = 0
    while i < sublist_length(impls_sl) {
        let other = sublist_get(impls_sl, i)
        if tc_impl_trait_id(other) == sname {
            if node_name(other) == tname { return 1 }
        }
        i = i + 1
    }
    0
}

// Does the receiver type `tname` satisfy supertrait `sname`? For E0911. @derive
// and explicit impls both count. A built-in receiver (not a user-declared type)
// provides the built-in comparison/arithmetic traits intrinsically, so it fails
// open — it is never rejected here.
fn tc_type_satisfies_trait(tname: Str, sname: Str, impls_sl: Int) -> Int {
    if (tc_type_decl_nodes.get(tname) ?? -1) == -1 { return 1 }
    if sname == "Eq" { return tc_type_has_eq_impl(tname) }
    if sname == "Ord" { return tc_type_has_ord_impl(tname) }
    if sname == "Display" { return tc_type_has_display_impl(tname) }
    if sname == "Hash" {
        let td = tc_type_decl_nodes.get(tname) ?? -1
        if td != -1 && tc_decl_derives(td, "Hash") != 0 { return 1 }
        if tc_type_writes_trait_method(tname, "hash", "Hash") { return 1 }
        return 0
    }
    if sname == "Clone" {
        let td = tc_type_decl_nodes.get(tname) ?? -1
        if td != -1 && tc_decl_derives(td, "Clone") != 0 { return 1 }
        if tc_type_writes_trait_method(tname, "clone", "Clone") { return 1 }
        return 0
    }
    // Arithmetic traits are sealed to numerics; a user type can never satisfy one.
    if is_arith_trait_name(sname) != 0 { return 0 }
    tc_impl_exists(impls_sl, sname, tname)
}

// Is `sname` a trait the compiler can auto-derive? Steers the E0911 fix hint.
fn tc_is_derivable_trait(sname: Str) -> Int {
    if sname == "Eq" || sname == "Ord" || sname == "Hash" || sname == "Clone" { return 1 }
    0
}

// Can `.{method}()` resolve on a KNOWN struct/enum type `tname`?
// Allowlist-style and biased FAIL-OPEN: every path that resolves at codegen
// must return 1 here, but any path we cannot model at typecheck also returns 1
// (the codegen E0505 backstop catches genuine misses). Returning 0 emits a hard
// typecheck error, so over-strictness would reject valid programs — including
// the compiler typechecking itself during `task regen`. When unsure: return 1.
fn tc_method_resolvable_on_type(obj_k: TyKind, tname: Str, method: Str) -> Int {
    // (a) user method + ALL trait-impl methods. Trait-impl methods register
    //     under the trait-qualified key `{T}_{trait}_{m}`, so consult
    //     the method→traits index; a bare inherent fnsig `{T}_{m}` still counts.
    if tc_method_trait_count(tname, method) >= 1 { return 1 }
    if lookup_fnsig("{tname}_{method}") != -1 { return 1 }
    // (b) sealed synthesized Display.display() (no user fnsig).
    if method == "display" && tc_type_has_display_impl(tname) != 0 { return 1 }
    // (c) @derive-generated methods — query the annotation via the decl node.
    //     tc_type_decl_nodes covers BOTH structs (850) and enums (902).
    let td = tc_type_decl_nodes.get(tname) ?? -1
    if td != -1 {
        if method == "to_json"   && tc_decl_derives(td, "Serialize")   != 0 { return 1 }
        if method == "from_json" && tc_decl_derives(td, "Deserialize") != 0 { return 1 }
        if method == "eq"        && tc_decl_derives(td, "Eq")          != 0 { return 1 }
        if method == "cmp"       && tc_decl_derives(td, "Ord")         != 0 { return 1 }
        if method == "clone"     && tc_decl_derives(td, "Clone")       != 0 { return 1 }
        if method == "hash"      && tc_decl_derives(td, "Hash")        != 0 { return 1 }
        if method == "debug"     && tc_decl_derives(td, "Debug")       != 0 { return 1 }
    }
    // (c') str-backed enum intrinsics (to_str/from_str) are synthesized in
    //      codegen (codegen_stmt.bl:5983) and not modeled here → fail-open.
    if obj_k == TyKind.Enum && (method == "to_str" || method == "from_str") { return 1 }
    // (d) closure-typed struct field invoked like a method. Closure fields lower
    //     to TyKind.Typevar("Fn"), not a closure kind, so reuse the callable-field
    //     name registry (the same signal that suppresses W0501).
    if obj_k == TyKind.Struct && is_callable_field_name(method) != 0 { return 1 }
    // (e) trait/stdlib methods whose receiver-type resolution is not modeled at
    //     typecheck: `.into()` (From-trait auto-conversion), stdlib-type methods
    //     like `Instant.to_rfc3339()`, channel ops, etc. This is the SAME name
    //     allowlist that suppresses the W0501 name-only warning — reusing it keeps
    //     the hard E0505 and the soft W0501 consistent (no name warns-but-errors).
    //
    //     EXCLUDE `display`/`to_str`/`from_str`: those names live in is_builtin_method
    //     too, but on a struct/enum receiver they are SYNTHESIZED conditionally —
    //     `display` only with an `impl Display` (clause b), `to_str`/`from_str` only
    //     on enums (clause c'). Letting the name-only check resolve them would defeat
    //     the whole point: `.display()` on a type WITHOUT a Display impl must error
    //     here at typecheck, not fall open to the codegen backstop.
    if method != "display" && method != "to_str" && method != "from_str" {
        // `collect` crosses iterator→List; it is the one iterator-exclusive method, not a
        // collection method (§3c.1:18,70,753). On any non-Iterator receiver it must reach
        // E0505 — do not let the name-only allowlist fail it open. An Iterator receiver
        // never gets here: its collect returns in the Iterator dispatch block.
        if method == "collect" && obj_k != TyKind.Iterator { return 0 }
        if is_builtin_method(method) != 0 { return 1 }
    }
    0
}

// E0514 helper: does a type id have a usable Display impl?
// Returns 1 for builtin-scalar Display (Int/Float/Bool/Char/Str) or a user
// type with `impl Display`. Returns 0 for TyKind.Unknown / TyKind.Typevar so callers
// SKIP the check (Display is unknowable for unresolved/generic types).
fn tc_type_id_has_display(tid: Int) -> Int ! TypeCheck.Resolve, Diag.Report {
    let k = type_kind(tid)
    if k == TyKind.Unknown || k == TyKind.Typevar { return 0 }
    if k == TyKind.Int || k == TyKind.Float || k == TyKind.Bool || k == TyKind.Char || k == TyKind.Str { return 1 }
    // Sized integers are Display-able scalars — interpolation lowers them to
    // %lld/%llu just like Int (codegen_expr emit_interp_string, the i8..u64 integer widths).
    if is_sized_int(k) != 0 { return 1 }
    // Tuples derive Display structurally when every element is Display (spec
    // §3.6); codegen renders them "(e0, e1, ...)". An empty tuple has nothing
    // non-Display, so it is trivially Display.
    if k == TyKind.Tuple {
        let te = ty_pool.get(tid).unwrap()
        let mut i = 0
        while i < te.params_count {
            let et = ty_param_list.get(te.params_start + i).unwrap()
            let ek = type_kind(et)
            // Fail-open on unresolved/generic elements — unknowable, not absent.
            if ek != TyKind.Unknown && ek != TyKind.Typevar && tc_type_id_has_display(et) == 0 {
                return 0
            }
            i = i + 1
        }
        return 1
    }
    // Key the Display-impl lookup on the struct/enum BASE name, not type_to_str:
    // a monomorphized instance tid renders as "Box[Int]" but tc_display_impl_types
    // is keyed on the bare declared name "Box" (node_name(im) at registration).
    // Using type_to_str here would miss the impl for any generic struct value that
    // carries an instance tid. strip_module_qualifier mirrors the bare key form; for
    // non-struct/enum kinds type_to_str already returns the plain scalar name, so
    // fall back to it.
    if k == TyKind.Struct || k == TyKind.Enum {
        let base = strip_module_qualifier(ty_pool.get(tid).unwrap().name)
        // Gate on the name-level fact first: no Display impl for this base at all
        // is the existing E0523 (unchanged). This preserves the non-generic path
        // exactly — the base-name answer IS the whole answer for a 0-arg type.
        if tc_type_has_display_impl(base) == 0 { return 0 }
        if tc_tid_struct_arg_count(tid) == 0 { return 1 }
        // Generic INSTANCE (`Box[Int]`): the base-name fact is too coarse — resolve
        // against the impl nodes so `Box[Int]` and `Box[NoDisplay]` can differ. A
        // base may carry several disjoint Display impls (§3.6 coherence is per
        // (Trait, TYPE): `impl Display for Box[Int]` and `... for Box[Str]` are both
        // legal), so THIS instance has Display iff ANY of them applies to it.
        let cands = match tc_display_impl_nodes.get(base) {
            Some(c) => c
            None => { return 1 }
        }
        let mut ci = 0
        while ci < cands.len() {
            let im = cands.get(ci).unwrap()
            // A concrete-receiver impl (`impl Display for Box[Int]`) does not answer
            // for `Box[Str]`; a poly impl answers only when its `where`-bounds are not
            // definitely-unmet (`where T: Display` with T := NoDisplay). Unknown/typevar
            // bounds fail open (regen safety).
            if tc_impl_matches_instance(im, tid) != 0 {
                let binds = tc_impl_binds_for_instance(im, tid)
                if tc_impl_where_bounds_hold(im, binds) != -1 { return 1 }
            }
            ci = ci + 1
        }
        return 0
    }
    tc_type_has_display_impl(type_to_str(tid))
}

// tc_type_id_has_display's answer read from the receivers impl registration recorded. A
// Display impl applies where its receiver matches and tc_impl_bounds_rule_out finds no
// bound that definitely fails; a bound on a program trait is not judged, so it holds.
fn tc_display_fact(tid: Int) -> Int {
    let k = type_kind(tid)
    if k == TyKind.Unknown || k == TyKind.Typevar { return 0 }
    if k == TyKind.Int || k == TyKind.Float || k == TyKind.Bool || k == TyKind.Char || k == TyKind.Str || is_sized_int(k) != 0 { return 1 }
    if k == TyKind.Tuple {
        let te = ty_pool.get(tid).unwrap()
        let mut i = 0
        while i < te.params_count {
            let et = ty_param_list.get(te.params_start + i).unwrap()
            let ek = type_kind(et)
            if ek != TyKind.Unknown && ek != TyKind.Typevar && tc_display_fact(et) == 0 { return 0 }
            i = i + 1
        }
        return 1
    }
    if k == TyKind.Struct || k == TyKind.Enum {
        let base = strip_module_qualifier(ty_pool.get(tid).unwrap().name)
        if tc_type_has_display_impl(base) == 0 { return 0 }
        if tc_tid_struct_arg_count(tid) == 0 { return 1 }
        let cands = match tc_display_impl_nodes.get(base) {
            Some(c) => c
            None => { return 1 }
        }
        for im in cands {
            let raw = tc_impl_recv_tids.get(im) ?? -1
            if raw < 0 { return 1 }
            let binds: Map[Str, Int] = Map()
            unify_typevar_binds(raw, tid, binds)
            if tc_tid_same_type(substitute_typevar_tid(raw, binds), tid) && !tc_impl_bounds_rule_out(im, binds) { return 1 }
        }
        return 0
    }
    tc_type_has_display_impl(type_to_str(tid))
}

// Tri-state: does the concrete type `concrete_tid` satisfy trait `trait_name`?
//   1 = satisfies, 0 = unknown/skip (Typevar/Unknown or a trait we cannot model
//   → NEVER reject), -1 = definitely does not. Used to enforce impl `where`-bounds
//   per instantiation. A -1 is the only value that turns into E0523.
fn tc_type_satisfies_bound(concrete_tid: Int, trait_name: Str) -> Int ! TypeCheck.Resolve, Diag.Report {
    let k = type_kind(concrete_tid)
    if trait_name == "Display" && k != TyKind.Unknown && k != TyKind.Typevar {
        if tc_type_id_has_display(concrete_tid) != 0 { return 1 }
        return -1
    }
    tc_bound_fact(concrete_tid, trait_name)
}

// tc_type_satisfies_bound's answer read only from what impl registration recorded, so it
// needs no effect and mono can ask it at an instance. The overlap check and conversion
// selection both judge bounds here, so a pair of impls the overlap check let through never
// both answer one call. Display is judged by tc_display_fact.
fn tc_bound_fact(concrete_tid: Int, trait_name: Str) -> Int {
    let k = type_kind(concrete_tid)
    // Unknowable for an unresolved/generic type — fail open, never reject.
    if k == TyKind.Unknown || k == TyKind.Typevar { return 0 }
    if trait_name == "Display" {
        if tc_display_fact(concrete_tid) != 0 { return 1 }
        return -1
    }
    // The derivable traits are read at the instance, through its arguments and the bounds
    // of any impl written for it (tc_trait_need).
    if trait_name == "Debug" || trait_name == "Hash" || trait_name == "Serialize" {
        return tc_derive_only_fact(concrete_tid, trait_name)
    }
    if trait_name == "Eq" || trait_name == "Ord" {
        if tc_tid_has_unbound_metavar(concrete_tid) != 0 { return 0 }
        if tc_trait_need(concrete_tid, trait_name, []).len() == 0 { return 1 }
        return -1
    }
    // The arithmetic traits are sealed to the built-in numeric types (03_types.md:2011),
    // so a concrete type satisfies one iff it is numeric. The top guard already returned
    // 0 for an unresolved/typevar concrete, so a -1 here means a genuinely non-numeric
    // argument (Str/Bool/Char/user) was bound to an arithmetic-bounded param — the ugly
    // `cc` error today, a clean E0306 with this branch.
    if trait_name == "Add" || trait_name == "Sub" || trait_name == "Mul" || trait_name == "Div" || trait_name == "Rem" || trait_name == "Neg" {
        if is_arith_numeric_type(concrete_tid) != 0 { return 1 }
        return -1
    }
    // A user trait we do not model here — fail open. A full impl-registry recursion
    // is not needed: the compiler declares no such where-bound (audited), and
    // an unmodeled bound must never manufacture a false E0523.
    0
}

// The Hash, Debug or Serialize answer for one type, tri-state as tc_type_satisfies_bound's:
// a scalar has each of them, and a type parameter or an unsolved type is not judged. Hash
// has its own closed list, which is narrower: a Float, a container or a tuple holding one
// has no Hash, so a bound, a derive at an instance and a container key all read that list.
fn tc_derive_only_fact(tid: Int, tr: Str) -> Int {
    if tr == "Hash" { return tc_tid_hash_fact(tid) }
    let k = type_kind(tid)
    if k == TyKind.Unknown || k == TyKind.Typevar { return 0 }
    if k == TyKind.Int || k == TyKind.Float || k == TyKind.Bool || k == TyKind.Char || k == TyKind.Str || is_sized_int(k) != 0 { return 1 }
    tc_tid_derive_fact(tid, tr)
}

// Tri-state per-INSTANCE answer for the three @derive-backed traits (Hash / Debug /
// Serialize): 1 satisfies, -1 definitely does not, 0 unknown (never rejects). The base's
// derive is necessary but not sufficient for a generic instance — `@derive(Hash) type
// Box[T] { v: T }` synthesizes a hash that hashes `v`, so `Box[NoHash]` has no usable
// Hash even though `Box` carries the derive. This is the per-instantiation resolution
// tc_type_id_has_display already does for Display; the structural rule replaces Display's
// impl-node walk because these three traits are reachable ONLY through @derive (spec
// §3.4:1908 for Hash; the Debug and Serialize emitters are derive-only), so there are no
// impl nodes to consult.
//
// A field annotated with one of the declaration's type parameters takes that slot's
// concrete argument and must satisfy the trait itself. Every other field was already
// judged against the declaration by the derive-field passes (E0520 / E1401), so it is
// skipped here rather than decided twice. Recursion runs on the instance's arguments,
// which are strictly less nested than the instance, so it terminates.
fn tc_tid_derive_fact(tid: Int, tr: Str) -> Int {
    let base = tc_tid_struct(tid)
    if base == "" { return 0 }
    let mut td = tc_type_decl_node_by_tid.get(tid) ?? -1
    if td == DECL_NODE_AMBIGUOUS { return 0 }
    if td == -1 { td = tc_decl_node_for_type(tc_tid_name(tid)) }
    if td == -1 { return -1 }
    if tc_decl_derives(td, tr) == 0 { return -1 }
    if tc_tid_struct_arg_count(tid) == 0 { return 1 }
    let tps = node_type_params(td)
    let flds = node_fields(td)
    if tps == -1 || flds == -1 { return 1 }
    let mut i = 0
    while i < sublist_length(flds) {
        let f = sublist_get(flds, i)
        if node_kind(f) == NodeKind.TypeVariant {
            let vflds = node_fields(f)
            let mut vi = 0
            while vflds != -1 && vi < sublist_length(vflds) {
                if tc_tparam_field_fact(sublist_get(vflds, vi), tps, tid, tr) == -1 { return -1 }
                vi = vi + 1
            }
        } else {
            if tc_tparam_field_fact(f, tps, tid, tr) == -1 { return -1 }
        }
        i = i + 1
    }
    1
}

// One field of a generic declaration, judged against the instance `tid`. Answers -1 only
// when a type parameter occurring in the field's annotation is bound to an argument that
// definitely lacks the trait; every other shape answers 0 (skip).
fn tc_tparam_field_fact(f: Int, tps: Int, tid: Int, tr: Str) -> Int {
    tc_ann_tparam_fact(node_value(f), tps, tid, tr)
}

// A type parameter binds its slot's argument to the trait wherever it occurs in `ann`,
// not only when it IS the whole annotation: a derived impl must traverse every field, and
// every container it can traverse imposes the same trait on its own element. So
// `inner: Box[T]` is judged exactly like `v: T`, one level deeper.
fn tc_ann_tparam_fact(ann: Int, tps: Int, tid: Int, tr: Str) -> Int {
    if ann == -1 { return 0 }
    let aname = node_name(ann)
    let mut i = 0
    while i < sublist_length(tps) {
        if node_name(sublist_get(tps, i)) == aname {
            let arg = tc_tid_struct_arg_tid(tid, i)
            if arg == -1 { return 0 }
            return tc_derive_only_fact(arg, tr)
        }
        i = i + 1
    }
    let elems = node_elements(ann)
    let mut j = 0
    while elems != -1 && j < sublist_length(elems) {
        if tc_ann_tparam_fact(sublist_get(elems, j), tps, tid, tr) == -1 { return -1 }
        j = j + 1
    }
    0
}

// Does the single Display impl `im` apply to the generic instance `tid`?
//   Concrete receiver (`impl Display for Box[Int]`) → exact structural identity,
//   so it does NOT answer for `Box[Str]`. Poly receiver (`impl[T] .. for Box[T]`)
//   → same base + arity (binding + where-bounds decide the rest).
fn tc_impl_matches_instance(im: Int, tid: Int) -> Int ! TypeCheck.Resolve, Diag.Report {
    let binders = node_impl_binders(im)
    let has_binders = if binders != -1 && sublist_length(binders) > 0 { 1 } else { 0 }
    if has_binders == 0 {
        let recv_tid = tc_impl_recv_tid(im)
        return if tc_tid_same_type(recv_tid, tid) { 1 } else { 0 }
    }
    let recv_args = node_recv_type_args(im)
    let nr = if recv_args == -1 { 0 } else { sublist_length(recv_args) }
    if nr != tc_tid_struct_arg_count(tid) { return 0 }
    1
}

// Discover the impl's binder := concrete-arg map by unifying each receiver
// type-arg annotation (`Box[T]` → `T`) against the instance's per-slot tid
// (`Box[Int]` → Int). Read-only: validation suppressed, binders scoped so a bare
// `T` lowers to a typevar the unifier can bind.
fn tc_impl_binds_for_instance(im: Int, tid: Int) -> Map[Str, Int] ! TypeCheck.Resolve, Diag.Report {
    let mut binds: Map[Str, Int] = Map()
    let recv_args = node_recv_type_args(im)
    if recv_args == -1 { return binds }
    let binders = node_impl_binders(im)
    let saved = tc_suppress_ann_validation
    tc_suppress_ann_validation = 1
    tc_push_tparam_scope(binders)
    let n = sublist_length(recv_args)
    let mut i = 0
    while i < n {
        let ptid = resolve_type_ann(sublist_get(recv_args, i))
        let atid = tc_tid_struct_arg_tid(tid, i)
        if atid != -1 {
            unify_typevar_binds(ptid, atid, binds)
        }
        i = i + 1
    }
    tc_pop_tparam_scope(binders)
    tc_suppress_ann_validation = saved
    binds
}

// The impl's binders as this receiver instance answers them. Empty unless the method belongs
// to a per-instance impl over a user generic type: any other impl's binders are not read off
// the receiver's arguments.
fn tc_impl_binds_at_call(sig: Int, recv: Int) -> Map[Str, Int] ! TypeCheck.Resolve, Diag.Report {
    let none: Map[Str, Int] = Map()
    let im = tc_method_block.get(fnsig_pool.get(sig).unwrap().decl) ?? -1
    if im == -1 || !tc_impl_is_poly_user(im) { return none }
    tc_impl_binds_for_instance(im, recv)
}

// Evaluate the impl's `where`-bounds against the discovered binds. Tri-state
// combine: any definitely-unmet bound (-1) rejects the whole impl; an unbound
// param or an unmodeled bound is skipped (fail open). Returns -1 (reject) or 1.
// A bound on a program trait is judged at its arguments, as a binder's bound is at a call.
fn tc_impl_where_bounds_hold(im: Int, binds: Map[Str, Int]) -> Int ! TypeCheck.Resolve, Diag.Report {
    let wb = node_impl_where_bounds(im)
    if wb == -1 { return 1 }
    let mut i = 0
    while i < sublist_length(wb) {
        let cons = sublist_get(wb, i)
        let pname = node_name(cons)
        let concrete = binds.get(pname) ?? -1
        if concrete != -1 {
            let bounds = node_elements(cons)
            if bounds != -1 {
                let mut j = 0
                while j < sublist_length(bounds) {
                    let trait_name = tc_bound_trait(sublist_get(bounds, j))
                    if tc_type_satisfies_bound(concrete, trait_name) == -1 { return -1 }
                    j = j + 1
                }
            }
            if tc_unmet_user_bound(cons, node_impl_binders(im), -1, tc_resolve(concrete), binds).trait_name != "" { return -1 }
        }
        i = i + 1
    }
    1
}

// Trait method signature registry (for contract validation)
type TraitMethodSigEntry {
    trait_name: Str
    method: Str
    ret_tid: Int
    tparams_start: Int
    tparams_count: Int
    params_start: Int
    params_count: Int
    // The same declaration as a fnsig, for the keyword and count rules of a call the trait
    // alone answers. No name resolves to it.
    sig: Int
}
let mut tc_tmsig_pool: List[TraitMethodSigEntry] = []
// Each trait method param's resolved tid, with Self/trait-tparams/Self.assoc
// left as typevars for per-impl binding by subst_trait_type_tid.
let mut tc_tmsig_param_tids: List[Int] = []
let mut tc_trait_tparam_names: List[Str] = []
// Flat side-table PARALLEL to tc_trait_tparam_names (same index, same length): the NODE
// that declares that trait type parameter, which is the identity a substitution keys on.
let mut tc_trait_tparam_nodes: List[Int] = []

let mut tc_current_fn_ret: Int = -1
// The expression a `with` is holding open, while that expression is being checked. An ffi
// scope frees its allocations when the block ends, so it is only meaningful in this one
// position, and this is how the check below tells that position from every other.
let mut tc_with_resource_node: Int = -1
// The binder of the `let` whose value is being inferred, so the repair an `FfiScope` misuse
// shows carries the author's own name rather than a hardcoded one (§9.1.1).
let mut tc_ffi_scope_binder: Str = ""
// The function whose body is being walked, for the annotations a rule reads off it.
let mut tc_current_fn_node: Int = -1
let mut tc_current_fn_name: Str = ""
// The receiver type of the impl block whose method body is being checked, or -1 outside one
// (free functions, trait default bodies, test blocks). `self` is the only parameter with no
// annotation to resolve, so this is where its type comes from — see tc_record_impl_recv_tid. Set and
// restored by tc_infer_program's impl loop, which is the only place the impl node is in hand.
let mut tc_current_self_tid: Int = -1
// The receiver tid of every impl block that has a `for` clause, keyed by impl node. Written
// once, while validate_trait_impls checks the header; read through tc_impl_recv_tid.
let mut tc_impl_recv_tids: Map[Int, Int] = Map()
// The source tid of every From/TryFrom impl, keyed by impl node. Written through
// tc_impl_conv_source_tid while the impl's methods register.
let mut tc_conv_source_tids: Map[Int, Int] = Map()
// The impls over a user generic type that are checked and emitted per instance: impl node to
// the receiver type's declaration. Written beside the receiver tid; read through
// tc_poly_user_impl_decl.
let mut tc_poly_user_impls: Map[Int, Int] = Map()
// The impl or trait block that declares each method, keyed by method node. A call knows its
// method's declaration, and only the block says what module it reads in and, for an impl,
// what the method's type variables stand for.
let mut tc_method_block: Map[Int, Int] = Map()
// The fnsig KEY of the impl method being checked, or "" outside one. An impl method registers its
// signature under the trait-mangled spelling (tc_mangle_impl_fnsig) but is checked under
// "{impl_type}_{method}", so without this key, tc_check_fn's `lookup_fnsig(fn_name)` misses and
// no impl method's declared return type gets installed — every wrong return escapes to the C
// compiler. The node name stays the display spelling; only the lookup uses this.
let mut tc_current_method_sig_key: Str = ""
// One entry per closure body the type-inference pass is currently inside, innermost last: the
// scope index where that closure's own bindings start, so a binding below the last entry is a
// capture. Its length is the closure depth. tc_current_fn_ret is saved/restored by
// tc_check_fn (and the test-body elaborator) only, so within a closure body it still names
// the ENCLOSING fn's declared return — the closure's own is never installed. Read-only diagnostics tolerate that; an in-place ty_pool MUTATION
// keyed on it does not (see tc_pin_tail_ret_generic's call site in the Return arm).
let mut tc_closure_scope_base: List[Int] = []

// Consume-once marker: tc_check_fn sets it immediately before calling
// tc_check_body on the fn's own body, and tc_check_body's Block arm reads-then-zeroes
// it as its first act. That is what lets the implicit-tail declared-return check run
// for exactly the fn body and for no nested block — if/else, `with`, match arm, loop
// body, closure body all read 0 for free, with no depth arithmetic.
//
// NOT nr_scope_depth. tc_check_test_block does nr_push_scope / tc_check_body /
// nr_pop_scope at the SAME depth as a fn body, so a depth discriminator cannot tell
// the two apart. It installs tc_current_fn_ret = Result[Void, TestError] for a body
// containing `?` and TYPE_VOID otherwise, so the spurious-E0300 hazard is confined to
// the `?` bodies — a Void tail compared against Result[Void, TestError]. Those are a
// minority of the suite, but a depth discriminator has no way to exempt even one.
// NOT a tc_check_body parameter either: it is called from every nested-block
// position in the checker (22 sites today) and the bit is true at exactly one.
let mut tc_fn_body_block: Int = 0

// One-shot marker for tc_check_body: the node it is about to walk produces a consumed value
// (§2.9), from the tail of a value-returning fn down through block, `if`, `match` and `with`
// tails. The walk is the one pass that sees branch scopes, so it owns the value-context checks.
let mut tc_walk_value_tail: Int = 0

let mut tc_errors: List[Str] = []

// ── Deprecation tracking ───────────────────────────────────────────
let mut depr_type_nodes: Map[Str, Int] = Map()

// ── Kind A name-collision tracking (struct name == enum variant name) ──
// Decl nodes captured at registration so the E0518 diagnostic can point a
// primary span at the struct decl and a secondary span at the enum decl.
pub let mut tc_struct_decl_nodes: Map[Str, Int] = Map()

// Dedupe so each colliding name is reported once, not per use site.
let mut tc_collision_reported: Map[Str, Int] = Map()

// Tids of @ffi.struct types, so Ptr[T] is allowed for them. Keyed by tid, not by name: a
// declaration has one type but many spellings, and a name key answers only the spelling that
// happens to match the one the writer chose.
let mut ffi_struct_type_set: Map[Int, Int] = Map()

// Tids of @ffi.opaque handle types, keyed the same way as the @ffi.struct set above and for
// the same reason. Consulted by tc_ptr_pointee_is_valid so an out-param `Ptr[Handle]` (the
// `<c_name>**` mint shape) is a legal FFI inner type, and by the struct-literal head so a
// handle stays sealed to the FFI boundary. The handle itself is never a Ptr, so it needs no
// E0811 carve-out.
let mut ffi_opaque_type_set: Map[Int, Int] = Map()

// Maps a type-alias name (e.g. `type Port = Int`) to its underlying type id.
// Consulted by types_compatible so refinement aliases stay compatible with their base type.
// Keyed by name (not type id) because type ids are pass-dependent across the dual codegen passes.
let mut tc_alias_underlying: Map[Str, Int] = Map()

// The underlying tid of the alias that `name` means, or -1. Keyed by the DECLARATION, so a
// namesake is asked for under the module the reading file selected: the bare key alone
// answers with whichever of the namesakes registered last, which is not a fact about the
// file that wrote the name. A name no module declares twice keeps the plain two-step lookup.
fn tc_alias_underlying_of(name: Str) -> Int {
    let bare = strip_module_qualifier(name)
    if tc_is_namesake_type_name(bare) != 0 {
        return tc_alias_underlying.get(tc_written_type_nominal(name)) ?? -1
    }
    let u = tc_alias_underlying.get(name) ?? -1
    if u != -1 { return u }
    tc_alias_underlying.get(bare) ?? -1
}

// ── Inferred type hints (for LSP inlayHint) ─────────────────────────
pub type HintEntry {
    line: Int
    col: Int
    name: Str
    type_str: Str
    module: Str
}
pub let mut tc_hints: List[HintEntry] = []

// ── Unused import tracking ──────────────────────────────────────────
let mut tc_symbol_module: Map[Str, Str] = Map()
let mut tc_used_modules: Map[Str, Int] = Map()

// The DECLARATION NODE of every top-level `let`, keyed "{module}.{name}", so a
// module-QUALIFIED access can be resolved. Top-level lets are also defined by
// bare name (nr_define_typed, below), which is why the bare form inside the
// declaring module was always typed; the qualified form had nothing to read.
//
// A separate table rather than nr_get_type(name), because the bare-name scope is
// shadowable: with `let count = "s"` in scope, nr_get_type("count") answers the
// LOCAL, and `prov.count` would silently acquire the wrong type. Keying on the
// module makes the lookup immune to that, and the key is the module the QUALIFIER
// resolves to (tc_qualifier_to_module_or_self), not the bare qualifier, so an
// aliased or dotted import resolves the same way.
//
// It maps to the NODE, not to a type: the binding's type lives on the `let` node
// like every other node's does, so this table cannot hold a second, drifting copy
// of it. Both readers — the qualified-access arm below and codegen's
// tc_top_level_let_tid — go from the node to tc_lookup_node_tid.
let mut tc_module_let_decl: Map[Str, Int] = Map()

// The `let` node a module-qualified name declares, or -1 when no module registered it.
// Callers read the binding's type off that node.
pub fn tc_module_let_decl_node(module_name: Str, name: Str) -> Int {
    tc_module_let_decl.get("{module_name}.{name}") ?? -1
}

// Prelude modules (underscore form, e.g. "std_num") and the set of *free
// function* names they export. The prelude provides compiler-known
// types/traits/impls unconditionally (§10.6), but its free functions
// (list_map, parse_int, …) require an explicit import per §3.2.3 — they are
// filtered out of name-resolution scope. compiler.bl seeds the module
// set via tc_set_prelude_modules before check_types.
let mut tc_prelude_modules: Map[Str, Int] = Map()
let mut tc_prelude_free_fn: Map[Str, Int] = Map()

// `mods` are module keys in underscore form ("std_num"), matching node_module
// / tc_symbol_module. compiler.bl's inject_prelude normalizes the dotted
// prelude paths before calling (dots_to_underscores lives there).
pub fn tc_set_prelude_modules(mods: List[Str]) {
    tc_prelude_modules.clear()
    let mut i = 0
    while i < mods.len() {
        tc_prelude_modules.insert(mods.get(i).unwrap(), 1)
        i = i + 1
    }
}

fn tc_mark_symbol_used(name: Str) {
    if nr_current_module != "" && nr_current_module != "__main__" { return }
    if tc_mark_alias_used(name) { return }
    match tc_symbol_module.get(name) {
        Some(mod_name) => tc_used_modules.insert(mod_name, 1)
        None => {}
    }
}

// An alias is known only to the import index of the file that writes it, so no symbol table
// maps its spelling to a module: the entries that bind it are what it uses. When an alias and
// a plain selection bind one spelling, the clash is the one report, so neither entry is
// called unused on top of it.
fn tc_mark_alias_used(name: Str) -> Bool {
    let binds = nr_module_import_index(nr_current_module).get(name) ?? []
    let mut renames = false
    for b in binds {
        if b.member != name { renames = true }
    }
    if !renames { return false }
    for b in binds {
        tc_used_modules.insert(b.source_mod, 1)
    }
    true
}

// The dotted module a top-level symbol resolves to, or "" if unknown.
// Lets the unused-import check (compiler.bl) tell whether a selectively
// imported name is prelude-visible.
pub fn tc_get_symbol_module(name: Str) -> Str {
    match tc_symbol_module.get(name) {
        Some(mod_name) => mod_name
        None => ""
    }
}

fn tc_mark_qualifier_used(qualifier: Str) {
    if nr_current_module != "" && nr_current_module != "__main__" { return }
    if tc_mark_alias_used(qualifier) { return }
    tc_used_modules.insert(qualifier, 1)
    match tc_qualifier_to_module.get(qualifier) {
        Some(mod_name) => tc_used_modules.insert(mod_name, 1)
        None => {}
    }
}

// Whether the program's own module declares a name more than once (E1016). The copies after
// the first are never checked, so no one knows which imports they use.
pub fn tc_main_module_has_duplicates() -> Bool {
    for m in ["", "__main__"] {
        match nr_module_names.get(m) {
            Some(r) => { if r.poisoned.len() > 0 { return true } }
            None => {}
        }
    }
    false
}

pub fn tc_is_module_used(mod_name: Str) -> Int {
    if tc_used_modules.contains_key(mod_name) {
        return 1
    }
    0
}

// ── Incremental filter ──────────────────────────────────────────────
// When enabled, only functions whose names appear in the filter set
// are typechecked. Used by the incremental recheck engine.

let mut tc_inc_enabled: Int = 0
let mut tc_inc_filter: Map[Str, Int] = Map()

// Set while tc_produce_struct_instance_tid's off-path instance-tid producer re-resolves a
// struct's type-args (`Box[Map[Float,Int]]` → recurse into `Map[Float,Int]`). Without this
// flag that re-resolution would emit a net-new, non-deduped E1400 MapKeyNotHashable
// diagnostic from validate_keyed_ann — a byte-identity violation of
// typecheck decisions. The flag suppresses ONLY the hashability diagnostics during that
// off-path pass; tid-building is unaffected, so the captured instance tids are
// byte-identical either way. The live Map/Set annotation (a real `let m: Map[Float,Int]`)
// is resolved with the flag clear and still reports as before.
let mut tc_suppress_ann_validation: Int = 0

// ── Type creation ───────────────────────────────────────────────────

fn new_type(kind: TyKind, name: Str) -> Int {
    let idx = ty_pool.len()
    ty_pool.push(TypePoolEntry { kind: kind, name: name, inner1: -1, inner2: -1, params_start: -1, params_count: 0 })
    idx
}

// The canonical Void tid. A function with no return annotation returns Void, so its
// return tid is TYPE_VOID (mirrors the ret_ann == -1 => TYPE_VOID rule in typecheck).
// Codegen resolves an un-annotated signature's return tid through this so the tid can
// spell "void" itself rather than declining and leaning on the flat carrier.
pub fn tc_void_tid() -> Int {
    TYPE_VOID
}

// ── Compound-type interning ───────────────────────────────────────────
//
// decisions/compiler-type-representation.md:39-47 (Q3, 5-0) mandates full interning:
// "type equality is integer comparison." Mirrors tp_intern/tp_alloc
// (codegen_types.bl:78-92), extended with the variadic ty_param_list slice ty_pool
// additionally carries.
//
// THE CENTRAL INVARIANT: the key is built over the RAW CHILD TIDS AS STORED — never
// tc_resolve'd, never over a child's recursive structure, and ABOVE ALL never with an
// unbound metavar normalized to a common token. make_metavar mints a FRESH, never-interned
// TyKind.Unknown entry for every unannotated `Map()` / `Set()` / `None` / `[]`, and that
// freshness is exactly what lets each one bind independently later (textbook HM). If the
// key ever collapsed two different unbound metavars onto one string, `let a: Option[Int] =
// None; let b: Option[Str] = None` would share one alpha — binding it via `a` would
// silently retype `b`. new_type/make_metavar are deliberately left OUT of the intern path
// so this can never happen by construction; do not "improve" this by normalizing unbound
// tids in the key. The two-fresh-metavars rows of
// tests/test_typecheck_ty_pool_interns_compounds.bl are the
// permanent tripwire for this invariant and must never be deleted.
//
// Safe to share a hit across callers because: (1) a compound ty_pool entry is NEVER
// mutated post-construction except bind_metavar, which is gated to TyKind.Unknown entries only
// and therefore never touches a compound; (2) ty_param_list is append-only (push/clear,
// no set/pop), so a compound's params slice is frozen at construction.
//
// The key is deliberately FINER than tc_tid_same_type on two axes (finer only ever merges
// less, never wrongly collapses): `name` is part of the key for EVERY kind (not just
// TyKind.Struct/TyKind.Enum/TyKind.Typevar), and `name` is RAW, never strip_module_qualifier'd —
// stripping would collapse `helper.Box[Int]` with `Box[Int]` across modules, the exact
// cross-module collision mono_phys_base (codegen_types.bl:1246) exists to prevent.
// Coarser-than-tc_tid_same_type is the one direction that would be unsound.
//
// Sound but INCOMPLETE: interning `Option[alpha]` then later binding alpha := Int does not
// re-key that entry, so a subsequent make_option_type(TYPE_INT) mints a second tid. Closing
// this needs a rehash-on-bind plus tid-forwarding. Annotation-shaped same-type conflicts
// with no metavar involved are unaffected by the gap.
let mut ty_intern: Map[Str, Int] = Map()

fn ty_intern_args_key(args: List[Int]) -> Str {
    let mut s = ""
    let mut i = 0
    while i < args.len() {
        s = "{s},{args.get(i).unwrap()}"
        i = i + 1
    }
    s
}

fn ty_intern_key(kind: TyKind, name: Str, inner1: Int, inner2: Int, args: List[Int]) -> Str {
    "{tk_name(kind)}|{name}|{inner1}|{inner2}|{ty_intern_args_key(args)}"
}

// Interning ctor for the fixed-arity shapes (List/Option/Result/Map/Set): at most two
// scalar inner slots, no ty_param_list involvement.
fn ty_intern_simple(kind: TyKind, name: Str, inner1: Int, inner2: Int) -> Int {
    let key = ty_intern_key(kind, name, inner1, inner2, [])
    match ty_intern.get(key) {
        Some(v) => return v
        None => {}
    }
    let t = new_type(kind, name)
    let e = ty_pool.get(t).unwrap()
    ty_pool.set(t, TypePoolEntry { inner1: inner1, inner2: inner2, ..e })
    ty_intern.insert(key, t)
    t
}

// Interning ctor for the variadic shapes (Tuple/Fn/struct-instance/enum-instance): the
// key is computed from the caller's already-materialized `args` BEFORE any push, so a
// HIT touches ty_param_list not at all — there is no rollback path to get wrong, because
// there is nothing to roll back. A MISS pushes exactly once, in the original order,
// reproducing the pre-interning body byte-for-byte.
fn ty_intern_variadic(kind: TyKind, name: Str, inner1: Int, args: List[Int]) -> Int {
    let key = ty_intern_key(kind, name, inner1, -1, args)
    match ty_intern.get(key) {
        Some(v) => return v
        None => {}
    }
    let t = new_type(kind, name)
    let start = ty_param_list.len()
    let mut i = 0
    while i < args.len() {
        ty_param_list.push(args.get(i).unwrap())
        i = i + 1
    }
    let e = ty_pool.get(t).unwrap()
    ty_pool.set(t, TypePoolEntry { inner1: inner1, params_start: start, params_count: args.len(), ..e })
    ty_intern.insert(key, t)
    t
}

// `pub` FOR THE TEST ONLY — see make_option_type below. List and Set are the two
// containers whose structural child access the collapse leans on hardest, so
// tests/test_typecheck_tid_structural_accessors.bl builds them directly rather than hoping a
// probe program happens to mint the nesting depth a row needs.
pub fn make_list_type(inner: Int) -> Int {
    ty_intern_simple(TyKind.List, "List", inner, -1)
}

// `pub` FOR THE TEST ONLY — same precedent as make_fn_type below: proving the
// collapse-not-interpolate arms in tc_tid_inner_tag/tc_tid_to_c_tag
// requires constructing an Option/Result/Map wrapping an unbound metavar directly, which
// no surface program can do (an unbound metavar never survives to a fully-typechecked
// program — it either binds or raises E0301 at the boundary).
pub fn make_option_type(inner: Int) -> Int {
    ty_intern_simple(TyKind.Option, "Option", inner, -1)
}

pub fn make_result_type(ok_type: Int, err_type: Int) -> Int {
    ty_intern_simple(TyKind.Result, "Result", ok_type, err_type)
}

// TyKind.Fn is the one kind tc_tid_to_c_tag has no arm for, so this is also the way to
// CONSTRUCT the input that proves its ICE_SEG_UNHANDLED_KIND tail actually fires — the gap
// tests/test_fes70z_mono_slot_ice.bl exists to close.
//
// `pub` was once FOR THAT TEST ONLY, because no surface syntax reached here: a closure
// literal inferred as TYPE_UNKNOWN and an `fn(...)` annotation lowered to
// TyKind.Typevar("Fn"). Both are now real callers (infer_type's Closure arm and
// resolve_type_ann's Fn arm), so a Fn tid is ordinary and the fixture is no longer the only
// producer.
pub fn make_fn_type(ret_type: Int, param_types: List[Int]) -> Int {
    ty_intern_variadic(TyKind.Fn, "Fn", ret_type, param_types)
}

// INTERNS — safe because tc_tid_same_type compares TyKind.Typevar by
// name alone (:11672-11673 above), so name-keying IS its equality, and a TyKind.Typevar entry
// is never mutated post-construction (same invariant as every other ty_intern_* ctor).
// A type parameter with no binder in scope. The fallback mints of resolve_type_ann land
// here: `Self.Context`, an effect name used as a type argument, an unknown name in a
// formatter fixture. None of those is a type parameter, and no declaration binds a
// parameter under any of those spellings, so keying them together collides with nothing.
pub let NO_BINDER_NODE: Int = -1
// `Self` binds once per compile, not at a node. It needs an identity distinct from
// NO_BINDER_NODE so an unsolved fallback mint can never be mistaken for the receiver.
pub let SELF_BINDER_NODE: Int = -2
// The type parameters of the builtin signatures (register_builtin_fn_sigs) belong to no
// declaration in the program.
pub let BUILTIN_BINDER_NODE: Int = -3

// The innermost binder of `name`, or NO_BINDER_NODE when `name` is not an active type
// parameter. Scans the frame stack from the top, so an inner declaration's parameter
// shadows an outer one of the same spelling.
fn tc_active_binder_node(name: Str) -> Int {
    let mut i = tc_tp_frames.len() - 1
    while i >= 0 {
        let f = tc_tp_frames.get(i).unwrap()
        if f.name == name { return f.binder }
        i = i - 1
    }
    NO_BINDER_NODE
}

// A typevar is interned per (spelling, binder), so the same letter bound by two
// declarations is two types. inner1 carries the binder: ty_intern_simple already keys on
// it and tc_tid_child_count reports Typevar as a leaf, so no reader walks into it.
fn make_typevar_bound(name: Str, binder: Int) -> Int {
    ty_intern_simple(TyKind.Typevar, name, binder, -1)
}

// The key a substitution binds a type parameter under: its binder AND its spelling.
// The binder alone is not enough, because every fallback mint with no binder in scope
// shares NO_BINDER_NODE -- `Self.Context`, an effect name used as a type argument, an
// unknown name in a fixture. The spelling alone is the bug this pair replaces. Together
// they are exact: one declaration's `T` never keys the same as another's.
pub fn tc_binder_key(binder: Int, name: Str) -> Str {
    "{binder}|{name}"
}

// The binds key of a typevar tid, or "" when the tid is not a typevar.
pub fn tc_tid_typevar_key(tid0: Int) -> Str {
    let t = tc_resolve(tid0)
    if t < 0 || t >= ty_pool.len() { return "" }
    let e = ty_pool.get(t).unwrap()
    if e.kind != TyKind.Typevar { return "" }
    tc_binder_key(e.inner1, e.name)
}

// The node that binds this typevar, or NO_BINDER_NODE when it is not a typevar or has
// no binder in scope.
pub fn tc_tid_binder(tid0: Int) -> Int {
    let t = tc_resolve(tid0)
    if t < 0 || t >= ty_pool.len() { return NO_BINDER_NODE }
    let e = ty_pool.get(t).unwrap()
    if e.kind != TyKind.Typevar { return NO_BINDER_NODE }
    e.inner1
}

// `pub` FOR THE TEST ONLY — see make_option_type above.
pub fn make_typevar(name: Str) -> Int {
    // `Self` is bound by the impl, which is not a type-parameter scope. Pinning it here
    // keeps one key for it whether or not an impl frame happens to be on the stack.
    if name == "Self" { return make_typevar_bound(name, SELF_BINDER_NODE) }
    make_typevar_bound(name, tc_active_binder_node(name))
}

// `pub` FOR THE TEST ONLY — see make_option_type above.
pub fn make_tuple_type(elem_types: List[Int]) -> Int {
    ty_intern_variadic(TyKind.Tuple, "Tuple", -1, elem_types)
}

// A monomorphized struct instance (`Box[Int]`): a fresh TyKind.Struct entry named
// after the generic base, with its concrete type-args stored variadically in
// ty_param_list[params_start .. +params_count] — exactly how make_tuple_type /
// make_fn_type store their element/param tids. The generic base declared by a
// `type Box[T] { .. }` keeps params_count=0; an instance carries params_count>=1.
// This is the tid-pool representation decisions/compiler-type-representation.md
// Q2 (5-0) mandates to close the "concrete inner lives only in codegen's string
// mono registry" split.
//
// INTERNS — two calls with the same (base_name, arg_types) share one tid.
// See the ty_intern_* helpers above `new_type` for the interning invariant.
// tc_tid_same_type remains the sanctioned STRUCTURAL comparison for the residual case
// interning does not close (a compound built over a since-bound metavar) — do not
// deprecate it here.
//
// `pub` FOR THE TEST ONLY — same precedent as make_option_type above:
// tests/test_typecheck_ty_pool_interns_compounds.bl constructs struct-instance tids directly
// to prove the interning invariant at the ctor boundary, not just end-to-end through a
// compiled program.
pub fn make_struct_instance_type(base_name: Str, arg_types: List[Int]) -> Int {
    ty_intern_variadic(TyKind.Struct, base_name, -1, arg_types)
}

// A generic-enum INSTANCE tid (`Tree[Int]`), the enum analogue of
// make_struct_instance_type. Records the concrete type-args variadically
// in ty_param_list[params_start..] so tc_tid_struct_arg_* / tc_tid_struct_mono_name
// (all kind-agnostic once widened to TyKind.Enum) can recover them at codegen, minting
// the mono typedef `blink_Tree_Int` instead of the erased bare `blink_Tree`. INTERNS —
// see make_struct_instance_type above.
//
// `pub` so codegen's set_var_struct can re-intern the enum analogue when it reverse-
// resolves a mangled mono-instance name (Tree_0Int) back to its tid; interning makes
// that re-mint share the def side's entry, not fork a second one.
pub fn make_enum_instance_type(base_name: Str, arg_types: List[Int]) -> Int {
    ty_intern_variadic(TyKind.Enum, base_name, -1, arg_types)
}


// `pub` FOR THE TEST ONLY — see make_option_type above.
pub fn make_map_type(key_type: Int, value_type: Int) -> Int {
    ty_intern_simple(TyKind.Map, "Map", key_type, value_type)
}

// `pub` FOR THE TEST ONLY — see make_list_type above.
pub fn make_set_type(elem_type: Int) -> Int {
    ty_intern_simple(TyKind.Set, "Set", elem_type, -1)
}

// Read-only, and exported so a unit test can BUILD an under-determined type — e.g. to assert
// tc_tid_ct answers -1 for the Unknown kind. The global itself stays private; a test that could
// assign it could invalidate the pool.
pub fn tc_unknown_tid() -> Int { TYPE_UNKNOWN }

// The memo's second absence. -1 says "nobody has typed this"; this says "an inference arm
// looked at this method call and none of them claimed it", which is the one absence the
// total-stamp pass is allowed to pass over. It is NEGATIVE on purpose: every reader already
// treats a negative tid as no type at all, so the reason rides along without ever reading as
// an answer. A real pool index could not, which is why infer_type refuses to memoize
// TYPE_UNKNOWN.
pub fn tc_unclaimed_call_tid() -> Int { -2 }

// True when a tid carries no information about a type. Two spellings reach the same state and
// both must be skipped wherever a type is merged or compared: ABSENCE — -1, or a tid outside
// the pool, meaning nothing has a type here — and the give-up singleton, meaning inference had
// nothing to say. A caller that tests only one of the two treats the other as a real type,
// which is how a -1 element ends up inside a container tid.
pub fn tc_tid_is_no_info(tid: Int) -> Int {
    if tid < 0 { return 1 }
    if tid >= ty_pool.len() { return 1 }
    if tid == TYPE_UNKNOWN { return 1 }
    0
}

// The two one-inner runtime carriers. Until these existed, `new_type` was never
// called with TyKind.Handle or TyKind.Channel, so an annotation naming one fell through
// resolve_type_ann to `make_typevar(name)` — a bare typevar wearing the type's name. Codegen
// meanwhile had the Handle/Channel C type and carried the element in its flat fields, which made
// the flat universe STRICTLY more informative than the tid for these and would have left the
// Stage 3 divergence counter permanently nonzero at those sites with nothing to read. It also
// broke a real program: `iter_tk == TyKind.Channel` is how tc_check_body recognises a channel
// as iterable, and a typevar is not that kind, so ANNOTATING a channel made it un-iterable.
//
// Shaped exactly like make_set_type: one inner, name = the type's own name, so tc_tid_child /
// tc_tid_child_count / the spellers / tk_to_ct all reach them through the arms they already
// had.
//
// The other two unconstructible kinds resolve differently. TyKind.Closure is DELETED, not
// constructed: TyKind.Fn is already constructed (make_fn_type), covers the same surface (a
// closure's declared type is spelled `Fn(..) -> T`), and tk_to_ct collapsed both to void
// anyway. TyKind.Iterator is DEFERRED on a spec question — see the note on its
// tc_tid_child_count arm.
//
// THIS AUDIT WAS INCOMPLETE, and how it was incomplete is the useful part: it enumerated the
// UNCONSTRUCTED MEMBERS of TyKind, and `Handler[E]` was not a member — see make_handler_type
// below, which cost a segfault reachable from safe Blink. "Which enum members are
// unconstructed" is a strictly weaker question than "which annotations reach the make_typevar
// tail", and only the second one would have found it.
pub fn make_handle_type(result_type: Int) -> Int {
    ty_intern_simple(TyKind.Handle, "Handle", result_type, -1)
}

pub fn make_channel_type(elem_type: Int) -> Int {
    ty_intern_simple(TyKind.Channel, "Channel", elem_type, -1)
}

// The sealed, opaque one-inner iterator carrier (sections/03c_protocols.md:38 — "Iterator[T]
// is a built-in, sealed, opaque type, not a user-implementable trait"). Shaped exactly like
// make_channel_type: one inner = the element, name = the type's own name. `.into_iter()` is the
// only door that produces one from a collection, and `.collect()` crosses back to a List.
pub fn make_iterator_type(elem_type: Int) -> Int {
    ty_intern_simple(TyKind.Iterator, "Iterator", elem_type, -1)
}

// The case the audit above missed, because `Handler` was not an unconstructed
// TyKind: it was not a TyKind AT ALL. `Handler[E]` fell through resolve_type_parts to
// `make_typevar("Handler")`, and the Fn arm three screens down names what that costs in one line
// — "a bare typevar unifies with anything". So every handler type compared equal to every other
// type in the language, `let laundered: Int = <Handler[IO]>` typechecked clean, and a handler
// laundered through it into a parameter of a DIFFERENT effect SEGFAULTED: the callee dispatches
// by slot index, so a one-function vtable receiving a four-function dispatch calls a function
// pointer read past the end of the struct. `blink check` said ok.
//
// THE NAME SLOT HOLDS THE EFFECT, which departs from make_handle_type / make_channel_type above
// (name = the type's OWN name) and is not a shortcut. Those two carry their parameter as a child
// tid because a Channel's element IS a type; an effect is not, so there is no tid to put in
// inner1 and the effect has to travel in the only other slot the entry has. It is what the intern
// key discriminates on, which is precisely the identity this fixes, and it is what
// tc_tid_handler_effect hands back to codegen so `resolve_effect_vtable` stays on the codegen side
// where the ue_effects registry lives.
//
// Sub-effects are ROOT-COMPARED, not string-compared — see tc_handler_effect_root.
pub fn make_handler_type(effect_name: Str) -> Int {
    ty_intern_simple(TyKind.Handler, effect_name, -1, -1)
}

// The effect a handler type handles, raw as written (`IO`, `IO.Print`, `Metrics`). "" for any
// other kind, so a caller can use it as its own gate.
pub fn tc_tid_handler_effect(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Handler { return "" }
    t.name
}

// Two handler types are interchangeable exactly when they install into the same effect slot, and
// the slot is chosen by the ROOT effect: resolve_effect_vtable (codegen_types.bl:1455) maps `IO`,
// `IO.Print`, `IO.Log` and `IO.Eprint` all onto `blink_io_vtable`, and groups every user effect by
// `ue.name` with `starts_with("{ue.name}.")`. So comparing roots is not a loosening of the rule —
// it IS the equivalence the C representation already uses, which is why this cannot reject a
// program that works today (lib/std/testing.bl returns Handler[IO.Log] / [IO.Print] / [IO.Eprint]).
//
// It is also representationally EXACT rather than merely convenient, which was measured and not
// assumed: a `handler Metrics.Emit` declaration emits the PARENT'S FULL-SIZE vtable and fills the
// unlisted slots from `blink_ue_metrics_vtable_default` (`__handler_vt_0 = *__handler_0_outer`,
// then override). Two handler types with the same root effect therefore have literally the same C
// type, and slot-index dispatch cannot run off the end of one — which is exactly why the earlier
// crash above needed two DIFFERENT effects.
//
// So the remaining sub-effect question is not about this function. Passing a `Handler[Metrics.Emit]`
// to a `Handler[Metrics]` parameter runs clean and returns the default stub's 0 from an unfilled
// slot: a silent wrong answer, not a safety hole, and an effect-semantics decision (should a
// default stub return a zero value or panic as "unhandled operation"?) rather than a type-identity
// one.
pub fn tc_handler_effect_root(effect_name: Str) -> Str {
    let dot = match effect_name.byte_index_of(".", 0) {
        Some(i) => i
        None => { return effect_name }
    }
    effect_name.byte_slice(0, dot)
}

// The fifth case of the audit above, and the worst of them: TyKind.Ptr did not
// merely go unconstructed, it did not EXIST. Typecheck only ever checked `Ptr[T]` syntactically
// (PtrOutsideFFI, InvalidPtrType), so resolve_type_ann fell through to a
// typevar named "Ptr" — as permissive as TYPE_UNKNOWN, and permissive at the RECEIVER, which is
// why no method arm could have helped. Assigning a Ptr[Pollfd] to a declared Ptr[Int] therefore
// passed typecheck and failed as a raw cc error inside build/, with no span.
//
// One inner = the pointee, shaped like make_handle_type so tc_tid_child / tc_tid_child_count /
// the spellers / tk_to_ct reach it through arms they already had. Interned, so the two Ptr[T]
// mentions in a signature and its call site are integer-equal.
pub fn make_ptr_type(pointee: Int) -> Int {
    ty_intern_simple(TyKind.Ptr, "Ptr", pointee, -1)
}

// The sixth case of the same shape as make_ptr_type above. `Template` is
// claimed by is_primitive_type (:6866) so no user type could have taken the name, and
// resolve_type_parts had no arm for it — so every `tpl: Template[DB]` resolved to
// make_typevar("Template"), permissive at the RECEIVER, which is why the seven introspection
// methods codegen has always emitted could have no return type no matter what arm was added.
//
// One inner = the phantom context (`DB` in `Template[DB]`), shaped like make_ptr_type so
// tc_tid_child / tc_tid_child_count / the spellers / tk_to_ct reach it through arms they
// already have. The phantom is CARRIED, not yet CHECKED: sections/03b_contracts.md:563 states
// that `Template[Shell]` may not be passed where `Template[DB]` is expected, and today it can
// be. That check needs the contexts to be comparable, and the spec's own contexts (`DB`,
// `Shell`) are EFFECT names, which are not in the type namespace — so each resolves to a
// typevar, and typevars unify with anything by design. Carrying the phantom is the
// prerequisite for ever enforcing it; enforcing it is a spec question, filed separately.
pub fn make_template_type(context: Int) -> Int {
    ty_intern_simple(TyKind.Template, "Template", context, -1)
}

// The value `ffi.scope()` produces. Codegen has carried the ffi-scope C type
// (codegen_types.bl:48) and a four-method emitter block (codegen_methods.bl:4886) since the
// FFI surface landed; typecheck had no kind for the scope object at all, so `with ffi.scope()
// as scope` bound the binder at TYPE_UNKNOWN and the RECEIVER was permissive before any
// method arm could run. The sixth and last sighting of the untyped-receiver family.
//
// Childless: a scope is an opaque arena handle, not a container — §07:265-291 gives it three
// operations and no element type. So it takes the same shape as TyKind.Bytes rather than
// TyKind.Ptr, and every structural accessor answers "no children" through arms it already has.
pub fn make_ffi_scope_type() -> Int {
    ty_intern_simple(TyKind.FfiScope, "FFIScope", -1, -1)
}

// §3b.5: `Raw[T]` is a real marker type, not a spelling the compiler matches. Carrying the
// marker in the TYPE is what makes `let t = Raw(table)` the same bypass as the inline
// wrapper: the trigger reads the value, so a binding no longer launders it past the audit.
// One inner, the wrapped type, shaped like make_template_type.
pub fn make_raw_type(inner: Int) -> Int {
    ty_intern_simple(TyKind.Raw, "Raw", inner, -1)
}

// §9.1.1: an `FfiScope` may occur only as the resource of a `with ... as` block. The rule is
// stated over the TYPE, not over the `ffi.scope()` call, because the hazard belongs to the
// value: every excluded position is one the libc arena outlives the block that frees it,
// however the value arrived there. Two reports, one per position the type can appear in.
fn tc_ffi_scope_alloc_help() -> Str {
    "for one plain allocation with GC cleanup, use `alloc_ptr[T]()` instead of a scope"
}

// The `let` -> `with ... as` rewrite is deliberately NOT machine-applicable: no fixer can
// decide where the block should end.
fn tc_report_ffi_scope_value(node: Int, binder: Str) ! Diag.Report {
    let shown = if binder == "" { "<name>" } else { binder }
    diag_error_at("FfiScopeNotWithResource", FFI_SCOPE_NOT_WITH_RESOURCE,
        "an `FfiScope` may occur only as a `with ... as` resource", node,
        "bind it as a `with` resource: `with ffi.scope() as {shown} \{ ... \}`\n{tc_ffi_scope_alloc_help()}")
}

fn tc_report_ffi_scope_ann(node: Int) ! Diag.Report {
    diag_error_at("FfiScopeNotWithResource", FFI_SCOPE_NOT_WITH_RESOURCE,
        "an `FfiScope` may occur only as a `with ... as` resource", node,
        "drop the annotation: a scope is reachable only inside `with ffi.scope() as <name> \{ ... \}`\n{tc_ffi_scope_alloc_help()}")
}

// ── Metavariables (Hindley-Milner inference discipline) ─────────────
//
// A metavariable is a *fresh* TyKind.Unknown pool entry (minted per binding via
// make_metavar), distinct from the single shared TYPE_UNKNOWN sentinel so each
// unannotated `[]` / `None` / `Map()` / `Set()` gets its OWN α that can be pinned
// independently by a later constraining use. This is textbook HM: an α starts
// unbound and is bound in place when unification meets it against a concrete type
// (`xs.push(1)` pins List's element α to Int). Under-determined types (an α still
// unbound at the region boundary) become error[CannotInferType] (E0301) rather
// than the pre-decision silent Void-erasure. Decision: decisions/under-determined-types.md.
//
// Representation rides the existing functional pool (no new store):
//   unbound α : kind == TyKind.Unknown, inner1 == -1   (new_type's default)
//   bound   α : kind == TyKind.Unknown, inner1 == <solution tid>  (>= 0, set via ty_pool.set)
// The shared TYPE_UNKNOWN singleton keeps inner1 == -1 forever (never a per-binding
// α, never bound), so resolve() is the identity on it — Stage-1-safe.

// `pub` FOR THE TEST ONLY — same precedent as make_fn_type. Constructing an unbound
// metavar directly is the only way to prove tc_tid_tag_at's TyKind.Unknown arm
// actually fires at either tag position: no fully-typechecked surface
// program can produce one, since check_types resolves or E0301's every metavar at
// the region boundary before codegen ever sees it.
pub fn make_metavar() -> Int {
    // A fresh, independently-bindable α. NOT the shared TYPE_UNKNOWN singleton.
    new_type(TyKind.Unknown, "?")
}

pub fn tc_is_unbound_metavar(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return 0 }
    if tid == TYPE_UNKNOWN { return 0 }
    let e = ty_pool.get(tid).unwrap()
    if e.kind == TyKind.Unknown && e.inner1 < 0 { return 1 }
    0
}

// Follow a bound metavar to its solution. Identity on concrete types, typevars,
// the shared TYPE_UNKNOWN singleton, and unbound metavars. The step cap is a
// defensive backstop; the occurs-guard in bind_metavar prevents cycles at bind
// time, so in practice the chain is short (path compression optional).
// Named tc_resolve (not bare `resolve`) to avoid a flat-symbol clash with
// pkg.resolver.resolve in the archive-linked build.
pub fn tc_resolve(tid0: Int) -> Int {
    let mut tid = tid0
    let mut steps = 0
    while steps < 10000 {
        if tid < 0 || tid >= ty_pool.len() { return tid }
        let e = ty_pool.get(tid).unwrap()
        if e.kind == TyKind.Unknown && e.inner1 >= 0 {
            tid = e.inner1
            steps = steps + 1
        } else {
            return tid
        }
    }
    tid
}

// Does `needle` (an unbound α) occur inside `hay` after resolution? Guards
// bind_metavar against building an infinitely-recursive type (α := List[α]).
fn tc_occurs_in(needle: Int, hay0: Int) -> Int {
    let hay = tc_resolve(hay0)
    if hay < 0 || hay >= ty_pool.len() { return 0 }
    if hay == needle { return 1 }
    let e = ty_pool.get(hay).unwrap()
    let k = e.kind
    // Every kind tc_unify descends, or a bind through one of them could close a cycle.
    if k == TyKind.List || k == TyKind.Option || k == TyKind.Set || k == TyKind.Channel || k == TyKind.Iterator {
        return tc_occurs_in(needle, e.inner1)
    }
    if k == TyKind.Ptr || k == TyKind.Handle || k == TyKind.Template {
        return tc_occurs_in(needle, e.inner1)
    }
    if k == TyKind.Result || k == TyKind.Map {
        if tc_occurs_in(needle, e.inner1) != 0 { return 1 }
        return tc_occurs_in(needle, e.inner2)
    }
    if k == TyKind.Tuple || k == TyKind.Struct || k == TyKind.Enum || k == TyKind.Fn {
        let mut i = 0
        while i < e.params_count {
            let c = ty_param_list.get(e.params_start + i).unwrap()
            if tc_occurs_in(needle, c) != 0 { return 1 }
            i = i + 1
        }
        // A fn's RETURN is inner1, and it is as much a place for α to hide as a parameter.
        if k == TyKind.Fn { return tc_occurs_in(needle, e.inner1) }
        return 0
    }
    0
}

// Bind an unbound metavar α to a concrete solution by mutating its slot in place
// (the ty_pool.set idiom every make_*_type uses). Returns 1 on success. Refuses a
// self-bind (α := α) and a cyclic bind (α occurs in the solution) — both leave α
// unbound so the region-boundary check can report E0301.
fn bind_metavar(a0: Int, sol0: Int) -> Int {
    let a = tc_resolve(a0)
    let sol = tc_resolve(sol0)
    if tc_is_unbound_metavar(a) == 0 { return 0 }
    if a == sol { return 0 }
    if tc_occurs_in(a, sol) != 0 { return 0 }
    let e = ty_pool.get(a).unwrap()
    ty_pool.set(a, TypePoolEntry { inner1: sol, ..e })
    1
}

// Does `tid` carry an unbound metavariable anywhere in its structure (after
// resolution)? True for a bare unbound α and for any compound that transitively
// contains one (List[α], Map[Str,α], Box[α], (Int, α), …). This is the shared
// under-determined predicate: check_arg_value uses it to decide whether to take
// the unify path, and the Stage-3 region-boundary check uses it to fire E0301.
// NOTE: does NOT reuse tc_tid_encodable — that predicate does not descend
// TyKind.List/TyKind.Set (verified) and would miss an under-determined list element.
fn tc_tid_has_unbound_metavar(tid0: Int) -> Int {
    let tid = tc_resolve(tid0)
    if tid < 0 || tid >= ty_pool.len() { return 0 }
    if tc_is_unbound_metavar(tid) != 0 { return 1 }
    let e = ty_pool.get(tid).unwrap()
    let k = e.kind
    // Channel carries its element in inner1 like List/Option/Set, and is first-class in
    // the metavar machinery alongside them (tc_unify, tc_occurs_in, tc_tid_has_unknown,
    // tc_tid_fill_unknowns, tc_tid_has_bare_typevar all descend it): an unpinned
    // Channel[metavar] is under-determined and E0301, with no unobserved-local carve-out
    // (decisions/under-determined-types.md). A bare Channel in a TYPE position is E0303,
    // not E0301, but that spelling lowers to TYPE_UNKNOWN — not a metavar — so it
    // does not reach this arm.
    // Ptr too: null_ptr()/alloc_ptr() return Ptr[α], and an unpinned binding of one is E0301.
    if k == TyKind.List || k == TyKind.Option || k == TyKind.Set || k == TyKind.Channel || k == TyKind.Iterator || k == TyKind.Handle || k == TyKind.Ptr {
        return tc_tid_has_unbound_metavar(e.inner1)
    }
    if k == TyKind.Result || k == TyKind.Map {
        if tc_tid_has_unbound_metavar(e.inner1) != 0 { return 1 }
        return tc_tid_has_unbound_metavar(e.inner2)
    }
    if k == TyKind.Tuple || k == TyKind.Struct || k == TyKind.Enum || k == TyKind.Fn {
        let mut i = 0
        while i < e.params_count {
            if tc_tid_has_unbound_metavar(ty_param_list.get(e.params_start + i).unwrap()) != 0 { return 1 }
            i = i + 1
        }
        if k == TyKind.Fn { return tc_tid_has_unbound_metavar(e.inner1) }
        return 0
    }
    0
}

// Does `tid` carry the shared TYPE_UNKNOWN HOLE anywhere in its structure? The third member
// of this family, and the one a gate written `tid == TYPE_UNKNOWN` cannot express: `List[?]`
// is not TYPE_UNKNOWN, so a partially erased answer counted as an answer and the
// tc_tid_fill_unknowns recovery below never ran on it.
//
// An unbound metavar is deliberately NOT a hole here. α and `?` are both "not concrete yet",
// but α is solvable — by a later use, an argument unify, or monomorphization — so replacing
// `List[α]` with a concrete memo would PIN it, which is the lossy direction the pin gates
// below refuse. tc_is_unbound_metavar already excludes the TYPE_UNKNOWN singleton, so the two
// predicates partition the two kinds of emptiness rather than overlapping.
pub fn tc_tid_has_unknown(tid0: Int) -> Int {
    let tid = tc_resolve(tid0)
    // Absence counts as a hole for the same reason the give-up singleton does: a memo pinned
    // from a tid that names no type would pin the wrong thing. tc_tid_is_no_info already
    // covers the out-of-range case, so ty_pool.get below is safe.
    if tc_tid_is_no_info(tid) != 0 { return 1 }
    let e = ty_pool.get(tid).unwrap()
    let k = e.kind
    if k == TyKind.List || k == TyKind.Option || k == TyKind.Set || k == TyKind.Channel || k == TyKind.Iterator || k == TyKind.Handle {
        return tc_tid_has_unknown(e.inner1)
    }
    if k == TyKind.Result || k == TyKind.Map {
        if tc_tid_has_unknown(e.inner1) != 0 { return 1 }
        return tc_tid_has_unknown(e.inner2)
    }
    if k == TyKind.Tuple || k == TyKind.Struct || k == TyKind.Enum {
        let mut i = 0
        while i < e.params_count {
            let c = ty_param_list.get(e.params_start + i).unwrap()
            if tc_tid_has_unknown(c) != 0 { return 1 }
            i = i + 1
        }
        return 0
    }
    0
}

// Fill the HOLES in `base` from the same positions in `src`, position by position, and change
// nothing else. The recovery's take rule: `Result[?, ?]` recovered against a memo
// of `Result[Str, ?]` must become `Result[Str, ?]` — an all-or-nothing "take the memo only if
// it has no hole" rule would refuse it and leave BOTH sides erased, and `Ok(p)` genuinely
// cannot know its error type, so a residual hole is the correct answer there, not a reason to
// decline. Parity with the ordinary path is the bar: `let a = Ok("v")` outside a block infers
// `Result[Str, ?]`, so the same value inside one must not do worse.
//
// Three invariants, each load-bearing:
//   • A concrete position is NEVER overwritten — only a `?` is filled, so this can only add
//     information. That is what makes it safe to run after a compare-free inference.
//   • An unbound metavar is never pinned. tc_tid_has_unknown answers 0 for α, so `Map[α, ?]`
//     against `Map[Str, Int]` yields `Map[α, Int]` and α stays solvable.
//   • Differing kinds return `base` untouched: this is a recovery, not a unifier, and it must
//     never turn a mismatch into agreement.
// Struct/enum instance params are deliberately left alone — their tids are built by the
// generic-instance machinery (tc_*_instance_tid) and reconstructing one here would duplicate
// that path rather than read it.
fn tc_tid_fill_unknowns(base0: Int, src0: Int) -> Int {
    let base = tc_resolve(base0)
    let src = tc_resolve(src0)
    if base == src { return base }
    // Absence is a hole here exactly like the give-up singleton. A position the recovery
    // could not type at all is the position that most needs the memo, so a range guard that
    // returned `base` untouched would decline the one case it exists to repair.
    if tc_tid_is_no_info(src) != 0 { return base }
    if tc_tid_is_no_info(base) != 0 { return src }
    if tc_tid_has_unknown(base) == 0 { return base }
    let eb = ty_pool.get(base).unwrap()
    let es = ty_pool.get(src).unwrap()
    if eb.kind != es.kind { return base }
    if eb.kind == TyKind.List { return make_list_type(tc_tid_fill_unknowns(eb.inner1, es.inner1)) }
    if eb.kind == TyKind.Option { return make_option_type(tc_tid_fill_unknowns(eb.inner1, es.inner1)) }
    if eb.kind == TyKind.Set { return make_set_type(tc_tid_fill_unknowns(eb.inner1, es.inner1)) }
    if eb.kind == TyKind.Channel { return make_channel_type(tc_tid_fill_unknowns(eb.inner1, es.inner1)) }
    if eb.kind == TyKind.Iterator { return make_iterator_type(tc_tid_fill_unknowns(eb.inner1, es.inner1)) }
    if eb.kind == TyKind.Handle { return make_handle_type(tc_tid_fill_unknowns(eb.inner1, es.inner1)) }
    if eb.kind == TyKind.Result {
        return make_result_type(tc_tid_fill_unknowns(eb.inner1, es.inner1), tc_tid_fill_unknowns(eb.inner2, es.inner2))
    }
    if eb.kind == TyKind.Map {
        return make_map_type(tc_tid_fill_unknowns(eb.inner1, es.inner1), tc_tid_fill_unknowns(eb.inner2, es.inner2))
    }
    if eb.kind == TyKind.Tuple {
        if eb.params_count != es.params_count { return base }
        let mut filled: List[Int] = []
        let mut i = 0
        while i < eb.params_count {
            let bc = ty_param_list.get(eb.params_start + i).unwrap()
            let sc = ty_param_list.get(es.params_start + i).unwrap()
            filled.push(tc_tid_fill_unknowns(bc, sc))
            i = i + 1
        }
        return make_tuple_type(filled)
    }
    base
}

// Does `tid` carry a BARE TYPEVAR anywhere in its structure? The structural twin of
// tc_tid_has_unbound_metavar above, and deliberately a separate predicate: α and T are both
// "not concrete yet" but they are not interchangeable, and only one of them is solvable.
//
// A metavar can still be bound — by a later use, an argument-position unify, or
// monomorphization. A bare typevar cannot: as instantiate_return_type's doc spells out,
// tc_is_unbound_metavar counts only TyKind.Unknown with inner1 < 0 and tc_unify's typevar arm
// returns 1 WITHOUT binding, so a bare typevar is invisible to the whole metavar machinery.
// That makes `α := T` a strictly lossy pin — it converts a solvable hole into an unsolvable
// one — which is why the pin caller below refuses a declared type containing one.
pub fn tc_tid_has_bare_typevar(tid0: Int) -> Int { tc_tid_has_typevar_among(tid0, 0) }

// A typevar the declaration being checked does not bind: the formal of some OTHER
// declaration, such as a callee's parameter read off its signature. No substitution
// ever reaches such a slot at this site, so it can never become concrete here.
fn tc_tid_has_foreign_typevar(tid0: Int) -> Int { tc_tid_has_typevar_among(tid0, 1) }

// foreign_only = 1 skips the typevars the declaration being checked binds.
fn tc_tid_has_typevar_among(tid0: Int, foreign_only: Int) -> Int {
    let tid = tc_resolve(tid0)
    if tid < 0 || tid >= ty_pool.len() { return 0 }
    let e = ty_pool.get(tid).unwrap()
    let k = e.kind
    if k == TyKind.Typevar {
        if foreign_only != 0 && tc_typevar_binds_here(tid) != 0 { return 0 }
        return 1
    }
    if k == TyKind.List || k == TyKind.Option || k == TyKind.Set || k == TyKind.Channel || k == TyKind.Iterator {
        return tc_tid_has_typevar_among(e.inner1, foreign_only)
    }
    if k == TyKind.Result || k == TyKind.Map {
        if tc_tid_has_typevar_among(e.inner1, foreign_only) != 0 { return 1 }
        return tc_tid_has_typevar_among(e.inner2, foreign_only)
    }
    if k == TyKind.Tuple || k == TyKind.Struct || k == TyKind.Enum {
        let mut i = 0
        while i < e.params_count {
            let c = ty_param_list.get(e.params_start + i).unwrap()
            if tc_tid_has_typevar_among(c, foreign_only) != 0 { return 1 }
            i = i + 1
        }
        return 0
    }
    0
}

// The machine-applicable annotation shape that would fix an under-determined
// binding, chosen from the empty-ctor's known outer shape.
// `: List[T]` / `: T?` / `: Map[K, V]` / `: Set[T]`; a
// generic construction names its open params. Falls back to ": T" for a bare α.
fn tc_infer_annotation_hint(tid0: Int) -> Str {
    let tid = tc_resolve(tid0)
    if tid < 0 || tid >= ty_pool.len() { return ": T" }
    let e = ty_pool.get(tid).unwrap()
    let k = e.kind
    if k == TyKind.List { return ": List[T]" }
    if k == TyKind.Option { return ": T?" }
    if k == TyKind.Set { return ": Set[T]" }
    if k == TyKind.Channel { return ": Channel[T]" }
    if k == TyKind.Iterator { return ": Iterator[T]" }
    if k == TyKind.Handle { return ": Handle[T]" }
    if k == TyKind.Ptr { return ": Ptr[T]" }
    if k == TyKind.Map { return ": Map[K, V]" }
    if k == TyKind.Result { return ": Result[T, E]" }
    if k == TyKind.Struct || k == TyKind.Enum {
        return ": {strip_module_qualifier(e.name)}[...]"
    }
    // A function value's repair is the annotation that fixes its binders, so the hint keeps the
    // arity the reference already settled and leaves a placeholder only where nothing is known.
    if k == TyKind.Fn {
        let mut ps = ""
        let mut i = 0
        while i < e.params_count {
            if i > 0 { ps = "{ps}, " }
            ps = "{ps}{tc_hint_slot_str(ty_param_list.get(e.params_start + i).unwrap())}"
            i = i + 1
        }
        return ": fn({ps}) -> {tc_hint_slot_str(e.inner1)}"
    }
    ": T"
}

// One slot of an annotation hint: its own spelling when the slot is settled, a placeholder
// when it is the thing nothing determined.
fn tc_hint_slot_str(tid: Int) -> Str {
    if tc_tid_is_no_info(tid) != 0 { return "T" }
    if tc_tid_has_unbound_metavar(tid) != 0 { return "T" }
    type_to_str(tid)
}

// The arguments after the receiver of a sealed ops trait's qualified call `StrOps.len(s)`,
// or -1 when the call is not one. A local that shadows the trait's name makes the call an
// instance call on that value (§3c.4), and a call with no argument has no receiver to take.
//
// Built once per node and kept in the node's mark, so a walk that infers the call again does
// not grow the sublist arena, and the rewrite into method form installs this same list.
fn tc_sealed_ops_qualified_args(node: Int, obj_node: Int) -> Int {
    if obj_node == -1 || node_kind(obj_node) != NodeKind.Ident { return -1 }
    if is_sealed_builtin_trait(node_name(obj_node)) == 0 { return -1 }
    if tc_mc_obj_is_value(node) != 0 { return -1 }
    if node >= tc_sealed_ops_call_marks.len() { return -1 }
    let args = node_args(node)
    if args == -1 || sublist_length(args) == 0 { return -1 }
    let kept = tc_sealed_ops_call_marks.get(node).unwrap()
    if kept != 0 { return kept - 1 }
    let mut rest: List[Int] = []
    let mut i = 1
    while i < sublist_length(args) {
        rest.push(sublist_get(args, i))
        i = i + 1
    }
    let tail = sublist_of(rest)
    tc_sealed_ops_call_marks.set(node, tail + 1)
    tail
}

// The receiver and the arguments of a method call, read the same way for `s.len()` and for
// `StrOps.len(s)`, so every check over a method call holds for both spellings.
fn tc_mc_receiver(node: Int) -> Int {
    if tc_sealed_ops_qualified_args(node, node_obj(node)) != -1 { return sublist_get(node_args(node), 0) }
    node_obj(node)
}

fn tc_mc_call_args(node: Int) -> Int {
    let qualified = tc_sealed_ops_qualified_args(node, node_obj(node))
    if qualified != -1 { return qualified }
    node_args(node)
}

// A method call no arm of the dispatch answered. Its arguments are still inferred, so a
// mistake nested in one is reported: this is what surfaces E0522 for `x.m()` passed to
// io.println.
//
// When the receiver is a BUILTIN type the front end knows and nothing it has answers the
// name, that is a name error, the same one a struct receiver already draws, and nothing later
// can supply the method. Struct and enum receivers never reach here — their own gate answers
// them with the impl registries in hand. The poison return is what keeps this to ONE
// diagnostic: a declared type over the call unifies with the recovery tid instead of drawing
// a second, derived error about a type the program never had.
fn tc_method_call_unanswered(node: Int, method: Str, obj_t: Int, args_sl: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if args_sl != -1 {
        let mut i = 0
        while i < sublist_length(args_sl) {
            infer_type(sublist_get(args_sl, i))
            i = i + 1
        }
    }
    let obj_k = type_kind(obj_t)
    if tc_recv_type_is_determined(obj_k, obj_t) != 0 && tc_method_unavailable_on_receiver(obj_k, method) != 0 {
        let tname = type_to_str(obj_t)
        tc_unresolved_method_hard.insert(node, 1)
        tc_error_naming_types("UnresolvedMethod", UNRESOLVED_METHOD, "unresolved method `.{method}` on type {tname}", node, tc_unresolved_method_help(obj_k, tname, method), [obj_t])
        return tc_error_recovery_tid()
    }
    // Nothing claimed this node, so nothing has typed it — an absence. Codegen's backstop is
    // what names the receiver and the method, so the node says WHY it carries nothing and the
    // stamp pass leaves that report standing.
    if tc_boundary_check_active != 0 { tc_mark_unclaimed_call(node) }
    -1
}

// ── Deferred E0301 blame ────────────────────────────────────────────
//
// E0301 is reported where its repair attaches (decisions/under-determined-types.md,
// amended 2026-07-29). Only a `let` — local or module-level — is both the value's
// materialization site and a span an annotation can attach to, so only a `let` is
// judged at its own scope close. Every other binder class (fn/handler/closure param,
// `with` binder, tuple-destructure leaf, struct-pattern field, as-pattern, match-arm
// leaf) ALIASES a value it did not materialize, and two facts follow:
//
//   * Its scope closes MID-WALK, before a later statement that pins the value has run
//     (`for x in xs { } xs.push(1)`), so its own openness is not yet decidable there.
//   * Its repair does not attach to it — a pattern binder and a closure param carry no
//     annotation of the aliased value — so blaming it would duplicate the owner's
//     report with a span the user cannot act on.
//
// So an alias binder records a blame and the flush at the end of the inference pass
// reports it, but only when the metavar is STILL open and no owning binding claimed it.
// That makes every binder class reportable — an alias whose value has no owning `let`
// (a HOF closure param over an anonymous `[]`) is caught by the flush — without either
// duplicating a report or false-rejecting a later pin.
type TcUdPending {
    name: Str
    tid: Int
    node: Int
}
let mut tc_ud_pending: List[TcUdPending] = []
// Unbound metavars some report has already blamed, keyed by pool id. An unbound metavar
// IS its own identity (tc_is_unbound_metavar: kind Unknown with no solution), so two
// bindings that share one share the same under-determination.
let mut tc_ud_blamed: Map[Int, Int] = Map()
// Each unbracketed generic call's own binder tids, each conversion call's impl binder tids,
// and each bare Map()/Set() key, judged once inference is done: a binder a later statement
// pins is solved by then. A call is walked again after a speculative walk, so the last
// record of a node is the one that counts. A group in tc_call_open_tids is one of
// [sig, self_offset, n, tid..., open...] (tc_note_generic_call),
// [-1, im, n, tid...] (tc_note_conversion_call), [-1, -1, 1, ctor] (tc_note_open_ctor_key) or
// [-2, -1, 0] (tc_note_deferred_conversion).
let mut tc_call_open_calls: List[Int] = []
let mut tc_call_open_group: Map[Int, Int] = Map()
let mut tc_call_open_tids: List[Int] = []
let mut tc_call_reported: Map[Int, Int] = Map()

// Every unbound metavar reachable from `tid`, by pool id. Structural walk in lockstep
// with tc_tid_has_unbound_metavar — that one answers WHETHER a tid is open, this one
// answers WHICH metavars make it so, and a kind added to one belongs in both.
fn tc_ud_metavar_roots(tid0: Int) -> List[Int] {
    let tid = tc_resolve(tid0)
    let mut out: List[Int] = []
    if tid < 0 || tid >= ty_pool.len() { return out }
    if tc_is_unbound_metavar(tid) != 0 {
        out.push(tid)
        return out
    }
    let e = ty_pool.get(tid).unwrap()
    let k = e.kind
    if k == TyKind.List || k == TyKind.Option || k == TyKind.Set || k == TyKind.Channel || k == TyKind.Iterator || k == TyKind.Handle || k == TyKind.Ptr {
        return tc_ud_metavar_roots(e.inner1)
    }
    if k == TyKind.Result || k == TyKind.Map {
        out = tc_ud_metavar_roots(e.inner1)
        let rs = tc_ud_metavar_roots(e.inner2)
        let mut j = 0
        while j < rs.len() {
            out.push(rs.get(j).unwrap())
            j = j + 1
        }
        return out
    }
    if k == TyKind.Tuple || k == TyKind.Struct || k == TyKind.Enum || k == TyKind.Fn {
        let mut i = 0
        while i < e.params_count {
            let rs = tc_ud_metavar_roots(ty_param_list.get(e.params_start + i).unwrap())
            let mut j = 0
            while j < rs.len() {
                out.push(rs.get(j).unwrap())
                j = j + 1
            }
            i = i + 1
        }
        if k == TyKind.Fn {
            let rr = tc_ud_metavar_roots(e.inner1)
            let mut r = 0
            while r < rr.len() {
                out.push(rr.get(r).unwrap())
                r = r + 1
            }
        }
    }
    out
}

fn tc_ud_mark_blamed(tid: Int) {
    let roots = tc_ud_metavar_roots(tid)
    let mut i = 0
    while i < roots.len() {
        tc_ud_blamed.insert(roots.get(i).unwrap(), 1)
        i = i + 1
    }
}

fn tc_ud_already_blamed(tid: Int) -> Int {
    let roots = tc_ud_metavar_roots(tid)
    let mut i = 0
    while i < roots.len() {
        if tc_ud_blamed.contains_key(roots.get(i).unwrap()) { return 1 }
        i = i + 1
    }
    0
}

// The one decision point for a closing binder: report now, or defer. Every binder
// class routes through here, so none can be made unreportable by a call site passing
// the wrong thing. Withholding the node made a class unreportable outright; of the
// classes that did so, only a HOF closure param over an anonymous receiver actually
// escaped, because for the rest an owning `let` or scrutinee holds the same metavar
// and reports at its own site. Routing them all here stops the coverage from resting
// on that coincidence.
//
// A destructuring `for (a, b) in ...` registers its tuple under the parser's internal
// `_tuple` name with no binder node of its own; its leaves carry real IdentPattern
// nodes and are blamed there, so there is nothing to point a caret at here.
//
// `self` is typed from the impl block's receiver (tc_check_fn), never from inference,
// so it can never be under-determined. The guard states that invariant rather than
// leaning on the receiver tid happening to be ground: blaming `self` would name a
// binder the user cannot annotate.
fn tc_ud_judge_binder(vname: Str, tid: Int, decl_node: Int) ! Diag.Report {
    if decl_node == -1 { return }
    if vname == "self" { return }
    if node_kind(decl_node) == NodeKind.LetBinding && !tc_ud_conversion_may_settle(tid) {
        tc_report_under_determined(vname, tid, decl_node)
        return
    }
    tc_ud_pending.push(TcUdPending { name: vname, tid: tid, node: decl_node })
}

// Whether a deferred conversion's choice may still settle `tid`: a side of it holds one of
// its metavariables, and the impl chosen once inference is done fills them as a later use
// does.
fn tc_ud_conversion_may_settle(tid: Int) -> Bool {
    let roots = tc_ud_metavar_roots(tid)
    for call_node in tc_deferred_conversion_calls() {
        let (source, target) = tc_deferred_conversion_sides(call_node)
        for r in tc_ud_metavar_roots(source) { if roots.contains(r) { return true } }
        for r in tc_ud_metavar_roots(target) { if roots.contains(r) { return true } }
    }
    false
}

// Report the deferred alias blames nothing else answered. Runs once, after the whole
// inference pass: a metavar a LATER statement pinned is solved by now and drops out,
// which is what makes deferral sound rather than merely late.
fn tc_ud_flush_pending() ! Diag.Report {
    let mut i = 0
    while i < tc_ud_pending.len() {
        let p = tc_ud_pending.get(i).unwrap()
        if tc_tid_has_unbound_metavar(p.tid) != 0 {
            if tc_ud_already_blamed(p.tid) == 0 {
                tc_report_under_determined(p.name, p.tid, p.node)
            }
        }
        i = i + 1
    }
    tc_ud_pending = []
}

// `names` as the code spans a diagnostic lists: `K`, `V`.
fn tc_ticked_names(names: List[Str]) -> Str {
    let mut out = ""
    let mut i = 0
    while i < names.len() {
        if i > 0 { out = out.concat(", ") }
        out = out.concat("`{names.get(i).unwrap()}`")
        i = i + 1
    }
    out
}

// The repair for a call no inference can complete: written type arguments. The help
// lists every own binder, since a bracket list must supply all of them.
fn tc_call_type_args_help(sig: Int, self_offset: Int) -> Str {
    let fs = fnsig_pool.get(sig).unwrap()
    let mut all: List[Str] = []
    let mut pi = 0
    while pi < fs.type_params_count {
        all.push(fnsig_type_param_names.get(fs.type_params_start + pi).unwrap())
        pi = pi + 1
    }
    let callee = node_name(fs.decl)
    let args = if fs.params_count - self_offset > 0 { "..." } else { "" }
    "write the type arguments at this call, as in `{callee}[{all.join(", ")}]({args})` (replace each placeholder with the intended type)"
}

// A binder no parameter and no return type names can get its type only from written
// type arguments (sections/03_types.md 3.4), so an unbracketed call is an error at
// once, whatever the rest of the program does.
fn tc_report_unsourced_binders(sig: Int, call_node: Int, self_offset: Int) ! Diag.Report {
    if tc_boundary_check_active == 0 || call_node < 0 { return }
    if tc_call_reported.contains_key(call_node) { return }
    let fs = fnsig_pool.get(sig).unwrap()
    let mut names: List[Str] = []
    let mut pi = 0
    while pi < fs.type_params_count {
        let nidx = fs.type_params_start + pi
        if nidx < fnsig_tparam_sourced.len() && fnsig_tparam_sourced.get(nidx).unwrap() == 0 {
            names.push(fnsig_type_param_names.get(nidx).unwrap())
        }
        pi = pi + 1
    }
    if names.len() == 0 { return }
    tc_call_reported.insert(call_node, 1)
    let callee = node_name(fs.decl)
    let mut msg = "type parameter {tc_ticked_names(names)} of `{callee}` has no source -- it is bound by the declaration but supplied by neither a parameter nor the return type"
    if names.len() > 1 {
        msg = "type parameters {tc_ticked_names(names)} of `{callee}` have no source -- they are bound by the declaration but supplied by neither a parameter nor the return type"
    }
    diag_error_at("CannotInferType", CANNOT_INFER_TYPE, msg, call_node, tc_call_type_args_help(sig, self_offset))
}

// Record an unbracketed generic call's own binder tids for tc_ud_flush_calls. Group
// layout in tc_call_open_tids: [sig, self_offset, n, tid..., open...], -1 for a slot with
// no bind, and open 1 for a tid still open and not yet refused here. A binder the callee uses as a key is judged
// for Hash in the flush when it was open here: the use that solves it can come later, and a
// closed one was judged at the call. A keyed construction records a group too (see
// tc_note_open_ctor_key).
fn tc_note_generic_call(sig: Int, call_node: Int, self_offset: Int, binds: Map[Str, Int]) {
    if tc_boundary_check_active == 0 || call_node < 0 { return }
    let fs = fnsig_pool.get(sig).unwrap()
    if fs.type_params_count == 0 { return }
    let prev = tc_call_open_group.get(call_node) ?? -1
    if prev < 0 { tc_call_open_calls.push(call_node) }
    tc_call_open_group.insert(call_node, tc_call_open_tids.len())
    tc_call_open_tids.push(sig)
    tc_call_open_tids.push(self_offset)
    tc_call_open_tids.push(fs.type_params_count)
    let mut pi = 0
    while pi < fs.type_params_count {
        let nidx = fs.type_params_start + pi
        let tpn = fnsig_type_param_names.get(nidx).unwrap()
        let mut tid = -1
        if nidx < fnsig_tparam_nodes.len() {
            let key = tc_binder_key(fnsig_tparam_nodes.get(nidx).unwrap(), tpn)
            if binds.contains_key(key) { tid = binds.get(key).unwrap() }
        }
        if tid == -1 && binds.contains_key(tpn) { tid = binds.get(tpn).unwrap() }
        tc_call_open_tids.push(tid)
        pi = pi + 1
    }
    let keyed = tc_fn_hash_obligations(sig).len() > 0
    let first = tc_call_open_tids.len() - fs.type_params_count
    // One call has one set of binders. The body walk infers a call again after its argument
    // or statement already did, and that inference mints fresh metavariables, so an expected
    // type that filled the first set must reach the new one.
    if prev >= 0 && tc_call_open_tids.get(prev).unwrap() == sig {
        let mut li = 0
        while li < fs.type_params_count {
            let was = tc_call_open_tids.get(prev + 3 + li).unwrap()
            let now = tc_call_open_tids.get(first + li).unwrap()
            if was >= 0 && now >= 0 { let _ = tc_unify(was, now) }
            li = li + 1
        }
    }
    let mut oi = 0
    while oi < fs.type_params_count {
        let tid = tc_call_open_tids.get(first + oi).unwrap()
        let open = keyed && tid >= 0 && tc_tid_has_unbound_metavar(tid) != 0 && tc_tid_hash_fact(tid) != -1
        tc_call_open_tids.push(if open { 1 } else { 0 })
        oi = oi + 1
    }
}

// A call that converts through an impl with binders, as the group [-1, im, n, tid...]: one
// tid per impl binder, -1 for a slot with no bind. A binder only the argument fills
// (`X.from([])`) is open in no binding the program writes, so the call is what the flush
// blames.
fn tc_note_conversion_call(im: Int, call_node: Int, binds: Map[Str, Int]) {
    if tc_boundary_check_active == 0 || call_node < 0 { return }
    let binders = node_impl_binders(im)
    if binders == -1 || sublist_length(binders) == 0 { return }
    if tc_call_open_group.contains_key(call_node) == 0 { tc_call_open_calls.push(call_node) }
    tc_call_open_group.insert(call_node, tc_call_open_tids.len())
    tc_call_open_tids.push(-1)
    tc_call_open_tids.push(im)
    tc_call_open_tids.push(sublist_length(binders))
    let mut i = 0
    while i < sublist_length(binders) {
        let tp = sublist_get(binders, i)
        tc_call_open_tids.push(binds.get(tc_binder_key(tp, node_name(tp))) ?? -1)
        i = i + 1
    }
}

// A conversion whose impl is chosen once inference is done (tc_defer_conversion). The flush
// reads the call's types off its nodes, not off this walk: a later walk of a receiver such as
// `[]` gives it a fresh metavariable, and the node's type is the one codegen reads.
fn tc_note_deferred_conversion(call_node: Int) {
    if tc_boundary_check_active == 0 || call_node < 0 { return }
    if !tc_call_open_group.contains_key(call_node) { tc_call_open_calls.push(call_node) }
    tc_call_open_group.insert(call_node, tc_call_open_tids.len())
    tc_call_open_tids.push(-2)
    tc_call_open_tids.push(-1)
    tc_call_open_tids.push(0)
}

// A walk that chose a conversion at the call clears a deferred record an earlier walk left,
// as the inert key group [-1, -1, 1, -1].
fn tc_drop_deferred_conversion(call_node: Int) {
    if tc_boundary_check_active == 0 || call_node < 0 { return }
    let g = tc_call_open_group.get(call_node) ?? -1
    if g < 0 || !tc_open_group_is_deferred_conversion(g) { return }
    tc_call_open_group.insert(call_node, tc_call_open_tids.len())
    tc_call_open_tids.push(-1)
    tc_call_open_tids.push(-1)
    tc_call_open_tids.push(1)
    tc_call_open_tids.push(-1)
}

fn tc_open_group_is_deferred_conversion(g: Int) -> Bool {
    tc_call_open_tids.get(g).unwrap() == -2
}

// Whether the group at `g` is a conversion call's (tc_note_conversion_call).
fn tc_open_group_is_conversion(g: Int) -> Bool {
    tc_call_open_tids.get(g).unwrap() < 0 && tc_call_open_tids.get(g + 1).unwrap() >= 0
}

// The flush half of tc_note_conversion_call.
fn tc_ud_flush_conversion_call(call_node: Int, g: Int) ! Diag.Report {
    let im = tc_call_open_tids.get(g + 1).unwrap()
    let binders = node_impl_binders(im)
    let n = tc_call_open_tids.get(g + 2).unwrap()
    let mut names: List[Str] = []
    let mut tids: List[Int] = []
    let mut source_fills = true
    let mut pi = 0
    while pi < n {
        let tid = tc_call_open_tids.get(g + 3 + pi).unwrap()
        if tid >= 0 && tc_tid_has_unbound_metavar(tid) != 0 && tc_ud_already_blamed(tid) == 0 {
            let b = sublist_get(binders, pi)
            names.push(node_name(b))
            tids.push(tid)
            if !tc_tid_mentions_binder(tc_impl_conv_source(im), b) { source_fills = false }
        }
        pi = pi + 1
    }
    if names.len() == 0 { return }
    tc_call_reported.insert(call_node, 1)
    let head = tc_conversion_impl_head(im)
    let mut msg = "type parameter {tc_ticked_names(names)} of `{head}` is unbound at this call and nothing supplies it"
    if names.len() > 1 {
        msg = "type parameters {tc_ticked_names(names)} of `{head}` are unbound at this call and nothing supplies them"
    }
    // A binder only the receiver names is read off the result's type, not the source's.
    let help = if source_fills { "give the value this call converts a type annotation" } else { "annotate the binding that receives the result with the type it should have" }
    diag_error_at("CannotInferType", CANNOT_INFER_TYPE, msg, call_node, help)
    for t in tids { tc_ud_mark_blamed(t) }
}

// A Map()/Set() construction that names no type arguments, as a group of its own:
// [-1, -1, 1, ctor] when the key is open here, else [-1, -1, 1, -1], so a walk that found it
// closed clears an earlier record. The flush judges the key once inference is done.
fn tc_note_open_ctor_key(node: Int, ctor: Int) {
    if tc_boundary_check_active == 0 || node < 0 || ctor < 0 { return }
    let t = tc_resolve(ctor)
    let k = type_kind(t)
    if k != TyKind.Map && k != TyKind.Set { return }
    if tc_call_open_group.contains_key(node) == 0 { tc_call_open_calls.push(node) }
    tc_call_open_group.insert(node, tc_call_open_tids.len())
    tc_call_open_tids.push(-1)
    tc_call_open_tids.push(-1)
    tc_call_open_tids.push(1)
    tc_call_open_tids.push(if tc_tid_has_unbound_metavar(ty_pool.get(t).unwrap().inner1) != 0 { t } else { -1 })
}

// The Hash judgment of a recorded group, made once inference is done (see
// tc_note_generic_call). Reported before the unbound-binder check, which skips a call once
// any report has claimed it.
fn tc_flush_open_keys_of(call_node: Int, g: Int) ! Diag.Report {
    let sig = tc_call_open_tids.get(g).unwrap()
    if tc_open_group_is_conversion(g) || tc_open_group_is_deferred_conversion(g) { return }
    if sig < 0 {
        let ctor = tc_call_open_tids.get(g + 3).unwrap()
        if ctor < 0 { return }
        let t = tc_resolve(ctor)
        let key = ty_pool.get(t).unwrap().inner1
        tc_refuse_unhashable_tid(key, if type_kind(t) == TyKind.Map { HashRole.MapKey } else { HashRole.SetElement }, call_node)
        return
    }
    let oblig = tc_fn_hash_obligations(sig)
    if oblig.len() == 0 { return }
    let n = tc_call_open_tids.get(g + 2).unwrap()
    let fs = fnsig_pool.get(sig).unwrap()
    let mut pi = 0
    while pi < n {
        let role = tc_hash_oblig_mark(oblig, pi)
        let tid = tc_call_open_tids.get(g + 3 + pi).unwrap()
        let was_open = tc_call_open_tids.get(g + 3 + n + pi).unwrap()
        if role != HashRole.Free && was_open != 0 && tc_tid_hash_fact(tid) == -1 {
            tc_report_unhashable_bind(sig, fnsig_type_param_names.get(fs.type_params_start + pi).unwrap(), role, tid, call_node)
        }
        pi = pi + 1
    }
}

// Choose the impl of each conversion tc_defer_conversion left open, now that every use in the
// definition has run (sections/03_types.md 3.4 scopes a later use to the same definition). A
// sole impl that fits is a use like any call's: it settles what the call left open, and that
// can leave one impl for another deferred call, so the passes repeat until none chooses.
// tc_refuse_deferred_conversions judges the rest at the end of the program.
//
// Each definition flushes before its type parameters leave scope, so a chosen impl may bind
// a binder to one of them, under the licence the definition's own annotation has
// (tc_pin_tail_ret_generic). The flush at the end of the program has none in scope.
fn tc_flush_deferred_conversions() ! TypeCheck.Resolve, Diag.Report {
    tc_pin_tparam_binds = 1
    let mut chose = true
    while chose {
        chose = false
        for call_node in tc_deferred_conversion_calls() {
            if tc_choose_deferred_conversion(call_node) { chose = true }
        }
    }
    tc_pin_tparam_binds = 0
}

// Refuse each conversion no use settled: more than one impl fits, or none. This runs after
// the under-determined bindings and calls are reported, since a report that names the open
// type the program must write answers for the conversion too.
fn tc_refuse_deferred_conversions() ! Diag.Report {
    for call_node in tc_deferred_conversion_calls() { tc_refuse_deferred_conversion(call_node) }
}

// The calls whose last record is a deferred conversion that no report has claimed.
fn tc_deferred_conversion_calls() -> List[Int] {
    let mut out: List[Int] = []
    for call_node in tc_call_open_calls {
        let g = tc_call_open_group.get(call_node).unwrap()
        if tc_open_group_is_deferred_conversion(g) && !tc_call_reported.contains_key(call_node) { out.push(call_node) }
    }
    out
}

// The source and target of a deferred conversion as its nodes type them now, -1 for a side
// with no type.
fn tc_deferred_conversion_sides(call_node: Int) -> (Int, Int) {
    let into = tc_is_into_method(node_method(call_node))
    let trait_name = if into { "From" } else { tc_conversion_trait_of(node_method(call_node)) }
    let source = tc_lookup_node_tid(if into { node_obj(call_node) } else { sublist_get(node_args(call_node), 0) })
    (source, tc_conversion_target_of(trait_name, tc_lookup_node_tid(call_node)))
}

// A deferred conversion as its nodes type it now.
type TcDeferredConversion {
    into: Bool
    trait_name: Str
    source: Int
    target: Int
    // The impls that still fit, CONVERSION_IS_IDENTITY first when the value itself could.
    found: List[Int]
}

// None when a side has no type or some report already blamed it: a blamed side is not
// judged again.
fn tc_deferred_conversion_at(call_node: Int) -> Option[TcDeferredConversion] {
    let into = tc_is_into_method(node_method(call_node))
    let trait_name = if into { "From" } else { tc_conversion_trait_of(node_method(call_node)) }
    let (source, target) = tc_deferred_conversion_sides(call_node)
    if source < 0 || target < 0 { return None }
    if tc_ud_already_blamed(source) != 0 || tc_ud_already_blamed(target) != 0 { return None }
    let mut found = tc_conversion_impls_matching_at(trait_name, source, target, true)
    if trait_name == "From" && tc_tid_same_type_at(source, target, true, Map()) { found.insert(0, CONVERSION_IS_IDENTITY) }
    Some(TcDeferredConversion { into: into, trait_name: trait_name, source: source, target: target, found: found })
}

// Choose the impl of a deferred conversion when it is the sole one that fits, and answer
// whether this did. The impl settles the call's types and the call links to it, as
// tc_static_conversion links a call it chose at once.
fn tc_choose_deferred_conversion(call_node: Int) -> Bool ! TypeCheck.Resolve, Diag.Report {
    let d = match tc_deferred_conversion_at(call_node) {
        Some(x) => x
        None => { return false }
    }
    if d.found.len() != 1 { return false }
    tc_drop_deferred_conversion(call_node)
    let im = d.found.get(0).unwrap()
    if im == CONVERSION_IS_IDENTITY {
        if tc_unify(d.source, d.target) == 0 { tc_refuse_chosen_conversion(call_node, d) }
        return true
    }
    let binds = tc_impl_fresh_binders(im)
    let fits = tc_unify(substitute_typevar_tid(tc_impl_conv_source(im), binds), d.source) != 0
    if !fits || tc_unify(substitute_typevar_tid(tc_impl_recv_tids.get(im) ?? -1, binds), d.target) == 0 {
        tc_refuse_chosen_conversion(call_node, d)
        return true
    }
    if !d.into {
        let sig = tc_conversion_method_sig(im, node_method(call_node))
        if sig != -1 { nr_note_call_decl(call_node, fnsig_pool.get(sig).unwrap().decl) }
    }
    if tc_impl_is_poly_conversion(im) { tc_note_conversion_call(im, call_node, binds) }
    true
}

// The open match let the sole impl through, but its types still refuse the call's once
// unified (one metavariable that would have to be two types), so in fact none fits.
fn tc_refuse_chosen_conversion(call_node: Int, d: TcDeferredConversion) ! Diag.Report {
    tc_call_reported.insert(call_node, 1)
    tc_report_no_conversion(call_node, "", d.trait_name, d.source, d.target)
    tc_ud_mark_blamed(d.source)
    tc_ud_mark_blamed(d.target)
}

fn tc_refuse_deferred_conversion(call_node: Int) ! Diag.Report {
    let d = match tc_deferred_conversion_at(call_node) {
        Some(x) => x
        None => { return }
    }
    if d.found.len() > 1 {
        tc_call_reported.insert(call_node, 1)
        let call = if d.into { "`.into()`" } else { "`{node_name(node_obj(call_node))}.{node_method(call_node)}`" }
        tc_report_conversion_tie(call_node, call, "", d.source, d.found)
    } else if d.found.len() == 0 && tc_conversion_side_judgeable(d.source) && tc_conversion_side_judgeable(d.target) {
        tc_call_reported.insert(call_node, 1)
        tc_report_no_conversion(call_node, "", d.trait_name, d.source, d.target)
    } else {
        return
    }
    tc_ud_mark_blamed(d.source)
    tc_ud_mark_blamed(d.target)
}

// A side a refusal at the end of inference may judge: an error type was reported where it
// arose, and a generic body's `T` is judged per instance. A metavariable still open matches
// every impl, so a side that holds one and matches none could never convert.
fn tc_conversion_side_judgeable(t: Int) -> Bool {
    tc_tid_has_unknown(t) == 0 && tc_tid_has_bare_typevar(t) == 0
}

// Report the recorded calls a binder of which is still unbound once inference is done
// and no binding or scrutinee has already answered for it.
fn tc_ud_flush_calls() ! Diag.Report {
    let mut ci = 0
    while ci < tc_call_open_calls.len() {
        let call_node = tc_call_open_calls.get(ci).unwrap()
        ci = ci + 1
        let g = tc_call_open_group.get(call_node).unwrap()
        tc_flush_open_keys_of(call_node, g)
        let sig = tc_call_open_tids.get(g).unwrap()
        if tc_call_reported.contains_key(call_node) { continue }
        if tc_open_group_is_conversion(g) {
            tc_ud_flush_conversion_call(call_node, g)
            continue
        }
        if sig < 0 { continue }
        let n = tc_call_open_tids.get(g + 2).unwrap()
        let fs = fnsig_pool.get(sig).unwrap()
        let mut names: List[Str] = []
        let mut tids: List[Int] = []
        let mut pi = 0
        while pi < n {
            let tid = tc_call_open_tids.get(g + 3 + pi).unwrap()
            if tid >= 0 && tc_tid_has_unbound_metavar(tid) != 0 && tc_ud_already_blamed(tid) == 0 {
                names.push(fnsig_type_param_names.get(fs.type_params_start + pi).unwrap())
                tids.push(tid)
            }
            pi = pi + 1
        }
        if names.len() == 0 { continue }
        tc_call_reported.insert(call_node, 1)
        let callee = node_name(fs.decl)
        let mut msg = "type parameter {tc_ticked_names(names)} of `{callee}` is unbound at this call and nothing supplies it"
        if names.len() > 1 {
            msg = "type parameters {tc_ticked_names(names)} of `{callee}` are unbound at this call and nothing supplies them"
        }
        diag_error_at("CannotInferType", CANNOT_INFER_TYPE, msg, call_node, tc_call_type_args_help(sig, tc_call_open_tids.get(g + 1).unwrap()))
        let mut ti = 0
        while ti < tids.len() {
            tc_ud_mark_blamed(tids.get(ti).unwrap())
            ti = ti + 1
        }
    }
}

// The recorded calls once every flush has read them.
fn tc_drop_open_calls() {
    tc_call_open_calls = []
    tc_call_open_group.clear()
    tc_call_open_tids = []
}

// Report a binding whose type is under-determined — HM finished the region with a
// metavar still unbound (an empty `[]`/`None`/`Map()`/`Set()` never pinned by a
// constraining use). error[CannotInferType] (E0301), sole repair is annotation.
// Report-at-binding, dual-span: primary caret at the
// `let`, a secondary note at the value that left the slot open (the RHS). The `help`
// text shows the annotation SHAPE with placeholder type-params (T/K/V) — deliberately
// NOT a machine-applicable `fix`, because the open slot is precisely what the error
// says is unknowable: an auto-applied `: List[T]` would insert an undefined `T`.
fn tc_report_under_determined(vname: Str, tid: Int, decl_node: Int) ! Diag.Report {
    let hint = tc_infer_annotation_hint(tid)
    let dk = node_kind(decl_node)
    // Only a `let` holds its initializer in the value slot, so only there does the
    // value node name the construction that failed to fill the slot. A `with` binder
    // keeps its resource EXPRESSION in the same slot, and calling that "the empty
    // construction" would be a false claim about the user's code.
    let val = if dk == NodeKind.LetBinding { node_value(decl_node) } else { -1 }
    let (source, slot) = tc_ud_open_slot(tid, val)
    let mut notes: List[Str] = []
    if val != -1 {
        notes.push("{source} has no {slot} to infer at line {node_line(val)}")
    }
    // Claim this open type so a DEFERRED alias blame over the same metavar drops out
    // at the flush instead of adding a second report for one under-determination.
    tc_ud_mark_blamed(tid)
    // The repair has to be a form the blamed binder can actually take. A `let` takes
    // an annotation on itself and a fn/closure parameter takes one in the parameter
    // list; every other binder class destructures a value it did not materialize and
    // carries no annotation at all, so naming a `let` there would prescribe a repair
    // that does not exist at that span.
    let mut help = "add a type annotation, e.g. `let {vname}{hint} = ...` (replace the placeholder with the intended {slot})"
    if dk == NodeKind.Param {
        help = "add a type annotation, e.g. `fn({vname}{hint}) \{ ... }` (replace the placeholder with the intended {slot})"
    } else if dk != NodeKind.LetBinding {
        help = "annotate the value this binder destructures — a pattern binder takes no annotation of its own"
    }
    diag_error_at_notes("CannotInferType", CANNOT_INFER_TYPE, "cannot infer a type for `{vname}`: it is never given one by an annotation or a later use", decl_node, help, notes)
}

// What an under-determined binding's value is, and which of its type's slots nothing filled,
// keyed on the open type's outer kind. A Ptr or a spawned Handle comes from a call, not an
// empty construction, and what it leaves open is a pointee or a result, not an element. A
// Ptr nested in another kind (`Some(null_ptr())`) takes that kind's text, as `Some([])` does.
fn tc_ud_open_slot(tid: Int, val: Int) -> (Str, Str) {
    let k = tc_tid_kind(tc_resolve(tid))
    if k == TyKind.Ptr { return (tc_ud_call_source(val), "pointee type") }
    if k == TyKind.Handle { return (tc_ud_call_source(val), "result type") }
    ("the empty construction here", "element type")
}

// The call a value is, spelled as written, or a plain "the value" when it is not a call.
fn tc_ud_call_source(val: Int) -> Str {
    if val >= 0 && node_kind(val) == NodeKind.Call && node_kind(node_left(val)) == NodeKind.Ident {
        return "the `{node_name(node_left(val))}()` call here"
    }
    if val >= 0 && node_kind(val) == NodeKind.MethodCall && node_kind(node_obj(val)) == NodeKind.Ident {
        return "the `{node_name(node_obj(val))}.{node_method(val)}()` call here"
    }
    "the value here"
}

// Point the caret at the specific open constructor inside a compound value: the first
// tuple element whose type still carries an unbound metavar. A bare constructor
// scrutinee (`match Ok(3) { .. }`) has no tuple wrapper, so the node itself is the
// culprit — the fallthrough returns it unchanged.
fn tc_locate_under_determined(node: Int) -> Int {
    if node < 0 { return node }
    if node_kind(node) == NodeKind.TupleLit {
        let els = node_elements(node)
        if els != -1 {
            let mut i = 0
            while i < sublist_length(els) {
                let el = sublist_get(els, i)
                let et = tc_lookup_node_tid(el)
                if tc_tid_is_no_info(et) == 0 && tc_tid_has_unbound_metavar(et) != 0 {
                    return el
                }
                i = i + 1
            }
        }
    }
    node
}

// A match scrutinee that references an in-scope value binding — `match x`, or a
// `match rec.field` / `match arr[i]` rooted at one — is already covered by the
// scope-close under-determined check, which runs at nr_pop_scope after every later
// constraining use has run. Re-checking such a scrutinee here, mid-walk, would both
// false-reject a value a *later* statement pins (`match x` then `let y: Option[Int] = x`)
// and double-report one the scope-close check already owns. Only an anonymous temporary
// scrutinee — a constructor, a literal, a call, a tuple — escapes scope-close (it binds
// no name), so the eager boundary check must fire there and only there. A nullary
// constructor like `None` is an Ident with no binding (nr_has_binding == 0), so it stays
// eagerly checked; a match-arm pattern binding is a mere alias of a value already caught
// at its own materialization site, so skipping it drops the duplicate, not the error.
fn tc_scrut_is_named_place(node: Int) -> Int {
    let mut n = node
    while n >= 0 {
        let k = node_kind(n)
        if k == NodeKind.Ident {
            return nr_has_binding(node_name(n))
        }
        if k == NodeKind.FieldAccess || k == NodeKind.IndexExpr {
            n = node_obj(n)
        } else {
            return 0
        }
    }
    0
}

// The materialization-boundary twin of tc_report_under_determined for a value that is
// NOT a `let` binding — a match scrutinee. Same error[CannotInferType] (E0301), applied
// uniformly across syntactic position (decisions/under-determined-sum-variant-parameter.md,
// sections/03_types.md §3.4: "The judgment is a property of the type, not of the syntactic
// position."). There is no binding name to blame, so the caret lands on the open
// constructor (tc_locate_under_determined). The note enumerates the four things that would
// have pinned an open sum-variant parameter — an annotation, a `?`, an error-reading arm, or
// a return type — since a `Err(e) => ...`/`None => ...` arm that discards its payload
// constrains nothing.
fn tc_report_under_determined_at(scrut: Int, scrut_tid: Int) ! Diag.Report {
    if scrut == -1 { return }
    let culprit = tc_locate_under_determined(scrut)
    let culprit_tid = tc_lookup_node_tid(culprit)
    let hint_tid = if tc_tid_is_no_info(culprit_tid) == 0 { culprit_tid } else { scrut_tid }
    let hint = tc_infer_annotation_hint(hint_tid)
    let mut notes: List[Str] = []
    notes.push("its type is never constrained by an annotation, a `?`, an error-reading arm, or a return type")
    // Same claim the binding report makes: an arm binder aliasing this scrutinee has
    // already deferred, and its blame must not restate what this line says.
    tc_ud_mark_blamed(scrut_tid)
    tc_ud_mark_blamed(culprit_tid)
    diag_error_at_notes("CannotInferType", CANNOT_INFER_TYPE, "cannot infer a type for this value: it is left under-determined", culprit, "add a type annotation on a binding for this value, e.g. `let x{hint} = ...` (replace each placeholder with the intended type)", notes)
}

// Structural unification. On meeting an unbound α on either side, bind it to the
// other side (the crux fix — the constraint is *recorded*, not discarded the way
// check_arg_value's TYPE_UNKNOWN early-return does today). Returns 1 if the two
// types can be made equal, 0 on a hard structural mismatch. Same-kind compound
// types unify element-wise; unequal concrete kinds fail. This is intentionally
// permissive toward the legacy TYPE_UNKNOWN singleton and bare TyKind.Typevar (both
// treated as "unifies with anything, no bind") so Stage 1 is behavior-neutral —
// only fresh per-binding metavars from make_metavar ever get pinned.
// pub so the fail-closed range guards below can be driven directly; no surface program
// reaches them, the same reason type_merge is pub.
// Set only while a declared annotation is being pinned onto an under-determined value
// (tc_pin_tail_ret_generic). It licenses ONE extra bind in tc_unify: a bare type parameter
// of the enclosing declaration standing against the value's metavariable. Everywhere else a
// typevar still unifies vacuously.
let mut tc_pin_tparam_binds: Int = 0

// Whether this typevar is a type parameter the DECLARATION NOW BEING CHECKED binds, by
// binder node and not by spelling. That is what makes `a := T` a determination rather than
// a loss: the monomorphisation pass substitutes this declaration's own parameters once per
// instance of its body, so a slot holding T becomes concrete in every body that is lowered,
// while a body no instance reaches is never lowered at all. A same-spelled parameter of
// another declaration is a different type and is substituted by nothing here, so it answers
// 0 and keeps the vacuous unify.
fn tc_typevar_binds_here(tid0: Int) -> Int {
    let tid = tc_resolve(tid0)
    if tid < 0 || tid >= ty_pool.len() { return 0 }
    let e = ty_pool.get(tid).unwrap()
    if e.kind != TyKind.Typevar { return 0 }
    tc_binder_is_active(e.inner1)
}

// Any active frame counts, not only the innermost of a spelling: an impl's `T` shadowed
// by a method's own `T` is still substituted once per instance of the method body.
fn tc_binder_is_active(binder: Int) -> Int {
    if binder == NO_BINDER_NODE { return 0 }
    for f in tc_tp_frames {
        if f.binder == binder { return 1 }
    }
    0
}

// Inside a body its own type parameters are rigid: `T` stands for every type at once, so
// it matches only itself (§3 Parametricity). A parameter of another declaration, such as
// a callee formal read off its signature, is still open to anything at this site.
fn tc_typevar_pair_compatible(a: Int, b: Int) -> Int {
    if tc_current_fn_node == -1 { return 1 }
    if tc_typevar_is_open(a) != 0 || tc_typevar_is_open(b) != 0 { return 1 }
    0
}

fn tc_typevar_is_open(tid: Int) -> Int {
    let e = ty_pool.get(tid).unwrap()
    if e.kind != TyKind.Typevar { return 0 }
    if tc_typevar_binds_here(tid) != 0 { return 0 }
    1
}

fn tc_typevar_is_rigid(tid: Int) -> Int {
    if tc_current_fn_node == -1 { return 0 }
    tc_typevar_binds_here(tid)
}

// A type parameter declares no fields and a bound adds only methods, so no field is
// readable on it in its own body (§3 Parametricity), whatever it is instantiated at.
fn tc_reject_type_parameter_field(tid: Int, fname: Str, node: Int) -> Int ! Diag.Report {
    let tp = type_to_str(tid)
    diag_error_at("NoSuchField", NO_SUCH_FIELD, "type parameter {tp} has no field `{fname}`", node, "a type parameter has no fields; bound {tp} by a trait with a method that returns the value, and call it")
    tc_error_recovery_tid()
}

pub fn tc_unify(a0: Int, b0: Int) -> Int {
    let a = tc_resolve(a0)
    let b = tc_resolve(b0)
    // Fail CLOSED on a tid that is not a type, ahead of the a == b shortcut so that two
    // equal spellings of "no type" cannot answer "unified". A vacuous 1 reads to every
    // caller as a successful match with nothing pinned, which is the fail-open shape
    // types_compatible and type_merge already closed.
    if a < 0 || b < 0 { return 0 }
    if a >= ty_pool.len() || b >= ty_pool.len() { return 0 }
    if a == b { return 1 }
    // The `?` hole and a bare typevar unify vacuously, never bind. Unlike an absent tid
    // these are spellings a surface program produces, and the E0301 boundary check —
    // not this function — owns reporting one that never got pinned.
    if a == TYPE_UNKNOWN || b == TYPE_UNKNOWN { return 1 }
    let ka0 = ty_pool.get(a).unwrap().kind
    let kb0 = ty_pool.get(b).unwrap().kind
    if ka0 == TyKind.Typevar || kb0 == TyKind.Typevar {
        if tc_pin_tparam_binds == 0 { return 1 }
        if ka0 == TyKind.Typevar && tc_typevar_binds_here(a) != 0 && tc_is_unbound_metavar(b) != 0 {
            return bind_metavar(b, a)
        }
        if kb0 == TyKind.Typevar && tc_typevar_binds_here(b) != 0 && tc_is_unbound_metavar(a) != 0 {
            return bind_metavar(a, b)
        }
        return 1
    }
    // Unbound metavar on either side: pin it to the other side. A side that names another
    // declaration's type parameter (a callee's `List[U]`) is not a type at this site, as a bare
    // typevar is not: no substitution reaches it here, so the pin would turn a hole a later use
    // can still fill into one nothing can.
    if tc_is_unbound_metavar(a) != 0 {
        if tc_tid_has_foreign_typevar(b) != 0 { return 1 }
        return bind_metavar(a, b)
    }
    if tc_is_unbound_metavar(b) != 0 {
        if tc_tid_has_foreign_typevar(a) != 0 { return 1 }
        return bind_metavar(b, a)
    }
    let ta = ty_pool.get(a).unwrap()
    let tb = ty_pool.get(b).unwrap()
    let ka = ta.kind
    let kb = tb.kind
    if ka != kb { return 0 }
    if ka == TyKind.List || ka == TyKind.Option || ka == TyKind.Set || ka == TyKind.Channel || ka == TyKind.Iterator {
        return tc_unify(ta.inner1, tb.inner1)
    }
    // Ptr, Handle and Template keep their one child in inner1 too. Without these arms they
    // fell through to the scalar tail, so Ptr[Int] and Ptr[Float] unified by kind alone.
    if ka == TyKind.Ptr || ka == TyKind.Handle || ka == TyKind.Template {
        return tc_unify(ta.inner1, tb.inner1)
    }
    if ka == TyKind.Result || ka == TyKind.Map {
        if tc_unify(ta.inner1, tb.inner1) == 0 { return 0 }
        return tc_unify(ta.inner2, tb.inner2)
    }
    if ka == TyKind.Tuple {
        if ta.params_count != tb.params_count { return 0 }
        let mut i = 0
        while i < ta.params_count {
            let ea = ty_param_list.get(ta.params_start + i).unwrap()
            let eb = ty_param_list.get(tb.params_start + i).unwrap()
            if tc_unify(ea, eb) == 0 { return 0 }
            i = i + 1
        }
        return 1
    }
    // A function type unifies component-wise. Without this arm two fn types fell through to
    // the scalar tail and answered 1 with nothing bound, so an expected `fn(Int) -> Int` could
    // not fix the binders of the generic function name standing under it.
    if ka == TyKind.Fn {
        if ta.params_count != tb.params_count { return 0 }
        let mut fa: List[Int] = []
        let mut fb: List[Int] = []
        let mut i = 0
        while i < ta.params_count {
            fa.push(ty_param_list.get(ta.params_start + i).unwrap())
            fb.push(ty_param_list.get(tb.params_start + i).unwrap())
            i = i + 1
        }
        let mut j = 0
        while j < fa.len() {
            if tc_unify(fa.get(j).unwrap(), fb.get(j).unwrap()) == 0 { return 0 }
            j = j + 1
        }
        return tc_unify(ta.inner1, tb.inner1)
    }
    if ka == TyKind.Struct || ka == TyKind.Enum {
        if strip_module_qualifier(ta.name) != strip_module_qualifier(tb.name) { return 0 }
        if ta.params_count > 0 && tb.params_count > 0 {
            if ta.params_count != tb.params_count { return 0 }
            let mut i = 0
            while i < ta.params_count {
                let ea = ty_param_list.get(ta.params_start + i).unwrap()
                let eb = ty_param_list.get(tb.params_start + i).unwrap()
                if tc_unify(ea, eb) == 0 { return 0 }
                i = i + 1
            }
        }
        return 1
    }
    // Same concrete scalar kind (Int/Str/Bool/…): already equal by kind.
    1
}

// ── Type lookup ─────────────────────────────────────────────────────

pub fn lookup_named_type(name: Str) -> Int {
    let dot = name.byte_index_of(".", 0)
    // A selective import may rename what it selects, and the file then writes the alias. No
    // declaration carries that spelling, so the pool holds nothing under it: the declaration
    // is registered under its original name. The alias outranks any type another module
    // declares under the same spelling, since in this file the spelling means the import.
    // The key comes from the declaration the import reaches, not from the original spelling,
    // since this file may declare a namesake of the original and two modules may declare it.
    if dot.is_none() {
        let aliased = nr_alias_decl_here(name)
        if aliased >= 0 && node_kind(aliased) == NodeKind.TypeDef {
            match named_type_map.get(tc_nominal_type_name(aliased)) {
                Some(v) => return v
                None => {}
            }
        }
    }
    // A bare namesake means the reading module's own declaration, or the one its imports
    // select, before the bare key (which only the main file can hold).
    if dot.is_none() && tc_is_namesake_type_name(name) != 0 {
        match named_type_map.get(tc_nominal_type_name_in(name, nr_current_module)) {
            Some(v) => return v
            None => {}
        }
    }
    match named_type_map.get(name) {
        Some(v) => return v
        None => {}
    }
    match dot {
        Some(at) => {
            let bare = name.byte_slice(at + 1, name.byte_len())
            // A written qualifier on a namesake names one module's declaration and nothing else:
            // the bare key would answer with another module's type of the same name.
            if tc_is_namesake_type_name(bare) != 0 {
                let qual = name.byte_slice(0, at)
                let mod_key = tc_qualifier_to_module.get(qual) ?? qual
                return named_type_map.get("{mod_key}.{bare}") ?? -1
            }
            match named_type_map.get(bare) {
                Some(v) => return v
                None => {}
            }
        }
        None => {}
    }
    -1
}

// ConversionError is a runtime/prelude builtin, normally already registered — but
// lookup_named_type returns -1 if it is not, which would intern Result[T, -1], a -1
// escaping as the carrier's err arm. Mint-or-return so the err arm is a concrete Struct
// tid by construction.
fn tc_conversion_error_type() -> Int {
    // By identity: a module's own `type ConversionError` is not what a parse fails with.
    let known = tc_compiler_known_tid("ConversionError")
    if known != -1 { return known }
    ensure_runtime_struct_type("ConversionError", ["message", "source_type", "target_type"], [TYPE_STR, TYPE_STR, TYPE_STR], [])
}

// Mint a declaration for a RUNTIME-BACKED compiler-known type on demand.
//
// ProcessResult's C struct lives in bootstrap/runtime_process.h and codegen names it with
// no Blink declaration at all (src/codegen.bl:634 reg_fn_struct_ret, :650-652 the fields).
// So `let r = process_pid_wait(pid)` compiles and RUNS correctly in a file that never
// writes `import std.process` — src/cli.bl:2187 is exactly that. Without this, typecheck
// answers TYPE_VOID there: a fail-OPEN erasure that also swallows every downstream `r.out`.
//
// The type is known, so typecheck says so. Minting is idempotent and always defers to a
// real declaration, because lookup runs first: if lib/std/process.bl is in the program its
// register_struct_type has already inserted the name (registration precedes inference), and
// this returns that tid. Fields are registered here too — a fieldless mint would turn a
// silent erasure into a spurious "no field" error, which is worse.
// A type the runtime defines, minted on demand for a builtin's return. The declaration
// comes from lib/std when the program imports it; otherwise there is none to find and one
// is synthesized here, because layout reads a struct's shape and cname its symbol through
// a declaration node, and a tid without one has no C answer at all. The early return keeps
// a real declaration the sole answer for its name -- registering a second would make the
// name ambiguous and lose the one the program wrote. `derives` must match that lib/std
// declaration's @derive, or the type's traits would depend on whether it was loaded.
fn ensure_runtime_struct_type(name: Str, fnames: List[Str], ftids: List[Int], derives: List[Str]) -> Int {
    let existing = lookup_named_type(name)
    if existing != -1 { return existing }
    let tid = new_type(TyKind.Struct, name)
    named_type_names.push(name)
    named_type_ids.push(tid)
    named_type_map.insert(name, tid)
    let mut ftypes: List[Str] = []
    let mut i = 0
    while i < fnames.len() {
        let ftid = ftids.get(i).unwrap()
        sfield_pool.push(TcStructField { struct_id: tid, name: fnames.get(i).unwrap(), type_id: ftid })
        ftypes.push(tc_tid_name(ftid))
        i = i + 1
    }
    let td = synth_struct_decl(name, fnames, ftypes, derives)
    tc_register_type_decl_node(name, name, tid, td)
    tc_struct_decl_nodes.insert(name, td)
    tid
}

// Instant and Duration as lib/std/time.bl declares them, `derives` included.
fn runtime_instant_tid() -> Int {
    ensure_runtime_struct_type("Instant", ["nanos"], [TYPE_INT], ["Eq", "Ord", "Hash", "Clone", "Debug"])
}

fn runtime_duration_tid() -> Int {
    ensure_runtime_struct_type("Duration", ["nanos"], [TYPE_INT], ["Eq", "Ord", "Clone", "Debug"])
}

fn runtime_process_result_tid() -> Int {
    ensure_runtime_struct_type("ProcessResult", ["out", "err_out", "exit_code"], [TYPE_STR, TYPE_STR, TYPE_INT], [])
}

// The err type of the public fs.* surface. When std.fs is imported its `struct FsError`
// decl has already registered the name, so we return that tid and the caller's `FsError`
// annotations share identity with this surface's err arm. When it is NOT imported we still
// need a carrier tid for the fs.* signatures, but the name must stay unresolvable — FsError
// is not prelude, so `fn take(e: FsError)` without `import std.fs` is an unknown type. So the
// unimported carrier is minted WITHOUT touching the named-type tables; the op/code field tids
// are then -1 (FsOp/Errno also absent), typing `e.op`/`e.code` as Unknown for a wildcard-only
// caller while `e.path` stays Str. Actually consuming the fs.* surface unimported fails at
// codegen (the carrier and FsError tag stay unqualified), which is the real enforcement.
let mut fs_error_runtime_tid_cache: Int = -1
fn fs_error_tid() -> Int {
    let named = lookup_named_type("FsError")
    if named != -1 { return named }
    if fs_error_runtime_tid_cache != -1 { return fs_error_runtime_tid_cache }
    let tid = new_type(TyKind.Struct, "FsError")
    // op/code stay Unknown for a wildcard-only caller when std.fs is unimported (FsOp/Errno
    // absent) — the deliberate fs.* surface behavior, with codegen the real enforcement (the
    // carrier and FsError tag stay unqualified). Store the TYPE_UNKNOWN singleton, not the raw
    // -1 that lookup_named_type returns on a miss, so no -1 escapes as a field-type answer.
    let fsop_tid = lookup_named_type("FsOp")
    let errno_tid = lookup_named_type("Errno")
    sfield_pool.push(TcStructField { struct_id: tid, name: "op", type_id: if fsop_tid != -1 { fsop_tid } else { TYPE_UNKNOWN } })
    sfield_pool.push(TcStructField { struct_id: tid, name: "path", type_id: TYPE_STR })
    sfield_pool.push(TcStructField { struct_id: tid, name: "code", type_id: if errno_tid != -1 { errno_tid } else { TYPE_UNKNOWN } })
    fs_error_runtime_tid_cache = tid
    tid
}

// THE StringBuilder tid — one entry per program, so `sb_a` and `sb_b` compare
// equal by integer comparison per decisions/compiler-type-representation.md Q3.
//
// Goes through ty_intern_simple rather than new_type, unlike the TyKind.Bytes sites it
// otherwise mirrors (:2236, :5875). new_type is deliberately un-interned to keep every
// metavar FRESH, and a childless nominal leaf gets no benefit from that freshness — it
// just gets a fresh tid per mention. (Bytes therefore has as many tids as it has
// mentions; that is pre-existing and separate.)
fn type_stringbuilder() -> Int {
    ty_intern_simple(TyKind.StringBuilder, "StringBuilder", -1, -1)
}

fn resolve_type_name(name: Str) -> Int ! TypeCheck.Resolve, Diag.Report {
    if name == "Int" { return TYPE_INT }
    if name == "Float" { return TYPE_FLOAT }
    if name == "Bool" { return TYPE_BOOL }
    if name == "Str" { return TYPE_STR }
    if name == "Void" || name == "" { return TYPE_VOID }
    if name == "I8" { return TYPE_I8 }
    if name == "I16" { return TYPE_I16 }
    if name == "I32" { return TYPE_I32 }
    if name == "I64" { return TYPE_INT }
    if name == "U8" { return TYPE_U8 }
    if name == "U16" { return TYPE_U16 }
    if name == "U32" { return TYPE_U32 }
    if name == "U64" { return TYPE_U64 }
    if name == "Char" { return TYPE_CHAR }
    // The same reading resolve_type_parts gives a written name, so a type spelled through a
    // string (a closure's return, a parameter) means what its annotation means: a name
    // imported from a compiler-known type's home under another name is that builtin, and a
    // declaration that takes a shadowable name answers below, through lookup_named_type.
    let core = tc_compiler_known_type_meant(name, -1)
    if tc_is_shadowable_type_name(core) { return tc_compiler_known_type_tid(core, -1, -1) }
    lookup_named_type(name)
}

pub fn get_struct_field_tid(struct_tid: Int, fname: Str) -> Int {
    // Field entries are registered against the BASE declaration tid (register_
    // struct_type). A monomorphized instance tid (Box[Int], a fresh entry sharing
    // the base name) must normalize back to that base before matching,
    // or field lookups on any instance-typed value return -1. tc_struct_base_tid
    // is a no-op for a bare tid.
    let base = tc_struct_base_tid(struct_tid)
    let mut i = 0
    while i < sfield_pool.len() {
        let sf = sfield_pool.get(i).unwrap()
        if sf.struct_id == base && sf.name == fname {
            return sf.type_id
        }
        i = i + 1
    }
    -1
}

// Returns 1 only when obj_t's struct declaration is resolvable AND does not
// declare `fname` — the field is PROVABLY absent from the declared shape. A
// bodiless struct (an @ffi.opaque handle, §9.1.4, or an empty `type E {}`)
// declares zero fields, so every field access on it is provably absent.
//
// Returns 0 when the field IS declared, or when the declaration cannot be
// resolved from the tid. That second case is a real state, not a bug: an
// inferred list element surfaces as a struct-kind handle tid whose
// fields are not findable by tid even though the underlying struct declares
// them. get_struct_field_tid answering -1 must therefore NOT be read as "no
// such field"; only a resolvable declaration that omits the field proves
// absence.
// Prove absence from sfield_pool, the same shape source get_struct_field_tid uses for
// EXISTENCE. A runtime-minted struct (ProcessResult, Duration, Instant, FsError via
// ensure_runtime_struct_type) has only the decl node the mint synthesizes out of this pool,
// so the pool is where its shape is first known. Absence and existence must agree from this
// one source or a bad field access on such a type escapes E0525. A base tid with NO sfield
// entries is an under-resolved handle (an inferred element), not a known-empty shape —
// return 0 (cannot prove).
fn tc_sfield_shape_provably_absent(obj_t: Int, fname: Str) -> Int {
    let base = tc_struct_base_tid(obj_t)
    let mut found_any = 0
    let mut i = 0
    while i < sfield_pool.len() {
        let sf = sfield_pool.get(i).unwrap()
        if sf.struct_id == base {
            found_any = 1
            if sf.name == fname { return 0 }
        }
        i = i + 1
    }
    if found_any == 0 { return 0 }
    1
}

fn tc_struct_field_provably_absent(obj_t: Int, fname: Str) -> Int {
    let t = ty_pool.get(obj_t).unwrap()
    let decl = tc_struct_decl_nodes.get(strip_module_qualifier(t.name)) ?? -1
    if decl == -1 { return tc_sfield_shape_provably_absent(obj_t, fname) }
    let flds_sl = node_fields(decl)
    if flds_sl == -1 { return 1 }
    let mut i = 0
    while i < sublist_length(flds_sl) {
        if node_name(sublist_get(flds_sl, i)) == fname { return 0 }
        i = i + 1
    }
    1
}

// A struct-literal head `Name { ... }` may name only a constructible product type: a struct
// declared with a body. A builtin scalar (Int), an enum head (only its variants construct, not
// the enum type itself), and an @ffi.opaque handle (sealed to the FFI boundary, has no
// user-callable constructor — sections/07_trust_modules_metadata.md section 9.1.4) are not
// constructible. 03_types.md:1084 requires the head to denote a product type.
fn tc_head_constructible_struct(stid: Int) -> Int {
    if type_kind(stid) != TyKind.Struct { return 0 }
    if ffi_opaque_type_set.contains_key(tc_resolve(stid)) != 0 { return 0 }
    1
}

// Takes the head's tid beside its spelling, because the spelling alone cannot say whether the
// head is a handle: a rename introduces a name no declaration carries, and the literal was
// accepted, minting a handle outside the FFI boundary. A builtin head has no tid, so -1 says
// "not a handle" and the general refusal below answers.
fn tc_report_unconstructible_head(stid: Int, sname: Str, node: Int) ! Diag.Report {
    if stid >= 0 && ffi_opaque_type_set.contains_key(tc_resolve(stid)) != 0 {
        diag_error_at("TypeError", TYPE_ERROR, "cannot construct @ffi.opaque handle `{sname}` outside the FFI boundary", node, "an opaque handle has no user-callable constructor; it is produced only at the FFI boundary (section 9.1.4)")
        return
    }
    diag_error_at("TypeError", TYPE_ERROR, "`{sname}` is not a constructible struct type", node, "struct-literal syntax Name \{ ... } requires Name to name a struct type")
}

// Normalize a possibly-monomorphized struct instance tid (Box[Int]) to its base
// declaration tid (Box), by name. Any consumer that maps a struct tid
// back to declaration-level data keyed on the base tid (fields; anything using
// sf.struct_id) must normalize first. The input is resolved first, so a solved metavar
// standing for a struct normalizes too; a bare tid, a non-struct tid, or an unresolvable
// name returns the input unchanged.
fn tc_struct_base_tid(tid0: Int) -> Int {
    // Resolve first: a value whose type was INFERRED rather than annotated carries a bound
    // metavar, not the struct itself (`let mut xs = []` then `xs.push(p)` pins the element, so
    // `xs.get(0).unwrap()` is an α that solves to the struct). The pool entry for an α is kind
    // Unknown, so without resolving, every field lookup through such a value answered "no
    // field" and the field access carried no type at all.
    let tid = tc_resolve(tid0)
    if tid < 0 || tid >= ty_pool.len() { return tid0 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Struct { return tid0 }
    if t.params_count == 0 { return tid }
    let base = lookup_named_type(strip_module_qualifier(t.name))
    if base == -1 { return tid }
    base
}

fn get_variant_by_name(enum_tid: Int, vname: Str) -> Int {
    for i in evar_slots_by_name.get(vname) ?? [] {
        if evar_pool.get(i).unwrap().enum_id == enum_tid { return i }
    }
    -1
}

fn lookup_evfield_type_by_index(var_idx: Int, idx: Int) -> Int {
    let mut i = 0
    let mut seen = 0
    while i < evfield_pool.len() {
        let ef = evfield_pool.get(i).unwrap()
        if ef.var_idx == var_idx {
            if seen == idx { return ef.type_id }
            seen = seen + 1
        }
        i = i + 1
    }
    -1
}

fn lookup_evfield_type_by_name(var_idx: Int, name: Str) -> Int {
    let mut i = 0
    while i < evfield_pool.len() {
        let ef = evfield_pool.get(i).unwrap()
        if ef.var_idx == var_idx && ef.name == name {
            return ef.type_id
        }
        i = i + 1
    }
    -1
}

// Rewrite a variant field's DECLARED (generic) tid through the scrutinee's mono
// instance args, so a match binder is typed at its concrete instance rather than
// the enum's raw typevars. evfield_pool stores the generic field type (`(Box[T],
// Box[T])`); the scrutinee hint carries the instance (`Box[Int]`). Zipping the
// enum decl's tparams against the instance's arg tids and substituting turns the
// binder's node tid concrete (`(Box[Int], Box[Int])`) — the sole authority the C
// spelling reads. Without it a struct/enum tuple element erases to the bare base
// (`blink_Box`), which the physical mono carrier (`blink_Box_0Int`) then rejects.
// A no-op when the hint is not a generic instance (params_count 0) or carries no
// matching typevar. `substitute_typevar_tid` appends to ty_param_list, so every
// instance arg is read into `binds` BEFORE it runs.
fn tc_subst_evfield_from_instance(field_tid: Int, inst_tid: Int) -> Int {
    if field_tid < 0 || inst_tid < 0 || inst_tid >= ty_pool.len() { return field_tid }
    let ie = ty_pool.get(inst_tid).unwrap()
    if ie.params_count == 0 { return field_tid }
    if ie.kind != TyKind.Enum && ie.kind != TyKind.Struct { return field_tid }
    let decl = tc_type_decl_nodes.get(strip_module_qualifier(ie.name)) ?? -1
    if decl == -1 { return field_tid }
    let tparams_sl = node_type_params(decl)
    if tparams_sl == -1 { return field_tid }
    let mut binds: Map[Str, Int] = Map()
    let mut i = 0
    while i < sublist_length(tparams_sl) && i < ie.params_count {
        let arg = ty_param_list.get(ie.params_start + i).unwrap()
        let tp = sublist_get(tparams_sl, i)
        binds.insert(node_name(tp), arg)
        binds.insert(tc_binder_key(tp, node_name(tp)), arg)
        i = i + 1
    }
    substitute_typevar_tid(field_tid, binds)
}

// A declared member's tid read at an instance of its owner. The member pools register a
// field against the BASE declaration, so a generic type's member is declared over that
// type's own binders and only the instance's arguments say what the binders stand for.
// -1 is the declaration itself, where the declared tid is already the answer.
pub fn tc_member_tid_at_instance(declared_tid: Int, inst_tid: Int) -> Int {
    if inst_tid < 0 { return declared_tid }
    tc_subst_evfield_from_instance(declared_tid, inst_tid)
}

// The tid of `fname` on `recv_tid`, read at the instance rather than at the declaration.
// sfield_pool registers a field against the BASE declaration, so a generic struct's field
// is declared over the struct's own binders; only the instance's arguments say what those
// stand for at this receiver. A no-op for a struct that declares no parameters.
pub fn tc_field_tid_at_instance(recv_tid: Int, fname: Str) -> Int {
    let declared = get_struct_field_tid(recv_tid, fname)
    if declared < 0 { return -1 }
    tc_subst_evfield_from_instance(declared, recv_tid)
}

// ── Declared shape, by slot ───────────────────────────────────────────────
//
// sfield_pool / evar_pool / evfield_pool are the one place a nominal type's declared
// shape is registered, including the runtime-minted structs (ProcessResult, FsError)
// that have no declaration node at all. A reader that walked the AST annotations
// instead would be a second shape authority and would miss those types entirely, so
// codegen asks here. A slot is an index into the pool, handed back so a caller reads
// each entry once instead of rescanning the pool per field.

pub fn tc_struct_field_slots(struct_tid: Int) -> List[Int] {
    let base = tc_struct_base_tid(struct_tid)
    let mut out: List[Int] = []
    let mut i = 0
    while i < sfield_pool.len() {
        if sfield_pool.get(i).unwrap().struct_id == base { out.push(i) }
        i = i + 1
    }
    out
}

pub fn tc_sfield_name(slot: Int) -> Str {
    if slot < 0 || slot >= sfield_pool.len() { return "" }
    sfield_pool.get(slot).unwrap().name
}

pub fn tc_sfield_tid(slot: Int) -> Int {
    if slot < 0 || slot >= sfield_pool.len() { return -1 }
    sfield_pool.get(slot).unwrap().type_id
}

pub fn tc_enum_variant_slots(enum_tid: Int) -> List[Int] {
    let mut out: List[Int] = []
    let mut i = 0
    while i < evar_pool.len() {
        if evar_pool.get(i).unwrap().enum_id == enum_tid { out.push(i) }
        i = i + 1
    }
    out
}

pub fn tc_evar_name(slot: Int) -> Str {
    if slot < 0 || slot >= evar_pool.len() { return "" }
    evar_pool.get(slot).unwrap().name
}

pub fn tc_evar_has_data(slot: Int) -> Int {
    if slot < 0 || slot >= evar_pool.len() { return 0 }
    evar_pool.get(slot).unwrap().has_data
}

// True when any variant of an enum declares a field. One payload variant makes the whole
// type a tagged union in C, so this is a fact about the enum and never about the variant
// asked. An instance tid is normalized first, because the variant table is keyed on the
// base declaration.
pub fn tc_enum_has_payload(enum_tid: Int) -> Bool {
    let base = tc_enum_base_tid(tc_resolve(enum_tid))
    for slot in tc_enum_variant_slots(base) {
        if tc_evar_has_data(slot) != 0 { return true }
    }
    false
}

pub fn tc_evar_field_slots(var_slot: Int) -> List[Int] {
    let mut out: List[Int] = []
    let mut i = 0
    while i < evfield_pool.len() {
        if evfield_pool.get(i).unwrap().var_idx == var_slot { out.push(i) }
        i = i + 1
    }
    out
}

pub fn tc_evfield_name(slot: Int) -> Str {
    if slot < 0 || slot >= evfield_pool.len() { return "" }
    evfield_pool.get(slot).unwrap().name
}

pub fn tc_evfield_tid(slot: Int) -> Int {
    if slot < 0 || slot >= evfield_pool.len() { return -1 }
    evfield_pool.get(slot).unwrap().type_id
}

// Every field type a struct or enum declares, as written over its own binders: a struct's
// fields, or every variant's payload fields. Any other kind declares none.
pub fn tc_declared_field_tids(tid0: Int) -> List[Int] {
    let tid = tc_resolve(tid0)
    let k = type_kind(tid)
    let mut out: List[Int] = []
    if k == TyKind.Struct {
        for slot in tc_struct_field_slots(tid) { out.push(tc_sfield_tid(slot)) }
    }
    if k == TyKind.Enum {
        for v in tc_enum_variant_slots(tc_enum_base_tid(tid)) {
            for f in tc_evar_field_slots(v) { out.push(tc_evfield_tid(f)) }
        }
    }
    out
}

// Whether `Ptr` occurs anywhere in the type, through generic arguments and through the fields
// of a struct or enum at any depth: the spec's "pointer-bearing" (§9.1.1, Scope tags). A
// function type answers 0 — a closure carries a scope tag through what it captures, not
// through its type.
pub fn tc_tid_is_pointer_bearing(tid: Int) -> Int {
    let r = tc_resolve(tid)
    match tc_ptr_bearing_memo.get(r) {
        Some(hit) => { return hit }
        None => {}
    }
    let mut seen: Map[Int, Int] = Map()
    let answer = ptr_bearing_walk(r, seen)
    if !seen.contains_key(PTR_BEARING_MET_METAVAR) { tc_ptr_bearing_memo.insert(r, answer) }
    answer
}

// The answer of tc_tid_is_pointer_bearing by resolved tid, for one check. Escape asks for every
// expression, and one walk reads the whole field pools. A tid names one instance, and its
// entry, the field declarations and the instances they map to are fixed once interned, so
// only init_types, which clears them, clears this. The one entry that can still change is a
// metavar a later unify binds, so a walk that meets an unbound one is not kept.
let mut tc_ptr_bearing_memo: Map[Int, Int] = Map()
let PTR_BEARING_MET_METAVAR = -2

fn ptr_bearing_walk(r: Int, seen: Map[Int, Int]) -> Int {
    if r < 0 || r >= ty_pool.len() { return 0 }
    if seen.contains_key(r) { return 0 }
    seen.insert(r, 1)
    if tc_is_unbound_metavar(r) != 0 { seen.insert(PTR_BEARING_MET_METAVAR, 1) }
    let k = type_kind(r)
    if k == TyKind.Ptr { return 1 }
    if k == TyKind.Fn { return 0 }
    if k == TyKind.Struct || k == TyKind.Enum {
        for f in tc_declared_field_tids(r) {
            if ptr_bearing_walk(tc_resolve(tc_member_tid_at_instance(f, r)), seen) != 0 { return 1 }
        }
    }
    let mut i = 0
    while i < tc_tid_child_count(r) {
        if ptr_bearing_walk(tc_resolve(tc_tid_child(r, i)), seen) != 0 { return 1 }
        i = i + 1
    }
    0
}

// The first struct or enum a value of this type holds inside itself, or -1. A function,
// iterator, pointer or template context is opaque to a copy of the value, so the search
// stops there. The
// declaration is the identity, so `Tree[Int]` holding `Tree[List[Int]]` counts too.
pub fn tc_tid_reaches_itself(tid: Int) -> Int {
    let mut open: List[Int] = []
    let mut done: Map[Int, Int] = Map()
    reach_self_walk(tc_resolve(tid), open, done)
}

fn reach_self_walk(r: Int, open: List[Int], done: Map[Int, Int]) -> Int {
    if r < 0 || r >= ty_pool.len() { return -1 }
    let k = type_kind(r)
    if k == TyKind.Struct || k == TyKind.Enum {
        let base = if k == TyKind.Struct { tc_struct_base_tid(r) } else { tc_enum_base_tid(r) }
        for o in open {
            if o == base { return r }
        }
        if done.contains_key(r) { return -1 }
        open.push(base)
        for f in tc_declared_field_tids(r) {
            let hit = reach_self_walk(tc_resolve(tc_member_tid_at_instance(f, r)), open, done)
            if hit >= 0 { return hit }
        }
        let _ = open.pop()
        done.insert(r, 1)
        return -1
    }
    if k == TyKind.Fn || k == TyKind.Iterator || k == TyKind.Ptr || k == TyKind.Handle || k == TyKind.Channel || k == TyKind.Template {
        return -1
    }
    let mut i = 0
    while i < tc_tid_child_count(r) {
        let hit = reach_self_walk(tc_resolve(tc_tid_child(r, i)), open, done)
        if hit >= 0 { return hit }
        i = i + 1
    }
    -1
}

// The declared tid of a named field on an enum variant, for codegen match binding.
// Returns -1 when the enum/variant/field can't be resolved.
pub fn tc_variant_field_tid_by_name(enum_name: Str, variant_name: Str, field_name: Str) -> Int {
    let enum_tid = lookup_named_type(enum_name)
    if enum_tid < 0 { return -1 }
    let var_idx = get_variant_by_name(enum_tid, variant_name)
    if var_idx < 0 { return -1 }
    lookup_evfield_type_by_name(var_idx, field_name)
}

// True when an enum variant field is a TUPLE that reaches the enum itself at any
// nesting depth (`Pair(p: (Box[T], Box[T]))` or `Node(p: (Int, (Box, Box)))` on
// `Box`). Spelled by value the mono tuple carrier embeds the enum on every
// self-referring side — an infinitely-sized type whose typedef also
// forward-references the enum. Such a field must be BOXED like a direct
// self-recursive field, so codegen (typedef/ctor/match-binder) branches on this
// instead of only the direct `field == enum` shape.
pub fn tc_variant_field_is_selfrec_tuple(enum_name: Str, variant_name: Str, field_name: Str) -> Int {
    let ftid = tc_variant_field_tid_by_name(enum_name, variant_name, field_name)
    if ftid < 0 { return 0 }
    let rtid = tc_tid_resolved(ftid)
    if tc_tid_kind(rtid) != TyKind.Tuple { return 0 }
    let enum_tid = lookup_named_type(enum_name)
    if enum_tid < 0 { return 0 }
    tc_tuple_tid_references_enum(rtid, enum_tid)
}

// A nested tuple embeds the enum just as directly as a top-level element does
// (`(Int, (Box, Box))`): the outer carrier holds the inner carrier by value,
// which holds the enum by value. Descend into nested tuples so the whole field
// is boxed and its carriers ordered after the enum.
fn tc_tuple_tid_references_enum(tup_rtid: Int, enum_tid: Int) -> Int {
    let n = tc_tid_child_count(tup_rtid)
    let mut i = 0
    while i < n {
        let child = tc_tid_resolved(tc_tid_child(tup_rtid, i))
        // A non-generic self element interns as the bare enum tid (exact identity);
        // a generic one interns as an instance (`Box[T]`, a distinct tid) whose base
        // name resolves back to the bare enum. The instance carries only its base
        // name (module already stripped at interning), so the match is by that name —
        // a foreign same-named generic enum would false-match here, but its identity
        // was already collapsed upstream, so this does not widen the hazard.
        if child == enum_tid { return 1 }
        if tc_tid_kind(child) == TyKind.Enum {
            if lookup_named_type(strip_module_qualifier(ty_pool.get(child).unwrap().name)) == enum_tid { return 1 }
        }
        if tc_tid_kind(child) == TyKind.Tuple {
            if tc_tuple_tid_references_enum(child, enum_tid) != 0 { return 1 }
        }
        i = i + 1
    }
    0
}

fn lookup_fnsig(name: Str) -> Int {
    if nr_current_module != "" {
        let own = match nr_module_names.get(nr_current_module) {
            Some(r) => r.sigs.get(name) ?? -1
            None => -1
        }
        if own != -1 { return own }
    }
    fnsig_map.get(name) ?? -1
}

// Recursively substitute typevar tids in `t` using the name→tid map `binds`
// (typevar-name → concrete tid). Mirrors types_compatible's structural dispatch
// and rebuilds compound shells via the make_* constructors so the returned tid
// carries concrete elements. A kind with no embedded typevar — or an unbound
// typevar — is returned unchanged; a new pool entry is allocated only when a
// child actually changes (avoids ty_pool churn).
pub fn substitute_typevar_tid(t0: Int, binds: Map[Str, Int]) -> Int {
    // A metavariable inference already bound IS the type it was bound to, so it is resolved
    // before the kind is read. A slot holding a metavar bound to a type parameter is a slot
    // this substitution must replace; reading the metavar's own kind instead leaves the
    // parameter standing in the instance type, and the instance is the one place it cannot.
    let t = tc_resolve(t0)
    if t < 0 || t >= ty_pool.len() { return t }
    let e = ty_pool.get(t).unwrap()
    let k = e.kind
    if k == TyKind.Typevar {
        // Keyed on the BINDER, so a typevar bound by a different declaration finds no
        // entry and survives substitution unchanged. It then reaches monomorphization
        // unsolved and is reported, instead of silently taking this context's argument
        // for the same letter.
        match binds.get(tc_binder_key(e.inner1, e.name)) {
            Some(tid) => return tid
            None => return t
        }
    }
    if k == TyKind.List {
        let inner = substitute_typevar_tid(e.inner1, binds)
        if inner == e.inner1 { return t }
        return make_list_type(inner)
    }
    if k == TyKind.Option {
        let inner = substitute_typevar_tid(e.inner1, binds)
        if inner == e.inner1 { return t }
        return make_option_type(inner)
    }
    if k == TyKind.Set {
        let inner = substitute_typevar_tid(e.inner1, binds)
        if inner == e.inner1 { return t }
        return make_set_type(inner)
    }
    // The remaining one-child kinds, per tc_tid_child_count. The SUBSTITUTION half of the pair
    // whose discovery half is unify_typevar_binds: leaving a bind discovered but unapplied
    // spells the param with the typevar still in it, so the type reaches monomorphization
    // unsolved either way. Both halves have to list the same kinds.
    if k == TyKind.Handle {
        let inner = substitute_typevar_tid(e.inner1, binds)
        if inner == e.inner1 { return t }
        return make_handle_type(inner)
    }
    if k == TyKind.Channel {
        let inner = substitute_typevar_tid(e.inner1, binds)
        if inner == e.inner1 { return t }
        return make_channel_type(inner)
    }
    if k == TyKind.Iterator {
        let inner = substitute_typevar_tid(e.inner1, binds)
        if inner == e.inner1 { return t }
        return make_iterator_type(inner)
    }
    if k == TyKind.Ptr {
        let inner = substitute_typevar_tid(e.inner1, binds)
        if inner == e.inner1 { return t }
        return make_ptr_type(inner)
    }
    if k == TyKind.Template {
        let inner = substitute_typevar_tid(e.inner1, binds)
        if inner == e.inner1 { return t }
        return make_template_type(inner)
    }
    if k == TyKind.Result {
        let ok = substitute_typevar_tid(e.inner1, binds)
        let er = substitute_typevar_tid(e.inner2, binds)
        if ok == e.inner1 && er == e.inner2 { return t }
        return make_result_type(ok, er)
    }
    if k == TyKind.Map {
        let kk = substitute_typevar_tid(e.inner1, binds)
        let vv = substitute_typevar_tid(e.inner2, binds)
        if kk == e.inner1 && vv == e.inner2 { return t }
        return make_map_type(kk, vv)
    }
    if k == TyKind.Tuple {
        // Read every original element into `elems` BEFORE calling make_tuple_type:
        // the constructor appends to ty_param_list, the same array we read
        // e.params_start.. from, so finishing the read first avoids aliasing.
        let mut elems: List[Int] = []
        let mut changed = 0
        let mut i = 0
        while i < e.params_count {
            let orig = ty_param_list.get(e.params_start + i).unwrap()
            let sub = substitute_typevar_tid(orig, binds)
            if sub != orig { changed = 1 }
            elems.push(sub)
            i = i + 1
        }
        if changed == 0 { return t }
        return make_tuple_type(elems)
    }
    if k == TyKind.Struct {
        // A monomorphized struct instance (`Box[T]`, params_count>=1) may embed a
        // typevar in a type-arg; substitute each and rebuild via make_struct_
        // instance_type. Same aliasing guard as TyKind.Tuple: make_struct_instance_type
        // appends to ty_param_list (the array we read e.params_start.. from), so
        // finish the read into `elems` FIRST. The bare generic base (params_count 0)
        // has no type-args — the loop is empty, changed stays 0, `t` returns as-is.
        let mut elems: List[Int] = []
        let mut changed = 0
        let mut i = 0
        while i < e.params_count {
            let orig = ty_param_list.get(e.params_start + i).unwrap()
            let sub = substitute_typevar_tid(orig, binds)
            if sub != orig { changed = 1 }
            elems.push(sub)
            i = i + 1
        }
        if changed == 0 { return t }
        return make_struct_instance_type(e.name, elems)
    }
    if k == TyKind.Enum {
        // The enum twin of the TyKind.Struct arm: a monomorphized enum instance (`Box[T]`,
        // params_count>=1) may embed a typevar in a type-arg; substitute each and rebuild
        // via make_enum_instance_type. Same aliasing guard — read all originals into
        // `elems` BEFORE the constructor appends to ty_param_list. A bare generic enum
        // (params_count 0) has no type-args → empty loop → changed==0 → returns `t`
        // unchanged.
        let mut elems: List[Int] = []
        let mut changed = 0
        let mut i = 0
        while i < e.params_count {
            let orig = ty_param_list.get(e.params_start + i).unwrap()
            let sub = substitute_typevar_tid(orig, binds)
            if sub != orig { changed = 1 }
            elems.push(sub)
            i = i + 1
        }
        if changed == 0 { return t }
        return make_enum_instance_type(e.name, elems)
    }
    if k == TyKind.Fn {
        // A Fn holds its RETURN in inner1 and its params variadically, so `fn(T) -> T`
        // embeds a typevar in exactly the way `List[T]` does, and it must be substituted:
        // otherwise closure_sig_from_tid declines on the typevar child, the binding keeps an
        // empty closure sig, and an empty sig is indistinguishable from "not a closure", so a
        // closure read out of a container inside a generic fn reports UndefinedFunction.
        //
        // Same aliasing guard as the Tuple/Struct/Enum arms: read every param out of
        // ty_param_list BEFORE make_fn_type appends to it. The return is substituted first
        // and is NOT part of that read, so its order does not matter.
        let ret = substitute_typevar_tid(e.inner1, binds)
        let mut params: List[Int] = []
        let mut changed = if ret == e.inner1 { 0 } else { 1 }
        let mut i = 0
        while i < e.params_count {
            let orig = ty_param_list.get(e.params_start + i).unwrap()
            let sub = substitute_typevar_tid(orig, binds)
            if sub != orig { changed = 1 }
            params.push(sub)
            i = i + 1
        }
        if changed == 0 { return t }
        return make_fn_type(ret, params)
    }
    // Every scalar/nominal kind: no embedded typevar to rewrite.
    t
}

// The tparam-name → concrete-tid map for a codegen MONO CONTEXT: the enclosing
// monomorphized generic's tparam sublist zipped against its per-slot arg tids.
// Factored out of tc_mono_tids_subst so there is exactly ONE construction site for
// this pairing — a caller that skips the `tid >= 0` filter would bind a tparam to
// -1, which substitute_typevar_tid would then splice into a rebuilt instance as a
// pool index that is not a type.
pub fn tc_mono_binds_map(mono_tparams_sl: Int, mono_arg_tids: List[Int]) -> Map[Str, Int] {
    let mut binds: Map[Str, Int] = Map()
    if mono_tparams_sl == -1 { return binds }
    let mut mi = 0
    while mi < sublist_length(mono_tparams_sl) && mi < mono_arg_tids.len() {
        let tid = mono_arg_tids.get(mi).unwrap()
        if tid >= 0 {
            let tp = sublist_get(mono_tparams_sl, mi)
            binds.insert(node_name(tp), tid)
            binds.insert(tc_binder_key(tp, node_name(tp)), tid)
        }
        mi = mi + 1
    }
    binds
}

// Rewrite every typevar in `tid` through a codegen MONO CONTEXT, returning the
// interned tid of the substituted type (or `tid` itself when nothing changed).
//
// This is what lets a struct-instance tid written in terms of the ENCLOSING generic's
// binders — `GT[(T, Int)]` inside `fn wrap[T]` — be classified and spelled at the
// literal, where the only alternative was the I0001 chokepoint. The
// substitution happens HERE rather than by relaxing an encodability predicate on
// purpose: a typevar has no C spelling, so admitting TyKind.Typevar into
// tc_tid_tuple_elem_faithful would let a genuinely-unsolved `T` produce a segment.
// Eliminate the typevar; keep the predicates conservative.
//
// Interning at codegen time is not a new hazard: substitute_typevar_tid is already
// reached from codegen via tc_resolve_tparam_tid, so the pool already grows during
// emission and every reader is index-based.
//
// No-op by construction when `tid < 0` or the mono context is empty, so a caller can
// apply it unconditionally and still be byte-identical outside a mono body.
pub fn tc_tid_subst_mono(tid: Int, mono_tparams_sl: Int, mono_arg_tids: List[Int]) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return tid }
    if mono_tparams_sl == -1 || mono_arg_tids.len() == 0 { return tid }
    substitute_typevar_tid(tid, tc_mono_binds_map(mono_tparams_sl, mono_arg_tids))
}

// Structurally unify a param tid against a concrete arg tid, recording every
// typevar→concrete binding into `binds`. The reverse of substitute_typevar_tid:
// where that walks one tid rewriting typevars via `binds`, this walks the param
// and arg tids in lockstep and *discovers* the bindings. A bare typevar param
// binds directly; a compound param recurses into the matching children so a
// typevar buried inside `List[T]` / `Option[T]` / `Set[T]` / `Result[T,E]` /
// `Map[K,V]` / `(A, B)` is still inferred. Pure bind collection — allocates NO
// pool entries (no make_* calls), so it never touches ty_param_list and is free
// of the tuple aliasing hazard substitute_typevar_tid guards against. The first
// CONCRETE binding wins; a later concrete arg overwrites only a placeholder bind
// (a non-concrete metavar/typevar) left by an earlier metavar-carrying sibling
// arg (see the TyKind.Typevar branch below); kind mismatches (arg not shaped like the
// param) bind nothing.
// A bind target is CONCRETE when, after following bound metavars, it is neither
// an unbound metavar nor a bare typevar — i.e. it names a real type a downstream
// substitution/pin can commit to. Used by unify_typevar_binds so a concrete arg
// can overwrite a placeholder bind left by a metavar-carrying sibling arg.
fn bind_target_is_concrete(tid: Int) -> Int {
    let r = tc_resolve(tid)
    if r < 0 || r >= ty_pool.len() { return 0 }
    if tc_is_unbound_metavar(r) != 0 { return 0 }
    if ty_pool.get(r).unwrap().kind == TyKind.Typevar { return 0 }
    // The `?` hole is the third spelling of "nothing to commit to", and it arrives here from
    // a closure argument whose own seed left the type-parameter position open. Counting it as
    // concrete let that placeholder claim the type parameter outright, so a later argument
    // carrying the real type could not overwrite it and the closure's position stayed open —
    // which made the answer depend on which side of the call the closure was written.
    if tc_tid_has_unknown(r) != 0 { return 0 }
    1
}

fn unify_typevar_binds(ptid: Int, atid: Int, binds: Map[Str, Int]) {
    if ptid < 0 || ptid >= ty_pool.len() { return }
    if atid < 0 || atid >= ty_pool.len() { return }
    let pe = ty_pool.get(ptid).unwrap()
    let pk = pe.kind
    if pk == TyKind.Typevar {
        // "First binding wins" is only correct among CONCRETE args. A
        // metavar-carrying arg — a bare `Map()`/`Set()` whose element is a fresh
        // unbound α — unifies its typevar against that α; recording it would poison
        // the bind and block a later concrete sibling arg from supplying the real
        // type (`fill(Map(), 256, "x")` would otherwise bind K to Map()'s α before the
        // `256` arg could bind K:=Int). So: record a bind only when it is absent, or
        // when the existing bind is itself non-concrete (a placeholder α/typevar) and
        // the new atid IS concrete. Never let a non-concrete atid overwrite or claim.
        let bkey = tc_binder_key(pe.inner1, pe.name)
        match binds.get(bkey) {
            Some(prev) => {
                if bind_target_is_concrete(atid) != 0 && bind_target_is_concrete(prev) == 0 {
                    binds.insert(pe.name, atid)
                    binds.insert(bkey, atid)
                }
            }
            None => {
                binds.insert(pe.name, atid)
                binds.insert(bkey, atid)
            }
        }
        return
    }
    let ae = ty_pool.get(atid).unwrap()
    if ae.kind != pk { return }
    // Every one-child kind, per tc_tid_child_count — the layout authority. A kind left out
    // here is not a missed optimization: a typevar reachable only through it has no other way
    // to be inferred and reaches monomorphization unsolved (I0001 UnsolvedTypeVarAtCodegen),
    // which is what the Fn arm below was added to stop one kind over.
    if pk == TyKind.List || pk == TyKind.Option || pk == TyKind.Set || pk == TyKind.Handle || pk == TyKind.Iterator {
        unify_typevar_binds(pe.inner1, ae.inner1, binds)
        return
    }
    if pk == TyKind.Channel || pk == TyKind.Ptr || pk == TyKind.Template {
        unify_typevar_binds(pe.inner1, ae.inner1, binds)
        return
    }
    if pk == TyKind.Result || pk == TyKind.Map {
        unify_typevar_binds(pe.inner1, ae.inner1, binds)
        unify_typevar_binds(pe.inner2, ae.inner2, binds)
        return
    }
    if pk == TyKind.Tuple {
        if pe.params_count != ae.params_count { return }
        let mut i = 0
        while i < pe.params_count {
            let pc = ty_param_list.get(pe.params_start + i).unwrap()
            let ac = ty_param_list.get(ae.params_start + i).unwrap()
            unify_typevar_binds(pc, ac, binds)
            i = i + 1
        }
        return
    }
    if pk == TyKind.Fn {
        // The DISCOVERY twin of substitute_typevar_tid's Fn arm. A typevar reachable
        // only through a closure's signature — `fs: List[fn(Int) -> T]` with no second param
        // mentioning T — has no other way to be inferred, and without this arm it reaches
        // monomorphization unsolved: I0001 UnsolvedTypeVarAtCodegen, mono args
        // 'BLINK_I0001_erased_slot'.
        //
        // Structural like the Tuple arm above, not nominal: a Fn has no name to match, so the
        // arity check is the whole admission test. The return lives in inner1 and the params
        // follow variadically, so both have to be walked — a typevar can sit in either.
        if pe.params_count != ae.params_count { return }
        unify_typevar_binds(pe.inner1, ae.inner1, binds)
        let mut i = 0
        while i < pe.params_count {
            let pc = ty_param_list.get(pe.params_start + i).unwrap()
            let ac = ty_param_list.get(ae.params_start + i).unwrap()
            unify_typevar_binds(pc, ac, binds)
            i = i + 1
        }
        return
    }
    if pk == TyKind.Struct || pk == TyKind.Enum {
        // A generic struct/enum param (`b: Box[T]`, `n: Tree[T]`) binds its typevars
        // from an instance arg (`Box[Int]`, `Tree[Int]`). Both are nominal — the base
        // names must match (module-qualifier-stripped) as well as the arity, unlike
        // the structural tuple case above. Walk the type-args in lockstep. A bare
        // generic base (no args, params_count 0) has nothing to bind and the loop is
        // empty. The TyKind.Enum case covers a recursive generic-enum field
        // (`Branch(left: Tree[T], …)` unified against a `Tree[Int]` arg).
        if strip_module_qualifier(pe.name) != strip_module_qualifier(ae.name) { return }
        if pe.params_count != ae.params_count { return }
        let mut i = 0
        while i < pe.params_count {
            let pc = ty_param_list.get(pe.params_start + i).unwrap()
            let ac = ty_param_list.get(ae.params_start + i).unwrap()
            unify_typevar_binds(pc, ac, binds)
            i = i + 1
        }
        return
    }
}

// Build a typevar-name → concrete-tid map from the call's args by structurally
// unifying each param tid against its argument's inferred tid. Covers both the
// whole-bare-typevar rule (`x: T`) and typevars nested inside a compound param
// (`x: List[T]`, `x: (T, Int)`, `x: Map[K, V]`, …) via unify_typevar_binds.
// The type a generic function's NAME has as a value: its declared type with every binder
// replaced by a fresh metavar, one set per reference. Two references to the same generic
// function are two values and may be instantiated differently, so the mint cannot be shared.
fn tc_generic_fn_value_tid(sig: Int, decl_tid: Int) -> Int {
    let fs = fnsig_pool.get(sig).unwrap()
    let mut binds: Map[Str, Int] = Map()
    let mut i = 0
    while i < fs.type_params_count {
        let idx = fs.type_params_start + i
        let nm = fnsig_type_param_names.get(idx) ?? ""
        let binder = fnsig_tparam_nodes.get(idx) ?? -1
        binds.insert(tc_binder_key(binder, nm), make_metavar())
        i = i + 1
    }
    substitute_typevar_tid(decl_tid, binds)
}

// Whether a declaration writes type parameters of its own. -1 is a signature with no
// declaration node behind it, which declares nothing.
fn tc_decl_has_own_type_params(decl: Int) -> Int {
    if decl < 0 { return 0 }
    let tps = node_type_params(decl)
    if tps == -1 { return 0 }
    if sublist_length(tps) > 0 { 1 } else { 0 }
}

// `self_offset` shifts which fnsig param each call argument aligns with. Free-fn calls
// pass 0 (arg `pi` ↔ param `pi`). A method call passes 1: the receiver supplies param 0
// (self), so call argument `pi` ↔ fnsig param `1 + pi`. This binds only the callee's own
// declared params, never self — matching check_arg_shapes' own self_offset discipline.
// `arg_tids` is what check_arg_shapes read for each argument, so every step of one call
// binds against the same metavariables.
fn build_typevar_binds(sig: Int, arg_tids: List[Int], self_offset: Int) -> Map[Str, Int] ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let fs = fnsig_pool.get(sig).unwrap()
    let param_start = fs.params_start
    let param_count = fs.params_count
    let mut binds: Map[Str, Int] = Map()
    let mut i = 0
    while i < arg_tids.len() {
        let pidx = i + self_offset
        let arg_t = arg_tids.get(i).unwrap()
        if pidx < param_count && arg_t >= 0 {
            let ptid = fnsig_param_list.get(param_start + pidx).unwrap()
            unify_typevar_binds(ptid, arg_t, binds)
        }
        i = i + 1
    }
    binds
}

// The argument tids for a call no signature check reads, each argument inferred once.
fn tc_infer_arg_tids(args_sl: Int) -> List[Int] ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let mut tids: List[Int] = []
    if args_sl == -1 { return tids }
    let mut i = 0
    while i < sublist_length(args_sl) {
        tids.push(tc_infer_unhinted(sublist_get(args_sl, i)))
        i = i + 1
    }
    tids
}

// An argument's slot is its parameter, so what the call itself is expected to be says
// nothing about it. Inferring under that hint would type the argument from the call's
// context, and the call's return pin would never see the argument's own metavariables.
@allow(UnrestoredMutation)
fn tc_infer_unhinted(node: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let saved_hint = tc_construct_hint
    tc_construct_hint = -1
    let t = infer_type(node)
    tc_construct_hint = saved_hint
    t
}

// A field access is expected to be the FIELD's type, never the receiver's. A generic literal
// whose field is declared as a bare type parameter learns that parameter from it, so the
// receiver is inferred at that instance with fresh metavariables for the other parameters.
// Any other receiver has nothing to learn from the field's expected type.
@allow(UnrestoredMutation)
fn tc_infer_field_receiver(obj_node: Int, fname: Str) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let saved_hint = tc_construct_hint
    tc_construct_hint = tc_field_receiver_hint(obj_node, fname, saved_hint)
    let t = infer_type(obj_node)
    tc_construct_hint = saved_hint
    t
}

fn tc_field_receiver_hint(obj_node: Int, fname: Str, field_hint: Int) -> Int {
    if field_hint < 0 { return -1 }
    if node_kind(obj_node) != NodeKind.StructLit { return -1 }
    let stid = lookup_named_type(node_type_name(obj_node))
    if stid == -1 || type_kind(stid) != TyKind.Struct { return -1 }
    let bare = tc_instance_base_name(stid)
    let decl = tc_struct_decl_nodes.get(bare) ?? -1
    if decl == -1 { return -1 }
    let tparams_sl = node_type_params(decl)
    if tparams_sl == -1 || sublist_length(tparams_sl) == 0 { return -1 }
    let declared = get_struct_field_tid(stid, fname)
    if declared == -1 || tc_tid_kind(declared) != TyKind.Typevar { return -1 }
    let tvname = tc_tid_name(declared)
    let mut args: List[Int] = []
    let mut found = 0
    let mut i = 0
    while i < sublist_length(tparams_sl) {
        if node_name(sublist_get(tparams_sl, i)) == tvname {
            args.push(field_hint)
            found = 1
        } else {
            args.push(make_metavar())
        }
        i = i + 1
    }
    if found == 0 { return -1 }
    make_struct_instance_type(bare, args)
}

// Enforce a call's type-param bounds against the concrete types discovered for it
// (E0306 TraitBoundNotSatisfied, spec 03_types.md:1193). Reads the sig's parallel
// name+bound side-tables. Emits ONLY on a provably-unmet bound (tc_type_satisfies_bound
// == -1); an unbound param, an unresolved concrete, or an unmodeled trait is skipped, so
// this never rejects a program that compiles today (those already die at `cc`).
fn tc_check_bounds_for_binds(sig: Int, binds: Map[Str, Int], node: Int) ! TypeCheck.Resolve, Diag.Report {
    let fs = fnsig_pool.get(sig).unwrap()
    let start = fs.type_params_start
    let count = fs.type_params_count
    let mut ti = 0
    while ti < count {
        let idx = start + ti
        if idx < fnsig_type_param_names.len() && idx < fnsig_tparam_bounds.len() {
            let name = fnsig_type_param_names.get(idx).unwrap()
            let bounds = fnsig_tparam_bounds.get(idx).unwrap()
            if bounds != "" && binds.contains_key(name) != 0 {
                let concrete = binds.get(name).unwrap()
                if tc_check_one_bound(name, bounds, concrete, node) == 0 {
                    tc_check_user_bounds(fs.decl, idx, concrete, binds, node)
                }
            }
        }
        ti = ti + 1
    }
    tc_check_hash_obligations_for_binds(sig, binds, node)
}

// One type param's declared-bound set vs. its concrete type. Iterating the known modeled
// traits (mirroring tc_type_satisfies_bound's coverage) avoids a pipe-string splitter and
// matches the existing tc_pipe_has idiom. Reports at most one bound per param: the first
// provably-unmet trait (`T: Ord` frames `|Ord|Eq|`, both -1 for a non-Ord type — one
// error, not two). Answers 1 when it reported.
fn tc_check_one_bound(name: Str, bounds: Str, concrete: Int, node: Int) -> Int ! TypeCheck.Resolve, Diag.Report {
    let traits = ["Add", "Sub", "Mul", "Div", "Rem", "Neg", "Ord", "Eq", "Display", "Debug", "Hash", "Serialize"]
    let mut i = 0
    while i < traits.len() {
        let tr = traits.get(i).unwrap()
        if tc_pipe_has(bounds, tr) != 0 && tc_type_satisfies_bound(concrete, tr) == -1 {
            let path = tc_trait_need(concrete, tr, [])
            let fixes = if path.len() > 0 { tc_trait_need_fixes(path.get(path.len() - 1).unwrap(), tr) } else { [] }
            let help = if fixes.len() > 0 { fixes.join("\n") } else {
                "pass an argument whose type implements {tr}, or derive/implement {tr} for it; the arithmetic traits (Add/Sub/Mul/Div/Rem/Neg) are sealed to the built-in numeric types"
            }
            diag_error_at_notes("TraitBoundNotSatisfied", TRAIT_BOUND_NOT_SATISFIED,
                "`{type_to_str(concrete)}` does not satisfy the {tc_core_trait_shown(tr)} bound on type parameter {name}", node, help,
                tc_trait_need_notes(path, tr))
            return 1
        }
        i = i + 1
    }
    0
}

// The bounds on the type parameter at `idx` whose trait a program module declares, read at
// the call's types: `U: Tr[Str]` holds for `Pt` only where an impl of `Tr` for `Pt` has the
// trait argument Str, and `V` in `U: Tr[V]` is the call's type for V. Reports at most one bound.
fn tc_check_user_bounds(decl: Int, idx: Int, concrete: Int, binds: Map[Str, Int], node: Int) ! TypeCheck.Resolve, Diag.Report {
    if decl < 0 { return }
    let tp = fnsig_tparam_nodes.get(idx) ?? NO_BINDER_NODE
    let block = tc_method_block.get(decl) ?? -1
    let impl_binders = if block != -1 && node_kind(block) == NodeKind.ImplBlock { node_impl_binders(block) } else { -1 }
    let _ = tc_report_unmet_user_bound(tp, impl_binders, node_type_params(decl), concrete, binds, node)
}

// The bounds of the impl a method call reached, on its binders and in its `where` clause,
// read at the receiver instance's arguments (sections/05_memory_compile_errors.md, "Checked
// at the call"). Empty `ibinds` means the impl's binders are not read off the receiver, so
// there is nothing to judge. Reports at most one bound.
fn tc_check_impl_bounds_at_call(decl: Int, ibinds: Map[Str, Int], node: Int) ! TypeCheck.Resolve, Diag.Report {
    let im = tc_method_block.get(decl) ?? -1
    if im == -1 || node_kind(im) != NodeKind.ImplBlock { return }
    let binders = node_impl_binders(im)
    let mut carriers: List[Int] = []
    let mut i = 0
    while binders != -1 && i < sublist_length(binders) {
        carriers.push(sublist_get(binders, i))
        i = i + 1
    }
    let wb = node_impl_where_bounds(im)
    let mut j = 0
    while wb != -1 && j < sublist_length(wb) {
        carriers.push(sublist_get(wb, j))
        j = j + 1
    }
    for c in carriers {
        let concrete = ibinds.get(node_name(c)) ?? -1
        if concrete == -1 { continue }
        if tc_check_one_bound(node_name(c), tparam_node_bound_traits(c), concrete, node) != 0 { return }
        if tc_report_unmet_user_bound(c, binders, -1, concrete, ibinds, node) != 0 { return }
    }
}

// E0306 for the first bound on `carrier` that tc_unmet_user_bound finds; answers 1 when it
// reported.
fn tc_report_unmet_user_bound(carrier: Int, outer_sl: Int, own_sl: Int, concrete0: Int, binds: Map[Str, Int], node: Int) -> Int ! TypeCheck.Resolve, Diag.Report {
    let concrete = tc_resolve(concrete0)
    let u = tc_unmet_user_bound(carrier, outer_sl, own_sl, concrete, binds)
    if u.trait_name == "" { return 0 }
    let shown = tc_trait_shown(u.trait_name)
    let bound_text = tc_trait_at_text(shown, u.want)
    let has = if u.held.impls == 0 { "it has no impl of {shown}" } else { "it implements {tc_trait_heads_text(shown, u.held.args, u.want.len())}" }
    // A type that has the compiler-known trait this bound's trait shadows looks as if it
    // should pass, so the note says why it does not (sections/07 §10.6).
    let spelled = tc_trait_spelling(u.trait_name)
    let mut notes: List[Str] = []
    if u.trait_name != spelled && tc_trait_is_compiler_known(spelled) && tc_type_satisfies_bound(concrete, spelled) == 1 {
        notes.push("`{type_to_str(concrete)}` implements `{spelled} (blink.core)`, a different trait with the same name as `{shown}`")
    }
    diag_error_at_notes("TraitBoundNotSatisfied", TRAIT_BOUND_NOT_SATISFIED,
        "`{type_to_str(concrete)}` does not satisfy the {bound_text} bound on type parameter {node_name(carrier)}: {has}", node,
        "pass an argument whose type implements {bound_text}, or write `impl {tc_trait_at_text(spelled, u.want)} for {type_to_str(concrete)}`",
        notes)
    1
}

// A bound `concrete` provably does not meet: the trait, the arguments the bound asks for at
// these types, and the impls the type has. `trait_name` is "" when every bound holds or
// cannot be judged.
type UnmetBound {
    trait_name: Str
    want: List[Int]
    held: ImplArgsHeld
}

// The first bound on `carrier` (a TypeParam, or an impl's `where` constraint, which has the
// same shape) whose trait a program module declares and which `concrete` provably does not
// meet at the bound's arguments. The arguments are read under `outer_sl` and `own_sl`, the
// binders in scope where the bound is written, then `binds` replaces them. A trait a std
// module declares is left to the modeled checks, as its impls include ones no impl block
// writes (the sealed Ops surfaces, From's identity rule).
fn tc_unmet_user_bound(carrier: Int, outer_sl: Int, own_sl: Int, concrete: Int, binds: Map[Str, Int]) -> UnmetBound ! TypeCheck.Resolve, Diag.Report {
    let none = UnmetBound { trait_name: "", want: [], held: ImplArgsHeld { verdict: 0, impls: 0, args: [] } }
    if carrier < 0 || node_kind(carrier) != NodeKind.TypeParam { return none }
    let bounds = node_elements(carrier)
    if bounds == -1 { return none }
    if tc_tid_is_judgeable(concrete) == 0 { return none }
    let mut i = 0
    while i < sublist_length(bounds) {
        let b = sublist_get(bounds, i)
        let trait_name = tc_bound_trait(b)
        let tr = tc_trait_node_idx.get(trait_name) ?? -1
        let args_sl = node_elements(b)
        let got = if args_sl == -1 { 0 } else { sublist_length(args_sl) }
        // A wrong count is reported where the bound is written.
        let arity_ok = got == (tc_trait_tparam_count_idx.get(trait_name) ?? -1)
        if tr != -1 && arity_ok && !node_source_module(tr).starts_with("std_") {
            let want = tc_bound_args_at_call(outer_sl, own_sl, args_sl, binds)
            if want.len() == got {
                let held = tc_impl_trait_args_held(concrete, trait_name)
                if held.verdict == 1 && tc_impl_args_held_has(held, want) == 0 {
                    return UnmetBound { trait_name: trait_name, want: want, held: held }
                }
            }
        }
        i = i + 1
    }
    none
}

// Whether a type is fixed enough to judge an impl against: no unsolved metavariable and no
// type parameter anywhere in it.
fn tc_tid_is_judgeable(tid: Int) -> Int {
    if tc_tid_is_concrete(tid) == 0 { return 0 }
    if tc_tid_has_unbound_metavar(tid) != 0 || tc_tid_has_bare_typevar(tid) != 0 { return 0 }
    1
}

// A bound's trait arguments as types at this call, or a shorter list when one is not judgeable
// here. They are read under the binders of the declaration that writes the bound (a method's
// own, and its impl's), so `V` is that declaration's V, then the call's types replace them.
@allow(UnrestoredMutation)
fn tc_bound_args_at_call(outer_sl: Int, own_sl: Int, args_sl: Int, binds: Map[Str, Int]) -> List[Int] ! TypeCheck.Resolve, Diag.Report {
    let mut out: List[Int] = []
    if args_sl == -1 { return out }
    tc_push_tparam_scope(outer_sl)
    tc_push_tparam_scope(own_sl)
    let saved_suppress = tc_suppress_ann_validation
    tc_suppress_ann_validation = 1
    let mut i = 0
    while i < sublist_length(args_sl) {
        let t = tc_resolve(substitute_typevar_tid(resolve_type_ann(sublist_get(args_sl, i)), binds))
        if tc_tid_is_judgeable(t) == 0 { break }
        out.push(t)
        i = i + 1
    }
    tc_suppress_ann_validation = saved_suppress
    tc_pop_tparam_scope(own_sl)
    tc_pop_tparam_scope(outer_sl)
    out
}

// The trait arguments of each of the `impls` impls of a trait that apply to a type, one
// impl's after another in `args`. `verdict` is 1 when each impl could be judged, 0 when some
// impl could not (a receiver its binders do not pin), so the caller does not report.
type ImplArgsHeld {
    verdict: Int
    impls: Int
    args: List[Int]
}

fn tc_impl_trait_args_held(recv: Int, trait_name: Str) -> ImplArgsHeld ! TypeCheck.Resolve, Diag.Report {
    let mut args: List[Int] = []
    let mut verdict = 1
    let mut impls = 0
    for im in tc_impl_recv_tids.keys() {
        if tc_impl_trait_id(im) != trait_name { continue }
        let binders = node_impl_binders(im)
        let poly = binders != -1 && sublist_length(binders) > 0
        let raw_recv = tc_impl_recv_tids.get(im) ?? -1
        if tc_tid_kind(raw_recv) == TyKind.Typevar {
            verdict = 0
            continue
        }
        if poly && tc_impl_matches_instance(im, recv) == 0 { continue }
        let binds: Map[Str, Int] = if poly { tc_impl_binds_for_instance(im, recv) } else { Map() }
        let at = tc_resolve(substitute_typevar_tid(raw_recv, binds))
        // A receiver of another kind (`List[T]` against a struct) cannot apply, pinned or not.
        if tc_tid_kind(at) != tc_tid_kind(recv) { continue }
        if tc_tid_has_bare_typevar(at) != 0 {
            verdict = 0
            continue
        }
        if !tc_tid_same_type(at, recv) { continue }
        if poly && tc_impl_where_bounds_hold(im, binds) == -1 { continue }
        let mut heads: List[Int] = []
        for t in tc_impl_trait_arg_tids(im) {
            let ta = tc_resolve(substitute_typevar_tid(t, binds))
            if tc_tid_has_bare_typevar(ta) != 0 { verdict = 0 }
            heads.push(ta)
        }
        for t in heads { args.push(t) }
        impls = impls + 1
    }
    ImplArgsHeld { verdict: verdict, impls: impls, args: args }
}

// Whether one of the impls in `held` has exactly the trait arguments `want`.
fn tc_impl_args_held_has(held: ImplArgsHeld, want: List[Int]) -> Int {
    let n = want.len()
    let mut s = 0
    let mut j = 0
    while j < held.impls {
        let mut k = 0
        while k < n && tc_tid_same_type(held.args.get(s + k) ?? -1, want.get(k).unwrap()) { k = k + 1 }
        if k == n { return 1 }
        s = s + n
        j = j + 1
    }
    0
}

// A trait at arguments as a bound writes it: `Tr[Str]`, or `Tr` for none.
fn tc_trait_at_text(trait_name: Str, args: List[Int]) -> Str {
    if args.len() == 0 { return trait_name }
    let mut parts: List[Str] = []
    for t in args { parts.push(type_to_str(t)) }
    "{trait_name}[{parts.join(", ")}]"
}

// Each impl's head in `args` (`n` arguments per impl), as `Tr[Int]` or `Tr[Int] and Tr[Bool]`.
fn tc_trait_heads_text(trait_name: Str, args: List[Int], n: Int) -> Str {
    let mut heads: List[Str] = []
    let mut s = 0
    while n > 0 && s + n <= args.len() {
        heads.push(tc_trait_at_text(trait_name, args.slice(s, s + n)))
        s = s + n
    }
    heads.join(" and ")
}

// The metavars minted for `call_node`'s return-only type params, as a full-arity
// group (-1 where nothing was minted), minting them on first visit and returning the
// SAME ones on every later visit. See tc_ret_mint_start's declaration for why the
// per-node memo is required rather than merely nice.
//
// Each returned tid is passed through tc_resolve, so a caller reads the SOLUTION once
// something has bound α rather than the raw α slot. That matters concretely:
// tc_struct_slot_encodable does not resolve, and would judge a bound α unencodable and
// silently drop the slot back to the erasing string path.
// Group layout in tc_ret_mint_tids: [arity, slot_0, …, slot_{arity-1}], so the group
// is SELF-DESCRIBING and a reader that disagrees about the fn's arity refuses instead
// of indexing into the next call's group. That is not hypothetical: this memo is
// written from the sig (fs.type_params_count) and read back by
// tc_mono_tids_core from the AST (sublist_length(node_type_params(fn_node))), and
// lookup_fnsig keys on a name — two fns of the same name with different arities would
// otherwise silently share a slot and mint one fn's α into the other's mono name.
fn tc_ret_only_metavars(sig: Int, call_node: Int) -> List[Int] {
    let fs = fnsig_pool.get(sig).unwrap()
    let n = fs.type_params_count
    let mut out: List[Int] = []
    if n == 0 { return out }
    if call_node < 0 || call_node >= tc_ret_mint_start.len() { return out }

    let existing = tc_ret_mint_start.get(call_node).unwrap()
    if existing >= 0 {
        let mut i = 0
        while i < n {
            out.push(tc_resolve(tc_ret_mint_at(call_node, n, i)))
            i = i + 1
        }
        return out
    }

    let start = tc_ret_mint_tids.len()
    tc_ret_mint_tids.push(n)
    let mut minted = 0
    let mut pi = 0
    while pi < n {
        let ro_idx = fs.type_params_start + pi
        let mut tid = -1
        if ro_idx < fnsig_tparam_ret_only.len() {
            if fnsig_tparam_ret_only.get(ro_idx).unwrap() != 0 {
                tid = make_metavar()
                minted = minted + 1
            }
        }
        tc_ret_mint_tids.push(tid)
        out.push(tid)
        pi = pi + 1
    }
    // Record the group only when it holds at least one α. Every non-return-only
    // generic call would otherwise burn an all -1 group per call node for nothing, and
    // leaving the start at -1 keeps that overwhelmingly common path a single list read.
    if minted == 0 {
        let mut trim = 0
        while trim <= n {
            let _ = tc_ret_mint_tids.pop()
            trim = trim + 1
        }
        return out
    }
    tc_ret_mint_start.set(call_node, start)
    out
}

// The metavar minted for slot `pi` of `call_node`'s return-only group, RESOLVED, or -1
// when this call minted nothing, minted nothing for that slot, or the caller's arity
// disagrees with the recorded group. The mono-lowering consumers read through here so
// each one is a single guarded lookup with no arithmetic of its own.
pub fn tc_ret_mint_at(call_node: Int, arity: Int, pi: Int) -> Int {
    if call_node < 0 || call_node >= tc_ret_mint_start.len() { return -1 }
    let start = tc_ret_mint_start.get(call_node).unwrap()
    if start < 0 || start >= tc_ret_mint_tids.len() { return -1 }
    if tc_ret_mint_tids.get(start).unwrap() != arity { return -1 }
    if pi < 0 || pi >= arity { return -1 }
    let slot = start + 1 + pi
    if slot >= tc_ret_mint_tids.len() { return -1 }
    let tid = tc_ret_mint_tids.get(slot).unwrap()
    if tid < 0 { return -1 }
    tc_resolve(tid)
}

// Did THIS node mint return-only metavars? A struct-literal field reads it to tell a
// generic call's under-determination from a literal's own field metavars.
fn tc_node_has_ret_mint(n: Int) -> Int {
    if n < 0 || n >= tc_ret_mint_start.len() { return 0 }
    if tc_ret_mint_start.get(n).unwrap() < 0 { return 0 }
    1
}

// A generic call's return type, with its type params substituted from the call's
// arguments — and, for a RETURN-ONLY type param, from a freshly minted metavariable.
//
// The mint is the whole point. build_typevar_binds infers exclusively from ARGUMENT
// types, so `fn mk[T]() -> RGT[T]` called as `mk()` gets empty binds,
// substitute_typevar_tid's TyKind.Typevar arm returns `T` unchanged, and the return type
// carries a BARE TYPEVAR. A bare typevar is invisible to every part of the metavar
// machinery — tc_is_unbound_metavar counts only TyKind.Unknown with inner1 < 0, and
// tc_unify's typevar arm returns 1 without binding — so typecheck passes clean, no
// E0301 fires, and codegen erases the slot to "Void" at the emit_struct_lit
// chokepoint (a loud I0001) or to a wrong mono name. Substituting α instead puts the
// slot into the ONE representation the existing constraint machinery can already
// solve: the let-target pin (tc_pin_tail_ret_generic), the argument-position unify
// (check_arg_value), and the declared-return compare (tc_check_returned_value) each
// bind α with no new inference code, and a genuinely unconstrained α is reported as
// E0301 at its binding boundary instead of reaching codegen.
//
// Minting HERE and not in build_typevar_binds: that function runs more than once per
// call site (bounds, return type, pin), so it would produce unrelated α for one slot and
// only one of them could ever be bound. `self_offset` as in build_typevar_binds.
fn instantiate_return_type(sig: Int, arg_tids: List[Int], call_node: Int, self_offset: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let fs = fnsig_pool.get(sig).unwrap()
    let ret = fs.ret
    if ret < 0 || ret >= ty_pool.len() { return ret }
    tc_report_unsourced_binders(sig, call_node, self_offset)
    let mut binds = build_typevar_binds(sig, arg_tids, self_offset)
    let mints = tc_ret_only_metavars(sig, call_node)
    let mut pi = 0
    while pi < mints.len() {
        let a = mints.get(pi).unwrap()
        if a >= 0 {
            let nidx = fs.type_params_start + pi
            if nidx < fnsig_type_param_names.len() {
                let tpn = fnsig_type_param_names.get(nidx).unwrap()
                // An argument bind wins: a param annotation naming the tparam means it
                // is not return-only and no α was minted for it, so this can only be a
                // belt-and-braces guard against a future producer inserting both.
                if binds.contains_key(tpn) == 0 {
                    binds.insert(tpn, a)
                    if nidx < fnsig_tparam_nodes.len() {
                        let tpnode = fnsig_tparam_nodes.get(nidx).unwrap()
                        binds.insert(tc_binder_key(tpnode, tpn), a)
                    }
                }
            }
        }
        pi = pi + 1
    }
    tc_note_generic_call(sig, call_node, self_offset, binds)
    substitute_typevar_tid(ret, binds)
}

// Pin a generic call's metavar-carrying arguments from the resolved typevar binds.
// For `fill[K,V](m: Map[K,V], …)` called `fill(Map(), 256, "x")`, the
// binds recovered from the sibling args are K→Int, V→Str; substituting them into
// the param type `Map[K,V]` gives `Map[Int,Str]`, and unifying that against the
// `Map()` arg's `Map[α_k,α_v]` pins α_k=Int, α_v=Str — so codegen emits the right
// kops instead of the erased str default. If a typevar is genuinely unbound (no arg
// supplies it), substitution leaves it a typevar, unify leaves the arg's α unbound,
// and E0301 fires at the arg's own binding boundary. Runs only for metavar-carrying
// args — concrete args and the no-generic path are untouched.
fn tc_pin_generic_args_from_binds(sig: Int, args_sl: Int, arg_tids: List[Int], self_offset: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if args_sl == -1 { return }
    let fs = fnsig_pool.get(sig).unwrap()
    let param_start = fs.params_start
    let param_count = fs.params_count
    let binds = build_typevar_binds(sig, arg_tids, self_offset)
    let tids = tc_seed_closure_args_with_binds(sig, args_sl, arg_tids, self_offset, binds)
    let mut i = 0
    while i < tids.len() {
        let pidx = i + self_offset
        let arg_t = tids.get(i).unwrap()
        if pidx < param_count && arg_t >= 0 && tc_tid_has_unbound_metavar(arg_t) != 0 {
            let ptid = fnsig_param_list.get(param_start + pidx).unwrap()
            let concrete_ptid = substitute_typevar_tid(ptid, binds)
            let _ = tc_unify(concrete_ptid, arg_t)
        }
        i = i + 1
    }
}

// Seed every closure argument a second time, from the formal the call's own type-parameter
// binds have made concrete.
//
// The first seed happens argument by argument while the call is read, so a closure written
// before the argument that binds T sees a formal that still names T. A bare type variable
// cannot be solved later, so that position is left open, and the position stays open because
// nothing afterwards revisits it: the closure's body walk reads the stamp on the closure node
// and by then the stamp is the one the first seed left. Which side of the call the closure was
// written on then decided whether its parameter had a type — the spec asks for Hindley-Milner
// with information flowing both ways (sections/03_types.md 3.3) and fixes no order on
// arguments, so both orders owe the same answer.
//
// Runs after the whole argument list has been read and before the body walk, which is the one
// window where the binds are complete and the stamp is still the thing the walk will read. A
// type parameter no argument binds substitutes to itself, so the position stays open and its
// parameter is still reported as under-determined.
// Answers the argument tids with every seeded argument read again, since its closure's
// type is now the seeded one.
fn tc_seed_closure_args_with_binds(sig: Int, args_sl: Int, arg_tids: List[Int], self_offset: Int, binds: Map[Str, Int]) -> List[Int] ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let mut tids = arg_tids
    if args_sl == -1 { return tids }
    let fs = fnsig_pool.get(sig).unwrap()
    let param_start = fs.params_start
    let param_count = fs.params_count
    let n = sublist_length(args_sl)
    let mut i = 0
    while i < n && i < tids.len() {
        let pidx = i + self_offset
        if pidx < param_count {
            let arg = sublist_get(args_sl, i)
            let formal = substitute_typevar_tid(fnsig_param_list.get(param_start + pidx).unwrap(), binds)
            tc_seed_expected_into_value(arg, formal)
            if tc_formal_reaches_closure(formal) != 0 { tids.set(i, infer_type(arg)) }
        }
        i = i + 1
    }
    tids
}

// Whether tc_seed_expected_into_value can reach a closure under this formal: a function
// type, or a List whose elements can. Only those arguments change type when seeded, and
// reading any other again would mint fresh metavariables the call's binds never see.
fn tc_formal_reaches_closure(formal: Int) -> Int {
    let r = tc_tid_resolved(formal)
    if r < 0 || r >= ty_pool.len() { return 0 }
    let t = ty_pool.get(r).unwrap()
    if t.kind == TyKind.Fn { return 1 }
    if t.kind == TyKind.List && t.inner1 >= 0 { return tc_formal_reaches_closure(t.inner1) }
    0
}

// A function's declared return type is an expected-type source
// (sections/03_types.md:1031), so a generic-struct/enum literal — or a Map/Set
// construction — in return position must monomorphize against it.
// `fn a() -> GKV[Int, Str] { GKV { m: Map() } }` got no such constraint:
// tc_struct_lit_instance_tid mints `GKV[?a, ?b]` from the `Map()` field's own
// unbound metavars, nobody unified it against the declared `GKV[Int, Str]`, and
// codegen reached the struct-lit mono chokepoint with two unsolved params — I0001.
// `fn mkmap() -> Map[Int, Str] { Map() }` has the identical shape one
// level up: the bare `Map()` ctor mints `Map[?a, ?b]` and nothing pins it either —
// but there is no struct-lit mono chokepoint to catch it, so it silently reaches
// codegen's string kops default instead of an ICE.
//
// The pin is an IN-PLACE tc_unify, not a hint seed. That distinction is the whole
// fix: the metavar integers in the instance's arg list are the SAME integers the
// field's `Map[?a, ?b]` holds, so binding a:=Int solves the mono NAME and the
// ctor's kops vtable from one constraint. Seeding tc_construct_hint instead would
// fix only the name and leave resolve_ctor_kops_elem on its string default —
// blink_kops_str for an Int key, trading a loud ICE for a silent hash collision.
//
// tc_pin_admits_declared is the gate; each branch is load-bearing:
//   TyKind.Map/TyKind.Set/     — the kinds whose params_count is never set
//   TyKind.Option/TyKind.Result   (make_*_type store inner1/inner2, not a
//                        ty_param_list), so they must admit unconditionally rather
//                        than fall into the params_count check below. Admitting the
//                        two carriers back-pins a tail-`None` / tail-`Ok`/`Err` whose
//                        other slot a declared return or annotation determines.
//   TyKind.List        — its element slot is inner1, as a Set's is, so `id([])` under
//                        a declared List[Int] pins the α its `[]` argument minted.
//   TyKind.Ptr         — the pointee is inner1 too, so a `null_ptr()` bound and then
//                        returned under a declared Ptr[Int] pins the α it minted.
//   TyKind.Tuple       — each slot is an expected type for the value in it, so
//                        `let t: (Map[Str, Str], Int) = pair(Map(), 1)` pins pair's A.
//   TyKind.Struct/TyKind.Enum  — excludes Handler returns.
//   params_count > 0   — a monomorphic struct has nothing to pin.
// The caller additionally requires an unbound metavar in the inferred value, which
// excludes a bare TyKind.Typevar, so a generic fn's `-> Box[T]` keeps its existing
// per-T monomorphization untouched.
//
// The unify result is deliberately discarded: callers invoke this only where
// types_compatible ALREADY agreed, so there is no new mismatch to report, and a
// partial unify degrades to exactly today's I0001 rather than to a wrong type.
//
// Each caller is a declared type meeting an under-determined value. Every expected-type
// position (a let, an assignment, an argument, a return, a struct field, a list element, a
// tuple slot, a variant payload) reaches it through tc_pin_declared_into_value; a struct
// field whose type still names the struct's own parameter (tc_bind_struct_lit_fields) and a
// field default (tc_stamp_field_default) call it direct. Every caller gates on its own
// "did this value mint here" pre-check before calling; the two gates below are the
// shared ones. The name says
// "tail ret" for its first caller; it is really "pin a declared generic type onto a
// metavar-carrying value", and every gate above reads the same either way. Not
// renamed on purpose — a rename of a compiler-internal helper costs a 3-step
// bootstrap and buys nothing a comment cannot say.
fn tc_pin_admits_declared(d: Int) -> Int {
    if d < 0 || d >= ty_pool.len() { return 0 }
    let dt = ty_pool.get(d).unwrap()
    if dt.kind == TyKind.Map || dt.kind == TyKind.Set { return 1 }
    // Option/Result carry their element slots on inner1/inner2 (like Map/Set), not a
    // ty_param_list, so a declared Result[Int,Str] / Option[Int] must pin an
    // under-determined tail-bound carrier the same way — the Struct/Enum params_count
    // path below never sees them.
    if dt.kind == TyKind.Option || dt.kind == TyKind.Result || dt.kind == TyKind.List || dt.kind == TyKind.Ptr { return 1 }
    if dt.kind == TyKind.Tuple { return 1 }
    if dt.kind != TyKind.Struct && dt.kind != TyKind.Enum { return 0 }
    if dt.params_count == 0 { return 0 }
    1
}

fn tc_pin_tail_ret_generic(declared_ret: Int, inferred_ret: Int) {
    let d = resolve_alias_tid(declared_ret)
    if tc_pin_admits_declared(d) == 0 { return }
    if tc_tid_has_unbound_metavar(inferred_ret) == 0 { return }
    // Every pin mutates ty_pool IN PLACE, so adding a caller can change emitted C for
    // programs that have nothing to do with the new seam. `retpin` makes that blast
    // radius auditable without a printf+recompile: one line per pin that actually
    // fired, past both gates above (and, upstream, past whatever mint pre-check its
    // caller applied). Gated on dbg_channel_on so the interpolation is not built when
    // tracing is off.
    if dbg_channel_on("retpin") != 0 {
        dbg_trace("retpin", "pin declared={type_to_str(d)} inferred={type_to_str(inferred_ret)}")
    }
    // The declared type is written in the body being checked, so a type parameter in it is
    // one this body's own instances substitute. Nothing else in typecheck may bind a
    // metavariable to a typevar, which is why the licence is held for this call alone.
    tc_pin_tparam_binds = 1
    let _ = tc_unify(d, inferred_ret)
    tc_pin_tparam_binds = 0
}

// The value node an if/match ARM BODY reduces to: a Block yields its tail value, a
// short-form arm's ExprStmt unwraps to its value, anything else IS its own value.
// -1 when the body bears no tail value. This is the node the return-only mint is keyed
// on — instantiate_return_type records the mint on the arm-tail CALL, never on the
// enclosing if/match — so the pin gate must reach it to see the mint at all.
fn tc_arm_tail_value_node(body: Int) -> Int {
    if body < 0 { return -1 }
    let k = node_kind(body)
    if k == NodeKind.Block {
        let tail = tc_block_tail_stmt(body)
        if tail == -1 { return -1 }
        // A `return X` arm DIVERGES: its operand flows to the enclosing fn's return,
        // not to this if/match's declared let/assign target, so it must not be pinned
        // from that target. tc_block_tail_value would unwrap it to X; contribute no
        // value instead, exactly as a bare `return` (value -1) already does.
        if node_kind(tail) == NodeKind.Return { return -1 }
        return tc_block_tail_value(tail)
    }
    if k == NodeKind.ExprStmt { return node_value(body) }
    body
}

// Pin `declared_tid` into every tail `val` can produce: through a block's tail and into each
// if/match arm, as far down as the value goes. The declared type is the expected type of the
// whole value (sections/03_types.md 3.3), so a brace or a branch around a call must not change
// whether it fills the call's binders. Each tail pins on its own because the merged type of an
// if/match over a generic struct carries only one arm's metavar (type_merge keeps the first
// side), and the value itself pins too, since a merged type may hold a metavar no arm does.
// A let, an assignment, an argument, a return, a struct field, a variant payload or brace
// field, a `Some`/`Ok`/`Err` payload, a list element, a tuple slot and a `?`/`??` operand all
// pin through here, so a position cannot fill a binder another position leaves open.
fn tc_pin_declared_into_value(declared_tid: Int, val: Int, val_tid: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    tc_pin_tail_ret_generic(declared_tid, val_tid)
    let parts = tc_expected_parts(val, declared_tid)
    if parts.len() > 0 {
        for p in parts {
            tc_pin_declared_into_value(p.expected, p.value, tc_pin_tail_tid(p.value))
        }
        return
    }
    let k = node_kind(val)
    let d = resolve_alias_tid(tc_resolve(declared_tid))
    if tc_tid_is_no_info(d) != 0 { return }
    // `a?` is a match on `a` whose `Ok`/`Some` arm yields the value, so the expected type is
    // that slot of the operand's carrier. The error slot stays the operand's own.
    if k == NodeKind.UnaryOp && node_op(val) == "?" {
        let opnd = node_left(val)
        let ot = resolve_alias_tid(tc_resolve(tc_pin_tail_tid(opnd)))
        if tc_tid_kind(ot) == TyKind.Result {
            tc_pin_declared_into_value(make_result_type(d, tc_tid_child(ot, 1)), opnd, ot)
        } else if tc_tid_kind(ot) == TyKind.Option {
            tc_pin_declared_into_value(make_option_type(d), opnd, ot)
        }
        return
    }
    // A variant call's payloads are its fields, so each meets its field type at the instance
    // the whole value is expected to be.
    if k == NodeKind.Call || k == NodeKind.MethodCall {
        let var_idx = tc_variant_built_by_call(val, d)
        let args = node_args(val)
        if var_idx < 0 || args == -1 { return }
        let mut i = 0
        while i < sublist_length(args) {
            let p = tc_variant_payload(var_idx, args, i)
            if p.field != -1 {
                tc_pin_declared_into_value(tc_subst_evfield_from_instance(p.field, d), p.value, tc_pin_tail_tid(p.value))
            }
            i = i + 1
        }
        return
    }
    // A struct literal's and a brace variant's fields meet their types at the expected
    // instance, as payloads do. A spread's operand is a whole value of the struct itself.
    if k == NodeKind.StructLit {
        let var_idx = tc_variant_built_by_brace(val, val_tid, d)
        let flds = node_fields(val)
        if flds == -1 || (var_idx < 0 && !tc_struct_built_by_lit(val_tid, d)) { return }
        let mut i = 0
        while i < sublist_length(flds) {
            let f = sublist_get(flds, i)
            let fv = node_value(f)
            let ft = if node_kind(f) == NodeKind.SpreadExpr { d } else { tc_lit_field_tid_at(var_idx, node_name(f), d) }
            if ft != -1 && fv != -1 {
                tc_pin_declared_into_value(ft, fv, tc_pin_tail_tid(fv))
            }
            i = i + 1
        }
    }
}

// A value position inside a value, with the type expected there.
type ExpectedPart {
    value: Int
    expected: Int
}

// The positions of `val` that its own expected type reaches, each with the type expected
// there (sections/03_types.md *Expected type at a site*): each tail of a block, an if or a
// match; each element of a list or tuple literal; both arms of `??`; the payload of
// `Some`/`Ok`/`Err`. Read from the syntax alone, so the walk before inference
// (tc_seed_expected_into_value) and the walk after it (tc_pin_declared_into_value) descend
// the same positions. Empty when `val` has none.
fn tc_expected_parts(val: Int, expected: Int) -> List[ExpectedPart] {
    let mut parts: List[ExpectedPart] = []
    let k = node_kind(val)
    if k == NodeKind.Block {
        tc_push_tail_part(parts, val, expected)
        return parts
    }
    if k == NodeKind.IfExpr {
        // An `if` with no else branch is a statement and yields no value.
        if node_else_body(val) == -1 { return parts }
        tc_push_tail_part(parts, node_then_body(val), expected)
        tc_push_tail_part(parts, node_else_body(val), expected)
        return parts
    }
    if k == NodeKind.MatchExpr {
        let arms = node_arms(val)
        if arms == -1 { return parts }
        let mut i = 0
        while i < sublist_length(arms) {
            tc_push_tail_part(parts, node_body(sublist_get(arms, i)), expected)
            i = i + 1
        }
        return parts
    }
    let d = resolve_alias_tid(tc_resolve(expected))
    if tc_tid_is_no_info(d) != 0 { return parts }
    if k == NodeKind.TupleLit {
        let elems = node_elements(val)
        if elems == -1 || tc_tid_kind(d) != TyKind.Tuple || tc_tid_child_count(d) != sublist_length(elems) { return parts }
        let mut i = 0
        while i < sublist_length(elems) {
            parts.push(ExpectedPart { value: sublist_get(elems, i), expected: tc_tid_child(d, i) })
            i = i + 1
        }
        return parts
    }
    if k == NodeKind.ListLit {
        let elems = node_elements(val)
        if elems == -1 || tc_tid_kind(d) != TyKind.List { return parts }
        let et = tc_tid_child(d, 0)
        let mut i = 0
        while i < sublist_length(elems) {
            let e = sublist_get(elems, i)
            // A spread's operand is a whole list, so it meets the list type, not the element.
            if node_kind(e) == NodeKind.SpreadExpr {
                let src = node_value(e)
                if src != -1 { parts.push(ExpectedPart { value: src, expected: d }) }
            } else {
                parts.push(ExpectedPart { value: e, expected: et })
            }
            i = i + 1
        }
        return parts
    }
    // `a ?? b` is a match on `a` whose `Some` arm yields a's value and whose `None` arm is `b`
    // (sections/03_types.md 3.2), so each arm meets the expected type of the whole.
    if k == NodeKind.BinOp && node_op(val) == "??" {
        parts.push(ExpectedPart { value: node_left(val), expected: make_option_type(d) })
        parts.push(ExpectedPart { value: node_right(val), expected: d })
        return parts
    }
    // `Some(x)`, `Ok(x)` and `Err(x)` build the expected carrier, so x meets its slot.
    let slot = tc_carrier_slot_built_by_call(val, d)
    if slot >= 0 {
        parts.push(ExpectedPart { value: sublist_get(node_args(val), 0), expected: tc_tid_child(d, slot) })
    }
    parts
}

fn tc_push_tail_part(parts: List[ExpectedPart], body: Int, expected: Int) {
    let v = tc_arm_tail_value_node(body)
    if v >= 0 { parts.push(ExpectedPart { value: v, expected: expected }) }
}

// The type of field `name` read at instance `d`: of variant `var_idx` when the literal builds
// one, else of the struct `d`. -1 when there is no such field.
fn tc_lit_field_tid_at(var_idx: Int, name: Str, d: Int) -> Int {
    if var_idx < 0 { return tc_field_tid_at_instance(d, name) }
    let field = lookup_evfield_type_by_name(var_idx, name)
    if field == -1 { return -1 }
    tc_subst_evfield_from_instance(field, d)
}

// Whether a struct literal typed `lit_tid` builds struct type `d` with field types that can be
// read at `d`. A generic struct's bare head leaves the struct's own type parameters in each
// field type, as tc_variant_fields_typed_at says of an enum.
fn tc_struct_built_by_lit(lit_tid: Int, d: Int) -> Bool {
    if tc_tid_kind(d) != TyKind.Struct { return false }
    let lt = resolve_alias_tid(tc_resolve(lit_tid))
    if tc_tid_kind(lt) != TyKind.Struct || tc_struct_base_tid(lt) != tc_struct_base_tid(d) { return false }
    let decl = tc_tid_decl_node(d)
    let tparams = if decl >= 0 { node_type_params(decl) } else { -1 }
    tparams == -1 || sublist_length(tparams) == 0 || ty_pool.get(d).unwrap().params_count > 0
}

// The variant of enum type `d` that call `call` constructs, or -1 when it constructs none of
// them.
fn tc_variant_built_by_call(call: Int, d: Int) -> Int {
    if tc_tid_kind(d) != TyKind.Enum { return -1 }
    let vdecl = tc_call_decl_node(call)
    if vdecl < 0 || node_kind(vdecl) != NodeKind.TypeVariant { return -1 }
    let var_idx = get_variant_by_name(tc_enum_base_tid(d), node_name(vdecl))
    if var_idx < 0 || tc_variant_decl_node(var_idx) != vdecl || !tc_variant_fields_typed_at(var_idx, d) { return -1 }
    var_idx
}

// The variant of enum type `d` that brace literal `lit`, typed `lit_tid`, constructs, or -1
// when it constructs none of them. The literal's own type names the enum it resolved to, so
// its last name segment is the variant.
fn tc_variant_built_by_brace(lit: Int, lit_tid: Int, d: Int) -> Int {
    if tc_tid_kind(d) != TyKind.Enum { return -1 }
    let lt = resolve_alias_tid(tc_resolve(lit_tid))
    if tc_tid_kind(lt) != TyKind.Enum || tc_enum_base_tid(lt) != tc_enum_base_tid(d) { return -1 }
    let sname = node_type_name(lit)
    let mut vname = sname
    while vname.byte_index_of(".", 0).is_some() {
        vname = vname.byte_slice((vname.byte_index_of(".", 0) ?? 0) + 1, vname.byte_len())
    }
    let var_idx = get_variant_by_name(tc_enum_base_tid(d), vname)
    if var_idx < 0 || !tc_variant_fields_typed_at(var_idx, d) { return -1 }
    var_idx
}

// Whether variant `var_idx`'s field types can be read at enum type `d`. A generic enum's bare
// head leaves the enum's own type parameters in each field type, and those are not the checked
// body's to bind.
fn tc_variant_fields_typed_at(var_idx: Int, d: Int) -> Bool {
    let edecl = evar_pool.get(var_idx).unwrap().enum_decl
    let tparams = if edecl >= 0 { node_type_params(edecl) } else { -1 }
    tparams == -1 || sublist_length(tparams) == 0 || ty_pool.get(d).unwrap().params_count > 0
}

// The slot of carrier `d` that a `Some(x)`, `Ok(x)` or `Err(x)` call fills, bare or qualified
// (`Option.Some(x)`), or -1 when `call` is not one. A user variant spelled like a carrier
// reaches its declaration instead.
fn tc_carrier_slot_built_by_call(call: Int, d: Int) -> Int {
    let k = node_kind(call)
    if k != NodeKind.Call && k != NodeKind.MethodCall { return -1 }
    let args = node_args(call)
    if args == -1 || sublist_length(args) != 1 { return -1 }
    if node_kind(sublist_get(args, 0)) == NodeKind.NamedArg { return -1 }
    let mut name = ""
    if k == NodeKind.MethodCall {
        // Mirrors the MethodCall arm of infer_type_uncached: a qualifier that is a value is not
        // the carrier's type.
        let obj = node_obj(call)
        if obj == -1 || node_kind(obj) != NodeKind.Ident || tc_tid_is_no_info(nr_get_type(node_name(obj))) == 0 { return -1 }
        if tc_qualified_carrier(node_name(obj), node_method(call)).is_none() { return -1 }
        name = node_method(call)
    } else {
        let callee = node_left(call)
        if callee == -1 || node_kind(callee) != NodeKind.Ident || tc_call_decl_node(call) >= 0 { return -1 }
        name = node_name(callee)
    }
    let carrier = tc_prelude_carrier_of(name) ?? TyKind.Unknown
    if carrier == TyKind.Unknown || carrier != tc_tid_kind(d) { return -1 }
    if name == "Err" { 1 } else { 0 }
}

// The tid the checked walk recorded for a tail inside a value. A fresh infer_type would mint
// new metavars for an open argument, and pinning those leaves the recorded ones open.
fn tc_pin_tail_tid(node: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let t = tc_lookup_node_tid(node)
    if t >= 0 { return t }
    infer_type(node)
}

// The declared-return check for one returned value, shared by NodeKind.Return and by
// the implicit tail of a fn body. Two spellings of one program must give
// one answer, and the only way to guarantee that is one implementation.
//
// Every guard here is byte-identical to the Return arm's, deliberately:
//   • the tc_current_fn_ret Void/Unknown skip — a fn with no declared return has
//     nothing to compare against, and when tc_check_fn's `lookup_fnsig` misses it
//     never installs one at all, leaving tc_current_fn_ret at -1 (tc_check_fn is
//     called only from two non-reentrant top-level loops, so prev_fn_ret is always
//     -1 at entry). -1 stays vacuous through types_compatible's `a < 0` escape,
//     exactly as today. Do not "tighten" this with a >= 0 test: the Return arm has
//     always called through with -1 and must keep doing so. (The tail call site
//     does add >= 0, for an unrelated reason — see it.)
//     That miss is not hypothetical: EVERY impl method takes it, because the
//     register site keys the sig through tc_mangle_impl_fnsig while the check site
//     re-derives a different key. So neither this compare nor the pin has ever run
//     for a method — tracked as its own defect with pinned rows in
//     tests/test_implicit_tail_ret_compare.bl. Fixing the key turns both on
//     for methods at once; expect new diagnostics, not none.
//   • the val_t Unknown skip — an unbound metavar defers to the E0301 region
//     boundary check rather than double-reporting as a mismatch here.
//   • the pin only in the compatible branch — types_compatible is permissive toward
//     an unbound metavar, so this IS the branch an under-determined tail takes, and
//     placing the pin here means it can never turn a reported mismatch into a silent
//     success.
//   • the closure depth is 0 — tc_current_fn_ret DOES name the closure's own
//     declared return inside a closure body (installed by
//     tc_check_closure_body_against_own_ret, never the enclosing fn's), so the
//     compare above is no longer misreporting there. The gate stays anyway:
//     tc_pin_tail_ret_generic MUTATES ty_pool in place, and its own comment warns
//     that adding a caller can change emitted C for unrelated programs. Nothing
//     forces widening it — an under-determined closure tail declines into a loud
//     stop, never a silent miscompile — and doing so would newly touch live rows
//     in tests/test_generic_return_tail_infer.bl and
//     tests/test_fold_struct_accumulator.bl that no test asks for.
// Does this block end by transferring control out of itself? §3.3 calls such a block
// diverging, which is what makes its type the bottom type rather than the type of the
// operand its `return` carries away.
fn tc_block_exits(block: Int) -> Int {
    let stmts_sl = node_stmts(block)
    if stmts_sl == -1 { return 0 }
    if sublist_length(stmts_sl) == 0 { return 0 }
    let k = node_kind(sublist_get(stmts_sl, sublist_length(stmts_sl) - 1))
    if k == NodeKind.Return || k == NodeKind.Break || k == NodeKind.Continue { return 1 }
    0
}

// The error[MissingReturn] tail kind for a fn tail that yields `()`, or "" when the
// tail is not one of the shapes the body-completeness rule owns (§3.3). The kind is
// DATA on one code, never a per-kind family of codes — Minimalism's binding constraint
// in decisions/loop-tail-fallthrough.md.
//
// An else-less `if` never reaches here: it is a value-position `if` first, so
// error[MissingElse] (E0304) reports it during inference and names the better repair.
fn tc_missing_return_tail_kind(tail_val: Int, tail_t: Int) -> Str {
    if tail_t != TYPE_VOID { return "" }
    if tail_val < 0 { return "" }
    let k = node_kind(tail_val)
    // A `with` block or a bare block is a wrapper, not a tail shape of its own: the arm
    // or loop that yielded `()` is the one inside, and it names the repair.
    if k == NodeKind.WithBlock { return tc_missing_return_tail_kind(node_body(tail_val), tail_t) }
    if k == NodeKind.Block {
        let inner = tc_block_tail_stmt(tail_val)
        if inner == -1 { return "" }
        return tc_missing_return_tail_kind(tc_block_tail_value(inner), tail_t)
    }
    if k == NodeKind.ExprStmt { return tc_missing_return_tail_kind(node_value(tail_val), tail_t) }
    // An explicit `return <form>` names the same repair as the same form standing as the
    // tail. The kind is a property of the form that yielded `()`, not of the keyword.
    if k == NodeKind.Return { return tc_missing_return_tail_kind(node_value(tail_val), tail_t) }
    if k == NodeKind.WhileLoop { return "while" }
    if k == NodeKind.ForIn { return "for" }
    if k == NodeKind.LoopExpr { return "loop" }
    if k == NodeKind.MatchExpr { return "arm" }
    if k == NodeKind.IfExpr { return "arm" }
    ""
}

// Why this tail can complete, in the words of the construct the user wrote. The
// headline has to name the cause, not just the types (§3.3) — "expected Int, found ()"
// points at a `()` the user never wrote.
fn tc_missing_return_cause(kind: Str) -> Str {
    if kind == "while" { return "its tail `while` loop can finish, because the condition may be false on entry" }
    if kind == "for" { return "its tail `for` loop can finish, because the iterable may be empty or exhaust" }
    if kind == "loop" { return "a `break` targets its tail `loop`, so the loop can finish" }
    if kind == "end" { return "its body reaches its end with no tail expression" }
    "an arm of its tail completes without producing a value"
}

fn tc_report_missing_return(kind: Str, at_node: Int) ! Diag.Report {
    tc_report_missing_return_of(kind, tc_current_fn_name, tc_current_fn_ret, at_node)
}

fn tc_report_missing_return_of(kind: Str, owner_name: Str, ret: Int, at_node: Int) ! Diag.Report {
    let r = type_to_str(ret)
    // Both repairs must compile as written (§3.1). Naming the Option wrap for a fn that
    // ALREADY returns an Option would spell Option[Option[T]], which compiles but is not
    // the repair anyone wants — such a fn only needs the trailing None.
    let mut fix = "add a trailing `return <value>` (or a tail value expression), or change the return type to Option[{r}] and yield None"
    if type_kind(ret) == TyKind.Option {
        fix = "add a trailing `return <value>` (or a tail value expression), or yield None"
    }
    // No value of type Never exists, so only a diverging tail repairs the body (§3.3). A
    // program's own `panic` shadows the builtin and need not diverge, so it is not named then.
    if tc_resolve(ret) == TYPE_NEVER {
        fix = if lookup_fnsig("panic") == -1 { "end the body with a call that diverges: `panic(\"...\")` or a call to a function declared `-> Never`" } else { "end the body with a call to a function declared `-> Never`" }
    }
    diag_error_at_notes("MissingReturn", MISSING_RETURN, "function `{owner_name}` can finish without returning a value of type {r}: {tc_missing_return_cause(kind)}", at_node, fix, ["tail-kind: {kind}"])
}

fn tc_check_returned_value(val_t: Int, at_node: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if tc_current_fn_ret == TYPE_VOID || tc_tid_is_no_info(tc_current_fn_ret) != 0 { return }
    if tc_tid_is_no_info(val_t) != 0 { return }
    if types_compatible(tc_current_fn_ret, val_t) == 0 || tc_value_misses_never_slot(tc_current_fn_ret, val_t) != 0 {
        // §3.3 body completeness: the tail type must be a subtype of R, and `()` is a
        // subtype only of `()`. When the tail is a loop or an arm-bearing form that can
        // complete, the SHAPE is what names the repair, so it reports as
        // error[MissingReturn] instead of as a bare type mismatch. An explicit `return x`
        // arrives with a Return node here and keeps the mismatch wording.
        let mr_kind = tc_missing_return_tail_kind(at_node, val_t)
        if mr_kind != "" {
            tc_report_missing_return(mr_kind, at_node)
        } else {
            if !tc_closure_checked_against(at_node, tc_current_fn_ret) { tc_value_mismatch_at("return value type {type_to_str(val_t)} does not match function `{tc_current_fn_name}` return type {type_to_str(tc_current_fn_ret)}{tc_fn_mismatch_suffix(tc_current_fn_ret, val_t)}", at_node, at_node, tc_current_fn_ret) }
        }
    } else {
        // A `return`-wrapped value carries the returned node one level down; an
        // implicit tail passes the value node itself.
        let vnode = if node_kind(at_node) == NodeKind.Return { node_value(at_node) } else { at_node }
        if vnode >= 0 {
            tc_pin_declared_into_value(tc_current_fn_ret, vnode, val_t)
        } else {
            tc_pin_tail_ret_generic(tc_current_fn_ret, val_t)
        }
    }
}

// Parse an all-digits field name ("0", "12") to its Int index, or -1 for any
// non-numeric name (so struct field accesses never match the tuple path).
fn str_to_tuple_index(name: Str) -> Int {
    if name.len() == 0 { return -1 }
    // A tuple element is written `.0`, `.1`, ... — zero-indexed numeric fields
    // only (spec §3, sections/03_types.md:3292). The underscore-prefixed `._0`
    // form is NOT an accessor; it is the generated-C struct member name (C
    // identifiers cannot start with a digit) and must not leak into surface
    // syntax, so a leading underscore makes this not-a-tuple-index (-1) and the
    // access falls through to NoSuchField like any unknown field.
    let mut i = 0
    let mut acc = 0
    while i < name.byte_len() {
        let ch = name.byte_at(i).to_int()
        if ch < 48 || ch > 57 { return -1 }
        acc = acc * 10 + (ch - 48)
        i = i + 1
    }
    acc
}

// sections/03b_contracts.md:424. A `Template[C]` parameter accepts an
// interpolated string LITERAL at the call site and nothing else. The compiler decomposes the
// literal into parts and values instead of concatenating it — codegen does exactly that at
// codegen_methods.bl:3148, keyed on this same node kind — while a pre-built `Str` VARIABLE is
// opaque and must be rejected (:465), because accepting it is how tainted data would be
// laundered past parameterization. Every string literal parses as InterpString whether or not
// it interpolates (parser.bl:3413), so this is one kind, not two.
//
// This is the same shape as is_int_literal_node below and it lives in the same place for the
// same reason: it is a coercion at an ARGUMENT POSITION granted to a literal, not a statement
// that `Str` and `Template[C]` are compatible types. types_compatible must keep answering 0
// for them, which is what makes the variable case an error.
fn tc_template_arg_ok(ptid: Int, arg_node: Int) -> Int {
    if type_kind(resolve_alias_tid(ptid)) != TyKind.Template { return 0 }
    if node_kind(arg_node) == NodeKind.InterpString { return 1 }
    0
}

// The laundering case, and the reason it is its own predicate rather than folded into the
// mismatch: `Str` -> `Template[C]` is the one rejection the spec writes out in full
// (sections/03b_contracts.md:470, E0310, with the hint naming the literal and Raw()), because
// it is the mistake the feature exists to catch. A Template-to-Template mismatch is an
// ordinary type error about the phantom context and keeps the generic wording.
fn tc_template_launders_str(ptid: Int, arg_t: Int) -> Int {
    if type_kind(resolve_alias_tid(ptid)) != TyKind.Template { return 0 }
    if type_kind(resolve_alias_tid(arg_t)) == TyKind.Str { return 1 }
    0
}

fn is_int_literal_node(node: Int) -> Int {
    if node_kind(node) == NodeKind.IntLit { return 1 }
    if node_kind(node) == NodeKind.UnaryOp && node_op(node) == "-" {
        let operand = node_left(node)
        if operand != -1 && node_kind(operand) == NodeKind.IntLit { return 1 }
    }
    0
}

// An int literal accepted where an integer type is expected has that type at the literal
// (03_types.md §3.2 *Integer literal range*). Codegen reads the literal's own stamp, so the
// type is recorded on the node, not only accepted: a U64 operand stamped Int is held in a
// signed temp, and 2^63 reads back as the Int minimum.
//
// A literal out of the type's range still takes the type, and is E0318 here: the error stops
// the build before codegen, and a literal left Int would add a type mismatch after it.
fn tc_literal_takes(node: Int, tid: Int) ! Diag.Report {
    if node == -1 || is_int_literal_node(node) == 0 { return }
    let t = tc_resolve(resolve_alias_tid(tid))
    if is_integer_type(t) == 0 { return }
    if !tc_literal_fits(node, type_kind(t)) { tc_report_int_literal_range(node, t, false, "") }
    tc_publish_node_tid(node, t)
    if node_kind(node) == NodeKind.UnaryOp { tc_publish_node_tid(node_left(node), t) }
}

// error[IntLiteralOutOfRange] (E0318) at `node`, a literal whose value is outside `t`, its
// type. `default_int` says no expected type reached it, so it is Int by default.
fn tc_report_int_literal_range(node: Int, t: Int, default_int: Bool, help: Str) ! Diag.Report {
    let negative = node_kind(node) == NodeKind.UnaryOp
    tc_report_int_value_range(node, node_col(node), int_lit_node_digits(node), negative, t, default_int, help)
}

// The E0318 report for a value spelled `digits` (no sign), negative when `negative`, at
// column `col` of the node's line. A value is reported once: the passes that check a
// literal reach it more than once.
fn tc_report_int_value_range(node: Int, col: Int, digits: Str, negative: Bool, t: Int, default_int: Bool, help: Str) ! Diag.Report {
    if diag_has_error_at(INT_LITERAL_OUT_OF_RANGE, node, col) { return }
    let k = type_kind(t)
    let value = if negative { "-{digits}" } else { digits }
    let name = "IntLiteralOutOfRange"
    let line = node_line(node)
    if !negative && !tc_digits_within(digits, tc_int_literal_limit(TyKind.U64, false)) {
        diag_error_span_at_notes(name, INT_LITERAL_OUT_OF_RANGE, "no integer type holds {value}", node, line, col, 0, "", [])
        return
    }
    if negative && tc_int_literal_limit(k, true) == "" {
        let msg = if digits == "0" { "-0 is a negative literal" } else { "{value} does not fit in {type_to_str(t)}" }
        diag_error_span_at_notes(name, INT_LITERAL_OUT_OF_RANGE, msg, node, line, col, 0, "", ["unsigned types hold no negative values"])
        return
    }
    if default_int {
        diag_error_span_at_notes(name, INT_LITERAL_OUT_OF_RANGE, "{value} does not fit in Int, the default type", node, line, col, 0, help, [])
        return
    }
    let low = tc_int_literal_limit(k, true)
    let lowest = if low == "" { "0" } else { "-{low}" }
    diag_error_span_at_notes(name, INT_LITERAL_OUT_OF_RANGE, "{value} does not fit in {type_to_str(t)} ({lowest} to {tc_int_literal_limit(k, false)})", node, line, col, 0, "", [])
}

// The type inference gives an int literal: the one the expected type at it published, or Int.
fn tc_int_literal_type(node: Int) -> Int {
    let t = tc_lookup_node_tid(node)
    if t >= 0 && is_integer_type(t) != 0 { return t }
    TYPE_INT
}

// An int literal operand beside an operand that is not one takes the other's integer type, on
// either side (sections/03_types.md *Operator operands*). The other operand's type is known
// only once it is inferred, so this runs after both operands are, and it overrides a type an
// expected type gave the literal before: in `let x: U64 = n + 1` with `n: Int`, the `1` is
// Int, and the let reports Int.
fn tc_literal_takes_operand(lit: Int, other: Int, other_t: Int) -> Bool ! Diag.Report {
    if is_int_literal_node(lit) == 0 || is_int_literal_node(other) != 0 { return false }
    if tc_tid_is_no_info(other_t) != 0 || is_integer_type(resolve_alias_tid(tc_resolve(other_t))) == 0 { return false }
    tc_literal_takes(lit, other_t)
    true
}

// The type a literal operand of `node` took from the other operand, or -1 when neither
// operand is a lone literal beside an integer.
fn tc_operand_literal_type(node: Int, lt: Int, rt: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if tc_literal_takes_operand(node_right(node), node_left(node), lt) { return lt }
    if tc_literal_takes_operand(node_left(node), node_right(node), rt) { return rt }
    -1
}

fn tc_literal_fits(node: Int, k: TyKind) -> Bool {
    tc_digits_within(int_lit_node_digits(node), tc_int_literal_limit(k, node_kind(node) == NodeKind.UnaryOp))
}

// Whether decimal `digits`, with no leading zeros, are at most `limit`. Nothing is within "".
fn tc_digits_within(digits: Str, limit: Str) -> Bool {
    if digits == "" || limit == "" { return false }
    digits.byte_len() < limit.byte_len() || (digits.byte_len() == limit.byte_len() && digits <= limit)
}

// The largest magnitude a literal of kind `k` may spell, or "" when none may: a negative
// literal under an unsigned type holds no value of it.
fn tc_int_literal_limit(k: TyKind, negative: Bool) -> Str {
    if negative {
        return match k {
            TyKind.I8 => "128"
            TyKind.I16 => "32768"
            TyKind.I32 => "2147483648"
            TyKind.Int => "9223372036854775808"
            _ => ""
        }
    }
    match k {
        TyKind.I8 => "127"
        TyKind.I16 => "32767"
        TyKind.I32 => "2147483647"
        TyKind.Int => "9223372036854775807"
        TyKind.U8 => "255"
        TyKind.U16 => "65535"
        TyKind.U32 => "4294967295"
        TyKind.U64 => "18446744073709551615"
        _ => ""
    }
}

// The decimal digits of an int literal node, a negative literal's without its sign, or ""
// when the node is no int literal.
pub fn int_lit_node_digits(node: Int) -> Str {
    if node == -1 || is_int_literal_node(node) == 0 { return "" }
    let lit = if node_kind(node) == NodeKind.UnaryOp { node_left(node) } else { node }
    let s = node_str_val(lit)
    int_lit_decimal(if s == "" { "{node_int_val(lit)}" } else { s })
}

// A literal's digits without leading zeros. The literal is a decimal value whatever its
// spelling, and C would read `010` as octal and reject `09`.
pub fn int_lit_decimal(spelled: Str) -> Str {
    let mut i = 0
    while i + 1 < spelled.byte_len() && spelled.byte_at(i) == 48 { i = i + 1 }
    spelled.byte_slice(i, spelled.byte_len())
}

// The parameter index a keyword argument names, or -1. Starts at self_offset so a method's
// implicit receiver slot cannot be named.
fn tc_fnsig_param_index_by_name(param_start: Int, param_count: Int, self_offset: Int, label: Str) -> Int {
    let mut k = self_offset
    while k < param_count {
        if (fnsig_param_names.get(param_start + k) ?? "") == label { return k }
        k = k + 1
    }
    -1
}

// The index of the first KEYWORD parameter — the first declared after `--` — or param_count
// when the signature declares none.
fn tc_fnsig_kw_start(param_start: Int, param_count: Int, self_offset: Int) -> Int {
    let mut k = self_offset
    while k < param_count {
        if (fnsig_param_kw.get(param_start + k) ?? 0) == 1 { return k }
        k = k + 1
    }
    param_count
}

// The parameter a label names, searched in the KEYWORD namespace only, or -1. A label
// resolves after `--` and nowhere else (sections/02_syntax.md 2.13).
fn tc_fnsig_kw_index_by_name(param_start: Int, param_count: Int, kw_start: Int, label: Str) -> Int {
    let mut k = kw_start
    while k < param_count {
        if (fnsig_param_names.get(param_start + k) ?? "") == label { return k }
        k = k + 1
    }
    -1
}

// The callee's keyword parameters, quoted and comma-joined, for a report that has to say
// which labels the signature does declare.
fn tc_fnsig_kw_names(param_start: Int, param_count: Int, kw_start: Int) -> Str {
    let mut out = ""
    let mut k = kw_start
    while k < param_count {
        let nm = fnsig_param_names.get(param_start + k) ?? ""
        if out == "" { out = "`{nm}`" } else { out = "{out}, `{nm}`" }
        k = k + 1
    }
    out
}

// Both keyword-argument rules of sections/02_syntax.md 2.13, over one call against one
// declared signature: a label resolves in the keyword-parameter namespace and nowhere else,
// and a keyword parameter is reached by its label and never by position.
//
// Returns 1 when it reported. A caller that also reports arity reads that: a call whose
// keyword shape is wrong has had its one mistake named, and "expects 3 argument(s), got 2"
// on top would name the same mistake twice under a code whose repair is a different edit.
//
// One report per call. The five codes divide the mistakes, not the arguments, and a call
// carrying two of them is one call to repair.
// The four per-node side-tables are presized to the node pool as it stood when checking
// started. A keyword argument filled from a default is minted during the walk, so they have
// to grow to reach it: the memo write in infer_type is guarded by the table's length, and a
// node past the end is skipped in silence. The boundary check then reports that node as one
// that reached the end of inference carrying no type.
fn tc_grow_node_tables() {
    while tc_node_tid.len() < node_count() {
        tc_node_tid.push(-1)
        tc_ret_mint_start.push(-1)
        tc_mc_obj_value_marks.push(0)
        tc_name_position_is_value.push(0)
        tc_sealed_ops_call_marks.push(0)
    }
}

fn tc_check_keyword_args(fn_name: Str, sig: Int, args_sl: Int, self_offset: Int, call_node: Int) -> Int ! Diag.Report {
    let fs = fnsig_pool.get(sig).unwrap()
    let param_start = fs.params_start
    let param_count = fs.params_count
    let kw_start = tc_fnsig_kw_start(param_start, param_count, self_offset)
    let mut argc = 0
    if args_sl != -1 { argc = sublist_length(args_sl) }

    // With no label in the call and no keyword parameter in the signature, no rule below can
    // fire. Most calls are that shape, and each would otherwise build a `seen` Map for nothing.
    if kw_start >= param_count && tc_args_have_label(args_sl, argc) == 0 { return 0 }

    let mut seen: Map[Str, Int] = Map()
    let mut first_label = -1
    let mut i = 0
    while i < argc {
        let arg = sublist_get(args_sl, i)
        if node_kind(arg) == NodeKind.NamedArg {
            if first_label == -1 { first_label = i }
            let label = node_name(arg)
            if tc_fnsig_kw_index_by_name(param_start, param_count, kw_start, label) == -1 {
                if tc_fnsig_param_index_by_name(param_start, kw_start, self_offset, label) != -1 {
                    diag_error_at("InvalidKeywordArg", INVALID_KEYWORD_ARG, "`{label}` is a positional parameter of `{fn_name}`", arg, "pass it without a label")
                } else {
                    let declared = tc_fnsig_kw_names(param_start, param_count, kw_start)
                    let mut hint = "`{fn_name}` declares no keyword parameters"
                    if declared != "" { hint = "the keyword parameters of `{fn_name}` are {declared}" }
                    diag_error_at("InvalidKeywordArg", INVALID_KEYWORD_ARG, "`{label}` names no keyword parameter of `{fn_name}`", arg, hint)
                }
                return 1
            }
            if (seen.get(label) ?? 0) == 1 {
                diag_error_at("DuplicateKeywordArg", DUPLICATE_KEYWORD_ARG, "`{label}` is given twice in this call to `{fn_name}`", arg, "delete the repeated argument")
                return 1
            }
            seen.insert(label, 1)
        }
        i = i + 1
    }

    if first_label != -1 {
        let mut j = first_label
        while j < argc {
            let arg = sublist_get(args_sl, j)
            if node_kind(arg) != NodeKind.NamedArg {
                diag_error_at("PositionalAfterKeyword", POSITIONAL_AFTER_KEYWORD, "positional argument after a labelled one in the call to `{fn_name}`", arg, "move it before the first label, or give it the label its parameter declares")
                return 1
            }
            j = j + 1
        }
    }

    let mut positional = 0
    let mut p = 0
    while p < argc {
        if node_kind(sublist_get(args_sl, p)) != NodeKind.NamedArg { positional = positional + 1 }
        p = p + 1
    }
    let declared_positional = kw_start - self_offset

    if positional > declared_positional && kw_start < param_count {
        let arg = sublist_get(args_sl, declared_positional)
        let nm = fnsig_param_names.get(param_start + kw_start) ?? ""
        let declared = tc_fnsig_kw_names(param_start, param_count, kw_start)
        diag_error_at("UnlabeledKeywordArg", UNLABELED_KEYWORD_ARG, "{declared} of `{fn_name}` are keyword parameters and take their arguments by label", arg, "label the argument already written: `{nm}: ...`")
        return 1
    }

    // Too few positional arguments is an arity mistake, and the caller's arity report names
    // it. Reporting the keyword parameters missing behind it would name the wrong one.
    if positional < declared_positional { return 0 }

    // A keyword parameter the call left out is either filled from the declaration's default
    // or missing. The fill appends the declaration's own expression node, shared by every
    // call that omits the argument, which is how a struct field default already reaches a
    // literal that does not name the field. `seen` is what makes a second pass over the same
    // program find the argument already there instead of appending it twice.
    //
    // The default was written in the callee's module and is checked there, at the
    // declaration, so the fill carries that module and the default's own position: a later
    // stage lowers it there, and a report about it names the default's file.
    let mut k = kw_start
    while k < param_count {
        let nm = fnsig_param_names.get(param_start + k) ?? ""
        if (seen.get(nm) ?? 0) == 0 {
            let dflt = fnsig_param_default.get(param_start + k) ?? -1
            if dflt == -1 || args_sl == -1 {
                diag_error_at("MissingKeywordArg", MISSING_KEYWORD_ARG, "keyword argument `{nm}` is missing from the call to `{fn_name}`", call_node, "add `{nm}: <value>`")
                return 1
            }
            let fill = synth_named_arg(nm, dflt, node_line(dflt), node_col(dflt))
            node_set_module(fill, tc_body_module(fs.decl))
            sublist_append(args_sl, fill)
            tc_grow_node_tables()
            seen.insert(nm, 1)
        }
        k = k + 1
    }
    0
}

// A keyword argument typecheck appended from a declaration's default. Its value was checked
// at the declaration, in the module the fill names, so nothing reads it again in the caller.
pub fn tc_is_default_fill(arg: Int) -> Bool {
    node_kind(arg) == NodeKind.NamedArg && node_module(arg) != ""
}

fn tc_args_have_label(args_sl: Int, argc: Int) -> Int {
    let mut i = 0
    while i < argc {
        if node_kind(sublist_get(args_sl, i)) == NodeKind.NamedArg { return 1 }
        i = i + 1
    }
    0
}

// Interpolation parts whose value is a `Raw[T]`. §3b.5 gives a Raw exactly one consumer —
// the `Template[C]` coercion at an argument position — and that coercion is decided after
// the literal it sits in has been inferred. So a part is recorded here when it is seen and
// judged once its caller is known: the bypass warning where a template takes it, E0530 where
// nothing does. Keyed on the part node, so the several passes that infer one literal record
// it once.
let mut tc_raw_part_nodes: List[Int] = []
let mut tc_raw_part_interp: List[Int] = []
let mut tc_raw_part_consumed: Map[Int, Int] = Map()

fn tc_raw_note_part(interp: Int, part: Int) {
    if tc_raw_part_consumed.contains_key(part) != 0 { return }
    tc_raw_part_consumed.insert(part, 0)
    tc_raw_part_nodes.push(part)
    tc_raw_part_interp.push(interp)
}

// The audit identifier recorded on the function the checker is inside, or "" when there is
// none. A bare `@trusted` reads as "" on purpose: §9.1 makes the RECORD the thing that
// suppresses, so a channel that records nothing must not silence. -1 is a body with no
// enclosing user function — a test body, or the top level — where there is nothing to read.
fn tc_enclosing_audit_id() -> Str {
    if tc_current_fn_node == -1 { return "" }
    if has_annotation(tc_current_fn_node, "trusted") == 0 { return "" }
    trusted_audit_id(get_annotation(tc_current_fn_node, "trusted"))
}

// The literal `interp` is being coerced to a `Template[C]`, so every Raw in it is folded into
// the query text rather than parameterized. That is the bypass, and this is the only place it
// happens. `@trusted(audit: K)` is its one suppression channel (§9.1).
fn tc_raw_consume_template(interp: Int) ! Diag.Report {
    let mut i = 0
    while i < tc_raw_part_nodes.len() {
        if tc_raw_part_interp.get(i).unwrap() == interp {
            let part = tc_raw_part_nodes.get(i).unwrap()
            if (tc_raw_part_consumed.get(part) ?? 0) == 0 {
                tc_raw_part_consumed.insert(part, 1)
                // -1 is a body with no enclosing user function — a test body, or the top
                // level. No function means no audit to find, so the warning stands.
                if tc_enclosing_audit_id() == "" {
                    diag_warn_at("RawBypassesParam", RAW_BYPASSES_PARAM, "Raw() bypasses query parameterization", part, "add @trusted(audit: \"AUDIT-ID\") to suppress")
                }
            }
        }
        i = i + 1
    }
}

// Whatever no template took. Reported once the whole program has been checked, because a
// literal's consumer is a caller that may be checked after the literal itself.
fn tc_raw_report_unconsumed() ! Diag.Report {
    let mut i = 0
    while i < tc_raw_part_nodes.len() {
        let part = tc_raw_part_nodes.get(i).unwrap()
        if (tc_raw_part_consumed.get(part) ?? 0) == 0 {
            tc_raw_report_stranded(part, "drop the wrapper and interpolate the value itself")
        }
        i = i + 1
    }
}

// §3b.5: the folded text is the string itself, so `Raw` wraps only a `Str`. A type still
// open here is settled to Str, so a later use that wants another type reports there. A
// diverging argument never yields a value, so it has no type to reject.
fn tc_raw_require_str(arg: Int, t: Int) ! Diag.Report {
    let r = tc_resolve(t)
    if tc_is_unbound_metavar(r) != 0 {
        tc_unify(r, TYPE_STR)
        return
    }
    let k = tc_tid_kind(r)
    if k == TyKind.Str || k == TyKind.Unknown || k == TyKind.Never { return }
    diag_error_at("TemplateHoleType", TEMPLATE_HOLE_TYPE,
        "`Raw` wraps only a `Str`, found `{type_to_str(r)}`", arg,
        "send it as a parameter instead of wrapping it in `Raw`")
}

// True when the type at a template hole was a Raw[Str] that a template folded, so the
// fold was seen, and audited, here. Codegen folds only these.
pub fn tc_raw_part_folded(part: Int) -> Bool {
    (tc_raw_part_consumed.get(part) ?? 0) == 1
}

fn tc_raw_report_stranded(node: Int, help: Str) ! Diag.Report {
    diag_error_at("RawOutsideTemplate", RAW_OUTSIDE_TEMPLATE,
        "a `Raw[T]` reached a position that does not consume it — only a `Template[C]` coercion does",
        node, help)
}

// A Raw[Str] at any depth of the type. A function type is skipped: a closure that returns
// a Raw is not shown by printing it.
fn tc_tid_holds_raw(tid0: Int) -> Bool {
    let tid = tc_resolve(tid0)
    let k = tc_tid_kind(tid)
    if k == TyKind.Raw { return true }
    if k == TyKind.Fn { return false }
    let n = tc_tid_child_count(tid)
    let mut i = 0
    while i < n {
        let c = tc_tid_child(tid, i)
        if c >= 0 && tc_tid_holds_raw(c) { return true }
        i = i + 1
    }
    false
}

// A print sink shows its argument through Display or Debug, which a Raw[Str] has none of,
// alone or inside a container. Only a template hole consumes one, so here it is stranded the
// same as in a plain literal.
fn tc_raw_reject_display_sink(arg: Int, t: Int) ! Diag.Report {
    if !tc_tid_holds_raw(t) { return }
    tc_raw_report_stranded(arg, "drop the wrapper and pass the value itself")
}

// A call of a free function whose signature is settled: a bare `f(..)` or a module-qualified
// `m.f(..)`. Both forms reach the same function, so both take the keyword fill, the count and
// the argument types from check_arg_shapes; a form that skipped it would leave a defaulted
// argument out of the call.
fn tc_check_free_call(fn_name: Str, sig: Int, node: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let fs = fnsig_pool.get(sig).unwrap()
    check_deprecated_fn(fn_name, fs.decl, node)
    if tc_value_decl_poisoned(fs.decl) {
        return tc_check_poisoned_call_args(node)
    }
    if node_type_params(node) != -1 {
        let no_outer: Map[Str, Int] = Map()
        return tc_call_with_type_args(fn_name, sig, node, 0, no_outer)
    }
    let args_sl = node_args(node)
    let arg_tids = check_arg_shapes(fn_name, sig, args_sl, 0, node)
    if fs.type_params_count == 0 { return fs.ret }
    // Enforce each type param's declared bound against the concrete type inferred for it
    // (E0306). Read-only: bind the args, check, diagnose.
    tc_check_bounds_for_binds(sig, build_typevar_binds(sig, arg_tids, 0), node)
    // The return type is substituted, so a generic-struct return such as `Box[T]` carries
    // its concrete slots and codegen can spell the instance. Any metavar-carrying arg is
    // then pinned from the call's binds, so `fill(Map(), 256, "x")` (K→Int, V→Str from the
    // sibling args) codegens the Map() with the right kops instead of an erased default. If
    // a typevar is genuinely unbound (no arg pins it), the arg's α stays unbound and E0301
    // fires at its own binding/boundary.
    let ret_t = instantiate_return_type(sig, arg_tids, node, 0)
    tc_pin_generic_args_from_binds(sig, args_sl, arg_tids, 0)
    ret_t
}

// A call of a function its module declares twice (E1016) may have meant either declaration,
// so the arguments are checked on their own and the call is held to neither signature, nor
// its type arguments to either list of binders.
fn tc_check_poisoned_call_args(node: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    tc_type_args_claimed.insert(node, 1)
    let args_sl = node_args(node)
    if args_sl != -1 {
        let mut i = 0
        while i < sublist_length(args_sl) {
            let arg = sublist_get(args_sl, i)
            let _ = tc_infer_unhinted(if node_kind(arg) == NodeKind.NamedArg { node_value(arg) } else { arg })
            i = i + 1
        }
    }
    tc_error_recovery_tid()
}

// The signature a module-qualified call names. Name resolution recorded the declaration the
// qualifier reaches, and that settles it: the bare spelling may name a namesake in the
// caller's own module or in another import.
fn tc_qualified_call_fnsig(node: Int, method: Str) -> Int {
    match fnsig_by_decl.get(tc_call_decl_node(node)) {
        Some(s) => s
        None => lookup_fnsig(method)
    }
}

// Validate a call against a fnsig: its keyword shape, its argument count, and each
// argument's type. `self_offset` skips leading implicit params: 0 for free functions, 1 for
// methods whose fnsig carries `self` as param 0 (so explicit arg `i` aligns to
// fnsig param `i + self_offset`). Params typed TYPE_UNKNOWN are skipped.
// Genuinely saves/restores tc_construct_hint around infer_type; infer_type also
// writes cumulative inference state that is intended to persist, not roll back.
@allow(UnrestoredMutation)
fn check_arg_shapes(fn_name: Str, sig: Int, args_sl: Int, self_offset: Int, call_node: Int) -> List[Int] ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    check_arg_shapes_with_binds(fn_name, sig, args_sl, self_offset, call_node, tc_no_binds)
}

// One empty binds Map for every call that has none, instead of a new one per call. Only ever
// read: it reaches substitute_typevar_tid and nothing else.
let tc_no_binds: Map[Str, Int] = Map()

// Same as check_arg_shapes, but substitutes each param tid through `binds` first.
// A poly-impl method on List[T] must hint a bare literal from the receiver's
// concrete element type, not the impl's own unsubstituted Typevar(T).
//
// Answers one tid per argument, -1 where no parameter lines up. This is the one place
// a call reads its arguments: a second infer_type would mint fresh metavariables for a
// nested `Map()`, and the binds, return type and pin would each hold a different one.
@allow(UnrestoredMutation)
fn check_arg_shapes_with_binds(fn_name: Str, sig: Int, args_sl: Int, self_offset: Int, call_node: Int, binds: Map[Str, Int]) -> List[Int] ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    // Every call against a declared signature reaches here, which is what makes the keyword
    // and count rules hold for `b.f(x: 1)` and not only for `f(x: 1)`. A call with no
    // arguments at all still owes a signature its keyword arguments and its count.
    let kw_bad = tc_check_keyword_args(fn_name, sig, args_sl, self_offset, call_node)
    if kw_bad == 0 { tc_check_call_arity(fn_name, sig, args_sl, self_offset, call_node) }
    tc_check_arg_types_with_binds(fn_name, sig, args_sl, self_offset, binds)
}

// The count half of a call's shape, read after the keyword check has filled each defaulted
// argument the call left out. The receiver stands for the first `self_offset` parameters and
// is not counted. Only for a call whose keyword shape was right: a wrong one has had its one
// mistake named already.
fn tc_check_call_arity(fn_name: Str, sig: Int, args_sl: Int, self_offset: Int, call_node: Int) ! TypeCheck.Report, Diag.Report {
    let want = fnsig_pool.get(sig).unwrap().params_count - self_offset
    let got = if args_sl != -1 { sublist_length(args_sl) } else { 0 }
    if got == want { return }
    let noun = if self_offset == 0 { "function" } else { "method" }
    tc_error_at("{noun} `{fn_name}` expects {want} argument(s), got {got}", call_node)
}

// Each argument's type against its parameter, for a caller that has judged the keyword shape
// and the count itself because its count reads differently: a builtin with an optional
// argument, or a qualified trait call that counts the receiver.
@allow(UnrestoredMutation)
fn tc_check_arg_types_with_binds(fn_name: Str, sig: Int, args_sl: Int, self_offset: Int, binds: Map[Str, Int]) -> List[Int] ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let mut tids: List[Int] = []
    if args_sl == -1 { return tids }
    let fs = fnsig_pool.get(sig).unwrap()
    let param_start = fs.params_start
    let param_count = fs.params_count
    // What the arguments read so far say each type parameter is. A type parameter has one
    // type per call, so a later argument is checked against the type an earlier one fixed,
    // the rule a list literal's elements follow.
    if tc_arg_binds_free.len() == 0 { tc_arg_binds_free.push(Map()) }
    let mut seen = tc_arg_binds_free.pop().unwrap()
    seen.clear()
    let n = sublist_length(args_sl)
    let mut i = 0
    while i < n {
        let arg_node = sublist_get(args_sl, i)
        let mut pidx = i + self_offset
        if node_kind(arg_node) == NodeKind.NamedArg {
            // A keyword argument names its parameter, and codegen reorders by that name, so
            // this check has to follow the name too. -1 means no such parameter, which
            // tc_check_keyword_args reports as InvalidKeywordArg; skipping leaves that one
            // error standing.
            pidx = tc_fnsig_param_index_by_name(param_start, param_count, self_offset, node_name(arg_node))
        }
        let mut arg_t = -1
        if pidx >= 0 && pidx < param_count {
            let formal = fnsig_param_list.get(param_start + pidx).unwrap()
            // The second substitution is not skipped when nothing is bound: it still resolves
            // the metavariables in the formal.
            let concrete = if seen.len() == 0 { tc_no_binds } else { tc_concrete_binds(seen) }
            let ptid = substitute_typevar_tid(substitute_typevar_tid(formal, binds), concrete)
            if tc_is_default_fill(arg_node) {
                // Inferring the default here would read its names in the caller's module
                // and scope; it was held to this parameter at the declaration.
                arg_t = ptid
                tc_publish_node_tid(arg_node, ptid)
            } else if tc_tid_is_no_info(ptid) == 0 {
                arg_t = check_one_arg_shape(fn_name, i, arg_node, ptid)
            }
            if arg_t >= 0 { unify_typevar_binds(formal, arg_t, seen) }
        }
        // build_typevar_binds aligns by position, so a position with a parameter needs a
        // tid even where the check above had no parameter type to hint it from.
        if arg_t < 0 && i + self_offset < param_count { arg_t = tc_infer_unhinted(arg_node) }
        tids.push(arg_t)
        i = i + 1
    }
    tc_arg_binds_free.push(seen)
    tids
}

// The `seen` maps of check_arg_shapes_with_binds, kept instead of a new map per call. An
// argument can hold a call, which reads its own arguments before the outer call reads its next
// one, so a call takes a map off this list and gives it back when done: no two open calls
// share one. A check that panicked out of a call leaves its map off the list, which costs a
// new map and nothing else; init_types empties the list so no map outlives its check.
let mut tc_arg_binds_free: List[Map[Str, Int]] = []

// A placeholder bind (a bare metavariable from `Map()` against `K`) says nothing yet, and
// hinting the next argument with it would type that argument from a hole.
fn tc_concrete_binds(binds: Map[Str, Int]) -> Map[Str, Int] {
    let mut out: Map[Str, Int] = Map()
    for (k, v) in binds {
        if bind_target_is_concrete(v) != 0 { out.insert(k, v) }
    }
    out
}

// One argument against its parameter type `ptid`, answering the argument's type.
// Saves and restores tc_construct_hint around infer_type.
@allow(UnrestoredMutation)
// A parameter type is an expected type like a let annotation or a return type
// (sections/03_types.md 3.3), so it reaches a call inside a block or a branch of the
// argument too. The unify above binds only the merged type, which for an if/match over
// a generic struct carries one arm's metavar. A parameter type that still holds a bare
// typevar names the callee's own parameter, which no caller metavar may bind.
fn tc_pin_param_into_arg(ptid: Int, arg_node: Int, arg_t: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if tc_tid_has_bare_typevar(ptid) != 0 { return }
    let v = if node_kind(arg_node) == NodeKind.NamedArg { node_value(arg_node) } else { arg_node }
    if v < 0 { return }
    tc_pin_declared_into_value(tc_resolve(ptid), v, arg_t)
}

fn check_one_arg_shape(fn_name: Str, idx: Int, arg_node: Int, ptid: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    tc_seed_expected_into_value(arg_node, ptid)
    let saved_hint = tc_construct_hint
    tc_construct_hint = resolve_alias_tid(ptid)
    let arg_t = infer_type(arg_node)
    tc_construct_hint = saved_hint
    // An argument whose own type nothing has determined cannot be judged against
    // the parameter. Skipping keeps the mistake that made it undetermined as the
    // single report, instead of adding a mismatch against a type nobody claimed.
    // "Carries a hole" and not "is a hole": the name-resolution pass walks a body
    // before the typecheck pass has settled its locals, so `[a]` reads there as
    // `List[<hole>]` — a real List tid with an undetermined element. Comparing it
    // reports against a type nobody claimed; the compare that matters runs again on
    // the typecheck pass, with the element settled.
    if tc_tid_is_no_info(arg_t) != 0 || tc_tid_has_unknown(arg_t) != 0 { return arg_t }
    // Metavar path: passing an as-yet-unpinned empty container
    // to a concretely-typed param is a constraining use — UNIFY so the
    // param type PINS the argument's α (`let xs = []; takes_ints(xs)`
    // infers List[Int]). tc_unify returns 0 on a hard mismatch (real
    // arg-type error). Only when a metavar is actually present, so the
    // fully-concrete path keeps its existing types_compatible semantics.
    //
    // The parameter side can carry one too: `pick([], [1])` fixes T as List[α] from its first
    // argument, and only the second argument can pin α.
    if tc_tid_has_unbound_metavar(arg_t) != 0 || tc_tid_has_unbound_metavar(ptid) != 0 {
        if tc_unify(ptid, arg_t) == 0 {
            tc_arg_mismatch(fn_name, idx + 1, arg_node, ptid, arg_t)
        } else {
            tc_pin_param_into_arg(ptid, arg_node, arg_t)
        }
    } else {
        let mut lit_to_int = 0
        if is_int_literal_node(arg_node) != 0 && is_integer_type(resolve_alias_tid(ptid)) != 0 {
            tc_literal_takes(arg_node, ptid)
            lit_to_int = 1
        }
        // The template-literal coercion, on the same footing as the
        // int-literal one above. See tc_template_arg_ok.
        if tc_template_arg_ok(ptid, arg_node) != 0 {
            tc_raw_consume_template(arg_node)
            // Codegen builds a template value only where the literal's own stamp says
            // Template, so the coercion is recorded on the node, not only accepted.
            tc_publish_node_tid(arg_node, resolve_alias_tid(ptid))
            lit_to_int = 1
        } else if tc_template_launders_str(ptid, arg_t) != 0 {
            // The laundering case gets the spec's OWN diagnostic
            // (sections/03b_contracts.md:470) rather than the generic mismatch
            // below: E0310 with the hint that names the two ways out. This is the
            // error the whole feature exists to produce, and it used to come from
            // codegen (codegen_methods.bl:3151) — which meant it only fired on the
            // effect-op path and only after typecheck had let the program through.
            // Reporting it here covers every call shape and stops at the phase that
            // knows the param's type. Setting the flag suppresses the generic report,
            // so one mistake stays one error.
            diag_error_at("TemplateMismatch", TEMPLATE_MISMATCH, "expected {type_to_str(ptid)}, found {type_to_str(arg_t)} — string variables cannot be implicitly converted to Template", arg_node, "pass the string literal directly, or wrap values in Raw() for dynamic SQL")
            lit_to_int = 1
        }
        if lit_to_int == 0 && (types_compatible(arg_t, ptid) == 0 || tc_value_misses_never_slot(ptid, arg_t) != 0) {
            tc_arg_mismatch(fn_name, idx + 1, arg_node, ptid, arg_t)
        } else if lit_to_int == 0 {
            // A merged if/match type can read concrete from one arm while another arm's
            // call still holds an open binder.
            tc_pin_param_into_arg(ptid, arg_node, arg_t)
        }
    }
    arg_t
}

// Validate a single already-unwrapped argument value against an expected type,
// applying the construction hint + int-literal coercion escape, and emit the
// shared "argument N of 'LABEL' expects X, got Y" diagnostic on mismatch. Shared
// by check_builtin_arg and the qualified-variant-construction guard.
// Genuinely saves/restores tc_construct_hint around infer_type; infer_type also
// writes cumulative inference state that is intended to persist, not roll back.
@allow(UnrestoredMutation)
fn check_arg_value(label: Str, arg_idx: Int, expected_t: Int, value_node: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if tc_tid_is_no_info(expected_t) != 0 { return }
    tc_seed_expected_into_value(value_node, expected_t)
    let saved_hint = tc_construct_hint
    tc_construct_hint = resolve_alias_tid(expected_t)
    let arg_t = infer_type(value_node)
    tc_construct_hint = saved_hint
    // An argument whose own type nothing has determined cannot be judged against
    // the parameter. Skipping keeps the mistake that made it undetermined as the
    // single report, instead of adding a mismatch against a type nobody claimed.
    // "Carries a hole" and not "is a hole" — see check_arg_shapes for why the
    // name-resolution pass sees `List[<hole>]` for a well-typed list of locals.
    if tc_tid_is_no_info(arg_t) != 0 || tc_tid_has_unknown(arg_t) != 0 { return }
    // Metavariable path: when the expected type carries an unbound α
    // (e.g. `elem` of an as-yet-unpinned List/Set/Map — an unannotated `[]`),
    // UNIFY it with the argument type so the constraining use PINS α, instead of
    // discarding the constraint. tc_unify binds α in place and returns 1 on a
    // structural match, 0 on a hard mismatch (a real type error — a conflicting
    // second push, `xs.push(1); xs.push("a")`). Int-literals still coerce to a
    // pinned sized-int target. Runs only when a metavar is actually present so
    // the fully-concrete path stays on the existing types_compatible semantics.
    if tc_tid_has_unbound_metavar(expected_t) != 0 {
        let mut lit_ok = 0
        if is_int_literal_node(value_node) != 0 && is_integer_type(tc_resolve(expected_t)) != 0 {
            tc_literal_takes(value_node, expected_t)
            lit_ok = 1
        }
        if lit_ok == 0 && tc_unify(expected_t, arg_t) == 0 {
            tc_arg_mismatch(label, arg_idx + 1, value_node, expected_t, arg_t)
        } else {
            tc_pin_param_into_arg(expected_t, value_node, arg_t)
        }
        return
    }
    let mut lit_to_int = 0
    if is_int_literal_node(value_node) != 0 && is_integer_type(resolve_alias_tid(expected_t)) != 0 {
        tc_literal_takes(value_node, expected_t)
        lit_to_int = 1
    }
    // Mirror of check_arg_shapes (the fnsig-backed sibling): the metavar can sit on
    // the ARGUMENT side, not the expected side, when a fresh empty-container ctor is
    // passed to a concrete param — `l.push(Map())` with `l: List[Map[Int, Str]]` has a
    // concrete `Map[Int, Str]` expected and a `Map[α_k, α_v]` arg. Unify the concrete
    // expected type INTO the fresh ctor so it PINS α (and its kops vtable) instead of
    // discarding the constraint. Only when a metavar is actually present, so the
    // fully-concrete path keeps its existing types_compatible semantics.
    if lit_to_int == 0 && tc_tid_has_unbound_metavar(arg_t) != 0 {
        if tc_unify(expected_t, arg_t) == 0 {
            tc_arg_mismatch(label, arg_idx + 1, value_node, expected_t, arg_t)
        } else {
            tc_pin_param_into_arg(expected_t, value_node, arg_t)
        }
        return
    }
    if lit_to_int == 0 && (types_compatible(arg_t, expected_t) == 0 || tc_value_misses_never_slot(expected_t, arg_t) != 0) {
        tc_arg_mismatch(label, arg_idx + 1, value_node, expected_t, arg_t)
    } else if lit_to_int == 0 {
        tc_pin_param_into_arg(expected_t, value_node, arg_t)
    }
}

// `channel.new[T]` has one keyword parameter, `buffer: Int` (sections/04_effects.md), and
// no fnsig for tc_check_keyword_args to read, so its rules are applied here to that one
// parameter. One report per call, as there.
fn tc_check_channel_new_args(node: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let fn_name = "channel.new"
    let args_sl = node_args(node)
    let mut argc = 0
    if args_sl != -1 { argc = sublist_length(args_sl) }
    let mut value = -1
    let mut i = 0
    while i < argc {
        let arg = sublist_get(args_sl, i)
        if node_kind(arg) != NodeKind.NamedArg {
            diag_error_at("UnlabeledKeywordArg", UNLABELED_KEYWORD_ARG, "`buffer` of `{fn_name}` is a keyword parameter and takes its argument by label", arg, "label the argument already written: `buffer: ...`")
            return
        }
        let label = node_name(arg)
        if label != "buffer" {
            diag_error_at("InvalidKeywordArg", INVALID_KEYWORD_ARG, "`{label}` names no keyword parameter of `{fn_name}`", arg, "the keyword parameter of `{fn_name}` is `buffer`")
            return
        }
        if value != -1 {
            diag_error_at("DuplicateKeywordArg", DUPLICATE_KEYWORD_ARG, "`{label}` is given twice in this call to `{fn_name}`", arg, "delete the repeated argument")
            return
        }
        value = node_value(arg)
        i = i + 1
    }
    if value == -1 {
        diag_error_at("MissingKeywordArg", MISSING_KEYWORD_ARG, "keyword argument `buffer` is missing from the call to `{fn_name}`", node, "add `buffer: <value>`")
        return
    }
    check_arg_value(fn_name, 0, TYPE_INT, value)
}

// Validate a single argument to a built-in intrinsic method (List/Set/Str/Map).
// These methods are pure codegen intrinsics with no fnsig backing, so we cannot
// reuse check_arg_shapes; we validate inline against the container's elem/key type.
// DEFERRED (need closure-signature checking): List.map/filter/find/fold/for_each/
// any/all and Bytes.with_ptr. Bytes integer-arg methods also deferred.
fn check_builtin_arg(method: Str, arg_idx: Int, expected_t: Int, args_sl: Int, container_label: Str) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if args_sl == -1 { return }
    if arg_idx >= sublist_length(args_sl) { return }
    check_arg_value("{container_label}.{method}", arg_idx, expected_t, sublist_get(args_sl, arg_idx))
}

// `byte_index_of` has no default `from`, so the help spells out the one edit that keeps the
// call searching from the start. It is not offered as a fix: a fix replaces the reported
// span, and a call argument records no end, so an editor would put `, 0` before the needle.
fn tc_report_byte_index_of_missing_from(needle: Int) ! TypeCheck.Report, Diag.Report {
    tc_error_at_code("method `Str.byte_index_of` expects 2 argument(s), got 1", needle, "TypeError", TYPE_ERROR,
        "`byte_index_of` has no default start: add `, 0` after the needle to search from the first byte")
}

// Arity for a built-in intrinsic method. check_builtin_arg above validates argument i only
// when argument i is PRESENT, so a call with too few arguments passed the front end with no
// complaint and reached codegen, which then reads an argument that is not there. Answers 1
// when the call is well-formed, 0 after reporting — the caller stops rather than indexing an
// empty list, which panics.
fn check_builtin_arity(container_label: Str, method: Str, want: Int, args_sl: Int, node: Int) -> Int ! TypeCheck.Report, Diag.Report {
    let mut got = 0
    if args_sl != -1 { got = sublist_length(args_sl) }
    if got == want { return 1 }
    tc_error_at("method `{container_label}.{method}` expects {want} argument(s), got {got}", node)
    0
}

// The receiver name the arity report spells. tk_name is the stable spelling everywhere
// else; the ffi scope is the one kind whose surface the spec and the existing reports call
// `scope`, so the message keeps that word.
fn tc_builtin_recv_label(obj_k: TyKind) -> Str {
    if obj_k == TyKind.FfiScope { return "scope" }
    tk_name(obj_k)
}

// The scalars the built-in trait table (sections/03_types.md) gives Eq. Their `eq` is the
// explicit form of `==`, answered with no impl to resolve. Bool is Eq and not Ord.
pub fn tc_scalar_has_eq(k: TyKind) -> Bool {
    if k == TyKind.Bool { return true }
    tc_scalar_has_ord(k)
}

// The scalars the same table gives Ord. Their `cmp` is the explicit form of `<`.
pub fn tc_scalar_has_ord(k: TyKind) -> Bool {
    if k == TyKind.Int || k == TyKind.Float || k == TyKind.Char || k == TyKind.Str { return true }
    is_sized_int(k) != 0
}

// How many arguments a builtin method takes, or -1 when this table claims nothing for the
// pair. A builtin has no fnsig to count against, so this IS the count.
//
// Keyed on the method and never on the arm that answers it: two arms in
// infer_type_uncached answer methods whose counts differ (Int `abs` against `min`/`max`,
// `display` against `fmt`), so an arm is the wrong unit. No row is optional either — the
// language has neither default parameters nor variadics.
// docs/codegen-rewrite/builtin_method_arity.md is the survey this reproduces, arm by arm,
// and is where a new method's row gets recorded.
fn tc_builtin_method_arity(obj_k: TyKind, method: Str) -> Int {
    if method == "eq" && tc_scalar_has_eq(obj_k) { return 1 }
    if method == "cmp" && tc_scalar_has_ord(obj_k) { return 1 }
    if obj_k == TyKind.Int || obj_k == TyKind.Float || obj_k == TyKind.Bool || obj_k == TyKind.Str || obj_k == TyKind.Char {
        if method == "display" { return 0 }
        if method == "fmt" { return 1 }
    }
    if method == "into_iter" {
        if obj_k == TyKind.List || obj_k == TyKind.Set || obj_k == TyKind.Str || obj_k == TyKind.Iterator { return 0 }
    }
    if obj_k == TyKind.Iterator {
        if method == "map" || method == "flat_map" || method == "filter" { return 1 }
        if method == "for_each" || method == "any" || method == "all" || method == "find" { return 1 }
        if method == "take" || method == "skip" || method == "chain" || method == "zip" { return 1 }
        if method == "fold" { return 2 }
        if method == "enumerate" || method == "collect" || method == "count" { return 0 }
        return -1
    }
    if obj_k == TyKind.List {
        if method == "get" || method == "push" || method == "contains" || method == "join" || method == "remove" { return 1 }
        if method == "index_of" { return 1 }
        if method == "take" || method == "skip" || method == "chain" || method == "append" || method == "zip" { return 1 }
        if method == "map" || method == "flat_map" || method == "filter" || method == "sort_by" { return 1 }
        if method == "for_each" || method == "any" || method == "all" || method == "find" { return 1 }
        if method == "set" || method == "insert" || method == "slice" || method == "fold" { return 2 }
        if method == "len" || method == "count" || method == "pop" || method == "clear" || method == "sort" { return 0 }
        if method == "enumerate" || method == "is_empty" || method == "capacity" || method == "last" { return 0 }
        return -1
    }
    if obj_k == TyKind.Str {
        if method == "contains" || method == "starts_with" || method == "ends_with" { return 1 }
        if method == "concat" || method == "byte_at" || method == "index_of" { return 1 }
        if method == "char_at" || method == "split" { return 1 }
        if method == "replace" || method == "substring" { return 2 }
        if method == "byte_slice" || method == "byte_index_of" { return 2 }
        if method == "len" || method == "byte_len" || method == "as_cstr" || method == "to_int" || method == "lines" { return 0 }
        if method == "trim" || method == "trim_left" || method == "trim_right" { return 0 }
        if method == "to_lower" || method == "to_upper" || method == "is_empty" { return 0 }
        if method == "parse_float" || method == "parse_int" { return 0 }
        return -1
    }
    if obj_k == TyKind.Int {
        if method == "min" || method == "max" { return 1 }
        if method == "to_str" || method == "to_string" || method == "to_float" || method == "abs" { return 0 }
        if method == "to_i8" || method == "to_i16" || method == "to_i32" { return 0 }
        if method == "to_u8" || method == "to_u16" || method == "to_u32" || method == "to_u64" { return 0 }
        return -1
    }
    if obj_k == TyKind.Float {
        if method == "to_string" || method == "to_int" { return 0 }
        if method == "ieee_eq" { return 1 }
        if method == "to_bits" || method == "is_sign_negative" { return 0 }
        return -1
    }
    if obj_k == TyKind.Char {
        if method == "to_int" || method == "to_str" { return 0 }
        return -1
    }
    if is_sized_int(obj_k) {
        if method == "wrapping_add" || method == "wrapping_sub" || method == "wrapping_mul" { return 1 }
        if method == "to_int" { return 0 }
        if method == "to_i8" || method == "to_i16" || method == "to_i32" { return 0 }
        if method == "to_u8" || method == "to_u16" || method == "to_u32" || method == "to_u64" { return 0 }
        return -1
    }
    if obj_k == TyKind.Option {
        if method == "unwrap" || method == "is_some" || method == "is_none" { return 0 }
        return -1
    }
    if obj_k == TyKind.Result {
        if method == "unwrap" || method == "unwrap_err" || method == "is_ok" || method == "is_err" { return 0 }
        return -1
    }
    if obj_k == TyKind.Map {
        if method == "get" || method == "contains_key" || method == "contains" || method == "remove" { return 1 }
        if method == "insert" { return 2 }
        if method == "len" || method == "clear" || method == "is_empty" { return 0 }
        if method == "keys" || method == "values" || method == "entries" { return 0 }
        return -1
    }
    if obj_k == TyKind.Set {
        if method == "contains" || method == "insert" || method == "remove" || method == "union" { return 1 }
        if method == "len" || method == "is_empty" { return 0 }
        return -1
    }
    if obj_k == TyKind.Channel {
        if method == "send" { return 1 }
        if method == "recv" || method == "close" { return 0 }
        return -1
    }
    if obj_k == TyKind.Bytes {
        if method == "get" || method == "push" || method == "concat" || method == "with_ptr" { return 1 }
        if method == "read_u16_be" || method == "read_u32_be" || method == "read_i32_be" || method == "read_i64_be" { return 1 }
        if method == "read_u16_le" || method == "read_u32_le" || method == "read_i32_le" || method == "read_i64_le" { return 1 }
        if method == "write_u16_be" || method == "write_u32_be" || method == "write_i32_be" || method == "write_i64_be" { return 1 }
        if method == "write_u16_le" || method == "write_u32_le" || method == "write_i32_le" || method == "write_i64_le" { return 1 }
        if method == "set" || method == "slice" { return 2 }
        if method == "set_u16_be" || method == "set_u32_be" || method == "set_u64_be" { return 2 }
        if method == "set_i16_be" || method == "set_i32_be" || method == "set_i64_be" { return 2 }
        if method == "set_u16_le" || method == "set_u32_le" || method == "set_u64_le" { return 2 }
        if method == "set_i16_le" || method == "set_i32_le" || method == "set_i64_le" { return 2 }
        if method == "len" || method == "is_empty" || method == "to_str" || method == "to_hex" { return 0 }
        return -1
    }
    if obj_k == TyKind.StringBuilder {
        if method == "write" || method == "write_char" { return 1 }
        if method == "clear" || method == "to_str" || method == "len" { return 0 }
        if method == "capacity" || method == "is_empty" { return 0 }
        return -1
    }
    if obj_k == TyKind.Ptr {
        if method == "write" || method == "offset" { return 1 }
        if method == "is_null" || method == "addr" || method == "deref" || method == "to_str" { return 0 }
        return -1
    }
    if obj_k == TyKind.Template {
        if method == "type_tag" || method == "get_int" || method == "get_float" { return 1 }
        if method == "get_bool" || method == "get_str" { return 1 }
        if method == "parts" || method == "count" { return 0 }
        return -1
    }
    if obj_k == TyKind.FfiScope {
        if method == "cstr" || method == "take" || method == "alloc_n" { return 1 }
        if method == "alloc" { return 0 }
        return -1
    }
    -1
}

// A signature typecheck holds for a namespace intrinsic — a method codegen emits directly
// rather than resolving to a Blink function. Registered into fnsig_pool under the qualified
// key `{namespace}.{method}`, which no user function can spell (register_fn_sig separates a
// module qualifier with a COLON), so the whole existing fnsig machinery applies: lookup_fnsig
// finds it, check_arg_shapes reports "argument 2 of 'net.listen' expects Int, got Str", and
// `.ret` is the return tid.
fn register_intrinsic_fn_sig(key: Str, params: List[Int], ret: Int) {
    register_named_intrinsic_fn_sig(key, params, [], ret)
}

// As register_intrinsic_fn_sig, with the parameter names the spec writes. A name that
// `names` does not give stays "".
fn register_named_intrinsic_fn_sig(key: Str, params: List[Int], names: List[Str], ret: Int) {
    let start = fnsig_param_list.len()
    let mut i = 0
    while i < params.len() {
        fnsig_param_list.push(params.get(i).unwrap())
        fnsig_param_names.push(names.get(i) ?? "")
        fnsig_param_kw.push(0)
        fnsig_param_default.push(-1)
        i = i + 1
    }
    fnsig_map.insert(key, fnsig_pool.len())
    fnsig_pool.push(FnSigEntry { name: key, ret: ret, params_start: start, params_count: params.len(), type_params_start: fnsig_type_param_names.len(), type_params_count: 0, effects_start: fnsig_effect_names.len(), effects_count: 0, decl: -1 })
}

// The bare builtins whose call is checked like a declared fn's (sections/02_syntax.md §2.20
// and *Built-in Assertions*), each with the fewest arguments it takes, or -1 for any other
// name. `todo`, `unreachable`, `assert_eq` and `assert_ne` may leave out their trailing `msg`:
// two forms are a property of these builtins only, since a positional parameter of a user fn
// has no default (§2.13).
fn tc_builtin_fewest_args(name: Str) -> Int {
    let mut table: Map[Str, Int] = Map()
    table.insert("panic", 1)
    table.insert("todo", 0)
    table.insert("unreachable", 0)
    table.insert("assert_eq", 2)
    table.insert("assert_ne", 2)
    table.get(name) ?? -1
}

// Each is signed under a dotted key no user fn can spell, so a program's own `fn panic` keeps
// the bare key and wins by resolution.
fn tc_builtin_sig_key(name: Str) -> Str {
    if tc_builtin_fewest_args(name) < 0 { return "" }
    "builtin.{name}"
}

fn register_builtin_fn_sigs() {
    for name in ["panic", "todo", "unreachable"] {
        register_intrinsic_fn_sig(tc_builtin_sig_key(name), [TYPE_STR], TYPE_NEVER)
        fnsig_param_names.set(fnsig_param_names.len() - 1, "msg")
    }
    // `fn assert_eq[T: Eq + Debug](left: T, right: T, msg: Str = "")`. Both values share the
    // one T, so the second is checked against the type the first fixed, as a user
    // `fn eq[T: Eq](a: T, b: T)` call is. Eq is not in the bound set: tc_check_assert_eq_args
    // asks for it with a report that walks into containers. Debug is not in it yet either:
    // codegen renders the values without a Debug impl, and the programs that compare a type
    // with no Debug have to be repaired before the bound can be asked for.
    for name in ["assert_eq", "assert_ne"] {
        let t = make_typevar_bound("T", BUILTIN_BINDER_NODE)
        register_intrinsic_fn_sig(tc_builtin_sig_key(name), [t, t, TYPE_STR], TYPE_VOID)
        let at = fnsig_param_names.len() - 3
        fnsig_param_names.set(at, "left")
        fnsig_param_names.set(at + 1, "right")
        fnsig_param_names.set(at + 2, "msg")
        tc_add_builtin_sig_tparam("T", "|")
    }
}

// Gives the newest fnsig one more type parameter, in every table parallel to
// fnsig_type_param_names, so the readers indexing those tables by the same slot agree.
fn tc_add_builtin_sig_tparam(name: Str, bounds: Str) {
    let sig = fnsig_pool.len() - 1
    let fs = fnsig_pool.get(sig).unwrap()
    let start = if fs.type_params_count == 0 { fnsig_type_param_names.len() } else { fs.type_params_start }
    fnsig_type_param_names.push(name)
    fnsig_tparam_nodes.push(BUILTIN_BINDER_NODE)
    fnsig_tparam_ret_only.push(0)
    fnsig_tparam_sourced.push(1)
    fnsig_tparam_bounds.push(bounds)
    fnsig_pool.set(sig, FnSigEntry { name: fs.name, ret: fs.ret, params_start: fs.params_start, params_count: fs.params_count, type_params_start: start, type_params_count: fs.type_params_count + 1, effects_start: fs.effects_start, effects_count: fs.effects_count, decl: fs.decl })
}

// A bare builtin call against its tc_builtin_sig_key signature, with the wording a declared
// fn's call gets.
fn tc_check_builtin_sig_call(fn_name: Str, sig: Int, node: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let fs = fnsig_pool.get(sig).unwrap()
    let args_sl = node_args(node)
    let kw_bad = tc_check_keyword_args(fn_name, sig, args_sl, 0, node)
    let arg_count = if args_sl != -1 { sublist_length(args_sl) } else { 0 }
    let fewest = tc_builtin_fewest_args(fn_name)
    if kw_bad == 0 && (arg_count < fewest || arg_count > fs.params_count) {
        if fewest == fs.params_count {
            tc_error_at("function `{fn_name}` expects {fs.params_count} argument(s), got {arg_count}", node)
        } else {
            tc_error_at_code("function `{fn_name}` expects {fewest} or {fs.params_count} argument(s), got {arg_count}", node, "TypeError", TYPE_ERROR, "call `{fn_name}({tc_builtin_param_spelling(fs, fewest)})` or `{fn_name}({tc_builtin_param_spelling(fs, fs.params_count)})`")
        }
    }
    let tids = tc_check_arg_types_with_binds(fn_name, sig, args_sl, 0, tc_no_binds)
    if fs.type_params_count > 0 {
        tc_check_bounds_for_binds(sig, build_typevar_binds(sig, tids, 0), node)
    }
    if fn_name == "assert_eq" || fn_name == "assert_ne" {
        tc_check_assert_eq_args(tids, node)
        let a = tc_arg_value_at(args_sl, 0)
        let b = tc_arg_value_at(args_sl, 1)
        if tc_has_written_negative_zero(a, b) && tc_is_float_comparison(tids.get(0) ?? -1) && tc_is_float_comparison(tids.get(1) ?? -1) {
            let family = if fn_name == "assert_eq" { NegativeZeroFamily.TrueForBoth } else { NegativeZeroFamily.FalseForBoth }
            tc_warn_negative_zero_pair(a, b, family)
        }
    }
    fs.ret
}

// The first `count` parameters of a builtin signature as a user would write them: `msg: Str`.
fn tc_builtin_param_spelling(fs: FnSigEntry, count: Int) -> Str {
    let mut parts: List[Str] = []
    let mut i = 0
    while i < count {
        let at = fs.params_start + i
        parts.push("{fnsig_param_names.get(at).unwrap()}: {type_to_str(fnsig_param_list.get(at).unwrap())}")
        i = i + 1
    }
    parts.join(", ")
}

// W0703 (§2.20). The caller has resolved the call to the builtin `todo`, so a program's own
// `todo` never reaches here. A test that is not finished has `@skip` for that, so the help
// names it there.
fn tc_warn_todo_in_code(fn_name: Str, node: Int) ! Diag.Report {
    if fn_name != "todo" { return }
    let help = if tc_in_test_lexical != 0 { "write the missing code, or mark the test `@skip(\"reason\")` until it is written" } else { "write the missing code" }
    diag_warn_at_notes("TodoInCode", TODO_IN_CODE, "`todo()` left in code", node, help, ["upgrade to error in blink.toml: [lints] W0703 = \"error\""])
}

// The signature of every namespace intrinsic typecheck is allowed to know.
//
// Codegen knows all of them: each emitter at codegen_methods.bl:2651-3640 sets
// `expr_result_type` for its own method, and that is where the C types come from. Signing
// only some of them here would leave the rest with no declared type at all: TYPE_UNKNOWN
// unifies with anything, so both the declared type and the arguments go unchecked, and a
// mistyped call escapes to the C compiler or to a silent miscompile
// (`let bad: Str = net.connect(host, port)` would compile AND RUN).
//
// This is a table, not one arm per method: codegen already carries one per intrinsic, and
// typecheck reading a table keeps the two from drifting apart method by method. The parameter
// tids are the reason the table has to exist at all — the return tid alone would leave
// `net.listen(4242, "localhost")` for cc.
//
// Deliberately absent, each because what its signature IS is an open question, not where it
// lives:
//   - `net.request` — its `Result[Response, NetError]` needs two stdlib struct types that a
//     consuming module need not have imported.
//   - `io.println/print/print_raw/eprintln/eprint/eprint_raw/log` — Void statements with a
//     value-typed argument; no divergence to fix, and an arity or parameter claim here could
//     only be wrong. They are LISTED by is_intrinsic_method and unsigned here, which is a
//     deliberate and safe state: lookup_fnsig answers -1, the arm falls through, and being
//     listed keeps them off the bare-name path.
//   - `io.debug` — listed by is_intrinsic_method, emitted by no arm, so it reaches the loud
//     E0505 codegen backstop. Signing it would claim a method that cannot be called works.
//   - `env.vars` — spelled in sections/04_effects.md:209 and typed Map[Str, Str] at :752, with
//     no codegen arm at all. Unimplemented, not mistyped.
//
// io.read_bytes, io.read_line and io.read_all are the IO.Read operations of
// sections/04_effects.md §4.4.9. io.write/write_bytes and the five env.* below are not spelled
// there, but unlike fs.read there is no open question about what they ARE: the emitted C fixes
// each one completely (blink_stdout_write(const char*) -> void). The spec gap is real but
// separate: these are unspec'd intrinsics, not new types.
fn register_ns_intrinsic_sigs() {
    let bytes_t = new_type(TyKind.Bytes, "Bytes")

    // net.* — fds are bare Int, per lib/std/net_tcp.bl which wraps them.
    register_intrinsic_fn_sig("net.connect", [TYPE_STR, TYPE_INT], TYPE_INT)
    register_intrinsic_fn_sig("net.listen", [TYPE_STR, TYPE_INT], TYPE_INT)
    register_intrinsic_fn_sig("net.accept", [TYPE_INT], TYPE_INT)
    register_intrinsic_fn_sig("net.read", [TYPE_INT, TYPE_INT], TYPE_STR)
    register_intrinsic_fn_sig("net.read_all", [TYPE_INT], TYPE_STR)
    register_intrinsic_fn_sig("net.read_line", [TYPE_INT], TYPE_STR)
    register_intrinsic_fn_sig("net.read_bytes", [TYPE_INT, TYPE_INT], bytes_t)
    register_intrinsic_fn_sig("net.write", [TYPE_INT, TYPE_STR], TYPE_VOID)
    register_intrinsic_fn_sig("net.write_bytes", [TYPE_INT, bytes_t], TYPE_INT)
    register_intrinsic_fn_sig("net.set_timeout", [TYPE_INT, TYPE_INT], TYPE_VOID)
    register_intrinsic_fn_sig("net.close", [TYPE_INT], TYPE_VOID)

    register_intrinsic_fn_sig("io.read_line", [], make_option_type(TYPE_STR))
    // Named as §4.4.9 names it, so the W0545 fix can spell a read_bytes clause.
    register_named_intrinsic_fn_sig("io.read_bytes", [TYPE_INT], ["n"], bytes_t)
    register_intrinsic_fn_sig("io.read_all", [], TYPE_STR)
    register_intrinsic_fn_sig("io.write", [TYPE_STR], TYPE_VOID)
    register_intrinsic_fn_sig("io.write_bytes", [bytes_t], TYPE_VOID)

    // fs.* — the public filesystem surface returns Result[T, FsError] per
    // sections/04_effects.md:800-867; codegen redirects each to the fs_do_* wrapper. When the
    // program never imported std.fs, fs_error_tid mints the carrier WITHOUT registering the
    // name (so `FsError` stays an unknown type), yet the signature is still right — the same
    // fail-closed shape as time.read minting Instant.
    let fs_err_t = fs_error_tid()
    register_intrinsic_fn_sig("fs.read", [TYPE_STR], make_result_type(TYPE_STR, fs_err_t))
    register_intrinsic_fn_sig("fs.write", [TYPE_STR, TYPE_STR], make_result_type(TYPE_VOID, fs_err_t))
    register_intrinsic_fn_sig("fs.list_dir", [TYPE_STR], make_result_type(make_list_type(TYPE_STR), fs_err_t))
    register_intrinsic_fn_sig("fs.delete", [TYPE_STR], make_result_type(TYPE_VOID, fs_err_t))
    // FileInfo has no unimported carrier: without `import std.fs`, fs.stat has no signature.
    let file_info_t = lookup_named_type("FileInfo")
    if file_info_t != -1 {
        register_intrinsic_fn_sig("fs.stat", [TYPE_STR], make_result_type(file_info_t, fs_err_t))
    }

    // fs.errno — the last fs op's errno side-channel (0 = success). Unlike the signed
    // surface above, its type is not an open question: it is plumbing the Result wrappers
    // read, always an Int.
    register_intrinsic_fn_sig("fs.errno", [], TYPE_INT)

    register_intrinsic_fn_sig("term.isatty", [TYPE_INT], TYPE_INT)
    register_intrinsic_fn_sig("term.width", [], TYPE_INT)
    register_intrinsic_fn_sig("term.height", [], TYPE_INT)

    register_intrinsic_fn_sig("env.args", [], make_list_type(TYPE_STR))
    // env.var is the one intrinsic whose absence was a SILENT MISCOMPILE rather than a cc
    // escape: `let bad: Int = env.var("HOME")` compiled, linked, ran and printed `<value>`.
    // Option[Str] per sections/04_effects.md:705-716, where `env.var(...) ?? "8080"` and
    // `env.var("VERBOSE").is_some()` both appear.
    register_intrinsic_fn_sig("env.var", [TYPE_STR], make_option_type(TYPE_STR))
    register_intrinsic_fn_sig("env.cwd", [], TYPE_STR)
    register_intrinsic_fn_sig("env.set_var", [TYPE_STR, TYPE_STR], TYPE_VOID)
    register_intrinsic_fn_sig("env.remove_var", [TYPE_STR], TYPE_VOID)
    register_intrinsic_fn_sig("env.exit", [TYPE_INT], TYPE_NEVER)

    // ffi.scope() — the arena constructor. This table entry is what makes the
    // `with ffi.scope() as scope` binder typed: tc_bind_with_resource binds the binder to the
    // resource expression's tid, which is otherwise TYPE_UNKNOWN. Nullary, so the entry also
    // supplies the arity check. Codegen still rejects the form outside a `with` (E0819).
    register_intrinsic_fn_sig("ffi.scope", [], make_ffi_scope_type())
}

// Every variant of a str-backed enum carries a string value — `Open = "open"`. Mirrors the
// same test codegen makes when it decides to synthesize to_str/from_str
// (src/codegen_stmt.bl:8749-8765): ALL variants, not merely one, and at least one.
// Duplicated rather than shared because codegen imports typecheck, not the other way round.
fn tc_is_str_backed_enum_decl(td: Int) -> Int {
    let flds_sl = node_fields(td)
    if flds_sl == -1 { return 0 }
    let n = sublist_length(flds_sl)
    if n == 0 { return 0 }
    let mut i = 0
    while i < n {
        let v = sublist_get(flds_sl, i)
        if node_kind(v) != NodeKind.TypeVariant { return 0 }
        if node_str_val(v) == "" { return 0 }
        i = i + 1
    }
    1
}

// One synthesized-method signature, under the bare `{Type}_{method}` key both resolution
// paths already spell — the instance path at the struct/enum receiver arm, and the static
// path at the type-name receiver arm.
//
// Registered LAST, so anything a program says for itself wins: a key already taken by a user
// fn (register_fn_sig inserts the bare name as well as the module-qualified one) or by a
// trait impl (which keys `{Type}_{trait}_{method}` and is found through the method→traits
// index) is left alone. A type that both derives and hand-writes a same-named method is a
// duplicate-impl question, not this function's to answer.
fn register_derive_method_sig(tname: Str, method: Str, params: List[Int], ret: Int) {
    let key = "{tname}_{method}"
    if (fnsig_map.get(key) ?? -1) != -1 { return }
    if tc_method_trait_count(tname, method) >= 1 { return }
    register_intrinsic_fn_sig(key, params, ret)
}

// The signature of every method `@derive` synthesizes.
//
// tc_method_resolvable_on_type's clause (c) affirms these NAMES from the derive annotation on
// the type decl, but without a registered signature here a resolvability list with nothing
// behind it fails open: TYPE_UNKNOWN unifies with anything, so neither the declared type nor
// the arguments get checked (`let bad: Int = u.to_json()` would compile, link and run).
//
// A table, not one arm per method: codegen already carries one arm per derived method
// (codegen_methods.bl:5176 for structs, :5225 for enums), and typecheck reading a table is what
// keeps the two from drifting apart method by method.
//
// The types are the spec table (sections/03_types.md:2352) crossed with what codegen actually
// emits, and where those two disagree the emitted C wins, because registering anything else
// would reject programs that compile today:
//
//   * `to_json`/`from_json` are Str-typed. The spec spells `-> JsonValue` and
//     `(JsonValue) -> Result[Self, JsonError]`, but NEITHER type exists anywhere in src/ or
//     lib/ — codegen emits `const char* {T}_to_json` and
//     `blink_Result_{tag}_str {T}_from_json(const char*)` (codegen_derive.bl:159,169).
//   * `hash` agrees with the spec: registered `(self) -> U64` to match the `uint64_t {T}_hash`
//     codegen emits (codegen_derive.bl:199).
//
// `Ordering` comes from lib/std/traits.bl, so a program that never pulls it in has no tid for
// it; `cmp` is then left unregistered.
// A generic declaration's derived methods are declared over its own parameters, so the
// self type they answer with is the declaration applied to its binders. A call reads that
// at the receiver's instance, the same way a field of the declaration is read.
fn derive_self_tid(td: Int, ttid: Int) -> Int {
    let tps = node_type_params(td)
    if tps == -1 || sublist_length(tps) == 0 { return ttid }
    let mut args: List[Int] = []
    let mut i = 0
    while i < sublist_length(tps) {
        let tp = sublist_get(tps, i)
        args.push(make_typevar_bound(node_name(tp), tp))
        i = i + 1
    }
    if type_kind(ttid) == TyKind.Enum { return make_enum_instance_type(tc_instance_base_name(ttid), args) }
    make_struct_instance_type(tc_instance_base_name(ttid), args)
}

fn register_derive_method_sigs(program: Int) {
    let types_sl = node_fields(program)
    if types_sl == -1 { return }
    let ordering_t = tc_compiler_known_tid("Ordering")
    let mut i = 0
    while i < sublist_length(types_sl) {
        let td = sublist_get(types_sl, i)
        let tname = node_name(td)
        let ttid = lookup_named_type(tname)
        if ttid != -1 {
            let self_t = derive_self_tid(td, ttid)
            if tc_decl_derives(td, "Serialize") != 0 {
                register_derive_method_sig(tname, "to_json", [ttid], TYPE_STR)
            }
            if tc_decl_derives(td, "Deserialize") != 0 {
                register_derive_method_sig(tname, "from_json", [TYPE_STR], make_result_type(self_t, TYPE_STR))
            }
            if tc_decl_derives(td, "Clone") != 0 {
                register_derive_method_sig(tname, "clone", [ttid], self_t)
            }
            if tc_decl_derives(td, "Debug") != 0 {
                register_derive_method_sig(tname, "debug", [ttid], TYPE_STR)
            }
            if tc_decl_derives(td, "Eq") != 0 {
                register_derive_method_sig(tname, "eq", [ttid, ttid], TYPE_BOOL)
            }
            if tc_decl_derives(td, "Ord") != 0 && ordering_t != -1 {
                register_derive_method_sig(tname, "cmp", [ttid, ttid], ordering_t)
            }
            if tc_decl_derives(td, "Hash") != 0 {
                register_derive_method_sig(tname, "hash", [ttid], TYPE_U64)
            }
            // Every enum crosses to Int by its tag (section 3), whatever its variants carry.
            if type_kind(ttid) == TyKind.Enum {
                register_derive_method_sig(tname, "to_int", [ttid], TYPE_INT)
            }
            if tc_is_str_backed_enum_decl(td) != 0 {
                register_derive_method_sig(tname, "to_str", [ttid], TYPE_STR)
                register_derive_method_sig(tname, "from_str", [TYPE_STR], make_option_type(self_t))
            }
        }
        i = i + 1
    }
}

// The closure argument at `idx`, or -1 if absent. The closure validators below
// tolerate -1 (they no-op on a non-Closure node), so call sites need no guard.
fn closure_arg_at(args_sl: Int, idx: Int) -> Int {
    if args_sl == -1 || idx >= sublist_length(args_sl) { return -1 }
    sublist_get(args_sl, idx)
}

// Validate one explicitly-annotated closure parameter against the type the HOF
// expects there (derived from the container element type). Unannotated params
// (TYPE_UNKNOWN) and unknown expected types are skipped — annotation validation
// only; check_closure_body handles inference for the unannotated case.
fn check_closure_param(closure_node: Int, param_idx: Int, expected_t: Int, method: Str, container_label: Str) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if tc_tid_is_no_info(expected_t) != 0 { return }
    if closure_node == -1 || node_kind(closure_node) != NodeKind.Closure { return }
    let params_sl = node_params(closure_node)
    if params_sl == -1 || param_idx >= sublist_length(params_sl) { return }
    let p = sublist_get(params_sl, param_idx)
    let ptid = resolve_param_type(p)
    if tc_tid_is_no_info(ptid) != 0 { return }
    if types_compatible(ptid, expected_t) == 0 {
        tc_error_at("closure parameter {param_idx + 1} of `{container_label}.{method}` expects {type_to_str(expected_t)}, got {type_to_str(ptid)}", p)
    }
}

// Validate an explicitly-annotated closure return type against the type the HOF
// requires (e.g. Bool for filter/any/all). Skipped when the closure has no
// declared return or the expected type is unknown.
fn check_closure_ret(closure_node: Int, expected_ret: Int, method: Str, container_label: Str) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if tc_tid_is_no_info(expected_ret) != 0 { return }
    if closure_node == -1 || node_kind(closure_node) != NodeKind.Closure { return }
    let ret_str = node_return_type(closure_node)
    if ret_str == "" { return }
    let rt = resolve_type_name(ret_str)
    if rt == -1 { return }
    if types_compatible(rt, expected_ret) == 0 {
        tc_error_at("closure of `{container_label}.{method}` must return {type_to_str(expected_ret)}, got {type_to_str(rt)}", closure_node)
    }
}

// A closure's OWN written return annotation, resolved to a tid. Mirrors
// register_fn_sig's ret-resolution (:3132-3156): resolve_type_ann, then
// re-intern a generic user-struct/enum return as a structural instance carrying
// its type-arg slots via tc_fnsig_param_instance_tid, so the codegen mono seams
// read the instance tid instead of the erased bare base. TYPE_VOID when
// unannotated, matching register_fn_sig's no-`-> T` default (Principle 2: a
// closure and a named fn share one obligation). No node_return_type string
// fallback needed: parser.bl's sole Closure producer sets return_type/type_ann
// from the same node, so ret_ann == -1 iff ret_str == "".
fn tc_closure_declared_ret(cls: Int) -> Int ! TypeCheck.Resolve, Diag.Report {
    let ret_ann = node_type_ann(cls)
    if ret_ann == -1 { return TYPE_VOID }
    let mut ret_tid = resolve_type_ann(ret_ann)
    let ret_inst = tc_fnsig_param_instance_tid(ret_ann, ret_tid)
    if ret_inst != -1 { ret_tid = ret_inst }
    ret_tid
}

// The result type of a callback that carries no `-> T`, read from its BODY.
//
// tc_closure_declared_ret above answers Void for an unannotated closure on purpose: that is the
// obligation the closure's own tail is CHECKED AGAINST (Principle 2 — a closure and a named fn
// share one obligation). What a HOF hands BACK to its caller is a different question, and for
// `Bytes.with_ptr` the spec answers it with `T` — whatever the body computed
// (sections/07_trust_modules_metadata.md; `blink llms --topic "Bytes Methods"`).
//
// Reads the tid the walk already recorded for the body's tail rather than re-inferring it:
// infer_type is a write-through memo, NOT a read-through cache (infer_type_uncached always
// runs), and it REPORTS as a side effect — so a speculative re-infer here would report every
// diagnostic inside the body a second time. tc_scoped_value_memo relies on the same reasoning
// and is the sole caller of this function.
//
// DECLINES to -1 rather than guessing, so the caller keeps its own default for a body whose
// tail typecheck could not name (a memoized TYPE_UNKNOWN). The with_ptr caller binds the
// closure param to Ptr[U8] before the walk (tc_check_body's MethodCall arm), so an
// `fn(p) { p.addr() }` tail names its type and does NOT reach this decline.
fn tc_closure_body_result_tid(cls: Int, depth: Int) -> Int {
    if cls == -1 { return -1 }
    if node_kind(cls) != NodeKind.Closure { return -1 }
    let t = tc_scoped_value_memo(node_body(cls), depth + 1)
    if t < 0 { return -1 }
    if tc_tid_is_no_info(t) != 0 { return -1 }
    t
}

// The result of a `map` / `flat_map` whose closure names no `-> U`: a List or Iterator of a
// metavar that the body walk binds (tc_bind_hof_result). infer_type answers for the call
// before that walk, and again on each later pass, so the call node's own memo is reused when
// it already holds this slot — a fresh metavar per pass would leave the earlier binder's
// type holding a hole that nothing binds.
fn tc_hof_result_slot(node: Int, kind: TyKind) -> Int {
    let memo = tc_lookup_node_tid(node)
    if memo >= 0 && tc_tid_kind(memo) == kind {
        let inner = ty_pool.get(memo).unwrap().inner1
        if inner >= 0 && inner != TYPE_UNKNOWN && tc_tid_kind(inner) == TyKind.Unknown { return memo }
    }
    let alpha = make_metavar()
    if kind == TyKind.Iterator { make_iterator_type(alpha) } else { make_list_type(alpha) }
}

// What a `map` / `flat_map` argument that is a fn VALUE rather than a closure literal (a
// named fn, an fn-typed local) returns: its type already states it. -1 when the argument is a
// closure, or its return is not determined here — a generic fn's own typevar is never
// substituted at this site.
fn tc_hof_fn_value_ret(arg: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if arg == -1 || node_kind(arg) == NodeKind.Closure { return -1 }
    let r = tc_fn_tid_ret(infer_type(arg))
    if r < 0 || tc_tid_is_no_info(r) != 0 { return -1 }
    if tc_tid_has_unbound_metavar(r) != 0 || tc_tid_has_unknown(r) != 0 || tc_tid_has_foreign_typevar(r) != 0 { return -1 }
    r
}

// The element metavar of a tc_hof_result_slot memo, or -1 when the call's memo is not one
// (an annotated closure, or a named fn whose return was already known).
fn tc_hof_result_slot_elem(node: Int) -> Int {
    let memo = tc_lookup_node_tid(node)
    if memo < 0 { return -1 }
    let k = tc_tid_kind(memo)
    if k != TyKind.List && k != TyKind.Iterator { return -1 }
    let inner = ty_pool.get(memo).unwrap().inner1
    if inner < 0 || inner == TYPE_UNKNOWN || tc_tid_kind(inner) != TyKind.Unknown { return -1 }
    inner
}

// Whether a statement's value holds a type that a closure's walk has yet to bind: a call whose
// type names the open return of a closure argument that omits `-> R` (a generic binder taken
// from tc_closure_ret_slot), or the result slot of a `map` / `flat_map`. The value was inferred
// before that walk, so whatever reads the result in the same expression (an operator, a method,
// a field) met a type nothing had chosen and let it pass; the statement infers its value again
// once the walk is done. Read before the walk, which binds the slot. A closure's body is not
// searched: the walk infers its statements in their own scope.
fn tc_value_awaits_closure_ret(val: Int) -> Bool {
    if val == -1 { return false }
    let mut stack: List[Int] = [val]
    let mut kids: List[Int] = []
    while stack.len() > 0 {
        let n = stack.pop().unwrap()
        let k = node_kind(n)
        if k != NodeKind.Closure {
            if k == NodeKind.MethodCall {
                let elem = tc_hof_result_slot_elem(n)
                if elem != -1 && tc_is_unbound_metavar(elem) != 0 { return true }
            }
            if (k == NodeKind.Call || k == NodeKind.MethodCall) && tc_call_type_awaits_closure_ret(n) { return true }
            kids.clear()
            node_push_value_child_ids(n, kids)
            for kid in kids { stack.push(kid) }
        }
    }
    false
}

// Whether a call's type names the still-open return slot of a function-typed argument.
// Only a type the call took from that slot waits on the walk: a closure the call merely
// consumes (`async.spawn` reads its body, not its slot) leaves the call's type alone, and
// inferring that call again would walk the body out of its scope. The argument's type is read,
// not its node, so a closure a block or an `if` hands over counts as one written in place.
fn tc_call_type_awaits_closure_ret(call: Int) -> Bool {
    let memo = tc_lookup_node_tid(call)
    if memo < 0 || tc_tid_has_unbound_metavar(memo) == 0 { return false }
    let args_sl = node_args(call)
    if args_sl == -1 { return false }
    let n = sublist_length(args_sl)
    let mut i = 0
    while i < n {
        let mut a = sublist_get(args_sl, i)
        if node_kind(a) == NodeKind.NamedArg { a = node_value(a) }
        if a != -1 && tc_fn_ret_open_in(tc_lookup_node_tid(a), memo) { return true }
        i = i + 1
    }
    false
}

// Whether `fn_tid` is a function type whose return is an unbound metavar that `memo` holds.
fn tc_fn_ret_open_in(fn_tid: Int, memo: Int) -> Bool {
    let ret = tc_fn_tid_ret(fn_tid)
    if ret < 0 { return false }
    let slot = tc_resolve(ret)
    tc_is_unbound_metavar(slot) != 0 && tc_occurs_in(slot, memo) != 0
}

// Binds the call's result metavar to what the walked closure body produced. `bind_metavar`,
// not tc_unify: tc_unify leaves a typevar unbound in a generic body, which would report a
// `fn f[T](xs: List[T]) { xs.map(fn(x) { Some(x) }) }` as under-determined. An undeterminable
// body leaves the slot open for the E0301 boundary check; when the body already reported
// why, the slot is marked so that check does not report the same hole again.
fn tc_bind_hof_result(node: Int, cls: Int, method: Str, diag_before: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if cls == -1 || node_kind(cls) != NodeKind.Closure { return }
    if node_type_ann(cls) != -1 || node_return_type(cls) != "" { return }
    let slot = tc_hof_result_slot_elem(node)
    if slot == -1 { return }
    let ret = tc_fn_tid_ret(tc_lookup_node_tid(cls))
    let mut produced = ret
    if method == "flat_map" && ret >= 0 {
        let rk = type_kind(ret)
        if rk == TyKind.Unknown || rk == TyKind.Typevar {
            if diag_count > diag_before { tc_ud_mark_blamed(slot) }
            return
        }
        if rk != TyKind.List && rk != TyKind.Iterator {
            tc_error_at("the closure of `flat_map` must return a List or an Iterator, got {type_to_str(ret)}", cls)
            // A let binder's E0301 ignores the blamed set, so close the hole instead: this
            // error already stops the build, and an unknown element keeps uses quiet.
            bind_metavar(slot, TYPE_UNKNOWN)
            return
        }
        produced = ty_pool.get(tc_resolve(ret)).unwrap().inner1
    }
    if produced < 0 || tc_tid_is_no_info(produced) != 0 {
        if diag_count > diag_before { tc_ud_mark_blamed(slot) }
        return
    }
    if tc_is_unbound_metavar(tc_resolve(slot)) != 0 {
        bind_metavar(slot, produced)
        return
    }
    if types_compatible(tc_resolve(slot), produced) == 0 {
        tc_error_at("`{method}` is used here as producing {type_to_str(slot)}, but its closure returns {type_to_str(produced)}", cls)
    }
}

// List HOFs whose closure takes a single element-typed param. `fold` is handled
// separately (its closure takes accumulator + element).
fn is_elem_closure_hof(method: Str) -> Int {
    method == "map" || method == "filter" || method == "for_each" || method == "any" || method == "all" || method == "find" || method == "flat_map"
}

// A `sort_by` comparator with no `-> Ordering` is given both elements and walked, and then
// the type its body answers is held to `Ordering`; check_closure_ret covers one with an
// annotation. The body's own tail is read, not the closure's Fn tid, so a body that answers
// nothing is refused too. A body whose type the walk could not name is left to the error
// that says why.
fn tc_check_sort_by_body(cls: Int, elem: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if cls == -1 || node_kind(cls) != NodeKind.Closure { return }
    check_closure_body(cls, make_fn_type(TYPE_UNKNOWN, [elem, elem]))
    if node_type_ann(cls) != -1 { return }
    let ord_t = tc_compiler_known_tid("Ordering")
    if ord_t == -1 { return }
    let ret = tc_closure_body_result_tid(cls, 0)
    if ret < 0 { return }
    if types_compatible(ret, ord_t) == 0 {
        tc_error_at("closure of `List.sort_by` must return Ordering, got {type_to_str(ret)}", cls)
    }
}

// The single install point for a closure's own fn-identity: installs
// tc_current_fn_name/tc_current_fn_ret to `ret`, the return the closure's body answers to —
// its own `-> R`, or the one the context declares when the arrow is omitted
// (never the enclosing fn's, which is what every other read of these globals
// gets for free once this runs), walks the body once, and checks the implicit
// tail against that same declared return. Mirrors emit_closure's codegen
// treatment of a closure as its own fn context (src/codegen_closures.bl:868-874,
// 1028-1043, 1046-1052) — codegen already does this; typecheck never did. Shared
// by the two positions a closure body is walked from (tc_check_body's Closure arm
// and check_closure_body's HOF path below), so the tc_closure_scope_base push and
// the tc_fn_body_block one-shot marker live here exactly once instead of
// duplicated at both call sites.
// tc_current_fn_name/tc_current_fn_ret are genuinely saved and restored here;
// the tc_check_body call mutates plenty of other global state (tc_errors,
// ty_pool, ...) that this function does not save/restore around that one call,
// which the analyzer correctly flags (mirrors tc_check_fn:9052).
@allow(UnrestoredMutation, IncompleteStateRestore)
fn tc_check_closure_body_against_own_ret(cls: Int, ret: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let prev_fn_name = tc_current_fn_name
    let prev_fn_ret = tc_current_fn_ret
    tc_current_fn_name = "closure"
    tc_current_fn_ret = ret
    // codegen's expr_task_ret position reads the closure return-annotation node's tid. Publish
    // the declared return so an annotated task closure resolves off the tid instead of the flat
    // carrier; an unannotated closure has no annotation node and the emit site reads tc_void_tid().
    let cls_ret_ann = node_type_ann(cls)
    if cls_ret_ann != -1 { tc_publish_node_tid(cls_ret_ann, tc_current_fn_ret) }
    let body = node_body(cls)
    if node_kind(body) == NodeKind.Block { tc_fn_body_block = 1 }
    // Spec §3c.2: a closure body does not inherit the surrounding test-body
    // elaboration. `?` inside the closure must be gated against the closure's
    // own return type, not the test block's implicit Result[Void, TestError]
    // (mirrors nr_check_node's Closure arm, which resets this for the same reason).
    let saved_in_test = tc_in_test_body
    tc_in_test_body = 0
    tc_closure_scope_base.push(nr_scope_names.len())
    tc_check_body(body)
    let _ = tc_closure_scope_base.pop()
    tc_in_test_body = saved_in_test
    tc_check_missing_tail_value(body, tc_current_fn_ret, "closure", cls)
    tc_current_fn_name = prev_fn_name
    tc_current_fn_ret = prev_fn_ret
}

// The per-position param types of a structured TyKind.Fn tid, in declaration order.
// Empty when the tid is absent or is not a Fn, which is how "the context supplies no
// signature" is spelled — a caller then hints nothing rather than hinting a wrong type.
fn tc_fn_tid_param_hints(fn_tid: Int) -> List[Int] {
    let mut out: List[Int] = []
    if fn_tid < 0 { return out }
    let r = tc_tid_resolved(fn_tid)
    if tc_tid_kind(r) != TyKind.Fn { return out }
    // Child 0 of a Fn is its RETURN; the params start at 1 (tc_tid_child).
    let nparams = tc_tid_child_count(r) - 1
    let mut i = 0
    while i < nparams {
        let p = tc_tid_child(r, i + 1)
        out.push(if p >= 0 { p } else { TYPE_UNKNOWN })
        i = i + 1
    }
    out
}

// The RETURN of a structured TyKind.Fn tid, or -1 when the tid is absent or not a Fn.
fn tc_fn_tid_ret(fn_tid: Int) -> Int {
    if fn_tid < 0 { return -1 }
    let r = tc_tid_resolved(fn_tid)
    if tc_tid_kind(r) != TyKind.Fn { return -1 }
    tc_tid_child(r, 0)
}

// The return slot of a closure that omits `-> R`: a metavar the body walk binds, so every value
// built from the closure before the walk sees the return the body produces. The one already on
// the closure's tid is reused, bound or not; minting a second would orphan the first in any
// type that captured it.
fn tc_closure_ret_slot(cls: Int) -> Int {
    let own_ret = tc_fn_tid_ret(tc_lookup_node_tid(cls))
    if own_ret >= 0 && own_ret != TYPE_UNKNOWN && tc_tid_kind(own_ret) == TyKind.Unknown { return own_ret }
    make_metavar()
}

// The return a context DECLARES for a closure written in it, or -1 when it declares none.
//
// A HOF hint carries UNKNOWN there, and a metavar is the slot infer_type minted for the
// closure's own omitted arrow, which the body fills rather than answers to. A return naming a
// type parameter or a hole is decided per instance or by inference, so a body is not held to
// it here.
fn tc_closure_context_ret(exp_fn: Int) -> Int {
    let r = tc_fn_tid_ret(exp_fn)
    if tc_tid_is_no_info(r) != 0 { return -1 }
    if tc_tid_kind(r) == TyKind.Unknown { return -1 }
    if tc_tid_has_bare_typevar(r) != 0 || tc_tid_has_unbound_metavar(r) != 0 || tc_tid_has_unknown(r) != 0 { return -1 }
    r
}

// `async.spawn` takes `fn() -> T ! _` (sections/04_effects.md): the pool thread calls the task
// with no arguments, so any value of that type is a task, whatever expression names it, and
// the call is Handle[T]. Any other argument is reported the way a call argument that does not
// fit its parameter is. An argument whose type is not yet determined is left alone: the pass
// that leaves it open has its own report to make, and a second one here would guess.
fn tc_spawn_value_handle(arg: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let t = infer_type(arg)
    let r = tc_tid_resolved(t)
    if tc_tid_kind(r) == TyKind.Fn && tc_tid_child_count(r) == 1 {
        return make_handle_type(tc_tid_child(r, 0))
    }
    let holes = tc_tid_has_unbound_metavar(r) != 0 || tc_tid_has_unknown(r) != 0 || tc_tid_has_bare_typevar(r) != 0
    let determined = tc_tid_is_concrete(r) != 0 && !holes
    if tc_tid_kind(r) == TyKind.Fn || determined {
        tc_error_at("argument 1 of `async.spawn` expects fn() -> T, got {type_to_str(t)}", arg)
    }
    TYPE_UNKNOWN
}

// A closure literal in a position whose type the context DECLARES — a call argument against
// an fn-typed param, a `let` with an `fn(A, B) -> R` annotation — is where the expected
// signature enters. The closure node is the only place both the inference walk and the body
// walk can read it from, so the declared type is published there: infer_type's Closure arm
// re-mints from the declaration alone (UNKNOWN params, a Void default return) and keeps
// whichever of the two is more specific, so this seed survives that re-mint.
fn tc_seed_closure_expected_fn(arg0: Int, expected: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if arg0 == -1 || expected < 0 { return }
    if tc_tid_kind(tc_tid_resolved(expected)) != TyKind.Fn { return }
    // A keyword argument wraps its value; the caller has already paired it with the
    // parameter it NAMES, so the tid here is the right one to publish.
    let mut a = arg0
    if node_kind(a) == NodeKind.NamedArg { a = node_value(a) }
    if a == -1 { return }
    if node_kind(a) != NodeKind.Closure { return }
    // A generic formal (`f: fn(T, Str) -> Int`) names type parameters this call has not
    // substituted. Binding a param to a bare typevar cannot be solved later — a typevar is
    // invisible to the metavar machinery — so it would reach monomorphization unsolved. Only
    // the positions that NAME one are affected, so the seed is masked per position: dropping
    // the whole signature would leave `Str` and `Int` here undeclared as well.
    let seed = tc_fn_tid_declared_positions(expected)
    if seed < 0 { return }
    // A closure of another arity cannot take the declared type: published, it would read as
    // a fit, and the position's own compare is the one that names the arity it expects.
    let cls_params = node_params(a)
    let cls_arity = if cls_params == -1 { 0 } else { sublist_length(cls_params) }
    if cls_arity != tc_tid_child_count(tc_tid_resolved(seed)) - 1 { return }
    tc_check_closure_ann_against_declared(a, seed)
    // The closure's return slot (tc_closure_ret_slot) is what a declared return answers, and
    // what a return the declaration leaves open is: a generic formal's `-> U` then unifies with
    // the slot, and the body walk that binds it solves U, as it does for a slot a list literal
    // captured.
    let mut published = seed
    if node_type_ann(a) == -1 {
        let want_ret = tc_fn_tid_ret(seed)
        if tc_tid_is_no_info(want_ret) != 0 {
            published = make_fn_type(tc_closure_ret_slot(a), tc_fn_tid_param_hints(seed))
        } else {
            let old_ret = tc_fn_tid_ret(tc_lookup_node_tid(a))
            if old_ret >= 0 && old_ret != TYPE_UNKNOWN && tc_tid_kind(old_ret) == TyKind.Unknown {
                let _ = bind_metavar(old_ret, want_ret)
            }
        }
    }
    // A call read again after the body walk seeds the closure again; the walk's stamp names
    // the parameters the body pinned, which the masked seed leaves open.
    if tc_fn_tid_more_specific(tc_lookup_node_tid(a), published) != 0 { return }
    tc_publish_node_tid(a, published)
}

// A closure may spell a position the context has already declared. Two types for one position
// is a contradiction, and the declaration is the half every caller reads, so the closure's
// annotation is the error rather than a second opinion that silently wins.
//
// Only a position BOTH halves name is compared. One the closure leaves unwritten declares
// nothing, and one the declaration leaves open is how a generic formal reaches here — the
// caller has already masked those to TYPE_UNKNOWN.
fn tc_check_closure_ann_against_declared(cls: Int, declared_fn: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let hints = tc_fn_tid_param_hints(declared_fn)
    let params_sl = node_params(cls)
    if params_sl != -1 {
        let n = sublist_length(params_sl)
        let mut i = 0
        while i < n {
            let p = sublist_get(params_sl, i)
            if node_type_ann(p) != -1 || node_type_name(p) != "" {
                let want = hints.get(i) ?? TYPE_UNKNOWN
                let got = resolve_param_type(p)
                if tc_tid_is_no_info(want) == 0 && tc_tid_is_no_info(got) == 0 && types_compatible(want, got) == 0 {
                    let ppos = i + 1
                    tc_error_at("closure parameter {ppos} `{node_name(p)}`: declared type {type_to_str(want)} but written {type_to_str(got)}", p)
                }
            }
            i = i + 1
        }
    }
    // An omitted `-> R` is not a contradiction: tc_closure_declared_ret answers Void for it,
    // which is a default rather than something the program wrote.
    if node_type_ann(cls) == -1 { return }
    let want_ret = tc_fn_tid_ret(declared_fn)
    let got_ret = tc_closure_declared_ret(cls)
    if tc_tid_is_no_info(want_ret) != 0 || tc_tid_is_no_info(got_ret) != 0 { return }
    if types_compatible(want_ret, got_ret) != 0 { return }
    tc_error_at("closure return type: declared type {type_to_str(want_ret)} but written {type_to_str(got_ret)}", cls)
}

// Carry a declared type along the path the VALUE takes to reach the position that declared
// it, and hand it to the int literal or the closure that finally sits there. This runs before
// the value is inferred, so a literal's type and a closure's signature are known when
// inference reaches them (sections/03_types.md *Integer literal range*: the literal gets its
// type at the literal).
//
// A literal or a closure is not always written where the declaration is written. An `if` used
// as a value produces its answer from a branch tail, and a List literal produces its element
// type from its elements, so `let f: fn(Int) -> Int = if p { fn(a) { .. } } else { .. }`
// declares the type of each tail, not of the `if`. tc_expected_parts names those positions,
// and an arithmetic or bitwise operator adds its operands (*Operator operands*).
//
// Descent only: the leaves are the publishers, so a position this does not understand
// behaves exactly as it did before, and a value that is neither a literal nor a closure is
// untouched.
fn tc_seed_expected_into_value(val: Int, expected: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if dbg_channel_on("seedv") != 0 {
        dbg_trace("seedv", "enter val={val} kind={if val >= 0 { node_kind_name(node_kind(val)) } else { "<none>" }} expected={expected}")
    }
    if val == -1 || expected < 0 { return }
    let mut v = val
    if node_kind(v) == NodeKind.NamedArg { v = node_value(v) }
    if v == -1 { return }
    tc_literal_takes(v, expected)
    for p in tc_expected_parts(v, expected) {
        tc_seed_expected_into_value(p.value, p.expected)
    }
    if node_kind(v) == NodeKind.BinOp {
        let op = node_op(v)
        if is_integer_type(resolve_alias_tid(tc_resolve(expected))) == 0 { return }
        // `T`x`T`->`T` gives both operands the expected `T`. A shift's amount is U32 whatever
        // the expected type, which the BinOp arm of infer_type_uncached publishes.
        //
        // A literal beside an operand that is not one takes that operand's type instead, once
        // it is inferred (tc_literal_takes_operand), so it is not seeded: `T` would range-check
        // it against a type it does not take.
        if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" || op == "&" || op == "|" || op == "^" {
            let l = node_left(v)
            let r = node_right(v)
            let both = is_int_literal_node(l) != 0 && is_int_literal_node(r) != 0
            if both || is_int_literal_node(l) == 0 { tc_seed_expected_into_value(l, expected) }
            if both || is_int_literal_node(r) == 0 { tc_seed_expected_into_value(r, expected) }
        } else if op == "<<" || op == ">>" {
            tc_seed_expected_into_value(node_left(v), expected)
        }
        return
    }
    tc_seed_closure_expected_fn(v, expected)
}

// `fn_tid` with every position that names a type parameter replaced by TYPE_UNKNOWN, so
// inference still owns those and the remaining positions are published as declared. -1 when
// no position survives, which is how "this signature declares nothing usable here" is spelled.
fn tc_fn_tid_declared_positions(fn_tid: Int) -> Int {
    if tc_fn_tid_is_concrete(fn_tid) != 0 { return fn_tid }
    let r = tc_tid_resolved(fn_tid)
    let n = tc_tid_child_count(r)
    let mut kept = 0
    // Child 0 of a Fn is its RETURN; the params start at 1 (tc_tid_child).
    let ret0 = tc_tid_child(r, 0)
    let mut ret = TYPE_UNKNOWN
    if ret0 >= 0 && tc_tid_has_bare_typevar(ret0) == 0 {
        ret = ret0
        kept = kept + 1
    }
    let mut params: List[Int] = []
    let mut i = 1
    while i < n {
        let p = tc_tid_child(r, i)
        if p >= 0 && tc_tid_has_bare_typevar(p) == 0 {
            params.push(p)
            kept = kept + 1
        } else {
            params.push(TYPE_UNKNOWN)
        }
        i = i + 1
    }
    if kept == 0 { return -1 }
    make_fn_type(ret, params)
}

// Does every part of this Fn tid name a real type? A bare typevar anywhere means the
// signature belongs to a generic that this call site has not substituted yet.
fn tc_fn_tid_is_concrete(fn_tid: Int) -> Int {
    let r = tc_tid_resolved(fn_tid)
    let n = tc_tid_child_count(r)
    let mut i = 0
    while i < n {
        if tc_tid_has_bare_typevar(tc_tid_child(r, i)) != 0 { return 0 }
        i = i + 1
    }
    1
}

// Type-check the BODY of a closure with its params bound to the signature the CONTEXT
// expects (`exp_fn`, a TyKind.Fn tid, or -1 when no context supplies one). Unannotated
// params would otherwise bind to TYPE_UNKNOWN, so a wrong body (e.g. `Str` param used as
// `Int`) leaks past typecheck to the C compiler. When a param IS explicitly annotated we
// bind the declared type instead — this preserves Part A's annotation validation and never
// contradicts it. The body walk itself — including installing the closure's own declared
// return and the tc_closure_scope_base push — is shared with tc_check_body's Closure arm via
// tc_check_closure_body_against_own_ret.
//
// Hints are read off `exp_fn` per POSITION with no special-casing of index 0 and 1: the
// ladder that hard-coded those two positions dropped every param from index 2 on, which
// bound it to Void and emitted `void a` as a C parameter.
fn check_closure_body(cls: Int, exp_fn: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if cls == -1 || node_kind(cls) != NodeKind.Closure { return }
    nr_push_scope()
    let hints = tc_fn_tid_param_hints(exp_fn)
    let params_sl = node_params(cls)
    let mut param_types: List[Int] = []
    if params_sl != -1 {
        let nparams = sublist_length(params_sl)
        let mut i = 0
        while i < nparams {
            let pi = sublist_get(params_sl, i)
            let decl = resolve_param_type(pi)
            let hint = hints.get(i) ?? TYPE_UNKNOWN
            let mut bind = if tc_tid_is_no_info(decl) == 0 { decl } else { hint }
            // Neither an annotation nor the context chose this param's type. TYPE_UNKNOWN
            // unifies with anything and codegen erases it to `void`, so bind a fresh
            // metavar: a use in the body can still pin it, and one that stays open is
            // reported as error[CannotInferType] at the param's own span when this scope's
            // deferred blame is flushed (decisions/under-determined-types.md).
            if tc_tid_is_no_info(bind) != 0 { bind = make_metavar() }
            nr_define_typed(node_name(pi), 0, bind, pi)
            tc_publish_node_tid(pi, bind)
            param_types.push(bind)
            i = i + 1
        }
    }
    // Stamp the closure's Fn tid with the per-position param types, so codegen's
    // closure_lit_param_c reads each param off the tid (fold's Int accumulator, distinct
    // from the element type) instead of the position-blind element hint. The Fn tid minted
    // during inference left unannotated params UNKNOWN; this overwrites it.
    //
    // A closure that omits `-> R` takes R from the context when the context declares it, and
    // its body answers to that R exactly as a named fn's body answers to its own: the tail,
    // every `return e`, and a body with no tail value. Held to the Void default instead, a
    // body yielding () passed where `fn(Int) -> Int` was expected and the caller read back a
    // value nothing wrote. With no declared R the obligation stays Void, which drops the tail
    // as a named fn with no `-> R` does, and the return is read off the body after the walk.
    let cls_ret_ann = node_type_ann(cls)
    let mut obligation = tc_closure_declared_ret(cls)
    let mut stamp_ret = obligation
    // The return slot of an omitted arrow (tc_closure_ret_slot). A value built from the
    // closure before this walk (a list literal's element type) holds it, so it is bound below
    // rather than replaced, and the closure keeps it as its return.
    let mut slot = -1
    if cls_ret_ann == -1 {
        slot = tc_closure_ret_slot(cls)
        stamp_ret = slot
        let declared_ret = tc_closure_context_ret(exp_fn)
        if declared_ret >= 0 {
            obligation = declared_ret
            stamp_ret = declared_ret
        }
    }
    tc_publish_node_tid(cls, make_fn_type(stamp_ret, param_types))
    tc_check_closure_body_against_own_ret(cls, obligation)
    if cls_ret_ann != -1 {
        nr_pop_scope()
        return
    }
    if stamp_ret == slot {
        tc_settle_closure_ret(cls, slot)
    } else {
        let _ = bind_metavar(slot, stamp_ret)
    }
    // The slot, not its solution, is published: a later walk reads this tid back as `exp_fn`,
    // and a return the body itself produced must not come back as one the context declared.
    tc_publish_node_tid(cls, make_fn_type(slot, param_types))
    nr_pop_scope()
}

// The return of a closure that neither writes `-> R` nor sits where one is declared is what its
// body produces: the tail, or, when the tail leaves by another edge, the value its `return`s
// carry. Every `return e` then answers to that type as it would to a written `-> R`. A slot
// already bound — by an earlier walk of this closure, or by a use that pinned it — is the
// answer the body is held to instead.
//
// Read after the walk, off the memo, so nothing in the body is reported twice. The depth arg of
// tc_closure_body_result_tid is the tail-value recursion bound (tc_scoped_value_memo caps it at
// 8), a fresh walk from here, so it starts at 0 — NOT the closure-nesting depth.
fn tc_settle_closure_ret(cls: Int, slot: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let returns = tc_body_valued_returns(node_body(cls))
    let tail_t = tc_closure_body_result_tid(cls, 0)
    let mut ret = tc_resolve(slot)
    // Unless a use already pinned the return to (), the tail is the value the closure hands
    // back, so the walk (which checked the body against the Void default) did not compare it.
    if tc_is_unbound_metavar(ret) != 0 || (tc_tid_is_no_info(ret) == 0 && ret != TYPE_VOID) {
        tc_report_consumed_branch_mismatch(tc_value_tail_of(node_body(cls)))
    }
    // Resolved first: a slot tied to a sibling's (tc_tie_fn_rets) is bound to that slot, which
    // may itself still be open.
    if tc_is_unbound_metavar(ret) != 0 {
        // A tail that leaves by another edge, or that the walk could not name, says nothing of
        // the value; the `return`s do. With neither, the body is a statement body: the walk
        // names no value for a tail such as a match whose arms assign, and a named fn with
        // that body returns ().
        let mut found = tail_t
        if found < 0 || tc_resolve(found) == TYPE_NEVER {
            for r in returns {
                let vt = tc_lookup_node_tid(node_value(r))
                if tc_tid_is_no_info(vt) == 0 && tc_resolve(vt) != TYPE_NEVER {
                    found = vt
                    break
                }
            }
        }
        if found < 0 { found = TYPE_VOID }
        ret = found
        let _ = bind_metavar(slot, ret)
    } else if tc_tid_is_no_info(tail_t) == 0 && tc_tid_is_no_info(ret) == 0 && ret != TYPE_VOID && (types_compatible(ret, tail_t) == 0 || tc_value_misses_never_slot(ret, tail_t) != 0) {
        tc_error_at("return value type {type_to_str(tail_t)} does not match function `closure` return type {type_to_str(ret)}", cls)
    }
    // A Void return drops what a `return e` carries, as a named fn with no `-> R` does.
    if ret == TYPE_VOID || tc_tid_is_no_info(ret) != 0 { return }
    for r in returns {
        let vt = tc_lookup_node_tid(node_value(r))
        if tc_tid_is_no_info(vt) == 0 && (types_compatible(ret, vt) == 0 || tc_value_misses_never_slot(ret, vt) != 0) {
            tc_error_at("return value type {type_to_str(vt)} does not match function `closure` return type {type_to_str(ret)}", r)
        }
    }
}

// The `return e` statements of a body, not those of a closure nested in it, whose `return`
// leaves that closure. The shapes descended are tc_loop_scan_children's, which names every
// statement position a `return` can sit in.
fn tc_body_valued_returns(node: Int) -> List[Int] {
    let mut out: List[Int] = []
    if node == -1 { return out }
    let kind = node_kind(node)
    if kind == NodeKind.Return {
        if node_value(node) != -1 { out.push(node) }
        return out
    }
    if kind == NodeKind.Closure { return out }
    for kid in tc_loop_scan_children(node) {
        for r in tc_body_valued_returns(kid) { out.push(r) }
    }
    out
}

// A derived body is checked as a handler clause is, against the operation's own signature.
// It is the current fn so that name resolution and rigid typevars read this operation.
fn tc_check_derived_op(op: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let prev_fn_node = tc_current_fn_node
    tc_current_fn_node = op
    diag_enter_allows(op)
    tc_check_handler_method(op)
    diag_exit_allows()
    tc_current_fn_node = prev_fn_node
}

// The third entry point into a body that is its own fn context. A handler method
// is an ordinary parse_fn_def() FnDef node (src/parser.bl:2116) that lives in a HandlerExpr's
// `methods` sublist rather than the program's, so check_types' top-level tc_check_fn walk never
// reaches it and lookup_fnsig has no entry under its bare name. Nothing else about it is
// special: it has params to bind and its own declared return to check the body and the implicit
// tail against. Mirrors tc_check_fn with the fnsig lookup replaced by the node's own
// annotation, so `handler MyEff { fn doit() -> Int { let bad: Int = "not an int"; 2 } }` reports
// the same error the identical named fn would.
//
// tc_closure_declared_ret reads only node_type_ann, which parse_fn_def sets from the same
// parse_type_annotation() the sole Closure producer uses, so it resolves a handler method's
// return with no closure-specific behavior — including the generic-instance re-intern a
// hand-rolled resolve_type_ann here would drop.
//
// tc_current_fn_name/tc_current_fn_ret are genuinely saved and restored; the tc_check_body call
// mutates plenty of other global state (tc_errors, ty_pool, nr_* scope) that this does not save
// around it, which the analyzer correctly flags (mirrors tc_check_fn and
// tc_check_closure_body_against_own_ret).
@allow(UnrestoredMutation, IncompleteStateRestore)
fn tc_check_handler_method(m: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if m == -1 || node_kind(m) != NodeKind.FnDef { return }
    let body = node_body(m)
    if body == -1 { return }
    let mname = node_name(m)
    let prev_fn_name = tc_current_fn_name
    let prev_fn_ret = tc_current_fn_ret
    tc_current_fn_name = mname
    tc_current_fn_ret = tc_closure_declared_ret(m)

    nr_push_scope()
    let params_sl = node_params(m)
    if params_sl != -1 {
        let mut i = 0
        while i < sublist_length(params_sl) {
            let p = sublist_get(params_sl, i)
            let pname = node_name(p)
            let ptid = resolve_param_type(p)
            // Mirror tc_check_fn's param publish: lift a generic-struct/enum param to its
            // structural instance, then publish the tid on the param node so codegen's
            // expr_handler_param position reads it off the tid instead of the flat carrier.
            let ann = node_type_ann(p)
            let mut ptid_final = ptid
            if ann != -1 {
                let inst = tc_fnsig_param_instance_tid(ann, ptid)
                if inst != -1 { ptid_final = inst }
            }
            nr_define_typed(pname, 0, ptid_final, p)
            tc_publish_node_tid(p, ptid_final)
            i = i + 1
        }
    }
    // The return twin: codegen's expr_handler_ret position reads the return-annotation node's
    // tid. Publish the same tid the body was checked against (tc_current_fn_ret ==
    // tc_closure_declared_ret(m), which keeps the generic-instance re-intern a hand-rolled
    // resolve_type_ann would drop). An unannotated (void) method has no annotation node; the
    // emit site reads tc_void_tid() for that case.
    let ret_ann = node_type_ann(m)
    if ret_ann != -1 { tc_publish_node_tid(ret_ann, tc_current_fn_ret) }
    if node_kind(body) == NodeKind.Block { tc_fn_body_block = 1 }
    // Same reason as the closure walker: a handler method body is its own fn context, so `?`
    // inside it gates against this method's return type and not an enclosing test block's
    // implicit Result[Void, TestError] (spec §3c.2).
    let saved_in_test = tc_in_test_body
    tc_in_test_body = 0
    // And it is not inside any closure written around the handler: tc_current_fn_ret now names
    // this method's own return, which is what depth 0 promises.
    let saved_closure_bases = tc_closure_scope_base
    tc_closure_scope_base = []
    tc_check_body(body)
    tc_closure_scope_base = saved_closure_bases
    tc_in_test_body = saved_in_test
    tc_check_missing_tail_value(body, tc_current_fn_ret, mname, m)
    nr_pop_scope()

    tc_current_fn_name = prev_fn_name
    tc_current_fn_ret = prev_fn_ret
}

// A clause of an FS handler or an IO.Read clause fills the vtable slot of the operation it
// names, and the slot's C type is that operation's signature, so a clause must name an
// operation its effect has and take and answer exactly that operation's types (§4.4.5,
// §4.4.9). An IO literal holds the print operations too, which this does not check.
fn tc_check_builtin_handler_clause(eff_name: Str, m: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if m == -1 || node_kind(m) != NodeKind.FnDef { return }
    let root = tc_handler_effect_root(eff_name)
    let op = node_name(m)
    if root == "FS" {
        let sub = fs_op_sub_effect(op)
        if sub == "" || (eff_name != "FS" && eff_name != "FS.{sub}") {
            diag_error_at("UnresolvedMethod", UNRESOLVED_METHOD, "effect `{eff_name}` has no operation `{op}`", m,
                "the FS operations are read, write, list_dir, stat and delete (§4.4.5)")
            return
        }
        tc_check_builtin_clause_sig("FS", "fs", op, m)
        return
    }
    if root != "IO" { return }
    let reads = is_io_read_op(op)
    if eff_name == "IO.Read" && !reads {
        diag_error_at("UnresolvedMethod", UNRESOLVED_METHOD, "effect `{eff_name}` has no operation `{op}`", m,
            "the IO.Read operations are read_bytes, read_line and read_all (§4.4.9)")
        return
    }
    if !reads { return }
    if !handles_io_read(eff_name) {
        diag_error_at("UnresolvedMethod", UNRESOLVED_METHOD, "effect `{eff_name}` has no operation `{op}`", m,
            "`{op}` is an operation of IO.Read (§4.4.9)")
        return
    }
    tc_check_builtin_clause_sig("IO", "io", op, m)
}

// The clause `m` for operation `op` of builtin root `root` against the signature of the
// call `{ns}.{op}` that it answers.
fn tc_check_builtin_clause_sig(root: Str, ns: Str, op: Str, m: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let sig_idx = builtin_handler_op_sig(root, op)
    if sig_idx == -1 { return }
    let sig = fnsig_pool.get(sig_idx).unwrap()
    let mut want: List[Str] = []
    let mut i = 0
    while i < sig.params_count {
        want.push(type_to_str(fnsig_param_list.get(sig.params_start + i).unwrap()))
        i = i + 1
    }
    let spec_sig = "fn {op}({want.join(", ")}) -> {type_to_str(sig.ret)}"
    let params_sl = node_params(m)
    let n = if params_sl == -1 { 0 } else { sublist_length(params_sl) }
    if n != sig.params_count {
        tc_error_at("{root} handler clause `{op}` takes {n} parameter(s), but {ns}.{op} takes {sig.params_count}: `{spec_sig}`", m)
        return
    }
    let mut j = 0
    while j < n {
        let ptid = resolve_param_type(sublist_get(params_sl, j))
        let wtid = fnsig_param_list.get(sig.params_start + j).unwrap()
        if tc_tid_is_no_info(ptid) == 0 && !tc_tid_same_type(ptid, wtid) {
            tc_error_at("{root} handler clause `{op}` parameter {j + 1} is {type_to_str(ptid)}, but {ns}.{op} takes {type_to_str(wtid)}: `{spec_sig}`", m)
            return
        }
        j = j + 1
    }
    let rtid = tc_closure_declared_ret(m)
    if tc_tid_is_no_info(rtid) == 0 && !tc_tid_same_type(rtid, sig.ret) {
        tc_error_at("{root} handler clause `{op}` answers {type_to_str(rtid)}, but {ns}.{op} answers {type_to_str(sig.ret)}: `{spec_sig}`", m)
    }
}

// Walk the BODY of every Closure / HandlerExpr argument at a call site. infer_type validates a
// closure argument's declared annotation against the param type (Part A, check_closure_ret) but
// never visits its statements, so without this, `take(fn() { let bad: Int = "not an int" })`
// would typecheck clean and RUN, printing a Str out of an Int-declared variable — position alone
// deciding whether a closure's body got checked.
//
// `skip_idx` is the argument the caller already walked itself. The List-HOF path in the
// MethodCall arm binds arg 0 (arg 1 for `fold`) to the element/accumulator type via
// check_closure_body, which is strictly better than what this function can do for an
// unannotated param, and walking it a second time would report every diagnostic inside every
// `.map`/`.filter`/`.fold` closure twice. -1 means nothing to skip.
//
// A NamedArg wraps its value, so descend through it rather than treating a labelled closure
// argument as a non-closure.
fn tc_check_callable_arg_bodies(args_sl: Int, skip_idx: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if args_sl == -1 { return }
    let mut i = 0
    while i < sublist_length(args_sl) {
        if i != skip_idx {
            let mut a = sublist_get(args_sl, i)
            if a != -1 && node_kind(a) == NodeKind.NamedArg { a = node_value(a) }
            if a != -1 {
                let ak = node_kind(a)
                if ak == NodeKind.Closure || ak == NodeKind.HandlerExpr {
                    tc_check_body(a)
                } else {
                    // A non-callable argument can still nest a HOF whose unannotated closure
                    // needs binding and walking — `foo(a.fold(0, fn(x,y){..}))`,
                    // `io.println("{a.map(fn(x){..})}")`. Descend so that closure reaches
                    // check_closure_body instead of keeping a Void return (garbage at codegen).
                    tc_walk_nested_hof_bodies(a)
                }
            }
        }
        i = i + 1
    }
}

// A statement-position SUBEXPRESSION that its arm only inferred and never body-walked: an
// `if`/`while` condition, a `for` iterable, an assignment right-hand side. A HOF there
// (`if list_any(xs, fn(s) { ... })`, `for v in xs.filter(fn(n) { ... })`) reached
// check_closure_body from nowhere, so its closure bound no params and its body carried no
// types. Every such arm wants the same two steps in the same order, so they share one name.
// A value that reads a closure's result is inferred again once the walk has bound it.
fn tc_check_nested_value(expr: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let t = infer_type(expr)
    let reread = tc_value_awaits_closure_ret(expr)
    tc_walk_nested_hof_bodies(expr)
    if reread { return infer_type(expr) }
    t
}

// A HOF whose closure must be bound and walked (check_closure_body) can hide anywhere a value
// nests: the receiver of an outer method call (`a.map(f).collect()`), an interpolation part
// (`"{a.fold(..)}"`), a binary operand, an argument. tc_check_body's arms walk only primary
// statement positions, so a HOF in one of these positions never reached check_closure_body and
// its unannotated closure kept a Void return — silent garbage at codegen. This descends the
// value-carrying expression kinds and routes each nested MethodCall/Call to tc_check_body, which
// runs that call's own HOF closure-body walk exactly once. The MethodCall/Call arms re-infer
// nothing of their own — they reach the same per-node walk the primary arms use, for nodes those
// arms miss. The Block arm does walk the block through tc_check_body, whose tail ExprStmt re-infers
// a value the enclosing call already inferred; that is harmless, since diagnostics dedup on
// (code, span, message) and the raw error count is discarded at every caller.
fn tc_walk_nested_hof_bodies(expr: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if expr == -1 { return }
    let k = node_kind(expr)
    if k == NodeKind.MethodCall || k == NodeKind.Call {
        tc_check_body(expr)
        return
    }
    // A block-expr in a value-nested position (`take_int({ let mut s: Set[Int] = Set()  ...  s.len() })`).
    // tc_infer_value types only the block's TAIL, so the non-tail statements inside — the `let`
    // above all — never reach the LetBinding arm and their node tids stay unpublished. Codegen then
    // has no declared type to read for the block-local, so a `Set[Int]` local boxes its key at the
    // wrong width. tc_check_body walks every statement in its own scope, which is the same full walk
    // a fn-body block gets; routing here closes the one nesting position it was never reached from.
    if k == NodeKind.Block {
        tc_walk_nested_under_own_type(expr)
        return
    }
    // A closure, a handler, or a struct literal written DIRECTLY in a nested value position —
    // `inner = fn(x: Int) -> Int { x + 100 }`. These are the same three kinds the ExprStmt arm
    // walks through tc_stmt_value_walks_body, and for the same reason: infer_type types a
    // closure's signature and a struct literal's head without descending, so nothing in the
    // body or the fields was ever typed.
    if k == NodeKind.Closure || k == NodeKind.HandlerExpr || k == NodeKind.StructLit {
        tc_check_body(expr)
        return
    }
    if k == NodeKind.NamedArg || k == NodeKind.SpreadExpr {
        if !tc_is_default_fill(expr) { tc_walk_nested_hof_bodies(node_value(expr)) }
        return
    }
    // `channel.new[T](buffer: ..)` is its own node kind, not a call, so the call arms above
    // never reach its arguments.
    if k == NodeKind.ChannelNew {
        tc_check_callable_arg_bodies(node_args(expr), -1)
        return
    }
    if k == NodeKind.BinOp {
        tc_walk_nested_hof_bodies(node_left(expr))
        tc_walk_nested_hof_bodies(node_right(expr))
        return
    }
    if k == NodeKind.UnaryOp {
        tc_walk_nested_hof_bodies(node_left(expr))
        return
    }
    if k == NodeKind.FieldAccess {
        tc_walk_nested_hof_bodies(node_obj(expr))
        return
    }
    // `spawn(fn() { .. }).await` — the awaited expression holds the closure, and the operand
    // of an await lives in `obj`.
    if k == NodeKind.AwaitExpr {
        tc_walk_nested_hof_bodies(node_obj(expr))
        return
    }
    if k == NodeKind.IndexExpr {
        tc_walk_nested_hof_bodies(node_obj(expr))
        tc_walk_nested_hof_bodies(node_index(expr))
        return
    }
    if k == NodeKind.InterpString {
        let parts = node_elements(expr)
        if parts != -1 {
            let mut i = 0
            while i < sublist_length(parts) {
                let p = sublist_get(parts, i)
                if node_kind(p) != NodeKind.Ident || node_str_val(p) == "" {
                    tc_walk_nested_hof_bodies(p)
                }
                i = i + 1
            }
        }
        return
    }
    if k == NodeKind.TupleLit || k == NodeKind.ListLit {
        let els = node_elements(expr)
        if els != -1 {
            let mut i = 0
            while i < sublist_length(els) {
                tc_walk_nested_hof_bodies(sublist_get(els, i))
                i = i + 1
            }
        }
        return
    }
    if k == NodeKind.IfExpr || k == NodeKind.MatchExpr {
        tc_walk_nested_under_own_type(expr)
    }
}

// A block or branching value nested in a larger one (a tuple or list element, an argument)
// was inferred under its slot's expectation, which is its own published type. Its body is
// walked under that type rather than the enclosing value's, so a branch's bare `None` keeps it.
// @allow: the construct hint is saved and restored around the one walk below.
@allow(UnrestoredMutation)
fn tc_walk_nested_under_own_type(expr: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let saved_hint = tc_construct_hint
    let own = tc_lookup_node_tid(expr)
    if tc_tid_is_no_info(own) == 0 && tc_tid_has_unbound_metavar(own) == 0 {
        tc_construct_hint = resolve_alias_tid(own)
    }
    tc_walk_nested_value_body(expr)
    tc_construct_hint = saved_hint
}

fn tc_walk_nested_value_body(expr: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let k = node_kind(expr)
    if k == NodeKind.Block {
        tc_check_body(expr)
        return
    }
    // An `if` used as a value holds its closure in a branch, and a branch body is a Block,
    // which gets the full walk under the `if`'s own type. Without this the closure
    // in `take(if p { fn(x) { .. } } else { .. })` was never body-walked at all: its parameters
    // stayed unstamped and its return stayed Void, whatever the parameter declared.
    if k == NodeKind.IfExpr {
        tc_check_body(node_then_body(expr))
        tc_check_body(node_else_body(expr))
        return
    }
    // A `match` used as a value holds its closure in an arm, for the same reason and with the
    // same consequence. A braceless arm wraps its expression in an ExprStmt, which is a pure
    // wrapper and is stepped through here rather than everywhere, so no other position changes.
    if k == NodeKind.MatchExpr {
        let arms_sl = node_arms(expr)
        if arms_sl != -1 {
            let mut i = 0
            while i < sublist_length(arms_sl) {
                let b = node_body(sublist_get(arms_sl, i))
                if b != -1 {
                    let inner = if node_kind(b) == NodeKind.ExprStmt { node_value(b) } else { b }
                    if node_kind(inner) == NodeKind.Block { tc_check_body(inner) } else { tc_walk_nested_hof_bodies(inner) }
                }
                i = i + 1
            }
        }
        return
    }
}

// Arity- and per-argument-check a call against a structured TyKind.Fn tid, and answer its
// return type. Shared by the two callable-callee shapes, which need identical treatment and
// differ only in how the diagnostic names the callee:
//
//   * a closure VARIABLE — `let g = ..` then `g(1)` — whose Fn tid comes from local scope
//     (label "function 'g'");
//   * an immediately-invoked closure LITERAL — `fn(x: Int) -> Int { .. }(1)` — whose Fn tid
//     comes from inferring the callee node (label "closure").
//
// `got` drives the argument loop, not `expected`, so a wrong arity still type-checks every
// argument it was given instead of stopping at the first report.
// A label written at a call whose callee is a VALUE. Section 3.3 keeps labels out of the
// function type, so the type this call has says nothing about keyword parameters and there
// is no namespace here for the label to resolve in. Reported under the label rule and not
// as arity, because the parameter the label names was never dropped by the caller: the
// caller wrote it, and the type is what cannot carry it.
//
// Returns 1 when it reported, and the caller then reports nothing else. Matching the label
// against a parameter by position is what produced the second, invented type error.
fn tc_report_label_through_value(args_sl: Int, label: Str, node: Int) -> Int ! Diag.Report {
    if args_sl == -1 { return 0 }
    let argc = sublist_length(args_sl)
    let mut i = 0
    while i < argc {
        let arg = sublist_get(args_sl, i)
        if node_kind(arg) == NodeKind.NamedArg {
            diag_error_at("InvalidKeywordArg", INVALID_KEYWORD_ARG, "`{node_name(arg)}` names no keyword parameter of {label}", arg, "a function type carries no labels and no defaults, so a call through a value passes every argument positionally")
            return 1
        }
        i = i + 1
    }
    0
}

fn tc_check_call_against_fn_tid(fn_tid: Int, args_sl: Int, label: Str, node: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    // All three call sites guard with `type_kind(..) == TyKind.Fn`, which RESOLVES, so the
    // entry read here has to be the entry the guard approved. Reading the raw tid instead
    // sees a metavar's own entry: params_count 0, and inner1 the solution rather than the
    // Fn's return.
    let fn_ty = ty_pool.get(tc_tid_resolved(fn_tid)).unwrap()
    let expected = fn_ty.params_count
    let got = if args_sl != -1 { sublist_length(args_sl) } else { 0 }
    if tc_report_label_through_value(args_sl, label, node) == 1 { return fn_ty.inner1 }
    if got != expected {
        tc_error_at("{label} expects {expected} argument(s), got {got}", node)
    }
    let pstart = fn_ty.params_start
    let mut li = 0
    while li < got {
        // A call argument is expression context (§2.9): an else-less `if` passed as an
        // argument has no value on the false path. Infer in value context.
        if li < expected { tc_seed_expected_into_value(sublist_get(args_sl, li), ty_param_list.get(pstart + li).unwrap()) }
        let arg_tid = tc_infer_value(sublist_get(args_sl, li))
        if li < expected {
            let ptid = ty_param_list.get(pstart + li).unwrap()
            if tc_tid_is_no_info(arg_tid) == 0 && tc_tid_is_no_info(ptid) == 0 && types_compatible(ptid, arg_tid) == 0 {
                let (want_s, got_s) = tc_type_pair_strs(ptid, arg_tid)
                tc_type_error_naming("{label} argument {li} expects {want_s}, got {got_s}{tc_fn_mismatch_suffix(ptid, arg_tid)}", node, "", [ptid, arg_tid])
            }
        }
        li = li + 1
    }
    fn_ty.inner1
}

// ── Error reporting ─────────────────────────────────────────────────

fn tc_error(msg: Str) ! TypeCheck.Report, Diag.Report {
    tc_errors.push(msg)
    diag_error_no_loc("TypeError", TYPE_ERROR, msg, "")
}

fn tc_error_at(msg: Str, node_id: Int) ! TypeCheck.Report, Diag.Report {
    tc_errors.push(msg)
    diag_error_at("TypeError", TYPE_ERROR, msg, node_id, "")
}

// The same error under the code the rule owns. A rule the diagnostic index already names
// should report under that name; TYPE_ERROR is the code for a rule that has none. The push
// stays, so a reader counting type errors sees the same number either way.
fn tc_error_at_code(msg: Str, node_id: Int, name: Str, code: Str, help: Str) ! TypeCheck.Report, Diag.Report {
    tc_errors.push(msg)
    diag_error_at(name, code, msg, node_id, help)
}

// io.read_line() once answered Str, with "" for both a blank line and end of input, so a
// mismatch on its value says what changed and shows the match that replaces the old use. The
// help never shows `?? ""`: that form brings the old confusion back (sections/04_effects.md
// §4.4.9, "Migration").
fn tc_value_mismatch_at(msg: Str, at: Int, val: Int, want: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if !tc_read_line_used_as_str(val, want) { return tc_error_at(msg, at) }
    tc_errors.push(msg)
    diag_error_at_notes("TypeError", TYPE_ERROR, msg, at,
        "match on it: `match io.read_line() \{ Some(line) => ..., None => break }`",
        ["`io.read_line()` returns `None` at end of input and `Some(\"\")` for a blank line"])
}

// One report for an argument that does not fit its parameter, unless the closure check
// already made one for it.
fn tc_arg_mismatch(callee: Str, pos: Int, node: Int, want: Int, got: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if tc_closure_checked_against(node, want) { return }
    let (want_s, got_s) = tc_type_pair_strs(want, got)
    let msg = "argument {pos} of `{callee}` expects {want_s}, got {got_s}{tc_fn_mismatch_suffix(want, got)}"
    if tc_read_line_used_as_str(node, want) { return tc_value_mismatch_at(msg, node, node, want) }
    tc_type_error_naming(msg, node, "", [want, got])
}

fn tc_read_line_used_as_str(val: Int, want: Int) -> Bool ! TypeCheck.Resolve {
    tc_is_read_line_value(val) && resolve_alias_tid(tc_resolve(want)) == TYPE_STR
}

// A `return` and a labelled argument report at their own node, and a local reads as the
// value its `let` bound.
fn tc_is_read_line_value(val: Int) -> Bool {
    if val < 0 { return false }
    let k = node_kind(val)
    if k == NodeKind.Return || k == NodeKind.NamedArg { return tc_is_read_line_value(node_value(val)) }
    if k == NodeKind.Ident {
        let binder = tc_ident_binder_node(val)
        if binder < 0 || node_kind(binder) != NodeKind.LetBinding { return false }
        return tc_is_read_line_call(node_value(binder))
    }
    tc_is_read_line_call(val)
}

// The receiver test is the one the intrinsic arm makes: a binding named `io`, local or
// module-level, makes `io.read_line()` a call of its own method.
fn tc_is_read_line_call(val: Int) -> Bool {
    if val < 0 || node_kind(val) != NodeKind.MethodCall || node_method(val) != "read_line" { return false }
    let obj = node_obj(val)
    node_kind(obj) == NodeKind.Ident && node_name(obj) == "io" && nr_top_index("io") == -1
}

// A binding declared as T whose value is a channel `recv()`: recv answers Option[T], and the
// help names the forms that handle a closed channel before the `.unwrap()` that panics on one.
fn tc_report_declared_mismatch(msg: Str, at: Int, val: Int, declared: Int, got: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let recv_help = tc_recv_option_help(val, declared, got)
    if recv_help == "" && tc_read_line_used_as_str(val, declared) { return tc_value_mismatch_at(msg, at, val, declared) }
    let help = if recv_help != "" { recv_help } else { tc_hidden_variant_help(val, declared) }
    tc_type_error_naming(msg, at, help, [declared, got])
}

// A value that hides a variant reads as the value even where the hint names the variant's
// enum (sections/03_types.md §3.4 "Values come first"), so the mismatch there names the
// qualified variant the site likely meant. "" when the hint's enum has no variant of the name.
fn tc_hidden_variant_help(val: Int, declared: Int) -> Str {
    if val < 0 { return "" }
    let named = if node_kind(val) == NodeKind.Call { node_left(val) } else { val }
    if named < 0 || node_kind(named) != NodeKind.Ident { return "" }
    let name = node_name(named)
    match tc_bare_variant_from_type(name, None, declared) {
        BareVariantPick.Declared(_, var_idx) => "write `{node_name(evar_pool.get(var_idx).unwrap().enum_decl)}.{name}` for the variant"
        _ => ""
    }
}

fn tc_recv_option_help(val: Int, declared: Int, got: Int) -> Str ! TypeCheck.Resolve {
    if val < 0 || node_kind(val) != NodeKind.MethodCall || node_method(val) != "recv" { return "" }
    if type_kind(tc_lookup_node_tid(node_obj(val))) != TyKind.Channel { return "" }
    let r = tc_resolve(got)
    if type_kind(r) != TyKind.Option { return "" }
    if !tc_tid_same_type(ty_pool.get(r).unwrap().inner1, declared) { return "" }
    "recv answers None once the channel is closed and drained: use `ch.recv() ?? <default>`, a `match` on Some and None, or drain with `for v in ch`; write `.unwrap()` only where a value is known to be there"
}


// ── Incremental filter API ──────────────────────────────────────────

pub fn tc_set_incremental_filter(names: List[Str]) {
    tc_inc_filter = Map()
    let mut i = 0
    while i < names.len() {
        tc_inc_filter.insert(names.get(i).unwrap(), 1)
        i = i + 1
    }
    tc_inc_enabled = 1
}

pub fn tc_clear_incremental_filter() {
    tc_inc_filter = Map()
    tc_inc_enabled = 0
}

fn tc_should_check_fn(name: Str) -> Int {
    if tc_inc_enabled == 0 {
        return 1
    }
    tc_inc_filter.contains_key(name)
}

// ── Type annotation resolution ──────────────────────────────────────

// Memoize a compound-carrier tid (Option/Result/Tuple) onto its annotation node
// when it carries a generic-struct INSTANCE leaf, so the codegen pre-fn /
// let-binding pass can recurse the carrier's inners back through
// register_struct_instance_from_tid and register the boxed struct ahead of the
// carrier typedef that names it by value. Annotation nodes never reach infer_type,
// so this slot is otherwise -1. Gated on an instance leaf so a scalar carrier
// (Result[Int,Str], (Int,Str)) leaves its slot -1.
fn tc_memo_carrier_over_instance(ann_node: Int, carrier_tid: Int) {
    if ann_node < 0 || ann_node >= tc_node_tid.len() { return }
    if tc_carrier_has_instance_leaf(carrier_tid) == 0 { return }
    tc_node_tid.set(ann_node, carrier_tid)
}

// True when an Option/Result/Tuple carrier tid has (possibly nested) a struct/enum
// INSTANCE leaf (params_count >= 1). A bare struct leaf (Box, no args) or scalar
// returns 0 — those never need pre-registration.
fn tc_carrier_has_instance_leaf(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return 0 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind == TyKind.Option { return tc_leaf_is_instance_or_carrier(t.inner1) }
    if t.kind == TyKind.Result {
        if tc_leaf_is_instance_or_carrier(t.inner1) != 0 { return 1 }
        return tc_leaf_is_instance_or_carrier(t.inner2)
    }
    if t.kind == TyKind.Tuple {
        let mut i = 0
        while i < t.params_count {
            let et = ty_param_list.get(t.params_start + i).unwrap()
            if tc_leaf_is_instance_or_carrier(et) != 0 { return 1 }
            i = i + 1
        }
    }
    0
}

fn tc_leaf_is_instance_or_carrier(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return 0 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind == TyKind.Struct && t.params_count >= 1 { return 1 }
    if t.kind == TyKind.Option || t.kind == TyKind.Result || t.kind == TyKind.Tuple { return tc_carrier_has_instance_leaf(tid) }
    0
}

fn resolve_type_ann(ann_node: Int) -> Int ! TypeCheck.Resolve, Diag.Report {
    if ann_node == -1 {
        // No annotation node to read. A fresh, independently-bindable alpha, not the shared
        // give-up singleton, so an unwritten position a later use pins is not fixed as
        // "nothing is known" here.
        //
        // A metavar is NOT no-info: tc_tid_is_no_info answers 0 for it. A caller that means
        // ABSENCE — nothing has a type at this position — must therefore answer -1 itself
        // before calling, the way register_trait and tc_trait_contract_tid_check do, rather
        // than hand -1 in and expect a no-info tid back.
        return make_metavar()
    }
    resolve_type_parts(node_name(ann_node), node_elements(ann_node), ann_node)
}

// resolve_type_ann's whole body, reached by its (name, type-args) PARTS instead of by an
// annotation node — because one caller has the parts and no node. An impl header
// (`impl[T] Firstish[T] for List[T]`) stores its receiver as `name` plus a `recv_type_args`
// sublist of annotation nodes (parser.bl:2088-2091); that pair is exactly the shape this
// function already destructures out of an annotation node, so `self` gets its type from the
// same implementation every other type position uses, rather than a second dispatch that
// would drift.
//
// `ann_node` is the node to memoize onto and may be -1 when the caller has no node. Every
// use of it below is either already -1-guarded (tc_memo_carrier_over_instance:2337) or
// guarded here; nothing may pass -1 to a node accessor, which node_or_die crashes on.
// The declared type-argument arity of a type constructor named in a type
// position, or -1 when `name` is not an arity-bearing constructor (a primitive,
// a type variable, a variadic form like Tuple/Fn, or an unknown name) and so is
// not subject to error[TypeArgArity]. Builtin arities are fixed by the language;
// a user generic's arity is the number of type parameters on its declaration
// (a non-generic user type has arity 0). See sections/03_types.md §3.4.
// Bring a declaration's type parameters into scope for the span of its signature
// and body resolution, and take them back out. Counted, so nested binders that
// reuse a name restore the outer one on exit. Both are no-ops for a -1 sublist.
// An arithmetic-family trait: one whose method is what an arithmetic operator
// desugars to (Add=+, Sub=-, Mul=*, Div=/, Rem=%, Neg=unary -). Naming any of
// these in a type parameter's bound licenses arithmetic on that parameter.
fn is_arith_trait_name(n: Str) -> Int {
    if n == "Add" || n == "Sub" || n == "Mul" || n == "Div" || n == "Rem" || n == "Neg" {
        return 1
    }
    0
}

// A TypeParam / where-constraint node carries an arithmetic-family bound when any
// of its bounds (stored in `elements`) names an arithmetic trait.
// Push one bound frame per TypeParam / where-constraint node in `sl` — a frame for
// every binder (bounded or not) so an inner binder masks an outer one that reuses
// the same name (shadowing).
fn tc_push_arith_frames(sl: Int) {
    if sl == -1 { return }
    let mut i = 0
    while i < sublist_length(sl) {
        let tp = sublist_get(sl, i)
        tc_tp_frames.push(TpFrame { name: node_name(tp), binder: tp, bounds_node: tp, traits: tparam_node_bound_traits(tp), methods: "|" })
        i = i + 1
    }
}

// A `where T: Bound` frame adds bounds to a parameter an outer frame already binds, so it
// carries that parameter's binder. With the constraint node instead, a `T` written in the
// body would mint a second type distinct from the `T` of the method's own signature.
fn tc_push_where_frames(sl: Int) {
    if sl == -1 { return }
    let mut i = 0
    while i < sublist_length(sl) {
        let wc = sublist_get(sl, i)
        let binder = tc_active_binder_node(node_name(wc))
        tc_tp_frames.push(TpFrame { name: node_name(wc), binder: if binder == NO_BINDER_NODE { wc } else { binder }, bounds_node: wc, traits: tparam_node_bound_traits(wc), methods: "|" })
        i = i + 1
    }
}

// Remove the frames a matching tc_push_arith_frames(sl) or tc_push_where_frames(sl) added.
fn tc_pop_arith_frames(sl: Int) {
    if sl == -1 { return }
    let mut i = 0
    while i < sublist_length(sl) {
        let _ = tc_tp_frames.pop()
        i = i + 1
    }
}

// ── E0305: operations on `Self` in a trait default body ──────────────────────
// The guarantee-set bookkeeping. A pipe-framed string is a small set of names:
// "|" is empty, "|Add|Ord|" holds two. Membership is a substring test on "|name|".
fn tc_pipe_has(set: Str, name: Str) -> Int {
    if name == "" { return 0 }
    if set.contains("|{name}|") { return 1 }
    0
}

fn tc_pipe_add(set: Str, name: Str) -> Str {
    if name == "" { return set }
    if tc_pipe_has(set, name) != 0 { return set }
    if set == "" { return "|{name}|" }
    "{set}{name}|"
}

// Merge every member of pipe-framed `b` into `a`.
fn tc_pipe_merge(a: Str, b: Str) -> Str {
    if b == "" { return a }
    let mut acc = a
    let mut seg_start = 0
    let mut i = 0
    while i <= b.byte_len() {
        if i == b.byte_len() || b.byte_at(i) == 124 {
            if i > seg_start {
                acc = tc_pipe_add(acc, b.byte_slice(seg_start, i))
            }
            seg_start = i + 1
        }
        i = i + 1
    }
    acc
}

// The built-in traits the guarantee-set closure must know without an AST node: their
// direct supertraits and the methods they provide.
fn builtin_trait_supers(name: Str) -> Str {
    if name == "Ord" { return "Eq" }
    if name == "Hash" { return "Eq" }
    ""
}

fn builtin_trait_methods(name: Str) -> Str {
    if name == "Eq" { return "|eq|ne|" }
    if name == "Ord" { return "|cmp|" }
    if name == "Hash" { return "|hash|" }
    if name == "Add" { return "|add|" }
    if name == "Sub" { return "|sub|" }
    if name == "Mul" { return "|mul|" }
    if name == "Div" { return "|div|" }
    if name == "Rem" { return "|rem|" }
    if name == "Neg" { return "|neg|" }
    if name == "Display" { return "|fmt|display|" }
    if name == "Clone" { return "|clone|" }
    ""
}

// The traits a bound on trait `key` guarantees, each by identity: the trait and every
// supertrait, transitively (§3 "Operations on `Self` in a Default Body"). A built-in
// supertrait (Ord: Eq) lives in the compiler, a declared one in the trait's own clause.
fn tc_trait_guarantee_set(key: Str) -> Str {
    let mut set = "|"
    let mut work: List[Str] = [key]
    while work.len() > 0 {
        let t = work.pop().unwrap()
        if t.is_empty() || tc_pipe_has(set, t) != 0 { continue }
        set = tc_pipe_add(set, t)
        let builtin_super = builtin_trait_supers(t)
        if !builtin_super.is_empty() { work.push(builtin_super) }
        let tr = tc_trait_node_idx.get(t) ?? -1
        if tr == -1 { continue }
        let sup = node_supertraits(tr)
        if sup == -1 { continue }
        let mut i = 0
        while i < sublist_length(sup) {
            work.push(tc_bound_trait(sublist_get(sup, i)))
            i = i + 1
        }
    }
    set
}

// The methods the traits of a guarantee set provide.
fn tc_guarantee_methods(traits: Str) -> Str {
    let mut methods = "|"
    for t in traits.split("|") {
        if t.is_empty() { continue }
        // A builtin trait's sealed or synthesized methods (Display's `display`, Eq's `ne`)
        // live in the compiler, not the AST, even when the trait also has a node.
        methods = tc_pipe_merge(methods, builtin_trait_methods(t))
        let tr = tc_trait_node_idx.get(t) ?? -1
        if tr != -1 { methods = tc_add_node_methods(methods, tr) }
    }
    methods
}

// Whether every trait of a non-empty guarantee set has a known method list: a declaration,
// or the compiler's own list for a trait it provides.
fn tc_guarantee_lists_all_methods(traits: Str) -> Bool {
    let mut any = false
    for t in traits.split("|") {
        if t.is_empty() { continue }
        if !tc_trait_node_idx.contains_key(t) && builtin_trait_methods(t).is_empty() { return false }
        // A trait its module declares twice (E1016) may have meant the other's methods.
        if tc_trait_key_poisoned(t) { return false }
        any = true
    }
    any
}

// A pipe-framed set as the " and "-joined list a diagnostic reads.
fn tc_pipe_joined(set: Str) -> Str {
    let mut items: List[Str] = []
    for t in set.split("|") {
        if !t.is_empty() { items.push(t) }
    }
    items.join(" and ")
}

// The trait-bound set of one TypeParam / where-constraint node: the guarantee set of each
// declared bound, so `T: Ord` also licenses `==` and `U: Kid` licenses Kid's supertraits.
fn tparam_node_bound_traits(tp: Int) -> Str {
    let mut set = "|"
    let bounds = node_elements(tp)
    if bounds == -1 { return set }
    let mut i = 0
    while i < sublist_length(bounds) {
        set = tc_pipe_merge(set, tc_trait_guarantee_set(tc_bound_trait(sublist_get(bounds, i))))
        i = i + 1
    }
    set
}

fn tc_add_node_methods(set: Str, tr_node: Int) -> Str {
    let ms = node_methods(tr_node)
    if ms == -1 { return set }
    let mut acc = set
    let mut i = 0
    while i < sublist_length(ms) {
        acc = tc_pipe_add(acc, node_name(sublist_get(ms, i)))
        i = i + 1
    }
    acc
}

// Push the implicit `Self` frame for a trait's default bodies: `Self` bounded by the
// trait's guarantee set (own methods + the transitive supertrait closure's methods),
// with an arithmetic bit set when any arithmetic trait is in the closure.
fn tc_push_self_frame(tr_node: Int) {
    let traits = tc_trait_guarantee_set(tc_trait_key_of(tr_node))
    let methods = tc_guarantee_methods(traits)
    tc_tp_frames.push(TpFrame { name: "Self", binder: SELF_BINDER_NODE, bounds_node: NO_BINDER_NODE, traits: traits, methods: methods })
}

fn tc_pop_self_frame() {
    let _ = tc_tp_frames.pop()
}

// The innermost active binding of `name`: its pipe-framed trait set / method set, or
// "" if `name` is not an active type parameter.
fn tc_tparam_bound_traits(name: Str) -> Str {
    let mut i = tc_tp_frames.len() - 1
    while i >= 0 {
        let f = tc_tp_frames.get(i).unwrap()
        if f.name == name { return f.traits }
        i = i - 1
    }
    ""
}

fn tc_tparam_bound_methods(name: Str) -> Str {
    let mut i = tc_tp_frames.len() - 1
    while i >= 0 {
        let f = tc_tp_frames.get(i).unwrap()
        if f.name == name { return f.methods }
        i = i - 1
    }
    ""
}

// The arithmetic trait an operator desugars to (§3.6). Binary `-` maps to Sub, but
// unary `-` maps to Neg — they share the `-` spelling, so the caller says which.
fn arith_backing_trait(op: Str, is_unary: Int) -> Str {
    if op == "+" { return "Add" }
    if op == "*" { return "Mul" }
    if op == "/" { return "Div" }
    if op == "%" { return "Rem" }
    if is_unary != 0 { return "Neg" }
    "Sub"
}

// W1010 at a trait that shadows a compiler-known one, with the forms in this module that
// still use the compiler-known trait and the alias import that names it (sections/07 §10.6).
fn tc_warn_shadowed_trait(tr: Int) ! Diag.Report {
    let name = node_name(tr)
    let mut notes = ["shadows compiler-known trait `{name}` (blink.core)"]
    for n in tc_desugaring_forms_note(name, "blink.core") { notes.push(n) }
    let alias = tc_core_alias_in(name, node_module(tr))
    let help = if alias == "" {
        "to use the compiler-known trait in this module, import it under another name:\nimport blink.core.\{{name} as Core{name}\}"
    } else {
        "this module names the compiler-known trait `{alias}`"
    }
    diag_warn_at_notes("ShadowedPreludeName", SHADOWED_PRELUDE_NAME, "name shadows compiler-known trait", tr, help, notes)
}

// W1010 at a declaration outside the prelude that takes a shadowable compiler-known type name
// (sections/07 §10.6). The prelude's own declarations of Ordering and ConversionError are the
// builtins themselves.
fn tc_warn_shadowed_type(decl: Int) ! Diag.Report {
    let name = node_name(decl)
    let (home, spelled) = tc_shadowable_type(name)
    if home == "" || tc_prelude_modules.contains_key(node_module(decl)) { return }
    let mut notes = ["shadows compiler-known type `{spelled}` ({home})"]
    for n in tc_desugaring_forms_note(name, home) { notes.push(n) }
    let help = tc_shadowed_type_help(name, home, node_module(decl))
    diag_warn_at_notes("ShadowedPreludeName", SHADOWED_PRELUDE_NAME, "name shadows compiler-known type", decl, help, notes)
}

// The help that reaches the compiler-known type `name` from `home` in module `in_mod`: the
// alias the module already imports, or the aliased import that would name it.
fn tc_shadowed_type_help(name: Str, home: Str, in_mod: Str) -> Str {
    let alias = tc_core_type_alias_in(name, in_mod)
    if alias != "" { return "this module names the compiler-known type `{alias}`" }
    let prefix = if home == "blink.ffi" { "Ffi" } else { "Core" }
    "to use the compiler-known type in this module, import it under another name:\nimport {home}.\{{name} as {prefix}{name}\}"
}

// The declaration of `tid` when it is a type outside the prelude that takes a shadowable
// compiler-known name, else -1.
fn tc_shadowing_type_decl(tid: Int) -> Int {
    let d = tc_tid_decl_node(tid)
    if d < 0 || tc_prelude_modules.contains_key(node_module(d)) { return -1 }
    if tc_shadowable_type_home(node_name(d)) == "" { return -1 }
    d
}

// Whether the bare type name `name`, read in the module under check, means the declaration `d`.
fn tc_name_means_decl_here(name: Str, d: Int) -> Bool {
    if tc_compiler_known_type_meant(name, -1) != "" { return false }
    let t = lookup_named_type(name)
    t >= 0 && tc_tid_decl_node(t) == d
}

// An error whose subjects are the types `tids`. Each subject that shadows a compiler-known
// type adds a note with the shadowing declaration's location and the builtin's home, and the
// W1010 help, so the escape shows where the error is (sections/07 §10.6, Diagnostics that
// involve a shadowing name, rule 2). The help is for the module being checked, which may
// import the shadowing type from the module that declares it.
fn tc_error_naming_types(name: Str, code: Str, msg: Str, at: Int, help: Str, tids: List[Int]) ! Diag.Report {
    let mut notes: List[Str] = []
    let mut helps: List[Str] = if help == "" { [] } else { [help] }
    let mut seen: List[Int] = []
    for t in tids {
        let d = tc_shadowing_type_decl(t)
        if d < 0 || seen.contains(d) { continue }
        seen.push(d)
        let tname = node_name(d)
        // Where the bare name means the builtin or another declaration, this one shadows
        // nothing here, and the pair the message prints already tells the types apart.
        if !tc_name_means_decl_here(tname, d) { continue }
        let (home, spelled) = tc_shadowable_type(tname)
        let site = "{diag_normalize_path(diag_file_for_node(d))}:{node_line(d)}"
        notes.push("`{tname}` here is `type {tname}` ({site}), which shadows the compiler-known `{spelled}` ({home})")
        let h = tc_shadowed_type_help(tname, home, nr_current_module)
        if !helps.contains(h) { helps.push(h) }
    }
    if notes.len() == 0 { return diag_error_at(name, code, msg, at, help) }
    diag_error_at_notes(name, code, msg, at, helps.join("\n"), notes)
}

// A type mismatch under TYPE_ERROR, counted as tc_error_at counts one, with the notes
// tc_error_naming_types adds for `tids`.
fn tc_type_error_naming(msg: Str, at: Int, help: Str, tids: List[Int]) ! TypeCheck.Report, Diag.Report {
    tc_errors.push(msg)
    tc_error_naming_types("TypeError", TYPE_ERROR, msg, at, help, tids)
}

// Two types an error names side by side. When both spell the same name and are different
// types, each prints as `Name (module)`, so the reader can tell them apart (sections/07 §10.6,
// Diagnostics that involve a shadowing name, rule 3).
fn tc_type_pair_strs(a: Int, b: Int) -> (Str, Str) {
    let sa = type_to_str(a)
    let sb = type_to_str(b)
    if !tc_types_share_name(a, b) { return (sa, sb) }
    (tc_type_with_home(a, sa), tc_type_with_home(b, sb))
}

fn tc_types_share_name(a: Int, b: Int) -> Bool {
    let head = tc_type_head_name(a)
    // Box[Int] against Box[Str] is one declaration, and the arguments already tell them apart.
    head != "" && head == tc_type_head_name(b) && tc_tid_decl_node(a) != tc_tid_decl_node(b)
}

// The bare name `tid` is spelled with, without its module or its arguments, or "" for a type
// no declaration or compiler-known name spells.
fn tc_type_head_name(tid: Int) -> Str {
    let d = tc_tid_decl_node(tid)
    if d >= 0 { return node_name(d) }
    let k = type_kind(tc_resolve(tid))
    if k == TyKind.Struct || k == TyKind.Enum || k == TyKind.Fn || k == TyKind.Tuple { return "" }
    if k == TyKind.Unknown || k == TyKind.Typevar { return "" }
    let s = type_to_str(tid)
    match s.byte_index_of("[", 0) {
        Some(i) => s.byte_slice(0, i)
        None => s
    }
}

// `shown` (how type_to_str renders `tid`) with the module that declares it: `main` or the
// module path for a declaration, and the §10.6 home for a compiler-known type.
fn tc_type_with_home(tid: Int, shown: Str) -> Str {
    let d = tc_tid_decl_node(tid)
    if d < 0 {
        let home = tc_shadowable_type_home(tc_type_head_name(tid))
        return if home == "" { shown } else { "{shown} ({home})" }
    }
    let args = match shown.byte_index_of("[", 0) {
        Some(i) => shown.byte_slice(i, shown.byte_len())
        None => ""
    }
    let bare = "{node_name(d)}{args}"
    if tc_prelude_modules.contains_key(node_module(d)) {
        let home = tc_shadowable_type_home(node_name(d))
        let shown_home = if home == "" { "blink.core" } else { home }
        return "{bare} ({shown_home})"
    }
    tc_name_with_module(bare, node_module(d))
}

// The W1010 note that lists the forms which go on using the compiler-known `name` from `home`
// in a module that shadows it, or none when no form does.
fn tc_desugaring_forms_note(name: Str, home: Str) -> List[Str] {
    let forms = tc_desugaring_forms(name)
    if forms.len() == 0 { return [] }
    let last = forms.get(forms.len() - 1).unwrap()
    let listed = if forms.len() == 1 { "{last} in this module still uses" } else {
        "{forms.slice(0, forms.len() - 1).join(", ")} and {last} in this module still use"
    }
    ["{listed} `{name}` ({home})"]
}

// The forms a desugaring writes with the compiler-known trait or type `tr`, which go on using
// it in a module that shadows `tr` (sections/03 §3.4 Hygiene, and the Used by column of
// Prelude Traits in sections/07). W1010 reads only this list; the arithmetic rows come from
// arith_backing_trait, and the rest must change with the desugaring they name. `@derive` is
// never one: its argument resolves by scope. A row with one form spells it in the singular,
// since the note's verb agrees with the count.
fn tc_desugaring_forms(tr: Str) -> List[Str] {
    let mut forms: List[Str] = []
    for op in ["+", "-", "*", "/", "%"] {
        if arith_backing_trait(op, 0) == tr { forms.push("`{op}`") }
    }
    if arith_backing_trait("-", 1) == tr { forms.push("unary `-`") }
    match tr {
        "Eq" => ["`==`", "`!=`", "`assert_eq`", "`assert_ne`", "Map/Set keys"]
        "Ord" => ["`<`", "`>`", "`<=`", "`>=`"]
        "Hash" => ["a Map/Set key"]
        "Debug" => ["`assert_eq`", "`assert_ne`"]
        "Display" => ["string interpolation"]
        "From" => ["the `.into()` that `From` derives"]
        "Into" => ["`.into()`"]
        "IntoIterator" => ["a `for` loop"]
        "Closeable" => ["`with`"]
        "List" => ["`[T]`", "a list literal"]
        "Option" => ["`T?`", "`??`", "`?`"]
        "Ordering" => ["`<`", "`>`", "`<=`", "`>=`"]
        "Result" => ["`?`"]
        "Iterator" => ["a `for` loop"]
        "Range" => ["`..`", "`..=`"]
        "Handler" => ["`with`"]
        "Handle" => ["`async.spawn`"]
        "Template" => ["a template literal"]
        "ConversionError" => ["`parse_int`", "`parse_float`", "`Char.from_code_point`", "`try_from`"]
        _ => forms
    }
}

fn arith_backing_method(op: Str, is_unary: Int) -> Str {
    if op == "+" { return "add" }
    if op == "*" { return "mul" }
    if op == "/" { return "div" }
    if op == "%" { return "rem" }
    if is_unary != 0 { return "neg" }
    "sub"
}

// The comparison licensing check for an operand of a type-parameter type:
// relational ops (`<` `>` `<=` `>=`) desugar to Ord.cmp, equality (`==` `!=`) to Eq.eq.
// Licensed only when the backing trait is in the parameter's declared bound set; Ord
// licenses equality too (Ord's Eq supertrait). `Self` in a trait default body reports
// against the trait definition with the supertrait fix (E0305); any other type
// parameter reports the missing bound (E0300). Fails open only when the name is not an
// active type parameter (unmodeled builtin lowered to a typevar) — matching the
// arithmetic check (reject_non_numeric_arith_operand).
fn reject_unlicensed_comparison(op: Str, tid: Int, node: Int) ! TypeCheck.Report, Diag.Report {
    if type_kind(resolve_alias_tid(tid)) != TyKind.Typevar { return }
    let name = type_to_str(tid)
    let traits = tc_tparam_bound_traits(name)
    if traits == "" { return }
    let relational = if op == "==" || op == "!=" { 0 } else { 1 }
    if relational != 0 {
        if tc_pipe_has(traits, "Ord") != 0 { return }
    } else {
        if tc_pipe_has(traits, "Eq") != 0 || tc_pipe_has(traits, "Ord") != 0 { return }
    }
    let bt = if relational != 0 { "Ord" } else { "Eq" }
    let bm = if relational != 0 { "Ord.cmp" } else { "Eq.eq" }
    if name == "Self" {
        let imp = tc_core_import_in(bt, nr_current_module)
        let lead = if imp == "" { "" } else { "{imp}\nthen " }
        diag_error_at_notes("UnlicensedSelfOperation", UNLICENSED_SELF_OP,
            "`{op}` on `Self` is not licensed by `{tc_current_self_trait}` (`{op}` desugars to {bm}, but `{tc_current_self_trait}` does not require {tc_core_trait_shown(bt)})", node,
            "{lead}declare the supertrait so every implementor provides `{op}`: trait {tc_current_self_trait}: {tc_core_name_in(bt, nr_current_module)} \{ ... \}",
            tc_shadowed_trait_notes(bt))
        return
    }
    if tc_report_shadowed_operator_bound(op, name, bt, bt, traits, node) { return }
    if relational == 0 && tc_report_shadowed_operator_bound(op, name, bt, "Ord", traits, node) { return }
    let help = if tc_shadowing_trait_key(bt, nr_current_module) == "" {
        "add a comparison bound so the operation is licensed, e.g. `[{name}: {bt}]`"
    } else {
        tc_core_bound_fix(bt, name)
    }
    diag_error_at_notes("TypeError", TYPE_ERROR,
        "comparison `{op}` requires a trait bound on type parameter {name} (`{op}` desugars to {bm})", node, help,
        tc_shadowed_trait_notes(bt))
}

// An operator on a type parameter whose bounds give a local trait that shadows `bound_tr`:
// the bound looks right and is not, so the error names both traits and gives the bound that
// reaches the compiler-known `need` (sections/07 §10.6). `need` and `bound_tr` differ only
// for `==` under an Ord bound, since Ord licenses equality.
fn tc_report_shadowed_operator_bound(op: Str, tpname: Str, need: Str, bound_tr: Str, traits: Str, node: Int) -> Bool ! Diag.Report {
    for key in traits.split("|") {
        if key.starts_with("{bound_tr}@") {
            let local = tc_trait_shown(key)
            diag_error_at_notes("TypeError", TYPE_ERROR,
                "`{op}` on {tpname} needs `{need} (blink.core)`, but the bounds on {tpname} give only `{local}`", node,
                tc_core_bound_fix(need, tpname),
                ["`{local}` and `{bound_tr} (blink.core)` are different traits with the same name; `{op}` uses `{need} (blink.core)`"])
            return true
        }
    }
    false
}

fn tc_push_tparam_scope(tparams_sl: Int) {
    if tparams_sl == -1 { return }
    let mut i = 0
    while i < sublist_length(tparams_sl) {
        let nm = node_name(sublist_get(tparams_sl, i))
        tc_active_tparams.insert(nm, (tc_active_tparams.get(nm) ?? 0) + 1)
        i = i + 1
    }
    tc_push_arith_frames(tparams_sl)
}

fn tc_pop_tparam_scope(tparams_sl: Int) {
    if tparams_sl == -1 { return }
    tc_pop_arith_frames(tparams_sl)
    let mut i = 0
    while i < sublist_length(tparams_sl) {
        let nm = node_name(sublist_get(tparams_sl, i))
        let c = tc_active_tparams.get(nm) ?? 0
        if c <= 1 {
            let _ = tc_active_tparams.remove(nm)
        } else {
            tc_active_tparams.insert(nm, c - 1)
        }
        i = i + 1
    }
}

fn tc_ctor_arity(name: Str) -> Int {
    tc_ctor_arity_meaning(name, tc_compiler_known_type_meant(strip_module_qualifier(name), -1))
}

// The arity of `name` where it means the compiler-known type `core`, or a declaration when
// `core` is "".
fn tc_ctor_arity_meaning(name: Str, core: Str) -> Int {
    let n = strip_module_qualifier(name)
    // A type parameter in scope is a type variable, not a constructor: a bare
    // reference to it is well-formed and carries no arity to check (§3.4:1259).
    if (tc_active_tparams.get(n) ?? 0) > 0 { return -1 }
    if core != "" { return tc_compiler_known_ctor_arity(core) }
    let decl = tc_type_decl_nodes.get(tc_written_type_nominal(n)) ?? -1
    if decl == -1 { return -1 }
    let tps = node_type_params(decl)
    if tps == -1 { return 0 }
    sublist_length(tps)
}

// The arity of the compiler-known type `core`: its builtin row, else its prelude declaration's
// (Ordering, ConversionError), else the §10.6 table's for a type no module declares.
fn tc_compiler_known_ctor_arity(core: Str) -> Int {
    let builtin = tc_builtin_ctor_arity(core)
    if builtin != -1 { return builtin }
    let decl = tc_prelude_type_decl(core)
    if decl != -1 {
        let tps = node_type_params(decl)
        return if tps == -1 { 0 } else { sublist_length(tps) }
    }
    match core {
        "Range" => 1
        "Buf" => 1
        "TemplateValue" => 0
        _ => -1
    }
}

// The arity of a compiler-known type constructor, or -1 for any other name.
fn tc_builtin_ctor_arity(n: Str) -> Int {
    // A bare `Ptr` names no pointee, and the resolve arm would hand back Ptr over the give-up
    // type, which no later pass can spell.
    if n == "List" || n == "Option" || n == "Set" || n == "Channel" || n == "Handle" || n == "Iterator" || n == "Ptr" {
        return 1
    }
    if n == "Map" || n == "Result" {
        return 2
    }
    // `Self` names the receiver and takes no type arguments of its own
    // (sections/03_types.md §"The `Self` Type"). The `Self` arm in resolve_type_parts
    // answers with the receiver and ignores its argument list, so without this row
    // `Self[Int]` is silently accepted as the bare receiver with the arguments dropped.
    // Arity 0 makes the over-application a reported error instead.
    if n == "Self" { return 0 }
    // The 0-arity scalars: a bare name is correct, any application over-applies.
    // Tuple/Fn/Handler/Template are left to fall through (variadic,
    // FFI-shaped, or resolved by another rule) so E0303 never fires on them here.
    if n == "Int" || n == "Float" || n == "F32" || n == "F64" || n == "Bool" || n == "Str" {
        return 0
    }
    if n == "Void" || n == "Never" || n == "Bytes" || n == "Char" || n == "StringBuilder" {
        return 0
    }
    if n == "U8" || n == "U16" || n == "U32" || n == "U64" || n == "I8" || n == "I16" || n == "I32" || n == "I64" {
        return 0
    }
    -1
}

// The case-specific repair, whose first `help:` line is normative
// (sections/03_types.md §3.4:1255-1264). Four cases keyed on the mismatch shape:
// over-application removes; a bare constructor with a type parameter already in
// scope applies that parameter; a bare constructor with none declares one; a
// partially-applied constructor supplies what is missing. The binder-declaring
// repair is offered only when bare AND no in-scope parameter can fill the slot.
fn tc_arity_help(n: Str, want: Int, got: Int) -> Str {
    if got > want {
        return "remove the extra type argument(s); `{n}` takes exactly {want}"
    }
    if got == 0 {
        let ks = tc_active_tparams.keys()
        if ks.len() > 0 {
            return "apply the type parameter in scope, e.g. `{n}[{ks.get(0).unwrap()}]`"
        }
        return "declare a type parameter and apply it, e.g. `{n}[T]`"
    }
    "supply the missing type argument(s); `{n}` takes exactly {want}"
}

// error[TypeArgArity] (E0303): a type constructor in a type position must be
// applied to exactly its declared arity. Under-application — of which a bare
// name (0 args) is the extreme — and over-application are one failure. Decided
// here at name resolution, from the declaration alone, before inference runs.
fn tc_check_type_arg_arity(name: Str, core: Str, elems_sl: Int, ann_node: Int) ! Diag.Report {
    let want = tc_ctor_arity_meaning(name, core)
    if want == -1 { return }
    let got = if elems_sl == -1 { 0 } else { sublist_length(elems_sl) }
    if got == want { return }
    let n = strip_module_qualifier(name)
    let subjects: List[Int] = if core != "" { [] } else { [lookup_named_type(name)] }
    tc_error_naming_types("TypeArgArity", TYPE_ARG_ARITY, "type constructor `{n}` takes {want} type argument(s) but {got} were given", ann_node, tc_arity_help(n, want, got), subjects)
}

// resolve_type_parts' answer where the annotation means the compiler-known type `name`, or -1
// when `name` has no arm here and resolves as a declared or primitive name.
fn tc_resolve_compiler_known_type(name: Str, elems_sl: Int, ann_node: Int) -> Int ! TypeCheck.Resolve, Diag.Report {
    // `Self` is a built-in type ALIAS for the type being implemented (sections/03_types.md
    // §"The `Self` Type"), so inside an impl block it lowers to the receiver's tid — the same
    // answer `self` already gets. Resolved here, at the single lowering site every type
    // position goes through, so `-> Self`, `other: Self`, `-> Option[Self]` and `-> List[Self]`
    // all get it from one implementation; the container arms below recurse back in here.
    //
    // Inside a TRAIT declaration there is no receiver yet, so `Self` stays the abstract type
    // variable that subst_trait_type_tid binds per impl. tc_current_self_tid is the gate: the
    // impl walk sets it to the receiver, the trait default-body walk sets it to that same
    // abstract typevar, and it is -1 everywhere else. First, so no user name can take `Self`.
    if name == "Self" {
        if tc_current_self_tid != -1 { return tc_current_self_tid }
        return make_typevar(name)
    }
    if name == "List" {
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            let inner = resolve_type_ann(sublist_get(elems_sl, 0))
            return make_list_type(inner)
        }
        return make_list_type(TYPE_UNKNOWN)
    }
    if name == "Option" {
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            let inner = resolve_type_ann(sublist_get(elems_sl, 0))
            let opt = make_option_type(inner)
            tc_memo_carrier_over_instance(ann_node, opt)
            return opt
        }
        return make_option_type(TYPE_UNKNOWN)
    }
    if name == "Result" {
        if elems_sl != -1 && sublist_length(elems_sl) >= 2 {
            let ok_t = resolve_type_ann(sublist_get(elems_sl, 0))
            let err_t = resolve_type_ann(sublist_get(elems_sl, 1))
            let res = make_result_type(ok_t, err_t)
            tc_memo_carrier_over_instance(ann_node, res)
            return res
        }
        return make_result_type(TYPE_UNKNOWN, TYPE_UNKNOWN)
    }
    if name == "Map" {
        if elems_sl != -1 && sublist_length(elems_sl) >= 2 {
            let key_ann = sublist_get(elems_sl, 0)
            let key_t = resolve_type_ann(key_ann)
            let val_t = resolve_type_ann(sublist_get(elems_sl, 1))
            if tc_suppress_ann_validation == 0 {
                validate_keyed_ann(key_ann, HashRole.MapKey)
                tc_refuse_unhashable_instance(key_t, key_ann, HashRole.MapKey)
            }
            return make_map_type(key_t, val_t)
        }
        return make_map_type(TYPE_UNKNOWN, TYPE_UNKNOWN)
    }
    if name == "Set" {
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            let elem_ann = sublist_get(elems_sl, 0)
            let elem_t = resolve_type_ann(elem_ann)
            if tc_suppress_ann_validation == 0 {
                validate_keyed_ann(elem_ann, HashRole.SetElement)
                tc_refuse_unhashable_instance(elem_t, elem_ann, HashRole.SetElement)
            }
            return make_set_type(elem_t)
        }
        return make_set_type(TYPE_UNKNOWN)
    }
    if name == "Tuple" {
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            let mut elem_types: List[Int] = []
            let mut i = 0
            while i < sublist_length(elems_sl) {
                elem_types.push(resolve_type_ann(sublist_get(elems_sl, i)))
                i = i + 1
            }
            let tup = make_tuple_type(elem_types)
            tc_memo_carrier_over_instance(ann_node, tup)
            return tup
        }
    }
    if name == "Bytes" {
        return new_type(TyKind.Bytes, "Bytes")
    }
    // Written in a type position at all — parameter, return, field, type argument, let
    // annotation — is already the mistake: the one position the type may occupy is a
    // `with ... as` resource, whose binder is never annotated.
    if name == "FfiScope" {
        if ann_node != -1 { tc_report_ffi_scope_ann(ann_node) }
        return make_ffi_scope_type()
    }
    if name == "Raw" {
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            return make_raw_type(resolve_type_ann(sublist_get(elems_sl, 0)))
        }
        return make_raw_type(TYPE_UNKNOWN)
    }
    // The three one-inner runtime carriers. Ahead of resolve_type_name for the
    // same reason List/Map/Set are: is_primitive_type already claims these names, so a user
    // type could not have taken them, and falling through to `make_typevar(name)` is what made
    // an ANNOTATED channel un-iterable — tc_check_body's deferred-iterable test asks
    // `iter_tk == TyKind.Channel`, which a typevar is not, so `let ch: Channel[Int] = channel.new[Int](buffer: 4)`
    // followed by `for v in ch` drew E0302 while the unannotated program compiled.
    if name == "Handle" {
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            return make_handle_type(resolve_type_ann(sublist_get(elems_sl, 0)))
        }
        return make_handle_type(TYPE_UNKNOWN)
    }
    if name == "Channel" {
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            return make_channel_type(resolve_type_ann(sublist_get(elems_sl, 0)))
        }
        return make_channel_type(TYPE_UNKNOWN)
    }
    // The sealed iterator carrier (§3c.1:38). Ahead of resolve_type_name for the same reason
    // Channel is: is_primitive_type claims the name, and falling through to make_typevar("Iterator")
    // is what degraded `let it: Iterator[Int] = ...` to a bare typevar that unified with anything.
    if name == "Iterator" {
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            return make_iterator_type(resolve_type_ann(sublist_get(elems_sl, 0)))
        }
        return make_iterator_type(TYPE_UNKNOWN)
    }
    // The fourth carrier for the same reason. `Ptr` is claimed by
    // is_primitive_type (:6486) so no user type could have taken the name, and falling through
    // to make_typevar("Ptr") is what let `let r: Ptr[Int] = buf` (buf: Ptr[Pollfd]) reach the C
    // compiler as `int64_t* r = buf` — a cc error with no Blink span.
    //
    // The pointee recurses through resolve_type_ann rather than being read as a name, so
    // `Ptr[Ptr[Void]]` nests properly. The pointee rule (E0810) is checked here, on the
    // resolved tid, because every position a type can be written in resolves through here.
    if name == "Ptr" {
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            let inner = sublist_get(elems_sl, 0)
            let pointee = resolve_type_ann(inner)
            tc_check_ptr_pointee(pointee, inner)
            return make_ptr_type(pointee)
        }
        return make_ptr_type(TYPE_UNKNOWN)
    }
    // The fifth carrier and the same reason again — see make_template_type. The
    // phantom recurses through resolve_type_ann like every other carrier's child, so a
    // context that IS a real type resolves to it; the spec's own contexts are effect names,
    // which are not types, so those land on a typevar named for the effect. Either way the
    // context is kept rather than discarded with the whole type. A `type Template` declared
    // in scope takes the name instead, and resolves below like any declared type.
    if name == "Template" {
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            return make_template_type(resolve_type_ann(sublist_get(elems_sl, 0)))
        }
        return make_template_type(TYPE_UNKNOWN)
    }
    // `fn(A, B) -> R` is placed here for the same reason as the three carriers
    // above: "Fn" is a reserved type name (is_primitive_type claims it), so no user type
    // could have taken it, and falling through to `make_typevar("Fn")` is what made an
    // ANNOTATED closure both structureless and unsound — a bare typevar unifies with
    // anything, so `let bad: fn(Int) -> Int = 5` typechecked clean.
    //
    // parser.bl:1447 puts the param annotations in `elements` and the return annotation in
    // `type_ann`, leaving type_ann == -1 (with return_type "Void") when the arrow is absent.
    // TYPE_VOID for that case, not TYPE_UNKNOWN: it matches tc_closure_declared_ret and the
    // named-fn default, and Void is an ordinary inhabited type, not an unsolved one
    // (decisions/under-determined-types.md).
    // `Handler[E]` belongs beside Fn: falling through to `make_typevar("Handler")` made an
    // ANNOTATED handler both structureless and unsound. Unlike Fn the name is not reserved: a
    // `type Handler` declared in scope takes it, and resolves below like any declared type.
    // The parser puts the effect in `elements` (parser.bl:1478) as a TypeAnn node whose NAME
    // is the effect — the effect is not a type, so the name is read directly rather than
    // resolved.
    //
    // A bare `Handler` with no `[E]` keeps the old typevar answer on purpose: it is not a type
    // anyone can write (the parser only builds this node from `handler[...]`), so minting a
    // handler-of-no-effect would invent an identity for a shape that cannot occur, and a typevar
    // is the honest "no information" answer if some path reaches here anyway.
    if name == "Handler" {
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            let eff = node_name(sublist_get(elems_sl, 0))
            if eff != "" { return make_handler_type(eff) }
        }
        return make_typevar(name)
    }
    if name == "Fn" {
        let ret_ann = if ann_node == -1 { -1 } else { node_type_ann(ann_node) }
        let ret_t = if ret_ann == -1 { TYPE_VOID } else { resolve_type_ann(ret_ann) }
        let mut param_types: List[Int] = []
        if elems_sl != -1 {
            let mut i = 0
            while i < sublist_length(elems_sl) {
                param_types.push(resolve_type_ann(sublist_get(elems_sl, i)))
                i = i + 1
            }
        }
        return make_fn_type(ret_t, param_types)
    }
    if name == "Never" { return TYPE_NEVER }
    if name == "StringBuilder" { return type_stringbuilder() }
    -1
}

// The tid of the compiler-known type `core`: its arm in tc_resolve_compiler_known_type, else
// its prelude declaration (Ordering, ConversionError), else -1.
fn tc_compiler_known_type_tid(core: Str, elems_sl: Int, ann_node: Int) -> Int ! TypeCheck.Resolve, Diag.Report {
    let builtin = tc_resolve_compiler_known_type(core, elems_sl, ann_node)
    if builtin != -1 { return builtin }
    tc_compiler_known_tid(core)
}

// What `written`, an import alias of the compiler-known `core`, resolves to when `core` has no
// arm in tc_resolve_compiler_known_type. A type no declaration gives (Range, Buf,
// TemplateValue) has no tid to answer, so the alias is reported rather than left a free type
// variable named for the alias, which no back end can spell.
fn tc_aliased_compiler_known_type(written: Str, core: Str, ann_node: Int) -> Int ! Diag.Report {
    let known = tc_compiler_known_tid(core)
    if known != -1 { return known }
    let (home, _) = tc_shadowable_type(core)
    let at = if ann_node != -1 { ann_node } else { 0 }
    diag_error_at("UnknownType", UNKNOWN_TYPE, "`{written}` imports `{core}` from {home}, which cannot be named through an import alias", at, "write `{core}` where no declaration in this module takes the name")
    tc_error_recovery_tid()
}

fn resolve_type_parts(name: Str, elems_sl: Int, ann_node: Int) -> Int ! TypeCheck.Resolve, Diag.Report {
    // Arity is a property of a WRITTEN type position, so it keys on ann_node
    // alone — not on tc_suppress_ann_validation. That flag only silences
    // hashability re-reports the live path already emitted; arity has no such
    // live/producer duplication (and a nested arg reached only through a
    // suppressed producer would otherwise escape the check — sections/03_types.md
    // §3.4). Re-resolving the same arg node across producers re-runs the check on
    // an identical span+message, which diag dedup collapses. The impl-self path
    // passes ann_node = -1 for the receiver base — skipped here, checked in
    // validate_trait_impls instead — so it neither double-reports nor emits a
    // locationless diagnostic.
    // The compiler-known type the annotation means, if any, decides both the arity and the
    // arms below: a declaration that takes a shadowable name answers in their place.
    let core = tc_compiler_known_type_meant(name, ann_node)
    if ann_node != -1 {
        tc_check_type_arg_arity(name, core, elems_sl, ann_node)
    }
    if core != "" {
        let builtin = tc_resolve_compiler_known_type(core, elems_sl, ann_node)
        if builtin != -1 { return builtin }
        // An import alias spells no type, so the builtin it names answers by identity.
        if core != name { return tc_aliased_compiler_known_type(name, core, ann_node) }
    }

    // A type parameter is a BINDING occurrence, so inside the declaration that binds it its
    // spelling names the parameter and nothing else. Asked before the alias and declared-type
    // lookups below, which would otherwise answer the outer type and make
    // `fn ident[Shape](x: Shape)` take the struct `Shape` instead of any type at all. The
    // scan is innermost-first, so a nested binder shadows an outer one of the same spelling
    // the same way.
    //
    // After the builtin and carrier branches, not before: those names are reserved
    // (is_primitive_type claims them), so no declaration can bind a parameter under one, and
    // reaching this first would let `[List]` turn every `List` in the signature into a
    // structureless type variable.
    let tp_binder = tc_active_binder_node(name)
    if tp_binder != NO_BINDER_NODE { return make_typevar_bound(name, tp_binder) }

    // A transparent `type Alias = X` peels to X's tid HERE, at the leaf the
    // recursion reaches for every child position — so `Map[Port, Int]` gets Int
    // in its key slot, not the alias's own name. Without this the tid kept `Port`
    // while the annotation/param path lowered it to Int (two spellings of one
    // type), and an alias-keyed map inside a compound carrier emitted a void key
    // temp. The annotation node still names what the user wrote for diagnostics.
    // A generic alias applied to arguments owes the same Hash checks as the type it names.
    if tc_suppress_ann_validation == 0 && elems_sl != -1 && tc_alias_underlying_of(name) != -1 {
        tc_validate_type_arg_hashability(tc_hash_oblig_of(name), elems_sl)
    }
    let alias_name_tid = tc_resolve_transparent_alias_name(name)
    if alias_name_tid != -1 {
        // An alias its module declares twice (E1016) may have meant either type.
        if tc_type_name_poisoned(name) { return tc_error_recovery_tid() }
        return tc_resolve(alias_name_tid)
    }

    let resolved = resolve_type_name(name)
    if resolved != -1 {
        // A user struct named with type-args (`Box[Int]`, `Box[T]`) resolves to the
        // structured instance tid on the LIVE path: the
        // annotation side must carry the specialization so a concrete param/let
        // type (Box[Int]) compares by name+params against a reverse-inferred
        // literal (Box[Str]) — the two must be able to mismatch. Consumers that map
        // a struct tid back to its declaration (fields, derives) normalize
        // instance→base by name, so the fresh instance entry is safe. The instance
        // is still memoized onto the annotation node's tc_node_tid slot for the
        // tc_tid_struct_arg_* accessors.
        // The struct/enum branches are the only ones that never visited their own args on the
        // live path, so a Map key or Set element reached through one escaped validation
        // entirely. Gated on the same flag as the Map/Set branches above so the
        // off-path re-resolution below still cannot double-report.
        if tc_suppress_ann_validation == 0 && (type_kind(resolved) == TyKind.Struct || type_kind(resolved) == TyKind.Enum) {
            tc_validate_type_arg_hashability(tc_hash_oblig_at(tc_tid_decl_node(resolved)), elems_sl)
        }
        if type_kind(resolved) == TyKind.Struct && elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            return tc_produce_struct_instance_tid(ann_node, tc_instance_base_name(resolved), elems_sl)
        }
        // A generic-enum instance annotation (`t: Tree[Int]`) likewise memoizes its
        // structured instance tid onto the annotation node so codegen's param_c_type
        // can lower it to the mono carrier (blink_Tree_Int), not the erased bare enum.
        if type_kind(resolved) == TyKind.Enum && elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            return tc_produce_enum_instance_tid(ann_node, tc_instance_base_name(resolved), elems_sl)
        }
        return resolved
    }

    // An unresolved name here is NOT necessarily an unknown type: resolve_type_parts is
    // the shared low-level type-lowering path, reached for the trait `Self` (no concrete
    // receiver yet), the primitive sentinels, and effect names used as phantom
    // `Template[Effect]` arguments (types_compatible:9738 is normative that effects are
    // not in the type namespace) — local AND imported. All of those legitimately lower to
    // a typevar. Reporting UnknownType here would false-positive on every one of them, so
    // the genuine "unknown type in a struct field / enum-variant payload / alias
    // underlying" leak (the positions name-resolution does not walk) must be closed in the
    // name-resolution walker with its full acceptance set, not in this fallback.
    make_typevar(name)
}

// The one write of an impl block's receiver tid — i.e. what `self` is — made while the header
// is checked.
//
// `self` is the one parameter in the language that carries no type annotation, so
// resolve_param_type answers TYPE_UNKNOWN for it and tc_check_fn would bind it that way in
// EVERY impl method body. TYPE_UNKNOWN unifies with anything, so that made both the declared-type
// compare AND the argument check vacuous for every `self.method(...)` call in every Blink
// program: `self.get(42)` against `fn get(self, k: Str)` passed typecheck and landed as a C
// compiler error with no Blink span. The impl header has had the answer all along.
//
// Structural, not the erased base: a poly impl's receiver (`for List[T]`, `for Box[T]`) must carry
// its type-arg slots, exactly as tc_fnsig_param_instance_tid does for an annotated generic param,
// or substitute_typevar_tid has nothing to rewrite at the call site. Going through
// resolve_type_parts gets that for free and keeps one implementation of "name + args is a type".
// The binders are in scope so the slot reads as a type variable, the same way the method
// bodies later see it.
//
// Validation is suppressed over the arg resolution: these annotation nodes are resolved again
// here, and the Map/Set branches emit non-deduped E1400 hashability diagnostics that
// check_impl_type_arg_names has already reported against the same header.
//
// The receiver is a type position (spec §3.4). resolve_type_parts lowers a name it cannot
// place to a free type variable because other callers need that, so the unknown-name check
// for the receiver base lives here, with the acceptance set check_impl_type_arg_names uses
// for the receiver's arguments: a declared or builtin type, or one of the impl's own binders.
@allow(UnrestoredMutation)
fn tc_record_impl_recv_tid(im: Int) ! TypeCheck.Resolve, Diag.Report {
    // A trait's own default-method bodies have no receiver type to speak of, and the parser
    // leaves the name empty for a header with no `for` clause.
    let written = node_name(im)
    if written == "" { return }
    let binders_sl = node_impl_binders(im)
    // The module-resolved name: a namesake type is keyed under its module, not its bare name.
    let name = tc_impl_target_name(im)
    let unbound = impl_binder_declared(binders_sl, written) == 0
    let reserved = if unbound { tc_report_reserved_unbuilt(written, im) } else { 0 }
    if reserved == 0 && unbound && is_known_type(written) == 0 && lookup_named_type(name) == -1 {
        diag_error_at("UnknownType", UNKNOWN_TYPE, "unknown type `{written}` in receiver of impl `{node_trait_name(im)}`", im, "the receiver must be a declared type, a builtin type, or a name declared in `impl[...]` binders")
    }
    tc_push_tparam_scope(binders_sl)
    let saved_suppress = tc_suppress_ann_validation
    tc_suppress_ann_validation = 1
    // An aliased compiler-known receiver resolves through its alias: the builtin's own
    // spelling would mean a declaration that takes the name in this module.
    let resolved = if tc_impl_recv_spelling(im) != written { written } else { name }
    let t = tc_impl_recv_structural(resolve_type_parts(resolved, node_recv_type_args(im), -1), node_recv_type_args(im))
    tc_suppress_ann_validation = saved_suppress
    tc_pop_tparam_scope(binders_sl)
    tc_impl_recv_tids.insert(im, t)
    tc_record_poly_user_impl(im, t)
}

// An all-typevar receiver (`for Box[T]`) resolves to the bare base, which has no slot for
// the impl's T. `self` needs the slots, so a field read answers the impl's binder and not
// the declaration's. Called with the binders in scope.
@allow(UnrestoredMutation)
fn tc_impl_recv_structural(t: Int, args_sl: Int) -> Int ! TypeCheck.Resolve, Diag.Report {
    if args_sl == -1 || sublist_length(args_sl) == 0 { return t }
    let k = type_kind(t)
    if k != TyKind.Struct && k != TyKind.Enum { return t }
    if ty_pool.get(t).unwrap().params_count != 0 { return t }
    let mut arg_tids: List[Int] = []
    let mut i = 0
    while i < sublist_length(args_sl) {
        arg_tids.push(resolve_type_ann(sublist_get(args_sl, i)))
        i = i + 1
    }
    let base = tc_instance_base_name(t)
    if k == TyKind.Struct { return make_struct_instance_type(base, arg_tids) }
    make_enum_instance_type(base, arg_tids)
}

// A user generic type's impl is per instance when its receiver arguments are its binders,
// each once and in order: every instance then names every binder, so the binds read
// straight off the receiver.
fn tc_record_poly_user_impl(im: Int, recv: Int) {
    let binders_sl = node_impl_binders(im)
    if binders_sl == -1 { return }
    let n = sublist_length(binders_sl)
    if n == 0 || tc_tid_struct_arg_count(recv) != n { return }
    let decl = tc_tid_decl_node(recv)
    if decl < 0 { return }
    let mut i = 0
    while i < n {
        let a = tc_tid_struct_arg_tid(recv, i)
        if type_kind(a) != TyKind.Typevar || tc_tid_binder(a) != sublist_get(binders_sl, i) { return }
        i = i + 1
    }
    tc_poly_user_impls.insert(im, decl)
}

// Pure, so mono and codegen read the one decision typecheck made.
pub fn tc_impl_is_poly_user(im: Int) -> Bool {
    tc_poly_user_impls.contains_key(im)
}

// The receiver type's declaration of a per-instance user impl, or -1 for any other impl.
pub fn tc_poly_user_impl_decl(im: Int) -> Int {
    tc_poly_user_impls.get(im) ?? -1
}

// The receiver tid typecheck recorded for the impl block `im`; pure, so lowering can read it.
// -1 for a node that is not an impl block and for a header with no `for` clause: neither has
// a receiver, which is a different claim from "a receiver nobody could type". An impl block
// with a `for` clause and no record is a compiler bug.
pub fn tc_impl_recv_tid(im: Int) -> Int ! Diag.Report {
    if im == -1 { return -1 }
    if node_kind(im) != NodeKind.ImplBlock { return -1 }
    if node_name(im) == "" { return -1 }
    match tc_impl_recv_tids.get(im) {
        Some(t) => t
        None => {
            diag_ice_at("ImplReceiverNotRecorded", UNSOLVED_TYPEVAR_AT_CODEGEN,
                "impl block {im} has no recorded receiver type", im,
                "validate_trait_impls records every impl receiver before anything reads it; this is a compiler defect, not a program error")
            -1
        }
    }
}

// OFF-PATH monomorphized-struct-instance producer. Called only
// when resolve_type_ann sees a user struct named with type-args
// (`Box[Int]`, `Box[T]`). resolve_type_ann's live return stays the bare generic tid; this
// builds the structured instance tid and memoizes it onto the annotation node's
// tc_node_tid slot for the tc_tid_struct_arg_* accessors to read. Byte-identical:
// annotation nodes never reach infer_type, so this slot is otherwise -1, and no
// emit/typecheck reader consumes an annotation-node tid (the mono CSV path reads
// ARG-EXPRESSION node tids only). An all-typevar `Box[T]` in a generic body mints
// too: a declared typevar is not an inference variable, and the bare head has no
// slot for mono to substitute, so layout declines it.
//
// tc_suppress_ann_validation is raised over the arg re-resolution: this recursion
// is net-new work the live struct path never did, and resolve_type_ann's Map/Set
// branches emit non-deduped E1400 hashability diagnostics — suppressing them keeps
// the pass byte-identical while leaving tid-building intact. Kept in its own fn
// (not inlined into resolve_type_ann) so the save/restore idiom does not make the
// effect analyzer flag resolve_type_ann's other unguarded mutating calls.
fn tc_produce_struct_instance_tid(ann_node: Int, name: Str, elems_sl: Int) -> Int ! TypeCheck.Resolve, Diag.Report {
    let saved_suppress = tc_suppress_ann_validation
    tc_suppress_ann_validation = 1
    let mut arg_tids: List[Int] = []
    let mut ai = 0
    while ai < sublist_length(elems_sl) {
        arg_tids.push(resolve_type_ann(sublist_get(elems_sl, ai)))
        ai = ai + 1
    }
    tc_suppress_ann_validation = saved_suppress
    let inst = make_struct_instance_type(name, arg_tids)
    if ann_node >= 0 && ann_node < tc_node_tid.len() {
        tc_node_tid.set(ann_node, inst)
    }
    inst
}

// The enum analogue of tc_produce_struct_instance_tid: mint+memoize a
// generic-enum instance tid (`Tree[Int]`) onto the annotation node so codegen's
// param_c_type reads the full mono stem. Same suppression.
@allow(UnrestoredMutation)
fn tc_produce_enum_instance_tid(ann_node: Int, name: Str, elems_sl: Int) -> Int ! TypeCheck.Resolve, Diag.Report {
    let saved_suppress = tc_suppress_ann_validation
    tc_suppress_ann_validation = 1
    let mut arg_tids: List[Int] = []
    let mut ai = 0
    while ai < sublist_length(elems_sl) {
        arg_tids.push(resolve_type_ann(sublist_get(elems_sl, ai)))
        ai = ai + 1
    }
    tc_suppress_ann_validation = saved_suppress
    let inst = make_enum_instance_type(name, arg_tids)
    if ann_node >= 0 && ann_node < tc_node_tid.len() {
        tc_node_tid.set(ann_node, inst)
    }
    inst
}

// A generic FN PARAM annotation (`b: Box[T]`) must intern as a STRUCTURAL instance
// tid carrying its type-arg slots — even when every slot is a typevar — so
// unify_typevar_binds' TyKind.Struct arm (which walks param/arg slots in lockstep) can
// discover T from a `Box[Box[Int]]` argument. Without the slots the fnsig param
// collapses to the bare `Box` (params_count 0), the arity check in unify_typevar_binds fails, and a
// bare-typevar return `-> T` bound to a struct instance stays unsubstituted →
// codegen types the result `void`.
//
// Safe for check_arg_shapes: types_compatible treats a typevar slot as compatible
// with anything (TyKind.Typevar short-circuit + the element-wise struct-slot compare),
// so `Box[Box[Int]]` still matches the `Box[T]` param. Returns -1 (caller keeps the
// bare tid) unless the annotation is a generic user-struct with type-args.
//
// The make_struct_instance_type write to ty_pool/ty_param_list is INTENTIONAL (the
// interned instance is the return value), not speculative — the save/restore here
// covers only tc_suppress_ann_validation, so the mutation-analyzer flag is expected.
@allow(UnrestoredMutation)
fn tc_fnsig_param_instance_tid(ann_node: Int, bare_tid: Int) -> Int ! TypeCheck.Resolve, Diag.Report {
    let bk = type_kind(bare_tid)
    // A CONTAINER param/return (`Map[Str, Box[T]]`, `List[Box[T]]`, …) whose element
    // is a generic user-struct: resolve_type_ann once erased that element to its bare
    // base on the value path, so at the call site
    // substitute_typevar_tid meets a params_count-0 base in the slot and has no `[T]`
    // to rebind — the container comes back with the value erased (blink_Box, not
    // blink_Box_0Int). Recurse into each element annotation, re-intern it structurally,
    // and rebuild the container tid so the element keeps its slots. Mirrors
    // substitute_typevar_tid's own container arms and tc_evfield_structural_tid's tuple
    // recursion; returns -1 (caller keeps the bare tid) when no element needed interning.
    //
    // A generic-ENUM element (`Map[Str, Wrap[T]]`) rides the same recursion.
    if bk == TyKind.Map || bk == TyKind.List || bk == TyKind.Option || bk == TyKind.Result || bk == TyKind.Set {
        let need = if bk == TyKind.Map || bk == TyKind.Result { 2 } else { 1 }
        let celems_sl = node_elements(ann_node)
        if celems_sl == -1 || sublist_length(celems_sl) < need { return -1 }
        // The already-erased element tids the value path stored on the container.
        let ce = ty_pool.get(bare_tid).unwrap()
        let saved_suppress = tc_suppress_ann_validation
        tc_suppress_ann_validation = 1
        let mut parts: List[Int] = []
        let mut ci = 0
        while ci < need {
            parts.push(resolve_type_ann(sublist_get(celems_sl, ci)))
            ci = ci + 1
        }
        tc_suppress_ann_validation = saved_suppress
        let structural_key_or_only = parts.get(0).unwrap()
        // Nothing changed if every slot resolves to the tid already stored: keep the
        // caller on its bare tid so an all-scalar container is untouched.
        if bk == TyKind.List { if structural_key_or_only == ce.inner1 { return -1 } return make_list_type(structural_key_or_only) }
        if bk == TyKind.Option { if structural_key_or_only == ce.inner1 { return -1 } return make_option_type(structural_key_or_only) }
        if bk == TyKind.Set { if structural_key_or_only == ce.inner1 { return -1 } return make_set_type(structural_key_or_only) }
        let structural_val = parts.get(1).unwrap()
        if structural_key_or_only == ce.inner1 && structural_val == ce.inner2 { return -1 }
        if bk == TyKind.Map { return make_map_type(structural_key_or_only, structural_val) }
        return make_result_type(structural_key_or_only, structural_val)
    }
    // A generic-ENUM param/return (`t: Tree[T]` / `-> Tree[Int]`)
    // must also re-intern as a structural instance carrying its type-arg slots — the
    // enum twin of the struct case — so the codegen return/param mono seams read the
    // instance tid (tc_lookup_node_tid → tc_tid_struct_mono_name → blink_Tree_Int)
    // instead of the erased bare base. Without it a `-> Tree[Int]` return kept the
    // bare Tree tid and lowered to the never-typedef'd blink_Tree.
    if bk != TyKind.Struct && bk != TyKind.Enum { return -1 }
    let elems_sl = node_elements(ann_node)
    if elems_sl == -1 || sublist_length(elems_sl) < 1 { return -1 }
    let saved_suppress = tc_suppress_ann_validation
    tc_suppress_ann_validation = 1
    let mut arg_tids: List[Int] = []
    let mut ai = 0
    while ai < sublist_length(elems_sl) {
        arg_tids.push(resolve_type_ann(sublist_get(elems_sl, ai)))
        ai = ai + 1
    }
    tc_suppress_ann_validation = saved_suppress
    let base = tc_instance_base_name(bare_tid)
    if bk == TyKind.Enum {
        return make_enum_instance_type(base, arg_tids)
    }
    make_struct_instance_type(base, arg_tids)
}

// A generic-enum VARIANT-FIELD annotation (`Branch(left: Tree[T], …)`) must intern
// as a STRUCTURAL enum instance carrying its type-arg slots — even all-typevar ones
// — so unify_typevar_binds' TyKind.Enum arm can walk the recursive-field param against a
// concrete `Tree[Int]` construction arg and bind T. The enum analogue of
// tc_fnsig_param_instance_tid. Returns -1 (caller keeps the bare resolved tid) unless the annotation is a
// generic user-enum with type-args.
@allow(UnrestoredMutation)
fn tc_evfield_instance_tid(ann_node: Int, bare_tid: Int) -> Int ! TypeCheck.Resolve, Diag.Report {
    if type_kind(bare_tid) != TyKind.Enum { return -1 }
    let elems_sl = node_elements(ann_node)
    if elems_sl == -1 || sublist_length(elems_sl) < 1 { return -1 }
    let saved_suppress = tc_suppress_ann_validation
    tc_suppress_ann_validation = 1
    let mut arg_tids: List[Int] = []
    let mut ai = 0
    while ai < sublist_length(elems_sl) {
        arg_tids.push(resolve_type_ann(sublist_get(elems_sl, ai)))
        ai = ai + 1
    }
    tc_suppress_ann_validation = saved_suppress
    make_enum_instance_type(tc_instance_base_name(bare_tid), arg_tids)
}

// The tuple-aware extension of tc_evfield_instance_tid. A self-recursive tuple
// field (`Pair(p: (Box[T], Box[T]))`) resolves through the bare-tuple path, whose
// elements resolve_type_ann once erased to the argless base (`(Box, Box)`). Recurse the annotation: at a tuple, re-intern each element structurally
// and rebuild the tuple so a SELF-type element keeps its `[T]` slots; otherwise
// defer to tc_evfield_instance_tid. That preserved typevar is what lets a match
// binder substitute T→Int from the scrutinee instance (tc_subst_evfield_from_instance)
// and lets a ctor reverse-infer the instance from `(l, r)`. Returns -1 (caller
// keeps the bare tid) when nothing structural needs interning. make_tuple_type
// appends to ty_param_list, so every element tid is collected into `elems` first.
//
// The root field annotation keeps the original any-instance behavior (a direct
// `left: Tree[T]` field preserves its typevars). Inside a tuple the preservation
// is restricted to `self_enum`: a non-self generic instance element (`(Other[T],
// Int)`) has no arg-full tuple-carrier emission, so constructing it miscompiles
// if its slots are kept — it must stay erased, exactly as before this path existed.
fn tc_evfield_structural_tid(ann_node: Int, bare_tid: Int, self_enum: Str, is_root: Int) -> Int ! TypeCheck.Resolve, Diag.Report {
    if node_name(ann_node) == "Tuple" {
        let elems_sl = node_elements(ann_node)
        if elems_sl == -1 || sublist_length(elems_sl) < 1 { return -1 }
        let mut elems: List[Int] = []
        let mut changed = 0
        let mut i = 0
        while i < sublist_length(elems_sl) {
            let el_ann = sublist_get(elems_sl, i)
            let el_bare = resolve_type_ann(el_ann)
            let el_inst = tc_evfield_structural_tid(el_ann, el_bare, self_enum, 0)
            if el_inst != -1 {
                elems.push(el_inst)
                changed = 1
            } else {
                elems.push(el_bare)
            }
            i = i + 1
        }
        if changed == 0 { return -1 }
        return make_tuple_type(elems)
    }
    if is_root == 0 && strip_module_qualifier(node_name(ann_node)) != self_enum { return -1 }
    tc_evfield_instance_tid(ann_node, bare_tid)
}

// Purely SYNTACTIC pre-check: is `v` a direct call to a bare Ident whose signature
// declares at least one RETURN-ONLY type param — i.e. could this node have minted a
// metavar that a declared type is entitled to pin?
//
// This is the load-bearing narrowing for each struct-field pin that calls it, on two
// counts, and neither is an optimization detail:
//
//   • COST. infer_type does not memoize its diagnostics, so an unconditional infer
//     per struct-literal field would re-run every field value's checking for every
//     struct literal in the program. Answering "can this mint" without inferring
//     keeps the walk free for the overwhelming majority of literals.
//
//   • SCOPE. It STRUCTURALLY excludes a bare ctor field value such as
//     `Box { value: Map() }`, whose key the field's own metavar carries, not a call's.
//     `Map()`/`Set()`/`[]`/`None` are builtins handled long before lookup_fnsig, so
//     the lookup misses and this returns 0. The field pin therefore cannot reach a
//     bare ctor field value at all; that shape stays exactly where it is today.
//
// A local binding of the same name shadows the global sig (a closure-valued
// variable), so it is excluded the same way the Call arm of infer_type excludes it.
fn tc_call_mints_ret_only(v: Int) -> Int {
    if v == -1 { return 0 }
    if node_kind(v) != NodeKind.Call { return 0 }
    let callee = node_left(v)
    if callee == -1 { return 0 }
    if node_kind(callee) != NodeKind.Ident { return 0 }
    let written = node_name(callee)
    if tc_tid_is_no_info(nr_get_type(written)) == 0 { return 0 }
    let sig = tc_bare_callee_sig(written)
    if sig == -1 { return 0 }
    let fs = fnsig_pool.get(sig).unwrap()
    let mut pi = 0
    while pi < fs.type_params_count {
        let ro_idx = fs.type_params_start + pi
        if ro_idx < fnsig_tparam_ret_only.len() {
            if fnsig_tparam_ret_only.get(ro_idx).unwrap() != 0 { return 1 }
        }
        pi = pi + 1
    }
    0
}

// Publish a node tid for every field VALUE of a MONOMORPHIC struct literal. The generic path
// below infers field values in its typevar-binds loop, but a non-generic struct returns before
// that loop — so its field values would otherwise never reach infer_type and would carry no tid,
// leaving codegen without the authoritative type for any temp it mints from them.
//
// Each value is inferred under the DECLARED field type as construction hint (so a bare
// variant-named value like `Leaf {..}` resolves to the field's enum rather than tripping an
// ambiguous-construction error) and, when the value is an as-yet-unpinned empty container
// (`[]`/`Map()`/`None`), unified against the declared type so the node memo carries the concrete
// element type rather than an under-determined metavar. Mirrors check_arg_value's hint+unify.
// infer_type writes cumulative inference state that persists beyond the restored hint.
@allow(UnrestoredMutation)
fn tc_infer_struct_lit_field_values(stid: Int, node: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let flds_sl = node_fields(node)
    if flds_sl == -1 { return }
    let mut fi = 0
    while fi < sublist_length(flds_sl) {
        let f = sublist_get(flds_sl, fi)
        let declared = get_struct_field_tid(stid, node_name(f))
        let saved_hint = tc_construct_hint
        if tc_tid_is_no_info(declared) == 0 {
            tc_seed_expected_into_value(node_value(f), declared)
            tc_construct_hint = resolve_alias_tid(declared)
        }
        let vt = infer_type(node_value(f))
        tc_construct_hint = saved_hint
        if tc_tid_is_no_info(declared) == 0 {
            if tc_tid_has_unbound_metavar(vt) != 0 { tc_unify(declared, vt) }
            tc_pin_declared_into_value(declared, node_value(f), vt)
        }
        fi = fi + 1
    }
}

// LIVE reverse-inference of a struct literal's concrete instance tid. Given the bare generic tid
// (`Box`) and the StructLit node, unify each declared generic field type (which
// holds TyKind.Typevar for a generic field, e.g. Box.value: T) against the inferred
// type of the corresponding literal field VALUE, collecting typevar→concrete
// binds. If at least one type-param binds to a concrete (non-typevar) type, build
// the structured instance tid (make_struct_instance_type, args in the decl's
// type-param order) and return it; otherwise fall back to the bare `stid`.
//
// Fallback (bare) is the correct answer when the literal carries no concrete
// information: an all-typevar field, or an empty-collection field (`Box { value:
// Map() }`) whose value infers Map[?,?] with no reachable concrete inner. The
// instance tid meeting the bare tid stays compatible (types_compatible bare~any),
// so returning bare never causes a spurious mismatch — it only forgoes the
// stronger check when nothing is knowable, exactly like the annotation side.
//
// A missing decl node (should not happen for a resolved struct) or a non-generic
// struct (no type params) short-circuits to bare — no instance is minted for a
// monomorphic struct, keeping the pool free of redundant entries.
// Walk the body of a closure written directly as a struct-literal field value
// (`ErrorHandler { on_error: fn(req, msg) -> Response { .. } }`). Nothing else reaches it:
// infer_type answers the closure's own Fn tid without descending, and there is no call site
// to route it through tc_check_callable_arg_bodies — so its params never bound and its body
// never typed. The declared FIELD type supplies the param hints, which is exactly what a
// closure argument gets from the parameter it is passed to.
fn tc_check_struct_lit_field_closures(stid: Int, node: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let flds_sl = node_fields(node)
    if flds_sl == -1 { return }
    let mut fi = 0
    while fi < sublist_length(flds_sl) {
        let f = sublist_get(flds_sl, fi)
        let v = node_value(f)
        if v != -1 {
            let vk = node_kind(v)
            let declared = resolve_alias_tid(get_struct_field_tid(stid, node_name(f)))
            if type_kind(declared) == TyKind.Fn {
                tc_check_struct_lit_fn_field(v, declared)
            }
            if vk == NodeKind.HandlerExpr {
                tc_check_body(v)
            }
        }
        fi = fi + 1
    }
}

// A closure written as a function-typed field's value takes its parameter hints from the
// field's type. The value itself is held to that type with every other field, by
// tc_check_lit_field_values.
fn tc_check_struct_lit_fn_field(v: Int, declared: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if node_kind(v) != NodeKind.Closure { return }
    tc_seed_closure_expected_fn(v, declared)
    check_closure_body(v, declared)
}

// A field value meets its declared field type (sections/03_types.md *Expected type at a site*,
// item 5). A field declared with the type's own parameter gives no expected type, as a
// parameter declared with the callee's does (item 4), even when an annotation fixes the
// parameter at `at_inst`.
fn tc_seed_declared_field(declared: Int, at_inst: Int, value_node: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if tc_tid_has_bare_typevar(declared) != 0 { return }
    tc_seed_expected_into_value(value_node, at_inst)
}

// A field value inferred under the field's OWN type rather than under the whole literal's.
// @allow: infer_type writes cumulative inference state that outlives the restored hint, as in
// tc_infer_struct_lit_field_values.
@allow(UnrestoredMutation)
fn tc_infer_field_value_under(hint: Int, value_node: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let saved_hint = tc_construct_hint
    if tc_tid_is_no_info(hint) == 0 { tc_construct_hint = resolve_alias_tid(hint) }
    let vt = infer_type(value_node)
    tc_construct_hint = saved_hint
    vt
}

// The field's own declared type, with the type's own parameters filled in from the target
// annotation when the target names that same type: `let w: GW[Pollfd] = GW { p: ... }` says
// the field `p: Ptr[T]` is a `Ptr[Pollfd]` here. Without it a field value is inferred under the
// WHOLE literal's type as its hint, which says nothing about any one field. A target naming a
// DIFFERENT type is not this literal's instance and substitutes nothing.
fn tc_field_target_hint(bare: Str, declared: Int) -> Int {
    if tc_construct_hint < 0 { return declared }
    let h = resolve_alias_tid(tc_construct_hint)
    if h < 0 || h >= ty_pool.len() { return declared }
    let he = ty_pool.get(h).unwrap()
    if he.kind != TyKind.Struct && he.kind != TyKind.Enum { return declared }
    if strip_module_qualifier(he.name) != bare { return declared }
    tc_subst_evfield_from_instance(declared, h)
}

// Whether the declared field type is the thing that says what this field value holds,
// answered WITHOUT inferring the value. A call that mints a return-only type parameter is
// one way in. A declared container head is the other: an empty `Map()`/`Set()` mints its own
// element metavariables and names nothing that could ever solve them. A field outside both
// keeps its own inferred type, so a concrete field still beats the declaration.
fn tc_pin_field_carries_value_type(v: Int, declared: Int) -> Int {
    if tc_call_mints_ret_only(v) != 0 { return 1 }
    let dk = type_kind(resolve_alias_tid(declared))
    if dk == TyKind.Map || dk == TyKind.Set || dk == TyKind.Option || dk == TyKind.Result {
        return 1
    }
    0
}

// The source is nominally the same struct, so its type arguments line up with the
// declaration's parameters one for one. Unifying each against the parameter's own typevar
// reuses the concrete-wins rule, so a field written beside it still takes priority.
fn tc_bind_tparams_from_instance(bare: Str, src: Int, tparams_sl: Int, binds: Map[Str, Int]) {
    let r = tc_resolve(src)
    let k = tc_tid_kind(r)
    if k != TyKind.Struct && k != TyKind.Enum { return }
    if strip_module_qualifier(tc_tid_name(r)) != strip_module_qualifier(bare) { return }
    let n = tc_tid_child_count(r)
    if n != sublist_length(tparams_sl) { return }
    let mut i = 0
    while i < n {
        let tp = sublist_get(tparams_sl, i)
        unify_typevar_binds(make_typevar_bound(node_name(tp), tp), tc_tid_child(r, i), binds)
        i = i + 1
    }
}

// Binds each type parameter from the fields and spread entries alone. Each field value
// is still inferred under its type at the expected instance, which is how an empty
// `Map()`/`Set()` field learns its element types.
fn tc_bind_struct_lit_fields(stid: Int, bare: Str, flds_sl: Int, tparams_sl: Int, binds: Map[Str, Int]) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let mut fi = 0
    while fi < sublist_length(flds_sl) {
        let f = sublist_get(flds_sl, fi)
        let fname = node_name(f)
        let declared = get_struct_field_tid(stid, fname)
        if declared != -1 {
            // The field type read AT THIS INSTANCE, which is also the field value's expected
            // type. An empty `Map()`/`Set()` field has no other source for its element types:
            // the value mints its own metavariables and names nothing that could ever solve
            // them, and a keyed container chooses its key operations from the key type, so an
            // unbound key answers no table. The bind map still reads the UNSUBSTITUTED
            // declared type, which is the one carrying the parameters a sibling field or a
            // spread may yet determine.
            let at_inst = tc_field_target_hint(bare, declared)
            tc_seed_declared_field(declared, at_inst, node_value(f))
            let ftid = tc_infer_field_value_under(at_inst, node_value(f))
            // A field type still naming the struct's own parameter is only half solved, so the
            // walk must not carry it into the value's tails and pin each arm from it. A value
            // that is itself a return-only call or an empty container still meets it at the
            // top, which links its open binder to the parameter that the binds below solve.
            if tc_tid_has_bare_typevar(at_inst) == 0 {
                tc_pin_declared_into_value(at_inst, node_value(f), ftid)
            } else if tc_pin_field_carries_value_type(node_value(f), at_inst) != 0 {
                tc_pin_tail_ret_generic(at_inst, ftid)
            }
            unify_typevar_binds(declared, ftid, binds)
        } else {
            // A spread entry (`..base()`) has no field name, and so no declared type to unify
            // against, but the value it spreads is an instance of this same struct — and when
            // every type-carrying field arrives through the spread, its arguments are the only
            // place the literal's own type parameters can come from. Dropping the inferred
            // type here left the literal on the bare generic head, which has no C layout.
            tc_bind_tparams_from_instance(bare, infer_type(node_value(f)), tparams_sl, binds)
        }
        fi = fi + 1
    }
}

// Each parameter unifies its field bind with its expected-instance bind, which solves the
// metavars of an empty `Map()`/`Set()` field. A failed unify is a concrete clash, so the
// field bind stays and the let, argument or return comparison reports the mismatch.
fn tc_fill_binds_from_hint(bare: Str, hint: Int, tparams_sl: Int, binds: Map[Str, Int]) {
    let mut hbinds: Map[Str, Int] = Map()
    tc_bind_tparams_from_instance(bare, hint, tparams_sl, hbinds)
    for key in hbinds.keys() {
        let h = hbinds.get(key) ?? -1
        let prev = binds.get(key) ?? -1
        if h < 0 { continue }
        if prev < 0 {
            binds.insert(key, h)
        } else if tc_unify(prev, h) != 0 && tc_bind_has_hole(prev) != 0 && tc_bind_has_hole(h) == 0 {
            // A success can be vacuous: tc_unify returns 1 without binding on the `?` hole,
            // a type parameter, and Ptr, Handle and Template, which it has no arm for.
            binds.insert(key, h)
        }
    }
}

// Open after a vacuous unify: a metavar, the `?` hole, or a generic callee's own parameter
// read off its signature, which nothing binds here.
fn tc_bind_has_hole(tid: Int) -> Int {
    if tc_tid_has_unbound_metavar(tid) != 0 { return 1 }
    if tc_tid_has_foreign_typevar(tid) != 0 { return 1 }
    tc_tid_has_unknown(tid)
}

fn tc_struct_lit_instance_tid(stid: Int, node: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    tc_check_brace_literal(tc_struct_literal_owner(stid), node)
    tc_check_struct_lit_field_closures(stid, node)
    let bare = tc_instance_base_name(stid)
    let decl = tc_struct_decl_nodes.get(bare) ?? -1
    if decl == -1 {
        tc_infer_struct_lit_field_values(stid, node)
        return stid
    }
    let tparams_sl = node_type_params(decl)
    if tparams_sl == -1 || sublist_length(tparams_sl) == 0 {
        tc_infer_struct_lit_field_values(stid, node)
        return stid
    }
    let flds_sl = node_fields(node)
    if flds_sl == -1 { return stid }
    let mut binds: Map[Str, Int] = Map()
    tc_bind_struct_lit_fields(stid, bare, flds_sl, tparams_sl, binds)
    if tc_construct_hint >= 0 {
        tc_fill_binds_from_hint(bare, resolve_alias_tid(tc_construct_hint), tparams_sl, binds)
    }
    // Decide whether any type-param bound to a concrete type BEFORE building the
    // arg list, so the no-concrete fallback does not mint throwaway pool entries on
    // the hot inference path — it returns the bare tid untouched. "Concrete" here
    // excludes BOTH a typevar AND TYPE_UNKNOWN: an empty `Map()`/`Set()` field binds
    // its param to TYPE_UNKNOWN (make_map_type(TYPE_UNKNOWN,..)), and an instance
    // whose args are all unknown carries no more information than the bare tid.
    // Minting it would produce a `GKV[?,?]` whose field access substitutes to a
    // void inner and defeats codegen's erased-default recovery. A
    // MIXED instance (one arg concrete, one unknown) still mints — the arg-list
    // builder keeps the unknown arg, and the field-access consumer skips it.
    let mut has_concrete = 0
    // Also mint the instance when a param bound to an UNBOUND metavar
    // (an inner empty `Map()`/`Set()`/`[]`/`None`). Pre-decision this returned the
    // bare stid and the erased inner rode codegen's default-recovery; post-decision
    // an under-determined construction must be REPORTED (E0301), so the instance
    // must carry the α — the region-boundary check then blames the binding and
    // names the open params. A raw resolved metavar (kind TyKind.Unknown after
    // tc_resolve) is the trigger; a bare TyKind.Typevar (legitimate generic-fn body
    // context) is NOT — that still returns the bare stid untouched.
    let mut has_open_metavar = 0
    // Also mint when a param binds to a bare TyKind.Typevar from the
    // ENCLOSING generic fn's own scope (`Box { value: inner }` where `inner: T`
    // inside `fn wrap_and_build[T](...)`). A bare-head instance has no param slot
    // for wrap_and_build's OWN monomorphization (T:=Int) to substitute into, so
    // the callee's mono symbol permanently erases to the undeclared generic head
    // (blink_Box instead of blink_Box_Int). Minting with the raw typevar in the
    // slot (make_typevar(tpname), below) is safe: get_struct_field_tid/
    // tc_struct_base_tid normalize any instance back to its base decl tid by
    // name regardless of slot contents.
    let mut has_bare_typevar = 0
    let mut ci = 0
    while ci < sublist_length(tparams_sl) {
        let bound = binds.get(node_name(sublist_get(tparams_sl, ci))) ?? -1
        if bound != -1 && type_kind(bound) != TyKind.Typevar && type_kind(bound) != TyKind.Unknown { has_concrete = 1 }
        if bound != -1 && tc_tid_has_unbound_metavar(bound) != 0 { has_open_metavar = 1 }
        if bound != -1 && type_kind(bound) == TyKind.Typevar { has_bare_typevar = 1 }
        ci = ci + 1
    }
    if has_concrete == 0 && has_open_metavar == 0 && has_bare_typevar == 0 { return stid }
    let mut arg_tids: List[Int] = []
    let mut ti = 0
    while ti < sublist_length(tparams_sl) {
        let tp = sublist_get(tparams_sl, ti)
        let tpname = node_name(tp)
        let bound = binds.get(tpname) ?? -1
        if bound != -1 {
            arg_tids.push(bound)
        } else {
            arg_tids.push(make_typevar_bound(tpname, tp))
        }
        ti = ti + 1
    }
    make_struct_instance_type(bare, arg_tids)
}

// ── Registration from AST ───────────────────────────────────────────

fn is_ffi_struct_field_type(ann_name: Str) -> Int {
    if ann_name == "I8" || ann_name == "I16" || ann_name == "I32" || ann_name == "I64" { return 1 }
    if ann_name == "U8" || ann_name == "U16" || ann_name == "U32" || ann_name == "U64" { return 1 }
    if ann_name == "Int" || ann_name == "Float" || ann_name == "F32" || ann_name == "F64" { return 1 }
    if ann_name == "Bool" { return 1 }
    0
}

// A `Ptr` or `@ffi.struct` field is judged by the type it resolves to, not its spelling, so
// an alias or a qualified name is accepted as the type it names.
fn ffi_struct_field_type_ok(ann_name: Str, ftid: Int) -> Int {
    if is_ffi_struct_field_type(ann_name) != 0 { return 1 }
    let t = tc_resolve(ftid)
    if t < 0 || t >= ty_pool.len() { return 0 }
    if type_kind(t) == TyKind.Ptr { return 1 }
    if ffi_struct_type_set.contains_key(t) { return 1 }
    0
}

fn is_builtin_hashable(name: Str) -> Int {
    if name == "Str" || name == "Int" || name == "Bool" || name == "Char" { return 1 }
    // The annotation `()` is named Void. It is the 0-tuple, hashable because it has no
    // element that is not. A written `Void` outside Ptr is already E0828, so it is not
    // reported twice here.
    if name == "Void" { return 1 }
    if name == "I8" || name == "I16" || name == "I32" || name == "I64" { return 1 }
    if name == "U8" || name == "U16" || name == "U32" || name == "U64" { return 1 }
    0
}

// Verify that a Map key type annotation is hashable. Emits MAP_KEY_NOT_HASHABLE
// (E1400) on rejection. Built-in scalars are always OK; user structs/enums
// must carry @derive(Hash); tuples are OK iff every element is hashable;
// Float/Double are explicitly rejected. Generic type parameters are accepted
// since we can't see through them at this point.
// A type alias / refinement (`type Port = Int`, `type Port = Int @where(self > 0)`) constrains
// the VALUES that inhabit its base type; it is not a new representation. sections/03b_contracts.md
// is explicit — "@where constrains the set of values that inhabit the type" — and
// sections/03_types.md:757 draws the contrast from the other side, calling sized ints "first-class
// nominal types -- not refinements of Int, not aliases, not newtypes".
//
// Hashability is a property of representation plus equality, so an alias is hashable exactly when
// its base is. @derive(Hash, Eq) exists for structs and enums, which have no intrinsic hash; asking
// it of a refinement over Int is a category error, and the E1400 help text ("add @derive(Hash, Eq)
// to the 'Port' type definition") is advice the user should never need — it is written for a struct.
//
// Resolving the name makes both answers fall out of the ordinary rules below rather than needing a
// carve-out: `type Port = Int` reaches is_builtin_hashable and is accepted, while
// `type Temp = Float` reaches the Float arm and is rejected for the NaN hazard it actually has.
// Skipping aliases instead would accept a Float-keyed Map, which the spec forbids outright.
//
// Resolution is deliberately partial. A NAME cannot carry type arguments, so `type Pair =
// (Float, Float)` resolves to a bare tuple name with no element nodes to recurse into, and any
// verdict read off that name would be a guess — accepting it would punch a Float-keyed hole
// straight through the arm above. So a hop is taken only when the underlying name is one these
// rules can decide NOMINALLY: a hashable builtin, a Float width, or a declared struct/enum
// (which also keeps alias chains walking, since an intermediate alias is itself a named type).
// Anything else leaves the declared name in place and the caller's behavior unchanged.
// "Tuple" is deliberately excluded even though is_primitive_type recognizes it: a NAME
// carries no type arguments, so a tuple alias (`type Pair = (Float, Float)`) resolves to
// the bare name "Tuple" with no element nodes to recurse into, and Tuple's hashability
// depends entirely on its elements. Every OTHER primitive name is decided by the name
// alone regardless of its own type arguments — a container (List/Map/Set/Option/Result)
// is never Hash no matter what it holds, same for Bytes/StringBuilder/Fn/etc — so hopping
// to one of those and rejecting immediately is sound without seeing inside it.
fn alias_name_decidable(name: Str) -> Int {
    if name == "Tuple" { return 0 }
    if is_primitive_type(name) != 0 { return 1 }
    let nominal = tc_written_type_nominal(name)
    let bare = strip_module_qualifier(name)
    if named_type_map.contains_key(nominal) || named_type_map.contains_key(bare) { return 1 }
    0
}

fn resolve_alias_type_name(name0: Str) -> Str {
    if tc_alias_underlying.len() == 0 { return name0 }
    let mut name = name0
    let mut hops = 0
    while hops < 8 {
        let u = tc_alias_underlying_of(name)
        if u == -1 { return name }
        let next = tc_type_name(u)
        if next == "" || next == name { return name }
        if alias_name_decidable(next) == 0 { return name }
        name = next
        hops = hops + 1
    }
    name
}

// Whether a written type name is a type parameter bound by the enclosing declaration. A
// binder shadows a type of the same name, so a signature written `fn f[K, V](m: Map[K, V])`
// says nothing about a user type that happens to also be called K. The key's Hash
// obligation belongs at the call site, on whatever the parameter is substituted with.
fn tc_name_is_tparam_in_scope(name: Str) -> Int {
    if (tc_active_tparams.get(name) ?? 0) > 0 { return 1 }
    if (tc_active_tparams.get(strip_module_qualifier(name)) ?? 0) > 0 { return 1 }
    0
}

// The words E1400 uses for one keyed role: the name of the role, the plural the rule is
// stated over, the noun the help offers a replacement for, and what the Float help rounds.
type HashRoleWords {
    title: Str
    plural: Str
    noun: Str
    rounded: Str
}

fn tc_hash_role_words(role: HashRole) -> HashRoleWords {
    match role {
        HashRole.SetElement => HashRoleWords { title: "Set element", plural: "Set elements", noun: "element", rounded: "value" }
        _ => HashRoleWords { title: "Map key", plural: "Map keys", noun: "key", rounded: "key" }
    }
}

// Why a key type has no Hash: a Float, a user type with no derive, a builtin with no impl, or
// a derived Hash that fails at this instance's arguments.
type HashRefusal { FloatKey, NoDerive, NoImpl, Instance }

// E1400 for a key a container refuses, in one wording whether the key was written or
// inferred. `shown` is the type as the reader knows it; `name` is the type the reason or the
// help points at.
fn tc_report_unhashable(role: HashRole, why: HashRefusal, shown: Str, name: Str, node: Int) ! Diag.Report {
    let w = tc_hash_role_words(role)
    match why {
        HashRefusal.FloatKey => diag_error_at("MapKeyNotHashable", MAP_KEY_NOT_HASHABLE, "{w.title} type `{shown}` is not hashable — Float/Double values cannot serve as {w.plural} (NaN-inequality and bit-equality hazards)", node, "round the {w.rounded} to an Int (or another integer width) before inserting")
        HashRefusal.NoDerive => {
            let args = "{tc_derive_arg_for("Hash", name)}, {tc_derive_arg_for("Eq", name)}"
            // The plain wording names the @derive spelling, which a shadow makes wrong here.
            let plain = args == "Hash, Eq" && tc_core_trait_shown("Hash") == "Hash" && tc_core_trait_shown("Eq") == "Eq"
            let must = if plain { "carry the @derive(Hash, Eq) annotation" } else {
                "derive `{tc_core_trait_shown("Hash")}` and `{tc_core_trait_shown("Eq")}`"
            }
            diag_error_at_notes("MapKeyNotHashable", MAP_KEY_NOT_HASHABLE, "{w.title} type `{shown}` does not implement {tc_core_trait_shown("Hash")} — user types used as {w.plural} must {must}", node,
                "{tc_derive_fix_imports(["Hash", "Eq"], name)}add @derive({args}) to the `{name}` type definition", tc_shadowed_trait_notes("Hash"))
        }
        HashRefusal.NoImpl => diag_error_at("MapKeyNotHashable", MAP_KEY_NOT_HASHABLE, "{w.title} type `{shown}` does not implement Hash — {name} has no Hash/Eq implementation in v1 (containers, Bytes, StringBuilder, and fn types cannot be {w.plural})", node, "use a hashable scalar (Int/sized-int/Bool/Char/Str), a tuple of hashable types, or a @derive(Hash, Eq) struct/enum as the {w.noun} instead")
        HashRefusal.Instance => diag_error_at("MapKeyNotHashable", MAP_KEY_NOT_HASHABLE, "{w.title} type `{shown}` does not implement Hash — a derived Hash holds only where each type argument its fields use is Hash", node, "use type arguments that are Hash, or derive Hash on the argument types")
    }
}

// A written Map key or Set element. A Set is a keys-only hash table, so its element carries
// the same Hash requirement as a Map key: built-in scalars OK; user structs/enums need
// @derive(Hash); tuples OK iff every element is hashable; Float/Double rejected; generic type
// params accepted (opaque at this point); aliases decided by their base type.
fn validate_keyed_ann(key_ann: Int, role: HashRole) ! Diag.Report {
    // Decisions read the base type; every message names what the USER wrote, so a rejected
    // `type Temp = Float` says "Map key type 'Temp'" and explains the Float hazard behind it.
    let decl_name = node_name(key_ann)
    if tc_name_is_tparam_in_scope(decl_name) != 0 { return }
    let key_name = resolve_alias_type_name(decl_name)
    if key_name == "Float" || key_name == "F32" || key_name == "F64" {
        tc_report_unhashable(role, HashRefusal.FloatKey, decl_name, key_name, key_ann)
        return
    }
    if key_name == "Tuple" {
        let elems = node_elements(key_ann)
        if elems != -1 {
            let mut i = 0
            while i < sublist_length(elems) {
                validate_keyed_ann(sublist_get(elems, i), role)
                i = i + 1
            }
        }
        return
    }
    if is_builtin_hashable(key_name) != 0 { return }
    let bare = strip_module_qualifier(key_name)
    let nominal = tc_written_type_nominal(key_name)
    if tc_type_name_derives(nominal, "Hash") != 0 {
        return
    }
    // Generic type params and unknown names — let later phases handle them.
    // Only reject when we KNOW this is a user-defined struct/enum without
    // @derive(Hash), to avoid spurious errors on generics.
    // The message names what the user wrote; the help names the type that actually has to carry the
    // derive. For `type MyKey = Point` those differ, and pointing the fix at Point is the useful
    // half — @derive on the alias would be the category error described above.
    if named_type_map.contains_key(nominal) || named_type_map.contains_key(bare) {
        tc_report_unhashable(role, HashRefusal.NoDerive, decl_name, key_name, key_ann)
        return
    }
    // Deny-by-default: is_primitive_type enumerates every concrete builtin name the
    // compiler knows (List/Map/Set/Option/Result, Bytes, StringBuilder, Fn, ...). None of
    // them implement Hash, and none of them can gain one via @derive, so any name it
    // recognizes here is a known rejection rather than a missing diagnostic. A name it
    // does NOT recognize, and that is also not a registered user type, is a generic type
    // parameter opaque at this point — deferred to later phases, same as always.
    if is_primitive_type(key_name) != 0 {
        tc_report_unhashable(role, HashRefusal.NoImpl, decl_name, key_name, key_ann)
    }
}

// validate_keyed_ann reads the written name, so it passes any instance of a type that derives
// Hash. The derive holds only at an instance whose arguments have Hash, read here at the tid.
fn tc_refuse_unhashable_instance(tid0: Int, ann: Int, role: HashRole) ! Diag.Report {
    let tid = resolve_alias_tid(tc_resolve(tid0))
    let k = type_kind(tid)
    if k != TyKind.Struct && k != TyKind.Enum { return }
    if tc_tid_child_count(tid) == 0 { return }
    let base = if k == TyKind.Struct { tc_struct_base_tid(tid) } else { tc_enum_base_tid(tid) }
    if tc_type_name_derives(strip_module_qualifier(tc_type_name(base)), "Hash") == 0 { return }
    if tc_instance_has_trait(tid, "Hash") { return }
    tc_report_unhashable(role, HashRefusal.Instance, type_to_str(tid), "", ann)
}

// A key type no annotation spelled, judged by the rule a written one is and reported in its
// words. The reason is read off the type: a tuple answers for its first element that fails.
fn tc_refuse_unhashable_tid(tid0: Int, role: HashRole, node: Int) ! Diag.Report {
    let tid = resolve_alias_tid(tc_resolve(tid0))
    if tc_tid_hash_fact(tid) != -1 { return }
    let k = type_kind(tid)
    if k == TyKind.Tuple {
        let te = ty_pool.get(tid).unwrap()
        let mut i = 0
        while i < te.params_count {
            let e = ty_param_list.get(te.params_start + i).unwrap()
            if tc_tid_hash_fact(e) == -1 {
                tc_refuse_unhashable_tid(e, role, node)
                return
            }
            i = i + 1
        }
        return
    }
    let shown = type_to_str(tid)
    if k == TyKind.Float {
        tc_report_unhashable(role, HashRefusal.FloatKey, shown, shown, node)
        return
    }
    if k == TyKind.Struct || k == TyKind.Enum {
        let base = if k == TyKind.Struct { tc_struct_base_tid(tid) } else { tc_enum_base_tid(tid) }
        let bname = strip_module_qualifier(tc_type_name(base))
        let why = if tc_type_name_derives(bname, "Hash") != 0 { HashRefusal.Instance } else { HashRefusal.NoDerive }
        tc_report_unhashable(role, why, shown, bname, node)
        return
    }
    tc_report_unhashable(role, HashRefusal.NoImpl, shown, tk_name(k), node)
}

// Hashability validation for a STRUCT or ENUM annotation's type arguments.
//
// resolve_type_ann's Map and Set branches validate their own key/element, and the builtin
// carrier branches (Option/Result/Tuple) reach a nested Map/Set because they resolve their
// inners through resolve_type_ann. The struct and enum branches did neither: they hand the
// annotation straight to tc_produce_struct_instance_tid / tc_produce_enum_instance_tid and
// return the instance tid, and those producers re-resolve the args with
// tc_suppress_ann_validation raised. So nothing on the LIVE path had ever visited a struct
// type-arg, and `Box[Map[Float,Int]]` was accepted while the bare `Map[Float,Int]` was
// rejected outright.
//
// That was never merely a missing diagnostic. Codegen has no kops vtable for a Float key, so
// once any tier pinned the slot, kops_table_name fell through to
// BLINK_COMPILER_BUG_kops_unsupported_K_ct1_Float — an invalid C identifier, a gcc-level
// failure with no Blink diagnostic, wearing a spelling that accuses the compiler for what is a
// user program naming an illegal key. Before the slot got pinned the erased default emits
// blink_kops_str instead: a Float hashed through the STRING vtable, a silent-hash shape.
// Which of the two you get depends only on whether some unrelated tier happened to bind
// the slot.
//
// Deliberately NOT a resolve_type_ann recursion. This walks the annotation tree and calls only
// the two validators, so it interns nothing and appends nothing to ty_pool — which is what
// keeps every legal program byte-identical, the concern that made the off-path producer
// suppress in the first place. Validating HERE rather than un-suppressing THERE is also what
// makes the diagnostic fire once per SITE: the live path visits each annotation exactly once,
// while the off-path producer can visit one node repeatedly.
//
// The recursion descends through intervening carriers and struct levels alike, so
// `Box[Box[Map[Float,Int]]]` and `Box[Option[Set[Float]]]` are both reached. A typevar or
// unknown arg name matches neither "Map" nor "Set" and has no elements, so it costs one
// comparison and terminates — the deferral validate_keyed_ann documents for type params stays
// intact — being over-eager here would itself be a defect.
//
// `owner_oblig` is the owner's tc_hash_oblig entry: an argument substituted for a parameter
// that the declaration uses as a Set element or Map key is judged here as one, so
// `Holder[Point]` over `type Holder[T] { items: Set[T] }` is rejected like `Set[Point]`.
fn tc_validate_type_arg_hashability(owner_oblig: List[HashRole], elems_sl: Int) ! Diag.Report {
    if elems_sl == -1 { return }
    let mut i = 0
    while i < sublist_length(elems_sl) {
        let arg = sublist_get(elems_sl, i)
        let arg_name = node_name(arg)
        let arg_elems = node_elements(arg)
        match tc_hash_oblig_mark(owner_oblig, i) {
            HashRole.SetElement => validate_keyed_ann(arg, HashRole.SetElement)
            HashRole.MapKey => validate_keyed_ann(arg, HashRole.MapKey)
            HashRole.Free => {}
        }
        if arg_name == "Map" {
            if arg_elems != -1 && sublist_length(arg_elems) >= 1 {
                validate_keyed_ann(sublist_get(arg_elems, 0), HashRole.MapKey)
            }
        } else if arg_name == "Set" {
            if arg_elems != -1 && sublist_length(arg_elems) >= 1 {
                validate_keyed_ann(sublist_get(arg_elems, 0), HashRole.SetElement)
            }
        }
        tc_validate_type_arg_hashability(tc_hash_oblig_of(arg_name), arg_elems)
        i = i + 1
    }
}

// The role of parameter `i`; Free past the end.
fn tc_hash_oblig_mark(oblig: List[HashRole], i: Int) -> HashRole {
    oblig.get(i) ?? HashRole.Free
}

fn tc_hash_role_is_free(r: HashRole) -> Int {
    match r {
        HashRole.Free => 1
        _ => 0
    }
}

// The roles stored for a declaration node; empty when it has none.
fn tc_hash_oblig_at(decl: Int) -> List[HashRole] {
    let none: List[HashRole] = []
    if decl < 0 { return none }
    tc_hash_oblig.get(decl) ?? none
}

// The roles of a generic type as written in the module under check; empty when it has none.
fn tc_hash_oblig_of(name: Str) -> List[HashRole] {
    let none: List[HashRole] = []
    if name == "" { return none }
    tc_hash_oblig_at(tc_decl_node_for_type(tc_written_type_nominal(name)))
}

// Gives each parameter in `names` that `ann` places in a Set element or Map key position its
// role in `roles`: directly, inside a tuple in that position, or through another generic
// type's role for its parameter. `key_role` is the role `ann` itself is in. Returns 1 when a
// role changed.
fn tc_hash_oblig_walk(ann: Int, key_role: HashRole, names: List[Str], roles: List[HashRole]) -> Int {
    if ann == -1 { return 0 }
    let name = node_name(ann)
    let elems = node_elements(ann)
    let mut changed = 0
    if tc_hash_role_is_free(key_role) == 0 {
        if elems == -1 {
            let mut p = 0
            while p < names.len() {
                if names.get(p).unwrap() == name {
                    if tc_hash_role_is_free(roles.get(p).unwrap()) != 0 {
                        roles.set(p, key_role)
                        return 1
                    }
                    return 0
                }
                p = p + 1
            }
        }
        if name == "Tuple" && elems != -1 {
            let mut t = 0
            while t < sublist_length(elems) {
                if tc_hash_oblig_walk(sublist_get(elems, t), key_role, names, roles) != 0 { changed = 1 }
                t = t + 1
            }
            return changed
        }
    }
    if name == "Fn" {
        if tc_hash_oblig_walk(node_type_ann(ann), HashRole.Free, names, roles) != 0 { changed = 1 }
    }
    if elems == -1 { return changed }
    let owner = if name == "Map" { [HashRole.MapKey] } else if name == "Set" { [HashRole.SetElement] } else { tc_hash_oblig_of(name) }
    let mut i = 0
    while i < sublist_length(elems) {
        if tc_hash_oblig_walk(sublist_get(elems, i), tc_hash_oblig_mark(owner, i), names, roles) != 0 { changed = 1 }
        i = i + 1
    }
    changed
}

// One role per name, from the roles found so far.
fn tc_hash_roles_from(names: List[Str], prior: List[HashRole]) -> List[HashRole] {
    let mut roles: List[HashRole] = []
    let mut i = 0
    while i < names.len() {
        roles.push(tc_hash_oblig_mark(prior, i))
        i = i + 1
    }
    roles
}

// Fills tc_hash_oblig for every generic struct, enum and alias. A parameter can be obliged
// through another declaration's obliged parameter, so this repeats until no mark changes;
// marks are only ever added, so it stops.
fn tc_compute_type_hash_obligations(types_sl: Int) {
    let saved_module = nr_current_module
    let mut changed = 1
    while changed != 0 {
        changed = 0
        let mut i = 0
        while i < sublist_length(types_sl) {
            let td = sublist_get(types_sl, i)
            let tps = node_type_params(td)
            if tps != -1 && sublist_length(tps) > 0 {
                nr_current_module = node_module(td)
                let mut names: List[Str] = []
                let mut p = 0
                while p < sublist_length(tps) {
                    names.push(node_name(sublist_get(tps, p)))
                    p = p + 1
                }
                let roles = tc_hash_roles_from(names, tc_hash_oblig_at(td))
                let mut grew = tc_hash_oblig_walk(node_value(td), HashRole.Free, names, roles)
                let flds = node_fields(td)
                let mut f = 0
                while flds != -1 && f < sublist_length(flds) {
                    let fd = sublist_get(flds, f)
                    if node_kind(fd) == NodeKind.TypeVariant {
                        let vflds = node_fields(fd)
                        let mut v = 0
                        while vflds != -1 && v < sublist_length(vflds) {
                            if tc_hash_oblig_walk(node_value(sublist_get(vflds, v)), HashRole.Free, names, roles) != 0 { grew = 1 }
                            v = v + 1
                        }
                    } else {
                        if tc_hash_oblig_walk(node_value(fd), HashRole.Free, names, roles) != 0 { grew = 1 }
                    }
                    f = f + 1
                }
                if grew != 0 {
                    tc_hash_oblig.insert(td, roles)
                    changed = 1
                }
            }
            i = i + 1
        }
    }
    nr_current_module = saved_module
}

// The roles of the generic fn behind `sig`, over its type parameters in
// signature order: every annotation in its signature and body is scanned, so a
// `let s: Set[T]` in the body obliges T as surely as a `Set[T]` parameter does.
fn tc_fn_hash_obligations(sig: Int) -> List[HashRole] {
    let fs = fnsig_pool.get(sig).unwrap()
    let none: List[HashRole] = []
    if fs.decl < 0 || fs.type_params_count == 0 { return none }
    match tc_hash_oblig.get(fs.decl) {
        Some(o) => { return o }
        None => {}
    }
    let mut names: List[Str] = []
    let mut i = 0
    while i < fs.type_params_count {
        let idx = fs.type_params_start + i
        names.push(if idx < fnsig_type_param_names.len() { fnsig_type_param_names.get(idx).unwrap() } else { "" })
        i = i + 1
    }
    let saved_module = nr_current_module
    nr_current_module = node_module(fs.decl)
    let roles = tc_hash_roles_from(names, none)
    tc_hash_oblig_walk_tree(fs.decl, names, roles)
    nr_current_module = saved_module
    tc_hash_oblig.insert(fs.decl, roles)
    roles
}

fn tc_hash_oblig_walk_tree(id: Int, names: List[Str], roles: List[HashRole]) {
    for sp in node_spell_child_ids(id) { tc_hash_oblig_walk(sp, HashRole.Free, names, roles) }
    for c in node_value_child_ids(id) { tc_hash_oblig_walk_tree(c, names, roles) }
}

// Tri-state Hash verdict on a concrete type, by the spec's closed list
// (sections/03_types.md, "Non-hashable keys and elements in general"): 1 hashable, -1 not,
// 0 unknown (never rejects). The list is closed: the spec gives every type it does not name
// no Hash, so a kind not matched here, including one added later, is refused.
fn tc_tid_hash_fact(tid0: Int) -> Int {
    let tid = tc_resolve(tid0)
    match type_kind(tid) {
        TyKind.Unknown => 0
        TyKind.Typevar => 0
        TyKind.Int => 1
        TyKind.Bool => 1
        TyKind.Char => 1
        TyKind.Str => 1
        TyKind.Void => 1
        TyKind.Never => 1
        TyKind.I8 => 1
        TyKind.I16 => 1
        TyKind.I32 => 1
        TyKind.U8 => 1
        TyKind.U16 => 1
        TyKind.U32 => 1
        TyKind.U64 => 1
        TyKind.Tuple => tc_tuple_hash_fact(tid)
        TyKind.Struct => tc_nominal_hash_fact(tid)
        TyKind.Enum => tc_nominal_hash_fact(tid)
        _ => -1
    }
}

fn tc_tuple_hash_fact(tid: Int) -> Int {
    let te = ty_pool.get(tid).unwrap()
    let mut verdict = 1
    let mut i = 0
    while i < te.params_count {
        let f = tc_tid_hash_fact(ty_param_list.get(te.params_start + i).unwrap())
        if f == -1 { return -1 }
        if f == 0 { verdict = 0 }
        i = i + 1
    }
    verdict
}

fn tc_nominal_hash_fact(tid: Int) -> Int {
    // A type with no declaration node is compiler-provided; its Hash is not ours to judge.
    let td = tc_type_decl_node_by_tid.get(tid) ?? -1
    if td == -1 && tc_decl_node_for_type(tc_tid_name(tid)) == -1 { return 0 }
    tc_tid_derive_fact(tid, "Hash")
}

// E1400 at a call whose type argument is used by the callee as a Set element or Map key
// and is provably not hashable. Only a -1 verdict reports.
fn tc_check_hash_obligations_for_binds(sig: Int, binds: Map[Str, Int], node: Int) ! TypeCheck.Resolve, Diag.Report {
    let oblig = tc_fn_hash_obligations(sig)
    if oblig.len() == 0 { return }
    let fs = fnsig_pool.get(sig).unwrap()
    let mut i = 0
    while i < fs.type_params_count {
        let role = tc_hash_oblig_mark(oblig, i)
        let idx = fs.type_params_start + i
        if role != HashRole.Free && idx < fnsig_type_param_names.len() {
            let name = fnsig_type_param_names.get(idx).unwrap()
            let bound = binds.get(name) ?? -1
            // A part already known can refuse a bind that is still open (`(Float, ?)`); any
            // other open bind is judged by tc_ud_flush_calls once a later use has solved it.
            if bound != -1 && tc_tid_hash_fact(bound) == -1 {
                tc_report_unhashable_bind(sig, name, role, bound, node)
            }
        }
        i = i + 1
    }
}

fn tc_report_unhashable_bind(sig: Int, name: Str, role: HashRole, bound: Int, node: Int) ! Diag.Report {
    let fs = fnsig_pool.get(sig).unwrap()
    diag_error_at("MapKeyNotHashable", MAP_KEY_NOT_HASHABLE,
        "`{type_to_str(tc_resolve(bound))}` does not implement Hash — `{node_name(fs.decl)}` uses its type parameter {name} as a {tc_hash_role_words(role).title}", node,
        "use a hashable scalar (Int/sized-int/Bool/Char/Str), a tuple of hashable types, or a @derive(Hash, Eq) struct/enum for {name}")
}

// Does deriving `listed` oblige `tr`: the trait itself, or one its built-in supertraits
// reach. The relation is shallow and acyclic (Ord -> Eq, Hash -> Eq); the walk is bounded
// so a future entry that closed a cycle could not hang the compiler.
fn tc_derive_obliges(listed: Str, tr: Str) -> Int {
    let mut cur = listed
    let mut steps = 0
    while cur != "" && steps < 8 {
        if cur == tr { return 1 }
        cur = builtin_trait_supers(cur)
        steps = steps + 1
    }
    0
}

// Every name @derive accepts. This is the one list: the derive stage of codegen reads it
// here rather than keeping a second copy, because two copies disagree the day one gains a
// name and the check that rejects an unknown name starts rejecting a legal one.
pub fn tc_derive_names() -> List[Str] {
    ["Eq", "Ord", "Hash", "Clone", "Debug", "Serialize", "Deserialize"]
}

// The note that lists what @derive takes. It names every trait §3.6.1 lists, Display too:
// the spec is what a user writes against, and @derive(Display) has its own E1402 until
// codegen can synthesize it.
fn tc_derive_takes_note() -> Str {
    "@derive takes Eq, Ord, Hash, Clone, Display, Debug, Serialize, Deserialize (§3.6.1)"
}

// The compiler-known trait a @derive argument denotes, or "" when it denotes none @derive
// accepts. The argument is a name the user writes, so it resolves by the scope of the file
// that wrote it (sections/03_types.md §3.6.1): in a module that shadows `Eq`, `@derive(Eq)`
// names the local trait, and `@derive(CoreEq)` under `import blink.core.{Eq as CoreEq}`
// names the compiler-known one. Every reader of a derive asks here, never the spelling.
pub fn tc_derive_arg_trait(a: Int) -> Str {
    let key = tc_derive_arg_key(a)
    if tc_derive_names().contains(key) && tc_trait_is_compiler_known(key) { key } else { "" }
}

// The trait a @derive argument names, by its key, or "" when it names none: a qualified
// name whose module does not declare it names nothing, not the compiler-known trait of
// its bare name.
fn tc_derive_arg_key(a: Int) -> Str {
    let written = node_name(a)
    if strip_module_qualifier(written) != written { return tc_qualified_trait_key(written, node_module(a)) }
    tc_trait_ref_key(written, node_module(a))
}

// Every @derive argument is checked where the author can still see the annotation, since
// codegen derives only the names it knows and would drop the rest without a word.
fn tc_reject_unknown_derives(td: Int) ! Diag.Report {
    for a in tc_decl_derive_args(td) {
        if tc_derive_arg_trait(a) == "" { tc_report_not_derivable(a) }
    }
}

// One E1402 for every argument that does not denote a derivable compiler-known trait, worded
// for what the name does denote (sections/07 §10.6, ERROR_CATALOG E1402).
fn tc_report_not_derivable(a: Int) ! Diag.Report {
    let name = node_name(a)
    let key = tc_derive_arg_key(a)
    let takes = tc_derive_takes_note()
    let decl = tc_trait_node_idx.get(key) ?? -1
    if key != "" && tc_trait_is_compiler_known(key) {
        let why = if key == "Display" { "this compiler does not synthesize it yet" } else { "it is not a derivable trait" }
        diag_error_at_notes("NotDerivable", NOT_DERIVABLE, "cannot derive `{name}`: {why}", a, "implement `{name}` by hand", [takes])
        return
    }
    if decl == -1 {
        diag_error_at_notes("NotDerivable", NOT_DERIVABLE,
            "cannot derive `{name}`: no trait named `{name}` is in scope", a,
            "use one of the traits @derive takes", [takes])
        return
    }
    let declared = tc_trait_spelling(key)
    let site = "{diag_normalize_path(diag_file_for_node(decl))}:{node_line(decl)}"
    // The order of §10.6's golden: the label, what @derive takes, then the shadow.
    let mut notes = ["`{name}` here is `trait {declared}` ({site}), a user trait", takes]
    let mut help = "implement `{name}` by hand"
    if tc_trait_is_compiler_known(declared) {
        notes.push("`{name}` here is `trait {declared}` ({site}), which shadows the compiler-known `{declared}` (blink.core)")
        if tc_derive_names().contains(declared) {
            let in_mod = node_module(a)
            let imp = tc_core_import_in(declared, in_mod)
            let fix = "write @derive({tc_core_name_in(declared, in_mod)})"
            help = if imp == "" { fix } else { "{imp}\nthen {fix}" }
        }
    }
    diag_error_at_notes("NotDerivable", NOT_DERIVABLE,
        "cannot derive `{name}`: it is not a compiler-known trait", a, help, notes)
}

// Every name written in every @derive on a declaration, as the annotation argument nodes.
// A node carries both the name and its span, so a diagnostic about one derive name can
// point at that name.
pub fn tc_decl_derive_args(decl: Int) -> List[Int] {
    let mut out: List[Int] = []
    if decl < 0 { return out }
    let anns = node_handlers(decl)
    if anns == -1 { return out }
    let mut i = 0
    while i < sublist_length(anns) {
        let ann = sublist_get(anns, i)
        if node_name(ann) == "derive" {
            let args_sl = node_args(ann)
            if args_sl != -1 {
                let mut j = 0
                while j < sublist_length(args_sl) {
                    out.push(sublist_get(args_sl, j))
                    j = j + 1
                }
            }
        }
        i = i + 1
    }
    out
}

// Does the declaration `td` derive `tr`, by naming it or by naming a trait whose
// supertrait obligation reaches it? Deriving Ord or Hash derives Eq as well when the
// author did not list it (spec sections/03_types.md, "Supertrait Auto-Derivation"), so
// every reader of a derive fact answers from the expanded set; a reader that answered
// from the written list alone would disagree with the methods codegen synthesizes.
// Scans EVERY @derive annotation, not just the first. get_annotation returns only the
// first match, so `@derive(Eq)` + `@derive(Ord)` on separate lines hid the second derive.
pub fn tc_decl_derives(td: Int, tr: Str) -> Int {
    for a in tc_decl_derive_args(td) {
        if tc_derive_obliges(tc_derive_arg_trait(a), tr) != 0 { return 1 }
    }
    0
}

// Whether no declaration may take `name`: the §10.6 reserved names, plus Fn and Tuple, which
// the parser still writes as the head of a function or tuple annotation, so a declaration
// that took one would change what those annotations mean.
fn tc_type_name_is_undeclarable(name: Str) -> Bool {
    tc_type_name_is_reserved(name) || name == "Fn" || name == "Tuple"
}

// Reports E0524 when `decl` (a `kw` declaration) takes a reserved name. The caller then
// registers nothing for it, so the builtin keeps the name and no use of it reports again.
fn tc_reject_reserved_decl_name(decl: Int, kw: Str) -> Bool ! Diag.Report {
    let name = node_name(decl)
    if !tc_type_name_is_undeclarable(name) { return false }
    let reason = match name {
        "Self" => "reserved: `Self` names the implementing type in every trait and impl"
        "Void" => "reserved: `Void` is the type of no value in every module"
        "Fn" => "reserved: the compiler names function types `Fn`"
        "Tuple" => "reserved: the compiler names tuple types `Tuple`"
        _ => "reserved: literals produce this type in every module"
    }
    diag_error_at_notes("ReservedTypeName", RESERVED_TYPE_NAME, "`{name}` is a reserved type name", decl, "choose another name, for example `{kw} {name}Value`", [reason])
    true
}

fn register_struct_type(td: Int) ! TypeCheck.Register, TypeCheck.Resolve, Diag.Report {
    if tc_reject_reserved_decl_name(td, "type") { return }
    tc_reject_unknown_derives(td)
    let name = tc_nominal_type_name(td)
    let tid = new_type(TyKind.Struct, name)
    named_type_names.push(name)
    named_type_ids.push(tid)
    tc_register_type_decl_node(node_name(td), name, tid, td)
    named_type_map.insert(name, tid)
    tc_struct_decl_nodes.insert(name, td)
    if has_annotation(td, "ffi.struct") != 0 {
        ffi_struct_type_set.insert(tid, 1)
    }

    if has_annotation(td, "ffi.opaque") != 0 {
        ffi_opaque_type_set.insert(tid, 1)
    }
    tc_warn_missing_canonical_header(td, "ffi.struct")
    tc_warn_missing_canonical_header(td, "ffi.opaque")

    if has_annotation(td, "deprecated") != 0 {
        depr_type_nodes.insert(name, td)
    }
}

// W0812 (§9.1.3, §9.1.4): the header an @ffi type mirrors must be pinned in blink.toml, or
// layout drift goes unnoticed. With no manifest there is no place to pin it, so there is
// nothing to warn about. A stdlib @ffi type rides a compiler-managed native dep the user
// never declares, so it is exempt.
fn tc_warn_missing_canonical_header(td: Int, ann_name: Str) ! Diag.Report {
    let ann = get_annotation(td, ann_name)
    if ann == -1 || manifest_name == "" { return }
    let header = get_str_named_arg(ann, "header")
    if header == "" || manifest_header_is_declared(header) != 0 { return }
    if node_source_module(td).starts_with("std_") { return }
    diag_warn_at(
        "MissingCanonicalHeader",
        MISSING_CANONICAL_HEADER,
        "@{ann_name} '{node_name(td)}' declares header '{header}' but no [native-dependencies] entry in blink.toml lists it",
        td,
        "add the header to blink.toml: [native-dependencies] <dep>.headers = [\"{header}\"]"
    )
}

// Resolve a struct's field type annotations. Split out of register_struct_type
// so it runs AFTER every type name is interned and every alias underlying is
// resolved: a field may reference an alias (`items: List[MB]`) whose target — or
// whose own declaration — comes later in the file, and resolving it during the
// name-registration pass would peel to an orphan typevar.
fn resolve_struct_fields(td: Int) ! TypeCheck.Register, TypeCheck.Resolve, Diag.Report {
    let tid = tc_decl_tid(td)
    let is_ffi_struct = has_annotation(td, "ffi.struct")
    let decl_tparams = node_type_params(td)
    tc_push_tparam_scope(decl_tparams)
    let flds_sl = node_fields(td)
    if flds_sl != -1 {
        let mut i = 0
        while i < sublist_length(flds_sl) {
            let f = sublist_get(flds_sl, i)
            let fname = node_name(f)
            let ftype_ann = node_value(f)
            let ftype_ann_name = node_name(ftype_ann)
            // `Buf` has no type to resolve to yet; E0822 is the whole answer for the field.
            let is_buf_field = is_ffi_struct != 0 && tc_compiler_known_type_meant(ftype_ann_name, ftype_ann) == "Buf"
            let ftype_id = if is_buf_field { TYPE_UNKNOWN } else { resolve_type_ann(ftype_ann) }
            sfield_pool.push(TcStructField { struct_id: tid, name: fname, type_id: ftype_id })
            if ftype_ann_name == "Fn" {
                if is_callable_field_name(fname) == 0 {
                    nr_callable_field_names.push(fname)
                }
            }
            if is_buf_field {
                diag_error_at("BufOutsideFfiSurface", BUF_OUTSIDE_FFI_SURFACE, "@ffi.struct field `{fname}` names `Buf` — a `Buf` is a `blink_buf_t*`, not the C pointer the field declares", f, "use `Ptr[T]` for a C pointer field")
            } else if is_ffi_struct != 0 {
                if ffi_struct_field_type_ok(ftype_ann_name, ftype_id) == 0 {
                    diag_error_at("FfiStructGcField", FFI_STRUCT_GC_FIELD, "@ffi.struct field `{fname}` uses non-FFI type `{ftype_ann_name}` — only sized FFI-compatible types (I8/I16/I32/I64, U8/U16/U32/U64, Int, Float, F32, F64, Bool), `Ptr[T]` and other @ffi.struct types are allowed", f, "use a sized integer/float/bool type, a `Ptr[T]`, or another @ffi.struct type")
                }
            }
            i = i + 1
        }
    }
    tc_pop_tparam_scope(decl_tparams)
}

fn register_enum_type(td: Int) ! TypeCheck.Register, TypeCheck.Resolve, Diag.Report {
    if tc_reject_reserved_decl_name(td, "type") { return }
    tc_reject_unknown_derives(td)
    let name = tc_nominal_type_name(td)
    let tid = new_type(TyKind.Enum, name)
    named_type_names.push(name)
    named_type_ids.push(tid)
    tc_register_type_decl_node(node_name(td), name, tid, td)
    named_type_map.insert(name, tid)
    if has_annotation(td, "deprecated") != 0 {
        depr_type_nodes.insert(name, td)
    }
}

// Resolve an enum's variant payload annotations. Split out of register_enum_type
// so it runs AFTER every type name is interned and every alias underlying is
// resolved: a payload may reference an alias (`Wrap(o: MB)`) whose target — or
// whose own declaration — comes later in the file, and resolving it during the
// name-registration pass would peel to an orphan typevar.
fn resolve_enum_variants(td: Int) ! TypeCheck.Register, TypeCheck.Resolve, Diag.Report {
    let name = tc_nominal_type_name(td)
    let tid = tc_decl_tid(td)
    let decl_tparams = node_type_params(td)
    tc_push_tparam_scope(decl_tparams)
    let flds_sl = node_fields(td)
    if flds_sl != -1 {
        let mut _tag = 0
        let mut i = 0
        while i < sublist_length(flds_sl) {
            let v = sublist_get(flds_sl, i)
            let vname = node_name(v)
            let var_idx = evar_pool.len()

            let vflds_sl = node_fields(v)
            let mut _has_data = 0
            if vflds_sl != -1 && sublist_length(vflds_sl) > 0 {
                _has_data = 1
                let mut fi = 0
                while fi < sublist_length(vflds_sl) {
                    let vf = sublist_get(vflds_sl, fi)
                    let vf_name = node_name(vf)
                    let vf_type_ann = node_value(vf)
                    let mut vf_type_id = resolve_type_ann(vf_type_ann)
                    // A generic-enum instance field (`Branch(left: Tree[T], …)`) or a
                    // tuple wrapping one (`Pair(p: (Box[T], Box[T]))`) interns its
                    // typevar slots so reverse-inference and pattern binders can bind T
                    // from a concrete instance instead of erasing to the bare base.
                    let inst = tc_evfield_structural_tid(vf_type_ann, vf_type_id, name, 1)
                    if inst != -1 { vf_type_id = inst }
                    evfield_pool.push(EnumVariantFieldEntry { var_idx: var_idx, name: vf_name, type_id: vf_type_id })
                    fi = fi + 1
                }
            }
            evar_pool.push(EnumVariantEntry { enum_id: tid, name: vname, tag: _tag, has_data: _has_data, enum_decl: td })
            evar_decl_nodes.push(v)
            let mut name_slots = evar_slots_by_name.get(vname) ?? []
            name_slots.push(var_idx)
            evar_slots_by_name.insert(vname, name_slots)

            _tag = _tag + 1
            i = i + 1
        }
    }
    tc_pop_tparam_scope(decl_tparams)
}

// A field of a @derive(Debug) type whose own type is a user struct/enum must
// itself derive Debug — the generated debug() renders each field via its
// debug(). A built-in scalar / Str is always OK; a user type is OK iff it
// itself carries @derive(Debug).
fn tc_debug_field_ok(ftype_name: Str) -> Int {
    if named_type_map.contains_key(ftype_name) == 0 { return 1 }
    if tc_type_name_derives(ftype_name, "Debug") != 0 { return 1 }
    0
}

// The Debug field check for a leaf annotation that `core`, what it means
// (tc_compiler_known_type_meant), may name as a compiler-known type. A builtin with a prelude
// declaration (Ordering, ConversionError) answers by that declaration, not by a namesake.
fn tc_debug_leaf_ok(written: Str, core: Str) -> Int {
    if core == "" { return tc_debug_field_ok(written) }
    let td = tc_prelude_type_decl(core)
    if td == -1 { 1 } else { tc_decl_derives(td, "Debug") }
}

// The container type constructors that the v1 Debug renderer can walk
// (or that the typecheck rule peels into the element/key/value check).
// Set/Result are container-shaped but NOT in the v1 renderable set.
fn tc_is_container_name(n: Str) -> Int {
    if n == "List" || n == "Option" || n == "Map" || n == "Set" || n == "Result" { return 1 }
    0
}

// Leaf type names that reach the Debug field check but are NOT Debug-renderable in v1 and
// can never be made so by adding a derive:
//   fn(...) -> T  → "Fn" (parser.bl:1437); (A, B) → "Tuple" (parser.bl:1408;
//   tuples auto-derive Eq/Ord/Hash/Display/Clone but NOT Debug, spec §3.6);
//   handler[E] → "Handler" (parser.bl:1453); Raw[Str] → "Raw", a marker with no Debug
//   (§3b.5). Rejected E0520 like Set/Result
//   else they slip past tc_debug_field_ok and emit BLINK_COMPILER_BUG.
//
// "Void" is the one entry that is NOT a parser pseudo-type — it is an ordinary inhabited
// type (decisions/under-determined-types.md:39) — but it belongs here for the same reason
// "Tuple" does: `()` IS the 0-tuple, so rejecting the n-tuple and rendering the 0-tuple
// would be incoherent, and Void's single value carries no information to render. A
// declared Void field lowers to an int64_t placeholder, so without this arm the type
// builds and RUNS, printing `<?>` for the field with a BLINK_COMPILER_BUG marker compiled
// into the binary — a silent wrong answer instead of a diagnostic.
fn tc_is_non_debug_pseudo_type(n: Str, core: Str) -> Int {
    if n == "Fn" || n == "Tuple" || n == "Void" { return 1 }
    if core == "Raw" || core == "Handler" { return 1 }
    0
}

// Is `tname` a user STRUCT (not an enum)? A struct decl's fields are plain
// TypeField nodes; an enum decl's first field is a TypeVariant (same shape used
// at whole-program registration, typecheck.bl:2644). Returns 0 for unknown /
// non-user names.
pub fn tc_type_is_struct(tname: Str) -> Int {
    let td = tc_type_decl_nodes.get(tname) ?? -1
    if td == -1 { return 0 }
    let flds = node_fields(td)
    if flds != -1 && sublist_length(flds) > 0 {
        if node_kind(sublist_get(flds, 0)) == NodeKind.TypeVariant { return 0 }
    }
    1
}

// The Map-key types the v1 renderer can read back through the kops storage
// layer. Two families: (a) scalars — Str / Char / Int / Bool / sized ints,
// stored inline (Char in single-quoted debug-form, decisions/char-debug-form.md);
// (b) @derive(Debug, Hash, Eq) user STRUCTS, read via blink_map_key_slot (which
// dereferences the inline_key=0 pointer) and rendered via {sname}_debug (mirrors
// the struct-VALUE path). Enums and non-Debug user types are still rejected
// (E0520 via tc_check_debug_element).
fn tc_debug_map_key_ok(key_name: Str) -> Int {
    if key_name == "Str" || key_name == "Char" || key_name == "Int" || key_name == "Bool" { return 1 }
    if key_name == "I8" || key_name == "I16" || key_name == "I32" || key_name == "I64" { return 1 }
    if key_name == "U8" || key_name == "U16" || key_name == "U32" || key_name == "U64" { return 1 }
    if tc_type_is_struct(key_name) != 0 && tc_type_name_derives(key_name, "Debug") != 0 { return 1 }
    0
}

// Check one element / value of a Debug-renderable container field. The rule is
// fully inductive (spec §3.6): a non-Debug leaf → E0520; a Set/Result element →
// E0520 (not renderable at any level); a List/Option/Map element recurses into
// its own element/key/value checks so arbitrary nesting is proven Debug.
fn tc_check_debug_element(elem_ann: Int, f: Int, tname: Str) ! Diag.Report {
    let elem_name = node_name(elem_ann)
    let core = tc_compiler_known_type_meant(elem_name, elem_ann)
    if tc_is_non_debug_pseudo_type(elem_name, core) != 0 {
        diag_error_at("DeriveDebugFieldNoDebug", DERIVE_DEBUG_FIELD_NO_DEBUG, "@derive(Debug) on `{tname}`: field `{node_name(f)}` has element type `{elem_name}` which is not Debug-renderable in v1", f, "implement Debug manually for this field's type")
        return
    }
    if tc_is_container_name(core) != 0 {
        // Nested container: Set/Result are still rejected at every level; the
        // renderable containers (List/Option/Map) recurse.
        if core == "Set" || core == "Result" {
            diag_error_at("DeriveDebugFieldNoDebug", DERIVE_DEBUG_FIELD_NO_DEBUG, "@derive(Debug) on `{tname}`: field `{node_name(f)}` has element type `{elem_name}` which is not Debug-renderable (only List/Option/Map containers render)", f, "implement Debug manually for this field's type")
            return
        }
        tc_check_container_elems(elem_ann, core, f, tname)
        return
    }
    if tc_debug_leaf_ok(elem_name, core) == 0 {
        diag_error_at("DeriveDebugFieldNoDebug", DERIVE_DEBUG_FIELD_NO_DEBUG, "@derive(Debug) on `{tname}`: field `{node_name(f)}` has element type `{elem_name}` which does not derive Debug", f, "{tc_derive_fix_imports(["Debug"], elem_name)}add @derive({tc_derive_arg_for("Debug", elem_name)}) to `{elem_name}`")
    }
}

// Peel a List/Option/Map container annotation `ann` and check its element (or
// key + value) types. Shared between the top-level field check and the nested
// recursion in tc_check_debug_element, so nesting is pure composition. The
// caller guarantees `ann` names List / Option / Map (Set/Result rejected first).
fn tc_check_container_elems(ann: Int, core: Str, f: Int, tname: Str) ! Diag.Report {
    let elems_sl = node_elements(ann)
    if core == "Map" {
        if elems_sl != -1 && sublist_length(elems_sl) >= 2 {
            let key_ann = sublist_get(elems_sl, 0)
            let key_name = node_name(key_ann)
            if tc_debug_map_key_ok(key_name) != 0 {
                tc_check_debug_element(key_ann, f, tname)
            } else if tc_type_is_struct(key_name) != 0 {
                // A user STRUCT key that isn't Debug (tc_debug_map_key_ok gates
                // the Debug ones above): let tc_check_debug_element emit the
                // precise "does not derive Debug" diagnostic.
                tc_check_debug_element(key_ann, f, tname)
            } else {
                // Container map keys (List/Map/Option/Set/Result) and other
                // unsupported keys land here — container keys stay rejected,
                // which is why the map-debug emitter never recurses on keys.
                diag_error_at("DeriveDebugFieldNoDebug", DERIVE_DEBUG_FIELD_NO_DEBUG, "@derive(Debug) on `{tname}`: field `{node_name(f)}` has Map key type `{key_name}` which v1 Debug cannot render (Str/Char/Int/Bool/sized-int keys, or a @derive(Debug, Hash, Eq) struct key)", f, "use a supported scalar key or a Debug struct key, or implement Debug manually")
            }
            tc_check_debug_element(sublist_get(elems_sl, 1), f, tname)
        }
        return
    }

    // List / Option: peel element 0.
    if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
        tc_check_debug_element(sublist_get(elems_sl, 0), f, tname)
    }
}

// Reject one field `f` of a @derive(Debug) type `tname` whose type — or whose
// container element/key/value type — does not derive Debug. `is_variant_field`
// is 1 when `f` is a field of an enum variant; container Debug rendering applies
// to struct fields AND enum-variant fields, so the param is threaded
// only to keep call sites unchanged.
fn tc_check_one_debug_field(f: Int, tname: Str, _is_variant_field: Int) ! Diag.Report {
    let ann = node_value(f)
    let ftype_name = node_name(ann)
    let core = tc_compiler_known_type_meant(ftype_name, ann)

    if tc_is_non_debug_pseudo_type(ftype_name, core) != 0 {
        diag_error_at("DeriveDebugFieldNoDebug", DERIVE_DEBUG_FIELD_NO_DEBUG, "@derive(Debug) on `{tname}`: field `{node_name(f)}` has type `{ftype_name}` which is not Debug-renderable in v1", f, "implement Debug manually for this field's type")
        return
    }

    if tc_is_container_name(core) == 0 {
        if tc_debug_leaf_ok(ftype_name, core) == 0 {
            diag_error_at("DeriveDebugFieldNoDebug", DERIVE_DEBUG_FIELD_NO_DEBUG, "@derive(Debug) on `{tname}`: field `{node_name(f)}` has type `{ftype_name}` which does not derive Debug", f, "{tc_derive_fix_imports(["Debug"], ftype_name)}add @derive({tc_derive_arg_for("Debug", ftype_name)}) to `{ftype_name}`")
        }
        return
    }

    // Field is a container type. Set/Result are not renderable at any level.
    if core == "Set" || core == "Result" {
        diag_error_at("DeriveDebugFieldNoDebug", DERIVE_DEBUG_FIELD_NO_DEBUG, "@derive(Debug) on `{tname}`: field `{node_name(f)}` has type `{ftype_name}` which is not Debug-renderable in v1 (only List/Option/Map containers render)", f, "implement Debug manually for this field's type")
        return
    }

    tc_check_container_elems(ann, core, f, tname)
}

fn tc_check_derive_debug() ! Diag.Report {
    let mut ti = 0
    while ti < named_type_names.len() {
        let tname = named_type_names.get(ti).unwrap()
        let td = tc_decl_node_for_type(tname)
        if td != -1 && tc_decl_derives(td, "Debug") != 0 {
            // A field annotation means what it means in the declaring module.
            let saved_module = tc_enter_body_module(td)
            let flds_sl = node_fields(td)
            let mut i = 0
            while flds_sl != -1 && i < sublist_length(flds_sl) {
                let f = sublist_get(flds_sl, i)
                if node_kind(f) == NodeKind.TypeVariant {
                    let vflds_sl = node_fields(f)
                    let mut vi = 0
                    while vflds_sl != -1 && vi < sublist_length(vflds_sl) {
                        tc_check_one_debug_field(sublist_get(vflds_sl, vi), tname, 1)
                        vi = vi + 1
                    }
                } else {
                    tc_check_one_debug_field(f, tname, 0)
                }
                i = i + 1
            }
            tc_leave_body_module(saved_module)
        }
        ti = ti + 1
    }
}

// ---------------------------------------------------------------------------
// E1401 NonDerivableTrait — spec §3.6.6: a @derive(Hash/Eq/Ord) type may only
// contain fields whose type itself implements the derived trait. Modeled on
// tc_check_derive_debug (the Debug-field pass). Fail-open on generic /
// unresolved names so the compiler's own generic code keeps typechecking.
//
// Eq asks each field what `==` asks of its type (tc_eq_need), so a container field is
// `Eq` when its parts are. Hash and Ord still go by the field's written name:
// collections are rejected under both, Float is not Hashable and Bool is not Orderable.

// Is a bare scalar type name integer-like (Int / sized ints / Char)?
fn tc_is_integer_scalar(n: Str) -> Int {
    if n == "Int" || n == "Char" { return 1 }
    if n == "I8" || n == "I16" || n == "I32" || n == "I64" { return 1 }
    if n == "U8" || n == "U16" || n == "U32" || n == "U64" { return 1 }
    0
}

fn tc_is_float_scalar(n: Str) -> Int {
    if n == "Float" || n == "F32" || n == "F64" { return 1 }
    0
}

// Does the named field type satisfy `tr` ("Hash"/"Ord")? Returns 1 for
// OK, 0 for reject. Fails OPEN (returns 1) for names that are neither a builtin
// scalar nor a known user type — generics / type params we can't resolve here.
fn tc_field_type_derivable(written: Str, tr: Str) -> Int {
    // An alias stands for its target everywhere else in the type system, so the trait is
    // asked of what the name resolves to. The caller keeps the written name for the
    // message, because that is the text the author can change.
    let ftype_name = resolve_alias_type_name(written)

    // Collections are never hashable or orderable in v1.
    if tc_is_container_name(ftype_name) != 0 { return 0 }

    // Tuple struct fields: a tuple is structurally Hash/Eq/Ord when its
    // elements are, but codegen (emit_struct_hash/_eq/_cmp) cannot synthesize a
    // per-tuple adapter for a struct FIELD today — it emits a BLINK_COMPILER_BUG
    // sentinel and a degenerate constant hash. Reject here so the failure is a
    // clear E1401 instead of a silent hash collapse. (Tuples as Map KEYS take a
    // different codegen path and remain supported.)
    if ftype_name == "Tuple" { return 0 }

    if tc_is_integer_scalar(ftype_name) != 0 { return 1 }
    if ftype_name == "Str" {
        // Str is Hash + Eq + Ord.
        return 1
    }
    if ftype_name == "Bool" {
        // Bool: Hash + Eq, but NOT Ord.
        if tr == "Ord" { return 0 }
        return 1
    }
    if tc_is_float_scalar(ftype_name) != 0 {
        // Float: Eq + Ord, but NOT Hash.
        if tr == "Hash" { return 0 }
        return 1
    }

    // User type: it must itself carry the trait (derive or hand-impl).
    let bare = strip_module_qualifier(ftype_name)
    let nominal = tc_written_type_nominal(ftype_name)
    if named_type_map.contains_key(nominal) || named_type_map.contains_key(bare) {
        if tr == "Hash" {
            if tc_type_name_derives(nominal, "Hash") != 0 { return 1 }
            return 0
        }
        // Ord
        if tc_type_has_ord_impl(nominal) != 0 || tc_type_has_ord_impl(bare) != 0 { return 1 }
        return 0
    }

    // Generic type param / unknown name — fail open.
    1
}

fn tc_check_one_derive_trait_field(f: Int, ftid: Int, tname: Str, tr: Str) ! Diag.Report {
    let ann = node_value(f)
    let ftype_name = node_name(ann)
    let generic_help = "remove the field from the derive, give it a type that implements {tr}, or implement {tr} by hand"
    if tr == "Eq" {
        tc_check_derive_eq_field(f, ftid, tname, generic_help)
        return
    }
    if tc_field_type_derivable(ftype_name, tr) == 0 {
        diag_error_at("NonDerivableTrait", NON_DERIVABLE_TRAIT, "@derive({tr}) on `{tname}`: field `{node_name(f)}` has type `{ftype_name}` which does not implement {tr}", f, generic_help)
    }
}

// A derived Eq compares each field the way `==` would (03_types.md, *Derived Equality*),
// so a field is asked what `==` asks of its type. The field's declared tid is read over the
// type's own binders, which pass here: a generic derive is `Eq` where its arguments are,
// and that is asked at each instance.
fn tc_check_derive_eq_field(f: Int, ftid: Int, tname: Str, generic_help: Str) ! Diag.Report {
    if ftid < 0 { return }
    let path = tc_eq_need(ftid, [])
    if path.len() == 0 { return }
    let mut notes: List[Str] = []
    let mut i = 0
    while i + 1 < path.len() {
        notes.push("`{type_to_str(path.get(i).unwrap())}` is `Eq` only if `{type_to_str(path.get(i + 1).unwrap())}` is `Eq`")
        i = i + 1
    }
    let leaf = path.get(path.len() - 1).unwrap()
    let k = type_kind(leaf)
    let help = if k == TyKind.Struct || k == TyKind.Enum {
        let base = if k == TyKind.Struct { tc_struct_base_tid(leaf) } else { tc_enum_base_tid(leaf) }
        let bname = strip_module_qualifier(tc_type_name(base))
        "{tc_derive_fix_imports(["Eq"], bname)}add `@derive({tc_derive_arg_for("Eq", bname)})` to `type {bname}`"
    } else {
        generic_help
    }
    diag_error_at_notes("NonDerivableTrait", NON_DERIVABLE_TRAIT,
        "@derive(Eq) on `{tname}`: field `{node_name(f)}` has type `{type_ann_text(node_value(f))}` which does not implement Eq",
        f, help, notes)
}

// The declared tid of the struct field `f`, or of the `fi`th field of variant `v`; -1 when
// the pools hold no entry for it.
fn tc_derive_struct_field_tid(ttid: Int, f: Int) -> Int {
    if ttid < 0 || type_kind(ttid) != TyKind.Struct { return -1 }
    get_struct_field_tid(ttid, node_name(f))
}

fn tc_derive_variant_field_tid(v: Int, fi: Int) -> Int {
    let mut slot = 0
    while slot < evar_decl_nodes.len() {
        if evar_decl_nodes.get(slot).unwrap() == v {
            let fslots = tc_evar_field_slots(slot)
            if fi >= fslots.len() { return -1 }
            return tc_evfield_tid(fslots.get(fi).unwrap())
        }
        slot = slot + 1
    }
    -1
}

fn tc_check_one_derive_trait(tr: Str) ! Diag.Report {
    let mut ti = 0
    while ti < named_type_names.len() {
        let tname = named_type_names.get(ti).unwrap()
        let td = tc_type_decl_nodes.get(tname) ?? -1
        if td != -1 && tc_decl_derives(td, tr) != 0 {
            let ttid = named_type_ids.get(ti) ?? -1
            let saved_module = nr_current_module
            nr_current_module = node_module(td)
            let flds_sl = node_fields(td)
            let mut i = 0
            while flds_sl != -1 && i < sublist_length(flds_sl) {
                let f = sublist_get(flds_sl, i)
                if node_kind(f) == NodeKind.TypeVariant {
                    let vflds_sl = node_fields(f)
                    let mut vi = 0
                    while vflds_sl != -1 && vi < sublist_length(vflds_sl) {
                        tc_check_one_derive_trait_field(sublist_get(vflds_sl, vi), tc_derive_variant_field_tid(f, vi), tname, tr)
                        vi = vi + 1
                    }
                } else {
                    tc_check_one_derive_trait_field(f, tc_derive_struct_field_tid(ttid, f), tname, tr)
                }
                i = i + 1
            }
            nr_current_module = saved_module
        }
        ti = ti + 1
    }
}

// A handle the compiler cannot see inside exposes no field a derived method could read,
// so the derive is refused where the author wrote it. The stage that would have to write
// the body reports the same shape as an internal error, which is the wrong reader: there
// is nothing wrong with the compiler, only with the annotation.
fn tc_check_derive_opaque_handle() ! Diag.Report {
    let mut ti = 0
    while ti < named_type_names.len() {
        let tname = named_type_names.get(ti).unwrap()
        let td = tc_type_decl_nodes.get(tname) ?? -1
        let ttid = named_type_ids.get(ti) ?? -1
        if td != -1 && ttid >= 0 && ffi_opaque_type_set.contains_key(tc_resolve(ttid)) != 0 {
            for a in tc_decl_derive_args(td) {
                // A name @derive does not take is reported once, where it is resolved.
                if tc_derive_arg_trait(a) == "" { continue }
                let tr = node_name(a)
                diag_error_at("NonDerivableTrait", NON_DERIVABLE_TRAIT,
                    "@derive({tr}) on `{tname}`: an @ffi.opaque handle exposes no fields, so {tr} cannot be synthesized for it",
                    a, "remove the derive, or implement {tr} by hand")
            }
        }
        ti = ti + 1
    }
}

fn tc_check_derive_hash_eq_ord() ! Diag.Report {
    tc_check_derive_opaque_handle()
    tc_check_one_derive_trait("Hash")
    tc_check_one_derive_trait("Eq")
    tc_check_one_derive_trait("Ord")
}

// ---------------------------------------------------------------------------
// E1401 NonDerivableTrait for @derive(Serialize) — spec §3.6.6, §3.6.2. Mirrors
// tc_check_derive_debug: every field of a @derive(Serialize) type (and every
// enum-variant field) must have a type the generated to_json can faithfully
// serialize. The emitter (emit_field_serialize / emit_list_serialize in
// codegen_derive.bl) produces a real value for exactly: the scalar primitives,
// a List of a serializable element (recursively), and a struct/enum that itself
// carries @derive(Serialize) (has_derive_method is derive-only). Any other type
// — Ptr, an @ffi.opaque handle, a non-Serialize user type, or a container the
// emitter does not yet walk (Option/Map/Set/Result) — falls through to the
// literal "null", the banned silent fallback the per-field derive checks exist
// to prevent. Reject those at derive time instead. Fails OPEN on a generic type
// param (a name that is neither a builtin nor a registered user type), deferring
// the decision to instantiation, exactly as the Debug and Hash/Eq/Ord passes do.

// Is a bare scalar type name one the to_json emitter renders as a real JSON leaf
// (not "null")? Only these four reach a faithful emitter branch: Int / I64 →
// int_to_str (both lower to int), Float → float_to_str, Bool → true/false,
// Str → escaped string. Char, the sized ints (I8/I16/I32, U8/U16/U32/U64) and
// F32/F64 keep distinct CTs that fall through the emitter's else arm to the
// literal "null", so they are NOT accepted here — this must not reuse the
// Hash/Eq/Ord scalar helpers, whose set is wider than the emitter's.
fn tc_serialize_scalar_ok(n: Str) -> Int {
    if n == "Int" || n == "I64" || n == "Float" || n == "Bool" || n == "Str" { return 1 }
    0
}

// A user type is faithfully serialized only when it itself derives Serialize
// (mirrors the emitter's derive-only has_derive_method). An @ffi.opaque handle
// is a registered struct with no derive, so it is rejected. A name that is
// neither a builtin nor a registered user type is a generic type param — fail
// open, deferring the decision to instantiation, as the Debug / Hash-Eq-Ord
// passes do.
fn tc_serialize_user_type_ok(name: Str) -> Int {
    let bare = strip_module_qualifier(name)
    let nominal = tc_written_type_nominal(name)
    if named_type_map.contains_key(nominal) || named_type_map.contains_key(bare) {
        if tc_type_name_derives(nominal, "Serialize") != 0 { return 1 }
        return 0
    }
    1
}

// A List element type emit_list_serialize renders faithfully: a scalar leaf, or
// a user struct/enum that itself derives Serialize (the elem_struct +
// has_derive_method arm covers both). A nested List, Char, a sized int, F32/F64,
// Option, Map, etc. all fall through to "null", so is_primitive_type rejects
// them (List included) before the user-type check.
fn tc_serialize_list_elem_ok(ann: Int) -> Int {
    let name = node_name(ann)
    if tc_serialize_scalar_ok(name) != 0 { return 1 }
    if is_primitive_type(name) != 0 { return 0 }
    tc_serialize_user_type_ok(name)
}

// A struct-field type emit_field_serialize renders faithfully: a scalar leaf, a
// List of a faithful element, or a user struct/enum that derives Serialize (its
// void + has_derive_method arm covers both struct and enum fields).
fn tc_serialize_struct_field_ok(ann: Int) -> Int {
    let name = node_name(ann)
    if tc_serialize_scalar_ok(name) != 0 { return 1 }
    if name == "List" {
        let elems_sl = node_elements(ann)
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            return tc_serialize_list_elem_ok(sublist_get(elems_sl, 0))
        }
        // A bare List with no element annotation cannot be proven serializable.
        return 0
    }
    if is_primitive_type(name) != 0 { return 0 }
    tc_serialize_user_type_ok(name)
}

// An enum-variant field type emit_enum_to_json renders faithfully — a strictly
// weaker set than the struct path. It has NO List branch (even List[Int] emits
// "null") and gates nested recursion on is_struct_type, so an enum-typed field
// (even one deriving Serialize) also emits "null". Faithful set: a scalar leaf,
// or a user STRUCT that derives Serialize. List and enum-typed fields are
// rejected here until emit_enum_to_json grows the matching branches.
fn tc_serialize_variant_field_ok(ann: Int) -> Int {
    let name = node_name(ann)
    if tc_serialize_scalar_ok(name) != 0 { return 1 }
    if is_primitive_type(name) != 0 { return 0 }
    let bare = strip_module_qualifier(name)
    let nominal = tc_written_type_nominal(name)
    if named_type_map.contains_key(nominal) || named_type_map.contains_key(bare) {
        if tc_type_name_derives(nominal, "Serialize") != 0 {
            if tc_type_is_struct(nominal) != 0 || tc_type_is_struct(bare) != 0 { return 1 }
            return 0
        }
        return 0
    }
    // Generic type param — fail open.
    1
}

fn tc_check_one_serialize_field(f: Int, tname: Str, in_variant: Int) ! Diag.Report {
    let ann = node_value(f)
    let ok = if in_variant != 0 { tc_serialize_variant_field_ok(ann) } else { tc_serialize_struct_field_ok(ann) }
    if ok == 0 {
        diag_error_at("NonDerivableTrait", NON_DERIVABLE_TRAIT, "@derive(Serialize) on `{tname}`: field `{node_name(f)}` has type `{node_name(ann)}` which does not implement Serialize", f, "remove the field from the derive, give it a type that implements Serialize, or implement Serialize by hand")
    }
}

fn tc_check_derive_serialize() ! Diag.Report {
    let mut ti = 0
    while ti < named_type_names.len() {
        let tname = named_type_names.get(ti).unwrap()
        let td = tc_decl_node_for_type(tname)
        if td != -1 && tc_decl_derives(td, "Serialize") != 0 {
            let saved_module = nr_current_module
            nr_current_module = node_module(td)
            let flds_sl = node_fields(td)
            let mut i = 0
            while flds_sl != -1 && i < sublist_length(flds_sl) {
                let f = sublist_get(flds_sl, i)
                if node_kind(f) == NodeKind.TypeVariant {
                    let vflds_sl = node_fields(f)
                    let mut vi = 0
                    while vflds_sl != -1 && vi < sublist_length(vflds_sl) {
                        tc_check_one_serialize_field(sublist_get(vflds_sl, vi), tname, 1)
                        vi = vi + 1
                    }
                } else {
                    tc_check_one_serialize_field(f, tname, 0)
                }
                i = i + 1
            }
            nr_current_module = saved_module
        }
        ti = ti + 1
    }
}

// Kind A collision: a struct type whose name equals an enum variant name. This is the
// NARROW invariant — two enums sharing a variant name (e.g. `Pending` in JobState and
// NetState) stays legal and is resolved by the hint, so we only fire when the colliding
// name is registered as a TyKind.Struct in named_type_map. Whole-program: both tables are
// merged across all modules at registration, so cross-module collisions are caught.
fn tc_check_name_collisions() ! TypeCheck.Register, Diag.Report {
    let mut i = 0
    while i < evar_pool.len() {
        let vname = evar_pool.get(i).unwrap().name
        let stid = tc_struct_tid_declared_as(vname)
        if tc_collision_reported.contains_key(vname) == 0 && stid != -1 {
            tc_collision_reported.insert(vname, 1)
            let struct_node = tc_struct_decl_nodes.get(tc_tid_name(stid)) ?? -1
            let enum_node = tc_variant_enum_decl_node(vname)
            diag_error_at("NameCollision", NAME_COLLISION, "struct `{vname}` has the same name as an enum variant `{vname}`; bare construction would be ambiguous (note: two different enums MAY share a variant name — only a struct-vs-variant clash is rejected)", struct_node, "rename either the struct or the variant")
            if enum_node != -1 {
                diag_error_at("NameCollision", NAME_COLLISION, "the conflicting variant `{vname}` is declared here", enum_node, "rename either the struct or the variant")
            }
        }
        i = i + 1
    }
}

// Is `tp_name` return-only: named by the fn's RETURN annotation and by no parameter
// annotation? Computed once at registration, where `ret_ann` and `params_sl` are both
// in scope and the type-param push order is guaranteed to match the side-table's.
//
// BOTH halves of the conjunction are required, and the return half is the tighter of
// the two. Requiring only "no parameter mentions it" would also admit a PHANTOM type
// param (`fn f[T]() -> Int`), and a phantom binder is not a shape INFERENCE can solve:
// its type argument arrives from an explicit type-argument list at the call (`f[Int]()`
// — §3.4 *Explicit Type Application*), never from unifying against an argument or a
// binding annotation. So minting an inference metavar for it is the wrong instrument,
// not a deferred solution. Requiring the return annotation to name it keeps the mint at
// exactly the shape inference CAN reach, which is what "return-only" means. A phantom
// binder is reported at an unbracketed call (tc_report_unsourced_binders).
fn tc_tparam_is_ret_only(tp_name: Str, ret_ann: Int, params_sl: Int) -> Int {
    if ret_ann == -1 { return 0 }
    if !tc_ann_names_tparam(ret_ann, tp_name) { return 0 }
    if tc_params_name_tparam(tp_name, params_sl) != 0 { return 0 }
    1
}

// Supplied by the signature: a parameter or the return annotation names it. Decided from
// the signature alone, as sections/03_types.md 3.4 requires.
fn tc_tparam_is_sourced(tp_name: Str, ret_ann: Int, params_sl: Int) -> Int {
    if ret_ann != -1 && tc_ann_names_tparam(ret_ann, tp_name) { return 1 }
    tc_params_name_tparam(tp_name, params_sl)
}

fn tc_params_name_tparam(tp_name: Str, params_sl: Int) -> Int {
    if params_sl != -1 {
        let mut i = 0
        while i < sublist_length(params_sl) {
            let p = sublist_get(params_sl, i)
            // node_type_name as well as the walk: parse_param sets both from the same
            // annotation, but register_fn_sig itself falls back to the flat type_name
            // when a param carries no ann node (:2617), so a synthesized param must
            // not be able to hide a mention.
            if node_type_name(p) == tp_name { return 1 }
            if tc_ann_names_tparam(node_type_ann(p), tp_name) { return 1 }
            i = i + 1
        }
    }
    0
}

fn register_fn_sig(fn_node: Int) ! TypeCheck.Register, TypeCheck.Resolve, Diag.Report {
    let name = node_name(fn_node)
    let fn_tparams = node_type_params(fn_node)
    tc_push_tparam_scope(fn_tparams)
    let ret_str = node_return_type(fn_node)
    let ret_ann = node_type_ann(fn_node)
    let mut ret_tid = TYPE_VOID

    if ret_ann != -1 {
        ret_tid = resolve_type_ann(ret_ann)
        // A generic user-struct RETURN (`-> LocBox[T]`) once resolved to the BARE base
        // tid. Re-intern it as a structural instance carrying the typevar slots — exactly
        // as the param path does — so instantiate_return_type's
        // substitute_typevar_tid has a T slot to rewrite; otherwise a call
        // `make_box(11)` returns the bare `LocBox` tid, and a downstream bare-typevar
        // fn (`wrap_opt[T](x: T) -> Option[T]`) mangles its mono off the arg-erased
        // head (blink_wrap_opt_LocBox, param blink_LocBox) instead of the concrete
        // instance (blink_wrap_opt_LocBox_Int).
        let ret_inst = tc_fnsig_param_instance_tid(ret_ann, ret_tid)
        if ret_inst != -1 { ret_tid = ret_inst }
    } else if ret_str != "" {
        ret_tid = resolve_type_name(ret_str)
        if ret_tid == -1 {
            ret_tid = TYPE_VOID
        }
    }

    let sig_idx = fnsig_pool.len()
    fnsig_map.insert(name, sig_idx)
    fnsig_by_decl.insert(fn_node, sig_idx)
    let fn_mod = node_module(fn_node)
    if fn_mod != "" {
        nr_module_names_of(fn_mod).sigs.insert(name, sig_idx)
    }
    let start = fnsig_param_list.len()

    let params_sl = node_params(fn_node)
    let mut count = 0
    if params_sl != -1 {
        let mut i = 0
        while i < sublist_length(params_sl) {
            let p = sublist_get(params_sl, i)
            let ptype_str = node_type_name(p)
            let ptype_ann = node_type_ann(p)
            let mut ptid = TYPE_UNKNOWN
            if ptype_ann != -1 {
                ptid = resolve_type_ann(ptype_ann)
                // A generic user-struct param (`Box[T]`) resolves to the BARE base
                // tid; re-intern it as a structural instance carrying the typevar
                // slots so unify_typevar_binds can bind T from the argument.
                let inst = tc_fnsig_param_instance_tid(ptype_ann, ptid)
                if inst != -1 { ptid = inst }
            } else if ptype_str != "" {
                ptid = resolve_type_name(ptype_str)
                if ptid == -1 {
                    ptid = TYPE_UNKNOWN
                }
            }
            fnsig_param_list.push(ptid)
            fnsig_param_names.push(node_name(p))
            fnsig_param_kw.push(node_int_val(p))
            fnsig_param_default.push(node_value(p))
            count = count + 1
            i = i + 1
        }
    }

    let tparams_sl = node_type_params(fn_node)
    let tp_start = fnsig_type_param_names.len()
    let mut tp_count = 0
    if tparams_sl != -1 {
        let mut ti = 0
        while ti < sublist_length(tparams_sl) {
            let tp = sublist_get(tparams_sl, ti)
            let tp_name = node_name(tp)
            fnsig_type_param_names.push(tp_name)
            fnsig_tparam_nodes.push(tp)
            fnsig_tparam_ret_only.push(tc_tparam_is_ret_only(tp_name, ret_ann, params_sl))
            fnsig_tparam_sourced.push(tc_tparam_is_sourced(tp_name, ret_ann, params_sl))
            fnsig_tparam_bounds.push(tparam_node_bound_traits(tp))
            tp_count = tp_count + 1
            ti = ti + 1
        }
    }
    let eff_start = fnsig_effect_names.len()
    let effects_sl = node_effects(fn_node)
    let mut eff_count = 0
    if effects_sl != -1 {
        let mut ei = 0
        while ei < sublist_length(effects_sl) {
            let eff = sublist_get(effects_sl, ei)
            fnsig_effect_names.push(node_name(eff))
            eff_count = eff_count + 1
            ei = ei + 1
        }
    }
    fnsig_pool.push(FnSigEntry { name: name, ret: ret_tid, params_start: start, params_count: count, type_params_start: tp_start, type_params_count: tp_count, effects_start: eff_start, effects_count: eff_count, decl: fn_node })

    tc_pop_tparam_scope(fn_tparams)
}

fn depr_ann_str_arg(ann_node: Int, key: Str) -> Str {
    let args_sl = node_args(ann_node)
    if args_sl == -1 { return "" }
    let mut i = 0
    while i < sublist_length(args_sl) {
        let arg = sublist_get(args_sl, i)
        if node_name(arg) == key {
            let parts_sl = node_elements(arg)
            if parts_sl != -1 && sublist_length(parts_sl) > 0 {
                return node_str_val(sublist_get(parts_sl, 0))
            }
        }
        i = i + 1
    }
    ""
}

fn check_deprecated_fn(fn_name: Str, decl: Int, call_node: Int) ! Diag.Report {
    if decl < 0 { return }
    let ann = get_annotation(decl, "deprecated")
    if ann == -1 { return }
    let since = depr_ann_str_arg(ann, "since")
    let replacement = depr_ann_str_arg(ann, "replacement")
    let mut msg = "use of deprecated function `{fn_name}`"
    if since != "" {
        msg = msg.concat(" (deprecated since {since})")
    }
    let mut help = ""
    if replacement != "" {
        help = "use `{replacement}` instead"
    }
    diag_warn_at("DeprecatedUsage", DEPRECATED_USAGE, msg, call_node, help)
}

fn check_deprecated_type(type_name: Str, usage_node: Int) ! Diag.Report {
    let key = tc_written_type_nominal(type_name)
    if depr_type_nodes.contains_key(key) == 0 { return }
    let def_node = depr_type_nodes.get(key) ?? -1
    if def_node == -1 { return }
    let ann = get_annotation(def_node, "deprecated")
    if ann == -1 { return }
    let since = depr_ann_str_arg(ann, "since")
    let replacement = depr_ann_str_arg(ann, "replacement")
    let mut msg = "use of deprecated type `{type_name}`"
    if since != "" {
        msg = msg.concat(" (deprecated since {since})")
    }
    let mut help = ""
    if replacement != "" {
        help = "use `{replacement}` instead"
    }
    diag_warn_at("DeprecatedUsage", DEPRECATED_USAGE, msg, usage_node, help)
}

// A `Ptr[S]` whose pointee is an `@ffi.struct`. The typed field access `p.f.read()/.write(v)`
// is lowered only for those (codegen_methods.bl's get_var_ffi_ptr_struct gate), so resolving the
// pair on any pointer would type a call codegen cannot emit and would shadow a user `.read()`
// on the field's own type.
fn tc_ptr_ffi_struct_pointee(ptr_tid: Int) -> Int {
    let pt = tc_resolve(ptr_tid)
    if pt < 0 || pt >= ty_pool.len() { return 0 }
    if type_kind(pt) != TyKind.Ptr { return 0 }
    // Resolved, like the FieldAccess arm that types `p.f`: an alias or a metavar-backed
    // binding stores a raw pool inner, and the two halves of the pair must answer alike or
    // `p.f` types while `p.f.read()` rejects on the field's own type.
    let pointee = tc_resolve(ty_pool.get(pt).unwrap().inner1)
    if pointee < 0 { return 0 }
    if ffi_struct_type_set.contains_key(pointee) != 0 { return 1 }
    0
}

// Does `p.offset(i)` have a stride? The spec maps it to C's `ptr + i` over any `alloc_n`
// region, so C steps by `sizeof` the pointee, and every pointee C gives a size has one: the
// sized integers, `Int`, `Float`, a pointer and an `@ffi.struct`. `Void` has no `sizeof`,
// an `@ffi.opaque` step is a question the spec has not settled, and a type parameter has no
// C type until an instance names one. Codegen asks this same question before it emits the
// arithmetic, so the two passes cannot disagree on which steps exist.
pub fn tc_ptr_offset_stride_known(ptr_tid: Int) -> Int {
    let pt = tc_resolve(ptr_tid)
    if pt < 0 || pt >= ty_pool.len() { return 0 }
    if type_kind(pt) != TyKind.Ptr { return 0 }
    let pointee = tc_resolve(ty_pool.get(pt).unwrap().inner1)
    if pointee < 0 || pointee >= ty_pool.len() { return 0 }
    let k = type_kind(pointee)
    if k == TyKind.Ptr || k == TyKind.Int || k == TyKind.Float { return 1 }
    if k == TyKind.I8 || k == TyKind.I16 || k == TyKind.I32 { return 1 }
    if k == TyKind.U8 || k == TyKind.U16 || k == TyKind.U32 || k == TyKind.U64 { return 1 }
    if ffi_struct_type_set.contains_key(pointee) != 0 { return 1 }
    0
}

// Does this node denote an `FfiScope`? Read out of the memo, and out of the scope for a name
// the memo has not reached, because the question is asked in the middle of the walk that
// fills the memo and re-inferring here would re-report whatever the node already reported.
fn tc_node_is_ffi_scope_value(n: Int) -> Int {
    if n == -1 { return 0 }
    let mut t = tc_lookup_node_tid(n)
    if tc_tid_is_no_info(t) != 0 {
        if node_kind(n) == NodeKind.Ident { t = nr_get_type(node_name(n)) }
    }
    if tc_tid_is_no_info(t) != 0 { return 0 }
    if type_kind(tc_resolve(t)) == TyKind.FfiScope { return 1 }
    0
}

// Was this pointer allocated as ONE cell (`scope.alloc()`) rather than as an array
// (`scope.alloc_n(n)`)? sections/07_trust_modules_metadata.md:655 rejects `offset` on the
// singleton-cell result, because every address past cell 0 is outside the allocation.
//
// The same sentence PERMITS `offset` only on an `alloc_n` result or on another `offset`,
// which is stricter than what is rejected here: a `Ptr` from a C function, a field or a
// parameter reaches this test and is allowed through. Naming one of those E0813 would be
// false — it is not a singleton allocation — and the spec defines no code for a pointer whose
// allocation is simply unknown, so the stricter reading needs a decision before it can be
// reported at all.
//
// The allocator comes from the DECLARATION the name reads, through the scope that resolved
// it, not from a table keyed by the name: two functions may each bind `p`, one to a cell and
// one to an array, and a name-keyed answer would let the first reject the second.
//
// A receiver that is not a plain name answers 0. `p.offset(1).offset(1)` steps a value no
// `let` declares, and the honest answer there is that the allocation is unknown, not that it
// is a singleton — a rule that guessed would reject the stepping the spec allows.
fn tc_ptr_reads_singleton_alloc(obj_node: Int) -> Int {
    if obj_node == -1 { return 0 }
    if node_kind(obj_node) != NodeKind.Ident { return 0 }
    let decl = nr_binding_node(node_name(obj_node))
    if decl == -1 { return 0 }
    if node_kind(decl) != NodeKind.LetBinding { return 0 }
    let init = node_value(decl)
    if init == -1 { return 0 }
    if node_kind(init) != NodeKind.MethodCall { return 0 }
    if node_method(init) != "alloc" { return 0 }
    tc_node_is_ffi_scope_value(node_obj(init))
}

fn check_ptr_in_type_ann(ann_node: Int, in_ffi_region: Int) ! Diag.Report {
    if ann_node == -1 { return }
    let name = node_name(ann_node)
    if tc_compiler_known_type_meant(name, ann_node) == "Ptr" {
        if in_ffi_region == 0 {
            diag_error_at("PtrOutsideFFI", PTR_OUTSIDE_FFI, "Ptr[T] may appear only in an FFI region: the signature or body of an @ffi or @trusted function", ann_node, "add @ffi or @trusted(audit: \"ID\") to the function")
        }
        return
    }
    let elems_sl = node_elements(ann_node)
    if elems_sl != -1 {
        let mut i = 0
        while i < sublist_length(elems_sl) {
            check_ptr_in_type_ann(sublist_get(elems_sl, i), in_ffi_region)
            i = i + 1
        }
    }
}

// The pointee half of the §9.1.3 Ptr rule. It runs where every annotation resolves, so a
// pointee is judged the same in a let, a field, an alias, a payload or a signature. A
// PtrOutsideFFI check stays per function: it is a property of the enclosing context.
fn tc_check_ptr_pointee(pointee: Int, inner: Int) ! Diag.Report {
    if tc_ptr_pointee_is_valid(pointee) != 0 { return }
    let inner_name = node_name(inner)
    diag_error_at("InvalidPtrType", INVALID_PTR_TYPE, "invalid Ptr type parameter `{inner_name}` — only Void, U8-U64, I8-I64, Int, Float, Ptr, @ffi.struct, or @ffi.opaque types are allowed", inner, "use a valid FFI-compatible type, or annotate the type with @ffi.struct for a known layout or @ffi.opaque for a handle")
}

// A type not yet known is not judged: whatever left it unknown reports on its own. A type
// parameter is not judged either, since what it stands for is known only per instantiation;
// mono judges it there.
pub fn tc_ptr_pointee_is_valid(pointee: Int) -> Int {
    let t = tc_resolve(pointee)
    if t < 0 || t >= ty_pool.len() { return 1 }
    if tc_tid_has_unbound_metavar(t) != 0 { return 1 }
    let k = type_kind(t)
    if k == TyKind.Unknown || k == TyKind.Typevar { return 1 }
    if k == TyKind.Void || k == TyKind.Ptr { return 1 }
    if k == TyKind.Int || k == TyKind.Float { return 1 }
    if k == TyKind.I8 || k == TyKind.I16 || k == TyKind.I32 { return 1 }
    if k == TyKind.U8 || k == TyKind.U16 || k == TyKind.U32 || k == TyKind.U64 { return 1 }
    if ffi_struct_type_set.contains_key(t) != 0 { return 1 }
    if ffi_opaque_type_set.contains_key(t) != 0 { return 1 }
    0
}

fn check_ptr_in_type_name(type_name: Str, node: Int, in_ffi_region: Int) ! Diag.Report {
    if in_ffi_region == 0 && tc_compiler_known_type_meant(type_name, -1) == "Ptr" {
        diag_error_at("PtrOutsideFFI", PTR_OUTSIDE_FFI, "Ptr[T] may appear only in an FFI region: the signature or body of an @ffi or @trusted function", node, "add @ffi or @trusted(audit: \"ID\") to the function")
    }
}

// An @ffi.struct that holds a Ptr, directly or through a nested @ffi.struct, is confined as
// Ptr[T] is (§9.1.3), so it is checked at the same signature sites. The type is looked up,
// not matched by spelling, so an alias to such a struct is caught too. Nothing in the
// struct's name says why it is confined, so the error names the field that holds the Ptr.
fn check_ptr_bearing_struct_in_type_ann(ann_node: Int, in_ffi_region: Int) ! Diag.Report {
    if ann_node == -1 || in_ffi_region != 0 { return }
    let name = node_name(ann_node)
    // An alias's own name is also registered as a type, so the alias chain is asked first.
    let mut tid = tc_resolve_transparent_alias_name(name)
    if tid == -1 { tid = lookup_named_type(name) }
    let r = tc_resolve(tid)
    // Most annotations name a type with no arguments that is not an @ffi.struct, where the
    // search below answers -1 at once; this skips its seen map, which every annotation built.
    let mut st = -1
    if tc_tid_child_count(r) > 0 || ffi_struct_type_set.contains_key(r) != 0 {
        st = ptr_bearing_ffi_struct_in(r, Map())
    }
    if st != -1 {
        let path = ffi_struct_ptr_field_path(st, Map())
        let td = tc_tid_decl_node(st)
        let sname = node_name(td)
        let mut names: List[Str] = []
        for fnode in path { names.push(node_name(fnode)) }
        let fpath = names.join(".")
        let line = node_line(path.get(path.len() - 1).unwrap())
        diag_error_at("PtrOutsideFFI", PTR_OUTSIDE_FFI, "`{sname}` holds `Ptr` in field `{fpath}` (line {line}), so it may appear only in an FFI region", ann_node, "add @ffi or @trusted(audit: \"ID\") to the function")
        return
    }
    let elems_sl = node_elements(ann_node)
    if elems_sl != -1 {
        let mut i = 0
        while i < sublist_length(elems_sl) {
            check_ptr_bearing_struct_in_type_ann(sublist_get(elems_sl, i), in_ffi_region)
            i = i + 1
        }
    }
}

// The first @ffi.struct that holds a Ptr, found in `t` or its type arguments, or -1. The
// fields of a struct that is not @ffi.struct are not searched: a Ptr there is a separate gap.
fn ptr_bearing_ffi_struct_in(t: Int, seen: Map[Int, Int]) -> Int {
    if t < 0 || t >= ty_pool.len() { return -1 }
    if seen.contains_key(t) { return -1 }
    seen.insert(t, 1)
    if ffi_struct_type_set.contains_key(t) && ffi_struct_ptr_field_path(t, Map()).len() > 0 { return t }
    let mut i = 0
    while i < tc_tid_child_count(t) {
        let hit = ptr_bearing_ffi_struct_in(tc_resolve(tc_tid_child(t, i)), seen)
        if hit != -1 { return hit }
        i = i + 1
    }
    -1
}

// The field declarations from @ffi.struct `st` down to the first Ptr field, through nested
// @ffi.struct fields, or empty when it holds none.
fn ffi_struct_ptr_field_path(st: Int, seen: Map[Int, Int]) -> List[Int] {
    let none: List[Int] = []
    if seen.contains_key(st) { return none }
    seen.insert(st, 1)
    let td = tc_tid_decl_node(st)
    if td < 0 { return none }
    let flds_sl = node_fields(td)
    if flds_sl == -1 { return none }
    let slots = tc_struct_field_slots(st)
    let mut i = 0
    while i < sublist_length(flds_sl) {
        let f = sublist_get(flds_sl, i)
        for slot in slots {
            if tc_sfield_name(slot) == node_name(f) {
                let ft = tc_resolve(tc_sfield_tid(slot))
                if ft >= 0 && ft < ty_pool.len() {
                    if type_kind(ft) == TyKind.Ptr { return [f] }
                    if ffi_struct_type_set.contains_key(ft) {
                        let sub = ffi_struct_ptr_field_path(ft, seen)
                        if sub.len() > 0 {
                            let mut out: List[Int] = [f]
                            for n in sub { out.push(n) }
                            return out
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    none
}

// ── Phase 0: Contract predicate validator ─────────────────────────────
//
// Predicates inside @requires / @ensures / @where must lie in an
// SMT-decidable subset so that today's runtime checks can later be
// promoted to compile-time proofs without rewriting every contract.
//
// Allowed: literals, identifiers, parameter refs, `result` (in @ensures),
// `old(_)` (in @ensures), arithmetic / comparison / boolean / equality
// binops, unary `!` and unary `-`, FieldAccess, IndexExpr, RangeLit,
// IfExpr, MatchExpr, calls/method-calls to either a hardcoded bootstrap
// whitelist (`len`, `is_empty`, `unwrap`, `abs`) or to a @pure function.
//
// Rejected (each maps to a distinct diagnostic in E1300-E1306):
//   - LetBinding, Assignment/CompoundAssign            → E1306 / E1300
//   - Closure, ForIn, WhileLoop, LoopExpr              → E1303 / E1300
//   - Break, Continue, Return                          → E1300
//   - WithBlock, AsyncSpawn, AwaitExpr, ChannelNew     → E1300
//   - Allocation (ListLit, StructLit non-trivially)    → E1300
//   - Calls into effectful fns                         → E1301
//   - Calls into non-pure user fns (no effects, but
//     not @pure / not on bootstrap whitelist)          → E1302

fn pv_is_whitelisted_call(name: Str) -> Int {
    if name == "len" { return 1 }
    if name == "is_empty" { return 1 }
    if name == "unwrap" { return 1 }
    if name == "abs" { return 1 }
    if name == "fabs" { return 1 }
    0
}

fn pv_fn_has_any_effect(name: Str) -> Int {
    let sig = lookup_fnsig(name)
    if sig == -1 { return 0 }
    let fs = fnsig_pool.get(sig).unwrap()
    if fs.effects_count > 0 { return 1 }
    0
}

// Depth counter set transiently when walking the argument(s) of an
// `old(_)` call. Used to reject nested `old(old(_))`.
let mut pv_in_old_depth: Int = 0

fn pv_validate_call_target(call_name: Str, call_node: Int, in_ensures: Int) ! Diag.Report {
    if call_name == "old" {
        if in_ensures == 0 {
            diag_error_at("OldOutsideEnsures", OLD_OUTSIDE_ENSURES, "`old(_)` is only valid inside @ensures predicates", call_node, "move the `old(_)` reference into an @ensures predicate")
        } else if pv_in_old_depth != 0 {
            diag_error_at("OldOutsideEnsures", OLD_OUTSIDE_ENSURES, "`old(_)` may not be nested — `old(old(_))` is not meaningful", call_node, "remove the outer `old(_)`")
        }
        return
    }
    if pv_is_whitelisted_call(call_name) != 0 { return }
    if pv_is_whitelisted_ffi_wrapper(call_name) != 0 { return }
    if tc_fn_is_pure(call_name) != 0 { return }
    if pv_fn_has_any_effect(call_name) != 0 {
        diag_error_at("EffectfulCallInPredicate", EFFECTFUL_CALL_IN_PREDICATE, "predicate calls effectful function `{call_name}` — predicates must be pure", call_node, "call only @pure helpers (or compute the value in the function body)")
        return
    }
    let sig = lookup_fnsig(call_name)
    if sig == -1 { return }
    diag_error_at("ImpureCallInPredicate", IMPURE_CALL_IN_PREDICATE, "predicate calls non-pure function `{call_name}` — predicates may only call @pure helpers or the bootstrap whitelist (len, is_empty, unwrap, abs, fabs)", call_node, "mark `{call_name}` as @pure if it qualifies, or inline the computation")
}

fn pv_walk(expr: Int, in_ensures: Int) ! Diag.Report {
    if expr == -1 { return }
    let k = node_kind(expr)

    // Literals — always fine.
    if k == NodeKind.IntLit { return }
    if k == NodeKind.FloatLit { return }
    if k == NodeKind.BoolLit { return }
    if k == NodeKind.CharLit { return }

    // Strings: literal Str is allowed, but interpolation is a control-flow
    // artifact we don't want in predicates today.
    if k == NodeKind.InterpString {
        diag_error_at("ContractPredicateNotDecidable", CONTRACT_PREDICATE_NOT_DECIDABLE, "interpolated strings are not allowed in contract predicates", expr, "use a plain string literal or move the formatting into the function body")
        return
    }

    // Identifiers — `result` is gated to @ensures, everything else is fine.
    if k == NodeKind.Ident {
        let nm = node_name(expr)
        if nm == "result" {
            if in_ensures == 0 {
                diag_error_at("ResultOutsideEnsures", RESULT_OUTSIDE_ENSURES, "`result` is only valid inside @ensures predicates", expr, "rename the local, or move the reference into @ensures(...)")
            }
        }
        return
    }

    // Operators.
    if k == NodeKind.BinOp {
        pv_walk(node_left(expr), in_ensures)
        pv_walk(node_right(expr), in_ensures)
        return
    }
    if k == NodeKind.UnaryOp {
        pv_walk(node_left(expr), in_ensures)
        return
    }

    // Read-only access.
    if k == NodeKind.FieldAccess {
        pv_walk(node_obj(expr), in_ensures)
        return
    }
    if k == NodeKind.IndexExpr {
        pv_walk(node_obj(expr), in_ensures)
        pv_walk(node_index(expr), in_ensures)
        return
    }

    // Range membership / construction (rhs of `in`).
    if k == NodeKind.RangeLit {
        pv_walk(node_start(expr), in_ensures)
        pv_walk(node_end(expr), in_ensures)
        return
    }

    // If / Match — accepted (per design: SMT can encode as ite).
    if k == NodeKind.IfExpr {
        pv_walk(node_condition(expr), in_ensures)
        pv_walk(node_then_body(expr), in_ensures)
        pv_walk(node_else_body(expr), in_ensures)
        return
    }
    if k == NodeKind.MatchExpr {
        pv_walk(node_scrutinee(expr), in_ensures)
        let arms_sl = node_arms(expr)
        if arms_sl != -1 {
            let mut i = 0
            while i < sublist_length(arms_sl) {
                let arm = sublist_get(arms_sl, i)
                let g = node_guard(arm)
                if g != -1 { pv_walk(g, in_ensures) }
                pv_walk(node_body(arm), in_ensures)
                i = i + 1
            }
        }
        return
    }

    // A bare Block can wrap a single expression; if it contains statements
    // (let, assignment, loops...), the recursive walk will surface the
    // appropriate diagnostic against each child.
    if k == NodeKind.Block {
        let stmts_sl = node_stmts(expr)
        if stmts_sl != -1 {
            let mut i = 0
            while i < sublist_length(stmts_sl) {
                pv_walk(sublist_get(stmts_sl, i), in_ensures)
                i = i + 1
            }
        }
        return
    }

    // Block bodies wrap their tail expression in ExprStmt; descend.
    if k == NodeKind.ExprStmt {
        pv_walk(node_value(expr), in_ensures)
        return
    }

    // Calls. Parser stores callee in `left` (typically an Ident).
    if k == NodeKind.Call {
        let callee = node_left(expr)
        let mut call_name = ""
        if callee != -1 {
            call_name = tc_unresolved_callee_name(node_name(callee))
        }
        pv_validate_call_target(call_name, expr, in_ensures)
        let is_old = if call_name == "old" { 1 } else { 0 }
        if is_old != 0 { pv_in_old_depth = pv_in_old_depth + 1 }
        let args_sl = node_args(expr)
        if args_sl != -1 {
            let mut i = 0
            while i < sublist_length(args_sl) {
                pv_walk(sublist_get(args_sl, i), in_ensures)
                i = i + 1
            }
        }
        if is_old != 0 { pv_in_old_depth = pv_in_old_depth - 1 }
        return
    }
    if k == NodeKind.MethodCall {
        let mname = node_method(expr)
        // Method calls bypass the impurity check when on the whitelist
        // (`xs.len()`, `o.unwrap()`, etc.). For everything else we have no
        // way today to know which trait/impl the method resolves to without
        // running full method dispatch — so we accept conservatively and
        // leave precise checking to the @pure registry.
        if pv_is_whitelisted_call(mname) == 0 {
            // Best-effort: if there is a top-level fn with this exact name
            // and it has effects, surface E1301.
            if pv_fn_has_any_effect(mname) != 0 {
                diag_error_at("EffectfulCallInPredicate", EFFECTFUL_CALL_IN_PREDICATE, "predicate calls effectful method `{mname}` — predicates must be pure", expr, "call only @pure helpers (or compute the value in the function body)")
            }
        }
        pv_walk(node_obj(expr), in_ensures)
        let m_args_sl = node_args(expr)
        if m_args_sl != -1 {
            let mut i = 0
            while i < sublist_length(m_args_sl) {
                pv_walk(sublist_get(m_args_sl, i), in_ensures)
                i = i + 1
            }
        }
        return
    }

    // Hard rejections — distinct codes for the structurally-disqualifying
    // forms; everything else funnels into E1300.
    if k == NodeKind.WhileLoop || k == NodeKind.ForIn || k == NodeKind.LoopExpr {
        diag_error_at("LoopInPredicate", LOOP_IN_PREDICATE, "loops are not allowed in contract predicates — predicates must terminate and be quantifier-free", expr, "replace iteration with a recursive @pure helper or a quantifier-free expression")
        return
    }
    if k == NodeKind.Assignment || k == NodeKind.CompoundAssign {
        diag_error_at("AssignmentInPredicate", ASSIGNMENT_IN_PREDICATE, "assignments are not allowed in contract predicates — predicates must be referentially transparent", expr, "rewrite as a pure comparison; bind values outside the predicate if needed")
        return
    }

    // Catch-all: every other shape is outside the decidable subset.
    let kname = node_kind_name(k)
    diag_error_at("ContractPredicateNotDecidable", CONTRACT_PREDICATE_NOT_DECIDABLE, "construct `{kname}` is not allowed in contract predicates — predicates must lie in the SMT-decidable subset", expr, "rewrite the predicate as a pure expression over parameters, comparisons, and @pure calls")
}

fn pv_validate_annotation(ann: Int, in_ensures: Int) ! Diag.Report {
    let args_sl = node_args(ann)
    if args_sl == -1 { return }
    if sublist_length(args_sl) == 0 { return }
    let pred = sublist_get(args_sl, 0)
    pv_in_old_depth = 0
    pv_walk_recording(pred, in_ensures)
}

// Predicates this validator refused. Inference skips them: a misplaced `result` or `old(_)`
// has already been reported, and typing it again would add an undefined-name error on top.
let mut pv_rejected_preds: Map[Int, Int] = Map()

fn pv_walk_recording(pred: Int, in_ensures: Int) ! Diag.Report {
    let before = diag_count
    pv_walk(pred, in_ensures)
    if diag_count > before { pv_rejected_preds.insert(pred, 1) }
}

fn pv_validate_fn_contracts(fn_node: Int) ! Diag.Report {
    let anns_sl = node_handlers(fn_node)
    if anns_sl == -1 { return }
    let mut i = 0
    while i < sublist_length(anns_sl) {
        let ann = sublist_get(anns_sl, i)
        let nm = node_name(ann)
        if nm == "requires" {
            pv_validate_annotation(ann, 0)
        } else if nm == "ensures" {
            pv_validate_annotation(ann, 1)
        } else if nm == "modifies" {
            pv_validate_modifies(ann)
        }
        i = i + 1
    }
}

// Validate that every @modifies argument is a simple path
// (`ident`, `ident.field`, or `nothing`). Reject kv-pair forms.
fn pv_validate_modifies(ann: Int) ! Diag.Report {
    let args_sl = node_args(ann)
    if args_sl == -1 { return }
    let mut i = 0
    while i < sublist_length(args_sl) {
        let arg = sublist_get(args_sl, i)
        let nm = node_name(arg)
        if nm.contains(":") {
            diag_error_at("ModifiesArgNotSimplePath", MODIFIES_ARG_NOT_SIMPLE_PATH,
                "@modifies argument must be a simple path (ident, ident.field, or `nothing`), got `{nm}`",
                arg, "remove the kv-pair form")
        }
        i = i + 1
    }
}

fn pv_validate_type_alias(td: Int) ! Diag.Report {
    let where_pred = node_condition(td)
    if where_pred == -1 { return }
    pv_walk_recording(where_pred, 0)
}

// ── @pure annotation + minimal purity check ─────────────────────────
//
// `tc_pure_fns` is populated in a first pass over all fns *before* any
// body is walked, so recursive and mutually-recursive @pure fns work.
// `pv_validate_call_target` consults this registry to decide whether a
// non-effectful, non-bootstrap call is allowed in a predicate.

pub let mut tc_pure_fns: Map[Str, Int] = Map()
pub let mut tc_fn_node_by_name: Map[Str, Int] = Map()

pub fn tc_fn_is_pure(name: Str) -> Int {
    if tc_pure_fns.contains_key(name) { return 1 }
    0
}

// True if `name` is a Blink wrapper around a C symbol on the predicate
// bootstrap whitelist (today: just `fabs`). The wrapper is FFI and would
// otherwise be rejected as effectful — the whitelist short-circuits.
fn pv_is_whitelisted_ffi_wrapper(name: Str) -> Int {
    if !tc_fn_node_by_name.contains_key(name) { return 0 }
    let fn_node = tc_fn_node_by_name.get(name).unwrap()
    let ffi_ann = get_annotation(fn_node, "ffi")
    if ffi_ann == -1 { return 0 }
    let args_sl = node_args(ffi_ann)
    if args_sl == -1 { return 0 }
    let mut i = 0
    while i < sublist_length(args_sl) {
        let arg = sublist_get(args_sl, i)
        if node_kind(arg) == NodeKind.InterpString && node_name(arg) == "" {
            let parts_sl = node_elements(arg)
            if parts_sl != -1 && sublist_length(parts_sl) == 1 {
                let part = sublist_get(parts_sl, 0)
                if is_literal_string_part(part) != 0 {
                    let sym = node_str_val(part)
                    if pv_is_whitelisted_call(sym) != 0 { return 1 }
                }
            }
            return 0
        }
        i = i + 1
    }
    0
}

fn pp_is_mutating_method(name: Str) -> Int {
    if name == "push" { return 1 }
    if name == "pop" { return 1 }
    if name == "append" { return 1 }
    if name == "clear" { return 1 }
    if name == "insert" { return 1 }
    if name == "remove" { return 1 }
    if name == "set" { return 1 }
    0
}

fn pp_is_collection_constructor(name: Str) -> Int {
    if name == "List" { return 1 }
    if name == "Map" { return 1 }
    if name == "Set" { return 1 }
    0
}

fn pp_walk(node: Int, fn_name: Str, anchor: Int) ! Diag.Report {
    if node == -1 { return }
    let k = node_kind(node)

    // Reject loops outright — non-terminating constructs.
    if k == NodeKind.WhileLoop || k == NodeKind.ForIn || k == NodeKind.LoopExpr {
        diag_error_at("ImpureBodyForPureAnnotation", IMPURE_BODY_FOR_PURE_ANNOTATION, "@pure function `{fn_name}` contains a loop — @pure forbids while/for/loop", anchor, "remove the loop or drop the @pure annotation")
        return
    }
    // Reject assignments.
    if k == NodeKind.Assignment || k == NodeKind.CompoundAssign {
        diag_error_at("ImpureBodyForPureAnnotation", IMPURE_BODY_FOR_PURE_ANNOTATION, "@pure function `{fn_name}` contains an assignment — @pure forbids mutation", anchor, "rewrite without assignment or drop the @pure annotation")
        return
    }
    // Reject List/Map/Set allocation in literal form.
    if k == NodeKind.ListLit {
        diag_error_at("ImpureBodyForPureAnnotation", IMPURE_BODY_FOR_PURE_ANNOTATION, "@pure function `{fn_name}` allocates a List — @pure forbids List/Map/Set allocation", anchor, "compute on existing inputs or drop the @pure annotation")
        return
    }

    if k == NodeKind.Call {
        let callee = node_left(node)
        let mut written = ""
        if callee != -1 { written = node_name(callee) }
        // The tables are keyed on the declaration's own name, which an import alias hides; the
        // message keeps the spelling the reader wrote.
        let call_name = if callee != -1 { tc_call_declared_name(node) } else { "" }
        if pp_is_collection_constructor(call_name) != 0 {
            diag_error_at("ImpureBodyForPureAnnotation", IMPURE_BODY_FOR_PURE_ANNOTATION, "@pure function `{fn_name}` allocates a `{written}` — @pure forbids List/Map/Set allocation", anchor, "compute on existing inputs or drop the @pure annotation")
        } else if pv_fn_has_any_effect(call_name) != 0 {
            diag_error_at("ImpureBodyForPureAnnotation", IMPURE_BODY_FOR_PURE_ANNOTATION, "@pure function `{fn_name}` calls effectful function `{written}` — @pure may only call @pure helpers (or len/is_empty/unwrap/abs/fabs)", anchor, "drop the @pure annotation or rewrite without the effectful call")
        } else if pv_is_whitelisted_call(call_name) == 0 && tc_fn_is_pure(call_name) == 0 {
            // Skip if the callee is unresolvable — could be a stdlib helper
            // (e.g. assert) or a builtin we don't track. Only complain when
            // we can prove it's a defined non-pure user function.
            if lookup_fnsig(call_name) != -1 {
                diag_error_at("ImpureBodyForPureAnnotation", IMPURE_BODY_FOR_PURE_ANNOTATION, "@pure function `{fn_name}` calls non-@pure function `{written}` — mark it @pure or drop the annotation", anchor, "add @pure to `{written}` if it qualifies, or remove @pure from `{fn_name}`")
            }
        }
        // Still recurse into args — a pure-looking call could embed impurity.
        let cargs_sl = node_args(node)
        if cargs_sl != -1 {
            let mut i = 0
            while i < sublist_length(cargs_sl) {
                pp_walk(sublist_get(cargs_sl, i), fn_name, anchor)
                i = i + 1
            }
        }
        return
    }

    if k == NodeKind.MethodCall {
        let mname = node_method(node)
        if pp_is_mutating_method(mname) != 0 {
            diag_error_at("ImpureBodyForPureAnnotation", IMPURE_BODY_FOR_PURE_ANNOTATION, "@pure function `{fn_name}` calls mutating method `.{mname}()` — @pure forbids mutation", anchor, "rewrite without the mutating call or drop the @pure annotation")
        }
        pp_walk(node_obj(node), fn_name, anchor)
        let margs_sl = node_args(node)
        if margs_sl != -1 {
            let mut i = 0
            while i < sublist_length(margs_sl) {
                pp_walk(sublist_get(margs_sl, i), fn_name, anchor)
                i = i + 1
            }
        }
        return
    }

    // Recurse into children. Replicates the structure of pv_walk.
    if k == NodeKind.BinOp {
        pp_walk(node_left(node), fn_name, anchor)
        pp_walk(node_right(node), fn_name, anchor)
        return
    }
    if k == NodeKind.UnaryOp {
        pp_walk(node_left(node), fn_name, anchor)
        return
    }
    if k == NodeKind.FieldAccess {
        pp_walk(node_obj(node), fn_name, anchor)
        return
    }
    if k == NodeKind.IndexExpr {
        pp_walk(node_obj(node), fn_name, anchor)
        pp_walk(node_index(node), fn_name, anchor)
        return
    }
    if k == NodeKind.RangeLit {
        pp_walk(node_start(node), fn_name, anchor)
        pp_walk(node_end(node), fn_name, anchor)
        return
    }
    if k == NodeKind.IfExpr {
        pp_walk(node_condition(node), fn_name, anchor)
        pp_walk(node_then_body(node), fn_name, anchor)
        pp_walk(node_else_body(node), fn_name, anchor)
        return
    }
    if k == NodeKind.MatchExpr {
        pp_walk(node_scrutinee(node), fn_name, anchor)
        let arms_sl = node_arms(node)
        if arms_sl != -1 {
            let mut i = 0
            while i < sublist_length(arms_sl) {
                let arm = sublist_get(arms_sl, i)
                let g = node_guard(arm)
                if g != -1 { pp_walk(g, fn_name, anchor) }
                pp_walk(node_body(arm), fn_name, anchor)
                i = i + 1
            }
        }
        return
    }
    if k == NodeKind.Block {
        let stmts_sl = node_stmts(node)
        if stmts_sl != -1 {
            let mut i = 0
            while i < sublist_length(stmts_sl) {
                pp_walk(sublist_get(stmts_sl, i), fn_name, anchor)
                i = i + 1
            }
        }
        return
    }
    if k == NodeKind.ExprStmt {
        pp_walk(node_value(node), fn_name, anchor)
        return
    }
    if k == NodeKind.LetBinding {
        // `let x = expr` itself is fine; the RHS is the only thing that
        // could carry impurity.
        pp_walk(node_value(node), fn_name, anchor)
        return
    }
    if k == NodeKind.Return {
        pp_walk(node_value(node), fn_name, anchor)
        return
    }
    // Literals + identifiers — leaves, nothing to check.
}

fn tc_register_pure_fns(fns_sl: Int) {
    if fns_sl == -1 { return }
    let mut i = 0
    while i < sublist_length(fns_sl) {
        let fn_node = sublist_get(fns_sl, i)
        let fn_name = node_name(fn_node)
        tc_fn_node_by_name.insert(fn_name, fn_node)
        if has_annotation(fn_node, "pure") != 0 {
            tc_pure_fns.insert(fn_name, 1)
        }
        i = i + 1
    }
}

fn tc_check_pure(fn_node: Int) ! Diag.Report {
    if has_annotation(fn_node, "pure") == 0 { return }
    let fn_name = node_name(fn_node)
    let pure_ann = get_annotation(fn_node, "pure")
    let anchor = if pure_ann != -1 { pure_ann } else { fn_node }

    // Reject @pure on a fn that declares any effects.
    let effects_sl = node_effects(fn_node)
    if effects_sl != -1 && sublist_length(effects_sl) > 0 {
        diag_error_at("ImpureBodyForPureAnnotation", IMPURE_BODY_FOR_PURE_ANNOTATION, "@pure function `{fn_name}` declares effects — @pure forbids declared effects", anchor, "drop the effect declaration or remove @pure")
        return
    }

    let body = node_body(fn_node)
    if body == -1 { return }
    pp_walk(body, fn_name, anchor)
}

// The `audit:` argument of a @trusted annotation, or "" when the annotation is bare,
// carries no `audit:`, or carries an empty one.
fn trusted_audit_id(ann: Int) -> Str {
    if ann == -1 { return "" }
    let args_sl = node_args(ann)
    if args_sl == -1 { return "" }
    let count = sublist_length(args_sl)
    let mut i = 0
    while i < count {
        let arg = sublist_get(args_sl, i)
        if node_name(arg) == "audit" { return ann_str_val(arg) }
        i = i + 1
    }
    ""
}

// sections/03b_contracts.md 3b.2: the spec defines contracts on functions and impl methods
// only. A trait method's contract never reaches the validator or the lowering, so each
// annotation is refused here rather than accepted with no meaning.
fn tc_reject_trait_method_contracts(trait_node: Int) ! Diag.Report {
    let methods_sl = node_methods(trait_node)
    if methods_sl == -1 { return }
    let mut i = 0
    while i < sublist_length(methods_sl) {
        let method = sublist_get(methods_sl, i)
        let anns_sl = node_handlers(method)
        let mut j = 0
        while anns_sl != -1 && j < sublist_length(anns_sl) {
            let ann = sublist_get(anns_sl, j)
            let nm = node_name(ann)
            if nm == "requires" || nm == "ensures" || nm == "verify" {
                diag_error_at("UnexpectedAnnotation", UNEXPECTED_ANNOTATION, "@{nm} on trait method `{node_name(trait_node)}.{node_name(method)}`: the spec does not define contracts on trait method declarations", ann, "put the contract on the method in each impl")
            }
            j = j + 1
        }
        i = i + 1
    }
}

// sections/03b_contracts.md 3b.4 names two fallbacks for a contract the solver cannot decide.
// Any other value would leave the contract with no defined meaning.
fn validate_verify_fallback(fn_node: Int) ! Diag.Report {
    let ann = get_annotation(fn_node, "verify")
    if ann == -1 { return }
    let fb = get_str_named_arg(ann, "fallback")
    if fb == "runtime" || fb == "trust" { return }
    diag_error_at("UnexpectedAnnotation", UNEXPECTED_ANNOTATION, "@verify fallback must be \"runtime\" or \"trust\", got \"{fb}\"", ann, "write @verify(fallback: \"runtime\") to check the contract at runtime, or @verify(fallback: \"trust\") to accept it unchecked")
}

// sections/03b_contracts.md 3b.4: a contract the solver can neither prove nor disprove does not
// compile without a @verify fallback. With no solver every contract is in that state. Each
// contract has its own outcome, so each gets its own error.
fn tc_check_contract_verifiable(fn_node: Int) ! Diag.Report {
    if has_annotation(fn_node, "verify") != 0 { return }
    // E0803 already asks for the contract to go, and a @verify would not help.
    if has_annotation(fn_node, "ffi") != 0 { return }
    let anns_sl = node_handlers(fn_node)
    if anns_sl == -1 { return }
    let mut i = 0
    while i < sublist_length(anns_sl) {
        let ann = sublist_get(anns_sl, i)
        let nm = node_name(ann)
        let args_sl = if nm == "requires" || nm == "ensures" { node_args(ann) } else { -1 }
        // A predicate outside the decidable subset already has its own error and repair.
        if args_sl != -1 && sublist_length(args_sl) > 0 && !pv_rejected_preds.contains_key(sublist_get(args_sl, 0)) {
            diag_error_at_notes("ContractUnverifiable", CONTRACT_UNVERIFIABLE, "contract unverifiable", ann,
                "options:\n1. Simplify the contract predicate\n2. Add @verify(fallback: \"runtime\") to insert a runtime check\n3. Add @verify(fallback: \"trust\") to accept without verification",
                ["the SMT solver could not prove or disprove this contract"])
        }
        i = i + 1
    }
}

fn validate_ffi_fn(fn_node: Int) ! Diag.Report {
    let name = node_name(fn_node)
    let ffi_node = get_annotation(fn_node, "ffi")
    let has_ffi = if ffi_node != -1 { 1 } else { 0 }
    let has_trusted = has_annotation(fn_node, "trusted")
    // An @ffi or @trusted function is an FFI region (§9.1.3), so its signature may name a Ptr.
    let in_ffi_region = if has_ffi != 0 || has_trusted != 0 { 1 } else { 0 }
    if has_trusted != 0 {
        // The audit identifier is the record the channel exists to create; without it
        // @trusted only silences (sections/07_trust_modules_metadata.md:78).
        let trusted_ann = get_annotation(fn_node, "trusted")
        if trusted_audit_id(trusted_ann) == "" {
            diag_error_at("TrustedRequiresAudit", TRUSTED_REQUIRES_AUDIT, "`@trusted` on `{name}` requires a non-empty `audit:` identifier", trusted_ann, "write @trusted(audit: \"SOME-ID\")")
        }
    }
    let requires_node = get_annotation(fn_node, "requires")
    let has_requires = if requires_node != -1 { 1 } else { 0 }
    let ensures_node = get_annotation(fn_node, "ensures")
    let has_ensures = if ensures_node != -1 { 1 } else { 0 }

    if has_ffi != 0 {
        if node_is_pub(fn_node) != 0 && has_trusted == 0 {
            diag_error_at("PubFFI", PUB_FFI, "FFI function `{name}` must not be pub — FFI functions are unsafe and should be wrapped", ffi_node, "remove `pub` or add @trusted(audit: \"ID\") to mark it as audited")
        }
        let effects_sl = node_effects(fn_node)
        if effects_sl == -1 || sublist_length(effects_sl) == 0 {
            diag_error_at("FFINoEffects", FFI_NO_EFFECTS, "FFI function `{name}` must declare effects — FFI calls are side-effectful", ffi_node, "add `! FFI` or appropriate effects to the function signature")
        }
        if has_requires != 0 {
            diag_error_at("ContractOnFFI", CONTRACT_ON_FFI, "@requires cannot be used on FFI function `{name}` — contracts cannot verify foreign code", requires_node, "remove @requires from the FFI function")
        }
        if has_ensures != 0 {
            diag_error_at("ContractOnFFI", CONTRACT_ON_FFI, "@ensures cannot be used on FFI function `{name}` — contracts cannot verify foreign code", ensures_node, "remove @ensures from the FFI function")
        }
        if has_trusted == 0 {
            diag_warn_at("UnauditedFFI", UNAUDITED_FFI, "FFI function `{name}` is not marked @trusted — consider auditing and adding @trusted", ffi_node, "add @trusted(audit: \"ID\") after auditing the foreign function")
        }
    }

    // Check Ptr[T] in parameter types
    let params_sl = node_params(fn_node)
    if params_sl != -1 {
        let mut pi = 0
        while pi < sublist_length(params_sl) {
            let p = sublist_get(params_sl, pi)
            let ptype_ann = node_type_ann(p)
            if ptype_ann != -1 {
                check_ptr_in_type_ann(ptype_ann, in_ffi_region)
                check_ptr_bearing_struct_in_type_ann(ptype_ann, in_ffi_region)
            } else {
                check_ptr_in_type_name(node_type_name(p), p, in_ffi_region)
            }
            pi = pi + 1
        }
    }

    // Check Ptr[T] in return type
    let ret_ann = node_type_ann(fn_node)
    if ret_ann != -1 {
        check_ptr_in_type_ann(ret_ann, in_ffi_region)
        check_ptr_bearing_struct_in_type_ann(ret_ann, in_ffi_region)
    } else {
        let ret_str = node_return_type(fn_node)
        if in_ffi_region == 0 && tc_compiler_known_type_meant(ret_str, -1) == "Ptr" {
            diag_error_at("PtrOutsideFFI", PTR_OUTSIDE_FFI, "Ptr[T] may appear only in an FFI region: the signature or body of an @ffi or @trusted function", fn_node, "add @ffi or @trusted(audit: \"ID\") to the function")
        }
    }
}

fn budget_effect_satisfies(budget_eff: Str, fn_eff: Str) -> Int {
    if budget_eff == fn_eff { return 1 }
    if fn_eff.starts_with(budget_eff.concat(".")) { return 1 }
    0
}

fn validate_capabilities_budget(program: Int, fns_sl: Int) ! Diag.Report {
    let cap_node = get_annotation(program, "capabilities")
    if cap_node == -1 { return }
    let mut budget_names: List[Str] = []
    let ann_args_sl = node_args(cap_node)
    if ann_args_sl != -1 {
        let mut ai = 0
        while ai < sublist_length(ann_args_sl) {
            let arg_nd = sublist_get(ann_args_sl, ai)
            budget_names.push(node_name(arg_nd))
            ai = ai + 1
        }
    }
    if fns_sl == -1 { return }
    let mut fi = 0
    while fi < sublist_length(fns_sl) {
        let fn_node = sublist_get(fns_sl, fi)
        let fn_name = node_name(fn_node)
        let fn_mod = node_module(fn_node)
        if fn_name != "main" && !fn_name.starts_with("__test_") && (fn_mod == "__main__") {
            let sig = lookup_fnsig(fn_name)
            if sig != -1 && sig < fnsig_pool.len() {
                let fs = fnsig_pool.get(sig).unwrap()
                let eff_start = fs.effects_start
                let eff_count = fs.effects_count
                let mut ei = 0
                while ei < eff_count {
                    let eff = fnsig_effect_names.get(eff_start + ei).unwrap()
                    let mut allowed = 0
                    let mut bi = 0
                    while bi < budget_names.len() {
                        if budget_effect_satisfies(budget_names.get(bi).unwrap(), eff) != 0 {
                            allowed = 1
                        }
                        bi = bi + 1
                    }
                    if allowed == 0 {
                        diag_error_at("CapabilityBudgetExceeded", CAPABILITY_BUDGET, "function `{fn_name}` uses effect `{eff}` which is not in @capabilities budget", fn_node, "add `{eff}` to @capabilities")
                    }
                    ei = ei + 1
                }
            }
        }
        fi = fi + 1
    }
}

pub fn tc_fn_has_effect(name: Str, eff: Str) -> Int {
    let sig = lookup_fnsig(name)
    if sig == -1 { return 0 }
    let fs = fnsig_pool.get(sig).unwrap()
    let mut i = 0
    while i < fs.effects_count {
        if fnsig_effect_names.get(fs.effects_start + i).unwrap() == eff { return 1 }
        i = i + 1
    }
    0
}

// The traits the compiler reads by name, from sources that need not write the name: the
// prelude's, which codegen and the checker dispatch to by name (Display for an interpolation,
// Eq for `==`, Closeable for `with`, IntoIterator for `for`), and the ones registered with no
// declaration. Valid after tc_set_prelude_modules.
pub fn tc_builtin_trait_names(program: Int) -> List[Str] {
    let mut names = tc_undeclared_trait_names()
    let traits_sl = node_arms(program)
    if traits_sl != -1 {
        for name in tc_prelude_trait_names(traits_sl) { names.push(name) }
    }
    names
}

// The built-in method-surface traits are prelude + sealed (§3.2.2 /
// §10.6): user code may neither redefine them nor write an impl of them.
// Single source of truth for both the redefinition check (trait-registration
// loop) and the impl check (validate_trait_impls).
fn is_sealed_builtin_trait(name: Str) -> Int {
    if name == "StrOps" || name == "BytesOps" || name == "StringBuildOps" || name == "Sized" { return 1 }
    if name == "Contains" || name == "ListOps" || name == "MapOps" || name == "SetOps" || name == "Joinable" { return 1 }
    0
}

// The sealed built-in TYPES a user may never write an impl of. The spec's
// authoritative enumeration is §3c.4:737 (Str, List, Map, Set, Bytes,
// StringBuilder, Instant, Duration, Iterator) — their method surfaces are
// sealed and the types themselves are closed (§3c.1:38 "closed, exactly as Str
// and List are closed"). Range is a closed collection carrier too (§3c.1:11,
// §2 Range[T: Ord]) even though it has no dedicated Ops trait. Naming one in
// the trait position of an impl is a sealed-type violation (E0907), not an
// undefined-trait (E0904): the name IS defined, just not implementable.
fn is_sealed_builtin_type(name: Str) -> Int {
    if name == "Iterator" || name == "List" || name == "Map" || name == "Set" { return 1 }
    if name == "Str" || name == "Bytes" || name == "StringBuilder" { return 1 }
    if name == "Instant" || name == "Duration" || name == "Range" { return 1 }
    0
}

// A declaration is user-sourced when its module is empty or the synthetic
// main module — the stdlib defs that legitimately back the sealed traits
// carry their dotted module (e.g. "std.traits") during this pass.
fn is_user_sourced(node: Int) -> Int {
    let m = node_module(node)
    if m == "" || m == "__main__" { return 1 }
    0
}

// Whether a name written in a trait method signature resolves to anything. The impl
// header's acceptance set (a declared type, a builtin, a trait name) plus what only a
// trait has: `Self`, an associated type reached through it, the trait's own type
// parameters, and the method's own. The trait's parameters answer through the active
// scope, which register_trait has pushed; the method's are not pushed there, so they are
// read off the method node.
// A trait whose declaration already reported an unknown type in a method signature.
// The recorded signature is then whatever the resolver could salvage, so a contract
// difference measured against it names two types the programmer cannot tell apart and
// cannot repair. Report the declaration once and stay quiet about its impls.
let mut tc_trait_sig_poisoned: Map[Str, Int] = Map()

fn tc_trait_sig_name_declared(name: Str, m: Int) -> Int {
    if name == "Self" { return 1 }
    if name.starts_with("Self.") { return 1 }
    if is_known_type(name) != 0 { return 1 }
    if is_trait_name(name) != 0 { return 1 }
    if tc_active_binder_node(name) != NO_BINDER_NODE { return 1 }
    let mtp = node_type_params(m)
    if mtp != -1 {
        let mut i = 0
        while i < sublist_length(mtp) {
            if node_name(sublist_get(mtp, i)) == name { return 1 }
            i = i + 1
        }
    }
    0
}

// Report every name in one written trait-signature annotation that nothing declares.
// resolve_type_parts lowers a name it cannot place to a free type variable, because its
// other callers need that; a trait signature is a declaration site, so here the name has
// to be an error instead. Left as a type variable it became a parameter the trait never
// declared and no caller could solve, which an impl then matched by accident.
//
// Reports the outermost unknown name and stops descending: a name that resolves to
// nothing has no arguments worth blaming separately.
fn tc_check_trait_sig_ann(ann: Int, trait_name: Str, mname: Str, m: Int) ! Diag.Report {
    if ann == -1 { return }
    let name = node_name(ann)
    if tc_report_reserved_unbuilt(name, ann) != 0 {
        tc_trait_sig_poisoned.insert(trait_name, 1)
        return
    }
    if name != "" && tc_trait_sig_name_declared(name, m) == 0 {
        tc_trait_sig_poisoned.insert(trait_name, 1)
        diag_error_at("UnknownType", UNKNOWN_TYPE, "unknown type `{name}` in method `{mname}` of trait `{tc_trait_shown(trait_name)}`", ann,
            "a trait signature may name a declared type, a builtin type, `Self`, an associated type, or one of the trait's or method's own type parameters")
        return
    }
    // `Template[E]` and `Handler[E]` carry an EFFECT in their argument position. An effect
    // is not in the type namespace, so that position is not read as a type here either.
    let core = tc_compiler_known_type_meant(name, ann)
    if core == "Template" || core == "Handler" { return }
    let elems = node_elements(ann)
    if elems != -1 {
        let mut i = 0
        while i < sublist_length(elems) {
            tc_check_trait_sig_ann(sublist_get(elems, i), trait_name, mname, m)
            i = i + 1
        }
    }
    // `fn(A, B) -> R` keeps its parameters in `elements` and its return in `type_ann`.
    if name == "Fn" { tc_check_trait_sig_ann(node_type_ann(ann), trait_name, mname, m) }
}

// The arithmetic traits, Serialize, Deserialize and Iterator have no trait declaration, and a
// bound, an operator, a derive or a type reads them by name.
fn tc_undeclared_trait_names() -> List[Str] {
    ["From", "TryFrom", "Into", "IntoIterator", "Add", "Sub", "Mul", "Div", "Rem", "Neg", "Serialize", "Deserialize", "Iterator"]
}

fn tc_prelude_trait_names(traits_sl: Int) -> List[Str] {
    let mut names: List[Str] = []
    let mut i = 0
    while i < sublist_length(traits_sl) {
        let tr = sublist_get(traits_sl, i)
        if tc_prelude_modules.contains_key(node_module(tr)) { names.push(node_name(tr)) }
        i = i + 1
    }
    names
}

// ── A trait is known by its module and its name ─────────────────────
//
// Every trait table is keyed by the trait's identity. A trait no other declaration answers to
// keeps its bare name, as does a compiler-known one (a prelude module's, or one with no
// declaration), so the compiler's own uses of `Eq` or `TryFrom` keep naming those. A trait
// whose name a compiler-known trait or another module's trait also has is keyed
// `Name@module`. A name written in a file reaches one of them only through that file's scope
// (sections/07 §10.6, a shadow has module scope).

// Files each trait declaration under its identity before any registers, so a supertrait
// clause resolves against every trait in the program.
fn tc_file_trait_keys(traits_sl: Int, prelude_traits: List[Str]) {
    let compiler_known = tc_undeclared_trait_names()
    let mut first_module: Map[Str, Str] = Map()
    let mut shared: Map[Str, Int] = Map()
    let mut i = 0
    while i < sublist_length(traits_sl) {
        let tr = sublist_get(traits_sl, i)
        let name = node_name(tr)
        let m = node_module(tr)
        if !tc_prelude_modules.contains_key(m) {
            if compiler_known.contains(name) || prelude_traits.contains(name) { shared.insert(name, 1) }
            match first_module.get(name) {
                Some(seen) => if seen != m { shared.insert(name, 1) }
                None => first_module.insert(name, m)
            }
        }
        i = i + 1
    }
    i = 0
    while i < sublist_length(traits_sl) {
        let tr = sublist_get(traits_sl, i)
        let name = node_name(tr)
        let key = if tc_prelude_modules.contains_key(node_module(tr)) || !shared.contains_key(name) { name } else { "{name}@{node_module(tr)}" }
        tc_trait_node_idx.insert(key, tr)
        i = i + 1
    }
}

// The identity of a trait declaration, once tc_file_trait_keys has filed it.
fn tc_trait_key_of(tr: Int) -> Str {
    let name = node_name(tr)
    if tc_prelude_modules.contains_key(node_module(tr)) { return name }
    if (tc_trait_node_idx.get(name) ?? -1) == tr { return name }
    "{name}@{node_module(tr)}"
}

// The name a trait was declared under, as a help line writes it.
fn tc_trait_spelling(key: Str) -> Str {
    match key.byte_index_of("@", 0) {
        Some(at) => key.byte_slice(0, at)
        None => key
    }
}

// A user name as one part of a C symbol. `_` becomes `_1`, so in a symbol `_` before a letter
// only ever joins two parts, and no name can pass for two. An identifier never starts with a
// digit, which leaves `_<digit>` free to mark structure: `_0` opens a mono argument, `_2` the
// module of a shared trait, `_3` ends a main-file type that takes a compiler-known name.
pub fn tc_sym_escape(s: Str) -> Str {
    s.replace("_", "_1")
}

// The trait segment of an impl method's signature key and of its C symbol. One type may hold
// two traits of one spelling, so a shared name carries its module after `_2`, which no
// escaped name holds; every other trait is its escaped name alone.
fn tc_trait_segment(key: Str) -> Str {
    match key.byte_index_of("@", 0) {
        Some(at) => "{tc_sym_escape(key.byte_slice(0, at))}_2{key.byte_slice(at + 1, key.byte_len())}"
        None => tc_sym_escape(key)
    }
}

// The signature key of a trait impl's method, which is also the stem of its C symbol, so the
// two cannot name different methods.
pub fn tc_impl_method_stem(impl_type: Str, trait_key: Str, mname: Str) -> Str {
    "{tc_sym_escape(impl_type)}_{tc_trait_segment(trait_key)}_{tc_sym_escape(mname)}"
}

// The signature key of a From or TryFrom impl's method, and the stem of its C symbol, with the
// source spelled the way the caller names types. One type takes many sources, so the source
// follows the method's stem as a mono argument after `_0`, which no other stem holds there.
pub fn tc_impl_conv_stem(impl_type: Str, trait_key: Str, mname: Str, src: Str) -> Str {
    "{tc_impl_method_stem(impl_type, trait_key, mname)}_0{tc_sym_escape(src)}"
}

// A " and "-joined list of trait keys, as a diagnostic names them.
fn tc_traits_shown(keys: Str) -> Str {
    let mut shown: List[Str] = []
    for k in keys.split(" and ") {
        shown.push(tc_trait_shown(k))
    }
    shown.join(" and ")
}

// How a diagnostic names a trait: `Eq (geo.sim)` for one that shares its name.
fn tc_trait_shown(key: Str) -> Str {
    match key.byte_index_of("@", 0) {
        Some(at) => tc_name_with_module(key.byte_slice(0, at), key.byte_slice(at + 1, key.byte_len()))
        None => key
    }
}

// `Name (module)`: how a diagnostic tells apart two declarations of one name
// (sections/07_trust_modules_metadata.md, "Diagnostics that involve a shadowing name").
fn tc_name_with_module(name: Str, mod_key: Str) -> Str {
    "{name} ({tc_module_display_name(mod_key)})"
}

// How a diagnostic names a module: `main`, its dotted import path, or the name an `@module`
// gives it. The import path of a file that names its module with `@module` reaches only that
// one of the module's files.
fn tc_module_display_name(mod_key: Str) -> Str {
    if tc_module_key_is_main(mod_key) != 0 { return "main" }
    let dotted = tc_get_dotted_module_path(mod_key)
    if dotted.replace(".", "_") == mod_key { dotted } else { mod_key }
}

// The trait declaration `member` names inside module `target`, or -1, following a `pub
// import` that re-exports it as nr_resolve_decl_in_module does.
fn tc_trait_decl_in_module(target: Str, member: Str, depth: Int) -> Int {
    if target == "" { return -1 }
    let shared = tc_trait_node_idx.get("{member}@{target}") ?? -1
    if shared != -1 { return shared }
    let alone = tc_trait_node_idx.get(member) ?? -1
    if alone != -1 && node_module(alone) == target { return alone }
    if depth >= 8 { return -1 }
    for src in nr_reexport_sources(target, member) {
        let hit = tc_trait_decl_in_module(src, member, depth + 1)
        if hit != -1 { return hit }
    }
    -1
}

// The identity of the trait a name written in module `consuming_mod` names. A qualified name
// reaches the trait the qualified module declares. A bare name reaches the module's own
// trait, then one its imports select, then the compiler-known trait of that name; a trait
// another module declares is never in scope under its bare name alone.
fn tc_trait_ref_key(written: Str, consuming_mod: Str) -> Str {
    let name = strip_module_qualifier(written)
    if name != written {
        let key = tc_qualified_trait_key(written, consuming_mod)
        return if key == "" { name } else { key }
    }
    if consuming_mod == "" { return name }
    let alone = tc_trait_node_idx.get(name) ?? -1
    if alone != -1 && node_module(alone) == consuming_mod { return name }
    let own = tc_trait_node_idx.get("{name}@{consuming_mod}") ?? -1
    if own != -1 { return tc_trait_key_of(own) }
    // An import outranks a trait another module declares under the same name, so
    // `import blink.core.{Eq as CoreEq}` holds where some other module has a `CoreEq`.
    let core = tc_core_alias_target(name, consuming_mod)
    if core != "" { return core }
    match nr_module_import_index(consuming_mod).get(name) {
        Some(binds) => {
            for b in binds {
                let d = tc_trait_decl_in_module(b.source_mod, b.member, 0)
                if d != -1 { return tc_trait_key_of(d) }
            }
        }
        None => {}
    }
    name
}

// The trait a qualified name such as `sim.Eq` reaches, by its key, or "" when the qualifier
// names no module that declares it. "" keeps a misspelt qualifier from falling back to the
// compiler-known trait of the bare name.
fn tc_qualified_trait_key(written: Str, consuming_mod: Str) -> Str {
    let name = strip_module_qualifier(written)
    let qualifier = written.byte_slice(0, written.byte_len() - name.byte_len() - 1)
    let target = nr_qualifier_module_in(qualifier, consuming_mod)
    if target == "blink_core" && tc_trait_is_compiler_known(name) { return name }
    let d = tc_trait_decl_in_module(target, name, 0)
    if d == -1 { "" } else { tc_trait_key_of(d) }
}

// The compiler-known trait that `written` names in module `in_mod` through an import from
// blink.core, such as `import blink.core.{Eq as CoreEq}`, or "". That import is what puts the
// name in scope, and the trait it names is in no module a scope check could look in.
// collect_imports keys the pseudo-module by its path with `_` for `.`.
fn tc_core_alias_target(written: Str, in_mod: Str) -> Str {
    tc_compiler_known_import(written, in_mod, false)
}

// The type a static-call qualifier names: a name imported from a compiler-known type's home
// under another name (`CoreBytes.from_str`) is that type, as `Bytes.from_str` is.
pub fn tc_static_qualifier(written: Str) -> Str {
    let core = tc_core_type_alias_target(written, nr_current_module)
    if core != "" { core } else { written }
}

// The compiler-known type that `written` names in module `in_mod` through an import from the
// type's home, such as `import blink.core.{Option as CoreOption}` or
// `import blink.ffi.{Ptr as RawPtr}`, or "".
fn tc_core_type_alias_target(written: Str, in_mod: Str) -> Str {
    tc_compiler_known_import(written, in_mod, true)
}

// The member a pseudo-module import binds `written` to in `in_mod`, when that member is a
// compiler-known type (`want_type`) or trait at that home, else "".
fn tc_compiler_known_import(written: Str, in_mod: Str, want_type: Bool) -> Str {
    if in_mod == "" { return "" }
    match nr_module_import_index(in_mod).get(written) {
        Some(binds) => {
            for b in binds {
                if want_type {
                    let home = tc_shadowable_type_home(b.member)
                    if home != "" && b.source_mod == home.replace(".", "_") { return b.member }
                } else if b.source_mod == "blink_core" && tc_trait_is_compiler_known(b.member) {
                    return b.member
                }
            }
        }
        None => {}
    }
    ""
}

// The local trait that shadows the compiler-known `tr` in module `in_mod`, by its key, or "".
fn tc_shadowing_trait_key(tr: Str, in_mod: Str) -> Str {
    if in_mod == "" || !tc_trait_is_compiler_known(tr) { return "" }
    let key = tc_trait_ref_key(tr, in_mod)
    if key == tr { "" } else { key }
}

// How this module's diagnostics name the compiler-known `tr`: with its home when a local trait
// shadows it, so the reader can tell the two apart.
fn tc_core_trait_shown(tr: Str) -> Str {
    if tc_shadowing_trait_key(tr, nr_current_module) == "" { tr } else { "{tr} (blink.core)" }
}

// The note that says the `tr` this module names is not the one a compiler-inserted form uses.
fn tc_shadowed_trait_notes(tr: Str) -> List[Str] {
    let key = tc_shadowing_trait_key(tr, nr_current_module)
    if key == "" { return [] }
    if tc_trait_is_compiler_known(key) {
        return ["`{tr}` in this module is `{key} (blink.core)`, imported under the name `{tr}`"]
    }
    ["`{tr}` in this module is `{tc_trait_shown(key)}`, a different trait with the same name as `{tr} (blink.core)`"]
}

// The name module `in_mod` already imports the compiler-known trait `tr` under, other than
// `tr` itself, or "".
fn tc_core_alias_in(tr: Str, in_mod: Str) -> Str {
    tc_compiler_known_alias_in(tr, in_mod, false)
}

// The name module `in_mod` already imports the compiler-known type `name` under, other than
// `name` itself, or "".
fn tc_core_type_alias_in(name: Str, in_mod: Str) -> Str {
    tc_compiler_known_alias_in(name, in_mod, true)
}

fn tc_compiler_known_alias_in(name: Str, in_mod: Str, want_type: Bool) -> Str {
    if in_mod == "" { return "" }
    for local in nr_module_import_index(in_mod).keys() {
        if local != name && tc_compiler_known_import(local, in_mod, want_type) == name { return local }
    }
    ""
}

// The name a fix writes for the compiler-known `tr` in module `in_mod`: `tr`, or where a local
// trait shadows it, the alias the module already imports, else `Core{tr}` (sections/07 §10.6).
fn tc_core_name_in(tr: Str, in_mod: Str) -> Str {
    if tc_shadowing_trait_key(tr, in_mod) == "" { return tr }
    let alias = tc_core_alias_in(tr, in_mod)
    if alias == "" { "Core{tr}" } else { alias }
}

// The import that tc_core_name_in's name needs first, or "" when the module needs none.
fn tc_core_import_in(tr: Str, in_mod: Str) -> Str {
    if tc_shadowing_trait_key(tr, in_mod) == "" || tc_core_alias_in(tr, in_mod) != "" { return "" }
    "import blink.core.\{{tr} as Core{tr}\}"
}

// A bound on `tpname` that names the compiler-known `tr` in this module, after the alias
// import it needs, if any.
fn tc_core_bound_fix(tr: Str, tpname: Str) -> Str {
    let bound = "add the bound `[{tpname}: {tc_core_name_in(tr, nr_current_module)}]`"
    let imp = tc_core_import_in(tr, nr_current_module)
    if imp == "" { bound } else { "{imp}\nthen {bound}" }
}

fn tc_type_decl_module(tname: Str) -> Str {
    let td = tc_decl_node_for_type(tname)
    if td == -1 { "" } else { node_module(td) }
}

// The @derive argument that names the compiler-known `tr` in the module that declares type
// `tname`, since `@derive(tr)` names a local trait where one shadows `tr` there.
fn tc_derive_arg_for(tr: Str, tname: Str) -> Str {
    tc_core_name_in(tr, tc_type_decl_module(tname))
}

// The alias imports a fix that derives `trs` on `tname` needs first, one per line, or "".
fn tc_derive_fix_imports(trs: List[Str], tname: Str) -> Str {
    let m = tc_type_decl_module(tname)
    let mut out = ""
    for tr in trs {
        let imp = tc_core_import_in(tr, m)
        if imp != "" { out = "{out}{imp}\n" }
    }
    out
}

// Whether the trait key `key` is a compiler-known trait: one a prelude module declares, or
// one with no declaration. A user trait of the same name is keyed `Name@module`, but a user
// trait no other declaration shares keeps its bare name, so a bare key alone proves nothing.
fn tc_trait_is_compiler_known(key: Str) -> Bool {
    if tc_undeclared_trait_names().contains(key) { return true }
    let d = tc_trait_node_idx.get(key) ?? -1
    d != -1 && tc_prelude_modules.contains_key(node_module(d))
}

// The trait a bound, a where-bound or a supertrait clause names, read in the file that
// wrote it (tc_stamp_trait_ref_modules).
fn tc_bound_trait(b: Int) -> Str {
    tc_trait_ref_key(node_name(b), node_module(b))
}

// The trait an impl header names.
pub fn tc_impl_trait_id(im: Int) -> Str {
    tc_trait_ref_key(node_trait_name(im), node_module(im))
}

// Only declarations carry the module they were written in. A trait-naming node inside one (a
// bound, a where-bound, a supertrait) gets its declaration's module, so whatever reads that
// name resolves it through the file that wrote it.
fn tc_stamp_trait_ref_modules(program: Int) {
    let fns_sl = node_params(program)
    if fns_sl != -1 {
        let mut i = 0
        while i < sublist_length(fns_sl) {
            let f = sublist_get(fns_sl, i)
            tc_stamp_bounds(node_type_params(f), node_module(f))
            tc_stamp_bounds(node_impl_where_bounds(f), node_module(f))
            i = i + 1
        }
    }
    let types_sl = node_fields(program)
    if types_sl != -1 {
        let mut i = 0
        while i < sublist_length(types_sl) {
            let td = sublist_get(types_sl, i)
            tc_stamp_bounds(node_type_params(td), node_module(td))
            for a in tc_decl_derive_args(td) { node_set_module(a, node_module(td)) }
            i = i + 1
        }
    }
    let traits_sl = node_arms(program)
    if traits_sl != -1 {
        let mut i = 0
        while i < sublist_length(traits_sl) {
            let tr = sublist_get(traits_sl, i)
            let m = node_module(tr)
            tc_stamp_bounds(node_type_params(tr), m)
            tc_stamp_names(node_supertraits(tr), m)
            tc_stamp_method_bounds(node_methods(tr), m)
            i = i + 1
        }
    }
    let impls_sl = node_methods(program)
    if impls_sl != -1 {
        let mut i = 0
        while i < sublist_length(impls_sl) {
            let im = sublist_get(impls_sl, i)
            let m = node_module(im)
            tc_stamp_bounds(node_impl_binders(im), m)
            tc_stamp_bounds(node_impl_where_bounds(im), m)
            tc_stamp_method_bounds(node_methods(im), m)
            i = i + 1
        }
    }
}

fn tc_stamp_method_bounds(methods_sl: Int, m: Str) {
    if methods_sl == -1 { return }
    let mut i = 0
    while i < sublist_length(methods_sl) {
        tc_stamp_bounds(node_type_params(sublist_get(methods_sl, i)), m)
        tc_stamp_bounds(node_impl_where_bounds(sublist_get(methods_sl, i)), m)
        i = i + 1
    }
}

// The bounds of each type parameter (or where-constraint) in `tparams_sl`.
fn tc_stamp_bounds(tparams_sl: Int, m: Str) {
    if tparams_sl == -1 { return }
    let mut i = 0
    while i < sublist_length(tparams_sl) {
        tc_stamp_names(node_elements(sublist_get(tparams_sl, i)), m)
        i = i + 1
    }
}

fn tc_stamp_names(names_sl: Int, m: Str) {
    if names_sl == -1 { return }
    let mut i = 0
    while i < sublist_length(names_sl) {
        node_set_module(sublist_get(names_sl, i), m)
        i = i + 1
    }
}

// A trait method declaration as a fnsig, so a call through a bound or a qualified call on a
// bounded receiver runs the keyword and count rules against the one declaration it names.
// The parameter tids are the ones the contract check registered, with no annotation (`self`)
// read as TYPE_UNKNOWN as register_fn_sig reads it. Kept out of fnsig_map: the key is never
// looked up.
fn tc_register_trait_method_sig(key: Str, m: Int, p_start: Int, ret: Int) -> Int {
    let start = fnsig_param_list.len()
    let params_sl = node_params(m)
    let mut count = 0
    if params_sl != -1 {
        while count < sublist_length(params_sl) {
            let p = sublist_get(params_sl, count)
            let ptid = tc_tmsig_param_tids.get(p_start + count).unwrap()
            fnsig_param_list.push(if ptid == -1 { TYPE_UNKNOWN } else { ptid })
            fnsig_param_names.push(node_name(p))
            fnsig_param_kw.push(node_int_val(p))
            fnsig_param_default.push(node_value(p))
            count = count + 1
        }
    }
    let sig = fnsig_pool.len()
    fnsig_pool.push(FnSigEntry { name: key, ret: ret, params_start: start, params_count: count, type_params_start: fnsig_type_param_names.len(), type_params_count: 0, effects_start: fnsig_effect_names.len(), effects_count: 0, decl: m })
    sig
}

fn register_trait(tr_node: Int) ! TypeCheck.Register, TypeCheck.Resolve, Diag.Report {
    let name = tc_trait_key_of(tr_node)
    tc_trait_names.push(name)
    // Collect trait-level type params (e.g., T in trait From[T])
    let tparams_sl = node_type_params(tr_node)
    let tp_start = tc_trait_tparam_names.len()
    let mut tp_count = 0
    if tparams_sl != -1 {
        let mut ti = 0
        while ti < sublist_length(tparams_sl) {
            let tp = sublist_get(tparams_sl, ti)
            tc_trait_tparam_names.push(node_name(tp))
            tc_trait_tparam_nodes.push(tp)
            tp_count = tp_count + 1
            ti = ti + 1
        }
    }
    // Record the declared tparam count by trait name for the E0910
    // arity check, independent of whether the trait has any methods.
    tc_trait_tparam_count_idx.insert(name, tp_count)
    tc_trait_node_idx.insert(name, tr_node)
    // Record direct supertraits for the E0911 obligation check.
    let mut supers = "|"
    let sup_sl = node_supertraits(tr_node)
    if sup_sl != -1 {
        let mut spi = 0
        while spi < sublist_length(sup_sl) {
            supers = tc_pipe_add(supers, tc_bound_trait(sublist_get(sup_sl, spi)))
            spi = spi + 1
        }
    }
    tc_trait_supers_idx.insert(name, supers)
    let methods_sl = node_methods(tr_node)
    if methods_sl != -1 {
        // The trait's own tparams are in scope inside its method signatures;
        // resolve each signature type to a tid once here (register precedes every
        // impl check), leaving Self / trait-tparams / Self.assoc as typevars that
        // the per-impl substitution binds. Validation is suppressed: a signature
        // type is re-resolved here, not a freshly written position.
        tc_push_tparam_scope(tparams_sl)
        let saved_suppress = tc_suppress_ann_validation
        tc_suppress_ann_validation = 1
        let mut i = 0
        while i < sublist_length(methods_sl) {
            let m = sublist_get(methods_sl, i)
            let mname = node_name(m)
            tc_trait_method_names.push("{name}.{mname}")
            tc_method_block.insert(m, tr_node)
            // Store method signature for contract validation
            let p_start = tc_tmsig_param_tids.len()
            let params_sl = node_params(m)
            let mut p_count = 0
            if params_sl != -1 {
                let mut j = 0
                while j < sublist_length(params_sl) {
                    let p = sublist_get(params_sl, j)
                    // `self` carries no annotation. That is an absence, not a type the
                    // impl must match, and the contract check skips it on that basis.
                    let p_ann = node_type_ann(p)
                    tc_check_trait_sig_ann(p_ann, name, mname, m)
                    tc_tmsig_param_tids.push(if p_ann == -1 { -1 } else { resolve_type_ann(p_ann) })
                    p_count = p_count + 1
                    j = j + 1
                }
            }
            // An omitted arrow on the TRAIT side means Void, the same reading the impl
            // side already takes below. Left as a no-info value it skipped the return
            // contract check entirely, so an impl could return anything at all.
            let m_ann = node_type_ann(m)
            tc_check_trait_sig_ann(m_ann, name, mname, m)
            let m_ret = if m_ann == -1 { TYPE_VOID } else { resolve_type_ann(m_ann) }
            let m_sig = tc_register_trait_method_sig("{name}.{mname}", m, p_start, m_ret)
            tc_tmsig_pool.push(TraitMethodSigEntry { trait_name: name, method: mname, ret_tid: m_ret, tparams_start: tp_start, tparams_count: tp_count, params_start: p_start, params_count: p_count, sig: m_sig })
            i = i + 1
        }
        tc_suppress_ann_validation = saved_suppress
        tc_pop_tparam_scope(tparams_sl)
    }
    let assoc_sl = node_assoc_types(tr_node)
    if assoc_sl != -1 {
        let mut ai = 0
        while ai < sublist_length(assoc_sl) {
            let at_node = sublist_get(assoc_sl, ai)
            let aname = node_name(at_node)
            tc_trait_assoc_names.push("{name}.{aname}")
            ai = ai + 1
        }
    }
}

// Substitute the trait method's Self /
// trait-tparams / associated types by the concrete tids this impl binds them
// to, then return the resulting tid. `Self` → the impl receiver; each trait
// tparam name → the impl's positional trait-arg; each `Self.<assoc>` typevar
// → the impl's `type <assoc> = ...` binding. Caller must have the impl binder
// scope pushed and ann-validation suppressed.
fn subst_trait_type_tid(type_tid: Int, impl_recv_tid: Int, tmsig_idx: Int, impl_node: Int) -> Int ! TypeCheck.Resolve, Diag.Report {
    if tc_tid_is_no_info(type_tid) != 0 { return type_tid }
    let mut binds: Map[Str, Int] = Map()
    binds.insert("Self", impl_recv_tid)
    binds.insert(tc_binder_key(SELF_BINDER_NODE, "Self"), impl_recv_tid)
    let _tmsig = tc_tmsig_pool.get(tmsig_idx).unwrap()
    let tp_start = _tmsig.tparams_start
    let tp_count = _tmsig.tparams_count
    if tp_count > 0 {
        let impl_targs_sl = node_type_params(impl_node)
        let mut k = 0
        while k < tp_count {
            let tp_name = tc_trait_tparam_names.get(tp_start + k).unwrap()
            let tp_node = tc_trait_tparam_nodes.get(tp_start + k) ?? NO_BINDER_NODE
            if impl_targs_sl != -1 && k < sublist_length(impl_targs_sl) {
                let tp_tid = resolve_type_ann(sublist_get(impl_targs_sl, k))
                binds.insert(tp_name, tp_tid)
                binds.insert(tc_binder_key(tp_node, tp_name), tp_tid)
            }
            k = k + 1
        }
    }
    let assoc_sl = node_assoc_types(impl_node)
    if assoc_sl != -1 {
        let mut ai = 0
        while ai < sublist_length(assoc_sl) {
            let at_node = sublist_get(assoc_sl, ai)
            let at_name = "Self.{node_name(at_node)}"
            let at_tid = resolve_type_ann(node_type_ann(at_node))
            binds.insert(at_name, at_tid)
            binds.insert(tc_binder_key(NO_BINDER_NODE, at_name), at_tid)
            ai = ai + 1
        }
    }
    substitute_typevar_tid(type_tid, binds)
}

// The binds a call through a bound reads the trait method's declared signature with: `Self`
// is the receiver's type parameter and each trait type parameter is the bound's argument, so
// through `U: Tr[Int]` the trait's `T` is `Int`. The bound is read off the receiver's binder,
// which keeps the argument a bound spelled with another type parameter (`U: Tr[V]`) in that
// declaration's scope. A trait type parameter the bound gives no argument for stays unbound.
fn tc_bound_call_binds(recv_tid: Int, tmsig_idx: Int) -> Map[Str, Int] ! TypeCheck.Resolve, Diag.Report {
    let mut binds: Map[Str, Int] = Map()
    binds.insert("Self", recv_tid)
    binds.insert(tc_binder_key(SELF_BINDER_NODE, "Self"), recv_tid)
    let tm = tc_tmsig_pool.get(tmsig_idx).unwrap()
    if tm.tparams_count == 0 { return binds }
    let arg_tids = tc_bound_trait_arg_tids(tc_tid_binder(recv_tid), tm.trait_name)
    let mut k = 0
    while k < tm.tparams_count && k < arg_tids.len() {
        let tp_name = tc_trait_tparam_names.get(tm.tparams_start + k).unwrap()
        let tp_node = tc_trait_tparam_nodes.get(tm.tparams_start + k) ?? NO_BINDER_NODE
        let arg_tid = arg_tids.get(k).unwrap()
        binds.insert(tp_name, arg_tid)
        binds.insert(tc_binder_key(tp_node, tp_name), arg_tid)
        k = k + 1
    }
    binds
}

// The trait arguments the type parameter declared at `binder` is bounded by `trait_name`
// at (`[Int]` of `U: Tr[Int]`), empty when its bounds do not name the trait with arguments.
// An impl's `where T: Tr[Int]` bounds the impl's `T` from a node of its own, which the frame
// for that binder carries, so every active frame of the binder is read, not the binder alone.
fn tc_bound_trait_arg_tids(binder: Int, trait_name: Str) -> List[Int] ! TypeCheck.Resolve, Diag.Report {
    if binder < 0 { return [] }
    let mut i = tc_tp_frames.len() - 1
    while i >= 0 {
        let f = tc_tp_frames.get(i).unwrap()
        if f.binder == binder {
            let args = tc_bounds_node_trait_arg_tids(f.bounds_node, trait_name)
            if args.len() > 0 { return args }
        }
        i = i - 1
    }
    tc_bounds_node_trait_arg_tids(binder, trait_name)
}

fn tc_resolve_type_args(args_sl: Int) -> List[Int] ! TypeCheck.Resolve, Diag.Report {
    let mut out: List[Int] = []
    if args_sl == -1 { return out }
    let mut i = 0
    while i < sublist_length(args_sl) {
        out.push(resolve_type_ann(sublist_get(args_sl, i)))
        i = i + 1
    }
    out
}

// The arguments one TypeParam or `where` constraint node bounds its parameter by `trait_name`
// at, or empty.
fn tc_bounds_node_trait_arg_tids(bounds_node: Int, trait_name: Str) -> List[Int] ! TypeCheck.Resolve, Diag.Report {
    if bounds_node < 0 { return [] }
    if node_kind(bounds_node) != NodeKind.TypeParam { return [] }
    let bounds = node_elements(bounds_node)
    if bounds == -1 { return [] }
    let mut i = 0
    while i < sublist_length(bounds) {
        let b = sublist_get(bounds, i)
        if tc_bound_trait(b) == trait_name { return tc_resolve_type_args(node_elements(b)) }
        i = i + 1
    }
    // A trait the bound guarantees through a supertrait clause takes that clause's arguments.
    i = 0
    while i < sublist_length(bounds) {
        let b = sublist_get(bounds, i)
        let args = tc_super_clause_arg_tids(tc_bound_trait(b), tc_resolve_type_args(node_elements(b)), trait_name, "|")
        if args.len() > 0 { return args }
        i = i + 1
    }
    []
}

// The arguments a supertrait clause of trait `key`, or of one of its supertraits, names
// `trait_name` at, read with `key`'s own type parameters bound to `key_args`: through
// `trait Sub[X]: Tr[X]` and the bound `Sub[Int]`, `Tr` takes `[Int]`. Empty when no clause
// names the trait with arguments.
fn tc_super_clause_arg_tids(key: Str, key_args: List[Int], trait_name: Str, seen: Str) -> List[Int] ! TypeCheck.Resolve, Diag.Report {
    if tc_pipe_has(seen, key) != 0 { return [] }
    let tr = tc_trait_node_idx.get(key) ?? -1
    if tr == -1 { return [] }
    let sup = node_supertraits(tr)
    if sup == -1 { return [] }
    let tparams_sl = node_type_params(tr)
    let mut binds: Map[Str, Int] = Map()
    let mut k = 0
    while tparams_sl != -1 && k < sublist_length(tparams_sl) && k < key_args.len() {
        let tp_node = sublist_get(tparams_sl, k)
        binds.insert(node_name(tp_node), key_args.get(k).unwrap())
        binds.insert(tc_binder_key(tp_node, node_name(tp_node)), key_args.get(k).unwrap())
        k = k + 1
    }
    let mut named: List[Str] = []
    let mut clause_args: List[List[Int]] = []
    let mut i = 0
    while i < sublist_length(sup) {
        let clause = sublist_get(sup, i)
        named.push(tc_bound_trait(clause))
        clause_args.push(tc_clause_arg_tids(clause, tparams_sl, binds))
        i = i + 1
    }
    i = 0
    while i < named.len() {
        if named.get(i).unwrap() == trait_name { return clause_args.get(i).unwrap() }
        i = i + 1
    }
    let seen_here = tc_pipe_add(seen, key)
    i = 0
    while i < named.len() {
        let args = tc_super_clause_arg_tids(named.get(i).unwrap(), clause_args.get(i).unwrap(), trait_name, seen_here)
        if args.len() > 0 { return args }
        i = i + 1
    }
    []
}

// One supertrait clause's arguments, resolved in the declaring trait's scope and then read
// at `binds`. The clause was checked where the trait registered, so it is not re-validated.
fn tc_clause_arg_tids(clause: Int, tparams_sl: Int, binds: Map[Str, Int]) -> List[Int] ! TypeCheck.Resolve, Diag.Report {
    tc_push_tparam_scope(tparams_sl)
    let saved_suppress = tc_suppress_ann_validation
    tc_suppress_ann_validation = 1
    let mut args: List[Int] = []
    for a in tc_resolve_type_args(node_elements(clause)) {
        args.push(substitute_typevar_tid(a, binds))
    }
    tc_suppress_ann_validation = saved_suppress
    tc_pop_tparam_scope(tparams_sl)
    args
}

// One deep trait-contract compare: `verdict` is -1 when a side is unknown
// (can't judge — fail-open), 0 when the deep tids agree, 1 when they differ.
// `actual`/`expected` carry the tids so the caller can render them.
// Two distinct types can render to a single string: a type parameter prints as its spelling,
// which an impl binder may share with a declared type. Identity is in the binder, not the
// letters, so where two renderings collide the message says where each type came from.
// `type_to_str` itself is not touched — one string per type identity is what its other
// readers depend on.
fn tc_type_origin_qualifier(tid: Int) -> Str {
    if tc_tid_kind(tid) != TyKind.Typevar { return " (the declared type)" }
    let b = tc_tid_binder(tid)
    if b == SELF_BINDER_NODE { return " (the implementing type)" }
    if b == NO_BINDER_NODE || b == BUILTIN_BINDER_NODE { return " (a type parameter)" }
    " (the type parameter declared at line {node_line(b)})"
}

type TraitContractTidResult {
    verdict: Int
    actual: Int
    expected: Int
}

// Deep contract check: does the impl's method signature type at `impl_ann`
// match what the trait requires (`trait_tid`, after binding Self / trait-tparams
// / associated types to this impl), compared by interned tid? Caller must have
// the impl binder scope pushed. Suppression of re-validation is saved/restored
// here so the caller keeps no save/restore idiom of its own.
fn tc_trait_contract_tid_check(trait_tid: Int, impl_ann: Int, impl_recv_tid: Int, tmsig_idx: Int, im: Int) -> TraitContractTidResult ! TypeCheck.Resolve, Diag.Report {
    if tc_tid_is_no_info(trait_tid) != 0 { return TraitContractTidResult { verdict: -1, actual: TYPE_UNKNOWN, expected: TYPE_UNKNOWN } }
    // A param the impl leaves unannotated — `self`, or any param written bare — has no
    // written type to compare. Reporting it against the trait's type names `?`, which is
    // not a type anyone can write, and asks the author to repair a correct impl.
    if impl_ann == -1 { return TraitContractTidResult { verdict: -1, actual: TYPE_UNKNOWN, expected: TYPE_UNKNOWN } }
    let saved_suppress = tc_suppress_ann_validation
    tc_suppress_ann_validation = 1
    let mut self_binds: Map[Str, Int] = Map()
    self_binds.insert("Self", impl_recv_tid)
    self_binds.insert(tc_binder_key(SELF_BINDER_NODE, "Self"), impl_recv_tid)
    let actual = substitute_typevar_tid(resolve_type_ann(impl_ann), self_binds)
    tc_suppress_ann_validation = saved_suppress
    tc_trait_contract_tid_check_actual(trait_tid, actual, impl_recv_tid, tmsig_idx, im)
}

// Same contract compare, but the impl-side tid is supplied already resolved. The
// return check uses this to spell an OMITTED return arrow as Void (the ret_ann == -1
// => TYPE_VOID rule): resolving the -1 node would yield UNKNOWN and skip the check,
// silently satisfying a trait that requires a real return.
fn tc_trait_contract_tid_check_actual(trait_tid: Int, actual: Int, impl_recv_tid: Int, tmsig_idx: Int, im: Int) -> TraitContractTidResult ! TypeCheck.Resolve, Diag.Report {
    if tc_tid_is_no_info(trait_tid) != 0 { return TraitContractTidResult { verdict: -1, actual: actual, expected: TYPE_UNKNOWN } }
    let saved_suppress = tc_suppress_ann_validation
    tc_suppress_ann_validation = 1
    let expected = subst_trait_type_tid(trait_tid, impl_recv_tid, tmsig_idx, im)
    tc_suppress_ann_validation = saved_suppress
    if tc_tid_is_no_info(expected) != 0 || tc_tid_is_no_info(actual) != 0 {
        return TraitContractTidResult { verdict: -1, actual: actual, expected: expected }
    }
    let v = if tc_tid_same_type(actual, expected) { 0 } else { 1 }
    TraitContractTidResult { verdict: v, actual: actual, expected: expected }
}

// True when `name` is declared as a binder in the impl's `impl[T, ...]` list.
fn impl_binder_declared(binders_sl: Int, name: Str) -> Int {
    if binders_sl == -1 { return 0 }
    let mut i = 0
    while i < sublist_length(binders_sl) {
        if node_name(sublist_get(binders_sl, i)) == name {
            return 1
        }
        i = i + 1
    }
    0
}

// True when `name` appears anywhere inside a type annotation tree
// (the annotation's own name, its element args, or a fn return ann).
fn type_ann_mentions(ann: Int, name: Str) -> Int {
    if ann == -1 { return 0 }
    if node_name(ann) == name { return 1 }
    let elems = node_elements(ann)
    if elems != -1 {
        let mut i = 0
        while i < sublist_length(elems) {
            if type_ann_mentions(sublist_get(elems, i), name) != 0 {
                return 1
            }
            i = i + 1
        }
    }
    let ret_ann = node_type_ann(ann)
    if ret_ann != -1 {
        if type_ann_mentions(ret_ann, name) != 0 { return 1 }
    }
    0
}

// True when `name` is mentioned by any type annotation in `args_sl`.
fn type_args_mention(args_sl: Int, name: Str) -> Int {
    if args_sl == -1 { return 0 }
    let mut i = 0
    while i < sublist_length(args_sl) {
        if type_ann_mentions(sublist_get(args_sl, i), name) != 0 {
            return 1
        }
        i = i + 1
    }
    0
}

// Report E0507-style unknown-name errors for each type argument in `args_sl`
// that is neither a declared impl binder, a known type, nor a trait name.
// `where` distinguishes the trait-args site from the receiver-args site.
fn check_impl_type_arg_names(args_sl: Int, binders_sl: Int, trait_name: Str, where: Str, im: Int) ! Diag.Report {
    if args_sl == -1 { return }
    let mut i = 0
    while i < sublist_length(args_sl) {
        let arg_name = node_name(sublist_get(args_sl, i))
        let unbound = impl_binder_declared(binders_sl, arg_name) == 0
        let reserved = if unbound { tc_report_reserved_unbuilt(arg_name, im) } else { 0 }
        if reserved == 0 && arg_name != "" && unbound && is_known_type(arg_name) == 0 && is_trait_name(arg_name) == 0 {
            if where == "receiver" {
                diag_error_at("UnknownType", UNKNOWN_TYPE, "unknown type `{arg_name}` in receiver of impl `{trait_name}`", im, "receiver type arguments must be concrete types or names declared in `impl[...]` binders")
            } else {
                diag_error_at("UnknownType", UNKNOWN_TYPE, "unknown type `{arg_name}` in impl `{trait_name}`", im, "trait type arguments must be concrete types; for a polymorphic impl write `impl[{arg_name}] {trait_name}[{arg_name}] for ReceiverType[{arg_name}]`")
            }
        }
        i = i + 1
    }
}

fn validate_trait_impls(program: Int) ! TypeCheck.Register, TypeCheck.Resolve, Diag.Report {
    let saved_module = nr_current_module
    validate_trait_impls_in_own_modules(program)
    nr_current_module = saved_module
}

// Each impl is checked in its own module, where its type names mean what that module declares.
fn validate_trait_impls_in_own_modules(program: Int) ! TypeCheck.Register, TypeCheck.Resolve, Diag.Report {
    let impls_sl = node_methods(program)
    if impls_sl == -1 { return }
    let mut ii = 0
    while ii < sublist_length(impls_sl) {
        let im = sublist_get(impls_sl, ii)
        nr_current_module = node_module(im)
        let trait_name = tc_impl_trait_id(im)
        let impl_type = tc_impl_target_name(im)
        tc_record_impl_recv_tid(im)
        if is_trait_name(trait_name) == 0 {
            if is_sealed_builtin_type(trait_name) != 0 && is_user_sourced(im) != 0 {
                diag_error_at("TraitContract", TRAIT_CONTRACT_907, "`{tc_trait_shown(trait_name)}` is a sealed built-in type and cannot be implemented for user types", im, "`{tc_trait_shown(trait_name)}` is a closed built-in; define your own trait with the methods you need and impl that instead")
                ii = ii + 1
                continue
            }
            diag_error_at("TraitContract", TRAIT_CONTRACT_904, "trait `{tc_trait_shown(trait_name)}` is not defined", im, "check the trait name or define `trait {tc_trait_shown(trait_name)} \{ ... }`")
            ii = ii + 1
            continue
        }
        if is_sealed_builtin_trait(trait_name) != 0 && is_user_sourced(im) != 0 {
            diag_error_at("TraitContract", TRAIT_CONTRACT_907, "trait `{tc_trait_shown(trait_name)}` is a sealed built-in trait and cannot be implemented for user types", im, "define your own trait with the methods you need and impl that instead")
            ii = ii + 1
            continue
        }
        // A trait its module declares twice (E1016) may have meant either declaration's contract.
        if tc_trait_key_poisoned(trait_name) {
            ii = ii + 1
            continue
        }
        let binders_sl = node_impl_binders(im)
        let recv_args_sl = node_recv_type_args(im)
        let trait_args_sl = node_type_params(im)
        // A binder declared after `impl` must appear somewhere in the header's
        // type positions (trait args or receiver args); otherwise nothing can
        // ever determine what it stands for.
        if binders_sl != -1 {
            let mut bi = 0
            while bi < sublist_length(binders_sl) {
                let bname = node_name(sublist_get(binders_sl, bi))
                let mut used = type_args_mention(trait_args_sl, bname)
                if used == 0 { used = type_args_mention(recv_args_sl, bname) }
                if used == 0 {
                    diag_error_at("ImplBinderUnused", IMPL_BINDER_UNUSED, "impl binder `{bname}` is not used in the impl header", im, "use `{bname}` in the trait's or the receiver's type arguments, or remove the binder")
                }
                bi = bi + 1
            }
        }
        // Unknown outer names in trait_type_args would otherwise slip past the
        // single-letter carve-out in nr_check_type_ref and silently lower to
        // `void` in codegen. Names declared as impl binders are bound (§3.6)
        // and excluded.
        check_impl_type_arg_names(trait_args_sl, binders_sl, trait_name, "trait", im)
        check_impl_type_arg_names(recv_args_sl, binders_sl, trait_name, "receiver", im)
        // The impl-header RECEIVER is a type position (spec §3.4): a bare
        // `impl Show for Box` on a generic `Box[T]` is error[TypeArgArity] just
        // as a bare `Box` param would be. The receiver is resolved through
        // tc_record_impl_recv_tid with annotation validation suppressed, so its arity
        // is checked here rather than in resolve_type_parts.
        tc_push_tparam_scope(binders_sl)
        // The written name, so an aliased compiler-known receiver takes the builtin's arity.
        let recv_want = tc_ctor_arity(node_name(im))
        if recv_want != -1 {
            let recv_got = if recv_args_sl == -1 { 0 } else { sublist_length(recv_args_sl) }
            if recv_got != recv_want {
                let recv_decl = tc_impl_owner_decl(im)
                let recv_subjects: List[Int] = if recv_decl < 0 { [] } else { [tc_decl_tid(recv_decl)] }
                tc_error_naming_types("TypeArgArity", TYPE_ARG_ARITY, "type constructor `{impl_type}` takes {recv_want} type argument(s) but {recv_got} were given in the impl receiver", im, tc_arity_help(impl_type, recv_want, recv_got), recv_subjects)
            }
        }
        tc_pop_tparam_scope(binders_sl)
        // Polymorphic impl headers parse (spec §3.6). The impl binders make `T`
        // a free type var that the contract check below resolves positionally
        // (Self == receiver base, trait tparam name == binder name), so the
        // method-contract / Display / assoc-type checks run for poly impls too.
        // Codegen monomorphization of a polymorphic impl is not yet supported; the
        // E0908 gate is emitted after those checks (so a malformed poly impl reports
        // both its specific contract error and E0908) to block codegen.
        let is_poly = if binders_sl != -1 || recv_args_sl != -1 { 1 } else { 0 }
        // Two supported canonical builtin forms:
        //  1. `impl[T] Trait[T] for List[T]` — monomorphized per element T in
        //     codegen (or, when element-agnostic, routed to the single-symbol
        //     eager path). Codegen assumes the single binder is List's element.
        //  2. Element-agnostic `impl[T] Trait[T] for Set[T]` and
        //     `impl[K,V] Trait[K,V] for Map[K,V]` — these lower to ONE symbol
        //     shared by every element type (byte-identical to a bare
        //     `impl for Set`/`impl for Map`), so they route to the same eager
        //     path. A TYPE-DEPENDENT Set/Map poly impl (a binder in a method
        //     signature) would need per-element monomorphization that is not
        //     built yet, so it must still trip E0908.
        //  3. A user generic struct or enum whose receiver arguments are the
        //     binders in order (`impl[T] X for Box[T]`, `impl[A, B] X for
        //     Pair[A, B]`): monomorphized per receiver instance.
        //  4. A From or TryFrom impl over a declared type (tc_impl_is_poly_conversion):
        //     monomorphized per call, from the source the call converts.
        // Any other shape stays unsupported: multi-binder List impls (mis-map
        // both binders to the element), binders without a receiver type-arg
        // (Holder), receiver args without binders (Box[Int]), concrete
        // `List[Int]`, a nested binder (Box[List[T]]) and a repeated one.
        // tc_impl_is_poly_conversion reads the source from the cache, which only the fnsig
        // loop has filled so far, and only for an impl that writes a method.
        if tc_is_conversion_trait(tc_impl_trait_id(im)) { let _ = tc_impl_conv_source_tid(im) }
        let mut poly_supported = if tc_impl_is_poly_user(im) || tc_impl_is_poly_conversion(im) { 1 } else { 0 }
        if binders_sl != -1 && recv_args_sl != -1 {
            let nb = sublist_length(binders_sl)
            let nr = sublist_length(recv_args_sl)
            if impl_type == "List" && nb == 1 && nr == 1 {
                let binder_name = node_name(sublist_get(binders_sl, 0))
                if binder_name != "" && node_name(sublist_get(recv_args_sl, 0)) == binder_name {
                    poly_supported = 1
                }
            }
            if poly_supported == 0 && impl_is_element_agnostic(im) != 0 {
                if impl_type == "Set" && nb == 1 && nr == 1 {
                    let sb = node_name(sublist_get(binders_sl, 0))
                    if sb != "" && node_name(sublist_get(recv_args_sl, 0)) == sb {
                        poly_supported = 1
                    }
                }
                if impl_type == "Map" && nb == 2 && nr == 2 {
                    let k0 = node_name(sublist_get(binders_sl, 0))
                    let v0 = node_name(sublist_get(binders_sl, 1))
                    if k0 != "" && v0 != "" && node_name(sublist_get(recv_args_sl, 0)) == k0 && node_name(sublist_get(recv_args_sl, 1)) == v0 {
                        poly_supported = 1
                    }
                }
            }
        }
        // A wrong trait-arg count would leave a trait tparam unbound, so
        // subst_trait_type_tid below leaves it a bare typevar and the per-param
        // check compares against an unresolved type. Report a dedicated arity
        // error instead and skip the per-param comparison (trait_arg_arity_ok)
        // so no unbound tparam leaks.
        // The count comes from the trait DECLARATION (register_trait records
        // node_type_params by name), not from tc_tmsig_pool, because a
        // methodless trait has no sig entry to scan.
        let trait_tparam_count = tc_trait_tparam_count_idx.get(trait_name) ?? -1
        let mut supplied_trait_args = 0
        if trait_args_sl != -1 {
            supplied_trait_args = sublist_length(trait_args_sl)
        }
        let mut trait_arg_arity_ok = 1
        if trait_tparam_count >= 0 && supplied_trait_args != trait_tparam_count {
            trait_arg_arity_ok = 0
            diag_error_at("TraitContract", TRAIT_ARG_ARITY, "impl of trait `{tc_trait_shown(trait_name)}` supplies {supplied_trait_args} type argument(s) but `{tc_trait_shown(trait_name)}` declares {trait_tparam_count}", im, "supply one type argument per trait type parameter: `impl {tc_trait_shown(trait_name)}[...] for {impl_type}`")
        }
        // Display.display and Eq.ne are synthesized sealed methods: the compiler derives
        // them from the impl's `fmt` and `eq`, so a user impl may not define them. The
        // remaining contract checks below still run (a missing `fmt` also reports E0900).
        if trait_name == "Display" || trait_name == "Eq" {
            let sealed = if trait_name == "Display" { "display" } else { "ne" }
            let source = if trait_name == "Display" { "fmt" } else { "eq" }
            let sealed_methods_sl = node_methods(im)
            if sealed_methods_sl != -1 {
                let mut dmi = 0
                while dmi < sublist_length(sealed_methods_sl) {
                    let dm = sublist_get(sealed_methods_sl, dmi)
                    if node_name(dm) == sealed {
                        diag_error_at("SealedMethodOverride", SEALED_METHOD_OVERRIDE, "method `{sealed}` of trait `{tc_trait_shown(trait_name)}` is sealed and cannot be overridden — it is synthesized from `{source}`", dm, "implement `{source}` and remove `{sealed}`; `{sealed}()` is generated from `{source}`")
                    }
                    dmi = dmi + 1
                }
            }
        }
        // Check each trait method signature against this impl
        let impl_methods_sl = node_methods(im)
        // Deep (tid) contract audit runs alongside the string compare below: the
        // impl's own binders are in scope for its receiver + method signatures.
        // Validation suppression for the re-resolutions lives inside
        // tc_trait_contract_tid_check, so this function keeps no save/restore
        // idiom of its own.
        tc_push_tparam_scope(binders_sl)
        let impl_recv_tid = tc_impl_recv_tid(im)
        let mut si = 0
        while si < tc_tmsig_pool.len() {
            let tmsig = tc_tmsig_pool.get(si).unwrap()
            if tmsig.trait_name == trait_name {
                let expected_method = tmsig.method
                let mut found = 0
                let mut mi = 0
                if impl_methods_sl != -1 {
                    while mi < sublist_length(impl_methods_sl) {
                        let impl_m = sublist_get(impl_methods_sl, mi)
                        if node_name(impl_m) == expected_method {
                            found = 1
                            // Check arity
                            let trait_pcount = tmsig.params_count
                            let impl_params_sl = node_params(impl_m)
                            let mut impl_pcount = 0
                            if impl_params_sl != -1 {
                                impl_pcount = sublist_length(impl_params_sl)
                            }
                            if trait_pcount != impl_pcount {
                                diag_error_at("TraitContract", TRAIT_CONTRACT_901, "method `{expected_method}` in impl {tc_trait_shown(trait_name)} for {impl_type} has {impl_pcount} params, expected {trait_pcount}", impl_m, "trait requires {trait_pcount} parameters (including self)")
                            } else if trait_arg_arity_ok != 0 {
                                // Skipped when the impl's trait-arg arity is
                                // wrong (E0910 already reported): subst_trait_type_tid
                                // would otherwise leave an unbound trait tparam
                                // typevar in the expected type.
                                // Check param types
                                let tp_start = tmsig.params_start
                                let mut pi = 0
                                while pi < trait_pcount {
                                    let trait_ptid = tc_tmsig_param_tids.get(tp_start + pi).unwrap()
                                    if tc_tid_is_no_info(trait_ptid) == 0 {
                                        let impl_p = sublist_get(impl_params_sl, pi)
                                        let r = tc_trait_contract_tid_check(trait_ptid, node_type_ann(impl_p), impl_recv_tid, si, im)
                                        if r.verdict == 1 && (tc_trait_sig_poisoned.get(trait_name) ?? 0) == 0 {
                                            let a_s = type_to_str(r.actual)
                                            let e_s = type_to_str(r.expected)
                                            let a_q = if a_s == e_s { tc_type_origin_qualifier(r.actual) } else { "" }
                                            let e_q = if a_s == e_s { tc_type_origin_qualifier(r.expected) } else { "" }
                                            diag_error_at("TraitContract", TRAIT_CONTRACT_902, "method `{expected_method}` param has type `{a_s}`{a_q}, expected `{e_s}`{e_q}", impl_p, "change type to `{e_s}`{e_q} to match trait {tc_trait_shown(trait_name)}")
                                        }
                                    }
                                    pi = pi + 1
                                }
                                // Check return type. An omitted arrow means the method
                                // returns Void (ret_ann == -1 => TYPE_VOID), which must
                                // still be compared: dropping to UNKNOWN would let a
                                // Void impl silently satisfy a non-Void trait return.
                                if tc_tid_is_no_info(tmsig.ret_tid) == 0 {
                                    let impl_ret_ann = node_type_ann(impl_m)
                                    let r = if impl_ret_ann == -1 {
                                        tc_trait_contract_tid_check_actual(tmsig.ret_tid, TYPE_VOID, impl_recv_tid, si, im)
                                    } else {
                                        tc_trait_contract_tid_check(tmsig.ret_tid, impl_ret_ann, impl_recv_tid, si, im)
                                    }
                                    if r.verdict == 1 && (tc_trait_sig_poisoned.get(trait_name) ?? 0) == 0 {
                                        // Void is not a return type a user may write, so the
                                        // repair for a trait method declared without an arrow
                                        // is to drop the impl's arrow, not to spell Void out.
                                        let ra_s = type_to_str(r.actual)
                                        let re_s = type_to_str(r.expected)
                                        let ra_q = if ra_s == re_s { tc_type_origin_qualifier(r.actual) } else { "" }
                                        let re_q = if ra_s == re_s { tc_type_origin_qualifier(r.expected) } else { "" }
                                        let want = if r.expected == TYPE_VOID { "no return value" } else { "`{re_s}`{re_q}" }
                                        let fix = if r.expected == TYPE_VOID {
                                            "remove the return type — trait {tc_trait_shown(trait_name)} declares `{expected_method}` with no return"
                                        } else {
                                            "change return type to `{re_s}`{re_q} to match trait {tc_trait_shown(trait_name)}"
                                        }
                                        diag_error_at("TraitContract", TRAIT_CONTRACT_903, "method `{expected_method}` returns `{ra_s}`{ra_q}, expected {want}", impl_m, fix)
                                    }
                                }
                            }
                            break
                        }
                        mi = mi + 1
                    }
                }
                if found == 0 {
                    diag_error_at("TraitContract", TRAIT_CONTRACT_900, "impl {tc_trait_shown(trait_name)} for {impl_type} is missing method `{expected_method}`", im, "add `fn {expected_method}(...)` to the impl block")
                }
            }
            si = si + 1
        }
        tc_pop_tparam_scope(binders_sl)
        // E0911: an impl of a subtrait must satisfy every supertrait (transitively)
        // for the receiver. This is the soundness basis of the E0305 Self-licensing
        // rule — a default body may call a supertrait method on `Self` only because
        // every implementor is guaranteed to provide it. Only user-sourced impls are
        // checked; the stdlib is trusted.
        if is_user_sourced(im) != 0 {
            let supers = tc_trait_direct_supers(trait_name)
            let mut seg_start = 0
            let mut ci = 0
            while ci <= supers.byte_len() {
                if ci == supers.byte_len() || supers.byte_at(ci) == 124 {
                    if ci > seg_start {
                        let sname = supers.byte_slice(seg_start, ci)
                        if tc_type_satisfies_trait(impl_type, sname, impls_sl) == 0 {
                            let fix = if is_arith_trait_name(sname) != 0 {
                                "{tc_trait_shown(sname)} is a sealed arithmetic trait — only built-in numeric types implement it, so no user type can satisfy `{tc_trait_shown(trait_name)}: {tc_trait_shown(sname)}`; implement `{tc_trait_shown(trait_name)}` only for a numeric type, or drop the `: {tc_trait_shown(sname)}` supertrait if `{tc_trait_shown(trait_name)}` does not need it"
                            } else if tc_is_derivable_trait(sname) != 0 {
                                "derive it: `@derive({tc_trait_shown(sname)})` on `{impl_type}`, or write `impl {tc_trait_shown(sname)} for {impl_type}`"
                            } else {
                                "add `impl {tc_trait_shown(sname)} for {impl_type}`"
                            }
                            diag_error_at("MissingSupertraitImpl", MISSING_SUPERTRAIT_IMPL, "impl {tc_trait_shown(trait_name)} for {impl_type} requires {impl_type} to also implement supertrait `{tc_trait_shown(sname)}` (trait {tc_trait_shown(trait_name)}: {tc_trait_shown(sname)})", im, fix)
                        }
                    }
                    seg_start = ci + 1
                }
                ci = ci + 1
            }
        }
        let impl_assoc_sl = node_assoc_types(im)
        let mut ati = 0
        while ati < tc_trait_assoc_names.len() {
            let full_name = tc_trait_assoc_names.get(ati).unwrap()
            if full_name.starts_with("{trait_name}.") {
                let expected_assoc = full_name.byte_slice(trait_name.byte_len() + 1, full_name.byte_len())
                let mut found_assoc = 0
                if impl_assoc_sl != -1 {
                    let mut aj = 0
                    while aj < sublist_length(impl_assoc_sl) {
                        let at_node = sublist_get(impl_assoc_sl, aj)
                        if node_name(at_node) == expected_assoc {
                            found_assoc = 1
                            break
                        }
                        aj = aj + 1
                    }
                }
                if found_assoc == 0 {
                    diag_error_at("TraitContract", TRAIT_CONTRACT_905, "impl {tc_trait_shown(trait_name)} for {impl_type} is missing associated type `{expected_assoc}`", im, "add `type {expected_assoc} = ...` to the impl block")
                }
            }
            ati = ati + 1
        }
        if is_poly != 0 && poly_supported == 0 {
            diag_error_at("PolyImplUnsupported", POLY_IMPL_UNSUPPORTED, "polymorphic impls are not yet compiled", im, "spec §3.6 defines `impl[T] {tc_trait_shown(trait_name)}[T] for Recv[T]`, but compiled support is still in progress; write a separate impl per concrete type for now")
        }
        ii = ii + 1
    }
    tc_check_impl_overlap(impls_sl)
}

// The trait a pair of impls must share before either could answer for the other's
// receiver: its name and how many arguments it takes. The arguments themselves are part
// of the head, which tc_impls_overlap unifies, so From[List[Int]] and From[List[Str]]
// are compared rather than keyed apart or together by their spelling.
fn tc_impl_trait_key(im: Int) -> Str {
    let args = node_type_params(im)
    let n = if args == -1 { 0 } else { sublist_length(args) }
    "{tc_impl_trait_id(im)}/{n}"
}

// The types an impl's trait arguments name, resolved under its own binders so that
// `impl[T] From[List[T]]` reads its own T. Validation is off, as the header was checked.
@allow(UnrestoredMutation)
fn tc_impl_trait_arg_tids(im: Int) -> List[Int] ! TypeCheck.Resolve, Diag.Report {
    let mut out: List[Int] = []
    let args = node_type_params(im)
    if args == -1 { return out }
    let binders_sl = node_impl_binders(im)
    tc_push_tparam_scope(binders_sl)
    let saved_suppress = tc_suppress_ann_validation
    tc_suppress_ann_validation = 1
    let mut i = 0
    while i < sublist_length(args) {
        out.push(resolve_type_ann(sublist_get(args, i)))
        i = i + 1
    }
    tc_suppress_ann_validation = saved_suppress
    tc_pop_tparam_scope(binders_sl)
    out
}

// An impl's head: its receiver, then each trait argument. Empty for a header with no
// receiver, which answers for no type.
fn tc_impl_head(im: Int) -> List[Int] ! TypeCheck.Resolve, Diag.Report {
    let mut head: List[Int] = []
    let recv = tc_impl_recv_tid(im)
    if recv < 0 { return head }
    head.push(recv)
    for t in tc_impl_trait_arg_tids(im) { head.push(t) }
    head
}

// A fresh metavariable for each of the impl's binders, keyed as substitute_typevar_tid
// looks them up. Fresh per comparison, so the two impls of a pair never share a variable
// even when both spell their binder `T`, and a binding made for one pair is never read
// by another.
fn tc_impl_fresh_binders(im: Int) -> Map[Str, Int] {
    let mut fresh: Map[Str, Int] = Map()
    let binders = node_impl_binders(im)
    if binders == -1 { return fresh }
    let mut i = 0
    while i < sublist_length(binders) {
        let tp = sublist_get(binders, i)
        fresh.insert(tc_binder_key(tp, node_name(tp)), make_metavar())
        i = i + 1
    }
    fresh
}

// The heads are read from impl headers, which hold no inference variable. One that does
// would take a binding from this comparison and carry it out, so it is a compiler defect.
fn tc_impl_head_is_closed(im: Int, head: List[Int]) -> Bool ! Diag.Report {
    for t in head {
        if tc_tid_has_unbound_metavar(t) != 0 {
            diag_ice_at("ImplHeadCarriesMetavar", UNSOLVED_TYPEVAR_AT_CODEGEN,
                "the head of impl {im} carries an inference variable", im,
                "an impl header resolves to types and its own binders only; this is a compiler defect, not a program error")
            return false
        }
    }
    true
}

// Does one of the impl's bounds definitely fail for what unification bound its binders
// to? Only a definite no rules the pair out. A binder left unbound could still take a
// type that meets every bound on both sides, and a bound tc_bound_fact can not
// decide might hold, so both keep the overlap: the spec rejects impls that COULD both
// match.
fn tc_impl_bounds_rule_out(im: Int, fresh: Map[Str, Int]) -> Bool {
    let binders = node_impl_binders(im)
    if binders == -1 { return false }
    let wb = node_impl_where_bounds(im)
    let mut i = 0
    while i < sublist_length(binders) {
        let tp = sublist_get(binders, i)
        let name = node_name(tp)
        let bound_to = tc_resolve(fresh.get(tc_binder_key(tp, name)) ?? -1)
        if bound_to >= 0 && tc_is_unbound_metavar(bound_to) == 0 {
            let mut traits: List[Str] = []
            let inline = node_elements(tp)
            let mut j = 0
            while inline != -1 && j < sublist_length(inline) {
                traits.push(tc_bound_trait(sublist_get(inline, j)))
                j = j + 1
            }
            let mut w = 0
            while wb != -1 && w < sublist_length(wb) {
                let cons = sublist_get(wb, w)
                let bounds = node_elements(cons)
                let mut k = 0
                while node_name(cons) == name && bounds != -1 && k < sublist_length(bounds) {
                    traits.push(tc_bound_trait(sublist_get(bounds, k)))
                    k = k + 1
                }
                w = w + 1
            }
            for tr in traits {
                if tc_bound_fact(bound_to, tr) == -1 { return true }
            }
        }
        i = i + 1
    }
    false
}

// Could both impls match one type (sections/03_types.md "No Impl Overlap")? They can
// exactly when their heads unify once each impl's binders are renamed apart, and no
// bound definitely fails for what the binders were bound to. So `impl[T] From[(T, T)]`
// stays apart from `impl From[(Int, Str)]`, and `impl[T] R for List[T] where T: Display`
// meets `impl R for List[Int]` because Int is Display.
fn tc_impls_overlap(a: Int, b: Int) -> Int ! TypeCheck.Resolve, Diag.Report {
    let ha = tc_impl_head(a)
    let hb = tc_impl_head(b)
    if ha.len() == 0 || ha.len() != hb.len() { return 0 }
    if !tc_impl_head_is_closed(a, ha) || !tc_impl_head_is_closed(b, hb) { return 0 }
    let fa = tc_impl_fresh_binders(a)
    let fb = tc_impl_fresh_binders(b)
    let mut i = 0
    while i < ha.len() {
        let ta = substitute_typevar_tid(ha.get(i).unwrap(), fa)
        let tb = substitute_typevar_tid(hb.get(i).unwrap(), fb)
        if tc_unify(ta, tb) == 0 { return 0 }
        i = i + 1
    }
    if tc_impl_bounds_rule_out(a, fa) || tc_impl_bounds_rule_out(b, fb) { return 0 }
    1
}

// Could a From impl convert its receiver to itself? Every type has the reflexive impl
// (sections/03c_protocols.md), so one that could is a second impl for that pair, and the
// call would silently take the identity instead of the body written for it.
fn tc_impl_overlaps_identity(im: Int) -> Bool ! TypeCheck.Resolve, Diag.Report {
    if tc_impl_trait_id(im) != "From" { return false }
    let head = tc_impl_head(im)
    if head.len() != 2 || !tc_impl_head_is_closed(im, head) { return false }
    let fresh = tc_impl_fresh_binders(im)
    if tc_unify(substitute_typevar_tid(head.get(0).unwrap(), fresh), substitute_typevar_tid(head.get(1).unwrap(), fresh)) == 0 { return false }
    !tc_impl_bounds_rule_out(im, fresh)
}

// sections/03_types.md "No Impl Overlap": if two impls could both match a given type the
// compiler rejects the program, because there is no specialization to choose between them.
// Reported on the later impl, which is the one the author can delete.
fn tc_check_impl_overlap(impls_sl: Int) ! TypeCheck.Resolve, Diag.Report {
    let n = sublist_length(impls_sl)
    let mut i = 0
    while i < n {
        let later = sublist_get(impls_sl, i)
        if tc_impl_overlaps_identity(later) {
            diag_error_at("OverlappingImpls", OVERLAPPING_IMPLS, "impl of `From` for `{tc_impl_target_name(later)}` overlaps the compiler-provided `impl From[T] for T`; Blink does not support specialization", later, "a type already converts to itself; narrow the source so it can never be the receiver")
        } else if is_trait_name(tc_impl_trait_id(later)) != 0 {
            let key = tc_impl_trait_key(later)
            let mut j = 0
            while j < i {
                let earlier = sublist_get(impls_sl, j)
                if tc_impl_trait_key(earlier) == key {
                    if tc_impls_overlap(earlier, later) != 0 {
                        let what = tc_impl_target_name(later)
                        let help = if impl_provided_by_closeable(earlier) || impl_provided_by_closeable(later) {
                            "`Closeable` already provides `BlockHandler` for `{what}`; remove one of the two impls"
                        } else {
                            "keep one impl, or wrap one receiver in a newtype so the two impls answer for types that share no instance"
                        }
                        diag_error_at("OverlappingImpls", OVERLAPPING_IMPLS, "impl of `{node_trait_name(later)}` for `{what}` overlaps an earlier impl; Blink does not support specialization", later, help)
                        break
                    }
                }
                j = j + 1
            }
        }
        i = i + 1
    }
}

// The parser writes a BlockHandler impl for each impl whose header may name Closeable
// (§4.7.2), before any name resolves. One stays when its impl names the core Closeable over a
// declared receiver and is the first such impl of that receiver. The rest leave the program,
// so no later pass sees an impl the source does not give, and an error in the impl itself is
// reported once, on the impl the author wrote.
fn tc_drop_unprovided_closeable_impls(program: Int) {
    let impls_sl = node_methods(program)
    if impls_sl == -1 { return }
    let mut drop: Set[Int] = Set()
    let mut receivers: Set[Str] = Set()
    let mut i = 0
    while i < sublist_length(impls_sl) {
        let im = sublist_get(impls_sl, i)
        if impl_provided_by_closeable(im) {
            let src = closeable_impl_of(im)
            let recv = tc_impl_target_name(src)
            let declared = is_known_type(node_name(src)) != 0 || lookup_named_type(recv) != -1
            if tc_impl_trait_id(src) != "Closeable" || !declared || receivers.contains(recv) {
                drop.insert(im)
            } else {
                receivers.insert(recv)
            }
        }
        i = i + 1
    }
    sublist_remove_members(impls_sl, drop)
}

// ── Main entry point ────────────────────────────────────────────────

fn init_types() ! TypeCheck.Register {
    ty_pool.clear()
    tc_ptr_bearing_memo.clear()
    tc_arg_binds_free.clear()
    ty_param_list.clear()
    // The unresolved-method handoff spans all three phases of one check_types, so it is
    // cleared here rather than in resolve_names with the registries that feed it.
    nr_unresolved_method_nodes = []
    tc_unresolved_method_hard = Map()
    // Load-bearing for the daemon/LSP (long-lived processes, daemon.bl / lsp.bl): a
    // surviving intern map would hand out tids keyed against the PREVIOUS, since-cleared
    // pool on the next check_types() call — out-of-bounds unwrap panic or a silently
    // wrong shared type. The second-check_types-run row of
    // tests/test_typecheck_ty_pool_interns_compounds.bl is the
    // only test shape that can catch a dropped clear here (task test forks per file).
    ty_intern.clear()
    // New lists sized to the pool, so the fill below never regrows them.
    tc_node_tid = List.with_capacity(node_count())
    tc_ret_mint_start = List.with_capacity(node_count())
    tc_mc_obj_value_marks = List.with_capacity(node_count())
    tc_name_position_is_value = List.with_capacity(node_count())
    tc_sealed_ops_call_marks = List.with_capacity(node_count())
    tc_sealed_ops_rewrite_program = -1
    tc_sealed_ops_rewritten.clear()
    let mut nti = 0
    while nti < node_count() {
        tc_node_tid.push(-1)
        tc_ret_mint_start.push(-1)
        tc_mc_obj_value_marks.push(0)
        tc_name_position_is_value.push(0)
        tc_sealed_ops_call_marks.push(0)
        nti = nti + 1
    }
    tc_ret_mint_tids.clear()
    named_type_names.clear()
    named_type_ids.clear()
    named_type_map.clear()
    fs_error_runtime_tid_cache = -1
    tc_type_decl_nodes.clear()
    tc_type_decl_node_by_tid.clear()
    tc_type_decl_ambiguous_names = Map()
    tc_namesake_type_modules = Map()
    tc_impl_recv_tids = Map()
    tc_conv_source_tids = Map()
    tc_poly_user_impls = Map()
    tc_method_block = Map()
    tc_active_tparams.clear()
    tc_hash_oblig = Map()
    tc_bracket_sites.clear()
    tc_type_args_claimed.clear()
    tc_type_args_unresolved.clear()
    tc_type_args_untyped = []
    tc_tp_frames.clear()
    // A diagnostic can stop a walk before it restores these flags.
    tc_walk_value_tail = 0
    tc_pin_tparam_binds = 0
    tc_in_ensures_predicate = 0
    tc_trait_sig_poisoned.clear()
    tc_alias_underlying = Map()
    sfield_pool.clear()
    nr_callable_field_names.clear()
    evar_pool.clear()
    evar_decl_nodes.clear()
    evar_slots_by_name.clear()
    evfield_pool.clear()
    fnsig_pool.clear()
    fnsig_by_decl.clear()
    fnsig_map.clear()
    for mod_name in nr_module_names.keys() {
        nr_module_names_of(mod_name).sigs.clear()
    }
    fnsig_param_list.clear()
    fnsig_param_names.clear()
    fnsig_param_kw.clear()
    fnsig_param_default.clear()
    tc_raw_part_nodes.clear()
    tc_raw_part_interp.clear()
    tc_raw_part_consumed = Map()
    fnsig_type_param_names.clear()
    fnsig_tparam_nodes.clear()
    fnsig_tparam_ret_only.clear()
    fnsig_tparam_sourced.clear()
    fnsig_tparam_bounds.clear()
    fnsig_effect_names.clear()
    tc_trait_names.clear()
    tc_trait_method_names.clear()
    tc_trait_assoc_names.clear()
    tc_display_impl_types.clear()
    tc_display_impl_nodes.clear()
    tc_method_trait_count_idx.clear()
    tc_method_trait_names_idx.clear()
    tc_method_distinct_trait_count_idx.clear()
    tc_method_distinct_trait_names_idx.clear()
    tc_poly_list_impl_node.clear()
    tc_tmsig_pool.clear()
    tc_tmsig_param_tids.clear()
    tc_trait_tparam_names.clear()
    tc_trait_tparam_nodes.clear()
    tc_trait_tparam_count_idx.clear()
    tc_trait_node_idx.clear()
    tc_trait_supers_idx.clear()
    tc_current_fn_ret = -1
    tc_current_fn_name = ""
    tc_with_resource_node = -1
    tc_ffi_scope_binder = ""
    tc_current_fn_node = -1
    tc_current_self_tid = -1
    tc_current_method_sig_key = ""
    tc_closure_scope_base = []
    tc_fn_body_block = 0
    tc_suppress_ann_validation = 0
    tc_boundary_check_active = 0
    tc_ud_pending = []
    tc_ud_blamed.clear()
    tc_call_open_calls = []
    tc_call_open_group.clear()
    tc_call_open_tids = []
    tc_call_reported.clear()
    tc_errors.clear()
    depr_type_nodes.clear()
    tc_struct_decl_nodes.clear()
    tc_collision_reported.clear()
    ffi_struct_type_set.clear()
    ffi_opaque_type_set.clear()
    tc_symbol_module.clear()
    tc_module_let_decl.clear()
    tc_prelude_free_fn.clear()
    tc_used_modules.clear()
    tc_hints.clear()
    tc_pure_fns.clear()
    tc_fn_node_by_name.clear()
    pv_in_old_depth = 0
    pv_rejected_preds.clear()
    tc_ann_alias_decl.clear()
    tc_fn_requires.clear()
    tc_fn_ensures.clear()
    tc_old_calls.clear()
    tc_build_import_map()

    TYPE_INT = new_type(TyKind.Int, "Int")
    TYPE_FLOAT = new_type(TyKind.Float, "Float")
    TYPE_BOOL = new_type(TyKind.Bool, "Bool")
    TYPE_STR = new_type(TyKind.Str, "Str")
    TYPE_VOID = new_type(TyKind.Void, "Void")
    TYPE_UNKNOWN = new_type(TyKind.Unknown, "?")
    TYPE_I8 = new_type(TyKind.I8, "I8")
    TYPE_I16 = new_type(TyKind.I16, "I16")
    TYPE_I32 = new_type(TyKind.I32, "I32")
    TYPE_U8 = new_type(TyKind.U8, "U8")
    TYPE_U16 = new_type(TyKind.U16, "U16")
    TYPE_U32 = new_type(TyKind.U32, "U32")
    TYPE_U64 = new_type(TyKind.U64, "U64")
    TYPE_CHAR = new_type(TyKind.Char, "Char")
    TYPE_NEVER = new_type(TyKind.Never, "Never")
}

// Declarations resolve their annotations in their own module, so a bare namesake reads
// as the declaring module's type. The caller's module comes back after: the module context
// also gates the used-import bookkeeping, which these passes must not touch.
fn tc_register_type_decls(types_sl: Int) ! TypeCheck.Register, TypeCheck.Resolve, Diag.Report {
    let saved_module = nr_current_module
    tc_register_type_decls_in_own_modules(types_sl)
    nr_current_module = saved_module
}

fn tc_register_type_decls_in_own_modules(types_sl: Int) ! TypeCheck.Register, TypeCheck.Resolve, Diag.Report {
    if types_sl == -1 { return }
    tc_collect_namesake_type_names(types_sl)
    let mut i = 0
    while i < sublist_length(types_sl) {
        let td = sublist_get(types_sl, i)
        let td_flds = node_fields(td)
        let mut is_enum = 0
        if td_flds != -1 && sublist_length(td_flds) > 0 {
            if node_kind(sublist_get(td_flds, 0)) == NodeKind.TypeVariant {
                is_enum = 1
            }
        }
        tc_warn_shadowed_type(td)
        if is_enum != 0 {
            register_enum_type(td)
        } else {
            register_struct_type(td)
        }
        i = i + 1
    }
    // Before any annotation resolves, so an alias underlying or a field that applies a
    // generic type already sees which of its parameters must be hashable.
    tc_compute_type_hash_obligations(types_sl)
    // Second pass: resolve each alias's underlying type now that every type
    // name is interned, so a target declared textually after the alias
    // resolves to its real instance tid instead of an orphan typevar.
    let mut j = 0
    while j < sublist_length(types_sl) {
        let atd = sublist_get(types_sl, j)
        let alias_ann = node_value(atd)
        // E0524 rejected the declaration, so the builtin keeps the name.
        if alias_ann != -1 && !tc_type_name_is_undeclarable(node_name(atd)) {
            // The alias's own binders are in scope inside its underlying type, so
            // a binder that shadows a builtin (`type Wrap[List] = List`) is a type
            // variable there, not the constructor (§3.4:1259).
            let alias_tparams = node_type_params(atd)
            nr_current_module = node_module(atd)
            tc_push_tparam_scope(alias_tparams)
            tc_alias_underlying.insert(tc_nominal_type_name(atd), resolve_type_ann(alias_ann))
            tc_pop_tparam_scope(alias_tparams)
        }
        j = j + 1
    }
    // Third pass: resolve enum variant payloads and struct field types.
    // Deferred to here so a payload or field that names an alias
    // (`Wrap(o: MB)`, `items: List[MB]`) peels through a fully-populated
    // tc_alias_underlying regardless of declaration order. An alias node has
    // no fields, so resolve_struct_fields is a no-op for it.
    let mut k = 0
    while k < sublist_length(types_sl) {
        let etd = sublist_get(types_sl, k)
        nr_current_module = node_module(etd)
        let etd_flds = node_fields(etd)
        let mut is_enum = 0
        if etd_flds != -1 && sublist_length(etd_flds) > 0 {
            if node_kind(sublist_get(etd_flds, 0)) == NodeKind.TypeVariant {
                is_enum = 1
            }
        }
        if tc_type_name_is_undeclarable(node_name(etd)) {
            // Rejected by E0524 and never registered.
        } else if is_enum != 0 {
            resolve_enum_variants(etd)
        } else {
            resolve_struct_fields(etd)
        }
        k = k + 1
    }
}

fn tc_register_fn_sigs(fns_sl: Int) ! TypeCheck.Register, TypeCheck.Resolve, Diag.Report {
    let saved_module = nr_current_module
    tc_register_fn_sigs_in_own_modules(fns_sl)
    nr_current_module = saved_module
}

fn tc_register_fn_sigs_in_own_modules(fns_sl: Int) ! TypeCheck.Register, TypeCheck.Resolve, Diag.Report {
    let mut i = 0
    while i < sublist_length(fns_sl) {
        let fn_node = sublist_get(fns_sl, i)
        nr_current_module = node_module(fn_node)
        register_fn_sig(fn_node)
        i = i + 1
    }
}

pub fn check_types(program: Int) -> Int ! TypeCheck, Diag.Report {
    if trace_mode != "" { trace("typecheck", "start") }
    init_types()
    nr_check_duplicate_declarations(program)
    nr_record_program_decls(program)

    // A trait name is read from the first signature on, so every trait is filed under its
    // identity, and every name that refers to one knows its file, before anything registers.
    tc_stamp_trait_ref_modules(program)
    let all_traits_sl = node_arms(program)
    if all_traits_sl != -1 { tc_file_trait_keys(all_traits_sl, tc_prelude_trait_names(all_traits_sl)) }

    // Register all type definitions (structs and enums)
    let types_sl = node_fields(program)
    tc_register_type_decls(types_sl)
    tc_drop_unprovided_closeable_impls(program)

    // Kind A: a struct name equal to an enum variant name is a hard error (E0518).
    // Detected over the whole-program symbol table (catches cross-module collisions).
    tc_check_name_collisions()

    // @derive(Debug) requires every user-type field to also derive Debug.
    tc_check_derive_debug()

    // @derive(Serialize) requires every field's type to be serializable by the
    // generated to_json (spec §3.6.2/§3.6.6 NonDerivableTrait, E1401).
    tc_check_derive_serialize()

    // Register all function signatures
    let fns_sl = node_params(program)
    if fns_sl != -1 {
        tc_register_fn_sigs(fns_sl)
    }

    // Validate FFI annotations and Ptr[T] usage
    if fns_sl != -1 {
        let mut i = 0
        while i < sublist_length(fns_sl) {
            let saved = tc_enter_body_module(sublist_get(fns_sl, i))
            validate_ffi_fn(sublist_get(fns_sl, i))
            validate_verify_fallback(sublist_get(fns_sl, i))
            tc_leave_body_module(saved)
            i = i + 1
        }
    }

    // Build the @pure registry first so the predicate validator can
    // consult it when a contract calls a user helper.
    if fns_sl != -1 {
        tc_register_pure_fns(fns_sl)
    }

    // Validate contract predicates against the SMT-decidable subset.
    // Runs before name resolution so reserved names (`result`, `old`)
    // surface as E1304/E1305 rather than as generic E0506/E0504.
    if fns_sl != -1 {
        let mut i = 0
        while i < sublist_length(fns_sl) {
            let saved = tc_enter_body_module(sublist_get(fns_sl, i))
            pv_validate_fn_contracts(sublist_get(fns_sl, i))
            tc_leave_body_module(saved)
            tc_check_contract_verifiable(sublist_get(fns_sl, i))
            i = i + 1
        }
    }
    let contract_traits_sl = node_arms(program)
    if contract_traits_sl != -1 {
        let mut i = 0
        while i < sublist_length(contract_traits_sl) {
            tc_reject_trait_method_contracts(sublist_get(contract_traits_sl, i))
            i = i + 1
        }
    }
    let contract_impls_sl = node_methods(program)
    if contract_impls_sl != -1 {
        let mut i = 0
        while i < sublist_length(contract_impls_sl) {
            let methods_sl = node_methods(sublist_get(contract_impls_sl, i))
            let mut j = 0
            while methods_sl != -1 && j < sublist_length(methods_sl) {
                validate_verify_fallback(sublist_get(methods_sl, j))
                let saved = tc_enter_body_module(sublist_get(methods_sl, j))
                pv_validate_fn_contracts(sublist_get(methods_sl, j))
                tc_leave_body_module(saved)
                tc_check_contract_verifiable(sublist_get(methods_sl, j))
                j = j + 1
            }
            i = i + 1
        }
    }
    if types_sl != -1 {
        let mut i = 0
        while i < sublist_length(types_sl) {
            let saved = tc_enter_body_module(sublist_get(types_sl, i))
            pv_validate_type_alias(sublist_get(types_sl, i))
            tc_leave_body_module(saved)
            i = i + 1
        }
    }

    tc_check_namesake_import_ambiguity()
    tc_check_renamed_import_conflicts()

    validate_capabilities_budget(program, fns_sl)

    // Build symbol-to-module map for unused import detection
    if types_sl != -1 {
        let mut i = 0
        while i < sublist_length(types_sl) {
            let td = sublist_get(types_sl, i)
            let mod_name = node_module(td)
            if mod_name != "" && mod_name != "__main__" {
                tc_symbol_module.insert(node_name(td), mod_name)
                let td_flds = node_fields(td)
                if td_flds != -1 {
                    let mut j = 0
                    while j < sublist_length(td_flds) {
                        let fld = sublist_get(td_flds, j)
                        if node_kind(fld) == NodeKind.TypeVariant {
                            tc_symbol_module.insert(node_name(fld), mod_name)
                        }
                        j = j + 1
                    }
                }
            }
            i = i + 1
        }
    }
    if fns_sl != -1 {
        let mut i = 0
        while i < sublist_length(fns_sl) {
            let fn_node = sublist_get(fns_sl, i)
            let mod_name = node_module(fn_node)
            if mod_name != "" && mod_name != "__main__" {
                let fn_sym_name = node_name(fn_node)
                tc_symbol_module.insert(fn_sym_name, mod_name)
                // A free function defined in a prelude module is NOT auto-visible
                // (§3.2.3) — record it so a bare call lacking an explicit import
                // is rejected (nr_is_unimported_prelude_free_fn).
                if tc_prelude_modules.contains_key(mod_name) {
                    tc_prelude_free_fn.insert(fn_sym_name, 1)
                }
            }
            i = i + 1
        }
    }
    let lets_sl_sym = node_stmts(program)
    if lets_sl_sym != -1 {
        let mut i = 0
        while i < sublist_length(lets_sl_sym) {
            let l = sublist_get(lets_sl_sym, i)
            let mod_name = node_module(l)
            if mod_name != "" && mod_name != "__main__" {
                tc_symbol_module.insert(node_name(l), mod_name)
            }
            i = i + 1
        }
    }

    // Register traits
    let traits_sl = node_arms(program)
    if traits_sl != -1 {
        let prelude_traits = tc_prelude_trait_names(traits_sl)
        let mut i = 0
        while i < sublist_length(traits_sl) {
            let tr = sublist_get(traits_sl, i)
            let in_prelude = tc_prelude_modules.contains_key(node_module(tr))
            if tc_reject_reserved_decl_name(tr, "trait") {
                i = i + 1
                continue
            }
            if is_sealed_builtin_trait(node_name(tr)) != 0 && is_user_sourced(tr) != 0 {
                diag_error_at("TraitContract", TRAIT_CONTRACT_907, "trait `{node_name(tr)}` is a sealed built-in trait and cannot be redefined", tr, "rename your trait, or define your own trait with the methods you need")
            } else if !in_prelude && (prelude_traits.contains(node_name(tr)) || tc_undeclared_trait_names().contains(node_name(tr))) {
                tc_warn_shadowed_trait(tr)
            } else {
                tc_warn_shadowed_type(tr)
            }
            let saved = tc_enter_body_module(tr)
            register_trait(tr)
            tc_leave_body_module(saved)
            i = i + 1
        }
    }
    // Register builtin trait names (handled specially in codegen, no AST nodes)
    tc_trait_names.push("From")
    tc_trait_names.push("TryFrom")
    tc_trait_names.push("Into")
    // Iterator is NOT a trait: §3c.1:38 makes it a sealed, opaque, non-user-implementable
    // built-in type (constructed by make_iterator_type). IntoIterator stays a trait name —
    // it is the sealed protocol whose built-in impls `.into_iter()` dispatches through.
    tc_trait_names.push("IntoIterator")
    // These builtins are single-tparam (From[T], Into[T], ...); record
    // their arity so E0910 fires for impls that supply the wrong count. From/
    // Into/TryFrom are also declared in lib/std/traits.bl and pass through
    // register_trait -- the Map is keyed by name so last-write-wins agrees (1).
    tc_trait_tparam_count_idx.insert("From", 1)
    tc_trait_tparam_count_idx.insert("TryFrom", 1)
    tc_trait_tparam_count_idx.insert("Into", 1)
    tc_trait_tparam_count_idx.insert("IntoIterator", 1)

    // Register impl method signatures
    let impls_sl = node_methods(program)
    if impls_sl != -1 {
        // A type name in a method signature means what it means in the impl's own module.
        let saved_impl_module = nr_current_module
        let mut i = 0
        while i < sublist_length(impls_sl) {
            let im = sublist_get(impls_sl, i)
            nr_current_module = node_module(im)
            let impl_type = tc_impl_target_name(im)
            let trait_id = tc_impl_trait_id(im)
            // Register the canonical monomorphized poly impl
            // `impl[T] Trait[T] for List[T]` for binder recovery in the
            // MethodCall arm. Same shape gate as validate_trait_impls'
            // poly_supported (typecheck.bl ~3122): List receiver, exactly one
            // impl binder, exactly one receiver type arg, and that arg IS the
            // binder. Any other shape never registers, so the arm falls through.
            if impl_type == "List" {
                let pl_binders = node_impl_binders(im)
                let pl_recv_args = node_recv_type_args(im)
                if pl_binders != -1 && pl_recv_args != -1 {
                    if sublist_length(pl_binders) == 1 && sublist_length(pl_recv_args) == 1 {
                        let pl_binder_name = node_name(sublist_get(pl_binders, 0))
                        let pl_recv_arg_name = node_name(sublist_get(pl_recv_args, 0))
                        if pl_binder_name != "" && pl_recv_arg_name == pl_binder_name {
                            let pl_methods = node_methods(im)
                            if pl_methods != -1 {
                                let mut pmi = 0
                                while pmi < sublist_length(pl_methods) {
                                    let pl_mname = node_name(sublist_get(pl_methods, pmi))
                                    tc_poly_list_impl_node.insert(tc_impl_method_stem("List", trait_id, pl_mname), im)
                                    pmi = pmi + 1
                                }
                            }
                        }
                    }
                }
            }
            // Record Display impls so infer_type can resolve the synthesized
            // display() to Str.
            if trait_id == "Display" {
                tc_display_impl_types.push(impl_type)
                // Record every impl NODE for per-instantiation resolution. A base may
                // carry several disjoint Display impls (§3.6 coherence is per (Trait,
                // TYPE)), so accumulate them all — the resolver tries each in turn.
                match tc_display_impl_nodes.get(impl_type) {
                    Some(lst) => {
                        let mut impls = lst
                        impls.push(im)
                    }
                    None => {
                        let l: List[Int] = [im]
                        tc_display_impl_nodes.insert(impl_type, l)
                    }
                }
                // The synthesized sealed `display()` makes `display` resolvable
                // on this type; record it as a Display-owned method so a foreign
                // trait's `display` registers as a second owner.
                tc_record_method_trait(impl_type, "display", "Display")
            }
            let impl_binders_sl = node_impl_binders(im)
            tc_push_tparam_scope(impl_binders_sl)
            let methods_sl = node_methods(im)
            if methods_sl != -1 {
                let mut j = 0
                while j < sublist_length(methods_sl) {
                    let m = sublist_get(methods_sl, j)
                    let orig_name = node_name(m)
                    // From/TryFrom key each impl apart; all
                    // other impl methods register under the trait-qualified key
                    // so two traits sharing a method name don't overwrite.
                    let mangled = tc_mangle_impl_fnsig(impl_type, trait_id, orig_name, im)
                    tc_record_method_trait(impl_type, orig_name, trait_id)
                    tc_method_block.insert(m, im)
                    node_set_name(m, mangled)
                    register_fn_sig(m)
                    node_set_name(m, orig_name)
                    j = j + 1
                }
            }
            tc_pop_tparam_scope(impl_binders_sl)
            i = i + 1
        }
        nr_current_module = saved_impl_module
    }

    // Validate trait impl contracts
    validate_trait_impls(program)

    // @derive(Hash/Eq/Ord) requires every field's type to implement that trait
    // (spec §3.6.6 NonDerivableTrait, E1401). After the impl registrations, because a
    // field type may implement the trait by hand.
    tc_check_derive_hash_eq_ord()

    // The signatures of the namespace intrinsics codegen emits directly.
    register_ns_intrinsic_sigs()
    register_builtin_fn_sigs()

    // The signatures of the methods @derive synthesizes. AFTER the user fn and
    // impl-method registrations above, so a key a program spells for itself is never taken
    // over — see register_derive_method_sig.
    register_derive_method_sigs(program)

    // Register user-defined effect handle names, and the SIGNATURE of every operation
    // they declare. The handle name alone only suppresses the UnknownMethod
    // warning; without the signatures `db.query(..)` has no return type and its
    // arguments are compared against nothing.
    tc_ue_handles = []
    tc_ue_op_root = Map()
    let effects_decl_sl = node_args(program)
    if effects_decl_sl != -1 {
        let mut ei = 0
        while ei < sublist_length(effects_decl_sl) {
            let ed = sublist_get(effects_decl_sl, ei)
            if tc_reject_reserved_decl_name(ed, "effect") {
                ei = ei + 1
                continue
            }
            tc_warn_shadowed_type(ed)
            let eff_name = node_name(ed)
            register_ue_handle(str_to_lower(eff_name), ed)
            register_ue_op_sigs(ed)
            tc_check_effect_op_names(ed)
            ei = ei + 1
        }
    }

    // Build symbol-to-module map (continued): impls, traits, effects
    if impls_sl != -1 {
        let mut i = 0
        while i < sublist_length(impls_sl) {
            let im = sublist_get(impls_sl, i)
            let mod_name = node_module(im)
            if mod_name != "" && mod_name != "__main__" {
                let impl_type = tc_impl_target_name(im)
                let trait_id = tc_impl_trait_id(im)
                tc_symbol_module.insert(impl_type, mod_name)
                let methods_sl_sym = node_methods(im)
                if methods_sl_sym != -1 {
                    let mut j = 0
                    while j < sublist_length(methods_sl_sym) {
                        let m = sublist_get(methods_sl_sym, j)
                        tc_symbol_module.insert(tc_mangle_impl_fnsig(impl_type, trait_id, node_name(m), im), mod_name)
                        j = j + 1
                    }
                }
            }
            i = i + 1
        }
    }
    if traits_sl != -1 {
        let mut i = 0
        while i < sublist_length(traits_sl) {
            let tr = sublist_get(traits_sl, i)
            let mod_name = node_module(tr)
            if mod_name != "" && mod_name != "__main__" {
                tc_symbol_module.insert(node_name(tr), mod_name)
            }
            i = i + 1
        }
    }
    let effects_sl_sym = node_args(program)
    if effects_sl_sym != -1 {
        let mut i = 0
        while i < sublist_length(effects_sl_sym) {
            let ed = sublist_get(effects_sl_sym, i)
            let mod_name = node_module(ed)
            if mod_name != "" && mod_name != "__main__" {
                tc_symbol_module.insert(node_name(ed), mod_name)
            }
            i = i + 1
        }
    }

    // Remap tc_symbol_module for pub import re-exports
    tc_apply_reexport_remapping()

    // Phase 1: Name resolution
    resolve_names(program)
    nr_warn_unused = 0

    // Enforce @pure body constraints. After name resolution, since a callee is judged by the
    // declaration it reaches, and an import alias or a local decides which one that is.
    if fns_sl != -1 {
        let mut i = 0
        while i < sublist_length(fns_sl) {
            tc_check_pure(sublist_get(fns_sl, i))
            i = i + 1
        }
    }

    // Phase 2: Expression type inference
    tc_infer_program(program)
    tc_flush_index_sites()

    // Phase 3: whatever Phase 1 found unresolvable and Phase 2 did not report on. The
    // receiver's type was never known at the call, so no type can be named as lacking the
    // method — the honest report is the soft one.
    tc_flush_unresolved_method_warnings()

    // Phases 4 and 5: recover the types inference determined but never wrote down, then hold
    // every value node to carrying one.
    tc_stamp_program(program)

    // A `Raw[T]` whose literal no `Template[C]` took. Last, because the coercion that
    // consumes one is a caller, and a caller may be checked after the literal it calls with.
    tc_raw_report_unconsumed()

    if trace_mode != "" { trace("typecheck", "done ({tc_errors.len()} errors)") }
    tc_errors.len()
}

// Report the Phase-1 unresolvable method names that Phase 2 left alone. A receiver whose
// type is a bare typevar or an unresolved metavar at the call has no type to name, so this
// stays a warning; every receiver whose type IS known was already reported as E0505. A call
// Phase 2 resolved to a declaration is skipped too: a free fn `{Type}_{method}` supplies a
// method name that no impl lists, so Phase 1 records it, but the name does resolve.
fn tc_flush_unresolved_method_warnings() ! Diag.Report {
    let mut i = 0
    while i < nr_unresolved_method_nodes.len() {
        let n = nr_unresolved_method_nodes.get(i).unwrap()
        if tc_unresolved_method_hard.contains_key(n) == 0 && tc_call_decl.contains_key(n) == 0 {
            let m = node_method(n)
            diag_warn_at("UnknownMethod", UNKNOWN_METHOD, "method `{m}` resolves to nothing, and the receiver's type is not known here", n, "annotate the receiver so the method can be resolved, or correct the method name")
        }
        i = i + 1
    }
}

// ── User-effect handle name tracking ────────────────────────────────

// An effect handle (the lowercased root effect name) and that root's EffectDecl node.
type UeHandle {
    handle: Str
    decl: Int
}
let mut tc_ue_handles: List[UeHandle] = []

// Effect operation declaration node -> the root effect declaring it. An operation is a
// bodiless FnDef like any other, so this is what tells a call recorded against one apart
// from a call of a function.
let mut tc_ue_op_root: Map[Int, Int] = Map()

fn register_ue_handle(name: Str, ed: Int) {
    tc_ue_handles.push(UeHandle { handle: name, decl: ed })
}

// Register one fnsig per effect operation, keyed `{handle}.{op}` — the same
// key the call site spells, and the same handle (`str_to_lower(effect name)`) both sides
// already agree on. Ops live only under a sub-effect: `parse_effect_decl` (parser.bl:1554)
// demands `effect` for every member of the outer body, so `node_elements(ed)` ->
// `node_methods(child)` is the whole set, exactly the walk codegen makes at
// codegen.bl:750-760 to fill its UeMethod registry.
//
// An op node is a real `NodeKind.FnDef` (`parse_effect_op_sig`, parser.bl:1516) carrying
// params, `return_type` and the whole `type_ann` tree, so `register_fn_sig` types it with
// no special case — which is the point: codegen needs EIGHT flat return fields for the
// same information because `Result[Option[Row], DBError]` is depth 2, and one tid holds it.
//
// The name is swapped for the qualified key and restored, as the impl-method path does at
// tc_infer_program; registering under the bare op name would collide with any free function
// of that name. Annotation validation is suppressed: the op's types are validated where the
// effect is DECLARED, and a consuming module that never selectively imported `Row` must not
// be told about it here (the same reason tc_record_impl_recv_tid suppresses it).
// An effect operation has no body, so the stamp the body path makes at its param and return
// positions never runs over one. Codegen reads an operation's signature through the same
// node-tid channel it reads a function's, so the slots are filled here or the vtable it
// writes has no types in it.
//
// The nodes and the resolution are the ones the body path uses: the PARAM node, the RETURN
// ANNOTATION node, and the structural-instance lift that keeps a generic carrier's type-arg
// slots. Two idioms would let the two paths disagree about what an operation's type is.
//
// A name this unit cannot resolve lowers to a type variable, the same answer the body path
// gets, and codegen refuses a type variable at its own chokepoint. The publish refuses a tid
// that carries no information, so nothing here can turn a missing type into a stand-in.
fn publish_ue_op_tids(op: Int) ! TypeCheck.Resolve, Diag.Report {
    let params_sl = node_params(op)
    if params_sl != -1 {
        let mut i = 0
        while i < sublist_length(params_sl) {
            let p = sublist_get(params_sl, i)
            let ptid = resolve_param_type(p)
            let ann = node_type_ann(p)
            let mut ptid_final = ptid
            if ann != -1 {
                let inst = tc_fnsig_param_instance_tid(ann, ptid)
                if inst != -1 { ptid_final = inst }
            }
            tc_publish_node_tid(p, ptid_final)
            i = i + 1
        }
    }
    let ret_ann = node_type_ann(op)
    if ret_ann != -1 {
        let mut ret_tid = resolve_type_ann(ret_ann)
        let ret_inst = tc_fnsig_param_instance_tid(ret_ann, ret_tid)
        if ret_inst != -1 { ret_tid = ret_inst }
        tc_publish_node_tid(ret_ann, ret_tid)
    }
}

@allow(UnrestoredMutation)
// The operations under one root effect share one dispatch table, so a name repeated
// across its sub-effects has no unique slot to fill.
fn tc_check_effect_op_names(ed: Int) ! Diag.Report {
    let children_sl = node_elements(ed)
    if children_sl == -1 { return }
    let mut seen: Map[Str, Int] = Map()
    let mut ci = 0
    while ci < sublist_length(children_sl) {
        let child = sublist_get(children_sl, ci)
        let ops_sl = node_methods(child)
        if ops_sl != -1 {
            let mut oi = 0
            while oi < sublist_length(ops_sl) {
                let op = sublist_get(ops_sl, oi)
                let op_name = node_name(op)
                if seen.contains(op_name) {
                    diag_error_at("DuplicateEffectOperation", DUPLICATE_EFFECT_OP, "effect `{node_name(ed)}` declares operation `{op_name}` more than once", op, "the operations under one root effect share one dispatch table, so rename this operation or move it under a different root effect")
                } else {
                    seen.insert(op_name, 1)
                }
                oi = oi + 1
            }
        }
        ci = ci + 1
    }
}

fn register_ue_op_sigs(ed: Int) ! TypeCheck.Register, TypeCheck.Resolve, Diag.Report {
    let handle = str_to_lower(node_name(ed))
    let children_sl = node_elements(ed)
    if children_sl == -1 { return }
    let saved_suppress = tc_suppress_ann_validation
    tc_suppress_ann_validation = 1
    let mut ci = 0
    while ci < sublist_length(children_sl) {
        let ops_sl = node_methods(sublist_get(children_sl, ci))
        if ops_sl != -1 {
            let mut oi = 0
            while oi < sublist_length(ops_sl) {
                let op = sublist_get(ops_sl, oi)
                let op_name = node_name(op)
                node_set_name(op, "{handle}.{op_name}")
                tc_ue_op_root.insert(op, ed)
                register_fn_sig(op)
                publish_ue_op_tids(op)
                node_set_name(op, op_name)
                oi = oi + 1
            }
        }
        ci = ci + 1
    }
    tc_suppress_ann_validation = saved_suppress
}

// The root effect whose operation this call performs, or -1. The call's recorded
// declaration decides it, so a handle spelled like an imported module still performs
// wherever typecheck typed the call as the operation.
pub fn tc_call_user_effect(call_node: Int) -> Int {
    let decl = tc_call_decl_node(call_node)
    if decl < 0 { return -1 }
    tc_ue_op_root.get(decl) ?? -1
}

// The builtin Handler tid a `default.op(args)` call performs through, or -1. Name resolution
// typed the receiver as the handler the enclosing operation belongs to; a user root answers
// through tc_call_user_effect instead, and a local named `default` is a value.
pub fn tc_call_builtin_default(call: Int) -> Int {
    if call < 0 || node_kind(call) != NodeKind.MethodCall { return -1 }
    let obj = node_obj(call)
    if obj < 0 || node_kind(obj) != NodeKind.Ident || node_name(obj) != "default" { return -1 }
    if tc_mc_obj_is_value(call) != 0 { return -1 }
    let tid = tc_lookup_node_tid(obj)
    let eff = tc_tid_handler_effect(tid)
    if eff == "" || !builtin_root_has_handler_ops(tc_handler_effect_root(eff)) { return -1 }
    tid
}

// `default` in a handler operation names the handler this one was installed over (§4
// explicit delegation). Name resolution is the walk that knows which operation it is in, so it
// types the receiver as that handler and records the operation the call performs; inference and
// codegen then read the call as a perform of the root, the same one an omitted operation reaches.
fn nr_resolve_default_receiver(call: Int, obj: Int) {
    if tc_current_fn_node < 0 { return }
    let eff = tc_tid_handler_effect(tc_lookup_node_tid(tc_current_fn_node))
    if eff == "" { return }
    let root = tc_handler_effect_root(eff)
    tc_publish_node_tid(obj, make_handler_type(root))
    let handle = str_to_lower(root)
    if is_user_effect_handle_name(handle) == 0 { return }
    let sig = lookup_fnsig("{handle}.{node_method(call)}")
    if sig != -1 { nr_note_call_decl(call, fnsig_pool.get(sig).unwrap().decl) }
}

// The answer of `default.method(args)`, whose receiver name resolution typed as a handler of
// `root`. A closure can outlive the operation it is written in, so there is no enclosing
// handler for it to name.
fn tc_infer_default_perform(call: Int, root: Str, method: Str) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if tc_closure_scope_base.len() > 0 {
        diag_error_at("UnresolvedMethod", UNRESOLVED_METHOD,
            "`default` cannot be used inside a closure within a handler operation", call,
            "call `default.{method}` in the operation body itself")
        return tc_error_recovery_tid()
    }
    let handle = str_to_lower(root)
    let user = is_user_effect_handle_name(handle) != 0
    if !user && !builtin_root_has_handler_ops(root) {
        diag_error_at("UnresolvedMethod", UNRESOLVED_METHOD,
            "`default` is not supported yet in a handler of effect `{root}`", call,
            "call the effect's handle directly, or forward to a handler you hold")
        return tc_error_recovery_tid()
    }
    let key = if user { "{handle}.{method}" } else { builtin_handler_op_key(root, method) }
    let sig = if user { lookup_fnsig(key) } else { builtin_handler_op_sig(root, method) }
    if sig == -1 {
        diag_error_at("UnresolvedMethod", UNRESOLVED_METHOD, "effect `{root}` has no operation `{method}`", call, "")
        return tc_error_recovery_tid()
    }
    let _ = check_arg_shapes(key, sig, node_args(call), 0, call)
    fnsig_pool.get(sig).unwrap().ret
}

// The builtin roots whose handler operations the spec names (§4.3): IO's three, which take
// the rendered text, and the three IO.Read operations of §4.4.9; Time's two; and the five FS
// operations of §4.4.5. Env's names differ between the spec and the runtime, so it has none
// here until that is settled; the other builtin roots name none.
fn builtin_root_has_handler_ops(root: Str) -> Bool {
    root == "IO" || root == "Time" || root == "FS"
}

// The FS operations of §4.4.5, in the order the FS vtable lays out its slots. Each row names
// the sub-effect that performs the operation (list_dir and stat are reads; there is no FS.List
// or FS.Stat) and the std.fs_ops function that is its default body. Typecheck reads the rows
// for the clauses a handler may write and codegen for the vtable, so the two cannot drift.
pub type FsOpRow {
    op: Str
    sub_effect: Str
    default_fn: Str
}

pub fn fs_op_rows() -> List[FsOpRow] {
    [
        FsOpRow { op: "read", sub_effect: "Read", default_fn: "fs_do_read" },
        FsOpRow { op: "write", sub_effect: "Write", default_fn: "fs_do_write" },
        FsOpRow { op: "list_dir", sub_effect: "Read", default_fn: "fs_do_list_dir" },
        FsOpRow { op: "stat", sub_effect: "Read", default_fn: "fs_do_stat" },
        FsOpRow { op: "delete", sub_effect: "Delete", default_fn: "fs_do_delete" },
    ]
}

// The sub-effect that performs an FS operation, or "" for a name that is no FS operation.
pub fn fs_op_sub_effect(op: Str) -> Str {
    for row in fs_op_rows() {
        if row.op == op { return row.sub_effect }
    }
    ""
}

// The operations of IO.Read (§4.4.9), in the order the IO vtable lays out their slots.
// read_bytes is the primitive and the one operation whose count the perform checks.
// read_line and read_all are derived: std.io_read holds the spec's body of each under the
// operation's own name, and it runs over the read_bytes of the handler that omits it.
pub fn io_read_ops() -> List[Str] { [IO_READ_PRIMITIVE, "read_line", "read_all"] }

pub let IO_READ_PRIMITIVE = "read_bytes"

pub fn is_io_read_op(op: Str) -> Bool { io_read_ops().contains(op) }

pub fn is_io_read_derived_op(op: Str) -> Bool { op != IO_READ_PRIMITIVE && is_io_read_op(op) }

// The module that holds the derived bodies. The loader loads it and codegen finds the bodies
// in it, so both read the name here.
pub fn io_read_module() -> Str { "std.io_read" }

// Whether a handler of `eff` writes IO.Read's operations: a handler of the root or of IO.Read.
pub fn handles_io_read(eff: Str) -> Bool { eff == "IO" || eff == "IO.Read" }

// No source spelling reaches this key, so no declaration can take it over.
fn builtin_handler_op_key(root: Str, op: Str) -> Str {
    "Handler[{root}].{op}"
}

// The signature of a handler operation of a builtin root, or -1 for a name the spec does not
// give that root. io.eprint is not interceptable, so eprint is no operation, and a caller
// name such as println is not one either. Registered on first use, so Instant and Duration are
// minted only for a program that delegates a Time operation or omits one from a Time handler.
fn builtin_handler_op_sig(root: Str, op: Str) -> Int {
    let key = builtin_handler_op_key(root, op)
    let found = lookup_fnsig(key)
    if found != -1 { return found }
    if root == "IO" && (op == "print" || op == "print_no_nl" || op == "log") {
        register_intrinsic_fn_sig(key, [TYPE_STR], TYPE_VOID)
    } else if root == "Time" && op == "read" {
        register_intrinsic_fn_sig(key, [], runtime_instant_tid())
    } else if root == "Time" && op == "sleep" {
        register_named_intrinsic_fn_sig(key, [runtime_duration_tid()], ["d"], TYPE_VOID)
    } else if root == "FS" && fs_op_sub_effect(op) != "" {
        // The handle call's own signature, so a clause and the call it answers cannot differ.
        return lookup_fnsig("fs.{op}")
    } else if root == "IO" && is_io_read_op(op) {
        return lookup_fnsig("io.{op}")
    } else {
        return -1
    }
    lookup_fnsig(key)
}

// The operations of the marked builtin effects that the W0545 check reads, in the order a
// warning names them. Only a primitive operation can be missing; a derived one still shows
// that a parent handler means to handle its sub-effect. Each operation's signature comes from
// builtin_handler_op_sig.
type BuiltinHandlerOp {
    root: Str
    sub_effect: Str
    op: Str
    primitive: Bool
}

fn builtin_handler_ops() -> List[BuiltinHandlerOp] {
    let mut rows = [
        BuiltinHandlerOp { root: "Time", sub_effect: "Read", op: "read", primitive: true },
        BuiltinHandlerOp { root: "Time", sub_effect: "Sleep", op: "sleep", primitive: true },
    ]
    for op in io_read_ops() {
        rows.push(BuiltinHandlerOp { root: "IO", sub_effect: "Read", op: op, primitive: !is_io_read_derived_op(op) })
    }
    rows
}

// The builtin effects the stdlib marks `@handle_all` (§4.7.1): a root such as `Time`, or one
// sub-effect such as `IO.Read`, which covers that sub-effect only. A marked effect needs its
// operations in builtin_handler_ops.
fn builtin_handle_all_marks() -> List[Str] {
    ["Time", "IO.Read"]
}

// The sub-effects of the builtin `root` that the handler clauses `implemented` write one or
// more operations of, derived ones included. `rows` is builtin_handler_ops().
fn builtin_sub_effects_written(rows: List[BuiltinHandlerOp], root: Str, implemented: Map[Str, Int]) -> Map[Str, Int] {
    let mut written: Map[Str, Int] = Map()
    for row in rows {
        if row.root == root && implemented.contains_key(row.op) { written.insert(row.sub_effect, 1) }
    }
    written
}

pub fn is_user_effect_handle_name(name: Str) -> Int {
    if tc_ue_handle_decl(name) != -1 { 1 } else { 0 }
}

// The root EffectDecl whose handle is `name`, or -1.
fn tc_ue_handle_decl(name: Str) -> Int {
    for h in tc_ue_handles {
        if h.handle == name { return h.decl }
    }
    -1
}

// ── PartialHandler (W0545) ──────────────────────────────────────────
// sections/04_effects.md §4.7.1. The check sits on the handler expression, so a literal, a
// factory's tail and a handler bound to a value each warn once, wherever it is installed.

// The primitive operations of `ops` that `implemented` does not name, appended in
// declaration order. A derived operation has a body in the declaration, so it never counts.
fn partial_handler_collect(ops: Int, implemented: Map[Str, Int], missing: List[Int]) {
    if ops == -1 { return }
    let mut i = 0
    while i < sublist_length(ops) {
        let op = sublist_get(ops, i)
        if node_body(op) == -1 && !implemented.contains_key(node_name(op)) { missing.push(op) }
        i = i + 1
    }
}

fn partial_handler_touches(ops: Int, implemented: Map[Str, Int]) -> Bool {
    if ops == -1 { return false }
    let mut i = 0
    while i < sublist_length(ops) {
        if implemented.contains_key(node_name(sublist_get(ops, i))) { return true }
        i = i + 1
    }
    false
}

fn partial_handler_child(ed: Int, name: Str) -> Int {
    let children = node_elements(ed)
    if children == -1 { return -1 }
    let mut i = 0
    while i < sublist_length(children) {
        let c = sublist_get(children, i)
        if node_name(c) == name { return c }
        i = i + 1
    }
    -1
}

// The clause the fix adds for one omitted operation. `fixable` is false when the file that gets
// it cannot spell one of the types the operation names.
type HandlerStub {
    text: Str
    fixable: Bool
}

// The qualifier through which `here` reaches `decl` as `name`, or "" when no import of
// `here` reaches it.
fn partial_handler_qualifier(name: Str, decl: Int, here: Str) -> Str {
    let quals = nr_module_imports_built(here).qualifiers
    for q in quals.keys() {
        if nr_resolve_decl_in_module(quals.get(q) ?? "", name, 0) == decl { return q }
    }
    ""
}

// The clause the fix adds for `op` in module `here`: its declared signature, forwarding on
// purpose. The declaration spells its types for its own module, so a type that `here` reaches
// only through a qualifier is spelled qualified. A parameter named `default` would shadow the
// handler the clause forwards to, so it gets a fresh name.
fn partial_handler_stub(op: Int, decl_mod: Str, here: Str) -> HandlerStub {
    let mut taken: List[Str] = []
    let mut names: List[Str] = []
    let params = node_params(op)
    if params != -1 {
        let mut i = 0
        while i < sublist_length(params) {
            let p = sublist_get(params, i)
            taken.push(node_name(p))
            if node_type_ann(p) != -1 { tc_collect_type_ann_names(node_type_ann(p), names) } else { names.push(node_type_name(p)) }
            i = i + 1
        }
    }
    if node_type_ann(op) != -1 { tc_collect_type_ann_names(node_type_ann(op), names) } else { names.push(node_return_type(op)) }
    let mut args: List[Str] = []
    for n in taken {
        let mut a = n
        if n == "default" {
            a = "default_"
            while taken.contains(a) { a = a.concat("_") }
        }
        args.push(a)
    }
    let mut renames: Map[Str, Str] = Map()
    let mut fixable = true
    if decl_mod != here {
        for n in names {
            let d = nr_resolve_bare_decl(n, decl_mod)
            if d != -1 && !renames.contains_key(n) && nr_resolve_bare_decl(n, here) != d {
                let q = partial_handler_qualifier(n, d, here)
                if q == "" { fixable = false } else { renames.insert(n, "{q}.{n}") }
            }
        }
    }
    let text = "{effect_op_sig_text(op, renames, args, false)} \{ default.{node_name(op)}({args.join(", ")}) }"
    HandlerStub { text: text, fixable: fixable }
}

fn leading_whitespace(line: Str) -> Str {
    let mut i = 0
    while i < line.byte_len() && (line.byte_at(i) == 32 || line.byte_at(i) == 9) { i = i + 1 }
    line.byte_slice(0, i)
}

// Adds the stubs before the handler's closing brace, one clause per line, indented one level
// inside the handler. A brace that shares its line with code is moved to a line of its own.
fn partial_handler_fix(he: Int, stubs: List[Str], action: Str) {
    let file = diag_file_for_node(he)
    let close_line = node_end_line(he)
    let close_col = node_end_col(he)
    let text = diag_source_line(file, close_line)
    if close_line <= 0 || close_col <= 0 || text.byte_len() < close_col { return }
    let before = text.byte_slice(0, close_col - 1)
    if leading_whitespace(before) == before {
        let unit = indent_unit(before)
        let mut add = ""
        for stub in stubs { add = add.concat("{unit}{stub}\n{before}") }
        diag_set_last_fix_at(action, add, close_line, close_col, close_line, close_col)
        return
    }
    let base = leading_whitespace(diag_source_line(file, node_line(he)))
    let unit = indent_unit(base)
    let mut end = before.byte_len()
    while end > 0 && (before.byte_at(end - 1) == 32 || before.byte_at(end - 1) == 9) { end = end - 1 }
    let mut add = "\n"
    for stub in stubs { add = add.concat("{base}{unit}{stub}\n") }
    diag_set_last_fix_at(action, add.concat(base), close_line, end + 1, close_line, close_col)
}

// One level of indentation in the style of `ws`: a tab when it holds one, else four spaces.
fn indent_unit(ws: Str) -> Str {
    if ws.contains("\t") { "\t" } else { "    " }
}

// The column just past the effect name of the handler expression `he`, which names `eff`.
// Any run of blanks may sit between `handler` and the name.
fn partial_handler_span_end(he: Int, eff: Str) -> Int {
    let line = diag_source_line(diag_file_for_node(he), node_line(he))
    let mut i = node_col(he) - 1 + "handler".byte_len()
    while i < line.byte_len() && (line.byte_at(i) == 32 || line.byte_at(i) == 9) { i = i + 1 }
    if i + eff.byte_len() > line.byte_len() { return node_col(he) + "handler ".byte_len() + eff.byte_len() }
    i + 1 + eff.byte_len()
}

// The EffectDecl named `root`. A handle is the lowercased name, so two effects whose names
// differ only in case share one, and the handle alone does not say which is meant.
fn tc_effect_decl_named(root: Str) -> Int {
    let handle = str_to_lower(root)
    for h in tc_ue_handles {
        if h.handle == handle && node_name(h.decl) == root { return h.decl }
    }
    -1
}

// The operation names the clauses of the handler expression `he` implement.
fn partial_handler_implemented(he: Int) -> Map[Str, Int] {
    let mut implemented: Map[Str, Int] = Map()
    let clauses = node_methods(he)
    if clauses != -1 {
        let mut i = 0
        while i < sublist_length(clauses) {
            implemented.insert(node_name(sublist_get(clauses, i)), 1)
            i = i + 1
        }
    }
    implemented
}

fn tc_check_partial_handler(he: Int) ! Diag.Report, TypeCheck.Resolve {
    let eff = node_name(he)
    let root = tc_handler_effect_root(eff)
    let ed = tc_effect_decl_named(root)
    if ed == -1 {
        tc_check_partial_builtin_handler(he, eff, root)
        return
    }
    // A declaration the parser recovered from may have lost operations, so its handlers are
    // not judged against it.
    if diag_errors_in_lines(diag_file_for_node(ed), node_line(ed), node_end_line(ed)) > 0 { return }
    let root_marked = has_annotation(ed, "handle_all") != 0
    let implemented = partial_handler_implemented(he)
    let mut missing: List[Int] = []
    let mut marked: List[Str] = []
    if eff == root {
        let children = node_elements(ed)
        if children != -1 {
            let mut i = 0
            while i < sublist_length(children) {
                let child = sublist_get(children, i)
                let ops = node_methods(child)
                // A marked root covers every sub-effect. Only an unmarked parent waits for a
                // clause of the marked sub-effect, which says the handler means to handle it.
                if root_marked || (has_annotation(child, "handle_all") != 0 && partial_handler_touches(ops, implemented)) {
                    let before = missing.len()
                    partial_handler_collect(ops, implemented, missing)
                    let label = if root_marked { root } else { "{root}.{node_name(child)}" }
                    if missing.len() > before && !marked.contains(label) { marked.push(label) }
                }
                i = i + 1
            }
        }
    } else {
        let child = partial_handler_child(ed, eff.byte_slice(root.byte_len() + 1, eff.byte_len()))
        if child == -1 { return }
        if root_marked || has_annotation(child, "handle_all") != 0 {
            partial_handler_collect(node_methods(child), implemented, missing)
            marked.push(if root_marked { root } else { eff })
        }
    }
    let mut names: List[Str] = []
    let mut stubs: List[Str] = []
    let mut fixable = true
    for op in missing {
        names.push(node_name(op))
        let stub = partial_handler_stub(op, node_module(ed), nr_current_module)
        stubs.push(stub.text)
        fixable = fixable && stub.fixable
    }
    partial_handler_warn(he, eff, names, stubs, fixable, marked)
}

// W0545 on a handler for a builtin effect, which has no declaration: the operations come from
// builtin_handler_ops, the marks from builtin_handle_all_marks, and the rule is the one
// tc_check_partial_handler applies to a declared effect.
fn tc_check_partial_builtin_handler(he: Int, eff: Str, root: Str) ! Diag.Report, TypeCheck.Resolve {
    let marks = builtin_handle_all_marks()
    let root_marked = marks.contains(root)
    let sub = if eff == root { "" } else { eff.byte_slice(root.byte_len() + 1, eff.byte_len()) }
    let implemented = partial_handler_implemented(he)
    let rows = builtin_handler_ops()
    let touched = builtin_sub_effects_written(rows, root, implemented)
    let mut names: List[Str] = []
    let mut stubs: List[Str] = []
    let mut fixable = true
    let mut marked: List[Str] = []
    for row in rows {
        let path = "{root}.{row.sub_effect}"
        // As for a declared effect: a marked root covers every sub-effect, and an unmarked
        // parent counts a marked sub-effect only once the handler implements one of its
        // operations.
        let in_scope = row.primitive && row.root == root && (sub == "" || sub == row.sub_effect)
        let counts = in_scope && (root_marked || (marks.contains(path) && (sub != "" || touched.contains_key(row.sub_effect))))
        if counts && !implemented.contains_key(row.op) {
            let stub = builtin_partial_handler_stub(he, root, row.op)
            names.push(row.op)
            stubs.push(stub.text)
            fixable = fixable && stub.fixable
            let label = if root_marked { root } else { path }
            if !marked.contains(label) { marked.push(label) }
        }
    }
    partial_handler_warn(he, eff, names, stubs, fixable, marked)
}

// The clause the fix adds for the builtin operation `op` of `root`. The fix is withheld when a
// parameter has no name, or when the file spells a type of the signature as another type. A
// parameter named `default` would shadow the handler the clause forwards to, so it gets a
// fresh name.
fn builtin_partial_handler_stub(he: Int, root: Str, op: Str) -> HandlerStub ! Diag.Report, TypeCheck.Resolve {
    let sig = builtin_handler_op_sig(root, op)
    if sig == -1 {
        diag_ice_at("BuiltinHandlerOpUnsigned", UNSOLVED_TYPEVAR_AT_CODEGEN,
            "builtin operation `{root}.{op}` has no handler signature", he,
            "every row of builtin_handler_ops needs a signature in builtin_handler_op_sig")
        return HandlerStub { text: "", fixable: false }
    }
    let entry = fnsig_pool.get(sig).unwrap()
    let mut taken: List[Str] = []
    let mut i = 0
    while i < entry.params_count {
        taken.push(fnsig_param_names.get(entry.params_start + i) ?? "")
        i = i + 1
    }
    let mut fixable = true
    let mut params: List[Str] = []
    let mut args: List[Str] = []
    i = 0
    while i < entry.params_count {
        let t = fnsig_param_list.get(entry.params_start + i) ?? -1
        let mut name = taken.get(i) ?? ""
        if name == "default" {
            name = "default_"
            while taken.contains(name) { name = name.concat("_") }
        }
        if name == "" || !builtin_stub_type_spellable(t) { fixable = false }
        params.push("{name}: {type_to_str(t)}")
        args.push(name)
        i = i + 1
    }
    let mut ret = ""
    if entry.ret != TYPE_VOID {
        if !builtin_stub_type_spellable(entry.ret) { fixable = false }
        ret = " -> {type_to_str(entry.ret)}"
    }
    let text = "fn {op}({params.join(", ")}){ret} \{ default.{op}({args.join(", ")}) }"
    HandlerStub { text: text, fixable: fixable }
}

// Whether the current module spells `t` by its name. The types a builtin signature names are
// declared in lib/std, and ensure_runtime_struct_type returns a namesake that a user module
// declares, so a declaration from outside lib/std means the name is not the runtime's type.
fn builtin_stub_type_spellable(t: Int) -> Bool ! TypeCheck.Resolve, Diag.Report {
    // `()` names no declaration, so no module can take its spelling.
    if type_kind(t) == TyKind.Void { return true }
    let named = resolve_type_name(type_to_str(t))
    // Each mention of Bytes gets its own tid, so Bytes is spellable when no declaration takes
    // the name.
    if type_kind(t) == TyKind.Bytes { return named >= 0 && type_kind(named) == TyKind.Bytes }
    if named != t { return false }
    let decl = tc_tid_decl_node(t)
    decl == -1 || (decl >= 0 && node_source_module(decl).starts_with("std_"))
}

// Raises W0545 on `he` for the omitted operations `names`, whose clauses are `stubs`, and
// attaches the fix unless a stub cannot be spelled in this file.
fn partial_handler_warn(he: Int, eff: Str, names: List[Str], stubs: List[Str], fixable: Bool, marked: List[Str]) ! Diag.Report {
    if names.len() == 0 { return }
    let mut quoted: List[Str] = []
    for n in names { quoted.push("`{n}`") }
    let one = names.len() == 1
    let pronoun = if one { "it" } else { "them" }
    let mut notes: List[Str] = []
    for m in marked { notes.push("`{m}` is marked `@handle_all`") }
    notes.push("omitted operations go to the enclosing handler")
    let before = diag_entry_count()
    diag_warn_span_at_notes("PartialHandler", PARTIAL_HANDLER,
        "handler for `{eff}` does not implement {quoted.join(", ")}", he,
        partial_handler_span_end(he, eff),
        "implement {pronoun}, or forward on purpose: `{stubs.get(0).unwrap()}`", notes)
    // A silenced warning records no entry, and the fix would land on someone else's.
    if diag_entry_count() == before || !fixable { return }
    partial_handler_fix(he, stubs, if one { "add the omitted operation" } else { "add the omitted operations" })
}

// ── Selective import filtering ──────────────────────────────────────
// consuming_mod → source_mod → every import of that module the file writes, in source order:
// the import node, or -1 for a whole-module import. A file may import one module more than
// once (a selection and a whole-module import, or two selections), and each import binds its
// own names, so none replaces another. Keyed by the consuming module first, since a lookup by
// bare name asks for one module's imports. The driver fills it through record_module_import
// while it resolves imports; the checks that read it live here.
let mut per_module_imports: Map[Str, Map[Str, List[Int]]] = Map()
pub let mut tc_import_modules: List[Str] = []
pub let mut tc_import_qualifiers: List[Str] = []
pub let mut tc_import_nodes: List[Int] = []
let mut tc_module_import_node: Map[Str, Int] = Map()
let mut tc_qualifier_to_module: Map[Str, Str] = Map()
let mut tc_import_modules_idx: Map[Str, Int] = Map()
let mut tc_import_qualifiers_set: Map[Str, Int] = Map()

// One name a selective import selects: the module it is selected from and its spelling there.
type ImportBinding {
    source_mod: Str
    member: Str
}

pub fn record_module_import(consuming_mod: Str, source_mod: Str, imp_node: Int) {
    nr_drop_import_index(consuming_mod)
    let mut imports = per_module_imports.get(consuming_mod) ?? Map()
    let mut nodes = imports.get(source_mod) ?? []
    if nodes.contains(imp_node) { return }
    nodes.push(imp_node)
    imports.insert(source_mod, nodes)
    per_module_imports.insert(consuming_mod, imports)
}

pub fn clear_module_imports() {
    per_module_imports.clear()
    for mod_name in nr_module_names.keys() {
        nr_drop_import_index(mod_name)
    }
}

// The index is derived from per_module_imports[consuming_mod] alone, so a change to that one
// import list is all that makes it stale. The module's answers about bare names read the
// index, so they go with it.
fn nr_drop_import_index(consuming_mod: Str) {
    match nr_module_names.get(consuming_mod) {
        Some(r) => {
            nr_forget_module_answers(r)
            if r.imports_built {
                r.imports.clear()
                r.selects.clear()
                r.qualifiers.clear()
                nr_module_names.insert(consuming_mod, ModuleNames { decls: r.decls, sigs: r.sigs, imports: r.imports, selects: r.selects, qualifiers: r.qualifiers, imports_built: false, unselected: r.unselected, private_access: r.private_access, bare_decl: r.bare_decl, package: r.package, poisoned: r.poisoned })
            }
        }
        None => {}
    }
}

fn nr_module_import_index(consuming_mod: Str) -> Map[Str, List[ImportBinding]] {
    nr_module_imports_built(consuming_mod).imports
}

// The record of `consuming_mod` with its import index and selected spellings built.
fn nr_module_imports_built(consuming_mod: Str) -> ModuleNames {
    let r = nr_module_names_of(consuming_mod)
    if r.imports_built { return r }
    let mut idx = r.imports
    let mut selects = r.selects
    let mut quals = r.qualifiers
    match per_module_imports.get(consuming_mod) {
        Some(imports) => {
            for source_mod in imports.keys() {
                // A selective import binds the module's qualifier as a whole-module one does.
                quals.insert(tc_qualifier_for_module(source_mod), source_mod)
                for imp_node in imports.get(source_mod) ?? [] {
                    if imp_node == -1 { continue }
                    // Every selection of the module adds to one spelling set, so a second
                    // import of it never takes away what the first binds.
                    let mut spellings = selects.get(source_mod) ?? Map()
                    selects.insert(source_mod, spellings)
                    let names_sl = node_args(imp_node)
                    if names_sl == -1 { continue }
                    let mut i = 0
                    while i < sublist_length(names_sl) {
                        let name_node = sublist_get(names_sl, i)
                        let alias = node_str_val(name_node)
                        let bound = if alias != "" { alias } else { node_name(name_node) }
                        let mut binds = idx.get(bound) ?? []
                        binds.push(ImportBinding { source_mod: source_mod, member: node_name(name_node) })
                        idx.insert(bound, binds)
                        // An alias replaces the original name in this file (sections/07, the
                        // alias rules): only the spelling the import binds is selected.
                        spellings.insert(bound, 1)
                        i = i + 1
                    }
                }
            }
        }
        None => {}
    }
    let built = ModuleNames { decls: r.decls, sigs: r.sigs, imports: idx, selects: selects, qualifiers: quals, imports_built: true, unselected: r.unselected, private_access: r.private_access, bare_decl: r.bare_decl, package: r.package, poisoned: r.poisoned }
    nr_module_names.insert(consuming_mod, built)
    built
}

// Every import of `source_mod` that `consuming_mod` writes: an empty list when it has none.
fn module_imports_of(consuming_mod: Str, source_mod: Str) -> List[Int] {
    match per_module_imports.get(consuming_mod) {
        Some(imports) => imports.get(source_mod) ?? []
        None => []
    }
}

// ── Pub import re-export tracking ──────────────────────────────────
// Key: "reexporting_mod:item_name" → source module name (selective re-exports)
// Key: "reexporting_mod:*:source_mod" → source module name (wildcard re-exports)
pub let mut tc_reexport_source: Map[Str, Str] = Map()
pub let mut tc_reexport_modules: Map[Str, Int] = Map()

fn tc_apply_reexport_remapping() {
    let keys = tc_reexport_source.keys()
    let mut i = 0
    while i < keys.len() {
        let key = keys.get(i).unwrap()
        match key.byte_index_of(":", 0) {
            Some(colon_idx) => {
                if colon_idx > 0 {
                    let reexporter = key.byte_slice(0, colon_idx)
                    let rest = key.byte_slice(colon_idx + 1, key.byte_len())
                    if rest.starts_with("*:") {
                        let source_mod = rest.byte_slice(2, rest.byte_len())
                        let sym_keys = tc_symbol_module.keys()
                        let mut si = 0
                        while si < sym_keys.len() {
                            let sym = sym_keys.get(si).unwrap()
                            if tc_symbol_module.get(sym).unwrap() == source_mod {
                                tc_symbol_module.insert(sym, reexporter)
                            }
                            si = si + 1
                        }
                    } else {
                        let item_name = rest
                        match tc_symbol_module.get(item_name) {
                            Some(current_mod) => {
                                let source_mod = tc_reexport_source.get(key).unwrap()
                                if current_mod == source_mod {
                                    tc_symbol_module.insert(item_name, reexporter)
                                }
                            }
                            None => {}
                        }
                    }
                }
            }
            None => {}
        }
        i = i + 1
    }
}

fn tc_build_import_map() {
    tc_module_import_node = Map()
    tc_qualifier_to_module = Map()
    tc_import_modules_idx = Map()
    tc_import_qualifiers_set = Map()
    let mut i = 0
    while i < tc_import_modules.len() {
        let mod_key = tc_import_modules.get(i).unwrap()
        tc_import_modules_idx.insert(mod_key, i)
        let node_id = tc_import_nodes.get(i).unwrap()
        if i < tc_import_qualifiers.len() {
            let qual = tc_import_qualifiers.get(i).unwrap()
            if qual != "" && qual != mod_key {
                tc_qualifier_to_module.insert(qual, mod_key)
            }
            if qual != "" {
                tc_import_qualifiers_set.insert(qual, 1)
            }
        }
        if node_id != -1 {
            tc_module_import_node.insert(mod_key, node_id)
        }
        i = i + 1
    }
}

// Whether some selective import of `source_mod` in `consuming_mod` binds `name`: the alias of
// a renaming entry, or else the selected name.
fn is_selected_import(name: Str, consuming_mod: Str, source_mod: Str) -> Int {
    match nr_module_imports_built(consuming_mod).selects.get(source_mod) {
        Some(spellings) => if spellings.contains_key(name) { 1 } else { 0 }
        None => 0
    }
}

pub fn is_import_module_name(name: Str) -> Int {
    if tc_import_modules_idx.contains_key(name) { return 1 }
    if tc_import_qualifiers_set.contains_key(name) { return 1 }
    0
}

// The namespaces the compiler provides itself. No import declares them, so
// is_import_module_name does not know them, yet `io` in `io.println(..)` names a namespace
// exactly as an imported qualifier does.
pub fn is_builtin_namespace(name: Str) -> Int {
    if name == "io" { return 1 }
    if name == "fs" { return 1 }
    if name == "net" { return 1 }
    if name == "env" { return 1 }
    if name == "time" { return 1 }
    if name == "async" { return 1 }
    if name == "channel" { return 1 }
    if name == "default" { return 1 }
    if name == "term" { return 1 }
    if name == "ffi" { return 1 }
    0
}

fn tc_get_dotted_module_path(mod_key: Str) -> Str {
    match tc_module_import_node.get(mod_key) {
        Some(imp_node) => {
            let dotted = node_str_val(imp_node)
            if dotted != "" {
                return dotted
            }
        }
        None => {}
    }
    mod_key
}

fn is_filtered_for_module(name: Str, source_mod: Str, consuming_mod: Str) -> Int {
    if source_mod == consuming_mod { return 0 }
    if source_mod == "" { return 0 }
    if consuming_mod == "" { return 0 }
    // A prelude module's types and traits are in every module's scope (section 10.6), so an
    // import of that module cannot narrow them to a selection. Its free functions still need one.
    if tc_prelude_modules.contains_key(source_mod) && tc_prelude_free_fn.contains_key(name) == 0 { return 0 }
    // A whole-module import binds only the qualifier, so an imported module's bare name is in
    // scope just when one of the file's selections of that module names it.
    if module_imports_of(consuming_mod, source_mod).len() > 0 {
        return is_selected_import(name, consuming_mod, source_mod) == 0
    }
    // No import of this module at all. A file's imports say what it depends on, so a name
    // it never asked for is not in its scope, however many other modules pulled the
    // declaration in. A prelude module is the exception: its types and traits stay visible
    // without an import, and a bare call to one of its free functions is E0504, reported by
    // nr_is_unimported_prelude_free_fn below, not a missing selection.
    if tc_prelude_modules.contains_key(source_mod) { return 0 }
    1
}

// True when `name` is a free function exported by a prelude module that the
// current module did NOT explicitly import. The prelude contributes
// compiler-known types/traits/impls unconditionally, but its free functions
// require an explicit `import` (§3.2.3) — a bare call to one is an undefined
// reference (E0504, §6.3.5), NOT an ImportNotSelected.
fn nr_is_unimported_prelude_free_fn(name: Str) -> Int {
    // Only prelude-module free fns are recorded here, so membership already
    // implies the source is a prelude module.
    if tc_prelude_free_fn.contains_key(name) == 0 { return 0 }
    let source_mod = match tc_symbol_module.get(name) {
        Some(v) => v
        None => return 0
    }
    if nr_current_module == source_mod { return 0 }
    // The current module's own declaration is the binding; the prelude fn is not in scope.
    if nr_module_declares(nr_current_module, name) != 0 { return 0 }
    // An explicit import (bare or selective-including-name) makes it visible.
    if module_imports_of(nr_current_module, source_mod).contains(-1) { return 0 }
    if is_selected_import(name, nr_current_module, source_mod) != 0 { return 0 }
    1
}

fn is_builtin_name(name: Str) -> Int {
    if is_primitive_type(name) != 0 { return 1 }
    if is_builtin_fn(name) != 0 { return 1 }
    0
}

fn tc_qualifier_for_module(mod_key: Str) -> Str {
    match tc_import_modules_idx.get(mod_key) {
        Some(idx) => {
            if idx < tc_import_qualifiers.len() {
                let q = tc_import_qualifiers.get(idx).unwrap()
                if q != "" {
                    return q
                }
            }
            return mod_key
        }
        None => {}
    }
    mod_key
}

// Inverse of tc_qualifier_for_module: an import qualifier (the leaf the user
// writes before `.`, e.g. "libc") -> the module key stored in tc_symbol_module
// values (e.g. "std_libc"). Falls back to the qualifier when no alias mapping
// exists (qual == key).
pub fn tc_qualifier_to_module_or_self(qualifier: Str) -> Str {
    match tc_qualifier_to_module.get(qualifier) {
        Some(mod_name) => mod_name
        None => qualifier
    }
}

fn nr_check_selective_access(name: Str, node: Int) -> Int ! Diag.Report {
    if nr_current_module == "" { return 0 }
    if is_builtin_name(name) != 0 { return 0 }
    nr_check_selective_access_at(name, node, nr_top_index(name))
}

// nr_check_selective_access for a binding already looked up; `idx` is -1 when nothing binds
// the name.
fn nr_check_selective_access_at(name: Str, node: Int, idx: Int) -> Int ! Diag.Report {
    if nr_current_module == "" { return 0 }
    // A local binding holds a value, not a declaration some module exported. It may be spelled
    // like an exported name, and an import list has nothing to say about a local. Asked before
    // the builtin test, which costs a string compare ladder, since most reads are of locals.
    if nr_index_is_local(idx) { return 0 }
    // Two imports of this file bind the spelling to different declarations, which
    // tc_check_renamed_import_conflicts has reported. One mistake, one report, even when a
    // third module's declaration of the spelling sits in the shared frame. The read uses
    // both imports, so neither is reported unused either.
    if nr_renamed_import_clash(nr_current_module, name).0 != "" {
        tc_mark_alias_used(name)
        return 1
    }
    let mut answers = nr_module_names_of(nr_current_module).unselected
    let source_mod = match answers.get(name) {
        Some(m) => m
        None => {
            let m = nr_unselected_source(name)
            answers.insert(name, m)
            m
        }
    }
    if source_mod == "" { return 0 }
    // No import qualifier names the main file, so a selective import is its one fix.
    let fix = if source_mod == "__main__" { "add it to the import list" } else { "add it to the import list or use qualified access `{tc_qualifier_for_module(source_mod)}.{name}`" }
    if node == -1 {
        diag_error_no_loc("ImportNotSelected", IMPORT_NOT_SELECTED, "`{name}` is not in scope — {fix}", "add `{name}` to your selective import")
    } else {
        diag_error_at("ImportNotSelected", IMPORT_NOT_SELECTED, "`{name}` is not in scope — {fix}", node, "add `{name}` to your selective import")
    }
    1
}

// The import-list half of nr_check_selective_access, for a name no local binding holds: the
// module the name comes from when this module's import list does not select it, else "".
fn nr_unselected_source(name: Str) -> Str {
    if is_builtin_name(name) != 0 { return "" }
    if nr_module_declares(nr_current_module, name) != 0 { return "" }
    // A namesake type is in scope when this module's import list selects one declaration of
    // it; the last-writer symbol table below knows only one module for the name.
    if tc_nominal_type_name_in(name, nr_current_module) != name { return "" }
    let source_mod = match tc_symbol_module.get(name) {
        Some(v) => v
        // The main file's declarations are never recorded there, yet they reach another
        // module only through its import list, as any module's do.
        None => if nr_module_declares("__main__", name) != 0 { "__main__" } else { return "" }
    }
    // A private declaration cannot be selected or qualified, so the import list is not the
    // fix; the private-access check names the real problem.
    if nr_is_private_in(name, source_mod) != 0 { return "" }
    // The same last-writer limit as the namesake-type check above: `source_mod` is whichever
    // module was recorded last for the spelling, not the one this file's import list picked.
    if nr_bare_name_in_scope_here(name, nr_current_module) != 0 { return "" }
    // is_filtered_for_module answers 0 for an empty source, so "" is free to mean "in scope".
    if is_filtered_for_module(name, source_mod, nr_current_module) != 0 { return source_mod }
    ""
}

// ── Import visibility ───────────────────────────────────────────────

let mut nr_private_imports: Map[Str, Str] = Map()
let mut nr_current_module: Str = ""
let mut nr_name_source_module: Map[Str, Str] = Map()
// What one module's bare names mean inside it. Filed by module and then by bare name because
// name resolution asks these per name reference, and building a "module|name" key there cost
// an allocation and a hash of the longer key on each question. Each table keeps the lifetime
// it had on its own: init_types clears `sigs`, nr_record_program_decls clears `decls`, and
// `imports` is dropped whenever the module's import list changes.
type ModuleNames {
    // Every top-level declaration of the module, holding the declaration node. A module's own
    // declaration is what its bare name means, whatever other loaded modules declare under the
    // same spelling.
    decls: Map[Str, Int]
    // The signature index of each function the module registers. lookup_fnsig asks the current
    // module before the bare-name table, which a namesake in another module may hold.
    sigs: Map[Str, Int]
    // per_module_imports of the module turned inside out: the spelling an import binds (the
    // alias of a renaming import, or else the selected name) → every selection that binds it.
    // nr_resolve_imported_decl runs for each bare name a module reads that it does not declare,
    // and walking every name of every import list there was the cost of that question. Built
    // on first use; meaningless while imports_built is false.
    imports: Map[Str, List[ImportBinding]]
    // Each module the module imports selectively → every spelling those imports bind: the
    // alias of a renaming entry, or else the selected name. Resolve asks whether an import
    // selects a name for most names it reads, and a walk of the import list per question was
    // its largest cost. Built and dropped with `imports`.
    selects: Map[Str, Map[Str, Int]]
    // Each qualifier the module's imports bind → the module it names. Only these qualify a
    // name in the module: another module's import loads a module into the program and binds
    // nothing here. Built and dropped with `imports`.
    qualifiers: Map[Str, Str]
    imports_built: Bool
    // The answers resolve gives a spelling the module reads that no local binding holds, kept
    // because it asks them again at every read: nr_unselected_source, nr_private_access_here
    // and nr_find_bare_decl of each spelling. Each answer depends on the module and the
    // spelling, and on tables that resolve_names' setup and the passes before it fill: each
    // module's declarations and privates, the import lists, the symbol modules, the re-exports,
    // the namesake types, the type declarations of Handler and Template, and the prelude
    // modules. Nothing after that setup writes any of them until the next check, so
    // nr_record_program_decls and resolve_names drop every answer (nr_forget_answers), and a
    // change to one module's import list drops that module's. The calls emit and mark
    // nothing, so each caller still reports and marks at each node.
    unselected: Map[Str, Str]
    private_access: Map[Str, Int]
    bare_decl: Map[Str, Int]
    // The package the module's file belongs to, as the loader names it; "" when the loader
    // recorded none. A variant collides with a value only inside one package (E1016).
    package: Str
    // The names the module declares more than once in one namespace (E1016), keyed
    // "{namespace}|{name}", each to the first declaration (or pattern leaf) that binds it.
    // Only the first is checked, and what a use of the name gets from it is not reported
    // against it, since the use may have meant a later one.
    poisoned: Map[Str, Int]
}
let mut nr_module_names: Map[Str, ModuleNames] = Map()
// The same declarations gathered by bare name, so a caller can see every module that spells
// it and let its own import list choose between them.
let mut nr_decls_by_name: Map[Str, List[Int]] = Map()

// The record of `mod_name`, created empty on first use. Its maps are shared with the stored
// record, so a caller fills them in place.
fn nr_module_names_of(mod_name: Str) -> ModuleNames {
    match nr_module_names.get(mod_name) {
        Some(r) => r
        None => {
            let r = ModuleNames { decls: Map(), sigs: Map(), imports: Map(), selects: Map(), qualifiers: Map(), imports_built: false, unselected: Map(), private_access: Map(), bare_decl: Map(), package: "", poisoned: Map() }
            nr_module_names.insert(mod_name, r)
            r
        }
    }
}

pub fn tc_record_module_package(mod_name: Str, package: Str) {
    let r = nr_module_names_of(mod_name)
    nr_module_names.insert(mod_name, ModuleNames { decls: r.decls, sigs: r.sigs, imports: r.imports, selects: r.selects, qualifiers: r.qualifiers, imports_built: r.imports_built, unselected: r.unselected, private_access: r.private_access, bare_decl: r.bare_decl, package: package, poisoned: r.poisoned })
}

// Whether two modules sit in one package. A module is always in its own, and the standard
// library is one package whatever loaded it. Two modules the loader named no package for are
// taken to be one, as a program checked from a single source is.
fn tc_same_package(a: Str, b: Str) -> Bool {
    if a == b { return true }
    tc_module_package(a) == tc_module_package(b)
}

fn tc_module_package(m: Str) -> Str {
    if m.starts_with("std_") { return "std" }
    match nr_module_names.get(m) {
        Some(r) => r.package
        None => ""
    }
}

// The declaration `mod_name` itself makes under `name`, or -1.
fn nr_module_decl(mod_name: Str, name: Str) -> Int {
    match nr_module_names.get(mod_name) {
        Some(r) => r.decls.get(name) ?? -1
        None => -1
    }
}

// Drop every module's cached answers about the bare names it reads.
fn nr_forget_answers() {
    for mod_name in nr_module_names.keys() {
        nr_forget_module_answers(nr_module_names_of(mod_name))
    }
}

fn nr_forget_module_answers(r: ModuleNames) {
    r.unselected.clear()
    r.private_access.clear()
    r.bare_decl.clear()
}

// Every top-level declaration on record before any pass reads a name, since signature and
// type registration already resolve spellings (an alias in an annotation among them).
fn nr_record_program_decls(program: Int) {
    for mod_name in nr_module_names.keys() {
        nr_module_names_of(mod_name).decls.clear()
    }
    nr_forget_answers()
    nr_decls_by_name = Map()
    let fns_sl = node_params(program)
    if fns_sl != -1 {
        let mut i = 0
        while i < sublist_length(fns_sl) {
            let fn_node = sublist_get(fns_sl, i)
            nr_record_decl(node_name(fn_node), node_module(fn_node), fn_node)
            i = i + 1
        }
    }
    let types_sl = node_fields(program)
    if types_sl != -1 {
        let mut i = 0
        while i < sublist_length(types_sl) {
            let td = sublist_get(types_sl, i)
            let mod_name = node_module(td)
            nr_record_decl(node_name(td), mod_name, td)
            let flds = node_fields(td)
            if flds != -1 && sublist_length(flds) > 0 {
                if node_kind(sublist_get(flds, 0)) == NodeKind.TypeVariant {
                    let mut vi = 0
                    while vi < sublist_length(flds) {
                        nr_record_decl(node_name(sublist_get(flds, vi)), mod_name, sublist_get(flds, vi))
                        vi = vi + 1
                    }
                }
            }
            i = i + 1
        }
    }
    let traits_sl = node_arms(program)
    if traits_sl != -1 {
        let mut i = 0
        while i < sublist_length(traits_sl) {
            let tr = sublist_get(traits_sl, i)
            nr_record_decl(node_name(tr), node_module(tr), tr)
            i = i + 1
        }
    }
    let lets_sl = node_stmts(program)
    if lets_sl != -1 {
        let mut i = 0
        while i < sublist_length(lets_sl) {
            let l = sublist_get(lets_sl, i)
            nr_record_decl(node_name(l), node_module(l), l)
            i = i + 1
        }
    }
}

// One name a module-scope declaration binds, in the namespace it binds it in. `binder` is the
// pattern leaf a destructuring `let` binds it with, else -1.
type ModuleDeclName {
    namespace: Str
    name: Str
    decl: Int
    binder: Int
}

// Module scope has two namespaces (sections/02_syntax.md §2.12.1): values (`let`, `let mut`,
// `const`, `fn`) and types (`type`, alias, `trait`, `effect`). Each declaration after the
// first of one name in one namespace of one module is DuplicateModuleBinding (E1016). The
// later ones leave the program here, before anything registers, so every pass binds the name
// to the first. That is recovery, not a winner, so the name is also poisoned: a use that fits
// only a later declaration reports nothing more.
fn nr_check_duplicate_declarations(program: Int) ! Diag.Report {
    for mod_name in nr_module_names.keys() { nr_module_names_of(mod_name).poisoned.clear() }
    // Node ids give source order: a file's top-level declarations are built one after the
    // other, files parse in turn, and a pattern builds its leaves left to right.
    let mut by_order: Map[Int, ModuleDeclName] = Map()
    for d in nr_module_decl_names(program) {
        by_order.insert(if d.binder != -1 { d.binder } else { d.decl }, d)
    }
    let mut firsts: Map[Str, ModuleDeclName] = Map()
    let mut dropped: Map[Int, Int] = Map()
    for order in by_order.keys().sort() {
        let d = by_order.get(order).unwrap()
        let mod_name = node_module(d.decl)
        let key = "{d.namespace}|{mod_name}|{d.name}"
        let first = match firsts.get(key) {
            Some(f) => f
            None => {
                firsts.insert(key, d)
                continue
            }
        }
        let (line, col) = nr_decl_name_at(d)
        let (first_line, first_col) = nr_decl_name_at(first)
        let first_node = if first.binder != -1 { first.binder } else { first.decl }
        diag_error_span_at_notes("DuplicateModuleBinding", DUPLICATE_MODULE_BINDING,
            "`{d.name}` is declared twice in module `{tc_module_display_name(mod_name)}`",
            if d.binder != -1 { d.binder } else { d.decl }, line, col, col + d.name.byte_len(),
            "rename one of the two declarations",
            ["first declared at {diag_file_for_node(first_node)}:{first_line}:{first_col}"])
        nr_module_names_of(mod_name).poisoned.insert("{d.namespace}|{d.name}", first_node)
        // A destructuring `let` stays while it binds a name of its own.
        if d.binder == -1 { dropped.insert(d.decl, 1) }
    }
    if dropped.len() == 0 { return }
    node_set_params(program, nr_sublist_without(node_params(program), dropped))
    node_set_stmts(program, nr_sublist_without(node_stmts(program), dropped))
    node_set_fields(program, nr_sublist_without(node_fields(program), dropped))
    node_set_arms(program, nr_sublist_without(node_arms(program), dropped))
    node_set_args(program, nr_sublist_without(node_args(program), dropped))
}

// Every name the program's module-scope declarations bind, each in its namespace.
fn nr_module_decl_names(program: Int) -> List[ModuleDeclName] {
    let mut out: List[ModuleDeclName] = []
    for (sl, namespace) in [(node_params(program), "value"), (node_stmts(program), "value"),
        (node_fields(program), "type"), (node_arms(program), "type"), (node_args(program), "type")] {
        if sl == -1 { continue }
        let mut i = 0
        while i < sublist_length(sl) {
            let decl = sublist_get(sl, i)
            let leaves = if node_kind(decl) == NodeKind.LetBinding { tc_module_let_leaves(decl) } else { [] }
            if leaves.len() == 0 {
                // `let _ = e` binds nothing, so any number of them may stand in one module.
                if node_name(decl) != "" { out.push(ModuleDeclName { namespace: namespace, name: node_name(decl), decl: decl, binder: -1 }) }
            }
            for leaf in leaves {
                if node_name(leaf) != "_" && node_name(leaf) != "" {
                    out.push(ModuleDeclName { namespace: namespace, name: node_name(leaf), decl: decl, binder: leaf })
                }
            }
            i = i + 1
        }
    }
    out
}

// The line and column where `d` writes its name. A pattern leaf stands at its name. Any other
// declaration starts at its keyword, so the name is the first whole word that spells it on
// the declaration's first line, at or after the keyword; the keyword's own place when the
// line does not hold it.
fn nr_decl_name_at(d: ModuleDeclName) -> (Int, Int) {
    if d.binder != -1 { return (node_line(d.binder), node_col(d.binder)) }
    let line = node_line(d.decl)
    let text = diag_source_line(diag_file_for_node(d.decl), line)
    let mut from = if node_col(d.decl) > 0 { node_col(d.decl) - 1 } else { 0 }
    while from < text.byte_len() {
        match text.byte_index_of(d.name, from) {
            Some(at) => {
                let end = at + d.name.byte_len()
                let starts_word = at == 0 || !nr_is_ident_byte(text.byte_at(at - 1).to_int())
                let ends_word = end >= text.byte_len() || !nr_is_ident_byte(text.byte_at(end).to_int())
                if starts_word && ends_word { return (line, at + 1) }
                from = at + 1
            }
            None => return (line, node_col(d.decl))
        }
    }
    (line, node_col(d.decl))
}

fn nr_is_ident_byte(b: Int) -> Bool {
    (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 95
}

// The members of `sl` that `dropped` does not hold, as a new sublist; -1 stays -1.
fn nr_sublist_without(sl: Int, dropped: Map[Int, Int]) -> Int {
    if sl == -1 { return -1 }
    let mut kept: List[Int] = []
    let mut i = 0
    while i < sublist_length(sl) {
        let m = sublist_get(sl, i)
        if !dropped.contains_key(m) { kept.push(m) }
        i = i + 1
    }
    sublist_of(kept)
}

// Whether `mod_name` declares `name` more than once in `namespace` (E1016).
fn nr_poisoned(mod_name: Str, namespace: Str, name: Str) -> Bool {
    match nr_module_names.get(mod_name) {
        Some(r) => r.poisoned.contains_key("{namespace}|{name}")
        None => false
    }
}

// Whether `decl` is the module-scope type declaration (type, alias, trait, effect) a module
// keeps of a name it declares more than once (E1016).
fn tc_type_decl_poisoned(decl: Int) -> Bool {
    nr_poisoned_first(decl, "type")
}

// Whether `decl` is the module-scope value declaration (fn, let, const) a module keeps of a
// name it declares more than once (E1016).
fn tc_value_decl_poisoned(decl: Int) -> Bool {
    nr_poisoned_first(decl, "value")
}

// Whether the type a written name means is one its module declares more than once (E1016).
fn tc_type_name_poisoned(name: Str) -> Bool {
    tc_type_decl_poisoned(tc_decl_node_for_type(tc_written_type_nominal(name)))
}

// Whether the trait a trait key names is one its module declares more than once (E1016).
fn tc_trait_key_poisoned(key: Str) -> Bool {
    tc_type_decl_poisoned(tc_trait_node_idx.get(key) ?? -1)
}

fn nr_poisoned_first(decl: Int, namespace: Str) -> Bool {
    if decl < 0 { return false }
    match nr_module_names.get(node_module(decl)) {
        Some(r) => (r.poisoned.get("{namespace}|{node_name(decl)}") ?? -1) == decl
        None => false
    }
}

fn nr_record_decl(name: Str, mod_name: Str, decl_node: Int) {
    nr_module_names_of(mod_name).decls.insert(name, decl_node)
    let mut seen = nr_decls_by_name.get(name) ?? []
    seen.push(decl_node)
    nr_decls_by_name.insert(name, seen)
}

fn nr_module_declares(mod_name: Str, name: Str) -> Int {
    match nr_module_names.get(mod_name) {
        Some(r) => if r.decls.contains_key(name) { 1 } else { 0 }
        None => 0
    }
}

// ── The declaration a call resolved to ──────────────────────────────
//
// Name resolution already decides this and used to discard it, leaving every later stage to
// re-derive it from the spelling. The spelling does not carry the answer: two modules may
// declare it, and only the calling file's import list says which one it reached.
let mut tc_call_decl: Map[Int, Int] = Map()

// The declaration node this call resolved to, or -1 for a callee that is not a declaration:
// a closure value, a builtin, an intrinsic.
pub fn tc_call_decl_node(call_node: Int) -> Int {
    tc_call_decl.get(call_node) ?? -1
}

// The name the declaration a bare call reaches was written under. An import may rename what
// it brings in, and every table after name resolution is keyed on the declaration's own name.
// A callee that reached no declaration keeps its spelling.
pub fn tc_call_declared_name(call_node: Int) -> Str {
    let decl = tc_call_decl_node(call_node)
    if decl >= 0 { return node_name(decl) }
    node_name(node_left(call_node))
}

// The name a bare callee spelling stands for before name resolution has recorded what the call
// reaches: the declaration an import alias of the module under check renames, else the
// spelling itself.
fn tc_unresolved_callee_name(written: Str) -> Str {
    let decl = tc_aliased_callee_decl(written)
    if decl >= 0 { node_name(decl) } else { written }
}

// The declaration a bare callee spelling reaches through an import alias in the module under
// check, or -1. A local of that spelling shadows the import.
fn tc_aliased_callee_decl(written: Str) -> Int {
    if nr_index_is_local(nr_name_top.get(written) ?? -1) { return -1 }
    nr_alias_decl_here(written)
}

// The signature a bare callee spelling names in the module under check. An alias names the
// declaration its import reaches; reading the original spelling instead would find this
// module's own namesake first.
fn tc_bare_callee_sig(written: Str) -> Int {
    let aliased = tc_aliased_callee_decl(written)
    if aliased >= 0 { return fnsig_by_decl.get(aliased) ?? -1 }
    lookup_fnsig(written)
}

// The return type a declaration's signature carries, or -1 for a node that registered none.
// A call site inside a generic instance reads a callee's answer here: the callee's own
// annotation node belongs to no instance, so no instance holds a type for it.
pub fn tc_decl_ret_tid(decl: Int) -> Int {
    match fnsig_by_decl.get(decl) {
        Some(idx) => fnsig_pool.get(idx).unwrap().ret
        None => -1
    }
}

// Whether this call resolved to an ordinary fn declaration, the one shape a builtin's
// spelling must yield to (sections/07_trust_modules_metadata.md, "Shadowing Rules"). A
// bare variant or builtin-type call resolves too, but to a TypeVariant, not a FnDef.
pub fn tc_call_decl_is_fn(call_node: Int) -> Bool {
    let decl = tc_call_decl_node(call_node)
    decl >= 0 && node_kind(decl) == NodeKind.FnDef
}

fn nr_note_call_decl(call_node: Int, decl_node: Int) {
    if decl_node < 0 { return }
    tc_call_decl.insert(call_node, decl_node)
}

// ── The declaration a bare global read resolved to ──────────────────
//
// The same fact as the call record above, for a read instead of a call. A module-scope
// `let` is a C global, and the spelling alone does not say which one a read means: two
// modules may each declare a private global under one name, so a later stage that searches
// by the spelling finds both and picks by table order — reading the wrong module's value
// with no diagnostic at all. A top-level function named as a value is the same fact, kept in
// the same record: the declaration's kind tells the two apart, and a reader of the global
// answer takes the name for a C global, which a function is not.
let mut tc_global_read_decl: Map[Int, Int] = Map()

// The module-scope `let` this ident read resolved to, or -1 when the ident is not a read of
// a global: a local, a parameter, a function name, a builtin.
pub fn tc_global_decl_node(ident_node: Int) -> Int {
    let decl = tc_global_read_decl.get(ident_node) ?? -1
    if decl < 0 || node_kind(decl) != NodeKind.LetBinding { return -1 }
    decl
}

fn nr_note_global_decl(ident_node: Int, decl_node: Int) {
    if decl_node < 0 { return }
    if node_kind(decl_node) != NodeKind.LetBinding { return }
    tc_global_read_decl.insert(ident_node, decl_node)
}

// The function declaration this ident read names as a value, or -1.
pub fn tc_fn_value_decl_node(ident_node: Int) -> Int {
    let decl = tc_global_read_decl.get(ident_node) ?? -1
    if decl < 0 || node_kind(decl) != NodeKind.FnDef { return -1 }
    decl
}

fn nr_note_fn_value_decl(ident_node: Int, decl_node: Int) {
    if decl_node < 0 { return }
    if node_kind(decl_node) != NodeKind.FnDef { return }
    tc_global_read_decl.insert(ident_node, decl_node)
}

// ── The local binder a read resolved to ─────────────────────────────
//
// The binder node, not the spelling, is a local's identity: two nested blocks may each bind
// `s`, and a later pass that looks the name up again cannot tell which one a read meant.
let mut tc_local_binder: Map[Int, Int] = Map()

// The node that bound the local, parameter or pattern name this ident reads, or -1 when the
// ident reads a global, a function, a builtin, or a binder that recorded no node.
pub fn tc_ident_binder_node(ident_node: Int) -> Int {
    tc_local_binder.get(ident_node) ?? -1
}

fn nr_note_local_binder(ident_node: Int, name: Str) {
    nr_note_local_binder_at(ident_node, nr_top_index(name))
}

// nr_note_local_binder for a binding already looked up; `idx` is -1 when nothing binds the name.
fn nr_note_local_binder_at(ident_node: Int, idx: Int) {
    if idx == -1 { return }
    if nr_index_is_global(idx) != 0 { return }
    let binder = nr_scope_nodes.get(idx).unwrap()
    if binder < 0 { return }
    tc_local_binder.insert(ident_node, binder)
}

// A bare type name that two of a file's selective imports both answer for. A file that
// selects the same name from two declaring modules has written nothing that says which
// declaration it means, so binding one makes the meaning depend on registration order
// (spec sections/07_trust_modules_metadata.md, ambiguous import). Reported per READING
// module, not against the entry file, because the file that selected both owns the choice.
fn tc_check_namesake_import_ambiguity() ! Diag.Report {
    if tc_namesake_type_modules.len() == 0 { return }
    for reader in per_module_imports.keys() {
        for bare in tc_namesake_type_modules.keys() {
            let mods = tc_namesake_type_modules.get(bare) ?? ""
            // A module's own declaration wins outright, so it is never asked to choose.
            if mods.contains("|{reader}|") != 0 { continue }
            let mut hits = 0
            let mut first = ""
            let mut second = ""
            for source_mod in mods.split("|") {
                if source_mod == "" { continue }
                if is_selected_import(bare, reader, source_mod) == 0 { continue }
                hits = hits + 1
                if hits == 1 { first = source_mod } else { second = source_mod }
            }
            if hits > 1 {
                let site = if tc_module_key_is_main(reader) != 0 { "" } else { " in module `{reader}`" }
                diag_error_no_loc("AmbiguousImport", AMBIGUOUS_IMPORT, "type `{bare}` is ambiguous{site} — selected from both `{first}` and `{second}`", "name the declaration you mean, e.g. `{first}.{bare}`")
            }
        }
    }
}

// Two selective imports in one file that bind one spelling to different declarations, where
// at least one of them renames (sections/07, "Imported Names": the check uses the name after
// `as`). An alias is bound only in its own file, so no program-wide table sees the clash;
// two plain selections of one spelling are reported by nr_check_ambiguity instead.
fn tc_check_renamed_import_conflicts() ! Diag.Report {
    for reader in per_module_imports.keys() {
        for spelling in nr_module_import_index(reader).keys() {
            let clash = nr_renamed_import_clash(reader, spelling)
            if clash.0 == "" { continue }
            let site = if tc_module_key_is_main(reader) != 0 { "" } else { " in module `{reader}`" }
            diag_error_no_loc("AmbiguousImport", AMBIGUOUS_IMPORT, "`{spelling}` is imported twice{site}, from `{clash.0}` and from `{clash.1}`", "import one under another name, or drop it from the list and use the qualified path")
        }
    }
}

// The two source modules of the first pair of `reader`'s imports that bind `spelling` to
// different declarations when one of them renames, else ("", "").
fn nr_renamed_import_clash(reader: Str, spelling: Str) -> (Str, Str) {
    let binds = nr_module_import_index(reader).get(spelling) ?? []
    let mut renames = false
    for b in binds {
        if b.member != spelling { renames = true }
    }
    if !renames { return ("", "") }
    nr_imports_disagree(reader, spelling)
}

// The two source modules of the first pair of `reader`'s imports that bind `spelling` to
// different declarations, else ("", "").
fn nr_imports_disagree(reader: Str, spelling: Str) -> (Str, Str) {
    let binds = nr_module_import_index(reader).get(spelling) ?? []
    if binds.len() < 2 { return ("", "") }
    let mut first = -1
    let mut first_mod = ""
    for b in binds {
        let hit = nr_resolve_decl_in_module(b.source_mod, b.member, 0)
        if hit == -1 { continue }
        if first == -1 {
            first = hit
            first_mod = b.source_mod
        } else if hit != first {
            return (first_mod, b.source_mod)
        }
    }
    ("", "")
}

// The declaration a selective import in `consuming_mod` binds to the spelling `name`: the
// alias of a renaming import, or else the selected name itself. The source may be a facade
// that only re-exports it, so the lookup follows the re-export to the module that wrote it.
fn nr_resolve_imported_decl(name: Str, consuming_mod: Str) -> Int {
    if name == "" { return -1 }
    if consuming_mod == "" { return -1 }
    let binds = match nr_module_import_index(consuming_mod).get(name) {
        Some(b) => b
        None => return -1
    }
    // The answer does not depend on the order the imports are visited in: a second hit
    // either names the declaration already found or settles nothing.
    let mut found = -1
    for b in binds {
        let hit = nr_resolve_decl_in_module(b.source_mod, b.member, 0)
        // Two imports binding one spelling to different declarations settle nothing.
        if hit != -1 && found != -1 && hit != found { return -1 }
        if hit != -1 { found = hit }
    }
    found
}

// Which declaration of `name` the bare spelling means inside `consuming_mod`.
fn nr_resolve_bare_decl(name: Str, consuming_mod: Str) -> Int {
    let mut answers = nr_module_names_of(consuming_mod).bare_decl
    match answers.get(name) {
        Some(d) => d
        None => {
            let d = nr_find_bare_decl(name, consuming_mod)
            answers.insert(name, d)
            d
        }
    }
}

fn nr_find_bare_decl(name: Str, consuming_mod: Str) -> Int {
    let cands = nr_decls_by_name.get(name) ?? []
    // A module's own declaration wins over any import, so it is asked for first. Among its
    // own, a value comes before a variant of the same spelling (sections/03_types.md §3.4).
    let mut own = -1
    for c in cands {
        if node_module(c) == consuming_mod {
            let k = node_kind(c)
            if k == NodeKind.FnDef || k == NodeKind.LetBinding { return c }
            if own == -1 { own = c }
        }
    }
    if own != -1 { return own }
    // A selective import is this file's own binding for the spelling, so it outranks whatever
    // other modules declare under it. It is also the only way an alias or a name selected
    // from a facade resolves, since the declaration sits under another spelling or module.
    let imported = nr_resolve_imported_decl(name, consuming_mod)
    if imported != -1 { return imported }
    // Imports that disagree settle the spelling as ambiguous, which is reported once; a third
    // module's declaration of it is not what this file means.
    if nr_imports_disagree(consuming_mod, name).0 != "" { return -1 }
    if cands.len() == 0 { return -1 }
    let mut found = -1
    let mut hits = 0
    for c in cands {
        if is_filtered_for_module(name, node_module(c), consuming_mod) == 0 {
            found = c
            hits = hits + 1
        }
    }
    if hits == 1 { return found }
    -1
}

// The declaration a bare CALL name reaches. One spelling can name an enum and an arm of that
// enum at once (`type Errno { Errno(Int) }`), and a search by the spelling alone answers
// whichever of the two was recorded first -- so which one a call means is said here instead.
// A call means the arm: a type declares no callable of its own name, and a later stage handed
// the type would spell the type's name as a callee nothing declares.
fn nr_resolve_bare_call_decl(name: Str, consuming_mod: Str) -> Int {
    let d = nr_resolve_bare_decl(name, consuming_mod)
    if d < 0 { return d }
    if node_kind(d) != NodeKind.TypeDef { return d }
    let arm = nr_same_named_arm(d, name)
    if arm >= 0 { arm } else { d }
}

// The arm of this type declaration spelled exactly as the declaration itself.
fn nr_same_named_arm(td: Int, name: Str) -> Int {
    let flds = node_fields(td)
    if flds == -1 { return -1 }
    let mut i = 0
    while i < sublist_length(flds) {
        let f = sublist_get(flds, i)
        if node_kind(f) == NodeKind.TypeVariant && node_name(f) == name { return f }
        i = i + 1
    }
    -1
}

// The declaration `member` names inside `target`, following any `pub import` that re-exports
// it. A facade module holds no declaration of its own: the re-export makes the name reachable
// under the facade's qualifier while the declaration stays in the module that wrote it.
fn nr_resolve_decl_in_module(target: Str, member: Str, depth: Int) -> Int {
    let direct = nr_module_decl(target, member)
    if direct != -1 { return direct }
    if depth >= 8 { return -1 }
    for src in nr_reexport_sources(target, member) {
        let hit = nr_resolve_decl_in_module(src, member, depth + 1)
        if hit != -1 { return hit }
    }
    -1
}

// The modules a `pub import` in `target` forwards `member` from: a named re-export first,
// then each wildcard one.
fn nr_reexport_sources(target: Str, member: Str) -> List[Str] {
    let mut out: List[Str] = []
    match tc_reexport_source.get("{target}:{member}") {
        Some(src) => out.push(src)
        None => {}
    }
    let wildcard_prefix = "{target}:*:"
    for key in tc_reexport_source.keys() {
        if key.starts_with(wildcard_prefix) == 0 { continue }
        out.push(key.byte_slice(wildcard_prefix.byte_len(), key.byte_len()))
    }
    out
}

// A module qualifier settles the module before any name is looked up, so an alias another
// file bound to the same spelling has nothing to say here.
fn nr_resolve_qualified_decl(qualifier: Str, member: Str) -> Int {
    let here = nr_qualifier_module_here(qualifier)
    let target = if here != "" { here } else { tc_qualifier_to_module.get(qualifier) ?? qualifier }
    nr_resolve_decl_in_module(target, member, 0)
}

// Whether this file's own import list reaches any declaration of the bare `name`. The
// declarations answer this, not tc_symbol_module: that table holds one module per name and
// a `pub import` re-export overwrites it, so it can name a module that only forwards the
// declaration while the importing file selected the module that owns it.
fn nr_bare_name_in_scope_here(name: Str, consuming_mod: Str) -> Int {
    let cands = nr_decls_by_name.get(name) ?? []
    for c in cands {
        if node_module(c) == consuming_mod { return 1 }
        if is_filtered_for_module(name, node_module(c), consuming_mod) == 0 { return 1 }
    }
    // An alias or a name selected from a facade binds the spelling too, and neither names the
    // declaring module, so the candidate list above can never answer for one.
    if nr_resolve_imported_decl(name, consuming_mod) != -1 { return 1 }
    0
}

// A name is ambiguous only where two declarations of it are both in a file's bare scope. A
// selective import names one of them, which settles the question the clash was asking.
fn nr_ambiguity_settled_by_import(name: Str) -> Int {
    let cands = nr_decls_by_name.get(name) ?? []
    if cands.len() == 0 { return 0 }
    let mut hits = 0
    for c in cands {
        if is_filtered_for_module(name, node_module(c), "__main__") == 0 { hits = hits + 1 }
    }
    if hits <= 1 { 1 } else { 0 }
}

// True when `name` is declared in `source_mod` without a pub declaration anywhere, so no
// import can select it and no qualifier can reach it.
fn nr_is_private_in(name: Str, source_mod: Str) -> Int {
    match nr_private_imports.get(name) {
        Some(mods) => if mods.contains("|{source_mod}|") != 0 { 1 } else { 0 }
        None => 0
    }
}

fn nr_check_ambiguity(name: Str, mod_name: Str, local_names: Map[Str, Int]) ! Diag.Report {
    if mod_name == "" || mod_name == "__main__" { return }
    if nr_private_imports.contains_key(name) { return }
    if local_names.contains_key(name) { return }
    match nr_name_source_module.get(name) {
        Some(existing_mod) => {
            if existing_mod != mod_name && existing_mod != "__main__" && nr_ambiguity_settled_by_import(name) == 0 {
                diag_error_no_loc("AmbiguousImport", AMBIGUOUS_IMPORT, "name `{name}` is ambiguous — imported from both `{existing_mod}` and `{mod_name}`", "use selective imports to disambiguate, e.g. import {existing_mod}.\{name}")
            }
        }
        None => nr_name_source_module.insert(name, mod_name)
    }
}

// Whether a QUALIFIED access reaches a private declaration. The question is about the
// module the qualifier names, not about the reader: a reader that declares its own non-pub
// namesake still cannot see the other module's.
fn nr_qualified_private_access(qualifier: Str, name: Str) -> Int {
    if is_builtin_name(name) != 0 { return 0 }
    let here = nr_qualifier_module_here(qualifier)
    let target = if here != "" { here } else { tc_qualifier_to_module_or_self(qualifier) }
    if target == nr_current_module { return 0 }
    nr_is_private_in(name, target)
}

// The module the reading module's own imports bind `qualifier` to, or "" when none does
// (section 10.1). A module's own qualifier names it too. A reader with no module recorded has
// no import list to ask, so any module the program imports answers for it.
fn nr_qualifier_module_here(qualifier: Str) -> Str {
    nr_qualifier_module_in(qualifier, nr_current_module)
}

fn nr_qualifier_module_in(qualifier: Str, reader: Str) -> Str {
    if reader == "" {
        return if is_import_module_name(qualifier) != 0 { tc_qualifier_to_module_or_self(qualifier) } else { "" }
    }
    if tc_qualifier_for_module(reader) == qualifier { return reader }
    nr_module_imports_built(reader).qualifiers.get(qualifier) ?? ""
}

// The fix for a qualifier the reading module does not import. A module another file imports
// is named by the import that would bind it here.
fn nr_missing_import_help(qualifier: Str) -> Str {
    if is_import_module_name(qualifier) == 0 { return "" }
    "this file does not import `{qualifier}`: add `import {tc_get_dotted_module_path(tc_qualifier_to_module_or_self(qualifier))}`"
}

fn is_private_access(name: Str) -> Int {
    let mut answers = nr_module_names_of(nr_current_module).private_access
    match answers.get(name) {
        Some(v) => v
        None => {
            let v = nr_private_access_here(name)
            answers.insert(name, v)
            v
        }
    }
}

fn nr_private_access_here(name: Str) -> Int {
    // Builtin names (primitive types + builtin fns/variants like Ok/Err/Some/Map)
    // can never be private — a user cannot make a builtin private, so a colliding
    // user variant must not poison the verdict. Mirrors nr_check_selective_access.
    if is_builtin_name(name) != 0 { return 0 }
    let mods = match nr_private_imports.get(name) {
        Some(v) => v
        None => return 0
    }
    if mods.contains("|{nr_current_module}|") != 0 { return 0 }
    1
}

// Emit E1003 PrivateItemAccess for `name` on `node`, choosing the noun
// (variant / type / trait / function) the same way the bare-Ident handler does,
// so a qualified access (mod.Name) is labelled identically to a bare one.
// Caller must have already checked is_private_access(name) != 0.
fn nr_emit_private_access(name: Str, node: Int) ! Diag.Report {
    if is_variant_name(name) != 0 {
        tc_errors.push("cannot access private variant `{name}`")
        diag_error_at("PrivateItemAccess", PRIVATE_ITEM_ACCESS, "cannot access private variant `{name}` from another module", node, "mark the enum as `pub` in its module")
    } else if is_known_type(name) != 0 {
        tc_errors.push("cannot access private type `{name}`")
        diag_error_at("PrivateItemAccess", PRIVATE_ITEM_ACCESS, "cannot access private type `{name}` from another module", node, "mark the type as `pub` in its module")
    } else if is_trait_name(name) != 0 {
        tc_errors.push("cannot access private trait `{name}`")
        diag_error_at("PrivateItemAccess", PRIVATE_ITEM_ACCESS, "cannot access private trait `{name}` from another module", node, "mark the trait as `pub` in its module")
    } else {
        tc_errors.push("cannot access private function `{name}`")
        diag_error_at("PrivateItemAccess", PRIVATE_ITEM_ACCESS, "cannot access private function `{name}` from another module", node, "mark the function as `pub` in its module")
    }
}

fn nr_register_private(name: Str, mod_name: Str) {
    // A name its module declares twice (E1016) may be public in the declaration a use meant.
    if nr_poisoned(mod_name, "value", name) || nr_poisoned(mod_name, "type", name) { return }
    match nr_private_imports.get(name) {
        Some(prev) => nr_private_imports.insert(name, "{prev}{mod_name}|")
        None => nr_private_imports.insert(name, "|{mod_name}|")
    }
}

// ── Name resolution scope ───────────────────────────────────────────

let mut nr_scope_names: List[Str] = []
let mut nr_scope_muts: List[Int] = []
let mut nr_scope_types: List[Int] = []
let mut nr_scope_reads: List[Int] = []
let mut nr_scope_writes: List[Int] = []
let mut nr_scope_nodes: List[Int] = []
// Sticky-read flag: if set, nr_mark_written won't clear the read flag. Used
// for vars captured by a closure — subsequent writes are observable through
// closure calls, so the original read shouldn't be dismissed as "dead".
let mut nr_scope_captured: List[Int] = []
// Shadow chain: nr_scope_prev[i] is the index of the previous entry with the
// same name (the one this entry shadows), or -1 if none. Lets nr_pop_scope
// restore nr_name_top to the prior binding without a linear scan.
let mut nr_scope_prev: List[Int] = []
// Top-of-stack index per name: O(1) lookup for nr_is_defined / nr_is_mut /
// nr_get_type / nr_mark_written. Keys absent ⇒ name not currently in scope.
let mut nr_name_top: Map[Str, Int] = Map()
let mut nr_scope_frames: List[Int] = []
let mut nr_scope_depth: Int = 0
let mut nr_loop_depth: Int = 0
let mut nr_in_closure_depth: Int = 0
let mut nr_with_ptr_depth: Int = 0
let mut nr_warn_unused: Int = 0
// The E0301 region-boundary check must run ONLY in the type-inference
// pass (tc_check_fn/tc_check_body), where annotations are honored (final_tid =
// declared_tid) and constraining uses have pinned their metavars. The earlier
// name-resolution pass (nr_check_fn/nr_check_node) shares nr_pop_scope but stores
// the raw *inferred* RHS type ignoring annotations — so `let m: Map[Str,Int] =
// Map()` carries an unpinned α there and would false-positive. Gate on this flag.
let mut tc_boundary_check_active: Int = 0

// Push a new entry into the parallel scope arrays and update nr_name_top.
// All nr_define* functions must route through here to keep the shadow chain
// intact. The .insert at the end overwrites any prior nr_name_top entry by
// design — we captured the displaced index in nr_scope_prev so pop can
// restore it.
fn nr_scope_push_entry(name: Str, is_mut: Int, tid: Int, node: Int) {
    let new_idx = nr_scope_names.len()
    let mut prev = -1
    match nr_name_top.get(name) {
        Some(p) => prev = p
        None => {}
    }
    nr_scope_names.push(name)
    nr_scope_muts.push(is_mut)
    nr_scope_types.push(tid)
    nr_scope_reads.push(0)
    nr_scope_writes.push(1)
    nr_scope_nodes.push(node)
    nr_scope_captured.push(0)
    nr_scope_prev.push(prev)
    nr_name_top.insert(name, new_idx)
}

// An OR-pattern binds each name once for its arm (§3.5 *OR-Patterns*). The first alternative
// binds into the arm's scope as any pattern does. Each later one binds into a frame of its own,
// with no shadow warning, and nr_or_alt_close then keeps only the names no earlier alternative
// bound: a name bound again is the same binding, so the arm sees one entry, warned about once.
fn nr_or_alt_open() -> Int {
    let saved_warn = nr_warn_unused
    nr_warn_unused = 0
    nr_push_scope()
    saved_warn
}

// Closes the frame nr_or_alt_open began, for an OR-pattern whose entries begin at `or_start`.
// Answers the scope index of each name it keeps, for the caller's shadow check.
fn nr_or_alt_close(or_start: Int, saved_warn: Int) -> List[Int] {
    let frame = nr_scope_frames.get(nr_scope_frames.len() - 1).unwrap()
    let mut names: List[Str] = []
    let mut muts: List[Int] = []
    let mut tids: List[Int] = []
    let mut nodes: List[Int] = []
    let mut i = frame
    while i < nr_scope_names.len() {
        let nm = nr_scope_names.get(i).unwrap()
        let mut bound = false
        let mut j = or_start
        while j < frame {
            if nr_scope_names.get(j).unwrap() == nm { bound = true }
            j = j + 1
        }
        if !bound {
            names.push(nm)
            muts.push(nr_scope_muts.get(i).unwrap())
            tids.push(nr_scope_types.get(i).unwrap())
            nodes.push(nr_scope_nodes.get(i).unwrap())
        }
        i = i + 1
    }
    while nr_scope_names.len() > frame {
        let idx = nr_scope_names.len() - 1
        let prev = nr_scope_prev.get(idx).unwrap()
        if prev == -1 {
            nr_name_top.remove(nr_scope_names.get(idx).unwrap())
        } else {
            nr_name_top.insert(nr_scope_names.get(idx).unwrap(), prev)
        }
        nr_scope_names.pop()
        nr_scope_muts.pop()
        nr_scope_types.pop()
        nr_scope_reads.pop()
        nr_scope_writes.pop()
        nr_scope_nodes.pop()
        nr_scope_captured.pop()
        nr_scope_prev.pop()
    }
    nr_scope_frames.pop()
    nr_scope_depth = nr_scope_depth - 1
    nr_warn_unused = saved_warn
    let mut kept: List[Int] = []
    i = 0
    while i < names.len() {
        kept.push(nr_scope_names.len())
        nr_scope_push_entry(names.get(i).unwrap(), muts.get(i).unwrap(), tids.get(i).unwrap(), nodes.get(i).unwrap())
        i = i + 1
    }
    kept
}

// A scope entry no source name can spell, pushed for the body of a `with` that has an item
// without `as`. While it is in scope, an undefined name gets a help line to bind one.
let NR_ITEM_WITHOUT_AS = " with item without as"

fn nr_push_scope() {
    nr_scope_frames.push(nr_scope_names.len())
    nr_scope_depth = nr_scope_depth + 1
}

fn nr_pop_scope() ! Diag.Report {
    if nr_scope_frames.len() == 0 {
        return
    }
    let start = nr_scope_frames.get(nr_scope_frames.len() - 1).unwrap()
    nr_scope_frames.pop()
    let emit_unused = nr_warn_unused != 0 && nr_scope_depth > 1
    // Fused loop: emit unused-variable warnings AND restore nr_name_top AND
    // pop the parallel arrays in a single back-to-front pass over [start, len).
    while nr_scope_names.len() > start {
        let idx = nr_scope_names.len() - 1
        let nm = nr_scope_names.get(idx).unwrap()
        if emit_unused {
            if nr_scope_reads.get(idx).unwrap() == 0 && nm.len() > 0 && nm.byte_at(0) != 95 { // '_'
                let nd = nr_scope_nodes.get(idx).unwrap()
                if nd != -1 {
                    if nr_scope_writes.get(idx).unwrap() > 1 {
                        diag_warn_at("SetButNotRead", SET_BUT_NOT_READ, "variable `{nm}` is assigned a value that is never read", nd, "remove the unused assignment, or prefix with `_` to suppress")
                    } else {
                        diag_warn_at("UnusedVariable", UNUSED_VARIABLE, "variable `{nm}` is never read", nd, "prefix with `_` to suppress this warning")
                    }
                }
            }
        }
        // Region boundary: the scope is closing in the INFERENCE pass and
        // every constraining use in it has already run (tc_check_body is a single
        // interleaved walk), so a binding still carrying an unbound metavar is
        // genuinely under-determined → error[CannotInferType] (E0301). Gated on
        // tc_boundary_check_active so the earlier annotation-blind name-resolution
        // pass never fires it. The shared singleton TYPE_UNKNOWN never trips this
        // (tc_is_unbound_metavar excludes it), so only unpinned empty-ctor bindings
        // are reported.
        //
        // "Every constraining use has already run" depends on a fn body's IMPLICIT
        // TAIL being pinned before this pop: the declared return type is a
        // constraining use (sections/03_types.md:1031), and tc_check_body's Block arm
        // must apply it before reaching here, or this check would report E0301 on
        // bindings the declared return would have solved. Any future constraint
        // source for a fn body must land on that same side of this line.
        if tc_boundary_check_active != 0 {
            let ud_tid = nr_scope_types.get(idx).unwrap()
            if tc_tid_has_unbound_metavar(ud_tid) != 0 {
                tc_ud_judge_binder(nm, ud_tid, nr_scope_nodes.get(idx).unwrap())
            }
        }
        let prev = nr_scope_prev.get(idx).unwrap()
        if prev == -1 {
            nr_name_top.remove(nm)
        } else {
            nr_name_top.insert(nm, prev)
        }
        nr_scope_names.pop()
        nr_scope_muts.pop()
        nr_scope_types.pop()
        nr_scope_reads.pop()
        nr_scope_writes.pop()
        nr_scope_nodes.pop()
        nr_scope_captured.pop()
        nr_scope_prev.pop()
    }
    nr_scope_depth = nr_scope_depth - 1
}

fn nr_define(name: Str) {
    nr_scope_push_entry(name, 0, TYPE_UNKNOWN, -1)
}

fn nr_check_shadow(name: Str, node: Int) ! Diag.Report {
    if nr_warn_unused == 0 { return }
    if name.len() == 0 { return }
    if name.byte_at(0) == 95 { return } // '_'
    if nr_scope_depth <= 1 { return }
    if nr_scope_frames.len() == 0 { return }
    let frame_start = nr_scope_frames.get(nr_scope_frames.len() - 1).unwrap()
    // Walk the shadow chain from the newest entry back to the first one
    // that lives outside this frame — that's the shadowed outer binding.
    let mut idx = -1
    match nr_name_top.get(name) {
        Some(t) => idx = t
        None => return
    }
    while idx >= frame_start {
        idx = nr_scope_prev.get(idx).unwrap()
        if idx == -1 { return }
    }
    // A local binding that "shadows" a same-named top-level symbol from a
    // DIFFERENT module is not a real lexical shadow — it's a cross-module name
    // collision (e.g. a stdlib param colliding with a user's top-level free
    // fn). Suppress W0603 only in that case. A genuine same-module
    // top-level shadow (a function-local rebinding a module-level let/fn) still
    // warns.
    if nr_scope_frames.len() >= 2 {
        let first_inner = nr_scope_frames.get(1).unwrap()
        if idx < first_inner {
            let sym_mod = tc_get_symbol_module(name)
            if sym_mod != "" && sym_mod != nr_current_module { return }
            // User top-level symbols (module __main__) are intentionally never
            // recorded in tc_symbol_module (see the mod_name != "__main__" guards
            // at registration), so their module reads back as "". When we're
            // checking inside a real non-main module body (e.g. a stdlib fn's
            // closure param), an unknown outer-symbol module can only be a
            // user/__main__ global — a DIFFERENT module from the current one, so
            // it's the same cross-module collision, not a lexical shadow. Suppress.
            if sym_mod == "" && nr_current_module != "" && nr_current_module != "__main__" { return }
        }
    }
    diag_warn_at("ShadowedVariable", SHADOWED_VARIABLE, "variable `{name}` shadows a variable from an outer scope", node, "rename the variable or prefix with `_` to suppress")
}

fn nr_define_at(name: Str, node: Int) ! Diag.Report {
    if node != -1 && nr_current_module != "" {
        node_set_module(node, nr_current_module)
    }
    nr_check_shadow(name, node)
    nr_scope_push_entry(name, 0, TYPE_UNKNOWN, node)
}

fn nr_define_mut(name: Str, is_mut: Int) {
    nr_scope_push_entry(name, is_mut, TYPE_UNKNOWN, -1)
}

fn nr_define_mut_at(name: Str, is_mut: Int, node: Int) ! Diag.Report {
    if node != -1 && nr_current_module != "" {
        node_set_module(node, nr_current_module)
    }
    nr_check_shadow(name, node)
    nr_scope_push_entry(name, is_mut, TYPE_UNKNOWN, node)
}

// Records the binding's decl node so E0301's region-boundary check has a span to
// point the diagnostic at. EVERY binder class passes its own real node: which of
// them is judged at its scope close and which defers to the end-of-pass flush is
// decided in one place, tc_ud_judge_binder, from the node's kind. A call site that
// withheld the node made its whole binder class unreportable, so the policy lived in
// fifteen call sites instead of one.
fn nr_define_typed(name: Str, is_mut: Int, tid: Int, node: Int) {
    nr_scope_push_entry(name, is_mut, tid, node)
}

fn nr_is_defined(name: Str) -> Int {
    let i = nr_top_index(name)
    if i == -1 { return 0 }
    nr_mark_read_at(i)
    1
}

// The scope index of the binding `name` reads here, or -1 when nothing binds it. A reference
// that asks several questions of its binding looks the name up once here and asks the rest by
// index, since each lookup by name hashes and compares the whole spelling again.
fn nr_top_index(name: Str) -> Int {
    let top = nr_name_top.get(name) ?? -1
    if nr_index_is_local(top) { return top }
    // An alias is bound only in the file whose import writes it, so the shared frame holds
    // no entry under it: it reads the entry of the declaration it renames.
    let aliased = nr_alias_decl_here(name)
    if aliased >= 0 { return nr_global_index_of_decl(aliased) }
    if top == -1 { return -1 }
    nr_module_global_index(name, top)
}

// Whether the scope entry `idx` is a binding inside a function, which no import can shadow.
fn nr_index_is_local(idx: Int) -> Bool {
    idx != -1 && nr_index_is_global(idx) == 0
}

// The outermost-frame entry that holds `decl` under its own name, or -1. Only a function or a
// module-level binding has one. Name resolution files a function, and every global before
// inference reaches it, with no node, and those node-less entries of one name are
// interchangeable; an entry that carries another node belongs to another declaration.
fn nr_global_index_of_decl(decl: Int) -> Int {
    let k = node_kind(decl)
    if k != NodeKind.FnDef && k != NodeKind.LetBinding { return -1 }
    let top = nr_name_top.get(node_name(decl)) ?? -1
    let own = nr_entry_holding(top, decl)
    if own != -1 { return own }
    nr_entry_holding(top, -1)
}

// The first entry from `idx` down its shadow chain that is global and holds `decl`, or -1.
fn nr_entry_holding(idx: Int, decl: Int) -> Int {
    let mut at = idx
    while at != -1 {
        if nr_index_is_global(at) != 0 && nr_scope_nodes.get(at).unwrap() == decl { return at }
        at = nr_scope_prev.get(at).unwrap()
    }
    -1
}

// The declaration `name` reaches in the module under check when one of its selective imports
// renames it (`import m.{x as name}`), or -1 when the spelling is not such an alias there.
// Aliases are local to the importing file (sections/07, the alias rules), so this reads that
// file's own import index and nothing program-wide.
fn nr_alias_decl_here(name: Str) -> Int {
    if nr_current_module == "" { return -1 }
    let decl = nr_resolve_bare_decl(name, nr_current_module)
    if decl < 0 { return -1 }
    if node_name(decl) == name { return -1 }
    decl
}

// Every module's top-level bindings share the outermost frame, so two modules that each
// declare a private `start` leave two entries there, and the newest belongs to whichever
// module registered last. The reading module's own declaration is the one its bare spelling
// means, so a global entry is chosen by the declaration name resolution picks for the
// current module, never by registration order.
fn nr_module_global_index(name: Str, top: Int) -> Int {
    if nr_scope_prev.get(top).unwrap() == -1 { return top }
    if nr_index_is_global(top) == 0 { return top }
    let decl = nr_resolve_bare_decl(name, nr_current_module)
    if decl < 0 { return top }
    let idx = nr_entry_holding(top, decl)
    if idx == -1 { return top }
    if idx != top { dbg_trace("nr.global", "`{name}` in {nr_current_module}: entry {idx} (decl {decl}), not newest {top}") }
    idx
}

// nr_is_defined's side effects for a binding already looked up.
fn nr_mark_read_at(i: Int) {
    nr_scope_reads.set(i, 1)
    // If the read happens inside a closure body, the capture may be
    // observed on a later call — don't let subsequent writes in the
    // enclosing scope cancel this read (W0601 false positive).
    if nr_in_closure_depth > 0 {
        // Only mark entries in enclosing scopes (outside the closure
        // frame) as captured. Locals inside the closure are walked
        // the normal way.
        let mut frame_start = 0
        if nr_scope_frames.len() > 0 {
            frame_start = nr_scope_frames.get(nr_scope_frames.len() - 1).unwrap()
        }
        if i < frame_start {
            nr_scope_captured.set(i, 1)
        }
    }
}

// Does `name` have ANY binding in scope right now? nr_is_defined's answer without
// its side effects — that one marks nr_scope_reads (and nr_scope_captured inside a closure),
// which is how W0310/W0601 decide a variable was used. An inference-time question like "is
// this method receiver a value rather than a type name?" must not count as a read, or asking
// it would silence the unused-variable warnings for every name it asks about. Same
// pure-inspection contract as nr_top_binding_is_global below.
fn nr_has_binding(name: Str) -> Int {
    if nr_name_top.contains_key(name) { return 1 }
    // An alias of a function or a module-level binding reads that declaration's entry.
    if nr_top_index(name) != -1 { return 1 }
    0
}

// Whether `name`'s current top binding lives in the global frame (depth 1).
// A cross-module private-access violation can only legitimately apply to a
// real top-level free-fn/let reference (global frame); when a name resolves to
// an inner frame (a param/local that merely shadows a same-named private
// top-level symbol in another module) it is NOT a cross-module access, so
// E1003 must not fire. Pure inspection — must not call
// nr_is_defined (which has read/capture side effects).
fn nr_top_binding_is_global(name: Str) -> Int {
    let idx = nr_top_index(name)
    if idx == -1 { return 0 }
    nr_index_is_global(idx)
}

// nr_top_binding_is_global for a binding already looked up.
fn nr_index_is_global(idx: Int) -> Int {
    if nr_scope_frames.len() < 2 {
        return 1
    }
    let first_inner = nr_scope_frames.get(1).unwrap()
    if idx < first_inner { 1 } else { 0 }
}

fn nr_is_mut(name: Str) -> Int {
    let i = nr_top_index(name)
    if i == -1 { return 0 }
    nr_scope_muts.get(i).unwrap()
}

fn nr_mark_written(name: Str, _node: Int) ! Diag.Report {
    let i = nr_top_index(name)
    if i == -1 { return }
    if nr_loop_depth == 0 && nr_scope_captured.get(i).unwrap() == 0 {
        nr_scope_reads.set(i, 0)
    }
    nr_scope_writes.set(i, nr_scope_writes.get(i).unwrap() + 1)
}

// The declaring node of `name`'s current top binding, or -1 when the binder recorded none.
// Used to tell a `let` apart from every other way a name enters scope: a
// parameter, a match/for/with binder and a closure param all define through the node-less
// nr_define_typed / nr_define_mut, so -1 there means "not a let" without a per-binder flag.
fn nr_binding_node(name: Str) -> Int {
    let i = nr_top_index(name)
    if i == -1 { return -1 }
    nr_scope_nodes.get(i).unwrap()
}

// -1 for a name the scope does not carry. The give-up singleton would be a TYPE here, and a
// caller cannot tell "this name has no recorded type" from "this name is typed as unknown".
fn nr_get_type(name: Str) -> Int {
    let i = nr_top_index(name)
    if i == -1 { return -1 }
    nr_scope_types.get(i).unwrap()
}

fn nr_set_last_type(tid: Int) {
    if nr_scope_types.len() > 0 {
        nr_scope_types.set(nr_scope_types.len() - 1, tid)
    }
}

// §2.20 test-only symbol allowlist. Append future test-only symbols here
// (e.g. assert_panics) — membership means the symbol may only be called inside
// a literal 'test { ... }' block (tc_in_test_body == 1). This predicate is the
// single source of truth for *which* symbols are fenced; the *fence itself*
// (tc_fence_test_only_symbol) is shared. A new symbol whose Call has its own
// signature/arg-count checks still needs its own `if fn_name == ...` dispatch
// branch in infer_type that calls tc_fence_test_only_symbol with its code —
// the list-append removes fence duplication, not the per-symbol dispatch.
fn is_test_only_symbol(name: Str) -> Int {
    if name == "skip" { return 1 }
    0
}

// Shared fence for §2.20 test-only symbols. `code`/`short_name` are
// parameterized so a future symbol (assert_panics) can fence with E0833.
// tc_in_test_lexical is 1 inside the test block AND inside closures lexically
// within it — testing.for_each's case body relies on this; it is 0 in a
// regular fn, so calling a test-only symbol from a helper fn is fenced even
// when that helper is reachable from a test. This asks a purely LEXICAL
// question, which is why it is not tc_in_test_body: that flag is reset by the
// closure walkers for `?` elaboration (spec §3c.2) and would fence every
// test-only symbol inside a walked closure body.
fn tc_fence_test_only_symbol(name: Str, code: Str, short_name: Str, node: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if is_test_only_symbol(name) != 0 && tc_in_test_lexical == 0 {
        diag_error_at(short_name, code,
            "{name}() can only be called inside a test body",
            node, "move the call into a `test \{ ... }` block")
    }
}

// Whether a call node is the std.testing skip intrinsic. Sole source of truth for this
// question; cg_call and cg_stmt call this directly rather than keeping their own copy.
// The intrinsic needs no import, so an unresolved callee still counts; a resolved callee
// counts only when it names lib/std/testing.bl's skip. A module-qualified call counts
// only by its resolved declaration, since any module may export a fn of that spelling.
pub fn tc_call_is_skip_intrinsic(node: Int) -> Bool {
    if node_kind(node) == NodeKind.MethodCall {
        let decl = tc_call_decl_node(node)
        return decl >= 0 && node_source_module(decl) == "std_testing" && node_name(decl) == "skip"
    }
    let callee = node_left(node)
    if callee < 0 || node_kind(callee) != NodeKind.Ident { return false }
    if tc_call_declared_name(node) != "skip" { return false }
    let decl = tc_call_decl_node(node)
    if decl < 0 { return true }
    node_source_module(decl) == "std_testing" && node_name(decl) == "skip"
}

// The bare and the module-qualified spelling share this, so neither can drift from the
// other on the fence or the argument checks.
fn tc_check_skip_call(node: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    tc_fence_test_only_symbol("skip", SKIP_OUTSIDE_TEST, "SkipOutsideTest", node)
    let args_sl = node_args(node)
    let arg_count = if args_sl != -1 { sublist_length(args_sl) } else { 0 }
    if arg_count != 1 {
        tc_error_at("skip() expects 1 argument (reason: Str), got {arg_count}", node)
    } else {
        let arg_t = infer_type(sublist_get(args_sl, 0))
        if tc_tid_is_no_info(arg_t) == 0 && arg_t != TYPE_STR {
            tc_error_at("skip() reason must be Str, got {type_to_str(arg_t)}", node)
        }
    }
    TYPE_NEVER
}

// pub so codegen resolves a CALL callee in the same order this file does: builtin
// first, user variant second. A payload-less variant named `Map` must not shadow the
// `Map()` constructor, and the only way that ordering cannot drift between the two
// phases is for both to read this one list.
pub fn is_builtin_fn(name: Str) -> Int {
    match name.byte_len() {
        2 => match name {
            "Ok" => 1
            _ => 0
        }
        3 => match name {
            "Err" => 1
            "Map" => 1
            "Set" => 1
            "Raw" => 1
            _ => 0
        }
        4 => match name {
            "exit" => 1
            "Some" => 1
            "None" => 1
            "skip" => 1
            "todo" => 1
            _ => 0
        }
        5 => match name {
            "Bytes" => 1
            "panic" => 1
            _ => 0
        }
        6 => match name {
            "is_dir" => 1
            "assert" => 1
            "getpid" => 1
            _ => 0
        }
        7 => match name {
            "get_arg" => 1
            "time_ms" => 1
            _ => 0
        }
        8 => match name {
            "list_dir" => 1
            "null_ptr" => 1
            _ => 0
        }
        9 => match name {
            "arg_count" => 1
            "read_file" => 1
            "fs_remove" => 1
            "assert_eq" => 1
            "assert_ne" => 1
            "alloc_ptr" => 1
            _ => 0
        }
        10 => match name {
            "write_file" => 1
            "shell_exec" => 1
            "file_mtime" => 1
            _ => 0
        }
        11 => match name {
            "file_exists" => 1
            "process_run" => 1
            "unreachable" => 1
            _ => 0
        }
        12 => match name {
            "debug_assert" => 1
            "socket_write" => 1
            "process_exec" => 1
            _ => 0
        }
        13 => match name {
            "StringBuilder" => 1
            "process_spawn" => 1
            _ => 0
        }
        16 => match name {
            "socket_read_line" => 1
            "process_pid_wait" => 1
            "process_pid_kill" => 1
            _ => 0
        }
        17 => match name {
            "unix_socket_close" => 1
            _ => 0
        }
        18 => match name {
            "unix_socket_listen" => 1
            "unix_socket_accept" => 1
            _ => 0
        }
        19 => match name {
            "unix_socket_connect" => 1
            _ => 0
        }
        22 => match name {
            "process_run_with_stdin" => 1
            _ => 0
        }
        23 => match name {
            "process_pid_send_signal" => 1
            _ => 0
        }
        26 => match name {
            "unix_socket_accept_timeout" => 1
            _ => 0
        }
        33 => match name {
            "process_install_signal_forwarding" => 1
            _ => 0
        }
        _ => 0
    }
}

// A List method that was renamed keeps its old spelling live on Str and Bytes, so a bare
// "no such method" leaves the reader guessing which transforming method took over. Shared
// between the typecheck E0505 site and codegen's backstop so the two cannot drift.
pub fn tc_list_rename_help(method: Str) -> Str {
    if method == "concat" { return "list concatenation is `.append(other)`" }
    if method == "collect" { return "`.collect()` crosses an iterator back to a list; a collection is already collected — drop it, or call `.into_iter()` first to enter the lazy world" }
    if method == "sorted" { return "there is no `.sorted()`: `.sort()` already returns a new sorted list and leaves the receiver as it was" }
    if method == "sort_by_key" { return "there is no `.sort_by_key(key)`: compare the keys in a `.sort_by` comparator, `.sort_by(fn(a, b) \{ key(a).cmp(key(b)) })`" }
    ""
}

// Str has no `slice` or `substr`: a range of a Str is either codepoints or bytes, and those
// two names did not say which. List and Bytes keep `slice`, so the name stays a builtin and
// only this receiver refuses it.
pub fn tc_str_removed_method_help(method: Str) -> Str {
    if method == "slice" || method == "substr" {
        return "Str has no `.{method}`: use `.substring` for a range of codepoints or `.byte_slice(start, end)` for a range of bytes"
    }
    // `.into_iter()` is the one crossing name into the lazy world, so Str has no `.chars()`.
    if method == "chars" {
        return "Str has no `.chars()`: call `.into_iter()` for an Iterator[Char] of its Unicode scalar values"
    }
    ""
}

fn is_builtin_method(name: Str) -> Int {
    // Display: synthesized display() and builtin scalar fmt()/display()
    // (Int/Float/Bool/Str/Char)
    if name == "display" { return 1 }
    if name == "fmt" { return 1 }
    // String methods
    if name == "len" { return 1 }
    if name == "contains" { return 1 }
    if name == "starts_with" { return 1 }
    if name == "ends_with" { return 1 }
    if name == "concat" { return 1 }
    if name == "slice" { return 1 }
    if name == "to_int" { return 1 }
    if name == "split" { return 1 }
    if name == "char_at" { return 1 }
    // `charAt` is deliberately NOT here: it has no codegen arm and no stdlib function, so
    // listing it would only suppress the UnknownMethod warning for a method that does not
    // exist, leaving the user with a hard UnresolvedMethod at codegen and no earlier signal.
    // This list claims a method EXISTS (it also gates the :388 resolution check), so a name
    // with nothing behind it belongs out of it, not given a return type.
    if name == "byte_len" { return 1 }
    if name == "byte_at" { return 1 }
    if name == "byte_slice" { return 1 }
    if name == "byte_index_of" { return 1 }
    if name == "substring" { return 1 }
    if name == "index_of" { return 1 }
    if name == "trim" { return 1 }
    if name == "trim_right" { return 1 }
    if name == "trim_left" { return 1 }
    if name == "to_lower" { return 1 }
    if name == "to_upper" { return 1 }
    if name == "replace" { return 1 }
    if name == "as_cstr" { return 1 }
    if name == "lines" { return 1 }
    if name == "parse_float" { return 1 }
    if name == "parse_int" { return 1 }
    // List methods
    if name == "push" { return 1 }
    if name == "pop" { return 1 }
    if name == "get" { return 1 }
    if name == "last" { return 1 }
    if name == "sort" { return 1 }
    if name == "sort_by" { return 1 }
    if name == "set" { return 1 }
    if name == "join" { return 1 }
    if name == "clear" { return 1 }
    if name == "append" { return 1 }
    // Iterator methods
    if name == "map" { return 1 }
    if name == "filter" { return 1 }
    if name == "collect" { return 1 }
    if name == "count" { return 1 }
    if name == "for_each" { return 1 }
    if name == "any" { return 1 }
    if name == "all" { return 1 }
    if name == "find" { return 1 }
    if name == "fold" { return 1 }
    if name == "take" { return 1 }
    if name == "skip" { return 1 }
    if name == "chain" { return 1 }
    if name == "flat_map" { return 1 }
    if name == "enumerate" { return 1 }
    if name == "zip" { return 1 }
    // The crossing door into the lazy iterator world (§3c.1).
    if name == "into_iter" { return 1 }
    // Map methods
    if name == "contains_key" { return 1 }
    if name == "remove" { return 1 }
    if name == "clear" { return 1 }
    if name == "keys" { return 1 }
    if name == "values" { return 1 }
    if name == "entries" { return 1 }
    // Set methods
    if name == "insert" { return 1 }
    if name == "union" { return 1 }
    // Ptr methods
    if name == "deref" { return 1 }
    if name == "is_null" { return 1 }
    if name == "addr" { return 1 }
    if name == "offset" { return 1 }
    // FFI scope methods
    if name == "alloc" { return 1 }
    if name == "alloc_n" { return 1 }
    if name == "cstr" { return 1 }
    // Bytes methods
    if name == "with_ptr" { return 1 }
    if name == "is_empty" { return 1 }
    if name == "to_str" { return 1 }
    if name == "to_hex" { return 1 }
    if name == "from_str" { return 1 }
    if name == "from_code_point" { return 1 }
    if name == "read_u16_be" { return 1 }
    if name == "read_u32_be" { return 1 }
    if name == "read_i32_be" { return 1 }
    if name == "read_i64_be" { return 1 }
    if name == "read_u16_le" { return 1 }
    if name == "read_u32_le" { return 1 }
    if name == "read_i32_le" { return 1 }
    if name == "read_i64_le" { return 1 }
    if name == "write_u16_be" { return 1 }
    if name == "write_u32_be" { return 1 }
    if name == "write_i32_be" { return 1 }
    if name == "write_i64_be" { return 1 }
    if name == "write_u16_le" { return 1 }
    if name == "write_u32_le" { return 1 }
    if name == "write_i32_le" { return 1 }
    if name == "write_i64_le" { return 1 }
    // The `set_*_le/be(off, v)` family — sections/03_types.md:649-655. Codegen has
    // dispatched all twelve since the family landed (codegen_methods.bl:2784); they were
    // never added here, so the name-only gate answered "no such method" for a method the
    // spec pins and the runtime implements.
    if name == "set_u16_be" { return 1 }
    if name == "set_u32_be" { return 1 }
    if name == "set_u64_be" { return 1 }
    if name == "set_i16_be" { return 1 }
    if name == "set_i32_be" { return 1 }
    if name == "set_i64_be" { return 1 }
    if name == "set_u16_le" { return 1 }
    if name == "set_u32_le" { return 1 }
    if name == "set_u64_le" { return 1 }
    if name == "set_i16_le" { return 1 }
    if name == "set_i32_le" { return 1 }
    if name == "set_i64_le" { return 1 }
    // Effect handle methods (io, fs, net, time, async, env)
    if name == "println" { return 1 }
    if name == "print" { return 1 }
    if name == "eprintln" { return 1 }
    if name == "eprint" { return 1 }
    if name == "log" { return 1 }
    if name == "print_raw" { return 1 }
    if name == "eprint_raw" { return 1 }
    if name == "read" { return 1 }
    if name == "write" { return 1 }
    if name == "list_dir" { return 1 }
    if name == "args" { return 1 }
    // Env effect methods
    if name == "var" { return 1 }
    if name == "cwd" { return 1 }
    if name == "set_var" { return 1 }
    if name == "remove_var" { return 1 }
    if name == "sleep" { return 1 }
    if name == "spawn" { return 1 }
    // Net methods
    if name == "request" { return 1 }
    if name == "listen" { return 1 }
    if name == "accept" { return 1 }
    if name == "read_line" { return 1 }
    if name == "read_n" { return 1 }
    if name == "read_bytes" { return 1 }
    if name == "write_bytes" { return 1 }
    if name == "write_line" { return 1 }
    if name == "close" { return 1 }
    if name == "post" { return 1 }
    if name == "put" { return 1 }
    if name == "patch" { return 1 }
    if name == "head" { return 1 }
    if name == "delete" { return 1 }
    // Channel methods
    if name == "send" { return 1 }
    if name == "recv" { return 1 }
    // Conversion methods
    if tc_is_into_method(name) { return 1 }
    if name == "to_float" { return 1 }
    if name == "to_string" { return 1 }
    if name == "from" { return 1 }
    if name == "try_from" { return 1 }
    // Sized int conversion methods
    if name == "to_i8" { return 1 }
    if name == "to_i16" { return 1 }
    if name == "to_i32" { return 1 }
    if name == "to_u8" { return 1 }
    if name == "to_u16" { return 1 }
    if name == "to_u32" { return 1 }
    if name == "to_u64" { return 1 }
    // Float's IEEE 754 equality, the escape from its total order
    if name == "ieee_eq" { return 1 }
    // Float's bit pattern and sign bit (sections/03_types.md "Float Bits")
    if name == "to_bits" { return 1 }
    if name == "from_bits" { return 1 }
    if name == "is_sign_negative" { return 1 }
    // Sized int wrapping arithmetic
    if name == "wrapping_add" { return 1 }
    if name == "wrapping_sub" { return 1 }
    if name == "wrapping_mul" { return 1 }
    // Int methods
    if name == "abs" { return 1 }
    if name == "min" { return 1 }
    if name == "max" { return 1 }
    // Option methods
    if name == "unwrap" { return 1 }
    if name == "is_some" { return 1 }
    if name == "is_none" { return 1 }
    // Result methods
    if name == "unwrap_err" { return 1 }
    if name == "is_ok" { return 1 }
    if name == "is_err" { return 1 }
    // Instant methods
    if name == "elapsed" { return 1 }
    if name == "since" { return 1 }
    if name == "add" { return 1 }
    if name == "to_rfc3339" { return 1 }
    if name == "to_unix_ms" { return 1 }
    if name == "to_unix_secs" { return 1 }
    // Duration static constructors
    if name == "nanos" { return 1 }
    if name == "ms" { return 1 }
    if name == "seconds" { return 1 }
    if name == "minutes" { return 1 }
    if name == "hours" { return 1 }
    // Duration methods
    if name == "to_ms" { return 1 }
    if name == "to_seconds" { return 1 }
    if name == "to_nanos" { return 1 }
    if name == "sub" { return 1 }
    if name == "scale" { return 1 }
    if name == "is_zero" { return 1 }
    // StringBuilder methods
    if name == "clear" { return 1 }
    if name == "write_char" { return 1 }
    if name == "capacity" { return 1 }
    // emit_sb_method's sibling constructor (codegen_methods.bl:2590) — must be listed
    // here too, or `StringBuilder.with_capacity(8)` draws a W0501 for a method the
    // compiler is able to emit.
    if name == "with_capacity" { return 1 }
    // Bytes/Instant static constructors
    if name == "new" { return 1 }
    if name == "zeroed" { return 1 }
    if name == "from_epoch_secs" { return 1 }
    // ffi.scope() intrinsic namespace constructor (with-resource only)
    if name == "scope" { return 1 }
    // Template methods
    if name == "parts" { return 1 }
    if name == "count" { return 1 }
    if name == "type_tag" { return 1 }
    if name == "get_str" { return 1 }
    if name == "get_int" { return 1 }
    if name == "get_float" { return 1 }
    if name == "get_bool" { return 1 }
    0
}

// The Map method surface, sections/03_types.md "The MapOps Trait": the nine MapOps methods,
// plus len and is_empty from Sized and contains from Contains. One of the nine,
// get_or_default, is not callable yet, and it stays listed here: this answers what the SPEC
// gives a Map, and the name-level check reports the one the front end has not built.
fn tc_map_surface_has(name: Str) -> Int {
    if name == "get" || name == "keys" || name == "values" { return 1 }
    if name == "entries" || name == "get_or_default" { return 1 }
    if name == "insert" || name == "remove" { return 1 }
    if name == "contains_key" || name == "clear" { return 1 }
    if name == "len" || name == "is_empty" || name == "contains" { return 1 }
    0
}

// Does a builtin method name belong to THIS receiver kind? is_builtin_method answers per
// name, which is the right question for a typo suggestion and for "does this name resolve
// anywhere in the program", and the wrong one for a call: `set` is a builtin name because
// List and Bytes have one, and that name-level answer is what accepted `m.set(k, v)` on a
// Map, whose surface the spec closes. A kind is named here only once its surface is closed;
// every other kind keeps the name-level answer.
fn is_builtin_method_on_receiver(obj_k: TyKind, name: Str) -> Int {
    if is_builtin_method(name) == 0 { return 0 }
    if obj_k == TyKind.Map { return tc_map_surface_has(name) }
    if obj_k == TyKind.Str && tc_str_removed_method_help(name) != "" { return 0 }
    1
}

// A builtin type whose name has no call form, unlike Map and Set, and the repair to name for
// it; "" for any other name. The spec builds List and StringBuilder through a static
// constructor on the type name (sections/03_types.md), and a channel through the namespaced
// `channel.new[T]` (sections/04_effects.md), which has to name the element.
fn tc_no_call_form_repair(name: Str) -> Str {
    if name == "List" {
        return "`List` has no constructor call; build an empty list with `List.new()`, with `List.with_capacity(n)` when the final size n is known, or with `[]` and an annotation, as in `let l: List[Int] = []`"
    }
    if name == "StringBuilder" {
        return "`StringBuilder` has no constructor call; build one with `StringBuilder.new()`, or with `StringBuilder.with_capacity(n)` to reserve n bytes"
    }
    if name == "Channel" {
        return "`Channel` has no constructor call; build a channel with `channel.new[T](buffer: n)`, which names its element type"
    }
    // Every other name in the type namespace has no call form either, except the builtins that
    // is_builtin_fn answers for: `Map()`, `Set()`, `Bytes()` and `Raw(e)` (sections/03_types.md,
    // sections/03b_contracts.md). A declaration is read before the builtin spelling, because a
    // program may declare a type that a builtin also names.
    if is_builtin_fn(name) != 0 { return "" }
    let aliased = tc_alias_underlying_of(name)
    if aliased != -1 {
        return "`{name}` is a type alias and has no call form; build the value the way `{type_to_str(aliased)}` is built"
    }
    let declared = lookup_named_type(name)
    if declared != -1 { return tc_declared_type_call_repair(name, declared) }
    if is_primitive_type(name) != 0 || tc_is_undeclared_ffi_scope(name) { return tc_builtin_type_call_repair(name) }
    if is_trait_name(name) != 0 {
        return "`{name}` is a trait, not a type, and has no call form; call one of its methods on a value, or qualified as in `{name}.method(value)`"
    }
    ""
}

// The repair for a call of a type the program declares (sections/02_syntax.md 2.14: a struct
// value is a struct literal; an enum value is one of its variants).
fn tc_declared_type_call_repair(name: Str, tid: Int) -> Str {
    let k = type_kind(tid)
    if k == TyKind.Struct {
        let slots = tc_struct_field_slots(tid)
        let mut fields = ""
        for slot in slots {
            if fields != "" { fields = "{fields}," }
            fields = "{fields} {tc_sfield_name(slot)}: ..."
        }
        let literal = if fields == "" { "`{name} \{}`" } else { "`{name} \{{fields} }`" }
        let scoped = tc_type_scoped_ctor_examples(name, tid)
        // A std type's surface is its type-scoped constructors (sections/03_types.md); its
        // fields are representation, so the repair does not teach a literal of them.
        let decl = tc_tid_decl_node(tid)
        if scoped != "" && decl >= 0 && node_source_module(decl).starts_with("std_") {
            return "`{name}` has no constructor call; build a value with a function of `{name}`, such as {scoped}"
        }
        if scoped != "" {
            return "`{name}` has no constructor call; build a value with a function of `{name}`, such as {scoped}, or with a struct literal, as in {literal}"
        }
        return "`{name}` has no constructor call; build a value with a struct literal, as in {literal}"
    }
    if k == TyKind.Enum {
        return "`{name}` is an enum and has no constructor call; build a value with one of its variants"
    }
    "`{name}` has no constructor call; build a value with the form of the type it names"
}

// Up to two type-scoped functions of the type that build it (sections/02_syntax.md 2.12.3),
// in declaration order and spelled as a call is written, or "" when it has none. One that
// takes a value of the type already has one, so it is an operation, not a constructor.
fn tc_type_scoped_ctor_examples(name: Str, tid: Int) -> Str {
    let prefix = "{name}_"
    let mut out = ""
    let mut found = 0
    let mut i = 0
    while i < fnsig_pool.len() && found < 2 {
        let fs = fnsig_pool.get(i).unwrap()
        if fs.name.starts_with(prefix) && fs.ret == tid && !tc_fnsig_takes(fs, tid) && !tc_fn_decl_takes_self(fs.decl) {
            // A trait impl's function is registered as `{Type}_{Trait}_{fn}`, but a call
            // spells only the function's own name. A free `{Type}_{fn}` keeps its whole name.
            let own = if fs.decl >= 0 { node_name(fs.decl) } else { fs.name }
            let short = if own != fs.name { own } else { fs.name.byte_slice(prefix.byte_len(), fs.name.byte_len()) }
            if out != "" { out = "{out} or " }
            out = "{out}`{name}.{short}(...)`"
            found = found + 1
        }
        i = i + 1
    }
    out
}

// A signature's params leave the receiver out, so a method shows only on its declaration.
// The receiver is the first param written with no annotation: `self`, or `_self`.
fn tc_fn_decl_takes_self(decl: Int) -> Bool {
    if decl < 0 { return false }
    let params = node_params(decl)
    params != -1 && sublist_length(params) > 0 && node_type_ann(sublist_get(params, 0)) == -1
}

fn tc_fnsig_takes(fs: FnSigEntry, tid: Int) -> Bool {
    let mut p = 0
    while p < fs.params_count {
        if fnsig_param_list.get(fs.params_start + p).unwrap() == tid { return true }
        p = p + 1
    }
    false
}

fn tc_builtin_type_call_repair(name: Str) -> Str {
    if name == "Option" { return "`Option` has no constructor call; build one with `Some(value)` or `None`" }
    if name == "Result" { return "`Result` has no constructor call; build one with `Ok(value)` or `Err(error)`" }
    if name == "Tuple" { return "`Tuple` has no constructor call; write a tuple literal, as in `(a, b)`" }
    if name == "Self" {
        return "`Self` is a type-position alias, not a constructor; build the value through the concrete type name"
    }
    if name == "Ptr" {
        return "`Ptr` has no constructor call; build one with `alloc_ptr[T](n)` or `null_ptr[T]()`"
    }
    if name == "FfiScope" { return "`FfiScope` has no constructor call; open one with `ffi.scope()`" }
    if name == "Template" { return "`Template` has no constructor call; write a template literal, as in `t\"...\"`" }
    if name == "Handle" { return "`Handle` has no constructor call; `async.spawn(f)` answers one" }
    if name == "Iterator" { return "`Iterator` has no constructor call; ask a collection for one with `.into_iter()`" }
    if name == "Fn" { return "`Fn` has no constructor call; write a closure, or name a function" }
    if name == "Handler" { return "`Handler` has no constructor call; write a handler expression" }
    if name == "Void" { return "`Void` has no constructor call" }
    "`{name}` has no constructor call; write a literal of the type, or convert a value to it with a conversion method"
}

// Whether a bare call of `name` calls one of those types, and not a declaration or a variant
// that the program spells the same way.
fn tc_names_type_without_call_form(name: Str) -> Bool {
    tc_no_call_form_repair(name) != "" && nr_is_defined(name) == 0 && is_variant_name(name) == 0
}

fn get_builtin_fn_ret(name: Str) -> Int {
    if name == "arg_count" { return TYPE_INT }
    if name == "get_arg" { return TYPE_STR }
    if name == "read_file" { return TYPE_STR }
    if name == "write_file" { return TYPE_VOID }
    if name == "list_dir" { return make_list_type(TYPE_STR) }
    if name == "fs_remove" { return TYPE_VOID }
    if name == "file_exists" { return TYPE_INT }
    if name == "shell_exec" { return TYPE_INT }
    if name == "exit" { return TYPE_VOID }
    let bsig = fnsig_map.get(tc_builtin_sig_key(name)) ?? -1
    if bsig != -1 { return fnsig_pool.get(bsig).unwrap().ret }
    if name == "is_dir" { return TYPE_INT }

    if name == "time_ms" { return TYPE_INT }
    if name == "assert" { return TYPE_VOID }
    if name == "debug_assert" { return TYPE_VOID }
    if name == "skip" { return TYPE_NEVER }
    if name == "unix_socket_listen" { return TYPE_INT }
    if name == "unix_socket_connect" { return TYPE_INT }
    if name == "unix_socket_accept" { return TYPE_INT }
    if name == "unix_socket_accept_timeout" { return TYPE_INT }
    if name == "unix_socket_close" { return TYPE_VOID }
    if name == "socket_read_line" { return TYPE_STR }
    if name == "socket_write" { return TYPE_INT }
    if name == "file_mtime" { return TYPE_INT }
    if name == "getpid" { return TYPE_INT }
    if name == "process_run" { return runtime_process_result_tid() }
    if name == "process_run_with_stdin" { return runtime_process_result_tid() }
    if name == "process_exec" { return TYPE_VOID }
    if name == "process_spawn" { return TYPE_INT }
    if name == "process_pid_wait" { return runtime_process_result_tid() }
    if name == "process_pid_kill" { return TYPE_INT }
    if name == "process_pid_send_signal" { return TYPE_INT }
    if name == "process_install_signal_forwarding" { return TYPE_VOID }
    // Both Ptr constructors are codegen intrinsics whose element comes from the context — the
    // annotation on the binding. A metavar is that context's slot; leaving them absent left the
    // call itself with no type at all.
    if name == "alloc_ptr" { return make_ptr_type(make_metavar()) }
    if name == "null_ptr" { return make_ptr_type(make_metavar()) }
    if name == "Bytes" { return new_type(TyKind.Bytes, "Bytes") }
    if name == "StringBuilder" { return type_stringbuilder() }
    // An empty `Map()`/`Set()` names nothing about its own elements, so the context that
    // receives it is the only source of them, exactly as it is for an empty carrier. Read from
    // the hint rather than left to a bare metavar for a keyed container specifically: its
    // constructor chooses the operations its keys are compared and hashed by FROM THE KEY TYPE,
    // so a key the context knows and the mint does not is a container that cannot be built.
    // Every position that receives one already narrows the hint to the slot the value flows
    // into -- an annotation, a parameter, a list element, a carrier payload, a field default, a
    // declared return -- and a hint of any other kind still mints, so a context that names
    // nothing is unchanged.
    if name == "Map" {
        return make_map_type(tc_container_slot_from_hint(TyKind.Map, 1), tc_container_slot_from_hint(TyKind.Map, 2))
    }
    if name == "Set" { return make_set_type(tc_container_slot_from_hint(TyKind.Set, 1)) }
    TYPE_UNKNOWN
}

// `Float.from_bits`, read on the qualifier's spelling as the `Char.from_code_point` arm is.
// Codegen asks the same question here, so the call it emits is the one this typed. Every
// U64 is a binary64 pattern, so the call is total and returns a bare Float
// (sections/03_types.md "Float Bits").
pub fn tc_is_float_from_bits(qualifier: Str, method: Str) -> Bool {
    qualifier == "Float" && method == "from_bits"
}

// The typecheck mirror of codegen's builtin static-constructor blocks
// (codegen_methods.bl:2525 onward). Every constructor reached here is a codegen INTRINSIC
// with no .bl function behind it, so no fnsig can answer for it and this is the only source
// of its type. It therefore has to enumerate the same methods codegen dispatches
// (project_is_intrinsic_method_must_match_handlers): gating on the method name `new` alone
// and handing the whole answer to get_builtin_fn_ret would not work, because that fn is keyed
// on the TYPE name and so cannot tell two constructors of one type apart.
//
// Deliberately ABSENT, and each for its own reason:
//   • Duration.nanos/ms/seconds/minutes/hours and Instant.from_epoch_secs — lib/std/time.bl
//     declares them as real functions, so the bare `{Type}_{method}` fnsig key already
//     answers. A second answer here could only drift from the declaration.
//   • Char.from_code_point — likewise answered already, as Result[Char, ConversionError].
//   • StringBuilder — answered by its own block earlier in infer_type, which has to run
//     BEFORE the receiver is inferred so a same-spelled enum variant cannot shadow it into
//     E0505. Keeping it there is why StringBuilder is named below only as a comment.
//
// Returns -1 for anything it does not own — absence, so the caller falls through to the fnsig
// lookups. The give-up singleton would have been a type here, and a type ends resolution.
fn tc_builtin_static_ret(tname: Str, method: Str) -> Int {
    if tname == "Bytes" {
        if method == "new" || method == "from_str" || method == "zeroed" {
            return get_builtin_fn_ret("Bytes")
        }
        return -1
    }
    // Map.new() / Set.new(): the element types are metavars, minted per call by
    // get_builtin_fn_ret. No other static constructor exists on either.
    if method == "new" { return get_builtin_fn_ret(tname) }
    -1
}

// The prelude carrier a variant name constructs. Option and Result are type kinds, not
// enums in evar_pool, so their variants are answered here.
pub fn tc_prelude_carrier_of(name: Str) -> Option[TyKind] {
    match name {
        "None" => Some(TyKind.Option)
        "Some" => Some(TyKind.Option)
        "Ok" => Some(TyKind.Result)
        "Err" => Some(TyKind.Result)
        _ => None
    }
}

fn tc_prelude_carrier_name(k: TyKind) -> Str {
    if k == TyKind.Option { "Option" } else { "Result" }
}

// The carrier `Qualifier.Variant` names when the qualifier is that carrier's type and the
// variant one of its own, as in `Option.None` or `Result.Err`. The caller decides that the
// qualifier is a free name and not a value spelled `Option`.
pub fn tc_qualified_carrier(qualifier: Str, variant: Str) -> Option[TyKind] {
    match tc_prelude_carrier_of(variant) {
        Some(k) => if tc_prelude_carrier_name(k) == qualifier { Some(k) } else { None }
        None => None
    }
}

// A carrier variant named with no argument list, bare (`None`) or qualified (`Option.None`).
// Only None is a value on its own. `spelled` is the name as written.
fn tc_carrier_nullary_tid(variant: Str, spelled: Str, node: Int) -> Int ! TypeCheck.Report, Diag.Report {
    if variant == "None" { return make_option_type(tc_carrier_slot_from_hint(TyKind.Option, 1)) }
    let (fewest, most) = tc_carrier_arity(variant)
    let want = if fewest == most { "{most}" } else { "{fewest} or {most}" }
    tc_report_payload_variant_value(variant, want, "fn(x) \{ {spelled}(x) \}", node)
}

// A declared variant named with no argument list. One with a payload is no value on its own;
// the closure the help offers gives each parameter its field's type where that type is
// concrete, since nothing else would pin it.
fn tc_declared_variant_value_tid(enum_tid: Int, var_idx: Int, spelled: Str, node: Int) -> Int ! TypeCheck.Report, Diag.Report {
    let n = variant_field_count(var_idx)
    if n == 0 { return tc_nullary_variant_tid(enum_tid, evar_pool.get(var_idx).unwrap().enum_decl, var_idx) }
    let mut params: List[Str] = []
    let mut names: List[Str] = []
    let mut i = 0
    while i < n {
        let pname = if n == 1 { "x" } else { "x{i + 1}" }
        let ft = lookup_evfield_type_by_index(var_idx, i)
        let typed = ft >= 0 && tc_tid_has_typevar_among(ft, 0) == 0
        params.push(if typed { "{pname}: {type_to_str(ft)}" } else { pname })
        names.push(pname)
        i = i + 1
    }
    let closure = "fn({params.join(", ")}) \{ {spelled}({names.join(", ")}) \}"
    tc_report_payload_variant_value(evar_pool.get(var_idx).unwrap().name, "{n}", closure, node)
}

// No rule makes a variant constructor a function value, so a payload variant named as one is
// refused rather than given the enum's type, which would build a variant with no payload.
fn tc_report_payload_variant_value(variant: Str, want: Str, closure: Str, node: Int) -> Int ! TypeCheck.Report, Diag.Report {
    tc_error_at_code("variant `{variant}` takes {want} argument(s) and is not a function value", node,
        "TypeError", TYPE_ERROR, "wrap the constructor in a closure: `{closure}`")
    tc_error_recovery_tid()
}

// The fewest and most arguments each carrier constructor takes. `Ok()` is `Ok(())`, so `Ok`
// takes none only where its payload may be unit.
fn tc_carrier_arity(variant: Str) -> (Int, Int) {
    match variant {
        "None" => (0, 0)
        "Ok" => if tc_ok_payload_may_be_unit() { (0, 1) } else { (1, 1) }
        _ => (1, 1)
    }
}

// Whether the expected type leaves `Ok`'s payload free to be unit: it names no payload, or
// names unit. A payload it names fixes the count even while the error side is still open, so
// `r = Ok()` with `r` inferred from `Ok(5)` is the arity error. A callee's own type parameter
// names nothing at this site, so the call may still solve it to unit.
fn tc_ok_payload_may_be_unit() -> Bool {
    if tc_construct_hint < 0 { return true }
    let h = resolve_alias_tid(tc_construct_hint)
    if h < 0 || h >= ty_pool.len() { return true }
    let e = ty_pool.get(h).unwrap()
    if e.kind != TyKind.Result || e.inner1 < 0 { return true }
    let payload = tc_resolve(e.inner1)
    if tc_tid_is_no_info(payload) != 0 || tc_is_unbound_metavar(payload) != 0 { return true }
    if tc_tid_has_foreign_typevar(payload) != 0 { return true }
    type_kind(resolve_alias_tid(payload)) == TyKind.Void
}

// Reports a carrier constructor call of the wrong arity in the words a user variant's gets.
// Answers whether the count fits.
fn tc_check_carrier_arity(variant: Str, args_sl: Int, call_node: Int) -> Bool ! TypeCheck.Report, Diag.Report {
    let (fewest, most) = tc_carrier_arity(variant)
    let got = if args_sl != -1 { sublist_length(args_sl) } else { 0 }
    if got >= fewest && got <= most { return true }
    let want = if fewest == most { "{most}" } else { "{fewest} or {most}" }
    tc_error_at("variant `{variant}` expects {want} argument(s), got {got}", call_node)
    false
}

// A carrier constructor call, bare (`Some(x)`) or qualified (`Option.Some(x)`): the one path
// both spellings are typed by, and the one place their arity is checked.
//
// The slot a one-sided carrier does not name mints a FRESH metavar, not the shared
// TYPE_UNKNOWN singleton. A metavar unifies with an annotation / declared return / later use
// that constrains it; an unconstrained one trips the E0301 region boundary. The singleton is
// excluded from that boundary check, so it must not stand in for an inferable slot.
fn tc_carrier_call_tid(variant: Str, args_sl: Int, call_node: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let fits = tc_check_carrier_arity(variant, args_sl, call_node)
    let arg = if args_sl != -1 && sublist_length(args_sl) >= 1 { sublist_get(args_sl, 0) } else { -1 }
    match variant {
        "None" => make_option_type(tc_carrier_slot_from_hint(TyKind.Option, 1))
        "Some" => {
            if arg == -1 { return make_option_type(make_metavar()) }
            make_option_type(infer_carrier_arg(arg, variant))
        }
        "Ok" => {
            // A rejected `Ok()` has no payload type: unit would be a second, wrong error
            // against the payload the expected type names.
            if arg == -1 && !fits { return tc_error_recovery_tid() }
            let payload = if arg == -1 { TYPE_VOID } else { infer_carrier_arg(arg, variant) }
            make_result_type(payload, tc_carrier_slot_from_hint(TyKind.Result, 2))
        }
        _ => {
            if arg == -1 { return make_result_type(make_metavar(), make_metavar()) }
            make_result_type(tc_carrier_slot_from_hint(TyKind.Result, 1), infer_carrier_arg(arg, variant))
        }
    }
}

fn is_variant_name(name: Str) -> Int {
    if tc_prelude_carrier_of(name).is_some() { return 1 }
    if tc_first_variant_slot(name) != -1 { 1 } else { 0 }
}

// The lexer reads only ASCII identifiers, so A-Z is the whole Unicode Lu/Lt set a name can
// start with.
fn tc_name_is_upper(name: Str) -> Bool {
    name.byte_len() > 0 && name.byte_at(0) >= 65 && name.byte_at(0) <= 90
}

// Whether a bare name with no payload binds a new name (§3.5 Bare names: variant or binding).
// In a refutable pattern an uppercase name is a variant whatever the type at that position;
// any other name binds unless some enum declares a variant of that name.
fn pattern_name_binds(name: Str, refutable: Bool) -> Bool {
    if name == "_" || (refutable && tc_name_is_upper(name)) { return false }
    is_variant_name(name) == 0
}

fn get_variant_enum_tid(name: Str) -> Int {
    let i = tc_first_variant_slot(name)
    if i < 0 { return TYPE_UNKNOWN }
    evar_pool.get(i).unwrap().enum_id
}

// What a bare variant name in value position constructs (sections/03_types.md §3.4).
type BareVariantPick {
    NotAVariant
    Carrier(kind: TyKind)
    Declared(enum_tid: Int, var_idx: Int)
    // The prelude carrier that also has the variant, if one does, and the declaration of each
    // enum that has it.
    Ambiguous(carrier: Option[TyKind], enums: List[Int])
}

// Step 2 of the resolution order: the expected type names the carrier or an enum that has a
// variant `name`. `carrier` is the prelude carrier `name` constructs, or None.
fn tc_bare_variant_from_type(name: Str, carrier: Option[TyKind], t: Int) -> BareVariantPick {
    if t < 0 { return BareVariantPick.NotAVariant }
    let h = resolve_alias_tid(t)
    let hk = type_kind(h)
    if (carrier ?? TyKind.Unknown) == hk && hk != TyKind.Unknown { return BareVariantPick.Carrier(hk) }
    if hk != TyKind.Enum { return BareVariantPick.NotAVariant }
    let base = tc_enum_base_tid(h)
    let vi = get_variant_by_name(base, name)
    if vi == -1 { return BareVariantPick.NotAVariant }
    BareVariantPick.Declared(base, vi)
}

// The type that picks `name` at `site`: the expected type, else the type an earlier walk
// stamped on the site under its expected type. A site denotes one variant, so a later walk
// that reaches it with no expected type (an `if` branch walked after its let) keeps that
// answer. -1 when neither picks.
fn tc_bare_variant_site_type(name: Str, site: Int, carrier: Option[TyKind]) -> Int {
    match tc_bare_variant_from_type(name, carrier, tc_construct_hint) {
        BareVariantPick.NotAVariant => {}
        _ => return tc_construct_hint
    }
    let stamped = tc_lookup_node_tid(site)
    match tc_bare_variant_from_type(name, carrier, stamped) {
        BareVariantPick.NotAVariant => -1
        _ => stamped
    }
}

// Step 3: the one constructible name of that spelling in the program. A std module never
// depends on the program that uses it, so its sites do not see the program's enums.
fn tc_bare_variant_from_program(name: Str, site: Int, carrier: Option[TyKind]) -> BareVariantPick {
    let mut enums: List[Int] = []
    let mut only = match carrier {
        Some(k) => BareVariantPick.Carrier(k)
        None => BareVariantPick.NotAVariant
    }
    let std_site = tc_site_in_std(site)
    for i in evar_slots_by_name.get(name) ?? [] {
        let ev = evar_pool.get(i).unwrap()
        if !std_site || node_source_module(ev.enum_decl).starts_with("std_") {
            enums.push(ev.enum_decl)
            only = BareVariantPick.Declared(ev.enum_id, i)
        }
    }
    let carriers = if carrier.is_some() { 1 } else { 0 }
    if enums.len() + carriers > 1 { return BareVariantPick.Ambiguous(carrier, enums) }
    only
}

// An expression node records no module of its own; the function around it does.
fn tc_site_in_std(site: Int) -> Bool {
    if tc_current_fn_node >= 0 { return node_source_module(tc_current_fn_node).starts_with("std_") }
    node_source_module(site).starts_with("std_")
}

// Step 1 of the resolution order (sections/03_types.md §3.4 "Values come first"): a local,
// a parameter, or the module-scope fn or let name resolution bound the spelling to. A hint
// never moves the name past it, so this is asked before any variant is.
fn tc_bare_name_is_value(name: Str, site: Int) -> Bool {
    let top = nr_top_index(name)
    if top != -1 && nr_index_is_global(top) == 0 { return true }
    let decl = match tc_call_decl.get(site) {
        Some(d) => d
        None => tc_global_read_decl.get(site) ?? -1
    }
    if decl < 0 { return false }
    let k = node_kind(decl)
    k == NodeKind.FnDef || k == NodeKind.LetBinding
}

fn tc_pick_bare_variant(name: Str, site: Int, carrier: Option[TyKind]) -> BareVariantPick {
    if carrier.is_none() && tc_first_variant_slot(name) == -1 { return BareVariantPick.NotAVariant }
    if tc_bare_name_is_value(name, site) { return BareVariantPick.NotAVariant }
    let site_t = tc_bare_variant_site_type(name, site, carrier)
    if site_t >= 0 { return tc_bare_variant_from_type(name, carrier, site_t) }
    tc_bare_variant_from_program(name, site, carrier)
}

// One payload argument of a paren variant call: the value it holds and the variant field it
// fills, by label when it has one and by position when not. `field` is -1 when the label
// names no field or the position is past the arity.
type VariantPayload {
    value: Int
    field: Int
}

fn tc_variant_payload(var_idx: Int, args_sl: Int, i: Int) -> VariantPayload {
    let arg = sublist_get(args_sl, i)
    if node_kind(arg) == NodeKind.NamedArg {
        return VariantPayload { value: node_value(arg), field: lookup_evfield_type_by_name(var_idx, node_name(arg)) }
    }
    VariantPayload { value: arg, field: lookup_evfield_type_by_index(var_idx, i) }
}

// The instance of a generic variant's enum whose every argument is a fresh metavariable, as a
// generic fn call instantiates its type parameters: the payloads fill them, so two payloads of
// one parameter must agree, and a field type never names the enum's own parameter, which is
// not the checked body's. -1 for a non-generic enum, whose fields name no parameter.
fn tc_variant_open_instance(var_idx: Int) -> Int {
    let ev = evar_pool.get(var_idx).unwrap()
    if ev.enum_decl < 0 { return -1 }
    let tparams = node_type_params(ev.enum_decl)
    if tparams == -1 || sublist_length(tparams) == 0 { return -1 }
    let mut args: List[Int] = []
    let mut i = 0
    while i < sublist_length(tparams) {
        args.push(make_metavar())
        i = i + 1
    }
    make_enum_instance_type(tc_instance_base_name(ev.enum_id), args)
}

// Each payload value of a paren variant call `E.V(...)` or `V(...)` against its field type, the
// value's expected type (sections/03_types.md 3.3). Both spellings come here, so a payload is
// checked, and fills a generic call's binders, the same way whichever one builds the variant.
// tc_check_variant_paren_payload owns the count and the labels. The field is read as declared:
// which instance of a generic enum the call builds is the answer this check feeds, and an
// expected type around the call is met by tc_pin_declared_into_value once the call is typed.
// Answers each payload's type in argument order, so the instance is read off the types this
// check recorded and no payload is inferred twice.
fn tc_check_variant_payload_values(label: Str, var_idx: Int, args_sl: Int) -> List[Int] ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let mut tids: List[Int] = []
    if args_sl == -1 { return tids }
    let inst = tc_variant_open_instance(var_idx)
    let mut i = 0
    while i < sublist_length(args_sl) {
        let p = tc_variant_payload(var_idx, args_sl, i)
        // -1 is a named miss or an index past the arity, which the payload check has
        // reported; a mismatch against no field would be a second report of one mistake.
        if p.field != -1 && tc_tid_is_no_info(p.field) == 0 {
            check_arg_value(label, i, tc_subst_evfield_from_instance(p.field, inst), p.value)
            tids.push(tc_pin_tail_tid(p.value))
        } else {
            tids.push(infer_type(p.value))
        }
        i = i + 1
    }
    tids
}

// A call `Name(...)` whose name resolved to a declared variant or to no single one; None for
// any other pick.
@allow(UnrestoredMutation)
fn tc_infer_bare_variant_call(node: Int, fn_name: Str, vpick: BareVariantPick) -> Option[Int] ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    match vpick {
        BareVariantPick.Declared(venum, var_idx) => {
            tc_check_variant_paren_payload(var_idx, fn_name, node)
            let payload_tids = tc_check_variant_payload_values(fn_name, var_idx, node_args(node))
            // A generic-enum variant (`Leaf(1)`) reverse-infers its concrete
            // instance tid (`Tree[Int]`) from the ctor args so codegen mono's
            // it; a non-generic enum keeps the bare tid.
            let vdecl = evar_pool.get(var_idx).unwrap().enum_decl
            Some(tc_enum_ctor_instance_tid(venum, vdecl, var_idx, node_args(node), payload_tids))
        }
        BareVariantPick.Ambiguous(carrier, enums) => {
            tc_report_ambiguous_construction(fn_name, carrier, enums, node)
            let args_sl = node_args(node)
            if args_sl != -1 {
                let saved_hint = tc_construct_hint
                tc_construct_hint = -1
                let mut ai = 0
                while ai < sublist_length(args_sl) {
                    infer_type(sublist_get(args_sl, ai))
                    ai = ai + 1
                }
                tc_construct_hint = saved_hint
            }
            Some(tc_error_recovery_tid())
        }
        _ => None
    }
}

// How the module under check can write an enum as the qualifier of one of its variants.
type EnumReach {
    // A spelling that names the enum here: its own name, or the alias an import gives it.
    Named(qualifier: Str)
    // Nothing here names it, and a selective import of its module would bind its bare name.
    Importable
    // Its bare name means another declaration here, or its module cannot be imported.
    Unreachable
}

// What the candidate `decl` is to module `reader`, by the spellings that resolve there to that
// very declaration. -1 is the prelude carrier `bare`: it has no declaration and is in every
// module's scope unless the module binds the name.
fn tc_enum_reach(decl: Int, bare: Str, reader: Str) -> EnumReach {
    let binds = nr_module_import_index(reader)
    let taken = nr_module_declares(reader, bare) != 0 || binds.contains_key(bare)
    if decl == -1 { return if taken { EnumReach.Unreachable } else { EnumReach.Named(bare) } }
    let src_mod = node_module(decl)
    if src_mod == reader || (tc_module_key_is_main(src_mod) != 0 && tc_module_key_is_main(reader) != 0) {
        return EnumReach.Named(bare)
    }
    // Only a spelling the file's own imports bind counts, so a facade's re-export or an alias
    // is followed to the declaration. Sorted, so two aliases of one enum give one answer.
    if nr_resolve_imported_decl(bare, reader) == decl { return EnumReach.Named(bare) }
    for bound in binds.keys().sort() {
        if nr_resolve_imported_decl(bound, reader) == decl { return EnumReach.Named(bound) }
    }
    if taken { return EnumReach.Unreachable }
    if tc_prelude_modules.contains_key(src_mod) { return EnumReach.Named(bare) }
    if tc_module_key_is_main(src_mod) != 0 || node_is_pub(decl) == 0 { return EnumReach.Unreachable }
    EnumReach.Importable
}

// The prelude carrier comes first, then the enums. Two of one bare name print with their
// modules. The qualify list holds only what resolves at the site; an enum an import would
// reach gets a note with that import, and one whose name means something else there gets
// nothing, since no spelling of it resolves.
fn tc_report_ambiguous_construction(name: Str, carrier: Option[TyKind], enums: List[Int], node: Int) ! Diag.Report {
    let carrier_name = match carrier {
        Some(k) => tc_prelude_carrier_name(k)
        None => ""
    }
    let mut cands: List[Int] = []
    if carrier_name != "" { cands.push(-1) }
    for e in enums {
        cands.push(e)
    }
    let mut seen: Map[Str, Int] = Map()
    for c in cands {
        let bare = if c == -1 { carrier_name } else { node_name(c) }
        seen.insert(bare, (seen.get(bare) ?? 0) + 1)
    }
    let mut owners: List[Str] = []
    let mut quals: List[Str] = []
    let mut notes: List[Str] = []
    for c in cands {
        let bare = if c == -1 { carrier_name } else { node_name(c) }
        // The home sections/07_trust_modules_metadata.md gives the compiler-known types.
        let m = if c == -1 { "blink.core" } else { node_module(c) }
        owners.push(if (seen.get(bare) ?? 0) > 1 { tc_name_with_module(bare, m) } else { bare })
        match tc_enum_reach(c, bare, nr_current_module) {
            EnumReach.Named(q) => quals.push("{q}.{name}")
            EnumReach.Importable => notes.push(tc_import_help(bare, tc_get_dotted_module_path(m), name))
            EnumReach.Unreachable => {}
        }
    }
    let both = if owners.len() == 2 { "both " } else { "" }
    let qualify = if quals.len() == 0 { "" } else { "; qualify as {tc_series(quals, "or")}" }
    diag_error_at_notes("AmbiguousConstruction", AMBIGUOUS_CONSTRUCTION, "`{name}` is a variant of {both}{tc_series(owners, "and")}{qualify}", node, "write the enum before the variant, or give the site an expected type", notes)
}

// How to reach `ty.member` when `ty` is not selected: the same words wherever a type
// qualifier is missing from the import list.
fn tc_import_help(ty: Str, dotted_mod: Str, member: Str) -> Str {
    "add `{ty}` to your import: `import {dotted_mod}.\{{ty}\}` then use `{ty}.{member}`"
}

// `a`, `a and b`, `a, b and c`: a list as a sentence names it.
fn tc_series(items: List[Str], conj: Str) -> Str {
    let last = items.len() - 1
    let mut out = ""
    let mut i = 0
    while i < items.len() {
        let sep = if i == 0 { "" } else if i == last { " {conj} " } else { ", " }
        out = "{out}{sep}{items.get(i).unwrap()}"
        i = i + 1
    }
    out
}

// ── Literal field checks (§2.14 Checking a Literal's Fields) ─────────
// Every literal that names fields comes here: a struct literal, a variant brace literal, and a
// variant paren payload. A struct pattern and a variant brace pattern come here too (§3.5).

// A field a literal may label, in declaration order. `field` is its TypeField node; its type
// is written out only when a report names it.
type LitFieldRow {
    name: Str
    field: Int
    has_default: Bool
}

type LitDup {
    at: Int
    first: Int
}

type LitUnknown {
    at: Int
    suggestion: Str
}

type LitFaults {
    dups: List[LitDup]
    unknowns: List[LitUnknown]
    missing: List[LitFieldRow]
}

// Where a repair adds to a brace list. `lead` is ", " after a label and "" inside empty braces.
type BraceAppend {
    line: Int
    col: Int
    lead: Str
}

// The type a literal builds, as its diagnostics name it, and the declaration a repair would edit.
type LitOwner {
    shown: Str
    decl: Int
    rows: List[LitFieldRow]
    is_struct: Bool
}

// The Error Catalog's nearest-name rule: compare with case, `_` and `-` ignored, and name a
// candidate only when it alone is nearest and near enough. "" when there is none.
fn nearest_name(written: Str, candidates: List[Str]) -> Str {
    let key = nearest_name_key(written)
    let threshold = if key.byte_len() / 3 < 1 { 1 } else { key.byte_len() / 3 }
    let mut best = ""
    let mut best_dist = threshold + 1
    let mut tied = false
    for c in candidates {
        let d = str_levenshtein(key, nearest_name_key(c))
        if d < best_dist {
            best = c
            best_dist = d
            tied = false
        } else if d == best_dist {
            tied = true
        }
    }
    if tied { "" } else { best }
}

fn nearest_name_key(s: Str) -> Str {
    s.to_lower().replace("_", "").replace("-", "")
}

// The faults of one literal, each kind in source order. `labels` are the label nodes as
// written. A missing field that an unknown label's suggestion names is left out, so a typo
// gives one report and one rename clears it. A field that two unknown labels both come nearest
// to is suggested to neither: renaming both would give it twice.
fn literal_field_faults(rows: List[LitFieldRow], labels: List[Int], check_missing: Bool) -> LitFaults {
    let mut first_at: Map[Str, Int] = Map()
    let mut dups: List[LitDup] = []
    for l in labels {
        match first_at.get(node_name(l)) {
            Some(first) => dups.push(LitDup { at: l, first: first })
            None => first_at.insert(node_name(l), l)
        }
    }
    let mut declared: Map[Str, Int] = Map()
    for r in rows { declared.insert(r.name, 1) }
    let mut unknown_at: List[Int] = []
    for l in labels {
        if !declared.contains_key(node_name(l)) && (first_at.get(node_name(l)) ?? -1) == l { unknown_at.push(l) }
    }
    let mut unknowns: List[LitUnknown] = []
    let mut picks: Map[Str, Int] = Map()
    if unknown_at.len() > 0 {
        let mut candidates: List[Str] = []
        for r in rows {
            if !first_at.contains_key(r.name) { candidates.push(r.name) }
        }
        let mut found: List[LitUnknown] = []
        for l in unknown_at {
            let s = nearest_name(node_name(l), candidates)
            if s != "" { picks.insert(s, (picks.get(s) ?? 0) + 1) }
            found.push(LitUnknown { at: l, suggestion: s })
        }
        for u in found {
            unknowns.push(if (picks.get(u.suggestion) ?? 0) > 1 { LitUnknown { at: u.at, suggestion: "" } } else { u })
        }
    }
    let mut missing: List[LitFieldRow] = []
    if check_missing {
        for r in rows {
            if !r.has_default && !first_at.contains_key(r.name) && (picks.get(r.name) ?? 0) != 1 { missing.push(r) }
        }
    }
    LitFaults { dups: dups, unknowns: unknowns, missing: missing }
}

// The named fields of a declaration's field list. A positional variant field has no label.
fn tc_lit_rows(decl_fields: Int) -> List[LitFieldRow] {
    let mut rows: List[LitFieldRow] = []
    if decl_fields == -1 { return rows }
    let mut i = 0
    while i < sublist_length(decl_fields) {
        let f = sublist_get(decl_fields, i)
        if node_kind(f) == NodeKind.TypeField && node_int_val(f) == 0 {
            rows.push(LitFieldRow { name: node_name(f), field: f, has_default: node_condition(f) != -1 })
        }
        i = i + 1
    }
    rows
}

// §3.1 rule 1: a repair that edits a declaration is offered only in the package being
// compiled. The root package stands for it until the spec defines workspaces and path deps.
// A declaration the checker synthesizes has no source line, and no file a person could edit.
fn tc_decl_in_root_package(decl: Int) -> Bool {
    if node_line(decl) <= 0 { return false }
    let m = node_module(decl)
    tc_module_key_is_main(m) != 0 || tc_same_package(m, "__main__")
}

// An alias head builds its target, so the target's declaration owns the fields.
fn tc_struct_literal_owner(stid: Int) -> Option[LitOwner] {
    let written = tc_instance_base_name(stid)
    let target = tc_alias_underlying_of(written)
    let name = if target != -1 { tc_instance_base_name(target) } else { written }
    let decl = tc_struct_decl_nodes.get(name) ?? -1
    if decl == -1 { return None }
    Some(LitOwner { shown: tc_nominal_type_name(decl), decl: decl, rows: tc_lit_rows(node_fields(decl)), is_struct: true })
}

fn tc_variant_literal_owner(var_idx: Int) -> Option[LitOwner] {
    let vdecl = tc_variant_decl_node(var_idx)
    if vdecl == -1 { return None }
    let edecl = evar_pool.get(var_idx).unwrap().enum_decl
    Some(LitOwner { shown: "{tc_nominal_type_name(edecl)}.{node_name(vdecl)}", decl: edecl, rows: tc_lit_rows(node_fields(vdecl)), is_struct: false })
}

fn tc_lit_labels(sl: Int) -> List[Int] {
    let mut labels: List[Int] = []
    if sl == -1 { return labels }
    let mut i = 0
    while i < sublist_length(sl) {
        let n = sublist_get(sl, i)
        if node_kind(n) == NodeKind.StructLitField || node_kind(n) == NodeKind.NamedArg { labels.push(n) }
        i = i + 1
    }
    labels
}

fn tc_lit_spread(flds_sl: Int) -> Int {
    if flds_sl == -1 { return -1 }
    let mut i = 0
    while i < sublist_length(flds_sl) {
        let n = sublist_get(flds_sl, i)
        if node_kind(n) == NodeKind.SpreadExpr { return n }
        i = i + 1
    }
    -1
}

fn tc_check_brace_literal(owner: Option[LitOwner], node: Int) ! Diag.Report {
    match owner {
        Some(o) => {
            let spread = tc_lit_spread(node_fields(node))
            tc_report_literal_fields(o, tc_lit_labels(node_fields(node)), spread, node, node)
            if spread != -1 && !o.is_struct { tc_report_variant_spread(o, spread) }
        }
        None => {}
    }
}

// §3.4: an all-labelled payload takes the literal field checks in place of the argument count.
// A label can name only a named field, so a variant with a positional field keeps the count.
// Any other payload keeps the count, with a note that lists the fields in order, and its
// labels still name fields.
fn tc_check_variant_paren_payload(var_idx: Int, vname: Str, node: Int) ! TypeCheck.Report, Diag.Report {
    let args_sl = node_args(node)
    let got = if args_sl != -1 { sublist_length(args_sl) } else { 0 }
    let labels = tc_lit_labels(args_sl)
    let expected = variant_field_count(var_idx)
    if labels.len() == 0 && got == expected { return }
    match tc_variant_literal_owner(var_idx) {
        Some(owner) => {
            if got > 0 && labels.len() == got && owner.rows.len() > 0 && owner.rows.len() == expected {
                tc_report_literal_fields(owner, labels, -1, node, -1)
                return
            }
            tc_report_variant_arity(owner.shown, var_idx, vname, got, node)
            let faults = literal_field_faults(owner.rows, labels, false)
            for u in faults.unknowns { tc_report_unknown_label(owner, labels, u, false) }
        }
        None => tc_report_variant_arity("", var_idx, vname, got, node)
    }
}

// The count error, with a note that lists the variant's fields when its declaration is known.
fn tc_report_variant_arity(shown: Str, var_idx: Int, vname: Str, got: Int, node: Int) ! TypeCheck.Report, Diag.Report {
    let expected = variant_field_count(var_idx)
    if got == expected { return }
    let vdecl = tc_variant_decl_node(var_idx)
    let decl_fields = if vdecl != -1 { node_fields(vdecl) } else { -1 }
    let mut fields: List[Str] = []
    if decl_fields != -1 {
        let mut i = 0
        while i < sublist_length(decl_fields) {
            let f = sublist_get(decl_fields, i)
            let t = type_ann_text(node_value(f))
            fields.push(if node_int_val(f) != 0 { t } else { "{node_name(f)} ({t})" })
            i = i + 1
        }
    }
    let msg = "variant `{vname}` expects {expected} argument(s), got {got}"
    tc_errors.push(msg)
    let notes = if fields.len() > 0 { ["fields of `{shown}`, in order: {fields.join(", ")}"] } else { [] }
    diag_error_at_notes("TypeError", TYPE_ERROR, msg, node, "", notes)
}

// Every DuplicateField, then every NoSuchField, then MissingField (§2.14 Order). `lit` is the
// brace literal a fill-in assist edits, or -1 for a paren payload.
fn tc_report_literal_fields(owner: LitOwner, labels: List[Int], spread: Int, head: Int, lit: Int) ! Diag.Report {
    let faults = tc_report_label_faults(owner, owner.rows, labels, spread == -1, false)
    if faults.missing.len() == 0 { return }
    let mut fill: List[Str] = []
    for r in faults.missing { fill.push("{r.name}: ") }
    let one = faults.missing.len() == 1
    let first = faults.missing.get(0).unwrap().name
    let what = tc_missing_fields_phrase(faults.missing)
    let mut help = if one { "add `{first}: ` and a value" } else { "add each missing field with a value" }
    if owner.is_struct && tc_decl_in_root_package(owner.decl) {
        help = if one { "{help}\nor give `{first}` a default in `{owner.shown}`" } else { "{help}\nor give each a default in `{owner.shown}`" }
    }
    let before = diag_entry_count()
    diag_error_at("MissingField", MISSING_FIELD, "`{owner.shown}` literal is missing {what}", head, help)
    if lit != -1 && diag_entry_count() > before { tc_assist_fill_fields(lit, labels, fill) }
}

// The fill-in assist writes each missing label after the last field, or inside empty braces.
// It leaves the values for a person to write, so it is never a machine fix.
fn tc_assist_fill_fields(lit: Int, labels: List[Int], fill: List[Str]) ! Diag.Report {
    let text = fill.join(", ")
    let action = if fill.len() == 1 { "add the missing field" } else { "add the missing fields" }
    match tc_brace_append_at(lit, labels) {
        Some(at) => diag_set_last_assist_at(action, "{at.lead}{text}", at.line, at.col)
        None => {}
    }
}

// After the last label, or before the `}` of empty braces. None when the parser kept no end
// span there, as after a parse error.
fn tc_brace_append_at(brace: Int, labels: List[Int]) -> Option[BraceAppend] {
    if labels.len() > 0 {
        let last = labels.get(labels.len() - 1).unwrap()
        if node_end_line(last) > 0 { return Some(BraceAppend { line: node_end_line(last), col: node_end_col(last), lead: ", " }) }
        return None
    }
    if node_end_line(brace) > 0 && node_end_col(brace) > 1 { return Some(BraceAppend { line: node_end_line(brace), col: node_end_col(brace) - 1, lead: "" }) }
    None
}

// E0315 and E0319 name the missing fields the same way: each with its declared type.
fn tc_missing_fields_phrase(missing: List[LitFieldRow]) -> Str {
    let mut shown: List[Str] = []
    for r in missing { shown.push("`{r.name}` ({type_ann_text(node_value(r.field))})") }
    if shown.len() == 1 { "field {shown.get(0).unwrap()}" } else { "fields {shown.join(", ")}" }
}

// Every DuplicateField, then every NoSuchField (§2.14 Order). The caller reports what is
// missing, since a literal and a pattern report it with different codes.
fn tc_report_label_faults(owner: LitOwner, rows: List[LitFieldRow], labels: List[Int], check_missing: Bool, in_pattern: Bool) -> LitFaults ! Diag.Report {
    // A type its module declares twice (E1016) may have meant either declaration's fields.
    if tc_type_decl_poisoned(owner.decl) { return LitFaults { dups: [], unknowns: [], missing: [] } }
    let faults = literal_field_faults(rows, labels, check_missing)
    tc_report_duplicate_labels(faults.dups)
    for u in faults.unknowns { tc_report_unknown_label(owner, labels, u, in_pattern) }
    faults
}

fn tc_report_duplicate_labels(dups: List[LitDup]) ! Diag.Report {
    for d in dups {
        diag_error_at_notes("DuplicateField", DUPLICATE_FIELD, "field `{node_name(d.at)}` is given twice", d.at,
            "remove one of the two", ["first given here: {node_line(d.first)}:{node_col(d.first)}"])
    }
}

// A variant with no named field cannot take one beside its positional fields, so it gets no
// "add the field" help. Nor does a pattern label: a pattern only reads the fields a type has.
fn tc_report_unknown_label(owner: LitOwner, labels: List[Int], u: LitUnknown, in_pattern: Bool) ! Diag.Report {
    let name = node_name(u.at)
    let add = if !in_pattern && owner.rows.len() > 0 && tc_decl_in_root_package(owner.decl) { "\nor add the field to `{owner.shown}`" } else { "" }
    let msg = "`{owner.shown}` has no field `{name}`"
    if u.suggestion != "" {
        let before = diag_entry_count()
        diag_error_at("NoSuchField", NO_SUCH_FIELD, msg, u.at, "did you mean `{u.suggestion}`?{add}")
        if diag_entry_count() > before {
            // A punned label is also its binder, so the fix labels the field and keeps the
            // binder's name: a use in the arm still means what it meant.
            if in_pattern && node_pattern(u.at) == -1 {
                if node_end_line(u.at) == node_line(u.at) && node_end_col(u.at) > node_col(u.at) {
                    let binder = if node_is_mut(u.at) != 0 { "mut {name}" } else { name }
                    diag_set_last_fix_at("label as", "{u.suggestion}: {binder}", node_line(u.at), node_col(u.at), node_line(u.at), node_end_col(u.at))
                }
            } else {
                diag_set_last_fix_at("rename to", u.suggestion, node_line(u.at), node_col(u.at), node_line(u.at), node_col(u.at) + name.byte_len())
            }
        }
        return
    }
    if owner.rows.len() == 0 {
        diag_error_at("NoSuchField", NO_SUCH_FIELD, msg, u.at, "`{owner.shown}` has no named fields")
        return
    }
    diag_error_at("NoSuchField", NO_SUCH_FIELD, msg, u.at, "`{owner.shown}` declares: {tc_declared_marks(owner, labels).join(", ")}{add}")
}

fn tc_declared_marks(owner: LitOwner, labels: List[Int]) -> List[Str] {
    let mut given: Map[Str, Int] = Map()
    for l in labels { given.insert(node_name(l), 1) }
    let mut out: List[Str] = []
    for r in owner.rows { out.push(if given.contains_key(r.name) { "{r.name} (given)" } else { r.name }) }
    out
}

// §3.5 Struct patterns: the labels of a struct pattern or a variant brace pattern are checked
// as a literal's are, with `..` in place of `..source`. A pattern must name a defaulted field
// too, so no row has a default. The faults come back whether or not this visit reported them,
// so the arm's recovery is the same on every walk.
fn tc_check_pattern_labels(owner: Option[LitOwner], pat: Int) -> LitFaults ! Diag.Report {
    match owner {
        Some(o) => {
            let mut rows: List[LitFieldRow] = []
            for r in o.rows { rows.push(LitFieldRow { has_default: false, ..r }) }
            let labels = tc_lit_labels(node_fields(pat))
            let faults = tc_report_label_faults(o, rows, labels, node_inclusive(pat) == 0, true)
            if faults.missing.len() > 0 { tc_report_pattern_missing_rest(o, pat, labels, faults.missing) }
            faults
        }
        None => LitFaults { dups: [], unknowns: [], missing: [] }
    }
}

// One error at the type or variant name. The fixes come in the spec's order: `..` is the
// machine fix; `f: _` keeps the pattern closed, so it is an assist a person chooses.
fn tc_report_pattern_missing_rest(owner: LitOwner, pat: Int, labels: List[Int], missing: List[LitFieldRow]) ! Diag.Report {
    let mut skips: List[Str] = []
    for r in missing { skips.push("{r.name}: _") }
    let msg = "`{owner.shown}` pattern leaves out {tc_missing_fields_phrase(missing)} and has no `..`"
    // Both spellings put the error under the name the pattern gives: `Rect` in `Shape.Rect`.
    let named = node_type_name(pat)
    let qcol = if node_kind(pat) == NodeKind.EnumPattern { tc_qualified_name_col(pat, node_name(pat), named) } else { node_col(pat) }
    let col = if qcol > 0 { qcol } else { node_col(pat) }
    let end_col = if qcol > 0 { qcol + named.byte_len() } else { 0 }
    let before = diag_entry_count()
    diag_error_span_at_notes("PatternMissingRest", PATTERN_MISSING_REST, msg, pat, node_line(pat), col, end_col, "add `..`", [])
    if diag_entry_count() == before { return }
    let skip_action = if missing.len() == 1 { "name the left-out field" } else { "name the left-out fields" }
    match tc_brace_append_at(pat, labels) {
        Some(at) => {
            diag_set_last_fix_at("insert `..`", "{at.lead}..", at.line, at.col, at.line, at.col)
            diag_set_last_assist_at(skip_action, "{at.lead}{skips.join(", ")}", at.line, at.col)
        }
        None => {}
    }
}

// §3.4: copy-update is for struct literals. The note shows the match that binds the fields.
fn tc_report_variant_spread(owner: LitOwner, spread: Int) ! Diag.Report {
    let src = unparse_expr(node_value(spread))
    let mut names: List[Str] = []
    for r in owner.rows { names.push(r.name) }
    let notes = if names.len() > 0 { ["for example, `match {src} \{ {owner.shown} \{ {names.join(", ")} } => ... }` binds the fields of `{owner.shown}`"] } else { [] }
    diag_error_at_notes("VariantSpread", VARIANT_SPREAD, "a variant literal cannot copy fields with `..{src}`", spread,
        "write every field, or match on `{src}` to bind its fields (copy-update is for struct literals, §2.16)", notes)
}

// Reverse-infer a generic-enum INSTANCE tid (`Tree[Int]`) from a variant
// construction, the enum analogue of tc_struct_lit_instance_tid. Given
// the bare enum tid, its decl node, the variant name, and the constructor's arg
// list, unify each declared payload field tid (evfield_pool, keyed on the
// variant's var_idx) against the inferred ctor arg type, collect the typevar binds
// in the enum's tparam order, and mint make_enum_instance_type. Falls back to the
// bare `enum_tid` when the enum is non-generic or no type-param bound to a concrete
// type — mirroring the struct path's has_concrete gate so an all-typevar / bare
// construction keeps the existing bare behavior unchanged. `args_sl` is the raw
// call/ctor argument sublist, and `payload_tids` the type tc_check_variant_payload_values
// answered for each of its arguments.
fn tc_enum_ctor_instance_tid(enum_tid: Int, decl: Int, var_idx: Int, args_sl: Int, payload_tids: List[Int]) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if decl == -1 { return enum_tid }
    let tparams_sl = node_type_params(decl)
    if tparams_sl == -1 || sublist_length(tparams_sl) == 0 { return enum_tid }
    if args_sl == -1 { return enum_tid }
    let mut binds: Map[Str, Int] = Map()
    let mut fi = 0
    while fi < sublist_length(args_sl) && fi < payload_tids.len() {
        let declared = tc_variant_payload(var_idx, args_sl, fi).field
        if declared != -1 {
            unify_typevar_binds(declared, payload_tids.get(fi).unwrap(), binds)
        }
        fi = fi + 1
    }
    // "Concrete" excludes a typevar AND TYPE_UNKNOWN — an all-typevar / all-unknown
    // instance carries no more information than the bare tid, so the bare path stays
    // authoritative (mirrors tc_struct_lit_instance_tid's has_concrete gate). An unbound
    // metavariable counts: it is a hole the expected type of the whole value fills, and the
    // boundary check reports it if nothing does.
    let mut has_concrete = 0
    let mut ci = 0
    while ci < sublist_length(tparams_sl) {
        let bound = binds.get(node_name(sublist_get(tparams_sl, ci))) ?? -1
        if bound != -1 && type_kind(bound) != TyKind.Typevar && type_kind(bound) != TyKind.Unknown { has_concrete = 1 }
        if bound != -1 && tc_is_unbound_metavar(tc_resolve(bound)) != 0 { has_concrete = 1 }
        // A variant whose payload mentions none of the enum's parameters binds nothing, so
        // the enclosing annotation is the only place they can come from. Without this the
        // construction kept the bare head, which names no instance and has no C layout.
        if bound == -1 && tc_hint_enum_slot(enum_tid, tparams_sl, ci) != -1 { has_concrete = 1 }
        ci = ci + 1
    }
    if has_concrete == 0 { return enum_tid }
    let mut arg_tids: List[Int] = []
    let mut ti = 0
    while ti < sublist_length(tparams_sl) {
        let tp = sublist_get(tparams_sl, ti)
        let tpname = node_name(tp)
        let bound = binds.get(tpname) ?? -1
        if bound != -1 {
            arg_tids.push(bound)
        } else {
            let h = tc_hint_enum_slot(enum_tid, tparams_sl, ti)
            if h != -1 {
                arg_tids.push(h)
            } else {
                arg_tids.push(make_typevar_bound(tpname, tp))
            }
        }
        ti = ti + 1
    }
    make_enum_instance_type(tc_instance_base_name(enum_tid), arg_tids)
}

// Struct-style analogue of tc_enum_ctor_instance_tid for a `Variant { field: val }`
// construction (a StructLit node). Unifies each declared payload field tid against
// the inferred value by FIELD NAME (lookup_evfield_type_by_name) rather than by
// position. Same bare-fallback / has_concrete contract.
// The enum-variant twin of tc_infer_struct_lit_field_values: `E.V { a: 1 }` answered its type
// from the variant name alone, so on every path that needs no reverse-inference the field
// VALUES were never inferred and carried no type. The declared field type is the value's hint,
// and a closure field value needs the same body walk a struct field's does — nothing else
// reaches it.
// @allow: publishing the field values' types IS this function's effect.
@allow(UnrestoredMutation)
// The field values of a construction that names no variant: typed with no hint, so nothing
// under the error goes untyped.
fn tc_infer_orphan_field_values(flds_sl: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if flds_sl == -1 { return }
    let mut fi = 0
    while fi < sublist_length(flds_sl) {
        let v = node_value(sublist_get(flds_sl, fi))
        if v != -1 && node_kind(v) == NodeKind.HandlerExpr { tc_check_body(v) }
        if v != -1 { let _ = tc_infer_unhinted(v) }
        fi = fi + 1
    }
}

fn tc_infer_enum_structlit_field_values(enum_tid: Int, vname: Str, flds_sl: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if flds_sl == -1 { return }
    let var_idx = get_variant_by_name(tc_enum_base_tid(enum_tid), vname)
    let mut fi = 0
    while fi < sublist_length(flds_sl) {
        let f = sublist_get(flds_sl, fi)
        let v = node_value(f)
        if v != -1 {
            let mut raw = -1
            if var_idx != -1 { raw = lookup_evfield_type_by_name(var_idx, node_name(f)) }
            // At an instance (`Tree[Option[Str]]`) a field is typed at the instance's arguments.
            let declared = if raw != -1 { resolve_alias_tid(tc_subst_evfield_from_instance(raw, enum_tid)) } else { -1 }
            // A closure or handler value is typed too, so tc_check_lit_field_values can hold it
            // to the field.
            if node_kind(v) == NodeKind.Closure && type_kind(declared) == TyKind.Fn {
                tc_check_struct_lit_fn_field(v, declared)
                let _ = infer_type(v)
            } else if node_kind(v) == NodeKind.HandlerExpr {
                tc_check_body(v)
                let _ = infer_type(v)
            } else {
                let saved_hint = tc_construct_hint
                if declared != -1 && tc_tid_is_no_info(declared) == 0 {
                    tc_construct_hint = declared
                    tc_seed_declared_field(raw, declared, v)
                }
                let vt = infer_type(v)
                tc_construct_hint = saved_hint
                if declared != -1 && tc_tid_is_no_info(declared) == 0 && tc_tid_has_unbound_metavar(vt) != 0 {
                    tc_unify(declared, vt)
                }
                if declared != -1 && tc_tid_is_no_info(declared) == 0 && tc_variant_fields_typed_at(var_idx, enum_tid) {
                    tc_pin_declared_into_value(declared, v, vt)
                }
            }
        }
        fi = fi + 1
    }
}

fn tc_enum_structlit_instance_tid(enum_tid: Int, decl: Int, vname: Str, flds_sl: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if decl == -1 {
        tc_infer_enum_structlit_field_values(enum_tid, vname, flds_sl)
        return enum_tid
    }
    let tparams_sl = node_type_params(decl)
    if tparams_sl == -1 || sublist_length(tparams_sl) == 0 {
        tc_infer_enum_structlit_field_values(enum_tid, vname, flds_sl)
        return enum_tid
    }
    if flds_sl == -1 { return enum_tid }
    let var_idx = get_variant_by_name(tc_enum_base_tid(enum_tid), vname)
    if var_idx == -1 {
        tc_infer_enum_structlit_field_values(enum_tid, vname, flds_sl)
        return enum_tid
    }
    let mut binds: Map[Str, Int] = Map()
    let mut fi = 0
    while fi < sublist_length(flds_sl) {
        let f = sublist_get(flds_sl, fi)
        let declared = lookup_evfield_type_by_name(var_idx, node_name(f))
        if declared != -1 {
            let at_inst = tc_field_target_hint(tc_instance_base_name(enum_tid), declared)
            tc_seed_declared_field(declared, at_inst, node_value(f))
            let ftid = tc_infer_field_value_under(at_inst, node_value(f))
            unify_typevar_binds(declared, ftid, binds)
        } else {
            // A field name the variant does not declare is still an expression that must carry
            // a type; the mismatch itself is reported elsewhere.
            infer_type(node_value(f))
        }
        fi = fi + 1
    }
    let mut has_concrete = 0
    let mut ci = 0
    while ci < sublist_length(tparams_sl) {
        let bound = binds.get(node_name(sublist_get(tparams_sl, ci))) ?? -1
        if bound != -1 && type_kind(bound) != TyKind.Typevar && type_kind(bound) != TyKind.Unknown { has_concrete = 1 }
        // As in tc_enum_ctor_instance_tid: an unbound metavariable is a hole the expected type
        // of the whole value fills.
        if bound != -1 && tc_is_unbound_metavar(tc_resolve(bound)) != 0 { has_concrete = 1 }
        // A variant whose payload mentions none of the enum's parameters binds nothing, so
        // the enclosing annotation is the only place they can come from. Without this the
        // construction kept the bare head, which names no instance and has no C layout.
        if bound == -1 && tc_hint_enum_slot(enum_tid, tparams_sl, ci) != -1 { has_concrete = 1 }
        ci = ci + 1
    }
    if has_concrete == 0 { return enum_tid }
    let mut arg_tids: List[Int] = []
    let mut ti = 0
    while ti < sublist_length(tparams_sl) {
        let tp = sublist_get(tparams_sl, ti)
        let bound = binds.get(node_name(tp)) ?? -1
        if bound != -1 {
            arg_tids.push(bound)
        } else {
            let h = tc_hint_enum_slot(enum_tid, tparams_sl, ti)
            if h != -1 {
                arg_tids.push(h)
            } else {
                arg_tids.push(make_typevar_bound(node_name(tp), tp))
            }
        }
        ti = ti + 1
    }
    make_enum_instance_type(tc_instance_base_name(enum_tid), arg_tids)
}

// When a generic-enum ctor slot is unbound after arg-unification (a subset variant
// like `Left(L)` leaves R untouched), the enclosing annotation (tc_construct_hint)
// may pin it. Return the hint's concrete slot tid at `ti`, or -1 unless the hint is
// a TyKind.Enum matching THIS enum by strip_module_qualifier(base name) AND arity. Hint
// fills gaps only; unify wins where it has evidence. An unrelated hint (Option[..],
// a different-named enum) is rejected.
fn tc_hint_enum_slot(enum_tid: Int, tparams_sl: Int, ti: Int) -> Int {
    if tc_construct_hint < 0 { return -1 }
    if tc_tid_is_enum(tc_construct_hint) == 0 { return -1 }
    // The base name, read from the pool, not the rendered string: rendering an enum
    // instance spells its args, so `Side[Int, Str]` and the `Side` it instantiates no
    // longer render alike, and a hint would stop matching the enum it pins.
    if tc_tid_struct(tc_construct_hint) != tc_tid_struct(enum_tid) { return -1 }
    // Arity: hint's arg count vs THIS enum's tparam count. The enum side MUST come
    // from sublist_length(tparams_sl) — the bare enum decl tid has params_count==0,
    // so tc_tid_struct_arg_count(enum_tid) would be 0 and never match.
    if tc_tid_struct_arg_count(tc_construct_hint) != sublist_length(tparams_sl) { return -1 }
    tc_tid_struct_arg_tid(tc_construct_hint, ti)
}

// A payload-less variant of a generic enum has no argument to infer its binders from, so
// each comes from the expected type or is a fresh metavariable a later use pins, as `None`
// does. Left bare, the head names no instance and has no C layout.
fn tc_nullary_variant_tid(enum_tid: Int, decl: Int, var_idx: Int) -> Int {
    if decl == -1 || var_idx == -1 { return enum_tid }
    if variant_field_count(var_idx) != 0 { return enum_tid }
    let tparams_sl = node_type_params(decl)
    if tparams_sl == -1 || sublist_length(tparams_sl) == 0 { return enum_tid }
    // An expectation with an open slot of its own names nothing, as for `None`.
    let open_hint = tc_construct_hint >= 0 && tc_tid_has_unbound_metavar(tc_construct_hint) != 0
    let mut arg_tids: List[Int] = []
    let mut ti = 0
    while ti < sublist_length(tparams_sl) {
        let h = if open_hint { -1 } else { tc_hint_enum_slot(enum_tid, tparams_sl, ti) }
        arg_tids.push(if h != -1 { h } else { make_metavar() })
        ti = ti + 1
    }
    make_enum_instance_type(tc_instance_base_name(enum_tid), arg_tids)
}

// Index of the first variant named `name` in evar_pool. This index is the
// `var_idx` key used by evfield_pool (registration stores var_idx =
// evar_pool.len() just before pushing the variant), so it lets variant_field_count
// look up the declared field count for that variant. Returns -1 if not found.
fn get_variant_var_idx(name: Str) -> Int {
    tc_first_variant_slot(name)
}

// Number of declared fields for the variant at the given evar_pool index, by
// counting evfield_pool entries keyed on that var_idx (mirrors the traversal in
// lookup_evfield_type_by_index). A bare variant with no payload has 0 fields.
fn variant_field_count(var_idx: Int) -> Int {
    let mut i = 0
    let mut count = 0
    while i < evfield_pool.len() {
        if evfield_pool.get(i).unwrap().var_idx == var_idx {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Iterative two-row Levenshtein edit distance between two strings.
fn str_levenshtein(a: Str, b: Str) -> Int {
    let alen = a.byte_len()
    let blen = b.byte_len()
    if alen == 0 { return blen }
    if blen == 0 { return alen }
    let mut prev: List[Int] = []
    let mut j = 0
    while j <= blen {
        prev.push(j)
        j = j + 1
    }
    let mut i = 0
    while i < alen {
        let mut curr: List[Int] = []
        curr.push(i + 1)
        let ac = a.byte_at(i)
        let mut k = 0
        while k < blen {
            let bc = b.byte_at(k)
            let cost = if ac == bc { 0 } else { 1 }
            let del = prev.get(k + 1).unwrap() + 1
            let ins = curr.get(k).unwrap() + 1
            let sub = prev.get(k).unwrap() + cost
            let mut best = del
            if ins < best { best = ins }
            if sub < best { best = sub }
            curr.push(best)
            k = k + 1
        }
        prev = curr
        i = i + 1
    }
    prev.get(blen).unwrap()
}

// Suggest the closest known variant name (as `Enum.Variant`) to `name`,
// scanning evar_pool. Returns "" when no candidate is within the confidence
// threshold, so a far-off typo gets no bogus suggestion.
fn suggest_variant(name: Str) -> Str {
    let mut best_dist = -1
    let mut best_enum = ""
    let mut best_var = ""
    let mut i = 0
    while i < evar_pool.len() {
        let ev = evar_pool.get(i).unwrap()
        let d = str_levenshtein(name, ev.name)
        if best_dist == -1 || d < best_dist {
            best_dist = d
            best_var = ev.name
            best_enum = type_to_str(ev.enum_id)
        }
        i = i + 1
    }
    if best_dist == -1 { return "" }
    let mut threshold = name.len() / 3
    if threshold < 1 { threshold = 1 }
    if best_dist > threshold { return "" }
    "{best_enum}.{best_var}"
}

// Suggest the closest known member of `mod_name` (a module key, e.g. "std_libc")
// to `member`, scanning tc_symbol_module for symbols whose source module equals
// `mod_name`. Returns "" when nothing is within the threshold, so a far-off typo
// gets no bogus suggestion. `pub` so codegen's module-qualified-call path (which
// has the scope-var guard `infer_type` lacks) can offer the suggestion.
//
// Threshold is stricter than suggest_variant's: a longer name (threshold > 1)
// must be edit-distance STRICTLY under member.len()/3, not merely <=. This keeps
// a single-char typo on a short name (`read_byte` -> `read_bytes`, dist 1) while
// rejecting a name that is a deferred *feature*, not a typo: `recvfrom_bytes`
// (14 chars, threshold 4) is exactly dist 4 from `recv_bytes` and must NOT
// suggest it (a UDP wrapper is post-v1, not a misspelling of TCP recv).
pub fn suggest_module_member(mod_name: Str, member: Str) -> Str {
    let mut best_dist = -1
    let mut best_name = ""
    let keys = tc_symbol_module.keys()
    let mut i = 0
    while i < keys.len() {
        let sym = keys.get(i).unwrap()
        if tc_symbol_module.get(sym).unwrap() == mod_name {
            let d = str_levenshtein(member, sym)
            if best_dist == -1 || d < best_dist {
                best_dist = d
                best_name = sym
            }
        }
        i = i + 1
    }
    if best_dist == -1 { return "" }
    let mut threshold = member.len() / 3
    if threshold < 1 { threshold = 1 }
    if best_dist > threshold { return "" }
    if threshold > 1 && best_dist >= threshold { return "" }
    best_name
}

// Whether `name` is a trait's identity, or the bare name of one that shares its name.
fn is_trait_name(name: Str) -> Int {
    let shared = "{name}@"
    let mut i = 0
    while i < tc_trait_names.len() {
        let key = tc_trait_names.get(i).unwrap()
        if key == name || key.starts_with(shared) {
            return 1
        }
        i = i + 1
    }
    0
}

// The method `method` as the trait `key` itself declares it, or -1.
fn tc_trait_method_decl(key: Str, method: Str) -> Int {
    let tr = tc_trait_node_idx.get(key) ?? -1
    if tr == -1 { return -1 }
    let methods_sl = node_methods(tr)
    if methods_sl == -1 { return -1 }
    let mut i = 0
    while i < sublist_length(methods_sl) {
        let m = sublist_get(methods_sl, i)
        if node_name(m) == method { return m }
        i = i + 1
    }
    -1
}

// The trait a call reached a method of, as its identity key; None for a call that reached
// no trait or impl method.
pub fn tc_call_trait(call_node: Int) -> Option[Str] {
    let block = tc_method_block.get(tc_call_decl_node(call_node)) ?? -1
    if block == -1 { return None }
    if node_kind(block) == NodeKind.ImplBlock { return Some(tc_impl_trait_id(block)) }
    Some(tc_trait_key_of(block))
}

// A call read through no trait may take an impl of any trait.
pub fn tc_impl_is_of_call_trait(im: Int, call_trait: Option[Str]) -> Bool {
    match call_trait {
        Some(key) => tc_impl_trait_id(im) == key
        None => true
    }
}

// The trait a `Trait.method(value, ..)` call names. The call's record answers when the trait
// declares the method; a method the compiler synthesizes (Display's `display`) has no
// declaration, so its qualifier is read in the module whose body holds the call.
pub fn tc_qualified_call_trait(call_node: Int, written: Str) -> Str {
    tc_call_trait(call_node) ?? tc_trait_ref_key(written, nr_current_module)
}

// Whether a qualifier names a trait, read as the qualified-call arm reads it.
pub fn tc_names_a_trait(name: Str) -> Bool {
    is_trait_name(name) != 0
}

// Does the trait's own DECLARATION list a method of this name? register_trait
// pushes "{trait}.{method}" per declared method, so this is an exact-name membership test —
// deliberately not a substring probe of tc_method_trait_names, whose values are " and
// "-joined and would make trait `A` look like an owner inside "AB and C".
//
// This is the gate for the qualified call `Trait.method(x)` naming a trait that does not
// define `method` AT ALL, which is a different question from "no impl fnsig exists for this
// receiver type": a declared method with no fnsig (an open default, an Iterator adapter,
// From/TryFrom's per-impl keys) must keep its existing answer rather than be rejected.
fn tc_trait_declares_method(trait_name: Str, method: Str) -> Int {
    let key = "{trait_name}.{method}"
    let mut i = 0
    while i < tc_trait_method_names.len() {
        if tc_trait_method_names.get(i).unwrap() == key {
            return 1
        }
        i = i + 1
    }
    0
}

// The compiler-known type names of §10.6 that no declaration in scope has taken. Every name
// here must be in that table. An undeclared `FfiScope` is known through
// tc_is_undeclared_ffi_scope instead, as it is not a name.
fn is_primitive_type(name: Str) -> Int {
    if tc_declaration_shadows_builtin(name) != 0 { return 0 }
    match name.byte_len() {
        2 => match name {
            "U8" => 1
            "I8" => 1
            "Fn" => 1
            _ => 0
        }
        3 => match name {
            "Int" => 1
            "F32" => 1
            "F64" => 1
            "Str" => 1
            "Map" => 1
            "Set" => 1
            "Ptr" => 1
            "U16" => 1
            "U32" => 1
            "U64" => 1
            "I16" => 1
            "I32" => 1
            "I64" => 1
            "Raw" => 1
            _ => 0
        }
        4 => match name {
            "Bool" => 1
            "Void" => 1
            "List" => 1
            "Char" => 1
            "Self" => 1
            _ => 0
        }
        5 => match name {
            "Float" => 1
            "Bytes" => 1
            "Tuple" => 1
            "Never" => 1
            _ => 0
        }
        6 => match name {
            "Option" => 1
            "Result" => 1
            "Handle" => 1
            _ => 0
        }
        7 => match name {
            "Channel" => 1
            "Handler" => 1
            _ => 0
        }
        8 => match name {
            "Iterator" => 1
            "Template" => 1
            _ => 0
        }
        13 => match name {
            "StringBuilder" => 1
            _ => 0
        }
        _ => 0
    }
}

fn is_known_type(name: Str) -> Int {
    if is_primitive_type(name) != 0 || tc_is_undeclared_ffi_scope(name) { return 1 }
    if tc_core_type_alias_target(name, nr_current_module) != "" { return 1 }
    if lookup_named_type(name) != -1 { return 1 }
    0
}

// Whether a bare name names a type: one of the compiler's own, or one the program declares.
// Published so that a later stage deciding whether a call's qualifier is a type reads this
// answer instead of remaking a narrower one from the declared types alone. A trait name is
// not a type and answers false here; a qualified trait call is its own reading.
pub fn tc_names_a_type(name: Str) -> Bool {
    is_known_type(name) != 0
}

// A method call's receiver. A bare name with no value under it that names a type is the
// qualifier of a static call (`Errno.from(3)`), not a read of the type's namesake variant,
// so it answers what every other type qualifier answers: no type.
fn tc_infer_receiver(recv: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if recv != -1 && node_kind(recv) == NodeKind.Ident {
        let name = node_name(recv)
        if is_variant_name(name) != 0 && tc_names_a_type(name) && tc_tid_is_no_info(nr_get_type(name)) != 0 { return -1 }
    }
    infer_type(recv)
}

// Impl method registry for name resolution
let mut nr_impl_type_names: List[Str] = []
let mut nr_impl_method_names: List[Str] = []
// The declaration node of entry i, or -1 for a method the compiler synthesizes and no
// source declares: a Display `display()`, a derived `clone`/`eq`/`cmp`/`hash`/`debug`.
let mut nr_impl_method_nodes: List[Int] = []
let mut nr_callable_field_names: List[Str] = []

// Method calls whose NAME resolves nowhere, found in Phase 1. Phase 1 cannot decide the
// severity: it has no receiver type, and W0501-vs-E0505 turns on exactly that. So it
// records the node and Phase 2 decides — the nodes it reports as E0505 land in
// tc_unresolved_method_hard, and whatever is left over is flushed as W0501 once inference
// is done, which is where the receiver types stop changing.
let mut nr_unresolved_method_nodes: List[Int] = []
let mut tc_unresolved_method_hard: Map[Int, Int] = Map()

// Mark a method call the inference pass could not type and did not report on: the name
// resolves somewhere in the program, so name resolution let it pass, but no arm here claims
// this receiver-and-method pair. Codegen's backstop is what names them, and it needs the
// program to reach it, so the total-stamp pass excuses these nodes rather than reporting a
// hole over the top of the report that is coming.
//
// Only an absence is marked. A node an earlier walk already typed keeps that type: the mark
// says "no arm claimed this", and an arm did.
fn tc_mark_unclaimed_call(node: Int) {
    if node == -1 { return }
    if node >= tc_node_tid.len() { return }
    if tc_tid_is_no_info(tc_lookup_node_tid(node)) == 0 { return }
    tc_node_tid.set(node, tc_unclaimed_call_tid())
}

// The calls that are STILL unclaimed. A branch of an if-expression is inferred once for the
// `if`'s own type, before tc_check_body walks that branch and binds the block's lets, so a
// tail whose receiver is one of those lets reads as untyped there and falls through; the
// second walk types it, and that walk overwrites the mark with the type it found. The marker
// therefore says "absent" by being present, and needs no second liveness question.
fn tc_unclaimed_call_nodes() -> List[Int] {
    let mut out: List[Int] = []
    let mut n = 0
    while n < tc_node_tid.len() {
        if tc_node_tid.get(n).unwrap() == tc_unclaimed_call_tid() { out.push(n) }
        n = n + 1
    }
    // In load order, which the ids of a recheck that kept nodes are not.
    if parser_load_order_moved() {
        let mut i = 1
        while i < out.len() {
            let v = out.get(i).unwrap()
            let r = node_load_rank(v)
            let mut j = i - 1
            while j >= 0 && node_load_rank(out.get(j).unwrap()) > r {
                out.set(j + 1, out.get(j).unwrap())
                j = j - 1
            }
            out.set(j + 1, v)
            i = i + 1
        }
    }
    out
}

pub fn tc_unresolved_call_count() -> Int { tc_unclaimed_call_nodes().len() }

// `with X as ctx` does not always bind X: for a BlockHandler the binder is what
// `enter()` returns, i.e. the impl's `type Context`. Resource type name -> the impl's Context
// AssocType node, filled from the same impl walk that fills the method registry below, since
// that loop already holds both the impl node and its trait name. The Context is kept as a node
// and resolved to a tid on demand — this registry is written in Phase 1, and a struct declared
// after the impl is not interned yet. A node rather than a name, because a name keeps only the
// head of `Handler[DB]`.
let mut nr_bh_context: Map[Str, Int] = Map()

fn is_callable_field_name(name: Str) -> Int {
    let mut i = 0
    while i < nr_callable_field_names.len() {
        if nr_callable_field_names.get(i).unwrap() == name { return 1 }
        i = i + 1
    }
    0
}

// The three registry lists are index-parallel: entry i is the triple (type, method,
// declaration). Every push must go through here, or a reader that walks one list and
// indexes another reads past the end.
fn nr_register_impl_method(type_name: Str, method: Str, decl_node: Int) {
    nr_impl_type_names.push(type_name)
    nr_impl_method_names.push(method)
    nr_impl_method_nodes.push(decl_node)
}

// Which declaration `type_name.method` names, or -1 if none does. The pair is the key: the
// same method name may be implemented for several receivers, so the name alone would answer
// one of them for every call.
fn nr_impl_method_decl(type_name: Str, method: Str) -> Int {
    let mut i = 0
    while i < nr_impl_type_names.len() {
        if nr_impl_type_names.get(i).unwrap() == type_name && nr_impl_method_names.get(i).unwrap() == method {
            return nr_impl_method_nodes.get(i).unwrap()
        }
        i = i + 1
    }
    -1
}

fn nr_has_impl_method(type_name: Str, method: Str) -> Int {
    let mut i = 0
    while i < nr_impl_type_names.len() {
        if nr_impl_type_names.get(i).unwrap() == type_name && nr_impl_method_names.get(i).unwrap() == method {
            return 1
        }
        i = i + 1
    }
    0
}

// Does this method NAME resolve to nothing anywhere in the program? A name-level fact,
// so it holds for every receiver: a name no builtin, no impl, no derive and no callable
// field supplies cannot be supplied by any type either. Phase 1 records the nodes that
// answer yes; Phase 2 turns the ones with a KNOWN receiver type into E0505 and leaves the
// rest as the soft W0501.
fn nr_method_name_unresolvable(method: Str) -> Int {
    if is_builtin_method(method) != 0 { return 0 }
    if is_variant_name(method) != 0 { return 0 }
    if is_callable_field_name(method) != 0 { return 0 }
    let mut i = 0
    while i < nr_impl_method_names.len() {
        if nr_impl_method_names.get(i).unwrap() == method { return 0 }
        i = i + 1
    }
    1
}

// Does this call name nothing the receiver can answer? Two ways to fail, and the receiver's
// kind separates them: a name that resolves NOWHERE in the program, and a builtin name that
// resolves on some other kind but not on this one. The impl registry is asked before the
// second refusal, so a declared method always outranks a closed builtin surface: no impl can
// target a builtin container today, and a name rule must not be what decides that.
fn tc_method_unavailable_on_receiver(obj_k: TyKind, method: Str) -> Int {
    if nr_method_name_unresolvable(method) != 0 { return 1 }
    if is_builtin_method(method) != 0 && is_builtin_method_on_receiver(obj_k, method) == 0 {
        if nr_has_impl_method(tk_name(obj_k), method) != 0 { return 0 }
        return 1
    }
    0
}

// The identifier alphabet a near-miss neighbour is drawn from. Method names are
// lowercase with underscores and the occasional digit.
fn tc_ident_alphabet() -> Str {
    "abcdefghijklmnopqrstuvwxyz_0123456789"
}

// Whether `cand` may be offered in place of `method` on a builtin receiver of kind `obj_k`.
// is_builtin_method answers per NAME, so on its own it offers `add` (an operator method) to a
// Set and `index_of` (a Str method) to a List. tc_builtin_method_arity is keyed on the pair
// and mirrors the dispatch arms row for row, so a name it claims for this kind is one the
// call would resolve. A swap of two equal letters, or a letter replaced by itself, rebuilds
// the written name, and that is never a suggestion.
fn tc_builtin_suggestion_ok(obj_k: TyKind, method: Str, cand: Str) -> Int {
    if cand == method { return 0 }
    if is_builtin_method_on_receiver(obj_k, cand) == 0 { return 0 }
    if tc_builtin_method_arity(obj_k, cand) < 0 { return 0 }
    1
}

// The closest BUILTIN method name one edit away from `method` that this receiver answers,
// or "" when there is none.
//
// Generated-and-probed rather than scanned, because is_builtin_method is a name chain, not
// a list, and cannot be enumerated. Probing it keeps ONE authority for "this builtin method
// exists"; a second copy of the 170-odd names to scan would drift from it, which is the
// failure this compiler has already paid for twice. The four edits are tried in order of how
// likely each is to be the typo the user made: transposition, deletion, substitution,
// insertion.
fn tc_builtin_method_edit1(obj_k: TyKind, method: Str) -> Str {
    let n = method.byte_len()
    // Two characters give too many neighbours for the match to mean anything.
    if n < 3 { return "" }
    let mut i = 0
    while i + 1 < n {
        let c = method.byte_slice(0, i).concat(method.byte_slice(i + 1, i + 2)).concat(method.byte_slice(i, i + 1)).concat(method.byte_slice(i + 2, n))
        if tc_builtin_suggestion_ok(obj_k, method, c) != 0 { return c }
        i = i + 1
    }
    i = 0
    while i < n {
        let c = method.byte_slice(0, i).concat(method.byte_slice(i + 1, n))
        if tc_builtin_suggestion_ok(obj_k, method, c) != 0 { return c }
        i = i + 1
    }
    let alpha = tc_ident_alphabet()
    let alen = alpha.byte_len()
    i = 0
    while i < n {
        let mut a = 0
        while a < alen {
            let c = method.byte_slice(0, i).concat(alpha.byte_slice(a, a + 1)).concat(method.byte_slice(i + 1, n))
            if tc_builtin_suggestion_ok(obj_k, method, c) != 0 { return c }
            a = a + 1
        }
        i = i + 1
    }
    i = 0
    while i <= n {
        let mut a = 0
        while a < alen {
            let c = method.byte_slice(0, i).concat(alpha.byte_slice(a, a + 1)).concat(method.byte_slice(i, n))
            if tc_builtin_suggestion_ok(obj_k, method, c) != 0 { return c }
            a = a + 1
        }
        i = i + 1
    }
    ""
}

// Near-miss suggestion for a method the receiver does not have. Candidates come only from
// the registries that ANSWER method resolution, so a suggestion always names something the
// compiler would accept on some receiver. Returns "" when nothing is close enough — a
// far-off name is a missing feature, not a misspelling.
//
// A declared type is asked about ITS OWN methods first: `f.dispaly()` on a type with an
// `impl Display` must suggest that impl's method, not a same-named builtin. The builtin
// surface is offered only for a builtin receiver, where no impl registry applies.
fn tc_suggest_method(obj_k: TyKind, tname: Str, method: Str) -> Str {
    // The registry stores the impl head (`List` for `impl Trait for List[Int]`), while a
    // builtin receiver reaches here spelled with its arguments, so match on the head.
    let mut head = tname
    match tname.byte_index_of("[", 0) {
        Some(br) => {
            if br > 0 { head = tname.byte_slice(0, br) }
        }
        None => {}
    }
    let mut best_dist = -1
    let mut best_name = ""
    let mut i = 0
    while i < nr_impl_type_names.len() {
        if nr_impl_type_names.get(i).unwrap() == head {
            let cand = nr_impl_method_names.get(i).unwrap()
            let d = str_levenshtein(method, cand)
            if best_dist == -1 || d < best_dist {
                best_dist = d
                best_name = cand
            }
        }
        i = i + 1
    }
    if best_dist != -1 {
        let mut threshold = method.len() / 3
        if threshold < 1 { threshold = 1 }
        if best_dist <= threshold {
            if threshold <= 1 || best_dist < threshold { return best_name }
        }
    }
    if obj_k == TyKind.Struct || obj_k == TyKind.Enum { return "" }
    tc_builtin_method_edit1(obj_k, method)
}

// What `List[T].contains` and `List[T].index_of` need of their element: each walks the
// elements comparing each with `==`, so `T` must be `Eq` (sections/03_types.md, *The
// `Contains` Trait* and *The `ListOps` Trait*). The answer is the same chain `==` reports,
// empty when the element is `Eq`.
//
// An element nothing has chosen yet is not refused. There is no type to name as lacking the
// comparison, and the instance the call is monomorphised to meets this same gate once its
// element is decided.
fn tc_list_scan_elem_need(elem: Int) -> List[Int] {
    let k = type_kind(elem)
    if k == TyKind.Unknown { return [] }
    if tc_tid_has_unbound_metavar(elem) != 0 { return [] }
    tc_eq_need(elem, [])
}

// Refused as hard, the way every other method the receiver does not answer is, so inference
// does not go on to flush the softer W0501 about the same call. The answer is poisoned
// rather than absent, so a declared Bool over the call unifies with the recovery tid instead
// of drawing a second error about a type the program never had.
fn tc_refuse_list_scan(node: Int, obj_t: Int, need: List[Int], method: Str) -> Int ! Diag.Report {
    tc_unresolved_method_hard.insert(node, 1)
    let leaf = need.get(need.len() - 1).unwrap()
    let mut help = "`.{method}` compares elements with `==`, and `{type_to_str(leaf)}` does not implement `{tc_core_trait_shown("Eq")}`"
    let k = type_kind(leaf)
    if k == TyKind.Struct || k == TyKind.Enum {
        let base = if k == TyKind.Struct { tc_struct_base_tid(leaf) } else { tc_enum_base_tid(leaf) }
        let bname = strip_module_qualifier(tc_type_name(base))
        let imps = tc_derive_fix_imports(["Eq"], bname)
        let sep = if imps == "" { "; " } else { "\n" }
        help = "{help}{sep}{imps}add `@derive({tc_derive_arg_for("Eq", bname)})` to `type {bname}`"
    }
    if k == TyKind.Typevar {
        let fix = tc_core_bound_fix("Eq", type_to_str(leaf))
        let sep = if fix.contains("\n") { "\n" } else { "; " }
        help = "{help}{sep}{fix}"
    }
    diag_error_at("UnresolvedMethod", UNRESOLVED_METHOD,
        "unresolved method `.{method}` on type {type_to_str(obj_t)}", node, help)
    tc_error_recovery_tid()
}

// The help line for an unresolved method: the rename note the resolver already carries for
// a renamed List operation, else the near-miss suggestion, else nothing.
fn tc_unresolved_method_help(obj_k: TyKind, tname: Str, method: Str) -> Str {
    if method == "display" {
        return "add an `impl Display for {tname}` (with `fn fmt(self, sb: StringBuilder)`)"
    }
    if obj_k == TyKind.List {
        let rename = tc_list_rename_help(method)
        if rename != "" { return rename }
    }
    if obj_k == TyKind.Str {
        let removed = tc_str_removed_method_help(method)
        if removed != "" { return removed }
    }
    // A Map is the one receiver where the near-miss neighbour of `set` is `get`, which reads
    // the entry the caller meant to write. Name the mutator instead.
    if obj_k == TyKind.Map && method == "set" {
        return "a Map is written with `.insert(key, value)`"
    }
    // `add` is what most languages call it, and it is no typo, so no near-miss reaches it.
    if obj_k == TyKind.Set && method == "add" {
        return "a Set is written with `.insert(value)`"
    }
    let near = tc_suggest_method(obj_k, tname, method)
    // Naming the method the caller already wrote sends them in a circle.
    if near != "" && near != method { return "did you mean `.{near}`?" }
    ""
}

// A receiver whose type the front end KNOWS. Struct and Enum are absent because their own
// gate answers them earlier, with the impl registries in hand. Unknown and Typevar are
// absent because there is no type to name as lacking the method. The rest are absent
// because their method surface is not modelled here at all (Fn, Handle, Handler, Channel,
// Ptr, Template, FFIScope), so silence there is honest rather than fail-open.
fn tc_recv_type_is_known(obj_k: TyKind) -> Int {
    if obj_k == TyKind.Int || obj_k == TyKind.Float || obj_k == TyKind.Bool { return 1 }
    if obj_k == TyKind.Str || obj_k == TyKind.Char { return 1 }
    if obj_k == TyKind.I8 || obj_k == TyKind.I16 || obj_k == TyKind.I32 { return 1 }
    if obj_k == TyKind.U8 || obj_k == TyKind.U16 || obj_k == TyKind.U32 || obj_k == TyKind.U64 { return 1 }
    if obj_k == TyKind.List || obj_k == TyKind.Map || obj_k == TyKind.Set { return 1 }
    if obj_k == TyKind.Bytes || obj_k == TyKind.StringBuilder { return 1 }
    if obj_k == TyKind.Option || obj_k == TyKind.Result { return 1 }
    if obj_k == TyKind.Tuple || obj_k == TyKind.Iterator { return 1 }
    0
}

// Known KIND is not enough: `Map[?, ?]` before its first insert is a Map, but naming it in a
// diagnostic names a type the program never had, and inference visits the same node again
// once the holes are filled — two errors for one call. A receiver counts as known only when
// its type is determined all the way down, which is also the reading §3c.4 forces: a hole
// is a type the compiler does not know, so the honest report there is the soft warning.
fn tc_recv_type_is_determined(obj_k: TyKind, obj_t: Int) -> Int {
    if tc_recv_type_is_known(obj_k) == 0 { return 0 }
    if tc_tid_has_unbound_metavar(obj_t) != 0 { return 0 }
    if tc_tid_has_unknown(obj_t) != 0 { return 0 }
    if tc_tid_has_bare_typevar(obj_t) != 0 { return 0 }
    1
}

// ── Name resolution walker ──────────────────────────────────────────

// A module-scope value must not take the name of a variant of a prelude enum or of an enum
// its own package declares (sections/02_syntax.md §2.12.1). A dependency's variant is not
// covered: there the value comes first at a bare use (sections/03_types.md §3.4).
fn tc_check_values_named_like_variants(program: Int) ! Diag.Report {
    let fns = node_params(program)
    if fns != -1 {
        let mut i = 0
        while i < sublist_length(fns) {
            let f = sublist_get(fns, i)
            tc_check_value_named_like_variant(node_name(f), f)
            i = i + 1
        }
    }
    let lets = node_stmts(program)
    if lets != -1 {
        let mut i = 0
        while i < sublist_length(lets) {
            let l = sublist_get(lets, i)
            // One diagnostic per declaration, so a destructuring `let` stops at its first.
            for bound in tc_module_let_bound_names(l) {
                if tc_check_value_named_like_variant(bound, l) { break }
            }
            i = i + 1
        }
    }
}

// Reports E1016 for the value `decl` binds under `name` when that name is a colliding
// variant, naming the first such variant; true when it reported.
fn tc_check_value_named_like_variant(name: Str, decl: Int) -> Bool ! Diag.Report {
    match tc_prelude_carrier_of(name) {
        Some(k) => {
            tc_report_prelude_variant_collision(name, tc_prelude_carrier_name(k), decl)
            return true
        }
        None => {}
    }
    let vmod = node_module(decl)
    for slot in evar_slots_by_name.get(name) ?? [] {
        let enum_decl = evar_pool.get(slot).unwrap().enum_decl
        let emod = node_module(enum_decl)
        if tc_prelude_modules.contains_key(emod) {
            tc_report_prelude_variant_collision(name, node_name(enum_decl), decl)
            return true
        }
        if tc_same_package(vmod, emod) {
            let qual = "{node_name(enum_decl)}.{name}"
            let shown = tc_module_display_name(emod)
            let vnode = tc_variant_decl_node(slot)
            let at = "{diag_file_for_node(vnode)}:{node_line(vnode)}:{node_col(vnode)}"
            diag_error_at_notes("DuplicateModuleBinding", DUPLICATE_MODULE_BINDING,
                "`{name}` collides with variant `{qual}` (module `{shown}`)", decl,
                "rename the value; a bare `{name}` in this package must have one meaning",
                ["variant `{qual}` is declared at {at}"])
            return true
        }
    }
    false
}

fn tc_report_prelude_variant_collision(name: Str, enum_name: Str, decl: Int) ! Diag.Report {
    diag_error_at_notes("DuplicateModuleBinding", DUPLICATE_MODULE_BINDING,
        "`{name}` collides with variant `{enum_name}.{name}` (prelude)", decl, "rename the value",
        ["`{name}` is a variant of the prelude type `{enum_name}`", "the variants of a prelude enum count as declared in every module"])
}

fn resolve_names(program: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    nr_scope_names = []
    nr_scope_muts = []
    nr_scope_types = []
    nr_scope_reads = []
    nr_scope_writes = []
    nr_scope_nodes = []
    nr_scope_captured = []
    nr_scope_prev = []
    nr_name_top.clear()
    nr_scope_frames = []
    nr_scope_depth = 0
    nr_loop_depth = 0
    nr_in_closure_depth = 0
    nr_with_ptr_depth = 0
    nr_warn_unused = 1
    nr_impl_type_names = []
    nr_impl_method_names = []
    nr_impl_method_nodes = []
    nr_bh_context = Map()
    nr_private_imports = Map()
    nr_name_source_module = Map()
    // Bare-name answers cached by the passes before this one may predate the prelude's
    // free-function table, so they are asked again here.
    nr_forget_answers()
    tc_call_decl = Map()
    tc_global_read_decl = Map()
    tc_local_binder = Map()
    nr_push_scope()

    // Build private import set: imported non-pub fns, types, lets
    // A name is private only if no pub definition exists for it
    let mut nr_pub_names: Map[Str, Int] = Map()

    // First pass: collect all pub imported names
    // Items that are pub but excluded by selective imports are treated as private
    let fns_sl_priv = node_params(program)
    if fns_sl_priv != -1 {
        let mut i = 0
        while i < sublist_length(fns_sl_priv) {
            let fn_node = sublist_get(fns_sl_priv, i)
            let fn_mod = node_module(fn_node)
            if fn_mod != "" && node_is_pub(fn_node) != 0 {
                nr_pub_names.insert(node_name(fn_node), 1)
            }
            i = i + 1
        }
    }
    let types_sl_priv = node_fields(program)
    if types_sl_priv != -1 {
        let mut i = 0
        while i < sublist_length(types_sl_priv) {
            let td = sublist_get(types_sl_priv, i)
            let td_mod = node_module(td)
            if td_mod != "" && node_is_pub(td) != 0 {
                nr_pub_names.insert(node_name(td), 1)
                let td_flds = node_fields(td)
                if td_flds != -1 && sublist_length(td_flds) > 0 {
                    if node_kind(sublist_get(td_flds, 0)) == NodeKind.TypeVariant {
                        let mut vi = 0
                        while vi < sublist_length(td_flds) {
                            nr_pub_names.insert(node_name(sublist_get(td_flds, vi)), 1)
                            vi = vi + 1
                        }
                    }
                }
            }
            i = i + 1
        }
    }
    let traits_sl_priv = node_arms(program)
    if traits_sl_priv != -1 {
        let mut i = 0
        while i < sublist_length(traits_sl_priv) {
            let tr = sublist_get(traits_sl_priv, i)
            let tr_mod = node_module(tr)
            if tr_mod != "" && node_is_pub(tr) != 0 {
                nr_pub_names.insert(node_name(tr), 1)
            }
            i = i + 1
        }
    }
    let lets_sl_priv = node_stmts(program)
    if lets_sl_priv != -1 {
        let mut i = 0
        while i < sublist_length(lets_sl_priv) {
            let l = sublist_get(lets_sl_priv, i)
            let l_mod = node_module(l)
            if l_mod != "" && node_is_pub(l) != 0 {
                nr_pub_names.insert(node_name(l), 1)
            }
            i = i + 1
        }
    }

    // Second pass: register private names (skip if a pub version exists)
    // Value format: "|mod1|mod2|" so contains("|modX|") works for same-module check
    if fns_sl_priv != -1 {
        let mut i = 0
        while i < sublist_length(fns_sl_priv) {
            let fn_node = sublist_get(fns_sl_priv, i)
            let fn_name = node_name(fn_node)
            let mod_name = node_module(fn_node)
            if mod_name != "" && node_is_pub(fn_node) == 0 && nr_pub_names.contains_key(fn_name) == 0 {
                nr_register_private(fn_name, mod_name)
            }
            i = i + 1
        }
    }
    if types_sl_priv != -1 {
        let mut i = 0
        while i < sublist_length(types_sl_priv) {
            let td = sublist_get(types_sl_priv, i)
            let td_name = node_name(td)
            let mod_name = node_module(td)
            if mod_name != "" && node_is_pub(td) == 0 && nr_pub_names.contains_key(td_name) == 0 {
                nr_register_private(td_name, mod_name)
                let td_flds = node_fields(td)
                if td_flds != -1 && sublist_length(td_flds) > 0 {
                    if node_kind(sublist_get(td_flds, 0)) == NodeKind.TypeVariant {
                        let mut vi = 0
                        while vi < sublist_length(td_flds) {
                            let vname = node_name(sublist_get(td_flds, vi))
                            // A variant named like a builtin (a primitive type like
                            // `Char`, or a builtin variant like `Ok`/`Err`/`Some`)
                            // must never be registered private — it would poison the
                            // builtin's resolution in every module.
                            if nr_pub_names.contains_key(vname) == 0 && is_builtin_name(vname) == 0 {
                                nr_register_private(vname, mod_name)
                            }
                            vi = vi + 1
                        }
                    }
                }
            }
            i = i + 1
        }
    }
    if traits_sl_priv != -1 {
        let mut i = 0
        while i < sublist_length(traits_sl_priv) {
            let tr = sublist_get(traits_sl_priv, i)
            let tr_name = node_name(tr)
            let mod_name = node_module(tr)
            if mod_name != "" && node_is_pub(tr) == 0 && nr_pub_names.contains_key(tr_name) == 0 {
                nr_register_private(tr_name, mod_name)
            }
            i = i + 1
        }
    }
    if lets_sl_priv != -1 {
        let mut i = 0
        while i < sublist_length(lets_sl_priv) {
            let l = sublist_get(lets_sl_priv, i)
            let l_name = node_name(l)
            let mod_name = node_module(l)
            if mod_name != "" && node_is_pub(l) == 0 && nr_pub_names.contains_key(l_name) == 0 {
                nr_register_private(l_name, mod_name)
            }
            i = i + 1
        }
    }

    tc_check_values_named_like_variants(program)

    // Pre-collect __main__ names to suppress ambiguity when local defs shadow
    let mut main_names: Map[Str, Int] = Map()
    let pre_fns = node_params(program)
    if pre_fns != -1 {
        let mut i = 0
        while i < sublist_length(pre_fns) {
            let fn_node = sublist_get(pre_fns, i)
            if node_module(fn_node) == "__main__" {
                main_names.insert(node_name(fn_node), 1)
            }
            i = i + 1
        }
    }
    let pre_lets = node_stmts(program)
    if pre_lets != -1 {
        let mut i = 0
        while i < sublist_length(pre_lets) {
            let l = sublist_get(pre_lets, i)
            if node_module(l) == "__main__" {
                main_names.insert(node_name(l), 1)
            }
            i = i + 1
        }
    }

    // Register all top-level let binding names
    let lets_sl = node_stmts(program)
    if lets_sl != -1 {
        let mut i = 0
        while i < sublist_length(lets_sl) {
            let l = sublist_get(lets_sl, i)
            let l_mod = node_module(l)
            let bound = tc_module_let_bound_names(l)
            let mut bi = 0
            while bi < bound.len() {
                let l_name = bound.get(bi).unwrap()
                nr_check_ambiguity(l_name, l_mod, main_names)
                nr_define(l_name)
                bi = bi + 1
            }
            i = i + 1
        }
    }

    // Register all function names in scope
    let fns_sl = node_params(program)
    if fns_sl != -1 {
        let mut i = 0
        while i < sublist_length(fns_sl) {
            let fn_node = sublist_get(fns_sl, i)
            let fn_name = node_name(fn_node)
            let fn_mod = node_module(fn_node)
            nr_check_ambiguity(fn_name, fn_mod, main_names)
            nr_define(fn_name)
            i = i + 1
        }
    }

    // Register impl methods for method call resolution
    let impls_sl = node_methods(program)
    if impls_sl != -1 {
        let mut i = 0
        while i < sublist_length(impls_sl) {
            let im = sublist_get(impls_sl, i)
            let impl_type = tc_impl_target_name(im)
            let methods_sl = node_methods(im)
            if methods_sl != -1 {
                let mut j = 0
                while j < sublist_length(methods_sl) {
                    let m = sublist_get(methods_sl, j)
                    nr_register_impl_method(impl_type, node_name(m), m)
                    j = j + 1
                }
            }
            // The compiler synthesizes a sealed display() for every Display
            // impl; register it so calls resolve.
            if tc_impl_trait_id(im) == "Display" {
                nr_register_impl_method(impl_type, "display", -1)
            }
            // A Closeable's Context is the receiver itself, so its binder is the item's own
            // type, instance arguments and all.
            if tc_impl_trait_id(im) == "BlockHandler" && !impl_provided_by_closeable(im) {
                let ctx_sl = node_assoc_types(im)
                if ctx_sl != -1 {
                    let mut ai = 0
                    while ai < sublist_length(ctx_sl) {
                        let at_node = sublist_get(ctx_sl, ai)
                        if node_name(at_node) == "Context" {
                            nr_bh_context.insert(impl_type, at_node)
                        }
                        ai = ai + 1
                    }
                }
            }
            i = i + 1
        }
    }

    // Register @derive-generated method names so derived calls don't trip W0501.
    // Mirrors register_derive_annotations in src/codegen_derive.bl (runs after typecheck).
    let derive_types_sl = node_fields(program)
    if derive_types_sl != -1 {
        let mut i = 0
        while i < sublist_length(derive_types_sl) {
            let td = sublist_get(derive_types_sl, i)
            let dtname = tc_nominal_type_name(td)
            if tc_decl_derives(td, "Clone") != 0 { nr_register_impl_method(dtname, "clone", -1) }
            if tc_decl_derives(td, "Eq") != 0 { nr_register_impl_method(dtname, "eq", -1) }
            if tc_decl_derives(td, "Ord") != 0 { nr_register_impl_method(dtname, "cmp", -1) }
            if tc_decl_derives(td, "Hash") != 0 { nr_register_impl_method(dtname, "hash", -1) }
            if tc_decl_derives(td, "Debug") != 0 { nr_register_impl_method(dtname, "debug", -1) }
            if tc_decl_derives(td, "Serialize") != 0 { nr_register_impl_method(dtname, "to_json", -1) }
            if tc_decl_derives(td, "Deserialize") != 0 { nr_register_impl_method(dtname, "from_json", -1) }
            i = i + 1
        }
    }

    // Walk the type declarations. Every other annotation position reaches
    // nr_check_type_ref through nr_check_fn, so a name nothing declares is reported there.
    // A declaration's own annotations are not in a function, so without this walk a struct
    // field, an enum-variant payload or an alias underlying named no declared type at all
    // and lowered to a fresh type variable instead.
    let nr_types_sl = node_fields(program)
    if nr_types_sl != -1 {
        let mut i = 0
        while i < sublist_length(nr_types_sl) {
            let td = sublist_get(nr_types_sl, i)
            nr_current_module = node_module(td)
            nr_check_type_decl(td)
            nr_check_field_defaults(td)
            i = i + 1
        }
    }

    // Walk each module-global initializer. A call written there is a call like any other and
    // owes the same answer: which declaration it reaches. It sits in no function body, no impl
    // method and no test block, so without this walk it was never visited, and the later passes
    // that READ the resolved declaration rather than re-deriving a callee got nothing.
    let nr_globals_sl = node_stmts(program)
    if nr_globals_sl != -1 {
        let mut i = 0
        while i < sublist_length(nr_globals_sl) {
            let g = sublist_get(nr_globals_sl, i)
            let g_init = node_value(g)
            if g_init != -1 {
                nr_current_module = node_module(g)
                nr_check_node(g_init)
            }
            i = i + 1
        }
    }

    // Walk each function body
    if fns_sl != -1 {
        let mut i = 0
        while i < sublist_length(fns_sl) {
            let fn_node = sublist_get(fns_sl, i)
            nr_current_module = node_module(fn_node)
            nr_check_fn(fn_node)
            i = i + 1
        }
    }

    // Walk each impl method body
    if impls_sl != -1 {
        let mut i = 0
        while i < sublist_length(impls_sl) {
            let im = sublist_get(impls_sl, i)
            nr_current_module = node_module(im)
            nr_check_impl_trait_ref(im)
            let methods_sl = node_methods(im)
            let impl_binders_sl = node_impl_binders(im)
            tc_push_tparam_scope(impl_binders_sl)
            nr_check_binder_bounds(impl_binders_sl)
            nr_check_binder_bounds(node_impl_where_bounds(im))
            if methods_sl != -1 {
                let mut j = 0
                while j < sublist_length(methods_sl) {
                    nr_check_fn(sublist_get(methods_sl, j))
                    j = j + 1
                }
            }
            tc_pop_tparam_scope(impl_binders_sl)
            i = i + 1
        }
    }

    nr_check_trait_method_defaults(node_arms(program))

    // A derived operation's body is a function of its own (§4.7.1). It names no handler of
    // its own, so `default` does not resolve in it.
    for op in effect_derived_ops(program) {
        nr_current_module = tc_body_module(op)
        nr_check_fn(op)
    }

    // Walk test block bodies for unused import detection
    let tests_sl = node_captures(program)
    if tests_sl != -1 {
        nr_current_module = "__main__"
        nr_check_test_bodies(tests_sl)
    }

    nr_pop_scope()
}

// The trait an impl header names is read as a bound's is. A name no trait declares is
// validate_trait_impls' report, and a compiler-known trait with no declaration has nothing to
// import.
fn nr_check_impl_trait_ref(im: Int) ! TypeCheck.Resolve, Diag.Report {
    let trait_name = node_trait_name(im)
    if trait_name == "" { return }
    let trait_id = tc_impl_trait_id(im)
    if is_trait_name(trait_id) == 0 { return }
    if tc_undeclared_trait_names().contains(trait_id) { return }
    if tc_core_alias_target(trait_name, node_module(im)) != "" { return }
    nr_check_type_ref(trait_name, im)
}

// A call through a bound fills a default from the trait's declaration, so each default is
// read here, in the trait's module and before any parameter is in scope, as a function's is.
// The bounds on the trait's and each method's own type parameters are read here too.
fn nr_check_trait_method_defaults(traits_sl: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if traits_sl == -1 { return }
    let mut i = 0
    while i < sublist_length(traits_sl) {
        let tr = sublist_get(traits_sl, i)
        let methods_sl = node_methods(tr)
        nr_current_module = node_module(tr)
        tc_push_tparam_scope(node_type_params(tr))
        nr_check_binder_bounds(node_type_params(tr))
        if methods_sl != -1 {
            let mut j = 0
            while j < sublist_length(methods_sl) {
                let m = sublist_get(methods_sl, j)
                let params_sl = node_params(m)
                if params_sl != -1 {
                    let mut d = 0
                    while d < sublist_length(params_sl) {
                        nr_check_node(node_value(sublist_get(params_sl, d)))
                        d = d + 1
                    }
                }
                tc_push_tparam_scope(node_type_params(m))
                nr_check_binder_bounds(node_type_params(m))
                tc_pop_tparam_scope(node_type_params(m))
                j = j + 1
            }
        }
        tc_pop_tparam_scope(node_type_params(tr))
        i = i + 1
    }
}

// The let arm infers a call initializer during this walk, and the test-only fences
// it can reach ask whether the code is lexically in a test.
fn nr_check_test_bodies(tests_sl: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let prev_in_test_lex = tc_in_test_lexical
    tc_in_test_lexical = 1
    nr_check_test_bodies_in_test(tests_sl)
    tc_in_test_lexical = prev_in_test_lex
}

fn nr_check_test_bodies_in_test(tests_sl: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let mut i = 0
    while i < sublist_length(tests_sl) {
        let tb = sublist_get(tests_sl, i)
        let tbody = node_body(tb)
        if tbody != -1 {
            nr_check_node(tbody)
        }
        i = i + 1
    }
}

// The declaration's own type parameters are in scope for every annotation it writes, so
// they are pushed for the walk: `[T]` declares `T`, and `T` is then a type, not a gap.
fn nr_check_type_decl(td: Int) ! TypeCheck.Resolve, Diag.Report {
    let tparams = node_type_params(td)
    tc_push_tparam_scope(tparams)
    nr_check_binder_bounds(tparams)
    // A type alias keeps its underlying annotation in the value slot and has no fields.
    let alias_ann = node_value(td)
    if alias_ann != -1 {
        nr_check_type_ann_visibility(alias_ann)
    }
    let is_ffi_struct = has_annotation(td, "ffi.struct")
    let flds = node_fields(td)
    if flds != -1 {
        let mut i = 0
        while i < sublist_length(flds) {
            let f = sublist_get(flds, i)
            if node_kind(f) == NodeKind.TypeVariant {
                let payload = node_fields(f)
                if payload != -1 {
                    let mut j = 0
                    while j < sublist_length(payload) {
                        nr_check_type_ann_visibility(node_value(sublist_get(payload, j)))
                        j = j + 1
                    }
                }
            } else if is_ffi_struct == 0 || tc_compiler_known_type_meant(node_name(node_value(f)), node_value(f)) != "Buf" {
                // A Buf field of an @ffi.struct is reported as E0822 alone, in resolve_struct_fields.
                nr_check_type_ann_visibility(node_value(f))
            }
            i = i + 1
        }
    }
    tc_pop_tparam_scope(tparams)
}

// A field default is read in the module that declares the type, whichever literal leaves the
// field out, so its names are resolved here, once, and not at each literal.
fn nr_check_field_defaults(td: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let flds = node_fields(td)
    if flds == -1 { return }
    let tparams = node_type_params(td)
    tc_push_tparam_scope(tparams)
    let mut i = 0
    while i < sublist_length(flds) {
        let f = sublist_get(flds, i)
        if node_kind(f) == NodeKind.TypeField { nr_check_node(node_condition(f)) }
        i = i + 1
    }
    tc_pop_tparam_scope(tparams)
}

fn nr_check_fn(fn_node: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    // Before the scope, because the warnings this walk raises are raised by CLOSING it.
    diag_enter_allows(fn_node)
    nr_check_fn_as_current(fn_node)
    diag_exit_allows()
}

// This walk raises diagnostics that read the enclosing function's annotations, and it
// runs before tc_check_fn, which is the other writer of this.
fn nr_check_fn_as_current(fn_node: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let prev_fn_node = tc_current_fn_node
    tc_current_fn_node = fn_node
    nr_check_fn_scope(fn_node)
    tc_current_fn_node = prev_fn_node
}

fn nr_check_fn_scope(fn_node: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    nr_push_scope()
    // Bind this fn's own type params so a single-letter annotation resolves as a
    // declared type variable rather than an unknown type. Enclosing impl binders
    // are already pushed by the caller.
    let fn_tparams = node_type_params(fn_node)
    tc_push_tparam_scope(fn_tparams)
    nr_check_binder_bounds(fn_tparams)
    let nr_is_ffi = has_annotation(fn_node, "ffi")
    let params_sl = node_params(fn_node)
    // A default is read where it is written, before any parameter is in scope: a call that
    // leaves the argument out has none of them to give it.
    if params_sl != -1 {
        let mut d = 0
        while d < sublist_length(params_sl) {
            nr_check_node(node_value(sublist_get(params_sl, d)))
            d = d + 1
        }
    }
    if params_sl != -1 && nr_is_ffi == 0 {
        let mut i = 0
        while i < sublist_length(params_sl) {
            let p = sublist_get(params_sl, i)
            nr_define_at(node_name(p), p)
            let ptype_ann = node_type_ann(p)
            if ptype_ann != -1 {
                nr_check_type_ann_visibility(ptype_ann)
            } else {
                nr_check_type_ref(node_type_name(p), p)
            }
            // A LetBinding below eagerly infers its value's type, and a Call there
            // needs a typed local to see a closure param shadowing a same-named
            // global fn, or it falls through to the global's arity instead.
            nr_set_last_type(resolve_param_type(p))
            i = i + 1
        }
    }
    let ret_ann = node_type_ann(fn_node)
    if ret_ann != -1 {
        nr_check_type_ann_visibility(ret_ann)
    } else {
        let ret_str = node_return_type(fn_node)
        if ret_str != "" {
            nr_check_type_ref(ret_str, fn_node)
        }
    }
    if nr_is_ffi == 0 {
        let body = node_body(fn_node)
        if body != -1 {
            nr_check_node(body)
        }
    }
    tc_pop_tparam_scope(fn_tparams)
    nr_pop_scope()
}

// The bounds a list of binders carries (`[U: Tr[Int]]`, or an impl's `where T: Tr[Int]`).
// A bound's trait arguments are part of the bound, so they are counted against the trait and
// resolved here, where the bound is written, whether or not any call ever reaches it.
fn nr_check_binder_bounds(binders_sl: Int) ! TypeCheck.Resolve, Diag.Report {
    if binders_sl == -1 { return }
    let mut i = 0
    while i < sublist_length(binders_sl) {
        let bounds = node_elements(sublist_get(binders_sl, i))
        if bounds != -1 {
            let mut j = 0
            while j < sublist_length(bounds) {
                nr_check_bound_args(sublist_get(bounds, j))
                j = j + 1
            }
        }
        i = i + 1
    }
}

fn nr_check_bound_args(bound: Int) ! TypeCheck.Resolve, Diag.Report {
    let written = node_name(bound)
    let trait_name = tc_bound_trait(bound)
    // A bound names a trait, so a name no trait declares gets the impl header's error.
    let undeclared = tc_undeclared_trait_names().contains(trait_name)
    if is_trait_name(trait_name) == 0 && !undeclared {
        diag_error_at("TraitContract", TRAIT_CONTRACT_904, "trait `{written}` is not defined", bound, "check the trait name or define `trait {strip_module_qualifier(written)} \{ ... }`")
        return
    }
    // A compiler-known trait with no declaration has nothing to import.
    if !undeclared && tc_core_alias_target(written, node_module(bound)) == "" { nr_check_type_ref(written, bound) }
    let args_sl = node_elements(bound)
    let got = if args_sl == -1 { 0 } else { sublist_length(args_sl) }
    let want = tc_trait_tparam_count_idx.get(trait_name) ?? -1
    if want >= 0 && got != want {
        diag_error_at("TraitContract", TRAIT_ARG_ARITY, "trait `{tc_trait_shown(trait_name)}` takes {want} type argument(s), {got} were given", bound,
            "write one type argument per trait type parameter: `{strip_module_qualifier(written)}[...]`")
        return
    }
    let mut i = 0
    while i < got {
        let arg = sublist_get(args_sl, i)
        nr_check_type_ann_visibility(arg)
        nr_resolve_bound_arg(arg)
        i = i + 1
    }
}

// Resolving the argument is what counts a nested constructor's arguments (E0303).
@allow(UnrestoredMutation)
fn nr_resolve_bound_arg(arg: Int) ! TypeCheck.Resolve, Diag.Report {
    let saved_suppress = tc_suppress_ann_validation
    tc_suppress_ann_validation = 1
    let _ = resolve_type_ann(arg)
    tc_suppress_ann_validation = saved_suppress
}

fn nr_check_type_ann_visibility(ann_node: Int) ! TypeCheck.Resolve, Diag.Report {
    if ann_node == -1 { return }
    let name = node_name(ann_node)
    nr_check_type_ref(name, ann_node)
    let core = tc_compiler_known_type_meant(name, ann_node)
    if core == "Handler" || core == "Template" {
        let elems_sl = node_elements(ann_node)
        if elems_sl != -1 {
            let mut i = 0
            while i < sublist_length(elems_sl) {
                let child = sublist_get(elems_sl, i)
                let child_name = node_name(child)
                tc_mark_symbol_used(child_name)
                i = i + 1
            }
        }
        return
    }
    let elems_sl = node_elements(ann_node)
    if elems_sl != -1 {
        let mut i = 0
        while i < sublist_length(elems_sl) {
            nr_check_type_ann_visibility(sublist_get(elems_sl, i))
            i = i + 1
        }
    }
}

// A call's bracketed type arguments. A name there that is no type but is a value in scope
// was written by someone who meant to index, so its report names element access, and the
// call's own count check stays quiet about a list that already has its report.
fn nr_check_call_type_args(call_node: Int) ! TypeCheck.Resolve, Diag.Report {
    let sl = node_type_params(call_node)
    if sl == -1 { return }
    let mut reported = false
    let mut i = 0
    while i < sublist_length(sl) {
        let ann = sublist_get(sl, i)
        let name = node_name(ann)
        if nr_names_a_type(name) == 0 && nr_has_binding(name) != 0 {
            // The value is read, as the element position it was meant to be.
            nr_mark_read_at(nr_top_index(name))
            tc_type_args_unresolved.insert(call_node, 1)
            if !reported {
                reported = true
                tc_errors.push("no index operator")
                diag_error_at_notes("NoIndexOperator", NO_INDEX_OPERATOR, "Blink has no index operator", call_node, "",
                    [tc_called_element_note(tc_call_head_text(call_node), name)])
            }
        } else {
            nr_check_type_ann_visibility(ann)
        }
        i = i + 1
    }
}

// Whether a name in a type position names something nr_check_type_ref accepts.
fn nr_names_a_type(name: Str) -> Int {
    if (tc_active_tparams.get(name) ?? 0) > 0 { return 1 }
    if is_known_type(name) != 0 || is_trait_name(name) != 0 { return 1 }
    0
}

// `at` is the node the report points at, or -1 when the caller has none.
fn nr_check_type_ref(name: Str, at: Int) ! TypeCheck.Resolve, Diag.Report {
    if name == "" { return }
    // A name is a type variable exactly where a generic binder in scope declares it. The
    // spelling carries nothing, so the length of the name is not part of the test.
    // Undeclared, the name is no type at all — fall through to the unknown-type check
    // below instead of passing it unchecked.
    if (tc_active_tparams.get(name) ?? 0) > 0 { return }
    if tc_report_reserved_unbuilt(name, at) != 0 { return }
    match name.byte_index_of(".", 0) {
        Some(dot) => {
            let qualifier = name.byte_slice(0, dot)
            if nr_qualifier_names_a_type(qualifier) == 0 {
                nr_check_qualified_type_ref(name, qualifier, name.byte_slice(dot + 1, name.byte_len()), at)
                return
            }
        }
        None => {}
    }
    // An import from blink.core or blink.ffi names the compiler-known type under the alias.
    if tc_core_type_alias_target(name, nr_current_module) != "" {
        tc_mark_symbol_used(name)
        return
    }
    if is_known_type(name) != 0 {
        if nr_check_selective_access(name, at) != 0 { return }
        if is_private_access(name) != 0 {
            tc_errors.push("cannot access private type `{name}`")
            nr_error("PrivateItemAccess", PRIVATE_ITEM_ACCESS, "cannot access private type `{name}` from another module", at, "mark the type as `pub` in its module")
            return
        }
        tc_mark_symbol_used(name)
        return
    }
    if is_trait_name(name) != 0 {
        if nr_check_selective_access(name, at) != 0 { return }
        if is_private_access(name) != 0 {
            tc_errors.push("cannot access private trait `{name}`")
            nr_error("PrivateItemAccess", PRIVATE_ITEM_ACCESS, "cannot access private trait `{name}` from another module", at, "mark the trait as `pub` in its module")
            return
        }
        tc_mark_symbol_used(name)
        return
    }
    tc_errors.push("unknown type `{name}`")
    nr_error("UnknownType", UNKNOWN_TYPE, "unknown type `{name}`", at, "")
}

// `Self.Context` and `T.Item` qualify by a type, not a module.
fn nr_qualifier_names_a_type(qualifier: Str) -> Int {
    if qualifier == "Self" { return 1 }
    nr_names_a_type(qualifier)
}

// A qualified name in a type position: the qualifier must be a module the reading module
// imports, and the member a declaration that module makes or re-exports, `pub` there.
fn nr_check_qualified_type_ref(name: Str, qualifier: Str, member: Str, at: Int) ! TypeCheck.Resolve, Diag.Report {
    let target = nr_qualifier_module_here(qualifier)
    if target == "" {
        tc_errors.push("unknown type `{name}`")
        nr_error("UnknownType", UNKNOWN_TYPE, "unknown type `{name}`: no module `{qualifier}` is imported here", at, nr_missing_import_help(qualifier))
        return
    }
    tc_mark_qualifier_used(qualifier)
    // `mod.Type.Member` is its own report, made where the member is read.
    if member.contains(".") { return }
    if nr_resolve_decl_in_module(target, member, 0) == -1 {
        tc_errors.push("unknown type `{name}`")
        let near = suggest_module_member(target, member)
        let help = if near != "" { "did you mean `{qualifier}.{near}`?" } else { "" }
        nr_error("UnknownType", UNKNOWN_TYPE, "unknown type `{name}`: module `{qualifier}` declares no `{member}`", at, help)
        return
    }
    if nr_qualified_private_access(qualifier, member) != 0 {
        nr_emit_private_access(member, at)
        return
    }
    tc_mark_symbol_used(member)
}

fn nr_error(name: Str, code: Str, message: Str, at: Int, help: Str) ! Diag.Report {
    if at == -1 {
        diag_error_no_loc(name, code, message, help)
    } else {
        diag_error_at(name, code, message, at, help)
    }
}

// F32 is a built-in the spec names and the compiler does not build yet; F64 is claimed with no
// spec entry. Both stay reserved, so a user type cannot take them, and the report says so
// instead of calling them unknown. Lowering has no type for either and would mint a typevar.
fn tc_report_reserved_unbuilt(name: Str, at: Int) -> Int ! Diag.Report {
    if name != "F32" && name != "F64" { return 0 }
    tc_errors.push("reserved type `{name}` is not yet supported")
    nr_error("UnknownType", UNKNOWN_TYPE, "type `{name}` is reserved but not yet supported", at, "use Float")
    1
}

fn is_bytes_growth_method(name: Str) -> Int {
    if name == "push" { return 1 }
    if name == "append" { return 1 }
    if name == "concat" { return 1 }
    if name == "extend" { return 1 }
    if name == "clear" { return 1 }
    if name == "truncate" { return 1 }
    if name == "resize" { return 1 }
    if name == "write_u16_be" || name == "write_u32_be" || name == "write_i32_be" || name == "write_i64_be" { return 1 }
    if name == "write_u16_le" || name == "write_u32_le" || name == "write_i32_le" || name == "write_i64_le" { return 1 }
    0
}

fn nogrow_scan(node: Int, recv: Str, with_ptr_site: Int) ! Diag.Report {
    if node == -1 { return }
    let kind = node_kind(node)

    if kind == NodeKind.MethodCall {
        let mc_obj = node_obj(node)
        if mc_obj != -1 && node_kind(mc_obj) == NodeKind.Ident && node_name(mc_obj) == recv {
            let m = node_method(node)
            if is_bytes_growth_method(m) != 0 {
                diag_error_at("BytesGrowInWithPtr", BYTES_GROW_IN_WITH_PTR, "cannot grow Bytes inside with_ptr closure — `{m}` is growth-effecting", node, "move the growth call outside the with_ptr closure")
            }
        }
        let args_sl = node_args(node)
        if args_sl != -1 {
            let mut i = 0
            while i < sublist_length(args_sl) {
                let a = sublist_get(args_sl, i)
                if node_kind(a) == NodeKind.Ident && node_name(a) == recv {
                    diag_error_at("PinnedBytesEscape", PINNED_BYTES_ESCAPE, "pinned Bytes `{recv}` cannot escape with_ptr closure as argument", a, "pass the Ptr[U8] `p` or an integer slice instead")
                } else {
                    nogrow_scan(a, recv, with_ptr_site)
                }
                i = i + 1
            }
        }
        if mc_obj != -1 {
            nogrow_scan(mc_obj, recv, with_ptr_site)
        }
        return
    }

    if kind == NodeKind.Call {
        let args_sl = node_args(node)
        if args_sl != -1 {
            let mut i = 0
            while i < sublist_length(args_sl) {
                let a = sublist_get(args_sl, i)
                if node_kind(a) == NodeKind.Ident && node_name(a) == recv {
                    diag_error_at("PinnedBytesEscape", PINNED_BYTES_ESCAPE, "pinned Bytes `{recv}` cannot escape with_ptr closure as argument", a, "pass the Ptr[U8] `p` or an integer slice instead")
                } else {
                    nogrow_scan(a, recv, with_ptr_site)
                }
                i = i + 1
            }
        }
        let cobj = node_obj(node)
        if cobj != -1 { nogrow_scan(cobj, recv, with_ptr_site) }
        return
    }

    if kind == NodeKind.Block {
        let stmts_sl = node_stmts(node)
        if stmts_sl != -1 {
            let mut i = 0
            while i < sublist_length(stmts_sl) {
                nogrow_scan(sublist_get(stmts_sl, i), recv, with_ptr_site)
                i = i + 1
            }
        }
        return
    }

    if kind == NodeKind.LetBinding {
        let v = node_value(node)
        if v != -1 { nogrow_scan(v, recv, with_ptr_site) }
        return
    }

    if kind == NodeKind.ExprStmt {
        nogrow_scan(node_value(node), recv, with_ptr_site)
        return
    }

    if kind == NodeKind.Assignment || kind == NodeKind.CompoundAssign {
        nogrow_scan(node_target(node), recv, with_ptr_site)
        nogrow_scan(node_value(node), recv, with_ptr_site)
        return
    }

    if kind == NodeKind.Return {
        nogrow_scan(node_value(node), recv, with_ptr_site)
        return
    }

    if kind == NodeKind.IfExpr {
        nogrow_scan(node_condition(node), recv, with_ptr_site)
        nogrow_scan(node_then_body(node), recv, with_ptr_site)
        nogrow_scan(node_else_body(node), recv, with_ptr_site)
        return
    }

    if kind == NodeKind.MatchExpr {
        nogrow_scan(node_scrutinee(node), recv, with_ptr_site)
        let arms_sl = node_arms(node)
        if arms_sl != -1 {
            let mut i = 0
            while i < sublist_length(arms_sl) {
                let arm = sublist_get(arms_sl, i)
                nogrow_scan(node_guard(arm), recv, with_ptr_site)
                nogrow_scan(node_body(arm), recv, with_ptr_site)
                i = i + 1
            }
        }
        return
    }

    if kind == NodeKind.WhileLoop {
        nogrow_scan(node_condition(node), recv, with_ptr_site)
        nogrow_scan(node_body(node), recv, with_ptr_site)
        return
    }

    if kind == NodeKind.ForIn {
        nogrow_scan(node_iterable(node), recv, with_ptr_site)
        nogrow_scan(node_body(node), recv, with_ptr_site)
        return
    }

    if kind == NodeKind.BinOp {
        nogrow_scan(node_left(node), recv, with_ptr_site)
        nogrow_scan(node_right(node), recv, with_ptr_site)
        return
    }

    if kind == NodeKind.UnaryOp {
        nogrow_scan(node_value(node), recv, with_ptr_site)
        return
    }

    if kind == NodeKind.FieldAccess || kind == NodeKind.IndexExpr {
        nogrow_scan(node_obj(node), recv, with_ptr_site)
        nogrow_scan(node_index(node), recv, with_ptr_site)
        return
    }

    if kind == NodeKind.TupleLit || kind == NodeKind.ListLit || kind == NodeKind.InterpString {
        let elems_sl = node_elements(node)
        if elems_sl != -1 {
            let mut i = 0
            while i < sublist_length(elems_sl) {
                nogrow_scan(sublist_get(elems_sl, i), recv, with_ptr_site)
                i = i + 1
            }
        }
        return
    }

    if kind == NodeKind.StructLit {
        let fields_sl = node_fields(node)
        if fields_sl != -1 {
            let mut i = 0
            while i < sublist_length(fields_sl) {
                nogrow_scan(node_value(sublist_get(fields_sl, i)), recv, with_ptr_site)
                i = i + 1
            }
        }
        return
    }

    if kind == NodeKind.Closure {
        nogrow_scan(node_body(node), recv, with_ptr_site)
        return
    }
}

// A literal text run inside an InterpString. parse_interp_string emits these as
// Ident nodes with both str_val and name set to the literal text, so an embedded
// `{expr}` (name set, str_val empty) is distinguishable. Used to skip literal
// runs when walking interpolation parts for name resolution and type checks.
fn is_interp_literal_part(part: Int) -> Int {
    if node_kind(part) == NodeKind.Ident && node_str_val(part) == node_name(part) { return 1 }
    0
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn nr_check_node(node: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if node == -1 { return }
    let kind = node_kind(node)

    if kind == NodeKind.Block {
        nr_push_scope()
        let stmts_sl = node_stmts(node)
        if stmts_sl != -1 {
            let mut i = 0
            while i < sublist_length(stmts_sl) {
                nr_check_node(sublist_get(stmts_sl, i))
                i = i + 1
            }
        }
        nr_pop_scope()
        return
    }

    if kind == NodeKind.LetBinding {
        let val = node_value(node)
        if val != -1 {
            nr_check_node(val)
        }
        let let_type_ann = node_target(node)
        if let_type_ann != -1 {
            nr_check_type_ann_visibility(let_type_ann)
        }
        let let_is_mut = node_is_mut(node)
        let let_binds = tc_let_binder_is_discard(node) == 0
        if let_binds {
            nr_define_mut_at(node_name(node), let_is_mut, node)
        }
        if val != -1 {
            let vk = node_kind(val)
            if vk == NodeKind.Call || vk == NodeKind.Ident || vk == NodeKind.MethodCall {
                // This inference is the FIRST to reach the value, so a report it draws is the
                // one a reader sees; the binder has to be in scope here too, not only at the
                // body walk below.
                let saved_nr_binder = tc_ffi_scope_binder
                tc_ffi_scope_binder = node_name(node)
                // A bare variant name resolves from the annotation (§3.4), and so do the
                // receiver's arguments of a static conversion; without it here, the first
                // inference would find either ambiguous before the body walk hints it.
                let saved_nr_hint = tc_construct_hint
                if let_type_ann != -1 && (tc_names_bare_variant(val) || tc_names_static_conversion(val)) {
                    let ann_tid = resolve_type_ann(let_type_ann)
                    if tc_tid_is_no_info(ann_tid) == 0 { tc_construct_hint = resolve_alias_tid(ann_tid) }
                }
                let inferred = infer_type(val)
                tc_construct_hint = saved_nr_hint
                tc_ffi_scope_binder = saved_nr_binder
                // The recorded type goes on the entry THIS let just defined, which is the
                // top one. A discard defines no entry, so the top one belongs to whatever
                // binder came before it, and writing there retypes a binder the discard
                // has nothing to do with. A declared type is the binder's type even when the
                // value does not fit it, so the value's type is not recorded over an
                // annotation; the body walk defines the binder at the declared type.
                if let_binds && let_type_ann == -1 && node_type_name(node) == "" && tc_tid_is_no_info(inferred) == 0 {
                    nr_set_last_type(inferred)
                }
            }
        }
        let let_pat_sl = node_elements(node)
        if let_pat_sl != -1 {
            nr_define_let_pattern(let_pat_sl)
        }
        return
    }

    if kind == NodeKind.Assignment || kind == NodeKind.CompoundAssign {
        let assign_target = node_target(node)
        nr_check_node(node_value(node))
        if assign_target != -1 && node_kind(assign_target) == NodeKind.IndexExpr {
            // A store is no read of the element, so the target is not walked as one.
            nr_check_node(node_obj(assign_target))
            let item = node_index(assign_target)
            let mode = if nr_index_written_twice_safely(item) { INDEX_STORE_STABLE } else { INDEX_STORE }
            nr_note_index_site(node, item, mode)
            return
        }
        if assign_target != -1 && node_kind(assign_target) == NodeKind.Ident {
            let assign_name = node_name(assign_target)
            if kind == NodeKind.CompoundAssign {
                nr_check_node(assign_target)
            } else {
                // CompoundAssign reaches this same fact through nr_check_node's own Ident
                // branch above; a plain `=` never walks its target through that branch, so
                // it is recorded here instead, the same way that branch records it for a
                // read of the name — selective-import gate included, or an assignment to a
                // global this module never imported would be silently accepted here and
                // only fail later, opaquely, in codegen.
                // nr_has_binding, not nr_is_defined: a write must not count as a read.
                if nr_has_binding(assign_name) == 0 {
                    tc_errors.push("undefined variable `{assign_name}`")
                    diag_error_at("UndefinedVariable", UNDEFINED_VARIABLE, "undefined variable `{assign_name}`", assign_target, "")
                    return
                }
                if nr_top_binding_is_global(assign_name) != 0 {
                    if nr_check_selective_access(assign_name, assign_target) != 0 { return }
                    nr_note_global_decl(assign_target, nr_resolve_bare_decl(assign_name, nr_current_module))
                }
                nr_note_local_binder(assign_target, assign_name)
                tc_mark_symbol_used(assign_name)
            }
            nr_mark_written(assign_name, node)
        } else {
            nr_check_node(assign_target)
        }
        return
    }

    if kind == NodeKind.ExprStmt {
        nr_check_node(node_value(node))
        return
    }

    if kind == NodeKind.Return {
        nr_check_node(node_value(node))
        return
    }

    if kind == NodeKind.Ident {
        let name = node_name(node)
        if name == "true" || name == "false" || name == "None" { return }
        let top = nr_top_index(name)
        if top != -1 {
            nr_mark_read_at(top)
            if nr_check_selective_access_at(name, node, top) != 0 { return }
            nr_note_local_binder_at(node, top)
            let global = nr_index_is_global(top) != 0
            if global && is_private_access(name) != 0 {
                tc_errors.push("cannot access private item `{name}`")
                diag_error_at("PrivateItemAccess", PRIVATE_ITEM_ACCESS, "cannot access private item `{name}` from another module", node, "mark the item as `pub` in its module")
                return
            }
            // A local binder of the same spelling holds a value, not a declaration, so a
            // read through it names no global.
            if global {
                let decl = nr_resolve_bare_decl(name, nr_current_module)
                nr_note_global_decl(node, decl)
                nr_note_fn_value_decl(node, decl)
            }
            tc_mark_symbol_used(name)
            return
        }
        if is_builtin_namespace(name) != 0 { return }
        if is_user_effect_handle_name(name) != 0 { return }
        if is_variant_name(name) != 0 {
            if nr_check_selective_access(name, node) != 0 { return }
            if is_private_access(name) != 0 {
                tc_errors.push("cannot access private variant `{name}`")
                diag_error_at("PrivateItemAccess", PRIVATE_ITEM_ACCESS, "cannot access private variant `{name}` from another module", node, "mark the enum as `pub` in its module")
                return
            }
            tc_mark_symbol_used(name)
            return
        }
        if is_builtin_fn(name) != 0 { return }
        if is_known_type(name) != 0 {
            if nr_check_selective_access(name, node) != 0 { return }
            if is_private_access(name) != 0 {
                tc_errors.push("cannot access private type `{name}`")
                diag_error_at("PrivateItemAccess", PRIVATE_ITEM_ACCESS, "cannot access private type `{name}` from another module", node, "mark the type as `pub` in its module")
                return
            }
            tc_mark_symbol_used(name)
            return
        }
        if is_trait_name(name) != 0 {
            if nr_check_selective_access(name, node) != 0 { return }
            if is_private_access(name) != 0 {
                tc_errors.push("cannot access private trait `{name}`")
                diag_error_at("PrivateItemAccess", PRIVATE_ITEM_ACCESS, "cannot access private trait `{name}` from another module", node, "mark the trait as `pub` in its module")
                return
            }
            tc_mark_symbol_used(name)
            return
        }
        if nr_qualifier_module_here(name) != "" { return }
        tc_errors.push("undefined variable `{name}`")
        let help = if is_import_module_name(name) != 0 {
            nr_missing_import_help(name)
        } else {
            let name_help = tc_undefined_name_help(name)
            if name_help == "" && nr_name_top.contains_key(NR_ITEM_WITHOUT_AS) {
                // A scoped value entered without `as` has its Context discarded, so a name the
                // body expected from it is not there (sections/04_effects.md §4.7). Name
                // resolution runs before item types are known, and a handler item gives no
                // Context, so the help holds for either kind of item.
                "if a with item is a scoped value, bind its Context: with ... as {name}"
            } else {
                name_help
            }
        }
        diag_error_at("UndefinedVariable", UNDEFINED_VARIABLE, "undefined variable `{name}`", node, help)
        return
    }

    if kind == NodeKind.IntLit || kind == NodeKind.FloatLit || kind == NodeKind.BoolLit {
        return
    }

    if kind == NodeKind.InterpString {
        let elems_sl = node_elements(node)
        if elems_sl != -1 {
            let mut i = 0
            while i < sublist_length(elems_sl) {
                let part = sublist_get(elems_sl, i)
                if is_interp_literal_part(part) != 0 {
                    // Literal text run — mark as read but skip full check
                    let iname = node_name(part)
                    if nr_is_defined(iname) != 0 {
                        let _skip = 0
                    }
                } else {
                    nr_check_node(part)
                }
                i = i + 1
            }
        }
        return
    }

    if kind == NodeKind.Call {
        let callee = node_left(node)
        if callee != -1 {
            let callee_kind = node_kind(callee)
            nr_check_call_type_args(node)
            if callee_kind == NodeKind.Ident {
                let fn_name = node_name(callee)
                let top = nr_top_index(fn_name)
                if nr_check_selective_access_at(fn_name, node, top) == 0 {
                    // A call through a local closure reads that binding like any other
                    // read, and the escape pass follows it to what the closure captures.
                    nr_note_local_binder_at(callee, top)
                    let defined = top != -1
                    if defined { nr_mark_read_at(top) }
                    let global = defined && nr_index_is_global(top) != 0
                    if global && is_private_access(fn_name) != 0 {
                        tc_errors.push("cannot access private function `{fn_name}`")
                        diag_error_at("PrivateItemAccess", PRIVATE_ITEM_ACCESS, "cannot access private function `{fn_name}` from another module", node, "mark the function as `pub` in its module")
                    } else if !defined && is_variant_name(fn_name) != 0 && is_private_access(fn_name) != 0 {
                        tc_errors.push("cannot access private variant `{fn_name}`")
                        diag_error_at("PrivateItemAccess", PRIVATE_ITEM_ACCESS, "cannot access private variant `{fn_name}` from another module", node, "mark the enum as `pub` in its module")
                    } else if nr_is_unimported_prelude_free_fn(fn_name) != 0 {
                        tc_errors.push("undefined function `{fn_name}`")
                        diag_error_at("UndefinedFunction", UNDEFINED_FUNCTION, "undefined function `{fn_name}`", node, "this stdlib function is not in the prelude — add an explicit import, e.g. import {tc_qualifier_for_module(tc_get_symbol_module(fn_name))}.\{{fn_name}}")
                    } else if tc_names_type_without_call_form(fn_name) {
                        // Marking the call unresolved keeps the arity check off the same mistake.
                        tc_type_args_unresolved.insert(node, 1)
                        tc_errors.push("undefined function `{fn_name}`")
                        diag_error_at("UndefinedFunction", UNDEFINED_FUNCTION, "undefined function `{fn_name}`", node, tc_no_call_form_repair(fn_name))
                    } else if !defined && is_builtin_fn(fn_name) == 0 && is_variant_name(fn_name) == 0 && is_known_type(fn_name) == 0 && is_trait_name(fn_name) == 0 {
                        tc_errors.push("undefined function `{fn_name}`")
                        diag_error_at("UndefinedFunction", UNDEFINED_FUNCTION, "undefined function `{fn_name}`", node, "")
                    } else {
                        tc_mark_symbol_used(fn_name)
                    }
                    // A local binding of the same spelling holds a value, not a declaration,
                    // so a call through it is a call through a closure and records nothing.
                    if global || !defined {
                        nr_note_call_decl(node, nr_resolve_bare_call_decl(fn_name, nr_current_module))
                    }
                }
            } else if callee_kind == NodeKind.IndexExpr && tc_index_is_type_application(callee) == 0 {
                nr_check_node(node_obj(callee))
                nr_note_index_site(callee, node_index(callee), INDEX_CALLED_READ)
            } else {
                nr_check_node(callee)
            }
        }
        let args_sl = node_args(node)
        if args_sl != -1 {
            let mut i = 0
            while i < sublist_length(args_sl) {
                nr_check_node(sublist_get(args_sl, i))
                i = i + 1
            }
        }
        return
    }

    if kind == NodeKind.MethodCall {
        let obj = node_obj(node)
        nr_check_call_type_args(node)
        if obj != -1 && node_kind(obj) == NodeKind.Ident && node_name(obj) == "default" && nr_has_binding("default") == 0 {
            nr_resolve_default_receiver(node, obj)
        }
        let mut is_module_qual = 0
        if obj != -1 && node_kind(obj) == NodeKind.Ident {
            let obj_name = node_name(obj)
            if nr_qualifier_module_here(obj_name) != "" && nr_is_defined(obj_name) == 0 {
                is_module_qual = 1
                let mq_method = node_method(node)
                if nr_qualified_private_access(obj_name, mq_method) != 0 {
                    nr_emit_private_access(mq_method, node)
                } else {
                    tc_mark_symbol_used(mq_method)
                }
                nr_note_call_decl(node, nr_resolve_qualified_decl(obj_name, mq_method))
                tc_mark_qualifier_used(obj_name)
            }
        }
        if is_module_qual == 0 && obj != -1 {
            if node_kind(obj) == NodeKind.FieldAccess {
                let inner_obj = node_obj(obj)
                if inner_obj != -1 && node_kind(inner_obj) == NodeKind.Ident {
                    let inner_name = node_name(inner_obj)
                    if nr_qualifier_module_here(inner_name) != "" && nr_is_defined(inner_name) == 0 {
                        let mid_field = node_name(obj)
                        if is_known_type(mid_field) != 0 {
                            let outer_field = node_method(node)
                            tc_mark_symbol_used(mid_field)
                            tc_mark_symbol_used(outer_field)
                            let dotted_mod = tc_get_dotted_module_path(inner_name)
                            diag_error_at("ModuleQualifiedType", MODULE_QUALIFIED_TYPE, "cannot access type member `{mid_field}.{outer_field}` via module qualifier — {tc_import_help(mid_field, dotted_mod, outer_field)}", node, "enum variants and type members use type qualifiers, not module qualifiers")
                            return
                        }
                    }
                }
            }
            nr_check_node(obj)
        }
        let method_name = node_method(node)
        if is_module_qual == 0 && is_builtin_method(method_name) == 0 && is_variant_name(method_name) == 0 {
            let mut found_in_impl = 0
            let mut mi = 0
            while mi < nr_impl_method_names.len() {
                if nr_impl_method_names.get(mi).unwrap() == method_name {
                    found_in_impl = 1
                }
                mi = mi + 1
            }
            if found_in_impl == 0 && is_callable_field_name(method_name) == 0 {
                let mut is_ue_call = 0
                if obj != -1 && node_kind(obj) == NodeKind.Ident {
                    if is_user_effect_handle_name(node_name(obj)) != 0 {
                        is_ue_call = 1
                    }
                    if node_name(obj) == "default" && tc_tid_handler_effect(tc_lookup_node_tid(obj)) != "" {
                        is_ue_call = 1
                    }
                    // is_builtin_method is keyed on the BARE method name, so it cannot tell a
                    // namespace intrinsic like `env.exit` from an unrelated method of the same
                    // name on another type. Adding `exit` there would be the wrong key: it would
                    // silence `.exit()` on every type. A namespace intrinsic has to be recognized
                    // by NAMESPACE AND METHOD, which is what is_intrinsic_method answers.
                    if is_intrinsic_method(node_name(obj), method_name) != 0 && nr_is_defined(node_name(obj)) == 0 {
                        is_ue_call = 1
                    }
                    // A type its module declares twice (E1016) may have meant the member of
                    // either declaration.
                    if tc_type_name_poisoned(node_name(obj)) { is_ue_call = 1 }
                }
                if is_ue_call == 0 {
                    // Recorded, not reported. Phase 2 knows the receiver type and turns
                    // this into E0505 wherever the type is known; the leftovers are
                    // flushed as W0501 after inference.
                    nr_unresolved_method_nodes.push(node)
                }
            }
        }
        let args_sl = node_args(node)
        let obj_is_ident = if obj != -1 && node_kind(obj) == NodeKind.Ident { 1 } else { 0 }
        let is_with_ptr_call = if method_name == "with_ptr" && obj_is_ident != 0 { 1 } else { 0 }
        if is_with_ptr_call != 0 { nr_with_ptr_depth = nr_with_ptr_depth + 1 }
        if args_sl != -1 {
            let mut i = 0
            while i < sublist_length(args_sl) {
                nr_check_node(sublist_get(args_sl, i))
                i = i + 1
            }
        }
        if is_with_ptr_call != 0 { nr_with_ptr_depth = nr_with_ptr_depth - 1 }
        if method_name == "as_ptr" && nr_with_ptr_depth == 0 && obj_is_ident != 0 {
            let recv_t = tc_infer_receiver(obj)
            if type_kind(recv_t) == TyKind.Bytes {
                diag_error_at("BytesPtrCastForbidden", BYTES_PTR_CAST_FORBIDDEN, "cannot take a raw Ptr[U8] from Bytes outside a with_ptr closure — Bytes is GC-managed and may be relocated", node, "use Bytes.with_ptr(fn(p) \{ ... }) to pin the buffer for the FFI call")
            }
        }
        if is_with_ptr_call != 0 {
            let recv = node_name(obj)
            if args_sl != -1 && sublist_length(args_sl) >= 1 {
                let cls = sublist_get(args_sl, 0)
                if node_kind(cls) == NodeKind.Closure {
                    nogrow_scan(node_body(cls), recv, node)
                }
            }
        }
        return
    }

    if kind == NodeKind.FieldAccess {
        let obj = node_obj(node)
        if obj != -1 {
            let mut is_mod_fa = 0
            let obj_kind = node_kind(obj)
            if obj_kind == NodeKind.Ident {
                let fa_obj_name = node_name(obj)
                if nr_qualifier_module_here(fa_obj_name) != "" && nr_is_defined(fa_obj_name) == 0 {
                    is_mod_fa = 1
                    let fa_field = node_name(node)
                    if nr_qualified_private_access(fa_obj_name, fa_field) != 0 {
                        nr_emit_private_access(fa_field, node)
                    } else {
                        tc_mark_symbol_used(fa_field)
                    }
                    tc_mark_qualifier_used(fa_obj_name)
                }
            }
            if is_mod_fa == 0 && obj_kind == NodeKind.FieldAccess {
                let inner_obj = node_obj(obj)
                if inner_obj != -1 && node_kind(inner_obj) == NodeKind.Ident {
                    let inner_name = node_name(inner_obj)
                    if nr_qualifier_module_here(inner_name) != "" && nr_is_defined(inner_name) == 0 {
                        let mid_field = node_name(obj)
                        if is_known_type(mid_field) != 0 {
                            let outer_field = node_name(node)
                            tc_mark_symbol_used(mid_field)
                            tc_mark_symbol_used(outer_field)
                            let dotted_mod = tc_get_dotted_module_path(inner_name)
                            diag_error_at("ModuleQualifiedType", MODULE_QUALIFIED_TYPE, "cannot access type member `{mid_field}.{outer_field}` via module qualifier — {tc_import_help(mid_field, dotted_mod, outer_field)}", node, "enum variants and type members use type qualifiers, not module qualifiers")
                            return
                        }
                    }
                }
            }
            if is_mod_fa == 0 {
                nr_check_node(obj)
            }
        }
        return
    }

    if kind == NodeKind.IndexExpr {
        if tc_index_is_type_application(node) != 0 {
            let ty_name = node_name(node_index(node))
            let obj = node_obj(node)
            let fn_text = if node_kind(obj) == NodeKind.Ident { node_name(obj) } else { "f" }
            tc_bracket_sites.insert(node, BRACKET_TYPE_ARGS)
            tc_errors.push("type arguments with no call")
            diag_error_at("CallSiteTypeArgs", CALL_SITE_TYPE_ARGS, "type argument `[{ty_name}]` has no call to apply to", node, "type arguments belong to a call, as in `{fn_text}[{ty_name}]()`; to keep the function as a value, annotate the binding with its function type")
            nr_check_node(obj)
            return
        }
        nr_check_node(node_obj(node))
        nr_note_index_site(node, node_index(node), INDEX_READ)
        return
    }

    if kind == NodeKind.BinOp {
        nr_check_node(node_left(node))
        nr_check_node(node_right(node))
        return
    }

    if kind == NodeKind.UnaryOp {
        nr_check_node(node_left(node))
        return
    }

    if kind == NodeKind.IfExpr {
        nr_check_node(node_condition(node))
        nr_check_node(node_then_body(node))
        nr_check_node(node_else_body(node))
        return
    }

    if kind == NodeKind.WhileLoop {
        nr_check_node(node_condition(node))
        nr_loop_depth = nr_loop_depth + 1
        nr_check_node(node_body(node))
        nr_loop_depth = nr_loop_depth - 1
        nr_check_node(node_condition(node))
        return
    }

    if kind == NodeKind.LoopExpr {
        nr_loop_depth = nr_loop_depth + 1
        nr_check_node(node_body(node))
        nr_loop_depth = nr_loop_depth - 1
        return
    }

    if kind == NodeKind.ForIn {
        nr_check_node(node_iterable(node))
        nr_push_scope()
        nr_define_mut_at(node_var_name(node), tc_for_binder_is_mut(node), node)
        let for_pat_sl = node_elements(node)
        if for_pat_sl != -1 {
            nr_check_pattern(for_pat_sl, false)
        }
        nr_loop_depth = nr_loop_depth + 1
        nr_check_node(node_body(node))
        nr_loop_depth = nr_loop_depth - 1
        nr_pop_scope()
        return
    }

    if kind == NodeKind.Break || kind == NodeKind.Continue {
        return
    }

    if kind == NodeKind.MatchExpr {
        nr_check_node(node_scrutinee(node))
        let arms_sl = node_arms(node)
        if arms_sl != -1 {
            let mut i = 0
            while i < sublist_length(arms_sl) {
                let arm = sublist_get(arms_sl, i)
                nr_push_scope()
                nr_check_pattern(node_pattern(arm), true)
                let guard = node_guard(arm)
                if guard != -1 {
                    nr_check_node(guard)
                }
                nr_check_node(node_body(arm))
                nr_pop_scope()
                i = i + 1
            }
        }
        return
    }

    if kind == NodeKind.Closure {
        nr_push_scope()
        // A closure writes its parameters with the same syntax a function does, so the two
        // rules a default has to satisfy are the same ones. The fn-body walk never reaches
        // here, and without this the identical spelling is refused in a declaration and
        // accepted in a closure.
        tc_check_param_defaults(node)
        let params_sl = node_params(node)
        if params_sl != -1 {
            let mut i = 0
            while i < sublist_length(params_sl) {
                let cp = sublist_get(params_sl, i)
                nr_define_at(node_name(cp), cp)
                // A closure annotation is a type position like a function's, and a name nothing
                // declares would otherwise lower to a free type variable.
                nr_check_type_ann_visibility(node_type_ann(cp))
                i = i + 1
            }
        }
        nr_check_type_ann_visibility(node_type_ann(node))
        // Spec §3c.2: a closure body does not inherit the surrounding
        // test-body elaboration. `?` inside the closure must be gated
        // against the closure's own (or enclosing fn's) return type.
        let saved_in_test = tc_in_test_body
        tc_in_test_body = 0
        nr_in_closure_depth = nr_in_closure_depth + 1
        nr_check_node(node_body(node))
        nr_in_closure_depth = nr_in_closure_depth - 1
        tc_in_test_body = saved_in_test
        nr_pop_scope()
        return
    }

    if kind == NodeKind.StructLit {
        let type_name = node_type_name(node)
        if type_name != "" {
            match type_name.byte_index_of(".", 0) {
                Some(dot_pos) => {
                    let prefix = type_name.byte_slice(0, dot_pos)
                    let names_module = nr_qualifier_module_here(prefix) != "" || (is_import_module_name(prefix) != 0 && is_known_type(prefix) == 0)
                    if names_module && nr_is_defined(prefix) == 0 {
                        // module.Type qualified construction reads the type as an annotation does.
                        nr_check_type_ref(type_name, node)
                    } else {
                        // Enum.Variant struct-style construction: check the enum type only
                        nr_check_type_ref(prefix, node)
                    }
                }
                None => {
                    if is_variant_name(type_name) != 0 {
                        // bare struct-style variant construction; resolved in infer_type.
                        // This gate only suppresses the false UnknownType — it never picks a winner.
                    } else {
                        let stid = lookup_named_type(type_name)
                        if stid == -1 {
                            let suggestion = suggest_variant(type_name)
                            if suggestion != "" {
                                diag_error_at("UnknownType", UNKNOWN_TYPE, "unknown type `{type_name}`", node, "did you mean {suggestion}? construct as {suggestion} \{ ... }")
                            } else {
                                nr_check_type_ref(type_name, node)
                            }
                        } else {
                            nr_check_type_ref(type_name, node)
                        }
                    }
                }
            }
        }
        let flds_sl = node_fields(node)
        if flds_sl != -1 {
            let mut i = 0
            while i < sublist_length(flds_sl) {
                let f = sublist_get(flds_sl, i)
                nr_check_node(node_value(f))
                i = i + 1
            }
        }
        return
    }

    if kind == NodeKind.ListLit {
        let elems_sl = node_elements(node)
        if elems_sl != -1 {
            let mut i = 0
            while i < sublist_length(elems_sl) {
                nr_check_node(sublist_get(elems_sl, i))
                i = i + 1
            }
        }
        return
    }

    if kind == NodeKind.TupleLit {
        let elems_sl = node_elements(node)
        if elems_sl != -1 {
            let mut i = 0
            while i < sublist_length(elems_sl) {
                nr_check_node(sublist_get(elems_sl, i))
                i = i + 1
            }
        }
        return
    }

    if kind == NodeKind.RangeLit {
        nr_check_node(node_start(node))
        nr_check_node(node_end(node))
        return
    }

    if kind == NodeKind.WithBlock {
        let wh_sl = node_handlers(node)
        nr_push_scope()
        let mut has_item_without_as = false
        if wh_sl != -1 {
            let mut wi = 0
            while wi < sublist_length(wh_sl) {
                let wh_item = sublist_get(wh_sl, wi)
                let wh_kind = node_kind(wh_item)
                if wh_kind == NodeKind.WithResource {
                    nr_define_at(node_name(wh_item), wh_item)
                    nr_check_node(node_value(wh_item))
                } else if wh_kind == NodeKind.Ident && node_name(wh_item) == "arena" {
                    // `arena` is a keyword in `with arena { }` — skip the
                    // bare ident so we don't emit E0506. Matches the skip
                    // guard in tc_check_body's WithBlock branch.
                } else {
                    nr_check_node(wh_item)
                    if wh_kind != NodeKind.HandlerExpr { has_item_without_as = true }
                }
                wi = wi + 1
            }
        }
        // After the items, so a later item does not get the help for an earlier one.
        if has_item_without_as { nr_scope_push_entry(NR_ITEM_WITHOUT_AS, 0, TYPE_UNKNOWN, -1) }
        nr_check_node(node_body(node))
        nr_pop_scope()
        return
    }

    if kind == NodeKind.AssertPanics {
        let ap_match = node_value(node)
        if ap_match != -1 {
            nr_check_node(ap_match)
        }
        nr_push_scope()
        nr_check_node(node_body(node))
        nr_pop_scope()
        return
    }

    if kind == NodeKind.WithResource {
        nr_check_node(node_value(node))
        return
    }

    if kind == NodeKind.HandlerExpr {
        let methods_sl = node_methods(node)
        if methods_sl != -1 {
            let mut i = 0
            while i < sublist_length(methods_sl) {
                let m = sublist_get(methods_sl, i)
                // An operation carries the handler it belongs to, which is what a `default`
                // in its body names (nr_resolve_default_receiver).
                if node_name(node) != "" { tc_publish_node_tid(m, make_handler_type(node_name(node))) }
                nr_check_fn(m)
                i = i + 1
            }
        }
        return
    }

    if kind == NodeKind.AsyncScope {
        nr_check_node(node_body(node))
        return
    }

    if kind == NodeKind.AsyncSpawn {
        nr_check_node(node_body(node))
        return
    }

    if kind == NodeKind.AwaitExpr {
        // The operand lives in `obj` (src/parser.bl:2865), not `value` — reading `value`
        // gives -1 and the whole operand subtree goes unvisited, so `h1.await` would not
        // count as a read of `h1`.
        nr_check_node(node_obj(node))
        return
    }

    if kind == NodeKind.ChannelNew {
        let cn_tps = node_type_params(node)
        if cn_tps != -1 && sublist_length(cn_tps) >= 1 { nr_check_type_ann_visibility(sublist_get(cn_tps, 0)) }
        let cn_args = node_args(node)
        if cn_args == -1 { return }
        let mut i = 0
        while i < sublist_length(cn_args) {
            let arg = sublist_get(cn_args, i)
            if node_kind(arg) == NodeKind.NamedArg { nr_check_node(node_value(arg)) } else { nr_check_node(arg) }
            i = i + 1
        }
        return
    }

    if kind == NodeKind.SpreadExpr {
        nr_check_node(node_value(node))
        return
    }

    if kind == NodeKind.NamedArg {
        // A default fill was resolved at its declaration, in its own module.
        if !tc_is_default_fill(node) { nr_check_node(node_value(node)) }
        return
    }

    if kind == NodeKind.EmbedExpr {
        return
    }

    let _skip = 0
}

// Types every leaf of a destructuring `let` from the tuple it destructures.
//
// Decomposes the tuple into per-leaf types, the way the TuplePattern arm of
// tc_check_pattern_types already does for `for-in` and `match`. Without this,
// `let (m, n) = t` leaves each leaf as TYPE_UNKNOWN, so a method call on a leaf answers
// "on type ?" and codegen's binder has nothing to read. Recursive for the same reason
// nr_define_let_pattern is: a leaf of `let ((x, y), label) = ...` is itself a pattern,
// and the type it needs is a child of a child.
// A `let` whose binder is the discard `_`. The binder is a NODE, not a spelling: the
// parser mints a WildcardPattern in the pattern slot and leaves the name empty, so every
// pass reads the kind here instead of comparing a name against "_". A destructuring `let`
// fills the same slot with a TuplePattern, which is why this asks for the kind and not
// merely whether the slot is filled.
pub fn tc_let_binder_is_discard(node: Int) -> Int {
    let binder = node_elements(node)
    if binder == -1 { return 0 }
    if node_kind(binder) == NodeKind.WildcardPattern { return 1 }
    0
}

// A leaf of a destructuring `let` is mutable when `mut` stands before it, or when parse
// recovery after an E0613 marked it.
fn tc_leaf_is_mut(leaf: Int) -> Int {
    if node_is_mut(leaf) != 0 { 1 } else { 0 }
}

// `for mut i in xs` marks the simple binder; a destructuring `for` marks each leaf.
fn tc_for_binder_is_mut(for_node: Int) -> Int {
    let binder = node_for_binder(for_node)
    if binder == -1 { 0 } else { node_is_mut(binder) }
}

fn tc_type_let_pattern(pat: Int, tid: Int) {
    if pat == -1 { return }
    let kind = node_kind(pat)

    if kind == NodeKind.TuplePattern {
        let elems_sl = node_elements(pat)
        if elems_sl == -1 { return }
        // The pattern node itself carries the tuple it takes apart, so a later pass reads
        // the type it projects through rather than re-deriving it from the leaves.
        tc_publish_node_tid(pat, tid)
        let tup = tc_tid_resolved(tid)
        let mut arity = -1
        if tc_tid_kind(tup) == TyKind.Tuple {
            arity = tc_tid_child_count(tup)
        }
        let mut i = 0
        while i < sublist_length(elems_sl) {
            // A leaf past the tuple's arity stays unknown instead of borrowing a
            // neighbour's type. Wrong-arity destructuring is diagnosed elsewhere;
            // shifting types into it would turn that error into a miscompile.
            let mut elem_tid = TYPE_UNKNOWN
            if i < arity {
                elem_tid = tc_tid_child(tup, i)
                if elem_tid < 0 { elem_tid = TYPE_UNKNOWN }
            }
            tc_type_let_pattern(sublist_get(elems_sl, i), elem_tid)
            i = i + 1
        }
        return
    }

    if kind == NodeKind.WildcardPattern { return }

    nr_define_typed(node_name(pat), tc_leaf_is_mut(pat), tid, pat)
    tc_publish_node_tid(pat, tid)
}

// Binds every leaf of a destructuring `let`. A leaf may itself be a pattern:
// `let ((x, y), label) = ...` is irrefutable and §3.5 lists it among the patterns a
// binding accepts, so walking only the top row leaves the inner names undefined and
// every read of them reports UndefinedVariable.
//
// Separate from nr_check_pattern, which walks the same shapes for a match arm, because
// that one binds through nr_define_at and a `mut` leaf has to carry its mutability to
// the binding that a later assignment names.
fn nr_define_let_pattern(pat: Int) ! Diag.Report {
    if pat == -1 { return }
    let kind = node_kind(pat)

    if kind == NodeKind.TuplePattern {
        let elems_sl = node_elements(pat)
        if elems_sl != -1 {
            let mut i = 0
            while i < sublist_length(elems_sl) {
                nr_define_let_pattern(sublist_get(elems_sl, i))
                i = i + 1
            }
        }
        return
    }

    // `_` names nothing, so it needs no entry. The flat walk this replaced pushed one
    // under the empty name, which no source line can read.
    if kind == NodeKind.WildcardPattern { return }

    // A named leaf binds its name. Any other kind is outside the irrefutable subset a
    // `let` accepts and binds its own name too, which is what the flat walk did: for
    // `Some(x)` that is a binding called `Some` and no binding for the payload. Reaching
    // into the payload here instead would bind a leaf the type walk beside this one does
    // not descend into, and a bound but untyped binder ends inference as an internal
    // error where an undefined name is a diagnostic the author can act on. Refusing a
    // refutable pattern in a `let` is specified and unimplemented; until some pass does
    // it, both walks have to agree on which names exist.
    nr_define_mut_at(node_name(pat), tc_leaf_is_mut(pat), pat)
}

// `mut Red` names a variant, which binds nothing. The parser cannot tell a bare variant from a
// binder, so this E0613 comes once names resolve. Its span runs over `mut` through the name,
// the text the fix replaces.
fn nr_report_mut_on_variant(node: Int, name: Str) ! Diag.Report {
    let has_end = node_end_line(node) > 0
    let end_line = if has_end { node_end_line(node) } else { 0 }
    let end_col = if has_end { node_end_col(node) } else { 0 }
    let before = diag_entry_count()
    diag_emit_in_file("error", "MutOnPattern", MUT_ON_PATTERN, "`mut` must come before a name, not the variant `{name}`",
        diag_file_for_node(node), node_line(node), node_col(node), end_line, end_col,
        "remove `mut`; the variant `{name}` binds no name")
    if has_end && diag_entry_count() > before { diag_set_last_fix_at("remove `mut`", name, node_line(node), node_col(node), end_line, end_col) }
}

// `refutable`: the pattern is a match arm's, where an uppercase bare name is a variant (§3.5).
fn nr_check_pattern(node: Int, refutable: Bool) ! TypeCheck.Resolve, Diag.Report {
    if node == -1 { return }
    let kind = node_kind(node)

    if kind == NodeKind.IdentPattern {
        let name = node_name(node)
        if pattern_name_binds(name, refutable) {
            nr_define_mut_at(name, node_is_mut(node), node)
        } else if is_variant_name(name) != 0 && node_is_mut(node) != 0 && node_is_mut(node) != BINDER_MUT_RECOVERED {
            // An uppercase name no enum declares gets one error from the pattern check, at
            // the name, not a second one about `mut`.
            nr_report_mut_on_variant(node, name)
        }
        return
    }

    if kind == NodeKind.IntPattern || kind == NodeKind.StringPattern || kind == NodeKind.WildcardPattern {
        return
    }

    if kind == NodeKind.EnumPattern {
        let flds_sl = node_fields(node)
        if flds_sl != -1 {
            let is_struct_pat = node_int_val(node)
            let mut i = 0
            while i < sublist_length(flds_sl) {
                let f = sublist_get(flds_sl, i)
                if is_struct_pat != 0 {
                    // Struct-style fields are StructLitField nodes; bind by name
                    let fpat = node_pattern(f)
                    if fpat != -1 {
                        nr_check_pattern(fpat, refutable)
                    } else {
                        nr_define_mut_at(node_name(f), node_is_mut(f), f)
                    }
                } else {
                    nr_check_pattern(f, refutable)
                }
                i = i + 1
            }
        }
        return
    }

    if kind == NodeKind.StructPattern {
        let flds_sl = node_fields(node)
        if flds_sl != -1 {
            let mut i = 0
            while i < sublist_length(flds_sl) {
                let f = sublist_get(flds_sl, i)
                // A `field: pat` sub-pattern binds through the sub-pattern; only the
                // shorthand `field` binds the field name itself. The qualified
                // EnumPattern struct-style arm makes the same distinction — the bare and
                // qualified spellings are duals (§3.5).
                let fpat = node_pattern(f)
                if fpat != -1 {
                    nr_check_pattern(fpat, refutable)
                } else {
                    nr_define_mut_at(node_name(f), node_is_mut(f), f)
                }
                i = i + 1
            }
        }
        return
    }

    if kind == NodeKind.TuplePattern {
        let elems_sl = node_elements(node)
        if elems_sl != -1 {
            let mut i = 0
            while i < sublist_length(elems_sl) {
                nr_check_pattern(sublist_get(elems_sl, i), refutable)
                i = i + 1
            }
        }
        return
    }

    if kind == NodeKind.ListPattern {
        let elems_sl = node_elements(node)
        if elems_sl != -1 {
            let mut i = 0
            while i < sublist_length(elems_sl) {
                nr_check_pattern(sublist_get(elems_sl, i), refutable)
                i = i + 1
            }
        }
        return
    }

    if kind == NodeKind.OrPattern {
        let alts = node_elements(node)
        if alts != -1 && sublist_length(alts) > 0 {
            let or_start = nr_scope_names.len()
            nr_check_pattern(sublist_get(alts, 0), refutable)
            let mut i = 1
            while i < sublist_length(alts) {
                let saved_warn = nr_or_alt_open()
                nr_check_pattern(sublist_get(alts, i), refutable)
                for idx in nr_or_alt_close(or_start, saved_warn) {
                    let decl = nr_scope_nodes.get(idx).unwrap()
                    if decl != -1 { nr_check_shadow(nr_scope_names.get(idx).unwrap(), decl) }
                }
                i = i + 1
            }
        }
        return
    }

    if kind == NodeKind.RangePattern {
        return
    }

    if kind == NodeKind.AsPattern {
        nr_check_pattern(node_pattern(node), refutable)
        nr_define_typed(node_name(node), node_is_mut(node), TYPE_UNKNOWN, node)
        return
    }

    let _skip = 0
}

// ── Phase 2: Type compatibility ─────────────────────────────────────

pub fn resolve_alias_tid(tid: Int) -> Int {
    if tc_alias_underlying.len() == 0 { return tid }
    if tid < 0 || tid >= ty_pool.len() { return tid }
    let name = ty_pool.get(tid).unwrap().name
    let u = tc_alias_underlying_of(name)
    if u == -1 { tid } else { u }
}

// Walks a transparent `type Alias = X` chain from a bare (params_count 0) struct/enum
// NAME to the tid that actually determines its C spelling / injectivity — the single
// shared resolver for the three consumers that must agree on this (tc_tid_to_c_tag,
// tc_tid_inner_tag, tc_tid_struct_seg_injective), rather than each re-deriving it and
// risking a "two-speller, opposite rules" shape, repeated a third time if left alone.
// Bounded like resolve_alias_type_name's hop cap: a long alias-of-alias chain must
// terminate, not recurse unboundedly. Refuses to follow into a forward-declared alias
// whose RHS hadn't been registered yet — register_struct_type inserts the alias's own
// name into named_type_map before resolving its RHS, so a reference to a not-yet-declared
// type mints an orphaned TyKind.Typevar (resolve_type_ann's make_typevar fallback) instead of
// the real tid. Chasing that phantom would hand back tc_tid_to_c_tag's own "<tv>" poison
// sentinel as if it were a genuine resolution, baking it into a real C identifier instead
// of refusing to treat the alias as resolved. Returns -1 when `name` names no alias, or
// when the chain would return anything other than a genuine, encodable target.
pub fn tc_resolve_transparent_alias_name(name: Str) -> Int {
    if tc_alias_underlying.len() == 0 { return -1 }
    let mut cur_name = name
    let mut result = -1
    let mut hops = 0
    while hops < 8 {
        let next = tc_alias_underlying_of(cur_name)
        if next == -1 { return result }
        let nr = tc_resolve(next)
        if nr < 0 || nr >= ty_pool.len() { return result }
        let ne = ty_pool.get(nr).unwrap()
        if ne.kind == TyKind.Typevar || ne.kind == TyKind.Unknown { return result }
        // Direct self-alias (`type A = A`) resolves to a real, already-registered tid
        // for itself rather than a TyKind.Typevar placeholder, so the poison check above
        // does not catch it. A genuine multi-name cycle always has some direction that
        // forward-references a not-yet-declared name and mints an orphan TyKind.Typevar
        // there (register_struct_type inserts before resolving), which the check above
        // already terminates within a few hops — only the degenerate zero-indirection
        // self-loop has no such gap to be caught by. Without this, cur_name would never
        // change and the caller's self-recursion on an unchanged tid would spin forever.
        if ne.name == cur_name { return result }
        result = next
        if ne.kind != TyKind.Struct && ne.kind != TyKind.Enum { return result }
        if ne.params_count != 0 { return result }
        cur_name = ne.name
        hops = hops + 1
    }
    result
}

// Whether exactly one of two types is Never and the other is a settled type that is not.
// Never fits any slot as a whole value only (§3.2): a value of type Int does not fit a
// `Never` slot, and `List[Never]` is not a `List[Int]`.
fn tc_never_mismatch(a0: Int, b0: Int) -> Int {
    let a = tc_resolve(resolve_alias_tid(a0))
    let b = tc_resolve(resolve_alias_tid(b0))
    if a == b { return 0 }
    if a != TYPE_NEVER && b != TYPE_NEVER { return 0 }
    let other = if a == TYPE_NEVER { b } else { a }
    if tc_tid_is_no_info(other) != 0 { return 0 }
    let k = type_kind(other)
    if k == TyKind.Unknown || k == TyKind.Typevar { return 0 }
    1
}

// The slot `want` is Never and the value `got` is settled and is not. types_compatible is
// asked in both directions, so it lets Never through either way; a site that knows which
// side is the slot asks this too.
fn tc_value_misses_never_slot(want: Int, got: Int) -> Int {
    if tc_resolve(resolve_alias_tid(want)) != TYPE_NEVER { return 0 }
    tc_never_mismatch(want, got)
}

// A type argument, a field of a fn type, or any other part of a type built by a constructor:
// Never there is only Never.
fn tc_type_part_compatible(a: Int, b: Int) -> Int {
    if tc_never_mismatch(a, b) != 0 { return 0 }
    types_compatible(a, b)
}

fn types_compatible(a0: Int, b0: Int) -> Int {
    // Follow bound metavars to their solution FIRST: a pinned α reads as
    // its concrete type, so `let s: Str = intList.get(0).unwrap()` is now rejected
    // (α=Int vs Str) instead of silently accepted. An *unbound* α (or the shared
    // TYPE_UNKNOWN singleton) still resolves to a TyKind.Unknown entry and takes the
    // permissive branch below — the region-boundary check reports it as E0301, so
    // we do not double-report it here as a spurious mismatch.
    let a = tc_resolve(resolve_alias_tid(a0))
    let b = tc_resolve(resolve_alias_tid(b0))
    if a == b { return 1 }
    if a == TYPE_UNKNOWN || b == TYPE_UNKNOWN { return 1 }
    // §3.3: `Never` has no values, so a construct of that type never produces one and
    // vacuously satisfies any expected type. Symmetric because this predicate is asked
    // in both directions across the checker.
    if a == TYPE_NEVER || b == TYPE_NEVER { return 1 }
    // A negative or out-of-range tid is never a legitimate "pending unification"
    // state — unlike an unbound metavar (handled permissively below, and reported
    // once at the region boundary as E0301), a -1 is an ABSENCE: a lookup that found
    // nothing. Phase 1.2 closes the sources that minted it as an answer (Char.from_code_point
    // err arm, qualified-ctor evfield miss). Failing closed here turns any that survive
    // into an honest incompatibility instead of a silent accept.
    if a < 0 || b < 0 { return 0 }
    if a >= ty_pool.len() || b >= ty_pool.len() { return 0 }
    let ta = ty_pool.get(a).unwrap()
    let tb = ty_pool.get(b).unwrap()
    let ka = ta.kind
    let kb = tb.kind
    // An unbound metavar that survived resolution (kind TyKind.Unknown, not the
    // singleton) is still "compatible with anything" pending the boundary check.
    if ka == TyKind.Unknown || kb == TyKind.Unknown { return 1 }
    if ka == TyKind.Typevar || kb == TyKind.Typevar { return tc_typevar_pair_compatible(a, b) }
    // Int and Bool are interchangeable in Blink (C-style truthiness)
    if (ka == TyKind.Int || ka == TyKind.Bool) && (kb == TyKind.Int || kb == TyKind.Bool) { return 1 }
    // Sized integer kinds are compatible only with themselves (no implicit promotion)
    let is_sized_a = is_sized_int(ka)
    let is_sized_b = is_sized_int(kb)
    if is_sized_a || is_sized_b { return if ka == kb { 1 } else { 0 } }
    // Enums are nominally distinct from Int. An enum value
    // is NOT assignable to an Int target nor an Int to an enum target — INT vs ENUM
    // falls through to `ka == kb` (false → 0), mirroring the sized-int rule above.
    // Comparison (==/!=/<…) is unaffected: it short-circuits to Bool before reaching
    // types_compatible, so an enum tag stays comparable to an Int. Convert explicitly
    // via Enum.to_int() / Enum.from_int(n) -> Option[Enum].
    if ka == kb {
        if ka == TyKind.List || ka == TyKind.Option || ka == TyKind.Iterator || ka == TyKind.Set {
            return tc_type_part_compatible(ta.inner1, tb.inner1)
        }
        // A pointer is compatible only with a pointer to the same thing. Same
        // one-inner recursion as the line above, spelled separately because the reason differs:
        // for List/Option/Set the payload is a Blink value, here it is a C memory layout, and
        // `int64_t*` vs `blink_Pollfd*` is a stride and field-offset difference that the C
        // compiler rejects outright. Recursing is what turns that cc error into a TypeError.
        //
        // Ptr[Void] is deliberately NOT special-cased into a universal pointer. C converts
        // void* implicitly in both directions, so importing that rule would make every Ptr
        // assignable to every other via one Void hop — the exact hole this arm closes. If a real
        // FFI signature needs the C conversion, it belongs in an explicit cast, not in the
        // compatibility relation.
        if ka == TyKind.Ptr {
            return tc_type_part_compatible(ta.inner1, tb.inner1)
        }
        // The phantom injection context, and the same one-inner recursion for a third
        // distinct reason: sections/03b_contracts.md:566 is normative — "`Template[DB]` and
        // `Template[Shell]` are distinct types. You cannot pass a `Template[Shell]` to a function
        // expecting `Template[DB]`." Without this arm two Templates matched on kind alone, which
        // is the cross-context confusion the phantom exists to prevent.
        //
        // It is VACUOUS for the spec's own examples, deliberately and unavoidably: `DB` and
        // `Shell` there are EFFECT names, effect names are not in the type namespace, so each
        // phantom resolves to a typevar and the typevar arm above already returned 1. So this
        // arm bites only when the context is a real type. Making the effect spelling bite is a
        // spec question (filed) and not something a compatibility arm can decide.
        if ka == TyKind.Template {
            return tc_type_part_compatible(ta.inner1, tb.inner1)
        }
        // Two handler types are interchangeable exactly when they install into the
        // same effect slot, and the slot is picked by the ROOT effect — resolve_effect_vtable
        // (codegen_types.bl:1455) maps `IO`, `IO.Print`, `IO.Log` and `IO.Eprint` all onto
        // `blink_io_vtable`, and groups every user effect by `ue.name` plus
        // `starts_with("{ue.name}.")`. So this is not name equality and not a loosening of one:
        // it IS the equivalence the C representation already uses, which is why it cannot reject
        // a program that compiles today (lib/std/testing.bl returns Handler[IO.Log] /
        // [IO.Print] / [IO.Eprint] and they flow into `Handler[IO]` positions).
        //
        // The effect lives in the NAME slot rather than in a child (make_handler_type), so this
        // compares strings where the arms above recurse on tids. There is no child to recurse
        // into — an effect is not a type.
        //
        // Whether the type system SHOULD go finer than the representation — a `Handler[IO]`
        // parameter rejecting a `Handler[IO.Print]` argument as too narrow, or accepting it as a
        // subtype — is a sub-effect variance question the spec does not answer, and it is not
        // this arm's to decide. Filed as friction.
        if ka == TyKind.Handler {
            return if tc_handler_effect_root(ta.name) == tc_handler_effect_root(tb.name) { 1 } else { 0 }
        }
        if ka == TyKind.Map {
            if tc_type_part_compatible(ta.inner1, tb.inner1) == 0 { return 0 }
            return tc_type_part_compatible(ta.inner2, tb.inner2)
        }
        if ka == TyKind.Result {
            if tc_type_part_compatible(ta.inner1, tb.inner1) == 0 { return 0 }
            return tc_type_part_compatible(ta.inner2, tb.inner2)
        }
        if ka == TyKind.Tuple {
            if ta.params_count != tb.params_count { return 0 }
            let mut i = 0
            while i < ta.params_count {
                let ea = ty_param_list.get(ta.params_start + i).unwrap()
                let eb = ty_param_list.get(tb.params_start + i).unwrap()
                if tc_type_part_compatible(ea, eb) == 0 { return 0 }
                i = i + 1
            }
            return 1
        }
        // A function value is called with the arguments its slot's type names and read back as
        // that type's return, so the arity and every position must agree. The spec gives no
        // variance for parameters or return (§3.3: `fn() -> Never` is not a `fn() -> Int`).
        if ka == TyKind.Fn {
            return if tc_fn_mismatch_detail(a, b) == "" { 1 } else { 0 }
        }
        if ka == TyKind.Struct || ka == TyKind.Enum {
            // Nominal equality by base name first (mirrors the TyKind.Tuple branch
            // above). Two struct/enum tids are compatible iff they name the same
            // declaration; the module qualifier is stripped on both sides so a
            // qualified and bare reference to the same type still match (precedent:
            // strip_module_qualifier at tc_type_name callers below).
            if strip_module_qualifier(ta.name) != strip_module_qualifier(tb.name) { return 0 }
            // Same declaration: a generic struct carries its concrete type-args as
            // params (Box[Int] built by make_struct_instance_type). If BOTH sides
            // carry params, they must specialize identically — element-wise like a
            // tuple. If EITHER is the bare generic (params_count 0), it
            // is the un-specialized form and matches any specialization of the same
            // name (bare Box ~ Box[Int]); enums have no params → this is a no-op and
            // the branch reduces to the old name-only (a==b) behavior for them.
            if ta.params_count > 0 && tb.params_count > 0 {
                if ta.params_count != tb.params_count { return 0 }
                let mut si = 0
                while si < ta.params_count {
                    let sea = ty_param_list.get(ta.params_start + si).unwrap()
                    let seb = ty_param_list.get(tb.params_start + si).unwrap()
                    if tc_type_part_compatible(sea, seb) == 0 { return 0 }
                    si = si + 1
                }
            }
            return 1
        }
        return 1
    }
    0
}

// The first way a function value of type `got` fails to fit a slot of type `want`, worded for
// the end of a TypeError, or "" when it fits or either side is not a function type.
// types_compatible decides with this, so the reason a site reports is the one it was refused for.
fn tc_fn_mismatch_detail(want0: Int, got0: Int) -> Str {
    let want = tc_resolve(resolve_alias_tid(want0))
    let got = tc_resolve(resolve_alias_tid(got0))
    if tc_tid_kind(want) != TyKind.Fn || tc_tid_kind(got) != TyKind.Fn { return "" }
    // Child 0 of a Fn is its RETURN; the params start at 1 (tc_tid_child).
    let nwant = tc_tid_child_count(want) - 1
    let ngot = tc_tid_child_count(got) - 1
    if nwant != ngot {
        let noun = if nwant == 1 { "parameter" } else { "parameters" }
        return "expects {nwant} {noun}, got {ngot}"
    }
    let mut i = 1
    while i <= nwant {
        let pw = tc_tid_child(want, i)
        let pg = tc_tid_child(got, i)
        let settled = tc_tid_is_no_info(pw) == 0 && tc_tid_is_no_info(pg) == 0
        if settled && tc_type_part_compatible(pw, pg) == 0 {
            return "parameter {i} expects {type_to_str(pw)}, got {type_to_str(pg)}"
        }
        i = i + 1
    }
    let rw = tc_tid_child(want, 0)
    let rg = tc_tid_child(got, 0)
    let ret_settled = tc_tid_is_no_info(rw) == 0 && tc_tid_is_no_info(rg) == 0
    if ret_settled && tc_type_part_compatible(rw, rg) == 0 {
        return "return type expects {type_to_str(rw)}, got {type_to_str(rg)}"
    }
    ""
}

// The closure `val0` is, seen through the wrappers a value position adds, when that closure
// has no `-> R`; -1 otherwise.
fn tc_fn_value_unannotated_closure(val0: Int) -> Int {
    let mut val = val0
    let mut depth = 0
    while val != -1 && depth < 8 {
        let k = node_kind(val)
        if k == NodeKind.NamedArg || k == NodeKind.ExprStmt {
            val = node_value(val)
        } else if k == NodeKind.Block {
            let tail = tc_block_tail_stmt(val)
            val = if tail == -1 { -1 } else { tc_block_tail_value(tail) }
        } else {
            break
        }
        depth = depth + 1
    }
    if val == -1 || node_kind(val) != NodeKind.Closure || node_type_ann(val) != -1 { return -1 }
    val
}

// Two fn values that share one type (list elements, the branches of an `if`, the arms of a
// `match`) return one type. A return slot still open on either side is bound to the other
// side's return, so each body walk holds its closure to that one return; otherwise each
// closure would settle its own and a list of them could mix Int and Str behind one element
// type. The slot is open on a closure with no `-> R` (tc_closure_ret_slot), and on an `if` or
// `match` of such closures, whose own type carries its first closure's slot.
fn tc_tie_fn_rets(a_t: Int, b_t: Int) {
    let a = tc_resolve(a_t)
    let b = tc_resolve(b_t)
    if tc_tid_kind(a) != TyKind.Fn || tc_tid_kind(b) != TyKind.Fn { return }
    if tc_tid_child_count(a) != tc_tid_child_count(b) { return }
    let a_ret = tc_resolve(tc_tid_child(a, 0))
    let b_ret = tc_resolve(tc_tid_child(b, 0))
    if tc_tid_is_no_info(a_ret) != 0 || tc_tid_is_no_info(b_ret) != 0 { return }
    if tc_is_unbound_metavar(a_ret) != 0 {
        let _ = bind_metavar(a_ret, b_ret)
        return
    }
    let _ = bind_metavar(b_ret, a_ret)
}

// Whether two values that one form yields as a single type (the branches of an `if`, the arms
// of a `match`) can share it. Their fn returns are tied first, so a closure with no `-> R` is
// held to its sibling's return by its own body walk, not compared here against a return its
// body has not produced yet.
fn tc_branch_values_agree(a_node: Int, a_t: Int, b_node: Int, b_t: Int) -> Int {
    if tc_tid_is_no_info(a_t) != 0 || tc_tid_is_no_info(b_t) != 0 { return 1 }
    // A diverging value yields nothing, so it fits any type (Never is a subtype of every type).
    if tc_resolve(a_t) == TYPE_NEVER || tc_resolve(b_t) == TYPE_NEVER { return 1 }
    tc_tie_fn_rets(a_t, b_t)
    if tc_tid_has_unknown(a_t) != 0 || tc_tid_has_unknown(b_t) != 0 { return 1 }
    types_compatible(tc_fn_value_open_ret(a_node, a_t), tc_fn_value_open_ret(b_node, b_t))
}

// A `match` used as a value yields one type, so every arm that yields a value must share the
// type of the first one that does. An arm with no value makes the whole match `()` (§3.3), so
// the others' values are dropped rather than compared; a diverging arm fits any type. One
// report per match, at the first arm that disagrees.
fn tc_report_match_arm_mismatch(nodes: List[Int], types: List[Int]) ! TypeCheck.Report, Diag.Report {
    for t in types {
        if tc_tid_is_no_info(t) == 0 && tc_resolve(t) == TYPE_VOID { return }
    }
    let mut first = -1
    let mut i = 0
    while i < types.len() {
        let t = types.get(i).unwrap()
        if tc_tid_is_no_info(t) == 0 && tc_resolve(t) != TYPE_NEVER {
            if first == -1 {
                first = i
            } else {
                let first_t = types.get(first).unwrap()
                if tc_branch_values_agree(nodes.get(first).unwrap(), first_t, nodes.get(i).unwrap(), t) == 0 {
                    tc_error_at("match arms have incompatible types: {type_to_str(first_t)} vs {type_to_str(t)}", tc_value_report_node(nodes.get(i).unwrap()))
                    return
                }
            }
        }
        i = i + 1
    }
}

// The value a body yields: a block's tail value, or the body itself when it is no block.
fn tc_value_tail_of(body: Int) -> Int {
    if body == -1 || node_kind(body) != NodeKind.Block { return body }
    let tail = tc_block_tail_stmt(body)
    if tail == -1 { return -1 }
    tc_block_tail_value(tail)
}

// The branch or arm compare for an `if` or `match` whose value a walk that did not consume it
// has already typed in its own scopes.
fn tc_report_consumed_branch_mismatch(val: Int) ! TypeCheck.Report, Diag.Report {
    if val == -1 { return }
    let k = node_kind(val)
    if k == NodeKind.MatchExpr {
        tc_report_walked_match_arm_mismatch(val)
    } else if k == NodeKind.IfExpr && node_else_body(val) != -1 {
        tc_report_if_branch_mismatch(val)
    }
}

// Where a report about a value points: a block's tail value, which is what disagrees, else the
// value itself.
fn tc_value_report_node(val: Int) -> Int {
    let tail_val = tc_value_tail_of(val)
    if tail_val == -1 { return val }
    tail_val
}

// Whether any arm of a match is a block whose tail names a binding of that block. Such an arm
// is typed only once the walk has opened its scope, so its compare waits for that walk
// (tc_report_deferred_branch_mismatch), as an `if` with such a branch does.
fn tc_match_declaring_arm(node: Int) -> Int {
    let arms_sl = node_arms(node)
    if arms_sl == -1 { return 0 }
    let mut i = 0
    while i < sublist_length(arms_sl) {
        if tc_block_tail_reads_own_local(tc_arm_body_value(sublist_get(arms_sl, i))) != 0 { return 1 }
        i = i + 1
    }
    0
}

// A match's arm value nodes and the types the walk memoized for them in their own scopes.
fn tc_report_walked_match_arm_mismatch(node: Int) ! TypeCheck.Report, Diag.Report {
    let arms_sl = node_arms(node)
    if arms_sl == -1 { return }
    let mut nodes: List[Int] = []
    let mut types: List[Int] = []
    let mut i = 0
    while i < sublist_length(arms_sl) {
        let v = tc_arm_body_value(sublist_get(arms_sl, i))
        nodes.push(v)
        types.push(if v == -1 { -1 } else { tc_scoped_value_memo(v, 0) })
        i = i + 1
    }
    tc_report_match_arm_mismatch(nodes, types)
}

// The fn type `val` offers to a comparison made before its closure body is walked. A closure
// with no `-> R` returns its body's type, but until check_closure_body has walked the body its
// tid holds an unfilled return slot (or, from an older stamp, the Void default), which is not an
// answer, so the return is left open there. A position that declares the fn type seeds the
// closure instead (tc_seed_expected_into_value).
fn tc_fn_value_open_ret(val0: Int, t: Int) -> Int {
    if tc_fn_value_unannotated_closure(val0) == -1 { return t }
    let r = tc_resolve(t)
    if tc_tid_kind(r) != TyKind.Fn { return t }
    let ret = tc_resolve(tc_tid_child(r, 0))
    if ret != TYPE_VOID && tc_is_unbound_metavar(ret) == 0 { return t }
    let mut params: List[Int] = []
    let mut i = 1
    while i < tc_tid_child_count(r) {
        params.push(tc_tid_child(r, i))
        i = i + 1
    }
    make_fn_type(TYPE_UNKNOWN, params)
}

// Whether `val` is a closure that a fn-typed position of its own arity seeded. The seed checks
// each parameter and return the closure wrote against that position and gives every one it
// left unwritten the declared type, so a compare of the two can only repeat the closure check's
// own report, which names the parameter. The position leaves such a closure to it.
fn tc_closure_checked_against(val0: Int, want: Int) -> Bool {
    let mut val = val0
    if val != -1 && (node_kind(val) == NodeKind.NamedArg || node_kind(val) == NodeKind.Return) { val = node_value(val) }
    if val == -1 || node_kind(val) != NodeKind.Closure { return false }
    let w = tc_resolve(resolve_alias_tid(want))
    if tc_tid_kind(w) != TyKind.Fn { return false }
    let params_sl = node_params(val)
    let n = if params_sl == -1 { 0 } else { sublist_length(params_sl) }
    n == tc_tid_child_count(w) - 1
}

// tc_fn_mismatch_detail as the tail of a site's own TypeError, so the site keeps its wording and
// a function-value mismatch also names the position that failed.
fn tc_fn_mismatch_suffix(want: Int, got: Int) -> Str {
    let d = tc_fn_mismatch_detail(want, got)
    if d != "" { return ": {d}" }
    let hint = tc_std_time_mismatch_hint(tc_std_time_type_name(want), tc_std_time_type_name(got))
    if hint == "" { "" } else { ": {hint}" }
}

// Help for a name that is undefined because Blink spells the idea another way.
fn tc_undefined_name_help(name: Str) -> Str {
    match name {
        "DateTime" => "std.time has no DateTime: an Instant is already a point in UTC. For an Instant `x`, write `x.date()` for its calendar day and `x.hour()` for its hour; for now, write `time.read()`, and `time.read().date()` for today"
        _ => ""
    }
}

// The std.time conversion a mismatch most likely wants. An Instant is a point in UTC and a
// Date is a calendar day, so code written for a DateTime type passes one where the other goes.
fn tc_std_time_mismatch_hint(want: Str, got: Str) -> Str {
    match want {
        "Date" => if got == "Instant" { "call `.date()` on the Instant to get its UTC calendar day" } else { "" }
        "Instant" => if got == "Date" { "call `.to_instant()` on the Date to get its midnight in UTC" } else { "" }
        _ => ""
    }
}

// The name of a type declared in std.time, or "" for any other type, so that a user type
// that happens to be named Date gets no std.time hint.
fn tc_std_time_type_name(tid: Int) -> Str {
    let decl = tc_tid_decl_node(tid)
    if decl < 0 || node_source_module(decl) != "std_time" { return "" }
    node_name(decl)
}

// Assignment-position compatibility: like types_compatible, but allows an
// untyped integer literal RHS to flow into a sized-int target (I8/U32/...).
// Kept OUT of types_compatible so function-arg checking stays strict.
// A literal may already carry the integer type one position stamped on it; it is still a
// literal, so a check against another integer type takes it too.
fn assignment_types_compatible(target_t: Int, val_t: Int, val_node: Int) -> Int {
    if tc_value_misses_never_slot(target_t, val_t) != 0 { return 0 }
    if types_compatible(target_t, val_t) == 1 { return 1 }
    let literal_to_int = is_integer_type(target_t) != 0 && is_integer_type(val_t) != 0 && is_int_literal_node(val_node) != 0
    if literal_to_int { return 1 }
    0
}

// Picks the more concrete of two compatible types. Used by branch
// unification (if/else, match) so that a Result[Int, ?] merged with a
// Result[?, Bool] yields Result[Int, Bool] instead of dropping the
// concrete payload from one side. Caller must have already validated
// `types_compatible(a, b)`.
pub fn type_merge(a0: Int, b0: Int) -> Int {
    // Branch unification is a constraining use: `if c { None } else {
    // Some(x) }` must PIN the None's element α from the Some branch, so the merged
    // binding is Option[T] and never trips E0301. Resolve bound metavars first,
    // then unify an unbound α on either side against the other (tc_unify binds it
    // in place) and return the now-concrete side. When the other side is a rigid
    // typevar, tc_unify is vacuous (it never binds a typevar), so α stays unbound;
    // the metavar carries no information, so return the determined side directly —
    // otherwise merging Some's Option[T] with None's Option[α] would erase T.
    let a = tc_resolve(a0)
    let b = tc_resolve(b0)
    // Fail CLOSED on a side that carries no information. Adopting the other side would let a
    // caller that never checked types_compatible launder an absence into a real merged answer,
    // and a raw -1 escaping as a type is the forbidden third default state
    // (decisions/under-determined-types.md). The callers that legitimately have one empty side —
    // a match arm that diverges, an if with no else — test tc_tid_is_no_info themselves and pick
    // the other side without entering this function. The singleton is the answer here because
    // there is no report to make: the argument is malformed, not the program.
    if tc_tid_is_no_info(a) != 0 || tc_tid_is_no_info(b) != 0 { return tc_unknown_tid() }
    // A diverging branch contributes no value, so the other branch decides the merge.
    if a == TYPE_NEVER { return b }
    if b == TYPE_NEVER { return a }
    if a == b { return a }
    if tc_is_unbound_metavar(a) != 0 {
        let _ = tc_unify(a, b)
        let ra = tc_resolve(a)
        if tc_is_unbound_metavar(ra) != 0 { return b }
        return ra
    }
    if tc_is_unbound_metavar(b) != 0 {
        let _ = tc_unify(b, a)
        let rb = tc_resolve(b)
        if tc_is_unbound_metavar(rb) != 0 { return a }
        return rb
    }
    let ta = ty_pool.get(a).unwrap()
    let tb = ty_pool.get(b).unwrap()
    if ta.kind != tb.kind { return a }
    if ta.kind == TyKind.List {
        let inner = type_merge(ta.inner1, tb.inner1)
        if inner == ta.inner1 { return a }
        if inner == tb.inner1 { return b }
        return make_list_type(inner)
    }
    if ta.kind == TyKind.Option {
        let inner = type_merge(ta.inner1, tb.inner1)
        if inner == ta.inner1 { return a }
        if inner == tb.inner1 { return b }
        return make_option_type(inner)
    }
    if ta.kind == TyKind.Set {
        let inner = type_merge(ta.inner1, tb.inner1)
        if inner == ta.inner1 { return a }
        if inner == tb.inner1 { return b }
        return make_set_type(inner)
    }
    if ta.kind == TyKind.Result {
        let i1 = type_merge(ta.inner1, tb.inner1)
        let i2 = type_merge(ta.inner2, tb.inner2)
        if i1 == ta.inner1 && i2 == ta.inner2 { return a }
        if i1 == tb.inner1 && i2 == tb.inner2 { return b }
        return make_result_type(i1, i2)
    }
    if ta.kind == TyKind.Map {
        let k = type_merge(ta.inner1, tb.inner1)
        let v = type_merge(ta.inner2, tb.inner2)
        if k == ta.inner1 && v == ta.inner2 { return a }
        if k == tb.inner1 && v == tb.inner2 { return b }
        return make_map_type(k, v)
    }
    // Tuples carry their elements variadically, not in inner1/inner2, so the recursion is a
    // loop rather than two hand-written slots — but the constraining effect is identical to
    // the containers above: a carrier metavar left open in one branch's element is bound in
    // place by the sibling's element (tc_unify inside the recursive merge). Differing arity is
    // not mergeable, so fall through to `a` exactly as a kind mismatch does.
    if ta.kind == TyKind.Tuple {
        if ta.params_count != tb.params_count { return a }
        let mut merged: List[Int] = []
        let mut all_eq_a = 1
        let mut all_eq_b = 1
        let mut i = 0
        while i < ta.params_count {
            let ea = ty_param_list.get(ta.params_start + i).unwrap()
            let eb = ty_param_list.get(tb.params_start + i).unwrap()
            let em = type_merge(ea, eb)
            if em != ea { all_eq_a = 0 }
            if em != eb { all_eq_b = 0 }
            merged.push(em)
            i = i + 1
        }
        if all_eq_a == 1 { return a }
        if all_eq_b == 1 { return b }
        return make_tuple_type(merged)
    }
    a
}

// Short-form arm bodies parse as ExprStmt; unwrap so infer_type sees the expression.
// The arm body is inferred inside a scope where the arm's PATTERN bindings carry their
// types — `w as "hi" => { w }` must see `w: Str`, not the out-of-scope UNKNOWN that a bare
// infer_type would return. Without the scope, a match whose every arm's value is a binder
// merged to TYPE_UNKNOWN. This scope makes the merged type correct wherever infer_type is
// called on the match node — call arg, interp, method receiver, and the tail/let/return
// positions the tc_check_body recovery reaches. It is NOT enough on its own for a match hidden
// in a non-generic struct-lit field: infer_type never inters that field, so tc_check_body's
// StructLit arm must descend into it (from binding, tail and return position) for the memo to
// be written at all. Once written, codegen reads Str and `.len()` on the receiver resolves.
//
// tc_check_pattern_types runs on every infer_type(match), which happens many times per node;
// its names and tids are idempotent and a repeated report is one diagnostic. The scope is
// pushed and popped here so the bindings never leak past the arm.
// A match arm GUARD. Both match walks bound the arm's pattern and then went straight to the
// body, so `v if v < 0 => ..` left the guard and everything under it with no type — and with no
// Bool check either. It must be typed inside the arm's own scope, where the pattern bindings the
// guard names exist.
fn tc_check_arm_guard(arm: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let g = node_guard(arm)
    if g == -1 { return }
    let gt = tc_check_nested_value(g)
    if is_bool_compat(gt) == 0 {
        tc_error_at("match guard must be Bool, got {type_to_str(gt)}", g)
    }
}

// A pattern fault is reported here as well as from the statement walk: a match nested in an
// expression (a call argument) is reached by this walk alone. Repeats are one diagnostic.
fn infer_arm_body(arm: Int, scrut_tid: Int, subject: Str) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let b = node_body(arm)
    // No body is an ABSENCE — this arm contributes nothing to the merge. The merge below reads
    // that through tc_tid_is_no_info, which is the same test it applies to the diverging-arm
    // placeholder, so the two need not be the same value.
    if b == -1 { return -1 }
    nr_push_scope()
    let _ = tc_check_pattern_types_against(node_pattern(arm), scrut_tid, subject, true)
    tc_check_arm_guard(arm)
    // Infer the BODY NODE whatever its shape. infer_type answers for the statement kinds a
    // braceless arm produces (ExprStmt passes through to its value, a control transfer is
    // Never), so the body node itself is stamped and codegen's divergence read is one path
    // for the braced and the braceless spelling alike.
    let r = infer_type(b)
    nr_pop_scope()
    r
}

pub fn type_kind(tid0: Int) -> TyKind {
    // Resolve bound metavars so a pinned α reports its solution's kind.
    let tid = tc_resolve(tid0)
    if tid < 0 || tid >= ty_pool.len() { return TyKind.Unknown }
    ty_pool.get(tid).unwrap().kind
}

// Blink treats Int as truthy — Int is valid in Bool contexts
fn is_bool_compat(tid: Int) -> Int {
    if tc_tid_is_no_info(tid) != 0 { return 1 }
    if tid == TYPE_BOOL { return 1 }
    if tid == TYPE_INT { return 1 }
    let k = type_kind(tid)
    if k == TyKind.Bool || k == TyKind.Int { return 1 }
    0
}

pub fn is_sized_int(k: TyKind) -> Int {
    if k == TyKind.I8 || k == TyKind.I16 || k == TyKind.I32 { return 1 }
    if k == TyKind.U8 || k == TyKind.U16 || k == TyKind.U32 || k == TyKind.U64 { return 1 }
    0
}

pub fn is_integer_type(tid: Int) -> Int {
    if tc_tid_is_no_info(tid) != 0 { return 0 }
    let k = type_kind(tid)
    if k == TyKind.Int { return 1 }
    is_sized_int(k)
}

// The arithmetic traits (Add/Sub/Mul/Div/Rem/Neg) are sealed to the built-in numeric types —
// Int, the sized ints, and Float — and user types cannot implement them (spec
// sections/03_types.md:1988, sections/02_syntax.md:1046). So `+ - * / %`, unary `-`, and the
// compound forms accept only a numeric operand: a struct, an @ffi.opaque handle (whose pointer
// would otherwise form a silent ptrdiff in C), an enum, Bool (no truthiness — DECISIONS.md:109),
// Char, or Str is not one. Without this a same-typed non-numeric pair passes the
// types_compatible mismatch check and reaches codegen. Resolves aliases so `type Port = Int`
// still counts as numeric.
fn is_arith_numeric_type(tid: Int) -> Int {
    let k = type_kind(resolve_alias_tid(tid))
    if k == TyKind.Int || k == TyKind.Float { return 1 }
    if is_sized_int(k) != 0 { return 1 }
    // Fail-open only on types this check genuinely cannot model at the definition site:
    //   - Unknown: not yet resolved (includes TYPE_UNKNOWN, kind Unknown).
    // Typevar is NOT fail-open here: an abstract type parameter is numeric only when
    // an arithmetic bound licenses it. This function answers "is the type itself a
    // built-in numeric" (no, for a Typevar); reject_non_numeric_arith_operand layers
    // the bound check on top, accepting a bounded `T` and rejecting an unbounded one
    // at its definition (§3.1: no rule enforced only at codegen).
    //   - Never: §3.3 makes it a subtype of every type, and it has no values, so the
    //     numeric requirement holds vacuously and the operand is unreachable anyway.
    if k == TyKind.Unknown || k == TyKind.Never { return 1 }
    // Void is NOT fail-open. It once stood in for an under-inferred value, so refusing it
    // would have refused programs the compiler already accepted; metavar inference ended
    // that, and an under-determined type is now E0301 rather than a Void default. So a
    // Void operand is a value of type Void, and the arithmetic traits are sealed to the
    // built-in numerics (03_types.md:576) — which Void is not.
    0
}

fn reject_non_numeric_arith_operand(op: Str, tid: Int, node: Int, is_unary: Int) ! TypeCheck.Report, Diag.Report {
    if is_arith_numeric_type(tid) == 0 {
        if type_kind(resolve_alias_tid(tid)) == TyKind.Typevar {
            let tpname = type_to_str(tid)
            let traits = tc_tparam_bound_traits(tpname)
            // "" means `tpname` is not an active type parameter. `Self` is pushed as a
            // frame in a trait default body, so this is only an unmodeled builtin lowered
            // to a typevar — leave it alone, matching reject_unlicensed_comparison.
            if traits == "" { return }
            let bt = arith_backing_trait(op, is_unary)
            let bm = arith_backing_method(op, is_unary)
            // Each operator is licensed only by its OWN backing trait (§3.6): `[T: Add]`
            // licenses `+`, not `*` (which desugars to Mul). An arithmetic-family bound no
            // longer blanket-licenses every arithmetic operator. A licensed body checks
            // under the bound and monomorphizes at a numeric type (arithmetic traits are
            // sealed to the numerics, 03_types.md:2011).
            if tc_pipe_has(traits, bt) != 0 { return }
            // `Self` in a trait default body: report against the trait definition with
            // the sealed-arithmetic diagnostic. Because the arithmetic traits are sealed
            // to the numerics, naming one as a supertrait is not an actionable repair, so
            // the help does NOT suggest it (Q5=B) — it names the seal and the real options.
            if tpname == "Self" {
                diag_error_at("UnlicensedSelfOperation", UNLICENSED_SELF_OP,
                    "`{op}` on `Self` is not licensed by `{tc_current_self_trait}` (`{op}` desugars to {bt}.{bm}, but `{tc_current_self_trait}` does not require {bt})", node,
                    "{bt} is a sealed arithmetic trait — only built-in numeric types implement it, so no user type could satisfy it; make this a required method (drop the default body) so each implementor defines it, or use a concrete numeric type instead of `Self`")
                return
            }
            if tc_report_shadowed_operator_bound(op, tpname, bt, bt, traits, node) { return }
            let sealed = "the arithmetic traits (Add/Sub/Mul/Div/Rem/Neg) are sealed to the built-in numeric types"
            let help = if tc_shadowing_trait_key(bt, nr_current_module) == "" {
                "add the matching arithmetic bound, e.g. `[{tpname}: {bt}]`; {sealed}"
            } else {
                "{tc_core_bound_fix(bt, tpname)}\n{sealed}"
            }
            diag_error_at_notes("TypeError", TYPE_ERROR,
                "arithmetic `{op}` requires the {bt} bound on type parameter {tpname} (`{op}` desugars to {bt}.{bm})", node,
                help, tc_shadowed_trait_notes(bt))
            return
        }
        tc_error_at("arithmetic `{op}` requires numeric operand, got {type_to_str(tid)}", node)
    }
}

fn is_shift_amount_type(tid: Int, rhs_node: Int) -> Int {
    if tc_tid_is_no_info(tid) != 0 { return 1 }
    let k = type_kind(tid)
    if k == TyKind.U32 { return 1 }
    if k == TyKind.Int && rhs_node != -1 && node_kind(rhs_node) == NodeKind.IntLit { return 1 }
    0
}

fn tc_type_name(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    ty_pool.get(tid).unwrap().name
}

// What `==` needs of a type, read through every type it is built from (03_types.md,
// *Container Equality*). The answer runs from the type asked to the innermost type with
// no `Eq`, and is empty when the type is `Eq`.
fn eq_need_through(tid: Int, inner: List[Int]) -> List[Int] {
    let mut path: List[Int] = [tid]
    for t in inner { path.push(t) }
    path
}

// A type built from `parts` is `Eq` when every part is. The first part with no `Eq`
// is the one reported, so the chain names a single innermost type.
fn tc_eq_need_parts(tid: Int, parts: List[Int], visiting: List[Int]) -> List[Int] {
    for p in parts {
        let need = tc_eq_need(p, visiting)
        if need.len() > 0 { return eq_need_through(tid, need) }
    }
    []
}

// The interim enum rule: an enum with an `Eq` impl or derive is `Eq`, one with no
// payloads is `Eq`, and any other is `Eq` only if every payload type is. Payloads are
// read at the instance, so `Tree[Widget]` asks about `Widget`, not `T`. An enum already
// being walked counts as `Eq`, which lets a self-recursive enum answer from its other
// payloads.
fn tc_eq_need_enum(tid: Int, visiting: List[Int]) -> List[Int] {
    let base = tc_enum_base_tid(tid)
    let bname = strip_module_qualifier(tc_type_name(base))
    match tc_hand_impl_need(tid, base, "Eq", "eq", visiting) {
        Some(need) => { return need }
        None => {}
    }
    if tc_type_name_derives(bname, "Eq") != 0 && base == tid { return [] }
    if !tc_enum_has_payload(base) { return [] }
    if tc_need_visited(visiting, tid) { return [] }
    let inst = if base == tid { -1 } else { tid }
    let mut parts: List[Int] = []
    for vslot in tc_enum_variant_slots(base) {
        for fslot in tc_evar_field_slots(vslot) {
            parts.push(tc_member_tid_at_instance(tc_evfield_tid(fslot), inst))
        }
    }
    tc_eq_need_parts(tid, parts, tc_need_visiting(visiting, tid))
}

// A hand impl answers where its own bounds hold (tc_hand_impl_need). A derive answers from
// the fields, read at the instance, so `Box[Widget]` asks about `Widget` (03_types.md,
// *Generic Type Bound Inference*). A struct already being walked counts as `Eq`, as an enum
// does.
fn tc_eq_need_struct(tid: Int, visiting: List[Int]) -> List[Int] {
    let base = tc_struct_base_tid(tid)
    match tc_hand_impl_need(tid, base, "Eq", "eq", visiting) {
        Some(need) => { return need }
        None => {}
    }
    if tc_type_name_derives(strip_module_qualifier(tc_type_name(base)), "Eq") == 0 { return [tid] }
    tc_struct_need_fields(tid, base, "Eq", visiting)
}

// A derived impl on a struct holds where every field, read at the instance, has the trait.
fn tc_struct_need_fields(tid: Int, base: Int, tr: Str, visiting: List[Int]) -> List[Int] {
    if base == tid || tc_need_visited(visiting, tid) { return [] }
    let inner = tc_need_visiting(visiting, tid)
    for slot in tc_struct_field_slots(base) {
        let need = tc_trait_need(tc_member_tid_at_instance(tc_sfield_tid(slot), tid), tr, inner)
        if need.len() > 0 { return eq_need_through(tid, need) }
    }
    []
}

// An instance already being walked counts as having the trait, which lets a recursive type
// answer from its other parts. The walk is keyed by instance, so `Box[Box[Widget]]` still
// reads `Box[Widget]`; a type whose recursion grows its arguments (`Nest[A]` holding a `Nest[List[A]]`)
// would never repeat one, so past a fixed depth the walk stops and asks nothing.
fn tc_need_visited(visiting: List[Int], tid: Int) -> Bool {
    if visiting.len() >= 32 { return true }
    for v in visiting {
        if tc_tid_same_type(v, tid) { return true }
    }
    false
}

fn tc_need_visiting(visiting: List[Int], tid: Int) -> List[Int] {
    let mut inner: List[Int] = []
    for v in visiting { inner.push(v) }
    inner.push(tid)
    inner
}

// What `tr` needs of `tid`, read as tc_eq_need reads `Eq`: the chain from `tid` to the
// innermost type without the trait, or empty when `tid` has it. A trait this has no rule
// for asks nothing, so no caller refuses on it.
fn tc_trait_need(tid: Int, tr: Str, visiting: List[Int]) -> List[Int] {
    match tr {
        "Eq" => tc_eq_need(tid, visiting)
        "Ord" => tc_ord_need(tid, visiting)
        "Hash" => tc_derive_only_need(tid, tr)
        "Debug" => tc_derive_only_need(tid, tr)
        "Serialize" => tc_derive_only_need(tid, tr)
        _ => []
    }
}

fn tc_derive_only_need(tid0: Int, tr: Str) -> List[Int] {
    let tid = resolve_alias_tid(tc_resolve(tid0))
    if tc_derive_only_fact(tid, tr) == -1 { return [tid] }
    []
}

// Whether the instance `tid` has `tr`, by the rule the type checker judged it with. Pure,
// so codegen emits a derived body only at an instance where the derive holds.
pub fn tc_instance_has_trait(tid: Int, tr: Str) -> Bool {
    tc_trait_need(tid, tr, []).len() == 0
}

// What the impls of `tr` written for `base` need of the instance `tid`, or None when no
// impl of `tr` is written for it. An impl answers where its receiver matches `tid` and its
// binder bounds and `where` bounds hold at the arguments it binds, so an unbounded
// `impl[T] Eq for H[T]` holds for every T. The bare declaration stands for an instance
// not yet chosen, which any impl answers.
fn tc_hand_impl_need(tid: Int, base: Int, tr: Str, method: Str, visiting: List[Int]) -> Option[List[Int]] {
    if !tc_type_writes_trait_method(strip_module_qualifier(tc_type_name(base)), method, tr) { return None }
    if base == tid { return Some([]) }
    let k = type_kind(tid)
    let mut failed: List[Int] = []
    let mut applies = false
    for im in tc_impl_recv_tids.keys() {
        if tc_impl_trait_id(im) != tr { continue }
        let raw = tc_impl_recv_tids.get(im) ?? -1
        if type_kind(raw) != k { continue }
        let rbase = if k == TyKind.Struct { tc_struct_base_tid(raw) } else { tc_enum_base_tid(raw) }
        if rbase != base { continue }
        let binds: Map[Str, Int] = Map()
        unify_typevar_binds(raw, tid, binds)
        if !tc_tid_same_type(tc_resolve(substitute_typevar_tid(raw, binds)), tid) { continue }
        applies = true
        let need = tc_impl_bounds_need(im, binds, visiting)
        if need.len() == 0 { return Some([]) }
        if failed.len() == 0 { failed = need }
    }
    if !applies { return Some([tid]) }
    Some(eq_need_through(tid, failed))
}

// What an impl's binder bounds and `where` bounds need of the arguments `binds` gives its
// binders: the first bound that does not hold, as tc_trait_need answers it.
fn tc_impl_bounds_need(im: Int, binds: Map[Str, Int], visiting: List[Int]) -> List[Int] {
    let binders = node_impl_binders(im)
    let mut i = 0
    while binders != -1 && i < sublist_length(binders) {
        let tp = sublist_get(binders, i)
        let need = tc_carrier_bounds_need(tp, binds.get(tc_binder_key(tp, node_name(tp))) ?? -1, visiting)
        if need.len() > 0 { return need }
        i = i + 1
    }
    let wb = node_impl_where_bounds(im)
    let mut j = 0
    while wb != -1 && j < sublist_length(wb) {
        let cons = sublist_get(wb, j)
        let need = tc_carrier_bounds_need(cons, binds.get(node_name(cons)) ?? -1, visiting)
        if need.len() > 0 { return need }
        j = j + 1
    }
    []
}

// The first of the bounds written on `carrier` (a binder or a `where` constraint) that the
// type `arg` does not have. An argument nothing binds is not judged.
fn tc_carrier_bounds_need(carrier: Int, arg: Int, visiting: List[Int]) -> List[Int] {
    let bounds = node_elements(carrier)
    if arg == -1 || bounds == -1 { return [] }
    let mut i = 0
    while i < sublist_length(bounds) {
        let need = tc_trait_need(arg, tc_bound_trait(sublist_get(bounds, i)), visiting)
        if need.len() > 0 { return need }
        i = i + 1
    }
    []
}

fn tc_eq_need(tid0: Int, visiting: List[Int]) -> List[Int] {
    let tid = resolve_alias_tid(tc_resolve(tid0))
    if tc_tid_is_no_info(tid) != 0 { return [] }
    let t = ty_pool.get(tid).unwrap()
    let k = t.kind
    if k == TyKind.Option || k == TyKind.List { return tc_eq_need_parts(tid, [t.inner1], visiting) }
    if k == TyKind.Result { return tc_eq_need_parts(tid, [t.inner1, t.inner2], visiting) }
    // A Set element is `Hash`, and `Hash` requires `Eq`, so a Set is always `Eq`.
    if k == TyKind.Set { return [] }
    // A Map key is `Hash` as well, so only the value type can lack `Eq`.
    if k == TyKind.Map { return tc_eq_need_parts(tid, [t.inner2], visiting) }
    if k == TyKind.Tuple {
        let mut elems: List[Int] = []
        let mut i = 0
        while i < t.params_count {
            elems.push(ty_param_list.get(t.params_start + i).unwrap())
            i = i + 1
        }
        return tc_eq_need_parts(tid, elems, visiting)
    }
    if k == TyKind.Enum { return tc_eq_need_enum(tid, visiting) }
    if k == TyKind.Struct { return tc_eq_need_struct(tid, visiting) }
    if k == TyKind.Typevar {
        // "" is a name that is not an active type parameter (a builtin lowered to a
        // typevar); it passes, as reject_unlicensed_comparison lets it pass.
        let traits = tc_tparam_bound_traits(type_to_str(tid))
        if traits == "" || tc_pipe_has(traits, "Eq") != 0 || tc_pipe_has(traits, "Ord") != 0 { return [] }
        return [tid]
    }
    if tc_kind_is_plain_eq(k) { return [] }
    [tid]
}

// Kinds that are `Eq` with no parts to ask about. Void, Unknown and Never carry no
// value to compare, so they pass rather than stack a second report on an earlier one.
fn tc_kind_is_plain_eq(k: TyKind) -> Bool {
    if k == TyKind.Int || k == TyKind.Bool || k == TyKind.Float || k == TyKind.Char { return true }
    if k == TyKind.Str || k == TyKind.Bytes || is_sized_int(k) != 0 { return true }
    // A Ptr compares by address (07_trust_modules_metadata.md).
    if k == TyKind.Ptr { return true }
    k == TyKind.Void || k == TyKind.Unknown || k == TyKind.Never
}

// The kinds whose `==` this check decides: the containers, and the nominal types whose
// `Eq` comes from an impl, a derive, or (for an enum) its payloads.
fn tc_kind_takes_eq_need(k: TyKind) -> Bool {
    // A Raw[Str] is a marker with no `Eq` (§3b.5): its one use is a template hole.
    if k == TyKind.Raw { return true }
    if k == TyKind.Option || k == TyKind.Result || k == TyKind.List || k == TyKind.Set { return true }
    k == TyKind.Map || k == TyKind.Tuple || k == TyKind.Enum || k == TyKind.Struct
}

fn tc_is_none_lit(node: Int) -> Bool {
    node != -1 && node_kind(node) == NodeKind.Ident && node_name(node) == "None"
}

fn tc_eq_need_help(leaf: Int, op: Str, node: Int) -> Str {
    let mut lines: List[Str] = []
    let lhs = node_left(node)
    let rhs = node_right(node)
    let other = if tc_is_none_lit(rhs) { lhs } else if tc_is_none_lit(lhs) { rhs } else { -1 }
    if other != -1 {
        let call = if op == "==" { "is_none" } else { "is_some" }
        if node_kind(other) == NodeKind.Ident {
            lines.push("to test for `None`, write `{node_name(other)}.{call}()`")
        } else {
            lines.push("to test for `None`, call `.{call}()`")
        }
    }
    for line in tc_eq_need_fixes(leaf) { lines.push(line) }
    lines.join("\n")
}

// The fix for the innermost type with no `Eq`, the same for `==` and for assert_eq.
fn tc_eq_need_fixes(leaf: Int) -> List[Str] {
    tc_trait_need_fixes(leaf, "Eq")
}

// The fix for the innermost type without `tr`. A type that already has an impl of `tr` that
// does not apply here needs one that does; a type that derives `tr` already lacks it only
// through an argument, which the chain names, so it gets no fix of its own.
fn tc_trait_need_fixes(leaf: Int, tr: Str) -> List[Str] {
    let mut lines: List[Str] = []
    let k = type_kind(leaf)
    if k == TyKind.Struct || k == TyKind.Enum {
        let base = if k == TyKind.Struct { tc_struct_base_tid(leaf) } else { tc_enum_base_tid(leaf) }
        let bname = strip_module_qualifier(tc_type_name(base))
        if tc_type_writes_trait_method(bname, tc_trait_method(tr), tr) {
            let imp = tc_core_import_in(tr, nr_current_module)
            if imp != "" { lines.push(imp) }
            lines.push("write `impl {tc_core_name_in(tr, nr_current_module)} for {type_to_str(leaf)}`")
        } else if tc_type_name_derives(bname, tr) == 0 {
            lines.push("{tc_derive_fix_imports([tr], bname)}add `@derive({tc_derive_arg_for(tr, bname)})` to `type {bname}`")
        }
    }
    if k == TyKind.Typevar {
        lines.push(tc_core_bound_fix(tr, type_to_str(leaf)))
    }
    lines
}

// The method an impl of a derivable trait records under its trait.
fn tc_trait_method(tr: Str) -> Str {
    match tr {
        "Eq" => "eq"
        "Ord" => "cmp"
        "Hash" => "hash"
        "Debug" => "debug"
        _ => ""
    }
}

// The derivable trait whose derive writes `method`, or "".
fn tc_derived_method_trait(method: Str) -> Str {
    match method {
        "eq" => "Eq"
        "cmp" => "Ord"
        "hash" => "Hash"
        "debug" => "Debug"
        _ => ""
    }
}

// A derived method called by name is the derive at this instance, so it holds only where the
// derive does, as `==` holds only there.
fn tc_refuse_derived_method_at(recv: Int, method: Str, node: Int) ! Diag.Report {
    let tr = tc_derived_method_trait(method)
    if tr == "" { return }
    let path = tc_trait_need(recv, tr, [])
    if path.len() == 0 { return }
    tc_report_trait_need(path, tr, node)
}

fn tc_report_trait_need(path: List[Int], tr: Str, node: Int) ! Diag.Report {
    diag_error_at_notes("TypeError", TYPE_ERROR, "`{type_to_str(path.get(0).unwrap())}` does not implement `{tc_core_trait_shown(tr)}`", node,
        tc_trait_need_fixes(path.get(path.len() - 1).unwrap(), tr).join("\n"), tc_trait_need_notes(path, tr))
}

// Each step of the chain from the compared type to the innermost type with no `Eq`.
fn tc_eq_need_notes(path: List[Int]) -> List[Str] {
    tc_trait_need_notes(path, "Eq")
}

fn tc_trait_need_notes(path: List[Int], tr: Str) -> List[Str] {
    let mut notes = tc_shadowed_trait_notes(tr)
    let mut i = 0
    while i + 1 < path.len() {
        notes.push(tc_trait_need_step(path.get(i).unwrap(), path.get(i + 1).unwrap(), tr))
        i = i + 1
    }
    notes
}

fn tc_trait_need_step(outer: Int, inner: Int, tr: Str) -> Str {
    "`{type_to_str(outer)}` is `{tr}` only if `{type_to_str(inner)}` is `{tr}`"
}

// `==` and `!=` need `Eq` on the operand type, recursively. Returns 1 when it reported,
// so the caller does not stack an "incompatible types" error on the same comparison.
// Operands of different shapes are left to the caller's own type match.
fn reject_eq_less_operands(op: Str, lt: Int, rt: Int, node: Int) -> Int ! TypeCheck.Report, Diag.Report {
    let a = resolve_alias_tid(tc_resolve(lt))
    let b = resolve_alias_tid(tc_resolve(rt))
    let k = type_kind(a)
    if k != type_kind(b) || !tc_kind_takes_eq_need(k) { return 0 }
    if k == TyKind.Enum && tc_enum_base_tid(a) != tc_enum_base_tid(b) { return 0 }
    if k == TyKind.Struct && tc_struct_base_tid(a) != tc_struct_base_tid(b) { return 0 }
    if types_compatible(a, b) == 0 { return 0 }
    // A bare `None` operand types as `Option` over an unknown, which asks nothing, so
    // the other side is asked too.
    let mut path = tc_eq_need(a, [])
    if path.len() == 0 { path = tc_eq_need(b, []) }
    if path.len() > 0 {
        diag_error_at_notes("TypeError", TYPE_ERROR, "`{type_to_str(path.get(0).unwrap())}` does not implement `{tc_core_trait_shown("Eq")}`", node,
            tc_eq_need_help(path.get(path.len() - 1).unwrap(), op, node), tc_eq_need_notes(path))
        return 1
    }
    0
}

// `<`, `>`, `<=` and `>=` on two values of one struct need `Ord` on it, read at the instance
// as `==` reads `Eq`. Returns 1 when it reported. An enum compares by its tag, and other
// operand kinds are left to the caller's own match.
fn reject_ord_less_operands(lt: Int, rt: Int, node: Int) -> Int ! TypeCheck.Report, Diag.Report {
    let a = resolve_alias_tid(tc_resolve(lt))
    let b = resolve_alias_tid(tc_resolve(rt))
    if type_kind(a) != TyKind.Struct || type_kind(b) != TyKind.Struct { return 0 }
    if tc_struct_base_tid(a) != tc_struct_base_tid(b) || types_compatible(a, b) == 0 { return 0 }
    let path = tc_ord_need(a, [])
    if path.len() == 0 { return 0 }
    tc_report_trait_need(path, "Ord", node)
    1
}

// assert_eq and assert_ne carry a `T: Eq` bound, checked the way `==` is checked, so a
// type `==` refuses is refused here as an unmet bound (02_syntax.md, test assertions).
// A type parameter is asked here as well: `==` asks it in reject_unlicensed_comparison,
// which an assertion does not reach. Arguments of different types are left to the
// argument check.
fn reject_eq_less_assert_args(lt: Int, rt: Int, node: Int) ! TypeCheck.Report, Diag.Report {
    let a = resolve_alias_tid(tc_resolve(lt))
    let b = resolve_alias_tid(tc_resolve(rt))
    let k = type_kind(a)
    if k != type_kind(b) { return }
    if !tc_kind_takes_eq_need(k) && k != TyKind.Typevar { return }
    if types_compatible(a, b) == 0 { return }
    let mut path = tc_eq_need(a, [])
    if path.len() == 0 { path = tc_eq_need(b, []) }
    if path.len() == 0 { return }
    diag_error_at_notes("TraitBoundNotSatisfied", TRAIT_BOUND_NOT_SATISFIED,
        "`{type_to_str(path.get(0).unwrap())}` does not implement `{tc_core_trait_shown("Eq")}`", node,
        tc_eq_need_fixes(path.get(path.len() - 1).unwrap()).join("\n"), tc_eq_need_notes(path))
}

fn tc_tuple_elem_tids(tid: Int) -> List[Int] {
    let t = ty_pool.get(tid).unwrap()
    let mut elems: List[Int] = []
    let mut i = 0
    while i < t.params_count {
        elems.push(ty_param_list.get(t.params_start + i).unwrap())
        i = i + 1
    }
    elems
}

// What `sort` needs of its element: `T: Ord` (03_types.md, *The `ListOps` Trait*). The
// answer runs from the element to the innermost type with no `Ord`, and is empty when the
// element is `Ord`. A tuple is `Ord` when every element is (*Tuples*), and a fieldless enum
// is `Ord` by its declaration (*Enum Ord*). A struct or enum is read at the instance, as
// tc_eq_need reads it for `Eq`. An element nothing has chosen yet is not refused, for the
// reason tc_list_scan_elem_need gives.
fn tc_ord_need(tid0: Int, visiting: List[Int]) -> List[Int] {
    let tid = resolve_alias_tid(tc_resolve(tid0))
    if tc_tid_is_no_info(tid) != 0 || tc_tid_has_unbound_metavar(tid) != 0 { return [] }
    let k = type_kind(tid)
    if tc_scalar_has_ord(k) || k == TyKind.Never || k == TyKind.Void || k == TyKind.Unknown { return [] }
    if k == TyKind.Tuple {
        for e in tc_tuple_elem_tids(tid) {
            let need = tc_ord_need(e, visiting)
            if need.len() > 0 { return eq_need_through(tid, need) }
        }
        return []
    }
    if k == TyKind.Struct {
        let base = tc_struct_base_tid(tid)
        match tc_hand_impl_need(tid, base, "Ord", "cmp", visiting) {
            Some(need) => { return need }
            None => {}
        }
        if tc_type_name_derives(strip_module_qualifier(tc_type_name(base)), "Ord") == 0 { return [tid] }
        return tc_struct_need_fields(tid, base, "Ord", visiting)
    }
    if k == TyKind.Enum {
        let base = tc_enum_base_tid(tid)
        match tc_hand_impl_need(tid, base, "Ord", "cmp", visiting) {
            Some(need) => { return need }
            None => {}
        }
        if !tc_enum_has_payload(base) { return [] }
        if tc_type_name_derives(strip_module_qualifier(tc_type_name(base)), "Ord") == 0 { return [tid] }
        if base == tid || tc_need_visited(visiting, tid) { return [] }
        let inner = tc_need_visiting(visiting, tid)
        for vslot in tc_enum_variant_slots(base) {
            for fslot in tc_evar_field_slots(vslot) {
                let need = tc_ord_need(tc_member_tid_at_instance(tc_evfield_tid(fslot), tid), inner)
                if need.len() > 0 { return eq_need_through(tid, need) }
            }
        }
        return []
    }
    if k == TyKind.Typevar {
        // "" is a name that is not an active type parameter; it passes, as in tc_eq_need.
        let traits = tc_tparam_bound_traits(type_to_str(tid))
        if traits == "" || tc_pipe_has(traits, "Ord") != 0 { return [] }
        return [tid]
    }
    [tid]
}

// An `Ord` element whose `cmp` the compiler cannot build yet, or -1. The spec gives a tuple
// of `Ord` elements and a fieldless enum with no derive an order, and neither has a `cmp`
// to call.
fn tc_ord_not_lowered(tid0: Int) -> Int {
    let tid = resolve_alias_tid(tc_resolve(tid0))
    if tc_tid_is_no_info(tid) != 0 { return -1 }
    let k = type_kind(tid)
    if k == TyKind.Tuple { return tid }
    if k == TyKind.Enum {
        let base = tc_enum_base_tid(tid)
        if tc_type_has_ord_impl(strip_module_qualifier(tc_type_name(base))) == 0 { return tid }
    }
    -1
}

// The part of `tid` a comparator can order by, spelled as a field access (`.name`, `.0`),
// or "" when no part of it is `Ord`.
fn tc_ord_example_part(tid0: Int) -> Str {
    let tid = resolve_alias_tid(tc_resolve(tid0))
    if tc_tid_is_no_info(tid) != 0 { return "" }
    let k = type_kind(tid)
    if k == TyKind.Tuple {
        let mut i = 0
        for e in tc_tuple_elem_tids(tid) {
            if tc_ord_need(e, []).len() == 0 && tc_ord_not_lowered(e) == -1 { return ".{i}" }
            i = i + 1
        }
    }
    if k == TyKind.Struct {
        for slot in tc_struct_field_slots(tid) {
            let ft = tc_member_tid_at_instance(tc_sfield_tid(slot), tid)
            if tc_ord_need(ft, []).len() == 0 && tc_ord_not_lowered(ft) == -1 { return ".{tc_sfield_name(slot)}" }
        }
    }
    ""
}

// The `sort_by` call that orders `recv` by one of its element's parts, or "".
fn tc_sort_by_example(recv: Int, elem: Int) -> Str ! Diag.Report {
    let part = tc_ord_example_part(elem)
    if part == "" { return "" }
    "`{unparse_expr(recv)}.sort_by(fn(a, b) \{ a{part}.cmp(b{part}) })`"
}

// The fix for an element with no `Ord`, or for one whose order is not built yet, ending in
// a comparator the caller can pass to `sort_by` in place of the bound.
fn tc_sort_fix(lead: Str, recv: Int, elem: Int) -> Str ! Diag.Report {
    let example = tc_sort_by_example(recv, elem)
    if example != "" { return "{lead}, or sort with a comparator: {example}" }
    "{lead}, or pass a comparator that returns `Ordering` to `{unparse_expr(recv)}.sort_by`"
}

// `sort` needs `T: Ord` on the list's element. Refuses an element with no `Ord` as an unmet
// bound, naming the innermost type without it, and an element whose order the compiler
// cannot build yet as a TypeError that says so. Returns 1 when it reported.
fn tc_refuse_unordered_sort(node: Int, recv: Int, elem: Int) -> Int ! TypeCheck.Report, Diag.Report {
    let path = tc_ord_need(elem, [])
    if path.len() > 0 {
        let leaf = path.get(path.len() - 1).unwrap()
        let lk = type_kind(leaf)
        let lead = if lk == TyKind.Struct {
            "implement `Ord` for `{strip_module_qualifier(tc_type_name(tc_struct_base_tid(leaf)))}`"
        } else if lk == TyKind.Enum {
            "implement `Ord` for `{strip_module_qualifier(tc_type_name(tc_enum_base_tid(leaf)))}`"
        } else if lk == TyKind.Typevar {
            "add the bound `[{type_to_str(leaf)}: Ord]`"
        } else {
            "`{type_to_str(leaf)}` has no order"
        }
        let mut notes: List[Str] = []
        let mut i = 0
        while i + 1 < path.len() {
            let outer = path.get(i).unwrap()
            let inner = path.get(i + 1).unwrap()
            if type_kind(outer) == TyKind.Tuple {
                let elems = tc_tuple_elem_tids(outer)
                let mut idx = 0
                while idx < elems.len() && elems.get(idx).unwrap() != inner { idx = idx + 1 }
                notes.push("`{type_to_str(inner)}` does not implement `Ord` (element .{idx} of tuple)")
            } else {
                notes.push(tc_trait_need_step(outer, inner, "Ord"))
            }
            i = i + 1
        }
        diag_error_at_notes("TraitBoundNotSatisfied", TRAIT_BOUND_NOT_SATISFIED,
            "`{type_to_str(path.get(0).unwrap())}` does not implement `Ord`", node, tc_sort_fix(lead, recv, elem), notes)
        return 1
    }
    let unbuilt = tc_ord_not_lowered(elem)
    if unbuilt == -1 { return 0 }
    if type_kind(unbuilt) == TyKind.Tuple {
        tc_error_at_code("`sort` on `{type_to_str(elem)}` is not built yet: the compiler cannot order a tuple", node, "TypeError", TYPE_ERROR,
            tc_sort_fix("sort by one element instead", recv, elem))
    } else {
        let ename = strip_module_qualifier(tc_type_name(tc_enum_base_tid(unbuilt)))
        tc_error_at_code("`sort` on `{type_to_str(elem)}` is not built yet: the compiler cannot order a fieldless enum with no `@derive(Ord)`", node, "TypeError", TYPE_ERROR,
            "{tc_derive_fix_imports(["Ord"], ename)}add `@derive({tc_derive_arg_for("Ord", ename)})` to `type {ename}`, which gives it the same declaration order")
    }
    1
}

// The spec enum-vs-Int comparison exception (03_types.md:1093). An
// enum value stays comparable to an Int (shared tag representation), in EITHER
// operand order. This is what keeps the compiler's own `node_kind(x) ==
// NodeKind.Y` comparisons legal after operand type-checking lands.
fn cmp_is_enum_int_pair(lt: Int, rt: Int) -> Int {
    let lk = type_kind(lt)
    let rk = type_kind(rt)
    // Int side may be plain Int OR a sized int; the enum side is TyKind.Enum.
    let l_int = lk == TyKind.Int || is_sized_int(lk) != 0
    let r_int = rk == TyKind.Int || is_sized_int(rk) != 0
    if lk == TyKind.Enum && r_int != 0 { return 1 }
    if rk == TyKind.Enum && l_int != 0 { return 1 }
    0
}

// Are `lt`/`rt` valid comparison operands? `relational` distinguishes
// `<`/`>`/`<=`/`>=` (needs Ord) from `==`/`!=` (needs Eq). Callers handle the
// enum-vs-Int exception and int-literal coercion BEFORE calling this.
fn cmp_operands_ok(lt: Int, rt: Int, relational: Int) -> Int {
    let a = resolve_alias_tid(lt)
    let b = resolve_alias_tid(rt)
    let ka = type_kind(a)
    let kb = type_kind(b)

    // Fail-open on types we cannot model here, mirroring types_compatible:
    //   - TyKind.Typevar: a type-parameter operand's Ord/Eq licensing is decided at
    //     the definition by reject_unlicensed_comparison (the caller runs it first),
    //     so returning 1 here avoids a redundant "incompatible types" report on top of
    //     the missing-bound diagnostic; a licensed `[T: Ord]` compare is genuinely ok.
    //   - TyKind.Void: an under-inferred value (e.g. an un-annotated closure return
    //     flowing through Bytes.with_ptr) types as Void; rejecting it would
    //     break programs that compiled before operand checking landed.
    //   - An unbound metavar: compatible pending its binding, as in types_compatible. A
    //     statement whose value read one before a walk bound it infers the value again
    //     (tc_value_awaits_closure_ret), and the compare is judged then.
    if ka == TyKind.Typevar || kb == TyKind.Typevar { return 1 }
    if ka == TyKind.Void || kb == TyKind.Void { return 1 }
    if ka == TyKind.Unknown || kb == TyKind.Unknown { return 1 }

    // Int and Bool are interchangeable (C-style truthiness, mirroring
    // types_compatible:5132). `flag == 0`, `set.contains(x) != 0`, and
    // `true == false` are all pervasive Blink idioms. Bool participates only in
    // equality — it has Eq but not Ord (spec §3.6) — so relational against a Bool
    // operand falls through to the reject path below.
    let a_intbool = ka == TyKind.Int || ka == TyKind.Bool
    let b_intbool = kb == TyKind.Int || kb == TyKind.Bool
    if a_intbool != 0 && b_intbool != 0 {
        if relational != 0 && (ka == TyKind.Bool || kb == TyKind.Bool) { return 0 }
        return 1
    }

    // Scalars: same kind only (no implicit promotion), mirroring types_compatible.
    // Int<->sized-int literal coercion is handled by the caller. Float/Char and
    // sized ints compare within their own kind.
    let a_scalar = is_sized_int(ka) != 0 || ka == TyKind.Float || ka == TyKind.Char
    let b_scalar = is_sized_int(kb) != 0 || kb == TyKind.Float || kb == TyKind.Char
    if a_scalar != 0 && b_scalar != 0 {
        if ka == kb { return 1 }
        return 0
    }

    // Str: full Eq + Ord.
    if ka == TyKind.Str && kb == TyKind.Str { return 1 }

    // Option and Result have no Ord. Whether their parts have Eq is decided by
    // reject_eq_less_operands, which the caller runs first.
    if (ka == TyKind.Option && kb == TyKind.Option) || (ka == TyKind.Result && kb == TyKind.Result) {
        if relational != 0 { return 0 }
        return types_compatible(a, b)
    }

    // A List, Set, Map or tuple is Eq by its parts, which reject_eq_less_operands has
    // already asked. Ordering one is not lowered, so it stays refused.
    let a_container = ka == TyKind.List || ka == TyKind.Set || ka == TyKind.Map || ka == TyKind.Tuple
    if a_container && ka == kb {
        if relational != 0 { return 0 }
        return types_compatible(a, b)
    }

    // Same-enum comparison is intrinsic: an enum lowers to an integer tag, so
    // ==/!=/<… on two values of the SAME enum compares tags directly. This has
    // always been legal in Blink (no @derive required) and is what the bulk of
    // the compiler's own enum comparisons rely on. @derive(Eq/Ord) on an enum
    // only customizes semantics; it is not a precondition for comparing.
    if ka == TyKind.Enum && kb == TyKind.Enum {
        let an = tc_type_name(a)
        let bn = tc_type_name(b)
        if an == "" || an != bn { return 0 }
        return 1
    }

    // Bytes is a kind, not a declaration, so no derive or impl can give it a
    // trait. It implements Eq but not Ord (03_types.md:659).
    if ka == TyKind.Bytes && kb == TyKind.Bytes {
        if relational != 0 { return 0 }
        return 1
    }

    // User struct: must be the SAME nominal type and carry the right impl
    // (equality needs Eq, relational needs Ord) — structs have no intrinsic
    // comparison, so a bare struct compare is the genuine error case.
    if ka == TyKind.Struct && kb == TyKind.Struct {
        let an = tc_type_name(a)
        let bn = tc_type_name(b)
        if an != bn || an == "" { return 0 }
        let tr = if relational != 0 { "Ord" } else { "Eq" }
        if tc_trait_need(a, tr, []).len() == 0 { return 1 }
        return 0
    }

    0
}

// The width of an integer type in bits. The lowering seam reads it to bound a shift: C
// leaves a shift by the width or more undefined, and the bound belongs to the left operand.
pub fn type_bit_width(tid: Int) -> Int {
    let k = type_kind(tid)
    if k == TyKind.I8 || k == TyKind.U8 { return 8 }
    if k == TyKind.I16 || k == TyKind.U16 { return 16 }
    if k == TyKind.I32 || k == TyKind.U32 { return 32 }
    64
}

// A Bool operand of `&` or `|` is most often a logical operator spelled the C bitwise way. The
// help says that the logical one short-circuits, since a right operand with effects then may
// not run. A Float has no bitwise operators (sections/03_types.md §3.2.3); its bit pattern is
// an integer, reached through `to_bits()`.
fn bitwise_operand_help(op: Str, operand_tid: Int) -> Str {
    if type_kind(operand_tid) == TyKind.Float { return "a bitwise operator works on an integer; call `to_bits()` for the Float's U64 bit pattern and `Float.from_bits` to go back" }
    if type_kind(operand_tid) != TyKind.Bool { return "" }
    if op == "&" { return "for a logical and of two Bool values write `&&`, which skips the right operand when the left is false" }
    if op == "|" { return "for a logical or of two Bool values write `||`, which skips the right operand when the left is true" }
    ""
}

// A bare variant name on either side of a comparison takes the other operand as its expected
// type (`a.cmp(b) == Greater`). The enclosing expectation is a Bool and names nothing about
// either operand. A bare variant name on the left is typed after the right, the only thing
// that can hint it.
@allow(UnrestoredMutation)
fn tc_infer_comparison(node: Int, op: Str) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let saved_hint = tc_construct_hint
    tc_construct_hint = -1
    let left_first = !tc_names_bare_variant(node_left(node))
    let mut lt = -1
    if left_first { lt = infer_type(node_left(node)) }
    if left_first && tc_names_bare_variant(node_right(node)) && tc_tid_is_no_info(lt) == 0 { tc_construct_hint = resolve_alias_tid(lt) }
    let rt = infer_type(node_right(node))
    tc_construct_hint = -1
    if !left_first {
        if tc_tid_is_no_info(rt) == 0 { tc_construct_hint = resolve_alias_tid(rt) }
        lt = infer_type(node_left(node))
    }
    tc_construct_hint = saved_hint
    // A comparison on a type-parameter operand is licensed only by that
    // parameter's declared bounds (Ord/Eq): `Self` in a trait default body by
    // the guarantee set (E0305), any other type parameter by its `[T: Ord]` /
    // `[T: Eq]` bound (E0300). Report on the left operand; on the right only
    // when the left is not itself the same `Self`, so `self < other` reports once.
    reject_unlicensed_comparison(op, lt, node)
    if type_kind(resolve_alias_tid(lt)) != TyKind.Typevar || type_to_str(lt) != "Self" {
        reject_unlicensed_comparison(op, rt, node)
    }
    // Comparison operators desugar to Eq.eq / Ord.cmp and require
    // same-type operands (spec 03_types.md:1809). Validate when both sides
    // are known, preserving the enum-vs-Int representation exception
    // (03_types.md:1093). An int literal beside an integer operand takes that operand's type
    // first, so `x == 1` holds for any integer `x`.
    if tc_tid_is_no_info(lt) == 0 && tc_tid_is_no_info(rt) == 0 {
        if cmp_is_enum_int_pair(lt, rt) == 0 {
            if tc_operand_literal_type(node, lt, rt) < 0 {
                let relational = if op == "==" || op == "!=" { 0 } else { 1 }
                let refused = if relational == 0 { reject_eq_less_operands(op, lt, rt, node) } else { reject_ord_less_operands(lt, rt, node) }
                if refused == 0 && cmp_operands_ok(lt, rt, relational) == 0 {
                    // Operands that pass as an equality pair fail only for want of Ord.
                    // Name the side without it: `1 < true` lacks Ord on the Bool.
                    if relational != 0 && cmp_operands_ok(lt, rt, 0) != 0 {
                        let unordered = if cmp_operands_ok(lt, lt, 1) != 0 { rt } else { lt }
                        tc_error_at("binary `{op}` needs Ord, and {type_to_str(unordered)} does not implement Ord", node)
                    } else {
                        let cmp_msg = "binary `{op}`: incompatible types {type_to_str(lt)} and {type_to_str(rt)}"
                        if tc_is_read_line_value(node_right(node)) {
                            tc_value_mismatch_at(cmp_msg, node, node_right(node), lt)
                        } else {
                            tc_value_mismatch_at(cmp_msg, node, node_left(node), rt)
                        }
                    }
                }
            }
        }
        if tc_has_written_negative_zero(node_left(node), node_right(node)) && tc_is_float_comparison(lt) && tc_is_float_comparison(rt) {
            tc_warn_negative_zero_pair(node_left(node), node_right(node), tc_negative_zero_family(op))
        }
    }
    return TYPE_BOOL
}

// W0706 (sections/03_types.md §3.6) fires only where the comparison resolves to the Float
// impl. A type parameter is not Float here, so a generic body never warns, whatever it is
// instantiated with. F32 joins by its kind when it exists.
fn tc_is_float_comparison(tid: Int) -> Bool {
    tid >= 0 && type_kind(resolve_alias_tid(tid)) == TyKind.Float
}

// What a comparison family gives for 0.0 and -0.0: the label and the help differ by it.
type NegativeZeroFamily {
    TrueForBoth
    FalseForBoth
    SameForBoth
}

fn tc_negative_zero_family(op: Str) -> NegativeZeroFamily {
    if op == "==" { return NegativeZeroFamily.TrueForBoth }
    if op == "!=" { return NegativeZeroFamily.FalseForBoth }
    NegativeZeroFamily.SameForBoth
}

// A written negative zero: one unary `-` over a float literal with the value zero. The parser
// keeps no node for parentheses, so `(-0.0)`, `-(0.0)` and `((-((0.0))))` reach here as this
// one shape, and `-(-0.0)` is a `-` over a `-`, which does not match. A const or a let that
// holds -0.0 is an Ident, so it does not match either: the check reads the code as written.
fn tc_is_written_negative_zero(n: Int) -> Bool {
    if n == -1 || node_kind(n) != NodeKind.UnaryOp || node_op(n) != "-" { return false }
    let lit = node_left(n)
    lit != -1 && node_kind(lit) == NodeKind.FloatLit && tc_float_lit_is_zero(node_str_val(lit))
}

// Read before any operand type: the syntax test is cheap, and almost no comparison passes it.
fn tc_has_written_negative_zero(a: Int, b: Int) -> Bool {
    tc_is_written_negative_zero(a) || tc_is_written_negative_zero(b)
}

// Whether a float literal's text has the value zero: no digit in it is 1-9.
fn tc_float_lit_is_zero(text: Str) -> Bool {
    let mut i = 0
    while i < text.byte_len() {
        let c = text.byte_at(i)
        if c >= 49 && c <= 57 { return false }
        i = i + 1
    }
    true
}

fn tc_warn_negative_zero_pair(a: Int, b: Int, family: NegativeZeroFamily) ! Diag.Report {
    tc_warn_negative_zero_operand(a, b, family)
    tc_warn_negative_zero_operand(b, a, family)
}

// W0706 on `n` when it is a written negative zero compared with `other`. The caret ends at
// the literal: with no paren node, the closing parens of `-(0.0)` have no column to end on.
// A span holds one line, so a literal on a later line than its `-` leaves the caret on the `-`.
// No machine fix: only the author knows whether the code means the sign, negative zero or zero.
fn tc_warn_negative_zero_operand(n: Int, other: Int, family: NegativeZeroFamily) ! Diag.Report {
    if !tc_is_written_negative_zero(n) { return }
    let lit = node_left(n)
    let end_col = if node_line(lit) == node_line(n) { node_col(lit) + node_str_val(lit).byte_len() } else { node_col(n) + 1 }
    let label = match family {
        TrueForBoth => "this comparison is true for 0.0 and -0.0"
        FalseForBoth => "this comparison is false for 0.0 and -0.0"
        SameForBoth => "this comparison gives the same result for 0.0 and -0.0"
    }
    diag_warn_span_label_at_notes("NegativeZeroComparison", NEGATIVE_ZERO_COMPARISON, "`-0.0` compares the same as `0.0`", n, end_col, label, tc_negative_zero_help(other, family), ["to test for zero, write `0.0`; it means the same and does not warn"])
}

// The help names the other operand when it is a simple path. Any other operand is bound with
// `let` first, so the help never writes a call twice.
fn tc_negative_zero_help(other: Int, family: NegativeZeroFamily) -> Str ! Diag.Report {
    let path = if other != -1 && tc_index_receiver_is_path(other) { unparse_expr(other) } else { "" }
    let v = if path != "" { path } else { "v" }
    let zero_test = if family == NegativeZeroFamily.FalseForBoth {
        "to test that it is not negative zero, use `{v} != 0.0 || !{v}.is_sign_negative()`"
    } else {
        "to test for negative zero, use `{v} == 0.0 && {v}.is_sign_negative()`"
    }
    let tests = "to test the sign, use `{v}.is_sign_negative()`\n{zero_test}"
    if path != "" { return tests }
    let text = tc_index_text(other)
    let bind = if text != "" { "bind the other operand first: `let v = {text}`" } else { "bind the other operand first: `let v = ...`" }
    "{bind}\n{tests}"
}

// The caller has just checked the argument, so its type is read from the memo: inferring it
// again would walk each nested call's argument twice per level.
fn tc_warn_negative_zero_method(obj_t: Int, recv_node: Int, args_sl: Int, family: NegativeZeroFamily) ! Diag.Report {
    let arg = tc_arg_value_at(args_sl, 0)
    if arg == -1 || !tc_has_written_negative_zero(recv_node, arg) { return }
    if !tc_is_float_comparison(obj_t) || !tc_is_float_comparison(tc_lookup_node_tid(arg)) { return }
    tc_warn_negative_zero_pair(recv_node, arg, family)
}

// A labelled argument compares its value, so the label is looked through.
fn tc_arg_value_at(args_sl: Int, i: Int) -> Int {
    if args_sl == -1 || sublist_length(args_sl) <= i { return -1 }
    let a = sublist_get(args_sl, i)
    if node_kind(a) == NodeKind.NamedArg { node_value(a) } else { a }
}

// Whether `n` is a bare variant name (`Pending`, `Running(1)`) that no binding hides, or a
// qualified carrier variant (`Option.None`, `Result.Ok(1)`): a carrier names no slot its
// variant does not carry, so it reads the rest from the expected type as the bare one does.
// `Type.from(x)` or `Type.try_from(x)` on a name no local shadows.
fn tc_names_static_conversion(n: Int) -> Bool {
    if n == -1 || node_kind(n) != NodeKind.MethodCall { return false }
    let obj = node_obj(n)
    if obj == -1 || node_kind(obj) != NodeKind.Ident || nr_top_index(node_name(obj)) != -1 { return false }
    let args = node_args(n)
    tc_conversion_trait_of(node_method(n)) != "" && args != -1 && sublist_length(args) == 1
}

fn tc_names_bare_variant(n: Int) -> Bool {
    if n == -1 { return false }
    let k = node_kind(n)
    if k == NodeKind.FieldAccess || k == NodeKind.MethodCall {
        let obj = node_obj(n)
        if obj == -1 || node_kind(obj) != NodeKind.Ident || nr_top_index(node_name(obj)) != -1 { return false }
        let variant = if k == NodeKind.FieldAccess { node_name(n) } else { node_method(n) }
        return tc_qualified_carrier(node_name(obj), variant).is_some()
    }
    let mut name = ""
    if k == NodeKind.Ident { name = node_name(n) }
    if k == NodeKind.Call && node_left(n) != -1 && node_kind(node_left(n)) == NodeKind.Ident { name = node_name(node_left(n)) }
    name != "" && nr_top_index(name) == -1 && is_variant_name(name) != 0
}

fn is_comparison_op(op: Str) -> Int {
    if op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=" { return 1 }
    0
}

// ── Phase 2: Expression type inference ──────────────────────────────

// Infer a carrier argument (Some/Ok/Err) with the construction hint unwrapped to the carried
// inner type, so a bare struct-style variant inside the carrier resolves against the right enum.
// Mirrors the pattern-path carrier unwrap. carrier is "Some" | "Ok" | "Err".
// The slot a one-sided carrier constructor does not name. `Ok(v)` says what the Ok side
// holds and nothing about the Err side; the expected type at that position does, so read it
// from there and mint a fresh metavar only when nothing names it.
//
// Minting is not free. infer_type re-runs on the same node and overwrites the node's stamp
// each time, so a metavar minted AFTER the declared type was pinned replaces a solved stamp
// with an unsolved one and reaches layout as "unbound metavariable". The hint is present at
// exactly the positions that pin (declared return, annotation, parameter, field), so taking
// the slot from it makes the first stamp the right one and re-inference idempotent.
//
// `slot` is the slot being FILLED: 1 for inner1, 2 for inner2. A hint of a different kind
// names nothing about this carrier and is ignored, so a mismatch still mints and still
// reports through the usual compare rather than baking a wrong type.
fn tc_carrier_slot_from_hint(want: TyKind, slot: Int) -> Int {
    if tc_construct_hint < 0 { return make_metavar() }
    let h = resolve_alias_tid(tc_construct_hint)
    if h < 0 || h >= ty_pool.len() { return make_metavar() }
    // An expectation that still carries an unsolved slot of its own NAMES nothing here, and
    // reading one out of it would take away the very thing a later use pins. `let mut x =
    // Ok(3)` leaves the err slot open on purpose and `x = Err("boom")` closes it; if the Err
    // side read its ok slot back out of x, the two sides would already agree and nothing would
    // drive the binding, so the slot stays open to the end and is reported as uninferable.
    if tc_tid_has_unbound_metavar(h) != 0 { return make_metavar() }
    let e = ty_pool.get(h).unwrap()
    if e.kind != want { return make_metavar() }
    let other = if slot == 1 { e.inner1 } else { e.inner2 }
    if other < 0 { return make_metavar() }
    // A callee's own parameter (`None` against `o: Option[T]`) names nothing at this site,
    // and a slot holding it can never be pinned, so the slot is minted for the call to solve.
    if tc_tid_has_foreign_typevar(other) != 0 { return make_metavar() }
    other
}

// `a ?? b` puts b in the Option's ELEMENT slot, so the element is the hint b is built under
// -- the same narrowing a list element and a carrier payload already get. Without it an empty
// `Map()` fallback minted its own key and the container's key operations are chosen from a type
// nothing ever solves. The narrowing runs BEFORE the right operand is inferred, so the first
// stamp on the constructor is the right one and a later re-inference reads the same hint instead
// of replacing a solved slot with a fresh metavariable.
//
// The unify at the end is the OTHER direction and still needed: `None ?? 99` learns its element
// from the default, and there the hint has nothing to narrow to.
// @allow: the construct hint is saved and restored around the single descent below, and the
// types that descent publishes ARE this function's effect.
@allow(UnrestoredMutation)
fn tc_infer_coalesce(node: Int, lt: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let left_k = type_kind(lt)
    if left_k != TyKind.Option && left_k != TyKind.Unknown {
        tc_error_at_code("`??` operator requires Option value, got {type_to_str(lt)}", node,
            "CoalesceRequiresOption", COALESCE_REQUIRES_OPT,
            "use `??` only on an Option; for a Result use `match` or `?`")
    }
    if left_k != TyKind.Option { return infer_type(node_right(node)) }
    let opt = tc_resolve(lt)
    let inner = ty_pool.get(opt).unwrap().inner1
    let saved_hint = tc_construct_hint
    if inner >= 0 && tc_tid_is_no_info(inner) == 0 && tc_tid_has_unbound_metavar(inner) == 0 {
        tc_seed_expected_into_value(node_right(node), inner)
        tc_construct_hint = resolve_alias_tid(inner)
    }
    let rt = infer_type(node_right(node))
    tc_construct_hint = saved_hint
    // `??` is a match on the Option whose `None` arm is the default, so the default shares the
    // value type the `Some` arm yields, and that type is the default's expected type.
    if tc_tid_has_unbound_metavar(inner) != 0 {
        if tc_unify(inner, rt) != 0 { tc_pin_declared_into_value(tc_resolve(inner), node_right(node), rt) }
    } else if tc_branch_values_agree(-1, inner, node_right(node), rt) == 0 {
        tc_error_at("`??` default type {type_to_str(rt)} does not match the Option's value type {type_to_str(inner)}", node_right(node))
    } else {
        tc_pin_declared_into_value(tc_resolve(inner), node_right(node), rt)
    }
    tc_resolve(inner)
}

// The element type an empty KEYED container takes from its context, or a fresh metavariable
// when the context names nothing this site can use. A keyed container asks more of its hint
// than a carrier does: its constructor chooses the operations its keys are compared and hashed
// by FROM the element types, so a slot naming a bare type PARAMETER answers no table here. That
// parameter belongs to a declaration this site is not an instance of -- `Holder { m: Map() }`
// reads `Map[Key, V]` off the field of `Holder[V]` -- and the later use that decides it
// (`h.m.insert(k, "one")`) can only reach it through a metavariable, because nothing in the
// metavariable machinery binds a bare typevar. So the parameter is declined and the slot is
// minted, which leaves inference owning exactly the slots the context could not name.
fn tc_container_slot_from_hint(want: TyKind, slot: Int) -> Int {
    let s = tc_carrier_slot_from_hint(want, slot)
    if tc_tid_has_bare_typevar(s) != 0 { return make_metavar() }
    s
}

// A bare Ok/Err/None argument mints an unbound metavariable for the slot it doesn't
// spell, and the signature check hints the other argument only from a concrete bind, so a
// bare first argument leaves its slot open. Unify both sides so either argument can be the
// bare literal, then ask for the `Eq` bound on the unified type. `tids` is what the
// signature check read for each argument.
fn tc_check_assert_eq_args(tids: List[Int], node: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if tids.len() < 2 { return }
    let t0 = tids.get(0).unwrap()
    let t1 = tids.get(1).unwrap()
    if t0 < 0 || t1 < 0 { return }
    if tc_tid_has_unbound_metavar(t0) != 0 { let _ = tc_unify(t0, t1) }
    if tc_tid_has_unbound_metavar(t1) != 0 { let _ = tc_unify(t1, t0) }
    reject_eq_less_assert_args(t0, t1, node)
}

fn infer_carrier_arg(arg_node: Int, carrier: Str) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let saved_hint = tc_construct_hint
    let k = type_kind(tc_construct_hint)
    if carrier == "Err" {
        if tc_construct_hint >= 0 && k == TyKind.Result { tc_construct_hint = ty_pool.get(tc_construct_hint).unwrap().inner2 }
    } else if (carrier == "Some" && k == TyKind.Option) || (carrier == "Ok" && k == TyKind.Result) {
        if tc_construct_hint >= 0 { tc_construct_hint = ty_pool.get(tc_construct_hint).unwrap().inner1 }
    }
    let inner = infer_type(arg_node)
    tc_construct_hint = saved_hint
    // Inference never picks Never for an open slot (§3.2): a diverging payload leaves the
    // slot to the hint or to a later use.
    if tc_resolve(inner) == TYPE_NEVER {
        if carrier == "Err" { return tc_carrier_slot_from_hint(TyKind.Result, 2) }
        if carrier == "Ok" { return tc_carrier_slot_from_hint(TyKind.Result, 1) }
        return tc_carrier_slot_from_hint(TyKind.Option, 1)
    }
    inner
}

// The element type of a list literal whose first element is Never: the first plain element
// that has another settled type, else the slot the position expects.
fn tc_list_elem_past_never(elems_sl: Int) -> Int ! TypeCheck.Resolve {
    let mut i = 1
    while i < sublist_length(elems_sl) {
        let elem = sublist_get(elems_sl, i)
        if node_kind(elem) != NodeKind.SpreadExpr {
            let t = tc_lookup_node_tid(elem)
            if tc_tid_is_no_info(t) == 0 && tc_resolve(t) != TYPE_NEVER { return t }
        }
        i = i + 1
    }
    tc_carrier_slot_from_hint(TyKind.List, 1)
}

// The element type one list-literal element CONTRIBUTES, which is not the same as its own
// type: a spread contributes its operand's ELEMENT (`[..a]` where `a: List[Str]` contributes
// `Str`, not `List[Str]`), while every other element contributes itself. `infer_type` has no
// `SpreadExpr` arm, so before this the ListLit arm read `TYPE_UNKNOWN` from `..a` and the whole
// literal came out `List[?]` — erased, and a `?` element is compatible with every declared
// type, so all four gates would fail open at once.
//
// The operand is still inferred on every path, spread or not, because that call is what
// memoizes the per-node tid a CALL-style generic constructor's mono recovery reads (the
// reason below).
//
// A non-List operand contributes TYPE_UNKNOWN rather than a guess: `[..7]` is a spec violation
// (§2.16), not a shape to invent an element for, and reporting it belongs with the rest of the
// spread-source check below, where the diagnostic can name the real rule.
// @allow: the construct hint is saved and restored around the single descent below, and the
// types the descent publishes ARE this function's effect.
@allow(UnrestoredMutation)
fn tc_list_elem_contribution(elem: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if node_kind(elem) != NodeKind.SpreadExpr {
        // The hint names the slot the value flows into, and an ELEMENT's slot is the element
        // type. Narrowed here rather than at the literal because a target-directed form reads
        // the hint as its own target: unnarrowed, `[x.into()]` under `List[Float]` converts to
        // List[Float] and an arena allocation sizes itself against the list. A spread is the
        // exception below — its source really is a whole list, so its slot is the hint as given.
        // A hint that is not a List names no element slot, so the element gets none.
        let saved_hint = tc_construct_hint
        let mut elem_hint = -1
        if tc_construct_hint >= 0 {
            let h = resolve_alias_tid(tc_construct_hint)
            if type_kind(h) == TyKind.List { elem_hint = tc_tid_child(h, 0) }
        }
        tc_construct_hint = elem_hint
        let t = infer_type(elem)
        tc_construct_hint = saved_hint
        return t
    }
    let src_t = tc_resolve(infer_type(node_value(elem)))
    // `tc_resolve` above is required, not defensive: tc_tid_child indexes ty_pool directly
    // and answers -1 for an unresolved metavar. A -1 child is still folded back to
    // TYPE_UNKNOWN so no caller ever sees a non-tid in a tid slot.
    if tc_tid_kind(src_t) == TyKind.List {
        let e = tc_tid_child(src_t, 0)
        if e >= 0 { return e }
    }
    TYPE_UNKNOWN
}

// §2.16's own rule: *"The spread source must be a
// `List[T]` with the same element type as the list being constructed. Type mismatches are
// compile errors"* (sections/02_syntax.md:863, panel vote 5-0). Both halves of that sentence
// must be enforced: a spread source with a mismatched element type, and a non-List spread
// source, are both compile errors, not runtime undefined behavior.
//
// The operand tid is read from the MEMO, not re-inferred: infer_type has no memo
// short-circuit (see the comment on it below), so a second call re-walks the operand and
// double-reports every diagnostic inside it. tc_list_elem_contribution already inferred
// every operand exactly once, spread or not.
//
// SCOPE, and this is a line the spec draws rather than an omission: only spread elements are
// checked. `[..a, 1]` where the *plain* element is the odd one out satisfies §2.16 — the
// spread source and the literal agree there — and §2.16 says nothing about plain elements, so
// `[1, "x"]` stays legal. General list homogeneity is a separate decision.
//
// Silence on Unknown / Typevar operands is load-bearing, not laxity: an unbound metavar here
// is what the region-boundary check reports as E0301, and reporting it twice — or
// pinning it from the literal — is the lossy direction to avoid. types_compatible is
// already permissive the same way for the element compare.
fn tc_check_spread_sources(elems_sl: Int, elem_t: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let n = sublist_length(elems_sl)
    let mut i = 0
    while i < n {
        let elem = sublist_get(elems_sl, i)
        if node_kind(elem) == NodeKind.SpreadExpr {
            let memo = tc_lookup_node_tid(node_value(elem))
            if memo >= 0 {
                let src_t = tc_resolve(memo)
                let k = tc_tid_kind(src_t)
                if k != TyKind.List {
                    if k != TyKind.Unknown && k != TyKind.Typevar {
                        tc_error_at("cannot spread {tc_type_str(src_t)} into a list literal: a spread source must be a List", elem)
                    }
                } else {
                    let contrib = tc_tid_child(src_t, 0)
                    if contrib >= 0 && elem_t >= 0 {
                        if types_compatible(contrib, elem_t) == 0 {
                            tc_error_at("list spread source has element type {tc_type_str(contrib)} but the list is built from {tc_type_str(elem_t)}", elem)
                        }
                    }
                }
            }
        }
        i = i + 1
    }
}

// `List[T]` has one element type, so the elements of a literal must agree on it: without this
// check, `[1, "a"]` reads the Str pointer back as an Int, `[2.5, 1]` segfaults, and
// `[mk_io(), mk_metrics()]` dispatches `io.println` by slot index through the Metrics vtable —
// the same cross-effect laundering possible via a typevar, reached instead through a literal.
//
// THE RULE IS check_arg_value's, NOT A NEW ONE. Element 0 governs (sections/03_types.md:311,
// `[100, 95, 87]  // List[Int]`) and every later element is checked against it exactly as `push`
// checks its argument: the int-literal escape, then the metavar unify when either side carries an
// unbound α, then types_compatible. `xs.push("a")` on a `List[Int]` was already an error; the literal
// was the one position that skipped the check.
//
// WHY THIS IS NOT THE SPEC DECISION tc_check_spread_sources DEFERRED. That comment reads
// "§2.16 says nothing about plain elements, so `[1, "x"]` stays legal. General list homogeneity is a
// separate decision." The deferral was right and the question has one sound answer, because there is
// no implicit widening anywhere in the language to build an alternative rule from — `let f: Float = 1`
// and `push(1)` onto a `List[Float]` are both rejected today. So `[2.5, 1]` cannot mean "List[Float]
// with 1 promoted"; it means the segfault. No expressible program is removed.
//
// check_arg_value ITSELF CANNOT BE CALLED HERE, and the reason is the trap this file already
// documents twice: it infers the value node, and infer_type has no memo short-circuit, so a second
// call re-walks the element and double-reports every diagnostic inside it. The contribution computed
// by the caller's loop is passed in instead.
//
// SPREAD ELEMENTS ARE SKIPPED. tc_check_spread_sources owns them and cites the spec sentence it
// enforces; reporting both would be one defect explained two different ways.
//
// UNIFY, NOT JUST COMPARE, when either side has an unbound metavar. It is what lets an element pin
// the type — `[None, Some(4)]` would otherwise be E0301, because element 0 contributes
// `Option[α]` and the constraint in element 1 is computed and thrown away. Pinning α from a
// later element is inference, not Void-defaulting: the literal determines the type.
fn tc_check_list_elem_compat(elem: Int, elem_t: Int, idx: Int, first: Int, first_t: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if node_kind(elem) == NodeKind.SpreadExpr { return }
    if tc_tid_is_no_info(first_t) != 0 || tc_tid_is_no_info(elem_t) != 0 { return }
    // Both resolutions, because the two paths in check_arg_value spell this escape differently —
    // resolve_alias_tid on the concrete side, tc_resolve on the metavar side — and a first element
    // whose type is a metavar already BOUND to a sized int needs the second one.
    if is_int_literal_node(elem) != 0 {
        if is_integer_type(resolve_alias_tid(first_t)) != 0 || is_integer_type(tc_resolve(first_t)) != 0 {
            // A first literal has the type an expected type gave every element, or the default
            // Int, which the default-Int pass reports in its own words.
            if is_int_literal_node(first) == 0 { tc_literal_takes(elem, first_t) }
            return
        }
    }
    if tc_tid_has_unbound_metavar(first_t) != 0 || tc_tid_has_unbound_metavar(elem_t) != 0 {
        if tc_unify(first_t, elem_t) == 0 {
            tc_error_at("list element {idx + 1} has type {tc_type_str(elem_t)} but the list is built from {tc_type_str(first_t)}{tc_fn_mismatch_suffix(first_t, elem_t)}", elem)
        }
        return
    }
    if types_compatible(elem_t, first_t) == 0 {
        tc_error_at("list element {idx + 1} has type {tc_type_str(elem_t)} but the list is built from {tc_type_str(first_t)}{tc_fn_mismatch_suffix(first_t, elem_t)}", elem)
    }
}

// True when `existing` is a Fn tid that REFINES the freshly-minted `fresh` Fn tid: same arity,
// and at every position `existing` is at least as concrete as `fresh`. `fresh` comes from the
// declaration alone (unannotated params UNKNOWN, an omitted arrow VOID), so a position where
// `existing` fills in an UNKNOWN param or a concrete return over the VOID default is a refinement,
// never a contradiction. A position where `fresh` already holds a concrete type that `existing`
// disagrees with means these are DIFFERENT signatures (e.g. the same closure node re-minted under
// another mono T) — not a refinement — so the answer is 0 and the fresh mint stands.
//
// `pub` FOR THE TEST ONLY — same precedent as make_fn_type: the sole live caller is infer_type's
// Closure arm, and the test pins the positional refinement rule directly.
pub fn tc_fn_tid_more_specific(existing0: Int, fresh0: Int) -> Int {
    if existing0 < 0 || fresh0 < 0 { return 0 }
    let existing = tc_resolve(existing0)
    let fresh = tc_resolve(fresh0)
    if existing < 0 || existing >= ty_pool.len() { return 0 }
    if fresh < 0 || fresh >= ty_pool.len() { return 0 }
    let ee = ty_pool.get(existing).unwrap()
    let fe = ty_pool.get(fresh).unwrap()
    if ee.kind != TyKind.Fn { return 0 }
    if fe.kind != TyKind.Fn { return 0 }
    if ee.params_count != fe.params_count { return 0 }
    let fr = tc_resolve(fe.inner1)
    let er = tc_resolve(ee.inner1)
    // The return refines only when fresh defaulted to VOID (omitted arrow) AND existing supplies
    // a real return. An existing UNKNOWN is LESS specific than a concrete VOID, so it must not win
    // — that would keep a divergence-cell UNKNOWN where the honest VOID default was available.
    if fr != er && (fr != TYPE_VOID || tc_tid_is_no_info(er) != 0) { return 0 }
    let mut i = 0
    while i < fe.params_count {
        let fp = tc_resolve(ty_param_list.get(fe.params_start + i).unwrap())
        let ep = tc_resolve(ty_param_list.get(ee.params_start + i).unwrap())
        if fp != ep && tc_tid_is_no_info(fp) == 0 { return 0 }
        i = i + 1
    }
    1
}

// §2.9: report an else-less `if` used as a value. The single emit site for E0304; the IfExpr
// arm calls it only when tc_if_value_ctx is set, so a statement-context else-less `if` (value
// discarded) is never reported.
fn tc_report_missing_else(node: Int) ! Diag.Report {
    diag_error_at("MissingElse", MISSING_ELSE, "an `if` used as a value must have an `else` — the false path produces no value (§2.9)", node, "add an `else` branch, or make the `if` a statement if you only want its effect")
}

// Infer a value in EXPRESSION context (§2.9): set tc_if_value_ctx across the walk so the IfExpr
// arm reports an else-less `if` anywhere the value is produced — flat sub-expressions and the
// block/with/async/match TAILS infer_type descends alike. Saves/restores so a value nested in a
// statement (an arg of a discarded call) is still value context, and vice versa.
@allow(UnrestoredMutation)
fn tc_infer_value(node: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let saved = tc_if_value_ctx
    tc_if_value_ctx = 1
    let t = infer_type(node)
    tc_if_value_ctx = saved
    t
}

// §2.9: the implicit tail and an explicit `return` are expression context only when the fn
// actually returns a value. tc_current_fn_ret is -1 when lookup_fnsig missed (impl methods,
// unresolved sigs); TYPE_VOID / TYPE_UNKNOWN are the non-value returns. One predicate so the
// tail gate (which also drives the declared-return compare) and the Return gate cannot drift.
fn tc_fn_returns_value() -> Bool {
    tc_current_fn_ret != TYPE_VOID && tc_tid_is_no_info(tc_current_fn_ret) == 0
}

// `pub` FOR THE TEST ONLY — same precedent as make_fn_type. Real code reaches inference through
// tc_check_body, never this entry directly; a test calls it by hand to install the
// latent re-inference producer the Closure-arm guard defends against. It MUTATES the tc_node_tid
// memo, so it must not be called from ordinary compiler code.
// Every ARGUMENT of a call must carry a type. Several arms answer a call's own type from the
// method name alone — `Char.from_code_point(-1)`, `Bytes.zeroed(4)` — and return without
// descending, which leaves the arguments both untyped and unchecked. Inferring them AFTER the
// answer keeps every hinted arm's own argument typing intact: an arm that pins a metavar from
// a hint has already written the node, and only an argument nobody claimed is inferred here.
fn tc_infer_unclaimed_args(node: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if node == -1 { return }
    let k = node_kind(node)
    // ChannelNew joins the two call kinds: `channel.new[Int](buffer: 10)` answers from its type
    // argument, and a call its argument check refused leaves the capacity untyped.
    if k != NodeKind.MethodCall && k != NodeKind.Call && k != NodeKind.ChannelNew { return }
    let a_sl = node_args(node)
    if a_sl == -1 { return }
    let mut i = 0
    while i < sublist_length(a_sl) {
        let a = sublist_get(a_sl, i)
        if a != -1 && tc_tid_is_no_info(tc_lookup_node_tid(a)) != 0 { infer_type(a) }
        i = i + 1
    }
}

// A brace literal's own type: a struct, or a struct-style variant of an enum.
fn tc_infer_struct_lit_type(node: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let sname = node_type_name(node)
    if sname != "" {
        match sname.byte_index_of(".", 0) {
            Some(dot) => {
                // A qualified struct-style variant `E.V { .. }` is named by its PREFIX —
                // 03_types.md:1040 rule 1: "if the site is already written `Enum.Variant {
                // ... }`, that names the variant directly". This must be tried BEFORE
                // lookup_named_type(sname) below, which strips the qualifier and looks up
                // the SUFFIX. That is right for the module-qualified struct literal it was
                // written for (`mod.Type { .. }`, suffix IS the type) and wrong here: the
                // suffix is the variant name, never a type (E0518 makes struct-vs-variant a
                // declaration-time error). Getting the order wrong would infer TYPE_UNKNOWN,
                // which unifies with anything — and worse, an unrelated enum that happened
                // to be NAMED like the variant would hijack the lookup and reject correct
                // code.
                //
                // Mirrors the bare global-unique variant path below exactly rather than returning the bare
                // enum tid, so a generic enum reverse-infers its instance (`Tree[Int]`);
                // the two spellings must "emit identical code" (03_types.md:1036). The decl
                // node comes from tc_type_decl_nodes keyed by the ENUM — NOT from
                // tc_variant_enum_decl_node, which is first-declared-wins per variant name
                // and would hand back the other enum's decl for a shared name, the very
                // confusion this block exists to end.
                //
                // Guarded on the prefix being a TyKind.Enum, so a module qualifier still falls
                // through untouched. A prefix enum without the named variant is NoSuchVariant
                // (§3.4); its field values are still typed so nothing under it goes untyped.
                let qual = sname.byte_slice(0, dot)
                let vname = sname.byte_slice(dot + 1, sname.byte_len())
                let qtid = lookup_named_type(qual)
                if qtid != -1 && type_kind(qtid) == TyKind.Enum && get_variant_by_name(qtid, vname) != -1 {
                    check_deprecated_type(qual, node)
                    let edecl = tc_decl_node_for_type(type_to_str(qtid))
                    tc_check_brace_literal(tc_variant_literal_owner(get_variant_by_name(qtid, vname)), node)
                    return tc_enum_structlit_instance_tid(qtid, edecl, vname, node_fields(node))
                }
                match tc_value_missing_variant(qual, vname) {
                    Some(owner) => {
                        tc_report_no_such_variant_value(node, owner, qual, vname, 2)
                        tc_infer_orphan_field_values(node_fields(node))
                        return tc_error_recovery_tid()
                    }
                    None => {}
                }
                let etid = lookup_named_type(sname)
                if etid != -1 {
                    check_deprecated_type(sname, node)
                    if tc_head_constructible_struct(etid) == 0 {
                        tc_report_unconstructible_head(etid, sname, node)
                        return tc_error_recovery_tid()
                    }
                    // `mod.Type { .. }` is the same construction as `Type { .. }` and must
                    // answer the same way — the bare spelling reverse-infers its instance and
                    // types its field values, this one returned the head and looked at nothing,
                    // so every field value under a qualified literal carried no type.
                    return tc_struct_lit_instance_tid(etid, node)
                }
            }
            None => {
                // 1) hint FIRST (monotonicity: a distant enum decl must never retroactively
                //    rebind a locally-determined site).
                let site_t = tc_bare_variant_site_type(sname, node, None)
                match tc_bare_variant_from_type(sname, None, site_t) {
                    BareVariantPick.Declared(_, hint_var_idx) => {
                        tc_check_brace_literal(tc_variant_literal_owner(hint_var_idx), node)
                        // A hint that still names an enclosing literal's own T (`b: Tree[T]`
                        // before T is settled) says nothing about the arguments, so the values
                        // settle them, as with no hint at all. Values that settle nothing keep
                        // the hint, which is right inside a generic fn.
                        let hint_t = resolve_alias_tid(site_t)
                        if tc_tid_has_bare_typevar(hint_t) != 0 {
                            let base = tc_enum_base_tid(hint_t)
                            let inst = tc_enum_structlit_instance_tid(base, evar_pool.get(hint_var_idx).unwrap().enum_decl, sname, node_fields(node))
                            if inst != base { return inst }
                            return site_t
                        }
                        // The hint answers the literal's own type without looking inside it, so the
                        // field VALUES still need typing — `QeHolder { err: NotFound { msg: "x" } }`
                        // left the inner literal's fields with nothing.
                        tc_infer_enum_structlit_field_values(hint_t, sname, node_fields(node))
                        return site_t
                    }
                    _ => {}
                }
                // 2) struct (Kind A guarantees a name is never both a struct AND a variant).
                //    User-first: a user type shadowing a builtin name (`type Char { .. }`)
                //    resolves here and stays constructible, matching how the annotation and
                //    field-access paths resolve the same name.
                let stid = lookup_named_type(sname)
                if stid != -1 {
                    check_deprecated_type(sname, node)
                    if tc_head_constructible_struct(stid) == 0 {
                        tc_report_unconstructible_head(stid, sname, node)
                        return tc_error_recovery_tid()
                    }
                    // Reverse-infer the concrete instance tid (Box[Int]) from the
                    // field values so the literal carries its specialization, not the
                    // bare generic tid. Falls back to the bare stid when no concrete
                    // bind is discoverable (all-typevar / empty collection fields).
                    return tc_struct_lit_instance_tid(stid, node)
                }
                // A builtin type used as a struct-literal head — scalar (`Int { }`) or
                // structural (`List { }`, `Map { }`, `Option { }`) — is not a product struct
                // and cannot be built with `{ ... }`. A user type of the same name was handled
                // above (user-first), so this fires only for a genuine builtin, which
                // lookup_named_type (name-map only) never finds.
                if is_primitive_type(sname) != 0 {
                    tc_report_unconstructible_head(-1, sname, node)
                    return tc_error_recovery_tid()
                }
                // 3) global-unique variant.
                match tc_bare_variant_from_program(sname, node, None) {
                    BareVariantPick.Declared(venum, var_idx) => {
                        // A generic-enum struct-style ctor (`Leaf { value: 1 }`) reverse-
                        // infers its concrete instance tid; non-generic keeps bare.
                        let vdecl = evar_pool.get(var_idx).unwrap().enum_decl
                        tc_check_brace_literal(tc_variant_literal_owner(var_idx), node)
                        return tc_enum_structlit_instance_tid(venum, vdecl, sname, node_fields(node))
                    }
                    BareVariantPick.Ambiguous(carrier, enums) => {
                        tc_report_ambiguous_construction(sname, carrier, enums, node)
                        return tc_error_recovery_tid()
                    }
                    _ => {}
                }
            }
        }
    }
    // Nothing above claimed this node, so nothing has typed it — an absence.
    return -1
}

// Each written value is held to its field's declared type, read at the literal's own instance
// (sections/02_syntax.md §2.14), so a field the literal's type parameters reach is checked at
// the arguments the literal settled on. A copy-update source must be the literal's own type
// (§2.16).
fn tc_check_lit_field_values(node: Int, lit_t: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if tc_tid_is_no_info(lit_t) != 0 { return }
    let r = resolve_alias_tid(lit_t)
    let k = type_kind(r)
    if k != TyKind.Struct && k != TyKind.Enum { return }
    let flds_sl = node_fields(node)
    if flds_sl == -1 { return }
    // A variant literal is spelled `V` or `E.V`; its last segment names the variant.
    let mut vname = ""
    let mut var_idx = -1
    if k == TyKind.Enum {
        let segs = node_type_name(node).split(".")
        vname = segs.get(segs.len() - 1) ?? ""
        var_idx = get_variant_by_name(tc_enum_base_tid(r), vname)
        if var_idx == -1 { return }
    }
    let mut fi = 0
    while fi < sublist_length(flds_sl) {
        let f = sublist_get(flds_sl, fi)
        fi = fi + 1
        let v = node_value(f)
        if v == -1 { continue }
        let got = tc_lookup_node_tid(v)
        if tc_tid_is_no_info(got) != 0 { continue }
        if node_kind(f) == NodeKind.SpreadExpr {
            // A variant literal's spread is VariantSpread, reported with the literal's labels.
            if k == TyKind.Struct && types_compatible(r, got) == 0 {
                let (ws, gs) = tc_type_pair_strs(r, got)
                tc_report_declared_mismatch("spread source of `{type_to_str(r)}`: expected {ws} but got {gs}", v, v, r, got)
            }
            continue
        }
        let fname = node_name(f)
        let declared = tc_lit_field_tid_at(var_idx, fname, r)
        if declared == -1 { continue }
        let want = resolve_alias_tid(declared)
        if tc_tid_is_no_info(want) != 0 { continue }
        // A field the literal's type parameters reach has its type only now.
        tc_literal_takes(v, want)
        if assignment_types_compatible(want, got, v) != 0 { continue }
        // A closure's own check ran before the literal's T was read, so it stands for this one
        // only when the literal has no type arguments.
        if ty_pool.get(r).unwrap().params_count == 0 && tc_closure_checked_against(v, want) { continue }
        let owner = if k == TyKind.Enum { "{type_to_str(r)}.{vname}" } else { type_to_str(r) }
        let (ws, gs) = tc_type_pair_strs(want, got)
        tc_report_declared_mismatch("field `{fname}` of `{owner}`: declared type {ws} but got {gs}{tc_fn_mismatch_suffix(want, got)}", v, v, want, got)
    }
}

pub fn infer_type(node: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    // §2.9: infer_type_uncached resets tc_if_value_ctx to 1 at entry (its consuming child
    // descents are all value positions) and only its pass-through arms restore the incoming
    // context. Save/restore here so a walk never clobbers the flag its caller set — the
    // ambient a discarded statement relies on stays 0 across statements.
    let saved_ctx = tc_if_value_ctx
    let tid = infer_type_uncached(node)
    tc_if_value_ctx = saved_ctx
    tc_infer_unclaimed_args(node)
    tc_check_type_args_claimed(node, tid)
    if node != -1 && node < tc_node_tid.len() {
        // The memo answers a TYPE or nothing, and -1 is the "nobody has typed this"
        // sentinel (TYPE_INT is 0, so -1 cannot collide with a real tid). TYPE_UNKNOWN
        // is a real, in-range pool index, so writing it would read as an ANSWER to
        // every `tid >= 0` gate downstream while meaning "inference gave up". Refusing
        // the write leaves the slot at -1, which is the same contract
        // tc_publish_node_tid states for the memo's other writer. A negative tid is
        // likewise an absence, never a type.
        //
        // An UNBOUND METAVAR is a different thing and is still stored: it is a hole a
        // later unification can pin, and the boundary check reports one that never was.
        // Only the shared give-up singleton is refused here.
        //
        // Known->known overwrites are still allowed: mono-calls-mono re-instantiates
        // one AST node under several T.
        if tc_tid_is_no_info(tid) == 0 {
            tc_node_tid.set(node, tid)
        }
    }
    tid
}

pub fn tc_lookup_node_tid(node: Int) -> Int {
    if node == -1 { return -1 }
    if node >= tc_node_tid.len() { return -1 }
    tc_node_tid.get(node).unwrap()
}

pub fn tc_mc_obj_is_value(node: Int) -> Int {
    if node == -1 { return 0 }
    if node >= tc_mc_obj_value_marks.len() { return 0 }
    tc_mc_obj_value_marks.get(node).unwrap()
}

// Rewrite each sealed ops qualified call into the method call it means: `StrOps.len(s)`
// becomes `s.len()`, so mono and codegen see one shape. The build and the check run this
// once, after typecheck and before mono (check_pipeline.bl); fmt, doc and query keep the
// program as written.
pub fn desugar_sealed_ops_calls(program: Int) ! Diag.Report {
    if tc_sealed_ops_rewrite_program != -1 {
        diag_ice_at("SealedOpsRewriteRepeated", SEALED_OPS_REWRITE_INVARIANT,
            "the sealed ops call rewrite ran a second time on one program", program,
            "each build runs the rewrite once, between typecheck and mono; a second run would take the next argument as the receiver")
        return
    }
    tc_sealed_ops_rewrite_program = program
    for n in tc_sealed_ops_calls_in_load_order() { tc_rewrite_sealed_ops_call(n) }
}

// In load order, which the ids of a recheck that kept nodes are not, so the internal errors
// of the rewrite come in a cold check's order.
fn tc_sealed_ops_calls_in_load_order() -> List[Int] {
    let mut out: List[Int] = []
    let ranges = parser_live_ranges()
    let mut r = 0
    while r + 1 < ranges.len() {
        let mut n = ranges.get(r).unwrap()
        while n < ranges.get(r + 1).unwrap() && n < tc_sealed_ops_call_marks.len() {
            if tc_sealed_ops_call_marks.get(n).unwrap() != 0 { out.push(n) }
            n = n + 1
        }
        r = r + 2
    }
    out
}

// The node keeps its id and span, so its tid stamp and every diagnostic keyed on it stay
// valid. The receiver was already typed as argument 0; the marks tell later readers that
// the object slot now holds a value, not an item name.
fn tc_rewrite_sealed_ops_call(node: Int) ! Diag.Report {
    if tc_sealed_ops_rewritten.contains_key(node) {
        diag_ice_at("SealedOpsCallRewrittenTwice", SEALED_OPS_REWRITE_INVARIANT,
            "a sealed ops call was rewritten a second time", node,
            "a second rewrite would take the next argument as the receiver")
        return
    }
    // A recorded declaration would be the trait's, and mono and codegen would read it as
    // the callee of the method call this becomes.
    if tc_call_decl_node(node) != -1 {
        diag_ice_at("SealedOpsCallHasDeclaration", SEALED_OPS_REWRITE_INVARIANT,
            "a sealed ops call has a recorded declaration", node,
            "a sealed ops trait has no source impl, so its qualified call resolves to no declaration")
        return
    }
    let recv = sublist_get(node_args(node), 0)
    node_set_obj(node, recv)
    node_set_args(node, tc_sealed_ops_call_marks.get(node).unwrap() - 1)
    tc_mc_obj_value_marks.set(node, 1)
    if node_kind(recv) == NodeKind.Ident && recv < tc_name_position_is_value.len() {
        tc_name_position_is_value.set(recv, 1)
    }
    tc_sealed_ops_rewritten.insert(node, 1)
}

// Mono reads a qualified call as a trait call, so one that reaches it unrewritten means a
// build path skipped the rewrite. Asked at mono's entry, which every build path reaches.
pub fn require_sealed_ops_rewritten(program: Int) ! Diag.Report {
    if tc_sealed_ops_rewrite_program != -1 { return }
    let calls = tc_sealed_ops_calls_in_load_order()
    if calls.len() > 0 {
        diag_ice_at("SealedOpsCallNotRewritten", SEALED_OPS_REWRITE_INVARIANT,
            "a sealed ops qualified call reached mono without the rewrite to method form", calls.get(0).unwrap(),
            "every build path runs desugar_sealed_ops_calls between typecheck and mono")
    }
}

// Publish a tid for a node that is a DECLARATION rather than an expression, so codegen can read
// it from the same memo it reads every inferred type from.
//
// `infer_type` is the only other writer, and it is only ever called on expressions. A parameter's
// type therefore never lands in the memo: it comes from its annotation through
// `resolve_param_type`, is bound into scope by name, and the node keeps `-1`. The same argument
// covers any future non-expression binder.
//
// Writes nothing for an unknown or absent type, so the memo's "-1 means nobody has typed this"
// contract holds and a caller cannot mistake a published UNKNOWN for an answer.
pub fn tc_publish_node_tid(node: Int, tid: Int) {
    if node == -1 { return }
    if node >= tc_node_tid.len() { return }
    if tc_tid_is_no_info(tid) != 0 { return }
    tc_node_tid.set(node, tid)
}

// `scope.alloc()` / `scope.alloc_n(n)` cannot spell their own pointee (see the FFIScope
// arm below), so the only thing that says what they allocate is the type expected of the
// call — a let annotation, a parameter, or a return type. Hand that back when it really is
// a pointer.
//
// Resolved, because the carrier-argument set site (infer_carrier_arg) stores a raw pool
// inner and every other reader of this channel resolves before it tests the kind.
//
// With no such expectation there is nothing to name, and DECISIONS.md *Under-determined types* (6-0) says an
// under-determined type is reported and never defaulted. Void would not be a missing pointee
// here, it would be a `sizeof(void)` allocation the checker had signed off on, so the repair
// the report asks for — annotate the slot — is the only way the size can be right.
//
// The report waits for the inference pass. The name-resolution walk runs before any
// annotation is honoured, so every allocator reads as unhinted there.
fn tc_ffi_alloc_hint_tid(node: Int) -> Int ! Diag.Report {
    if tc_construct_hint < 0 { return tc_ffi_alloc_unhinted_tid(node) }
    let hint_tid = resolve_alias_tid(tc_construct_hint)
    if type_kind(hint_tid) != TyKind.Ptr { return tc_ffi_alloc_unhinted_tid(node) }
    hint_tid
}

// `alloc_ptr()` and `null_ptr()` spell no pointee either, and the let-annotation path does
// not unify a metavar, so an annotated call would keep `Ptr[?]` in the stamp codegen sizes
// from. The expected pointer is the answer when there is one; otherwise a later argument
// or merge may still pin the metavar.
fn tc_ptr_ctor_tid() -> Int {
    if tc_construct_hint >= 0 {
        let hint_tid = resolve_alias_tid(tc_construct_hint)
        if type_kind(hint_tid) == TyKind.Ptr { return hint_tid }
    }
    make_ptr_type(make_metavar())
}

fn tc_ffi_alloc_unhinted_tid(node: Int) -> Int ! Diag.Report {
    if tc_boundary_check_active == 0 { return -1 }
    diag_error_at("CannotInferType", CANNOT_INFER_TYPE,
        "cannot infer what this allocation points at: nothing names its pointee",
        node,
        "annotate the slot it flows into, e.g. `let p: Ptr[Int] = scope.alloc()`")
    -1
}

@allow(UnrestoredMutation)
fn infer_type_uncached(node: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    // No node is an absence, not a type. Every caller reads it through tc_tid_is_no_info.
    if node == -1 { return -1 }
    let kind = node_kind(node)

    // Scope is live here and nowhere later, so the one question the total-stamp pass cannot
    // answer for itself is settled now: whether this node's callee or qualifier names a value.
    tc_record_name_position_value(node)

    // §2.9 value-context flag. `incoming` is whether THIS node is a consumed value (its else-less
    // `if` needs an `else`). Reset to 1 so every consuming child descent below — operand, element,
    // field, argument, index, scrutinee, condition — is value context by default. Only the
    // pass-through arms (block/with/async tail, if branches, match-arm bodies) restore `incoming`,
    // so a discarded statement's legal else-less `if` stays legal exactly at those tails. The
    // infer_type wrapper restores the flag on return, so this write never escapes the walk.
    let incoming = tc_if_value_ctx
    tc_if_value_ctx = 1

    if kind == NodeKind.IntLit { return tc_int_literal_type(node) }
    if kind == NodeKind.FloatLit { return TYPE_FLOAT }
    if kind == NodeKind.BoolLit { return TYPE_BOOL }
    if kind == NodeKind.CharLit { return TYPE_CHAR }
    if kind == NodeKind.InterpString {
        // Infer each embedded expression so per-expression checks (e.g. the
        // '+'-on-Str rejection) fire inside interpolations. Skip literal text
        // runs to avoid resolving them as variables.
        let parts_sl = node_elements(node)
        if parts_sl != -1 {
            let mut pi = 0
            while pi < sublist_length(parts_sl) {
                let part = sublist_get(parts_sl, pi)
                if is_interp_literal_part(part) == 0 {
                    let ptid = infer_type(part)
                    // Spec §3.6 (DECISIONS.md:191-192): every interpolated
                    // expression must be Display. No Debug fallback. Skip
                    // unresolved/generic types (helper returns 0 there, but
                    // Display is unknowable — erroring would false-reject and
                    // brick `task regen`).
                    let pk = type_kind(ptid)
                    // Never joins them for a stronger reason: §3.3 makes it a subtype of
                    // every type and it has no values, so Display holds vacuously.
                    // A `Raw[T]` implements no Display and is not meant to: it is waiting for
                    // the one coercion that consumes it, which the caller decides.
                    if pk == TyKind.Raw {
                        tc_raw_note_part(node, part)
                    } else if pk != TyKind.Unknown && pk != TyKind.Typevar && pk != TyKind.Never && tc_type_id_has_display(ptid) == 0 {
                        tc_errors.push("interpolated value of type `{type_to_str(ptid)}` does not implement Display")
                        diag_error_at("MissingDisplayImpl", MISSING_DISPLAY_IMPL, "type `{type_to_str(ptid)}` does not implement Display", part, "add `@derive(Display)` or implement Display manually; use `.debug()` for structural form")
                    }
                }
                pi = pi + 1
            }
        }
        return TYPE_STR
    }
    if kind == NodeKind.EmbedExpr { return TYPE_STR }

    // `channel.new[Str](buffer: 4)` is the spec's own constructor (sections/04_effects.md)
    // and it writes the element type down at the construction site, as an ordinary type
    // argument in `type_params`. Without this arm
    // the explicitly spelled type would be discarded and consumption seams would fall back to
    // a fabricated int element.
    if kind == NodeKind.ChannelNew {
        tc_check_channel_new_args(node)
        let cn_tps = node_type_params(node)
        if cn_tps != -1 && tc_claim_type_args(node, 1, "channel.new", "write one element type: channel.new[Int](buffer: 8)") != 0 {
            return make_channel_type(resolve_type_ann(sublist_get(cn_tps, 0)))
        }
        return make_channel_type(TYPE_UNKNOWN)
    }

    // The same shape as ChannelNew above: a construction site that writes its
    // own type down. `handler IO { ... }` parses to a HandlerExpr whose NAME is the full dotted
    // effect (parser.bl:2126), so the effect is already in hand and nothing needs resolving —
    // an effect is not a type. Without this arm the node falls to the silent TYPE_UNKNOWN tail,
    // leaving the handler value untyped even though resolve_type_parts lowers the ANNOTATION.
    if kind == NodeKind.HandlerExpr {
        let he_eff = node_name(node)
        // Empty only when the source ran out of tokens after `handler` — expect_value hands
        // back the offending token's value otherwise, so a wrong token lands in he_eff and
        // types as that handler. Either way the parser has reported; an absence here, not a
        // second diagnostic and not a crash.
        if he_eff == "" { return -1 }
        return make_handler_type(he_eff)
    }

    if kind == NodeKind.Ident {
        let name = node_name(node)
        if name == "true" || name == "false" { return TYPE_BOOL }
        let top = nr_top_index(name)
        let vt = if top != -1 { nr_scope_types.get(top).unwrap() } else { -1 }
        if tc_tid_is_no_info(vt) == 0 { return vt }
        match tc_pick_bare_variant(name, node, tc_prelude_carrier_of(name)) {
            BareVariantPick.Carrier(_) => return tc_carrier_nullary_tid(name, name, node)
            BareVariantPick.Declared(enum_tid, var_idx) => return tc_declared_variant_value_tid(enum_tid, var_idx, name, node)
            BareVariantPick.Ambiguous(carrier, enums) => {
                tc_report_ambiguous_construction(name, carrier, enums, node)
                return tc_error_recovery_tid()
            }
            BareVariantPick.NotAVariant => {}
        }
        // A named function used as a VALUE (`take_fn(m, bump)`) denotes its own signature. No
        // binding carries it — the name lives in the function table, not in a scope — so the
        // type is built from the signature here. A callee name reaches this arm too and gets
        // the same answer, which is the same type the call is checked against.
        //
        // A module-level binding of the same name wins: registering the function names defines
        // them in the same scope the globals live in, which leaves an untyped entry over a
        // global that a function shadows, and the global is the value the name reads. Its own
        // declaration is what says which value, so the answer comes from there rather than from
        // the function table — without it the name, and every method called on it, carries
        // nothing at all.
        let g_decl = tc_module_let_decl_node(nr_current_module, name)
        if g_decl != -1 {
            let g_tid = tc_lookup_node_tid(g_decl)
            if tc_tid_is_no_info(g_tid) == 0 { return g_tid }
            return -1
        }
        // A binding in an inner frame IS what the name reads, even while it carries no type yet:
        // the name-resolution walk registers a local before anything types it, and reads types as
        // it goes. Answering from the function table there types a shadowing local as the
        // function it shadows.
        if nr_index_is_local(top) { return -1 }
        let fn_sig = tc_bare_callee_sig(name)
        if fn_sig != -1 {
            let fs = fnsig_pool.get(fn_sig).unwrap()
            // A function its module declares twice (E1016) may have meant either signature.
            if tc_value_decl_poisoned(fs.decl) { return tc_error_recovery_tid() }
            let mut fn_param_types: List[Int] = []
            let mut fpi = 0
            while fpi < fs.params_count {
                fn_param_types.push(fnsig_param_list.get(fs.params_start + fpi).unwrap())
                fpi = fpi + 1
            }
            let decl_tid = make_fn_type(fs.ret, fn_param_types)
            if fs.type_params_count == 0 { return decl_tid }
            // A generic function's NAME is a value, and its binders are open at the reference:
            // `apply(identity, 3)` and `let f = identity` name the same value, and what fixes T
            // is the type expected where the name stands. Each binder becomes a metavar so the
            // expectation can solve it, because a bare typevar is invisible to every part of the
            // solving machinery and would reach codegen unsolved with nothing reported.
            let val_tid = tc_generic_fn_value_tid(fn_sig, decl_tid)
            if tc_construct_hint >= 0 {
                let want = resolve_alias_tid(tc_construct_hint)
                if type_kind(want) == TyKind.Fn { tc_unify(val_tid, want) }
            }
            return val_tid
        }
        // `with arena` names the built-in Arena effect where every other with-item names a
        // handler VALUE. It denotes a handler all the same, so it answers the type its siblings
        // answer. LAST, under every binding and every signature: the effect has no declaration
        // to lose to, so anything a program does declare under the name is the thing it means.
        if name == "arena" { return make_handler_type("Arena") }
        // An undeclared name is reported as E0506 by the name-resolution pass, so reaching here
        // means the name IS in scope with no type recorded against it — an absence.
        return -1
    }

    if kind == NodeKind.BinOp {
        let op = node_op(node)
        if is_comparison_op(op) != 0 { return tc_infer_comparison(node, op) }
        let lt = infer_type(node_left(node))
        // Answered before the shared right-operand inference below: the fallback's hint is the
        // left side's element type, and it has to be in hand the FIRST time the fallback is
        // typed, not after.
        if op == "??" { return tc_infer_coalesce(node, lt) }
        // A shift's amount is U32 (sections/03_types.md *Operator operands*).
        if op == "<<" || op == ">>" { tc_literal_takes(node_right(node), TYPE_U32) }
        let rt = infer_type(node_right(node))

        if op == "&&" || op == "||" {
            if is_bool_compat(lt) == 0 {
                tc_error_at("logical operator `{op}` requires Bool operands, got {type_to_str(lt)}", node)
            }
            if is_bool_compat(rt) == 0 {
                tc_error_at("logical operator `{op}` requires Bool operands, got {type_to_str(rt)}", node)
            }
            return TYPE_BOOL
        }
        if op == "+" && (type_kind(lt) == TyKind.Str || type_kind(rt) == TyKind.Str) {
            if tc_tid_is_no_info(lt) == 0 && tc_tid_is_no_info(rt) == 0 {
                diag_error_at("StrPlusUnsupported", STR_PLUS_UNSUPPORTED,
                    "`+` does not work on Str", node,
                    "use .concat() to join two strings, or string interpolation to embed a value")
            }
            return TYPE_STR
        }
        if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" {
            reject_non_numeric_arith_operand(op, lt, node, 0)
            // Skip the right operand only when the left is `Self` and already reported
            // it — `self + self` must not raise two identical E0305. A non-`Self` left
            // still lets the right be checked independently.
            if type_kind(resolve_alias_tid(lt)) != TyKind.Typevar || type_to_str(lt) != "Self" {
                reject_non_numeric_arith_operand(op, rt, node, 0)
            }
            let lit_t = tc_operand_literal_type(node, lt, rt)
            if lit_t >= 0 { return lit_t }
            if tc_tid_is_no_info(lt) == 0 && tc_tid_is_no_info(rt) == 0 {
                if types_compatible(lt, rt) == 0 {
                    tc_error_at("binary `{op}`: incompatible types {type_to_str(lt)} and {type_to_str(rt)}", node)
                }
            }
            if tc_tid_is_no_info(lt) == 0 { return lt }
            return rt
        }
        if op == "&" || op == "|" || op == "^" {
            if tc_tid_is_no_info(lt) == 0 && is_integer_type(lt) == 0 {
                tc_error_at_code("bitwise `{op}` requires integer operand, got {type_to_str(lt)}", node, "TypeError", TYPE_ERROR, bitwise_operand_help(op, lt))
            }
            if tc_tid_is_no_info(rt) == 0 && is_integer_type(rt) == 0 {
                tc_error_at_code("bitwise `{op}` requires integer operand, got {type_to_str(rt)}", node, "TypeError", TYPE_ERROR, bitwise_operand_help(op, rt))
            }
            let lit_t = tc_operand_literal_type(node, lt, rt)
            if lit_t >= 0 { return lit_t }
            if tc_tid_is_no_info(lt) == 0 && tc_tid_is_no_info(rt) == 0 && types_compatible(lt, rt) == 0 {
                tc_error_at("bitwise `{op}`: incompatible types {type_to_str(lt)} and {type_to_str(rt)}", node)
            }
            if tc_tid_is_no_info(lt) == 0 { return lt }
            return rt
        }
        if op == "<<" || op == ">>" {
            if tc_tid_is_no_info(lt) == 0 && is_integer_type(lt) == 0 {
                tc_error_at_code("shift `{op}` requires integer left operand, got {type_to_str(lt)}", node, "TypeError", TYPE_ERROR, bitwise_operand_help(op, lt))
            }
            let rhs = node_right(node)
            if tc_tid_is_no_info(rt) == 0 && is_shift_amount_type(rt, rhs) == 0 {
                tc_error_at("shift `{op}` amount must be U32, got {type_to_str(rt)}", node)
            }
            // An amount out of U32's range is E0318 at the literal already.
            if tc_tid_is_no_info(lt) == 0 && rhs != -1 && node_kind(rhs) == NodeKind.IntLit && tc_literal_fits(rhs, TyKind.U32) {
                let amt = node_str_val(rhs).to_int()
                let bw = type_bit_width(lt)
                if amt < 0 || amt >= bw {
                    tc_error_at("shift `{op}` amount {amt} out of range for {type_to_str(lt)} (must be 0..{bw})", node)
                }
            }
            if tc_tid_is_no_info(lt) == 0 { return lt }
            return TYPE_INT
        }
        if tc_tid_is_no_info(lt) == 0 { return lt }
        return rt
    }

    if kind == NodeKind.UnaryOp {
        let op = node_op(node)
        let operand = infer_type(node_left(node))
        if op == "!" { return TYPE_BOOL }
        if op == "-" {
            // Unary minus desugars to Neg.neg, a sealed arithmetic trait (spec
            // sections/02_syntax.md:1046) — `-someStruct` / `-someOpaque` is not numeric.
            reject_non_numeric_arith_operand(op, operand, node, 1)
            return operand
        }
        if op == "~" {
            if tc_tid_is_no_info(operand) == 0 && is_integer_type(operand) == 0 {
                tc_error_at_code("bitwise `~` requires integer operand, got {type_to_str(operand)}", node, "TypeError", TYPE_ERROR, bitwise_operand_help(op, operand))
            }
            return operand
        }
        if op == "?" {
            // Read through a bound metavar: an operand such as a `map` element carries its
            // Result or Option only as the metavar's solution.
            let carrier = resolve_alias_tid(tc_resolve(operand))
            let ok = type_kind(carrier)
            if ok == TyKind.Result {
                let operand_err = ty_pool.get(carrier).unwrap().inner2
                if tc_in_test_body == 1 {
                    // Spec §2.20 / §3c.2: inside a test body E is rendered via
                    // Display.display(e), not structurally propagated. Skip the
                    // E0512/E0508 gates; require Display[E] (E0514). Skip when E
                    // is unresolved/generic (helper returns 0 there).
                    let k = type_kind(operand_err)
                    if k != TyKind.Unknown && k != TyKind.Typevar && tc_type_id_has_display(operand_err) == 0 {
                        tc_errors.push("`?` on Result in test body requires error type `{type_to_str(operand_err)}` to implement Display")
                        diag_error_at("QuestionMarkTestDisplayRequired", QM_TEST_DISPLAY_REQUIRED, "`?` in a test body requires the error type `{type_to_str(operand_err)}` to implement Display", node, "implement `impl Display for {type_to_str(operand_err)}` or `.unwrap()` the Result explicitly")
                    }
                } else if tc_current_fn_ret >= 0 && tc_current_fn_ret < ty_pool.len() {
                    let ret_kind = ty_pool.get(tc_current_fn_ret).unwrap().kind
                    if ret_kind != TyKind.Result && ret_kind != TyKind.Unknown {
                        tc_errors.push("`?` on Result in function `{tc_current_fn_name}` which does not return Result")
                        diag_error_at("QuestionMarkResultInNonResult", QM_RESULT_IN_NON_RESULT, "`?` on Result in function `{tc_current_fn_name}` which does not return Result", node, "change the return type to Result[T, E]")
                    } else if ret_kind == TyKind.Result {
                        let ret_err = ty_pool.get(tc_current_fn_ret).unwrap().inner2
                        if types_compatible(operand_err, ret_err) == 0 {
                            tc_errors.push("`?` error type mismatch in function `{tc_current_fn_name}`")
                            diag_error_at("QuestionMarkErrorMismatch", QM_ERROR_MISMATCH, "`?` error type mismatch: operand error type does not match return error type in `{tc_current_fn_name}`", node, "ensure the error types are compatible")
                        }
                    }
                }
                return ty_pool.get(carrier).unwrap().inner1
            }
            if ok == TyKind.Option {
                // Spec §2.20: in a test body `?` on Option is permitted —
                // None propagates as a fixed-message TestError. The
                // elaborated return is Result[Void, TestError] (not Option),
                // so suppress the QM-Option-in-non-Option gate here.
                if tc_in_test_body == 0 && tc_current_fn_ret >= 0 && tc_current_fn_ret < ty_pool.len() {
                    let ret_kind = ty_pool.get(tc_current_fn_ret).unwrap().kind
                    if ret_kind != TyKind.Option && ret_kind != TyKind.Unknown {
                        tc_errors.push("`?` on Option in function `{tc_current_fn_name}` which does not return Option")
                        diag_error_at("QuestionMarkOptionInNonOption", QM_OPTION_IN_NON_OPTION, "`?` on Option in function `{tc_current_fn_name}` which does not return Option", node, "change the return type to Option[T]")
                    }
                }
                return ty_pool.get(carrier).unwrap().inner1
            }
            if ok != TyKind.Unknown {
                tc_errors.push("`?` requires Result or Option value")
                diag_error_at("QuestionMarkInvalidOperand", QM_INVALID_OPERAND, "`?` requires a Result or Option value", node, "")
            }
            return operand
        }
        return operand
    }

    if kind == NodeKind.Call {
        let callee = node_left(node)
        if callee != -1 {
            let callee_kind = node_kind(callee)
            if callee_kind == NodeKind.Ident {
                let written = node_name(callee)
                let alias_decl = tc_aliased_callee_decl(written)
                let fn_name = if alias_decl >= 0 { node_name(alias_decl) } else { written }
                let vpick = tc_pick_bare_variant(fn_name, node, tc_prelude_carrier_of(fn_name))
                let as_carrier = match vpick {
                    BareVariantPick.Carrier(_) => true
                    _ => false
                }
                // A prelude carrier name some enum also declares resolves here, before the
                // builtins below, which would take it for the carrier.
                if !as_carrier && tc_prelude_carrier_of(fn_name).is_some() {
                    match tc_infer_bare_variant_call(node, fn_name, vpick) {
                        Some(t) => return t
                        None => {}
                    }
                }
                if as_carrier {
                    return tc_carrier_call_tid(fn_name, node_args(node), node)
                }
                if fn_name == "Raw" {
                    let args_sl = node_args(node)
                    let raw_count = if args_sl == -1 { 0 } else { sublist_length(args_sl) }
                    if raw_count != 1 {
                        tc_error_at_code("`Raw` expects 1 argument, got {raw_count}", node, "TypeError", TYPE_ERROR,
                            "wrap exactly one `Str`: `Raw(name)`")
                        return tc_error_recovery_tid()
                    }
                    let raw_arg = sublist_get(args_sl, 0)
                    let raw_inner = infer_type(raw_arg)
                    tc_raw_require_str(raw_arg, raw_inner)
                    return make_raw_type(TYPE_STR)
                }
                // old(e) in an @ensures predicate is e's value at entry, so it has e's type.
                if fn_name == "old" && tc_in_ensures_predicate != 0 {
                    let args_sl = node_args(node)
                    if args_sl != -1 && sublist_length(args_sl) == 1 {
                        tc_old_calls.insert(node, 1)
                        return infer_type(sublist_get(args_sl, 0))
                    }
                }
                let skip_is_intrinsic = fn_name != "skip" || tc_call_is_skip_intrinsic(node)
                if fn_name == "skip" && skip_is_intrinsic { return tc_check_skip_call(node) }
                // A resolved fn declaration always wins over a builtin's spelling: see
                // tc_call_decl_is_fn. Skipping the builtin branch here lets this call fall
                // through to lookup_fnsig below, which types it against the user's own
                // signature instead of the builtin's.
                // A local binding shadows a builtin as it shadows a module-level fn: the
                // local-scope arm below reads it.
                if is_builtin_fn(fn_name) != 0 && skip_is_intrinsic && !tc_call_decl_is_fn(node) && tc_tid_is_no_info(nr_get_type(fn_name)) != 0 {
                    let bsig = fnsig_map.get(tc_builtin_sig_key(fn_name)) ?? -1
                    if bsig != -1 {
                        let bret = tc_check_builtin_sig_call(fn_name, bsig, node)
                        tc_warn_todo_in_code(fn_name, node)
                        return bret
                    }
                    // Infer args so nested expressions (e.g. a method call passed
                    // to println) are type-checked — variadic builtins otherwise
                    // skip arg inference, hiding errors like E0522.
                    let bf_args = node_args(node)
                    if bf_args != -1 {
                        // An assertion shows its message when it fails, so a Raw there is
                        // shown as a print sink would show it.
                        let shows_msg = fn_name == "assert" || fn_name == "debug_assert"
                        let mut bai = 0
                        while bai < sublist_length(bf_args) {
                            let bf_arg = sublist_get(bf_args, bai)
                            let bf_t = infer_type(bf_arg)
                            if shows_msg && bai == 1 { tc_raw_reject_display_sink(bf_arg, bf_t) }
                            bai = bai + 1
                        }
                    }
                    if fn_name == "alloc_ptr" || fn_name == "null_ptr" {
                        if node_type_params(node) != -1 { return tc_ptr_from_type_arg(node, fn_name) }
                        return tc_ptr_ctor_tid()
                    }
                    if (fn_name == "Map" || fn_name == "Set") && tc_empty_ctor_arity(fn_name, node) == 0 {
                        return tc_error_recovery_tid()
                    }
                    if (fn_name == "Map" || fn_name == "Set") && node_type_params(node) != -1 {
                        return tc_container_ctor_from_type_args(node, fn_name)
                    }
                    // A bare StringBuilder call, already reported by name resolution, still
                    // answers the type it plainly meant, so its uses report nothing further.
                    let ret = get_builtin_fn_ret(fn_name)
                    tc_note_open_ctor_key(node, ret)
                    return ret
                }
                if !as_carrier {
                    match tc_infer_bare_variant_call(node, fn_name, vpick) {
                        Some(t) => return t
                        None => {}
                    }
                }
                // Local lexical scope shadows module-level definitions
                // (sections/02_syntax.md:671-680, 07_trust_modules_metadata.md:1042).
                // A closure parameter named `f` (e.g. list_fold's `f: fn(U,T)->U`)
                // must NOT resolve against a same-named top-level fn — doing so
                // applied the global fn's arity to the closure call and produced a
                // spurious TypeError inside the stdlib. When the name
                // is bound in local scope, it wins: infer the args (so nested
                // expressions are still type-checked) and, if the local binding is
                // a structured fn type, arity/type-check against THAT; otherwise
                // return its type without consulting the global fnsig.
                //
                // The TyKind.Fn branch below is the live path: closure literals infer a
                // structured tid and `fn(..)` annotations lower to it, so a locally-bound
                // callable has a structured tid to check against, which is
                // what makes `let g = c` followed by `g(21)` arity-checked.
                let local_tid = nr_get_type(written)
                if tc_tid_is_no_info(local_tid) == 0 {
                    // The callee names a VALUE — a closure in a local or a parameter — not an
                    // item, so it is a value child like any other and carries its own type.
                    tc_publish_node_tid(callee, local_tid)
                    let call_args_sl = node_args(node)
                    if node_type_params(node) != -1 {
                        // A value declares no type parameters, so brackets after it were
                        // meant as an index.
                        let _ = tc_claim_type_args(node, 0, fn_name, ELEMENT_ACCESS_HELP)
                        let _ = tc_infer_arg_tids(call_args_sl)
                        return tc_error_recovery_tid()
                    }
                    if type_kind(local_tid) == TyKind.Fn {
                        return tc_check_call_against_fn_tid(local_tid, call_args_sl, "function `{fn_name}`", node)
                    }
                    if call_args_sl != -1 {
                        let mut li = 0
                        while li < sublist_length(call_args_sl) {
                            infer_type(sublist_get(call_args_sl, li))
                            li = li + 1
                        }
                    }
                    // The name is in scope and carries a type, and that type is not a function.
                    // A local whose own type is still open is not yet known to be uncallable, so
                    // only a settled non-Fn type is reported.
                    let lk = type_kind(local_tid)
                    if lk == TyKind.Unknown || lk == TyKind.Typevar { return -1 }
                    tc_error_at("cannot call `{fn_name}`: it has type {type_to_str(local_tid)}, which is not a function", node)
                    return tc_error_recovery_tid()
                }
                let sig = tc_bare_callee_sig(written)
                // Name resolution already reported the call; the arguments are still checked,
                // and the call answers the recovery type so its uses report nothing further.
                if sig == -1 && tc_names_type_without_call_form(fn_name) {
                    let _ = tc_infer_arg_tids(node_args(node))
                    return tc_error_recovery_tid()
                }
                if sig != -1 { return tc_check_free_call(fn_name, sig, node) }
            } else if callee_kind == NodeKind.FieldAccess {
                // A FIELD holding a function value — `(self.action)()`, `(h.on_error)(1, m)`.
                // The field's own type is the only thing that says what the call answers and
                // the only thing that can check the arguments; without it the call is both
                // untyped and unchecked. Same treatment as a closure variable, since the
                // callee is a closure value either way.
                let fa_fn_t = infer_type(callee)
                if type_kind(fa_fn_t) == TyKind.Fn {
                    return tc_check_call_against_fn_tid(fa_fn_t, node_args(node), "field", node)
                }
                // Infer args so nested expressions in a module-qualified call
                // (e.g. io.println(x.m())) are type-checked — otherwise this
                // branch returns without descending, hiding E0522.
                let fa_args = node_args(node)
                if fa_args != -1 {
                    let mut fai = 0
                    while fai < sublist_length(fa_args) {
                        infer_type(sublist_get(fa_args, fai))
                        fai = fai + 1
                    }
                }
                let obj = node_obj(callee)
                if obj != -1 && node_kind(obj) == NodeKind.Ident {
                    let type_name = node_name(obj)
                    let tid = lookup_named_type(type_name)
                    if tid != -1 { return tid }
                }
            } else if callee_kind == NodeKind.Closure {
                // An immediately-invoked closure literal (IIFE) must not fall through to
                // TYPE_UNKNOWN without its arguments being checked — TYPE_UNKNOWN
                // unifies with anything, which would make `let bad: Str = fn() -> Int { 7 }()`
                // a silent miscompile rather than a TypeError. The Closure arm of infer_type
                // already answers a real TyKind.Fn tid built from the literal's own
                // annotations, so this is dispatch, not new inference: the same checking the
                // closure-VARIABLE path above performs, against the same kind of tid.
                let cls_tid = infer_type(callee)
                if type_kind(cls_tid) == TyKind.Fn {
                    return tc_check_call_against_fn_tid(cls_tid, node_args(node), "closure", node)
                }
                // No structured tid (an un-annotated literal): still infer the arguments, so
                // nested expressions in them are checked, then fall through to TYPE_UNKNOWN.
                let cls_args = node_args(node)
                if cls_args != -1 {
                    let mut cai = 0
                    while cai < sublist_length(cls_args) {
                        infer_type(sublist_get(cls_args, cai))
                        cai = cai + 1
                    }
                }
            } else {
                // A call through any OTHER value expression — `xs.get(0).unwrap()(1)`, an
                // element read out of a container and applied in place. The callee is a
                // closure value like the two arms above, so it gets their treatment: its own
                // type says what the call answers and checks the arguments. Without this the
                // call returned unclaimed and nothing inside the callee was typed either.
                let val_fn_t = infer_type(callee)
                if type_kind(val_fn_t) == TyKind.Fn {
                    return tc_check_call_against_fn_tid(val_fn_t, node_args(node), "closure", node)
                }
                let val_args = node_args(node)
                if val_args != -1 {
                    let mut vai = 0
                    while vai < sublist_length(val_args) {
                        infer_type(sublist_get(val_args, vai))
                        vai = vai + 1
                    }
                }
            }
        }
        // Nothing above claimed this node, so nothing has typed it — an absence.
        return -1
    }

    if kind == NodeKind.MethodCall {
        let obj_node = node_obj(node)
        let method = node_method(node)

        // A local value shadowing a trait/module name makes `obj.method(args)` an
        // instance call, not a qualified trait call (§03c:590, §10.1:1164). Capture
        // it here while scope is live so the mono pass can route it correctly after
        // nr scope is torn down. Monotonic, so a later scope-torn-down re-inference
        // never un-marks it.
        if obj_node != -1 && node_kind(obj_node) == NodeKind.Ident && nr_has_binding(node_name(obj_node)) != 0 {
            tc_mc_obj_value_marks.set(node, 1)
        }

        // `p.zzf.read()` and `p.zzf.write(v)` — the typed field access the spec documents for a
        // `Ptr[@ffi.struct S]` (§9.1). The receiver is a PLACE reached through the pointer, not
        // an ordinary value of the field's type, so the pair is resolved on the SHAPE of the
        // receiver — a field access whose own object is a pointer — which is the same shape
        // codegen lowers it on. Resolving on the receiver's TYPE would instead put `read` and
        // `write` on every value of that field's type.
        if method == "read" || method == "write" {
            if obj_node != -1 && node_kind(obj_node) == NodeKind.FieldAccess {
                if tc_ptr_ffi_struct_pointee(infer_type(node_obj(obj_node))) != 0 {
                    let place_t = infer_type(obj_node)
                    if method == "read" { return place_t }
                    // Inferred, not checked against the field: a stored value that does not fit
                    // is C's to reject until the pointee-vs-argument check the Ptr arm below
                    // still owes exists for `.write` in both its spellings.
                    let pw_args = node_args(node)
                    if pw_args != -1 && sublist_length(pw_args) >= 1 {
                        infer_type(sublist_get(pw_args, 0))
                    }
                    return TYPE_VOID
                }
            }
        }

        // `async.spawn(f)` is Handle[T] for f's return type T. It parses as an
        // ordinary MethodCall on the `async` module — NodeKind.AsyncSpawn has no producer
        // anywhere in src/ or lib/ and is a dead variant — so the answer belongs here rather
        // than in an AsyncSpawn arm. The nr_get_type guard mirrors codegen's mc_obj_is_local
        // check: a local named `async` must not be mistaken for the module.
        if obj_node != -1 && node_kind(obj_node) == NodeKind.Ident && node_name(obj_node) == "async" && method == "spawn" {
            if tc_tid_is_no_info(nr_get_type("async")) != 0 {
                let sp_args = node_args(node)
                if sp_args != -1 && sublist_length(sp_args) >= 1 {
                    let sp_cls = sublist_get(sp_args, 0)
                    if node_kind(sp_cls) == NodeKind.Closure {
                        // spawn calls its task with no arguments, so a literal that takes one is the same
                        // type error as any other argument that is not `fn() -> T`.
                        let sp_params = node_params(sp_cls)
                        if sp_params != -1 && sublist_length(sp_params) > 0 {
                            return tc_spawn_value_handle(sp_cls)
                        }
                        // A DECLARED return wins; otherwise infer the body's tail, because
                        // tc_closure_declared_ret answers TYPE_VOID for an un-annotated
                        // closure and the corpus form is `async.spawn(fn() { compute(100) })`
                        // — taking Void there would make every `.await` on it Void. The body
                        // is only inferred for a zero-param closure (spawn's shape), so no
                        // param binding is needed for the walk to be sound.
                        if node_type_ann(sp_cls) != -1 {
                            return make_handle_type(tc_closure_declared_ret(sp_cls))
                        }
                        // Infer the inner from the body ONCE and reuse the memo. Re-walking the
                        // body on a later pass is unstable: a body-local `let` falls out of
                        // scope, a call's return gets mono-lowered to a struct kind, an unpinned
                        // `Ok` loses its err type — so codegen would re-derive a different (and
                        // wrong) handle than the check pass established. The annotated arm above
                        // stays a per-call resolve so a generic-T spawn refines per instance.
                        //
                        // The memo is honoured only when its inner is DETERMINED. A
                        // Handle[?] memo is the fingerprint of the annotation-blind
                        // name-resolution pass, which walks this body before a captured
                        // outer `let` has a type — locking Unknown there would outlive the
                        // typed pass that could pin it. Re-inferring an under-determined
                        // memo lets the later, in-scope pass upgrade it; a concrete memo is
                        // authoritative and never re-walked (the instability above).
                        // "Under-determined" is checked to any depth in BOTH forms an inner
                        // can carry a hole — a raw TYPE_UNKNOWN (tc_tid_has_unknown) and an
                        // unbound metavar (tc_tid_has_unbound_metavar) — so a compound like
                        // Handle[List[?]] or Handle[Result[?,?]] is re-walked too, not just
                        // a bare Handle[?].
                        let sp_memo = tc_lookup_node_tid(node)
                        if sp_memo != -1 && tc_tid_kind(sp_memo) == TyKind.Handle {
                            let memo_inner = tc_tid_child(sp_memo, 0)
                            if tc_tid_has_unknown(memo_inner) == 0 && tc_tid_has_unbound_metavar(memo_inner) == 0 {
                                return sp_memo
                            }
                        }
                        return make_handle_type(infer_type(node_body(sp_cls)))
                    }
                    return tc_spawn_value_handle(sp_cls)
                }
            }
        }

        // `Option.Some(x)` and `Result.Err(e)` name the carrier directly (§3.4 resolution
        // step 1), so neither the expected type nor a user enum's namesake variant is asked.
        if obj_node != -1 && node_kind(obj_node) == NodeKind.Ident && tc_tid_is_no_info(nr_get_type(node_name(obj_node))) != 0 {
            if tc_qualified_carrier(node_name(obj_node), method).is_some() {
                return tc_carrier_call_tid(method, node_args(node), node)
            }
        }

        // A variant name (e.g. `Key`) can shadow an enum type name when
        // `Key` is also a variant of another enum (`Event.Key`). For qualified
        // construction `Enum.Variant(...)`, resolve the obj as a TYPE first when
        // there is no real local of that name — otherwise Ident inference picks
        // the shadowing variant's enum and `.Variant` fails to resolve.
        if obj_node != -1 && node_kind(obj_node) == NodeKind.Ident {
            let cname = node_name(obj_node)
            if tc_tid_is_no_info(nr_get_type(cname)) != 0 {
                let ctor_tid = lookup_named_type(cname)
                if ctor_tid != -1 && type_kind(ctor_tid) == TyKind.Enum {
                    let cvar_idx = get_variant_by_name(ctor_tid, method)
                    if cvar_idx != -1 {
                        nr_note_call_decl(node, tc_variant_decl_node(cvar_idx))
                        let cargs_sl = node_args(node)
                        tc_check_variant_paren_payload(cvar_idx, method, node)
                        let payload_tids = tc_check_variant_payload_values("{cname}.{method}", cvar_idx, cargs_sl)
                        // A generic-enum qualified ctor (`Tree.Leaf(1)`) reverse-infers
                        // its concrete instance tid; a non-generic enum keeps the bare
                        // ctor_tid.
                        let cdecl = tc_type_decl_nodes.get(tc_written_type_nominal(cname)) ?? -1
                        return tc_enum_ctor_instance_tid(ctor_tid, cdecl, cvar_idx, cargs_sl, payload_tids)
                    }
                }
                match tc_value_missing_variant(cname, method) {
                    Some(owner) => {
                        tc_report_no_such_variant_value(node, owner, cname, method, 1)
                        let _ = tc_infer_arg_tids(node_args(node))
                        // Reported here, so the method-resolution flush adds no UnknownMethod.
                        tc_unresolved_method_hard.insert(node, 1)
                        return tc_error_recovery_tid()
                    }
                    None => {}
                }
            }
        }

        // StringBuilder's two static constructors, resolved from the receiver's
        // NAME before the receiver is inferred as a value.
        //
        // The ordering is load-bearing. `StringBuilder` is a builtin type with no Blink
        // declaration, so a bare Ident spelling it has nothing to resolve to — except that
        // an enum in scope may own a variant of the same name, and bare-variant resolution
        // then infers the Ident as THAT ENUM. typecheck's own TyKind has exactly such a
        // variant (and a `Char` one, the same hazard for `Char.from_code_point`), so any
        // file importing TyKind and calling `StringBuilder.new()` — tests/, and any future
        // compiler module — would reach the Struct/Enum branch below and be rejected with
        // E0505 "unresolved method '.new' on type TyKind". Deciding on the name first
        // cannot be shadowed that way.
        //
        // A local genuinely named `StringBuilder` still wins: it is a value, and a value
        // receiver is not a static call.
        if obj_node != -1 && node_kind(obj_node) == NodeKind.Ident {
            if node_name(obj_node) == "StringBuilder" && nr_is_defined("StringBuilder") == 0 {
                if method == "new" { return type_stringbuilder() }
                // Kept beside `new` rather than folded into get_builtin_fn_ret, which is
                // keyed on the type name alone and so cannot tell two constructors apart.
                if method == "with_capacity" {
                    if check_builtin_arity("StringBuilder", method, 1, node_args(node), node) == 1 {
                        check_builtin_arg(method, 0, TYPE_INT, node_args(node), "StringBuilder")
                    }
                    return type_stringbuilder()
                }
            }
        }

        // A sealed ops trait's qualified call `StrOps.len(s)` is the same call as `s.len()`
        // (§3c.4), so it takes the receiver from its first argument and goes through the one
        // dispatch below. The instance spelling's checks are then the qualified spelling's
        // checks by construction, not by a second table that has to keep up with them.
        let qualified = tc_sealed_ops_qualified_args(node, obj_node)
        let recv_node = tc_mc_receiver(node)
        let args_sl = tc_mc_call_args(node)

        // Resolve bound metavars up front: a pinned α (`let mut xs = []` whose element
        // is fixed by a later `push`) has kind Unknown with inner1 pointing at its
        // solution, and every arm below reads structural children from `obj_t.inner1`.
        // type_kind already resolves, so `obj_k` names the solution's kind — but reading
        // the UNRESOLVED α's inner1 returns the binding pointer, not the type's real
        // child, which typed `e.unwrap()` on an `Option[T]` α one level too deep.
        let obj_t = tc_resolve(tc_infer_receiver(recv_node))
        let obj_k = type_kind(obj_t)

        // A plain method call on `Self` in a trait default body is licensed only when the
        // method is in the trait's guarantee set (its own methods + the supertrait
        // closure's). Reported at the trait definition (E0305). Fires only for a `Self`
        // receiver with an active `Self` frame, so ordinary calls are untouched.
        if obj_k == TyKind.Typevar && type_to_str(obj_t) == "Self" {
            let gm = tc_tparam_bound_methods("Self")
            if gm != "" && tc_pipe_has(gm, method) == 0 {
                diag_error_at("UnlicensedSelfOperation", UNLICENSED_SELF_OP,
                    "method `.{method}` on `Self` is not licensed by `{tc_current_self_trait}`", node,
                    "`{tc_current_self_trait}` does not declare `{method}`, and no supertrait it names provides it; declare the method on `{tc_current_self_trait}` (or a supertrait that has it) so every implementor supplies it")
                return tc_error_recovery_tid()
            }
        }

        // §3c rule-3 on a List receiver: an unqualified call to a method
        // defined by two or more owners is ambiguous. Owners are the user
        // poly-impl traits (`impl[T] Trait for List[T]`, recorded via
        // tc_record_method_trait under "List") plus, for a reused HOF name, the
        // sealed built-in List surface. Placed BEFORE the builtin arity table and
        // the builtin List block: ambiguity is a resolution error, so a user method
        // shadowing fold/map/... must not first be counted as the sealed one. Mirrors the
        // struct/enum guard below. A qualified call names its owner, so it is never
        // ambiguous: a sealed one skips this, and any other has obj = Ident(Trait).
        if obj_k == TyKind.List && qualified == -1 {
            let user_traits = tc_method_trait_count("List", method)
            let sealed_hof = tc_is_sealed_list_hof(method)
            if user_traits + sealed_hof >= 2 {
                let user_names = tc_traits_shown(tc_method_trait_names("List", method))
                let names = if sealed_hof != 0 {
                    if user_names != "" { "{user_names} and the sealed built-in List.{method}" } else { "the sealed built-in List.{method}" }
                } else { user_names }
                diag_error_at("AmbiguousMethodCall", AMBIGUOUS_METHOD_CALL, "ambiguous method call: `.{method}` is defined in multiple traits implemented by List ({names})", node, "use a qualified call to disambiguate, e.g. `Trait.{method}(receiver)`")
                return tc_error_recovery_tid()
            }
        }

        // A builtin method has no fnsig, so nothing counted the arguments a caller wrote:
        // the count is implicit in which arm below answers, and an arm that never asks about
        // an index — every nullary method — could not notice a surplus at all. Ask the table
        // once, ahead of every arm, and stop on a wrong count: an arm that reads argument 1
        // of a one-argument call would otherwise index past the end.
        let bi_arity = tc_builtin_method_arity(obj_k, method)
        if obj_k == TyKind.Str && method == "byte_index_of" && args_sl != -1 && sublist_length(args_sl) == 1 {
            tc_report_byte_index_of_missing_from(sublist_get(args_sl, 0))
            return tc_error_recovery_tid()
        }
        if bi_arity >= 0 {
            if check_builtin_arity(tc_builtin_recv_label(obj_k), method, bi_arity, args_sl, node) == 0 {
                return tc_error_recovery_tid()
            }
        }

        // Builtin scalar Display: display() -> Str and fmt(sb) on Int/Float/Bool/Str/Char.
        if obj_k == TyKind.Int || obj_k == TyKind.Float || obj_k == TyKind.Bool || obj_k == TyKind.Str || obj_k == TyKind.Char {
            if method == "display" { return TYPE_STR }
            if method == "fmt" { return TYPE_VOID }
        }

        // `.into_iter()` is the crossing door into the lazy world (§3c.1:11-18, IntoIterator
        // built-in impls at :127-136): List[T]/Set[T]/Iterator[T] yield T and Str yields Char.
        // It is the ONLY producer of a TyKind.Iterator carrier. Map[K,V]->(K,V) is legal per
        // the spec table but not yet wired through codegen's into_iter door, so it is left to
        // fall through to its own method arms rather than typed to an un-lowerable Iterator.
        if method == "into_iter" {
            if obj_k == TyKind.List || obj_k == TyKind.Set {
                return make_iterator_type(ty_pool.get(obj_t).unwrap().inner1)
            }
            if obj_k == TyKind.Str { return make_iterator_type(TYPE_CHAR) }
            if obj_k == TyKind.Iterator { return obj_t }
        }

        // `.collect()` is the ONE iterator-exclusive method (§3c.1:18,70,753): it crosses an
        // iterator BACK to a List. On a collection receiver it is not a method at all — a
        // collection is already collected. Reject it HERE at typecheck, not at the codegen
        // backstop, so `blink check` and `blink build` agree: name resolution belongs with
        // E0504/E0506/E0507 (see the E0505 gate note at the Struct/Enum path below), and the
        // backstop is unreachable once diag_count > 0 aborts before codegen. The Iterator
        // receiver's collect is answered by the Iterator dispatch block immediately below.
        if method == "collect" && (obj_k == TyKind.List || obj_k == TyKind.Map || obj_k == TyKind.Set || obj_k == TyKind.Str || obj_k == TyKind.Bytes) {
            diag_error_at("UnresolvedMethod", UNRESOLVED_METHOD, "unresolved method `.collect` on type {type_to_str(obj_t)}", node, tc_list_rename_help("collect"))
            return tc_error_recovery_tid()
        }

        // The lazy iterator-receiver world (§3c.1:56-77): adapters are "iterator method in,
        // iterator out" and the consumers drain. Mirrors the eager List adapter table below but
        // wraps each adapter result in a fresh Iterator carrier; `.collect()` is the door back to
        // a List.
        if obj_k == TyKind.Iterator {
            let elem = ty_pool.get(obj_t).unwrap().inner1
            if method == "map" {
                let cls = closure_arg_at(args_sl, 0)
                check_closure_param(cls, 0, elem, method, "Iterator")
                if cls == -1 { return obj_t }
                let ret_ann = node_type_ann(cls)
                if ret_ann != -1 {
                    let u = resolve_type_ann(ret_ann)
                    if u != -1 { return make_iterator_type(u) }
                }
                let fv_ret = tc_hof_fn_value_ret(cls)
                if fv_ret != -1 { return make_iterator_type(fv_ret) }
                let ret_str = node_return_type(cls)
                if ret_str == "" { return tc_hof_result_slot(node, TyKind.Iterator) }
                let u = resolve_type_name(ret_str)
                if u != -1 { return make_iterator_type(u) }
                return tc_hof_result_slot(node, TyKind.Iterator)
            }
            if method == "flat_map" {
                let cls = closure_arg_at(args_sl, 0)
                check_closure_param(cls, 0, elem, method, "Iterator")
                if cls == -1 { return obj_t }
                let ret_ann = node_type_ann(cls)
                if ret_ann != -1 {
                    let u = resolve_type_ann(ret_ann)
                    if u != -1 { return u }
                }
                let fv_ret = tc_hof_fn_value_ret(cls)
                if fv_ret != -1 { return fv_ret }
                let ret_str = node_return_type(cls)
                if ret_str == "" { return tc_hof_result_slot(node, TyKind.Iterator) }
                let u = resolve_type_name(ret_str)
                if u != -1 { return u }
                return tc_hof_result_slot(node, TyKind.Iterator)
            }
            if method == "filter" {
                let cls = closure_arg_at(args_sl, 0)
                check_closure_param(cls, 0, elem, method, "Iterator")
                check_closure_ret(cls, TYPE_BOOL, method, "Iterator")
                return obj_t
            }
            if method == "take" || method == "skip" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "Iterator")
                return obj_t
            }
            if method == "chain" {
                check_builtin_arg(method, 0, obj_t, args_sl, "Iterator")
                return obj_t
            }
            if method == "enumerate" {
                return make_iterator_type(make_tuple_type([TYPE_INT, elem]))
            }
            if method == "zip" {
                if check_builtin_arity("Iterator", method, 1, args_sl, node) == 0 { return tc_error_recovery_tid() }
                let other_t = tc_resolve(infer_type(sublist_get(args_sl, 0)))
                // tc_tid_iter_elem answers the give-up singleton, not -1, for a receiver that is
                // not iterable, so the singleton is the predicate for "not an iterable" here.
                // An argument whose own type is not yet determined is not yet known to be wrong.
                let other_k = tc_tid_kind(other_t)
                if other_k == TyKind.Unknown || other_k == TyKind.Typevar { return tc_error_recovery_tid() }
                let other_elem = tc_tid_iter_elem(other_t)
                if other_elem < 0 { return tc_error_recovery_tid() }
                if other_elem == TYPE_UNKNOWN {
                    tc_error_at("argument 1 of `Iterator.zip` expects an iterable, got {type_to_str(other_t)}", sublist_get(args_sl, 0))
                    return tc_error_recovery_tid()
                }
                return make_iterator_type(make_tuple_type([elem, other_elem]))
            }
            // Consumers drain the iterator (§3c.1:69).
            if method == "collect" { return make_list_type(elem) }
            if method == "count" { return TYPE_INT }
            if method == "for_each" {
                check_closure_param(closure_arg_at(args_sl, 0), 0, elem, method, "Iterator")
                return TYPE_VOID
            }
            if method == "any" || method == "all" {
                let cls = closure_arg_at(args_sl, 0)
                check_closure_param(cls, 0, elem, method, "Iterator")
                check_closure_ret(cls, TYPE_BOOL, method, "Iterator")
                return TYPE_BOOL
            }
            if method == "find" {
                let cls = closure_arg_at(args_sl, 0)
                check_closure_param(cls, 0, elem, method, "Iterator")
                check_closure_ret(cls, TYPE_BOOL, method, "Iterator")
                return make_option_type(elem)
            }
            if method == "fold" {
                if check_builtin_arity("Iterator", method, 2, args_sl, node) == 0 { return tc_error_recovery_tid() }
                let init_t = infer_type(sublist_get(args_sl, 0))
                let cls = closure_arg_at(args_sl, 1)
                check_closure_param(cls, 0, init_t, method, "Iterator")
                check_closure_param(cls, 1, elem, method, "Iterator")
                return init_t
            }
        }

        if obj_k == TyKind.List {
            let elem = ty_pool.get(obj_t).unwrap().inner1
            if method == "len" || method == "count" || method == "capacity" { return TYPE_INT }
            if method == "get" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "List")
                return make_option_type(elem)
            }
            if method == "last" { return make_option_type(elem) }
            // A sorted copy. The bound is asked here, at the call, where the element is known;
            // the comparator a `sort_by` takes is checked here when it is annotated or a fn
            // value, and by tc_check_sort_by_body once an unannotated one is walked.
            if method == "sort" {
                if tc_refuse_unordered_sort(node, recv_node, elem) != 0 { return tc_error_recovery_tid() }
                return obj_t
            }
            if method == "sort_by" {
                let ord_t = tc_compiler_known_tid("Ordering")
                let cmp_arg = closure_arg_at(args_sl, 0)
                if cmp_arg != -1 && node_kind(cmp_arg) == NodeKind.Closure {
                    check_closure_param(cmp_arg, 0, elem, method, "List")
                    check_closure_param(cmp_arg, 1, elem, method, "List")
                    if ord_t != -1 { check_closure_ret(cmp_arg, ord_t, method, "List") }
                } else if ord_t != -1 {
                    check_builtin_arg(method, 0, make_fn_type(ord_t, [elem, elem]), args_sl, "List")
                }
                return obj_t
            }
            if method == "push" {
                check_builtin_arg(method, 0, elem, args_sl, "List")
                return TYPE_VOID
            }
            if method == "set" || method == "insert" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "List")
                check_builtin_arg(method, 1, elem, args_sl, "List")
                return TYPE_VOID
            }
            // Bare T, not Option: an index out of range panics, as `xs[i]` does.
            if method == "remove" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "List")
                return elem
            }
            // `pop` removes AND RETURNS the last element (`sections/03_types.md:390`,
            // `lib/std/traits.bl:56` `fn pop(self) -> Option[T]`), matching what codegen
            // builds (src/codegen_methods.bl:1285).
            if method == "pop" { return make_option_type(elem) }
            if method == "clear" { return TYPE_VOID }
            if method == "for_each" {
                check_closure_param(closure_arg_at(args_sl, 0), 0, elem, method, "List")
                return TYPE_VOID
            }
            if method == "take" || method == "skip" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "List")
                return obj_t
            }
            // `chain(other)` concatenates two same-element sequences and yields the
            // same element type (`sections/03c_protocols.md:67`
            // `fn chain(self, other: Iterator[T]) -> Iterator[T]`). Without an arm here
            // it memoized as TYPE_UNKNOWN — a non-negative tid that carries no element,
            // so codegen could not recover the carrier from the node tid. Returning the
            // receiver type keeps the element tid-recoverable, matching filter/take/skip.
            if method == "chain" {
                check_builtin_arg(method, 0, obj_t, args_sl, "List")
                return obj_t
            }
            // enumerate/zip yield genuine tuples (`sections/03c_protocols.md:98,102` —
            // enumerate -> Iterator[(Int,T)], zip -> Iterator[(T,U)]). Codegen already
            // materializes them as Tuple2_<a>_<b> structs; without an arm here
            // the result memoized as TYPE_UNKNOWN, so a downstream `.get().unwrap()`
            // could not tid-back the tuple carrier and fell to the flat sname. Returning
            // the List[Tuple] shape lets tc_tid_tuple_tag spell the same Tuple2 name the
            // struct path builds, keeping the carrier tid-recoverable.
            if method == "enumerate" {
                return make_list_type(make_tuple_type([TYPE_INT, elem]))
            }
            if method == "zip" {
                // A malformed `a.zip()` (no arg) must not index an empty sublist —
                // sublist_get panics out of bounds — so the arity is reported first and
                // the arm stops.
                if check_builtin_arity("List", method, 1, args_sl, node) == 0 { return tc_error_recovery_tid() }
                let other_t = tc_resolve(infer_type(sublist_get(args_sl, 0)))
                let other_elem = tc_tid_list_elem(other_t)
                if other_elem < 0 {
                    tc_error_at("argument 1 of `List.zip` expects a List, got {type_to_str(other_t)}", sublist_get(args_sl, 0))
                    return tc_error_recovery_tid()
                }
                return make_list_type(make_tuple_type([elem, other_elem]))
            }
            if method == "slice" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "List")
                check_builtin_arg(method, 1, TYPE_INT, args_sl, "List")
                return obj_t
            }
            if method == "append" {
                check_builtin_arg(method, 0, obj_t, args_sl, "List")
                return obj_t
            }
            // `join` must resolve to a real type, not TYPE_UNKNOWN: it is in
            // is_builtin_method (:6299) — which is what lets it past the E0505
            // and W0501 gates — and codegen has always emitted
            // `str_join(obj, delim) -> string` (codegen_methods.bl:1620), so an
            // unresolved type here unifies with anything, lets a mistyped result
            // through, and leaves a non-Str element receiver unchecked (`[1, 2].join(",")`
            // reads int64 as `const char*` in str_join).
            //
            // sections/03_types.md:227-238 spells the impl header exactly —
            // `impl Joinable for List[Str]`, `fn join(self, separator: Str) ->
            // Str` — and the sealed-trait table at :521 reads
            // `Joinable | List[Str] | join`. So BOTH the separator and the
            // element type are pinned by the spec, not chosen here.
            //
            // The element check fails open on Unknown and Typevar. type_kind
            // resolves a bound metavar, so a pinned α reads as its solution;
            // what is left is a genuinely unresolved element — a typevar in a
            // generic fn body (`fn f[T](xs: List[T]) -> Str { xs.join(",") }`)
            // cannot be judged at the definition site, and whether that shape
            // should require a bound is a spec question about generic bounds.
            if method == "join" {
                check_builtin_arg(method, 0, TYPE_STR, args_sl, "List")
                // An element still open here (a `map` whose closure body is walked after this
                // call is typed) is pinned to Str, so a body that produces anything else
                // conflicts and is reported instead of passing through the fail-open below.
                if tc_is_unbound_metavar(tc_resolve(elem)) != 0 { tc_unify(elem, TYPE_STR) }
                let ek = type_kind(elem)
                if ek != TyKind.Str && ek != TyKind.Unknown && ek != TyKind.Typevar {
                    tc_error_at("List.join requires List[Str], got {type_to_str(obj_t)}", node)
                }
                return TYPE_STR
            }
            if method == "map" {
                let cls = closure_arg_at(args_sl, 0)
                check_closure_param(cls, 0, elem, method, "List")
                if cls == -1 { return obj_t }
                // Resolve the closure's return from its annotation NODE, not the bare
                // string: resolve_type_name only spells a primitive or a single named
                // type, so a compound return (Option[Int], (Int, Int)) flattened to the
                // source element — typing `list.map` as List[T] instead of List[U] and
                // erasing the element for every downstream collect/for-in.
                let ret_ann = node_type_ann(cls)
                if ret_ann != -1 {
                    let u = resolve_type_ann(ret_ann)
                    if u != -1 { return make_list_type(u) }
                }
                let fv_ret = tc_hof_fn_value_ret(cls)
                if fv_ret != -1 { return make_list_type(fv_ret) }
                let ret_str = node_return_type(cls)
                if ret_str == "" { return tc_hof_result_slot(node, TyKind.List) }
                let u = resolve_type_name(ret_str)
                if u != -1 { return make_list_type(u) }
                return tc_hof_result_slot(node, TyKind.List)
            }
            if method == "flat_map" {
                let cls = closure_arg_at(args_sl, 0)
                check_closure_param(cls, 0, elem, method, "List")
                if cls == -1 { return obj_t }
                // flat_map's closure returns a List[U] and flat_map flattens, so the
                // result type IS that closure return directly — not make_list_type(U)
                // (that would spell List[List[U]] and erase the real element). Resolve
                // from the annotation NODE like `map`, so a compound element (List of a
                // struct) threads its element tid instead of collapsing to List[?].
                let ret_ann = node_type_ann(cls)
                if ret_ann != -1 {
                    let u = resolve_type_ann(ret_ann)
                    if u != -1 { return u }
                }
                let fv_ret = tc_hof_fn_value_ret(cls)
                if fv_ret != -1 { return fv_ret }
                let ret_str = node_return_type(cls)
                if ret_str == "" { return tc_hof_result_slot(node, TyKind.List) }
                let u = resolve_type_name(ret_str)
                if u != -1 { return u }
                return tc_hof_result_slot(node, TyKind.List)
            }
            if method == "filter" {
                let cls = closure_arg_at(args_sl, 0)
                check_closure_param(cls, 0, elem, method, "List")
                check_closure_ret(cls, TYPE_BOOL, method, "List")
                return obj_t
            }
            if method == "contains" || method == "index_of" {
                let need = tc_list_scan_elem_need(elem)
                if need.len() > 0 { return tc_refuse_list_scan(node, obj_t, need, method) }
                check_builtin_arg(method, 0, elem, args_sl, "List")
                if method == "index_of" { return make_option_type(TYPE_INT) }
                return TYPE_BOOL
            }
            if method == "is_empty" { return TYPE_BOOL }
            if method == "any" || method == "all" {
                let cls = closure_arg_at(args_sl, 0)
                check_closure_param(cls, 0, elem, method, "List")
                check_closure_ret(cls, TYPE_BOOL, method, "List")
                return TYPE_BOOL
            }
            if method == "find" {
                let cls = closure_arg_at(args_sl, 0)
                check_closure_param(cls, 0, elem, method, "List")
                check_closure_ret(cls, TYPE_BOOL, method, "List")
                return make_option_type(elem)
            }
            if method == "fold" {
                if check_builtin_arity("List", method, 2, args_sl, node) == 0 {
                    // Still infer whatever WAS written, so a mistake inside the accumulator
                    // is reported on its own terms rather than swallowed by the arity report.
                    if args_sl != -1 && sublist_length(args_sl) >= 1 {
                        let _ = infer_type(sublist_get(args_sl, 0))
                    }
                    return tc_error_recovery_tid()
                }
                let acc_t = infer_type(sublist_get(args_sl, 0))
                let cls = sublist_get(args_sl, 1)
                check_closure_param(cls, 0, acc_t, method, "List")
                check_closure_param(cls, 1, elem, method, "List")
                check_closure_ret(cls, acc_t, method, "List")
                return acc_t
            }
        }

        // A user poly-impl method on a List receiver — the canonical
        // `impl[T] Trait[T] for List[T]` form. Placed AFTER the builtin List
        // block so every builtin method has already returned (builtins win,
        // untouched). Resolve the sole owning trait's fnsig and return its
        // `-> T` return type with the impl binder substituted by the receiver's
        // element tid, so the method-call node memoizes a concrete tid instead
        // of TYPE_UNKNOWN. Only the canonical single-binder shape registered in
        // tc_poly_list_impl_node; any other shape leaves `im == -1` and this
        // block does nothing, falling through to today's arg-inference loop and
        // TYPE_UNKNOWN — no path regresses. A sealed qualified call names the
        // sealed owner, so a user impl never answers it.
        if obj_k == TyKind.List && qualified == -1 {
            let sole_trait = tc_method_trait_names("List", method)
            if sole_trait != "" && tc_method_trait_count("List", method) == 1 {
                let sig_name = tc_impl_method_stem("List", sole_trait, method)
                let sig = lookup_fnsig(sig_name)
                if sig != -1 {
                    let im = tc_poly_list_impl_node.get(sig_name) ?? -1
                    // The registry only ever holds nodes that passed the
                    // canonical single-binder gate at registration, so binders
                    // is a length-1 sublist here. Re-check defensively so a
                    // future gate relaxation that forgets this reader degrades
                    // to the fall-through TYPE_UNKNOWN path instead of crashing
                    // sublist_get on a -1 / empty binder list.
                    let im_binders = if im != -1 { node_impl_binders(im) } else { -1 }
                    if im != -1 && im_binders != -1 && sublist_length(im_binders) == 1 {
                        let elem = ty_pool.get(obj_t).unwrap().inner1
                        let binder_node = sublist_get(im_binders, 0)
                        let binder = node_name(binder_node)
                        let mut binds: Map[Str, Int] = Map()
                        binds.insert(binder, elem)
                        binds.insert(tc_binder_key(binder_node, binder), elem)
                        // binds must exist before this call: a bare-literal argument whose
                        // static param type is the impl's own Typevar(T) needs the RECEIVER's
                        // concrete element type as its hint, not the raw unsubstituted binder.
                        let _ = check_arg_shapes_with_binds("List.{method}", sig, args_sl, 1, node, binds)
                        let raw_ret = fnsig_pool.get(sig).unwrap().ret
                        return substitute_typevar_tid(raw_ret, binds)
                    }
                }
            }
        }

        // The explicit forms of a scalar's `==` and `<`, against one value of the receiver's
        // own type, with the Ordering the prelude declares.
        if method == "eq" && tc_scalar_has_eq(obj_k) {
            check_builtin_arg(method, 0, obj_t, args_sl, tc_builtin_recv_label(obj_k))
            tc_warn_negative_zero_method(obj_t, recv_node, args_sl, NegativeZeroFamily.TrueForBoth)
            return TYPE_BOOL
        }
        if method == "cmp" && tc_scalar_has_ord(obj_k) {
            check_builtin_arg(method, 0, obj_t, args_sl, tc_builtin_recv_label(obj_k))
            tc_warn_negative_zero_method(obj_t, recv_node, args_sl, NegativeZeroFamily.SameForBoth)
            return tc_compiler_known_tid("Ordering")
        }

        if obj_k == TyKind.Str {
            if method == "len" { return TYPE_INT }
            // The one Ptr-producing method the spec states outright AND codegen agrees with:
            // `fn as_cstr(self: Str) -> Ptr[U8]` (sections/07_trust_modules_metadata.md:221)
            // against `blink_strdup(s)` with expr_result_type = pointer (codegen_methods.bl:857).
            // Its partner `.to_str(self: Ptr[U8]) -> Option[Str]` (:222) is in the TyKind.Ptr
            // block below, so the documented round trip now types end to end.
            if method == "as_cstr" { return make_ptr_type(TYPE_U8) }
            if method == "contains" || method == "starts_with" || method == "ends_with" {
                check_builtin_arg(method, 0, TYPE_STR, args_sl, "Str")
                return TYPE_BOOL
            }
            if method == "replace" {
                check_builtin_arg(method, 0, TYPE_STR, args_sl, "Str")
                check_builtin_arg(method, 1, TYPE_STR, args_sl, "Str")
                return TYPE_STR
            }
            if method == "concat" {
                check_builtin_arg(method, 0, TYPE_STR, args_sl, "Str")
                return TYPE_STR
            }
            if method == "substring" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "Str")
                check_builtin_arg(method, 1, TYPE_INT, args_sl, "Str")
                return TYPE_STR
            }
            if method == "trim" || method == "trim_right" || method == "trim_left" || method == "to_lower" || method == "to_upper" {
                return TYPE_STR
            }
            if method == "byte_len" { return TYPE_INT }
            if method == "byte_at" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "Str")
                return TYPE_U8
            }
            if method == "byte_slice" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "Str")
                check_builtin_arg(method, 1, TYPE_INT, args_sl, "Str")
                return TYPE_STR
            }
            if method == "byte_index_of" {
                check_builtin_arg(method, 0, TYPE_STR, args_sl, "Str")
                check_builtin_arg(method, 1, TYPE_INT, args_sl, "Str")
                return make_option_type(TYPE_INT)
            }
            if method == "index_of" {
                check_builtin_arg(method, 0, TYPE_STR, args_sl, "Str")
                return make_option_type(TYPE_INT)
            }
            if method == "to_int" { return TYPE_INT }
            if method == "char_at" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "Str")
                return make_option_type(TYPE_CHAR)
            }
            if method == "split" {
                check_builtin_arg(method, 0, TYPE_STR, args_sl, "Str")
                return make_list_type(TYPE_STR)
            }
            if method == "lines" { return make_list_type(TYPE_STR) }
            if method == "parse_float" { return make_result_type(TYPE_FLOAT, tc_conversion_error_type()) }
            if method == "parse_int" { return make_result_type(TYPE_INT, tc_conversion_error_type()) }
            if method == "is_empty" { return TYPE_BOOL }
        }

        if obj_k == TyKind.Int {
            if method == "to_str" { return TYPE_STR }
            // The two conversions codegen implements for an Int receiver:
            // `to_string` (codegen_methods.bl:3879, the int branch) and `to_float`
            // (`:3777`, gated on the Int type). Note `to_string` is NOT answered for a
            // sized-int or Bool receiver, and `to_float` is NOT answered for a Str one — codegen
            // implements none of those three, so answering them here would invent surface.
            if method == "to_string" { return TYPE_STR }
            if method == "to_float" { return TYPE_FLOAT }
            if method == "abs" || method == "min" || method == "max" { return TYPE_INT }
            if method == "to_i8" { return TYPE_I8 }
            if method == "to_i16" { return TYPE_I16 }
            if method == "to_i32" { return TYPE_I32 }
            if method == "to_u8" { return TYPE_U8 }
            if method == "to_u16" { return TYPE_U16 }
            if method == "to_u32" { return TYPE_U32 }
            if method == "to_u64" { return TYPE_U64 }
        }

        // A Float receiver's `to_int` is answered here rather than in the Str block above;
        // codegen implements it at codegen_methods.bl:3782, gated on the Float type.
        // `ieee_eq` is the IEEE 754 escape from Float's total order (sections/03_types.md
        // "Float Total Ordering"). `to_bits` and `is_sign_negative` read the bit pattern
        // (sections/03_types.md "Float Bits").
        if obj_k == TyKind.Float {
            if method == "to_string" { return TYPE_STR }
            if method == "to_int" { return TYPE_INT }
            if method == "to_bits" { return TYPE_U64 }
            if method == "is_sign_negative" { return TYPE_BOOL }
            if method == "ieee_eq" {
                check_builtin_arg(method, 0, TYPE_FLOAT, args_sl, "Float")
                tc_warn_negative_zero_method(obj_t, recv_node, args_sl, NegativeZeroFamily.TrueForBoth)
                return TYPE_BOOL
            }
        }

        let is_sized_obj = is_sized_int(obj_k)
        if is_sized_obj {
            if method == "to_int" { return TYPE_INT }
            if method == "to_i8" { return TYPE_I8 }
            if method == "to_i16" { return TYPE_I16 }
            if method == "to_i32" { return TYPE_I32 }
            if method == "to_u8" { return TYPE_U8 }
            if method == "to_u16" { return TYPE_U16 }
            if method == "to_u32" { return TYPE_U32 }
            if method == "to_u64" { return TYPE_U64 }
            if method == "wrapping_add" || method == "wrapping_sub" || method == "wrapping_mul" {
                if args_sl != -1 && sublist_length(args_sl) == 1 { tc_literal_takes(sublist_get(args_sl, 0), obj_t) }
                return obj_t
            }
        }

        if obj_k == TyKind.Char {
            if method == "to_int" { return TYPE_INT }
            if method == "to_str" { return TYPE_STR }
        }

        if obj_k == TyKind.Option {
            if method == "unwrap" { return ty_pool.get(obj_t).unwrap().inner1 }
            if method == "is_some" || method == "is_none" { return TYPE_BOOL }
        }

        if obj_k == TyKind.Result {
            if method == "unwrap" { return ty_pool.get(obj_t).unwrap().inner1 }
            if method == "unwrap_err" { return ty_pool.get(obj_t).unwrap().inner2 }
            if method == "is_ok" || method == "is_err" { return TYPE_BOOL }
        }

        if obj_k == TyKind.Map {
            let key_t = ty_pool.get(obj_t).unwrap().inner1
            let val_t = ty_pool.get(obj_t).unwrap().inner2
            if method == "len" { return TYPE_INT }
            if method == "contains_key" || method == "contains" {
                check_builtin_arg(method, 0, key_t, args_sl, "Map")
                return TYPE_BOOL
            }
            // MapOps gives `remove` the value it took out, not a presence test: a Bool answer
            // throws the value away and leaves the caller a second lookup to get it back.
            if method == "remove" {
                check_builtin_arg(method, 0, key_t, args_sl, "Map")
                return make_option_type(val_t)
            }
            if method == "insert" {
                check_builtin_arg(method, 0, key_t, args_sl, "Map")
                check_builtin_arg(method, 1, val_t, args_sl, "Map")
                return TYPE_VOID
            }
            if method == "clear" { return TYPE_VOID }
            // Codegen emits it for a Map exactly as it does for the other four containers
            // (src/codegen_methods.bl), and List/Str/Set/Bytes/StringBuilder all answer it here.
            if method == "is_empty" { return TYPE_BOOL }
            if method == "get" {
                check_builtin_arg(method, 0, key_t, args_sl, "Map")
                return make_option_type(val_t)
            }
            if method == "keys" { return make_list_type(key_t) }
            if method == "values" { return make_list_type(val_t) }
            if method == "entries" { return make_list_type(make_tuple_type([key_t, val_t])) }
        }

        if obj_k == TyKind.Set {
            let elem = ty_pool.get(obj_t).unwrap().inner1
            if method == "len" { return TYPE_INT }
            if method == "is_empty" { return TYPE_BOOL }
            if method == "contains" || method == "insert" || method == "remove" {
                check_builtin_arg(method, 0, elem, args_sl, "Set")
                return TYPE_BOOL
            }
            if method == "union" {
                check_builtin_arg(method, 0, obj_t, args_sl, "Set")
                return obj_t
            }
        }

        // Channel had no arm at all, so `.recv()` answered Unknown even for an annotated
        // `Channel[Str]` — nothing compared its result against a declared type. `send` is the
        // constraining use, exactly as `insert` is for Map/Set, so it goes through the same
        // check_builtin_arg.
        if obj_k == TyKind.Channel {
            let elem = ty_pool.get(tc_resolve(obj_t)).unwrap().inner1
            if method == "send" {
                check_builtin_arg(method, 0, elem, args_sl, "Channel")
                return TYPE_VOID
            }
            // An Option: None only once the channel is closed and drained, so closed is
            // never a value of the element (sections/04_effects.md §4.13).
            //
            // An element nothing has pinned answers Unknown rather than an Option over the
            // bare α, so the read is not what reports the under-determined element.
            if method == "recv" {
                let r = tc_resolve(elem)
                if tc_tid_has_unbound_metavar(r) != 0 { return -1 }
                return make_option_type(r)
            }
            if method == "close" { return TYPE_VOID }
        }

        if obj_k == TyKind.Bytes {
            if method == "len" { return TYPE_INT }
            if method == "get" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "Bytes")
                return make_option_type(TYPE_INT)
            }
            if method == "is_empty" { return TYPE_BOOL }
            if method == "push" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "Bytes")
                return TYPE_VOID
            }
            if method == "set" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "Bytes")
                check_builtin_arg(method, 1, TYPE_INT, args_sl, "Bytes")
                return TYPE_VOID
            }
            if method == "slice" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "Bytes")
                check_builtin_arg(method, 1, TYPE_INT, args_sl, "Bytes")
                return obj_t
            }
            if method == "concat" {
                check_builtin_arg(method, 0, obj_t, args_sl, "Bytes")
                return obj_t
            }
            if method == "to_str" { return make_result_type(TYPE_STR, TYPE_STR) }
            if method == "to_hex" { return TYPE_STR }
            if method == "read_u16_be" || method == "read_u32_be" || method == "read_i32_be" || method == "read_i64_be" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "Bytes")
                return make_result_type(TYPE_INT, TYPE_STR)
            }
            if method == "read_u16_le" || method == "read_u32_le" || method == "read_i32_le" || method == "read_i64_le" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "Bytes")
                return make_result_type(TYPE_INT, TYPE_STR)
            }
            if method == "write_u16_be" || method == "write_u32_be" || method == "write_i32_be" || method == "write_i64_be" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "Bytes")
                return TYPE_VOID
            }
            if method == "write_u16_le" || method == "write_u32_le" || method == "write_i32_le" || method == "write_i64_le" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "Bytes")
                return TYPE_VOID
            }
            // set_*(off, v) writes IN PLACE at a bounds-checked offset and reports the
            // bound as an Err, unlike the appending write_* family above.
            if method == "set_u16_be" || method == "set_u32_be" || method == "set_u64_be" || method == "set_i16_be" || method == "set_i32_be" || method == "set_i64_be" || method == "set_u16_le" || method == "set_u32_le" || method == "set_u64_le" || method == "set_i16_le" || method == "set_i32_le" || method == "set_i64_le" {
                // Arity before the per-argument types: codegen reads argument 1 unconditionally,
                // so a short call panics the compiler rather than erroring.
                check_builtin_arity("Bytes", method, 2, args_sl, node)
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "Bytes")
                check_builtin_arg(method, 1, TYPE_INT, args_sl, "Bytes")
                return make_result_type(TYPE_VOID, TYPE_STR)
            }
            if method == "with_ptr" {
                if args_sl == -1 || sublist_length(args_sl) < 1 { return TYPE_VOID }
                let cls_node = sublist_get(args_sl, 0)
                if node_kind(cls_node) != NodeKind.Closure { return TYPE_VOID }
                let ret_str = node_return_type(cls_node)
                // `-> T` is not the only channel: the unascribed spelling — the one the spec
                // writes and the one the corpus uses — must NOT type as Void, since Void is not
                // inert (`n + 1` is E0301-class TypeError, `"{n}"` is MissingDisplayImpl).
                //
                // DECLINE, rather than answer. The body's own tail is what types this call, and
                // it is not memoized until tc_check_body walks the closure one step later — so
                // the honest answer here is "not yet known", and the LetBinding recovery
                // fills it in from the body once the walk has run. Re-inferring the body HERE
                // instead would double-report every diagnostic inside it.
                if ret_str == "" { return -1 }
                let rt = resolve_type_name(ret_str)
                if rt == -1 { return TYPE_VOID }
                return rt
            }
        }

        // The StringBuilder surface, mirroring emit_sb_method
        // (src/codegen_methods.bl:2017) method-for-method — that function IS the
        // definition of what a StringBuilder can do, and a method typed here that it
        // cannot emit would trade a missing type for a link error.
        //
        // `write` deliberately takes ANY argument: codegen dispatches on the arg's ct
        // (blink_sb_write / _write_int / _write_float / _write_bool) and interpolates an
        // InterpString part-by-part, so constraining it to Str here would reject
        // `buf.write("{n}")` and `buf.write(count)`, both of which lower correctly today.
        // `write_char` is signed `(self, c: Char)` in sections/03_types.md, and codegen
        // converts that Char to text, so any other argument is a type error here.
        if obj_k == TyKind.StringBuilder {
            if method == "write_char" {
                check_builtin_arg(method, 0, TYPE_CHAR, args_sl, "StringBuilder")
                return TYPE_VOID
            }
            if method == "write" {
                // Not checked, but still INFERRED: the shared fall-through at the end of
                // this arm is what surfaces E0522 for a nested call in an argument, and
                // returning early here would skip it.
                if args_sl != -1 && sublist_length(args_sl) > 0 {
                    let sb_arg = sublist_get(args_sl, 0)
                    tc_raw_reject_display_sink(sb_arg, infer_type(sb_arg))
                }
                return TYPE_VOID
            }
            if method == "clear" { return TYPE_VOID }
            if method == "to_str" { return TYPE_STR }
            if method == "len" || method == "capacity" { return TYPE_INT }
            if method == "is_empty" { return TYPE_BOOL }
        }

        // Ptr methods typed here per sections/07_trust_modules_metadata.md: `is_null` and
        // `to_str` are codegen-authoritative; `addr` is the integer address (:220);
        // `deref` (:219) is signed as the pointee T so a sized pointee cannot launder into
        // an Int binding; `offset` preserves the pointee.
        if obj_k == TyKind.Ptr {
            if method == "is_null" { return TYPE_BOOL }
            // `.write(v)` stores through the pointer and answers unit. The stored value is
            // inferred but NOT checked against the pointee — that check still does not exist —
            // and an unchecked argument is a smaller gap than a call that carries no type at
            // all, which is what leaving this arm out meant.
            if method == "write" {
                if args_sl != -1 && sublist_length(args_sl) >= 1 {
                    infer_type(sublist_get(args_sl, 0))
                }
                return TYPE_VOID
            }
            // `addr` is always the integer address (codegen emits `(int64_t)(intptr_t)…`).
            if method == "addr" { return TYPE_INT }
            // `deref` reads the pointee, so its result IS the pointee type T
            // (sections/07_trust_modules_metadata.md:219, `fn deref(self) -> T`).
            // Signing it closes the fail-open where an unsigned result skipped the
            // let compare and laundered a sized-int pointee (Ptr[U8]) into an Int
            // binding; the honest form is `p.deref().to_int()`.
            if method == "deref" { return ty_pool.get(obj_t).unwrap().inner1 }
            // Pointer arithmetic, so the pointee is PRESERVED — `obj_t` itself, not its child
            // (sections/07_trust_modules_metadata.md:481).
            if method == "offset" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "Ptr")
                // Both rules are reported HERE, at the site that types the method: codegen
                // reported the stride rule as an ICE, which named a program the user wrote
                // wrong an internal compiler error.
                if tc_ptr_offset_stride_known(obj_t) == 0 {
                    diag_error_at("FfiOffsetUnknownStride", FFI_OFFSET_UNKNOWN_STRIDE,
                        "`offset` needs a pointee whose size is known at compile time, and {type_to_str(obj_t)} does not point at an `@ffi.struct`",
                        node,
                        "annotate the pointee type `@ffi.struct`, or walk the bytes through a `Bytes` value")
                } else if tc_ptr_reads_singleton_alloc(recv_node) != 0 {
                    // Only once the stride is known: a pointee with no stride is the more
                    // basic error, and two reports for one call name one fault twice.
                    diag_error_at("FfiOffsetOnSingleton", FFI_OFFSET_ON_SINGLETON,
                        "`offset` on a pointer from `scope.alloc()`, which allocates a single cell",
                        node,
                        "allocate an array with `scope.alloc_n(n)` when the pointer is stepped")
                }
                return obj_t
            }
            if method == "to_str" { return make_option_type(TYPE_STR) }
        }

        // Enumerated against codegen's emit_template_method
        // (src/codegen_methods.bl:2108) method-for-method: codegen has exactly these seven
        // arms and is_builtin_method lists exactly the same seven. A method typed here that
        // codegen cannot emit would trade a missing type for a link error.
        //
        // The spec (sections/03b_contracts.md:428) spells the surface as two FIELDS —
        // `parts: List[Str]` and `values: List[Any]` — while the compiler implements a
        // method API, because Blink has no `Any` and so cannot express `values`. `parts()`
        // is the one member both agree on, and it is `List[Str]` in both. The four typed
        // getters plus `type_tag` are how the compiler answers what `values` would have,
        // and their types come from codegen's own emission: `type_tag` reads the tag list
        // as an Int, `get_float` memcpys a double, `get_str` yields the interned Str.
        // Reconciling the two surfaces is a spec question, filed separately.
        if obj_k == TyKind.Template {
            if method == "parts" { return make_list_type(TYPE_STR) }
            if method == "count" { return TYPE_INT }
            if method == "type_tag" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "Template")
                return TYPE_INT
            }
            if method == "get_int" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "Template")
                return TYPE_INT
            }
            if method == "get_float" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "Template")
                return TYPE_FLOAT
            }
            if method == "get_bool" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "Template")
                return TYPE_BOOL
            }
            if method == "get_str" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "Template")
                return TYPE_STR
            }
        }

        // The four ffi.scope() allocators, against the operation table at
        // sections/07_trust_modules_metadata.md:309-313 and codegen's own emitter block
        // (codegen_methods.bl:4886), which sets expr_result_type = pointer for all four.
        //
        // Two of the four are fully signable: `cstr` is monomorphic
        // (`fn cstr(self, s: Str) -> Ptr[U8]`, :312) and matches the
        // `Str.as_cstr()` signature above; `take` is the IDENTITY on its argument's type
        // (`fn take[T](self, ptr: Ptr[T]) -> Ptr[T]`, :313), so it needs the argument's tid
        // and no inference at all.
        //
        // `alloc` / `alloc_n` cannot infer a pointee of their own. The spec writes it at the
        // call site — `scope.alloc[T]()` (sections/07_trust_modules_metadata.md:311),
        // `scope.alloc_n[T](n)` (:564) — but that spelling does not parse as a method call:
        // parser.bl:2896 accepts a `[` after a member name for the one hard-coded
        // `channel.new[T]` form and nothing else, so the type argument never reaches the AST.
        // What is left is the type expected of the call, which tc_ffi_alloc_hint_tid reads;
        // without one the pointee is Void, which is what codegen allocates for.
        // Codegen sizes the allocation from its own let annotation (resolve_ptr_inner_c), a
        // narrower channel than this one, so the two agree on a let and only this one answers
        // for an argument or a return. Their argument IS checked: alloc_n takes a count, and
        // passing a Str for it silently calloc'd a garbage size and returned NULL.
        if obj_k == TyKind.FfiScope {
            if method == "cstr" {
                check_builtin_arg(method, 0, TYPE_STR, args_sl, "scope")
                return make_ptr_type(TYPE_U8)
            }
            if method == "take" {
                if check_builtin_arity("scope", method, 1, args_sl, node) == 0 { return tc_error_recovery_tid() }
                let taken_t = infer_type(sublist_get(args_sl, 0))
                let taken_k = type_kind(resolve_alias_tid(taken_t))
                if taken_k == TyKind.Ptr { return taken_t }
                // An unresolved argument keeps the unresolved answer. `scope.take(scope.alloc())`
                // is the corpus's own spelling, and with nothing expecting a pointer around it
                // the inner allocator has no type to give (above).
                if taken_k == TyKind.Unknown || taken_k == TyKind.Typevar { return -1 }
                tc_error_at("argument 1 of `scope.take` expects Ptr[T], got {type_to_str(taken_t)}", sublist_get(args_sl, 0))
                return tc_error_recovery_tid()
            }
            if method == "alloc_n" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "scope")
                if node_type_params(node) != -1 { return tc_ptr_from_type_arg(node, "scope.alloc_n") }
                return tc_ffi_alloc_hint_tid(node)
            }
            if method == "alloc" {
                if node_type_params(node) != -1 { return tc_ptr_from_type_arg(node, "scope.alloc") }
                return tc_ffi_alloc_hint_tid(node)
            }
        }

        // Every arm a sealed ops trait owns is above. What follows answers from user impls,
        // bounds and names, none of which a call naming the sealed trait can reach.
        if qualified != -1 { return tc_method_call_unanswered(node, method, obj_t, args_sl) }

        // A method call on a BOUNDED type parameter (`fn show[T: Display](x: T) { x.fmt(sb) }`).
        // The bound is what licenses the call, so it is also what answers it: the trait's own
        // declared signature. An unbounded parameter licenses nothing and reaches no arm.
        if obj_k == TyKind.Typevar {
            let tv_traits = tc_tparam_bound_traits(type_to_str(obj_t))
            if tv_traits != "" {
                // The sealed synthesized `display()`, which has no declared signature anywhere
                // — the same arm the struct path carries below.
                if method == "display" && tc_pipe_has(tv_traits, "Display") != 0 { return TYPE_STR }
                let tv_name = type_to_str(obj_t)
                let mut found = -1
                let mut owners: List[Str] = []
                let mut tvi = 0
                while tvi < tc_tmsig_pool.len() {
                    let tm = tc_tmsig_pool.get(tvi).unwrap()
                    if tm.method == method && tc_pipe_has(tv_traits, tm.trait_name) != 0 && !owners.contains(tm.trait_name) {
                        if found < 0 { found = tvi }
                        owners.push(tm.trait_name)
                    }
                    tvi = tvi + 1
                }
                // §3c rule 3 holds for a bound as for a type: two traits the bound guarantees
                // that both declare the name leave the call without one answer.
                if owners.len() >= 2 {
                    diag_error_at("AmbiguousMethodCall", AMBIGUOUS_METHOD_CALL, "ambiguous method call: `.{method}` is defined in multiple traits that bound type parameter `{tv_name}` ({tc_traits_shown(owners.join(" and "))})", node, "use a qualified call to disambiguate, e.g. `Trait.{method}(receiver)`")
                    return tc_error_recovery_tid()
                }
                if found >= 0 {
                    let tm = tc_tmsig_pool.get(found).unwrap()
                    // Each instance picks its impl by the trait that declares the method: the
                    // type may hold another trait of one spelling with a method of this name.
                    nr_note_call_decl(node, tc_trait_method_decl(tm.trait_name, method))
                    let binds = tc_bound_call_binds(obj_t, found)
                    let _ = check_arg_shapes_with_binds("{tc_trait_shown(tm.trait_name)}.{method}", tm.sig, args_sl, 1, node, binds)
                    return substitute_typevar_tid(tm.ret_tid, binds)
                }
                // The bound is the whole licence, so a method none of its traits declares is
                // refused here, in the generic body, not at each instance. Only a guarantee
                // set whose method lists are all known can say a method is absent.
                if tc_guarantee_lists_all_methods(tv_traits) && tc_pipe_has(tc_guarantee_methods(tv_traits), method) == 0 {
                    tc_unresolved_method_hard.insert(node, 1)
                    diag_error_at("UnresolvedMethod", UNRESOLVED_METHOD, "type parameter `{tv_name}` is bounded by {tc_traits_shown(tc_pipe_joined(tv_traits))}, and none of them declares method `{method}`", node, "correct the method name, or add a bound whose trait declares `{method}`")
                    return tc_error_recovery_tid()
                }
            }
        }

        // A user `impl Trait for Str` / `for Float` / `for Int` puts a method on a BUILTIN
        // receiver. The trait-qualified fnsig below the struct gate answers those for a struct
        // and an enum only, so the same lookup runs here for every other receiver kind — which
        // is what codegen already does (src/codegen_methods.bl builtin_receiver_type_name +
        // lookup_impl_method), and it does it before its own `.into()` arm, so this sits above
        // the one below for the same reason. Under the builtin arms above, so a declared builtin
        // method still wins over a same-named user impl.
        if obj_k != TyKind.Struct && obj_k != TyKind.Enum {
            let bname = tc_builtin_receiver_name(obj_t)
            if bname != "" {
                let btrait = tc_method_trait_names(bname, method)
                if btrait != "" {
                    let bsig = lookup_fnsig(tc_impl_method_stem(bname, btrait, method))
                    if bsig != -1 {
                        let _ = check_arg_shapes("{bname}.{method}", bsig, node_args(node), 1, node)
                        // Which declaration this call reached. Phase 1 could not say: it has
                        // no receiver type, and the receiver is the only thing that tells two
                        // impls of one method name apart.
                        nr_note_call_decl(node, nr_impl_method_decl(bname, method))
                        return fnsig_pool.get(bsig).unwrap().ret
                    }
                }
            }
        }

        if obj_k == TyKind.Struct || obj_k == TyKind.Enum {
            let tname = ty_pool.get(obj_t).unwrap().name
            // §3c rule-3: an unqualified call to a method defined by two
            // or more traits this type implements is ambiguous. Reject before
            // resolving — the qualified call `Trait.method(receiver)` selects one.
            if tc_method_trait_count(tname, method) >= 2 {
                let names = tc_traits_shown(tc_method_trait_names(tname, method))
                // The program may not spell BlockHandler at all: `impl Closeable` provides it
                // (sections/04_effects.md §4.7.2), so the note names the impl that was written.
                let mut notes: List[Str] = []
                if tc_type_writes_trait_method(tname, method, "BlockHandler") && tc_type_writes_trait_method(tname, "close", "Closeable") {
                    notes.push("`impl Closeable for {tname}` provides `BlockHandler` for `{tname}`")
                }
                diag_error_at_notes("AmbiguousMethodCall", AMBIGUOUS_METHOD_CALL, "ambiguous method call: `.{method}` is defined in multiple traits implemented by {tname} ({names})", node, "use a qualified call to disambiguate, e.g. `Trait.{method}(receiver)`", notes)
                return tc_error_recovery_tid()
            }
            // Resolve through the trait-qualified fnsig key. From/TryFrom register
            // one key per impl (handled via the builtin-method path
            // below), so a bare-key fallback keeps any non-trait inherent sig.
            let sole_trait = tc_method_trait_names(tname, method)
            let sig_name = if sole_trait != "" { tc_impl_method_stem(tname, sole_trait, method) } else { "{tname}_{method}" }
            let sig = lookup_fnsig(sig_name)
            if sig != -1 {
                // Before the argument check: an argument typed by an impl binder takes the
                // receiver's type argument as its hint, as a List poly-impl argument does.
                let ibinds = tc_impl_binds_at_call(sig, obj_t)
                tc_check_impl_bounds_at_call(fnsig_pool.get(sig).unwrap().decl, ibinds, node)
                if sole_trait == "" && fnsig_pool.get(sig).unwrap().decl < 0 {
                    tc_refuse_derived_method_at(obj_t, method, node)
                }
                if node_type_params(node) != -1 {
                    nr_note_call_decl(node, fnsig_pool.get(sig).unwrap().decl)
                    return tc_call_with_type_args("{tname}.{method}", sig, node, 1, ibinds)
                }
                let mut mtids = check_arg_shapes_with_binds("{tname}.{method}", sig, node_args(node), 1, node, ibinds)
                // Which declaration this call reached. The signature answers, because the
                // receiver picked the signature and the receiver is the only thing that
                // tells two impls of one method name apart.
                nr_note_call_decl(node, fnsig_pool.get(sig).unwrap().decl)
                // A method's OWN bounded type param (`fn combine[U: Add](self, ...)`)
                // registers into the same fnsig with the same parallel name+bound side-
                // tables, so enforce it at the call the same way (E0306). self_offset=1:
                // self is param 0 (from the receiver), call arg `pi` ↔ fnsig param `1+pi`,
                // so only the method's own params bind — impl-level `where`-bounds stay
                // with tc_impl_where_bounds_hold. Additive: the return path is untouched.
                let mfs = fnsig_pool.get(sig).unwrap()
                if mfs.type_params_count > 0 {
                    let mbinds = build_typevar_binds(sig, mtids, 1)
                    tc_check_bounds_for_binds(sig, mbinds, node)
                    // A method declaring its own type parameter has the same closure-argument
                    // ordering problem a free function does, and the receiver does not answer it.
                    mtids = tc_seed_closure_args_with_binds(sig, node_args(node), mtids, 1, mbinds)
                }
                // A type parameter the METHOD declares is chosen by the call, so the call's
                // type is the declared return with that choice applied. Gated on the
                // declaration's own binders and not on the signature's count, because an
                // impl over a generic type puts the impl's binders in the same count and
                // those are answered by the receiver, not by the arguments.
                if tc_decl_has_own_type_params(mfs.decl) != 0 {
                    return substitute_typevar_tid(instantiate_return_type(sig, mtids, node, 1), ibinds)
                }
                // A return declared over the receiver type's own binders, as a derived clone
                // is, stands for the receiver's instance. A no-op for a monomorphic receiver.
                return substitute_typevar_tid(tc_member_tid_at_instance(mfs.ret, obj_t), ibinds)
            }
            // Instant's two CODEGEN-ONLY methods. Four of its six are declared in
            // lib/std/time.bl:16-19 and so resolve through the fnsig lookup just above;
            // `elapsed` and `to_rfc3339` have no Blink declaration anywhere —
            // codegen_methods.bl:4695,:4716 emit `blink_Instant_elapsed` /
            // `blink_Instant_to_rfc3339` directly — so without this arm there is no fnsig and
            // the block falls through to TYPE_UNKNOWN. Both names are in is_builtin_method
            // (:6429, :6432), so tc_method_resolvable_on_type answers yes and E0505 would
            // never fire either: an allow-list with nothing behind it.
            //
            // sections/03_types.md:566,:569 pins both signatures — `elapsed(self) -> Duration
            // ! Time.Read` and `to_rfc3339(self) -> Str` — so the return types and the zero
            // arity are the spec's, not a choice made here.
            //
            // DELIBERATELY BELOW the fnsig lookup, not above it: a real declaration must always
            // win, both so a future lib/std/time.bl `Instant_elapsed` supersedes this without
            // touching the arm, and so the four declared siblings keep resolving through their
            // own signatures. Keyed on `tname` for the same reason `elapsed` is not keyed on the
            // name alone: sections/06_tooling.md:923 gives the mock clock handle its own
            // `elapsed(self) -> List[Duration]`.
            if tname == "Instant" && (method == "elapsed" || method == "to_rfc3339") {
                let inst_args = node_args(node)
                let inst_got = if inst_args != -1 { sublist_length(inst_args) } else { 0 }
                // Codegen never reads the argument list for these two, so an extra argument was
                // silently discarded and no later phase would ever have reported it.
                if inst_got != 0 {
                    tc_error_at("method `Instant.{method}` expects 0 argument(s), got {inst_got}", node)
                }
                if method == "to_rfc3339" { return TYPE_STR }
                // The Duration tid, minted only if lib/std/time.bl is absent from the program —
                // lookup runs first inside ensure_runtime_struct_type, so the declared tid wins
                // and `.to_ms()` on the result still resolves through `Duration_to_ms`. Same
                // idempotent-mint reasoning as the Instant tid at the time.read() arm.
                return runtime_duration_tid()
            }
            // The synthesized sealed Display.display() has no user-written fnsig; it
            // always returns Str.
            if method == "display" && tc_type_has_display_impl(tname) != 0 {
                return TYPE_STR
            }
            // Synthesized @derive(Eq)/@derive(Ord) methods have no user
            // fnsig. eq -> Bool, cmp -> Ordering. (User `impl Eq/Ord` resolves
            // through the trait-qualified fnsig above; this is the derive path.)
            if method == "eq" && tc_type_has_eq_impl(tname) != 0 {
                return TYPE_BOOL
            }
            if method == "cmp" && tc_type_has_ord_impl(tname) != 0 {
                let ot = tc_compiler_known_tid("Ordering")
                if ot != -1 { return ot }
                // Ordering is declared in lib/std/traits.bl, so a program that never pulls
                // it in has no tid for it — the same reading register_derive_method_sigs
                // takes when it leaves `cmp` unregistered. An absence: the method's return
                // type is a type this program does not have.
                return -1
            }
            // A closure-typed struct field invoked like a method —
            // `route.callback(req)`, `srv.error_handler.on_error(req, msg)`, the
            // `handler: fn(Request) -> Response` field the spec puts inside `type Route`
            // (sections/04_effects.md:453). Without an arm for it, the call would fall
            // through to TYPE_UNKNOWN — and tc_method_resolvable_on_type clause (d)
            // fail-opens on is_callable_field_name, a GLOBAL name list, so E0505 would stay
            // silent too. Return type, arity and every argument type are all checked here:
            // the only callable shape in the language that otherwise would not be.
            //
            // Nothing new is inferred here. resolve_type_ann's Fn arm (:2756)
            // already gives every `fn(A) -> B` annotation a structured TyKind.Fn tid, and
            // register_struct_type stores it as the field's sf.type_id — so this is the
            // THIRD dispatch to tc_check_call_against_fn_tid, alongside the closure
            // VARIABLE (:9012) and the immediately-invoked closure literal (:9086),
            // against the same kind of tid.
            //
            // DELIBERATELY BELOW the fnsig lookup and above the E0505 gate, which mirrors
            // codegen exactly: codegen_methods.bl tries synthesized display, then
            // lookup_impl_method (:5323), then the closure field (:5333). A trait-impl
            // method of the same name therefore wins in BOTH phases; typechecking the
            // field instead would only move the miscompile.
            //
            // Guarded on TyKind.Struct — an enum has variants, not fields — and on the
            // field tid actually being a Fn, so a non-callable field of the same name as
            // some other struct's callable field still falls to E0505 as before.
            if obj_k == TyKind.Struct {
                let fld_tid = get_struct_field_tid(obj_t, method)
                if fld_tid != -1 && type_kind(fld_tid) == TyKind.Fn {
                    return tc_check_call_against_fn_tid(fld_tid, node_args(node), "closure field `{tname}.{method}`", node)
                }
            }
            // The receiver type is KNOWN, but no resolution path matched. Emit E0505
            // here (typecheck) instead of deferring to the codegen backstop — name
            // resolution belongs with E0504/E0506/E0507. Display rides along with its
            // actionable help; blinkc_main aborts on diag_count > 0 before codegen, so
            // the backstop never re-fires.
            if tc_method_resolvable_on_type(obj_k, tname, method) == 0 {
                let help = tc_unresolved_method_help(obj_k, tname, method)
                tc_unresolved_method_hard.insert(node, 1)
                tc_error_naming_types("UnresolvedMethod", UNRESOLVED_METHOD, "unresolved method `.{method}` on type {tname}", node, help, [obj_t])
                return tc_error_recovery_tid()
            }
        }

        // `.into()` is TARGET-directed: the conversion is chosen by the type the result flows
        // into, never by the receiver (sections/03_types.md From/Into). Codegen reads the
        // assignment target for it; the same answer is available here as the construction hint
        // the annotated binding installs. With no hint there is nothing to name, so decline.
        //
        // BELOW every impl lookup, because a declared `into` is an ordinary method: a receiver
        // that has one answers with the method's own return type, and only a receiver with none
        // is target-directed. The hint is the whole ENCLOSING target, so it is right only where
        // the target is the value's own slot; a list element or a carrier argument narrows it
        // elsewhere and is not this arm's to widen.
        if tc_is_into_method(method) {
            if tc_construct_hint < 0 { return -1 }
            // A generic callee's parameter (`take[U](b: Box[U])`) is filled by this call, so
            // its binders are metavariables the chosen impl solves.
            let target = tc_with_foreign_typevars_fresh(tc_construct_hint)
            let found = tc_conversion_impl_for("From", obj_t, target)
            if tc_defer_conversion(node, found, obj_t, target) { return target }
            let im = tc_judge_conversion(node, "`.into()`", "", "From", obj_t, target, found)
            if im >= 0 && tc_impl_is_poly_conversion(im) { tc_note_conversion_call(im, node, tc_conversion_match_binds(im, obj_t, target) ?? Map()) }
            return target
        }

        if obj_node != -1 && node_kind(obj_node) == NodeKind.Ident {
            let obj_written = node_name(obj_node)
            let obj_name = if nr_has_binding(obj_written) != 0 { obj_written } else { tc_static_qualifier(obj_written) }
            if obj_name == "Char" {
                if method == "from_code_point" {
                    return make_result_type(TYPE_CHAR, tc_conversion_error_type())
                }
            }
            if tc_is_float_from_bits(obj_name, method) {
                if check_builtin_arity("Float", method, 1, node_args(node), node) == 1 {
                    check_builtin_arg(method, 0, TYPE_U64, node_args(node), "Float")
                }
                return TYPE_FLOAT
            }
            // A user-effect operation call — `db.query(..)`, `storage.get_names()`. The
            // handle is not a value, so it never had a type and the receiver-typed arms
            // above cannot reach it; register_ue_op_sigs put the op's own signature under
            // `{handle}.{op}`. Both halves come from it: the return tid, and the argument
            // check, which without a signature compared against nothing and let a wrong
            // argument reach the C compiler.
            //
            // `nr_is_defined` gates it so a local binding that happens to share the handle's
            // spelling keeps its own type — that variable's receiver arm has already run and
            // fallen through only because the method was genuinely unresolved on it.
            if obj_name == "default" && nr_has_binding(obj_name) == 0 {
                let dflt_eff = tc_tid_handler_effect(tc_lookup_node_tid(obj_node))
                if dflt_eff != "" {
                    let dflt_ret = tc_infer_default_perform(node, dflt_eff, method)
                    if dflt_ret != -1 { return dflt_ret }
                }
            }
            if nr_is_defined(obj_name) == 0 && is_user_effect_handle_name(obj_name) != 0 {
                let ue_sig = lookup_fnsig("{obj_name}.{method}")
                if ue_sig != -1 {
                    nr_note_call_decl(node, fnsig_pool.get(ue_sig).unwrap().decl)
                    let _ = check_arg_shapes("{obj_name}.{method}", ue_sig, node_args(node), 0, node)
                    return fnsig_pool.get(ue_sig).unwrap().ret
                }
            }
            // Intrinsic time.* methods type even without `import std.time` (they emit as
            // codegen intrinsics like io.println). Typing read() as Instant lets the
            // comparison check (Stage 4) catch `time.read() > 0` at `blink check` instead
            // of leaking an Instant into invalid C.
            if is_import_module_name(obj_name) != 0 && nr_is_defined(obj_name) == 0 && is_intrinsic_method(obj_name, method) != 0 {
                if obj_name == "time" && method == "read" {
                    // std.time is a prelude module (compiler.bl:1357), so the declaration
                    // is normally present — but a silent fall-through when it is not would
                    // be the same fail-open erasure as the process builtins had. Mint it,
                    // so the type is right whether or not std.time is in scope.
                    return runtime_instant_tid()
                }
                if obj_name == "time" && method == "sleep" { return TYPE_VOID }
            }
            // Every other namespace intrinsic, from the table
            // register_ns_intrinsic_sigs put in fnsig_pool under `{namespace}.{method}`.
            // Not gated on is_import_module_name, unlike the time.* arms above: an
            // intrinsic needs no import (that is what makes it an intrinsic), and
            // is_intrinsic_method already restricts the namespace. nr_is_defined keeps a
            // local that shadows the namespace spelling on its own receiver-typed arm.
            if nr_is_defined(obj_name) == 0 && is_intrinsic_method(obj_name, method) != 0 {
                let nsi = lookup_fnsig("{obj_name}.{method}")
                if nsi != -1 {
                    let nsi_fs = fnsig_pool.get(nsi).unwrap()
                    // The count check inside is not a nicety: codegen indexes the argument
                    // list positionally and unconditionally, so `net.listen("localhost")`
                    // panics the compiler instead of reporting anything.
                    let _ = check_arg_shapes("{obj_name}.{method}", nsi, node_args(node), 0, node)
                    if type_kind(nsi_fs.ret) == TyKind.FfiScope && node != tc_with_resource_node {
                        tc_report_ffi_scope_value(node, tc_ffi_scope_binder)
                    }
                    return nsi_fs.ret
                }
                // The print family is listed by is_intrinsic_method and deliberately
                // left out of the fnsig table, because its PARAMETER is open — any
                // Display value — and a claim there could only be wrong. That covers
                // the parameter and not the return: each one emits a C statement and
                // yields no value, so `()` is the whole answer. Falling through instead
                // typed the call TYPE_UNKNOWN, which is compatible with everything, so
                // `let n: Int = io.println("a")` passed `blink check` and then failed in
                // codegen naming a type the value never had.
                if tc_io_is_print_method(obj_name, method) != 0 {
                    // Still infer the arguments: a mistake inside the call is reported
                    // by the arg's own inference, which the fall-through used to do.
                    let pf_args = node_args(node)
                    let mut pf_got = 0
                    if pf_args != -1 {
                        pf_got = sublist_length(pf_args)
                        let mut pf_i = 0
                        while pf_i < sublist_length(pf_args) {
                            let pf_arg = sublist_get(pf_args, pf_i)
                            tc_raw_reject_display_sink(pf_arg, infer_type(pf_arg))
                            pf_i = pf_i + 1
                        }
                    }
                    // Arity is checked here for the same reason the fnsig arm above
                    // checks it: each of these emits ONE C statement from argument 0,
                    // so a second argument is dropped along with its side effects and a
                    // missing one prints nothing. Only the PARAMETER TYPE is open.
                    if pf_got != 1 {
                        tc_error_at("function `{obj_name}.{method}` expects 1 argument(s), got {pf_got}", node)
                    }
                    return TYPE_VOID
                }
            }
            if is_import_module_name(obj_name) != 0 && nr_is_defined(obj_name) == 0 && is_intrinsic_method(obj_name, method) == 0 {
                if tc_call_is_skip_intrinsic(node) { return tc_check_skip_call(node) }
                let sig = tc_qualified_call_fnsig(node, method)
                if sig != -1 { return tc_check_free_call("{obj_name}.{method}", sig, node) }
            }
            // Every path below reads the receiver Ident as a TYPE NAME. A name with
            // a binding in scope is a value, and `value.method()` is an instance call no
            // matter what a same-spelled type could have offered — name resolution follows
            // scope. Without this gate `let foo = 42; foo.bar()` would silently adopt the
            // return type of a free fn named `foo_bar`, and `let Widget = 7; Widget.make(3)`
            // would type as Widget while emitting a call that ignored the binding.
            // Deliberately mirrors the `nr_is_defined(obj_name) == 0` gate the
            // module-qualified paths above already carry — but via the pure probe, so
            // asking does not mark a read.
            //
            // Failing to resolve here is not the end of checking: the receiver was inferred
            // above, so a struct/enum receiver has already been through
            // tc_method_resolvable_on_type, and a scalar one falls through to Unknown and
            // the codegen E0505 backstop. The wrong ANSWER is what this removes.
            let obj_is_value = nr_has_binding(obj_name)
            // The qualified trait call `Trait.method(receiver, args)` — parsed as
            // MethodCall(obj = Ident(Trait)), and the spec's ONLY way to name one of two
            // traits that define the same method (sections/03c_protocols.md:697-712,
            // resolution table :773 "Explicit trait + method"). Without an arm for a
            // trait-name receiver, the call would answer TYPE_UNKNOWN and BOTH halves of
            // the gate would fail open: the declared type of the result never compared
            // (`let bad: Bool = Sizer.size(p)` would print 5 and test truthy) and neither
            // arity nor argument types checked (an extra argument would reach cc as "too
            // many arguments to a C function").
            //
            // Everything answered here comes from the impl's own signature, which
            // tc_mangle_impl_fnsig keys TRAIT-QUALIFIED as `{T}_{Trait}_{m}` precisely so
            // two traits sharing a method name do not overwrite each other. That makes the
            // trait half of the key the "does this trait own this method for this type"
            // gate as well as the answer — the same gate-and-answer-in-one-lookup shape as
            // tc_channel_elem_ct — so no separate ownership index is needed.
            //
            // The sealed builtin ops traits are EXCLUDED. They carry no such fnsig by design
            // (they are the sole codegen-dispatched surface) and their qualified form already
            // emits correct C through the intrinsics; their own missing declared-type compare
            // needs a signature table rather than another resolution arm.
            if obj_is_value == 0 && is_trait_name(obj_name) != 0 && is_sealed_builtin_trait(obj_name) == 0 {
                // The trait the qualifier names in this file: a shared spelling reaches the
                // file's own trait or the one it selects, as an impl header or a bound does.
                let qt_trait = tc_trait_ref_key(obj_name, nr_current_module)
                // Mono and codegen pick the impl by this trait, and only the calling file's
                // scope says which trait a shared spelling names.
                nr_note_call_decl(node, tc_trait_method_decl(qt_trait, method))
                let qt_args = node_args(node)
                let qt_n = if qt_args != -1 { sublist_length(qt_args) } else { 0 }
                if qt_n == 0 {
                    tc_error_at("qualified trait call `{obj_name}.{method}` expects the receiver as its first argument, got none", node)
                    return tc_error_recovery_tid()
                }
                let qt_recv = infer_type(sublist_get(qt_args, 0))
                let qt_k = type_kind(qt_recv)
                // A receiver that is a BOUNDED type parameter — the spec's own
                // `fn show[T: Describe](v: T) { Describe.describe(v) }` form (:706). No impl
                // fnsig can answer, because the impl is chosen per instantiation, but the bound
                // that LICENSES the call declares the signature, and that declared signature is
                // already the answer the unqualified `v.describe()` takes on the same receiver
                // (the bounded-typevar arm of the instance path). Both spellings of one call
                // read one signature. A bound that does NOT name the trait is rejected below,
                // as an unbounded parameter is: neither licenses the call.
                if qt_k == TyKind.Typevar {
                    let qt_tp = type_to_str(qt_recv)
                    let qt_bounds = tc_tparam_bound_traits(qt_tp)
                    // A type parameter IN SCOPE carries a frame, empty ("|") when it is
                    // unbounded. A typevar with no frame at all — `Self`, or a binder whose
                    // scope this arm is not inside — answers "" and keeps its old path: this
                    // rule speaks only where the bound list is known.
                    if qt_bounds != "" && tc_pipe_has(qt_bounds, qt_trait) == 0 {
                        // The qualifier selects ONE trait (§3c:668-682; the resolution table
                        // at :748 resolves the form by "Explicit trait + method"). On a type
                        // parameter the bound is the whole licence, so a trait the bound does
                        // not name licenses nothing — falling through let the call dispatch to
                        // whichever OTHER trait defines the name and return that trait's
                        // answer, silently ignoring the qualifier the author wrote.
                        if tc_trait_declares_method(qt_trait, method) == 0 {
                            tc_unresolved_method_hard.insert(node, 1)
                            diag_error_at("UnresolvedMethod", UNRESOLVED_METHOD, "trait `{obj_name}` does not define method `{method}`", node, "")
                            return tc_error_recovery_tid()
                        }
                        tc_unresolved_method_hard.insert(node, 1)
                        diag_error_at("TraitBoundNotSatisfied", TRAIT_BOUND_NOT_SATISFIED, "type parameter `{qt_tp}` is not bound by trait `{obj_name}`, so `{obj_name}.{method}` is not available on it", node, "add the bound: `{qt_tp}: {obj_name}`")
                        return tc_error_recovery_tid()
                    }
                    if tc_pipe_has(qt_bounds, qt_trait) != 0 {
                        // The sealed synthesized `display()`, which has no declared signature
                        // anywhere — the same arm the instance path carries. Its arity is spelled
                        // here for the same reason: with no declaration to count, nothing else
                        // can, and the extra arguments were accepted and then dropped.
                        if obj_name == "Display" && method == "display" {
                            if qt_n != 1 {
                                tc_error_at("qualified trait call `Display.display` expects 1 argument(s) including the receiver, got {qt_n}", node)
                            }
                            return TYPE_STR
                        }
                        let mut qv = 0
                        while qv < tc_tmsig_pool.len() {
                            let qtm = tc_tmsig_pool.get(qv).unwrap()
                            if qtm.trait_name == qt_trait && qtm.method == method {
                                // The receiver IS param 0 (`self`), so the declared param count
                                // is the qualified form's arity exactly, as it is on the concrete
                                // path below.
                                let qtm_kw_bad = tc_check_keyword_args("{obj_name}.{method}", qtm.sig, qt_args, 0, node)
                                let qtm_filled = if qt_args != -1 { sublist_length(qt_args) } else { 0 }
                                if qtm_kw_bad == 0 && qtm_filled != qtm.params_count {
                                    tc_error_at("qualified trait call `{obj_name}.{method}` expects {qtm.params_count} argument(s) including the receiver, got {qtm_filled}", node)
                                }
                                let qtm_binds = tc_bound_call_binds(qt_recv, qv)
                                let _ = tc_check_arg_types_with_binds("{obj_name}.{method}", qtm.sig, qt_args, 0, qtm_binds)
                                return substitute_typevar_tid(qtm.ret_tid, qtm_binds)
                            }
                            qv = qv + 1
                        }
                    }
                }
                // An unknown receiver keeps today's answer: there is no fnsig to read.
                // The receiver's name in the impl registry: a struct or an enum answers with
                // its own name, a builtin container with its kind name. `impl[T] Sizer[T] for
                // List[T]` registers under `List_Sizer_tag`, the same key shape a struct impl
                // takes, so the same lookup answers both.
                let qt_tname = if qt_k == TyKind.Struct || qt_k == TyKind.Enum {
                    ty_pool.get(qt_recv).unwrap().name
                } else {
                    tc_builtin_receiver_name(qt_recv)
                }
                if qt_tname != "" {
                    let qt_sig = lookup_fnsig(tc_impl_method_stem(qt_tname, qt_trait, method))
                    if qt_sig != -1 {
                        let qt_fs = fnsig_pool.get(qt_sig).unwrap()
                        // The receiver IS param 0 (`self`), so the qualified form's arity is
                        // the declared param count exactly and check_arg_shapes runs at
                        // self_offset 0, where the instance path uses 1. `self` itself has no
                        // annotation, so its param tid is Unknown and check_arg_shapes skips
                        // it — the receiver's own type was already established by the
                        // fnsig key.
                        let qt_kw_bad = tc_check_keyword_args("{obj_name}.{method}", qt_sig, qt_args, 0, node)
                        let qt_filled = if qt_args != -1 { sublist_length(qt_args) } else { 0 }
                        if qt_kw_bad == 0 && qt_filled != qt_fs.params_count {
                            tc_error_at("qualified trait call `{obj_name}.{method}` expects {qt_fs.params_count} argument(s) including the receiver, got {qt_filled}", node)
                        }
                        // The receiver's type arguments answer a per-instance impl's binders,
                        // as on the instance path.
                        let qt_ibinds = tc_impl_binds_at_call(qt_sig, qt_recv)
                        let _ = tc_check_arg_types_with_binds("{obj_name}.{method}", qt_sig, qt_args, 0, qt_ibinds)
                        return substitute_typevar_tid(qt_fs.ret, qt_ibinds)
                    }
                    // The synthesized sealed `Display.display` has no user fnsig anywhere
                    // — and §3c:712 names it as THE qualified call to write.
                    // Same answer as the instance arm at the Struct/Enum receiver block.
                    if obj_name == "Display" && method == "display" && tc_type_has_display_impl(qt_tname) != 0 {
                        if qt_n != 1 {
                            tc_error_at("qualified trait call `Display.display` expects 1 argument(s) including the receiver, got {qt_n}", node)
                        }
                        return TYPE_STR
                    }
                    // The named trait does not define this method at all. Without this,
                    // `B.go(p)` where only `A` defines `go` silently dispatched to
                    // `blink_Point_A_go` and printed A's answer: the qualifier was ignored.
                    // Gated on the TRAIT's declaration rather than on the missing fnsig, so
                    // a declared-but-unregistered method keeps its existing answer.
                    if tc_trait_declares_method(qt_trait, method) == 0 {
                        let qt_owner = tc_traits_shown(tc_method_trait_names(qt_tname, method))
                        let qt_help = if qt_owner != "" { "`{method}` on {qt_tname} is defined by {qt_owner}" } else { "" }
                        tc_unresolved_method_hard.insert(node, 1)
                        diag_error_at("UnresolvedMethod", UNRESOLVED_METHOD, "trait `{obj_name}` does not define method `{method}`", node, qt_help)
                        return tc_error_recovery_tid()
                    }
                }
            }
            // Static constructor on a sealed builtin type: Bytes.new/from_str/zeroed,
            // Map.new(), Set.new() mirror the bare-call forms in get_builtin_fn_ret. Keyed on
            // the type AND the method — see tc_builtin_static_ret for why the method half
            // matters. A type/method pair it does not own answers TYPE_UNKNOWN and falls
            // through to the fnsig lookups below, which is strictly more than the old gate
            // did: it returned get_builtin_fn_ret's answer for `new` even when that was
            // Unknown, ending resolution there.
            // List is a type and not a builtin fn, so its constructors need their own arms.
            // They sit above every declaration rung, as the builtin constructors below do, so a
            // program that declares `List_new` cannot type this call as its own function.
            if obj_name == "List" && obj_is_value == 0 && method == "new" { return tc_list_new_ctor(node) }
            if obj_name == "List" && obj_is_value == 0 && method == "with_capacity" { return tc_list_with_capacity_ctor(node) }
            // Only the namespaced `channel.new[T]` builds a channel, so the static spelling gets
            // the bare call's refusal. The recovery type keeps the uses of the value quiet.
            if obj_name == "Channel" && obj_is_value == 0 && method == "new" && tc_names_type_without_call_form(obj_name) {
                tc_errors.push("undefined function `Channel.new`")
                diag_error_at("UndefinedFunction", UNDEFINED_FUNCTION, "undefined function `Channel.new`: `Channel` has no constructor", node, tc_no_call_form_repair(obj_name))
                return tc_error_recovery_tid()
            }
            if is_builtin_fn(obj_name) != 0 && obj_is_value == 0 {
                if (obj_name == "Map" || obj_name == "Set") && method == "new" && tc_empty_ctor_arity("{obj_name}.new", node) == 0 {
                    return tc_error_recovery_tid()
                }
                if (obj_name == "Map" || obj_name == "Set") && method == "new" && node_type_params(node) != -1 {
                    return tc_container_ctor_from_type_args(node, obj_name)
                }
                let bs_ret = tc_builtin_static_ret(obj_name, method)
                if method == "new" { tc_note_open_ctor_key(node, bs_ret) }
                if bs_ret >= 0 { return bs_ret }
            }
            // Static method on a builtin/named type: Type.from(x), Type.try_from(x), etc.
            // Trait-impl methods register under `{Type}_{trait}_{method}`; an
            // inherent sig keeps the bare `{Type}_{method}` key — which is how the stdlib
            // spells a static constructor at all, since Blink has no inherent methods
            // (sections/03c_protocols.md:758): `pub fn Duration_seconds(s: Int)`
            // (lib/std/time.bl:3) IS `Duration.seconds(2)`.
            if obj_is_value == 0 {
                // §3c rule-3 ambiguity at the static rung. Two different traits declare this
                // associated function for this type, so the call names no one declaration. The
                // rung just below is gated on exactly one owner, and a trait method keeps no
                // bare `{Type}_{method}` signature, so without this the call resolved to
                // nothing and was accepted anyway.
                //
                // The help cannot offer the qualified call §3c:671 documents for the ambiguous
                // INSTANCE call: `Trait.method(receiver)` names the trait by passing the
                // receiver as the first argument, and an associated function has no receiver to
                // pass. So the fixes it can offer are both in the declarations.
                if tc_method_distinct_trait_count(obj_name, method) >= 2 {
                    let amb_traits = tc_traits_shown(tc_method_distinct_trait_names(obj_name, method))
                    diag_error_at("AmbiguousMethodCall", AMBIGUOUS_METHOD_CALL, "ambiguous static call: `{obj_name}.{method}` is declared by multiple traits implemented by {obj_name} ({amb_traits})", node, "rename one of the methods, or drop one of the impls: a qualified call names the trait by passing the receiver first, and an associated function has no receiver to pass")
                    return tc_error_recovery_tid()
                }
                let static_trait = tc_method_trait_names(obj_name, method)
                if static_trait != "" && tc_method_trait_count(obj_name, method) == 1 {
                    let q_sig = lookup_fnsig(tc_impl_method_stem(obj_name, static_trait, method))
                    if q_sig != -1 {
                        nr_note_call_decl(node, fnsig_pool.get(q_sig).unwrap().decl)
                        // The impl's signature still says `Self`; the call names the type.
                        let q_ret = fnsig_pool.get(q_sig).unwrap().ret
                        let self_tid = lookup_named_type(obj_name)
                        if self_tid == -1 {
                            let _ = check_arg_shapes("{obj_name}.{method}", q_sig, node_args(node), 0, node)
                            return q_ret
                        }
                        let mut self_bind: Map[Str, Int] = Map()
                        self_bind.insert("Self", self_tid)
                        self_bind.insert(tc_binder_key(SELF_BINDER_NODE, "Self"), self_tid)
                        let _ = check_arg_shapes_with_binds("{obj_name}.{method}", q_sig, node_args(node), 0, node, self_bind)
                        return substitute_typevar_tid(q_ret, self_bind)
                    }
                }
                let static_sig_name = "{obj_name}_{method}"
                let static_sig = lookup_fnsig(static_sig_name)
                if static_sig != -1 {
                    nr_note_call_decl(node, fnsig_pool.get(static_sig).unwrap().decl)
                    let _ = check_arg_shapes("{obj_name}.{method}", static_sig, node_args(node), 0, node)
                    return fnsig_pool.get(static_sig).unwrap().ret
                }
                // From/TryFrom key each impl apart (tc_mangle_impl_fnsig), because one target
                // carries several: lib/std/int_conv.bl declares try_from on I8 from Int, I32
                // and I16. So the impl is chosen by the argument's own type.
                //
                // Gated on the method NAME rather than on static_trait, to stay independent of
                // the count == 1 guard above. A miss does not fall through, because the shared
                // fall-through below re-infers every argument and would report a bad one twice.
                if tc_conversion_trait_of(method) != "" {
                    let ff_args = node_args(node)
                    if ff_args != -1 && sublist_length(ff_args) == 1 {
                        return tc_static_conversion(node, obj_name, method, tc_infer_unhinted(sublist_get(ff_args, 0)))
                    }
                }
            }
        }

        return tc_method_call_unanswered(node, method, obj_t, args_sl)
    }

    if kind == NodeKind.FieldAccess {
        let obj_node = node_obj(node)
        let fname = node_name(node)
        if obj_node == -1 { return -1 }

        if node_kind(obj_node) == NodeKind.Ident {
            let obj_name = node_name(obj_node)
            if tc_tid_is_no_info(nr_get_type(obj_name)) != 0 && tc_qualified_carrier(obj_name, fname).is_some() {
                return tc_carrier_nullary_tid(fname, "{obj_name}.{fname}", node)
            }
            if tc_tid_is_no_info(nr_get_type(obj_name)) != 0 {
                match tc_value_missing_variant(obj_name, fname) {
                    Some(owner) => {
                        tc_report_no_such_variant_value(node, owner, obj_name, fname, 0)
                        return tc_error_recovery_tid()
                    }
                    None => {}
                }
            }
            let tid = lookup_named_type(obj_name)
            if tid != -1 && type_kind(tid) == TyKind.Enum {
                let edecl = tc_type_decl_nodes.get(tc_written_type_nominal(obj_name)) ?? -1
                let vi = get_variant_by_name(tid, fname)
                if vi != -1 && variant_field_count(vi) != 0 { return tc_declared_variant_value_tid(tid, vi, "{obj_name}.{fname}", node) }
                return tc_nullary_variant_tid(tid, edecl, vi)
            }
            // A MODULE qualifier. This arm covers an enum type qualifier, a struct
            // field, a tuple index, and this fourth case for `module.name` — without
            // it, a qualified top-level `let` falls off the tail as TYPE_UNKNOWN, which
            // unifies with anything: `let bad: Str = prov.count` would compile, link
            // and RUN, while `want_str(prov.count)` would escape to cc with no
            // diagnostic at all.
            //
            // Same gate name resolution uses for the form (:7764): an Ident that
            // names an import and is not shadowed by a binding. Fails CLOSED —
            // an unregistered key falls through to the existing behaviour rather
            // than guessing a type.
            if is_import_module_name(obj_name) != 0 && nr_is_defined(obj_name) == 0 {
                let qual_mod = tc_qualifier_to_module_or_self(obj_name)
                let qual_decl = tc_module_let_decl_node(qual_mod, fname)
                if qual_decl != -1 {
                    let let_tid = tc_lookup_node_tid(qual_decl)
                    if let_tid >= 0 { return let_tid }
                }
            }
        }

        // tc_resolve, so the arms below read the struct itself and not the bound metavar an
        // inferred value carries — type_kind resolves, but the pool reads here do not.
        let obj_t = tc_resolve(tc_infer_field_receiver(obj_node, fname))
        // A type its module declares twice (E1016) may have meant either declaration's fields.
        if tc_type_decl_poisoned(tc_tid_decl_node(obj_t)) { return tc_error_recovery_tid() }
        if type_kind(obj_t) == TyKind.Struct {
            let ft = get_struct_field_tid(obj_t, fname)
            if ft != -1 {
                // A generic field on a struct INSTANCE (`b: Box[Int]`) carries the
                // concrete inner, not the declared typevar: substitute the instance's
                // type-args into the field tid so `b.value` infers `Int`, not `T`.
                // The pairing is DIRECT — the instance stores its args in
                // declaration order, so name[i] ↔ arg[i] needs no unify_typevar_binds.
                // A bare tid (arg_count 0) leaves the map empty and returns ft as-is.
                //
                // A TYPEVAR arg is bound like any other. `Box[U]` inside
                // `fn f[T, U]` must answer `b.val` as U: the field tid is written in
                // the DECLARING type's binder, and only this substitution carries it
                // over into the binder language of the function that reads the field.
                // Leaving it unbound hands the reader the declaring type's `T`, which
                // monomorphization then resolves against the reader's own same-spelled
                // `T` — a silently wrong type wherever the two binders disagree.
                // Typevars are interned by spelling, so nothing downstream can tell
                // those two `T`s apart; the substitution has to happen here.
                //
                // TYPE_UNKNOWN is the one arg kind left UNBOUND — an empty
                // `Map()`/`Set()` literal (`let b = GKV { m: Map() }` mints a
                // GKV[?,?] instance, tc_struct_lit_instance_tid). Substituting
                // `Map[K,V]` with `K→?` yields `Map[?,?]` whose key C type is void,
                // which defeats the codegen erased-default guard
                // (recover_set_elem_from_tid keys on a -1 no-op for an unresolved
                // inner) and regresses the arg-node element recovery. Skipping the
                // bind keeps the field typevar for the unknowable case.
                if tc_tid_struct_arg_count(obj_t) >= 1 {
                    let inst = ty_pool.get(obj_t).unwrap()
                    let decl = tc_struct_decl_nodes.get(strip_module_qualifier(inst.name)) ?? -1
                    if decl != -1 {
                        let tparams_sl = node_type_params(decl)
                        if tparams_sl != -1 {
                            let mut binds: Map[Str, Int] = Map()
                            let mut i = 0
                            while i < sublist_length(tparams_sl) && i < inst.params_count {
                                let tpnode = sublist_get(tparams_sl, i)
                                let tpname = node_name(tpnode)
                                let tpkey = tc_binder_key(tpnode, tpname)
                                let arg_tid = ty_param_list.get(inst.params_start + i).unwrap()
                                let ak = type_kind(arg_tid)
                                if ak != TyKind.Unknown {
                                    binds.insert(tpname, arg_tid)
                                    binds.insert(tpkey, arg_tid)
                                } else if tc_is_unbound_metavar(arg_tid) != 0 {
                                    // The instance param is an as-yet-unpinned
                                    // metavar α (`let b = GBox { s: Set() }`). Bind the
                                    // field's typevar to THAT SAME α so the field-access
                                    // type shares it — then a later constraining use
                                    // (`b.s.insert(3)`) pins α through the field and the
                                    // whole instance resolves. Without this the field
                                    // type is a fresh disconnected Set[T] and the pin is
                                    // lost (→ spurious E0301 on the recovery idiom).
                                    binds.insert(tpname, arg_tid)
                                    binds.insert(tpkey, arg_tid)
                                }
                                i = i + 1
                            }
                            return substitute_typevar_tid(ft, binds)
                        }
                    }
                }
                return ft
            }
            // ft == -1 does NOT prove the field is absent: an under-resolved
            // handle tid (an inferred-list element) is struct-kind yet
            // carries no findable fields. Error only when the declared shape is
            // resolvable and genuinely omits the field (sections/03_types.md:3305);
            // an @ffi.opaque handle is a bodiless struct, so its inertness against
            // field access falls out of the same declared-shape rule (§9.1.4).
            // Otherwise the field's type is an absence, not an answer.
            if tc_struct_field_provably_absent(obj_t, fname) != 0 {
                tc_error_naming_types("NoSuchField", NO_SUCH_FIELD, "type {type_to_str(obj_t)} has no field `{fname}`", node, "use a declared field, or add the field to the type", [obj_t])
                return tc_error_recovery_tid()
            }
            return -1
        }
        // Tuple positional access `t.0`, `t.1`, ...: the field name is the
        // numeric index into the tuple's element tids. Without this, a tuple
        // element type is TYPE_UNKNOWN and method calls on it (e.g. `t.0.unwrap()`
        // when element 0 is Option) fail to resolve.
        if type_kind(obj_t) == TyKind.Tuple {
            let te = ty_pool.get(obj_t).unwrap()
            let idx = str_to_tuple_index(fname)
            if idx >= 0 && idx < te.params_count {
                return ty_param_list.get(te.params_start + idx).unwrap()
            }
            diag_error_at("NoSuchField", NO_SUCH_FIELD, "tuple {type_to_str(obj_t)} has no field `{fname}`", node, "a tuple field is a numeric index within its arity")
            return tc_error_recovery_tid()
        }
        // `p.zzf` where `p: Ptr[S]` names the field's STORAGE through the pointer — the
        // receiver half of the documented `.read()` / `.write(v)` pair for a
        // `Ptr[@ffi.struct S]` (§9.1). It lowers to `p->zzf`, so it answers the FIELD's type,
        // which is exactly what codegen emits for it and what `.read()` hands back.
        if type_kind(obj_t) == TyKind.Ptr {
            let pointee = tc_resolve(ty_pool.get(obj_t).unwrap().inner1)
            let pointee_k = type_kind(pointee)
            if tc_ptr_ffi_struct_pointee(obj_t) != 0 {
                let pf = get_struct_field_tid(pointee, fname)
                if pf != -1 { return pf }
                if tc_struct_field_provably_absent(pointee, fname) != 0 {
                    tc_error_naming_types("NoSuchField", NO_SUCH_FIELD, "type {type_to_str(pointee)} has no field `{fname}`", node, "use a declared field, or add the field to the type", [pointee])
                    return tc_error_recovery_tid()
                }
            } else if pointee_k == TyKind.Struct && ffi_opaque_type_set.contains_key(pointee) == 0 {
                // E0810 refused this pointee. The pair arm asks the same question, so a field
                // typed here would leave `.read()` and `.write(v)` unclaimed on the field type.
                return tc_error_recovery_tid()
            } else if pointee_k != TyKind.Struct && pointee_k != TyKind.Unknown && pointee_k != TyKind.Typevar {
                // A pointee with no fields of its own, so the pointer has none either.
                let recv = type_to_str(obj_t)
                tc_error_naming_types("NoSuchField", NO_SUCH_FIELD, "type {recv} has no field `{fname}`", node, "{recv} has no fields; call a method instead", [obj_t])
                return tc_error_recovery_tid()
            }
        }
        if tc_typevar_is_rigid(obj_t) != 0 {
            return tc_reject_type_parameter_field(obj_t, fname, node)
        }
        // Only a struct and a tuple declare fields (§3), so any other settled receiver is
        // known to lack this one. The KIND settles it: a hole in `Map[?, ?]` cannot add a
        // field. An open metavar or typevar may still become a tuple, and a Ptr's field is
        // its pointee's, so those stay unanswered here.
        let obj_k = type_kind(obj_t)
        if obj_k != TyKind.Unknown && obj_k != TyKind.Typevar && obj_k != TyKind.Ptr {
            let recv = type_to_str(obj_t)
            let help = if str_to_tuple_index(fname) >= 0 { "a numeric field is a tuple index, and {recv} is not a tuple" } else { "{recv} has no fields; call a method instead" }
            tc_error_naming_types("NoSuchField", NO_SUCH_FIELD, "type {recv} has no field `{fname}`", node, help, [obj_t])
            return tc_error_recovery_tid()
        }
        // Nothing above claimed this node, so nothing has typed it — an absence.
        return -1
    }

    if kind == NodeKind.IndexExpr {
        if (tc_bracket_sites.get(node) ?? 0) == BRACKET_TYPE_ARGS {
            // Reported already, as a type application. The operands are still walked so the
            // nodes under them carry types, and the answer is the error-recovery type: the
            // program has no reading in which this expression holds a value.
            let _ = infer_type(node_obj(node))
            let _ = infer_type(node_index(node))
            return tc_error_recovery_tid()
        }
        let obj_t = infer_type(node_obj(node))
        let idx_t = infer_type(node_index(node))
        let _ = tc_index_pin_open(idx_t, tc_index_get_arg(tc_resolve(obj_t)))
        let mode = tc_bracket_sites.get(node) ?? INDEX_READ
        // A walk that runs before the receiver's binding is typed sees no type; a later walk,
        // or tc_flush_index_sites, reports the site.
        if mode == INDEX_CALLED_READ || tc_tid_is_no_info(tc_resolve(obj_t)) == 0 {
            tc_report_index_read(node, obj_t, mode == INDEX_CALLED_READ)
        }
        return tc_error_recovery_tid()
    }

    if kind == NodeKind.ListLit {
        let elems_sl = node_elements(node)
        if elems_sl != -1 && sublist_length(elems_sl) > 0 {
            let first_t = tc_list_elem_contribution(sublist_get(elems_sl, 0))
            let first_cmp = tc_fn_value_open_ret(sublist_get(elems_sl, 0), first_t)
            // Every element beyond the first must still be visited: infer_type is
            // what memoizes a per-node tid (tc_node_tid), and a CALL-style
            // generic-enum/struct constructor's mono-name recovery
            // (register_mono_enum_from_node / register_struct_instance_from_tid)
            // reads that memo via tc_lookup_node_tid. Without visiting elements 1..N,
            // a 2nd+ `Tree.Leaf(n)` in one list literal falls back to the erased bare
            // head at construction — not a codegen list-elem-channel gap, a typecheck
            // one. The List's own element type still comes from element 0 only,
            // matching pre-existing homogeneity assumptions and diagnostics.
            let mut ei = 1
            while ei < sublist_length(elems_sl) {
                let elem = sublist_get(elems_sl, ei)
                let c = tc_list_elem_contribution(elem)
                tc_check_list_elem_compat(elem, tc_fn_value_open_ret(elem, c), ei, sublist_get(elems_sl, 0), first_cmp)
                tc_tie_fn_rets(first_t, c)
                ei = ei + 1
            }
            // Inference never picks Never for an open slot (§3.2): a diverging element
            // yields nothing, so the element type comes from another element or the hint.
            let elem_t = if tc_resolve(first_t) == TYPE_NEVER { tc_list_elem_past_never(elems_sl) } else { first_t }
            tc_check_spread_sources(elems_sl, elem_t)
            return make_list_type(elem_t)
        }
        // Empty `[]`: the elements say nothing, so the element type can only come from what
        // the position expects. Taking it from the hint makes the FIRST stamp the right one,
        // which matters because a metavar minted here would overwrite an already-solved stamp
        // on re-inference. Where nothing expects a List the helper mints, so a later
        // constraining use (xs.push(1)) still pins it, and an unpinned one is still E0301.
        return make_list_type(tc_carrier_slot_from_hint(TyKind.List, 1))
    }

    if kind == NodeKind.StructLit {
        let lit_t = tc_infer_struct_lit_type(node)
        tc_check_lit_field_values(node, lit_t)
        return lit_t
    }

    if kind == NodeKind.TupleLit {
        let elems_sl = node_elements(node)
        if elems_sl == -1 { return TYPE_VOID }
        if sublist_length(elems_sl) == 0 { return TYPE_VOID }
        let mut elem_types: List[Int] = []
        // An ELEMENT's slot is the element type, not the tuple, so the hint is narrowed one
        // position at a time exactly as a list literal narrows to its element. Unnarrowed, a
        // one-sided carrier written as an element reads the tuple as its expectation, finds a
        // kind it is not, and mints an unbound slot the annotation right there would name.
        let tl_saved_hint = tc_construct_hint
        let tl_hint = if tc_construct_hint >= 0 { resolve_alias_tid(tc_construct_hint) } else { -1 }
        let tl_narrow = if tl_hint >= 0 && tc_tid_kind(tl_hint) == TyKind.Tuple && tc_tid_child_count(tl_hint) == sublist_length(elems_sl) { 1 } else { 0 }
        let mut i = 0
        while i < sublist_length(elems_sl) {
            if tl_narrow != 0 { tc_construct_hint = tc_tid_child(tl_hint, i) }
            elem_types.push(infer_type(sublist_get(elems_sl, i)))
            tc_construct_hint = tl_saved_hint
            i = i + 1
        }
        return make_tuple_type(elem_types)
    }

    if kind == NodeKind.IfExpr {
        // The condition is always consumed (value context); leave the flag at 1. The branches
        // inherit THIS if's own consumed-ness, so restore `incoming` before descending them.
        // The condition is a Bool, whatever the if is expected to be.
        let cond_t = tc_infer_unhinted(node_condition(node))
        if is_bool_compat(cond_t) == 0 {
            tc_error_at("if condition must be Bool, got {type_to_str(cond_t)}", node)
        }
        tc_if_value_ctx = incoming
        let then_t = infer_type(node_then_body(node))
        let else_node = node_else_body(node)
        if else_node != -1 {
            tc_if_value_ctx = incoming
            let else_t = infer_type(else_node)
            // Both sides must carry information all the way down before they can be
            // compared. A branch typed `Option[<hole>]` on the name-resolution pass — the
            // walk that runs before the typecheck pass settles the block's locals — is not a
            // mismatch with `Option[?]`, it is the same branch not yet typed. The compare
            // runs again on the typecheck pass, where both sides are settled.
            //
            // A branch that declares a binding is not compared HERE at all. This runs before
            // either branch scope exists, so such a branch was read against the enclosing
            // scope and its answer is about some other variable of the same name, or about
            // nothing. tc_check_body's IfExpr arm compares those two branches once it has
            // walked them in their own scopes, and the gate there is this same test, so
            // exactly one of the two sites reports any one `if`.
            if tc_if_declaring_branch(node) == 0 {
                if tc_branch_values_agree(node_then_body(node), then_t, else_node, else_t) == 0 {
                    tc_error_at("if branches have incompatible types: {type_to_str(then_t)} vs {type_to_str(else_t)}", node)
                }
            }
            if tc_tid_is_no_info(then_t) != 0 { return else_t }
            if tc_tid_is_no_info(else_t) != 0 { return then_t }
            // A hole takes the other branch's answer for that position, so the `if`'s own
            // type never carries an absence into a container the callers then read.
            if tc_tid_has_unknown(then_t) != 0 { return tc_tid_fill_unknowns(then_t, else_t) }
            if tc_tid_has_unknown(else_t) != 0 { return tc_tid_fill_unknowns(else_t, then_t) }
            return type_merge(then_t, else_t)
        }
        // §2.9: an else-less `if` used as a value has no value on the false path. infer_type
        // reaches this arm in BOTH contexts — value positions AND the tails of discarded
        // statement blocks/asyncs (its Block/WithBlock/AsyncScope arms descend the tail) — so
        // report only when `incoming` marks THIS `if` as a consumed value. One gated site covers
        // every position infer_type walks: flat (operand, field, element, argument, scrutinee,
        // RHS) and every value tail. A discarded statement `if` stays legal with type ().
        if incoming != 0 {
            tc_report_missing_else(node)
        }
        return then_t
    }

    if kind == NodeKind.MatchExpr {
        let arms_sl = node_arms(node)
        if arms_sl != -1 && sublist_length(arms_sl) > 0 {
            // The scrutinee is consumed by the match (value context); the arm bodies produce the
            // match's value, so they inherit its own consumed-ness.
            // What the match is expected to be says nothing about what it matches on.
            let scrut_tid = tc_infer_unhinted(node_scrutinee(node))
            let subject = tc_match_subject(node)
            tc_if_value_ctx = incoming
            // §3.3: `()` is contagious across an arm-bearing form. One arm that falls out
            // with no value makes the WHOLE match `()`, whatever its siblings produce.
            // type_merge cannot say this — it keeps the first side when the kinds differ —
            // so the completing arm is tracked alongside the merge.
            let mut merged = infer_arm_body(sublist_get(arms_sl, 0), scrut_tid, subject)
            let mut completes = 0
            if tc_resolve(merged) == TYPE_VOID { completes = 1 }
            let mut arm_nodes: List[Int] = [tc_arm_body_value(sublist_get(arms_sl, 0))]
            let mut arm_types: List[Int] = [merged]
            let mut i = 1
            while i < sublist_length(arms_sl) {
                tc_if_value_ctx = incoming
                let arm_t = infer_arm_body(sublist_get(arms_sl, i), scrut_tid, subject)
                arm_nodes.push(tc_arm_body_value(sublist_get(arms_sl, i)))
                arm_types.push(arm_t)
                if tc_resolve(arm_t) == TYPE_VOID { completes = 1 }
                if tc_tid_is_no_info(merged) != 0 {
                    merged = arm_t
                } else {
                    if tc_tid_is_no_info(arm_t) == 0 { merged = type_merge(merged, arm_t) }
                }
                i = i + 1
            }
            // An arm whose tail names its own block's binding was typed against the enclosing
            // scope here, so its compare is made once the walk has typed it in its own.
            if tc_match_declaring_arm(node) == 0 { tc_report_match_arm_mismatch(arm_nodes, arm_types) }
            if completes != 0 && tc_tid_is_no_info(merged) == 0 { return TYPE_VOID }
            return merged
        }
        return -1
    }

    // §3.3: `return`/`break`/`continue` transfers control out of the form that holds it and
    // reaches nothing after it, so it produces no value and its type is the bottom type. The
    // rule belongs on the STATEMENT node, not only on a Block that happens to wrap it: a
    // braceless arm body (`0 => return 100`) IS that statement node, and two spellings of one
    // program must give one answer.
    if kind == NodeKind.Return || kind == NodeKind.Break || kind == NodeKind.Continue { return TYPE_NEVER }

    // An expression statement holds exactly the type of the expression it wraps, divergence
    // included — `0 => env.exit(1)` diverges the same way `{ env.exit(1) }` does. Pass-through
    // on the value context (§2.9) so the wrapped value keeps this node's consumed-ness.
    if kind == NodeKind.ExprStmt {
        tc_if_value_ctx = incoming
        return infer_type(node_value(node))
    }

    if kind == NodeKind.Block {
        // §3.3: a block whose last statement transfers control out of it produces no value
        // and nothing follows it, so the block IS the bottom type. Typing it by the operand
        // of its `return` instead makes a diverging arm look like an ordinary value-producing
        // one, and the completeness rule then stops composing through an enclosing form.
        if tc_block_exits(node) != 0 { return TYPE_NEVER }
        let tail = tc_block_tail_stmt(node)
        if tail == -1 { return TYPE_VOID }
        // The tail produces the block's value, so it inherits the block's own consumed-ness.
        tc_if_value_ctx = incoming
        return infer_type(tc_block_tail_value(tail))
    }

    if kind == NodeKind.WhileLoop || kind == NodeKind.ForIn || kind == NodeKind.LoopExpr {
        // sections/02_syntax.md §2.11: a loop is a statement evaluating to `()`, with one
        // refinement — a `loop` no `break` targets never exits, so it is `Never` and may
        // stand as the tail of a fn returning any type. A `while`/`for` can always finish
        // (the condition may be false on entry, the iterable may be empty), so both stay
        // `()`; `while true` is not folded. The loop's type is fixed by its own structure
        // here, BEFORE any compare against a declared return, which is why answering
        // `Never` is not inference picking the bottom type for an open slot (§3.4).
        if kind == NodeKind.LoopExpr && tc_loop_diverges(node) != 0 { return TYPE_NEVER }
        return TYPE_VOID
    }

    if kind == NodeKind.WithBlock {
        tc_if_value_ctx = incoming
        // A `with` in EXPRESSION position — an argument, a `let` value. tc_check_body reaches
        // statement forms only, so in this position nothing walked the body and nothing bound
        // the resource names its tail reads: inferring the body alone answers from an empty
        // scope and leaves every statement inside untyped. Route through the statement arm,
        // which binds the resources, walks the body and recovers the block's own type, then
        // answer that. Gated on the node having no type yet, so the statement position (where
        // that arm has already run and published) keeps its single walk.
        if tc_tid_is_no_info(tc_lookup_node_tid(node)) != 0 {
            tc_check_body(node)
            let w_expr_tid = tc_lookup_node_tid(node)
            if tc_tid_is_no_info(w_expr_tid) == 0 { return w_expr_tid }
        }
        return infer_type(node_body(node))
    }

    if kind == NodeKind.NamedArg {
        // A keyword argument is a LABEL on a value, and its type is that value's type. There was
        // no arm at all, so `serve(port: 8080)` left both the label node and the literal inside
        // it with nothing — check_arg_shapes infers the NamedArg node, not the value, so the
        // argument was never checked against the parameter either.
        if tc_is_default_fill(node) { return tc_lookup_node_tid(node) }
        return infer_type(node_value(node))
    }

    if kind == NodeKind.RangeLit {
        // The bounds are ordinary expressions and the only things that can be wrong here, but
        // the answer (a list of Int) never depended on them, so nothing used to look.
        infer_type(node_start(node))
        infer_type(node_end(node))
        return make_list_type(TYPE_INT)
    }

    // `async.scope { ... }` evaluates to its block's tail, exactly like the bare block
    // it wraps, so the Block arm already computes the answer. Without this arm a
    // statement-position scope returns Unknown here AND its body goes unwalked, because
    // tc_check_body's ExprStmt re-dispatch keys on is_block_bearing.
    if kind == NodeKind.AsyncScope {
        tc_if_value_ctx = incoming
        return infer_type(node_body(node))
    }

    // `.await` unwraps Handle[T]. The operand is in `obj`, NOT `value`. This is
    // expressible only because TyKind.Handle is constructible — a bare typevar named
    // "Handle" would have no inner to read.
    if kind == NodeKind.AwaitExpr {
        let awaited = infer_type(node_obj(node))
        if tc_tid_kind(awaited) == TyKind.Handle && tc_tid_child_count(awaited) >= 1 {
            return tc_tid_child(awaited, 0)
        }
        // A Handle with no element is a malformed carrier rather than a user mistake, and an
        // operand whose own type is still open is not yet known to be un-awaitable. Report only
        // a settled non-Handle: `.await` on it can never produce a value.
        let ak = tc_tid_kind(awaited)
        if ak == TyKind.Handle || ak == TyKind.Unknown || ak == TyKind.Typevar { return -1 }
        if tc_tid_is_no_info(awaited) != 0 { return -1 }
        tc_error_at("cannot await a value of type {type_to_str(awaited)}: `.await` expects a Handle[T]", node)
        return tc_error_recovery_tid()
    }

    // A closure literal's type is its signature, computed from the declaration rather
    // than the body: params through resolve_param_type (TYPE_UNKNOWN for an
    // un-annotated param, which is honest — nothing infers those yet), a written return
    // through tc_closure_declared_ret.
    if kind == NodeKind.Closure {
        let mut ret_t = tc_closure_declared_ret(node)
        // An omitted arrow is not a Void return: the body decides it. check_closure_body binds
        // this slot after its walk, so a type built from the closure first (a list literal's
        // element type) still ends up naming what the body returns.
        if node_type_ann(node) == -1 {
            ret_t = tc_fn_tid_ret(tc_lookup_node_tid(node))
            if ret_t < 0 { ret_t = tc_closure_ret_slot(node) }
        }
        let mut param_types: List[Int] = []
        let params_sl = node_params(node)
        if params_sl != -1 {
            let mut i = 0
            while i < sublist_length(params_sl) {
                param_types.push(resolve_param_type(sublist_get(params_sl, i)))
                i = i + 1
            }
        }
        let fresh = make_fn_type(ret_t, param_types)
        // check_closure_body may have already published a more-specific signature for this
        // closure — an unannotated param bound from the HOF element type, the return inferred
        // from the body. This arm re-mints from the declaration alone (UNKNOWN params, a VOID
        // default return), and the infer_type memo only refuses a downgrade of the WHOLE tid to
        // UNKNOWN, so without this the re-mint would clobber the concrete stamp. Keep whichever
        // is strictly more specific; a differing concrete position (a re-mint under another mono
        // T) is not a refinement, so the fresh mint still wins there. The cross-T safety rests on
        // check_closure_body binding an unannotated param from a TYPEVAR elem in a generic
        // context (not a concrete stamp that could go stale under a second T).
        let existing = tc_lookup_node_tid(node)
        if tc_fn_tid_more_specific(existing, fresh) != 0 {
            return existing
        }
        return fresh
    }

    // Reached by the statement kinds with no value of their own — NodeKind.Unknown
    // placeholders, `let`/`const` bindings, `assert_panics`, `with`-resources. TYPE_UNKNOWN
    // is the sentinel the MatchExpr/IfExpr merge reads as "this arm contributes no value
    // type, skip it", so it must stay TYPE_UNKNOWN here — a metavar would be merged in
    // wrongly, and an ICE would fire on the many valid diverging-arm matches the compiler
    // itself has.
    TYPE_UNKNOWN
}

// The value an inference exit answers AFTER it has reported a diagnostic. The exit's
// own diagnostic is the answer the user reads; this is only what the rest of the pass
// carries in the value's place, and it exists so that every such exit names the
// decision in one place instead of spelling the give-up singleton inline.
//
// A fresh metavar is the type the placeholder WANTS to be — it cannot be mistaken for
// a settled type. It cannot serve yet: the under-determined boundary check sees an
// unbound metavar and reports CannotInferType on it, so each of these exits emitted a
// second diagnostic whose note described a construction that is not in the program.
// Suppressing that needs a placeholder the boundary check can tell apart from a
// solvable metavar — a dedicated error type, not this one-line helper.
fn tc_error_recovery_tid() -> Int {
    TYPE_UNKNOWN
}

// Only a conversion between two settled types can be refused: a generic body's `T` and a type
// inference has not finished are decided again per instance, or reported by the checks that
// own them.
fn tc_conversion_side_settled(t: Int) -> Bool {
    tc_tid_is_concrete(t) != 0 && tc_tid_has_unknown(t) == 0 && tc_tid_has_bare_typevar(t) == 0
}

// The impl a conversion runs, CONVERSION_IS_IDENTITY, or -1. A side that holds a generic
// body's `T` can still match an impl with binders, so the match comes first; only a
// conversion between two settled types that nothing matches reports E0312. `call` spells
// the call for a report that more than one impl matches: the spec gives no rule to pick
// one, so the program must name the receiver's arguments. `at` names the generic instance
// mono checks the call in, and is empty for typecheck's own check.
pub fn tc_check_conversion(node: Int, call: Str, at: Str, trait_name: Str, source: Int, target: Int) -> Int ! Diag.Report {
    tc_judge_conversion(node, call, at, trait_name, source, target, tc_conversion_impl_for(trait_name, source, target))
}

// tc_check_conversion once the impl `im` is looked up.
fn tc_judge_conversion(node: Int, call: Str, at: Str, trait_name: Str, source: Int, target: Int, im: Int) -> Int ! Diag.Report {
    if im == CONVERSION_IS_AMBIGUOUS {
        tc_report_conversion_tie(node, call, at, source, tc_conversion_impls_matching(trait_name, source, target))
        return -1
    }
    if im != -1 { return im }
    if !tc_conversion_side_settled(source) || !tc_conversion_side_settled(target) { return -1 }
    tc_report_no_conversion(node, at, trait_name, source, target)
    -1
}

// `found` holds two or more matches. The spec gives no rule to pick one, so the program must
// name the receiver's arguments.
fn tc_report_conversion_tie(node: Int, call: Str, at: Str, source: Int, found: List[Int]) ! Diag.Report {
    diag_error_at("CannotInferType", CANNOT_INFER_TYPE,
        "{call}{at} on {tc_type_str(source)} matches more than one impl: `{tc_conversion_impl_head(found.get(0).unwrap())}` and `{tc_conversion_impl_head(found.get(1).unwrap())}`", node,
        "annotate the binding that receives the result with the type it should have")
}

fn tc_report_no_conversion(node: Int, at: Str, trait_name: Str, source: Int, target: Int) ! Diag.Report {
    let s = tc_type_str(source)
    let t = tc_type_str(target)
    diag_error_at("NoConversionImpl", NO_CONVERSION_IMPL,
        "{s} does not convert to {t}{at}: there is no `impl {trait_name}[{s}] for {t}`", node,
        "declare the impl, or name the conversion: `.to_float()` widens, `.truncate()` drops a fraction, `.to_int_checked()` checks the range, `{t}.try_from(x)` can fail, `.to_string()` renders text")
}

// Whether typecheck leaves the choice of a conversion to tc_flush_deferred_conversions: no
// impl `im` matches yet and a side still holds an unbound metavariable, which a later use may
// settle (sections/03_types.md 3.4). Records the call when so, and clears an earlier record
// of it when not, since the last walk of a node is the one that counts.
fn tc_defer_conversion(node: Int, im: Int, source: Int, target: Int) -> Bool {
    if im == -1 && (tc_tid_has_unbound_metavar(source) != 0 || tc_tid_has_unbound_metavar(target) != 0) {
        tc_note_deferred_conversion(node)
        return true
    }
    tc_drop_deferred_conversion(node)
    false
}

// `Type.from(x)` / `Type.try_from(x)`. The target is the type the qualifier names; a
// declared impl answers with its method's return, Self read as that target. The impl's
// binders take what the source fills in, and a binder the source leaves open gets a fresh
// metavar, so a bare generic qualifier (`Box.from(xs)`) answers `Box[Int]` for a List[Int].
fn tc_static_conversion(node: Int, obj_name: Str, method: Str, src_t: Int) -> Int ! TypeCheck.Resolve, Diag.Report {
    // An alias qualifier converts to the type it names, as an alias source does.
    let named = resolve_alias_tid(resolve_type_name(obj_name))
    if named < 0 { return -1 }
    let trait_name = tc_conversion_trait_of(method)
    let named_target = tc_static_conversion_target(trait_name, src_t, named)
    let found = tc_conversion_impl_for(trait_name, src_t, named_target)
    // A deferred choice may fill the receiver's arguments a bare generic qualifier leaves
    // open, so they get metavariables of their own.
    let target = if found == -1 && tc_tid_has_unbound_metavar(src_t) != 0 { tc_fresh_instance_tid(named_target) } else { named_target }
    if tc_defer_conversion(node, found, src_t, target) { return tc_static_conversion_answer(trait_name, target) }
    let im = tc_judge_conversion(node, "`{obj_name}.{method}`", "", trait_name, src_t, target, found)
    if im == CONVERSION_IS_IDENTITY { return target }
    // A generic body's `T` picks its impl per instance, so the call still answers the type
    // the qualifier names, and each instance reads that answer to find its impl.
    if im == -1 && !tc_conversion_side_settled(src_t) && tc_conversion_side_settled(target) { return tc_static_conversion_answer(trait_name, target) }
    if im < 0 { return -1 }
    let sig = tc_conversion_method_sig(im, method)
    if sig == -1 { return -1 }
    nr_note_call_decl(node, fnsig_pool.get(sig).unwrap().decl)
    let matched = tc_conversion_match_binds(im, src_t, target) ?? Map()
    let mut binds = tc_impl_fresh_binders(im)
    for key in matched.keys() { binds.insert(key, matched.get(key).unwrap()) }
    if tc_impl_is_poly_conversion(im) { tc_note_conversion_call(im, node, binds) }
    let self_t = substitute_typevar_tid(tc_impl_recv_tids.get(im) ?? target, binds)
    binds.insert("Self", self_t)
    binds.insert(tc_binder_key(SELF_BINDER_NODE, "Self"), self_t)
    substitute_typevar_tid(fnsig_pool.get(sig).unwrap().ret, binds)
}

// `tid` with each typevar the declaration being checked does not bind replaced by a fresh
// metavariable, one per binder.
fn tc_with_foreign_typevars_fresh(tid: Int) -> Int {
    if tc_tid_has_foreign_typevar(tid) == 0 { return tid }
    let mut fresh: Map[Str, Int] = Map()
    tc_collect_foreign_typevars(tid, fresh)
    substitute_typevar_tid(tid, fresh)
}

fn tc_collect_foreign_typevars(tid0: Int, fresh: Map[Str, Int]) {
    let tid = tc_resolve(tid0)
    if tid < 0 || tid >= ty_pool.len() { return }
    if type_kind(tid) == TyKind.Typevar {
        if tc_typevar_binds_here(tid) != 0 { return }
        let key = tc_tid_typevar_key(tid)
        if !fresh.contains_key(key) { fresh.insert(key, make_metavar()) }
        return
    }
    let mut i = 0
    while i < tc_tid_child_count(tid) {
        tc_collect_foreign_typevars(tc_tid_child(tid, i), fresh)
        i = i + 1
    }
}

// What `Type.from(x)` answers before its impl is known: the target, or the Result
// `Type.try_from(x)` carries it in.
fn tc_static_conversion_answer(trait_name: Str, target: Int) -> Int {
    if trait_name == "TryFrom" { return make_result_type(target, tc_conversion_error_type()) }
    target
}

// The fnsig of the `from` or `try_from` method impl `im` declares, or -1.
fn tc_conversion_method_sig(im: Int, method: Str) -> Int ! TypeCheck.Resolve, Diag.Report {
    lookup_fnsig(tc_mangle_impl_fnsig(tc_impl_target_name(im), tc_impl_trait_id(im), method, im))
}

// A bare generic type (`Box`) as an instance whose arguments are fresh metavariables
// (`Box[?1]`); any other type as itself.
fn tc_fresh_instance_tid(tid: Int) -> Int {
    let t = tc_resolve(tid)
    let decl = tc_tid_decl_node(t)
    if decl < 0 || tc_tid_struct_arg_count(t) != 0 { return tid }
    let tps = node_type_params(decl)
    if tps == -1 || sublist_length(tps) == 0 { return tid }
    let mut args: List[Int] = []
    let mut i = 0
    while i < sublist_length(tps) {
        args.push(make_metavar())
        i = i + 1
    }
    if type_kind(t) == TyKind.Enum { return make_enum_instance_type(tc_instance_base_name(t), args) }
    make_struct_instance_type(tc_instance_base_name(t), args)
}

// The type a static conversion matches against. The annotation on the binding that receives
// the result names the receiver's arguments a bare generic qualifier leaves open, so it is
// the target when it names the qualifier's own type and an impl answers for it there, or
// when the source is still open and so cannot rule the annotation out yet.
fn tc_static_conversion_target(trait_name: Str, src_t: Int, named: Int) -> Int {
    let hint = if tc_construct_hint < 0 { -1 } else { tc_conversion_target_of(trait_name, tc_construct_hint) }
    let decl = tc_tid_decl_node(named)
    if hint < 0 || decl < 0 || tc_tid_decl_node(hint) != decl { return named }
    if tc_conversion_side_settled(src_t) && tc_tid_has_unbound_metavar(src_t) == 0 && tc_conversion_impl_for(trait_name, src_t, hint) == -1 { return named }
    hint
}

// The io.* methods that print and answer `()`. Kept separate from the
// is_intrinsic_method list, which also names io.debug — no codegen arm emits that one,
// so it must keep reaching the loud unresolved-method backstop instead of gaining a
// type that would say a call which cannot be built is fine.
fn tc_io_is_print_method(ns: Str, method: Str) -> Int {
    if ns != "io" { return 0 }
    if method == "println" || method == "print" || method == "print_raw" { return 1 }
    if method == "eprintln" || method == "eprint" || method == "eprint_raw" { return 1 }
    if method == "log" { return 1 }
    0
}

// Whether this `loop` provably diverges: no `break` anywhere in its body targets it.
//
// §2.11 fixes the search: it does NOT cross into a nested loop, whose `break` targets
// that inner loop, nor into a closure body, whose `break` belongs to a loop inside the
// closure. `continue` re-enters the same loop and so does not stop divergence.
//
// Only `loop` can answer yes. A `while`/`for` can finish without any `break` at all, and
// the checker does not fold the condition, so `while true` is not special.
fn tc_loop_diverges(node: Int) -> Int {
    if node_kind(node) != NodeKind.LoopExpr { return 0 }
    if tc_body_breaks_here(node_body(node)) != 0 { return 0 }
    1
}

// Whether a `break` in this subtree targets the loop that owns it — the recursive half
// of tc_loop_diverges, stopping at each boundary that re-targets a `break`.
fn tc_body_breaks_here(node: Int) -> Int {
    if node == -1 { return 0 }
    let kind = node_kind(node)
    if kind == NodeKind.Break { return 1 }
    // Boundaries. A nested loop owns every `break` under it; a closure body's `break`
    // can only bind to a loop inside that closure.
    if kind == NodeKind.WhileLoop || kind == NodeKind.ForIn || kind == NodeKind.LoopExpr { return 0 }
    if kind == NodeKind.Closure { return 0 }

    let kids = tc_loop_scan_children(node)
    let mut i = 0
    while i < kids.len() {
        if tc_body_breaks_here(kids.get(i).unwrap()) != 0 { return 1 }
        i = i + 1
    }
    0
}

// The child nodes a loop-body scan descends into, for one statement or expression.
//
// Kept apart from the scan above because it is a list of AST shapes, not type logic: a
// kind missing from it is a silently wrong answer rather than a crash, so it has to be
// readable on its own. The caller keeps its own policy on the loop and closure kinds,
// which are the boundaries that re-target a `break`.
//
// Conditions and scrutinees are deliberately absent: a `break` cannot sit in one.
//
// ast.bl's is_block_bearing names the same block-bearing kinds for a different
// consumer. It cannot drive this list — a boolean predicate says nothing about which
// accessor reaches the block — so a new block-bearing kind has to be added in both.
fn tc_loop_scan_children(node: Int) -> List[Int] {
    let mut out: List[Int] = []
    let kind = node_kind(node)

    if kind == NodeKind.Block {
        let stmts_sl = node_stmts(node)
        if stmts_sl != -1 {
            let mut i = 0
            while i < sublist_length(stmts_sl) {
                out.push(sublist_get(stmts_sl, i))
                i = i + 1
            }
        }
        return out
    }

    if kind == NodeKind.IfExpr {
        out.push(node_then_body(node))
        out.push(node_else_body(node))
        return out
    }

    if kind == NodeKind.MatchExpr {
        let arms_sl = node_arms(node)
        if arms_sl != -1 {
            let mut i = 0
            while i < sublist_length(arms_sl) {
                out.push(node_body(sublist_get(arms_sl, i)))
                i = i + 1
            }
        }
        return out
    }

    // A nested loop, a `with` block and an `async.scope` are all bodies the enclosing
    // fn's `return`s can sit in.
    if kind == NodeKind.WhileLoop || kind == NodeKind.ForIn || kind == NodeKind.LoopExpr {
        out.push(node_body(node))
        return out
    }
    if kind == NodeKind.WithBlock || kind == NodeKind.AsyncScope {
        out.push(node_body(node))
        return out
    }
    // A block-bearing expression in statement position parses as ExprStmt, so unwrap it
    // and re-enter, or the scans never see the form inside.
    if kind == NodeKind.ExprStmt {
        out.push(node_value(node))
        return out
    }
    // A `break` also hides in the VALUE of a binding: `let x = if c { break } else { 4 }`
    // targets the enclosing loop, so walking past the binding would miss it.
    if kind == NodeKind.LetBinding {
        out.push(node_value(node))
        return out
    }
    if kind == NodeKind.Assignment || kind == NodeKind.CompoundAssign {
        out.push(node_value(node))
        return out
    }

    out
}

// ── Phase 2: Type check function bodies ─────────────────────────────

fn resolve_param_type(p: Int) -> Int ! TypeCheck.Resolve, Diag.Report {
    let ptype_str = node_type_name(p)
    let ptype_ann = node_type_ann(p)
    if ptype_ann != -1 {
        return resolve_type_ann(ptype_ann)
    }
    if ptype_str != "" {
        let t = resolve_type_name(ptype_str)
        if t != -1 { return t }
    }
    TYPE_UNKNOWN
}

// The statement that carries a block's value, or -1 when the block has none.
//
// This accepted-kind list has TWO consumers — infer_type's Block arm and
// tc_check_body's implicit-tail declared-return check — and their divergence is a real
// risk. Keep it here, in one place, so they cannot drift apart again.
fn tc_block_tail_stmt(block: Int) -> Int {
    let stmts_sl = node_stmts(block)
    if stmts_sl == -1 { return -1 }
    if sublist_length(stmts_sl) == 0 { return -1 }
    let last = sublist_get(stmts_sl, sublist_length(stmts_sl) - 1)
    let last_k = node_kind(last)
    if last_k == NodeKind.ExprStmt { return last }
    if last_k == NodeKind.Return { return last }
    if last_k == NodeKind.IfExpr || last_k == NodeKind.MatchExpr || last_k == NodeKind.Call || last_k == NodeKind.MethodCall || last_k == NodeKind.Ident || last_k == NodeKind.IntLit || last_k == NodeKind.FloatLit || last_k == NodeKind.BoolLit || last_k == NodeKind.InterpString || last_k == NodeKind.BinOp || last_k == NodeKind.UnaryOp || last_k == NodeKind.WhileLoop || last_k == NodeKind.ForIn || last_k == NodeKind.LoopExpr || last_k == NodeKind.WithBlock {
        return last
    }
    -1
}

// The value node inside a tail statement. ExprStmt and Return wrap theirs; every
// other accepted kind IS its own value. A bare `return` yields -1, which infer_type
// maps to TYPE_UNKNOWN — the same answer the inlined list gave before.
fn tc_block_tail_value(stmt: Int) -> Int {
    let k = node_kind(stmt)
    if k == NodeKind.ExprStmt || k == NodeKind.Return { return node_value(stmt) }
    stmt
}

// The statement that produces a block's value when the block is itself a consumed value, or
// -1. A `return` tail is left out: its own arm already checks the value it returns.
fn tc_value_tail_stmt(block: Int, consumed: Bool) -> Int {
    if !consumed { return -1 }
    let tail = tc_block_tail_stmt(block)
    if tail == -1 || node_kind(tail) == NodeKind.Return { return -1 }
    tail
}

// A binding's value type once the walk has typed the value in its own scope: `inferred` is what
// infer_type answered before the walk, `pre` and `post` the value's scoped memo before and after
// it.
//
// A value can name a binding its own construct introduces: `let x = { let h = 5  h }`, or
// a match arm's pattern binder. infer_type reads that name before the construct's scope
// exists, so it answers with a hole. The walk pushes the scope and memoizes the value in
// it, so the caller reads that answer before it checks the value against an annotation.
// A hole unifies with anything, so a check against the hole would pass any annotation.
//
// The take never replaces an answer infer_type gave. It fills holes only: a bare hole
// takes the memo whole, and a carrier with a hole in it (`List[?]`, `Option[?]`,
// `(?, Int)`) takes the memo's answer at each position it has none for, so an element
// type is not left erased.
fn tc_value_tid_after_walk(val: Int, inferred: Int, pre: Int, post: Int) -> Int {
    if tc_tid_is_no_info(inferred) != 0 || tc_tid_has_unknown(inferred) != 0 {
        if tc_tid_is_no_info(post) != 0 { return inferred }
        if tc_tid_is_no_info(inferred) != 0 { return post }
        return tc_tid_fill_unknowns(inferred, post)
    }
    // A CONFIDENT answer can still be an out-of-scope answer. In
    // `let v = 1` followed by `let x = ...` whose value block re-binds `v` to a
    // Str and names it as the tail, the tail was typed against the OUTER `v` and
    // came back Int, so the gate above declines and the binding takes a type the
    // block does not produce. The proof is the delta: the walk retyped the very
    // node the earlier answer was read from, so a memo that MOVED is the in-scope
    // answer replacing an out-of-scope one. An unmoved memo keeps the old path.
    if tc_tid_is_no_info(post) != 0 || post == pre { return inferred }
    // The value node keeps the out-of-scope answer too, and codegen reads
    // node tids, so correcting only the binding would leave the block itself
    // lowered at the type the block does not produce. The `with` and `match`
    // arms republish their own node; a bare block has no such arm.
    tc_publish_node_tid(val, post)
    post
}

// The tid the IN-SCOPE walk recorded for a value produced inside a scope the speculative
// infer could not see, or -1.
//
// infer_type cannot answer for a value that names a binding introduced by the very
// construct being inferred: tc_check_body's LetBinding arm infers the initializer BEFORE
// walking it, so at that moment nr has no frame for the construct and nr_get_type misses. The
// walk that follows does have the frame, and its ExprStmt arm memoizes the value with the
// right answer — so the tid exists, it is merely written one step late. This reads it instead
// of re-deriving it, which is the whole direction of the tid collapse
// (decisions/compiler-type-representation.md Q2) and also the only version that adds no
// diagnostics: infer_type REPORTS as a side effect (its IfExpr arm emits "if branches have
// incompatible types"), so re-inferring to recover the value would double-report every one.
//
// Two scope-introducing constructs reach here, for the same reason:
//
//   Block (and WithBlock/AsyncScope, which forward to the block they wrap, exactly as
//   infer_type's own arms do) — the tail names a `let` of that block.
//
//   MatchExpr — an arm body names a binding of that arm's PATTERN. The merge in
//   infer_type's MatchExpr arm hides this whenever some sibling arm dodges it
//   (`if merged == TYPE_UNKNOWN { merged = arm_t }`), so only a match where NO arm dodges
//   loses its type. That is why the corpus rows all look like a diverging-arm bug: a
//   `None => return 0` body is TYPE_UNKNOWN too, and so cannot cover for the arm beside it.
//
// A DIVERGING arm body contributes nothing, which is the bottom-type rule and not an
// omission: `match o { Some(v) => v  None => return 0 }` in a `-> Int` fn has the type of
// `v`, and folding the `return`'s own operand in would type an `Option[Str]` match as the
// merge of Str and Int. Skipped by kind rather than by leaning on the Return node's memo
// being TYPE_UNKNOWN, so a later change to what Return memoizes cannot quietly break it.
//
// Recursive rather than a loop because a match fans out. The depth bound is a belt: these
// nest only as deep as the source does, and 8 is far past any real spelling.
fn tc_scoped_value_memo(node: Int, depth: Int) -> Int {
    if node == -1 { return -1 }
    if depth >= 8 { return -1 }
    let k = node_kind(node)
    // The structural answers infer_type gives (§3.3, §2.11) are given here too, because the
    // fn tail reads its type from this memo alone: a diverging form is Never, and a loop or
    // a block with no tail value is ().
    if k == NodeKind.Return || k == NodeKind.Break || k == NodeKind.Continue { return TYPE_NEVER }
    if k == NodeKind.WhileLoop || k == NodeKind.ForIn || k == NodeKind.LoopExpr {
        if k == NodeKind.LoopExpr && tc_loop_diverges(node) != 0 { return TYPE_NEVER }
        return TYPE_VOID
    }
    if k == NodeKind.WithBlock || k == NodeKind.AsyncScope {
        return tc_scoped_value_memo(node_body(node), depth + 1)
    }
    if k == NodeKind.Block {
        if tc_block_exits(node) != 0 { return TYPE_NEVER }
        let tail = tc_block_tail_stmt(node)
        if tail == -1 { return TYPE_VOID }
        return tc_scoped_value_memo(tc_block_tail_value(tail), depth + 1)
    }
    // An `if` tail is the `match` tail's twin: both branch bodies are Blocks the walk
    // DID memoize, so the answer is there to be read. The
    // mismatch case deliberately declines (-1) instead of merging to the then-branch —
    // reporting it here would double-report every `if`, since infer_type's IfExpr arm
    // reports as a side effect, and CLAIMING the then-branch would accept a program that
    // is rejected today.
    if k == NodeKind.IfExpr {
        let then_t = tc_scoped_value_memo(node_then_body(node), depth + 1)
        let else_node = node_else_body(node)
        if else_node == -1 { return then_t }
        let else_t = tc_scoped_value_memo(else_node, depth + 1)
        if tc_tid_is_no_info(then_t) != 0 { return else_t }
        if tc_tid_is_no_info(else_t) != 0 { return then_t }
        if types_compatible(then_t, else_t) == 0 { return -1 }
        return type_merge(then_t, else_t)
    }
    if k == NodeKind.MatchExpr {
        let arms_sl = node_arms(node)
        if arms_sl == -1 { return -1 }
        let mut merged = -1
        let mut completes = 0
        let mut i = 0
        while i < sublist_length(arms_sl) {
            let arm_t = tc_scoped_value_memo(tc_arm_body_value(sublist_get(arms_sl, i)), depth + 1)
            if tc_tid_is_no_info(arm_t) == 0 {
                if tc_resolve(arm_t) == TYPE_VOID { completes = 1 }
                if merged < 0 { merged = arm_t } else { merged = type_merge(merged, arm_t) }
            }
            i = i + 1
        }
        // §3.3: one arm that completes with no value makes the whole match (), as infer_type says.
        if completes != 0 { return TYPE_VOID }
        return merged
    }
    // A CALLBACK'S BODY is a scope the speculative infer could not see either, and
    // for the same reason as the two above: `Bytes.with_ptr(fn(p) { ... })` is typed by the
    // closure's tail (spec §07 signs it `-> T`), and that tail is not walked — so not memoized —
    // until tc_check_body reaches the call, one step after infer_type had to answer. The
    // with_ptr arm of infer_type therefore declines to TYPE_UNKNOWN and the answer is read here.
    //
    // Gated on the node having NO answer of its own, so the ASCRIBED spelling (`fn(p) -> Int`)
    // keeps the annotation's type verbatim, and gated on the receiver actually being Bytes, so a
    // user type with a method of the same name is untouched.
    if k == NodeKind.MethodCall {
        let own = tc_lookup_node_tid(node)
        // An un-annotated `async.spawn(fn() { .. })` takes its payload from the closure's tail, which
        // infer_type read before the closure's scope existed. Only the payload's holes are filled,
        // so a payload infer_type did answer is kept.
        let sp_cls = tc_unannotated_spawn_closure(node)
        if sp_cls != -1 {
            let body_t = tc_closure_body_result_tid(sp_cls, depth)
            if body_t == -1 { return own }
            if tc_tid_is_no_info(own) != 0 { return make_handle_type(body_t) }
            if tc_tid_kind(own) != TyKind.Handle { return own }
            return make_handle_type(tc_tid_fill_unknowns(tc_tid_child(own, 0), body_t))
        }
        if tc_tid_is_no_info(own) == 0 { return own }
        if node_method(node) == "with_ptr" {
            let recv_t = tc_lookup_node_tid(node_obj(node))
            if recv_t >= 0 && type_kind(recv_t) == TyKind.Bytes {
                return tc_closure_body_result_tid(closure_arg_at(node_args(node), 0), depth)
            }
        }
        return own
    }
    // `.await` has its operand's payload as its type, so a spawn recovered above is read through.
    if k == NodeKind.AwaitExpr {
        let own = tc_lookup_node_tid(node)
        if tc_tid_is_no_info(own) == 0 && tc_tid_has_unknown(own) == 0 { return own }
        let h = tc_scoped_value_memo(node_obj(node), depth + 1)
        if tc_tid_is_no_info(h) != 0 || tc_tid_kind(h) != TyKind.Handle { return own }
        let payload = tc_tid_child(h, 0)
        if tc_tid_is_no_info(own) != 0 { return payload }
        return tc_tid_fill_unknowns(own, payload)
    }
    tc_lookup_node_tid(node)
}

// The closure of an `async.spawn(fn() { .. })` whose payload comes from its body, or -1. The
// same shape infer_type's spawn arm infers from the body: a zero-param closure with no declared
// return, on the `async` module rather than a local of that name.
fn tc_unannotated_spawn_closure(node: Int) -> Int {
    if node_kind(node) != NodeKind.MethodCall { return -1 }
    if node_method(node) != "spawn" { return -1 }
    let obj = node_obj(node)
    if obj == -1 || node_kind(obj) != NodeKind.Ident || node_name(obj) != "async" { return -1 }
    if tc_tid_is_no_info(nr_get_type("async")) == 0 { return -1 }
    let cls = closure_arg_at(node_args(node), 0)
    if cls == -1 || node_kind(cls) != NodeKind.Closure { return -1 }
    if node_type_ann(cls) != -1 { return -1 }
    let params = node_params(cls)
    if params != -1 && sublist_length(params) != 0 { return -1 }
    cls
}

// A postfix `[...]` whose item is a value is NoIndexOperator (E0313, 03_types.md §3.4), read
// or store alike. Name resolution decides that a site is one, but the first help depends on
// the receiver's type, so the report waits for inference; tc_flush_index_sites reports any
// site inference never reached.
const INDEX_READ = 1
const INDEX_CALLED_READ = 2
const INDEX_STORE = 3
// A store whose index can be written twice without changing what it names: the `op=` repair
// writes it twice.
const INDEX_STORE_STABLE = 4
// Bracketed type arguments with no call after them. The construct already has its
// diagnostic, so the index-typing arm stays quiet on it.
const BRACKET_TYPE_ARGS = 5
// A site already reported, or one whose item holds a name that resolves nowhere: that name's
// own error is the only report, since what the name is decides the code.
const INDEX_REPORTED = 6

// What name resolution found at each bracket site, by node: an IndexExpr for a read or a type
// application, the Assignment or CompoundAssign for a store.
let mut tc_bracket_sites: Map[Int, Int] = Map()

// Calls whose bracketed type-argument list a typing arm read. A list no arm read binds
// nothing, and tc_check_type_args_claimed reports it once the call is typed.
let mut tc_type_args_claimed: Map[Int, Int] = Map()

// Calls whose type-argument list holds a value name, reported by name resolution. The
// count checks stay quiet on these, so one mistake gets one report.
let mut tc_type_args_unresolved: Map[Int, Int] = Map()

// Calls with an unread type-argument list that had no type yet when the check reached them.
// A later walk may still claim the list; whatever is left at the end of the program is reported.
let mut tc_type_args_untyped: List[Int] = []

// Whether an index expression with no call after it is a type applied in brackets rather
// than a position read. The brackets hold a NAME that names a type or a type parameter in
// scope. A bracket item is in type position, so a value of the same name does not count
// (03_types.md §3.4).
fn tc_index_is_type_application(idx: Int) -> Int {
    if idx == -1 { return 0 }
    if node_kind(idx) != NodeKind.IndexExpr { return 0 }
    let arg = node_index(idx)
    if arg == -1 { return 0 }
    if node_kind(arg) != NodeKind.Ident { return 0 }
    let nm = node_name(arg)
    if nm == "" { return 0 }
    if (tc_active_tparams.get(nm) ?? 0) > 0 { return 1 }
    if tc_names_a_type(nm) { return 1 }
    0
}

fn nr_note_index_site(site: Int, item: Int, mode: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let before = tc_errors.len()
    nr_check_node(item)
    tc_bracket_sites.insert(site, if tc_errors.len() > before { INDEX_REPORTED } else { mode })
}

// A literal, a local, or a const, as name resolution sees it. A module-level `let mut` or a
// call can name a different element the second time.
fn nr_index_written_twice_safely(item: Int) -> Bool {
    let k = node_kind(item)
    if k == NodeKind.IntLit { return true }
    if k != NodeKind.Ident { return false }
    let top = nr_top_index(node_name(item))
    if top == -1 { return false }
    if nr_index_is_global(top) == 0 { return true }
    let decl = nr_binding_node(node_name(item))
    decl != -1 && node_kind(decl) == NodeKind.LetBinding && node_is_const(decl) != 0
}

// Whether unparse_expr renders every node under `node`. A help quotes only what it can
// render faithfully.
fn tc_index_renders(node: Int) -> Bool {
    if node == -1 { return false }
    let k = node_kind(node)
    if k == NodeKind.IntLit || k == NodeKind.FloatLit || k == NodeKind.CharLit || k == NodeKind.BoolLit || k == NodeKind.Ident {
        return true
    }
    if k == NodeKind.InterpString { return tc_index_renders_parts(node_elements(node), true) }
    if k == NodeKind.BinOp { return tc_index_renders(node_left(node)) && tc_index_renders(node_right(node)) }
    if k == NodeKind.UnaryOp { return tc_index_renders(node_left(node)) }
    if k == NodeKind.FieldAccess { return tc_index_renders(node_obj(node)) }
    if k == NodeKind.IndexExpr { return tc_index_renders(node_obj(node)) && tc_index_renders(node_index(node)) }
    if k == NodeKind.Call { return tc_index_renders(node_left(node)) && tc_index_renders_parts(node_args(node), false) }
    if k == NodeKind.MethodCall { return tc_index_renders(node_obj(node)) && tc_index_renders_parts(node_args(node), false) }
    if k == NodeKind.TupleLit || k == NodeKind.ListLit { return tc_index_renders_parts(node_elements(node), false) }
    if k == NodeKind.NamedArg { return tc_index_renders(node_value(node)) }
    false
}

fn tc_index_renders_parts(sl: Int, interp: Bool) -> Bool {
    if sl == -1 { return true }
    let mut i = 0
    while i < sublist_length(sl) {
        let part = sublist_get(sl, i)
        let literal = interp && is_literal_string_part(part) != 0
        if !literal && !tc_index_renders(part) { return false }
        i = i + 1
    }
    true
}

// The source text of `node` as a help quotes it, or "" when it cannot be rendered.
fn tc_index_text(node: Int) -> Str ! Diag.Report {
    if !tc_index_renders(node) { return "" }
    unparse_expr(node)
}

// What a call with value type arguments was called on: `fns` in `fns[i](x)`, `s.fns` in
// `s.fns[i](x)`.
fn tc_call_head_text(call_node: Int) -> Str ! Diag.Report {
    if node_kind(call_node) == NodeKind.MethodCall {
        let obj = tc_index_text(node_obj(call_node))
        if obj == "" { return "" }
        return "{obj}.{node_method(call_node)}"
    }
    tc_index_text(node_left(call_node))
}

// A called element is an Option to unwrap first, and no single edit unwraps it correctly
// in every function, so this note is all the report offers.
fn tc_called_element_note(recv: Str, item: Str) -> Str {
    if recv == "" || item == "" {
        return "`.get(...)` returns an `Option`; `match` on it before calling the element"
    }
    "`{recv}.get({item})` returns an `Option`; `match` on it before calling the element"
}

// Whether a struct or enum type answers `.get(...)` itself.
fn tc_type_has_get(tid: Int) -> Bool {
    let k = type_kind(tid)
    if k != TyKind.Struct && k != TyKind.Enum { return false }
    let tname = ty_pool.get(tid).unwrap().name
    tc_method_trait_count(tname, "get") >= 1 || lookup_fnsig("{tname}_get") != -1
}

// The element type `.get` answers an Option of on a List, Map or Bytes, or -1.
fn tc_index_get_elem(tid: Int) -> Int {
    let k = type_kind(tid)
    if k == TyKind.List { return ty_pool.get(tid).unwrap().inner1 }
    if k == TyKind.Map { return ty_pool.get(tid).unwrap().inner2 }
    if k == TyKind.Bytes { return TYPE_INT }
    -1
}

// The type `.get` takes as its argument on a List, Map or Bytes, or -1.
fn tc_index_get_arg(tid: Int) -> Int {
    let k = type_kind(tid)
    if k == TyKind.List || k == TyKind.Bytes { return TYPE_INT }
    if k == TyKind.Map { return ty_pool.get(tid).unwrap().inner1 }
    -1
}

// The repair passes `operand` where the method takes `want`, so an operand whose type nothing
// else settles takes that type. Without it, a name only the brackets use draws E0301 as well.
fn tc_index_pin_open(operand_t: Int, want: Int) -> Int {
    if want == -1 || tc_is_unbound_metavar(tc_resolve(operand_t)) == 0 { return 0 }
    tc_unify(operand_t, want)
}

// The field a decimal integer literal names, or -1 for any other item.
fn tc_tuple_position(item: Int) -> Int {
    if node_kind(item) != NodeKind.IntLit { return -1 }
    let text = node_str_val(item)
    let n = text.to_int()
    if "{n}" != text { return -1 }
    n
}

fn tc_report_no_index(node: Int, help: Str, notes: List[Str]) ! Diag.Report {
    if notes.len() > 0 {
        diag_error_at_notes("NoIndexOperator", NO_INDEX_OPERATOR, "Blink has no index operator", node, help, notes)
    } else {
        diag_error_at("NoIndexOperator", NO_INDEX_OPERATOR, "Blink has no index operator", node, help)
    }
}

// The fix replaces the whole site, so it needs the site's end on the line it starts on.
fn tc_index_fix(node: Int, before: Int, action: Str, text: Str) {
    if text == "" || diag_entry_count() <= before { return }
    if node_end_line(node) != node_line(node) || node_end_col(node) <= node_col(node) { return }
    diag_set_last_fix_at(action, text, node_line(node), node_col(node), node_end_line(node), node_end_col(node))
}

// A read through brackets: `xs[i]`, or `fns[i](x)` when `called`.
fn tc_report_index_read(node: Int, obj_tid: Int, called: Bool) ! Diag.Report {
    let mode = tc_bracket_sites.get(node) ?? INDEX_READ
    if mode == INDEX_REPORTED || mode == BRACKET_TYPE_ARGS { return }
    tc_bracket_sites.insert(node, INDEX_REPORTED)
    tc_errors.push("no index operator")
    let obj_t = tc_resolve(obj_tid)
    let recv = tc_index_text(node_obj(node))
    let item = node_index(node)
    let item_text = tc_index_text(item)
    if called {
        tc_report_no_index(node, "", [tc_called_element_note(recv, item_text)])
        return
    }
    let k = type_kind(obj_t)
    if k == TyKind.Tuple {
        let arity = ty_pool.get(obj_t).unwrap().params_count
        let pos = tc_tuple_position(item)
        if recv == "" || pos < 0 || pos >= arity {
            tc_report_no_index(node, "a tuple field is a literal position after a dot, such as `.0`", [])
            return
        }
        let field = "{recv}.{pos}"
        let before = diag_entry_count()
        tc_report_no_index(node, "a tuple field is `{field}`", [])
        tc_index_fix(node, before, "use the tuple field", field)
        return
    }
    // A `.get` read answers an Option where the bracket read answered the element, so the
    // repair changes the type of the expression and is not offered as a fix.
    let call = if recv == "" || item_text == "" { "`.get(...)`" } else { "`{recv}.get({item_text})`" }
    let elem = tc_index_get_elem(obj_t)
    let help = if elem != -1 {
        "{call} returns `Option[{type_to_str(tc_resolve(elem))}]`"
    } else if tc_type_has_get(obj_t) {
        call
    } else {
        ""
    }
    tc_report_no_index(node, help, [])
}

// A receiver a repair can quote: a binding, or a field path from one.
fn tc_index_receiver_is_path(node: Int) -> Bool {
    let k = node_kind(node)
    if k == NodeKind.Ident { return true }
    if k == NodeKind.FieldAccess { return tc_index_receiver_is_path(node_obj(node)) }
    false
}

// A store through brackets: `xs[i] = v` or `xs[i] op= v` at `node`.
fn tc_report_index_store(node: Int, obj_tid: Int) ! Diag.Report {
    let mode = tc_bracket_sites.get(node) ?? INDEX_STORE
    if mode == INDEX_REPORTED { return }
    tc_bracket_sites.insert(node, INDEX_REPORTED)
    tc_errors.push("no index operator")
    let target = node_target(node)
    let obj = node_obj(target)
    let k = type_kind(tc_resolve(obj_tid))
    let compound = node_kind(node) == NodeKind.CompoundAssign
    let r = tc_index_text(obj)
    let i = tc_index_text(node_index(target))
    let v = tc_index_text(node_value(node))
    let quoted = r != "" && i != "" && v != "" && tc_index_receiver_is_path(obj)
    let rr = if r == "" { "xs" } else { r }
    let ii = if i == "" { "i" } else { i }
    let vv = if v == "" { "v" } else { v }
    let op = node_op(node)
    let seq = k == TyKind.List || k == TyKind.Bytes
    let mut help = ""
    let mut notes: List[Str] = []
    let mut fix = ""
    if seq || k == TyKind.Map {
        let verb = if seq { "set" } else { "insert" }
        if !compound {
            help = "`{rr}.{verb}({ii}, {vv})`"
            if quoted { fix = "{r}.{verb}({i}, {v})" }
        } else if seq && quoted && node_kind(obj) == NodeKind.Ident && mode == INDEX_STORE_STABLE {
            // A field-path receiver may count as the nested place the spec excludes, so only a
            // bare binding gets the fix.
            fix = "{r}.set({i}, {r}.get({i}).unwrap() {op} {v})"
            help = "`{fix}` (panics when `{i}` is out of bounds)"
        } else {
            let key = if seq { "i" } else { "k" }
            let missing = if seq { "out of bounds" } else { "absent" }
            help = "`let {key} = {ii}`, then `{rr}.{verb}({key}, {rr}.get({key}).unwrap() {op} {vv})` (panics when `{key}` is {missing})"
            notes.push("bind the index with `let` first, so the repair computes it once")
        }
    } else {
        let nv = if compound { "{rr}.get({ii}).unwrap() {op} {vv}" } else { vv }
        help = "`{rr}.set({ii}, {nv})` on a List or Bytes, `{rr}.insert({ii}, {nv})` on a Map"
    }
    let before = diag_entry_count()
    tc_report_no_index(node, help, notes)
    tc_index_fix(node, before, "write the element with a method", fix)
}

// Sites inference never reached carry no receiver type, so they get the type-free help.
// Node order keeps the reports the same from run to run, which map order does not.
fn tc_flush_index_sites() ! Diag.Report {
    for site in tc_bracket_sites.keys().sort() {
        let mode = tc_bracket_sites.get(site) ?? INDEX_REPORTED
        if mode >= INDEX_READ && mode <= INDEX_STORE_STABLE {
            if mode == INDEX_STORE || mode == INDEX_STORE_STABLE {
                tc_report_index_store(site, TYPE_UNKNOWN)
            } else {
                tc_report_index_read(site, TYPE_UNKNOWN, mode == INDEX_CALLED_READ)
            }
        }
    }
}

// Marks the type-argument list at `call_node` as read, and reports it when the callee
// declares a different count. Returns 1 when the list can bind.
fn tc_claim_type_args(call_node: Int, declared: Int, callee: Str, help: Str) -> Int ! Diag.Report {
    tc_type_args_claimed.insert(call_node, 1)
    if (tc_type_args_unresolved.get(call_node) ?? 0) != 0 { return 0 }
    let given = sublist_length(node_type_params(call_node))
    if given == declared { return 1 }
    tc_errors.push("type argument count")
    diag_error_at("CallSiteTypeArgs", CALL_SITE_TYPE_ARGS, "`{callee}` expects {declared} type argument(s), {given} given", call_node, help)
    0
}

// The repair for a wrong count at a callee that is a declaration.
fn tc_type_arity_help(callee: Str, declared: Int) -> Str {
    if declared == 0 { return "`{callee}` declares no type parameters; remove the brackets" }
    "write one type argument for each of the {declared} type parameters `{callee}` declares, or remove the brackets and let the arguments decide them"
}

// The binders a declaration writes itself, which are the ones a call's list may bind.
fn tc_own_type_param_count(decl: Int) -> Int {
    if decl < 0 { return 0 }
    let tps = node_type_params(decl)
    if tps == -1 { return 0 }
    sublist_length(tps)
}

// The binds a call's written type arguments give the declaration's own binders, in order.
// The same tids seed the call's mint group, which is where mono reads a binder that no
// argument reaches, so `probe[Int]()` names its instance.
fn tc_explicit_type_binds(decl: Int, call_node: Int) -> Map[Str, Int] ! TypeCheck.Resolve, Diag.Report {
    let mut binds: Map[Str, Int] = Map()
    let binders = node_type_params(decl)
    let targs = node_type_params(call_node)
    let mut tids: List[Int] = []
    let mut i = 0
    while i < sublist_length(binders) {
        let b = sublist_get(binders, i)
        let t = resolve_type_ann(sublist_get(targs, i))
        binds.insert(node_name(b), t)
        binds.insert(tc_binder_key(b, node_name(b)), t)
        tids.push(t)
        i = i + 1
    }
    tc_seed_mint_group(call_node, tids)
    binds
}

// Writes a full group for `call_node` in the layout tc_ret_only_metavars reads, once. A
// later walk of the same call reads the group back rather than minting over it.
fn tc_seed_mint_group(call_node: Int, tids: List[Int]) {
    if call_node < 0 || call_node >= tc_ret_mint_start.len() { return }
    if tc_ret_mint_start.get(call_node).unwrap() >= 0 { return }
    let start = tc_ret_mint_tids.len()
    tc_ret_mint_tids.push(tids.len())
    for t in tids { tc_ret_mint_tids.push(t) }
    tc_ret_mint_start.set(call_node, start)
}

// A call that writes its type arguments. The list binds the declaration's own binders before
// the arguments are checked, so each argument is checked against the written type. `outer`
// holds the binds the receiver already answers.
fn tc_call_with_type_args(callee: Str, sig: Int, call_node: Int, self_offset: Int, outer: Map[Str, Int]) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let fs = fnsig_pool.get(sig).unwrap()
    let args_sl = node_args(call_node)
    let declared = tc_own_type_param_count(fs.decl)
    if tc_claim_type_args(call_node, declared, callee, tc_type_arity_help(callee, declared)) == 0 {
        let _ = check_arg_shapes_with_binds(callee, sig, args_sl, self_offset, call_node, outer)
        return tc_error_recovery_tid()
    }
    let mut binds = tc_explicit_type_binds(fs.decl, call_node)
    for (k, v) in outer {
        if binds.contains_key(k) == 0 { binds.insert(k, v) }
    }
    let arg_tids = check_arg_shapes_with_binds(callee, sig, args_sl, self_offset, call_node, binds)
    tc_check_bounds_for_binds(sig, binds, call_node)
    let _ = tc_seed_closure_args_with_binds(sig, args_sl, arg_tids, self_offset, binds)
    substitute_typevar_tid(fs.ret, binds)
}

// A pointer allocator given its pointee in brackets, as `alloc_ptr[U8]()` or
// `scope.alloc[U8]()`. The written type is the answer, ahead of any expectation.
fn tc_ptr_from_type_arg(call_node: Int, callee: Str) -> Int ! TypeCheck.Resolve, Diag.Report {
    let help = "`{callee}` takes one type argument, the pointee, as in `{callee}[U8]()`"
    if tc_claim_type_args(call_node, 1, callee, help) == 0 { return tc_error_recovery_tid() }
    make_ptr_type(resolve_type_ann(sublist_get(node_type_params(call_node), 0)))
}

// A container given its element types in brackets, as `Map[Str, Int]()`. The written
// types are the answer, ahead of any expectation, so the constructor knows its key type.
fn tc_container_ctor_from_type_args(call_node: Int, name: Str) -> Int ! TypeCheck.Resolve, Diag.Report {
    let mut declared = 1
    let mut help = "`Set` takes one type argument, the element, as in `Set[Int]()`"
    if name == "Map" {
        declared = 2
        help = "`Map` takes two type arguments, the key and the value, as in `Map[Str, Int]()`"
    } else if name == "List.new" {
        help = "`List.new` takes one type argument, the element, as in `List.new[Int]()`"
    } else if name == "List.with_capacity" {
        help = "`List.with_capacity` takes one type argument, the element, as in `List.with_capacity[Int](n)`"
    }
    if tc_claim_type_args(call_node, declared, name, help) == 0 { return tc_error_recovery_tid() }
    let targs = node_type_params(call_node)
    let first = resolve_type_ann(sublist_get(targs, 0))
    if name == "List.new" || name == "List.with_capacity" { return make_list_type(first) }
    // `Set[T]()` and `Map[K, V]()` write the key as a type argument, so it is judged as a
    // written annotation is, with its text.
    if tc_suppress_ann_validation == 0 {
        let role = if declared == 1 { HashRole.SetElement } else { HashRole.MapKey }
        validate_keyed_ann(sublist_get(targs, 0), role)
        tc_refuse_unhashable_instance(first, sublist_get(targs, 0), role)
    }
    if declared == 1 { return make_set_type(first) }
    make_map_type(first, resolve_type_ann(sublist_get(targs, 1)))
}

// The runtime constructor of an empty container takes no operand, and codegen builds it
// from the tid alone, so a written argument would be dropped with no report. Marking the
// type-argument list unresolved keeps its count check off the same call.
fn tc_empty_ctor_arity(label: Str, node: Int) -> Int ! TypeCheck.Report, Diag.Report {
    let args = node_args(node)
    if args == -1 || sublist_length(args) == 0 { return 1 }
    tc_type_args_unresolved.insert(node, 1)
    tc_error_at_code("`{label}` builds an empty container and takes no arguments, got {sublist_length(args)}", node,
        "TypeError", TYPE_ERROR, "remove the arguments, and add the elements after the container is built")
    0
}

// `List.new()` is the empty list (03_types.md:306), so without brackets it takes its element
// the way an empty `[]` does: from the context, or from a metavariable a later use pins.
fn tc_list_new_ctor(node: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if tc_empty_ctor_arity("List.new", node) == 0 { return tc_error_recovery_tid() }
    if node_type_params(node) != -1 { return tc_container_ctor_from_type_args(node, "List.new") }
    make_list_type(tc_carrier_slot_from_hint(TyKind.List, 1))
}

// `List.with_capacity(n)` is the empty list with room for n elements (03_types.md
// *Capacity*), so it takes its element the same way `List.new()` does. The count is
// checked here because codegen reads exactly one argument.
fn tc_list_with_capacity_ctor(node: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let args = node_args(node)
    if check_builtin_arity("List", "with_capacity", 1, args, node) == 0 {
        tc_type_args_unresolved.insert(node, 1)
        return tc_error_recovery_tid()
    }
    check_builtin_arg("with_capacity", 0, TYPE_INT, args, "List")
    if node_type_params(node) != -1 { return tc_container_ctor_from_type_args(node, "List.with_capacity") }
    make_list_type(tc_carrier_slot_from_hint(TyKind.List, 1))
}

// A call whose list no typing arm read has nothing the list could bind: a variant, a
// builtin, or a method with no declaration behind it. Judged on the inference pass once the
// call has a type, so a receiver an earlier walk could not resolve is not misjudged.
fn tc_check_type_args_claimed(node: Int, tid: Int) ! Diag.Report {
    if node == -1 || tc_boundary_check_active == 0 { return }
    let k = node_kind(node)
    if k != NodeKind.Call && k != NodeKind.MethodCall { return }
    let targs = node_type_params(node)
    if targs == -1 { return }
    if (tc_type_args_claimed.get(node) ?? 0) != 0 { return }
    if (tc_type_args_unresolved.get(node) ?? 0) != 0 { return }
    if tc_tid_is_no_info(tid) != 0 {
        tc_type_args_untyped.push(node)
        return
    }
    tc_report_unclaimed_type_args(node)
}

// Reports what tc_check_type_args_claimed deferred and no later walk claimed, so a list that
// binds nothing never reaches codegen without a report.
fn tc_flush_untyped_type_args() ! Diag.Report {
    for node in tc_type_args_untyped {
        if (tc_type_args_claimed.get(node) ?? 0) == 0 { tc_report_unclaimed_type_args(node) }
    }
    tc_type_args_untyped = []
}

fn tc_report_unclaimed_type_args(node: Int) ! Diag.Report {
    let k = node_kind(node)
    tc_type_args_claimed.insert(node, 1)
    let given = sublist_length(node_type_params(node))
    tc_errors.push("type arguments nothing reads")
    if k == NodeKind.Call && node_kind(node_left(node)) != NodeKind.Ident {
        diag_error_at("CallSiteTypeArgs", CALL_SITE_TYPE_ARGS, "a function value expects 0 type argument(s), {given} given", node, ELEMENT_ACCESS_HELP)
        return
    }
    diag_error_at("CallSiteTypeArgs", CALL_SITE_TYPE_ARGS, "this call expects 0 type argument(s), {given} given", node, "remove the brackets; this call's types come from its arguments and from where its result goes")
}

// The branch or arm compare infer_type declined to make, made once every branch has been
// walked inside its own scope, so the tails mean what they say.
//
// Called from the CONSUMER of the `if`, never from the walk of the `if` itself. Whether the
// value is used decides whether a difference between the branches is an error at all — an
// `if` in statement position discards it, and an else-if chain whose arms end in calls of
// unrelated types is ordinary code. The walk cannot see which it is; the consumer can, because
// it is the thing doing the consuming. The value-context walk is that consumer's proxy: its
// marker says the value is consumed, so it checks the `if` itself (tc_check_if_value).
fn tc_report_deferred_branch_mismatch(node: Int) ! Diag.Report, TypeCheck.Report {
    if node == -1 { return }
    if node_kind(node) == NodeKind.MatchExpr {
        if tc_match_declaring_arm(node) != 0 { tc_report_walked_match_arm_mismatch(node) }
        return
    }
    if node_kind(node) != NodeKind.IfExpr { return }
    if node_else_body(node) == -1 { return }
    if tc_if_declaring_branch(node) == 0 { return }
    tc_report_if_branch_mismatch(node)
}

// A consumed `if` the value-context walk reached, checked once both branches were walked in
// their own scopes. infer_type never types this node, so both of its reports are made here,
// for every branch shape and not only the declaring ones.
fn tc_check_if_value(node: Int) ! Diag.Report, TypeCheck.Report {
    if node_else_body(node) == -1 {
        tc_report_missing_else(node)
        return
    }
    tc_report_if_branch_mismatch(node)
}

fn tc_report_if_branch_mismatch(node: Int) ! Diag.Report, TypeCheck.Report {
    let then_t = tc_scoped_value_memo(node_then_body(node), 0)
    let else_t = tc_scoped_value_memo(node_else_body(node), 0)
    if tc_branch_values_agree(node_then_body(node), then_t, node_else_body(node), else_t) != 0 { return }
    tc_error_at("if branches have incompatible types: {type_to_str(then_t)} vs {type_to_str(else_t)}", node)
}

// Whether a block's tail value is a bare read of a binding that same block declares. Such a
// block cannot be typed by an inference that runs before its scope exists: the tail resolves
// the name against the ENCLOSING scope, so the answer describes a different variable of that
// spelling, or nothing at all.
//
// A block that declares a binding its tail does not name is NOT this shape. Its tail was read
// correctly out of scope, so nothing about it needs deferring.
fn tc_block_tail_reads_own_local(body: Int) -> Int {
    if body == -1 { return 0 }
    if node_kind(body) != NodeKind.Block { return 0 }
    let tail = tc_block_tail_stmt(body)
    if tail == -1 { return 0 }
    let tail_val = tc_block_tail_value(tail)
    if tail_val == -1 { return 0 }
    if node_kind(tail_val) != NodeKind.Ident { return 0 }
    let nm = node_name(tail_val)
    let stmts_sl = node_stmts(body)
    if stmts_sl == -1 { return 0 }
    let mut i = 0
    while i < sublist_length(stmts_sl) {
        let st = sublist_get(stmts_sl, i)
        if node_kind(st) == NodeKind.LetBinding && node_name(st) == nm { return 1 }
        i = i + 1
    }
    0
}

// The gate shared by the two sites that compare an `if`'s branches, so neither can start
// reporting what the other already reports.
fn tc_if_declaring_branch(node: Int) -> Int {
    if tc_block_tail_reads_own_local(node_then_body(node)) != 0 { return 1 }
    if tc_block_tail_reads_own_local(node_else_body(node)) != 0 { return 1 }
    0
}

// The value node of a match arm body, or -1 when the body diverges and therefore contributes
// no type. The by-kind -1 is load-bearing: it keeps tc_check_body's publish off a braceless
// diverging body, whose own node already carries Never from infer_arm_body.
fn tc_arm_body_value(arm: Int) -> Int {
    let b = node_body(arm)
    if b == -1 { return -1 }
    let k = node_kind(b)
    if k == NodeKind.Return || k == NodeKind.Break || k == NodeKind.Continue { return -1 }
    if k == NodeKind.ExprStmt { return node_value(b) }
    b
}

// A Block body with a non-Void declared return but NO tail value at all (ends in
// a `let`, an empty body, etc.) — the one branch that cannot be folded into the
// per-statement walk, since it reports against the whole fn/closure, not a
// statement that doesn't exist. infer_type(Block) answers TYPE_VOID (not
// TYPE_UNKNOWN) for a valueless body, so `-> Int { let x = 1 }` depends on this
// running here, verbatim, with `at_node` as the report site. Extracted from
// tc_check_fn so a closure's own declared return gets the same check a named
// fn's does — "Two spellings of one program must give one answer, and the only
// way to guarantee that is one implementation" (tc_check_returned_value).
fn tc_check_missing_tail_value(body: Int, declared_ret: Int, owner_name: Str, at_node: Int) ! TypeCheck.Report, Diag.Report {
    if node_kind(body) != NodeKind.Block { return }
    if declared_ret == TYPE_VOID || tc_tid_is_no_info(declared_ret) != 0 { return }
    if tc_block_tail_stmt(body) == -1 {
        if tc_resolve(declared_ret) == TYPE_NEVER { return tc_report_missing_return_of("end", owner_name, declared_ret, at_node) }
        tc_error_at("function `{owner_name}` declared return type {type_to_str(declared_ret)} but body returns {type_to_str(TYPE_VOID)}", at_node)
    }
}

// Genuine scope save/restore: nr_push_scope on entry, nr_pop_scope on exit.
// `@allow` records nothing, so it does not reach an audit-gated diagnostic. Naming one
// there is refused rather than dropped: an author who cannot tell a failed suppression
// from a successful one learns nothing from either.
// §2.21 defines a const expression as literals and arithmetic over them, plus `const`
// bindings and struct literals whose fields are const. This answers that question for the
// forms it can decide on the node alone. A bare identifier is ACCEPTED: deciding whether a
// name is a `const` needs resolution this pass does not run, and rejecting every name would
// refuse the `const DEFAULT_PORT` spelling the section names as correct.
// Whether a NAME is const where it is written. §2.21 admits another `const` by name and
// refuses a `let`, so the two have to be told apart, and only the declaration can tell them
// apart: both are LetBinding nodes and the const flag is the difference. A name this scope
// cannot see is not judged — an enum variant written bare, and an import, both arrive here
// with no local binding, and refusing what cannot be seen would refuse correct programs.
fn tc_name_is_const_binding(name: Str) -> Int {
    if nr_has_binding(name) == 0 { return 1 }
    let d = nr_binding_node(name)
    if d == -1 { return 1 }
    if node_kind(d) != NodeKind.LetBinding { return 1 }
    node_is_const(d)
}

fn tc_args_are_const(args_sl: Int) -> Int {
    if args_sl == -1 { return 1 }
    let mut i = 0
    while i < sublist_length(args_sl) {
        if tc_is_const_expr(sublist_get(args_sl, i)) == 0 { return 0 }
        i = i + 1
    }
    1
}

// Enum-variant construction is const with const payloads; every other call is not, and the
// two are written the same way. The variant table answers for a user enum, and the carriers
// are named because they are variants the language declares rather than the program.
fn tc_name_is_variant_ctor(name: Str) -> Int {
    if name == "Some" || name == "Ok" || name == "Err" || name == "None" { return 1 }
    if tc_first_variant_slot(name) != -1 { return 1 }
    0
}

// A string with no interpolated part is a literal. One with a part is a run-time
// concatenation of whatever the part evaluates to, whatever that part looks like.
fn tc_is_plain_string_literal(node: Int) -> Bool {
    let parts = node_elements(node)
    if parts == -1 { return true }
    let mut i = 0
    while i < sublist_length(parts) {
        if is_literal_string_part(sublist_get(parts, i)) == 0 { return false }
        i = i + 1
    }
    true
}

fn tc_is_const_expr(e: Int) -> Int {
    if e == -1 { return 0 }
    let k = node_kind(e)
    if k == NodeKind.IntLit { return 1 }
    if k == NodeKind.FloatLit { return 1 }
    if k == NodeKind.BoolLit { return 1 }
    if k == NodeKind.CharLit { return 1 }
    if k == NodeKind.Ident { return tc_name_is_const_binding(node_name(e)) }
    // A call is outside the set unless it is building a variant. `Map()` is refused here and
    // not by a list of collection names: what rules it out is that it is a call at all.
    // The callee is the left child, not the node's own name, which a Call leaves empty.
    if k == NodeKind.Call {
        let callee = node_left(e)
        if callee == -1 { return 0 }
        let ck = node_kind(callee)
        if ck != NodeKind.Ident && ck != NodeKind.FieldAccess { return 0 }
        if tc_name_is_variant_ctor(node_name(callee)) == 0 { return 0 }
        return tc_args_are_const(node_args(e))
    }
    // `Level.Info` is a payload-free variant, and `mod.NAME` is a const named through its
    // module. Both read as a field access, so anything that is not a variant is as const as
    // the base it reads from.
    if k == NodeKind.FieldAccess {
        if tc_name_is_variant_ctor(node_name(e)) != 0 { return 1 }
        return tc_is_const_expr(node_obj(e))
    }
    // `Level.Info(1)` parses as a method call on the type, so a method name that is a variant
    // is construction and everything else is the method call §2.21 names.
    if k == NodeKind.MethodCall {
        if tc_name_is_variant_ctor(node_method(e)) == 0 { return 0 }
        return tc_args_are_const(node_args(e))
    }
    if k == NodeKind.UnaryOp { return tc_is_const_expr(node_left(e)) }
    if k == NodeKind.BinOp {
        if tc_is_const_expr(node_left(e)) == 0 { return 0 }
        return tc_is_const_expr(node_right(e))
    }
    if k == NodeKind.InterpString { return if tc_is_plain_string_literal(e) { 1 } else { 0 } }
    // §2.21 enumerates a closed set and is silent on these three. `#embed` is read by the
    // compiler and can be nothing else, and a bracket literal of const elements is written in
    // the tree today, so refusing either would refuse correct code the section never rules out.
    if k == NodeKind.EmbedExpr { return 1 }
    if k == NodeKind.ListLit { return tc_args_are_const(node_elements(e)) }
    if k == NodeKind.TupleLit { return tc_args_are_const(node_elements(e)) }
    if k == NodeKind.StructLit {
        let flds = node_fields(e)
        if flds == -1 { return 1 }
        let mut i = 0
        while i < sublist_length(flds) {
            if tc_is_const_expr(node_value(sublist_get(flds, i))) == 0 { return 0 }
            i = i + 1
        }
        return 1
    }
    0
}

// §2.21: a const is evaluated while compiling and written in at every use, so a right-hand
// side the compiler cannot evaluate leaves nothing to write in. Reported against the value
// rather than the binding, because the value is the part to change.
fn tc_check_const_decl(node: Int) ! Diag.Report {
    if node_is_const(node) == 0 { return }
    let v = node_value(node)
    if v == -1 { return }
    if tc_is_const_expr(v) != 0 { return }
    diag_error_at("NonConstExpr", NON_CONST_EXPR,
        "the value of const `{node_name(node)}` is not a compile-time constant", v,
        "const values are literals, arithmetic and boolean operators over them, other consts by name, struct literals with const fields, and enum variants; calls of any kind and `let` bindings are not")
}

// §2.13 allows a default value only on a parameter declared after `--`, and §2.21 requires
// the value to be const. Both rules are stated as normative and neither could be broken
// before, because the syntax did not parse.
fn tc_check_param_defaults(fn_node: Int) ! Diag.Report {
    let params_sl = node_params(fn_node)
    if params_sl == -1 { return }
    let mut i = 0
    while i < sublist_length(params_sl) {
        let pn = sublist_get(params_sl, i)
        let dflt = node_value(pn)
        if dflt != -1 {
            let nm = node_name(pn)
            if node_int_val(pn) == 0 {
                diag_error_at("PositionalParamDefault", POSITIONAL_PARAM_DEFAULT,
                    "`{nm}` is a positional parameter and cannot carry a default value", pn,
                    "move it after the `--` separator, which also makes it keyword-required")
            } else if tc_is_const_expr(dflt) == 0 {
                diag_error_at("NonConstParamDefault", NON_CONST_PARAM_DEFAULT,
                    "the default for `{nm}` is not a const expression", dflt,
                    "use a literal, a `const` binding, or arithmetic over those")
            }
        }
        i = i + 1
    }
}

// Each default against its parameter's type, here at the declaration, in the declaration's
// module and before any parameter is in scope. Every call that leaves the argument out
// shares the one node, so this is the one place it is read, and a mistake in it is reported
// at the default in its own file, not at a call.
fn tc_check_param_default_types(fn_name: Str, fn_node: Int, sig: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let params_sl = node_params(fn_node)
    if params_sl == -1 || sig == -1 { return }
    let fs = fnsig_pool.get(sig).unwrap()
    // The receiver is the one parameter written with no type, and a call counts its
    // arguments after it.
    let mut receiver = 0
    if sublist_length(params_sl) > 0 {
        let p0 = sublist_get(params_sl, 0)
        if node_type_ann(p0) == -1 && node_type_name(p0) == "" { receiver = 1 }
    }
    let mut i = 0
    while i < sublist_length(params_sl) && i < fs.params_count {
        let dflt = node_value(sublist_get(params_sl, i))
        if dflt != -1 {
            let ptid = fnsig_param_list.get(fs.params_start + i) ?? -1
            if ptid >= 0 && tc_tid_is_no_info(ptid) == 0 {
                let _ = check_one_arg_shape(fn_name, i - receiver, dflt, ptid)
            } else {
                let _ = tc_infer_unhinted(dflt)
            }
        }
        i = i + 1
    }
}

fn tc_check_allow_annotation(fn_node: Int) ! Diag.Report {
    let allow_ann = get_annotation(fn_node, "allow")
    if allow_ann == -1 { return }
    let args_sl = node_args(allow_ann)
    if args_sl == -1 { return }
    let mut i = 0
    while i < sublist_length(args_sl) {
        let arg = sublist_get(args_sl, i)
        let nm = node_name(arg)
        if diag_is_audit_gated(nm) != 0 {
            diag_error_at("AuditGatedSuppression", AUDIT_GATED_SUPPRESSION,
                "`{nm}` cannot be suppressed with @allow", arg,
                diag_audit_gated_help(nm))
        }
        i = i + 1
    }
}

// The sibling diag_push_allows/diag_clear_allows and nr_* scope writes fall
// outside that pattern, which the analyzer correctly flags.
@allow(UnrestoredMutation, IncompleteStateRestore)
fn tc_check_fn(fn_node: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let prev_boundary = tc_boundary_check_active
    tc_boundary_check_active = 1
    nr_push_scope()
    let fn_tparams = node_type_params(fn_node)
    tc_push_tparam_scope(fn_tparams)
    let fn_name = node_name(fn_node)
    let prev_fn_name = tc_current_fn_name
    let prev_fn_ret = tc_current_fn_ret
    let prev_fn_node = tc_current_fn_node
    tc_current_fn_name = fn_name
    tc_current_fn_node = fn_node
    // An impl method's signature lives under the trait-mangled key, not under the display name the
    // caller installed on the node. Two overlapping impls share that key and the later one owns
    // it, so the body reads the signature its own declaration made: the overlap is reported once
    // and does not also read as a wrong return type in the earlier impl.
    let sig = if tc_current_method_sig_key != "" {
        fnsig_by_decl.get(fn_node) ?? lookup_fnsig(tc_current_method_sig_key)
    } else {
        lookup_fnsig(fn_name)
    }
    if sig != -1 {
        tc_current_fn_ret = fnsig_pool.get(sig).unwrap().ret
        // Signatures are registered before any impl receiver is in scope, so a `-> Self`
        // method's recorded return is still the abstract `Self` typevar. types_compatible
        // short-circuits on a typevar, which made the declared-return compare VACUOUS for
        // every `-> Self` body in the language: `-> Self { 42 }` was accepted. The receiver
        // is what `Self` means here, and the annotation node is stamped with it, so the body
        // must be checked against the same type — otherwise the two channels disagree and a
        // wrong body lands as a C error with no Blink span.
        if tc_current_self_tid != -1 {
            let mut self_ret_binds: Map[Str, Int] = Map()
            self_ret_binds.insert("Self", tc_current_self_tid)
            self_ret_binds.insert(tc_binder_key(SELF_BINDER_NODE, "Self"), tc_current_self_tid)
            tc_current_fn_ret = substitute_typevar_tid(tc_current_fn_ret, self_ret_binds)
        }
    }

    let is_ffi = has_annotation(fn_node, "ffi")
    tc_check_allow_annotation(fn_node)
    tc_check_param_defaults(fn_node)
    tc_check_param_default_types(fn_name, fn_node, sig)
    diag_push_allows(fn_node)

    let params_sl = node_params(fn_node)
    if params_sl != -1 {
        let mut i = 0
        while i < sublist_length(params_sl) {
            let p = sublist_get(params_sl, i)
            let pname = node_name(p)
            let ptid = resolve_param_type(p)
            // Mirror the fnsig path (tc_fnsig_param_instance_tid): a generic-struct/enum
            // param binds into scope as a STRUCTURAL instance carrying its type-arg slots,
            // not the erased bare base. Without this the mono-calls-mono forwarding chain
            // (take_box→is_full, forward_box→take_box, recursion) sees a bare enum head
            // that substitute_typevar_tid can't rewrite and the instance-arm guard rejects,
            // falling the element resolution to the legacy CSV path. Guard on
            // `ann != -1` exactly like the fnsig caller — an un-annotated param resolves to
            // TYPE_UNKNOWN today so the callee's bk-guard already returns -1, but keeping
            // the guard makes this an exact structural mirror and never hands a -1 node to
            // node_elements (which node_or_die-crashes on -1).
            let ann = node_type_ann(p)
            tc_record_alias_ann(ann)
            let mut ptid_final = ptid
            if ann != -1 {
                let inst = tc_fnsig_param_instance_tid(ann, ptid)
                if inst != -1 { ptid_final = inst }
            }
            // `self` is the one parameter that can carry no annotation, so the branch above can
            // never type it and resolve_param_type answers TYPE_UNKNOWN — which unifies with
            // anything, silently disabling both the declared-type compare and the ARGUMENT check
            // on every `self.method(...)` in the language. The impl block's receiver type is
            // the answer, and tc_infer_program has it in hand at the call site.
            //
            // Guarded on the resolved type still being UNKNOWN so an explicitly annotated `self`
            // (and any future typed receiver form) keeps its own annotation: the annotation is
            // more specific than the header, and this must not overwrite it.
            //
            // Keyed on the receiver POSITION, not on the spelling: an impl method may write
            // the receiver `_self` to mark it unused, and the receiver is still the receiver.
            // Keying on the name `self` left `_self` bound to TYPE_UNKNOWN and every field
            // read through it untyped. Only param 0 of an impl method can be the receiver,
            // and tc_current_self_tid is -1 outside an impl, so a free function's
            // un-annotated first param is untouched.
            if i == 0 && ann == -1 && tc_tid_is_no_info(ptid_final) != 0 && tc_current_self_tid != -1 {
                ptid_final = tc_current_self_tid
            }
            // An FFI extern fn has an empty body, so it needs no scope binding or argument
            // machinery — but its param node must still carry a tid so codegen's param_fmt
            // reads the authoritative tid instead of declining to the flat param_c_type.
            // c_type_from_tid already spells every scalar/handle/str FFI param C type
            // identically; the format_params gate keeps a divergent raw-pointer lowering
            // (Bytes uint8_t*, Ptr inner) on the flat, so emitted C is unchanged.
            if is_ffi == 0 {
                nr_define_typed(pname, 0, ptid_final, p)
            }
            // The same type, on the node, for codegen's dual-write. `ptid_final` is the
            // answer every check below uses; publishing it here is what lets the param's
            // ScopeVar be compared against it instead of only against a name put through
            // type_from_name. A typevar for a generic fn — codegen substitutes with the
            // instance's binds.
            tc_publish_node_tid(p, ptid_final)
            i = i + 1
        }
    }

    // The return twin of the param publish above: codegen's signature-return positions read
    // the return-annotation node's tid, so stamp it here or those positions decline to the flat
    // carrier. Resolution mirrors tc_closure_declared_ret (resolve + structural-instance lift so a
    // generic-struct/enum return carries its type-arg slots). An unannotated (void) fn has no
    // annotation node to stamp and the flat carrier already spells void, so the -1 case is skipped.
    // Not gated on is_ffi: the param publish above is likewise ungated (only its nr_define_typed
    // scope binding is), and an FFI carrier return must carry its authoritative tid too so its
    // RetType stops declining to the pool fallback. The FFI extern signature C is unaffected —
    // ffi_c_ret_type reads the flat annotation, not this memo.
    let ret_ann = node_type_ann(fn_node)
    let mut fn_ret_tid = TYPE_VOID
    if ret_ann != -1 {
        let mut ret_tid = resolve_type_ann(ret_ann)
        let ret_inst = tc_fnsig_param_instance_tid(ret_ann, ret_tid)
        if ret_inst != -1 { ret_tid = ret_inst }
        tc_publish_node_tid(ret_ann, ret_tid)
        fn_ret_tid = ret_tid
        tc_record_alias_ann(ret_ann)
    }

    // An @ffi fn binds no params, and its contracts are refused (ContractOnFFI).
    if is_ffi == 0 { tc_type_contract_predicates(fn_node, fn_ret_tid) }

    let body = node_body(fn_node)
    if body != -1 && is_ffi == 0 {
        // The implicit-tail declared-return check runs INSIDE tc_check_body, ahead of
        // the body scope's nr_pop_scope. Re-inferring the body after the pop reads a
        // degraded type: a tail Ident resolves to TYPE_UNKNOWN and a tail struct literal
        // falls to the bare-stid return, which then overwrites the good memo and
        // compares vacuously.
        if node_kind(body) == NodeKind.Block { tc_fn_body_block = 1 }
        tc_check_body(body)
        tc_fn_body_block = 0

        // The one branch that CANNOT move: a body with no tail value at all reports
        // against the whole function, not against a statement that does not exist. The
        // old post-pop compare was its only producer (infer_type(Block) answers
        // TYPE_VOID — not UNKNOWN — for a valueless body), so `fn f() -> Int { let x =
        // 1 }` and `fn f() -> Int { }` both depend on keeping it here, verbatim, with
        // fn_node as the report site. `sig != -1` is kept here, not inside the shared
        // helper: it is what leaves this check un-run for every impl method, and that
        // miss must stay verbatim.
        if sig != -1 {
            let declared_ret = fnsig_pool.get(sig).unwrap().ret
            tc_check_missing_tail_value(body, declared_ret, fn_name, fn_node)
        }
    }
    tc_flush_deferred_conversions()
    diag_clear_allows()
    tc_pop_tparam_scope(fn_tparams)
    tc_current_fn_name = prev_fn_name
    tc_current_fn_node = prev_fn_node
    tc_current_fn_ret = prev_fn_ret
    nr_pop_scope()
    tc_boundary_check_active = prev_boundary
}

// 1 while an @ensures predicate is inferred, where `old(e)` is the entry snapshot of e and not
// a call.
let mut tc_in_ensures_predicate: Int = 0

// The typed contract predicates of each fn, keyed by the fn node, and the `old(e)` nodes
// among them. Codegen lowers exactly these, so a predicate the validator refused is never
// lowered, and a call to a user fn named `old` is never read as a snapshot.
let mut tc_fn_requires: Map[Int, List[Int]] = Map()
let mut tc_fn_ensures: Map[Int, List[Int]] = Map()
let mut tc_old_calls: Map[Int, Int] = Map()

pub fn tc_requires_preds_of(fn_node: Int) -> List[Int] {
    tc_fn_requires.get(fn_node) ?? []
}

pub fn tc_ensures_preds_of(fn_node: Int) -> List[Int] {
    tc_fn_ensures.get(fn_node) ?? []
}

pub fn tc_is_old_snapshot(node: Int) -> Bool {
    tc_old_calls.contains_key(node)
}

// The @requires and @ensures predicates, typed in the fn's own scope so their runtime checks
// lower from tids like any other expression. @ensures also sees `result`, the returned value.
// @allow: publishing types IS this function's effect; the ensures flag is reset on the way out.
@allow(UnrestoredMutation)
fn tc_type_contract_predicates(fn_node: Int, ret_tid: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let anns_sl = node_handlers(fn_node)
    if anns_sl == -1 { return }
    let mut requires: List[Int] = []
    let mut ensures: List[Int] = []
    let mut i = 0
    while i < sublist_length(anns_sl) {
        let ann = sublist_get(anns_sl, i)
        let nm = node_name(ann)
        let args_sl = if nm == "requires" || nm == "ensures" { node_args(ann) } else { -1 }
        if args_sl != -1 && sublist_length(args_sl) > 0 {
            let pred = sublist_get(args_sl, 0)
            if pv_rejected_preds.contains_key(pred) == false {
                let is_ens = nm == "ensures"
                if is_ens {
                    nr_push_scope()
                    nr_define_typed("result", 0, ret_tid, -1)
                    tc_in_ensures_predicate = 1
                }
                tc_type_predicate(pred, "@{nm}")
                if is_ens {
                    tc_in_ensures_predicate = 0
                    nr_pop_scope()
                    ensures.push(pred)
                } else {
                    requires.push(pred)
                }
            }
        }
        i = i + 1
    }
    tc_fn_requires.insert(fn_node, requires)
    tc_fn_ensures.insert(fn_node, ensures)
}

fn tc_type_predicate(pred: Int, what: Str) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let mut t = tc_infer_value(pred)
    let reread = tc_value_awaits_closure_ret(pred)
    tc_walk_stmt_value(pred)
    if reread { t = tc_infer_value(pred) }
    if is_bool_compat(t) == 0 {
        tc_error_at("{what} predicate must be Bool, got {type_to_str(t)}", pred)
    }
}

// A @where predicate is an expression over `self`, the value of the alias's base type. It is
// reached here, from the declaration, for the reason field defaults are: no body holds it.
// @allow: the module and tparam scope are restored; publishing types is the point.
@allow(UnrestoredMutation)
fn tc_stamp_where_predicate(td: Int, seen: List[Int]) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if node_value(td) != -1 {
        let saved = nr_current_module
        nr_current_module = node_module(td)
        tc_record_alias_ann(node_value(td))
        nr_current_module = saved
    }
    let pred = node_condition(td)
    if pred == -1 { return }
    if pv_rejected_preds.contains_key(pred) { return }
    let tparams = node_type_params(td)
    tc_push_tparam_scope(tparams)
    let saved_module = nr_current_module
    nr_current_module = node_module(td)
    nr_push_scope()
    nr_define_typed("self", 0, resolve_type_ann(node_value(td)), -1)
    tc_type_predicate(pred, "@where")
    nr_pop_scope()
    nr_current_module = saved_module
    tc_pop_tparam_scope(tparams)
    // As with a field default, the walk recovered this subtree before it was typed.
    let mut pred_owners: List[Int] = []
    let _ = tc_stamp_walk(pred, pred_owners, seen)
}

// The alias declaration an annotation names, keyed by the annotation node. An alias is
// transparent, so the tid at a boundary is the base type and cannot say which @where
// applies; codegen reads the declaration from here instead.
let mut tc_ann_alias_decl: Map[Int, Int] = Map()

fn tc_record_alias_ann(ann: Int) {
    if ann == -1 { return }
    let td = tc_decl_node_for_type(tc_written_type_nominal(node_name(ann)))
    if td < 0 { return }
    if node_value(td) == -1 { return }
    tc_ann_alias_decl.insert(ann, td)
}

// The alias TypeDef the annotation `ann` names, or -1.
pub fn tc_alias_decl_of_ann(ann: Int) -> Int {
    tc_ann_alias_decl.get(ann) ?? -1
}

// ── Match exhaustiveness (E0004) ─────────────────────────────────────
//
// Spec: sections/03_types.md "Exhaustiveness". Catalog: E0004 NonExhaustiveMatch.
//
// UNDER-APPROXIMATING BY DESIGN. This reports only what it can PROVE is
// non-exhaustive: a match whose scrutinee resolves to a declared enum, where some
// variant of that enum is named by no arm and no arm is a catch-all. Every shape it
// cannot reason about (Int/Str/Char scrutinees and their ranges, tuple and struct
// patterns, nested refutable sub-patterns) contributes nothing and stays silent.
//
// The asymmetry is deliberate and is the whole safety argument for turning this on
// in a self-hosting compiler: a FALSE NEGATIVE is a match that keeps its old
// behaviour, while a FALSE POSITIVE breaks a working program. So when in doubt this
// code counts a variant as COVERED. That is also why a variant with refutable
// sub-patterns (`Shape.Circle(0)`) counts as fully covering `Circle` — narrowing it
// would need range/nested analysis, which is not implemented, and guessing would
// reject valid code.

// Normalize a possibly-monomorphized enum instance tid (`Tree[Int]`) to its base
// declaration tid (`Tree`), the key evar_pool.enum_id is stored under. The enum twin
// of tc_struct_base_tid; a non-enum, bare, or unresolvable tid returns unchanged.
fn tc_enum_base_tid(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return tid }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Enum { return tid }
    if t.params_count == 0 { return tid }
    let base = lookup_named_type(strip_module_qualifier(t.name))
    if base == -1 { return tid }
    base
}

// Collect the variant names a single pattern covers into `covered`, and return 1 if
// the pattern is a CATCH-ALL (irrefutable) — in which case the match is exhaustive
// regardless of what else is present.
fn tc_exh_collect_pattern(pat: Int, covered: List[Str]) -> Int {
    if pat == -1 { return 0 }
    let pk = node_kind(pat)
    if pk == NodeKind.WildcardPattern { return 1 }
    if pk == NodeKind.IdentPattern {
        // A bare identifier is either a variant spelling (`Red`) or a binding that
        // matches anything (`other`). Coverage is only checked for match arms, which
        // are refutable.
        let nm = node_name(pat)
        if nm != "_" && !pattern_name_binds(nm, true) {
            covered.push(nm)
            return 0
        }
        return 1
    }
    if pk == NodeKind.EnumPattern {
        // Qualified `Color.Red` puts the type in `name` and the variant in
        // `type_name`; unqualified `Red(x)` puts the variant in `name`.
        let vname = node_name(pat)
        let tname = node_type_name(pat)
        if tname != "" {
            covered.push(tname)
        } else {
            covered.push(vname)
        }
        return 0
    }
    if pk == NodeKind.OrPattern {
        // Union of the alternatives (spec: "OR-patterns — union of covered patterns
        // per alternative"). A catch-all in any alternative makes the whole arm one.
        let alts = node_elements(pat)
        if alts == -1 { return 0 }
        let mut any_catch_all = 0
        let mut i = 0
        while i < sublist_length(alts) {
            if tc_exh_collect_pattern(sublist_get(alts, i), covered) != 0 { any_catch_all = 1 }
            i = i + 1
        }
        return any_catch_all
    }
    if pk == NodeKind.StructPattern {
        // A struct-STYLE variant written bare (`NotFound { msg }`, `Shared { only }`)
        // parses here, not as an EnumPattern — the parser only builds an EnumPattern
        // for the qualified `Type.Variant { .. }` form. Its `type_name` holds the bare
        // name. Missing this arm reported three exhaustive corpus matches as missing
        // variants, so it is load-bearing, not defensive.
        //
        // A genuine struct destructuring (`Point { x, y }`) also lands here; its name
        // is not a variant name, so it contributes nothing. A name that collides across
        // enums is safe too: coverage is compared against the SCRUTINEE enum's declared
        // variant list, which scopes the match.
        let sname = node_type_name(pat)
        if is_variant_name(sname) != 0 {
            covered.push(sname)
        }
        return 0
    }
    if pk == NodeKind.AsPattern {
        // `p as name` binds in addition to matching; coverage is the inner pattern's.
        return tc_exh_collect_pattern(node_pattern(pat), covered)
    }
    // Int/Str/Range/Tuple/List patterns cover no enum variant and are not catch-alls.
    // Contribute nothing.
    0
}

fn tc_check_match_exhaustive(node: Int, scrut_tid: Int, arms_sl: Int) ! TypeCheck.Report, Diag.Report {
    if arms_sl == -1 { return }
    let resolved = tc_resolve(scrut_tid)
    if type_kind(resolved) == TyKind.Typevar && tc_typevar_is_rigid(resolved) != 0 {
        tc_check_type_param_match_exhaustive(node, resolved, arms_sl)
        return
    }
    let base = tc_enum_base_tid(resolved)
    if base < 0 || base >= ty_pool.len() { return }
    if ty_pool.get(base).unwrap().kind != TyKind.Enum { return }

    // The declared variant set. An enum the registry knows nothing about (0 variants)
    // is unanalyzable, not vacuously non-exhaustive.
    let mut declared: List[Str] = []
    let mut i = 0
    while i < evar_pool.len() {
        let ev = evar_pool.get(i).unwrap()
        if ev.enum_id == base { declared.push(ev.name) }
        i = i + 1
    }
    if declared.len() == 0 { return }

    let mut covered: List[Str] = []
    let mut ai = 0
    while ai < sublist_length(arms_sl) {
        let arm = sublist_get(arms_sl, ai)
        // Guards are opaque (spec): a guarded arm may not fire, so it contributes
        // NOTHING — not its variants, and not its catch-all-ness.
        if node_guard(arm) == -1 {
            if tc_exh_collect_pattern(node_pattern(arm), covered) != 0 { return }
        }
        ai = ai + 1
    }

    let mut missing: List[Str] = []
    let mut di = 0
    while di < declared.len() {
        let want = declared.get(di).unwrap()
        let mut seen = 0
        let mut ci = 0
        while ci < covered.len() {
            if covered.get(ci).unwrap() == want { seen = 1 }
            ci = ci + 1
        }
        if seen == 0 { missing.push(want) }
        di = di + 1
    }
    if missing.len() == 0 { return }

    let ename = strip_module_qualifier(ty_pool.get(base).unwrap().name)
    let mut list_str = ""
    let mut mi = 0
    while mi < missing.len() {
        if mi > 0 { list_str = "{list_str}, " }
        list_str = "{list_str}`{missing.get(mi).unwrap()}`"
        mi = mi + 1
    }
    let noun = if missing.len() == 1 { "pattern" } else { "patterns" }
    diag_error_at("NonExhaustiveMatch", NON_EXHAUSTIVE_MATCH,
        "non-exhaustive match: missing {noun} {list_str}", node,
        "add an arm for {list_str}, or a `_ => ...` catch-all arm to absorb the rest of {ename}")
}

// A type parameter has no variants and no literals, so only an unguarded arm that matches
// every value covers it. This check does not trust the pattern checks to have caught a
// variant arm on the parameter: such a match would panic at run time.
fn tc_check_type_param_match_exhaustive(node: Int, tv: Int, arms_sl: Int) ! TypeCheck.Report, Diag.Report {
    let mut ai = 0
    while ai < sublist_length(arms_sl) {
        let arm = sublist_get(arms_sl, ai)
        if node_guard(arm) == -1 && tc_pattern_covers_type_param(node_pattern(arm)) { return }
        ai = ai + 1
    }
    diag_error_at("NonExhaustiveMatch", NON_EXHAUSTIVE_MATCH,
        "non-exhaustive match: a value of type parameter `{type_to_str(tv)}` is matched by no arm that always runs", node,
        "add a binding arm or a `_ => ...` catch-all arm")
}

// Whether a pattern matches every value of a type parameter. Only the case of a bare name
// decides here: a lowercase name binds even when some enum declares it as a variant, since
// no enum is the type at this position.
fn tc_pattern_covers_type_param(pat: Int) -> Bool {
    if pat == -1 { return false }
    let k = node_kind(pat)
    if k == NodeKind.WildcardPattern { return true }
    if k == NodeKind.IdentPattern { return !tc_name_is_upper(node_name(pat)) }
    if k == NodeKind.AsPattern { return tc_pattern_covers_type_param(node_pattern(pat)) }
    if k == NodeKind.OrPattern {
        let alts = node_elements(pat)
        if alts == -1 { return false }
        let mut i = 0
        while i < sublist_length(alts) {
            if tc_pattern_covers_type_param(sublist_get(alts, i)) { return true }
            i = i + 1
        }
    }
    false
}

// Bind a `with <expr> as x { .. }` resource name WITH its type.
//
// A resource clause is a declaration site, exactly like a `let`: the binder names the value
// of the resource expression. It was bound with the untyped `nr_define`, so the entry carried
// TYPE_UNKNOWN — which unifies with anything, so a declared type over `x.method()` was never
// compared and the arguments to that call were never checked. `with make() as r { let bad:
// Str = r.value() }` compiled, linked, ran and printed the Int.
//
// The type was never missing, only dropped: the resource expression is walked on the line
// below, and `with db.prepare(..).unwrap() as stmt` types all the way through the Result
// chain. So this is a binding, not a new inference path — one more instance of the
// untyped-receiver family (Ptr, ffi scope, self, Template), fixed by using the typed
// spelling that already exists.
//
// The tid is also published on the WithResource node itself, the way the LetBinding arm
// publishes a let's tid: infer_type memoizes expression nodes only, so a resource clause
// carried no tid at all and codegen's ScopeVar for the binder had nothing to read.
//
// An unresolvable resource binds TYPE_UNKNOWN, i.e. exactly what it bound before — which is
// what keeps `ffi.scope()` (not a Blink type at all) working unchanged.
// What `with <resource> as name` actually binds. Usually the resource itself, but a
// BlockHandler rebinds: the block sees `enter()`'s result, whose type the impl declares as
// `type Context`. Binding the resource unconditionally would resolve a field read against
// the wrong type whenever the two types share nothing but a position — including silently,
// when both spell the same field name at different types.
//
// Conservative by construction: anything this cannot answer — a non-nominal resource, an impl with
// no Context, a Context naming a type that does not resolve (a typevar on a generic handler) — falls
// back to the resource tid, which is exactly what every caller got before.
fn tc_with_binder_tid(res_tid: Int) -> Int ! TypeCheck.Resolve, Diag.Report {
    let rname = tc_tid_struct(res_tid)
    if rname == "" { return res_tid }
    let ctx_node = nr_bh_context.get(rname) ?? -1
    if ctx_node < 0 { return res_tid }
    let ctx_tid = tc_resolve(resolve_type_ann(node_type_ann(ctx_node)))
    if ctx_tid < 0 { return res_tid }
    // `type Context = Void` is the shape both stdlib handlers use (db_sqlite's Transaction,
    // testing's Cleanup): enter() returns nothing, so the handler does not rebind and the form is
    // `with sqlite_transaction(h) { ... }` with no `as` at all. Nothing to swap in.
    if tc_tid_kind(ctx_tid) == TyKind.Void { return res_tid }
    // A generic handler's `type Context = T` resolves to a typevar outside the binding instance.
    // Swapping a concrete resource tid for an unbound one trades a wrong answer for no answer, which
    // is worse for every downstream consumer. No generic BlockHandler impl exists in-tree yet, so
    // this guards the shape rather than a live case.
    let ctx_kind = tc_tid_kind(ctx_tid)
    if ctx_kind == TyKind.Typevar || ctx_kind == TyKind.Unknown { return res_tid }
    ctx_tid
}

// A with-item installs a Handler[E] or enters a scoped value, a type with a BlockHandler impl
// (sections/04_effects.md §4.7, Disambiguation rules). A Closeable type is one through the impl
// the parser writes for it. `as` only binds a name, so both item shapes come here. Nothing
// else has a meaning there. A type typecheck could not settle is left alone, so one mistake
// reads as one error. A type parameter is a scoped value only by its bound, and its Context
// is abstract in the body. The spec does not say what a Never item is. Until it does, one
// that `as` binds passes and one without `as` is E0839. Returns false when it reports the
// item.
fn tc_check_with_item(item: Int, tid0: Int, binds: Bool) -> Bool ! Diag.Report {
    let tid = tc_resolve(tid0)
    if tc_tid_is_no_info(tid) != 0 { return true }
    let k = tc_tid_kind(tid)
    if k == TyKind.Unknown || (k == TyKind.Never && binds) { return true }
    if k == TyKind.Typevar && tc_typevar_is_scoped(tid) { return true }
    // `ffi.scope()` is the arena the FFI chapter scopes with `with ... as` (§5.2).
    if k == TyKind.Handler || k == TyKind.FfiScope { return true }
    if tc_tid_has_scoped_impl(tid) { return true }
    // A handler or scoped value is usually acquired through a Result or an Option, and the
    // item then holds the carrier rather than the value it carries.
    let help = if k == TyKind.Result {
        "add ? or .unwrap() to use the value the Result holds"
    } else if k == TyKind.Option {
        "add ? or .unwrap() to use the value the Option holds"
    } else {
        "a with-item installs a Handler[E] or enters a scoped value: a type that implements BlockHandler or Closeable"
    }
    diag_error_at("NonHandlerWithItem", WITH_ITEM_NOT_A_HANDLER,
        "a with-item must be a Handler[E] or a scoped value, got {type_to_str(tid)}", item, help)
    false
}

// A type parameter is a scoped value when a bound says so. Every active frame of its binder
// is read, since an impl's `where` bounds it from a frame of its own. A typevar whose binder
// is not in scope here was not written in this body, so nothing is known and it passes.
fn tc_typevar_is_scoped(tid: Int) -> Bool {
    if tc_typevar_binds_here(tid) == 0 { return true }
    let binder = tc_tid_binder(tid)
    for f in tc_tp_frames {
        if f.binder == binder && (tc_pipe_has(f.traits, "BlockHandler") != 0 || tc_pipe_has(f.traits, "Closeable") != 0) {
            return true
        }
    }
    false
}

// Whether a type implements BlockHandler or Closeable. A Closeable impl counts on its own for
// a generic receiver, which gets no BlockHandler impl from the parser. The receiver is matched
// by its declaration node, which every instance of a generic type shares. An impl written for
// one instance cannot be told from another here, so it answers yes rather than refuse a
// program codegen may accept.
fn tc_tid_has_scoped_impl(tid: Int) -> Bool ! Diag.Report {
    let decl = tc_tid_decl_node(tid)
    if decl < 0 { return false }
    for im in tc_impl_recv_tids.keys() {
        let trait_id = tc_impl_trait_id(im)
        if (trait_id == "BlockHandler" || trait_id == "Closeable") && tc_tid_decl_node(tc_impl_recv_tid(im)) == decl {
            return true
        }
    }
    false
}

fn tc_bind_with_resource(item: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let res_expr = node_value(item)
    let prev_res = tc_with_resource_node
    tc_with_resource_node = res_expr
    tc_check_body(res_expr)
    let res_tid = infer_type(res_expr)
    tc_with_resource_node = prev_res
    // A refused item binds its name with no type, so uses in the body do not repeat the error.
    let bind_tid = if tc_check_with_item(res_expr, res_tid, true) { tc_with_binder_tid(res_tid) } else { tc_unknown_tid() }
    // The node's tid is the BINDER's type, not the resource expression's: codegen's only consumer
    // reads it to stamp the binder's ScopeVar, so keeping the resource type here would just move
    // the same wrong answer one phase later.
    if item < tc_node_tid.len() && tc_tid_is_no_info(bind_tid) == 0 {
        tc_node_tid.set(item, bind_tid)
    }
    nr_define_typed(node_name(item), 0, bind_tid, item)
}

// Block branch genuinely save/restores scope via nr_push_scope/nr_pop_scope;
// the recursive tc_check_body and other nr_* writes fall outside that pattern,
// which the analyzer correctly flags.
@allow(UnrestoredMutation, IncompleteStateRestore)
// Which collection methods the spec calls mutating, keyed by RECEIVER KIND and not by
// bare method name: `insert`/`remove`/`set`/`clear` are all ordinary user method names
// too, and a name-only key would reject `my_widget.set(3)`.
//
// The set comes from the per-type tables' `Mutates` column (sections/03_types.md:369, :430,
// :485) and NOT from the trait blocks' "// Mutation (requires let mut)" comments — the
// MapOps block files `contains_key` under that comment while its own table row says
// Mutates=no. It is also NOT pp_is_mutating_method (:4718), which is the @pure walker's
// list and includes `append`, marked Mutates=no.
fn tc_is_mutating_collection_method(k: TyKind, method: Str) -> Int {
    if k == TyKind.List {
        return method == "push" || method == "pop" || method == "set" || method == "clear" || method == "insert" || method == "remove"
    }
    if k == TyKind.Map {
        return method == "insert" || method == "remove" || method == "clear"
    }
    if k == TyKind.Set {
        return method == "insert" || method == "remove"
    }
    0
}

// The rows of the per-type tables of ListOps, MapOps and SetOps (sections/03_types.md §3.2.2),
// keyed by receiver kind. A List also answers the eager adapters `map`, `filter`, `take` and
// `skip`, which return a List too, but they are not rows, and the discarded-copy rule is drawn
// by the tables.
fn tc_collection_ops_row(k: TyKind, method: Str) -> Bool {
    if method == "len" || method == "is_empty" || method == "contains" {
        return k == TyKind.List || k == TyKind.Map || k == TyKind.Set
    }
    if k == TyKind.List {
        if method == "get" || method == "last" || method == "index_of" || method == "capacity" || method == "join" { return true }
        if method == "push" || method == "pop" || method == "set" || method == "insert" || method == "remove" || method == "clear" { return true }
        return method == "append" || method == "slice" || method == "reverse" || method == "sort" || method == "sort_by"
    }
    if k == TyKind.Map { return tc_map_surface_has(method) != 0 }
    if k == TyKind.Set { return method == "insert" || method == "remove" || method == "union" }
    false
}

// The name the help binds a dropped copy to.
fn tc_discarded_copy_binding(method: Str) -> Str {
    if method == "append" { return "appended" }
    if method == "slice" { return "sliced" }
    if method == "reverse" { return "reversed" }
    if method == "sort" || method == "sort_by" { return "sorted" }
    if method == "union" { return "combined" }
    "copy"
}

// `node` has been walked and its value is dropped: it is a statement before its block's tail,
// the tail of a function that returns nothing, or a loop body. A dropped `if`, `match` or block
// drops the value of each branch tail in turn. Only tails are followed: the statements before
// a nested block's tail are that block's own walk's business.
fn tc_check_dropped_value(node: Int) ! Diag.Report {
    if node == -1 { return }
    let k = node_kind(node)
    if k == NodeKind.MethodCall {
        tc_check_discarded_copy(node)
        return
    }
    if k == NodeKind.ExprStmt {
        tc_check_dropped_value(node_value(node))
        return
    }
    if k == NodeKind.Block {
        tc_check_dropped_value(tc_block_tail_stmt(node))
        return
    }
    if k == NodeKind.IfExpr {
        tc_check_dropped_value(node_then_body(node))
        tc_check_dropped_value(node_else_body(node))
        return
    }
    if k == NodeKind.MatchExpr {
        let arms_sl = node_arms(node)
        if arms_sl == -1 { return }
        let mut i = 0
        while i < sublist_length(arms_sl) {
            tc_check_dropped_value(node_body(sublist_get(arms_sl, i)))
            i = i + 1
        }
        return
    }
    if k == NodeKind.WithBlock || k == NodeKind.AsyncScope { tc_check_dropped_value(node_body(node)) }
}

// W0606. A table row that does not mutate and returns the receiver's own type hands back a
// new collection and leaves the receiver as it was, so as a statement its only output is
// dropped. Both facts are read off the row and the call's type, not off a list of names, so a
// row that later lands with that signature is covered as it lands.
fn tc_check_discarded_copy(val: Int) ! Diag.Report {
    if val == -1 || node_kind(val) != NodeKind.MethodCall { return }
    let obj = node_obj(val)
    if obj == -1 { return }
    let recv = tc_resolve(tc_lookup_node_tid(obj))
    if recv < 0 { return }
    let recv_t = resolve_alias_tid(recv)
    let k = type_kind(recv_t)
    let method = node_method(val)
    if !tc_collection_ops_row(k, method) { return }
    if tc_is_mutating_collection_method(k, method) != 0 { return }
    if resolve_alias_tid(tc_resolve(tc_lookup_node_tid(val))) != recv_t { return }
    let what = if k == TyKind.Set { "set" } else if k == TyKind.Map { "map" } else { "list" }
    let call = unparse_expr(val)
    let mut fix = "let {tc_discarded_copy_binding(method)} = {call}"
    // Read off the binder, not the scope: the call may sit in a branch whose scope is gone.
    if node_kind(obj) == NodeKind.Ident {
        let binder = tc_ident_binder_node(obj)
        if binder != -1 && node_is_mut(binder) != 0 { fix = "{node_name(obj)} = {call}" }
    }
    diag_warn_at("DiscardedCollectionCopy", DISCARDED_COLLECTION_COPY,
        "`{method}` returns a new {what} and leaves the receiver unchanged; the result is discarded",
        val, "use the result: `{fix}`")
}

// The pattern site that holds `binder`: the destructuring `let` or the `for` it sits in, or the
// top pattern of its match arm; -1 when none does. Only an error asks, so this scans rather than
// keep a table for every binder. A site is parsed next to its pattern, so the scan starts at the
// binder and works outward.
fn tc_binder_site(binder: Int) -> Int {
    let n = node_count()
    let mut d = 1
    while binder - d >= 0 || binder + d < n {
        let below = tc_site_holding(binder - d, binder)
        if below != -1 { return below }
        let above = tc_site_holding(binder + d, binder)
        if above != -1 { return above }
        d = d + 1
    }
    -1
}

fn tc_site_holding(node: Int, binder: Int) -> Int {
    if node < 0 || node >= node_count() { return -1 }
    let k = node_kind(node)
    if k == NodeKind.LetBinding && tc_pattern_holds(node_elements(node), binder) != 0 { return node }
    if k == NodeKind.ForIn && (node_for_binder(node) == binder || tc_pattern_holds(node_elements(node), binder) != 0) { return node }
    if k == NodeKind.MatchArm && tc_pattern_holds(node_pattern(node), binder) != 0 { return node_pattern(node) }
    -1
}

// The pattern a site binds through: the site itself for a match arm.
fn tc_site_pattern(site: Int) -> Int {
    let k = node_kind(site)
    if k == NodeKind.LetBinding || k == NodeKind.ForIn { node_elements(site) } else { site }
}

// 0 when `target` is not a node of pattern `pat`, 2 when an OR-pattern holds it, else 1.
fn tc_pattern_holds(pat: Int, target: Int) -> Int {
    if pat == -1 { return 0 }
    if pat == target { return 1 }
    let k = node_kind(pat)
    let mut found = 0
    if k == NodeKind.TuplePattern || k == NodeKind.ListPattern || k == NodeKind.OrPattern {
        found = tc_patterns_hold(node_elements(pat), target)
    } else if k == NodeKind.EnumPattern || k == NodeKind.StructPattern {
        found = tc_patterns_hold(node_fields(pat), target)
    } else if k == NodeKind.AsPattern || k == NodeKind.StructLitField {
        found = tc_pattern_holds(node_pattern(pat), target)
    }
    if found != 0 && k == NodeKind.OrPattern { 2 } else { found }
}

fn tc_patterns_hold(sl: Int, target: Int) -> Int {
    if sl == -1 { return 0 }
    let mut i = 0
    while i < sublist_length(sl) {
        let found = tc_pattern_holds(sublist_get(sl, i), target)
        if found != 0 { return found }
        i = i + 1
    }
    0
}

// The pattern that holds `binder`, as the user wrote it, with `mut ` before the binder: `let (mut
// a, b)`, `for (k, mut v) in pairs`, `Point { mut x, .. }`. "" when the pattern spans lines or the
// source cannot be read, so the caller falls back to a help with no quote.
fn tc_binder_fix_preview(binder: Int, site: Int) -> Str {
    if site == -1 { return "" }
    let line = node_line(binder)
    let col = node_col(binder)
    if node_line(site) != line || node_col(site) > col { return "" }
    let sk = node_kind(site)
    let mut end_line = node_end_line(site)
    let mut end_col = node_end_col(site)
    if sk == NodeKind.LetBinding {
        let pat = node_elements(site)
        end_line = node_end_line(pat)
        end_col = node_end_col(pat)
    } else if sk == NodeKind.ForIn {
        // A `for` ends at its body, so the quote runs up to the body's `{`.
        let body = node_body(site)
        if body == -1 { return "" }
        end_line = node_line(body)
        end_col = node_col(body)
    }
    if end_line != line || end_col <= col { return "" }
    let text = diag_source_line(diag_file_for_node(binder), line)
    if end_col - 1 > text.byte_len() { return "" }
    "{text.byte_slice(node_col(site) - 1, col - 1)}mut {text.byte_slice(col - 1, end_col - 1).trim()}"
}

// E0610 for a write or a mutating call whose root `name` is a pattern binder with no `mut`: a name
// of a destructuring `let`, of a `for` or match pattern, an `as` name, or the name after `with ...
// as` (sections/03_types.md §3.5 *Mutable Binders*). False when the root is not such a binder, so
// the caller goes on to its own cases. A parameter is not a binder here: its root is another case.
fn tc_report_immutable_binder(name: Str, message: Str, at: Int) -> Bool ! Diag.Report {
    let idx = nr_top_index(name)
    if idx == -1 { return false }
    if nr_scope_muts.get(idx).unwrap() != 0 { return false }
    let decl = nr_scope_nodes.get(idx).unwrap()
    if decl < 0 { return false }
    let k = node_kind(decl)
    let mut notes = ["declared here: `{name}` in the pattern at line {node_line(decl)}"]
    if nr_index_is_global(idx) != 0 {
        // Every module's globals share one flat scope, so the binder must be this module's own
        // module-level `let` leaf.
        if k != NodeKind.IdentPattern || tc_module_let_decl_node(nr_current_module, name) != decl { return false }
        let preview = tc_binder_fix_preview(decl, tc_binder_site(decl))
        let edit = if preview != "" { "write `{preview}`" } else { "add `mut` before `{name}` in its pattern" }
        tc_errors.push(message)
        diag_error_at_notes("MutationRequiresMut", MUTATION_REQUIRES_MUT, message, at,
            "{edit} only if it must change: `mut` adds `State` to the row of each function that reads or writes it (§4.16)", notes)
        return true
    }
    if k == NodeKind.WithResource {
        notes = ["declared here: `with ... as {name}` at line {node_line(decl)}"]
        tc_errors.push(message)
        diag_error_at_notes("MutationRequiresMut", MUTATION_REQUIRES_MUT, message, at,
            "bind a new `let mut` name inside the block; the name after `as` is never `mut` (§2.18)", notes)
        return true
    }
    if k != NodeKind.IdentPattern && k != NodeKind.AsPattern && k != NodeKind.StructLitField { return false }
    let site = tc_binder_site(decl)
    if site != -1 && tc_pattern_holds(tc_site_pattern(site), decl) == 2 {
        return tc_report_immutable_or_binder(name, message, at, decl, site, idx, notes)
    }
    let preview = tc_binder_fix_preview(decl, site)
    let in_closure = tc_closure_scope_base.len() > 0 && idx < tc_closure_scope_base.get(tc_closure_scope_base.len() - 1).unwrap()
    if in_closure { notes.push("captured here: the closure that makes this write captures `{name}`") }
    let line = node_line(decl)
    let col = node_col(decl)
    // The fix rewrites the binder's own name, so each write to one binder gives the same edit. It
    // is withheld only when the source is readable and the name is not where the node says.
    let text = diag_source_line(diag_file_for_node(decl), line)
    let name_end = col - 1 + name.byte_len()
    let at_name = text == "" || (name_end <= text.byte_len() && text.byte_slice(col - 1, name_end) == name)
    let help = if preview != "" { "declare it `mut` where the pattern binds it: `{preview}`" } else { "declare it `mut` where the pattern binds it: `mut {name}`" }
    tc_errors.push(message)
    let before = diag_entry_count()
    diag_error_at_notes("MutationRequiresMut", MUTATION_REQUIRES_MUT, message, at, help, notes)
    if at_name && diag_entry_count() > before {
        diag_set_last_fix_at("insert `mut`", "mut {name}", line, col, line, col + name.byte_len())
    }
    true
}

// E0610 for a binder an OR-pattern holds. Each alternative binds the name (§3.5 *OR-Patterns*),
// so the fix puts `mut` before the binder in every alternative: one edit from the first binder
// to the last, which needs them all on one line with the name where each node says.
fn tc_report_immutable_or_binder(name: Str, message: Str, at: Int, decl: Int, site: Int, idx: Int, notes0: List[Str]) -> Bool ! Diag.Report {
    let pat = tc_site_pattern(site)
    // In a match arm, a name `mut` in some alternatives and not others is already E0005, whose fix
    // is this one.
    let sk = node_kind(site)
    if sk != NodeKind.LetBinding && sk != NodeKind.ForIn && tc_has_mut_binder(pat, name) { return true }
    let mut notes = notes0
    let in_closure = tc_closure_scope_base.len() > 0 && idx < tc_closure_scope_base.get(tc_closure_scope_base.len() - 1).unwrap()
    if in_closure { notes.push("captured here: the closure that makes this write captures `{name}`") }
    let mut binders: List[Int] = []
    tc_binders_named(pat, name, binders)
    let line = node_line(decl)
    let text = diag_source_line(diag_file_for_node(decl), line)
    let mut ok = text != "" && binders.len() > 0
    for b in binders {
        let k = node_kind(b)
        let name_end = node_col(b) - 1 + name.byte_len()
        if k != NodeKind.IdentPattern && k != NodeKind.StructLitField {
            ok = false
        } else if node_line(b) != line || name_end > text.byte_len() || text.byte_slice(node_col(b) - 1, name_end) != name { ok = false }
    }
    let mut fix = ""
    let mut fix_col = 0
    let mut fix_end = 0
    let mut preview = ""
    if ok {
        fix_col = node_col(binders.get(0).unwrap())
        fix_end = node_col(binders.get(binders.len() - 1).unwrap()) + name.byte_len()
        fix = tc_insert_mut_before(text, binders, fix_col, fix_end)
        if node_line(pat) == line && node_end_line(pat) == line && node_col(pat) <= fix_col && node_end_col(pat) >= fix_end && node_end_col(pat) - 1 <= text.byte_len() {
            preview = tc_insert_mut_before(text, binders, node_col(pat), node_end_col(pat)).trim()
        }
    }
    let help = if preview != "" { "declare it `mut` in every alternative that binds it: `{preview}`" } else { "declare it `mut` in every alternative that binds it: `mut {name}`" }
    tc_errors.push(message)
    let before = diag_entry_count()
    diag_error_at_notes("MutationRequiresMut", MUTATION_REQUIRES_MUT, message, at, help, notes)
    if ok && diag_entry_count() > before {
        diag_set_last_fix_at("insert `mut`", fix, line, fix_col, line, fix_end)
    }
    true
}

// Source columns [from, to) of `text`, with `mut ` before each of `binders`, which sit in that
// range in source order.
fn tc_insert_mut_before(text: Str, binders: List[Int], from: Int, to: Int) -> Str {
    let mut out = ""
    let mut c = from
    for b in binders {
        out = "{out}{text.byte_slice(c - 1, node_col(b) - 1)}mut "
        c = node_col(b)
    }
    "{out}{text.byte_slice(c - 1, to - 1)}"
}

// Every node in `pat` that binds `name` with no `mut`, in every alternative, in source order.
fn tc_binders_named(pat: Int, name: Str, out: List[Int]) {
    if pat == -1 { return }
    let k = node_kind(pat)
    if node_name(pat) == name && node_is_mut(pat) != 0 && (k == NodeKind.IdentPattern || k == NodeKind.StructLitField) { return }
    if k == NodeKind.IdentPattern {
        if node_name(pat) == name { out.push(pat) }
    } else if k == NodeKind.AsPattern {
        tc_binders_named(node_pattern(pat), name, out)
        if node_name(pat) == name && node_is_mut(pat) == 0 { out.push(pat) }
    } else if k == NodeKind.TuplePattern || k == NodeKind.ListPattern || k == NodeKind.OrPattern {
        tc_binders_named_in(node_elements(pat), name, out)
    } else if k == NodeKind.EnumPattern || k == NodeKind.StructPattern {
        tc_binders_named_in(node_fields(pat), name, out)
    } else if k == NodeKind.StructLitField {
        if node_pattern(pat) == -1 {
            if node_name(pat) == name { out.push(pat) }
        } else {
            tc_binders_named(node_pattern(pat), name, out)
        }
    }
}

// Whether some node in `pat` binds `name` with `mut`, in any alternative.
fn tc_has_mut_binder(pat: Int, name: Str) -> Bool {
    if pat == -1 { return false }
    let k = node_kind(pat)
    if k == NodeKind.IdentPattern || (k == NodeKind.StructLitField && node_pattern(pat) == -1) {
        return node_name(pat) == name && node_is_mut(pat) != 0
    }
    if k == NodeKind.AsPattern {
        if node_name(pat) == name && node_is_mut(pat) != 0 { return true }
        return tc_has_mut_binder(node_pattern(pat), name)
    }
    if k == NodeKind.StructLitField { return tc_has_mut_binder(node_pattern(pat), name) }
    let mut sl = -1
    if k == NodeKind.TuplePattern || k == NodeKind.ListPattern || k == NodeKind.OrPattern {
        sl = node_elements(pat)
    } else if k == NodeKind.EnumPattern || k == NodeKind.StructPattern {
        sl = node_fields(pat)
    }
    if sl == -1 { return false }
    let mut i = 0
    while i < sublist_length(sl) {
        if tc_has_mut_binder(sublist_get(sl, i), name) { return true }
        i = i + 1
    }
    false
}

fn tc_binders_named_in(sl: Int, name: Str, out: List[Int]) {
    if sl == -1 { return }
    let mut i = 0
    while i < sublist_length(sl) {
        tc_binders_named(sublist_get(sl, i), name, out)
        i = i + 1
    }
}

// sections/03_types.md:302 — "Mutating methods require the binding to be `let mut`", with
// `names.push("Dave")  // COMPILE ERROR` at :316. The rationale at :320 is that `grep "let
// mut"` must find every mutation source, so the check has to key on the BINDING, which is
// why only a bare-Ident receiver is in scope: `mk_list().push(1)` mutates a temporary that
// no binding names.
//
// A parameter is a separate and currently unrestricted mutation source — `fn f(xs:
// List[Int]) { xs.push(9) }` mutates the caller's list — and whether the rule reaches there
// is a live spec question, so params are left alone. nr_is_mut answers 0 for a
// param exactly as it does for a plain `let`, so is_mut alone cannot tell them apart: the
// binder identity has to come from the decl node. A pattern binder and the name after `with ...
// as` go to tc_report_immutable_binder, as a write does.
fn tc_check_mutating_method(node: Int, obj: Int, obj_t: Int) ! Diag.Report {
    if obj == -1 { return }
    if node_kind(obj) != NodeKind.Ident { return }
    let name = node_name(obj)
    if nr_has_binding(name) == 0 { return }
    if nr_is_mut(name) != 0 { return }
    let method = node_method(node)
    if tc_is_mutating_collection_method(type_kind(resolve_alias_tid(obj_t)), method) == 0 { return }
    if tc_report_immutable_binder(name, "cannot call mutating method `.{method}` on immutable binding `{name}`", node) { return }
    let decl = nr_binding_node(name)
    if decl == -1 || node_kind(decl) != NodeKind.LetBinding { return }
    tc_errors.push("cannot call mutating method `{method}` on immutable binding `{name}`")
    // The span points at the CALL, because that is what the reader is looking at, so the help
    // has to carry the line of the `let` — otherwise a long function makes the reader hunt for
    // which of several same-named bindings is in scope here.
    diag_error_at("MutationRequiresMut", MUTATION_REQUIRES_MUT, "cannot call mutating method `.{method}` on immutable binding `{name}`", node, "declare it as `let mut {name}` at line {node_line(decl)}")
}

// §2.22 *Writes that are not to a place*, cases 1 and 4: `=` or `op=` whose path steps
// through a `Ptr`, then one whose root is a plain `let`. Runs once the path's types are
// known. A temporary root and a parameter root, the cases between them in the spec's order,
// are other errors and take the write. A pattern binder and the name after `with ... as` go
// to tc_report_immutable_binder.
fn tc_check_assign_root(node: Int) ! Diag.Report {
    let target = node_target(node)
    let mut root = target
    while node_kind(root) == NodeKind.FieldAccess || node_kind(root) == NodeKind.IndexExpr {
        let obj = node_obj(root)
        if obj == -1 { return }
        let obj_t = tc_resolve(tc_lookup_node_tid(obj))
        if type_kind(resolve_alias_tid(obj_t)) == TyKind.Ptr {
            // A step the pointee does not have is reported where it is typed, and `.write()`
            // on it would be no fix.
            if tc_tid_is_no_info(tc_lookup_node_tid(root)) == 0 { tc_report_write_through_ptr(node, obj, obj_t) }
            return
        }
        root = obj
    }
    if node_kind(root) != NodeKind.Ident { return }
    let name = node_name(root)
    let idx = nr_top_index(name)
    if idx == -1 { return }
    let message = if root == target { "cannot assign to `{name}`, which is not `mut`" } else { "cannot assign to `{unparse_expr(target)}`, whose root `{name}` is not `mut`" }
    if tc_report_immutable_binder(name, message, target) { return }
    let global = nr_index_is_global(idx) != 0
    // Every module's globals share one flat scope, so the newest spelling may be another
    // module's; the declaration this module sees decides.
    let decl = if global { nr_resolve_bare_decl(name, nr_current_module) } else { nr_scope_nodes.get(idx).unwrap() }
    if decl < 0 || node_kind(decl) != NodeKind.LetBinding { return }
    let is_mut = if global { node_is_mut(decl) } else { nr_scope_muts.get(idx).unwrap() }
    if is_mut != 0 { return }
    if node_elements(decl) != -1 || node_is_const(decl) != 0 { return }
    let mut notes = ["declared here: `let {name}` at line {node_line(decl)}"]
    let decl_module = node_module(decl)
    let imported = global && decl_module != "" && decl_module != nr_current_module
    if imported {
        notes = ["declared here: `pub let {name}` at {diag_normalize_path(diag_file_for_node(decl))}:{node_line(decl)}"]
    }
    let in_closure = !global && tc_closure_scope_base.len() > 0 && idx < tc_closure_scope_base.get(tc_closure_scope_base.len() - 1).unwrap()
    if in_closure { notes.push("captured here: the closure that makes this write captures `{name}`") }
    tc_errors.push(message)
    if !global {
        let before = diag_entry_count()
        diag_error_at_notes("MutationRequiresMut", MUTATION_REQUIRES_MUT, message, target, "declare it `let mut {name}`", notes)
        // The span is the `let` keyword, so every write to one root gives the same edit.
        if diag_entry_count() > before {
            diag_set_last_fix_at("insert `mut`", "let mut", node_line(decl), node_col(decl), node_line(decl), node_col(decl) + 3)
        }
        return
    }
    if imported {
        diag_error_at_notes("MutationRequiresMut", MUTATION_REQUIRES_MUT, message, target,
            "`{name}` is a `pub let` of module `{tc_get_dotted_module_path(decl_module)}`, and `pub let mut` is not allowed (E1013); copy it into a local `let mut`", notes)
        return
    }
    diag_error_at_notes("MutationRequiresMut", MUTATION_REQUIRES_MUT, message, target,
        "declare it `let mut {name}` only if it must change: `mut` adds `State` to the row of each function that reads or writes it (§4.16)", notes)
}

// `place = rhs` runs `rhs` before it reads the root, but `p.f.write(rhs)` reads `p` before
// its argument runs, so the help writes `rhs` in place only when it runs no code, and else
// binds it on the line before. Help only: no fix is applied.
fn tc_report_write_through_ptr(node: Int, ptr: Int, ptr_t: Int) ! Diag.Report {
    let message = "cannot assign through a `Ptr`"
    let mut notes = ["a field behind a `Ptr` is not a place; write it with `.write()`"]
    let target = node_target(node)
    let path = tc_index_text(target)
    let ptr_text = tc_index_text(ptr)
    let label = if ptr_text == "" { "" } else { "`{ptr_text}` is a `{type_to_str(ptr_t)}`" }
    // A part the help cannot quote is written as a placeholder, as the index-store help does.
    let pp = if path == "" { "p.f" } else { path }
    let val = node_value(node)
    let rhs = tc_index_text(val)
    let mut help = ""
    if node_kind(node) == NodeKind.CompoundAssign {
        notes.push("this is a read and then a write, not one atomic step")
        let read_op = if rhs == "" { "{pp}.read() {node_op(node)} ..." } else { unparse_binop_with_lhs("{pp}.read()", node_op(node), val) }
        help = "`{pp}.write({read_op})`"
    } else if rhs != "" && tc_runs_no_code(val) {
        help = "`{pp}.write({rhs})`"
    } else {
        // The target is a field step, since an index target never reaches here; a tuple
        // step such as `p.0` names no binding.
        let field = node_name(target)
        let base = if field == "" || tc_is_decimal_digits(field) { "v" } else { field }
        let name = tc_name_not_in_scope(base)
        let shown = if rhs == "" { "..." } else { rhs }
        let who = if ptr_text == "" { "the `Ptr`" } else { "`{ptr_text}`" }
        notes.push("the right side runs before {who} is read, so the fix keeps it on its own line")
        help = "`let {name} = {shown}`, then `{pp}.write({name})`"
    }
    tc_errors.push(message)
    diag_error_label_at_notes("NotAPlace", NOT_A_PLACE, message, target, label, help, notes)
}

// `base`, or the first of `base_1`, `base_2`, ... that names nothing in scope here, so a
// binding the help adds shadows nothing the line reads.
fn tc_name_not_in_scope(base: Str) -> Str {
    if nr_has_binding(base) == 0 { return base }
    let mut i = 1
    while nr_has_binding("{base}_{i}") != 0 { i = i + 1 }
    "{base}_{i}"
}

// §2.22: a literal, a name, or a field path of names. It has no operator, call or other
// sub-expression, so it cannot run code.
fn tc_runs_no_code(node: Int) -> Bool {
    let k = node_kind(node)
    if k == NodeKind.IntLit || k == NodeKind.FloatLit || k == NodeKind.CharLit || k == NodeKind.BoolLit || k == NodeKind.Ident {
        return true
    }
    if k == NodeKind.UnaryOp && node_op(node) == "-" {
        let operand = node_left(node)
        return operand != -1 && (node_kind(operand) == NodeKind.IntLit || node_kind(operand) == NodeKind.FloatLit)
    }
    if k == NodeKind.InterpString { return tc_is_plain_string_literal(node) }
    if k == NodeKind.FieldAccess { return tc_index_receiver_is_path(node) }
    false
}

// The mutation check above runs from tc_check_body's MethodCall arm, which is reached only in
// statement/initializer position, so a mutating call written as an ARGUMENT is never checked —
// the same mutation on the same binding caught or allowed by syntactic position alone. The
// generic walk deliberately does not recurse into argument expressions (infer_type has already
// visited them and re-walking invents duplicate diagnostics), so this descends for the mutation
// check ONLY.
//
// Closure arguments are skipped: tc_check_callable_arg_bodies routes those through tc_check_body,
// which reaches their statements by the normal path.
fn tc_check_mutating_in_args(args_sl: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if args_sl == -1 { return }
    let mut i = 0
    while i < sublist_length(args_sl) {
        tc_check_mutating_nested(sublist_get(args_sl, i))
        i = i + 1
    }
}

fn tc_check_mutating_nested(n: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if n == -1 { return }
    let k = node_kind(n)
    if k == NodeKind.Closure { return }
    if k == NodeKind.MethodCall {
        let obj = tc_mc_receiver(n)
        // Gated on Ident before infer_type runs. tc_check_mutating_method rejects every other
        // object kind anyway, and inferring here would re-report infer_type's own diagnostics.
        if obj != -1 && node_kind(obj) == NodeKind.Ident {
            tc_check_mutating_method(n, obj, tc_infer_receiver(obj))
        }
        tc_check_mutating_nested(obj)
        tc_check_mutating_in_args(tc_mc_call_args(n))
        return
    }
    if k == NodeKind.Call {
        tc_check_mutating_in_args(node_args(n))
    }
}

// A statement-position value (the tail of a block, or the operand of an explicit
// `return`) leaves the function the same way whether it is a bare ExprStmt tail
// or a `return`, so both sites re-dispatch the SAME node kinds into tc_check_body:
// infer_type types only a value's signature/shape, never the bodies nested inside
// a closure, a handler's methods, a call's closure arguments, or a struct
// literal's block-valued fields. Each kind here carries such a body. Keeping the
// two gates on one predicate stops them from drifting — the tail gate once carried
// Closure/HandlerExpr while the return gate carried only StructLit, and returned
// handler/closure bodies went unwalked as a result.
fn tc_stmt_value_walks_body(vk: NodeKind) -> Bool {
    is_block_bearing(vk) || vk == NodeKind.MethodCall || vk == NodeKind.Call || vk == NodeKind.StructLit || vk == NodeKind.Closure || vk == NodeKind.HandlerExpr
}

// A statement's VALUE, after it has been inferred: the walk inference itself does not do.
// A block-bearing value needs its non-tail statements walked (`y = if c { return 7 } else
// { return 8 }` typed neither return operand); every other shape can still HIDE one
// (`rows.find(fn(e) { .. }).unwrap().val` is a FieldAccess, so the first test says no and
// nothing walked the closure). The nested walk descends the value-carrying shapes only and
// routes each call it finds to tc_check_body, so both branches stay as narrow as each other.
// @allow: publishing types IS this function's effect, so there is nothing to restore.
@allow(UnrestoredMutation)
fn tc_walk_stmt_value(val: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if val == -1 { return }
    if tc_stmt_value_walks_body(node_kind(val)) {
        tc_check_body(val)
    } else {
        tc_walk_nested_hof_bodies(val)
    }
}

// An assignment right-hand side: expression context (§2.9), so an else-less `if` (no value on
// the false path) is rejected, then walked like any other statement value.
//
// Inferred under the TARGET's type as its construction hint, the same channel a let annotation
// opens and for the same reason. A value with no type of its own is the only kind that reads
// the hint — the arena allocators name their pointee from nothing else, so `p = scope.alloc_n(4)`
// had no pointee at all while this site was missing — and a value that has its own type is
// unaffected, so the caller's compare still fires on a disagreement. Only the inference runs
// under the hint, as at the let site: the body walk that follows types nested constructs
// against their own expectations, not against this statement's.
// @allow: as tc_walk_stmt_value.
@allow(UnrestoredMutation)
fn tc_infer_assigned_value(target_t: Int, val: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    // The target gives the value its type as a typed `let` does: a literal takes it, and a
    // closure takes its signature from it.
    tc_seed_expected_into_value(val, target_t)
    let t = tc_infer_value_under(target_t, val)
    let reread = tc_value_awaits_closure_ret(val)
    tc_walk_stmt_value(val)
    if reread { return tc_infer_value_under(target_t, val) }
    t
}

// @allow: the hint is restored before the return.
@allow(UnrestoredMutation)
fn tc_infer_value_under(target_t: Int, val: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let saved_hint = tc_construct_hint
    if tc_tid_is_no_info(target_t) == 0 { tc_construct_hint = resolve_alias_tid(target_t) }
    let t = tc_infer_value(val)
    tc_construct_hint = saved_hint
    t
}

// One arm of a statement-position match: its guard, then its body.
// @allow: as tc_walk_stmt_value.
@allow(UnrestoredMutation)
fn tc_check_stmt_match_arm(arm: Int, in_value: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    tc_check_arm_guard(arm)
    tc_walk_value_tail = in_value
    tc_check_body(node_body(arm))
}

// Whether a type has no variants at all, so that no in-scope reading of an enum-variant
// pattern could make an arm over it well typed. Deliberately the builtin scalars only: an
// enum is already correct, a carrier's variants are Some/Ok/Err, and anything unsolved is
// not yet decidable.
fn tc_kind_has_no_variants(tid: Int) -> Int {
    if tid < 0 { return 0 }
    match type_kind(tid) {
        TyKind.Int => 1
        TyKind.Float => 1
        TyKind.Bool => 1
        TyKind.Str => 1
        TyKind.Char => 1
        TyKind.I8 => 1
        TyKind.I16 => 1
        TyKind.I32 => 1
        TyKind.U8 => 1
        TyKind.U16 => 1
        TyKind.U32 => 1
        TyKind.U64 => 1
        _ => 0
    }
}

// error[InconsistentPatternBindings] (E0005) for each OR-pattern in `pat`, at any depth, whose
// alternatives do not bind the same names at the same types (§3.5 *OR-Patterns*). One error per
// OR-pattern, with a note for each name an alternative misses and each name whose type differs.
// Reported from the statement walk, which visits each match arm once.
fn tc_check_or_pattern_bindings(pat: Int) ! Diag.Report {
    if pat == -1 { return }
    let k = node_kind(pat)
    if k == NodeKind.OrPattern {
        tc_report_or_pattern_bindings(pat)
        tc_check_or_bindings_in(node_elements(pat))
    } else if k == NodeKind.TuplePattern || k == NodeKind.ListPattern {
        tc_check_or_bindings_in(node_elements(pat))
    } else if k == NodeKind.EnumPattern || k == NodeKind.StructPattern {
        tc_check_or_bindings_in(node_fields(pat))
    } else if k == NodeKind.AsPattern || k == NodeKind.StructLitField {
        tc_check_or_pattern_bindings(node_pattern(pat))
    }
}

fn tc_check_or_bindings_in(sl: Int) ! Diag.Report {
    if sl == -1 { return }
    let mut i = 0
    while i < sublist_length(sl) {
        tc_check_or_pattern_bindings(sublist_get(sl, i))
        i = i + 1
    }
}

fn tc_report_or_pattern_bindings(or_pat: Int) ! Diag.Report {
    let alts = node_elements(or_pat)
    if alts == -1 { return }
    let n = sublist_length(alts)
    // Each alternative's binders, flattened: alt_start[i] is where alternative i's begin.
    let mut names: List[Str] = []
    let mut nodes: List[Int] = []
    let mut alt_start: List[Int] = []
    let mut i = 0
    while i < n {
        alt_start.push(names.len())
        tc_pattern_binders(sublist_get(alts, i), names, nodes)
        i = i + 1
    }
    alt_start.push(names.len())
    // Every name some alternative binds, in source order.
    let mut all: List[Str] = []
    for nm in names {
        if !all.contains(nm) { all.push(nm) }
    }
    let mut notes: List[Str] = []
    let mut other_notes = 0
    let mut mut_names: List[Str] = []
    for nm in all {
        let mut first = -1
        let mut a = 0
        while a < n {
            let hit = tc_binder_in(names, nodes, alt_start.get(a).unwrap(), alt_start.get(a + 1).unwrap(), nm)
            if hit == -1 {
                notes.push("`{tc_or_alt_text(sublist_get(alts, a), a)}` does not bind `{nm}`")
                other_notes = other_notes + 1
            } else if first == -1 {
                first = a
            } else {
                let t0 = tc_lookup_node_tid(tc_binder_in(names, nodes, alt_start.get(first).unwrap(), alt_start.get(first + 1).unwrap(), nm))
                let t1 = tc_lookup_node_tid(hit)
                if t0 >= 0 && t1 >= 0 && !tc_tid_same_type(t0, t1) {
                    notes.push("`{nm}` is `{type_to_str(t0)}` in `{tc_or_alt_text(sublist_get(alts, first), first)}` but `{type_to_str(t1)}` in `{tc_or_alt_text(sublist_get(alts, a), a)}`")
                    other_notes = other_notes + 1
                }
            }
            a = a + 1
        }
        if tc_or_mut_notes(alts, names, nodes, alt_start, nm, notes) { mut_names.push(nm) }
    }
    if notes.len() == 0 { return }
    let mut help = "all alternatives must bind the same variables"
    if mut_names.len() > 0 {
        let mut spelled: List[Str] = []
        for nm in mut_names { spelled.push("`mut {nm}`") }
        let sep = " and "
        let mut_help = "write {spelled.join(sep)} in every alternative, or in none"
        help = if other_notes == 0 { mut_help } else { "{help}; {mut_help}" }
    }
    tc_errors.push("inconsistent bindings in OR-pattern")
    let before = diag_entry_count()
    diag_error_at_notes("InconsistentPatternBindings", INCONSISTENT_PATTERN_BINDINGS,
        "inconsistent bindings in OR-pattern", or_pat, help, notes)
    // The fix is offered only when mutability is the whole problem, so applying it clears the error.
    if other_notes == 0 && diag_entry_count() > before { tc_set_or_mut_fix(or_pat, mut_names) }
}

// Notes for a name that is `mut` in some alternatives of an OR-pattern and not in others: one for
// the first alternative that binds it, one for each later alternative that differs from it. A
// binder that E0613 recovery made `mut` counts as `mut`, and a name with one is left to that error.
fn tc_or_mut_notes(alts: Int, names: List[Str], nodes: List[Int], alt_start: List[Int], name: Str, notes: List[Str]) -> Bool {
    let n = sublist_length(alts)
    let mut first = -1
    let mut first_mut = false
    let mut differ: List[Int] = []
    let mut a = 0
    while a < n {
        let hit = tc_binder_in(names, nodes, alt_start.get(a).unwrap(), alt_start.get(a + 1).unwrap(), name)
        if hit != -1 {
            if node_is_mut(hit) == BINDER_MUT_RECOVERED { return false }
            let is_mut = node_is_mut(hit) != 0
            if first == -1 {
                first = a
                first_mut = is_mut
            } else if is_mut != first_mut {
                differ.push(a)
            }
        }
        a = a + 1
    }
    if differ.len() == 0 { return false }
    notes.push(tc_or_mut_note(name, first_mut, sublist_get(alts, first), first))
    for d in differ { notes.push(tc_or_mut_note(name, !first_mut, sublist_get(alts, d), d)) }
    true
}

fn tc_or_mut_note(name: Str, is_mut: Bool, alt: Int, index: Int) -> Str {
    let state = if is_mut { "is `mut`" } else { "is not `mut`" }
    "`{name}` {state} in `{tc_or_alt_text(alt, index)}`"
}

// The E0005 fix for `mut` that differs across alternatives: `mut` before each binder of `names`
// that lacks it. A diagnostic holds one edit, so it runs from the first such binder to the last,
// which needs them all on one line with the name where each node says.
fn tc_set_or_mut_fix(or_pat: Int, names: List[Str]) {
    if names.len() == 0 { return }
    let mut binders: List[Int] = []
    for nm in names { tc_binders_named(or_pat, nm, binders) }
    if binders.len() == 0 { return }
    // tc_binders_named keeps source order for one name; the names interleave, so sort by column.
    let mut i = 1
    while i < binders.len() {
        let mut j = i
        while j > 0 && node_col(binders.get(j - 1).unwrap()) > node_col(binders.get(j).unwrap()) {
            let t = binders.get(j).unwrap()
            binders.set(j, binders.get(j - 1).unwrap())
            binders.set(j - 1, t)
            j = j - 1
        }
        i = i + 1
    }
    let line = node_line(binders.get(0).unwrap())
    let text = diag_source_line(diag_file_for_node(or_pat), line)
    if text == "" { return }
    for b in binders {
        let k = node_kind(b)
        let name_end = node_col(b) - 1 + node_name(b).byte_len()
        if k != NodeKind.IdentPattern && k != NodeKind.StructLitField && k != NodeKind.AsPattern { return }
        if node_line(b) != line || name_end > text.byte_len() || text.byte_slice(node_col(b) - 1, name_end) != node_name(b) { return }
    }
    let last = binders.get(binders.len() - 1).unwrap()
    let fix_col = node_col(binders.get(0).unwrap())
    let fix_end = node_col(last) + node_name(last).byte_len()
    diag_set_last_fix_at("insert `mut`", tc_insert_mut_before(text, binders, fix_col, fix_end), line, fix_col, line, fix_end)
}

// The binder node of `name` among names[from..to), or -1.
fn tc_binder_in(names: List[Str], nodes: List[Int], from: Int, to: Int, name: Str) -> Int {
    let mut i = from
    while i < to {
        if names.get(i).unwrap() == name { return nodes.get(i).unwrap() }
        i = i + 1
    }
    -1
}

// An alternative as the user wrote it, or its position when it spans lines.
fn tc_or_alt_text(alt: Int, index: Int) -> Str {
    let line = node_line(alt)
    if node_end_line(alt) == line && node_end_col(alt) > node_col(alt) {
        let text = diag_source_line(diag_file_for_node(alt), line)
        if node_end_col(alt) - 1 <= text.byte_len() { return text.byte_slice(node_col(alt) - 1, node_end_col(alt) - 1).trim() }
    }
    "alternative {index + 1}"
}

// Each name `pat` binds, with the node that binds it. A nested OR-pattern binds what its first
// alternative binds; its own check compares the rest.
fn tc_pattern_binders(pat: Int, names: List[Str], nodes: List[Int]) {
    if pat == -1 { return }
    let k = node_kind(pat)
    if k == NodeKind.IdentPattern {
        let name = node_name(pat)
        // Only a match arm's OR-patterns are checked for their binders, so the pattern is refutable.
        if pattern_name_binds(name, true) {
            names.push(name)
            nodes.push(pat)
        }
    } else if k == NodeKind.AsPattern {
        tc_pattern_binders(node_pattern(pat), names, nodes)
        names.push(node_name(pat))
        nodes.push(pat)
    } else if k == NodeKind.OrPattern {
        let alts = node_elements(pat)
        if alts != -1 && sublist_length(alts) > 0 { tc_pattern_binders(sublist_get(alts, 0), names, nodes) }
    } else if k == NodeKind.TuplePattern || k == NodeKind.ListPattern {
        let sl = node_elements(pat)
        if sl == -1 { return }
        let mut i = 0
        while i < sublist_length(sl) {
            tc_pattern_binders(sublist_get(sl, i), names, nodes)
            i = i + 1
        }
    } else if k == NodeKind.EnumPattern || k == NodeKind.StructPattern {
        let sl = node_fields(pat)
        if sl == -1 { return }
        let by_name = k == NodeKind.StructPattern || node_int_val(pat) != 0
        let mut i = 0
        while i < sublist_length(sl) {
            let f = sublist_get(sl, i)
            if by_name && node_pattern(f) == -1 {
                names.push(node_name(f))
                nodes.push(f)
            } else if by_name {
                tc_pattern_binders(node_pattern(f), names, nodes)
            } else {
                tc_pattern_binders(f, names, nodes)
            }
            i = i + 1
        }
    }
}

// Installs `hint` as the construction hint for one walk of `node`, then puts the caller's back.
fn tc_check_body_with_hint(node: Int, hint: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let saved_hint = tc_construct_hint
    tc_construct_hint = hint
    tc_check_body(node)
    tc_construct_hint = saved_hint
}

// A let's value is inferred under the let's own hint, and with its binder named so an
// `FfiScope` misuse repair carries the author's name.
// The type of a `let` value, read one way for a `let` in a body and for a module-level one.
fn tc_infer_walked_let_value(val: Int, binder: Str, hint: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let inferred = tc_infer_let_value(val, binder, hint)
    // What the inference above wrote for the value's tail, read BEFORE the walk below
    // retypes it in scope. A tail that names a binding the value's own construct
    // introduces was resolved against the enclosing scope, so a name it SHADOWS
    // answered with the outer binding's type: confidently, and wrongly, which is why
    // the recovery below cannot gate on the answer being absent.
    let pre = tc_scoped_value_memo(val, 0)
    let reread = tc_value_awaits_closure_ret(val)
    // A closure written inside a container literal — `let fs: List[fn(Int) -> Int] =
    // [fn(x: Int) -> Int { x + 1 }]` — is reached by neither walk on its own: tc_check_body
    // descends a call or a struct literal, not a list, and infer_type types the closure's
    // signature without its body. tc_walk_stmt_value picks the walk the value's kind needs.
    tc_walk_stmt_value(val)
    // What the walk wrote for the value in scope, read before the inference below
    // writes its own answer over it again.
    let post = tc_scoped_value_memo(val, 0)
    let read = if reread { tc_infer_let_value(val, binder, hint) } else { inferred }
    tc_report_deferred_branch_mismatch(val)
    tc_value_tid_after_walk(val, read, pre, post)
}

fn tc_infer_let_value(val: Int, binder: Str, hint: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let saved_hint = tc_construct_hint
    tc_construct_hint = hint
    let saved_binder = tc_ffi_scope_binder
    tc_ffi_scope_binder = binder
    let t = tc_infer_value(val)
    tc_ffi_scope_binder = saved_binder
    tc_construct_hint = saved_hint
    t
}

fn tc_check_pattern_types_against(pat: Int, binding_t: Int, subject: Str, refutable: Bool) -> Bool ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let saved_pat = tc_pattern_binding_type
    tc_pattern_binding_type = binding_t
    let bad = tc_check_pattern_types(pat, subject, false, refutable)
    tc_pattern_binding_type = saved_pat
    bad
}

// A literal pattern and each literal bound of a range pattern take the scrutinee's integer
// type, and must be in its range (sections/03_types.md §3.2 *Integer literal range*). A
// pattern spells no sign, and a Char or Bool pattern is no integer literal.
fn tc_check_int_pattern_range(pat: Int, hint: Int) ! Diag.Report {
    if hint < 0 || node_type_name(pat) != "" { return }
    let t = tc_resolve(resolve_alias_tid(hint))
    if is_integer_type(t) == 0 { return }
    tc_check_int_pattern_bound(pat, node_col(pat), node_str_val(pat), t)
    if node_kind(pat) == NodeKind.RangePattern { tc_check_int_pattern_bound(pat, node_int_val(pat), node_name(pat), t) }
}

// One bound of `pat`, spelled `b`, at column `col` of the pattern's line.
fn tc_check_int_pattern_bound(pat: Int, col: Int, b: Str, t: Int) ! Diag.Report {
    if !tc_is_decimal_digits(b) { return }
    let digits = int_lit_decimal(b)
    if !tc_digits_within(digits, tc_int_literal_limit(type_kind(t), false)) {
        tc_report_int_value_range(pat, col, digits, false, t, false, "")
    }
}

fn tc_is_decimal_digits(s: Str) -> Bool {
    if s == "" { return false }
    let mut i = 0
    while i < s.byte_len() {
        let c = s.byte_at(i)
        if c < 48 || c > 57 { return false }
        i = i + 1
    }
    true
}

// The matched value's name, for the NoSuchVariant note; empty when it is not a plain name.
fn tc_match_subject(m: Int) -> Str {
    let scrut = node_scrutinee(m)
    if scrut != -1 && node_kind(scrut) == NodeKind.Ident { node_name(scrut) } else { "" }
}

fn tc_check_assert_panics_body(body: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let prev_in_ap = tc_in_assert_panics
    tc_in_assert_panics = 1
    tc_check_body_in_scope(body)
    tc_in_assert_panics = prev_in_ap
}

fn tc_check_body_in_scope(node: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    nr_push_scope()
    tc_check_body(node)
    nr_pop_scope()
}

fn tc_infer_returned_value_with_hint(val: Int, returns_value: Bool, hint: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let saved_hint = tc_construct_hint
    tc_construct_hint = hint
    let t = tc_infer_returned_value(val, returns_value)
    tc_construct_hint = saved_hint
    t
}

fn tc_infer_returned_value(val: Int, returns_value: Bool) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    // A value in return position takes the declared return before it is inferred, the same
    // way a call argument takes the formal: a literal needs it to be other than Int, and a
    // closure body reads its signature from it while it is walked. Inside a closure
    // body tc_current_fn_ret is that closure's own return (tc_check_closure_body_against_own_ret).
    if returns_value { tc_seed_expected_into_value(val, tc_current_fn_ret) }
    if returns_value { tc_infer_value(val) } else { infer_type(val) }
}

fn tc_check_body(node: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    // Read-then-zero before anything can recurse, so a nested walk never inherits it.
    let in_value = tc_walk_value_tail
    tc_walk_value_tail = 0
    if node == -1 { return }
    let kind = node_kind(node)

    if kind == NodeKind.Block {
        // Read-then-zero: only the block tc_check_fn set the marker for is a fn body.
        let is_fn_body = tc_fn_body_block
        tc_fn_body_block = 0
        nr_push_scope()
        let stmts_sl = node_stmts(node)
        // The implicit tail of a value-returning fn is a return position, so a literal or a
        // closure there takes the declared return. The tail compare below runs AFTER the
        // walk; the seed has to be in hand BEFORE it, because the walk is what checks the body.
        let mut hint_tail = -1
        let value_fn_body = is_fn_body != 0 && tc_fn_returns_value()
        if value_fn_body {
            let seed_tail = tc_block_tail_stmt(node)
            if seed_tail != -1 {
                if tc_block_tail_value(seed_tail) != -1 { hint_tail = seed_tail }
                tc_seed_expected_into_value(tc_block_tail_value(seed_tail), tc_current_fn_ret)
            }
        }
        let value_tail = tc_value_tail_stmt(node, value_fn_body || in_value != 0)
        // A closure with no `-> T` hands its tail back to the caller even though its body is
        // checked against Void, so only a named function's Void body drops its tail.
        let drops_tail = is_fn_body != 0 && !value_fn_body && tc_current_fn_name != "closure"
        let last_stmt = tc_block_tail_stmt(node)
        if stmts_sl != -1 {
            let mut i = 0
            let mut _found_terminal = 0
            while i < sublist_length(stmts_sl) {
                let stmt = sublist_get(stmts_sl, i)
                if _found_terminal != 0 {
                    diag_warn_at("UnreachableCode", UNREACHABLE_CODE, "unreachable code after return/break/continue", stmt, "remove this code or move it before the control flow statement")
                }
                // The implicit tail names the same slot an explicit `return` does, so it takes the
                // same construction hint. Without it a target-directed tail — `x.into()`, a carrier
                // literal, an arena allocation — has nothing to name its type and reaches the end
                // of inference with none. Installed around the WALK, not around the tail compare
                // further down: the walk is what publishes the node tids, and the compare re-reads
                // what the walk already decided.
                let stmt_hint = if stmt == hint_tail { resolve_alias_tid(tc_current_fn_ret) } else { tc_construct_hint }
                if stmt == value_tail { tc_walk_value_tail = 1 }
                tc_check_body_with_hint(stmt, stmt_hint)
                if stmt != last_stmt || drops_tail { tc_check_dropped_value(stmt) }
                let sk = node_kind(stmt)
                if sk == NodeKind.Return || sk == NodeKind.Break || sk == NodeKind.Continue {
                    _found_terminal = 1
                }
                i = i + 1
            }
        }
        // ORDERING CONTRACT: this must run BEFORE nr_pop_scope. The pin
        // inside tc_check_returned_value binds metavars in place — bind_metavar mutates
        // the α slot itself, and the tail's instance tid and the scope entry for a local
        // hold the very same α integers — so nr_pop_scope's E0301 region-boundary check
        // then reads them already solved, with no scope-entry rewrite. Pop first and the
        // boundary check wins the race, which is the bug.
        //
        // NodeKind.Return is excluded because its own arm already ran this check on the
        // same value during the statement walk above; including it is the double-report.
        //
        // Gated on a value-returning fn, like the value-tail marker above: a Void fn's tail
        // is a discarded statement, so `fn f() { if c { a() } else { b() } }` with arms of
        // different types stays silent.
        if value_fn_body {
            let tail = tc_block_tail_stmt(node)
            if tail != -1 && node_kind(tail) != NodeKind.Return {
                let tail_val = tc_block_tail_value(tail)
                if tail_val != -1 {
                    // The walk above typed the tail in value context with every branch scope
                    // live, so its answer is read back rather than inferred again out of scope,
                    // where a branch-local binding would resolve to nothing.
                    let tail_t = tc_scoped_value_memo(tail_val, 0)
                    tc_check_returned_value(tail_t, tail_val)
                }
            }
        }
        nr_pop_scope()
        return
    }

    if kind == NodeKind.LetBinding {
        let vname = node_name(node)
        let val = node_value(node)
        let is_mut = node_is_mut(node)
        tc_check_const_decl(node)

        let type_str = node_type_name(node)
        let type_ann = node_target(node)
        let mut declared_tid = TYPE_UNKNOWN
        if type_ann != -1 {
            declared_tid = resolve_type_ann(type_ann)
        } else if type_str != "" {
            let rt = resolve_type_name(type_str)
            if rt != -1 {
                declared_tid = rt
            }
        }

        let mut inferred_tid = TYPE_UNKNOWN
        if val != -1 {
            tc_seed_expected_into_value(val, declared_tid)
            // With no annotation the value has no expected type: the expectation of the block
            // this `let` sits in is the block's TAIL's, not this value's.
            let let_hint = if tc_tid_is_no_info(declared_tid) == 0 { resolve_alias_tid(declared_tid) } else { -1 }
            // A let binding is expression context (§2.9): infer in value context so an else-less
            // `if` as its value (no value on the false path) is rejected regardless of the
            // declared/inferred type, so `let x = if c { 1 }` fails even when x is unused.
            inferred_tid = tc_infer_walked_let_value(val, vname, let_hint)
        }

        if tc_tid_is_no_info(declared_tid) == 0 && tc_tid_is_no_info(inferred_tid) == 0 {
            if assignment_types_compatible(declared_tid, inferred_tid, val) == 0 {
                if !tc_closure_checked_against(val, declared_tid) {
                    let (declared_s, got_s) = tc_type_pair_strs(declared_tid, inferred_tid)
                    tc_report_declared_mismatch("variable `{vname}`: declared type {declared_s} but got {got_s}{tc_fn_mismatch_suffix(declared_tid, inferred_tid)}", node, val, declared_tid, inferred_tid)
                }
            } else {
                // A declared let type is an expected-type source for the value's
                // metavars (sections/03_types.md 3.3), not only something to compare
                // against: `let e: RGT[Int] = mk()` must fill the α that
                // instantiate_return_type minted for mk's return-only T, and `let m:
                // Map[Str, Int] = Map()` must fill the ctor's key and value. The pin
                // unifies in place, so one bind solves the mono name and the field
                // ctor's key operations together.
                //
                // In the COMPATIBLE branch only, so a pin can never turn a reported
                // mismatch into a silent success. A bare type parameter of THIS
                // declaration pins too (`let m: Map[K, V] = Map()` in `fn f[K, V]()`),
                // since mono substitutes f's own parameters once per instance; see
                // tc_pin_tail_ret_generic for the licence that allows it.
                tc_pin_declared_into_value(declared_tid, val, inferred_tid)
            }
        }

        let mut final_tid = declared_tid
        if tc_tid_is_no_info(final_tid) != 0 {
            final_tid = inferred_tid
        }
        // Publish the BINDING's type on the let node itself. infer_type memoizes expression
        // nodes only, so a `let` statement carried no tid at all and codegen had to guess
        // between the annotation node and the initializer — and guessing the initializer is
        // WRONG for `let m: Map[Str, List[Int]] = Map()`: the declared type is compared
        // against the initializer, never unified into it, so the ctor's tid is still
        // `Map[α, β]` with both metavars unbound. final_tid is typecheck's own answer to
        // "what type is this variable", by the same rule three lines up, so publishing it is
        // what lets codegen READ the type rather than re-derive it (Stage 2 of the tid
        // collapse, decisions/compiler-type-representation.md Q2).
        //
        // Additive: this slot was the -1 unset sentinel for every let node before now.
        if node < tc_node_tid.len() && tc_tid_is_no_info(final_tid) == 0 {
            tc_node_tid.set(node, final_tid)
        }
        // Record the decl node so the E0301 region-boundary check has a span. Node is
        // used only for that diagnostic in this pass — unused-var warnings are off
        // during inference (nr_warn_unused == 0).
        if tc_let_binder_is_discard(node) == 0 {
            nr_define_typed(vname, is_mut, final_tid, node)
            if type_ann == -1 && type_str == "" && tc_tid_is_no_info(final_tid) == 0 {
                tc_hints.push(HintEntry { line: node_line(node), col: node_col(node), name: vname, type_str: type_to_str(final_tid), module: nr_current_module })
            }
        }
        let tc_let_pat_sl = node_elements(node)
        if tc_let_pat_sl != -1 {
            tc_type_let_pattern(tc_let_pat_sl, final_tid)
        }
        return
    }

    if kind == NodeKind.Assignment || kind == NodeKind.CompoundAssign {
        let target = node_target(node)
        let val = node_value(node)
        if target != -1 && val != -1 && node_kind(target) == NodeKind.IndexExpr {
            // The target is no place, so neither the root's `mut` nor the value's type is
            // checked against it; the one report is the store's.
            let obj_t = infer_type(node_obj(target))
            let val_t = infer_type(val)
            let _ = tc_index_pin_open(val_t, tc_index_get_elem(tc_resolve(obj_t)))
            let type_args = (tc_bracket_sites.get(target) ?? 0) == BRACKET_TYPE_ARGS
            if !type_args { tc_bracket_sites.insert(target, INDEX_REPORTED) }
            let _ = infer_type(target)
            if !type_args && tc_tid_is_no_info(tc_resolve(obj_t)) == 0 {
                tc_report_index_store(node, obj_t)
            }
            return
        }
        if target != -1 && val != -1 {
            let target_t = infer_type(target)
            tc_check_assign_root(node)
            let val_t = tc_infer_assigned_value(target_t, val)
            if kind == NodeKind.CompoundAssign {
                reject_non_numeric_arith_operand(node_op(node), target_t, node, 0)
                reject_non_numeric_arith_operand(node_op(node), val_t, node, 0)
            }
            if tc_tid_is_no_info(target_t) == 0 && tc_tid_is_no_info(val_t) == 0 {
                if assignment_types_compatible(target_t, val_t, val) == 0 {
                    if !tc_closure_checked_against(val, target_t) { tc_value_mismatch_at("assignment: cannot assign {type_to_str(val_t)} to {type_to_str(target_t)}{tc_fn_mismatch_suffix(target_t, val_t)}", node, val, target_t) }
                } else {
                    // An assignment TARGET is a declared-type source for the value's
                    // metavars, not only something to compare against — the same
                    // reasoning as the LetBinding arm above, and the same in-place
                    // unify, so one bind solves the mono name and the field ctor's
                    // kops vtable together. Without it `e = mk()` left the α that
                    // instantiate_return_type minted for mk's return-only T unbound
                    // and it reached emit_struct_lit erased.
                    //
                    // target_t already carries the right expected type for both
                    // spellings: an Ident target resolves through scope, a FieldAccess
                    // target through the field arm, which substitutes the enclosing
                    // instance's concrete args.
                    //
                    // No closure-depth guard, unlike tc_check_returned_value: that
                    // guard exists because tc_current_fn_ret names the closure's own
                    // declared return, not stale ambient state. target_t was never
                    // ambient to begin with: it's read from the
                    // target expression itself, so a closure assigning to a
                    // captured binding pins that binding's own declared type
                    // regardless.
                    //
                    // Assignment only, never CompoundAssign: no compound operator is
                    // defined over any kind tc_pin_admits_declared admits (Map, Set,
                    // generic struct/enum), so the branch would be dead. Excluded on
                    // purpose rather than by accident.
                    //
                    // The same walker as the LetBinding arm, so a block or a branch
                    // around the value does not change what the target fills
                    // (`x = Err("boom")` pins the mut carrier's other slot).
                    if kind == NodeKind.Assignment {
                        tc_pin_declared_into_value(target_t, val, val_t)
                    } else {
                        tc_literal_takes(val, target_t)
                    }
                }
            }
        }
        return
    }

    if kind == NodeKind.IfExpr {
        let cond_t = tc_check_nested_value(node_condition(node))
        if is_bool_compat(cond_t) == 0 {
            tc_error_at("if condition must be Bool, got {type_to_str(cond_t)}", node)
        }
        // The branch tails as the speculative inference left them, read before either branch
        // scope exists. The recovery below reads them again and takes the delta as its gate.
        let pre_if_memo = tc_scoped_value_memo(node, 0)
        tc_walk_value_tail = in_value
        tc_check_body(node_then_body(node))
        tc_walk_value_tail = in_value
        tc_check_body(node_else_body(node))
        if in_value != 0 { tc_check_if_value(node) }
        // The branch bodies were walked — and memoized — inside their own block scopes, so an
        // `if` whose branch tail names a block-local `let` memoized TYPE_UNKNOWN for the `if` as
        // a whole. The answers exist now; read them back here at the `if`, exactly as the
        // MatchExpr arm does for its arms. Recovery only — gated on the node having no answer of
        // its own, and tc_publish_node_tid refuses an UNKNOWN, so a genuinely void `if` is a
        // no-op. Two-branch forms ONLY: an else-less `if` whose value is discarded is a statement
        // that codegen lowers without a result temp (emit_if_expr's else==-1 && tid<0 fast path);
        // publishing a tid there would defeat that and resurrect a dead temp. A consumed else-less
        // if-tail keeps its own publish path, unaffected here.
        if node_else_body(node) != -1 {
            let own_tid = tc_lookup_node_tid(node)
            let post_if_memo = tc_scoped_value_memo(node, 0)
            if tc_tid_is_no_info(own_tid) != 0 {
                tc_publish_node_tid(node, post_if_memo)
            } else if post_if_memo != pre_if_memo {
                // Same delta gate as the MatchExpr arm: a branch tail that names a
                // block-local shadowing an outer binding was typed against the outer one.
                tc_publish_node_tid(node, post_if_memo)
            }
        }
        return
    }

    if kind == NodeKind.WhileLoop {
        let cond_t = tc_check_nested_value(node_condition(node))
        if is_bool_compat(cond_t) == 0 {
            tc_error_at("while condition must be Bool, got {type_to_str(cond_t)}", node)
        }
        tc_check_body(node_body(node))
        tc_check_dropped_value(node_body(node))
        return
    }

    if kind == NodeKind.ForIn {
        nr_push_scope()
        let iter_t = tc_resolve(tc_check_nested_value(node_iterable(node)))
        let iter_tk = type_kind(iter_t)
        let elem_t = tc_tid_iter_elem(iter_t)
        // Gated on the KIND, not on `elem_t == TYPE_UNKNOWN`. A List/Set/Map is iterable whatever
        // its element turns out to be, and `List[?]` — an element that is still an unbound
        // metavar — must not be diagnosed here: only E0301's region boundary decides whether an
        // under-determined type is an error. Testing the element instead of the kind would put a
        // NotIterable on a list, which is the one thing this arm must never say.
        let has_elem_rule = iter_tk == TyKind.List || iter_tk == TyKind.Set || iter_tk == TyKind.Map
        if has_elem_rule == 0 {
            // TyKind.Unknown here means iter_t is still an unbound metavar (e.g. a lazy-adapter
            // chain like `.enumerate()`/`.zip()` not yet pinned at this point in checking) --
            // under-determined, not known to be non-iterable. Leave it to E0301's
            // region-boundary check rather than misdiagnosing it here. Set/Map/Str/Bytes/
            // Iterator/Channel ARE spec-legal iterables (sections/03c_protocols.md
            // IntoIterator table, sections/03_types.md:656 for Bytes' IntoIterator[U8],
            // plus the Channel receive extension) so they pass through even where codegen's
            // emit_for_in has no arm yet -- that gap is I0002, an internal compiler error,
            // never a user-facing NotIterable.
            // TyKind.Map is no longer listed: the kind gate above answers it, so naming it here
            // would be an unreachable claim that a Map still has no element type.
            let is_deferred_iterable = iter_tk == TyKind.Unknown || iter_tk == TyKind.Str || iter_tk == TyKind.Bytes || iter_tk == TyKind.Iterator || iter_tk == TyKind.Channel
            if is_deferred_iterable == 0 {
                diag_error_at("NotIterable", NOT_ITERABLE, "cannot iterate over type `{type_to_str(iter_t)}` with a `for` loop -- only List, Set, Map, Range, Str, Bytes, Channel, and Iterator implement iteration", node_iterable(node), "iterate a List, Set, Map, Range, Str, Bytes, Channel, or Iterator instead")
            }
        }
        // A `for` binder aliases an element it did not materialize, so its blame is
        // deferred to the end-of-pass flush like every other alias binder — that is what
        // lets `for x in xs { } xs.push(1)` pin the element AFTER this scope closes without
        // the binder being false-rejected, and what makes `for x in []` reportable with no
        // named-place gate here.
        nr_define_typed(node_var_name(node), tc_for_binder_is_mut(node), elem_t, node_for_binder(node))
        // Stamp the simple `for x in xs` binder's dedicated IdentPattern node with the element
        // type. The destructuring path carries for_binder == -1 and is stamped through its tuple
        // pattern below instead.
        tc_publish_node_tid(node_for_binder(node), elem_t)
        // A pattern NODE, not a sublist (tc_check_pattern_types takes a node).
        let tc_for_pat_node = node_elements(node)
        if tc_for_pat_node != -1 {
            // The ELEMENT type is the binding hint: a destructured `for (k, v) in m` needs the
            // same tuple decomposition the match path gets. Without the hint the TuplePattern
            // arm takes its `tup_start == -1` path and types both leaves as untyped.
            let _ = tc_check_pattern_types_against(tc_for_pat_node, elem_t, "", false)
        }
        tc_check_body(node_body(node))
        tc_check_dropped_value(node_body(node))
        nr_pop_scope()
        return
    }

    if kind == NodeKind.MatchExpr {
        let scrut = node_scrutinee(node)
        // Walked before it is inferred, so a closure result it reads is bound by then; a
        // scrutinee such as an operator can hide a HOF that tc_check_body does not reach.
        tc_check_body(scrut)
        if !tc_stmt_value_walks_body(node_kind(scrut)) { tc_walk_nested_hof_bodies(scrut) }
        let scrut_tid = infer_type(scrut)
        // The arm bodies as the speculative inference left them, read before any arm scope
        // exists. The recovery below reads them again and takes the delta as its gate.
        let pre_arm_memo = tc_scoped_value_memo(node, 0)
        let arms_sl = node_arms(node)
        if arms_sl != -1 {
            let subject = tc_match_subject(node)
            // An arm whose pattern names nothing the value can be covers nothing (§3.5
            // Exhaustiveness). When such an arm is unguarded, the author meant it to cover
            // something, so the coverage error would only restate the pattern error.
            let mut bad_unguarded = false
            let mut i = 0
            while i < sublist_length(arms_sl) {
                let arm = sublist_get(arms_sl, i)
                nr_push_scope()
                tc_pattern_binding_type = scrut_tid
                let bad = tc_check_pattern_types(node_pattern(arm), subject, false, true)
                tc_pattern_binding_type = -1
                if bad && node_guard(arm) == -1 { bad_unguarded = true }
                tc_check_or_pattern_bindings(node_pattern(arm))
                tc_check_stmt_match_arm(arm, in_value)
                // Resolve the arm's body-value tid through the scoped-value memo, NOT a bare
                // tc_lookup_node_tid: a braced arm body (`Pat => { ... }`) makes tc_arm_body_value
                // return the Block node, whose own tid is unwritten in statement position — the
                // memo walks the Block/if/match tail down to the value the walk already recorded.
                tc_publish_node_tid(arm, tc_scoped_value_memo(tc_arm_body_value(arm), 0))
                nr_pop_scope()
                i = i + 1
            }
            // A consumed match the value-context walk reached. infer_type never types this node,
            // so its arm compare is made here, as tc_check_if_value makes an `if`'s.
            if in_value != 0 { tc_report_walked_match_arm_mismatch(node) }

            // Materialization boundary: an anonymous temporary scrutinee is a value exactly
            // like a `let` initializer, so a metavar still unbound after every arm's
            // constraining uses have run is under-determined → error[CannotInferType] (E0301),
            // uniformly with the `let` case (decisions/under-determined-sum-variant-parameter.md).
            // Without this, an `Ok(3)` (Err never pinned) as a tuple element in the scrutinee
            // slipped past the scope-close check — it binds no name whose type carries the
            // metavar — and codegen fabricated an arbitrary carrier. A scrutinee that references
            // an in-scope binding is skipped (tc_scrut_is_named_place): the scope-close check
            // owns it with correct timing, so eager-checking it would false-reject a value a
            // later statement pins and double-report one already covered. Gated on
            // tc_boundary_check_active exactly as the scope-close check, so the annotation-blind
            // name-resolution pass never fires it.
            if tc_boundary_check_active != 0 {
                if tc_tid_has_unbound_metavar(scrut_tid) != 0 {
                    if tc_scrut_is_named_place(node_scrutinee(node)) == 0 {
                        tc_report_under_determined_at(node_scrutinee(node), scrut_tid)
                    }
                }
            }

            // The arm bodies above were walked — and memoized — inside the scope where the arm's
            // pattern bindings exist. infer_type ran before any of those scopes did, so a match whose
            // every arm names one of its own bindings (`w as Cfg { .. } => { w }`) memoized
            // TYPE_UNKNOWN for the match as a whole. The answers exist now, so read them back here at
            // the match rather than at each consumer: one publish serves every consumer this function
            // reaches. That reach is statement forms only, so a match nested in an expression is not
            // covered. Recovery, not correction: the in-scope answer is taken either when the
            // node has none of its own, or when the arm memo MOVED across the walk, which is
            // the proof that the answer it does have was computed before the arm scopes
            // existed, against whatever binding an arm shadows.
            let own_tid = tc_lookup_node_tid(node)
            let post_arm_memo = tc_scoped_value_memo(node, 0)
            if tc_tid_is_no_info(own_tid) != 0 {
                tc_publish_node_tid(node, post_arm_memo)
            } else if post_arm_memo != pre_arm_memo {
                tc_publish_node_tid(node, post_arm_memo)
            }

            if !bad_unguarded { tc_check_match_exhaustive(node, scrut_tid, arms_sl) }
        }
        return
    }

    if kind == NodeKind.LoopExpr {
        tc_check_body(node_body(node))
        tc_check_dropped_value(node_body(node))
        return
    }

    if kind == NodeKind.WithBlock {
        let wh_sl2 = node_handlers(node)
        nr_push_scope()
        if wh_sl2 != -1 {
            let mut wi2 = 0
            while wi2 < sublist_length(wh_sl2) {
                let wh_item2 = sublist_get(wh_sl2, wi2)
                let wh_kind2 = node_kind(wh_item2)
                if wh_kind2 == NodeKind.WithResource {
                    tc_bind_with_resource(wh_item2)
                } else {
                    tc_check_body(wh_item2)
                    // tc_check_body WALKS the operand but never types it (no Ident arm, no
                    // FieldAccess arm), so its tid must be memoized here instead: the operand of
                    // a `with` is an ordinary expression whose type is `Handler[E]`, and typecheck
                    // is the layer that knows it. This lets the spec's own rule
                    // (sections/04_effects.md:1102 — "the compiler checks `Handler[E]` first, then
                    // `BlockHandler`") be enforced against a type instead of against a C string.
                    //
                    // tc_check_body stays and runs FIRST: for an inline handler operand it routes to
                    // the HandlerExpr arm that walks the method bodies, which infer_type does not
                    // do. The two are complements, and the order keeps handler-body diagnostics
                    // reported before any type error on the operand itself.
                    let _ = tc_check_with_item(wh_item2, infer_type(wh_item2), false)
                }
                wi2 = wi2 + 1
            }
        }
        // The body's tail as the speculative inference left it, read before the body is
        // walked in this scope. The recovery below takes the delta as its gate.
        let pre_with_memo = tc_scoped_value_memo(node, 0)
        tc_walk_value_tail = in_value
        tc_check_body(node_body(node))
        // Same recovery as the MatchExpr arm, and for the same reason: `with` is an
        // expression whose value is its body's tail (sections/02_syntax.md:1017), and that tail
        // routinely names a binding the block itself introduces. infer_type answered before
        // this scope existed, so it read TYPE_UNKNOWN and the memo would not take the write,
        // leaving the block with no type of its own in either position. The body has now been
        // walked and its tail memoized, so read the answer back here at the block rather than
        // at each consumer: one publish serves every consumer this function reaches. That reach
        // is statement forms only, so a `with` nested in an expression is not covered.
        // A body with no value-bearing last statement is not a miss — the spec gives it `()`
        // (sections/05_memory_compile_errors.md:169), so say so instead of leaving it blank.
        // Recovery, not correction: taken when the node has no answer of its own, or when the
        // tail memo MOVED across the walk, which is the proof that the answer it does have was
        // computed before this scope existed, against whatever binding the tail shadows.
        let with_own_tid = tc_lookup_node_tid(node)
        let post_with_memo = tc_scoped_value_memo(node, 0)
        if tc_tid_is_no_info(with_own_tid) != 0 {
            let mut with_tail_tid = post_with_memo
            if tc_tid_is_no_info(with_tail_tid) != 0 && tc_block_tail_stmt(node_body(node)) == -1 {
                with_tail_tid = TYPE_VOID
            }
            tc_publish_node_tid(node, with_tail_tid)
        } else if post_with_memo != pre_with_memo {
            // Same delta gate as the MatchExpr arm: the tail names a block-local that
            // shadows an outer binding, and the answer above was read before this scope.
            tc_publish_node_tid(node, post_with_memo)
        }
        nr_pop_scope()
        return
    }

    if kind == NodeKind.WithResource {
        tc_check_body(node_value(node))
        return
    }

    // A handler's method bodies need walking in EVERY position it can appear in — as a
    // call argument, written inline in a `with`, or bound to a `let`. The WithBlock arm
    // above already routes an inline handler here, so this arm is what actually walks it.
    if kind == NodeKind.HandlerExpr {
        tc_check_partial_handler(node)
        let hm_sl = node_methods(node)
        if hm_sl != -1 {
            let mut hi = 0
            while hi < sublist_length(hm_sl) {
                tc_check_builtin_handler_clause(node_name(node), sublist_get(hm_sl, hi))
                tc_check_handler_method(sublist_get(hm_sl, hi))
                hi = hi + 1
            }
        }
        return
    }

    if kind == NodeKind.AssertPanics {
        // Lexical, like the E0827 skip fence — see tc_in_test_lexical's declaration.
        if tc_in_test_lexical == 0 {
            diag_error_at("AssertPanicsOutsideTest", ASSERT_PANICS_OUTSIDE_TEST,
                "assert_panics can only be used inside a test body",
                node, "move it into a `test \{ ... }` block")
        }
        if tc_in_assert_panics != 0 {
            diag_error_at("AssertPanicsNestedExpectPanic", ASSERT_PANICS_NESTED_EXPECT_PANIC,
                "assert_panics cannot be nested inside another assert_panics block",
                node, "split the assertions into two separate tests")
        }
        let ap_match = node_value(node)
        if ap_match != -1 {
            tc_check_body(ap_match)
            let mt = infer_type(ap_match)
            if tc_tid_is_no_info(mt) == 0 && mt != TYPE_STR {
                tc_error_at("assert_panics matching: must be Str, got {type_to_str(mt)}", node)
            }
        }
        tc_check_assert_panics_body(node_body(node))
        return
    }

    if kind == NodeKind.AsyncScope {
        tc_check_body(node_body(node))
        return
    }

    if kind == NodeKind.AsyncSpawn {
        tc_check_body(node_body(node))
        return
    }

    // The second of the two entry points into a closure body: a closure the HOF path did not
    // claim (a call argument to a user function, an fn-typed `let`, a struct-literal field,
    // an immediately-invoked literal). It used to bind params from their annotations alone
    // and publish nothing at all on the param nodes, so an unannotated param here was Void.
    // Both entry points are now the same function, so a param's type and its node stamp
    // cannot differ by which path reached it. The expected signature is whatever the context
    // published on this closure node — the empty answer when nothing did.
    if kind == NodeKind.Closure {
        check_closure_body(node, tc_lookup_node_tid(node))
        return
    }

    if kind == NodeKind.ExprStmt {
        let val = node_value(node)
        if val != -1 {
            if in_value != 0 { tc_infer_value(val) } else { infer_type(val) }
            let reread = tc_value_awaits_closure_ret(val)
            // Statement-position HOFs (l.for_each(fn(x){...})) need the MethodCall
            // branch to walk the closure body. Binding-position calls already
            // get this via tc_check_body(val) in the LetBinding handler. Scoped to the
            // call kinds below rather than recursing unconditionally: the Assignment handler
            // lacks LetBinding's literal-to-sized-int coercion, so walking arbitrary
            // statement values would surface spurious errors.
            //
            // Block-bearing control-flow in statement position must also be walked:
            // infer_type only visits a block's tail, so non-tail statements inside
            // their bodies (e.g. `result = result + x`) would skip every per-statement
            // check otherwise. `if`/`while`/`loop`/`for`/`match`/`with` are all bare
            // statements (parse_stmt produces the node directly; parse_primary never
            // produces them in statement position), so they never arrive ExprStmt-
            // wrapped — but a statement-position match still dispatches to the bare
            // MatchExpr branch above, not here. is_block_bearing is the single source
            // of truth for THIS re-dispatch so a future block-bearing kind cannot
            // silently lose statement-walking coverage here.
            // NodeKind.Call joins MethodCall here for the same reason MethodCall was already
            // listed — a statement-position call can carry a closure argument whose body
            // needs walking (`take(fn() { ... })`). Both arms are narrow by construction:
            // they walk callable arguments only, never arbitrary statement values.
            // NodeKind.StructLit joins them so a struct literal at the fn tail (`Box { v: match
            // ... }`, the last statement of the body) reaches the StructLit arm's field walk;
            // that arm only descends into is_block_bearing field values, so it is equally narrow.
            // NodeKind.Closure joins them so a closure written as a bare statement (the tail of
            // `with arena { fn(i) { xs.get(0)... } }`, where the closure is the block value)
            // reaches the Closure arm's body walk; infer_type only types a closure's signature,
            // so without this the body's own expressions never get their node tids published.
            // NodeKind.HandlerExpr is the sibling: a bare tail `handler E { ... }` is likewise a
            // parse_primary expression whose method bodies infer_type does not walk, so its body
            // diagnostics are skipped and node tids unpublished unless it reaches the HandlerExpr
            // arm here. A handler consumed by `with` routes through the WithBlock arm instead.
            tc_walk_stmt_value(val)
            if reread {
                if in_value != 0 { tc_infer_value(val) } else { infer_type(val) }
            }
        }
        return
    }

    if kind == NodeKind.Return {
        let val = node_value(node)
        if val != -1 {
            // An explicit `return` is expression context (§2.9) ONLY when the fn returns a
            // value: infer in value context there so an else-less `if` (no value on the false
            // path) is rejected. `return if c { .. }` in a `-> ()` fn is statement context —
            // the returned value is discarded — so it stays legal (plain infer, flag off).
            let returns_value = tc_fn_returns_value()
            let ret_hint = if returns_value { resolve_alias_tid(tc_current_fn_ret) } else { tc_construct_hint }
            let mut val_t = tc_infer_returned_value_with_hint(val, returns_value, ret_hint)
            // The check pins open types of the value to the declared return, so a value that
            // reads a closure's result is checked once the walk has bound it.
            let reread = tc_value_awaits_closure_ret(val)
            // Shared with the implicit tail — see tc_check_returned_value for why each
            // guard is load-bearing. This arm stays necessary alongside the tail site: an
            // EARLY return inside an `if` is not the block's last statement, so the tail
            // check never visits it.
            if !reread { tc_check_returned_value(val_t, node) }
            // A returned value is walked the same way the ExprStmt arm walks a tail value,
            // through the shared tc_stmt_value_walks_body predicate: infer_type types only a
            // value's shape, never the bodies nested inside it (a struct literal's block-valued
            // fields, a returned closure's or handler's method bodies, a call's closure args),
            // so those stay unwalked unless this walk reaches them.
            tc_walk_stmt_value(val)
            if reread {
                val_t = tc_infer_returned_value_with_hint(val, returns_value, ret_hint)
                tc_check_returned_value(val_t, node)
            } else {
                // The walk infers the value again, and an empty container in an arm tail
                // mints fresh metavars when it does. The return type is still each arm's
                // expected type (sections/03_types.md 3.3), so it pins them once more.
                if returns_value && tc_tid_is_no_info(tc_current_fn_ret) == 0 && tc_tid_is_no_info(val_t) == 0 && types_compatible(tc_current_fn_ret, val_t) != 0 {
                    tc_pin_declared_into_value(tc_current_fn_ret, val, val_t)
                }
            }
        } else {
            if tc_current_fn_ret != TYPE_VOID && tc_tid_is_no_info(tc_current_fn_ret) == 0 {
                tc_error_at("function `{tc_current_fn_name}` returns {type_to_str(tc_current_fn_ret)} but bare `return` has no value", node)
            }
        }
        return
    }

    if kind == NodeKind.MethodCall {
        // infer_type already validated explicit closure annotations (Part A) and
        // ran arg/method checks during the binding/ExprStmt inference. Here we add
        // the Part B body walk: bind unannotated closure params to the elem/acc
        // type and type-check the body once.
        let recv = tc_mc_receiver(node)
        let obj_t = tc_infer_receiver(recv)
        // The RECEIVER of this call is a value the arm above only inferred, never body-walked,
        // so a HOF in the receiver chain (`a.map(f).collect()`) reaches check_closure_body only
        // through this descent. It runs first so a receiver `map` has bound its result before
        // this call's own closure is handed that element (`xs.map(f1).map(f2)`).
        tc_walk_nested_hof_bodies(recv)
        // This arm, and not infer_type's MethodCall arm: infer_type is called several
        // times per node (the nr pass, then the inference pass, then re-inference for
        // mono) and its memo wrapper does not short-circuit, so a diagnostic emitted there
        // reports two or three times. tc_check_body walks each node once, with the nr scope
        // frames live, which is the pair of facts the check needs.
        tc_check_mutating_method(node, recv, obj_t)
        let args_sl = tc_mc_call_args(node)
        // The argument the List-HOF path walks itself, so the generic walk below does not
        // report its contents a second time.
        let mut hof_arg = -1
        // The eager (List) and lazy (Iterator) worlds share these HOFs, so both must hand the
        // closure its element type. Only the eager half did, so a lazy `xs.into_iter().map(fn(x)
        // { .. })` left its param with no type at all — now an error, not a silent Void.
        if type_kind(obj_t) == TyKind.List || type_kind(obj_t) == TyKind.Iterator {
            let method = node_method(node)
            let elem = tc_tid_iter_elem(obj_t)
            if is_elem_closure_hof(method) != 0 {
                let hof_cls = closure_arg_at(args_sl, 0)
                let diag_before = diag_count
                check_closure_body(hof_cls, make_fn_type(TYPE_UNKNOWN, [elem]))
                hof_arg = 0
                if method == "map" || method == "flat_map" { tc_bind_hof_result(node, hof_cls, method, diag_before) }
            } else if method == "fold" {
                if args_sl != -1 && sublist_length(args_sl) >= 2 {
                    let acc_t = infer_type(sublist_get(args_sl, 0))
                    check_closure_body(sublist_get(args_sl, 1), make_fn_type(TYPE_UNKNOWN, [acc_t, elem]))
                    hof_arg = 1
                }
            } else if method == "sort_by" && type_kind(obj_t) == TyKind.List {
                tc_check_sort_by_body(closure_arg_at(args_sl, 0), elem)
                hof_arg = 0
            }
        }
        // Bytes.with_ptr hands its closure a `Ptr[U8]` (sections/07_trust_modules_metadata.md;
        // the same pointer nogrow_scan names in its escape diagnostics). The generic walk below
        // would bind the unannotated param to UNKNOWN, so `fn(p) { p.addr() }` would miss the
        // Ptr method arm and the body tail would memoize as UNKNOWN — the with_ptr result tid
        // then declines and codegen falls back to the flat carrier. Binding the param to Ptr[U8]
        // here, exactly as the List-HOF path binds the element type, lets the body type and the
        // closure's return tid publish faithfully. An annotated param keeps its own type
        // (check_closure_body prefers the declared type over this hint).
        if type_kind(obj_t) == TyKind.Bytes && node_method(node) == "with_ptr" {
            let wp_cls = closure_arg_at(args_sl, 0)
            check_closure_body(wp_cls, make_fn_type(TYPE_UNKNOWN, [make_ptr_type(TYPE_U8)]))
            hof_arg = 0
            // The call answers whatever its callback answers. infer_type's arm declines an
            // unascribed callback because the body is not walked when it runs; once the walk has
            // happened the closure's own tid carries the answer and the call takes it.
            if wp_cls != -1 {
                let wp_ret = tc_fn_tid_ret(tc_lookup_node_tid(wp_cls))
                if wp_ret >= 0 { tc_publish_node_tid(node, wp_ret) }
            }
        }
        // "Only List has closure-taking HOFs" is true of the STDLIB and false of the
        // LANGUAGE — any fn-typed param takes a closure, and `async.spawn(fn() { ... })`
        // (the shape in our own src/cli.bl) is a MethodCall on a receiver that is not a
        // List, so its body still needs walking below.
        tc_check_callable_arg_bodies(args_sl, hof_arg)
        tc_check_mutating_in_args(args_sl)
        return
    }

    // A plain call's closure argument (`take(fn() { ... })`) needs its body typechecked
    // too. Only the callable arguments need walking: infer_type has already visited every
    // argument expression, and recursing unconditionally would surface the spurious errors
    // the ExprStmt arm's comment describes.
    if kind == NodeKind.Call {
        // The CALLEE of an immediately-invoked closure is a body that needs walking too,
        // and this arm reached only the arguments. Callee position joins call-argument
        // and struct-literal-field position as places a closure body can hide. Without
        // this, `fn() -> Int { "notint" }()` escaped to the C compiler.
        let cb_callee = node_left(node)
        if cb_callee != -1 && node_kind(cb_callee) == NodeKind.Closure {
            tc_check_body(cb_callee)
        }
        tc_check_callable_arg_bodies(node_args(node), -1)
        tc_check_mutating_in_args(node_args(node))
        return
    }

    // A struct-literal field value in binding/statement position (`let b = Box { v: match
    // ... }`, `Route { cb: Some(fn(x: Int) -> Int { x }) }`). infer_type's StructLit arm
    // inters field values only on the GENERIC reverse-inference path — a non-generic struct
    // returns its bare tid without ever typing a field — so nothing there walked a
    // block-bearing value's non-tail statements, nor a closure buried in a call argument.
    // A field value is a value in statement position like any other, so it takes the same
    // walk chooser a `let` value takes.
    if kind == NodeKind.StructLit {
        let sl_flds = node_fields(node)
        if sl_flds != -1 {
            let mut sfi = 0
            while sfi < sublist_length(sl_flds) {
                tc_walk_stmt_value(node_value(sublist_get(sl_flds, sfi)))
                sfi = sfi + 1
            }
        }
        // The walk infers each field value again, and an empty container in an arm tail
        // mints fresh metavars when it does. The literal's own type is still each field's
        // expected type (sections/03_types.md 3.3), so it pins them once more, as a let's
        // annotation pins its value after the same walk.
        let sl_tid = tc_lookup_node_tid(node)
        if tc_tid_is_no_info(sl_tid) == 0 { tc_pin_declared_into_value(sl_tid, node, sl_tid) }
        return
    }

    let _skip = 0
}

let mut tc_pattern_binding_type: Int = -1
// Expected enum tid for a bare struct-style construction site (`Name { ... }`).
// Set before infer_type at the four hint sources (binding annotation, return type,
// fn-arg param, Ok/Err/Some carrier) and consulted FIRST among the unqualified
// resolution rules. -1 = no hint. Mirrors the tc_pattern_binding_type discipline.
let mut tc_construct_hint: Int = -1

// §2.9 value-context flag. infer_type walks ONLY value positions (flat sub-expressions and
// block/with/async/match TAILS) — never a discarded statement, which tc_check_body walks
// instead — so the flag rides infer_type's recursion: value sites set it before inferring
// their value, and it reaches every consumed position beneath. 0 = discard/statement context
// (an else-less `if` is legal, type ()); 1 = value context (the IfExpr arm reports E0304).
// Default 0 is fail-safe: a missed value site leaks (spec-should-error but does not) rather
// than rejecting legal code. Set by tc_infer_value at let/return/assignment/fn-tail/argument.
let mut tc_if_value_ctx: Int = 0

// The type whose variants a pattern or a qualified construction can name: a declared enum
// (its base tid), or a prelude carrier (`carrier` is then Option or Result and `base` is -1).
type VariantOwner {
    base: Int
    carrier: TyKind
}

// What is wrong with one variant or struct pattern, judged against the type at its position
// (sections/03_types.md §3.5 Pattern Forms). Each fault is the only error for its pattern.
type PatternFault {
    Clean
    UnknownQualifier
    NoSuchVariant(owner: VariantOwner)
    NoVariants(shown: Str, noun: Str)
    WrongType(named: Str, tid: Int)
    OnScalar(enum_qual: Str)
}

fn tc_carrier_owner(k: TyKind) -> VariantOwner {
    VariantOwner { base: -1, carrier: k }
}

fn tc_enum_owner(base: Int) -> VariantOwner {
    VariantOwner { base: base, carrier: TyKind.Unknown }
}

// The owner's declaration node, or -1 for a prelude carrier or a name two modules declare.
fn tc_owner_decl(o: VariantOwner) -> Int {
    if o.base < 0 { return -1 }
    let decl = tc_tid_decl_node(o.base)
    if decl < 0 { -1 } else { decl }
}

// The owner's name as the diagnostics write it.
fn tc_owner_shown(o: VariantOwner) -> Str {
    if o.base < 0 { return tc_prelude_carrier_name(o.carrier) }
    let decl = tc_owner_decl(o)
    if decl != -1 { return tc_nominal_type_name(decl) }
    strip_module_qualifier(type_to_str(o.base))
}

// The owner of the variants a value of type `h` (resolved) can match, if it has variants.
fn tc_variant_owner_of(h: Int) -> Option[VariantOwner] {
    if h < 0 { return None }
    match type_kind(h) {
        TyKind.Option => Some(tc_carrier_owner(TyKind.Option))
        TyKind.Result => Some(tc_carrier_owner(TyKind.Result))
        TyKind.Enum => Some(tc_enum_owner(tc_enum_base_tid(h)))
        _ => None
    }
}

// The owner a qualifier names: a declared enum, or `Option` / `Result` when no declared type
// takes that name.
fn tc_qualifier_owner(qual: Str) -> Option[VariantOwner] {
    let qtid = lookup_named_type(qual)
    if qtid != -1 {
        return tc_variant_owner_of(resolve_alias_tid(qtid))
    }
    if qual == "Option" { return Some(tc_carrier_owner(TyKind.Option)) }
    if qual == "Result" { return Some(tc_carrier_owner(TyKind.Result)) }
    None
}

fn tc_owner_has_variant(o: VariantOwner, name: Str) -> Bool {
    if o.base < 0 { return (tc_prelude_carrier_of(name) ?? TyKind.Unknown) == o.carrier }
    get_variant_by_name(o.base, name) != -1
}

fn tc_same_owner(a: VariantOwner, b: VariantOwner) -> Bool {
    a.base == b.base && a.carrier == b.carrier
}

// The name that spells `o` at this site, when its declared name resolves back to it there. A
// namesake shadowed by a local type, or reached only through a renamed import, has none.
fn tc_owner_site_name(o: VariantOwner) -> Option[Str] {
    let decl = if o.base < 0 { -1 } else { tc_owner_decl(o) }
    let name = if decl == -1 { tc_owner_shown(o) } else { node_name(decl) }
    match tc_qualifier_owner(name) {
        Some(s) => if tc_same_owner(s, o) { Some(name) } else { None }
        None => None
    }
}

// Declaration order, so the list reads as the type does.
fn tc_owner_variant_names(o: VariantOwner) -> List[Str] {
    if o.carrier == TyKind.Option { return ["Some", "None"] }
    if o.carrier == TyKind.Result { return ["Ok", "Err"] }
    let mut names: List[Str] = []
    for slot in tc_enum_variant_slots(o.base) { names.push(tc_evar_name(slot)) }
    names
}

// 0 for a unit variant, 1 for `( )`, 2 for `{ }`: the rename is a machine fix only when the
// written payload has the form the suggested variant was declared with.
fn tc_owner_variant_form(o: VariantOwner, name: Str) -> Int {
    if o.base < 0 { return if name == "None" { 0 } else { 1 } }
    let decl = tc_variant_decl_node(get_variant_by_name(o.base, name))
    if decl == -1 { return -1 }
    if node_int_val(decl) == 1 { return 2 }
    if node_fields(decl) != -1 { return 1 }
    0
}

fn tc_pattern_payload_form(pat: Int) -> Int {
    if node_kind(pat) == NodeKind.StructPattern || node_int_val(pat) == 1 { return 2 }
    if node_fields(pat) == -1 { return 0 }
    1
}

// The struct a name declares, as its base tid, or -1.
fn tc_named_struct_base(name: Str) -> Int ! TypeCheck.Resolve, Diag.Report {
    let rt = resolve_alias_tid(resolve_type_name(name))
    if rt == -1 || type_kind(rt) != TyKind.Struct { return -1 }
    tc_struct_base_tid(rt)
}

// A bare variant name, against the resolved type `h` at its position.
fn tc_bare_variant_fault(name: Str, h: Int) -> PatternFault {
    match tc_variant_owner_of(h) {
        Some(o) => return if tc_owner_has_variant(o, name) { PatternFault.Clean } else { PatternFault.NoSuchVariant(o) }
        None => {}
    }
    if tc_kind_has_no_variants(h) != 0 { return PatternFault.OnScalar("") }
    if !tc_settled_without_variants(h) { return PatternFault.Clean }
    match type_kind(h) {
        TyKind.Struct => PatternFault.NoVariants(type_to_str(h), "a struct")
        TyKind.Tuple => PatternFault.NoVariants(type_to_str(h), "a tuple")
        TyKind.Typevar => PatternFault.NoVariants(type_to_str(h), "a type parameter")
        _ => PatternFault.NoVariants(type_to_str(h), "not an enum")
    }
}

// Whether `h`, a type no variant owner claims, is settled and so can match no variant pattern.
// A type already in error was reported where it went wrong, an enum with no owner is not one
// this check can read, and an unknown parameter type (E0507) recovers as an open type variable.
// Never has no values, so no variant either.
fn tc_settled_without_variants(h: Int) -> Bool {
    match type_kind(h) {
        TyKind.Unknown => false
        TyKind.Enum => false
        TyKind.Typevar => tc_typevar_is_rigid(h) != 0
        _ => true
    }
}

// The order of checks is the spec's: resolve the qualifier, look the variant up in it, then
// compare it with the type at the position.
fn tc_qualified_variant_fault(qual: Str, variant: Str, h: Int, open: Bool) -> PatternFault {
    match tc_qualifier_owner(qual) {
        Some(q) => {
            if !tc_owner_has_variant(q, variant) { return PatternFault.NoSuchVariant(q) }
            if open { return PatternFault.Clean }
            if tc_kind_has_no_variants(h) != 0 { return PatternFault.OnScalar(if q.base >= 0 { qual } else { "" }) }
            match tc_variant_owner_of(h) {
                Some(o) => return if tc_same_owner(o, q) { PatternFault.Clean } else { PatternFault.WrongType(qual, q.base) }
                None => {}
            }
            if tc_settled_without_variants(h) { return PatternFault.WrongType(qual, q.base) }
            PatternFault.Clean
        }
        None => {
            let qtid = lookup_named_type(qual)
            if qtid == -1 && is_known_type(qual) == 0 && is_builtin_namespace(qual) == 0 { return PatternFault.UnknownQualifier }
            if qtid != -1 && type_kind(resolve_alias_tid(qtid)) == TyKind.Struct { return PatternFault.NoVariants(qual, "a struct") }
            PatternFault.Clean
        }
    }
}

// The one place a variant or struct pattern is looked up against the type at its position,
// `hint`. A bare name reaches here only when it names a variant (an uppercase name in a
// refutable pattern). A position whose type is not known yet is not judged here: the
// under-determined check owns it.
fn tc_pattern_fault(pat: Int, hint: Int) -> PatternFault ! TypeCheck.Resolve, Diag.Report {
    let h = if hint < 0 { -1 } else { resolve_alias_tid(tc_tid_resolved(hint)) }
    let open = h < 0 || tc_tid_is_no_info(h) != 0 || tc_is_unbound_metavar(h) != 0
    let k = node_kind(pat)
    if k == NodeKind.IdentPattern { return if open { PatternFault.Clean } else { tc_bare_variant_fault(node_name(pat), h) } }
    if k != NodeKind.EnumPattern && k != NodeKind.StructPattern { return PatternFault.Clean }
    if k == NodeKind.EnumPattern {
        let qual = node_name(pat)
        let variant = node_type_name(pat)
        if variant != "" && is_import_module_name(qual) == 0 { return tc_qualified_variant_fault(qual, variant, h, open) }
        if open { return PatternFault.Clean }
        return tc_bare_variant_fault(if variant == "" { qual } else { variant }, h)
    }
    if open { return PatternFault.Clean }
    let tname = node_type_name(pat)
    match tc_variant_owner_of(h) {
        Some(o) => {
            if tc_owner_has_variant(o, tname) { return PatternFault.Clean }
            let named = tc_named_struct_base(tname)
            return if named != -1 { PatternFault.WrongType(tname, named) } else { PatternFault.NoSuchVariant(o) }
        }
        None => {}
    }
    let named = tc_named_struct_base(tname)
    if named == -1 { return tc_bare_variant_fault(tname, h) }
    let hk = type_kind(h)
    if hk == TyKind.Struct { return if tc_struct_base_tid(h) == named { PatternFault.Clean } else { PatternFault.WrongType(tname, named) } }
    if tc_settled_without_variants(h) { return PatternFault.WrongType(tname, named) }
    PatternFault.Clean
}

// The column `name` starts at in `qual.name` on the node's line, so a span can cover the
// variant alone. -1 when the line does not hold that spelling (`K\n    .Name`): the caller
// then has no span it can rewrite.
fn tc_qualified_name_col(node: Int, qual: Str, name: Str) -> Int {
    let text = diag_source_line(diag_file_for_node(node), node_line(node))
    let back = node_col(node) - 2 - qual.byte_len()
    match text.byte_index_of("{qual}.{name}", if back > 0 { back } else { 0 }) {
        Some(i) => i + qual.byte_len() + 2
        None => -1
    }
}

// The note names the one other visible enum that declares a bare `name`. It is found only to
// write the note: the pattern still means a variant of `owner`, so nothing is typed from it.
fn tc_other_enum_note(name: Str, owner: VariantOwner, subject: Str, site: Int) -> List[Str] {
    let mut others: List[Str] = []
    let mut decls: List[Int] = []
    let mut carrier: Option[TyKind] = None
    match tc_bare_variant_from_program(name, site, tc_prelude_carrier_of(name)) {
        BareVariantPick.NotAVariant => {}
        BareVariantPick.Carrier(k) => carrier = Some(k)
        BareVariantPick.Declared(_, slot) => decls.push(evar_pool.get(slot).unwrap().enum_decl)
        BareVariantPick.Ambiguous(c, enums) => {
            carrier = c
            decls = enums
        }
    }
    match carrier {
        Some(k) => if k != owner.carrier { others.push(tc_prelude_carrier_name(k)) }
        None => {}
    }
    let own = tc_owner_decl(owner)
    for d in decls {
        if d != own { others.push(tc_nominal_type_name(d)) }
    }
    let shown = tc_owner_shown(owner)
    // A user enum that spells its name like the owner would make the note contradict itself.
    if others.len() != 1 || others.get(0).unwrap() == shown { return [] }
    let place = if subject != "" { "a pattern for `{subject}`" } else { "a pattern here" }
    ["`{name}` is a variant of `{others.get(0).unwrap()}`, not of `{shown}`; {place} can name only variants of `{shown}`"]
}

// error[NoSuchVariant] at the variant name, written `name` with payload form `form`. The help
// never says "add the variant": a misspelling almost never means the enum lacks one. The
// rename starts at `fix_from`, before the name when a `mut` there must go too, since a
// variant binds nothing.
fn tc_report_no_such_variant(node: Int, owner: VariantOwner, name: Str, form: Int, col: Int, fix_from: Int, notes: List[Str]) ! Diag.Report {
    // An enum its module declares twice (E1016) may have meant the other's variants.
    if tc_type_decl_poisoned(tc_owner_decl(owner)) { return }
    let shown = tc_owner_shown(owner)
    let names = tc_owner_variant_names(owner)
    let sugg = nearest_name(name, names)
    let help = if sugg != "" { "did you mean `{sugg}`?" } else { "`{shown}` declares: {names.join(", ")}" }
    let line = node_line(node)
    let start = if col == -1 { node_col(node) } else { col }
    let end = start + name.byte_len()
    let before = diag_entry_count()
    diag_error_span_at_notes("NoSuchVariant", NO_SUCH_VARIANT, "`{shown}` has no variant `{name}`", node, line, start, end, help, notes)
    if sugg != "" && col != -1 && diag_entry_count() > before && tc_owner_variant_form(owner, sugg) == form {
        diag_set_last_fix_at(if fix_from == col { "rename to" } else { "remove `mut` and rename to" }, sugg, line, fix_from, line, end)
    }
}

// The owner of the variants a construction `qual.name` (§3.4) can name, when it names none of
// them: `qual` is an enum, an alias of one or a prelude carrier, and no static method takes
// `name`. A lowercase name is a method or field, never a variant.
fn tc_value_missing_variant(qual: Str, name: Str) -> Option[VariantOwner] {
    if name.byte_len() == 0 || (name.byte_at(0) >= 97 && name.byte_at(0) <= 122) { return None }
    match tc_qualifier_owner(qual) {
        Some(o) => {
            if tc_owner_has_variant(o, name) || tc_static_method_named(qual, name) { return None }
            // Through an alias the static methods are declared on the enum itself.
            if o.base >= 0 && tc_static_method_named(tc_owner_shown(o), name) { return None }
            Some(o)
        }
        None => None
    }
}

fn tc_static_method_named(owner: Str, name: Str) -> Bool {
    lookup_fnsig("{owner}_{name}") != -1 || nr_has_impl_method(owner, name) != 0
}

fn tc_report_no_such_variant_value(node: Int, owner: VariantOwner, qual: Str, name: Str, form: Int) ! Diag.Report {
    let col = tc_qualified_name_col(node, qual, name)
    tc_report_no_such_variant(node, owner, name, form, col, col, [])
}

// The repairs for an uppercase name with no payload at a position that is not an enum: a
// lowercase name binds the value, and when a value of that name is in scope a guard compares
// with it. The guard is shown only when it would compile: the value has the type at the
// position, and that type has `==`. At the top of an arm the guard binds the matched value
// under its own name when the match names one; deeper, the guard cannot replace the whole
// arm pattern, so the help says where each part goes.
fn tc_bare_name_on_non_enum_help(name: Str, subject: Str, hint: Int) -> Str {
    let bind = "to bind the value, write a lowercase name"
    if hint < 0 { return bind }
    // nr_is_defined would mark the value read and hide an unused-value warning on it, and
    // nr_has_binding answers for a name bound anywhere, not here.
    let idx = nr_top_index(name)
    if idx == -1 { return bind }
    // A declaration this file's import list does not select is not in scope here.
    if !nr_index_is_local(idx) && nr_unselected_source(name) != "" { return bind }
    let vt = tc_named_value_tid(name, idx)
    let h = resolve_alias_tid(tc_tid_resolved(hint))
    if vt < 0 || resolve_alias_tid(tc_tid_resolved(vt)) != h || tc_eq_need(h, []).len() > 0 { return bind }
    if subject == "" { return "{bind}\nto compare with the value `{name}`, write a lowercase name here and add a guard: `if n == {name}`" }
    // An uppercase binder would itself name a variant, and `self` is no binder.
    let v = if tc_name_is_upper(subject) || subject == "self" { "n" } else { subject }
    "{bind}\nto compare with the value `{name}`, write a guard: `{v} if {v} == {name} =>`"
}

// The type of the value the scope entry `idx` for `name` holds, or -1 when it is not known.
// A module-level binding is filed with no type before inference reaches it; its declaration
// carries the type.
fn tc_named_value_tid(name: Str, idx: Int) -> Int {
    let vt = nr_scope_types.get(idx).unwrap()
    if tc_tid_is_no_info(vt) == 0 { return vt }
    let here = tc_module_let_decl_node(nr_current_module, name)
    let decl = if here != -1 { here } else { tc_module_let_decl_node(tc_symbol_module.get(name) ?? "", name) }
    if decl == -1 { return -1 }
    let t = tc_lookup_node_tid(decl)
    if tc_tid_is_no_info(t) == 0 { t } else { -1 }
}

fn tc_report_pattern_fault(pat: Int, fault: PatternFault, hint: Int, subject: Str) ! Diag.Report {
    let k = node_kind(pat)
    let qualified = k == NodeKind.EnumPattern && node_type_name(pat) != ""
    let qual = if qualified { node_name(pat) } else { "" }
    let name = if k == NodeKind.StructPattern || qualified { node_type_name(pat) } else { node_name(pat) }
    // `mut Name` starts at `mut`; the name ends where the node does.
    let ident_end = k == NodeKind.IdentPattern && node_end_col(pat) > 0 && node_end_line(pat) == node_line(pat)
    let col = if qualified { tc_qualified_name_col(pat, qual, name) } else if ident_end { node_end_col(pat) - name.byte_len() } else { node_col(pat) }
    let line = node_line(pat)
    let bare = !qualified || is_import_module_name(qual) != 0
    match fault {
        PatternFault.Clean => {}
        PatternFault.UnknownQualifier => {
            diag_error_span_at_notes("UnknownType", UNKNOWN_TYPE, "unknown type `{qual}`", pat, line, node_col(pat), node_col(pat) + qual.byte_len(),
                "a qualified variant pattern is written `Enum.Variant`, and no type is named `{qual}`", [])
        }
        PatternFault.NoSuchVariant(owner) => {
            let notes = if bare { tc_other_enum_note(name, owner, subject, pat) } else { [] }
            let mut_written = ident_end && node_is_mut(pat) != 0 && node_is_mut(pat) != BINDER_MUT_RECOVERED
            tc_report_no_such_variant(pat, owner, name, tc_pattern_payload_form(pat), col, if mut_written { node_col(pat) } else { col }, notes)
        }
        PatternFault.NoVariants(shown, noun) => {
            let at = if col == -1 { node_col(pat) } else { col }
            let help = if k == NodeKind.IdentPattern { tc_bare_name_on_non_enum_help(name, subject, hint) } else { "" }
            // `Point.Zed` names a variant of `Point` itself, so it reads as a lookup that found
            // none; only the type at the position makes a bare name's fault a type mismatch.
            let (dname, dcode) = if bare { ("EnumPatternNeedsEnumScrutinee", ENUM_PATTERN_NON_ENUM) } else { ("NoSuchVariant", NO_SUCH_VARIANT) }
            diag_error_span_at_notes(dname, dcode, "`{shown}` is {noun}; it has no variants", pat, line, at, at + name.byte_len(), help, [])
        }
        PatternFault.WrongType(named, ptid) => {
            let h = resolve_alias_tid(tc_tid_resolved(hint))
            // An enum its module declares twice (E1016) may have meant the other's variants.
            if tc_type_decl_poisoned(tc_tid_decl_node(h)) { return }
            let at = if col == -1 { node_col(pat) + qual.byte_len() + 1 } else { col }
            let start = if qualified { at - qual.byte_len() - 1 } else { at }
            let end = at + name.byte_len()
            // Two types with one name print as `Name (module)` (§10.6); else as written.
            let homed = ptid >= 0 && tc_types_share_name(ptid, h)
            let (pat_s, val_s) = if homed { tc_type_pair_strs(ptid, h) } else { (named, type_to_str(h)) }
            let msg = "pattern of type `{pat_s}` used on a value of type `{val_s}`"
            match tc_variant_owner_of(h) {
                Some(o) => {
                    let owner_s = if homed { tc_type_with_home(h, tc_type_head_name(h)) } else { tc_owner_shown(o) }
                    let listed = "`{owner_s}` declares: {tc_owner_variant_names(o).join(", ")}"
                    // A span not found in the source is no safe rewrite.
                    let same_form = col != -1 && tc_owner_has_variant(o, name) && tc_owner_variant_form(o, name) == tc_pattern_payload_form(pat)
                    let site: Option[Str] = if same_form { tc_owner_site_name(o) } else { None }
                    let help = match site {
                        Some(t) => "write `{t}.{name}`; {listed}"
                        None => listed
                    }
                    let before = diag_entry_count()
                    diag_error_span_at_notes("TypeError", TYPE_ERROR, msg, pat, line, start, end, help, [])
                    match site {
                        Some(t) => if diag_entry_count() > before { diag_set_last_fix_at("rename to", "{t}.{name}", line, start, line, end) }
                        None => {}
                    }
                }
                None => diag_error_span_at_notes("TypeError", TYPE_ERROR, msg, pat, line, start, end, "", [])
            }
        }
        PatternFault.OnScalar(enum_qual) => {
            let shown = if qualified { "{qual}.{name}" } else { name }
            let help = if enum_qual != "" {
                "match the enum itself, or cross the boundary explicitly with {enum_qual}.from_int(...), which answers Option[{enum_qual}]"
            } else if k == NodeKind.IdentPattern {
                tc_bare_name_on_non_enum_help(name, subject, hint)
            } else {
                "a scalar has no variants: match it with literals, ranges or a binding"
            }
            let at = if col == -1 { node_col(pat) + qual.byte_len() + 1 } else { col }
            let start = if qualified { at - qual.byte_len() - 1 } else { at }
            diag_error_span_at_notes("EnumPatternNeedsEnumScrutinee", ENUM_PATTERN_NON_ENUM,
                "match arm names variant `{shown}`, but the value being matched has type `{type_to_str(resolve_alias_tid(tc_tid_resolved(hint)))}` -- a scalar has no variants",
                pat, line, start, at + name.byte_len(), help, [])
        }
    }
}

// §3.5: only a binder under a label the type does not declare is poison. A binder under a
// duplicate label still names a declared field, so it keeps that field's type. The check is
// by name: a repeated unknown label is listed once, and each of its binders is poison.
fn tc_label_is_unknown(faults: LitFaults, name: Str) -> Bool {
    for u in faults.unknowns {
        if node_name(u.at) == name { return true }
    }
    false
}

// An unknown or duplicate label makes the arm cover nothing; leaving fields out does not.
fn tc_labels_cover_nothing(faults: LitFaults) -> Bool {
    faults.dups.len() > 0 || faults.unknowns.len() > 0
}

// Types `node` against tc_pattern_binding_type and binds its names. Reports each pattern, at
// any depth, that names nothing the value there can be (§3.5 Pattern Forms), and answers
// whether there was one. Inference runs this walk many times per node; a repeat report is one
// diagnostic. `subject` names the matched value for the note, at the top level only. Under a
// faulted pattern every binder takes the poison type, so no use of it reports anything more.
// Genuinely saves/restores tc_pattern_binding_type around recursive descent;
// the nr_define/nr_define_typed/recursive calls also write scope-management
// globals (nr_scope_*, nr_name_top) — defining the pattern's bindings is the
// intended permanent effect, not speculative state to roll back.
@allow(UnrestoredMutation)
fn tc_check_pattern_types(node: Int, subject: Str, poisoned: Bool, refutable: Bool) -> Bool ! TypeCheck.Resolve, Diag.Report {
    if node == -1 { return false }
    let kind = node_kind(node)
    // Every pattern MATCHES a value, so every pattern node has a type: the value it is
    // matched against, which is the binding hint exactly as it arrives here, before any arm
    // below decomposes it for a child. Published once at the top rather than arm by arm --
    // the two arms that bind a name did it for themselves, so a wildcard, a literal, a range
    // and a nested variant pattern were the shapes nothing published for, and codegen asking
    // one of them for its type found no answer at all.
    if tc_pattern_binding_type >= 0 { tc_publish_node_tid(node, tc_pattern_binding_type) }
    if kind == NodeKind.IntPattern || kind == NodeKind.RangePattern { tc_check_int_pattern_range(node, tc_pattern_binding_type) }
    // An uppercase name in a refutable pattern is a variant: it is judged below like `Red(x)`.
    // A nullary variant (`None`) and `_` bind nothing, but they still MATCH a value, so they
    // keep the tid published above; only the scope entry is conditional.
    if kind == NodeKind.IdentPattern && !(refutable && tc_name_is_upper(node_name(node))) {
        let name = node_name(node)
        if !pattern_name_binds(name, refutable) { return false }
        // Every arm above decomposes the binding hint one level -- Option/Result unwrap, tuple
        // element, list element, enum variant field -- so the binder's type is already
        // computed, and the tid published above hands codegen that decomposition.
        if tc_pattern_binding_type >= 0 {
            nr_define_typed(name, node_is_mut(node), tc_pattern_binding_type, node)
        } else {
            nr_define_mut(name, node_is_mut(node))
        }
        return false
    }
    // A pattern under a faulted one is not judged: its types are poison, and the one error
    // already covers it.
    let fault = if poisoned { PatternFault.Clean } else { tc_pattern_fault(node, tc_pattern_binding_type) }
    let faulted = match fault {
        PatternFault.Clean => false
        _ => true
    }
    if faulted { tc_report_pattern_fault(node, fault, tc_pattern_binding_type, subject) }
    // Only an E0547 or a pattern E0300 makes the arm cover nothing (§3.5 Exhaustiveness);
    // every fault still poisons the binders under it.
    let covers_nothing = match fault {
        PatternFault.NoSuchVariant(_) => true
        PatternFault.NoVariants(_, _) => true
        PatternFault.WrongType(_, _) => true
        _ => false
    }
    if kind == NodeKind.IdentPattern { return covers_nothing }
    let bad = faulted || poisoned
    let poison = tc_error_recovery_tid()
    let mut child_bad = false
    if kind == NodeKind.EnumPattern {
        let vname = node_name(node)
        let tname = node_type_name(node)
        let saved_binding = tc_pattern_binding_type
        // short_name is the variant's declared name; for qualified `E.A(...)` it's `tname`,
        // for unqualified `A(...)` it's `vname`. enum_tid is resolved from the qualifier when
        // present, otherwise from the outer binding hint, otherwise via global lookup.
        let mut short_name = vname
        let mut variant_enum_tid = -1
        if tname != "" {
            short_name = tname
            variant_enum_tid = lookup_named_type(vname)
        }
        // Peel from the RESOLVED binding hint: a push-built (metavar-pinned) scrutinee holds
        // the carrier as a bound metavar (kind Unknown, inner1 -> the Option/Result solution),
        // so reading .inner1/.inner2 off the raw tid yields the carrier itself, not the payload,
        // and the binder is typed one level too shallow (`Some(v)` over Option[Int] binds v as
        // Option[Int]). type_kind already resolves; the inner read must too. Identity on a
        // concrete scrutinee, so only the metavar case changes.
        let pbt_resolved = if tc_pattern_binding_type >= 0 { tc_tid_resolved(tc_pattern_binding_type) } else { tc_pattern_binding_type }
        // `Option.Some(v)` peels as `Some(v)` does; `Mode.Some(v)` names a user enum's variant.
        let carrier_spelled = tname == "" || tc_qualified_carrier(vname, tname).is_some()
        if bad {
            tc_pattern_binding_type = poison
        } else if carrier_spelled && short_name == "Some" && tc_pattern_binding_type >= 0 && type_kind(pbt_resolved) == TyKind.Option {
            tc_pattern_binding_type = ty_pool.get(pbt_resolved).unwrap().inner1
        } else if carrier_spelled && short_name == "Ok" && tc_pattern_binding_type >= 0 && type_kind(pbt_resolved) == TyKind.Result {
            tc_pattern_binding_type = ty_pool.get(pbt_resolved).unwrap().inner1
        } else if carrier_spelled && short_name == "Err" && tc_pattern_binding_type >= 0 && type_kind(pbt_resolved) == TyKind.Result {
            tc_pattern_binding_type = ty_pool.get(pbt_resolved).unwrap().inner2
        } else {
            tc_pattern_binding_type = -1
        }
        let mut var_idx = -1
        if !bad && variant_enum_tid >= 0 {
            var_idx = get_variant_by_name(variant_enum_tid, short_name)
        }
        if !bad && var_idx == -1 && saved_binding >= 0 && type_kind(saved_binding) == TyKind.Enum {
            var_idx = get_variant_by_name(tc_enum_base_tid(pbt_resolved), short_name)
        }
        // The scrutinee type alone decides what a bare variant pattern names (§3.4 patterns:
        // the program-wide search never runs in a pattern). Searching by bare name past a
        // known scrutinee let a user enum's `Some(val: T)` type the binder of an Option
        // match anywhere in the program, std included, with the user enum's free T.
        if !bad && var_idx == -1 && tc_tid_is_no_info(saved_binding) != 0 {
            let fallback_tid = get_variant_enum_tid(short_name)
            if fallback_tid != TYPE_UNKNOWN {
                var_idx = get_variant_by_name(fallback_tid, short_name)
            }
        }
        let flds_sl = node_fields(node)
        let is_struct_pat = node_int_val(node)
        let labels = tc_check_pattern_labels(if !bad && is_struct_pat != 0 && var_idx >= 0 { tc_variant_literal_owner(var_idx) } else { None }, node)
        if flds_sl != -1 {
            let mut i = 0
            while i < sublist_length(flds_sl) {
                let f = sublist_get(flds_sl, i)
                if is_struct_pat != 0 {
                    // Struct-style fields: StructLitField nodes; define field names as vars
                    let fpat = node_pattern(f)
                    let fname = node_name(f)
                    let mut sub_t = -1
                    if tc_label_is_unknown(labels, fname) {
                        sub_t = poison
                    } else if var_idx >= 0 {
                        sub_t = tc_subst_evfield_from_instance(lookup_evfield_type_by_name(var_idx, fname), saved_binding)
                    }
                    if sub_t < 0 { sub_t = tc_pattern_binding_type }
                    if fpat != -1 {
                        tc_pattern_binding_type = sub_t
                        if tc_check_pattern_types(fpat, "", bad, refutable) { child_bad = true }
                    } else {
                        if sub_t >= 0 {
                            nr_define_typed(fname, node_is_mut(f), sub_t, f)
                            tc_publish_node_tid(f, sub_t)
                        } else {
                            nr_define_mut(fname, node_is_mut(f))
                        }
                    }
                } else {
                    let mut sub_t = -1
                    if var_idx >= 0 { sub_t = tc_subst_evfield_from_instance(lookup_evfield_type_by_index(var_idx, i), saved_binding) }
                    if sub_t < 0 { sub_t = tc_pattern_binding_type }
                    tc_pattern_binding_type = sub_t
                    if tc_check_pattern_types(f, "", bad, refutable) { child_bad = true }
                }
                i = i + 1
            }
        }
        tc_pattern_binding_type = saved_binding
        return covers_nothing || tc_labels_cover_nothing(labels) || child_bad
    }
    if kind == NodeKind.StructPattern {
        // Resolve the carrier so each field binder is typed from its declared field type,
        // the same treatment every sibling arm gives its binders. Two carriers reach here:
        // a struct-style enum variant (resolved to a variant index, fields via evfield_pool)
        // and a plain struct (resolved to a struct tid, fields via sfield_pool). Without this
        // the binder is untyped by omission and a mistyped use escapes to the C compiler.
        let tname = node_type_name(node)
        let saved_binding = tc_pattern_binding_type
        let mut var_idx = -1
        let mut struct_tid = -1
        // The scrutinee hint is authoritative: a struct hint types fields from the struct, an
        // enum hint from the named variant. Only with no usable hint do we resolve the name
        // globally, and there a top-level struct still wins over a same-named enum variant --
        // otherwise a bare variant lookup would hijack an unrelated struct destructure.
        if !bad && saved_binding >= 0 && type_kind(saved_binding) == TyKind.Struct {
            struct_tid = saved_binding
        } else if !bad && saved_binding >= 0 && type_kind(saved_binding) == TyKind.Enum {
            var_idx = get_variant_by_name(tc_enum_base_tid(tc_tid_resolved(saved_binding)), tname)
        }
        if !bad && var_idx == -1 && struct_tid == -1 {
            let rt = resolve_type_name(tname)
            if rt != -1 && type_kind(rt) == TyKind.Struct {
                struct_tid = rt
            } else if tc_tid_is_no_info(saved_binding) != 0 {
                let fallback_tid = get_variant_enum_tid(tname)
                if fallback_tid != TYPE_UNKNOWN {
                    var_idx = get_variant_by_name(fallback_tid, tname)
                }
            }
        }
        let mut owner: Option[LitOwner] = None
        if var_idx >= 0 {
            owner = tc_variant_literal_owner(var_idx)
        } else if struct_tid >= 0 {
            owner = tc_struct_literal_owner(struct_tid)
        }
        let labels = tc_check_pattern_labels(owner, node)
        let flds_sl = node_fields(node)
        if flds_sl != -1 {
            let mut i = 0
            while i < sublist_length(flds_sl) {
                let f = sublist_get(flds_sl, i)
                let fname = node_name(f)
                let fpat = node_pattern(f)
                // The pools hold the DECLARED field type, which for a generic carrier is
                // the carrier's own type parameter. The binder is typed at the instance the
                // scrutinee carries, so `Box[Str] { v, .. }` binds `v` at Str and not at T —
                // the same substitution the qualified variant spelling above already makes,
                // and the one thing that keeps the two spellings of one pattern in agreement.
                let mut sub_t = -1
                if bad || tc_label_is_unknown(labels, fname) {
                    sub_t = poison
                } else if var_idx >= 0 {
                    sub_t = tc_subst_evfield_from_instance(lookup_evfield_type_by_name(var_idx, fname), saved_binding)
                } else if struct_tid >= 0 {
                    sub_t = tc_subst_evfield_from_instance(get_struct_field_tid(struct_tid, fname), struct_tid)
                }
                if fpat != -1 {
                    tc_pattern_binding_type = sub_t
                    if tc_check_pattern_types(fpat, "", bad, refutable) { child_bad = true }
                } else {
                    if sub_t >= 0 {
                        nr_define_typed(fname, node_is_mut(f), sub_t, f)
                        tc_publish_node_tid(f, sub_t)
                    } else {
                        nr_define_mut(fname, node_is_mut(f))
                    }
                }
                i = i + 1
            }
        }
        tc_pattern_binding_type = saved_binding
        return covers_nothing || tc_labels_cover_nothing(labels) || child_bad
    }
    if kind == NodeKind.TuplePattern {
        let saved_binding = tc_pattern_binding_type
        let elems_sl = node_elements(node)
        if elems_sl != -1 {
            // Decompose the tuple binding hint so each element pattern is typed
            // against its own element type, not the whole tuple. Without this an
            // Option/Result element binder is typed as the enclosing tuple and a
            // nested match on it fails typecheck.
            // The hint is a bare unbound metavar (`for (a, b) in xs` with xs's element
            // type still open), so it cannot decompose yet. BIND it to a tuple of fresh
            // per-leaf metavars rather than handing each leaf a disconnected one: the
            // leaves then live inside the scrutinee's own type, so a later statement that
            // pins the iterable (`xs.push((1, 2))`) solves them too. Minting unreachable
            // metavars instead would make every such leaf permanently under-determined and
            // reject a program whose element type IS determined.
            if !poisoned && saved_binding >= 0 && tc_is_unbound_metavar(tc_resolve(saved_binding)) != 0 {
                let mut leaf_metas: List[Int] = []
                let mut li = 0
                while li < sublist_length(elems_sl) {
                    leaf_metas.push(make_metavar())
                    li = li + 1
                }
                let _bound = bind_metavar(saved_binding, make_tuple_type(leaf_metas))
            }
            let mut tup_start = -1
            let mut tup_count = 0
            // Read the RESOLVED entry: the hint arrives as a metavar bound to a tuple both
            // from the bind above and from any earlier unification, and reading the metavar's
            // own slot would report params_count 0 and decompose nothing.
            let hint_res = tc_resolve(saved_binding)
            if hint_res >= 0 && type_kind(hint_res) == TyKind.Tuple {
                let te = ty_pool.get(hint_res).unwrap()
                tup_start = te.params_start
                tup_count = te.params_count
            }
            let mut i = 0
            while i < sublist_length(elems_sl) {
                if poisoned {
                    tc_pattern_binding_type = poison
                } else if tup_start >= 0 && i < tup_count {
                    tc_pattern_binding_type = ty_param_list.get(tup_start + i).unwrap()
                } else {
                    tc_pattern_binding_type = -1
                }
                if tc_check_pattern_types(sublist_get(elems_sl, i), "", poisoned, refutable) { child_bad = true }
                i = i + 1
            }
        }
        tc_pattern_binding_type = saved_binding
        return child_bad
    }
    if kind == NodeKind.ListPattern {
        let saved_binding = tc_pattern_binding_type
        // Each fixed-position element binder is typed against the list's
        // element type, not the whole list. Without this a `[cmd]` binder is
        // typed as List[T] and any consumer that reads the binding's type
        // (e.g. the Display interpolation gate) sees the wrong type.
        let mut elem_t = if poisoned { poison } else { -1 }
        if !poisoned && saved_binding >= 0 && type_kind(saved_binding) == TyKind.List {
            elem_t = ty_pool.get(saved_binding).unwrap().inner1
        }
        let elems_sl = node_elements(node)
        if elems_sl != -1 {
            let mut i = 0
            while i < sublist_length(elems_sl) {
                tc_pattern_binding_type = elem_t
                if tc_check_pattern_types(sublist_get(elems_sl, i), "", poisoned, refutable) { child_bad = true }
                i = i + 1
            }
        }
        tc_pattern_binding_type = saved_binding
        return child_bad
    }
    if kind == NodeKind.OrPattern {
        // The alternatives are an `elements` LIST, not a left/right pair — the parser builds one
        // node for `a | b | c`. Reading left/right walked neither of them, so no alternative was
        // pattern-typed. Each alternative matches the same scrutinee, so each takes the hint
        // unchanged.
        let alts = node_elements(node)
        if alts != -1 {
            let saved_binding = tc_pattern_binding_type
            let or_start = nr_scope_names.len()
            let mut i = 0
            while i < sublist_length(alts) {
                tc_pattern_binding_type = saved_binding
                if i == 0 {
                    if tc_check_pattern_types(sublist_get(alts, i), subject, poisoned, refutable) { child_bad = true }
                } else {
                    let saved_warn = nr_or_alt_open()
                    if tc_check_pattern_types(sublist_get(alts, i), subject, poisoned, refutable) { child_bad = true }
                    let _ = nr_or_alt_close(or_start, saved_warn)
                }
                i = i + 1
            }
            tc_pattern_binding_type = saved_binding
        }
        return child_bad
    }
    if kind == NodeKind.AsPattern {
        // The binder takes the scrutinee UNDECOMPOSED — §3 Pattern Binding: "the bound name gets the
        // pre-destructured value (scrutinee type)". So it reads the hint as it arrives and leaves it
        // alone, and the inner pattern then decomposes that same hint rather than one the binder
        // already consumed.
        if tc_pattern_binding_type >= 0 {
            nr_define_typed(node_name(node), node_is_mut(node), tc_pattern_binding_type, node)
            tc_publish_node_tid(node, tc_pattern_binding_type)
        } else {
            nr_define_mut(node_name(node), node_is_mut(node))
        }
        // The inner pattern is not the whole arm: a guard written for the subject would drop
        // the `as` binder.
        return tc_check_pattern_types(node_pattern(node), "", poisoned, refutable)
    }
    false
}

// ── Test-block elaboration (spec §2.20 ?-in-test-body) ──────────────
//
// A test body using `?` is implicitly elaborated to return
// Result[Void, TestError]. The body itself has no surface return-type;
// any `->` annotation is rejected (E0515). When `?` appears anywhere in
// the body, tc_current_fn_ret is set to a synthetic Result[Void, TestError]
// for the duration of the body walk so the QM gate at infer_type accepts
// it. Otherwise the body remains void.

fn tc_node_contains_question_op(node: Int) -> Int {
    if node == -1 { return 0 }
    let kind = node_kind(node)
    if kind == NodeKind.UnaryOp {
        if node_op(node) == "?" { return 1 }
        return tc_node_contains_question_op(node_left(node))
    }
    if kind == NodeKind.BinOp {
        if tc_node_contains_question_op(node_left(node)) != 0 { return 1 }
        return tc_node_contains_question_op(node_right(node))
    }
    if kind == NodeKind.LetBinding {
        if tc_node_contains_question_op(node_value(node)) != 0 { return 1 }
        return tc_node_contains_question_op(node_target(node))
    }
    if kind == NodeKind.ExprStmt {
        return tc_node_contains_question_op(node_value(node))
    }
    if kind == NodeKind.Return {
        return tc_node_contains_question_op(node_value(node))
    }
    if kind == NodeKind.Block {
        let stmts_sl = node_stmts(node)
        if stmts_sl == -1 { return 0 }
        let mut i = 0
        while i < sublist_length(stmts_sl) {
            if tc_node_contains_question_op(sublist_get(stmts_sl, i)) != 0 { return 1 }
            i = i + 1
        }
        return 0
    }
    if kind == NodeKind.IfExpr {
        if tc_node_contains_question_op(node_condition(node)) != 0 { return 1 }
        if tc_node_contains_question_op(node_then_body(node)) != 0 { return 1 }
        return tc_node_contains_question_op(node_else_body(node))
    }
    if kind == NodeKind.WhileLoop {
        if tc_node_contains_question_op(node_condition(node)) != 0 { return 1 }
        return tc_node_contains_question_op(node_body(node))
    }
    if kind == NodeKind.ForIn {
        if tc_node_contains_question_op(node_iterable(node)) != 0 { return 1 }
        return tc_node_contains_question_op(node_body(node))
    }
    if kind == NodeKind.LoopExpr {
        return tc_node_contains_question_op(node_body(node))
    }
    if kind == NodeKind.WithBlock {
        return tc_node_contains_question_op(node_body(node))
    }
    if kind == NodeKind.Call {
        let args_sl = node_args(node)
        if args_sl != -1 {
            let mut i = 0
            while i < sublist_length(args_sl) {
                if tc_node_contains_question_op(sublist_get(args_sl, i)) != 0 { return 1 }
                i = i + 1
            }
        }
        return 0
    }
    if kind == NodeKind.MethodCall {
        if tc_node_contains_question_op(node_obj(node)) != 0 { return 1 }
        let args_sl = node_args(node)
        if args_sl != -1 {
            let mut i = 0
            while i < sublist_length(args_sl) {
                if tc_node_contains_question_op(sublist_get(args_sl, i)) != 0 { return 1 }
                i = i + 1
            }
        }
        return 0
    }
    if kind == NodeKind.MatchExpr {
        if tc_node_contains_question_op(node_scrutinee(node)) != 0 { return 1 }
        let arms_sl = node_arms(node)
        if arms_sl != -1 {
            let mut i = 0
            while i < sublist_length(arms_sl) {
                if tc_node_contains_question_op(node_body(sublist_get(arms_sl, i))) != 0 { return 1 }
                i = i + 1
            }
        }
        return 0
    }
    if kind == NodeKind.ListLit {
        let elems_sl = node_elements(node)
        if elems_sl == -1 { return 0 }
        let mut i = 0
        while i < sublist_length(elems_sl) {
            if tc_node_contains_question_op(sublist_get(elems_sl, i)) != 0 { return 1 }
            i = i + 1
        }
        return 0
    }
    if kind == NodeKind.TupleLit {
        let elems_sl = node_elements(node)
        if elems_sl == -1 { return 0 }
        let mut i = 0
        while i < sublist_length(elems_sl) {
            if tc_node_contains_question_op(sublist_get(elems_sl, i)) != 0 { return 1 }
            i = i + 1
        }
        return 0
    }
    if kind == NodeKind.StructLit {
        let flds_sl = node_fields(node)
        if flds_sl == -1 { return 0 }
        let mut i = 0
        while i < sublist_length(flds_sl) {
            if tc_node_contains_question_op(node_value(sublist_get(flds_sl, i))) != 0 { return 1 }
            i = i + 1
        }
        return 0
    }
    if kind == NodeKind.IndexExpr {
        if tc_node_contains_question_op(node_obj(node)) != 0 { return 1 }
        return tc_node_contains_question_op(node_index(node))
    }
    if kind == NodeKind.FieldAccess {
        return tc_node_contains_question_op(node_obj(node))
    }
    if kind == NodeKind.InterpString {
        let parts_sl = node_elements(node)
        if parts_sl == -1 { return 0 }
        let mut i = 0
        while i < sublist_length(parts_sl) {
            if tc_node_contains_question_op(sublist_get(parts_sl, i)) != 0 { return 1 }
            i = i + 1
        }
        return 0
    }
    0
}

// Two DIFFERENT questions used to share tc_in_test_body, and they want opposite answers inside
// a closure:
//
//   tc_in_test_body     "does `?` here elaborate against the test block's implicit
//                        Result[Void, TestError]?"  Inside a closure the answer is NO — a
//                        closure body gates `?` against its OWN declared return (spec §3c.2),
//                        so the closure walkers reset this to 0.
//
//   tc_in_test_lexical  "is this code lexically inside a `test { ... }` block?"  Inside a
//                        closure the answer is YES, and the test-only symbol fences (E0827
//                        skip, E0833 assert_panics) are the readers that mean this one. The
//                        closure walkers must NOT reset it.
//
// Both fence sites were reading the elaboration flag, so a `skip()` in a closure lexically
// inside a test was rejected the moment anything walked that closure body — reachable via the
// List-HOF path (`l.for_each(fn(x) { skip(...) })`) as well as via `testing.for_each`. Two
// places already documented the intended behavior against the code:
// tc_fence_test_only_symbol's comment ("and inside closures lexically within it —
// testing.for_each's case body relies on this") and the header of
// tests/test_e0833_assert_panics_outside_test.bl ("it IS allowed inside a closure that is
// lexically within a test body ... because tc_in_test_body stays set through such closures").
// It did not stay set; splitting the flag is what makes both statements true.
let mut tc_in_test_body: Int = 0
let mut tc_in_test_lexical: Int = 0
let mut tc_in_assert_panics: Int = 0

pub fn sanitize_test_name(name: Str) -> Str {
    let mut out = ""
    let mut i = 0
    while i < name.byte_len() {
        let ch = name.byte_at(i)
        if ch == 32 || ch == 95 {
            out = out.concat("_")
        } else if (ch >= 48 && ch <= 57) || (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) {
            out = out.concat(name.byte_slice(i, i + 1))
        }
        i = i + 1
    }
    out
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn tc_check_test_block(tb: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    // Reject surface annotation (E0515). Today the parser already rejects
    // '->' after a test header, but we re-check here so any future parser
    // recovery path still produces the typed error.
    let tann = node_type_ann(tb)
    if tann != -1 {
        diag_error_at("AnnotatedTestReturnTypeRejected", TEST_ANNOTATED_RETURN,
            "test blocks do not declare a return type",
            tb, "remove the `-> ...` annotation")
    }

    // test.failing(...) requires a non-empty reason: (E0835). int_val
    // is set to 1 by parse_test_failing_block as the "this is xfail" marker
    // (unused by plain `test { ... }`), so a registration with no reason is
    // still caught here instead of behaving like a plain test.
    if node_int_val(tb) != 0 {
        if node_xfail_reason(tb) == "" {
            diag_error_at("XfailMissingReason", XFAIL_MISSING_REASON,
                "test.failing requires a non-empty `reason:`",
                tb, "say why the test is expected to fail: reason: \"...\"")
        }
    }

    let tbody = node_body(tb)
    if tbody == -1 { return }

    let test_name = node_str_val(tb)
    let sanitized = sanitize_test_name(test_name)
    let prev_fn_name = tc_current_fn_name
    let prev_fn_ret = tc_current_fn_ret
    let prev_in_test = tc_in_test_body
    let prev_in_test_lex = tc_in_test_lexical
    tc_current_fn_name = "__test_{sanitized}"
    tc_in_test_body = 1
    tc_in_test_lexical = 1

    if tc_node_contains_question_op(tbody) != 0 {
        // Elaborate to Result[Void, TestError]. TestError must be visible
        // (lib/std/testing.bl is loaded transitively for any test build).
        let test_error_tid = resolve_type_name("TestError")
        let err_tid = if test_error_tid != -1 { test_error_tid } else { TYPE_UNKNOWN }
        tc_current_fn_ret = make_result_type(TYPE_VOID, err_tid)
    } else {
        tc_current_fn_ret = TYPE_VOID
    }

    let prev_boundary = tc_boundary_check_active
    tc_boundary_check_active = 1
    nr_push_scope()
    tc_check_body(tbody)
    tc_flush_deferred_conversions()
    nr_pop_scope()
    tc_boundary_check_active = prev_boundary

    tc_current_fn_name = prev_fn_name
    tc_current_fn_ret = prev_fn_ret
    tc_in_test_body = prev_in_test
    tc_in_test_lexical = prev_in_test_lex
}


// ── Phase 2: Top-level driver ───────────────────────────────────────

// Record a module-level let from one site: its tid on the `let` node, its bare name
// in the nr scope, and the module-qualified key (`m.x`) pointing back at that same
// node. One tid, one place — a qualified read resolves the node here and then reads
// the node's tid, so the two spellings cannot name different types. An UNKNOWN
// binding publishes no tid (tc_publish_node_tid declines it) but still needs both
// spellings registered so a body that reads it resolves.
fn tc_register_module_let_tid(l: Int, l_tid0: Int) {
    // A name its module declares twice (E1016) may be read as either declaration's value.
    let l_tid = if tc_value_decl_poisoned(l) { tc_error_recovery_tid() } else { l_tid0 }
    nr_define_typed(node_name(l), node_is_mut(l), l_tid, l)
    tc_publish_node_tid(l, l_tid)
    let l_mod_key = node_module(l)
    if l_mod_key != "" {
        tc_module_let_decl.insert("{l_mod_key}.{node_name(l)}", l)
    }
    tc_register_module_let_pattern(l, l_tid)
}

// The names a module-level `let` puts in scope. A destructuring form carries the
// parser's placeholder in the node name and its real binders in the pattern, so the
// node name alone would register a spelling no source can write and leave every leaf
// undefined.
fn tc_module_let_bound_names(l: Int) -> List[Str] {
    let leaves = tc_module_let_leaves(l)
    if leaves.len() == 0 { return [node_name(l)] }
    let mut out: List[Str] = []
    for leaf in leaves { out.push(node_name(leaf)) }
    out
}

// The pattern leaves a destructuring module-level `let` binds, left to right; none for any
// other `let`.
fn tc_module_let_leaves(l: Int) -> List[Int] {
    let mut out: List[Int] = []
    let pat_sl = node_elements(l)
    if pat_sl == -1 { return out }
    let elems_sl = node_elements(pat_sl)
    if elems_sl == -1 { return out }
    let mut i = 0
    while i < sublist_length(elems_sl) {
        out.push(sublist_get(elems_sl, i))
        i = i + 1
    }
    out
}

// A destructuring module-level `let` binds its leaves, not the node's own name. The
// node name is the pattern's internal placeholder, so without this the leaves are the
// only spelling a body can use and none of them is in scope — every use reads as an
// undefined variable. Decomposition matches the fn-body arm: a leaf past the tuple's
// arity stays unknown rather than borrowing a neighbour's type.
fn tc_register_module_let_pattern(l: Int, l_tid: Int) {
    let pat_sl = node_elements(l)
    if pat_sl == -1 { return }
    let elems_sl = node_elements(pat_sl)
    if elems_sl == -1 { return }
    let l_mod_key = node_module(l)
    let tup = tc_tid_resolved(l_tid)
    let mut arity = -1
    if tc_tid_kind(tup) == TyKind.Tuple { arity = tc_tid_child_count(tup) }
    let mut i = 0
    while i < sublist_length(elems_sl) {
        let leaf = sublist_get(elems_sl, i)
        let mut leaf_tid = TYPE_UNKNOWN
        if i < arity && !nr_poisoned(l_mod_key, "value", node_name(leaf)) {
            leaf_tid = tc_tid_child(tup, i)
            if leaf_tid < 0 { leaf_tid = TYPE_UNKNOWN }
        }
        nr_define_typed(node_name(leaf), tc_leaf_is_mut(leaf), leaf_tid, leaf)
        tc_publish_node_tid(leaf, leaf_tid)
        if l_mod_key != "" {
            tc_module_let_decl.insert("{l_mod_key}.{node_name(leaf)}", leaf)
        }
        i = i + 1
    }
}

// Types an ANNOTATED module-level global's initializer for its node tids alone.
//
// The first pass already registered the declared type on the binding, so this walk decides
// nothing about the binding. It runs so every expression node INSIDE the initializer gets a
// tid, as an unannotated global's initializer does and as any `let` in a fn body does. Without
// it, an annotation removed the initializer's types and codegen had nothing to read for
// `[1, 2]` in `let xs: List[Int] = [1, 2]`.
//
// The read REPORTS. A module-level binding is typechecked at its own site, exactly as a `let`
// in a fn body is, so a declared type its initializer contradicts is an error here and not a
// question deferred to codegen.
//
// The declared type drives the walk — construct hint, closure expected fn type, and the metavar
// pin — so `let m: Map[Str, Int] = Map()` records `Map[Str, Int]` on the ctor and not `Map[?, ?]`.
fn tc_stamp_annotated_global_init(l: Int, l_val: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let declared = tc_lookup_node_tid(l)
    tc_seed_expected_into_value(l_val, declared)
    let hint = if tc_tid_is_no_info(declared) == 0 { resolve_alias_tid(declared) } else { tc_construct_hint }
    let v_tid = tc_infer_walked_let_value(l_val, node_name(l), hint)
    if tc_tid_is_no_info(declared) == 0 && tc_tid_is_no_info(v_tid) == 0 {
        // Behind the compare, for the reason the LetBinding arm gives at its own pin: a pin
        // ahead of the compare can turn a mismatch into a silent success.
        if assignment_types_compatible(declared, v_tid, l_val) == 0 {
            if !tc_closure_checked_against(l_val, declared) {
                let (declared_s, got_s) = tc_type_pair_strs(declared, v_tid)
                tc_report_declared_mismatch("variable `{node_name(l)}`: declared type {declared_s} but got {got_s}{tc_fn_mismatch_suffix(declared, v_tid)}", l, l_val, declared, v_tid)
            }
        } else {
            tc_pin_declared_into_value(declared, l_val, v_tid)
        }
    }
}

// Second pass over every global's initializer, in source order. The first pass registered the
// BINDINGS and typed only an unannotated bare-scalar-literal initializer, so every other global
// arrives here with its initializer expressions unvisited.
//
// An ANNOTATED global keeps the declared type it already carries; the walk serves only the node
// tids inside the initializer — tc_stamp_annotated_global_init.
//
// An UNANNOTATED non-literal global stayed UNKNOWN because a call/ident/variant initializer can
// name a function or an earlier global, and the first pass had registered neither. Both are
// registered now, so infer again: a later global that reads an earlier one (`let b = a`) sees a's
// fresh tid, and codegen spells the declaration from it and not from its flat arm.
//
// infer_type both REPORTS and mints metavars. The report stands: a module-level initializer is
// checked at its own site, as a fn-body `let` is. The binding takes the tid only when the read
// was clean AND fully ground; an open tid (`[]` -> List[α]) or a read that errored leaves it
// UNKNOWN, so this pass only turns UNKNOWN into a concrete tid.
//
// A clean but still-open tid is the module-scope form of the region-boundary under-determined
// case (nr_pop_scope): a top-level binding takes its type at its own site from its RHS and
// annotation ALONE, so an empty `[]`/`None`/`Map()` that nothing here pins is
// under-determined -> error[CannotInferType] (E0301). A later cross-scope use (`ch.send(1)` in a
// fn or test body) is the remote effect the panel rejected, so it cannot supply the type; leaving
// the binding UNKNOWN would let codegen invent an arbitrary flat carrier — the forbidden "third
// default state" (decisions/under-determined-types.md; §3.4).
fn tc_infer_global_initializers(lets_sl: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let mut i = 0
    while i < sublist_length(lets_sl) {
        let l = sublist_get(lets_sl, i)
        // Here and not in the first pass: the first pass has not registered the function
        // names yet, so a name this check asks about could not be told apart from an
        // undefined one.
        tc_check_const_decl(l)
        let l_val = node_value(l)
        if l_val != -1 {
            if node_target(l) != -1 || node_type_name(l) != "" {
                nr_current_module = node_module(l)
                tc_stamp_annotated_global_init(l, l_val)
            } else {
                let vk = node_kind(l_val)
                if vk != NodeKind.IntLit && vk != NodeKind.FloatLit && vk != NodeKind.BoolLit {
                    nr_current_module = node_module(l)
                    let saved = diag_entry_count()
                    let l_tid = tc_infer_walked_let_value(l_val, node_name(l), tc_construct_hint)
                    let clean = diag_any_errors_since(saved) == 0
                    if clean && tc_tid_is_no_info(l_tid) == 0 {
                        if tc_tid_has_unbound_metavar(l_tid) != 0 {
                            tc_ud_judge_binder(node_name(l), l_tid, l)
                        } else {
                            tc_register_module_let_tid(l, l_tid)
                        }
                    }
                }
            }
        }
        i = i + 1
    }
}

fn tc_infer_program(program: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    nr_scope_names = []
    nr_scope_muts = []
    nr_scope_types = []
    nr_scope_reads = []
    nr_scope_writes = []
    nr_scope_nodes = []
    nr_scope_captured = []
    nr_scope_prev = []
    nr_name_top.clear()
    nr_scope_frames = []
    nr_scope_depth = 0
    nr_loop_depth = 0
    nr_push_scope()
    tc_infer_program_with_boundary_check(program)
}

// Each trait method's defaults against the signature a call through a bound reads. A method
// with a default body has its const rules read by tc_check_fn, which checks that body with no
// signature and so leaves the types to this.
fn tc_check_trait_method_defaults(trait_name: Str, tmethods_sl: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let mut i = 0
    while i < sublist_length(tmethods_sl) {
        let m = sublist_get(tmethods_sl, i)
        if node_body(m) == -1 { tc_check_param_defaults(m) }
        let mut si = 0
        while si < tc_tmsig_pool.len() {
            let tm = tc_tmsig_pool.get(si).unwrap()
            if fnsig_pool.get(tm.sig).unwrap().decl == m {
                tc_check_param_default_types("{trait_name}.{node_name(m)}", m, tm.sig)
                break
            }
            si = si + 1
        }
        i = i + 1
    }
}

fn tc_check_trait_default_bodies(tmethods_sl: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let prev_walk_ret = tc_current_fn_ret
    tc_check_each_trait_default_body(tmethods_sl)
    tc_current_fn_ret = prev_walk_ret
}

fn tc_check_each_trait_default_body(tmethods_sl: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let mut mj = 0
    while mj < sublist_length(tmethods_sl) {
        let dm = sublist_get(tmethods_sl, mj)
        if node_body(dm) != -1 {
            // sig == -1 leaves tc_check_fn's declared-return install un-run, so
            // set it here (Self resolves to the abstract self typevar) — an
            // explicit `return expr` in the body is checked against it.
            let dm_ann = node_type_ann(dm)
            tc_current_fn_ret = if dm_ann == -1 { TYPE_VOID } else { resolve_type_ann(dm_ann) }
            tc_check_fn(dm)
        }
        mj = mj + 1
    }
}

// The E0301 region-boundary check is on for the WHOLE inference pass, not just
// inside tc_check_fn/tc_check_test_block. Turning it on here makes the check
// unconditional at module scope: the module-scope nr_pop_scope in the pass runs it for
// every top-level binder that still holds a metavar in scope, so no future
// module-scope binder class can silently escape it the way the inline top-level
// report (the second-pass under-determined check) covers only unannotated lets.
// tc_check_fn/tc_check_test_block still save/restore around their own regions, so
// this only widens the region — it does not change their behaviour, and the
// module-scope pop is independent of the --incremental fn filter (fn bodies it
// skips report at their own site, not here). Reset to 0 by init_types before every
// run; restored at the end for symmetry.
fn tc_infer_program_with_boundary_check(program: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let prev_boundary = tc_boundary_check_active
    tc_boundary_check_active = 1
    tc_infer_program_body(program)
    tc_boundary_check_active = prev_boundary
}

fn tc_infer_program_body(program: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    // Register top-level let bindings WITH their declared types so fn bodies that
    // reference a module-global see its real type. Annotated type is resolved
    // directly (never forward-references other globals, so order-independent).
    // For unannotated globals we infer ONLY a scalar-literal RHS (also order-safe);
    // a non-literal RHS could forward-reference and stays UNKNOWN (same as before).
    // We deliberately do NOT run assignment_types_compatible here (RHS is validated
    // elsewhere; adding validation at this site risks the self-hosting bootstrap).
    let lets_sl = node_stmts(program)
    if lets_sl != -1 {
        let mut i = 0
        while i < sublist_length(lets_sl) {
            let l = sublist_get(lets_sl, i)
            let l_ann = node_target(l)
            let l_type_str = node_type_name(l)
            // An annotation is a type reference wherever it is written, so a global's
            // annotation answers to the same resolution a fn-body let's does. Without this
            // a name no type owns resolves to UNKNOWN in silence and reaches codegen.
            nr_current_module = node_module(l)
            if l_ann != -1 {
                nr_check_type_ann_visibility(l_ann)
            } else if l_type_str != "" {
                nr_check_type_ref(l_type_str, l)
            }
            let mut l_tid = TYPE_UNKNOWN
            if l_ann != -1 {
                l_tid = resolve_type_ann(l_ann)
            } else if l_type_str != "" {
                let rt = resolve_type_name(l_type_str)
                if rt != -1 { l_tid = rt }
            } else {
                let l_val = node_value(l)
                if l_val != -1 {
                    let vk = node_kind(l_val)
                    if vk == NodeKind.IntLit || vk == NodeKind.FloatLit || vk == NodeKind.BoolLit || vk == NodeKind.InterpString {
                        l_tid = infer_type(l_val)
                    }
                }
            }
            tc_register_module_let_tid(l, l_tid)
            i = i + 1
        }
    }

    // Register function names
    let fns_sl = node_params(program)
    if fns_sl != -1 {
        let mut i = 0
        while i < sublist_length(fns_sl) {
            nr_define(node_name(sublist_get(fns_sl, i)))
            i = i + 1
        }
    }

    // This pass walks every module-global initializer, once the globals and the function
    // names are both registered — see tc_infer_global_initializers.
    if lets_sl != -1 {
        tc_infer_global_initializers(lets_sl)
    }

    // Type check each function body (skip unaffected when incremental filter active)
    if fns_sl != -1 {
        let mut i = 0
        while i < sublist_length(fns_sl) {
            let fn_node = sublist_get(fns_sl, i)
            nr_current_module = node_module(fn_node)
            if tc_should_check_fn(node_name(fn_node)) != 0 {
                tc_check_fn(fn_node)
            }
            i = i + 1
        }
    }

    // Type check impl methods (skip unaffected when incremental filter active)
    let impls_sl = node_methods(program)
    if impls_sl != -1 {
        let mut i = 0
        while i < sublist_length(impls_sl) {
            let im = sublist_get(impls_sl, i)
            nr_current_module = node_module(im)
            let impl_type = tc_impl_target_name(im)
            // The binders are in scope for the span of the method bodies. The receiver
            // itself was recorded under the same scope when the header was checked, so a
            // receiver arg that shadows a builtin (`impl[Map] Sz for List[Map]`) already
            // reads as the type variable, not the constructor (§3.4:1259).
            let impl_binders_sl = node_impl_binders(im)
            tc_push_tparam_scope(impl_binders_sl)
            // The binders (`[T]`) carry no bounds; an impl's arithmetic bounds live
            // in its `where` clause (`impl[T] .. where T: Add`), so license those
            // for the span of the method bodies. Pushed after the binder frames so
            // the bounded `where T` frame shadows the unbounded binder `T` frame.
            let impl_where_sl = node_impl_where_bounds(im)
            tc_push_where_frames(impl_where_sl)
            tc_current_self_tid = tc_impl_recv_tid(im)
            let methods_sl = node_methods(im)
            if methods_sl != -1 {
                let mut j = 0
                while j < sublist_length(methods_sl) {
                    let m = sublist_get(methods_sl, j)
                    let orig_name = node_name(m)
                    let qualified = "{impl_type}_{orig_name}"
                    if tc_should_check_fn(qualified) != 0 {
                        // Same spelling the registration loop (:5183) wrote, so tc_check_fn can
                        // find the signature and install the declared return.
                        tc_current_method_sig_key = tc_mangle_impl_fnsig(impl_type, tc_impl_trait_id(im), orig_name, im)
                        node_set_name(m, qualified)
                        tc_check_fn(m)
                        node_set_name(m, orig_name)
                        tc_current_method_sig_key = ""
                    }
                    j = j + 1
                }
            }
            tc_pop_arith_frames(impl_where_sl)
            tc_pop_tparam_scope(impl_binders_sl)
            tc_current_self_tid = -1
            i = i + 1
        }
    }

    // Type check trait DEFAULT method bodies against an abstract, guarantee-set-bounded
    // `Self` (E0305). A default body belongs to no impl, so the impl loop above never
    // reaches it — this is the only place `self + self` / `self < other` / `self.foo()`
    // on the abstract `Self` is checked, closing the hole where such a body slipped past
    // the typechecker and died at the C compiler.
    let traits_walk_sl = node_arms(program)
    if traits_walk_sl != -1 {
        let self_tv = make_typevar_bound("Self", SELF_BINDER_NODE)
        let mut wi = 0
        while wi < sublist_length(traits_walk_sl) {
            let trn = sublist_get(traits_walk_sl, wi)
            let tmethods_sl = node_methods(trn)
            if tmethods_sl != -1 {
                nr_current_module = node_module(trn)
                tc_current_self_trait = node_name(trn)
                tc_push_self_frame(trn)
                tc_push_tparam_scope(node_type_params(trn))
                tc_current_self_tid = self_tv
                // A default body's signature is in tc_tmsig_pool, not fnsig_pool: a
                // sentinel key that misses leaves sig == -1 in tc_check_fn, so the
                // missing-tail check (gated on sig != -1) does not run against the abstract
                // `Self`. Only the operator / method licensing is wanted here.
                tc_current_method_sig_key = "__trait_default_no_sig__"
                tc_check_trait_method_defaults(node_name(trn), tmethods_sl)
                tc_check_trait_default_bodies(tmethods_sl)
                tc_current_method_sig_key = ""
                tc_current_self_tid = -1
                tc_pop_tparam_scope(node_type_params(trn))
                tc_pop_self_frame()
                tc_current_self_trait = ""
            }
            wi = wi + 1
        }
    }

    for op in effect_derived_ops(program) {
        nr_current_module = tc_body_module(op)
        tc_check_derived_op(op)
    }

    // Type check test block bodies under elaborated return type
    let tests_sl = node_captures(program)
    if tests_sl != -1 {
        nr_current_module = "__main__"
        let mut i = 0
        while i < sublist_length(tests_sl) {
            tc_check_test_block(sublist_get(tests_sl, i))
            i = i + 1
        }
    }

    tc_check_effect_rows(program)
    nr_pop_scope()
    // Last: every constraining use in the program has now run, so a deferred alias blame
    // whose metavar is still unbound is genuinely under-determined. A deferred conversion
    // no definition chose (a module-scope one has no definition) is chosen first, since the
    // impl it chooses can settle what the others judge, and refused last, so a binding or call
    // that names the open type answers for it.
    tc_flush_deferred_conversions()
    tc_ud_flush_pending()
    tc_ud_flush_calls()
    tc_refuse_deferred_conversions()
    tc_drop_open_calls()
    tc_flush_untyped_type_args()
}

// ── Debug / introspection ───────────────────────────────────────────

// The one export of type_to_str. Codegen's own lens (type_name_from_ct) is a total
// function over the CTs it enumerates and answers "Void" for everything else, so a
// diagnostic spelled from it makes a confident wrong claim about any type codegen cannot
// name — Void being a real surface type, not a visible unknown. Consumers must treat
// the "<?>" render as "no usable tid here" and keep their own fallback; it is not a
// type name.
pub fn tc_type_str(tid: Int) -> Str {
    type_to_str(tid)
}

fn type_to_str(tid0: Int) -> Str {
    // A bound metavar renders as its solution; an unbound α still renders as
    // the internal "?" placeholder (never a surface type name).
    let tid = tc_resolve(tid0)
    if tid < 0 || tid >= ty_pool.len() {
        return "<?>"
    }
    let t = ty_pool.get(tid).unwrap()
    let k = t.kind
    let name = t.name

    // Dispatch is a match, not an if-chain, so the surface rendering of a kind can
    // never be decided by fall-through. The five arms that answer `name` do so
    // deliberately; four of them (Closure/Iterator/Handle/Channel) are also
    // UNCONSTRUCTIBLE — new_type is never called with them — so they are named
    // here to record that, not because the rendering was chosen.
    match k {
        TyKind.Int => return "Int"
        TyKind.Float => return "Float"
        TyKind.Bool => return "Bool"
        TyKind.Str => return "Str"
        // The unit type is written `()`; `Void` is only the pointee marker the Ptr arm keeps.
        TyKind.Void => return "()"
        TyKind.Never => return "Never"
        TyKind.Char => return name
        TyKind.I8 => return "I8"
        TyKind.I16 => return "I16"
        TyKind.I32 => return "I32"
        TyKind.U8 => return "U8"
        TyKind.U16 => return "U16"
        TyKind.U32 => return "U32"
        TyKind.U64 => return "U64"
        TyKind.Bytes => return "Bytes"
        TyKind.StringBuilder => return "StringBuilder"
        TyKind.Unknown => return "?"
        TyKind.Typevar => return name
        // Channel/Handle/Iterator are constructed, so they render their inner rather than the
        // bare name. The bare name is what made NotIterable read "cannot iterate over
        // type 'Channel' -- only ... Channel ... implement iteration": one line contradicting
        // itself.
        TyKind.Iterator => return "Iterator[{type_to_str(t.inner1)}]"
        TyKind.Handle => return "Handle[{type_to_str(t.inner1)}]"
        // The effect lives in the name slot, not in a child (make_handler_type), so this renders
        // it directly instead of recursing. `Handler[IO]`, `Handler[IO.Print]`, `Handler[Metrics]`
        // — the spelling a user wrote, which is what a diagnostic has to say back to them.
        TyKind.Handler => return "Handler[{name}]"
        TyKind.Channel => return "Channel[{type_to_str(t.inner1)}]"
        TyKind.Ptr => {
            if type_kind(tc_resolve(t.inner1)) == TyKind.Void { return "Ptr[Void]" }
            return "Ptr[{type_to_str(t.inner1)}]"
        }
        TyKind.Template => return "Template[{type_to_str(t.inner1)}]"
        TyKind.Raw => return "Raw[{type_to_str(t.inner1)}]"
        // The surface spelling of the type is the expression that makes one: §07:272 has no
        // type name for it, and `ffi.scope()` is the only way to obtain one.
        TyKind.FfiScope => return "FfiScope"
        TyKind.List => return "List[{type_to_str(t.inner1)}]"
        TyKind.Option => return "Option[{type_to_str(t.inner1)}]"
        TyKind.Result => return "Result[{type_to_str(t.inner1)}, {type_to_str(t.inner2)}]"
        TyKind.Map => return "Map[{type_to_str(t.inner1)}, {type_to_str(t.inner2)}]"
        TyKind.Set => return "Set[{type_to_str(t.inner1)}]"
        TyKind.Struct => {}
        TyKind.Enum => {}
        TyKind.Fn => {}
        TyKind.Tuple => {}
    }

    if k == TyKind.Struct || k == TyKind.Enum {
        // Monomorphized struct or enum instance (Box[Int], ZzTree[Int]): render its concrete
        // type-args so diagnostics read "expects Box[Int], got Box[Str]" instead of an
        // ambiguous bare "Box" on both sides. One rule for both kinds, because a
        // monomorphized enum instance is a distinct type per argument exactly as a struct
        // instance is, and rendered bare a mismatch between two of them said nothing at all.
        // A bare generic declaration (params_count 0) renders as the plain name.
        if t.params_count > 0 {
            let start = t.params_start
            let count = t.params_count
            let mut targs = ""
            let mut i = 0
            while i < count {
                if i > 0 {
                    targs = targs.concat(", ")
                }
                targs = targs.concat(type_to_str(ty_param_list.get(start + i).unwrap()))
                i = i + 1
            }
            return "{strip_module_qualifier(name)}[{targs}]"
        }
        return name
    }
    if k == TyKind.Fn {
        let start = t.params_start
        let count = t.params_count
        let mut params = ""
        let mut i = 0
        while i < count {
            if i > 0 {
                params = params.concat(", ")
            }
            params = params.concat(type_to_str(ty_param_list.get(start + i).unwrap()))
            i = i + 1
        }
        return "Fn({params}) -> {type_to_str(t.inner1)}"
    }
    if k == TyKind.Tuple {
        let start = t.params_start
        let count = t.params_count
        let mut elems = ""
        let mut i = 0
        while i < count {
            if i > 0 {
                elems = elems.concat(", ")
            }
            elems = elems.concat(type_to_str(ty_param_list.get(start + i).unwrap()))
            i = i + 1
        }
        return "({elems})"
    }

    name
}

// Tag position: TOP is tc_tid_to_c_tag's own call (Pascal scalars, module-qualifier
// stripped, List/Set/Map/Bytes erased to their bare carrier). INNER is every recursion
// into a compound's element (Option_<inner>, Result_<ok>_<err>, Map_<k>_<v>,
// Tuple<n>_<...>): lowercase scalars, module prefix KEPT via c_type_tag_for_struct, Map
// spelled structurally. This asymmetry is a property of the emitted C names, not
// accidental duplication — so it is a position PARAMETER on one encoder, never a shared rule.
pub let TAGPOS_TOP = 0
pub let TAGPOS_INNER = 1

// The two SYMBOL positions are the ones a C FUNCTION name is built at. A C type
// deliberately loses information: one blink_map* serves every key and value, so TOP and
// INNER both drop them. A C symbol cannot afford that loss, because the symbol IS the
// definition: two instances that spell one name are one function defined twice, and the
// unit stops compiling. scalar_top already refuses a Fn at TOP for exactly this reason --
// dropping the signature "would merge two instances into one symbol" -- and an erased
// container drops its elements the same way.
//
// So a position answers two questions, not one: how deep the segment sits, and whether an
// erased container spells its elements there. The first two positions answer the width
// question with "no" and differ only in depth; these two answer it with "yes" and differ
// in exactly the same way. SYMBOL mirrors TOP and SYMBOL_INNER mirrors INNER, so every
// name that exists today is spelled as it is today, and the only thing these add is the
// element the C type had no room for.
pub let TAGPOS_SYMBOL = 2
pub let TAGPOS_SYMBOL_INNER = 3

// One encoder for both tid-to-C-tag positions. tc_tid_to_c_tag and
// tc_tid_inner_tag are thin `tagpos`-fixed wrappers below, so no call site moves and every
// existing byte-for-byte contract (scalar casing, struct/enum module-qualifier handling,
// compound erasure vs structural spelling, the three ICE_SEG_* sentinels) is preserved
// exactly, not re-derived.
pub fn tc_tid_resolved(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    tc_resolve(tid)
}

// ── Structural accessors ────────────────────────────────────────────────────
//
// The four functions that subsume the 51-accessor cartesian product below
// ({list_elem, set_elem, map_key, map_val, option_inner, result_ok, result_err,
// struct_arg, tuple_elem} x {_ct, _struct, _tid} x {plain, _resolved}). That product
// exists for ONE reason: codegen could not hold a tid, so each child had to be
// pre-flattened into a (C-type code, struct name) pair at this boundary. A pair spans
// depth 1, which is why every nesting deeper than that needed its own bespoke channel.
// tc_tid_child answers a *tid*, so it composes with itself and depth stops mattering.
//
// RAW, all four: they read the pool slot as stored. A caller that wants a bound metavar
// followed composes tc_tid_resolved FIRST. This is deliberate and not an oversight — a
// raw/resolved asymmetry between two readers of one tid is a documented cause of past
// capture holes, and resolving the kind while reading children raw would report
// TyKind.Map while answering -1 for both children. Note the resulting split with
// type_kind above, which DOES resolve: type_kind is typecheck's semantic question ("what
// is this type"), tc_tid_kind is the structural one ("what is in this slot").
//
// Every compound constructor's answer through these four is checked in
// tests/test_typecheck_tid_structural_accessors.bl.
pub fn tc_tid_kind(tid: Int) -> TyKind {
    if tid < 0 || tid >= ty_pool.len() { return TyKind.Unknown }
    ty_pool.get(tid).unwrap().kind
}

// Arity is KIND-determined, never slot-determined. A List whose element slot holds -1
// still has ONE child, answered as -1 — that is what lets a caller tell "this kind has
// no child" from "this child is erased". Collapsing those two is exactly the
// Void-vs-erasure conflation tests/test_hsgsbp_void_vs_erasure.bl guards, and deriving
// the count from `inner1 != -1` would reintroduce it here.
pub fn tc_tid_child_count(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return 0 }
    let t = ty_pool.get(tid).unwrap()
    match t.kind {
        TyKind.List => 1
        TyKind.Option => 1
        TyKind.Set => 1
        TyKind.Result => 2
        TyKind.Map => 2
        // inner1 is the return type and the params follow it, so 1 + params_count.
        TyKind.Fn => 1 + t.params_count
        // Variadic: arity IS params_count, so a generic base (Box) reports 0 and an
        // instance (Box[Int]) reports 1 — a distinction callers depend on.
        TyKind.Tuple => t.params_count
        TyKind.Struct => t.params_count
        TyKind.Enum => t.params_count
        // Leaves. Named individually rather than defaulted so that adding a kind with
        // children fails to compile here instead of silently reporting 0 — which would
        // present as "the type has no element" at every call site at once.
        TyKind.Int => 0
        TyKind.Float => 0
        TyKind.Bool => 0
        TyKind.Str => 0
        TyKind.Void => 0
        TyKind.Bytes => 0
        TyKind.StringBuilder => 0
        TyKind.Typevar => 0
        TyKind.Unknown => 0
        // Channel/Handle/Iterator carry one inner each (element / result / element). Iterator is
        // the sealed opaque carrier of §3c.1:38, produced only by `.into_iter()` and the lazy
        // iterator-receiver adapters; its element is inner1, read below.
        TyKind.Iterator => 1
        TyKind.Handle => 1
        TyKind.Channel => 1
        // The pointee. `Ptr[Void]` and `Ptr[Ptr[T]]` are both spec-legal pointees
        // (sections/07_trust_modules_metadata.md:193,:197), so this child is a real recursion
        // point, not a formality.
        TyKind.Ptr => 1
        // The phantom context. Carried, not checked — see make_template_type.
        TyKind.Template => 1
        // The wrapped type. A `Raw[T]` is not a `T`, but it is made of one.
        TyKind.Raw => 1
        // A handler's EFFECT is not a type, so it is not a child: it lives in the entry's name
        // slot (make_handler_type) and is read back with tc_tid_handler_effect. This
        // is the one kind whose parameter is deliberately NOT a tid, which is exactly why the
        // count is 0 and not "1 that is always -1" — there is no type down there to erase.
        TyKind.Handler => 0
        TyKind.FfiScope => 0
        TyKind.I8 => 0
        TyKind.I16 => 0
        TyKind.I32 => 0
        TyKind.U8 => 0
        TyKind.U16 => 0
        TyKind.U32 => 0
        TyKind.U64 => 0
        TyKind.Char => 0
        // The bottom type has no values, so it has nothing under it either.
        TyKind.Never => 0
    }
}

// Child `i` as a TID, uniformly across all three storage forms (inner1, inner2, and the
// ty_param_list slice). -1 for out of range, and -1 is also the honest answer for a slot
// whose child is genuinely absent.
//
// Answering -1 rather than a plausible default is the entire point. sv_tp
// (codegen_types.bl) responds to a missing slot by INVENTING one —
// `return type_list(type_int())` — and every "erases the element to Int" / "fabricated as
// string default" ticket in the backlog is that invention observed downstream. Do not
// add a fallback here, and do not clamp `i` to the last real child: a clamp duplicates a
// type into a slot that has none and reads as success.
pub fn tc_tid_child(tid: Int, i: Int) -> Int {
    if i < 0 { return -1 }
    if i >= tc_tid_child_count(tid) { return -1 }
    let t = ty_pool.get(tid).unwrap()
    match t.kind {
        TyKind.List => t.inner1
        TyKind.Option => t.inner1
        TyKind.Set => t.inner1
        TyKind.Result => if i == 0 { t.inner1 } else { t.inner2 }
        TyKind.Map => if i == 0 { t.inner1 } else { t.inner2 }
        // Return-first, then params. Pinned by test rather than convention: nothing else
        // in the tree mixes a scalar slot with the variadic slice, so a silent reordering
        // would stay invisible until a signature came out backwards.
        TyKind.Fn => if i == 0 { t.inner1 } else { ty_param_at(t, i - 1) }
        TyKind.Tuple => ty_param_at(t, i)
        TyKind.Struct => ty_param_at(t, i)
        TyKind.Enum => ty_param_at(t, i)
        // Unreachable: child_count answered 0 for every kind below, so the bound check
        // above already returned. Enumerated anyway so this match stays total and a kind
        // that GAINS children cannot slip through with a silent -1.
        TyKind.Int => -1
        TyKind.Float => -1
        TyKind.Bool => -1
        TyKind.Str => -1
        TyKind.Void => -1
        TyKind.Bytes => -1
        TyKind.StringBuilder => -1
        TyKind.Typevar => -1
        TyKind.Unknown => -1
        TyKind.Iterator => if i == 0 { t.inner1 } else { -1 }
        TyKind.Handle => if i == 0 { t.inner1 } else { -1 }
        TyKind.Channel => if i == 0 { t.inner1 } else { -1 }
        TyKind.Ptr => if i == 0 { t.inner1 } else { -1 }
        TyKind.Template => if i == 0 { t.inner1 } else { -1 }
        TyKind.Raw => if i == 0 { t.inner1 } else { -1 }
        // Unreachable, like the leaves above: child_count is 0 because the effect is a NAME,
        // not a tid.
        TyKind.Handler => -1
        TyKind.FfiScope => -1
        TyKind.I8 => -1
        TyKind.I16 => -1
        TyKind.I32 => -1
        TyKind.U8 => -1
        TyKind.U16 => -1
        TyKind.U32 => -1
        TyKind.U64 => -1
        TyKind.Char => -1
        TyKind.Never => -1
    }
}

// Bounds-checked read of the variadic slice. A params_start/params_count pair pointing
// outside ty_param_list is a pool-invariant violation; answer -1 rather than panicking,
// consistent with every other sentinel on this boundary.
fn ty_param_at(t: TypePoolEntry, i: Int) -> Int {
    if t.params_start < 0 { return -1 }
    if i < 0 || i >= t.params_count { return -1 }
    let idx = t.params_start + i
    if idx >= ty_param_list.len() { return -1 }
    ty_param_list.get(idx) ?? -1
}

// The RAW declared name: a struct/enum instance answers its generic base unadorned
// (`Box`, not `Box_Int`) and a container answers its kind's own name. Mono spelling is a
// separate concern and must not leak in here — tc_tid_struct_mono_name owns that.
// Unlike tc_tid_struct below, this does not strip the module qualifier and does not
// restrict to Struct/Enum, because a caller walking a tree needs a name for whatever it
// lands on.
// The base name a monomorphized instance of `base_tid` carries: the pool name of the
// base itself, so a namesake declared by two modules keeps its module on every instance.
fn tc_instance_base_name(base_tid: Int) -> Str {
    tc_tid_name(tc_resolve(base_tid))
}

pub fn tc_tid_name(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    ty_pool.get(tid).unwrap().name
}

pub fn tc_tid_struct(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind == TyKind.Struct || t.kind == TyKind.Enum { return strip_module_qualifier(t.name) }
    ""
}

// What a `for` loop binds when it iterates `iter_t` — the one definition of an iterable's
// element type, read by BOTH typecheck's ForIn arm (which names the loop variable) and
// codegen's emit_for_in (which stamps that variable's ScopeVar and measures it). Two copies
// of this answer is how the pair-position element got lost in the first place: typecheck knew
// only List and Set, so a Map's element had to be reconstructed per codegen route.
//
// TYPE_UNKNOWN means "no element is published for this kind yet", which is a different claim
// from "not iterable" — Range is a spec-legal iterable (sections/03c_protocols.md's
// IntoIterator table) whose element this does not answer, and the ForIn arm's
// deferred-iterable list is what keeps it from being diagnosed. A caller that
// stamps a ScopeVar must therefore gate on a KNOWN element and leave the slot unstamped
// otherwise: stamping TYPE_UNKNOWN would make the divergence counter report a cell where the
// flat field is in fact right and only the tid is absent.
pub fn tc_tid_iter_elem(iter_t: Int) -> Int {
    let tk = type_kind(iter_t)
    if tk == TyKind.List || tk == TyKind.Set || tk == TyKind.Iterator { return ty_pool.get(iter_t).unwrap().inner1 }
    if tk == TyKind.Map {
        // A Map's iteration element is the (K, V) pair. make_tuple_type interns, so this is the
        // same tid the pair tuple already has everywhere else — including at codegen, where the
        // pool outlives checking.
        let mt = ty_pool.get(iter_t).unwrap()
        return make_tuple_type([mt.inner1, mt.inner2])
    }
    // The three remaining iterables the front end admits. A Channel drains its own element;
    // Bytes yields U8 and Str yields Char, one per Unicode scalar value (sections/03_types.md,
    // sections/03c_protocols.md's IntoIterator table).
    if tk == TyKind.Channel { return ty_pool.get(iter_t).unwrap().inner1 }
    if tk == TyKind.Str { return TYPE_CHAR }
    if tk == TyKind.Bytes { return TYPE_U8 }
    TYPE_UNKNOWN
}

// Whether `tid` is a TyKind.Enum (bare or instance). Lets codegen distinguish a
// generic-enum instance slot from a struct instance slot when both funnel through
// the kind-agnostic tc_tid_struct/tc_tid_struct_arg_* accessors.
pub fn tc_tid_is_enum(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return 0 }
    if ty_pool.get(tid).unwrap().kind == TyKind.Enum { return 1 }
    0
}

// ── Channel element type, for codegen's three consumption seams ──────────────────────
//
// `send`, `recv` and the `for v in ch` drain read the element type from the channel's tid.
// A prior flat ScopeVar field held it too, but that field was a fabrication — the let-binding
// stamped it from the initializer's emitted C expression looked up as a variable name, which
// never hits — so the tid is the sole authority and these two answer from it.
//
// The pair (ct, struct name) rather than a tid is codegen's own language at this boundary;
// see the note on tc_tid_child above for why that pair is the thing being retired. Once
// Stage 3's recursive c_type_from_tid lands, both of these collapse into it.
pub fn tc_tid_struct_arg_count(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return 0 }
    let t = ty_pool.get(tid).unwrap()
    // TyKind.Enum admitted so a generic-enum INSTANCE (`Tree[Int]`) surfaces its arg
    // count to the codegen mono-name path, mirroring struct instances.
    if t.kind != TyKind.Struct && t.kind != TyKind.Enum { return 0 }
    t.params_count
}

pub fn tc_tid_struct_arg_tid(tid: Int, idx: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    // TyKind.Enum admitted so a generic-enum INSTANCE (`Tree[Int]`) surfaces its per-slot
    // arg tids to the codegen mono-name / instance-registration path.
    if t.kind != TyKind.Struct && t.kind != TyKind.Enum { return -1 }
    if idx < 0 || idx >= t.params_count { return -1 }
    ty_param_list.get(t.params_start + idx).unwrap()
}

// The full monomorphized C name STEM for a struct-INSTANCE tid — the mangled
// `Box_Str` / `Pair_Str_Int` / `Box_Box_Int` codegen prefixes with `blink_`.
// This is the def-side reader that lets a NON-generic fn whose param type is a
// concrete generic-struct instance (`b: Box[Str]`) lower its C type off the
// instance tid typecheck memoized onto the param annotation
// (make_struct_instance_type), not the bare head name (which codegen's
// param_c_type would otherwise use → the never-typedef'd `blink_Box`).
//
// Each arg slot is spelled via tc_tid_to_c_tag EXCEPT a struct-instance slot
// (params_count>=1), which is expanded RECURSIVELY so nesting is preserved:
// `Box[Box[Int]]` → outer base `Box` + inner stem `Box_Int` = `Box_Box_Int`,
// where the string helper (mono_name_from_ann) would read only the inner head
// name and collapse to `Box_Box`, dropping the `Int`.
//
// Returns "" (→ the caller keeps the string path) for a non-struct tid, a bare
// generic base (params_count 0), or any tid whose transitive slots are not
// concretely encodable (an unsubstituted typevar/unknown, or a module-qualified
// struct/enum, which tc_tid_to_c_tag strips and would diverge from the string
// path's file-derived prefix). The all-concrete same-module case rides this
// path; everything else DEFERS, matching test_6zmspt / test_tid_tuple.
pub fn tc_tid_list_elem(tid: Int) -> Int {
    let rt = tc_resolve(tid)
    if rt < 0 || rt >= ty_pool.len() { return -1 }
    let t = ty_pool.get(rt).unwrap()
    if t.kind != TyKind.List { return -1 }
    tc_resolve(t.inner1)
}

pub fn tc_tid_same_type(a0: Int, b0: Int) -> Bool {
    tc_tid_same_type_at(a0, b0, false, Map())
}

// tc_tid_same_type, except with `open` an unbound metavariable on either side stands for
// whatever the other side holds there: could inference still make the two one type? `holes`
// keeps what each metavariable stood for, so one that occurs twice must stand for one type
// both times. Binds nothing, so a candidate can be weighed and dropped.
fn tc_tid_same_type_at(a0: Int, b0: Int, open: Bool, holes: Map[Int, Int]) -> Bool {
    let a = tc_resolve(a0)
    let b = tc_resolve(b0)
    if a == b { return a >= 0 && a < ty_pool.len() }
    if open && tc_is_unbound_metavar(a) != 0 { return tc_open_hole_fits(a, b, holes) }
    if open && tc_is_unbound_metavar(b) != 0 { return tc_open_hole_fits(b, a, holes) }
    if a < 0 || a >= ty_pool.len() { return false }
    if b < 0 || b >= ty_pool.len() { return false }
    let ta = ty_pool.get(a).unwrap()
    let tb = ty_pool.get(b).unwrap()
    if ta.kind != tb.kind { return false }
    let k = ta.kind
    if k == TyKind.Struct || k == TyKind.Enum || k == TyKind.Typevar {
        if ta.name != tb.name { return false }
    }
    if (ta.inner1 < 0) != (tb.inner1 < 0) { return false }
    if (ta.inner2 < 0) != (tb.inner2 < 0) { return false }
    if ta.inner1 >= 0 && !tc_tid_same_type_at(ta.inner1, tb.inner1, open, holes) { return false }
    if ta.inner2 >= 0 && !tc_tid_same_type_at(ta.inner2, tb.inner2, open, holes) { return false }
    if ta.params_count != tb.params_count { return false }
    let mut i = 0
    while i < ta.params_count {
        let pa = ty_param_list.get(ta.params_start + i).unwrap()
        let pb = ty_param_list.get(tb.params_start + i).unwrap()
        if !tc_tid_same_type_at(pa, pb, open, holes) { return false }
        i = i + 1
    }
    true
}

// `holes` links each metavariable to what it stood for, as a forest: a link starts only at a
// root, so a chain always ends.
fn tc_open_hole_fits(hole: Int, other: Int, holes: Map[Int, Int]) -> Bool {
    let h = tc_open_hole_root(hole, holes)
    let o = tc_open_hole_root(other, holes)
    if h == o { return true }
    if tc_is_unbound_metavar(h) != 0 {
        holes.insert(h, o)
        return true
    }
    if tc_is_unbound_metavar(o) != 0 {
        holes.insert(o, h)
        return true
    }
    tc_tid_same_type_at(h, o, true, holes)
}

fn tc_open_hole_root(t: Int, holes: Map[Int, Int]) -> Int {
    let mut r = tc_resolve(t)
    while tc_is_unbound_metavar(r) != 0 && holes.contains_key(r) { r = tc_resolve(holes.get(r).unwrap()) }
    r
}

// Triage the slot contradictions merge_arg_tids recorded. Drained once at the
// end of generate(), which is why the buffer exists at all: the detector lives in
// codegen_types, BELOW typecheck in the DAG, and must stay pure — it can see that two
// concrete tids disagree but not whether they MEAN different things.
//
// The split is the whole point. `same_type` was the ty_pool
// non-interning artefact and the MAJORITY of the corpus population; ty_pool now interns
// canonically-constructed compounds (see the ty_intern_* helpers above `new_type`), so
// that population is driven toward 0. The residual `same_type` hits are the accepted
// incompleteness: a compound built over a metavar that later binds is not re-keyed, so
// two handles can still denote one type. Either handle still lowers identically, so this
// remains harmless even once the tid is authoritative.
// `diff_type` is one (base, args) key that genuinely collapsed two different types; a
// single stored tid cannot be per-instantiation identity for all of them, which is exactly
// what this classification must not assume it can read.
//
// Spelling is read HERE, after all emission, not at conflict time. Deliberate: pins mutate
// ty_pool in place and only ever make a type MORE resolved, so classifying late can only
// turn a "both render as ?" false SAMEness into the real difference — the direction that
// loses no findings.
fn tc_ann_names_tparam(ann: Int, param_name: Str) -> Bool {
    if ann == -1 { return false }
    if node_name(ann) == param_name { return true }
    if tc_ann_names_tparam(node_type_ann(ann), param_name) { return true }
    let elems_sl = node_elements(ann)
    if elems_sl == -1 { return false }
    let mut i = 0
    while i < sublist_length(elems_sl) {
        if tc_ann_names_tparam(sublist_get(elems_sl, i), param_name) { return true }
        i = i + 1
    }
    false
}


// Closure-signature scalar type NAME → its canonical tid, or -1 for anything else.
// Pure (effect-free) so the Fn arm of tc_resolve_tparam_tid can lower a closure
// literal's param/return annotation name without pulling in TypeCheck.Resolve (a
// lookup_named_type fallback would force that effect virally up through tc_mono_tids).
//
// The admitted set is deliberately narrower than resolve_type_name's: ONLY the four
// scalars the STRING path can recover from a closure's C signature — ct_from_c_type
// (codegen_types.bl) maps back exactly int64_t→Int, double→Float, int→Bool,
// const char*→Str and nothing else. Restricting to that set keeps the tid seg
// BYTE-IDENTICAL to the string seg for every closure-bound slot (the D1b invariant).
// A sized-int/Char annotation renders to int8_t/…/int32_t in the C signature, which
// ct_from_c_type erases to "Void"; admitting those here would spell "I8"/"Char"
// instead, a divergence that NOTHING DOWNSTREAM WOULD CATCH. The narrowing stands ON
// ITS OWN as the alignment guarantee for closure-bound slots — there is no backstop
// behind it. Widening the admitted set means re-establishing alignment here, not
// relying on a later screen. The capture cost of staying narrow is
// still nil (a closure typed over a sized int / Char binds no target-corpus tparam).

// ── Phase 4/5: total stamping ───────────────────────────────────────
//
// Inference stamps a node's type as a SIDE EFFECT of being asked for it, and the walk that
// asks is driven by tc_check_body, which reaches statement forms only. So a value that no
// statement arm happens to ask about carries nothing, and every later reader — the mono
// pass, codegen's two tid chokepoints — is left guessing from syntax instead of reading an
// answer. These two phases turn that from a silent gap into a reported one.
//
// Phase 4 RECOVERS, bottom-up, the types that are already determined but never written down:
// a scope- or branch-bearing form in a position tc_check_body does not walk (an argument, an
// initializer) is typed by its tail, which the walk DID memoize. It publishes only what it
// can read back; it never infers, because infer_type reports as it goes and inferring a form
// the checker skipped would invent diagnostics the program does not deserve.
//
// Phase 5 ASSERTS: every node whose kind denotes or binds a value must now carry a concrete
// type, or the compiler raises I0001 against that node. No kind is exempt. The three excuses
// are positional or structural and each is measured by the ratchet: a name position
// (tc_stamp_name_child), a cascade from a hole one level down (tc_stamp_is_cascade), and a
// body inference never checked (the @ffi skip in tc_stamp_walk).

// Whether the SPELLING `name` is one an item answers to — a namespace, an imported module, a
// type, a trait, a variant, a function. The ladder is name resolution's own, from the Ident
// arm of nr_check_node: what that pass accepts with no value binding behind it is exactly
// what has no value behind it.
//
// A spelling and not a position: a local can be bound under any of these names and is then
// the thing that name denotes. Asking this alone therefore answers "could be an item", not
// "is one" — tc_stamp_name_child asks the scope first and reaches here only when nothing was
// bound under the name.
pub fn tc_name_is_item(name: Str) -> Int {
    tc_name_is_item_in(name, nr_current_module)
}

// tc_name_is_item as read from inside `module`. The type and function tables answer a bare
// namesake per reading module, so the ladder has to run with the module of the position it
// excuses, not with whichever module the checker happened to finish on.
pub fn tc_name_is_item_in(name: Str, module: Str) -> Int {
    let saved_module = nr_current_module
    nr_current_module = module
    let is_item = tc_name_is_item_here(name)
    nr_current_module = saved_module
    is_item
}

// The module a body's names are read in: the one tc_infer_program_body checks it under. An
// impl or trait method carries no module of its own, so it reads in its block's; a test block
// reads in the main file's.
fn tc_body_module(decl: Int) -> Str {
    let own = node_module(decl)
    if own != "" { return own }
    // A derived operation reads in the module that declares its effect.
    let owner = tc_method_block.get(decl) ?? (tc_ue_op_root.get(decl) ?? -1)
    if owner < 0 { return "__main__" }
    node_module(owner)
}

// Codegen asks the type and function tables by name too, and they answer a bare namesake
// per reading module, so a lowered body must read in the module it was checked in. Answers
// the module it replaces, for tc_leave_body_module.
pub fn tc_enter_body_module(decl: Int) -> Str {
    let saved_module = nr_current_module
    nr_current_module = tc_body_module(decl)
    saved_module
}

pub fn tc_leave_body_module(saved_module: Str) {
    nr_current_module = saved_module
}

fn tc_name_is_item_here(name: Str) -> Int {
    // `import m.{add as plus}` registers `add` in the item tables and nothing under `plus`,
    // so the ladder has to ask about the declaration the alias reaches in this file. A
    // module-level binding is a value, not an item.
    let aliased = nr_alias_decl_here(name)
    if aliased >= 0 {
        if node_kind(aliased) == NodeKind.LetBinding { return 0 }
        return 1
    }
    if is_builtin_namespace(name) != 0 { return 1 }
    if is_import_module_name(name) != 0 { return 1 }
    if is_variant_name(name) != 0 { return 1 }
    if is_builtin_fn(name) != 0 { return 1 }
    if is_known_type(name) != 0 { return 1 }
    if is_trait_name(name) != 0 { return 1 }
    if is_user_effect_handle_name(name) != 0 { return 1 }
    if lookup_fnsig(name) != -1 { return 1 }
    0
}

// The one child of `n` that stands in a NAME position instead of a value position, or -1 when
// every value child of `n` really is a value.
//
// Exactly three positions can hold a name: a call's callee, and the qualifier of a method call
// or of a field access. Each is written as a bare Ident whether it names a value or an item —
// `f(x)` and `emit_line(x)`, `xs.len()` and `io.println(x)`, `p.zzf` and `NodeKind.Ident`.
// node_children sees the syntax and nothing else, so it cannot file these as spellings the
// way it files a type annotation; the rule is applied here instead. THIS function answers the
// syntactic half only — which child, if any, could be a name. Whether it is one is a question
// about scope, and tc_stamp_name_child puts it.
pub fn tc_name_position_child(n: Int) -> Int {
    let k = node_kind(n)
    let c = if k == NodeKind.Call {
        node_left(n)
    } else if k == NodeKind.MethodCall || k == NodeKind.FieldAccess {
        node_obj(n)
    } else {
        -1
    }
    if c == -1 { return -1 }
    if node_kind(c) != NodeKind.Ident { return -1 }
    c
}

// Record that the Ident in `n`'s name position denotes a VALUE. Called from inference, which
// is the only pass that runs with nr scope live, so it is the only place the question can be
// put. A name position is the one place a local BINDING and an item are spelled alike, and
// the item tables the ladder above reads cannot tell them apart — `ZzHue.len()` on a list
// named after an enum is written exactly like `io.println(x)`.
//
// An INNER-frame binding, because the global frame holds the items themselves: every
// top-level function is bound under its own name there, so `set_len(s)` would otherwise
// record its own callee as a value. A param or local is the only binding that can stand
// between a spelling and the item it would otherwise name, and it is always a value.
fn tc_record_name_position_value(n: Int) {
    let c = tc_name_position_child(n)
    if c == -1 { return }
    let top = nr_top_index(node_name(c))
    if top == -1 { return }
    if nr_index_is_global(top) != 0 { return }
    if c >= tc_name_position_is_value.len() { return }
    tc_name_position_is_value.set(c, 1)
}

// The one child of `n` that really IS a name — a spelling with no value under it for a type
// to describe. Everything else in those three positions is a value and must carry a type like
// any other, which is what the total-stamp pass excuses against this answer.
pub fn tc_stamp_name_child(n: Int) -> Int {
    let mut items: Map[Str, Int] = Map()
    tc_stamp_name_child_in(n, nr_current_module, items)
}

// tc_stamp_name_child for a position inside `module`, with the item-table answer kept in
// `items` per module and spelling. The ladder reads tables that nothing writes while the
// assert runs, so one answer holds for every position of that spelling in that module; two
// modules can each declare a type of the same name, so the module is part of the key. Scope
// is per position and stays out of the key: the same spelling is an item at one position and
// a shadowing local at another.
fn tc_stamp_name_child_in(n: Int, module: Str, items: Map[Str, Int]) -> Int {
    let c = tc_name_position_child(n)
    if c == -1 { return -1 }
    // `old` in an @ensures snapshot names the snapshot form, not a value or an item.
    if tc_old_calls.contains_key(n) { return c }
    // The scope is asked first, through the record inference left behind. A binding shadows
    // an item of the same name, so what the item tables say about the SPELLING settles
    // nothing once something is bound under it: the position holds a value, and a value
    // carries a type like any other.
    if c < tc_name_position_is_value.len() {
        if tc_name_position_is_value.get(c).unwrap() != 0 { return -1 }
    }
    let nm = node_name(c)
    // A spelling holds no space, so the module before it cannot run into it.
    let key = "{module} {nm}"
    let mut is_item = items.get(key) ?? -1
    if is_item == -1 {
        is_item = tc_name_is_item_in(nm, module)
        items.insert(key, is_item)
    }
    if is_item == 0 { return -1 }
    c
}

// Whether `tid` answers the question "what type is this" — a tid that resolves to a real
// pool entry and not to an unsolved metavariable.
pub fn tc_tid_is_concrete(tid: Int) -> Int {
    if tc_tid_is_no_info(tid) != 0 { return 0 }
    let r = tc_tid_resolved(tid)
    if tc_tid_is_no_info(r) != 0 { return 0 }
    if tc_is_unbound_metavar(r) != 0 { return 0 }
    1
}

// The type a scope- or branch-bearing form has by virtue of its tail, or -1 when nothing can
// be read back. Void is the answer for a form in statement position: it completes, and the
// value it does not produce is `()`. Never comes first, because a form every path leaves
// produces no value at all and codegen reads that distinction to decide reachability.
fn tc_recovered_scope_tid(node: Int) -> Int {
    let k = node_kind(node)
    if k == NodeKind.Block {
        if tc_block_exits(node) != 0 { return TYPE_NEVER }
    }
    // §2.9: an `if` with no else produces nothing on the path that skips the branch, so it holds
    // `()` whatever the branch evaluates to. Reached only when no consumer typed the form, which
    // is the statement position the rule is about.
    if k == NodeKind.IfExpr {
        if node_else_body(node) == -1 { return TYPE_VOID }
    }
    let memo = tc_scoped_value_memo(node, 0)
    if tc_tid_is_concrete(memo) != 0 { return memo }
    // A tail that produces a value of its own but carries no type leaves the whole form
    // unknown. `()` would claim a value the form does not have, and would hide the tail as the
    // real hole, so nothing is published and the consumer above reads as a cascade instead.
    let tail = tc_scoped_tail_node(node, 0)
    if tail != -1 {
        if tc_tid_is_concrete(tc_lookup_node_tid(tail)) == 0 { return -1 }
    }
    if k == NodeKind.Block { return TYPE_VOID }
    if k == NodeKind.IfExpr { return TYPE_VOID }
    if k == NodeKind.MatchExpr { return TYPE_VOID }
    if k == NodeKind.WithBlock { return TYPE_VOID }
    if k == NodeKind.AsyncScope { return TYPE_VOID }
    -1
}

// The node whose value a block-bearing form evaluates to, or -1 when its last statement
// produces none. Mirrors tc_scoped_value_memo's descent, which reads the TYPE at this same
// node; a branching form has no single tail and answers -1.
fn tc_scoped_tail_node(node: Int, depth: Int) -> Int {
    if node == -1 { return -1 }
    if depth >= 8 { return -1 }
    let k = node_kind(node)
    if k == NodeKind.WithBlock || k == NodeKind.AsyncScope {
        return tc_scoped_tail_node(node_body(node), depth + 1)
    }
    if k == NodeKind.Block {
        let tail = tc_block_tail_stmt(node)
        if tail == -1 { return -1 }
        let v = tc_block_tail_value(tail)
        if v == -1 { return -1 }
        // A tail statement whose KIND carries no type produces no value: §2.11 signs `for` and
        // `while` as `()`, and the block-tail rule accepts both. Asking one for a type answers
        // "unknown", which reads as an unanswered tail and leaves the block — and every form
        // above it — with nothing to publish.
        if nk_is_typed(node_kind(v)) == 0 { return -1 }
        return v
    }
    -1
}

// A value whose type depends on a scope it opens — a block tail, a spawned closure's body — was
// inferred before that scope existed, so a tail naming one of its locals left a hole in the
// node's own type (`Option[?]`, `Handle[?]`). The in-scope walk has the answer by now, and
// codegen reads the node, so the holes are filled from it here, in every position the value
// can sit in. Only a memo with no hole left is taken, and only the node's holes change: a
// value the program really leaves open keeps its hole for the checks that report it.
fn tc_stamp_fill_scoped_holes(node: Int) -> Int {
    let k = node_kind(node)
    let scoped = k == NodeKind.Block || k == NodeKind.IfExpr || k == NodeKind.MatchExpr || k == NodeKind.WithBlock || k == NodeKind.AsyncScope
    if !scoped && k != NodeKind.AwaitExpr && tc_unannotated_spawn_closure(node) == -1 { return 0 }
    let own = tc_lookup_node_tid(node)
    let open_own = tc_tid_is_no_info(own) == 0 && tc_tid_has_unknown(own) != 0
    let open_await = k == NodeKind.AwaitExpr && tc_tid_is_no_info(own) != 0
    if !open_own && !open_await { return 0 }
    let memo = tc_scoped_value_memo(node, 0)
    if tc_tid_is_no_info(memo) != 0 { return 0 }
    if tc_tid_has_unknown(memo) != 0 || tc_tid_has_unbound_metavar(memo) != 0 { return 0 }
    let filled = if open_await { memo } else { tc_tid_fill_unknowns(own, memo) }
    if tc_tid_has_unknown(filled) != 0 { return 0 }
    tc_publish_node_tid(node, filled)
    1
}

// One node, after its children. Publishing nothing is always allowed here; Phase 5 is what
// decides whether the absence is tolerable.
fn tc_stamp_recover_node(node: Int, seen: List[Int]) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let k = node_kind(node)
    if k == NodeKind.TypeDef {
        tc_stamp_type_field_defaults(node, seen)
        tc_stamp_where_predicate(node, seen)
        return
    }
    // §3.3: control transfer produces no value, and the rule belongs on the statement node
    // itself — the checker only ever asks about the Block that wraps it.
    if k == NodeKind.Return || k == NodeKind.Break || k == NodeKind.Continue {
        tc_publish_node_tid(node, TYPE_NEVER)
        return
    }
    // A literal chunk of an interpolated string IS a string literal; only the interpolated
    // expressions between the chunks are inferred.
    if k == NodeKind.Ident {
        if is_literal_string_part(node) != 0 { tc_publish_node_tid(node, TYPE_STR) }
        return
    }
    if tc_stamp_fill_scoped_holes(node) != 0 { return }
    if tc_tid_is_concrete(tc_lookup_node_tid(node)) != 0 { return }
    if k == NodeKind.Block || k == NodeKind.IfExpr || k == NodeKind.MatchExpr {
        tc_publish_node_tid(node, tc_recovered_scope_tid(node))
        return
    }
    if k == NodeKind.WithBlock || k == NodeKind.AsyncScope {
        tc_publish_node_tid(node, tc_recovered_scope_tid(node))
        return
    }
    // A call through a value — `(self.action)()`, a closure held in a field or a local — has
    // no name for the Call arm to look up, so nothing types it. The callee's own type says
    // what the call answers: child 0 of a Fn tid is its return type.
    if k == NodeKind.Call {
        if tc_tid_is_concrete(tc_lookup_node_tid(node)) != 0 { return }
        if node_left(node) == -1 { return }
        let callee_t = tc_tid_resolved(tc_lookup_node_tid(node_left(node)))
        if type_kind(callee_t) == TyKind.Fn { tc_publish_node_tid(node, tc_tid_child(callee_t, 0)) }
        return
    }
    // `..base` in a struct literal contributes the fields of the value it spreads, so it has
    // exactly that value's type.
    if k == NodeKind.SpreadExpr {
        tc_publish_node_tid(node, tc_lookup_node_tid(node_value(node)))
        return
    }
    // §2.11: a loop evaluates to `()`, except a `loop` no `break` targets, which never exits.
    if k == NodeKind.LoopExpr {
        if tc_loop_diverges(node) != 0 {
            tc_publish_node_tid(node, TYPE_NEVER)
        } else {
            tc_publish_node_tid(node, TYPE_VOID)
        }
    }
}

// A field DEFAULT is the one value expression no ordinary walk reaches: nothing calls it and
// codegen only ever emits it. Checked at the declaration, where the field's resolved type is in
// hand and the declaration's type parameters can be put back in scope for it.
// @allow: the module below is saved and restored, which opts this function into the check and so
// names the two mutations no save/restore can cover — the matched tparam push/pop pair, and the
// type publishing that IS the point of the field-default check.
@allow(UnrestoredMutation)
fn tc_stamp_type_field_defaults(td: Int, seen: List[Int]) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let flds_sl = node_fields(td)
    if flds_sl == -1 { return }
    let struct_tid = tc_decl_tid(td)
    let tparams = node_type_params(td)
    tc_push_tparam_scope(tparams)
    // A bare name in a default resolves through the module the DECLARATION came from: the local
    // scopes are gone by now, so a module-level binding is reached by its module key alone. The
    // global-initializer walk sets the same global for the same reason.
    let saved_module = nr_current_module
    nr_current_module = node_module(td)
    let mut i = 0
    while i < sublist_length(flds_sl) {
        let f = sublist_get(flds_sl, i)
        if node_kind(f) == NodeKind.TypeField {
            let dflt = node_condition(f)
            if dflt != -1 {
                tc_stamp_field_default(dflt, get_struct_field_tid(struct_tid, node_name(f)))
                // The surrounding walk recovers the default's nodes BEFORE it reaches this
                // declaration, so a node that reads its type from a child — a closure body's
                // block from its tail — had nothing to read then. Recover the subtree again now
                // that the check above has typed it.
                let mut dflt_owners: List[Int] = []
                let _ = tc_stamp_walk(dflt, dflt_owners, seen)
            }
        }
        i = i + 1
    }
    nr_current_module = saved_module
    tc_pop_tparam_scope(tparams)
}

// The default's value against the field's declared type: the same pair of walks a let
// binding's value gets, so a container default types its elements and a closure default binds
// its params and types its body.
// @allow: publishing types IS this function's effect, as in tc_walk_stmt_value.
@allow(UnrestoredMutation)
fn tc_stamp_field_default(dflt: Int, ftid: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    tc_seed_expected_into_value(dflt, ftid)
    let mut inferred = tc_infer_value_under(ftid, dflt)
    // The pin below would fix a closure's open result to the field's type, so a default that
    // reads one is pinned once the walk has bound it.
    let reread = tc_value_awaits_closure_ret(dflt)
    if reread {
        tc_walk_stmt_value(dflt)
        inferred = tc_infer_value_under(ftid, dflt)
    }
    // An empty `Map()` mints its own key and value metavars, which a hint over the
    // declaration's own parameters cannot fill. Pinning them to K and V is a determination:
    // each instance of the type substitutes its own arguments there.
    tc_pin_tail_ret_generic(ftid, inferred)
    if tc_tid_is_concrete(tc_lookup_node_tid(dflt)) == 0 { tc_publish_node_tid(dflt, inferred) }
    if !reread { tc_walk_stmt_value(dflt) }
    tc_literal_takes(dflt, ftid)
}

// Post-order over the value children of `node`. Explicitly iterative: the AST is as deep as
// the source nests, and a recursive walk over the compiler's own longest functions is a
// stack the recovery pass has no reason to spend.
// The assert order, and `owners` filled in step with it: owners[i] is the body order[i] sits
// in, the nearest enclosing function or test block, or -1 for a node at module level. Both
// columns come off ONE descent, so a change to how children are enumerated cannot move one
// and leave the other behind.
//
// A closure is not a body here. Its result type may be inferred from its tail, so an absence
// inside it flows out into the function that holds it, and the fence has to be that function.
//
// `seen` holds one mark per node id and is all zero between walks. The walk grows it to the
// node count, and clears its own marks once the descent is done. Recovery runs after that and
// walks a field default or a @where predicate on its own; it reuses the same buffer, so those
// walks cost their own subtree and not a pass over every node.
pub fn tc_stamp_walk(root: Int, owners: List[Int], seen: List[Int]) -> List[Int] ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let mut mods: List[Str] = []
    tc_stamp_walk_sized(root, owners, mods, seen, 0)
}

// The walk with room for `cap` nodes in its order: the whole-program walk reaches nearly every
// node, and growing a list that size by doubling copies it again at each step.
//
// `mods` gets a third column: the module each node was checked in. Only a top-level
// declaration carries its module, so a node below one reads it from the nearest ancestor that
// does, which is the module tc_infer_program_body sets around that declaration's body.
fn tc_stamp_walk_sized(root: Int, owners: List[Int], mods: List[Str], seen: List[Int], cap: Int) -> List[Int] ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let mut order: List[Int] = List.with_capacity(cap)
    if root == -1 { return order }
    while seen.len() < node_count() { seen.push(0) }
    let mut stack: List[Int] = [root]
    let mut pending: List[Int] = [-1]
    // A test block carries no module and is checked in the main file's, as tc_body_module reads it.
    let mut pending_mod: List[Str] = ["__main__"]
    let mut kids: List[Int] = []
    while stack.len() > 0 {
        let n = stack.pop().unwrap()
        let o = pending.pop().unwrap()
        let outer_mod = pending_mod.pop().unwrap()
        if seen.get(n).unwrap() != 0 { continue }
        seen.set(n, 1)
        let own_mod = node_module(n)
        let m = if own_mod != "" { own_mod } else { outer_mod }
        owners.push(o)
        mods.push(m)
        order.push(n)
        // An `@ffi` declaration's body is never checked — tc_check_fn skips it, and name
        // resolution does not even bind its params — so nothing in it was ever given a type.
        // Walking it would assert against a hole inference was told not to fill. The body is
        // the only child that goes unchecked: the params and the return annotation are
        // published either way.
        let skip_body = if node_kind(n) == NodeKind.FnDef && has_annotation(n, "ffi") != 0 {
            node_body(n)
        } else {
            -1
        }
        let nk = node_kind(n)
        let inner = if nk == NodeKind.FnDef || nk == NodeKind.TestBlock { n } else { o }
        kids.clear()
        node_push_value_child_ids(n, kids)
        let mut i = 0
        while i < kids.len() {
            let kid = kids.get(i).unwrap()
            if kid != skip_body {
                stack.push(kid)
                pending.push(inner)
                pending_mod.push(m)
            }
            i = i + 1
        }
    }
    for n in order { seen.set(n, 0) }
    let mut j = order.len() - 1
    while j >= 0 {
        tc_stamp_recover_node(order.get(j).unwrap(), seen)
        j = j - 1
    }
    order
}

// The owner of a node the walk never reached. An owner is -1 or a node id, so this collides
// with neither.
pub let TC_STAMP_UNOWNED = -2

// The owner column of a walk, indexed by node id instead of by walk position.
pub fn tc_stamp_owner_index(order: List[Int], owners: List[Int]) -> List[Int] {
    let mut index: List[Int] = List.with_capacity(node_count())
    while index.len() < node_count() { index.push(TC_STAMP_UNOWNED) }
    let mut i = 0
    while i < order.len() {
        index.set(order.get(i).unwrap(), owners.get(i).unwrap())
        i = i + 1
    }
    index
}

// TC_STAMP_UNOWNED for an id the index does not cover: a node made after the walk, which the
// walk cannot have reached.
pub fn tc_stamp_owner_of(index: List[Int], n: Int) -> Int {
    if n < 0 || n >= index.len() { return TC_STAMP_UNOWNED }
    index.get(n).unwrap()
}

fn tc_stamp_is_cascade(n: Int) -> Int {
    // `.await` answers with the PAYLOAD of its operand's handle, so a handle whose payload is
    // still open leaves it nothing to read even though the operand itself has a type. The hole
    // is in whatever failed to pin the payload — the spawned closure's return.
    if node_kind(n) == NodeKind.AwaitExpr {
        let awaited = tc_tid_resolved(tc_lookup_node_tid(node_obj(n)))
        if tc_tid_kind(awaited) != TyKind.Handle { return 1 }
        if tc_tid_child_count(awaited) < 1 { return 1 }
        if tc_tid_is_concrete(tc_tid_child(awaited, 0)) == 0 { return 1 }
        return 0
    }
    // A member reached THROUGH a type parameter — `v.x` where `v: T`, `x.m()` where `x: T` —
    // names no type at this site. The field or method belongs to whatever T stands for, so the
    // answer exists only once T is bound, which is monomorphization: the mono pass records this
    // node's tid per instance. The receiver is typed (it is T), so the hole is not the
    // receiver's own — it is the parameter's, one level up at the call that binds it. A BOUNDED
    // parameter does not reach here: the bound licenses the member and the trait's own
    // signature answers it, so a hole under a bound is a real hole and still reports.
    let member_recv = if node_kind(n) == NodeKind.FieldAccess || node_kind(n) == NodeKind.MethodCall {
        node_obj(n)
    } else {
        -1
    }
    if member_recv != -1 {
        let recv_t = tc_tid_resolved(tc_lookup_node_tid(member_recv))
        if tc_tid_kind(recv_t) == TyKind.Typevar {
            if tc_tparam_bound_traits(tc_tid_name(recv_t)) == "" { return 1 }
        }
    }
    // A block-bearing form reads its type from its TAIL and from nothing else, so the tail is
    // the only child that can be its hole — its other statements are typed on their own.
    let tail = tc_scoped_tail_node(n, 0)
    if tail != -1 {
        if tc_tid_is_concrete(tc_lookup_node_tid(tail)) == 0 { return 1 }
        return 0
    }
    let kids = node_value_child_ids(n)
    let mut i = 0
    while i < kids.len() {
        let kid = kids.get(i).unwrap()
        if kid != -1 {
            if nk_is_typed(node_kind(kid)) != 0 {
                if tc_tid_is_concrete(tc_lookup_node_tid(kid)) == 0 { return 1 }
            }
        }
        i = i + 1
    }
    0
}

// The bodies the stand-down covers: one entry per body that still holds an unclaimed call, and
// -1 when a call sits at module level.
//
// A call no arm claimed carries nothing, and the absence spreads by DATA FLOW: the `let` it
// initializes, then every read of that binding. A local binding lives no wider than the body
// that declares it, and a body's result type is declared — an un-annotated signature returns
// `()` — so the absence cannot cross the function or test block that holds the call. Standing
// down for that body alone leaves every other body asserted. A closure is not a fence: its
// result type may be inferred from its tail, so the absence flows out of it into the enclosing
// body, which is why the owner is the nearest FnDef and not the nearest callable. A call at
// module level has no fence at all — it types a global whose readers are the whole program.
fn tc_stamp_standdown_bodies(owner_index: List[Int]) -> Map[Int, Int] {
    let mut bodies: Map[Int, Int] = Map()
    for uc in tc_unclaimed_call_nodes() {
        // A call the walk never reached is fenced by nothing, as a module-level call is.
        let o = tc_stamp_owner_of(owner_index, uc)
        bodies.insert(if o == TC_STAMP_UNOWNED { -1 } else { o }, 1)
    }
    bodies
}

// Phase 5. Reports against the first offending node per kind, so a systemic hole reads as one
// error naming its kind and not as thousands. Nodes inside a body `stood` names are passed
// over: an unclaimed call there leaves holes the report coming from codegen already owns.
//
// `marks` is the walk's `seen` buffer: all zero, one slot per node the walk reached. Nothing
// reads it after this pass, so the marks are left in it.
fn tc_stamp_assert(order: List[Int], owners: List[Int], mods: List[Str], stood: Map[Int, Int], marks: List[Int]) ! Diag.Report {
    // The untyped nodes first. Only a node that carries no type can need a name excuse, so the
    // name ladder runs for those alone. In a program that type checks they are the item names
    // in name positions, which leaves out the typed name positions (about three in ten).
    // Slot 1 marks a candidate, 2 a candidate excused as a name.
    let check_stood = stood.len() > 0
    let mut cands: List[Int] = []
    let mut ident_cand = false
    let mut i = 0
    while i < order.len() {
        let n = order.get(i).unwrap()
        if !check_stood || !stood.contains_key(owners.get(i).unwrap()) {
            if nk_is_typed(node_kind(n)) != 0 && tc_tid_is_concrete(tc_lookup_node_tid(n)) == 0 {
                cands.push(n)
                marks.set(n, 1)
                if node_kind(n) == NodeKind.Ident { ident_cand = true }
            }
        }
        i = i + 1
    }
    // A name position always holds a bare Ident, so with no Ident candidate there is nothing
    // to excuse. Otherwise the positions are read off the PARENT, as the walk has no parent
    // column, and the ladder is put only where the child is a candidate.
    if ident_cand {
        // A few thousand spellings fill tens of thousands of name positions. Dropped with
        // this call, so no answer outlives the tables it was read from.
        let mut items: Map[Str, Int] = Map()
        let mut j = 0
        while j < order.len() {
            let p = order.get(j).unwrap()
            let c = tc_name_position_child(p)
            if c != -1 && c < marks.len() && marks.get(c).unwrap() == 1 {
                if tc_stamp_name_child_in(p, mods.get(j).unwrap(), items) == c { marks.set(c, 2) }
            }
            j = j + 1
        }
    }
    let mut reported: Map[Str, Int] = Map()
    for n in cands {
        if marks.get(n).unwrap() == 1 && tc_stamp_is_cascade(n) == 0 {
            let kn = node_kind_name(node_kind(n))
            if reported.contains_key(kn) == false {
                reported.insert(kn, 1)
                diag_ice_at("NodeCarriesNoType", UNSOLVED_TYPEVAR_AT_CODEGEN,
                    "a {kn} node reached the end of type checking with no type",
                    n,
                    "every node whose kind denotes or binds a value must carry a type by the end of inference; this is a compiler defect, not a program error")
            }
        }
    }
}

// A call no arm claimed is a name error once its receiver names a type or a module
// (section 6.3.3), and 6.3.5 wants it reported before codegen, which would otherwise lay
// out the value the call never had. A type parameter's methods are decided per instance.
// `order` and `mods` are the stamp walk's nodes and the module each one is in: a report's help
// is written for the module that holds the call.
fn tc_report_unclaimed_calls(order: List[Int], mods: List[Str]) ! Diag.Report {
    let calls = tc_unclaimed_call_nodes()
    if calls.len() == 0 { return }
    let mut unclaimed: Map[Int, Int] = Map()
    for uc in calls { unclaimed.insert(uc, 1) }
    let mut call_mod: Map[Int, Str] = Map()
    let mut i = 0
    while i < order.len() {
        let n = order.get(i).unwrap()
        if unclaimed.contains_key(n) { call_mod.insert(n, mods.get(i).unwrap()) }
        i = i + 1
    }
    let saved_module = nr_current_module
    for uc in calls {
        nr_current_module = call_mod.get(uc) ?? saved_module
        let obj = node_obj(uc)
        let mname = node_method(uc)
        let recv = tc_lookup_node_tid(obj)
        if tc_unclaimed_receiver_is_named(recv) != 0 {
            let tname = tc_type_str(recv)
            tc_error_naming_types("UnresolvedMethod", UNRESOLVED_METHOD, "unresolved method `.{mname}` on type {tname}",
                uc, tc_unresolved_method_help(type_kind(recv), tname, mname), [recv])
        } else if node_kind(obj) == NodeKind.Ident {
            let q = node_name(obj)
            if q == "default" {
                diag_error_at("UnresolvedMethod", UNRESOLVED_METHOD, "`default` is only valid inside a handler operation body", uc,
                    "`default` names the handler an operation's own handler was installed over")
            } else if q == "io" && mname == "lines" {
                // Some languages have a lines iterator on stdin; Blink reads lines with two
                // forms, and the help shows both (sections/04_effects.md §4.4.9).
                diag_error_at("UnresolvedMethod", UNRESOLVED_METHOD, "no method `lines` on the `io` handle", uc,
                    "read all the input, then split it: `for line in io.read_all().lines() \{ ... }`\nor read one line at a time: `loop \{ match io.read_line() \{ Some(line) => ..., None => break } }`")
            } else if is_builtin_namespace(q) == 1 || is_import_module_name(q) == 1 {
                let near = suggest_module_member(tc_qualifier_to_module_or_self(q), mname)
                let help = if near != "" { "did you mean `{q}.{near}`?" } else { "" }
                diag_error_at("UnresolvedMethod", UNRESOLVED_METHOD, "no member `{mname}` on module `{q}`", uc, help)
            }
        }
    }
    nr_current_module = saved_module
}

// A value receiver's type, determined all the way down. A local shadowing a module name
// lands here too, so it is named by its type and not as the module.
fn tc_unclaimed_receiver_is_named(tid: Int) -> Int {
    if tc_tid_is_concrete(tid) == 0 { return 0 }
    let r = tc_tid_resolved(tid)
    if tc_tid_has_unbound_metavar(r) != 0 || tc_tid_has_unknown(r) != 0 { return 0 }
    if tc_tid_has_bare_typevar(r) != 0 { return 0 }
    1
}

// A literal no expected type reached is Int (sections/03_types.md §3.2 *Integer literal
// range*). Its type is final only once every pass that can give it one has run, so the range
// check of a literal that is Int by default waits for the whole walk. A literal that another
// check reported is not reported again. `order` is the walk's pre-order: a let comes before
// its value, and a negative literal before the literal under its `-`. The reports follow node
// order, which is source order, and not the walk's.
//
// A literal beside an operand that is not an integer stays Int, and the operator or the
// operand is the error there: reporting the literal too would explain one mistake twice. A
// program with no error yet gets the report, so no literal reaches codegen out of range.
fn tc_report_int_literals_out_of_range(order: List[Int]) ! Diag.Report {
    let mut skip: Set[Int] = Set()
    let mut let_of: Map[Int, Int] = Map()
    let mut found: List[Int] = []
    for n in order {
        let k = node_kind(n)
        if k == NodeKind.LetBinding && node_target(n) == -1 && node_type_name(n) == "" && node_name(n) != "" {
            let v = node_value(n)
            if v != -1 && is_int_literal_node(v) != 0 { let_of.insert(v, n) }
        }
        if k == NodeKind.BinOp {
            tc_skip_literal_beside_non_integer(node_left(n), node_right(n), skip)
            tc_skip_literal_beside_non_integer(node_right(n), node_left(n), skip)
        }
        if is_int_literal_node(n) == 0 || skip.contains(n) { continue }
        if k == NodeKind.UnaryOp { skip.insert(node_left(n)) }
        let stamped = tc_lookup_node_tid(n)
        if stamped < 0 { continue }
        let t = tc_resolve(resolve_alias_tid(stamped))
        if is_integer_type(t) == 0 || tc_literal_fits(n, type_kind(t)) { continue }
        found.push(n)
    }
    for n in found.sort() {
        let k = node_kind(n)
        let t = tc_resolve(resolve_alias_tid(tc_lookup_node_tid(n)))
        let default_int = type_kind(t) == TyKind.Int
        let mut help = ""
        let decl = let_of.get(n) ?? -1
        if default_int && decl != -1 && k == NodeKind.IntLit && tc_literal_fits(n, TyKind.U64) {
            let p = if node_is_pub(decl) != 0 { "pub " } else { "" }
            let m = if node_is_mut(decl) != 0 { "mut " } else { "" }
            let kw = if node_is_const(decl) != 0 { "const" } else { "let" }
            help = "{p}{kw} {m}{node_name(decl)}: U64 = {int_lit_node_digits(n)}"
        }
        tc_report_int_literal_range(n, t, default_int, help)
    }
}

fn tc_skip_literal_beside_non_integer(lit: Int, other: Int, skip: Set[Int]) {
    if lit == -1 || other == -1 || is_int_literal_node(lit) == 0 || is_int_literal_node(other) != 0 { return }
    if diag_any_errors_since(0) == 0 { return }
    let other_t = tc_lookup_node_tid(other)
    if other_t >= 0 && is_integer_type(tc_resolve(resolve_alias_tid(other_t))) != 0 { return }
    skip.insert(lit)
}

// Phases 4 and 5 over one program. Separate from check_types so `blink check` and the test
// harness reach the same pass by the same name.

pub fn tc_stamp_program(program: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let mut owners: List[Int] = List.with_capacity(node_count())
    // tc_stamp_walk fills one slot per node.
    let mut mods: List[Str] = List.with_capacity(node_count())
    let mut seen: List[Int] = List.with_capacity(node_count())
    let order = tc_stamp_walk_sized(program, owners, mods, seen, node_count())
    tc_report_unclaimed_calls(order, mods)
    tc_report_int_literals_out_of_range(order)
    // A program that already has an error has nodes inference deliberately never typed: the
    // arm that would have typed them reported instead and returned. Asserting there turns
    // every ordinary type error into an internal-compiler-error cascade, so the total-stamp
    // claim only holds for a program that type checks.
    if diag_count > 0 { return }
    // The same precondition, for a call left unclaimed on a receiver with no named type, which
    // tc_report_unclaimed_calls cannot report. The absence spreads: the let it initializes
    // carries nothing, and so does every read of that binding. Nothing here can tell those
    // apart from a real hole — inside the BODY that holds the call. Every other body keeps its
    // claim, so one unclaimed call buys silence for itself and not for the program.
    // Traced rather than silent, so "the pass stood down" is a thing a build can be asked.
    let mut stood: Map[Int, Int] = Map()
    let live_unclaimed = tc_unresolved_call_count()
    if live_unclaimed > 0 {
        let owner_index = tc_stamp_owner_index(order, owners)
        stood = tc_stamp_standdown_bodies(owner_index)
        if dbg_channel_on("stamp") != 0 {
            // The module-level pseudo-body is a key in `stood` but is not a body, so it is not
            // counted as one.
            let bodies = stood.len() - (if stood.contains_key(-1) { 1 } else { 0 })
            dbg_trace("stamp", "stood down: {live_unclaimed} call(s) left to the codegen backstop, in {bodies} body(ies)")
            for uc in tc_unclaimed_call_nodes() {
                // A call the owner walk never reached is fenced by nothing, which stands the
                // pass down everywhere — the same effect as a module-level call and a
                // different cause, so the trace names them apart.
                let ob = tc_stamp_owner_of(owner_index, uc)
                let where_ = if ob == TC_STAMP_UNOWNED {
                    "<unowned: the whole program stands down>"
                } else if ob == -1 {
                    "<module level>"
                } else {
                    node_name(ob)
                }
                dbg_trace("stamp", "  .{node_method(uc)}() at {node_line(uc)}:{node_col(uc)} in {where_}")
            }
        }
        // A module-level call has no body to be fenced by: it types a global, and a global's
        // readers are the whole program. That one case still stands the pass down everywhere.
        if stood.contains_key(-1) { return }
    }
    tc_stamp_assert(order, owners, mods, stood, seen)
}

// ── Name and impl-shape helpers ────────────────────────────────────────────────
//
// These three answer questions typecheck itself asks. They lived in the old
// codegen_types.bl only because that file was compiled into every program; the
// answers were never a storage fact and nothing in codegen consumed them.

// `std.db.row.Row` → `db.row.Row`. Strips one leading segment, not all of them. A namesake
// keeps its qualifier: `alpha.Point` IS the nominal name when another module also declares
// `Point`, so stripping it would collapse the two types every comparison keeps apart.
pub fn strip_module_qualifier(name: Str) -> Str {
    match name.byte_index_of(".", 0) {
        Some(dot_pos) => {
            let rest = name.byte_slice(dot_pos + 1, name.byte_len())
            if tc_is_namesake_type_name(rest) != 0 { return name }
            return rest
        }
        None => {}
    }
    name
}

// Every `namespace.method` the compiler types itself rather than resolving to a
// declared signature. This list must be a SUPERSET of the arms codegen emits: an
// unlisted name falls out of the intrinsic gate and into the bare-name
// fallthrough, which asks `lookup_fnsig("write")` rather than
// `lookup_fnsig("io.write")` — nothing answers and the call types as unknown,
// which unifies with anything.
//
// Short is the bug; long is harmless. `debug` is listed with no codegen arm
// behind it and STAYS: a listed-but-unsigned name gets no type from either arm
// and falls to the loud codegen backstop, and being listed is what keeps it off
// the bare-name path where a free fn named `debug` could answer for it.
// `println` has always been in that state. `env.vars` is deliberately NOT listed:
// it is spelled in the effects spec but no codegen arm emits it, so it must keep
// reaching the backstop rather than being affirmed here.
pub fn is_intrinsic_method(namespace: Str, method: Str) -> Int {
    if namespace == "net" {
        if method == "connect" || method == "close" || method == "read" || method == "write" || method == "read_all" || method == "read_line" || method == "set_timeout" || method == "listen" || method == "accept" || method == "request" || method == "read_bytes" || method == "write_bytes" {
            return 1
        }
    }
    if namespace == "io" {
        if method == "println" || method == "print" || method == "print_raw" || method == "eprintln" || method == "eprint" || method == "eprint_raw" || method == "log" || method == "debug" || method == "read_line" || method == "read_bytes" || method == "read_all" || method == "write" || method == "write_bytes" {
            return 1
        }
    }
    if namespace == "fs" {
        if fs_op_sub_effect(method) != "" || method == "errno" {
            return 1
        }
    }
    if namespace == "term" {
        if method == "isatty" || method == "width" || method == "height" {
            return 1
        }
    }
    if namespace == "env" {
        if method == "args" || method == "var" || method == "cwd" || method == "set_var" || method == "remove_var" || method == "exit" {
            return 1
        }
    }
    if namespace == "time" {
        if method == "read" || method == "sleep" {
            return 1
        }
    }
    if namespace == "async" {
        if method == "spawn" {
            return 1
        }
    }
    if namespace == "ffi" {
        if method == "scope" {
            return 1
        }
    }
    0
}

fn tc_collect_type_ann_names(ann: Int, out: List[Str]) {
    if ann == -1 { return }
    let n = node_name(ann)
    if n != "" { out.push(n) }
    let elems = node_elements(ann)
    if elems != -1 {
        let mut i = 0
        while i < sublist_length(elems) {
            tc_collect_type_ann_names(sublist_get(elems, i), out)
            i = i + 1
        }
    }
    // A fn-type annotation stores its parameters in `elements` but its return
    // type in `type_ann`, so the return binder is only reachable this way.
    if n == "Fn" {
        tc_collect_type_ann_names(node_type_ann(ann), out)
    }
}

// True when no impl binder is bounded and no binder name appears in any method
// signature. Such an impl cannot materialize an element by value nor operate on
// one, so it is accepted where a per-element poly impl would not be.
pub fn impl_is_element_agnostic(im: Int) -> Int {
    let binders_sl = node_impl_binders(im)
    if binders_sl == -1 { return 1 }
    let nb = sublist_length(binders_sl)
    if nb == 0 { return 1 }
    // A where-clause bounds a binder just as an inline `[T: Bound]` does.
    let where_sl = node_impl_where_bounds(im)
    if where_sl != -1 && sublist_length(where_sl) != 0 { return 0 }
    let mut bnames: List[Str] = []
    let mut bi = 0
    while bi < nb {
        let b = sublist_get(binders_sl, bi)
        if node_elements(b) != -1 { return 0 }
        bnames.push(node_name(b))
        bi = bi + 1
    }
    let methods_sl = node_methods(im)
    if methods_sl == -1 { return 1 }
    let mut j = 0
    while j < sublist_length(methods_sl) {
        let m = sublist_get(methods_sl, j)
        let mut names: List[Str] = []
        tc_collect_type_ann_names(node_type_ann(m), names)
        let params_sl = node_params(m)
        if params_sl != -1 {
            let mut pi = 0
            while pi < sublist_length(params_sl) {
                tc_collect_type_ann_names(node_type_ann(sublist_get(params_sl, pi)), names)
                pi = pi + 1
            }
        }
        let mut ni = 0
        while ni < names.len() {
            let nm = names.get(ni).unwrap()
            let mut bk = 0
            while bk < bnames.len() {
                if nm == bnames.get(bk).unwrap() { return 0 }
                bk = bk + 1
            }
            ni = ni + 1
        }
        j = j + 1
    }
    1
}

// ── Effect rows (E0500) ──────────────────────────────────────────────
// A caller must declare every effect its callees require (sections/04_effects.md §4.5). The
// walk carries the row a body holds as a parameter: a fn's own `!` list, extended inside a
// `with` block by the effect each item installs. A closure or a handler-literal op body runs
// with the row of the fn that encloses it.

// Only a user effect's children are known here, from its declaration. A builtin parent must
// be held as written: the children the runtime routes through a builtin parent (IO.Eprint)
// are not the list in §4.3, and a second copy of either list would drift from the other.
fn tc_er_user_children(program: Int, root: Str) -> List[Str] {
    let mut out: List[Str] = []
    let eds = node_args(program)
    if eds == -1 { return out }
    let mut i = 0
    while i < sublist_length(eds) {
        let ed = sublist_get(eds, i)
        let kids = node_elements(ed)
        if node_name(ed) == root && kids != -1 {
            let mut k = 0
            while k < sublist_length(kids) {
                out.push(node_name(sublist_get(kids, k)))
                k = k + 1
            }
        }
        i = i + 1
    }
    out
}

// Holding a parent grants each of its children; holding every child of a parent grants
// the parent (§4.3).
fn tc_er_satisfied(program: Int, held: List[Str], req: Str) -> Bool {
    for h in held {
        if h == req || req.starts_with("{h}.") { return true }
    }
    if req.contains(".") { return false }
    let kids = tc_er_user_children(program, req)
    if kids.len() == 0 { return false }
    for kid in kids {
        if !tc_er_satisfied(program, held, "{req}.{kid}") { return false }
    }
    true
}

// The effect an operation of user effect `ed` requires: the child that declares it, or the
// effect itself for an op declared at its top level.
fn tc_er_op_effect(ed: Int, op: Int) -> Str {
    let kids = node_elements(ed)
    if kids != -1 {
        let mut ci = 0
        while ci < sublist_length(kids) {
            let c = sublist_get(kids, ci)
            let ops = node_methods(c)
            if ops != -1 {
                let mut oi = 0
                while oi < sublist_length(ops) {
                    if sublist_get(ops, oi) == op { return "{node_name(ed)}.{node_name(c)}" }
                    oi = oi + 1
                }
            }
            ci = ci + 1
        }
    }
    node_name(ed)
}

fn tc_er_require(program: Int, site: Int, held: List[Str], owner: Str, callee: Str, req: Str) ! Diag.Report {
    if tc_er_satisfied(program, held, req) { return }
    diag_error_at("UndeclaredEffect", UNDECLARED_EFFECT,
        "call to `{callee}` needs effect `{req}`, which `{owner}` does not declare", site,
        "add `{req}` to the `!` list of `{owner}`, or make the call inside a `with` block that provides it")
    diag_set_last_fix("add effect", req)
}

fn tc_er_check_call(program: Int, node: Int, held: List[Str], owner: Str) ! Diag.Report {
    let decl = tc_call_decl_node(node)
    if decl < 0 { return }
    match tc_ue_op_root.get(decl) {
        Some(ed) => {
            tc_er_require(program, node, held, owner, "{node_name(ed)}.{node_name(decl)}", tc_er_op_effect(ed, decl))
            return
        }
        None => {}
    }
    let idx = fnsig_by_decl.get(decl) ?? -1
    if idx < 0 { return }
    let fs = fnsig_pool.get(idx).unwrap()
    let mut i = 0
    while i < fs.effects_count {
        let req = fnsig_effect_names.get(fs.effects_start + i).unwrap()
        // FFI is left out until the owner rules on whether @trusted discharges it; reporting
        // it now, or making the lib wrappers declare it, would settle that question here.
        if req != "FFI" && !req.starts_with("FFI.") {
            tc_er_require(program, node, held, owner, node_name(decl), req)
        }
        i = i + 1
    }
}

fn tc_er_row_with(held: List[Str], extra: Str) -> List[Str] {
    let mut out: List[Str] = []
    for h in held { out.push(h) }
    if extra != "" { out.push(extra) }
    out
}

fn tc_er_fn_row(fn_node: Int) -> List[Str] {
    let mut out: List[Str] = []
    let effs = node_effects(fn_node)
    if effs != -1 {
        let mut i = 0
        while i < sublist_length(effs) {
            out.push(node_name(sublist_get(effs, i)))
            i = i + 1
        }
    }
    out
}

// Items nest left to right, so each item's expression runs under the effects the items
// before it installed (§4.7.2).
fn tc_er_with_row(program: Int, node: Int, held: List[Str], owner: Str, kids: List[Int]) -> List[Str] ! TypeCheck.Resolve, Diag.Report {
    let mut row = tc_er_row_with(held, "")
    let items = node_handlers(node)
    if items == -1 { return row }
    let mut i = 0
    while i < sublist_length(items) {
        let it = sublist_get(items, i)
        let ik = node_kind(it)
        if ik == NodeKind.Ident && node_name(it) == "arena" {
            row = tc_er_row_with(row, "Arena")
        } else {
            let vn = if ik == NodeKind.WithResource { node_value(it) } else { it }
            tc_er_walk(program, vn, row, owner, kids)
            let vt = resolve_alias_tid(tc_lookup_node_tid(vn))
            let mut e = tc_tid_handler_effect(vt)
            if e == "" && vt >= 0 { e = tc_tid_handler_effect(resolve_alias_tid(tc_with_binder_tid(vt))) }
            row = tc_er_row_with(row, e)
        }
        i = i + 1
    }
    row
}

fn tc_er_walk(program: Int, node: Int, held: List[Str], owner: Str, kids: List[Int]) ! TypeCheck.Resolve, Diag.Report {
    if node < 0 { return }
    let k = node_kind(node)
    if k == NodeKind.FnDef {
        tc_er_walk_fn(program, node, kids)
        return
    }
    if k == NodeKind.WithBlock {
        tc_er_walk(program, node_body(node), tc_er_with_row(program, node, held, owner, kids), owner, kids)
        return
    }
    if k == NodeKind.HandlerExpr {
        // An operation body runs over the handler this one was installed on, so its calls
        // through the effect it handles are answered there (§4.7.1).
        let row = tc_er_row_with(held, tc_tid_handler_effect(resolve_alias_tid(tc_lookup_node_tid(node))))
        let ms = node_methods(node)
        if ms != -1 {
            let mut i = 0
            while i < sublist_length(ms) {
                tc_er_walk(program, node_body(sublist_get(ms, i)), row, owner, kids)
                i = i + 1
            }
        }
    }
    if k == NodeKind.Call || k == NodeKind.MethodCall { tc_er_check_call(program, node, held, owner) }
    // One child buffer serves the whole descent: each node appends its children, walks them,
    // and gives the slots back, so a body is walked without a list per node.
    let base = kids.len()
    node_push_value_child_ids(node, kids)
    let end = kids.len()
    let mut i = base
    while i < end {
        let c = kids.get(i).unwrap()
        if k != NodeKind.HandlerExpr || node_kind(c) != NodeKind.FnDef {
            tc_er_walk(program, c, held, owner, kids)
        }
        i = i + 1
    }
    while kids.len() > base {
        let _ = kids.pop()
    }
}

fn tc_er_walk_fn(program: Int, fn_node: Int, kids: List[Int]) ! TypeCheck.Resolve, Diag.Report {
    // `main` holds every effect (§4.6).
    if node_name(fn_node) == "main" && node_source_module(fn_node) == "__main__" { return }
    tc_er_walk(program, node_body(fn_node), tc_er_fn_row(fn_node), node_name(fn_node), kids)
}

// `owners` is a list of impl or trait nodes; each one's methods are walked.
fn tc_er_walk_methods(program: Int, owners: Int, kids: List[Int]) ! TypeCheck.Resolve, Diag.Report {
    if owners == -1 { return }
    let mut i = 0
    while i < sublist_length(owners) {
        let ms = node_methods(sublist_get(owners, i))
        if ms != -1 {
            let mut j = 0
            while j < sublist_length(ms) {
                tc_er_walk_fn(program, sublist_get(ms, j), kids)
                j = j + 1
            }
        }
        i = i + 1
    }
}

// Test blocks are not walked: whether a test body holds every effect, as `main` does, is
// still open with the owner.
fn tc_check_effect_rows(program: Int) ! TypeCheck.Resolve, Diag.Report {
    let mut kids: List[Int] = []
    let fns = node_params(program)
    if fns != -1 {
        let mut i = 0
        while i < sublist_length(fns) {
            tc_er_walk_fn(program, sublist_get(fns, i), kids)
            i = i + 1
        }
    }
    tc_er_walk_methods(program, node_methods(program), kids)
    tc_er_walk_methods(program, node_arms(program), kids)
    // A derived body runs at the call site, and that call needs only the effect that declares
    // the operation, so the body holds that effect and nothing more.
    for op in effect_derived_ops(program) {
        match tc_ue_op_root.get(op) {
            Some(ed) => tc_er_walk(program, node_body(op), [tc_er_op_effect(ed, op)], "{node_name(ed)}.{node_name(op)}", kids)
            None => {}
        }
    }
}
