effect TypeCheck {
    effect Register
    effect Resolve
    effect Report
}

// typecheck.bl — Type representation, registries, and type checking
//
// Phase 0: Type registries — registers struct/enum/fn/trait types into pools
// Phase 1: Name resolution — walks function bodies checking identifiers resolve
// Phase 2: Expression type inference — infers types, checks compatibility
//
// The pipeline: lex → parse → typecheck → codegen

// ── Type kind constants ─────────────────────────────────────────────
let TK_INT = 0
let TK_FLOAT = 1
let TK_BOOL = 2
let TK_STR = 3
let TK_VOID = 4
let TK_LIST = 5
let TK_OPTION = 6
let TK_RESULT = 7
let TK_FN = 8
let TK_STRUCT = 9
let TK_ENUM = 10
let TK_TYPEVAR = 11
let TK_UNKNOWN = 12
let TK_CLOSURE = 13
let TK_ITERATOR = 14
let TK_HANDLE = 15
let TK_CHANNEL = 16
let TK_TUPLE = 17
let TK_MAP = 18
let TK_BYTES = 19
let TK_SET = 20
let TK_I8 = 21
let TK_I16 = 22
let TK_I32 = 23
let TK_U8 = 24
let TK_U16 = 25
let TK_U32 = 26
let TK_U64 = 27
let TK_CHAR = 28

// ── Type pool ───────────────────────────────────────────────────────
pub type TypePoolEntry {
    kind: Int
    name: Str
    inner1: Int
    inner2: Int
    params_start: Int
    params_count: Int
}
let mut ty_pool: List[TypePoolEntry] = []
let mut ty_param_list: List[Int] = []
// node id → tid memo. Populated during infer_type in check_types and left
// resident so generate() can consume structured tids instead of re-deriving
// them from string tags. -1 = not-yet-inferred / out of range. Reset in
// init_types alongside ty_pool so a tid can never outlive its pool.
let mut tc_node_tid: List[Int] = []

// ── Builtin type indices (populated by init_types) ──────────────────
let mut TYPE_INT: Int = -1
let mut TYPE_FLOAT: Int = -1
let mut TYPE_BOOL: Int = -1
let mut TYPE_STR: Int = -1
let mut TYPE_VOID: Int = -1
let mut TYPE_UNKNOWN: Int = -1
let mut TYPE_I8: Int = -1
let mut TYPE_I16: Int = -1
let mut TYPE_I32: Int = -1
let mut TYPE_U8: Int = -1
let mut TYPE_U16: Int = -1
let mut TYPE_U32: Int = -1
let mut TYPE_U64: Int = -1
let mut TYPE_CHAR: Int = -1

// ── Type registries ─────────────────────────────────────────────────
let mut named_type_names: List[Str] = []
let mut named_type_ids: List[Int] = []

type TcStructField {
    struct_id: Int
    name: Str
    type_id: Int
}
let mut sfield_pool: List[TcStructField] = []

type EnumVariantEntry {
    enum_id: Int
    name: Str
    tag: Int
    has_data: Int
}
let mut evar_pool: List[EnumVariantEntry] = []

type EnumVariantFieldEntry {
    var_idx: Int
    name: Str
    type_id: Int
}
let mut evfield_pool: List[EnumVariantFieldEntry] = []

let mut named_type_map: Map[Str, Int] = Map()
let mut fnsig_map: Map[Str, Int] = Map()
// Set of struct/enum names that carry @derive(Hash). Used to reject
// Map[K, V] at typecheck when K is a user type without the derive.
let mut tc_hashable_types: Map[Str, Int] = Map()

// Set of struct/enum names that carry @derive(Debug). Used to reject
// @derive(Debug) on a type whose field's user-type does not also derive Debug.
let mut tc_debug_types: Map[Str, Int] = Map()
// type name -> its declaration node, for field-derive validation spans.
let mut tc_type_decl_nodes: Map[Str, Int] = Map()

type FnSigEntry {
    name: Str
    ret: Int
    params_start: Int
    params_count: Int
    type_params_start: Int
    type_params_count: Int
    effects_start: Int
    effects_count: Int
}
let mut fnsig_pool: List[FnSigEntry] = []
let mut fnsig_param_list: List[Int] = []
let mut fnsig_type_param_names: List[Str] = []
let mut fnsig_effect_names: List[Str] = []

let mut tc_trait_names: List[Str] = []
let mut tc_trait_method_names: List[Str] = []
let mut tc_trait_assoc_names: List[Str] = []

// 4q2etk: replaced by mwxtyj — types with an `impl Display`, for which the
// compiler synthesizes a sealed `display() -> Str`.
let mut tc_display_impl_types: List[Str] = []

// sb3125 — typecheck-phase index of which traits define a given method for a
// given type. Built while walking impls (the codegen impl_entries registry is
// empty during typecheck). Drives both the trait-qualified fnsig key and the
// E0522 ambiguity check. tc_method_trait_count holds the distinct-trait count;
// tc_method_trait_names holds " and "-joined names for the diagnostic message.
// Both keyed "{type}\t{method}".
let mut tc_method_trait_count_idx: Map[Str, Int] = Map()
let mut tc_method_trait_names_idx: Map[Str, Str] = Map()
// wz48pq: trait-level type-param count keyed by trait NAME, populated in
// register_trait for EVERY trait (methodless or not). validate_trait_impls
// reads this for the E0910 arg-arity check; deriving it from tc_tmsig_pool
// (per-method sigs) missed methodless traits, which have no sig entry.
let mut tc_trait_tparam_count_idx: Map[Str, Int] = Map()

fn tc_method_traits_key(tname: Str, method: Str) -> Str {
    "{tname}\t{method}"
}

fn tc_record_method_trait(tname: Str, method: Str, trait_name: Str) {
    let key = tc_method_traits_key(tname, method)
    let prev_n = tc_method_trait_count_idx.get(key) ?? 0
    tc_method_trait_count_idx.insert(key, prev_n + 1)
    let prev_names = tc_method_trait_names_idx.get(key) ?? ""
    if prev_names == "" {
        tc_method_trait_names_idx.insert(key, trait_name)
    } else {
        tc_method_trait_names_idx.insert(key, "{prev_names} and {trait_name}")
    }
}

// Count of distinct traits defining `method` for `tname` (the synthesized
// sealed Display.display() is folded in at record time). >=2 ⇒ ambiguous.
fn tc_method_trait_count(tname: Str, method: Str) -> Int {
    tc_method_trait_count_idx.get(tc_method_traits_key(tname, method)) ?? 0
}

fn tc_method_trait_names(tname: Str, method: Str) -> Str {
    tc_method_trait_names_idx.get(tc_method_traits_key(tname, method)) ?? ""
}

// Typecheck-side mirror of codegen's mangle_impl_method: the fnsig key for an
// impl method. Must match the codegen C symbol exactly so arg-shape/return-type
// lookups resolve. From/TryFrom keep `{type}_{method}_{src}`; all other traits
// use the trait-qualified `{type}_{trait}_{method}`.
fn tc_mangle_impl_fnsig(impl_type: Str, trait_name: Str, mname: Str, im: Int) -> Str {
    if trait_name == "From" || trait_name == "TryFrom" {
        let tparams = node_type_params(im)
        if tparams != -1 && sublist_length(tparams) > 0 {
            let src = node_name(sublist_get(tparams, 0))
            return "{impl_type}_{mname}_{src}"
        }
    }
    "{impl_type}_{trait_name}_{mname}"
}

// vfgp72: does `tname` carry an Eq impl usable by the `==`/`!=` operators?
// Covers BOTH @derive(Eq)/@derive(Ord) (Ord: Eq) and a user `impl Eq for T`.
// The user-impl signal is the sb3125 trait→method index: an `impl Eq for T`
// records method `eq` under trait `Eq` for `T`.
fn tc_type_has_eq_impl(tname: Str) -> Int {
    let td = tc_type_decl_nodes.get(tname) ?? -1
    if td != -1 {
        if type_has_derive(td, "Eq") != 0 { return 1 }
        if type_has_derive(td, "Ord") != 0 { return 1 }
    }
    if tc_method_trait_names(tname, "eq").contains("Eq") != 0 { return 1 }
    0
}

// vfgp72: does `tname` carry an Ord impl usable by `<`/`>`/`<=`/`>=`?
// Covers @derive(Ord) and a user `impl Ord for T` (records `cmp` under `Ord`).
fn tc_type_has_ord_impl(tname: Str) -> Int {
    let td = tc_type_decl_nodes.get(tname) ?? -1
    if td != -1 {
        if type_has_derive(td, "Ord") != 0 { return 1 }
    }
    if tc_method_trait_names(tname, "cmp").contains("Ord") != 0 { return 1 }
    0
}

fn tc_type_has_display_impl(tname: Str) -> Int {
    let mut i = 0
    while i < tc_display_impl_types.len() {
        if tc_display_impl_types.get(i).unwrap() == tname { return 1 }
        i = i + 1
    }
    0
}

// mrwgz4: can `.{method}()` resolve on a KNOWN struct/enum type `tname`?
// Allowlist-style and biased FAIL-OPEN: every path that resolves at codegen
// must return 1 here, but any path we cannot model at typecheck also returns 1
// (the codegen E0505 backstop catches genuine misses). Returning 0 emits a hard
// typecheck error, so over-strictness would reject valid programs — including
// the compiler typechecking itself during `task regen`. When unsure: return 1.
fn tc_method_resolvable_on_type(obj_k: Int, tname: Str, method: Str) -> Int {
    // (a) user method + ALL trait-impl methods. Trait-impl methods register
    //     under the trait-qualified key `{T}_{trait}_{m}` (sb3125), so consult
    //     the method→traits index; a bare inherent fnsig `{T}_{m}` still counts.
    if tc_method_trait_count(tname, method) >= 1 { return 1 }
    if lookup_fnsig("{tname}_{method}") != -1 { return 1 }
    // (b) sealed synthesized Display.display() (no user fnsig).
    if method == "display" && tc_type_has_display_impl(tname) != 0 { return 1 }
    // (c) @derive-generated methods — query the annotation via the decl node.
    //     tc_type_decl_nodes covers BOTH structs (850) and enums (902).
    let td = tc_type_decl_nodes.get(tname) ?? -1
    if td != -1 {
        if method == "to_json"   && type_has_derive(td, "Serialize")   != 0 { return 1 }
        if method == "from_json" && type_has_derive(td, "Deserialize") != 0 { return 1 }
        if method == "eq"        && type_has_derive(td, "Eq")          != 0 { return 1 }
        // Ord: Eq (spec §3.6) — deriving Ord synthesizes both cmp and eq.
        if method == "eq"        && type_has_derive(td, "Ord")         != 0 { return 1 }
        if method == "cmp"       && type_has_derive(td, "Ord")         != 0 { return 1 }
        if method == "clone"     && type_has_derive(td, "Clone")       != 0 { return 1 }
        if method == "hash"      && type_has_derive(td, "Hash")        != 0 { return 1 }
        if method == "debug"     && type_has_derive(td, "Debug")       != 0 { return 1 }
    }
    // (c') str-backed enum intrinsics (to_str/from_str) are synthesized in
    //      codegen (codegen_stmt.bl:5983) and not modeled here → fail-open.
    if obj_k == TK_ENUM && (method == "to_str" || method == "from_str") { return 1 }
    // (d) closure-typed struct field invoked like a method. Closure fields lower
    //     to TK_TYPEVAR("Fn"), not a closure kind, so reuse the callable-field
    //     name registry (the same signal that suppresses W0501).
    if obj_k == TK_STRUCT && is_callable_field_name(method) != 0 { return 1 }
    // (e) trait/stdlib methods whose receiver-type resolution is not modeled at
    //     typecheck: `.into()` (From-trait auto-conversion), stdlib-type methods
    //     like `Instant.to_rfc3339()`, channel ops, etc. This is the SAME name
    //     allowlist that suppresses the W0501 name-only warning — reusing it keeps
    //     the hard E0505 and the soft W0501 consistent (no name warns-but-errors).
    //
    //     EXCLUDE `display`/`to_str`/`from_str`: those names live in is_builtin_method
    //     too, but on a struct/enum receiver they are SYNTHESIZED conditionally —
    //     `display` only with an `impl Display` (clause b), `to_str`/`from_str` only
    //     on enums (clause c'). Letting the name-only check resolve them would defeat
    //     the whole point: `.display()` on a type WITHOUT a Display impl must error
    //     here at typecheck (j2xxyd/mrwgz4), not fall open to the codegen backstop.
    if method != "display" && method != "to_str" && method != "from_str" {
        if is_builtin_method(method) != 0 { return 1 }
    }
    0
}

// E0514 helper (5q5jwz/wbf74w): does a type id have a usable Display impl?
// Returns 1 for builtin-scalar Display (Int/Float/Bool/Char/Str) or a user
// type with `impl Display`. Returns 0 for TK_UNKNOWN / TK_TYPEVAR so callers
// SKIP the check (Display is unknowable for unresolved/generic types).
fn tc_type_id_has_display(tid: Int) -> Int {
    let k = type_kind(tid)
    if k == TK_UNKNOWN || k == TK_TYPEVAR { return 0 }
    if k == TK_INT || k == TK_FLOAT || k == TK_BOOL || k == TK_CHAR || k == TK_STR { return 1 }
    // Sized integers are Display-able scalars — interpolation lowers them to
    // %lld/%llu just like Int (codegen_expr emit_interp_string CT_I8..CT_U64).
    if is_sized_int(k) != 0 { return 1 }
    // Tuples derive Display structurally when every element is Display (spec
    // §3.6); codegen renders them "(e0, e1, ...)". An empty tuple has nothing
    // non-Display, so it is trivially Display.
    if k == TK_TUPLE {
        let te = ty_pool.get(tid).unwrap()
        let mut i = 0
        while i < te.params_count {
            let et = ty_param_list.get(te.params_start + i).unwrap()
            let ek = type_kind(et)
            // Fail-open on unresolved/generic elements — unknowable, not absent.
            if ek != TK_UNKNOWN && ek != TK_TYPEVAR && tc_type_id_has_display(et) == 0 {
                return 0
            }
            i = i + 1
        }
        return 1
    }
    // Key the Display-impl lookup on the struct/enum BASE name, not type_to_str:
    // a monomorphized instance tid renders as "Box[Int]" but tc_display_impl_types
    // is keyed on the bare declared name "Box" (node_name(im) at registration).
    // Using type_to_str here would miss the impl for any generic struct value that
    // now carries an instance tid (br qw7v90 regression). strip_module_qualifier
    // mirrors the bare key form; for non-struct/enum kinds type_to_str already
    // returns the plain scalar name, so fall back to it.
    if k == TK_STRUCT || k == TK_ENUM {
        return tc_type_has_display_impl(strip_module_qualifier(ty_pool.get(tid).unwrap().name))
    }
    tc_type_has_display_impl(type_to_str(tid))
}

// Trait method signature registry (for contract validation)
type TraitMethodSigEntry {
    trait_name: Str
    method: Str
    ret: Str
    tparams_start: Int
    tparams_count: Int
    params_start: Int
    params_count: Int
}
let mut tc_tmsig_pool: List[TraitMethodSigEntry] = []
let mut tc_tmsig_param_names: List[Str] = []
let mut tc_trait_tparam_names: List[Str] = []

let mut tc_current_fn_ret: Int = -1
let mut tc_current_fn_name: Str = ""

let mut tc_errors: List[Str] = []
let mut tc_warnings: List[Str] = []

// ── Deprecation tracking ───────────────────────────────────────────
let mut depr_fn_nodes: Map[Str, Int] = Map()
let mut depr_type_nodes: Map[Str, Int] = Map()

// ── Kind A name-collision tracking (struct name == enum variant name) ──
// Decl nodes captured at registration so the E0518 diagnostic can point a
// primary span at the struct decl and a secondary span at the enum decl.
let mut tc_struct_decl_nodes: Map[Str, Int] = Map()
let mut tc_variant_enum_decl_nodes: Map[Str, Int] = Map()
// Dedupe so each colliding name is reported once, not per use site.
let mut tc_collision_reported: Map[Str, Int] = Map()

// Names of @ffi.struct types (consulted by is_valid_ptr_inner so Ptr[T] is allowed for them).
let mut ffi_struct_type_set: Map[Str, Int] = Map()

// Maps a type-alias name (e.g. `type Port = Int`) to its underlying type id.
// Consulted by types_compatible so refinement aliases stay compatible with their base type.
// Keyed by name (not type id) because type ids are pass-dependent across the dual codegen passes.
let mut tc_alias_underlying: Map[Str, Int] = Map()

// ── Import alias maps ──────────────────────────────────────────────
pub let mut tc_alias_to_original: Map[Str, Str] = Map()
let mut tc_original_to_alias: Map[Str, Str] = Map()

// ── Inferred type hints (for LSP inlayHint) ─────────────────────────
pub type HintEntry {
    line: Int
    col: Int
    name: Str
    type_str: Str
    module: Str
}
pub let mut tc_hints: List[HintEntry] = []

// ── Unused import tracking ──────────────────────────────────────────
let mut tc_symbol_module: Map[Str, Str] = Map()
let mut tc_used_modules: Map[Str, Int] = Map()

// Prelude modules (underscore form, e.g. "std_num") and the set of *free
// function* names they export. The prelude provides compiler-known
// types/traits/impls unconditionally (§10.6), but its free functions
// (list_map, parse_int, …) require an explicit import per §3.2.3 — they are
// filtered out of name-resolution scope (fsmwz2). compiler.bl seeds the module
// set via tc_set_prelude_modules before check_types.
let mut tc_prelude_modules: Map[Str, Int] = Map()
let mut tc_prelude_free_fn: Map[Str, Int] = Map()

// `mods` are module keys in underscore form ("std_num"), matching node_module
// / tc_symbol_module. compiler.bl's inject_prelude normalizes the dotted
// prelude paths before calling (dots_to_underscores lives there).
pub fn tc_set_prelude_modules(mods: List[Str]) {
    tc_prelude_modules.clear()
    let mut i = 0
    while i < mods.len() {
        tc_prelude_modules.insert(mods.get(i).unwrap(), 1)
        i = i + 1
    }
}

fn tc_mark_symbol_used(name: Str) {
    if nr_current_module != "" && nr_current_module != "__main__" { return }
    match tc_symbol_module.get(name) {
        Some(mod_name) => tc_used_modules.insert(mod_name, 1)
        None => {}
    }
}

// The dotted module a top-level symbol resolves to, or "" if unknown.
// Lets the unused-import check (compiler.bl) tell whether a selectively
// imported name is prelude-visible (yze3de).
pub fn tc_get_symbol_module(name: Str) -> Str {
    match tc_symbol_module.get(name) {
        Some(mod_name) => mod_name
        None => ""
    }
}

fn tc_mark_qualifier_used(qualifier: Str) {
    if nr_current_module != "" && nr_current_module != "__main__" { return }
    tc_used_modules.insert(qualifier, 1)
    match tc_qualifier_to_module.get(qualifier) {
        Some(mod_name) => tc_used_modules.insert(mod_name, 1)
        None => {}
    }
}

pub fn tc_is_module_used(mod_name: Str) -> Int {
    if tc_used_modules.contains_key(mod_name) {
        return 1
    }
    0
}

// ── Incremental filter ──────────────────────────────────────────────
// When enabled, only functions whose names appear in the filter set
// are typechecked. Used by the incremental recheck engine.

let mut tc_inc_enabled: Int = 0
let mut tc_inc_filter: Map[Str, Int] = Map()

// Set while the kvn6w8 off-path instance-tid producer re-resolves a struct's
// type-args (`Box[Map[Float,Int]]` → recurse into `Map[Float,Int]`). Before that
// producer existed, the struct branch of resolve_type_ann returned the bare tid
// WITHOUT visiting the args, so validate_map_key / validate_set_elem never ran on
// them. Those validators emit non-deduped E1400 diagnostics, so an un-suppressed
// re-resolution would emit a net-new MapKeyNotHashable the old compiler didn't —
// a byte-identity violation of typecheck decisions. The flag suppresses ONLY the
// hashability diagnostics during that off-path pass; tid-building is unaffected,
// so the captured instance tids are byte-identical either way. The live Map/Set
// annotation (a real `let m: Map[Float,Int]`) is resolved with the flag clear and
// still reports as before.
let mut tc_suppress_ann_validation: Int = 0

// ── Type creation ───────────────────────────────────────────────────

fn new_type(kind: Int, name: Str) -> Int {
    let idx = ty_pool.len()
    ty_pool.push(TypePoolEntry { kind: kind, name: name, inner1: -1, inner2: -1, params_start: -1, params_count: 0 })
    idx
}

fn make_list_type(inner: Int) -> Int {
    let t = new_type(TK_LIST, "List")
    let e = ty_pool.get(t).unwrap()
    ty_pool.set(t, TypePoolEntry { inner1: inner, ..e })
    t
}

fn make_option_type(inner: Int) -> Int {
    let t = new_type(TK_OPTION, "Option")
    let e = ty_pool.get(t).unwrap()
    ty_pool.set(t, TypePoolEntry { inner1: inner, ..e })
    t
}

fn make_result_type(ok_type: Int, err_type: Int) -> Int {
    let t = new_type(TK_RESULT, "Result")
    let e = ty_pool.get(t).unwrap()
    ty_pool.set(t, TypePoolEntry { inner1: ok_type, inner2: err_type, ..e })
    t
}

fn make_fn_type(ret_type: Int, param_types: List[Int]) -> Int {
    let t = new_type(TK_FN, "Fn")
    let start = ty_param_list.len()
    let mut i = 0
    while i < param_types.len() {
        ty_param_list.push(param_types.get(i).unwrap())
        i = i + 1
    }
    let e = ty_pool.get(t).unwrap()
    ty_pool.set(t, TypePoolEntry { inner1: ret_type, params_start: start, params_count: param_types.len(), ..e })
    t
}

fn make_typevar(name: Str) -> Int {
    new_type(TK_TYPEVAR, name)
}

fn make_tuple_type(elem_types: List[Int]) -> Int {
    let t = new_type(TK_TUPLE, "Tuple")
    let start = ty_param_list.len()
    let mut i = 0
    while i < elem_types.len() {
        ty_param_list.push(elem_types.get(i).unwrap())
        i = i + 1
    }
    let e = ty_pool.get(t).unwrap()
    ty_pool.set(t, TypePoolEntry { params_start: start, params_count: elem_types.len(), ..e })
    t
}

// A monomorphized struct instance (`Box[Int]`): a fresh TK_STRUCT entry named
// after the generic base, with its concrete type-args stored variadically in
// ty_param_list[params_start .. +params_count] — exactly how make_tuple_type /
// make_fn_type store their element/param tids. The generic base declared by a
// `type Box[T] { .. }` keeps params_count=0; an instance carries params_count>=1.
// This is the tid-pool representation decisions/compiler-type-representation.md
// Q2 (5-0) mandates to close the "concrete inner lives only in codegen's string
// mono registry" split. Foundation-only (br kvn6w8 spike): produced OFF-PATH
// (memoized onto the annotation node's tc_node_tid slot) and read solely by the
// tc_tid_struct_arg_* accessors — no emit reader consumes it yet, so it does not
// intern (mirrors make_tuple_type: fresh entry per call) and stays byte-identical.
fn make_struct_instance_type(base_name: Str, arg_types: List[Int]) -> Int {
    let t = new_type(TK_STRUCT, base_name)
    let start = ty_param_list.len()
    let mut i = 0
    while i < arg_types.len() {
        ty_param_list.push(arg_types.get(i).unwrap())
        i = i + 1
    }
    let e = ty_pool.get(t).unwrap()
    ty_pool.set(t, TypePoolEntry { params_start: start, params_count: arg_types.len(), ..e })
    t
}


fn make_map_type(key_type: Int, value_type: Int) -> Int {
    let t = new_type(TK_MAP, "Map")
    let e = ty_pool.get(t).unwrap()
    ty_pool.set(t, TypePoolEntry { inner1: key_type, inner2: value_type, ..e })
    t
}

fn make_set_type(elem_type: Int) -> Int {
    let t = new_type(TK_SET, "Set")
    let e = ty_pool.get(t).unwrap()
    ty_pool.set(t, TypePoolEntry { inner1: elem_type, ..e })
    t
}

// ── Type lookup ─────────────────────────────────────────────────────

fn lookup_named_type(name: Str) -> Int {
    match named_type_map.get(name) {
        Some(v) => return v
        None => {}
    }
    let dot = name.index_of(".")
    if dot >= 0 {
        let bare = name.slice(dot + 1, name.len())
        let resolved = tc_alias_to_original.get(bare) ?? bare
        match named_type_map.get(resolved) {
            Some(v) => return v
            None => {}
        }
        match named_type_map.get(bare) {
            Some(v) => return v
            None => {}
        }
    }
    -1
}

fn resolve_type_name(name: Str) -> Int ! TypeCheck.Resolve {
    if name == "Int" { return TYPE_INT }
    if name == "Float" { return TYPE_FLOAT }
    if name == "Bool" { return TYPE_BOOL }
    if name == "Str" { return TYPE_STR }
    if name == "Void" || name == "" { return TYPE_VOID }
    if name == "I8" { return TYPE_I8 }
    if name == "I16" { return TYPE_I16 }
    if name == "I32" { return TYPE_I32 }
    if name == "I64" { return TYPE_INT }
    if name == "U8" { return TYPE_U8 }
    if name == "U16" { return TYPE_U16 }
    if name == "U32" { return TYPE_U32 }
    if name == "U64" { return TYPE_U64 }
    if name == "Char" { return TYPE_CHAR }
    lookup_named_type(name)
}

fn get_struct_field_tid(struct_tid: Int, fname: Str) -> Int {
    // Field entries are registered against the BASE declaration tid (register_
    // struct_type). A monomorphized instance tid (Box[Int], a fresh entry sharing
    // the base name — br qw7v90) must normalize back to that base before matching,
    // or field lookups on any instance-typed value return -1. tc_struct_base_tid
    // is a no-op for a bare tid.
    let base = tc_struct_base_tid(struct_tid)
    let mut i = 0
    while i < sfield_pool.len() {
        let sf = sfield_pool.get(i).unwrap()
        if sf.struct_id == base && sf.name == fname {
            return sf.type_id
        }
        i = i + 1
    }
    -1
}

// Normalize a possibly-monomorphized struct instance tid (Box[Int]) to its base
// declaration tid (Box), by name (br qw7v90). Any consumer that maps a struct tid
// back to declaration-level data keyed on the base tid (fields; anything using
// sf.struct_id) must normalize first. A bare tid, a non-struct tid, or an
// unresolvable name returns the input unchanged.
fn tc_struct_base_tid(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return tid }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TK_STRUCT { return tid }
    if t.params_count == 0 { return tid }
    let base = lookup_named_type(strip_module_qualifier(t.name))
    if base == -1 { return tid }
    base
}

fn get_variant_by_name(enum_tid: Int, vname: Str) -> Int {
    let mut i = 0
    while i < evar_pool.len() {
        let ev = evar_pool.get(i).unwrap()
        if ev.enum_id == enum_tid && ev.name == vname {
            return i
        }
        i = i + 1
    }
    -1
}

fn lookup_evfield_type_by_index(var_idx: Int, idx: Int) -> Int {
    let mut i = 0
    let mut seen = 0
    while i < evfield_pool.len() {
        let ef = evfield_pool.get(i).unwrap()
        if ef.var_idx == var_idx {
            if seen == idx { return ef.type_id }
            seen = seen + 1
        }
        i = i + 1
    }
    -1
}

fn lookup_evfield_type_by_name(var_idx: Int, name: Str) -> Int {
    let mut i = 0
    while i < evfield_pool.len() {
        let ef = evfield_pool.get(i).unwrap()
        if ef.var_idx == var_idx && ef.name == name {
            return ef.type_id
        }
        i = i + 1
    }
    -1
}

fn lookup_fnsig(name: Str) -> Int {
    if nr_current_module != "" {
        let qualified = "{nr_current_module}:{name}"
        match fnsig_map.get(qualified) {
            Some(v) => return v
            None => {}
        }
    }
    fnsig_map.get(name) ?? -1
}

// Recursively substitute typevar tids in `t` using the name→tid map `binds`
// (typevar-name → concrete tid). Mirrors types_compatible's structural dispatch
// and rebuilds compound shells via the make_* constructors so the returned tid
// carries concrete elements. A kind with no embedded typevar — or an unbound
// typevar — is returned unchanged; a new pool entry is allocated only when a
// child actually changes (avoids ty_pool churn).
fn substitute_typevar_tid(t: Int, binds: Map[Str, Int]) -> Int {
    if t < 0 || t >= ty_pool.len() { return t }
    let e = ty_pool.get(t).unwrap()
    let k = e.kind
    if k == TK_TYPEVAR {
        match binds.get(e.name) {
            Some(tid) => return tid
            None => return t
        }
    }
    if k == TK_LIST {
        let inner = substitute_typevar_tid(e.inner1, binds)
        if inner == e.inner1 { return t }
        return make_list_type(inner)
    }
    if k == TK_OPTION {
        let inner = substitute_typevar_tid(e.inner1, binds)
        if inner == e.inner1 { return t }
        return make_option_type(inner)
    }
    if k == TK_SET {
        let inner = substitute_typevar_tid(e.inner1, binds)
        if inner == e.inner1 { return t }
        return make_set_type(inner)
    }
    if k == TK_RESULT {
        let ok = substitute_typevar_tid(e.inner1, binds)
        let er = substitute_typevar_tid(e.inner2, binds)
        if ok == e.inner1 && er == e.inner2 { return t }
        return make_result_type(ok, er)
    }
    if k == TK_MAP {
        let kk = substitute_typevar_tid(e.inner1, binds)
        let vv = substitute_typevar_tid(e.inner2, binds)
        if kk == e.inner1 && vv == e.inner2 { return t }
        return make_map_type(kk, vv)
    }
    if k == TK_TUPLE {
        // Read every original element into `elems` BEFORE calling make_tuple_type:
        // the constructor appends to ty_param_list, the same array we read
        // e.params_start.. from, so finishing the read first avoids aliasing.
        let mut elems: List[Int] = []
        let mut changed = 0
        let mut i = 0
        while i < e.params_count {
            let orig = ty_param_list.get(e.params_start + i).unwrap()
            let sub = substitute_typevar_tid(orig, binds)
            if sub != orig { changed = 1 }
            elems.push(sub)
            i = i + 1
        }
        if changed == 0 { return t }
        return make_tuple_type(elems)
    }
    if k == TK_STRUCT {
        // A monomorphized struct instance (`Box[T]`, params_count>=1) may embed a
        // typevar in a type-arg; substitute each and rebuild via make_struct_
        // instance_type. Same aliasing guard as TK_TUPLE: make_struct_instance_type
        // appends to ty_param_list (the array we read e.params_start.. from), so
        // finish the read into `elems` FIRST. The bare generic base (params_count 0)
        // has no type-args — the loop is empty, changed stays 0, `t` returns as-is.
        let mut elems: List[Int] = []
        let mut changed = 0
        let mut i = 0
        while i < e.params_count {
            let orig = ty_param_list.get(e.params_start + i).unwrap()
            let sub = substitute_typevar_tid(orig, binds)
            if sub != orig { changed = 1 }
            elems.push(sub)
            i = i + 1
        }
        if changed == 0 { return t }
        return make_struct_instance_type(e.name, elems)
    }
    // TK_FN and every scalar/nominal kind: no embedded typevar to rewrite.
    t
}

// Structurally unify a param tid against a concrete arg tid, recording every
// typevar→concrete binding into `binds`. The reverse of substitute_typevar_tid:
// where that walks one tid rewriting typevars via `binds`, this walks the param
// and arg tids in lockstep and *discovers* the bindings. A bare typevar param
// binds directly; a compound param recurses into the matching children so a
// typevar buried inside `List[T]` / `Option[T]` / `Set[T]` / `Result[T,E]` /
// `Map[K,V]` / `(A, B)` is still inferred. Pure bind collection — allocates NO
// pool entries (no make_* calls), so it never touches ty_param_list and is free
// of the tuple aliasing hazard substitute_typevar_tid guards against. A first
// binding wins; kind mismatches (arg not shaped like the param) bind nothing.
fn unify_typevar_binds(ptid: Int, atid: Int, binds: Map[Str, Int]) {
    if ptid < 0 || ptid >= ty_pool.len() { return }
    if atid < 0 || atid >= ty_pool.len() { return }
    let pe = ty_pool.get(ptid).unwrap()
    let pk = pe.kind
    if pk == TK_TYPEVAR {
        if !binds.contains_key(pe.name) {
            binds.insert(pe.name, atid)
        }
        return
    }
    let ae = ty_pool.get(atid).unwrap()
    if ae.kind != pk { return }
    if pk == TK_LIST || pk == TK_OPTION || pk == TK_SET {
        unify_typevar_binds(pe.inner1, ae.inner1, binds)
        return
    }
    if pk == TK_RESULT || pk == TK_MAP {
        unify_typevar_binds(pe.inner1, ae.inner1, binds)
        unify_typevar_binds(pe.inner2, ae.inner2, binds)
        return
    }
    if pk == TK_TUPLE {
        if pe.params_count != ae.params_count { return }
        let mut i = 0
        while i < pe.params_count {
            let pc = ty_param_list.get(pe.params_start + i).unwrap()
            let ac = ty_param_list.get(ae.params_start + i).unwrap()
            unify_typevar_binds(pc, ac, binds)
            i = i + 1
        }
        return
    }
    if pk == TK_STRUCT {
        // A generic struct param (`b: Box[T]`) binds its typevars from a struct-
        // instance arg (`Box[Int]`). Structs are nominal — the base names must match
        // (module-qualifier-stripped) as well as the arity, unlike the structural
        // tuple case above. Walk the type-args in lockstep. A bare generic base (no
        // args, params_count 0) has nothing to bind and the loop is empty.
        if strip_module_qualifier(pe.name) != strip_module_qualifier(ae.name) { return }
        if pe.params_count != ae.params_count { return }
        let mut i = 0
        while i < pe.params_count {
            let pc = ty_param_list.get(pe.params_start + i).unwrap()
            let ac = ty_param_list.get(ae.params_start + i).unwrap()
            unify_typevar_binds(pc, ac, binds)
            i = i + 1
        }
        return
    }
}

// Build a typevar-name → concrete-tid map from the call's args by structurally
// unifying each param tid against its argument's inferred tid. Covers both the
// whole-bare-typevar rule (`x: T`) and typevars nested inside a compound param
// (`x: List[T]`, `x: (T, Int)`, `x: Map[K, V]`, …) via unify_typevar_binds.
fn build_typevar_binds(sig: Int, args_sl: Int) -> Map[Str, Int] ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let fs = fnsig_pool.get(sig).unwrap()
    let param_start = fs.params_start
    let param_count = fs.params_count
    let mut binds: Map[Str, Int] = Map()
    if args_sl == -1 { return binds }
    let n = sublist_length(args_sl)
    let mut pi = 0
    while pi < param_count {
        if pi < n {
            let ptid = fnsig_param_list.get(param_start + pi).unwrap()
            unify_typevar_binds(ptid, infer_type(sublist_get(args_sl, pi)), binds)
        }
        pi = pi + 1
    }
    binds
}

fn instantiate_return_type(sig: Int, args_sl: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let fs = fnsig_pool.get(sig).unwrap()
    let ret = fs.ret
    if ret < 0 || ret >= ty_pool.len() { return ret }
    let binds = build_typevar_binds(sig, args_sl)
    substitute_typevar_tid(ret, binds)
}

// Parse an all-digits field name ("0", "12") to its Int index, or -1 for any
// non-numeric name (so struct field accesses never match the tuple path).
fn str_to_tuple_index(name: Str) -> Int {
    if name.len() == 0 { return -1 }
    let mut acc = 0
    let mut i = 0
    while i < name.len() {
        let ch = name.byte_at(i)
        if ch < 48 || ch > 57 { return -1 }
        acc = acc * 10 + (ch - 48)
        i = i + 1
    }
    acc
}

fn is_int_literal_node(node: Int) -> Int {
    if node_kind(node) == NodeKind.IntLit { return 1 }
    if node_kind(node) == NodeKind.UnaryOp && node_op(node) == "-" {
        let operand = node_left(node)
        if operand != -1 && node_kind(operand) == NodeKind.IntLit { return 1 }
    }
    0
}

// Validate call args against a fnsig's param types (type only, no arity).
// `self_offset` skips leading implicit params: 0 for free functions, 1 for
// methods whose fnsig carries `self` as param 0 (so explicit arg `i` aligns to
// fnsig param `i + self_offset`). Params typed TYPE_UNKNOWN are skipped.
// Genuinely saves/restores tc_construct_hint around infer_type; infer_type also
// writes cumulative inference state that is intended to persist, not roll back.
@allow(UnrestoredMutation)
fn check_arg_shapes(fn_name: Str, sig: Int, args_sl: Int, self_offset: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if args_sl == -1 { return }
    let fs = fnsig_pool.get(sig).unwrap()
    let param_start = fs.params_start
    let param_count = fs.params_count
    let n = sublist_length(args_sl)
    let mut i = 0
    while i < n {
        let pidx = i + self_offset
        if pidx < param_count {
            let ptid = fnsig_param_list.get(param_start + pidx).unwrap()
            if ptid != TYPE_UNKNOWN {
                let arg_node = sublist_get(args_sl, i)
                let saved_hint = tc_construct_hint
                tc_construct_hint = resolve_alias_tid(ptid)
                let arg_t = infer_type(arg_node)
                tc_construct_hint = saved_hint
                let mut lit_to_int = 0
                if is_int_literal_node(arg_node) != 0 && is_integer_type(resolve_alias_tid(ptid)) != 0 {
                    lit_to_int = 1
                }
                if lit_to_int == 0 && types_compatible(arg_t, ptid) == 0 {
                    tc_error_at("argument {i + 1} of '{fn_name}' expects {type_to_str(ptid)}, got {type_to_str(arg_t)}", arg_node)
                }
            }
        }
        i = i + 1
    }
}

// Validate a single already-unwrapped argument value against an expected type,
// applying the construction hint + int-literal coercion escape, and emit the
// shared "argument N of 'LABEL' expects X, got Y" diagnostic on mismatch. Shared
// by check_builtin_arg and the qualified-variant-construction guard (8v0cpr).
// Genuinely saves/restores tc_construct_hint around infer_type; infer_type also
// writes cumulative inference state that is intended to persist, not roll back.
@allow(UnrestoredMutation)
fn check_arg_value(label: Str, arg_idx: Int, expected_t: Int, value_node: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if expected_t == TYPE_UNKNOWN { return }
    let saved_hint = tc_construct_hint
    tc_construct_hint = resolve_alias_tid(expected_t)
    let arg_t = infer_type(value_node)
    tc_construct_hint = saved_hint
    let mut lit_to_int = 0
    if is_int_literal_node(value_node) != 0 && is_integer_type(resolve_alias_tid(expected_t)) != 0 {
        lit_to_int = 1
    }
    if lit_to_int == 0 && types_compatible(arg_t, expected_t) == 0 {
        tc_error_at("argument {arg_idx + 1} of '{label}' expects {type_to_str(expected_t)}, got {type_to_str(arg_t)}", value_node)
    }
}

// Validate a single argument to a built-in intrinsic method (List/Set/Str/Map).
// These methods are pure codegen intrinsics with no fnsig backing, so we cannot
// reuse check_arg_shapes; we validate inline against the container's elem/key type.
// DEFERRED (need closure-signature checking): List.map/filter/find/fold/for_each/
// any/all and Bytes.with_ptr. Bytes integer-arg methods also deferred.
fn check_builtin_arg(method: Str, arg_idx: Int, expected_t: Int, args_sl: Int, container_label: Str) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if args_sl == -1 { return }
    if arg_idx >= sublist_length(args_sl) { return }
    check_arg_value("{container_label}.{method}", arg_idx, expected_t, sublist_get(args_sl, arg_idx))
}

// The closure argument at `idx`, or -1 if absent. The closure validators below
// tolerate -1 (they no-op on a non-Closure node), so call sites need no guard.
fn closure_arg_at(args_sl: Int, idx: Int) -> Int {
    if args_sl == -1 || idx >= sublist_length(args_sl) { return -1 }
    sublist_get(args_sl, idx)
}

// Validate one explicitly-annotated closure parameter against the type the HOF
// expects there (derived from the container element type). Unannotated params
// (TYPE_UNKNOWN) and unknown expected types are skipped — annotation validation
// only, no inference (that is gkr3fs Part B).
fn check_closure_param(closure_node: Int, param_idx: Int, expected_t: Int, method: Str, container_label: Str) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if expected_t == TYPE_UNKNOWN { return }
    if closure_node == -1 || node_kind(closure_node) != NodeKind.Closure { return }
    let params_sl = node_params(closure_node)
    if params_sl == -1 || param_idx >= sublist_length(params_sl) { return }
    let p = sublist_get(params_sl, param_idx)
    let ptid = resolve_param_type(p)
    if ptid == TYPE_UNKNOWN { return }
    if types_compatible(ptid, expected_t) == 0 {
        tc_error_at("closure parameter {param_idx + 1} of '{container_label}.{method}' expects {type_to_str(expected_t)}, got {type_to_str(ptid)}", p)
    }
}

// Validate an explicitly-annotated closure return type against the type the HOF
// requires (e.g. Bool for filter/any/all). Skipped when the closure has no
// declared return or the expected type is unknown.
fn check_closure_ret(closure_node: Int, expected_ret: Int, method: Str, container_label: Str) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if expected_ret == TYPE_UNKNOWN { return }
    if closure_node == -1 || node_kind(closure_node) != NodeKind.Closure { return }
    let ret_str = node_return_type(closure_node)
    if ret_str == "" { return }
    let rt = resolve_type_name(ret_str)
    if rt == -1 { return }
    if types_compatible(rt, expected_ret) == 0 {
        tc_error_at("closure of '{container_label}.{method}' must return {type_to_str(expected_ret)}, got {type_to_str(rt)}", closure_node)
    }
}

// List HOFs whose closure takes a single element-typed param. `fold` is handled
// separately (its closure takes accumulator + element).
fn is_elem_closure_hof(method: Str) -> Int {
    method == "map" || method == "filter" || method == "for_each" || method == "any" || method == "all" || method == "find"
}

// gkr3fs Part B — type-check the BODY of a closure with params bound to the types
// the HOF supplies (`p0_t`/`p1_t`, -1 = absent). Unannotated params would otherwise
// bind to TYPE_UNKNOWN, so a wrong body (e.g. `Str` param used as `Int`) leaks past
// typecheck to the C compiler. When a param IS explicitly annotated we bind the
// declared type instead — this preserves Part A's annotation validation and never
// contradicts it. Walks the body exactly once via tc_check_body, mirroring its own
// Closure handler's scope dance.
fn check_closure_body(cls: Int, p0_t: Int, p1_t: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if cls == -1 || node_kind(cls) != NodeKind.Closure { return }
    nr_push_scope()
    let params_sl = node_params(cls)
    if params_sl != -1 {
        let nparams = sublist_length(params_sl)
        if nparams >= 1 {
            let p0 = sublist_get(params_sl, 0)
            let decl0 = resolve_param_type(p0)
            let bind0 = if decl0 != TYPE_UNKNOWN { decl0 } else { p0_t }
            nr_define_typed(node_name(p0), 0, bind0)
        }
        if nparams >= 2 {
            let p1 = sublist_get(params_sl, 1)
            let decl1 = resolve_param_type(p1)
            let bind1 = if decl1 != TYPE_UNKNOWN { decl1 } else { p1_t }
            nr_define_typed(node_name(p1), 0, bind1)
        }
    }
    tc_check_body(node_body(cls))
    nr_pop_scope()
}

// ── Error reporting ─────────────────────────────────────────────────

fn tc_error(msg: Str) ! TypeCheck.Report, Diag.Report {
    tc_errors.push(msg)
    diag_error_no_loc("TypeError", TYPE_ERROR, msg, "")
}

fn tc_error_at(msg: Str, node_id: Int) ! TypeCheck.Report, Diag.Report {
    tc_errors.push(msg)
    diag_error_at("TypeError", TYPE_ERROR, msg, node_id, "")
}

fn tc_warn(msg: Str) ! TypeCheck.Report {
    tc_warnings.push(msg)
}

// ── Incremental filter API ──────────────────────────────────────────

pub fn tc_set_incremental_filter(names: List[Str]) {
    tc_inc_filter = Map()
    let mut i = 0
    while i < names.len() {
        tc_inc_filter.insert(names.get(i).unwrap(), 1)
        i = i + 1
    }
    tc_inc_enabled = 1
}

pub fn tc_clear_incremental_filter() {
    tc_inc_filter = Map()
    tc_inc_enabled = 0
}

fn tc_should_check_fn(name: Str) -> Int {
    if tc_inc_enabled == 0 {
        return 1
    }
    tc_inc_filter.contains_key(name)
}

// ── Type annotation resolution ──────────────────────────────────────

fn resolve_type_ann(ann_node: Int) -> Int ! TypeCheck.Resolve, Diag.Report {
    if ann_node == -1 {
        return TYPE_UNKNOWN
    }
    let name = node_name(ann_node)
    let elems_sl = node_elements(ann_node)

    if name == "List" {
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            let inner = resolve_type_ann(sublist_get(elems_sl, 0))
            return make_list_type(inner)
        }
        return make_list_type(TYPE_UNKNOWN)
    }
    if name == "Option" {
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            let inner = resolve_type_ann(sublist_get(elems_sl, 0))
            return make_option_type(inner)
        }
        return make_option_type(TYPE_UNKNOWN)
    }
    if name == "Result" {
        if elems_sl != -1 && sublist_length(elems_sl) >= 2 {
            let ok_t = resolve_type_ann(sublist_get(elems_sl, 0))
            let err_t = resolve_type_ann(sublist_get(elems_sl, 1))
            return make_result_type(ok_t, err_t)
        }
        return make_result_type(TYPE_UNKNOWN, TYPE_UNKNOWN)
    }
    if name == "Map" {
        if elems_sl != -1 && sublist_length(elems_sl) >= 2 {
            let key_ann = sublist_get(elems_sl, 0)
            let key_t = resolve_type_ann(key_ann)
            let val_t = resolve_type_ann(sublist_get(elems_sl, 1))
            if tc_suppress_ann_validation == 0 { validate_map_key(key_ann) }
            return make_map_type(key_t, val_t)
        }
        return make_map_type(TYPE_UNKNOWN, TYPE_UNKNOWN)
    }
    if name == "Set" {
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            let elem_ann = sublist_get(elems_sl, 0)
            let elem_t = resolve_type_ann(elem_ann)
            if tc_suppress_ann_validation == 0 { validate_set_elem(elem_ann) }
            return make_set_type(elem_t)
        }
        return make_set_type(TYPE_UNKNOWN)
    }
    if name == "Tuple" {
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            let mut elem_types: List[Int] = []
            let mut i = 0
            while i < sublist_length(elems_sl) {
                elem_types.push(resolve_type_ann(sublist_get(elems_sl, i)))
                i = i + 1
            }
            return make_tuple_type(elem_types)
        }
    }
    if name == "Bytes" {
        return new_type(TK_BYTES, "Bytes")
    }

    let resolved = resolve_type_name(name)
    if resolved != -1 {
        // A user struct named with concrete type-args (`Box[Int]`) resolves to the
        // structured instance tid on the LIVE path (br qw7v90, increment B): the
        // annotation side must carry the specialization so a concrete param/let
        // type (Box[Int]) compares by name+params against a reverse-inferred
        // literal (Box[Str]) — the two must be able to mismatch. Consumers that map
        // a struct tid back to its declaration (fields, derives) normalize
        // instance→base by name, so the fresh instance entry is safe. The instance
        // is still memoized onto the annotation node's tc_node_tid slot for the
        // tc_tid_struct_arg_* accessors. Falls back to the bare tid when no concrete
        // arg is present (all-typevar `Box[T]`).
        if type_kind(resolved) == TK_STRUCT && elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            let inst = tc_produce_struct_instance_tid(ann_node, name, elems_sl)
            if inst != -1 { return inst }
        }
        return resolved
    }

    make_typevar(name)
}

// OFF-PATH monomorphized-struct-instance producer (br kvn6w8 spike). Called only
// when resolve_type_ann sees a user struct named with concrete type-args
// (`Box[Int]`). resolve_type_ann's live return stays the bare generic tid; this
// builds the structured instance tid and memoizes it onto the annotation node's
// tc_node_tid slot for the tc_tid_struct_arg_* accessors to read. Byte-identical:
// annotation nodes never reach infer_type, so this slot is otherwise -1, and no
// emit/typecheck reader consumes an annotation-node tid (the mono CSV path reads
// ARG-EXPRESSION node tids only). Skipped when every arg is a typevar (a generic
// `Box[T]`): inference variables must not be interned
// (compiler-type-representation.md:47), and an all-typevar instance carries no
// more information than the bare tid.
//
// tc_suppress_ann_validation is raised over the arg re-resolution: this recursion
// is net-new work the live struct path never did, and resolve_type_ann's Map/Set
// branches emit non-deduped E1400 hashability diagnostics — suppressing them keeps
// the pass byte-identical while leaving tid-building intact. Kept in its own fn
// (not inlined into resolve_type_ann) so the save/restore idiom does not make the
// effect analyzer flag resolve_type_ann's other unguarded mutating calls.
fn tc_produce_struct_instance_tid(ann_node: Int, name: Str, elems_sl: Int) -> Int ! TypeCheck.Resolve, Diag.Report {
    let saved_suppress = tc_suppress_ann_validation
    tc_suppress_ann_validation = 1
    let mut arg_tids: List[Int] = []
    let mut has_concrete = 0
    let mut ai = 0
    while ai < sublist_length(elems_sl) {
        let arg_t = resolve_type_ann(sublist_get(elems_sl, ai))
        if type_kind(arg_t) != TK_TYPEVAR { has_concrete = 1 }
        arg_tids.push(arg_t)
        ai = ai + 1
    }
    tc_suppress_ann_validation = saved_suppress
    if has_concrete != 0 {
        let inst = make_struct_instance_type(name, arg_tids)
        if ann_node < tc_node_tid.len() {
            tc_node_tid.set(ann_node, inst)
        }
        return inst
    }
    -1
}

// A generic FN PARAM annotation (`b: Box[T]`) must intern as a STRUCTURAL instance
// tid carrying its type-arg slots — even when every slot is a typevar — so
// unify_typevar_binds' TK_STRUCT arm (which walks param/arg slots in lockstep) can
// discover T from a `Box[Box[Int]]` argument (br 8wyq1k). This is the deliberate
// EXCEPTION to tc_produce_struct_instance_tid's all-typevar skip: that skip guards
// the annotation/inference HOT path (an all-typevar instance there carries no more
// info than the bare tid and would only churn the pool). A fn-param annotation is
// resolved ONCE at register_fn_sig — not hot — and the typevar slots are exactly
// what the binder needs. Without the slots the fnsig param collapses to the bare
// `Box` (params_count 0), the arity check in unify_typevar_binds fails, and a
// bare-typevar return `-> T` bound to a struct instance stays unsubstituted →
// codegen types the result `void`.
//
// Safe for check_arg_shapes: types_compatible treats a typevar slot as compatible
// with anything (TK_TYPEVAR short-circuit + the element-wise struct-slot compare),
// so `Box[Box[Int]]` still matches the `Box[T]` param. Returns -1 (caller keeps the
// bare tid) unless the annotation is a generic user-struct with type-args.
//
// The make_struct_instance_type write to ty_pool/ty_param_list is INTENTIONAL (the
// interned instance is the return value), not speculative — the save/restore here
// covers only tc_suppress_ann_validation, so the mutation-analyzer flag is expected.
@allow(UnrestoredMutation)
fn tc_fnsig_param_instance_tid(ann_node: Int, bare_tid: Int) -> Int ! TypeCheck.Resolve, Diag.Report {
    if type_kind(bare_tid) != TK_STRUCT { return -1 }
    let elems_sl = node_elements(ann_node)
    if elems_sl == -1 || sublist_length(elems_sl) < 1 { return -1 }
    let saved_suppress = tc_suppress_ann_validation
    tc_suppress_ann_validation = 1
    let mut arg_tids: List[Int] = []
    let mut ai = 0
    while ai < sublist_length(elems_sl) {
        arg_tids.push(resolve_type_ann(sublist_get(elems_sl, ai)))
        ai = ai + 1
    }
    tc_suppress_ann_validation = saved_suppress
    make_struct_instance_type(strip_module_qualifier(node_name(ann_node)), arg_tids)
}

// LIVE reverse-inference of a struct literal's concrete instance tid (br qw7v90,
// increment B of the codegen-structured-tids epic). Given the bare generic tid
// (`Box`) and the StructLit node, unify each declared generic field type (which
// holds TK_TYPEVAR for a generic field, e.g. Box.value: T) against the inferred
// type of the corresponding literal field VALUE, collecting typevar→concrete
// binds. If at least one type-param binds to a concrete (non-typevar) type, build
// the structured instance tid (make_struct_instance_type, args in the decl's
// type-param order) and return it; otherwise fall back to the bare `stid`.
//
// Fallback (bare) is the correct answer when the literal carries no concrete
// information: an all-typevar field, or an empty-collection field (`Box { value:
// Map() }`) whose value infers Map[?,?] with no reachable concrete inner. The
// instance tid meeting the bare tid stays compatible (types_compatible bare~any),
// so returning bare never causes a spurious mismatch — it only forgoes the
// stronger check when nothing is knowable, exactly like the annotation side.
//
// A missing decl node (should not happen for a resolved struct) or a non-generic
// struct (no type params) short-circuits to bare — no instance is minted for a
// monomorphic struct, keeping the pool free of redundant entries.
fn tc_struct_lit_instance_tid(stid: Int, sname: Str, node: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let bare = strip_module_qualifier(sname)
    let decl = tc_struct_decl_nodes.get(bare) ?? -1
    if decl == -1 { return stid }
    let tparams_sl = node_type_params(decl)
    if tparams_sl == -1 || sublist_length(tparams_sl) == 0 { return stid }
    let flds_sl = node_fields(node)
    if flds_sl == -1 { return stid }
    let mut binds: Map[Str, Int] = Map()
    let mut fi = 0
    while fi < sublist_length(flds_sl) {
        let f = sublist_get(flds_sl, fi)
        let fname = node_name(f)
        let declared = get_struct_field_tid(stid, fname)
        if declared != -1 {
            unify_typevar_binds(declared, infer_type(node_value(f)), binds)
        }
        fi = fi + 1
    }
    // Decide whether any type-param bound to a concrete type BEFORE building the
    // arg list, so the no-concrete fallback does not mint throwaway pool entries on
    // the hot inference path — it returns the bare tid untouched. "Concrete" here
    // excludes BOTH a typevar AND TYPE_UNKNOWN: an empty `Map()`/`Set()` field binds
    // its param to TYPE_UNKNOWN (make_map_type(TYPE_UNKNOWN,..)), and an instance
    // whose args are all unknown carries no more information than the bare tid.
    // Minting it would produce a `GKV[?,?]` whose field access substitutes to a
    // CT_VOID inner and defeats codegen's erased-default recovery (br 365fqj). A
    // MIXED instance (one arg concrete, one unknown) still mints — the arg-list
    // builder keeps the unknown arg, and the field-access consumer skips it.
    let mut has_concrete = 0
    let mut ci = 0
    while ci < sublist_length(tparams_sl) {
        let bound = binds.get(node_name(sublist_get(tparams_sl, ci))) ?? -1
        if bound != -1 && type_kind(bound) != TK_TYPEVAR && type_kind(bound) != TK_UNKNOWN { has_concrete = 1 }
        ci = ci + 1
    }
    if has_concrete == 0 { return stid }
    let mut arg_tids: List[Int] = []
    let mut ti = 0
    while ti < sublist_length(tparams_sl) {
        let tpname = node_name(sublist_get(tparams_sl, ti))
        let bound = binds.get(tpname) ?? -1
        if bound != -1 {
            arg_tids.push(bound)
        } else {
            arg_tids.push(make_typevar(tpname))
        }
        ti = ti + 1
    }
    make_struct_instance_type(bare, arg_tids)
}

// ── Registration from AST ───────────────────────────────────────────

fn is_ffi_struct_field_type(ann_name: Str) -> Int {
    if ann_name == "I8" || ann_name == "I16" || ann_name == "I32" || ann_name == "I64" { return 1 }
    if ann_name == "U8" || ann_name == "U16" || ann_name == "U32" || ann_name == "U64" { return 1 }
    if ann_name == "Int" || ann_name == "Float" || ann_name == "F32" || ann_name == "F64" { return 1 }
    if ann_name == "Bool" { return 1 }
    0
}

fn is_builtin_hashable(name: Str) -> Int {
    if name == "Str" || name == "Int" || name == "Bool" || name == "Char" { return 1 }
    if name == "I8" || name == "I16" || name == "I32" || name == "I64" { return 1 }
    if name == "U8" || name == "U16" || name == "U32" || name == "U64" { return 1 }
    0
}

// Verify that a Map key type annotation is hashable. Emits MAP_KEY_NOT_HASHABLE
// (E1400) on rejection. Built-in scalars are always OK; user structs/enums
// must carry @derive(Hash); tuples are OK iff every element is hashable;
// Float/Double are explicitly rejected. Generic type parameters are accepted
// since we can't see through them at this point.
fn validate_map_key(key_ann: Int) ! Diag.Report {
    let key_name = node_name(key_ann)
    if key_name == "Float" || key_name == "F32" || key_name == "F64" {
        diag_error_at("MapKeyNotHashable", MAP_KEY_NOT_HASHABLE, "Map key type '{key_name}' is not hashable — Float/Double values cannot serve as Map keys (NaN-inequality and bit-equality hazards)", key_ann, "round the key to an Int (or another integer width) before inserting")
        return
    }
    if key_name == "Tuple" {
        let elems = node_elements(key_ann)
        if elems != -1 {
            let mut i = 0
            while i < sublist_length(elems) {
                validate_map_key(sublist_get(elems, i))
                i = i + 1
            }
        }
        return
    }
    if is_builtin_hashable(key_name) != 0 { return }
    let bare = strip_module_qualifier(key_name)
    if tc_hashable_types.contains_key(key_name) || tc_hashable_types.contains_key(bare) {
        return
    }
    // Generic type params and unknown names — let later phases handle them.
    // Only reject when we KNOW this is a user-defined struct/enum without
    // @derive(Hash), to avoid spurious errors on generics.
    if named_type_map.contains_key(key_name) || named_type_map.contains_key(bare) {
        diag_error_at("MapKeyNotHashable", MAP_KEY_NOT_HASHABLE, "Map key type '{key_name}' does not implement Hash — user types used as Map keys must carry the @derive(Hash, Eq) annotation", key_ann, "add @derive(Hash, Eq) to the '{key_name}' type definition")
    }
}

// Verify that a Set element type annotation is hashable — a Set is a keys-only
// hash table, so its element carries the same Hash requirement as a Map key.
// Emits MAP_KEY_NOT_HASHABLE (E1400) with Set-worded messages. Same rules as
// validate_map_key: built-in scalars OK; user structs/enums need @derive(Hash);
// tuples OK iff every element is hashable; Float/Double rejected; generic type
// params accepted (opaque at this point).
fn validate_set_elem(elem_ann: Int) ! Diag.Report {
    let elem_name = node_name(elem_ann)
    if elem_name == "Float" || elem_name == "F32" || elem_name == "F64" {
        diag_error_at("MapKeyNotHashable", MAP_KEY_NOT_HASHABLE, "Set element type '{elem_name}' is not hashable — Float/Double values cannot serve as Set elements (NaN-inequality and bit-equality hazards)", elem_ann, "round the value to an Int (or another integer width) before inserting")
        return
    }
    if elem_name == "Tuple" {
        let elems = node_elements(elem_ann)
        if elems != -1 {
            let mut i = 0
            while i < sublist_length(elems) {
                validate_set_elem(sublist_get(elems, i))
                i = i + 1
            }
        }
        return
    }
    if is_builtin_hashable(elem_name) != 0 { return }
    let bare = strip_module_qualifier(elem_name)
    if tc_hashable_types.contains_key(elem_name) || tc_hashable_types.contains_key(bare) {
        return
    }
    if named_type_map.contains_key(elem_name) || named_type_map.contains_key(bare) {
        diag_error_at("MapKeyNotHashable", MAP_KEY_NOT_HASHABLE, "Set element type '{elem_name}' does not implement Hash — user types used as Set elements must carry the @derive(Hash, Eq) annotation", elem_ann, "add @derive(Hash, Eq) to the '{elem_name}' type definition")
    }
}

// vfgp72: scan EVERY @derive annotation, not just the first. get_annotation
// returns only the first match, so `@derive(Eq)` + `@derive(Ord)` on separate
// lines hid the second derive (codegen's register_derive_annotations already
// walks all of node_handlers, so this aligns typecheck with codegen).
fn type_has_derive(td: Int, derive_name: Str) -> Int {
    let anns = node_handlers(td)
    if anns == -1 { return 0 }
    let mut i = 0
    while i < sublist_length(anns) {
        let ann = sublist_get(anns, i)
        if node_name(ann) == "derive" {
            let args_sl = node_args(ann)
            if args_sl != -1 {
                let mut j = 0
                while j < sublist_length(args_sl) {
                    if node_name(sublist_get(args_sl, j)) == derive_name { return 1 }
                    j = j + 1
                }
            }
        }
        i = i + 1
    }
    0
}

// Names the compiler reserves for internal AST head-sentinels: the parser
// overloads these head names to tag tuple / function / self-type annotations
// (parser.bl), and resolve_type_ann + resolve_tuple_ann key on the raw string.
// A user `type X` with one of these names would shadow the sentinel and
// mis-decode any annotation that mentions it (e.g. `type Tuple[X]` makes
// `(Int, Tuple[Int])` decode as a forbidden 1-arity tuple). Unlike other
// prelude names (shadowable with a warning), these three are un-shadowable
// because the collision has no disambiguation path — reject at the decl site.
fn is_reserved_type_sentinel(name: Str) -> Int {
    if name == "Tuple" || name == "Fn" || name == "Self" { return 1 }
    0
}

fn reject_reserved_type_name(td: Int) ! Diag.Report {
    let name = node_name(td)
    if is_reserved_type_sentinel(name) != 0 {
        diag_error_at("ReservedTypeName", RESERVED_TYPE_NAME, "type name '{name}' is reserved for an internal AST sentinel and cannot be declared as a user type", td, "rename the type")
    }
}

fn register_struct_type(td: Int) ! TypeCheck.Register, TypeCheck.Resolve, Diag.Report {
    reject_reserved_type_name(td)
    let name = node_name(td)
    let tid = new_type(TK_STRUCT, name)
    named_type_names.push(name)
    named_type_ids.push(tid)
    named_type_map.insert(name, tid)
    tc_struct_decl_nodes.insert(name, td)
    tc_type_decl_nodes.insert(name, td)
    let alias_ann = node_value(td)
    if alias_ann != -1 {
        tc_alias_underlying.insert(name, resolve_type_ann(alias_ann))
    }
    if type_has_derive(td, "Hash") != 0 {
        tc_hashable_types.insert(name, 1)
    }
    if type_has_derive(td, "Debug") != 0 {
        tc_debug_types.insert(name, 1)
    }

    let is_ffi_struct = has_annotation(td, "ffi.struct")
    if is_ffi_struct != 0 {
        ffi_struct_type_set.insert(name, 1)
    }

    let flds_sl = node_fields(td)
    if flds_sl != -1 {
        let mut i = 0
        while i < sublist_length(flds_sl) {
            let f = sublist_get(flds_sl, i)
            let fname = node_name(f)
            let ftype_ann = node_value(f)
            let ftype_id = resolve_type_ann(ftype_ann)
            sfield_pool.push(TcStructField { struct_id: tid, name: fname, type_id: ftype_id })
            let ftype_ann_name = node_name(ftype_ann)
            if ftype_ann_name == "Fn" {
                if is_callable_field_name(fname) == 0 {
                    nr_callable_field_names.push(fname)
                }
            }
            if is_ffi_struct != 0 {
                if is_ffi_struct_field_type(ftype_ann_name) == 0 {
                    diag_error_at("FfiStructGcField", FFI_STRUCT_GC_FIELD, "@ffi.struct field '{fname}' uses non-FFI type '{ftype_ann_name}' — only sized FFI-compatible types (I8/I16/I32/I64, U8/U16/U32/U64, Int, Float, F32, F64, Bool) and other @ffi.struct types are allowed", f, "use a sized integer/float/bool type or another @ffi.struct type")
                }
            }
            i = i + 1
        }
    }

    if has_annotation(td, "deprecated") != 0 {
        depr_type_nodes.insert(name, td)
    }
}

fn register_enum_type(td: Int) ! TypeCheck.Register, TypeCheck.Resolve, Diag.Report {
    reject_reserved_type_name(td)
    let name = node_name(td)
    let tid = new_type(TK_ENUM, name)
    named_type_names.push(name)
    named_type_ids.push(tid)
    named_type_map.insert(name, tid)
    tc_type_decl_nodes.insert(name, td)
    if type_has_derive(td, "Hash") != 0 {
        tc_hashable_types.insert(name, 1)
    }
    if type_has_derive(td, "Debug") != 0 {
        tc_debug_types.insert(name, 1)
    }

    let flds_sl = node_fields(td)
    if flds_sl != -1 {
        let mut _tag = 0
        let mut i = 0
        while i < sublist_length(flds_sl) {
            let v = sublist_get(flds_sl, i)
            let vname = node_name(v)
            let var_idx = evar_pool.len()

            let vflds_sl = node_fields(v)
            let mut _has_data = 0
            if vflds_sl != -1 && sublist_length(vflds_sl) > 0 {
                _has_data = 1
                let mut fi = 0
                while fi < sublist_length(vflds_sl) {
                    let vf = sublist_get(vflds_sl, fi)
                    let vf_name = node_name(vf)
                    let vf_type_ann = node_value(vf)
                    let vf_type_id = resolve_type_ann(vf_type_ann)
                    evfield_pool.push(EnumVariantFieldEntry { var_idx: var_idx, name: vf_name, type_id: vf_type_id })
                    fi = fi + 1
                }
            }
            evar_pool.push(EnumVariantEntry { enum_id: tid, name: vname, tag: _tag, has_data: _has_data })
            if tc_variant_enum_decl_nodes.contains_key(vname) == 0 {
                tc_variant_enum_decl_nodes.insert(vname, td)
            }

            _tag = _tag + 1
            i = i + 1
        }
    }

    if has_annotation(td, "deprecated") != 0 {
        depr_type_nodes.insert(name, td)
    }
}

// A field of a @derive(Debug) type whose own type is a user struct/enum must
// itself derive Debug — the generated debug() renders each field via its
// debug(). A built-in scalar / Str is always OK; a user type is OK iff it
// itself carries @derive(Debug).
fn tc_debug_field_ok(ftype_name: Str) -> Int {
    if named_type_map.contains_key(ftype_name) == 0 { return 1 }
    if tc_debug_types.contains_key(ftype_name) != 0 { return 1 }
    0
}

// The container type constructors that the v1 Debug renderer can walk
// (or that the typecheck rule peels into the element/key/value check).
// Set/Result are container-shaped but NOT in the v1 renderable set.
fn tc_is_container_name(n: Str) -> Int {
    if n == "List" || n == "Option" || n == "Map" || n == "Set" || n == "Result" { return 1 }
    0
}

// Parser pseudo-types that reach the Debug field check as a leaf `name` but are
// NOT Debug-renderable in v1 and can never be made so by adding a derive:
//   fn(...) -> T  → "Fn" (parser.bl:1437); (A, B) → "Tuple" (parser.bl:1408;
//   tuples auto-derive Eq/Ord/Hash/Display/Clone but NOT Debug, spec §3.6);
//   handler[E] → "Handler" (parser.bl:1453). Rejected E0520 like Set/Result
//   (0xr7fq); else they slip past tc_debug_field_ok and emit BLINK_COMPILER_BUG.
fn tc_is_non_debug_pseudo_type(n: Str) -> Int {
    if n == "Fn" || n == "Tuple" || n == "Handler" { return 1 }
    0
}

// Is `tname` a user STRUCT (not an enum)? A struct decl's fields are plain
// TypeField nodes; an enum decl's first field is a TypeVariant (same shape used
// at whole-program registration, typecheck.bl:2644). Returns 0 for unknown /
// non-user names.
fn tc_type_is_struct(tname: Str) -> Int {
    let td = tc_type_decl_nodes.get(tname) ?? -1
    if td == -1 { return 0 }
    let flds = node_fields(td)
    if flds != -1 && sublist_length(flds) > 0 {
        if node_kind(sublist_get(flds, 0)) == NodeKind.TypeVariant { return 0 }
    }
    1
}

// The Map-key types the v1 renderer can read back through the kops storage
// layer. Two families: (a) scalars — Str / Char / Int / Bool / sized ints,
// stored inline (Char in single-quoted debug-form, decisions/char-debug-form.md);
// (b) @derive(Debug, Hash, Eq) user STRUCTS, read via blink_map_key_slot (which
// dereferences the inline_key=0 pointer) and rendered via {sname}_debug (mirrors
// the struct-VALUE path). Enums and non-Debug user types are still rejected
// (E0520 via tc_check_debug_element).
fn tc_debug_map_key_ok(key_name: Str) -> Int {
    if key_name == "Str" || key_name == "Char" || key_name == "Int" || key_name == "Bool" { return 1 }
    if key_name == "I8" || key_name == "I16" || key_name == "I32" || key_name == "I64" { return 1 }
    if key_name == "U8" || key_name == "U16" || key_name == "U32" || key_name == "U64" { return 1 }
    if tc_type_is_struct(key_name) != 0 && tc_debug_types.contains_key(key_name) != 0 { return 1 }
    0
}

// Check one element / value of a Debug-renderable container field. The rule is
// fully inductive (spec §3.6): a non-Debug leaf → E0520; a Set/Result element →
// E0520 (not renderable at any level); a List/Option/Map element recurses into
// its own element/key/value checks so arbitrary nesting is proven Debug.
fn tc_check_debug_element(elem_ann: Int, f: Int, tname: Str) ! Diag.Report {
    let elem_name = node_name(elem_ann)
    if tc_is_non_debug_pseudo_type(elem_name) != 0 {
        diag_error_at("DeriveDebugFieldNoDebug", DERIVE_DEBUG_FIELD_NO_DEBUG, "@derive(Debug) on '{tname}': field '{node_name(f)}' has element type '{elem_name}' which is not Debug-renderable in v1", f, "implement Debug manually for this field's type")
        return
    }
    if tc_is_container_name(elem_name) != 0 {
        // Nested container: Set/Result are still rejected at every level; the
        // renderable containers (List/Option/Map) recurse.
        if elem_name == "Set" || elem_name == "Result" {
            diag_error_at("DeriveDebugFieldNoDebug", DERIVE_DEBUG_FIELD_NO_DEBUG, "@derive(Debug) on '{tname}': field '{node_name(f)}' has element type '{elem_name}' which is not Debug-renderable (only List/Option/Map containers render)", f, "implement Debug manually for this field's type")
            return
        }
        tc_check_container_elems(elem_ann, f, tname)
        return
    }
    if tc_debug_field_ok(elem_name) == 0 {
        diag_error_at("DeriveDebugFieldNoDebug", DERIVE_DEBUG_FIELD_NO_DEBUG, "@derive(Debug) on '{tname}': field '{node_name(f)}' has element type '{elem_name}' which does not derive Debug", f, "add @derive(Debug) to '{elem_name}'")
    }
}

// Peel a List/Option/Map container annotation `ann` and check its element (or
// key + value) types. Shared between the top-level field check and the nested
// recursion in tc_check_debug_element, so nesting is pure composition. The
// caller guarantees `ann` names List / Option / Map (Set/Result rejected first).
fn tc_check_container_elems(ann: Int, f: Int, tname: Str) ! Diag.Report {
    let ftype_name = node_name(ann)
    let elems_sl = node_elements(ann)
    if ftype_name == "Map" {
        if elems_sl != -1 && sublist_length(elems_sl) >= 2 {
            let key_ann = sublist_get(elems_sl, 0)
            let key_name = node_name(key_ann)
            if tc_debug_map_key_ok(key_name) != 0 {
                tc_check_debug_element(key_ann, f, tname)
            } else if tc_type_is_struct(key_name) != 0 {
                // A user STRUCT key that isn't Debug (tc_debug_map_key_ok gates
                // the Debug ones above): let tc_check_debug_element emit the
                // precise "does not derive Debug" diagnostic.
                tc_check_debug_element(key_ann, f, tname)
            } else {
                // Container map keys (List/Map/Option/Set/Result) and other
                // unsupported keys land here — container keys stay rejected,
                // which is why the map-debug emitter never recurses on keys.
                diag_error_at("DeriveDebugFieldNoDebug", DERIVE_DEBUG_FIELD_NO_DEBUG, "@derive(Debug) on '{tname}': field '{node_name(f)}' has Map key type '{key_name}' which v1 Debug cannot render (Str/Char/Int/Bool/sized-int keys, or a @derive(Debug, Hash, Eq) struct key)", f, "use a supported scalar key or a Debug struct key, or implement Debug manually")
            }
            tc_check_debug_element(sublist_get(elems_sl, 1), f, tname)
        }
        return
    }

    // List / Option: peel element 0.
    if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
        tc_check_debug_element(sublist_get(elems_sl, 0), f, tname)
    }
}

// Reject one field `f` of a @derive(Debug) type `tname` whose type — or whose
// container element/key/value type — does not derive Debug. `is_variant_field`
// is 1 when `f` is a field of an enum variant; container Debug rendering applies
// to struct fields AND enum-variant fields (x112x7), so the param is threaded
// only to keep call sites unchanged.
fn tc_check_one_debug_field(f: Int, tname: Str, _is_variant_field: Int) ! Diag.Report {
    let ann = node_value(f)
    let ftype_name = node_name(ann)

    if tc_is_non_debug_pseudo_type(ftype_name) != 0 {
        diag_error_at("DeriveDebugFieldNoDebug", DERIVE_DEBUG_FIELD_NO_DEBUG, "@derive(Debug) on '{tname}': field '{node_name(f)}' has type '{ftype_name}' which is not Debug-renderable in v1", f, "implement Debug manually for this field's type")
        return
    }

    if tc_is_container_name(ftype_name) == 0 {
        if tc_debug_field_ok(ftype_name) == 0 {
            diag_error_at("DeriveDebugFieldNoDebug", DERIVE_DEBUG_FIELD_NO_DEBUG, "@derive(Debug) on '{tname}': field '{node_name(f)}' has type '{ftype_name}' which does not derive Debug", f, "add @derive(Debug) to '{ftype_name}'")
        }
        return
    }

    // Field is a container type. Set/Result are not renderable at any level.
    if ftype_name == "Set" || ftype_name == "Result" {
        diag_error_at("DeriveDebugFieldNoDebug", DERIVE_DEBUG_FIELD_NO_DEBUG, "@derive(Debug) on '{tname}': field '{node_name(f)}' has type '{ftype_name}' which is not Debug-renderable in v1 (only List/Option/Map containers render)", f, "implement Debug manually for this field's type")
        return
    }

    tc_check_container_elems(ann, f, tname)
}

fn tc_check_derive_debug() ! Diag.Report {
    let mut ti = 0
    while ti < named_type_names.len() {
        let tname = named_type_names.get(ti).unwrap()
        if tc_debug_types.contains_key(tname) != 0 {
            let flds_sl = node_fields(tc_type_decl_nodes.get(tname).unwrap())
            let mut i = 0
            while flds_sl != -1 && i < sublist_length(flds_sl) {
                let f = sublist_get(flds_sl, i)
                if node_kind(f) == NodeKind.TypeVariant {
                    let vflds_sl = node_fields(f)
                    let mut vi = 0
                    while vflds_sl != -1 && vi < sublist_length(vflds_sl) {
                        tc_check_one_debug_field(sublist_get(vflds_sl, vi), tname, 1)
                        vi = vi + 1
                    }
                } else {
                    tc_check_one_debug_field(f, tname, 0)
                }
                i = i + 1
            }
        }
        ti = ti + 1
    }
}

// ---------------------------------------------------------------------------
// E1401 NonDerivableTrait — spec §3.6.6: a @derive(Hash/Eq/Ord) type may only
// contain fields whose type itself implements the derived trait. Modeled on
// tc_check_derive_debug (the Debug-field pass). Fail-open on generic /
// unresolved names so the compiler's own generic code keeps typechecking.
//
// v1 policy (spec §3.4:329): collections (List/Map/Set/Option/Result) have no
// value-equality/hash/ordering — `==` is pointer identity and there is no
// Eq/Hash/Ord impl for them as value types — so they are rejected under any of
// the three derives. Per-scalar: Float is not Hashable; Bool is not Orderable.

// Is a bare scalar type name integer-like (Int / sized ints / Char)?
fn tc_is_integer_scalar(n: Str) -> Int {
    if n == "Int" || n == "Char" { return 1 }
    if n == "I8" || n == "I16" || n == "I32" || n == "I64" { return 1 }
    if n == "U8" || n == "U16" || n == "U32" || n == "U64" { return 1 }
    0
}

fn tc_is_float_scalar(n: Str) -> Int {
    if n == "Float" || n == "F32" || n == "F64" { return 1 }
    0
}

// Does the named field type satisfy `tr` ("Hash"/"Eq"/"Ord")? Returns 1 for
// OK, 0 for reject. Fails OPEN (returns 1) for names that are neither a builtin
// scalar nor a known user type — generics / type params we can't resolve here.
fn tc_field_type_derivable(ftype_name: Str, tr: Str) -> Int {
    // Collections are never value-comparable/hashable/orderable in v1.
    if tc_is_container_name(ftype_name) != 0 { return 0 }

    // Tuple struct fields: a tuple is structurally Hash/Eq/Ord when its
    // elements are, but codegen (emit_struct_hash/_eq/_cmp) cannot synthesize a
    // per-tuple adapter for a struct FIELD today — it emits a BLINK_COMPILER_BUG
    // sentinel and a degenerate constant hash. Reject here so the failure is a
    // clear E1401 instead of a silent hash collapse. (Tuples as Map KEYS take a
    // different codegen path and remain supported.) Follow-up: sr04fj-class.
    if ftype_name == "Tuple" { return 0 }

    if tc_is_integer_scalar(ftype_name) != 0 { return 1 }
    if ftype_name == "Str" {
        // Str is Hash + Eq + Ord.
        return 1
    }
    if ftype_name == "Bool" {
        // Bool: Hash + Eq, but NOT Ord.
        if tr == "Ord" { return 0 }
        return 1
    }
    if tc_is_float_scalar(ftype_name) != 0 {
        // Float: Eq + Ord, but NOT Hash.
        if tr == "Hash" { return 0 }
        return 1
    }

    // User type: it must itself carry the trait (derive or hand-impl).
    let bare = strip_module_qualifier(ftype_name)
    if named_type_map.contains_key(ftype_name) || named_type_map.contains_key(bare) {
        if tr == "Hash" {
            if tc_hashable_types.contains_key(ftype_name) || tc_hashable_types.contains_key(bare) { return 1 }
            return 0
        }
        if tr == "Eq" {
            if tc_type_has_eq_impl(ftype_name) != 0 || tc_type_has_eq_impl(bare) != 0 { return 1 }
            return 0
        }
        // Ord
        if tc_type_has_ord_impl(ftype_name) != 0 || tc_type_has_ord_impl(bare) != 0 { return 1 }
        return 0
    }

    // Generic type param / unknown name — fail open.
    1
}

fn tc_check_one_derive_trait_field(f: Int, tname: Str, tr: Str) ! Diag.Report {
    let ann = node_value(f)
    let ftype_name = node_name(ann)
    if tc_field_type_derivable(ftype_name, tr) == 0 {
        diag_error_at("NonDerivableTrait", NON_DERIVABLE_TRAIT, "@derive({tr}) on '{tname}': field '{node_name(f)}' has type '{ftype_name}' which does not implement {tr}", f, "remove the field from the derive, give it a type that implements {tr}, or implement {tr} by hand")
    }
}

fn tc_check_one_derive_trait(tr: Str) ! Diag.Report {
    let mut ti = 0
    while ti < named_type_names.len() {
        let tname = named_type_names.get(ti).unwrap()
        let td = tc_type_decl_nodes.get(tname) ?? -1
        if td != -1 && type_has_derive(td, tr) != 0 {
            let flds_sl = node_fields(td)
            let mut i = 0
            while flds_sl != -1 && i < sublist_length(flds_sl) {
                let f = sublist_get(flds_sl, i)
                if node_kind(f) == NodeKind.TypeVariant {
                    let vflds_sl = node_fields(f)
                    let mut vi = 0
                    while vflds_sl != -1 && vi < sublist_length(vflds_sl) {
                        tc_check_one_derive_trait_field(sublist_get(vflds_sl, vi), tname, tr)
                        vi = vi + 1
                    }
                } else {
                    tc_check_one_derive_trait_field(f, tname, tr)
                }
                i = i + 1
            }
        }
        ti = ti + 1
    }
}

fn tc_check_derive_hash_eq_ord() ! Diag.Report {
    tc_check_one_derive_trait("Hash")
    tc_check_one_derive_trait("Eq")
    tc_check_one_derive_trait("Ord")
}

// Kind A collision: a struct type whose name equals an enum variant name. This is the
// NARROW invariant — two enums sharing a variant name (e.g. `Pending` in JobState and
// NetState) stays legal and is resolved by the hint, so we only fire when the colliding
// name is registered as a TK_STRUCT in named_type_map. Whole-program: both tables are
// merged across all modules at registration, so cross-module collisions are caught.
fn tc_check_name_collisions() ! TypeCheck.Register, Diag.Report {
    let mut i = 0
    while i < evar_pool.len() {
        let vname = evar_pool.get(i).unwrap().name
        let stid = named_type_map.get(vname) ?? -1
        if tc_collision_reported.contains_key(vname) == 0 && stid != -1 && type_kind(stid) == TK_STRUCT {
            tc_collision_reported.insert(vname, 1)
            let struct_node = tc_struct_decl_nodes.get(vname) ?? -1
            let enum_node = tc_variant_enum_decl_nodes.get(vname) ?? -1
            diag_error_at("NameCollision", NAME_COLLISION, "struct '{vname}' has the same name as an enum variant '{vname}'; bare construction would be ambiguous (note: two different enums MAY share a variant name — only a struct-vs-variant clash is rejected)", struct_node, "rename either the struct or the variant")
            if enum_node != -1 {
                diag_error_at("NameCollision", NAME_COLLISION, "the conflicting variant '{vname}' is declared here", enum_node, "rename either the struct or the variant")
            }
        }
        i = i + 1
    }
}

fn register_fn_sig(fn_node: Int) ! TypeCheck.Register, TypeCheck.Resolve, Diag.Report {
    let name = node_name(fn_node)
    let ret_str = node_return_type(fn_node)
    let ret_ann = node_type_ann(fn_node)
    let mut ret_tid = TYPE_VOID

    if ret_ann != -1 {
        ret_tid = resolve_type_ann(ret_ann)
    } else if ret_str != "" {
        ret_tid = resolve_type_name(ret_str)
        if ret_tid == -1 {
            ret_tid = TYPE_VOID
        }
    }

    let sig_idx = fnsig_pool.len()
    fnsig_map.insert(name, sig_idx)
    let fn_mod = node_module(fn_node)
    if fn_mod != "" {
        fnsig_map.insert("{fn_mod}:{name}", sig_idx)
    }
    let start = fnsig_param_list.len()

    let params_sl = node_params(fn_node)
    let mut count = 0
    if params_sl != -1 {
        let mut i = 0
        while i < sublist_length(params_sl) {
            let p = sublist_get(params_sl, i)
            let ptype_str = node_type_name(p)
            let ptype_ann = node_type_ann(p)
            let mut ptid = TYPE_UNKNOWN
            if ptype_ann != -1 {
                ptid = resolve_type_ann(ptype_ann)
                // A generic user-struct param (`Box[T]`) resolves to the BARE base
                // tid; re-intern it as a structural instance carrying the typevar
                // slots so unify_typevar_binds can bind T from the argument (8wyq1k).
                let inst = tc_fnsig_param_instance_tid(ptype_ann, ptid)
                if inst != -1 { ptid = inst }
            } else if ptype_str != "" {
                ptid = resolve_type_name(ptype_str)
                if ptid == -1 {
                    ptid = TYPE_UNKNOWN
                }
            }
            fnsig_param_list.push(ptid)
            count = count + 1
            i = i + 1
        }
    }

    let tparams_sl = node_type_params(fn_node)
    let tp_start = fnsig_type_param_names.len()
    let mut tp_count = 0
    if tparams_sl != -1 {
        let mut ti = 0
        while ti < sublist_length(tparams_sl) {
            let tp = sublist_get(tparams_sl, ti)
            fnsig_type_param_names.push(node_name(tp))
            tp_count = tp_count + 1
            ti = ti + 1
        }
    }
    let eff_start = fnsig_effect_names.len()
    let effects_sl = node_effects(fn_node)
    let mut eff_count = 0
    if effects_sl != -1 {
        let mut ei = 0
        while ei < sublist_length(effects_sl) {
            let eff = sublist_get(effects_sl, ei)
            fnsig_effect_names.push(node_name(eff))
            eff_count = eff_count + 1
            ei = ei + 1
        }
    }
    fnsig_pool.push(FnSigEntry { name: name, ret: ret_tid, params_start: start, params_count: count, type_params_start: tp_start, type_params_count: tp_count, effects_start: eff_start, effects_count: eff_count })

    if has_annotation(fn_node, "deprecated") != 0 {
        depr_fn_nodes.insert(name, fn_node)
    }
}

fn depr_ann_str_arg(ann_node: Int, key: Str) -> Str {
    let args_sl = node_args(ann_node)
    if args_sl == -1 { return "" }
    let mut i = 0
    while i < sublist_length(args_sl) {
        let arg = sublist_get(args_sl, i)
        if node_name(arg) == key {
            let parts_sl = node_elements(arg)
            if parts_sl != -1 && sublist_length(parts_sl) > 0 {
                return node_str_val(sublist_get(parts_sl, 0))
            }
        }
        i = i + 1
    }
    ""
}

fn check_deprecated_fn(fn_name: Str, call_node: Int) ! Diag.Report {
    if depr_fn_nodes.contains_key(fn_name) == 0 { return }
    let def_node = depr_fn_nodes.get(fn_name) ?? -1
    if def_node == -1 { return }
    let ann = get_annotation(def_node, "deprecated")
    if ann == -1 { return }
    let since = depr_ann_str_arg(ann, "since")
    let replacement = depr_ann_str_arg(ann, "replacement")
    let mut msg = "use of deprecated function '{fn_name}'"
    if since != "" {
        msg = msg.concat(" (deprecated since {since})")
    }
    let mut help = ""
    if replacement != "" {
        help = "use '{replacement}' instead"
    }
    diag_warn_at("DeprecatedUsage", DEPRECATED_USAGE, msg, call_node, help)
}

fn check_deprecated_type(type_name: Str, usage_node: Int) ! Diag.Report {
    if depr_type_nodes.contains_key(type_name) == 0 { return }
    let def_node = depr_type_nodes.get(type_name) ?? -1
    if def_node == -1 { return }
    let ann = get_annotation(def_node, "deprecated")
    if ann == -1 { return }
    let since = depr_ann_str_arg(ann, "since")
    let replacement = depr_ann_str_arg(ann, "replacement")
    let mut msg = "use of deprecated type '{type_name}'"
    if since != "" {
        msg = msg.concat(" (deprecated since {since})")
    }
    let mut help = ""
    if replacement != "" {
        help = "use '{replacement}' instead"
    }
    diag_warn_at("DeprecatedUsage", DEPRECATED_USAGE, msg, usage_node, help)
}

fn is_valid_ptr_inner(name: Str) -> Int {
    if name == "Void" { return 1 }
    if name == "U8" || name == "U16" || name == "U32" || name == "U64" { return 1 }
    if name == "I8" || name == "I16" || name == "I32" || name == "I64" { return 1 }
    if name == "Int" || name == "Float" || name == "Ptr" { return 1 }
    if ffi_struct_type_set.contains_key(name) != 0 { return 1 }
    0
}

fn check_ptr_in_type_ann(ann_node: Int, has_ffi: Int) ! Diag.Report {
    if ann_node == -1 { return }
    let name = node_name(ann_node)
    if name == "Ptr" {
        if has_ffi == 0 {
            diag_error_at("PtrOutsideFFI", PTR_OUTSIDE_FFI, "Ptr[T] type can only be used in @ffi functions or @trusted blocks", ann_node, "add @ffi annotation to the function or wrap usage in @trusted")
        }
        let elems_sl = node_elements(ann_node)
        if elems_sl != -1 && sublist_length(elems_sl) > 0 {
            let inner = sublist_get(elems_sl, 0)
            let inner_name = node_name(inner)
            if is_valid_ptr_inner(inner_name) == 0 {
                diag_error_at("InvalidPtrType", INVALID_PTR_TYPE, "invalid Ptr type parameter '{inner_name}' — only Void, U8-U64, I8-I64, Int, Float, Ptr, or @ffi.struct types are allowed", inner, "use a valid FFI-compatible type or annotate the type with @ffi.struct")
            }
        }
        return
    }
    let elems_sl = node_elements(ann_node)
    if elems_sl != -1 {
        let mut i = 0
        while i < sublist_length(elems_sl) {
            check_ptr_in_type_ann(sublist_get(elems_sl, i), has_ffi)
            i = i + 1
        }
    }
}

fn check_ptr_in_type_name(type_name: Str, node: Int, has_ffi: Int) ! Diag.Report {
    if type_name == "Ptr" && has_ffi == 0 {
        diag_error_at("PtrOutsideFFI", PTR_OUTSIDE_FFI, "Ptr[T] type can only be used in @ffi functions or @trusted blocks", node, "add @ffi annotation to the function or wrap usage in @trusted")
    }
}

// ── Phase 0: Contract predicate validator ─────────────────────────────
//
// Predicates inside @requires / @ensures / @where must lie in an
// SMT-decidable subset so that today's runtime checks can later be
// promoted to compile-time proofs without rewriting every contract.
//
// Allowed: literals, identifiers, parameter refs, `result` (in @ensures),
// `old(_)` (in @ensures), arithmetic / comparison / boolean / equality
// binops, unary `!` and unary `-`, FieldAccess, IndexExpr, RangeLit,
// IfExpr, MatchExpr, calls/method-calls to either a hardcoded bootstrap
// whitelist (`len`, `is_empty`, `unwrap`, `abs`) or to a @pure function.
//
// Rejected (each maps to a distinct diagnostic in E1300-E1306):
//   - LetBinding, Assignment/CompoundAssign            → E1306 / E1300
//   - Closure, ForIn, WhileLoop, LoopExpr              → E1303 / E1300
//   - Break, Continue, Return                          → E1300
//   - WithBlock, AsyncSpawn, AwaitExpr, ChannelNew     → E1300
//   - Allocation (ListLit, StructLit non-trivially)    → E1300
//   - Calls into effectful fns                         → E1301
//   - Calls into non-pure user fns (no effects, but
//     not @pure / not on bootstrap whitelist)          → E1302

fn pv_is_whitelisted_call(name: Str) -> Int {
    if name == "len" { return 1 }
    if name == "is_empty" { return 1 }
    if name == "unwrap" { return 1 }
    if name == "abs" { return 1 }
    if name == "fabs" { return 1 }
    0
}

fn pv_fn_has_any_effect(name: Str) -> Int {
    let sig = lookup_fnsig(name)
    if sig == -1 { return 0 }
    let fs = fnsig_pool.get(sig).unwrap()
    if fs.effects_count > 0 { return 1 }
    0
}

// Depth counter set transiently when walking the argument(s) of an
// `old(_)` call. Used to reject nested `old(old(_))`.
let mut pv_in_old_depth: Int = 0

fn pv_validate_call_target(call_name: Str, call_node: Int, in_ensures: Int) ! Diag.Report {
    if call_name == "old" {
        if in_ensures == 0 {
            diag_error_at("OldOutsideEnsures", OLD_OUTSIDE_ENSURES, "`old(_)` is only valid inside @ensures predicates", call_node, "move the `old(_)` reference into an @ensures predicate")
        } else if pv_in_old_depth != 0 {
            diag_error_at("OldOutsideEnsures", OLD_OUTSIDE_ENSURES, "`old(_)` may not be nested — `old(old(_))` is not meaningful", call_node, "remove the outer `old(_)`")
        }
        return
    }
    if pv_is_whitelisted_call(call_name) != 0 { return }
    if pv_is_whitelisted_ffi_wrapper(call_name) != 0 { return }
    if tc_fn_is_pure(call_name) != 0 { return }
    if pv_fn_has_any_effect(call_name) != 0 {
        diag_error_at("EffectfulCallInPredicate", EFFECTFUL_CALL_IN_PREDICATE, "predicate calls effectful function '{call_name}' — predicates must be pure", call_node, "call only @pure helpers (or compute the value in the function body)")
        return
    }
    let sig = lookup_fnsig(call_name)
    if sig == -1 { return }
    diag_error_at("ImpureCallInPredicate", IMPURE_CALL_IN_PREDICATE, "predicate calls non-pure function '{call_name}' — predicates may only call @pure helpers or the bootstrap whitelist (len, is_empty, unwrap, abs, fabs)", call_node, "mark '{call_name}' as @pure if it qualifies, or inline the computation")
}

fn pv_walk(expr: Int, in_ensures: Int) ! Diag.Report {
    if expr == -1 { return }
    let k = node_kind(expr)

    // Literals — always fine.
    if k == NodeKind.IntLit { return }
    if k == NodeKind.FloatLit { return }
    if k == NodeKind.BoolLit { return }
    if k == NodeKind.CharLit { return }

    // Strings: literal Str is allowed, but interpolation is a control-flow
    // artifact we don't want in predicates today.
    if k == NodeKind.InterpString {
        diag_error_at("ContractPredicateNotDecidable", CONTRACT_PREDICATE_NOT_DECIDABLE, "interpolated strings are not allowed in contract predicates", expr, "use a plain string literal or move the formatting into the function body")
        return
    }

    // Identifiers — `result` is gated to @ensures, everything else is fine.
    if k == NodeKind.Ident {
        let nm = node_name(expr)
        if nm == "result" {
            if in_ensures == 0 {
                diag_error_at("ResultOutsideEnsures", RESULT_OUTSIDE_ENSURES, "`result` is only valid inside @ensures predicates", expr, "rename the local, or move the reference into @ensures(...)")
            }
        }
        return
    }

    // Operators.
    if k == NodeKind.BinOp {
        pv_walk(node_left(expr), in_ensures)
        pv_walk(node_right(expr), in_ensures)
        return
    }
    if k == NodeKind.UnaryOp {
        pv_walk(node_left(expr), in_ensures)
        return
    }

    // Read-only access.
    if k == NodeKind.FieldAccess {
        pv_walk(node_obj(expr), in_ensures)
        return
    }
    if k == NodeKind.IndexExpr {
        pv_walk(node_obj(expr), in_ensures)
        pv_walk(node_index(expr), in_ensures)
        return
    }

    // Range membership / construction (rhs of `in`).
    if k == NodeKind.RangeLit {
        pv_walk(node_start(expr), in_ensures)
        pv_walk(node_end(expr), in_ensures)
        return
    }

    // If / Match — accepted (per design: SMT can encode as ite).
    if k == NodeKind.IfExpr {
        pv_walk(node_condition(expr), in_ensures)
        pv_walk(node_then_body(expr), in_ensures)
        pv_walk(node_else_body(expr), in_ensures)
        return
    }
    if k == NodeKind.MatchExpr {
        pv_walk(node_scrutinee(expr), in_ensures)
        let arms_sl = node_arms(expr)
        if arms_sl != -1 {
            let mut i = 0
            while i < sublist_length(arms_sl) {
                let arm = sublist_get(arms_sl, i)
                let g = node_guard(arm)
                if g != -1 { pv_walk(g, in_ensures) }
                pv_walk(node_body(arm), in_ensures)
                i = i + 1
            }
        }
        return
    }

    // A bare Block can wrap a single expression; if it contains statements
    // (let, assignment, loops...), the recursive walk will surface the
    // appropriate diagnostic against each child.
    if k == NodeKind.Block {
        let stmts_sl = node_stmts(expr)
        if stmts_sl != -1 {
            let mut i = 0
            while i < sublist_length(stmts_sl) {
                pv_walk(sublist_get(stmts_sl, i), in_ensures)
                i = i + 1
            }
        }
        return
    }

    // Block bodies wrap their tail expression in ExprStmt; descend.
    if k == NodeKind.ExprStmt {
        pv_walk(node_value(expr), in_ensures)
        return
    }

    // Calls. Parser stores callee in `left` (typically an Ident).
    if k == NodeKind.Call {
        let callee = node_left(expr)
        let mut call_name = ""
        if callee != -1 {
            call_name = node_name(callee)
        }
        pv_validate_call_target(call_name, expr, in_ensures)
        let is_old = if call_name == "old" { 1 } else { 0 }
        if is_old != 0 { pv_in_old_depth = pv_in_old_depth + 1 }
        let args_sl = node_args(expr)
        if args_sl != -1 {
            let mut i = 0
            while i < sublist_length(args_sl) {
                pv_walk(sublist_get(args_sl, i), in_ensures)
                i = i + 1
            }
        }
        if is_old != 0 { pv_in_old_depth = pv_in_old_depth - 1 }
        return
    }
    if k == NodeKind.MethodCall {
        let mname = node_method(expr)
        // Method calls bypass the impurity check when on the whitelist
        // (`xs.len()`, `o.unwrap()`, etc.). For everything else we have no
        // way today to know which trait/impl the method resolves to without
        // running full method dispatch — so we accept conservatively and
        // leave precise checking to the @pure registry.
        if pv_is_whitelisted_call(mname) == 0 {
            // Best-effort: if there is a top-level fn with this exact name
            // and it has effects, surface E1301.
            if pv_fn_has_any_effect(mname) != 0 {
                diag_error_at("EffectfulCallInPredicate", EFFECTFUL_CALL_IN_PREDICATE, "predicate calls effectful method '{mname}' — predicates must be pure", expr, "call only @pure helpers (or compute the value in the function body)")
            }
        }
        pv_walk(node_obj(expr), in_ensures)
        let m_args_sl = node_args(expr)
        if m_args_sl != -1 {
            let mut i = 0
            while i < sublist_length(m_args_sl) {
                pv_walk(sublist_get(m_args_sl, i), in_ensures)
                i = i + 1
            }
        }
        return
    }

    // Hard rejections — distinct codes for the structurally-disqualifying
    // forms; everything else funnels into E1300.
    if k == NodeKind.WhileLoop || k == NodeKind.ForIn || k == NodeKind.LoopExpr {
        diag_error_at("LoopInPredicate", LOOP_IN_PREDICATE, "loops are not allowed in contract predicates — predicates must terminate and be quantifier-free", expr, "replace iteration with a recursive @pure helper or a quantifier-free expression")
        return
    }
    if k == NodeKind.Assignment || k == NodeKind.CompoundAssign {
        diag_error_at("AssignmentInPredicate", ASSIGNMENT_IN_PREDICATE, "assignments are not allowed in contract predicates — predicates must be referentially transparent", expr, "rewrite as a pure comparison; bind values outside the predicate if needed")
        return
    }

    // Catch-all: every other shape is outside the decidable subset.
    let kname = node_kind_name(k)
    diag_error_at("ContractPredicateNotDecidable", CONTRACT_PREDICATE_NOT_DECIDABLE, "construct '{kname}' is not allowed in contract predicates — predicates must lie in the SMT-decidable subset", expr, "rewrite the predicate as a pure expression over parameters, comparisons, and @pure calls")
}

fn pv_validate_annotation(ann: Int, in_ensures: Int) ! Diag.Report {
    let args_sl = node_args(ann)
    if args_sl == -1 { return }
    if sublist_length(args_sl) == 0 { return }
    let pred = sublist_get(args_sl, 0)
    pv_in_old_depth = 0
    pv_walk(pred, in_ensures)
}

fn pv_validate_fn_contracts(fn_node: Int) ! Diag.Report {
    let anns_sl = node_handlers(fn_node)
    if anns_sl == -1 { return }
    let mut i = 0
    while i < sublist_length(anns_sl) {
        let ann = sublist_get(anns_sl, i)
        let nm = node_name(ann)
        if nm == "requires" {
            pv_validate_annotation(ann, 0)
        } else if nm == "ensures" {
            pv_validate_annotation(ann, 1)
        } else if nm == "modifies" {
            pv_validate_modifies(ann)
        }
        i = i + 1
    }
}

// Validate that every @modifies argument is a simple path
// (`ident`, `ident.field`, or `nothing`). Reject kv-pair forms.
fn pv_validate_modifies(ann: Int) ! Diag.Report {
    let args_sl = node_args(ann)
    if args_sl == -1 { return }
    let mut i = 0
    while i < sublist_length(args_sl) {
        let arg = sublist_get(args_sl, i)
        let nm = node_name(arg)
        if nm.contains(":") {
            diag_error_at("ModifiesArgNotSimplePath", MODIFIES_ARG_NOT_SIMPLE_PATH,
                "@modifies argument must be a simple path (ident, ident.field, or 'nothing'), got '{nm}'",
                arg, "remove the kv-pair form")
        }
        i = i + 1
    }
}

fn pv_validate_type_alias(td: Int) ! Diag.Report {
    let where_pred = node_condition(td)
    if where_pred == -1 { return }
    pv_walk(where_pred, 0)
}

// ── @pure annotation + minimal purity check ─────────────────────────
//
// `tc_pure_fns` is populated in a first pass over all fns *before* any
// body is walked, so recursive and mutually-recursive @pure fns work.
// `pv_validate_call_target` consults this registry to decide whether a
// non-effectful, non-bootstrap call is allowed in a predicate.

pub let mut tc_pure_fns: Map[Str, Int] = Map()
pub let mut tc_fn_node_by_name: Map[Str, Int] = Map()

pub fn tc_fn_is_pure(name: Str) -> Int {
    if tc_pure_fns.contains_key(name) { return 1 }
    0
}

// True if `name` is a Blink wrapper around a C symbol on the predicate
// bootstrap whitelist (today: just `fabs`). The wrapper is FFI and would
// otherwise be rejected as effectful — the whitelist short-circuits.
fn pv_is_whitelisted_ffi_wrapper(name: Str) -> Int {
    if !tc_fn_node_by_name.contains_key(name) { return 0 }
    let fn_node = tc_fn_node_by_name.get(name).unwrap()
    let ffi_ann = get_annotation(fn_node, "ffi")
    if ffi_ann == -1 { return 0 }
    let args_sl = node_args(ffi_ann)
    if args_sl == -1 { return 0 }
    let mut i = 0
    while i < sublist_length(args_sl) {
        let arg = sublist_get(args_sl, i)
        if node_kind(arg) == NodeKind.InterpString && node_name(arg) == "" {
            let parts_sl = node_elements(arg)
            if parts_sl != -1 && sublist_length(parts_sl) == 1 {
                let part = sublist_get(parts_sl, 0)
                if is_literal_string_part(part) != 0 {
                    let sym = node_str_val(part)
                    if pv_is_whitelisted_call(sym) != 0 { return 1 }
                }
            }
            return 0
        }
        i = i + 1
    }
    0
}

fn pp_is_mutating_method(name: Str) -> Int {
    if name == "push" { return 1 }
    if name == "pop" { return 1 }
    if name == "append" { return 1 }
    if name == "clear" { return 1 }
    if name == "insert" { return 1 }
    if name == "remove" { return 1 }
    if name == "set" { return 1 }
    0
}

fn pp_is_collection_constructor(name: Str) -> Int {
    if name == "List" { return 1 }
    if name == "Map" { return 1 }
    if name == "Set" { return 1 }
    0
}

fn pp_walk(node: Int, fn_name: Str, anchor: Int) ! Diag.Report {
    if node == -1 { return }
    let k = node_kind(node)

    // Reject loops outright — non-terminating constructs.
    if k == NodeKind.WhileLoop || k == NodeKind.ForIn || k == NodeKind.LoopExpr {
        diag_error_at("ImpureBodyForPureAnnotation", IMPURE_BODY_FOR_PURE_ANNOTATION, "@pure function '{fn_name}' contains a loop — @pure forbids while/for/loop", anchor, "remove the loop or drop the @pure annotation")
        return
    }
    // Reject assignments.
    if k == NodeKind.Assignment || k == NodeKind.CompoundAssign {
        diag_error_at("ImpureBodyForPureAnnotation", IMPURE_BODY_FOR_PURE_ANNOTATION, "@pure function '{fn_name}' contains an assignment — @pure forbids mutation", anchor, "rewrite without assignment or drop the @pure annotation")
        return
    }
    // Reject List/Map/Set allocation in literal form.
    if k == NodeKind.ListLit {
        diag_error_at("ImpureBodyForPureAnnotation", IMPURE_BODY_FOR_PURE_ANNOTATION, "@pure function '{fn_name}' allocates a List — @pure forbids List/Map/Set allocation", anchor, "compute on existing inputs or drop the @pure annotation")
        return
    }

    if k == NodeKind.Call {
        let callee = node_left(node)
        let mut call_name = ""
        if callee != -1 { call_name = node_name(callee) }
        if pp_is_collection_constructor(call_name) != 0 {
            diag_error_at("ImpureBodyForPureAnnotation", IMPURE_BODY_FOR_PURE_ANNOTATION, "@pure function '{fn_name}' allocates a '{call_name}' — @pure forbids List/Map/Set allocation", anchor, "compute on existing inputs or drop the @pure annotation")
        } else if pv_fn_has_any_effect(call_name) != 0 {
            diag_error_at("ImpureBodyForPureAnnotation", IMPURE_BODY_FOR_PURE_ANNOTATION, "@pure function '{fn_name}' calls effectful function '{call_name}' — @pure may only call @pure helpers (or len/is_empty/unwrap/abs/fabs)", anchor, "drop the @pure annotation or rewrite without the effectful call")
        } else if pv_is_whitelisted_call(call_name) == 0 && tc_fn_is_pure(call_name) == 0 {
            // Skip if the callee is unresolvable — could be a stdlib helper
            // (e.g. assert) or a builtin we don't track. Only complain when
            // we can prove it's a defined non-pure user function.
            if lookup_fnsig(call_name) != -1 {
                diag_error_at("ImpureBodyForPureAnnotation", IMPURE_BODY_FOR_PURE_ANNOTATION, "@pure function '{fn_name}' calls non-@pure function '{call_name}' — mark it @pure or drop the annotation", anchor, "add @pure to '{call_name}' if it qualifies, or remove @pure from '{fn_name}'")
            }
        }
        // Still recurse into args — a pure-looking call could embed impurity.
        let cargs_sl = node_args(node)
        if cargs_sl != -1 {
            let mut i = 0
            while i < sublist_length(cargs_sl) {
                pp_walk(sublist_get(cargs_sl, i), fn_name, anchor)
                i = i + 1
            }
        }
        return
    }

    if k == NodeKind.MethodCall {
        let mname = node_method(node)
        if pp_is_mutating_method(mname) != 0 {
            diag_error_at("ImpureBodyForPureAnnotation", IMPURE_BODY_FOR_PURE_ANNOTATION, "@pure function '{fn_name}' calls mutating method '.{mname}()' — @pure forbids mutation", anchor, "rewrite without the mutating call or drop the @pure annotation")
        }
        pp_walk(node_obj(node), fn_name, anchor)
        let margs_sl = node_args(node)
        if margs_sl != -1 {
            let mut i = 0
            while i < sublist_length(margs_sl) {
                pp_walk(sublist_get(margs_sl, i), fn_name, anchor)
                i = i + 1
            }
        }
        return
    }

    // Recurse into children. Replicates the structure of pv_walk.
    if k == NodeKind.BinOp {
        pp_walk(node_left(node), fn_name, anchor)
        pp_walk(node_right(node), fn_name, anchor)
        return
    }
    if k == NodeKind.UnaryOp {
        pp_walk(node_left(node), fn_name, anchor)
        return
    }
    if k == NodeKind.FieldAccess {
        pp_walk(node_obj(node), fn_name, anchor)
        return
    }
    if k == NodeKind.IndexExpr {
        pp_walk(node_obj(node), fn_name, anchor)
        pp_walk(node_index(node), fn_name, anchor)
        return
    }
    if k == NodeKind.RangeLit {
        pp_walk(node_start(node), fn_name, anchor)
        pp_walk(node_end(node), fn_name, anchor)
        return
    }
    if k == NodeKind.IfExpr {
        pp_walk(node_condition(node), fn_name, anchor)
        pp_walk(node_then_body(node), fn_name, anchor)
        pp_walk(node_else_body(node), fn_name, anchor)
        return
    }
    if k == NodeKind.MatchExpr {
        pp_walk(node_scrutinee(node), fn_name, anchor)
        let arms_sl = node_arms(node)
        if arms_sl != -1 {
            let mut i = 0
            while i < sublist_length(arms_sl) {
                let arm = sublist_get(arms_sl, i)
                let g = node_guard(arm)
                if g != -1 { pp_walk(g, fn_name, anchor) }
                pp_walk(node_body(arm), fn_name, anchor)
                i = i + 1
            }
        }
        return
    }
    if k == NodeKind.Block {
        let stmts_sl = node_stmts(node)
        if stmts_sl != -1 {
            let mut i = 0
            while i < sublist_length(stmts_sl) {
                pp_walk(sublist_get(stmts_sl, i), fn_name, anchor)
                i = i + 1
            }
        }
        return
    }
    if k == NodeKind.ExprStmt {
        pp_walk(node_value(node), fn_name, anchor)
        return
    }
    if k == NodeKind.LetBinding {
        // `let x = expr` itself is fine; the RHS is the only thing that
        // could carry impurity.
        pp_walk(node_value(node), fn_name, anchor)
        return
    }
    if k == NodeKind.Return {
        pp_walk(node_value(node), fn_name, anchor)
        return
    }
    // Literals + identifiers — leaves, nothing to check.
}

fn tc_register_pure_fns(fns_sl: Int) {
    if fns_sl == -1 { return }
    let mut i = 0
    while i < sublist_length(fns_sl) {
        let fn_node = sublist_get(fns_sl, i)
        let fn_name = node_name(fn_node)
        tc_fn_node_by_name.insert(fn_name, fn_node)
        if has_annotation(fn_node, "pure") != 0 {
            tc_pure_fns.insert(fn_name, 1)
        }
        i = i + 1
    }
}

fn tc_check_pure(fn_node: Int) ! Diag.Report {
    if has_annotation(fn_node, "pure") == 0 { return }
    let fn_name = node_name(fn_node)
    let pure_ann = get_annotation(fn_node, "pure")
    let anchor = if pure_ann != -1 { pure_ann } else { fn_node }

    // Reject @pure on a fn that declares any effects.
    let effects_sl = node_effects(fn_node)
    if effects_sl != -1 && sublist_length(effects_sl) > 0 {
        diag_error_at("ImpureBodyForPureAnnotation", IMPURE_BODY_FOR_PURE_ANNOTATION, "@pure function '{fn_name}' declares effects — @pure forbids declared effects", anchor, "drop the effect declaration or remove @pure")
        return
    }

    let body = node_body(fn_node)
    if body == -1 { return }
    pp_walk(body, fn_name, anchor)
}

fn validate_ffi_fn(fn_node: Int) ! Diag.Report {
    let name = node_name(fn_node)
    let ffi_node = get_annotation(fn_node, "ffi")
    let has_ffi = if ffi_node != -1 { 1 } else { 0 }
    let has_trusted = has_annotation(fn_node, "trusted")
    let requires_node = get_annotation(fn_node, "requires")
    let has_requires = if requires_node != -1 { 1 } else { 0 }
    let ensures_node = get_annotation(fn_node, "ensures")
    let has_ensures = if ensures_node != -1 { 1 } else { 0 }

    if has_ffi != 0 {
        if node_is_pub(fn_node) != 0 && has_trusted == 0 {
            diag_error_at("PubFFI", PUB_FFI, "FFI function '{name}' must not be pub — FFI functions are unsafe and should be wrapped", ffi_node, "remove 'pub' or add @trusted to mark it as audited")
        }
        let effects_sl = node_effects(fn_node)
        if effects_sl == -1 || sublist_length(effects_sl) == 0 {
            diag_error_at("FFINoEffects", FFI_NO_EFFECTS, "FFI function '{name}' must declare effects — FFI calls are side-effectful", ffi_node, "add '! FFI' or appropriate effects to the function signature")
        }
        if has_requires != 0 {
            diag_error_at("ContractOnFFI", CONTRACT_ON_FFI, "@requires cannot be used on FFI function '{name}' — contracts cannot verify foreign code", requires_node, "remove @requires from the FFI function")
        }
        if has_ensures != 0 {
            diag_error_at("ContractOnFFI", CONTRACT_ON_FFI, "@ensures cannot be used on FFI function '{name}' — contracts cannot verify foreign code", ensures_node, "remove @ensures from the FFI function")
        }
        if has_trusted == 0 {
            diag_warn_at("UnauditedFFI", UNAUDITED_FFI, "FFI function '{name}' is not marked @trusted — consider auditing and adding @trusted", ffi_node, "add @trusted after auditing the foreign function")
        }
    }

    // Check Ptr[T] in parameter types
    let params_sl = node_params(fn_node)
    if params_sl != -1 {
        let mut pi = 0
        while pi < sublist_length(params_sl) {
            let p = sublist_get(params_sl, pi)
            let ptype_ann = node_type_ann(p)
            if ptype_ann != -1 {
                check_ptr_in_type_ann(ptype_ann, has_ffi)
            } else {
                check_ptr_in_type_name(node_type_name(p), p, has_ffi)
            }
            pi = pi + 1
        }
    }

    // Check Ptr[T] in return type
    let ret_ann = node_type_ann(fn_node)
    if ret_ann != -1 {
        check_ptr_in_type_ann(ret_ann, has_ffi)
    } else {
        let ret_str = node_return_type(fn_node)
        if ret_str == "Ptr" && has_ffi == 0 {
            diag_error_at("PtrOutsideFFI", PTR_OUTSIDE_FFI, "Ptr[T] type can only be used in @ffi functions or @trusted blocks", fn_node, "add @ffi annotation to the function or wrap usage in @trusted")
        }
    }
}

fn budget_effect_satisfies(budget_eff: Str, fn_eff: Str) -> Int {
    if budget_eff == fn_eff { return 1 }
    if fn_eff.starts_with(budget_eff.concat(".")) { return 1 }
    0
}

fn validate_capabilities_budget(program: Int, fns_sl: Int) ! Diag.Report {
    let cap_node = get_annotation(program, "capabilities")
    if cap_node == -1 { return }
    let mut budget_names: List[Str] = []
    let ann_args_sl = node_args(cap_node)
    if ann_args_sl != -1 {
        let mut ai = 0
        while ai < sublist_length(ann_args_sl) {
            let arg_nd = sublist_get(ann_args_sl, ai)
            budget_names.push(node_name(arg_nd))
            ai = ai + 1
        }
    }
    if fns_sl == -1 { return }
    let mut fi = 0
    while fi < sublist_length(fns_sl) {
        let fn_node = sublist_get(fns_sl, fi)
        let fn_name = node_name(fn_node)
        let fn_mod = node_module(fn_node)
        if fn_name != "main" && !fn_name.starts_with("__test_") && (fn_mod == "__main__") {
            let sig = lookup_fnsig(fn_name)
            if sig != -1 && sig < fnsig_pool.len() {
                let fs = fnsig_pool.get(sig).unwrap()
                let eff_start = fs.effects_start
                let eff_count = fs.effects_count
                let mut ei = 0
                while ei < eff_count {
                    let eff = fnsig_effect_names.get(eff_start + ei).unwrap()
                    let mut allowed = 0
                    let mut bi = 0
                    while bi < budget_names.len() {
                        if budget_effect_satisfies(budget_names.get(bi).unwrap(), eff) != 0 {
                            allowed = 1
                        }
                        bi = bi + 1
                    }
                    if allowed == 0 {
                        diag_error_at("CapabilityBudgetExceeded", CAPABILITY_BUDGET, "function '{fn_name}' uses effect '{eff}' which is not in @capabilities budget", fn_node, "add '{eff}' to @capabilities")
                    }
                    ei = ei + 1
                }
            }
        }
        fi = fi + 1
    }
}

pub fn tc_fn_has_effect(name: Str, eff: Str) -> Int {
    let sig = lookup_fnsig(name)
    if sig == -1 { return 0 }
    let fs = fnsig_pool.get(sig).unwrap()
    let mut i = 0
    while i < fs.effects_count {
        if fnsig_effect_names.get(fs.effects_start + i).unwrap() == eff { return 1 }
        i = i + 1
    }
    0
}

// The built-in method-surface traits are prelude + sealed (nrbq84, §3.2.2 /
// §10.6): user code may neither redefine them nor write an impl of them.
// Single source of truth for both the redefinition check (trait-registration
// loop) and the impl check (validate_trait_impls).
fn is_sealed_builtin_trait(name: Str) -> Int {
    if name == "StrOps" || name == "BytesOps" || name == "StringBuildOps" || name == "Sized" { return 1 }
    if name == "Contains" || name == "ListOps" || name == "MapOps" || name == "SetOps" || name == "Joinable" { return 1 }
    0
}

// A declaration is user-sourced when its module is empty or the synthetic
// main module — the stdlib defs that legitimately back the sealed traits
// carry their dotted module (e.g. "std.traits") during this pass.
fn is_user_sourced(node: Int) -> Int {
    let m = node_module(node)
    if m == "" || m == "__main__" { return 1 }
    0
}

fn register_trait(tr_node: Int) ! TypeCheck.Register {
    let name = node_name(tr_node)
    tc_trait_names.push(name)
    // Collect trait-level type params (e.g., T in trait From[T])
    let tparams_sl = node_type_params(tr_node)
    let tp_start = tc_trait_tparam_names.len()
    let mut tp_count = 0
    if tparams_sl != -1 {
        let mut ti = 0
        while ti < sublist_length(tparams_sl) {
            let tp = sublist_get(tparams_sl, ti)
            tc_trait_tparam_names.push(node_name(tp))
            tp_count = tp_count + 1
            ti = ti + 1
        }
    }
    // wz48pq: record the declared tparam count by trait name for the E0910
    // arity check, independent of whether the trait has any methods.
    tc_trait_tparam_count_idx.insert(name, tp_count)
    let methods_sl = node_methods(tr_node)
    if methods_sl != -1 {
        let mut i = 0
        while i < sublist_length(methods_sl) {
            let m = sublist_get(methods_sl, i)
            let mname = node_name(m)
            tc_trait_method_names.push("{name}.{mname}")
            // Store method signature for contract validation
            let p_start = tc_tmsig_param_names.len()
            let params_sl = node_params(m)
            let mut p_count = 0
            if params_sl != -1 {
                let mut j = 0
                while j < sublist_length(params_sl) {
                    let p = sublist_get(params_sl, j)
                    tc_tmsig_param_names.push(node_type_name(p))
                    p_count = p_count + 1
                    j = j + 1
                }
            }
            tc_tmsig_pool.push(TraitMethodSigEntry { trait_name: name, method: mname, ret: node_return_type(m), tparams_start: tp_start, tparams_count: tp_count, params_start: p_start, params_count: p_count })
            i = i + 1
        }
    }
    let assoc_sl = node_assoc_types(tr_node)
    if assoc_sl != -1 {
        let mut ai = 0
        while ai < sublist_length(assoc_sl) {
            let at_node = sublist_get(assoc_sl, ai)
            let aname = node_name(at_node)
            tc_trait_assoc_names.push("{name}.{aname}")
            ai = ai + 1
        }
    }
}

fn subst_trait_type(type_str: Str, impl_type: Str, tmsig_idx: Int, impl_node: Int) -> Str {
    if type_str == "Self" { return impl_type }
    if type_str.starts_with("Self.") {
        let assoc_name = type_str.substring(5, type_str.len() - 5)
        let assoc_sl = node_assoc_types(impl_node)
        if assoc_sl != -1 {
            let mut ai = 0
            while ai < sublist_length(assoc_sl) {
                let at_node = sublist_get(assoc_sl, ai)
                if node_name(at_node) == assoc_name {
                    return node_type_name(at_node)
                }
                ai = ai + 1
            }
        }
        return type_str
    }
    let _tmsig = tc_tmsig_pool.get(tmsig_idx).unwrap()
    let tp_start = _tmsig.tparams_start
    let tp_count = _tmsig.tparams_count
    if tp_count > 0 {
        let impl_targs_sl = node_type_params(impl_node)
        let mut k = 0
        while k < tp_count {
            let tp_name = tc_trait_tparam_names.get(tp_start + k).unwrap()
            if type_str == tp_name {
                if impl_targs_sl != -1 && k < sublist_length(impl_targs_sl) {
                    return node_name(sublist_get(impl_targs_sl, k))
                }
            }
            k = k + 1
        }
    }
    type_str
}

// True when `name` is declared as a binder in the impl's `impl[T, ...]` list.
fn impl_binder_declared(binders_sl: Int, name: Str) -> Int {
    if binders_sl == -1 { return 0 }
    let mut i = 0
    while i < sublist_length(binders_sl) {
        if node_name(sublist_get(binders_sl, i)) == name {
            return 1
        }
        i = i + 1
    }
    0
}

// True when `name` appears anywhere inside a type annotation tree
// (the annotation's own name, its element args, or a fn return ann).
fn type_ann_mentions(ann: Int, name: Str) -> Int {
    if ann == -1 { return 0 }
    if node_name(ann) == name { return 1 }
    let elems = node_elements(ann)
    if elems != -1 {
        let mut i = 0
        while i < sublist_length(elems) {
            if type_ann_mentions(sublist_get(elems, i), name) != 0 {
                return 1
            }
            i = i + 1
        }
    }
    let ret_ann = node_type_ann(ann)
    if ret_ann != -1 {
        if type_ann_mentions(ret_ann, name) != 0 { return 1 }
    }
    0
}

// True when `name` is mentioned by any type annotation in `args_sl`.
fn type_args_mention(args_sl: Int, name: Str) -> Int {
    if args_sl == -1 { return 0 }
    let mut i = 0
    while i < sublist_length(args_sl) {
        if type_ann_mentions(sublist_get(args_sl, i), name) != 0 {
            return 1
        }
        i = i + 1
    }
    0
}

// Report E0507-style unknown-name errors for each type argument in `args_sl`
// that is neither a declared impl binder, a known type, nor a trait name.
// `where` distinguishes the trait-args site from the receiver-args site.
fn check_impl_type_arg_names(args_sl: Int, binders_sl: Int, trait_name: Str, where: Str, im: Int) ! Diag.Report {
    if args_sl == -1 { return }
    let mut i = 0
    while i < sublist_length(args_sl) {
        let arg_name = node_name(sublist_get(args_sl, i))
        if arg_name != "" && impl_binder_declared(binders_sl, arg_name) == 0 && is_known_type(arg_name) == 0 && is_trait_name(arg_name) == 0 {
            if where == "receiver" {
                diag_error_at("UnknownType", UNKNOWN_TYPE, "unknown type '{arg_name}' in receiver of impl '{trait_name}'", im, "receiver type arguments must be concrete types or names declared in 'impl[...]' binders")
            } else {
                diag_error_at("UnknownType", UNKNOWN_TYPE, "unknown type '{arg_name}' in impl '{trait_name}'", im, "trait type arguments must be concrete types; for a polymorphic impl write 'impl[{arg_name}] {trait_name}[{arg_name}] for ReceiverType[{arg_name}]'")
            }
        }
        i = i + 1
    }
}

fn validate_trait_impls(program: Int) ! TypeCheck.Register, Diag.Report {
    let impls_sl = node_methods(program)
    if impls_sl == -1 { return }
    let mut ii = 0
    while ii < sublist_length(impls_sl) {
        let im = sublist_get(impls_sl, ii)
        let trait_name = node_trait_name(im)
        let impl_type = node_name(im)
        if is_trait_name(trait_name) == 0 {
            diag_error_at("TraitContract", TRAIT_CONTRACT_904, "trait '{trait_name}' is not defined", im, "check the trait name or define 'trait {trait_name} \{ ... }'")
            ii = ii + 1
            continue
        }
        if is_sealed_builtin_trait(trait_name) != 0 && is_user_sourced(im) != 0 {
            diag_error_at("TraitContract", TRAIT_CONTRACT_907, "trait '{trait_name}' is a sealed built-in trait and cannot be implemented for user types", im, "define your own trait with the methods you need and impl that instead")
            ii = ii + 1
            continue
        }
        let binders_sl = node_impl_binders(im)
        let recv_args_sl = node_recv_type_args(im)
        let trait_args_sl = node_type_params(im)
        // A binder declared after `impl` must appear somewhere in the header's
        // type positions (trait args or receiver args); otherwise nothing can
        // ever determine what it stands for.
        if binders_sl != -1 {
            let mut bi = 0
            while bi < sublist_length(binders_sl) {
                let bname = node_name(sublist_get(binders_sl, bi))
                let mut used = type_args_mention(trait_args_sl, bname)
                if used == 0 { used = type_args_mention(recv_args_sl, bname) }
                if used == 0 {
                    diag_error_at("ImplBinderUnused", IMPL_BINDER_UNUSED, "impl binder '{bname}' is not used in the impl header", im, "use '{bname}' in the trait's or the receiver's type arguments, or remove the binder")
                }
                bi = bi + 1
            }
        }
        // Unknown outer names in trait_type_args would otherwise slip past the
        // single-letter carve-out in nr_check_type_ref and silently lower to
        // `void` in codegen. Names declared as impl binders are bound (§3.6)
        // and excluded.
        check_impl_type_arg_names(trait_args_sl, binders_sl, trait_name, "trait", im)
        check_impl_type_arg_names(recv_args_sl, binders_sl, trait_name, "receiver", im)
        // Polymorphic impl headers parse (spec §3.6). The impl binders make `T`
        // a free type var that the contract check below resolves positionally
        // (Self == receiver base, trait tparam name == binder name), so the
        // method-contract / Display / assoc-type checks run for poly impls too.
        // Codegen monomorphization is tracked under project b1bdnh; the E0908
        // gate is emitted after those checks (so a malformed poly impl reports
        // both its specific contract error and E0908) to block codegen.
        let is_poly = if binders_sl != -1 || recv_args_sl != -1 { 1 } else { 0 }
        // ms4ctb: ONLY the canonical builtin form `impl[T] Trait[T] for List[T]`
        // — exactly one impl binder, a List receiver with exactly one type arg,
        // and that type arg IS the binder — is monomorphized in codegen, so it
        // must NOT trip E0908. Codegen assumes the single binder is the List's
        // element type, so any other shape must still be rejected: multi-binder
        // impls (`impl[T,U] Trait[T] for List[U]` would mis-map both binders to
        // the element), binders without a receiver type-arg (Holder), receiver
        // args without binders (Box[Int]), concrete `List[Int]`, user generic
        // structs (Box[T]), and Map/Set receivers.
        let mut poly_supported = 0
        if binders_sl != -1 && recv_args_sl != -1 && impl_type == "List" {
            if sublist_length(binders_sl) == 1 && sublist_length(recv_args_sl) == 1 {
                let binder_name = node_name(sublist_get(binders_sl, 0))
                let recv_arg_name = node_name(sublist_get(recv_args_sl, 0))
                if binder_name != "" && recv_arg_name == binder_name {
                    poly_supported = 1
                }
            }
        }
        // 9jq7qx: a wrong trait-arg count would leave a trait tparam unbound, so
        // subst_trait_type below returns its raw name and the per-param check
        // prints a bogus `expected 'U'`. Report a dedicated arity error instead
        // and skip the per-param comparison (trait_arg_arity_ok) so no unbound
        // name leaks.
        // wz48pq: the count comes from the trait DECLARATION (register_trait
        // records node_type_params by name), not from tc_tmsig_pool -- a
        // methodless trait has no sig entry, so the old per-method scan left
        // trait_tparam_count at -1 and silently skipped the arity check.
        let trait_tparam_count = tc_trait_tparam_count_idx.get(trait_name) ?? -1
        let mut supplied_trait_args = 0
        if trait_args_sl != -1 {
            supplied_trait_args = sublist_length(trait_args_sl)
        }
        let mut trait_arg_arity_ok = 1
        if trait_tparam_count >= 0 && supplied_trait_args != trait_tparam_count {
            trait_arg_arity_ok = 0
            diag_error_at("TraitContract", TRAIT_ARG_ARITY, "impl of trait '{trait_name}' supplies {supplied_trait_args} type argument(s) but '{trait_name}' declares {trait_tparam_count}", im, "supply one type argument per trait type parameter: 'impl {trait_name}[...] for {impl_type}'")
        }
        // 4q2etk: replaced by mwxtyj — Display.display is a synthesized sealed
        // method (decision 344dnd): the compiler derives it from the impl's
        // `fmt`, so a user impl may not define it. The remaining contract
        // checks below still run (a missing `fmt` also reports E0900).
        if trait_name == "Display" {
            let disp_methods_sl = node_methods(im)
            if disp_methods_sl != -1 {
                let mut dmi = 0
                while dmi < sublist_length(disp_methods_sl) {
                    let dm = sublist_get(disp_methods_sl, dmi)
                    if node_name(dm) == "display" {
                        diag_error_at("SealedMethodOverride", SEALED_METHOD_OVERRIDE, "method 'display' of trait 'Display' is sealed and cannot be overridden — it is synthesized from 'fmt'", dm, "implement 'fn fmt(self, sb: StringBuilder)' and remove 'display'; 'display()' is generated from 'fmt'")
                    }
                    dmi = dmi + 1
                }
            }
        }
        // Check each trait method signature against this impl
        let impl_methods_sl = node_methods(im)
        let mut si = 0
        while si < tc_tmsig_pool.len() {
            let tmsig = tc_tmsig_pool.get(si).unwrap()
            if tmsig.trait_name == trait_name {
                let expected_method = tmsig.method
                let mut found = 0
                let mut mi = 0
                if impl_methods_sl != -1 {
                    while mi < sublist_length(impl_methods_sl) {
                        let impl_m = sublist_get(impl_methods_sl, mi)
                        if node_name(impl_m) == expected_method {
                            found = 1
                            // Check arity
                            let trait_pcount = tmsig.params_count
                            let impl_params_sl = node_params(impl_m)
                            let mut impl_pcount = 0
                            if impl_params_sl != -1 {
                                impl_pcount = sublist_length(impl_params_sl)
                            }
                            if trait_pcount != impl_pcount {
                                diag_error_at("TraitContract", TRAIT_CONTRACT_901, "method '{expected_method}' in impl {trait_name} for {impl_type} has {impl_pcount} params, expected {trait_pcount}", impl_m, "trait requires {trait_pcount} parameters (including self)")
                            } else if trait_arg_arity_ok != 0 {
                                // Skipped when the impl's trait-arg arity is
                                // wrong (E0910 already reported): subst_trait_type
                                // would otherwise leak an unbound trait tparam
                                // name into the expected type (9jq7qx).
                                // Check param types
                                let tp_start = tmsig.params_start
                                let mut pi = 0
                                while pi < trait_pcount {
                                    let trait_ptype = tc_tmsig_param_names.get(tp_start + pi).unwrap()
                                    if trait_ptype != "" {
                                        let impl_p = sublist_get(impl_params_sl, pi)
                                        let raw_impl_ptype = node_type_name(impl_p)
                                        let impl_ptype = if raw_impl_ptype == "Self" { impl_type } else { raw_impl_ptype }
                                        let expected_type = subst_trait_type(trait_ptype, impl_type, si, im)
                                        if impl_ptype != expected_type {
                                            diag_error_at("TraitContract", TRAIT_CONTRACT_902, "method '{expected_method}' param has type '{impl_ptype}', expected '{expected_type}'", impl_p, "change type to '{expected_type}' to match trait {trait_name}")
                                        }
                                    }
                                    pi = pi + 1
                                }
                                // Check return type
                                let trait_ret = tmsig.ret
                                if trait_ret != "" {
                                    let raw_impl_ret = node_return_type(impl_m)
                                    let impl_ret = if raw_impl_ret == "Self" { impl_type } else { raw_impl_ret }
                                    let expected_ret = subst_trait_type(trait_ret, impl_type, si, im)
                                    if impl_ret != expected_ret {
                                        diag_error_at("TraitContract", TRAIT_CONTRACT_903, "method '{expected_method}' returns '{impl_ret}', expected '{expected_ret}'", impl_m, "change return type to '{expected_ret}' to match trait {trait_name}")
                                    }
                                }
                            }
                            break
                        }
                        mi = mi + 1
                    }
                }
                if found == 0 {
                    diag_error_at("TraitContract", TRAIT_CONTRACT_900, "impl {trait_name} for {impl_type} is missing method '{expected_method}'", im, "add 'fn {expected_method}(...)' to the impl block")
                }
            }
            si = si + 1
        }
        let impl_assoc_sl = node_assoc_types(im)
        let mut ati = 0
        while ati < tc_trait_assoc_names.len() {
            let full_name = tc_trait_assoc_names.get(ati).unwrap()
            if full_name.starts_with("{trait_name}.") {
                let expected_assoc = full_name.substring(trait_name.len() + 1, full_name.len() - trait_name.len() - 1)
                let mut found_assoc = 0
                if impl_assoc_sl != -1 {
                    let mut aj = 0
                    while aj < sublist_length(impl_assoc_sl) {
                        let at_node = sublist_get(impl_assoc_sl, aj)
                        if node_name(at_node) == expected_assoc {
                            found_assoc = 1
                            break
                        }
                        aj = aj + 1
                    }
                }
                if found_assoc == 0 {
                    diag_error_at("TraitContract", TRAIT_CONTRACT_905, "impl {trait_name} for {impl_type} is missing associated type '{expected_assoc}'", im, "add 'type {expected_assoc} = ...' to the impl block")
                }
            }
            ati = ati + 1
        }
        if is_poly != 0 && poly_supported == 0 {
            diag_error_at("PolyImplUnsupported", POLY_IMPL_UNSUPPORTED, "polymorphic impls are not yet compiled", im, "spec §3.6 defines 'impl[T] {trait_name}[T] for Recv[T]', but compiled support is still in progress (project b1bdnh); write a separate impl per concrete type for now")
        }
        let conflict_trait = if trait_name == "BlockHandler" { "Closeable" } else if trait_name == "Closeable" { "BlockHandler" } else { "" }
        if conflict_trait != "" {
            let mut ci = 0
            while ci < sublist_length(impls_sl) {
                let other = sublist_get(impls_sl, ci)
                if node_trait_name(other) == conflict_trait && node_name(other) == impl_type {
                    diag_error_at("TraitContract", TRAIT_CONTRACT_906, "type '{impl_type}' cannot implement both Closeable and BlockHandler (ambiguous with-block semantics)", im, "remove one of the impl blocks")
                    break
                }
                ci = ci + 1
            }
        }
        ii = ii + 1
    }
}

// ── Main entry point ────────────────────────────────────────────────

fn init_types() ! TypeCheck.Register {
    ty_pool.clear()
    ty_param_list.clear()
    tc_node_tid.clear()
    let mut nti = 0
    while nti < node_count() {
        tc_node_tid.push(-1)
        nti = nti + 1
    }
    named_type_names.clear()
    named_type_ids.clear()
    named_type_map.clear()
    tc_hashable_types.clear()
    tc_debug_types.clear()
    tc_type_decl_nodes.clear()
    tc_alias_underlying = Map()
    sfield_pool.clear()
    nr_callable_field_names.clear()
    evar_pool.clear()
    evfield_pool.clear()
    fnsig_pool.clear()
    fnsig_map.clear()
    fnsig_param_list.clear()
    fnsig_type_param_names.clear()
    fnsig_effect_names.clear()
    tc_trait_names.clear()
    tc_trait_method_names.clear()
    tc_trait_assoc_names.clear()
    tc_display_impl_types.clear()
    tc_method_trait_count_idx.clear()
    tc_method_trait_names_idx.clear()
    tc_tmsig_pool.clear()
    tc_tmsig_param_names.clear()
    tc_trait_tparam_names.clear()
    tc_trait_tparam_count_idx.clear()
    tc_current_fn_ret = -1
    tc_current_fn_name = ""
    tc_suppress_ann_validation = 0
    tc_errors.clear()
    tc_warnings.clear()
    depr_fn_nodes.clear()
    depr_type_nodes.clear()
    tc_struct_decl_nodes.clear()
    tc_variant_enum_decl_nodes.clear()
    tc_collision_reported.clear()
    ffi_struct_type_set.clear()
    tc_symbol_module.clear()
    tc_prelude_free_fn.clear()
    tc_used_modules.clear()
    tc_hints.clear()
    tc_pure_fns.clear()
    tc_fn_node_by_name.clear()
    pv_in_old_depth = 0
    tc_build_import_map()

    TYPE_INT = new_type(TK_INT, "Int")
    TYPE_FLOAT = new_type(TK_FLOAT, "Float")
    TYPE_BOOL = new_type(TK_BOOL, "Bool")
    TYPE_STR = new_type(TK_STR, "Str")
    TYPE_VOID = new_type(TK_VOID, "Void")
    TYPE_UNKNOWN = new_type(TK_UNKNOWN, "?")
    TYPE_I8 = new_type(TK_I8, "I8")
    TYPE_I16 = new_type(TK_I16, "I16")
    TYPE_I32 = new_type(TK_I32, "I32")
    TYPE_U8 = new_type(TK_U8, "U8")
    TYPE_U16 = new_type(TK_U16, "U16")
    TYPE_U32 = new_type(TK_U32, "U32")
    TYPE_U64 = new_type(TK_U64, "U64")
    TYPE_CHAR = new_type(TK_CHAR, "Char")
}

pub fn check_types(program: Int) -> Int ! TypeCheck, Diag.Report {
    if trace_mode != "" { trace("typecheck", "start") }
    init_types()

    // Register all type definitions (structs and enums)
    let types_sl = node_fields(program)
    if types_sl != -1 {
        let mut i = 0
        while i < sublist_length(types_sl) {
            let td = sublist_get(types_sl, i)
            let td_flds = node_fields(td)
            let mut is_enum = 0
            if td_flds != -1 && sublist_length(td_flds) > 0 {
                if node_kind(sublist_get(td_flds, 0)) == NodeKind.TypeVariant {
                    is_enum = 1
                }
            }
            if is_enum != 0 {
                register_enum_type(td)
            } else {
                register_struct_type(td)
            }
            i = i + 1
        }
    }

    // Kind A: a struct name equal to an enum variant name is a hard error (E0518).
    // Detected over the whole-program symbol table (catches cross-module collisions).
    tc_check_name_collisions()

    // @derive(Debug) requires every user-type field to also derive Debug.
    tc_check_derive_debug()

    // @derive(Hash/Eq/Ord) requires every field's type to implement that trait
    // (spec §3.6.6 NonDerivableTrait, E1401).
    tc_check_derive_hash_eq_ord()

    // Register all function signatures
    let fns_sl = node_params(program)
    if fns_sl != -1 {
        let mut i = 0
        while i < sublist_length(fns_sl) {
            register_fn_sig(sublist_get(fns_sl, i))
            i = i + 1
        }
    }

    // Validate FFI annotations and Ptr[T] usage
    if fns_sl != -1 {
        let mut i = 0
        while i < sublist_length(fns_sl) {
            validate_ffi_fn(sublist_get(fns_sl, i))
            i = i + 1
        }
    }

    // Build the @pure registry first so the predicate validator can
    // consult it when a contract calls a user helper.
    if fns_sl != -1 {
        tc_register_pure_fns(fns_sl)
    }

    // Validate contract predicates against the SMT-decidable subset.
    // Runs before name resolution so reserved names (`result`, `old`)
    // surface as E1304/E1305 rather than as generic E0506/E0504.
    if fns_sl != -1 {
        let mut i = 0
        while i < sublist_length(fns_sl) {
            pv_validate_fn_contracts(sublist_get(fns_sl, i))
            i = i + 1
        }
    }
    if types_sl != -1 {
        let mut i = 0
        while i < sublist_length(types_sl) {
            pv_validate_type_alias(sublist_get(types_sl, i))
            i = i + 1
        }
    }

    // Enforce @pure body constraints.
    if fns_sl != -1 {
        let mut i = 0
        while i < sublist_length(fns_sl) {
            tc_check_pure(sublist_get(fns_sl, i))
            i = i + 1
        }
    }

    validate_capabilities_budget(program, fns_sl)

    // Build symbol-to-module map for unused import detection
    if types_sl != -1 {
        let mut i = 0
        while i < sublist_length(types_sl) {
            let td = sublist_get(types_sl, i)
            let mod_name = node_module(td)
            if mod_name != "" && mod_name != "__main__" {
                tc_symbol_module.insert(node_name(td), mod_name)
                let td_flds = node_fields(td)
                if td_flds != -1 {
                    let mut j = 0
                    while j < sublist_length(td_flds) {
                        let fld = sublist_get(td_flds, j)
                        if node_kind(fld) == NodeKind.TypeVariant {
                            tc_symbol_module.insert(node_name(fld), mod_name)
                        }
                        j = j + 1
                    }
                }
            }
            i = i + 1
        }
    }
    if fns_sl != -1 {
        let mut i = 0
        while i < sublist_length(fns_sl) {
            let fn_node = sublist_get(fns_sl, i)
            let mod_name = node_module(fn_node)
            if mod_name != "" && mod_name != "__main__" {
                let fn_sym_name = node_name(fn_node)
                tc_symbol_module.insert(fn_sym_name, mod_name)
                // A free function defined in a prelude module is NOT auto-visible
                // (§3.2.3) — record it so a bare call lacking an explicit import
                // is rejected (nr_is_unimported_prelude_free_fn, fsmwz2).
                if tc_prelude_modules.contains_key(mod_name) {
                    tc_prelude_free_fn.insert(fn_sym_name, 1)
                }
                match tc_original_to_alias.get(fn_sym_name) {
                    Some(alias) => tc_symbol_module.insert(alias, mod_name)
                    None => {}
                }
            }
            i = i + 1
        }
    }
    let lets_sl_sym = node_stmts(program)
    if lets_sl_sym != -1 {
        let mut i = 0
        while i < sublist_length(lets_sl_sym) {
            let l = sublist_get(lets_sl_sym, i)
            let mod_name = node_module(l)
            if mod_name != "" && mod_name != "__main__" {
                tc_symbol_module.insert(node_name(l), mod_name)
            }
            i = i + 1
        }
    }

    // Register traits
    let traits_sl = node_arms(program)
    if traits_sl != -1 {
        let mut i = 0
        while i < sublist_length(traits_sl) {
            let tr = sublist_get(traits_sl, i)
            if is_sealed_builtin_trait(node_name(tr)) != 0 && is_user_sourced(tr) != 0 {
                diag_error_at("TraitContract", TRAIT_CONTRACT_907, "trait '{node_name(tr)}' is a sealed built-in trait and cannot be redefined", tr, "rename your trait, or define your own trait with the methods you need")
            }
            register_trait(tr)
            i = i + 1
        }
    }
    // Register builtin trait names (handled specially in codegen, no AST nodes)
    tc_trait_names.push("From")
    tc_trait_names.push("TryFrom")
    tc_trait_names.push("Into")
    tc_trait_names.push("Iterator")
    tc_trait_names.push("IntoIterator")
    // wz48pq: these builtins are single-tparam (From[T], Into[T], ...); record
    // their arity so E0910 fires for impls that supply the wrong count. From/
    // Into/TryFrom are also declared in lib/std/traits.bl and pass through
    // register_trait -- the Map is keyed by name so last-write-wins agrees (1).
    tc_trait_tparam_count_idx.insert("From", 1)
    tc_trait_tparam_count_idx.insert("TryFrom", 1)
    tc_trait_tparam_count_idx.insert("Into", 1)
    tc_trait_tparam_count_idx.insert("Iterator", 1)
    tc_trait_tparam_count_idx.insert("IntoIterator", 1)

    // Register impl method signatures
    let impls_sl = node_methods(program)
    if impls_sl != -1 {
        let mut i = 0
        while i < sublist_length(impls_sl) {
            let im = sublist_get(impls_sl, i)
            let impl_type = node_name(im)
            let trait_name = node_trait_name(im)
            // 4q2etk: replaced by mwxtyj — record Display impls so infer_type
            // can resolve the synthesized display() to Str.
            if trait_name == "Display" {
                tc_display_impl_types.push(impl_type)
                // The synthesized sealed `display()` makes `display` resolvable
                // on this type; record it as a Display-owned method so a foreign
                // trait's `display` registers as a second owner (sb3125/bsn3s9).
                tc_record_method_trait(impl_type, "display", "Display")
            }
            let methods_sl = node_methods(im)
            if methods_sl != -1 {
                let mut j = 0
                while j < sublist_length(methods_sl) {
                    let m = sublist_get(methods_sl, j)
                    let orig_name = node_name(m)
                    // From/TryFrom keep their source-typed symbol scheme; all
                    // other impl methods register under the trait-qualified key
                    // so two traits sharing a method name don't overwrite.
                    let mangled = tc_mangle_impl_fnsig(impl_type, trait_name, orig_name, im)
                    tc_record_method_trait(impl_type, orig_name, trait_name)
                    node_set_name(m, mangled)
                    register_fn_sig(m)
                    node_set_name(m, orig_name)
                    j = j + 1
                }
            }
            i = i + 1
        }
    }

    // Validate trait impl contracts
    validate_trait_impls(program)

    // Register user-defined effect handle names
    tc_ue_handles = []
    let effects_decl_sl = node_args(program)
    if effects_decl_sl != -1 {
        let mut ei = 0
        while ei < sublist_length(effects_decl_sl) {
            let ed = sublist_get(effects_decl_sl, ei)
            let eff_name = node_name(ed)
            register_ue_handle(str_to_lower(eff_name))
            ei = ei + 1
        }
    }

    // Build symbol-to-module map (continued): impls, traits, effects
    if impls_sl != -1 {
        let mut i = 0
        while i < sublist_length(impls_sl) {
            let im = sublist_get(impls_sl, i)
            let mod_name = node_module(im)
            if mod_name != "" && mod_name != "__main__" {
                let impl_type = node_name(im)
                let trait_name = node_trait_name(im)
                tc_symbol_module.insert(impl_type, mod_name)
                let methods_sl_sym = node_methods(im)
                if methods_sl_sym != -1 {
                    let mut j = 0
                    while j < sublist_length(methods_sl_sym) {
                        let m = sublist_get(methods_sl_sym, j)
                        tc_symbol_module.insert(tc_mangle_impl_fnsig(impl_type, trait_name, node_name(m), im), mod_name)
                        j = j + 1
                    }
                }
            }
            i = i + 1
        }
    }
    if traits_sl != -1 {
        let mut i = 0
        while i < sublist_length(traits_sl) {
            let tr = sublist_get(traits_sl, i)
            let mod_name = node_module(tr)
            if mod_name != "" && mod_name != "__main__" {
                tc_symbol_module.insert(node_name(tr), mod_name)
            }
            i = i + 1
        }
    }
    let effects_sl_sym = node_args(program)
    if effects_sl_sym != -1 {
        let mut i = 0
        while i < sublist_length(effects_sl_sym) {
            let ed = sublist_get(effects_sl_sym, i)
            let mod_name = node_module(ed)
            if mod_name != "" && mod_name != "__main__" {
                tc_symbol_module.insert(node_name(ed), mod_name)
            }
            i = i + 1
        }
    }

    // Remap tc_symbol_module for pub import re-exports
    tc_apply_reexport_remapping()

    // Phase 1: Name resolution
    resolve_names(program)
    nr_warn_unused = 0

    // Phase 2: Expression type inference
    tc_infer_program(program)

    if trace_mode != "" { trace("typecheck", "done ({tc_errors.len()} errors)") }
    tc_errors.len()
}

// ── User-effect handle name tracking ────────────────────────────────

let mut tc_ue_handles: List[Str] = []

fn register_ue_handle(name: Str) {
    tc_ue_handles.push(name)
}

fn is_user_effect_handle_name(name: Str) -> Int {
    let mut i = 0
    while i < tc_ue_handles.len() {
        if tc_ue_handles.get(i).unwrap() == name {
            return 1
        }
        i = i + 1
    }
    0
}

// ── Selective import filtering ──────────────────────────────────────
pub let mut tc_import_modules: List[Str] = []
pub let mut tc_import_qualifiers: List[Str] = []
pub let mut tc_import_nodes: List[Int] = []
let mut tc_module_import_node: Map[Str, Int] = Map()
let mut tc_qualifier_to_module: Map[Str, Str] = Map()
let mut tc_import_modules_idx: Map[Str, Int] = Map()
let mut tc_import_qualifiers_set: Map[Str, Int] = Map()

// ── Pub import re-export tracking ──────────────────────────────────
// Key: "reexporting_mod:item_name" → source module name (selective re-exports)
// Key: "reexporting_mod:*:source_mod" → source module name (wildcard re-exports)
pub let mut tc_reexport_source: Map[Str, Str] = Map()
pub let mut tc_reexport_modules: Map[Str, Int] = Map()

fn tc_apply_reexport_remapping() {
    let keys = tc_reexport_source.keys()
    let mut i = 0
    while i < keys.len() {
        let key = keys.get(i).unwrap()
        let colon_idx = key.index_of(":")
        if colon_idx > 0 {
            let reexporter = key.substring(0, colon_idx)
            let rest = key.substring(colon_idx + 1, key.len() - colon_idx - 1)
            if rest.starts_with("*:") {
                let source_mod = rest.substring(2, rest.len() - 2)
                let sym_keys = tc_symbol_module.keys()
                let mut si = 0
                while si < sym_keys.len() {
                    let sym = sym_keys.get(si).unwrap()
                    if tc_symbol_module.get(sym).unwrap() == source_mod {
                        tc_symbol_module.insert(sym, reexporter)
                    }
                    si = si + 1
                }
            } else {
                let item_name = rest
                match tc_symbol_module.get(item_name) {
                    Some(current_mod) => {
                        let source_mod = tc_reexport_source.get(key).unwrap()
                        if current_mod == source_mod {
                            tc_symbol_module.insert(item_name, reexporter)
                        }
                    }
                    None => {}
                }
            }
        }
        i = i + 1
    }
}

fn tc_build_import_map() {
    tc_module_import_node = Map()
    tc_qualifier_to_module = Map()
    tc_alias_to_original = Map()
    tc_original_to_alias = Map()
    tc_import_modules_idx = Map()
    tc_import_qualifiers_set = Map()
    let mut i = 0
    while i < tc_import_modules.len() {
        let mod_key = tc_import_modules.get(i).unwrap()
        tc_import_modules_idx.insert(mod_key, i)
        let node_id = tc_import_nodes.get(i).unwrap()
        if i < tc_import_qualifiers.len() {
            let qual = tc_import_qualifiers.get(i).unwrap()
            if qual != "" && qual != mod_key {
                tc_qualifier_to_module.insert(qual, mod_key)
            }
            if qual != "" {
                tc_import_qualifiers_set.insert(qual, 1)
            }
        }
        if node_id != -1 {
            tc_module_import_node.insert(mod_key, node_id)
            let names_sl = node_args(node_id)
            if names_sl != -1 {
                let mut j = 0
                while j < sublist_length(names_sl) {
                    let name_node = sublist_get(names_sl, j)
                    let alias = node_str_val(name_node)
                    if alias != "" {
                        let original = node_name(name_node)
                        tc_alias_to_original.insert(alias, original)
                        tc_original_to_alias.insert(original, alias)
                    }
                    j = j + 1
                }
            }
        }
        i = i + 1
    }
}

fn is_selected_import(name: Str, imp_node: Int) -> Int {
    let names_sl = node_args(imp_node)
    if names_sl == -1 { return 0 }
    let mut i = 0
    while i < sublist_length(names_sl) {
        let name_node = sublist_get(names_sl, i)
        if node_name(name_node) == name { return 1 }
        let alias = node_str_val(name_node)
        if alias != "" && alias == name { return 1 }
        i = i + 1
    }
    0
}

pub fn is_import_module_name(name: Str) -> Int {
    if tc_import_modules_idx.contains_key(name) { return 1 }
    if tc_import_qualifiers_set.contains_key(name) { return 1 }
    0
}

fn tc_get_dotted_module_path(mod_key: Str) -> Str {
    match tc_module_import_node.get(mod_key) {
        Some(imp_node) => {
            let dotted = node_str_val(imp_node)
            if dotted != "" {
                return dotted
            }
        }
        None => {}
    }
    mod_key
}

fn is_filtered_for_module(name: Str, source_mod: Str, consuming_mod: Str) -> Int {
    if source_mod == consuming_mod { return 0 }
    if source_mod == "" || source_mod == "__main__" { return 0 }
    if consuming_mod == "" { return 0 }
    let key = "{consuming_mod}:{source_mod}"
    match per_module_imports.get(key) {
        Some(imp_node) => {
            if imp_node == -1 { return 1 }
            return is_selected_import(name, imp_node) == 0
        }
        None => {}
    }
    0
}

// True when `name` is a free function exported by a prelude module that the
// current module did NOT explicitly import. The prelude contributes
// compiler-known types/traits/impls unconditionally, but its free functions
// require an explicit `import` (§3.2.3) — a bare call to one is an undefined
// reference (E0504, §6.3.5), NOT an ImportNotSelected. (fsmwz2)
fn nr_is_unimported_prelude_free_fn(name: Str) -> Int {
    // Only prelude-module free fns are recorded here, so membership already
    // implies the source is a prelude module.
    if tc_prelude_free_fn.contains_key(name) == 0 { return 0 }
    let source_mod = match tc_symbol_module.get(name) {
        Some(v) => v
        None => return 0
    }
    if nr_current_module == source_mod { return 0 }
    // An explicit import (bare or selective-including-name) makes it visible.
    let key = "{nr_current_module}:{source_mod}"
    match per_module_imports.get(key) {
        Some(imp_node) => {
            if imp_node == -1 { return 0 }
            if is_selected_import(name, imp_node) != 0 { return 0 }
        }
        None => {}
    }
    1
}

fn is_builtin_name(name: Str) -> Int {
    if is_primitive_type(name) != 0 { return 1 }
    if is_builtin_fn(name) != 0 { return 1 }
    0
}

fn tc_qualifier_for_module(mod_key: Str) -> Str {
    match tc_import_modules_idx.get(mod_key) {
        Some(idx) => {
            if idx < tc_import_qualifiers.len() {
                let q = tc_import_qualifiers.get(idx).unwrap()
                if q != "" {
                    return q
                }
            }
            return mod_key
        }
        None => {}
    }
    mod_key
}

// Inverse of tc_qualifier_for_module: an import qualifier (the leaf the user
// writes before `.`, e.g. "libc") -> the module key stored in tc_symbol_module
// values (e.g. "std_libc"). Falls back to the qualifier when no alias mapping
// exists (qual == key).
pub fn tc_qualifier_to_module_or_self(qualifier: Str) -> Str {
    match tc_qualifier_to_module.get(qualifier) {
        Some(mod_name) => mod_name
        None => qualifier
    }
}

fn nr_check_selective_access(name: Str, node: Int) -> Int ! Diag.Report {
    if nr_current_module == "" { return 0 }
    if is_builtin_name(name) != 0 { return 0 }
    let source_mod = match tc_symbol_module.get(name) {
        Some(v) => v
        None => return 0
    }
    if is_filtered_for_module(name, source_mod, nr_current_module) != 0 {
        let display_mod = tc_qualifier_for_module(source_mod)
        if node == -1 {
            diag_error_no_loc("ImportNotSelected", IMPORT_NOT_SELECTED, "'{name}' is not in scope — add it to the import list or use qualified access '{display_mod}.{name}'", "add '{name}' to your selective import")
        } else {
            diag_error_at("ImportNotSelected", IMPORT_NOT_SELECTED, "'{name}' is not in scope — add it to the import list or use qualified access '{display_mod}.{name}'", node, "add '{name}' to your selective import")
        }
        return 1
    }
    0
}

// ── Import visibility ───────────────────────────────────────────────

let mut nr_private_imports: Map[Str, Str] = Map()
let mut nr_current_module: Str = ""
let mut nr_name_source_module: Map[Str, Str] = Map()

fn nr_check_ambiguity(name: Str, mod_name: Str, local_names: Map[Str, Int]) ! Diag.Report {
    if mod_name == "" || mod_name == "__main__" { return }
    if nr_private_imports.contains_key(name) { return }
    if local_names.contains_key(name) { return }
    match nr_name_source_module.get(name) {
        Some(existing_mod) => {
            if existing_mod != mod_name && existing_mod != "__main__" {
                diag_error_no_loc("AmbiguousImport", AMBIGUOUS_IMPORT, "name '{name}' is ambiguous — imported from both '{existing_mod}' and '{mod_name}'", "use selective imports to disambiguate, e.g. import {existing_mod}.\{name}")
            }
        }
        None => nr_name_source_module.insert(name, mod_name)
    }
}

fn is_private_access(name: Str) -> Int {
    // Builtin names (primitive types + builtin fns/variants like Ok/Err/Some/Map)
    // can never be private — a user cannot make a builtin private, so a colliding
    // user variant must not poison the verdict. Mirrors nr_check_selective_access.
    if is_builtin_name(name) != 0 { return 0 }
    let mods = match nr_private_imports.get(name) {
        Some(v) => v
        None => return 0
    }
    if mods.contains("|{nr_current_module}|") != 0 { return 0 }
    1
}

// Emit E1003 PrivateItemAccess for `name` on `node`, choosing the noun
// (variant / type / trait / function) the same way the bare-Ident handler does,
// so a qualified access (mod.Name) is labelled identically to a bare one.
// Caller must have already checked is_private_access(name) != 0.
fn nr_emit_private_access(name: Str, node: Int) ! Diag.Report {
    if is_variant_name(name) != 0 {
        tc_errors.push("cannot access private variant '{name}'")
        diag_error_at("PrivateItemAccess", PRIVATE_ITEM_ACCESS, "cannot access private variant '{name}' from another module", node, "mark the enum as 'pub' in its module")
    } else if is_known_type(name) != 0 {
        tc_errors.push("cannot access private type '{name}'")
        diag_error_at("PrivateItemAccess", PRIVATE_ITEM_ACCESS, "cannot access private type '{name}' from another module", node, "mark the type as 'pub' in its module")
    } else if is_trait_name(name) != 0 {
        tc_errors.push("cannot access private trait '{name}'")
        diag_error_at("PrivateItemAccess", PRIVATE_ITEM_ACCESS, "cannot access private trait '{name}' from another module", node, "mark the trait as 'pub' in its module")
    } else {
        tc_errors.push("cannot access private function '{name}'")
        diag_error_at("PrivateItemAccess", PRIVATE_ITEM_ACCESS, "cannot access private function '{name}' from another module", node, "mark the function as 'pub' in its module")
    }
}

fn nr_register_private(name: Str, mod_name: Str) {
    match nr_private_imports.get(name) {
        Some(prev) => nr_private_imports.insert(name, "{prev}{mod_name}|")
        None => nr_private_imports.insert(name, "|{mod_name}|")
    }
}

// ── Name resolution scope ───────────────────────────────────────────

let mut nr_scope_names: List[Str] = []
let mut nr_scope_muts: List[Int] = []
let mut nr_scope_types: List[Int] = []
let mut nr_scope_reads: List[Int] = []
let mut nr_scope_writes: List[Int] = []
let mut nr_scope_nodes: List[Int] = []
// Sticky-read flag: if set, nr_mark_written won't clear the read flag. Used
// for vars captured by a closure — subsequent writes are observable through
// closure calls, so the original read shouldn't be dismissed as "dead".
let mut nr_scope_captured: List[Int] = []
// Shadow chain: nr_scope_prev[i] is the index of the previous entry with the
// same name (the one this entry shadows), or -1 if none. Lets nr_pop_scope
// restore nr_name_top to the prior binding without a linear scan.
let mut nr_scope_prev: List[Int] = []
// Top-of-stack index per name: O(1) lookup for nr_is_defined / nr_is_mut /
// nr_get_type / nr_mark_written. Keys absent ⇒ name not currently in scope.
let mut nr_name_top: Map[Str, Int] = Map()
let mut nr_scope_frames: List[Int] = []
let mut nr_scope_depth: Int = 0
let mut nr_loop_depth: Int = 0
let mut nr_in_closure_depth: Int = 0
let mut nr_with_ptr_depth: Int = 0
let mut nr_warn_unused: Int = 0

// Push a new entry into the parallel scope arrays and update nr_name_top.
// All nr_define* functions must route through here to keep the shadow chain
// intact. The .insert at the end overwrites any prior nr_name_top entry by
// design — we captured the displaced index in nr_scope_prev so pop can
// restore it.
fn nr_scope_push_entry(name: Str, is_mut: Int, tid: Int, node: Int) {
    let new_idx = nr_scope_names.len()
    let mut prev = -1
    match nr_name_top.get(name) {
        Some(p) => prev = p
        None => {}
    }
    nr_scope_names.push(name)
    nr_scope_muts.push(is_mut)
    nr_scope_types.push(tid)
    nr_scope_reads.push(0)
    nr_scope_writes.push(1)
    nr_scope_nodes.push(node)
    nr_scope_captured.push(0)
    nr_scope_prev.push(prev)
    nr_name_top.insert(name, new_idx)
}

fn nr_push_scope() {
    nr_scope_frames.push(nr_scope_names.len())
    nr_scope_depth = nr_scope_depth + 1
}

fn nr_pop_scope() ! Diag.Report {
    if nr_scope_frames.len() == 0 {
        return
    }
    let start = nr_scope_frames.get(nr_scope_frames.len() - 1).unwrap()
    nr_scope_frames.pop()
    let emit_unused = nr_warn_unused != 0 && nr_scope_depth > 1
    // Fused loop: emit unused-variable warnings AND restore nr_name_top AND
    // pop the parallel arrays in a single back-to-front pass over [start, len).
    while nr_scope_names.len() > start {
        let idx = nr_scope_names.len() - 1
        let nm = nr_scope_names.get(idx).unwrap()
        if emit_unused {
            if nr_scope_reads.get(idx).unwrap() == 0 && nm.len() > 0 && nm.byte_at(0) != 95 { // '_'
                let nd = nr_scope_nodes.get(idx).unwrap()
                if nd != -1 {
                    if nr_scope_writes.get(idx).unwrap() > 1 {
                        diag_warn_at("SetButNotRead", SET_BUT_NOT_READ, "variable '{nm}' is assigned a value that is never read", nd, "remove the unused assignment, or prefix with '_' to suppress")
                    } else {
                        diag_warn_at("UnusedVariable", UNUSED_VARIABLE, "variable '{nm}' is never read", nd, "prefix with '_' to suppress this warning")
                    }
                }
            }
        }
        let prev = nr_scope_prev.get(idx).unwrap()
        if prev == -1 {
            nr_name_top.remove(nm)
        } else {
            nr_name_top.insert(nm, prev)
        }
        nr_scope_names.pop()
        nr_scope_muts.pop()
        nr_scope_types.pop()
        nr_scope_reads.pop()
        nr_scope_writes.pop()
        nr_scope_nodes.pop()
        nr_scope_captured.pop()
        nr_scope_prev.pop()
    }
    nr_scope_depth = nr_scope_depth - 1
}

fn nr_define(name: Str) {
    nr_scope_push_entry(name, 0, TYPE_UNKNOWN, -1)
}

fn nr_check_shadow(name: Str, node: Int) ! Diag.Report {
    if nr_warn_unused == 0 { return }
    if name.len() == 0 { return }
    if name.byte_at(0) == 95 { return } // '_'
    if nr_scope_depth <= 1 { return }
    if nr_scope_frames.len() == 0 { return }
    let frame_start = nr_scope_frames.get(nr_scope_frames.len() - 1).unwrap()
    // Walk the shadow chain from the newest entry back to the first one
    // that lives outside this frame — that's the shadowed outer binding.
    let mut idx = -1
    match nr_name_top.get(name) {
        Some(t) => idx = t
        None => return
    }
    while idx >= frame_start {
        idx = nr_scope_prev.get(idx).unwrap()
        if idx == -1 { return }
    }
    // A local binding that "shadows" a same-named top-level symbol from a
    // DIFFERENT module is not a real lexical shadow — it's a cross-module name
    // collision (e.g. a stdlib param colliding with a user's top-level free
    // fn). Suppress W0603 only in that case (br xfbezd). A genuine same-module
    // top-level shadow (a function-local rebinding a module-level let/fn) still
    // warns.
    if nr_scope_frames.len() >= 2 {
        let first_inner = nr_scope_frames.get(1).unwrap()
        if idx < first_inner {
            let sym_mod = tc_get_symbol_module(name)
            if sym_mod != "" && sym_mod != nr_current_module { return }
            // User top-level symbols (module __main__) are intentionally never
            // recorded in tc_symbol_module (see the mod_name != "__main__" guards
            // at registration), so their module reads back as "". When we're
            // checking inside a real non-main module body (e.g. a stdlib fn's
            // closure param), an unknown outer-symbol module can only be a
            // user/__main__ global — a DIFFERENT module from the current one, so
            // it's the same cross-module collision, not a lexical shadow. Suppress.
            if sym_mod == "" && nr_current_module != "" && nr_current_module != "__main__" { return }
        }
    }
    diag_warn_at("ShadowedVariable", SHADOWED_VARIABLE, "variable '{name}' shadows a variable from an outer scope", node, "rename the variable or prefix with '_' to suppress")
}

fn nr_define_at(name: Str, node: Int) ! Diag.Report {
    if node != -1 && nr_current_module != "" {
        node_set_module(node, nr_current_module)
    }
    nr_check_shadow(name, node)
    nr_scope_push_entry(name, 0, TYPE_UNKNOWN, node)
}

fn nr_define_mut(name: Str, is_mut: Int) {
    nr_scope_push_entry(name, is_mut, TYPE_UNKNOWN, -1)
}

fn nr_define_mut_at(name: Str, is_mut: Int, node: Int) ! Diag.Report {
    if node != -1 && nr_current_module != "" {
        node_set_module(node, nr_current_module)
    }
    nr_check_shadow(name, node)
    nr_scope_push_entry(name, is_mut, TYPE_UNKNOWN, node)
}

fn nr_define_typed(name: Str, is_mut: Int, tid: Int) {
    nr_scope_push_entry(name, is_mut, tid, -1)
}

// match-with-return per arm (instead of `let x = match { ... }` as an
// expression) is a workaround for a codegen issue where binding a match
// expression whose arms `return` from the enclosing fn produces wrong C.
// Applies to nr_is_mut / nr_get_type / nr_check_shadow below too.
fn nr_is_defined(name: Str) -> Int {
    match nr_name_top.get(name) {
        Some(i) => {
            nr_scope_reads.set(i, 1)
            // If the read happens inside a closure body, the capture may be
            // observed on a later call — don't let subsequent writes in the
            // enclosing scope cancel this read (W0601 false positive).
            if nr_in_closure_depth > 0 {
                // Only mark entries in enclosing scopes (outside the closure
                // frame) as captured. Locals inside the closure are walked
                // the normal way.
                let mut frame_start = 0
                if nr_scope_frames.len() > 0 {
                    frame_start = nr_scope_frames.get(nr_scope_frames.len() - 1).unwrap()
                }
                if i < frame_start {
                    nr_scope_captured.set(i, 1)
                }
            }
            return 1
        }
        None => {}
    }
    0
}

// Whether `name`'s current top binding lives in the global frame (depth 1).
// A cross-module private-access violation can only legitimately apply to a
// real top-level free-fn/let reference (global frame); when a name resolves to
// an inner frame (a param/local that merely shadows a same-named private
// top-level symbol in another module) it is NOT a cross-module access, so
// E1003 must not fire (br xfbezd). Pure inspection — must not call
// nr_is_defined (which has read/capture side effects).
fn nr_top_binding_is_global(name: Str) -> Int {
    let idx = match nr_name_top.get(name) {
        Some(i) => i
        None => return 0
    }
    if nr_scope_frames.len() < 2 {
        return 1
    }
    let first_inner = nr_scope_frames.get(1).unwrap()
    if idx < first_inner { 1 } else { 0 }
}

fn nr_is_mut(name: Str) -> Int {
    match nr_name_top.get(name) {
        Some(i) => return nr_scope_muts.get(i).unwrap()
        None => {}
    }
    0
}

fn nr_mark_written(name: Str, _node: Int) ! Diag.Report {
    match nr_name_top.get(name) {
        Some(i) => {
            if nr_loop_depth == 0 && nr_scope_captured.get(i).unwrap() == 0 {
                nr_scope_reads.set(i, 0)
            }
            nr_scope_writes.set(i, nr_scope_writes.get(i).unwrap() + 1)
        }
        None => {}
    }
}

fn nr_get_type(name: Str) -> Int {
    match nr_name_top.get(name) {
        Some(i) => return nr_scope_types.get(i).unwrap()
        None => {}
    }
    TYPE_UNKNOWN
}

fn nr_set_last_type(tid: Int) {
    if nr_scope_types.len() > 0 {
        nr_scope_types.set(nr_scope_types.len() - 1, tid)
    }
}

// §2.20 test-only symbol allowlist. Append future test-only symbols here
// (e.g. assert_panics) — membership means the symbol may only be called inside
// a literal 'test { ... }' block (tc_in_test_body == 1). This predicate is the
// single source of truth for *which* symbols are fenced; the *fence itself*
// (tc_fence_test_only_symbol) is shared. A new symbol whose Call has its own
// signature/arg-count checks still needs its own `if fn_name == ...` dispatch
// branch in infer_type that calls tc_fence_test_only_symbol with its code —
// the list-append removes fence duplication, not the per-symbol dispatch.
fn is_test_only_symbol(name: Str) -> Int {
    if name == "skip" { return 1 }
    0
}

// Shared fence for §2.20 test-only symbols. `code`/`short_name` are
// parameterized so a future symbol (assert_panics) can fence with E0833.
// tc_in_test_body is 1 inside the test block (and inside closures lexically
// within it — testing.for_each's case body relies on this); it is 0 in a
// regular fn, so calling a test-only symbol from a helper fn is fenced even
// when that helper is reachable from a test.
fn tc_fence_test_only_symbol(name: Str, code: Str, short_name: Str, node: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if is_test_only_symbol(name) != 0 && tc_in_test_body == 0 {
        diag_error_at(short_name, code,
            "{name}() can only be called inside a test body",
            node, "move the call into a 'test \{ ... }' block")
    }
}

