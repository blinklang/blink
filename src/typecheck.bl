effect TypeCheck {
    effect Register
    effect Resolve
    effect Report
}

// typecheck.bl — Type representation, registries, and type checking
//
// Phase 0: Type registries — registers struct/enum/fn/trait types into pools
// Phase 1: Name resolution — walks function bodies checking identifiers resolve
// Phase 2: Expression type inference — infers types, checks compatibility
//
// The pipeline: lex → parse → typecheck → codegen

// ── Type kinds ──────────────────────────────────────────────────────
// The discriminant of an interned type. A real enum, not a `let` Int: a kind
// reached by an `if k == ...` chain falls through silently to whatever default
// the chain ends in, which is how a speller comes to answer a plausible-wrong
// tag for TyKind.Fn. Typed as TyKind end to end — never
// stored back into an Int (see ast.bl's node_kind_name(kind: Int) for the trap:
// widening an enum to Int throws exhaustiveness away).
pub type TyKind {
    Int, Float, Bool, Str, Void,
    List, Option, Result, Fn, Struct, Enum,
    Typevar, Unknown, Iterator, Handle, Channel, Ptr,
    Tuple, Map, Bytes, Set, StringBuilder, Template, FfiScope,
    I8, I16, I32, U8, U16, U32, U64, Char
}

// Stable spelling of a kind, for the ty_intern key. A match, not Display: it is
// the one place the whole kind set must be enumerated, so a kind added without
// a spelling fails to compile here rather than colliding in the intern map.
fn tk_name(k: TyKind) -> Str {
    match k {
        TyKind.Int => "Int"
        TyKind.Float => "Float"
        TyKind.Bool => "Bool"
        TyKind.Str => "Str"
        TyKind.Void => "Void"
        TyKind.List => "List"
        TyKind.Option => "Option"
        TyKind.Result => "Result"
        TyKind.Fn => "Fn"
        TyKind.Struct => "Struct"
        TyKind.Enum => "Enum"
        TyKind.Typevar => "Typevar"
        TyKind.Unknown => "Unknown"
        TyKind.Iterator => "Iterator"
        TyKind.Handle => "Handle"
        TyKind.Channel => "Channel"
        TyKind.Ptr => "Ptr"
        TyKind.Tuple => "Tuple"
        TyKind.Map => "Map"
        TyKind.Bytes => "Bytes"
        TyKind.Set => "Set"
        TyKind.StringBuilder => "StringBuilder"
        TyKind.Template => "Template"
        TyKind.FfiScope => "FFIScope"
        TyKind.I8 => "I8"
        TyKind.I16 => "I16"
        TyKind.I32 => "I32"
        TyKind.U8 => "U8"
        TyKind.U16 => "U16"
        TyKind.U32 => "U32"
        TyKind.U64 => "U64"
        TyKind.Char => "Char"
    }
}

// ── Type pool ───────────────────────────────────────────────────────
pub type TypePoolEntry {
    kind: TyKind
    name: Str
    inner1: Int
    inner2: Int
    params_start: Int
    params_count: Int
}
let mut ty_pool: List[TypePoolEntry] = []
let mut ty_param_list: List[Int] = []
// node id → tid memo. Populated during infer_type in check_types and left
// resident so generate() can consume structured tids instead of re-deriving
// them from string tags. -1 = not-yet-inferred / out of range. Reset in
// init_types alongside ty_pool so a tid can never outlive its pool.
let mut tc_node_tid: List[Int] = []

// Call node → the metavars minted for that call's RETURN-ONLY type params (3dpshm).
// Presized to node_count() with -1 in init_types, exactly like tc_node_tid, so a
// stale index can never survive a pool reset.
//
// TWO LISTS, NOT A MAP, and MEMOIZED PER CALL NODE. infer_type calls
// infer_type_uncached unconditionally, so one call site's return type is
// instantiated many times; without the memo each visit would mint a DIFFERENT α and
// only the last one would ever be constrained — the node's memoized tid would carry
// a bound α while the mono lowering read a fresh unbound one. Sharing α across call
// sites is the opposite failure: `let a: RGT[Int] = mk(); let b: RGT[Str] = mk()`
// would bind whichever ran first and collapse both onto one C type.
//
// tc_ret_mint_start holds the offset of this call's group in tc_ret_mint_tids;
// each group is FULL ARITY, with -1 in the slots that were not minted, so a reader
// can index it positionally against the fn's type-param list with no second table.
let mut tc_ret_mint_start: List[Int] = []
let mut tc_ret_mint_tids: List[Int] = []

// ── Builtin type indices (populated by init_types) ──────────────────
let mut TYPE_INT: Int = -1
let mut TYPE_FLOAT: Int = -1
let mut TYPE_BOOL: Int = -1
let mut TYPE_STR: Int = -1
let mut TYPE_VOID: Int = -1
let mut TYPE_UNKNOWN: Int = -1
let mut TYPE_I8: Int = -1
let mut TYPE_I16: Int = -1
let mut TYPE_I32: Int = -1
let mut TYPE_U8: Int = -1
let mut TYPE_U16: Int = -1
let mut TYPE_U32: Int = -1
let mut TYPE_U64: Int = -1
let mut TYPE_CHAR: Int = -1

// ── Type registries ─────────────────────────────────────────────────
let mut named_type_names: List[Str] = []
let mut named_type_ids: List[Int] = []

type TcStructField {
    struct_id: Int
    name: Str
    type_id: Int
}
let mut sfield_pool: List[TcStructField] = []

type EnumVariantEntry {
    enum_id: Int
    name: Str
    tag: Int
    has_data: Int
}
let mut evar_pool: List[EnumVariantEntry] = []

type EnumVariantFieldEntry {
    var_idx: Int
    name: Str
    type_id: Int
}
let mut evfield_pool: List[EnumVariantFieldEntry] = []

let mut named_type_map: Map[Str, Int] = Map()
let mut fnsig_map: Map[Str, Int] = Map()
// Set of struct/enum names that carry @derive(Hash). Used to reject
// Map[K, V] at typecheck when K is a user type without the derive.
let mut tc_hashable_types: Map[Str, Int] = Map()

// Set of struct/enum names that carry @derive(Debug). Used to reject
// @derive(Debug) on a type whose field's user-type does not also derive Debug.
let mut tc_debug_types: Map[Str, Int] = Map()
// type name -> its declaration node, for field-derive validation spans.
let mut tc_type_decl_nodes: Map[Str, Int] = Map()

type FnSigEntry {
    name: Str
    ret: Int
    params_start: Int
    params_count: Int
    type_params_start: Int
    type_params_count: Int
    effects_start: Int
    effects_count: Int
}
let mut fnsig_pool: List[FnSigEntry] = []
let mut fnsig_param_list: List[Int] = []
let mut fnsig_type_param_names: List[Str] = []
// Flat side-table PARALLEL to fnsig_type_param_names (same index, same length):
// 1 iff that type param is RETURN-ONLY — named by the fn's return annotation and by
// no parameter annotation. Only those slots get a call-site metavar (3dpshm); every
// other slot keeps inferring from arguments exactly as before.
//
// It is a side-table rather than an FnSigEntry field because FnSigEntry is by-value
// and already carries the (start, count) pair that indexes the names, so a parallel
// list needs no new bookkeeping and no struct-shape change to a type the whole file
// destructures.
let mut fnsig_tparam_ret_only: List[Int] = []
let mut fnsig_effect_names: List[Str] = []

let mut tc_trait_names: List[Str] = []
let mut tc_trait_method_names: List[Str] = []
let mut tc_trait_assoc_names: List[Str] = []

// 4q2etk: replaced by mwxtyj — types with an `impl Display`, for which the
// compiler synthesizes a sealed `display() -> Str`.
let mut tc_display_impl_types: List[Str] = []

// sb3125 — typecheck-phase index of which traits define a given method for a
// given type. Built while walking impls (the codegen impl_entries registry is
// empty during typecheck). Drives both the trait-qualified fnsig key and the
// E0522 ambiguity check. tc_method_trait_count holds the distinct-trait count;
// tc_method_trait_names holds " and "-joined names for the diagnostic message.
// Both keyed "{type}\t{method}".
let mut tc_method_trait_count_idx: Map[Str, Int] = Map()
let mut tc_method_trait_names_idx: Map[Str, Str] = Map()
// wz48pq: trait-level type-param count keyed by trait NAME, populated in
// register_trait for EVERY trait (methodless or not). validate_trait_impls
// reads this for the E0910 arg-arity check; deriving it from tc_tmsig_pool
// (per-method sigs) missed methodless traits, which have no sig entry.
let mut tc_trait_tparam_count_idx: Map[Str, Int] = Map()
// 9myrp2: binder-recovery index for the canonical monomorphized poly impl
// `impl[T] Trait[T] for List[T]`, keyed "List_{trait}_{method}" -> impl node.
// The MethodCall arm reads it to substitute the impl's `-> T` return type with
// the receiver's List element tid, so the method-call node memoizes a concrete
// tid instead of TYPE_UNKNOWN (which left the downstream free-fn call with no tid
// for its type-param, back when a legacy string CSV still absorbed that). Only the
// canonical shape
// (single binder == receiver's sole type arg, matching validate_trait_impls'
// poly_supported gate) ever registers; every other shape stays absent so the
// arm falls through to today's TYPE_UNKNOWN behavior unchanged.
let mut tc_poly_list_impl_node: Map[Str, Int] = Map()

fn tc_method_traits_key(tname: Str, method: Str) -> Str {
    "{tname}\t{method}"
}

fn tc_record_method_trait(tname: Str, method: Str, trait_name: Str) {
    let key = tc_method_traits_key(tname, method)
    let prev_n = tc_method_trait_count_idx.get(key) ?? 0
    tc_method_trait_count_idx.insert(key, prev_n + 1)
    let prev_names = tc_method_trait_names_idx.get(key) ?? ""
    if prev_names == "" {
        tc_method_trait_names_idx.insert(key, trait_name)
    } else {
        tc_method_trait_names_idx.insert(key, "{prev_names} and {trait_name}")
    }
}

// Count of distinct traits defining `method` for `tname` (the synthesized
// sealed Display.display() is folded in at record time). >=2 ⇒ ambiguous.
fn tc_method_trait_count(tname: Str, method: Str) -> Int {
    tc_method_trait_count_idx.get(tc_method_traits_key(tname, method)) ?? 0
}

fn tc_method_trait_names(tname: Str, method: Str) -> Str {
    tc_method_trait_names_idx.get(tc_method_traits_key(tname, method)) ?? ""
}

// Typecheck-side mirror of codegen's mangle_impl_method: the fnsig key for an
// impl method. Must match the codegen C symbol exactly so arg-shape/return-type
// lookups resolve. From/TryFrom keep `{type}_{method}_{src}`; all other traits
// use the trait-qualified `{type}_{trait}_{method}`.
fn tc_mangle_impl_fnsig(impl_type: Str, trait_name: Str, mname: Str, im: Int) -> Str {
    if trait_name == "From" || trait_name == "TryFrom" {
        let tparams = node_type_params(im)
        if tparams != -1 && sublist_length(tparams) > 0 {
            let src = node_name(sublist_get(tparams, 0))
            return "{impl_type}_{mname}_{src}"
        }
    }
    "{impl_type}_{trait_name}_{mname}"
}

// vfgp72: does `tname` carry an Eq impl usable by the `==`/`!=` operators?
// Covers BOTH @derive(Eq)/@derive(Ord) (Ord: Eq) and a user `impl Eq for T`.
// The user-impl signal is the sb3125 trait→method index: an `impl Eq for T`
// records method `eq` under trait `Eq` for `T`.
fn tc_type_has_eq_impl(tname: Str) -> Int {
    let td = tc_type_decl_nodes.get(tname) ?? -1
    if td != -1 {
        if type_has_derive(td, "Eq") != 0 { return 1 }
        if type_has_derive(td, "Ord") != 0 { return 1 }
    }
    if tc_method_trait_names(tname, "eq").contains("Eq") != 0 { return 1 }
    0
}

// vfgp72: does `tname` carry an Ord impl usable by `<`/`>`/`<=`/`>=`?
// Covers @derive(Ord) and a user `impl Ord for T` (records `cmp` under `Ord`).
fn tc_type_has_ord_impl(tname: Str) -> Int {
    let td = tc_type_decl_nodes.get(tname) ?? -1
    if td != -1 {
        if type_has_derive(td, "Ord") != 0 { return 1 }
    }
    if tc_method_trait_names(tname, "cmp").contains("Ord") != 0 { return 1 }
    0
}

fn tc_type_has_display_impl(tname: Str) -> Int {
    let mut i = 0
    while i < tc_display_impl_types.len() {
        if tc_display_impl_types.get(i).unwrap() == tname { return 1 }
        i = i + 1
    }
    0
}

// mrwgz4: can `.{method}()` resolve on a KNOWN struct/enum type `tname`?
// Allowlist-style and biased FAIL-OPEN: every path that resolves at codegen
// must return 1 here, but any path we cannot model at typecheck also returns 1
// (the codegen E0505 backstop catches genuine misses). Returning 0 emits a hard
// typecheck error, so over-strictness would reject valid programs — including
// the compiler typechecking itself during `task regen`. When unsure: return 1.
fn tc_method_resolvable_on_type(obj_k: TyKind, tname: Str, method: Str) -> Int {
    // (a) user method + ALL trait-impl methods. Trait-impl methods register
    //     under the trait-qualified key `{T}_{trait}_{m}` (sb3125), so consult
    //     the method→traits index; a bare inherent fnsig `{T}_{m}` still counts.
    if tc_method_trait_count(tname, method) >= 1 { return 1 }
    if lookup_fnsig("{tname}_{method}") != -1 { return 1 }
    // (b) sealed synthesized Display.display() (no user fnsig).
    if method == "display" && tc_type_has_display_impl(tname) != 0 { return 1 }
    // (c) @derive-generated methods — query the annotation via the decl node.
    //     tc_type_decl_nodes covers BOTH structs (850) and enums (902).
    let td = tc_type_decl_nodes.get(tname) ?? -1
    if td != -1 {
        if method == "to_json"   && type_has_derive(td, "Serialize")   != 0 { return 1 }
        if method == "from_json" && type_has_derive(td, "Deserialize") != 0 { return 1 }
        if method == "eq"        && type_has_derive(td, "Eq")          != 0 { return 1 }
        // Ord: Eq (spec §3.6) — deriving Ord synthesizes both cmp and eq.
        if method == "eq"        && type_has_derive(td, "Ord")         != 0 { return 1 }
        if method == "cmp"       && type_has_derive(td, "Ord")         != 0 { return 1 }
        if method == "clone"     && type_has_derive(td, "Clone")       != 0 { return 1 }
        if method == "hash"      && type_has_derive(td, "Hash")        != 0 { return 1 }
        if method == "debug"     && type_has_derive(td, "Debug")       != 0 { return 1 }
    }
    // (c') str-backed enum intrinsics (to_str/from_str) are synthesized in
    //      codegen (codegen_stmt.bl:5983) and not modeled here → fail-open.
    if obj_k == TyKind.Enum && (method == "to_str" || method == "from_str") { return 1 }
    // (d) closure-typed struct field invoked like a method. Closure fields lower
    //     to TyKind.Typevar("Fn"), not a closure kind, so reuse the callable-field
    //     name registry (the same signal that suppresses W0501).
    if obj_k == TyKind.Struct && is_callable_field_name(method) != 0 { return 1 }
    // (e) trait/stdlib methods whose receiver-type resolution is not modeled at
    //     typecheck: `.into()` (From-trait auto-conversion), stdlib-type methods
    //     like `Instant.to_rfc3339()`, channel ops, etc. This is the SAME name
    //     allowlist that suppresses the W0501 name-only warning — reusing it keeps
    //     the hard E0505 and the soft W0501 consistent (no name warns-but-errors).
    //
    //     EXCLUDE `display`/`to_str`/`from_str`: those names live in is_builtin_method
    //     too, but on a struct/enum receiver they are SYNTHESIZED conditionally —
    //     `display` only with an `impl Display` (clause b), `to_str`/`from_str` only
    //     on enums (clause c'). Letting the name-only check resolve them would defeat
    //     the whole point: `.display()` on a type WITHOUT a Display impl must error
    //     here at typecheck (j2xxyd/mrwgz4), not fall open to the codegen backstop.
    if method != "display" && method != "to_str" && method != "from_str" {
        if is_builtin_method(method) != 0 { return 1 }
    }
    0
}

// E0514 helper (5q5jwz/wbf74w): does a type id have a usable Display impl?
// Returns 1 for builtin-scalar Display (Int/Float/Bool/Char/Str) or a user
// type with `impl Display`. Returns 0 for TyKind.Unknown / TyKind.Typevar so callers
// SKIP the check (Display is unknowable for unresolved/generic types).
fn tc_type_id_has_display(tid: Int) -> Int {
    let k = type_kind(tid)
    if k == TyKind.Unknown || k == TyKind.Typevar { return 0 }
    if k == TyKind.Int || k == TyKind.Float || k == TyKind.Bool || k == TyKind.Char || k == TyKind.Str { return 1 }
    // Sized integers are Display-able scalars — interpolation lowers them to
    // %lld/%llu just like Int (codegen_expr emit_interp_string CT_I8..CT_U64).
    if is_sized_int(k) != 0 { return 1 }
    // Tuples derive Display structurally when every element is Display (spec
    // §3.6); codegen renders them "(e0, e1, ...)". An empty tuple has nothing
    // non-Display, so it is trivially Display.
    if k == TyKind.Tuple {
        let te = ty_pool.get(tid).unwrap()
        let mut i = 0
        while i < te.params_count {
            let et = ty_param_list.get(te.params_start + i).unwrap()
            let ek = type_kind(et)
            // Fail-open on unresolved/generic elements — unknowable, not absent.
            if ek != TyKind.Unknown && ek != TyKind.Typevar && tc_type_id_has_display(et) == 0 {
                return 0
            }
            i = i + 1
        }
        return 1
    }
    // Key the Display-impl lookup on the struct/enum BASE name, not type_to_str:
    // a monomorphized instance tid renders as "Box[Int]" but tc_display_impl_types
    // is keyed on the bare declared name "Box" (node_name(im) at registration).
    // Using type_to_str here would miss the impl for any generic struct value that
    // now carries an instance tid (br qw7v90 regression). strip_module_qualifier
    // mirrors the bare key form; for non-struct/enum kinds type_to_str already
    // returns the plain scalar name, so fall back to it.
    if k == TyKind.Struct || k == TyKind.Enum {
        return tc_type_has_display_impl(strip_module_qualifier(ty_pool.get(tid).unwrap().name))
    }
    tc_type_has_display_impl(type_to_str(tid))
}

// Trait method signature registry (for contract validation)
type TraitMethodSigEntry {
    trait_name: Str
    method: Str
    ret: Str
    tparams_start: Int
    tparams_count: Int
    params_start: Int
    params_count: Int
}
let mut tc_tmsig_pool: List[TraitMethodSigEntry] = []
let mut tc_tmsig_param_names: List[Str] = []
let mut tc_trait_tparam_names: List[Str] = []

let mut tc_current_fn_ret: Int = -1
let mut tc_current_fn_name: Str = ""
// The receiver type of the impl block whose method body is being checked, or -1 outside one
// (free functions, trait default bodies, test blocks). `self` is the only parameter with no
// annotation to resolve, so this is where its type comes from — see tc_impl_self_tid. Set and
// restored by tc_infer_program's impl loop, which is the only place the impl node is in hand.
let mut tc_current_self_tid: Int = -1
// The fnsig KEY of the impl method being checked, or "" outside one. An impl method registers its
// signature under the trait-mangled spelling (tc_mangle_impl_fnsig) but is checked under
// "{impl_type}_{method}", so tc_check_fn's `lookup_fnsig(fn_name)` missed and NO impl method ever
// had its declared return type installed — every wrong return escaped to the C compiler (br
// zd1tz3). The node name stays the display spelling; only the lookup uses this.
let mut tc_current_method_sig_key: Str = ""
// Depth of closure bodies the type-inference pass is currently inside. tc_current_fn_ret
// is saved/restored by tc_check_fn (and the test-body elaborator) only, so within a
// closure body it still names the ENCLOSING fn's declared return — the closure's own is
// never installed. Read-only diagnostics tolerate that; an in-place ty_pool MUTATION
// keyed on it does not (see tc_pin_tail_ret_generic's call site in the Return arm).
let mut tc_in_closure_depth: Int = 0

// Consume-once marker (br r9krgr): tc_check_fn sets it immediately before calling
// tc_check_body on the fn's own body, and tc_check_body's Block arm reads-then-zeroes
// it as its first act. That is what lets the implicit-tail declared-return check run
// for exactly the fn body and for no nested block — if/else, `with`, match arm, loop
// body, closure body all read 0 for free, with no depth arithmetic.
//
// NOT nr_scope_depth. tc_check_test_block does nr_push_scope / tc_check_body /
// nr_pop_scope at the SAME depth as a fn body, so a depth discriminator cannot tell
// the two apart. It installs tc_current_fn_ret = Result[Void, TestError] for a body
// containing `?` and TYPE_VOID otherwise, so the spurious-E0300 hazard is confined to
// the `?` bodies — a Void tail compared against Result[Void, TestError]. Those are a
// minority of the suite, but a depth discriminator has no way to exempt even one.
// NOT a tc_check_body parameter either: it is called from every nested-block
// position in the checker (22 sites today) and the bit is true at exactly one.
let mut tc_fn_body_block: Int = 0

let mut tc_errors: List[Str] = []

// ── Deprecation tracking ───────────────────────────────────────────
let mut depr_fn_nodes: Map[Str, Int] = Map()
let mut depr_type_nodes: Map[Str, Int] = Map()

// ── Kind A name-collision tracking (struct name == enum variant name) ──
// Decl nodes captured at registration so the E0518 diagnostic can point a
// primary span at the struct decl and a secondary span at the enum decl.
let mut tc_struct_decl_nodes: Map[Str, Int] = Map()
let mut tc_variant_enum_decl_nodes: Map[Str, Int] = Map()
// Dedupe so each colliding name is reported once, not per use site.
let mut tc_collision_reported: Map[Str, Int] = Map()

// Names of @ffi.struct types (consulted by is_valid_ptr_inner so Ptr[T] is allowed for them).
let mut ffi_struct_type_set: Map[Str, Int] = Map()

// Maps a type-alias name (e.g. `type Port = Int`) to its underlying type id.
// Consulted by types_compatible so refinement aliases stay compatible with their base type.
// Keyed by name (not type id) because type ids are pass-dependent across the dual codegen passes.
let mut tc_alias_underlying: Map[Str, Int] = Map()

// ── Import alias maps ──────────────────────────────────────────────
pub let mut tc_alias_to_original: Map[Str, Str] = Map()
let mut tc_original_to_alias: Map[Str, Str] = Map()

// ── Inferred type hints (for LSP inlayHint) ─────────────────────────
pub type HintEntry {
    line: Int
    col: Int
    name: Str
    type_str: Str
    module: Str
}
pub let mut tc_hints: List[HintEntry] = []

// ── Unused import tracking ──────────────────────────────────────────
let mut tc_symbol_module: Map[Str, Str] = Map()
let mut tc_used_modules: Map[Str, Int] = Map()

// br cttrag: the type of every top-level `let`, keyed "{module}.{name}", so a
// module-QUALIFIED access can be resolved. Top-level lets are also defined by
// bare name (nr_define_typed, below), which is why the bare form inside the
// declaring module was always typed; the qualified form had nothing to read.
//
// A separate table rather than nr_get_type(name), because the bare-name scope is
// shadowable: with `let count = "s"` in scope, nr_get_type("count") answers the
// LOCAL, and `prov.count` would silently acquire the wrong type. Keying on the
// module makes the lookup immune to that, and the key is the module the QUALIFIER
// resolves to (tc_qualifier_to_module_or_self), not the bare qualifier, so an
// aliased or dotted import resolves the same way.
let mut tc_module_let_tid: Map[Str, Int] = Map()

// Prelude modules (underscore form, e.g. "std_num") and the set of *free
// function* names they export. The prelude provides compiler-known
// types/traits/impls unconditionally (§10.6), but its free functions
// (list_map, parse_int, …) require an explicit import per §3.2.3 — they are
// filtered out of name-resolution scope (fsmwz2). compiler.bl seeds the module
// set via tc_set_prelude_modules before check_types.
let mut tc_prelude_modules: Map[Str, Int] = Map()
let mut tc_prelude_free_fn: Map[Str, Int] = Map()

// `mods` are module keys in underscore form ("std_num"), matching node_module
// / tc_symbol_module. compiler.bl's inject_prelude normalizes the dotted
// prelude paths before calling (dots_to_underscores lives there).
pub fn tc_set_prelude_modules(mods: List[Str]) {
    tc_prelude_modules.clear()
    let mut i = 0
    while i < mods.len() {
        tc_prelude_modules.insert(mods.get(i).unwrap(), 1)
        i = i + 1
    }
}

fn tc_mark_symbol_used(name: Str) {
    if nr_current_module != "" && nr_current_module != "__main__" { return }
    match tc_symbol_module.get(name) {
        Some(mod_name) => tc_used_modules.insert(mod_name, 1)
        None => {}
    }
}

// The dotted module a top-level symbol resolves to, or "" if unknown.
// Lets the unused-import check (compiler.bl) tell whether a selectively
// imported name is prelude-visible (yze3de).
pub fn tc_get_symbol_module(name: Str) -> Str {
    match tc_symbol_module.get(name) {
        Some(mod_name) => mod_name
        None => ""
    }
}

fn tc_mark_qualifier_used(qualifier: Str) {
    if nr_current_module != "" && nr_current_module != "__main__" { return }
    tc_used_modules.insert(qualifier, 1)
    match tc_qualifier_to_module.get(qualifier) {
        Some(mod_name) => tc_used_modules.insert(mod_name, 1)
        None => {}
    }
}

pub fn tc_is_module_used(mod_name: Str) -> Int {
    if tc_used_modules.contains_key(mod_name) {
        return 1
    }
    0
}

// ── Incremental filter ──────────────────────────────────────────────
// When enabled, only functions whose names appear in the filter set
// are typechecked. Used by the incremental recheck engine.

let mut tc_inc_enabled: Int = 0
let mut tc_inc_filter: Map[Str, Int] = Map()

// Set while the kvn6w8 off-path instance-tid producer re-resolves a struct's
// type-args (`Box[Map[Float,Int]]` → recurse into `Map[Float,Int]`). Before that
// producer existed, the struct branch of resolve_type_ann returned the bare tid
// WITHOUT visiting the args, so validate_map_key / validate_set_elem never ran on
// them. Those validators emit non-deduped E1400 diagnostics, so an un-suppressed
// re-resolution would emit a net-new MapKeyNotHashable the old compiler didn't —
// a byte-identity violation of typecheck decisions. The flag suppresses ONLY the
// hashability diagnostics during that off-path pass; tid-building is unaffected,
// so the captured instance tids are byte-identical either way. The live Map/Set
// annotation (a real `let m: Map[Float,Int]`) is resolved with the flag clear and
// still reports as before.
let mut tc_suppress_ann_validation: Int = 0

// Raised around tc_produce_struct_instance_tid's own arg-resolution loop (br
// wzm47q): while resolving Box[Box[T]]'s outer arg list, the inner Box[T] element
// is itself re-resolved through resolve_type_ann's struct branch, which recurses
// back into tc_produce_struct_instance_tid for "Box[T]". That inner call's own
// all-typevar skip would otherwise erase T and return -1, collapsing the slot to
// the bare Box tid — the outer instance then carries no way to substitute T later.
// This flag tells an inner call "you were reached while your caller was itself
// producing a struct instance", so it mints the all-typevar instance anyway. It
// does NOT widen the skip's exemption to the general hot path (a plain `Box[T]`
// resolved directly off a Map/List/... branch still returns -1, unchanged) —
// only a struct instance nested inside another struct instance's arg list opts in.
pub let mut tc_structural_nested_instances: Int = 0

// ── Type creation ───────────────────────────────────────────────────

fn new_type(kind: TyKind, name: Str) -> Int {
    let idx = ty_pool.len()
    ty_pool.push(TypePoolEntry { kind: kind, name: name, inner1: -1, inner2: -1, params_start: -1, params_count: 0 })
    idx
}

// ── Compound-type interning (br v76b0b) ──────────────────────────────
//
// decisions/compiler-type-representation.md:39-47 (Q3, 5-0) mandates full interning:
// "type equality is integer comparison." Mirrors tp_intern/tp_alloc
// (codegen_types.bl:78-92), extended with the variadic ty_param_list slice ty_pool
// additionally carries.
//
// THE CENTRAL INVARIANT: the key is built over the RAW CHILD TIDS AS STORED — never
// tc_resolve'd, never over a child's recursive structure, and ABOVE ALL never with an
// unbound metavar normalized to a common token. make_metavar mints a FRESH, never-interned
// TyKind.Unknown entry for every unannotated `Map()` / `Set()` / `None` / `[]`, and that
// freshness is exactly what lets each one bind independently later (textbook HM). If the
// key ever collapsed two different unbound metavars onto one string, `let a: Option[Int] =
// None; let b: Option[Str] = None` would share one alpha — binding it via `a` would
// silently retype `b`. new_type/make_metavar are deliberately left OUT of the intern path
// so this can never happen by construction; do not "improve" this by normalizing unbound
// tids in the key. tests/test_v76b0b_ty_pool_interns_compounds.bl Half B is the permanent
// tripwire for this invariant and must never be deleted.
//
// Safe to share a hit across callers because: (1) a compound ty_pool entry is NEVER
// mutated post-construction except bind_metavar, which is gated to TyKind.Unknown entries only
// and therefore never touches a compound; (2) ty_param_list is append-only (push/clear,
// no set/pop), so a compound's params slice is frozen at construction.
//
// The key is deliberately FINER than tc_tid_same_type on two axes (finer only ever merges
// less, never wrongly collapses): `name` is part of the key for EVERY kind (not just
// TyKind.Struct/TyKind.Enum/TyKind.Typevar), and `name` is RAW, never strip_module_qualifier'd —
// stripping would collapse `helper.Box[Int]` with `Box[Int]` across modules, the exact
// cross-module collision mono_phys_base (codegen_types.bl:1246) exists to prevent (br
// q4etvt). Coarser-than-tc_tid_same_type is the one direction that would be unsound.
//
// Sound but INCOMPLETE, accepted for v1: interning `Option[alpha]` then later binding
// alpha := Int does not re-key that entry, so a subsequent make_option_type(TYPE_INT)
// mints a second tid. Closing this needs a rehash-on-bind plus tid-forwarding, which does
// not exist yet (follow-up filed, br v76b0b Stage 4). This does not weaken the measured
// goal: the corpus's same-type conflicts are annotation-shaped, with no metavar involved,
// and bottom-up interning fixes those outright.
let mut ty_intern: Map[Str, Int] = Map()

fn ty_intern_args_key(args: List[Int]) -> Str {
    let mut s = ""
    let mut i = 0
    while i < args.len() {
        s = "{s},{args.get(i).unwrap()}"
        i = i + 1
    }
    s
}

fn ty_intern_key(kind: TyKind, name: Str, inner1: Int, inner2: Int, args: List[Int]) -> Str {
    "{tk_name(kind)}|{name}|{inner1}|{inner2}|{ty_intern_args_key(args)}"
}

// Interning ctor for the fixed-arity shapes (List/Option/Result/Map/Set): at most two
// scalar inner slots, no ty_param_list involvement.
fn ty_intern_simple(kind: TyKind, name: Str, inner1: Int, inner2: Int) -> Int {
    let key = ty_intern_key(kind, name, inner1, inner2, [])
    match ty_intern.get(key) {
        Some(v) => return v
        None => {}
    }
    let t = new_type(kind, name)
    let e = ty_pool.get(t).unwrap()
    ty_pool.set(t, TypePoolEntry { inner1: inner1, inner2: inner2, ..e })
    ty_intern.insert(key, t)
    t
}

// Interning ctor for the variadic shapes (Tuple/Fn/struct-instance/enum-instance): the
// key is computed from the caller's already-materialized `args` BEFORE any push, so a
// HIT touches ty_param_list not at all — there is no rollback path to get wrong, because
// there is nothing to roll back. A MISS pushes exactly once, in the original order,
// reproducing the pre-interning body byte-for-byte.
fn ty_intern_variadic(kind: TyKind, name: Str, inner1: Int, args: List[Int]) -> Int {
    let key = ty_intern_key(kind, name, inner1, -1, args)
    match ty_intern.get(key) {
        Some(v) => return v
        None => {}
    }
    let t = new_type(kind, name)
    let start = ty_param_list.len()
    let mut i = 0
    while i < args.len() {
        ty_param_list.push(args.get(i).unwrap())
        i = i + 1
    }
    let e = ty_pool.get(t).unwrap()
    ty_pool.set(t, TypePoolEntry { inner1: inner1, params_start: start, params_count: args.len(), ..e })
    ty_intern.insert(key, t)
    t
}

// `pub` FOR THE TEST ONLY — see make_option_type below. List and Set are the two
// containers whose structural child access the collapse leans on hardest, so
// tests/test_tc_tid_structural_accessors.bl builds them directly rather than hoping a
// probe program happens to mint the nesting depth a row needs.
pub fn make_list_type(inner: Int) -> Int {
    ty_intern_simple(TyKind.List, "List", inner, -1)
}

// `pub` FOR THE TEST ONLY — same precedent as make_fn_type below: proving the
// collapse-not-interpolate arms in tc_tid_inner_tag/tc_tid_to_c_tag (br vbcw1e Stage 2)
// requires constructing an Option/Result/Map wrapping an unbound metavar directly, which
// no surface program can do (an unbound metavar never survives to a fully-typechecked
// program — it either binds or raises E0301 at the boundary).
pub fn make_option_type(inner: Int) -> Int {
    ty_intern_simple(TyKind.Option, "Option", inner, -1)
}

pub fn make_result_type(ok_type: Int, err_type: Int) -> Int {
    ty_intern_simple(TyKind.Result, "Result", ok_type, err_type)
}

// TyKind.Fn is the one kind tc_tid_to_c_tag has no arm for, so this is also the way to
// CONSTRUCT the input that proves its ICE_SEG_UNHANDLED_KIND tail actually fires — the gap
// tests/test_fes70z_mono_slot_ice.bl exists to close (br hsgsbp).
//
// `pub` was once FOR THAT TEST ONLY, because no surface syntax reached here: a closure
// literal inferred as TYPE_UNKNOWN and an `fn(...)` annotation lowered to
// TyKind.Typevar("Fn"). Both are now real callers (br nz7drz, infer_type's Closure arm and
// resolve_type_ann's Fn arm), so a Fn tid is ordinary and the fixture is no longer the only
// producer.
pub fn make_fn_type(ret_type: Int, param_types: List[Int]) -> Int {
    ty_intern_variadic(TyKind.Fn, "Fn", ret_type, param_types)
}

// INTERNS (br v76b0b Stage 3) — safe because tc_tid_same_type compares TyKind.Typevar by
// name alone (:11672-11673 above), so name-keying IS its equality, and a TyKind.Typevar entry
// is never mutated post-construction (same invariant as every other ty_intern_* ctor).
// Isolated as its own stage/commit: changes tid identity for generic BASE shapes, a wider
// blast radius than compound instances — revert this stage alone if the monodedup
// counters move the wrong way or task ci reddens; Stages 1-2 already deliver the ticket's
// measured goal independent of this one.
fn make_typevar(name: Str) -> Int {
    ty_intern_simple(TyKind.Typevar, name, -1, -1)
}

// `pub` FOR THE TEST ONLY — see make_option_type above.
pub fn make_tuple_type(elem_types: List[Int]) -> Int {
    ty_intern_variadic(TyKind.Tuple, "Tuple", -1, elem_types)
}

// A monomorphized struct instance (`Box[Int]`): a fresh TyKind.Struct entry named
// after the generic base, with its concrete type-args stored variadically in
// ty_param_list[params_start .. +params_count] — exactly how make_tuple_type /
// make_fn_type store their element/param tids. The generic base declared by a
// `type Box[T] { .. }` keeps params_count=0; an instance carries params_count>=1.
// This is the tid-pool representation decisions/compiler-type-representation.md
// Q2 (5-0) mandates to close the "concrete inner lives only in codegen's string
// mono registry" split.
//
// INTERNS (br v76b0b) — two calls with the same (base_name, arg_types) share one tid.
// Was "fresh entry per call" once justified by "no emit reader consumes it yet" (br
// kvn6w8, when this was a foundation-only spike read solely by the tc_tid_struct_arg_*
// accessors); that premise EXPIRED — br wzv72h made the tid path primary at every
// generic-fn seam and br qnpb2d makes it authoritative at the struct-literal mono seam.
// See the ty_intern_* helpers above `new_type` for the interning invariant.
// tc_tid_same_type remains the sanctioned STRUCTURAL comparison for the residual case
// interning does not close (a compound built over a since-bound metavar) — do not
// deprecate it here.
//
// `pub` FOR THE TEST ONLY — same precedent as make_option_type above:
// tests/test_v76b0b_ty_pool_interns_compounds.bl constructs struct-instance tids directly
// to prove the interning invariant at the ctor boundary, not just end-to-end through a
// compiled program.
pub fn make_struct_instance_type(base_name: Str, arg_types: List[Int]) -> Int {
    ty_intern_variadic(TyKind.Struct, base_name, -1, arg_types)
}

// A generic-enum INSTANCE tid (`Tree[Int]`), the enum analogue of
// make_struct_instance_type (jjhnf3). Records the concrete type-args variadically
// in ty_param_list[params_start..] so tc_tid_struct_arg_* / tc_tid_struct_mono_name
// (all kind-agnostic once widened to TyKind.Enum) can recover them at codegen, minting
// the mono typedef `blink_Tree_Int` instead of the erased bare `blink_Tree`. INTERNS
// (br v76b0b) — see make_struct_instance_type above.
fn make_enum_instance_type(base_name: Str, arg_types: List[Int]) -> Int {
    ty_intern_variadic(TyKind.Enum, base_name, -1, arg_types)
}


// `pub` FOR THE TEST ONLY — see make_option_type above.
pub fn make_map_type(key_type: Int, value_type: Int) -> Int {
    ty_intern_simple(TyKind.Map, "Map", key_type, value_type)
}

// `pub` FOR THE TEST ONLY — see make_list_type above.
pub fn make_set_type(elem_type: Int) -> Int {
    ty_intern_simple(TyKind.Set, "Set", elem_type, -1)
}

// The two one-inner runtime carriers (br vag3wc). Until these existed, `new_type` was never
// called with TyKind.Handle or TyKind.Channel, so an annotation naming one fell through
// resolve_type_ann to `make_typevar(name)` — a bare typevar wearing the type's name. Codegen
// meanwhile had CT_HANDLE / CT_CHANNEL and carried the element in its flat fields, which made
// the flat universe STRICTLY more informative than the tid for these and would have left the
// Stage 3 divergence counter permanently nonzero at those sites with nothing to read. It also
// broke a real program: `iter_tk == TyKind.Channel` is how tc_check_body recognises a channel
// as iterable, and a typevar is not that kind, so ANNOTATING a channel made it un-iterable.
//
// Shaped exactly like make_set_type: one inner, name = the type's own name, so tc_tid_child /
// tc_tid_child_count / the spellers / tk_to_ct all reach them through the arms they already
// had.
//
// The other two unconstructible kinds resolve differently. TyKind.Closure is DELETED, not
// constructed: TyKind.Fn is already constructed (make_fn_type), covers the same surface (a
// closure's declared type is spelled `Fn(..) -> T`), and tk_to_ct collapsed both to CT_VOID
// anyway. TyKind.Iterator is DEFERRED to br qzdz2e on a spec question — see the note on its
// tc_tid_child_count arm.
pub fn make_handle_type(result_type: Int) -> Int {
    ty_intern_simple(TyKind.Handle, "Handle", result_type, -1)
}

pub fn make_channel_type(elem_type: Int) -> Int {
    ty_intern_simple(TyKind.Channel, "Channel", elem_type, -1)
}

// br w13xgb. The fifth case of the vag3wc audit, and the worst of them: TyKind.Ptr did not
// merely go unconstructed, it did not EXIST. Typecheck only ever checked `Ptr[T]` syntactically
// (PtrOutsideFFI, InvalidPtrType, is_valid_ptr_inner), so resolve_type_ann fell through to a
// typevar named "Ptr" — as permissive as TYPE_UNKNOWN, and permissive at the RECEIVER, which is
// why no method arm could have helped. Assigning a Ptr[Pollfd] to a declared Ptr[Int] therefore
// passed typecheck and failed as a raw cc error inside build/, with no span.
//
// One inner = the pointee, shaped like make_handle_type so tc_tid_child / tc_tid_child_count /
// the spellers / tk_to_ct reach it through arms they already had. Interned, so the two Ptr[T]
// mentions in a signature and its call site are integer-equal.
pub fn make_ptr_type(pointee: Int) -> Int {
    ty_intern_simple(TyKind.Ptr, "Ptr", pointee, -1)
}

// br nrrs28, and the sixth case of the same shape as make_ptr_type above. `Template` is
// claimed by is_primitive_type (:6866) so no user type could have taken the name, and
// resolve_type_parts had no arm for it — so every `tpl: Template[DB]` resolved to
// make_typevar("Template"), permissive at the RECEIVER, which is why the seven introspection
// methods codegen has always emitted could have no return type no matter what arm was added.
//
// One inner = the phantom context (`DB` in `Template[DB]`), shaped like make_ptr_type so
// tc_tid_child / tc_tid_child_count / the spellers / tk_to_ct reach it through arms they
// already have. The phantom is CARRIED, not yet CHECKED: sections/03b_contracts.md:563 states
// that `Template[Shell]` may not be passed where `Template[DB]` is expected, and today it can
// be. That check needs the contexts to be comparable, and the spec's own contexts (`DB`,
// `Shell`) are EFFECT names, which are not in the type namespace — so each resolves to a
// typevar, and typevars unify with anything by design. Carrying the phantom is the
// prerequisite for ever enforcing it; enforcing it is a spec question, filed separately.
pub fn make_template_type(context: Int) -> Int {
    ty_intern_simple(TyKind.Template, "Template", context, -1)
}

// br ps5br9 — the value `ffi.scope()` produces. Codegen has carried CT_FFI_SCOPE
// (codegen_types.bl:48) and a four-method emitter block (codegen_methods.bl:4886) since the
// FFI surface landed; typecheck had no kind for the scope object at all, so `with ffi.scope()
// as scope` bound the binder at TYPE_UNKNOWN and the RECEIVER was permissive before any
// method arm could run. The sixth and last sighting of the untyped-receiver family.
//
// Childless: a scope is an opaque arena handle, not a container — §07:265-291 gives it three
// operations and no element type. So it takes the same shape as TyKind.Bytes rather than
// TyKind.Ptr, and every structural accessor answers "no children" through arms it already has.
pub fn make_ffi_scope_type() -> Int {
    ty_intern_simple(TyKind.FfiScope, "FFIScope", -1, -1)
}

// ── Metavariables (Hindley-Milner inference discipline) ─────────────
//
// A metavariable is a *fresh* TyKind.Unknown pool entry (minted per binding via
// make_metavar), distinct from the single shared TYPE_UNKNOWN sentinel so each
// unannotated `[]` / `None` / `Map()` / `Set()` gets its OWN α that can be pinned
// independently by a later constraining use. This is textbook HM: an α starts
// unbound and is bound in place when unification meets it against a concrete type
// (`xs.push(1)` pins List's element α to Int). Under-determined types (an α still
// unbound at the region boundary) become error[CannotInferType] (E0301) rather
// than the pre-decision silent Void-erasure. Decision: decisions/under-determined-types.md.
//
// Representation rides the existing functional pool (no new store):
//   unbound α : kind == TyKind.Unknown, inner1 == -1   (new_type's default)
//   bound   α : kind == TyKind.Unknown, inner1 == <solution tid>  (>= 0, set via ty_pool.set)
// The shared TYPE_UNKNOWN singleton keeps inner1 == -1 forever (never a per-binding
// α, never bound), so resolve() is the identity on it — Stage-1-safe.

// `pub` FOR THE TEST ONLY — same precedent as make_fn_type. Constructing an unbound
// metavar directly is the only way to prove tc_tid_tag_at's TyKind.Unknown arm (br vbcw1e
// Stage 2) actually fires at either tag position: no fully-typechecked surface
// program can produce one, since check_types resolves or E0301's every metavar at
// the region boundary (8vcj2c) before codegen ever sees it.
pub fn make_metavar() -> Int {
    // A fresh, independently-bindable α. NOT the shared TYPE_UNKNOWN singleton.
    new_type(TyKind.Unknown, "?")
}

fn tc_is_unbound_metavar(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return 0 }
    if tid == TYPE_UNKNOWN { return 0 }
    let e = ty_pool.get(tid).unwrap()
    if e.kind == TyKind.Unknown && e.inner1 < 0 { return 1 }
    0
}

// Follow a bound metavar to its solution. Identity on concrete types, typevars,
// the shared TYPE_UNKNOWN singleton, and unbound metavars. The step cap is a
// defensive backstop; the occurs-guard in bind_metavar prevents cycles at bind
// time, so in practice the chain is short (path compression optional).
// Named tc_resolve (not bare `resolve`) to avoid a flat-symbol clash with
// pkg.resolver.resolve in the archive-linked build.
fn tc_resolve(tid0: Int) -> Int {
    let mut tid = tid0
    let mut steps = 0
    while steps < 10000 {
        if tid < 0 || tid >= ty_pool.len() { return tid }
        let e = ty_pool.get(tid).unwrap()
        if e.kind == TyKind.Unknown && e.inner1 >= 0 {
            tid = e.inner1
            steps = steps + 1
        } else {
            return tid
        }
    }
    tid
}

// Does `needle` (an unbound α) occur inside `hay` after resolution? Guards
// bind_metavar against building an infinitely-recursive type (α := List[α]).
fn tc_occurs_in(needle: Int, hay0: Int) -> Int {
    let hay = tc_resolve(hay0)
    if hay < 0 || hay >= ty_pool.len() { return 0 }
    if hay == needle { return 1 }
    let e = ty_pool.get(hay).unwrap()
    let k = e.kind
    if k == TyKind.List || k == TyKind.Option || k == TyKind.Set {
        return tc_occurs_in(needle, e.inner1)
    }
    if k == TyKind.Result || k == TyKind.Map {
        if tc_occurs_in(needle, e.inner1) != 0 { return 1 }
        return tc_occurs_in(needle, e.inner2)
    }
    if k == TyKind.Tuple || k == TyKind.Struct || k == TyKind.Enum {
        let mut i = 0
        while i < e.params_count {
            let c = ty_param_list.get(e.params_start + i).unwrap()
            if tc_occurs_in(needle, c) != 0 { return 1 }
            i = i + 1
        }
        return 0
    }
    0
}

// Bind an unbound metavar α to a concrete solution by mutating its slot in place
// (the ty_pool.set idiom every make_*_type uses). Returns 1 on success. Refuses a
// self-bind (α := α) and a cyclic bind (α occurs in the solution) — both leave α
// unbound so the region-boundary check can report E0301.
fn bind_metavar(a0: Int, sol0: Int) -> Int {
    let a = tc_resolve(a0)
    let sol = tc_resolve(sol0)
    if tc_is_unbound_metavar(a) == 0 { return 0 }
    if a == sol { return 0 }
    if tc_occurs_in(a, sol) != 0 { return 0 }
    let e = ty_pool.get(a).unwrap()
    ty_pool.set(a, TypePoolEntry { inner1: sol, ..e })
    1
}

// Does `tid` carry an unbound metavariable anywhere in its structure (after
// resolution)? True for a bare unbound α and for any compound that transitively
// contains one (List[α], Map[Str,α], Box[α], (Int, α), …). This is the shared
// under-determined predicate: check_arg_value uses it to decide whether to take
// the unify path, and the Stage-3 region-boundary check uses it to fire E0301.
// NOTE: does NOT reuse tc_tid_encodable — that predicate does not descend
// TyKind.List/TyKind.Set (verified) and would miss an under-determined list element.
fn tc_tid_has_unbound_metavar(tid0: Int) -> Int {
    let tid = tc_resolve(tid0)
    if tid < 0 || tid >= ty_pool.len() { return 0 }
    if tc_is_unbound_metavar(tid) != 0 { return 1 }
    let e = ty_pool.get(tid).unwrap()
    let k = e.kind
    if k == TyKind.List || k == TyKind.Option || k == TyKind.Set {
        return tc_tid_has_unbound_metavar(e.inner1)
    }
    if k == TyKind.Result || k == TyKind.Map {
        if tc_tid_has_unbound_metavar(e.inner1) != 0 { return 1 }
        return tc_tid_has_unbound_metavar(e.inner2)
    }
    if k == TyKind.Tuple || k == TyKind.Struct || k == TyKind.Enum {
        let mut i = 0
        while i < e.params_count {
            let c = ty_param_list.get(e.params_start + i).unwrap()
            if tc_tid_has_unbound_metavar(c) != 0 { return 1 }
            i = i + 1
        }
        return 0
    }
    0
}

// Does `tid` carry the shared TYPE_UNKNOWN HOLE anywhere in its structure? The third member
// of this family, and the one a gate written `tid == TYPE_UNKNOWN` cannot express: `List[?]`
// is not TYPE_UNKNOWN, so a partially erased answer counted as an answer and the bfq7nf
// recovery below never ran on it (br gmb211).
//
// An unbound metavar is deliberately NOT a hole here. α and `?` are both "not concrete yet",
// but α is solvable — by a later use, an argument unify, or monomorphization — so replacing
// `List[α]` with a concrete memo would PIN it, which is the lossy direction sskpk8's pin gates
// refuse. tc_is_unbound_metavar already excludes the TYPE_UNKNOWN singleton, so the two
// predicates partition the two kinds of emptiness rather than overlapping.
pub fn tc_tid_has_unknown(tid0: Int) -> Int {
    let tid = tc_resolve(tid0)
    if tid == TYPE_UNKNOWN { return 1 }
    if tid < 0 || tid >= ty_pool.len() { return 0 }
    let e = ty_pool.get(tid).unwrap()
    let k = e.kind
    if k == TyKind.List || k == TyKind.Option || k == TyKind.Set {
        return tc_tid_has_unknown(e.inner1)
    }
    if k == TyKind.Result || k == TyKind.Map {
        if tc_tid_has_unknown(e.inner1) != 0 { return 1 }
        return tc_tid_has_unknown(e.inner2)
    }
    if k == TyKind.Tuple || k == TyKind.Struct || k == TyKind.Enum {
        let mut i = 0
        while i < e.params_count {
            let c = ty_param_list.get(e.params_start + i).unwrap()
            if tc_tid_has_unknown(c) != 0 { return 1 }
            i = i + 1
        }
        return 0
    }
    0
}

// Fill the HOLES in `base` from the same positions in `src`, position by position, and change
// nothing else. The recovery's take rule (br gmb211): `Result[?, ?]` recovered against a memo
// of `Result[Str, ?]` must become `Result[Str, ?]` — an all-or-nothing "take the memo only if
// it has no hole" rule would refuse it and leave BOTH sides erased, and `Ok(p)` genuinely
// cannot know its error type, so a residual hole is the correct answer there, not a reason to
// decline. Parity with the ordinary path is the bar: `let a = Ok("v")` outside a block infers
// `Result[Str, ?]`, so the same value inside one must not do worse.
//
// Three invariants, each load-bearing:
//   • A concrete position is NEVER overwritten — only a `?` is filled, so this can only add
//     information. That is what makes it safe to run after a compare-free inference.
//   • An unbound metavar is never pinned. tc_tid_has_unknown answers 0 for α, so `Map[α, ?]`
//     against `Map[Str, Int]` yields `Map[α, Int]` and α stays solvable (sskpk8).
//   • Differing kinds return `base` untouched: this is a recovery, not a unifier, and it must
//     never turn a mismatch into agreement.
// Struct/enum instance params are deliberately left alone — their tids are built by the
// generic-instance machinery (tc_*_instance_tid) and reconstructing one here would duplicate
// that path rather than read it.
fn tc_tid_fill_unknowns(base0: Int, src0: Int) -> Int {
    let base = tc_resolve(base0)
    let src = tc_resolve(src0)
    if base == src { return base }
    if src == TYPE_UNKNOWN { return base }
    if base == TYPE_UNKNOWN { return src }
    if base < 0 || base >= ty_pool.len() { return base }
    if src < 0 || src >= ty_pool.len() { return base }
    if tc_tid_has_unknown(base) == 0 { return base }
    let eb = ty_pool.get(base).unwrap()
    let es = ty_pool.get(src).unwrap()
    if eb.kind != es.kind { return base }
    if eb.kind == TyKind.List { return make_list_type(tc_tid_fill_unknowns(eb.inner1, es.inner1)) }
    if eb.kind == TyKind.Option { return make_option_type(tc_tid_fill_unknowns(eb.inner1, es.inner1)) }
    if eb.kind == TyKind.Set { return make_set_type(tc_tid_fill_unknowns(eb.inner1, es.inner1)) }
    if eb.kind == TyKind.Result {
        return make_result_type(tc_tid_fill_unknowns(eb.inner1, es.inner1), tc_tid_fill_unknowns(eb.inner2, es.inner2))
    }
    if eb.kind == TyKind.Map {
        return make_map_type(tc_tid_fill_unknowns(eb.inner1, es.inner1), tc_tid_fill_unknowns(eb.inner2, es.inner2))
    }
    if eb.kind == TyKind.Tuple {
        if eb.params_count != es.params_count { return base }
        let mut filled: List[Int] = []
        let mut i = 0
        while i < eb.params_count {
            let bc = ty_param_list.get(eb.params_start + i).unwrap()
            let sc = ty_param_list.get(es.params_start + i).unwrap()
            filled.push(tc_tid_fill_unknowns(bc, sc))
            i = i + 1
        }
        return make_tuple_type(filled)
    }
    base
}

// Does `tid` carry a BARE TYPEVAR anywhere in its structure? The structural twin of
// tc_tid_has_unbound_metavar above, and deliberately a separate predicate: α and T are both
// "not concrete yet" but they are not interchangeable, and only one of them is solvable.
//
// A metavar can still be bound — by a later use, an argument-position unify, or
// monomorphization. A bare typevar cannot: as instantiate_return_type's doc spells out,
// tc_is_unbound_metavar counts only TyKind.Unknown with inner1 < 0 and tc_unify's typevar arm
// returns 1 WITHOUT binding, so a bare typevar is invisible to the whole metavar machinery.
// That makes `α := T` a strictly lossy pin — it converts a solvable hole into an unsolvable
// one — which is why the pin caller below refuses a declared type containing one (sskpk8).
pub fn tc_tid_has_bare_typevar(tid0: Int) -> Int {
    let tid = tc_resolve(tid0)
    if tid < 0 || tid >= ty_pool.len() { return 0 }
    let e = ty_pool.get(tid).unwrap()
    let k = e.kind
    if k == TyKind.Typevar { return 1 }
    if k == TyKind.List || k == TyKind.Option || k == TyKind.Set {
        return tc_tid_has_bare_typevar(e.inner1)
    }
    if k == TyKind.Result || k == TyKind.Map {
        if tc_tid_has_bare_typevar(e.inner1) != 0 { return 1 }
        return tc_tid_has_bare_typevar(e.inner2)
    }
    if k == TyKind.Tuple || k == TyKind.Struct || k == TyKind.Enum {
        let mut i = 0
        while i < e.params_count {
            let c = ty_param_list.get(e.params_start + i).unwrap()
            if tc_tid_has_bare_typevar(c) != 0 { return 1 }
            i = i + 1
        }
        return 0
    }
    0
}

// Does `tid` name a transparent `type Alias = X` anywhere in its structure? The tid tree
// stores the alias's OWN name, and resolve_alias_tid only ever peels the outermost one, so
// `Map[Port, Int]` keeps `Port` in its key slot while the parallel annotation-NODE path
// (type_from_name) lowers it to Int. Two spellings of one type, and the pin caller below
// refuses rather than committing the un-canonical one (sskpk8; the structural resolver is
// tracked as its own prerequisite, br bvh7qt).
pub fn tc_tid_has_alias(tid0: Int) -> Int {
    if tc_alias_underlying.len() == 0 { return 0 }
    let tid = tc_resolve(tid0)
    if tid < 0 || tid >= ty_pool.len() { return 0 }
    let e = ty_pool.get(tid).unwrap()
    if e.name != "" {
        let under = tc_alias_underlying.get(e.name) ?? -1
        if under != -1 { return 1 }
    }
    let k = e.kind
    if k == TyKind.List || k == TyKind.Option || k == TyKind.Set {
        return tc_tid_has_alias(e.inner1)
    }
    if k == TyKind.Result || k == TyKind.Map {
        if tc_tid_has_alias(e.inner1) != 0 { return 1 }
        return tc_tid_has_alias(e.inner2)
    }
    if k == TyKind.Tuple || k == TyKind.Struct || k == TyKind.Enum {
        let mut i = 0
        while i < e.params_count {
            let c = ty_param_list.get(e.params_start + i).unwrap()
            if tc_tid_has_alias(c) != 0 { return 1 }
            i = i + 1
        }
        return 0
    }
    0
}

// The machine-applicable annotation shape that would fix an under-determined
// binding, chosen from the empty-ctor's known outer shape (gqg3rk report-at-
// binding, dual-span). `: List[T]` / `: T?` / `: Map[K, V]` / `: Set[T]`; a
// generic construction names its open params. Falls back to ": T" for a bare α.
fn tc_infer_annotation_hint(tid0: Int) -> Str {
    let tid = tc_resolve(tid0)
    if tid < 0 || tid >= ty_pool.len() { return ": T" }
    let e = ty_pool.get(tid).unwrap()
    let k = e.kind
    if k == TyKind.List { return ": List[T]" }
    if k == TyKind.Option { return ": T?" }
    if k == TyKind.Set { return ": Set[T]" }
    if k == TyKind.Map { return ": Map[K, V]" }
    if k == TyKind.Struct || k == TyKind.Enum {
        return ": {strip_module_qualifier(e.name)}[...]"
    }
    ": T"
}

// Pin a sealed Ops-trait receiver's element metavar(s) from the call's payload
// args (gqg3rk). These static calls (MapOps.insert(m,k,v) …) put the receiver at
// args[0]; the element-bearing args follow. Mirrors the method-call pin so the
// trait-qualified spelling is an equally-good constraining use. No-op unless the
// receiver container actually carries an unbound metavar.
fn tc_pin_ops_trait_receiver(trait_name: Str, method: Str, args_sl: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if args_sl == -1 || sublist_length(args_sl) < 2 { return }
    let recv = tc_resolve(infer_type(sublist_get(args_sl, 0)))
    if tc_tid_has_unbound_metavar(recv) == 0 { return }
    let rk = ty_pool.get(recv).unwrap().kind
    // Only pin from a method whose pinned-position argument GENUINELY carries the
    // element/key/value. A blind "arg1"/"last-arg" heuristic mis-pins the many
    // methods whose args are indices or whole containers (ListOps.get(l, idx),
    // ListOps.concat(l, other), SetOps.union(s, other)) — that would infer the
    // element from an Int index or a nested container. Gate per method explicitly.
    if trait_name == "MapOps" {
        // insert(m,k,v): arg1→key, arg2→value. get/contains_key/remove(m,k): arg1→key.
        // (len/keys/values are 1-arg → early-returned above.) Every 2+-arg MapOps
        // method takes the key at arg1, so arg1→key is always right here.
        if rk != TyKind.Map { return }
        let key_a = ty_pool.get(recv).unwrap().inner1
        let val_a = ty_pool.get(recv).unwrap().inner2
        if method == "insert" || method == "get" || method == "contains_key" || method == "remove" {
            if tc_tid_has_unbound_metavar(key_a) != 0 {
                let _ = tc_unify(key_a, infer_type(sublist_get(args_sl, 1)))
            }
        }
        if method == "insert" && sublist_length(args_sl) >= 3 && tc_tid_has_unbound_metavar(val_a) != 0 {
            let _ = tc_unify(val_a, infer_type(sublist_get(args_sl, 2)))
        }
        return
    }
    if trait_name == "SetOps" {
        // insert/contains/remove(s,e): arg1→elem. union(s, other) takes a Set, NOT
        // an element — must NOT pin from it (would infer Set[Set[T]]).
        if rk != TyKind.Set { return }
        if method != "insert" && method != "contains" && method != "remove" { return }
        let elem_a = ty_pool.get(recv).unwrap().inner1
        if tc_tid_has_unbound_metavar(elem_a) != 0 {
            let _ = tc_unify(elem_a, infer_type(sublist_get(args_sl, 1)))
        }
        return
    }
    if trait_name == "ListOps" {
        // Only push(l,x) and set(l,i,x) carry the element at the LAST arg. get(l,i),
        // pop(l), concat(l,other), slice(l,s,e) do NOT — their last arg is an Int
        // index/bound or another List, so pinning from it mis-infers the element.
        if rk != TyKind.List { return }
        if method != "push" && method != "set" { return }
        let elem_a = ty_pool.get(recv).unwrap().inner1
        if tc_tid_has_unbound_metavar(elem_a) != 0 {
            let last = sublist_get(args_sl, sublist_length(args_sl) - 1)
            let _ = tc_unify(elem_a, infer_type(last))
        }
        return
    }
}

// Report a binding whose type is under-determined — HM finished the region with a
// metavar still unbound (an empty `[]`/`None`/`Map()`/`Set()` never pinned by a
// constraining use). error[CannotInferType] (E0301), sole repair is annotation
// (decision 8vcj2c, 6-0). Report-at-binding, dual-span: primary caret at the
// `let`, a secondary note at the empty ctor (the RHS value). The `help` text shows
// the annotation SHAPE with placeholder type-params (T/K/V) — deliberately NOT a
// machine-applicable `fix`, because the element type is precisely what the error
// says is unknowable: an auto-applied `: List[T]` would insert an undefined `T`.
fn tc_report_under_determined(vname: Str, tid: Int, decl_node: Int) ! Diag.Report {
    if decl_node == -1 { return }
    let hint = tc_infer_annotation_hint(tid)
    let mut notes: List[Str] = []
    let val = node_value(decl_node)
    if val != -1 {
        notes.push("the empty construction here has no element type to infer at line {node_line(val)}")
    }
    diag_error_at_notes("CannotInferType", CANNOT_INFER_TYPE, "cannot infer a type for '{vname}': it is never given one by an annotation or a later use", decl_node, "add a type annotation, e.g. `let {vname}{hint} = ...` (replace the placeholder with the intended element type)", notes)
}

// Structural unification. On meeting an unbound α on either side, bind it to the
// other side (the crux fix — the constraint is *recorded*, not discarded the way
// check_arg_value's TYPE_UNKNOWN early-return does today). Returns 1 if the two
// types can be made equal, 0 on a hard structural mismatch. Same-kind compound
// types unify element-wise; unequal concrete kinds fail. This is intentionally
// permissive toward the legacy TYPE_UNKNOWN singleton and bare TyKind.Typevar (both
// treated as "unifies with anything, no bind") so Stage 1 is behavior-neutral —
// only fresh per-binding metavars from make_metavar ever get pinned.
fn tc_unify(a0: Int, b0: Int) -> Int {
    let a = tc_resolve(a0)
    let b = tc_resolve(b0)
    if a == b { return 1 }
    if a < 0 || b < 0 { return 1 }
    if a >= ty_pool.len() || b >= ty_pool.len() { return 1 }
    // Legacy singleton / bare typevar: unify vacuously, never bind (Stage-1 neutral).
    if a == TYPE_UNKNOWN || b == TYPE_UNKNOWN { return 1 }
    let ka0 = ty_pool.get(a).unwrap().kind
    let kb0 = ty_pool.get(b).unwrap().kind
    if ka0 == TyKind.Typevar || kb0 == TyKind.Typevar { return 1 }
    // Unbound metavar on either side: pin it to the other side.
    if tc_is_unbound_metavar(a) != 0 { return bind_metavar(a, b) }
    if tc_is_unbound_metavar(b) != 0 { return bind_metavar(b, a) }
    let ta = ty_pool.get(a).unwrap()
    let tb = ty_pool.get(b).unwrap()
    let ka = ta.kind
    let kb = tb.kind
    if ka != kb { return 0 }
    if ka == TyKind.List || ka == TyKind.Option || ka == TyKind.Set {
        return tc_unify(ta.inner1, tb.inner1)
    }
    if ka == TyKind.Result || ka == TyKind.Map {
        if tc_unify(ta.inner1, tb.inner1) == 0 { return 0 }
        return tc_unify(ta.inner2, tb.inner2)
    }
    if ka == TyKind.Tuple {
        if ta.params_count != tb.params_count { return 0 }
        let mut i = 0
        while i < ta.params_count {
            let ea = ty_param_list.get(ta.params_start + i).unwrap()
            let eb = ty_param_list.get(tb.params_start + i).unwrap()
            if tc_unify(ea, eb) == 0 { return 0 }
            i = i + 1
        }
        return 1
    }
    if ka == TyKind.Struct || ka == TyKind.Enum {
        if strip_module_qualifier(ta.name) != strip_module_qualifier(tb.name) { return 0 }
        if ta.params_count > 0 && tb.params_count > 0 {
            if ta.params_count != tb.params_count { return 0 }
            let mut i = 0
            while i < ta.params_count {
                let ea = ty_param_list.get(ta.params_start + i).unwrap()
                let eb = ty_param_list.get(tb.params_start + i).unwrap()
                if tc_unify(ea, eb) == 0 { return 0 }
                i = i + 1
            }
        }
        return 1
    }
    // Same concrete scalar kind (Int/Str/Bool/…): already equal by kind.
    1
}

// ── Type lookup ─────────────────────────────────────────────────────

fn lookup_named_type(name: Str) -> Int {
    match named_type_map.get(name) {
        Some(v) => return v
        None => {}
    }
    let dot = name.index_of(".")
    if dot >= 0 {
        let bare = name.slice(dot + 1, name.len())
        let resolved = tc_alias_to_original.get(bare) ?? bare
        match named_type_map.get(resolved) {
            Some(v) => return v
            None => {}
        }
        match named_type_map.get(bare) {
            Some(v) => return v
            None => {}
        }
    }
    -1
}

// b907wt: mint a declaration for a RUNTIME-BACKED compiler-known type on demand.
//
// ProcessResult's C struct lives in bootstrap/runtime_process.h and codegen names it with
// no Blink declaration at all (src/codegen.bl:634 reg_fn_struct_ret, :650-652 the fields).
// So `let r = process_pid_wait(pid)` compiles and RUNS correctly in a file that never
// writes `import std.process` — src/cli.bl:2187 is exactly that. Typecheck used to answer
// TYPE_VOID there: a fail-OPEN erasure that also swallowed every downstream `r.out`.
//
// The type is known, so typecheck says so. Minting is idempotent and always defers to a
// real declaration, because lookup runs first: if lib/std/process.bl is in the program its
// register_struct_type has already inserted the name (registration precedes inference), and
// this returns that tid. Fields are registered here too — a fieldless mint would turn a
// silent erasure into a spurious "no field" error, which is worse.
fn ensure_runtime_struct_type(name: Str, fnames: List[Str], ftids: List[Int]) -> Int {
    let existing = lookup_named_type(name)
    if existing != -1 { return existing }
    let tid = new_type(TyKind.Struct, name)
    named_type_names.push(name)
    named_type_ids.push(tid)
    named_type_map.insert(name, tid)
    let mut i = 0
    while i < fnames.len() {
        sfield_pool.push(TcStructField { struct_id: tid, name: fnames.get(i).unwrap(), type_id: ftids.get(i).unwrap() })
        i = i + 1
    }
    tid
}

fn runtime_process_result_tid() -> Int {
    ensure_runtime_struct_type("ProcessResult", ["out", "err_out", "exit_code"], [TYPE_STR, TYPE_STR, TYPE_INT])
}

// 7cq6w2: THE StringBuilder tid — one entry per program, so `sb_a` and `sb_b` compare
// equal by integer comparison per decisions/compiler-type-representation.md Q3.
//
// Goes through ty_intern_simple rather than new_type, unlike the TyKind.Bytes sites it
// otherwise mirrors (:2236, :5875). new_type is deliberately un-interned to keep every
// metavar FRESH, and a childless nominal leaf gets no benefit from that freshness — it
// just gets a fresh tid per mention. (Bytes therefore has as many tids as it has
// mentions; that is pre-existing and separate.)
fn type_stringbuilder() -> Int {
    ty_intern_simple(TyKind.StringBuilder, "StringBuilder", -1, -1)
}

fn resolve_type_name(name: Str) -> Int ! TypeCheck.Resolve {
    if name == "Int" { return TYPE_INT }
    if name == "Float" { return TYPE_FLOAT }
    if name == "Bool" { return TYPE_BOOL }
    if name == "Str" { return TYPE_STR }
    if name == "Void" || name == "" { return TYPE_VOID }
    if name == "I8" { return TYPE_I8 }
    if name == "I16" { return TYPE_I16 }
    if name == "I32" { return TYPE_I32 }
    if name == "I64" { return TYPE_INT }
    if name == "U8" { return TYPE_U8 }
    if name == "U16" { return TYPE_U16 }
    if name == "U32" { return TYPE_U32 }
    if name == "U64" { return TYPE_U64 }
    if name == "Char" { return TYPE_CHAR }
    // A builtin with no Blink declaration anywhere: `StringBuilder` names codegen's
    // CT_STRINGBUILDER / `blink_sb*` and is listed by is_primitive_type, but lib/std/sb.bl
    // only declares FUNCTIONS over it. Without this arm every `sb: StringBuilder` param
    // and `-> StringBuilder` return resolved to -1 and inference fell back to Unknown.
    if name == "StringBuilder" { return type_stringbuilder() }
    lookup_named_type(name)
}

fn get_struct_field_tid(struct_tid: Int, fname: Str) -> Int {
    // Field entries are registered against the BASE declaration tid (register_
    // struct_type). A monomorphized instance tid (Box[Int], a fresh entry sharing
    // the base name — br qw7v90) must normalize back to that base before matching,
    // or field lookups on any instance-typed value return -1. tc_struct_base_tid
    // is a no-op for a bare tid.
    let base = tc_struct_base_tid(struct_tid)
    let mut i = 0
    while i < sfield_pool.len() {
        let sf = sfield_pool.get(i).unwrap()
        if sf.struct_id == base && sf.name == fname {
            return sf.type_id
        }
        i = i + 1
    }
    -1
}

// Normalize a possibly-monomorphized struct instance tid (Box[Int]) to its base
// declaration tid (Box), by name (br qw7v90). Any consumer that maps a struct tid
// back to declaration-level data keyed on the base tid (fields; anything using
// sf.struct_id) must normalize first. A bare tid, a non-struct tid, or an
// unresolvable name returns the input unchanged.
fn tc_struct_base_tid(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return tid }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Struct { return tid }
    if t.params_count == 0 { return tid }
    let base = lookup_named_type(strip_module_qualifier(t.name))
    if base == -1 { return tid }
    base
}

fn get_variant_by_name(enum_tid: Int, vname: Str) -> Int {
    let mut i = 0
    while i < evar_pool.len() {
        let ev = evar_pool.get(i).unwrap()
        if ev.enum_id == enum_tid && ev.name == vname {
            return i
        }
        i = i + 1
    }
    -1
}

fn lookup_evfield_type_by_index(var_idx: Int, idx: Int) -> Int {
    let mut i = 0
    let mut seen = 0
    while i < evfield_pool.len() {
        let ef = evfield_pool.get(i).unwrap()
        if ef.var_idx == var_idx {
            if seen == idx { return ef.type_id }
            seen = seen + 1
        }
        i = i + 1
    }
    -1
}

fn lookup_evfield_type_by_name(var_idx: Int, name: Str) -> Int {
    let mut i = 0
    while i < evfield_pool.len() {
        let ef = evfield_pool.get(i).unwrap()
        if ef.var_idx == var_idx && ef.name == name {
            return ef.type_id
        }
        i = i + 1
    }
    -1
}

fn lookup_fnsig(name: Str) -> Int {
    if nr_current_module != "" {
        let qualified = "{nr_current_module}:{name}"
        match fnsig_map.get(qualified) {
            Some(v) => return v
            None => {}
        }
    }
    fnsig_map.get(name) ?? -1
}

// Recursively substitute typevar tids in `t` using the name→tid map `binds`
// (typevar-name → concrete tid). Mirrors types_compatible's structural dispatch
// and rebuilds compound shells via the make_* constructors so the returned tid
// carries concrete elements. A kind with no embedded typevar — or an unbound
// typevar — is returned unchanged; a new pool entry is allocated only when a
// child actually changes (avoids ty_pool churn).
fn substitute_typevar_tid(t: Int, binds: Map[Str, Int]) -> Int {
    if t < 0 || t >= ty_pool.len() { return t }
    let e = ty_pool.get(t).unwrap()
    let k = e.kind
    if k == TyKind.Typevar {
        match binds.get(e.name) {
            Some(tid) => return tid
            None => return t
        }
    }
    if k == TyKind.List {
        let inner = substitute_typevar_tid(e.inner1, binds)
        if inner == e.inner1 { return t }
        return make_list_type(inner)
    }
    if k == TyKind.Option {
        let inner = substitute_typevar_tid(e.inner1, binds)
        if inner == e.inner1 { return t }
        return make_option_type(inner)
    }
    if k == TyKind.Set {
        let inner = substitute_typevar_tid(e.inner1, binds)
        if inner == e.inner1 { return t }
        return make_set_type(inner)
    }
    if k == TyKind.Result {
        let ok = substitute_typevar_tid(e.inner1, binds)
        let er = substitute_typevar_tid(e.inner2, binds)
        if ok == e.inner1 && er == e.inner2 { return t }
        return make_result_type(ok, er)
    }
    if k == TyKind.Map {
        let kk = substitute_typevar_tid(e.inner1, binds)
        let vv = substitute_typevar_tid(e.inner2, binds)
        if kk == e.inner1 && vv == e.inner2 { return t }
        return make_map_type(kk, vv)
    }
    if k == TyKind.Tuple {
        // Read every original element into `elems` BEFORE calling make_tuple_type:
        // the constructor appends to ty_param_list, the same array we read
        // e.params_start.. from, so finishing the read first avoids aliasing.
        let mut elems: List[Int] = []
        let mut changed = 0
        let mut i = 0
        while i < e.params_count {
            let orig = ty_param_list.get(e.params_start + i).unwrap()
            let sub = substitute_typevar_tid(orig, binds)
            if sub != orig { changed = 1 }
            elems.push(sub)
            i = i + 1
        }
        if changed == 0 { return t }
        return make_tuple_type(elems)
    }
    if k == TyKind.Struct {
        // A monomorphized struct instance (`Box[T]`, params_count>=1) may embed a
        // typevar in a type-arg; substitute each and rebuild via make_struct_
        // instance_type. Same aliasing guard as TyKind.Tuple: make_struct_instance_type
        // appends to ty_param_list (the array we read e.params_start.. from), so
        // finish the read into `elems` FIRST. The bare generic base (params_count 0)
        // has no type-args — the loop is empty, changed stays 0, `t` returns as-is.
        let mut elems: List[Int] = []
        let mut changed = 0
        let mut i = 0
        while i < e.params_count {
            let orig = ty_param_list.get(e.params_start + i).unwrap()
            let sub = substitute_typevar_tid(orig, binds)
            if sub != orig { changed = 1 }
            elems.push(sub)
            i = i + 1
        }
        if changed == 0 { return t }
        return make_struct_instance_type(e.name, elems)
    }
    if k == TyKind.Enum {
        // The enum twin of the TyKind.Struct arm: a monomorphized enum instance (`Box[T]`,
        // params_count>=1) may embed a typevar in a type-arg; substitute each and rebuild
        // via make_enum_instance_type. Same aliasing guard — read all originals into
        // `elems` BEFORE the constructor appends to ty_param_list. A bare generic enum
        // (params_count 0) has no type-args → empty loop → changed==0 → returns `t`
        // unchanged (br 82ajft).
        let mut elems: List[Int] = []
        let mut changed = 0
        let mut i = 0
        while i < e.params_count {
            let orig = ty_param_list.get(e.params_start + i).unwrap()
            let sub = substitute_typevar_tid(orig, binds)
            if sub != orig { changed = 1 }
            elems.push(sub)
            i = i + 1
        }
        if changed == 0 { return t }
        return make_enum_instance_type(e.name, elems)
    }
    // TyKind.Fn and every scalar/nominal kind: no embedded typevar to rewrite.
    t
}

// The tparam-name → concrete-tid map for a codegen MONO CONTEXT: the enclosing
// monomorphized generic's tparam sublist zipped against its per-slot arg tids.
// Factored out of tc_mono_tids_subst so there is exactly ONE construction site for
// this pairing — a caller that skips the `tid >= 0` filter would bind a tparam to
// -1, which substitute_typevar_tid would then splice into a rebuilt instance as a
// pool index that is not a type.
fn tc_mono_binds_map(mono_tparams_sl: Int, mono_arg_tids: List[Int]) -> Map[Str, Int] {
    let mut binds: Map[Str, Int] = Map()
    if mono_tparams_sl == -1 { return binds }
    let mut mi = 0
    while mi < sublist_length(mono_tparams_sl) && mi < mono_arg_tids.len() {
        let tid = mono_arg_tids.get(mi).unwrap()
        if tid >= 0 {
            binds.insert(node_name(sublist_get(mono_tparams_sl, mi)), tid)
        }
        mi = mi + 1
    }
    binds
}

// Rewrite every typevar in `tid` through a codegen MONO CONTEXT, returning the
// interned tid of the substituted type (or `tid` itself when nothing changed).
//
// This is what lets a struct-instance tid written in terms of the ENCLOSING generic's
// binders — `GT[(T, Int)]` inside `fn wrap[T]` — be classified and spelled at the
// literal, where the only alternative was the I0001 chokepoint (br 6cvvh8). The
// substitution happens HERE rather than by relaxing an encodability predicate on
// purpose: a typevar has no C spelling, so admitting TyKind.Typevar into
// tc_tid_tuple_elem_faithful would let a genuinely-unsolved `T` produce a segment.
// Eliminate the typevar; keep the predicates conservative.
//
// Interning at codegen time is not a new hazard: substitute_typevar_tid is already
// reached from codegen via tc_resolve_tparam_tid, so the pool already grows during
// emission and every reader is index-based.
//
// No-op by construction when `tid < 0` or the mono context is empty, so a caller can
// apply it unconditionally and still be byte-identical outside a mono body.
pub fn tc_tid_subst_mono(tid: Int, mono_tparams_sl: Int, mono_arg_tids: List[Int]) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return tid }
    if mono_tparams_sl == -1 || mono_arg_tids.len() == 0 { return tid }
    substitute_typevar_tid(tid, tc_mono_binds_map(mono_tparams_sl, mono_arg_tids))
}

// Structurally unify a param tid against a concrete arg tid, recording every
// typevar→concrete binding into `binds`. The reverse of substitute_typevar_tid:
// where that walks one tid rewriting typevars via `binds`, this walks the param
// and arg tids in lockstep and *discovers* the bindings. A bare typevar param
// binds directly; a compound param recurses into the matching children so a
// typevar buried inside `List[T]` / `Option[T]` / `Set[T]` / `Result[T,E]` /
// `Map[K,V]` / `(A, B)` is still inferred. Pure bind collection — allocates NO
// pool entries (no make_* calls), so it never touches ty_param_list and is free
// of the tuple aliasing hazard substitute_typevar_tid guards against. The first
// CONCRETE binding wins; a later concrete arg overwrites only a placeholder bind
// (a non-concrete metavar/typevar) left by an earlier metavar-carrying sibling
// arg (see the TyKind.Typevar branch below); kind mismatches (arg not shaped like the
// param) bind nothing.
// A bind target is CONCRETE when, after following bound metavars, it is neither
// an unbound metavar nor a bare typevar — i.e. it names a real type a downstream
// substitution/pin can commit to. Used by unify_typevar_binds so a concrete arg
// can overwrite a placeholder bind left by a metavar-carrying sibling arg.
fn bind_target_is_concrete(tid: Int) -> Int {
    let r = tc_resolve(tid)
    if r < 0 || r >= ty_pool.len() { return 0 }
    if tc_is_unbound_metavar(r) != 0 { return 0 }
    if ty_pool.get(r).unwrap().kind == TyKind.Typevar { return 0 }
    1
}

fn unify_typevar_binds(ptid: Int, atid: Int, binds: Map[Str, Int]) {
    if ptid < 0 || ptid >= ty_pool.len() { return }
    if atid < 0 || atid >= ty_pool.len() { return }
    let pe = ty_pool.get(ptid).unwrap()
    let pk = pe.kind
    if pk == TyKind.Typevar {
        // "First binding wins" is only correct among CONCRETE args. A
        // metavar-carrying arg — a bare `Map()`/`Set()` whose element is a fresh
        // unbound α — unifies its typevar against that α; recording it would poison
        // the bind and block a later concrete sibling arg from supplying the real
        // type (m1wspm: `fill(Map(), 256, "x")` bound K to Map()'s α before the
        // `256` arg could bind K:=Int). So: record a bind only when it is absent, or
        // when the existing bind is itself non-concrete (a placeholder α/typevar) and
        // the new atid IS concrete. Never let a non-concrete atid overwrite or claim.
        match binds.get(pe.name) {
            Some(prev) => {
                if bind_target_is_concrete(atid) != 0 && bind_target_is_concrete(prev) == 0 {
                    binds.insert(pe.name, atid)
                }
            }
            None => {
                binds.insert(pe.name, atid)
            }
        }
        return
    }
    let ae = ty_pool.get(atid).unwrap()
    if ae.kind != pk { return }
    if pk == TyKind.List || pk == TyKind.Option || pk == TyKind.Set {
        unify_typevar_binds(pe.inner1, ae.inner1, binds)
        return
    }
    if pk == TyKind.Result || pk == TyKind.Map {
        unify_typevar_binds(pe.inner1, ae.inner1, binds)
        unify_typevar_binds(pe.inner2, ae.inner2, binds)
        return
    }
    if pk == TyKind.Tuple {
        if pe.params_count != ae.params_count { return }
        let mut i = 0
        while i < pe.params_count {
            let pc = ty_param_list.get(pe.params_start + i).unwrap()
            let ac = ty_param_list.get(ae.params_start + i).unwrap()
            unify_typevar_binds(pc, ac, binds)
            i = i + 1
        }
        return
    }
    if pk == TyKind.Struct || pk == TyKind.Enum {
        // A generic struct/enum param (`b: Box[T]`, `n: Tree[T]`) binds its typevars
        // from an instance arg (`Box[Int]`, `Tree[Int]`). Both are nominal — the base
        // names must match (module-qualifier-stripped) as well as the arity, unlike
        // the structural tuple case above. Walk the type-args in lockstep. A bare
        // generic base (no args, params_count 0) has nothing to bind and the loop is
        // empty. The TyKind.Enum case covers a recursive generic-enum field (jjhnf3:
        // `Branch(left: Tree[T], …)` unified against a `Tree[Int]` arg).
        if strip_module_qualifier(pe.name) != strip_module_qualifier(ae.name) { return }
        if pe.params_count != ae.params_count { return }
        let mut i = 0
        while i < pe.params_count {
            let pc = ty_param_list.get(pe.params_start + i).unwrap()
            let ac = ty_param_list.get(ae.params_start + i).unwrap()
            unify_typevar_binds(pc, ac, binds)
            i = i + 1
        }
        return
    }
}

// Build a typevar-name → concrete-tid map from the call's args by structurally
// unifying each param tid against its argument's inferred tid. Covers both the
// whole-bare-typevar rule (`x: T`) and typevars nested inside a compound param
// (`x: List[T]`, `x: (T, Int)`, `x: Map[K, V]`, …) via unify_typevar_binds.
fn build_typevar_binds(sig: Int, args_sl: Int) -> Map[Str, Int] ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let fs = fnsig_pool.get(sig).unwrap()
    let param_start = fs.params_start
    let param_count = fs.params_count
    let mut binds: Map[Str, Int] = Map()
    if args_sl == -1 { return binds }
    let n = sublist_length(args_sl)
    let mut pi = 0
    while pi < param_count {
        if pi < n {
            let ptid = fnsig_param_list.get(param_start + pi).unwrap()
            unify_typevar_binds(ptid, infer_type(sublist_get(args_sl, pi)), binds)
        }
        pi = pi + 1
    }
    binds
}

// The metavars minted for `call_node`'s return-only type params, as a full-arity
// group (-1 where nothing was minted), minting them on first visit and returning the
// SAME ones on every later visit. See tc_ret_mint_start's declaration for why the
// per-node memo is required rather than merely nice.
//
// Each returned tid is passed through tc_resolve, so a caller reads the SOLUTION once
// something has bound α rather than the raw α slot. That matters concretely:
// tc_struct_slot_encodable does not resolve, and would judge a bound α unencodable and
// silently drop the slot back to the erasing string path.
// Group layout in tc_ret_mint_tids: [arity, slot_0, …, slot_{arity-1}], so the group
// is SELF-DESCRIBING and a reader that disagrees about the fn's arity refuses instead
// of indexing into the next call's group. That is not hypothetical: this memo is
// written from the sig (fs.type_params_count) and read back by
// tc_mono_tids_core from the AST (sublist_length(node_type_params(fn_node))), and
// lookup_fnsig keys on a name — two fns of the same name with different arities would
// otherwise silently share a slot and mint one fn's α into the other's mono name.
fn tc_ret_only_metavars(sig: Int, call_node: Int) -> List[Int] {
    let fs = fnsig_pool.get(sig).unwrap()
    let n = fs.type_params_count
    let mut out: List[Int] = []
    if n == 0 { return out }
    if call_node < 0 || call_node >= tc_ret_mint_start.len() { return out }

    let existing = tc_ret_mint_start.get(call_node).unwrap()
    if existing >= 0 {
        let mut i = 0
        while i < n {
            out.push(tc_resolve(tc_ret_mint_at(call_node, n, i)))
            i = i + 1
        }
        return out
    }

    let start = tc_ret_mint_tids.len()
    tc_ret_mint_tids.push(n)
    let mut minted = 0
    let mut pi = 0
    while pi < n {
        let ro_idx = fs.type_params_start + pi
        let mut tid = -1
        if ro_idx < fnsig_tparam_ret_only.len() {
            if fnsig_tparam_ret_only.get(ro_idx).unwrap() != 0 {
                tid = make_metavar()
                minted = minted + 1
            }
        }
        tc_ret_mint_tids.push(tid)
        out.push(tid)
        pi = pi + 1
    }
    // Record the group only when it holds at least one α. Every non-return-only
    // generic call would otherwise burn an all -1 group per call node for nothing, and
    // leaving the start at -1 keeps that overwhelmingly common path a single list read.
    if minted == 0 {
        let mut trim = 0
        while trim <= n {
            let _ = tc_ret_mint_tids.pop()
            trim = trim + 1
        }
        return out
    }
    tc_ret_mint_start.set(call_node, start)
    out
}

// The metavar minted for slot `pi` of `call_node`'s return-only group, RESOLVED, or -1
// when this call minted nothing, minted nothing for that slot, or the caller's arity
// disagrees with the recorded group. The mono-lowering consumers read through here so
// each one is a single guarded lookup with no arithmetic of its own.
pub fn tc_ret_mint_at(call_node: Int, arity: Int, pi: Int) -> Int {
    if call_node < 0 || call_node >= tc_ret_mint_start.len() { return -1 }
    let start = tc_ret_mint_start.get(call_node).unwrap()
    if start < 0 || start >= tc_ret_mint_tids.len() { return -1 }
    if tc_ret_mint_tids.get(start).unwrap() != arity { return -1 }
    if pi < 0 || pi >= arity { return -1 }
    let slot = start + 1 + pi
    if slot >= tc_ret_mint_tids.len() { return -1 }
    let tid = tc_ret_mint_tids.get(slot).unwrap()
    if tid < 0 { return -1 }
    tc_resolve(tid)
}

// Did THIS node mint return-only metavars? The let-target pin is gated on it, so that
// caller reaches exactly the under-determination this ticket introduced and nothing else.
//
// Without the gate the pin also fires on an annotated let whose initializer is a struct
// LITERAL carrying field metavars — `let x: Box[Map[Float,Int]] = Box { value: Map() }`.
// That is a different mechanism with a different owner, and pinning it changes emitted C
// two ways at once: it fixes a latent br hnyqe4 kops miscompile (an Int-keyed Set hashed
// as a string) and it drives a Float key all the way to resolve_ctor_kops_elem, which has
// no vtable for one and emits a BLINK_COMPILER_BUG_ sentinel — an invalid C identifier.
// Both are real findings about the struct-literal path, both are filed, and neither is
// this ticket's to decide.
//
// The half of that which was a BLOCKER is now gone: the enforcement gap it named — a
// declared `Map[Float,_]` rejected by validate_map_key while the same type reached
// through a struct type-arg was not — is closed by tc_validate_type_arg_hashability, so
// the Float MVCE above no longer reaches codegen at all and the sentinel arm is
// unreachable from it. What remains is the kops half, which is a genuine question about
// the struct-literal path and still not this gate's to answer. Widening the gate is now
// a decision, not a wait.
fn tc_node_has_ret_mint(n: Int) -> Int {
    if n < 0 || n >= tc_ret_mint_start.len() { return 0 }
    if tc_ret_mint_start.get(n).unwrap() < 0 { return 0 }
    1
}

// A generic call's return type, with its type params substituted from the call's
// arguments — and, for a RETURN-ONLY type param, from a freshly minted metavariable
// (3dpshm).
//
// The mint is the whole point. build_typevar_binds infers exclusively from ARGUMENT
// types, so `fn mk[T]() -> RGT[T]` called as `mk()` gets empty binds,
// substitute_typevar_tid's TyKind.Typevar arm returns `T` unchanged, and the return type
// carries a BARE TYPEVAR. A bare typevar is invisible to every part of the metavar
// machinery — tc_is_unbound_metavar counts only TyKind.Unknown with inner1 < 0, and
// tc_unify's typevar arm returns 1 without binding — so typecheck passes clean, no
// E0301 fires, and codegen erases the slot to "Void" at the emit_struct_lit
// chokepoint (a loud I0001) or to a wrong mono name. Substituting α instead puts the
// slot into the ONE representation the existing constraint machinery can already
// solve: the let-target pin (tc_pin_tail_ret_generic), the argument-position unify
// (check_arg_value), and the declared-return compare (tc_check_returned_value) each
// bind α with no new inference code, and a genuinely unconstrained α is reported as
// E0301 at its binding boundary instead of reaching codegen.
//
// Minting HERE and not in build_typevar_binds: that function runs twice per call site
// (once for the return type, once for tc_pin_generic_args_from_binds), so it would
// produce two unrelated α for one slot and only one of them could ever be bound.
// substitute_typevar_tid stays byte-identical — inserting α into `binds` is the whole
// mechanism, which is what keeps every `-> Box[T]` whose T comes from an argument on
// exactly its current path.
fn instantiate_return_type(sig: Int, args_sl: Int, call_node: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let fs = fnsig_pool.get(sig).unwrap()
    let ret = fs.ret
    if ret < 0 || ret >= ty_pool.len() { return ret }
    let mut binds = build_typevar_binds(sig, args_sl)
    let mints = tc_ret_only_metavars(sig, call_node)
    let mut pi = 0
    while pi < mints.len() {
        let a = mints.get(pi).unwrap()
        if a >= 0 {
            let nidx = fs.type_params_start + pi
            if nidx < fnsig_type_param_names.len() {
                let tpn = fnsig_type_param_names.get(nidx).unwrap()
                // An argument bind wins: a param annotation naming the tparam means it
                // is not return-only and no α was minted for it, so this can only be a
                // belt-and-braces guard against a future producer inserting both.
                if binds.contains_key(tpn) == 0 {
                    binds.insert(tpn, a)
                }
            }
        }
        pi = pi + 1
    }
    substitute_typevar_tid(ret, binds)
}

// Pin a generic call's metavar-carrying arguments from the resolved typevar binds
// (gqg3rk). For `fill[K,V](m: Map[K,V], …)` called `fill(Map(), 256, "x")`, the
// binds recovered from the sibling args are K→Int, V→Str; substituting them into
// the param type `Map[K,V]` gives `Map[Int,Str]`, and unifying that against the
// `Map()` arg's `Map[α_k,α_v]` pins α_k=Int, α_v=Str — so codegen emits the right
// kops instead of the erased str default (the escape miscompile the reviewer
// found). If a typevar is genuinely unbound (no arg supplies it), substitution
// leaves it a typevar, unify leaves the arg's α unbound, and E0301 fires at the
// arg's own binding boundary. Runs only for metavar-carrying args — concrete args
// and the no-generic path are untouched.
fn tc_pin_generic_args_from_binds(sig: Int, args_sl: Int, self_offset: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if args_sl == -1 { return }
    let fs = fnsig_pool.get(sig).unwrap()
    let param_start = fs.params_start
    let param_count = fs.params_count
    let binds = build_typevar_binds(sig, args_sl)
    let n = sublist_length(args_sl)
    let mut i = 0
    while i < n {
        let pidx = i + self_offset
        if pidx < param_count {
            let arg_t = infer_type(sublist_get(args_sl, i))
            if tc_tid_has_unbound_metavar(arg_t) != 0 {
                let ptid = fnsig_param_list.get(param_start + pidx).unwrap()
                let concrete_ptid = substitute_typevar_tid(ptid, binds)
                let _ = tc_unify(concrete_ptid, arg_t)
            }
        }
        i = i + 1
    }
}

// A function's declared return type is an expected-type source
// (sections/03_types.md:1031), so a generic-struct/enum literal — or a Map/Set
// construction — in return position must monomorphize against it.
// `fn a() -> GKV[Int, Str] { GKV { m: Map() } }` got no such constraint:
// tc_struct_lit_instance_tid mints `GKV[?a, ?b]` from the `Map()` field's own
// unbound metavars, nobody unified it against the declared `GKV[Int, Str]`, and
// codegen reached the struct-lit mono chokepoint with two unsolved params — I0001
// (br y1n3ck). `fn mkmap() -> Map[Int, Str] { Map() }` has the identical shape one
// level up: the bare `Map()` ctor mints `Map[?a, ?b]` and nothing pins it either —
// but there is no struct-lit mono chokepoint to catch it, so it silently reaches
// codegen's CT_STRING kops default instead of an ICE (br farq9f).
//
// The pin is an IN-PLACE tc_unify, not a hint seed. That distinction is the whole
// fix: the metavar integers in the instance's arg list are the SAME integers the
// field's `Map[?a, ?b]` holds, so binding a:=Int solves the mono NAME and the
// ctor's kops vtable from one constraint. Seeding tc_construct_hint instead would
// fix only the name and leave resolve_ctor_kops_elem on its CT_STRING default —
// blink_kops_str for an Int key, trading a loud ICE for the silent br hnyqe4 hash
// collision.
//
// tc_pin_admits_declared is the gate; each branch is load-bearing:
//   TyKind.Map/TyKind.Set      — the only kind whose params_count is never set (br farq9f;
//                        make_map_type/make_set_type store inner1/inner2, not a
//                        ty_param_list), so it must admit unconditionally rather
//                        than fall into the params_count check below.
//   TyKind.Struct/TyKind.Enum  — excludes Option/Result/List/tuple/Handler returns, which
//                        is what keeps every existing tail-`None` / tail-`[]` /
//                        tail-tuple return byte-identical.
//   params_count > 0   — a monomorphic struct has nothing to pin.
// The caller additionally requires an unbound metavar in the inferred value, which
// excludes a bare TyKind.Typevar, so a generic fn's `-> Box[T]` keeps its existing
// per-T monomorphization untouched.
//
// The unify result is deliberately discarded: callers invoke this only where
// types_compatible ALREADY agreed, so there is no new mismatch to report, and a
// partial unify degrades to exactly today's I0001 rather than to a wrong type.
//
// FOUR callers, each a declared type meeting an under-determined value: the returned
// value of a fn (tc_check_returned_value, for both `return x` and an implicit tail),
// an annotated let's initializer (the LetBinding arm, br 3dpshm), a struct literal's
// declared FIELD type (tc_pin_struct_lit_field_ret_mints) and an assignment TARGET's
// type (the Assignment arm) — the last two br e2kjqy. Every caller gates on its own
// "did this value mint here" pre-check before calling; the two gates below are the
// shared ones. The name says
// "tail ret" for its first caller; it is really "pin a declared generic type onto a
// metavar-carrying value", and every gate above reads the same either way. Not
// renamed on purpose — a rename of a compiler-internal helper costs a 3-step
// bootstrap and buys nothing a comment cannot say.
fn tc_pin_admits_declared(d: Int) -> Int {
    if d < 0 || d >= ty_pool.len() { return 0 }
    let dt = ty_pool.get(d).unwrap()
    if dt.kind == TyKind.Map || dt.kind == TyKind.Set { return 1 }
    if dt.kind != TyKind.Struct && dt.kind != TyKind.Enum { return 0 }
    if dt.params_count == 0 { return 0 }
    1
}

fn tc_pin_tail_ret_generic(declared_ret: Int, inferred_ret: Int) {
    let d = resolve_alias_tid(declared_ret)
    if tc_pin_admits_declared(d) == 0 { return }
    if tc_tid_has_unbound_metavar(inferred_ret) == 0 { return }
    // Every pin mutates ty_pool IN PLACE, so adding a caller can change emitted C for
    // programs that have nothing to do with the new seam. `retpin` makes that blast
    // radius auditable without a printf+recompile: one line per pin that actually
    // fired, past both gates above (and, upstream, past whatever mint pre-check its
    // caller applied). Gated on dbg_channel_on so the interpolation is not built when
    // tracing is off.
    if dbg_channel_on("retpin") != 0 {
        dbg_trace("retpin", "pin declared={type_to_str(d)} inferred={type_to_str(inferred_ret)}")
    }
    let _ = tc_unify(d, inferred_ret)
}

// The declared-return check for one returned value, shared by NodeKind.Return and by
// the implicit tail of a fn body (br skdxkv). Two spellings of one program must give
// one answer, and the only way to guarantee that is one implementation.
//
// Every guard here is byte-identical to the Return arm's, deliberately:
//   • the tc_current_fn_ret Void/Unknown skip — a fn with no declared return has
//     nothing to compare against, and when tc_check_fn's `lookup_fnsig` misses it
//     never installs one at all, leaving tc_current_fn_ret at -1 (tc_check_fn is
//     called only from two non-reentrant top-level loops, so prev_fn_ret is always
//     -1 at entry). -1 stays vacuous through types_compatible's `a < 0` escape,
//     exactly as today. Do not "tighten" this with a >= 0 test: the Return arm has
//     always called through with -1 and must keep doing so. (The tail call site
//     does add >= 0, for an unrelated reason — see it.)
//     That miss is not hypothetical: EVERY impl method takes it, because the
//     register site keys the sig through tc_mangle_impl_fnsig while the check site
//     re-derives a different key. So neither this compare nor the pin has ever run
//     for a method — tracked as its own defect (br ya8qyf) with pinned rows in
//     tests/test_skdxkv_implicit_tail_ret_compare.bl. Fixing the key turns both on
//     for methods at once; expect new diagnostics, not none.
//   • the val_t Unknown skip — an unbound metavar defers to the E0301 region
//     boundary check rather than double-reporting as a mismatch here.
//   • the pin only in the compatible branch — types_compatible is permissive toward
//     an unbound metavar, so this IS the branch an under-determined tail takes, and
//     placing the pin here means it can never turn a reported mismatch into a silent
//     success.
//   • tc_in_closure_depth == 0 — since n8mmry, tc_current_fn_ret DOES name the
//     closure's own declared return inside a closure body (installed by
//     tc_check_closure_body_against_own_ret, never the enclosing fn's), so the
//     compare above is no longer misreporting there. The gate stays anyway:
//     tc_pin_tail_ret_generic MUTATES ty_pool in place, and its own comment warns
//     that adding a caller can change emitted C for unrelated programs. Nothing
//     forces widening it — an under-determined closure tail declines into a loud
//     stop, never a silent miscompile — and doing so would newly touch live rows
//     in tests/test_y1n3ck_generic_return_tail_infer.bl and
//     tests/test_e00ngd_fold_struct_accumulator.bl that no test asks for. Tracked
//     as its own follow-up (br srztkr) rather than folded into this fix.
fn tc_check_returned_value(val_t: Int, at_node: Int) ! TypeCheck.Report, Diag.Report {
    if tc_current_fn_ret == TYPE_VOID || tc_current_fn_ret == TYPE_UNKNOWN { return }
    if val_t == TYPE_UNKNOWN { return }
    if types_compatible(tc_current_fn_ret, val_t) == 0 {
        tc_error_at("return value type {type_to_str(val_t)} does not match function '{tc_current_fn_name}' return type {type_to_str(tc_current_fn_ret)}", at_node)
    } else {
        if tc_in_closure_depth == 0 {
            tc_pin_tail_ret_generic(tc_current_fn_ret, val_t)
        }
    }
}

// Parse an all-digits field name ("0", "12") to its Int index, or -1 for any
// non-numeric name (so struct field accesses never match the tuple path).
fn str_to_tuple_index(name: Str) -> Int {
    if name.len() == 0 { return -1 }
    let mut acc = 0
    let mut i = 0
    while i < name.len() {
        let ch = name.byte_at(i)
        if ch < 48 || ch > 57 { return -1 }
        acc = acc * 10 + (ch - 48)
        i = i + 1
    }
    acc
}

// br nrrs28 + sections/03b_contracts.md:424. A `Template[C]` parameter accepts an
// interpolated string LITERAL at the call site and nothing else. The compiler decomposes the
// literal into parts and values instead of concatenating it — codegen does exactly that at
// codegen_methods.bl:3148, keyed on this same node kind — while a pre-built `Str` VARIABLE is
// opaque and must be rejected (:465), because accepting it is how tainted data would be
// laundered past parameterization. Every string literal parses as InterpString whether or not
// it interpolates (parser.bl:3413), so this is one kind, not two.
//
// This is the same shape as is_int_literal_node below and it lives in the same place for the
// same reason: it is a coercion at an ARGUMENT POSITION granted to a literal, not a statement
// that `Str` and `Template[C]` are compatible types. types_compatible must keep answering 0
// for them, which is what makes the variable case an error.
fn tc_template_arg_ok(ptid: Int, arg_node: Int) -> Int {
    if type_kind(resolve_alias_tid(ptid)) != TyKind.Template { return 0 }
    if node_kind(arg_node) == NodeKind.InterpString { return 1 }
    0
}

// The laundering case, and the reason it is its own predicate rather than folded into the
// mismatch: `Str` -> `Template[C]` is the one rejection the spec writes out in full
// (sections/03b_contracts.md:470, E0310, with the hint naming the literal and Raw()), because
// it is the mistake the feature exists to catch. A Template-to-Template mismatch is an
// ordinary type error about the phantom context (br kfefsy) and keeps the generic wording.
fn tc_template_launders_str(ptid: Int, arg_t: Int) -> Int {
    if type_kind(resolve_alias_tid(ptid)) != TyKind.Template { return 0 }
    if type_kind(resolve_alias_tid(arg_t)) == TyKind.Str { return 1 }
    0
}

fn is_int_literal_node(node: Int) -> Int {
    if node_kind(node) == NodeKind.IntLit { return 1 }
    if node_kind(node) == NodeKind.UnaryOp && node_op(node) == "-" {
        let operand = node_left(node)
        if operand != -1 && node_kind(operand) == NodeKind.IntLit { return 1 }
    }
    0
}

// Validate call args against a fnsig's param types (type only, no arity).
// `self_offset` skips leading implicit params: 0 for free functions, 1 for
// methods whose fnsig carries `self` as param 0 (so explicit arg `i` aligns to
// fnsig param `i + self_offset`). Params typed TYPE_UNKNOWN are skipped.
// Genuinely saves/restores tc_construct_hint around infer_type; infer_type also
// writes cumulative inference state that is intended to persist, not roll back.
@allow(UnrestoredMutation)
fn check_arg_shapes(fn_name: Str, sig: Int, args_sl: Int, self_offset: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if args_sl == -1 { return }
    let fs = fnsig_pool.get(sig).unwrap()
    let param_start = fs.params_start
    let param_count = fs.params_count
    let n = sublist_length(args_sl)
    let mut i = 0
    while i < n {
        let pidx = i + self_offset
        if pidx < param_count {
            let ptid = fnsig_param_list.get(param_start + pidx).unwrap()
            if ptid != TYPE_UNKNOWN {
                let arg_node = sublist_get(args_sl, i)
                let saved_hint = tc_construct_hint
                tc_construct_hint = resolve_alias_tid(ptid)
                let arg_t = infer_type(arg_node)
                tc_construct_hint = saved_hint
                // Metavar path (gqg3rk): passing an as-yet-unpinned empty container
                // to a concretely-typed param is a constraining use — UNIFY so the
                // param type PINS the argument's α (`let xs = []; takes_ints(xs)`
                // infers List[Int]). tc_unify returns 0 on a hard mismatch (real
                // arg-type error). Only when a metavar is actually present, so the
                // fully-concrete path keeps its existing types_compatible semantics.
                if tc_tid_has_unbound_metavar(arg_t) != 0 {
                    if tc_unify(ptid, arg_t) == 0 {
                        tc_error_at("argument {i + 1} of '{fn_name}' expects {type_to_str(ptid)}, got {type_to_str(arg_t)}", arg_node)
                    }
                } else {
                    let mut lit_to_int = 0
                    if is_int_literal_node(arg_node) != 0 && is_integer_type(resolve_alias_tid(ptid)) != 0 {
                        lit_to_int = 1
                    }
                    // br nrrs28 — the template-literal coercion, on the same footing as the
                    // int-literal one above. See tc_template_arg_ok.
                    if tc_template_arg_ok(ptid, arg_node) != 0 {
                        lit_to_int = 1
                    } else if tc_template_launders_str(ptid, arg_t) != 0 {
                        // The laundering case gets the spec's OWN diagnostic
                        // (sections/03b_contracts.md:470) rather than the generic mismatch
                        // below: E0310 with the hint that names the two ways out. This is the
                        // error the whole feature exists to produce, and it used to come from
                        // codegen (codegen_methods.bl:3151) — which meant it only fired on the
                        // effect-op path and only after typecheck had let the program through.
                        // Reporting it here covers every call shape and stops at the phase that
                        // knows the param's type. Setting the flag suppresses the generic report,
                        // so one mistake stays one error.
                        diag_error_at("TemplateMismatch", TEMPLATE_MISMATCH, "expected {type_to_str(ptid)}, found {type_to_str(arg_t)} — string variables cannot be implicitly converted to Template", arg_node, "pass the string literal directly, or wrap values in Raw() for dynamic SQL")
                        lit_to_int = 1
                    }
                    if lit_to_int == 0 && types_compatible(arg_t, ptid) == 0 {
                        tc_error_at("argument {i + 1} of '{fn_name}' expects {type_to_str(ptid)}, got {type_to_str(arg_t)}", arg_node)
                    }
                }
            }
        }
        i = i + 1
    }
}

// Validate a single already-unwrapped argument value against an expected type,
// applying the construction hint + int-literal coercion escape, and emit the
// shared "argument N of 'LABEL' expects X, got Y" diagnostic on mismatch. Shared
// by check_builtin_arg and the qualified-variant-construction guard (8v0cpr).
// Genuinely saves/restores tc_construct_hint around infer_type; infer_type also
// writes cumulative inference state that is intended to persist, not roll back.
@allow(UnrestoredMutation)
fn check_arg_value(label: Str, arg_idx: Int, expected_t: Int, value_node: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if expected_t == TYPE_UNKNOWN { return }
    let saved_hint = tc_construct_hint
    tc_construct_hint = resolve_alias_tid(expected_t)
    let arg_t = infer_type(value_node)
    tc_construct_hint = saved_hint
    // Metavariable path (gqg3rk): when the expected type carries an unbound α
    // (e.g. `elem` of an as-yet-unpinned List/Set/Map — an unannotated `[]`),
    // UNIFY it with the argument type so the constraining use PINS α, instead of
    // discarding the constraint. tc_unify binds α in place and returns 1 on a
    // structural match, 0 on a hard mismatch (a real type error — a conflicting
    // second push, `xs.push(1); xs.push("a")`). Int-literals still coerce to a
    // pinned sized-int target. Runs only when a metavar is actually present so
    // the fully-concrete path stays on the existing types_compatible semantics.
    if tc_tid_has_unbound_metavar(expected_t) != 0 {
        let mut lit_ok = 0
        if is_int_literal_node(value_node) != 0 && is_integer_type(tc_resolve(expected_t)) != 0 {
            lit_ok = 1
        }
        if lit_ok == 0 && tc_unify(expected_t, arg_t) == 0 {
            tc_error_at("argument {arg_idx + 1} of '{label}' expects {type_to_str(expected_t)}, got {type_to_str(arg_t)}", value_node)
        }
        return
    }
    let mut lit_to_int = 0
    if is_int_literal_node(value_node) != 0 && is_integer_type(resolve_alias_tid(expected_t)) != 0 {
        lit_to_int = 1
    }
    if lit_to_int == 0 && types_compatible(arg_t, expected_t) == 0 {
        tc_error_at("argument {arg_idx + 1} of '{label}' expects {type_to_str(expected_t)}, got {type_to_str(arg_t)}", value_node)
    }
}

// Validate a single argument to a built-in intrinsic method (List/Set/Str/Map).
// These methods are pure codegen intrinsics with no fnsig backing, so we cannot
// reuse check_arg_shapes; we validate inline against the container's elem/key type.
// DEFERRED (need closure-signature checking): List.map/filter/find/fold/for_each/
// any/all and Bytes.with_ptr. Bytes integer-arg methods also deferred.
fn check_builtin_arg(method: Str, arg_idx: Int, expected_t: Int, args_sl: Int, container_label: Str) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if args_sl == -1 { return }
    if arg_idx >= sublist_length(args_sl) { return }
    check_arg_value("{container_label}.{method}", arg_idx, expected_t, sublist_get(args_sl, arg_idx))
}

// A signature typecheck holds for a namespace intrinsic — a method codegen emits directly
// rather than resolving to a Blink function. Registered into fnsig_pool under the qualified
// key `{namespace}.{method}`, which no user function can spell (register_fn_sig separates a
// module qualifier with a COLON), so the whole existing fnsig machinery applies: lookup_fnsig
// finds it, check_arg_shapes reports "argument 2 of 'net.listen' expects Int, got Str", and
// `.ret` is the return tid.
fn register_intrinsic_fn_sig(key: Str, params: List[Int], ret: Int) {
    let start = fnsig_param_list.len()
    let mut i = 0
    while i < params.len() {
        fnsig_param_list.push(params.get(i).unwrap())
        i = i + 1
    }
    fnsig_map.insert(key, fnsig_pool.len())
    fnsig_pool.push(FnSigEntry { name: key, ret: ret, params_start: start, params_count: params.len(), type_params_start: fnsig_type_param_names.len(), type_params_count: 0, effects_start: fnsig_effect_names.len(), effects_count: 0 })
}

// br qjfwc6. The signature of every namespace intrinsic typecheck is allowed to know.
//
// Codegen has always known all of them: each emitter at codegen_methods.bl:2651-3640 sets
// `expr_result_type` for its own method, and that is where the C types come from. Typecheck
// knew two — `time.read` and `time.sleep`, both spelled as inline arms — so every other
// intrinsic call fell out of the gate with no type at all. TYPE_UNKNOWN unifies with
// anything, so both halves failed open: the declared type was never compared and the
// arguments were never checked, and each escaped to the C compiler or to a silent
// miscompile (`let bad: Str = net.connect(host, port)` compiled AND RAN).
//
// This is a table, not one arm per method, because the arms are the disease: codegen already
// carries one per intrinsic and typecheck reading a table keeps the two from drifting apart
// method by method. The parameter tids are the reason the table has to exist at all — the
// return tid alone would leave `net.listen(4242, "localhost")` for cc.
//
// Deliberately absent, each because what its signature IS is an open question, not where it
// lives (see the ticket):
//   - `fs.read/write/list_dir/remove` — sections/04_effects.md:73,157 spells `fs.read(path)?`
//     as a Result and names the lister `fs.list`, while codegen emits a bare `const char*`
//     from `blink_read_file`. A spec answer has to come first.
//   - `net.request` — its `Result[Response, NetError]` needs two stdlib struct types that a
//     consuming module need not have imported.
//   - `io.println/print/print_raw/eprintln/eprint/eprint_raw/log` — Void statements with a
//     value-typed argument; no divergence to fix, and an arity or parameter claim here could
//     only be wrong. They are LISTED by is_intrinsic_method and unsigned here, which is a
//     deliberate and safe state: lookup_fnsig answers -1, the arm falls through, and being
//     listed keeps them off the bare-name path (br n84s1p).
//   - `io.debug` — listed by is_intrinsic_method, emitted by no arm, so it reaches the loud
//     E0505 codegen backstop. Signing it would claim a method that cannot be called works.
//   - `env.vars` — spelled in sections/04_effects.md:209 and typed Map[Str, Str] at :752, with
//     no codegen arm at all. Unimplemented, not mistyped; its own ticket.
//
// br n84s1p added io.read_bytes/write/write_bytes and the five env.* below. None is spelled in
// sections/04_effects.md — the IO table at :193 stops at the print family — but unlike fs.read
// there is no open question about what they ARE: the emitted C fixes each one completely
// (blink_stdin_read_bytes(int) -> blink_bytes*, blink_stdout_write(const char*) -> void). That
// is the same basis on which io.read_line was signed above, and it decides nothing the spec has
// left open. The spec gap is real but separate: these are unspec'd intrinsics, not new types.
fn register_ns_intrinsic_sigs() {
    let bytes_t = new_type(TyKind.Bytes, "Bytes")

    // net.* — fds are bare Int, per lib/std/net_tcp.bl which wraps them.
    register_intrinsic_fn_sig("net.connect", [TYPE_STR, TYPE_INT], TYPE_INT)
    register_intrinsic_fn_sig("net.listen", [TYPE_STR, TYPE_INT], TYPE_INT)
    register_intrinsic_fn_sig("net.accept", [TYPE_INT], TYPE_INT)
    register_intrinsic_fn_sig("net.read", [TYPE_INT, TYPE_INT], TYPE_STR)
    register_intrinsic_fn_sig("net.read_all", [TYPE_INT], TYPE_STR)
    register_intrinsic_fn_sig("net.read_line", [TYPE_INT], TYPE_STR)
    register_intrinsic_fn_sig("net.read_bytes", [TYPE_INT, TYPE_INT], bytes_t)
    register_intrinsic_fn_sig("net.write", [TYPE_INT, TYPE_STR], TYPE_VOID)
    register_intrinsic_fn_sig("net.write_bytes", [TYPE_INT, bytes_t], TYPE_INT)
    register_intrinsic_fn_sig("net.set_timeout", [TYPE_INT, TYPE_INT], TYPE_VOID)
    register_intrinsic_fn_sig("net.close", [TYPE_INT], TYPE_VOID)

    register_intrinsic_fn_sig("io.read_line", [], TYPE_STR)
    register_intrinsic_fn_sig("io.read_bytes", [TYPE_INT], bytes_t)
    register_intrinsic_fn_sig("io.write", [TYPE_STR], TYPE_VOID)
    register_intrinsic_fn_sig("io.write_bytes", [bytes_t], TYPE_VOID)

    register_intrinsic_fn_sig("term.isatty", [TYPE_INT], TYPE_INT)
    register_intrinsic_fn_sig("term.width", [], TYPE_INT)
    register_intrinsic_fn_sig("term.height", [], TYPE_INT)

    register_intrinsic_fn_sig("env.args", [], make_list_type(TYPE_STR))
    // env.var is the one intrinsic whose absence was a SILENT MISCOMPILE rather than a cc
    // escape: `let bad: Int = env.var("HOME")` compiled, linked, ran and printed `<value>`.
    // Option[Str] per sections/04_effects.md:705-716, where `env.var(...) ?? "8080"` and
    // `env.var("VERBOSE").is_some()` both appear.
    register_intrinsic_fn_sig("env.var", [TYPE_STR], make_option_type(TYPE_STR))
    register_intrinsic_fn_sig("env.cwd", [], TYPE_STR)
    register_intrinsic_fn_sig("env.set_var", [TYPE_STR, TYPE_STR], TYPE_VOID)
    register_intrinsic_fn_sig("env.remove_var", [TYPE_STR], TYPE_VOID)
    register_intrinsic_fn_sig("env.exit", [TYPE_INT], TYPE_VOID)

    // ffi.scope() — br ps5br9. The arena constructor, and the whole reason the scope object
    // now has a type: this table entry is what makes the `with ffi.scope() as scope` binder
    // typed, because tc_bind_with_resource binds the binder to the resource expression's tid
    // and that tid was TYPE_UNKNOWN. Nullary, so the entry also supplies the arity check
    // `ffi.scope(7)` never had. Codegen still rejects the form outside a `with` (E0819).
    register_intrinsic_fn_sig("ffi.scope", [], make_ffi_scope_type())
}

// Every variant of a str-backed enum carries a string value — `Open = "open"`. Mirrors the
// same test codegen makes when it decides to synthesize to_str/from_str
// (src/codegen_stmt.bl:8749-8765): ALL variants, not merely one, and at least one.
// Duplicated rather than shared because codegen imports typecheck, not the other way round.
fn tc_is_str_backed_enum_decl(td: Int) -> Int {
    let flds_sl = node_fields(td)
    if flds_sl == -1 { return 0 }
    let n = sublist_length(flds_sl)
    if n == 0 { return 0 }
    let mut i = 0
    while i < n {
        let v = sublist_get(flds_sl, i)
        if node_kind(v) != NodeKind.TypeVariant { return 0 }
        if node_str_val(v) == "" { return 0 }
        i = i + 1
    }
    1
}

// One synthesized-method signature, under the bare `{Type}_{method}` key both resolution
// paths already spell — the instance path at the struct/enum receiver arm, and the static
// path at the type-name receiver arm.
//
// Registered LAST, so anything a program says for itself wins: a key already taken by a user
// fn (register_fn_sig inserts the bare name as well as the module-qualified one) or by a
// trait impl (which keys `{Type}_{trait}_{method}` and is found through the method→traits
// index) is left alone. A type that both derives and hand-writes a same-named method is a
// duplicate-impl question, not this function's to answer.
fn register_derive_method_sig(tname: Str, method: Str, params: List[Int], ret: Int) {
    let key = "{tname}_{method}"
    if (fnsig_map.get(key) ?? -1) != -1 { return }
    if tc_method_trait_count(tname, method) >= 1 { return }
    register_intrinsic_fn_sig(key, params, ret)
}

// br nxnnxe. The signature of every method `@derive` synthesizes.
//
// tc_method_resolvable_on_type's clause (c) has always affirmed these NAMES — it reads the
// derive annotation straight off the type decl — and clause (c') fail-opened the str-backed
// enum statics. Nothing behind either clause carried a return type or parameter types, and a
// resolvability list with nothing behind it fails open twice over: TYPE_UNKNOWN unifies with
// anything, so the declared type was never compared AND the arguments were never checked.
// `let bad: Int = u.to_json()` compiled, linked and RAN. The fourth instance of this exact
// shape, after is_builtin_method and is_intrinsic_method (br qjfwc6).
//
// A table, not one arm per method, for qjfwc6's reason: codegen already carries one arm per
// derived method (codegen_methods.bl:5176 for structs, :5225 for enums) and typecheck reading
// a table is what keeps the two from drifting apart method by method. The two inline arms that
// predate it — 4q2etk's synthesized `display`, vfgp72's `eq`/`cmp` — are subsumed by these
// entries and answer identically; they stay for now.
//
// The types are the spec table (sections/03_types.md:2352) crossed with what codegen actually
// emits, and where those two disagree the emitted C wins, because registering anything else
// would reject programs that compile today:
//
//   * `to_json`/`from_json` are Str-typed. The spec spells `-> JsonValue` and
//     `(JsonValue) -> Result[Self, JsonError]`, but NEITHER type exists anywhere in src/ or
//     lib/ — codegen emits `const char* {T}_to_json` and
//     `blink_Result_{tag}_str {T}_from_json(const char*)` (codegen_derive.bl:159,169).
//     The divergence is br 169kjt; if it resolves toward JsonValue, this is the one place the
//     return types change.
//   * `hash` agrees with the spec. It was held out of this table until it could be called:
//     `@derive(Hash)` registered it and emitted `uint64_t {T}_hash` (codegen_derive.bl:199)
//     with no derive-dispatch arm consuming it, so `p.hash()` was a hard E0505 and a
//     signature would have claimed a method that does not work (br pvhaew). Both arms exist
//     now, so it is registered `(self) -> U64` — spec and emitted C say the same thing.
//
// `Ordering` comes from lib/std/traits.bl, so a program that never pulls it in has no tid for
// it; `cmp` is then left unregistered and falls to vfgp72's arm, which asks the same question.
fn register_derive_method_sigs(program: Int) {
    let types_sl = node_fields(program)
    if types_sl == -1 { return }
    let ordering_t = lookup_named_type("Ordering")
    let mut i = 0
    while i < sublist_length(types_sl) {
        let td = sublist_get(types_sl, i)
        let tname = node_name(td)
        let ttid = lookup_named_type(tname)
        if ttid != -1 {
            if type_has_derive(td, "Serialize") != 0 {
                register_derive_method_sig(tname, "to_json", [ttid], TYPE_STR)
            }
            if type_has_derive(td, "Deserialize") != 0 {
                register_derive_method_sig(tname, "from_json", [TYPE_STR], make_result_type(ttid, TYPE_STR))
            }
            if type_has_derive(td, "Clone") != 0 {
                register_derive_method_sig(tname, "clone", [ttid], ttid)
            }
            if type_has_derive(td, "Debug") != 0 {
                register_derive_method_sig(tname, "debug", [ttid], TYPE_STR)
            }
            // Ord: Eq (spec §3.6) — deriving Ord synthesizes eq as well as cmp.
            if type_has_derive(td, "Eq") != 0 || type_has_derive(td, "Ord") != 0 {
                register_derive_method_sig(tname, "eq", [ttid, ttid], TYPE_BOOL)
            }
            if type_has_derive(td, "Ord") != 0 && ordering_t != -1 {
                register_derive_method_sig(tname, "cmp", [ttid, ttid], ordering_t)
            }
            if type_has_derive(td, "Hash") != 0 {
                register_derive_method_sig(tname, "hash", [ttid], TYPE_U64)
            }
            if tc_is_str_backed_enum_decl(td) != 0 {
                register_derive_method_sig(tname, "to_str", [ttid], TYPE_STR)
                register_derive_method_sig(tname, "from_str", [TYPE_STR], make_option_type(ttid))
            }
        }
        i = i + 1
    }
}

// The closure argument at `idx`, or -1 if absent. The closure validators below
// tolerate -1 (they no-op on a non-Closure node), so call sites need no guard.
fn closure_arg_at(args_sl: Int, idx: Int) -> Int {
    if args_sl == -1 || idx >= sublist_length(args_sl) { return -1 }
    sublist_get(args_sl, idx)
}

// Validate one explicitly-annotated closure parameter against the type the HOF
// expects there (derived from the container element type). Unannotated params
// (TYPE_UNKNOWN) and unknown expected types are skipped — annotation validation
// only, no inference (that is gkr3fs Part B).
fn check_closure_param(closure_node: Int, param_idx: Int, expected_t: Int, method: Str, container_label: Str) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if expected_t == TYPE_UNKNOWN { return }
    if closure_node == -1 || node_kind(closure_node) != NodeKind.Closure { return }
    let params_sl = node_params(closure_node)
    if params_sl == -1 || param_idx >= sublist_length(params_sl) { return }
    let p = sublist_get(params_sl, param_idx)
    let ptid = resolve_param_type(p)
    if ptid == TYPE_UNKNOWN { return }
    if types_compatible(ptid, expected_t) == 0 {
        tc_error_at("closure parameter {param_idx + 1} of '{container_label}.{method}' expects {type_to_str(expected_t)}, got {type_to_str(ptid)}", p)
    }
}

// Validate an explicitly-annotated closure return type against the type the HOF
// requires (e.g. Bool for filter/any/all). Skipped when the closure has no
// declared return or the expected type is unknown.
fn check_closure_ret(closure_node: Int, expected_ret: Int, method: Str, container_label: Str) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if expected_ret == TYPE_UNKNOWN { return }
    if closure_node == -1 || node_kind(closure_node) != NodeKind.Closure { return }
    let ret_str = node_return_type(closure_node)
    if ret_str == "" { return }
    let rt = resolve_type_name(ret_str)
    if rt == -1 { return }
    if types_compatible(rt, expected_ret) == 0 {
        tc_error_at("closure of '{container_label}.{method}' must return {type_to_str(expected_ret)}, got {type_to_str(rt)}", closure_node)
    }
}

// A closure's OWN written return annotation, resolved to a tid. Mirrors
// register_fn_sig's ret-resolution (:3132-3156): resolve_type_ann, then
// re-intern a generic user-struct/enum return as a structural instance carrying
// its type-arg slots via tc_fnsig_param_instance_tid, so the codegen mono seams
// read the instance tid instead of the erased bare base. TYPE_VOID when
// unannotated, matching register_fn_sig's no-`-> T` default (Principle 2: a
// closure and a named fn share one obligation). No node_return_type string
// fallback needed: parser.bl's sole Closure producer sets return_type/type_ann
// from the same node, so ret_ann == -1 iff ret_str == "".
fn tc_closure_declared_ret(cls: Int) -> Int ! TypeCheck.Resolve, Diag.Report {
    let ret_ann = node_type_ann(cls)
    if ret_ann == -1 { return TYPE_VOID }
    let mut ret_tid = resolve_type_ann(ret_ann)
    let ret_inst = tc_fnsig_param_instance_tid(ret_ann, ret_tid)
    if ret_inst != -1 { ret_tid = ret_inst }
    ret_tid
}

// List HOFs whose closure takes a single element-typed param. `fold` is handled
// separately (its closure takes accumulator + element).
fn is_elem_closure_hof(method: Str) -> Int {
    method == "map" || method == "filter" || method == "for_each" || method == "any" || method == "all" || method == "find"
}

// The single install point for a closure's own fn-identity: installs
// tc_current_fn_name/tc_current_fn_ret to the closure's OWN declared return
// (never the enclosing fn's, which is what every other read of these globals
// gets for free once this runs), walks the body once, and checks the implicit
// tail against that same declared return. Mirrors emit_closure's codegen
// treatment of a closure as its own fn context (src/codegen_closures.bl:868-874,
// 1028-1043, 1046-1052) — codegen already does this; typecheck never did, which
// is the root of all seven n8mmry symptoms. Shared by the two positions a
// closure body is walked from (tc_check_body's Closure arm and
// check_closure_body's HOF path below), so the tc_in_closure_depth bump and the
// tc_fn_body_block one-shot marker live here exactly once instead of duplicated
// at both call sites.
// tc_current_fn_name/tc_current_fn_ret are genuinely saved and restored here;
// the tc_check_body call mutates plenty of other global state (tc_errors,
// ty_pool, ...) that this function does not save/restore around that one call,
// which the analyzer correctly flags (mirrors tc_check_fn:9052).
@allow(UnrestoredMutation, IncompleteStateRestore)
fn tc_check_closure_body_against_own_ret(cls: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let prev_fn_name = tc_current_fn_name
    let prev_fn_ret = tc_current_fn_ret
    tc_current_fn_name = "closure"
    tc_current_fn_ret = tc_closure_declared_ret(cls)
    let body = node_body(cls)
    if node_kind(body) == NodeKind.Block { tc_fn_body_block = 1 }
    // Spec §3c.2: a closure body does not inherit the surrounding test-body
    // elaboration. `?` inside the closure must be gated against the closure's
    // own return type, not the test block's implicit Result[Void, TestError]
    // (mirrors nr_check_node's Closure arm, which resets this for the same reason).
    let saved_in_test = tc_in_test_body
    tc_in_test_body = 0
    tc_in_closure_depth = tc_in_closure_depth + 1
    tc_check_body(body)
    tc_in_closure_depth = tc_in_closure_depth - 1
    tc_in_test_body = saved_in_test
    tc_check_missing_tail_value(body, tc_current_fn_ret, "closure", cls)
    tc_current_fn_name = prev_fn_name
    tc_current_fn_ret = prev_fn_ret
}

// gkr3fs Part B — type-check the BODY of a closure with params bound to the types
// the HOF supplies (`p0_t`/`p1_t`, -1 = absent). Unannotated params would otherwise
// bind to TYPE_UNKNOWN, so a wrong body (e.g. `Str` param used as `Int`) leaks past
// typecheck to the C compiler. When a param IS explicitly annotated we bind the
// declared type instead — this preserves Part A's annotation validation and never
// contradicts it. The body walk itself — including installing the closure's own
// declared return and the tc_in_closure_depth bump — is shared with tc_check_body's
// Closure arm via tc_check_closure_body_against_own_ret (br n8mmry): this is the
// second of the two entry points into a closure body (the HOF path).
fn check_closure_body(cls: Int, p0_t: Int, p1_t: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if cls == -1 || node_kind(cls) != NodeKind.Closure { return }
    nr_push_scope()
    let params_sl = node_params(cls)
    if params_sl != -1 {
        let nparams = sublist_length(params_sl)
        if nparams >= 1 {
            let p0 = sublist_get(params_sl, 0)
            let decl0 = resolve_param_type(p0)
            let bind0 = if decl0 != TYPE_UNKNOWN { decl0 } else { p0_t }
            nr_define_typed(node_name(p0), 0, bind0)
        }
        if nparams >= 2 {
            let p1 = sublist_get(params_sl, 1)
            let decl1 = resolve_param_type(p1)
            let bind1 = if decl1 != TYPE_UNKNOWN { decl1 } else { p1_t }
            nr_define_typed(node_name(p1), 0, bind1)
        }
    }
    tc_check_closure_body_against_own_ret(cls)
    nr_pop_scope()
}

// br pgc3d9 — the third entry point into a body that is its own fn context. A handler method
// is an ordinary parse_fn_def() FnDef node (src/parser.bl:2116) that lives in a HandlerExpr's
// `methods` sublist rather than the program's, so check_types' top-level tc_check_fn walk never
// reaches it and lookup_fnsig has no entry under its bare name. Nothing else about it is
// special: it has params to bind and its own declared return to check the body and the implicit
// tail against. Mirrors tc_check_fn with the fnsig lookup replaced by the node's own
// annotation, so `handler MyEff { fn doit() -> Int { let bad: Int = "not an int"; 2 } }` reports
// the same error the identical named fn would.
//
// tc_closure_declared_ret reads only node_type_ann, which parse_fn_def sets from the same
// parse_type_annotation() the sole Closure producer uses, so it resolves a handler method's
// return with no closure-specific behavior — including the generic-instance re-intern a
// hand-rolled resolve_type_ann here would drop.
//
// tc_current_fn_name/tc_current_fn_ret are genuinely saved and restored; the tc_check_body call
// mutates plenty of other global state (tc_errors, ty_pool, nr_* scope) that this does not save
// around it, which the analyzer correctly flags (mirrors tc_check_fn and
// tc_check_closure_body_against_own_ret).
@allow(UnrestoredMutation, IncompleteStateRestore)
fn tc_check_handler_method(m: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if m == -1 || node_kind(m) != NodeKind.FnDef { return }
    let body = node_body(m)
    if body == -1 { return }
    let mname = node_name(m)
    let prev_fn_name = tc_current_fn_name
    let prev_fn_ret = tc_current_fn_ret
    tc_current_fn_name = mname
    tc_current_fn_ret = tc_closure_declared_ret(m)

    nr_push_scope()
    let params_sl = node_params(m)
    if params_sl != -1 {
        let mut i = 0
        while i < sublist_length(params_sl) {
            let p = sublist_get(params_sl, i)
            nr_define_typed(node_name(p), 0, resolve_param_type(p))
            i = i + 1
        }
    }
    if node_kind(body) == NodeKind.Block { tc_fn_body_block = 1 }
    // Same reason as the closure walker: a handler method body is its own fn context, so `?`
    // inside it gates against this method's return type and not an enclosing test block's
    // implicit Result[Void, TestError] (spec §3c.2).
    let saved_in_test = tc_in_test_body
    tc_in_test_body = 0
    tc_check_body(body)
    tc_in_test_body = saved_in_test
    tc_check_missing_tail_value(body, tc_current_fn_ret, mname, m)
    nr_pop_scope()

    tc_current_fn_name = prev_fn_name
    tc_current_fn_ret = prev_fn_ret
}

// br pgc3d9 — walk the BODY of every Closure / HandlerExpr argument at a call site. Before this,
// tc_check_body had no way in: infer_type validates a closure argument's declared annotation
// against the param type (Part A, check_closure_ret) but never visits its statements, so
// `take(fn() { let bad: Int = "not an int" })` typechecked clean and RAN, printing a Str out of
// an Int-declared variable. A closure bound to a `let` was always checked, so position alone
// decided whether code was checked — the same shape of hole as br e0wmt6.
//
// `skip_idx` is the argument the caller already walked itself. The List-HOF path in the
// MethodCall arm binds arg 0 (arg 1 for `fold`) to the element/accumulator type via
// check_closure_body, which is strictly better than what this function can do for an
// unannotated param, and walking it a second time would report every diagnostic inside every
// `.map`/`.filter`/`.fold` closure in the corpus twice. -1 means nothing to skip.
//
// A NamedArg wraps its value, so descend through it rather than treating a labelled closure
// argument as a non-closure.
fn tc_check_callable_arg_bodies(args_sl: Int, skip_idx: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if args_sl == -1 { return }
    let mut i = 0
    while i < sublist_length(args_sl) {
        if i != skip_idx {
            let mut a = sublist_get(args_sl, i)
            if a != -1 && node_kind(a) == NodeKind.NamedArg { a = node_value(a) }
            if a != -1 {
                let ak = node_kind(a)
                if ak == NodeKind.Closure || ak == NodeKind.HandlerExpr { tc_check_body(a) }
            }
        }
        i = i + 1
    }
}

// Arity- and per-argument-check a call against a structured TyKind.Fn tid, and answer its
// return type. Shared by the two callable-callee shapes, which need identical treatment and
// differ only in how the diagnostic names the callee:
//
//   * a closure VARIABLE — `let g = ..` then `g(1)` — whose Fn tid comes from local scope
//     (label "function 'g'", the wording nz7drz/3vfae9 established);
//   * an immediately-invoked closure LITERAL — `fn(x: Int) -> Int { .. }(1)` — whose Fn tid
//     comes from inferring the callee node (label "closure", br x3x0qj).
//
// `got` drives the argument loop, not `expected`, so a wrong arity still type-checks every
// argument it was given instead of stopping at the first report.
fn tc_check_call_against_fn_tid(fn_tid: Int, args_sl: Int, label: Str, node: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let fn_ty = ty_pool.get(fn_tid).unwrap()
    let expected = fn_ty.params_count
    let got = if args_sl != -1 { sublist_length(args_sl) } else { 0 }
    if got != expected {
        tc_error_at("{label} expects {expected} argument(s), got {got}", node)
    }
    let pstart = fn_ty.params_start
    let mut li = 0
    while li < got {
        let arg_tid = infer_type(sublist_get(args_sl, li))
        if li < expected {
            let ptid = ty_param_list.get(pstart + li).unwrap()
            if arg_tid != TYPE_UNKNOWN && ptid != TYPE_UNKNOWN && types_compatible(ptid, arg_tid) == 0 {
                tc_error_at("{label} argument {li} expects {type_to_str(ptid)}, got {type_to_str(arg_tid)}", node)
            }
        }
        li = li + 1
    }
    fn_ty.inner1
}

// ── Error reporting ─────────────────────────────────────────────────

fn tc_error(msg: Str) ! TypeCheck.Report, Diag.Report {
    tc_errors.push(msg)
    diag_error_no_loc("TypeError", TYPE_ERROR, msg, "")
}

fn tc_error_at(msg: Str, node_id: Int) ! TypeCheck.Report, Diag.Report {
    tc_errors.push(msg)
    diag_error_at("TypeError", TYPE_ERROR, msg, node_id, "")
}


// ── Incremental filter API ──────────────────────────────────────────

pub fn tc_set_incremental_filter(names: List[Str]) {
    tc_inc_filter = Map()
    let mut i = 0
    while i < names.len() {
        tc_inc_filter.insert(names.get(i).unwrap(), 1)
        i = i + 1
    }
    tc_inc_enabled = 1
}

pub fn tc_clear_incremental_filter() {
    tc_inc_filter = Map()
    tc_inc_enabled = 0
}

fn tc_should_check_fn(name: Str) -> Int {
    if tc_inc_enabled == 0 {
        return 1
    }
    tc_inc_filter.contains_key(name)
}

// ── Type annotation resolution ──────────────────────────────────────

// Memoize a compound-carrier tid (Option/Result/Tuple) onto its annotation node
// when it carries a generic-struct INSTANCE leaf, so the codegen pre-fn /
// let-binding pass can recurse the carrier's inners back through
// register_struct_instance_from_tid and register blink_RBox_Int ahead of the
// carrier typedef that names it by value (br f9mqbq / 637sy9). Like
// tc_produce_struct_instance_tid, this writes a slot that is otherwise -1 for
// annotation nodes (they never reach infer_type), and only the new codegen reader
// consumes it — so the pass stays byte-identical. Gated on an instance leaf so a
// scalar carrier (Result[Int,Str], (Int,Str)) leaves its slot -1.
fn tc_memo_carrier_over_instance(ann_node: Int, carrier_tid: Int) {
    if ann_node < 0 || ann_node >= tc_node_tid.len() { return }
    if tc_carrier_has_instance_leaf(carrier_tid) == 0 { return }
    tc_node_tid.set(ann_node, carrier_tid)
}

// True when an Option/Result/Tuple carrier tid has (possibly nested) a struct/enum
// INSTANCE leaf (params_count >= 1). A bare struct leaf (Box, no args) or scalar
// returns 0 — those never need pre-registration.
fn tc_carrier_has_instance_leaf(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return 0 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind == TyKind.Option { return tc_leaf_is_instance_or_carrier(t.inner1) }
    if t.kind == TyKind.Result {
        if tc_leaf_is_instance_or_carrier(t.inner1) != 0 { return 1 }
        return tc_leaf_is_instance_or_carrier(t.inner2)
    }
    if t.kind == TyKind.Tuple {
        let mut i = 0
        while i < t.params_count {
            let et = ty_param_list.get(t.params_start + i).unwrap()
            if tc_leaf_is_instance_or_carrier(et) != 0 { return 1 }
            i = i + 1
        }
    }
    0
}

fn tc_leaf_is_instance_or_carrier(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return 0 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind == TyKind.Struct && t.params_count >= 1 { return 1 }
    if t.kind == TyKind.Option || t.kind == TyKind.Result || t.kind == TyKind.Tuple { return tc_carrier_has_instance_leaf(tid) }
    0
}

fn resolve_type_ann(ann_node: Int) -> Int ! TypeCheck.Resolve, Diag.Report {
    if ann_node == -1 {
        return TYPE_UNKNOWN
    }
    resolve_type_parts(node_name(ann_node), node_elements(ann_node), ann_node)
}

// resolve_type_ann's whole body, reached by its (name, type-args) PARTS instead of by an
// annotation node — because one caller has the parts and no node. An impl header
// (`impl[T] Firstish[T] for List[T]`) stores its receiver as `name` plus a `recv_type_args`
// sublist of annotation nodes (parser.bl:2088-2091); that pair is exactly the shape this
// function already destructures out of an annotation node, so `self` gets its type from the
// same implementation every other type position uses, rather than a second dispatch that
// would drift (br jzvxav).
//
// `ann_node` is the node to memoize onto and may be -1 when the caller has no node. Every
// use of it below is either already -1-guarded (tc_memo_carrier_over_instance:2337) or
// guarded here; nothing may pass -1 to a node accessor, which node_or_die crashes on.
fn resolve_type_parts(name: Str, elems_sl: Int, ann_node: Int) -> Int ! TypeCheck.Resolve, Diag.Report {
    if name == "List" {
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            let inner = resolve_type_ann(sublist_get(elems_sl, 0))
            return make_list_type(inner)
        }
        return make_list_type(TYPE_UNKNOWN)
    }
    if name == "Option" {
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            let inner = resolve_type_ann(sublist_get(elems_sl, 0))
            let opt = make_option_type(inner)
            tc_memo_carrier_over_instance(ann_node, opt)
            return opt
        }
        return make_option_type(TYPE_UNKNOWN)
    }
    if name == "Result" {
        if elems_sl != -1 && sublist_length(elems_sl) >= 2 {
            let ok_t = resolve_type_ann(sublist_get(elems_sl, 0))
            let err_t = resolve_type_ann(sublist_get(elems_sl, 1))
            let res = make_result_type(ok_t, err_t)
            tc_memo_carrier_over_instance(ann_node, res)
            return res
        }
        return make_result_type(TYPE_UNKNOWN, TYPE_UNKNOWN)
    }
    if name == "Map" {
        if elems_sl != -1 && sublist_length(elems_sl) >= 2 {
            let key_ann = sublist_get(elems_sl, 0)
            let key_t = resolve_type_ann(key_ann)
            let val_t = resolve_type_ann(sublist_get(elems_sl, 1))
            if tc_suppress_ann_validation == 0 { validate_map_key(key_ann) }
            return make_map_type(key_t, val_t)
        }
        return make_map_type(TYPE_UNKNOWN, TYPE_UNKNOWN)
    }
    if name == "Set" {
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            let elem_ann = sublist_get(elems_sl, 0)
            let elem_t = resolve_type_ann(elem_ann)
            if tc_suppress_ann_validation == 0 { validate_set_elem(elem_ann) }
            return make_set_type(elem_t)
        }
        return make_set_type(TYPE_UNKNOWN)
    }
    if name == "Tuple" {
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            let mut elem_types: List[Int] = []
            let mut i = 0
            while i < sublist_length(elems_sl) {
                elem_types.push(resolve_type_ann(sublist_get(elems_sl, i)))
                i = i + 1
            }
            let tup = make_tuple_type(elem_types)
            tc_memo_carrier_over_instance(ann_node, tup)
            return tup
        }
    }
    if name == "Bytes" {
        return new_type(TyKind.Bytes, "Bytes")
    }
    // The three one-inner runtime carriers (br vag3wc). Ahead of resolve_type_name for the
    // same reason List/Map/Set are: is_primitive_type already claims these names, so a user
    // type could not have taken them, and falling through to `make_typevar(name)` is what made
    // an ANNOTATED channel un-iterable — tc_check_body's deferred-iterable test asks
    // `iter_tk == TyKind.Channel`, which a typevar is not, so `let ch: Channel[Int] = Channel(4)`
    // followed by `for v in ch` drew E0302 while the unannotated program compiled.
    if name == "Handle" {
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            return make_handle_type(resolve_type_ann(sublist_get(elems_sl, 0)))
        }
        return make_handle_type(TYPE_UNKNOWN)
    }
    if name == "Channel" {
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            return make_channel_type(resolve_type_ann(sublist_get(elems_sl, 0)))
        }
        return make_channel_type(TYPE_UNKNOWN)
    }
    // br w13xgb, and the fourth carrier for the same reason. `Ptr` is claimed by
    // is_primitive_type (:6486) so no user type could have taken the name, and falling through
    // to make_typevar("Ptr") is what let `let r: Ptr[Int] = buf` (buf: Ptr[Pollfd]) reach the C
    // compiler as `int64_t* r = buf` — a cc error with no Blink span.
    //
    // The pointee recurses through resolve_type_ann rather than being read as a name, so
    // `Ptr[Ptr[Void]]` nests properly. Nothing here re-validates the pointee: the legal set is
    // enforced separately and syntactically by check_ptr_in_type_ann / is_valid_ptr_inner
    // (:3734), which walks the annotation tree on its own and must keep doing so — it is the
    // only thing that sees a `Ptr` in a position that never reaches this function.
    if name == "Ptr" {
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            return make_ptr_type(resolve_type_ann(sublist_get(elems_sl, 0)))
        }
        return make_ptr_type(TYPE_UNKNOWN)
    }
    // br nrrs28, the fifth carrier and the same reason again — see make_template_type. The
    // phantom recurses through resolve_type_ann like every other carrier's child, so a
    // context that IS a real type resolves to it; the spec's own contexts are effect names,
    // which are not types, so those land on a typevar named for the effect. Either way the
    // context is kept rather than discarded with the whole type.
    if name == "Template" {
        if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            return make_template_type(resolve_type_ann(sublist_get(elems_sl, 0)))
        }
        return make_template_type(TYPE_UNKNOWN)
    }
    // `fn(A, B) -> R` (br nz7drz). Placed here for the same reason as the three carriers
    // above: "Fn" is a reserved type name (is_primitive_type claims it), so no user type
    // could have taken it, and falling through to `make_typevar("Fn")` is what made an
    // ANNOTATED closure both structureless and unsound — a bare typevar unifies with
    // anything, so `let bad: fn(Int) -> Int = 5` typechecked clean.
    //
    // parser.bl:1447 puts the param annotations in `elements` and the return annotation in
    // `type_ann`, leaving type_ann == -1 (with return_type "Void") when the arrow is absent.
    // TYPE_VOID for that case, not TYPE_UNKNOWN: it matches tc_closure_declared_ret and the
    // named-fn default, and Void is an ordinary inhabited type, not an unsolved one
    // (decisions/under-determined-types.md).
    if name == "Fn" {
        let ret_ann = if ann_node == -1 { -1 } else { node_type_ann(ann_node) }
        let ret_t = if ret_ann == -1 { TYPE_VOID } else { resolve_type_ann(ret_ann) }
        let mut param_types: List[Int] = []
        if elems_sl != -1 {
            let mut i = 0
            while i < sublist_length(elems_sl) {
                param_types.push(resolve_type_ann(sublist_get(elems_sl, i)))
                i = i + 1
            }
        }
        return make_fn_type(ret_t, param_types)
    }

    let resolved = resolve_type_name(name)
    if resolved != -1 {
        // A user struct named with concrete type-args (`Box[Int]`) resolves to the
        // structured instance tid on the LIVE path (br qw7v90, increment B): the
        // annotation side must carry the specialization so a concrete param/let
        // type (Box[Int]) compares by name+params against a reverse-inferred
        // literal (Box[Str]) — the two must be able to mismatch. Consumers that map
        // a struct tid back to its declaration (fields, derives) normalize
        // instance→base by name, so the fresh instance entry is safe. The instance
        // is still memoized onto the annotation node's tc_node_tid slot for the
        // tc_tid_struct_arg_* accessors. Falls back to the bare tid when no concrete
        // arg is present (all-typevar `Box[T]`).
        // The struct/enum branches are the only ones that never visited their own args on the
        // live path, so a Map key or Set element reached through one escaped validation
        // entirely (br f8t5wb). Gated on the same flag as the Map/Set branches above so the
        // off-path re-resolution below still cannot double-report.
        if tc_suppress_ann_validation == 0 && (type_kind(resolved) == TyKind.Struct || type_kind(resolved) == TyKind.Enum) {
            tc_validate_type_arg_hashability(elems_sl)
        }
        if type_kind(resolved) == TyKind.Struct && elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            let inst = tc_produce_struct_instance_tid(ann_node, name, elems_sl)
            if inst != -1 { return inst }
        }
        // A generic-enum instance annotation (`t: Tree[Int]`) likewise memoizes its
        // structured instance tid onto the annotation node so codegen's param_c_type
        // can lower it to the mono carrier (blink_Tree_Int), not the erased bare enum
        // (jjhnf3). Same all-typevar skip as the struct producer.
        if type_kind(resolved) == TyKind.Enum && elems_sl != -1 && sublist_length(elems_sl) >= 1 {
            let inst = tc_produce_enum_instance_tid(ann_node, name, elems_sl)
            if inst != -1 { return inst }
        }
        return resolved
    }

    make_typevar(name)
}

// The receiver type of an impl block, as a tid — i.e. what `self` is (br jzvxav).
//
// `self` is the one parameter in the language that carries no type annotation, so
// resolve_param_type (:9786) answers TYPE_UNKNOWN for it and tc_check_fn binds it that way in
// EVERY impl method body. TYPE_UNKNOWN unifies with anything, so that made both the declared-type
// compare AND the argument check vacuous for every `self.method(...)` call in every Blink
// program: `self.get(42)` against `fn get(self, k: Str)` passed typecheck and landed as a C
// compiler error with no Blink span. The impl node has had the answer all along — tc_infer_program
// reads `node_name(im)` for the qualified method name three lines before checking the body.
//
// Structural, not the erased base: a poly impl's receiver (`for List[T]`, `for Box[T]`) must carry
// its type-arg slots, exactly as tc_fnsig_param_instance_tid does for an annotated generic param,
// or substitute_typevar_tid has nothing to rewrite at the call site. Going through
// resolve_type_parts gets that for free and keeps one implementation of "name + args is a type".
//
// Validation is suppressed over the arg resolution: these annotation nodes are resolved again
// here, and the Map/Set branches emit non-deduped E1400 hashability diagnostics that
// check_impl_type_arg_names (:4643) has already reported against the same header.
@allow(UnrestoredMutation)
pub fn tc_impl_self_tid(im: Int) -> Int ! TypeCheck.Resolve, Diag.Report {
    if im == -1 { return TYPE_UNKNOWN }
    let name = node_name(im)
    // A trait's own default-method bodies have no receiver type to speak of, and the parser
    // leaves `name` empty for a header with no `for` clause.
    if name == "" { return TYPE_UNKNOWN }
    let saved_suppress = tc_suppress_ann_validation
    tc_suppress_ann_validation = 1
    let t = resolve_type_parts(name, node_recv_type_args(im), -1)
    tc_suppress_ann_validation = saved_suppress
    t
}

// OFF-PATH monomorphized-struct-instance producer (br kvn6w8 spike). Called only
// when resolve_type_ann sees a user struct named with concrete type-args
// (`Box[Int]`). resolve_type_ann's live return stays the bare generic tid; this
// builds the structured instance tid and memoizes it onto the annotation node's
// tc_node_tid slot for the tc_tid_struct_arg_* accessors to read. Byte-identical:
// annotation nodes never reach infer_type, so this slot is otherwise -1, and no
// emit/typecheck reader consumes an annotation-node tid (the mono CSV path reads
// ARG-EXPRESSION node tids only). Skipped when every arg is a typevar (a generic
// `Box[T]`): inference variables must not be interned
// (compiler-type-representation.md:47), and an all-typevar instance carries no
// more information than the bare tid.
//
// tc_suppress_ann_validation is raised over the arg re-resolution: this recursion
// is net-new work the live struct path never did, and resolve_type_ann's Map/Set
// branches emit non-deduped E1400 hashability diagnostics — suppressing them keeps
// the pass byte-identical while leaving tid-building intact. Kept in its own fn
// (not inlined into resolve_type_ann) so the save/restore idiom does not make the
// effect analyzer flag resolve_type_ann's other unguarded mutating calls.
fn tc_produce_struct_instance_tid(ann_node: Int, name: Str, elems_sl: Int) -> Int ! TypeCheck.Resolve, Diag.Report {
    let saved_suppress = tc_suppress_ann_validation
    tc_suppress_ann_validation = 1
    let saved_nested = tc_structural_nested_instances
    tc_structural_nested_instances = 1
    let mut arg_tids: List[Int] = []
    let mut has_concrete = 0
    let mut ai = 0
    while ai < sublist_length(elems_sl) {
        let arg_t = resolve_type_ann(sublist_get(elems_sl, ai))
        if type_kind(arg_t) != TyKind.Typevar { has_concrete = 1 }
        arg_tids.push(arg_t)
        ai = ai + 1
    }
    tc_suppress_ann_validation = saved_suppress
    tc_structural_nested_instances = saved_nested
    if has_concrete != 0 || saved_nested != 0 {
        let inst = make_struct_instance_type(name, arg_tids)
        if ann_node >= 0 && ann_node < tc_node_tid.len() {
            tc_node_tid.set(ann_node, inst)
        }
        return inst
    }
    -1
}

// The enum analogue of tc_produce_struct_instance_tid (jjhnf3): mint+memoize a
// generic-enum instance tid (`Tree[Int]`) onto the annotation node so codegen's
// param_c_type reads the full mono stem. Same all-typevar skip and suppression.
@allow(UnrestoredMutation)
fn tc_produce_enum_instance_tid(ann_node: Int, name: Str, elems_sl: Int) -> Int ! TypeCheck.Resolve, Diag.Report {
    let saved_suppress = tc_suppress_ann_validation
    tc_suppress_ann_validation = 1
    let mut arg_tids: List[Int] = []
    let mut has_concrete = 0
    let mut ai = 0
    while ai < sublist_length(elems_sl) {
        let arg_t = resolve_type_ann(sublist_get(elems_sl, ai))
        if type_kind(arg_t) != TyKind.Typevar { has_concrete = 1 }
        arg_tids.push(arg_t)
        ai = ai + 1
    }
    tc_suppress_ann_validation = saved_suppress
    if has_concrete != 0 {
        let inst = make_enum_instance_type(name, arg_tids)
        if ann_node >= 0 && ann_node < tc_node_tid.len() {
            tc_node_tid.set(ann_node, inst)
        }
        return inst
    }
    -1
}

// A generic FN PARAM annotation (`b: Box[T]`) must intern as a STRUCTURAL instance
// tid carrying its type-arg slots — even when every slot is a typevar — so
// unify_typevar_binds' TyKind.Struct arm (which walks param/arg slots in lockstep) can
// discover T from a `Box[Box[Int]]` argument (br 8wyq1k). This is the deliberate
// EXCEPTION to tc_produce_struct_instance_tid's all-typevar skip: that skip guards
// the annotation/inference HOT path (an all-typevar instance there carries no more
// info than the bare tid and would only churn the pool). A fn-param annotation is
// resolved ONCE at register_fn_sig — not hot — and the typevar slots are exactly
// what the binder needs. Without the slots the fnsig param collapses to the bare
// `Box` (params_count 0), the arity check in unify_typevar_binds fails, and a
// bare-typevar return `-> T` bound to a struct instance stays unsubstituted →
// codegen types the result `void`.
//
// Safe for check_arg_shapes: types_compatible treats a typevar slot as compatible
// with anything (TyKind.Typevar short-circuit + the element-wise struct-slot compare),
// so `Box[Box[Int]]` still matches the `Box[T]` param. Returns -1 (caller keeps the
// bare tid) unless the annotation is a generic user-struct with type-args.
//
// The make_struct_instance_type write to ty_pool/ty_param_list is INTENTIONAL (the
// interned instance is the return value), not speculative — the save/restore here
// covers only tc_suppress_ann_validation, so the mutation-analyzer flag is expected.
@allow(UnrestoredMutation)
fn tc_fnsig_param_instance_tid(ann_node: Int, bare_tid: Int) -> Int ! TypeCheck.Resolve, Diag.Report {
    let bk = type_kind(bare_tid)
    // br 82ajft item 3: a generic-ENUM param/return (`t: Tree[T]` / `-> Tree[Int]`)
    // must also re-intern as a structural instance carrying its type-arg slots — the
    // enum twin of the struct case — so the codegen return/param mono seams read the
    // instance tid (tc_lookup_node_tid → tc_tid_struct_mono_name → blink_Tree_Int)
    // instead of the erased bare base. Without it a `-> Tree[Int]` return kept the
    // bare Tree tid and lowered to the never-typedef'd blink_Tree.
    if bk != TyKind.Struct && bk != TyKind.Enum { return -1 }
    let elems_sl = node_elements(ann_node)
    if elems_sl == -1 || sublist_length(elems_sl) < 1 { return -1 }
    let saved_suppress = tc_suppress_ann_validation
    tc_suppress_ann_validation = 1
    let mut arg_tids: List[Int] = []
    let mut ai = 0
    while ai < sublist_length(elems_sl) {
        arg_tids.push(resolve_type_ann(sublist_get(elems_sl, ai)))
        ai = ai + 1
    }
    tc_suppress_ann_validation = saved_suppress
    let base = strip_module_qualifier(node_name(ann_node))
    if bk == TyKind.Enum {
        return make_enum_instance_type(base, arg_tids)
    }
    make_struct_instance_type(base, arg_tids)
}

// A generic-enum VARIANT-FIELD annotation (`Branch(left: Tree[T], …)`) must intern
// as a STRUCTURAL enum instance carrying its type-arg slots — even all-typevar ones
// — so unify_typevar_binds' TyKind.Enum arm can walk the recursive-field param against a
// concrete `Tree[Int]` construction arg and bind T (jjhnf3). The enum analogue of
// tc_fnsig_param_instance_tid; same deliberate exception to the all-typevar skip
// (a field decl is resolved once at register_enum_type, not on the hot path).
// Returns -1 (caller keeps the bare resolved tid) unless the annotation is a
// generic user-enum with type-args.
@allow(UnrestoredMutation)
fn tc_evfield_instance_tid(ann_node: Int, bare_tid: Int) -> Int ! TypeCheck.Resolve, Diag.Report {
    if type_kind(bare_tid) != TyKind.Enum { return -1 }
    let elems_sl = node_elements(ann_node)
    if elems_sl == -1 || sublist_length(elems_sl) < 1 { return -1 }
    let saved_suppress = tc_suppress_ann_validation
    tc_suppress_ann_validation = 1
    let mut arg_tids: List[Int] = []
    let mut ai = 0
    while ai < sublist_length(elems_sl) {
        arg_tids.push(resolve_type_ann(sublist_get(elems_sl, ai)))
        ai = ai + 1
    }
    tc_suppress_ann_validation = saved_suppress
    make_enum_instance_type(strip_module_qualifier(node_name(ann_node)), arg_tids)
}

// Purely SYNTACTIC pre-check: is `v` a direct call to a bare Ident whose signature
// declares at least one RETURN-ONLY type param — i.e. could this node have minted a
// metavar that a declared type is entitled to pin?
//
// This is the load-bearing narrowing for tc_pin_struct_lit_field_ret_mints, on two
// counts, and neither is an optimization detail:
//
//   • COST. infer_type does not memoize its diagnostics, so an unconditional infer
//     per struct-literal field would re-run every field value's checking for every
//     struct literal in the program. Answering "can this mint" without inferring
//     keeps the walk free for the overwhelming majority of literals.
//
//   • SCOPE. It STRUCTURALLY excludes the hazard the pin doc at tc_node_has_ret_mint
//     warns about — `let x: Box[Map[Float,Int]] = Box { value: Map() }`, which drives
//     a Float key into resolve_ctor_kops_elem and out the BLINK_COMPILER_BUG_ escape.
//     `Map()`/`Set()`/`[]`/`None` are builtins handled long before lookup_fnsig, so
//     the lookup misses and this returns 0. The field pin therefore cannot reach a
//     bare ctor field value at all; that shape stays exactly where it is today.
//
// A local binding of the same name shadows the global sig (a closure-valued
// variable), so it is excluded the same way the Call arm of infer_type excludes it.
fn tc_call_mints_ret_only(v: Int) -> Int {
    if v == -1 { return 0 }
    if node_kind(v) != NodeKind.Call { return 0 }
    let callee = node_left(v)
    if callee == -1 { return 0 }
    if node_kind(callee) != NodeKind.Ident { return 0 }
    let mut fn_name = node_name(callee)
    fn_name = tc_alias_to_original.get(fn_name) ?? fn_name
    if nr_get_type(fn_name) != TYPE_UNKNOWN { return 0 }
    let sig = lookup_fnsig(fn_name)
    if sig == -1 { return 0 }
    let fs = fnsig_pool.get(sig).unwrap()
    let mut pi = 0
    while pi < fs.type_params_count {
        let ro_idx = fs.type_params_start + pi
        if ro_idx < fnsig_tparam_ret_only.len() {
            if fnsig_tparam_ret_only.get(ro_idx).unwrap() != 0 { return 1 }
        }
        pi = pi + 1
    }
    0
}

// A struct literal's DECLARED FIELD TYPE is an expected-type source for that field's
// value, exactly as a let annotation and an assignment target are (e2kjqy). Without
// this, `Wrapper { inner: mk() }` for `fn mk[T]() -> RGT[T]` left the α minted for
// mk's return-only T unbound and it reached the emit_struct_lit chokepoint erased.
//
// THERE IS NO OTHER PLACE THIS COULD LIVE. The compiler has no struct-literal
// field-value type CHECK anywhere; the binds loop in tc_struct_lit_instance_tid below
// is the only spot where a declared field type meets its value's type, and its
// consumer unify_typevar_binds is a pure bind COLLECTOR that never mutates a metavar.
// So this is a new, deliberately-scoped walk rather than an extra line in that loop —
// and it must run BEFORE the loop, so a generic outer struct sees the solved α when it
// builds its own instance args.
//
// TWO GATES, IN THIS ORDER, both required. On first visit the value has never been
// inferred, so no mint exists yet and tc_node_has_ret_mint reads 0: the syntactic
// check answers "CAN this mint" without inferring, and the existence check then
// confirms "DID it". Reversing them makes the walk a no-op on every first visit;
// dropping the syntactic one re-infers every field of every struct literal.
//
// Deliberately NOT transitive. A value that merely CONTAINS a minting call (an if or
// match arm tail) is out of scope: reaching it needs a successor predicate that is
// only half-solvable from one arm's type, and half-solved is the "compiles under a
// wrong-but-plausible mono name" failure a loud I0001 exists to prevent.
fn tc_pin_struct_lit_field_ret_mints(stid: Int, node: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let flds_sl = node_fields(node)
    if flds_sl == -1 { return }
    let mut fi = 0
    while fi < sublist_length(flds_sl) {
        let f = sublist_get(flds_sl, fi)
        let v = node_value(f)
        if tc_call_mints_ret_only(v) != 0 {
            let declared = get_struct_field_tid(stid, node_name(f))
            if declared != -1 {
                let inferred = infer_type(v)
                if tc_node_has_ret_mint(v) != 0 {
                    tc_pin_tail_ret_generic(declared, inferred)
                }
            }
        }
        fi = fi + 1
    }
}

// LIVE reverse-inference of a struct literal's concrete instance tid (br qw7v90,
// increment B of the codegen-structured-tids epic). Given the bare generic tid
// (`Box`) and the StructLit node, unify each declared generic field type (which
// holds TyKind.Typevar for a generic field, e.g. Box.value: T) against the inferred
// type of the corresponding literal field VALUE, collecting typevar→concrete
// binds. If at least one type-param binds to a concrete (non-typevar) type, build
// the structured instance tid (make_struct_instance_type, args in the decl's
// type-param order) and return it; otherwise fall back to the bare `stid`.
//
// Fallback (bare) is the correct answer when the literal carries no concrete
// information: an all-typevar field, or an empty-collection field (`Box { value:
// Map() }`) whose value infers Map[?,?] with no reachable concrete inner. The
// instance tid meeting the bare tid stays compatible (types_compatible bare~any),
// so returning bare never causes a spurious mismatch — it only forgoes the
// stronger check when nothing is knowable, exactly like the annotation side.
//
// A missing decl node (should not happen for a resolved struct) or a non-generic
// struct (no type params) short-circuits to bare — no instance is minted for a
// monomorphic struct, keeping the pool free of redundant entries.
fn tc_struct_lit_instance_tid(stid: Int, sname: Str, node: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    tc_pin_struct_lit_field_ret_mints(stid, node)
    let bare = strip_module_qualifier(sname)
    let decl = tc_struct_decl_nodes.get(bare) ?? -1
    if decl == -1 { return stid }
    let tparams_sl = node_type_params(decl)
    if tparams_sl == -1 || sublist_length(tparams_sl) == 0 { return stid }
    let flds_sl = node_fields(node)
    if flds_sl == -1 { return stid }
    let mut binds: Map[Str, Int] = Map()
    let mut fi = 0
    while fi < sublist_length(flds_sl) {
        let f = sublist_get(flds_sl, fi)
        let fname = node_name(f)
        let declared = get_struct_field_tid(stid, fname)
        if declared != -1 {
            unify_typevar_binds(declared, infer_type(node_value(f)), binds)
        }
        fi = fi + 1
    }
    // Decide whether any type-param bound to a concrete type BEFORE building the
    // arg list, so the no-concrete fallback does not mint throwaway pool entries on
    // the hot inference path — it returns the bare tid untouched. "Concrete" here
    // excludes BOTH a typevar AND TYPE_UNKNOWN: an empty `Map()`/`Set()` field binds
    // its param to TYPE_UNKNOWN (make_map_type(TYPE_UNKNOWN,..)), and an instance
    // whose args are all unknown carries no more information than the bare tid.
    // Minting it would produce a `GKV[?,?]` whose field access substitutes to a
    // CT_VOID inner and defeats codegen's erased-default recovery (br 365fqj). A
    // MIXED instance (one arg concrete, one unknown) still mints — the arg-list
    // builder keeps the unknown arg, and the field-access consumer skips it.
    let mut has_concrete = 0
    // gqg3rk: also mint the instance when a param bound to an UNBOUND metavar
    // (an inner empty `Map()`/`Set()`/`[]`/`None`). Pre-decision this returned the
    // bare stid and the erased inner rode codegen's default-recovery; post-decision
    // an under-determined construction must be REPORTED (E0301), so the instance
    // must carry the α — the region-boundary check then blames the binding and
    // names the open params. A raw resolved metavar (kind TyKind.Unknown after
    // tc_resolve) is the trigger; a bare TyKind.Typevar (legitimate generic-fn body
    // context) is NOT — that still returns the bare stid untouched.
    let mut has_open_metavar = 0
    // gq131c: also mint when a param binds to a bare TyKind.Typevar from the
    // ENCLOSING generic fn's own scope (`Box { value: inner }` where `inner: T`
    // inside `fn wrap_and_build[T](...)`). A bare-head instance has no param slot
    // for wrap_and_build's OWN monomorphization (T:=Int) to substitute into, so
    // the callee's mono symbol permanently erases to the undeclared generic head
    // (blink_Box instead of blink_Box_Int). Minting with the raw typevar in the
    // slot (make_typevar(tpname), below) is safe: get_struct_field_tid/
    // tc_struct_base_tid normalize any instance back to its base decl tid by
    // name regardless of slot contents.
    let mut has_bare_typevar = 0
    let mut ci = 0
    while ci < sublist_length(tparams_sl) {
        let bound = binds.get(node_name(sublist_get(tparams_sl, ci))) ?? -1
        if bound != -1 && type_kind(bound) != TyKind.Typevar && type_kind(bound) != TyKind.Unknown { has_concrete = 1 }
        if bound != -1 && tc_tid_has_unbound_metavar(bound) != 0 { has_open_metavar = 1 }
        if bound != -1 && type_kind(bound) == TyKind.Typevar { has_bare_typevar = 1 }
        ci = ci + 1
    }
    if has_concrete == 0 && has_open_metavar == 0 && has_bare_typevar == 0 { return stid }
    let mut arg_tids: List[Int] = []
    let mut ti = 0
    while ti < sublist_length(tparams_sl) {
        let tpname = node_name(sublist_get(tparams_sl, ti))
        let bound = binds.get(tpname) ?? -1
        if bound != -1 {
            arg_tids.push(bound)
        } else {
            arg_tids.push(make_typevar(tpname))
        }
        ti = ti + 1
    }
    make_struct_instance_type(bare, arg_tids)
}

// ── Registration from AST ───────────────────────────────────────────

fn is_ffi_struct_field_type(ann_name: Str) -> Int {
    if ann_name == "I8" || ann_name == "I16" || ann_name == "I32" || ann_name == "I64" { return 1 }
    if ann_name == "U8" || ann_name == "U16" || ann_name == "U32" || ann_name == "U64" { return 1 }
    if ann_name == "Int" || ann_name == "Float" || ann_name == "F32" || ann_name == "F64" { return 1 }
    if ann_name == "Bool" { return 1 }
    0
}

fn is_builtin_hashable(name: Str) -> Int {
    if name == "Str" || name == "Int" || name == "Bool" || name == "Char" { return 1 }
    if name == "I8" || name == "I16" || name == "I32" || name == "I64" { return 1 }
    if name == "U8" || name == "U16" || name == "U32" || name == "U64" { return 1 }
    0
}

// Verify that a Map key type annotation is hashable. Emits MAP_KEY_NOT_HASHABLE
// (E1400) on rejection. Built-in scalars are always OK; user structs/enums
// must carry @derive(Hash); tuples are OK iff every element is hashable;
// Float/Double are explicitly rejected. Generic type parameters are accepted
// since we can't see through them at this point.
// A type alias / refinement (`type Port = Int`, `type Port = Int @where(self > 0)`) constrains
// the VALUES that inhabit its base type; it is not a new representation. sections/03b_contracts.md
// is explicit — "@where constrains the set of values that inhabit the type" — and
// sections/03_types.md:757 draws the contrast from the other side, calling sized ints "first-class
// nominal types -- not refinements of Int, not aliases, not newtypes".
//
// Hashability is a property of representation plus equality, so an alias is hashable exactly when
// its base is. @derive(Hash, Eq) exists for structs and enums, which have no intrinsic hash; asking
// it of a refinement over Int is a category error, and the E1400 help text ("add @derive(Hash, Eq)
// to the 'Port' type definition") is advice the user should never need — it is written for a struct.
//
// Resolving the name makes both answers fall out of the ordinary rules below rather than needing a
// carve-out: `type Port = Int` reaches is_builtin_hashable and is accepted, while
// `type Temp = Float` reaches the Float arm and is rejected for the NaN hazard it actually has.
// Skipping aliases instead would accept a Float-keyed Map, which the spec forbids outright.
//
// Resolution is deliberately partial. A NAME cannot carry type arguments, so `type Pair =
// (Float, Float)` resolves to a bare tuple name with no element nodes to recurse into, and any
// verdict read off that name would be a guess — accepting it would punch a Float-keyed hole
// straight through the arm above. So a hop is taken only when the underlying name is one these
// rules can decide NOMINALLY: a hashable builtin, a Float width, or a declared struct/enum
// (which also keeps alias chains walking, since an intermediate alias is itself a named type).
// Anything else leaves the declared name in place and the caller's behavior unchanged.
// "Tuple" is deliberately excluded even though is_primitive_type recognizes it: a NAME
// carries no type arguments, so a tuple alias (`type Pair = (Float, Float)`) resolves to
// the bare name "Tuple" with no element nodes to recurse into, and Tuple's hashability
// depends entirely on its elements. Every OTHER primitive name is decided by the name
// alone regardless of its own type arguments — a container (List/Map/Set/Option/Result)
// is never Hash no matter what it holds, same for Bytes/StringBuilder/Fn/etc — so hopping
// to one of those and rejecting immediately is sound without seeing inside it.
fn alias_name_decidable(name: Str) -> Int {
    if name == "Tuple" { return 0 }
    if is_primitive_type(name) != 0 { return 1 }
    let bare = strip_module_qualifier(name)
    if named_type_map.contains_key(name) || named_type_map.contains_key(bare) { return 1 }
    0
}

fn resolve_alias_type_name(name0: Str) -> Str {
    if tc_alias_underlying.len() == 0 { return name0 }
    let mut name = name0
    let mut hops = 0
    while hops < 8 {
        let bare = strip_module_qualifier(name)
        let mut u = tc_alias_underlying.get(name) ?? -1
        if u == -1 { u = tc_alias_underlying.get(bare) ?? -1 }
        if u == -1 { return name }
        let next = tc_type_name(u)
        if next == "" || next == name { return name }
        if alias_name_decidable(next) == 0 { return name }
        name = next
        hops = hops + 1
    }
    name
}

fn validate_map_key(key_ann: Int) ! Diag.Report {
    // Decisions read the base type; every message names what the USER wrote, so a rejected
    // `type Temp = Float` says "Map key type 'Temp'" and explains the Float hazard behind it.
    let decl_name = node_name(key_ann)
    let key_name = resolve_alias_type_name(decl_name)
    if key_name == "Float" || key_name == "F32" || key_name == "F64" {
        diag_error_at("MapKeyNotHashable", MAP_KEY_NOT_HASHABLE, "Map key type '{decl_name}' is not hashable — Float/Double values cannot serve as Map keys (NaN-inequality and bit-equality hazards)", key_ann, "round the key to an Int (or another integer width) before inserting")
        return
    }
    if key_name == "Tuple" {
        let elems = node_elements(key_ann)
        if elems != -1 {
            let mut i = 0
            while i < sublist_length(elems) {
                validate_map_key(sublist_get(elems, i))
                i = i + 1
            }
        }
        return
    }
    if is_builtin_hashable(key_name) != 0 { return }
    let bare = strip_module_qualifier(key_name)
    if tc_hashable_types.contains_key(key_name) || tc_hashable_types.contains_key(bare) {
        return
    }
    // Generic type params and unknown names — let later phases handle them.
    // Only reject when we KNOW this is a user-defined struct/enum without
    // @derive(Hash), to avoid spurious errors on generics.
    // The message names what the user wrote; the help names the type that actually has to carry the
    // derive. For `type MyKey = Point` those differ, and pointing the fix at Point is the useful
    // half — @derive on the alias would be the category error described above.
    if named_type_map.contains_key(key_name) || named_type_map.contains_key(bare) {
        diag_error_at("MapKeyNotHashable", MAP_KEY_NOT_HASHABLE, "Map key type '{decl_name}' does not implement Hash — user types used as Map keys must carry the @derive(Hash, Eq) annotation", key_ann, "add @derive(Hash, Eq) to the '{key_name}' type definition")
        return
    }
    // Deny-by-default: is_primitive_type enumerates every concrete builtin name the
    // compiler knows (List/Map/Set/Option/Result, Bytes, StringBuilder, Fn, ...). None of
    // them implement Hash, and none of them can gain one via @derive, so any name it
    // recognizes here is a known rejection rather than a missing diagnostic. A name it
    // does NOT recognize, and that is also not a registered user type, is a generic type
    // parameter opaque at this point — deferred to later phases, same as always.
    if is_primitive_type(key_name) != 0 {
        diag_error_at("MapKeyNotHashable", MAP_KEY_NOT_HASHABLE, "Map key type '{decl_name}' does not implement Hash — {key_name} has no Hash/Eq implementation in v1 (containers, Bytes, StringBuilder, and fn types cannot be Map keys)", key_ann, "use a hashable scalar (Int/sized-int/Bool/Char/Str), a tuple of hashable types, or a @derive(Hash, Eq) struct/enum as the key instead")
    }
}

// Verify that a Set element type annotation is hashable — a Set is a keys-only
// hash table, so its element carries the same Hash requirement as a Map key.
// Emits MAP_KEY_NOT_HASHABLE (E1400) with Set-worded messages. Same rules as
// validate_map_key: built-in scalars OK; user structs/enums need @derive(Hash);
// tuples OK iff every element is hashable; Float/Double rejected; generic type
// params accepted (opaque at this point); aliases decided by their base type.
fn validate_set_elem(elem_ann: Int) ! Diag.Report {
    // Same decl/base split as validate_map_key: verdicts read the base type, messages name what
    // the user wrote.
    let decl_name = node_name(elem_ann)
    let elem_name = resolve_alias_type_name(decl_name)
    if elem_name == "Float" || elem_name == "F32" || elem_name == "F64" {
        diag_error_at("MapKeyNotHashable", MAP_KEY_NOT_HASHABLE, "Set element type '{decl_name}' is not hashable — Float/Double values cannot serve as Set elements (NaN-inequality and bit-equality hazards)", elem_ann, "round the value to an Int (or another integer width) before inserting")
        return
    }
    if elem_name == "Tuple" {
        let elems = node_elements(elem_ann)
        if elems != -1 {
            let mut i = 0
            while i < sublist_length(elems) {
                validate_set_elem(sublist_get(elems, i))
                i = i + 1
            }
        }
        return
    }
    if is_builtin_hashable(elem_name) != 0 { return }
    let bare = strip_module_qualifier(elem_name)
    if tc_hashable_types.contains_key(elem_name) || tc_hashable_types.contains_key(bare) {
        return
    }
    if named_type_map.contains_key(elem_name) || named_type_map.contains_key(bare) {
        diag_error_at("MapKeyNotHashable", MAP_KEY_NOT_HASHABLE, "Set element type '{decl_name}' does not implement Hash — user types used as Set elements must carry the @derive(Hash, Eq) annotation", elem_ann, "add @derive(Hash, Eq) to the '{elem_name}' type definition")
        return
    }
    // Deny-by-default — see validate_map_key's twin comment. A name is_primitive_type
    // recognizes is a known-concrete builtin with no Hash impl; anything else unresolved
    // is a generic type parameter and stays deferred.
    if is_primitive_type(elem_name) != 0 {
        diag_error_at("MapKeyNotHashable", MAP_KEY_NOT_HASHABLE, "Set element type '{decl_name}' does not implement Hash — {elem_name} has no Hash/Eq implementation in v1 (containers, Bytes, StringBuilder, and fn types cannot be Set elements)", elem_ann, "use a hashable scalar (Int/sized-int/Bool/Char/Str), a tuple of hashable types, or a @derive(Hash, Eq) struct/enum as the element instead")
    }
}

// Hashability validation for a STRUCT or ENUM annotation's type arguments (br f8t5wb).
//
// resolve_type_ann's Map and Set branches validate their own key/element, and the builtin
// carrier branches (Option/Result/Tuple) reach a nested Map/Set because they resolve their
// inners through resolve_type_ann. The struct and enum branches did neither: they hand the
// annotation straight to tc_produce_struct_instance_tid / tc_produce_enum_instance_tid and
// return the instance tid, and those producers re-resolve the args with
// tc_suppress_ann_validation raised. So nothing on the LIVE path had ever visited a struct
// type-arg, and `Box[Map[Float,Int]]` was accepted while the bare `Map[Float,Int]` was
// rejected outright.
//
// That was never merely a missing diagnostic. Codegen has no kops vtable for a Float key, so
// once any tier pinned the slot, kops_table_name fell through to
// BLINK_COMPILER_BUG_kops_unsupported_K_ct1_Float — an invalid C identifier, a gcc-level
// failure with no Blink diagnostic, wearing a spelling that accuses the compiler for what is a
// user program naming an illegal key. Before the slot got pinned the erased default emitted
// blink_kops_str instead: a Float hashed through the STRING vtable, the br hnyqe4 silent-hash
// shape. Which of the two you got depended only on whether some unrelated tier happened to
// bind the slot.
//
// Deliberately NOT a resolve_type_ann recursion. This walks the annotation tree and calls only
// the two validators, so it interns nothing and appends nothing to ty_pool — which is what
// keeps every legal program byte-identical, the concern that made the off-path producer
// suppress in the first place. Validating HERE rather than un-suppressing THERE is also what
// makes the diagnostic fire once per SITE: the live path visits each annotation exactly once,
// while the off-path producer can visit one node repeatedly.
//
// The recursion descends through intervening carriers and struct levels alike, so
// `Box[Box[Map[Float,Int]]]` and `Box[Option[Set[Float]]]` are both reached. A typevar or
// unknown arg name matches neither "Map" nor "Set" and has no elements, so it costs one
// comparison and terminates — the deferral validate_map_key documents for type params stays
// intact (br 0kvdef is the sibling bug where being over-eager here is itself the defect).
fn tc_validate_type_arg_hashability(elems_sl: Int) ! Diag.Report {
    if elems_sl == -1 { return }
    let mut i = 0
    while i < sublist_length(elems_sl) {
        let arg = sublist_get(elems_sl, i)
        let arg_name = node_name(arg)
        let arg_elems = node_elements(arg)
        if arg_name == "Map" {
            if arg_elems != -1 && sublist_length(arg_elems) >= 1 {
                validate_map_key(sublist_get(arg_elems, 0))
            }
        } else if arg_name == "Set" {
            if arg_elems != -1 && sublist_length(arg_elems) >= 1 {
                validate_set_elem(sublist_get(arg_elems, 0))
            }
        }
        tc_validate_type_arg_hashability(arg_elems)
        i = i + 1
    }
}

// vfgp72: scan EVERY @derive annotation, not just the first. get_annotation
// returns only the first match, so `@derive(Eq)` + `@derive(Ord)` on separate
// lines hid the second derive (codegen's register_derive_annotations already
// walks all of node_handlers, so this aligns typecheck with codegen).
fn type_has_derive(td: Int, derive_name: Str) -> Int {
    let anns = node_handlers(td)
    if anns == -1 { return 0 }
    let mut i = 0
    while i < sublist_length(anns) {
        let ann = sublist_get(anns, i)
        if node_name(ann) == "derive" {
            let args_sl = node_args(ann)
            if args_sl != -1 {
                let mut j = 0
                while j < sublist_length(args_sl) {
                    if node_name(sublist_get(args_sl, j)) == derive_name { return 1 }
                    j = j + 1
                }
            }
        }
        i = i + 1
    }
    0
}

// Names the compiler reserves for internal AST head-sentinels: the parser
// overloads these head names to tag tuple / function / self-type annotations
// (parser.bl), and resolve_type_ann + resolve_tuple_ann key on the raw string.
// A user `type X` with one of these names would shadow the sentinel and
// mis-decode any annotation that mentions it (e.g. `type Tuple[X]` makes
// `(Int, Tuple[Int])` decode as a forbidden 1-arity tuple). Unlike other
// prelude names (shadowable with a warning), these three are un-shadowable
// because the collision has no disambiguation path — reject at the decl site.
fn is_reserved_type_sentinel(name: Str) -> Int {
    if name == "Tuple" || name == "Fn" || name == "Self" { return 1 }
    0
}

fn reject_reserved_type_name(td: Int) ! Diag.Report {
    let name = node_name(td)
    if is_reserved_type_sentinel(name) != 0 {
        diag_error_at("ReservedTypeName", RESERVED_TYPE_NAME, "type name '{name}' is reserved for an internal AST sentinel and cannot be declared as a user type", td, "rename the type")
    }
}

fn register_struct_type(td: Int) ! TypeCheck.Register, TypeCheck.Resolve, Diag.Report {
    reject_reserved_type_name(td)
    let name = node_name(td)
    let tid = new_type(TyKind.Struct, name)
    named_type_names.push(name)
    named_type_ids.push(tid)
    named_type_map.insert(name, tid)
    tc_struct_decl_nodes.insert(name, td)
    tc_type_decl_nodes.insert(name, td)
    let alias_ann = node_value(td)
    if alias_ann != -1 {
        tc_alias_underlying.insert(name, resolve_type_ann(alias_ann))
    }
    if type_has_derive(td, "Hash") != 0 {
        tc_hashable_types.insert(name, 1)
    }
    if type_has_derive(td, "Debug") != 0 {
        tc_debug_types.insert(name, 1)
    }

    let is_ffi_struct = has_annotation(td, "ffi.struct")
    if is_ffi_struct != 0 {
        ffi_struct_type_set.insert(name, 1)
    }

    let flds_sl = node_fields(td)
    if flds_sl != -1 {
        let mut i = 0
        while i < sublist_length(flds_sl) {
            let f = sublist_get(flds_sl, i)
            let fname = node_name(f)
            let ftype_ann = node_value(f)
            let ftype_id = resolve_type_ann(ftype_ann)
            sfield_pool.push(TcStructField { struct_id: tid, name: fname, type_id: ftype_id })
            let ftype_ann_name = node_name(ftype_ann)
            if ftype_ann_name == "Fn" {
                if is_callable_field_name(fname) == 0 {
                    nr_callable_field_names.push(fname)
                }
            }
            if is_ffi_struct != 0 {
                if is_ffi_struct_field_type(ftype_ann_name) == 0 {
                    diag_error_at("FfiStructGcField", FFI_STRUCT_GC_FIELD, "@ffi.struct field '{fname}' uses non-FFI type '{ftype_ann_name}' — only sized FFI-compatible types (I8/I16/I32/I64, U8/U16/U32/U64, Int, Float, F32, F64, Bool) and other @ffi.struct types are allowed", f, "use a sized integer/float/bool type or another @ffi.struct type")
                }
            }
            i = i + 1
        }
    }

    if has_annotation(td, "deprecated") != 0 {
        depr_type_nodes.insert(name, td)
    }
}

fn register_enum_type(td: Int) ! TypeCheck.Register, TypeCheck.Resolve, Diag.Report {
    reject_reserved_type_name(td)
    let name = node_name(td)
    let tid = new_type(TyKind.Enum, name)
    named_type_names.push(name)
    named_type_ids.push(tid)
    named_type_map.insert(name, tid)
    tc_type_decl_nodes.insert(name, td)
    if type_has_derive(td, "Hash") != 0 {
        tc_hashable_types.insert(name, 1)
    }
    if type_has_derive(td, "Debug") != 0 {
        tc_debug_types.insert(name, 1)
    }

    let flds_sl = node_fields(td)
    if flds_sl != -1 {
        let mut _tag = 0
        let mut i = 0
        while i < sublist_length(flds_sl) {
            let v = sublist_get(flds_sl, i)
            let vname = node_name(v)
            let var_idx = evar_pool.len()

            let vflds_sl = node_fields(v)
            let mut _has_data = 0
            if vflds_sl != -1 && sublist_length(vflds_sl) > 0 {
                _has_data = 1
                let mut fi = 0
                while fi < sublist_length(vflds_sl) {
                    let vf = sublist_get(vflds_sl, fi)
                    let vf_name = node_name(vf)
                    let vf_type_ann = node_value(vf)
                    let mut vf_type_id = resolve_type_ann(vf_type_ann)
                    // A generic-enum instance field (`Branch(left: Tree[T], …)`)
                    // interns its typevar slots so reverse-inference can bind T from
                    // a concrete `Tree[Int]` construction arg (jjhnf3).
                    let inst = tc_evfield_instance_tid(vf_type_ann, vf_type_id)
                    if inst != -1 { vf_type_id = inst }
                    evfield_pool.push(EnumVariantFieldEntry { var_idx: var_idx, name: vf_name, type_id: vf_type_id })
                    fi = fi + 1
                }
            }
            evar_pool.push(EnumVariantEntry { enum_id: tid, name: vname, tag: _tag, has_data: _has_data })
            if tc_variant_enum_decl_nodes.contains_key(vname) == 0 {
                tc_variant_enum_decl_nodes.insert(vname, td)
            }

            _tag = _tag + 1
            i = i + 1
        }
    }

    if has_annotation(td, "deprecated") != 0 {
        depr_type_nodes.insert(name, td)
    }
}

// A field of a @derive(Debug) type whose own type is a user struct/enum must
// itself derive Debug — the generated debug() renders each field via its
// debug(). A built-in scalar / Str is always OK; a user type is OK iff it
// itself carries @derive(Debug).
fn tc_debug_field_ok(ftype_name: Str) -> Int {
    if named_type_map.contains_key(ftype_name) == 0 { return 1 }
    if tc_debug_types.contains_key(ftype_name) != 0 { return 1 }
    0
}

// The container type constructors that the v1 Debug renderer can walk
// (or that the typecheck rule peels into the element/key/value check).
// Set/Result are container-shaped but NOT in the v1 renderable set.
fn tc_is_container_name(n: Str) -> Int {
    if n == "List" || n == "Option" || n == "Map" || n == "Set" || n == "Result" { return 1 }
    0
}

// Leaf type names that reach the Debug field check but are NOT Debug-renderable in v1 and
// can never be made so by adding a derive:
//   fn(...) -> T  → "Fn" (parser.bl:1437); (A, B) → "Tuple" (parser.bl:1408;
//   tuples auto-derive Eq/Ord/Hash/Display/Clone but NOT Debug, spec §3.6);
//   handler[E] → "Handler" (parser.bl:1453). Rejected E0520 like Set/Result
//   (0xr7fq); else they slip past tc_debug_field_ok and emit BLINK_COMPILER_BUG.
//
// "Void" is the one entry that is NOT a parser pseudo-type — it is an ordinary inhabited
// type (decisions/under-determined-types.md:39) — but it belongs here for the same reason
// "Tuple" does: `()` IS the 0-tuple, so rejecting the n-tuple and rendering the 0-tuple
// would be incoherent, and Void's single value carries no information to render. It reaches
// this check as a leaf name only after br hsgsbp made a declared Void field lower to an
// int64_t placeholder; while `v: Void` still emitted an illegal `void v;`, cc stopped every
// such build and the gap was invisible. Without this arm the type builds and RUNS, printing
// `<?>` for the field with a BLINK_COMPILER_BUG marker compiled into the binary — the
// silent-wrong-answer class this ticket exists to remove, not merely a missing diagnostic.
fn tc_is_non_debug_pseudo_type(n: Str) -> Int {
    if n == "Fn" || n == "Tuple" || n == "Handler" || n == "Void" { return 1 }
    0
}

// Is `tname` a user STRUCT (not an enum)? A struct decl's fields are plain
// TypeField nodes; an enum decl's first field is a TypeVariant (same shape used
// at whole-program registration, typecheck.bl:2644). Returns 0 for unknown /
// non-user names.
fn tc_type_is_struct(tname: Str) -> Int {
    let td = tc_type_decl_nodes.get(tname) ?? -1
    if td == -1 { return 0 }
    let flds = node_fields(td)
    if flds != -1 && sublist_length(flds) > 0 {
        if node_kind(sublist_get(flds, 0)) == NodeKind.TypeVariant { return 0 }
    }
    1
}

// The Map-key types the v1 renderer can read back through the kops storage
// layer. Two families: (a) scalars — Str / Char / Int / Bool / sized ints,
// stored inline (Char in single-quoted debug-form, decisions/char-debug-form.md);
// (b) @derive(Debug, Hash, Eq) user STRUCTS, read via blink_map_key_slot (which
// dereferences the inline_key=0 pointer) and rendered via {sname}_debug (mirrors
// the struct-VALUE path). Enums and non-Debug user types are still rejected
// (E0520 via tc_check_debug_element).
fn tc_debug_map_key_ok(key_name: Str) -> Int {
    if key_name == "Str" || key_name == "Char" || key_name == "Int" || key_name == "Bool" { return 1 }
    if key_name == "I8" || key_name == "I16" || key_name == "I32" || key_name == "I64" { return 1 }
    if key_name == "U8" || key_name == "U16" || key_name == "U32" || key_name == "U64" { return 1 }
    if tc_type_is_struct(key_name) != 0 && tc_debug_types.contains_key(key_name) != 0 { return 1 }
    0
}

// Check one element / value of a Debug-renderable container field. The rule is
// fully inductive (spec §3.6): a non-Debug leaf → E0520; a Set/Result element →
// E0520 (not renderable at any level); a List/Option/Map element recurses into
// its own element/key/value checks so arbitrary nesting is proven Debug.
fn tc_check_debug_element(elem_ann: Int, f: Int, tname: Str) ! Diag.Report {
    let elem_name = node_name(elem_ann)
    if tc_is_non_debug_pseudo_type(elem_name) != 0 {
        diag_error_at("DeriveDebugFieldNoDebug", DERIVE_DEBUG_FIELD_NO_DEBUG, "@derive(Debug) on '{tname}': field '{node_name(f)}' has element type '{elem_name}' which is not Debug-renderable in v1", f, "implement Debug manually for this field's type")
        return
    }
    if tc_is_container_name(elem_name) != 0 {
        // Nested container: Set/Result are still rejected at every level; the
        // renderable containers (List/Option/Map) recurse.
        if elem_name == "Set" || elem_name == "Result" {
            diag_error_at("DeriveDebugFieldNoDebug", DERIVE_DEBUG_FIELD_NO_DEBUG, "@derive(Debug) on '{tname}': field '{node_name(f)}' has element type '{elem_name}' which is not Debug-renderable (only List/Option/Map containers render)", f, "implement Debug manually for this field's type")
            return
        }
        tc_check_container_elems(elem_ann, f, tname)
        return
    }
    if tc_debug_field_ok(elem_name) == 0 {
        diag_error_at("DeriveDebugFieldNoDebug", DERIVE_DEBUG_FIELD_NO_DEBUG, "@derive(Debug) on '{tname}': field '{node_name(f)}' has element type '{elem_name}' which does not derive Debug", f, "add @derive(Debug) to '{elem_name}'")
    }
}

// Peel a List/Option/Map container annotation `ann` and check its element (or
// key + value) types. Shared between the top-level field check and the nested
// recursion in tc_check_debug_element, so nesting is pure composition. The
// caller guarantees `ann` names List / Option / Map (Set/Result rejected first).
fn tc_check_container_elems(ann: Int, f: Int, tname: Str) ! Diag.Report {
    let ftype_name = node_name(ann)
    let elems_sl = node_elements(ann)
    if ftype_name == "Map" {
        if elems_sl != -1 && sublist_length(elems_sl) >= 2 {
            let key_ann = sublist_get(elems_sl, 0)
            let key_name = node_name(key_ann)
            if tc_debug_map_key_ok(key_name) != 0 {
                tc_check_debug_element(key_ann, f, tname)
            } else if tc_type_is_struct(key_name) != 0 {
                // A user STRUCT key that isn't Debug (tc_debug_map_key_ok gates
                // the Debug ones above): let tc_check_debug_element emit the
                // precise "does not derive Debug" diagnostic.
                tc_check_debug_element(key_ann, f, tname)
            } else {
                // Container map keys (List/Map/Option/Set/Result) and other
                // unsupported keys land here — container keys stay rejected,
                // which is why the map-debug emitter never recurses on keys.
                diag_error_at("DeriveDebugFieldNoDebug", DERIVE_DEBUG_FIELD_NO_DEBUG, "@derive(Debug) on '{tname}': field '{node_name(f)}' has Map key type '{key_name}' which v1 Debug cannot render (Str/Char/Int/Bool/sized-int keys, or a @derive(Debug, Hash, Eq) struct key)", f, "use a supported scalar key or a Debug struct key, or implement Debug manually")
            }
            tc_check_debug_element(sublist_get(elems_sl, 1), f, tname)
        }
        return
    }

    // List / Option: peel element 0.
    if elems_sl != -1 && sublist_length(elems_sl) >= 1 {
        tc_check_debug_element(sublist_get(elems_sl, 0), f, tname)
    }
}

// Reject one field `f` of a @derive(Debug) type `tname` whose type — or whose
// container element/key/value type — does not derive Debug. `is_variant_field`
// is 1 when `f` is a field of an enum variant; container Debug rendering applies
// to struct fields AND enum-variant fields (x112x7), so the param is threaded
// only to keep call sites unchanged.
fn tc_check_one_debug_field(f: Int, tname: Str, _is_variant_field: Int) ! Diag.Report {
    let ann = node_value(f)
    let ftype_name = node_name(ann)

    if tc_is_non_debug_pseudo_type(ftype_name) != 0 {
        diag_error_at("DeriveDebugFieldNoDebug", DERIVE_DEBUG_FIELD_NO_DEBUG, "@derive(Debug) on '{tname}': field '{node_name(f)}' has type '{ftype_name}' which is not Debug-renderable in v1", f, "implement Debug manually for this field's type")
        return
    }

    if tc_is_container_name(ftype_name) == 0 {
        if tc_debug_field_ok(ftype_name) == 0 {
            diag_error_at("DeriveDebugFieldNoDebug", DERIVE_DEBUG_FIELD_NO_DEBUG, "@derive(Debug) on '{tname}': field '{node_name(f)}' has type '{ftype_name}' which does not derive Debug", f, "add @derive(Debug) to '{ftype_name}'")
        }
        return
    }

    // Field is a container type. Set/Result are not renderable at any level.
    if ftype_name == "Set" || ftype_name == "Result" {
        diag_error_at("DeriveDebugFieldNoDebug", DERIVE_DEBUG_FIELD_NO_DEBUG, "@derive(Debug) on '{tname}': field '{node_name(f)}' has type '{ftype_name}' which is not Debug-renderable in v1 (only List/Option/Map containers render)", f, "implement Debug manually for this field's type")
        return
    }

    tc_check_container_elems(ann, f, tname)
}

fn tc_check_derive_debug() ! Diag.Report {
    let mut ti = 0
    while ti < named_type_names.len() {
        let tname = named_type_names.get(ti).unwrap()
        if tc_debug_types.contains_key(tname) != 0 {
            let flds_sl = node_fields(tc_type_decl_nodes.get(tname).unwrap())
            let mut i = 0
            while flds_sl != -1 && i < sublist_length(flds_sl) {
                let f = sublist_get(flds_sl, i)
                if node_kind(f) == NodeKind.TypeVariant {
                    let vflds_sl = node_fields(f)
                    let mut vi = 0
                    while vflds_sl != -1 && vi < sublist_length(vflds_sl) {
                        tc_check_one_debug_field(sublist_get(vflds_sl, vi), tname, 1)
                        vi = vi + 1
                    }
                } else {
                    tc_check_one_debug_field(f, tname, 0)
                }
                i = i + 1
            }
        }
        ti = ti + 1
    }
}

// ---------------------------------------------------------------------------
// E1401 NonDerivableTrait — spec §3.6.6: a @derive(Hash/Eq/Ord) type may only
// contain fields whose type itself implements the derived trait. Modeled on
// tc_check_derive_debug (the Debug-field pass). Fail-open on generic /
// unresolved names so the compiler's own generic code keeps typechecking.
//
// v1 policy (spec §3.4:329): collections (List/Map/Set/Option/Result) have no
// value-equality/hash/ordering — `==` is pointer identity and there is no
// Eq/Hash/Ord impl for them as value types — so they are rejected under any of
// the three derives. Per-scalar: Float is not Hashable; Bool is not Orderable.

// Is a bare scalar type name integer-like (Int / sized ints / Char)?
fn tc_is_integer_scalar(n: Str) -> Int {
    if n == "Int" || n == "Char" { return 1 }
    if n == "I8" || n == "I16" || n == "I32" || n == "I64" { return 1 }
    if n == "U8" || n == "U16" || n == "U32" || n == "U64" { return 1 }
    0
}

fn tc_is_float_scalar(n: Str) -> Int {
    if n == "Float" || n == "F32" || n == "F64" { return 1 }
    0
}

// Does the named field type satisfy `tr` ("Hash"/"Eq"/"Ord")? Returns 1 for
// OK, 0 for reject. Fails OPEN (returns 1) for names that are neither a builtin
// scalar nor a known user type — generics / type params we can't resolve here.
fn tc_field_type_derivable(ftype_name: Str, tr: Str) -> Int {
    // Collections are never value-comparable/hashable/orderable in v1.
    if tc_is_container_name(ftype_name) != 0 { return 0 }

    // Tuple struct fields: a tuple is structurally Hash/Eq/Ord when its
    // elements are, but codegen (emit_struct_hash/_eq/_cmp) cannot synthesize a
    // per-tuple adapter for a struct FIELD today — it emits a BLINK_COMPILER_BUG
    // sentinel and a degenerate constant hash. Reject here so the failure is a
    // clear E1401 instead of a silent hash collapse. (Tuples as Map KEYS take a
    // different codegen path and remain supported.) Follow-up: sr04fj-class.
    if ftype_name == "Tuple" { return 0 }

    if tc_is_integer_scalar(ftype_name) != 0 { return 1 }
    if ftype_name == "Str" {
        // Str is Hash + Eq + Ord.
        return 1
    }
    if ftype_name == "Bool" {
        // Bool: Hash + Eq, but NOT Ord.
        if tr == "Ord" { return 0 }
        return 1
    }
    if tc_is_float_scalar(ftype_name) != 0 {
        // Float: Eq + Ord, but NOT Hash.
        if tr == "Hash" { return 0 }
        return 1
    }

    // User type: it must itself carry the trait (derive or hand-impl).
    let bare = strip_module_qualifier(ftype_name)
    if named_type_map.contains_key(ftype_name) || named_type_map.contains_key(bare) {
        if tr == "Hash" {
            if tc_hashable_types.contains_key(ftype_name) || tc_hashable_types.contains_key(bare) { return 1 }
            return 0
        }
        if tr == "Eq" {
            if tc_type_has_eq_impl(ftype_name) != 0 || tc_type_has_eq_impl(bare) != 0 { return 1 }
            return 0
        }
        // Ord
        if tc_type_has_ord_impl(ftype_name) != 0 || tc_type_has_ord_impl(bare) != 0 { return 1 }
        return 0
    }

    // Generic type param / unknown name — fail open.
    1
}

fn tc_check_one_derive_trait_field(f: Int, tname: Str, tr: Str) ! Diag.Report {
    let ann = node_value(f)
    let ftype_name = node_name(ann)
    if tc_field_type_derivable(ftype_name, tr) == 0 {
        diag_error_at("NonDerivableTrait", NON_DERIVABLE_TRAIT, "@derive({tr}) on '{tname}': field '{node_name(f)}' has type '{ftype_name}' which does not implement {tr}", f, "remove the field from the derive, give it a type that implements {tr}, or implement {tr} by hand")
    }
}

fn tc_check_one_derive_trait(tr: Str) ! Diag.Report {
    let mut ti = 0
    while ti < named_type_names.len() {
        let tname = named_type_names.get(ti).unwrap()
        let td = tc_type_decl_nodes.get(tname) ?? -1
        if td != -1 && type_has_derive(td, tr) != 0 {
            let flds_sl = node_fields(td)
            let mut i = 0
            while flds_sl != -1 && i < sublist_length(flds_sl) {
                let f = sublist_get(flds_sl, i)
                if node_kind(f) == NodeKind.TypeVariant {
                    let vflds_sl = node_fields(f)
                    let mut vi = 0
                    while vflds_sl != -1 && vi < sublist_length(vflds_sl) {
                        tc_check_one_derive_trait_field(sublist_get(vflds_sl, vi), tname, tr)
                        vi = vi + 1
                    }
                } else {
                    tc_check_one_derive_trait_field(f, tname, tr)
                }
                i = i + 1
            }
        }
        ti = ti + 1
    }
}

fn tc_check_derive_hash_eq_ord() ! Diag.Report {
    tc_check_one_derive_trait("Hash")
    tc_check_one_derive_trait("Eq")
    tc_check_one_derive_trait("Ord")
}

// Kind A collision: a struct type whose name equals an enum variant name. This is the
// NARROW invariant — two enums sharing a variant name (e.g. `Pending` in JobState and
// NetState) stays legal and is resolved by the hint, so we only fire when the colliding
// name is registered as a TyKind.Struct in named_type_map. Whole-program: both tables are
// merged across all modules at registration, so cross-module collisions are caught.
fn tc_check_name_collisions() ! TypeCheck.Register, Diag.Report {
    let mut i = 0
    while i < evar_pool.len() {
        let vname = evar_pool.get(i).unwrap().name
        let stid = named_type_map.get(vname) ?? -1
        if tc_collision_reported.contains_key(vname) == 0 && stid != -1 && type_kind(stid) == TyKind.Struct {
            tc_collision_reported.insert(vname, 1)
            let struct_node = tc_struct_decl_nodes.get(vname) ?? -1
            let enum_node = tc_variant_enum_decl_nodes.get(vname) ?? -1
            diag_error_at("NameCollision", NAME_COLLISION, "struct '{vname}' has the same name as an enum variant '{vname}'; bare construction would be ambiguous (note: two different enums MAY share a variant name — only a struct-vs-variant clash is rejected)", struct_node, "rename either the struct or the variant")
            if enum_node != -1 {
                diag_error_at("NameCollision", NAME_COLLISION, "the conflicting variant '{vname}' is declared here", enum_node, "rename either the struct or the variant")
            }
        }
        i = i + 1
    }
}

// Is `tp_name` return-only: named by the fn's RETURN annotation and by no parameter
// annotation? Computed once at registration, where `ret_ann` and `params_sl` are both
// in scope and the type-param push order is guaranteed to match the side-table's.
//
// BOTH halves of the conjunction are required, and the return half is the tighter of
// the two. Requiring only "no parameter mentions it" would also admit a PHANTOM type
// param (`fn f[T]() -> Int`), and a phantom binder is not a shape INFERENCE can solve:
// its type argument arrives from an explicit type-argument list at the call (`f[Int]()`
// — §3.4 *Explicit Type Application*), never from unifying against an argument or a
// binding annotation. So minting an inference metavar for it is the wrong instrument,
// not a deferred solution. Requiring the return annotation to name it keeps the mint at
// exactly the shape inference CAN reach, which is what "return-only" means.
//
// What happens to a phantom binder TODAY is a known defect, not the design: the bare
// call `f()` raises I0001 at the fn-mono chokepoint in emit_generic_fn_call_tail, where
// §3.4 says it must be error[CannotInferType] at the type-argument position; and the
// bracketed call `f[Int]()` is not rejected anywhere — it emits the literal Blink source
// text `const void a = f[Int]();` and `blink check` reports ok. Neither behaviour is the
// rule, and neither is evidence about what a call site can supply.
fn tc_tparam_is_ret_only(tp_name: Str, ret_ann: Int, params_sl: Int) -> Int {
    if ret_ann == -1 { return 0 }
    if !tc_ann_names_tparam(ret_ann, tp_name) { return 0 }
    if params_sl != -1 {
        let mut i = 0
        while i < sublist_length(params_sl) {
            let p = sublist_get(params_sl, i)
            // node_type_name as well as the walk: parse_param sets both from the same
            // annotation, but register_fn_sig itself falls back to the flat type_name
            // when a param carries no ann node (:2617), so a synthesized param must
            // not be able to hide a mention. Costs nothing and can only ever make
            // FEWER params look return-only — the safe direction.
            if node_type_name(p) == tp_name { return 0 }
            if tc_ann_names_tparam(node_type_ann(p), tp_name) { return 0 }
            i = i + 1
        }
    }
    1
}

fn register_fn_sig(fn_node: Int) ! TypeCheck.Register, TypeCheck.Resolve, Diag.Report {
    let name = node_name(fn_node)
    let ret_str = node_return_type(fn_node)
    let ret_ann = node_type_ann(fn_node)
    let mut ret_tid = TYPE_VOID

    if ret_ann != -1 {
        ret_tid = resolve_type_ann(ret_ann)
        // A generic user-struct RETURN (`-> LocBox[T]`) resolves to the BARE base
        // tid (resolve_type_ann's all-typevar instance is skipped for the hot path).
        // Re-intern it as a structural instance carrying the typevar slots — exactly
        // as the param path does (8wyq1k) — so instantiate_return_type's
        // substitute_typevar_tid has a T slot to rewrite; otherwise a call
        // `make_box(11)` returns the bare `LocBox` tid, and a downstream bare-typevar
        // fn (`wrap_opt[T](x: T) -> Option[T]`) mangles its mono off the arg-erased
        // head (blink_wrap_opt_LocBox, param blink_LocBox) instead of the concrete
        // instance (blink_wrap_opt_LocBox_Int) (br bd4mg6).
        let ret_inst = tc_fnsig_param_instance_tid(ret_ann, ret_tid)
        if ret_inst != -1 { ret_tid = ret_inst }
    } else if ret_str != "" {
        ret_tid = resolve_type_name(ret_str)
        if ret_tid == -1 {
            ret_tid = TYPE_VOID
        }
    }

    let sig_idx = fnsig_pool.len()
    fnsig_map.insert(name, sig_idx)
    let fn_mod = node_module(fn_node)
    if fn_mod != "" {
        fnsig_map.insert("{fn_mod}:{name}", sig_idx)
    }
    let start = fnsig_param_list.len()

    let params_sl = node_params(fn_node)
    let mut count = 0
    if params_sl != -1 {
        let mut i = 0
        while i < sublist_length(params_sl) {
            let p = sublist_get(params_sl, i)
            let ptype_str = node_type_name(p)
            let ptype_ann = node_type_ann(p)
            let mut ptid = TYPE_UNKNOWN
            if ptype_ann != -1 {
                ptid = resolve_type_ann(ptype_ann)
                // A generic user-struct param (`Box[T]`) resolves to the BARE base
                // tid; re-intern it as a structural instance carrying the typevar
                // slots so unify_typevar_binds can bind T from the argument (8wyq1k).
                let inst = tc_fnsig_param_instance_tid(ptype_ann, ptid)
                if inst != -1 { ptid = inst }
            } else if ptype_str != "" {
                ptid = resolve_type_name(ptype_str)
                if ptid == -1 {
                    ptid = TYPE_UNKNOWN
                }
            }
            fnsig_param_list.push(ptid)
            count = count + 1
            i = i + 1
        }
    }

    let tparams_sl = node_type_params(fn_node)
    let tp_start = fnsig_type_param_names.len()
    let mut tp_count = 0
    if tparams_sl != -1 {
        let mut ti = 0
        while ti < sublist_length(tparams_sl) {
            let tp = sublist_get(tparams_sl, ti)
            let tp_name = node_name(tp)
            fnsig_type_param_names.push(tp_name)
            fnsig_tparam_ret_only.push(tc_tparam_is_ret_only(tp_name, ret_ann, params_sl))
            tp_count = tp_count + 1
            ti = ti + 1
        }
    }
    let eff_start = fnsig_effect_names.len()
    let effects_sl = node_effects(fn_node)
    let mut eff_count = 0
    if effects_sl != -1 {
        let mut ei = 0
        while ei < sublist_length(effects_sl) {
            let eff = sublist_get(effects_sl, ei)
            fnsig_effect_names.push(node_name(eff))
            eff_count = eff_count + 1
            ei = ei + 1
        }
    }
    fnsig_pool.push(FnSigEntry { name: name, ret: ret_tid, params_start: start, params_count: count, type_params_start: tp_start, type_params_count: tp_count, effects_start: eff_start, effects_count: eff_count })

    if has_annotation(fn_node, "deprecated") != 0 {
        depr_fn_nodes.insert(name, fn_node)
    }
}

fn depr_ann_str_arg(ann_node: Int, key: Str) -> Str {
    let args_sl = node_args(ann_node)
    if args_sl == -1 { return "" }
    let mut i = 0
    while i < sublist_length(args_sl) {
        let arg = sublist_get(args_sl, i)
        if node_name(arg) == key {
            let parts_sl = node_elements(arg)
            if parts_sl != -1 && sublist_length(parts_sl) > 0 {
                return node_str_val(sublist_get(parts_sl, 0))
            }
        }
        i = i + 1
    }
    ""
}

fn check_deprecated_fn(fn_name: Str, call_node: Int) ! Diag.Report {
    if depr_fn_nodes.contains_key(fn_name) == 0 { return }
    let def_node = depr_fn_nodes.get(fn_name) ?? -1
    if def_node == -1 { return }
    let ann = get_annotation(def_node, "deprecated")
    if ann == -1 { return }
    let since = depr_ann_str_arg(ann, "since")
    let replacement = depr_ann_str_arg(ann, "replacement")
    let mut msg = "use of deprecated function '{fn_name}'"
    if since != "" {
        msg = msg.concat(" (deprecated since {since})")
    }
    let mut help = ""
    if replacement != "" {
        help = "use '{replacement}' instead"
    }
    diag_warn_at("DeprecatedUsage", DEPRECATED_USAGE, msg, call_node, help)
}

fn check_deprecated_type(type_name: Str, usage_node: Int) ! Diag.Report {
    if depr_type_nodes.contains_key(type_name) == 0 { return }
    let def_node = depr_type_nodes.get(type_name) ?? -1
    if def_node == -1 { return }
    let ann = get_annotation(def_node, "deprecated")
    if ann == -1 { return }
    let since = depr_ann_str_arg(ann, "since")
    let replacement = depr_ann_str_arg(ann, "replacement")
    let mut msg = "use of deprecated type '{type_name}'"
    if since != "" {
        msg = msg.concat(" (deprecated since {since})")
    }
    let mut help = ""
    if replacement != "" {
        help = "use '{replacement}' instead"
    }
    diag_warn_at("DeprecatedUsage", DEPRECATED_USAGE, msg, usage_node, help)
}

fn is_valid_ptr_inner(name: Str) -> Int {
    if name == "Void" { return 1 }
    if name == "U8" || name == "U16" || name == "U32" || name == "U64" { return 1 }
    if name == "I8" || name == "I16" || name == "I32" || name == "I64" { return 1 }
    if name == "Int" || name == "Float" || name == "Ptr" { return 1 }
    if ffi_struct_type_set.contains_key(name) != 0 { return 1 }
    0
}

fn check_ptr_in_type_ann(ann_node: Int, has_ffi: Int) ! Diag.Report {
    if ann_node == -1 { return }
    let name = node_name(ann_node)
    if name == "Ptr" {
        if has_ffi == 0 {
            diag_error_at("PtrOutsideFFI", PTR_OUTSIDE_FFI, "Ptr[T] type can only be used in @ffi functions or @trusted blocks", ann_node, "add @ffi annotation to the function or wrap usage in @trusted")
        }
        let elems_sl = node_elements(ann_node)
        if elems_sl != -1 && sublist_length(elems_sl) > 0 {
            let inner = sublist_get(elems_sl, 0)
            let inner_name = node_name(inner)
            if is_valid_ptr_inner(inner_name) == 0 {
                diag_error_at("InvalidPtrType", INVALID_PTR_TYPE, "invalid Ptr type parameter '{inner_name}' — only Void, U8-U64, I8-I64, Int, Float, Ptr, or @ffi.struct types are allowed", inner, "use a valid FFI-compatible type or annotate the type with @ffi.struct")
            }
        }
        return
    }
    let elems_sl = node_elements(ann_node)
    if elems_sl != -1 {
        let mut i = 0
        while i < sublist_length(elems_sl) {
            check_ptr_in_type_ann(sublist_get(elems_sl, i), has_ffi)
            i = i + 1
        }
    }
}

fn check_ptr_in_type_name(type_name: Str, node: Int, has_ffi: Int) ! Diag.Report {
    if type_name == "Ptr" && has_ffi == 0 {
        diag_error_at("PtrOutsideFFI", PTR_OUTSIDE_FFI, "Ptr[T] type can only be used in @ffi functions or @trusted blocks", node, "add @ffi annotation to the function or wrap usage in @trusted")
    }
}

// ── Phase 0: Contract predicate validator ─────────────────────────────
//
// Predicates inside @requires / @ensures / @where must lie in an
// SMT-decidable subset so that today's runtime checks can later be
// promoted to compile-time proofs without rewriting every contract.
//
// Allowed: literals, identifiers, parameter refs, `result` (in @ensures),
// `old(_)` (in @ensures), arithmetic / comparison / boolean / equality
// binops, unary `!` and unary `-`, FieldAccess, IndexExpr, RangeLit,
// IfExpr, MatchExpr, calls/method-calls to either a hardcoded bootstrap
// whitelist (`len`, `is_empty`, `unwrap`, `abs`) or to a @pure function.
//
// Rejected (each maps to a distinct diagnostic in E1300-E1306):
//   - LetBinding, Assignment/CompoundAssign            → E1306 / E1300
//   - Closure, ForIn, WhileLoop, LoopExpr              → E1303 / E1300
//   - Break, Continue, Return                          → E1300
//   - WithBlock, AsyncSpawn, AwaitExpr, ChannelNew     → E1300
//   - Allocation (ListLit, StructLit non-trivially)    → E1300
//   - Calls into effectful fns                         → E1301
//   - Calls into non-pure user fns (no effects, but
//     not @pure / not on bootstrap whitelist)          → E1302

fn pv_is_whitelisted_call(name: Str) -> Int {
    if name == "len" { return 1 }
    if name == "is_empty" { return 1 }
    if name == "unwrap" { return 1 }
    if name == "abs" { return 1 }
    if name == "fabs" { return 1 }
    0
}

fn pv_fn_has_any_effect(name: Str) -> Int {
    let sig = lookup_fnsig(name)
    if sig == -1 { return 0 }
    let fs = fnsig_pool.get(sig).unwrap()
    if fs.effects_count > 0 { return 1 }
    0
}

// Depth counter set transiently when walking the argument(s) of an
// `old(_)` call. Used to reject nested `old(old(_))`.
let mut pv_in_old_depth: Int = 0

fn pv_validate_call_target(call_name: Str, call_node: Int, in_ensures: Int) ! Diag.Report {
    if call_name == "old" {
        if in_ensures == 0 {
            diag_error_at("OldOutsideEnsures", OLD_OUTSIDE_ENSURES, "`old(_)` is only valid inside @ensures predicates", call_node, "move the `old(_)` reference into an @ensures predicate")
        } else if pv_in_old_depth != 0 {
            diag_error_at("OldOutsideEnsures", OLD_OUTSIDE_ENSURES, "`old(_)` may not be nested — `old(old(_))` is not meaningful", call_node, "remove the outer `old(_)`")
        }
        return
    }
    if pv_is_whitelisted_call(call_name) != 0 { return }
    if pv_is_whitelisted_ffi_wrapper(call_name) != 0 { return }
    if tc_fn_is_pure(call_name) != 0 { return }
    if pv_fn_has_any_effect(call_name) != 0 {
        diag_error_at("EffectfulCallInPredicate", EFFECTFUL_CALL_IN_PREDICATE, "predicate calls effectful function '{call_name}' — predicates must be pure", call_node, "call only @pure helpers (or compute the value in the function body)")
        return
    }
    let sig = lookup_fnsig(call_name)
    if sig == -1 { return }
    diag_error_at("ImpureCallInPredicate", IMPURE_CALL_IN_PREDICATE, "predicate calls non-pure function '{call_name}' — predicates may only call @pure helpers or the bootstrap whitelist (len, is_empty, unwrap, abs, fabs)", call_node, "mark '{call_name}' as @pure if it qualifies, or inline the computation")
}

fn pv_walk(expr: Int, in_ensures: Int) ! Diag.Report {
    if expr == -1 { return }
    let k = node_kind(expr)

    // Literals — always fine.
    if k == NodeKind.IntLit { return }
    if k == NodeKind.FloatLit { return }
    if k == NodeKind.BoolLit { return }
    if k == NodeKind.CharLit { return }

    // Strings: literal Str is allowed, but interpolation is a control-flow
    // artifact we don't want in predicates today.
    if k == NodeKind.InterpString {
        diag_error_at("ContractPredicateNotDecidable", CONTRACT_PREDICATE_NOT_DECIDABLE, "interpolated strings are not allowed in contract predicates", expr, "use a plain string literal or move the formatting into the function body")
        return
    }

    // Identifiers — `result` is gated to @ensures, everything else is fine.
    if k == NodeKind.Ident {
        let nm = node_name(expr)
        if nm == "result" {
            if in_ensures == 0 {
                diag_error_at("ResultOutsideEnsures", RESULT_OUTSIDE_ENSURES, "`result` is only valid inside @ensures predicates", expr, "rename the local, or move the reference into @ensures(...)")
            }
        }
        return
    }

    // Operators.
    if k == NodeKind.BinOp {
        pv_walk(node_left(expr), in_ensures)
        pv_walk(node_right(expr), in_ensures)
        return
    }
    if k == NodeKind.UnaryOp {
        pv_walk(node_left(expr), in_ensures)
        return
    }

    // Read-only access.
    if k == NodeKind.FieldAccess {
        pv_walk(node_obj(expr), in_ensures)
        return
    }
    if k == NodeKind.IndexExpr {
        pv_walk(node_obj(expr), in_ensures)
        pv_walk(node_index(expr), in_ensures)
        return
    }

    // Range membership / construction (rhs of `in`).
    if k == NodeKind.RangeLit {
        pv_walk(node_start(expr), in_ensures)
        pv_walk(node_end(expr), in_ensures)
        return
    }

    // If / Match — accepted (per design: SMT can encode as ite).
    if k == NodeKind.IfExpr {
        pv_walk(node_condition(expr), in_ensures)
        pv_walk(node_then_body(expr), in_ensures)
        pv_walk(node_else_body(expr), in_ensures)
        return
    }
    if k == NodeKind.MatchExpr {
        pv_walk(node_scrutinee(expr), in_ensures)
        let arms_sl = node_arms(expr)
        if arms_sl != -1 {
            let mut i = 0
            while i < sublist_length(arms_sl) {
                let arm = sublist_get(arms_sl, i)
                let g = node_guard(arm)
                if g != -1 { pv_walk(g, in_ensures) }
                pv_walk(node_body(arm), in_ensures)
                i = i + 1
            }
        }
        return
    }

    // A bare Block can wrap a single expression; if it contains statements
    // (let, assignment, loops...), the recursive walk will surface the
    // appropriate diagnostic against each child.
    if k == NodeKind.Block {
        let stmts_sl = node_stmts(expr)
        if stmts_sl != -1 {
            let mut i = 0
            while i < sublist_length(stmts_sl) {
                pv_walk(sublist_get(stmts_sl, i), in_ensures)
                i = i + 1
            }
        }
        return
    }

    // Block bodies wrap their tail expression in ExprStmt; descend.
    if k == NodeKind.ExprStmt {
        pv_walk(node_value(expr), in_ensures)
        return
    }

    // Calls. Parser stores callee in `left` (typically an Ident).
    if k == NodeKind.Call {
        let callee = node_left(expr)
        let mut call_name = ""
        if callee != -1 {
            call_name = node_name(callee)
        }
        pv_validate_call_target(call_name, expr, in_ensures)
        let is_old = if call_name == "old" { 1 } else { 0 }
        if is_old != 0 { pv_in_old_depth = pv_in_old_depth + 1 }
        let args_sl = node_args(expr)
        if args_sl != -1 {
            let mut i = 0
            while i < sublist_length(args_sl) {
                pv_walk(sublist_get(args_sl, i), in_ensures)
                i = i + 1
            }
        }
        if is_old != 0 { pv_in_old_depth = pv_in_old_depth - 1 }
        return
    }
    if k == NodeKind.MethodCall {
        let mname = node_method(expr)
        // Method calls bypass the impurity check when on the whitelist
        // (`xs.len()`, `o.unwrap()`, etc.). For everything else we have no
        // way today to know which trait/impl the method resolves to without
        // running full method dispatch — so we accept conservatively and
        // leave precise checking to the @pure registry.
        if pv_is_whitelisted_call(mname) == 0 {
            // Best-effort: if there is a top-level fn with this exact name
            // and it has effects, surface E1301.
            if pv_fn_has_any_effect(mname) != 0 {
                diag_error_at("EffectfulCallInPredicate", EFFECTFUL_CALL_IN_PREDICATE, "predicate calls effectful method '{mname}' — predicates must be pure", expr, "call only @pure helpers (or compute the value in the function body)")
            }
        }
        pv_walk(node_obj(expr), in_ensures)
        let m_args_sl = node_args(expr)
        if m_args_sl != -1 {
            let mut i = 0
            while i < sublist_length(m_args_sl) {
                pv_walk(sublist_get(m_args_sl, i), in_ensures)
                i = i + 1
            }
        }
        return
    }

    // Hard rejections — distinct codes for the structurally-disqualifying
    // forms; everything else funnels into E1300.
    if k == NodeKind.WhileLoop || k == NodeKind.ForIn || k == NodeKind.LoopExpr {
        diag_error_at("LoopInPredicate", LOOP_IN_PREDICATE, "loops are not allowed in contract predicates — predicates must terminate and be quantifier-free", expr, "replace iteration with a recursive @pure helper or a quantifier-free expression")
        return
    }
    if k == NodeKind.Assignment || k == NodeKind.CompoundAssign {
        diag_error_at("AssignmentInPredicate", ASSIGNMENT_IN_PREDICATE, "assignments are not allowed in contract predicates — predicates must be referentially transparent", expr, "rewrite as a pure comparison; bind values outside the predicate if needed")
        return
    }

    // Catch-all: every other shape is outside the decidable subset.
    let kname = node_kind_name(k)
    diag_error_at("ContractPredicateNotDecidable", CONTRACT_PREDICATE_NOT_DECIDABLE, "construct '{kname}' is not allowed in contract predicates — predicates must lie in the SMT-decidable subset", expr, "rewrite the predicate as a pure expression over parameters, comparisons, and @pure calls")
}

fn pv_validate_annotation(ann: Int, in_ensures: Int) ! Diag.Report {
    let args_sl = node_args(ann)
    if args_sl == -1 { return }
    if sublist_length(args_sl) == 0 { return }
    let pred = sublist_get(args_sl, 0)
    pv_in_old_depth = 0
    pv_walk(pred, in_ensures)
}

fn pv_validate_fn_contracts(fn_node: Int) ! Diag.Report {
    let anns_sl = node_handlers(fn_node)
    if anns_sl == -1 { return }
    let mut i = 0
    while i < sublist_length(anns_sl) {
        let ann = sublist_get(anns_sl, i)
        let nm = node_name(ann)
        if nm == "requires" {
            pv_validate_annotation(ann, 0)
        } else if nm == "ensures" {
            pv_validate_annotation(ann, 1)
        } else if nm == "modifies" {
            pv_validate_modifies(ann)
        }
        i = i + 1
    }
}

// Validate that every @modifies argument is a simple path
// (`ident`, `ident.field`, or `nothing`). Reject kv-pair forms.
fn pv_validate_modifies(ann: Int) ! Diag.Report {
    let args_sl = node_args(ann)
    if args_sl == -1 { return }
    let mut i = 0
    while i < sublist_length(args_sl) {
        let arg = sublist_get(args_sl, i)
        let nm = node_name(arg)
        if nm.contains(":") {
            diag_error_at("ModifiesArgNotSimplePath", MODIFIES_ARG_NOT_SIMPLE_PATH,
                "@modifies argument must be a simple path (ident, ident.field, or 'nothing'), got '{nm}'",
                arg, "remove the kv-pair form")
        }
        i = i + 1
    }
}

fn pv_validate_type_alias(td: Int) ! Diag.Report {
    let where_pred = node_condition(td)
    if where_pred == -1 { return }
    pv_walk(where_pred, 0)
}

// ── @pure annotation + minimal purity check ─────────────────────────
//
// `tc_pure_fns` is populated in a first pass over all fns *before* any
// body is walked, so recursive and mutually-recursive @pure fns work.
// `pv_validate_call_target` consults this registry to decide whether a
// non-effectful, non-bootstrap call is allowed in a predicate.

pub let mut tc_pure_fns: Map[Str, Int] = Map()
pub let mut tc_fn_node_by_name: Map[Str, Int] = Map()

pub fn tc_fn_is_pure(name: Str) -> Int {
    if tc_pure_fns.contains_key(name) { return 1 }
    0
}

// True if `name` is a Blink wrapper around a C symbol on the predicate
// bootstrap whitelist (today: just `fabs`). The wrapper is FFI and would
// otherwise be rejected as effectful — the whitelist short-circuits.
fn pv_is_whitelisted_ffi_wrapper(name: Str) -> Int {
    if !tc_fn_node_by_name.contains_key(name) { return 0 }
    let fn_node = tc_fn_node_by_name.get(name).unwrap()
    let ffi_ann = get_annotation(fn_node, "ffi")
    if ffi_ann == -1 { return 0 }
    let args_sl = node_args(ffi_ann)
    if args_sl == -1 { return 0 }
    let mut i = 0
    while i < sublist_length(args_sl) {
        let arg = sublist_get(args_sl, i)
        if node_kind(arg) == NodeKind.InterpString && node_name(arg) == "" {
            let parts_sl = node_elements(arg)
            if parts_sl != -1 && sublist_length(parts_sl) == 1 {
                let part = sublist_get(parts_sl, 0)
                if is_literal_string_part(part) != 0 {
                    let sym = node_str_val(part)
                    if pv_is_whitelisted_call(sym) != 0 { return 1 }
                }
            }
            return 0
        }
        i = i + 1
    }
    0
}

fn pp_is_mutating_method(name: Str) -> Int {
    if name == "push" { return 1 }
    if name == "pop" { return 1 }
    if name == "append" { return 1 }
    if name == "clear" { return 1 }
    if name == "insert" { return 1 }
    if name == "remove" { return 1 }
    if name == "set" { return 1 }
    0
}

fn pp_is_collection_constructor(name: Str) -> Int {
    if name == "List" { return 1 }
    if name == "Map" { return 1 }
    if name == "Set" { return 1 }
    0
}

fn pp_walk(node: Int, fn_name: Str, anchor: Int) ! Diag.Report {
    if node == -1 { return }
    let k = node_kind(node)

    // Reject loops outright — non-terminating constructs.
    if k == NodeKind.WhileLoop || k == NodeKind.ForIn || k == NodeKind.LoopExpr {
        diag_error_at("ImpureBodyForPureAnnotation", IMPURE_BODY_FOR_PURE_ANNOTATION, "@pure function '{fn_name}' contains a loop — @pure forbids while/for/loop", anchor, "remove the loop or drop the @pure annotation")
        return
    }
    // Reject assignments.
    if k == NodeKind.Assignment || k == NodeKind.CompoundAssign {
        diag_error_at("ImpureBodyForPureAnnotation", IMPURE_BODY_FOR_PURE_ANNOTATION, "@pure function '{fn_name}' contains an assignment — @pure forbids mutation", anchor, "rewrite without assignment or drop the @pure annotation")
        return
    }
    // Reject List/Map/Set allocation in literal form.
    if k == NodeKind.ListLit {
        diag_error_at("ImpureBodyForPureAnnotation", IMPURE_BODY_FOR_PURE_ANNOTATION, "@pure function '{fn_name}' allocates a List — @pure forbids List/Map/Set allocation", anchor, "compute on existing inputs or drop the @pure annotation")
        return
    }

    if k == NodeKind.Call {
        let callee = node_left(node)
        let mut call_name = ""
        if callee != -1 { call_name = node_name(callee) }
        if pp_is_collection_constructor(call_name) != 0 {
            diag_error_at("ImpureBodyForPureAnnotation", IMPURE_BODY_FOR_PURE_ANNOTATION, "@pure function '{fn_name}' allocates a '{call_name}' — @pure forbids List/Map/Set allocation", anchor, "compute on existing inputs or drop the @pure annotation")
        } else if pv_fn_has_any_effect(call_name) != 0 {
            diag_error_at("ImpureBodyForPureAnnotation", IMPURE_BODY_FOR_PURE_ANNOTATION, "@pure function '{fn_name}' calls effectful function '{call_name}' — @pure may only call @pure helpers (or len/is_empty/unwrap/abs/fabs)", anchor, "drop the @pure annotation or rewrite without the effectful call")
        } else if pv_is_whitelisted_call(call_name) == 0 && tc_fn_is_pure(call_name) == 0 {
            // Skip if the callee is unresolvable — could be a stdlib helper
            // (e.g. assert) or a builtin we don't track. Only complain when
            // we can prove it's a defined non-pure user function.
            if lookup_fnsig(call_name) != -1 {
                diag_error_at("ImpureBodyForPureAnnotation", IMPURE_BODY_FOR_PURE_ANNOTATION, "@pure function '{fn_name}' calls non-@pure function '{call_name}' — mark it @pure or drop the annotation", anchor, "add @pure to '{call_name}' if it qualifies, or remove @pure from '{fn_name}'")
            }
        }
        // Still recurse into args — a pure-looking call could embed impurity.
        let cargs_sl = node_args(node)
        if cargs_sl != -1 {
            let mut i = 0
            while i < sublist_length(cargs_sl) {
                pp_walk(sublist_get(cargs_sl, i), fn_name, anchor)
                i = i + 1
            }
        }
        return
    }

    if k == NodeKind.MethodCall {
        let mname = node_method(node)
        if pp_is_mutating_method(mname) != 0 {
            diag_error_at("ImpureBodyForPureAnnotation", IMPURE_BODY_FOR_PURE_ANNOTATION, "@pure function '{fn_name}' calls mutating method '.{mname}()' — @pure forbids mutation", anchor, "rewrite without the mutating call or drop the @pure annotation")
        }
        pp_walk(node_obj(node), fn_name, anchor)
        let margs_sl = node_args(node)
        if margs_sl != -1 {
            let mut i = 0
            while i < sublist_length(margs_sl) {
                pp_walk(sublist_get(margs_sl, i), fn_name, anchor)
                i = i + 1
            }
        }
        return
    }

    // Recurse into children. Replicates the structure of pv_walk.
    if k == NodeKind.BinOp {
        pp_walk(node_left(node), fn_name, anchor)
        pp_walk(node_right(node), fn_name, anchor)
        return
    }
    if k == NodeKind.UnaryOp {
        pp_walk(node_left(node), fn_name, anchor)
        return
    }
    if k == NodeKind.FieldAccess {
        pp_walk(node_obj(node), fn_name, anchor)
        return
    }
    if k == NodeKind.IndexExpr {
        pp_walk(node_obj(node), fn_name, anchor)
        pp_walk(node_index(node), fn_name, anchor)
        return
    }
    if k == NodeKind.RangeLit {
        pp_walk(node_start(node), fn_name, anchor)
        pp_walk(node_end(node), fn_name, anchor)
        return
    }
    if k == NodeKind.IfExpr {
        pp_walk(node_condition(node), fn_name, anchor)
        pp_walk(node_then_body(node), fn_name, anchor)
        pp_walk(node_else_body(node), fn_name, anchor)
        return
    }
    if k == NodeKind.MatchExpr {
        pp_walk(node_scrutinee(node), fn_name, anchor)
        let arms_sl = node_arms(node)
        if arms_sl != -1 {
            let mut i = 0
            while i < sublist_length(arms_sl) {
                let arm = sublist_get(arms_sl, i)
                let g = node_guard(arm)
                if g != -1 { pp_walk(g, fn_name, anchor) }
                pp_walk(node_body(arm), fn_name, anchor)
                i = i + 1
            }
        }
        return
    }
    if k == NodeKind.Block {
        let stmts_sl = node_stmts(node)
        if stmts_sl != -1 {
            let mut i = 0
            while i < sublist_length(stmts_sl) {
                pp_walk(sublist_get(stmts_sl, i), fn_name, anchor)
                i = i + 1
            }
        }
        return
    }
    if k == NodeKind.ExprStmt {
        pp_walk(node_value(node), fn_name, anchor)
        return
    }
    if k == NodeKind.LetBinding {
        // `let x = expr` itself is fine; the RHS is the only thing that
        // could carry impurity.
        pp_walk(node_value(node), fn_name, anchor)
        return
    }
    if k == NodeKind.Return {
        pp_walk(node_value(node), fn_name, anchor)
        return
    }
    // Literals + identifiers — leaves, nothing to check.
}

fn tc_register_pure_fns(fns_sl: Int) {
    if fns_sl == -1 { return }
    let mut i = 0
    while i < sublist_length(fns_sl) {
        let fn_node = sublist_get(fns_sl, i)
        let fn_name = node_name(fn_node)
        tc_fn_node_by_name.insert(fn_name, fn_node)
        if has_annotation(fn_node, "pure") != 0 {
            tc_pure_fns.insert(fn_name, 1)
        }
        i = i + 1
    }
}

fn tc_check_pure(fn_node: Int) ! Diag.Report {
    if has_annotation(fn_node, "pure") == 0 { return }
    let fn_name = node_name(fn_node)
    let pure_ann = get_annotation(fn_node, "pure")
    let anchor = if pure_ann != -1 { pure_ann } else { fn_node }

    // Reject @pure on a fn that declares any effects.
    let effects_sl = node_effects(fn_node)
    if effects_sl != -1 && sublist_length(effects_sl) > 0 {
        diag_error_at("ImpureBodyForPureAnnotation", IMPURE_BODY_FOR_PURE_ANNOTATION, "@pure function '{fn_name}' declares effects — @pure forbids declared effects", anchor, "drop the effect declaration or remove @pure")
        return
    }

    let body = node_body(fn_node)
    if body == -1 { return }
    pp_walk(body, fn_name, anchor)
}

fn validate_ffi_fn(fn_node: Int) ! Diag.Report {
    let name = node_name(fn_node)
    let ffi_node = get_annotation(fn_node, "ffi")
    let has_ffi = if ffi_node != -1 { 1 } else { 0 }
    let has_trusted = has_annotation(fn_node, "trusted")
    let requires_node = get_annotation(fn_node, "requires")
    let has_requires = if requires_node != -1 { 1 } else { 0 }
    let ensures_node = get_annotation(fn_node, "ensures")
    let has_ensures = if ensures_node != -1 { 1 } else { 0 }

    if has_ffi != 0 {
        if node_is_pub(fn_node) != 0 && has_trusted == 0 {
            diag_error_at("PubFFI", PUB_FFI, "FFI function '{name}' must not be pub — FFI functions are unsafe and should be wrapped", ffi_node, "remove 'pub' or add @trusted to mark it as audited")
        }
        let effects_sl = node_effects(fn_node)
        if effects_sl == -1 || sublist_length(effects_sl) == 0 {
            diag_error_at("FFINoEffects", FFI_NO_EFFECTS, "FFI function '{name}' must declare effects — FFI calls are side-effectful", ffi_node, "add '! FFI' or appropriate effects to the function signature")
        }
        if has_requires != 0 {
            diag_error_at("ContractOnFFI", CONTRACT_ON_FFI, "@requires cannot be used on FFI function '{name}' — contracts cannot verify foreign code", requires_node, "remove @requires from the FFI function")
        }
        if has_ensures != 0 {
            diag_error_at("ContractOnFFI", CONTRACT_ON_FFI, "@ensures cannot be used on FFI function '{name}' — contracts cannot verify foreign code", ensures_node, "remove @ensures from the FFI function")
        }
        if has_trusted == 0 {
            diag_warn_at("UnauditedFFI", UNAUDITED_FFI, "FFI function '{name}' is not marked @trusted — consider auditing and adding @trusted", ffi_node, "add @trusted after auditing the foreign function")
        }
    }

    // Check Ptr[T] in parameter types
    let params_sl = node_params(fn_node)
    if params_sl != -1 {
        let mut pi = 0
        while pi < sublist_length(params_sl) {
            let p = sublist_get(params_sl, pi)
            let ptype_ann = node_type_ann(p)
            if ptype_ann != -1 {
                check_ptr_in_type_ann(ptype_ann, has_ffi)
            } else {
                check_ptr_in_type_name(node_type_name(p), p, has_ffi)
            }
            pi = pi + 1
        }
    }

    // Check Ptr[T] in return type
    let ret_ann = node_type_ann(fn_node)
    if ret_ann != -1 {
        check_ptr_in_type_ann(ret_ann, has_ffi)
    } else {
        let ret_str = node_return_type(fn_node)
        if ret_str == "Ptr" && has_ffi == 0 {
            diag_error_at("PtrOutsideFFI", PTR_OUTSIDE_FFI, "Ptr[T] type can only be used in @ffi functions or @trusted blocks", fn_node, "add @ffi annotation to the function or wrap usage in @trusted")
        }
    }
}

fn budget_effect_satisfies(budget_eff: Str, fn_eff: Str) -> Int {
    if budget_eff == fn_eff { return 1 }
    if fn_eff.starts_with(budget_eff.concat(".")) { return 1 }
    0
}

fn validate_capabilities_budget(program: Int, fns_sl: Int) ! Diag.Report {
    let cap_node = get_annotation(program, "capabilities")
    if cap_node == -1 { return }
    let mut budget_names: List[Str] = []
    let ann_args_sl = node_args(cap_node)
    if ann_args_sl != -1 {
        let mut ai = 0
        while ai < sublist_length(ann_args_sl) {
            let arg_nd = sublist_get(ann_args_sl, ai)
            budget_names.push(node_name(arg_nd))
            ai = ai + 1
        }
    }
    if fns_sl == -1 { return }
    let mut fi = 0
    while fi < sublist_length(fns_sl) {
        let fn_node = sublist_get(fns_sl, fi)
        let fn_name = node_name(fn_node)
        let fn_mod = node_module(fn_node)
        if fn_name != "main" && !fn_name.starts_with("__test_") && (fn_mod == "__main__") {
            let sig = lookup_fnsig(fn_name)
            if sig != -1 && sig < fnsig_pool.len() {
                let fs = fnsig_pool.get(sig).unwrap()
                let eff_start = fs.effects_start
                let eff_count = fs.effects_count
                let mut ei = 0
                while ei < eff_count {
                    let eff = fnsig_effect_names.get(eff_start + ei).unwrap()
                    let mut allowed = 0
                    let mut bi = 0
                    while bi < budget_names.len() {
                        if budget_effect_satisfies(budget_names.get(bi).unwrap(), eff) != 0 {
                            allowed = 1
                        }
                        bi = bi + 1
                    }
                    if allowed == 0 {
                        diag_error_at("CapabilityBudgetExceeded", CAPABILITY_BUDGET, "function '{fn_name}' uses effect '{eff}' which is not in @capabilities budget", fn_node, "add '{eff}' to @capabilities")
                    }
                    ei = ei + 1
                }
            }
        }
        fi = fi + 1
    }
}

pub fn tc_fn_has_effect(name: Str, eff: Str) -> Int {
    let sig = lookup_fnsig(name)
    if sig == -1 { return 0 }
    let fs = fnsig_pool.get(sig).unwrap()
    let mut i = 0
    while i < fs.effects_count {
        if fnsig_effect_names.get(fs.effects_start + i).unwrap() == eff { return 1 }
        i = i + 1
    }
    0
}

// The built-in method-surface traits are prelude + sealed (nrbq84, §3.2.2 /
// §10.6): user code may neither redefine them nor write an impl of them.
// Single source of truth for both the redefinition check (trait-registration
// loop) and the impl check (validate_trait_impls).
fn is_sealed_builtin_trait(name: Str) -> Int {
    if name == "StrOps" || name == "BytesOps" || name == "StringBuildOps" || name == "Sized" { return 1 }
    if name == "Contains" || name == "ListOps" || name == "MapOps" || name == "SetOps" || name == "Joinable" { return 1 }
    0
}

// A declaration is user-sourced when its module is empty or the synthetic
// main module — the stdlib defs that legitimately back the sealed traits
// carry their dotted module (e.g. "std.traits") during this pass.
fn is_user_sourced(node: Int) -> Int {
    let m = node_module(node)
    if m == "" || m == "__main__" { return 1 }
    0
}

fn register_trait(tr_node: Int) ! TypeCheck.Register {
    let name = node_name(tr_node)
    tc_trait_names.push(name)
    // Collect trait-level type params (e.g., T in trait From[T])
    let tparams_sl = node_type_params(tr_node)
    let tp_start = tc_trait_tparam_names.len()
    let mut tp_count = 0
    if tparams_sl != -1 {
        let mut ti = 0
        while ti < sublist_length(tparams_sl) {
            let tp = sublist_get(tparams_sl, ti)
            tc_trait_tparam_names.push(node_name(tp))
            tp_count = tp_count + 1
            ti = ti + 1
        }
    }
    // wz48pq: record the declared tparam count by trait name for the E0910
    // arity check, independent of whether the trait has any methods.
    tc_trait_tparam_count_idx.insert(name, tp_count)
    let methods_sl = node_methods(tr_node)
    if methods_sl != -1 {
        let mut i = 0
        while i < sublist_length(methods_sl) {
            let m = sublist_get(methods_sl, i)
            let mname = node_name(m)
            tc_trait_method_names.push("{name}.{mname}")
            // Store method signature for contract validation
            let p_start = tc_tmsig_param_names.len()
            let params_sl = node_params(m)
            let mut p_count = 0
            if params_sl != -1 {
                let mut j = 0
                while j < sublist_length(params_sl) {
                    let p = sublist_get(params_sl, j)
                    tc_tmsig_param_names.push(node_type_name(p))
                    p_count = p_count + 1
                    j = j + 1
                }
            }
            tc_tmsig_pool.push(TraitMethodSigEntry { trait_name: name, method: mname, ret: node_return_type(m), tparams_start: tp_start, tparams_count: tp_count, params_start: p_start, params_count: p_count })
            i = i + 1
        }
    }
    let assoc_sl = node_assoc_types(tr_node)
    if assoc_sl != -1 {
        let mut ai = 0
        while ai < sublist_length(assoc_sl) {
            let at_node = sublist_get(assoc_sl, ai)
            let aname = node_name(at_node)
            tc_trait_assoc_names.push("{name}.{aname}")
            ai = ai + 1
        }
    }
}

fn subst_trait_type(type_str: Str, impl_type: Str, tmsig_idx: Int, impl_node: Int) -> Str {
    if type_str == "Self" { return impl_type }
    if type_str.starts_with("Self.") {
        let assoc_name = type_str.substring(5, type_str.len() - 5)
        let assoc_sl = node_assoc_types(impl_node)
        if assoc_sl != -1 {
            let mut ai = 0
            while ai < sublist_length(assoc_sl) {
                let at_node = sublist_get(assoc_sl, ai)
                if node_name(at_node) == assoc_name {
                    return node_type_name(at_node)
                }
                ai = ai + 1
            }
        }
        return type_str
    }
    let _tmsig = tc_tmsig_pool.get(tmsig_idx).unwrap()
    let tp_start = _tmsig.tparams_start
    let tp_count = _tmsig.tparams_count
    if tp_count > 0 {
        let impl_targs_sl = node_type_params(impl_node)
        let mut k = 0
        while k < tp_count {
            let tp_name = tc_trait_tparam_names.get(tp_start + k).unwrap()
            if type_str == tp_name {
                if impl_targs_sl != -1 && k < sublist_length(impl_targs_sl) {
                    return node_name(sublist_get(impl_targs_sl, k))
                }
            }
            k = k + 1
        }
    }
    type_str
}

// True when `name` is declared as a binder in the impl's `impl[T, ...]` list.
fn impl_binder_declared(binders_sl: Int, name: Str) -> Int {
    if binders_sl == -1 { return 0 }
    let mut i = 0
    while i < sublist_length(binders_sl) {
        if node_name(sublist_get(binders_sl, i)) == name {
            return 1
        }
        i = i + 1
    }
    0
}

// True when `name` appears anywhere inside a type annotation tree
// (the annotation's own name, its element args, or a fn return ann).
fn type_ann_mentions(ann: Int, name: Str) -> Int {
    if ann == -1 { return 0 }
    if node_name(ann) == name { return 1 }
    let elems = node_elements(ann)
    if elems != -1 {
        let mut i = 0
        while i < sublist_length(elems) {
            if type_ann_mentions(sublist_get(elems, i), name) != 0 {
                return 1
            }
            i = i + 1
        }
    }
    let ret_ann = node_type_ann(ann)
    if ret_ann != -1 {
        if type_ann_mentions(ret_ann, name) != 0 { return 1 }
    }
    0
}

// True when `name` is mentioned by any type annotation in `args_sl`.
fn type_args_mention(args_sl: Int, name: Str) -> Int {
    if args_sl == -1 { return 0 }
    let mut i = 0
    while i < sublist_length(args_sl) {
        if type_ann_mentions(sublist_get(args_sl, i), name) != 0 {
            return 1
        }
        i = i + 1
    }
    0
}

// Report E0507-style unknown-name errors for each type argument in `args_sl`
// that is neither a declared impl binder, a known type, nor a trait name.
// `where` distinguishes the trait-args site from the receiver-args site.
fn check_impl_type_arg_names(args_sl: Int, binders_sl: Int, trait_name: Str, where: Str, im: Int) ! Diag.Report {
    if args_sl == -1 { return }
    let mut i = 0
    while i < sublist_length(args_sl) {
        let arg_name = node_name(sublist_get(args_sl, i))
        if arg_name != "" && impl_binder_declared(binders_sl, arg_name) == 0 && is_known_type(arg_name) == 0 && is_trait_name(arg_name) == 0 {
            if where == "receiver" {
                diag_error_at("UnknownType", UNKNOWN_TYPE, "unknown type '{arg_name}' in receiver of impl '{trait_name}'", im, "receiver type arguments must be concrete types or names declared in 'impl[...]' binders")
            } else {
                diag_error_at("UnknownType", UNKNOWN_TYPE, "unknown type '{arg_name}' in impl '{trait_name}'", im, "trait type arguments must be concrete types; for a polymorphic impl write 'impl[{arg_name}] {trait_name}[{arg_name}] for ReceiverType[{arg_name}]'")
            }
        }
        i = i + 1
    }
}

fn validate_trait_impls(program: Int) ! TypeCheck.Register, Diag.Report {
    let impls_sl = node_methods(program)
    if impls_sl == -1 { return }
    let mut ii = 0
    while ii < sublist_length(impls_sl) {
        let im = sublist_get(impls_sl, ii)
        let trait_name = node_trait_name(im)
        let impl_type = node_name(im)
        if is_trait_name(trait_name) == 0 {
            diag_error_at("TraitContract", TRAIT_CONTRACT_904, "trait '{trait_name}' is not defined", im, "check the trait name or define 'trait {trait_name} \{ ... }'")
            ii = ii + 1
            continue
        }
        if is_sealed_builtin_trait(trait_name) != 0 && is_user_sourced(im) != 0 {
            diag_error_at("TraitContract", TRAIT_CONTRACT_907, "trait '{trait_name}' is a sealed built-in trait and cannot be implemented for user types", im, "define your own trait with the methods you need and impl that instead")
            ii = ii + 1
            continue
        }
        let binders_sl = node_impl_binders(im)
        let recv_args_sl = node_recv_type_args(im)
        let trait_args_sl = node_type_params(im)
        // A binder declared after `impl` must appear somewhere in the header's
        // type positions (trait args or receiver args); otherwise nothing can
        // ever determine what it stands for.
        if binders_sl != -1 {
            let mut bi = 0
            while bi < sublist_length(binders_sl) {
                let bname = node_name(sublist_get(binders_sl, bi))
                let mut used = type_args_mention(trait_args_sl, bname)
                if used == 0 { used = type_args_mention(recv_args_sl, bname) }
                if used == 0 {
                    diag_error_at("ImplBinderUnused", IMPL_BINDER_UNUSED, "impl binder '{bname}' is not used in the impl header", im, "use '{bname}' in the trait's or the receiver's type arguments, or remove the binder")
                }
                bi = bi + 1
            }
        }
        // Unknown outer names in trait_type_args would otherwise slip past the
        // single-letter carve-out in nr_check_type_ref and silently lower to
        // `void` in codegen. Names declared as impl binders are bound (§3.6)
        // and excluded.
        check_impl_type_arg_names(trait_args_sl, binders_sl, trait_name, "trait", im)
        check_impl_type_arg_names(recv_args_sl, binders_sl, trait_name, "receiver", im)
        // Polymorphic impl headers parse (spec §3.6). The impl binders make `T`
        // a free type var that the contract check below resolves positionally
        // (Self == receiver base, trait tparam name == binder name), so the
        // method-contract / Display / assoc-type checks run for poly impls too.
        // Codegen monomorphization is tracked under project b1bdnh; the E0908
        // gate is emitted after those checks (so a malformed poly impl reports
        // both its specific contract error and E0908) to block codegen.
        let is_poly = if binders_sl != -1 || recv_args_sl != -1 { 1 } else { 0 }
        // ms4ctb: ONLY the canonical builtin form `impl[T] Trait[T] for List[T]`
        // — exactly one impl binder, a List receiver with exactly one type arg,
        // and that type arg IS the binder — is monomorphized in codegen, so it
        // must NOT trip E0908. Codegen assumes the single binder is the List's
        // element type, so any other shape must still be rejected: multi-binder
        // impls (`impl[T,U] Trait[T] for List[U]` would mis-map both binders to
        // the element), binders without a receiver type-arg (Holder), receiver
        // args without binders (Box[Int]), concrete `List[Int]`, user generic
        // structs (Box[T]), and Map/Set receivers.
        let mut poly_supported = 0
        if binders_sl != -1 && recv_args_sl != -1 && impl_type == "List" {
            if sublist_length(binders_sl) == 1 && sublist_length(recv_args_sl) == 1 {
                let binder_name = node_name(sublist_get(binders_sl, 0))
                let recv_arg_name = node_name(sublist_get(recv_args_sl, 0))
                if binder_name != "" && recv_arg_name == binder_name {
                    poly_supported = 1
                }
            }
        }
        // 9jq7qx: a wrong trait-arg count would leave a trait tparam unbound, so
        // subst_trait_type below returns its raw name and the per-param check
        // prints a bogus `expected 'U'`. Report a dedicated arity error instead
        // and skip the per-param comparison (trait_arg_arity_ok) so no unbound
        // name leaks.
        // wz48pq: the count comes from the trait DECLARATION (register_trait
        // records node_type_params by name), not from tc_tmsig_pool -- a
        // methodless trait has no sig entry, so the old per-method scan left
        // trait_tparam_count at -1 and silently skipped the arity check.
        let trait_tparam_count = tc_trait_tparam_count_idx.get(trait_name) ?? -1
        let mut supplied_trait_args = 0
        if trait_args_sl != -1 {
            supplied_trait_args = sublist_length(trait_args_sl)
        }
        let mut trait_arg_arity_ok = 1
        if trait_tparam_count >= 0 && supplied_trait_args != trait_tparam_count {
            trait_arg_arity_ok = 0
            diag_error_at("TraitContract", TRAIT_ARG_ARITY, "impl of trait '{trait_name}' supplies {supplied_trait_args} type argument(s) but '{trait_name}' declares {trait_tparam_count}", im, "supply one type argument per trait type parameter: 'impl {trait_name}[...] for {impl_type}'")
        }
        // 4q2etk: replaced by mwxtyj — Display.display is a synthesized sealed
        // method (decision 344dnd): the compiler derives it from the impl's
        // `fmt`, so a user impl may not define it. The remaining contract
        // checks below still run (a missing `fmt` also reports E0900).
        if trait_name == "Display" {
            let disp_methods_sl = node_methods(im)
            if disp_methods_sl != -1 {
                let mut dmi = 0
                while dmi < sublist_length(disp_methods_sl) {
                    let dm = sublist_get(disp_methods_sl, dmi)
                    if node_name(dm) == "display" {
                        diag_error_at("SealedMethodOverride", SEALED_METHOD_OVERRIDE, "method 'display' of trait 'Display' is sealed and cannot be overridden — it is synthesized from 'fmt'", dm, "implement 'fn fmt(self, sb: StringBuilder)' and remove 'display'; 'display()' is generated from 'fmt'")
                    }
                    dmi = dmi + 1
                }
            }
        }
        // Check each trait method signature against this impl
        let impl_methods_sl = node_methods(im)
        let mut si = 0
        while si < tc_tmsig_pool.len() {
            let tmsig = tc_tmsig_pool.get(si).unwrap()
            if tmsig.trait_name == trait_name {
                let expected_method = tmsig.method
                let mut found = 0
                let mut mi = 0
                if impl_methods_sl != -1 {
                    while mi < sublist_length(impl_methods_sl) {
                        let impl_m = sublist_get(impl_methods_sl, mi)
                        if node_name(impl_m) == expected_method {
                            found = 1
                            // Check arity
                            let trait_pcount = tmsig.params_count
                            let impl_params_sl = node_params(impl_m)
                            let mut impl_pcount = 0
                            if impl_params_sl != -1 {
                                impl_pcount = sublist_length(impl_params_sl)
                            }
                            if trait_pcount != impl_pcount {
                                diag_error_at("TraitContract", TRAIT_CONTRACT_901, "method '{expected_method}' in impl {trait_name} for {impl_type} has {impl_pcount} params, expected {trait_pcount}", impl_m, "trait requires {trait_pcount} parameters (including self)")
                            } else if trait_arg_arity_ok != 0 {
                                // Skipped when the impl's trait-arg arity is
                                // wrong (E0910 already reported): subst_trait_type
                                // would otherwise leak an unbound trait tparam
                                // name into the expected type (9jq7qx).
                                // Check param types
                                let tp_start = tmsig.params_start
                                let mut pi = 0
                                while pi < trait_pcount {
                                    let trait_ptype = tc_tmsig_param_names.get(tp_start + pi).unwrap()
                                    if trait_ptype != "" {
                                        let impl_p = sublist_get(impl_params_sl, pi)
                                        let raw_impl_ptype = node_type_name(impl_p)
                                        let impl_ptype = if raw_impl_ptype == "Self" { impl_type } else { raw_impl_ptype }
                                        let expected_type = subst_trait_type(trait_ptype, impl_type, si, im)
                                        if impl_ptype != expected_type {
                                            diag_error_at("TraitContract", TRAIT_CONTRACT_902, "method '{expected_method}' param has type '{impl_ptype}', expected '{expected_type}'", impl_p, "change type to '{expected_type}' to match trait {trait_name}")
                                        }
                                    }
                                    pi = pi + 1
                                }
                                // Check return type
                                let trait_ret = tmsig.ret
                                if trait_ret != "" {
                                    let raw_impl_ret = node_return_type(impl_m)
                                    let impl_ret = if raw_impl_ret == "Self" { impl_type } else { raw_impl_ret }
                                    let expected_ret = subst_trait_type(trait_ret, impl_type, si, im)
                                    if impl_ret != expected_ret {
                                        diag_error_at("TraitContract", TRAIT_CONTRACT_903, "method '{expected_method}' returns '{impl_ret}', expected '{expected_ret}'", impl_m, "change return type to '{expected_ret}' to match trait {trait_name}")
                                    }
                                }
                            }
                            break
                        }
                        mi = mi + 1
                    }
                }
                if found == 0 {
                    diag_error_at("TraitContract", TRAIT_CONTRACT_900, "impl {trait_name} for {impl_type} is missing method '{expected_method}'", im, "add 'fn {expected_method}(...)' to the impl block")
                }
            }
            si = si + 1
        }
        let impl_assoc_sl = node_assoc_types(im)
        let mut ati = 0
        while ati < tc_trait_assoc_names.len() {
            let full_name = tc_trait_assoc_names.get(ati).unwrap()
            if full_name.starts_with("{trait_name}.") {
                let expected_assoc = full_name.substring(trait_name.len() + 1, full_name.len() - trait_name.len() - 1)
                let mut found_assoc = 0
                if impl_assoc_sl != -1 {
                    let mut aj = 0
                    while aj < sublist_length(impl_assoc_sl) {
                        let at_node = sublist_get(impl_assoc_sl, aj)
                        if node_name(at_node) == expected_assoc {
                            found_assoc = 1
                            break
                        }
                        aj = aj + 1
                    }
                }
                if found_assoc == 0 {
                    diag_error_at("TraitContract", TRAIT_CONTRACT_905, "impl {trait_name} for {impl_type} is missing associated type '{expected_assoc}'", im, "add 'type {expected_assoc} = ...' to the impl block")
                }
            }
            ati = ati + 1
        }
        if is_poly != 0 && poly_supported == 0 {
            diag_error_at("PolyImplUnsupported", POLY_IMPL_UNSUPPORTED, "polymorphic impls are not yet compiled", im, "spec §3.6 defines 'impl[T] {trait_name}[T] for Recv[T]', but compiled support is still in progress (project b1bdnh); write a separate impl per concrete type for now")
        }
        let conflict_trait = if trait_name == "BlockHandler" { "Closeable" } else if trait_name == "Closeable" { "BlockHandler" } else { "" }
        if conflict_trait != "" {
            let mut ci = 0
            while ci < sublist_length(impls_sl) {
                let other = sublist_get(impls_sl, ci)
                if node_trait_name(other) == conflict_trait && node_name(other) == impl_type {
                    diag_error_at("TraitContract", TRAIT_CONTRACT_906, "type '{impl_type}' cannot implement both Closeable and BlockHandler (ambiguous with-block semantics)", im, "remove one of the impl blocks")
                    break
                }
                ci = ci + 1
            }
        }
        ii = ii + 1
    }
}

// ── Main entry point ────────────────────────────────────────────────

fn init_types() ! TypeCheck.Register {
    ty_pool.clear()
    ty_param_list.clear()
    // Load-bearing for the daemon/LSP (long-lived processes, daemon.bl / lsp.bl): a
    // surviving intern map would hand out tids keyed against the PREVIOUS, since-cleared
    // pool on the next check_types() call — out-of-bounds unwrap panic or a silently
    // wrong shared type. tests/test_v76b0b_ty_pool_interns_compounds.bl Half D is the
    // only test shape that can catch a dropped clear here (task test forks per file).
    ty_intern.clear()
    tc_node_tid.clear()
    tc_ret_mint_start.clear()
    let mut nti = 0
    while nti < node_count() {
        tc_node_tid.push(-1)
        tc_ret_mint_start.push(-1)
        nti = nti + 1
    }
    tc_ret_mint_tids.clear()
    named_type_names.clear()
    named_type_ids.clear()
    named_type_map.clear()
    tc_hashable_types.clear()
    tc_debug_types.clear()
    tc_type_decl_nodes.clear()
    tc_alias_underlying = Map()
    sfield_pool.clear()
    nr_callable_field_names.clear()
    evar_pool.clear()
    evfield_pool.clear()
    fnsig_pool.clear()
    fnsig_map.clear()
    fnsig_param_list.clear()
    fnsig_type_param_names.clear()
    fnsig_tparam_ret_only.clear()
    fnsig_effect_names.clear()
    tc_trait_names.clear()
    tc_trait_method_names.clear()
    tc_trait_assoc_names.clear()
    tc_display_impl_types.clear()
    tc_method_trait_count_idx.clear()
    tc_method_trait_names_idx.clear()
    tc_poly_list_impl_node.clear()
    tc_tmsig_pool.clear()
    tc_tmsig_param_names.clear()
    tc_trait_tparam_names.clear()
    tc_trait_tparam_count_idx.clear()
    tc_current_fn_ret = -1
    tc_current_fn_name = ""
    tc_current_self_tid = -1
    tc_current_method_sig_key = ""
    tc_in_closure_depth = 0
    tc_fn_body_block = 0
    tc_suppress_ann_validation = 0
    tc_structural_nested_instances = 0
    tc_boundary_check_active = 0
    tc_errors.clear()
    depr_fn_nodes.clear()
    depr_type_nodes.clear()
    tc_struct_decl_nodes.clear()
    tc_variant_enum_decl_nodes.clear()
    tc_collision_reported.clear()
    ffi_struct_type_set.clear()
    tc_symbol_module.clear()
    tc_module_let_tid.clear()
    tc_prelude_free_fn.clear()
    tc_used_modules.clear()
    tc_hints.clear()
    tc_pure_fns.clear()
    tc_fn_node_by_name.clear()
    pv_in_old_depth = 0
    tc_build_import_map()

    TYPE_INT = new_type(TyKind.Int, "Int")
    TYPE_FLOAT = new_type(TyKind.Float, "Float")
    TYPE_BOOL = new_type(TyKind.Bool, "Bool")
    TYPE_STR = new_type(TyKind.Str, "Str")
    TYPE_VOID = new_type(TyKind.Void, "Void")
    TYPE_UNKNOWN = new_type(TyKind.Unknown, "?")
    TYPE_I8 = new_type(TyKind.I8, "I8")
    TYPE_I16 = new_type(TyKind.I16, "I16")
    TYPE_I32 = new_type(TyKind.I32, "I32")
    TYPE_U8 = new_type(TyKind.U8, "U8")
    TYPE_U16 = new_type(TyKind.U16, "U16")
    TYPE_U32 = new_type(TyKind.U32, "U32")
    TYPE_U64 = new_type(TyKind.U64, "U64")
    TYPE_CHAR = new_type(TyKind.Char, "Char")
}

pub fn check_types(program: Int) -> Int ! TypeCheck, Diag.Report {
    if trace_mode != "" { trace("typecheck", "start") }
    init_types()

    // Register all type definitions (structs and enums)
    let types_sl = node_fields(program)
    if types_sl != -1 {
        let mut i = 0
        while i < sublist_length(types_sl) {
            let td = sublist_get(types_sl, i)
            let td_flds = node_fields(td)
            let mut is_enum = 0
            if td_flds != -1 && sublist_length(td_flds) > 0 {
                if node_kind(sublist_get(td_flds, 0)) == NodeKind.TypeVariant {
                    is_enum = 1
                }
            }
            if is_enum != 0 {
                register_enum_type(td)
            } else {
                register_struct_type(td)
            }
            i = i + 1
        }
    }

    // Kind A: a struct name equal to an enum variant name is a hard error (E0518).
    // Detected over the whole-program symbol table (catches cross-module collisions).
    tc_check_name_collisions()

    // @derive(Debug) requires every user-type field to also derive Debug.
    tc_check_derive_debug()

    // @derive(Hash/Eq/Ord) requires every field's type to implement that trait
    // (spec §3.6.6 NonDerivableTrait, E1401).
    tc_check_derive_hash_eq_ord()

    // Register all function signatures
    let fns_sl = node_params(program)
    if fns_sl != -1 {
        let mut i = 0
        while i < sublist_length(fns_sl) {
            register_fn_sig(sublist_get(fns_sl, i))
            i = i + 1
        }
    }

    // Validate FFI annotations and Ptr[T] usage
    if fns_sl != -1 {
        let mut i = 0
        while i < sublist_length(fns_sl) {
            validate_ffi_fn(sublist_get(fns_sl, i))
            i = i + 1
        }
    }

    // Build the @pure registry first so the predicate validator can
    // consult it when a contract calls a user helper.
    if fns_sl != -1 {
        tc_register_pure_fns(fns_sl)
    }

    // Validate contract predicates against the SMT-decidable subset.
    // Runs before name resolution so reserved names (`result`, `old`)
    // surface as E1304/E1305 rather than as generic E0506/E0504.
    if fns_sl != -1 {
        let mut i = 0
        while i < sublist_length(fns_sl) {
            pv_validate_fn_contracts(sublist_get(fns_sl, i))
            i = i + 1
        }
    }
    if types_sl != -1 {
        let mut i = 0
        while i < sublist_length(types_sl) {
            pv_validate_type_alias(sublist_get(types_sl, i))
            i = i + 1
        }
    }

    // Enforce @pure body constraints.
    if fns_sl != -1 {
        let mut i = 0
        while i < sublist_length(fns_sl) {
            tc_check_pure(sublist_get(fns_sl, i))
            i = i + 1
        }
    }

    validate_capabilities_budget(program, fns_sl)

    // Build symbol-to-module map for unused import detection
    if types_sl != -1 {
        let mut i = 0
        while i < sublist_length(types_sl) {
            let td = sublist_get(types_sl, i)
            let mod_name = node_module(td)
            if mod_name != "" && mod_name != "__main__" {
                tc_symbol_module.insert(node_name(td), mod_name)
                let td_flds = node_fields(td)
                if td_flds != -1 {
                    let mut j = 0
                    while j < sublist_length(td_flds) {
                        let fld = sublist_get(td_flds, j)
                        if node_kind(fld) == NodeKind.TypeVariant {
                            tc_symbol_module.insert(node_name(fld), mod_name)
                        }
                        j = j + 1
                    }
                }
            }
            i = i + 1
        }
    }
    if fns_sl != -1 {
        let mut i = 0
        while i < sublist_length(fns_sl) {
            let fn_node = sublist_get(fns_sl, i)
            let mod_name = node_module(fn_node)
            if mod_name != "" && mod_name != "__main__" {
                let fn_sym_name = node_name(fn_node)
                tc_symbol_module.insert(fn_sym_name, mod_name)
                // A free function defined in a prelude module is NOT auto-visible
                // (§3.2.3) — record it so a bare call lacking an explicit import
                // is rejected (nr_is_unimported_prelude_free_fn, fsmwz2).
                if tc_prelude_modules.contains_key(mod_name) {
                    tc_prelude_free_fn.insert(fn_sym_name, 1)
                }
                match tc_original_to_alias.get(fn_sym_name) {
                    Some(alias) => tc_symbol_module.insert(alias, mod_name)
                    None => {}
                }
            }
            i = i + 1
        }
    }
    let lets_sl_sym = node_stmts(program)
    if lets_sl_sym != -1 {
        let mut i = 0
        while i < sublist_length(lets_sl_sym) {
            let l = sublist_get(lets_sl_sym, i)
            let mod_name = node_module(l)
            if mod_name != "" && mod_name != "__main__" {
                tc_symbol_module.insert(node_name(l), mod_name)
            }
            i = i + 1
        }
    }

    // Register traits
    let traits_sl = node_arms(program)
    if traits_sl != -1 {
        let mut i = 0
        while i < sublist_length(traits_sl) {
            let tr = sublist_get(traits_sl, i)
            if is_sealed_builtin_trait(node_name(tr)) != 0 && is_user_sourced(tr) != 0 {
                diag_error_at("TraitContract", TRAIT_CONTRACT_907, "trait '{node_name(tr)}' is a sealed built-in trait and cannot be redefined", tr, "rename your trait, or define your own trait with the methods you need")
            }
            register_trait(tr)
            i = i + 1
        }
    }
    // Register builtin trait names (handled specially in codegen, no AST nodes)
    tc_trait_names.push("From")
    tc_trait_names.push("TryFrom")
    tc_trait_names.push("Into")
    tc_trait_names.push("Iterator")
    tc_trait_names.push("IntoIterator")
    // wz48pq: these builtins are single-tparam (From[T], Into[T], ...); record
    // their arity so E0910 fires for impls that supply the wrong count. From/
    // Into/TryFrom are also declared in lib/std/traits.bl and pass through
    // register_trait -- the Map is keyed by name so last-write-wins agrees (1).
    tc_trait_tparam_count_idx.insert("From", 1)
    tc_trait_tparam_count_idx.insert("TryFrom", 1)
    tc_trait_tparam_count_idx.insert("Into", 1)
    tc_trait_tparam_count_idx.insert("Iterator", 1)
    tc_trait_tparam_count_idx.insert("IntoIterator", 1)

    // Register impl method signatures
    let impls_sl = node_methods(program)
    if impls_sl != -1 {
        let mut i = 0
        while i < sublist_length(impls_sl) {
            let im = sublist_get(impls_sl, i)
            let impl_type = node_name(im)
            let trait_name = node_trait_name(im)
            // 9myrp2: register the canonical monomorphized poly impl
            // `impl[T] Trait[T] for List[T]` for binder recovery in the
            // MethodCall arm. Same shape gate as validate_trait_impls'
            // poly_supported (typecheck.bl ~3122): List receiver, exactly one
            // impl binder, exactly one receiver type arg, and that arg IS the
            // binder. Any other shape never registers, so the arm falls through.
            if impl_type == "List" {
                let pl_binders = node_impl_binders(im)
                let pl_recv_args = node_recv_type_args(im)
                if pl_binders != -1 && pl_recv_args != -1 {
                    if sublist_length(pl_binders) == 1 && sublist_length(pl_recv_args) == 1 {
                        let pl_binder_name = node_name(sublist_get(pl_binders, 0))
                        let pl_recv_arg_name = node_name(sublist_get(pl_recv_args, 0))
                        if pl_binder_name != "" && pl_recv_arg_name == pl_binder_name {
                            let pl_methods = node_methods(im)
                            if pl_methods != -1 {
                                let mut pmi = 0
                                while pmi < sublist_length(pl_methods) {
                                    let pl_mname = node_name(sublist_get(pl_methods, pmi))
                                    tc_poly_list_impl_node.insert("List_{trait_name}_{pl_mname}", im)
                                    pmi = pmi + 1
                                }
                            }
                        }
                    }
                }
            }
            // 4q2etk: replaced by mwxtyj — record Display impls so infer_type
            // can resolve the synthesized display() to Str.
            if trait_name == "Display" {
                tc_display_impl_types.push(impl_type)
                // The synthesized sealed `display()` makes `display` resolvable
                // on this type; record it as a Display-owned method so a foreign
                // trait's `display` registers as a second owner (sb3125/bsn3s9).
                tc_record_method_trait(impl_type, "display", "Display")
            }
            let methods_sl = node_methods(im)
            if methods_sl != -1 {
                let mut j = 0
                while j < sublist_length(methods_sl) {
                    let m = sublist_get(methods_sl, j)
                    let orig_name = node_name(m)
                    // From/TryFrom keep their source-typed symbol scheme; all
                    // other impl methods register under the trait-qualified key
                    // so two traits sharing a method name don't overwrite.
                    let mangled = tc_mangle_impl_fnsig(impl_type, trait_name, orig_name, im)
                    tc_record_method_trait(impl_type, orig_name, trait_name)
                    node_set_name(m, mangled)
                    register_fn_sig(m)
                    node_set_name(m, orig_name)
                    j = j + 1
                }
            }
            i = i + 1
        }
    }

    // Validate trait impl contracts
    validate_trait_impls(program)

    // The signatures of the namespace intrinsics codegen emits directly (br qjfwc6).
    register_ns_intrinsic_sigs()

    // The signatures of the methods @derive synthesizes (br nxnnxe). AFTER the user fn and
    // impl-method registrations above, so a key a program spells for itself is never taken
    // over — see register_derive_method_sig.
    register_derive_method_sigs(program)

    // Register user-defined effect handle names, and the SIGNATURE of every operation
    // they declare (br h3q81d). The handle name alone only suppresses the UnknownMethod
    // warning; without the signatures `db.query(..)` has no return type and its
    // arguments are compared against nothing.
    tc_ue_handles = []
    let effects_decl_sl = node_args(program)
    if effects_decl_sl != -1 {
        let mut ei = 0
        while ei < sublist_length(effects_decl_sl) {
            let ed = sublist_get(effects_decl_sl, ei)
            let eff_name = node_name(ed)
            register_ue_handle(str_to_lower(eff_name))
            register_ue_op_sigs(ed)
            ei = ei + 1
        }
    }

    // Build symbol-to-module map (continued): impls, traits, effects
    if impls_sl != -1 {
        let mut i = 0
        while i < sublist_length(impls_sl) {
            let im = sublist_get(impls_sl, i)
            let mod_name = node_module(im)
            if mod_name != "" && mod_name != "__main__" {
                let impl_type = node_name(im)
                let trait_name = node_trait_name(im)
                tc_symbol_module.insert(impl_type, mod_name)
                let methods_sl_sym = node_methods(im)
                if methods_sl_sym != -1 {
                    let mut j = 0
                    while j < sublist_length(methods_sl_sym) {
                        let m = sublist_get(methods_sl_sym, j)
                        tc_symbol_module.insert(tc_mangle_impl_fnsig(impl_type, trait_name, node_name(m), im), mod_name)
                        j = j + 1
                    }
                }
            }
            i = i + 1
        }
    }
    if traits_sl != -1 {
        let mut i = 0
        while i < sublist_length(traits_sl) {
            let tr = sublist_get(traits_sl, i)
            let mod_name = node_module(tr)
            if mod_name != "" && mod_name != "__main__" {
                tc_symbol_module.insert(node_name(tr), mod_name)
            }
            i = i + 1
        }
    }
    let effects_sl_sym = node_args(program)
    if effects_sl_sym != -1 {
        let mut i = 0
        while i < sublist_length(effects_sl_sym) {
            let ed = sublist_get(effects_sl_sym, i)
            let mod_name = node_module(ed)
            if mod_name != "" && mod_name != "__main__" {
                tc_symbol_module.insert(node_name(ed), mod_name)
            }
            i = i + 1
        }
    }

    // Remap tc_symbol_module for pub import re-exports
    tc_apply_reexport_remapping()

    // Phase 1: Name resolution
    resolve_names(program)
    nr_warn_unused = 0

    // Phase 2: Expression type inference
    tc_infer_program(program)

    if trace_mode != "" { trace("typecheck", "done ({tc_errors.len()} errors)") }
    tc_errors.len()
}

// ── User-effect handle name tracking ────────────────────────────────

let mut tc_ue_handles: List[Str] = []

fn register_ue_handle(name: Str) {
    tc_ue_handles.push(name)
}

// br h3q81d. Register one fnsig per effect operation, keyed `{handle}.{op}` — the same
// key the call site spells, and the same handle (`str_to_lower(effect name)`) both sides
// already agree on. Ops live only under a sub-effect: `parse_effect_decl` (parser.bl:1554)
// demands `effect` for every member of the outer body, so `node_elements(ed)` ->
// `node_methods(child)` is the whole set, exactly the walk codegen makes at
// codegen.bl:750-760 to fill its UeMethod registry.
//
// An op node is a real `NodeKind.FnDef` (`parse_effect_op_sig`, parser.bl:1516) carrying
// params, `return_type` and the whole `type_ann` tree, so `register_fn_sig` types it with
// no special case — which is the point: codegen needs EIGHT flat return fields for the
// same information because `Result[Option[Row], DBError]` is depth 2, and one tid holds it.
//
// The name is swapped for the qualified key and restored, as the impl-method path does at
// tc_infer_program; registering under the bare op name would collide with any free function
// of that name. Annotation validation is suppressed: the op's types are validated where the
// effect is DECLARED, and a consuming module that never selectively imported `Row` must not
// be told about it here (the same reason tc_impl_self_tid suppresses it).
@allow(UnrestoredMutation)
fn register_ue_op_sigs(ed: Int) ! TypeCheck.Register, TypeCheck.Resolve, Diag.Report {
    let handle = str_to_lower(node_name(ed))
    let children_sl = node_elements(ed)
    if children_sl == -1 { return }
    let saved_suppress = tc_suppress_ann_validation
    tc_suppress_ann_validation = 1
    let mut ci = 0
    while ci < sublist_length(children_sl) {
        let ops_sl = node_methods(sublist_get(children_sl, ci))
        if ops_sl != -1 {
            let mut oi = 0
            while oi < sublist_length(ops_sl) {
                let op = sublist_get(ops_sl, oi)
                let op_name = node_name(op)
                node_set_name(op, "{handle}.{op_name}")
                register_fn_sig(op)
                node_set_name(op, op_name)
                oi = oi + 1
            }
        }
        ci = ci + 1
    }
    tc_suppress_ann_validation = saved_suppress
}

fn is_user_effect_handle_name(name: Str) -> Int {
    let mut i = 0
    while i < tc_ue_handles.len() {
        if tc_ue_handles.get(i).unwrap() == name {
            return 1
        }
        i = i + 1
    }
    0
}

// ── Selective import filtering ──────────────────────────────────────
pub let mut tc_import_modules: List[Str] = []
pub let mut tc_import_qualifiers: List[Str] = []
pub let mut tc_import_nodes: List[Int] = []
let mut tc_module_import_node: Map[Str, Int] = Map()
let mut tc_qualifier_to_module: Map[Str, Str] = Map()
let mut tc_import_modules_idx: Map[Str, Int] = Map()
let mut tc_import_qualifiers_set: Map[Str, Int] = Map()

// ── Pub import re-export tracking ──────────────────────────────────
// Key: "reexporting_mod:item_name" → source module name (selective re-exports)
// Key: "reexporting_mod:*:source_mod" → source module name (wildcard re-exports)
pub let mut tc_reexport_source: Map[Str, Str] = Map()
pub let mut tc_reexport_modules: Map[Str, Int] = Map()

fn tc_apply_reexport_remapping() {
    let keys = tc_reexport_source.keys()
    let mut i = 0
    while i < keys.len() {
        let key = keys.get(i).unwrap()
        let colon_idx = key.index_of(":")
        if colon_idx > 0 {
            let reexporter = key.substring(0, colon_idx)
            let rest = key.substring(colon_idx + 1, key.len() - colon_idx - 1)
            if rest.starts_with("*:") {
                let source_mod = rest.substring(2, rest.len() - 2)
                let sym_keys = tc_symbol_module.keys()
                let mut si = 0
                while si < sym_keys.len() {
                    let sym = sym_keys.get(si).unwrap()
                    if tc_symbol_module.get(sym).unwrap() == source_mod {
                        tc_symbol_module.insert(sym, reexporter)
                    }
                    si = si + 1
                }
            } else {
                let item_name = rest
                match tc_symbol_module.get(item_name) {
                    Some(current_mod) => {
                        let source_mod = tc_reexport_source.get(key).unwrap()
                        if current_mod == source_mod {
                            tc_symbol_module.insert(item_name, reexporter)
                        }
                    }
                    None => {}
                }
            }
        }
        i = i + 1
    }
}

fn tc_build_import_map() {
    tc_module_import_node = Map()
    tc_qualifier_to_module = Map()
    tc_alias_to_original = Map()
    tc_original_to_alias = Map()
    tc_import_modules_idx = Map()
    tc_import_qualifiers_set = Map()
    let mut i = 0
    while i < tc_import_modules.len() {
        let mod_key = tc_import_modules.get(i).unwrap()
        tc_import_modules_idx.insert(mod_key, i)
        let node_id = tc_import_nodes.get(i).unwrap()
        if i < tc_import_qualifiers.len() {
            let qual = tc_import_qualifiers.get(i).unwrap()
            if qual != "" && qual != mod_key {
                tc_qualifier_to_module.insert(qual, mod_key)
            }
            if qual != "" {
                tc_import_qualifiers_set.insert(qual, 1)
            }
        }
        if node_id != -1 {
            tc_module_import_node.insert(mod_key, node_id)
            let names_sl = node_args(node_id)
            if names_sl != -1 {
                let mut j = 0
                while j < sublist_length(names_sl) {
                    let name_node = sublist_get(names_sl, j)
                    let alias = node_str_val(name_node)
                    if alias != "" {
                        let original = node_name(name_node)
                        tc_alias_to_original.insert(alias, original)
                        tc_original_to_alias.insert(original, alias)
                    }
                    j = j + 1
                }
            }
        }
        i = i + 1
    }
}

fn is_selected_import(name: Str, imp_node: Int) -> Int {
    let names_sl = node_args(imp_node)
    if names_sl == -1 { return 0 }
    let mut i = 0
    while i < sublist_length(names_sl) {
        let name_node = sublist_get(names_sl, i)
        if node_name(name_node) == name { return 1 }
        let alias = node_str_val(name_node)
        if alias != "" && alias == name { return 1 }
        i = i + 1
    }
    0
}

pub fn is_import_module_name(name: Str) -> Int {
    if tc_import_modules_idx.contains_key(name) { return 1 }
    if tc_import_qualifiers_set.contains_key(name) { return 1 }
    0
}

fn tc_get_dotted_module_path(mod_key: Str) -> Str {
    match tc_module_import_node.get(mod_key) {
        Some(imp_node) => {
            let dotted = node_str_val(imp_node)
            if dotted != "" {
                return dotted
            }
        }
        None => {}
    }
    mod_key
}

fn is_filtered_for_module(name: Str, source_mod: Str, consuming_mod: Str) -> Int {
    if source_mod == consuming_mod { return 0 }
    if source_mod == "" || source_mod == "__main__" { return 0 }
    if consuming_mod == "" { return 0 }
    let key = "{consuming_mod}:{source_mod}"
    match per_module_imports.get(key) {
        Some(imp_node) => {
            if imp_node == -1 { return 1 }
            return is_selected_import(name, imp_node) == 0
        }
        None => {}
    }
    0
}

// True when `name` is a free function exported by a prelude module that the
// current module did NOT explicitly import. The prelude contributes
// compiler-known types/traits/impls unconditionally, but its free functions
// require an explicit `import` (§3.2.3) — a bare call to one is an undefined
// reference (E0504, §6.3.5), NOT an ImportNotSelected. (fsmwz2)
fn nr_is_unimported_prelude_free_fn(name: Str) -> Int {
    // Only prelude-module free fns are recorded here, so membership already
    // implies the source is a prelude module.
    if tc_prelude_free_fn.contains_key(name) == 0 { return 0 }
    let source_mod = match tc_symbol_module.get(name) {
        Some(v) => v
        None => return 0
    }
    if nr_current_module == source_mod { return 0 }
    // An explicit import (bare or selective-including-name) makes it visible.
    let key = "{nr_current_module}:{source_mod}"
    match per_module_imports.get(key) {
        Some(imp_node) => {
            if imp_node == -1 { return 0 }
            if is_selected_import(name, imp_node) != 0 { return 0 }
        }
        None => {}
    }
    1
}

fn is_builtin_name(name: Str) -> Int {
    if is_primitive_type(name) != 0 { return 1 }
    if is_builtin_fn(name) != 0 { return 1 }
    0
}

fn tc_qualifier_for_module(mod_key: Str) -> Str {
    match tc_import_modules_idx.get(mod_key) {
        Some(idx) => {
            if idx < tc_import_qualifiers.len() {
                let q = tc_import_qualifiers.get(idx).unwrap()
                if q != "" {
                    return q
                }
            }
            return mod_key
        }
        None => {}
    }
    mod_key
}

// Inverse of tc_qualifier_for_module: an import qualifier (the leaf the user
// writes before `.`, e.g. "libc") -> the module key stored in tc_symbol_module
// values (e.g. "std_libc"). Falls back to the qualifier when no alias mapping
// exists (qual == key).
pub fn tc_qualifier_to_module_or_self(qualifier: Str) -> Str {
    match tc_qualifier_to_module.get(qualifier) {
        Some(mod_name) => mod_name
        None => qualifier
    }
}

fn nr_check_selective_access(name: Str, node: Int) -> Int ! Diag.Report {
    if nr_current_module == "" { return 0 }
    if is_builtin_name(name) != 0 { return 0 }
    let source_mod = match tc_symbol_module.get(name) {
        Some(v) => v
        None => return 0
    }
    if is_filtered_for_module(name, source_mod, nr_current_module) != 0 {
        let display_mod = tc_qualifier_for_module(source_mod)
        if node == -1 {
            diag_error_no_loc("ImportNotSelected", IMPORT_NOT_SELECTED, "'{name}' is not in scope — add it to the import list or use qualified access '{display_mod}.{name}'", "add '{name}' to your selective import")
        } else {
            diag_error_at("ImportNotSelected", IMPORT_NOT_SELECTED, "'{name}' is not in scope — add it to the import list or use qualified access '{display_mod}.{name}'", node, "add '{name}' to your selective import")
        }
        return 1
    }
    0
}

// ── Import visibility ───────────────────────────────────────────────

let mut nr_private_imports: Map[Str, Str] = Map()
let mut nr_current_module: Str = ""
let mut nr_name_source_module: Map[Str, Str] = Map()

fn nr_check_ambiguity(name: Str, mod_name: Str, local_names: Map[Str, Int]) ! Diag.Report {
    if mod_name == "" || mod_name == "__main__" { return }
    if nr_private_imports.contains_key(name) { return }
    if local_names.contains_key(name) { return }
    match nr_name_source_module.get(name) {
        Some(existing_mod) => {
            if existing_mod != mod_name && existing_mod != "__main__" {
                diag_error_no_loc("AmbiguousImport", AMBIGUOUS_IMPORT, "name '{name}' is ambiguous — imported from both '{existing_mod}' and '{mod_name}'", "use selective imports to disambiguate, e.g. import {existing_mod}.\{name}")
            }
        }
        None => nr_name_source_module.insert(name, mod_name)
    }
}

fn is_private_access(name: Str) -> Int {
    // Builtin names (primitive types + builtin fns/variants like Ok/Err/Some/Map)
    // can never be private — a user cannot make a builtin private, so a colliding
    // user variant must not poison the verdict. Mirrors nr_check_selective_access.
    if is_builtin_name(name) != 0 { return 0 }
    let mods = match nr_private_imports.get(name) {
        Some(v) => v
        None => return 0
    }
    if mods.contains("|{nr_current_module}|") != 0 { return 0 }
    1
}

// Emit E1003 PrivateItemAccess for `name` on `node`, choosing the noun
// (variant / type / trait / function) the same way the bare-Ident handler does,
// so a qualified access (mod.Name) is labelled identically to a bare one.
// Caller must have already checked is_private_access(name) != 0.
fn nr_emit_private_access(name: Str, node: Int) ! Diag.Report {
    if is_variant_name(name) != 0 {
        tc_errors.push("cannot access private variant '{name}'")
        diag_error_at("PrivateItemAccess", PRIVATE_ITEM_ACCESS, "cannot access private variant '{name}' from another module", node, "mark the enum as 'pub' in its module")
    } else if is_known_type(name) != 0 {
        tc_errors.push("cannot access private type '{name}'")
        diag_error_at("PrivateItemAccess", PRIVATE_ITEM_ACCESS, "cannot access private type '{name}' from another module", node, "mark the type as 'pub' in its module")
    } else if is_trait_name(name) != 0 {
        tc_errors.push("cannot access private trait '{name}'")
        diag_error_at("PrivateItemAccess", PRIVATE_ITEM_ACCESS, "cannot access private trait '{name}' from another module", node, "mark the trait as 'pub' in its module")
    } else {
        tc_errors.push("cannot access private function '{name}'")
        diag_error_at("PrivateItemAccess", PRIVATE_ITEM_ACCESS, "cannot access private function '{name}' from another module", node, "mark the function as 'pub' in its module")
    }
}

fn nr_register_private(name: Str, mod_name: Str) {
    match nr_private_imports.get(name) {
        Some(prev) => nr_private_imports.insert(name, "{prev}{mod_name}|")
        None => nr_private_imports.insert(name, "|{mod_name}|")
    }
}

// ── Name resolution scope ───────────────────────────────────────────

let mut nr_scope_names: List[Str] = []
let mut nr_scope_muts: List[Int] = []
let mut nr_scope_types: List[Int] = []
let mut nr_scope_reads: List[Int] = []
let mut nr_scope_writes: List[Int] = []
let mut nr_scope_nodes: List[Int] = []
// Sticky-read flag: if set, nr_mark_written won't clear the read flag. Used
// for vars captured by a closure — subsequent writes are observable through
// closure calls, so the original read shouldn't be dismissed as "dead".
let mut nr_scope_captured: List[Int] = []
// Shadow chain: nr_scope_prev[i] is the index of the previous entry with the
// same name (the one this entry shadows), or -1 if none. Lets nr_pop_scope
// restore nr_name_top to the prior binding without a linear scan.
let mut nr_scope_prev: List[Int] = []
// Top-of-stack index per name: O(1) lookup for nr_is_defined / nr_is_mut /
// nr_get_type / nr_mark_written. Keys absent ⇒ name not currently in scope.
let mut nr_name_top: Map[Str, Int] = Map()
let mut nr_scope_frames: List[Int] = []
let mut nr_scope_depth: Int = 0
let mut nr_loop_depth: Int = 0
let mut nr_in_closure_depth: Int = 0
let mut nr_with_ptr_depth: Int = 0
let mut nr_warn_unused: Int = 0
// gqg3rk: the E0301 region-boundary check must run ONLY in the type-inference
// pass (tc_check_fn/tc_check_body), where annotations are honored (final_tid =
// declared_tid) and constraining uses have pinned their metavars. The earlier
// name-resolution pass (nr_check_fn/nr_check_node) shares nr_pop_scope but stores
// the raw *inferred* RHS type ignoring annotations — so `let m: Map[Str,Int] =
// Map()` carries an unpinned α there and would false-positive. Gate on this flag.
let mut tc_boundary_check_active: Int = 0

// Push a new entry into the parallel scope arrays and update nr_name_top.
// All nr_define* functions must route through here to keep the shadow chain
// intact. The .insert at the end overwrites any prior nr_name_top entry by
// design — we captured the displaced index in nr_scope_prev so pop can
// restore it.
fn nr_scope_push_entry(name: Str, is_mut: Int, tid: Int, node: Int) {
    let new_idx = nr_scope_names.len()
    let mut prev = -1
    match nr_name_top.get(name) {
        Some(p) => prev = p
        None => {}
    }
    nr_scope_names.push(name)
    nr_scope_muts.push(is_mut)
    nr_scope_types.push(tid)
    nr_scope_reads.push(0)
    nr_scope_writes.push(1)
    nr_scope_nodes.push(node)
    nr_scope_captured.push(0)
    nr_scope_prev.push(prev)
    nr_name_top.insert(name, new_idx)
}

fn nr_push_scope() {
    nr_scope_frames.push(nr_scope_names.len())
    nr_scope_depth = nr_scope_depth + 1
}

fn nr_pop_scope() ! Diag.Report {
    if nr_scope_frames.len() == 0 {
        return
    }
    let start = nr_scope_frames.get(nr_scope_frames.len() - 1).unwrap()
    nr_scope_frames.pop()
    let emit_unused = nr_warn_unused != 0 && nr_scope_depth > 1
    // Fused loop: emit unused-variable warnings AND restore nr_name_top AND
    // pop the parallel arrays in a single back-to-front pass over [start, len).
    while nr_scope_names.len() > start {
        let idx = nr_scope_names.len() - 1
        let nm = nr_scope_names.get(idx).unwrap()
        if emit_unused {
            if nr_scope_reads.get(idx).unwrap() == 0 && nm.len() > 0 && nm.byte_at(0) != 95 { // '_'
                let nd = nr_scope_nodes.get(idx).unwrap()
                if nd != -1 {
                    if nr_scope_writes.get(idx).unwrap() > 1 {
                        diag_warn_at("SetButNotRead", SET_BUT_NOT_READ, "variable '{nm}' is assigned a value that is never read", nd, "remove the unused assignment, or prefix with '_' to suppress")
                    } else {
                        diag_warn_at("UnusedVariable", UNUSED_VARIABLE, "variable '{nm}' is never read", nd, "prefix with '_' to suppress this warning")
                    }
                }
            }
        }
        // Region boundary (gqg3rk): the scope is closing in the INFERENCE pass and
        // every constraining use in it has already run (tc_check_body is a single
        // interleaved walk), so a binding still carrying an unbound metavar is
        // genuinely under-determined → error[CannotInferType] (E0301). Gated on
        // tc_boundary_check_active so the earlier annotation-blind name-resolution
        // pass never fires it. The shared singleton TYPE_UNKNOWN never trips this
        // (tc_is_unbound_metavar excludes it), so only unpinned empty-ctor bindings
        // are reported.
        //
        // "Every constraining use has already run" only became true for a fn body's
        // IMPLICIT TAIL in br r9krgr. The declared return type is a constraining use
        // (sections/03_types.md:1031) and it used to be applied by tc_check_fn AFTER
        // this pop, so this check reported E0301 on bindings the declared return would
        // have solved. tc_check_body's Block arm now pins ahead of the pop. Any future
        // constraint source for a fn body must land on that same side of this line.
        if tc_boundary_check_active != 0 {
            if tc_tid_has_unbound_metavar(nr_scope_types.get(idx).unwrap()) != 0 {
                tc_report_under_determined(nm, nr_scope_types.get(idx).unwrap(), nr_scope_nodes.get(idx).unwrap())
            }
        }
        let prev = nr_scope_prev.get(idx).unwrap()
        if prev == -1 {
            nr_name_top.remove(nm)
        } else {
            nr_name_top.insert(nm, prev)
        }
        nr_scope_names.pop()
        nr_scope_muts.pop()
        nr_scope_types.pop()
        nr_scope_reads.pop()
        nr_scope_writes.pop()
        nr_scope_nodes.pop()
        nr_scope_captured.pop()
        nr_scope_prev.pop()
    }
    nr_scope_depth = nr_scope_depth - 1
}

fn nr_define(name: Str) {
    nr_scope_push_entry(name, 0, TYPE_UNKNOWN, -1)
}

fn nr_check_shadow(name: Str, node: Int) ! Diag.Report {
    if nr_warn_unused == 0 { return }
    if name.len() == 0 { return }
    if name.byte_at(0) == 95 { return } // '_'
    if nr_scope_depth <= 1 { return }
    if nr_scope_frames.len() == 0 { return }
    let frame_start = nr_scope_frames.get(nr_scope_frames.len() - 1).unwrap()
    // Walk the shadow chain from the newest entry back to the first one
    // that lives outside this frame — that's the shadowed outer binding.
    let mut idx = -1
    match nr_name_top.get(name) {
        Some(t) => idx = t
        None => return
    }
    while idx >= frame_start {
        idx = nr_scope_prev.get(idx).unwrap()
        if idx == -1 { return }
    }
    // A local binding that "shadows" a same-named top-level symbol from a
    // DIFFERENT module is not a real lexical shadow — it's a cross-module name
    // collision (e.g. a stdlib param colliding with a user's top-level free
    // fn). Suppress W0603 only in that case (br xfbezd). A genuine same-module
    // top-level shadow (a function-local rebinding a module-level let/fn) still
    // warns.
    if nr_scope_frames.len() >= 2 {
        let first_inner = nr_scope_frames.get(1).unwrap()
        if idx < first_inner {
            let sym_mod = tc_get_symbol_module(name)
            if sym_mod != "" && sym_mod != nr_current_module { return }
            // User top-level symbols (module __main__) are intentionally never
            // recorded in tc_symbol_module (see the mod_name != "__main__" guards
            // at registration), so their module reads back as "". When we're
            // checking inside a real non-main module body (e.g. a stdlib fn's
            // closure param), an unknown outer-symbol module can only be a
            // user/__main__ global — a DIFFERENT module from the current one, so
            // it's the same cross-module collision, not a lexical shadow. Suppress.
            if sym_mod == "" && nr_current_module != "" && nr_current_module != "__main__" { return }
        }
    }
    diag_warn_at("ShadowedVariable", SHADOWED_VARIABLE, "variable '{name}' shadows a variable from an outer scope", node, "rename the variable or prefix with '_' to suppress")
}

fn nr_define_at(name: Str, node: Int) ! Diag.Report {
    if node != -1 && nr_current_module != "" {
        node_set_module(node, nr_current_module)
    }
    nr_check_shadow(name, node)
    nr_scope_push_entry(name, 0, TYPE_UNKNOWN, node)
}

fn nr_define_mut(name: Str, is_mut: Int) {
    nr_scope_push_entry(name, is_mut, TYPE_UNKNOWN, -1)
}

fn nr_define_mut_at(name: Str, is_mut: Int, node: Int) ! Diag.Report {
    if node != -1 && nr_current_module != "" {
        node_set_module(node, nr_current_module)
    }
    nr_check_shadow(name, node)
    nr_scope_push_entry(name, is_mut, TYPE_UNKNOWN, node)
}

fn nr_define_typed(name: Str, is_mut: Int, tid: Int) {
    nr_scope_push_entry(name, is_mut, tid, -1)
}

// Like nr_define_typed but records the binding's decl node (gqg3rk): the E0301
// region-boundary check needs a span to point the diagnostic at. Used by the
// inference-pass LetBinding, whose `node` is the `let` itself.
fn nr_define_typed_at(name: Str, is_mut: Int, tid: Int, node: Int) {
    nr_scope_push_entry(name, is_mut, tid, node)
}

// match-with-return per arm (instead of `let x = match { ... }` as an
// expression) is a workaround for a codegen issue where binding a match
// expression whose arms `return` from the enclosing fn produces wrong C.
// Applies to nr_is_mut / nr_get_type / nr_check_shadow below too.
fn nr_is_defined(name: Str) -> Int {
    match nr_name_top.get(name) {
        Some(i) => {
            nr_scope_reads.set(i, 1)
            // If the read happens inside a closure body, the capture may be
            // observed on a later call — don't let subsequent writes in the
            // enclosing scope cancel this read (W0601 false positive).
            if nr_in_closure_depth > 0 {
                // Only mark entries in enclosing scopes (outside the closure
                // frame) as captured. Locals inside the closure are walked
                // the normal way.
                let mut frame_start = 0
                if nr_scope_frames.len() > 0 {
                    frame_start = nr_scope_frames.get(nr_scope_frames.len() - 1).unwrap()
                }
                if i < frame_start {
                    nr_scope_captured.set(i, 1)
                }
            }
            return 1
        }
        None => {}
    }
    0
}

// mjsbwm: does `name` have ANY binding in scope right now? nr_is_defined's answer without
// its side effects — that one marks nr_scope_reads (and nr_scope_captured inside a closure),
// which is how W0310/W0601 decide a variable was used. An inference-time question like "is
// this method receiver a value rather than a type name?" must not count as a read, or asking
// it would silence the unused-variable warnings for every name it asks about. Same
// pure-inspection contract as nr_top_binding_is_global below.
fn nr_has_binding(name: Str) -> Int {
    if nr_name_top.contains_key(name) { return 1 }
    0
}

// Whether `name`'s current top binding lives in the global frame (depth 1).
// A cross-module private-access violation can only legitimately apply to a
// real top-level free-fn/let reference (global frame); when a name resolves to
// an inner frame (a param/local that merely shadows a same-named private
// top-level symbol in another module) it is NOT a cross-module access, so
// E1003 must not fire (br xfbezd). Pure inspection — must not call
// nr_is_defined (which has read/capture side effects).
fn nr_top_binding_is_global(name: Str) -> Int {
    let idx = match nr_name_top.get(name) {
        Some(i) => i
        None => return 0
    }
    if nr_scope_frames.len() < 2 {
        return 1
    }
    let first_inner = nr_scope_frames.get(1).unwrap()
    if idx < first_inner { 1 } else { 0 }
}

fn nr_is_mut(name: Str) -> Int {
    match nr_name_top.get(name) {
        Some(i) => return nr_scope_muts.get(i).unwrap()
        None => {}
    }
    0
}

fn nr_mark_written(name: Str, _node: Int) ! Diag.Report {
    match nr_name_top.get(name) {
        Some(i) => {
            if nr_loop_depth == 0 && nr_scope_captured.get(i).unwrap() == 0 {
                nr_scope_reads.set(i, 0)
            }
            nr_scope_writes.set(i, nr_scope_writes.get(i).unwrap() + 1)
        }
        None => {}
    }
}

fn nr_get_type(name: Str) -> Int {
    match nr_name_top.get(name) {
        Some(i) => return nr_scope_types.get(i).unwrap()
        None => {}
    }
    TYPE_UNKNOWN
}

fn nr_set_last_type(tid: Int) {
    if nr_scope_types.len() > 0 {
        nr_scope_types.set(nr_scope_types.len() - 1, tid)
    }
}

// §2.20 test-only symbol allowlist. Append future test-only symbols here
// (e.g. assert_panics) — membership means the symbol may only be called inside
// a literal 'test { ... }' block (tc_in_test_body == 1). This predicate is the
// single source of truth for *which* symbols are fenced; the *fence itself*
// (tc_fence_test_only_symbol) is shared. A new symbol whose Call has its own
// signature/arg-count checks still needs its own `if fn_name == ...` dispatch
// branch in infer_type that calls tc_fence_test_only_symbol with its code —
// the list-append removes fence duplication, not the per-symbol dispatch.
fn is_test_only_symbol(name: Str) -> Int {
    if name == "skip" { return 1 }
    0
}

// Shared fence for §2.20 test-only symbols. `code`/`short_name` are
// parameterized so a future symbol (assert_panics) can fence with E0833.
// tc_in_test_lexical is 1 inside the test block AND inside closures lexically
// within it — testing.for_each's case body relies on this; it is 0 in a
// regular fn, so calling a test-only symbol from a helper fn is fenced even
// when that helper is reachable from a test. This asks a purely LEXICAL
// question, which is why it is not tc_in_test_body: that flag is reset by the
// closure walkers for `?` elaboration (spec §3c.2) and would fence every
// test-only symbol inside a walked closure body (br pgc3d9).
fn tc_fence_test_only_symbol(name: Str, code: Str, short_name: Str, node: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if is_test_only_symbol(name) != 0 && tc_in_test_lexical == 0 {
        diag_error_at(short_name, code,
            "{name}() can only be called inside a test body",
            node, "move the call into a 'test \{ ... }' block")
    }
}

// pub so codegen resolves a CALL callee in the same order this file does: builtin
// first, user variant second. A payload-less variant named `Map` must not shadow the
// `Map()` constructor, and the only way that ordering cannot drift between the two
// phases is for both to read this one list (br t1apwa).
pub fn is_builtin_fn(name: Str) -> Int {
    if name == "arg_count" { return 1 }
    if name == "get_arg" { return 1 }
    if name == "read_file" { return 1 }
    if name == "write_file" { return 1 }
    if name == "file_exists" { return 1 }
    if name == "shell_exec" { return 1 }
    if name == "exit" { return 1 }
    if name == "is_dir" { return 1 }

    if name == "time_ms" { return 1 }
    if name == "Some" { return 1 }
    if name == "None" { return 1 }
    if name == "Ok" { return 1 }
    if name == "Err" { return 1 }
    if name == "assert" { return 1 }
    if name == "assert_eq" { return 1 }
    if name == "assert_ne" { return 1 }
    if name == "debug_assert" { return 1 }
    if name == "Map" { return 1 }
    if name == "Set" { return 1 }
    if name == "Bytes" { return 1 }
    if name == "Channel" { return 1 }
    if name == "StringBuilder" { return 1 }
    if name == "unix_socket_listen" { return 1 }
    if name == "unix_socket_connect" { return 1 }
    if name == "unix_socket_accept" { return 1 }
    if name == "unix_socket_accept_timeout" { return 1 }
    if name == "unix_socket_close" { return 1 }
    if name == "socket_read_line" { return 1 }
    if name == "socket_write" { return 1 }
    if name == "file_mtime" { return 1 }
    if name == "getpid" { return 1 }
    if name == "process_run" { return 1 }
    if name == "process_run_with_stdin" { return 1 }
    if name == "process_exec" { return 1 }
    if name == "process_spawn" { return 1 }
    if name == "process_pid_wait" { return 1 }
    if name == "process_pid_kill" { return 1 }
    if name == "process_pid_send_signal" { return 1 }
    if name == "process_install_signal_forwarding" { return 1 }
    if name == "alloc_ptr" { return 1 }
    if name == "null_ptr" { return 1 }
    if name == "Raw" { return 1 }
    if name == "skip" { return 1 }
    0
}

fn is_builtin_method(name: Str) -> Int {
    // 4q2etk: replaced by mwxtyj — Display: synthesized display() and
    // builtin scalar fmt()/display() (Int/Float/Bool/Str/Char)
    if name == "display" { return 1 }
    if name == "fmt" { return 1 }
    // String methods
    if name == "len" { return 1 }
    if name == "contains" { return 1 }
    if name == "starts_with" { return 1 }
    if name == "ends_with" { return 1 }
    if name == "concat" { return 1 }
    if name == "slice" { return 1 }
    if name == "to_int" { return 1 }
    if name == "split" { return 1 }
    if name == "char_at" { return 1 }
    // br rbd0a4. `charAt` is deliberately NOT here. It was the only mention of that spelling in
    // the whole compiler — no codegen arm, no stdlib function, and zero uses across src/, lib/,
    // tests/ and examples/ — so its only effect was to suppress the UnknownMethod warning for a
    // method that does not exist, leaving the user with a hard UnresolvedMethod at codegen and no
    // earlier signal. This list claims a method EXISTS (it also gates the :388 resolution check),
    // so a name with nothing behind it belongs out of it, not given a return type.
    if name == "byte_at" { return 1 }
    if name == "substring" { return 1 }
    if name == "substr" { return 1 }
    if name == "index_of" { return 1 }
    if name == "trim" { return 1 }
    if name == "trim_right" { return 1 }
    if name == "trim_left" { return 1 }
    if name == "to_lower" { return 1 }
    if name == "to_upper" { return 1 }
    if name == "replace" { return 1 }
    if name == "as_cstr" { return 1 }
    if name == "lines" { return 1 }
    if name == "parse_float" { return 1 }
    if name == "parse_int" { return 1 }
    // List methods
    if name == "push" { return 1 }
    if name == "pop" { return 1 }
    if name == "get" { return 1 }
    if name == "set" { return 1 }
    if name == "join" { return 1 }
    if name == "clear" { return 1 }
    // Iterator methods
    if name == "map" { return 1 }
    if name == "filter" { return 1 }
    if name == "collect" { return 1 }
    if name == "count" { return 1 }
    if name == "for_each" { return 1 }
    if name == "any" { return 1 }
    if name == "all" { return 1 }
    if name == "find" { return 1 }
    if name == "fold" { return 1 }
    if name == "take" { return 1 }
    if name == "skip" { return 1 }
    if name == "chain" { return 1 }
    if name == "flat_map" { return 1 }
    if name == "enumerate" { return 1 }
    if name == "zip" { return 1 }
    // Map methods
    if name == "contains_key" { return 1 }
    if name == "remove" { return 1 }
    if name == "clear" { return 1 }
    if name == "keys" { return 1 }
    if name == "values" { return 1 }
    // Set methods
    if name == "insert" { return 1 }
    if name == "union" { return 1 }
    // Ptr methods
    if name == "deref" { return 1 }
    if name == "is_null" { return 1 }
    if name == "addr" { return 1 }
    if name == "offset" { return 1 }
    // FFI scope methods
    if name == "alloc" { return 1 }
    if name == "alloc_n" { return 1 }
    if name == "cstr" { return 1 }
    // Bytes methods
    if name == "with_ptr" { return 1 }
    if name == "is_empty" { return 1 }
    if name == "to_str" { return 1 }
    if name == "to_hex" { return 1 }
    if name == "from_str" { return 1 }
    if name == "from_code_point" { return 1 }
    if name == "read_u16_be" { return 1 }
    if name == "read_u32_be" { return 1 }
    if name == "read_i32_be" { return 1 }
    if name == "read_i64_be" { return 1 }
    if name == "read_u16_le" { return 1 }
    if name == "read_u32_le" { return 1 }
    if name == "read_i32_le" { return 1 }
    if name == "read_i64_le" { return 1 }
    if name == "write_u16_be" { return 1 }
    if name == "write_u32_be" { return 1 }
    if name == "write_i32_be" { return 1 }
    if name == "write_i64_be" { return 1 }
    if name == "write_u16_le" { return 1 }
    if name == "write_u32_le" { return 1 }
    if name == "write_i32_le" { return 1 }
    if name == "write_i64_le" { return 1 }
    // Effect handle methods (io, fs, net, time, async, env)
    if name == "println" { return 1 }
    if name == "print" { return 1 }
    if name == "eprintln" { return 1 }
    if name == "eprint" { return 1 }
    if name == "log" { return 1 }
    if name == "print_raw" { return 1 }
    if name == "eprint_raw" { return 1 }
    if name == "read" { return 1 }
    if name == "write" { return 1 }
    if name == "list_dir" { return 1 }
    if name == "args" { return 1 }
    // Env effect methods
    if name == "var" { return 1 }
    if name == "cwd" { return 1 }
    if name == "set_var" { return 1 }
    if name == "remove_var" { return 1 }
    if name == "sleep" { return 1 }
    if name == "spawn" { return 1 }
    // Net methods
    if name == "request" { return 1 }
    if name == "listen" { return 1 }
    if name == "accept" { return 1 }
    if name == "read_line" { return 1 }
    if name == "read_n" { return 1 }
    if name == "read_bytes" { return 1 }
    if name == "write_bytes" { return 1 }
    if name == "write_line" { return 1 }
    if name == "close" { return 1 }
    if name == "post" { return 1 }
    if name == "put" { return 1 }
    if name == "patch" { return 1 }
    if name == "head" { return 1 }
    if name == "delete" { return 1 }
    // Channel methods
    if name == "send" { return 1 }
    if name == "recv" { return 1 }
    // Conversion methods
    if name == "into" { return 1 }
    if name == "to_float" { return 1 }
    if name == "to_string" { return 1 }
    if name == "from" { return 1 }
    if name == "try_from" { return 1 }
    // Sized int conversion methods
    if name == "to_i8" { return 1 }
    if name == "to_i16" { return 1 }
    if name == "to_i32" { return 1 }
    if name == "to_u8" { return 1 }
    if name == "to_u16" { return 1 }
    if name == "to_u32" { return 1 }
    if name == "to_u64" { return 1 }
    // Sized int wrapping arithmetic
    if name == "wrapping_add" { return 1 }
    if name == "wrapping_sub" { return 1 }
    if name == "wrapping_mul" { return 1 }
    if name == "wrapping_div" { return 1 }
    if name == "wrapping_rem" { return 1 }
    if name == "wrapping_neg" { return 1 }
    // Int methods
    if name == "abs" { return 1 }
    if name == "min" { return 1 }
    if name == "max" { return 1 }
    // Option methods
    if name == "unwrap" { return 1 }
    if name == "is_some" { return 1 }
    if name == "is_none" { return 1 }
    // Result methods
    if name == "unwrap_err" { return 1 }
    if name == "is_ok" { return 1 }
    if name == "is_err" { return 1 }
    // Instant methods
    if name == "elapsed" { return 1 }
    if name == "since" { return 1 }
    if name == "add" { return 1 }
    if name == "to_rfc3339" { return 1 }
    if name == "to_unix_ms" { return 1 }
    if name == "to_unix_secs" { return 1 }
    // Duration static constructors
    if name == "nanos" { return 1 }
    if name == "ms" { return 1 }
    if name == "seconds" { return 1 }
    if name == "minutes" { return 1 }
    if name == "hours" { return 1 }
    // Duration methods
    if name == "to_ms" { return 1 }
    if name == "to_seconds" { return 1 }
    if name == "to_nanos" { return 1 }
    if name == "sub" { return 1 }
    if name == "scale" { return 1 }
    if name == "is_zero" { return 1 }
    // StringBuilder methods
    if name == "clear" { return 1 }
    if name == "write_char" { return 1 }
    if name == "capacity" { return 1 }
    // 7cq6w2: emit_sb_method's sibling constructor (codegen_methods.bl:2590) — omitted
    // here, so `StringBuilder.with_capacity(8)` drew a W0501 for a method the compiler
    // has always been able to emit.
    if name == "with_capacity" { return 1 }
    // Bytes/Instant static constructors
    if name == "new" { return 1 }
    if name == "zeroed" { return 1 }
    if name == "from_epoch_secs" { return 1 }
    // ffi.scope() intrinsic namespace constructor (with-resource only)
    if name == "scope" { return 1 }
    // Template methods
    if name == "parts" { return 1 }
    if name == "count" { return 1 }
    if name == "type_tag" { return 1 }
    if name == "get_str" { return 1 }
    if name == "get_int" { return 1 }
    if name == "get_float" { return 1 }
    if name == "get_bool" { return 1 }
    0
}

fn get_builtin_fn_ret(name: Str) -> Int {
    if name == "arg_count" { return TYPE_INT }
    if name == "get_arg" { return TYPE_STR }
    if name == "read_file" { return TYPE_STR }
    if name == "write_file" { return TYPE_VOID }
    if name == "file_exists" { return TYPE_INT }
    if name == "shell_exec" { return TYPE_INT }
    if name == "exit" { return TYPE_VOID }
    if name == "is_dir" { return TYPE_INT }

    if name == "time_ms" { return TYPE_INT }
    if name == "assert" { return TYPE_VOID }
    if name == "assert_eq" { return TYPE_VOID }
    if name == "assert_ne" { return TYPE_VOID }
    if name == "debug_assert" { return TYPE_VOID }
    if name == "skip" { return TYPE_VOID }
    if name == "unix_socket_listen" { return TYPE_INT }
    if name == "unix_socket_connect" { return TYPE_INT }
    if name == "unix_socket_accept" { return TYPE_INT }
    if name == "unix_socket_accept_timeout" { return TYPE_INT }
    if name == "unix_socket_close" { return TYPE_VOID }
    if name == "socket_read_line" { return TYPE_STR }
    if name == "socket_write" { return TYPE_VOID }
    if name == "file_mtime" { return TYPE_INT }
    if name == "getpid" { return TYPE_INT }
    if name == "process_run" { return runtime_process_result_tid() }
    if name == "process_run_with_stdin" { return runtime_process_result_tid() }
    if name == "process_exec" { return TYPE_VOID }
    if name == "process_spawn" { return TYPE_INT }
    if name == "process_pid_wait" { return runtime_process_result_tid() }
    if name == "process_pid_kill" { return TYPE_INT }
    if name == "process_pid_send_signal" { return TYPE_INT }
    if name == "process_install_signal_forwarding" { return TYPE_VOID }
    if name == "Bytes" { return new_type(TyKind.Bytes, "Bytes") }
    if name == "StringBuilder" { return type_stringbuilder() }
    if name == "Map" { return make_map_type(make_metavar(), make_metavar()) }
    if name == "Set" { return make_set_type(make_metavar()) }
    TYPE_UNKNOWN
}

// br 2r96m9. The typecheck mirror of codegen's builtin static-constructor blocks
// (codegen_methods.bl:2525 onward). Every constructor reached here is a codegen INTRINSIC
// with no .bl function behind it, so no fnsig can answer for it and this is the only source
// of its type. It therefore has to enumerate the same methods codegen dispatches
// (project_is_intrinsic_method_must_match_handlers): the call site used to gate on the
// method name `new` alone and hand the whole answer to get_builtin_fn_ret, which is keyed on
// the TYPE name and so cannot tell two constructors of one type apart — which is exactly why
// Bytes.from_str and Bytes.zeroed were untyped while Bytes.new was fine.
//
// Deliberately ABSENT, and each for its own reason:
//   • Duration.nanos/ms/seconds/minutes/hours and Instant.from_epoch_secs — lib/std/time.bl
//     declares them as real functions, so the bare `{Type}_{method}` fnsig key already
//     answers. A second answer here could only drift from the declaration.
//   • Char.from_code_point — likewise answered already, as Result[Char, ConversionError].
//   • StringBuilder — answered by its own block earlier in infer_type, which has to run
//     BEFORE the receiver is inferred so a same-spelled enum variant cannot shadow it into
//     E0505. Keeping it there is why StringBuilder is named below only as a comment.
//
// Returns TYPE_UNKNOWN for anything it does not own, and the caller falls through to the
// fnsig lookups rather than treating that as the final answer.
fn tc_builtin_static_ret(tname: Str, method: Str) -> Int {
    if tname == "Bytes" {
        if method == "new" || method == "from_str" || method == "zeroed" {
            return get_builtin_fn_ret("Bytes")
        }
        return TYPE_UNKNOWN
    }
    // Map.new() / Set.new(): the element types are metavars, minted per call by
    // get_builtin_fn_ret. No other static constructor exists on either.
    if method == "new" { return get_builtin_fn_ret(tname) }
    TYPE_UNKNOWN
}

fn is_builtin_variant_name(name: Str) -> Int {
    if name == "None" { return 1 }
    if name == "Some" { return 1 }
    if name == "Ok" { return 1 }
    if name == "Err" { return 1 }
    0
}

fn is_variant_name(name: Str) -> Int {
    if is_builtin_variant_name(name) != 0 { return 1 }
    let mut i = 0
    while i < evar_pool.len() {
        if evar_pool.get(i).unwrap().name == name {
            return 1
        }
        i = i + 1
    }
    0
}

fn get_variant_enum_tid(name: Str) -> Int {
    let mut i = 0
    while i < evar_pool.len() {
        let ev = evar_pool.get(i).unwrap()
        if ev.name == name {
            return ev.enum_id
        }
        i = i + 1
    }
    TYPE_UNKNOWN
}

// Reverse-infer a generic-enum INSTANCE tid (`Tree[Int]`) from a variant
// construction (jjhnf3), the enum analogue of tc_struct_lit_instance_tid. Given
// the bare enum tid, its decl node, the variant name, and the constructor's arg
// list, unify each declared payload field tid (evfield_pool, keyed on the
// variant's var_idx) against the inferred ctor arg type, collect the typevar binds
// in the enum's tparam order, and mint make_enum_instance_type. Falls back to the
// bare `enum_tid` when the enum is non-generic or no type-param bound to a concrete
// type — mirroring the struct path's has_concrete gate so an all-typevar / bare
// construction keeps the existing bare behavior unchanged. `args_sl` is the raw
// call/ctor argument sublist (positional).
fn tc_enum_ctor_instance_tid(enum_tid: Int, decl: Int, vname: Str, args_sl: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if decl == -1 { return enum_tid }
    let tparams_sl = node_type_params(decl)
    if tparams_sl == -1 || sublist_length(tparams_sl) == 0 { return enum_tid }
    if args_sl == -1 { return enum_tid }
    let var_idx = get_variant_var_idx(vname)
    if var_idx == -1 { return enum_tid }
    let mut binds: Map[Str, Int] = Map()
    let mut fi = 0
    while fi < sublist_length(args_sl) {
        let declared = lookup_evfield_type_by_index(var_idx, fi)
        if declared != -1 {
            unify_typevar_binds(declared, infer_type(sublist_get(args_sl, fi)), binds)
        }
        fi = fi + 1
    }
    // "Concrete" excludes a typevar AND TYPE_UNKNOWN — an all-typevar / all-unknown
    // instance carries no more information than the bare tid, so the bare path stays
    // authoritative (mirrors tc_struct_lit_instance_tid's has_concrete gate).
    let mut has_concrete = 0
    let mut ci = 0
    while ci < sublist_length(tparams_sl) {
        let bound = binds.get(node_name(sublist_get(tparams_sl, ci))) ?? -1
        if bound != -1 && type_kind(bound) != TyKind.Typevar && type_kind(bound) != TyKind.Unknown { has_concrete = 1 }
        ci = ci + 1
    }
    if has_concrete == 0 { return enum_tid }
    let mut arg_tids: List[Int] = []
    let mut ti = 0
    while ti < sublist_length(tparams_sl) {
        let tpname = node_name(sublist_get(tparams_sl, ti))
        let bound = binds.get(tpname) ?? -1
        if bound != -1 {
            arg_tids.push(bound)
        } else {
            let h = tc_hint_enum_slot(enum_tid, tparams_sl, ti)
            if h != -1 {
                arg_tids.push(h)
            } else {
                arg_tids.push(make_typevar(tpname))
            }
        }
        ti = ti + 1
    }
    make_enum_instance_type(strip_module_qualifier(type_to_str(enum_tid)), arg_tids)
}

// Struct-style analogue of tc_enum_ctor_instance_tid for a `Variant { field: val }`
// construction (a StructLit node). Unifies each declared payload field tid against
// the inferred value by FIELD NAME (lookup_evfield_type_by_name) rather than by
// position. Same bare-fallback / has_concrete contract (jjhnf3).
fn tc_enum_structlit_instance_tid(enum_tid: Int, decl: Int, vname: Str, flds_sl: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if decl == -1 { return enum_tid }
    let tparams_sl = node_type_params(decl)
    if tparams_sl == -1 || sublist_length(tparams_sl) == 0 { return enum_tid }
    if flds_sl == -1 { return enum_tid }
    let var_idx = get_variant_var_idx(vname)
    if var_idx == -1 { return enum_tid }
    let mut binds: Map[Str, Int] = Map()
    let mut fi = 0
    while fi < sublist_length(flds_sl) {
        let f = sublist_get(flds_sl, fi)
        let declared = lookup_evfield_type_by_name(var_idx, node_name(f))
        if declared != -1 {
            unify_typevar_binds(declared, infer_type(node_value(f)), binds)
        }
        fi = fi + 1
    }
    let mut has_concrete = 0
    let mut ci = 0
    while ci < sublist_length(tparams_sl) {
        let bound = binds.get(node_name(sublist_get(tparams_sl, ci))) ?? -1
        if bound != -1 && type_kind(bound) != TyKind.Typevar && type_kind(bound) != TyKind.Unknown { has_concrete = 1 }
        ci = ci + 1
    }
    if has_concrete == 0 { return enum_tid }
    let mut arg_tids: List[Int] = []
    let mut ti = 0
    while ti < sublist_length(tparams_sl) {
        let bound = binds.get(node_name(sublist_get(tparams_sl, ti))) ?? -1
        if bound != -1 {
            arg_tids.push(bound)
        } else {
            let h = tc_hint_enum_slot(enum_tid, tparams_sl, ti)
            if h != -1 {
                arg_tids.push(h)
            } else {
                arg_tids.push(make_typevar(node_name(sublist_get(tparams_sl, ti))))
            }
        }
        ti = ti + 1
    }
    make_enum_instance_type(strip_module_qualifier(type_to_str(enum_tid)), arg_tids)
}

// When a generic-enum ctor slot is unbound after arg-unification (a subset variant
// like `Left(L)` leaves R untouched), the enclosing annotation (tc_construct_hint)
// may pin it. Return the hint's concrete slot tid at `ti`, or -1 unless the hint is
// a TyKind.Enum matching THIS enum by strip_module_qualifier(base name) AND arity. Hint
// fills gaps only; unify wins where it has evidence. An unrelated hint (Option[..],
// a different-named enum) is rejected (br 7q3aj0).
fn tc_hint_enum_slot(enum_tid: Int, tparams_sl: Int, ti: Int) -> Int {
    if tc_construct_hint < 0 { return -1 }
    if tc_tid_is_enum(tc_construct_hint) == 0 { return -1 }
    if strip_module_qualifier(type_to_str(tc_construct_hint)) != strip_module_qualifier(type_to_str(enum_tid)) { return -1 }
    // Arity: hint's arg count vs THIS enum's tparam count. The enum side MUST come
    // from sublist_length(tparams_sl) — the bare enum decl tid has params_count==0,
    // so tc_tid_struct_arg_count(enum_tid) would be 0 and never match.
    if tc_tid_struct_arg_count(tc_construct_hint) != sublist_length(tparams_sl) { return -1 }
    tc_tid_struct_arg_tid(tc_construct_hint, ti)
}

// Index of the first variant named `name` in evar_pool. This index is the
// `var_idx` key used by evfield_pool (registration stores var_idx =
// evar_pool.len() just before pushing the variant), so it lets variant_field_count
// look up the declared field count for that variant. Returns -1 if not found.
fn get_variant_var_idx(name: Str) -> Int {
    let mut i = 0
    while i < evar_pool.len() {
        if evar_pool.get(i).unwrap().name == name {
            return i
        }
        i = i + 1
    }
    -1
}

// Number of declared fields for the variant at the given evar_pool index, by
// counting evfield_pool entries keyed on that var_idx (mirrors the traversal in
// lookup_evfield_type_by_index). A bare variant with no payload has 0 fields.
fn variant_field_count(var_idx: Int) -> Int {
    let mut i = 0
    let mut count = 0
    while i < evfield_pool.len() {
        if evfield_pool.get(i).unwrap().var_idx == var_idx {
            count = count + 1
        }
        i = i + 1
    }
    count
}

// Count the number of DISTINCT enums that declare a variant named `name`.
// get_variant_enum_tid returns only the first match, so it cannot detect
// non-uniqueness; this is what the bare-construction cascade uses to decide
// between a unique-variant fallback and an E0519 AmbiguousConstruction.
fn count_enums_with_variant(name: Str) -> Int {
    let mut seen: Map[Int, Int] = Map()
    let mut count = 0
    let mut i = 0
    while i < evar_pool.len() {
        let ev = evar_pool.get(i).unwrap()
        if ev.name == name && seen.contains_key(ev.enum_id) == 0 {
            seen.insert(ev.enum_id, 1)
            count = count + 1
            if count > 1 { return count }
        }
        i = i + 1
    }
    count
}

// Iterative two-row Levenshtein edit distance between two strings.
fn str_levenshtein(a: Str, b: Str) -> Int {
    let alen = a.len()
    let blen = b.len()
    if alen == 0 { return blen }
    if blen == 0 { return alen }
    let mut prev: List[Int] = []
    let mut j = 0
    while j <= blen {
        prev.push(j)
        j = j + 1
    }
    let mut i = 0
    while i < alen {
        let mut curr: List[Int] = []
        curr.push(i + 1)
        let ac = a.slice(i, i + 1)
        let mut k = 0
        while k < blen {
            let bc = b.slice(k, k + 1)
            let cost = if ac == bc { 0 } else { 1 }
            let del = prev.get(k + 1).unwrap() + 1
            let ins = curr.get(k).unwrap() + 1
            let sub = prev.get(k).unwrap() + cost
            let mut best = del
            if ins < best { best = ins }
            if sub < best { best = sub }
            curr.push(best)
            k = k + 1
        }
        prev = curr
        i = i + 1
    }
    prev.get(blen).unwrap()
}

// Suggest the closest known variant name (as `Enum.Variant`) to `name`,
// scanning evar_pool. Returns "" when no candidate is within the confidence
// threshold, so a far-off typo gets no bogus suggestion.
fn suggest_variant(name: Str) -> Str {
    let mut best_dist = -1
    let mut best_enum = ""
    let mut best_var = ""
    let mut i = 0
    while i < evar_pool.len() {
        let ev = evar_pool.get(i).unwrap()
        let d = str_levenshtein(name, ev.name)
        if best_dist == -1 || d < best_dist {
            best_dist = d
            best_var = ev.name
            best_enum = type_to_str(ev.enum_id)
        }
        i = i + 1
    }
    if best_dist == -1 { return "" }
    let mut threshold = name.len() / 3
    if threshold < 1 { threshold = 1 }
    if best_dist > threshold { return "" }
    "{best_enum}.{best_var}"
}

// Suggest the closest known member of `mod_name` (a module key, e.g. "std_libc")
// to `member`, scanning tc_symbol_module for symbols whose source module equals
// `mod_name`. Returns "" when nothing is within the threshold, so a far-off typo
// gets no bogus suggestion. `pub` so codegen's module-qualified-call path (which
// has the scope-var guard `infer_type` lacks) can offer the suggestion.
//
// Threshold is stricter than suggest_variant's: a longer name (threshold > 1)
// must be edit-distance STRICTLY under member.len()/3, not merely <=. This keeps
// a single-char typo on a short name (`read_byte` -> `read_bytes`, dist 1) while
// rejecting a name that is a deferred *feature*, not a typo: `recvfrom_bytes`
// (14 chars, threshold 4) is exactly dist 4 from `recv_bytes` and must NOT
// suggest it (a UDP wrapper is post-v1, not a misspelling of TCP recv).
pub fn suggest_module_member(mod_name: Str, member: Str) -> Str {
    let mut best_dist = -1
    let mut best_name = ""
    let keys = tc_symbol_module.keys()
    let mut i = 0
    while i < keys.len() {
        let sym = keys.get(i).unwrap()
        if tc_symbol_module.get(sym).unwrap() == mod_name {
            let d = str_levenshtein(member, sym)
            if best_dist == -1 || d < best_dist {
                best_dist = d
                best_name = sym
            }
        }
        i = i + 1
    }
    if best_dist == -1 { return "" }
    let mut threshold = member.len() / 3
    if threshold < 1 { threshold = 1 }
    if best_dist > threshold { return "" }
    if threshold > 1 && best_dist >= threshold { return "" }
    best_name
}

fn is_trait_name(name: Str) -> Int {
    let mut i = 0
    while i < tc_trait_names.len() {
        if tc_trait_names.get(i).unwrap() == name {
            return 1
        }
        i = i + 1
    }
    0
}

// br ta51an. Does the trait's own DECLARATION list a method of this name? register_trait
// pushes "{trait}.{method}" per declared method, so this is an exact-name membership test —
// deliberately not a substring probe of tc_method_trait_names, whose values are " and
// "-joined and would make trait `A` look like an owner inside "AB and C".
//
// This is the gate for the qualified call `Trait.method(x)` naming a trait that does not
// define `method` AT ALL, which is a different question from "no impl fnsig exists for this
// receiver type": a declared method with no fnsig (an open default, an Iterator adapter,
// From/TryFrom's source-typed keys) must keep its existing answer rather than be rejected.
fn tc_trait_declares_method(trait_name: Str, method: Str) -> Int {
    let key = "{trait_name}.{method}"
    let mut i = 0
    while i < tc_trait_method_names.len() {
        if tc_trait_method_names.get(i).unwrap() == key {
            return 1
        }
        i = i + 1
    }
    0
}

fn is_primitive_type(name: Str) -> Int {
    if name == "Int" || name == "Float" || name == "F32" || name == "F64" || name == "Bool" || name == "Str" { return 1 }
    if name == "Void" || name == "List" || name == "Option" || name == "Result" { return 1 }
    if name == "Iterator" || name == "Handle" || name == "Channel" || name == "Map" || name == "Set" { return 1 }
    if name == "Bytes" || name == "Instant" || name == "Duration" || name == "Char" || name == "StringBuilder" { return 1 }
    if name == "Ptr" || name == "U8" || name == "U16" || name == "U32" || name == "U64" { return 1 }
    if name == "I8" || name == "I16" || name == "I32" || name == "I64" { return 1 }
    if name == "Fn" || name == "Self" || name == "Tuple" || name == "Handler" || name == "Template" { return 1 }
    0
}

fn is_known_type(name: Str) -> Int {
    if is_primitive_type(name) != 0 { return 1 }
    if lookup_named_type(name) != -1 { return 1 }
    0
}

// Impl method registry for name resolution
let mut nr_impl_type_names: List[Str] = []
let mut nr_impl_method_names: List[Str] = []
let mut nr_callable_field_names: List[Str] = []

fn is_callable_field_name(name: Str) -> Int {
    let mut i = 0
    while i < nr_callable_field_names.len() {
        if nr_callable_field_names.get(i).unwrap() == name { return 1 }
        i = i + 1
    }
    0
}

fn nr_has_impl_method(type_name: Str, method: Str) -> Int {
    let mut i = 0
    while i < nr_impl_type_names.len() {
        if nr_impl_type_names.get(i).unwrap() == type_name && nr_impl_method_names.get(i).unwrap() == method {
            return 1
        }
        i = i + 1
    }
    0
}

// ── Name resolution walker ──────────────────────────────────────────

fn resolve_names(program: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    nr_scope_names = []
    nr_scope_muts = []
    nr_scope_types = []
    nr_scope_reads = []
    nr_scope_writes = []
    nr_scope_nodes = []
    nr_scope_captured = []
    nr_scope_prev = []
    nr_name_top.clear()
    nr_scope_frames = []
    nr_scope_depth = 0
    nr_loop_depth = 0
    nr_in_closure_depth = 0
    nr_with_ptr_depth = 0
    nr_warn_unused = 1
    nr_impl_type_names = []
    nr_impl_method_names = []
    nr_private_imports = Map()
    nr_name_source_module = Map()
    nr_push_scope()

    // Build private import set: imported non-pub fns, types, lets
    // A name is private only if no pub definition exists for it
    let mut nr_pub_names: Map[Str, Int] = Map()

    // First pass: collect all pub imported names
    // Items that are pub but excluded by selective imports are treated as private
    let fns_sl_priv = node_params(program)
    if fns_sl_priv != -1 {
        let mut i = 0
        while i < sublist_length(fns_sl_priv) {
            let fn_node = sublist_get(fns_sl_priv, i)
            let fn_mod = node_module(fn_node)
            if fn_mod != "" && node_is_pub(fn_node) != 0 {
                nr_pub_names.insert(node_name(fn_node), 1)
            }
            i = i + 1
        }
    }
    let types_sl_priv = node_fields(program)
    if types_sl_priv != -1 {
        let mut i = 0
        while i < sublist_length(types_sl_priv) {
            let td = sublist_get(types_sl_priv, i)
            let td_mod = node_module(td)
            if td_mod != "" && node_is_pub(td) != 0 {
                nr_pub_names.insert(node_name(td), 1)
                let td_flds = node_fields(td)
                if td_flds != -1 && sublist_length(td_flds) > 0 {
                    if node_kind(sublist_get(td_flds, 0)) == NodeKind.TypeVariant {
                        let mut vi = 0
                        while vi < sublist_length(td_flds) {
                            nr_pub_names.insert(node_name(sublist_get(td_flds, vi)), 1)
                            vi = vi + 1
                        }
                    }
                }
            }
            i = i + 1
        }
    }
    let traits_sl_priv = node_arms(program)
    if traits_sl_priv != -1 {
        let mut i = 0
        while i < sublist_length(traits_sl_priv) {
            let tr = sublist_get(traits_sl_priv, i)
            let tr_mod = node_module(tr)
            if tr_mod != "" && node_is_pub(tr) != 0 {
                nr_pub_names.insert(node_name(tr), 1)
            }
            i = i + 1
        }
    }
    let lets_sl_priv = node_stmts(program)
    if lets_sl_priv != -1 {
        let mut i = 0
        while i < sublist_length(lets_sl_priv) {
            let l = sublist_get(lets_sl_priv, i)
            let l_mod = node_module(l)
            if l_mod != "" && node_is_pub(l) != 0 {
                nr_pub_names.insert(node_name(l), 1)
            }
            i = i + 1
        }
    }

    // Second pass: register private names (skip if a pub version exists)
    // Value format: "|mod1|mod2|" so contains("|modX|") works for same-module check
    if fns_sl_priv != -1 {
        let mut i = 0
        while i < sublist_length(fns_sl_priv) {
            let fn_node = sublist_get(fns_sl_priv, i)
            let fn_name = node_name(fn_node)
            let mod_name = node_module(fn_node)
            if mod_name != "" && node_is_pub(fn_node) == 0 && nr_pub_names.contains_key(fn_name) == 0 {
                nr_register_private(fn_name, mod_name)
            }
            i = i + 1
        }
    }
    if types_sl_priv != -1 {
        let mut i = 0
        while i < sublist_length(types_sl_priv) {
            let td = sublist_get(types_sl_priv, i)
            let td_name = node_name(td)
            let mod_name = node_module(td)
            if mod_name != "" && node_is_pub(td) == 0 && nr_pub_names.contains_key(td_name) == 0 {
                nr_register_private(td_name, mod_name)
                let td_flds = node_fields(td)
                if td_flds != -1 && sublist_length(td_flds) > 0 {
                    if node_kind(sublist_get(td_flds, 0)) == NodeKind.TypeVariant {
                        let mut vi = 0
                        while vi < sublist_length(td_flds) {
                            let vname = node_name(sublist_get(td_flds, vi))
                            // A variant named like a builtin (a primitive type like
                            // `Char`, or a builtin variant like `Ok`/`Err`/`Some`)
                            // must never be registered private — it would poison the
                            // builtin's resolution in every module.
                            if nr_pub_names.contains_key(vname) == 0 && is_builtin_name(vname) == 0 {
                                nr_register_private(vname, mod_name)
                            }
                            vi = vi + 1
                        }
                    }
                }
            }
            i = i + 1
        }
    }
    if traits_sl_priv != -1 {
        let mut i = 0
        while i < sublist_length(traits_sl_priv) {
            let tr = sublist_get(traits_sl_priv, i)
            let tr_name = node_name(tr)
            let mod_name = node_module(tr)
            if mod_name != "" && node_is_pub(tr) == 0 && nr_pub_names.contains_key(tr_name) == 0 {
                nr_register_private(tr_name, mod_name)
            }
            i = i + 1
        }
    }
    if lets_sl_priv != -1 {
        let mut i = 0
        while i < sublist_length(lets_sl_priv) {
            let l = sublist_get(lets_sl_priv, i)
            let l_name = node_name(l)
            let mod_name = node_module(l)
            if mod_name != "" && node_is_pub(l) == 0 && nr_pub_names.contains_key(l_name) == 0 {
                nr_register_private(l_name, mod_name)
            }
            i = i + 1
        }
    }

    // Pre-collect __main__ names to suppress ambiguity when local defs shadow
    let mut main_names: Map[Str, Int] = Map()
    let pre_fns = node_params(program)
    if pre_fns != -1 {
        let mut i = 0
        while i < sublist_length(pre_fns) {
            let fn_node = sublist_get(pre_fns, i)
            if node_module(fn_node) == "__main__" {
                main_names.insert(node_name(fn_node), 1)
            }
            i = i + 1
        }
    }
    let pre_lets = node_stmts(program)
    if pre_lets != -1 {
        let mut i = 0
        while i < sublist_length(pre_lets) {
            let l = sublist_get(pre_lets, i)
            if node_module(l) == "__main__" {
                main_names.insert(node_name(l), 1)
            }
            i = i + 1
        }
    }

    // Register all top-level let binding names
    let lets_sl = node_stmts(program)
    if lets_sl != -1 {
        let mut i = 0
        while i < sublist_length(lets_sl) {
            let l = sublist_get(lets_sl, i)
            let l_name = node_name(l)
            let l_mod = node_module(l)
            if l_mod != "__main__" {
                match tc_original_to_alias.get(l_name) {
                    Some(alias) => {
                        nr_check_ambiguity(alias, l_mod, main_names)
                        nr_define(alias)
                        nr_register_private(l_name, l_mod)
                    }
                    None => {
                        nr_check_ambiguity(l_name, l_mod, main_names)
                        nr_define(l_name)
                    }
                }
            } else {
                nr_check_ambiguity(l_name, l_mod, main_names)
                nr_define(l_name)
            }
            i = i + 1
        }
    }

    // Register all function names in scope
    let fns_sl = node_params(program)
    if fns_sl != -1 {
        let mut i = 0
        while i < sublist_length(fns_sl) {
            let fn_node = sublist_get(fns_sl, i)
            let fn_name = node_name(fn_node)
            let fn_mod = node_module(fn_node)
            if fn_mod != "__main__" {
                match tc_original_to_alias.get(fn_name) {
                    Some(alias) => {
                        nr_check_ambiguity(alias, fn_mod, main_names)
                        nr_define(alias)
                        nr_register_private(fn_name, fn_mod)
                    }
                    None => {
                        nr_check_ambiguity(fn_name, fn_mod, main_names)
                        nr_define(fn_name)
                    }
                }
            } else {
                nr_check_ambiguity(fn_name, fn_mod, main_names)
                nr_define(fn_name)
            }
            i = i + 1
        }
    }

    // Register impl methods for method call resolution
    let impls_sl = node_methods(program)
    if impls_sl != -1 {
        let mut i = 0
        while i < sublist_length(impls_sl) {
            let im = sublist_get(impls_sl, i)
            let impl_type = node_name(im)
            let methods_sl = node_methods(im)
            if methods_sl != -1 {
                let mut j = 0
                while j < sublist_length(methods_sl) {
                    let m = sublist_get(methods_sl, j)
                    nr_impl_type_names.push(impl_type)
                    nr_impl_method_names.push(node_name(m))
                    j = j + 1
                }
            }
            // 4q2etk: replaced by mwxtyj — the compiler synthesizes a sealed
            // display() for every Display impl; register it so calls resolve.
            if node_trait_name(im) == "Display" {
                nr_impl_type_names.push(impl_type)
                nr_impl_method_names.push("display")
            }
            i = i + 1
        }
    }

    // Register @derive-generated method names so derived calls don't trip W0501.
    // Mirrors register_derive_annotations in src/codegen_derive.bl (runs after typecheck).
    let derive_types_sl = node_fields(program)
    if derive_types_sl != -1 {
        let mut i = 0
        while i < sublist_length(derive_types_sl) {
            let td = sublist_get(derive_types_sl, i)
            if type_has_derive(td, "Clone") != 0 { nr_impl_method_names.push("clone") }
            if type_has_derive(td, "Eq") != 0 { nr_impl_method_names.push("eq") }
            if type_has_derive(td, "Ord") != 0 {
                nr_impl_method_names.push("cmp")
                nr_impl_method_names.push("eq")
            }
            if type_has_derive(td, "Hash") != 0 { nr_impl_method_names.push("hash") }
            if type_has_derive(td, "Debug") != 0 { nr_impl_method_names.push("debug") }
            if type_has_derive(td, "Serialize") != 0 { nr_impl_method_names.push("to_json") }
            if type_has_derive(td, "Deserialize") != 0 { nr_impl_method_names.push("from_json") }
            i = i + 1
        }
    }

    // Walk each function body
    if fns_sl != -1 {
        let mut i = 0
        while i < sublist_length(fns_sl) {
            let fn_node = sublist_get(fns_sl, i)
            nr_current_module = node_module(fn_node)
            nr_check_fn(fn_node)
            i = i + 1
        }
    }

    // Walk each impl method body
    if impls_sl != -1 {
        let mut i = 0
        while i < sublist_length(impls_sl) {
            let im = sublist_get(impls_sl, i)
            nr_current_module = node_module(im)
            let methods_sl = node_methods(im)
            if methods_sl != -1 {
                let mut j = 0
                while j < sublist_length(methods_sl) {
                    nr_check_fn(sublist_get(methods_sl, j))
                    j = j + 1
                }
            }
            i = i + 1
        }
    }

    // Walk test block bodies for unused import detection
    let tests_sl = node_captures(program)
    if tests_sl != -1 {
        nr_current_module = "__main__"
        let mut i = 0
        while i < sublist_length(tests_sl) {
            let tb = sublist_get(tests_sl, i)
            let tbody = node_body(tb)
            if tbody != -1 {
                nr_check_node(tbody)
            }
            i = i + 1
        }
    }

    nr_pop_scope()
}

fn nr_check_fn(fn_node: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    nr_push_scope()
    let nr_is_ffi = has_annotation(fn_node, "ffi")
    let params_sl = node_params(fn_node)
    if params_sl != -1 && nr_is_ffi == 0 {
        let mut i = 0
        while i < sublist_length(params_sl) {
            let p = sublist_get(params_sl, i)
            nr_define_at(node_name(p), p)
            let ptype_ann = node_type_ann(p)
            if ptype_ann != -1 {
                nr_check_type_ann_visibility(ptype_ann)
            } else {
                nr_check_type_ref(node_type_name(p))
            }
            i = i + 1
        }
    }
    let ret_ann = node_type_ann(fn_node)
    if ret_ann != -1 {
        nr_check_type_ann_visibility(ret_ann)
    } else {
        let ret_str = node_return_type(fn_node)
        if ret_str != "" {
            nr_check_type_ref(ret_str)
        }
    }
    if nr_is_ffi == 0 {
        let body = node_body(fn_node)
        if body != -1 {
            nr_check_node(body)
        }
    }
    nr_pop_scope()
}

fn nr_check_type_ann_visibility(ann_node: Int) ! TypeCheck.Resolve, Diag.Report {
    if ann_node == -1 { return }
    let name = node_name(ann_node)
    nr_check_type_ref(name)
    if name == "Handler" || name == "Template" {
        let elems_sl = node_elements(ann_node)
        if elems_sl != -1 {
            let mut i = 0
            while i < sublist_length(elems_sl) {
                let child = sublist_get(elems_sl, i)
                let child_name = node_name(child)
                tc_mark_symbol_used(child_name)
                i = i + 1
            }
        }
        return
    }
    let elems_sl = node_elements(ann_node)
    if elems_sl != -1 {
        let mut i = 0
        while i < sublist_length(elems_sl) {
            nr_check_type_ann_visibility(sublist_get(elems_sl, i))
            i = i + 1
        }
    }
}

fn nr_check_type_ref(name: Str) ! TypeCheck.Resolve, Diag.Report {
    if name == "" { return }
    if name.len() == 1 { return }
    if is_known_type(name) != 0 {
        if nr_check_selective_access(name, -1) != 0 { return }
        if is_private_access(name) != 0 {
            tc_errors.push("cannot access private type '{name}'")
            diag_error_no_loc("PrivateItemAccess", PRIVATE_ITEM_ACCESS, "cannot access private type '{name}' from another module", "mark the type as 'pub' in its module")
            return
        }
        tc_mark_symbol_used(name)
        return
    }
    if is_trait_name(name) != 0 {
        if nr_check_selective_access(name, -1) != 0 { return }
        if is_private_access(name) != 0 {
            tc_errors.push("cannot access private trait '{name}'")
            diag_error_no_loc("PrivateItemAccess", PRIVATE_ITEM_ACCESS, "cannot access private trait '{name}' from another module", "mark the trait as 'pub' in its module")
            return
        }
        tc_mark_symbol_used(name)
        return
    }
    tc_errors.push("unknown type '{name}'")
    diag_error_no_loc("UnknownType", UNKNOWN_TYPE, "unknown type '{name}'", "")
}

fn is_bytes_growth_method(name: Str) -> Int {
    if name == "push" { return 1 }
    if name == "append" { return 1 }
    if name == "concat" { return 1 }
    if name == "extend" { return 1 }
    if name == "clear" { return 1 }
    if name == "truncate" { return 1 }
    if name == "resize" { return 1 }
    if name == "write_u16_be" || name == "write_u32_be" || name == "write_i32_be" || name == "write_i64_be" { return 1 }
    if name == "write_u16_le" || name == "write_u32_le" || name == "write_i32_le" || name == "write_i64_le" { return 1 }
    0
}

fn nogrow_scan(node: Int, recv: Str, with_ptr_site: Int) ! Diag.Report {
    if node == -1 { return }
    let kind = node_kind(node)

    if kind == NodeKind.MethodCall {
        let mc_obj = node_obj(node)
        if mc_obj != -1 && node_kind(mc_obj) == NodeKind.Ident && node_name(mc_obj) == recv {
            let m = node_method(node)
            if is_bytes_growth_method(m) != 0 {
                diag_error_at("BytesGrowInWithPtr", BYTES_GROW_IN_WITH_PTR, "cannot grow Bytes inside with_ptr closure — '{m}' is growth-effecting", node, "move the growth call outside the with_ptr closure")
            }
        }
        let args_sl = node_args(node)
        if args_sl != -1 {
            let mut i = 0
            while i < sublist_length(args_sl) {
                let a = sublist_get(args_sl, i)
                if node_kind(a) == NodeKind.Ident && node_name(a) == recv {
                    diag_error_at("PinnedBytesEscape", PINNED_BYTES_ESCAPE, "pinned Bytes '{recv}' cannot escape with_ptr closure as argument", a, "pass the Ptr[U8] 'p' or an integer slice instead")
                } else {
                    nogrow_scan(a, recv, with_ptr_site)
                }
                i = i + 1
            }
        }
        if mc_obj != -1 {
            nogrow_scan(mc_obj, recv, with_ptr_site)
        }
        return
    }

    if kind == NodeKind.Call {
        let args_sl = node_args(node)
        if args_sl != -1 {
            let mut i = 0
            while i < sublist_length(args_sl) {
                let a = sublist_get(args_sl, i)
                if node_kind(a) == NodeKind.Ident && node_name(a) == recv {
                    diag_error_at("PinnedBytesEscape", PINNED_BYTES_ESCAPE, "pinned Bytes '{recv}' cannot escape with_ptr closure as argument", a, "pass the Ptr[U8] 'p' or an integer slice instead")
                } else {
                    nogrow_scan(a, recv, with_ptr_site)
                }
                i = i + 1
            }
        }
        let cobj = node_obj(node)
        if cobj != -1 { nogrow_scan(cobj, recv, with_ptr_site) }
        return
    }

    if kind == NodeKind.Block {
        let stmts_sl = node_stmts(node)
        if stmts_sl != -1 {
            let mut i = 0
            while i < sublist_length(stmts_sl) {
                nogrow_scan(sublist_get(stmts_sl, i), recv, with_ptr_site)
                i = i + 1
            }
        }
        return
    }

    if kind == NodeKind.LetBinding {
        let v = node_value(node)
        if v != -1 { nogrow_scan(v, recv, with_ptr_site) }
        return
    }

    if kind == NodeKind.ExprStmt {
        nogrow_scan(node_value(node), recv, with_ptr_site)
        return
    }

    if kind == NodeKind.Assignment || kind == NodeKind.CompoundAssign {
        nogrow_scan(node_target(node), recv, with_ptr_site)
        nogrow_scan(node_value(node), recv, with_ptr_site)
        return
    }

    if kind == NodeKind.Return {
        nogrow_scan(node_value(node), recv, with_ptr_site)
        return
    }

    if kind == NodeKind.IfExpr {
        nogrow_scan(node_condition(node), recv, with_ptr_site)
        nogrow_scan(node_then_body(node), recv, with_ptr_site)
        nogrow_scan(node_else_body(node), recv, with_ptr_site)
        return
    }

    if kind == NodeKind.MatchExpr {
        nogrow_scan(node_scrutinee(node), recv, with_ptr_site)
        let arms_sl = node_arms(node)
        if arms_sl != -1 {
            let mut i = 0
            while i < sublist_length(arms_sl) {
                let arm = sublist_get(arms_sl, i)
                nogrow_scan(node_guard(arm), recv, with_ptr_site)
                nogrow_scan(node_body(arm), recv, with_ptr_site)
                i = i + 1
            }
        }
        return
    }

    if kind == NodeKind.WhileLoop {
        nogrow_scan(node_condition(node), recv, with_ptr_site)
        nogrow_scan(node_body(node), recv, with_ptr_site)
        return
    }

    if kind == NodeKind.ForIn {
        nogrow_scan(node_iterable(node), recv, with_ptr_site)
        nogrow_scan(node_body(node), recv, with_ptr_site)
        return
    }

    if kind == NodeKind.BinOp {
        nogrow_scan(node_left(node), recv, with_ptr_site)
        nogrow_scan(node_right(node), recv, with_ptr_site)
        return
    }

    if kind == NodeKind.UnaryOp {
        nogrow_scan(node_value(node), recv, with_ptr_site)
        return
    }

    if kind == NodeKind.FieldAccess || kind == NodeKind.IndexExpr {
        nogrow_scan(node_obj(node), recv, with_ptr_site)
        nogrow_scan(node_index(node), recv, with_ptr_site)
        return
    }

    if kind == NodeKind.TupleLit || kind == NodeKind.ListLit || kind == NodeKind.InterpString {
        let elems_sl = node_elements(node)
        if elems_sl != -1 {
            let mut i = 0
            while i < sublist_length(elems_sl) {
                nogrow_scan(sublist_get(elems_sl, i), recv, with_ptr_site)
                i = i + 1
            }
        }
        return
    }

    if kind == NodeKind.StructLit {
        let fields_sl = node_fields(node)
        if fields_sl != -1 {
            let mut i = 0
            while i < sublist_length(fields_sl) {
                nogrow_scan(node_value(sublist_get(fields_sl, i)), recv, with_ptr_site)
                i = i + 1
            }
        }
        return
    }

    if kind == NodeKind.Closure {
        nogrow_scan(node_body(node), recv, with_ptr_site)
        return
    }
}

// A literal text run inside an InterpString. parse_interp_string emits these as
// Ident nodes with both str_val and name set to the literal text, so an embedded
// `{expr}` (name set, str_val empty) is distinguishable. Used to skip literal
// runs when walking interpolation parts for name resolution and type checks.
fn is_interp_literal_part(part: Int) -> Int {
    if node_kind(part) == NodeKind.Ident && node_str_val(part) == node_name(part) { return 1 }
    0
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn nr_check_node(node: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if node == -1 { return }
    let kind = node_kind(node)

    if kind == NodeKind.Block {
        nr_push_scope()
        let stmts_sl = node_stmts(node)
        if stmts_sl != -1 {
            let mut i = 0
            while i < sublist_length(stmts_sl) {
                nr_check_node(sublist_get(stmts_sl, i))
                i = i + 1
            }
        }
        nr_pop_scope()
        return
    }

    if kind == NodeKind.LetBinding {
        let val = node_value(node)
        if val != -1 {
            nr_check_node(val)
        }
        let let_type_ann = node_target(node)
        if let_type_ann != -1 {
            nr_check_type_ann_visibility(let_type_ann)
        }
        let let_is_mut = node_is_mut(node)
        nr_define_mut_at(node_name(node), let_is_mut, node)
        if val != -1 {
            let vk = node_kind(val)
            if vk == NodeKind.Call || vk == NodeKind.Ident || vk == NodeKind.MethodCall {
                let inferred = infer_type(val)
                if inferred != TYPE_UNKNOWN {
                    nr_set_last_type(inferred)
                }
            }
        }
        let let_pat_sl = node_elements(node)
        if let_pat_sl != -1 {
            let let_elems_sl = node_elements(let_pat_sl)
            if let_elems_sl != -1 {
                let mut pi = 0
                while pi < sublist_length(let_elems_sl) {
                    let sp = sublist_get(let_elems_sl, pi)
                    nr_define_mut_at(node_name(sp), let_is_mut, sp)
                    pi = pi + 1
                }
            }
        }
        return
    }

    if kind == NodeKind.Assignment || kind == NodeKind.CompoundAssign {
        let assign_target = node_target(node)
        nr_check_node(node_value(node))
        if assign_target != -1 && node_kind(assign_target) == NodeKind.Ident {
            let assign_name = node_name(assign_target)
            if kind == NodeKind.CompoundAssign {
                nr_check_node(assign_target)
            } else {
                tc_mark_symbol_used(assign_name)
            }
            nr_mark_written(assign_name, node)
        } else {
            nr_check_node(assign_target)
        }
        return
    }

    if kind == NodeKind.ExprStmt {
        nr_check_node(node_value(node))
        return
    }

    if kind == NodeKind.Return {
        nr_check_node(node_value(node))
        return
    }

    if kind == NodeKind.Ident {
        let name = node_name(node)
        if name == "true" || name == "false" || name == "None" { return }
        if nr_is_defined(name) != 0 {
            if nr_check_selective_access(name, node) != 0 { return }
            if nr_top_binding_is_global(name) != 0 && is_private_access(name) != 0 {
                tc_errors.push("cannot access private item '{name}'")
                diag_error_at("PrivateItemAccess", PRIVATE_ITEM_ACCESS, "cannot access private item '{name}' from another module", node, "mark the item as 'pub' in its module")
                return
            }
            tc_mark_symbol_used(name)
            return
        }
        if name == "io" || name == "fs" || name == "net" || name == "env" || name == "time" || name == "async" || name == "channel" || name == "default" || name == "term" || name == "ffi" { return }
        if is_user_effect_handle_name(name) != 0 { return }
        if is_variant_name(name) != 0 {
            if nr_check_selective_access(name, node) != 0 { return }
            if is_private_access(name) != 0 {
                tc_errors.push("cannot access private variant '{name}'")
                diag_error_at("PrivateItemAccess", PRIVATE_ITEM_ACCESS, "cannot access private variant '{name}' from another module", node, "mark the enum as 'pub' in its module")
                return
            }
            tc_mark_symbol_used(name)
            return
        }
        if is_builtin_fn(name) != 0 { return }
        if is_known_type(name) != 0 {
            if nr_check_selective_access(name, node) != 0 { return }
            if is_private_access(name) != 0 {
                tc_errors.push("cannot access private type '{name}'")
                diag_error_at("PrivateItemAccess", PRIVATE_ITEM_ACCESS, "cannot access private type '{name}' from another module", node, "mark the type as 'pub' in its module")
                return
            }
            tc_mark_symbol_used(name)
            return
        }
        if is_trait_name(name) != 0 {
            if nr_check_selective_access(name, node) != 0 { return }
            if is_private_access(name) != 0 {
                tc_errors.push("cannot access private trait '{name}'")
                diag_error_at("PrivateItemAccess", PRIVATE_ITEM_ACCESS, "cannot access private trait '{name}' from another module", node, "mark the trait as 'pub' in its module")
                return
            }
            tc_mark_symbol_used(name)
            return
        }
        if is_import_module_name(name) != 0 { return }
        tc_errors.push("undefined variable '{name}'")
        diag_error_at("UndefinedVariable", UNDEFINED_VARIABLE, "undefined variable '{name}'", node, "")
        return
    }

    if kind == NodeKind.IntLit || kind == NodeKind.FloatLit || kind == NodeKind.BoolLit {
        return
    }

    if kind == NodeKind.InterpString {
        let elems_sl = node_elements(node)
        if elems_sl != -1 {
            let mut i = 0
            while i < sublist_length(elems_sl) {
                let part = sublist_get(elems_sl, i)
                if is_interp_literal_part(part) != 0 {
                    // Literal text run — mark as read but skip full check
                    let iname = node_name(part)
                    if nr_is_defined(iname) != 0 {
                        let _skip = 0
                    }
                } else {
                    nr_check_node(part)
                }
                i = i + 1
            }
        }
        return
    }

    if kind == NodeKind.Call {
        let callee = node_left(node)
        if callee != -1 {
            let callee_kind = node_kind(callee)
            if callee_kind == NodeKind.Ident {
                let fn_name = node_name(callee)
                if nr_check_selective_access(fn_name, node) == 0 {
                    if nr_is_defined(fn_name) != 0 && nr_top_binding_is_global(fn_name) != 0 && is_private_access(fn_name) != 0 {
                        tc_errors.push("cannot access private function '{fn_name}'")
                        diag_error_at("PrivateItemAccess", PRIVATE_ITEM_ACCESS, "cannot access private function '{fn_name}' from another module", node, "mark the function as 'pub' in its module")
                    } else if nr_is_defined(fn_name) == 0 && is_variant_name(fn_name) != 0 && is_private_access(fn_name) != 0 {
                        tc_errors.push("cannot access private variant '{fn_name}'")
                        diag_error_at("PrivateItemAccess", PRIVATE_ITEM_ACCESS, "cannot access private variant '{fn_name}' from another module", node, "mark the enum as 'pub' in its module")
                    } else if nr_is_unimported_prelude_free_fn(fn_name) != 0 {
                        tc_errors.push("undefined function '{fn_name}'")
                        diag_error_at("UndefinedFunction", UNDEFINED_FUNCTION, "undefined function '{fn_name}'", node, "this stdlib function is not in the prelude — add an explicit import, e.g. import {tc_qualifier_for_module(tc_get_symbol_module(fn_name))}.\{{fn_name}}")
                    } else if nr_is_defined(fn_name) == 0 && is_builtin_fn(fn_name) == 0 && is_variant_name(fn_name) == 0 && is_known_type(fn_name) == 0 && is_trait_name(fn_name) == 0 {
                        tc_errors.push("undefined function '{fn_name}'")
                        diag_error_at("UndefinedFunction", UNDEFINED_FUNCTION, "undefined function '{fn_name}'", node, "")
                    } else {
                        tc_mark_symbol_used(fn_name)
                    }
                }
            } else {
                nr_check_node(callee)
            }
        }
        let args_sl = node_args(node)
        if args_sl != -1 {
            let mut i = 0
            while i < sublist_length(args_sl) {
                nr_check_node(sublist_get(args_sl, i))
                i = i + 1
            }
        }
        return
    }

    if kind == NodeKind.MethodCall {
        let obj = node_obj(node)
        let mut is_module_qual = 0
        if obj != -1 && node_kind(obj) == NodeKind.Ident {
            let obj_name = node_name(obj)
            if is_import_module_name(obj_name) != 0 && nr_is_defined(obj_name) == 0 {
                is_module_qual = 1
                let mq_method = node_method(node)
                if is_private_access(mq_method) != 0 {
                    nr_emit_private_access(mq_method, node)
                } else {
                    tc_mark_symbol_used(mq_method)
                }
                tc_mark_qualifier_used(obj_name)
            }
        }
        if is_module_qual == 0 && obj != -1 {
            if node_kind(obj) == NodeKind.FieldAccess {
                let inner_obj = node_obj(obj)
                if inner_obj != -1 && node_kind(inner_obj) == NodeKind.Ident {
                    let inner_name = node_name(inner_obj)
                    if is_import_module_name(inner_name) != 0 && nr_is_defined(inner_name) == 0 {
                        let mid_field = node_name(obj)
                        if is_known_type(mid_field) != 0 {
                            let outer_field = node_method(node)
                            tc_mark_symbol_used(mid_field)
                            tc_mark_symbol_used(outer_field)
                            let dotted_mod = tc_get_dotted_module_path(inner_name)
                            diag_error_at("ModuleQualifiedType", MODULE_QUALIFIED_TYPE, "cannot access type member '{mid_field}.{outer_field}' via module qualifier — add '{mid_field}' to your import: 'import {dotted_mod}.\{{mid_field}\}' then use '{mid_field}.{outer_field}'", node, "enum variants and type members use type qualifiers, not module qualifiers")
                            return
                        }
                    }
                }
            }
            nr_check_node(obj)
        }
        let method_name = node_method(node)
        if is_module_qual == 0 && is_builtin_method(method_name) == 0 && is_variant_name(method_name) == 0 {
            let mut found_in_impl = 0
            let mut mi = 0
            while mi < nr_impl_method_names.len() {
                if nr_impl_method_names.get(mi).unwrap() == method_name {
                    found_in_impl = 1
                }
                mi = mi + 1
            }
            if found_in_impl == 0 && is_callable_field_name(method_name) == 0 {
                let mut is_ue_call = 0
                if obj != -1 && node_kind(obj) == NodeKind.Ident {
                    if is_user_effect_handle_name(node_name(obj)) != 0 {
                        is_ue_call = 1
                    }
                    // br n84s1p: this gate is keyed on the BARE method name via
                    // is_builtin_method, so it happened to know `var`, `cwd`, `write` and
                    // `read_bytes` for unrelated reasons and did NOT know `exit` — which made
                    // valid, spec'd `env.exit(0)` warn that the method was unknown. Adding
                    // `exit` to is_builtin_method would be the wrong key: it would silence
                    // `.exit()` on every type. A namespace intrinsic has to be recognized by
                    // NAMESPACE AND METHOD, which is what is_intrinsic_method answers.
                    if is_intrinsic_method(node_name(obj), method_name) != 0 && nr_is_defined(node_name(obj)) == 0 {
                        is_ue_call = 1
                    }
                }
                if is_ue_call == 0 {
                    diag_warn_at("UnknownMethod", UNKNOWN_METHOD, "unknown method '{method_name}' — may fail at compile time", node, "")
                }
            }
        }
        let args_sl = node_args(node)
        let obj_is_ident = if obj != -1 && node_kind(obj) == NodeKind.Ident { 1 } else { 0 }
        let is_with_ptr_call = if method_name == "with_ptr" && obj_is_ident != 0 { 1 } else { 0 }
        if is_with_ptr_call != 0 { nr_with_ptr_depth = nr_with_ptr_depth + 1 }
        if args_sl != -1 {
            let mut i = 0
            while i < sublist_length(args_sl) {
                nr_check_node(sublist_get(args_sl, i))
                i = i + 1
            }
        }
        if is_with_ptr_call != 0 { nr_with_ptr_depth = nr_with_ptr_depth - 1 }
        if method_name == "as_ptr" && nr_with_ptr_depth == 0 && obj_is_ident != 0 {
            let recv_t = infer_type(obj)
            if type_kind(recv_t) == TyKind.Bytes {
                diag_error_at("BytesPtrCastForbidden", BYTES_PTR_CAST_FORBIDDEN, "cannot take a raw Ptr[U8] from Bytes outside a with_ptr closure — Bytes is GC-managed and may be relocated", node, "use Bytes.with_ptr(fn(p) \{ ... }) to pin the buffer for the FFI call")
            }
        }
        if is_with_ptr_call != 0 {
            let recv = node_name(obj)
            if args_sl != -1 && sublist_length(args_sl) >= 1 {
                let cls = sublist_get(args_sl, 0)
                if node_kind(cls) == NodeKind.Closure {
                    nogrow_scan(node_body(cls), recv, node)
                }
            }
        }
        return
    }

    if kind == NodeKind.FieldAccess {
        let obj = node_obj(node)
        if obj != -1 {
            let mut is_mod_fa = 0
            let obj_kind = node_kind(obj)
            if obj_kind == NodeKind.Ident {
                let fa_obj_name = node_name(obj)
                if is_import_module_name(fa_obj_name) != 0 && nr_is_defined(fa_obj_name) == 0 {
                    is_mod_fa = 1
                    let fa_field = node_name(node)
                    if is_private_access(fa_field) != 0 {
                        nr_emit_private_access(fa_field, node)
                    } else {
                        tc_mark_symbol_used(fa_field)
                    }
                    tc_mark_qualifier_used(fa_obj_name)
                }
            }
            if is_mod_fa == 0 && obj_kind == NodeKind.FieldAccess {
                let inner_obj = node_obj(obj)
                if inner_obj != -1 && node_kind(inner_obj) == NodeKind.Ident {
                    let inner_name = node_name(inner_obj)
                    if is_import_module_name(inner_name) != 0 && nr_is_defined(inner_name) == 0 {
                        let mid_field = node_name(obj)
                        if is_known_type(mid_field) != 0 {
                            let outer_field = node_name(node)
                            tc_mark_symbol_used(mid_field)
                            tc_mark_symbol_used(outer_field)
                            let dotted_mod = tc_get_dotted_module_path(inner_name)
                            diag_error_at("ModuleQualifiedType", MODULE_QUALIFIED_TYPE, "cannot access type member '{mid_field}.{outer_field}' via module qualifier — add '{mid_field}' to your import: 'import {dotted_mod}.\{{mid_field}\}' then use '{mid_field}.{outer_field}'", node, "enum variants and type members use type qualifiers, not module qualifiers")
                            return
                        }
                    }
                }
            }
            if is_mod_fa == 0 {
                nr_check_node(obj)
            }
        }
        return
    }

    if kind == NodeKind.IndexExpr {
        nr_check_node(node_obj(node))
        nr_check_node(node_index(node))
        return
    }

    if kind == NodeKind.BinOp {
        nr_check_node(node_left(node))
        nr_check_node(node_right(node))
        return
    }

    if kind == NodeKind.UnaryOp {
        nr_check_node(node_left(node))
        return
    }

    if kind == NodeKind.IfExpr {
        nr_check_node(node_condition(node))
        nr_check_node(node_then_body(node))
        nr_check_node(node_else_body(node))
        return
    }

    if kind == NodeKind.WhileLoop {
        nr_check_node(node_condition(node))
        nr_loop_depth = nr_loop_depth + 1
        nr_check_node(node_body(node))
        nr_loop_depth = nr_loop_depth - 1
        nr_check_node(node_condition(node))
        return
    }

    if kind == NodeKind.LoopExpr {
        nr_loop_depth = nr_loop_depth + 1
        nr_check_node(node_body(node))
        nr_loop_depth = nr_loop_depth - 1
        return
    }

    if kind == NodeKind.ForIn {
        nr_check_node(node_iterable(node))
        nr_push_scope()
        nr_define_at(node_var_name(node), node)
        let for_pat_sl = node_elements(node)
        if for_pat_sl != -1 {
            nr_check_pattern(for_pat_sl)
        }
        nr_loop_depth = nr_loop_depth + 1
        nr_check_node(node_body(node))
        nr_loop_depth = nr_loop_depth - 1
        nr_pop_scope()
        return
    }

    if kind == NodeKind.Break || kind == NodeKind.Continue {
        return
    }

    if kind == NodeKind.MatchExpr {
        nr_check_node(node_scrutinee(node))
        let arms_sl = node_arms(node)
        if arms_sl != -1 {
            let mut i = 0
            while i < sublist_length(arms_sl) {
                let arm = sublist_get(arms_sl, i)
                nr_push_scope()
                nr_check_pattern(node_pattern(arm))
                let guard = node_guard(arm)
                if guard != -1 {
                    nr_check_node(guard)
                }
                nr_check_node(node_body(arm))
                nr_pop_scope()
                i = i + 1
            }
        }
        return
    }

    if kind == NodeKind.Closure {
        nr_push_scope()
        let params_sl = node_params(node)
        if params_sl != -1 {
            let mut i = 0
            while i < sublist_length(params_sl) {
                let cp = sublist_get(params_sl, i)
                nr_define_at(node_name(cp), cp)
                i = i + 1
            }
        }
        // Spec §3c.2: a closure body does not inherit the surrounding
        // test-body elaboration. `?` inside the closure must be gated
        // against the closure's own (or enclosing fn's) return type.
        let saved_in_test = tc_in_test_body
        tc_in_test_body = 0
        nr_in_closure_depth = nr_in_closure_depth + 1
        nr_check_node(node_body(node))
        nr_in_closure_depth = nr_in_closure_depth - 1
        tc_in_test_body = saved_in_test
        nr_pop_scope()
        return
    }

    if kind == NodeKind.StructLit {
        let type_name = node_type_name(node)
        if type_name != "" {
            let dot_pos = type_name.index_of(".")
            if dot_pos >= 0 {
                let prefix = type_name.substr(0, dot_pos)
                if is_import_module_name(prefix) != 0 && nr_is_defined(prefix) == 0 {
                    // module.Type qualified construction: mark module used; nr_check_type_ref not needed
                    // (lookup_named_type in type inference strips the qualifier and resolves the bare name)
                    tc_mark_qualifier_used(prefix)
                } else {
                    // Enum.Variant struct-style construction: check the enum type only
                    nr_check_type_ref(prefix)
                }
            } else {
                if is_variant_name(type_name) != 0 {
                    // bare struct-style variant construction; resolved in infer_type.
                    // This gate only suppresses the false UnknownType — it never picks a winner.
                } else {
                    let stid = lookup_named_type(type_name)
                    if stid == -1 {
                        let suggestion = suggest_variant(type_name)
                        if suggestion != "" {
                            diag_error_at("UnknownType", UNKNOWN_TYPE, "unknown type '{type_name}'", node, "did you mean {suggestion}? construct as {suggestion} \{ ... }")
                        } else {
                            nr_check_type_ref(type_name)
                        }
                    } else {
                        nr_check_type_ref(type_name)
                    }
                }
            }
        }
        let flds_sl = node_fields(node)
        if flds_sl != -1 {
            let mut i = 0
            while i < sublist_length(flds_sl) {
                let f = sublist_get(flds_sl, i)
                nr_check_node(node_value(f))
                i = i + 1
            }
        }
        return
    }

    if kind == NodeKind.ListLit {
        let elems_sl = node_elements(node)
        if elems_sl != -1 {
            let mut i = 0
            while i < sublist_length(elems_sl) {
                nr_check_node(sublist_get(elems_sl, i))
                i = i + 1
            }
        }
        return
    }

    if kind == NodeKind.TupleLit {
        let elems_sl = node_elements(node)
        if elems_sl != -1 {
            let mut i = 0
            while i < sublist_length(elems_sl) {
                nr_check_node(sublist_get(elems_sl, i))
                i = i + 1
            }
        }
        return
    }

    if kind == NodeKind.RangeLit {
        nr_check_node(node_start(node))
        nr_check_node(node_end(node))
        return
    }

    if kind == NodeKind.WithBlock {
        let wh_sl = node_handlers(node)
        nr_push_scope()
        if wh_sl != -1 {
            let mut wi = 0
            while wi < sublist_length(wh_sl) {
                let wh_item = sublist_get(wh_sl, wi)
                let wh_kind = node_kind(wh_item)
                if wh_kind == NodeKind.WithResource {
                    nr_define_at(node_name(wh_item), wh_item)
                    nr_check_node(node_value(wh_item))
                } else if wh_kind == NodeKind.Ident && node_name(wh_item) == "arena" {
                    // `arena` is a keyword in `with arena { }` — skip the
                    // bare ident so we don't emit E0506. Matches the skip
                    // guard in tc_check_body's WithBlock branch.
                } else {
                    nr_check_node(wh_item)
                }
                wi = wi + 1
            }
        }
        nr_check_node(node_body(node))
        nr_pop_scope()
        return
    }

    if kind == NodeKind.AssertPanics {
        let ap_match = node_value(node)
        if ap_match != -1 {
            nr_check_node(ap_match)
        }
        nr_push_scope()
        nr_check_node(node_body(node))
        nr_pop_scope()
        return
    }

    if kind == NodeKind.WithResource {
        nr_check_node(node_value(node))
        return
    }

    if kind == NodeKind.HandlerExpr {
        let methods_sl = node_methods(node)
        if methods_sl != -1 {
            let mut i = 0
            while i < sublist_length(methods_sl) {
                nr_check_fn(sublist_get(methods_sl, i))
                i = i + 1
            }
        }
        return
    }

    if kind == NodeKind.AsyncScope {
        nr_check_node(node_body(node))
        return
    }

    if kind == NodeKind.AsyncSpawn {
        nr_check_node(node_body(node))
        return
    }

    if kind == NodeKind.AwaitExpr {
        // 1b7ggq: the operand lives in `obj` (src/parser.bl:2865), not `value`. Reading
        // `value` gave -1, so the whole operand subtree went unvisited — `h1.await` did not
        // count as a read of `h1`, and an undefined name in that position reached the C
        // compiler with `check` reporting ok.
        nr_check_node(node_obj(node))
        return
    }

    if kind == NodeKind.ChannelNew {
        return
    }

    if kind == NodeKind.SpreadExpr {
        nr_check_node(node_value(node))
        return
    }

    if kind == NodeKind.EmbedExpr {
        return
    }

    let _skip = 0
}

fn nr_check_pattern(node: Int) ! TypeCheck.Resolve, Diag.Report {
    if node == -1 { return }
    let kind = node_kind(node)

    if kind == NodeKind.IdentPattern {
        let name = node_name(node)
        if name != "_" && is_variant_name(name) == 0 {
            nr_define_at(name, node)
        }
        return
    }

    if kind == NodeKind.IntPattern || kind == NodeKind.StringPattern || kind == NodeKind.WildcardPattern {
        return
    }

    if kind == NodeKind.EnumPattern {
        let flds_sl = node_fields(node)
        if flds_sl != -1 {
            let is_struct_pat = node_int_val(node)
            let mut i = 0
            while i < sublist_length(flds_sl) {
                let f = sublist_get(flds_sl, i)
                if is_struct_pat != 0 {
                    // Struct-style fields are StructLitField nodes; bind by name
                    let fpat = node_pattern(f)
                    if fpat != -1 {
                        nr_check_pattern(fpat)
                    } else {
                        nr_define_at(node_name(f), f)
                    }
                } else {
                    nr_check_pattern(f)
                }
                i = i + 1
            }
        }
        return
    }

    if kind == NodeKind.StructPattern {
        let flds_sl = node_fields(node)
        if flds_sl != -1 {
            let mut i = 0
            while i < sublist_length(flds_sl) {
                let f = sublist_get(flds_sl, i)
                nr_define_at(node_name(f), f)
                i = i + 1
            }
        }
        return
    }

    if kind == NodeKind.TuplePattern {
        let elems_sl = node_elements(node)
        if elems_sl != -1 {
            let mut i = 0
            while i < sublist_length(elems_sl) {
                nr_check_pattern(sublist_get(elems_sl, i))
                i = i + 1
            }
        }
        return
    }

    if kind == NodeKind.ListPattern {
        let elems_sl = node_elements(node)
        if elems_sl != -1 {
            let mut i = 0
            while i < sublist_length(elems_sl) {
                nr_check_pattern(sublist_get(elems_sl, i))
                i = i + 1
            }
        }
        return
    }

    if kind == NodeKind.OrPattern {
        nr_check_pattern(node_left(node))
        nr_check_pattern(node_right(node))
        return
    }

    if kind == NodeKind.RangePattern {
        return
    }

    if kind == NodeKind.AsPattern {
        nr_check_pattern(node_pattern(node))
        nr_define(node_name(node))
        return
    }

    let _skip = 0
}

// ── Phase 2: Type compatibility ─────────────────────────────────────

fn resolve_alias_tid(tid: Int) -> Int {
    if tc_alias_underlying.len() == 0 { return tid }
    if tid < 0 || tid >= ty_pool.len() { return tid }
    let name = ty_pool.get(tid).unwrap().name
    tc_alias_underlying.get(name) ?? tid
}

// Walks a transparent `type Alias = X` chain from a bare (params_count 0) struct/enum
// NAME to the tid that actually determines its C spelling / injectivity — the single
// shared resolver for the three consumers that must agree on this (tc_tid_to_c_tag,
// tc_tid_inner_tag, tc_tid_struct_seg_injective), rather than each re-deriving it (br
// bwyfy1's "two-speller, opposite rules" shape, repeated a third time if left alone).
// Bounded like resolve_alias_type_name's hop cap: a long alias-of-alias chain must
// terminate, not recurse unboundedly. Refuses to follow into a forward-declared alias
// whose RHS hadn't been registered yet — register_struct_type inserts the alias's own
// name into named_type_map before resolving its RHS, so a reference to a not-yet-declared
// type mints an orphaned TyKind.Typevar (resolve_type_ann's make_typevar fallback) instead of
// the real tid. Chasing that phantom would hand back tc_tid_to_c_tag's own "<tv>" poison
// sentinel as if it were a genuine resolution, baking it into a real C identifier instead
// of refusing to treat the alias as resolved. Returns -1 when `name` names no alias, or
// when the chain would return anything other than a genuine, encodable target.
fn tc_resolve_transparent_alias_name(name: Str) -> Int {
    if tc_alias_underlying.len() == 0 { return -1 }
    let mut cur_name = name
    let mut result = -1
    let mut hops = 0
    while hops < 8 {
        let next = tc_alias_underlying.get(cur_name) ?? -1
        if next == -1 { return result }
        let nr = tc_resolve(next)
        if nr < 0 || nr >= ty_pool.len() { return result }
        let ne = ty_pool.get(nr).unwrap()
        if ne.kind == TyKind.Typevar || ne.kind == TyKind.Unknown { return result }
        // Direct self-alias (`type A = A`) resolves to a real, already-registered tid
        // for itself rather than a TyKind.Typevar placeholder, so the poison check above
        // does not catch it. A genuine multi-name cycle always has some direction that
        // forward-references a not-yet-declared name and mints an orphan TyKind.Typevar
        // there (register_struct_type inserts before resolving), which the check above
        // already terminates within a few hops — only the degenerate zero-indirection
        // self-loop has no such gap to be caught by. Without this, cur_name would never
        // change and the caller's self-recursion on an unchanged tid would spin forever.
        if ne.name == cur_name { return result }
        result = next
        if ne.kind != TyKind.Struct && ne.kind != TyKind.Enum { return result }
        if ne.params_count != 0 { return result }
        cur_name = ne.name
        hops = hops + 1
    }
    result
}

fn types_compatible(a0: Int, b0: Int) -> Int {
    // Follow bound metavars to their solution FIRST (gqg3rk): a pinned α reads as
    // its concrete type, so `let s: Str = intList.get(0).unwrap()` is now rejected
    // (α=Int vs Str) instead of silently accepted. An *unbound* α (or the shared
    // TYPE_UNKNOWN singleton) still resolves to a TyKind.Unknown entry and takes the
    // permissive branch below — the region-boundary check reports it as E0301, so
    // we do not double-report it here as a spurious mismatch.
    let a = tc_resolve(resolve_alias_tid(a0))
    let b = tc_resolve(resolve_alias_tid(b0))
    if a == b { return 1 }
    if a == TYPE_UNKNOWN || b == TYPE_UNKNOWN { return 1 }
    if a < 0 || b < 0 { return 1 }
    if a >= ty_pool.len() || b >= ty_pool.len() { return 1 }
    let ta = ty_pool.get(a).unwrap()
    let tb = ty_pool.get(b).unwrap()
    let ka = ta.kind
    let kb = tb.kind
    // An unbound metavar that survived resolution (kind TyKind.Unknown, not the
    // singleton) is still "compatible with anything" pending the boundary check.
    if ka == TyKind.Unknown || kb == TyKind.Unknown { return 1 }
    if ka == TyKind.Typevar || kb == TyKind.Typevar { return 1 }
    // Int and Bool are interchangeable in Blink (C-style truthiness)
    if (ka == TyKind.Int || ka == TyKind.Bool) && (kb == TyKind.Int || kb == TyKind.Bool) { return 1 }
    // Sized integer kinds are compatible only with themselves (no implicit promotion)
    let is_sized_a = is_sized_int(ka)
    let is_sized_b = is_sized_int(kb)
    if is_sized_a || is_sized_b { return if ka == kb { 1 } else { 0 } }
    // Enums are nominally distinct from Int (br dhggkg, panel 6-0). An enum value
    // is NOT assignable to an Int target nor an Int to an enum target — INT vs ENUM
    // falls through to `ka == kb` (false → 0), mirroring the sized-int rule above.
    // Comparison (==/!=/<…) is unaffected: it short-circuits to Bool before reaching
    // types_compatible, so an enum tag stays comparable to an Int. Convert explicitly
    // via Enum.to_int() / Enum.from_int(n) -> Option[Enum].
    if ka == kb {
        if ka == TyKind.List || ka == TyKind.Option || ka == TyKind.Iterator || ka == TyKind.Set {
            return types_compatible(ta.inner1, tb.inner1)
        }
        // br w13xgb. A pointer is compatible only with a pointer to the same thing. Same
        // one-inner recursion as the line above, spelled separately because the reason differs:
        // for List/Option/Set the payload is a Blink value, here it is a C memory layout, and
        // `int64_t*` vs `blink_Pollfd*` is a stride and field-offset difference that the C
        // compiler rejects outright. Recursing is what turns that cc error into a TypeError.
        //
        // Ptr[Void] is deliberately NOT special-cased into a universal pointer. C converts
        // void* implicitly in both directions, so importing that rule would make every Ptr
        // assignable to every other via one Void hop — the exact hole this arm closes. If a real
        // FFI signature needs the C conversion, it belongs in an explicit cast, not in the
        // compatibility relation.
        if ka == TyKind.Ptr {
            return types_compatible(ta.inner1, tb.inner1)
        }
        // br nrrs28. The phantom injection context, and the same one-inner recursion for a third
        // distinct reason: sections/03b_contracts.md:566 is normative — "`Template[DB]` and
        // `Template[Shell]` are distinct types. You cannot pass a `Template[Shell]` to a function
        // expecting `Template[DB]`." Without this arm two Templates matched on kind alone, which
        // is the cross-context confusion the phantom exists to prevent.
        //
        // It is VACUOUS for the spec's own examples, deliberately and unavoidably: `DB` and
        // `Shell` there are EFFECT names, effect names are not in the type namespace, so each
        // phantom resolves to a typevar and the typevar arm above already returned 1. So this
        // arm bites only when the context is a real type. Making the effect spelling bite is a
        // spec question (filed) and not something a compatibility arm can decide.
        if ka == TyKind.Template {
            return types_compatible(ta.inner1, tb.inner1)
        }
        if ka == TyKind.Map {
            if types_compatible(ta.inner1, tb.inner1) == 0 { return 0 }
            return types_compatible(ta.inner2, tb.inner2)
        }
        if ka == TyKind.Result {
            if types_compatible(ta.inner1, tb.inner1) == 0 { return 0 }
            return types_compatible(ta.inner2, tb.inner2)
        }
        if ka == TyKind.Tuple {
            if ta.params_count != tb.params_count { return 0 }
            let mut i = 0
            while i < ta.params_count {
                let ea = ty_param_list.get(ta.params_start + i).unwrap()
                let eb = ty_param_list.get(tb.params_start + i).unwrap()
                if types_compatible(ea, eb) == 0 { return 0 }
                i = i + 1
            }
            return 1
        }
        if ka == TyKind.Struct || ka == TyKind.Enum {
            // Nominal equality by base name first (mirrors the TyKind.Tuple branch
            // above). Two struct/enum tids are compatible iff they name the same
            // declaration; the module qualifier is stripped on both sides so a
            // qualified and bare reference to the same type still match (precedent:
            // strip_module_qualifier at tc_type_name callers below).
            if strip_module_qualifier(ta.name) != strip_module_qualifier(tb.name) { return 0 }
            // Same declaration: a generic struct carries its concrete type-args as
            // params (Box[Int] built by make_struct_instance_type). If BOTH sides
            // carry params, they must specialize identically — element-wise like a
            // tuple (br 2bh76q). If EITHER is the bare generic (params_count 0), it
            // is the un-specialized form and matches any specialization of the same
            // name (bare Box ~ Box[Int]); enums have no params → this is a no-op and
            // the branch reduces to the old name-only (a==b) behavior for them.
            if ta.params_count > 0 && tb.params_count > 0 {
                if ta.params_count != tb.params_count { return 0 }
                let mut si = 0
                while si < ta.params_count {
                    let sea = ty_param_list.get(ta.params_start + si).unwrap()
                    let seb = ty_param_list.get(tb.params_start + si).unwrap()
                    if types_compatible(sea, seb) == 0 { return 0 }
                    si = si + 1
                }
            }
            return 1
        }
        return 1
    }
    0
}

// Assignment-position compatibility: like types_compatible, but allows an
// untyped integer literal RHS to flow into a sized-int target (I8/U32/...).
// Kept OUT of types_compatible so function-arg checking stays strict.
fn assignment_types_compatible(target_t: Int, val_t: Int, val_node: Int) -> Int {
    if types_compatible(target_t, val_t) == 1 { return 1 }
    let literal_to_sized = is_sized_int(type_kind(target_t)) && val_t == TYPE_INT && is_int_literal_node(val_node)
    if literal_to_sized { return 1 }
    0
}

// Picks the more concrete of two compatible types. Used by branch
// unification (if/else, match) so that a Result[Int, ?] merged with a
// Result[?, Bool] yields Result[Int, Bool] instead of dropping the
// concrete payload from one side. Caller must have already validated
// `types_compatible(a, b)`.
fn type_merge(a0: Int, b0: Int) -> Int {
    // Branch unification is a constraining use (gqg3rk): `if c { None } else {
    // Some(x) }` must PIN the None's element α from the Some branch, so the merged
    // binding is Option[T] and never trips E0301. Resolve bound metavars first,
    // then unify an unbound α on either side against the other (tc_unify binds it
    // in place) and return the now-concrete side.
    let a = tc_resolve(a0)
    let b = tc_resolve(b0)
    if a == TYPE_UNKNOWN { return b }
    if b == TYPE_UNKNOWN { return a }
    if a == b { return a }
    if a < 0 || b < 0 { return a }
    if a >= ty_pool.len() || b >= ty_pool.len() { return a }
    if tc_is_unbound_metavar(a) != 0 {
        let _ = tc_unify(a, b)
        return tc_resolve(a)
    }
    if tc_is_unbound_metavar(b) != 0 {
        let _ = tc_unify(b, a)
        return tc_resolve(b)
    }
    let ta = ty_pool.get(a).unwrap()
    let tb = ty_pool.get(b).unwrap()
    if ta.kind != tb.kind { return a }
    if ta.kind == TyKind.List {
        let inner = type_merge(ta.inner1, tb.inner1)
        if inner == ta.inner1 { return a }
        if inner == tb.inner1 { return b }
        return make_list_type(inner)
    }
    if ta.kind == TyKind.Option {
        let inner = type_merge(ta.inner1, tb.inner1)
        if inner == ta.inner1 { return a }
        if inner == tb.inner1 { return b }
        return make_option_type(inner)
    }
    if ta.kind == TyKind.Set {
        let inner = type_merge(ta.inner1, tb.inner1)
        if inner == ta.inner1 { return a }
        if inner == tb.inner1 { return b }
        return make_set_type(inner)
    }
    if ta.kind == TyKind.Result {
        let i1 = type_merge(ta.inner1, tb.inner1)
        let i2 = type_merge(ta.inner2, tb.inner2)
        if i1 == ta.inner1 && i2 == ta.inner2 { return a }
        if i1 == tb.inner1 && i2 == tb.inner2 { return b }
        return make_result_type(i1, i2)
    }
    if ta.kind == TyKind.Map {
        let k = type_merge(ta.inner1, tb.inner1)
        let v = type_merge(ta.inner2, tb.inner2)
        if k == ta.inner1 && v == ta.inner2 { return a }
        if k == tb.inner1 && v == tb.inner2 { return b }
        return make_map_type(k, v)
    }
    a
}

// Short-form arm bodies parse as ExprStmt; unwrap so infer_type sees the expression.
fn infer_arm_body(arm: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let b = node_body(arm)
    if b == -1 { return TYPE_UNKNOWN }
    if node_kind(b) == NodeKind.ExprStmt {
        return infer_type(node_value(b))
    }
    infer_type(b)
}

fn type_kind(tid0: Int) -> TyKind {
    // Resolve bound metavars so a pinned α reports its solution's kind (gqg3rk).
    let tid = tc_resolve(tid0)
    if tid < 0 || tid >= ty_pool.len() { return TyKind.Unknown }
    ty_pool.get(tid).unwrap().kind
}

// Blink treats Int as truthy — Int is valid in Bool contexts
fn is_bool_compat(tid: Int) -> Int {
    if tid == TYPE_UNKNOWN { return 1 }
    if tid == TYPE_BOOL { return 1 }
    if tid == TYPE_INT { return 1 }
    let k = type_kind(tid)
    if k == TyKind.Bool || k == TyKind.Int { return 1 }
    0
}

pub fn is_sized_int(k: TyKind) -> Int {
    if k == TyKind.I8 || k == TyKind.I16 || k == TyKind.I32 { return 1 }
    if k == TyKind.U8 || k == TyKind.U16 || k == TyKind.U32 || k == TyKind.U64 { return 1 }
    0
}

fn is_integer_type(tid: Int) -> Int {
    if tid == TYPE_UNKNOWN { return 0 }
    let k = type_kind(tid)
    if k == TyKind.Int { return 1 }
    is_sized_int(k)
}

fn is_shift_amount_type(tid: Int, rhs_node: Int) -> Int {
    if tid == TYPE_UNKNOWN { return 1 }
    let k = type_kind(tid)
    if k == TyKind.U32 { return 1 }
    if k == TyKind.Int && rhs_node != -1 && node_kind(rhs_node) == NodeKind.IntLit { return 1 }
    0
}

fn tc_type_name(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    ty_pool.get(tid).unwrap().name
}

// vfgp72: the spec enum-vs-Int comparison exception (03_types.md:1093). An
// enum value stays comparable to an Int (shared tag representation), in EITHER
// operand order. This is what keeps the compiler's own 191 `node_kind(x) ==
// NodeKind.Y` comparisons legal after operand type-checking lands.
fn cmp_is_enum_int_pair(lt: Int, rt: Int) -> Int {
    let lk = type_kind(lt)
    let rk = type_kind(rt)
    // Int side may be plain Int OR a sized int; the enum side is TyKind.Enum.
    let l_int = lk == TyKind.Int || is_sized_int(lk) != 0
    let r_int = rk == TyKind.Int || is_sized_int(rk) != 0
    if lk == TyKind.Enum && r_int != 0 { return 1 }
    if rk == TyKind.Enum && l_int != 0 { return 1 }
    0
}

// vfgp72: builtin types that implement Eq+Ord per spec §3.6 (03_types.md:1822)
// but are represented as plain structs/kinds in the type pool (no @derive, no
// user impl). Instant/Duration are `{ nanos: Int }` structs; Bytes is TyKind.Bytes.
fn is_builtin_eq_ord_type(tid: Int) -> Int {
    let k = type_kind(tid)
    if k == TyKind.Bytes { return 1 }
    if k == TyKind.Struct {
        let n = tc_type_name(tid)
        if n == "Instant" || n == "Duration" { return 1 }
    }
    0
}

// vfgp72: are `lt`/`rt` valid comparison operands? `relational` distinguishes
// `<`/`>`/`<=`/`>=` (needs Ord) from `==`/`!=` (needs Eq). Callers handle the
// enum-vs-Int exception and int-literal coercion BEFORE calling this.
fn cmp_operands_ok(lt: Int, rt: Int, relational: Int) -> Int {
    let a = resolve_alias_tid(lt)
    let b = resolve_alias_tid(rt)
    let ka = type_kind(a)
    let kb = type_kind(b)

    // Fail-open on types we cannot model here, mirroring types_compatible:
    //   - TyKind.Typevar: generic `T <op> T` resolves at monomorphization (the
    //     concrete type's Eq/Ord is checked there).
    //   - TyKind.Void: an under-inferred value (e.g. an un-annotated closure return
    //     flowing through Bytes.with_ptr) types as Void; rejecting it would
    //     break programs that compiled before operand checking landed.
    if ka == TyKind.Typevar || kb == TyKind.Typevar { return 1 }
    if ka == TyKind.Void || kb == TyKind.Void { return 1 }

    // Int and Bool are interchangeable (C-style truthiness, mirroring
    // types_compatible:5132). `flag == 0`, `set.contains(x) != 0`, and
    // `true == false` are all pervasive Blink idioms. Bool participates only in
    // equality — it has Eq but not Ord (spec §3.6) — so relational against a Bool
    // operand falls through to the reject path below.
    let a_intbool = ka == TyKind.Int || ka == TyKind.Bool
    let b_intbool = kb == TyKind.Int || kb == TyKind.Bool
    if a_intbool != 0 && b_intbool != 0 {
        if relational != 0 && (ka == TyKind.Bool || kb == TyKind.Bool) { return 0 }
        return 1
    }

    // Scalars: same kind only (no implicit promotion), mirroring types_compatible.
    // Int<->sized-int literal coercion is handled by the caller. Float/Char and
    // sized ints compare within their own kind.
    let a_scalar = is_sized_int(ka) != 0 || ka == TyKind.Float || ka == TyKind.Char
    let b_scalar = is_sized_int(kb) != 0 || kb == TyKind.Float || kb == TyKind.Char
    if a_scalar != 0 && b_scalar != 0 {
        if ka == kb { return 1 }
        return 0
    }

    // Str: full Eq + Ord.
    if ka == TyKind.Str && kb == TyKind.Str { return 1 }

    // Option[T]: codegen only lowers ==/!= on matching inner; relational is rejected.
    if ka == TyKind.Option && kb == TyKind.Option {
        if relational != 0 { return 0 }
        return types_compatible(a, b)
    }

    // Same-enum comparison is intrinsic: an enum lowers to an integer tag, so
    // ==/!=/<… on two values of the SAME enum compares tags directly. This has
    // always been legal in Blink (no @derive required) and is what the bulk of
    // the compiler's own enum comparisons rely on. @derive(Eq/Ord) on an enum
    // only customizes semantics; it is not a precondition for comparing.
    if ka == TyKind.Enum && kb == TyKind.Enum {
        let an = tc_type_name(a)
        let bn = tc_type_name(b)
        if an == "" || an != bn { return 0 }
        return 1
    }

    // Builtin Eq+Ord types (Instant/Duration/Bytes): same type, any comparison.
    if is_builtin_eq_ord_type(a) != 0 && ka == kb {
        if ka == TyKind.Struct && tc_type_name(a) != tc_type_name(b) { return 0 }
        return 1
    }

    // User struct: must be the SAME nominal type and carry the right impl
    // (equality needs Eq, relational needs Ord) — structs have no intrinsic
    // comparison, so a bare struct compare is the genuine error case.
    if ka == TyKind.Struct && kb == TyKind.Struct {
        let an = tc_type_name(a)
        let bn = tc_type_name(b)
        if an != bn || an == "" { return 0 }
        if relational != 0 {
            return tc_type_has_ord_impl(an)
        }
        return tc_type_has_eq_impl(an)
    }

    0
}

fn type_bit_width(tid: Int) -> Int {
    let k = type_kind(tid)
    if k == TyKind.I8 || k == TyKind.U8 { return 8 }
    if k == TyKind.I16 || k == TyKind.U16 { return 16 }
    if k == TyKind.I32 || k == TyKind.U32 { return 32 }
    64
}

fn warn_bitwise_vs_comparison(child: Int, parent: Int, op: Str) ! TypeCheck.Report, Diag.Report {
    if child != -1 && node_kind(child) == NodeKind.BinOp && is_comparison_op(node_op(child)) {
        diag_warn_at("BitwisePrecedence", BITWISE_PRECEDENCE, "bitwise '{op}' applied to comparison result; use parentheses to clarify", parent, "wrap the comparison or the bitwise op in parentheses")
    }
}

fn check_bitwise_precedence(node: Int, op: Str) ! TypeCheck.Report, Diag.Report {
    warn_bitwise_vs_comparison(node_left(node), node, op)
    warn_bitwise_vs_comparison(node_right(node), node, op)
}

fn is_comparison_op(op: Str) -> Int {
    if op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=" { return 1 }
    0
}

// ── Phase 2: Expression type inference ──────────────────────────────

// Infer a carrier argument (Some/Ok/Err) with the construction hint unwrapped to the carried
// inner type, so a bare struct-style variant inside the carrier resolves against the right enum.
// Mirrors the pattern-path carrier unwrap. carrier is "Some" | "Ok" | "Err".
fn infer_carrier_arg(arg_node: Int, carrier: Str) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let saved_hint = tc_construct_hint
    let k = type_kind(tc_construct_hint)
    if carrier == "Err" {
        if tc_construct_hint >= 0 && k == TyKind.Result { tc_construct_hint = ty_pool.get(tc_construct_hint).unwrap().inner2 }
    } else if (carrier == "Some" && k == TyKind.Option) || (carrier == "Ok" && k == TyKind.Result) {
        if tc_construct_hint >= 0 { tc_construct_hint = ty_pool.get(tc_construct_hint).unwrap().inner1 }
    }
    let inner = infer_type(arg_node)
    tc_construct_hint = saved_hint
    inner
}

fn infer_type(node: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let tid = infer_type_uncached(node)
    if node != -1 && node < tc_node_tid.len() {
        // Never downgrade a known memo to UNKNOWN. -1 is the unset sentinel (TYPE_INT
        // is 0), so a never-inferred node still takes the write, and known->known
        // overwrites are preserved: mono-calls-mono re-instantiates one AST node under
        // several T.
        //
        // The producer this guard was written for is GONE (br r9krgr): tc_check_fn used
        // to re-infer the body for its declared-return check AFTER tc_check_body popped
        // the body scope, so a tail-position generic call's ident args read UNKNOWN
        // there and clobbered the concrete tid. That compare now runs inside the Block
        // arm, in scope, and never re-infers. The guard is kept because it is not known
        // to be the only out-of-scope re-infer — proving that and retiring it is br
        // kdskwh. Do not treat this comment as evidence that a live producer remains.
        if tid != TYPE_UNKNOWN || tc_node_tid.get(node).unwrap() == -1 {
            tc_node_tid.set(node, tid)
        }
    }
    tid
}

pub fn tc_lookup_node_tid(node: Int) -> Int {
    if node == -1 { return -1 }
    if node >= tc_node_tid.len() { return -1 }
    tc_node_tid.get(node).unwrap()
}

fn infer_type_uncached(node: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if node == -1 { return TYPE_UNKNOWN }
    let kind = node_kind(node)

    if kind == NodeKind.IntLit { return TYPE_INT }
    if kind == NodeKind.FloatLit { return TYPE_FLOAT }
    if kind == NodeKind.BoolLit { return TYPE_BOOL }
    if kind == NodeKind.CharLit { return TYPE_CHAR }
    if kind == NodeKind.InterpString {
        // Infer each embedded expression so per-expression checks (e.g. the
        // '+'-on-Str rejection) fire inside interpolations. Skip literal text
        // runs to avoid resolving them as variables.
        let parts_sl = node_elements(node)
        if parts_sl != -1 {
            let mut pi = 0
            while pi < sublist_length(parts_sl) {
                let part = sublist_get(parts_sl, pi)
                if is_interp_literal_part(part) == 0 {
                    let ptid = infer_type(part)
                    // Spec §3.6 (DECISIONS.md:191-192): every interpolated
                    // expression must be Display. No Debug fallback. Skip
                    // unresolved/generic types (helper returns 0 there, but
                    // Display is unknowable — erroring would false-reject and
                    // brick `task regen`).
                    let pk = type_kind(ptid)
                    if pk != TyKind.Unknown && pk != TyKind.Typevar && tc_type_id_has_display(ptid) == 0 {
                        tc_errors.push("interpolated value of type '{type_to_str(ptid)}' does not implement Display")
                        diag_error_at("MissingDisplayImpl", MISSING_DISPLAY_IMPL, "type '{type_to_str(ptid)}' does not implement Display", part, "add '@derive(Display)' or implement Display manually; use '.debug()' for structural form")
                    }
                }
                pi = pi + 1
            }
        }
        return TYPE_STR
    }
    if kind == NodeKind.EmbedExpr { return TYPE_STR }

    // br hgd2az. `channel.new[Str](buffer: 4)` is the spec's own constructor
    // (sections/04_effects.md:1751) and it writes the element type down at the construction
    // site; the parser already keeps it (parser.bl:2885 stores `type_params`). With no arm
    // here the node inferred TYPE_UNKNOWN, so the type that was spelled out explicitly was
    // discarded and the consumption seams fell back to the fabricated CT_INT element.
    //
    // The type argument is read by NAME, not through resolve_type_ann: parse_type_params
    // builds a NodeKind.TypeParam whose `elements` are trait BOUNDS (parser.bl:1104-1113),
    // not type arguments, and handing those to resolve_type_parts as type args would read
    // `[T: Ord]`'s bound as an element. That also means a nested argument
    // (`channel.new[List[Int]]`) is a parse limitation upstream, not a hole here.
    if kind == NodeKind.ChannelNew {
        let cn_tps = node_type_params(node)
        if cn_tps != -1 && sublist_length(cn_tps) >= 1 {
            let cn_tp = sublist_get(cn_tps, 0)
            return make_channel_type(resolve_type_parts(node_name(cn_tp), -1, cn_tp))
        }
        return make_channel_type(TYPE_UNKNOWN)
    }

    if kind == NodeKind.Ident {
        let name = node_name(node)
        if name == "true" || name == "false" { return TYPE_BOOL }
        if name == "None" { return make_option_type(make_metavar()) }
        let vt = nr_get_type(name)
        if vt != TYPE_UNKNOWN { return vt }
        if is_variant_name(name) != 0 {
            return get_variant_enum_tid(name)
        }
        return TYPE_UNKNOWN
    }

    if kind == NodeKind.BinOp {
        let op = node_op(node)
        let lt = infer_type(node_left(node))
        let rt = infer_type(node_right(node))

        if is_comparison_op(op) {
            // vfgp72: comparison operators desugar to Eq.eq / Ord.cmp and require
            // same-type operands (spec 03_types.md:1809). Validate when both sides
            // are known, preserving the enum-vs-Int representation exception
            // (03_types.md:1093) and untyped-int-literal coercion to a sized int.
            if lt != TYPE_UNKNOWN && rt != TYPE_UNKNOWN {
                if cmp_is_enum_int_pair(lt, rt) == 0 {
                    let lit_r = is_sized_int(type_kind(lt)) != 0 && rt == TYPE_INT && is_int_literal_node(node_right(node)) != 0
                    let lit_l = is_sized_int(type_kind(rt)) != 0 && lt == TYPE_INT && is_int_literal_node(node_left(node)) != 0
                    if lit_r == 0 && lit_l == 0 {
                        let relational = if op == "==" || op == "!=" { 0 } else { 1 }
                        if cmp_operands_ok(lt, rt, relational) == 0 {
                            tc_error_at("binary '{op}': incompatible types {type_to_str(lt)} and {type_to_str(rt)}", node)
                        }
                    }
                }
            }
            return TYPE_BOOL
        }
        if op == "&&" || op == "||" {
            if is_bool_compat(lt) == 0 {
                tc_error_at("logical operator '{op}' requires Bool operands, got {type_to_str(lt)}", node)
            }
            if is_bool_compat(rt) == 0 {
                tc_error_at("logical operator '{op}' requires Bool operands, got {type_to_str(rt)}", node)
            }
            return TYPE_BOOL
        }
        if op == "+" && (type_kind(lt) == TyKind.Str || type_kind(rt) == TyKind.Str) {
            if lt != TYPE_UNKNOWN && rt != TYPE_UNKNOWN {
                diag_error_at("StrPlusUnsupported", STR_PLUS_UNSUPPORTED,
                    "'+' does not work on Str", node,
                    "use .concat() to join two strings, or string interpolation to embed a value")
            }
            return TYPE_STR
        }
        if op == "+" || op == "-" || op == "*" || op == "/" || op == "%" {
            // A bare int literal takes its type from the surrounding expression
            // (spec sections/03_types.md:874), so `a * 2` with `a: I32` treats
            // `2` as I32 and yields I32 — not a rejected `I32 * Int`. Coerce a
            // literal operand toward the other side's sized-int type, on either
            // side (br fsq5ma). The sized result then chains through nested ops.
            let lit_to_sized_r = is_sized_int(type_kind(lt)) && rt == TYPE_INT && is_int_literal_node(node_right(node))
            let lit_to_sized_l = is_sized_int(type_kind(rt)) && lt == TYPE_INT && is_int_literal_node(node_left(node))
            if lit_to_sized_r { return lt }
            if lit_to_sized_l { return rt }
            if lt != TYPE_UNKNOWN && rt != TYPE_UNKNOWN {
                if types_compatible(lt, rt) == 0 {
                    tc_error_at("binary '{op}': incompatible types {type_to_str(lt)} and {type_to_str(rt)}", node)
                }
            }
            // Arithmetic on a Bool operand yields an integer count, not a Bool
            // (e.g. `(a != 0) + (b != 0)`). Without this, the sum is typed Bool
            // and a later `sum <= 1` would wrongly look like a Bool relational
            // (vfgp72). Bool is int64_t-repped, so this matches the emitted C.
            if lt == TYPE_BOOL && rt == TYPE_BOOL { return TYPE_INT }
            if lt == TYPE_BOOL && rt != TYPE_UNKNOWN { return rt }
            if rt == TYPE_BOOL && lt != TYPE_UNKNOWN { return lt }
            if lt != TYPE_UNKNOWN { return lt }
            return rt
        }
        if op == "&" || op == "|" || op == "^" {
            check_bitwise_precedence(node, op)
            if lt != TYPE_UNKNOWN && is_integer_type(lt) == 0 {
                tc_error_at("bitwise '{op}' requires integer operand, got {type_to_str(lt)}", node)
            }
            if rt != TYPE_UNKNOWN && is_integer_type(rt) == 0 {
                tc_error_at("bitwise '{op}' requires integer operand, got {type_to_str(rt)}", node)
            }
            if lt != TYPE_UNKNOWN && rt != TYPE_UNKNOWN && types_compatible(lt, rt) == 0 {
                tc_error_at("bitwise '{op}': incompatible types {type_to_str(lt)} and {type_to_str(rt)}", node)
            }
            if lt != TYPE_UNKNOWN { return lt }
            return rt
        }
        if op == "<<" || op == ">>" {
            check_bitwise_precedence(node, op)
            if lt != TYPE_UNKNOWN && is_integer_type(lt) == 0 {
                tc_error_at("shift '{op}' requires integer left operand, got {type_to_str(lt)}", node)
            }
            let rhs = node_right(node)
            if rt != TYPE_UNKNOWN && is_shift_amount_type(rt, rhs) == 0 {
                tc_error_at("shift '{op}' amount must be U32, got {type_to_str(rt)}", node)
            }
            if lt != TYPE_UNKNOWN && rhs != -1 && node_kind(rhs) == NodeKind.IntLit {
                let amt = node_str_val(rhs).to_int()
                let bw = type_bit_width(lt)
                if amt < 0 || amt >= bw {
                    tc_error_at("shift '{op}' amount {amt} out of range for {type_to_str(lt)} (must be 0..{bw})", node)
                }
            }
            if lt != TYPE_UNKNOWN { return lt }
            return TYPE_INT
        }
        if op == "??" {
            let left_k = type_kind(lt)
            if left_k != TyKind.Option && left_k != TyKind.Unknown {
                tc_error_at("'??' operator requires Option value, got {type_to_str(lt)}", node)
            }
            if left_k == TyKind.Option {
                // `y ?? default` is a constraining use (gqg3rk): the default's type
                // pins the Option's element α (`None ?? 99` infers y : Int?). Unify
                // the (possibly-metavar) inner with the default type.
                let opt = tc_resolve(lt)
                let inner = ty_pool.get(opt).unwrap().inner1
                if tc_tid_has_unbound_metavar(inner) != 0 { let _ = tc_unify(inner, rt) }
                return tc_resolve(inner)
            }
            return rt
        }
        if lt != TYPE_UNKNOWN { return lt }
        return rt
    }

    if kind == NodeKind.UnaryOp {
        let op = node_op(node)
        let operand = infer_type(node_left(node))
        if op == "!" { return TYPE_BOOL }
        if op == "-" { return operand }
        if op == "~" {
            if operand != TYPE_UNKNOWN && is_integer_type(operand) == 0 {
                tc_error_at("bitwise '~' requires integer operand, got {type_to_str(operand)}", node)
            }
            return operand
        }
        if op == "?" {
            let ok = type_kind(operand)
            if ok == TyKind.Result {
                let operand_err = ty_pool.get(operand).unwrap().inner2
                if tc_in_test_body == 1 {
                    // Spec §2.20 / §3c.2: inside a test body E is rendered via
                    // Display.display(e), not structurally propagated. Skip the
                    // E0512/E0508 gates; require Display[E] (E0514). Skip when E
                    // is unresolved/generic (helper returns 0 there).
                    let k = type_kind(operand_err)
                    if k != TyKind.Unknown && k != TyKind.Typevar && tc_type_id_has_display(operand_err) == 0 {
                        tc_errors.push("'?' on Result in test body requires error type '{type_to_str(operand_err)}' to implement Display")
                        diag_error_at("QuestionMarkTestDisplayRequired", QM_TEST_DISPLAY_REQUIRED, "'?' in a test body requires the error type '{type_to_str(operand_err)}' to implement Display", node, "implement 'impl Display for {type_to_str(operand_err)}' or '.unwrap()' the Result explicitly")
                    }
                } else if tc_current_fn_ret >= 0 && tc_current_fn_ret < ty_pool.len() {
                    let ret_kind = ty_pool.get(tc_current_fn_ret).unwrap().kind
                    if ret_kind != TyKind.Result && ret_kind != TyKind.Unknown {
                        tc_errors.push("'?' on Result in function '{tc_current_fn_name}' which does not return Result")
                        diag_error_at("QuestionMarkResultInNonResult", QM_RESULT_IN_NON_RESULT, "'?' on Result in function '{tc_current_fn_name}' which does not return Result", node, "change the return type to Result[T, E]")
                    } else if ret_kind == TyKind.Result {
                        let ret_err = ty_pool.get(tc_current_fn_ret).unwrap().inner2
                        if types_compatible(operand_err, ret_err) == 0 {
                            tc_errors.push("'?' error type mismatch in function '{tc_current_fn_name}'")
                            diag_error_at("QuestionMarkErrorMismatch", QM_ERROR_MISMATCH, "'?' error type mismatch: operand error type does not match return error type in '{tc_current_fn_name}'", node, "ensure the error types are compatible")
                        }
                    }
                }
                return ty_pool.get(operand).unwrap().inner1
            }
            if ok == TyKind.Option {
                // Spec §2.20: in a test body `?` on Option is permitted —
                // None propagates as a fixed-message TestError. The
                // elaborated return is Result[Void, TestError] (not Option),
                // so suppress the QM-Option-in-non-Option gate here.
                if tc_in_test_body == 0 && tc_current_fn_ret >= 0 && tc_current_fn_ret < ty_pool.len() {
                    let ret_kind = ty_pool.get(tc_current_fn_ret).unwrap().kind
                    if ret_kind != TyKind.Option && ret_kind != TyKind.Unknown {
                        tc_errors.push("'?' on Option in function '{tc_current_fn_name}' which does not return Option")
                        diag_error_at("QuestionMarkOptionInNonOption", QM_OPTION_IN_NON_OPTION, "'?' on Option in function '{tc_current_fn_name}' which does not return Option", node, "change the return type to Option[T]")
                    }
                }
                return ty_pool.get(operand).unwrap().inner1
            }
            if ok != TyKind.Unknown {
                tc_errors.push("'?' requires Result or Option value")
                diag_error_at("QuestionMarkInvalidOperand", QM_INVALID_OPERAND, "'?' requires a Result or Option value", node, "")
            }
            return operand
        }
        return operand
    }

    if kind == NodeKind.Call {
        let callee = node_left(node)
        if callee != -1 {
            let callee_kind = node_kind(callee)
            if callee_kind == NodeKind.Ident {
                let mut fn_name = node_name(callee)
                fn_name = tc_alias_to_original.get(fn_name) ?? fn_name
                if fn_name == "Some" {
                    let args_sl = node_args(node)
                    if args_sl != -1 && sublist_length(args_sl) >= 1 {
                        let inner = infer_carrier_arg(sublist_get(args_sl, 0), "Some")
                        return make_option_type(inner)
                    }
                    return make_option_type(TYPE_UNKNOWN)
                }
                if fn_name == "Ok" {
                    let args_sl = node_args(node)
                    if args_sl != -1 && sublist_length(args_sl) >= 1 {
                        let inner = infer_carrier_arg(sublist_get(args_sl, 0), "Ok")
                        return make_result_type(inner, TYPE_UNKNOWN)
                    }
                    return make_result_type(TYPE_UNKNOWN, TYPE_UNKNOWN)
                }
                if fn_name == "Err" {
                    let args_sl = node_args(node)
                    if args_sl != -1 && sublist_length(args_sl) >= 1 {
                        let inner = infer_carrier_arg(sublist_get(args_sl, 0), "Err")
                        return make_result_type(TYPE_UNKNOWN, inner)
                    }
                    return make_result_type(TYPE_UNKNOWN, TYPE_UNKNOWN)
                }
                if fn_name == "Raw" {
                    let args_sl = node_args(node)
                    if args_sl != -1 && sublist_length(args_sl) >= 1 {
                        return infer_type(sublist_get(args_sl, 0))
                    }
                    return TYPE_STR
                }
                if fn_name == "skip" {
                    tc_fence_test_only_symbol("skip", SKIP_OUTSIDE_TEST, "SkipOutsideTest", node)
                    let args_sl = node_args(node)
                    let arg_count = if args_sl != -1 { sublist_length(args_sl) } else { 0 }
                    if arg_count != 1 {
                        tc_error_at("skip() expects 1 argument (reason: Str), got {arg_count}", node)
                    } else {
                        let arg_t = infer_type(sublist_get(args_sl, 0))
                        if arg_t != TYPE_UNKNOWN && arg_t != TYPE_STR {
                            tc_error_at("skip() reason must be Str, got {type_to_str(arg_t)}", node)
                        }
                    }
                    return TYPE_VOID
                }
                if is_builtin_fn(fn_name) != 0 {
                    // Infer args so nested expressions (e.g. a method call passed
                    // to println) are type-checked — variadic builtins otherwise
                    // skip arg inference, hiding errors like E0522 (sb3125).
                    let bf_args = node_args(node)
                    if bf_args != -1 {
                        let mut bai = 0
                        while bai < sublist_length(bf_args) {
                            infer_type(sublist_get(bf_args, bai))
                            bai = bai + 1
                        }
                    }
                    return get_builtin_fn_ret(fn_name)
                }
                if is_variant_name(fn_name) != 0 {
                    // Arity-check only when the variant name is unambiguous. An
                    // ambiguous name (declared by >1 enum) keeps deferring to the
                    // existing E0519 AmbiguousConstruction cascade rather than
                    // guessing which variant's field count to compare against.
                    if count_enums_with_variant(fn_name) == 1 {
                        let var_idx = get_variant_var_idx(fn_name)
                        if var_idx != -1 {
                            let expected = variant_field_count(var_idx)
                            let args_sl = node_args(node)
                            let arg_count = if args_sl != -1 { sublist_length(args_sl) } else { 0 }
                            if arg_count != expected {
                                tc_error_at("variant '{fn_name}' expects {expected} argument(s), got {arg_count}", node)
                            }
                        }
                    }
                    let venum = get_variant_enum_tid(fn_name)
                    // A generic-enum variant (`Leaf(1)`) reverse-infers its concrete
                    // instance tid (`Tree[Int]`) from the ctor args so codegen mono's
                    // it; a non-generic enum keeps the bare tid (jjhnf3).
                    let vdecl = tc_variant_enum_decl_nodes.get(fn_name) ?? -1
                    return tc_enum_ctor_instance_tid(venum, vdecl, fn_name, node_args(node))
                }
                // Local lexical scope shadows module-level definitions
                // (sections/02_syntax.md:671-680, 07_trust_modules_metadata.md:1042).
                // A closure parameter named `f` (e.g. list_fold's `f: fn(U,T)->U`)
                // must NOT resolve against a same-named top-level fn — doing so
                // applied the global fn's arity to the closure call and produced a
                // spurious TypeError inside the stdlib (br 3vfae9). When the name
                // is bound in local scope, it wins: infer the args (so nested
                // expressions are still type-checked) and, if the local binding is
                // a structured fn type, arity/type-check against THAT; otherwise
                // return its type without consulting the global fnsig.
                //
                // The TyKind.Fn branch below was dead until br nz7drz — closure
                // literals inferred TYPE_UNKNOWN and `fn(..)` annotations lowered to
                // TyKind.Typevar("Fn"), so a locally-bound callable never had a
                // structured tid to check against. It is the live path now, and it is
                // what makes `let g = c` followed by `g(21)` arity-checked.
                let local_tid = nr_get_type(fn_name)
                if local_tid != TYPE_UNKNOWN {
                    let call_args_sl = node_args(node)
                    if type_kind(local_tid) == TyKind.Fn {
                        return tc_check_call_against_fn_tid(local_tid, call_args_sl, "function '{fn_name}'", node)
                    }
                    if call_args_sl != -1 {
                        let mut li = 0
                        while li < sublist_length(call_args_sl) {
                            infer_type(sublist_get(call_args_sl, li))
                            li = li + 1
                        }
                    }
                    return TYPE_UNKNOWN
                }
                let sig = lookup_fnsig(fn_name)
                if sig != -1 {
                    check_deprecated_fn(fn_name, node)
                    let args_sl = node_args(node)
                    let mut arg_count = 0
                    if args_sl != -1 {
                        arg_count = sublist_length(args_sl)
                    }
                    let fs = fnsig_pool.get(sig).unwrap()
                    if arg_count != fs.params_count {
                        let expected = fs.params_count
                        tc_error_at("function '{fn_name}' expects {expected} argument(s), got {arg_count}", node)
                    }
                    check_arg_shapes(fn_name, sig, args_sl, 0)
                    if fs.type_params_count > 0 {
                        // gqg3rk: pin any metavar-carrying arg from the call's resolved
                        // typevar binds, so `fill(Map(), 256, "x")` (K→Int, V→Str from
                        // the sibling args) codegens the Map() with the right kops
                        // instead of the erased str default (a silent miscompile). If a
                        // typevar is genuinely unbound (no arg pins it), the arg's α
                        // stays unbound and E0301 fires at its own binding/boundary.
                        // instantiate_return_type re-infers every arg via
                        // build_typevar_binds, which re-mints a fresh (unbound)
                        // Map[α,α]/Set[α] for a bare ctor arg and CLOBBERS the
                        // node's memoized tid. So compute the return type FIRST,
                        // then pin LAST — the pin's own final infer_type per arg
                        // leaves the bound metavars in the node memo for codegen
                        // to read (m1wspm).
                        let ret_t = instantiate_return_type(sig, args_sl, node)
                        tc_pin_generic_args_from_binds(sig, args_sl, 0)
                        return ret_t
                    }
                    return fs.ret
                }
            } else if callee_kind == NodeKind.FieldAccess {
                // Infer args so nested expressions in a module-qualified call
                // (e.g. io.println(x.m())) are type-checked — otherwise this
                // branch returns without descending, hiding E0522 (sb3125).
                let fa_args = node_args(node)
                if fa_args != -1 {
                    let mut fai = 0
                    while fai < sublist_length(fa_args) {
                        infer_type(sublist_get(fa_args, fai))
                        fai = fai + 1
                    }
                }
                let obj = node_obj(callee)
                if obj != -1 && node_kind(obj) == NodeKind.Ident {
                    let type_name = node_name(obj)
                    let tid = lookup_named_type(type_name)
                    if tid != -1 { return tid }
                }
            } else if callee_kind == NodeKind.Closure {
                // br x3x0qj: an immediately-invoked closure literal. This arm had branches for
                // an Ident and a FieldAccess callee only, so an IIFE fell through to the
                // TYPE_UNKNOWN below without its arguments being inferred — and TYPE_UNKNOWN
                // unifies with anything, which made `let bad: Str = fn() -> Int { 7 }()` a
                // silent miscompile rather than a TypeError. The Closure arm of infer_type
                // already answers a real TyKind.Fn tid built from the literal's own
                // annotations, so this is dispatch, not new inference: the same checking the
                // closure-VARIABLE path above performs, against the same kind of tid.
                let cls_tid = infer_type(callee)
                if type_kind(cls_tid) == TyKind.Fn {
                    return tc_check_call_against_fn_tid(cls_tid, node_args(node), "closure", node)
                }
                // No structured tid (an un-annotated literal): still infer the arguments, so
                // nested expressions in them are checked, then fall through to TYPE_UNKNOWN.
                let cls_args = node_args(node)
                if cls_args != -1 {
                    let mut cai = 0
                    while cai < sublist_length(cls_args) {
                        infer_type(sublist_get(cls_args, cai))
                        cai = cai + 1
                    }
                }
            }
        }
        return TYPE_UNKNOWN
    }

    if kind == NodeKind.MethodCall {
        let obj_node = node_obj(node)
        let method = node_method(node)

        // br e0wmt6: `async.spawn(f)` is Handle[T] for f's return type T. It parses as an
        // ordinary MethodCall on the `async` module — NodeKind.AsyncSpawn has no producer
        // anywhere in src/ or lib/ and is a dead variant — so the answer belongs here rather
        // than in an AsyncSpawn arm. The nr_get_type guard mirrors codegen's mc_obj_is_local
        // check: a local named `async` must not be mistaken for the module.
        if obj_node != -1 && node_kind(obj_node) == NodeKind.Ident && node_name(obj_node) == "async" && method == "spawn" {
            if nr_get_type("async") == TYPE_UNKNOWN {
                let sp_args = node_args(node)
                if sp_args != -1 && sublist_length(sp_args) >= 1 {
                    let sp_cls = sublist_get(sp_args, 0)
                    if node_kind(sp_cls) == NodeKind.Closure {
                        // A DECLARED return wins; otherwise infer the body's tail, because
                        // tc_closure_declared_ret answers TYPE_VOID for an un-annotated
                        // closure and the corpus form is `async.spawn(fn() { compute(100) })`
                        // — taking Void there would make every `.await` on it Void. The body
                        // is only inferred for a zero-param closure (spawn's shape), so no
                        // param binding is needed for the walk to be sound.
                        if node_type_ann(sp_cls) != -1 {
                            return make_handle_type(tc_closure_declared_ret(sp_cls))
                        }
                        let sp_params = node_params(sp_cls)
                        if sp_params == -1 || sublist_length(sp_params) == 0 {
                            return make_handle_type(infer_type(node_body(sp_cls)))
                        }
                    }
                }
            }
        }

        // 8v0cpr: a variant name (e.g. `Key`) can shadow an enum type name when
        // `Key` is also a variant of another enum (`Event.Key`). For qualified
        // construction `Enum.Variant(...)`, resolve the obj as a TYPE first when
        // there is no real local of that name — otherwise Ident inference picks
        // the shadowing variant's enum and `.Variant` fails to resolve.
        if obj_node != -1 && node_kind(obj_node) == NodeKind.Ident {
            let cname = node_name(obj_node)
            if nr_get_type(cname) == TYPE_UNKNOWN {
                let ctor_tid = lookup_named_type(cname)
                if ctor_tid != -1 && type_kind(ctor_tid) == TyKind.Enum {
                    let cvar_idx = get_variant_by_name(ctor_tid, method)
                    if cvar_idx != -1 {
                        let cargs_sl = node_args(node)
                        // 6zrkwk: arity-check the qualified ctor, mirroring the
                        // bare-Ident variant path (8tk637). The per-arg loop below
                        // only checks value types, not the count.
                        let cexpected = variant_field_count(cvar_idx)
                        let cgot = if cargs_sl != -1 { sublist_length(cargs_sl) } else { 0 }
                        if cgot != cexpected {
                            tc_error_at("variant '{method}' expects {cexpected} argument(s), got {cgot}", node)
                        }
                        if cargs_sl != -1 {
                            let mut i = 0
                            while i < sublist_length(cargs_sl) {
                                let carg = sublist_get(cargs_sl, i)
                                let mut cval = carg
                                let mut cftid = TYPE_UNKNOWN
                                if node_kind(carg) == NodeKind.NamedArg {
                                    cval = node_value(carg)
                                    cftid = lookup_evfield_type_by_name(cvar_idx, node_name(carg))
                                } else {
                                    cftid = lookup_evfield_type_by_index(cvar_idx, i)
                                }
                                check_arg_value("{cname}.{method}", i, cftid, cval)
                                i = i + 1
                            }
                        }
                        // A generic-enum qualified ctor (`Tree.Leaf(1)`) reverse-infers
                        // its concrete instance tid; a non-generic enum keeps the bare
                        // ctor_tid (jjhnf3).
                        let cdecl = tc_type_decl_nodes.get(cname) ?? -1
                        return tc_enum_ctor_instance_tid(ctor_tid, cdecl, method, cargs_sl)
                    }
                }
            }
        }

        // 7cq6w2: StringBuilder's two static constructors, resolved from the receiver's
        // NAME before the receiver is inferred as a value.
        //
        // The ordering is load-bearing. `StringBuilder` is a builtin type with no Blink
        // declaration, so a bare Ident spelling it has nothing to resolve to — except that
        // an enum in scope may own a variant of the same name, and bare-variant resolution
        // then infers the Ident as THAT ENUM. typecheck's own TyKind has exactly such a
        // variant (and a `Char` one, the same hazard for `Char.from_code_point`), so any
        // file importing TyKind and calling `StringBuilder.new()` — tests/, and any future
        // compiler module — would reach the Struct/Enum branch below and be rejected with
        // E0505 "unresolved method '.new' on type TyKind". Deciding on the name first
        // cannot be shadowed that way.
        //
        // A local genuinely named `StringBuilder` still wins: it is a value, and a value
        // receiver is not a static call.
        if obj_node != -1 && node_kind(obj_node) == NodeKind.Ident {
            if node_name(obj_node) == "StringBuilder" && nr_is_defined("StringBuilder") == 0 {
                if method == "new" { return type_stringbuilder() }
                // Kept beside `new` rather than folded into get_builtin_fn_ret, which is
                // keyed on the type name alone and so cannot tell two constructors apart.
                if method == "with_capacity" {
                    check_builtin_arg(method, 0, TYPE_INT, node_args(node), "StringBuilder")
                    return type_stringbuilder()
                }
            }
        }

        let obj_t = infer_type(obj_node)
        let obj_k = type_kind(obj_t)

        // 4q2etk: replaced by mwxtyj — builtin scalar Display:
        // display() -> Str and fmt(sb) on Int/Float/Bool/Str/Char.
        if obj_k == TyKind.Int || obj_k == TyKind.Float || obj_k == TyKind.Bool || obj_k == TyKind.Str || obj_k == TyKind.Char {
            if method == "display" { return TYPE_STR }
            if method == "fmt" { return TYPE_VOID }
        }

        if obj_k == TyKind.List {
            let args_sl = node_args(node)
            let elem = ty_pool.get(obj_t).unwrap().inner1
            if method == "len" || method == "count" { return TYPE_INT }
            if method == "get" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "List")
                return make_option_type(elem)
            }
            if method == "push" {
                check_builtin_arg(method, 0, elem, args_sl, "List")
                return TYPE_VOID
            }
            if method == "set" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "List")
                check_builtin_arg(method, 1, elem, args_sl, "List")
                return TYPE_VOID
            }
            // dvzt90: `pop` was sharing `clear`'s arm. It removes AND RETURNS the last
            // element (`sections/03_types.md:390`, `lib/std/traits.bl:56`
            // `fn pop(self) -> Option[T]`), and codegen has built that Option since gemr3z
            // (src/codegen_methods.bl:1285) — typecheck was the only phase saying Void.
            if method == "pop" { return make_option_type(elem) }
            if method == "clear" { return TYPE_VOID }
            if method == "for_each" {
                check_closure_param(closure_arg_at(args_sl, 0), 0, elem, method, "List")
                return TYPE_VOID
            }
            if method == "take" || method == "skip" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "List")
                return obj_t
            }
            if method == "slice" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "List")
                check_builtin_arg(method, 1, TYPE_INT, args_sl, "List")
                return obj_t
            }
            if method == "concat" {
                check_builtin_arg(method, 0, obj_t, args_sl, "List")
                return obj_t
            }
            // br jvy35h: `join` reached here as a NAME with no type. It is in
            // is_builtin_method (:6299) — which is what lets it past the E0505
            // and W0501 gates — and codegen has always emitted
            // `str_join(obj, delim) -> CT_STRING` (codegen_methods.bl:1620), so
            // the C was right and typecheck said TYPE_UNKNOWN. That unified with
            // anything four ways: `let bad: Int = parts.join(",")` ran and
            // printed `a,b`; a non-Str separator reached cc; and, because
            // nothing checked the RECEIVER, `[1, 2].join(",")` segfaulted inside
            // str_join reading int64 as `const char*` while
            // `[["a"], ["b"]].join(",")` printed binary noise at exit 0.
            //
            // sections/03_types.md:227-238 spells the impl header exactly —
            // `impl Joinable for List[Str]`, `fn join(self, separator: Str) ->
            // Str` — and the sealed-trait table at :521 reads
            // `Joinable | List[Str] | join`. So BOTH the separator and the
            // element type are pinned by the spec, not chosen here.
            //
            // The element check fails open on Unknown and Typevar. type_kind
            // resolves a bound metavar, so a pinned α reads as its solution;
            // what is left is a genuinely unresolved element — a typevar in a
            // generic fn body (`fn f[T](xs: List[T]) -> Str { xs.join(",") }`)
            // cannot be judged at the definition site, and whether that shape
            // should require a bound is a spec question about generic bounds.
            if method == "join" {
                check_builtin_arg(method, 0, TYPE_STR, args_sl, "List")
                let ek = type_kind(elem)
                if ek != TyKind.Str && ek != TyKind.Unknown && ek != TyKind.Typevar {
                    tc_error_at("List.join requires List[Str], got {type_to_str(obj_t)}", node)
                }
                return TYPE_STR
            }
            if method == "map" {
                let cls = closure_arg_at(args_sl, 0)
                check_closure_param(cls, 0, elem, method, "List")
                if cls == -1 { return obj_t }
                let ret_str = node_return_type(cls)
                if ret_str == "" { return obj_t }
                let u = resolve_type_name(ret_str)
                if u != -1 { return make_list_type(u) }
                return obj_t
            }
            if method == "filter" {
                let cls = closure_arg_at(args_sl, 0)
                check_closure_param(cls, 0, elem, method, "List")
                check_closure_ret(cls, TYPE_BOOL, method, "List")
                return obj_t
            }
            if method == "collect" {
                // No closure argument — nothing to validate.
                return obj_t
            }
            if method == "contains" {
                check_builtin_arg(method, 0, elem, args_sl, "List")
                return TYPE_BOOL
            }
            if method == "is_empty" { return TYPE_BOOL }
            if method == "any" || method == "all" {
                let cls = closure_arg_at(args_sl, 0)
                check_closure_param(cls, 0, elem, method, "List")
                check_closure_ret(cls, TYPE_BOOL, method, "List")
                return TYPE_BOOL
            }
            if method == "find" {
                let cls = closure_arg_at(args_sl, 0)
                check_closure_param(cls, 0, elem, method, "List")
                check_closure_ret(cls, TYPE_BOOL, method, "List")
                return make_option_type(elem)
            }
            if method == "fold" {
                if args_sl != -1 && sublist_length(args_sl) >= 2 {
                    let acc_t = infer_type(sublist_get(args_sl, 0))
                    let cls = sublist_get(args_sl, 1)
                    check_closure_param(cls, 0, acc_t, method, "List")
                    check_closure_param(cls, 1, elem, method, "List")
                    check_closure_ret(cls, acc_t, method, "List")
                    return acc_t
                } else if args_sl != -1 && sublist_length(args_sl) >= 1 {
                    return infer_type(sublist_get(args_sl, 0))
                }
                return TYPE_UNKNOWN
            }
        }

        // 9myrp2: a user poly-impl method on a List receiver — the canonical
        // `impl[T] Trait[T] for List[T]` form. Placed AFTER the builtin List
        // block so every builtin method has already returned (builtins win,
        // untouched). Resolve the sole owning trait's fnsig and return its
        // `-> T` return type with the impl binder substituted by the receiver's
        // element tid, so the method-call node memoizes a concrete tid instead
        // of TYPE_UNKNOWN. Only the canonical single-binder shape registered in
        // tc_poly_list_impl_node; any other shape leaves `im == -1` and this
        // block does nothing, falling through to today's arg-inference loop and
        // TYPE_UNKNOWN — no path regresses.
        if obj_k == TyKind.List {
            let sole_trait = tc_method_trait_names("List", method)
            if sole_trait != "" && tc_method_trait_count("List", method) == 1 {
                let sig_name = "List_{sole_trait}_{method}"
                let sig = lookup_fnsig(sig_name)
                if sig != -1 {
                    let im = tc_poly_list_impl_node.get(sig_name) ?? -1
                    // The registry only ever holds nodes that passed the
                    // canonical single-binder gate at registration, so binders
                    // is a length-1 sublist here. Re-check defensively so a
                    // future gate relaxation that forgets this reader degrades
                    // to the fall-through TYPE_UNKNOWN path instead of crashing
                    // sublist_get on a -1 / empty binder list.
                    let im_binders = if im != -1 { node_impl_binders(im) } else { -1 }
                    if im != -1 && im_binders != -1 && sublist_length(im_binders) == 1 {
                        let elem = ty_pool.get(obj_t).unwrap().inner1
                        check_arg_shapes("List.{method}", sig, node_args(node), 1)
                        let binder = node_name(sublist_get(im_binders, 0))
                        let mut binds: Map[Str, Int] = Map()
                        binds.insert(binder, elem)
                        let raw_ret = fnsig_pool.get(sig).unwrap().ret
                        return substitute_typevar_tid(raw_ret, binds)
                    }
                }
            }
        }

        if obj_k == TyKind.Str {
            let args_sl = node_args(node)
            if method == "len" { return TYPE_INT }
            // br w13xgb, deferred here by br rbd0a4 because there was no TyKind.Ptr to name. The
            // one Ptr-producing method the spec states outright AND codegen agrees with:
            // `fn as_cstr(self: Str) -> Ptr[U8]` (sections/07_trust_modules_metadata.md:221)
            // against `blink_strdup(s)` with expr_result_type = CT_PTR (codegen_methods.bl:857).
            // Its partner `.to_str(self: Ptr[U8]) -> Option[Str]` (:222) is in the TyKind.Ptr
            // block below, so the documented round trip now types end to end.
            if method == "as_cstr" { return make_ptr_type(TYPE_U8) }
            if method == "contains" || method == "starts_with" || method == "ends_with" {
                check_builtin_arg(method, 0, TYPE_STR, args_sl, "Str")
                return TYPE_BOOL
            }
            if method == "replace" {
                check_builtin_arg(method, 0, TYPE_STR, args_sl, "Str")
                check_builtin_arg(method, 1, TYPE_STR, args_sl, "Str")
                return TYPE_STR
            }
            if method == "concat" {
                check_builtin_arg(method, 0, TYPE_STR, args_sl, "Str")
                return TYPE_STR
            }
            // br rbd0a4. `substr` shares this arm rather than getting a copy: it is an ALIAS of
            // `substring`, dispatched by the one codegen arm (`codegen_methods.bl:922` spells
            // `"substring" || "substr"`), and two arms could drift.
            if method == "substring" || method == "substr" || method == "slice" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "Str")
                check_builtin_arg(method, 1, TYPE_INT, args_sl, "Str")
                return TYPE_STR
            }
            if method == "trim" || method == "trim_right" || method == "trim_left" || method == "to_lower" || method == "to_upper" {
                return TYPE_STR
            }
            if method == "byte_at" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "Str")
                return TYPE_INT
            }
            if method == "index_of" {
                check_builtin_arg(method, 0, TYPE_STR, args_sl, "Str")
                return TYPE_INT
            }
            if method == "to_int" { return TYPE_INT }
            if method == "char_at" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "Str")
                return make_option_type(TYPE_CHAR)
            }
            if method == "split" {
                check_builtin_arg(method, 0, TYPE_STR, args_sl, "Str")
                return make_list_type(TYPE_STR)
            }
            if method == "lines" { return make_list_type(TYPE_STR) }
            if method == "parse_float" { return TYPE_FLOAT }
            if method == "parse_int" { return TYPE_INT }
            if method == "is_empty" { return TYPE_BOOL }
        }

        if obj_k == TyKind.Int {
            if method == "to_str" { return TYPE_STR }
            // br rbd0a4. The two conversions codegen implements for an Int receiver that no arm
            // named: `to_string` (codegen_methods.bl:3879, the CT_INT branch) and `to_float`
            // (`:3777`, gated on `obj_type == CT_INT`). Note `to_string` is NOT answered for a
            // sized-int or Bool receiver, and `to_float` is NOT answered for a Str one — codegen
            // implements none of those three, so answering them here would invent surface.
            if method == "to_string" { return TYPE_STR }
            if method == "to_float" { return TYPE_FLOAT }
            if method == "abs" || method == "min" || method == "max" { return TYPE_INT }
            if method == "to_i8" { return TYPE_I8 }
            if method == "to_i16" { return TYPE_I16 }
            if method == "to_i32" { return TYPE_I32 }
            if method == "to_u8" { return TYPE_U8 }
            if method == "to_u16" { return TYPE_U16 }
            if method == "to_u32" { return TYPE_U32 }
            if method == "to_u64" { return TYPE_U64 }
        }

        // br rbd0a4. A Float receiver had no block at all. `to_int` was answered only inside the
        // Str block above, so `1.7.to_int()` resolved nothing even though codegen has implemented
        // it all along (codegen_methods.bl:3782, gated on `obj_type == CT_FLOAT`).
        if obj_k == TyKind.Float {
            if method == "to_string" { return TYPE_STR }
            if method == "to_int" { return TYPE_INT }
        }

        let is_sized_obj = is_sized_int(obj_k)
        if is_sized_obj {
            if method == "to_int" { return TYPE_INT }
            if method == "to_i8" { return TYPE_I8 }
            if method == "to_i16" { return TYPE_I16 }
            if method == "to_i32" { return TYPE_I32 }
            if method == "to_u8" { return TYPE_U8 }
            if method == "to_u16" { return TYPE_U16 }
            if method == "to_u32" { return TYPE_U32 }
            if method == "to_u64" { return TYPE_U64 }
            if method == "wrapping_add" || method == "wrapping_sub" || method == "wrapping_mul" || method == "wrapping_div" || method == "wrapping_rem" || method == "wrapping_neg" {
                return obj_t
            }
        }

        if obj_k == TyKind.Char {
            if method == "to_int" { return TYPE_INT }
            if method == "to_str" { return TYPE_STR }
        }

        if obj_k == TyKind.Option {
            if method == "unwrap" { return ty_pool.get(obj_t).unwrap().inner1 }
            if method == "is_some" || method == "is_none" { return TYPE_BOOL }
        }

        if obj_k == TyKind.Result {
            if method == "unwrap" { return ty_pool.get(obj_t).unwrap().inner1 }
            if method == "unwrap_err" { return ty_pool.get(obj_t).unwrap().inner2 }
            if method == "is_ok" || method == "is_err" { return TYPE_BOOL }
        }

        if obj_k == TyKind.Map {
            let args_sl = node_args(node)
            let key_t = ty_pool.get(obj_t).unwrap().inner1
            let val_t = ty_pool.get(obj_t).unwrap().inner2
            if method == "len" { return TYPE_INT }
            if method == "contains_key" || method == "contains" || method == "remove" {
                check_builtin_arg(method, 0, key_t, args_sl, "Map")
                return TYPE_BOOL
            }
            if method == "insert" {
                check_builtin_arg(method, 0, key_t, args_sl, "Map")
                check_builtin_arg(method, 1, val_t, args_sl, "Map")
                return TYPE_VOID
            }
            if method == "clear" { return TYPE_VOID }
            if method == "get" {
                check_builtin_arg(method, 0, key_t, args_sl, "Map")
                return make_option_type(val_t)
            }
            if method == "keys" { return make_list_type(key_t) }
            if method == "values" { return make_list_type(val_t) }
        }

        if obj_k == TyKind.Set {
            let args_sl = node_args(node)
            let elem = ty_pool.get(obj_t).unwrap().inner1
            if method == "len" { return TYPE_INT }
            if method == "is_empty" { return TYPE_BOOL }
            if method == "contains" || method == "insert" || method == "remove" {
                check_builtin_arg(method, 0, elem, args_sl, "Set")
                return TYPE_BOOL
            }
            if method == "union" {
                check_builtin_arg(method, 0, obj_t, args_sl, "Set")
                return obj_t
            }
        }

        if obj_k == TyKind.Bytes {
            let args_sl = node_args(node)
            if method == "len" { return TYPE_INT }
            if method == "get" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "Bytes")
                return make_option_type(TYPE_INT)
            }
            if method == "is_empty" { return TYPE_BOOL }
            if method == "push" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "Bytes")
                return TYPE_VOID
            }
            if method == "set" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "Bytes")
                check_builtin_arg(method, 1, TYPE_INT, args_sl, "Bytes")
                return TYPE_VOID
            }
            if method == "slice" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "Bytes")
                check_builtin_arg(method, 1, TYPE_INT, args_sl, "Bytes")
                return obj_t
            }
            if method == "concat" {
                check_builtin_arg(method, 0, obj_t, args_sl, "Bytes")
                return obj_t
            }
            if method == "to_str" { return make_result_type(TYPE_STR, TYPE_STR) }
            if method == "to_hex" { return TYPE_STR }
            if method == "read_u16_be" || method == "read_u32_be" || method == "read_i32_be" || method == "read_i64_be" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "Bytes")
                return make_result_type(TYPE_INT, TYPE_STR)
            }
            if method == "read_u16_le" || method == "read_u32_le" || method == "read_i32_le" || method == "read_i64_le" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "Bytes")
                return make_result_type(TYPE_INT, TYPE_STR)
            }
            if method == "write_u16_be" || method == "write_u32_be" || method == "write_i32_be" || method == "write_i64_be" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "Bytes")
                return TYPE_VOID
            }
            if method == "write_u16_le" || method == "write_u32_le" || method == "write_i32_le" || method == "write_i64_le" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "Bytes")
                return TYPE_VOID
            }
            if method == "with_ptr" {
                if args_sl == -1 || sublist_length(args_sl) < 1 { return TYPE_VOID }
                let cls_node = sublist_get(args_sl, 0)
                if node_kind(cls_node) != NodeKind.Closure { return TYPE_VOID }
                let ret_str = node_return_type(cls_node)
                if ret_str == "" { return TYPE_VOID }
                let rt = resolve_type_name(ret_str)
                if rt == -1 { return TYPE_VOID }
                return rt
            }
        }

        // 7cq6w2: the StringBuilder surface, mirroring emit_sb_method
        // (src/codegen_methods.bl:2017) method-for-method — that function IS the
        // definition of what a StringBuilder can do, and a method typed here that it
        // cannot emit would trade a missing type for a link error.
        //
        // `write` deliberately takes ANY argument: codegen dispatches on the arg's ct
        // (blink_sb_write / _write_int / _write_float / _write_bool) and interpolates an
        // InterpString part-by-part, so constraining it to Str here would reject
        // `buf.write("{n}")` and `buf.write(count)`, both of which lower correctly today.
        if obj_k == TyKind.StringBuilder {
            let args_sl = node_args(node)
            if method == "write" || method == "write_char" {
                // Not checked, but still INFERRED: the shared fall-through at the end of
                // this arm is what surfaces E0522 for a nested call in an argument, and
                // returning early here would skip it.
                if args_sl != -1 && sublist_length(args_sl) > 0 {
                    infer_type(sublist_get(args_sl, 0))
                }
                return TYPE_VOID
            }
            if method == "clear" { return TYPE_VOID }
            if method == "to_str" { return TYPE_STR }
            if method == "len" || method == "capacity" { return TYPE_INT }
            if method == "is_empty" { return TYPE_BOOL }
        }

        // br w13xgb. Only the three methods where the spec and codegen already agree, or where
        // codegen is the sole authority AND lib/std depends on it. `.deref()` and `.addr()` are
        // deliberately absent: sections/07_trust_modules_metadata.md:217,:220 specifies
        // `Option[T]` and `Ptr[Ptr[T]]` while codegen_methods.bl:4774-4835 implements a bare
        // `Int` for both, and lib/std/libc.bl:146,164,177,189,210 depends on the bare form. An
        // arm here would have to pick a side, so which side moves is br mwsy85 (type:spec).
        // `.read()` / `.write()` are likewise out — br 5efs37 is the miscompile that has to be
        // fixed before a return type means anything for them.
        if obj_k == TyKind.Ptr {
            let args_sl = node_args(node)
            if method == "is_null" { return TYPE_BOOL }
            // Pointer arithmetic, so the pointee is PRESERVED — `obj_t` itself, not its child.
            // Absent from the spec's operations table (br mwsy85) but defined by codegen
            // (codegen_methods.bl:4812), described by the E0813/E0822 diagnostics, and
            // load-bearing at lib/std/libc.bl:52,:68 — which is where 165 of this cause's
            // divergence rows are.
            if method == "offset" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "Ptr")
                return obj_t
            }
            if method == "to_str" { return make_option_type(TYPE_STR) }
        }

        // br nrrs28. Enumerated against codegen's emit_template_method
        // (src/codegen_methods.bl:2108) method-for-method rather than added a name at a
        // time — codegen has exactly these seven arms, is_builtin_method lists exactly the
        // same seven, and the list and the arms AGREE, which is the first cause in this
        // campaign where that enumeration came back clean. A method typed here that
        // codegen cannot emit would trade a missing type for a link error.
        //
        // The spec (sections/03b_contracts.md:428) spells the surface as two FIELDS —
        // `parts: List[Str]` and `values: List[Any]` — while the compiler implements a
        // method API, because Blink has no `Any` and so cannot express `values`. `parts()`
        // is the one member both agree on, and it is `List[Str]` in both. The four typed
        // getters plus `type_tag` are how the compiler answers what `values` would have,
        // and their types come from codegen's own emission: `type_tag` reads the tag list
        // as an Int, `get_float` memcpys a double, `get_str` yields the interned Str.
        // Reconciling the two surfaces is a spec question, filed separately.
        if obj_k == TyKind.Template {
            let args_sl = node_args(node)
            if method == "parts" { return make_list_type(TYPE_STR) }
            if method == "count" { return TYPE_INT }
            if method == "type_tag" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "Template")
                return TYPE_INT
            }
            if method == "get_int" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "Template")
                return TYPE_INT
            }
            if method == "get_float" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "Template")
                return TYPE_FLOAT
            }
            if method == "get_bool" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "Template")
                return TYPE_BOOL
            }
            if method == "get_str" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "Template")
                return TYPE_STR
            }
        }

        // br ps5br9 — the four ffi.scope() allocators, against the operation table at
        // sections/07_trust_modules_metadata.md:280-286 and codegen's own emitter block
        // (codegen_methods.bl:4886), which sets expr_result_type = CT_PTR for all four.
        //
        // Two of the four are fully signable and are the whole of this ticket's divergence:
        // `cstr` is monomorphic (`fn cstr(self, s: Str) -> Ptr[U8]`, :285) and matches the
        // `Str.as_cstr()` signature above; `take` is the IDENTITY on its argument's type
        // (`fn take[T](self, ptr: Ptr[T]) -> Ptr[T]`, :286), so it needs the argument's tid
        // and no inference at all.
        //
        // `alloc` / `alloc_n` are deliberately UNSIGNED. The spec writes the pointee at the
        // call site — `scope.alloc[T]()`, `scope.alloc_n[T](n)` — but that spelling does not
        // parse as a method call: parser.bl:2887 accepts a `[` after a member name for the one
        // hard-coded `channel.new[T]` form and nothing else, so the type argument never
        // reaches the AST (br 9qmrma). The only channel that carries the pointee today is the
        // let annotation, which codegen reads directly (resolve_ptr_inner_c). TYPE_UNKNOWN is
        // the honest answer and leaves that path byte-identical; minting `Ptr[metavar]` would
        // make every unannotated `let p = scope.alloc()` in the corpus E0301 with nothing to
        // bind it — the w3v2e6 trap. Their argument IS checked: alloc_n takes a count, and
        // passing a Str for it silently calloc'd a garbage size and returned NULL.
        if obj_k == TyKind.FfiScope {
            let args_sl = node_args(node)
            if method == "cstr" {
                check_builtin_arg(method, 0, TYPE_STR, args_sl, "scope")
                return make_ptr_type(TYPE_U8)
            }
            if method == "take" {
                if args_sl == -1 || sublist_length(args_sl) < 1 { return TYPE_UNKNOWN }
                let taken_t = infer_type(sublist_get(args_sl, 0))
                let taken_k = type_kind(resolve_alias_tid(taken_t))
                if taken_k == TyKind.Ptr { return taken_t }
                // An unresolved argument keeps the unresolved answer — `scope.take(scope.alloc())`
                // is the corpus's own spelling and its argument has no tid by design (above).
                if taken_k == TyKind.Unknown || taken_k == TyKind.Typevar { return TYPE_UNKNOWN }
                tc_error_at("argument 1 of 'scope.take' expects Ptr[T], got {type_to_str(taken_t)}", sublist_get(args_sl, 0))
                return TYPE_UNKNOWN
            }
            if method == "alloc_n" {
                check_builtin_arg(method, 0, TYPE_INT, args_sl, "scope")
                return TYPE_UNKNOWN
            }
            if method == "alloc" { return TYPE_UNKNOWN }
        }

        if obj_k == TyKind.Struct || obj_k == TyKind.Enum {
            let tname = ty_pool.get(obj_t).unwrap().name
            // sb3125 §3c rule-3: an unqualified call to a method defined by two
            // or more traits this type implements is ambiguous. Reject before
            // resolving — the qualified call `Trait.method(receiver)` selects one.
            if tc_method_trait_count(tname, method) >= 2 {
                let names = tc_method_trait_names(tname, method)
                diag_error_at("AmbiguousMethodCall", AMBIGUOUS_METHOD_CALL, "ambiguous method call: '.{method}' is defined in multiple traits implemented by {tname} ({names})", node, "use a qualified call to disambiguate, e.g. `Trait.{method}(receiver)`")
                return TYPE_UNKNOWN
            }
            // Resolve through the trait-qualified fnsig key. From/TryFrom register
            // under their source-typed key (handled via the builtin-method path
            // below), so a bare-key fallback keeps any non-trait inherent sig.
            let sole_trait = tc_method_trait_names(tname, method)
            let sig_name = if sole_trait != "" { "{tname}_{sole_trait}_{method}" } else { "{tname}_{method}" }
            let sig = lookup_fnsig(sig_name)
            if sig != -1 {
                check_arg_shapes("{tname}.{method}", sig, node_args(node), 1)
                return fnsig_pool.get(sig).unwrap().ret
            }
            // br rb5wvb. Instant's two CODEGEN-ONLY methods. Four of its six are declared in
            // lib/std/time.bl:16-19 and so resolved through the fnsig lookup just above;
            // `elapsed` and `to_rfc3339` have no Blink declaration anywhere —
            // codegen_methods.bl:4695,:4716 emit `blink_Instant_elapsed` /
            // `blink_Instant_to_rfc3339` directly — so there was no fnsig and the block fell
            // through to TYPE_UNKNOWN. Both names are in is_builtin_method (:6429, :6432), so
            // tc_method_resolvable_on_type answered yes and E0505 never fired either: the same
            // allow-list-with-nothing-behind-it shape as jvy35h and n84s1p.
            //
            // sections/03_types.md:566,:569 pins both signatures — `elapsed(self) -> Duration
            // ! Time.Read` and `to_rfc3339(self) -> Str` — so the return types and the zero
            // arity are the spec's, not a choice made here.
            //
            // DELIBERATELY BELOW the fnsig lookup, not above it: a real declaration must always
            // win, both so a future lib/std/time.bl `Instant_elapsed` supersedes this without
            // touching the arm, and so the four declared siblings keep resolving through their
            // own signatures. Keyed on `tname` for the same reason `elapsed` is not keyed on the
            // name alone: sections/06_tooling.md:923 gives the mock clock handle its own
            // `elapsed(self) -> List[Duration]`.
            if tname == "Instant" && (method == "elapsed" || method == "to_rfc3339") {
                let inst_args = node_args(node)
                let inst_got = if inst_args != -1 { sublist_length(inst_args) } else { 0 }
                // Codegen never reads the argument list for these two, so an extra argument was
                // silently discarded and no later phase would ever have reported it.
                if inst_got != 0 {
                    tc_error_at("method 'Instant.{method}' expects 0 argument(s), got {inst_got}", node)
                }
                if method == "to_rfc3339" { return TYPE_STR }
                // The Duration tid, minted only if lib/std/time.bl is absent from the program —
                // lookup runs first inside ensure_runtime_struct_type, so the declared tid wins
                // and `.to_ms()` on the result still resolves through `Duration_to_ms`. Same
                // idempotent-mint reasoning as the Instant tid at the time.read() arm (b907wt).
                return ensure_runtime_struct_type("Duration", ["nanos"], [TYPE_INT])
            }
            // 4q2etk: replaced by mwxtyj — synthesized sealed Display.display()
            // has no user-written fnsig; it always returns Str.
            if method == "display" && tc_type_has_display_impl(tname) != 0 {
                return TYPE_STR
            }
            // vfgp72: synthesized @derive(Eq)/@derive(Ord) methods have no user
            // fnsig. eq -> Bool, cmp -> Ordering. (User `impl Eq/Ord` resolves
            // through the trait-qualified fnsig above; this is the derive path.)
            if method == "eq" && tc_type_has_eq_impl(tname) != 0 {
                return TYPE_BOOL
            }
            if method == "cmp" && tc_type_has_ord_impl(tname) != 0 {
                let ot = lookup_named_type("Ordering")
                if ot != -1 { return ot }
                return TYPE_UNKNOWN
            }
            // br cjtxxr. A closure-typed struct field invoked like a method —
            // `route.callback(req)`, `srv.error_handler.on_error(req, msg)`, the
            // `handler: fn(Request) -> Response` field the spec puts inside `type Route`
            // (sections/04_effects.md:453). This block had no arm for it, so the call fell
            // through to TYPE_UNKNOWN — and tc_method_resolvable_on_type clause (d)
            // fail-opens on is_callable_field_name, a GLOBAL name list, so E0505 stayed
            // silent too. Return type, arity and every argument type were all unchecked:
            // the only callable shape in the language that was not.
            //
            // Nothing new is inferred here. resolve_type_ann's Fn arm (:2756, nz7drz)
            // already gives every `fn(A) -> B` annotation a structured TyKind.Fn tid, and
            // register_struct_type stores it as the field's sf.type_id — so this is the
            // THIRD dispatch to tc_check_call_against_fn_tid, alongside the closure
            // VARIABLE (:9012) and the immediately-invoked closure literal (:9086),
            // against the same kind of tid. (Clause (d)'s comment claiming closure fields
            // lower to TyKind.Typevar("Fn") predates nz7drz and is stale.)
            //
            // DELIBERATELY BELOW the fnsig lookup and above the E0505 gate, which mirrors
            // codegen exactly: codegen_methods.bl tries synthesized display, then
            // lookup_impl_method (:5323), then the closure field (:5333). A trait-impl
            // method of the same name therefore wins in BOTH phases; typechecking the
            // field instead would only move the miscompile.
            //
            // Guarded on TyKind.Struct — an enum has variants, not fields — and on the
            // field tid actually being a Fn, so a non-callable field of the same name as
            // some other struct's callable field still falls to E0505 as before.
            if obj_k == TyKind.Struct {
                let fld_tid = get_struct_field_tid(obj_t, method)
                if fld_tid != -1 && type_kind(fld_tid) == TyKind.Fn {
                    return tc_check_call_against_fn_tid(fld_tid, node_args(node), "closure field '{tname}.{method}'", node)
                }
            }
            // mrwgz4: the receiver type is KNOWN, but no resolution path matched.
            // Emit E0505 here (typecheck) instead of deferring to the codegen
            // backstop — name resolution belongs with E0504/E0506/E0507. Display
            // rides along with its actionable help (4q2etk); blinkc_main aborts
            // on diag_count > 0 before codegen, so the backstop never re-fires.
            if tc_method_resolvable_on_type(obj_k, tname, method) == 0 {
                let help = if method == "display" {
                    "add an `impl Display for {tname}` (with `fn fmt(self, sb: StringBuilder)`)"
                } else {
                    ""
                }
                diag_error_at("UnresolvedMethod", UNRESOLVED_METHOD, "unresolved method '.{method}' on type {tname}", node, help)
                return TYPE_UNKNOWN
            }
        }

        if obj_node != -1 && node_kind(obj_node) == NodeKind.Ident {
            let obj_name = node_name(obj_node)
            // gqg3rk: a sealed Ops-trait mutator (MapOps.insert(m,k,v),
            // SetOps.insert(s,e), ListOps.push(l,x)) is a constraining use spelled
            // statically with the receiver at args[0]. Pin the receiver container's
            // element metavar(s) from the payload args so `let m = Map();
            // MapOps.insert(m,"k",42)` infers Map[Str,Int] rather than E0301.
            if is_sealed_builtin_trait(obj_name) != 0 {
                tc_pin_ops_trait_receiver(obj_name, method, node_args(node))
            }
            if obj_name == "Char" {
                if method == "from_code_point" {
                    return make_result_type(TYPE_CHAR, lookup_named_type("ConversionError"))
                }
            }
            // br h3q81d. A user-effect operation call — `db.query(..)`, `storage.get_names()`.
            // The handle is not a value, so it never had a type and the receiver-typed arms
            // above cannot reach it; register_ue_op_sigs put the op's own signature under
            // `{handle}.{op}`. Both halves come from it: the return tid, and the argument
            // check, which without a signature compared against nothing and let a wrong
            // argument reach the C compiler.
            //
            // `nr_is_defined` gates it so a local binding that happens to share the handle's
            // spelling keeps its own type — that variable's receiver arm has already run and
            // fallen through only because the method was genuinely unresolved on it.
            if nr_is_defined(obj_name) == 0 && is_user_effect_handle_name(obj_name) != 0 {
                let ue_sig = lookup_fnsig("{obj_name}.{method}")
                if ue_sig != -1 {
                    check_arg_shapes("{obj_name}.{method}", ue_sig, node_args(node), 0)
                    return fnsig_pool.get(ue_sig).unwrap().ret
                }
            }
            // vfgp72: intrinsic time.* methods type even without `import std.time`
            // (they emit as codegen intrinsics like io.println). Typing read() as
            // Instant lets the comparison check (Stage 4) catch `time.read() > 0`
            // at `blink check` instead of leaking an Instant into invalid C — the
            // original ticket bug.
            if is_import_module_name(obj_name) != 0 && nr_is_defined(obj_name) == 0 && is_intrinsic_method(obj_name, method) != 0 {
                if obj_name == "time" && method == "read" {
                    // b907wt: std.time is a prelude module (compiler.bl:1357), so the
                    // declaration is normally present — but a silent fall-through when it
                    // is not is the same fail-open erasure as the process builtins had.
                    // Mint it, so the type is right whether or not std.time is in scope.
                    return ensure_runtime_struct_type("Instant", ["nanos"], [TYPE_INT])
                }
                if obj_name == "time" && method == "sleep" { return TYPE_VOID }
            }
            // br qjfwc6. Every other namespace intrinsic, from the table
            // register_ns_intrinsic_sigs put in fnsig_pool under `{namespace}.{method}`.
            // Not gated on is_import_module_name, unlike the time.* arms above: an
            // intrinsic needs no import (that is what makes it an intrinsic), and
            // is_intrinsic_method already restricts the namespace. nr_is_defined keeps a
            // local that shadows the namespace spelling on its own receiver-typed arm.
            if nr_is_defined(obj_name) == 0 && is_intrinsic_method(obj_name, method) != 0 {
                let nsi = lookup_fnsig("{obj_name}.{method}")
                if nsi != -1 {
                    let nsi_fs = fnsig_pool.get(nsi).unwrap()
                    let nsi_args = node_args(node)
                    let mut nsi_got = 0
                    if nsi_args != -1 { nsi_got = sublist_length(nsi_args) }
                    // The arity check is not a nicety: codegen indexes the argument list
                    // positionally and unconditionally, so `net.listen("localhost")`
                    // panics the compiler at parser.bl:111 (unwrap on the missing node)
                    // instead of reporting anything.
                    if nsi_got != nsi_fs.params_count {
                        tc_error_at("function '{obj_name}.{method}' expects {nsi_fs.params_count} argument(s), got {nsi_got}", node)
                    }
                    check_arg_shapes("{obj_name}.{method}", nsi, nsi_args, 0)
                    return nsi_fs.ret
                }
            }
            if is_import_module_name(obj_name) != 0 && nr_is_defined(obj_name) == 0 && is_intrinsic_method(obj_name, method) == 0 {
                let sig = lookup_fnsig(method)
                if sig != -1 {
                    let mq_gen_args = node_args(node)
                    // A generic module-qualified call must SUBSTITUTE its type
                    // params into the return type, exactly like the same-module
                    // bare-Ident path (instantiate_return_type at the callee_kind ==
                    // Ident arm). Returning the raw fnsig ret leaves a
                    // generic-struct-instance return memoized as CmgBox[T] with T
                    // unsubstituted — so the return node's tid carries the typevar
                    // (unencodable), and every codegen consumer that recovers inner
                    // tids off that return tid (mono_instance_arg_tids_from_tid ->
                    // resolve_arg_seg_via_slot_tid / resolve_tparam_via_tid) misses
                    // the tid path and spells the bare binder. Substituting
                    // here binds T->Int so CmgBox[Int]'s inner slot is the concrete
                    // Int tid the tid path can spell (br h4hpbq). The scalar-return
                    // path (`-> T`, cmg_identity) already resolved correctly; this
                    // additionally fixes the generic-struct-instance return.
                    // instantiate_return_type infers each arg (build_typevar_binds)
                    // as a side effect, so the generic path also populates the
                    // node→tid memo the tid-driven mono lowering (tc_mono_tids_core) reads.
                    let mq_fs = fnsig_pool.get(sig).unwrap()
                    if mq_fs.type_params_count > 0 {
                        return instantiate_return_type(sig, mq_gen_args, node)
                    }
                    // Non-generic module-qualified call: no substitution, but still
                    // infer the args so their node→tid memo is populated (the
                    // fall-through inference loop below is unreachable past this
                    // early return).
                    if mq_gen_args != -1 {
                        let mut mgi = 0
                        while mgi < sublist_length(mq_gen_args) {
                            infer_type(sublist_get(mq_gen_args, mgi))
                            mgi = mgi + 1
                        }
                    }
                    return mq_fs.ret
                }
            }
            // mjsbwm: every path below reads the receiver Ident as a TYPE NAME. A name with
            // a binding in scope is a value, and `value.method()` is an instance call no
            // matter what a same-spelled type could have offered — name resolution follows
            // scope. Without this gate `let foo = 42; foo.bar()` silently adopted the return
            // type of a free fn named `foo_bar`, and `let Widget = 7; Widget.make(3)` typed
            // as Widget while emitting a call that ignored the binding. Deliberately mirrors
            // the `nr_is_defined(obj_name) == 0` gate the module-qualified paths above
            // already carry — but via the pure probe, so asking does not mark a read.
            //
            // Failing to resolve here is not the end of checking: the receiver was inferred
            // above, so a struct/enum receiver has already been through
            // tc_method_resolvable_on_type, and a scalar one falls through to Unknown and
            // the codegen E0505 backstop. The wrong ANSWER is what this removes.
            let obj_is_value = nr_has_binding(obj_name)
            // br ta51an. The qualified trait call `Trait.method(receiver, args)` — parsed as
            // MethodCall(obj = Ident(Trait)), and the spec's ONLY way to name one of two
            // traits that define the same method (sections/03c_protocols.md:697-712,
            // resolution table :773 "Explicit trait + method"). There was no arm for a
            // trait-name receiver, so the call answered TYPE_UNKNOWN and BOTH halves of the
            // gate failed open: the declared type of the result was never compared
            // (`let bad: Bool = Sizer.size(p)` printed 5 and tested truthy) and neither
            // arity nor argument types were checked (an extra argument reached cc as "too
            // many arguments to a C function").
            //
            // Everything answered here comes from the impl's own signature, which
            // tc_mangle_impl_fnsig keys TRAIT-QUALIFIED as `{T}_{Trait}_{m}` precisely so
            // two traits sharing a method name do not overwrite each other. That makes the
            // trait half of the key the "does this trait own this method for this type"
            // gate as well as the answer — the same gate-and-answer-in-one-lookup shape as
            // tc_channel_elem_ct — so no separate ownership index is needed.
            //
            // The sealed builtin ops traits are EXCLUDED. They carry no such fnsig by design
            // (they are the sole codegen-dispatched surface, project_ops_traits_sole_dispatch_surface)
            // and their qualified form already emits correct C through the intrinsics;
            // their own missing declared-type compare is br 9kgj76, a signature table rather
            // than another resolution arm.
            if obj_is_value == 0 && is_trait_name(obj_name) != 0 && is_sealed_builtin_trait(obj_name) == 0 {
                let qt_args = node_args(node)
                let qt_n = if qt_args != -1 { sublist_length(qt_args) } else { 0 }
                if qt_n == 0 {
                    tc_error_at("qualified trait call '{obj_name}.{method}' expects the receiver as its first argument, got none", node)
                    return TYPE_UNKNOWN
                }
                let qt_recv = infer_type(sublist_get(qt_args, 0))
                let qt_k = type_kind(qt_recv)
                // A typevar or unknown receiver keeps today's answer: that is the spec's
                // `fn show[T: Describe](v: T) { Describe.describe(v) }` form (:706), where
                // the bound guarantees the method exists, the impl is chosen per
                // instantiation, and there is no single fnsig to read.
                if qt_k == TyKind.Struct || qt_k == TyKind.Enum {
                    let qt_tname = ty_pool.get(qt_recv).unwrap().name
                    let qt_sig = lookup_fnsig("{qt_tname}_{obj_name}_{method}")
                    if qt_sig != -1 {
                        let qt_fs = fnsig_pool.get(qt_sig).unwrap()
                        // The receiver IS param 0 (`self`), so the qualified form's arity is
                        // the declared param count exactly and check_arg_shapes runs at
                        // self_offset 0, where the instance path uses 1. `self` itself has no
                        // annotation, so its param tid is Unknown and check_arg_shapes skips
                        // it — the receiver's own type was already established by the
                        // fnsig key.
                        if qt_n != qt_fs.params_count {
                            tc_error_at("qualified trait call '{obj_name}.{method}' expects {qt_fs.params_count} argument(s) including the receiver, got {qt_n}", node)
                        }
                        check_arg_shapes("{obj_name}.{method}", qt_sig, qt_args, 0)
                        return qt_fs.ret
                    }
                    // The synthesized sealed `Display.display` (4q2etk/mwxtyj) has no user
                    // fnsig anywhere — and §3c:712 names it as THE qualified call to write.
                    // Same answer as the instance arm at the Struct/Enum receiver block.
                    if obj_name == "Display" && method == "display" && tc_type_has_display_impl(qt_tname) != 0 {
                        if qt_n != 1 {
                            tc_error_at("qualified trait call 'Display.display' expects 1 argument(s) including the receiver, got {qt_n}", node)
                        }
                        return TYPE_STR
                    }
                    // The named trait does not define this method at all. Without this,
                    // `B.go(p)` where only `A` defines `go` silently dispatched to
                    // `blink_Point_A_go` and printed A's answer: the qualifier was ignored.
                    // Gated on the TRAIT's declaration rather than on the missing fnsig, so
                    // a declared-but-unregistered method keeps its existing answer.
                    if tc_trait_declares_method(obj_name, method) == 0 {
                        let qt_owner = tc_method_trait_names(qt_tname, method)
                        let qt_help = if qt_owner != "" { "'{method}' on {qt_tname} is defined by {qt_owner}" } else { "" }
                        diag_error_at("UnresolvedMethod", UNRESOLVED_METHOD, "trait '{obj_name}' does not define method '{method}'", node, qt_help)
                        return TYPE_UNKNOWN
                    }
                }
            }
            // Static constructor on a sealed builtin type: Bytes.new/from_str/zeroed,
            // Map.new(), Set.new() mirror the bare-call forms in get_builtin_fn_ret. Keyed on
            // the type AND the method — see tc_builtin_static_ret for why the method half
            // matters. A type/method pair it does not own answers TYPE_UNKNOWN and falls
            // through to the fnsig lookups below, which is strictly more than the old gate
            // did: it returned get_builtin_fn_ret's answer for `new` even when that was
            // Unknown, ending resolution there.
            if is_builtin_fn(obj_name) != 0 && obj_is_value == 0 {
                let bs_ret = tc_builtin_static_ret(obj_name, method)
                if bs_ret != TYPE_UNKNOWN { return bs_ret }
            }
            // Static method on a builtin/named type: Type.from(x), Type.try_from(x), etc.
            // Trait-impl methods register under `{Type}_{trait}_{method}` (sb3125); an
            // inherent sig keeps the bare `{Type}_{method}` key — which is how the stdlib
            // spells a static constructor at all, since Blink has no inherent methods
            // (sections/03c_protocols.md:758): `pub fn Duration_seconds(s: Int)`
            // (lib/std/time.bl:3) IS `Duration.seconds(2)`.
            if obj_is_value == 0 {
                let static_trait = tc_method_trait_names(obj_name, method)
                if static_trait != "" && tc_method_trait_count(obj_name, method) == 1 {
                    let q_sig = lookup_fnsig("{obj_name}_{static_trait}_{method}")
                    if q_sig != -1 {
                        return fnsig_pool.get(q_sig).unwrap().ret
                    }
                }
                let static_sig_name = "{obj_name}_{method}"
                let static_sig = lookup_fnsig(static_sig_name)
                if static_sig != -1 {
                    return fnsig_pool.get(static_sig).unwrap().ret
                }
                // br zs7khh. From/TryFrom are the one scheme neither key above can name:
                // tc_mangle_impl_fnsig keys them SOURCE-TYPED, `{Type}_{method}_{Src}`,
                // because one target can carry several source impls — lib/std/int_conv.bl
                // declares try_from on I8 from Int, from I32 and from I16, all three named
                // `try_from` on `I8`. So the source has to come from the argument, exactly
                // as codegen already does it (codegen_methods.bl's static From/TryFrom
                // dispatch spells `src` from the argument's own type, then goes through
                // find_from_impl/find_tryfrom_impl + mangle_from_method).
                //
                // Gated on the method NAME rather than on static_trait, to mirror codegen
                // and to stay independent of the count == 1 guard above: a target with
                // several distinct traits owning `try_from` still has exactly one
                // source-typed key per argument type.
                //
                // A miss returns Unknown here instead of falling through, because the
                // shared fall-through below re-infers every argument and infer_type REPORTS
                // as a side effect (see the note at the IfExpr arm) — falling through would
                // double-report a bad argument. Nothing past this point could answer for a
                // static call anyway.
                if method == "from" || method == "try_from" {
                    let ff_args = node_args(node)
                    if ff_args != -1 && sublist_length(ff_args) == 1 {
                        let src_t = infer_type(sublist_get(ff_args, 0))
                        let src_sig = lookup_fnsig("{obj_name}_{method}_{tc_type_str(src_t)}")
                        if src_sig != -1 {
                            return fnsig_pool.get(src_sig).unwrap().ret
                        }
                        return TYPE_UNKNOWN
                    }
                }
            }
        }

        // Fall-through (e.g. module-qualified calls like io.println(...)): the
        // type-specific branches above returned for their own receivers, so any
        // call reaching here had its args unchecked. Infer them so nested method
        // calls are validated — this is what surfaces E0522 for x.m() passed to
        // io.println (sb3125).
        let mc_args = node_args(node)
        if mc_args != -1 {
            let mut mci = 0
            while mci < sublist_length(mc_args) {
                infer_type(sublist_get(mc_args, mci))
                mci = mci + 1
            }
        }
        return TYPE_UNKNOWN
    }

    if kind == NodeKind.FieldAccess {
        let obj_node = node_obj(node)
        let fname = node_name(node)
        if obj_node == -1 { return TYPE_UNKNOWN }

        if node_kind(obj_node) == NodeKind.Ident {
            let obj_name = node_name(obj_node)
            let tid = lookup_named_type(obj_name)
            if tid != -1 && type_kind(tid) == TyKind.Enum {
                return tid
            }
            // br cttrag: a MODULE qualifier. This arm had three cases — an enum
            // type qualifier, a struct field, a tuple index — and no fourth for
            // `module.name`, so a qualified top-level `let` fell off the tail as
            // TYPE_UNKNOWN. That unifies with anything, so both halves failed
            // open and failed open differently: `let bad: Str = prov.count`
            // compiled, linked and RAN, while `want_str(prov.count)` escaped to
            // cc with no diagnostic at all.
            //
            // Same gate name resolution uses for the form (:7764): an Ident that
            // names an import and is not shadowed by a binding. Fails CLOSED —
            // an unregistered key falls through to the existing behaviour rather
            // than guessing a type.
            if is_import_module_name(obj_name) != 0 && nr_is_defined(obj_name) == 0 {
                let qual_mod = tc_qualifier_to_module_or_self(obj_name)
                match tc_module_let_tid.get("{qual_mod}.{fname}") {
                    Some(let_tid) => return let_tid
                    None => {}
                }
            }
        }

        let obj_t = infer_type(obj_node)
        if type_kind(obj_t) == TyKind.Struct {
            let ft = get_struct_field_tid(obj_t, fname)
            if ft != -1 {
                // A generic field on a struct INSTANCE (`b: Box[Int]`) carries the
                // concrete inner, not the declared typevar: substitute the instance's
                // type-args into the field tid so `b.value` infers `Int`, not `T`
                // (br 365fqj). The pairing is DIRECT — the instance stores its args in
                // declaration order, so name[i] ↔ arg[i] needs no unify_typevar_binds.
                // A bare tid (arg_count 0) leaves the map empty and returns ft as-is.
                //
                // Bind ONLY genuinely-concrete args. An instance whose args are
                // themselves unresolved — a typevar, or TYPE_UNKNOWN from an empty
                // `Map()`/`Set()` literal (`let b = GKV { m: Map() }` mints a
                // GKV[?,?] instance, tc_struct_lit_instance_tid) — must leave the
                // field's typevar UNBOUND. Substituting `Map[K,V]` with `K→?` yields
                // `Map[?,?]` whose key CT is CT_VOID, which defeats the codegen
                // erased-default guard (recover_set_elem_from_tid keys on a -1 no-op
                // for an unresolved inner) and regresses the arg-node element
                // recovery (hnyqe4). Skipping the bind keeps the field typevar, so
                // substitute_typevar_tid returns ft unchanged and the pre-C fallback
                // path is byte-identical for the unknowable case.
                if tc_tid_struct_arg_count(obj_t) >= 1 {
                    let inst = ty_pool.get(obj_t).unwrap()
                    let decl = tc_struct_decl_nodes.get(strip_module_qualifier(inst.name)) ?? -1
                    if decl != -1 {
                        let tparams_sl = node_type_params(decl)
                        if tparams_sl != -1 {
                            let mut binds: Map[Str, Int] = Map()
                            let mut i = 0
                            while i < sublist_length(tparams_sl) && i < inst.params_count {
                                let tpname = node_name(sublist_get(tparams_sl, i))
                                let arg_tid = ty_param_list.get(inst.params_start + i).unwrap()
                                let ak = type_kind(arg_tid)
                                if ak != TyKind.Typevar && ak != TyKind.Unknown {
                                    binds.insert(tpname, arg_tid)
                                } else if tc_is_unbound_metavar(arg_tid) != 0 {
                                    // gqg3rk: the instance param is an as-yet-unpinned
                                    // metavar α (`let b = GBox { s: Set() }`). Bind the
                                    // field's typevar to THAT SAME α so the field-access
                                    // type shares it — then a later constraining use
                                    // (`b.s.insert(3)`) pins α through the field and the
                                    // whole instance resolves. Without this the field
                                    // type is a fresh disconnected Set[T] and the pin is
                                    // lost (→ spurious E0301 on the vbhc4x recovery idiom).
                                    binds.insert(tpname, arg_tid)
                                }
                                i = i + 1
                            }
                            return substitute_typevar_tid(ft, binds)
                        }
                    }
                }
                return ft
            }
        }
        // Tuple positional access `t.0`, `t.1`, ...: the field name is the
        // numeric index into the tuple's element tids. Without this, a tuple
        // element type is TYPE_UNKNOWN and method calls on it (e.g. `t.0.unwrap()`
        // when element 0 is Option) fail to resolve (qm01e7).
        if type_kind(obj_t) == TyKind.Tuple {
            let te = ty_pool.get(obj_t).unwrap()
            let idx = str_to_tuple_index(fname)
            if idx >= 0 && idx < te.params_count {
                return ty_param_list.get(te.params_start + idx).unwrap()
            }
        }
        return TYPE_UNKNOWN
    }

    if kind == NodeKind.IndexExpr {
        let obj_t = infer_type(node_obj(node))
        if type_kind(obj_t) == TyKind.List {
            return ty_pool.get(obj_t).unwrap().inner1
        }
        return TYPE_UNKNOWN
    }

    if kind == NodeKind.ListLit {
        let elems_sl = node_elements(node)
        if elems_sl != -1 && sublist_length(elems_sl) > 0 {
            let first_t = infer_type(sublist_get(elems_sl, 0))
            // Every element beyond the first must still be visited: infer_type is
            // what memoizes a per-node tid (tc_node_tid), and a CALL-style
            // generic-enum/struct constructor's mono-name recovery
            // (register_mono_enum_from_node / register_struct_instance_from_tid)
            // reads that memo via tc_lookup_node_tid. Before this loop, elements
            // 1..N were never inferred at all, so a 2nd+ `Tree.Leaf(n)` in one
            // list literal fell back to the erased bare head at construction —
            // not a codegen list-elem-channel gap, a typecheck one (br tydqe6).
            // The List's own element type still comes from element 0 only,
            // matching pre-existing homogeneity assumptions and diagnostics.
            let mut ei = 1
            while ei < sublist_length(elems_sl) {
                infer_type(sublist_get(elems_sl, ei))
                ei = ei + 1
            }
            return make_list_type(first_t)
        }
        // Empty `[]`: mint a fresh element metavar α (gqg3rk) so a later
        // constraining use (xs.push(1)) can pin it. If nothing pins α, the
        // region-boundary check reports E0301.
        return make_list_type(make_metavar())
    }

    if kind == NodeKind.StructLit {
        let sname = node_type_name(node)
        if sname != "" {
            let dot = sname.index_of(".")
            if dot >= 0 {
                // br 9md3r1. A qualified struct-style variant `E.V { .. }` is named by its
                // PREFIX — 03_types.md:1040 rule 1: "if the site is already written
                // `Enum.Variant { ... }`, that names the variant directly". This must be
                // tried BEFORE lookup_named_type(sname) below, which strips the qualifier
                // and looks up the SUFFIX. That is right for the module-qualified struct
                // literal it was written for (`mod.Type { .. }`, suffix IS the type) and
                // wrong here: the suffix is the variant name, never a type (E0518 makes
                // struct-vs-variant a declaration-time error). So the site used to infer
                // TYPE_UNKNOWN, which unifies with anything — and worse, an unrelated enum
                // that happened to be NAMED like the variant hijacked the lookup and
                // rejected correct code.
                //
                // Mirrors the bare path (:10131) exactly rather than returning the bare
                // enum tid, so a generic enum reverse-infers its instance (`Tree[Int]`);
                // the two spellings must "emit identical code" (03_types.md:1036). The decl
                // node comes from tc_type_decl_nodes keyed by the ENUM — NOT from
                // tc_variant_enum_decl_nodes, which is first-declared-wins per variant name
                // and would hand back the other enum's decl for a shared name, the very
                // confusion this block exists to end.
                //
                // Guarded on the prefix being a TyKind.Enum that HAS the variant, so a
                // module qualifier still falls through untouched. A prefix enum without the
                // named variant also falls through, staying TYPE_UNKNOWN as before — that
                // needs an unknown-variant diagnostic which does not exist yet (br krwywm)
                // and covers the unit and tuple spellings too.
                let qual = sname.slice(0, dot)
                let vname = sname.slice(dot + 1, sname.len())
                let qtid = lookup_named_type(qual)
                if qtid != -1 && type_kind(qtid) == TyKind.Enum && get_variant_by_name(qtid, vname) != -1 {
                    check_deprecated_type(qual, node)
                    let edecl = tc_type_decl_nodes.get(strip_module_qualifier(type_to_str(qtid))) ?? -1
                    return tc_enum_structlit_instance_tid(qtid, edecl, vname, node_fields(node))
                }
                let etid = lookup_named_type(sname)
                if etid != -1 {
                    check_deprecated_type(sname, node)
                    return etid
                }
            } else {
                // 1) hint FIRST (monotonicity: a distant enum decl must never retroactively
                //    rebind a locally-determined site).
                if tc_construct_hint >= 0 && type_kind(tc_construct_hint) == TyKind.Enum && get_variant_by_name(tc_construct_hint, sname) != -1 {
                    return tc_construct_hint
                }
                // 2) struct (Kind A guarantees a name is never both a struct AND a variant).
                let stid = lookup_named_type(sname)
                if stid != -1 {
                    check_deprecated_type(sname, node)
                    // Reverse-infer the concrete instance tid (Box[Int]) from the
                    // field values so the literal carries its specialization, not the
                    // bare generic tid (br qw7v90). Falls back to the bare stid when
                    // no concrete bind is discoverable (all-typevar / empty
                    // collection fields).
                    return tc_struct_lit_instance_tid(stid, sname, node)
                }
                // 3) global-unique variant.
                let n = count_enums_with_variant(sname)
                if n == 1 {
                    let venum = get_variant_enum_tid(sname)
                    // A generic-enum struct-style ctor (`Leaf { value: 1 }`) reverse-
                    // infers its concrete instance tid; non-generic keeps bare (jjhnf3).
                    let vdecl = tc_variant_enum_decl_nodes.get(sname) ?? -1
                    return tc_enum_structlit_instance_tid(venum, vdecl, sname, node_fields(node))
                }
                if n > 1 {
                    diag_error_at("AmbiguousConstruction", AMBIGUOUS_CONSTRUCTION, "bare construction of '{sname}' is ambiguous: '{sname}' is a variant of {n} enums; qualify it (e.g. SomeEnum.{sname} \{ ... }) or add a type annotation", node, "qualify with the enum name or annotate the binding")
                    return TYPE_UNKNOWN
                }
            }
        }
        return TYPE_UNKNOWN
    }

    if kind == NodeKind.TupleLit {
        let elems_sl = node_elements(node)
        if elems_sl == -1 { return TYPE_VOID }
        if sublist_length(elems_sl) == 0 { return TYPE_VOID }
        let mut elem_types: List[Int] = []
        let mut i = 0
        while i < sublist_length(elems_sl) {
            elem_types.push(infer_type(sublist_get(elems_sl, i)))
            i = i + 1
        }
        return make_tuple_type(elem_types)
    }

    if kind == NodeKind.IfExpr {
        let cond_t = infer_type(node_condition(node))
        if is_bool_compat(cond_t) == 0 {
            tc_error_at("if condition must be Bool, got {type_to_str(cond_t)}", node)
        }
        let then_t = infer_type(node_then_body(node))
        let else_node = node_else_body(node)
        if else_node != -1 {
            let else_t = infer_type(else_node)
            if then_t != TYPE_UNKNOWN && else_t != TYPE_UNKNOWN {
                if types_compatible(then_t, else_t) == 0 {
                    tc_error_at("if branches have incompatible types: {type_to_str(then_t)} vs {type_to_str(else_t)}", node)
                }
            }
            if then_t == TYPE_UNKNOWN { return else_t }
            if else_t == TYPE_UNKNOWN { return then_t }
            return type_merge(then_t, else_t)
        }
        return then_t
    }

    if kind == NodeKind.MatchExpr {
        let arms_sl = node_arms(node)
        if arms_sl != -1 && sublist_length(arms_sl) > 0 {
            let mut merged = infer_arm_body(sublist_get(arms_sl, 0))
            let mut i = 1
            while i < sublist_length(arms_sl) {
                let arm_t = infer_arm_body(sublist_get(arms_sl, i))
                if merged == TYPE_UNKNOWN {
                    merged = arm_t
                } else {
                    if arm_t != TYPE_UNKNOWN { merged = type_merge(merged, arm_t) }
                }
                i = i + 1
            }
            return merged
        }
        return TYPE_UNKNOWN
    }

    if kind == NodeKind.Block {
        let tail = tc_block_tail_stmt(node)
        if tail == -1 { return TYPE_VOID }
        return infer_type(tc_block_tail_value(tail))
    }

    if kind == NodeKind.WhileLoop || kind == NodeKind.ForIn || kind == NodeKind.LoopExpr {
        let body = node_body(node)
        return infer_loop_return_type(body)
    }

    if kind == NodeKind.WithBlock {
        return infer_type(node_body(node))
    }

    if kind == NodeKind.RangeLit {
        return make_list_type(TYPE_INT)
    }

    // br e0wmt6. `async.scope { ... }` evaluates to its block's tail, exactly like the bare
    // block it wraps, so the Block arm already computes the answer. Without this arm a
    // statement-position scope returned Unknown here AND its body went unwalked, because
    // tc_check_body's ExprStmt re-dispatch keys on is_block_bearing (now fixed in src/ast.bl).
    if kind == NodeKind.AsyncScope {
        return infer_type(node_body(node))
    }

    // br e0wmt6. `.await` unwraps Handle[T]. The operand is in `obj`, NOT `value`
    // (br 1b7ggq). This became expressible only once TyKind.Handle was constructible
    // (br vag3wc) — before that the operand's own tid was a bare typevar named "Handle" and
    // there was no inner to read, which is why this ticket depended on that one.
    if kind == NodeKind.AwaitExpr {
        let awaited = infer_type(node_obj(node))
        if tc_tid_kind(awaited) == TyKind.Handle && tc_tid_child_count(awaited) >= 1 {
            return tc_tid_child(awaited, 0)
        }
        return TYPE_UNKNOWN
    }

    // br nz7drz. A closure literal's type is its signature. Returning TYPE_UNKNOWN here was
    // the single largest tid-collapse divergence root cause — 16 of the 82 family-A shape
    // cells and 88 of the 1339 rows, where the FLAT universe holds the whole signature
    // (`flat=Fn(int64_t(*)(const blink_closure*, int64_t))`) and the tid holds nothing.
    //
    // Both halves come from the declaration, never from the body: params through
    // resolve_param_type (TYPE_UNKNOWN for an un-annotated param, which is honest — nothing
    // infers those yet), the return through tc_closure_declared_ret (TYPE_VOID when the
    // arrow is omitted, matching the named-fn default).
    if kind == NodeKind.Closure {
        let ret_t = tc_closure_declared_ret(node)
        let mut param_types: List[Int] = []
        let params_sl = node_params(node)
        if params_sl != -1 {
            let mut i = 0
            while i < sublist_length(params_sl) {
                param_types.push(resolve_param_type(sublist_get(params_sl, i)))
                i = i + 1
            }
        }
        return make_fn_type(ret_t, param_types)
    }

    TYPE_UNKNOWN
}

fn infer_loop_return_type(node: Int) -> Int ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if node == -1 { return TYPE_VOID }
    let kind = node_kind(node)

    if kind == NodeKind.Return {
        let rv = infer_type(node_value(node))
        if rv != TYPE_UNKNOWN { return rv }
        return tc_current_fn_ret
    }

    if kind == NodeKind.Block {
        let stmts_sl = node_stmts(node)
        if stmts_sl != -1 {
            let mut i = 0
            while i < sublist_length(stmts_sl) {
                let t = infer_loop_return_type(sublist_get(stmts_sl, i))
                if t != TYPE_VOID {
                    return t
                }
                i = i + 1
            }
        }
        return TYPE_VOID
    }

    if kind == NodeKind.IfExpr {
        let then_t = infer_loop_return_type(node_then_body(node))
        if then_t != TYPE_VOID {
            return then_t
        }
        let else_t = infer_loop_return_type(node_else_body(node))
        if else_t != TYPE_VOID {
            return else_t
        }
        return TYPE_VOID
    }

    if kind == NodeKind.MatchExpr {
        let arms_sl = node_arms(node)
        if arms_sl != -1 {
            let mut i = 0
            while i < sublist_length(arms_sl) {
                let arm = sublist_get(arms_sl, i)
                let t = infer_loop_return_type(node_body(arm))
                if t != TYPE_VOID {
                    return t
                }
                i = i + 1
            }
        }
        return TYPE_VOID
    }

    TYPE_VOID
}

// ── Phase 2: Type check function bodies ─────────────────────────────

fn resolve_param_type(p: Int) -> Int ! TypeCheck.Resolve, Diag.Report {
    let ptype_str = node_type_name(p)
    let ptype_ann = node_type_ann(p)
    if ptype_ann != -1 {
        return resolve_type_ann(ptype_ann)
    }
    if ptype_str != "" {
        let t = resolve_type_name(ptype_str)
        if t != -1 { return t }
    }
    TYPE_UNKNOWN
}

// The statement that carries a block's value, or -1 when the block has none.
//
// This accepted-kind list has TWO consumers — infer_type's Block arm and
// tc_check_body's implicit-tail declared-return check — and their divergence IS
// br skdxkv. Keep it here, in one place, so they cannot drift apart again.
fn tc_block_tail_stmt(block: Int) -> Int {
    let stmts_sl = node_stmts(block)
    if stmts_sl == -1 { return -1 }
    if sublist_length(stmts_sl) == 0 { return -1 }
    let last = sublist_get(stmts_sl, sublist_length(stmts_sl) - 1)
    let last_k = node_kind(last)
    if last_k == NodeKind.ExprStmt { return last }
    if last_k == NodeKind.Return { return last }
    if last_k == NodeKind.IfExpr || last_k == NodeKind.MatchExpr || last_k == NodeKind.Call || last_k == NodeKind.MethodCall || last_k == NodeKind.Ident || last_k == NodeKind.IntLit || last_k == NodeKind.FloatLit || last_k == NodeKind.BoolLit || last_k == NodeKind.InterpString || last_k == NodeKind.BinOp || last_k == NodeKind.UnaryOp || last_k == NodeKind.WhileLoop || last_k == NodeKind.ForIn || last_k == NodeKind.LoopExpr || last_k == NodeKind.WithBlock {
        return last
    }
    -1
}

// The value node inside a tail statement. ExprStmt and Return wrap theirs; every
// other accepted kind IS its own value. A bare `return` yields -1, which infer_type
// maps to TYPE_UNKNOWN — the same answer the inlined list gave before.
fn tc_block_tail_value(stmt: Int) -> Int {
    let k = node_kind(stmt)
    if k == NodeKind.ExprStmt || k == NodeKind.Return { return node_value(stmt) }
    stmt
}

// The tid the IN-SCOPE walk recorded for a value produced inside a scope the speculative
// infer could not see, or -1.
//
// br bfq7nf. infer_type cannot answer for a value that names a binding introduced by the very
// construct being inferred: tc_check_body's LetBinding arm infers the initializer BEFORE
// walking it, so at that moment nr has no frame for the construct and nr_get_type misses. The
// walk that follows does have the frame, and its ExprStmt arm memoizes the value with the
// right answer — so the tid exists, it is merely written one step late. This reads it instead
// of re-deriving it, which is the whole direction of the tid collapse
// (decisions/compiler-type-representation.md Q2) and also the only version that adds no
// diagnostics: infer_type REPORTS as a side effect (its IfExpr arm emits "if branches have
// incompatible types"), so re-inferring to recover the value would double-report every one.
//
// Two scope-introducing constructs reach here, for the same reason:
//
//   Block (and WithBlock/AsyncScope, which forward to the block they wrap, exactly as
//   infer_type's own arms do) — the tail names a `let` of that block.
//
//   MatchExpr (br 3c4g71) — an arm body names a binding of that arm's PATTERN. The merge in
//   infer_type's MatchExpr arm hides this whenever some sibling arm dodges it
//   (`if merged == TYPE_UNKNOWN { merged = arm_t }`), so only a match where NO arm dodges
//   loses its type. That is why the corpus rows all look like a diverging-arm bug: a
//   `None => return 0` body is TYPE_UNKNOWN too, and so cannot cover for the arm beside it.
//
// A DIVERGING arm body contributes nothing, which is the bottom-type rule and not an
// omission: `match o { Some(v) => v  None => return 0 }` in a `-> Int` fn has the type of
// `v`, and folding the `return`'s own operand in would type an `Option[Str]` match as the
// merge of Str and Int. Skipped by kind rather than by leaning on the Return node's memo
// being TYPE_UNKNOWN, so a later change to what Return memoizes cannot quietly break it.
//
// Recursive rather than a loop because a match fans out. The depth bound is a belt: these
// nest only as deep as the source does, and 8 is far past any real spelling.
fn tc_scoped_value_memo(node: Int, depth: Int) -> Int {
    if node == -1 { return -1 }
    if depth >= 8 { return -1 }
    let k = node_kind(node)
    if k == NodeKind.WithBlock || k == NodeKind.AsyncScope {
        return tc_scoped_value_memo(node_body(node), depth + 1)
    }
    if k == NodeKind.Block {
        let tail = tc_block_tail_stmt(node)
        if tail == -1 { return -1 }
        return tc_scoped_value_memo(tc_block_tail_value(tail), depth + 1)
    }
    // An `if` tail is the `match` tail's twin and was missing (br wnbsen): both branch
    // bodies are Blocks the walk DID memoize, so the answer is there to be read. The
    // mismatch case deliberately declines (-1) instead of merging to the then-branch —
    // reporting it here would double-report every `if`, since infer_type's IfExpr arm
    // reports as a side effect, and CLAIMING the then-branch would accept a program that
    // is rejected today.
    if k == NodeKind.IfExpr {
        let then_t = tc_scoped_value_memo(node_then_body(node), depth + 1)
        let else_node = node_else_body(node)
        if else_node == -1 { return then_t }
        let else_t = tc_scoped_value_memo(else_node, depth + 1)
        if then_t < 0 || then_t == TYPE_UNKNOWN { return else_t }
        if else_t < 0 || else_t == TYPE_UNKNOWN { return then_t }
        if types_compatible(then_t, else_t) == 0 { return -1 }
        return type_merge(then_t, else_t)
    }
    if k == NodeKind.MatchExpr {
        let arms_sl = node_arms(node)
        if arms_sl == -1 { return -1 }
        let mut merged = -1
        let mut i = 0
        while i < sublist_length(arms_sl) {
            let arm_t = tc_scoped_value_memo(tc_arm_body_value(sublist_get(arms_sl, i)), depth + 1)
            if arm_t >= 0 && arm_t != TYPE_UNKNOWN {
                if merged < 0 { merged = arm_t } else { merged = type_merge(merged, arm_t) }
            }
            i = i + 1
        }
        return merged
    }
    tc_lookup_node_tid(node)
}

// The value node of a match arm body, or -1 when the body diverges and therefore contributes
// no type. Mirrors infer_arm_body's ExprStmt unwrap — that is the node the walk memoizes.
fn tc_arm_body_value(arm: Int) -> Int {
    let b = node_body(arm)
    if b == -1 { return -1 }
    let k = node_kind(b)
    if k == NodeKind.Return || k == NodeKind.Break || k == NodeKind.Continue { return -1 }
    if k == NodeKind.ExprStmt { return node_value(b) }
    b
}

// A Block body with a non-Void declared return but NO tail value at all (ends in
// a `let`, an empty body, etc.) — the one branch that cannot be folded into the
// per-statement walk, since it reports against the whole fn/closure, not a
// statement that doesn't exist. infer_type(Block) answers TYPE_VOID (not
// TYPE_UNKNOWN) for a valueless body, so `-> Int { let x = 1 }` depends on this
// running here, verbatim, with `at_node` as the report site. Extracted from
// tc_check_fn (br n8mmry) so a closure's own declared return gets the same check
// a named fn's does — "Two spellings of one program must give one answer, and
// the only way to guarantee that is one implementation" (tc_check_returned_value).
fn tc_check_missing_tail_value(body: Int, declared_ret: Int, owner_name: Str, at_node: Int) ! TypeCheck.Report, Diag.Report {
    if node_kind(body) != NodeKind.Block { return }
    if declared_ret == TYPE_VOID || declared_ret == TYPE_UNKNOWN { return }
    if tc_block_tail_stmt(body) == -1 {
        tc_error_at("function '{owner_name}' declared return type {type_to_str(declared_ret)} but body returns {type_to_str(TYPE_VOID)}", at_node)
    }
}

// Genuine scope save/restore: nr_push_scope on entry, nr_pop_scope on exit.
// The sibling diag_push_allows/diag_clear_allows and nr_* scope writes fall
// outside that pattern, which the analyzer correctly flags.
@allow(UnrestoredMutation, IncompleteStateRestore)
fn tc_check_fn(fn_node: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let prev_boundary = tc_boundary_check_active
    tc_boundary_check_active = 1
    nr_push_scope()
    let fn_name = node_name(fn_node)
    let prev_fn_name = tc_current_fn_name
    let prev_fn_ret = tc_current_fn_ret
    tc_current_fn_name = fn_name
    // An impl method's signature lives under the trait-mangled key, not under the display name the
    // caller installed on the node (br zd1tz3).
    let sig = if tc_current_method_sig_key != "" { lookup_fnsig(tc_current_method_sig_key) } else { lookup_fnsig(fn_name) }
    if sig != -1 {
        tc_current_fn_ret = fnsig_pool.get(sig).unwrap().ret
    }

    let is_ffi = has_annotation(fn_node, "ffi")
    diag_push_allows(fn_node)

    let params_sl = node_params(fn_node)
    if params_sl != -1 && is_ffi == 0 {
        let mut i = 0
        while i < sublist_length(params_sl) {
            let p = sublist_get(params_sl, i)
            let pname = node_name(p)
            let ptid = resolve_param_type(p)
            // Mirror the fnsig path (tc_fnsig_param_instance_tid): a generic-struct/enum
            // param binds into scope as a STRUCTURAL instance carrying its type-arg slots,
            // not the erased bare base. Without this the mono-calls-mono forwarding chain
            // (take_box→is_full, forward_box→take_box, recursion) sees a bare enum head
            // that substitute_typevar_tid can't rewrite and the instance-arm guard rejects,
            // falling the element resolution to the legacy CSV path (br 82ajft). Guard on
            // `ann != -1` exactly like the fnsig caller — an un-annotated param resolves to
            // TYPE_UNKNOWN today so the callee's bk-guard already returns -1, but keeping
            // the guard makes this an exact structural mirror and never hands a -1 node to
            // node_elements (which node_or_die-crashes on -1).
            let ann = node_type_ann(p)
            let mut ptid_final = ptid
            if ann != -1 {
                let inst = tc_fnsig_param_instance_tid(ann, ptid)
                if inst != -1 { ptid_final = inst }
            }
            // `self` is the one parameter that can carry no annotation, so the branch above can
            // never type it and resolve_param_type answers TYPE_UNKNOWN — which unifies with
            // anything, silently disabling both the declared-type compare and the ARGUMENT check
            // on every `self.method(...)` in the language (br jzvxav). The impl block's receiver
            // type is the answer, and tc_infer_program has it in hand at the call site.
            //
            // Guarded on the resolved type still being UNKNOWN so an explicitly annotated `self`
            // (and any future typed receiver form) keeps its own annotation: the annotation is
            // more specific than the header, and this must not overwrite it.
            if pname == "self" && ptid_final == TYPE_UNKNOWN && tc_current_self_tid != -1 {
                ptid_final = tc_current_self_tid
            }
            nr_define_typed(pname, 0, ptid_final)
            i = i + 1
        }
    }

    let body = node_body(fn_node)
    if body != -1 && is_ffi == 0 {
        // The implicit-tail declared-return check itself now runs INSIDE tc_check_body,
        // ahead of the body scope's nr_pop_scope (br r9krgr / skdxkv). Re-inferring the
        // body here, after the pop, read a degraded type: a tail Ident resolved to
        // TYPE_UNKNOWN and a tail struct literal fell to the bare-stid return, which
        // then overwrote the good memo and compared vacuously.
        if node_kind(body) == NodeKind.Block { tc_fn_body_block = 1 }
        tc_check_body(body)
        tc_fn_body_block = 0

        // The one branch that CANNOT move: a body with no tail value at all reports
        // against the whole function, not against a statement that does not exist. The
        // old post-pop compare was its only producer (infer_type(Block) answers
        // TYPE_VOID — not UNKNOWN — for a valueless body), so `fn f() -> Int { let x =
        // 1 }` and `fn f() -> Int { }` both depend on keeping it here, verbatim, with
        // fn_node as the report site. `sig != -1` is kept here, not inside the shared
        // helper: it is what leaves this check un-run for every impl method (br ya8qyf),
        // and that miss must stay verbatim.
        if sig != -1 {
            let declared_ret = fnsig_pool.get(sig).unwrap().ret
            tc_check_missing_tail_value(body, declared_ret, fn_name, fn_node)
        }
    }
    diag_clear_allows()
    tc_current_fn_name = prev_fn_name
    tc_current_fn_ret = prev_fn_ret
    nr_pop_scope()
    tc_boundary_check_active = prev_boundary
}

// ── Match exhaustiveness (E0004) ─────────────────────────────────────
//
// Spec: sections/03_types.md "Exhaustiveness". Catalog: E0004 NonExhaustiveMatch.
//
// UNDER-APPROXIMATING BY DESIGN. This reports only what it can PROVE is
// non-exhaustive: a match whose scrutinee resolves to a declared enum, where some
// variant of that enum is named by no arm and no arm is a catch-all. Every shape it
// cannot reason about (Int/Str/Char scrutinees and their ranges, tuple and struct
// patterns, nested refutable sub-patterns) contributes nothing and stays silent.
//
// The asymmetry is deliberate and is the whole safety argument for turning this on
// in a self-hosting compiler: a FALSE NEGATIVE is a match that keeps its old
// behaviour, while a FALSE POSITIVE breaks a working program. So when in doubt this
// code counts a variant as COVERED. That is also why a variant with refutable
// sub-patterns (`Shape.Circle(0)`) counts as fully covering `Circle` — narrowing it
// would need range/nested analysis, which is not implemented, and guessing would
// reject valid code.

// Normalize a possibly-monomorphized enum instance tid (`Tree[Int]`) to its base
// declaration tid (`Tree`), the key evar_pool.enum_id is stored under. The enum twin
// of tc_struct_base_tid; a non-enum, bare, or unresolvable tid returns unchanged.
fn tc_enum_base_tid(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return tid }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Enum { return tid }
    if t.params_count == 0 { return tid }
    let base = lookup_named_type(strip_module_qualifier(t.name))
    if base == -1 { return tid }
    base
}

// Collect the variant names a single pattern covers into `covered`, and return 1 if
// the pattern is a CATCH-ALL (irrefutable) — in which case the match is exhaustive
// regardless of what else is present.
fn tc_exh_collect_pattern(pat: Int, covered: List[Str]) -> Int {
    if pat == -1 { return 0 }
    let pk = node_kind(pat)
    if pk == NodeKind.WildcardPattern { return 1 }
    if pk == NodeKind.IdentPattern {
        // A bare identifier is either a variant spelling (`Red`) or a binding that
        // matches anything (`other`). is_variant_name is the same discriminator the
        // pre-existing heuristic used, so this inherits its resolution rules.
        let nm = node_name(pat)
        if is_variant_name(nm) != 0 {
            covered.push(nm)
            return 0
        }
        return 1
    }
    if pk == NodeKind.EnumPattern {
        // Qualified `Color.Red` puts the type in `name` and the variant in
        // `type_name`; unqualified `Red(x)` puts the variant in `name`.
        let vname = node_name(pat)
        let tname = node_type_name(pat)
        if tname != "" {
            covered.push(tname)
        } else {
            covered.push(vname)
        }
        return 0
    }
    if pk == NodeKind.OrPattern {
        // Union of the alternatives (spec: "OR-patterns — union of covered patterns
        // per alternative"). A catch-all in any alternative makes the whole arm one.
        let alts = node_elements(pat)
        if alts == -1 { return 0 }
        let mut any_catch_all = 0
        let mut i = 0
        while i < sublist_length(alts) {
            if tc_exh_collect_pattern(sublist_get(alts, i), covered) != 0 { any_catch_all = 1 }
            i = i + 1
        }
        return any_catch_all
    }
    if pk == NodeKind.StructPattern {
        // A struct-STYLE variant written bare (`NotFound { msg }`, `Shared { only }`)
        // parses here, not as an EnumPattern — the parser only builds an EnumPattern
        // for the qualified `Type.Variant { .. }` form. Its `type_name` holds the bare
        // name. Missing this arm reported three exhaustive corpus matches as missing
        // variants, so it is load-bearing, not defensive.
        //
        // A genuine struct destructuring (`Point { x, y }`) also lands here; its name
        // is not a variant name, so it contributes nothing. A name that collides across
        // enums is safe too: coverage is compared against the SCRUTINEE enum's declared
        // variant list, which scopes the match.
        let sname = node_type_name(pat)
        if is_variant_name(sname) != 0 {
            covered.push(sname)
        }
        return 0
    }
    if pk == NodeKind.AsPattern {
        // `p as name` binds in addition to matching; coverage is the inner pattern's.
        return tc_exh_collect_pattern(node_pattern(pat), covered)
    }
    // Int/Str/Range/Tuple/List patterns cover no enum variant and are not catch-alls.
    // Contribute nothing.
    0
}

fn tc_check_match_exhaustive(node: Int, scrut_tid: Int, arms_sl: Int) ! TypeCheck.Report, Diag.Report {
    if arms_sl == -1 { return }
    let base = tc_enum_base_tid(tc_resolve(scrut_tid))
    if base < 0 || base >= ty_pool.len() { return }
    if ty_pool.get(base).unwrap().kind != TyKind.Enum { return }

    // The declared variant set. An enum the registry knows nothing about (0 variants)
    // is unanalyzable, not vacuously non-exhaustive.
    let mut declared: List[Str] = []
    let mut i = 0
    while i < evar_pool.len() {
        let ev = evar_pool.get(i).unwrap()
        if ev.enum_id == base { declared.push(ev.name) }
        i = i + 1
    }
    if declared.len() == 0 { return }

    let mut covered: List[Str] = []
    let mut ai = 0
    while ai < sublist_length(arms_sl) {
        let arm = sublist_get(arms_sl, ai)
        // Guards are opaque (spec): a guarded arm may not fire, so it contributes
        // NOTHING — not its variants, and not its catch-all-ness.
        if node_guard(arm) == -1 {
            if tc_exh_collect_pattern(node_pattern(arm), covered) != 0 { return }
        }
        ai = ai + 1
    }

    let mut missing: List[Str] = []
    let mut di = 0
    while di < declared.len() {
        let want = declared.get(di).unwrap()
        let mut seen = 0
        let mut ci = 0
        while ci < covered.len() {
            if covered.get(ci).unwrap() == want { seen = 1 }
            ci = ci + 1
        }
        if seen == 0 { missing.push(want) }
        di = di + 1
    }
    if missing.len() == 0 { return }

    let ename = strip_module_qualifier(ty_pool.get(base).unwrap().name)
    let mut list_str = ""
    let mut mi = 0
    while mi < missing.len() {
        if mi > 0 { list_str = "{list_str}, " }
        list_str = "{list_str}`{missing.get(mi).unwrap()}`"
        mi = mi + 1
    }
    let noun = if missing.len() == 1 { "pattern" } else { "patterns" }
    diag_error_at("NonExhaustiveMatch", NON_EXHAUSTIVE_MATCH,
        "non-exhaustive match: missing {noun} {list_str}", node,
        "add an arm for {list_str}, or a `_ => ...` catch-all arm to absorb the rest of {ename}")
}

// Bind a `with <expr> as x { .. }` resource name WITH its type (br w089a0).
//
// A resource clause is a declaration site, exactly like a `let`: the binder names the value
// of the resource expression. It was bound with the untyped `nr_define`, so the entry carried
// TYPE_UNKNOWN — which unifies with anything, so a declared type over `x.method()` was never
// compared and the arguments to that call were never checked. `with make() as r { let bad:
// Str = r.value() }` compiled, linked, ran and printed the Int.
//
// The type was never missing, only dropped: the resource expression is walked on the line
// below, and `with db.prepare(..).unwrap() as stmt` types all the way through the Result
// chain. So this is a binding, not a new inference path — the fifth instance of the
// untyped-receiver family (w13xgb Ptr, ps5br9 ffi scope, jzvxav self, nrrs28 Template), and
// the second one whose whole fix is to use the typed spelling that already exists.
//
// The tid is also published on the WithResource node itself, the way the LetBinding arm
// publishes a let's tid: infer_type memoizes expression nodes only, so a resource clause
// carried no tid at all and codegen's ScopeVar for the binder had nothing to read.
//
// An unresolvable resource binds TYPE_UNKNOWN, i.e. exactly what it bound before — which is
// what keeps `ffi.scope()` (not a Blink type at all) working unchanged.
fn tc_bind_with_resource(item: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    let res_expr = node_value(item)
    tc_check_body(res_expr)
    let res_tid = infer_type(res_expr)
    if item < tc_node_tid.len() && res_tid != TYPE_UNKNOWN {
        tc_node_tid.set(item, res_tid)
    }
    nr_define_typed(node_name(item), 0, res_tid)
}

// Block branch genuinely save/restores scope via nr_push_scope/nr_pop_scope;
// the recursive tc_check_body and other nr_* writes fall outside that pattern,
// which the analyzer correctly flags.
@allow(UnrestoredMutation, IncompleteStateRestore)
fn tc_check_body(node: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    if node == -1 { return }
    let kind = node_kind(node)

    if kind == NodeKind.Block {
        // Read-then-zero: only the block tc_check_fn set the marker for is a fn body.
        let is_fn_body = tc_fn_body_block
        tc_fn_body_block = 0
        nr_push_scope()
        let stmts_sl = node_stmts(node)
        if stmts_sl != -1 {
            let mut i = 0
            let mut _found_terminal = 0
            while i < sublist_length(stmts_sl) {
                let stmt = sublist_get(stmts_sl, i)
                if _found_terminal != 0 {
                    diag_warn_at("UnreachableCode", UNREACHABLE_CODE, "unreachable code after return/break/continue", stmt, "remove this code or move it before the control flow statement")
                }
                tc_check_body(stmt)
                let sk = node_kind(stmt)
                if sk == NodeKind.Return || sk == NodeKind.Break || sk == NodeKind.Continue {
                    _found_terminal = 1
                }
                i = i + 1
            }
        }
        // ORDERING CONTRACT (br r9krgr): this must run BEFORE nr_pop_scope. The pin
        // inside tc_check_returned_value binds metavars in place — bind_metavar mutates
        // the α slot itself, and the tail's instance tid and the scope entry for a local
        // hold the very same α integers — so nr_pop_scope's E0301 region-boundary check
        // then reads them already solved, with no scope-entry rewrite. Pop first and the
        // boundary check wins the race, which is the bug.
        //
        // NodeKind.Return is excluded because its own arm already ran this check on the
        // same value during the statement walk above; including it is the double-report.
        //
        // The declared-return gate is hoisted OUT of tc_check_returned_value and
        // repeated here, and that placement is load-bearing: infer_type REPORTS as a
        // side effect (its IfExpr arm emits "if branches have incompatible types"), so
        // inferring a tail the old code never inferred invents diagnostics. The old
        // post-pop site was gated on `sig != -1 && declared_ret not Void/Unknown` and so
        // never ran on a Void-returning fn — `fn f() { if c { a() } else { b() } }` with
        // arms of different types was, and stays, silent. `tc_current_fn_ret >= 0` is
        // the `sig != -1` half: tc_check_fn installs a return type only when
        // lookup_fnsig hits, and it is called from two non-reentrant top-level loops,
        // so a miss leaves the -1 that init_types/the prior restore put there. (Which
        // is why this check does not reach impl methods — see tc_check_returned_value.)
        if is_fn_body != 0 && tc_current_fn_ret >= 0 && tc_current_fn_ret != TYPE_VOID && tc_current_fn_ret != TYPE_UNKNOWN {
            let tail = tc_block_tail_stmt(node)
            if tail != -1 && node_kind(tail) != NodeKind.Return {
                let tail_val = tc_block_tail_value(tail)
                if tail_val != -1 {
                    tc_check_returned_value(infer_type(tail_val), tail_val)
                }
            }
        }
        nr_pop_scope()
        return
    }

    if kind == NodeKind.LetBinding {
        let vname = node_name(node)
        let val = node_value(node)
        let is_mut = node_is_mut(node)

        let type_str = node_type_name(node)
        let type_ann = node_target(node)
        let mut declared_tid = TYPE_UNKNOWN
        if type_ann != -1 {
            declared_tid = resolve_type_ann(type_ann)
        } else if type_str != "" {
            let rt = resolve_type_name(type_str)
            if rt != -1 {
                declared_tid = rt
            }
        }

        let mut inferred_tid = TYPE_UNKNOWN
        if val != -1 {
            let saved_hint = tc_construct_hint
            if declared_tid != TYPE_UNKNOWN { tc_construct_hint = resolve_alias_tid(declared_tid) }
            inferred_tid = infer_type(val)
            tc_construct_hint = saved_hint
            tc_check_body(val)
            // br bfq7nf / br 3c4g71. `let x = { let h = 5  h }` and
            // `let x = match sh { Circle(a) => a  Square(a) => a }` — the value names a binding
            // the construct itself introduces, which the infer_type above could not see because
            // tc_check_body had not pushed that frame yet. It has now, and it memoized the value
            // in scope, so the answer is available one line later. Placed BEFORE the
            // declared/inferred compare below, which is the point: TYPE_UNKNOWN unifies with
            // anything, so `let x: Str = { let h = 5  h }` typechecked clean, and a closure
            // reached this way lost the arity check br nz7drz had just made possible.
            //
            // Recovery only — it can never overwrite an answer infer_type already gave, so no
            // shape that resolved before now takes a different tid.
            //
            // The gate reads "carries a hole", not "IS a hole" (br gmb211). A carrier whose
            // ELEMENT names the block-local infers as `List[?]` / `Option[?]` / `(?, Int)` —
            // none of them TYPE_UNKNOWN — so an `== TYPE_UNKNOWN` gate treated a partially
            // erased answer as an answer and left the element erased, which is a SILENT
            // miscompile one level down (`let bad: Int = xs.get(0).unwrap()` ran and printed a
            // Str). The take stays monotone in both cases: a bare UNKNOWN accepts the memo
            // whole, exactly as before, and a partially erased answer takes only the memo's
            // answers for the positions it has no answer of its own for.
            if inferred_tid == TYPE_UNKNOWN || tc_tid_has_unknown(inferred_tid) != 0 {
                let memo = tc_scoped_value_memo(val, 0)
                if memo >= 0 && memo != TYPE_UNKNOWN {
                    if inferred_tid == TYPE_UNKNOWN {
                        inferred_tid = memo
                    } else {
                        inferred_tid = tc_tid_fill_unknowns(inferred_tid, memo)
                    }
                }
            }
        }

        if declared_tid != TYPE_UNKNOWN && inferred_tid != TYPE_UNKNOWN {
            if assignment_types_compatible(declared_tid, inferred_tid, val) == 0 {
                tc_error_at("variable '{vname}': declared type {type_to_str(declared_tid)} but got {type_to_str(inferred_tid)}", node)
            } else {
                // A declared let type is an expected-type source for the value's
                // metavars, not only something to compare against. This arm otherwise
                // only compares and then discards `inferred_tid` for `final_tid =
                // declared_tid`, so `let e: RGT[Int] = mk()` left the α that
                // instantiate_return_type minted for mk's return-only T unbound — the
                // declared instantiation was right there and never written down
                // (3dpshm).
                //
                // In the COMPATIBLE branch only, and via the same in-place unify the
                // tail-return site uses: the α integers in the value's instance arg
                // list are the same integers its fields hold, so one bind solves the
                // mono name and the field ctor's kops vtable together. Placing it here
                // rather than before the compare means it can never turn a reported
                // mismatch into a silent success.
                //
                // The mint gate is no longer the ONLY way in (sskpk8). It asks "did
                // instantiate_return_type register a return-only metavar group for this call
                // node", which only a GENERIC FN CALL ever does, so a builtin container ctor
                // never qualified: `let m: Map[Str, List[Int]] = Map()` left the ctor node at
                // `Map[α, β]` with both metavars unbound while the declared instantiation sat
                // right there — the same defect 3dpshm was, one node kind over.
                //
                // The second way in is deliberately narrow, and each clause paid for itself by
                // breaking a pinned test when it was absent:
                //
                //   • Map/Set HEAD only. The struct/enum heads tc_pin_admits_declared also
                //     admits stay mint-gated. `let e: GT[QB[Int]] = GT { s: Set() }` binds a
                //     FIELD's α, not the binding's, and making `Set[QB[Int]]` concrete drives
                //     kops_table_name down its fail-closed branch — QB carries no Hash derive,
                //     so there is genuinely no table and the compiler emits
                //     BLINK_COMPILER_BUG_kops. That program's hazard is real and pre-existing
                //     (the annotation-only hashability validators, br xcx9wc); revealing it is
                //     not this ticket's job, and doing it here would report it as a C
                //     compile error instead of a diagnostic.
                //   • No bare typevar. `let m: Map[K, V] = Map()` inside `fn f[K, V]()` must
                //     not be pinned: `α := K` trades a hole monomorphization can still fill
                //     for one nothing can (tc_tid_has_bare_typevar), and it emitted
                //     BLINK_COMPILER_BUG_kops_unsupported_K_ct23_ — the kops selector had been
                //     recovering the concrete key from the instantiation.
                //   • No alias. `let m: Map[Port, Int] = Map()` over `type Port = Int` keeps
                //     `Port` in the tid's key slot while the annotation path lowers it to Int,
                //     so pinning commits the un-canonical spelling and the i64 vtable is never
                //     selected (tc_tid_has_alias, br bvh7qt).
                //
                // Two gates then remain inside tc_pin_tail_ret_generic and they are the shared
                // ones: an admitted declared head, and an actually-unbound metavar in the value.
                let mut pin_ok = tc_node_has_ret_mint(val) != 0
                if pin_ok == false {
                    let dk = type_kind(resolve_alias_tid(declared_tid))
                    if dk == TyKind.Map || dk == TyKind.Set {
                        if tc_tid_has_bare_typevar(declared_tid) == 0 && tc_tid_has_alias(declared_tid) == 0 {
                            pin_ok = true
                        }
                    }
                }
                if pin_ok {
                    tc_pin_tail_ret_generic(declared_tid, inferred_tid)
                }
            }
        }

        let mut final_tid = declared_tid
        if final_tid == TYPE_UNKNOWN {
            final_tid = inferred_tid
        }
        // Publish the BINDING's type on the let node itself. infer_type memoizes expression
        // nodes only, so a `let` statement carried no tid at all and codegen had to guess
        // between the annotation node and the initializer — and guessing the initializer is
        // WRONG for `let m: Map[Str, List[Int]] = Map()`: the declared type is compared
        // against the initializer, never unified into it, so the ctor's tid is still
        // `Map[α, β]` with both metavars unbound. final_tid is typecheck's own answer to
        // "what type is this variable", by the same rule three lines up, so publishing it is
        // what lets codegen READ the type rather than re-derive it (Stage 2 of the tid
        // collapse, decisions/compiler-type-representation.md Q2).
        //
        // Additive: this slot was the -1 unset sentinel for every let node before now.
        if node < tc_node_tid.len() && final_tid != TYPE_UNKNOWN {
            tc_node_tid.set(node, final_tid)
        }
        // Record the decl node (gqg3rk) so the E0301 region-boundary check has a
        // span. Node is used only for that diagnostic in this pass — unused-var
        // warnings are off during inference (nr_warn_unused == 0).
        nr_define_typed_at(vname, is_mut, final_tid, node)
        if type_ann == -1 && type_str == "" && final_tid != TYPE_UNKNOWN {
            tc_hints.push(HintEntry { line: node_line(node), col: node_col(node), name: vname, type_str: type_to_str(final_tid), module: nr_current_module })
        }
        let tc_let_pat_sl = node_elements(node)
        if tc_let_pat_sl != -1 {
            let tc_let_elems_sl = node_elements(tc_let_pat_sl)
            if tc_let_elems_sl != -1 {
                let mut tpi = 0
                while tpi < sublist_length(tc_let_elems_sl) {
                    let tsp = sublist_get(tc_let_elems_sl, tpi)
                    nr_define_typed(node_name(tsp), is_mut, TYPE_UNKNOWN)
                    tpi = tpi + 1
                }
            }
        }
        return
    }

    if kind == NodeKind.Assignment || kind == NodeKind.CompoundAssign {
        let target = node_target(node)
        let val = node_value(node)
        if target != -1 && val != -1 {
            let target_t = infer_type(target)
            let val_t = infer_type(val)
            if target_t != TYPE_UNKNOWN && val_t != TYPE_UNKNOWN {
                if assignment_types_compatible(target_t, val_t, val) == 0 {
                    tc_error_at("assignment: cannot assign {type_to_str(val_t)} to {type_to_str(target_t)}", node)
                } else {
                    // An assignment TARGET is a declared-type source for the value's
                    // metavars, not only something to compare against — the same
                    // reasoning as the LetBinding arm above, and the same in-place
                    // unify, so one bind solves the mono name and the field ctor's
                    // kops vtable together (e2kjqy). Without it `e = mk()` left the α
                    // that instantiate_return_type minted for mk's return-only T
                    // unbound and it reached emit_struct_lit erased.
                    //
                    // target_t already carries the right expected type for both
                    // spellings: an Ident target resolves through scope, a FieldAccess
                    // target through the field arm, which substitutes the enclosing
                    // instance's concrete args.
                    //
                    // No tc_in_closure_depth guard, unlike tc_check_returned_value:
                    // that guard is now kept for a different reason (br srztkr) —
                    // since n8mmry, tc_current_fn_ret correctly names the closure's
                    // own declared return and is no longer stale ambient state.
                    // target_t was never ambient to begin with: it's read from the
                    // target expression itself, so a closure assigning to a
                    // captured binding pins that binding's own declared type
                    // regardless.
                    //
                    // Assignment only, never CompoundAssign: no compound operator is
                    // defined over any kind tc_pin_admits_declared admits (Map, Set,
                    // generic struct/enum), so the branch would be dead. Excluded on
                    // purpose rather than by accident.
                    //
                    // Restricted to values that minted here — see tc_node_has_ret_mint.
                    if kind == NodeKind.Assignment && tc_node_has_ret_mint(val) != 0 {
                        tc_pin_tail_ret_generic(target_t, val_t)
                    }
                }
            }
        }
        return
    }

    if kind == NodeKind.IfExpr {
        let cond_t = infer_type(node_condition(node))
        if is_bool_compat(cond_t) == 0 {
            tc_error_at("if condition must be Bool, got {type_to_str(cond_t)}", node)
        }
        tc_check_body(node_then_body(node))
        tc_check_body(node_else_body(node))
        return
    }

    if kind == NodeKind.WhileLoop {
        let cond_t = infer_type(node_condition(node))
        if is_bool_compat(cond_t) == 0 {
            tc_error_at("while condition must be Bool, got {type_to_str(cond_t)}", node)
        }
        tc_check_body(node_body(node))
        return
    }

    if kind == NodeKind.ForIn {
        nr_push_scope()
        let iter_t = tc_resolve(infer_type(node_iterable(node)))
        let iter_tk = type_kind(iter_t)
        let mut elem_t = TYPE_UNKNOWN
        if iter_tk == TyKind.List || iter_tk == TyKind.Set {
            elem_t = ty_pool.get(iter_t).unwrap().inner1
        } else {
            // TyKind.Unknown here means iter_t is still an unbound metavar (e.g. a lazy-adapter
            // chain like `.enumerate()`/`.zip()` not yet pinned at this point in checking) --
            // under-determined, not known to be non-iterable. Leave it to E0301's
            // region-boundary check rather than misdiagnosing it here. Set/Map/Str/Bytes/
            // Iterator/Channel ARE spec-legal iterables (sections/03c_protocols.md
            // IntoIterator table, sections/03_types.md:656 for Bytes' IntoIterator[U8],
            // plus the Channel receive extension) so they pass through even where codegen's
            // emit_for_in has no arm yet -- that gap is I0002, an internal compiler error,
            // never a user-facing NotIterable.
            let is_deferred_iterable = iter_tk == TyKind.Unknown || iter_tk == TyKind.Map || iter_tk == TyKind.Str || iter_tk == TyKind.Bytes || iter_tk == TyKind.Iterator || iter_tk == TyKind.Channel
            if is_deferred_iterable == 0 {
                diag_error_at("NotIterable", NOT_ITERABLE, "cannot iterate over type '{type_to_str(iter_t)}' with a `for` loop -- only List, Set, Map, Range, Str, Bytes, Channel, and Iterator implement iteration", node_iterable(node), "iterate a List, Set, Map, Range, Str, Bytes, Channel, or Iterator instead")
            }
        }
        nr_define_typed(node_var_name(node), 0, elem_t)
        let tc_for_pat_sl = node_elements(node)
        if tc_for_pat_sl != -1 {
            tc_check_pattern_types(tc_for_pat_sl)
        }
        tc_check_body(node_body(node))
        nr_pop_scope()
        return
    }

    if kind == NodeKind.MatchExpr {
        tc_check_body(node_scrutinee(node))
        let scrut_tid = infer_type(node_scrutinee(node))
        let arms_sl = node_arms(node)
        if arms_sl != -1 {
            let mut i = 0
            while i < sublist_length(arms_sl) {
                let arm = sublist_get(arms_sl, i)
                nr_push_scope()
                tc_pattern_binding_type = scrut_tid
                tc_check_pattern_types(node_pattern(arm))
                tc_pattern_binding_type = -1
                tc_check_body(node_body(arm))
                nr_pop_scope()
                i = i + 1
            }

            tc_check_match_exhaustive(node, scrut_tid, arms_sl)
        }
        return
    }

    if kind == NodeKind.LoopExpr {
        tc_check_body(node_body(node))
        return
    }

    if kind == NodeKind.WithBlock {
        let wh_sl2 = node_handlers(node)
        nr_push_scope()
        if wh_sl2 != -1 {
            let mut wi2 = 0
            while wi2 < sublist_length(wh_sl2) {
                let wh_item2 = sublist_get(wh_sl2, wi2)
                let wh_kind2 = node_kind(wh_item2)
                if wh_kind2 == NodeKind.WithResource {
                    tc_bind_with_resource(wh_item2)
                } else if wh_kind2 == NodeKind.Ident && node_name(wh_item2) == "arena" {
                } else {
                    tc_check_body(wh_item2)
                }
                wi2 = wi2 + 1
            }
        }
        tc_check_body(node_body(node))
        nr_pop_scope()
        return
    }

    if kind == NodeKind.WithResource {
        tc_check_body(node_value(node))
        return
    }

    // br pgc3d9: without this arm a handler's method bodies were unwalked in EVERY position —
    // as a call argument, written inline in a `with`, or bound to a `let`. The WithBlock arm
    // above already ROUTES an inline handler here; it landed on this function's silent
    // `let _skip = 0` fallthrough. So the route was never the missing piece, the arm was.
    if kind == NodeKind.HandlerExpr {
        let hm_sl = node_methods(node)
        if hm_sl != -1 {
            let mut hi = 0
            while hi < sublist_length(hm_sl) {
                tc_check_handler_method(sublist_get(hm_sl, hi))
                hi = hi + 1
            }
        }
        return
    }

    if kind == NodeKind.AssertPanics {
        // Lexical, like the E0827 skip fence — see tc_in_test_lexical's declaration.
        if tc_in_test_lexical == 0 {
            diag_error_at("AssertPanicsOutsideTest", ASSERT_PANICS_OUTSIDE_TEST,
                "assert_panics can only be used inside a test body",
                node, "move it into a 'test \{ ... }' block")
        }
        if tc_in_assert_panics != 0 {
            diag_error_at("AssertPanicsNestedExpectPanic", ASSERT_PANICS_NESTED_EXPECT_PANIC,
                "assert_panics cannot be nested inside another assert_panics block",
                node, "split the assertions into two separate tests")
        }
        let ap_match = node_value(node)
        if ap_match != -1 {
            tc_check_body(ap_match)
            let mt = infer_type(ap_match)
            if mt != TYPE_UNKNOWN && mt != TYPE_STR {
                tc_error_at("assert_panics matching: must be Str, got {type_to_str(mt)}", node)
            }
        }
        let prev_in_ap = tc_in_assert_panics
        tc_in_assert_panics = 1
        nr_push_scope()
        tc_check_body(node_body(node))
        nr_pop_scope()
        tc_in_assert_panics = prev_in_ap
        return
    }

    if kind == NodeKind.AsyncScope {
        tc_check_body(node_body(node))
        return
    }

    if kind == NodeKind.AsyncSpawn {
        tc_check_body(node_body(node))
        return
    }

    if kind == NodeKind.Closure {
        nr_push_scope()
        let params_sl = node_params(node)
        if params_sl != -1 {
            let mut i = 0
            while i < sublist_length(params_sl) {
                let p = sublist_get(params_sl, i)
                let pname = node_name(p)
                let ptid = resolve_param_type(p)
                nr_define_typed(pname, 0, ptid)
                i = i + 1
            }
        }
        tc_check_closure_body_against_own_ret(node)
        nr_pop_scope()
        return
    }

    if kind == NodeKind.ExprStmt {
        let val = node_value(node)
        if val != -1 {
            infer_type(val)
            // Statement-position HOFs (l.for_each(fn(x){...})) need the MethodCall
            // branch to walk the closure body. Binding-position calls already
            // get this via tc_check_body(val) in the LetBinding handler. Scoped to
            // MethodCall rather than recursing unconditionally: the Assignment handler
            // lacks LetBinding's literal-to-sized-int coercion, so walking arbitrary
            // statement values would surface spurious errors (br: separate ticket).
            //
            // Block-bearing control-flow in statement position must also be walked:
            // infer_type only visits a block's tail, so non-tail statements inside
            // their bodies (e.g. `result = result + x`) would skip every per-statement
            // check otherwise. `if`/`while`/`loop`/`for`/`match`/`with` are all bare
            // statements (parse_stmt produces the node directly; parse_primary never
            // produces them in statement position), so they never arrive ExprStmt-
            // wrapped — but a statement-position match still dispatches to the bare
            // MatchExpr branch above, not here. is_block_bearing is the single source
            // of truth for THIS re-dispatch so a future block-bearing kind cannot
            // silently lose statement-walking coverage here.
            // br pgc3d9: NodeKind.Call joins MethodCall here for the same reason MethodCall was
            // already listed — a statement-position call can carry a closure argument whose
            // body needs walking (`take(fn() { ... })`). Both arms are narrow by construction:
            // they walk callable arguments only, never arbitrary statement values.
            let vk = node_kind(val)
            if is_block_bearing(vk) || vk == NodeKind.MethodCall || vk == NodeKind.Call {
                tc_check_body(val)
            }
        }
        return
    }

    if kind == NodeKind.Return {
        let val = node_value(node)
        if val != -1 {
            let saved_hint = tc_construct_hint
            if tc_current_fn_ret != TYPE_VOID && tc_current_fn_ret != TYPE_UNKNOWN { tc_construct_hint = resolve_alias_tid(tc_current_fn_ret) }
            let val_t = infer_type(val)
            tc_construct_hint = saved_hint
            // Shared with the implicit tail (br skdxkv) — see tc_check_returned_value for
            // why each guard is load-bearing. This arm stays necessary alongside the tail
            // site: an EARLY return inside an `if` is not the block's last statement, so
            // the tail check never visits it.
            tc_check_returned_value(val_t, node)
        } else {
            if tc_current_fn_ret != TYPE_VOID && tc_current_fn_ret != TYPE_UNKNOWN {
                tc_error_at("function '{tc_current_fn_name}' returns {type_to_str(tc_current_fn_ret)} but bare 'return' has no value", node)
            }
        }
        return
    }

    if kind == NodeKind.MethodCall {
        // infer_type already validated explicit closure annotations (Part A) and
        // ran arg/method checks during the binding/ExprStmt inference. Here we add
        // the Part B body walk: bind unannotated closure params to the elem/acc
        // type and type-check the body once.
        let obj_t = infer_type(node_obj(node))
        let args_sl = node_args(node)
        // The argument the List-HOF path walks itself, so the generic walk below does not
        // report its contents a second time.
        let mut hof_arg = -1
        if type_kind(obj_t) == TyKind.List {
            let method = node_method(node)
            let elem = ty_pool.get(obj_t).unwrap().inner1
            if is_elem_closure_hof(method) != 0 {
                check_closure_body(closure_arg_at(args_sl, 0), elem, -1)
                hof_arg = 0
            } else if method == "fold" {
                if args_sl != -1 && sublist_length(args_sl) >= 2 {
                    let acc_t = infer_type(sublist_get(args_sl, 0))
                    check_closure_body(sublist_get(args_sl, 1), acc_t, elem)
                    hof_arg = 1
                }
            }
        }
        // br pgc3d9: the branch above used to be the whole arm, under the comment "Only List
        // has closure-taking HOFs". That is true of the STDLIB and false of the LANGUAGE — any
        // fn-typed param takes a closure, and `async.spawn(fn() { ... })` (the shape in our own
        // src/cli.bl) is a MethodCall on a receiver that is not a List. Those bodies were never
        // walked at all.
        tc_check_callable_arg_bodies(args_sl, hof_arg)
        return
    }

    // br pgc3d9: a plain call had NO arm here, so `take(fn() { ... })` fell through to the
    // silent tail below and its closure argument's body was never typechecked in either
    // position. Only the callable arguments need walking: infer_type has already visited every
    // argument expression, and recursing unconditionally would surface the spurious errors the
    // ExprStmt arm's comment describes.
    if kind == NodeKind.Call {
        // br x3x0qj: the CALLEE of an immediately-invoked closure is a body that needs
        // walking too, and this arm reached only the arguments. Callee position is the third
        // position of 1hg8b6's family — that ticket fixed call-argument position and still
        // scopes struct-literal-field position. Without this, `fn() -> Int { "notint" }()`
        // escaped to the C compiler.
        let cb_callee = node_left(node)
        if cb_callee != -1 && node_kind(cb_callee) == NodeKind.Closure {
            tc_check_body(cb_callee)
        }
        tc_check_callable_arg_bodies(node_args(node), -1)
        return
    }

    let _skip = 0
}

let mut tc_pattern_binding_type: Int = -1

// Expected enum tid for a bare struct-style construction site (`Name { ... }`).
// Set before infer_type at the four hint sources (binding annotation, return type,
// fn-arg param, Ok/Err/Some carrier) and consulted FIRST among the unqualified
// resolution rules. -1 = no hint. Mirrors the tc_pattern_binding_type discipline.
let mut tc_construct_hint: Int = -1

// Genuinely saves/restores tc_pattern_binding_type around recursive descent;
// the nr_define/nr_define_typed/recursive calls also write scope-management
// globals (nr_scope_*, nr_name_top) — defining the pattern's bindings is the
// intended permanent effect, not speculative state to roll back.
@allow(UnrestoredMutation)
fn tc_check_pattern_types(node: Int) ! TypeCheck.Resolve {
    if node == -1 { return }
    let kind = node_kind(node)
    if kind == NodeKind.IdentPattern {
        let name = node_name(node)
        if name != "_" && is_variant_name(name) == 0 {
            if tc_pattern_binding_type >= 0 {
                nr_define_typed(name, 0, tc_pattern_binding_type)
            } else {
                nr_define(name)
            }
        }
        return
    }
    if kind == NodeKind.EnumPattern {
        let vname = node_name(node)
        let tname = node_type_name(node)
        let saved_binding = tc_pattern_binding_type
        // short_name is the variant's declared name; for qualified `E.A(...)` it's `tname`,
        // for unqualified `A(...)` it's `vname`. enum_tid is resolved from the qualifier when
        // present, otherwise from the outer binding hint, otherwise via global lookup.
        let mut short_name = vname
        let mut variant_enum_tid = -1
        if tname != "" {
            short_name = tname
            variant_enum_tid = named_type_map.get(vname) ?? -1
        }
        if vname == "Some" && tc_pattern_binding_type >= 0 && type_kind(tc_pattern_binding_type) == TyKind.Option {
            tc_pattern_binding_type = ty_pool.get(tc_pattern_binding_type).unwrap().inner1
        } else if vname == "Ok" && tc_pattern_binding_type >= 0 && type_kind(tc_pattern_binding_type) == TyKind.Result {
            tc_pattern_binding_type = ty_pool.get(tc_pattern_binding_type).unwrap().inner1
        } else if vname == "Err" && tc_pattern_binding_type >= 0 && type_kind(tc_pattern_binding_type) == TyKind.Result {
            tc_pattern_binding_type = ty_pool.get(tc_pattern_binding_type).unwrap().inner2
        } else {
            tc_pattern_binding_type = -1
        }
        let mut var_idx = -1
        if variant_enum_tid >= 0 {
            var_idx = get_variant_by_name(variant_enum_tid, short_name)
        }
        if var_idx == -1 && saved_binding >= 0 && type_kind(saved_binding) == TyKind.Enum {
            var_idx = get_variant_by_name(saved_binding, short_name)
        }
        if var_idx == -1 {
            let fallback_tid = get_variant_enum_tid(short_name)
            if fallback_tid != TYPE_UNKNOWN {
                var_idx = get_variant_by_name(fallback_tid, short_name)
            }
        }
        let flds_sl = node_fields(node)
        if flds_sl != -1 {
            let is_struct_pat = node_int_val(node)
            let mut i = 0
            while i < sublist_length(flds_sl) {
                let f = sublist_get(flds_sl, i)
                if is_struct_pat != 0 {
                    // Struct-style fields: StructLitField nodes; define field names as vars
                    let fpat = node_pattern(f)
                    let fname = node_name(f)
                    let mut sub_t = -1
                    if var_idx >= 0 { sub_t = lookup_evfield_type_by_name(var_idx, fname) }
                    if sub_t < 0 { sub_t = tc_pattern_binding_type }
                    if fpat != -1 {
                        tc_pattern_binding_type = sub_t
                        tc_check_pattern_types(fpat)
                    } else {
                        if sub_t >= 0 {
                            nr_define_typed(fname, 0, sub_t)
                        } else {
                            nr_define(fname)
                        }
                    }
                } else {
                    let mut sub_t = -1
                    if var_idx >= 0 { sub_t = lookup_evfield_type_by_index(var_idx, i) }
                    if sub_t < 0 { sub_t = tc_pattern_binding_type }
                    tc_pattern_binding_type = sub_t
                    tc_check_pattern_types(f)
                }
                i = i + 1
            }
        }
        tc_pattern_binding_type = saved_binding
        return
    }
    if kind == NodeKind.StructPattern {
        let flds_sl = node_fields(node)
        if flds_sl != -1 {
            let mut i = 0
            while i < sublist_length(flds_sl) {
                nr_define(node_name(sublist_get(flds_sl, i)))
                i = i + 1
            }
        }
        return
    }
    if kind == NodeKind.TuplePattern {
        let saved_binding = tc_pattern_binding_type
        let elems_sl = node_elements(node)
        if elems_sl != -1 {
            // Decompose the tuple binding hint so each element pattern is typed
            // against its own element type, not the whole tuple. Without this an
            // Option/Result element binder is typed as the enclosing tuple and a
            // nested match on it fails typecheck.
            let mut tup_start = -1
            let mut tup_count = 0
            if saved_binding >= 0 && type_kind(saved_binding) == TyKind.Tuple {
                let te = ty_pool.get(saved_binding).unwrap()
                tup_start = te.params_start
                tup_count = te.params_count
            }
            let mut i = 0
            while i < sublist_length(elems_sl) {
                if tup_start >= 0 && i < tup_count {
                    tc_pattern_binding_type = ty_param_list.get(tup_start + i).unwrap()
                } else {
                    tc_pattern_binding_type = -1
                }
                tc_check_pattern_types(sublist_get(elems_sl, i))
                i = i + 1
            }
        }
        tc_pattern_binding_type = saved_binding
        return
    }
    if kind == NodeKind.ListPattern {
        let saved_binding = tc_pattern_binding_type
        // Each fixed-position element binder is typed against the list's
        // element type, not the whole list. Without this a `[cmd]` binder is
        // typed as List[T] and any consumer that reads the binding's type
        // (e.g. the Display interpolation gate) sees the wrong type.
        let mut elem_t = -1
        if saved_binding >= 0 && type_kind(saved_binding) == TyKind.List {
            elem_t = ty_pool.get(saved_binding).unwrap().inner1
        }
        let elems_sl = node_elements(node)
        if elems_sl != -1 {
            let mut i = 0
            while i < sublist_length(elems_sl) {
                tc_pattern_binding_type = elem_t
                tc_check_pattern_types(sublist_get(elems_sl, i))
                i = i + 1
            }
        }
        tc_pattern_binding_type = saved_binding
        return
    }
    if kind == NodeKind.OrPattern {
        tc_check_pattern_types(node_left(node))
        tc_check_pattern_types(node_right(node))
        return
    }
    if kind == NodeKind.AsPattern {
        tc_check_pattern_types(node_pattern(node))
        nr_define(node_name(node))
        return
    }
    let _skip = 0
}

// ── Test-block elaboration (spec §2.20 ?-in-test-body) ──────────────
//
// A test body using `?` is implicitly elaborated to return
// Result[Void, TestError]. The body itself has no surface return-type;
// any `->` annotation is rejected (E0515). When `?` appears anywhere in
// the body, tc_current_fn_ret is set to a synthetic Result[Void, TestError]
// for the duration of the body walk so the QM gate at infer_type accepts
// it. Otherwise the body remains void.

fn tc_node_contains_question_op(node: Int) -> Int {
    if node == -1 { return 0 }
    let kind = node_kind(node)
    if kind == NodeKind.UnaryOp {
        if node_op(node) == "?" { return 1 }
        return tc_node_contains_question_op(node_left(node))
    }
    if kind == NodeKind.BinOp {
        if tc_node_contains_question_op(node_left(node)) != 0 { return 1 }
        return tc_node_contains_question_op(node_right(node))
    }
    if kind == NodeKind.LetBinding {
        if tc_node_contains_question_op(node_value(node)) != 0 { return 1 }
        return tc_node_contains_question_op(node_target(node))
    }
    if kind == NodeKind.ExprStmt {
        return tc_node_contains_question_op(node_value(node))
    }
    if kind == NodeKind.Return {
        return tc_node_contains_question_op(node_value(node))
    }
    if kind == NodeKind.Block {
        let stmts_sl = node_stmts(node)
        if stmts_sl == -1 { return 0 }
        let mut i = 0
        while i < sublist_length(stmts_sl) {
            if tc_node_contains_question_op(sublist_get(stmts_sl, i)) != 0 { return 1 }
            i = i + 1
        }
        return 0
    }
    if kind == NodeKind.IfExpr {
        if tc_node_contains_question_op(node_condition(node)) != 0 { return 1 }
        if tc_node_contains_question_op(node_then_body(node)) != 0 { return 1 }
        return tc_node_contains_question_op(node_else_body(node))
    }
    if kind == NodeKind.WhileLoop {
        if tc_node_contains_question_op(node_condition(node)) != 0 { return 1 }
        return tc_node_contains_question_op(node_body(node))
    }
    if kind == NodeKind.ForIn {
        if tc_node_contains_question_op(node_iterable(node)) != 0 { return 1 }
        return tc_node_contains_question_op(node_body(node))
    }
    if kind == NodeKind.LoopExpr {
        return tc_node_contains_question_op(node_body(node))
    }
    if kind == NodeKind.WithBlock {
        return tc_node_contains_question_op(node_body(node))
    }
    if kind == NodeKind.Call {
        let args_sl = node_args(node)
        if args_sl != -1 {
            let mut i = 0
            while i < sublist_length(args_sl) {
                if tc_node_contains_question_op(sublist_get(args_sl, i)) != 0 { return 1 }
                i = i + 1
            }
        }
        return 0
    }
    if kind == NodeKind.MethodCall {
        if tc_node_contains_question_op(node_obj(node)) != 0 { return 1 }
        let args_sl = node_args(node)
        if args_sl != -1 {
            let mut i = 0
            while i < sublist_length(args_sl) {
                if tc_node_contains_question_op(sublist_get(args_sl, i)) != 0 { return 1 }
                i = i + 1
            }
        }
        return 0
    }
    if kind == NodeKind.MatchExpr {
        if tc_node_contains_question_op(node_scrutinee(node)) != 0 { return 1 }
        let arms_sl = node_arms(node)
        if arms_sl != -1 {
            let mut i = 0
            while i < sublist_length(arms_sl) {
                if tc_node_contains_question_op(node_body(sublist_get(arms_sl, i))) != 0 { return 1 }
                i = i + 1
            }
        }
        return 0
    }
    if kind == NodeKind.ListLit {
        let elems_sl = node_elements(node)
        if elems_sl == -1 { return 0 }
        let mut i = 0
        while i < sublist_length(elems_sl) {
            if tc_node_contains_question_op(sublist_get(elems_sl, i)) != 0 { return 1 }
            i = i + 1
        }
        return 0
    }
    if kind == NodeKind.TupleLit {
        let elems_sl = node_elements(node)
        if elems_sl == -1 { return 0 }
        let mut i = 0
        while i < sublist_length(elems_sl) {
            if tc_node_contains_question_op(sublist_get(elems_sl, i)) != 0 { return 1 }
            i = i + 1
        }
        return 0
    }
    if kind == NodeKind.StructLit {
        let flds_sl = node_fields(node)
        if flds_sl == -1 { return 0 }
        let mut i = 0
        while i < sublist_length(flds_sl) {
            if tc_node_contains_question_op(node_value(sublist_get(flds_sl, i))) != 0 { return 1 }
            i = i + 1
        }
        return 0
    }
    if kind == NodeKind.IndexExpr {
        if tc_node_contains_question_op(node_obj(node)) != 0 { return 1 }
        return tc_node_contains_question_op(node_index(node))
    }
    if kind == NodeKind.FieldAccess {
        return tc_node_contains_question_op(node_obj(node))
    }
    if kind == NodeKind.InterpString {
        let parts_sl = node_elements(node)
        if parts_sl == -1 { return 0 }
        let mut i = 0
        while i < sublist_length(parts_sl) {
            if tc_node_contains_question_op(sublist_get(parts_sl, i)) != 0 { return 1 }
            i = i + 1
        }
        return 0
    }
    0
}

// Two DIFFERENT questions used to share tc_in_test_body, and they want opposite answers inside
// a closure (br pgc3d9):
//
//   tc_in_test_body     "does `?` here elaborate against the test block's implicit
//                        Result[Void, TestError]?"  Inside a closure the answer is NO — a
//                        closure body gates `?` against its OWN declared return (spec §3c.2),
//                        so the closure walkers reset this to 0.
//
//   tc_in_test_lexical  "is this code lexically inside a `test { ... }` block?"  Inside a
//                        closure the answer is YES, and the test-only symbol fences (E0827
//                        skip, E0833 assert_panics) are the readers that mean this one. The
//                        closure walkers must NOT reset it.
//
// Both fence sites were reading the elaboration flag, so a `skip()` in a closure lexically
// inside a test was rejected the moment anything walked that closure body — reachable via the
// List-HOF path (`l.for_each(fn(x) { skip(...) })`) long before pgc3d9 widened the walk to
// `testing.for_each`. Two places already documented the intended behavior against the code:
// tc_fence_test_only_symbol's comment ("and inside closures lexically within it —
// testing.for_each's case body relies on this") and the header of
// tests/test_e0833_assert_panics_outside_test.bl ("it IS allowed inside a closure that is
// lexically within a test body ... because tc_in_test_body stays set through such closures").
// It did not stay set; splitting the flag is what makes both statements true.
let mut tc_in_test_body: Int = 0
let mut tc_in_test_lexical: Int = 0
let mut tc_in_assert_panics: Int = 0

pub fn sanitize_test_name(name: Str) -> Str {
    let mut out = ""
    let mut i = 0
    while i < name.len() {
        let ch = name.byte_at(i)
        if ch == 32 || ch == 95 {
            out = out.concat("_")
        } else if (ch >= 48 && ch <= 57) || (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) {
            out = out.concat(name.substring(i, 1))
        }
        i = i + 1
    }
    out
}

@allow(UnrestoredMutation, IncompleteStateRestore)
fn tc_check_test_block(tb: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    // Reject surface annotation (E0515). Today the parser already rejects
    // '->' after a test header, but we re-check here so any future parser
    // recovery path still produces the typed error.
    let tann = node_type_ann(tb)
    if tann != -1 {
        diag_error_at("AnnotatedTestReturnTypeRejected", TEST_ANNOTATED_RETURN,
            "test blocks do not declare a return type",
            tb, "remove the '-> ...' annotation")
    }

    // test.failing(...) requires non-empty reason:/ticket: (E0835). int_val
    // is set to 1 by parse_test_failing_block as the "this is xfail" marker
    // (unused by plain `test { ... }`), so an all-empty malformed
    // registration is still caught here instead of behaving like a plain test.
    if node_int_val(tb) != 0 {
        if node_xfail_reason(tb) == "" || node_xfail_ticket(tb) == "" {
            diag_error_at("XfailMissingReason", XFAIL_MISSING_REASON,
                "test.failing requires both 'reason:' and 'ticket:' to be non-empty",
                tb, "supply a non-empty reason: and ticket: string")
        }
    }

    let tbody = node_body(tb)
    if tbody == -1 { return }

    let test_name = node_str_val(tb)
    let sanitized = sanitize_test_name(test_name)
    let prev_fn_name = tc_current_fn_name
    let prev_fn_ret = tc_current_fn_ret
    let prev_in_test = tc_in_test_body
    let prev_in_test_lex = tc_in_test_lexical
    tc_current_fn_name = "__test_{sanitized}"
    tc_in_test_body = 1
    tc_in_test_lexical = 1

    if tc_node_contains_question_op(tbody) != 0 {
        // Elaborate to Result[Void, TestError]. TestError must be visible
        // (lib/std/testing.bl is loaded transitively for any test build).
        let test_error_tid = resolve_type_name("TestError")
        let err_tid = if test_error_tid != -1 { test_error_tid } else { TYPE_UNKNOWN }
        tc_current_fn_ret = make_result_type(TYPE_VOID, err_tid)
    } else {
        tc_current_fn_ret = TYPE_VOID
    }

    let prev_boundary = tc_boundary_check_active
    tc_boundary_check_active = 1
    nr_push_scope()
    tc_check_body(tbody)
    nr_pop_scope()
    tc_boundary_check_active = prev_boundary

    tc_current_fn_name = prev_fn_name
    tc_current_fn_ret = prev_fn_ret
    tc_in_test_body = prev_in_test
    tc_in_test_lexical = prev_in_test_lex
}


// ── Phase 2: Top-level driver ───────────────────────────────────────

fn tc_infer_program(program: Int) ! TypeCheck.Resolve, TypeCheck.Report, Diag.Report {
    nr_scope_names = []
    nr_scope_muts = []
    nr_scope_types = []
    nr_scope_reads = []
    nr_scope_writes = []
    nr_scope_nodes = []
    nr_scope_captured = []
    nr_scope_prev = []
    nr_name_top.clear()
    nr_scope_frames = []
    nr_scope_depth = 0
    nr_loop_depth = 0
    nr_push_scope()

    // Register top-level let bindings WITH their declared types so fn bodies that
    // reference a module-global see its real type (ticket y0709p). Annotated type is
    // resolved directly (never forward-references other globals, so order-independent).
    // For unannotated globals we infer ONLY a scalar-literal RHS (also order-safe);
    // a non-literal RHS could forward-reference and stays UNKNOWN (same as before).
    // We deliberately do NOT run assignment_types_compatible here (RHS is validated
    // elsewhere; adding validation at this site risks the self-hosting bootstrap).
    let lets_sl = node_stmts(program)
    if lets_sl != -1 {
        let mut i = 0
        while i < sublist_length(lets_sl) {
            let l = sublist_get(lets_sl, i)
            let l_ann = node_target(l)
            let l_type_str = node_type_name(l)
            let mut l_tid = TYPE_UNKNOWN
            if l_ann != -1 {
                l_tid = resolve_type_ann(l_ann)
            } else if l_type_str != "" {
                let rt = resolve_type_name(l_type_str)
                if rt != -1 { l_tid = rt }
            } else {
                let l_val = node_value(l)
                if l_val != -1 {
                    let vk = node_kind(l_val)
                    if vk == NodeKind.IntLit || vk == NodeKind.FloatLit || vk == NodeKind.BoolLit || vk == NodeKind.InterpString {
                        l_tid = infer_type(l_val)
                    }
                }
            }
            nr_define_typed(node_name(l), node_is_mut(l), l_tid)
            // br cttrag: the same tid, keyed by module, for the qualified form.
            // Registered here and not in a pass of its own so the two spellings
            // of one binding cannot drift — a `let` reachable as `m.x` gets its
            // type from the same resolve_type_ann call as the bare `x`.
            let l_mod_key = node_module(l)
            if l_mod_key != "" && l_tid != TYPE_UNKNOWN {
                tc_module_let_tid.insert("{l_mod_key}.{node_name(l)}", l_tid)
            }
            i = i + 1
        }
    }

    // Register function names
    let fns_sl = node_params(program)
    if fns_sl != -1 {
        let mut i = 0
        while i < sublist_length(fns_sl) {
            nr_define(node_name(sublist_get(fns_sl, i)))
            i = i + 1
        }
    }

    // Type check each function body (skip unaffected when incremental filter active)
    if fns_sl != -1 {
        let mut i = 0
        while i < sublist_length(fns_sl) {
            let fn_node = sublist_get(fns_sl, i)
            nr_current_module = node_module(fn_node)
            if tc_should_check_fn(node_name(fn_node)) != 0 {
                tc_check_fn(fn_node)
            }
            i = i + 1
        }
    }

    // Type check impl methods (skip unaffected when incremental filter active)
    let impls_sl = node_methods(program)
    if impls_sl != -1 {
        let mut i = 0
        while i < sublist_length(impls_sl) {
            let im = sublist_get(impls_sl, i)
            nr_current_module = node_module(im)
            let impl_type = node_name(im)
            // What `self` is inside these bodies (br jzvxav). Resolved once per impl block, not
            // per method: the receiver is a property of the header, and resolve_type_parts interns
            // through the pool so a repeat would only churn it.
            tc_current_self_tid = tc_impl_self_tid(im)
            let methods_sl = node_methods(im)
            if methods_sl != -1 {
                let mut j = 0
                while j < sublist_length(methods_sl) {
                    let m = sublist_get(methods_sl, j)
                    let orig_name = node_name(m)
                    let qualified = "{impl_type}_{orig_name}"
                    if tc_should_check_fn(qualified) != 0 {
                        // Same spelling the registration loop (:5183) wrote, so tc_check_fn can
                        // find the signature and install the declared return (br zd1tz3).
                        tc_current_method_sig_key = tc_mangle_impl_fnsig(impl_type, node_trait_name(im), orig_name, im)
                        node_set_name(m, qualified)
                        tc_check_fn(m)
                        node_set_name(m, orig_name)
                        tc_current_method_sig_key = ""
                    }
                    j = j + 1
                }
            }
            tc_current_self_tid = -1
            i = i + 1
        }
    }

    // Type check test block bodies under elaborated return type
    let tests_sl = node_captures(program)
    if tests_sl != -1 {
        nr_current_module = "__main__"
        let mut i = 0
        while i < sublist_length(tests_sl) {
            tc_check_test_block(sublist_get(tests_sl, i))
            i = i + 1
        }
    }

    nr_pop_scope()
}

// ── Debug / introspection ───────────────────────────────────────────

// The one export of type_to_str. Codegen's own lens (type_name_from_ct) is a total
// function over the CTs it enumerates and answers "Void" for everything else, so a
// diagnostic spelled from it makes a confident wrong claim about any type codegen cannot
// name — Void being a real surface type, not a visible unknown (br 3dpshm). Consumers
// must treat the "<?>" render as "no usable tid here" and keep their own fallback; it is
// not a type name.
pub fn tc_type_str(tid: Int) -> Str {
    type_to_str(tid)
}

fn type_to_str(tid0: Int) -> Str {
    // A bound metavar renders as its solution (gqg3rk); an unbound α still
    // renders as the internal "?" placeholder (never a surface type name).
    let tid = tc_resolve(tid0)
    if tid < 0 || tid >= ty_pool.len() {
        return "<?>"
    }
    let t = ty_pool.get(tid).unwrap()
    let k = t.kind
    let name = t.name

    // Dispatch is a match, not an if-chain, so the surface rendering of a kind can
    // never be decided by fall-through. The five arms that answer `name` do so
    // deliberately; four of them (Closure/Iterator/Handle/Channel) are also
    // UNCONSTRUCTIBLE — new_type is never called with them (br vag3wc) — so they
    // are named here to record that, not because the rendering was chosen.
    match k {
        TyKind.Int => return "Int"
        TyKind.Float => return "Float"
        TyKind.Bool => return "Bool"
        TyKind.Str => return "Str"
        TyKind.Void => return "Void"
        TyKind.Char => return name
        TyKind.I8 => return "I8"
        TyKind.I16 => return "I16"
        TyKind.I32 => return "I32"
        TyKind.U8 => return "U8"
        TyKind.U16 => return "U16"
        TyKind.U32 => return "U32"
        TyKind.U64 => return "U64"
        TyKind.Bytes => return "Bytes"
        TyKind.StringBuilder => return "StringBuilder"
        TyKind.Unknown => return "?"
        TyKind.Typevar => return name
        TyKind.Enum => return name
        // Channel/Handle are constructed since br vag3wc, so they render their inner rather
        // than the bare name. The bare name is what made NotIterable read "cannot iterate over
        // type 'Channel' -- only ... Channel ... implement iteration": one line contradicting
        // itself. TyKind.Iterator stays UNCONSTRUCTED and keeps the bare-name rendering — see
        // the note on tc_tid_child_count below (br qzdz2e).
        TyKind.Iterator => return name
        TyKind.Handle => return "Handle[{type_to_str(t.inner1)}]"
        TyKind.Channel => return "Channel[{type_to_str(t.inner1)}]"
        TyKind.Ptr => return "Ptr[{type_to_str(t.inner1)}]"
        TyKind.Template => return "Template[{type_to_str(t.inner1)}]"
        // The surface spelling of the type is the expression that makes one: §07:272 has no
        // type name for it, and `ffi.scope()` is the only way to obtain one.
        TyKind.FfiScope => return "ffi.scope()"
        TyKind.List => return "List[{type_to_str(t.inner1)}]"
        TyKind.Option => return "Option[{type_to_str(t.inner1)}]"
        TyKind.Result => return "Result[{type_to_str(t.inner1)}, {type_to_str(t.inner2)}]"
        TyKind.Map => return "Map[{type_to_str(t.inner1)}, {type_to_str(t.inner2)}]"
        TyKind.Set => return "Set[{type_to_str(t.inner1)}]"
        TyKind.Struct => {}
        TyKind.Fn => {}
        TyKind.Tuple => {}
    }

    if k == TyKind.Struct {
        // Monomorphized struct instance (Box[Int]): render its concrete type-args so
        // diagnostics read "expects Box[Int], got Box[Str]" instead of an ambiguous
        // bare "Box" on both sides (br qw7v90). A bare generic struct (params_count
        // 0) renders as the plain name.
        if t.params_count > 0 {
            let start = t.params_start
            let count = t.params_count
            let mut targs = ""
            let mut i = 0
            while i < count {
                if i > 0 {
                    targs = targs.concat(", ")
                }
                targs = targs.concat(type_to_str(ty_param_list.get(start + i).unwrap()))
                i = i + 1
            }
            return "{strip_module_qualifier(name)}[{targs}]"
        }
        return name
    }
    if k == TyKind.Fn {
        let start = t.params_start
        let count = t.params_count
        let mut params = ""
        let mut i = 0
        while i < count {
            if i > 0 {
                params = params.concat(", ")
            }
            params = params.concat(type_to_str(ty_param_list.get(start + i).unwrap()))
            i = i + 1
        }
        return "Fn({params}) -> {type_to_str(t.inner1)}"
    }
    if k == TyKind.Tuple {
        let start = t.params_start
        let count = t.params_count
        let mut elems = ""
        let mut i = 0
        while i < count {
            if i > 0 {
                elems = elems.concat(", ")
            }
            elems = elems.concat(type_to_str(ty_param_list.get(start + i).unwrap()))
            i = i + 1
        }
        return "({elems})"
    }

    name
}

// Tag position: TOP is tc_tid_to_c_tag's own call (Pascal scalars, module-qualifier
// stripped, List/Set/Map/Bytes erased to their bare carrier). INNER is every recursion
// into a compound's element (Option_<inner>, Result_<ok>_<err>, Map_<k>_<v>,
// Tuple<n>_<...>): lowercase scalars, module prefix KEPT via c_type_tag_for_struct, Map
// spelled structurally. This asymmetry is a property of the emitted C names, not
// accidental duplication (br bwyfy1: collapsing it to one RULE broke 296 fixtures and
// was reverted) — so it is a position PARAMETER on one encoder, never a shared rule.
let TAGPOS_TOP = 0
let TAGPOS_INNER = 1

// One encoder for both tid-to-C-tag positions (br qerbc7). tc_tid_to_c_tag and
// tc_tid_inner_tag are thin `tagpos`-fixed wrappers below, so no call site moves and every
// existing byte-for-byte contract (scalar casing, struct/enum module-qualifier handling,
// compound erasure vs structural spelling, the three ICE_SEG_* sentinels) is preserved
// exactly, not re-derived.
fn tc_tid_tag_at(tid0: Int, tagpos: Int) -> Str {
    let tid = tc_resolve(tid0)
    if tid < 0 || tid >= ty_pool.len() {
        if tagpos == TAGPOS_TOP {
            dbg_trace("ctagvoid", "producer=out_of_range tid0={tid0} tid={tid} pool_len={ty_pool.len()}")
        } else {
            if dbg_channel_on("voidtwin") != 0 { dbg_trace("voidtwin", "producer=inner_out_of_range tid0={tid0} tid={tid} pool_len={ty_pool.len()}") }
        }
        return ICE_SEG_TID_OUT_OF_RANGE
    }
    let t = ty_pool.get(tid).unwrap()
    let k = t.kind
    if k == TyKind.Struct || k == TyKind.Enum {
        let stem = tc_tid_struct_mono_name(tid)
        if stem != "" { return stem }
        // Twin alias hop for both positions (bwyfy1: the two spellers must agree on
        // every bare struct/enum, aliases included, or Option[MyInt]/List[MyInt]/
        // Map[K,MyInt]/Result[MyInt,_] keep leaking the alias spelling even after the
        // top-level slot is fixed).
        let underlying = tc_resolve_transparent_alias_name(t.name)
        if underlying != -1 { return tc_tid_tag_at(underlying, tagpos) }
        if tagpos == TAGPOS_TOP { return strip_module_qualifier(t.name) }
        return c_type_tag_for_struct(t.name)
    }
    // Collapse, never interpolate (br vbcw1e Stage 2): a recursive call can itself answer
    // a bare ICE_SEG_* sentinel (out-of-range / unsolved metavar / unhandled kind).
    // Interpolating that into "Option_{inner}" would bury it where diag_is_ice_seg's
    // prefix test can no longer see it — the exact hazard qerbc7 exists to close. Inner
    // recursion is always TAGPOS_INNER regardless of this call's own position (both
    // original callers already did this; it is why sharing tc_tid_tuple_tag is safe).
    if k == TyKind.Option {
        let inner = tc_tid_tag_at(t.inner1, TAGPOS_INNER)
        if diag_is_ice_seg(inner) { return inner }
        return "Option_{inner}"
    }
    if k == TyKind.Result {
        let ok = tc_tid_tag_at(t.inner1, TAGPOS_INNER)
        if diag_is_ice_seg(ok) { return ok }
        let err = tc_tid_tag_at(t.inner2, TAGPOS_INNER)
        if diag_is_ice_seg(err) { return err }
        return "Result_{ok}_{err}"
    }
    if k == TyKind.Tuple { return tc_tid_tuple_tag(t) }
    if k == TyKind.Typevar {
        if tagpos == TAGPOS_INNER {
            // Gated explicitly: an unresolved generic type param is a common inner in
            // generic-heavy code, so this must not build the message when the channel is off.
            if dbg_channel_on("voidtwin") != 0 { dbg_trace("voidtwin", "producer=inner_typevar tid={tid}") }
        }
        return "<tv>"
    }
    // TOP erases Map to its bare Pascal carrier ("Map"); INNER spells it structurally,
    // lowercase, byte-matching the string path's own Map_<key>_<val> segment.
    if k == TyKind.Map {
        if tagpos == TAGPOS_TOP { return "Map" }
        let key = tc_tid_tag_at(t.inner1, TAGPOS_INNER)
        if diag_is_ice_seg(key) { return key }
        let val = tc_tid_tag_at(t.inner2, TAGPOS_INNER)
        if diag_is_ice_seg(val) { return val }
        return "Map_{key}_{val}"
    }
    if tagpos == TAGPOS_TOP {
        if k == TyKind.Int { return "Int" }
        if k == TyKind.Float { return "Float" }
        if k == TyKind.Bool { return "Bool" }
        if k == TyKind.Str { return "Str" }
        if k == TyKind.List { return "List" }
        if k == TyKind.Iterator { return "Iterator" }
        if k == TyKind.Handle { return "Handle" }
        if k == TyKind.Channel { return "Channel" }
        // Mirrors codegen's two CT_PTR spellings — Pascal at the carrier position
        // (type_name_from_ct, codegen_types.bl:4518) and lowercase inside a segment
        // (c_type_tag, :6095). Both DROP the pointee, which is what makes Ptr non-injective as
        // a segment below.
        if k == TyKind.Ptr { return "Ptr" }
        if k == TyKind.Set { return "Set" }
        if k == TyKind.Bytes { return "Bytes" }
        // Mirrors codegen's own two spellings for CT_STRINGBUILDER — Pascal at the
        // carrier position (type_name_from_ct, codegen_types.bl:4517) and lowercase
        // inside a segment (c_type_tag, :6094). Spelled on both sides so the tid path
        // byte-matches the string path for a StringBuilder type arg (br 7cq6w2).
        if k == TyKind.StringBuilder { return "StringBuilder" }
        if k == TyKind.I8 { return "I8" }
        if k == TyKind.I16 { return "I16" }
        if k == TyKind.I32 { return "I32" }
        if k == TyKind.U8 { return "U8" }
        if k == TyKind.U16 { return "U16" }
        if k == TyKind.U32 { return "U32" }
        if k == TyKind.U64 { return "U64" }
        if k == TyKind.Char { return "Char" }
        // I0001 (gqg3rk): an unbound metavar (TyKind.Unknown) reaching C-tag emission means
        // an under-determined binding escaped the E0301 boundary check — a compiler
        // invariant violation. Fail CLOSED with an invalid-C-identifier sentinel so the C
        // compiler errors loudly, NEVER silently fall through to "Void" (the pre-decision
        // erased-default miscompile). Keys on KIND, per DECISIONS.md:342.
        if k == TyKind.Unknown { return ICE_SEG_UNSOLVED_TYPEVAR }
        // A GENUINE Void, answered deliberately rather than by fall-through. Void is "an
        // ordinary INHABITED, encodable type" (decisions/under-determined-types.md:38-42,
        // 6-0) and is genuinely distinct from an unsolved metavariable α (:51-54 —
        // substituting one for the other "is licensed by no typing rule"). The I0001
        // tripwire keys on the KIND "so a genuine GKV[Void, Void] is unaffected"
        // (:263-266, DECISIONS.md:342), which is only true if this arm exists: without
        // it, Void shares its spelling with the two failure buckets below and every
        // consumer that rejects one rejects all three. Byte-identical to the string
        // path, which also spells a Void type arg "Void".
        if k == TyKind.Void {
            dbg_trace("ctagvoid", "producer=genuine_void tid={tid} name={t.name}")
            return "Void"
        }
        // A kind with no arm above (TyKind.Fn, any kind added later). Fails
        // CLOSED rather than sharing the genuine Void's spelling directly above: this is
        // not a type name, it is "this encoder does not know how to spell this kind", and
        // letting it read as "Void" is what made the two indistinguishable. The floor is
        // measured at 0 across the corpus and both compiler entry points (ctagvoid,
        // CLAUDE.md), so arming it cannot regress a working program — it can only make a
        // future kind loud instead of silent.
        dbg_trace("ctagvoid", "producer=unhandled_kind tid={tid} k={tk_name(k)} name={t.name}")
        return ICE_SEG_UNHANDLED_KIND
    }
    // INNER: lowercase scalars, mirroring codegen_types.c_type_tag.
    if k == TyKind.Int { return "int" }
    if k == TyKind.Float { return "double" }
    if k == TyKind.Bool { return "bool" }
    if k == TyKind.Str { return "str" }
    if k == TyKind.List { return "list" }
    if k == TyKind.Iterator { return "iter" }
    if k == TyKind.Handle { return "handle" }
    if k == TyKind.Channel { return "channel" }
    if k == TyKind.Ptr { return "ptr" }
    if k == TyKind.Set { return "set" }
    if k == TyKind.Bytes { return "bytes" }
    if k == TyKind.StringBuilder { return "stringbuilder" }
    if k == TyKind.Option { return "option" }
    if k == TyKind.Result { return "result" }
    if k == TyKind.I8 { return "i8" }
    if k == TyKind.I16 { return "i16" }
    if k == TyKind.I32 { return "i32" }
    if k == TyKind.U8 { return "u8" }
    if k == TyKind.U16 { return "u16" }
    if k == TyKind.U32 { return "u32" }
    if k == TyKind.U64 { return "u64" }
    if k == TyKind.Char { return "char" }
    // A GENUINE Void, answered deliberately (the twin of the TOP arm's TyKind.Void case).
    //
    // THIS ARM IS LOAD-BEARING AND MUST NOT BE DELETED (br hsgsbp / br vbcw1e).
    //
    // tc_tid_tag_at's TOP-position TyKind.Result arm spells Result[Void, Str] as
    // "Result_{tc_tid_tag_at(inner1, INNER)}_{...}", and the INNER recursion on a Void
    // inner reaches THIS arm before it ever reaches the fall-through below — so
    // Result_void_str's "void" comes from here, full stop. src/codegen_types.bl's
    // result-typedef emitter MATCHES that literal tag (`if ok_tag == "void" || ok_tag ==
    // "Void"`) to lower the Void leaf to an int64_t placeholder field; deleting this arm
    // (or changing what it returns) would miss that match and emit an undeclared type.
    // Result[Void, E] is not a corner case: lib/std/ depends on it (bytes.bl,
    // db_sqlite.bl, traits.bl) and the compiler synthesizes it for EVERY `?`-bearing
    // `test` block. The fall-through below is a SEPARATE bucket (kinds with no arm at
    // all — TyKind.Fn) that a genuine Void never reaches, and arming IT (br
    // vbcw1e Stage 2) does not touch this one.
    //
    // VERIFIED, not just traced: the 728-file corpus sweep for this arm's `voidtwin` tap
    // reads 0 — that is a coverage gap, not a safety fact (feedback_corpus_sweep_is_not_
    // coverage: no corpus file happens to instantiate a generic fn/struct over a
    // Result[Void,_]/Option[Void] argument, which is what actually drives a call here).
    // Constructing that shape by hand (a generic `identity[T]` called with a
    // `Result[Void, Str]` argument) reaches this exact arm via the real, ungated caller
    // chain — tid_instance_mono_args_csv / tc_seg_from_tid → tc_tid_to_c_tag →
    // tc_tid_tag_at(_, INNER) → here — firing 12 times in one tiny file. That MVCE is the
    // actual load-bearing witness for this arm, not the corpus.
    if k == TyKind.Void {
        // Gated explicitly (not just relying on dbg_trace's own internal gate): this arm is
        // a hot path — Result[Void, E] is synthesized for every `?`-bearing test block —
        // so the message must not be built when the channel is off.
        if dbg_channel_on("voidtwin") != 0 { dbg_trace("voidtwin", "producer=scalar_genuine_void tid={tid}") }
        return "void"
    }
    // An unbound metavariable: this is the erased-default bucket DECISIONS.md:342 forbids —
    // an unsolved α reaching codegen must ICE, never silently spell "void" (which the same
    // kind DOES answer correctly at TOP position, gqg3rk). Stage 1 measured this bucket's
    // floor at 0 over the full corpus; it is reachable in principle only if some future
    // caller stops routing an unbound metavar away via tc_tid_encodable/
    // tc_tid_tuple_elem_faithful (the gates qerbc7 retires) and lets it ride the tid path
    // instead — exactly the failure this arm now forecloses at the source.
    if k == TyKind.Unknown {
        if dbg_channel_on("voidtwin") != 0 { dbg_trace("voidtwin", "producer=scalar_unsolved_typevar tid={tid}") }
        return ICE_SEG_UNSOLVED_TYPEVAR
    }
    // Every kind with a real arm above is exhausted, and TyKind.Void/TyKind.Unknown are both
    // intercepted above too, so this is reached only by a kind this speller never learned
    // (TyKind.Fn). Stage 1 measured this bucket's floor at 0 over the full corpus.
    // Safe to arm because, per the TyKind.Void arm's comment above, a genuine Void can never
    // reach this line — only a kind this speller genuinely never learned does.
    if dbg_channel_on("voidtwin") != 0 { dbg_trace("voidtwin", "producer=scalar_unhandled_kind tid={tid} k={tk_name(k)}") }
    ICE_SEG_UNHANDLED_KIND
}

// Codegen tag for the INNER of a compound carrier. Struct/enum → stripped name (module
// prefix KEPT), nested compound → recurse, else lowercase scalar tag. Mirrors
// codegen_types.resolve_ann_tag's inner behavior but reads the tid structurally instead
// of guessing from a flattened string. Thin wrapper over tc_tid_tag_at (br qerbc7) — no
// caller moves, no behavior changes.
pub fn tc_tid_inner_tag(tid: Int) -> Str {
    tc_tid_tag_at(tid, TAGPOS_INNER)
}

fn tc_tid_tuple_tag(t: TypePoolEntry) -> Str {
    let start = t.params_start
    let count = t.params_count
    let mut tag = "Tuple{count}"
    let mut i = 0
    while i < count {
        // Collapse, never interpolate (br vbcw1e Stage 2) — same rule as the OPTION/RESULT/
        // MAP arms above: an ICE_SEG_* element must replace the whole tag, not get
        // concatenated into it. Elements are always TAGPOS_INNER regardless of the
        // tuple's own position (both callers already did this before qerbc7).
        let elem = tc_tid_tag_at(ty_param_list.get(start + i).unwrap(), TAGPOS_INNER)
        if diag_is_ice_seg(elem) { return elem }
        tag = tag.concat("_").concat(elem)
        i = i + 1
    }
    tag
}

// Prints the qerbc7 counterfactual for a single gate rejection (br vbcw1e): what the now-
// armed tc_tid_inner_tag answers for `tid` when a caller's gate (tc_tid_encodable /
// tc_tid_inner_tag_faithful) has just declined to route it onto the tid path. Since Stage 2,
// tc_tid_inner_tag IS the ICE-or-genuine answer — no separate shadow predicate to keep in
// lockstep — so this only needs to call it and check diag_is_ice_seg on the result. Gated on
// the channel first so a cold run skips the extra structural walk on every rejection — every
// caller site is on a generic call's hot path pre-monomorphization.
//
// Callers narrow `tid` to a scalar/typevar/unknown leaf before its own gate check, with one
// exception: tc_tid_inner_tag_faithful's params_count!=0 branch also reaches a non-STRUCT/ENUM
// compound tid here (e.g. a TyKind.Tuple with arity>0, via its "faithful_reject_paramcount" call) —
// harmless, since tc_tid_tag_at's TyKind.Tuple arm spells it structurally rather than falling
// through to its TAGPOS_INNER scalar fallback, so diag_is_ice_seg never fires for a genuine compound. A
// struct/enum tid can also legitimately answer a non-ICE erased name here (the STRUCT/ENUM arm's
// own give-up path, a separate undischarged concern, not this probe's job to flag).
fn voidtwin_probe(gate: Str, tid: Int) {
    if dbg_channel_on("voidtwin") == 0 { return }
    let spelled = tc_tid_inner_tag(tid)
    if !diag_is_ice_seg(spelled) { return }
    dbg_trace("voidtwin", "probe=gate_reject gate={gate} tid={tid} k={tk_name(type_kind(tid))} would_ice={spelled}")
}

// TK_* → CT_* translation. The two numberings are NOT the same (e.g. TyKind.Map=18
// vs CT_MAP=13, TyKind.Struct=9 vs CT_STRUCT=23), so a cast would silently corrupt.
// Explicit switch; unknown kinds map to CT_VOID.
// Q2's translation layer between the two type universes, and slated for deletion
// once codegen reads the tid directly. Exhaustive by construction: six kinds have
// no CT at all and collapse onto CT_VOID, which is a LOSSY answer, not a correct
// one — CT_VOID here means "codegen's flat universe cannot say this", and callers
// that must not force a value to void re-read it as -1 (see tid_inner_ct below).
// Naming those six keeps the collapse legible instead of implicit in a
// fall-through, and makes a newly added kind a compile error here.
fn tk_to_ct(kind: TyKind) -> Int {
    match kind {
        TyKind.Int => CT_INT
        TyKind.Float => CT_FLOAT
        TyKind.Bool => CT_BOOL
        TyKind.Str => CT_STRING
        TyKind.List => CT_LIST
        TyKind.Option => CT_OPTION
        TyKind.Result => CT_RESULT
        TyKind.Struct => CT_STRUCT
        TyKind.Enum => CT_ENUM
        TyKind.Iterator => CT_ITERATOR
        TyKind.Handle => CT_HANDLE
        TyKind.Channel => CT_CHANNEL
        TyKind.Ptr => CT_PTR
        TyKind.Map => CT_MAP
        TyKind.Bytes => CT_BYTES
        TyKind.Set => CT_SET
        TyKind.StringBuilder => CT_STRINGBUILDER
        // Codegen has always known this one: `"Template" => CT_TEMPLATE` (codegen_types.bl:5709)
        // maps the annotation NAME to it, and the 7 emitters key on it. Only the tid side was
        // missing, so this arm makes the two universes agree rather than adding knowledge.
        TyKind.Template => CT_TEMPLATE
        TyKind.FfiScope => CT_FFI_SCOPE
        TyKind.I8 => CT_I8
        TyKind.I16 => CT_I16
        TyKind.I32 => CT_I32
        TyKind.U8 => CT_U8
        TyKind.U16 => CT_U16
        TyKind.U32 => CT_U32
        TyKind.U64 => CT_U64
        TyKind.Char => CT_CHAR
        // No CT exists for these. CT_VOID is the erasure, not a type.
        TyKind.Void => CT_VOID
        TyKind.Fn => CT_VOID
        TyKind.Tuple => CT_VOID
        TyKind.Typevar => CT_VOID
        TyKind.Unknown => CT_VOID
    }
}

// ── Stage 2 divergence instrument ───────────────────────────────────
//
// WHY THIS LIVES IN typecheck.bl. The measurement needs to read BOTH type universes at
// once: ty_pool (this file) and codegen's flat-derived tp_pool. typecheck imports
// codegen_types, not the reverse, so this file is the only one below codegen_expr /
// codegen_stmt / codegen_methods that can see both — and it already owns tk_to_ct, the
// translation layer the comparison runs through. All three codegen modules import
// typecheck, so a call site anywhere in codegen can reach sv_ty_or_flat. It leaves with
// tk_to_ct in Stage 4.
//
// WHAT IT MEASURES. Per call site: how often codegen has no stamped tid at all (Missing),
// how often it has one that the flat fields contradict (Diverge), and how often the two
// agree. Missing is remaining Stage 2 instrumentation; Diverge is remaining Stage 3
// lowering work. Pooling them into one number would conflate the two, so they are separate
// buckets, and both are keyed by site because Stage 3's exit criterion — the counter at 0 —
// has to be worked through site by site.
pub type TyDiv { Agree, Diverge, Missing }

type TyDivRow {
    site: Str
    agree: Int
    diverge: Int
    missing: Int
}
// Deliberately NOT reset by reset_scope_state: that runs per function, and a per-function
// counter cannot answer a whole-corpus sweep. Reset is explicit only.
let mut ty_div_rows: List[TyDivRow] = []

pub fn reset_ty_divergence() {
    ty_div_rows = []
}

fn ty_div_find(site: Str) -> Int {
    let mut i = 0
    while i < ty_div_rows.len() {
        if ty_div_rows.get(i).unwrap().site == site { return i }
        i = i + 1
    }
    -1
}

fn ty_div_bump(site: Str, b: TyDiv) {
    let idx = ty_div_find(site)
    if idx < 0 {
        ty_div_rows.push(TyDivRow { site: site, agree: 0, diverge: 0, missing: 0 })
        ty_div_bump(site, b)
        return
    }
    let r = ty_div_rows.get(idx).unwrap()
    match b {
        TyDiv.Agree => { ty_div_rows.set(idx, TyDivRow { agree: r.agree + 1, ..r }) }
        TyDiv.Diverge => { ty_div_rows.set(idx, TyDivRow { diverge: r.diverge + 1, ..r }) }
        TyDiv.Missing => { ty_div_rows.set(idx, TyDivRow { missing: r.missing + 1, ..r }) }
    }
}

// A query must never create a row: a sweep's zero has to mean "reached and clean", not
// "never reached" (the unexercised-tap failure mode).
pub fn ty_divergence_count(site: Str, b: TyDiv) -> Int {
    let idx = ty_div_find(site)
    if idx < 0 { return 0 }
    let r = ty_div_rows.get(idx).unwrap()
    match b {
        TyDiv.Agree => return r.agree
        TyDiv.Diverge => return r.diverge
        TyDiv.Missing => return r.missing
    }
}

pub fn ty_divergence_total(b: TyDiv) -> Int {
    let mut total = 0
    let mut i = 0
    while i < ty_div_rows.len() {
        total = total + ty_divergence_count(ty_div_rows.get(i).unwrap().site, b)
        i = i + 1
    }
    total
}

pub fn ty_divergence_rows() -> List[Str] {
    let mut out: List[Str] = []
    let mut i = 0
    while i < ty_div_rows.len() {
        let r = ty_div_rows.get(i).unwrap()
        out.push("{r.site} agree={r.agree} diverge={r.diverge} missing={r.missing}")
        i = i + 1
    }
    out
}

fn tp_cmp_child(tp: Int, i: Int) -> Int {
    if i == 0 { return tp_get_child1(tp) }
    if i == 1 { return tp_get_child2(tp) }
    -1
}

// Structural, NOT string equality. The two universes render types with different
// vocabularies (tp_display spells a closure `Fn(sig)`, tc_type_str spells a struct instance
// with its mono stem), so comparing renderings would manufacture cells for pure spelling
// differences and bury the real ones. Kinds are compared through tk_to_ct, the translation
// that already exists.
//
// Returns 1 for "same shape". Every 0 is a real cell, by construction of three rules:
//   * tp < 0 is an ERASED flat slot. Against a tid that named the type, that is a
//     divergence, not a match — mv45y5's -1-instead-of-fabricate patch made the erasure
//     honest, it did not make it correct.
//   * a kind with no CT at all (Tuple / Fn / Closure / Typevar / Unknown) collapses onto
//     CT_VOID in tk_to_ct. Accepting that as equal to a CT_VOID tp would report AGREE for
//     a tuple-typed variable the flat universe provably cannot describe, so the six are
//     rejected up front and only a genuine Void matches CT_VOID.
//   * Struct / Enum do not recurse. The flat universe has no slot for type arguments; what
//     it has is the mono STEM baked into sname (`Box_Int`), so the args are compared there
//     or nowhere. Recursing would report a cell for every non-generic struct.
fn ty_tp_same_shape(tid0: Int, tp: Int, depth: Int) -> Int {
    // A cycle cannot occur in an interned acyclic pool; the cap is against a corrupted
    // slot, and it answers "same" so a defensive stop can never invent a cell.
    if depth > 12 { return 1 }
    if tp < 0 { return 0 }
    let tid = tc_resolve(tid0)
    if tid < 0 || tid >= ty_pool.len() { return 0 }
    let t = ty_pool.get(tid).unwrap()
    let k = t.kind
    let ct = tk_to_ct(k)
    if ct == CT_VOID && k != TyKind.Void { return 0 }
    if ct != tp_get_kind(tp) { return 0 }
    if k == TyKind.Struct || k == TyKind.Enum {
        let sn = tp_get_sname(tp)
        if sn == t.name { return 1 }
        let stem = tc_tid_struct_mono_name(tid)
        if stem != "" && sn == stem { return 1 }
        return 0
    }
    let n = tc_tid_child_count(tid)
    let mut i = 0
    while i < n {
        if ty_tp_same_shape(tc_tid_child(tid, i), tp_cmp_child(tp, i), depth + 1) == 0 { return 0 }
        i = i + 1
    }
    1
}

// The Stage 2 seam, and the one Stage 3 flips. Answers the authoritative tid for `name`, or
// -1 when codegen never stamped one; a caller keeps its legacy flat path for -1 and reads
// the tid otherwise. In Stage 2 no emit decision calls it, so the flat fields still govern
// everything and the emitted C is unchanged — the instrument observes without perturbing.
//
// `site` is a stable label for the call site, not a message. It is the key the whole cell
// map is grouped by.
pub fn sv_ty_or_flat(name: Str, site: Str) -> Int {
    sv_ty_or_flat_at(name, site, -1)
}

// Same seam, plus the AST node whose type is being decided, so the trace can name the
// declaration instead of only the variable.
//
// Attribution, not decoration. A sweep row carries `var=` and the ENTRY file it was compiled
// from, and neither identifies the `let`: every test compile re-emits the whole stdlib, so one
// stdlib `let buf = ...` is blamed on ~90 different entry files, and short names (`r`, `p`,
// `v`, `inner`) collide across modules besides. Ranking cells by grepping `let <var> =` out of
// the entry file therefore mis-attributes most of the corpus — 501 of 767 (var, flat, file)
// triples had no such line at all, and the ones that did were frequently a same-named variable
// in an unrelated module. `at=` makes every remaining cell attributable from the sweep alone.
pub fn sv_ty_or_flat_at(name: Str, site: Str, node: Int) -> Int {
    let tid = get_var_ty(name)
    if tid < 0 {
        ty_div_bump(site, TyDiv.Missing)
        ty_div_trace(site, "missing", name, -1, -1, node)
        return -1
    }
    let tp = get_var_tp(name)
    if ty_tp_same_shape(tid, tp, 0) == 1 {
        ty_div_bump(site, TyDiv.Agree)
        return tid
    }
    ty_div_bump(site, TyDiv.Diverge)
    ty_div_trace(site, "diverge", name, tid, tp, node)
    tid
}

// The sweep's readout: one NDJSON-ish line per occurrence, carrying both renderings so the
// cell map says WHAT diverged and not merely where. Off by default, so the instrument costs
// a channel check per call when nobody is measuring.
// The sweep's per-site summary, emitted once at the end of a codegen run. Silent when the
// channel is off, and silent when no site was ever reached — an empty dump means "the
// instrument was not exercised", which is a different claim from "zero divergences", and
// keeping the two distinguishable is the whole reason a sweep can be trusted.
pub fn ty_divergence_dump() {
    if dbg_channel_on("tydiv") == 0 { return }
    let rows = ty_divergence_rows()
    let mut i = 0
    while i < rows.len() {
        dbg_trace("tydiv", "summary {rows.get(i).unwrap()}")
        i = i + 1
    }
}

// `at=` is LAST on the line on purpose: a flat spelling can contain spaces
// (`Fn(int64_t(*)(const blink_closure*, int64_t))`), so every sweep script strips a fixed
// trailing token to get at the cell. Two trailing tokens now — the harness appends ` file=`
// after this — and both are suffixes, which keeps `sed 's| at=[^ ]* file=[^ ]*$||'` sufficient.
// `-` when no node was threaded, so the field is always present and never has to be optional.
fn ty_div_trace(site: Str, bucket: Str, name: Str, tid: Int, tp: Int, node: Int) {
    if dbg_channel_on("tydiv") == 0 { return }
    let spelled_tid = if tid >= 0 { tc_type_str(tid) } else { "-" }
    let spelled_tp = if tp >= 0 { tp_display(tp) } else { "-" }
    // Named `at_str`, not `at`, as a WORKAROUND for br 8wk3xg: a local `let at` is not found
    // at all — resolution reaches parser.bl:585's PRIVATE `fn at` and reports
    // error[ImportNotSelected], suggesting you import a private item. Shadowing runs the wrong
    // way. Rename this back to `at` when 8wk3xg is fixed.
    let at_str = if node >= 0 { "{node_source_module(node)}:{node_line(node)}" } else { "-" }
    dbg_trace("tydiv", "bucket={bucket} site={site} var={name} tid={spelled_tid} flat={spelled_tp} at={at_str}")
}

// Inner-type accessors over a tid for the codegen read-site fix (jkdywb). A
// Set[T]/Map[K,V] element reached through a tuple/struct-field boundary loses
// its inner type in the type-erased carrier; codegen recovers it from the
// per-node tid memo (tc_lookup_node_tid) via these. Non-matching tids return a
// safe sentinel (-1 / "") so any un-memoized edge is a no-op fallback.
// Returns the CT for a Set/Map inner tid, or -1 when the inner kind is not one
// tk_to_ct can map to a concrete storage type (typevar/tuple/fn/closure/unknown
// → tk_to_ct yields CT_VOID, which is NOT a real element type). Returning -1 —
// not CT_VOID — keeps the accessor's sentinel contract honest: a caller gating
// on `ct >= 0` then treats an unresolvable inner as a true no-op rather than
// forcing the element type to void (which would emit a `void _mkey` key box).
fn tid_inner_ct(inner: Int) -> Int {
    if inner < 0 || inner >= ty_pool.len() { return -1 }
    let ct = tk_to_ct(ty_pool.get(inner).unwrap().kind)
    if ct == CT_VOID { return -1 }
    ct
}

fn tid_inner_struct(inner: Int) -> Str {
    if inner < 0 || inner >= ty_pool.len() { return "" }
    let it = ty_pool.get(inner).unwrap()
    if it.kind == TyKind.Struct || it.kind == TyKind.Enum {
        // A generic struct INSTANCE inner (Box[Int]) must carry its recursive mono
        // stem (Box_Int), not the erased bare head (Box) — this feeds the generic-fn
        // bare-typevar-return recovery (emit_generic_fn_call_tail) that types the
        // receiving `let` variable's carrier (1452w4). Mirror tc_tid_inner_tag /
        // the top-level branch; "" from tc_tid_struct_mono_name (bare base, typevar,
        // module-qual) keeps the bare fallback.
        //
        // An ENUM INSTANCE inner now shares this path with struct instances (br
        // tydqe6): tc_struct_slot_encodable / tc_tid_encodable already admit an enum
        // instance via this same tc_tid_struct_mono_name (br 82ajft item 1), so the
        // "defer until the gates widen" premise here was stale — the gates had
        // already widened. `stem != ""` still falls through to the bare fallback for
        // a bare base, typevar, or module-qualified name, exactly as the struct arm.
        let stem = tc_tid_struct_mono_name(inner)
        if stem != "" { return stem }
        return strip_module_qualifier(it.name)
    }
    ""
}

pub fn tc_tid_set_elem_ct(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Set { return -1 }
    tid_inner_ct(t.inner1)
}

pub fn tc_tid_set_elem_struct(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Set { return "" }
    tid_inner_struct(t.inner1)
}

// br jw1pmb: the List twin of tc_tid_set_elem_ct/_struct above — same non-resolving
// contract, feeding recover_list_elem_from_tid's per-use recovery rather than a
// resolved/kops path (so no _resolved variant here, unlike tc_tid_set_elem_*_resolved).
pub fn tc_tid_list_elem_ct(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.List { return -1 }
    tid_inner_ct(t.inner1)
}

pub fn tc_tid_list_elem_struct(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.List { return "" }
    tid_inner_struct(t.inner1)
}

pub fn tc_tid_map_key_ct(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Map { return -1 }
    tid_inner_ct(t.inner1)
}

pub fn tc_tid_map_key_struct(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Map { return "" }
    tid_inner_struct(t.inner1)
}

pub fn tc_tid_map_val_ct(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Map { return -1 }
    tid_inner_ct(t.inner2)
}

pub fn tc_tid_map_val_struct(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Map { return "" }
    tid_inner_struct(t.inner2)
}

// Resolving twins of the Set/Map element accessors above (m1wspm). The plain
// accessors read ty_pool.get(inner) WITHOUT tc_resolve, so a metavar that
// tc_pin_generic_args_from_binds bound IN PLACE (kind stays TyKind.Unknown, solution
// stashed in inner1) reads back as TyKind.Unknown -> CT_VOID -> -1/"". These wrap the
// inner in tc_resolve so a bound a_k := Int surfaces its real ct/sname. Originally
// only the key(Map)/elem(Set) twins existed — kops_table_name keys the vtable on
// the key ct and sname alone; the Map value type doesn't affect it. The val
// twins below were added for recover_map_kv_from_tid (codegen_expr.bl), which
// DOES need the value's concrete ct/sname (to pick the right box/unbox shape at
// the read site) — using the plain, non-resolving val accessor there let an
// in-place-bound value metavar read back as -1, bail the whole recovery, and
// leave the field at its erased CT_INT default while the map actually stored a
// boxed value of a different ct, a real box/unbox mismatch (segfault, not just
// a wrong value). Kept separate from the plain accessors: other callers still
// depend on the bound-but-typevar inner reading as -1/"" (dbzy4r deferral et al.).
pub fn tc_tid_map_key_ct_resolved(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Map { return -1 }
    tid_inner_ct(tc_resolve(t.inner1))
}

pub fn tc_tid_map_key_struct_resolved(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Map { return "" }
    tid_inner_struct(tc_resolve(t.inner1))
}

pub fn tc_tid_map_val_ct_resolved(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Map { return -1 }
    tid_inner_ct(tc_resolve(t.inner2))
}

pub fn tc_tid_map_val_struct_resolved(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Map { return "" }
    tid_inner_struct(tc_resolve(t.inner2))
}

pub fn tc_tid_set_elem_ct_resolved(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Set { return -1 }
    tid_inner_ct(tc_resolve(t.inner1))
}

pub fn tc_tid_set_elem_struct_resolved(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Set { return "" }
    tid_inner_struct(tc_resolve(t.inner1))
}

// Is a Map/Set tid's KOPS-DECIDING slot (the key for Map, the element for Set —
// inner1 either way) still a genuinely unbound metavar? The fail-closed backstop
// (br farq9f Stage 3) uses this, not tc_tid_has_unbound_metavar, because that
// predicate also descends the Map VALUE slot (inner2) — `Map[Int, ?v]` is a
// reachable, CORRECT state (the value type doesn't affect kops_table_name) and
// must not be misreported as unsolved. tc_is_unbound_metavar (not a bare kind
// check) is deliberate too: it excludes both a real TyKind.Typevar and the shared
// TYPE_UNKNOWN singleton, so neither is slandered as "unsolved" by this gate.
// Returns 0 — "no evidence", not "proof of a solved slot" — for a non-Map/Set
// tid, an out-of-range tid, or a container mismatch: absence of an unsolved
// metavar is not the same claim as absence of an answer.
pub fn tc_tid_kops_slot_unsolved(tid: Int, container: Str) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return 0 }
    let t = ty_pool.get(tid).unwrap()
    let want_kind = if container == "Map" { TyKind.Map } else { TyKind.Set }
    if t.kind != want_kind { return 0 }
    tc_is_unbound_metavar(tc_resolve(t.inner1))
}

// The raw value-slot tid for a Map tid — twin of tc_tid_map_val_struct but
// surfaces the whole slot tid (Box[Int] instance), not just the mono-name stem.
// The codegen bare-typevar CT_MAP return branch (br h0n5qe) feeds this to
// mono_instance_arg_tids_from_tid so the value struct's mono instance registers
// with real arg tids, including nested value structs (Box[Box[Int]]). Same -1
// sentinel contract as tc_tid_struct_arg_tid: a non-Map tid yields -1.
pub fn tc_tid_map_val_tid(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Map { return -1 }
    t.inner2
}

// The raw key-slot tid for a Map tid — twin of tc_tid_map_val_tid for the key
// slot (br h0n5qe). Same -1 sentinel contract.
pub fn tc_tid_map_key_tid(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Map { return -1 }
    t.inner1
}

// Direct-tid accessors (not inner-of-a-compound): the CT and stripped
// struct/enum name for a tid taken as-is. Used by the codegen call-site fix
// (ma6n41 / tr5gcn) to reroute a generic fn's bare-typevar return off the
// CT_VOID that type_from_name(carrier_tag) produces — the substituted return
// tid memoized on the call node (tc_lookup_node_tid) carries the real shape.
// Same -1 / "" sentinel contract as the inner accessors: tc_tid_ct returns -1
// for a tid tk_to_ct can't map to concrete storage (typevar/tuple/fn/unknown),
// and tc_tid_struct returns "" unless the tid is itself a struct/enum.
//
// THIS FUNCTION IS DELIBERATELY NON-RESOLVING, and that is load-bearing. It reads
// ty_pool.get(tid).kind directly, so a metavar that tc_pin_generic_args_from_binds
// bound IN PLACE (kind stays TyKind.Unknown, solution stashed in inner1) reads back
// TyKind.Unknown -> CT_VOID -> -1. Callers here depend on that -1: a bound-but-typevar
// tid must not masquerade as concrete storage. A caller that instead wants the real
// ct of a bound `a_k := Int` composes tc_tid_resolved with this, or uses one of the
// surviving resolving twins in the m1wspm family — tc_tid_set_elem_ct_resolved /
// tc_tid_map_key_ct_resolved (live at src/codegen_expr.bl:2607, the kops ctor).
// A direct resolving twin of THIS function existed and was deleted with its last caller;
// re-adding one is fine, folding resolution INTO this function is not.
//
// TRAP, and the reason this warning lives here rather than only at the seam: do NOT
// key a struct-slot admission gate on a CT at all. tk_to_ct maps TyKind.Void, TyKind.Typevar,
// TyKind.Unknown and TyKind.Fn all onto CT_VOID, so a CT-keyed slot gate admits unsolved
// metavars as if they were a genuine Void — the inversion br hsgsbp had to reverse
// once already. Slot gates key on the KIND (tc_struct_slot_encodable); the same trap
// is restated at the seam itself, src/codegen_expr.bl:5669-5672.
pub fn tc_tid_ct(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let ct = tk_to_ct(ty_pool.get(tid).unwrap().kind)
    if ct == CT_VOID { return -1 }
    ct
}

// The resolved tid itself, so a codegen caller can compose the NON-resolving
// accessors above on a bound metavar without needing a resolving twin of each.
// -1 for an out-of-range input; otherwise tc_resolve's result, which is the identity
// on everything that is not a bound metavar (concrete types, typevars, TYPE_UNKNOWN,
// unbound metavars) and otherwise the solution it steps to. That is in-range unless a
// bound metavar's inner1 points outside the pool, which would be a pool-invariant
// violation, so callers get the same -1/in-range discipline as the accessors above.
pub fn tc_tid_resolved(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    tc_resolve(tid)
}

// ── Structural accessors ────────────────────────────────────────────────────
//
// The four functions that subsume the 51-accessor cartesian product below
// ({list_elem, set_elem, map_key, map_val, option_inner, result_ok, result_err,
// struct_arg, tuple_elem} x {_ct, _struct, _tid} x {plain, _resolved}). That product
// exists for ONE reason: codegen could not hold a tid, so each child had to be
// pre-flattened into a (CT_* code, struct name) pair at this boundary. A pair spans
// depth 1, which is why every nesting deeper than that needed its own bespoke channel.
// tc_tid_child answers a *tid*, so it composes with itself and depth stops mattering.
//
// RAW, all four: they read the pool slot as stored. A caller that wants a bound metavar
// followed composes tc_tid_resolved FIRST. This is deliberate and not an oversight — a
// raw/resolved asymmetry between two readers of one tid is a documented cause of past
// capture holes, and resolving the kind while reading children raw would report
// TyKind.Map while answering -1 for both children. Note the resulting split with
// type_kind above, which DOES resolve: type_kind is typecheck's semantic question ("what
// is this type"), tc_tid_kind is the structural one ("what is in this slot").
//
// Equivalence with each accessor these replace is pinned in
// tests/test_tc_tid_structural_accessors.bl. Stage 4's deletion is licensed by those
// rows and nothing else.
pub fn tc_tid_kind(tid: Int) -> TyKind {
    if tid < 0 || tid >= ty_pool.len() { return TyKind.Unknown }
    ty_pool.get(tid).unwrap().kind
}

// Arity is KIND-determined, never slot-determined. A List whose element slot holds -1
// still has ONE child, answered as -1 — that is what lets a caller tell "this kind has
// no child" from "this child is erased". Collapsing those two is exactly the
// Void-vs-erasure conflation tests/test_hsgsbp_void_vs_erasure.bl guards, and deriving
// the count from `inner1 != -1` would reintroduce it here.
pub fn tc_tid_child_count(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return 0 }
    let t = ty_pool.get(tid).unwrap()
    match t.kind {
        TyKind.List => 1
        TyKind.Option => 1
        TyKind.Set => 1
        TyKind.Result => 2
        TyKind.Map => 2
        // inner1 is the return type and the params follow it, so 1 + params_count.
        TyKind.Fn => 1 + t.params_count
        // Variadic: arity IS params_count, so a generic base (Box) reports 0 and an
        // instance (Box[Int]) reports 1 — a distinction callers depend on.
        TyKind.Tuple => t.params_count
        TyKind.Struct => t.params_count
        TyKind.Enum => t.params_count
        // Leaves. Named individually rather than defaulted so that adding a kind with
        // children fails to compile here instead of silently reporting 0 — which would
        // present as "the type has no element" at every call site at once.
        TyKind.Int => 0
        TyKind.Float => 0
        TyKind.Bool => 0
        TyKind.Str => 0
        TyKind.Void => 0
        TyKind.Bytes => 0
        TyKind.StringBuilder => 0
        TyKind.Typevar => 0
        TyKind.Unknown => 0
        // Channel/Handle carry one inner each since br vag3wc constructed them (element /
        // result). TyKind.Iterator is still never produced: `Iterator[T]` is a TRAIT in
        // sections/03c_protocols.md as well as a concrete return type in the List-methods
        // table, and typecheck's own adapter table answers List[T] for .take/.skip — so
        // constructing it would reject the spec-legal `let it: Iterator[Int] = a.take(2)`
        // that is accepted today. Deciding which reading wins, and aligning the adapter
        // return types with it, is br qzdz2e; this arm stays 0 until then.
        TyKind.Iterator => 0
        TyKind.Handle => 1
        TyKind.Channel => 1
        // The pointee. `Ptr[Void]` and `Ptr[Ptr[T]]` are both spec-legal pointees
        // (sections/07_trust_modules_metadata.md:193,:197), so this child is a real recursion
        // point, not a formality.
        TyKind.Ptr => 1
        // The phantom context. Carried, not checked — see make_template_type (br nrrs28).
        TyKind.Template => 1
        TyKind.FfiScope => 0
        TyKind.I8 => 0
        TyKind.I16 => 0
        TyKind.I32 => 0
        TyKind.U8 => 0
        TyKind.U16 => 0
        TyKind.U32 => 0
        TyKind.U64 => 0
        TyKind.Char => 0
    }
}

// Child `i` as a TID, uniformly across all three storage forms (inner1, inner2, and the
// ty_param_list slice). -1 for out of range, and -1 is also the honest answer for a slot
// whose child is genuinely absent.
//
// Answering -1 rather than a plausible default is the entire point. sv_tp
// (codegen_types.bl) responds to a missing slot by INVENTING one —
// `return type_list(type_int())` — and every "erases the element to Int" / "fabricated as
// CT_STRING default" ticket in the backlog is that invention observed downstream. Do not
// add a fallback here, and do not clamp `i` to the last real child: a clamp duplicates a
// type into a slot that has none and reads as success.
pub fn tc_tid_child(tid: Int, i: Int) -> Int {
    if i < 0 { return -1 }
    if i >= tc_tid_child_count(tid) { return -1 }
    let t = ty_pool.get(tid).unwrap()
    match t.kind {
        TyKind.List => t.inner1
        TyKind.Option => t.inner1
        TyKind.Set => t.inner1
        TyKind.Result => if i == 0 { t.inner1 } else { t.inner2 }
        TyKind.Map => if i == 0 { t.inner1 } else { t.inner2 }
        // Return-first, then params. Pinned by test rather than convention: nothing else
        // in the tree mixes a scalar slot with the variadic slice, so a silent reordering
        // would stay invisible until a signature came out backwards.
        TyKind.Fn => if i == 0 { t.inner1 } else { ty_param_at(t, i - 1) }
        TyKind.Tuple => ty_param_at(t, i)
        TyKind.Struct => ty_param_at(t, i)
        TyKind.Enum => ty_param_at(t, i)
        // Unreachable: child_count answered 0 for every kind below, so the bound check
        // above already returned. Enumerated anyway so this match stays total and a kind
        // that GAINS children cannot slip through with a silent -1.
        TyKind.Int => -1
        TyKind.Float => -1
        TyKind.Bool => -1
        TyKind.Str => -1
        TyKind.Void => -1
        TyKind.Bytes => -1
        TyKind.StringBuilder => -1
        TyKind.Typevar => -1
        TyKind.Unknown => -1
        // Unconstructed — see tc_tid_child_count above (br qzdz2e).
        TyKind.Iterator => -1
        TyKind.Handle => if i == 0 { t.inner1 } else { -1 }
        TyKind.Channel => if i == 0 { t.inner1 } else { -1 }
        TyKind.Ptr => if i == 0 { t.inner1 } else { -1 }
        TyKind.Template => if i == 0 { t.inner1 } else { -1 }
        TyKind.FfiScope => -1
        TyKind.I8 => -1
        TyKind.I16 => -1
        TyKind.I32 => -1
        TyKind.U8 => -1
        TyKind.U16 => -1
        TyKind.U32 => -1
        TyKind.U64 => -1
        TyKind.Char => -1
    }
}

// Bounds-checked read of the variadic slice. A params_start/params_count pair pointing
// outside ty_param_list is a pool-invariant violation; answer -1 rather than panicking,
// consistent with every other sentinel on this boundary.
fn ty_param_at(t: TypePoolEntry, i: Int) -> Int {
    if t.params_start < 0 { return -1 }
    if i < 0 || i >= t.params_count { return -1 }
    let idx = t.params_start + i
    if idx >= ty_param_list.len() { return -1 }
    ty_param_list.get(idx) ?? -1
}

// The RAW declared name: a struct/enum instance answers its generic base unadorned
// (`Box`, not `Box_Int`) and a container answers its kind's own name. Mono spelling is a
// separate concern and must not leak in here — tc_tid_struct_mono_name owns that.
// Unlike tc_tid_struct below, this does not strip the module qualifier and does not
// restrict to Struct/Enum, because a caller walking a tree needs a name for whatever it
// lands on.
pub fn tc_tid_name(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    ty_pool.get(tid).unwrap().name
}

pub fn tc_tid_struct(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind == TyKind.Struct || t.kind == TyKind.Enum { return strip_module_qualifier(t.name) }
    ""
}

// Whether `tid` is a TyKind.Enum (bare or instance). Lets codegen distinguish a
// generic-enum instance slot from a struct instance slot when both funnel through
// the kind-agnostic tc_tid_struct/tc_tid_struct_arg_* accessors (jjhnf3).
pub fn tc_tid_is_enum(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return 0 }
    if ty_pool.get(tid).unwrap().kind == TyKind.Enum { return 1 }
    0
}

// ── Channel element type, for codegen's three consumption seams (br hgd2az) ──────────
//
// `send`, `recv` and the `for v in ch` drain all asked get_var_channel_inner — a read of
// codegen's FLAT ScopeVar field — and that field was a fabrication: the let-binding stamped
// it by looking the INITIALIZER's emitted C expression up as a variable name
// (codegen_stmt.bl:3509), which never hits, so every channel in every program landed on the
// CT_INT default. The element type was in the tid the whole time. These two answer it.
//
// The pair (ct, struct name) rather than a tid is codegen's own language at this boundary;
// see the note on tc_tid_child above for why that pair is the thing being retired. Once
// Stage 3's recursive c_type_from_tid lands, both of these collapse into it.
fn tc_channel_elem_tid(chan_tid: Int) -> Int {
    let t = tc_tid_resolved(chan_tid)
    if t < 0 { return -1 }
    if tc_tid_kind(t) != TyKind.Channel { return -1 }
    if tc_tid_child_count(t) < 1 { return -1 }
    tc_tid_resolved(tc_tid_child(t, 0))
}

// The element's CT when the element is representable BY VALUE in codegen's flat universe,
// and -1 when it is not — in which case the caller must keep its existing flat behaviour
// rather than trade one wrong answer for another. The gate and the answer are the same
// function on purpose: a kind that this cannot spell cannot be claimed as supported
// somewhere else. The match is exhaustive so a kind added later fails to compile here
// instead of falling through to a plausible CT.
pub fn tc_channel_elem_ct(chan_tid: Int) -> Int {
    let e = tc_channel_elem_tid(chan_tid)
    if e < 0 { return -1 }
    let k = tc_tid_kind(e)
    // A struct or a data enum travels as its typedef, by value. A GENERIC instance is
    // excluded: its C name is the monomorphised spelling that only the mono registry can
    // produce, and emitting `blink_Box` for a `Box[Int]` element would name a type that was
    // never emitted. tc_tid_child_count reports 0 for a non-generic struct/enum and the arg
    // count for an instance, so the test is exact.
    if k == TyKind.Struct || k == TyKind.Enum {
        if tc_tid_child_count(e) != 0 { return -1 }
        if tc_tid_struct(e) == "" { return -1 }
        return CT_STRUCT
    }
    match k {
        TyKind.Int => CT_INT
        TyKind.Float => CT_FLOAT
        TyKind.Bool => CT_BOOL
        TyKind.Str => CT_STRING
        TyKind.Char => CT_CHAR
        TyKind.I8 => CT_I8
        TyKind.I16 => CT_I16
        TyKind.I32 => CT_I32
        TyKind.U8 => CT_U8
        TyKind.U16 => CT_U16
        TyKind.U32 => CT_U32
        TyKind.U64 => CT_U64
        // Two runtime handles with no element of their own, so nothing is lost by carrying
        // them: the box holds the handle and the unboxed value is complete.
        TyKind.Bytes => CT_BYTES
        TyKind.StringBuilder => CT_STRINGBUILDER
        // A CONTAINER element round-trips through the box perfectly well; what does not
        // round-trip is its own element/key/value metadata, which lives in flat side fields
        // that a `recv()` result has no way to carry. Claiming these would turn a wrong
        // element type into a wrong element type ONE LEVEL DOWN — the exact defect this
        // ticket is fixing — so they stay with the fallback until c_type_from_tid makes the
        // whole tree spellable.
        TyKind.List => -1
        TyKind.Map => -1
        TyKind.Set => -1
        TyKind.Option => -1
        TyKind.Result => -1
        TyKind.Tuple => -1
        TyKind.Ptr => -1
        TyKind.Fn => -1
        TyKind.Handle => -1
        TyKind.Channel => -1
        TyKind.Iterator => -1
        TyKind.Template => -1
        TyKind.FfiScope => -1
        // No element type at all. `Channel[Void]` is not a thing, an unresolved metavar or a
        // typevar means the element is not known YET, and a bare `Channel(n)` reaches here
        // through TyKind.Unknown — that spelling names no element and is br w3v2e6's
        // inference task, not a hole in this function.
        TyKind.Void => -1
        TyKind.Typevar => -1
        TyKind.Unknown => -1
        // Handled above, ahead of the match, because both need the arity test.
        TyKind.Struct => -1
        TyKind.Enum => -1
    }
}

// The bare struct/enum name behind a CT_STRUCT element; "" for every other element. Paired
// with tc_channel_elem_ct — a caller that reads CT_STRUCT must read this too, or it has a
// nameless struct.
pub fn tc_channel_elem_struct(chan_tid: Int) -> Str {
    tc_tid_struct(tc_channel_elem_tid(chan_tid))
}

// Monomorphized-struct-instance accessors (br kvn6w8 spike). Read the concrete
// type-args of a struct-instance tid built by make_struct_instance_type — the
// `Box[Int]` shape stored variadically in ty_param_list[params_start..]. These
// are the OFF-PATH seam the later reader-switch increments consume; nothing on
// the emit path calls them yet. Same -1 / "" sentinel contract as the inner
// accessors above: a non-struct tid, an out-of-range idx, or a generic base
// (params_count 0) yields 0 / -1 / "". A count of 0 distinguishes the bare
// generic base (`Box`) from an instance (`Box[Int]`, count 1).
pub fn tc_tid_struct_arg_count(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return 0 }
    let t = ty_pool.get(tid).unwrap()
    // TyKind.Enum admitted so a generic-enum INSTANCE (`Tree[Int]`) surfaces its arg
    // count to the codegen mono-name path, mirroring struct instances (jjhnf3).
    if t.kind != TyKind.Struct && t.kind != TyKind.Enum { return 0 }
    t.params_count
}

pub fn tc_tid_struct_arg_ct(tid: Int, idx: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Struct { return -1 }
    if idx < 0 || idx >= t.params_count { return -1 }
    tid_inner_ct(ty_param_list.get(t.params_start + idx).unwrap())
}

pub fn tc_tid_struct_arg_struct(tid: Int, idx: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Struct { return "" }
    if idx < 0 || idx >= t.params_count { return "" }
    tid_inner_struct(ty_param_list.get(t.params_start + idx).unwrap())
}

// The raw type-arg SLOT tid for a struct-instance tid, for the codegen struct-lit
// mono-arg derivation (br zrybya): the sibling _ct / _struct accessors read this
// slot internally but only surface a CT / bare name, whereas the compound-field
// fix must feed the whole slot tid to tc_tid_to_c_tag (Option[Int] → "Option_int").
// Same -1 sentinel contract: a non-struct tid, out-of-range idx, or bare generic
// base (params_count 0) yields -1.
pub fn tc_tid_struct_arg_tid(tid: Int, idx: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    // TyKind.Enum admitted so a generic-enum INSTANCE (`Tree[Int]`) surfaces its per-slot
    // arg tids to the codegen mono-name / instance-registration path (jjhnf3).
    if t.kind != TyKind.Struct && t.kind != TyKind.Enum { return -1 }
    if idx < 0 || idx >= t.params_count { return -1 }
    ty_param_list.get(t.params_start + idx).unwrap()
}

// The full monomorphized C name STEM for a struct-INSTANCE tid — the mangled
// `Box_Str` / `Pair_Str_Int` / `Box_Box_Int` codegen prefixes with `blink_` to.
// This is the def-side reader for the codegen-structured-tids epic (br wme0hh):
// a NON-generic fn whose param type is a concrete generic-struct instance
// (`b: Box[Str]`) must lower its C type off the instance tid typecheck memoized
// onto the param annotation (kvn6w8 make_struct_instance_type), not the bare
// head name (which codegen's param_c_type erroneously used → the never-typedef'd
// `blink_Box`).
//
// Each arg slot is spelled via tc_tid_to_c_tag EXCEPT a struct-instance slot
// (params_count>=1), which is expanded RECURSIVELY so nesting is preserved:
// `Box[Box[Int]]` → outer base `Box` + inner stem `Box_Int` = `Box_Box_Int`,
// where the string helper (mono_name_from_ann) would read only the inner head
// name and collapse to `Box_Box`, dropping the `Int`.
//
// Returns "" (→ the caller keeps the string path) for a non-struct tid, a bare
// generic base (params_count 0), or any tid whose transitive slots are not
// concretely encodable (an unsubstituted typevar/unknown, or a module-qualified
// struct/enum, which tc_tid_to_c_tag strips and would diverge from the string
// path's file-derived prefix). The all-concrete same-module case is exactly the
// wme0hh beachhead; everything else DEFERS, matching test_6zmspt / test_tid_tuple.
pub fn tc_tid_struct_mono_name(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    // TyKind.Enum admitted (jjhnf3): a generic-enum INSTANCE (`Tree[Int]`) spells the same
    // mono stem as a struct instance — c_type_tag_for_struct(base) + `_`-joined slot
    // segs — since both the head tag and tc_tid_struct_slot_seg are kind-agnostic. This
    // is what lets tc_tid_to_c_tag's shared TyKind.Struct|TyKind.Enum branch produce `Tree_Int`.
    // The 3 sibling gates (tc_tid_encodable / tc_tid_tuple_elem_faithful /
    // tc_struct_slot_encodable) now ADMIT an enum instance too (br 82ajft / dbzy4r
    // flipped their `k == TyKind.Enum && params_count != 0` arms), so widening this fn
    // and widening them landed together — neither is stale relative to the other.
    if (t.kind != TyKind.Struct && t.kind != TyKind.Enum) || t.params_count == 0 { return "" }
    // br cr4gqk: escape_mono_seg on the base and every slot segment, and join with "_0"
    // rather than a bare "_", so this stem is byte-identical to what mangle_generic_name
    // (codegen_types.bl) produces for the same (base, args) — this fn is a NINTH,
    // independent producer of a struct/enum mono instance's C name (the def side goes
    // through mangle_generic_name; this is a use-side producer feeding generic-fn return
    // type resolution), and before this fix it built the name via unescaped concatenation.
    // A divergence here is exactly the bee854 class documented at
    // codegen_types.bl:4668-4675: def side and use side disagreeing on a mono name is a
    // hard `cc` failure (the def side's typedef and this fn's reference to it stop naming
    // the same C symbol) the moment either side's input contains an underscore.
    let mut result = escape_mono_seg(c_type_tag_for_struct(t.name))
    let mut i = 0
    while i < t.params_count {
        let slot = ty_param_list.get(t.params_start + i).unwrap()
        let seg = tc_tid_struct_slot_seg(slot)
        if seg == "" { return "" }
        // Collapse, never interpolate (br vbcw1e): tc_tid_struct_slot_seg can answer a bare
        // ICE_SEG_* sentinel (e.g. a TyKind.Fn slot via tc_tid_to_c_tag's unhandled-kind
        // arm). Concatenating it here would bury it mid-identifier (Box_int_BLINK_I0001_...),
        // past where diag_is_ice_seg's prefix test at the downstream chokepoints can see it —
        // the same hazard this ticket closes for Option/Result/Map/Tuple, one struct level down.
        if diag_is_ice_seg(seg) { return seg }
        result = result.concat("_0").concat(escape_mono_seg(seg))
        i = i + 1
    }
    result
}

// The CSV segment a struct-instance arg SLOT contributes to the mono name: the
// full recursive stem for a nested struct instance (Box_Int), else the plain tag
// (Str/Int/Option_int) when the slot is faithfully encodable. Returns "" for an
// unencodable slot (unsubstituted typevar, module-qualified struct/enum) so both
// the codegen name-builder (tc_tid_struct_mono_name) and the def-side typedef
// registrar (register_struct_instance_from_tid) DEFER identically to the string
// path. Kept pub so codegen can gate without reaching the private
// tc_tid_encodable.
pub fn tc_tid_struct_slot_seg(slot: Int) -> Str {
    let nested = tc_tid_struct_mono_name(slot)
    if nested != "" { return nested }
    if !tc_tid_encodable(slot) { return "" }
    tc_tid_to_c_tag(slot)
}

// Whether a struct-instance ARG SLOT tid can be lowered by tc_tid_to_c_tag to a
// CSV segment that byte-matches the carrier the field VALUE emits — for the codegen
// struct-lit compound-field fix (br zrybya). This is the compound analogue of
// tc_struct_slot_encodable (which governs the fn-arg slot path): here we ADMIT a
// compound (Option/Result/Map) whose inners are all scalars, because
// tc_tid_to_c_tag then produces exactly the blink_Option_int / blink_Result_int_str
// carrier the field value registers. We REJECT:
//   - a compound whose inner is itself a struct/enum or another compound
//     (`Option[Box[Int]]`, `Option[Option[Int]]`): can diverge in the field-value
//     registration path; defer (orthogonal follow-up).
//   - a bare scalar slot: handled by the existing string path unchanged.
//
// A TUPLE slot is ADMITTED (br fqthkv), gated on tc_tid_tuple_elem_faithful — the SAME
// predicate the sibling gate tc_struct_slot_encodable already uses for its own
// TyKind.Tuple arm, whose comment records that tc_tid_to_c_tag's tuple spelling
// (tc_tid_tuple_tag -> Tuple2_int_int) byte-matches the struct-lit string path's
// registered tuple carrier segment. Before this arm a tuple type arg left
// has_compound at 0 in the tid tier's then-triad admission (now the single
// tc_struct_slot_encodable in tid_native_struct_mono_slots), so `GT[(Int, Int)]` hit the
// bail and reached codegen with no mono args at all — error[I0001] "mono args 'Void'".
//
// Permissive (tc_tid_tuple_elem_faithful) rather than scalar-elements-only, because both
// of the other halves of this seam are ALREADY permissive: the def side
// (tc_tid_struct_slot_seg -> tc_tid_encodable) and the parallel arg_tids recovery
// (mono_instance_arg_tids_from_tid -> tc_struct_slot_encodable). An asymmetric
// literal-side gate would recreate the same bail for shapes the compiler can spell
// on both other sides — and tc_tid_tag_at's TAGPOS_INNER arm already erases
// TyKind.List/TyKind.Set/TyKind.Bytes identically for all three, so `(Int, List[Str])` byte-matches
// everywhere.
//
// A STRUCT-OR-ENUM-INSTANCE slot is ADMITTED (br 6cvvh8; TyKind.Enum joined under br
// tydqe6) iff tc_tid_struct_mono_name spells it — the very predicate the def-side
// slot speller (tc_tid_struct_slot_seg) and the mono registrar already consult
// first, so admitting on it cannot split the name from the typedef. Before br
// 6cvvh8 this arm `let e: GT[QB[Int]] = GT { s: Set() }` had no producer at all: the
// string tier bails on every compound annotation arg, so the literal reached
// codegen with 'Void'. The BARE generic base (params_count 0) is unaffected — its
// mono name is "" — and so is every already-working shape, because the string tier
// is consulted before this one at the mono_args selector. TyKind.Enum was excluded
// until tydqe6 on the premise that the encodable gates still deferred it (br
// dbzy4r) — but tc_tid_encodable (:10980-10986) and tc_struct_slot_encodable
// (:11396-11402) already admit an enum instance via this same predicate (br 82ajft
// item 1), so the carve-out here was stale.
//
// NOTE: this predicate currently has no callers anywhere in the repo (confirmed by
// grep, br tydqe6) — it is exported and imported into codegen_expr.bl's namespace
// but never invoked there. Widening its TyKind.Enum arm above is therefore a no-op today;
// R2 of tests/test_tydqe6_generic_enum_instance_mono.bl passes via the
// emit_mono_struct_typedef admission (src/codegen_stmt.bl), not via this function.
// Keep the widening (it documents the intended admission for whenever a caller is
// wired up) but don't rely on it as the cause of any observed behavior change.
pub fn tc_tid_compound_slot_faithful(tid: Int) -> Bool {
    if tid < 0 || tid >= ty_pool.len() { return false }
    let t = ty_pool.get(tid).unwrap()
    let k = t.kind
    if k == TyKind.Option { return tc_tid_scalar_only(t.inner1) }
    if k == TyKind.Result { return tc_tid_scalar_only(t.inner1) && tc_tid_scalar_only(t.inner2) }
    if k == TyKind.Map { return tc_tid_scalar_only(t.inner1) && tc_tid_scalar_only(t.inner2) }
    if k == TyKind.Tuple { return tc_tid_tuple_elem_faithful(tid) }
    if k == TyKind.Struct || k == TyKind.Enum { return tc_tid_struct_mono_name(tid) != "" }
    false
}

// True iff, as the INNER of an Option/Result tuple-element carrier, `tid` spells
// byte-identically across all THREE tuple-element name spellers — the tid path
// (tc_tid_inner_tag), the annotation path (resolve_ann_tag / compound_name_from_ann),
// AND the value path (emit_tuple_lit's CT_OPTION/CT_RESULT arms). Only then may the
// enclosing Option/Result ride the tid path instead of deferring to the flat
// one-level string spelling.
//
// br yavhwc RECONCILED the value path — the lone laggard. emit_tuple_lit's CT_OPTION/
// CT_RESULT arms now read the memoized element tid and spell the inner via the SAME
// tc_tid_inner_tag the tid path uses, so the value path recurses in lockstep. This
// predicate therefore admits every inner whose STRUCTURED recursion bottoms out at
// faithful leaves:
//   - scalar (int/float/bool/str/char/sized-int): tc_tid_tag_at's TAGPOS_INNER arm on all three.
//   - List / Set / Bytes: element dropped to bare "list"/"set"/"bytes" identically.
//   - Map / nested Option / nested Result whose OWN leaves are each faithful: the value
//     path recurses via tc_tid_inner_tag (br yavhwc), so Option[Map[Str,Int]] spells
//     Option_Map_str_int on all three, Option[Option[Int]] spells Option_Option_int, etc.
//     A Result with a DIRECT Map ok/err side rides too (br e3js70) — the construction/
//     param/reassignment speller now spells the Map side STRUCTURED (Result_Map_str_int_int),
//     no longer the bare "map" that once forced a carve-out here.
//   - BARE (params_count 0) struct / enum leaf (br 6q5mz2): admitted. When the enclosing
//     Option/Result rides, emit_tuple_lit spells the inner via tc_tid_inner_tag (the SAME
//     speller the tid path uses), so the value carrier and the mono param are byte-identical by
//     construction — the 637sy9 equivalence for a DIRECT bare-struct tuple element, reused for
//     the wrapped leaf. A Map/Option/Result inner CONTAINING a bare struct/enum leaf rides too.
//   - a struct/enum INSTANCE leaf (params_count != 0, e.g. QBox[Int]/Tree[Int]): admitted
//     (br bee854 for struct, br tydqe6 for enum) — see the two comments beside the
//     `params_count != 0` arm below.
// DEFERS (the string path stays authoritative — a too-loose gate breaks the Gen1==Gen2
// fixed point OR emits divergent carriers):
//   - tuple, typevar, iterator/handle/channel, unknown.
pub fn tc_tid_inner_tag_faithful(tid: Int) -> Bool {
    if tid < 0 || tid >= ty_pool.len() { return false }
    // Exactly the scalar leaves (tc_tid_scalar_only) plus List/Set/Bytes — composed,
    // not re-enumerated, so a new scalar kind stays in lockstep with the scalar gate.
    if tc_tid_scalar_only(tid) { return true }
    let t = ty_pool.get(tid).unwrap()
    let k = t.kind
    if k == TyKind.List || k == TyKind.Set || k == TyKind.Bytes { return true }
    // br yavhwc: the value path now recurses (emit_tuple_lit reads the element tid and
    // spells the inner via the SAME tc_tid_inner_tag the tid path uses), so a Map inner
    // or a nested Option/Result inner is faithful WHENEVER its own leaves are faithful.
    // Recurse structurally — a Map key/val or an Option/Result sub-inner must each be
    // faithful, so the recursion bottoms out at scalar/List/Set/Bytes leaves and rejects
    // any struct/enum/tuple/typevar leaf (still spelled divergently, still deferred).
    if k == TyKind.Map { return tc_tid_inner_tag_faithful(t.inner1) && tc_tid_inner_tag_faithful(t.inner2) }
    if k == TyKind.Option { return tc_tid_inner_tag_faithful(t.inner1) }
    if k == TyKind.Result {
        // br e3js70: a Result carrier with a DIRECT Map ok/err side is now faithful. The
        // Result-Map value carrier used to be spelled BARE ("map") by upgrade_compound_carrier
        // for uniform-blink_map* assignment compat, diverging from the tid path's structured
        // Result_Map_str_int_int; that construction/param/reassignment speller now spells the
        // Map side STRUCTURED (identical C layout → assignment stays legal), so the carve-out
        // is gone and the shape rides the tid path. Recurse structurally — the Result's sides
        // must each be faithful (a Map side bottoms out at faithful scalar/List/Set/Bytes
        // key/val), rejecting only a struct/enum/tuple/typevar leaf.
        return tc_tid_inner_tag_faithful(t.inner1) && tc_tid_inner_tag_faithful(t.inner2)
    }
    // br 6q5mz2: a BARE (params_count 0) struct/enum leaf is faithful. When the enclosing
    // Option/Result rides, emit_tuple_lit spells the inner via tc_tid_inner_tag
    // (codegen_expr.bl ~5626/5633) — the EXACT same speller the tid path uses — and for a bare
    // struct/enum that bottoms out at c_type_tag_for_struct on BOTH the value carrier and the
    // generic-fn mono param, byte-identical by construction. This is the equivalence br 637sy9
    // proved for a DIRECT (non-wrapped) bare-struct tuple element; the Option/Result-wrapped
    // bare leaf reuses it since the ride branch delegates to the same function rather than the
    // divergent canonical_struct_tag fallback. Module qualifier is a non-issue: both sides call
    // tc_tid_inner_tag on the SAME tid, so they agree whatever it spells.
    //
    // br bee854: a struct INSTANCE leaf (params_count != 0, e.g. QBox[Int]) is now FAITHFUL.
    // When the enclosing Option/Result rides, emit_tuple_lit spells the inner via
    // tc_tid_inner_tag, whose struct/enum arm returns tc_tid_struct_mono_name (the mono stem
    // QBox_Int) — byte-identical to the tid-path carrier (blink_Option_QBox_Int). The
    // annotation-lowering erasure that used to mint a divergent bare blink_Option_QBox carrier
    // (void*/undeclared-blink_QBox member) is fixed at the same time: the lowering sites now
    // thread the mono stem + register the instance (register_carrier_inner_mono_instance), so
    // both paths converge on the single blink_Option_QBox_Int (blink_QBox_Int* value).
    //
    // A generic-enum INSTANCE (TyKind.Enum, params_count != 0) is now admitted alongside
    // TyKind.Struct (br tydqe6): the encodable gates (tc_tid_encodable, tc_struct_slot_
    // encodable) already spell it via tc_tid_struct_mono_name (Tree_Int), so it rides
    // the tid path exactly like a struct instance — the "still defers" carve-out that
    // used to live here was stale once those gates widened under br 82ajft item 1.
    if t.params_count != 0 {
        if k == TyKind.Struct || k == TyKind.Enum { return true }
        // Counterfactual measurement (br vbcw1e): every DECLINE here is a slot that stays
        // on the string CSV path today. If a future caller routed it onto the tid path
        // instead (qerbc7's "consumers stop routing on the gate" flip), this records
        // whether tc_tid_inner_tag would have silently spelled it "void" (a give-up) rather
        // than a real name — the erasure this gate currently prevents by declining, not by
        // detecting. Never changes the `false` returned above.
        voidtwin_probe("faithful_reject_paramcount", tid)
        return false
    }
    if k == TyKind.Struct || k == TyKind.Enum { return true }
    voidtwin_probe("faithful_reject", tid)
    false
}

// True iff `tid` is a plain scalar (int/float/bool/str/char/sized-int) — the shapes
// whose tc_tid_inner_tag is a lowercase Pascal tag that matches the carrier the
// field value emits. Excludes struct/enum (name erasure), compounds (nesting), and
// list/set/bytes/tuple (carrier spelling divergence).
fn tc_tid_scalar_only(tid: Int) -> Bool {
    if tid < 0 || tid >= ty_pool.len() { return false }
    let k = ty_pool.get(tid).unwrap().kind
    if k == TyKind.Int || k == TyKind.Float || k == TyKind.Bool || k == TyKind.Str || k == TyKind.Char { return true }
    if k == TyKind.I8 || k == TyKind.I16 || k == TyKind.I32 { return true }
    if k == TyKind.U8 || k == TyKind.U16 || k == TyKind.U32 || k == TyKind.U64 { return true }
    false
}

// mmegcb: the mangled tuple carrier name (Tuple2_int_str) for a TyKind.Tuple tid,
// else "" (same sentinel contract as tc_tid_struct). A Set[(Int,Str)] element
// (or Map tuple key) reached through a tuple/struct-field boundary erases to
// CT_STRING (recover_elem_ct_from_arg's erased default); codegen recovers the
// concrete tuple element from the argument node's memoized tid. For SCALAR tuple
// elements the tag equals resolve_tuple_ann's tuple_c_type_name (tc_tid_tag_at's
// TAGPOS_INNER arm ≡ c_type_tag), so the recovered sname aliases the kops-struct carrier the Set's
// construction registered in derive_hash_types. Tuple elements that are
// themselves module-qualified structs/enums can diverge from resolve_tuple_ann's
// c_type_tag_for_struct spelling; recover_elem_ct_from_arg's kops_is_struct_key
// guard turns any such miss into a safe no-op (never a miscompile).
pub fn tc_tid_tuple_sname(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Tuple { return "" }
    tc_tid_tuple_tag(t)
}

// Tuple element-tid accessors so codegen can recurse a tuple's struct-instance
// elements back through register_struct_instance_from_tid — a tuple element that
// is a generic-struct instance (`(PBox[Int], Int)`) appearing only as a param/
// return type is otherwise never registered, so its by-value member type
// blink_PBox_Int is never typedef'd (br 637sy9). Return -1 / 0 on kind mismatch.
pub fn tc_tid_tuple_arity(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return 0 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Tuple { return 0 }
    t.params_count
}

pub fn tc_tid_tuple_elem_tid(tid: Int, idx: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Tuple { return -1 }
    if idx < 0 || idx >= t.params_count { return -1 }
    ty_param_list.get(t.params_start + idx).unwrap()
}

// Option/Result inner-shape accessors over a tid, for the call-site fix. Mirror
// tc_tid_set_elem_ct's kind-guard + inner-accessor pattern. inner1 = Option
// value / Result Ok; inner2 = Result Err. Return the inner's CT (-1 sentinel)
// and stripped struct/enum name (""), so the codegen call-site can populate the
// expr_* carrier globals exactly as the annotation path does.
pub fn tc_tid_option_inner_ct(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Option { return -1 }
    tid_inner_ct(t.inner1)
}

// The element tid of a List tid, or -1 when the tid is not a List. Lets codegen
// project a receiver List[T]'s element tid without reaching into ty_pool (the
// poly-impl arg-tid path, br ec5qgb).
pub fn tc_tid_list_elem(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.List { return -1 }
    t.inner1
}

pub fn tc_tid_option_inner_struct(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Option { return "" }
    tid_inner_struct(t.inner1)
}

pub fn tc_tid_result_ok_ct(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Result { return -1 }
    tid_inner_ct(t.inner1)
}

pub fn tc_tid_result_ok_struct(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Result { return "" }
    tid_inner_struct(t.inner1)
}

pub fn tc_tid_result_err_ct(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Result { return -1 }
    tid_inner_ct(t.inner2)
}

pub fn tc_tid_result_err_struct(tid: Int) -> Str {
    if tid < 0 || tid >= ty_pool.len() { return "" }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Result { return "" }
    tid_inner_struct(t.inner2)
}

// Inner-TID accessors (not just ct/struct name) so codegen can recurse a carrier's
// leaves back through register_struct_instance_from_tid — needed to register a
// struct-INSTANCE leaf (RBox[Int]) nested inside an Option/Result carrier
// (Result[RBox[Int],RBox[Str]]) before the carrier typedef names it, so the member
// resolves to blink_RBox_Int rather than erasing to `void` (br f9mqbq). The tid
// carries the structured type-args (a multi-param leaf Pair[Int,Str] keeps its two
// slots), which the mono-name string tag cannot unambiguously recover. inner1 =
// Option value / Result Ok; inner2 = Result Err. Return -1 on kind mismatch.
pub fn tc_tid_option_inner_tid(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Option { return -1 }
    t.inner1
}

pub fn tc_tid_result_ok_tid(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Result { return -1 }
    t.inner1
}

pub fn tc_tid_result_err_tid(tid: Int) -> Int {
    if tid < 0 || tid >= ty_pool.len() { return -1 }
    let t = ty_pool.get(tid).unwrap()
    if t.kind != TyKind.Result { return -1 }
    t.inner2
}

// TOP-LEVEL CSV-segment form for a tid: the string that, concatenated onto a
// generic base by mangle_generic_name, reproduces the current monomorphized C
// symbol. Since br 3fc3pn this is the SOLE per-segment resolution, not a twin of
// one: the string producer it was written to byte-match is gone, so the answers
// DEFINE the symbol rather than having to agree with something else.
// Note the asymmetry vs tc_tid_inner_tag: a top-level Map segment erases to the
// bare carrier "Map", while a Map *inside* a compound keeps its Map_<k>_<v> tag.
// Both positions are one encoder with a `tagpos` parameter (br qerbc7,
// tc_tid_tag_at) — see that function for the full per-kind rationale. Thin
// wrapper: no caller moves, no behavior changes.
pub fn tc_tid_to_c_tag(tid: Int) -> Str {
    tc_tid_tag_at(tid, TAGPOS_TOP)
}

// Whether tc_tid_to_c_tag can faithfully encode this tid into a CSV segment that
// byte-matches the string-tag path. False (→ defer to the old path) for any tid
// tc_tid_to_c_tag would lose or poison: an unsubstituted typevar or unknown
// (mono-calls-mono; substitution happens later at codegen mono-expansion), and
// any compound whose inner is itself unencodable (a nested typevar would leak
// "<tv>" into the symbol). Struct/enum/scalar/list/set/map are all encodable at
// the top level (list/set/map erase to their bare carrier).
//
// A top-level tuple is encodable only when every element is tuple-element-safe
// (tc_tid_tuple_elem_faithful): the tid path spells a struct/enum element with the
// module qualifier STRIPPED (tc_tid_inner_tag → strip_module_qualifier) while the
// string path's c_type_tag_for_struct KEEPS the module prefix, so a tuple that
// transitively contains a struct/enum would mangle to a different symbol. Those
// still defer to the string path.
fn tc_tid_encodable(tid0: Int) -> Bool {
    // Resolve bound metavars (gqg3rk): a pinned α is encodable iff its solution
    // is; an unbound α resolves to itself (kind TyKind.Unknown) → false (defer to the
    // string path / boundary check reports E0301).
    let tid = tc_resolve(tid0)
    if tid < 0 || tid >= ty_pool.len() { return false }
    let t = ty_pool.get(tid).unwrap()
    let k = t.kind
    // Counterfactual measurement (br vbcw1e): TyKind.Unknown declining here is exactly the
    // routing this gate provides today in INNER position — the reason tc_tid_tag_at's
    // TAGPOS_INNER TyKind.Unknown fall-through is unreachable from any gated caller. Taps
    // the would-be-erasure without changing the `false` returned below.
    if k == TyKind.Unknown {
        voidtwin_probe("encodable", tid)
    }
    if k == TyKind.Typevar || k == TyKind.Unknown { return false }
    if k == TyKind.Tuple { return tc_tid_tuple_elem_faithful(tid) }
    if k == TyKind.Option { return tc_tid_encodable(t.inner1) }
    if k == TyKind.Result { return tc_tid_encodable(t.inner1) && tc_tid_encodable(t.inner2) }
    // A struct/enum INSTANCE (params_count>=1) is admitted only when
    // tc_tid_struct_mono_name can actually spell its full recursive stem — the exact
    // guard tc_struct_slot_encodable uses (br wzm47q depth-3: a still-generic nested
    // instance like Box[T], one level inside an outer Box[Box[T]] LITERAL, used to fall
    // through to the unconditional `true` below on the strength of the comment two
    // paragraphs down, which is true only when tc_tid_struct_mono_name's recursion
    // SUCCEEDS. When it declines (mono_name == ""), tc_tid_to_c_tag's TyKind.Struct|TyKind.Enum
    // arm falls back to the BARE head name instead of declining, so this predicate was
    // admitting a slot that spells as a plain, wrong "Box" — which tc_tid_struct_slot_seg
    // (this function's own caller, one struct level up) then folds into ITS OWN parent's
    // mono name as a plausible-but-unsubstituted segment, short-circuiting
    // tid_native_struct_mono's substitution retry before it gets a chance to run).
    // A BARE struct/enum (params_count 0) still admits unconditionally (br q4etvt).
    if k == TyKind.Struct || k == TyKind.Enum {
        if t.params_count == 0 { return true }
        let name = tc_tid_struct_mono_name(tid)
        return name != "" && !diag_is_ice_seg(name)
    }
    // A MAP slot (br 91j9fw, the List twin of br jw1pmb one carrier over):
    // tc_tid_to_c_tag erases Map to the bare carrier tag "Map" with no inner
    // spelling, exactly like Set/List, and tc_tid_seg_injective already groups
    // TyKind.Map alongside TyKind.Set/TyKind.List as non-injective — so an inner gate here
    // is a refusal with no referent, the identical parity argument jw1pmb made
    // for List. Falls through to TyKind.Set/TyKind.List at the tail `true` below.
    // A struct/enum INSTANCE (type-args present, params_count>=1, e.g. Box[Int]) is
    // ADMITTED (br bwyfy1 B1) above once tc_tid_struct_mono_name can spell it: the
    // mono-CSV consumer (tc_seg_from_tid →
    // tc_tid_to_c_tag) recurses its args to the full mono stem (Box_Int) via
    // tc_tid_struct_mono_name, byte-matching the string path's registered mono name
    // (blink_identity_Box_Int) instead of the erased bare head (blink_identity_Box,
    // the old nss31w bug). Top-level struct/enum args reach this path once a generic
    // field access on a struct instance memoizes a concrete struct tid (br 365fqj).
    //
    // A MODULE-QUALIFIED struct/enum is now ADMITTED (br q4etvt): after the mono-
    // registry physical-base split, tc_tid_to_c_tag spells a cross-module struct
    // INSTANCE via tc_tid_struct_mono_name PHYSICALLY (blink_<mod>_Box_Int) — exactly
    // the c_name register_mono_instance now mints — and a bare cross-module struct as
    // its bare head, matching the string path's bare arg segment. Either way the
    // mono-CSV segment byte-matches the string path, so the module-qualifier no longer
    // forces a defer.
    //
    // An ENUM INSTANCE (TyKind.Enum, params_count>=1) is now ADMITTED (br 82ajft / dbzy4r):
    // tc_tid_struct_mono_name was widened for TyKind.Enum in jjhnf3 (c_type_tag_for_struct
    // base + kind-agnostic slot segs → Tree_Int), so tc_tid_to_c_tag's shared
    // TyKind.Struct|TyKind.Enum branch spells the full mono stem, byte-matching the string
    // path's registered mono name — exactly the struct-instance beachhead above. A
    // slot that is itself inexpressible still bottoms out at tc_tid_struct_slot_seg ""
    // (deferred there), so nothing that was on the string path starts diverging.
    //
    // COUNTERFACTUAL MEASUREMENT, br hsgsbp. This tap ships permanently: every row is a
    // site where adding TyKind.Void to the rejection set above — what br hsgsbp originally
    // asked for — would have flipped this answer to false and routed a genuine Void slot
    // onto the -1/string path. Void is an ordinary INHABITED, encodable type
    // (decisions/under-determined-types.md:38-42, 6-0), so the rejection is forbidden;
    // the number here is what makes that a measurement instead of an argument. Re-measure
    // before reopening the question.
    if k == TyKind.Void {
        dbg_trace("ctagvoid", "probe=encodable_void tid={tid} name={t.name}")
    }
    true
}

// Whether the mono-CSV segment tc_tid_to_c_tag spells for `tid` NAMES ITS OWN TYPE
// ARGUMENTS — i.e. whether that segment may be read back as per-instantiation IDENTITY, or
// only as a REPRESENTATION tag (br xskbvh).
//
// The mono registries dedup on (base, args) with `args` a CSV of these segments, so a
// non-injective segment COLLAPSES distinct instantiations onto one entry: `fn wrap[T]`
// called at Set[Int], Set[Str] and Set[Point] spells the bare segment "Set" three times
// and shares one key, hence one stored arg_tids. That collapse is CORRECT for naming —
// all three are blink_set*, so one C function serves all three and they MUST share the
// symbol — and it is exactly why the single stored tid cannot be per-instantiation type
// info for the others. This predicate is where that boundary is stated: false means "this
// slot's tid still lowers correctly (a Set is a Set), but the registry entry it keys is
// shared, so do not read identity out of it".
//
// KEYED ON THE KIND, never on the resulting string. Pattern-matching a spelling would be
// the erased-default guessing decisions/under-determined-types.md:264-266 forbids (a user
// struct legitimately named `Set` must not answer for the builtin), and a segment cannot
// be inverted anyway — losing the element is the whole point.
//
// It is the tid-side counterpart to the STRING-side erasure detector
// mono_args_has_void_seg (codegen_expr.bl), and answers a DIFFERENT question. That one
// asks "was this slot un-nameable" (a "Void" or bare-binder segment → I0001); this one
// asks "is the name FAITHFUL". Do not fold them together: a faithless name is valid C that
// compiles and links, which is why nothing else catches it.
//
// It must NOT be used to degrade a slot to -1. Since br 0n07he a -1 arg_tid means
// genuinely UNKNOWN, and the def side spells the binder through to a hard cc error
// (codegen_methods.bl resolve_mono_slot). The tid stays — it correctly spells blink_set*
// whatever the element is — only its use as IDENTITY is refused.
pub fn tc_tid_seg_injective(tid0: Int) -> Bool {
    let tid = tc_resolve(tid0)
    if tid < 0 || tid >= ty_pool.len() { return false }
    let t = ty_pool.get(tid).unwrap()
    let k = t.kind
    // The six kinds tc_tid_to_c_tag spells as a BARE carrier tag, dropping every type
    // argument: "List", "Set", "Map", "Iterator", "Handle", "Channel". Note TyKind.Map is
    // non-injective HERE but injective as an INNER (tc_tid_inner_tag spells Map_k_v) —
    // that is why this predicate is position-aware rather than one kind set.
    if k == TyKind.List || k == TyKind.Set || k == TyKind.Map { return false }
    if k == TyKind.Iterator || k == TyKind.Handle || k == TyKind.Channel { return false }
    // Ptr spells a bare "Ptr"/"ptr" and drops the pointee, so two different pointees collide on
    // one segment. Non-injective for the same reason List and Set are (br w13xgb).
    if k == TyKind.Ptr { return false }
    // TyKind.Bytes has no type arguments at all, so its bare "Bytes" is fully faithful — it is
    // NOT part of the erasing set even though it shares their bare spelling.
    if k == TyKind.Bytes { return true }
    if k == TyKind.Option { return tc_tid_inner_seg_injective(t.inner1) }
    if k == TyKind.Result { return tc_tid_inner_seg_injective(t.inner1) && tc_tid_inner_seg_injective(t.inner2) }
    if k == TyKind.Tuple { return tc_tid_tuple_seg_injective(t) }
    if k == TyKind.Struct || k == TyKind.Enum { return tc_tid_struct_seg_injective(t) }
    // No name to be faithful TO: a typevar spells "<tv>" and an unbound metavar spells the
    // I0001 sentinel. Neither identifies a type, so neither may be read as identity. This
    // overlaps mono_args_has_void_seg's population by design — that detector reports it
    // (as a compiler bug), this one merely refuses to trust it.
    if k == TyKind.Typevar || k == TyKind.Unknown { return false }
    // Void is refused for a different reason: "Void" is also tc_tid_to_c_tag's fallthrough
    // for every kind it has no arm for, so the segment does not distinguish the real Void
    // from an unspellable type. Never identity.
    if k == TyKind.Void { return false }
    // Scalars (Int/Float/Bool/Str/Char/sized ints) each spell a unique fixed tag.
    if k == TyKind.Int || k == TyKind.Float || k == TyKind.Bool || k == TyKind.Str || k == TyKind.Char { return true }
    if k == TyKind.I8 || k == TyKind.I16 || k == TyKind.I32 { return true }
    if k == TyKind.U8 || k == TyKind.U16 || k == TyKind.U32 || k == TyKind.U64 { return true }
    // Anything else (TyKind.Fn, any future kind) has no tc_tid_to_c_tag arm and falls through
    // to "Void" there. Fail closed: an unhandled kind is not identity.
    false
}

// The struct/enum arm, shared by both positions because both spell an instance through
// tc_tid_struct_mono_name: head tag + `_`-joined per-slot segs, where each slot seg comes
// from tc_tid_struct_slot_seg → tc_tid_to_c_tag, i.e. the TOP-LEVEL rules. So
// `Box[Set[Int]]` spells Box_Set and is non-injective through its slot.
fn tc_tid_struct_seg_injective(t: TypePoolEntry) -> Bool {
    if t.params_count == 0 {
        // A bare head. For a monomorphic type the name IS the identity. For a GENERIC base
        // reaching here with zero recorded args the same spelling drops every argument —
        // the nss31w erased-bare-head shape — so refuse it, but only on POSITIVE proof
        // from the decl: ty_pool cannot tell the two apart on its own, and a decl the
        // checker never registered (a miss) must not silently condemn every plain struct
        // arg. This is the one branch whose answer is registry-dependent rather than
        // kind-dependent; the erased-bare-head class is separately visible as
        // tc_tid_struct_mono_name returning "" (which every mono tier already treats as
        // "defer to the string path").
        let decl = tc_struct_decl_nodes.get(strip_module_qualifier(t.name)) ?? -1
        if decl == -1 { return true }
        let tparams_sl = node_type_params(decl)
        if tparams_sl == -1 { return true }
        if sublist_length(tparams_sl) != 0 { return false }
        // A bare, non-generic head normally IS the identity — but a transparent
        // `type Alias = X` alias also takes this shape, and tc_tid_to_c_tag now spells
        // it through to X's own tag (tc_resolve_transparent_alias_name) rather than the
        // alias's bare name. If X itself erases its arguments (List/Set/Map/...), this
        // predicate must say so too, or `type IntList = List[Int]` reads as injective
        // while the tid path spells it down to the bare, non-injective "List" — the
        // exact class DECISIONS.md:343 / br qnpb2d's diff-type-injective floor exists
        // to catch, reintroduced through the one branch that didn't ask the alias table.
        let underlying = tc_resolve_transparent_alias_name(t.name)
        if underlying != -1 { return tc_tid_seg_injective(underlying) }
        return true
    }
    let mut i = 0
    while i < t.params_count {
        if !tc_tid_seg_injective(ty_param_list.get(t.params_start + i).unwrap()) { return false }
        i = i + 1
    }
    true
}

fn tc_tid_tuple_seg_injective(t: TypePoolEntry) -> Bool {
    let mut i = 0
    while i < t.params_count {
        if !tc_tid_inner_seg_injective(ty_param_list.get(t.params_start + i).unwrap()) { return false }
        i = i + 1
    }
    true
}

// The INNER-position twin, mirroring tc_tid_inner_tag rather than tc_tid_to_c_tag. The two
// spellers erase DIFFERENTLY and the difference is not cosmetic: a Map spells its key and
// value here (Option[Map[Str,Int]] → Option_Map_str_int, injective) but erases to a bare
// "Map" at the top level. List/Set/Iterator/Handle/Channel erase in BOTH positions
// (tc_tid_inner_tag falls through to tc_tid_tag_at's shared scalar fallback → "list"/"set"/…).
fn tc_tid_inner_seg_injective(tid0: Int) -> Bool {
    let tid = tc_resolve(tid0)
    if tid < 0 || tid >= ty_pool.len() { return false }
    let t = ty_pool.get(tid).unwrap()
    let k = t.kind
    if k == TyKind.Struct || k == TyKind.Enum { return tc_tid_struct_seg_injective(t) }
    if k == TyKind.Option { return tc_tid_inner_seg_injective(t.inner1) }
    if k == TyKind.Result { return tc_tid_inner_seg_injective(t.inner1) && tc_tid_inner_seg_injective(t.inner2) }
    if k == TyKind.Map { return tc_tid_inner_seg_injective(t.inner1) && tc_tid_inner_seg_injective(t.inner2) }
    if k == TyKind.Tuple { return tc_tid_tuple_seg_injective(t) }
    if k == TyKind.List || k == TyKind.Set { return false }
    if k == TyKind.Iterator || k == TyKind.Handle || k == TyKind.Channel { return false }
    // Ptr spells a bare "Ptr"/"ptr" and drops the pointee, so two different pointees collide on
    // one segment. Non-injective for the same reason List and Set are (br w13xgb).
    if k == TyKind.Ptr { return false }
    if k == TyKind.Bytes { return true }
    if k == TyKind.Typevar || k == TyKind.Unknown || k == TyKind.Void { return false }
    if k == TyKind.Int || k == TyKind.Float || k == TyKind.Bool || k == TyKind.Str || k == TyKind.Char { return true }
    if k == TyKind.I8 || k == TyKind.I16 || k == TyKind.I32 { return true }
    if k == TyKind.U8 || k == TyKind.U16 || k == TyKind.U32 || k == TyKind.U64 { return true }
    false
}

// A tuple is encodable iff every element's tc_tid_inner_tag is byte-identical to
// the string path's per-element tag. This slice deliberately allows only the
// element shapes PROVEN identical, deferring the rest:
//   - scalars (int/float/str/bool/sized-ints/char)   → same lowercase tag
//   - List / Set / Bytes                             → tc_tid_inner_tag erases to
//                                                       bare list/set/bytes, same
//                                                       as resolve_tuple_ann
//   - nested tuple over safe elements                → tc_tid_tuple_tag recurses
//                                                       to Tuple{n}_...; the mono
//                                                       binding matches the tuple's
//                                                       registered carrier name
//                                                       (verified byte-equal by A/B
//                                                       for value-constructed args).
//                                                       (A nested tuple in a `let`
//                                                       TYPE ANNOTATION is a separate
//                                                       pre-existing codegen crash,
//                                                       br 5103fm — orthogonal here.)
// Admitted (in addition to the scalars/List/Set/Bytes/nested-tuple above):
//   - struct/enum : a BARE struct/enum, or a struct INSTANCE, is byte-identical
//                   (tc_tid_inner_tag → c_type_tag_for_struct / tc_tid_struct_mono_name
//                   == resolve_tuple_ann's element tag, both physical, both module-
//                   qualified — br bwyfy1 B3 / 637sy9). Only an ENUM INSTANCE
//                   (params_count>=1) DEFERS (tc_tid_struct_mono_name is STRUCT-only).
//   - Option/Result with a SCALAR inner (br anaqc3): tc_tid_inner_tag spells
//                   Option_<scalar> / Result_<scalar>_<scalar>, byte-identical to
//                   both the value path (emit_tuple_lit) and the annotation path
//                   (resolve_tuple_ann). Result needs BOTH inners scalar. List/Map/
//                   struct/nested-compound inners still DEFER (below).
//   - Map with SCALAR key AND value (br 6kqgnp): tc_tid_inner_tag spells
//                   Map_<scalar>_<scalar>, now byte-identical to the value path
//                   (emit_tuple_lit's CT_MAP arm reads the map's key/val) and the
//                   annotation path (compound_name_from_ann → Map_{key}_{val}). A
//                   Map with a non-scalar inner, or a Map NESTED inside an
//                   Option/Result carrier, still DEFERS (the Option/Result arms
//                   require a scalar inner).
// Deferred (string path stays authoritative — the two tags DIVERGE):
//   - enum INSTANCE: tc_tid_struct_mono_name is STRUCT-only, so the encoder would
//                   erase the args to the bare head (latent — generic enums aren't
//                   constructible today; mirrors the tc_tid_tuple_elem_faithful arm).
//   - Option/Result with a List/Map/struct/nested-compound inner: tc_tid_inner_tag
//                   has no List/Set/Bytes arm (erases to bare list/set/bytes) and
//                   spells Map/struct/nested inners differently from the
//                   value-constructed string path (Option[List[Int]] tid → bare
//                   "list" vs string path's kept element).
//   - typevar/unknown: no concrete binding yet.
pub fn tc_tid_tuple_elem_faithful(tid: Int) -> Bool {
    if tid < 0 || tid >= ty_pool.len() { return false }
    let t = ty_pool.get(tid).unwrap()
    let k = t.kind
    if k == TyKind.Tuple {
        let start = t.params_start
        let count = t.params_count
        let mut i = 0
        while i < count {
            if !tc_tid_tuple_elem_faithful(ty_param_list.get(start + i).unwrap()) { return false }
            i = i + 1
        }
        return true
    }
    if k == TyKind.List || k == TyKind.Set || k == TyKind.Bytes { return true }
    if k == TyKind.Int || k == TyKind.Float || k == TyKind.Bool || k == TyKind.Str || k == TyKind.Char { return true }
    if k == TyKind.I8 || k == TyKind.I16 || k == TyKind.I32 { return true }
    if k == TyKind.U8 || k == TyKind.U16 || k == TyKind.U32 || k == TyKind.U64 { return true }
    // Option/Result tuple element (br anaqc3 admitted SCALAR inners; br 9myrp2 widened
    // to List/Set/Bytes inners; br yavhwc widened to Map + nested Option/Result inners):
    // tc_tid_inner_tag spells Option_<inner> / Result_<i1>_<i2>, byte-identical to the
    // annotation path (resolve_tuple_ann → compound_name_from_ann → resolve_ann_tag) AND
    // the value path (emit_tuple_lit's CT_OPTION/CT_RESULT arms) whenever every inner is
    // tc_tid_inner_tag_faithful. Since br yavhwc made emit_tuple_lit recurse the element
    // tid via the SAME tc_tid_inner_tag, "faithful" now covers a Map inner
    // (Option[Map[Str,Int]] → Option_Map_str_int) and a nested Option/Result inner
    // (Option[Option[Int]] → Option_Option_int) whose own leaves are faithful.
    //
    // Both arms delegate to tc_tid_inner_tag_faithful for their inners. br e3js70 removed
    // the Result-Map carve-out: a Result[Map,_] value carrier is now spelled STRUCTURED
    // (Result_Map_str_int_int) by the construction/param/reassignment speller — identical
    // C layout to the bare "map" it replaced (uniform blink_map* member), so assignment
    // stays legal AND it matches the tid path — so both the top-level Result arm here and
    // the nested case (via the predicate's TyKind.Result branch) ride.
    // Still DEFERS: a struct/enum leaf anywhere in the inner (tc_tid_inner_tag routes
    // through c_type_tag_for_struct / tc_tid_struct_mono_name vs the annotation path's
    // mono_name_from_ann — not proven byte-equal at THIS seam specifically; 295z9x
    // reconciled the sibling value-path bugs it was filed for, but didn't reconcile
    // this one, which stays open as its own follow-up), as does a tuple inner.
    if k == TyKind.Option { return tc_tid_inner_tag_faithful(t.inner1) }
    if k == TyKind.Result {
        return tc_tid_inner_tag_faithful(t.inner1) && tc_tid_inner_tag_faithful(t.inner2)
    }
    // Top-level Map tuple element with SCALAR key AND value (br 6kqgnp): tc_tid_inner_tag
    // spells Map_<scalar>_<scalar>, byte-identical to the value path (emit_tuple_lit's
    // CT_MAP arm) and the annotation path (compound_name_from_ann → Map_{key}_{val}).
    // Scalar inners only — a struct/compound inner would spell via tc_tid_struct_mono_name
    // here vs canonical_struct_tag on the value/annotation side and could diverge (mirrors
    // tc_tid_compound_slot_faithful's Map arm and the Option/Result scalar/compound gate above).
    if k == TyKind.Map { return tc_tid_scalar_only(t.inner1) && tc_tid_scalar_only(t.inner2) }
    // A BARE (monomorphic) struct/enum tuple element: tc_tid_inner_tag spells it via
    // c_type_tag_for_struct (physical prefix), byte-identical to resolve_tuple_ann's
    // struct-element tag for BOTH same-module and cross-module names (br bwyfy1 B3;
    // this guard never gated on the module qualifier). A STRUCT INSTANCE
    // (params_count>=1) is now also byte-equal: tc_tid_inner_tag →
    // tc_tid_struct_mono_name spells the full mono stem PHYSICALLY (post-q4etvt), and
    // resolve_tuple_ann's element arm recovers the same mono stem via
    // mono_name_from_ann (br 637sy9, CLOSED) instead of erasing to the bare head — the
    // wzv72h fixed-point gate proves it (test_637sy9_*). An ENUM INSTANCE
    // (TyKind.Enum, params_count>=1) is now ADMITTED too (br 82ajft / dbzy4r):
    // tc_tid_struct_mono_name was widened for TyKind.Enum in jjhnf3 (c_type_tag_for_struct
    // base + kind-agnostic slot segs), so it spells the same full mono stem
    // (Tree_Int) that resolve_tuple_ann's element arm recovers via mono_name_from_ann
    // — the enum twin of the struct-instance case above.
    if k == TyKind.Struct || k == TyKind.Enum { return true }
    // A genuine Void TUPLE ELEMENT is now ADMITTED (br dq15j7) — the last of the four
    // sibling gates to do so, and the emitter gap that forced the deliberate refusal below
    // for so long is fixed: emit_tuple_typedef (codegen_types.bl:5622) now spells a scalar
    // element through c_field_type_str(et, name) instead of the bare c_type_str(et), keyed
    // on a resolved NAME threaded through TupleEntry's new elem_names field
    // (codegen_types.bl:1312-1317) from all three registration sites (ensure_tuple_type,
    // resolve_tuple_ann, tid_tuple_elem_enc/ensure_tuple_carrier_from_tid) — the same
    // NAME-keyed mechanism a named struct/enum Void field already used
    // (c_field_type_str is keyed on the literal name "Void", not on CT_VOID, precisely so
    // an ERASED element — type_from_name collapses "" and every unknown name onto CT_VOID
    // too — keeps failing loudly instead of silently becoming a well-typed int64_t field).
    //
    // Admitting it here is correct in principle regardless of the emitter state: Void is
    // "an ordinary INHABITED, encodable type" (decisions/under-determined-types.md:39, 6-0).
    // tc_tid_ct maps TyKind.Void onto CT_VOID and then to -1 (:10677) — CT alone cannot
    // distinguish a genuine Void from an unsolved metavariable — so this checks the KIND
    // directly, mirroring tc_struct_slot_encodable's TyKind.Void arm above (:11797).
    if k == TyKind.Void { return true }
    // A kind with no arm above (TyKind.Typevar, TyKind.Unknown, TyKind.Fn): E0301 forecloses an
    // unsolved metavar before codegen reaches this gate, so this refusal exists for
    // defense in depth and for kinds with genuinely no tuple-element spelling.
    voidtwin_probe("tuple_elem", tid)
    false
}

// A binding tid resolves to a concrete CSV segment only when tc_tid_to_c_tag can
// encode it byte-identically to the string-tag path; otherwise defer (None), and
// the hybrid in emit_generic_fn_call_tail falls back to infer_fn_type_args_from_
// types for that call.
pub fn tc_seg_from_tid(tid: Int) -> Option[Str] {
    if !tc_tid_encodable(tid) { return None }
    Some(tc_tid_to_c_tag(tid))
}

// STRUCTURAL type equality over two tids: same kind, same nominal name where the name is
// load-bearing, same inners, same type-args element-wise.
//
// tid INEQUALITY IS NOT ALWAYS TYPE INEQUALITY, even after ty_pool interning (br v76b0b):
// make_*_type now interns canonically-constructed compounds behind ty_intern (see the
// comment above `new_type`), so two calls with the same (kind, name, inners, args) share
// one tid — closing the corpus's measured same-type conflict population. What interning
// does NOT close: a compound built over a metavar that is later BOUND is not re-keyed, so
// `Option[alpha]` interned before `alpha := Int` binds remains a separate tid from a
// fresh `make_option_type(TYPE_INT)` call (needs tid-forwarding, not yet built — br
// v76b0b Stage 4 follow-up). So `a == b` is still a sound but INCOMPLETE test of type
// equality. Anything that wants a complete answer must still ask STRUCTURALLY — never by
// comparing the erasing mono-CSV spellings (tc_tid_to_c_tag drops a container's element,
// so Set[Int] and Set[Str] both spell "Set").
//
// Deliberately conservative on the two axes where a wrong answer misleads:
//   - the nominal name is compared only for TyKind.Struct / TyKind.Enum / TyKind.Typevar, the kinds
//     where it distinguishes types. Every other kind's head is fixed by the kind itself,
//     and make_*_type's `name` for those is decorative — comparing it would report a
//     spurious difference for two spellings of one type.
//   - a metavar is resolved first (a pinned α is its solution), and an out-of-range tid
//     answers false: unknown provenance is never reported as sameness.
pub fn tc_tid_same_type(a0: Int, b0: Int) -> Bool {
    let a = tc_resolve(a0)
    let b = tc_resolve(b0)
    if a == b { return a >= 0 && a < ty_pool.len() }
    if a < 0 || a >= ty_pool.len() { return false }
    if b < 0 || b >= ty_pool.len() { return false }
    let ta = ty_pool.get(a).unwrap()
    let tb = ty_pool.get(b).unwrap()
    if ta.kind != tb.kind { return false }
    let k = ta.kind
    if k == TyKind.Struct || k == TyKind.Enum || k == TyKind.Typevar {
        if ta.name != tb.name { return false }
    }
    if (ta.inner1 < 0) != (tb.inner1 < 0) { return false }
    if (ta.inner2 < 0) != (tb.inner2 < 0) { return false }
    if ta.inner1 >= 0 && !tc_tid_same_type(ta.inner1, tb.inner1) { return false }
    if ta.inner2 >= 0 && !tc_tid_same_type(ta.inner2, tb.inner2) { return false }
    if ta.params_count != tb.params_count { return false }
    let mut i = 0
    while i < ta.params_count {
        let pa = ty_param_list.get(ta.params_start + i).unwrap()
        let pb = ty_param_list.get(tb.params_start + i).unwrap()
        if !tc_tid_same_type(pa, pb) { return false }
        i = i + 1
    }
    true
}

// Triage the slot contradictions merge_arg_tids recorded (br xskbvh). Drained once at the
// end of generate(), which is why the buffer exists at all: the detector lives in
// codegen_types, BELOW typecheck in the DAG, and must stay pure — it can see that two
// concrete tids disagree but not whether they MEAN different things.
//
// The split is the whole point. `same_type` was, before br v76b0b, the ty_pool
// non-interning artefact and the MAJORITY of the corpus population; ty_pool now interns
// canonically-constructed compounds (see the ty_intern_* helpers above `new_type`), so
// that population is driven toward 0. The residual `same_type` hits are the accepted
// incompleteness: a compound built over a metavar that later binds is not re-keyed, so
// two handles can still denote one type. Either handle still lowers identically, so this
// remains harmless even once the tid is authoritative.
// `diff_type` is one (base, args) key that genuinely collapsed two different types; a
// single stored tid cannot be per-instantiation identity for all of them, which is exactly
// what br qnpb2d must not assume it can read.
//
// Spelling is read HERE, after all emission, not at conflict time. Deliberate: pins mutate
// ty_pool in place and only ever make a type MORE resolved, so classifying late can only
// turn a "both render as ?" false SAMEness into the real difference — the direction that
// loses no findings.
pub fn tc_classify_mono_conflicts() {
    let mut i = 0
    while i < mono_slot_conflicts.len() {
        let c = mono_slot_conflicts.get(i).unwrap()
        let same = tc_tid_same_type(c.stored, c.incoming)
        // A DIFF-TYPE row is only a DECISIONS.md:343 violation when BOTH segments name
        // their own type arguments. If either erases (Set/Map/List/... at a collapsing
        // position), one C symbol genuinely serves both and sharing the entry is correct.
        let injective = !same && tc_tid_seg_injective(c.stored) && tc_tid_seg_injective(c.incoming)
        if same {
            mono_slot_conflicts_same_type = mono_slot_conflicts_same_type + 1
        } else {
            mono_slot_conflicts_diff_type = mono_slot_conflicts_diff_type + 1
            if injective {
                mono_slot_conflicts_diff_type_injective = mono_slot_conflicts_diff_type_injective + 1
            }
        }
        if dbg_channel_on("monodedup") != 0 {
            let verdict = if same { "same-type" } else { "DIFF-TYPE" }
            // `class` is only meaningful on a DIFF-TYPE row; a same-type row is neither.
            let cls = if same { "n/a" } else { if injective { "VIOLATION" } else { "excusable" } }
            dbg_trace("monodedup", "slot-conflict-class base={c.base} args={c.args} slot={c.slot} verdict={verdict} class={cls} stored={c.stored}:{tc_type_str(c.stored)} incoming={c.incoming}:{tc_type_str(c.incoming)}")
        }
        i = i + 1
    }
    mono_slot_conflicts = []
}

// Whether a struct type-arg SLOT tid is one tc_tid_to_c_tag can spell at all — the
// slot-tid analogue of tc_tid_encodable, kept SEPARATE rather than folded into it
// (br qerbc7 triage) because the two predicates deliberately diverge on two axes:
// this one does NOT tc_resolve a bound-but-unsolved metavar (so a raw slot reads
// back TyKind.Unknown and is refused even when its resolution is concrete — 9 of its
// 10 call sites rely on that), and it admits TyKind.Map/TyKind.Set/TyKind.List unconditionally
// where tc_tid_encodable recurses. Before br 3fc3pn deleted the string mono-CSV
// producer, this predicate's contract was framed as byte-matching that producer's
// stored segment (`nth_type_arg(mi.args, ei)`); since then the tid path is sole
// authority, so each arm below is a decision about what the mono registry may key
// on, not a parity check against a twin that no longer exists.
//   - scalars (int/float/str/bool/sized-ints/char) admit unconditionally.
//   - a BARE (params_count 0) struct/enum admits regardless of module qualifier
//     (br q4etvt): tc_tid_to_c_tag spells it via strip_module_qualifier, and the
//     mono registrar's physical c_name agrees.
//   - a STRUCT INSTANCE slot (params_count>=1, `Box[Box[Int]]`) admits (br bwyfy1
//     B4): tc_tid_to_c_tag recurses via tc_tid_struct_mono_name to the full mono
//     stem (Box_Int), the same name register_mono_instance mints — closing the -1
//     hole so arg_tids can key the mono dedup (br 16z0s1).
//   - an ENUM INSTANCE (params_count>=1) admits too (br 82ajft/dbzy4r) — see the
//     TyKind.Struct|TyKind.Enum branch's own comment below.
//   - Option/Result over encodable inners, Tuple (tc_tid_tuple_elem_faithful), Map,
//     and Set all admit (br kffj8d): tc_tid_to_c_tag spells each via the tid tier's
//     one speller ("Option_int" / "Result_int_str" / "Tuple2_int_int" / bare
//     "Map"/"Set"), so carrying the real tid keys the mono dedup without changing
//     emitted C. Each shape's inner gate mirrors tc_tid_encodable's own arm. See
//     the per-shape arms below.
// Everything else refuses (return false):
//   - typevar/unknown — no concrete binding.
pub fn tc_struct_slot_encodable(tid: Int) -> Bool {
    if tid < 0 || tid >= ty_pool.len() { return false }
    let t = ty_pool.get(tid).unwrap()
    let k = t.kind
    if k == TyKind.Int || k == TyKind.Float || k == TyKind.Bool || k == TyKind.Str || k == TyKind.Char { return true }
    if k == TyKind.I8 || k == TyKind.I16 || k == TyKind.I32 { return true }
    if k == TyKind.U8 || k == TyKind.U16 || k == TyKind.U32 || k == TyKind.U64 { return true }
    // An ENUM INSTANCE (TyKind.Enum, params_count>=1) is now ADMITTED (br 82ajft / dbzy4r):
    // tc_tid_struct_mono_name was widened for TyKind.Enum in jjhnf3, so the encoder spells
    // its full mono stem (Tree_Int) rather than erasing to the bare head — the enum
    // twin of the struct-instance slot admitted below. (A poly-impl wrapper,
    // tc_poly_elem_slot_encodable, used to further restrict this to BARE unqualified
    // names for the poly-impl element path; br 3fc3pn deleted it along with the string
    // CSV twin it existed to byte-match, so that path now shares this rule.)
    // A struct/enum slot is admitted regardless of module qualifier (br q4etvt): the
    // mono-registry physical-base split makes both paths spell a cross-module slot
    // the SAME — a bare cross-module struct's segment is bare on both (tc_tid_to_c_tag
    // → strip_module_qualifier == the string path's bare arg segment), and a
    // cross-module struct INSTANCE's segment is PHYSICAL on both (tc_tid_struct_mono_name
    // == register_mono_instance's physical c_name). This is what lets a cross-module
    // instance SLOT carry a real tid so arg_tids can key the mono dedup (br 16z0s1).
    // A BARE struct/enum (params_count 0) admits unconditionally (br q4etvt, above).
    // An INSTANCE (params_count>=1) admits only when tc_tid_struct_mono_name can
    // actually spell its full recursive stem. Without this check, a still-generic
    // nested instance (Box[T] where T is this fn's own unbound typevar, one level
    // inside an outer Box[Box[T]] struct LITERAL) was admitted unconditionally on
    // the strength of the comment above ("tc_tid_to_c_tag recurses ... to the full
    // mono stem") — true only when that recursion SUCCEEDS. When it declines
    // (mono_name == ""), tc_tid_tag_at's own TyKind.Struct|TyKind.Enum arm falls back to the
    // BARE head name for every stem=="" cause, conflating "genuinely bare base" with
    // "instance failed to resolve" — so this gate would wave through a slot that
    // spells as a plain, wrong "Box" instead of declining so tid_native_struct_mono's
    // substitution retry (tc_tid_subst_mono) gets a chance to run. Also reject a bare
    // ICE_SEG_* sentinel spelling (diag_is_ice_seg) — non-"" but not a real name.
    if k == TyKind.Struct || k == TyKind.Enum {
        if t.params_count == 0 { return true }
        let name = tc_tid_struct_mono_name(tid)
        return name != "" && !diag_is_ice_seg(name)
    }
    // Compound slots (br kffj8d): a struct type-arg SLOT that is itself an
    // Option/Result over encodable inners is now ADMITTED. The string path spells the
    // slot via the SAME tc_tid_to_c_tag (tid_instance_mono_args_csv, the tid tier's one
    // speller → "Option_int" / "Result_int_str"), and the def-side reader (resolve_tparam_via_tid
    // → tc_seg_from_tid → tc_tid_to_c_tag) round-trips it byte-identically, so carrying
    // the real tid keys the mono dedup without changing emitted C. Gated on the general
    // tc_tid_encodable for the inner, exactly like tc_tid_to_c_tag's own recursion — a
    // nested typevar/unknown inner still defers. The Gen1==Gen2 fixed point is the
    // byte-equality proof; a shape that breaks it is a genuine divergence and reverts.
    if k == TyKind.Option { return tc_tid_encodable(t.inner1) }
    if k == TyKind.Result { return tc_tid_encodable(t.inner1) && tc_tid_encodable(t.inner2) }
    // A TUPLE slot (br kffj8d, test_0sh55p T=Tuple2_int_int): admitted when every
    // element is tuple-element-safe (tc_tid_tuple_elem_faithful), the same gate the general
    // tc_tid_encodable uses. tc_tid_to_c_tag spells it via tc_tid_tuple_tag
    // (Tuple2_int_int), byte-matching the struct-lit string path's registered tuple
    // carrier segment.
    if k == TyKind.Tuple { return tc_tid_tuple_elem_faithful(tid) }
    // A MAP slot (br 91j9fw, the List twin of br jw1pmb one carrier over): tc_tid_to_c_tag
    // erases Map to the bare carrier tag "Map" (no inner spelling), matching the string
    // path's bare "Map" segment — the same top-level spelling as Set/List below, admitted
    // unconditionally for the identical parity reason (a refusal here has no referent:
    // tc_tid_seg_injective already groups TyKind.Map with TyKind.Set/TyKind.List as non-injective, so
    // no inner element can ever leak into the erased "Map" symbol). Admitting the slot
    // alone is NOT the whole fix: the def-side field storage erases every Map[K,V] field
    // identically regardless of K,V, so a per-USE key/value recovery —
    // recover_map_kv_from_tid, codegen_expr.bl — is required alongside this to avoid
    // silently mis-reading a Map[Str,Point] field as the erased-default Map[Str,Int].
    if k == TyKind.Map { return true }
    // A SET slot (br kffj8d, test_kvn6w8 / test_qw7v90 T=Set): tc_tid_to_c_tag erases
    // Set to the bare carrier tag "Set", matching the string path's bare "Set" segment
    // — the twin of the Map arm above. tc_tid_encodable admits TyKind.Set unconditionally
    // (it erases to the bare carrier), so no inner gate is needed here.
    if k == TyKind.Set { return true }
    // A LIST slot (br jw1pmb): tc_tid_to_c_tag erases List to the bare carrier tag
    // "List", dropping every type argument — the same top-level spelling as Set/Map
    // above, admitted unconditionally for the identical reason. This needs a PARITY
    // ARGUMENT, not just an inner-encodable gate like Option/Result/Map/Tuple, because
    // the usual parity question ("does the tid segment byte-match what the string path
    // stored?") has no referent any more: br 3fc3pn deleted the string producer this
    // predicate's contract used to be measured against. The argument that survives is
    // representation-sharing (DECISIONS.md:343 is satisfied by ONE C symbol correctly
    // serving every element, not by per-element symbols): since the top-level spelling
    // names no type argument, no inner element can ever leak into the symbol, so an
    // inner gate here would be a refusal with NO REFERENT — there is nothing it could
    // protect that Option/Map/Tuple's inner gates protect (a leaking unencodable inner
    // spelling). tc_tid_seg_injective is already false for TyKind.List (:11344), so the
    // mono-conflict tripwire (tc_classify_mono_conflicts) already classifies the
    // resulting cross-element sharing as `excusable`, not a violation. And refusing here
    // does not make the program safe: a decline just pushes the same under-determination
    // into a codegen-only I0001 (UnsolvedTypeVarAtCodegen), which is precisely the "no
    // rule enforced only at codegen" pattern DECISIONS.md §3.1 Diagnostic Discipline
    // forbids — an I0001 catches a violation of a rule, it is never itself the rule.
    // (Admitting the slot alone is NOT the whole fix: the def-side field storage erases
    // every List[T] field identically regardless of T, so a per-USE element recovery —
    // recover_list_elem_from_tid, codegen_expr.bl — is required alongside this to avoid
    // silently mis-reading a List[Str]/[Float]/[struct] field as a List[Int].)
    if k == TyKind.List { return true }
    // A genuine Void slot is ADMITTED — same reasoning as tc_tid_tuple_elem_faithful's
    // TyKind.Void arm above (br hsgsbp): both paths spell it "Void", so this is byte-neutral,
    // and the accidental fall-through to `false` was what erased a real `Box[Void]`.
    if k == TyKind.Void { return true }
    voidtwin_probe("struct_slot", tid)
    false
}

// Resolve the CSV segment for type-arg slot `idx` of a struct-INSTANCE tid
// (`Box[Int]`, `Pair[Int,Str]` built by make_struct_instance_type). Reads the raw
// slot tid from ty_param_list — the same slot the dormant tc_tid_struct_arg_ct /
// _struct accessors read. Gates the slot on tc_struct_slot_encodable (the STRICT
// struct-slot spelling rule; NOT the general tc_tid_encodable, which would wrongly
// accept a nested struct instance / Option slot and emit a divergent symbol) before
// routing through tc_tid_to_c_tag. Yields None for a bare generic base (count 0),
// an out-of-range idx, or an unencodable slot — the caller then defers to the
// string path.
fn tc_struct_seg_from_arg(tid: Int, idx: Int) -> Option[Str] {
    let count = tc_tid_struct_arg_count(tid)
    if count == 0 { return None }
    if idx < 0 || idx >= count { return None }
    let t = ty_pool.get(tid).unwrap()
    let slot_tid = ty_param_list.get(t.params_start + idx).unwrap()
    if !tc_struct_slot_encodable(slot_tid) { return None }
    Some(tc_tid_to_c_tag(slot_tid))
}


// True when `tname` names a user-declared ENUM (first field is a TypeVariant) —
// the complement of tc_type_is_struct, used to route a generic-enum param
// (`Tree[T]`) through the same instance-tid slot read as a generic-struct param
// (br 82ajft).
fn tc_type_is_enum(tname: Str) -> Int {
    let td = tc_type_decl_nodes.get(tname) ?? -1
    if td == -1 { return 0 }
    let flds = node_fields(td)
    if flds != -1 && sublist_length(flds) > 0 {
        if node_kind(sublist_get(flds, 0)) == NodeKind.TypeVariant { return 1 }
    }
    0
}

// For a `List[( .., <param_name>, .. )]` param, the 0-based slot of the list's
// tuple ELEMENT that names `param_name` (`List[(Str, T)]` → T is slot 1), or -1
// when the list element is not a tuple / does not name the param. Reads the
// element annotation's Tuple children; the tuple annotation node's name is "Tuple".
fn tc_list_tuple_elem_slot(p: Int, param_name: Str) -> Int {
    let ta = node_type_ann(p)
    if ta == -1 { return -1 }
    let elems_sl = node_elements(ta)
    if elems_sl == -1 || sublist_length(elems_sl) < 1 { return -1 }
    let elem_ann = sublist_get(elems_sl, 0)
    if node_name(elem_ann) != "Tuple" { return -1 }
    let tup_sl = node_elements(elem_ann)
    if tup_sl == -1 { return -1 }
    let mut i = 0
    while i < sublist_length(tup_sl) {
        if node_name(sublist_get(tup_sl, i)) == param_name { return i }
        i = i + 1
    }
    -1
}

// True when param `p`'s annotation is List[<param_name>].
fn tc_list_param_elem_is(p: Int, param_name: Str) -> Bool {
    let ta = node_type_ann(p)
    if ta == -1 { return false }
    let elems_sl = node_elements(ta)
    if elems_sl == -1 || sublist_length(elems_sl) < 1 { return false }
    node_name(sublist_get(elems_sl, 0)) == param_name
}

// 1 if param `p` is Map[<param_name>, _], 2 if Map[_, <param_name>], else 0.
fn tc_map_param_binds(p: Int, param_name: Str) -> Int {
    let ta = node_type_ann(p)
    if ta == -1 { return 0 }
    let elems_sl = node_elements(ta)
    if elems_sl == -1 || sublist_length(elems_sl) < 2 { return 0 }
    if node_name(sublist_get(elems_sl, 0)) == param_name { return 1 }
    if node_name(sublist_get(elems_sl, 1)) == param_name { return 2 }
    0
}

// The 0-based type-arg slot in generic-struct param `p`'s annotation
// (`Box[T]` → 0, `Pair[A, B]` → A=0 / B=1) that names `param_name`, or -1.
// A struct can mention the param in any slot; when several do, return the LAST
// match. That rule was inherited from the while-loop last-wins in the deleted
// infer_fn_type_args_from_types' string struct branch, where a later matching slot
// overwrote `resolved`. Since br 3fc3pn there is nothing left to mirror, so last-wins
// is now this function's OWN choice — changing it changes emitted symbols directly.
fn tc_struct_param_binds(p: Int, param_name: Str) -> Int {
    let ta = node_type_ann(p)
    if ta == -1 { return -1 }
    let elems_sl = node_elements(ta)
    if elems_sl == -1 { return -1 }
    let mut which = -1
    let mut i = 0
    while i < sublist_length(elems_sl) {
        if node_name(sublist_get(elems_sl, i)) == param_name { which = i }
        i = i + 1
    }
    which
}

// 1 if param `p` is Result[<param_name>, _] / Option[<param_name>], 2 if
// Result[_, <param_name>], else 0.
fn tc_compound_param_binds(p: Int, param_name: Str) -> Int {
    let ta = node_type_ann(p)
    if ta == -1 { return 0 }
    let elems_sl = node_elements(ta)
    if elems_sl == -1 || sublist_length(elems_sl) < 1 { return 0 }
    if node_name(sublist_get(elems_sl, 0)) == param_name { return 1 }
    if sublist_length(elems_sl) >= 2 && node_name(sublist_get(elems_sl, 1)) == param_name { return 2 }
    0
}

// For a `Fn(...) -> R` param annotation: -2 if the return slot names the param,
// else the 0-based Fn-param index that names it, else -1.
fn tc_fn_param_binds(p: Int, param_name: Str) -> Int {
    let ta = node_type_ann(p)
    if ta == -1 { return -1 }
    if node_return_type(ta) == param_name { return -2 }
    let elems_sl = node_elements(ta)
    if elems_sl == -1 { return -1 }
    let mut i = 0
    while i < sublist_length(elems_sl) {
        if node_name(sublist_get(elems_sl, i)) == param_name { return i }
        i = i + 1
    }
    -1
}

// Whether a type annotation names `param_name` anywhere in its element tree.
// Distinguishes "this position mentions the type-param but the tid can't express
// it" (-> defer via None) from "this position is unrelated" (-> keep scanning).
fn tc_ann_mentions_param(ann: Int, param_name: Str) -> Bool {
    if ann == -1 { return false }
    if node_name(ann) == param_name { return true }
    let elems_sl = node_elements(ann)
    if elems_sl == -1 { return false }
    let mut i = 0
    while i < sublist_length(elems_sl) {
        if tc_ann_mentions_param(sublist_get(elems_sl, i), param_name) { return true }
        i = i + 1
    }
    false
}

// COMPLETE walk of a type annotation for a type-param name — elements AND the
// nested `type_ann` slot. Deliberately NOT tc_ann_mentions_param, which walks only
// node_elements: parser.bl builds an `Fn` annotation with its PARAMS in `elements`
// and its RETURN in `type_ann`, so the elements-only walk cannot see the `U` in
// `f: fn(T) -> U`. `Fn` is the only TypeAnn kind that stores a nested annotation
// outside `elements`, which is what makes this walk complete rather than merely
// deeper.
//
// The distinction is load-bearing and asymmetric: the two existing users of
// tc_ann_mentions_param ask "does this position mention the param, so should I
// DEFER?", where under-reporting costs only a fallback to the string path. This
// asks "is this param unconstrained by every parameter, so should I MINT?", where
// under-reporting mints an α nothing can ever bind — E0301 at every call of
// lib/std/list.bl's list_map and lib/std/map.bl's map_map_values, the only two
// functions in the repo whose type param is named solely inside an `Fn`. A row in
// tests/test_3dpshm_generic_fn_ret_only_tparam.bl fails loudly if the two are
// confused; do not merge them.
fn tc_ann_names_tparam(ann: Int, param_name: Str) -> Bool {
    if ann == -1 { return false }
    if node_name(ann) == param_name { return true }
    if tc_ann_names_tparam(node_type_ann(ann), param_name) { return true }
    let elems_sl = node_elements(ann)
    if elems_sl == -1 { return false }
    let mut i = 0
    while i < sublist_length(elems_sl) {
        if tc_ann_names_tparam(sublist_get(elems_sl, i), param_name) { return true }
        i = i + 1
    }
    false
}


// Closure-signature scalar type NAME → its canonical tid, or -1 for anything else.
// Pure (effect-free) so the Fn arm of tc_resolve_tparam_tid can lower a closure
// literal's param/return annotation name without pulling in TypeCheck.Resolve (a
// lookup_named_type fallback would force that effect virally up through tc_mono_tids).
//
// The admitted set is deliberately narrower than resolve_type_name's: ONLY the four
// scalars the STRING path can recover from a closure's C signature — ct_from_c_type
// (codegen_types.bl) maps back exactly int64_t→Int, double→Float, int→Bool,
// const char*→Str and nothing else. Restricting to that set keeps the tid seg
// BYTE-IDENTICAL to the string seg for every closure-bound slot (the D1b invariant).
// A sized-int/Char annotation renders to int8_t/…/int32_t in the C signature, which
// ct_from_c_type erases to "Void"; admitting those here would spell "I8"/"Char"
// instead, a divergence that NOTHING DOWNSTREAM WOULD CATCH. This narrowing used to be
// backed by the register-site listop_slot_tid, which vetoed any slot whose tid spelling
// diverged from the CSV segment; br fsa9gf reduced that to an encodability-only gate, so
// an "I8" slot would now be kept and mangled against a CSV that says "Void". The
// narrowing therefore stands ON ITS OWN as the alignment guarantee for closure-bound
// slots — there is no backstop behind it. Widening the admitted set means re-establishing
// alignment here, not relying on a later screen. The capture cost of staying narrow is
// still nil (a closure typed over a sized int / Char binds no target-corpus tparam).
fn tc_scalar_tid_from_name(name: Str) -> Int {
    if name == "Int" || name == "I64" { return TYPE_INT }
    if name == "Float" { return TYPE_FLOAT }
    if name == "Bool" { return TYPE_BOOL }
    if name == "Str" { return TYPE_STR }
    -1
}

// Return the concrete arg tid this type-param resolves to, or -1 when no argument
// position can supply it. Since br 3fc3pn this is the SOLE resolver: the whole mono CSV
// is rendered from the tids it produces, so "the segment" is by definition
// tc_seg_from_tid of what this returns and cannot disagree with it.
//
// It was previously the tid TWIN of a segment-producing resolver, tc_resolve_tparam_seg,
// and had to stay positionally aligned with it so a stored tid run back through
// tc_seg_from_tid reproduced that segment byte-for-byte (the D1b invariant). That twin is
// deleted — it was a strictly weaker duplicate of this ladder, never receiving
// mono-calls-mono substitution, the List[Tuple[..T..]] arm, or closure-annotation
// reading. Nothing needs alignment with it any more; the D1b framing survives here only
// as history.
//
// `binds` (typevar-name → concrete tid) resolves the mono-calls-mono case: inside a
// monomorphized body the nested generic call's arg carries its ORIGINAL memoized tid,
// which still embeds the enclosing fn's abstract typevar (`run[M]`'s body calls
// `step(initial)` with initial:M; `outer_result[T]` calls `identity(r)` with
// r:Result[T,Str]). tc_lookup_node_tid then returns a TyKind.Typevar / typevar-embedding
// tid that tc_tid_encodable rejects, leaving the slot unresolvable. Substituting the arg tid
// through the enclosing instantiation's binding (built at the codegen call site, the
// only place the M→Model / T→Int map is known) concretizes it BEFORE the arm ladder
// reads it, so every downstream arm works unchanged. An EMPTY map is a no-op
// (substitute_typevar_tid returns the tid untouched) — the direct-call path.
fn tc_resolve_tparam_tid(param_name: Str, fn_params_sl: Int, args_sl: Int, binds: Map[Str, Int]) -> Int {
    let np = sublist_length(fn_params_sl)
    let na = sublist_length(args_sl)
    let mut fi = 0
    while fi < np && fi < na {
        let p = sublist_get(fn_params_sl, fi)
        let ptype = node_type_name(p)
        let arg_node = sublist_get(args_sl, fi)
        let arg_tid = substitute_typevar_tid(tc_lookup_node_tid(arg_node), binds)
        // monotid channel: the per-slot view of type-param resolution. When arg_tid
        // is -1 here, the tid was never memoized onto arg_node — an upstream capture
        // gap, not an encodability failure. (Its old companion, the csvresolve
        // channel on the string resolver, is retired along with that resolver.)
        // Gated behind dbg_channel_on because this is the hot per-slot
        // path and the interpolated message would otherwise be built on every
        // generic-call resolution even with tracing off.
        if dbg_channel_on("monotid") != 0 {
            dbg_trace("monotid", "param={param_name} ptype={ptype} fi={fi} arg_node={arg_node} arg_tid={arg_tid}")
        }
        if ptype == param_name {
            return arg_tid
        } else if ptype == "List" {
            if arg_tid >= 0 && arg_tid < ty_pool.len() {
                let arg_ty = ty_pool.get(arg_tid).unwrap()
                if arg_ty.kind == TyKind.List && tc_list_param_elem_is(p, param_name) {
                    return arg_ty.inner1
                }
                // `List[(.., T, ..)]` — the element is a TUPLE naming the param at a
                // fixed slot (std.testing.for_each's `cases: List[(Str, T)]`). The arg's
                // element tuple tid (arg_ty.inner1) carries the concrete slot type, so
                // read the slot the annotation names. Mirrors infer_fn_type_args_from_
                // types' List→Tuple arm (codegen_types.bl:3992), which extracts the same
                // slot from the registered tuple entry. Only fires when the element tid
                // is actually a tuple of the annotation's arity; anything else falls
                // through to keep scanning (the closure param, etc.).
                let lslot = tc_list_tuple_elem_slot(p, param_name)
                if lslot >= 0 && arg_ty.kind == TyKind.List && arg_ty.inner1 >= 0 && arg_ty.inner1 < ty_pool.len() {
                    let elem_ty = ty_pool.get(arg_ty.inner1).unwrap()
                    if elem_ty.kind == TyKind.Tuple && lslot < elem_ty.params_count {
                        let slot_tid = ty_param_list.get(elem_ty.params_start + lslot).unwrap()
                        if tc_struct_slot_encodable(slot_tid) { return slot_tid }
                    }
                }
                // A `List[<nested>]` whose element mentions the param but is not the
                // bare element (`List[(Str, T)]`, `List[Box[T]]`) can't be read from
                // the flat inner1 slot. The deleted seg twin returned None here, which
                // was correct THERE only because a None aborted the all-or-nothing
                // tc_mono_csv and handed the whole call to the string walker. No such
                // walker exists now. This resolver is PER-SLOT, so a hard -1 would
                // freeze the binding at this param
                // even though a LATER param (`body: fn(T) -> Void`, the std.testing
                // for_each shape) can bind it. Fall through instead — keep scanning; if
                // no later param binds it the loop still returns -1 at the tail.
            }
        } else if ptype == "Map" {
            if arg_tid >= 0 && arg_tid < ty_pool.len() {
                let arg_ty = ty_pool.get(arg_tid).unwrap()
                if arg_ty.kind == TyKind.Map {
                    let which = tc_map_param_binds(p, param_name)
                    if which == 1 { return arg_ty.inner1 }
                    if which == 2 { return arg_ty.inner2 }
                }
            }
        } else if ptype == "Result" || ptype == "Option" {
            if arg_tid >= 0 && arg_tid < ty_pool.len() {
                let arg_ty = ty_pool.get(arg_tid).unwrap()
                if arg_ty.kind == TyKind.Result || arg_ty.kind == TyKind.Option {
                    let which = tc_compound_param_binds(p, param_name)
                    if which == 1 { return arg_ty.inner1 }
                    if which == 2 { return arg_ty.inner2 }
                }
            }
        } else if ptype == "Fn" {
            // `f: Fn(T) -> U` names a type-param in a closure position. A closure-
            // LITERAL arg carried no structured TyKind.Fn tid when this was written
            // (infer_type → TYPE_UNKNOWN — no longer true, see the br 3ejrqa note at the
            // tail of this comment), so the binding is read off the literal's own
            // annotations instead: the
            // return_type string when the param names the Fn return (tc_fn_param_binds
            // == -2), otherwise the naming Fn-param slot's declared type name. This is
            // the tid twin of the deleted infer_fn_type_args_from_types' Fn arm, which
            // derived U/T from the closure's C signature via infer_closure_ret_type /
            // infer_closure_param_type. tc_scalar_tid_from_name admits only the four
            // scalars that C-signature path could recover (Int/Float/Bool/Str), which is
            // why the narrowness is here at all — it kept the tid seg byte-identical to
            // the string seg.
            //
            // THE CONSEQUENCE OF A -1 HERE IS NOW I0001, NOT A FALLBACK. This block used
            // to say a richer param/return "defers to the string path". That was already
            // untrue before br 3fc3pn deleted the string producer — measured on the HEAD
            // binary, `fn apply[T](f: fn(Int) -> Box[T], x: Int) -> Box[T]` called with a
            // `fn(n: Int) -> Box[Int]` literal raises the SAME two ICEs before and after
            // the deletion. The tid path has been sole authority at this seam since br
            // wzv72h; nothing was consulting the string here to defer TO.
            //
            // So the narrowness is a live gap, not a safe conservatism: br 3ejrqa. Its
            // root was the same missing memo as br n8mmry symptom 2 — the closure LITERAL's
            // return annotation carried no instance tid, so this arm was reduced to reading
            // the annotation's NAME as a string. Widening tc_scalar_tid_from_name instead
            // would spell a name with no tid behind it, which is the erasure this whole seam
            // exists to prevent.
            //
            // 3ejrqa'S PRECONDITION IS NOW MET (br nz7drz). The closure literal's own node
            // tid is a real TyKind.Fn, and its return child is the INSTANCE tid, not a name:
            // measured on the 3ejrqa MVCE, the Closure arg node memoizes
            // `Fn(Int) -> Box[Int]`. So this arm can read tc_lookup_node_tid(arg_node) and
            // walk tc_tid_child, and the four-scalar restriction goes away. Left as its own
            // ticket because it needs 3ejrqa's own four-case fixture first.
            let fslot = tc_fn_param_binds(p, param_name)
            if fslot != -1 {
                if arg_node != -1 && node_kind(arg_node) == NodeKind.Closure {
                    if fslot == -2 {
                        return tc_scalar_tid_from_name(node_return_type(arg_node))
                    }
                    let cl_params = node_params(arg_node)
                    if cl_params != -1 && fslot < sublist_length(cl_params) {
                        return tc_scalar_tid_from_name(node_type_name(sublist_get(cl_params, fslot)))
                    }
                }
                return -1
            }
        } else if tc_type_is_struct(ptype) != 0 {
            if arg_tid >= 0 && arg_tid < ty_pool.len() {
                let arg_ty = ty_pool.get(arg_tid).unwrap()
                if arg_ty.kind == TyKind.Struct && tc_tid_struct_arg_count(arg_tid) >= 1 && strip_module_qualifier(arg_ty.name) == ptype {
                    let slot = tc_struct_param_binds(p, param_name)
                    if slot >= 0 && slot < tc_tid_struct_arg_count(arg_tid) {
                        let slot_tid = ty_param_list.get(ty_pool.get(arg_tid).unwrap().params_start + slot).unwrap()
                        if tc_struct_slot_encodable(slot_tid) { return slot_tid }
                    }
                }
            }
            if tc_ann_mentions_param(node_type_ann(p), param_name) {
                return -1
            }
        } else if tc_type_is_enum(ptype) != 0 {
            // br 82ajft: generic-enum param tid twin of the struct arm — read the
            // named slot's concrete tid off the arg's enum INSTANCE tid (TyKind.Enum), so
            // the def-side mono emitter re-derives blink_Tree_Int from the structured
            // tid rather than the "Void"-filled CSV.
            if arg_tid >= 0 && arg_tid < ty_pool.len() {
                let arg_ty = ty_pool.get(arg_tid).unwrap()
                if arg_ty.kind == TyKind.Enum && tc_tid_struct_arg_count(arg_tid) >= 1 && strip_module_qualifier(arg_ty.name) == ptype {
                    let slot = tc_struct_param_binds(p, param_name)
                    if slot >= 0 && slot < tc_tid_struct_arg_count(arg_tid) {
                        let slot_tid = ty_param_list.get(ty_pool.get(arg_tid).unwrap().params_start + slot).unwrap()
                        if tc_struct_slot_encodable(slot_tid) { return slot_tid }
                    }
                }
            }
            if tc_ann_mentions_param(node_type_ann(p), param_name) {
                return -1
            }
        }
        fi = fi + 1
    }
    -1
}

// The per-type-param concrete tids, and since br 3fc3pn the ORIGIN of the mono CSV
// rather than something parallel to it: codegen renders the CSV from this list via
// mono_csv_from_arg_tids, so each entry's tc_seg_from_tid IS the segment. An entry is -1
// where no argument position could supply the param, which renders as
// ICE_SEG_ERASED_SLOT and is caught at the I0001 chokepoints. (It formerly ran parallel
// to tc_mono_csv's independently-walked segments and was meaningful only when that
// returned Some; both that function and the string walker it chose between are gone.)
// Stored
// on the mono registry (arg_tids) so the def-side emitters can re-derive that
// slot from the structured tid instead of re-parsing the CSV string.
//
// mono-calls-mono variant: the same per-tparam derivation, but with the enclosing
// instantiation's typevar bindings applied to each nested-call arg tid before the
// arm ladder reads it (see tc_resolve_tparam_tid). `mono_tparams_sl` are the
// ENCLOSING generic fn's type-param nodes and `mono_arg_tids` its concrete per-
// tparam tids (cg_mono_tparams_sl / cg_mono_arg_tids at the codegen call site);
// paired by position into the name→tid map. A -1 or out-of-range enclosing tid is
// simply not inserted, so an un-captured enclosing slot leaves that typevar
// abstract and the nested slot stays on the string path (never a wrong bind).
pub fn tc_mono_tids_subst(call_node: Int, fn_node: Int, mono_tparams_sl: Int, mono_arg_tids: List[Int]) -> List[Int] {
    tc_mono_tids_core(call_node, fn_node, tc_mono_binds_map(mono_tparams_sl, mono_arg_tids))
}

fn tc_mono_tids_core(call_node: Int, fn_node: Int, binds: Map[Str, Int]) -> List[Int] {
    let mut tids: List[Int] = []
    let tparams_sl = node_type_params(fn_node)
    if tparams_sl == -1 { return tids }
    let num_params = sublist_length(tparams_sl)
    if num_params == 0 { return tids }
    let fn_params_sl = node_params(fn_node)
    if fn_params_sl == -1 { return tids }
    let args_sl = node_args(call_node)
    if args_sl == -1 { return tids }
    let mut pi = 0
    while pi < num_params {
        let param_name = node_name(sublist_get(tparams_sl, pi))
        let mut tid = tc_resolve_tparam_tid(param_name, fn_params_sl, args_sl, binds)
        // -1 is this function's "no argument position could supply it" — what the deleted
        // tc_mono_csv spelled as a Some("") fall-through, and the same seam a return-only
        // type param falls through (3dpshm). Substitute the call site's solved α so the
        // registered mono instance carries the concrete inner tid every def-side
        // arg_tids consumer reads, rather than -1 (which drops the slot to the erasing
        // string path). Only where the argument path already gave up.
        if tid < 0 {
            let m = tc_ret_mint_at(call_node, num_params, pi)
            if m >= 0 && tc_tid_encodable(m) { tid = m }
        }
        tids.push(tid)
        pi = pi + 1
    }
    tids
}
