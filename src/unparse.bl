// The source text of an expression, rebuilt from its node.
//
// A failing assert reports the condition the way the programmer wrote it --
// `assertion failed: x > 2`. Nothing after the parser keeps that text, so it is rebuilt
// here. This module reads the node pool and nothing else: no types, no IR, no emitter,
// because what a program says is a property of what was written, not of what it compiles
// to.
//
// Parentheses are rebuilt from precedence rather than remembered, because the parser
// keeps no grouping node. A pair the precedence already implies is therefore not written
// back: `1 + (2 * 3)` reads out as `1 + 2 * 3`, which is what a released build prints.
//
// A kind with no rendering refuses. Text invented for a failure message would read as
// though the programmer had written it, and there is nothing in the message to say
// otherwise.

import std.str.{str_from_code_point}
import ast.{NodeKind, nk_of, node_kind_name}
import parser.{
    is_literal_string_part, node_args, node_body, node_elements, node_fields, node_index,
    node_int_val, node_is_mut, node_kind, node_left, node_method, node_name, node_obj,
    node_op, node_params, node_return_type, node_right, node_stmts, node_str_val,
    node_type_name, node_value, sublist_get, sublist_length, node_type_ann, node_type_params,
    int_op_group, int_operand_needs_parens, type_ann_is_unit,
}
import diagnostics.{diag_ice_at, ICE_SEG_NO_SOURCE_TEXT, NO_SOURCE_TEXT_FOR_EXPR}

// Binding strength, in the order parse_expr descends. Higher binds tighter. An operand
// whose own strength is below what its position requires gets a pair of parentheses. The
// integer operators of §2.19 share one level, with `* / %` above `+ -`, and
// int_operand_needs_parens adds the pairs their groups need.
const PREC_COALESCE = 1
const PREC_OR = 2
const PREC_AND = 3
const PREC_EQUALITY = 4
const PREC_COMPARISON = 5
const PREC_INT_OPS = 6
const PREC_MULTIPLICATIVE = 7
const PREC_UNARY = 8
const PREC_POSTFIX = 9
const PREC_ATOM = 10

pub fn unparse_expr(node: Int) -> Str ! Diag.Report {
    unparse_at(node, 0)
}

fn unparse_at(node: Int, min_prec: Int) -> Str ! Diag.Report {
    let text = unparse_bare(node)
    if prec_of(node) < min_prec { return "({text})" }
    text
}

fn binop_prec(op: Str) -> Int {
    if op == "??" { return PREC_COALESCE }
    if op == "||" { return PREC_OR }
    if op == "&&" { return PREC_AND }
    if op == "==" || op == "!=" { return PREC_EQUALITY }
    if op == "<" || op == ">" || op == "<=" || op == ">=" { return PREC_COMPARISON }
    if op == "*" || op == "/" || op == "%" { return PREC_MULTIPLICATIVE }
    if int_op_group(op) != 0 { return PREC_INT_OPS }
    // An operator the table does not name is parenthesised rather than run together with
    // its neighbours, because a wrong grouping reads as a different condition.
    PREC_COALESCE
}

fn prec_of(node: Int) -> Int {
    match nk_of(node_kind(node)) {
        NodeKind.BinOp => binop_prec(node_op(node))
        NodeKind.UnaryOp => PREC_UNARY
        NodeKind.Call => PREC_POSTFIX
        NodeKind.MethodCall => PREC_POSTFIX
        NodeKind.FieldAccess => PREC_POSTFIX
        NodeKind.IndexExpr => PREC_POSTFIX
        _ => PREC_ATOM
    }
}

fn unparse_bare(node: Int) -> Str ! Diag.Report {
    match nk_of(node_kind(node)) {
        NodeKind.IntLit => node_str_val(node)
        NodeKind.FloatLit => node_str_val(node)
        NodeKind.CharLit => char_text(node)
        NodeKind.BoolLit => bool_text(node)
        NodeKind.Ident => node_name(node)
        NodeKind.InterpString => interp_text(node)
        NodeKind.BinOp => binop_text(node)
        NodeKind.UnaryOp => "{node_op(node)}{unparse_at(node_left(node), PREC_UNARY)}"
        NodeKind.Call => "{unparse_at(node_left(node), PREC_POSTFIX)}{call_type_args_text(node)}({arg_text(node_args(node))})"
        NodeKind.MethodCall => method_text(node)
        NodeKind.FieldAccess => "{unparse_at(node_obj(node), PREC_POSTFIX)}.{node_name(node)}"
        NodeKind.IndexExpr => "{unparse_at(node_obj(node), PREC_POSTFIX)}[{unparse_expr(node_index(node))}]"
        NodeKind.TupleLit => tuple_text(node)
        NodeKind.ListLit => "[{arg_text(node_elements(node))}]"
        NodeKind.StructLit => struct_text(node)
        NodeKind.Closure => closure_text(node)
        NodeKind.SpreadExpr => "..{unparse_expr(node_value(node))}"
        NodeKind.NamedArg => "{node_name(node)}: {unparse_expr(node_value(node))}"
        _ => refuse(node)
    }
}

// The lexer keeps a character literal as its code point, so the character itself is put
// back. The escapes are the ones a reader would otherwise see as whitespace in the middle
// of a failure message.
fn char_text(node: Int) -> Str {
    let code = node_str_val(node).to_int()
    if code == 92 { return "'\\\\'" }
    if code == 39 { return "'\\''" }
    if code == 10 { return "'\\n'" }
    if code == 9 { return "'\\t'" }
    if code == 13 { return "'\\r'" }
    "'{str_from_code_point(code)}'"
}

fn bool_text(node: Int) -> Str {
    if node_int_val(node) != 0 { "true" } else { "false" }
}

// Both operands sit at the operator's own strength on the left and one above it on the
// right. Every binary level in the parser is left-associative, so that single rule is
// what keeps `1 - 2 - 3` bare and puts a pair around `1 - (2 - 3)`.
fn binop_text(node: Int) -> Str ! Diag.Report {
    let op = node_op(node)
    let p = binop_prec(op)
    let lhs = operand_text(node_left(node), op, p)
    let rhs = operand_text(node_right(node), op, p + 1)
    "{lhs} {op} {rhs}"
}

fn operand_text(child: Int, parent_op: Str, min_prec: Int) -> Str ! Diag.Report {
    if nk_of(node_kind(child)) == NodeKind.BinOp && int_operand_needs_parens(node_op(child), parent_op) {
        return "({unparse_bare(child)})"
    }
    unparse_at(child, min_prec)
}

fn method_text(node: Int) -> Str ! Diag.Report {
    let recv = unparse_at(node_obj(node), PREC_POSTFIX)
    "{recv}.{node_method(node)}{call_type_args_text(node)}({arg_text(node_args(node))})"
}

fn arg_text(args: Int) -> Str ! Diag.Report {
    if args == -1 { return "" }
    let mut out = ""
    let mut i = 0
    while i < sublist_length(args) {
        if i > 0 { out = "{out}, " }
        out = "{out}{unparse_expr(sublist_get(args, i))}"
        i = i + 1
    }
    out
}

// A one-element tuple keeps its trailing comma: without it, `(x,)` would read back as
// the parenthesised expression `x` instead of a tuple.
fn tuple_text(node: Int) -> Str ! Diag.Report {
    let elems = node_elements(node)
    if elems == -1 { return "()" }
    if sublist_length(elems) == 1 {
        return "({unparse_expr(sublist_get(elems, 0))},)"
    }
    "({arg_text(elems)})"
}

fn struct_text(node: Int) -> Str ! Diag.Report {
    let tname = node_type_name(node)
    let flds = node_fields(node)
    let mut out = "{tname} \{ "
    if flds != -1 {
        let mut i = 0
        while i < sublist_length(flds) {
            if i > 0 { out = "{out}, " }
            let fld = sublist_get(flds, i)
            if nk_of(node_kind(fld)) == NodeKind.SpreadExpr {
                out = "{out}{unparse_expr(fld)}"
            } else {
                out = "{out}{node_name(fld)}: {unparse_expr(node_value(fld))}"
            }
            i = i + 1
        }
    }
    "{out} }"
}

fn closure_text(node: Int) -> Str ! Diag.Report {
    let params = node_params(node)
    let mut out = "fn("
    if params != -1 {
        let mut i = 0
        while i < sublist_length(params) {
            if i > 0 { out = "{out}, " }
            out = "{out}{param_text(sublist_get(params, i))}"
            i = i + 1
        }
    }
    out = "{out})"
    let ret_ann = node_type_ann(node)
    if ret_ann != -1 { out = "{out} -> {type_ann_text(ret_ann)}" }
    "{out} {closure_body_text(node, node_body(node))}"
}

fn param_text(node: Int) -> Str ! Diag.Report {
    let mut out = ""
    if node_is_mut(node) != 0 { out = "mut " }
    out = "{out}{node_name(node)}"
    let tann = node_type_ann(node)
    if tann != -1 { out = "{out}: {type_ann_text(tann)}" }
    let dflt = node_value(node)
    if dflt != -1 { out = "{out} = {unparse_expr(dflt)}" }
    out
}

// Only a single-statement body is rebuilt: a bare tail expression or an explicit
// return, the two shapes a one-line closure actually has. Anything more refuses
// rather than inventing a multi-line rendering the closure was never written as.
fn closure_body_text(closure: Int, body: Int) -> Str ! Diag.Report {
    let stmts = node_stmts(body)
    if stmts == -1 || sublist_length(stmts) == 0 { return "\{}" }
    if sublist_length(stmts) == 1 {
        let stmt = sublist_get(stmts, 0)
        let sk = nk_of(node_kind(stmt))
        if sk == NodeKind.ExprStmt {
            return "\{ {unparse_expr(node_value(stmt))} }"
        }
        if sk == NodeKind.Return {
            let val = node_value(stmt)
            if val != -1 { return "\{ return {unparse_expr(val)} }" }
            return "\{ return }"
        }
    }
    refuse(closure)
}

// The lexer hands back a decoded string part, so what it decoded is put back before the
// text is quoted again. A brace is in that set: an unescaped one would reopen a hole.
fn interp_text(node: Int) -> Str ! Diag.Report {
    let parts = node_elements(node)
    let mut out = "\""
    if parts != -1 {
        let mut i = 0
        while i < sublist_length(parts) {
            let part = sublist_get(parts, i)
            if is_literal_string_part(part) != 0 {
                out = "{out}{escape_string_part(node_str_val(part))}"
            } else {
                out = "{out}\{{unparse_expr(part)}}"
            }
            i = i + 1
        }
    }
    "{out}\""
}

fn escape_string_part(s: Str) -> Str {
    let mut sb = StringBuilder.new()
    // Unescaped bytes are copied a run at a time: a run ends only at an ASCII byte, so it
    // never cuts a multi-byte codepoint.
    let mut run = 0
    let mut i = 0
    while i < s.byte_len() {
        let c = s.byte_at(i)
        let esc = if c == 92 {
            "\\\\"
        } else if c == 34 {
            "\\\""
        } else if c == 10 {
            "\\n"
        } else if c == 9 {
            "\\t"
        } else if c == 13 {
            "\\r"
        } else if c == 123 {
            "\\\{"
        } else {
            ""
        }
        if esc != "" {
            sb.write(s.byte_slice(run, i))
            sb.write(esc)
            run = i + 1
        }
        i = i + 1
    }
    sb.write(s.byte_slice(run, s.byte_len()))
    sb.to_str()
}

// A type annotation as written. The formatter and docgen print types with it too, so
// every place that writes a type back out spells it the same way.
pub fn type_ann_text(node: Int) -> Str {
    type_ann_text_renamed(node, Map())
}

// type_ann_text with each type name that `renames` holds spelled as its value, so a caller
// can qualify a name that the module it writes into does not select.
pub fn type_ann_text_renamed(node: Int, renames: Map[Str, Str]) -> Str {
    if node == -1 {
        return ""
    }
    let kind = node_kind(node)
    if kind != NodeKind.TypeAnn {
        return renames.get(node_name(node)) ?? node_name(node)
    }
    if type_ann_is_unit(node) {
        return "()"
    }
    let name = node_name(node)
    let elems_sl = node_elements(node)
    if name == "Fn" {
        let mut sb = StringBuilder.new()
        sb.write("fn(")
        if elems_sl != -1 {
            let mut i = 0
            while i < sublist_length(elems_sl) {
                if i > 0 {
                    sb.write(", ")
                }
                sb.write(type_ann_text_renamed(sublist_get(elems_sl, i), renames))
                i = i + 1
            }
        }
        sb.write(")")
        let ret_ann = node_type_ann(node)
        if ret_ann != -1 {
            sb.write(" -> ")
            sb.write(type_ann_text_renamed(ret_ann, renames))
        } else {
            let ret = node_return_type(node)
            if ret != "" && ret != "Void" {
                sb.write(" -> ")
                sb.write(renames.get(ret) ?? ret)
            }
        }
        return sb.to_str()
    }
    if name == "Tuple" && elems_sl != -1 {
        let mut sb = StringBuilder.new()
        sb.write("(")
        let mut i = 0
        while i < sublist_length(elems_sl) {
            if i > 0 {
                sb.write(", ")
            }
            sb.write(type_ann_text_renamed(sublist_get(elems_sl, i), renames))
            i = i + 1
        }
        sb.write(")")
        return sb.to_str()
    }
    if elems_sl != -1 && sublist_length(elems_sl) > 0 {
        let mut sb = StringBuilder.new()
        sb.write(renames.get(name) ?? name)
        sb.write("[")
        let mut i = 0
        while i < sublist_length(elems_sl) {
            if i > 0 {
                sb.write(", ")
            }
            sb.write(type_ann_text_renamed(sublist_get(elems_sl, i), renames))
            i = i + 1
        }
        sb.write("]")
        return sb.to_str()
    }
    renames.get(name) ?? name
}

// A call's type-argument list as written, or nothing when the call has none.
pub fn call_type_args_text(node: Int) -> Str {
    let sl = node_type_params(node)
    if sl == -1 || sublist_length(sl) == 0 { return "" }
    let mut sb = StringBuilder.new()
    sb.write("[")
    let mut i = 0
    while i < sublist_length(sl) {
        if i > 0 { sb.write(", ") }
        sb.write(type_ann_text(sublist_get(sl, i)))
        i = i + 1
    }
    sb.write("]")
    sb.to_str()
}

fn refuse(node: Int) -> Str ! Diag.Report {
    diag_ice_at("NoSourceTextForExpression", NO_SOURCE_TEXT_FOR_EXPR,
        "a {node_kind_name(node_kind(node))} expression has no source text here", node,
        "a failing assert reports its condition as written; this kind needs a rendering in unparse.bl")
    ICE_SEG_NO_SOURCE_TEXT
}
