trait Shape { type Item
    fn first(self) -> Self.Item
    fn area(self) -> Int }
type Sq { s: Int }
impl Shape for Sq { type Item = Int
    fn first(self) -> Int { self.s }
    fn area(self) -> Int { self.s } }
fn f[S: Shape](s: S) -> Int { let it = s.first()
    it.area() }
fn main() { io.println("{f(Sq { s: 2 })}") }
