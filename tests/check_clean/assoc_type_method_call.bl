trait Shape { type Item
    fn first(self) -> Self.Item
    fn show(self, it: Self.Item) -> Str }
type Sq { s: Int }
impl Shape for Sq { type Item = Int
    fn first(self) -> Int { self.s }
    fn show(self, it: Int) -> Str { "sq{it}" } }
fn keep[T](x: T) -> T { x }
fn f[S: Shape](s: S) -> Str { let it = s.first()
    s.show(keep(it)) }
fn main() { io.println(f(Sq { s: 2 })) }
