import cname.{c_mint_local, c_variant_member_name}
import mono.{instance_of_type, mono_reset}

let mut cg_names: List[Str] = []

fn reset_unit_state() {
    mono_reset()
}

fn cg_reg_reset() {
    cg_names = []
}

// Every unit starts from the same clean state.
pub fn begin_unit(program: Int) -> Int {
    reset_unit_state()
    cg_reg_reset()
    cg_names.push(c_variant_member_name(program, c_mint_local("v")))
    instance_of_type(cg_names.join(","))
}
