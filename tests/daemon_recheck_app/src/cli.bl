import cg.{begin_unit}
import cname.{c_local_name}

fn strip_extension(filename: Str) -> Str {
    if filename.ends_with(".bl") {
        return filename.byte_slice(0, filename.byte_len() - 3)
    }
    filename
}

fn main() {
    io.println(c_local_name(strip_extension("main.bl")))
    io.println("{begin_unit(3)}")
}
