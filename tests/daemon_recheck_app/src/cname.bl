import typecheck.{
    tc_sym_escape, tc_tid_kind,
}

let C_MINTED_PREFIX: Str = "__m_"

let mut c_mint_seq: Int = 0

fn strip_blink(c_name: Str) -> Str {
    if c_name.starts_with("blink_") { return c_name.byte_slice(6, c_name.byte_len()) }
    c_name
}

pub fn c_local_name(name: Str) -> Str { strip_blink("blink_{tc_sym_escape(name)}") }

pub fn c_mint_local(stem: Str) -> Str {
    c_mint_seq = c_mint_seq + 1
    "{C_MINTED_PREFIX}{stem}{c_mint_seq}"
}

fn c_field_name(owner_tid: Int, field: Str) -> Str { "f{tc_tid_kind(owner_tid)}_{tc_sym_escape(field)}" }

pub fn c_variant_member_name(enum_tid: Int, variant: Str) -> Str { c_field_name(enum_tid, variant) }
