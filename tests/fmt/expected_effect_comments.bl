// The effect a cache reads through.
effect Kv {
    // Lookups.
    effect Get {
        // The primitive every lookup goes through.
        fn fetch(key: Str) -> Str
        fn shout(key: Str) -> Str {
            // A handler that omits shout still runs this body.
            let v = kv.fetch(key)
            "{v}!" // loud
        }
    }
    effect Put
}

fn main() {
    io.println("x")
}
