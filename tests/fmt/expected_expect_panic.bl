fn expect_panic_on_fn() {
    let zs: List[Int] = []
    let _ = zs.get(0).unwrap()
}

@expect_panic
test "bare expect_panic formats" {
    let xs: List[Int] = []
    let _ = xs.get(0).unwrap()
}

@expect_panic("None")
test "expect_panic with matching arg formats" {
    let ys: List[Int] = []
    let _ = ys.get(0).unwrap()
}
