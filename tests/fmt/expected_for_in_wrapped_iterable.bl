fn make_items(first_argument: Int, second_argument: Int, third_argument: Int) -> List[Int] {
    [first_argument, second_argument, third_argument]
}

fn main() {
    for pair in [
        ["aaaaaaaaaaaaaaaa", "bbbbbbbbbbbbbbbbbbb"],
        ["cccccccccccccccc", "ddddddddddddddd"],
        ["eeeeeeeeeeee", "ffff"]
    ] {
        io.println(pair.get(0).unwrap())
    }
    for item in make_items(1000000000000000, 2000000000000000, 3000000000000000).map(
        fn(x) { x / 1000000000 }
    ) {
        io.println("{item}")
    }
    for item in make_items(
        1000000000000000000 + 1000000,
        2000000000000000000 + 2000000,
        3000000000000000000
    ) {
        io.println("{item}")
    }
    let numbers = [1, 2, 3]
    for n in numbers
        .map(fn(x) { x * 2 })
        .filter(fn(x) { x > 2 })
        .map(fn(x) { x + 1000000000000000 }) {
        io.println("{n}")
    }
}
