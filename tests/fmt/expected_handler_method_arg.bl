effect MyEff {
    effect Op {
        fn doit() -> Int
    }
}

type Runner {
    n: Int
}

trait Runnable {
    fn run(self, h: Handler[MyEff]) -> Int
}

impl Runnable for Runner {
    fn run(self, h: Handler[MyEff]) -> Int {
        with h {
            myeff.doit() + self.n
        }
    }
}

fn make() -> Int {
    let r = Runner { n: 3 }
    r.run(handler MyEff {
        fn doit() -> Int {
            let x = 1
            x + 1
        }
    })
}
