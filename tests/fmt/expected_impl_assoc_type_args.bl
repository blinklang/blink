type Scoped {
    log: List[Str]
}

impl BlockHandler for Scoped {
    type Context = List[Int]

    fn enter(self) -> List[Int] {
        [1]
    }

    fn exit(self, ok: Bool) {
        self.log.push("exit:{ok}")
    }
}

fn main() {
    let s = Scoped { log: [] }
    with s as xs {
        io.println("{xs.len()}")
    }
}
