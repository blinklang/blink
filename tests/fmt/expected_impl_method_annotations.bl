type Ctr {
    n: Int
}

trait Bump {
    fn bump(self, x: Int) -> Int

    fn reset(self) -> Int
}

impl Bump for Ctr {
    @requires(x > 0)
    @ensures(result >= x)
    @verify(fallback: "runtime")
    fn bump(self, x: Int) -> Int {
        self.n + x
    }

    @ensures(result == 0)
    @verify(fallback: "trust")
    fn reset(self) -> Int {
        0
    }
}

fn main() {
    let c = Ctr { n: 1 }
    let _ = c.bump(1)
    let _ = c.reset()
}
