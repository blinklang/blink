type Box[V] {
    value: V
}

trait Bound {
    fn bnd(self) -> Int
}

trait Tr[T] {
    fn op(self, x: T) -> Int
}

impl[T: Bound] Tr[T] for Box[T] {
    fn op(self, _x: T) -> Int {
        0
    }
}

impl[A, B: Bound] Tr[A] for Box[B] {
    fn op(self, _x: A) -> Int {
        1
    }
}

impl Tr[Int] for Box[Int] {
    fn op(self, _x: Int) -> Int {
        2
    }
}

impl[T] Tr[T] for Box[T] where T: Bound {
    fn op(self, _x: T) -> Int {
        3
    }
}

impl[A, B] Tr[A] for Box[B] where A: Bound, B: Bound {
    fn op(self, _x: A) -> Int {
        4
    }
}
