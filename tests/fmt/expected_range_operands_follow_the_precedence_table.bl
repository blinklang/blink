fn ranges(n: Int, lo: Int, lim: Option[Int], r: Range[Int], xs: List[Int], ok: Bool) -> Int {
    for i in 0..n + 1 {
        io.println("{i}")
    }
    let a = -2..3
    let b = lo..3
    let c = 0..(n | 1)
    let d = 0..(lim ?? 5)
    let e = (0..n).into_iter()
    let f = r == (0..3)
    let g = 0..xs.len()
    let h = xs.len()..=n * 2
    let k = (0..1)..2
    let m = 0..(n << 2)
    let p = (n & 1)..n
    let q = -(0..3)
    let s = r != (0..=n)
    let t = lim ?? 0..n
    let u = (0..n) + 1
    let v = (n == 1)..3
    let w = ok && r == (0..n)
    0
}
