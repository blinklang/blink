type Cleanup[! _] {
    action: fn() -> Void ! _
}

type Job[T ! _] {
    input: T
    run: fn(T) -> Void ! _
}

impl BlockHandler for Cleanup[! _] {
    type Context = Void

    fn enter(self) -> Void {
        let _ = self
    }

    fn exit(self, ok: Bool) ! _ {
        let _ = ok
        let _ = self.action
    }
}

impl Display for Job[Int ! _] {
    fn to_str(self) -> Str {
        "job"
    }
}

fn a(x: Cleanup[! IO.Print]) ! IO.Print {
    let _ = x
}

fn b(j: Job[Int ! IO]) ! IO {
    let _ = j
}

fn e(j: Job[Int ! (IO.Print, FS.Read)]) ! IO.Print, FS.Read {
    let _ = j
}

fn c(x: Cleanup) {
    let _ = x
}
