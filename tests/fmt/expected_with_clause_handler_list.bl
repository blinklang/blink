effect Tally {
    effect Bump {
        fn bump(by: Int) -> Int
    }
}

fn main() {
    let hs = [
        handler Tally {
            fn bump(by: Int) -> Int {
                by * 5
            }
        }
    ]
    io.println("{hs.len()}")
    with handler IO {
        fn print(msg: Str) {
            io.eprintln("[H] {msg}")
        }
    }, handler IO {
        fn print(msg: Str) {
            io.eprintln("[H2] {msg}")
        }
    } {
        io.println("x")
    }
}
