// xtest
type Probe { id: Int }

impl BlockHandler for Probe {
    type Context = Int
    fn enter(self) -> Int { 0 }
    fn exit(self, _ok: Bool) {}
}

test "assert_panics formatting" {
        assert_panics {
            let xs: [Int] = []
        let _ = xs.get(0).unwrap()
        }

    assert_panics(matching: "None") {
    let ys: [Int] = []
            let _ = ys.get(0).unwrap()
    }

    assert_panics(matching: "rollback") {
        with Probe { id: 1 } as _p {
              let zs: [Int] = []
              let _ = zs.get(0).unwrap()
        }
    }
}
