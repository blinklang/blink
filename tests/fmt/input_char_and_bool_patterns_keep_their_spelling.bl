type Shape {
    Dot(Char),
    Pair(Int, Bool)
}

type P {
    c: Char
    b: Bool
}

fn kind(c: Char) -> Str {
    match c {
        'a' => "a"
        'b'..='y' => "low"
        'A'..'Z' => "up"
        '\n' => "newline"
        '\t' | '\r' => "space"
        '\'' => "quote"
        '\\' => "slash"
        '\0' => "nul"
        'é' => "e"
        '€'..='₿' => "money"
        '\u{1F600}' => "smile"
        _ => "other"
    }
}

fn flag(b: Bool) -> Str {
    match b {
        true => "t"
        false => "f"
    }
}

fn shape(s: Shape) -> Str {
    match s {
        Dot('x') => "x"
        Pair(1, true) => "one"
        Pair(_, false) => "no"
        _ => "other"
    }
}

fn pair(t: (Char, Bool)) -> Str {
    match t {
        ('a', true) => "a"
        (c, false) if c == 'z' => "z"
        _ => "other"
    }
}

fn point(p: P) -> Str {
    match p {
        P {c: 'a', b: true} => "a"
        P {c: 'b'..='c' | 'z', ..} => "bz"
        _ => "other"
    }
}

fn first(xs: List[Char]) -> Str {
    match xs {
        ['a'] => "a"
        [_, c as 'b'] => "{c}"
        _ => "other"
    }
}

fn main() {
    io.println("{kind('q')} {flag(true)} {shape(Shape.Dot('x'))} {pair(('a', true))}")
    io.println("{point(P { c: 'z', b: false })} {first(['x', 'b'])}")
}
