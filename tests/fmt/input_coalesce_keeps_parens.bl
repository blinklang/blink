fn coalesce(o: Option[Int], a: Option[Int], s: Option[Str], l: Option[List[Int]]) -> Int {
    let eq = (o ?? 0) == 99
    let lt = (a ?? -1) < (o ?? -1)
    let n = (s ?? "").len()
    let first = (l ?? [9]).get(0) ?? 0
    let idx = (l ?? [9])[0]
    let right = 1 + (o ?? 0)
    let both = (o ?? 0) * (a ?? 1)
    let logic = (o ?? 0) > 1 && (a ?? 0) > 2
    let grouped = o ?? (a ?? 0)
    let chained = o ?? a ?? 0
    let unparenthesized = o ?? 2 + 1
    let neg = -(o ?? 0)
    0
}

fn propagate(o: Option[Option[Int]], a: Option[Int]) -> Option[Int] {
    let v = (o ?? a)?
    Some(v)
}
