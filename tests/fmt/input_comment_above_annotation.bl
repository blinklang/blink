type Point {
    x: Int
}

impl Point {
    // Kept above the annotation.
    @allow(UnusedVariable)
    // Kept below it.
    fn get(self) -> Int {
        self.x
    }
}

/// Adds x.
@requires(x > 0)
@verify(fallback: "trust")
fn bump(x: Int) -> Int {
    x
}

// plain
@deprecated("use bump")
fn old(x: Int) -> Int {
    x
}

/// Bumps twice.
@verify(fallback: "trust")
@requires(x > 0)
fn bump2(x: Int) -> Int {
    x
}

// About both.
@allow(UnusedVariable)
// About the shadow.
@allow(ShadowedVariable)
@requires(x > 0)
fn both(x: Int) -> Int {
    x
}

fn main() {
    io.println("{bump(1)} {old(2)} {bump2(3)} {both(4)}")
}
