type Point {
    x: Int
}

impl Point {
    // Kept above the annotation.
    @allow(UnusedVariable)
    // Kept below it.
    fn get(self) -> Int {
        self.x
    }
}

/// Adds x.
@requires(x > 0)
@verify(fallback: "trust")
fn bump(x: Int) -> Int {
    x
}

// plain
@deprecated("use bump")
fn old(x: Int) -> Int {
    x
}

fn main() {
    io.println("{bump(1)} {old(2)}")
}
