// The whole effect reads one stream.
@handle_all
pub effect Dice {
    effect Roll {
        fn roll(sides: Int) -> Int
    }
}

effect Kv {
    effect Put {
        fn put(key: Str, val: Str)
    }
    // Every lookup reads one table.
    @handle_all
    effect Get {
        fn get(key: Str) -> Str
    }
    @handle_all
    effect Drop
}

fn main() {
    io.println("x")
}
