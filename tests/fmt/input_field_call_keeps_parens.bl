type Inner {
    f: fn(Int) -> Int
}

type Cb {
    f: fn(Int) -> Int
    inner: Inner
}

type Outer {
    b: Cb
}

type Slot[! _] {
    action: fn() -> Void ! _
}

impl Cb {
    fn helper(self, n: Int) -> Int {
        n
    }
}

fn id(n: Int) -> Int {
    n
}

fn run(x: Cb, a: Outer, c: Cb) -> Int {
    let one = (x.f)(1)
    let two = (a.b.inner.f)(2)
    let s = "v={(x.f)(3)}"
    let r = (c.f)(4)
    let plain = id(5)
    let method = x.helper(6)
    one + two + r + plain
}

fn slot(c: Slot[! IO.Print]) ! IO.Print {
    (c.action)()
}
