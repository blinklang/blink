effect MyEff {
    effect Op {
        fn doit() -> Int
    }
}

trait Runnable {
    fn run(self, h: Handler[MyEff], extra: Int) -> Int
}

type Runner {
    n: Int,
}

impl Runnable for Runner {
    fn run(self, h: Handler[MyEff], extra: Int) -> Int {
        with h { myeff.doit() + self.n + extra }
    }
}

fn make() -> Int {
    let r = Runner { n: 3 }
    r.run(handler MyEff {
        fn doit() -> Int {
            let x = 1
            x + 1
        }
    }, 7)
}
