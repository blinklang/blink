effect MyEff {
    effect Op {
        fn doit() -> Int
        fn other(n: Int) -> Int
    }
}

fn caller(h: Handler[MyEff]) -> Int {
    with h { myeff.doit() + myeff.other(2) }
}

fn make() -> Int {
    caller(handler MyEff {
        fn doit() -> Int {
            let x = 1
            x + 1
        }
        fn other(n: Int) -> Int {
            n * 2
        }
    })
}
