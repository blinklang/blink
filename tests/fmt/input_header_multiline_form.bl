fn id(x: Int) -> Int {
    x
}

fn main() {
    let r = 2
    if id({
        let w = 9
        w
    }) == 9 { io.println("if") }
    if r == 1 { io.println("a") } else if id(match r { 2 => { 9 } _ => { 0 } }) == 9 { io.println("else if") }
    let v = if id({
        let w = 9
        w
    }) == 9 { 1 } else { 2 }
    while id(match r { _ => 0 }) == 1 { io.println("never") }
    for x in [id({
        let w = 9
        w
    })] { io.println("{x}") }
    match id(match r { _ => 4 }) { 4 => io.println("match") _ => {} }
    match r {
        _ if id({
            let w = 9
            w
        }) == 9 => io.println("guard")
        _ => {}
    }
    io.println("{v}")
}
