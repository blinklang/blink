type Pt {
    x: Int
}

fn inc(n: Int) -> Int {
    n + 1
}

fn dec(n: Int) -> Int {
    n - 1
}

fn binop_statement(c: Bool) -> Int {
    let x = 1
    (if c { return 3 } else { return 4 }) + x
}

fn binop_let(c: Bool) -> Int {
    let x = 1
    let y = (if c { 10 } else { 20 }) + x
    y
}

fn method_receiver(c: Bool) -> Int {
    (if c { "ab" } else { "abc" }).len()
}

fn field_receiver(c: Bool) -> Int {
    let p = Pt { x: 1 }
    let q = Pt { x: 2 }
    (if c { p } else { q }).x
}

fn index_receiver(c: Bool) -> Int {
    let xs = [1, 2]
    let ys = [3, 4]
    (if c { xs } else { ys })[0]
}

fn try_operand(c: Bool) -> Option[Int] {
    let v = (if c { Some(1) } else { None })?
    Some(v + 1)
}

fn call_callee(c: Bool) -> Int {
    (if c { inc } else { dec })(5)
}

fn await_receiver(c: Bool) -> Int {
    let a = async.spawn(fn() -> Int { 1 })
    let b = async.spawn(fn() -> Int { 2 })
    (if c { a } else { b }).await
}

fn main() {
    io.println("{binop_statement(true)} {binop_let(false)} {method_receiver(true)}")
    io.println("{field_receiver(false)} {index_receiver(false)} {try_operand(true) ?? 0}")
    io.println("{call_callee(false)} {await_receiver(true)}")
}
