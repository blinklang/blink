type Ctr {
    n: Int
}

trait Bump {
    fn bump(self, x: Int) -> Int
    fn reset(self) -> Int
}

impl Bump for Ctr {
    @verify(fallback:   "runtime")
    @requires(x>0)
    @ensures(result  >= x)
    fn bump(self, x: Int) -> Int {
        self.n + x
    }
    @verify(fallback: "trust")
    @ensures(result == 0)
    fn reset(self) -> Int { 0 }
}

fn main() {
    let c = Ctr { n: 1 }
    let _ = c.bump(1)
    let _ = c.reset()
}
