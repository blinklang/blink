trait Bound {
    fn bnd(self) -> Int
}

trait Tr[T] {
    fn op(self, x: T) -> Int
}

type Box[V] { value: V }

impl[T: Bound] Tr[T] for Box[T] {
    fn op(self, _x: T) -> Int {
        0
    }
}

impl[A, B: Bound] Tr[A] for Box[B] {
    fn op(self, _x: A) -> Int {
        1
    }
}

impl Tr[Int] for Box[Int] {
    fn op(self, _x: Int) -> Int {
        2
    }
}
