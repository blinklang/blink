fn main() {
    let x = 5
    io.println("a {({ x })} b")
    io.println("a { ({ x + 1 }) } b")
    io.println("{({ x }) + 1}")
    io.println("{({
        let m = x + 1
        m
    })}")
    io.println("{({
        let m = x
        m
    }) + 1}")
    io.println("{({ "ab" }).len()}")
    io.println("a \{{x}} b")
}
