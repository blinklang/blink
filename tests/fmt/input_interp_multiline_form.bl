fn main() {
    let s = "hi"
    let n = 2
    let out = "<{match s { w as "hi" => { w } z => { z } }}>"
    io.println(out)
    io.println("{if n == 2 {
        let t = "a"
        t
    } else { "b" }} end")
    io.println("{{
        let m = n + 1
        m
    }}")
    io.println("{match s { _ => "x" }} and {match s { _ => "y" }}")
}
