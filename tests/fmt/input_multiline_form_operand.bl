type Box {
    v: Str
}

fn double(n: Int) -> Int {
    n * 2
}

fn match_binop_right(v: Int) -> Int {
    let mut sum = 1
    sum = sum + match v {
        0 => 10
        _ => 20
    }
    sum
}

fn match_binop_left(v: Int) -> Int {
    (match v {
        0 => 10
        _ => 20
    }) + 1
}

fn match_receiver(v: Int) -> Int {
    (match v {
        0 => "a"
        _ => "bb"
    }).len()
}

fn match_nested_arg(v: Int) -> Int {
    double(double(match v {
        0 => 1
        _ => 2
    }))
}

fn match_field(s: Str) -> Box {
    Box { v: match s {
        "hi" => "greeting"
        _ => s
    } }
}

fn match_receiver_arg(v: Int) -> Str {
    (match v {
        0 => "a"
        _ => "b"
    }).concat("x")
}

fn match_list(v: Int) -> List[Int] {
    [1, match v {
        0 => 2
        _ => 3
    }, 4]
}

fn match_tuple(m: Int) -> (Int, Int) {
    (m, match m {
        0 => 1
        _ => 2
    })
}

fn two_matches(a: Int, b: Int) -> Int {
    (match a {
        0 => 1
        _ => 2
    }) + match b {
        0 => 3
        _ => 4
    }
}

fn if_binop_left(c: Bool) -> Int {
    (if c {
        let a = 1
        a + 1
    } else {
        5
    }) + 1
}

fn if_else_loop(c: Bool) -> Int {
    let mut i = 0
    let y = if c {
        5
    } else {
        loop {
            i = i + 1
            if i > 2 { return i }
        }
    }
    y
}

fn with_binop_left(s: Str, x: Int) -> Int {
    (with s as n {
        n.len()
    }) + x
}

fn main() {
    io.println("{match_binop_right(0)} {match_binop_left(1)} {match_receiver(1)}")
    io.println("{match_nested_arg(1)} {match_field("hi").v} {match_tuple(0).1} {two_matches(1, 0)}")
    io.println("{if_binop_left(true)} {if_else_loop(false)} {with_binop_left("abc", 1)}")
    io.println("{match_receiver_arg(1)} {match_list(0).get(1).unwrap()}")
}
