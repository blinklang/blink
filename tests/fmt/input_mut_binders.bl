type Point {
    x: Int
    y: Int
}

fn main() {
    let (mut  a, b) = (1, 2)
    let (mut c, mut  d) = (3, 4)
    a += b + c + d
    for   mut i in [1, 2] { i += a }
    for (k,  mut v) in [(1, 2)] { v += k }
    let p = Point { x: 1, y: 2 }
    let n = match p {
        Point {  mut x, y } => { x += y
            x }
    }
    let m = match Some(n) {
        Some( mut z ) => z
        mut whole as None => { whole = Some(0)
            0 }
    }
    let q = match p { Point { x:   mut px, .. } => px }
    let _ = m + q
}
