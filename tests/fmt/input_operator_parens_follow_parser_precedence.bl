fn ops(x: Int, y: Int) -> Int {
    let bits = (x | 1) & 3
    let xor = (x ^ y) & 3
    let mixed = x | y & 3
    let shift_sum = x << (1 + 2)
    let sum_shift = (x << 1) + 2
    let shift_cmp = x << 1 < y
    let receiver = (x + 1).abs()
    let negated = (-x).abs()
    let not_first = -x.abs()
    let sub = x - (y - 1)
    let assoc = x - y - 1
    let cmp = x < 1 == y > 2
    x
}
