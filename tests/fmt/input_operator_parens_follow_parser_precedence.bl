fn ops(x: Int, y: Int) -> Int {
    let bits = (x | 1) & 3
    let xor = (x ^ y) & 3
    let chain = x | y | 3
    let or_right = x | (y | 3)
    let shift_sum = x << (1 + 2)
    let sum_shift = (x << 1) + 2
    let shift_cmp = x << 1 < y
    let mask_eq = x & 15 == 0
    let mask_eq_parens = (x & 15) == 0
    let sum_cmp = x + 1 < y
    let sum_cmp_parens = (x + 1) < y
    let product_sum = x + y * 2
    let sum_product = (x + y) * 2
    let receiver = (x + 1).abs()
    let negated = (-x).abs()
    let not_first = -x.abs()
    let complement = ~x & y
    let sub = x - (y - 1)
    let assoc = x - y - 1
    let cmp = x < 1 == y > 2
    x
}
