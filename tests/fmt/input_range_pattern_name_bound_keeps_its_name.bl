const TOP: Char = 'z'
const MAX: Int = 99

fn kind(c: Char) -> Str {
    match c {
        'a'..=TOP => "low"
        'A'..TOP => "up"
        _ => "other"
    }
}

fn size(n: Int) -> Str {
    match n {
        0..=MAX => "small"
        _ => "big"
    }
}

fn main() {
    io.println("{kind('q')} {size(5)}")
}
