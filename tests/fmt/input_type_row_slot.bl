type Cleanup[!_] {
    action: fn() -> Void ! _
}

type Job[T  !  _] {
    input: T
    run: fn(T) -> Void ! _
}

fn a(x: Cleanup[!IO.Print]) ! IO.Print {
    let _ = x
}

fn b(j: Job[Int ! IO]) ! IO {
    let _ = j
}

fn e(j: Job[Int ! (IO.Print, FS.Read)]) ! IO.Print, FS.Read {
    let _ = j
}

fn c(x: Cleanup) {
    let _ = x
}
