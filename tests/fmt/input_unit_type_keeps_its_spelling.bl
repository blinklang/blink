import blink.ffi { Ptr }

type Holder {
    unit: ()
    units: List[()]
    pair: ((), Int)
}

type Event {
    Tick(()),
    Stop
}

type Done = Result[(), Str]

fn take(x: (), f: fn(()) -> ()) -> () {
    f(x)
}

fn run(cb: fn() -> ()) -> Result[(), Str] {
    cb()
    Ok(())
}

@trusted(audit: "unit-type-golden")
fn raw(p: Ptr[Void]) -> Ptr[Void] {
    p
}

fn main() {
    let a: () = ()
    let b: List[()] = []
    let m: Map[(), Int] = Map()
    let o: Option[()] = None
    let c = channel.new[()](buffer: 1)
    let f: fn() -> () = fn() -> () { }
    let r: Result[(), Str] = run(f)
}
