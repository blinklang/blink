// xtest — manual stdin test, requires piped input
// Run with: printf 'hello from stdin\nABCDE' | build/test_stdio_stdin

test "io.read_line reads from stdin" {
    assert_eq(io.read_line(), Some("hello from stdin"))
}

test "io.read_bytes reads exact count from stdin" {
    let data = io.read_bytes(5)
    assert(data.len() == 5)
    match data.to_str() {
        Ok(s) => assert_eq(s, "ABCDE")
        Err(_e) => assert(false)
    }
}
