import std.semver.{version_matches}

// Two user TUs (this + util_b) import std.semver so its non-pub `let`s land in
// the per-module emit set referenced from multiple consumers. The bug being
// guarded: those non-pub lets are `static` in std_semver.c, so a foreign
// `extern` decl in a consumer would reference a symbol with no external
// definition. See br yk0mha.
pub fn check_a() -> Int {
    version_matches("1.2.3", ">=1.0.0")
}
