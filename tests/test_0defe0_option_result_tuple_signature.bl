// Bug 0defe0: Option[Tuple]/Result[Tuple] in fn SIGNATURES lowered to
// `blink_Option_void` / `blink_Result_void_void` because signature-lowering
// sites (param_c_type, mono_option_result_param_c_type, resolve_ret_type_from_ann
// Option branch, and the whole-program param pre-pass) only recognized
// struct/enum inners — a Tuple inner degraded to CT_VOID. The body already
// emitted the correct `blink_Option_Tuple2_int_int` carrier, so the signature
// and body disagreed and cc failed. Mirrors the emit_let_binding fix (r9bbmk).

fn take(x: Option[Tuple[Int, Int]]) -> Int {
    match x {
        Some(t) => return t.0 + t.1
        None => return 0
    }
}

fn make() -> Option[Tuple[Int, Int]] {
    Some((3, 4))
}

fn take_r(x: Result[Tuple[Int, Int], Str]) -> Int {
    match x {
        Ok(t) => return t.0 + t.1
        Err(_e) => return 0
    }
}

fn make_r() -> Result[Tuple[Int, Int], Str] {
    Ok((6, 8))
}

fn sum_pair(p: Option[Tuple[Int, Int]]) -> Int {
    match p {
        Some(t) => return t.0 + t.1
        None => return 0
    }
}

test "Option[Tuple] param and return round-trip through fn signatures" {
    assert_eq(take(make()), 7)
}

test "Result[Tuple] param and return round-trip through fn signatures" {
    assert_eq(take_r(make_r()), 14)
}

test "Option[Tuple] param-only fn constructs carrier at call site" {
    assert_eq(sum_pair(Some((1, 6))), 7)
}

test "Option[Tuple] param-only fn None path" {
    assert_eq(sum_pair(None), 0)
}
