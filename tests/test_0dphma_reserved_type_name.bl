// br 0dphma (RESHAPED): a user `type X` whose name is a reserved AST head-sentinel
// (Tuple, Fn, Self) must be rejected at the DECLARATION site with E0524, rather
// than silently shadowing the internal sentinel.
//
// Original symptom: `type Tuple[X] { val: X }` used in a tuple-element annotation
// mis-decoded as a 1-arity nested tuple — resolve_type_ann keys `name == "Tuple"`
// -> make_tuple_type, and the codegen twin resolve_tuple_ann keys the same string.
// "Tuple" is an internal AST head-sentinel (parser.bl overloads the head name),
// not a user-facing prelude type (§10.6 omits it); allowing the shadow manufactures
// a forbidden 1-arity tuple (§3 "No 1-Tuples"). The robust fix rejects the shadow
// at register_struct_type / register_enum_type, closing the whole sentinel family
// at the source instead of guarding each downstream string-comparison site.

import compile_test_helpers

test "struct named Tuple is rejected E0524" {
    let src = "type Tuple[X] \{ val: X }\nfn main() \{ let _t = Tuple \{ val: 5 }\n }\n"
    compile_test_helpers.expect_compile_error(src, "reserved_struct_tuple", "E0524")
}

test "enum named Tuple is rejected E0524" {
    let src = "type Tuple \{ A, B }\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "reserved_enum_tuple", "E0524")
}

test "struct named Fn is rejected E0524" {
    let src = "type Fn \{ x: Int }\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "reserved_struct_fn", "E0524")
}

test "struct named Self is rejected E0524" {
    let src = "type Self \{ x: Int }\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "reserved_struct_self", "E0524")
}

test "the original 0dphma MVCE (Tuple in tuple-element annotation) is rejected E0524" {
    let src = "type Tuple[X] \{ val: X }\nfn main() \{ let inner = Tuple \{ val: 5 }\n let p: (Int, Tuple[Int]) = (1, inner)\n io.println(\"\{p.0}\")\n }\n"
    compile_test_helpers.expect_compile_error(src, "reserved_tuple_mvce", "E0524")
}

test "a normal user type name is still accepted (no false positive)" {
    let src = "type Pair[X] \{ val: X }\nfn main() \{ let _t = Pair \{ val: 5 }\n }\n"
    compile_test_helpers.expect_no_error(src, "reserved_ok_pair", "E0524")
}
