// A bare struct-style pattern (`V { field: pat }` / `Point { field: pat }`, no `Type.`
// prefix) must bind its `: pat` sub-patterns, the same as the qualified `E.V { field: pat }`
// form — the bare and qualified struct-style spellings are duals (§3.5).

import compile_test_helpers

fn src_scalar_binder() -> Str {
    #"import std.io

type Box { V { val: Int } }

fn main() {
    let b = Box.V { val: 7 }
    match b {
        V { val: y } => io.println("y={y}")
    }
}
"#
}

test "bare struct-style scalar sub-field binds the ident" {
    let r = compile_test_helpers.compile_and_run(src_scalar_binder(), "0mvayd_scalar")
    if !r.out.contains("y=7") {
        compile_test_helpers.expect_contains(r.out, "y=7", "bare struct-style scalar binder — got '{r.out}' / '{r.err_out}'")
    }
    assert(r.out.contains("y=7"))
    assert_eq(r.exit_code, 0)
}

fn src_tuple_binder() -> Str {
    #"import std.io

type E { V { pair: (Int, Int) } }

fn main() {
    let e = E.V { pair: (3, 4) }
    match e {
        V { pair: (a, b) } => io.println("{a},{b}")
    }
}
"#
}

test "bare struct-style tuple sub-field binds its elements" {
    let r = compile_test_helpers.compile_and_run(src_tuple_binder(), "0mvayd_tuple")
    if !r.out.contains("3,4") {
        compile_test_helpers.expect_contains(r.out, "3,4", "bare struct-style tuple binder — got '{r.out}' / '{r.err_out}'")
    }
    assert(r.out.contains("3,4"))
    assert_eq(r.exit_code, 0)
}

fn src_struct_arg_binder() -> Str {
    #"import std.io

type P { x: Int, y: Int }

type E { V { p: P } }

fn main() {
    let e = E.V { p: P { x: 1, y: 2 } }
    match e {
        V { p: q } => io.println("px={q.x} py={q.y}")
    }
}
"#
}

test "bare struct-style struct sub-field binds and reads fields" {
    let r = compile_test_helpers.compile_and_run(src_struct_arg_binder(), "0mvayd_struct")
    if !r.out.contains("px=1 py=2") {
        compile_test_helpers.expect_contains(r.out, "px=1 py=2", "bare struct-style struct binder — got '{r.out}' / '{r.err_out}'")
    }
    assert(r.out.contains("px=1 py=2"))
    assert_eq(r.exit_code, 0)
}

fn src_plain_struct_rename() -> Str {
    #"import std.io

type Point { x: Int, y: Int }

fn main() {
    let p = Point { x: 5, y: 6 }
    match p {
        Point { x: px, y: py } => io.println("px={px} py={py}")
    }
}
"#
}

test "bare plain-struct pattern renames its fields via sub-patterns" {
    let r = compile_test_helpers.compile_and_run(src_plain_struct_rename(), "0mvayd_rename")
    if !r.out.contains("px=5 py=6") {
        compile_test_helpers.expect_contains(r.out, "px=5 py=6", "bare plain-struct rename — got '{r.out}' / '{r.err_out}'")
    }
    assert(r.out.contains("px=5 py=6"))
    assert_eq(r.exit_code, 0)
}

fn src_carrier_binder() -> Str {
    #"import std.io

type E { V { r: Option[Int] } }

fn main() {
    let e = E.V { r: Some(5) }
    match e {
        V { r: None } => io.println("none")
        V { r: Some(x) } => io.println("some={x}")
    }
}
"#
}

test "bare struct-style Option carrier sub-field binds through the nested pattern" {
    let r = compile_test_helpers.compile_and_run(src_carrier_binder(), "0mvayd_carrier")
    if !r.out.contains("some=5") {
        compile_test_helpers.expect_contains(r.out, "some=5", "bare struct-style carrier binder — got '{r.out}' / '{r.err_out}'")
    }
    assert(r.out.contains("some=5"))
    assert(!r.out.contains("none"))
    assert_eq(r.exit_code, 0)
}
