import compile_test_helpers

// br 0qesjg — a struct-literal head was not validated to name a constructible product-struct
// type. Constructing a builtin (Int {}), an enum head (State {}), or an @ffi.opaque handle
// (CFile {}) via struct-literal syntax all passed blink check and emitted C. For an opaque this
// forges a handle outside the FFI boundary, which sections/07_trust_modules_metadata.md section
// 9.1.4 seals: an opaque handle has no user-callable constructor. sections/03_types.md:1084 and
// the product-type rule require the head to be a struct type. All three are now E0300 TypeError
// (the existing type-mismatch diagnostic; section 9.1.4 mandates no new error code).

fn opaque_construct_src() -> Str {
    #"@ffi.opaque(header: "stdio.h", name: "FILE")
type CFile
fn main() {
    let a: CFile = CFile {}
    io.println("forged")
}
"#
}

test "constructing an @ffi.opaque handle via struct literal is E0300" {
    compile_test_helpers.expect_compile_error(opaque_construct_src(), "0qesjg_opaque", "E0300")
}

fn enum_head_construct_src() -> Str {
    #"type State { Idle, Running, Done }
fn main() {
    let s: State = State {}
    io.println("bad")
}
"#
}

test "constructing an enum head via struct literal is E0300" {
    compile_test_helpers.expect_compile_error(enum_head_construct_src(), "0qesjg_enumhead", "E0300")
}

fn builtin_construct_src() -> Str {
    #"fn main() {
    let n: Int = Int {}
    io.println("bad")
}
"#
}

test "constructing a builtin type via struct literal is E0300" {
    compile_test_helpers.expect_compile_error(builtin_construct_src(), "0qesjg_builtin", "E0300")
}

// Guards: legitimate construction must still typecheck cleanly.
fn good_struct_src() -> Str {
    #"type P { a: Int
b: Str }
fn main() {
    let p = P { a: 1, b: "x" }
    io.println("a={p.a} b={p.b}")
}
"#
}

test "constructing a real struct still typechecks (no false E0300)" {
    compile_test_helpers.expect_no_error(good_struct_src(), "0qesjg_good_struct", "E0300")
}

fn empty_struct_src() -> Str {
    #"type Empty {}
fn main() {
    let e = Empty {}
    io.println("ok")
}
"#
}

test "constructing an empty struct still typechecks (no false E0300)" {
    compile_test_helpers.expect_no_error(empty_struct_src(), "0qesjg_empty_struct", "E0300")
}

// Finding-1 guard: a user type shadowing a builtin scalar name resolves user-first at the
// construction head (same as decl / annotation / field access) and must still construct.
fn shadow_builtin_src() -> Str {
    #"type Char { a: Int }
fn main() {
    let c = Char { a: 1 }
    io.println("a={c.a}")
}
"#
}

test "a user struct shadowing a builtin name still constructs (no false E0300)" {
    compile_test_helpers.expect_no_error(shadow_builtin_src(), "0qesjg_shadow", "E0300")
}

// A generic struct constructed with a concrete field value must reverse-infer its instance
// tid, not be over-rejected as unconstructible.
fn generic_struct_src() -> Str {
    #"type Box { value: Int }
fn main() {
    let b = Box { value: 1 }
    io.println("v={b.value}")
}
"#
}

test "constructing a generic struct instance still typechecks (no false E0300)" {
    compile_test_helpers.expect_no_error(generic_struct_src(), "0qesjg_generic", "E0300")
}

// Finding-2 guard: a scalar builtin used as a construction head is rejected.
fn stringbuilder_head_src() -> Str {
    #"fn main() {
    let s = StringBuilder {}
    io.println("bad")
}
"#
}

test "constructing a builtin StringBuilder via struct literal is E0300" {
    compile_test_helpers.expect_compile_error(stringbuilder_head_src(), "0qesjg_sb", "E0300")
}

// Finding-2 guard: a structural builtin (List / Map / Option) used as a construction head is
// rejected, not silently folded to an unknown type.
fn list_head_src() -> Str {
    #"fn main() {
    let xs = List {}
    io.println("bad")
}
"#
}

test "constructing a builtin List via struct literal is E0300" {
    compile_test_helpers.expect_compile_error(list_head_src(), "0qesjg_list", "E0300")
}

fn map_head_src() -> Str {
    #"fn main() {
    let m = Map {}
    io.println("bad")
}
"#
}

test "constructing a builtin Map via struct literal is E0300" {
    compile_test_helpers.expect_compile_error(map_head_src(), "0qesjg_map", "E0300")
}

// The critical guard: enum VARIANTS use struct-literal syntax and must not be over-rejected.
fn variant_struct_src() -> Str {
    #"type QueryError { NotFound { msg: Str }, Timeout }
fn describe(e: QueryError) -> Str {
    match e {
        NotFound { msg } => msg
        Timeout => "timeout"
    }
}
fn main() {
    let e = NotFound { msg: "id 0" }
    io.println(describe(e))
}
"#
}

test "constructing an enum struct-style variant still typechecks (no false E0300)" {
    compile_test_helpers.expect_no_error(variant_struct_src(), "0qesjg_variant", "E0300")
}
