// br 1452w4 (codegen-structured-tids, unblocks q4etvt). Option[Box[Int]] twin of
// the Result fixture: the compound-inner spellers erased the struct instance's
// inner type-args to the bare head. EDIT 3 (resolve_ann_tag) covers the
// annotation-only Option carrier; EDIT 1 covers the through-a-generic-fn tid path.
//
// Model: test_nss31w_* / test_bwyfy1_*. Each case compiles AND asserts the value.

type Box[T] {
    value: T
}

fn ident[T](v: T) -> T {
    v
}

// Isolates EDIT 3 (resolve_ann_tag): annotation-only Option carrier, no generic fn.
test "Option[Box[Int]] annotation-only round-trips inner Int" {
    let o: Option[Box[Int]] = Some(Box { value: 9 })
    assert_eq(o.unwrap().value, 9)
}

test "Option[Box[Int]] through a generic fn round-trips inner Int" {
    let o: Option[Box[Int]] = Some(Box { value: 55 })
    let o2 = ident(o)
    assert_eq(o2.unwrap().value, 55)
}

// Str spelling of the inner slot must survive too.
test "Option[Box[Str]] round-trips the inner Str spelling" {
    let o: Option[Box[Str]] = Some(Box { value: "boxed" })
    let o2 = ident(o)
    assert_eq(o2.unwrap().value, "boxed")
}

test "Option[Box[Int]] None side round-trips" {
    let o: Option[Box[Int]] = None
    let o2 = ident(o)
    assert_eq(o2.is_none(), true)
}
