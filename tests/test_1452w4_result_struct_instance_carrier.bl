// br 1452w4 (codegen-structured-tids, unblocks q4etvt). A struct INSTANCE nested
// inside a compound carrier (Result here) had its inner type-args erased to the
// bare struct head, emitting an uncompilable `blink_Box` (never typedef'd) instead
// of the registered `blink_Box_Int`. Two independent erasure sites: the tid path
// (tc_tid_inner_tag struct/enum arm) feeding the generic-fn mono symbol + param
// carrier, and the annotation path (resolve_ann_tag / resolve_result_inner_tag)
// feeding the carrier typedef emitted from a `let` annotation. The fix mirrors the
// top-level struct branch's recursion (tc_tid_struct_mono_name / mono_name_from_ann)
// onto the compound-inner spellers so the inner Int/Str survives.
//
// Model: test_nss31w_* / test_bwyfy1_*. Each case compiles AND asserts the value.

type Box[T] {
    value: T
}

type Point {
    x: Int
    y: Int
}

fn ident[T](v: T) -> T {
    v
}

// Isolates EDIT 4 (resolve_result_inner_tag): annotation-only carrier, no generic
// fn in play — the erasure reproduced on the `let` annotation alone.
test "Result[Box[Int], Str] annotation-only round-trips inner Int" {
    let r: Result[Box[Int], Str] = Ok(Box { value: 7 })
    assert_eq(r.unwrap().value, 7)
}

// EDIT 1 (tid path) + annotation: repassing through a bare-typevar generic fn
// deterministically selects the tid path for the mono symbol.
test "Result[Box[Int], Str] through a generic fn round-trips inner Int" {
    let r: Result[Box[Int], Str] = Ok(Box { value: 42 })
    let r2 = ident(r)
    assert_eq(r2.unwrap().value, 42)
}

test "Result[Box[Int], Str] Err side round-trips" {
    let r: Result[Box[Int], Str] = Err("boom")
    let r2 = ident(r)
    assert_eq(r2.is_err(), true)
}

// GREEN control: a monomorphic struct instance keeps the bare name (byte-neutral).
test "Result[Point, Str] monomorphic-struct control round-trips" {
    let r: Result[Point, Str] = Ok(Point { x: 3, y: 4 })
    let r2 = ident(r)
    assert_eq(r2.unwrap().x, 3)
    assert_eq(r2.unwrap().y, 4)
}
