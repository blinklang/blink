// The Err arm of a Result nested under another carrier must spell a compound ok
// side from the fn-return marker, not erase it to a lowercase carrier that
// mismatches the sibling arm's real carrier type. Companion of the Ok-side
// reconstruction on the same fn-return construction path. The compound ok side
// covers both an Option inner and a Result inner.

type Point { x: Int, y: Int }

fn build(n: Int) -> Option[Result[Option[Point], Str]] {
    if n == 0 { Some(Ok(Some(Point { x: 5, y: 6 }))) } else { Some(Err("boom")) }
}

fn build_rr(n: Int) -> Option[Result[Result[Point, Str], Str]] {
    if n == 0 { None } else { Some(Err("outer")) }
}

fn main() {
    let a = build(0)
    match a {
        Some(r) => {
            match r {
                Ok(o) => {
                    match o {
                        Some(p) => { assert_eq(p.x == 5, true) }
                        None => assert_eq(1, 0)
                    }
                }
                Err(_e) => assert_eq(1, 0)
            }
        }
        None => assert_eq(1, 0)
    }

    let b = build(1)
    match b {
        Some(r) => {
            match r {
                Ok(_o) => assert_eq(1, 0)
                Err(e) => assert_eq(e == "boom", true)
            }
        }
        None => assert_eq(1, 0)
    }

    let c = build_rr(0)
    match c {
        Some(_r) => assert_eq(1, 0)
        None => assert_eq(1, 1)
    }

    let d = build_rr(1)
    match d {
        Some(r) => {
            match r {
                Ok(_inner) => assert_eq(1, 0)
                Err(e) => assert_eq(e == "outer", true)
            }
        }
        None => assert_eq(1, 0)
    }
}
