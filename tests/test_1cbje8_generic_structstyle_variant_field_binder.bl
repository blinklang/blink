// A QUALIFIED struct-style variant-field binder over a GENERIC enum instance
// (Box[Int]) must resolve the field's typevar (`T`) against the scrutinee's mono
// stem, exactly as the positional-payload path does. The struct-style binder loop
// used the RAW declared type `T` (CT_VOID) for both the recursion's scrut entry
// and the shorthand set_var, so `Box.V { val: y }` emitted `void y` (a cc error)
// and `Box.V { val }` bound `val` with void metadata (rendered `<value>`). The
// fix resolves the field type via scrut_mono before typing the binder.
//
// The BARE spelling (V { val: y }) is a separate typecheck-layer bug (the bare
// StructPattern arm drops the `: pat` sub-pattern binder even for non-generic
// scalars); it is tracked elsewhere and intentionally not exercised here.

import compile_test_helpers

fn src_scalar_explicit() -> Str {
    #"import std.io

type Box[T] { V { val: T } }

fn main() {
    let b: Box[Int] = Box.V { val: 3 }
    match b {
        Box.V { val: y } => io.println("y={y}")
    }
}
"#
}

test "qualified struct-style scalar binder on a generic instance resolves the field typevar" {
    let r = compile_test_helpers.compile_and_run(src_scalar_explicit(), "1cbje8_scalar")
    if !r.out.contains("y=3") {
        compile_test_helpers.expect_contains(r.out, "y=3", "generic struct-style scalar binder — got '{r.out}' / '{r.err_out}'")
    }
    assert(r.out.contains("y=3"))
    assert_eq(r.exit_code, 0)
}

fn src_scalar_shorthand() -> Str {
    #"import std.io

type Box[T] { V { val: T } }

fn main() {
    let b: Box[Int] = Box.V { val: 9 }
    match b {
        Box.V { val } => io.println("val={val}")
    }
}
"#
}

test "qualified struct-style shorthand binder on a generic instance carries the resolved scalar type" {
    let r = compile_test_helpers.compile_and_run(src_scalar_shorthand(), "1cbje8_shorthand")
    if !r.out.contains("val=9") {
        compile_test_helpers.expect_contains(r.out, "val=9", "generic struct-style shorthand binder — got '{r.out}' / '{r.err_out}'")
    }
    assert(r.out.contains("val=9"))
    assert(!r.out.contains("<value>"))
    assert_eq(r.exit_code, 0)
}

fn src_struct_arg() -> Str {
    #"import std.io

type P { x: Int, y: Int }

type Box[T] { V { val: T } }

fn main() {
    let b: Box[P] = Box.V { val: P { x: 7, y: 8 } }
    match b {
        Box.V { val: p } => io.println("px={p.x} py={p.y}")
    }
}
"#
}

test "qualified struct-style binder on a generic instance with a struct type-arg reads fields" {
    let r = compile_test_helpers.compile_and_run(src_struct_arg(), "1cbje8_struct")
    if !r.out.contains("px=7 py=8") {
        compile_test_helpers.expect_contains(r.out, "px=7 py=8", "generic struct-style struct-arg binder — got '{r.out}' / '{r.err_out}'")
    }
    assert(r.out.contains("px=7 py=8"))
    assert_eq(r.exit_code, 0)
}

fn src_enum_arg() -> Str {
    #"import std.io

type Color { Red, Green, Blue }

type Box[T] { V { val: T } }

fn main() {
    let b: Box[Color] = Box.V { val: Color.Green }
    match b {
        Box.V { val: c } => {
            match c {
                Color.Green => io.println("green")
                _ => io.println("other")
            }
        }
    }
}
"#
}

test "qualified struct-style binder on a generic instance with an enum type-arg matches" {
    let r = compile_test_helpers.compile_and_run(src_enum_arg(), "1cbje8_enum")
    if !r.out.contains("green") {
        compile_test_helpers.expect_contains(r.out, "green", "generic struct-style enum-arg binder — got '{r.out}' / '{r.err_out}'")
    }
    assert(r.out.contains("green"))
    assert(!r.out.contains("other"))
    assert_eq(r.exit_code, 0)
}
