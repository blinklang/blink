// br 1g6frv — an Ok/Some payload binder over a `Result[Map[K,V]]` /
// `Option[Map[K,V]]` carrier erased the inner Map's VALUE STRUCT. The carrier
// name is faithful (blink_Result_Map_str_Point_str), but the compound Map ok
// sets no rok_s, so the carrier's ok-struct slot is empty; unwrap_carrier then
// reported no inner_struct and the Map reached the payload binder with only its
// head CT. The Map C type is pointer-erased (blink_map*), so only the key/value
// metadata was at stake — and it was recovered from the erased flat channels,
// defaulting the value to Int:
//
//     blink_map* inner = _scrut.ok;
//     blink_Option_int _mgetopt = ...;   // value erased to Int
//     got = _ounw.value.y;               // member 'y' in something not a struct
//
// The binder's OWN tid is the authority for the inner Map's key/value; stamp it
// from pat_binder_tid. A scalar value (Int) survived the erasure by accident —
// only a struct value exposes it. Affects the non-tuple, decomposed-tuple, and
// whole-binder match paths alike.

type Point {
    x: Int
    y: Int
}

fn wrap[K, V](m: Map[K, V]) -> Result[Map[K, V], Str] { Ok(m) }
fn owrap[K, V](m: Map[K, V]) -> Option[Map[K, V]] { Some(m) }

test "non-tuple Result[Map] payload keeps its value struct" {
    let mut m: Map[Str, Point] = Map()
    m.insert("k", Point { x: 3, y: 9 })
    let r = wrap(m)
    let mut got = 0
    match r {
        Ok(inner) => { got = inner.get("k").unwrap().y }
        Err(_) => { got = -1 }
    }
    assert_eq(got, 9)
}

test "decomposed tuple Result[Map] payload keeps its value struct" {
    let mut m: Map[Str, Point] = Map()
    m.insert("k", Point { x: 3, y: 9 })
    let mut got = 0
    match (wrap(m), 1) {
        (Ok(inner), _) => { got = inner.get("k").unwrap().y }
        (Err(_), _) => { got = -1 }
    }
    assert_eq(got, 9)
}

test "whole-binder tuple Result[Map] payload keeps its value struct" {
    let mut m: Map[Str, Point] = Map()
    m.insert("k", Point { x: 3, y: 9 })
    let mut got = 0
    match (wrap(m), 1) {
        (whole, _) => {
            match whole {
                Ok(inner) => { got = inner.get("k").unwrap().y }
                Err(_) => { got = -1 }
            }
        }
    }
    assert_eq(got, 9)
}

test "Option[Map] payload keeps its value struct" {
    let mut m: Map[Str, Point] = Map()
    m.insert("k", Point { x: 3, y: 9 })
    let mut got = 0
    match (owrap(m), 1) {
        (Some(inner), _) => { got = inner.get("k").unwrap().y }
        (None, _) => { got = -1 }
    }
    assert_eq(got, 9)
}
