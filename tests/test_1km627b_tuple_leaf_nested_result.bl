// The tuple-leaf variant of the nested Result-of-Result carrier: when the inner
// Result's Ok side is a tuple, the fn-return construction path must spell that side
// as its generated tuple tag (blink_Result_Tuple2_int_int_str), not erase it to a
// void carrier. The struct/enum leaf case is covered by the sibling test; a tuple
// leaf rides the same tid push path through the generated Tuple tag rather than a
// struct name.

fn build_rr(n: Int) -> Option[Result[Result[(Int, Int), Str], Str]] {
    if n == 0 { Some(Ok(Ok((5, 6)))) } else { Some(Err("outer")) }
}

fn main() {
    let a = build_rr(0)
    match a {
        Some(r) => {
            match r {
                Ok(inner) => {
                    match inner {
                        Ok(t) => {
                            let (x, y) = t
                            assert_eq(x == 5, true)
                            assert_eq(y == 6, true)
                        }
                        Err(_e) => assert_eq(1, 0)
                    }
                }
                Err(_e) => assert_eq(1, 0)
            }
        }
        None => assert_eq(1, 0)
    }

    let b = build_rr(1)
    match b {
        Some(r) => {
            match r {
                Ok(_inner) => assert_eq(1, 0)
                Err(e) => assert_eq(e == "outer", true)
            }
        }
        None => assert_eq(1, 0)
    }
}
