// Bug 264p4n: a bare `None` in a struct-style enum-variant field defaulted to
// Option[int], emitting `blink_Option_int` instead of the declared Option[T]
// carrier. `blink check` passed; the C compiler rejected the mismatch.

type PgError {
    QueryError { sqlstate: Str, detail: Option[Str], position: Option[Int] }
    Other
}

test "bare None enum-variant fields adopt declared Option[T] carrier" {
    let e = PgError.QueryError { sqlstate: "42P01", detail: None, position: None }
    match e {
        QueryError { sqlstate, detail, position } => {
            assert_eq(sqlstate, "42P01")
            assert_eq(detail.is_none(), 1)
            assert_eq(position.is_none(), 1)
        }
        Other => assert_eq(1, 0)
    }
}

test "Some enum-variant fields round-trip with declared carrier" {
    let e = PgError.QueryError { sqlstate: "23505", detail: Some("dup key"), position: Some(7) }
    match e {
        QueryError { sqlstate, detail, position } => {
            assert_eq(sqlstate, "23505")
            assert_eq(detail.unwrap(), "dup key")
            assert_eq(position.unwrap(), 7)
        }
        Other => assert_eq(1, 0)
    }
}
