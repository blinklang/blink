// Bug 295z9x (body path): a generic fn that builds and returns a tuple
// (M, Option[UserEnum], ...) in its body lowered the body tuple literal as
// blink_Tuple_..._Cmd (Option wrapper + module prefix dropped), while its
// signature used the canonical blink_Tuple..._Option_<mod>_Cmd. The C compiler
// then rejected `return _tup;` as a type mismatch.
//
// The fix sets cg_current_fn_node in emit_mono_fn_def so emit_tuple_lit can
// recover the fn's declared return annotation and route the body tuple through
// resolve_tuple_ann (preserving Option[T]'s T). Earlier 2-tuple repros were
// masked: a sibling fn (e.g. the `upd` callback) returning the same-arity tuple
// left a matching stale cg_current_fn_node that accidentally supplied a correct
// annotation. The arity-3 return below has no sibling match, so only the fn's
// own annotation can name it — making this a true red/green regression.
import test_295z9x_generic_tuple_option_body_helper
import test_295z9x_generic_tuple_option_body_helper.{Cmd}

type Model { count: Int }

fn upd(m: Model) -> (Model, Option[Cmd]) {
    (m, Some(Cmd.Quit))
}

test "generic fn building+returning (M, Option[enum], Int) lowers one canonical body tuple" {
    let (m, c, n) = test_295z9x_generic_tuple_option_body_helper.step(Model { count: 7 }, upd)
    assert_eq(m.count, 7)
    assert_eq(c.is_some(), 1)
    assert_eq(n, 0)
}
