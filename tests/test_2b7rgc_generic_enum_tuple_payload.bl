// A generic enum instance whose variant payload is a Tuple must lower the variant
// field to the tuple carrier type, the same as the base/non-generic emitter does.
// emit_enum_typedef got a Tuple branch (w6nqwx), but emit_mono_enum_typedef fell
// through to c_field_type_str(type_from_name("Tuple"), ...) = void, so a generic
// instance `E[P]` emitted a `void pair;` union member and the C compiler failed.
// The fix mirrors the base emitter's Tuple branch under typevar substitution:
// resolve_tuple_ann(vf_type_ann, tparams_sl, segs) then c_type_c_name.

import compile_test_helpers

fn src_structlit_tuple() -> Str {
    #"import std.io

type P { x: Int, y: Int }

type E[T] {
    V { pair: (T, T) }
}

fn main() {
    let e: E[P] = E.V { pair: (P { x: 7, y: 8 }, P { x: 9, y: 10 }) }
    match e {
        E.V { pair } => io.println("a={pair.0.x} b={pair.1.y}")
    }
}
"#
}

fn src_structlit_tuple_destructure() -> Str {
    #"import std.io

type P { x: Int, y: Int }

type E[T] {
    V { pair: (T, T) }
}

fn main() {
    let e: E[P] = E.V { pair: (P { x: 7, y: 8 }, P { x: 9, y: 10 }) }
    match e {
        E.V { pair: (a, b) } => io.println("a={a.x} b={b.y}")
    }
}
"#
}

fn src_positional_tuple() -> Str {
    #"import std.io

type P { x: Int, y: Int }

type E[T] {
    V((T, T))
}

fn main() {
    let e: E[P] = E.V((P { x: 1, y: 2 }, P { x: 3, y: 4 }))
    match e {
        E.V(t) => io.println("a={t.0.x} b={t.1.y}")
    }
}
"#
}

fn src_typevar_bound_to_tuple() -> Str {
    #"import std.io

type Box[T] { One(x: T), Empty }

fn main() {
    let b: Box[(Int, Int)] = Box.One((3, 4))
    match b {
        Box.One(p) => io.println("{p.0} {p.1}")
        Box.Empty => io.println("empty")
    }
}
"#
}

test "generic enum instance typevar field bound to a tuple type-arg lowers the carrier" {
    let r = compile_test_helpers.compile_and_run(src_typevar_bound_to_tuple(), "2b7rgc_typevar")
    if !r.out.contains("3 4") {
        compile_test_helpers.expect_contains(r.out, "3 4", "generic enum typevar-to-tuple — got '{r.err_out}'")
    }
    assert(r.out.contains("3 4"))
    assert_eq(r.exit_code, 0)
}

fn src_refutable_tuple_element() -> Str {
    #"import std.io

type E[T] { V((T, T)) }

fn main() {
    let e: E[Int] = E.V((5, 2))
    match e {
        E.V((1, b)) => io.println("one,{b}")
        E.V((a, b)) => io.println("other,{a},{b}")
    }
}
"#
}

test "generic enum instance refutable Tuple element gates the arm" {
    let r = compile_test_helpers.compile_and_run(src_refutable_tuple_element(), "2b7rgc_refut")
    if !r.out.contains("other,5,2") {
        compile_test_helpers.expect_contains(r.out, "other,5,2", "generic enum refutable tuple element — got '{r.err_out}'")
    }
    assert(r.out.contains("other,5,2"))
    assert(!r.out.contains("one,"))
    assert_eq(r.exit_code, 0)
}

test "generic enum instance struct-literal Tuple payload lowers to the tuple carrier type" {
    let r = compile_test_helpers.compile_and_run(src_structlit_tuple(), "2b7rgc_structlit")
    if !r.out.contains("a=7 b=10") {
        compile_test_helpers.expect_contains(r.out, "a=7 b=10", "generic enum structlit tuple payload — got '{r.err_out}'")
    }
    assert(r.out.contains("a=7 b=10"))
    assert_eq(r.exit_code, 0)
}

test "generic enum instance struct-literal Tuple payload destructures into element bindings" {
    let r = compile_test_helpers.compile_and_run(src_structlit_tuple_destructure(), "2b7rgc_structlit_destr")
    if !r.out.contains("a=7 b=10") {
        compile_test_helpers.expect_contains(r.out, "a=7 b=10", "generic enum structlit tuple destructure — got '{r.err_out}'")
    }
    assert(r.out.contains("a=7 b=10"))
    assert_eq(r.exit_code, 0)
}

fn src_positional_tuple_destructure() -> Str {
    #"import std.io

type P { x: Int, y: Int }

type E[T] { V((T, T)) }

fn main() {
    let e: E[P] = E.V((P { x: 7, y: 8 }, P { x: 9, y: 10 }))
    match e {
        E.V((a, b)) => io.println("a={a.x} b={b.y}")
    }
}
"#
}

test "generic enum instance positional Tuple payload destructures into element bindings" {
    let r = compile_test_helpers.compile_and_run(src_positional_tuple_destructure(), "2b7rgc_pos_destr")
    if !r.out.contains("a=7 b=10") {
        compile_test_helpers.expect_contains(r.out, "a=7 b=10", "generic enum positional tuple destructure — got '{r.err_out}'")
    }
    assert(r.out.contains("a=7 b=10"))
    assert_eq(r.exit_code, 0)
}

test "generic enum instance positional Tuple payload lowers to the tuple carrier type" {
    let r = compile_test_helpers.compile_and_run(src_positional_tuple(), "2b7rgc_positional")
    if !r.out.contains("a=1 b=4") {
        compile_test_helpers.expect_contains(r.out, "a=1 b=4", "generic enum positional tuple payload — got '{r.err_out}'")
    }
    assert(r.out.contains("a=1 b=4"))
    assert_eq(r.exit_code, 0)
}
