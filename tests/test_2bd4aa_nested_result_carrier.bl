// br 2bd4aa: a nested Result[Result[..],..] constructed via Ok(Ok(x)) (or the
// Err mirrors) must emit the INNER constructor with the INNER carrier type, not
// the outer one. Latent before the fix: the annotated Ok/Err path cleared
// cg_expect_arg_ann before recursing but left the OUTER cg_let_target_ann live,
// so the inner Ok(5) believed its type was the outer Result carrier and emitted
// `(blink_Result_Result_int_str_str){.tag=0, .ok = (blink_Result_Result_int_str_str){...}}`
// — a cc `incompatible types` failure. Symmetric on the Err side. The fix pushes
// the narrowed inner annotation (exp_ok_ann / exp_err_ann) as cg_let_target_ann.

test "Ok(Ok(x)) — inner Ok carries the inner Result type" {
    let r: Result[Result[Int, Str], Str] = Ok(Ok(5))
    match r {
        Ok(inner) => {
            match inner {
                Ok(v) => { assert_eq(v, 5) }
                Err(_e) => { assert(false) }
            }
        }
        Err(_e) => { assert(false) }
    }
}

test "Err(Ok(x)) — inner Ok in Err slot carries the inner Result type" {
    let r: Result[Int, Result[Int, Str]] = Err(Ok(9))
    match r {
        Ok(_v) => { assert(false) }
        Err(inner) => {
            match inner {
                Ok(v) => { assert_eq(v, 9) }
                Err(_e) => { assert(false) }
            }
        }
    }
}

test "Ok(Err(x)) — inner Err in Ok slot carries the inner Result type" {
    let r: Result[Result[Int, Str], Str] = Ok(Err("boom"))
    match r {
        Ok(inner) => {
            match inner {
                Ok(_v) => { assert(false) }
                Err(e) => { assert_eq(e, "boom") }
            }
        }
        Err(_e) => { assert(false) }
    }
}

test "Err(Err(x)) — inner Err in Err slot carries the inner Result type" {
    let r: Result[Int, Result[Int, Str]] = Err(Err("boom"))
    match r {
        Ok(_v) => { assert(false) }
        Err(inner) => {
            match inner {
                Ok(_v) => { assert(false) }
                Err(e) => { assert_eq(e, "boom") }
            }
        }
    }
}
