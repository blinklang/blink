// A list `.map(f)` adapter yields an eager List of the closure's RETURN type
// (sections/03c_protocols.md: list adapters are eager, list.map -> List[U]). The
// iterator's element must therefore be the map OUTPUT type, recovered from the
// authoritative typecheck tid — not the source element carried in the flat codegen
// channel, which erased the output to the source type for any cross-type map.
//
// Scope: a SINGLE-REGISTER output (scalar / pointer-carried). A by-value
// multi-eightbyte closure return (struct/tuple/Option/Result) rides a different
// carrier convention and is br s663bm — guarded loudly, not miscompiled.
//
// The element-preserving `filter` case at the bottom is the green boundary: it
// already round-trips a compound element and must stay green.

test "map Int->Str collect yields List[Str]" {
    let mut nums: List[Int] = []
    nums.push(1)
    nums.push(2)
    nums.push(3)
    let words = nums.map(fn(x: Int) -> Str { "n{x}" }).collect()
    assert_eq(words.len(), 3)
    assert_eq(words.get(0).unwrap(), "n1")
    assert_eq(words.get(2).unwrap(), "n3")
}

test "for-in over map Int->Str binds Str" {
    let mut nums: List[Int] = []
    nums.push(1)
    nums.push(2)
    nums.push(3)
    let mut acc = ""
    for w in nums.map(fn(x: Int) -> Str { "n{x}" }) {
        acc = acc.concat(w)
    }
    assert_eq(acc, "n1n2n3")
}

test "map Int->Bool collect yields List[Bool]" {
    let mut nums: List[Int] = []
    nums.push(1)
    nums.push(2)
    nums.push(3)
    let flags = nums.map(fn(x: Int) -> Bool { x > 1 }).collect()
    assert_eq(flags.len(), 3)
    assert_eq(flags.get(0).unwrap(), false)
    assert_eq(flags.get(2).unwrap(), true)
}

test "filter over List[Option[Int]] preserves element (green boundary)" {
    let mut xs: List[Option[Int]] = []
    xs.push(Some(1))
    xs.push(None)
    xs.push(Some(3))
    let kept = xs.filter(fn(o: Option[Int]) -> Bool { o.is_some() }).collect()
    assert_eq(kept.len(), 2)
    assert_eq(kept.get(0).unwrap().unwrap(), 1)
    assert_eq(kept.get(1).unwrap().unwrap(), 3)
}
