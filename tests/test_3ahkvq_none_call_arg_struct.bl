// Regression for 3ahkvq: a `None` literal passed as a call argument must adopt
// the parameter's expected Option[Struct] type. Previously codegen emitted a
// bare `Option_int` carrier for the None argument, producing a C "incompatible
// types" error against the `Option_Box` parameter.
type Box { val: Int }

fn take_opt(o: Option[Box]) -> Int {
    match o {
        Some(b) => { return b.val }
        None => { return -1 }
    }
}

fn get_box(o: Option[Box]) -> Box {
    match o {
        Some(b) => { b }
        None => { Box { val: -1 } }
    }
}

test "None call-arg adopts Option[Box] param type" {
    assert_eq(take_opt(Some(Box { val: 7 })), 7)
    assert_eq(take_opt(None), -1)
}

test "Option[Box] block-arm match returns struct payload" {
    assert_eq(get_box(Some(Box { val: 9 })).val, 9)
    assert_eq(get_box(None).val, -1)
}
