// A struct-style variant sub-pattern that destructures a self-recursive field
// further (`{ tail: LL.Cons { .. } }`, not just an ident rename) must unbox the
// self-recursive field before reading the inner variant's tag and payload. The
// field is stored boxed as int64_t, so both the match condition and the inner
// binding need `*(blink_LL_0Int*)(intptr_t)...`; the recursion path emitted flat
// member access on the box (`.tail.tag`, `void h2 = .tail.data.Cons.head`).

import compile_test_helpers

fn src_nested_destructure() -> Str {
    #"import std.io

type LL[T] { Nil, Cons { head: T, tail: LL[T] } }

fn main() {
    let n: LL[Int] = LL.Nil
    let mid: LL[Int] = LL.Cons { head: 2, tail: n }
    let top: LL[Int] = LL.Cons { head: 1, tail: mid }
    match top {
        LL.Cons { tail: LL.Cons { head: h2, tail: _ } } => io.println("h2={h2}")
        _ => io.println("other")
    }
}
"#
}

test "nested destructure of a boxed self-recursive field unboxes before reading the inner variant" {
    let r = compile_test_helpers.compile_and_run(src_nested_destructure(), "3f05zr_nested")
    if !r.out.contains("h2=2") {
        compile_test_helpers.expect_contains(r.out, "h2=2", "nested selfrec destructure — got '{r.out}' / '{r.err_out}'")
    }
    assert(r.out.contains("h2=2"))
    assert(!r.out.contains("other"))
    assert_eq(r.exit_code, 0)
}

fn src_nested_destructure_head_and_tail() -> Str {
    #"import std.io

type LL[T] { Nil, Cons { head: T, tail: LL[T] } }

fn main() {
    let n: LL[Int] = LL.Nil
    let mid: LL[Int] = LL.Cons { head: 20, tail: n }
    let top: LL[Int] = LL.Cons { head: 10, tail: mid }
    match top {
        LL.Cons { head: h1, tail: LL.Cons { head: h2, tail: _ } } => io.println("h1={h1} h2={h2}")
        _ => io.println("other")
    }
}
"#
}

test "nested destructure binds both the outer head and the inner unboxed head" {
    let r = compile_test_helpers.compile_and_run(src_nested_destructure_head_and_tail(), "3f05zr_both")
    if !r.out.contains("h1=10 h2=20") {
        compile_test_helpers.expect_contains(r.out, "h1=10 h2=20", "nested selfrec destructure both — got '{r.out}' / '{r.err_out}'")
    }
    assert(r.out.contains("h1=10 h2=20"))
    assert(!r.out.contains("other"))
    assert_eq(r.exit_code, 0)
}

fn src_positional_nested_destructure() -> Str {
    #"import std.io

type LL[T] { Nil, Cons(T, LL[T]) }

fn main() {
    let n: LL[Int] = LL.Nil
    let mid: LL[Int] = LL.Cons(2, n)
    let top: LL[Int] = LL.Cons(1, mid)
    match top {
        LL.Cons(h1, LL.Cons(h2, _)) => io.println("h1={h1} h2={h2}")
        _ => io.println("other")
    }
}
"#
}

test "positional nested destructure unboxes the self-recursive field" {
    let r = compile_test_helpers.compile_and_run(src_positional_nested_destructure(), "3f05zr_pos")
    if !r.out.contains("h1=1 h2=2") {
        compile_test_helpers.expect_contains(r.out, "h1=1 h2=2", "positional nested selfrec destructure — got '{r.out}' / '{r.err_out}'")
    }
    assert(r.out.contains("h1=1 h2=2"))
    assert(!r.out.contains("other"))
    assert_eq(r.exit_code, 0)
}

fn src_three_level_condition() -> Str {
    #"import std.io

type LL[T] { Nil, Cons(T, LL[T]) }

fn main() {
    let n: LL[Int] = LL.Nil
    let a: LL[Int] = LL.Cons(3, n)
    let b: LL[Int] = LL.Cons(2, a)
    let c: LL[Int] = LL.Cons(1, b)
    match c {
        LL.Cons(_, LL.Cons(_, LL.Cons(h3, _))) => io.println("h3={h3}")
        _ => io.println("other")
    }
}
"#
}

test "three-level nested condition threads the mono stem through every deref" {
    let r = compile_test_helpers.compile_and_run(src_three_level_condition(), "3f05zr_3lvl")
    if !r.out.contains("h3=3") {
        compile_test_helpers.expect_contains(r.out, "h3=3", "three-level nested selfrec condition — got '{r.out}' / '{r.err_out}'")
    }
    assert(r.out.contains("h3=3"))
    assert(!r.out.contains("other"))
    assert_eq(r.exit_code, 0)
}
