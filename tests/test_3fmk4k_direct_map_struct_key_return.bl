// br 3fmk4k — key-side twin of cwb2my. A DIRECT (no-intermediate-let) call to a
// generic fn returning Map[StructInstance, V], e.g. Map[Box[Int], Str], resolves
// the key name to the mono instance (Box_Int) that no base-type registry holds,
// so the string-only KEY gate fails closed and the key struct type is lost —
// the emitted C declares `void _mkey = (void)(...)`. The authoritative tid must
// admit the key when its slot names a struct instance, symmetric with the value
// gate. A computed key (Box { value: n } from a variable) defeats any literal
// short-circuit so the round-trip actually exercises the struct-key kops.

@derive(Hash, Eq)
type Box[T] { value: T }

fn build_map[K, V](k: K, v: V) -> Map[K, V] {
    let mut m: Map[K, V] = Map()
    m.insert(k, v)
    m
}

test "direct call returning Map[Box[Int], Str] keeps the key struct type" {
    let n = 1
    let got = build_map(Box { value: n }, "x").get(Box { value: n })
    assert_eq(got.unwrap(), "x")
}

test "direct-call struct key misses on a different key" {
    let got = build_map(Box { value: 5 }, "y").get(Box { value: 6 })
    assert(got.is_none())
}
