// A self-recursive generic enum whose variant payload is a TUPLE of the enum
// itself (`Pair(p: (Box[T], Box[T]))`) must box that tuple field, exactly as a
// direct self-recursive field (`tail: Box[T]`) is boxed. Spelled by value the
// mono tuple carrier embeds `blink_Box_0Int` on both sides — an infinitely-sized
// type, and its typedef is forced BEFORE the enum it depends on (forward-ref).
// The ctor must heap-box the tuple, the enum union member is a bare int64_t, and
// the match binder derefs the boxed pointer through the mono tuple C type. This
// is the tuple-of-same-base tail of the e1f78s self-recursive-enum family.

import compile_test_helpers

fn src_pair_leaf() -> Str {
    #"import std.io

type Box[T] { Pair(p: (Box[T], Box[T])), Leaf(v: T) }

fn main() {
    let b: Box[Int] = Box.Leaf(5)
    match b {
        Box.Leaf(v) => io.println("leaf {v}")
        Box.Pair(p) => io.println("pair")
    }
}
"#
}

test "self-recursive tuple-field enum compiles and matches the Leaf arm" {
    let r = compile_test_helpers.compile_and_run(src_pair_leaf(), "41v64m_leaf")
    if !r.out.contains("leaf 5") {
        compile_test_helpers.expect_contains(r.out, "leaf 5", "selfrec tuple-field Leaf — got '{r.out}' / '{r.err_out}'")
    }
    assert(r.out.contains("leaf 5"))
    assert(!r.out.contains("pair"))
    assert_eq(r.exit_code, 0)
}

fn src_pair_walk() -> Str {
    #"import std.io

type Box[T] { Pair(p: (Box[T], Box[T])), Leaf(v: T) }

fn sum(b: Box[Int]) -> Int {
    match b {
        Box.Leaf(v) => v
        Box.Pair(p) => sum(p.0) + sum(p.1)
    }
}

fn main() {
    let l: Box[Int] = Box.Leaf(3)
    let r: Box[Int] = Box.Leaf(4)
    let root: Box[Int] = Box.Pair((l, r))
    io.println("sum {sum(root)}")
}
"#
}

test "self-recursive tuple-field enum walks the boxed tuple through both elements" {
    let r = compile_test_helpers.compile_and_run(src_pair_walk(), "41v64m_walk")
    if !r.out.contains("sum 7") {
        compile_test_helpers.expect_contains(r.out, "sum 7", "selfrec tuple-field walk — got '{r.out}' / '{r.err_out}'")
    }
    assert(r.out.contains("sum 7"))
    assert_eq(r.exit_code, 0)
}

fn src_pair_walk_bare() -> Str {
    #"import std.io

type Box[T] { Pair(p: (Box[T], Box[T])), Leaf(v: T) }

fn sum(b: Box[Int]) -> Int {
    match b {
        Box.Leaf(v) => v
        Box.Pair(p) => sum(p.0) + sum(p.1)
    }
}

fn main() {
    let l: Box[Int] = Leaf(3)
    let r: Box[Int] = Leaf(4)
    let root: Box[Int] = Pair((l, r))
    io.println("sum {sum(root)}")
}
"#
}

test "unqualified self-recursive tuple-field ctor mono's and boxes the tuple" {
    let r = compile_test_helpers.compile_and_run(src_pair_walk_bare(), "41v64m_bare")
    if !r.out.contains("sum 7") {
        compile_test_helpers.expect_contains(r.out, "sum 7", "selfrec tuple-field bare ctor — got '{r.out}' / '{r.err_out}'")
    }
    assert(r.out.contains("sum 7"))
    assert_eq(r.exit_code, 0)
}

fn src_pair_walk_structstyle() -> Str {
    #"import std.io

type Box[T] { Pair(p: (Box[T], Box[T])), Leaf(v: T) }

fn sum(b: Box[Int]) -> Int {
    match b {
        Box.Leaf { v } => v
        Box.Pair { p } => sum(p.0) + sum(p.1)
    }
}

fn main() {
    let l: Box[Int] = Box.Leaf(3)
    let r: Box[Int] = Box.Leaf(4)
    let root: Box[Int] = Box.Pair { p: (l, r) }
    io.println("sum {sum(root)}")
}
"#
}

test "struct-style self-recursive tuple-field ctor and shorthand binder box+deref" {
    let r = compile_test_helpers.compile_and_run(src_pair_walk_structstyle(), "41v64m_structstyle")
    if !r.out.contains("sum 7") {
        compile_test_helpers.expect_contains(r.out, "sum 7", "selfrec tuple-field struct-style — got '{r.out}' / '{r.err_out}'")
    }
    assert(r.out.contains("sum 7"))
    assert_eq(r.exit_code, 0)
}
