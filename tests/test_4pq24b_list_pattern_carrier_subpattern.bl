// A list pattern whose ELEMENT sub-patterns are carrier patterns (Some/None/Ok/
// Err) over a List[Option[T]] or List[Result[T,E]] must read each element as a
// struct VALUE, not a scalar. A list stores an aggregate element BOXED, so the
// element read has to deref `*(T*)blink_list_get(...)` before the carrier arm can
// spell `.tag`/`.value`/`.ok`/`.err`. The condition path (pattern_condition) and
// the binder path (bind_pattern_vars) both have to agree on that read, or the
// generated C applies member access to a scalar and cc rejects it.
//
// This is distinct from t8xr2m (whole-element binders `[a, b]`): here the carrier
// is destructured in place by the pattern itself.

import compile_test_helpers

fn option_int_src() -> Str {
    #"import std.io

fn main() {
    let xs: List[Option[Int]] = [Some(7), None]
    match xs {
        [Some(a), None] => io.println("some {a}")
        _ => io.println("no")
    }
}
"#
}

test "list pattern with Some(binder)/None over List[Option[Int]]" {
    let r = compile_test_helpers.compile_and_run(option_int_src(), "4pq24b_option_int")
    if !r.out.contains("some 7") { compile_test_helpers.expect_contains(r.out, "some 7", "List[Option[Int]] carrier sub-pattern — got '{r.err_out}'") }
    assert(r.out.contains("some 7"))
}

fn result_src() -> Str {
    #"import std.io

fn main() {
    let xs: List[Result[Int, Str]] = [Ok(7), Err("bad")]
    match xs {
        [Ok(a), Err(m)] => io.println("ok {a} err {m}")
        _ => io.println("no")
    }
}
"#
}

test "list pattern with Ok(binder)/Err(binder) over List[Result[Int, Str]]" {
    let r = compile_test_helpers.compile_and_run(result_src(), "4pq24b_result")
    if !r.out.contains("ok 7 err bad") { compile_test_helpers.expect_contains(r.out, "ok 7 err bad", "List[Result] carrier sub-pattern — got '{r.err_out}'") }
    assert(r.out.contains("ok 7 err bad"))
}

fn option_struct_src() -> Str {
    #"import std.io

type P {
    x: Int
}

fn main() {
    let xs: List[Option[P]] = [Some(P { x: 9 }), None]
    match xs {
        [Some(p), None] => io.println("x {p.x}")
        _ => io.println("no")
    }
}
"#
}

test "list pattern with Some(struct binder)/None over List[Option[Struct]]" {
    let r = compile_test_helpers.compile_and_run(option_struct_src(), "4pq24b_option_struct")
    if !r.out.contains("x 9") { compile_test_helpers.expect_contains(r.out, "x 9", "List[Option[Struct]] carrier sub-pattern — got '{r.err_out}'") }
    assert(r.out.contains("x 9"))
}

fn literal_inner_src() -> Str {
    #"import std.io

fn main() {
    let xs: List[Option[Int]] = [Some(7), Some(8)]
    match xs {
        [Some(7), Some(b)] => io.println("lit {b}")
        _ => io.println("no")
    }
}
"#
}

test "list pattern with a literal carrier inner Some(7) gates on the value" {
    let r = compile_test_helpers.compile_and_run(literal_inner_src(), "4pq24b_literal_inner")
    if !r.out.contains("lit 8") { compile_test_helpers.expect_contains(r.out, "lit 8", "List[Option[Int]] literal inner — got '{r.err_out}'") }
    assert(r.out.contains("lit 8"))
}
