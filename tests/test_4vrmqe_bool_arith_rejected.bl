// Bool is not a numeric type: the arithmetic traits are sealed to the built-in numeric types
// (sections/03_types.md:1936), bitwise already excludes Bool (:801), operands must be the same
// type (:1970), and the language has no truthiness (DECISIONS.md:106). So `+ - * / %` must reject
// a Bool operand instead of silently counting it as 0/1 — which also made the sum display as
// `true`/`false` while comparing equal to its integer value.
//
// Rejection rows run through the compiler in a SUBPROCESS: they are compile errors, so an in-file
// row could not be red without failing to compile the whole test file.

import std.process.{ProcessResult}

fn check_src(tag: Str, src: Str) -> ProcessResult {
    let bl_path = ".tmp/_4vrmqe_{tag}.bl"
    write_file(bl_path, src)
    let r = process_run("build/blink", ["check", bl_path, "--format", "json"])
    shell_exec("rm -f {bl_path}")
    r
}

fn expect_rejected(tag: Str, src: Str) {
    let r = check_src(tag, src)
    let out = "{r.out}{r.err_out}"
    if r.exit_code == 0 { io.println("FAIL[{tag}] accepted, expected rejection") }
    assert(r.exit_code != 0)
    if !out.contains("E0300") { io.println("FAIL[{tag}] want E0300, got: {out}") }
    assert(out.contains("E0300"))
    if !out.contains("requires numeric operand") { io.println("FAIL[{tag}] want the numeric-operand rule, got: {out}") }
    assert(out.contains("requires numeric operand"))
    if !out.contains("Bool") { io.println("FAIL[{tag}] diagnostic must name Bool, got: {out}") }
    assert(out.contains("Bool"))
}

fn expect_accepted(tag: Str, src: Str) {
    let r = check_src(tag, src)
    let out = "{r.out}{r.err_out}"
    if r.exit_code != 0 { io.println("FAIL[{tag}] rejected, expected acceptance: {out}") }
    assert_eq(r.exit_code, 0)
}

// ── Every arithmetic operator rejects a Bool operand ─────────────────────────

test "Bool plus Bool is rejected" {
    expect_rejected("add", #"fn main() {
    let a = true
    let b = false
    let s = a + b
    io.println("{s}")
}
"#)
}

test "Bool minus Bool is rejected" {
    expect_rejected("sub", #"fn main() {
    let a = true
    let b = false
    let s = a - b
    io.println("{s}")
}
"#)
}

test "Bool times Bool is rejected" {
    expect_rejected("mul", #"fn main() {
    let a = true
    let b = false
    let s = a * b
    io.println("{s}")
}
"#)
}

test "Bool divided by Bool is rejected" {
    expect_rejected("div", #"fn main() {
    let a = true
    let b = true
    let s = a / b
    io.println("{s}")
}
"#)
}

test "Bool modulo Bool is rejected" {
    expect_rejected("mod", #"fn main() {
    let a = true
    let b = true
    let s = a % b
    io.println("{s}")
}
"#)
}

test "a Bool literal operand is rejected" {
    expect_rejected("lit", #"fn main() {
    let s = true + true
    io.println("{s}")
}
"#)
}

// A comparison result is the shape that made this look useful, and it is still a Bool.
test "the result of a comparison is not an arithmetic operand" {
    expect_rejected("cmp_operand", #"fn main() {
    let a = 1
    let b = 2
    let s = (a != 0) + (b != 0)
    io.println("{s}")
}
"#)
}

// ── Mixed Bool/Int, on either side ───────────────────────────────────────────

test "Bool plus Int is rejected" {
    expect_rejected("bool_int", #"fn main() {
    let a = true
    let s = a + 1
    io.println("{s}")
}
"#)
}

test "Int plus Bool is rejected" {
    expect_rejected("int_bool", #"fn main() {
    let b = true
    let s = 1 + b
    io.println("{s}")
}
"#)
}

// ── The compound forms carry the same operator, so the rule reaches them ─────

test "Bool plus-equals Bool is rejected" {
    expect_rejected("cmp_add", #"fn main() {
    let mut a = true
    a += true
    io.println("{a}")
}
"#)
}

test "Bool minus-equals Bool is rejected" {
    expect_rejected("cmp_sub", #"fn main() {
    let mut a = true
    a -= true
    io.println("{a}")
}
"#)
}

test "Bool times-equals Bool is rejected" {
    expect_rejected("cmp_mul", #"fn main() {
    let mut a = true
    a *= true
    io.println("{a}")
}
"#)
}

test "Bool divide-equals Bool is rejected" {
    expect_rejected("cmp_div", #"fn main() {
    let mut a = true
    a /= true
    io.println("{a}")
}
"#)
}

// ── Controls: what Bool operands ARE for, and what arithmetic IS for ─────────

test "logical operators still take Bool" {
    expect_accepted("logical", #"fn main() {
    let a = true
    let b = false
    io.println("{a && b} {a || b} {!a}")
}
"#)
}

test "comparisons still yield Bool" {
    expect_accepted("compare", #"fn main() {
    let a = 1
    let b = 2
    let c = a < b
    io.println("{c}")
}
"#)
}

test "Int arithmetic is unaffected" {
    expect_accepted("int_arith", #"fn main() {
    let a = 3
    let b = 4
    io.println("{a + b} {a - b} {a * b} {b / a} {b % a}")
}
"#)
}

test "Int compound assignment is unaffected" {
    expect_accepted("int_compound", #"fn main() {
    let mut a = 3
    a += 4
    a -= 1
    a *= 2
    a /= 3
    io.println("a={a}")
    assert_eq(a, 4)
}
"#)
}

test "Float arithmetic is unaffected" {
    expect_accepted("float_arith", #"fn main() {
    let a = 1.5
    let b = 0.5
    io.println("{a + b} {a - b} {a * b} {a / b}")
}
"#)
}

// The explicit spelling a Bool count has to use now.
test "an explicit 0/1 conditional sums as Int" {
    expect_accepted("explicit_count", #"fn main() {
    let a = true
    let b = false
    let s = (if a { 1 } else { 0 }) + (if b { 1 } else { 0 })
    io.println("s={s}")
    assert_eq(s, 1)
}
"#)
}
