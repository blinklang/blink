// br 5103fm: a `let` with a nested-tuple type annotation — `(Int, (Int, Int))` —
// crashed codegen. resolve_tuple_ann (codegen_types.bl) walked tuple elements but
// had no case for a nested-Tuple element: the inner tuple's name is "Tuple",
// type_from_name("Tuple") == CT_VOID, and it is neither struct nor enum, so it hit
// the bail (`return None`). emit_let_binding then `.unwrap()`ed the None and panicked
// (unwrap called on None at src/codegen_stmt.bl:2933). The fix recurses into the
// nested tuple annotation and embeds its C type by value, mirroring the struct branch.

fn emit_c(tag: Str, src: Str) -> Str {
    let bl_path = ".tmp/_test_{tag}.bl"
    write_file(bl_path, src)
    let _ = process_run("build/blink", ["build", bl_path, "--emit", "c"])
    let c_src = read_file("build/_test_{tag}.c")
    shell_exec("rm -f {bl_path} build/_test_{tag}.c")
    c_src
}

test "nested tuple let annotation does not crash codegen and is embedded by value" {
    let src = "fn main() \{\n    let p: (Int, (Int, Int)) = (1, (2, 3))\n    io.println(\"\{p.0\}\")\n\}\n"
    let c = emit_c("5103fm_emit", src)
    // The bug: codegen panicked before emitting any C. The fix: both the inner and
    // outer tuple typedefs are emitted, and the inner is embedded by value in the outer.
    assert(c.contains("blink_Tuple2_int_int"))
    assert(c.contains("blink_Tuple2_int_Tuple2_int_int"))
}

test "nested tuple let compiles and outer field is readable" {
    let src = "fn main() \{\n    let p: (Int, (Int, Int)) = (1, (2, 3))\n    io.println(\"a \{p.0\}\")\n\}\n"
    let bl_path = ".tmp/_5103fm_run.bl"
    write_file(bl_path, src)
    let bin = ".tmp/_5103fm_run"
    let build = process_run("build/blink", ["build", bl_path, "-o", bin])
    assert_eq(build.exit_code, 0)
    let r = process_run(bin, [])
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("a 1"))
    shell_exec("rm -f {bl_path} {bin}")
}

test "nested tuple element field access reads through the inner tuple" {
    let src = "fn main() \{\n    let p: (Int, (Int, Int)) = (1, (2, 3))\n    let inner = p.1\n    io.println(\"b \{inner.0\} \{inner.1\}\")\n\}\n"
    let bl_path = ".tmp/_5103fm_inner"
    write_file("{bl_path}.bl", src)
    let build = process_run("build/blink", ["build", "{bl_path}.bl", "-o", bl_path])
    assert_eq(build.exit_code, 0)
    let r = process_run(bl_path, [])
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("b 2 3"))
    shell_exec("rm -f {bl_path}.bl {bl_path}")
}

test "top-level nested-tuple global emits inner typedef before the outer" {
    // The global-let path (emit_top_level_let) eagerly emits the OUTER tuple typedef
    // out of the catch-all insertion order; the inner tuple it embeds by value must
    // be emitted first. emit_tuple_typedef now recurses into by-value tuple fields.
    let src = "let g: (Int, (Int, Int)) = (1, (2, 3))\nfn main() \{\n    let inner = g.1\n    io.println(\"g \{g.0\} \{inner.0\} \{inner.1\}\")\n\}\n"
    let bl_path = ".tmp/_5103fm_global"
    write_file("{bl_path}.bl", src)
    let build = process_run("build/blink", ["build", "{bl_path}.bl", "-o", bl_path])
    assert_eq(build.exit_code, 0)
    let r = process_run(bl_path, [])
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("g 1 2 3"))
    shell_exec("rm -f {bl_path}.bl {bl_path}")
}

test "nested tuple inside a Result carrier compiles and destructures" {
    let src = "fn main() \{\n    let res: Result[(Int, (Int, Int)), Str] = Ok((1, (2, 3)))\n    match res \{\n        Ok(t) => \{ let inner = t.1\n io.println(\"ok \{t.0\} \{inner.0\} \{inner.1\}\") \}\n        Err(_e) => \{ io.println(\"err\") \}\n    \}\n\}\n"
    let bl_path = ".tmp/_5103fm_result"
    write_file("{bl_path}.bl", src)
    let build = process_run("build/blink", ["build", "{bl_path}.bl", "-o", bl_path])
    assert_eq(build.exit_code, 0)
    let r = process_run(bl_path, [])
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("ok 1 2 3"))
    shell_exec("rm -f {bl_path}.bl {bl_path}")
}

test "nested tuple as a function parameter compiles and is readable" {
    // Exercises the parameter-typing paths in codegen_stmt.bl (resolve_tuple_ann
    // .unwrap() sites) that also bailed on nested-tuple annotations before the fix.
    let src = "fn combine(p: (Int, (Int, Int))) -> Int \{\n    let inner = p.1\n    return p.0 + inner.0 + inner.1\n\}\nfn main() \{\n    io.println(\"r \{combine((10, (20, 30)))\}\")\n\}\n"
    let bl_path = ".tmp/_5103fm_param"
    write_file("{bl_path}.bl", src)
    let build = process_run("build/blink", ["build", "{bl_path}.bl", "-o", bl_path])
    assert_eq(build.exit_code, 0)
    let r = process_run(bl_path, [])
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("r 60"))
    shell_exec("rm -f {bl_path}.bl {bl_path}")
}

test "triple-nested tuple let compiles and runs" {
    let src = "fn main() \{\n    let p: (Int, (Int, (Int, Int))) = (1, (2, (3, 4)))\n    let mid = p.1\n    let deep = mid.1\n    io.println(\"c \{p.0\} \{mid.0\} \{deep.0\} \{deep.1\}\")\n\}\n"
    let bl_path = ".tmp/_5103fm_deep"
    write_file("{bl_path}.bl", src)
    let build = process_run("build/blink", ["build", "{bl_path}.bl", "-o", bl_path])
    assert_eq(build.exit_code, 0)
    let r = process_run(bl_path, [])
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("c 1 2 3 4"))
    shell_exec("rm -f {bl_path}.bl {bl_path}")
}
