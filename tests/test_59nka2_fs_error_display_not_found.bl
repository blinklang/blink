// 59nka2 (fs-result-surface Stage 5): FsError implements Display and provides a
// not_found() predicate per sections/04_effects.md:837-861.
//   Display renders `op path: message`, where message is the OS strerror text.
//   not_found() is true exactly when the code is ENOENT (2 on Linux).
// FsError/FsOp are named via `import std.fs` (not prelude); Errno via std.errno.
import std.fs.{FsError, FsOp}
import std.errno.{Errno}

test "FsError.not_found() is true only for ENOENT" {
    let missing = FsError { op: FsOp.Read, path: "/etc/app.toml", code: Errno(2) }
    assert(missing.not_found())

    let denied = FsError { op: FsOp.Write, path: "/root/x", code: Errno(13) }
    assert(!denied.not_found())

    let del_missing = FsError { op: FsOp.Delete, path: "/x", code: Errno(2) }
    assert(del_missing.not_found())
}

test "FsError Display renders 'op path: message' with the OS message" {
    let e = FsError { op: FsOp.Read, path: "/etc/app.toml", code: Errno(2) }
    assert_eq("{e}", "read /etc/app.toml: No such file or directory")

    let e2 = FsError { op: FsOp.Write, path: "/root/x", code: Errno(13) }
    assert_eq("{e2}", "write /root/x: Permission denied")

    let e3 = FsError { op: FsOp.ListDir, path: "/tmp/d", code: Errno(20) }
    assert_eq("{e3}", "list_dir /tmp/d: Not a directory")

    let e4 = FsError { op: FsOp.Delete, path: "/x", code: Errno(2) }
    assert_eq("{e4}", "delete /x: No such file or directory")
}
