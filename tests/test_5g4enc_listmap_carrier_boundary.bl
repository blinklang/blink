// List[Map[K,V]].get()/.pop() must emit the ERASED Option-of-Map carrier
// (blink_Option_map), byte-matching every other Option[Map] producer (Some(m),
// the annotation path, tp_carrier_tag). Before the erase-everywhere migration
// these two sites hand-spelled a structured blink_Option_Map_str_int carrier, so
// a List[Map].get() result could not meet a Some(m)-built Option[Map] at an
// assignment, a fn-parameter, or a return boundary without a C nominal-type
// clash ("incompatible types ... blink_Option_map vs blink_Option_Map_str_int").
//
// The value type/struct is still recovered per-use from the tid so a downstream
// `.unwrap().get(k)` decodes V -- that is what test_m039bn pins; this test pins
// the carrier BOUNDARY, the axis m039bn never crosses.

// --- scalar value: assignment boundary (Some(m) vs l.get(0)) ---
fn pick_get(l: List[Map[Str, Int]], m: Map[Str, Int]) -> Option[Map[Str, Int]] {
    let mut o = Some(m)
    o = l.get(0)
    o
}

// --- scalar value: fn-parameter boundary (l.pop() into an Option[Map] param) ---
fn take_opt(o: Option[Map[Str, Int]]) -> Int {
    match o {
        Some(mm) => mm.get("k").unwrap()
        None => -1
    }
}

// --- struct value: boundary + downstream field read ---
type B5Point { x: Int, y: Int }

fn pick_struct(l: List[Map[Str, B5Point]], m: Map[Str, B5Point]) -> Option[Map[Str, B5Point]] {
    let mut o = Some(m)
    o = l.get(0)
    o
}

test "scalar Map value survives the List.get assignment boundary" {
    let mut m: Map[Str, Int] = Map()
    m.insert("k", 5)
    let l = [m]
    let r = pick_get(l, m)
    match r {
        Some(mm) => assert_eq(mm.get("k").unwrap(), 5)
        None => assert_eq(0, 1)
    }
}

test "scalar Map value survives the List.pop fn-parameter boundary" {
    let mut m: Map[Str, Int] = Map()
    m.insert("k", 7)
    let mut l = [m]
    assert_eq(take_opt(l.pop()), 7)
}

test "struct Map value survives the List.get boundary and reads its field" {
    let mut m: Map[Str, B5Point] = Map()
    m.insert("p", B5Point { x: 9, y: 2 })
    let l = [m]
    let r = pick_struct(l, m)
    match r {
        Some(mm) => assert_eq(mm.get("p").unwrap().x, 9)
        None => assert_eq(0, 1)
    }
}
