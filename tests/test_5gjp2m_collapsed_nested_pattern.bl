// br 5gjp2m: a COLLAPSED nested carrier pattern (`Ok(Ok(v))` in a single match
// arm, rather than two separate nested `match` statements) mistyped the
// innermost binder as the INTERMEDIATE carrier. The emitted C declared
// `blink_Result_int_str v = _scrut_0.ok.ok;` — LHS an intermediate carrier
// struct, RHS an int64_t — a cc `invalid initializer`. The `.ok.ok` field walk
// was correct; only the binder's DECLARED C type was wrong.
//
// Root cause: the nested-EnumPattern recursion seams in bind_pattern_vars and
// pattern_condition (src/codegen_stmt.bl) called unwrap_carrier without first
// re-deriving the carrier-shape globals (expr_result_ok_type/ok_struct/…) for
// the INNER carrier, so the depth-2 recursion read the OUTER carrier's shape.
// Sibling test_j8krjg covers the same depths via SEPARATE nested match
// statements; this test locks in the collapsed single-arm form.

test "Ok(Ok(v)) — innermost Int binder typed correctly (not the carrier)" {
    let r: Result[Result[Int, Str], Str] = Ok(Ok(5))
    let mut got = 0
    match r {
        Ok(Ok(v)) => got = v
        _ => {}
    }
    assert_eq(got, 5)
}

test "Ok(Ok(Ok(v))) — depth-3 collapsed innermost Int binder" {
    let r: Result[Result[Result[Int, Str], Str], Str] = Ok(Ok(Ok(7)))
    let mut got = 0
    match r {
        Ok(Ok(Ok(v))) => got = v
        _ => {}
    }
    assert_eq(got, 7)
}

test "Ok(Ok(s)) — innermost Str binder typed correctly" {
    let r: Result[Result[Str, Int], Str] = Ok(Ok("hi"))
    let mut got = ""
    match r {
        Ok(Ok(s)) => got = s
        _ => {}
    }
    assert_eq(got, "hi")
}

test "Ok(Err(e)) — collapsed, inner Err slot binds its Str payload" {
    let r: Result[Result[Int, Str], Str] = Ok(Err("boom"))
    let mut got = ""
    match r {
        Ok(Err(e)) => got = e
        _ => {}
    }
    assert_eq(got, "boom")
}

test "Err(Ok(v)) — collapsed, inner Result in Err slot binds Int" {
    let r: Result[Int, Result[Int, Str]] = Err(Ok(19))
    let mut got = 0
    match r {
        Err(Ok(v)) => got = v
        _ => {}
    }
    assert_eq(got, 19)
}

test "Ok(Some(v)) — Result-outer Option-inner collapsed binds Int" {
    let r: Result[Option[Int], Str] = Ok(Some(13))
    let mut got = 0
    match r {
        Ok(Some(v)) => got = v
        _ => {}
    }
    assert_eq(got, 13)
}

test "single-level Ok(v) still binds Int (no regression)" {
    let r: Result[Int, Str] = Ok(5)
    let mut got = 0
    match r {
        Ok(v) => got = v
        _ => {}
    }
    assert_eq(got, 5)
}

test "single-level Some(v) still binds Int (no regression)" {
    let r: Option[Int] = Some(9)
    let mut got = 0
    match r {
        Some(v) => got = v
        _ => {}
    }
    assert_eq(got, 9)
}
