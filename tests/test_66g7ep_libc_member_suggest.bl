// Did-you-mean diagnostic for a missing libc.*_bytes member (66g7ep).
//
// A typo'd qualified call like `libc.read_byte(...)` should surface a precise
// "no member 'read_byte' on module 'libc'" with a "did you mean 'libc.read_bytes'?"
// help line — not a generic codegen E0505 UnresolvedMethod with no hint.
//
// Threshold is conservative: a near typo (`read_byte`/`recv_byte`, dist 1)
// suggests; a far-off name gets no bogus suggestion. `recvfrom_bytes` is exactly
// dist 4 from `recv_bytes` (threshold 4 for its 14-char length), which the
// strict `dist < threshold` rule in suggest_module_member rejects — it is a
// deferred post-v1 UDP feature, NOT a misspelling of TCP `recv_bytes`.
//
// Spec: sections/07_trust_modules_metadata.md §9.1.3.3;
//       decisions/libc-bytes-wrapper-coverage.md.
import compile_test_helpers

// Each source imports a real libc member so `is_import_module_name("libc")` holds;
// the offending call then names a member that does not exist.
test "libc.read_byte typo suggests read_bytes" {
    let src = "import std.libc.\{read_bytes}\nfn main() \{ let _ = libc.read_byte(0, 8) }\n"
    let output = compile_test_helpers.compile_and_capture(src, "libc_read_byte_typo")
    assert(output.contains("did you mean"))
    assert(output.contains("read_bytes"))
}

test "libc.recv_byte typo suggests recv_bytes" {
    let src = "import std.libc.\{recv_bytes}\nfn main() \{ let _ = libc.recv_byte(0, 8) }\n"
    let output = compile_test_helpers.compile_and_capture(src, "libc_recv_byte_typo")
    assert(output.contains("did you mean"))
    assert(output.contains("recv_bytes"))
}

test "libc.recvfrom_bytes (deferred feature) reports missing member with NO suggestion" {
    let src = "import std.libc.\{recv_bytes}\nfn main() \{ let _ = libc.recvfrom_bytes(0, 8) }\n"
    let output = compile_test_helpers.compile_and_capture(src, "libc_recvfrom_deferred")
    assert(output.contains("no member 'recvfrom_bytes'"))
    assert(!output.contains("did you mean"))
}

test "libc.frobnicate (far-off garbage) reports missing member with NO suggestion" {
    let src = "import std.libc.\{read_bytes}\nfn main() \{ let _ = libc.frobnicate(0, 8) }\n"
    let output = compile_test_helpers.compile_and_capture(src, "libc_frobnicate")
    assert(output.contains("no member 'frobnicate'"))
    assert(!output.contains("did you mean"))
}
