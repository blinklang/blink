@derive(Debug)
type Color { Red, Green, Blue }

// Data-carrying enum: BOXED in container slots, so the Debug walker must keep
// the pointer deref. Present here to pin that path against the payload-less fix.
@derive(Debug)
type Shape { Circle(Int), Rect(Int, Int) }

@derive(Debug)
type Palette {
    name: Str,
    shades: List[Color],
}

@derive(Debug)
type Legend {
    swatches: Map[Str, Color],
}

@derive(Debug)
type Tinted {
    tint: Option[Color],
}

@derive(Debug)
type Drawing {
    shapes: List[Shape],
}

fn main() {
    let p = Palette { name: "sunset", shades: [Color.Red, Color.Blue] }
    assert_eq(p.debug(), "Palette \{ name: \"sunset\", shades: [Red, Blue] }")

    let empty = Palette { name: "blank", shades: [] }
    assert_eq(empty.debug(), "Palette \{ name: \"blank\", shades: [] }")

    let mut m: Map[Str, Color] = Map()
    m.insert("k", Color.Green)
    let leg = Legend { swatches: m }
    assert_eq(leg.debug(), "Legend \{ swatches: \{\"k\": Green} }")

    let some = Tinted { tint: Some(Color.Green) }
    assert_eq(some.debug(), "Tinted \{ tint: Some(Green) }")
    let none = Tinted { tint: None }
    assert_eq(none.debug(), "Tinted \{ tint: None }")

    let d = Drawing { shapes: [Shape.Circle(5), Shape.Rect(2, 3)] }
    assert_eq(d.debug(), "Drawing \{ shapes: [Circle(5), Rect(2, 3)] }")
}
