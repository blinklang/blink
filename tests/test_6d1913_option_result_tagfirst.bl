// 6d1913: assert_eq on Option/Result must compare TAG-FIRST, then only the
// ACTIVE arm — never whole-struct memcmp over the union. A whole-struct memcmp
// reads junk left in the inactive arm (the union bytes not written by the active
// constructor), so two values that ARE equal can spuriously compare unequal
// ("differ (tag X vs Y)").
//
// The latent junk-payload case is not deterministically reproducible from Blink
// source (it depends on stack/union residue), and an assert_eq FAILURE aborts
// the enclosing test rather than raising a catchable panic — so this is a
// REGRESSION-LOCK on the EQUALITY direction: every assert_eq below exercises the
// rewritten tag-first + per-arm comparator and must stay green. It covers every
// arm-type shape the per-arm comparator branches on: scalar Ok/Err, String
// Ok/Err, scalar Some, None. The value-difference direction is locked, for the
// one carrier where the boolean operator exists (scalar Option), via ==/!=,
// which use an independent tag-first codegen path.
//
// The codegen-level RED→GREEN signal is the C-emission test below: before the
// fix the emitted compare is a whole-struct `memcmp(&_left, &_right, sizeof(...))`
// over the union; after the fix it is tag-first (`_left.tag != _right.tag`).

import compile_test_helpers.{compile_and_emit_c}

test "Result assert_eq emits tag-first compare, not whole-struct memcmp" {
    let src = "test \"r\" \{\n    let a: Result[Int, Str] = Ok(7)\n    let b: Result[Int, Str] = Ok(7)\n    assert_eq(a, b)\n\}\n"
    let c = compile_and_emit_c(src, "6d1913_result_emit")
    // tag-first: the failure condition must lead with a tag comparison.
    assert(c.contains("_left.tag != _right.tag"))
    // and must NOT whole-struct memcmp the Result union (junk in inactive arm).
    assert(!c.contains("memcmp(&_left, &_right, sizeof(blink_Result"))
}

test "scalar Option assert_eq emits tag-first compare, not whole-struct memcmp" {
    let src = "test \"o\" \{\n    let a: Option[Int] = Some(5)\n    let b: Option[Int] = Some(5)\n    assert_eq(a, b)\n\}\n"
    let c = compile_and_emit_c(src, "6d1913_option_emit")
    assert(c.contains("_left.tag != _right.tag"))
    assert(!c.contains("memcmp(&_left, &_right, sizeof(blink_Option"))
}

test "assert_eq holds for equal Result (scalar Ok arm)" {
    let a: Result[Int, Str] = Ok(7)
    let b: Result[Int, Str] = Ok(7)
    assert_eq(a, b)
}

test "assert_eq holds for equal Result (String Ok arm)" {
    let a: Result[Str, Int] = Ok("hello")
    let b: Result[Str, Int] = Ok("hello")
    assert_eq(a, b)
}

test "assert_eq holds for equal Result (String Err arm)" {
    let a: Result[Int, Str] = Err("boom")
    let b: Result[Int, Str] = Err("boom")
    assert_eq(a, b)
}

test "assert_eq holds for equal Result (scalar Err arm)" {
    let a: Result[Str, Int] = Err(42)
    let b: Result[Str, Int] = Err(42)
    assert_eq(a, b)
}

test "assert_eq holds for equal scalar Option (Some)" {
    let a: Option[Int] = Some(5)
    let b: Option[Int] = Some(5)
    assert_eq(a, b)
}

test "assert_eq holds for equal scalar Option (None)" {
    let a: Option[Int] = None
    let b: Option[Int] = None
    assert_eq(a, b)
}

test "scalar Option inequality detected by ==" {
    let s5: Option[Int] = Some(5)
    let s6: Option[Int] = Some(6)
    let no: Option[Int] = None
    assert(s5 != s6)            // same tag, different value
    assert(s5 != no)            // different tag
    assert(s5 == s5)
    assert(no == no)
}
