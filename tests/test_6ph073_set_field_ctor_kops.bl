// br 6ph073: Set()/Map() in a struct-field initializer must select the kops
// vtable from the field's declared element type (cg_expect_arg_ann), not fall
// back to the string default. Latent before the fix: runtime happened to print
// the right answer (boxing is consistent within one instance), but the emitted
// C constructed a Set[Int] field with blink_kops_str. The emitted-C check is
// the true red/green signal (kops_str -> kops_i64); these runtime assertions
// anchor observable behavior and guard the two regressions the fix surfaced.
type Box { s: Set[Int] }
type MapBox { m: Map[Int, Str] }

test "set field ctor kops" {
    let b = Box { s: Set() }
    b.s.insert(5)
    assert(b.s.contains(5))
}

test "map field ctor kops" {
    let b = MapBox { m: Map() }
    b.m.insert(7, "seven")
    assert_eq(b.m.get(7).unwrap(), "seven")
}

fn take_int(x: Int) -> Int { x }

// The fix must not let a stale cg_expect_arg_ann (the OUTER call's Int param)
// shadow a block-local `let s: Set[Int] =`'s target: with 0x00-leading int
// keys, the wrong (string) kops strcmp-dedups 256 and 512 to len 1.
test "block-expr let-RHS Set inside call arg keeps int kops" {
    let n = take_int({
        let mut s: Set[Int] = Set()
        s.insert(256)
        s.insert(512)
        s.len()
    })
    assert_eq(n, 2)
}
