// br 6q5mz2: an Option[<bare-struct>] tuple element now RIDES the tid path.
// tc_tid_inner_tag_faithful gained a BARE-struct/enum arm: the leaf is admitted because the
// tid speller (tc_tid_inner_tag → c_type_tag_for_struct for a non-generic struct) is
// byte-equal to the value path — when the element rides, emit_tuple_lit spells the inner via
// tc_tid_inner_tag itself (not the divergent canonical_struct_tag fallback), so both the
// value carrier and the generic-fn mono param bottom out at the SAME c_type_tag_for_struct.
// This is the exact equivalence br 637sy9 proved for a DIRECT (non-Option-wrapped) struct
// tuple element.
//
// Each RIDE case is a Gen1==Gen2 byte-stability tripwire: the tid carrier the generic-fn
// mono mints must match the value-constructed tuple, or the mono param erases to void and
// the emitted C fails to compile — which task regen catches.
//
// NOW RIDES TOO (br bee854, see the INSTANCE tests at the bottom): a struct INSTANCE inner
// (Option[QBox[Int]]). It used to defer — the Option carrier typedef erased its value member
// to void*/bare-blink_QBox and minted a divergent bare carrier. bee854 threads the mono stem
// (QBox_Int) at every annotation-lowering site + registers the instance
// (register_carrier_inner_mono_instance) and relaxes tc_tid_inner_tag_faithful to admit a
// TK_STRUCT instance leaf, so both paths converge on the single blink_Option_QBox_Int.
// A generic-ENUM instance inner still DEFERS (waits on br 82ajft/dbzy4r); a Result carrier
// over a struct instance is a separate pre-existing gap (br z4tk66).

type P {
    x: Int,
}

type QBox[T] {
    v: T,
}

fn take_int[T](_x: T) -> Int {
    99
}

// The MVCE: a bare same-module struct inner (Option[P]) — direct construction.
test "(Option[P], Int) rides the tid path" {
    let p = (Some(P { x: 1 }), 7)
    assert_eq(take_int(p), 99)
}

// Driven through a generic fn over List[(Option[P], Int)] — the seed chain that mints the
// tid carrier (Tuple2_Option_P_int). This shape is BROKEN on clean main: the bare-var `a`'s
// get_var_struct returns the Option's inner struct "P", dropping the Option wrapper
// (Tuple2_P_int) so the element (blink_Option_P) mismatches the tuple field. The widened
// gate clears that sn (elem_rides_tid) and spells the full carrier via tc_tid_inner_tag.
fn count_opt_p(xs: List[(Option[P], Int)]) -> Int {
    xs.len()
}

test "generic-fn over List[(Option[P], Int)] seeds the tid carrier" {
    let a: Option[P] = Some(P { x: 1 })
    let xs: List[(Option[P], Int)] = [(a, 1)]
    assert_eq(count_opt_p(xs), 1)
}

// A bare-enum inner rides on the same footing (tc_tid_inner_tag routes a bare TK_ENUM through
// the same c_type_tag_for_struct pair as a bare struct).
type Color {
    Red,
    Green,
}

test "(Option[Color], Int) rides the tid path" {
    let c = (Some(Color.Red), 7)
    assert_eq(take_int(c), 99)
}

// br bee854: a struct INSTANCE inner (Option[QBox[Int]]) now RIDES the tid path — the
// companion to the bare-struct ride above. The bug: the annotation-lowering sites read the
// bare annotation head (is_struct_type(inner_name)) and thread strip_module_qualifier (= QBox),
// dropping the [Int] type-arg, so the Option carrier typedef minted blink_Option_QBox with a
// void*/undeclared-blink_QBox value member — divergent from the tid path's blink_Option_QBox_Int.
// The fix threads the mono stem (QBox_Int) via mono_name_from_ann + registers the instance, so
// BOTH the value carrier and the generic-fn mono param bottom out at the SAME
// blink_Option_QBox_Int (blink_QBox_Int* value). Gen1==Gen2 byte-stability is the tripwire.

// The MVCE (ticket): Option[QBox[Int]] tuple element, direct construction. Reuses the
// QBox[T] declared at the top of this file — the generic-struct instance inner.
test "(Option[QBox[Int]], Int) rides the tid path" {
    let b: QBox[Int] = QBox { v: 42 }
    let p = (Some(b), 7)
    assert_eq(take_int(p), 99)
}

// Driven through a generic fn over List[(Option[QBox[Int]], Int)] — the seed chain that mints
// the tid carrier (Tuple2_Option_QBox_Int_int). The generic-fn mono param must spell the same
// blink_Option_QBox_Int the value-constructed tuple field carries.
fn count_opt_qbox(xs: List[(Option[QBox[Int]], Int)]) -> Int {
    xs.len()
}

test "generic-fn over List[(Option[QBox[Int]], Int)] seeds the tid carrier" {
    let a: Option[QBox[Int]] = Some(QBox { v: 5 })
    let xs: List[(Option[QBox[Int]], Int)] = [(a, 1)]
    assert_eq(count_opt_qbox(xs), 1)
}
