// br 6q5mz2: an Option[<bare-struct>] tuple element now RIDES the tid path.
// tc_tid_inner_tag_faithful gained a BARE-struct/enum arm: the leaf is admitted because the
// tid speller (tc_tid_inner_tag → c_type_tag_for_struct for a non-generic struct) is
// byte-equal to the value path — when the element rides, emit_tuple_lit spells the inner via
// tc_tid_inner_tag itself (not the divergent canonical_struct_tag fallback), so both the
// value carrier and the generic-fn mono param bottom out at the SAME c_type_tag_for_struct.
// This is the exact equivalence br 637sy9 proved for a DIRECT (non-Option-wrapped) struct
// tuple element.
//
// Each RIDE case is a Gen1==Gen2 byte-stability tripwire: the tid carrier the generic-fn
// mono mints must match the value-constructed tuple, or the mono param erases to void and
// the emitted C fails to compile — which task regen catches.
//
// STILL DEFERS (see the guard tests at the bottom): a struct/enum INSTANCE inner
// (Option[QBox[Int]]) — the Option carrier typedef for an instance inner erases its value
// member to void*/bare-blink_QBox and mints a divergent bare carrier; that is a deeper
// carrier-member-emission gap (follow-up ticket). It stays on the string CSV, where it
// already compiles.

type P {
    x: Int,
}

type QBox[T] {
    v: T,
}

fn take_int[T](_x: T) -> Int {
    99
}

// The MVCE: a bare same-module struct inner (Option[P]) — direct construction.
test "(Option[P], Int) rides the tid path" {
    let p = (Some(P { x: 1 }), 7)
    assert_eq(take_int(p), 99)
}

// Driven through a generic fn over List[(Option[P], Int)] — the seed chain that mints the
// tid carrier (Tuple2_Option_P_int). This shape is BROKEN on clean main: the bare-var `a`'s
// get_var_struct returns the Option's inner struct "P", dropping the Option wrapper
// (Tuple2_P_int) so the element (blink_Option_P) mismatches the tuple field. The widened
// gate clears that sn (elem_rides_tid) and spells the full carrier via tc_tid_inner_tag.
fn count_opt_p(xs: List[(Option[P], Int)]) -> Int {
    xs.len()
}

test "generic-fn over List[(Option[P], Int)] seeds the tid carrier" {
    let a: Option[P] = Some(P { x: 1 })
    let xs: List[(Option[P], Int)] = [(a, 1)]
    assert_eq(count_opt_p(xs), 1)
}

// A bare-enum inner rides on the same footing (tc_tid_inner_tag routes a bare TK_ENUM through
// the same c_type_tag_for_struct pair as a bare struct).
type Color {
    Red,
    Green,
}

test "(Option[Color], Int) rides the tid path" {
    let c = (Some(Color.Red), 7)
    assert_eq(take_int(c), 99)
}

// DEFERRAL GUARD: a struct INSTANCE inner (Option[QBox[Int]]) must STILL compile by riding
// the string CSV — tc_tid_inner_tag_faithful defers a params_count != 0 leaf. A too-loose
// gate that admitted it would mint a divergent bare blink_Option_QBox carrier (void* member,
// undeclared blink_QBox) alongside blink_Option_QBox_Int → C compile failure.
test "(Option[QBox[Int]], Int) stays on the string path" {
    let b: QBox[Int] = QBox { v: 42 }
    let p = (Some(b), 7)
    assert_eq(take_int(p), 99)
}
