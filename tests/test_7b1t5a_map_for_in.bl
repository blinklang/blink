// 7b1t5a: `for (k, v) in <Map>` compiled clean and ran zero iterations -- emit_for_in
// had no CT_MAP arm and fell into a bare "/* unsupported iterable */" comment.
// Fixed by walking the map's buckets directly in emitted C, materializing each
// pair as a Tuple2_<k>_<v> struct via finish_enum_zip_result (the same template
// enumerate()/zip() use), and reusing the CT_LIST loop emitter for the resulting
// pair list.
//
// Spec: sections/03c_protocols.md:178-186 (Map[K,V] -> (K,V), unspecified order);
// sections/03_types.md:1624,1660,3265 (the `for (key, value) in map` spelling).
// Per DECISIONS.md:335, Map iteration order is unspecified and randomized
// per-process -- these assert on sum/membership/count, never on order.

@derive(Hash, Eq)
type Pt { x: Int, y: Int }

test "for-in over Map[Str, Int]" {
    let mut m: Map[Str, Int] = Map()
    m.insert("a", 1)
    m.insert("bb", 2)
    m.insert("ccc", 3)
    let mut sum_v = 0
    let mut total_key_len = 0
    let mut count = 0
    for (k, v) in m {
        sum_v = sum_v + v
        total_key_len = total_key_len + k.len()
        count = count + 1
    }
    assert_eq(count, 3)
    assert_eq(sum_v, 6)
    assert_eq(total_key_len, 6)
}

test "for-in over Map[Int, Str]" {
    let mut m: Map[Int, Str] = Map()
    m.insert(1, "x")
    m.insert(2, "yy")
    m.insert(3, "zzz")
    let mut sum_k = 0
    let mut total_val_len = 0
    let mut count = 0
    for (k, v) in m {
        sum_k = sum_k + k
        total_val_len = total_val_len + v.len()
        count = count + 1
    }
    assert_eq(count, 3)
    assert_eq(sum_k, 6)
    assert_eq(total_val_len, 6)
}

test "for-in over Map[I8, Int] round-trips a negative key (narrow-width packing)" {
    let mut m: Map[I8, Int] = Map()
    m.insert(-1, 10)
    m.insert(5, 20)
    let mut found_neg = false
    let mut sum_v = 0
    let mut count = 0
    for (k, v) in m {
        if k == -1 {
            found_neg = true
        }
        sum_v = sum_v + v
        count = count + 1
    }
    assert_eq(count, 2)
    assert_eq(found_neg, true)
    assert_eq(sum_v, 30)
}

test "for-in over Map[Char, Int]" {
    let mut m: Map[Char, Int] = Map()
    m.insert('x', 1)
    m.insert('y', 2)
    let mut count = 0
    let mut found_x = false
    for (k, _v) in m {
        if k == 'x' {
            found_x = true
        }
        count = count + 1
    }
    assert_eq(count, 2)
    assert_eq(found_x, true)
}

test "for-in over Map[@derive(Hash,Eq) struct, Int]" {
    let mut m: Map[Pt, Int] = Map()
    m.insert(Pt { x: 1, y: 2 }, 10)
    m.insert(Pt { x: 3, y: 4 }, 20)
    let mut sum_x = 0
    let mut sum_v = 0
    let mut count = 0
    for (k, v) in m {
        sum_x = sum_x + k.x
        sum_v = sum_v + v
        count = count + 1
    }
    assert_eq(count, 2)
    assert_eq(sum_x, 4)
    assert_eq(sum_v, 30)
}

test "for-in over Map[(Int, Str), Int] tuple key" {
    let mut m: Map[(Int, Str), Int] = Map()
    m.insert((1, "a"), 100)
    m.insert((2, "bb"), 200)
    let mut sum_n = 0
    let mut total_len = 0
    let mut sum_v = 0
    let mut count = 0
    for (k, v) in m {
        sum_n = sum_n + k.0
        total_len = total_len + k.1.len()
        sum_v = sum_v + v
        count = count + 1
    }
    assert_eq(count, 2)
    assert_eq(sum_n, 3)
    assert_eq(total_len, 3)
    assert_eq(sum_v, 300)
}

test "for-in over an empty Map runs zero iterations" {
    let m: Map[Str, Int] = Map()
    let mut ran = false
    for (_k, _v) in m {
        ran = true
    }
    assert_eq(ran, false)
}

test "for-in over a Map reached through List[Map[Str, Int]]" {
    let mut a: Map[Str, Int] = Map()
    a.insert("a", 1)
    a.insert("b", 2)
    let mut b: Map[Str, Int] = Map()
    b.insert("c", 3)
    let maps: List[Map[Str, Int]] = [a, b]
    let mut total = 0
    let mut count = 0
    for inner in maps {
        for (_k, v) in inner {
            total = total + v
            count = count + 1
        }
    }
    assert_eq(count, 3)
    assert_eq(total, 6)
}
