// br 7xgbh6: the Stage 2 divergence counter must tap the for-in loop variable, not only `let`.
//
// `sv_ty_or_flat_at` was called from exactly ONE codegen site, `emit_let_binding.decl`, so the
// counter Stage 3 uses as its exit criterion measured let declarations and nothing else. A
// corpus sweep confirmed the tap population rather than merely the call count: all 4860 tydiv
// diverge rows on the 958-file basis reported that one site.
//
// br w224zg is the demonstration of what that hides. It fixed a map for-in pair whose element
// was wrong three ways — an honest UnresolvedMethod, a segfault, and a cc error with no Blink
// span — and the census read 4836 rows / 419 cells before AND after, because a for-in loop
// variable is never compared against its tid.
//
// So "drive the divergence counter to 0" meant "no let declaration disagrees with its tid". A
// for-in variable is a ScopeVar declaration exactly like a `let` is, and it needs both halves of
// Stage 2's dual-write: typecheck publishes the iteration element on the ForIn node (the way the
// WithResource arm publishes a resource's tid, br w089a0), and codegen stamps it onto the loop
// variable's ScopeVar and then measures the stamp against the flat fields.
//
// ADVISORY ONLY, like every other Stage 2 dual-write: the stamped tid is discarded at the tap and
// the flat fields still govern every emit decision, so the emitted C does not change. What
// changes is that the counter can see the site at all — and the row count is expected to RISE
// when a tap lands, which is the instrument getting honest, not a regression.
//
// Asserts through a real child process, for the same reason br k9agr8's test does: the claim is
// about what a compiler run reports, and only running one can observe it.

import std.process.{ProcessResult}

// A for-in over a Map returned by a CALL is the shape w224zg measured: a call receiver has no
// ScopeVar, so the flat accessors answer sv_tp's fabricated CT_STRING/CT_INT defaults while the
// tid says Map[Str, List[Int]]. The plain `for x in xs` and the destructured `for (k, v) in m`
// loops are here so the probe covers the ordinary shapes too.
let PROBE_SRC: Str = #"fn mk() -> Map[Str, List[Int]] {
    let mut m: Map[Str, List[Int]] = Map()
    m.insert("a", [5, 6])
    m
}

fn main() {
    let xs: List[Int] = [1, 2, 3]
    for x in xs { io.println("{x}") }
    for pair in mk() { io.println("{pair.0}") }
    for (k, v) in mk() { io.println("{k} {v.len()}") }
}
"#

fn probe_path() -> Str { "build/7xgbh6_probe.bl" }

fn run_tydiv() -> ProcessResult {
    process_run("sh", ["-c", "env BLINK_TRACE_CHANNELS=tydiv build/blinkc {probe_path()} build/7xgbh6_probe.c 2>&1"])
}

// br 83ywd6: `build/blinkc` exits 0 even when it reports errors, so `assert_eq(r.exit_code, 0)`
// does not establish that the probe compiled — this file's first draft passed that assertion on a
// probe with a parse error and no codegen at all. Assert on the absence of a diagnostic instead.
fn compiled_clean(out: Str) -> Bool {
    !out.contains("error[")
}

fn have_blinkc() -> Bool {
    file_exists("build/blinkc") == 1
}

test "the for-in loop variable is a tapped declaration site" {
    if !have_blinkc() {
        skip("build/blinkc is not present in this working tree")
        return
    }
    write_file(probe_path(), PROBE_SRC)
    let r = run_tydiv()
    fs.remove(probe_path())
    assert_eq(r.exit_code, 0)
    assert(compiled_clean(r.out))
    // The site key, in either shape the instrument prints it: `site=` on a per-occurrence
    // diverge/missing row, bare on the end-of-run summary row.
    assert(r.out.contains("emit_for_in.var"))
}

test "the let site is still tapped" {
    if !have_blinkc() {
        skip("build/blinkc is not present in this working tree")
        return
    }
    write_file(probe_path(), PROBE_SRC)
    let r = run_tydiv()
    fs.remove(probe_path())
    // Control: a new tap must not displace the one the published census is measured with.
    assert_eq(r.exit_code, 0)
    assert(compiled_clean(r.out))
    assert(r.out.contains("emit_let_binding.decl"))
}

test "a map for-in variable carries a tid to compare" {
    if !have_blinkc() {
        skip("build/blinkc is not present in this working tree")
        return
    }
    write_file(probe_path(), PROBE_SRC)
    let r = run_tydiv()
    fs.remove(probe_path())
    assert_eq(r.exit_code, 0)
    assert(compiled_clean(r.out))
    // `missing` means the ScopeVar was never stamped, which is the half of the dual-write that
    // lives in typecheck (the ForIn node publishing its element type). A tap that can only ever
    // answer `missing` measures nothing, so the row must be an agree or a diverge — i.e. the
    // site appears with a nonzero agree-or-diverge count in its summary line.
    let mut saw_comparable = false
    for line in r.out.split("\n") {
        if line.contains("emit_for_in.var") && line.contains("agree=") {
            if !line.contains("agree=0 diverge=0") { saw_comparable = true }
        }
    }
    assert(saw_comparable)
}

test "the tap stays off when nobody is measuring" {
    if !have_blinkc() {
        skip("build/blinkc is not present in this working tree")
        return
    }
    write_file(probe_path(), PROBE_SRC)
    let r = process_run("sh", ["-c", "env -u BLINK_TRACE_CHANNELS build/blinkc {probe_path()} build/7xgbh6_probe.c 2>&1"])
    fs.remove(probe_path())
    assert_eq(r.exit_code, 0)
    assert(compiled_clean(r.out))
    assert(!r.out.contains("[dbg:"))
}
