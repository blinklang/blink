// br 7xgbh6 sub-step 3: the `with X as r` resource binder is a ScopeVar declaration, and the
// divergence counter must tap it.
//
// w089a0 already made codegen stamp the binder's tid (`set_var_ty(binding, tc_lookup_node_tid(item))`),
// but stamping is not measuring: with no `sv_ty_or_flat_at` call the binder stayed a declaration the
// counter could not see, exactly like the for-in loop variable before sub-step 1.
//
// This is one site, not the two the ticket's wording ("with/catch bindings") suggests. Blink has no
// catch clause — `rg Catch src/ast.bl src/parser.bl src/codegen*.bl` finds nothing, because effects
// and `Result` carry failure — so there is no second binder to tap alongside it.
//
// Advisory, like every Stage 2 dual-write: the answer is discarded and the flat fields still govern
// every branch.

import std.fs
import std.process.{ProcessResult}

// A struct resource is the honest shape here: `Closeable` is implemented on nominal types, so the
// binder's type is depth 1 and the tid and the flat `(CT_STRUCT, sname)` pair CAN agree. The test
// therefore asserts the site compares, not that it diverges — a tap that fires and agrees is a
// working tap, and claiming a divergence the shape cannot produce would be a false expectation.
let PROBE_SRC: Str = #"type Res { tag: Str }

impl Closeable for Res {
    fn close(self) { io.println("close {self.tag}") }
}

fn main() {
    with Res { tag: "A" } as r {
        io.println("open {r.tag}")
    }
}
"#

fn probe_path() -> Str { "build/7xgbh6_wr_probe.bl" }

fn run_tydiv() -> ProcessResult {
    process_run("sh", ["-c", "env BLINK_TRACE_CHANNELS=tydiv build/blinkc {probe_path()} build/7xgbh6_wr_probe.c 2>&1"])
}

// br 83ywd6: `build/blinkc` exits 0 even when it reports errors, so `assert_eq(r.exit_code, 0)`
// does not establish that the probe compiled. Assert on the absence of a diagnostic instead.
fn compiled_clean(out: Str) -> Bool {
    !out.contains("error[")
}

fn have_blinkc() -> Bool {
    file_exists("build/blinkc") == 1
}

test "the with-resource binder is a tapped declaration site" {
    if !have_blinkc() {
        skip("build/blinkc is not present in this working tree")
        return
    }
    write_file(probe_path(), PROBE_SRC)
    let r = run_tydiv()
    let _ = fs.delete(probe_path())
    assert_eq(r.exit_code, 0)
    assert(compiled_clean(r.out))
    assert(r.out.contains("with_resource.bind"))
}

test "the with-resource tap compares rather than only answering missing" {
    if !have_blinkc() {
        skip("build/blinkc is not present in this working tree")
        return
    }
    write_file(probe_path(), PROBE_SRC)
    let r = run_tydiv()
    let _ = fs.delete(probe_path())
    assert_eq(r.exit_code, 0)
    assert(compiled_clean(r.out))
    // A tap that can only answer `missing` measures nothing: it says "no tid was stamped" and never
    // "the two representations disagree".
    let mut saw_comparable = false
    for line in r.out.split("\n") {
        if line.contains("with_resource.bind") && line.contains("agree=") {
            if !line.contains("agree=0 diverge=0") { saw_comparable = true }
        }
    }
    assert(saw_comparable)
}

test "the let site is still tapped" {
    if !have_blinkc() {
        skip("build/blinkc is not present in this working tree")
        return
    }
    write_file(probe_path(), PROBE_SRC)
    let r = run_tydiv()
    let _ = fs.delete(probe_path())
    // Control: a new tap must not displace the one the published census is measured with.
    assert_eq(r.exit_code, 0)
    assert(compiled_clean(r.out))
    assert(r.out.contains("emit_let_binding.decl"))
}
