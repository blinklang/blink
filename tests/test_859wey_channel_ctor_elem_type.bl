// An unannotated `Channel(n)` once took its element from a later send, the way `Map()` and
// `Set()` take theirs from a later insert. The spec builds a channel only through
// `channel.new[T](buffer: N)` (sections/04_effects.md), which writes the element at the
// construction site, so every unannotated shape below is now refused as an undefined
// function with that repair, whatever element a later send or read would have implied.
//
// Each shape reads the element in a different position (recv, the for-in binder, a later
// distinct read), so each is kept: a refusal that only one position reaches would let the
// others back into inference.
//
// The annotated controls build through `channel.new[T]`, which is the route that still
// exists, and must keep carrying a Str and a struct element through recv and for-in.

import compile_test_helpers

type Msg { n: Int }

fn assert_refused(body: Str, tag: Str) {
    let src = "import std.io\n\ntype Msg \{ n: Int }\n\nfn main() \{\n{body}\n}\n"
    let out = compile_test_helpers.compile_and_capture(src, tag)
    compile_test_helpers.expect_error(out, "E0504", "{tag}: bare Channel(n) is an undefined function")
    compile_test_helpers.expect_contains(out, "channel.new[T](buffer: n)", "{tag}: the repair names the spec constructor")
    assert(!out.contains("E0301"))
}

// ── recv position ─────────────────────────────────────────────────────────────

test "unannotated Channel(n) with a Str sent through recv is refused" {
    assert_refused(#"    let ch = Channel(4)
    ch.send("abcd")
    io.println("{ch.recv().unwrap().len()}")"#, "channel_ctor_elem_recv_str")
}

test "unannotated Channel(n) with a struct sent through recv is refused" {
    assert_refused(#"    let ch = Channel(4)
    ch.send(Msg { n: 7 })
    io.println("{ch.recv().unwrap().n}")"#, "channel_ctor_elem_recv_struct")
}

// ── for-in binder position ────────────────────────────────────────────────────

test "for-in over an unannotated Channel(n) of Str is refused" {
    assert_refused(#"    let ch = Channel(4)
    ch.send("ab")
    ch.send("cde")
    ch.close()
    let mut total = 0
    for v in ch {
        total = total + v.len()
    }
    io.println("{total}")"#, "channel_ctor_elem_forin_str")
}

test "for-in over an unannotated Channel(n) of a struct is refused" {
    assert_refused(#"    let ch = Channel(4)
    ch.send(Msg { n: 7 })
    ch.send(Msg { n: 35 })
    ch.close()
    let mut total = 0
    for m in ch {
        total = total + m.n
    }
    io.println("{total}")"#, "channel_ctor_elem_forin_struct")
}

test "an unannotated Channel(n) read back in a second position is refused" {
    assert_refused(#"    let ch = Channel(4)
    ch.send("first")
    ch.send("second")
    ch.close()
    let a = ch.recv().unwrap()
    let mut rest = ""
    for v in ch {
        rest = "{rest}{v}"
    }
    io.println("{a}{rest}")"#, "channel_ctor_elem_second_read")
}

// ── controls: the element written at the construction site ────────────────────

test "annotated Channel[Str] from channel.new[Str] still carries its element" {
    let ch: Channel[Str] = channel.new[Str](buffer: 4)
    ch.send("ab")
    ch.close()
    let mut total = 0
    for v in ch {
        total = total + v.len()
    }
    assert_eq(total, 2)
}

test "annotated Channel[Msg] from channel.new[Msg] still carries its element" {
    let ch: Channel[Msg] = channel.new[Msg](buffer: 4)
    ch.send(Msg { n: 7 })
    ch.close()
    let mut total = 0
    for m in ch {
        total = total + m.n
    }
    assert_eq(total, 7)
}

test "unannotated Channel(n) with an Int element is refused too" {
    assert_refused(#"    let ch = Channel(4)
    ch.send(10)
    ch.send(32)
    ch.close()
    let mut total = 0
    for v in ch {
        total = total + v
    }
    let ch2 = Channel(2)
    ch2.send(7)
    io.println("{total} {ch2.recv().unwrap()}")"#, "channel_ctor_elem_int")
}
