// 8tk637: a data-enum variant constructor called with the wrong number of
// arguments must be rejected at typecheck. Before the fix, the variant-name
// branch in infer_type's Call handling returned the enum tid immediately with
// no arity check, so 'Errno()' (0 args, needs 1) reached codegen and emitted
// invalid C ('.data.Errno={}'). Mirror the function-arity check (E0300).

import compile_test_helpers

test "variant constructor with too few args is a typecheck error" {
    let src = "pub type Errno \{ Errno(Int) \}\nfn classify(x: Int) -> Result[Int, Errno] \{\n    if x < 0 \{ Err(Errno()) \} else \{ Ok(x) \}\n\}\nfn main() \{ let _ = classify(-1) \}\n"
    compile_test_helpers.expect_compile_error(src, "variant_arity_under", "E0300")
}

test "variant under-arity error names the variant and counts" {
    let src = "pub type Errno \{ Errno(Int) \}\nfn classify(x: Int) -> Result[Int, Errno] \{\n    if x < 0 \{ Err(Errno()) \} else \{ Ok(x) \}\n\}\nfn main() \{ let _ = classify(-1) \}\n"
    let out = compile_test_helpers.compile_and_capture(src, "variant_arity_under_msg")
    compile_test_helpers.expect_contains(out, "variant 'Errno' expects 1 argument(s), got 0", "variant_arity_under_msg")
}

test "variant constructor with too many args is a typecheck error" {
    let src = "pub type Errno \{ Errno(Int) \}\nfn classify(x: Int) -> Result[Int, Errno] \{\n    if x < 0 \{ Err(Errno(1, 2)) \} else \{ Ok(x) \}\n\}\nfn main() \{ let _ = classify(-1) \}\n"
    compile_test_helpers.expect_compile_error(src, "variant_arity_over", "E0300")
}

test "variant over-arity error names the variant and counts" {
    let src = "pub type Errno \{ Errno(Int) \}\nfn classify(x: Int) -> Result[Int, Errno] \{\n    if x < 0 \{ Err(Errno(1, 2)) \} else \{ Ok(x) \}\n\}\nfn main() \{ let _ = classify(-1) \}\n"
    let out = compile_test_helpers.compile_and_capture(src, "variant_arity_over_msg")
    compile_test_helpers.expect_contains(out, "variant 'Errno' expects 1 argument(s), got 2", "variant_arity_over_msg")
}

test "correctly-arited variant constructor still compiles clean" {
    let src = "pub type Errno \{ Errno(Int) \}\nfn classify(x: Int) -> Result[Int, Errno] \{\n    if x < 0 \{ Err(Errno(42)) \} else \{ Ok(x) \}\n\}\nfn main() \{ let _ = classify(-1) \}\n"
    compile_test_helpers.expect_no_error(src, "variant_arity_ok", "E0300")
}
