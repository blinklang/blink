import compile_test_helpers

// A struct-pattern field binder (`match s { Rect { w, h } => ... }`) must carry the field's
// DECLARED type, exactly like every other pattern binder. The StructPattern arm of
// tc_check_pattern_types used to bind each field name with a bare nr_define — no type, no
// published node tid — so a mistyped use of the binder went undiagnosed and, for a Float field
// read as an Int, the program compiled and RAN with the wrong bit pattern.
//
// Two carriers reach this arm: a struct-style enum variant (`Rect` of an enum) and a plain
// struct (`Cfg`). Both are covered: the negative rows prove the mistype is now caught, and the
// positive rows prove a correctly-typed binder still produces the right value.

// ── negative: the mistype is diagnosed (was: silently accepted) ─────────────────

test "an Int variant-field binder cannot initialize a Str-declared let" {
    let src = "type Shape \{ Rect \{ w: Int, h: Int \} \}\nfn main() \{\n    let s = Shape.Rect \{ w: 2, h: 3 \}\n    match s \{\n        Rect \{ w, h \} => \{\n            let bad: Str = w\n            let _ = h\n            let _ = bad\n        \}\n    \}\n\}\n"
    compile_test_helpers.expect_compile_error(src, "8vc88v_variant_int_str", "declared type Str but got Int")
}

test "a Float variant-field binder cannot initialize an Int-declared let" {
    let src = "type Shape \{ Rect \{ w: Float, h: Int \} \}\nfn main() \{\n    let s = Shape.Rect \{ w: 2.75, h: 3 \}\n    match s \{\n        Rect \{ w, h \} => \{\n            let bad: Int = w\n            let _ = h\n            let _ = bad\n        \}\n    \}\n\}\n"
    compile_test_helpers.expect_compile_error(src, "8vc88v_variant_float_int", "declared type Int but got Float")
}

test "a plain-struct field binder cannot initialize a mistyped let" {
    let src = "type Cfg \{ port: Int, host: Str \}\nfn main() \{\n    let c = Cfg \{ port: 5, host: \"h\" \}\n    match c \{\n        Cfg \{ port, host \} => \{\n            let bad: Str = port\n            let _ = host\n            let _ = bad\n        \}\n    \}\n\}\n"
    compile_test_helpers.expect_compile_error(src, "8vc88v_struct_int_str", "declared type Str but got Int")
}

// ── positive: a correctly-typed binder still resolves and runs ──────────────────

type Shape {
    Rect { w: Int, h: Int }
}

type Cfg { port: Int, host: Str }

test "a struct-style variant field binder keeps its Int type" {
    let s = Shape.Rect { w: 2, h: 3 }
    let area = match s {
        Rect { w, h } => { w * h }
    }
    assert_eq(area, 6)
}

test "a plain-struct field binder keeps its declared types" {
    let c = Cfg { port: 5, host: "h" }
    let out = match c {
        Cfg { port, host } => { "{host}{port}" }
    }
    assert_eq(out, "h5")
}
