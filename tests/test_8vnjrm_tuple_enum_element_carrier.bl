type Model {
    n: Int
}

type Cmd {
    Quit
    Continue
}

fn step() -> (Model, Cmd) {
    (Model { n: 0 }, Quit)
}

test "tuple literal enum element infers declared Cmd carrier" {
    let (m, c) = step()
    assert_eq(m.n, 0)
    let matched = match c {
        Quit => 1
        _ => 0
    }
    assert_eq(matched, 1)
}

test "tuple enum element via let target ann" {
    let pair: (Model, Cmd) = (Model { n: 7 }, Continue)
    let (m, c) = pair
    assert_eq(m.n, 7)
    let matched = match c {
        Continue => 1
        _ => 0
    }
    assert_eq(matched, 1)
}
