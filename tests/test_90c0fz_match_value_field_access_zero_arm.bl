// Bug 90c0fz: `let r = match ...` (value position) collapsed to `const void r`
// when an arm body was a field-access on the payload binder (e.g. `Some(t) => t.x + t.y`)
// alongside a literal `0` arm (`None => 0`). Two things conspired in emit_match_expr:
// (1) static infer_arm_type returns CT_VOID for the field-access arm (the binder
// isn't in scope at infer time), and (2) the buffer-emit harvest override was
// disabled because the `None => 0` arm's emitted text "0" tripped pp_all_value=0
// — conflating a genuine integer value 0 with a value-less statement arm.
// Fix mirrors emit_block_expr: use a structural `arm_body_is_valueless` check
// instead of a string compare against "0".

type P {
    x: Int
    y: Int
}

test "let = match Option[Struct] with field-access arm and 0 arm" {
    let o: Option[P] = Some(P { x: 3, y: 4 })
    let r = match o {
        Some(t) => t.x + t.y
        None => 0
    }
    assert_eq(r, 7)
}

test "let = match Option[Struct] None path yields 0" {
    let o: Option[P] = None
    let r = match o {
        Some(t) => t.x + t.y
        None => 0
    }
    assert_eq(r, 0)
}

test "let = match Option[Tuple] with field-access arm and 0 arm" {
    let o: Option[Tuple[Int, Int]] = Some((10, 20))
    let r = match o {
        Some(t) => t._0 + t._1
        None => 0
    }
    assert_eq(r, 30)
}

test "let = match Option[Tuple] None path yields 0" {
    let o: Option[Tuple[Int, Int]] = None
    let r = match o {
        Some(t) => t._0 + t._1
        None => 0
    }
    assert_eq(r, 0)
}

test "let = match Result[Struct] with field-access arm and 0 arm" {
    let o: Result[P, Str] = Ok(P { x: 5, y: 6 })
    let r = match o {
        Ok(t) => t.x + t.y
        Err(_e) => 0
    }
    assert_eq(r, 11)
}

test "let = match Result[Struct] Err path yields 0" {
    let o: Result[P, Str] = Err("boom")
    let r = match o {
        Ok(t) => t.x + t.y
        Err(_e) => 0
    }
    assert_eq(r, 0)
}
