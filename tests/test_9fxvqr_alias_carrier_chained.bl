// A function whose declared return type is a type alias to a CARRIER
// (type MB = Option[Point]) is transparent: an immediate method chain on the
// call result (make_opt_point().unwrap()) must spell the unwrap temp from the
// alias's underlying carrier (blink_Option_Point), not the erased default
// (blink_Option_int). The call-result carrier registration keyed on the raw
// alias name ("MB"), so no carrier branch fired and the inner struct was lost,
// mistyping the temp and failing C compilation (member access on a non-struct).

type Point { x: Int }
type MB = Option[Point]
type MR = Result[Point, Str]

fn make_opt_point() -> MB { Some(Point { x: 7 }) }
fn make_res_point() -> MR { Ok(Point { x: 9 }) }

test "alias-to-Option return, immediate unwrap chain" {
    assert_eq(make_opt_point().unwrap().x, 7)
}

test "alias-to-Result return, immediate unwrap chain" {
    assert_eq(make_res_point().unwrap().x, 9)
}
