// br 9g2p3j: positional enum-variant payloads.
//
// The spec (sections/03_types.md) documents positional payloads as the
// canonical enum-variant syntax: `Boolean(Bool)`, `Number(Float)`,
// `Branch(Leaf(1), Leaf(2))`. Before this fix, src/parser.bl parsed the
// positional payload TYPE and then DISCARDED it ("skip to closing paren"),
// so a positional variant registered with zero fields and its constructor
// failed typecheck with `undefined function`.
//
// These tests are the spec for positional payloads: a variant declared
// `Variant(Type)` must be constructable as `Variant(arg)` and bind its
// positional payload in a match. Field names are synthesized positionally
// (_0, _1, ...). The match/pattern side already worked; this exercises the
// declaration + construction path the parser used to drop.
type Shape {
    Circle(Int),
    Rect(Int, Int)
}

// Mixed: a complex positional type (List) must survive the parser, not just
// scalar Int — confirms we parse a full type annotation, not a bare ident.
type Wrapper {
    Items(List[Int])
}

fn area(s: Shape) -> Int {
    match s {
        Shape.Circle(r) => 3 * r * r
        Shape.Rect(w, h) => w * h
    }
}

fn first_item(w: Wrapper) -> Int {
    match w {
        Wrapper.Items(xs) => xs.get(0).unwrap()
    }
}

test "single positional payload constructs and matches" {
    assert_eq(area(Shape.Circle(2)), 12)
}

test "multi positional payload constructs and matches" {
    assert_eq(area(Shape.Rect(3, 4)), 12)
}

test "bare positional constructor" {
    let s = Circle(5)
    assert_eq(area(s), 75)
}

test "positional payload with complex type annotation" {
    let w = Items([10, 20, 30])
    assert_eq(first_item(w), 10)
}
