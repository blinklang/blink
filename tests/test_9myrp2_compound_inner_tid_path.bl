// br 9myrp2 widening: a tuple element whose Option/Result inner is a ONE-LEVEL
// List/Set/Bytes/scalar now rides the tid path — tc_tid_tuple_elem_encodable admits
// it via tc_tid_inner_tag_faithful. Each case is a byte-stability tripwire: the tid
// carrier the generic-fn mono mints must match the value-constructed tuple.
//
// NESTED compound inners (Option[Option[_]], Option[Result[_,_]]) and a Map inner
// (Option[Map]) now ALSO ride the tid path (br yavhwc made emit_tuple_lit recurse the
// element tid via tc_tid_inner_tag) — see test_yavhwc_carrier_compound_inner_value_path.bl.
// A struct/enum leaf inner (Option[<struct>]) still DEFERS — tc_tid_inner_tag spells it
// via tc_tid_struct_mono_name while the value path uses canonical_struct_tag (not proven
// byte-equal; the 295z9x follow-up reconciles it). See
// test_anaqc3_deferring_tuple_elem.bl for the remaining deferred case.

fn take_int[T](_x: T) -> Int {
    99
}

// Option[Set[Int]] inner: Set element erased to bare "set" on all three spellers.
test "(Option[Set[Int]], Int) rides the tid path" {
    let mut s: Set[Int] = Set()
    s.insert(1)
    let p = (Some(s), 7)
    assert_eq(take_int(p), 99)
}

// Option[Bytes] inner: Bytes erased to bare "bytes".
test "(Option[Bytes], Int) rides the tid path" {
    let b: Option[Bytes] = Some(Bytes.new())
    let p = (b, 7)
    assert_eq(take_int(p), 99)
}

// Result[Bytes, Int]: Ok inner is Bytes → bare "bytes".
test "(Result[Bytes, Int], Int) rides the tid path" {
    let r: Result[Bytes, Int] = Ok(Bytes.new())
    let p = (r, 7)
    assert_eq(take_int(p), 99)
}

// Result[Int, List[Int]]: the ERR inner is a List → bare "list"; exercises the
// second Result inner arm.
test "(Result[Int, List[Int]], Int) rides the tid path" {
    let r: Result[Int, List[Int]] = Err([1, 2])
    let p = (r, 7)
    assert_eq(take_int(p), 99)
}

// Driven through a generic fn over List[(Option[List[Int]], Int)] — the exact seed
// chain that forced the string CSV before 9myrp2 (the resolve_tparam blocker shape,
// Tuple2_Option_list_int).
fn count_opt_list(xs: List[(Option[List[Int]], Int)]) -> Int {
    xs.len()
}

test "generic-fn over List[(Option[List[Int]], Int)] seeds the tid carrier" {
    let a: Option[List[Int]] = Some([1])
    let xs: List[(Option[List[Int]], Int)] = [(a, 1)]
    assert_eq(count_opt_list(xs), 1)
}
