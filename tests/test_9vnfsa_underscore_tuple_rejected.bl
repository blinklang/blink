import compile_test_helpers

// br 9vnfsa — the underscore-prefixed tuple accessor ._N was never a spec feature. It is a leak of
// the generated-C tuple struct member names into surface syntax: a tuple lowers to a C struct whose
// members cannot start with a digit, so codegen names them _0/_1 and emits the C initializer with
// those member names. Early Blink code wrote the underscore form to match the C member verbatim, and
// str_to_tuple_index formalized the accident by skipping one optional leading underscore. The spec
// (sections/03_types.md:3292) defines tuple access as .0/.1/.2 only, and an unknown tuple field is a
// compile error (:3305). The underscore form is now rejected like any other unknown tuple field
// (E0525 NoSuchField); the spec form .N is the sole accessor.

fn underscore_accessor_src() -> Str {
    #"fn main() {
    let t = (3, 9)
    let a = t._0
    io.println("{a}")
}
"#
}

test "the underscore-prefixed tuple accessor is rejected with E0525" {
    compile_test_helpers.expect_compile_error(underscore_accessor_src(), "9vnfsa_underscore", "E0525")
}

// The spec form .N must keep working in every position — element read, arithmetic, method chaining.
fn numeric_accessor_src() -> Str {
    #"fn main() {
    let t = (Some(5), 9)
    let a = t.0.unwrap()
    let s = t.1 + 1
    io.println("{a} {s}")
}
"#
}

test "the spec tuple accessor .N still typechecks (no false E0525)" {
    compile_test_helpers.expect_no_error(numeric_accessor_src(), "9vnfsa_numeric", "E0525")
}
