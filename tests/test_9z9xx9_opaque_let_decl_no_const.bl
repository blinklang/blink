import compile_test_helpers

// An @ffi.opaque handle bound with `let` must lower to a bare
// `cname *` pointer in the local declaration, never a `const cname *`. A leading
// const qualifies the POINTEE, so the value becomes a pointer-to-const that no
// longer matches the bare `cname *` of a thunk parameter, a struct field, or a
// return — gcc then warns -Wdiscarded-qualifiers at every consume site. §9.1.4
// defines the handle as one opaque machine word, not a pointer-to-const.
//
// The let-declaration for a struct-typed binding takes the struct arm of
// emit-let, which always prepends const for a non-mut binding. That arm predates
// @ffi.opaque handles — the only struct_type values that lower to a trailing-star
// pointer — so it must exempt them exactly as the flat arm already does.

fn roundtrip_src() -> Str {
    "@ffi.opaque(header: \"stdio.h\", name: \"FILE\")\ntype CFile\n"
        .concat("@ffi(\"c\", \"fopen\")\n@trusted\nfn c_fopen(path: Ptr[U8], mode: Ptr[U8]) -> CFile ! FFI \{ \}\n")
        .concat("@ffi(\"c\", \"fclose\")\n@trusted\nfn c_fclose(f: CFile) -> Int ! FFI \{ \}\n")
        .concat("fn main() \{\n")
        .concat("    with ffi.scope() as scope \{\n")
        .concat("        let p = scope.cstr(\"/dev/null\")\n")
        .concat("        let m = scope.cstr(\"r\")\n")
        .concat("        let f = c_fopen(p, m)\n")
        .concat("        let rc = c_fclose(f)\n")
        .concat("        io.println(\"rc \{rc}\")\n")
        .concat("    \}\n")
        .concat("\}\n")
}

test "an @ffi.opaque let-binding lowers to a bare pointer, not const-qualified" {
    let c = compile_test_helpers.compile_and_emit_c(roundtrip_src(), "_9z9xx9_letdecl")
    assert(c.contains("FILE* f = "))
    assert(!c.contains("const FILE* f"))
}
