// A bare call uses the import that selects its name. The file's own function uses no import,
// so a whole import of a module that declares a function of the same name stays unused.

import compile_test_helpers

test "a call of a selected newtype uses its selective import" {
    let src = "import std.errno.\{Errno}\n\nfn main() \{\n    let e = Errno(10)\n    io.println(\"\{e.to_int()}\")\n}\n"
    compile_test_helpers.expect_no_error(src, "bare_call_selected_newtype", "W0602")
}

test "a call of the file's own shuffle does not use a whole import of std.random" {
    let src = "import std.random\n\nfn shuffle(n: Int) -> Int \{\n    n\n}\n\nfn main() \{\n    io.println(\"\{shuffle(1)}\")\n}\n"
    compile_test_helpers.expect_compile_error(src, "bare_call_own_shuffle", "W0602")
}

test "a call of a selected shuffle uses its import, and a whole import of std.random its own" {
    let cards = "pub fn shuffle(n: Int) -> Int \{\n    n\n}\n"
    let src = "import bcm_cards.\{shuffle}\nimport std.random\n\nfn main() \{\n    let n = shuffle(1) + (random.choice([5]) ?? 0)\n    io.println(\"\{n}\")\n}\n"
    compile_test_helpers.expect_no_error_xmod(src, "bcm_cards", cards, "bare_call_selected_shuffle", "W0602")
}
