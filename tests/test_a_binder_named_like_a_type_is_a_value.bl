// A value comes first at a dotted head (sections/03_types.md, dotted heads), so a field read on a
// local or a parameter reads the value's own field, also when an alias or an enum has that name.

import compile_test_helpers.{compile_and_capture}

type K {
    A
    B
}
type KA = K
type Plain {
    x: Int
}
type Named {
    A: Int
}
type NamedCarrier {
    None: Int
}
type GV = K
let GV = Named { A: 11 }

fn read_through_alias_name(KA: Plain) -> Int {
    KA.x
}

fn read_through_enum_name(K: Plain) -> Int {
    K.x
}

test "a parameter named like a type reads the field of its value" {
    assert_eq(read_through_alias_name(Plain { x: 7 }), 7)
    assert_eq(read_through_enum_name(Plain { x: 8 }), 8)
}

test "a local named like a type reads the field of its value" {
    let KA = Plain { x: 7 }
    assert_eq("{KA.x}", "7")
    let K = Plain { x: 8 }
    assert_eq("{K.x}", "8")
}

test "a field named like a variant reads the field and not the variant" {
    let K = Named { A: 9 }
    assert_eq(K.A, 9)
    let KA = Named { A: 10 }
    assert_eq(KA.A, 10)
}

test "a module-level value named like a type reads its own field" {
    assert_eq(GV.A, 11)
}

test "a field named like a carrier's variant reads the field" {
    let Option = NamedCarrier { None: 12 }
    assert_eq(Option.None, 12)
}

test "with no binder the name still reaches the type" {
    let v = KA.B
    assert_eq(match v {
        K.A => 0
        K.B => 1
    }, 1)
}

fn rejected_as_value(body: Str, tag: Str, code: Str) ! Process.Spawn, FS.Write, FS.Read, FS.Delete, Env.Read {
    let out = compile_and_capture("type K \{ A(Int)\n B \}\ntype KA = K\ntype OI = Option[Int]\nfn main() \{\n{body}\n\}\n", tag)
    assert(out.contains(code), out)
    assert(!out.contains("\"severity\":\"ice\""), out)
}

test "a call on a local named like an alias of a carrier asks the value" {
    rejected_as_value("let OI = 5\nlet _x = OI.Some(1)", "_binder_alias_carrier_call", "UnresolvedMethod")
}

test "a call on a local named like a carrier asks the value" {
    rejected_as_value("let Option = 5\nlet _x = Option.Some(1)", "_binder_carrier_call", "UnresolvedMethod")
}

test "a call on a local named like an enum asks the value" {
    rejected_as_value("let K = 5\nlet _x = K.A(1)", "_binder_enum_call", "UnresolvedMethod")
}

test "a call on a local named like an alias of an enum asks the value" {
    rejected_as_value("let KA = 5\nlet _x = KA.A(1)", "_binder_alias_enum_call", "UnresolvedMethod")
}

test "a field read on a local named like an alias of a carrier asks the value" {
    rejected_as_value("let OI = 5\nlet _x = OI.None", "_binder_alias_carrier_field", "NoSuchField")
}
