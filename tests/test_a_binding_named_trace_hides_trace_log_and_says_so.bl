// A binding named `trace` hides the built-in `trace.log` in its scope, so `trace.log` is a
// method call on the binding; with no method `log` there, it is UnresolvedMethod, and the help
// names the binding that hides the built-in (§8.15.7, *A binding named `trace`*). `trace` alone
// is no value.

import compile_test_helpers

let FN_SRC = #"fn trace(phase: Str, msg: Str) { }

fn f() {
    trace.log("c", "x")
}

fn main() { f() }
"#

let LOCAL_SRC = #"fn main() {
    let trace = 5
    trace.log("c", "x")
}
"#

let PARAM_SRC = #"fn f(
    trace: Str,
) {
    trace.log("c", "x")
}

fn main() { f("a") }
"#

let GLOBAL_SRC = #"let trace = 5

fn main() {
    trace.log("c", "x")
}
"#

let VALUE_SRC = #"fn main() {
    let x = trace
}
"#

test "a fn named trace hides trace.log and the help names the fn" {
    let out = compile_test_helpers.compile_and_capture(FN_SRC, "trace_hide_fn")
    compile_test_helpers.expect_error(out, "UnresolvedMethod", "fn trace: E0505")
    compile_test_helpers.expect_contains(out, "`trace` here is the fn at line 1, which hides the built-in `trace.log`; rename the fn to use it", "fn trace: help")
}

test "a local named trace hides trace.log and the help names the local" {
    let out = compile_test_helpers.compile_and_capture(LOCAL_SRC, "trace_hide_local")
    compile_test_helpers.expect_error(out, "UnresolvedMethod", "local trace: E0505")
    compile_test_helpers.expect_contains(out, "`trace` here is the local at line 2, which hides the built-in `trace.log`; rename the local to use it", "local trace: help")
}

test "a parameter named trace hides trace.log and the help names the parameter" {
    let out = compile_test_helpers.compile_and_capture(PARAM_SRC, "trace_hide_param")
    compile_test_helpers.expect_error(out, "UnresolvedMethod", "param trace: E0505")
    compile_test_helpers.expect_contains(out, "`trace` here is the parameter at line 2, which hides the built-in `trace.log`; rename the parameter to use it", "param trace: help")
}

test "a module-level let named trace hides trace.log and the help names it" {
    let out = compile_test_helpers.compile_and_capture(GLOBAL_SRC, "trace_hide_global")
    compile_test_helpers.expect_error(out, "UnresolvedMethod", "global trace: E0505")
    compile_test_helpers.expect_contains(out, "`trace` here is the module-level binding at line 1, which hides the built-in `trace.log`; rename the module-level binding to use it", "global trace: help")
}

test "trace alone is no value" {
    let out = compile_test_helpers.compile_and_capture(VALUE_SRC, "trace_not_a_value")
    compile_test_helpers.expect_error(out, "UndefinedVariable", "trace value: E0504")
    compile_test_helpers.expect_contains(out, "`trace` is not a value: call `trace.log(channel, msg)`", "trace value: help")
}
