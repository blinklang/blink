// A List impl whose signatures name no binder can still bind an element in its body: a local,
// a loop variable, a match binding or a closure parameter whose type is the impl's `T`, or a
// value such as `Some(self)` whose type names `T` or `Self`, or a spread `[..self]` that copies
// elements. Its C then differs per element
// type, so the impl gets one body per receiver instance, as a signature mention gives it.
// A body that hands the receiver or an element to generic code (a generic fn, a std list
// adapter, or a method of a per-instance impl) also needs one body per instance, since the
// generic code is instanced at `T`. A body that names `T` only under a List, such as
// `List[Option[T]]`, and calls nothing generic at `T` keeps one shared body.

trait Peek {
    fn peek(self) -> Int
}

impl[T] Peek for List[T] {
    fn peek(self) -> Int {
        let x = self.get(0)
        if x.is_some() { 1 } else { 0 }
    }
}

trait Wrapped {
    fn wrapped(self) -> Int
}

impl[T] Wrapped for List[T] {
    fn wrapped(self) -> Int {
        let o: Option[Self] = Some(self)
        o.unwrap().len()
    }
}

trait Paired {
    fn paired(self) -> Int
}

impl[T] Paired for List[T] {
    fn paired(self) -> Int {
        let p = (self, 7)
        p.1 + p.0.len()
    }
}

trait Walk {
    fn walk(self) -> Int
}

impl[T] Walk for List[T] {
    fn walk(self) -> Int {
        let mut c = 0
        for e in self {
            let _y = e
            c = c + 1
        }
        c
    }
}

trait First {
    fn first_or_zero(self) -> Int
}

impl[T] First for List[T] {
    fn first_or_zero(self) -> Int {
        match self.get(0) {
            Some(e) => {
                let _y = e
                1
            }
            None => 0
        }
    }
}

trait Ones {
    fn ones(self) -> Int
    fn kept(self) -> Int
}

impl[T] Ones for List[T] {
    fn ones(self) -> Int { self.map(fn(_e: T) -> Int { 1 }).len() }
    fn kept(self) -> Int { self.filter(fn(_e) { true }).len() }
}

trait Shared {
    fn shared(self) -> Int
}

impl[T] Shared for List[T] {
    fn shared(self) -> Int {
        let ys: List[Option[T]] = []
        let s: Self = self
        let g = fn(l: List[T]) -> Int { l.len() }
        ys.len() + s.len() + g(self)
    }
}

fn cnt[U](l: List[U]) -> Int { l.len() }

fn keep[U](_u: U) -> Bool { true }

fn touch[U]() -> Int { 1 }

trait Calls {
    fn skipped(self) -> Int
    fn counted(self) -> Int
    fn kept_by_fn(self) -> Int
    fn touched(self) -> Int
    fn spread(self) -> Int
}

impl[T] Calls for List[T] {
    fn skipped(self) -> Int { self.skip(1).len() }
    fn counted(self) -> Int { cnt(self) }
    fn kept_by_fn(self) -> Int { self.filter(keep).len() }
    fn touched(self) -> Int { touch[T]() + self.len() }
    fn spread(self) -> Int {
        let a = [..self, ..self]
        a.len()
    }
}

trait Outer {
    fn outer(self) -> Int
}

impl[T] Outer for List[T] {
    fn outer(self) -> Int { self.peek() + 10 }
}

type Cnt { n: Int }

impl[T] From[List[T]] for Cnt {
    fn from(l: List[T]) -> Cnt { Cnt { n: l.len() } }
}

trait Counted {
    fn counted_twice(self) -> Int
}

impl[T] Counted for List[T] {
    fn counted_twice(self) -> Int {
        let c: Cnt = self.into()
        Cnt.from(self).n + c.n
    }
}

type Pt { x: Int }

test "a local bound to an element of a List receiver" {
    assert_eq([1, 2].peek(), 1)
    assert_eq(["a"].peek(), 1)
    let empty: List[Pt] = []
    assert_eq(empty.peek(), 0)
}

test "Option[Self] and a tuple holding self in the body" {
    assert_eq([1, 2].wrapped(), 2)
    assert_eq(["a"].wrapped(), 1)
    assert_eq([Pt { x: 1 }].paired(), 8)
}

test "a loop variable and a match binding of the element type" {
    assert_eq([1, 2, 3].walk(), 3)
    assert_eq([Pt { x: 1 }].walk(), 1)
    assert_eq(["a"].first_or_zero(), 1)
}

test "a closure parameter of the element type" {
    assert_eq([1, 2].ones(), 2)
    assert_eq(["a", "b", "c"].kept(), 3)
}

test "T only under a List keeps one shared body" {
    assert_eq([1, 2].shared(), 4)
    assert_eq(["a"].shared(), 2)
}

test "a body that calls generic code at the element type" {
    assert_eq([1, 2, 3].skipped(), 2)
    assert_eq(["a"].skipped(), 0)
    assert_eq([Pt { x: 1 }].counted(), 1)
    assert_eq(["a", "b"].counted(), 2)
    assert_eq([1, 2].kept_by_fn(), 2)
    assert_eq(["a"].touched(), 2)
}

test "a body that spreads the receiver into a new list" {
    assert_eq([1, 2].spread(), 4)
    assert_eq([Pt { x: 1 }].spread(), 2)
}

test "a body that calls a method of a per-instance impl" {
    assert_eq([1, 2].outer(), 11)
    assert_eq(["a"].outer(), 11)
    let empty: List[Pt] = []
    assert_eq(empty.outer(), 10)
}

test "a body that converts the receiver through a generic From impl" {
    assert_eq([1, 2].counted_twice(), 4)
    assert_eq(["a"].counted_twice(), 2)
}
