// A type parameter that holds a generic trait at the arguments a bound asks for meets that
// bound when the argument is itself a type parameter of the body (§3.6 Trait Bounds): at a
// call, a method call, a trait-qualified call and `==`. The bound is written on the binder, in
// an impl's where clause, or given through a supertrait with arguments, or the call fills the
// trait argument with a concrete type that matches. A callee parameter the call leaves open,
// a trait method bound on the trait's own parameter, an impl the compiler supplies, an impl
// with no methods and a supertrait at `Self` meet it too. Each form builds and runs.

trait Conv[A] {
    fn conv(self) -> Int
}

trait Wide[K]: Conv[K] {
    fn wide(self) -> Int
}

impl Conv[Int] for Int {
    fn conv(self) -> Int { self * 10 }
}

impl Wide[Int] for Int {
    fn wide(self) -> Int { self }
}

type Tg[X] { x: X }

impl[X] Conv[X] for Tg[X] {
    fn conv(_self) -> Int { 1 }
}

type Px[K, V] { k: K, v: V }

trait Shown {
    fn shown(self) -> Int
}

impl[K, V: Conv[K]] Shown for Px[K, V] {
    fn shown(self) -> Int { self.v.conv() }
}

impl[K, V: Conv[K]] Eq for Px[K, V] {
    fn eq(self, o: Px[K, V]) -> Bool { self.v.conv() == o.v.conv() }
}

fn need[K, V: Conv[K]](_k: K, v: V) -> Int { v.conv() }

fn inline_call[K2, A: Conv[K2]](k: K2, a: A) -> Int { need(k, a) }

fn inline_method[K2, A: Conv[K2]](p: Px[K2, A]) -> Int { p.shown() + Shown.shown(p) }

fn inline_eq[K2, A: Conv[K2]](p: Px[K2, A], q: Px[K2, A]) -> Bool { p == q }

fn super_call[K2, A: Wide[K2]](k: K2, a: A) -> Int { need(k, a) }

fn super_eq[K2, A: Wide[K2]](p: Px[K2, A], q: Px[K2, A]) -> Bool { p == q && !(p != q) }

fn concrete_call[A: Conv[Int]](a: A) -> Int { need(1, a) }

fn follows[K2](k: K2, t: Tg[K2]) -> Int { need(k, t) }

trait Run {
    fn run(self) -> Int
}

type Q[K, V] { k: K, v: V }

impl[K2, A] Run for Q[K2, A] where A: Conv[K2] {
    fn run(self) -> Int {
        let p = Px { k: self.k, v: self.v }
        need(self.k, self.v) + p.shown() + if p == p { 1 } else { 0 }
    }
}

fn super_method[K2, A: Wide[K2]](p: Px[K2, A]) -> Int { p.shown() }

fn concrete_method[A: Conv[Int]](p: Px[Int, A]) -> Int { p.shown() }

fn need_k[K, V: Conv[K]](_v: V) -> List[K] { [] }

fn open_callee[A: Conv[Int]](a: A) -> Int {
    let xs: List[Int] = need_k(a)
    let ys: List[Int] = need_k(3)
    xs.len() + ys.len()
}

type Hold[K] { k: K }

trait Mk[K] {
    fn mk[A: Conv[K]](self, a: A) -> Int
}

impl[K] Mk[K] for Hold[K] {
    fn mk[A: Conv[K]](_self, a: A) -> Int { a.conv() }
}

fn caller_mk[K2, B: Conv[K2]](h: Hold[K2], b: B) -> Int { h.mk(b) }

type Fx[K, V] { k: K, v: V }

impl[K, V: From[K]] Eq for Fx[K, V] {
    fn eq(_self, _o: Fx[K, V]) -> Bool { true }
}

trait Tag[A] { }

impl Tag[Int] for Int { }

type Mx[K, V] { k: K, v: V }

impl[K, V: Tag[K]] Eq for Mx[K, V] {
    fn eq(_self, _o: Mx[K, V]) -> Bool { true }
}

trait Selfy: Conv[Self] {
    fn sf(self) -> Int
}

impl Selfy for Int {
    fn sf(self) -> Int { self }
}

fn needs_self[V: Conv[V]](v: V) -> Int { v.conv() }

fn super_self[A: Selfy](a: A) -> Int { needs_self(a) }

test "a bound written on the binder meets the bound at a call, a method call and ==" {
    assert_eq(inline_call(1, 2), 20)
    assert_eq(inline_method(Px { k: 1, v: 3 }), 60)
    assert(inline_eq(Px { k: 1, v: 3 }, Px { k: 9, v: 3 }))
    assert(!inline_eq(Px { k: 1, v: 3 }, Px { k: 1, v: 4 }))
}

test "a bound given through a supertrait with arguments meets the bound" {
    assert_eq(super_call(1, 4), 40)
    assert(super_eq(Px { k: 1, v: 4 }, Px { k: 2, v: 4 }))
}

test "a call that fills the trait argument with a matching concrete type meets the bound" {
    assert_eq(concrete_call(5), 50)
}

test "an impl whose trait argument follows its receiver meets the bound" {
    assert_eq(follows("s", Tg { x: "t" }), 1)
}

test "a bound written in an impl's where clause meets the bound" {
    assert_eq(Q { k: 1, v: 2 }.run(), 41)
}

test "a method call meets the bound through a supertrait and with a matching concrete type" {
    assert_eq(super_method(Px { k: 1, v: 4 }), 40)
    assert_eq(concrete_method(Px { k: 1, v: 5 }), 50)
}

test "a callee parameter the call leaves open is not judged" {
    assert_eq(open_callee(3), 0)
}

test "a trait method bound on the trait's own parameter meets the bound" {
    assert_eq(Hold { k: 1 }.mk(2), 20)
    assert_eq(caller_mk(Hold { k: 1 }, 3), 30)
}

test "an impl the compiler supplies and an impl with no methods meet an impl bound at ==" {
    assert(Fx { k: 1, v: 5 } == Fx { k: 1, v: 6 })
    assert(Mx { k: 1, v: 5 } == Mx { k: 1, v: 6 })
}

test "a supertrait at Self gives the trait at the parameter itself" {
    assert_eq(super_self(3), 30)
}
