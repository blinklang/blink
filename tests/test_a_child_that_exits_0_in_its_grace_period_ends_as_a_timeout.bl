// A limit end wins over every other end (sections/06_tooling.md §8.10.7, What the report shows;
// sections/04_effects.md §4.4.8): a child that exits with code 0 on the SIGTERM of its deadline,
// inside the grace period, ends as Limit(Timeout), not Exited(0). `blink test` reports a test
// binary from this end, so a binary that does the same is an aborted file.
//
// The grace period is 30 s and the bound on the run is 20 s, so the child must have exited on
// SIGTERM, not on the SIGKILL after the grace period. A loaded host cannot make it fail.

import std.process.{ChildEnd, ChildLimits, LimitKind}
import std.time.{Duration}

test "a child that exits 0 in its grace period ends as Limit(Timeout)" {
    let limits = ChildLimits { timeout: Some(Duration.ms(300)), grace: Duration.seconds(30) }
    let start = time.read()
    let r = process.run("sh", ["-c", "trap 'exit 0' TERM; while :; do sleep 0.05; done"], limits: limits).unwrap()
    assert_eq(r.end, ChildEnd.Limit(LimitKind.Timeout))
    assert(start.elapsed().to_ms() < 20000, "the child ran {start.elapsed().to_ms()} ms, so SIGKILL ended it")
}
