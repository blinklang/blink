// A bare generic builtin head such as `Option` or `List` names the type with its parameters still
// open. A conversion through it finds the impl that converts the argument, as `Box.from(x)` does
// for a user generic type, and is NoConversionImpl when no impl does.

import compile_test_helpers.{compile_and_capture, compile_and_run}

fn refused_with(code: Str, src: Str, fixture: Str) ! FS.Delete, FS.Write, Process.Spawn, FS.Read, Env.Read {
    let r = compile_and_capture(src, fixture)
    assert(r.contains(code), r)
    assert(!r.contains("\"severity\":\"ice\""), r)
}

test "a conversion with no impl on a bare generic builtin head is refused" {
    refused_with("NoConversionImpl", "fn main() \{ let v: Option[Int] = Option.from(3)\n io.println(\"\{v ?? 0}\") \}\n", "_bare_builtin_from_option_annotated")
    refused_with("NoConversionImpl", "fn main() \{ let _v = Option.from(3) \}\n", "_bare_builtin_from_option")
    refused_with("NoConversionImpl", "fn main() \{ let _v = List.from(3) \}\n", "_bare_builtin_from_list")
    refused_with("NoConversionImpl", "fn main() \{ let _v = Map.try_from(3) \}\n", "_bare_builtin_try_from_map")
    refused_with("NoConversionImpl", "fn main() \{ let _v = Result.from(3) \}\n", "_bare_builtin_from_result")
}

test "a conversion with an impl on a bare generic builtin head takes the parameter from the argument" {
    let r = compile_and_run(#"
type Pair[T] { a: T, b: T }
impl[T] From[Pair[T]] for List[T] {
    fn from(p: Pair[T]) -> List[T] { [p.a, p.b] }
}
fn main() {
    let xs = List.from(Pair { a: 1, b: 2 })
    let ys: List[Str] = List.from(Pair { a: "x", b: "y" })
    io.println("{xs.len()} {xs.get(1).unwrap() + 1} {ys.get(0).unwrap()}")
}
"#, "_bare_builtin_from_list_impl")
    assert(r.exit_code == 0, "{r.out}{r.err_out}")
    assert_eq(r.out.trim(), "2 3 x")
}

test "a refused conversion on a bare generic builtin head names the head and adds no error" {
    let r = compile_and_capture("fn main() \{\n let xs: List[Int] = []\n let p = Option.try_from(xs)\n io.println(p.debug())\n\}\n", "_bare_builtin_refusal_alone")
    assert(r.contains("NoConversionImpl"), r)
    assert(!r.contains("[?]"), r)
    assert(!r.contains("CannotInferType"), r)
    assert(!r.contains("UnresolvedMethod"), r)
}
