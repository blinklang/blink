// A @derive(Debug) refusal of a variant field names the variant with the field, as the other
// derive refusals do, so two variants that hold the same type give two refusals a reader can
// tell apart. `N` has no Debug: it neither derives nor implements it.

import compile_test_helpers

test "a Debug refusal of a variant field names its variant" {
    let src = "type N \{ n: Int }\n@derive(Debug)\ntype E \{\n    A(N)\n    B(N)\n    C(xs: List[N])\n}\nfn main() \{ io.println(\"ok\") }\n"
    let out = compile_test_helpers.check_via_cli(src, "debug_variant_label")
    assert(out.contains("field `A._0` has type `N`"), out)
    assert(out.contains("field `B._0` has type `N`"), out)
    assert(out.contains("field `C.xs` has element type `N`"), out)
}

test "a Debug refusal of a struct field names the field alone" {
    let src = "type N \{ n: Int }\n@derive(Debug)\ntype S \{ xs: N }\nfn main() \{ io.println(\"ok\") }\n"
    let out = compile_test_helpers.check_via_cli(src, "debug_struct_label")
    assert(out.contains("field `xs` has type `N`"), out)
}
