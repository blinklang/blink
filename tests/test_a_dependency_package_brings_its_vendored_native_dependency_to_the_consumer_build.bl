// A package's [native-dependencies] go with the package (§9.1.2). When another package
// depends on it, the consumer's build compiles and links each vendored source the dependency
// declares, with the source's dir on the include path, and resolves each `path` from the
// dir of the package that declares it, not from the consumer's.
import std.process.{ProcessResult}

fn sh(cmd: Str) -> ProcessResult ! Process.Spawn {
    process.run("sh", ["-c", cmd]).unwrap()
}

fn pkg_manifest(name: Str, deps: Str, native: Str) -> Str {
    "[package]\nname = \"{name}\"\nversion = \"0.1.0\"\n{deps}{native}"
}

let NATIVE = "\n[native-dependencies]\naddc = \{ type = \"vendored\", path = \"vendor/addc.c\" \}\n"

// The library package `addlib`, with a vendored C source that adds two longs.
fn write_lib(dir: Str, ffi_args: Str, extra: Str) ! FS.Write, Process.Spawn {
    let _ = sh("mkdir -p {dir}/src {dir}/vendor")
    fs.write("{dir}/blink.toml", pkg_manifest("addlib", "", NATIVE)).unwrap()
    fs.write("{dir}/audits.toml", "[ADD-1]\nclaim = \"two longs in, long out\"\n").unwrap()
    fs.write("{dir}/vendor/addc.h", "#define ADDC_BASE 40\nlong addc_add(long a, long b);\n").unwrap()
    fs.write("{dir}/vendor/addc.c", "#include \"addc.h\"\nlong addc_add(long a, long b) \{ return a + b; \}\n").unwrap()
    fs.write("{dir}/src/addlib.bl", "@ffi({ffi_args})\n@trusted(audit: \"ADD-1\")\nfn raw_add(a: Int, b: Int) -> Int ! ()\n\npub fn add(a: Int, b: Int) -> Int \{ raw_add(a, b) \}\n{extra}").unwrap()
}

fn write_app(dir: Str, dep_name: Str, dep_rel: Str, main_src: Str) ! FS.Write, Process.Spawn {
    let _ = sh("mkdir -p {dir}/src")
    fs.write("{dir}/blink.toml", pkg_manifest("app", "\n[dependencies]\n{dep_name} = \{ path = \"{dep_rel}\" \}\n", "")).unwrap()
    fs.write("{dir}/src/main.bl", main_src).unwrap()
}

// Builds app/src/main.bl in app/ and runs the program. Answers the build's result and the
// program's output.
fn build_app(root: Str) -> (ProcessResult, Str) ! Process.Spawn {
    let r = sh("B=$(pwd)/build/blink; cd {root}/app && timeout 300 $B build src/main.bl -o {root}/out")
    let ran = if r.success() { sh("{root}/out").out } else { "" }
    (r, ran)
}

let ADD_MAIN = "import addlib\n\nfn main() \{\n    io.println(\"\{addlib.add(2, 3)}\")\n}\n"

fn new_root() -> Str ! Process.Spawn {
    sh("mktemp -d /tmp/blink_dep_native.XXXXXX").out.trim()
}

test "a binding with a header in a dependency builds and links its vendored source" {
    let root = new_root()
    write_lib("{root}/lib", "\"addc\", \"addc_add\", header: \"addc.h\"", "")
    write_app("{root}/app", "addlib", "../lib", ADD_MAIN)
    let (r, ran) = build_app(root)
    let _ = sh("rm -rf {root}")
    assert(r.success(), "got: {r.out}{r.err_out}")
    assert_eq(ran, "5\n")
}

test "a binding with no header in a dependency links its vendored source" {
    let root = new_root()
    write_lib("{root}/lib", "\"addc\", \"addc_add\"", "")
    write_app("{root}/app", "addlib", "../lib", ADD_MAIN)
    let (r, ran) = build_app(root)
    let _ = sh("rm -rf {root}")
    assert(r.success(), "got: {r.out}{r.err_out}")
    assert_eq(ran, "5\n")
}

test "a vendored path resolves from its own package in a transitive dependency" {
    let root = new_root()
    write_lib("{root}/deps/lib", "\"addc\", \"addc_add\", header: \"addc.h\"", "")
    let mid = "{root}/mid"
    let _ = sh("mkdir -p {mid}/src")
    fs.write("{mid}/blink.toml", pkg_manifest("mid", "\n[dependencies]\naddlib = \{ path = \"../deps/lib\" \}\n", "")).unwrap()
    fs.write("{mid}/src/mid.bl", "import addlib\n\npub fn add3(a: Int, b: Int, c: Int) -> Int \{ addlib.add(addlib.add(a, b), c) \}\n").unwrap()
    write_app("{root}/app", "mid", "../mid", "import mid\n\nfn main() \{\n    io.println(\"\{mid.add3(1, 2, 3)}\")\n}\n")
    let (r, ran) = build_app(root)
    let _ = sh("rm -rf {root}")
    assert(r.success(), "got: {r.out}{r.err_out}")
    assert_eq(ran, "6\n")
}

test "a foreign constant of a dependency names a key that the dependency declares" {
    let root = new_root()
    write_lib("{root}/lib", "\"addc\", \"addc_add\", header: \"addc.h\"", "\n@ffi(\"addc\", \"ADDC_BASE\", header: \"addc.h\")\npub let BASE: Int\n")
    write_app("{root}/app", "addlib", "../lib", "import addlib\n\nfn main() \{\n    io.println(\"\{addlib.add(addlib.BASE, 2)}\")\n}\n")
    let (r, ran) = build_app(root)
    let _ = sh("rm -rf {root}")
    assert(r.success(), "got: {r.out}{r.err_out}")
    assert_eq(ran, "42\n")
}

test "an edit to a dependency's vendored source reaches the next build" {
    let root = new_root()
    write_lib("{root}/lib", "\"addc\", \"addc_add\", header: \"addc.h\"", "")
    write_app("{root}/app", "addlib", "../lib", ADD_MAIN)
    let (r1, ran1) = build_app(root)
    // mtime has a coarse grain on some file systems; the edit must read as newer.
    let _ = sh("sleep 1")
    fs.write("{root}/lib/vendor/addc.c", "#include \"addc.h\"\nlong addc_add(long a, long b) \{ return a + b + 100; \}\n").unwrap()
    let (r2, ran2) = build_app(root)
    let _ = sh("rm -rf {root}")
    assert(r1.success(), "got: {r1.out}{r1.err_out}")
    assert_eq(ran1, "5\n")
    assert(r2.success(), "got: {r2.out}{r2.err_out}")
    assert_eq(ran2, "105\n")
}

test "a path dependency moved to another dir links the object of the new dir's source" {
    let root = new_root()
    // Written before the first build, so its source is older than the object that build makes.
    write_lib("{root}/lib2", "\"addc\", \"addc_add\", header: \"addc.h\"", "")
    fs.write("{root}/lib2/vendor/addc.c", "#include \"addc.h\"\nlong addc_add(long a, long b) \{ return a + b + 1000; \}\n").unwrap()
    let _ = sh("sleep 1")
    write_lib("{root}/lib", "\"addc\", \"addc_add\", header: \"addc.h\"", "")
    write_app("{root}/app", "addlib", "../lib", ADD_MAIN)
    let (r1, ran1) = build_app(root)
    write_app("{root}/app", "addlib", "../lib2", ADD_MAIN)
    let (r2, ran2) = build_app(root)
    let _ = sh("rm -rf {root}")
    assert(r1.success(), "got: {r1.out}{r1.err_out}")
    assert_eq(ran1, "5\n")
    assert(r2.success(), "got: {r2.out}{r2.err_out}")
    assert_eq(ran2, "1005\n")
}

test "a key that the root and a dependency both declare links the root's object only" {
    let root = new_root()
    write_lib("{root}/lib", "\"addc\", \"addc_add\", header: \"addc.h\"", "")
    write_app("{root}/app", "addlib", "../lib", ADD_MAIN)
    let _ = sh("mkdir -p {root}/app/vendor && cp {root}/lib/vendor/addc.h {root}/app/vendor/")
    fs.write("{root}/app/vendor/addc.c", "#include \"addc.h\"\nlong addc_add(long a, long b) \{ return a + b + 7; \}\n").unwrap()
    fs.write("{root}/app/blink.toml", pkg_manifest("app", "\n[dependencies]\naddlib = \{ path = \"../lib\" \}\n", NATIVE)).unwrap()
    let (r, ran) = build_app(root)
    let _ = sh("rm -rf {root}")
    assert(r.success(), "got: {r.out}{r.err_out}")
    assert_eq(ran, "12\n")
}

test "a dependency whose blink.toml does not load stops the build" {
    let root = new_root()
    write_lib("{root}/lib", "\"addc\", \"addc_add\", header: \"addc.h\"", "")
    write_app("{root}/app", "addlib", "../lib", ADD_MAIN)
    let (r1, _) = build_app(root)
    // No version: the manifest fails the [package] checks.
    fs.write("{root}/lib/blink.toml", "[package]\nname = \"addlib\"\n{NATIVE}").unwrap()
    let (r2, _) = build_app(root)
    // Two sources: the manifest fails the [dependencies] checks.
    fs.write("{root}/lib/blink.toml", pkg_manifest("addlib", "\n[dependencies]\nfoo = \{ path = \"../x\", version = \"1\" \}\n", NATIVE)).unwrap()
    let (r3, _) = build_app(root)
    let _ = sh("rm -rf {root}")
    assert(r1.success(), "got: {r1.out}{r1.err_out}")
    assert(!r2.success(), "the build passed: {r2.out}{r2.err_out}")
    assert(r2.err_out.contains("cannot load"), "got: {r2.out}{r2.err_out}")
    assert(r2.err_out.contains("lib/blink.toml: [package] section missing required field 'version'"), "got: {r2.out}{r2.err_out}")
    assert(!r3.success(), "the build passed: {r3.out}{r3.err_out}")
    assert(r3.err_out.contains("lib/blink.toml: dependency 'foo' has multiple sources"), "got: {r3.out}{r3.err_out}")
}

// A foreign constant of a dependency in lib_dir: the key is the dependency's
// whatever the names of the dirs above it.
fn dep_const_at(lib_dir: Str) -> (ProcessResult, Str) ! FS.Write, Process.Spawn {
    let root = new_root()
    let lib = "{root}/{lib_dir}"
    write_lib(lib, "\"addc\", \"addc_add\", header: \"addc.h\"", "\n@ffi(\"addc\", \"ADDC_BASE\", header: \"addc.h\")\npub let BASE: Int\n")
    write_app("{root}/app", "addlib", "../{lib_dir}", "import addlib\n\nfn main() \{\n    io.println(\"\{addlib.add(addlib.BASE, 2)}\")\n}\n")
    let out = build_app(root)
    let _ = sh("rm -rf {root}")
    out
}

test "a foreign constant of a dependency under a dir named src names the dependency's key" {
    let (r, ran) = dep_const_at("src/lib")
    assert(r.success(), "got: {r.out}{r.err_out}")
    assert_eq(ran, "42\n")
}

test "a foreign constant of a dependency under a lib/pkg dir names the dependency's key" {
    let (r, ran) = dep_const_at("w/lib/pkg/addlib")
    assert(r.success(), "got: {r.out}{r.err_out}")
    assert_eq(ran, "42\n")
}

test "a root foreign constant whose key only a dependency declares is MissingNativeDep" {
    let root = new_root()
    write_lib("{root}/lib", "\"addc\", \"addc_add\", header: \"addc.h\"", "")
    write_app("{root}/app", "addlib", "../lib", "import addlib\n\n@ffi(\"addc\", \"ADDC_BASE\", header: \"addc.h\")\nlet BASE: Int\n\nfn main() \{\n    io.println(\"\{addlib.add(BASE, 2)}\")\n}\n")
    let (r, _) = build_app(root)
    let _ = sh("rm -rf {root}")
    assert(!r.success(), "the build passed: {r.out}{r.err_out}")
    assert(r.err_out.contains("MissingNativeDep"), "got: {r.out}{r.err_out}")
}

// Builds app/src/main.bl in app/ for a cross target. Only the dependency check is of interest,
// which runs before any C compile.
fn cross_build_app(root: Str) -> ProcessResult ! Process.Spawn {
    sh("B=$(pwd)/build/blink; cd {root}/app && timeout 300 $B build --target linux-arm64 src/main.bl -o {root}/out")
}

let LIB_SYSTEM_NATIVE = "\n[native-dependencies]\naddc = \{ type = \"vendored\", path = \"vendor/addc.c\" \}\nzz = \{ system = true \}\n"

test "a dependency's system-only key that the root supplies does not stop a cross build" {
    let root = new_root()
    write_lib("{root}/lib", "\"addc\", \"addc_add\", header: \"addc.h\"", "")
    fs.write("{root}/lib/blink.toml", pkg_manifest("addlib", "", LIB_SYSTEM_NATIVE)).unwrap()
    write_app("{root}/app", "addlib", "../lib", ADD_MAIN)
    let _ = sh("mkdir -p {root}/app/vendor && touch {root}/app/vendor/zz.c")
    fs.write("{root}/app/blink.toml", pkg_manifest("app", "\n[dependencies]\naddlib = \{ path = \"../lib\" \}\n", "\n[native-dependencies]\nzz = \{ type = \"vendored\", path = \"vendor/zz.c\" \}\n")).unwrap()
    let r = cross_build_app(root)
    let arch = sh("file {root}/out").out
    let _ = sh("rm -rf {root}")
    assert(r.success(), "got: {r.out}{r.err_out}")
    assert(arch.contains("aarch64"), "got: {arch}")
}

test "a dependency's system-only key in a cross build names the dependency's manifest" {
    let root = new_root()
    write_lib("{root}/lib", "\"addc\", \"addc_add\", header: \"addc.h\"", "")
    fs.write("{root}/lib/blink.toml", pkg_manifest("addlib", "", LIB_SYSTEM_NATIVE)).unwrap()
    write_app("{root}/app", "addlib", "../lib", ADD_MAIN)
    let r = cross_build_app(root)
    let _ = sh("rm -rf {root}")
    assert(r.err_out.contains("NativeDepUnavailableCrossTarget"), "got: {r.out}{r.err_out}")
    assert(r.err_out.contains("`addlib`"), "got: {r.out}{r.err_out}")
    assert(r.err_out.contains("lib/blink.toml"), "got: {r.out}{r.err_out}")
}
