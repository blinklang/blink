// A derived from_json runs json_clear before it parses, and std.json keeps one node pool for
// the whole program. So a derived from_json called in the middle of a hand-written walk empties
// the pool that the outer parse still reads, and the outer root no longer names its node.

import std.json.{json_parse, json_get, json_as_str}

@derive(Deserialize)
type Inner { n: Int }

type Outer { name: Str, inner: Inner }

fn outer_from_json(input: Str) -> Result[Outer, Str] {
    let root = json_parse(input)
    let inner_text = json_as_str(json_get(root, "inner"))
    let inner = Inner.from_json(inner_text)?
    Ok(Outer { name: json_as_str(json_get(root, "name")), inner: inner })
}

let OUTER_TEXT = "\{\"name\": \"outer\", \"inner\": \"\{\\\"n\\\": 5}\"}"

test "a derived from_json inside a hand-written walk reads its own input" {
    match outer_from_json(OUTER_TEXT) {
        Ok(o) => assert_eq(o.inner.n, 5)
        Err(e) => assert(false, "outer_from_json failed: {e}")
    }
}

test.failing(
    "a derived from_json inside a hand-written walk leaves the outer parse readable",
    reason: "a derived from_json calls json_clear, which empties the one node pool the outer parse reads",
) {
    let o = outer_from_json(OUTER_TEXT).unwrap()
    assert_eq(o.name, "outer")
}
