// A tuple is Hash when every element is (sections/03_types.md *Hash Contract and Seeding*), so a
// derived Hash takes a tuple field of Hash elements, and the derived Eq on the same type agrees
// with it: equal values hash equal and find each other as Map keys.

@derive(Eq, Hash)
type TupleFieldPoint {
    p: (Int, Int)
}

@derive(Eq, Hash)
type TupleFieldNested {
    n: ((Int, Str), Bool)
    tag: Str
}

type TupleFieldPair = (Str, Int)

@derive(Eq, Hash)
type TupleFieldByAlias {
    q: TupleFieldPair
}

@derive(Eq, Hash)
type TupleFieldShape {
    Dot((Int, Int))
    Empty
}

@derive(Eq, Hash)
type TupleFieldOf[T] {
    v: (T, Int)
}

test "a struct with a tuple field keys a Map" {
    let mut m: Map[TupleFieldPoint, Int] = Map.new()
    m.insert(TupleFieldPoint { p: (1, 2) }, 3)
    m.insert(TupleFieldPoint { p: (2, 1) }, 4)
    assert_eq(m.len(), 2)
    assert_eq(m.get(TupleFieldPoint { p: (1, 2) }), Some(3))
    assert_eq(m.get(TupleFieldPoint { p: (2, 1) }), Some(4))
}

test "the derived Eq and the derived Hash agree on a tuple field" {
    let a = TupleFieldPoint { p: (1, 2) }
    let b = TupleFieldPoint { p: (1, 2) }
    let c = TupleFieldPoint { p: (2, 1) }
    assert(a == b)
    assert_eq(a.hash(), b.hash())
    assert(a != c)
    assert(a.hash() != c.hash())
}

test "a nested tuple field and a tuple alias field hash by their elements" {
    let x = TupleFieldNested { n: ((1, "a"), true), tag: "t" }
    assert(x == TupleFieldNested { n: ((1, "a"), true), tag: "t" })
    assert_eq(x.hash(), TupleFieldNested { n: ((1, "a"), true), tag: "t" }.hash())
    assert(x.hash() != TupleFieldNested { n: ((1, "a"), false), tag: "t" }.hash())
    let y = TupleFieldByAlias { q: ("k", 1) }
    assert(y == TupleFieldByAlias { q: ("k", 1) })
    assert_eq(y.hash(), TupleFieldByAlias { q: ("k", 1) }.hash())
    assert(y.hash() != TupleFieldByAlias { q: ("k", 2) }.hash())
}

test "a variant with a tuple payload keys a Set" {
    let mut s: Set[TupleFieldShape] = Set.new()
    s.insert(TupleFieldShape.Dot((1, 2)))
    s.insert(TupleFieldShape.Dot((1, 2)))
    s.insert(TupleFieldShape.Empty)
    assert_eq(s.len(), 2)
    assert(s.contains(TupleFieldShape.Dot((1, 2))))
    assert(!s.contains(TupleFieldShape.Dot((2, 1))))
}

test "a generic tuple field hashes at an instance of Hash elements" {
    let mut m: Map[TupleFieldOf[Str], Int] = Map.new()
    m.insert(TupleFieldOf { v: ("a", 1) }, 5)
    assert_eq(m.get(TupleFieldOf { v: ("a", 1) }), Some(5))
    assert_eq(m.get(TupleFieldOf { v: ("a", 2) }), None)
    assert_eq(TupleFieldOf { v: ("a", 1) }.hash(), TupleFieldOf { v: ("a", 1) }.hash())
}
