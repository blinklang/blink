// A failed assert_eq or assert_ne in main is a panic, so the `on_panic` hook gets it with the
// file and the line of the call, as it gets a failed assert (sections/02_syntax.md §2.20
// *What the hook gets*).

import compile_test_helpers.{compile_and_run}

fn hooked_src(call: Str) -> Str {
    #"import std.panic.{PanicInfo}
fn report(p: PanicInfo) -> Never ! IO.Print, Env.Exit {
    io.println(p.message)
    io.println(p.file)
    match p.line {
        Some(n) => io.println("line {n}")
        None => io.println("no line")
    }
    env.exit(70)
}

fn main() ! IO, Env {
    with on_panic(report) {
        let n = 3
        let s = "ab"
        let l = [1, 2]
"#.concat("        {call}\n").concat(#"        io.println("after")
    }
}
"#)
}

// `message` is the start of the hook's message: how an aggregate side renders is not this
// file's concern. Returns the whole message line, for a caller that checks all of it.
fn expect_hook(call: Str, tag: Str, message: Str) -> Str ! FS.Delete, FS.Write, Process.Spawn, FS.Read, Env.Read {
    let r = compile_and_run(hooked_src(call), tag)
    assert(r.exit_code == 70, "exit {r.exit_code}: {r.out}{r.err_out}")
    assert_eq(r.err_out, "")
    let lines = r.out.split("\n")
    assert(lines.get(0).unwrap().starts_with(message), r.out)
    assert(lines.get(1).unwrap().ends_with("/{tag}.bl"), r.out)
    assert_eq(lines.get(2).unwrap(), "line 17")
    lines.get(0).unwrap()
}

test "the hook gets a failed assert_eq of two Ints with its file and line" {
    let _ = expect_hook("assert_eq(n, 5)", "ae_int_{getpid()}", "ASSERT_EQ FAILED: 3 != 5")
}

test "the hook gets a failed assert_eq of two Strs with its file and line" {
    let _ = expect_hook(#"assert_eq(s, "cd")"#, "ae_str_{getpid()}", #"ASSERT_EQ FAILED: "ab" != "cd""#)
}

test "the hook gets a failed assert_eq of two Lists with its file and line" {
    let _ = expect_hook("assert_eq(l, [3])", "ae_list_{getpid()}", "ASSERT_EQ FAILED: ")
}

test "the hook gets a failed assert_ne with its file and line" {
    let _ = expect_hook("assert_ne(n, 3)", "ae_ne_{getpid()}", "ASSERT_NE FAILED: 3 == 3")
}

// The hook's message ends with the call's own message, as a failed assert's does.
test "the hook gets the message of a failed assert_eq" {
    let got = expect_hook(#"assert_eq(n, 5, "ctx")"#, "ae_msg_{getpid()}", "ASSERT_EQ FAILED")
    assert_eq(got, "ASSERT_EQ FAILED: 3 != 5: ctx")
}

test "the hook gets the interpolated message of a failed assert_ne" {
    let got = expect_hook(#"assert_ne(s, "ab", "ctx {n}")"#, "ae_ne_msg_{getpid()}", "ASSERT_NE FAILED")
    assert_eq(got, #"ASSERT_NE FAILED: "ab" == "ab": ctx 3"#)
}

test "the hook gets the message of a failed assert_eq of two Lists" {
    let got = expect_hook(#"assert_eq(l, [3], "ctx")"#, "ae_list_msg_{getpid()}", "ASSERT_EQ FAILED: ")
    assert(got.ends_with(": ctx"), got)
}
