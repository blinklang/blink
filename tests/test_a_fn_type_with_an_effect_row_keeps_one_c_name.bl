// A row on a fn type is not part of the C shape: `Box[fn(Int) -> Int ! IO.Print]` and
// `Box[fn(Int) -> Int]` are one C type, so one fn shape never splits into one C type per row.

import compile_test_helpers

fn count(text: Str, part: Str) -> Int {
    text.split(part).len() - 1
}

fn src() -> Str {
    #"type Box[T] { val: T }

fn shout(x: Int) -> Int ! IO.Print {
    io.println("shout {x}")
    x
}

fn double(x: Int) -> Int { x * 2 }

fn main() {
    let a: Box[fn(Int) -> Int ! IO.Print] = Box { val: shout }
    let b: Box[fn(Int) -> Int] = Box { val: double }
    let f = a.val
    let g = b.val
    io.println("{f(3)} {g(4)}")
}
"#
}

test "a rowful and a rowless fn type argument give one C type" {
    let c = compile_test_helpers.compile_and_emit_c(src(), "fn_row_one_c_name")
    assert(c.len() > 0, "the program emits C")
    assert_eq(count(c, "typedef struct blink_4Box_"), 1)
    assert_eq(count(c, "typedef struct blink_4Box_0Fn1_1int_1int "), 1)
}

test "a program with a rowful and a rowless fn type argument runs" {
    let r = compile_test_helpers.compile_and_run(src(), "fn_row_one_c_name_run")
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("shout 3"), "stdout: {r.out}")
    assert(r.out.contains("3 8"), "stdout: {r.out}")
}
