// A struct field of a fn type, called through the parenthesized field with one argument,
// compiles and runs. A fn type takes no parameter names (`fn(Int) -> Int`); the spelling
// `fn(x: Int) -> Int` in a field is a parse error, which
// tests/test_type_body_holds_fields_or_variants_not_both.bl covers.

import compile_test_helpers.{compile_and_run}

test "calling a fn-typed struct field with one argument runs" {
    let src = #"
import std.io
type H { f: fn(Int) -> Int }
fn main() {
    let h = H { f: fn(x: Int) -> Int { x + 1 } }
    io.println("{(h.f)(2)}")
}
"#
    let r = compile_and_run(src, "_fn_typed_field_one_argument")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "3\n")
}
