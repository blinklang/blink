// A written BlockHandler impl over a generic type has one enter and one exit body per instance,
// and a with-item at an instance where the impl's bound holds runs both (§3.6 "Polymorphic
// Trait Implementations", §5.5). An instance where the bound fails is E0306 at the item, so
// no body is built for it.

let mut log: List[Str] = []

trait Tag {
    fn tag(self) -> Int
}

impl Tag for Int {
    fn tag(self) -> Int { self }
}

type Hd[T] { v: T }

impl[T: Tag] BlockHandler for Hd[T] {
    type Context = Int
    fn enter(self) -> Int {
        log.push("enter {self.v.tag()}")
        self.v.tag() * 2
    }
    fn exit(self, ok: Bool) {
        log.push("exit {self.v.tag()} {ok}")
    }
}

fn held[U: Tag](u: U) -> Int {
    let mut r = 0
    with Hd { v: u } as c {
        r = c + 1
    }
    r
}

test "a with-item at a concrete instance where the bound holds enters and exits" {
    log = []
    with Hd { v: 3 } as c {
        log.push("in {c}")
    }
    assert_eq(log, ["enter 3", "in 6", "exit 3 true"])
}

test "a with-item at a type parameter with the bound enters and exits" {
    log = []
    assert_eq(held(5), 11)
    assert_eq(log, ["enter 5", "exit 5 true"])
}
