// A trait method can declare its own type parameters, and an impl can be generic. A call that
// reaches such a method through a bound, a trait-qualified head or an impl over a builtin
// generic builds the instance its arguments fix, the same as a direct call on a concrete type.

import compile_test_helpers.{compile_and_run}

fn runs_and_prints(src: Str, fixture: Str, want: Str) ! FS.Delete, FS.Write, Process.Spawn, FS.Read, Env.Read {
    let r = compile_and_run(src, fixture)
    assert(r.exit_code == 0, "{r.out}{r.err_out}")
    assert_eq(r.out.trim(), want)
}

test "a method with its own type parameter runs through a bound on its receiver" {
    runs_and_prints(#"
trait Tm { fn m[U](self, xs: List[U], n: Int) -> Int }
type B { v: Int }
impl Tm for B { fn m[U](self, xs: List[U], n: Int) -> Int { xs.len() + n + self.v } }
fn drive[R: Tm, U](r: R, xs: List[U]) -> Int { r.m(xs, 1) }
fn main() { io.println("{drive(B { v: 1 }, [1])} {drive(B { v: 2 }, ["a", "b"])}") }
"#, "_gbound_value_recv", "3 5")
}

test "a method with its own type parameter runs through a trait-qualified call on a bound" {
    runs_and_prints(#"
trait Tm { fn m[U](self, xs: List[U], n: Int) -> Int }
type B { v: Int }
impl Tm for B { fn m[U](self, xs: List[U], n: Int) -> Int { xs.len() + n + self.v } }
fn drive[R: Tm, U](r: R, xs: List[U]) -> Int { Tm.m(r, xs, 1) }
fn main() { io.println("{drive(B { v: 1 }, ["a", "b"])}") }
"#, "_gbound_qualified", "4")
}

test "a method with its own type parameter runs through a bound on a generic impl" {
    runs_and_prints(#"
trait Tm { fn m[U](self, xs: List[U], n: Int) -> Int }
type B[T] { v: T }
impl[T] Tm for B[T] { fn m[U](self, xs: List[U], n: Int) -> Int { xs.len() + n } }
fn drive[R: Tm, U](r: R, xs: List[U]) -> Int { r.m(xs, 1) }
fn main() { io.println("{drive(B { v: "s" }, [1.5])} {B { v: 2 }.m(["x"], 3)}") }
"#, "_gbound_poly_struct", "2 4")
}

test "a method with its own type parameter runs on an impl over a builtin generic" {
    runs_and_prints(#"
trait Own { fn own[U](self, u: U) -> Int }
impl[T] Own for List[T] { fn own[U](self, _u: U) -> Int { self.len() } }
fn main() {
    let l = [1, 2]
    io.println("{l.own("x")} {["a"].own(1.5)}")
}
"#, "_gbound_builtin_poly", "2 1")
}

test "a method with its own type parameter calls itself on an impl over a builtin generic" {
    runs_and_prints(#"
trait Tm { fn m[U](self, xs: List[U], n: Int) -> Int }
impl[T] Tm for List[T] { fn m[U](self, xs: List[U], n: Int) -> Int {
    if n == 0 { return self.len() + xs.len() }
    self.m(xs, n - 1) } }
fn main() {
    let e: List[Str] = []
    io.println("{[1].m(e, 2)} {[1, 2].m(["a"], 1)}")
}
"#, "_gbound_builtin_recursive", "1 3")
}

test "into through a bound reaches a generic From impl" {
    runs_and_prints(#"
type X { n: Int }
impl[U] From[List[U]] for X {
    fn from(xs: List[U]) -> X { X { n: xs.len() } }
}
fn g[T: Into[X]](x: T) -> X { x.into() }
fn main() { io.println("{g([1, 2]).n} {g(["a"]).n}") }
"#, "_gbound_into_generic_from", "2 1")
}
