// A generic impl has one body per instance, and an instance comes from a call. An impl
// that no call reaches has no instance, so it has no copy to write, and that is not an
// error: `blink check` accepted the file, so the build must finish too.
//
// The whole file is the fixture. If a single body here stops the build, no test runs.

trait Counted {
    fn counted(self) -> Int
}

trait Two {
    fn first(self) -> Int
    fn second(self) -> Int
}

trait Pick[T] {
    fn pick(self, d: T) -> T
    fn pick_again(self, d: T) -> T
}

trait Own {
    fn own[U](self, u: U) -> U
    fn own_unused[U](self, u: U) -> U
}

type NeverBuilt[T] { v: T }
type Built[T] { v: T }
type Pair[T] { v: T }
type Plain { v: Int }
type Shown[T] { v: T }
type Printed[T] { v: T }
type Shut[T] { v: T }
type NoBound { x: Int }
type Bounded[T] { v: T }
type OwnEq[T] { v: T }

@derive(Debug, Eq, Clone, Hash, Ord)
type Derived[T] { v: T }

trait Needed {
    fn needed(self) -> Int
}

// Neither the type nor the impl has an instance.
impl[T] Counted for NeverBuilt[T] {
    fn counted(_self) -> Int { 1 }
}

// The type has an instance and the impl has none.
impl[T] Counted for Built[T] {
    fn counted(_self) -> Int { 2 }
}

impl[T] Two for Pair[T] {
    fn first(_self) -> Int { 10 }
    fn second(_self) -> Int { 20 }
}

// A signature names the binder, so each method is one body per element.
impl[T] Pick[T] for List[T] {
    fn pick(_self, d: T) -> T { d }
    fn pick_again(_self, d: T) -> T { d }
}

impl Own for Plain {
    fn own[U](_self, u: U) -> U { u }
    fn own_unused[U](_self, u: U) -> U { u }
}

impl[T] Own for Pair[T] {
    fn own[U](_self, u: U) -> U { u }
    fn own_unused[U](_self, u: U) -> U { u }
}

impl[T] Debug for Printed[T] {
    fn debug(_self) -> Str { "printed" }
}

impl[T] Display for Shown[T] {
    fn fmt(_self, sb: StringBuilder) { sb.write("shown") }
}

impl[T] Closeable for Shut[T] {
    fn close(_self) { }
}

// A bound the only instance of the type does not meet: no copy means no judgment of it.
impl[T: Display] Counted for Printed[T] {
    fn counted(_self) -> Int { 3 }
}

// The pass registers an operator method at each instance of the type, with no call. Here
// the only instance lacks the bound the body needs, so the pass must not ask for a copy.
impl[T: Needed] Eq for Bounded[T] {
    fn eq(self, o: Bounded[T]) -> Bool { self.v.needed() == o.v.needed() }
}

impl[T: Needed] Clone for Bounded[T] {
    fn clone(self) -> Bounded[T] {
        let _n = self.v.needed()
        self
    }
}

fn same[A](x: A) -> A { x }

// A type instance gives no argument for the method's own binder, so this body has a type
// nothing solves.
impl[T] Eq for OwnEq[T] {
    fn eq[U](_self, _o: OwnEq[T]) -> Bool {
        let c: Option[OwnEq[U]] = None
        let d = same(c)
        d.is_none()
    }
}

test "a type with an instance builds when no call reaches its generic impl" {
    assert_eq(Built { v: 5 }.v, 5)
    assert_eq(Printed { v: NoBound { x: 7 } }.v.x, 7)
    assert_eq(Shown { v: 8 }.v, 8)
    assert_eq(Shut { v: 9 }.v, 9)
    assert_eq(Derived { v: 6 }.v, 6)
}

test "an operator impl builds when the type instance lacks the bound its body needs" {
    assert_eq(Bounded { v: NoBound { x: 1 } }.v.x, 1)
}

test "an operator method with its own binder builds when no call reaches it" {
    assert_eq(OwnEq { v: 2 }.v, 2)
}

test "the called method of a generic impl runs its own body when its neighbour is uncalled" {
    assert_eq(Pair { v: 1 }.first(), 10)
}

test "the called method of a per-element impl runs when its neighbour is uncalled" {
    let xs = [1, 2, 3]
    assert_eq(xs.pick(4), 4)
}

test "a method with its own binder runs when its neighbour is uncalled" {
    assert_eq(Plain { v: 1 }.own(11), 11)
    assert_eq(Pair { v: 1 }.own("twelve"), "twelve")
}
