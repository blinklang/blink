// A build of a package compiles each imported module, not only the entry file, so an impl in
// an imported module that no call reaches must not stop it. The fixture lives under a fresh
// temporary directory, since the test tree itself sits inside a project.

import std.process.{ProcessResult, ChildEnd}

fn sh(cmd: Str) -> ProcessResult ! Process.Spawn {
    process.run("sh", ["-c", cmd]).unwrap()
}

test "a package builds and runs with a generic impl no call reaches in an imported module" {
    let dir = sh("mktemp -d /tmp/blink_unreached_impl_in_module.XXXXXX").out.trim()
    let _ = sh("mkdir -p {dir}/src")
    fs.write("{dir}/blink.toml", "[package]\nname = \"app\"\nversion = \"0.1.0\"\n").unwrap()
    // A lock no older than blink.toml keeps dependency resolution out of the command.
    fs.write("{dir}/blink.lock", "[metadata]\nlockfile-version = 1\n").unwrap()
    fs.write("{dir}/src/shapes.bl", "pub trait Counted \{\n    fn counted(self) -> Int\n}\n\npub type Box[T] \{ v: T }\n\nimpl[T] Counted for Box[T] \{\n    fn counted(_self) -> Int \{ 1 }\n}\n\npub fn answer() -> Int \{ 7 }\n").unwrap()
    fs.write("{dir}/src/main.bl", "import shapes\n\nfn main() \{\n    io.println(\"\{shapes.answer()}\")\n}\n").unwrap()
    // BLINK_BIN makes the build workers the compiler under test, not the blink on PATH.
    let r = sh("B=$(pwd)/build/blink; cd {dir} && BLINK_BIN=$B $B run src/main.bl")
    let _ = sh("rm -rf {dir}")

    assert_eq(r.end, ChildEnd.Exited(0))
    assert_eq(r.out.trim(), "7")
}
