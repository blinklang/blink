// The per-instance body a call reaches must be the one the instance needs, and must exist.
// Each row here is a way of reaching a generic impl, with an impl beside it that no call
// reaches, so the body stage has both cases in one program.

trait Answer {
    fn answer(self) -> Int
    fn unused(self) -> Int
}

type First[T] { v: T }
type Second[T] { v: T }

impl[T] Answer for First[T] {
    fn answer(_self) -> Int { 1 }
    fn unused(_self) -> Int { 100 }
}

impl[T] Answer for Second[T] {
    fn answer(_self) -> Int { 2 }
    fn unused(_self) -> Int { 200 }
}

trait Holder[T] {
    fn held(self) -> T
}

impl[T] Holder[T] for First[T] {
    fn held(self) -> T { self.v }
}

impl[T] Eq for Second[T] {
    fn eq(_self, _other: Second[T]) -> Bool { true }
}

fn through_a_bound[X: Answer](x: X) -> Int { x.answer() }

test "a direct call picks the impl of the receiver's own type" {
    assert_eq(First { v: 1 }.answer(), 1)
    assert_eq(Second { v: 1 }.answer(), 2)
}

test "a call through a bound reaches the impl of the instance" {
    assert_eq(through_a_bound(First { v: "a" }), 1)
    assert_eq(through_a_bound(Second { v: "a" }), 2)
}

test "a qualified call reaches the impl of the argument" {
    assert_eq(Answer.answer(First { v: 1 }), 1)
    assert_eq(Answer.answer(Second { v: 1 }), 2)
}

test "two instances of one impl each read their own element" {
    assert_eq(First { v: 3 }.held(), 3)
    assert_eq(First { v: "three" }.held(), "three")
}

test "an operator reaches a written impl with no call node" {
    assert(Second { v: 1 } == Second { v: 2 })
}
