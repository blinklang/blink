// A handler that a `with` installs stays live for the whole `with` body, on main and on a spawned
// task (sections/02_syntax.md §2.8). The handler captures a string built at run time, and the body
// allocates enough to force many collections before it reads the handler.

effect Tag {
    effect Get {
        fn tag() -> Str
    }
}

fn tagged(name: Str) -> Handler[Tag] {
    handler Tag {
        fn tag() -> Str { name }
    }
}

fn churn() -> Int {
    let mut total = 0
    for i in 0..200000 {
        let parts = ["x{i}", "y{i}", "z{i}"]
        total = total + parts.join("-").len()
    }
    total
}

fn read_after_churn() -> Str ! Tag {
    let n = churn()
    "{tag.tag()}:{n > 0}"
}

test "a handler on main stays live while its with body allocates" {
    let name = "main-{[1, 2, 3].len()}"
    let saw = with tagged(name) { read_after_churn() }
    assert_eq(saw, "main-3:true")
}

test "a handler on a spawned task stays live while its with body allocates" {
    let mut saw = ""
    async.scope {
        let h = async.spawn(fn() {
            let name = "task-{[1, 2].len()}"
            with tagged(name) { read_after_churn() }
        })
        saw = h.await
    }
    assert_eq(saw, "task-2:true")
}

test "a handler at the spawn site stays live in the task while it allocates" {
    let mut saw = ""
    with tagged("site-{[1].len()}") {
        async.scope {
            let h = async.spawn(fn() { read_after_churn() })
            saw = h.await
        }
    }
    assert_eq(saw, "site-1:true")
}
