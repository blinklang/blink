// A handler may name its effect through the qualifier of the module that declares it, through an
// `as` alias of that module, or through a selective import alias (sections/04_effects.md §4.3 "A
// qualified effect name"). Each spelling names the one declared effect, so the handler fills
// that effect's slot, and `Handler[zzhq_log.Log]` and `Handler[Log]` are one type.

import std.process.{ProcessResult}

fn run_fixture(name: Str, flags: List[Str]) -> ProcessResult ! Process.Spawn {
    let mut args = ["run"]
    for f in flags { args.push(f) }
    args.push("tests/zzhq_handler_qualifier/src/{name}.bl")
    process.run("build/blink", args).unwrap()
}

fn assert_prints_with(name: Str, flags: List[Str], want: Str) ! IO.Print, Process.Spawn {
    let r = run_fixture(name, flags)
    if r.out != want { io.println("FAIL[{name}] want '{want}', got: {r.out}{r.err_out}") }
    assert(r.success())
    assert_eq(r.out, want)
}

// A one-unit build and a per-module build each name the effect's slot.
fn assert_prints_both(name: Str, want: Str) ! IO.Print, Process.Spawn {
    assert_prints_with(name, [], want)
    assert_prints_with(name, ["--no-per-module"], want)
}

test "a with handler names the effect through the module qualifier" {
    assert_prints_both("main_with_qualified", "q:note\n")
}

test "a with handler names the effect through an alias of the module" {
    assert_prints_both("main_with_alias", "a:note\n")
}

test "a with handler names the effect through a selective import alias" {
    assert_prints_both("main_with_selective_alias", "s:note\n")
}

test "a qualified Handler type holds a bare handler through a param, an alias, a field and a projection" {
    assert_prints_both("main_handler_values", "v:note\nv:note\nb:note\nv:emit\n")
}
