// A renamed core import names the builtin (sections/07_trust_modules_metadata.md §10.6), so a
// value of that type sits in a Map next to a hashable key, and a key type parameter bound inline,
// in an impl's where clause or through a supertrait keys a Map whose values have that type.
import blink.core.{Bytes as CoreBytes}
import blink.core.{List as CoreList}

trait Key: Hash + Eq {}
impl Key for Str {}

trait Cnt {
    fn cnt(self) -> Int
}

type Hold[K] {
    k: K
}

fn inline_bound[K: Hash + Eq](k: K) -> Int {
    let mut m: Map[K, CoreBytes] = Map()
    m.insert(k, CoreBytes.from_str("ab"))
    m.len()
}

impl[K] Cnt for Hold[K] where K: Hash + Eq {
    fn cnt(self) -> Int {
        let mut m: Map[K, CoreBytes] = Map()
        m.insert(self.k, CoreBytes.from_str("abc"))
        m.len()
    }
}

fn super_bound[K: Key](k: K) -> Int {
    let mut m: Map[K, CoreBytes] = Map()
    m.insert(k, CoreBytes.from_str("a"))
    m.len()
}

test "a renamed core import is a Map value beside a hashable key" {
    let mut m: Map[Str, CoreBytes] = Map()
    m.insert("a", CoreBytes.from_str("xyz"))
    let mut n: Map[(Int, Str), CoreList[Int]] = Map()
    n.insert((1, "b"), [1, 2])
    assert_eq("{m.len()} {(m.get("a") ?? CoreBytes.new()).len()} {n.len()}", "1 3 1")
}

test "a key type parameter bound inline, in a where clause or through a supertrait keys a Map of renamed Bytes" {
    let h = Hold { k: 7 }
    assert_eq("{inline_bound(1)} {h.cnt()} {super_bound("k")}", "1 1 1")
}
