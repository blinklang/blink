// The first token of a string hole's expression must not be `{`, whitespace skipped, in every
// string form and at every depth (sections/02_syntax.md §2.4, "A hole does not start with `{`").
// Such a hole is the parse error InterpDoubleBrace (E1130), once per bad hole, and the rest of
// the string and the file still parse. The help names `\{` and `#"..."#` for a literal brace and
// `( )` for a block; the spec picks no one rewrite, so the row carries no fix.

import std.process.{ProcessResult}

let DIR = ".tmp/a_hole_that_starts_with_a_brace"

fn sh(cmd: Str) -> ProcessResult {
    process_run("sh", ["-c", cmd])
}

fn ln(s: Str) -> Str {
    s.concat("\n")
}

fn write_case(name: Str, body: Str) {
    write_file("{DIR}/{name}.bl", "fn main() \{\n    let x = 5\n{body}}\n\nfn f(s: Str) -> Str \{ s \}\n")
}

fn check_json(name: Str, body: Str) -> ProcessResult {
    write_case(name, body)
    sh("B=$(pwd)/build/blink; cd {DIR} && $B check --json {name}.bl")
}

// Typecheck still runs after a parse error and reports on the tree the parser built for
// recovery, so only the parser's rows are counted. A parse error other than E1130 would mean the
// parser lost its place.
fn parser_rows(out: Str) -> List[Str] {
    let mut rows: List[Str] = []
    for row in out.trim().split("\n") {
        if row.contains("\"code\":\"E11") { rows.push(row) }
    }
    rows
}

// Each want is "line:col" of the `{` of the hole's opener (after the `#` in a raw string), in
// source order.
fn expect_e1130(name: Str, body: Str, want: List[Str]) -> Str {
    let r = check_json(name, body)
    let mut problems: List[Str] = []
    if r.exit_code != 1 { problems.push("{name}: want exit 1, got {r.exit_code}") }
    let rows = parser_rows(r.err_out)
    if rows.len() != want.len() { problems.push("{name}: want {want.len()} parser rows, got {rows.len()}:\n{r.err_out}") }
    let mut i = 0
    while i < rows.len() && i < want.len() {
        let row = rows.get(i).unwrap()
        let parts = want.get(i).unwrap().split(":")
        let line = parts.get(0).unwrap()
        let col = parts.get(1).unwrap()
        if !row.contains("\"code\":\"E1130\"") { problems.push("{name}: want E1130 in {row}") }
        if !row.contains("\"name\":\"InterpDoubleBrace\"") { problems.push("{name}: want InterpDoubleBrace in {row}") }
        if !row.contains("\"line\":{line},\"col\":{col}") { problems.push("{name}: want {line}:{col} in {row}") }
        if row.contains("\"fix\"") { problems.push("{name}: E1130 must not carry a fix: {row}") }
        i = i + 1
    }
    problems.join("\n")
}

test "a hole that starts with a brace is E1130 in every string form" {
    let _ = sh("rm -rf {DIR}; mkdir -p {DIR}")
    let mut problems: List[Str] = []
    problems.push(expect_e1130("plain", ln(#"    io.println("a {{x}} b")"#), ["3:19"]))
    problems.push(expect_e1130("spaced", ln(#"    io.println("a { {x} } b")"#), ["3:19"]))
    problems.push(expect_e1130("newline", "    io.println(\"a \{\n\{x\}\} b\")\n", ["3:19"]))
    problems.push(expect_e1130("template", ln(#"    let _ = t"{{x}}""#), ["3:15"]))
    problems.push(expect_e1130("raw", ln(##"    let _ = #"#{{x}}"#"##), ["3:16"]))
    problems.push(expect_e1130("raw_template", ln(##"    let _ = t#"#{{x}}"#"##), ["3:17"]))
    let _ = sh("rm -rf {DIR}")
    assert_eq(problems.join("\n").trim(), "")
}

test "a bad hole inside a hole's string is one E1130 at the inner hole" {
    let _ = sh("rm -rf {DIR}; mkdir -p {DIR}")
    let p = expect_e1130("nested", ln(#"    io.println("a {f("{{x}}")} b")"#), ["3:23"])
    let _ = sh("rm -rf {DIR}")
    assert_eq(p, "")
}

test "two bad holes are two errors and the file still parses" {
    let _ = sh("rm -rf {DIR}; mkdir -p {DIR}")
    let mut problems: List[Str] = []
    problems.push(expect_e1130("two", ln(#"    io.println("{{x}} and {{x}}")"#), ["3:17", "3:27"]))
    let body = ln(#"    io.println("{{x}} b")"#).concat(ln(#"    io.println("{x} ok")"#)).concat(ln(#"    io.println(" { {x} }")"#))
    problems.push(expect_e1130("lines", body, ["3:17", "5:18"]))
    // A type error after the bad string shows that the parser kept the statements that follow.
    let r = check_json("after", ln(#"    io.println("{{x}}")"#).concat("    let y: Str = 5\n    io.println(y)\n"))
    if !r.err_out.contains("\"line\":4,") { problems.push("after: want a row on line 4:\n{r.err_out}") }
    let _ = sh("rm -rf {DIR}")
    assert_eq(problems.join("\n").trim(), "")
}

test "E1130 help names both literal-brace forms and parentheses for a block" {
    let _ = sh("rm -rf {DIR}; mkdir -p {DIR}")
    write_case("help", ln(#"    io.println("a {{x}} b")"#))
    let r = sh("B=$(pwd)/build/blink; cd {DIR} && $B check help.bl")
    let _ = sh("rm -rf {DIR}")
    assert_eq(r.exit_code, 1)
    assert(r.err_out.contains("error[InterpDoubleBrace]: a string hole starts with `\{`"))
    assert(r.err_out.contains(##"help: for a literal brace, write `\{` or use `#"..."#`; to start the expression with a block, wrap it in `( )`"##))
}

test "check and build report the same E1130" {
    let _ = sh("rm -rf {DIR}; mkdir -p {DIR}")
    write_case("same", ln(#"    io.println("a {{x}} b")"#))
    let c = sh("B=$(pwd)/build/blink; cd {DIR} && $B check same.bl 2>&1")
    let b = sh("B=$(pwd)/build/blink; cd {DIR} && $B build same.bl 2>&1")
    let _ = sh("rm -rf {DIR}")
    assert_eq(c.exit_code, 1)
    assert(b.exit_code != 0)
    assert(c.out.contains("error[InterpDoubleBrace]") && c.out.contains("same.bl:3:19"))
    assert(b.out.contains("error[InterpDoubleBrace]") && b.out.contains("same.bl:3:19"))
}

test "blink explain E1130 names the rule" {
    let r = sh("build/blink explain E1130")
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("E1130 -- InterpDoubleBrace"))
}

test "a lone brace in a raw string is text, not a hole" {
    let x = 5
    assert_eq(#"{{x}}"#, "\{\{x\}\}")
    assert_eq(#"a { {x} } b"#, "a \{ \{x\} \} b")
    assert_eq(x, 5)
}

test "a hole that starts with a parenthesized block runs" {
    let x = 5
    assert_eq("{({ x })}", "5")
    assert_eq("{ ({ x + 1 }) }", "6")
}

test "an escaped brace is a literal brace" {
    let x = 5
    assert_eq("\{x}", #"{x}"#)
    assert_eq("\{{x}}", #"{5}"#)
    assert_eq(x, 5)
}
