// A JSON diagnostic with no source location has no `span` (sections/06_tooling.md §8.10.5):
// it never carries a placeholder location such as `line: 0`. The labels of such an entry go
// with it, since a label holds the same position. A diagnostic with a location keeps its span.

import std.process.{ChildEnd, ChildLimits, ProcessResult}
import std.time.{Duration}

fn sh(cmd: Str) -> ProcessResult {
    process.run("sh", ["-c", cmd], limits: ChildLimits { timeout: Some(Duration.seconds(120)) }).unwrap()
}

// `blink check --format json` on one file in a fresh directory with no blink.toml.
fn check_json(source: Str) -> ProcessResult {
    let dir = sh("mktemp -d /tmp/blink_no_span.XXXXXX").out.trim()
    write_file("{dir}/main.bl", source)
    let r = sh("B=$(pwd)/build/blink; cd {dir} && $B check --format json main.bl")
    let _ = sh("rm -rf {dir}")
    r
}

fn line_with(text: Str, needle: Str) -> Str {
    for line in text.split("\n") {
        if line.contains(needle) {
            return line
        }
    }
    ""
}

test "an import an orphan file may not make has no span and no line 0" {
    // OrphanFile reports no position, so the row has no location to give.
    let r = check_json("import notpkg\n\nfn main() \{\n}\n")
    let row = line_with(r.err_out, "\"OrphanFile\"")
    assert(row != "", "no OrphanFile row:\n{r.err_out}")
    assert(!row.contains("\"span\""), row)
    assert(!row.contains("\"line\":0"), row)
    assert(!row.contains("\"labels\""), row)
}

test "a diagnostic with a location keeps its span" {
    let r = check_json("import notpkg\n\nfn main() \{\n}\n")
    let row = line_with(r.err_out, "\"UnusedImport\"")
    assert(row != "", "no UnusedImport row:\n{r.err_out}")
    assert(row.contains("\"span\":\{\"file\":\"main.bl\",\"line\":1,"), row)
}
