// A generic alias in a Set element or Map key position means its target at the written arguments
// (sections/03_types.md), so the Hash rule reads each argument the target puts in that position.

import compile_test_helpers.{compile_and_capture}

type G[T] = (T, Int)
type SS[X] = Set[X]
type M[K] = Map[K, Int]
type Nested[Y] = G[(Y, Str)]
type Phantom[P] = (Int, Str)
type Stacked[X] = Set[G[X]]

type Holder[T] {
    items: Set[G[T]]
}

fn empty_of[T]() -> Set[G[T]] {
    Set()
}

fn refused(src: Str, tag: Str) -> Str ! Process.Spawn, FS.Write, FS.Read, FS.Delete, Env.Read {
    let out = compile_and_capture(src, tag)
    assert(out.contains("E1400"), "expected E1400, got: {out}")
    assert(!out.contains("\"severity\":\"ice\""), "expected no ICE, got: {out}")
    out
}

test "a Set of a generic alias of a tuple builds when each argument has Hash" {
    let s: SS[G[Int]] = Set()
    assert_eq(s.len(), 0)
    let n: SS[Nested[Int]] = Set()
    assert_eq(n.len(), 0)
    let st: Stacked[Str] = Set()
    assert_eq(st.len(), 0)
    let m: M[G[Str]] = Map()
    assert_eq(m.len(), 0)
}

test "a parameter the alias's target does not use is no key" {
    let s: SS[Phantom[Float]] = Set()
    assert_eq(s.len(), 0)
    let st: Stacked[Phantom[Float]] = Set()
    assert_eq(st.len(), 0)
}

test "a generic fn and a generic struct take a key through a generic alias" {
    let e = empty_of[Int]()
    assert_eq(e.len(), 0)
    let h: Holder[Str] = Holder { items: Set() }
    assert_eq(h.items.len(), 0)
}

test "an argument with no Hash is E1400 through an alias in a Set alias" {
    let _ = refused(#"
type G[T] = (T, Int)
type SS[X] = Set[X]
fn main() {
    let _s: SS[G[Float]] = Set()
}
"#, "_key_alias_set_alias")
}

test "an argument with no Hash is E1400 through an alias in a Map alias" {
    let _ = refused(#"
type G[T] = (T, Int)
type M[K] = Map[K, Int]
fn main() {
    let _m: M[G[Float]] = Map()
}
"#, "_key_alias_map_alias")
}

test "an alias whose target holds a Set of an alias obliges its own parameter" {
    let _ = refused(#"
type G2[A] = (A, Int)
type S[X] = Set[G2[X]]
fn main() {
    let _s: S[Float] = Set()
}
"#, "_key_alias_stacked")
}

test "an alias over an alias passes the key position down" {
    let _ = refused(#"
type G[T] = (T, Int)
type Over[X] = G[(X, Str)]
type SS[X] = Set[X]
fn main() {
    let _s: SS[Over[Float]] = Set()
}
"#, "_key_alias_over_alias")
}

test "a struct field and a fn signature oblige a parameter through an alias" {
    let _ = refused(#"
type G[T] = (T, Int)
type H[T] { items: Set[G[T]] }
fn main() {
    let _h: H[Float] = H { items: Set() }
}
"#, "_key_alias_struct_field")
    let _ = refused(#"
type G[T] = (T, Int)
fn mk[T]() -> Set[G[T]] { Set() }
fn main() {
    let _s = mk[Float]()
}
"#, "_key_alias_fn_sig")
}

test "a key under a carrier is judged through an alias" {
    let _ = refused(#"
type G[T] = (T, Int)
type SS[X] = Set[X]
fn main() {
    let _s: List[SS[G[Float]]] = []
}
"#, "_key_alias_under_list")
}

test "an alias that names itself in a key position ends the check" {
    let out = compile_and_capture(#"
type A[X] = (X, A[X])
type SS[X] = Set[X]
fn main() {
    let _s: SS[A[Int]] = Set()
}
"#, "_key_alias_recursive")
    assert(!out.contains("timed out"), out)
}
