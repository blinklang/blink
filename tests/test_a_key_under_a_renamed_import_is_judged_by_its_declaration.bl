// A renamed import spells no declaration, so a key written through one must reach the type by the
// declaration the import selects. A key that passes the check and has no Hash stops the build.

import std.process.{ProcessResult, ChildEnd}

fn sh(cmd: Str) -> ProcessResult ! Process.Spawn {
    process.run("sh", ["-c", cmd]).unwrap()
}

fn fixture() -> Str ! Process.Spawn, FS.Write {
    let dir = sh("mktemp -d /tmp/blink_renamed_key.XXXXXX").out.trim()
    let _ = sh("mkdir -p {dir}/src")
    fs.write("{dir}/blink.toml", "[package]\nname = \"app\"\nversion = \"0.1.0\"\n").unwrap()
    // A lock no older than blink.toml keeps dependency resolution out of the command.
    fs.write("{dir}/blink.lock", "[metadata]\nlockfile-version = 1\n").unwrap()
    fs.write("{dir}/src/inner.bl", #"
@derive(Hash, Eq)
pub type In[T] { x: T }
"#).unwrap()
    fs.write("{dir}/src/kinds.bl", #"
import inner.{In as Inn}
pub type G[T] = (T, Int)
pub type GI[T] = (Inn[T], Int)
pub type S[X] = Set[Inn[X]]
@derive(Hash, Eq)
pub type D[T] { f: Inn[T] }
"#).unwrap()
    dir
}

fn run_main(dir: Str, src: Str) -> ProcessResult ! Process.Spawn, FS.Write {
    fs.write("{dir}/src/main.bl", src).unwrap()
    // BLINK_BIN makes the build workers the compiler under test, not the blink on PATH.
    sh("B=$(pwd)/build/blink; cd {dir} && BLINK_BIN=$B $B run src/main.bl 2>&1")
}

fn refused(dir: Str, src: Str) ! Process.Spawn, FS.Write {
    let r = run_main(dir, src)
    assert(r.out.contains("error[MapKeyNotHashable]"), "expected MapKeyNotHashable, got: {r.out}")
    assert(!r.out.contains("internal compiler error"), "expected no ICE, got: {r.out}")
}

test "a key with no Hash is refused through a renamed import in each key position" {
    let dir = fixture()
    refused(dir, #"
import inner.{In as Inn}
fn main() { let s: Set[Inn[Float]] = Set()
    io.println("{s.len()}") }
"#)
    refused(dir, #"
import inner.{In as Inn}
type SS[X] = Set[X]
fn main() { let s: SS[Inn[Float]] = Set()
    io.println("{s.len()}") }
"#)
    refused(dir, #"
import inner.{In as Inn}
fn mk[T]() -> Set[Inn[T]] { Set() }
fn main() { let s = mk[Float]()
    io.println("{s.len()}") }
"#)
    refused(dir, #"
import inner.{In as Inn}
type S2[X] = Set[Inn[X]]
fn main() { let s: S2[Float] = Set()
    io.println("{s.len()}") }
"#)
    let _ = sh("rm -rf {dir}")
}

test "a generic alias under a renamed import judges a key at its arguments" {
    let dir = fixture()
    refused(dir, #"
import kinds.{G as GG}
type SS[X] = Set[X]
fn main() { let s: SS[GG[Float]] = Set()
    io.println("{s.len()}") }
"#)
    refused(dir, #"
import kinds.{G as GG}
fn mk[T]() -> Set[GG[T]] { Set() }
fn main() { let s = mk[Float]()
    io.println("{s.len()}") }
"#)
    let _ = sh("rm -rf {dir}")
}

test "a rename inside the declaring module holds where another module reads the type" {
    let dir = fixture()
    refused(dir, #"
import kinds
fn main() { let s: kinds.S[Float] = Set()
    io.println("{s.len()}") }
"#)
    refused(dir, #"
import kinds
type SS[X] = Set[X]
fn main() { let s: SS[kinds.GI[Float]] = Set()
    io.println("{s.len()}") }
"#)
    refused(dir, #"
import kinds
type SS[X] = Set[X]
fn main() { let s: SS[kinds.D[Float]] = Set()
    io.println("{s.len()}") }
"#)
    let _ = sh("rm -rf {dir}")
}

test "a key with Hash builds through a renamed import" {
    let dir = fixture()
    let r = run_main(dir, #"
import inner.{In as Inn}
import kinds.{G as GG}
type SS[X] = Set[X]
fn main() {
    let s: SS[Inn[Int]] = Set()
    let t: SS[GG[Str]] = Set()
    io.println("{s.len()} {t.len()}")
}
"#)
    let _ = sh("rm -rf {dir}")
    assert_eq(r.out.trim(), "0 0")
    assert_eq(r.end, ChildEnd.Exited(0))
}
