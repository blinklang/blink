// A keyword argument fills the parameter it names, wherever it is written in the call
// (section 2.13), so it binds that parameter's type variables, not those of the
// parameter at its position. A keyword written out of declared order, or after a keyword the
// call leaves to its default, binds the same type as one written in order.

fn kw[U](x: Int, -- a: List[U] = [], -- b: Option[U] = None) -> Int {
    x + a.len() + (if b.is_some() { 10 } else { 0 })
}

fn ap[U](x: Int, -- g: Int = 0, -- f: fn(Int) -> List[U]) -> List[U] { f(x + g) }

fn dfirst[U](x: Int, -- d: List[U] = [], -- f: fn(Int) -> List[U]) -> List[U] { if d.len() > 0 { d } else { f(x) } }

fn dlast[U](x: Int, -- f: fn(Int) -> List[U], -- d: List[U] = []) -> List[U] { if d.len() > 0 { d } else { f(x) } }

fn mix[T, U](x: T, n: Int, -- o: Option[U] = None, -- f: fn(T, Int) -> U) -> U { f(x, n) }

type Bx { v: Int }

trait Kw {
    fn kw[U](self, -- g: Int = 0, -- a: List[U], -- b: Option[U]) -> Int
}

impl Kw for Bx {
    fn kw[U](self, -- g: Int = 0, -- a: List[U], -- b: Option[U]) -> Int {
        self.v + g + a.len() + (if b.is_some() { 10 } else { 0 })
    }
}

test "a keyword after one left to its default binds its type parameter" {
    assert_eq(kw(1, b: Some("s")), 11)
}

test "keywords written out of declared order bind their type parameter" {
    assert_eq(kw(1, b: Some("s"), a: ["t", "u"]), 13)
}

test "a closure by keyword after a defaulted keyword solves the binder of its return" {
    let r = ap(1, f: fn(v) { [v, v * 2] })
    let s = ap(1, f: fn(v) { ["{v}"] }, g: 5)
    // Read through text, so nothing but the closure body gives `r` and `s` their type.
    assert_eq("{r.get(1).unwrap()} {s.get(0).unwrap()}", "2 6")
}

test "a method keyword out of declared order binds its type parameter" {
    let bx = Bx { v: 2 }
    assert_eq(bx.kw(b: Some(1), a: [3]), 13)
    assert_eq(bx.kw(b: Some("s"), a: ["t"], g: 5), 18)
}

test "a default whose type holds a type parameter takes the type the closure solves" {
    let a = dfirst(1, f: fn(v) { [v, v + 1] })
    let b = dlast(2, f: fn(v) { ["{v}"] })
    assert_eq("{a.get(1).unwrap()} {b.get(0).unwrap()}", "2 2")
}

test "positional and keyword arguments together bind each type parameter" {
    let r = mix("ab", 3, f: fn(s, k) { [s.len() * k] })
    assert_eq("{r.get(0).unwrap()}", "6")
}
