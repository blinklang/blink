// sections/03_types.md §3.6: an impl writes no default on a keyword parameter and inherits
// the trait's, so a keyword argument that a call through a bound leaves out takes the trait's
// default. When the method has type parameters of its own, the call reaches a generic
// instance of the impl's method, and that instance does not hold the trait's default. The
// default must still be built, with its own types, whether or not its type names a type
// parameter. Each program must check clean, then build and run and print the expected text.

import compile_test_helpers.{compile_and_run}

fn expect_runs(tag: Str, src: Str, want: Str) ! IO, FS.Delete, FS.Write, Process.Spawn, FS.Read, Env.Read {
    let r = compile_and_run(src, "_default_through_bound_{tag}")
    if r.exit_code != 0 || r.out != want { io.println("FAIL {tag}: exit {r.exit_code}\n{r.out}{r.err_out}") }
    assert(r.exit_code == 0)
    assert_eq(r.out, want)
}

test "a closed default is filled in a generic method called through a bound" {
    expect_runs("closed_default", #"type Bx { v: Int }
trait Kw { fn mk[U](self, x: U, -- n: Int = 1) -> List[U] }
impl Kw for Bx {
    fn mk[U](self, x: U, -- n: Int) -> List[U] {
        let mut l: List[U] = []
        for _ in 0..(n + self.v) { l.push(x) }
        l
    }
}
fn viabound[T: Kw](t: T) -> Int { t.mk("a").len() }
fn main() { io.println("{viabound(Bx { v: 2 })}") }
"#, "3\n")
}

test "a closed default is filled beside a written keyword argument" {
    expect_runs("closed_default_with_keyword", #"type Bx { v: Int }
trait Kw { fn mk[U](self, -- n: Int = 1, -- f: fn(Int) -> List[U]) -> List[U] }
impl Kw for Bx { fn mk[U](self, -- n: Int, -- f: fn(Int) -> List[U]) -> List[U] { f(n + self.v) } }
fn viabound[T: Kw](t: T) -> Int {
    let l: List[Int] = t.mk(f: fn(i) { [i, i] })
    l.len()
}
fn main() { io.println("{viabound(Bx { v: 2 })}") }
"#, "2\n")
}

test "a written keyword argument replaces the trait's default through a bound" {
    expect_runs("written_over_default", #"type Bx { v: Int }
trait Kw { fn mk[U](self, x: U, -- n: Int = 1) -> List[U] }
impl Kw for Bx {
    fn mk[U](self, x: U, -- n: Int) -> List[U] {
        let mut l: List[U] = []
        for _ in 0..(n + self.v) { l.push(x) }
        l
    }
}
fn dflt[T: Kw](t: T) -> Int { t.mk(1).len() }
fn written[T: Kw](t: T) -> Int { t.mk(1, n: 4).len() }
fn main() {
    io.println("{dflt(Bx { v: 0 })}")
    io.println("{written(Bx { v: 0 })}")
}
"#, "1\n4\n")
}

test "a closed Str default is filled through a bound" {
    expect_runs("str_default", #"type Bx { v: Int }
trait Kw { fn tag[U](self, x: U, -- sep: Str = "-") -> (U, Str) }
impl Kw for Bx { fn tag[U](self, x: U, -- sep: Str) -> (U, Str) { (x, "{self.v}{sep}") } }
fn viabound[T: Kw](t: T) -> Str { t.tag([1, 2]).1 }
fn main() { io.println(viabound(Bx { v: 7 })) }
"#, "7-\n")
}

test "a closed default is filled through a bound on a generic impl" {
    expect_runs("generic_impl", #"type W[T] { v: T }
trait Kw { fn mk[U](self, x: U, -- n: Int = 2) -> List[U] }
impl[T] Kw for W[T] {
    fn mk[U](self, x: U, -- n: Int) -> List[U] {
        let mut l: List[U] = []
        for _ in 0..n { l.push(x) }
        l
    }
}
fn viabound[T: Kw](t: T) -> Int { t.mk(1.5).len() }
fn main() {
    io.println("{viabound(W { v: 1 })}")
    io.println("{viabound(W { v: "s" })}")
}
"#, "2\n2\n")
}
