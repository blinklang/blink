// A limit that the host cannot enforce is Err ENOTSUP from run and spawn, no child starts,
// and process.can_limit gives the same answer, because both use one check
// (sections/04_effects.md §4.4.8 Bad values and unsupported limits; Ask which limits the
// host supports). Each case asks can_limit first, so the file holds on a host where a
// limit is supported too.

import std.process.{ProcessError, ProcessOp, ChildLimits, LimitKind}
import std.libc.{ERR_NOTSUP}

fn fresh_dir() -> Str {
    process.run("mktemp", ["-d"]).unwrap().out.trim()
}

fn exists(path: Str) -> Bool {
    process.run("test", ["-e", path]).unwrap().success()
}

fn code_of(e: ProcessError) -> Int {
    match e.code {
        Errno(c) => c
    }
}

fn op_name(e: ProcessError) -> Str {
    match e.op {
        ProcessOp.Run => "run"
        ProcessOp.Spawn => "spawn"
        _ => "other"
    }
}

fn kind_name(which: LimitKind) -> Str {
    match which {
        LimitKind.Timeout => "timeout"
        LimitKind.Memory => "memory"
        LimitKind.Processes => "processes"
    }
}

fn limits_of(which: LimitKind) -> ChildLimits {
    match which {
        LimitKind.Memory => ChildLimits { memory: Some(1024 * 1024 * 1024) }
        LimitKind.Processes => ChildLimits { processes: Some(200) }
        LimitKind.Timeout => panic("not asked here")
    }
}

fn check_kind(which: LimitKind) ! Process.Spawn {
    if process.can_limit(which) {
        return
    }
    let dir = fresh_dir()
    let marker = "{dir}/m"
    match process.run("sh", ["-c", "touch \"$0\"", marker], limits: limits_of(which)) {
        Ok(r) => assert(false, "{kind_name(which)}: expected Err, got Ok with end {r.end}")
        Err(e) => {
            assert_eq(code_of(e), ERR_NOTSUP)
            assert_eq(op_name(e), "run")
        }
    }
    match process.spawn("sh", ["-c", "touch \"$0\"", marker], limits: limits_of(which)) {
        Ok(child) => {
            let _ = process.wait(child)
            assert(false, "{kind_name(which)}: expected Err, got Ok")
        }
        Err(e) => {
            assert_eq(code_of(e), ERR_NOTSUP)
            assert_eq(op_name(e), "spawn")
        }
    }
    assert(!exists(marker), "{kind_name(which)}: a child started")
}

test "memory gives ENOTSUP exactly when can_limit says the host cannot enforce it" {
    check_kind(LimitKind.Memory)
}

test "processes gives ENOTSUP exactly when can_limit says the host cannot enforce it" {
    check_kind(LimitKind.Processes)
}

test "an unsupported limit displays as the spec example" {
    if process.can_limit(LimitKind.Memory) {
        return
    }
    match process.run("./t", [], limits: ChildLimits { memory: Some(1024 * 1024 * 1024) }) {
        Ok(_) => assert(false, "expected Err")
        Err(e) => assert_eq("{e}", "run ./t: Operation not supported")
    }
}

test "can_limit gives the same answer every time it is asked" {
    let m = process.can_limit(LimitKind.Memory)
    let p = process.can_limit(LimitKind.Processes)
    for _ in 0..3 {
        assert_eq(process.can_limit(LimitKind.Memory), m)
        assert_eq(process.can_limit(LimitKind.Processes), p)
    }
}
