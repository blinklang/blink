// When a program ends by a normal exit, a panic, or a SIGINT or SIGTERM, the runtime first ends
// the process group of each limited child that is still alive, and then the program ends with
// its own end (sections/04_effects.md §4.4.8 A limited child does not outlive this program).
// Each case builds a helper program that spawns a limited child, waits until the child has
// written its pid (and the pid of a grandchild) to a file, and then ends. The grandchild is in
// the child's group, so only the runtime's group signal ends it: the parent-death signal of
// Linux reaches the direct child alone. Each child would run for 30 s, far past each bound.
//
// The helper is built standalone (blinkc to C that includes runtime.h), as the program-exit
// path is the runtime's and not this test binary's.

import compile_test_helpers
import std.process.{ChildEnd, ChildLimits, LimitKind, SIGINT, SIGTERM}
import std.time.{Duration}

// args: mode, pid file, grace in ms, child kind. Kind "tree" starts a grandchild, "trap" writes
// "term" next to the pid file on SIGTERM and exits, "deaf" ignores SIGTERM.
fn helper_program() -> Str {
    [
        #"import std.process.{ChildLimits}"#,
        #"import std.time.{Duration}"#,
        #""#,
        #"fn script(kind: Str) -> Str {"#,
        #"    match kind {"#,
        #"        "tree" => "sleep 30 & echo $$ $! > \"$0.tmp\"; mv \"$0.tmp\" \"$0\"; wait""#,
        #"        "trap" => "trap 'echo term > \"$0.term\"; exit 0' TERM; echo $$ > \"$0.tmp\"; mv \"$0.tmp\" \"$0\"; while :; do sleep 0.05; done""#,
        #"        _ => "trap '' TERM; echo $$ > \"$0.tmp\"; mv \"$0.tmp\" \"$0\"; while :; do sleep 0.05; done""#,
        #"    }"#,
        #"}"#,
        #""#,
        #"fn main() {"#,
        #"    let a = env.args()"#,
        #"    let mode = a.get(1).unwrap()"#,
        #"    let file = a.get(2).unwrap()"#,
        #"    let grace = a.get(3).unwrap().parse_int().unwrap()"#,
        #"    let lim = ChildLimits { timeout: Some(Duration.seconds(60)), grace: Duration.ms(grace) }"#,
        #"    let _child = process.spawn("sh", ["-c", script(a.get(4).unwrap()), file], limits: lim).unwrap()"#,
        #"    while !process.run("test", ["-e", file]).unwrap().success() {"#,
        #"        time.sleep(Duration.ms(20))"#,
        #"    }"#,
        #"    match mode {"#,
        #"        "exit" => env.exit(3)"#,
        #"        "panic" => panic("helper panics")"#,
        #"        "term" => {"#,
        #"            let _ = process.run("kill", ["-TERM", "{getpid()}"])"#,
        #"            time.sleep(Duration.seconds(30))"#,
        #"        }"#,
        #"        "int" => {"#,
        #"            let _ = process.run("kill", ["-INT", "{getpid()}"])"#,
        #"            time.sleep(Duration.seconds(30))"#,
        #"        }"#,
        #"        "kill" => {"#,
        #"            let _ = process.run("kill", ["-KILL", "{getpid()}"])"#,
        #"            time.sleep(Duration.seconds(30))"#,
        #"        }"#,
        #"        _ => {}"#,
        #"    }"#,
        #"}"#,
        #""#,
    ].join("\n")
}

fn work_dir() -> Str {
    "{compile_test_helpers.scratch_root()}/_limited_exit"
}

// Built once per test binary; each later case finds it.
fn helper_bin() -> Str {
    let dir = work_dir()
    let bin = "{dir}/limited_exit_helper"
    if process.run("test", ["-x", bin]).unwrap().success() {
        return bin
    }
    shell_exec("mkdir -p {dir}")
    let src = "{dir}/limited_exit_helper.bl"
    let c_path = "{dir}/limited_exit_helper.c"
    write_file(src, helper_program())
    let emit = process.run("build/blinkc", [src, c_path]).unwrap()
    assert_eq(emit.end, ChildEnd.Exited(0), "blinkc failed:\n{emit.out}{emit.err_out}")
    let cc = process.run("cc", ["-O1", "-w", "-Ibootstrap", "-o", bin, c_path, "-lm", "-lgc", "-pthread"]).unwrap()
    assert_eq(cc.end, ChildEnd.Exited(0), "cc failed:\n{cc.out}{cc.err_out}")
    bin
}

type Run {
    end: ChildEnd
    ms: Int
    pids: List[Str]
    file: Str
}

fn run_helper(mode: Str, grace_ms: Int, kind: Str) -> Run {
    let bin = helper_bin()
    let file = "{work_dir()}/{mode}_{kind}_{grace_ms}.pid"
    shell_exec("rm -f {file} {file}.term")
    let start = time.read()
    // A program exit that blocked would hang the test; the timeout turns that into a failure.
    let r = process.run(bin, [mode, file, "{grace_ms}", kind], limits: ChildLimits { timeout: Some(Duration.seconds(60)) }).unwrap()
    let ms = start.elapsed().to_ms()
    assert(r.end != ChildEnd.Limit(LimitKind.Timeout), "the helper did not end within 60 s")
    let text = process.run("cat", [file]).unwrap().out.trim()
    Run { end: r.end, ms: ms, pids: text.split(" "), file: file }
}

// A process that the group signal ended may stay a zombie until its new parent reaps it, so
// a "Z" state counts as ended.
fn ended_within(pid: Str, ms: Int) -> Bool {
    let start = time.read()
    while start.elapsed().to_ms() < ms {
        let st = process.run("ps", ["-o", "stat=", "-p", pid]).unwrap().out.trim()
        if st == "" || st.starts_with("Z") {
            return true
        }
        time.sleep(Duration.ms(50))
    }
    false
}

fn assert_all_ended(r: Run) {
    for pid in r.pids {
        let gone = ended_within(pid, 5000)
        if !gone {
            let _ = process.run("kill", ["-9", pid])
        }
        assert(gone, "process {pid} outlived the program (pids {r.pids.join(" ")})")
    }
}

test "a return from main ends the group of a limited child first" {
    let r = run_helper("return", 300, "tree")
    assert_eq(r.end, ChildEnd.Exited(0))
    assert_eq(r.pids.len(), 2, "pid file: {r.pids.join(" ")}")
    assert_all_ended(r)
}

test "env.exit ends the group of a limited child and keeps its exit code" {
    let r = run_helper("exit", 300, "tree")
    assert_eq(r.end, ChildEnd.Exited(3))
    assert_all_ended(r)
}

test "a panic ends the group of a limited child" {
    let r = run_helper("panic", 300, "tree")
    assert_eq(r.end, ChildEnd.Exited(1))
    assert_all_ended(r)
}

test "a SIGTERM ends the group of a limited child and then this program by SIGTERM" {
    let r = run_helper("term", 300, "tree")
    assert_eq(r.end, ChildEnd.Signaled(SIGTERM))
    assert_all_ended(r)
}

test "a SIGINT ends the group of a limited child and then this program by SIGINT" {
    let r = run_helper("int", 300, "tree")
    assert_eq(r.end, ChildEnd.Signaled(SIGINT))
    assert_all_ended(r)
}

test "at program exit a limited child gets SIGTERM and its grace" {
    let r = run_helper("return", 20000, "trap")
    assert_eq(r.end, ChildEnd.Exited(0))
    assert_eq(process.run("cat", ["{r.file}.term"]).unwrap().out, "term\n", "the child got no SIGTERM")
    assert(r.ms < 15000, "the exit waited out the grace: {r.ms} ms")
    assert_all_ended(r)
}

test "at program exit a grace of zero sends SIGKILL and no SIGTERM" {
    let r = run_helper("return", 0, "trap")
    assert_eq(r.end, ChildEnd.Exited(0))
    assert(!process.run("test", ["-e", "{r.file}.term"]).unwrap().success(), "the child got SIGTERM")
    assert_all_ended(r)
}

// The lower bound holds on any host: the runtime cannot send SIGKILL before the grace ends.
test "at program exit a child that ignores SIGTERM gets SIGKILL after its grace" {
    let r = run_helper("return", 500, "deaf")
    assert_eq(r.end, ChildEnd.Exited(0))
    assert(r.ms >= 500, "the exit did not wait for the grace: {r.ms} ms")
    assert(r.ms < 15000, "the exit took {r.ms} ms")
    assert_all_ended(r)
}

// Nothing runs in this program after a SIGKILL. On Linux the parent-death signal still ends
// the direct child; macOS has no such signal (the spec names the gap).
test "on Linux a SIGKILL of this program still ends the direct limited child" {
    if process.run("uname", []).unwrap().out.trim() != "Linux" {
        return
    }
    let r = run_helper("kill", 300, "deaf")
    assert_eq(r.end, ChildEnd.Signaled(9))
    assert_all_ended(r)
}
