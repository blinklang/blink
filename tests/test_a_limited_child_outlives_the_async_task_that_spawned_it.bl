// On Linux the parent-death signal of a child fires when the thread that forked it ends, not
// when the program does. The runtime forks each limited child on its one long-lived limits
// thread, so a child that a finished async task spawned runs on until its own end or its
// deadline (sections/04_effects.md §4.4.8 A deadline holds whether or not anyone waits).

import std.process.{Child, ChildEnd, ChildLimits}
import std.time.{Duration}

test "a limited child spawned by an async task that has ended runs to its own end" {
    let lim = ChildLimits { timeout: Some(Duration.seconds(60)) }
    let mut child: Child? = None
    async.scope {
        let t = async.spawn(fn() -> Child {
            process.spawn("sh", ["-c", "sleep 1; echo alive"], limits: lim).unwrap()
        })
        child = Some(t.await)
    }
    let r = process.wait(child.unwrap()).unwrap()
    assert_eq(r.end, ChildEnd.Exited(0))
    assert_eq(r.out, "alive\n")
}
