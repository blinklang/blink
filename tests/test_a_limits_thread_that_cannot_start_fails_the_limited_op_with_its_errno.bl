// The first child with a limit starts the runtime's limits thread. When the thread cannot
// start, run and spawn of a limited child give Err with that errno and start no child, and a
// later call tries again; a child with no limit does not need the thread.
//
// cc -DBLINK_DEV_LIMITS_THREAD_FAIL fails every start of the thread with EAGAIN, as a full
// thread table would. The knob is a cc define that no binary blink builds carries, so the
// program is built standalone (blinkc to C that includes runtime.h) and the test runs cc on it.

import compile_test_helpers
import std.process.{ChildEnd}

fn thread_fail_program() -> Str {
    [
        #"import std.process.{ChildLimits}"#,
        #"import std.time.{Duration}"#,
        #""#,
        #"fn main() {"#,
        #"    let lim = ChildLimits { timeout: Some(Duration.seconds(60)) }"#,
        #"    for i in 0..2 {"#,
        #"        match process.run("echo", ["ran"], limits: lim) {"#,
        #"            Ok(r) => io.println("run ok: {r.out.trim()}")"#,
        #"            Err(e) => io.println("{e}")"#,
        #"        }"#,
        #"    }"#,
        #"    match process.spawn("echo", ["ran"], limits: lim) {"#,
        #"        Ok(_) => io.println("spawn ok")"#,
        #"        Err(e) => io.println("{e}")"#,
        #"    }"#,
        #"    io.println("unlimited: {process.run("echo", ["ran"]).unwrap().out.trim()}")"#,
        #"}"#,
        #""#,
    ].join("\n")
}

test "a limits thread that cannot start fails run and spawn with its errno" {
    let dir = "{compile_test_helpers.scratch_root()}/_limits_thread_fail"
    shell_exec("rm -rf {dir}")
    shell_exec("mkdir -p {dir}")
    let src = "{dir}/limits_thread_fail.bl"
    let c_path = "{dir}/limits_thread_fail.c"
    let bin = "{dir}/limits_thread_fail"
    write_file(src, thread_fail_program())

    let emit = process.run("build/blinkc", [src, c_path])?
    assert_eq(emit.end, ChildEnd.Exited(0), "blinkc failed:\n{emit.out}{emit.err_out}")
    let cc = process.run("cc", ["-O1", "-w", "-DBLINK_DEV_LIMITS_THREAD_FAIL", "-Ibootstrap", "-o", bin, c_path, "-lm", "-lgc", "-pthread"])?
    assert_eq(cc.end, ChildEnd.Exited(0), "cc failed:\n{cc.out}{cc.err_out}")

    let run = process.run(bin, [])?
    assert_eq(run.end, ChildEnd.Exited(0), "the program failed:\n{run.out}{run.err_out}")
    let eagain = "Resource temporarily unavailable"
    assert_eq(run.out, "run echo: {eagain}\nrun echo: {eagain}\nspawn echo: {eagain}\nunlimited: ran\n")
    shell_exec("rm -rf {dir}")
}
