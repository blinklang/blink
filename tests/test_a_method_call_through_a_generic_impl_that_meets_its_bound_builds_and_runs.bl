// A method call through a generic impl holds that impl's bounds at the receiver's type
// arguments (§3.6 Trait Bounds). A bound written on the binder, one in an impl's where clause,
// one given through a supertrait, and a concrete type that has the trait each meet it, on a
// builtin receiver and on a struct, for a receiver the body's parameters type, for one a use
// after the call fills, and for the trait-qualified call. Each form builds and runs.

trait Same {
    fn same(self) -> Bool
}

impl[T: Eq] Same for List[T] {
    fn same(self) -> Bool { self.len() < 2 || self.get(0).unwrap() == self.get(1).unwrap() }
}

type Hd[T] { v: List[T] }

impl[T: Eq] Same for Hd[T] {
    fn same(self) -> Bool { self.v.same() }
}

trait Conv[A] {
    fn conv(self) -> Int
}

trait Wide[K]: Conv[K] {
    fn wide(self) -> Int
}

impl Conv[Int] for Int {
    fn conv(self) -> Int { self * 10 }
}

impl Wide[Int] for Int {
    fn wide(self) -> Int { self }
}

type Px[K, V] { k: K, v: V }

type Pl[K, V] { ps: List[Px[K, V]] }

trait Total {
    fn total(self) -> Int
}

impl[K, V: Conv[K]] Total for Pl[K, V] {
    fn total(self) -> Int {
        let mut sum = 0
        for p in self.ps { sum = sum + p.v.conv() }
        sum
    }
}

fn direct_inline[T: Eq](x: List[T], h: Hd[T]) -> Bool {
    x.same() && Same.same(x) && h.same()
}

// The call comes before the push in the text, so inference fills the element type after the
// call, but at run time the call sees the two values the earlier turns pushed.
fn late_inline[T: Eq](x: T, y: T) -> Bool {
    let mut l = []
    let mut m = []
    let mut b = Hd { v: [] }
    let mut r = false
    let mut s = false
    let mut t = false
    for i in 0..3 {
        if i == 2 {
            r = l.same()
            s = Same.same(m)
            t = b.same()
        }
        l.push(if i == 0 { x } else { y })
        m.push(if i == 0 { x } else { y })
        b.v.push(if i == 0 { x } else { y })
    }
    r && s && t
}

fn late_super[T: Ord](x: T, y: T) -> Bool {
    let mut l = []
    let r = l.same()
    l.push(x)
    r && [x, y].same() && Same.same([x, y])
}

fn args_inline[K2, A: Conv[K2]](k: K2, a: A) -> Int {
    let l = Pl { ps: [Px { k: k, v: a }] }
    l.total() + Total.total(l)
}

fn args_super[K2, A: Wide[K2]](p: Pl[K2, A]) -> Int {
    p.total() + Total.total(p)
}

fn concrete() -> Bool {
    let mut l = []
    let r = l.same()
    l.push(1)
    let mut b = Hd { v: [] }
    let s = b.same()
    b.v.push("a")
    r && s && !["a", "b"].same()
}

type Bx[T] { v: T }

trait Ck {
    fn chk(self) -> Bool
}

impl[T] Ck for Bx[T] where T: Eq {
    fn chk(self) -> Bool {
        let mut l = []
        let r = l.same()
        l.push(self.v)
        r && [self.v, self.v].same() && Same.same([self.v]) && Hd { v: [self.v] }.same()
    }
}

test "a bound written on the binder meets the bound at a method call" {
    assert(direct_inline([1, 1], Hd { v: [2, 2] }))
    assert(!direct_inline([1, 2], Hd { v: [2, 2] }))
    assert(!direct_inline(["a"], Hd { v: ["b", "c"] }))
}

test "a method call whose receiver inference fills later judges the values it sees" {
    assert(late_inline(1, 1))
    assert(!late_inline(1, 2))
    assert(late_inline("a", "a"))
    assert(!late_inline("a", "b"))
}

test "a bound given through a supertrait meets the bound at a method call" {
    assert(late_super(4, 4))
    assert(!late_super(4, 5))
    assert_eq(args_super(Pl { ps: [Px { k: 1, v: 3 }] }), 60)
}

test "a bound on a trait argument written on the binder meets the bound at a method call" {
    assert_eq(args_inline(1, 3), 60)
}

test "a bound in an impl's where clause meets the bound at a method call" {
    assert(Bx { v: 7 }.chk())
}

test "a concrete type that has the trait meets the bound at a method call" {
    assert(concrete())
}
