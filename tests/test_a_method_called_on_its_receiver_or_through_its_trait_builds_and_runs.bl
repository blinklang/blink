// A method with `self` is called on its receiver (`x.m()`) or through its trait (`Tr.m(x)`), as a
// call through the type name is E0567 (sections/03_types.md §3.4). Each form builds and runs: on
// a built-in, a user and a derived method, and on a type parameter bound inline, in a where
// clause or through a supertrait.

trait Named {
    fn name(self) -> Str
}

trait Greeter: Named {
    fn greet(self) -> Str
}

type Dog {
    n: Str
}

impl Named for Dog {
    fn name(self) -> Str { self.n }
}

impl Greeter for Dog {
    fn greet(self) -> Str { "hi {self.name()}" }
}

@derive(Clone, Eq)
type P {
    v: Int
}

trait Dupe {
    fn dupe(self) -> Self
}

type Bx[T] {
    v: T
}

impl[T] Dupe for Bx[T] where T: Clone {
    fn dupe(self) -> Bx[T] { Bx { v: Clone.clone(self.v) } }
}

fn copy_inline[T: Clone](x: T) -> T { Clone.clone(x) }

fn copy_inline_recv[T: Clone](x: T) -> T { x.clone() }

fn name_through_supertrait[T: Greeter](x: T) -> Str { Named.name(x) }

fn name_through_supertrait_recv[T: Greeter](x: T) -> Str { x.name() }

test "a built-in method runs through its trait and on its receiver" {
    assert_eq(Sized.len("abc"), 3)
    assert_eq("abc".len(), 3)
    assert_eq((-3).abs(), 3)
    let a = 1
    let b = 2
    assert_eq((a + b).max(5), 5)
}

test "a user method runs through its trait and on its receiver" {
    let d = Dog { n: "rex" }
    assert_eq(Named.name(d), "rex")
    assert_eq(d.name(), "rex")
    assert_eq(Greeter.greet(d), "hi rex")
}

test "a derived method runs through its trait and on its receiver" {
    let p = P { v: 7 }
    assert_eq(Clone.clone(p).v, 7)
    assert(p.clone() == p)
}

test "a method of a type parameter bound inline runs through its trait and on its receiver" {
    assert_eq(copy_inline(4), 4)
    assert_eq(copy_inline_recv("s"), "s")
}

test "a method a where clause gives a type parameter runs through its trait" {
    let b = Bx { v: 9 }
    assert_eq(b.dupe().v, 9)
}

test "a method a supertrait gives a type parameter runs through its trait and on its receiver" {
    let d = Dog { n: "fido" }
    assert_eq(name_through_supertrait(d), "fido")
    assert_eq(name_through_supertrait_recv(d), "fido")
}
