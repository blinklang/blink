// A receiver of a type parameter has only the methods of its bounds. A method call on a
// parameter with no bound is E0505 in the generic body, whether or not code calls the
// function (section 6.3.3), so `blink check` stops it before the build does.

import compile_test_helpers.{compile_and_capture, expect_compiles_clean}

fn count(output: Str, code: Str) -> Int {
    output.split("\"code\":\"{code}\"").len() - 1
}

test "a method on an unbounded parameter is E0505 in a function that no code calls" {
    let src = "fn first_len[T](x: T) -> Int \{\n    x.len()\n\}\nfn main() \{\n    io.println(\"hi\")\n\}\n"
    let out = compile_and_capture(src, "_unbounded_uncalled")
    assert_eq(count(out, "E0505"), 1, out)
    assert(out.contains("type parameter `T` has no bound, so it has no method `len`"), out)
    assert(out.contains("add a bound whose trait declares `len`"), out)
}

test "the help names the bound when one trait declares the method" {
    let src = "trait Sh \{\n    fn sh(self) -> Int\n\}\nfn g[T](x: T) -> Int \{\n    x.sh()\n\}\nfn main() \{\n    io.println(\"hi\")\n\}\n"
    let out = compile_and_capture(src, "_unbounded_one_owner")
    assert_eq(count(out, "E0505"), 1, out)
    assert(out.contains("add a bound whose trait declares `sh`, such as `[T: Sh]`"), out)
}

test "each call on an unbounded parameter is reported, whatever its name" {
    let src = "fn f[T](x: T) -> Str \{\n    x.to_str()\n\}\nfn g[T](x: T) -> Str \{\n    x.display()\n\}\nfn main() \{\n    io.println(\"\{f(1)\}\{g(2)\}\")\n\}\n"
    let out = compile_and_capture(src, "_unbounded_names")
    assert_eq(count(out, "E0505"), 2, out)
}

test "the bound that declares the method makes the call valid" {
    let src = "fn first_len[T: Sized](x: T) -> Int \{\n    x.len()\n\}\nfn main() \{\n    io.println(\"\{first_len([1, 2])\}\")\n\}\n"
    let out = compile_and_capture(src, "_unbounded_fixed")
    expect_compiles_clean(out, "a bounded parameter")
}

// A trait with no impl still declares its methods, so the message does not say that nothing
// declares the name.
test "a method that only a trait with no impl declares names that trait" {
    let src = "trait Shape \{\n    type Item\n    fn first(self) -> Self.Item\n    fn area(self) -> Int\n\}\nfn f[S: Shape](s: S) -> Int \{\n    let it = s.first()\n    it.area()\n\}\nfn main() \{\n    io.println(\"hi\")\n\}\n"
    let out = compile_and_capture(src, "_unbounded_trait_no_impl")
    assert_eq(count(out, "E0505"), 1, out)
    assert(!out.contains("no type or trait declares method `area`"), out)
    assert(out.contains("the receiver has no method `area`: trait `Shape` declares it, but its type does not get it from an impl or a bound"), out)
    assert(out.contains("give the receiver a type that implements `Shape`"), out)
}
