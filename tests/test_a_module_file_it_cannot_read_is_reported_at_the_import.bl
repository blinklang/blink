// A module file that an import names and that is there but cannot be read is not an empty
// module. The import gets an error that names the path and the OS error. In the LSP that
// error reaches the client and the server goes on.

import std.process.{ProcessResult}

let ENTRY = "src/main.bl"

fn sh(cmd: Str) -> ProcessResult ! Process.Spawn {
    process.run("sh", ["-c", cmd]).unwrap()
}

fn as_root() -> Bool ! Process.Spawn {
    sh("id -u").out.trim() == "0"
}

// src/main.bl imports helper, and no one may read src/helper.bl.
fn setup(name: Str) -> Str ! FS.Write, Process.Spawn {
    let dir = sh("mktemp -d /tmp/blink_unreadable_module_{name}.XXXXXX").out.trim()
    let _ = sh("mkdir -p {dir}/src")
    fs.write("{dir}/blink.toml", "[package]\nname = \"unreadable_module\"\nversion = \"0.1.0\"\n").unwrap()
    // A lock no older than blink.toml keeps "resolving dependencies..." out of the output.
    fs.write("{dir}/blink.lock", "[metadata]\nlockfile-version = 1\n").unwrap()
    fs.write("{dir}/src/main.bl", "import helper\n\nfn main() \{\n    io.println(helper.greet())\n}\n").unwrap()
    fs.write("{dir}/src/helper.bl", "pub fn greet() -> Str \{ \"hi\" }\n").unwrap()
    let _ = sh("chmod 000 {dir}/src/helper.bl")
    dir
}

fn teardown(dir: Str) ! Process.Spawn {
    let _ = sh("chmod 644 {dir}/src/helper.bl; rm -rf {dir}")
}

fn check(dir: Str, flags: Str) -> ProcessResult ! Process.Spawn {
    sh("B=$(pwd)/build/blink; cd {dir} && $B check {flags} {ENTRY}")
}

fn lsp_msg(body: Str) -> Str {
    "Content-Length: {body.byte_len()}\r\n\r\n{body}"
}

// The LSP output of: open ENTRY, wait for its diagnostics, shut down.
fn via_lsp(dir: Str) -> Str ! FS.Write, FS.Read, Process.Spawn {
    let uri = "file://{ENTRY}"
    let init = lsp_msg("\{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\",\"params\":\{\"capabilities\":\{\}\}\}")
    let open = lsp_msg("\{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/didOpen\",\"params\":\{\"textDocument\":\{\"uri\":\"{uri}\",\"languageId\":\"blink\",\"version\":1,\"text\":\"\"\}\}\}")
    let shutdown = lsp_msg("\{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"shutdown\",\"params\":null\}")
    let exit_msg = lsp_msg("\{\"jsonrpc\":\"2.0\",\"method\":\"exit\",\"params\":\{\}\}")
    fs.write("{dir}/open.bin", init.concat(open)).unwrap()
    fs.write("{dir}/end.bin", shutdown.concat(exit_msg)).unwrap()
    let _ = sh("B=$(pwd)/build/blink; cd {dir} && ( cat open.bin; for i in $(seq 1 400); do grep -q published lsp.err 2>/dev/null && break; sleep 0.05; done; cat end.bin ) | timeout 60 $B lsp > lsp.out 2> lsp.err")
    fs.read("{dir}/lsp.out").unwrap()
}

test "blink check reports a module file it cannot read at the import" {
    if as_root() { return }
    let dir = setup("check")
    let r = check(dir, "")
    teardown(dir)
    let text = "{r.out}{r.err_out}"
    assert(!r.success(), "check answered success:\n{text}")
    assert(text.contains("error[ModuleNotFound]: read src/helper.bl: Permission denied"), "the error does not name the path and the cause:\n{text}")
    assert(text.contains("--> src/main.bl:1:"), "the error is not on the import line:\n{text}")
    assert(!text.contains("internal compiler error"), "a read error is not a compiler bug:\n{text}")
}

test "blink check --json gives a module file it cannot read the code E1200" {
    if as_root() { return }
    let dir = setup("json")
    let r = check(dir, "--json")
    teardown(dir)
    assert(!r.success())
    assert(r.err_out.contains("\"code\":\"E1200\""), r.err_out)
    assert(r.err_out.contains("read src/helper.bl: Permission denied"), r.err_out)
}

test "the lsp sends a module file it cannot read to the client and goes on" {
    if as_root() { return }
    let dir = setup("lsp")
    let out = via_lsp(dir)
    teardown(dir)
    assert(out.contains("textDocument/publishDiagnostics"), out)
    assert(out.contains("\"code\":\"E1200\""), out)
    assert(out.contains("read src/helper.bl: Permission denied"), out)
    // The answer to shutdown: the server did not exit on the read error.
    assert(out.contains("\"id\":2"), out)
}
