// `Never` is a subtype of every type, and inference never chooses `Never` for a slot that the
// program left open (sections/03_types.md §3.2). So a diverging value (`todo()`, `panic(..)`)
// fixes no type parameter: the other values, or the expected type, fix it, whatever the order.
// Each diverging value sits on a path that does not run.

type Pair[T] {
    a: T
    b: T
}

type Box[T] {
    v: T
}

type BoxAlias[X] = Box[X]

type Either[T] {
    Some1(T)
    Nothing
}

type EitherAlias[X] = Either[X]

type Shape[T] {
    Pt { x: T, y: T }
    Blank
}

fn pick[T](_a: T, b: T) -> T { b }

fn add_to[T](xs: List[T], x: T) { xs.push(x) }

fn count[T](_a: T) -> Int { 1 }

// Inside a generic body the argument has the body's own type, E or U, so the call binds T to
// it; an instance at Never then calls count at Never.
fn errs[E](r: Result[Int, E]) -> Int {
    match r {
        Ok(v) => v
        Err(e) => count(e)
    }
}

fn outer[U](u: U) -> Int { count(u) }

fn arg_never_first(go: Bool) -> Int {
    if go { return 1 }
    pick(todo(), 2)
}

fn arg_never_second(go: Bool) -> Int {
    if go { return 3 }
    pick(4, todo())
}

fn field_never_first(go: Bool) -> Int {
    if go { return 5 }
    let p = Pair { a: todo(), b: 6 }
    p.b
}

fn field_never_second(go: Bool) -> Int {
    if go { return 7 }
    let p = Pair { a: 8, b: todo() }
    p.a
}

fn field_under_annotation(go: Bool) -> Int {
    if go { return 9 }
    let b: Box[Int] = Box { v: panic("not reached") }
    b.v
}

fn field_under_alias_head(go: Bool) -> Int {
    if go { return 10 }
    let b: BoxAlias[Int] = BoxAlias { v: panic("not reached") }
    b.v
}

fn variant_under_return_type(go: Bool) -> Either[Int] {
    if go { return Either.Some1(11) }
    Either.Some1(panic("not reached"))
}

fn variant_under_annotation(go: Bool) -> Int {
    if go { return 12 }
    let e: Either[Int] = Either.Some1(panic("not reached"))
    match e {
        Either.Some1(v) => v
        Either.Nothing => 0
    }
}

fn variant_under_alias_head(go: Bool) -> Int {
    if go { return 13 }
    let e: EitherAlias[Int] = EitherAlias.Some1(panic("not reached"))
    match e {
        Either.Some1(v) => v
        Either.Nothing => 0
    }
}

fn struct_variant_field_never_first(go: Bool) -> Int {
    if go { return 19 }
    let s = Shape.Pt { x: todo(), y: 20 }
    match s {
        Shape.Pt { x: _, y } => y
        Shape.Blank => 0
    }
}

fn variant_pushed_into_a_typed_list(go: Bool) -> Int {
    let mut xs: List[Either[Int]] = []
    if !go { xs.push(Either.Some1(panic("not reached"))) }
    xs.push(Either.Some1(14))
    xs.len()
}

fn literal_pushed_into_a_typed_list(go: Bool) -> Int {
    let mut xs: List[Box[Int]] = []
    if !go { xs.push(Box { v: panic("not reached") }) }
    xs.push(Box { v: 15 })
    xs.get(0).unwrap().v
}

fn list_param_then_never(go: Bool) -> Int {
    let mut xs: List[Int] = []
    if !go { add_to(xs, panic("not reached")) }
    add_to(xs, 16)
    xs.get(0).unwrap()
}

fn outer_at_never(go: Bool) -> Int {
    if go { return 18 }
    outer[Never](todo())
}

test "a generic body at a Never instance passes its own typed value on" {
    let r: Result[Int, Never] = Ok(17)
    assert_eq(errs(r), 17)
    assert_eq(outer_at_never(true), 18)
}

test "a diverging argument leaves the type parameter to the other argument, in either order" {
    assert_eq(arg_never_first(true), 1)
    assert_eq(arg_never_second(true), 3)
}

test "a diverging field leaves the type parameter to the other field, in either order" {
    assert_eq(field_never_first(true), 5)
    assert_eq(field_never_second(true), 7)
}

test "a diverging field leaves the type parameter to the expected type" {
    assert_eq(field_under_annotation(true), 9)
    assert_eq(field_under_alias_head(true), 10)
}

test "a diverging payload leaves the type parameter to the expected type" {
    let e = variant_under_return_type(true)
    assert_eq(match e {
        Either.Some1(v) => v
        Either.Nothing => 0
    }, 11)
    assert_eq(variant_under_annotation(true), 12)
    assert_eq(variant_under_alias_head(true), 13)
}

test "a diverging field of a struct-style variant leaves the type parameter to the other field" {
    assert_eq(struct_variant_field_never_first(true), 19)
}

test "a diverging value fits a parameter that a typed argument fixed" {
    assert_eq(variant_pushed_into_a_typed_list(true), 1)
    assert_eq(literal_pushed_into_a_typed_list(true), 15)
    assert_eq(list_param_then_never(true), 16)
}
