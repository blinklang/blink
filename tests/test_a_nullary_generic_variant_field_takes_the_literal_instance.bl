// A struct literal of a generic struct is one instance: a field written beside a nullary
// variant fixes the type parameter, so the variant is the enum at that instance.

type Link[T] {
    Nil
    Hold(v: T)
}

type Cell[T] {
    v: T
    l: Link[T]
}

fn held[T](l: Link[T]) -> Bool {
    match l {
        Link.Nil => false
        Link.Hold(_) => true
    }
}

test "a nullary generic variant as a struct field takes the instance a sibling field fixes" {
    let s = Cell { v: "p", l: Link.Nil }
    assert_eq(s.v, "p")
    assert(!held(s.l))
    let n = Cell { l: Link.Nil, v: 3 }
    assert_eq(n.v, 3)
    assert(!held(n.l))
}

test "a payload generic variant as a struct field agrees with a sibling field" {
    let s = Cell { v: 1, l: Link.Hold(v: 2) }
    assert_eq(s.v, 1)
    assert(held(s.l))
}
