// A panic inside the hook writes the default report and exits with code 101, and the
// runtime does not call the hook a second time (sections/02_syntax.md §2.20 *A panic in the
// hook*).

import compile_test_helpers.{compile_and_run}

test "a panic in the hook gives the default report and exit 101" {
    let tag = "ph_hook_panics_{getpid()}"
    let src = #"import std.panic.{PanicInfo}
fn report(p: PanicInfo) -> Never ! IO.Print, Env.Exit {
    io.println("hook: {p.message}")
    let xs: List[Int] = []
    if xs.len() == 0 { panic("second") }
    env.exit(70)
}

fn main() ! IO, Env {
    with on_panic(report) {
        panic("first")
    }
}
"#
    let r = compile_and_run(src, tag)
    assert(r.exit_code == 101, "exit {r.exit_code}: {r.err_out}")
    // The hook ran once: a second call would print a second line.
    assert_eq(r.out, "hook: first\n")
    assert(r.err_out.contains("second"), r.err_out)
    assert(r.err_out.contains("{tag}.bl:5"), r.err_out)
    assert(!r.err_out.contains("first"), r.err_out)
}
