// A closure parameter with no annotation has an open type until a later use fixes it (section
// 3.4, under-determined types). A Some, Ok, Err or list pattern on it names the shape of that
// type, so the binders under the pattern are typed inside the parameter's type and the call
// that comes later solves them.

type E[T] {
    L(T)
    N
}

test "a qualified variant pattern under Some reads the payload the call passes" {
    let f = fn(p) {
        match p {
            Some(E.L(a)) => a
            _ => 0
        }
    }
    assert_eq(f(Some(E.L(3))), 3)
    assert_eq(f(Some(E.N)), 0)
    assert_eq(f(None), 0)
}

test "a qualified variant pattern under a list pattern reads the element the call passes" {
    let f = fn(p) {
        match p {
            [E.L(a), E.N] => a
            _ => 0
        }
    }
    assert_eq(f([E.L(3), E.N]), 3)
    assert_eq(f([E.N]), 0)
}

test "a variant pattern under two Some patterns reads the inner payload" {
    let f = fn(p) {
        match p {
            Some(Some(E.L(a))) => a
            _ => 0
        }
    }
    assert_eq(f(Some(Some(E.L(3)))), 3)
}

test "a bare Some or None pattern takes its payload type from the call" {
    let f = fn(o) {
        match o {
            Some(x) => x
            None => 0
        }
    }
    assert_eq(f(Some(3)), 3)
    assert_eq(f(None), 0)
}

test "an Ok and an Err pattern take both types from the call" {
    let f = fn(r) {
        match r {
            Ok(x) => x
            Err(e) => e.len()
        }
    }
    let v: Result[Int, Str] = Ok(5)
    let w: Result[Int, Str] = Err("abc")
    assert_eq(f(v), 5)
    assert_eq(f(w), 3)
}

test "a list pattern and a tuple under Some take the element type from the call" {
    let g = fn(xs) {
        match xs {
            [a, _] => a
            _ => 0
        }
    }
    assert_eq(g([3, 4]), 3)
    let h = fn(o) {
        match o {
            Some((a, _)) => a
            _ => 0
        }
    }
    assert_eq(h(Some((3, "x"))), 3)
}

test "a qualified carrier pattern takes its payload type from the call" {
    let f = fn(o) {
        match o {
            Option.Some(x) => x
            _ => 0
        }
    }
    assert_eq(f(Some(4)), 4)
}

test "an Ok pattern alone and an Err pattern alone each take the slot they read from the call" {
    let ok_of = fn(r) {
        match r {
            Ok(x) => x
            _ => 0
        }
    }
    let err_of = fn(r) {
        match r {
            Err(e) => e.len()
            _ => 0
        }
    }
    let v: Result[Int, Str] = Ok(5)
    let w: Result[Bool, Str] = Err("abcd")
    assert_eq(ok_of(v), 5)
    assert_eq(err_of(w), 4)
}

test "a list pattern with a rest takes the element type from the call" {
    let f = fn(xs) {
        match xs {
            [E.L(a), ..] => a
            _ => 0
        }
    }
    assert_eq(f([E.L(7), E.N, E.L(1)]), 7)
}
