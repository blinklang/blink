// The pid table holds 4096 slots and reuses a waited one only once every slot has held a
// child, so a waited handle keeps its result until then. Past that, the slot belongs to a later
// child: the old handle must name no child at all. Its wait gives the error result, never the
// later child's output, and its kill returns -1 and leaves the later child running.

import std.process.{spawn, ChildEnd}

test "a waited handle whose slot a later spawn took neither waits on nor signals that child" {
    let first = spawn("echo", ["first"])
    let r1 = first.wait()
    assert_eq(r1.out.trim(), "first")
    // 4095 more fill the table, so the next spawn, later, reuses the first waited slot.
    let mut i = 0
    while i < 4095 {
        let r = spawn("true", []).wait()
        assert_eq(r.end, ChildEnd.Exited(0))
        i = i + 1
    }
    let later = spawn("sh", ["-c", "sleep 1; echo later"])
    assert_eq(first.kill(0), -1)
    let again = first.wait()
    assert(again.out.trim() != "later", "a stale handle waited on a later child")
    assert(again.out.trim() == "first" || again.exit_code == -1, "stale wait gave out={again.out} {again.end}")
    let rl = later.wait()
    assert_eq(rl.end, ChildEnd.Exited(0))
    assert_eq(rl.out.trim(), "later")
}
