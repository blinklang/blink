// The pid table holds 4096 slots and reuses a waited one only once every slot has held a
// child. Past that, the slot belongs to a later child: the old Child must name no live child
// at all. Its wait gives its own result again, never the later child's output, and a signal
// to it is Err and leaves the later child running.

import std.process.{SIGKILL, ChildEnd}

test "a waited child whose slot a later spawn took neither waits on nor signals that child" {
    let first = process.spawn("echo", ["first"])?
    let r1 = process.wait(first)?
    assert_eq(r1.out.trim(), "first")
    // 4095 more fill the table, so the next spawn, later, reuses the first waited slot.
    let mut i = 0
    while i < 4095 {
        let r = process.wait(process.spawn("true", [])?)?
        assert_eq(r.end, ChildEnd.Exited(0))
        i = i + 1
    }
    let later = process.spawn("sh", ["-c", "sleep 1; echo later"])?
    assert(process.signal(first, SIGKILL).is_err())
    let again = process.wait(first)?
    assert_eq(again.out.trim(), "first", "a stale wait gave out={again.out} {again.end}")
    let rl = process.wait(later)?
    assert_eq(rl.end, ChildEnd.Exited(0))
    assert_eq(rl.out.trim(), "later")
}
