// The runtime keeps waited results so a second wait can return them, but only up to an
// output bound, so a program that spawns many children with large output does not keep
// them all. The newest result is always kept, whatever its size.
import std.process.{spawn}
test "a wait whose result the output bound dropped returns an error result, the newest stays" {
    let first = spawn("sh", ["-c", "printf '%0600000d' 0"])
    assert_eq(first.wait().out.len(), 600000)
    let second = spawn("sh", ["-c", "printf '%02000000d' 0"])
    assert_eq(second.wait().out.len(), 2000000)
    let again = second.wait()
    assert_eq(again.out.len(), 2000000)
    assert_eq(again.exit_code, 0)
    let stale = first.wait()
    assert_eq(stale.exit_code, -1, "a dropped result came back with out of {stale.out.len()} bytes")
    assert_eq(stale.err_out, "invalid pid handle")
    assert_eq(first.kill(0), -1)
}
