// A polymorphic impl over a built-in generic (sections/03_types.md §3.6 *Polymorphic Trait
// Implementations*) gives every instance of that type the trait, so it meets a bound on the
// trait as an impl over a user generic does.

trait Tally {
    fn tally(self) -> Int
}

impl[T] Tally for List[T] {
    fn tally(self) -> Int { self.len() }
}

impl[K, V] Tally for Map[K, V] {
    fn tally(self) -> Int { self.len() * 10 }
}

impl[T] Tally for Set[T] {
    fn tally(self) -> Int { self.len() * 100 }
}

fn count[X: Tally](x: X) -> Int { x.tally() }

trait Mark[T] {
    fn mark(self) -> T
}

impl[T] Mark[Str] for List[T] {
    fn mark(self) -> Str { "list of {self.len()}" }
}

fn marked[X: Mark[Str]](x: X) -> Str { x.mark() }

trait Same {
    fn same(self) -> Bool
}

// A bound on the impl's own binder: a List meets Same only where its element has Eq.
impl[T: Eq] Same for List[T] {
    fn same(self) -> Bool {
        match (self.get(0), self.get(1)) {
            (Some(a), Some(b)) => a == b
            _ => false
        }
    }
}

fn all_same[X: Same](x: X) -> Bool { x.same() }

test "a poly impl over List, Map or Set meets a bound" {
    assert_eq(count([1, 2]), 2)
    assert_eq(count(["a"]), 1)
    let mut m: Map[Str, Int] = Map()
    m.insert("a", 1)
    m.insert("b", 2)
    assert_eq(count(m), 20)
    let mut s: Set[Int] = Set()
    s.insert(7)
    assert_eq(count(s), 100)
}

test "a poly impl of a generic trait over List meets a bound at the impl's argument" {
    assert_eq(marked([1, 2, 3]), "list of 3")
    assert_eq(marked(["x"]), "list of 1")
}

test "a poly impl with a bound on its binder meets a bound where the element meets it" {
    assert(all_same([3, 3]))
    assert(!all_same(["a", "b"]))
}
