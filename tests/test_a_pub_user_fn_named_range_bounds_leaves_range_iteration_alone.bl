// The std modules read a range's bounds through an intrinsic named `range_bounds`. A user
// function of that name, even a pub one, is in scope only where the user can reach it, so it
// neither breaks nor replaces the std reads of a range.

pub fn range_bounds(n: Int) -> Int { n + 1 }

test "the user function is an ordinary function" {
    assert_eq(range_bounds(2), 3)
}

test "a range still walks and draws through std" {
    assert_eq((0..3).into_iter().count(), 3)
    let xs: List[Int] = (1..=3).into_iter().collect()
    assert_eq(xs, [1, 2, 3])
}

test "rand.int still reads the bounds of its range" {
    let x = rand.int(0..3)
    assert(x >= 0 && x < 3)
}
