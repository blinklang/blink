// A range bound to a `let` is a value like any other: a `for` loop over the name walks the
// same numbers as a loop over the literal, and the value can be walked again.

test "a let-bound range walks the same numbers as the literal" {
    let span = 1..4
    let mut seen: List[Int] = []
    for i in span { seen.push(i) }
    assert_eq(seen, [1, 2, 3])
}

test "a let-bound range can be walked twice" {
    let span = 0..=2
    let mut first = 0
    for i in span { first = first + i }
    let mut second = 0
    for i in span { second = second + i }
    assert_eq(first, 3)
    assert_eq(second, 3)
}
