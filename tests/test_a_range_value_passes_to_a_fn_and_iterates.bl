// A range literal is a `Range[Int]` value. It can be passed, returned, stored in a list and
// walked by a `for` loop that takes it as a value, with each end rule kept: `a..b` stops
// before b, `a..=b` includes b, and an empty range walks nothing.

fn total(r: Range[Int]) -> Int {
    let mut s = 0
    for i in r { s = s + i }
    s
}

fn count(r: Range[Int]) -> Int {
    let mut n = 0
    for _i in r { n = n + 1 }
    n
}

fn upto(n: Int) -> Range[Int] { 0..=n }

fn same[T](r: Range[T]) -> Range[T] { r }

test "an exclusive range stops before its end and an inclusive one includes it" {
    assert_eq(total(0..4), 6)
    assert_eq(total(1..=4), 10)
    assert_eq(count(0..4), 4)
    assert_eq(count(0..=4), 5)
}

test "an empty or reversed range walks nothing" {
    assert_eq(count(5..5), 0)
    assert_eq(count(5..=4), 0)
    assert_eq(count(5..2), 0)
    assert_eq(count(0..=0), 1)
}

test "a range whose end is a local passes straight to a fn" {
    let hi = 4
    let a = total(0..hi)
    let b = count(0..=hi)
    let c = total(same(1..=hi))
    assert_eq(a + b + c, 6 + 5 + 10)
}

test "a range comes back from a fn and through a generic fn" {
    assert_eq(total(upto(3)), 6)
    assert_eq(total(same(2..4)), 5)
    assert_eq(count(same(0..=0)), 1)
}

test "ranges held in a list keep their own end rules" {
    let rs = [0..2, 3..=3]
    let mut t = 0
    for r in rs { t = t + total(r) }
    assert_eq(t, 4)
}

test "an annotated range let is the same value" {
    let x: Range[Int] = 0..3
    assert_eq(total(x), 3)
}

test "a mutable loop binder over a range literal changes only its own copy" {
    let mut seen: List[Int] = []
    for mut i in 0..=2 {
        i = i * 10
        seen.push(i)
    }
    assert_eq(seen, [0, 10, 20])
}
