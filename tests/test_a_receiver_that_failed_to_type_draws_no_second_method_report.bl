// A method call whose receiver already has an error gets no second report for the method: the
// receiver's error is the cause, and a report that the method resolves to nothing only repeats
// it. A call that one check reports as E0505 gets no second report from the method flush. A
// receiver that types well still gets its method report when an argument has an error. A
// receiver that an earlier error left with no type is a poison value, and gets no report
// (section 6.3.5).

import compile_test_helpers.{compile_and_capture}

fn count(output: Str, code: Str) -> Int {
    output.split("\"code\":\"{code}\"").len() - 1
}

test "an undefined function as the receiver gives only its own error" {
    let src = "fn main() \{\n    let x = undefined_fn(1).m()\n    io.println(\"\{x\}\")\n\}\n"
    let out = compile_and_capture(src, "_rfpoison_undefined_fn")
    assert_eq(count(out, "E0504"), 1, out)
    assert_eq(count(out, "E0505"), 0, out)
}

test "an unresolved method in the receiver gives one E0505 and no report for the outer call" {
    let src = "fn main() \{\n    let x = [1, 2].nope_method(3).m()\n    io.println(\"\{x\}\")\n\}\n"
    let out = compile_and_capture(src, "_rfpoison_inner_method")
    assert_eq(count(out, "E0505"), 1, out)
    assert(out.contains("nope_method"), out)
}

test "default outside a handler gives one E0505" {
    let src = "fn main() \{\n    default.zork()\n\}\n"
    let out = compile_and_capture(src, "_rfpoison_default")
    assert_eq(count(out, "E0505"), 1, out)
}

test "a receiver that types well still gets its method report when an argument has an error" {
    let src = "fn f[T](x: T) -> Int \{\n    x.m(undefined_fn(1))\n\}\nfn main() \{\n    io.println(\"\{f(1)\}\")\n\}\n"
    let out = compile_and_capture(src, "_rfpoison_bad_arg")
    assert_eq(count(out, "E0504"), 1, out)
    assert_eq(count(out, "E0505"), 1, out)
    assert(out.contains("has no bound, so it has no method `m`"), out)
}

test "a receiver bound to a let whose value failed gives only the error of the value" {
    let src = "fn main() \{\n    let a = undefined_fn(1)\n    let x = a.m()\n    io.println(\"\{x\}\")\n\}\n"
    let out = compile_and_capture(src, "_rfpoison_failed_let")
    assert_eq(count(out, "E0504"), 1, out)
    assert_eq(count(out, "E0505"), 0, out)
}

test "a closure parameter that E0301 reports gives no E0505 for its method call" {
    let src = "fn main() \{\n    let g = fn(x) \{ x.frob() \}\n    io.println(\"hi\")\n\}\n"
    let out = compile_and_capture(src, "_rfpoison_e0301_closure")
    assert_eq(count(out, "E0301"), 1, out)
    assert_eq(count(out, "E0505"), 0, out)
}
