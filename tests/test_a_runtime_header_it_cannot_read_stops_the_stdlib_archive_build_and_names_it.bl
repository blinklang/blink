// The stdlib archive build copies bootstrap/runtime.h into the archive. A runtime.h it cannot
// read is not an empty header: the build says which path and why, and stops before cc.

import compile_test_helpers
import std.process.{ProcessResult}

fn sh(cmd: Str) -> ProcessResult {
    process.run("sh", ["-c", cmd]).unwrap()
}

test "a runtime header it cannot read stops the stdlib archive build and names the path" {
    if sh("id -u").out.trim() == "0" { skip("root can read every file") }
    let d = "{compile_test_helpers.scratch_root()}/_runtime_h_unreadable_{getpid()}"
    sh("rm -rf {d} && mkdir -p {d} && cp -r bootstrap {d}/bootstrap && ln -s $(pwd)/lib {d}/lib && chmod 000 {d}/bootstrap/runtime.h")
    let r = sh("B=$(pwd)/build/blink; cd {d} && env -u BLINK_COMPILER_ARCHIVE BLINK_ROOT={d} timeout 600 $B __build-stdlib-archive < /dev/null 2>&1")
    sh("chmod 644 {d}/bootstrap/runtime.h")
    sh("rm -rf {d}")
    assert(!r.success(), "the archive build answered success:\n{r.out}")
    assert(r.out.contains("read {d}/bootstrap/runtime.h: Permission denied"), "the error does not name the path and the cause:\n{r.out}")
    assert(!r.out.contains("cc failed"), "the build ran cc on an empty header:\n{r.out}")
}
