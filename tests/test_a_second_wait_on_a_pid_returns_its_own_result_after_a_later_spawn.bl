// Pid.wait is idempotent: a second wait returns the first child's cached result. The runtime
// once freed the slot at the first wait, so the next spawn took it and the old handle named
// the new child: the second wait returned that child's output and freed its live slot, so a
// third spawn could share it too.

import std.process.{spawn}

test "a second wait returns the first child's result, and leaves the later children alone" {
    let a = spawn("echo", ["a"])
    let ra = a.wait()
    let b = spawn("echo", ["b"])
    let ra2 = a.wait()
    assert_eq(ra.out.trim(), "a")
    assert_eq(ra2.out.trim(), "a")
    assert_eq(ra2.exit_code, 0)
    let c = spawn("echo", ["c"])
    let rb = b.wait()
    let rc = c.wait()
    assert_eq(rb.out.trim(), "b")
    assert_eq(rc.out.trim(), "c")
}
