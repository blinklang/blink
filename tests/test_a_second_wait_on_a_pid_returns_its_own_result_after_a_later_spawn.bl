// process.wait is idempotent: a second wait returns the first child's result. The runtime
// once freed the slot at the first wait, so the next spawn took it and the old handle named
// the new child: the second wait returned that child's output.

import std.process.{ChildEnd}

test "a second wait returns the first child's result after a later spawn" {
    let a = process.spawn("echo", ["a"])?
    let ra = process.wait(a)?
    let b = process.spawn("echo", ["b"])?
    let ra2 = process.wait(a)?
    assert_eq(ra.out.trim(), "a")
    assert_eq(ra2.out.trim(), "a")
    assert_eq(ra2.end, ChildEnd.Exited(0))
    let rb = process.wait(b)?
    assert_eq(rb.out.trim(), "b")
}
