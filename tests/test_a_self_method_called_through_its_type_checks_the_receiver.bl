// `T.sh(t)` calls the trait method `sh(self)` with `t` as the receiver. The receiver is an
// argument like the others, so a value that is not a `T` is a type error at check.

import compile_test_helpers.{compile_and_capture, compile_and_run}

test "a self method called through its type refuses a receiver of another type" {
    let r = compile_and_capture(#"
trait Sh { fn sh(self) -> Int }
type T { x: Int }
impl Sh for T { fn sh(self) -> Int { self.x } }
fn main() { io.println("{T.sh(1)}") }
"#, "_self_method_type_head_bad_receiver")
    assert(r.contains("argument 1 of `T.sh` expects T, got Int"), r)
    assert(!r.contains("\"severity\":\"ice\""), r)
}

test "a self method called through its type runs on a receiver of that type" {
    let r = compile_and_run(#"
trait Sh { fn sh(self) -> Int }
type T { x: Int }
impl Sh for T { fn sh(self) -> Int { self.x } }
fn main() {
    let t = T { x: 4 }
    io.println("{T.sh(t)}")
}
"#, "_self_method_type_head_good_receiver")
    assert_eq(r.exit_code, 0)
    assert_eq(r.out.trim(), "4")
}

test "a self method called through a builtin type refuses a receiver of another type" {
    let r = compile_and_capture(#"
trait Sz { fn sz(self) -> Int }
impl Sz for Int { fn sz(self) -> Int { self } }
impl Sz for Str { fn sz(self) -> Int { self.len() } }
fn main() { io.println("{Int.sz(\"s\")} {Str.sz(1)}") }
"#, "_self_method_builtin_head_bad_receiver")
    assert(r.contains("argument 1 of `Int.sz` expects Int, got Str"), r)
    assert(r.contains("argument 1 of `Str.sz` expects Str, got Int"), r)
    assert(!r.contains("\"severity\":\"ice\""), r)
}

test "a self method called through a sized builtin type refuses a receiver of another type" {
    let r = compile_and_capture(#"
trait Sz { fn sz(self) -> Int }
impl Sz for U8 { fn sz(self) -> Int { 1 } }
impl Sz for Float { fn sz(self) -> Int { 2 } }
fn main() {
    let n = 3
    io.println("{U8.sz(\"s\")} {Float.sz(n)}")
}
"#, "_self_method_sized_builtin_head_bad_receiver")
    assert(r.contains("argument 1 of `U8.sz` expects U8, got Str"), r)
    assert(r.contains("argument 1 of `Float.sz` expects Float, got Int"), r)
    assert(!r.contains("\"severity\":\"ice\""), r)
}

test "a self method called through a builtin type runs on a receiver of that type" {
    let r = compile_and_run(#"
trait Sz { fn sz(self) -> Int }
impl Sz for Int { fn sz(self) -> Int { self } }
impl Sz for Str { fn sz(self) -> Int { self.len() } }
fn main() { io.println("{Int.sz(4)} {Str.sz(\"abc\")}") }
"#, "_self_method_builtin_head_good_receiver")
    assert_eq(r.exit_code, 0)
    assert_eq(r.out.trim(), "4 3")
}
