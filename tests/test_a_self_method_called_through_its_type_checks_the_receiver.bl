// A method with `self` is no function of its type (sections/03_types.md §3.4), so `T.sh(x)` is
// E0567 at check, and a first argument that is not a `T` gets a note that names both types.
// `Sh.sh(t)` names the trait and calls the method with `t` as the receiver.

import compile_test_helpers.{compile_and_capture, compile_and_run}

test "a self method called through its type with a receiver of another type is E0567 with a note" {
    let r = compile_and_capture(#"
trait Sh { fn sh(self) -> Int }
type T { x: Int }
impl Sh for T { fn sh(self) -> Int { self.x } }
fn main() { io.println("{T.sh(1)}") }
"#, "_self_method_type_head_bad_receiver")
    assert(r.contains("MethodThroughTypeName"), r)
    assert(r.contains("the first argument `1` has type `Int`, not `T`"), r)
    assert(!r.contains("\"severity\":\"ice\""), r)
}

test "a self method called through its trait runs on a receiver of that type" {
    let r = compile_and_run(#"
trait Sh { fn sh(self) -> Int }
type T { x: Int }
impl Sh for T { fn sh(self) -> Int { self.x } }
fn main() {
    let t = T { x: 4 }
    io.println("{Sh.sh(t)}")
}
"#, "_self_method_type_head_good_receiver")
    assert_eq(r.exit_code, 0)
    assert_eq(r.out.trim(), "4")
}

test "a self method called through a builtin type with a receiver of another type is E0567 with a note" {
    let r = compile_and_capture(#"
trait Sz { fn sz(self) -> Int }
impl Sz for Int { fn sz(self) -> Int { self } }
impl Sz for Str { fn sz(self) -> Int { self.len() } }
fn main() {
    let a = Int.sz("s")
    let b = Str.sz(1)
    io.println("{a} {b}")
}
"#, "_self_method_builtin_head_bad_receiver")
    assert(r.contains("MethodThroughTypeName"), r)
    assert(r.contains("the first argument `\\\"s\\\"` has type `Str`, not `Int`"), r)
    assert(r.contains("the first argument `1` has type `Int`, not `Str`"), r)
    assert(!r.contains("\"severity\":\"ice\""), r)
}

test "a self method called through a sized builtin type with a receiver of another type is E0567 with a note" {
    let r = compile_and_capture(#"
trait Sz { fn sz(self) -> Int }
impl Sz for U8 { fn sz(self) -> Int { 1 } }
impl Sz for Float { fn sz(self) -> Int { 2 } }
fn main() {
    let n = 3
    let a = U8.sz("s")
    let b = Float.sz(n)
    io.println("{a} {b}")
}
"#, "_self_method_sized_builtin_head_bad_receiver")
    assert(r.contains("MethodThroughTypeName"), r)
    assert(r.contains("the first argument `\\\"s\\\"` has type `Str`, not `U8`"), r)
    assert(r.contains("the first argument `n` has type `Int`, not `Float`"), r)
    assert(!r.contains("\"severity\":\"ice\""), r)
}

test "a self method called through its trait on a builtin type runs on a receiver of that type" {
    let r = compile_and_run(#"
trait Sz { fn sz(self) -> Int }
impl Sz for Int { fn sz(self) -> Int { self } }
impl Sz for Str { fn sz(self) -> Int { self.len() } }
fn main() { io.println("{Sz.sz(4)} {Sz.sz(\"abc\")}") }
"#, "_self_method_builtin_head_good_receiver")
    assert_eq(r.exit_code, 0)
    assert_eq(r.out.trim(), "4 3")
}
