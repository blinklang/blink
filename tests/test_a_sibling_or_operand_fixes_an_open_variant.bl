// A form that yields one type from two values fixes an open slot of either from the other:
// the branches of an `if`, the arms of a `match`, and the operands of a comparison
// (sections/03_types.md: comparison operands are the same type). A parameter that names
// `Self` takes the receiver's type, so an argument for it is fixed by the receiver. Each
// program here checks and runs; none is under-determined.

@derive(Eq)
type Box[T] {
    Full(T)
    Vacant
}

type Pick[T, U] {
    A(T)
    B(U)
}

fn wantp(p: Pick[Int, Str]) -> Int {
    match p {
        Pick.A(v) => v
        Pick.B(s) => s.len()
    }
}

type Spot { v: Int }

trait Same {
    fn same(self, other: Option[Self]) -> Bool
    fn res(self, r: Result[Self, Str]) -> Bool
}

impl Same for Spot {
    fn same(self, other: Option[Self]) -> Bool {
        match other {
            Some(o) => o.v == self.v
            None => false
        }
    }
    fn res(self, r: Result[Self, Str]) -> Bool {
        match r {
            Ok(o) => o.v == self.v
            Err(_) => false
        }
    }
}

fn pick_of(c: Int) -> Int {
    let r = if c > 1 { Pick.A(c) } else { Pick.B("xy") }
    wantp(r)
}

fn pick_of_match(o: Int?) -> Int {
    let r = match o {
        Some(v) => Pick.A(v)
        None => Pick.B("abc")
    }
    wantp(r)
}

test "an if whose branches are sibling variants takes one type from both" {
    let c = 1
    let b = if c == 1 { Box.Full(9) } else { Box.Vacant }
    match b {
        Box.Full(v) => assert_eq(v, 9)
        Box.Vacant => assert(false)
    }
    assert_eq(pick_of(5), 5)
    assert_eq(pick_of(0), 2)
}

test "a match whose arms are sibling variants takes one type from all of them" {
    assert_eq(pick_of_match(Some(4)), 4)
    assert_eq(pick_of_match(None), 3)
}

test "a comparison fixes the open slot of a nullary variant from the other operand" {
    let b: Box[Int] = Box.Full(3)
    assert(!(b == Box.Vacant))
    assert(Box.Vacant != b)
    let e: Box[Int] = Box.Vacant
    assert(e == Box.Vacant)
    let o: Option[Int] = None
    assert(o == None)
    let d: Option[Option[Int]] = Some(None)
    assert(d == Some(None))
}

test "an argument for a parameter that names Self is fixed by the receiver" {
    let s = Spot { v: 1 }
    assert(!s.same(None))
    assert(s.same(Some(Spot { v: 1 })))
    assert(!s.res(Err("x")))
    assert(!Same.same(s, None))
}
