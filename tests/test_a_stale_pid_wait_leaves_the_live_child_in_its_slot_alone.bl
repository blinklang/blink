// A wait on a handle whose slot a later spawn took must not touch that later child. The
// runtime once let it drain and reap the later child and mark its live slot free, so the
// next spawn took the slot too, and the later child's own wait returned that spawn's output.

import std.process.{spawn, ChildEnd}

test "a stale wait neither reaps the later child in its slot nor frees that slot" {
    let first = spawn("echo", ["first"])
    let _ = first.wait()
    // 4095 more fill the table, so the next spawn, later, reuses the first waited slot.
    let mut i = 0
    while i < 4095 {
        let _ = spawn("true", []).wait()
        i = i + 1
    }
    let later = spawn("sh", ["-c", "sleep 1; echo later"])
    let stale = first.wait()
    let next = spawn("echo", ["next"])
    let rl = later.wait()
    let rn = next.wait()
    assert_eq(rl.out.trim(), "later")
    assert_eq(rl.end, ChildEnd.Exited(0))
    assert_eq(rn.out.trim(), "next")
    assert_eq(stale.exit_code, -1, "a stale wait gave out={stale.out}")
}
