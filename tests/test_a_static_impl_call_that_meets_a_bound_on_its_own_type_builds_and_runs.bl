// A static call through a generic impl holds that impl's bounds at the type the head names
// (§3.6 Trait Bounds). A bound that names the impl's own type, such as `T: Conv[Bx[T]]` or a
// `where Sw[T]: Sh` clause, met by a bound on the binder, one in an impl's where clause, one given through a
// supertrait, or a concrete type that has the trait, builds and runs, through a bare head and
// an alias head, at a trait-qualified call to a method written with `self`, and when a use
// after the call fills the head. Inside an impl with `where Sw[T]: Sh`, a call that reaches the
// `Sh` impl at that impl's own type builds and runs.

trait Conv[A] {
    fn conv(self) -> Int
}

trait Big[A]: Conv[A] {
    fn big(self) -> Int
}

type Bx[T] { v: T }

impl Conv[Bx[Int]] for Int {
    fn conv(self) -> Int { self * 10 }
}

impl Big[Bx[Int]] for Int {
    fn big(self) -> Int { self }
}

trait Mk {
    fn mk(s: Self) -> Int
}

trait Tot {
    fn tot(self) -> Int
}

impl[T: Conv[Bx[T]]] Mk for Bx[T] {
    fn mk(s: Self) -> Int { s.v.conv() }
}

impl[T: Conv[Bx[T]]] Tot for Bx[T] {
    fn tot(self) -> Int { self.v.conv() + 1 }
}

trait Sh {
    fn sh(self) -> Int
}

type Sw[T] { v: T }

impl[T: Eq] Sh for Sw[T] {
    fn sh(self) -> Int { if self.v == self.v { 5 } else { 0 } }
}

impl[T] Mk for Sw[T] where Sw[T]: Sh {
    fn mk(s: Self) -> Int { s.sh() + 100 }
}

impl[T] Tot for Sw[T] where Sw[T]: Sh {
    fn tot(self) -> Int { self.sh() + 10 }
}

trait Wv {
    fn wv(self) -> Int
}

impl[T] Wv for Sw[T] where Sw[T]: Sh {
    fn wv(self) -> Int { Sw.mk(self) + self.tot() + self.sh() }
}

type Named = Bx[Int]

trait Ck {
    fn chk(self) -> Int
}

impl[T] Ck for Bx[T] where T: Conv[Bx[T]] {
    fn chk(self) -> Int { Bx.mk(self) + Tot.tot(self) }
}

fn inline[T: Conv[Bx[T]]](b: Bx[T]) -> Int {
    Bx.mk(b) + Tot.tot(b)
}

fn inline_where_self[T: Eq](b: Sw[T]) -> Int {
    Sw.mk(b)
}

fn through_super[T: Big[Bx[T]]](b: Bx[T]) -> Int {
    Bx.mk(b) + Tot.tot(b)
}

fn super_where_self[T: Ord](b: Sw[T]) -> Int {
    Sw.mk(b)
}

fn late() -> Int {
    let mut l = []
    let r = Sw.mk(Sw { v: l })
    l.push(1)
    r
}

test "a bound on the binder meets a bound that names the impl's own type" {
    assert_eq(inline(Bx { v: 2 }), 41)
    assert_eq(inline_where_self(Sw { v: "a" }), 105)
}

test "a bound in an impl's where clause meets a bound that names the impl's own type" {
    assert_eq(Bx { v: 3 }.chk(), 61)
}

test "a bound given through a supertrait meets a bound that names the impl's own type" {
    assert_eq(through_super(Bx { v: 1 }), 21)
    assert_eq(super_where_self(Sw { v: 4 }), 105)
}

test "a concrete type that has the trait meets a bound that names the impl's own type" {
    assert_eq(Bx.mk(Bx { v: 4 }), 40)
    assert_eq(Tot.tot(Bx { v: 4 }), 41)
    assert_eq(Named.mk(Bx { v: 5 }), 50)
    assert_eq(Sw.mk(Sw { v: 1 }), 105)
    assert_eq(late(), 105)
}

test "a where clause on the impl's own type meets the impl it names at the impl's own type in its body" {
    assert_eq(Sw { v: 1 }.wv(), 125)
}
