// A std higher-order fn that only calls its callback takes `f: fn(..) ! _` and has the row
// `! _`, so a callback with effects flows into it as it is (sections/04_effects.md §4.15.2).
// The fn-row trace names each fn value whose row a fn type does not admit. A pure fn type
// that takes a fn with a row is the one flow here that it names, so an empty trace is not a
// channel that never turned on.

import compile_test_helpers.{fn_row_flows_via_cli}

test "list and map callbacks with a row flow into the std fns with no fn-row trace" {
    let src = #"import std.list.{list_map, list_filter, list_fold, list_any, list_all, list_for_each, list_find, list_flat_map, list_sort_by}
import std.map.{map_for_each, map_filter, map_fold, map_map_values}

fn say(n: Int) -> Int ! IO.Print {
    io.println("{n}")
    n
}

fn take(f: fn() -> Int) -> Int { f() }

fn main() ! IO {
    let xs = [2, 1]
    let mut m: Map[Str, Int] = Map()
    m.insert("a", 1)
    let _ = list_map(xs, fn(x: Int) -> Int { say(x) })
    let _ = list_filter(xs, fn(x: Int) -> Bool { say(x) > 0 })
    let _ = list_fold(xs, 0, fn(a: Int, x: Int) -> Int { a + say(x) })
    let _ = list_any(xs, fn(x: Int) -> Bool { say(x) > 1 })
    let _ = list_all(xs, fn(x: Int) -> Bool { say(x) > 1 })
    list_for_each(xs, fn(x: Int) { let _ = say(x) })
    let _ = list_find(xs, fn(x: Int) -> Bool { say(x) > 1 })
    let _ = list_flat_map(xs, fn(x: Int) -> List[Int] { [say(x)] })
    let _ = list_sort_by(xs, fn(a: Int, b: Int) -> Ordering { say(a).cmp(b) })
    map_for_each(m, fn(_k: Str, v: Int) { let _ = say(v) })
    let _ = map_filter(m, fn(_k: Str, v: Int) -> Bool { say(v) > 0 })
    let _ = map_fold(m, 0, fn(a: Int, _k: Str, v: Int) -> Int { a + say(v) })
    let _ = map_map_values(m, fn(_k: Str, v: Int) -> Int { say(v) })
    io.println("{take(fn() -> Int { say(1) })}")
}
"#
    let lines = fn_row_flows_via_cli(src, "std_hof_row_{getpid()}")
    assert_eq(lines.len(), 1)
    assert(lines.get(0).unwrap().contains(":28:23 "), lines.join("\n"))
}

test "a for_each body with a row flows into std.testing.for_each with no fn-row trace" {
    let src = #"import std.testing.{for_each}

fn take(f: fn() -> Int) -> Int { f() }

test "cases print" {
    for_each([("a", 1), ("b", 2)], fn(n: Int) {
        io.println("case {n}")
    })
    assert_eq(take(fn() -> Int {
        io.println("x")
        1
    }), 1)
}
"#
    let lines = fn_row_flows_via_cli(src, "std_for_each_row_{getpid()}")
    assert_eq(lines.len(), 1)
    assert(lines.get(0).unwrap().contains(":9:20 "), lines.join("\n"))
}
