// A `Template[C]` names one fixed context, so the context is a closed type after the type
// check (section 3b.5), not a type parameter the check leaves open. A sub-effect gives no
// type, so a template over one is SubEffectAsType, with a help that names the parent effect.

import compile_test_helpers.{check_via_cli}

pub effect Rd {
    effect Read {
        fn read(t: Template[Rd]) -> Str
    }
}

fn parts(t: Template[Rd]) -> Int {
    t.count()
}

fn pass_on(t: Template[Rd]) -> Template[Rd] {
    t
}

let SUB_EFFECT_SRC = "pub effect Rd \{\n    effect Read \{\n        fn read(t: Template[Rd]) -> Str\n    }\n}\n\nfn read_parts(t: Template[Rd.Read]) -> Int \{\n    t.count()\n}\n\nfn main() \{\n    let n = 7\n    let _ = read_parts(\"a \{n} b \{n}\")\n}\n"

let THROUGH_GENERIC_SRC = "effect DB \{ effect Read \{ fn r() -> Int } }\nfn ident[C](t: Template[C]) -> Template[C] \{ t }\nfn take(t: Template[DB.Read]) -> Int \{ ident(t).count() }\n\nfn main() \{ }\n"

test "a template over a user effect context builds and reads its values" {
    let n = 7
    assert_eq(parts("a {n} b"), 1)
    assert_eq(parts(pass_on("x {n} {n}")), 2)
}

test "a template over a sub-effect context is SubEffectAsType and names the parent" {
    let out = check_via_cli(SUB_EFFECT_SRC, "tmpl_sub_effect_{getpid()}")
    assert(out.contains("\"name\":\"SubEffectAsType\",\"code\":\"E0536\""), out)
    assert(out.contains("name the parent effect: `Rd`"), out)
    assert(!out.contains("\"severity\":\"ice\""), out)
}

test "a sub-effect context passed through a generic template is SubEffectAsType, not an ICE" {
    let out = check_via_cli(THROUGH_GENERIC_SRC, "tmpl_sub_effect_generic_{getpid()}")
    assert(out.contains("\"name\":\"SubEffectAsType\",\"code\":\"E0536\""), out)
    assert(out.contains("name the parent effect: `DB`"), out)
    assert(!out.contains("\"severity\":\"ice\""), out)
}
