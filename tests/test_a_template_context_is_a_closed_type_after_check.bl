// A `Template[C]` names one fixed context, so the context is a closed type after the type
// check (section 3b.5), not a type parameter the check leaves open. A sub-effect names one too.
pub effect Rd {
    effect Read {
        fn read(t: Template[Rd]) -> Str
    }
}

fn parts(t: Template[Rd]) -> Int {
    t.count()
}

fn pass_on(t: Template[Rd]) -> Template[Rd] {
    t
}

fn read_parts(t: Template[Rd.Read]) -> Int {
    t.count()
}

test "a template over a user effect context builds and reads its values" {
    let n = 7
    assert_eq(parts("a {n} b"), 1)
    assert_eq(parts(pass_on("x {n} {n}")), 2)
}

test "a template over a sub-effect context builds and reads its values" {
    let n = 7
    assert_eq(read_parts("a {n} b {n}"), 2)
}
