// A `Template[C]` context names the declared effect however the file spells it: through the
// module qualifier, bare through a selective import, or by a selective alias (sections/03b
// §3b.5 "the module qualifies the name"). Each spelling is one type, in a generic call and in
// a generic type's instance.

import std.process.{ProcessResult}

fn run_fixture(name: Str, flags: List[Str]) -> ProcessResult ! Process.Spawn {
    let mut args = ["run"]
    for f in flags { args.push(f) }
    args.push("tests/zztc_template_context/src/{name}.bl")
    process.run("build/blink", args).unwrap()
}

fn assert_prints_with(name: Str, flags: List[Str], want: Str) ! IO.Print, Process.Spawn {
    let r = run_fixture(name, flags)
    if r.out != want { io.println("FAIL[{name}] want '{want}', got: {r.out}{r.err_out}") }
    assert(r.success())
    assert_eq(r.out, want)
}

// A one-unit build and a per-module build each name the context.
fn assert_prints_both(name: Str, want: Str) ! IO.Print, Process.Spawn {
    assert_prints_with(name, [], want)
    assert_prints_with(name, ["--no-per-module"], want)
}

test "a template of a module-qualified context passes through a generic fn" {
    assert_prints_both("main_generic_qualified", "1\n")
}

test "a generic type's instance at a context is one type under both spellings" {
    assert_prints_both("main_instance_two_spellings", "1\n")
}

test "a context named by a selective alias is the declared effect" {
    assert_prints_both("main_alias_context", "2\n")
}

test "two modules' effects of one name are each the context their qualifier names" {
    assert_prints_both("main_two_modules_one_effect_name", "1 102\n")
}

test "an operation's own template context reads in the module that declares its effect" {
    assert_prints_both("main_an_operation_reads_its_own_effect", "12\n")
}
