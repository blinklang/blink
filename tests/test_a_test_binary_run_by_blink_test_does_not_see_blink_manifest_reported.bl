// `blink test` sets BLINK_MANIFEST_REPORTED for its build workers only. The test binaries it
// runs must read the variable as absent, so a user's test never sees a variable it did not set.
// The fixture lives under a fresh temporary directory, since the test tree itself sits inside a
// project.

import std.process.{ProcessResult}

fn sh(cmd: Str) -> ProcessResult {
    process_run("sh", ["-c", cmd])
}

test "a test binary run by blink test reads BLINK_MANIFEST_REPORTED as absent" {
    let dir = sh("mktemp -d /tmp/blink_test_binary_env.XXXXXX").out.trim()
    let _ = sh("mkdir -p {dir}/src {dir}/tests")
    write_file("{dir}/blink.toml", "[package]\nname = \"app\"\nversion = \"0.1.0\"\n")
    // A lock no older than blink.toml keeps dependency resolution out of the command.
    write_file("{dir}/blink.lock", "[metadata]\nlockfile-version = 1\n")
    write_file("{dir}/tests/test_env.bl", "test \"env\" \{\n    assert_eq(env.var(\"BLINK_MANIFEST_REPORTED\") ?? \"absent\", \"absent\")\n}\n")
    // BLINK_BIN makes the build workers the compiler under test, not the blink on PATH.
    let r = sh("B=$(pwd)/build/blink; cd {dir} && env -u BLINK_PER_MODULE -u BLINK_MANIFEST_REPORTED BLINK_BIN=$B $B test tests")
    let _ = sh("rm -rf {dir}")
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("1 passed") || r.err_out.contains("1 passed"))
}
