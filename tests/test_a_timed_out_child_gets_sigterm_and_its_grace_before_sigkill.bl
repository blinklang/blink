// At the deadline the runtime sends SIGTERM to the child's process group, and SIGKILL after
// `grace`; a grace of zero sends SIGKILL at once (sections/04_effects.md §4.4.8 Child
// limits; Bad values and unsupported limits). A child that exits 0 on SIGTERM still ends as
// Limit(Timeout). The shell loops sleep in short steps so that its trap runs soon after the
// signal, and each deadline is 2 s so that the shell has set its trap before it. Upper bounds on time are far from the values the cases set; the one lower bound
// holds on any host, since the runtime cannot send SIGKILL before deadline + grace.

import std.process.{ChildEnd, ChildLimits, LimitKind}
import std.time.{Duration}

fn limits_ms(timeout: Int, grace: Int) -> ChildLimits {
    ChildLimits { timeout: Some(Duration.ms(timeout)), grace: Duration.ms(grace) }
}

test "a child that exits 0 on SIGTERM in its grace ends as Limit(Timeout)" {
    let start = time.read()
    let script = "trap 'echo term; exit 0' TERM; echo up; while :; do sleep 0.05; done"
    let r = process.run("sh", ["-c", script], limits: limits_ms(2000, 20000)).unwrap()
    assert_eq(r.end, ChildEnd.Limit(LimitKind.Timeout))
    assert_eq(r.out, "up\nterm\n")
    assert(start.elapsed().to_ms() < 15000, "the child got SIGKILL, not SIGTERM: {start.elapsed().to_ms()} ms")
}

test "a child that ignores SIGTERM gets SIGKILL after its grace" {
    let start = time.read()
    let r = process.run("sh", ["-c", "trap '' TERM; while :; do sleep 0.05; done"], limits: limits_ms(2000, 500)).unwrap()
    let ms = start.elapsed().to_ms()
    assert_eq(r.end, ChildEnd.Limit(LimitKind.Timeout))
    assert(ms >= 2450, "SIGKILL came before deadline + grace: {ms} ms")
    assert(ms < 15000, "run waited {ms} ms")
}

test "a grace of zero sends SIGKILL at the deadline and no SIGTERM" {
    let script = "trap 'echo term; exit 0' TERM; echo up; while :; do sleep 0.05; done"
    let r = process.run("sh", ["-c", script], limits: limits_ms(2000, 0)).unwrap()
    assert_eq(r.end, ChildEnd.Limit(LimitKind.Timeout))
    assert_eq(r.out, "up\n")
}

test "a spawned child gets its grace too" {
    let script = "trap 'echo term; exit 0' TERM; echo up; while :; do sleep 0.05; done"
    let child = process.spawn("sh", ["-c", script], limits: limits_ms(2000, 20000)).unwrap()
    let r = process.wait(child).unwrap()
    assert_eq(r.end, ChildEnd.Limit(LimitKind.Timeout))
    assert_eq(r.out, "up\nterm\n")
}
