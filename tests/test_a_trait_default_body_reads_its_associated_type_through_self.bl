// A default body that calls a method returning `Self.Item` holds a value of the trait's own
// associated type. Like `Self`, that type is a parameter of the trait, so it is closed inside
// the trait's declaration and each impl gives it a type. The impls write each default method
// too, so the file builds while an impl that omits one is refused; the default bodies are
// still checked at the trait.

trait Shape {
    type Item
    fn item(self) -> Self.Item
    fn put(self, it: Self.Item) -> Int
    fn go(self) -> Int {
        self.put(self.item())
    }
    fn go_through_a_local(self) -> Int {
        let it = self.item()
        self.put(it)
    }
    fn count_items(self) -> Int {
        let _it = self.item()
        1
    }
    fn wrap(self) -> Option[Self.Item] {
        let f = fn() -> Option[Self.Item] { Some(self.item()) }
        f()
    }
}

type Box { n: Int }

impl Shape for Box {
    type Item = Int
    fn item(self) -> Int { self.n }
    fn put(self, it: Int) -> Int { it + 1 }
    fn go(self) -> Int { self.put(self.item()) }
    fn go_through_a_local(self) -> Int {
        let it = self.item()
        self.put(it)
    }
    fn count_items(self) -> Int { 1 }
    fn wrap(self) -> Option[Int] { Some(self.n) }
}

type Label { s: Str }

impl Shape for Label {
    type Item = Str
    fn item(self) -> Str { self.s }
    fn put(self, it: Str) -> Int { it.len() }
    fn go(self) -> Int { self.put(self.item()) }
    fn go_through_a_local(self) -> Int {
        let it = self.item()
        self.put(it)
    }
    fn count_items(self) -> Int { 1 }
    fn wrap(self) -> Option[Str] { Some(self.s) }
}

fn through_a_bound[S: Shape](s: S) -> Int { s.go() }

test "a trait whose default bodies hold Self.Item builds, and its impls run" {
    assert_eq(Box { n: 4 }.go(), 5)
    assert_eq(Label { s: "abc" }.go(), 3)
    assert_eq(Box { n: 9 }.go_through_a_local(), 10)
    assert_eq(Label { s: "ab" }.count_items(), 1)
    assert_eq(through_a_bound(Label { s: "abcd" }), 4)
    assert_eq(Box { n: 2 }.wrap(), Some(2))
}
