// A trait method's parameter default is checked against the method's own signature, so a
// default such as `[]` or `None` for a parameter typed by the method's own type parameter
// takes that parameter's type. The call fills or binds the type parameter as for a free fn.

type Bx { v: Int }

trait Kw {
    fn kw[U](self, -- a: List[U] = []) -> Int
    fn ko[U](self, -- o: Option[U] = None) -> Int
}

impl Kw for Bx {
    fn kw[U](self, -- a: List[U] = []) -> Int { self.v + a.len() }
    fn ko[U](self, -- o: Option[U] = None) -> Int { self.v + (if o.is_some() { 10 } else { 0 }) }
}

test "a trait method default typed by the method's own type parameter is valid" {
    let bx = Bx { v: 2 }
    assert_eq(bx.kw(a: [1]), 3)
    assert_eq(bx.kw(a: ["s", "t"]), 4)
}

test "an Option default typed by the method's own type parameter is valid" {
    let bx = Bx { v: 2 }
    assert_eq(bx.ko(o: Some("s")), 12)
}
