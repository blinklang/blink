// `Trait.method(x)` names one trait's method on x. When no impl of that trait answers for x's
// type, the call has no method to run, so check refuses it with the same report as `x.method()`.

import compile_test_helpers.{compile_and_capture, compile_and_run}

fn runs_and_prints(src: Str, fixture: Str, want: Str) ! FS.Delete, FS.Write, Process.Spawn, FS.Read, Env.Read {
    let r = compile_and_run(src, fixture)
    assert(r.exit_code == 0, "{r.out}{r.err_out}")
    assert_eq(r.out.trim(), want)
}

fn refused_with(code: Str, src: Str, fixture: Str) ! FS.Delete, FS.Write, Process.Spawn, FS.Read, Env.Read {
    let r = compile_and_capture(src, fixture)
    assert(r.contains(code), r)
    assert(!r.contains("\"severity\":\"ice\""), r)
}

test "a trait-qualified call on a builtin receiver with no impl is refused" {
    refused_with("unresolved method `.sh` on type Int", #"
trait Sh { fn sh(self) -> Int }
type T { x: Int }
impl Sh for T { fn sh(self) -> Int { self.x } }
fn main() { io.println("{Sh.sh(1)}") }
"#, "_qt_noimpl_int")
}

test "a trait-qualified call on a struct with no impl is refused" {
    refused_with("E0505", #"
trait Sh { fn sh(self) -> Int }
type T { x: Int }
type U { y: Int }
impl Sh for T { fn sh(self) -> Int { self.x } }
fn main() { io.println("{Sh.sh(U { y: 1 })}") }
"#, "_qt_noimpl_struct")
}

test "a trait-qualified call on a generic struct with no impl is refused" {
    refused_with("E0505", #"
trait Sh { fn sh(self) -> Int }
type B[X] { v: X }
fn main() { io.println("{Sh.sh(B { v: 1 })}") }
"#, "_qt_noimpl_generic")
}

test "a std trait-qualified call on a struct with no derive or impl is refused" {
    refused_with("unresolved method `.hash` on type S", #"
type S { a: Int }
fn main() { io.println("{Hash.hash(S { a: 1 })}") }
"#, "_qt_noimpl_std_hash")
    refused_with("unresolved method `.eq` on type S", #"
type S { a: Int }
fn main() { io.println("{Eq.eq(S { a: 1 }, S { a: 2 })}") }
"#, "_qt_noimpl_std_eq")
}

test "a trait-qualified call runs the impl that answers for its receiver" {
    runs_and_prints(#"
trait Sh { fn sh(self) -> Int }
type T { x: Int }
type B[X] { v: X }
impl Sh for T { fn sh(self) -> Int { self.x } }
impl Sh for Int { fn sh(self) -> Int { self + 1 } }
impl[X] Sh for B[X] { fn sh(self) -> Int { 7 } }
fn main() { io.println("{Sh.sh(T { x: 4 })} {Sh.sh(2)} {Sh.sh(B { v: "s" })}") }
"#, "_qt_impl_answers", "4 3 7")
}
