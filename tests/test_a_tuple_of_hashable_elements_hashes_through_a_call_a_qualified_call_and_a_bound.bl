// A tuple implements Hash when every element does (sections/03_types.md *Hash Contract and
// Seeding*). Its `hash()` runs through a method call, a trait-qualified call and a Hash bound,
// and each gives the same value. The same unit can also key a Map on that tuple type, so the
// hash a Map uses and the hash a call uses are one function.

@derive(Eq, Hash)
type TupleHashCell {
    n: Int
}

fn tuple_hash_via[T: Hash](x: T) -> U64 {
    x.hash()
}

test "the three call forms give the same hash" {
    let t = (1, "a")
    assert_eq(t.hash(), Hash.hash(t))
    assert_eq(t.hash(), tuple_hash_via(t))
    assert_eq((3, 4).hash(), tuple_hash_via((3, 4)))
}

test "equal tuples hash equal and the order of the elements counts" {
    assert_eq((1, 2).hash(), (1, 2).hash())
    assert_eq((1, "x", true).hash(), (1, "x", true).hash())
    assert((1, 2).hash() != (2, 1).hash())
}

test "a nested tuple and a tuple of a derived type hash" {
    let n = ((1, 2), "b")
    assert_eq(n.hash(), ((1, 2), "b").hash())
    assert_eq(n.hash(), tuple_hash_via(n))
    assert(n.hash() != ((2, 1), "b").hash())
    let c = (TupleHashCell { n: 5 }, 'q')
    assert_eq(c.hash(), (TupleHashCell { n: 5 }, 'q').hash())
    assert_eq(Hash.hash(c), tuple_hash_via(c))
}

test "a Map keyed on a tuple type and a hash call on that type share a unit" {
    let mut m: Map[(Int, Str), Int] = Map.new()
    m.insert((1, "a"), 10)
    m.insert((2, "b"), 20)
    assert_eq(m.get((1, "a")), Some(10))
    assert_eq(m.get((2, "b")), Some(20))
    assert_eq((1, "a").hash(), tuple_hash_via((1, "a")))
}

fn tuple_hash_of_param[T: Hash](x: T) -> U64 {
    (x, 1).hash()
}

test "a tuple of a type parameter with a Hash bound hashes at each instance" {
    assert_eq(tuple_hash_of_param("a"), ("a", 1).hash())
    assert_eq(tuple_hash_of_param((2, 3)), ((2, 3), 1).hash())
}

@derive(Eq, Hash)
type TupleHashBox[T] {
    v: T
}

test "a derived generic over a tuple hashes and keys a Map" {
    // No other row hashes `(Bool, Str)`, so the box body is the first to need its hash.
    let b = TupleHashBox { v: (true, "a") }
    assert_eq(b.hash(), TupleHashBox { v: (true, "a") }.hash())
    let mut m: Map[TupleHashBox[(Bool, Str)], Int] = Map.new()
    m.insert(b, 7)
    assert_eq(m.get(TupleHashBox { v: (true, "a") }), Some(7))
}
