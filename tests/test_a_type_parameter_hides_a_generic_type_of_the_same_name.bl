// Inside the declaration that binds it, a type parameter's name means the parameter, even
// where a generic type of the same name is in scope (sections/03_types.md §3.4). The name
// is not that type written with no arguments, so no arity error fires on it.

type T[A] { v: Option[A] = None }

type Shape[A] { s: A }

trait Width {
    fn width[T](self, x: T) -> Int
}

impl Width for Int {
    fn width[T](self, _x: T) -> Int { self }
}

fn ident[Shape](x: Shape) -> Shape { x }

test "a fn type parameter named like a generic type is the parameter" {
    assert_eq(ident(3), 3)
    assert_eq(ident("a"), "a")
}

test "a trait method type parameter named like a generic type is the parameter" {
    assert_eq((4).width("x"), 4)
}

test "a prelude method with a type parameter named like a user type still takes its argument" {
    let t: T[Str] = T {}
    let sh = Shape { s: 2 }
    let mut sb = StringBuilder.new()
    sb.write(sh.s)
    sb.write(t.v.is_none())
    assert_eq(sb.to_str(), "2true")
}
