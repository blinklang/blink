// A row slot is not part of the C shape: `Cleanup[! IO.Print]` and bare `Cleanup` are one C
// type, so one slotted type never splits into one C type per row.

import compile_test_helpers

fn src() -> Str {
    #"type Cleanup[! _] {
    action: fn() -> Void ! _
}

fn loud(c: Cleanup[! IO.Print]) ! IO.Print { (c.action)() }

fn quiet(c: Cleanup) { (c.action)() }

fn main() ! IO {
    let a: Cleanup[! IO.Print] = Cleanup { action: fn() { io.println("loud") } }
    let b: Cleanup = Cleanup { action: fn() { } }
    loud(a)
    quiet(b)
}
"#
}

test "a rowful and a rowless use of a slotted type give one C type" {
    let c = compile_test_helpers.compile_and_emit_c(src(), "row_slot_one_c_name")
    assert(c.len() > 0, "the program emits C")
    assert_eq(compile_test_helpers.count_of(c, "typedef struct blink_4Cleanup \{"), 1)
    assert_eq(compile_test_helpers.count_of(c, "blink_4Cleanup_"), 0)
}

test "a program with a rowful and a rowless use of a slotted type runs" {
    let r = compile_test_helpers.compile_and_run(src(), "row_slot_one_c_name_run")
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("loud"), "stdout: {r.out}")
}

fn generic_src() -> Str {
    #"type Job[T ! _] {
    input: T
    run: fn(T) -> Void ! _
}

fn loud(j: Job[Int ! IO.Print]) ! IO.Print { (j.run)(j.input) }

fn quiet(j: Job[Int]) { (j.run)(j.input) }

fn main() ! IO {
    let a: Job[Int ! IO.Print] = Job { input: 7, run: fn(n: Int) { io.println("job {n}") } }
    let b: Job[Int] = Job { input: 8, run: fn(n: Int) { let _ = n } }
    let s: Job[Str ! IO.Print] = Job { input: "text", run: fn(t: Str) { io.println(t) } }
    loud(a)
    quiet(b)
    (s.run)(s.input)
}
"#
}

test "a slotted generic type gives one C type per type argument, whatever the row" {
    let c = compile_test_helpers.compile_and_emit_c(generic_src(), "row_slot_generic_c_name")
    assert(c.len() > 0, "the program emits C")
    assert_eq(compile_test_helpers.count_of(c, "typedef struct blink_4Job_0Int \{"), 1)
    assert_eq(compile_test_helpers.count_of(c, "typedef struct blink_4Job_0Str \{"), 1)
    assert_eq(compile_test_helpers.count_of(c, "blink_4Job_0Int_"), 0)
    assert_eq(compile_test_helpers.count_of(c, "blink_4Job_0Str_"), 0)
}

test "a program with slotted generic instances runs" {
    let r = compile_test_helpers.compile_and_run(generic_src(), "row_slot_generic_run")
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("job 7"), "stdout: {r.out}")
    assert(r.out.contains("text"), "stdout: {r.out}")
}
