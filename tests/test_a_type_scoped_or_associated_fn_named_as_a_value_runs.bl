// `T.name` with no argument list is a function value when `name` is a function in the `T.`
// namespace (sections/03_types.md §3.4 "A type-scoped or associated function named as a
// value"): a type-scoped function, one on a generic type, and an associated function that a
// trait impl gives the type. Its type is the declaration's type, with `Self` read as the head
// type, and the expected type solves the function's own binders. Through a generic impl the
// value holds the impl's bounds, met here by a bound on the binder, through an impl's where
// clause and through a supertrait. Each form builds and runs.

import std.time.{Duration}

type Stack[T] {
    items: List[T]
}

// The `Type_name` spelling declares `Stack.empty` until the parser takes `fn Stack.empty`.
fn Stack_empty[T]() -> Stack[T] {
    Stack { items: [] }
}

fn Stack_one[T](x: T) -> Stack[T] {
    Stack { items: [x] }
}

trait Make {
    fn make(n: Int) -> Self
}

type W {
    v: Int
}

impl Make for W {
    fn make(n: Int) -> W { W { v: n } }
}

type Level {
    Low
    High
}

fn Level_of(n: Int) -> Level {
    if n > 0 { Level.High } else { Level.Low }
}

trait Wrap[A] {
    fn wrap(a: A) -> Self
}

type Bx[T] {
    v: List[T]
}

impl[T: Eq] Wrap[T] for Bx[T] {
    fn wrap(a: T) -> Bx[T] { Bx { v: [a, a] } }
}

type Cx[T] {
    v: T
}

impl[T] Wrap[T] for Cx[T] where T: Eq {
    fn wrap(a: T) -> Cx[T] { Cx { v: a } }
}

trait Loud: Eq {
    fn loud(self) -> Int
}

impl Loud for Int {
    fn loud(self) -> Int { self * 10 }
}

trait Tag {
    fn tag[U](u: U, n: Int) -> Self
}

impl Tag for W {
    fn tag[U](u: U, n: Int) -> W { W { v: n } }
}

trait Wrap2[A] {
    fn wrap2[U](u: U, a: A) -> Self
}

impl[T] Wrap2[T] for Bx[T] {
    fn wrap2[U](u: U, a: T) -> Bx[T] { Bx { v: [a] } }
}

type Celsius {
    v: Int
}

impl From[Int] for Celsius {
    fn from(n: Int) -> Celsius { Celsius { v: n } }
}

type IntStack = Stack[Int]

fn apply(f: fn(Int) -> Duration, n: Int) -> Duration { f(n) }

fn wrap_inline[T: Eq](x: T) -> Bx[T] {
    let f: fn(T) -> Bx[T] = Bx.wrap
    f(x)
}

fn wrap_where[T: Eq](x: T) -> Cx[T] {
    let f: fn(T) -> Cx[T] = Cx.wrap
    f(x)
}

fn wrap_super[T: Loud](x: T) -> Bx[T] {
    let f: fn(T) -> Bx[T] = Bx.wrap
    f(x)
}

fn level_name(l: Level) -> Str {
    match l {
        Level.Low => "low"
        Level.High => "high"
    }
}

test "a type-scoped function is a value with no expected type" {
    let f = Duration.ms
    assert_eq(f(2).nanos, 2000000)
}

test "a type-scoped function is the function a parameter type expects" {
    assert_eq(apply(Duration.ms, 3).nanos, 3000000)
    let ds = [1, 2].map(Duration.ms)
    assert_eq(ds.get(1).unwrap().nanos, 2000000)
}

test "a type-scoped function on an enum is a value, not a variant" {
    let f = Level.of
    assert_eq(level_name(f(1)), "high")
    assert_eq(level_name(f(0)), "low")
}

test "the expected type solves the binders of a function on a generic type" {
    let e: fn() -> Stack[Int] = Stack.empty
    assert_eq(e().items.len(), 0)
    let ss = [1, 2].map(Stack.one)
    assert_eq(ss.get(1).unwrap().items.get(0).unwrap(), 2)
}

test "an associated function that a trait impl gives the type reads Self as the type" {
    let g: fn(Int) -> W = W.make
    assert_eq(g(4).v, 4)
    let ws = [5, 6].map(W.make)
    assert_eq(ws.get(1).unwrap().v, 6)
}

test "an associated function through a generic impl takes the impl at its expected type" {
    let f: fn(Int) -> Bx[Int] = Bx.wrap
    assert_eq(f(7).v.len(), 2)
    let g: fn(Str) -> Bx[Str] = Bx.wrap
    assert_eq(g("s").v.get(0).unwrap(), "s")
}

test "an associated function through a generic impl meets its bound in a generic body" {
    assert_eq(wrap_inline(3).v.len(), 2)
    assert_eq(wrap_where("w").v, "w")
    assert_eq(wrap_super(8).v.get(0).unwrap().loud(), 80)
}

test "the expected type solves the own binders of an associated function" {
    let f: fn(Str, Int) -> W = W.tag
    assert_eq(f("a", 3).v, 3)
    let g: fn(Str, Int) -> Bx[Int] = Bx.wrap2
    assert_eq(g("a", 4).v.get(0).unwrap(), 4)
}

test "an associated function that one conversion impl gives the type is a value" {
    let f: fn(Int) -> Celsius = Celsius.from
    assert_eq(f(3).v, 3)
}

test "an alias head gives a function value the alias's type arguments" {
    let e = IntStack.empty
    let s: Stack[Int] = e()
    assert_eq(s.items.len(), 0)
}
