// A user trait's impl on List may name its method like a builtin one that List does not
// have. The dotted call runs the impl's method.

trait Minehash[T] {
    fn hash(self) -> Int
}

impl[T] Minehash[T] for List[T] {
    fn hash(self) -> Int { 4242 + self.len() }
}

trait Minecmp[T] {
    fn cmp(self) -> Int
}

impl[T] Minecmp[T] for List[T] {
    fn cmp(self) -> Int { 10 * self.len() }
}

test "a user trait method named hash runs on a List" {
    let l = [1, 2, 3]
    assert_eq(l.hash(), 4245)
}

test "a user trait method named cmp runs on a List" {
    let l = ["a", "b"]
    assert_eq(l.cmp(), 20)
}
