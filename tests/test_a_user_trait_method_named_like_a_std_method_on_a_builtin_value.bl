// A user trait may declare a method that has the name of a std trait method, and implement it
// for a built-in type. No trait ranks above another (sections/03c_protocols.md *Built-in Type
// Method Dispatch*): a bound selects its trait for every type argument, and a qualified call
// names its trait. The other owner of the name never answers in its place.

trait UtShow {
    fn debug(self) -> Str
}

impl UtShow for Str {
    fn debug(self) -> Str { "mine" }
}

impl UtShow for Int {
    fn debug(self) -> Str { "mineint" }
}

trait UtCopy {
    fn clone(self) -> Int
}

impl UtCopy for Int {
    fn clone(self) -> Int { 99 }
}

trait UtHash {
    fn hash(self) -> U64
}

impl UtHash for Float {
    fn hash(self) -> U64 { 5 }
}

impl UtHash for Str {
    fn hash(self) -> U64 { 42 }
}

fn ut_show[T: UtShow](x: T) -> Str {
    x.debug()
}

fn ut_copy[T: UtCopy](x: T) -> Int {
    x.clone()
}

fn ut_user_hash[T: UtHash](x: T) -> U64 {
    x.hash()
}

fn ut_std_hash[T: Hash](x: T) -> U64 {
    x.hash()
}

fn ut_std_show[T: Debug](x: T) -> Str {
    x.debug()
}

test "a bound on the user trait runs the user method on a built-in value" {
    assert_eq(ut_show("a"), "mine")
    assert_eq(ut_show(3), "mineint")
    assert_eq(ut_copy(7), 99)
    assert_eq(ut_user_hash("a"), 42)
    assert_eq(ut_user_hash(1.5), 5)
}

test "a bound on the std trait runs the built-in method" {
    assert_eq(ut_std_hash("a"), Hash.hash("a"))
    assert(ut_std_hash("a") != 42)
    assert_eq(ut_std_show("a"), Debug.debug("a"))
    assert_eq(ut_std_show(3), "3")
}

test "a qualified call runs the method of the trait it names" {
    assert_eq(UtShow.debug("a"), "mine")
    assert_eq(UtShow.debug(3), "mineint")
    assert_eq(Debug.debug(3), "3")
    assert_eq(UtCopy.clone(7), 99)
    assert_eq(Clone.clone(7), 7)
    assert_eq(UtHash.hash("a"), 42)
}

test "the user method answers where the built-in type lacks the std trait" {
    assert_eq(1.5.hash(), 5)
}
