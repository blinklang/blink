type K {
    A {}
    B
}

type KA = K

type Mixed {
    E {}
    C(Int)
}

type Opt[T] {
    No {}
    Yes(T)
}

fn k_code(k: K) -> Int {
    match k {
        K.A { } => 1
        K.B => 2
    }
}

fn k_code_rest(k: K) -> Int {
    match k {
        K.A { .. } => 1
        K.B => 2
    }
}

fn mixed_code(m: Mixed) -> Int {
    match m {
        Mixed.E { } => 0
        Mixed.C(n) => n
    }
}

fn opt_code(o: Opt[Int]) -> Int {
    match o {
        Opt.No { } => -1
        Opt.Yes(n) => n
    }
}

fn alias_code(k: KA) -> Int {
    match k {
        KA.A { } => 1
        KA.B => 2
    }
}

test "a brace literal builds a variant declared with empty braces" {
    assert_eq(k_code(K.A { }), 1)
    assert_eq(k_code(K.B), 2)
}

test "the rest pattern matches a variant declared with empty braces" {
    assert_eq(k_code_rest(K.A { }), 1)
    assert_eq(k_code_rest(K.B), 2)
}

test "a variant declared with empty braces sits beside a variant with a payload" {
    assert_eq(mixed_code(Mixed.E { }), 0)
    assert_eq(mixed_code(Mixed.C(7)), 7)
}

test "a generic enum builds and matches its variant declared with empty braces" {
    let n: Opt[Int] = Opt.No { }
    assert_eq(opt_code(n), -1)
    assert_eq(opt_code(Opt.Yes(4)), 4)
}

test "a type alias builds and matches a variant declared with empty braces" {
    let a: KA = KA.A { }
    assert_eq(alias_code(a), 1)
    assert_eq(k_code(a), 1)
}

test "a list holds values of a variant declared with empty braces, and a match reads each" {
    let xs = [K.A { }, K.B, K.A { }]
    let mut sum = 0
    for x in xs { sum = sum + k_code(x) }
    assert_eq(sum, 4)
}
