// A qualified variant `Q.V` where `Q` is not an enum is NoSuchVariant (E0547) in a pattern and
// in an expression (sections/03_types.md §3.5 *Qualified names and the wrong type*, §3.4 *A
// variant the enum does not declare*). `blink check` and the build report the same error, and
// neither stops with an internal error. The valid neighbors of these forms still run.

import compile_test_helpers
import std.io

fn expect_e0547_alike(src: Str, tag: Str) {
    let chk = compile_test_helpers.check_via_cli(src, "{tag}_check")
    let built = compile_test_helpers.compile_and_capture(src, "{tag}_build")
    let ok = chk.contains("\"code\":\"E0547\"") && built.contains("\"code\":\"E0547\"") && !chk.contains("\"severity\":\"ice\"") && !built.contains("\"severity\":\"ice\"")
    if !ok { io.eprintln("FAIL: {tag}\ncheck:\n{chk}\nbuild:\n{built}") }
    assert(ok)
}

test "List.Zed(v) in a pattern is E0547 in check and in build" {
    expect_e0547_alike(#"fn main() {
    match [1, 2] {
        List.Zed(v) => io.println("{v}")
        _ => io.println("x")
    }
}
"#, "list_zed_pattern")
}

test "Int.Zed in a pattern is E0547 in check and in build" {
    expect_e0547_alike(#"fn main() {
    let x = 5
    match x {
        Int.Zed => io.println("a")
        _ => io.println("b")
    }
}
"#, "int_zed_pattern")
}

test "Int.Zed as a value is E0547 in check and in build" {
    expect_e0547_alike(#"fn main() {
    let y = Int.Zed
    io.println("{y}")
}
"#, "int_zed_value")
}

test "an uppercase member of a struct that declares nothing of that name is E0547" {
    expect_e0547_alike(#"type T { x: Int }

fn main() {
    let z = T.NOPE
    io.println("{z.x}")
}
"#, "struct_upper_member")
}

test "the valid neighbors run: a real variant, a carrier and a static call" {
    let r = compile_test_helpers.compile_and_run(#"type Color { Red, Green }

fn name(c: Color) -> Str {
    match c {
        Color.Red => "red"
        Color.Green => "green"
    }
}

fn main() {
    let xs: List[Int] = List.new()
    let o = Option.Some(2)
    let n = match o {
        Option.Some(v) => v
        Option.None => 0
    }
    io.println("{name(Color.Green)} {xs.len()} {n}")
}
"#, "no_variants_neighbors")
    if r.exit_code != 0 || r.out.trim() != "green 0 2" { io.eprintln("FAIL: exit {r.exit_code}\n{r.out}\n{r.err_out}") }
    assert_eq(r.out.trim(), "green 0 2")
}
