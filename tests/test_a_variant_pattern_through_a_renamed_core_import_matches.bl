// A renamed core import names the builtin (sections/07_trust_modules_metadata.md §10.6), so a
// variant written through it, in a pattern or as a value, is that builtin's variant.
import blink.core.{Option as Opt}

fn f(o: Option[Int]) -> Int {
    match o {
        Opt.Some(v) => v
        Opt.None => 0
    }
}

test "a variant pattern through a renamed core import matches" {
    assert_eq(f(Some(3)), 3)
    assert_eq(f(None), 0)
    assert_eq(f(Opt.Some(4)), 4)
    assert_eq(f(Opt.None), 0)
}
