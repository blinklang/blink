// An alias and its target are one type, so a variant can be named through an alias of its
// enum (sections/03_types.md, dotted heads). The value has the target's type at the alias's
// arguments.

import compile_test_helpers.{compile_and_capture, run_xmod}

type K {
    A
    B
}
type KA = K
type KC2 = KC3
type KC3 = K

type Shape {
    Circle(r: Float, sides: Int)
    Rect { w: Int, h: Int }
    Dot
}
type ShapeAlias = Shape

type E[T] {
    L(T)
    Rec { v: T }
    N
}
type AV[X] = E[X]
type ChainV[X] = AV[X]

type Pick[A, B] {
    One(A)
    Two(B)
    Neither
}
type P = Pick[Int, Str]
type Partial[X] = Pick[Int, X]
type Swapped[X, Y] = Pick[Y, X]
type Same[X] = Pick[X, X]

type OI = Option[Int]
type O[X] = Option[X]
type RI = Result[Int, Str]
type R[X] = Result[X, Str]
type OS = Option[I32]

trait Tr {
    fn tr(self) -> Int
}
type Good {
    x: Int
}
impl Tr for Good {
    fn tr(self) -> Int {
        self.x
    }
}
type Bd[T: Tr] {
    Holds(T)
    Empty
}
type BdA[X: Tr] = Bd[X]

fn name_k(k: K) -> Str {
    match k {
        K.A => "a"
        K.B => "b"
    }
}

fn takes_int_e(e: E[Int]) -> Int {
    match e {
        E.L(v) => v
        E.Rec { v } => v
        E.N => -1
    }
}

fn returns_open() -> E[Str] {
    AV.N
}

test "a unit variant through a plain alias and an alias chain" {
    assert_eq(name_k(KA.A), "a")
    assert_eq(name_k(KC2.B), "b")
    let k: KA = KA.B
    assert_eq(name_k(k), "b")
}

test "a payload, brace and unit variant through an alias of a plain enum" {
    let c = ShapeAlias.Circle(1.5, 2)
    let r = ShapeAlias.Rect { w: 3, h: 4 }
    let total = match c {
        Shape.Circle(_, s) => s
        _ => 0
    } + match r {
        Shape.Rect { w, h } => w * h
        _ => 0
    }
    assert_eq(total, 14)
    let dot: Shape = ShapeAlias.Dot
    let is_dot = match dot {
        ShapeAlias.Dot => true
        _ => false
    }
    assert(is_dot)
}

test "a payload variant through a generic alias takes its argument from the value" {
    assert_eq(takes_int_e(AV.L(1)), 1)
    assert_eq(takes_int_e(ChainV.L(2)), 2)
    let v = AV.L(3)
    assert_eq(takes_int_e(v), 3)
    assert_eq(takes_int_e(AV.Rec { v: 4 }), 4)
}

test "an expected type settles a unit variant through a generic alias" {
    let x: E[Int] = AV.N
    assert_eq(takes_int_e(x), -1)
    assert_eq(takes_int_e(AV.N), -1)
    let y: AV[Str] = AV.N
    let z = returns_open()
    let same = match (y, z) {
        (E.N, E.N) => true
        _ => false
    }
    assert(same)
}

test "an alias that fixes an argument gives the value that argument" {
    let a = P.One(1)
    let b = P.Two("s")
    let c: Pick[Int, Str] = P.Neither
    let n = P.Neither
    let got = match a {
        Pick.One(i) => i
        _ => 0
    }
    assert_eq(got, 1)
    let s = match b {
        Pick.Two(t) => t
        _ => ""
    }
    assert_eq(s, "s")
    let none_c = match c {
        Pick.Neither => true
        _ => false
    }
    assert(none_c)
    let none_n = match n {
        Pick.Neither => 1
        Pick.One(i) => i
        Pick.Two(_) => 2
    }
    assert_eq(none_n, 1)
}

test "an alias that fixes one argument and reorders the others" {
    let p: Pick[Int, Str] = Partial.Two("x")
    let q: Pick[Int, Str] = Partial.Neither
    let sw: Pick[Bool, Str] = Swapped.Two("y")
    let dup: Pick[Int, Int] = Same.One(1)
    let got = match p {
        Pick.Two(t) => t
        _ => ""
    }
    assert_eq(got, "x")
    let is_none = match q {
        Pick.Neither => true
        _ => false
    }
    assert(is_none)
    let got2 = match sw {
        Pick.Two(t) => t
        _ => ""
    }
    assert_eq(got2, "y")
    let got3 = match dup {
        Pick.One(i) => i
        _ => 0
    }
    assert_eq(got3, 1)
}

test "the carriers through an alias" {
    let a = OI.Some(1)
    assert_eq(a.unwrap(), 1)
    let n = OI.None
    assert(n.is_none())
    let g = O.Some("g")
    assert_eq(g.unwrap(), "g")
    let gn: Option[Str] = O.None
    assert(gn.is_none())
    let ok = RI.Ok(1)
    assert_eq(ok.unwrap(), 1)
    let err = RI.Err("bad")
    assert(err.is_err())
    let rok: Result[Bool, Str] = R.Ok(true)
    assert(rok.unwrap())
    let lit = OS.Some(7)
    assert_eq(lit.unwrap().to_int(), 7)
}

test "an argument that has the enum's bound builds through an alias" {
    let h = BdA.Holds(Good { x: 5 })
    let got = match h {
        Bd.Holds(g) => g.tr()
        Bd.Empty => 0
    }
    assert_eq(got, 5)
    let e: Bd[Good] = BdA.Empty
    let empty = match e {
        Bd.Empty => true
        _ => false
    }
    assert(empty)
}

let DECLS = "type Pick[A, B] \{\n    One(A)\n    Two(B)\n    Neither\n\}\ntype P = Pick[Int, Str]\ntype Partial[X] = Pick[Int, X]\ntype Same[X] = Pick[X, X]\ntype Rec[A, B] \{\n    Both \{ a: A, b: B \}\n    Nope\n\}\ntype RP = Rec[Int, Str]\ntype RS[X] = Rec[X, X]\ntype OI = Option[Int]\ntype RI = Result[Int, Str]\ntype E[T] \{\n    L(T)\n    N\n\}\ntype AV[X] = E[X]\ntype Shape \{\n    Circle(r: Float, sides: Int)\n\}\ntype SA = Shape\n"

fn in_main(body: Str) -> Str {
    "{DECLS}fn main() \{\n    {body}\n\}\n"
}

fn count(output: Str, code: Str) -> Int {
    output.split("\"code\":\"{code}\"").len() - 1
}

test "a payload is held to the arguments an alias fixes" {
    let out = compile_and_capture(in_main("let _x = P.One(\"s\")"), "_alias_fixed_payload")
    assert(out.contains("\"code\":\"E0300\""), out)
    let out2 = compile_and_capture(in_main("let _x = Partial.One(\"s\")"), "_alias_partial_payload")
    assert(out2.contains("\"code\":\"E0300\""), out2)
}

test "two payloads of one alias parameter must agree" {
    let out = compile_and_capture(in_main("let _x = Same.One(1)\n    let _y: Pick[Int, Str] = Same.One(1)"), "_alias_same_join")
    assert(out.contains("\"code\":\"E0300\""), out)
    let brace = compile_and_capture(in_main("let _x = RS.Both \{ a: 1, b: \"s\" \}"), "_alias_same_brace")
    assert(brace.contains("\"code\":\"E0300\""), brace)
}

test "a brace field is held to the arguments an alias fixes" {
    let out = compile_and_capture(in_main("let _x = RP.Both \{ a: \"s\", b: \"t\" \}"), "_alias_fixed_brace")
    assert(out.contains("\"code\":\"E0300\""), out)
}

test "a carrier payload is held to the arguments an alias fixes" {
    let some = compile_and_capture(in_main("let _x = OI.Some(\"s\")"), "_alias_some")
    assert(some.contains("\"code\":\"E0300\""), some)
    let ok = compile_and_capture(in_main("let _x = RI.Ok(\"s\")"), "_alias_ok")
    assert(ok.contains("\"code\":\"E0300\""), ok)
    let err = compile_and_capture(in_main("let _x = RI.Err(1)"), "_alias_err")
    assert(err.contains("\"code\":\"E0300\""), err)
    let unit = compile_and_capture(in_main("let _x = RI.Ok()"), "_alias_ok_unit")
    assert(unit.contains("\"code\":\"E0300\""), unit)
}

test "a type parameter named like an alias of a carrier has no variants" {
    let out = compile_and_capture("type T = Option[Int]\nfn f[T](x: T) -> Option[Int] \{\n let _ = x\n T.Some(1)\n\}\nfn main() \{ let _ = f(1) \}\n", "_tparam_alias_carrier_call")
    assert(out.contains("NoSuchVariant"), out)
    assert(!out.contains("\"severity\":\"ice\""), out)
}

test "a type parameter named like an alias has no unit variant" {
    let out = compile_and_capture("type T = Option[Int]\nfn f[T](x: T) -> Option[Int] \{\n let _ = x\n T.None\n\}\nfn main() \{ let _ = f(1) \}\n", "_tparam_alias_carrier_none")
    assert(out.contains("NoSuchVariant"), out)
    assert(!out.contains("\"severity\":\"ice\""), out)
}

test "a pattern head named like a type parameter does not read an alias" {
    let out = compile_and_capture("type OI = Option[Int]\nfn f[OI](y: OI, x: Option[Int]) -> Int \{\n let _ = y\n match x \{\n  OI.Some(v) => v\n  OI.None => 0\n \}\n\}\nfn main() \{ let _ = f(1, Some(2)) \}\n", "_tparam_alias_pattern")
    assert(out.contains("error"), out)
    assert(!out.contains("\"severity\":\"ice\""), out)
}

test "a variant the target does not have is NoSuchVariant through an alias" {
    let out = compile_and_capture(in_main("let _x = OI.Ok(1)"), "_alias_carrier_other")
    assert(out.contains("NoSuchVariant"), out)
}

test "the count and labels of a payload are checked through an alias" {
    let many = compile_and_capture(in_main("let _x = SA.Circle(1.0)"), "_alias_payload_count")
    assert(many.contains("\"code\":\"E0300\""), many)
    let label = compile_and_capture(in_main("let _x = SA.Circle(1.0, radius: 2)"), "_alias_payload_label")
    assert(label.contains("\"code\":\"E0525\""), label)
}

test "a unit variant through a generic alias with no source for its argument is E0301" {
    let out = compile_and_capture(in_main("let _x = AV.N"), "_alias_open_unit")
    assert_eq(count(out, "E0301"), 1, out)
}

test "a variant through an alias another module declares, by each spelling" {
    let helper = #"
pub type K {
    A
    B(Int)
}
pub type KA = K
pub type E[T] {
    L(T)
    N
    Br { v: T }
}
pub type AV[X] = E[X]
pub type OI = Option[Int]
"#
    let entry = #"
import std.io
import shapes.kinds.{K as Kay, KA as KayA, AV as Av2, E, OI}

type Local = Kay
type ThroughRename = KayA
type RenamedOfG = Av2[Str]
type G[X] = E[X]

fn wrap[T](x: T) -> E[T] {
    Av2.L(x)
}

fn choose[T](x: T) -> E[T] {
    if false { Av2.N } else { G.L(x) }
}

fn main() {
    let a = KayA.A
    let b = KayA.B(2)
    let c = Local.A
    let through_rename = ThroughRename.A
    let renamed_alias_of_generic = RenamedOfG.L("r")
    let d: E[List[Int]] = Av2.L([])
    let h = OI.Some(1)
    let i = Av2.Br { v: 1 }
    let j = Av2.L("x")
    match b {
        Kay.B(z) => io.println("{z}")
        _ => io.println("no")
    }
    match through_rename {
        Kay.A => io.println("through")
        _ => io.println("no")
    }
    match renamed_alias_of_generic {
        E.L(v) => io.println(v)
        _ => io.println("no")
    }
    match a {
        Kay.A => io.println("a")
        _ => io.println("no")
    }
    match c {
        Kay.A => io.println("c")
        _ => io.println("no")
    }
    match d {
        E.L(xs) => io.println("{xs.len()}")
        _ => io.println("no")
    }
    match wrap(3) {
        E.L(v) => io.println("{v}")
        _ => io.println("no")
    }
    match choose("t") {
        E.L(v) => io.println(v)
        _ => io.println("no")
    }
    io.println("{h.unwrap()}")
    match i {
        E.Br { v } => io.println("{v}")
        _ => io.println("no")
    }
    match j {
        E.L(v) => io.println(v)
        _ => io.println("no")
    }
}
"#
    let r = run_xmod(entry, "shapes", "kinds", helper, "variant_through_alias_xmod")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "2\nthrough\nr\na\nc\n0\n3\nt\n1\n1\nx\n")
}
