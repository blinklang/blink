// A where clause whose subject is a type (§3.6) builds and runs: the bound on the impl's own type
// gives its trait in the body, and so does a bound on another type, at that type.

trait Sh {
    fn sh(self) -> Int
}

type Sw[T] {
    v: T
}

impl[T: Eq] Sh for Sw[T] {
    fn sh(_self) -> Int { 10 }
}

type Bx[T] {
    v: T
}

impl[T: Eq] Sh for Bx[T] {
    fn sh(_self) -> Int { 20 }
}

trait Tot {
    fn tot(self) -> Int
}

impl[T] Tot for Sw[T] where Sw[T]: Sh {
    fn tot(self) -> Int { self.sh() + 1 }
}

trait Ck {
    fn chk(self) -> Int
}

impl[T] Ck for Sw[T] where Bx[T]: Sh {
    fn chk(self) -> Int { Bx { v: self.v }.sh() + 2 }
}

test "a bound on the impl's own type gives its trait in the body" {
    assert_eq(Sw { v: 1 }.tot(), 11)
    assert_eq(Sw { v: "a" }.tot(), 11)
}

test "a bound on another type gives its trait at that type in the body" {
    assert_eq(Sw { v: 3 }.chk(), 22)
}
