// ajnk77 -- archive-resident runtime trap sites must be catchable by assert_panics.
//
// Trap sites in bootstrap/runtime_core.h used to gate their catchable dispatch
// behind `#ifdef BLINK_TEST_BUILD`. The stdlib archive monolith compiles WITHOUT
// that macro, so a panic reached through an archive-resident helper would always
// `fprintf;exit(1)` and escape an armed assert_panics, killing the test process.
//
// Real emit-site test: compile a fixture whose test body arms assert_panics over
// an out-of-bounds `[Int].set`, which lowers to the archive-resident
// `blink_list_set` trap (no inline bounds guard in codegen). Run the test binary
// and assert the runner reports a pass -- i.e. the trap was caught, not fatal.
// (`.pop()` on empty is codegen-guarded and returns None, so it does NOT reach
// the archive trap -- `.set` out of bounds is the correct vehicle.)

import compile_test_helpers.{compile_and_run_test_json}

test "archive-resident list-set trap is catchable by assert_panics" {
    let src = "test \"t\" \{\n    assert_panics(matching: \"out of bounds\") \{\n        let mut xs: [Int] = []\n        xs.set(99, 0)\n    }\n}\n"
    let r = compile_and_run_test_json(src, "_ajnk77_set")
    assert(r.out.contains("\"status\":\"pass\""))
}
