// Two alias shapes as a struct field's declared type: a forward-referencing
// scalar alias chain (NodeId -> RawId -> Int), and a container-erasing alias
// (IntList -> List[Int]). Both sides of each chain are valid types; the field
// must resolve to the alias's underlying C type either way.

type NodeId = RawId
type RawId = Int
type Wrap { id: NodeId }

type IntList = List[Int]
type Box { items: IntList }

test "forward-referencing scalar alias chain resolves as a struct field type" {
    let w = Wrap { id: 5 }
    assert_eq(w.id, 5)
}

test "container-erasing alias resolves as a struct field type" {
    let b = Box { items: [1, 2, 3] }
    assert_eq(b.items.len(), 3)
    assert_eq(b.items.get(1).unwrap(), 2)
}
