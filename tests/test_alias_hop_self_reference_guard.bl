// tc_resolve_transparent_alias_name (src/typecheck.bl, introduced fixing an alias-hop gap
// found while retiring arg_tids_match_mono_args, br jefm9w) bounds an alias-of-alias chain
// to 8 hops and refuses to chase a forward-declared alias's orphaned TK_TYPEVAR placeholder.
// Neither guard catches a direct self-alias (`type A = A`): register_struct_type inserts A's
// own name into named_type_map before resolving its RHS, so by the time the RHS is fully
// processed, "A"'s underlying resolves to a REAL, already-registered tid identical to A's own
// tid — not a TK_TYPEVAR placeholder. Without an explicit self-reference check, cur_name never
// advances and the caller's self-recursion on the "resolved" tid would recurse on an unchanged
// input with no bound. A genuine multi-name cycle (`type A = B; type B = A`) does not have this
// problem: whichever name is declared first forward-references the other before it exists,
// which mints the orphan TK_TYPEVAR the existing poison check already catches within one hop.
//
// This pins that the compiler TERMINATES on a direct self-alias — it does not assert the
// program compiles cleanly (a self-alias's own top-level typedef emission is the separate,
// already-filed br fht44j), only that resolving it does not hang or crash the compiler itself.

import compile_test_helpers

test "self-referential type alias terminates instead of recursing without bound" {
    let mut s = "type A = A\n"
    s = s.concat("type Wrap \{ id: A }\n")
    s = s.concat("fn main() \{\n")
    s = s.concat("    let w = Wrap \{ id: 5 }\n")
    s = s.concat("}\n")
    // The point of this assertion is that compile_and_emit_c RETURNS at all: a regression
    // that removes the self-reference guard would make the underlying blinkc process spin
    // forever inside tc_resolve_transparent_alias_name's caller, hanging this test instead
    // of failing it.
    let _c = compile_test_helpers.compile_and_emit_c(s, "selfalias_terminates")
}
