// A type alias is transparent: an alias to a carrier or generic instance must
// lower to the concrete C type (blink_Option_Box_0Int, blink_list*,
// blink_Box_0Int), not the bare erased base whose mono args are dropped.

type Box[T] {
    val: T
}

type MB = Option[Box[Int]]
type RB = Result[Box[Int], Str]
type LI = List[Box[Int]]
type BI = Box[Int]

type H {
    items: List[MB]
}

type HV {
    m: MB
}

type HI {
    b: BI
}

type EW {
    Wrap(o: MB)
    Empty
}

type MB2 = MB

type HC {
    m: MB2
}

fn carrier_alias_field() -> Int {
    let h = H { items: [Some(Box { val: 4 })] }
    h.items.get(0).unwrap().unwrap().val
}

fn option_alias_param(x: MB) -> Int {
    x.unwrap().val
}

fn result_alias_param(x: RB) -> Int {
    x.unwrap().val
}

fn list_alias_param(xs: LI) -> Int {
    xs.get(0).unwrap().val
}

fn instance_alias_param(b: BI) -> Int {
    b.val
}

test "alias of Option carrier survives as a field element" {
    assert_eq(carrier_alias_field(), 4)
}

test "alias of Option carrier round-trips as a param" {
    assert_eq(option_alias_param(Some(Box { val: 6 })), 6)
}

test "alias of Result carrier round-trips as a param" {
    assert_eq(result_alias_param(Ok(Box { val: 7 })), 7)
}

test "alias of List carrier round-trips as a param" {
    assert_eq(list_alias_param([Box { val: 8 }]), 8)
}

test "alias of a generic-struct instance round-trips as a param" {
    assert_eq(instance_alias_param(Box { val: 9 }), 9)
}

fn byvalue_carrier_field() -> Int {
    let h = HV { m: Some(Box { val: 11 }) }
    h.m.unwrap().val
}

fn byvalue_instance_field() -> Int {
    let h = HI { b: Box { val: 12 } }
    h.b.val
}

fn variant_payload_alias() -> Int {
    let e = EW.Wrap(Some(Box { val: 13 }))
    match e {
        Wrap(o) => o.unwrap().val
        Empty => 0
    }
}

test "by-value Option-carrier alias field round-trips" {
    assert_eq(byvalue_carrier_field(), 11)
}

test "by-value generic-instance alias field round-trips" {
    assert_eq(byvalue_instance_field(), 12)
}

test "compound-alias enum variant payload round-trips" {
    assert_eq(variant_payload_alias(), 13)
}

fn chained_alias_field() -> Int {
    let h = HC { m: Some(Box { val: 14 }) }
    h.m.unwrap().val
}

test "chained alias to a compound carrier round-trips as a by-value field" {
    assert_eq(chained_alias_field(), 14)
}

type MI = Option[Int]

type G[T] {
    tag: T
    m: MI
}

type EG[T] {
    Hold(tag: T, o: MI)
    Vacant
}

type HR {
    r: RB
}

fn generic_struct_alias_field() -> Int {
    let g = G { tag: 1, m: Some(15) }
    g.m.unwrap()
}

fn generic_enum_alias_payload() -> Int {
    let e = EG.Hold(1, Some(16))
    match e {
        Hold(_tag, o) => o.unwrap()
        Vacant => 0
    }
}

fn byvalue_result_field() -> Int {
    let h = HR { r: Ok(Box { val: 17 }) }
    h.r.unwrap().val
}

test "carrier alias field inside a generic struct round-trips" {
    assert_eq(generic_struct_alias_field(), 15)
}

test "carrier alias payload inside a generic enum round-trips" {
    assert_eq(generic_enum_alias_payload(), 16)
}

test "by-value Result-carrier alias field round-trips" {
    assert_eq(byvalue_result_field(), 17)
}

type MA = Map[Int, Int]
type SA = Set[Int]
type TA = (Int, Int)

type HM { m: MA }
type HS { s: SA }
type HT { t: TA }

fn map_alias_field() -> Int {
    let mut mm = Map()
    mm.insert(1, 42)
    let h = HM { m: mm }
    h.m.get(1).unwrap()
}

fn set_alias_field() -> Int {
    let mut ss = Set()
    ss.insert(9)
    let h = HS { s: ss }
    if h.s.contains(9) { 1 } else { 0 }
}

fn tuple_alias_field() -> Int {
    let h = HT { t: (5, 7) }
    let tt = h.t
    tt.1
}

test "by-value Map-carrier alias field round-trips" {
    assert_eq(map_alias_field(), 42)
}

test "by-value Set-carrier alias field round-trips" {
    assert_eq(set_alias_field(), 1)
}

test "by-value Tuple alias field round-trips" {
    assert_eq(tuple_alias_field(), 7)
}
