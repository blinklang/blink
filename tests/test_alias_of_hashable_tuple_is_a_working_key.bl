// A type alias names the same type as its target, so an alias of a tuple whose elements are
// all hashable is a Map key and a Set element with no derive (sections/03_types.md, *Hash
// Contract and Seeding*). The key check used to read the alias's own name and refuse it.
import std.io

type Coord = (Int, Str)

fn main() {
    let mut m: Map[Coord, Int] = Map.new()
    m.insert((1, "a"), 10)
    m.insert((2, "a"), 20)
    m.insert((1, "a"), 11)
    assert_eq(m.len(), 2)
    assert_eq(m.get((1, "a")) ?? 0, 11)
    assert_eq(m.get((2, "a")) ?? 0, 20)
    assert_eq(m.get((1, "b")) ?? -1, -1)

    let mut s: Set[Coord] = Set.new()
    s.insert((3, "x"))
    s.insert((3, "x"))
    s.insert((4, "x"))
    assert_eq(s.len(), 2)
    assert(s.contains((3, "x")))
    assert(!s.contains((3, "y")))

    let k: Coord = (2, "a")
    io.println("{m.get(k) ?? 0} {s.len()}")
}
