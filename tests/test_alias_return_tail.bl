// A function whose declared return type is a type alias to a struct or enum,
// with a struct-literal or enum-variant tail, must emit a `return`: the alias
// is transparent, so `-> PT` (type PT = Point) returns a struct body exactly
// like `-> Point`. The tail-return decision resolved is_struct_type on the raw
// alias name and so dropped the constructed value as a bare statement.

type Point { x: Int y: Int }
type PT = Point
type PT2 = PT

type Color { Red Green Blue }
type CL = Color

type Pair = (Int, Int)

fn mk() -> PT { Point { x: 1, y: 2 } }
fn mk_chained() -> PT2 { Point { x: 3, y: 4 } }
fn col() -> CL { Color.Green }
fn pair() -> Pair { (5, 7) }

fn color_num(c: Color) -> Int {
    match c {
        Red => 0
        Green => 2
        Blue => 3
    }
}

test "alias-to-struct return with struct-literal tail emits return" {
    assert_eq(mk().x, 1)
}

test "alias-to-struct return keeps the second field" {
    assert_eq(mk().y, 2)
}

test "chained alias-to-struct return with struct-literal tail" {
    assert_eq(mk_chained().x, 3)
}

test "alias-to-enum return with variant tail emits return" {
    assert_eq(color_num(col()), 2)
}

test "alias-to-tuple return with tuple tail emits return" {
    let p = pair()
    assert_eq(p.1, 7)
}
