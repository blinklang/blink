// A type alias must be transparent regardless of declaration order: an alias
// whose target type or generic instance is declared textually AFTER the alias
// must lower identically to the target-before case. Type information flows both
// forward and backward (spec §3), so a forward reference is well-formed. The
// alias C-type resolution for signatures and the generic-instance registration
// ran before the target's typedef was available when the target came later,
// erasing a param to `void` (MVCE1) or reaching mono with an unsolved tparam
// (MVCE2).

type MB = Option[Point]
type Point { x: Int }

type MBox = Option[Box[Int]]
type Box[T] { val: T }

type RP = Result[Later, Str]
type Later { n: Int }

fn opt_point_param(m: MB) -> Int { m.unwrap().x }
fn opt_box_param(m: MBox) -> Int { m.unwrap().val }
fn result_param(r: RP) -> Int { r.unwrap().n }

fn make_opt_point() -> MB { Some(Point { x: 7 }) }
fn make_opt_box() -> MBox { Some(Box { val: 8 }) }

test "alias to Option[struct] with target declared after lowers the param" {
    assert_eq(opt_point_param(Some(Point { x: 5 })), 5)
}

test "alias to Option[generic-instance] with target declared after lowers the param" {
    assert_eq(opt_box_param(Some(Box { val: 9 })), 9)
}

test "alias to Result[struct] with target declared after lowers the param" {
    assert_eq(result_param(Ok(Later { n: 11 })), 11)
}

// Let-bound so the return-type resolution is exercised without also hitting the
// orthogonal call-expression-result-type erasure of an alias-carrier return that
// is immediately method-chained (pre-existing, fails target-before too; tracked
// separately).
test "alias with target declared after round-trips as a return type" {
    let m = make_opt_point()
    assert_eq(m.unwrap().x, 7)
}

test "alias to generic-instance with target after round-trips as a return type" {
    let m = make_opt_box()
    assert_eq(m.unwrap().val, 8)
}
