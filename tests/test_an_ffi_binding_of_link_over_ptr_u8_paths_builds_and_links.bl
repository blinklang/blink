// `link` comes from unistd.h, which the prologue of every unit includes, and that header
// declares it over `const char*`. A binding that takes the paths as `Ptr[U8]`, the form
// section 9.1 gives for a C string, must call it under that prototype, not write a second one.

import compile_test_helpers

@ffi("link", header: "unistd.h")
@trusted(audit: "TEST-LINK")
fn c_link(from: Ptr[U8], to: Ptr[U8]) -> I32 ! FS.Write {}

test "link through Ptr[U8] paths makes a second name for the file" {
    let dir = "{compile_test_helpers.scratch_root()}/ffi_link_{getpid()}"
    process.run("sh", ["-c", "rm -rf {dir} && mkdir -p {dir}"]).unwrap()
    fs.write("{dir}/a", "x").unwrap()
    let mut rc = -1
    with ffi.scope() as scope {
        rc = c_link(scope.cstr("{dir}/a"), scope.cstr("{dir}/b")).to_int()
    }
    assert_eq(rc, 0)
    assert_eq(fs.read("{dir}/b").unwrap(), "x")
    process.run("sh", ["-c", "rm -rf {dir}"]).unwrap()
}
