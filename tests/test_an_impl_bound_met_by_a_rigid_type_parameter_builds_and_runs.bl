// A type parameter that holds an impl's bound (written on the binder, in an impl's where clause,
// or given through a supertrait) meets that bound at a method call, a trait-qualified call, a
// with-item, and a callee bound met through a polymorphic impl (§3.6 Trait Bounds). Each form
// builds and runs.

trait Shown {
    fn shown(self) -> Int
}

trait Tag {
    fn tag(self) -> Int
}

trait Loud: Tag {
    fn loud(self) -> Int
}

impl Tag for Int {
    fn tag(self) -> Int { self }
}

impl Loud for Int {
    fn loud(self) -> Int { self * 10 }
}

type Bx[T] { v: T }

type Cx[T] { v: T }

type Dx[T] { v: T }

impl[T: Ord] Shown for Bx[T] {
    fn shown(self) -> Int { if self.v < self.v { 1 } else { 2 } }
}

impl[T: Tag] Shown for Cx[T] {
    fn shown(self) -> Int { self.v.tag() }
}

impl[T] Shown for Dx[T] where T: Eq {
    fn shown(self) -> Int { if self.v == self.v { 3 } else { 4 } }
}

impl[T: Tag] Closeable for Bx[T] {
    fn close(self) { let _t = self.v.tag() }
}

trait Same {
    fn same(self) -> Bool
}

impl[T: Eq] Same for List[T] {
    fn same(self) -> Bool {
        match (self.get(0), self.get(1)) {
            (Some(a), Some(b)) => a == b
            _ => true
        }
    }
}

fn all_same[X: Same](x: X) -> Bool { x.same() }

fn inline_ord[T: Ord](x: T) -> Int { Bx { v: x }.shown() }

fn inline_tag[T: Tag](x: T) -> Int { Cx { v: x }.shown() }

fn inline_qualified[T: Ord](x: T) -> Int { Shown.shown(Bx { v: x }) }

fn inline_callee[T: Eq](x: List[T]) -> Bool { all_same(x) }

fn inline_with[U: Tag](u: U) -> Int {
    with Bx { v: u } {
        let _n = 0
    }
    5
}

fn super_tag[T: Loud](x: T) -> Int { Cx { v: x }.shown() }

fn super_eq[T: Ord](x: T) -> Int { Dx { v: x }.shown() }

fn super_callee[T: Ord](x: List[T]) -> Bool { all_same(x) }

fn super_with[U: Loud](u: U) -> Int {
    with Bx { v: u } {
        let _n = 0
    }
    6
}

trait Run {
    fn run(self) -> Int
}

type W[T] { v: T, l: List[T] }

impl[T] Run for W[T] where T: Ord + Tag {
    fn run(self) -> Int {
        let s = if all_same(self.l) { 100 } else { 200 }
        with Bx { v: self.v } {
            let _n = 0
        }
        s + Bx { v: self.v }.shown() + Cx { v: self.v }.shown() + Dx { v: self.v }.shown()
    }
}

test "a bound written on the binder meets the impl's bound at each path" {
    assert_eq(inline_ord(7), 2)
    assert_eq(inline_tag(7), 7)
    assert_eq(inline_qualified("a"), 2)
    assert_eq(inline_callee([1, 1]), true)
    assert_eq(inline_callee(["a", "b"]), false)
    assert_eq(inline_with(8), 5)
}

test "a bound that gives the impl's bound through a supertrait meets it at each path" {
    assert_eq(super_tag(9), 9)
    assert_eq(super_eq(9), 3)
    assert_eq(super_callee([2, 3]), false)
    assert_eq(super_with(4), 6)
}

test "a bound in an impl's where clause meets the impl's bound at each path" {
    assert_eq(W { v: 5, l: [1, 1] }.run(), 100 + 2 + 5 + 3)
}
