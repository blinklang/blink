// An import binds its qualifier (§10.1) and the name `trace` is not reserved (§8.15.7), so in a
// file that imports a module named `trace`, `trace.log` calls that module's `log`, with any
// channel on or off, and never writes a `[trace:...]` line.

import compile_test_helpers
import std.process.{ProcessResult}

let TRACE_MODULE = #"pub fn log(ch: Str, msg: Str) {
    io.eprintln("module {ch} {msg}")
}
"#

let MAIN = #"import trace

fn main() {
    trace.log("c", "x")
}
"#

// Builds the package and runs it with BLINK_TRACE_CHANNELS set to `channels`, or unset for "".
fn build_and_run(tag: Str, channels: Str) -> ProcessResult ! FS.Write, Process.Spawn, Env.Read {
    let root = "{compile_test_helpers.scratch_root()}/{tag}"
    compile_test_helpers.sh("mkdir -p {root}/src")
    fs.write("{root}/blink.toml", "[package]\nname = \"{tag}\"\nversion = \"0.1.0\"\n").unwrap()
    fs.write("{root}/src/trace.bl", TRACE_MODULE).unwrap()
    fs.write("{root}/src/main.bl", MAIN).unwrap()
    let bin = "{root}/main_bin"
    let b = process.run("build/blink", ["build", "{root}/src/main.bl", "-o", bin]).unwrap()
    assert(b.success(), "{b.out}{b.err_out}")
    let args = if channels == "" { ["-u", "BLINK_TRACE_CHANNELS", bin] } else { ["BLINK_TRACE_CHANNELS={channels}", bin] }
    let r = process.run("env", args).unwrap()
    compile_test_helpers.sh("rm -rf {root}")
    r
}

test "trace.log calls the imported module's log with its channel off" {
    let r = build_and_run("imported_trace_module_off", "")
    assert(r.success(), r.err_out)
    assert_eq(r.err_out, "module c x\n")
}

test "trace.log calls the imported module's log with its channel on" {
    let r = build_and_run("imported_trace_module_on", "c")
    assert(r.success(), r.err_out)
    assert_eq(r.err_out, "module c x\n")
}
