// An import binds its qualifier (§10.1) and the name `trace` is not reserved (§8.15.7), so in a
// file that imports a module named `trace`, `trace.log` calls that module's `log`, with any
// channel on or off, and never writes a `[trace:...]` line.

import compile_test_helpers
import std.process.{ProcessResult}

let TRACE_MODULE = #"pub fn log(ch: Str, msg: Str) {
    io.eprintln("module {ch} {msg}")
}
"#

let MAIN = #"import trace

fn main() {
    trace.log("c", "x")
}
"#

// Builds the package into its own scratch directory and gives the path of the binary.
fn build(tag: Str) -> Str ! FS.Write, Process.Spawn, Env.Read {
    let root = "{compile_test_helpers.scratch_root()}/{tag}"
    compile_test_helpers.sh("mkdir -p {root}/src")
    fs.write("{root}/blink.toml", "[package]\nname = \"{tag}\"\nversion = \"0.1.0\"\n").unwrap()
    fs.write("{root}/src/trace.bl", TRACE_MODULE).unwrap()
    fs.write("{root}/src/main.bl", MAIN).unwrap()
    let bin = "{root}/main_bin"
    let b = process.run("build/blink", ["build", "{root}/src/main.bl", "-o", bin]).unwrap()
    assert(b.success(), "{b.out}{b.err_out}")
    bin
}

test "trace.log calls the imported module's log with its channel off and on" {
    let bin = build("imported_trace_module")
    let off: ProcessResult = process.run("env", ["-u", "BLINK_TRACE_CHANNELS", bin]).unwrap()
    assert(off.success(), off.err_out)
    assert_eq(off.err_out, "module c x\n")
    let on: ProcessResult = process.run("env", ["BLINK_TRACE_CHANNELS=c", bin]).unwrap()
    assert(on.success(), on.err_out)
    assert_eq(on.err_out, "module c x\n")
    compile_test_helpers.sh("rm -rf {compile_test_helpers.scratch_root()}/imported_trace_module")
}
