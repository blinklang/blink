// An import binds its qualifier (§10.1) and the name `trace` is not reserved (§8.15.7), so in a
// file that imports a module named `trace`, `trace.log` calls that module's `log`, with any
// channel on or off, and never writes a `[trace:...]` line.

import compile_test_helpers
import std.process.{ProcessResult}

let TRACE_MODULE = #"pub fn log(ch: Str, msg: Str) ! IO.Eprint {
    io.eprintln("module {ch} {msg}")
}
"#

let MAIN = #"import trace

fn main() {
    trace.log("c", "x")
}
"#

test "trace.log calls the imported module's log with its channel off and on" {
    let tag = "imported_trace_module"
    let bin = compile_test_helpers.build_bin_xmod(MAIN, "trace", TRACE_MODULE, tag)
    let off: ProcessResult = process.run("env", ["-u", "BLINK_TRACE_CHANNELS", bin]).unwrap()
    assert(off.success(), off.err_out)
    assert_eq(off.err_out, "module c x\n")
    let on: ProcessResult = process.run("env", ["BLINK_TRACE_CHANNELS=c", bin]).unwrap()
    assert(on.success(), on.err_out)
    assert_eq(on.err_out, "module c x\n")
    compile_test_helpers.clean_bin(tag)
}
