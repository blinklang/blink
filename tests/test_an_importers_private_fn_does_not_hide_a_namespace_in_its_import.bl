// A module sees only its own scope, so a private `fn process` or `fn env` in the file that
// imports it leaves `process.run` and `env.var` the built-ins inside the imported module.

import compile_test_helpers
import std.process.{ProcessResult}

let PROCESS_HELPER = #"pub fn ok() -> Bool {
    process.run("true", []).unwrap().success()
}
"#

let PROCESS_MAIN = #"import helper

fn process(a: Int) {
    io.println("{a}")
}

fn main() {
    process(1)
    io.println("{helper.ok()}")
}
"#

let ENV_HELPER = #"pub fn home_set() -> Bool ! Env {
    env.var("IMPORTER_PRIVATE_FN_PROBE").is_some()
}
"#

let ENV_MAIN = #"import helper

fn env(a: Int) {
    io.println("{a}")
}

fn main() ! IO, Env {
    env(1)
    io.println("{helper.home_set()}")
}
"#

fn build_and_run(tag: Str, helper: Str, entry: Str) -> ProcessResult ! FS.Write, Process.Spawn, Env.Read {
    let root = "{compile_test_helpers.scratch_root()}/{tag}"
    compile_test_helpers.sh("mkdir -p {root}/src")
    fs.write("{root}/blink.toml", "[package]\nname = \"{tag}\"\nversion = \"0.1.0\"\n").unwrap()
    fs.write("{root}/src/helper.bl", helper).unwrap()
    fs.write("{root}/src/main.bl", entry).unwrap()
    let bin = "{root}/main_bin"
    let b = process.run("build/blink", ["build", "{root}/src/main.bl", "-o", bin]).unwrap()
    assert(b.success(), "{b.out}{b.err_out}")
    let r = process.run("env", ["IMPORTER_PRIVATE_FN_PROBE=1", bin]).unwrap()
    compile_test_helpers.sh("rm -rf {root}")
    r
}

test "an importer's private fn process leaves process.run the built-in in its import" {
    let r = build_and_run("importer_private_process", PROCESS_HELPER, PROCESS_MAIN)
    assert(r.success(), r.err_out)
    assert_eq(r.out, "1\ntrue\n")
}

test "an importer's private fn env leaves env.var the built-in in its import" {
    let r = build_and_run("importer_private_env", ENV_HELPER, ENV_MAIN)
    assert(r.success(), r.err_out)
    assert_eq(r.out, "1\ntrue\n")
}
