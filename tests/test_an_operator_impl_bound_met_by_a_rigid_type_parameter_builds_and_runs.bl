// A type parameter that holds the bound of an Eq or Ord impl (written on the binder, in an
// impl's where clause, or given through a supertrait) meets that bound at `==`, `!=` and the
// ordering operators (§3.6 Trait Bounds). A Closeable bound gives BlockHandler (§4.7.2), at an
// operator and at a method call. Each form builds and runs.

trait Sh {
    fn sh(self) -> Int
}

trait Loud: Sh {
    fn loud(self) -> Int
}

impl Sh for Int {
    fn sh(self) -> Int { self }
}

impl Loud for Int {
    fn loud(self) -> Int { self * 10 }
}

impl[V: Sh] Sh for List[V] {
    fn sh(self) -> Int { self.len() }
}

type Bx[T] { v: T }

impl[T: Sh] Eq for Bx[T] {
    fn eq(self, o: Bx[T]) -> Bool { self.v.sh() == o.v.sh() }
}

impl[T: Sh] Ord for Bx[T] {
    fn cmp(self, o: Bx[T]) -> Ordering { self.v.sh().cmp(o.v.sh()) }
}

type Ex[T] { v: T }

impl[T: Eq] Eq for Ex[T] {
    fn eq(self, o: Ex[T]) -> Bool { self.v == o.v }
}

fn same[T: Sh](a: Bx[T], b: Bx[T]) -> Bool { a == b }

fn differ[T: Sh](a: Bx[T], b: Bx[T]) -> Bool { a != b }

fn below[T: Sh](a: Bx[T], b: Bx[T]) -> Bool { a < b && a <= b && !(a > b) && !(a >= b) }

fn same_nested[T: Sh](a: Bx[List[T]], b: Bx[List[T]]) -> Bool { a == b }

fn same_loud[T: Loud](a: Bx[T], b: Bx[T]) -> Bool { a == b && a <= b }

fn same_ord[T: Ord](a: Ex[T], b: Ex[T]) -> Bool { a == b }

trait Run {
    fn run(self) -> Bool
}

type W[T] { v: T }

type Res { n: Int }

impl Closeable for Res {
    fn close(self) {
        let _ = self.n
    }
}

type Cx[T] { v: T, n: Int }

impl[T: BlockHandler] Eq for Cx[T] {
    fn eq(self, o: Cx[T]) -> Bool { self.n == o.n }
}

trait Shown {
    fn shown(self) -> Int
}

impl[T: BlockHandler] Shown for Cx[T] {
    fn shown(self) -> Int { self.n }
}

fn same_closeable[T: Closeable](a: Cx[T]) -> Bool { a == a && !(a != a) }

fn shown_closeable[T: Closeable](a: Cx[T]) -> Int { a.shown() }

impl[T] Run for W[T] where T: Sh {
    fn run(self) -> Bool {
        let b = Bx { v: self.v }
        b == b && b <= b
    }
}

test "a bound written on the binder meets the Eq impl's bound at == and !=" {
    assert(same(Bx { v: 3 }, Bx { v: 3 }))
    assert(!same(Bx { v: 3 }, Bx { v: 4 }))
    assert(differ(Bx { v: 3 }, Bx { v: 4 }))
    assert(!differ(Bx { v: 3 }, Bx { v: 3 }))
}

test "a bound written on the binder meets the Ord impl's bound at each ordering operator" {
    assert(below(Bx { v: 1 }, Bx { v: 2 }))
    assert(!below(Bx { v: 2 }, Bx { v: 1 }))
}

test "a bound met through another impl meets the Eq impl's bound at ==" {
    assert(same_nested(Bx { v: [1, 2] }, Bx { v: [5, 6] }))
    assert(!same_nested(Bx { v: [1] }, Bx { v: [5, 6] }))
}

test "a bound given through a supertrait meets the impl's bound at ==, and at <= where Ord needs it" {
    assert(same_loud(Bx { v: 7 }, Bx { v: 7 }))
    assert(same_ord(Ex { v: "a" }, Ex { v: "a" }))
    assert(!same_ord(Ex { v: "a" }, Ex { v: "b" }))
}

test "a bound written in an impl's where clause meets the impl's bound at == and <=" {
    assert(W { v: 5 }.run())
}

test "a Closeable bound meets a BlockHandler impl bound at == and at a method call" {
    let c = Cx { v: Res { n: 1 }, n: 7 }
    assert(same_closeable(c))
    assert_eq(shown_closeable(c), 7)
}
