// An internal compiler error is a bug of the compiler. Its help and its explain text tell the
// user to report it. They do not tell the user to use another compiler build, because no
// other build is known to hold the stage (section 6.7.4).

import diagnostics.{Diag, diag_reset, diag_unflushed, diag_explain, diag_ice_stage_not_built, CODEGEN_STAGE_NOT_BUILT}

test "the help of an unbuilt codegen stage names no other compiler build" {
    diag_reset()
    diag_ice_stage_not_built("a probe stage", -1)
    let text = diag_unflushed(0)
    diag_reset()
    assert(text.contains("internal compiler error[CodegenStageNotBuilt]: a probe stage is not built in this compiler"), text)
    assert(!text.contains("compiler build"), text)
    assert(text.contains("report"), text)
}

test "the explain text of an unbuilt codegen stage names no other compiler build" {
    let text = diag_explain(CODEGEN_STAGE_NOT_BUILT)
    assert(text.starts_with("I0004 -- CodegenStageNotBuilt"), text)
    assert(!text.contains("compiler build"), text)
    assert(text.contains("report"), text)
}
