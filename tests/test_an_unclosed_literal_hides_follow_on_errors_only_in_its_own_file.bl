// A string left open at the end of a file hides what the compiler says after its opening in
// that file, since that text is the same mistake again. Another file's errors are not follow-ons
// of it, so they still print, even when their line comes after the literal's.

import std.process.{ProcessResult}
import compile_test_helpers

let DIR = "{compile_test_helpers.scratch_root()}/unclosed_literal_other_file"

fn sh(cmd: Str) -> ProcessResult {
    process.run("sh", ["-c", cmd]).unwrap()
}

test "an error in a second file after an unclosed string in an imported file still prints" {
    let _ = sh("rm -rf {DIR}; mkdir -p {DIR}/src")
    write_file("{DIR}/blink.toml", "[package]\nname = \"unclosed_literal_other_file\"\nversion = \"0.1.0\"\n")
    write_file("{DIR}/blink.lock", "[metadata]\nlockfile-version = 1\n")
    write_file("{DIR}/src/base.bl", ["pub fn b() -> Str \{", #"    "x"#].join("\n"))
    write_file("{DIR}/src/main.bl", [
        "import base.\{b\}",
        "",
        "fn main() \{",
        #"    let n: Int = "no""#,
        "    io.println(b())",
        "    io.println(n)",
        "}",
        "",
    ].join("\n"))
    let r = sh("B=$(pwd)/build/blink; cd {DIR} && $B check --json src/main.bl")
    let _ = sh("rm -rf {DIR}")
    assert_eq(r.exit_code, 1)
    assert(r.err_out.contains(#""code":"E1126""#), r.err_out)
    assert(r.err_out.contains(#""span":{"file":"src/base.bl","line":2,"#), r.err_out)
    assert(r.err_out.contains(#""code":"E0300""#), r.err_out)
    assert(r.err_out.contains(#""span":{"file":"src/main.bl","line":4,"#), r.err_out)
}
