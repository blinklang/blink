// A variant of a generic enum whose payloads fix no type parameter, at a position whose
// expected type fixes none either, is under-determined: E0301, as for any generic call, and
// never a type variable left for codegen (sections/03_types.md §3.4, the under-determined rule).

import compile_test_helpers

test "a payload variant that names no type parameter, passed to a generic call, errors E0301" {
    let src = "type Tree[T] \{\n    Leaf(v: T)\n    Named(n: Int)\n}\nfn size[U](_t: Tree[U]) -> Int \{ 1 }\nfn main() \{\n    assert_eq(size(Tree.Named(1)), 1)\n}\n"
    compile_test_helpers.expect_compile_error(src, "e0301_variant_named_payload", "E0301")
}

test "a variant whose payloads are all nullary, passed to a generic call, errors E0301" {
    let src = "type Tree[T] \{\n    Leaf(T)\n    Node(l: Tree[T], r: Tree[T])\n    Empty\n}\nfn size[U](_t: Tree[U]) -> Int \{ 1 }\nfn main() \{\n    assert_eq(size(Tree.Node(l: Tree.Empty, r: Tree.Empty)), 1)\n}\n"
    compile_test_helpers.expect_compile_error(src, "e0301_variant_nullary_payloads", "E0301")
}

test "a nullary payload beside a payload that fixes the type parameter does not error" {
    let src = "type Tree[T] \{\n    Leaf(T)\n    Node(l: Tree[T], r: Tree[T])\n    Empty\n}\nfn size[U](_t: Tree[U]) -> Int \{ 1 }\nfn main() \{\n    assert_eq(size(Tree.Node(l: Tree.Empty, r: Tree.Leaf(1))), 1)\n}\n"
    compile_test_helpers.expect_no_error(src, "e0301_variant_fixed_payload_ok", "E0301")
}

test "a let bound to a variant that fixes only some type parameters errors E0301" {
    let src = "type Side[L, R] \{\n    Left(L)\n    Right(R)\n}\nfn main() \{\n    let _b = Side.Left(4)\n}\n"
    compile_test_helpers.expect_compile_error(src, "e0301_variant_partial_let", "E0301")
}
