// A build without --trace compiles the body of a written `impl[T] Debug` only at an instance
// that calls it. `Box2[NoShow]` never calls `debug`, so its body is not compiled there, and
// the program builds although `NoShow` has no Display.

type NoShow { x: Int }

type Box2[T] { v: T }

impl[T] Debug for Box2[T] {
    fn debug(self) -> Str { "B({self.v})" }
}

test "a written Debug impl is compiled only at the instance that calls it" {
    let a = Box2 { v: 5 }
    let b = Box2 { v: NoShow { x: 2 } }
    assert_eq("{a.debug()} {b.v.x}", "B(5) 2")
}
