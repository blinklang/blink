// A written `impl[T: Display] Debug` runs at an instance it covers, and a `Box2[NoShow]`,
// which it does not cover, builds in the same program although `NoShow` has no Display.
// The body is typed once, at its definition, so `T` needs the bound for "{self.v}".

type NoShow { x: Int }

type Box2[T] { v: T }

impl[T: Display] Debug for Box2[T] {
    fn debug(self) -> Str { "B({self.v})" }
}

test "a written Debug impl is compiled only at the instance that calls it" {
    let a = Box2 { v: 5 }
    let b = Box2 { v: NoShow { x: 2 } }
    assert_eq("{a.debug()} {b.v.x}", "B(5) 2")
}
