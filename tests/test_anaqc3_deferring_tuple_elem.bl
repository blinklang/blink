// anaqc3 regression guards: tuple elements whose Option/Result inner is NOT a
// scalar MUST stay on the string path (tc_tid_tuple_elem_encodable returns false
// for them, so the slot tid stays -1 and resolve_tparam_via_tid falls back). If the
// scalar-only guard ever loosens to admit these, the tid path (tc_tid_inner_tag)
// would spell them differently from the value-constructed string path and break the
// Gen1==Gen2 fixed point — these tests are the byte-stability tripwire.
//
// Kept in a SEPARATE TU from the scalar-inner cases
// (test_anaqc3_option_result_tuple_elem.bl): co-locating a scalar Option seed with
// these compound shapes trips an orthogonal, pre-existing tuple-literal carrier
// collapse (br yap7h7). These shapes each compile correctly on their own.

type AnaqcPoint {
    x: Int,
    y: Int,
}

fn take_int[T](_x: T) -> Int {
    99
}

// Option[List[Int]]: string path keeps the element → Tuple2_Option_list_int;
// tc_tid_inner_tag has no TK_LIST arm and would erase the List inner via
// tc_tid_scalar_tag to bare "list" — DIVERGES. Stays deferred.
test "(Option[List[Int]], Int) stays on the string path" {
    let xs = [1, 2, 3]
    let p = (Some(xs), 7)
    let n = take_int(p)
    assert_eq(n, 99)
}

// Option[<struct>] (the 295z9x family): tc_tid_inner_tag spells the struct inner
// via tc_tid_struct_mono_name; the value-constructed string path can erase it
// differently. Stays deferred. Also the regen safety net for the scalar-only guard
// — compiler source builds an (M, Option[Cmd]) shape; a too-loose guard breaks regen.
test "(Option[AnaqcPoint], Int) stays on the string path" {
    let pt = AnaqcPoint { x: 1, y: 2 }
    let p = (Some(pt), 7)
    let n = take_int(p)
    assert_eq(n, 99)
}

// Option[Map]: value-constructed erases the Map inner to bare "map"
// (Tuple2_Option_map_int); tc_tid_inner_tag would spell Map_str_int — DIVERGES
// (br 6kqgnp reconciles the canonical spelling before Map can be admitted).
test "(Option[Map[Str, Int]], Int) stays on the string path" {
    let mut m: Map[Str, Int] = Map()
    m.insert("a", 1)
    let p = (Some(m), 7)
    let n = take_int(p)
    assert_eq(n, 99)
}

// Result[List[Int], Int]: the Ok inner is a List → string path
// Tuple2_Result_list_int_int (bare "list"); a non-scalar inner1 means Result must
// NOT be admitted (the guard requires BOTH inners scalar). Stays deferred.
test "(Result[List[Int], Int], Int) stays on the string path" {
    let xs = [1, 2, 3]
    let r: Result[List[Int], Int] = Ok(xs)
    let p = (r, 7)
    let n = take_int(p)
    assert_eq(n, 99)
}
