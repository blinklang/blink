// anaqc3: Option tuple elements with a SCALAR inner now carry a real slot tid (not
// -1) through tc_mono_csv, so the def-side resolver reads the tuple element via
// tc_seg_from_tid rather than passing the raw element name through. The tid path
// (tc_tid_inner_tag) spells Option_<scalar>, byte-identical to BOTH the
// value-constructed path (emit_tuple_lit) and the annotation path
// (resolve_tuple_ann). The direct-literal cases are behavioral byte-parity guards;
// the List[(Option[Int], Int)] case is the true behavioral FLIP (pre-anaqc3 it
// mangled first[T] to first_Void and failed to typecheck the .unwrap()). The ci
// byte-equality gate (Gen1==Gen2) is the real proof.
//
// Mirrors the harness in test_tid_tuple_arg_bind.bl: the generic helpers force the
// tuple through tc_mono_csv, and the mono symbol (take_int_Tuple2_Option_int_int)
// must stay byte-identical before/after the gate change.
//
// SCOPE SPLIT (historical, kept for organization): the RESULT cases live in
// test_anaqc3_result_tuple_elem.bl and the still-DEFERRING shapes in
// test_anaqc3_deferring_tuple_elem.bl. The split ORIGINALLY dodged br yap7h7 (a
// tuple-returning free fn left cg_current_fn_node dangling into the test bodies, so
// bare tuple literals collapsed onto that fn's carrier). yap7h7 is now FIXED, so
// these files co-locate cleanly and the seed ordering below no longer matters —
// test_yap7h7_tuple_carrier_collapse.bl is the dedicated combined regression guard.

fn take[T](x: T) -> T {
    x
}

fn take_int[T](_x: T) -> Int {
    99
}

fn first[T](xs: List[T]) -> T {
    xs.get(0).unwrap()
}

fn take_opt_tuple(p: (Option[Int], Int)) -> Int {
    p.1
}

fn make_opt_tuple() -> (Option[Int], Int) {
    (Some(11), 12)
}

test "value-constructed (Option[Int], Int) tuple binds through tc_mono_csv" {
    let p = (Some(1), 7)
    let n = take_int(p)
    assert_eq(n, 99)
}

test "let-annotated (Option[Int], Int) tuple binds through tc_mono_csv" {
    let p: (Option[Int], Int) = (Some(1), 7)
    let n = take_int(p)
    assert_eq(n, 99)
}

test "(Option[Int], Int) round-trips through a bare-typevar param" {
    let p = (Some(3), 4)
    let q = take(p)
    assert_eq(q.0.unwrap(), 3)
    assert_eq(q.1, 4)
}

test "(Option[Int], Int) as an explicit fn param" {
    let p = (Some(5), 9)
    assert_eq(take_opt_tuple(p), 9)
}

test "(Option[Int], Int) as a fn return" {
    let p = make_opt_tuple()
    assert_eq(p.0.unwrap(), 11)
    assert_eq(p.1, 12)
}

// The behavioral FLIP: pre-anaqc3 the List element tid deferred to -1, so first[T]
// mangled to first_Void and the tuple element erased — .0.unwrap() failed to
// typecheck. The scalar-inner gate resolves the element tid to Tuple2_Option_int_int.
// (This was placed LAST as a br yap7h7 workaround; yap7h7 is now fixed, so its
// position is no longer load-bearing.)
test "List[(Option[Int], Int)] element resolves through first[T]" {
    let xs = [(Some(1), 7), (Some(2), 8)]
    let r = first(xs)
    assert_eq(r.0.unwrap(), 1)
    assert_eq(r.1, 7)
}
