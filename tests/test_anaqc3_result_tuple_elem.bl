// anaqc3 (Result half): Result tuple elements with BOTH inners scalar now carry a
// real slot tid (not -1) through tc_mono_csv. tc_tid_inner_tag spells
// Result_<scalar>_<scalar>, byte-identical to the value path (emit_tuple_lit) and
// the annotation path (resolve_tuple_ann). Behavioral byte-parity guards; the ci
// Gen1==Gen2 gate is the real proof.
//
// Split from the Option half (test_anaqc3_option_result_tuple_elem.bl) — originally
// to dodge br yap7h7 (a tuple-returning free fn left cg_current_fn_node dangling
// into the test bodies, collapsing later tuple literals onto its carrier). yap7h7 is
// now FIXED; the split is retained only for organization.

fn take_int[T](_x: T) -> Int {
    99
}

test "value-constructed (Result[Str, Int], Int) tuple binds through tc_mono_csv" {
    let r: Result[Str, Int] = Ok("a")
    let p = (r, 7)
    let n = take_int(p)
    assert_eq(n, 99)
}

test "let-annotated (Result[Str, Int], Int) tuple binds through tc_mono_csv" {
    let p: (Result[Str, Int], Int) = (Ok("a"), 7)
    let n = take_int(p)
    assert_eq(n, 99)
}

test "(Result[Int, Int], Int) both-scalar inners bind" {
    let r: Result[Int, Int] = Ok(3)
    let p = (r, 8)
    let n = take_int(p)
    assert_eq(n, 99)
}
