// anaqc3 (scalar-variety half): the newly-admitted scalar-inner gate accepts every
// kind tc_tid_scalar_only admits, not just Int. These exercise DISTINCT scalar tags
// (char / double / i32 / u8) so a tc_tid_scalar_tag spelling regression in one
// specific scalar kind is caught — the Int-only cases in the sibling files would
// miss it. tc_tid_inner_tag → tc_tid_scalar_tag must spell each inner byte-identical
// to the value/annotation string paths (Option_char, Option_double, Option_i32, ...).
//
// Kept in its OWN TU: piling more distinct Tuple2_Option_<scalar>_int carrier shapes
// into one file trips the pre-existing tuple-literal carrier collapse (br yap7h7).

fn take_int[T](_x: T) -> Int {
    99
}

test "(Option[Char], Int) scalar-char inner binds" {
    let p = (Some('a'), 7)
    let n = take_int(p)
    assert_eq(n, 99)
}

test "(Option[Float], Int) scalar-double inner binds" {
    let p = (Some(1.5), 7)
    let n = take_int(p)
    assert_eq(n, 99)
}

test "(Option[I32], Int) sized-int inner binds" {
    let x: I32 = 5
    let p = (Some(x), 7)
    let n = take_int(p)
    assert_eq(n, 99)
}

test "(Result[Bool, U8], Int) both-scalar non-Int inners bind" {
    let x: U8 = 3
    let r: Result[Bool, U8] = Err(x)
    let p = (r, 7)
    let n = take_int(p)
    assert_eq(n, 99)
}
