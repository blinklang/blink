// A type annotation on a module-level global must not change what its initializer
// means. Typecheck walks the initializer in both spellings, so every expression in
// it carries the same type — and the same value at run time — whether or not the
// binding is annotated.

type GPoint { x: Int, y: Int }
type GBox[T] { v: T }
type GWrap[T] { One(T)  Two }

let ag_list: List[Int] = [1, 2, 3]
let ag_empty: List[Int] = []
let ag_map: Map[Str, Int] = Map()
let ag_set: Set[Int] = Set()
let ag_struct: GPoint = GPoint { x: 4, y: 5 }
let ag_tuple: (Int, Str) = (7, "hi")
let ag_alias: List[Int] = ag_list
let ag_none: Option[Int] = None
let ag_some: Option[Int] = Some(9)
let ag_ok: Result[Int, Str] = Ok(11)
let ag_err: Result[Int, Str] = Err("boom")
let ag_nested: List[Map[Str, Int]] = [Map()]
let ag_deep: Map[Str, List[Int]] = Map()
let ag_box: GBox[Int] = GBox { v: 13 }
let ag_wrap: GWrap[Int] = GWrap.One(17)
let ag_str: Str = "annotated"
pub let ag_pub: List[Str] = ["a", "b"]
let mut ag_mut: List[Int] = [9]
const ag_const: List[Int] = [21, 22]
pub const ag_const_str: Str = "konst"

// Same initializer without the annotation. The two must agree.
let ag_list_bare = [1, 2, 3]

test "annotated list global holds its elements" {
    assert_eq(ag_list.len(), 3)
    assert_eq(ag_list.get(0).unwrap(), 1)
    assert_eq(ag_list.get(2).unwrap(), 3)
}

test "annotated and unannotated globals agree" {
    assert_eq(ag_list.len(), ag_list_bare.len())
    assert_eq(ag_list.get(1).unwrap(), ag_list_bare.get(1).unwrap())
}

test "annotated empty container globals are empty and usable" {
    assert_eq(ag_empty.len(), 0)
    assert_eq(ag_map.len(), 0)
    assert_eq(ag_set.len(), 0)
    let mut grown = ag_empty
    grown.push(5)
    assert_eq(grown.len(), 1)
    assert_eq(grown.get(0).unwrap(), 5)
}

test "annotated struct and tuple globals keep their fields" {
    assert_eq(ag_struct.x, 4)
    assert_eq(ag_struct.y, 5)
    assert_eq(ag_tuple.0, 7)
    assert_eq(ag_tuple.1, "hi")
}

test "annotated global initialized from an earlier global aliases its value" {
    assert_eq(ag_alias.len(), 3)
    assert_eq(ag_alias.get(2).unwrap(), 3)
}

test "annotated carrier globals carry their payload" {
    // A `match` rather than `??`: coalescing a module-level Option global is a
    // separate, pre-existing codegen defect and would mask what this file proves.
    let none_val = match ag_none { Some(v) => v  None => 0 }
    assert_eq(none_val, 0)
    let some_val = match ag_some { Some(v) => v  None => 0 }
    assert_eq(some_val, 9)
    let ok_val = match ag_ok { Ok(v) => v  Err(_) => -1 }
    assert_eq(ok_val, 11)
    let err_val = match ag_err { Ok(_) => "none"  Err(e) => e }
    assert_eq(err_val, "boom")
}

test "annotated nested-container global keeps its inner type" {
    assert_eq(ag_nested.len(), 1)
    let mut inner = ag_nested.get(0).unwrap()
    assert_eq(inner.len(), 0)
    inner.insert("k", 3)
    assert_eq(inner.get("k").unwrap(), 3)
}

test "annotated generic-type globals keep their instantiation" {
    assert_eq(ag_box.v, 13)
    let wrapped = match ag_wrap { One(v) => v  Two => 0 }
    assert_eq(wrapped, 17)
    assert_eq(ag_deep.len(), 0)
    let mut deep = ag_deep
    deep.insert("k", [3, 4])
    assert_eq(deep.get("k").unwrap().len(), 2)
    assert_eq(deep.get("k").unwrap().get(1).unwrap(), 4)
}

test "annotated scalar, pub and mut globals read back" {
    assert_eq(ag_str, "annotated")
    assert_eq(ag_pub.len(), 2)
    assert_eq(ag_pub.get(1).unwrap(), "b")
    assert_eq(ag_mut.len(), 1)
    assert_eq(ag_mut.get(0).unwrap(), 9)
}

test "annotated const globals read back" {
    assert_eq(ag_const.len(), 2)
    assert_eq(ag_const.get(1).unwrap(), 22)
    assert_eq(ag_const_str, "konst")
}
