// Regression for anphdt: `let c = if cond { make(1) } else { make(0) }` where
// `make` returns a struct must declare `c` with the struct type. Codegen
// previously emitted `const void c = 0;` because infer_node_struct_name did not
// handle a Call node in the if-branch tail position, taking the void fallback.
type Carrier {
    sname: Str
    ct: Int
}

fn make(_flag: Int) -> Carrier {
    Carrier { sname: "a", ct: 1 }
}

test "let = if/else with struct-returning call branches" {
    let c = if make(0).sname == "" { make(1) } else { make(0) }
    assert_eq(c.sname, "a")
    assert_eq(c.ct, 1)
}
