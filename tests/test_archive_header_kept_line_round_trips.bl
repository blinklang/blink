// The first line of the stdlib archive's header names the std bodies the archive leaves for
// the user unit. What the archive writes there, a user build reads back unchanged; a line
// with no symbols means nothing is left out, and any other line is no list at all.

import archive_keep.{KEPT_MARKER, kept_header_line, parse_kept_line}

fn set_of(xs: List[Str]) -> Map[Str, Int] {
    let mut m: Map[Str, Int] = Map()
    for x in xs { m.insert(x, 1) }
    m
}

fn sorted_keys(m: Map[Str, Int]) -> Str {
    m.keys().sort().join(" ")
}

test "a written kept line reads back as the same list" {
    let kept = set_of(["blink_std_toml_toml_1parse", "blink_std_list_a", "z_last"])
    let line = kept_header_line(kept)
    assert(line.starts_with(KEPT_MARKER), "the line does not start with the marker: {line}")
    match parse_kept_line(line) {
        Some(back) => assert_eq(sorted_keys(back), sorted_keys(kept))
        None => assert(false, "a written kept line did not parse: {line}")
    }
}

test "a kept line with no symbols reads as nothing kept" {
    let line = kept_header_line(Map())
    assert_eq(line, "{KEPT_MARKER} */")
    match parse_kept_line(line) {
        Some(back) => assert_eq(back.len(), 0)
        None => assert(false, "an empty kept line read as no list")
    }
}

test "a first line without the marker is no list" {
    assert(parse_kept_line("#ifndef BLINK_LIBBLINK_STD_H").is_none(), "a header guard read as a kept list")
    assert(parse_kept_line("").is_none(), "an empty line read as a kept list")
    assert(parse_kept_line("/* blink:kept_for_user_x */").is_none(), "a longer marker word read as a kept list")
    assert(parse_kept_line("{KEPT_MARKER} a b").is_none(), "an unclosed kept line read as a kept list")
}
