// §5.2.1 clause 7: a closure tail of `with arena { }` is promoted by walking its
// captures, so what it captured outlives the arena. Each row calls the closure
// only after `clobber` has filled a fresh arena with -7 in the freed memory.

fn clobber() {
    let mut n = 0
    with arena {
        let mut t: List[Int] = []
        let mut i = 0
        while i < 4000 {
            t.push(-7)
            i = i + 1
        }
        n = t.len()
    }
    assert_eq(n, 4000)
}

fn build(n: Int) -> List[Int] {
    let mut t: List[Int] = []
    let mut i = 0
    while i < n {
        t.push(i * 10)
        i = i + 1
    }
    t
}

fn lookup(xs: List[Int]) -> fn(Int) -> Int {
    fn(i: Int) -> Int { xs.get(i).unwrap() }
}

test "closure tail capturing a block-local list survives arena reuse" {
    let g = with arena {
        let xs = build(4)
        fn(i: Int) -> Int { xs.get(i).unwrap() }
    }
    clobber()
    assert_eq(g(3), 30)
    assert_eq(g(0), 0)
}

test "closure tail capturing a closure built by a callee promotes the inner captures" {
    let g = with arena {
        let inner = lookup(build(4))
        fn(i: Int) -> Int { inner(i) + 1 }
    }
    clobber()
    assert_eq(g(3), 31)
    assert_eq(g(1), 11)
}
