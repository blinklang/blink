// §5.2.1 Nesting: an inner arena's allocations are freed when the inner block exits and
// the outer arena is untouched. A List, Map or Set made in the outer arena and grown in
// the inner one must grow in the outer arena, so it is still whole after the inner block
// closes and a sibling inner arena (`clobber`) reuses the freed chunks.

fn clobber() {
    let mut n = 0
    with arena {
        let mut t: List[Int] = []
        let mut i = 0
        while i < 20000 {
            t.push(-7)
            i = i + 1
        }
        n = t.len()
    }
    assert_eq(n, 20000)
}

test "a list made in the outer arena and grown in an inner one keeps its items" {
    with arena {
        let mut xs: List[Int] = []
        xs.push(0)
        with arena {
            let mut i = 1
            while i < 5000 {
                xs.push(i)
                i = i + 1
            }
        }
        clobber()
        assert_eq(xs.len(), 5000)
        let mut bad = 0
        let mut k = 0
        while k < 5000 {
            if (xs.get(k) ?? -1) != k {
                bad = bad + 1
            }
            k = k + 1
        }
        assert_eq(bad, 0)
    }
}

test "a map made in the outer arena and rehashed in an inner one keeps its entries" {
    with arena {
        let mut m: Map[Int, Int] = Map()
        with arena {
            let mut i = 0
            while i < 3000 {
                m.insert(i, i + 1)
                i = i + 1
            }
        }
        clobber()
        assert_eq(m.len(), 3000)
        let mut bad = 0
        let mut k = 0
        while k < 3000 {
            if (m.get(k) ?? -1) != k + 1 {
                bad = bad + 1
            }
            k = k + 1
        }
        assert_eq(bad, 0)
    }
}

test "a set made in the outer arena and rehashed in an inner one keeps its items" {
    with arena {
        let mut s: Set[Int] = Set()
        with arena {
            let mut i = 0
            while i < 3000 {
                let _ = s.insert(i)
                i = i + 1
            }
        }
        clobber()
        assert_eq(s.len(), 3000)
        assert_eq(s.contains(0), true)
        assert_eq(s.contains(2999), true)
    }
}

// The promoted copy belongs to the outer arena, so pushing it past its capacity under a
// later inner arena must still grow it in the outer arena.
test "an inner arena tail list is promoted into the outer arena and grows there" {
    with arena {
        let ys = with arena {
            let mut t: List[Int] = []
            let mut i = 0
            while i < 3000 {
                t.push(i)
                i = i + 1
            }
            t
        }
        clobber()
        let mut zs = ys
        with arena {
            let mut i = 3000
            while i < 5000 {
                zs.push(i)
                i = i + 1
            }
        }
        clobber()
        assert_eq(zs.len(), 5000)
        let mut bad = 0
        let mut k = 0
        while k < 5000 {
            if (zs.get(k) ?? -1) != k {
                bad = bad + 1
            }
            k = k + 1
        }
        assert_eq(bad, 0)
    }
}

// The promoted copy of a top-level arena tail is on the GC heap, so pushing it past its
// capacity under a later arena must grow it on the GC heap.
test "an arena tail list promoted to the GC heap grows on the GC heap" {
    let ys = with arena {
        let mut t: List[Int] = []
        let mut i = 0
        while i < 3000 {
            t.push(i)
            i = i + 1
        }
        t
    }
    let mut zs = ys
    with arena {
        let mut i = 3000
        while i < 5000 {
            zs.push(i)
            i = i + 1
        }
    }
    clobber()
    assert_eq(zs.len(), 5000)
    let mut bad = 0
    let mut k = 0
    while k < 5000 {
        if (zs.get(k) ?? -1) != k {
            bad = bad + 1
        }
        k = k + 1
    }
    assert_eq(bad, 0)
}
