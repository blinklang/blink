// aj0cwb: io.* output methods are safe sinks like bare println — passing an
// interpolated string (a genuine arena allocation) to io.println/io.print/
// io.eprintln inside `with arena` must NOT flag E0700. Distinct from nzkk01
// (which exempted pure non-interpolated literals); here the arg really is an
// arena alloc, but the sink consumes it without letting it escape.
import compile_test_helpers

test "io.println with interpolated arg inside arena does not escape" {
    let src = "fn main() \{\n    with arena \{\n        let n = 1\n        io.println(\"x=\{n}\")\n    }\n}\n"
    compile_test_helpers.expect_no_error(src, "arena_io_println_interp", "E0700")
}

test "io.print with interpolated arg inside arena does not escape" {
    let src = "fn main() \{\n    with arena \{\n        let n = 2\n        io.print(\"y=\{n}\")\n    }\n}\n"
    compile_test_helpers.expect_no_error(src, "arena_io_print_interp", "E0700")
}

test "io.eprintln with interpolated arg inside arena does not escape" {
    let src = "fn main() \{\n    with arena \{\n        let n = 3\n        io.eprintln(\"z=\{n}\")\n    }\n}\n"
    compile_test_helpers.expect_no_error(src, "arena_io_eprintln_interp", "E0700")
}

test "arena value passed to a non-safe method still escapes" {
    // Guard against an over-broad exemption: a genuinely-escaping arena value
    // passed to a NON-safe-sink method must still flag E0700. push() stores the
    // interpolated arena string into a list that outlives the arena block.
    let src = "fn build(out: List[Str]) \{\n    with arena \{\n        let n = 4\n        out.push(\"w=\{n}\")\n    }\n}\n"
    compile_test_helpers.expect_compile_error(src, "arena_nonsafe_method_escapes", "E0700")
}
