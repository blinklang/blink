// §5.2.1: pushing bytes onto Bytes, or writing to a StringBuilder, made outside `with
// arena` is no escape. Their buffers grow while the arena is active and must outlive
// the block; `clobber` hands the closed arena's chunks to a new one.

fn clobber() {
    let mut n = 0
    with arena {
        let mut t: List[Int] = []
        let mut i = 0
        while i < 20000 {
            t.push(-7)
            i = i + 1
        }
        n = t.len()
    }
    assert_eq(n, 20000)
}

test "GC bytes grown inside an arena keep every byte" {
    let b = Bytes.new()
    with arena {
        let mut i = 0
        while i < 20000 {
            b.push(i % 251)
            i = i + 1
        }
    }
    clobber()
    assert_eq(b.len(), 20000)
    let mut bad = 0
    let mut k = 0
    while k < 20000 {
        if (b.get(k) ?? -1) != k % 251 {
            bad = bad + 1
        }
        k = k + 1
    }
    assert_eq(bad, 0)
}

test "a GC string builder grown inside an arena keeps its text" {
    let sb = StringBuilder.new()
    with arena {
        let mut i = 0
        while i < 4000 {
            sb.write("abcde")
            i = i + 1
        }
    }
    clobber()
    let s = sb.to_str()
    assert_eq(s.len(), 20000)
    assert_eq(s.starts_with("abcdeabcde"), true)
    assert_eq(s.ends_with("abcdeabcde"), true)
    assert_eq(s.replace("abcde", ""), "")
}
