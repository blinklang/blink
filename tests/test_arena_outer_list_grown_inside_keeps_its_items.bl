// §5.2.1: pushing Ints onto a List made outside `with arena` is no escape, so the
// program is valid. The list grows while the arena is active, yet its storage must
// outlive the block. `clobber` fills a fresh arena that takes the freed chunks, so a
// list whose storage went into the closed arena reads -7 or garbage.

fn clobber() {
    let mut n = 0
    with arena {
        let mut t: List[Int] = []
        let mut i = 0
        while i < 20000 {
            t.push(-7)
            i = i + 1
        }
        n = t.len()
    }
    assert_eq(n, 20000)
}

fn count_bad(xs: List[Int], n: Int) -> Int {
    let mut bad = 0
    let mut k = 0
    while k < n {
        if (xs.get(k) ?? -1) != k {
            bad = bad + 1
        }
        k = k + 1
    }
    bad
}

test "a GC list pushed past its capacity inside an arena keeps every item" {
    let mut xs: List[Int] = []
    let n = with arena {
        let mut i = 0
        while i < 5000 {
            xs.push(i)
            i = i + 1
        }
        xs.len()
    }
    clobber()
    assert_eq(n, 5000)
    assert_eq(xs.len(), 5000)
    assert_eq(count_bad(xs, 5000), 0)
}

test "a GC list of Str grown inside an arena keeps its strings" {
    let words = ["alpha", "beta", "gamma"]
    let mut xs: List[Str] = []
    with arena {
        let mut i = 0
        while i < 3000 {
            xs.push(words.get(i % 3) ?? "")
            i = i + 1
        }
    }
    clobber()
    assert_eq(xs.len(), 3000)
    assert_eq(xs.get(0) ?? "", "alpha")
    assert_eq(xs.get(2999) ?? "", "gamma")
}

test "a GC list grown inside an arena keeps growing after the block" {
    let mut xs: List[Int] = []
    with arena {
        let mut i = 0
        while i < 1000 {
            xs.push(i)
            i = i + 1
        }
    }
    clobber()
    let mut i = 1000
    while i < 5000 {
        xs.push(i)
        i = i + 1
    }
    assert_eq(count_bad(xs, 5000), 0)
}
