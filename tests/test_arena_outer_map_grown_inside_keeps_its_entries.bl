// §5.2.1: inserting Int keys into a Map made outside `with arena` is no escape. The
// rehash that runs inside the block must not put the map's slots in the arena: after
// the block they would be freed memory, and `clobber` hands it to a new arena.

fn clobber() {
    let mut n = 0
    with arena {
        let mut t: List[Int] = []
        let mut i = 0
        while i < 20000 {
            t.push(-7)
            i = i + 1
        }
        n = t.len()
    }
    assert_eq(n, 20000)
}

test "a GC map rehashed inside an arena keeps every entry" {
    let mut m: Map[Int, Int] = Map()
    with arena {
        let mut i = 0
        while i < 5000 {
            m.insert(i, i * 2)
            i = i + 1
        }
    }
    clobber()
    let mut i = 0
    while i < 5000 {
        m.insert(i, i * 2)
        i = i + 1
    }
    assert_eq(m.len(), 5000)
    let mut bad = 0
    let mut k = 0
    while k < 5000 {
        if (m.get(k) ?? -1) != k * 2 {
            bad = bad + 1
        }
        k = k + 1
    }
    assert_eq(bad, 0)
}

// 40 keys take the map from 16 slots to 64, so it rehashes twice inside the arena. The
// keys are made before the block, so only the map's own storage is at stake.
test "a GC map with Str keys rehashed inside an arena keeps its keys" {
    let mut keys: List[Str] = []
    let mut n = 0
    while n < 40 {
        keys.push("key{n}")
        n = n + 1
    }
    let mut m: Map[Str, Int] = Map()
    with arena {
        let mut i = 0
        while i < keys.len() {
            m.insert(keys.get(i) ?? "", i)
            i = i + 1
        }
    }
    clobber()
    assert_eq(m.len(), 40)
    let mut bad = 0
    let mut k = 0
    while k < 40 {
        if (m.get("key{k}") ?? -1) != k {
            bad = bad + 1
        }
        k = k + 1
    }
    assert_eq(bad, 0)
}
