// §5.2.1: a Map made outside `with arena` and churned inside it (insert, then remove)
// rebuilds its slots to drop tombstones. Slots rebuilt into the arena are freed at the
// block's end; a new arena reuses them, and a lookup that never meets an empty slot
// does not stop. The map must keep its own slots, so every lookup below ends.

fn clobber() {
    let mut n = 0
    with arena {
        let mut t: List[Int] = []
        let mut i = 0
        while i < 20000 {
            t.push(-7)
            i = i + 1
        }
        n = t.len()
    }
    assert_eq(n, 20000)
}

test "a GC map churned inside an arena still answers lookups after it" {
    let mut m: Map[Int, Int] = Map()
    with arena {
        let mut round = 0
        while round < 200 {
            let mut i = 0
            while i < 50 {
                m.insert(round * 50 + i, i)
                i = i + 1
            }
            let mut j = 0
            while j < 50 {
                let _ = m.remove(round * 50 + j)
                j = j + 1
            }
            round = round + 1
        }
        m.insert(7, 70)
    }
    clobber()
    assert_eq(m.len(), 1)
    assert_eq(m.get(7) ?? -1, 70)
    assert_eq(m.contains_key(123456), false)
    m.insert(8, 80)
    assert_eq(m.len(), 2)
    assert_eq(m.get(8) ?? -1, 80)
}

test "a GC set churned inside an arena still answers lookups after it" {
    let mut s: Set[Int] = Set()
    with arena {
        let mut round = 0
        while round < 200 {
            let mut i = 0
            while i < 50 {
                let _ = s.insert(round * 50 + i)
                i = i + 1
            }
            let mut j = 0
            while j < 50 {
                let _ = s.remove(round * 50 + j)
                j = j + 1
            }
            round = round + 1
        }
        let _ = s.insert(7)
    }
    clobber()
    assert_eq(s.len(), 1)
    assert_eq(s.contains(7), true)
    assert_eq(s.contains(123456), false)
}
