// §5.2.1: inserting Ints into a Set made outside `with arena` is no escape. Its rehash
// inside the block must keep the set's slots out of the arena, or `clobber` overwrites
// them through a new arena once the block closes.

fn clobber() {
    let mut n = 0
    with arena {
        let mut t: List[Int] = []
        let mut i = 0
        while i < 20000 {
            t.push(-7)
            i = i + 1
        }
        n = t.len()
    }
    assert_eq(n, 20000)
}

test "a GC set rehashed inside an arena keeps every item" {
    let mut s: Set[Int] = Set()
    with arena {
        let mut i = 0
        while i < 5000 {
            let _ = s.insert(i)
            i = i + 1
        }
    }
    clobber()
    let mut i = 0
    while i < 5000 {
        let _ = s.insert(i)
        i = i + 1
    }
    assert_eq(s.len(), 5000)
    let mut missing = 0
    let mut k = 0
    while k < 5000 {
        if !s.contains(k) {
            missing = missing + 1
        }
        k = k + 1
    }
    assert_eq(missing, 0)
}
