import compile_test_helpers

test "self-referential struct returned from arena emits E0701" {
    let src = "type Node \{\n    next: Node\n    value: Int\n}\nfn main() \{\n    with arena \{\n        Node \{ next: Node \{ next: Node \{ value: 0 }, value: 1 }, value: 2 }\n    \}\n}\n"
    compile_test_helpers.expect_compile_error(src, "arena_cycle_self", "E0701")
}

test "mutually recursive types returned from arena emit E0701" {
    let src = "type A \{\n    b: B\n}\ntype B \{\n    a: A\n}\nfn main() \{\n    with arena \{\n        A \{ b: B \{ a: A \{ b: B \{ a: A \{ b: B \{ } } } } } }\n    \}\n}\n"
    compile_test_helpers.expect_compile_error(src, "arena_cycle_mutual", "E0701")
}

test "a generic body whose parameter stands for a recursive type emits E0701 at the instance" {
    let src = "type Node \{\n    next: Option[Node]\n    v: Int\n}\nfn keep[T](x: T) -> T \{\n    with arena \{ x }\n}\nfn main() \{\n    let n = keep(Node \{ next: None, v: 1 })\n    let _ = n.v\n}\n"
    compile_test_helpers.expect_compile_error(src, "arena_cycle_generic_instance", "E0701")
}

test "a return of a recursive type from inside an arena emits E0701" {
    let src = "type Node \{\n    next: Option[Node]\n    v: Int\n}\nfn make(k: Int) -> Node \{\n    with arena \{\n        if k > 0 \{\n            return Node \{ next: None, v: k }\n        }\n    }\n    Node \{ next: None, v: 0 }\n}\nfn main() \{\n    let _ = make(1).v\n}\n"
    compile_test_helpers.expect_compile_error(src, "arena_cycle_return", "E0701")
}

test "a closure's own return inside an arena crosses nothing" {
    let src = "type Node \{\n    next: Option[Node]\n    v: Int\n}\nfn main() \{\n    let n = with arena \{\n        let f = fn(k: Int) -> Int \{\n            let x = Node \{ next: None, v: k }\n            return x.v\n        }\n        f(3)\n    }\n    assert_eq(n, 3)\n}\n"
    compile_test_helpers.expect_no_error(src, "arena_cycle_closure_return", "E0701")
}
