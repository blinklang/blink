// Arena promotion: a map whose key is a @derive(Hash, Eq) struct or a tuple survives
// `with arena { m }`, and a lookup by an equal key built outside the arena finds its entry.
// The keys are built outside the arena because inserting an arena value into an
// arena-local map is rejected as an escape today.
@derive(Hash, Eq)
type Point {
    x: Int
    y: Int
}

@derive(Hash, Eq)
type Named {
    name: Str
    n: Int
}

fn point_map(a: Point, b: Point) -> Map[Point, Int] {
    with arena {
        let mut m: Map[Point, Int] = Map()
        m.insert(a, 1)
        m.insert(b, 2)
        m
    }
}

fn named_map(a: Named) -> Map[Named, Int] {
    with arena {
        let mut m: Map[Named, Int] = Map()
        m.insert(a, 7)
        m
    }
}

fn tuple_map(a: (Int, Str), b: (Int, Str)) -> Map[(Int, Str), Int] {
    with arena {
        let mut m: Map[(Int, Str), Int] = Map()
        m.insert(a, 9)
        m.insert(b, 10)
        m
    }
}

test "a map with a scalar struct key promotes out of with-arena" {
    let m = point_map(Point { x: 1, y: 2 }, Point { x: 3, y: 4 })
    assert_eq(m.len(), 2)
    assert_eq(m.get(Point { x: 1, y: 2 }) ?? 0, 1)
    assert_eq(m.get(Point { x: 3, y: 4 }) ?? 0, 2)
    assert_eq(m.get(Point { x: 5, y: 6 }) ?? 0, 0)
}

test "a map with a struct key holding a Str promotes out of with-arena" {
    let m = named_map(Named { name: "k_{40 + 2}", n: 1 })
    assert_eq(m.len(), 1)
    assert_eq(m.get(Named { name: "k_42", n: 1 }) ?? 0, 7)
    assert_eq(m.get(Named { name: "k_42", n: 2 }) ?? 0, 0)
}

test "a map with a tuple key promotes out of with-arena" {
    let m = tuple_map((1, "one"), (2, "two"))
    assert_eq(m.len(), 2)
    assert_eq(m.get((1, "one")) ?? 0, 9)
    assert_eq(m.get((2, "two")) ?? 0, 10)
    assert_eq(m.get((2, "one")) ?? 0, 0)
}
