// Arena-promoting a struct field of type List[payload-less-enum] must copy the
// by-value intptr-packed enum ordinal, not dereference it as a pointer and box it.
// blink_promote_List_<Enum> reads *(blink_Enum*)blink_list_get(src, _i), which
// treats ordinal 0/1/2 as an address, segfaulting on the with-arena boundary.

import compile_test_helpers.{compile_and_run}

test.failing(
    "arena-promoting a struct with a List[payload-less enum] field does not segfault",
    reason: "blink_promote_List_<Enum> dereferences the by-value intptr-packed enum ordinal as a pointer and heap-boxes it, instead of copying the ordinal by value, so promoting a List[Color] (Color a payload-less enum) out of a with-arena block segfaults (exit 139)",
    ticket: "xxj7ef",
) {
    let src = #"
import std.io

type Color { Red, Green, Blue }
type Palette { shades: List[Color] }

fn main() ! IO {
    let p = with arena {
        Palette { shades: [Color.Red, Color.Blue] }
    }
    io.println("{p.shades.len()}")
}
"#
    let r = compile_and_run(src, "_arena_promote_list_payloadless_enum_segfault")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "2\n")
}
