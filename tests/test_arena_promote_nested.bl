test "Map[Int, I32] narrow-value tail promotes out of with-arena" {
    let m = with arena {
        let mut m: Map[Int, I32] = Map()
        m.insert(1, 42)
        m.insert(2, -7)
        m
    }
    assert_eq(m.len(), 2)
    assert_eq(m.get(1).unwrap(), 42)
    assert_eq(m.get(2).unwrap(), -7)
}

test "List[I32] narrow-element tail promotes out of with-arena" {
    let xs = with arena {
        let mut l: List[I32] = []
        l.push(42)
        l.push(-7)
        l
    }
    assert_eq(xs.len(), 2)
    assert_eq(xs.get(0).unwrap(), 42)
    assert_eq(xs.get(1).unwrap(), -7)
}

test "List[Char] narrow-element tail promotes out of with-arena" {
    let xs = with arena {
        let mut l: List[Char] = []
        l.push('a')
        l.push('z')
        l
    }
    assert_eq(xs.len(), 2)
    assert_eq(xs.get(0).unwrap(), 'a')
    assert_eq(xs.get(1).unwrap(), 'z')
}

// Closure-capture path: a Map captured by a closure returned out of a
// `with arena { }` block. This exercises descriptor_from_capture, a
// different code path than the tail-return tests above (bug nc0yrr).

test "Map[Char, Int] captured by closure promotes out of with-arena" {
    let g = with arena {
        let mut m: Map[Char, Int] = Map()
        m.insert('a', 1)
        m.insert('b', 2)
        m.insert('c', 3)
        let h = fn() -> Int {
            let mut total = 0
            for k in m.keys() { total = total + m.get(k).unwrap() }
            total
        }
        h
    }
    assert_eq(g(), 6)
}

test "Map[Int, Int] captured by closure promotes out of with-arena" {
    let g = with arena {
        let mut m: Map[Int, Int] = Map()
        m.insert(7, 100)
        m.insert(9, 200)
        let h = fn() -> Int {
            let mut total = 0
            for k in m.keys() { total = total + m.get(k).unwrap() }
            total
        }
        h
    }
    assert_eq(g(), 300)
}

test "Map[I32, Int] captured by closure promotes out of with-arena" {
    let g = with arena {
        let mut m: Map[I32, Int] = Map()
        m.insert(7, 100)
        m.insert(-300, 200)
        let h = fn() -> Int {
            let mut total = 0
            for k in m.keys() { total = total + m.get(k).unwrap() }
            total
        }
        h
    }
    assert_eq(g(), 300)
}

test "Map[Str, Int] captured by closure promotes out of with-arena" {
    let g = with arena {
        let mut m: Map[Str, Int] = Map()
        m.insert("a_{1}", 10)
        m.insert("b_{2}", 20)
        let h = fn() -> Int {
            let mut total = 0
            for k in m.keys() { total = total + m.get(k).unwrap() }
            total
        }
        h
    }
    assert_eq(g(), 30)
}
