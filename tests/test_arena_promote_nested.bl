// Arena promotion: List and Map tails cross the `with arena { }`
// boundary intact and are readable after the inner arena is destroyed.

test "List[Int] tail promotes out of with-arena" {
    let xs = with arena {
        let mut l: List[Int] = []
        l.push(1)
        l.push(2)
        l.push(3)
        l
    }
    assert_eq(xs.len(), 3)
    assert_eq(xs.get(0).unwrap(), 1)
    assert_eq(xs.get(1).unwrap(), 2)
    assert_eq(xs.get(2).unwrap(), 3)
}

test "List[Str] tail promotes out of with-arena" {
    let xs = with arena {
        let mut l: List[Str] = []
        l.push("hello_{1}")
        l.push("hello_{2}")
        l
    }
    assert_eq(xs.len(), 2)
    assert_eq(xs.get(0).unwrap(), "hello_1")
    assert_eq(xs.get(1).unwrap(), "hello_2")
}

test "Map[Str, Int] tail promotes out of with-arena" {
    let m = with arena {
        let mut m: Map[Str, Int] = Map()
        m.insert("a_{1}", 10)
        m.insert("b_{2}", 20)
        m
    }
    assert_eq(m.len(), 2)
    assert_eq(m.get("a_1").unwrap(), 10)
    assert_eq(m.get("b_2").unwrap(), 20)
}

test "Map[Int, Int] tail promotes out of with-arena" {
    let m = with arena {
        let mut m: Map[Int, Int] = Map()
        m.insert(7, 100)
        m.insert(9, 200)
        m
    }
    assert_eq(m.len(), 2)
    assert_eq(m.get(7).unwrap(), 100)
    assert_eq(m.get(9).unwrap(), 200)
}

test "Map[Bool, Int] tail promotes out of with-arena" {
    let m = with arena {
        let mut m: Map[Bool, Int] = Map()
        m.insert(true, 1)
        m.insert(false, 0)
        m
    }
    assert_eq(m.len(), 2)
    assert_eq(m.get(true).unwrap(), 1)
    assert_eq(m.get(false).unwrap(), 0)
}

test "Map[Int, Str] tail promotes out of with-arena" {
    let m = with arena {
        let mut m: Map[Int, Str] = Map()
        m.insert(1, "one_{1}")
        m.insert(2, "two_{2}")
        m
    }
    assert_eq(m.len(), 2)
    assert_eq(m.get(1).unwrap(), "one_1")
    assert_eq(m.get(2).unwrap(), "two_2")
