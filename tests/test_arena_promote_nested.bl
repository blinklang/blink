test "Map[U32, Int] tail promotes out of with-arena" {
    let m = with arena {
        let mut m: Map[U32, Int] = Map()
        m.insert(4000000000, 10)
        m.insert(7, 20)
        m
    }
    assert_eq(m.len(), 2)
    assert_eq(m.get(4000000000).unwrap(), 10)
    assert_eq(m.get(7).unwrap(), 20)
