// A by-value Result or Option capture whose ok/err or payload operand is an
// enum, Bytes, Set, closure, ... once had no promote walker: the old string
// descriptor collapsed it to "P:Int", and the arena tail promoter bit-copied
// the boxed carrier's heap pointer, a use-after-free once the arena died.
// Capture slots are now typed from the tid (spec 05 §5.2.1 clause 7), so these
// carriers promote: each run row reads the value after a later arena has
// reused the freed memory. In-grammar carriers still compile with no E0702d.

import compile_test_helpers

test "a promoted closure capturing an off-grammar Result[Int, enum] keeps its value" {
    let src = "import std.io\ntype Color \{ Red, Green, Blue }\nfn clobber() \{ with arena \{ let mut t: List[Int] = []\n let mut i = 0\n while i < 4000 \{ t.push(-7)\n i = i + 1 } } }\nfn main() ! IO \{ let f: fn() -> Int = with arena \{ let c: Result[Int, Color] = Ok(42)\n fn() -> Int \{ match c \{ Ok(x) => \{ x } Err(_) => \{ -1 } } } }\n clobber()\n io.println(\"\{f()}\") }\n"
    let r = compile_test_helpers.compile_and_run(src, "arena_promote_result_enum")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "42\n")
}

test "a promoted closure capturing Option[List[Bytes]] keeps its list and elements" {
    // The carrier's C type (blink_Option_list) is element-erased, so the walker
    // must come from the tid: the Bytes elements are copied, not bit-copied.
    let src = "import std.io\nfn mk() -> List[Bytes] \{ [Bytes.from_str(\"hi\")] }\nfn clobber() \{ with arena \{ let mut t: List[Int] = []\n let mut i = 0\n while i < 4000 \{ t.push(-7)\n i = i + 1 } } }\nfn main() ! IO \{ let f: fn() -> Int = with arena \{ let c: Option[List[Bytes]] = Some(mk())\n fn() -> Int \{ match c \{ Some(l) => \{ l.len() * 100 + l.get(0).unwrap().len() } None => \{ -1 } } } }\n clobber()\n io.println(\"\{f()}\") }\n"
    let r = compile_test_helpers.compile_and_run(src, "arena_promote_option_list_bytes")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "102\n")
}

test "a promoted closure capturing an in-grammar Option[List[Int]] still compiles" {
    let src = "fn main() \{ let f: fn() -> Int = with arena \{ let c: Option[List[Int]] = Some([1, 2, 3])\n fn() -> Int \{ match c \{ Some(l) => \{ l.len() } None => \{ -1 } } } }\n let _ = f() }\n"
    compile_test_helpers.expect_no_error(src, "arena_promote_option_list_int", "E0702d")
}

test "a promoted closure capturing an in-grammar Result[Int, Str] still compiles" {
    let src = "fn main() \{ let f: fn() -> Int = with arena \{ let c: Result[Int, Str] = Ok(42)\n fn() -> Int \{ match c \{ Ok(x) => \{ x } Err(_) => \{ -1 } } } }\n let _ = f() }\n"
    compile_test_helpers.expect_no_error(src, "arena_promote_result_str", "E0702d")
}
