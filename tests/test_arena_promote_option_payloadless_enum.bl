// The arena promote-walker for Option[enum] must bit-copy the inline
// (by-value) enum inner, not treat it as a heap-boxed pointer the way a
// struct or generic-typevar inner is boxed.

import compile_test_helpers.{compile_and_run}

test.failing(
    "an Option[payload-less enum] promotes out of with-arena",
    reason: "the Option-inner arm of the arena promote-walker generator assumes the inner is heap-boxed and derefs it as a pointer (*src.value), but an inline enum inner is a plain unsigned int, so cc rejects both the deref and the pointer-to-value assignment",
    ticket: "mebv1h",
) {
    let src = #"
import std.io

type Color { Red, Green, Blue }

fn main() ! IO {
    let o: Option[Color] = with arena {
        let inner: Option[Color] = Some(Color.Green)
        inner
    }
    match o {
        Some(_) => io.println("some")
        None => io.println("none")
    }
}
"#
    let r = compile_and_run(src, "_arena_promote_option_payloadless_enum")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "some\n")
}
