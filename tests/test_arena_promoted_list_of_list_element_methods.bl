// The element of a with-arena-promoted List[List[Int]] must keep its own
// methods (.len) resolvable, not only the outer list's type and length.

import compile_test_helpers.{compile_and_run}

test "an element of a with-arena-promoted List[List[Int]] resolves its own methods" {
    let src = #"
import std.io
fn main() ! IO {
    let ys = with arena {
        let mut inner: List[Int] = []
        inner.push(9)
        inner.push(8)
        let mut outer: List[List[Int]] = []
        outer.push(inner)
        outer
    }
    let first = ys.get(0).unwrap()
    io.println("b={first.len()}")
}
"#
    let r = compile_and_run(src, "_arena_promoted_list_of_list_element_methods")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "b=2\n")
}
