// io.read_bytes(n) inside `with arena` must grow its buffer within the arena
// when n is larger than the first Bytes buffer. Standard input here is an
// in-memory fd moved onto fd 0, so the test needs no piped input.
import std.libc.{write_bytes}

@ffi("memfd_create", header: "sys/mman.h")
@trusted(audit: "TEST-STDIN-ARENA: anonymous in-memory fd to stand in for standard input")
fn t_memfd_create(name: Ptr[U8], flags: U32) -> I32 ! FFI {}

@ffi("lseek", header: "unistd.h")
@trusted(audit: "TEST-STDIN-ARENA: rewind the in-memory fd after the write")
fn t_lseek(fd: I32, offset: I64, whence: I32) -> I64 ! FS.Read {}

@ffi("dup2", header: "unistd.h")
@trusted(audit: "TEST-STDIN-ARENA: make the in-memory fd the standard input")
fn t_dup2(old_fd: I32, new_fd: I32) -> I32 ! FFI {}

@ffi("close", header: "unistd.h")
@trusted(audit: "TEST-STDIN-ARENA: close the in-memory fd")
fn t_close(fd: I32) -> I32 ! FFI {}

fn payload(n: Int) -> Bytes {
    let sb = StringBuilder.new()
    let mut i = 0
    while sb.len() < n {
        sb.write("{i % 10}")
        i += 1
    }
    Bytes.from_str(sb.to_str())
}

test "stdin read_bytes larger than the first buffer is intact inside an arena" {
    let want = payload(100000)
    let fd = with ffi.scope() as scope {
        let name = scope.cstr("blink_stdin_arena_test")
        t_memfd_create(name, 0.to_u32()).to_int()
    }
    assert(fd >= 0)
    let _ = write_bytes(fd, want)
    let _ = t_lseek(fd.to_i32(), 0, 0)
    assert(t_dup2(fd.to_i32(), 0.to_i32()).to_int() == 0)
    let _ = t_close(fd.to_i32())
    with arena {
        let got = io.read_bytes(want.len())
        assert_eq(got.len(), want.len())
        assert(got == want)
    }
}
