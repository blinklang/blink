import compile_test_helpers

// br 83hrmr — the + - * / % operators (and their += -= *= /= compound forms) only rejected
// MISMATCHED operand types via types_compatible; they never checked the operand was a built-in
// numeric. Two operands of the same NON-numeric type (struct+struct, @ffi.opaque+@ffi.opaque,
// Str-Str) passed typecheck and reached codegen, where only the C compiler might reject them —
// and pointer-typed operands such as an opaque handle could silently form pointer arithmetic
// (a - b is a valid ptrdiff in C). Arithmetic traits are sealed to built-in numeric types
// (sections/03_types.md:1988, sections/02_syntax.md:1046); operands must be numeric. All of these
// are now E0300 TypeError at typecheck.

fn struct_plus_struct_src() -> Str {
    #"type P { x: Int }
fn main() {
    let a = P { x: 1 }
    let b = P { x: 2 }
    let c = a + b
    io.println("done")
}
"#
}

test "struct plus struct is E0300" {
    compile_test_helpers.expect_compile_error(struct_plus_struct_src(), "83hrmr_struct_plus", "E0300")
}

fn struct_minus_star_src() -> Str {
    #"type P { x: Int }
fn main() {
    let a = P { x: 1 }
    let b = P { x: 2 }
    let c = a * b
    io.println("done")
}
"#
}

test "struct times struct is E0300" {
    compile_test_helpers.expect_compile_error(struct_minus_star_src(), "83hrmr_struct_star", "E0300")
}

// The pointer-arithmetic case: two opaque handles (received across the FFI boundary as fn
// params, since an opaque has no user-callable constructor) must not silently form ptrdiff.
fn opaque_minus_opaque_src() -> Str {
    #"@ffi.opaque(header: "stdio.h", name: "FILE")
type CFile
fn diff(a: CFile, b: CFile) -> CFile {
    a - b
}
fn main() {
    io.println("done")
}
"#
}

test "opaque minus opaque is E0300" {
    compile_test_helpers.expect_compile_error(opaque_minus_opaque_src(), "83hrmr_opaque_minus", "E0300")
}

// Str is non-numeric for -, *, /, % too (the + case already errors via StrPlusUnsupported).
fn str_minus_str_src() -> Str {
    #"fn main() {
    let a = "x"
    let b = "y"
    let c = a - b
    io.println("done")
}
"#
}

test "str minus str is E0300" {
    compile_test_helpers.expect_compile_error(str_minus_str_src(), "83hrmr_str_minus", "E0300")
}

// The compound-assignment form must not be a way around the rule.
fn struct_compound_assign_src() -> Str {
    #"type P { x: Int }
fn main() {
    let mut a = P { x: 1 }
    let b = P { x: 2 }
    a += b
    io.println("done")
}
"#
}

test "struct compound-assign is E0300" {
    compile_test_helpers.expect_compile_error(struct_compound_assign_src(), "83hrmr_struct_cassign", "E0300")
}

// Guards: legitimate numeric arithmetic must still typecheck cleanly.
fn int_arith_src() -> Str {
    #"fn main() {
    let a = 3
    let b = 4
    let c = a + b * 2 - 1
    io.println("c={c}")
}
"#
}

test "Int arithmetic still typechecks (no false E0300)" {
    compile_test_helpers.expect_no_error(int_arith_src(), "83hrmr_int_ok", "E0300")
}

fn float_arith_src() -> Str {
    #"fn main() {
    let a = 3.0
    let b = 4.0
    let c = a * b + 1.5
    io.println("c={c}")
}
"#
}

test "Float arithmetic still typechecks (no false E0300)" {
    compile_test_helpers.expect_no_error(float_arith_src(), "83hrmr_float_ok", "E0300")
}

fn sized_int_arith_src() -> Str {
    #"fn main() {
    let a: I32 = 10
    let c = a * 2 + 1
    io.println("c={c}")
}
"#
}

test "sized-int arithmetic with literal coercion still typechecks (no false E0300)" {
    compile_test_helpers.expect_no_error(sized_int_arith_src(), "83hrmr_sized_ok", "E0300")
}

// Unary minus desugars to Neg, the same sealed-arithmetic set — a non-numeric operand is
// rejected just like the binary forms.
fn neg_struct_src() -> Str {
    #"type P { x: Int }
fn main() {
    let a = P { x: 1 }
    let c = -a
    io.println("done")
}
"#
}

test "unary minus on a struct is E0300" {
    compile_test_helpers.expect_compile_error(neg_struct_src(), "83hrmr_neg_struct", "E0300")
}

fn neg_numeric_src() -> Str {
    #"fn main() {
    let a = 5
    let b = -a
    let c = -3.0
    let d = -7
    io.println("b={b} c={c} d={d}")
}
"#
}

test "unary minus on numerics still typechecks (no false E0300)" {
    compile_test_helpers.expect_no_error(neg_numeric_src(), "83hrmr_neg_ok", "E0300")
}

fn int_compound_assign_src() -> Str {
    #"fn main() {
    let mut a = 5
    a += 3
    a *= 2
    io.println("a={a}")
}
"#
}

test "Int compound-assign still typechecks (no false E0300)" {
    compile_test_helpers.expect_no_error(int_compound_assign_src(), "83hrmr_cassign_ok", "E0300")
}
