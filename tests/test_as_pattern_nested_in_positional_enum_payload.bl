// An as-pattern nested INSIDE a positional/enum-payload slot (`Some(x as y)`),
// as opposed to a whole-scrutinee as-pattern at the top of a match arm
// (`whole as Some(v)`), binds both the pre-'as' and post-'as' names.

import compile_test_helpers.{compile_and_run}

test "an as-pattern nested inside a positional Some(..) payload binds both names" {
    let src = #"
import std.io

fn main() ! IO {
    let o: Option[Int] = Some(3)
    match o { Some(x as y) => { io.println("{x} {y}") } None => {} }
}
"#
    let r = compile_and_run(src, "_as_pattern_nested_positional_payload")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "3 3\n")
}
