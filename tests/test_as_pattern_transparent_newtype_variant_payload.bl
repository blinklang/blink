import compile_test_helpers

// An as-pattern whole-binder over a data-enum variant payload whose type is
// the transparent-newtype Errno must declare the binder with the same
// representation (bare int64_t) that the payload field itself uses.

fn as_pattern_errno_payload_src() -> Str {
    #"import std.io

pub type Errno { Errno(Int) }
type Box2 {
    Hold(Errno)
    Nope(Int)
}
fn main() ! IO {
    let b = Box2.Hold(Errno(13))
    let r = match b {
        Box2.Hold(e as Errno) => match e { Errno(rc) => rc }
        Box2.Nope(k) => k
    }
    io.println("r={r}")
}
"#
}

test.failing(
    "as-pattern binder over an Errno variant payload compiles and yields the payload value",
    reason: "the as-pattern binder is declared int64_t (transparent-newtype lowering) while the enum-payload field it copies from is typed as the nominal blink_Errno struct, so the C initializer disagrees",
) {
    let r = compile_test_helpers.compile_and_run(as_pattern_errno_payload_src(), "_as_pattern_errno")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "r=13\n")
}
