// assert_eq / assert_ne over a struct, an enum, a Result and an Option: each compares its
// value structurally (field by field, tag then payload) rather than refusing to lower.

type AggPoint {
    x: Int
    y: Int
}

type AggLabel {
    name: Str
    count: Int
}

type AggInner {
    value: Int
}

type AggOuter {
    label: Str
    inner: AggInner
}

type AggSignal {
    Red
    Green
    Blue
}

type AggShape {
    Dot
    Circle { radius: Int }
}

test "assert_eq on two equal structs" {
    let a = AggPoint { x: 1, y: 2 }
    let b = AggPoint { x: 1, y: 2 }
    assert_eq(a, b)
}

test "assert_eq on a struct with a Str field" {
    let a = AggLabel { name: "left", count: 3 }
    let b = AggLabel { name: "left", count: 3 }
    assert_eq(a, b)
}

test "assert_eq on a struct nested inside another struct" {
    let a = AggOuter { label: "outer", inner: AggInner { value: 7 } }
    let b = AggOuter { label: "outer", inner: AggInner { value: 7 } }
    assert_eq(a, b)
}

test "assert_eq on an enum's unit variant" {
    let a = AggSignal.Red
    let b = AggSignal.Red
    assert_eq(a, b)
}

test "assert_eq on an enum's payload variant" {
    let a = AggShape.Circle { radius: 5 }
    let b = AggShape.Circle { radius: 5 }
    assert_eq(a, b)
}

test "assert_eq on two equal Ok results" {
    let a: Result[Int, Str] = Ok(9)
    let b: Result[Int, Str] = Ok(9)
    assert_eq(a, b)
}

test "assert_ne on an Ok result against an Err result" {
    let a: Result[Int, Str] = Ok(9)
    let b: Result[Int, Str] = Err("bad")
    assert_ne(a, b)
}

test "assert_eq on a Some option against a None option compares by tag" {
    let a: Option[Int] = Some(4)
    let b: Option[Int] = None
    assert_ne(a, b)
}

test "assert_ne on two structs that differ" {
    let a = AggPoint { x: 1, y: 2 }
    let b = AggPoint { x: 1, y: 3 }
    assert_ne(a, b)
}
