// assert_eq and assert_ne take two values of one type. A U8 against a U8, or against an
// integer literal the U8 types, compares the bytes; a real mismatch fails the assert. An
// assert failure is not a panic `assert_panics` catches, so each failing case runs as a
// child test and its status is read.

import compile_test_helpers.{compile_and_run_test_json}

fn child_fails(src: Str, tag: Str, want: Str) {
    let r = compile_and_run_test_json(src, tag)
    assert(r.out.contains("\"status\":\"failed\""))
    assert(!r.out.contains("\"status\":\"passed\""))
    assert(r.out.contains(want))
}

test "equal U8 values and U8 literals pass" {
    let u: U8 = 200
    let v: U8 = 200
    assert_eq(u, v)
    assert_eq(u, 200)
    assert_ne(u, 201)
    assert_eq("abc".byte_at(0), 97)
}

test "two U8 values that differ fail assert_eq" {
    child_fails(#"test "t" {
    let u: U8 = 200
    let w: U8 = 199
    assert_eq(u, w)
}
"#, "aeq_bytes_differ", "200 != 199")
}

test "a U8 equal to its literal fails assert_ne" {
    child_fails(#"test "t" {
    let u: U8 = 200
    assert_ne(u, 200)
}
"#, "aeq_bytes_same", "200 == 200")
}

test "a bare carrier on either side takes the other side's type" {
    let r: Result[Int, Str] = Ok(1)
    assert_eq(r, Ok(1))
    let o: Option[Int] = None
    assert_eq(None, o)
    assert_ne(Some(2), Some(3))
}
