// assert_eq and assert_ne compare with `==` (sections/02_syntax.md, test assertions), so a
// List, Set, Map or tuple compares by its elements, not by where it lives. Two lists built
// apart with the same elements are equal; a lone NaN equals itself, as `==` says; and each
// argument is evaluated once, left to right.

import compile_test_helpers.{compile_and_run_test_json}

@derive(Eq)
type ByValPoint {
    x: Int
    y: Int
}

@derive(Eq)
type ByValBox {
    items: List[Int]
}

type ByValSlot {
    Held(n: Int)
    Empty
}

fn by_val_list(n: Int) -> List[Int] {
    let mut xs: List[Int] = []
    let mut i = 0
    while i < n {
        xs.push(i)
        i = i + 1
    }
    xs
}

fn by_val_logged(log: List[Str], tag: Str) -> List[Int] {
    log.push(tag)
    by_val_list(2)
}

// An assertion failure fails its test rather than panicking, so the failing direction runs
// in a fixture and is read back from the runner's report.
fn by_val_fixture_report(tag: Str, body: Str) -> Str {
    let lists = "fn mk(n: Int) -> List[Int] \{\n    let mut xs: List[Int] = []\n    let mut i = 0\n    while i < n \{\n        xs.push(i)\n        i = i + 1\n    }\n    xs\n}\n\n"
    let r = compile_and_run_test_json("{lists}test \"t\" \{\n    {body}\n}\n", tag)
    "{r.out}{r.err_out}"
}

test "assert_eq on two lists built apart with the same elements" {
    assert_eq(by_val_list(3), by_val_list(3))
    assert_eq([1, 2, 3], [1, 2, 3])
}

test "assert_ne on two lists built apart with the same elements fails" {
    let out = by_val_fixture_report("_byval_ne_equal", "assert_ne(mk(3), mk(3))")
    assert(out.contains("\"status\":\"failed\""))
    assert(out.contains("ASSERT_NE FAILED"))
}

test "assert_eq on two lists with different elements fails" {
    let out = by_val_fixture_report("_byval_eq_differ", "assert_eq(mk(3), mk(4))")
    assert(out.contains("\"status\":\"failed\""))
    assert(out.contains("ASSERT_EQ FAILED"))
    assert_ne(by_val_list(3), by_val_list(4))
}

test "assert_eq on two equal lists passes in a fixture too" {
    let out = by_val_fixture_report("_byval_eq_same", "assert_eq(mk(3), mk(3))")
    assert(out.contains("\"status\":\"passed\""))
}

test "assert_eq on lists of Str compares the strings" {
    let a = ["a", "b"]
    let b = ["a".concat(""), "b"]
    assert_eq(a, b)
}

test "assert_eq on sets compares their members" {
    let mut a: Set[Int] = Set.new()
    let mut b: Set[Int] = Set.new()
    a.insert(1)
    a.insert(2)
    b.insert(2)
    b.insert(1)
    assert_eq(a, b)
    b.insert(3)
    assert_ne(a, b)
}

test "assert_eq on maps compares keys and values" {
    let mut a: Map[Str, List[Int]] = Map.new()
    let mut b: Map[Str, List[Int]] = Map.new()
    a.insert("k", by_val_list(2))
    b.insert("k", by_val_list(2))
    assert_eq(a, b)
    b.insert("k", by_val_list(3))
    assert_ne(a, b)
}

test "assert_eq on tuples compares each part" {
    let a = (1, "one", by_val_list(2))
    let b = (1, "one", by_val_list(2))
    assert_eq(a, b)
    assert_ne(a, (1, "two", by_val_list(2)))
}

test "assert_eq on nested containers" {
    let a: List[Option[ByValPoint]] = [Some(ByValPoint { x: 1, y: 2 }), None]
    let b: List[Option[ByValPoint]] = [Some(ByValPoint { x: 1, y: 2 }), None]
    assert_eq(a, b)
    assert_ne(a, [Some(ByValPoint { x: 1, y: 3 }), None])
}

test "assert_eq on a struct with a List field compares the list" {
    assert_eq(ByValBox { items: by_val_list(2) }, ByValBox { items: by_val_list(2) })
    assert_ne(ByValBox { items: by_val_list(2) }, ByValBox { items: by_val_list(1) })
}

test "assert_eq on a payload enum with no derive compares its payload" {
    assert_eq(ByValSlot.Held(4), ByValSlot.Held(4))
    assert_ne(ByValSlot.Held(4), ByValSlot.Held(5))
    assert_ne(ByValSlot.Held(4), ByValSlot.Empty)
}

test "a NaN inside a container equals itself, as == says" {
    let nan = 0.0 / 0.0
    assert_eq([nan], [nan])
    assert_eq((nan, 1), (nan, 1))
}

test "each argument is evaluated once, left to right" {
    let mut log: List[Str] = []
    assert_eq(by_val_logged(log, "left"), by_val_logged(log, "right"))
    assert_eq(log, ["left", "right"])
}
