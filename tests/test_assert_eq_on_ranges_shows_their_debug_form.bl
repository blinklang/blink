// assert_eq and assert_ne compare two ranges with the `==` of Range (start, end and kind),
// and a failure message shows each side in its debug form (sections/03_types.md §3.6
// *Traits of Range[T]*: `assert_eq(r, 0..=2)` panics with a message that shows 0..3 and 0..=2).

import compile_test_helpers.{compile_and_run_test_json}

// An assertion failure fails its test rather than panicking, so the failing direction runs
// in a fixture and is read back from the runner's report.
fn range_assert_report(tag: Str, body: Str) -> Str ! FS.Delete, FS.Read, FS.Write, Process.Spawn, Env.Read {
    let r = compile_and_run_test_json("test \"t\" \{\n    {body}\n}\n", tag)
    "{r.out}{r.err_out}"
}

test "assert_eq passes on two equal ranges" {
    let r = 0..3
    assert_eq(r, 0..3)
    assert_eq(1..=4, 1..=4)
}

test "assert_ne passes on ranges that differ only in kind" {
    assert_ne(0..3, 0..=2)
    assert_ne(5..3, 0..0)
}

test "assert_eq on ranges of another kind fails and shows both ranges" {
    let out = range_assert_report("_range_assert_eq_kind", "let r = 0..3\n    assert_eq(r, 0..=2)")
    assert(out.contains("\"status\":\"failed\""), out)
    assert(out.contains("ASSERT_EQ FAILED: 0..3 != 0..=2"), out)
}

test "assert_ne on two equal ranges fails and shows both ranges" {
    let out = range_assert_report("_range_assert_ne_same", "assert_ne(1..=4, 1..=4)")
    assert(out.contains("\"status\":\"failed\""), out)
    assert(out.contains("ASSERT_NE FAILED: 1..=4 == 1..=4"), out)
}

test "assert_eq on ranges of Str shows each bound quoted" {
    let out = range_assert_report("_range_assert_eq_str", "assert_eq(\"a\"..\"b\", \"a\"..\"c\")")
    assert(out.contains("ASSERT_EQ FAILED: \\\"a\\\"..\\\"b\\\" != \\\"a\\\"..\\\"c\\\""), out)
}
