// Spec §2.20: assertion failure panics, and a panic outside a test terminates
// the process. The exit status is not named by the spec; 1 matches the
// runtime panic path.

import compile_test_helpers.{compile_and_run, compile_and_run_test_json}

test "a failing assert in main reports the assertion and exits 1" {
    let r = compile_and_run("fn main() \{\n    assert(1 == 2)\n}\n", "_assert_outside_plain")
    assert_eq(r.exit_code, 1)
    assert(r.err_out.contains("assertion failed: assert(1 == 2)"))
    assert(r.err_out.contains("--> "))
}

test "a failing assert_eq in main reports both values and exits 1" {
    let r = compile_and_run("fn main() \{\n    assert_eq(1, 2)\n}\n", "_assert_outside_eq")
    assert_eq(r.exit_code, 1)
    assert(r.err_out.contains("1 != 2"))
}

test "a failing Str assert in main reports the assertion and exits 1" {
    let src = "fn main() \{\n    let a = \"xy\"\n    let b = \"lo\"\n    assert(a == b)\n}\n"
    let r = compile_and_run(src, "_assert_outside_str")
    assert_eq(r.exit_code, 1)
    assert(r.err_out.contains("assertion failed: assert(a == b)"))
}

test "a failing assert with a message in main reports the message and exits 1" {
    let r = compile_and_run("fn main() \{\n    assert(1 == 2, \"custom note\")\n}\n", "_assert_outside_msg")
    assert_eq(r.exit_code, 1)
    assert(r.err_out.contains("assertion failed: assert(1 == 2)"))
    assert(r.err_out.contains("custom note"))
}

test "a failing assert_ne in main reports the value and exits 1" {
    let r = compile_and_run("fn main() \{\n    assert_ne(1, 1)\n}\n", "_assert_outside_ne")
    assert_eq(r.exit_code, 1)
    assert(r.err_out.contains("1 == 1"))
}

test "a failing assert in a helper fn exits 1 and keeps earlier stdout" {
    let src = "fn check(n: Int) \{\n    assert(n > 5)\n}\n\nfn main() \{\n    io.println(\"before\")\n    check(3)\n    io.println(\"after\")\n}\n"
    let r = compile_and_run(src, "_assert_outside_helper")
    assert_eq(r.exit_code, 1)
    assert(r.out.contains("before"))
    assert(!r.out.contains("after"))
    assert(r.err_out.contains("assertion failed: assert(n > 5)"))
}

test "a passing assert in main exits 0" {
    let r = compile_and_run("fn main() \{\n    assert(1 == 1)\n    io.println(\"done\")\n}\n", "_assert_outside_pass")
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("done"))
}

test "a failing assert inside a test still fails that test and the runner continues" {
    let src = "test \"first\" \{\n    assert(1 == 2)\n}\n\ntest \"second\" \{\n    assert(1 == 1)\n}\n"
    let r = compile_and_run_test_json(src, "_assert_outside_runner_control")
    assert(r.out.contains("\"cause\":\"assertion\""))
    assert(r.out.contains("\"passed\":1"))
    assert(r.out.contains("\"failed\":1"))
}
