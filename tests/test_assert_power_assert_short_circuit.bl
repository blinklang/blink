// C's && and || skip their right operand; assert's power-assert decomposition must not
// change that. A decomposition that binds both operands to temporaries ahead of the
// operator (the way every other decomposed comparison works) would run the right operand
// even when the left one alone decides the result -- an assert must not change what the
// program does.

let mut right_ran = false

fn right_side_or(v: Bool) -> Bool {
    right_ran = true
    v
}

fn right_side_and(v: Bool) -> Bool {
    right_ran = true
    v
}

test "assert on an or condition does not run the right operand when the left settles it" {
    right_ran = false
    let a = true
    assert(a || right_side_or(true))
    assert(!right_ran)
}

test "assert on an and condition does not run the right operand when the left settles it" {
    right_ran = false
    let b = false
    assert(!(b && right_side_and(true)))
    assert(!right_ran)
}

test "assert on an or condition still runs the right operand when the left does not settle it" {
    right_ran = false
    let c = false
    assert(c || right_side_or(true))
    assert(right_ran)
}

test "assert on an and condition still runs the right operand when the left does not settle it" {
    right_ran = false
    let d = true
    assert(d && right_side_and(true))
    assert(right_ran)
}
