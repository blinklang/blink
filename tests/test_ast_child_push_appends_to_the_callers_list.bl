// A walker that visits every node passes one list down and lets each node append its children
// to it, so the push forms must append after whatever the caller already holds and never clear
// it. The bucket reads of the table keep a sublist as its id; only the parser's value and
// spelling walks, which read the slot walk's slots, expand it.

import parser.{node_count, node_push, node_push_value_child_ids, node_push_spell_child_ids, node_value_child_ids, new_sublist, sublist_push, finalize_sublist}
import ast.{NodeKind, AstNode, ChildWalk, node_child_ids_into}

fn sublist_of(a: Int, b: Int) -> Int ! Parse.Build {
    let sl = new_sublist()
    sublist_push(sl, a)
    sublist_push(sl, -1)
    sublist_push(sl, b)
    finalize_sublist(sl)
    sl
}

// `f(x)[T]`: callee, two args, one explicit type argument.
fn call_node(args: Int, tps: Int) -> Int {
    let id = node_count()
    node_push(AstNode { kind: NodeKind.Call, left: 900, args: args, type_params: tps })
    id
}

test "a push appends after what the list already holds" {
    let call = call_node(sublist_of(901, 902), sublist_of(903, 904))
    let mut out: List[Int] = [7, 8]
    node_push_value_child_ids(call, out)
    assert_eq(out, [7, 8, 900, 901, 902])
    node_push_spell_child_ids(call, out)
    assert_eq(out, [7, 8, 900, 901, 902, 903, 904])
}

test "two nodes pushed in turn keep their own order" {
    let a = call_node(sublist_of(911, 912), -1)
    let b = call_node(-1, -1)
    let mut out: List[Int] = []
    node_push_value_child_ids(a, out)
    node_push_value_child_ids(b, out)
    assert_eq(out, [900, 911, 912, 900])
    assert_eq(node_value_child_ids(a), [900, 911, 912])
}

test "a bucket read keeps a sublist as its id" {
    let args = sublist_of(921, 922)
    let tps = sublist_of(923, 924)
    let node = AstNode { kind: NodeKind.Call, left: 900, args: args, type_params: tps }
    let pool = [node]
    let mut refs: List[Int] = []
    node_child_ids_into(pool, 0, ChildWalk.ValueRefs, refs)
    assert_eq(refs, [900])
    let mut lists: List[Int] = []
    node_child_ids_into(pool, 0, ChildWalk.ValueLists, lists)
    assert_eq(lists, [args])
    let mut spell_refs: List[Int] = []
    node_child_ids_into(pool, 0, ChildWalk.SpellRefs, spell_refs)
    assert_eq(spell_refs.len(), 0)
    let mut spell_lists: List[Int] = []
    node_child_ids_into(pool, 0, ChildWalk.SpellLists, spell_lists)
    assert_eq(spell_lists, [tps])
}
