// sections/03_types.md:1184 — an enum is nominally distinct from `Int`, and matching an
// `Int` scrutinee against enum-variant patterns is the pattern-side dual of that rule and
// likewise ill-typed. node_kind_name used to take a raw `Int` and match it against
// `NodeKind.*` arms, so the match was ill-typed by the rule above and silently
// non-exhaustive: a kind added without a spelling fell through to the catch-all instead of
// failing to compile.
//
// node_kind_name now takes a NodeKind, and the AST stores a NodeKind, so no caller holds a
// bare tag to hand it. A tag outside the kind set cannot reach the speller at all; NK_ALL is
// the only way from a tag to a kind, and it has no entry past the last real kind.
import std.io
import ast.{NodeKind, NK_ALL, nk_tag, node_kind_name}

fn fail(label: Str, got: Str, want: Str) {
    io.println("FAIL: {label}: answered '{got}', want '{want}'")
}

// The first tag whose kind, reached through NK_ALL, spells differently from the kind read
// back through its own tag, or -1 when they agree everywhere.
fn first_disagreeing_tag() -> Int {
    let mut t = 0
    while t < NK_ALL.len() {
        let k = NK_ALL.get(t).unwrap()
        if node_kind_name(NK_ALL.get(nk_tag(k)).unwrap()) != node_kind_name(k) { return t }
        t = t + 1
    }
    -1
}

// The first kind node_kind_name leaves unspelled, or -1 when every kind has its own name. An
// arm that fell through to a shared catch-all would show up here as a repeat.
fn first_unspelled_tag() -> Int {
    let mut t = 0
    while t < NK_ALL.len() {
        let n = node_kind_name(NK_ALL.get(t).unwrap())
        if n == "" || n == "Unknown" { return t }
        let mut u = 0
        while u < t {
            if node_kind_name(NK_ALL.get(u).unwrap()) == n { return t }
            u = u + 1
        }
        t = t + 1
    }
    -1
}

test "every NodeKind spells its own name, so no kind shares an arm" {
    let t = first_unspelled_tag()
    if t >= 0 { fail("tag {t}", node_kind_name(NK_ALL.get(t).unwrap()), "a name of its own") }
    assert(t == -1)
}

test "a kind reached through its tag spells what the kind itself spells" {
    let t = first_disagreeing_tag()
    if t >= 0 { fail("tag {t}", "a different name", node_kind_name(NK_ALL.get(t).unwrap())) }
    assert(t == -1)
}

test "KindCount is spelled, because a walk over the kinds stops on it" {
    let got = node_kind_name(NodeKind.KindCount)
    if got != "KindCount" { fail("KindCount", got, "KindCount") }
    assert(got == "KindCount")
}

// A tag outside the kind set has no kind, so it has no spelling to give: NK_ALL answers None
// rather than a plausible-wrong kind.
test "a tag outside the kind set reaches no kind" {
    assert(NK_ALL.get(0 - 1).is_none())
    assert(NK_ALL.get(nk_tag(NodeKind.KindCount)).is_none())
}
