// E0650: a closure passed to async.spawn may not capture a `let mut` (§2.8). This file
// holds the captures that stay legal. The rejected shapes, checked by compiling them, are in
// test_spawn_rejects_mutable_capture.bl.

test "immutable capture" {
    let x = 10
    let y = 20
    let h = async.spawn(fn() {
        x + y
    })
    let result = h.await
    assert_eq(result, 30)
}

test "multiple immutable captures" {
    let a = 100
    let b = 200
    let c = 300
    async.scope {
        let h1 = async.spawn(fn() {
            a + b + c
        })
        let r1 = h1.await
        assert_eq(r1, 600)
    }
}

test "capture of computed value" {
    let computed = 7 * 8
    let h2 = async.spawn(fn() {
        computed + 1
    })
    let r2 = h2.await
    assert_eq(r2, 57)
}
