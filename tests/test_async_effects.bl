// Test: fns that use async.scope and async.spawn declare ! Async (§4.4)

// async.scope needs ! Async in the row
fn helper_scope_declares_effect() ! Async {
    async.scope {
        let x = 42
        x + 1
    }
}

// A second async.scope user with the same row
fn helper_with_effect() ! Async {
    async.scope {
        let x = 42
        x + 1
    }
}

// async.spawn needs ! Async in the row
fn spawner_declares_effect() ! Async {
    let h = async.spawn(fn() {
        10
    })
    h.await
}

// A spawned task may not capture a `let mut` (E0650), so it gets a copy
fn test_mut_capture() ! Async {
    let mut counter = 0
    counter += 1
    let snapshot = counter
    let h = async.spawn(fn() {
        snapshot + 1
    })
    h.await
}

// No error: immutable variable captured by async.spawn — should pass
fn test_immutable_capture() ! Async {
    let x = 42
    let h = async.spawn(fn() {
        x + 1
    })
    h.await
}

fn main() {
    io.println("async effect tests")
}
