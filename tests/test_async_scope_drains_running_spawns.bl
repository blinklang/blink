// async.scope's own lowering, proven by timing rather than by message delivery: a channel
// recv blocks regardless of whether the scope drains anything, so it cannot tell a joined
// scope from a leaked one. Elapsed wall time can.

fn spawn_then_return_early() -> Int {
    async.scope {
        let _h = async.spawn(fn() {
            time.sleep(Duration.ms(30))
        })
        return 7
    }
    99
}

test "the scope's value is its body's tail expression" {
    let scoped = async.scope {
        let x = 5
        x * 10
    }
    assert_eq(scoped, 50)
}

test "a sleeping spawn left un-awaited is complete once the scope ends" {
    let start = time.read()
    async.scope {
        let _h = async.spawn(fn() {
            time.sleep(Duration.ms(30))
        })
    }
    let elapsed = start.elapsed()
    assert(elapsed.to_ms() >= 25)
}

test "an early return out of the scope's body still drains a still-running spawn" {
    let start = time.read()
    let r = spawn_then_return_early()
    let elapsed = start.elapsed()
    assert_eq(r, 7)
    assert(elapsed.to_ms() >= 25)
}
