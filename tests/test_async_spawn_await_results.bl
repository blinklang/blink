import std.io

type SpawnPoint { x: Int, y: Int }

test "spawn returning Int, awaited" {
    let h = async.spawn(fn() -> Int {
        21 + 21
    })
    assert_eq(h.await, 42)
}

test "spawn returning Float, awaited" {
    let h = async.spawn(fn() -> Float {
        1.5 + 2.25
    })
    assert_eq(h.await, 3.75)
}

test "spawn returning a by-value struct, awaited" {
    let h = async.spawn(fn() -> SpawnPoint {
        SpawnPoint { x: 3, y: 4 }
    })
    let p = h.await
    assert_eq(p.x, 3)
    assert_eq(p.y, 4)
}

test "spawn returning Result Ok, awaited" {
    let h = async.spawn(fn() -> Result[Int, Str] {
        Ok(7)
    })
    let res = h.await
    assert_eq(res.is_ok(), true)
    assert_eq(res.unwrap(), 7)
}

test "spawn returning nothing, awaited" {
    let h = async.spawn(fn() {
        io.println("spawned task ran")
    })
    h.await
    assert_eq(true, true)
}

test "channel close after send drains the remaining values" {
    let ch = channel.new[Int](buffer: 4)
    ch.send(1)
    ch.send(2)
    ch.close()
    let mut sum = 0
    for v in ch {
        sum = sum + v
    }
    assert_eq(sum, 3)
}
