import compile_test_helpers

// A bare multi-variant data enum returned through async.spawn/await must be
// unboxed by value at the await site, not treated as a bare int64_t.

fn spawn_data_enum_src() -> Str {
    #"type Color {
    Red(Int)
    Green
    Blue
}
fn mk() -> Color { Color.Red(255) }
fn main() ! IO {
    async.scope {
        let h = async.spawn(fn() { mk() })
        let c = h.await
        let n = match c {
            Red(x) => x
            Green => 0
            Blue => 0
        }
        io.println("n={n}")
    }
}
"#
}

test.failing(
    "async.spawn of a bare data enum compiles and awaits the correct payload",
    reason: "the await site declares the enum result as a bare int64_t instead of the struct type, so cc rejects the by-value assignment",
    ticket: "pt6bgw",
) {
    let r = compile_test_helpers.compile_and_run(spawn_data_enum_src(), "_async_data_enum")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "n=255\n")
}
