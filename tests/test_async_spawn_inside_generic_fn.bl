import compile_test_helpers

// async.spawn used inside a generic function's mono instance must have the
// thread pool symbol in scope, same as the non-generic equivalent does.

fn async_spawn_generic_fn_src() -> Str {
    #"fn run[T](x: T) -> Int {
    let h = async.spawn(fn() -> Int { 42 })
    h.await
}
fn main() ! IO {
    io.println("v={run(7)}")
}
"#
}

test.failing(
    "async.spawn inside a generic function compiles",
    reason: "the threadpool-submit call in the mono-instance body references __blink_pool, which is missing from the generic-fn mono emission context (the identical shape in a non-generic fn compiles fine)",
    ticket: "g1c92b",
) {
    let r = compile_test_helpers.compile_and_run(async_spawn_generic_fn_src(), "_async_generic")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "v=42\n")
}
