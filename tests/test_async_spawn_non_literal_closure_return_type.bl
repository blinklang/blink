import compile_test_helpers

// async.spawn of a closure held in a variable (not a literal closure
// expression) must still carry the task's real return type through to the
// Handle and the await site, instead of erasing it.

fn async_spawn_indirect_closure_src() -> Str {
    #"type Node { n: Int }
fn main() ! IO {
    let f = fn() -> Node {
        Node { n: 5 }
    }
    let h = async.spawn(f)
    let v = h.await
    io.println("n={v.n}")
}
"#
}

test.failing(
    "async.spawn of a non-literal closure preserves the return type",
    reason: "typecheck's async.spawn arm only memoizes a Handle tid for a literal NodeKind.Closure argument, so a closure held in a variable gets no Handle tid; codegen skips set_var_ty and both the let-binding for the handle and the await result have no spellable C type at codegen",
) {
    let r = compile_test_helpers.compile_and_run(async_spawn_indirect_closure_src(), "_async_indirect")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "n=5\n")
}
