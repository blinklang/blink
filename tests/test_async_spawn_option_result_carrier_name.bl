import compile_test_helpers

// An Option[Result[Int, Str]] value produced through async.spawn/await must
// keep its full carrier name; the inner Result argument must not be dropped
// from the spawn wrapper's and await site's spelling of the Option type.

fn async_option_result_src() -> Str {
    #"fn f() -> Option[Result[Int, Str]] { Some(Ok(3)) }
fn main() {
    async.scope {
        let h = async.spawn(fn() { f() })
        let o = h.await
        io.println("v={o.unwrap().unwrap()}")
    }
}
"#
}

test.failing(
    "async.spawn of Option[Result[Int, Str]] compiles and awaits the correct value",
    reason: "the spawn task's return type and the await-side unwrap declare an undeclared blink_Option_result, dropping the inner Result argument from the carrier name",
    ticket: "5fs3q7",
) {
    let r = compile_test_helpers.compile_and_run(async_option_result_src(), "_async_option_result")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "v=3\n")
}
