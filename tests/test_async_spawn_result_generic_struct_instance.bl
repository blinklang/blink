import compile_test_helpers

// async.spawn of a closure returning Result[GenericStruct[T], E] must
// monomorphize the ok type consistently between the spawn wrapper's return
// type and the closure body's constructed value.

fn async_result_generic_struct_src() -> Str {
    #"type Box[T] { value: T }
fn main() {
    async.scope {
        let h = async.spawn(fn() -> Result[Box[Int], Str] { Ok(Box { value: 7 }) })
        let r = h.await
        io.println("v={r.unwrap().value}")
    }
}
"#
}

test.failing(
    "async.spawn of Result[Box[Int], Str] compiles and awaits the correct value",
    reason: "the spawn wrapper and await sites name the ok type from the bare generic head (Box), while the closure body constructs the monomorphized instance (Box_0Int), so the emitted C types disagree",
    ticket: "n84y9z",
) {
    let r = compile_test_helpers.compile_and_run(async_result_generic_struct_src(), "_async_result_generic")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "v=7\n")
}
