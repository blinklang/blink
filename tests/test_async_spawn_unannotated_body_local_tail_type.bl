// The body of an un-annotated `async.spawn(fn() { ... })` is inferred from
// OUTSIDE the closure's own scope, so a tail expression that reads a binding
// declared INSIDE the body has no visible type there and the Handle's payload
// type stays unpinned. The MVCE's runtime value is correct (3), so the
// observable defect is at the frontend: `let v: Str = h.await` against a
// spawn body that yields Int must be rejected with error[TypeError] like any
// other Str/Int mismatch, instead of reaching cc as a raw pointer/integer
// conversion error. Distinct from spawn bodies that are a single-expression
// tail or a call to a helper declared outside the closure, which are pinned.

import compile_test_helpers.{expect_compile_error}

test.failing(
    "awaiting an un-annotated spawn's body-local tail with the wrong type is rejected at typecheck",
    reason: "the spawned closure body is inferred outside its own scope, so a tail expression reading a binding declared inside the body has no visible type there; the Handle payload stays unpinned, so a wrongly-typed .await consumer is not caught as TypeError and instead reaches the C compiler as a raw pointer/integer conversion failure",
    ticket: "h8scwq",
) {
    let src = #"
import std.io
fn main() {
    async.scope {
        let h = async.spawn(fn() {
            let xs: List[Int] = [1, 2, 3]
            xs.len()
        })
        let v: Str = h.await
        io.println(v)
    }
}
"#
    expect_compile_error(src, "_async_spawn_unannotated_body_local_tail_type", "TypeError")
}
