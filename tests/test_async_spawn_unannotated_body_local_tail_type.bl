// The body of an un-annotated `async.spawn(fn() { ... })` is inferred from
// OUTSIDE the closure's own scope, where a binding declared inside the body is
// unbound. The typechecker must still pin the Handle's payload from the body's
// in-scope type, so a wrongly-typed `.await` consumer such as
// `let v: Str = h.await` against an Int body is rejected with error[TypeError]
// like any other Str/Int mismatch, and never reaches cc as a raw
// pointer/integer conversion error.

import compile_test_helpers.{expect_compile_error}

test "awaiting an un-annotated spawn's body-local tail with the wrong type is rejected at typecheck" {
    let src = #"
import std.io
fn main() {
    async.scope {
        let h = async.spawn(fn() {
            let xs: List[Int] = [1, 2, 3]
            xs.len()
        })
        let v: Str = h.await
        io.println(v)
    }
}
"#
    expect_compile_error(src, "_async_spawn_unannotated_body_local_tail_type", "TypeError")
}
