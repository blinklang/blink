// Test: blink build/run auto-resolves dependencies when blink.lock is missing or stale.
// Sets up a project with blink.toml + path dep, no lockfile, and verifies
// that build/blink build auto-generates blink.lock and compiles successfully.

import compile_test_helpers

fn main() {
    let base = "{compile_test_helpers.scratch_root()}/_test_auto_resolve"
    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {base}/src"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {base}/deps/mylib/src"]).unwrap()

    // Write the dependency source
    fs.write("{base}/deps/mylib/src/mylib.bl", "pub fn greet() -> Str \{\n    \"hello-auto\"\n\}\n").unwrap()
    fs.write("{base}/deps/mylib/blink.toml", "[package]\nname = \"mylib\"\nversion = \"0.1.0\"\n").unwrap()

    // Write blink.toml with a path dependency — NO blink.lock
    fs.write("{base}/blink.toml", "[package]\nname = \"testproj\"\nversion = \"0.1.0\"\n\n[dependencies]\nmylib = \{ path = \"deps/mylib\" \}\n").unwrap()

    // Write main source that imports the dependency
    fs.write("{base}/src/main.bl", "import mylib.\{greet\}\n\nfn main() \{\n    io.println(greet())\n\}\n").unwrap()

    // Verify no lock file exists yet
    if compile_test_helpers.path_exists("{base}/blink.lock") || compile_test_helpers.path_exists("{base}/blink.lock") {
        io.println("FAIL: lock file should not exist before build")
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        return
    }

    // Build using build/blink — should auto-resolve deps
    let build_run = process.run("sh", ["-c", "cd {base} && {env.cwd()}/build/blink build src/main.bl -o build/main > build_log.txt 2>&1"]).unwrap()
    let build_log = fs.read("{base}/build_log.txt").unwrap()

    if !build_run.success() {
        io.println("FAIL: build failed ({build_run.end})")
        io.println(build_log)
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        return
    }

    // Verify lock file was auto-created
    if compile_test_helpers.path_exists("{base}/blink.lock") || compile_test_helpers.path_exists("{base}/blink.lock") {
        io.println("PASS: lock file auto-created by build")
    } else {
        io.println("FAIL: lock file was not created by build")
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        return
    }

    // Verify binary runs correctly
    process.run("sh", ["-c", "{base}/build/main > {base}/run_output.txt 2>&1 || true"]).unwrap()
    let output = fs.read("{base}/run_output.txt").unwrap()
    if output.starts_with("hello-auto") {
        io.println("PASS: binary output correct after auto-resolve")
    } else {
        io.println("FAIL: expected 'hello-auto', got: {output}")
    }

    // --- Test stale lockfile: touch blink.toml to make it newer ---
    process.run("sh", ["-c", "sleep 1 && touch {base}/blink.toml"]).unwrap()

    // Add a second dep to blink.toml
    process.run("sh", ["-c", "mkdir -p {base}/deps/otherlib/src"]).unwrap()
    fs.write("{base}/deps/otherlib/src/otherlib.bl", "pub fn other() -> Str \{\n    \"other-auto\"\n\}\n").unwrap()
    fs.write("{base}/deps/otherlib/blink.toml", "[package]\nname = \"otherlib\"\nversion = \"0.1.0\"\n").unwrap()
    fs.write("{base}/blink.toml", "[package]\nname = \"testproj\"\nversion = \"0.1.0\"\n\n[dependencies]\nmylib = \{ path = \"deps/mylib\" \}\notherlib = \{ path = \"deps/otherlib\" \}\n").unwrap()
    fs.write("{base}/src/main2.bl", "import mylib.\{greet\}\nimport otherlib.\{other\}\n\nfn main() \{\n    io.println(greet())\n    io.println(other())\n\}\n").unwrap()

    let build2_run = process.run("sh", ["-c", "cd {base} && {env.cwd()}/build/blink build src/main2.bl -o build/main2 > build_log2.txt 2>&1"]).unwrap()
    let build2_log = fs.read("{base}/build_log2.txt").unwrap()

    if !build2_run.success() {
        io.println("FAIL: stale lockfile rebuild failed ({build2_run.end})")
        io.println(build2_log)
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        return
    }

    process.run("sh", ["-c", "{base}/build/main2 > {base}/run_output2.txt 2>&1 || true"]).unwrap()
    let output2 = fs.read("{base}/run_output2.txt").unwrap()
    if output2.starts_with("hello-auto") {
        io.println("PASS: stale lockfile re-resolved correctly")
    } else {
        io.println("FAIL: expected 'hello-auto', got: {output2}")
    }

    // Cleanup
    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
}
