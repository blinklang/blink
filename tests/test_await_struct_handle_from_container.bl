import compile_test_helpers

// Awaiting a Handle[T] read straight out of a container (no named
// intermediate) must resolve T from the operand's own type, not from a
// scope-var name lookup that only covers a `let h = ...` binding.

fn await_from_container_src() -> Str {
    #"type CPt { x: Int }
fn main() ! IO {
    async.scope {
        let handles = [async.spawn(fn() -> CPt { CPt { x: 42 } })]
        let p = handles.get(0).unwrap().await
        io.println("x={p.x}")
    }
}
"#
}

test "awaiting a struct handle read out of a container compiles and yields the field" {
    let r = compile_test_helpers.compile_and_run(await_from_container_src(), "_await_container")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "x=42\n")
}
