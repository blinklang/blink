// A sent 0 truncated a channel's for-in drain.
//
// A channel whose element codegen cannot spell falls back to reinterpreting that element as an
// 8-byte word, and `send` emitted `blink_channel_send(ch, (void*)(intptr_t)x)`. For x == 0 that
// payload IS NULL, and NULL is blink_channel_recv's end-of-stream sentinel, so the drain broke
// on it: a sent 0 ended the stream silently, taking every value behind it as well.
//
//     let ch = channel.new[Int](buffer: 4); ch.send(5); ch.send(0); ch.send(7); ch.close()
//     for v in ch { io.println("v={v}") }      // printed v=5 and stopped: 0 and 7 vanished
//
// A channel now keeps each element inline in its ring and reports closed-and-drained through
// recv's own answer (an Option), never through the element's bits, so no value of the element
// type can read as end-of-stream (sections/04_effects.md §4.13). Every channel carries a KNOWN
// element: `channel.new[T](buffer: N)` writes it at the construction
// site (sections/04_effects.md), and a bare `Channel` in a type position is
// error[TypeArgArity] (E0303, sections/03_types.md §3.4), so no element-less channel reaches
// codegen at all.

import std.process.{ProcessResult}

fn emit_c(tag: Str, src: Str) -> Str {
    let bl_path = ".tmp/_w3v2e6_{tag}.bl"
    write_file(bl_path, src)
    let _ = process_run("build/blink", ["build", bl_path, "--emit", "c"])
    let c_src = read_file("build/_w3v2e6_{tag}.c")
    shell_exec("rm -f {bl_path} build/_w3v2e6_{tag}.c")
    c_src
}

fn run_src(tag: Str, src: Str) -> ProcessResult {
    let bl_path = ".tmp/_w3v2e6_{tag}.bl"
    let bin = ".tmp/_w3v2e6_{tag}"
    write_file(bl_path, src)
    let build = process_run("build/blink", ["build", bl_path, "-o", bin])
    if build.exit_code != 0 {
        shell_exec("rm -f {bl_path}")
        return build
    }
    let r = process_run(bin, [])
    shell_exec("rm -f {bl_path} {bin}")
    r
}

test "a leading zero does not truncate a channel's for-in drain" {
    let src = "fn main() \{\n    let ch = channel.new[Int](buffer: 4)\n    ch.send(0)\n    ch.send(1)\n    ch.close()\n    for v in ch \{ io.println(\"v=\{v\}\") \}\n    io.println(\"done\")\n\}\n"
    let r = run_src("lead", src)
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("v=0"))
    assert(r.out.contains("v=1"))
    assert(r.out.contains("done"))
}

// The value BEHIND the zero is the one that shows this is truncation and not a bad rendering
// of a single element: before the fix this drained `5` and stopped, losing both 0 and 7.
test "a mid-stream zero does not truncate the values behind it" {
    let src = "fn main() \{\n    let ch = channel.new[Int](buffer: 4)\n    ch.send(5)\n    ch.send(0)\n    ch.send(7)\n    ch.close()\n    for v in ch \{ io.println(\"v=\{v\}\") \}\n\}\n"
    let r = run_src("mid", src)
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("v=5"))
    assert(r.out.contains("v=0"))
    assert(r.out.contains("v=7"))
}

// The mechanism, not just the outcome: a behavioral row alone would pass if the drain stopped
// treating NULL as end-of-stream, which would break a genuinely closed channel instead. The
// element goes to the runtime by address, so neither a word cast nor a box per send remains.
test "channel send passes the element by address, with no pointer cast and no box per send" {
    let src = "fn main() \{\n    let ch = channel.new[Int](buffer: 4)\n    ch.send(0)\n    ch.close()\n    for v in ch \{ io.println(\"v=\{v\}\") \}\n\}\n"
    let c = emit_c("box", src)
    assert(!c.contains("(intptr_t)"))
    assert(!c.contains("(int64_t*)blink_alloc(sizeof(int64_t));"))
    assert(c.contains("blink_channel_send_value("))
}

// Controls that pin what must NOT move.

test "the .recv() path on a channel answers Some for a sent zero" {
    let src = "fn main() \{\n    let ch = channel.new[Int](buffer: 4)\n    ch.send(0)\n    ch.send(1)\n    ch.close()\n    io.println(\"a=\{ch.recv() ?? -1\} b=\{ch.recv() ?? -1\}\")\n\}\n"
    let r = run_src("recv", src)
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("a=0 b=1"))
}

// A closed, empty channel must still end the drain, and .recv() on it answers None: closed is
// a state of the channel, not a value of the element (sections/04_effects.md §4.13). Nothing is
// ever sent, so the annotation and the constructor are the only places the element is named.
test "a closed empty annotated channel ends the drain and recv answers None" {
    let src = "fn main() \{\n    let ch: Channel[Int] = channel.new[Int](buffer: 4)\n    ch.close()\n    for v in ch \{ io.println(\"v=\{v\}\") \}\n    io.println(\"drained\")\n    match ch.recv() \{\n        Some(v) => io.println(\"empty=some \{v\}\")\n        None => io.println(\"empty=none\")\n    \}\n\}\n"
    let r = run_src("closed", src)
    assert_eq(r.exit_code, 0)
    assert(!r.out.contains("v="))
    assert(r.out.contains("drained"))
    assert(r.out.contains("empty=none"))
}

// The compiler's own shape (src/cli.bl): a 1-slot channel used as a mutable cell whose stored
// value is legitimately 0. `blink test --parallel`'s dot-column counter is this code. The cell
// always holds a value when it is read, so the reader unwraps.
test "a one-slot channel used as a zero-valued mutable cell round-trips" {
    let src = "fn main() \{\n    let cell = channel.new[Int](buffer: 1)\n    cell.send(0)\n    let a = cell.recv().unwrap()\n    cell.send(a + 1)\n    let b = cell.recv().unwrap()\n    cell.send(b + 1)\n    io.println(\"a=\{a\} b=\{b\} c=\{cell.recv().unwrap()\}\")\n\}\n"
    let r = run_src("cell", src)
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("a=0 b=1 c=2"))
}

test "an annotated Channel[Int] still drains a zero" {
    let src = "fn main() \{\n    let ch: Channel[Int] = channel.new[Int](buffer: 4)\n    ch.send(0)\n    ch.send(1)\n    ch.close()\n    for v in ch \{ io.println(\"v=\{v\}\") \}\n\}\n"
    let r = run_src("ann", src)
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("v=0"))
    assert(r.out.contains("v=1"))
}

// R6 — a Str channel carries a Str. These two rows once pinned wrong answers (a reinterpreted
// pointer here, a hard cc failure below); they now pin the right ones. The boxing fallback
// still governs any element codegen must box (a sent 0 among them), and every channel it
// governs carries the element its constructor names.
test "a Str channel carries its element" {
    let src = "fn main() \{\n    let ch = channel.new[Str](buffer: 4)\n    ch.send(\"hello\")\n    ch.close()\n    for v in ch \{ io.println(\"v=\{v\}\") \}\n\}\n"
    let r = run_src("bstr", src)
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("v=hello"))
}

// R7 — a Float element used to fail in the C compiler ("cannot convert to a pointer
// type"). The box is now the element's own C type, so the double neither fails nor truncates.
// Asserting the VALUE is what separates the fix from the old failure mode: an `int64_t` box
// would have accepted the double and printed 1.
test "a Float channel carries its element without truncating" {
    let src = "fn main() \{\n    let ch = channel.new[Float](buffer: 4)\n    ch.send(1.5)\n    ch.close()\n    for v in ch \{ io.println(\"v=\{v\}\") \}\n\}\n"
    let r = run_src("bfl", src)
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("v=1.5"))
}
