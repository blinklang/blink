// A container named in a type position must carry its element argument. A bare `impl Foo for Set`
// names an incomplete type, so it is error[TypeArgArity] (E0303, sections/03_types.md §3.4) before
// it can reach codegen. Asserts through a real child process, because the claim is about what a
// compiler run reports.
import std.fs
import std.process.{ProcessResult}

// A bare `impl Foo for Set` — the receiver has no element argument.
let BARE_SRC: Str = #"trait Foo { fn foo(self) -> Int }
impl Foo for Set { fn foo(self) -> Int { 0 } }
fn main() { io.println("x") }
"#

fn probe_path() -> Str { "build/bare_container_impl_probe.bl" }

fn run_blinkc(src: Str) -> ProcessResult ! FS.Delete {
    write_file(probe_path(), src)
    let r = process_run("sh", ["-c", "build/blinkc {probe_path()} build/bare_container_impl_probe.c 2>&1"])
    let _ = fs.delete(probe_path())
    r
}

fn have_blinkc() -> Bool {
    file_exists("build/blinkc") == 1
}

test "a bare container impl receiver is rejected as E0303" {
    if !have_blinkc() {
        skip("build/blinkc is not present in this working tree")
        return
    }
    // The source names an incomplete type, so it is error[TypeArgArity] before codegen. blinkc
    // reports to stderr.
    let r = run_blinkc(BARE_SRC)
    assert(r.out.contains("error[TypeArgArity]"))
    assert(r.out.contains("'Set'"))
}
