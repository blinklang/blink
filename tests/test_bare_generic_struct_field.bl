// A struct field whose type is DIRECTLY a generic-struct instance (no Option/
// List/Map carrier wrapping) erased its mono arguments in the owning struct
// typedef: the field member was spelled `blink_Box` (the bare base, args
// dropped) instead of `blink_Box_0Int`, so cc reported "unknown type name
// 'blink_Box'". The carrier-wrapped case (List[Option[Box[Int]]]) was fixed
// separately; this is the bare-field axis of the same erasure family — a field
// type annotation carries no node tid, so the generic-instance mono must be
// registered/emitted from the annotation before the owning struct typedef.

type Box[T] {
    val: T
}

type BareField {
    b: Box[Int]
}

type NestedBare {
    inner: Box[Box[Int]]
}

type Maybe[T] {
    Present(T)
    Absent
}

type EHolder {
    m: Maybe[Int]
}

fn get_bare() -> Int {
    let h = BareField { b: Box { val: 7 } }
    h.b.val
}

fn get_nested() -> Int {
    let h = NestedBare { inner: Box { val: Box { val: 11 } } }
    h.inner.val.val
}

fn get_enum() -> Int {
    let h = EHolder { m: Maybe.Present(5) }
    match h.m {
        Present(v) => v
        Absent => 0
    }
}

test "bare generic-struct instance struct field round-trips" {
    assert_eq(get_bare(), 7)
}

test "bare generic-enum instance struct field round-trips" {
    assert_eq(get_enum(), 5)
}

test "nested generic-struct instance struct field round-trips" {
    assert_eq(get_nested(), 11)
}
