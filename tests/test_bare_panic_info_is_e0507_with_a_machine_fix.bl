// PanicInfo stays out of a file's scope until the file imports it, although each program loads
// its module for the hook's type (sections/02_syntax.md §2.20 *The name `PanicInfo` and its
// import*). The fix adds the one import line.

import compile_test_helpers.{check_via_cli}

fn only_error_line(out: Str) -> Str {
    let mut found = ""
    for line in out.split("\n") {
        if line.contains("\"severity\":\"error\"") {
            assert_eq(found, "")
            found = line
        }
    }
    found
}

test "the spec example: a bare PanicInfo with no import is E0507, and its fix adds the import" {
    let src = #"fn report(p: PanicInfo) -> Never ! Env.Exit {
    env.exit(70)
}

fn main() ! Env {
    with on_panic(report) { panic("x") }
}
"#
    let e = only_error_line(check_via_cli(src, "bpi_bare_{getpid()}"))
    assert(e.contains("\"name\":\"UnknownType\",\"code\":\"E0507\""), e)
    assert(e.contains("\"message\":\"unknown type `PanicInfo`\""), e)
    assert(e.contains("\"help\":\"add `import std.panic.\{PanicInfo}`\""), e)
    assert(e.contains("\"fix\":\{\"action\":\"add `import std.panic.\{PanicInfo}`\""), e)
    assert(e.contains("\"text\":\"import std.panic.\{PanicInfo}\\n\\n\""), e)
}

test "a literal of a bare PanicInfo is E0507" {
    let src = #"fn main() ! IO {
    let p = PanicInfo { message: "m", file: "f", line: None }
    io.println(p.message)
}
"#
    let e = only_error_line(check_via_cli(src, "bpi_literal_{getpid()}"))
    assert(e.contains("\"code\":\"E0507\""), e)
}

test "panic.PanicInfo with no import names the import in its help" {
    let src = #"fn name_of(p: panic.PanicInfo) -> Str { p.message }

fn main() { }
"#
    let e = only_error_line(check_via_cli(src, "bpi_qualified_{getpid()}"))
    assert(e.contains("\"code\":\"E0507\""), e)
    assert(e.contains("add `import std.panic`"), e)
}

test "a whole-module import brings in the qualifier and not the bare name" {
    let src = #"import std.panic

fn name_of(p: PanicInfo) -> Str { p.message }

fn main() { }
"#
    let e = only_error_line(check_via_cli(src, "bpi_whole_{getpid()}"))
    assert(e.contains("\"name\":\"ImportNotSelected\""), e)
}

test "a closure hook that writes no type name needs no import" {
    let src = #"fn main() ! IO, Env {
    with on_panic(fn(p) {
        io.eprintln(p.message)
        env.exit(70)
    }) {
        panic("x")
    }
}
"#
    let out = check_via_cli(src, "bpi_closure_{getpid()}")
    assert(!out.contains("\"severity\":\"error\""), out)
}
