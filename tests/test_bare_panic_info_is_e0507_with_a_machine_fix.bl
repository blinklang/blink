// PanicInfo stays out of a file's scope until the file imports it, although each program loads
// its module for the hook's type (sections/02_syntax.md §2.20 *The name `PanicInfo` and its
// import*). The fix adds the one import line.

import compile_test_helpers.{check_via_cli, scratch_root}

fn only_error_line(out: Str) -> Str {
    let mut found = ""
    for line in out.split("\n") {
        if line.contains("\"severity\":\"error\"") {
            assert_eq(found, "")
            found = line
        }
    }
    found
}

test "the spec example: a bare PanicInfo with no import is E0507, and its fix adds the import" {
    let src = #"fn report(p: PanicInfo) -> Never ! Env.Exit {
    env.exit(70)
}

fn main() ! Env {
    with on_panic(report) { panic("x") }
}
"#
    let e = only_error_line(check_via_cli(src, "bpi_bare_{getpid()}"))
    assert(e.contains("\"name\":\"UnknownType\",\"code\":\"E0507\""), e)
    assert(e.contains("\"message\":\"unknown type `PanicInfo`\""), e)
    assert(e.contains("\"help\":\"add `import std.panic.\{PanicInfo}`\""), e)
    assert(e.contains("\"fix\":\{\"action\":\"add `import std.panic.\{PanicInfo}`\""), e)
    assert(e.contains("\"text\":\"import std.panic.\{PanicInfo}\\n\\n\""), e)
}

test "a literal of a bare PanicInfo is E0507" {
    let src = #"fn main() ! IO {
    let p = PanicInfo { message: "m", file: "f", line: None }
    io.println(p.message)
}
"#
    let e = only_error_line(check_via_cli(src, "bpi_literal_{getpid()}"))
    assert(e.contains("\"code\":\"E0507\""), e)
}

test "panic.PanicInfo with no import names the import in its help" {
    let src = #"fn name_of(p: panic.PanicInfo) -> Str { p.message }

fn main() { }
"#
    let e = only_error_line(check_via_cli(src, "bpi_qualified_{getpid()}"))
    assert(e.contains("\"code\":\"E0507\""), e)
    assert(e.contains("add `import std.panic`"), e)
}

test "a whole-module import brings in the qualifier and not the bare name" {
    let src = #"import std.panic

fn name_of(p: PanicInfo) -> Str { p.message }

fn main() { }
"#
    let e = only_error_line(check_via_cli(src, "bpi_whole_{getpid()}"))
    assert(e.contains("\"name\":\"ImportNotSelected\""), e)
}

test "a closure hook that writes no type name needs no import" {
    let src = #"fn main() ! IO, Env {
    with on_panic(fn(p) {
        io.eprintln(p.message)
        env.exit(70)
    }) {
        panic("x")
    }
}
"#
    let out = check_via_cli(src, "bpi_closure_{getpid()}")
    assert(!out.contains("\"severity\":\"error\""), out)
}

// Runs `blink fix` on a file, then returns the fixed text and the check of that text.
fn fix_and_recheck(src: Str, tag: Str) -> (Str, Str) ! Process.Spawn, FS.Write, FS.Read, Env.Read {
    let dir = "{scratch_root()}/{tag}"
    let _mk = process.run("mkdir", ["-p", dir]).unwrap()
    let path = "{dir}/main.bl"
    fs.write(path, src).unwrap()
    let _ = process.run("build/blink", ["fix", path]).unwrap()
    let r = process.run("build/blink", ["check", path, "--format", "json"]).unwrap()
    (fs.read(path).unwrap(), "{r.out}{r.err_out}")
}

test "blink fix adds the import once for two bare uses, and the file then checks clean" {
    let src = "fn a(p: PanicInfo) -> Str \{ p.message }\n\nfn b(p: PanicInfo) -> Str \{ p.message }\n\nfn main() \{ }\n"
    let (text, out) = fix_and_recheck(src, "bpi_fix_{getpid()}")
    assert_eq(text, "import std.panic.\{PanicInfo}\n\n{src}")
    assert(!out.contains("\"severity\":\"error\""), out)
}

test "a literal of a bare PanicInfo reports only E0507, with no missing-field error on top" {
    let src = "fn main() \{\n    let _ = PanicInfo \{ message: \"m\" }\n}\n"
    let e = only_error_line(check_via_cli(src, "bpi_one_error_{getpid()}"))
    assert(e.contains("\"code\":\"E0507\""), e)
}

test "a literal of an unselected type reports only the selection, with no missing-field error on top" {
    let src = "import std.panic\n\nfn main() \{\n    let _ = PanicInfo \{ message: \"m\" }\n}\n"
    let e = only_error_line(check_via_cli(src, "bpi_one_error_sel_{getpid()}"))
    assert(e.contains("\"code\":\"E1006\""), e)
}

test "with `panic` declared here, the fix imports under another qualifier, and the file then checks clean" {
    let src = "fn panic() -> Int \{ 1 }\n\nfn name_of(p: PanicInfo) -> Str \{ p.message }\n\nfn main() \{ let _ = panic() }\n"
    let e = only_error_line(check_via_cli(src, "bpi_taken_{getpid()}"))
    assert(e.contains("\"help\":\"add `import std.panic as panic_mod.\{PanicInfo}`\""), e)
    let (text, out) = fix_and_recheck(src, "bpi_taken_fix_{getpid()}")
    assert_eq(text, "import std.panic as panic_mod.\{PanicInfo}\n\n{src}")
    assert(!out.contains("\"severity\":\"error\""), out)
}

test "with `panic` and `panic_mod` both declared here, the error gives help and no machine fix" {
    let src = "fn panic() -> Int \{ 1 }\n\nfn panic_mod() -> Int \{ 2 }\n\nfn name_of(p: PanicInfo) -> Str \{ p.message }\n\nfn main() \{ let _ = panic() + panic_mod() }\n"
    let e = only_error_line(check_via_cli(src, "bpi_both_taken_{getpid()}"))
    assert(e.contains("\"code\":\"E0507\""), e)
    assert(e.contains("import std.panic as <name>"), e)
    assert(!e.contains("\"fix\":"), e)
}
