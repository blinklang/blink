import compile_test_helpers

// A bare payload-less variant (INone) assigned to a generic-instance-annotated
// local (ITree[Int]) must produce a well-formed instance type, both for the
// local's own RHS cast and for the payload binder in a sibling match arm.

fn payloadless_variant_src() -> Str {
    #"import std.io

type ITree[T] {
    INone
    INode(value: T)
}

fn main() ! IO {
    let t: ITree[Int] = INone
    let mut hit = 0
    match t {
        INode(_v) => { hit = 1 }
        INone => { hit = 2 }
    }
    io.println("hit={hit}")
}
"#
}

test.failing(
    "bare payload-less variant under an instance annotation compiles and matches correctly",
    reason: "the bare-variant RHS cast and the sibling arm's payload binder resolve against the bare generic base, not the annotation instance, so the emitted C references an undeclared instance typedef and erases the arm binder to void",
    ticket: "acrtns",
) {
    let r = compile_test_helpers.compile_and_run(payloadless_variant_src(), "_payloadless_variant")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "hit=2\n")
}
