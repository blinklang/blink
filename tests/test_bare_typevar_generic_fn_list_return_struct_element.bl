// A bare-typevar generic function returning List[T], called with a generic struct instance
// as T, must keep the element's real struct shape through the list — accessing a field on
// the retrieved element must work, not erase to a non-struct slot.

type Box[T] { value: T }

fn mkbox[T](v: T) -> Box[T] { Box { value: v } }
fn wraplist[T](x: T) -> List[T] { [x] }

test "wraplist(mkbox(2)).get(0).unwrap().value reads the real struct field" {
    let l = wraplist(mkbox(2))
    assert_eq(l.get(0).unwrap().value, 2)
}
