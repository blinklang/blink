// A bare unit variant used as a value expression (no qualifier, no payload,
// no braces) is the same value as its qualified form (03_types.md:1123-1143).
// Bare names already resolved in pattern position; this file covers the
// value-expression side: let, fn argument, return, and a variant that
// shadows a builtin type name.

import compile_test_helpers.{compile_and_run}

type Leaf { LZero, LPos(Int) }

fn leaf_name(l: Leaf) -> Str {
    match l {
        LZero => "zero"
        LPos(_) => "pos"
    }
}

test "bare unit variant in a let" {
    let l = LZero
    assert_eq(leaf_name(l), "zero")
}

test "bare unit variant as a fn argument" {
    assert_eq(leaf_name(LZero), "zero")
    assert_eq(leaf_name(LPos(3)), "pos")
}

fn zero() -> Leaf { LZero }

test "bare unit variant as a return value" {
    assert_eq(leaf_name(zero()), "zero")
}

// `Map` names both a builtin container constructor and, here, a payload-less
// variant. `Map()` still builds the builtin; bare `Map` is the variant.
type Kind { Map, Other }

test "bare unit variant that shadows a builtin type name" {
    let k: Kind = Map
    match k {
        Map => assert(true)
        Other => assert(false)
    }
    let mut built: Map[Str, Int] = Map()
    built.insert("a", 1)
    assert_eq(built.len(), 1)
}

// A payload-less variant of a GENERIC enum ICEs UnspellableExprType when built as a
// value, bare or qualified alike -- typecheck never unifies the type parameter from
// the expected-type hint when there is no ctor argument to unify it from instead.
// That is a separate defect from the one this file proves fixed (codegen could not
// read a typecheck-resolved BARE variant at all); tracked apart from it.
test "a bare unit variant of a generic enum resolves as a value" {
    let src = #"
import std.io

type Maybe[T] { Nothing, Just(T) }
fn main() ! IO {
    let m: Maybe[Int] = Nothing
    match m {
        Nothing => io.println("nothing")
        Just(_) => io.println("just")
    }
}
"#
    let r = compile_and_run(src, "_bare_unit_variant_generic_enum")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "nothing\n")
}
