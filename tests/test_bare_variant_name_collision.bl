pub type Other {
    A(x: Str)
    B(x: Str)
    C(x: Str)
    ProtocolError(x: Str)
}

pub type Target {
    Ok2(msg: Str)
    ProtocolError(msg: Str)
    Done
}

fn describe(t: Target) -> Str {
    match t {
        Ok2(m) => return "ok: {m}"
        ProtocolError(m) => return "protocol: {m}"
        Done => return "done"
    }
}

// Struct-style colliding pair with *differing* field shapes, to exercise the
// StructPattern bare-resolution binding sites. If the bare name resolved to the
// wrong enum, the binding would read the wrong union member.
pub type FirstShape {
    Shared { a: Int, b: Int }
}

pub type SecondShape {
    Lead { z: Str }
    Shared { only: Str }
}

fn read_shared(s: SecondShape) -> Str {
    match s {
        Lead { z } => return "lead: {z}"
        Shared { only } => return "shared: {only}"
    }
}

test "bare variant name colliding across enums resolves to scrutinee enum" {
    assert_eq(describe(Target.ProtocolError(msg: "boom")), "protocol: boom")
    assert_eq(describe(Target.Done), "done")
    assert_eq(describe(Target.Ok2(msg: "hi")), "ok: hi")
}

test "bare struct-style variant name collision binds correct union member" {
    assert_eq(read_shared(SecondShape.Shared(only: "data")), "shared: data")
    assert_eq(read_shared(SecondShape.Lead(z: "head")), "lead: head")
}
