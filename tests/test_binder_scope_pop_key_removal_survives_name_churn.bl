// Each block binds names no other block binds, so every pop drops keys from the binder
// table that nothing re-inserts. A table that keeps a tombstone per removed key fills
// with them after a few distinct names and the compiler stops answering.

test "block scopes binding distinct names pop without exhausting the binder table" {
    let mut sum = 0
    if sum >= 0 {
        let a0 = 0
        let b0 = 1
        sum = sum + a0 + b0
    }
    if sum >= 0 {
        let a1 = 2
        let b1 = 3
        sum = sum + a1 + b1
    }
    if sum >= 0 {
        let a2 = 4
        let b2 = 5
        sum = sum + a2 + b2
    }
    if sum >= 0 {
        let a3 = 6
        let b3 = 7
        sum = sum + a3 + b3
    }
    if sum >= 0 {
        let a4 = 8
        let b4 = 9
        sum = sum + a4 + b4
    }
    if sum >= 0 {
        let a5 = 10
        let b5 = 11
        sum = sum + a5 + b5
    }
    if sum >= 0 {
        let a6 = 12
        let b6 = 13
        sum = sum + a6 + b6
    }
    if sum >= 0 {
        let a7 = 14
        let b7 = 15
        sum = sum + a7 + b7
    }
    if sum >= 0 {
        let a8 = 16
        let b8 = 17
        sum = sum + a8 + b8
    }
    if sum >= 0 {
        let a9 = 18
        let b9 = 19
        sum = sum + a9 + b9
    }
    if sum >= 0 {
        let a10 = 20
        let b10 = 21
        sum = sum + a10 + b10
    }
    if sum >= 0 {
        let a11 = 22
        let b11 = 23
        sum = sum + a11 + b11
    }
    if sum >= 0 {
        let a12 = 24
        let b12 = 25
        sum = sum + a12 + b12
    }
    if sum >= 0 {
        let a13 = 26
        let b13 = 27
        sum = sum + a13 + b13
    }
    if sum >= 0 {
        let a14 = 28
        let b14 = 29
        sum = sum + a14 + b14
    }
    if sum >= 0 {
        let a15 = 30
        let b15 = 31
        sum = sum + a15 + b15
    }
    if sum >= 0 {
        let a16 = 32
        let b16 = 33
        sum = sum + a16 + b16
    }
    if sum >= 0 {
        let a17 = 34
        let b17 = 35
        sum = sum + a17 + b17
    }
    if sum >= 0 {
        let a18 = 36
        let b18 = 37
        sum = sum + a18 + b18
    }
    if sum >= 0 {
        let a19 = 38
        let b19 = 39
        sum = sum + a19 + b19
    }
    if sum >= 0 {
        let a20 = 40
        let b20 = 41
        sum = sum + a20 + b20
    }
    if sum >= 0 {
        let a21 = 42
        let b21 = 43
        sum = sum + a21 + b21
    }
    if sum >= 0 {
        let a22 = 44
        let b22 = 45
        sum = sum + a22 + b22
    }
    if sum >= 0 {
        let a23 = 46
        let b23 = 47
        sum = sum + a23 + b23
    }
    if sum >= 0 {
        let a24 = 48
        let b24 = 49
        sum = sum + a24 + b24
    }
    if sum >= 0 {
        let a25 = 50
        let b25 = 51
        sum = sum + a25 + b25
    }
    if sum >= 0 {
        let a26 = 52
        let b26 = 53
        sum = sum + a26 + b26
    }
    if sum >= 0 {
        let a27 = 54
        let b27 = 55
        sum = sum + a27 + b27
    }
    if sum >= 0 {
        let a28 = 56
        let b28 = 57
        sum = sum + a28 + b28
    }
    if sum >= 0 {
        let a29 = 58
        let b29 = 59
        sum = sum + a29 + b29
    }
    if sum >= 0 {
        let a30 = 60
        let b30 = 61
        sum = sum + a30 + b30
    }
    if sum >= 0 {
        let a31 = 62
        let b31 = 63
        sum = sum + a31 + b31
    }
    assert_eq(sum, 2016)
}
