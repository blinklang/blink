// `blink cache clean` of a cache dir it cannot list has cleaned nothing. It says which dir and
// why, and exits nonzero.

import compile_test_helpers
import std.process.{ProcessResult}

fn sh(cmd: Str) -> ProcessResult {
    process.run("sh", ["-c", cmd]).unwrap()
}

test "blink cache clean of a cache dir it cannot list exits nonzero and names the dir" {
    if sh("id -u").out.trim() == "0" { skip("root can list every dir") }
    let d = "{compile_test_helpers.scratch_root()}/_cache_clean_unlistable_{getpid()}"
    sh("rm -rf {d} && mkdir -p {d}/cache && touch {d}/cache/a.o && chmod 000 {d}/cache")
    let r = sh("B=$(pwd)/build/blink; cd {d} && env -u BLINK_ROOT BLINK_CACHE_DIR={d}/cache $B cache clean < /dev/null")
    sh("chmod 755 {d}/cache")
    let kept = fs.read("{d}/cache/a.o").is_ok()
    sh("rm -rf {d}")
    let text = "{r.out}{r.err_out}"
    assert(!r.success(), "cache clean answered success:\n{text}")
    assert(text.contains("{d}/cache: Permission denied"), "the error does not name the dir and the cause:\n{text}")
    assert(kept, "the cache entry is gone")
}
