// A written `()` and a written `Void` name one type, but `()` is the unit type and `Void` is
// only the FFI pointee marker (sections/03_types.md), so the tools that print a signature
// back print `()` where the source wrote it. Each command runs in a fresh temporary project,
// since `blink doc <name>` looks for src/<name>.bl in the current directory.

import std.process.{ProcessResult}

fn sh(cmd: Str) -> ProcessResult {
    process.run("sh", ["-c", cmd]).unwrap()
}

fn lines(xs: List[Str]) -> Str {
    xs.join("\n").concat("\n")
}

fn source() -> Str {
    lines([
        "pub fn go(x: (), n: Int) -> () \{",
        "    x",
        "}",
    ])
}

fn expected_doc() -> Str {
    lines([
        "Module: unitdoc",
        "FUNCTIONS",
        "",
        "    fn go(x: (), n: Int) -> ()",
        "",
    ])
}

fn in_project(cmd: Str) -> ProcessResult {
    let dir = sh("mktemp -d /tmp/blink_doc_unit.XXXXXX").out.trim()
    let _ = sh("mkdir -p {dir}/src")
    write_file("{dir}/src/unitdoc.bl", source())
    let r = sh("B=$(pwd)/build/blink; cd {dir} && timeout 120 $B {cmd}")
    let _ = sh("rm -rf {dir}")
    r
}

test "blink doc prints a written () as () in a signature" {
    let r = in_project("doc unitdoc")
    if r.out != expected_doc() {
        io.eprintln("want:\n{expected_doc()}\ngot:\n{r.out}\nstderr:\n{r.err_out}")
    }
    assert_eq(r.exit_code, 0)
    assert(r.out == expected_doc())
}

test "blink query prints a written () as () in the signature" {
    let r = in_project("query src/unitdoc.bl --fn go")
    if !r.out.contains("\"signature\":\"go((),Int) -> ()\"") {
        io.eprintln("got:\n{r.out}\nstderr:\n{r.err_out}")
    }
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("\"signature\":\"go((),Int) -> ()\""))
}
