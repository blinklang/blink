// `@handle_all` is part of an effect's contract (sections/04_effects.md §4.7.1): a handler for
// the effect must write every primitive operation. So `blink doc` prints the mark where the
// source has it, on the effect or on the one sub-effect it marks, and prints nothing for an
// effect without it. The command runs in a fresh temporary project, since `blink doc <name>`
// looks for src/<name>.bl in the current directory.

import std.process.{ProcessResult, ChildEnd}

fn sh(cmd: Str) -> ProcessResult {
    process.run("sh", ["-c", cmd]).unwrap()
}

fn lines(xs: List[Str]) -> Str {
    xs.join("\n").concat("\n")
}

fn source() -> Str {
    lines([
        "@handle_all",
        "pub effect Dice \{",
        "    effect Roll \{",
        "        fn roll(sides: Int) -> Int",
        "        fn coin() -> Bool",
        "    }",
        "}",
        "",
        "pub effect Store \{",
        "    @handle_all",
        "    effect Read \{",
        "        fn get(k: Str) -> Int",
        "    }",
        "    effect Write \{",
        "        fn put(k: Str, v: Int)",
        "    }",
        "}",
        "",
        "@handle_all",
        "pub effect Tick",
        "",
        "pub effect Plain",
    ])
}

fn expected() -> Str {
    lines([
        "Module: dice",
        "EFFECTS",
        "",
        "    @handle_all",
        "    effect Dice \{",
        "        effect Roll \{",
        "            fn roll(sides: Int) -> Int",
        "            fn coin() -> Bool",
        "        }",
        "    }",
        "",
        "    effect Store \{",
        "        @handle_all",
        "        effect Read \{",
        "            fn get(k: Str) -> Int",
        "        }",
        "        effect Write \{",
        "            fn put(k: Str, v: Int)",
        "        }",
        "    }",
        "",
        "    @handle_all",
        "    effect Tick",
        "",
        "    effect Plain",
        "",
    ])
}

test "blink doc prints @handle_all on a marked effect and a marked sub-effect only" {
    let dir = sh("mktemp -d /tmp/blink_doc_handle_all.XXXXXX").out.trim()
    let _ = sh("mkdir -p {dir}/src")
    write_file("{dir}/src/dice.bl", source())
    let r = sh("B=$(pwd)/build/blink; cd {dir} && timeout 120 $B doc dice")
    if r.out != expected() {
        io.eprintln("want:\n{expected()}\ngot:\n{r.out}\nstderr:\n{r.err_out}")
    }
    assert_eq(r.end, ChildEnd.Exited(0))
    assert(r.out == expected())
    let _ = sh("rm -rf {dir}")
}
