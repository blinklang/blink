// A bare type name is the empty row (sections/04_effects.md §4.15.5), so a declaration printed
// without its row slot `[! _]` reads as another type. `blink doc` prints the slot after any
// type parameters. The command runs in a fresh temporary project, since `blink doc <name>`
// looks for src/<name>.bl in the current directory.

import std.process.{ProcessResult, ChildEnd}

fn sh(cmd: Str) -> ProcessResult ! Process.Spawn {
    process.run("sh", ["-c", cmd]).unwrap()
}

fn lines(xs: List[Str]) -> Str {
    xs.join("\n").concat("\n")
}

fn source() -> Str {
    lines([
        "pub type Cleanup[! _] \{",
        "    action: fn() -> Void ! _",
        "}",
        "pub type Job[T ! _] \{",
        "    input: T",
        "    run: fn(T) -> Void ! _",
        "}",
        "pub type Plain[T] \{",
        "    n: T",
        "}",
    ])
}

fn expected_doc() -> Str {
    lines([
        "Module: slotdoc",
        "",
        "TYPES",
        "",
        "    type Cleanup[! _] \{",
        "        action: fn() -> Void ! _",
        "    }",
        "",
        "    type Job[T ! _] \{",
        "        input: T",
        "        run: fn(T) -> Void ! _",
        "    }",
        "",
        "    type Plain[T] \{",
        "        n: T",
        "    }",
        "",
    ])
}

test "blink doc prints the row slot of a type" {
    let dir = sh("mktemp -d /tmp/blink_doc_row_slot.XXXXXX").out.trim()
    let _ = sh("mkdir -p {dir}/src")
    fs.write("{dir}/src/slotdoc.bl", source()).unwrap()
    let r = sh("B=$(pwd)/build/blink; cd {dir} && timeout 120 $B doc slotdoc")
    let _ = sh("rm -rf {dir}")
    if r.out != expected_doc() {
        io.eprintln("want:\n{expected_doc()}\ngot:\n{r.out}\nstderr:\n{r.err_out}")
    }
    assert_eq(r.end, ChildEnd.Exited(0))
    assert(r.out == expected_doc())
}
