// The W0545 fix on the builtin `Time` effect (sections/04_effects.md §4.7.1). `Time` has no
// declaration in source, so the fix takes each omitted operation's signature from the
// compiler's own table for the effect. An explicit `default.op(args)` gives the same program as
// the omitted operation, so the fixed file checks with no W0545 and runs the same, as one unit
// and under --per-module.

import std.process.{ProcessResult}

fn sh(cmd: Str) -> ProcessResult {
    process.run("sh", ["-c", cmd]).unwrap()
}

fn blink_in(dir: Str, args: Str) -> ProcessResult {
    sh("B=$(pwd)/build/blink; cd {dir} && timeout 120 $B {args}")
}

fn lines(xs: List[Str]) -> Str {
    xs.join("\n").concat("\n")
}

fn tail_lines() -> List[Str] {
    [
        "    }",
        "}",
        "",
        "fn main() \{",
        "    with frozen() \{",
        "        time.sleep(Duration.ms(1))",
        #"        io.println("{time.read().second()}")"#,
        "    }",
        "}",
    ]
}

fn head_lines() -> List[Str] {
    [
        "import std.time",
        "",
        "fn frozen() -> Handler[Time] \{",
        "    handler Time \{",
        "        fn read() -> Instant \{ Instant.from_epoch_secs(7) }",
    ]
}

fn partial_src() -> Str {
    lines(head_lines().append(tail_lines()))
}

fn fixed_src() -> Str {
    lines(head_lines().append(["        fn sleep(d: Duration) \{ default.sleep(d) }"]).append(tail_lines()))
}

test "blink fix adds the omitted Time op as a forward, and the fixed file runs the same" {
    let dir = sh("mktemp -d /tmp/blink_fix_w0545_time.XXXXXX").out.trim()
    write_file("{dir}/clock.bl", partial_src())
    let before = blink_in(dir, "run clock.bl")
    assert_eq(before.exit_code, 0)
    assert_eq(before.out, "7\n")
    assert(before.err_out.contains("warning[PartialHandler]: handler for `Time` does not implement `sleep`"))

    let r = blink_in(dir, "fix clock.bl")
    let got = read_file("{dir}/clock.bl")
    if got != fixed_src() {
        io.eprintln("want file:\n{fixed_src()}\ngot file:\n{got}\nstdout:\n{r.out}\nstderr:\n{r.err_out}")
    }
    assert(got == fixed_src())
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("clock.bl:6:5: W0545 add the omitted operation"))
    assert(r.out.contains("1 fix(es) applied"))

    let check = blink_in(dir, "check --json clock.bl")
    if check.exit_code != 0 || check.err_out.contains("W0545") || check.out.contains("W0545") { io.eprintln(check.err_out) }
    assert_eq(check.exit_code, 0)
    assert(!check.err_out.contains("W0545"))
    assert(!check.out.contains("W0545"))

    let after = blink_in(dir, "run clock.bl")
    assert_eq(after.exit_code, 0)
    assert_eq(after.out, before.out)
    let per = blink_in(dir, "run --per-module clock.bl")
    assert_eq(per.exit_code, 0)
    assert_eq(per.out, before.out)
    let _ = sh("rm -rf {dir}")
}
