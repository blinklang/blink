// `blink fix` that cannot write the fixed source has applied nothing. It says which path and
// why, lists no fix as applied, and exits nonzero.

import std.process.{ProcessResult}

fn sh(cmd: Str) -> ProcessResult ! Process.Spawn {
    process.run("sh", ["-c", cmd]).unwrap()
}

fn as_root() -> Bool ! Process.Spawn {
    sh("id -u").out.trim() == "0"
}

// A handler that leaves out `read_bytes`, so `blink fix` has one W0545 edit to make.
let PARTIAL: Str = "fn one_line() -> Handler[IO.Read] \{\n    handler IO.Read \{\n        fn read_line() -> Option[Str] \{ Some(\"seven\") }\n    }\n}\n\nfn main() \{\n    with one_line() \{\n        io.println(io.read_line() ?? \"none\")\n    }\n}\n"

test "blink fix of a source it cannot write exits nonzero, names the path and applies nothing" {
    if as_root() { skip("root can read and write every file") }
    let dir = sh("mktemp -d /tmp/blink_fix_cannot_write.XXXXXX").out.trim()
    fs.write("{dir}/reader.bl", PARTIAL)?
    sh("chmod 444 {dir}/reader.bl")
    let r = sh("B=$(pwd)/build/blink; cd {dir} && timeout 120 $B fix reader.bl < /dev/null")
    sh("chmod 644 {dir}/reader.bl")
    let after = fs.read("{dir}/reader.bl")?
    sh("rm -rf {dir}")
    let text = "{r.out}{r.err_out}"
    assert(!r.success(), "the command answered success:\n{text}")
    assert(text.contains("write reader.bl: Permission denied"), "the error does not name the path and the cause:\n{text}")
    assert(text.contains("0 fix(es) applied"), "a fix that was not written is listed as applied:\n{text}")
    assert_eq(after, PARTIAL)
}
