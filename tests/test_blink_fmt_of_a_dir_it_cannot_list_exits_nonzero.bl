// `blink fmt` with no path walks the current directory. A directory in it that it cannot list
// is not an empty one: fmt says which path and why and exits nonzero, so `fmt --check` never
// calls unread files formatted.

import std.process.{ProcessResult}

fn sh(cmd: Str) -> ProcessResult {
    process.run("sh", ["-c", cmd]).unwrap()
}

fn as_root() -> Bool {
    sh("id -u").out.trim() == "0"
}

test "blink fmt --check of a dir it cannot list exits nonzero and names the path" {
    if as_root() { skip("root can list every directory") }
    let d = sh("mktemp -d /tmp/blink_fmt_cannot_list.XXXXXX").out.trim()
    sh("mkdir -p {d}/sub")
    fs.write("{d}/sub/bad.bl", "fn main()\{io.println(\"x\")}\n")?
    sh("chmod 000 {d}/sub")
    let blink = sh("readlink -f build/blink").out.trim()
    let r = sh("cd {d} && timeout 120 {blink} fmt --check < /dev/null")
    sh("chmod 755 {d}/sub && rm -rf {d}")
    let text = "{r.out}{r.err_out}"
    assert(!r.success(), "the command answered success:\n{text}")
    assert(text.contains("sub: Permission denied"), "the error does not name the path and the cause:\n{text}")
}
