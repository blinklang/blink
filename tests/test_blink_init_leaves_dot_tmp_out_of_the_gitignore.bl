// No build writes a `.tmp` dir into a project, so `blink init` does not name one in the
// `.gitignore` it writes or in the lines it adds to one that exists.

import compile_test_helpers
import std.process.{ProcessResult}

fn sh(cmd: Str) -> ProcessResult {
    process.run("sh", ["-c", cmd]).unwrap()
}

fn init_in(blink: Str, dir: Str) -> ProcessResult {
    sh("cd {dir} && env -u BLINK_ROOT {blink} init demo < /dev/null")
}

test "blink init writes a gitignore with no .tmp line" {
    let blink = sh("readlink -f build/blink").out.trim()
    let dir = "{compile_test_helpers.scratch_root()}/_init_fresh_{getpid()}"
    shell_exec("rm -rf {dir} && mkdir -p {dir}")
    let r = init_in(blink, dir)
    let ignore = read_file("{dir}/.gitignore")
    shell_exec("rm -rf {dir}")
    assert(r.exit_code == 0, "init failed: {r.out}{r.err_out}")
    assert(ignore.contains("build/"), "no build/ line in: {ignore}")
    assert(!ignore.contains(".tmp"), "a .tmp line in: {ignore}")
}

test "blink init adds no .tmp line to a gitignore that exists" {
    let blink = sh("readlink -f build/blink").out.trim()
    let dir = "{compile_test_helpers.scratch_root()}/_init_existing_{getpid()}"
    shell_exec("rm -rf {dir} && mkdir -p {dir}")
    write_file("{dir}/.gitignore", "node_modules/\n")
    let r = init_in(blink, dir)
    let ignore = read_file("{dir}/.gitignore")
    shell_exec("rm -rf {dir}")
    assert(r.exit_code == 0, "init failed: {r.out}{r.err_out}")
    assert(ignore.contains("build/"), "no build/ line in: {ignore}")
    assert(!ignore.contains(".tmp"), "a .tmp line in: {ignore}")
}
