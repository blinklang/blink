// A command that is not a compile keeps printing blink.toml warnings itself, on stdout, as it
// did before a compile took the print over: `blink remove` loads the manifest with the print
// flag on, so its warnings show once each. The fixture lives under a fresh temporary
// directory, since the test tree itself sits inside a project.

import std.process.{ProcessResult}

let LINT_WARNING = "warning: unknown lint level 'loud' for 'W0703' in [lints] (expected off, warn, or error)"
let SECTION_WARNING = "warning: unknown section 'bogus' in manifest"

fn sh(cmd: Str) -> ProcessResult {
    process_run("sh", ["-c", cmd])
}

fn count(text: Str, part: Str) -> Int {
    text.split(part).len() - 1
}

test "blink remove prints each manifest warning once on stdout" {
    let dir = sh("mktemp -d /tmp/blink_remove_manifest_warning.XXXXXX").out.trim()
    let _ = sh("mkdir -p {dir}/src")
    write_file("{dir}/blink.toml", "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[lints]\nW0703 = \"loud\"\n\n[bogus]\nx = 1\n")
    write_file("{dir}/src/main.bl", "fn main() \{\n    io.println(\"hi\")\n}\n")
    let r = sh("B=$(pwd)/build/blink; cd {dir} && $B remove nothere")
    let _ = sh("rm -rf {dir}")

    assert_eq(count(r.out, LINT_WARNING), 1)
    assert_eq(count(r.out, SECTION_WARNING), 1)
    assert(!r.err_out.contains(LINT_WARNING))
    assert(!r.err_out.contains(SECTION_WARNING))
}
