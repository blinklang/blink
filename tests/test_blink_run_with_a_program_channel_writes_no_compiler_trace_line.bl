// The compiler is a Blink program that calls trace.log, and `blink run` builds and runs the
// program in one process tree under one environment. The compiler's channels are named
// `blink.<area>`, so a channel that the program names, such as `mono`, turns on the
// program's line and none of the compiler's.

import compile_test_helpers

let LOWER_SRC = #"fn lower(id: Int) -> Int {
    trace.log("mono", "lower {id}")
    id + 1
}

fn main() ! IO {
    io.println("{lower(4)}")
}
"#

test "blink run with BLINK_TRACE_CHANNELS=mono writes the program's mono line and no compiler line" {
    let dir = "{compile_test_helpers.scratch_root()}/run_program_channel"
    compile_test_helpers.sh("mkdir -p {dir}")
    let path = "{dir}/run_program_channel.bl"
    fs.write(path, LOWER_SRC).unwrap()
    let r = process.run("env", ["BLINK_TRACE_CHANNELS=mono", "build/blink", "run", path]).unwrap()
    compile_test_helpers.sh("rm -rf {dir}")
    assert(r.success(), r.err_out)
    assert_eq(r.out, "5\n")
    let mono_lines = r.err_out.split("\n").filter(fn(l) { l.contains("mono") })
    assert_eq(mono_lines.join("\n"), "[trace:mono] lower 4")
}

test "blink run with a blink. channel writes the compiler's line and not the program's" {
    let dir = "{compile_test_helpers.scratch_root()}/run_compiler_channel"
    compile_test_helpers.sh("mkdir -p {dir}")
    let path = "{dir}/run_compiler_channel.bl"
    fs.write(path, LOWER_SRC).unwrap()
    let r = process.run("env", ["BLINK_TRACE_CHANNELS=blink.mono", "build/blink", "run", "--no-cache", path]).unwrap()
    compile_test_helpers.sh("rm -rf {dir}")
    assert(r.success(), r.err_out)
    assert_eq(r.out, "5\n")
    assert(r.err_out.contains("[trace:blink.mono] instances="), r.err_out)
    assert(!r.err_out.contains("[trace:mono]"), r.err_out)
}
