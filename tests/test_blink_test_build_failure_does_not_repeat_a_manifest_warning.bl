// `blink test` builds each test file in a `blink build` worker and shows the worker's output when
// the build fails. The worker loads blink.toml too, and the command already printed its warning;
// the command must not show that warning a second time. A call to a
// C symbol that does not exist passes the typecheck and fails only at link time. The warning is
// an unknown section: an invalid lint level is an error, which fails the typecheck.

import std.process.{ProcessResult}

let SECTION_WARNING = "warning[UnknownManifestSection]: unknown section `[bogus]` in blink.toml"

fn sh(cmd: Str) -> ProcessResult {
    process_run("sh", ["-c", cmd])
}

fn count(text: Str, part: Str) -> Int {
    text.split(part).len() - 1
}

test "a failed test build does not repeat the manifest warning" {
    let dir = sh("mktemp -d /tmp/blink_test_build_failure_warning.XXXXXX").out.trim()
    let _ = sh("mkdir -p {dir}/src {dir}/tests")
    write_file("{dir}/blink.toml", "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[bogus]\nx = 1\n")
    // A lock no older than blink.toml keeps dependency resolution out of the command.
    write_file("{dir}/blink.lock", "[metadata]\nlockfile-version = 1\n")
    write_file("{dir}/tests/test_links.bl", "@ffi(\"c\", \"blink_test_symbol_that_no_library_defines\")\n@trusted(audit: \"test\")\nfn missing() -> Int ! FFI\n\ntest \"links\" \{\n    assert(missing() == 1)\n}\n")
    write_file("{dir}/tests/test_plain.bl", "test \"plain\" \{\n    assert(1 == 1)\n}\n")
    // BLINK_BIN makes the build workers the compiler under test, not the blink on PATH.
    let r = sh("B=$(pwd)/build/blink; cd {dir} && env -u BLINK_PER_MODULE BLINK_BIN=$B $B test tests")
    let _ = sh("rm -rf {dir}")

    assert_eq(r.exit_code, 1)
    assert(r.out.contains("BUILD FAILED"))
    assert(r.out.contains("blink_test_symbol_that_no_library_defines"))
    assert_eq(count(r.err_out, SECTION_WARNING), 1)
    assert(!r.out.contains(SECTION_WARNING))
}
