// `blink test` links the stdlib archive of the tree or install it runs from, so it must
// not build one in the directory it runs in. A dev tree builds only where it links, and
// an installed archive is never built.

import compile_test_helpers

fn sh(cmd: Str) -> Str {
    process_run("sh", ["-c", cmd]).out.trim()
}

fn write_test_file(proj: Str) {
    shell_exec("rm -rf {proj} && mkdir -p {proj}")
    write_file("{proj}/t.bl", "test \"t\" \{\n    assert(true)\n\}\n")
}

// The combined output of `blink test t.bl` run in proj.
fn blink_test_in(proj: Str, blink: Str) -> Str {
    let r = process_run("sh", ["-c", "cd {proj} && env -u BLINK_ROOT BLINK_CACHE_DIR= {blink} test t.bl 2>&1"])
    r.out
}

test "blink test from outside a dev tree builds no stdlib archive in its cwd" {
    let root = sh("pwd -P")
    let blink = sh("readlink -f build/blink")
    let arc = sh("dirname \"$(readlink -f build/libblink_std.h)\"")
    let tree = "{compile_test_helpers.scratch_root()}/_test_arc_dev_{getpid()}"
    let proj = "{tree}_proj"
    shell_exec("rm -rf {tree}")
    shell_exec("mkdir -p {tree}/build")
    // A copy, not a link: the install root comes from realpath(argv[0]).
    shell_exec("cp {blink} {tree}/build/blink")
    shell_exec("ln -s {root}/lib {tree}/lib")
    shell_exec("ln -s {root}/lib {tree}/build/lib")
    shell_exec("cp -L {root}/build/runtime.h {tree}/build/runtime.h")
    shell_exec("cp -L {arc}/libblink_std.a {arc}/libblink_std.h {arc}/skip_modules.txt {arc}/.archive-id {tree}/build/")
    write_test_file(proj)

    let out = blink_test_in(proj, "{tree}/build/blink")
    assert(out.contains("1 passed, 0 failed"), "blink test failed: {out}")
    assert_eq(file_exists("{proj}/build/std-cache"), 0)
    // The tree's archive was built by this compiler, so nothing is rebuilt there either.
    assert_eq(file_exists("{tree}/build/std-cache"), 0)
    shell_exec("rm -rf {tree} {proj}")
}

test "installed blink test builds no stdlib archive" {
    let root = sh("pwd -P")
    let blink = sh("readlink -f build/blink")
    let arc = sh("dirname \"$(readlink -f build/libblink_std.h)\"")
    let tree = "{compile_test_helpers.scratch_root()}/_test_arc_installed_{getpid()}"
    let proj = "{tree}_proj"
    shell_exec("rm -rf {tree}")
    shell_exec("mkdir -p {tree}/bin {tree}/share/blink")
    shell_exec("cp {blink} {tree}/bin/blink")
    shell_exec("cp -L {arc}/libblink_std.a {arc}/libblink_std.h {arc}/skip_modules.txt {arc}/.archive-id {tree}/share/blink/")
    shell_exec("cp -L {root}/build/runtime.h {tree}/share/blink/runtime.h")
    write_test_file(proj)

    let out = blink_test_in(proj, "{tree}/bin/blink")
    assert(out.contains("1 passed, 0 failed"), "installed blink test failed: {out}")
    assert_eq(file_exists("{proj}/build/std-cache"), 0)
    assert_eq(file_exists("{tree}/share/blink/std-cache"), 0)
    shell_exec("rm -rf {tree} {proj}")
}
