// `blink test` runs each test binary with a timeout (sections/06_tooling.md §8.10.7): from
// --timeout, else from [test] timeout in blink.toml, else 10m. A binary past it is an aborted
// file: the human output names the limit and a help line, and the run exits 1. The fixtures
// live under a fresh temporary directory, since the test tree itself sits inside a project.

import std.process.{ChildEnd, ChildLimits, ProcessResult}
import std.time.{Duration}

let PACKAGE = "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n"

let HANG = "import std.time.\{Duration}\n\ntest \"hangs\" \{\n    while true \{\n        time.sleep(Duration.ms(50))\n    }\n}\n"

// Takes about a second, far past 200ms and far below the 10m default.
let SLOW = "import std.time.\{Duration}\n\ntest \"slow\" \{\n    time.sleep(Duration.seconds(1))\n    assert(1 == 1)\n}\n"

let ABORTED = "ABORTED tests/test_hang.bl\n  timed out after 300ms in test \"hangs\"\n  help: raise it with --timeout <duration> or [test] timeout in blink.toml; none turns it off\n"

// A runner bug that hangs fails this test instead of the gate.
fn sh(cmd: Str) -> ProcessResult {
    process.run("sh", ["-c", cmd], limits: ChildLimits { timeout: Some(Duration.seconds(180)) }).unwrap()
}

// Runs `blink test <args>` in a fresh project that has one test file, tests/<name>.bl.
fn blink_test(toml: Str, name: Str, source: Str, args: Str) -> ProcessResult {
    let dir = sh("mktemp -d /tmp/blink_test_timeout.XXXXXX").out.trim()
    let _ = sh("mkdir -p {dir}/src {dir}/tests")
    write_file("{dir}/blink.toml", toml)
    // A lock no older than blink.toml keeps dependency resolution out of the command.
    write_file("{dir}/blink.lock", "[metadata]\nlockfile-version = 1\n")
    write_file("{dir}/tests/{name}.bl", source)
    // BLINK_BIN makes the build workers the compiler under test, not the blink on PATH.
    let r = sh("B=$(pwd)/build/blink; cd {dir} && env -u BLINK_PER_MODULE BLINK_BIN=$B $B test {args}")
    let _ = sh("rm -rf {dir}")
    r
}

test "--timeout ends a hanging binary as an aborted file with the limit and a help line" {
    let r = blink_test(PACKAGE, "test_hang", HANG, "--verbose --timeout 300ms tests")
    assert_eq(r.end, ChildEnd.Exited(1), "stdout:\n{r.out}\nstderr:\n{r.err_out}")
    assert(r.out.contains(ABORTED), r.out)
    assert(r.out.contains("0 passed, 0 failed (of 0); 1 file aborted"), r.out)
}

test "--timeout ends the binary of a run of one file" {
    let r = blink_test(PACKAGE, "test_hang", HANG, "--timeout 300ms tests/test_hang.bl")
    assert_eq(r.end, ChildEnd.Exited(1), "stdout:\n{r.out}\nstderr:\n{r.err_out}")
    assert(r.out.contains(ABORTED), r.out)
}

test "[test] timeout in blink.toml ends a hanging binary" {
    let r = blink_test("{PACKAGE}[test]\ntimeout = \"300ms\"\n", "test_hang", HANG, "tests")
    assert_eq(r.end, ChildEnd.Exited(1), "stdout:\n{r.out}\nstderr:\n{r.err_out}")
    assert(r.out.contains(ABORTED), r.out)
}

test "--timeout none beats [test] timeout" {
    let r = blink_test("{PACKAGE}[test]\ntimeout = \"200ms\"\n", "test_slow", SLOW, "--timeout none tests")
    assert_eq(r.end, ChildEnd.Exited(0), "stdout:\n{r.out}\nstderr:\n{r.err_out}")
    assert(!r.out.contains("ABORTED"), r.out)
}

test "a --timeout value beats [test] timeout" {
    let r = blink_test("{PACKAGE}[test]\ntimeout = \"200ms\"\n", "test_slow", SLOW, "--timeout 5m tests")
    assert_eq(r.end, ChildEnd.Exited(0), "stdout:\n{r.out}\nstderr:\n{r.err_out}")
}

test "[test] timeout beats the default" {
    let r = blink_test("{PACKAGE}[test]\ntimeout = \"200ms\"\n", "test_slow", SLOW, "tests")
    assert_eq(r.end, ChildEnd.Exited(1), "stdout:\n{r.out}\nstderr:\n{r.err_out}")
    assert(r.out.contains("ABORTED tests/test_slow.bl\n  timed out after 200ms in test \"slow\"\n"), r.out)
}

test "--json reports a limit end as an aborted file line with the limit and the running test" {
    let r = blink_test(PACKAGE, "test_hang", HANG, "--json --timeout 300ms tests")
    assert_eq(r.end, ChildEnd.Exited(1), "stdout:\n{r.out}\nstderr:\n{r.err_out}")
    assert(r.out.contains("\{\"record\":\"file\",\"file\":\"tests/test_hang.bl\",\"outcome\":\"aborted\",\"limit\":\"timeout\",\"limit_ms\":300,\"running\":\"hangs\","), r.out)
    assert(r.out.contains("\"files\":\{\"total\":1,\"ran\":0,\"build_failed\":0,\"aborted\":1}"), r.out)
    assert(!r.out.contains("ABORTED"), r.out)
}
