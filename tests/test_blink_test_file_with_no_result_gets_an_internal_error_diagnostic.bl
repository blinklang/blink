// A file whose task hands back no result is the runner's own fault (§8.10.5). Its file line
// reads aborted with one ice diagnostic, I0016 TestResultLost, so it never reads as a compile
// error of the user's code, and it still fails the run. The test lines that the binary wrote
// before the result was lost stay in the stream and count.
//
// BLINK_DEV_TEST_FAULT=lost:<file> runs that file's binary, then ends its task without its result.
// Fixture basenames must be unique per worker: `blink test` writes each binary to build/<basename>.

import compile_test_helpers

fn run_dropping(scratch: Str, dropped: Str, flag: Str) -> Str {
    let r = process.run("sh", ["-c", "BLINK_DEV_TEST_FAULT=lost:{dropped} build/blink test {flag} {scratch} 2>&1; echo \"exit=$?\""]).unwrap()
    r.out
}

test "a file with no result is aborted with one internal error diagnostic" {
    let scratch = "{compile_test_helpers.scratch_root()}/_test_no_result_{getpid()}"
    process.run("sh", ["-c", "rm -rf {scratch}"])?
    process.run("sh", ["-c", "mkdir -p {scratch}"])?
    let mut gi = 0
    while gi < 3 {
        fs.write("{scratch}/no_result_good_{gi}_{getpid()}.bl", "test \"good_{gi}\" \{\n    assert(1 + 1 == 2)\n}\n").unwrap()
        gi = gi + 1
    }
    let dropped = "{scratch}/no_result_good_1_{getpid()}.bl"

    let json = run_dropping(scratch, dropped, "--json")
    let jdiag = "captured:\n{json}"
    let lost = "\{\"record\":\"file\",\"file\":\"{dropped}\",\"outcome\":\"aborted\",\"diagnostics\":[\{\"severity\":\"ice\",\"name\":\"TestResultLost\",\"code\":\"I0016\",\"message\":\"blink test lost the result of this file\"}],\"summary\":\{\"total\":1,\"passed\":1,\"failed\":0,\"panicked\":0,\"skipped\":0,\"duration_ms\":0}}"
    assert(json.contains(lost), "expected an ice TestResultLost on the dropped file; {jdiag}")
    assert(!json.contains("\"severity\":\"error\""), "a file with no result must not read as a compile error; {jdiag}")
    assert(json.contains("\"files\":\{\"total\":3,\"ran\":2,\"build_failed\":0,\"aborted\":1}"), "expected the other two files to run; {jdiag}")
    assert(json.contains("\{\"record\":\"run\",\"summary\":\{\"total\":3,\"passed\":3,"), "expected the test line of the lost file to count; {jdiag}")
    assert(json.contains("exit=1"), "a file with no result must fail the run; {jdiag}")

    let text = run_dropping(scratch, dropped, "--quiet")
    let tdiag = "captured:\n{text}"
    assert(text.contains("ABORTED {dropped}\n  ice[I0016]: blink test lost the result of this file\n  note: this is a bug in blink test; please report it\n"), "expected the internal error under the dropped file; {tdiag}")
    assert(!text.contains("error[E"), "a file with no result must not read as a compile error; {tdiag}")
    assert(text.contains("3 passed, 0 failed (of 3); 1 file aborted\n"), "expected the summary to count the lost file; {tdiag}")
    assert(text.contains("exit=1"), "a file with no result must fail the run; {tdiag}")

    process.run("sh", ["-c", "rm -rf {scratch}"])?
}
