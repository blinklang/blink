// `blink test` gives each test process the null device as its standard input (§8.10.1), so
// an unhandled read sees end of input at once and never takes the runner's own input.

import std.process.{ProcessResult, ChildEnd}

fn sh(cmd: Str) -> ProcessResult {
    process.run("sh", ["-c", cmd]).unwrap()
}

let FIXTURE = "test \"an unhandled read sees end of input\" \{\n    assert_eq(io.read_line(), None)\n    assert_eq(io.read_all(), \"\")\n    assert(io.read_bytes(4).is_empty())\n}\n"

// Runs `blink test <target>` in a fresh project holding the fixture, with the runner's own
// standard input taken from a file, and answers its exit code.
fn run_fixture(target: Str) -> ChildEnd {
    let dir = sh("mktemp -d /tmp/blink_test_null_stdin.XXXXXX").out.trim()
    let _ = sh("mkdir -p {dir}/p/src {dir}/p/tests")
    write_file("{dir}/p/blink.toml", "[package]\nname = \"p\"\nversion = \"0.1.0\"\n")
    // A lock no older than blink.toml keeps dependency resolution out of the command.
    write_file("{dir}/p/blink.lock", "[metadata]\nlockfile-version = 1\n")
    write_file("{dir}/p/tests/test_reads_stdin.bl", FIXTURE)
    write_file("{dir}/input.txt", "the runner's input\nmore\n")
    // BLINK_BIN makes the build workers the compiler under test, not the blink on PATH.
    let r = sh("B=$(pwd)/build/blink; cd {dir}/p && BLINK_BIN=$B timeout 300 $B test {target} < {dir}/input.txt")
    let _ = sh("rm -rf {dir}")
    r.end
}

test "an unhandled read under blink test of a directory sees end of input, not the runner's input" {
    assert_eq(run_fixture("."), ChildEnd.Exited(0))
}

test "an unhandled read under blink test of one file sees end of input, not the runner's input" {
    assert_eq(run_fixture("tests/test_reads_stdin.bl"), ChildEnd.Exited(0))
}
