// A test binary keeps an assert's values in fixed-size buffers, so a long value is cut, and the
// cut can land inside a multi-byte UTF-8 char. The report line that carries it must still be
// UTF-8, and blink test must read every other line of the report: the file ran, with one
// failed test and two that passed (sections/06_tooling.md §8.10).

import std.process.{ChildEnd, ChildLimits, ProcessResult}
import std.time.{Duration}
import std.json.{json_clear, json_parse, json_get, json_as_str, json_as_int}

let PACKAGE = "[package]\nname = \"app\"\nversion = \"0.1.0\"\n"

// 200 copies of a two-byte char fill the 256-byte buffer for the actual value, and the
// cut falls in the middle of one char.
let CUT = #"test "before" {
    assert_eq(1, 1)
}

test "long value" {
    let mut s = ""
    let mut i = 0
    while i < 200 {
        s = s.concat("é")
        i = i + 1
    }
    assert_eq(s, "x")
}

test "after" {
    assert_eq(2, 2)
}
"#

// A runner bug that hangs fails this test instead of the gate.
fn sh(cmd: Str) -> ProcessResult {
    process.run("sh", ["-c", cmd], limits: ChildLimits { timeout: Some(Duration.seconds(300)) }).unwrap()
}

fn blink_test(args: Str) -> ProcessResult {
    let dir = sh("mktemp -d /tmp/blink_test_utf8_cut.XXXXXX").out.trim()
    let _ = sh("mkdir -p {dir}/src {dir}/tests")
    write_file("{dir}/blink.toml", PACKAGE)
    // A lock no older than blink.toml keeps dependency resolution out of the command.
    write_file("{dir}/blink.lock", "[metadata]\nlockfile-version = 1\n")
    write_file("{dir}/tests/test_cut.bl", CUT)
    // BLINK_BIN makes the build workers the compiler under test, not the blink on PATH.
    let r = sh("B=$(pwd)/build/blink; cd {dir} && env -u BLINK_PER_MODULE BLINK_BIN=$B $B test {args}")
    let _ = sh("rm -rf {dir}")
    r
}

fn diag(r: ProcessResult) -> Str {
    "exit {r.end}\nstdout:\n{r.out}\nstderr:\n{r.err_out}"
}

test "a value cut inside a UTF-8 char loses no line of the stream" {
    let r = blink_test("--json tests")
    assert_eq(r.end, ChildEnd.Exited(1), diag(r))
    let mut statuses: List[Str] = []
    let mut file_line = ""
    for line in r.out.split("\n") {
        if line.starts_with("\{\"record\":\"test\"") {
            json_clear()
            statuses.push(json_as_str(json_get(json_parse(line), "status")))
        } else if line.starts_with("\{\"record\":\"file\"") {
            file_line = line
        }
    }
    assert_eq(statuses.len(), 3, diag(r))
    assert_eq(statuses.filter(fn(s) { s == "passed" }).len(), 2, diag(r))
    assert_eq(statuses.filter(fn(s) { s == "failed" }).len(), 1, diag(r))
    json_clear()
    let root = json_parse(file_line)
    assert_eq(json_as_str(json_get(root, "outcome")), "ran", diag(r))
    assert_eq(json_as_int(json_get(json_get(root, "summary"), "total")), 3, diag(r))
}

test "the human output names the failed test whose value was cut" {
    let r = blink_test("tests")
    assert_eq(r.end, ChildEnd.Exited(1), diag(r))
    assert(r.out.contains("long value"), diag(r))
    assert(!r.out.contains("ABORTED"), diag(r))
}
