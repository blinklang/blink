// The text `blink test` prints for a limit (spec §8.10.7, *What the report shows*). A limit is
// written as the flag accepts it, in the largest unit with no remainder. A limit end names the
// cause, the limit and the test, and its help line names the flag in the spelling of the flag
// table and turns the limit off with `none`.

import std.process.{LimitKind}
import limit_values.{limit_text, limit_end_line, limit_end_help, limit_unsupported_error, limit_unsupported_help, parse_limit_value}

test "a duration is written in the largest unit with no remainder" {
    assert_eq(limit_text(LimitKind.Timeout, 600000), "10m")
    assert_eq(limit_text(LimitKind.Timeout, 90000), "90s")
    assert_eq(limit_text(LimitKind.Timeout, 1500), "1500ms")
    assert_eq(limit_text(LimitKind.Timeout, 3600000), "1h")
    assert_eq(limit_text(LimitKind.Timeout, 5400000), "90m")
    assert_eq(limit_text(LimitKind.Timeout, 1), "1ms")
}

test "a size is written in the largest power of 1024 with no remainder" {
    assert_eq(limit_text(LimitKind.Memory, 2 * 1024 * 1024 * 1024), "2G")
    assert_eq(limit_text(LimitKind.Memory, 512 * 1024 * 1024), "512M")
    assert_eq(limit_text(LimitKind.Memory, 1536 * 1024 * 1024), "1536M")
    assert_eq(limit_text(LimitKind.Memory, 1024), "1K")
}

test "a count is written as it is" {
    assert_eq(limit_text(LimitKind.Processes, 1024), "1024")
}

test "the text of a limit reads back as the same value" {
    for pair in [(LimitKind.Timeout, "1500ms"), (LimitKind.Timeout, "2h"), (LimitKind.Memory, "3K"), (LimitKind.Memory, "1536M"), (LimitKind.Processes, "7")] {
        let (kind, text) = pair
        assert_eq(limit_text(kind, parse_limit_value(kind, text).unwrap().unwrap()), text)
    }
}

test "a limit end names the cause, the limit and the test" {
    assert_eq(limit_end_line(LimitKind.Timeout, 600000, Some("hangs")), "timed out after 10m in test \"hangs\"")
    assert_eq(limit_end_line(LimitKind.Memory, 2 * 1024 * 1024 * 1024, Some("pushes forever")), "used more than the 2G memory limit in test \"pushes forever\"")
    assert_eq(limit_end_line(LimitKind.Processes, 1024, Some("forks forever")), "went past the 1024 process limit in test \"forks forever\"")
}

test "a limit end outside any test ends after the limit" {
    assert_eq(limit_end_line(LimitKind.Timeout, 600000, None), "timed out after 10m")
    assert_eq(limit_end_line(LimitKind.Memory, 512 * 1024 * 1024, None), "used more than the 512M memory limit")
    assert_eq(limit_end_line(LimitKind.Processes, 64, None), "went past the 64 process limit")
}

test "the help of a limit end names the flag, and the [test] key only for the timeout" {
    assert_eq(limit_end_help(LimitKind.Timeout), "raise it with --timeout <duration> or [test] timeout in blink.toml; none turns it off")
    assert_eq(limit_end_help(LimitKind.Memory), "raise it with --memory <size>; none turns it off")
    assert_eq(limit_end_help(LimitKind.Processes), "raise it with --processes <count>; none turns it off")
}

test "a limit the host cannot apply names the flag and the fix" {
    assert_eq(limit_unsupported_error(LimitKind.Memory), "--memory needs Linux with a delegated cgroup v2; this session has none")
    assert_eq(limit_unsupported_help(LimitKind.Memory), "run under `systemd-run --user --scope -p Delegate=yes blink test ...`, or leave out --memory")
    assert_eq(limit_unsupported_error(LimitKind.Processes), "--processes needs Linux with a delegated cgroup v2; this session has none")
    assert_eq(limit_unsupported_help(LimitKind.Processes), "run under `systemd-run --user --scope -p Delegate=yes blink test ...`, or leave out --processes")
}
