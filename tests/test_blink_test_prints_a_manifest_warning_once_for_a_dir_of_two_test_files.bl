// One `blink test` command prints each blink.toml warning once, on stderr, however many test
// files it compiles: it typechecks every file in its own process, and each of those compiles
// loads the manifest. The fixture lives under a fresh temporary directory, since the test tree
// itself sits inside a project.

import std.process.{ProcessResult}

let LINT_WARNING = "warning: unknown lint level 'loud' for 'W0703' in [lints] (expected off, warn, or error)"
let SECTION_WARNING = "warning: unknown section 'bogus' in manifest"

fn sh(cmd: Str) -> ProcessResult {
    process_run("sh", ["-c", cmd])
}

fn count(text: Str, part: Str) -> Int {
    text.split(part).len() - 1
}

test "blink test over two test files prints each manifest warning once on stderr" {
    let dir = sh("mktemp -d /tmp/blink_test_manifest_warning_once.XXXXXX").out.trim()
    let _ = sh("mkdir -p {dir}/src {dir}/tests")
    write_file("{dir}/blink.toml", "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[lints]\nW0703 = \"loud\"\n\n[bogus]\nx = 1\n")
    // A lock no older than blink.toml keeps dependency resolution out of the command.
    write_file("{dir}/blink.lock", "[metadata]\nlockfile-version = 1\n")
    write_file("{dir}/tests/test_one.bl", "test \"one\" \{\n    assert(1 == 1)\n}\n")
    write_file("{dir}/tests/test_two.bl", "test \"two\" \{\n    assert(2 == 2)\n}\n")
    // BLINK_BIN makes the build workers the compiler under test, not the blink on PATH.
    let r = sh("B=$(pwd)/build/blink; cd {dir} && env -u BLINK_PER_MODULE BLINK_BIN=$B $B test tests")
    let _ = sh("rm -rf {dir}")

    assert_eq(r.exit_code, 0)
    assert_eq(count(r.err_out, LINT_WARNING), 1)
    assert_eq(count(r.err_out, SECTION_WARNING), 1)
    assert(!r.out.contains(LINT_WARNING))
    assert(!r.out.contains(SECTION_WARNING))
}
