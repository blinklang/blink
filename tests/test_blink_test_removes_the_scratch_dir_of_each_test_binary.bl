// `blink test` gives each test binary a scratch dir below TMPDIR (BLINK_TEST_SCRATCH_DIR) and
// removes it once the binary ends, in the one-file and the directory mode. Without that, a run
// over the whole suite leaves one dir per test file in TMPDIR.
// Fixture basenames must be unique per worker: `blink test` writes each binary to build/<basename>.

import compile_test_helpers

fn fixture(name: Str) -> Str {
    "test \"{name} sees a scratch dir of its own under TMPDIR\" \{\n    let dir = env.var(\"BLINK_TEST_SCRATCH_DIR\") ?? \"\"\n    let tmp = env.var(\"TMPDIR\") ?? \"\"\n    assert(dir != \"\", \"the runner names no scratch dir\")\n    assert(dir.starts_with(tmp), \"scratch dir \{dir} is not below TMPDIR \{tmp}\")\n    shell_exec(\"mkdir -p \{dir} && echo kept > \{dir}/probe\")\n    assert(file_exists(\"\{dir}/probe\") == 1)\n}\n"
}

fn run_under(tmp: Str, target: Str) -> Str {
    let r = process_run("sh", ["-c", "TMPDIR={tmp} build/blink test {target} --quiet 2>&1; echo \"exit=$?\""])
    r.out
}

test "blink test removes the scratch dir of each test binary in directory mode" {
    let root = "{compile_test_helpers.scratch_root()}/_test_scratch_cleanup_dir"
    let tmp = "{root}/tmp"
    let src = "{root}/src"
    shell_exec("rm -rf {root}")
    shell_exec("mkdir -p {tmp} {src}")
    write_file("{src}/scratch_cleanup_dir_a_{getpid()}.bl", fixture("a"))
    write_file("{src}/scratch_cleanup_dir_b_{getpid()}.bl", fixture("b"))

    let out = run_under(tmp, src)
    let diag = "captured:\n{out}"
    assert(out.contains("2 test files: 2 passed, 0 failed, 0 build errors"), "expected both files to pass; {diag}")
    let left = process_run("ls", ["-A", tmp]).out
    assert(left == "", "the runner left scratch dirs behind: {left}")

    shell_exec("rm -rf {root}")
}

test "blink test removes the scratch dir of a test binary in one-file mode" {
    let root = "{compile_test_helpers.scratch_root()}/_test_scratch_cleanup_file"
    let tmp = "{root}/tmp"
    shell_exec("rm -rf {root}")
    shell_exec("mkdir -p {tmp}")
    let file = "{root}/scratch_cleanup_file_{getpid()}.bl"
    write_file(file, fixture("single"))

    let out = run_under(tmp, file)
    let diag = "captured:\n{out}"
    assert(out.contains("exit=0"), "expected the file to pass; {diag}")
    let left = process_run("ls", ["-A", tmp]).out
    assert(left == "", "the runner left scratch dirs behind: {left}")

    shell_exec("rm -rf {root}")
}
