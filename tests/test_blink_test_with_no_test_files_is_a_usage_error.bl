// `blink test` on a path with no test files is a usage error (sections/06_tooling.md §8.10.5): it
// exits 2 with the reason on stderr, and writes no `file` line and no `run` line. An exit of 0
// would let a CI job with a wrong path pass with no test run.

import std.process.{ChildEnd, ChildLimits, ProcessResult}
import std.time.{Duration}

fn sh(cmd: Str) -> ProcessResult {
    process.run("sh", ["-c", cmd], limits: ChildLimits { timeout: Some(Duration.seconds(120)) }).unwrap()
}

fn blink_test(args: Str) -> ProcessResult {
    let dir = sh("mktemp -d /tmp/blink_test_no_files.XXXXXX").out.trim()
    let _ = sh("mkdir -p {dir}/tests")
    write_file("{dir}/blink.toml", "[package]\nname = \"app\"\nversion = \"0.1.0\"\n")
    write_file("{dir}/blink.lock", "[metadata]\nlockfile-version = 1\n")
    write_file("{dir}/tests/helper.bl", "fn helper() -> Int \{\n    1\n}\n")
    let r = sh("B=$(pwd)/build/blink; cd {dir} && env -u BLINK_PER_MODULE BLINK_BIN=$B $B test {args}")
    let _ = sh("rm -rf {dir}")
    r
}

test "a directory with no test files exits 2 with the reason on stderr and nothing on stdout" {
    for args in ["tests", "--json tests"] {
        let r = blink_test(args)
        assert_eq(r.end, ChildEnd.Exited(2), "{args}: stdout:\n{r.out}\nstderr:\n{r.err_out}")
        assert_eq(r.out, "", args)
        assert(r.err_out.contains("no files with test blocks"), "{args}: {r.err_out}")
    }
}
