// A blink.toml issue is a diagnostic with a code and a span in blink.toml (§8.9.8): an invalid
// lint level is the error E0843 on the value token, with the valid levels as help, and an
// unknown section is the warning W1001 on the [header], with the closest defined section as
// help when one is close. `check --json` gives one row on stderr for each issue and leaves
// stdout to the status line. The fixture lives under a fresh temporary directory, since the
// test tree itself sits inside a project.

import std.process.{ProcessResult}
import std.json.{json_clear, json_parse, json_get, json_as_str, json_as_int}

let PACKAGE = "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n"

fn sh(cmd: Str) -> ProcessResult {
    process.run("sh", ["-c", cmd]).unwrap()
}

fn check(toml: Str, args: Str) -> ProcessResult {
    let dir = sh("mktemp -d /tmp/blink_toml_issue_codes.XXXXXX").out.trim()
    let _ = sh("mkdir -p {dir}/src")
    write_file("{dir}/blink.toml", toml)
    // A lock no older than blink.toml keeps dependency resolution out of the check.
    write_file("{dir}/blink.lock", "[metadata]\nlockfile-version = 1\n")
    write_file("{dir}/src/main.bl", "fn main() \{\n    io.println(\"hi\")\n}\n")
    let r = sh("B=$(pwd)/build/blink; cd {dir} && $B check {args} src/main.bl")
    let _ = sh("rm -rf {dir}")
    r
}

// The JSON row of the only line on stderr, after asserting there is one.
fn only_row(r: ProcessResult) -> Int {
    let lines = r.err_out.trim().split("\n")
    assert_eq(lines.len(), 1, "stderr:\n{r.err_out}")
    json_clear()
    let row = json_parse(lines.get(0).unwrap())
    assert(row >= 0, "not JSON: {r.err_out}")
    row
}

fn assert_status_only(r: ProcessResult, status: Str) {
    assert_eq(r.out.trim().split("\n").len(), 1, "stdout:\n{r.out}")
    json_clear()
    let root = json_parse(r.out.trim())
    assert(root >= 0, "not JSON: {r.out}")
    assert_eq(json_as_str(json_get(root, "status")), status)
}

fn assert_span(row: Int, line: Int, col: Int, end_col: Int) {
    let span = json_get(row, "span")
    assert_eq(json_as_str(json_get(span, "file")), "blink.toml")
    assert_eq(json_as_int(json_get(span, "line")), line)
    assert_eq(json_as_int(json_get(span, "col")), col)
    assert_eq(json_as_int(json_get(span, "end_line")), line)
    assert_eq(json_as_int(json_get(span, "end_col")), end_col)
}

test "an invalid lint level is the error E0843 on its value token and fails the check" {
    let r = check("{PACKAGE}[lints]\nW0703 = \"loud\"\n", "")
    assert_eq(r.exit_code, 1)
    assert(r.err_out.contains("error[InvalidLintLevel]: invalid lint level `loud` for `W0703`\n  --> blink.toml:6:9\n"), r.err_out)
    assert(r.err_out.contains("6 | W0703 = \"loud\"\n  |         ^^^^^^\n"), r.err_out)
    assert(r.err_out.contains("  help: a lint level is one of \"off\", \"warn\" or \"error\"\n"), r.err_out)
    assert(!r.out.contains("InvalidLintLevel"))
}

test "check --json gives one E0843 row with the value span and the valid levels" {
    let r = check("{PACKAGE}[lints]\nW0703 = \"loud\"\n", "--json")
    assert_eq(r.exit_code, 1)
    let row = only_row(r)
    assert_eq(json_as_str(json_get(row, "severity")), "error")
    assert_eq(json_as_str(json_get(row, "code")), "E0843")
    assert_eq(json_as_str(json_get(row, "name")), "InvalidLintLevel")
    assert_span(row, 6, 9, 15)
    assert_eq(json_as_str(json_get(row, "help")), "a lint level is one of \"off\", \"warn\" or \"error\"")
    assert_status_only(r, "error")
}

test "a lint level that is not a string is E0843 on the whole token" {
    let r = check("{PACKAGE}[lints]\nW0703 = 3\n", "--json")
    assert_eq(r.exit_code, 1)
    let row = only_row(r)
    assert_eq(json_as_str(json_get(row, "code")), "E0843")
    assert_eq(json_as_str(json_get(row, "message")), "invalid lint level `3` for `W0703`")
    assert_span(row, 6, 9, 10)
}

test "an unknown section is the warning W1001 on its header with the closest section as help" {
    let r = check("{PACKAGE}[dependecies]\nx = 1\n", "")
    assert_eq(r.exit_code, 0)
    assert(r.err_out.contains("warning[UnknownManifestSection]: unknown section `[dependecies]` in blink.toml\n  --> blink.toml:5:1\n"), r.err_out)
    assert(r.err_out.contains("5 | [dependecies]\n  | ^^^^^^^^^^^^^\n"), r.err_out)
    assert(r.err_out.contains("  help: did you mean `[dependencies]`?\n"), r.err_out)
    assert_eq(r.out.trim(), "ok: src/main.bl")
}

test "check --json gives one W1001 row with the header span and the suggestion" {
    let r = check("{PACKAGE}[dependecies]\nx = 1\n", "--json")
    assert_eq(r.exit_code, 0)
    let row = only_row(r)
    assert_eq(json_as_str(json_get(row, "severity")), "warning")
    assert_eq(json_as_str(json_get(row, "code")), "W1001")
    assert_eq(json_as_str(json_get(row, "name")), "UnknownManifestSection")
    assert_span(row, 5, 1, 14)
    assert_eq(json_as_str(json_get(row, "help")), "did you mean `[dependencies]`?")
    assert_status_only(r, "ok")
}

test "an unknown section far from every defined section has no help" {
    let r = check("{PACKAGE}[bogus]\nx = 1\n", "--json")
    assert_eq(r.exit_code, 0)
    let row = only_row(r)
    assert_eq(json_as_str(json_get(row, "code")), "W1001")
    assert_eq(json_as_str(json_get(row, "message")), "unknown section `[bogus]` in blink.toml")
    assert_span(row, 5, 1, 8)
    assert(json_get(row, "help") < 0)
    assert_status_only(r, "ok")
}

test "check --json gives one row for each issue, in blink.toml order" {
    let r = check("{PACKAGE}[bogus]\nx = 1\n\n[lints]\nW0703 = \"loud\"\n", "--json")
    assert_eq(r.exit_code, 1)
    let lines = r.err_out.trim().split("\n")
    assert_eq(lines.len(), 2, r.err_out)
    json_clear()
    let first = json_parse(lines.get(0).unwrap())
    assert_eq(json_as_str(json_get(first, "code")), "W1001")
    json_clear()
    let second = json_parse(lines.get(1).unwrap())
    assert_eq(json_as_str(json_get(second, "code")), "E0843")
    assert_span(second, 9, 9, 15)
    assert_status_only(r, "error")
}
