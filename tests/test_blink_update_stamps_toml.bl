// End-to-end regression test for `blink update` stamping [package].blink-version
// into blink.toml.
//
// `blink update --help` promises to update the blink-version, and `blink init`
// stamps it. But `stamp_blink_version`'s non-empty branch used to search for the
// dead `pact-version` field, so a modern toml carrying `blink-version = "..."`
// was left stale. This drives the real CLI and asserts on-disk toml state.
//
// stamp_blink_version is a private fn in cli.bl, so we exercise it through the
// `blink update` surface (matching how test_cli_shim_init.bl tests init).

import compile_test_helpers

fn trim_newlines(s: Str) -> Str {
    let mut end = s.byte_len()
    while end > 0 {
        let ch = s.byte_at(end - 1)
        if ch == 10 || ch == 13 {
            end = end - 1
        } else {
            return s.byte_slice(0, end)
        }
    }
    ""
}

// `blink --version` prints "blink <version>\n"; strip the prefix + newlines.
fn parse_version(raw: Str) -> Str {
    let trimmed = trim_newlines(raw)
    let prefix = "blink "
    match trimmed.byte_index_of(prefix, 0) {
        Some(idx) => { return trimmed.byte_slice(idx + prefix.byte_len(), trimmed.byte_len()) }
        None => {}
    }
    trimmed
}

fn main() {
    let base = "{compile_test_helpers.scratch_root()}/_test_blink_update_stamps_toml"
    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {base}/src"]).unwrap()

    let pwd = process.run("sh", ["-c", "pwd -P"]).unwrap()
    let blink_root = trim_newlines(pwd.out)

    // The version the running compiler will stamp (matches what the lockfile gets).
    let ver_result = process.run("sh", ["-c", "{blink_root}/build/blink --version 2>&1"]).unwrap()
    let expected_version = parse_version(ver_result.out)
    if expected_version == "" {
        io.println("FAIL: could not read compiler version")
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        return
    }

    // Step 1: project whose [package].blink-version is an OLD value.
    let toml = "[package]\nname = \"updproj\"\nversion = \"0.1.0\"\nblink-version = \"0.0.1-old\"\n\n[dependencies]\n"
    fs.write("{base}/blink.toml", toml).unwrap()
    fs.write("{base}/src/main.bl", "fn main() \{\n    io.println(\"hi\")\n\}\n").unwrap()

    // Step 2: run `blink update` in the scratch project.
    let upd = process.run("sh", ["-c", "cd {base} && {blink_root}/build/blink update 2>&1"]).unwrap()
    if !upd.success() {
        io.println("FAIL: blink update ended with {upd.end}: {upd.out}")
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        return
    }
    io.println("PASS: blink update exit=0")

    // Step 3: the stale value is gone and the live version is stamped.
    let after = fs.read("{base}/blink.toml").unwrap()
    if after.contains("0.0.1-old") {
        io.println("FAIL: blink.toml still contains stale '0.0.1-old':\n{after}")
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        return
    }
    io.println("PASS: stale blink-version removed")

    let stamped = "blink-version = \"{expected_version}\""
    if !after.contains(stamped) {
        io.println("FAIL: blink.toml missing '{stamped}':\n{after}")
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        return
    }
    io.println("PASS: live blink-version stamped")

    // Step 4: a second update is harmless (idempotent) and keeps the stamp.
    let upd2 = process.run("sh", ["-c", "cd {base} && {blink_root}/build/blink update 2>&1"]).unwrap()
    if !upd2.success() {
        io.println("FAIL: second blink update ended with {upd2.end}: {upd2.out}")
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        return
    }
    let after2 = fs.read("{base}/blink.toml").unwrap()
    if !after2.contains(stamped) {
        io.println("FAIL: idempotent update lost the stamp:\n{after2}")
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        return
    }
    io.println("PASS: update is idempotent")

    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
}
