// The blinkc binary resolves a name selected through a `pub import` facade the same way the
// blink CLI does. std.fs re-exports FsError from std.fs_error, and §4.4.5 names it with
// `import std.fs.{FsError}`.

import compile_test_helpers

test "blinkc accepts a type selected through a pub import facade" {
    let src = "import std.fs.\{FsError}\nfn f(e: FsError) -> Str \{ e.path }\nfn main() ! IO, FS \{\n    match fs.read(\"/nope\") \{\n        Ok(s) => io.println(s)\n        Err(e) => io.println(f(e))\n    }\n}\n"
    compile_test_helpers.expect_no_error(src, "_blinkc_facade_selective", "E1006")
}
