// `build/blinkc` must honour BLINK_TRACE_CHANNELS.
//
// The compiler's trace notes are trace.log calls on channels named `blink.<area>`, so the
// runtime of each compiler binary reads the var. `build/blinkc` is the only MONOLITHIC
// emitter: `blink build` has no monolith flag (`--emit binary|c|per-module-dir`), so a trace
// channel that only fires on the archive-linked codegen path can be observed nowhere else.
// The two build modes take different codegen paths and a sweep in one is not coverage of
// the other, so a channel dark in blinkc is unmeasurable in half the compiler.
//
// Asserts through a real child process: only spawning the binary can observe what its
// runtime reads at start. Uses `blink.mono` as a representative tap, because it fires once
// on every compile — the property under test is the env-var wiring, not any one channel.

import std.fs
import std.process.{ProcessResult, ChildEnd}

// A stat that fails for another reason than a missing entry counts as there.
fn path_exists(path: Str) -> Bool ! FS.Read {
    match fs.stat(path) {
        Ok(_) => true
        Err(e) => !e.not_found()
    }
}

let PROBE_SRC: Str = #"fn main() {
    let xs: List[Int] = [1, 2, 3]
    let mut m: Map[Str, Int] = Map()
    m.insert("a", xs.len())
    io.println("{m.len()}")
}
"#

fn probe_path() -> Str { "build/blinkc_trace_channels_probe.bl" }

// blinkc, with the environment stated explicitly in both directions: `env VAR=...` for the
// on case, `env -u VAR` for the off case. Inheriting the harness's own environment would
// make the control pass or fail depending on how the suite was invoked.
fn run_blinkc(env_prefix: Str) -> ProcessResult ! Process.Spawn {
    process.run("sh", ["-c", "{env_prefix} build/blinkc {probe_path()} build/blinkc_trace_channels_probe.c 2>&1"]).unwrap()
}

fn have_blinkc() -> Bool ! FS.Read {
    path_exists("build/blinkc")
}

test "blinkc writes trace lines when BLINK_TRACE_CHANNELS names a compiler channel" {
    if !have_blinkc() {
        skip("build/blinkc is not present in this working tree")
        return
    }
    fs.write(probe_path(), PROBE_SRC).unwrap()
    let r = run_blinkc("env BLINK_TRACE_CHANNELS=blink.mono")
    let _ = fs.delete(probe_path())
    // 2>&1 above: trace.log writes to stderr, and folding it into stdout keeps this
    // assertion independent of the stream.
    assert_eq(r.end, ChildEnd.Exited(0))
    assert(r.out.contains("[trace:blink.mono] "))
}

test "blinkc stays silent when the env var is unset" {
    if !have_blinkc() {
        skip("build/blinkc is not present in this working tree")
        return
    }
    fs.write(probe_path(), PROBE_SRC).unwrap()
    let r = run_blinkc("env -u BLINK_TRACE_CHANNELS")
    let _ = fs.delete(probe_path())
    // Empty channel list must cost nothing and print nothing — the trace surface is a
    // debugging tap, not output.
    assert_eq(r.end, ChildEnd.Exited(0))
    assert(!r.out.contains("[trace:"))
}

test "an unrelated channel name does not turn a channel on" {
    if !have_blinkc() {
        skip("build/blinkc is not present in this working tree")
        return
    }
    fs.write(probe_path(), PROBE_SRC).unwrap()
    let r = run_blinkc("env BLINK_TRACE_CHANNELS=nosuchchannel")
    let _ = fs.delete(probe_path())
    // An item matches a channel by its whole text; wiring the var up must not degrade into
    // "any non-empty value means all".
    assert_eq(r.end, ChildEnd.Exited(0))
    assert(!r.out.contains("[trace:"))
}

test "the wildcard turns a channel on" {
    if !have_blinkc() {
        skip("build/blinkc is not present in this working tree")
        return
    }
    fs.write(probe_path(), PROBE_SRC).unwrap()
    let r = run_blinkc("env BLINK_TRACE_CHANNELS=all")
    let _ = fs.delete(probe_path())
    assert_eq(r.end, ChildEnd.Exited(0))
    assert(r.out.contains("[trace:blink.mono] "))
}

test "a program's channel name does not turn on the compiler channel of the same area" {
    if !have_blinkc() {
        skip("build/blinkc is not present in this working tree")
        return
    }
    fs.write(probe_path(), PROBE_SRC).unwrap()
    let r = run_blinkc("env BLINK_TRACE_CHANNELS=mono")
    let _ = fs.delete(probe_path())
    assert_eq(r.end, ChildEnd.Exited(0))
    assert(!r.out.contains("[trace:"))
}
