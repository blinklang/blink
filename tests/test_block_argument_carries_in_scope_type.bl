// A block passed straight into a call, or left as a function's tail, has no let binding to hold
// a recovered type. Its own node is the only place the in-scope type can go.

fn show(o: Option[Str]) -> Str {
    o.unwrap()
}

fn count(xs: List[Str]) -> Int {
    xs.len()
}

test "a block argument built from a block-local keeps its inner type" {
    let s = show({
        let p = "v"
        Some(p.concat("-a"))
    })
    assert_eq(s, "v-a")
}

test "a block List argument built from a block-local keeps its element type" {
    let n = count({
        let p = "v"
        [p, p.concat("-b")]
    })
    assert_eq(n, 2)
}

fn block_tail() -> Option[Str] {
    {
        let p = "v"
        Some(p.concat("-t"))
    }
}

test "a block as a function tail keeps its inner type" {
    assert_eq(block_tail().unwrap(), "v-t")
}
