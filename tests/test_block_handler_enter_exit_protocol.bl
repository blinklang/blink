// A BlockHandler runs enter() before the block and exit(ok) after it, with or without
// `as`. ok is true only when the block completes normally; `?` and `return` pass false.
// With `as`, the binder holds what enter() returns, not the handler itself.

let mut log: List[Str] = []

fn take_log() -> Str {
    let joined = log.join(",")
    log = []
    joined
}

type Mark {
    tag: Str
}

impl BlockHandler for Mark {
    type Context = Void

    fn enter(self) {
        log.push("enter:{self.tag}")
    }

    fn exit(self, ok: Bool) {
        log.push("exit:{self.tag}:{ok}")
    }
}

type Ctx {
    n: Int
}

type Opener {
    base: Int
}

impl BlockHandler for Opener {
    type Context = Ctx

    fn enter(self) -> Ctx {
        log.push("open:{self.base}")
        Ctx { n: self.base + 1 }
    }

    fn exit(self, ok: Bool) {
        log.push("close:{self.base}:{ok}")
    }
}

fn question_mark_inside() -> Result[Int, Str] {
    with Mark { tag: "q" } {
        let failed: Result[Int, Str] = Err("boom")
        let v = failed?
        log.push("unreached:{v}")
    }
    Ok(1)
}

fn return_inside() -> Int {
    with Mark { tag: "r" } {
        log.push("body:r")
        return 7
    }
    0
}

test "without as, enter runs before the body and exit(true) after it" {
    let _ = take_log()
    with Mark { tag: "a" } {
        log.push("body:a")
    }
    assert_eq(take_log(), "enter:a,body:a,exit:a:true")
}

test "? out of the block runs exit(false)" {
    let _ = take_log()
    let r = question_mark_inside()
    assert(r.is_err())
    assert_eq(take_log(), "enter:q,exit:q:false")
}

test "return out of the block runs exit(false)" {
    let _ = take_log()
    assert_eq(return_inside(), 7)
    assert_eq(take_log(), "enter:r,body:r,exit:r:false")
}

test "two items enter in order and exit in reverse" {
    let _ = take_log()
    with Mark { tag: "outer" }, Mark { tag: "inner" } {
        log.push("body")
    }
    assert_eq(take_log(), "enter:outer,enter:inner,body,exit:inner:true,exit:outer:true")
}

test "with as, the binder holds the value enter returns" {
    let _ = take_log()
    with Opener { base: 41 } as c {
        log.push("n:{c.n}")
    }
    assert_eq(take_log(), "open:41,n:42,close:41:true")
}

test "a block handler with block is an expression" {
    let _ = take_log()
    let v = with Mark { tag: "e" } {
        log.push("body:e")
        5
    }
    assert_eq(v, 5)
    assert_eq(take_log(), "enter:e,body:e,exit:e:true")
}
