// A generic body is lowered once per instance, and the context a `with` binds comes from
// the handler's enter method, which is declared outside that body.

type Conn { id: Int }
type Tx { tag: Str }

impl BlockHandler for Conn {
    type Context = Tx
    fn enter(self) -> Tx { Tx { tag: "t{self.id}" } }
    fn exit(self, _ok: Bool) { }
}

fn inside[T](x: T) -> T {
    with Conn { id: 1 } as ctx {
        assert_eq(ctx.tag, "t1")
    }
    x
}

test "a block handler's context is bound inside a generic function body" {
    assert_eq(inside(3), 3)
    assert_eq(inside("s"), "s")
}
