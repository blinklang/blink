// Regression (br p9ddps): a braced block expression bound to a `let` must thread
// its tail value to the binding. The MVCE's block ends in a bare `if` (IfExpr
// tail). emit_block_expr only handled an ExprStmt tail and forced the result to
// void/"0" for any other tail, so `let r = { ... if ... }` declared `void r` and
// dropped the value. emit_block_expr now delegates to emit_block_value.
fn pick(n: Int) -> Int {
    let r = {
        let base = 10
        if n == 0 { base + 1 } else { base + 2 }
    }
    r
}

test "block-let with if tail threads the value" {
    assert_eq(pick(0), 11)
    assert_eq(pick(1), 12)
}
