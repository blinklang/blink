// Regression (br p9ddps): a braced block expression bound to a `let` whose tail
// is a bare `match` (MatchExpr tail) must thread the match's value to the binding.
fn classify(n: Int) -> Int {
    let r = {
        let base = 100
        match n {
            0 => base + 1
            1 => base + 2
            _ => base + 3
        }
    }
    r
}

test "block-let with match tail threads the value" {
    assert_eq(classify(0), 101)
    assert_eq(classify(1), 102)
    assert_eq(classify(9), 103)
}
