// Regression (br p9ddps): block-let must thread the tail's C *type*, not just an
// Int. A block tail producing a Str must declare the binding as a Str, not void.
fn label(n: Int) -> Str {
    let s = {
        let prefix = "v"
        if n == 0 { prefix.concat("-zero") } else { prefix.concat("-other") }
    }
    s
}

test "block-let with str tail threads the string value and type" {
    assert_eq(label(0), "v-zero")
    assert_eq(label(7), "v-other")
}
