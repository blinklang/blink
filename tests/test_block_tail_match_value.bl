// Regression: a bare `match` as the tail of a braced match-arm body must still
// produce the arm's value. Before statement-position-match normalization the
// arm body was ExprStmt(MatchExpr) and hit emit_block_value's ExprStmt branch;
// the bare MatchExpr must be handled symmetrically (else the value is lost ->
// arm evaluates to 0). `with`-tail arms have the same shape (WithBlock).
fn pick_arm(n: Int) -> Int {
    match n {
        0 => {
            let base = 10
            match n {
                0 => base + 1
                _ => base + 2
            }
        }
        _ => 999
    }
}

test "match at braced arm body tail yields arm value" {
    assert_eq(pick_arm(0), 11)
    assert_eq(pick_arm(5), 999)
}
