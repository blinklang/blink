// A block, `if` or `match` value whose tail names a binding the block declares has the type
// of that tail (sections/02_syntax.md: a block in a hole has the value of its tail). Each
// consumer below reads the value as it would read the binding written in its place.

fn id[T](x: T) -> T { x }

fn wide(x: U64) -> U64 { x }

fn half(x: U64) -> Option[U64] { if x > 1 { Some(x / 2) } else { None } }

fn half_of_block(q: U64) -> Option[U64] {
    let v = {
        let h = half(q)
        h
    }?
    Some(v)
}

fn kept[T](x: T) -> T {
    let r = {
        let h = x
        h
    }
    r
}

fn paired[T](x: T) -> (T, Int) {
    ({
        let h = x
        h
    }, 1)
}

fn spawned(c: Bool) -> Int {
    let h = async.spawn(fn() {
        let x = 4
        if c { return 5 }
        x
    })
    h.await
}

type Wrap { v: U64 }

test "an option, a binary operand and a generic call take the block's tail type" {
    let q: U64 = 300
    let o = Some({
        let h = q
        h
    })
    assert_eq(o ?? 0, 300)
    let z = {
        let h = q
        h
    } + {
        let g = q
        g
    }
    assert_eq(z, 600)
    let a = id({
        let h = q
        h
    })
    assert_eq(a, 300)
}

test "a tuple element, a compound assignment and a ? operand take the block's tail type" {
    let q: U64 = 300
    let t = ({
        let h = q
        h
    }, 1)
    assert_eq(t.0, 300)
    assert_eq(t.1, 1)
    let mut x: U64 = 1
    x += {
        let h = q
        h
    }
    assert_eq(x, 301)
    assert_eq(half_of_block(q) ?? 0, 150)
}

test "an if or match value whose branch block names its own local takes that type" {
    let q: U64 = 300
    let c = true
    let i = wide(if c {
        let h = q
        h
    } else { 1 })
    assert_eq(i, 300)
    let m = match c {
        true => {
            let h = q
            h
        }
        false => q
    }
    assert_eq(m, 300)
    let d: U64 = if c {
        let h = q
        h * 2
    } else { 1 }
    assert_eq(d, 600)
}

test "a field access, a method call and a unary operand read a block receiver" {
    let q: U64 = 300
    let w = {
        let h = Wrap { v: q }
        h
    }.v
    assert_eq(w, 300)
    let s = {
        let h = "abc"
        h
    }.len()
    assert_eq(s, 3)
    let p = -({
        let h: Int = 5
        h
    } * 2)
    assert_eq(p, -10)
}

test "a generic body block takes each instance's type" {
    assert_eq(kept(3), 3)
    assert_eq(kept("s"), "s")
    assert_eq(paired("z").0, "z")
}

test "a with_ptr closure result whose tail names its own local is a value" {
    let bs = Bytes.from_str("hi")
    let z = bs.with_ptr(fn(p) {
        let a = p.addr()
        a
    }) + 1
    assert(z > 0)
    let o = Some(bs.with_ptr(fn(p2) {
        let a = p2.addr()
        a
    }))
    assert(o.is_some())
}

test "a spawned closure's return leaves the closure, not the enclosing fn" {
    assert_eq(spawned(false), 4)
    assert_eq(spawned(true), 5)
}

test "a closure body block takes the closure's param type" {
    let xs: List[U8] = [1, 2, 3]
    let ys = xs.map(fn(x) {
        let y = x + 1
        y
    })
    let w: List[U8] = ys
    assert_eq(w.get(0) ?? 0, 2)
}

test "a block value whose tail is a deep if nest takes the tail's type" {
    let q: U64 = 300
    let c = true
    let own = {
        let h = q
        if c { if c { if c { if c { h } else { h } } else { if c { h } else { h } } } else { if c { if c { h } else { h } } else { if c { h } else { h } } } } else { if c { if c { if c { h } else { h } } else { if c { h } else { h } } } else { if c { if c { h } else { h } } else { if c { h } else { h } } } }
    }
    let outer = wide({
        let _a = 1
        if c { if c { if c { if c { q } else { q } } else { if c { q } else { q } } } else { if c { if c { q } else { q } } else { if c { q } else { q } } } } else { if c { if c { if c { q } else { q } } else { if c { q } else { q } } } else { if c { if c { q } else { q } } else { if c { q } else { q } } } }
    })
    let deep = Some({
        let _b = 2
        { { { { { { { { { q } } } } } } } } }
    })
    assert_eq(own + 1, 301)
    assert_eq(outer, 300)
    assert_eq(deep ?? 0, 300)
}
