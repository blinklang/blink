// An exhaustive match on a Bool needs only `true` and `false` arms (§3.4, §3.5). Every Bool is
// one or the other, so each match below takes exactly one arm, and no default arm is needed.

fn arm_taken(b: Bool, hits: List[Int]) -> Str {
    match b {
        true => {
            hits.push(1)
            "true"
        }
        false => {
            hits.push(0)
            "false"
        }
    }
}

fn is_even(n: Int) -> Bool {
    n % 2 == 0
}

test "a true value takes the true arm and no other" {
    let mut hits: List[Int] = []
    assert_eq(arm_taken(true, hits), "true")
    assert_eq(hits, [1])
}

test "a false value takes the false arm and no other" {
    let mut hits: List[Int] = []
    assert_eq(arm_taken(false, hits), "false")
    assert_eq(hits, [0])
}

test "a Bool that a comparison made takes one arm for each input" {
    let mut hits: List[Int] = []
    for n in 0..4 {
        let _ = arm_taken(is_even(n), hits)
    }
    assert_eq(hits, [1, 0, 1, 0])
}

test "a Bool from a negation takes the other arm" {
    let mut hits: List[Int] = []
    let _ = arm_taken(!is_even(1), hits)
    assert_eq(hits, [1])
}

test "a match value needs no default arm" {
    let n = match is_even(3) {
        true => 10
        false => 20
    }
    assert_eq(n, 20)
}
