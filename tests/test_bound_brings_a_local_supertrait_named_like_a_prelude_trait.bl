// A supertrait clause names a trait by scope: here the file's own `Eq`, not the core one. A
// bound on the subtrait guarantees the local trait's methods, by method call and by qualified
// call.

type Pt {
    v: Int
}

trait Eq {
    fn same(self, o: Self) -> Bool
}

trait Kid: Eq {
    fn one(self) -> Int
}

impl Eq for Pt {
    fn same(self, o: Self) -> Bool {
        self.v == o.v
    }
}

impl Kid for Pt {
    fn one(self) -> Int {
        1
    }
}

fn same_through_kid[U: Kid](a: U, b: U) -> Bool {
    a.same(b) && Eq.same(a, b)
}

test "the local supertrait's method is callable through the subtrait's bound" {
    assert(same_through_kid(Pt { v: 1 }, Pt { v: 1 }))
    assert(!same_through_kid(Pt { v: 1 }, Pt { v: 2 }))
}
