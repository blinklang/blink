// A bound guarantees its trait's methods and every supertrait's, transitively
// (sections/03_types.md, "Operations on `Self` in a Default Body"). A call through `U: Kid`
// to a method a supertrait declares dispatches to the receiver's impl of that supertrait,
// by method call and by qualified call, at every kind of binder that carries a bound.

type Pt {
    v: Int
}

trait Base {
    fn base(self) -> Int
}

trait Kid: Base {
    fn one(self) -> Int
}

impl Base for Pt {
    fn base(self) -> Int {
        self.v
    }
}

impl Kid for Pt {
    fn one(self) -> Int {
        1
    }
}

fn through_kid[U: Kid](u: U) -> Int {
    u.base() + u.one()
}

fn qualified_through_kid[U: Kid](u: U) -> Int {
    Base.base(u)
}

test "a supertrait method is callable through the subtrait's bound" {
    assert_eq(through_kid(Pt { v: 1 }), 2)
    assert_eq(qualified_through_kid(Pt { v: 5 }), 5)
}

trait Ca {
    fn ca(self) -> Int
}

trait Cb: Ca {
    fn cb(self) -> Int
}

trait Cc: Cb {
    fn cc(self) -> Int
}

impl Ca for Pt {
    fn ca(self) -> Int {
        self.v
    }
}

impl Cb for Pt {
    fn cb(self) -> Int {
        10
    }
}

impl Cc for Pt {
    fn cc(self) -> Int {
        100
    }
}

fn through_chain[U: Cc](u: U) -> Int {
    u.ca() + u.cb() + u.cc() + Ca.ca(u)
}

test "a method two supertrait levels up is callable through the bound" {
    assert_eq(through_chain(Pt { v: 1 }), 112)
}

trait Da {
    fn da(self) -> Int
}

trait Db: Da {
    fn db(self) -> Int
}

trait Dc: Da {
    fn dc(self) -> Int
}

trait Dd: Db + Dc {
    fn dd(self) -> Int
}

impl Da for Pt {
    fn da(self) -> Int {
        self.v
    }
}

impl Db for Pt {
    fn db(self) -> Int {
        10
    }
}

impl Dc for Pt {
    fn dc(self) -> Int {
        100
    }
}

impl Dd for Pt {
    fn dd(self) -> Int {
        1000
    }
}

fn through_diamond[U: Dd](u: U) -> Int {
    u.da() + u.db() + u.dc() + u.dd()
}

test "a method a diamond's shared supertrait declares is callable through the bound" {
    assert_eq(through_diamond(Pt { v: 1 }), 1111)
}

trait Tr[T] {
    fn put(self, x: T) -> T
}

trait Sub: Tr[Int] {
    fn one_more(self) -> Int
}

trait GSub[X]: Tr[X] {
    fn two_more(self) -> Int
}

impl Tr[Int] for Pt {
    fn put(self, x: Int) -> Int {
        x + self.v
    }
}

impl Sub for Pt {
    fn one_more(self) -> Int {
        1
    }
}

impl GSub[Int] for Pt {
    fn two_more(self) -> Int {
        2
    }
}

fn through_sub[U: Sub](u: U) -> Int {
    u.put(5) + u.one_more()
}

fn through_gsub[U: GSub[Int]](u: U) -> Int {
    u.put(5) + u.two_more()
}

test "a supertrait method takes the trait arguments the supertrait clause gives" {
    assert_eq(through_sub(Pt { v: 1 }), 7)
    assert_eq(through_gsub(Pt { v: 1 }), 8)
}

type Bx[T] {
    x: T
}

trait ShowW {
    fn show_w(self) -> Int
}

trait ShowB {
    fn show_b(self) -> Int
}

impl[T] ShowW for Bx[T] where T: Kid {
    fn show_w(self) -> Int {
        self.x.base() + self.x.one()
    }
}

impl[T: Kid] ShowB for Bx[T] {
    fn show_b(self) -> Int {
        self.x.base() + self.x.one()
    }
}

test "a supertrait method is callable through an impl's where-bound and binder bound" {
    assert_eq(Bx { x: Pt { v: 1 } }.show_w(), 2)
    assert_eq(Bx { x: Pt { v: 3 } }.show_b(), 4)
}

@derive(Eq, Ord)
type Rank {
    r: Int
}

trait Ranked: Ord {
    fn weight(self) -> Int
}

impl Ranked for Rank {
    fn weight(self) -> Int {
        self.r
    }
}

fn ranked_less[U: Ranked](a: U, b: U) -> Bool {
    a < b
}

fn ranked_cmp[U: Ranked](a: U, b: U) -> Ordering {
    a.cmp(b)
}

test "a prelude supertrait licenses its operators and methods through the bound" {
    assert(ranked_less(Rank { r: 1 }, Rank { r: 2 }))
    assert(!ranked_less(Rank { r: 2 }, Rank { r: 1 }))
    assert(ranked_cmp(Rank { r: 1 }, Rank { r: 2 }) == Ordering.Less)
}
