// A generic struct whose type param T substitutes to a whole container type
// (Box[T] with T = Set[Int], so the field itself is `value: T`, not
// `value: Set[T]`) must still resolve the empty Set() ctor field to the
// scalar int kops vtable from the let annotation, not the erased string
// default. An Int key with a zero low byte (256, 512) collides under the
// string vtable, so a correct len()==2 after both inserts proves the fix.

type Box[T] { value: T }

test "boxed typevar Set(Int) ctor field keeps the int kops vtable" {
    let b: Box[Set[Int]] = Box { value: Set() }
    b.value.insert(256)
    b.value.insert(512)
    assert_eq(b.value.len(), 2)
    assert(b.value.contains(256))
    assert(b.value.contains(512))
}
