// sections/03_types.md §3.3: divergence is a property of the control transfer, not of the
// braces around it. A bare `return`/`break`/`continue` arm body is `Never` exactly as a
// braced body holding the same statement is, so the sibling arm alone decides what the
// arm-bearing form holds. Each braceless form is paired with its braced spelling: two
// spellings of one program must give one answer.
//
// The `if` form is here as a guard, not as a repaired case: `parse_if_expr` reaches a branch
// body only through `parse_block`, so an `if` branch is always a Block and always carried the
// Block rule already.

fn braceless_return_arm(n: Int) -> Int {
    let r = match n {
        0 => return 100
        _ => 2
    }
    r
}

fn braced_return_arm(n: Int) -> Int {
    let r = match n {
        0 => { return 100 }
        _ => 2
    }
    r
}

fn braceless_return_arm_mixed(n: Int) -> Int {
    let r = match n {
        0 => return 100
        1 => { 20 }
        _ => 2
    }
    r + 1
}

fn if_return_branch(c: Bool) -> Int {
    let r = if c { return 5 } else { 6 }
    r
}

// A call typed `Never` is a diverging arm body too, and braceless it is an ExprStmt rather
// than a control-transfer statement.
fn braceless_exit_arm(n: Int) -> Int {
    let r = match n {
        0 => env.exit(7)
        _ => 2
    }
    r
}

fn braced_exit_arm(n: Int) -> Int {
    let r = match n {
        0 => { env.exit(7) }
        _ => 2
    }
    r
}

fn braceless_continue_arm() -> Int {
    let mut total = 0
    let mut i = 0
    while i < 5 {
        i = i + 1
        let v = match i {
            2 => continue
            _ => 1
        }
        total = total + v
    }
    total
}

fn braced_continue_arm() -> Int {
    let mut total = 0
    let mut i = 0
    while i < 5 {
        i = i + 1
        let v = match i {
            2 => { continue }
            _ => 1
        }
        total = total + v
    }
    total
}

fn braceless_break_and_continue_arms() -> Int {
    let mut total = 0
    let mut i = 0
    while i < 4 {
        i = i + 1
        let v = match i {
            2 => continue
            3 => break
            _ => 10
        }
        total = total + v
    }
    total
}

test "a braceless returning arm keeps the sibling arm value" {
    assert_eq(braceless_return_arm(0), 100)
    assert_eq(braceless_return_arm(1), 2)
}

test "the braced spelling of a returning arm gives the same answers" {
    assert_eq(braced_return_arm(0), 100)
    assert_eq(braced_return_arm(1), 2)
}

test "a braceless returning arm keeps every sibling arm value" {
    assert_eq(braceless_return_arm_mixed(0), 100)
    assert_eq(braceless_return_arm_mixed(1), 21)
    assert_eq(braceless_return_arm_mixed(2), 3)
}

test "a returning if branch keeps the else branch value" {
    assert_eq(if_return_branch(true), 5)
    assert_eq(if_return_branch(false), 6)
}

test "a braceless arm whose call diverges keeps the sibling arm value" {
    assert_eq(braceless_exit_arm(1), 2)
    assert_eq(braced_exit_arm(1), 2)
}

test "a braceless continue arm keeps the sibling arm value" {
    assert_eq(braceless_continue_arm(), 4)
}

test "the braced spelling of a continue arm gives the same answer" {
    assert_eq(braced_continue_arm(), 4)
}

test "braceless break and continue arms keep the sibling arm value" {
    assert_eq(braceless_break_and_continue_arms(), 10)
}

fn braceless_return_arm_option_sibling(n: Int) -> Option[Int] {
    let r = match n {
        0 => return Some(100)
        _ => Some(2)
    }
    r
}

type Pair { a: Int, b: Int }

fn braceless_return_arm_struct_sibling(n: Int) -> Pair {
    let r = match n {
        0 => return Pair { a: 100, b: 0 }
        _ => Pair { a: 2, b: 3 }
    }
    r
}

fn braceless_return_arm_str_sibling(n: Int) -> Str {
    let r = match n {
        0 => return "hundred"
        _ => "two"
    }
    r
}

fn trailing_diverging_arm(n: Int) -> Int {
    let r = match n {
        0 => 42
        _ => return 100
    }
    r
}

fn every_arm_diverges(n: Int) -> Int {
    let _r = match n {
        0 => return 1
        _ => return 2
    }
    0
}

fn braceless_diverging_arm_in_tail_position(n: Int) -> Int {
    match n {
        0 => return 100
        _ => 2
    }
}

fn braceless_break_arm_in_for(n: Int) -> Int {
    let mut total = 0
    for i in 0..4 {
        let v = match i {
            2 => break
            _ => n
        }
        total = total + v
    }
    total
}

fn braceless_continue_arm_in_loop(n: Int) -> Int {
    let mut total = 0
    let mut i = 0
    loop {
        i = i + 1
        if i > 4 { break }
        let v = match i {
            2 => continue
            _ => n
        }
        total = total + v
    }
    total
}

test "a braceless returning arm keeps a carrier sibling value" {
    assert_eq(braceless_return_arm_option_sibling(1).unwrap(), 2)
    assert_eq(braceless_return_arm_option_sibling(0).unwrap(), 100)
}

test "a braceless returning arm keeps a struct sibling value" {
    assert_eq(braceless_return_arm_struct_sibling(1).a, 2)
    assert_eq(braceless_return_arm_struct_sibling(1).b, 3)
    assert_eq(braceless_return_arm_struct_sibling(0).a, 100)
}

test "a braceless returning arm keeps a string sibling value" {
    assert_eq(braceless_return_arm_str_sibling(1), "two")
    assert_eq(braceless_return_arm_str_sibling(0), "hundred")
}

test "a trailing braceless returning arm keeps the earlier arm value" {
    assert_eq(trailing_diverging_arm(0), 42)
    assert_eq(trailing_diverging_arm(1), 100)
}

test "a match whose every arm diverges still transfers control" {
    assert_eq(every_arm_diverges(0), 1)
    assert_eq(every_arm_diverges(1), 2)
}

test "a braceless returning arm keeps the sibling value in tail position" {
    assert_eq(braceless_diverging_arm_in_tail_position(0), 100)
    assert_eq(braceless_diverging_arm_in_tail_position(1), 2)
}

test "a braceless break arm keeps the sibling value in a for loop" {
    assert_eq(braceless_break_arm_in_for(5), 10)
}

test "a braceless continue arm keeps the sibling value in a loop" {
    assert_eq(braceless_continue_arm_in_loop(5), 15)
}
