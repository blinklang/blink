// A match arm body without braces is whatever `parse_stmt` returns, so it can be a loop, a
// binding or a control transfer — not only an expression. Codegen must reach the same emitter
// for that body as it reaches for the braced spelling that wraps the identical statement,
// otherwise the statement is dropped from the output with no diagnostic. Each braceless form
// is paired with its braced spelling: two spellings of one program must give one answer.

fn braceless_while_arm(n: Int) -> Int {
    let mut acc = 0
    match n {
        0 => while acc < 3 { acc = acc + 1 }
        _ => acc = 9
    }
    acc
}

fn braced_while_arm(n: Int) -> Int {
    let mut acc = 0
    match n {
        0 => { while acc < 3 { acc = acc + 1 } }
        _ => acc = 9
    }
    acc
}

fn braceless_for_arm(n: Int) -> Int {
    let mut acc = 0
    match n {
        0 => for _i in 0..3 { acc = acc + 1 }
        _ => acc = 9
    }
    acc
}

fn braced_for_arm(n: Int) -> Int {
    let mut acc = 0
    match n {
        0 => { for _i in 0..3 { acc = acc + 1 } }
        _ => acc = 9
    }
    acc
}

fn braceless_loop_arm(n: Int) -> Int {
    let mut acc = 0
    match n {
        0 => loop { acc = acc + 3  break }
        _ => acc = 9
    }
    acc
}

fn braced_loop_arm(n: Int) -> Int {
    let mut acc = 0
    match n {
        0 => { loop { acc = acc + 3  break } }
        _ => acc = 9
    }
    acc
}

fn seen_flag(v: Int) -> Int {
    seen = seen + v
    v
}

let mut seen = 0

fn braceless_let_arm(n: Int) -> Int {
    seen = 0
    match n {
        0 => let _z = seen_flag(5)
        _ => seen = 9
    }
    seen
}

fn braced_let_arm(n: Int) -> Int {
    seen = 0
    match n {
        0 => { let _z = seen_flag(5) }
        _ => seen = 9
    }
    seen
}

fn braceless_continue_arm_in_stmt_position() -> Int {
    let mut i = 0
    let mut hits = 0
    while i < 5 {
        i = i + 1
        match i {
            2 => continue
            _ => Some(i)
        }
        hits = hits + 1
    }
    hits
}

fn braced_continue_arm_in_stmt_position() -> Int {
    let mut i = 0
    let mut hits = 0
    while i < 5 {
        i = i + 1
        match i {
            2 => { continue }
            _ => Some(i)
        }
        hits = hits + 1
    }
    hits
}

test "a braceless while arm body runs its loop" {
    assert_eq(braceless_while_arm(0), 3)
    assert_eq(braced_while_arm(0), 3)
}

test "a braceless for arm body runs its loop" {
    assert_eq(braceless_for_arm(0), 3)
    assert_eq(braced_for_arm(0), 3)
}

test "a braceless loop arm body runs its loop" {
    assert_eq(braceless_loop_arm(0), 3)
    assert_eq(braced_loop_arm(0), 3)
}

test "a braceless let arm body evaluates its initializer" {
    assert_eq(braceless_let_arm(0), 5)
    assert_eq(braced_let_arm(0), 5)
}

test "a braceless continue arm compiles when a sibling arm holds a carrier" {
    assert_eq(braceless_continue_arm_in_stmt_position(), 4)
    assert_eq(braced_continue_arm_in_stmt_position(), 4)
}
