// Regression for bshj6h: a `with X as r1, Y as r2 { ... }` Closeable block
// inside a generic fn[M] emitted the __blink_cl_state_* cleanup-state typedefs
// after the monomorphized body that referenced them, so the TU failed to
// compile (`unknown type name __blink_cl_state_*`).
type R1 { x: Int }
type R2 { y: Int }
impl Closeable for R1 { fn close(_self) {} }
impl Closeable for R2 { fn close(_self) {} }

fn open1() -> R1 { R1 { x: 1 } }
fn open2() -> R2 { R2 { y: 2 } }

pub fn run[M](_initial: M) -> Int {
    let mut total = 0
    with open1() as r, open2() as s {
        total = r.x + s.y
    }
    total
}

type Model { count: Int }

test "with-as Closeable block inside a generic fn compiles and runs" {
    assert_eq(run(Model { count: 0 }), 3)
}
