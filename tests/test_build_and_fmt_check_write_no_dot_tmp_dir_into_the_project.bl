// A build and a `fmt --check` write nothing into a `.tmp` dir of the dir they run in. A shared
// scratch dir there is one any nested build may create, reap or wipe while another uses it.
// The program imports a sqlite-backed module, so the build compiles a native dependency, and
// that object must land under build/.

import compile_test_helpers
import std.process.{ProcessResult}

fn sh(cmd: Str) -> ProcessResult {
    process_run("sh", ["-c", cmd])
}

test "a build of a program with a native dependency and a fmt --check leave no .tmp dir" {
    let root = sh("pwd -P").out.trim()
    let blink = sh("readlink -f build/blink").out.trim()
    let dir = "{compile_test_helpers.scratch_root()}/_no_dot_tmp_{getpid()}"
    shell_exec("rm -rf {dir}")
    compile_test_helpers.seed_native_cache(root, dir)
    write_file("{dir}/main.bl", [
        #"import std.db_sqlite { sqlite_open, sqlite_handler }"#,
        #""#,
        #"fn main() {"#,
        #"    let handle = sqlite_open(":memory:")"#,
        #"    with sqlite_handler(handle) {"#,
        #"        db.exec("CREATE TABLE t (name TEXT)").unwrap()"#,
        #"        io.println("ok")"#,
        #"    }"#,
        #"}"#,
        #""#,
    ].join("\n"))
    let env_of = "env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE BLINK_CACHE_DIR={dir}/objcache"
    let built = sh("cd {dir} && {env_of} {blink} build main.bl -o out/app")
    let ran = sh("{dir}/out/app").out.trim()
    let fmt = sh("cd {dir} && {env_of} {blink} fmt --check main.bl")
    let fmt_all = sh("cd {dir} && {env_of} {blink} fmt --check")
    let has_tmp = file_exists("{dir}/.tmp")
    let objects = sh("ls {dir}/build/native-cache | grep -c '^sqlite3.*\\.o$'").out.trim()
    shell_exec("rm -rf {dir}")
    assert(built.exit_code == 0, "build failed: {built.out}{built.err_out}")
    assert_eq(ran, "ok")
    assert(fmt.exit_code == 0, "fmt --check of the file failed: {fmt.out}{fmt.err_out}")
    assert(fmt_all.exit_code == 0, "fmt --check of the dir failed: {fmt_all.out}{fmt_all.err_out}")
    assert_eq(has_tmp, 0)
    assert_eq(objects, "1")
}
