// Build and run flush the front end's warnings before the back end runs and flush again when it
// ends. The second flush prints only what was reported after the first, so a warning shows
// once, as it does for check, in both build shapes.

import std.process.{ProcessResult}

fn sh(cmd: Str) -> ProcessResult {
    process_run("sh", ["-c", cmd])
}

fn count(text: Str, part: Str) -> Int {
    text.split(part).len() - 1
}

test "build and run print an unused variable warning once" {
    let dir = sh("mktemp -d /tmp/blink_source_warning_once.XXXXXX").out.trim()
    write_file("{dir}/spare.bl", "fn main() \{\n    let spare = 1\n    io.println(\"hi\")\n}\n")
    let mut problems: List[Str] = []
    for shape in ["BLINK_PER_MODULE=0", "BLINK_PER_MODULE=1"] {
        for cmd in ["check", "build", "run"] {
            let r = sh("B=$(pwd)/build/blink; cd {dir} && env {shape} $B {cmd} spare.bl")
            let n = count(r.err_out, "warning[UnusedVariable]")
            if r.exit_code != 0 || n != 1 {
                problems.push("{shape} blink {cmd}: exit {r.exit_code}, {n} warnings:\n{r.err_out}")
            }
        }
    }
    let _ = sh("rm -rf {dir}")
    let found: List[Str] = problems.filter(fn(p) { p != "" })
    assert_eq(found.join("\n"), "")
}
