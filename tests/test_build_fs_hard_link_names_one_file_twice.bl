// A build puts the units it takes from a record into a new units directory by a hard link,
// which it makes in process. The link must name the same file, as ln made it, and must fail
// where ln failed, so the build falls back to a copy.

import build_fs
import std.fs.{FsErrorExt}

// A stat that fails for another reason than a missing entry counts as there.
fn path_exists(path: Str) -> Bool ! FS.Read {
    match fs.stat(path) {
        Ok(_) => true
        Err(e) => !e.not_found()
    }
}

let DIR = "build/build_fs_hard_link_probe"

test "hard_link gives a file a second name that shares its bytes" {
    process.run("sh", ["-c", "rm -rf {DIR} && mkdir -p {DIR}/from {DIR}/to"])?
    fs.write("{DIR}/from/a.c", "int a;\n").unwrap()
    assert(build_fs.hard_link("{DIR}/from/a.c", "{DIR}/to/a.c"), "hard_link failed")
    assert_eq(fs.read("{DIR}/to/a.c").unwrap(), "int a;\n")
    let links = process.run("sh", ["-c", "stat -c %h {DIR}/from/a.c 2>/dev/null || stat -f %l {DIR}/from/a.c"])?.out.trim()
    assert_eq(links, "2")
}

test "hard_link fails onto a name that exists and from a missing file" {
    process.run("sh", ["-c", "rm -rf {DIR} && mkdir -p {DIR}/from {DIR}/to"])?
    fs.write("{DIR}/from/a.c", "int a;\n").unwrap()
    fs.write("{DIR}/to/a.c", "old\n").unwrap()
    assert(!build_fs.hard_link("{DIR}/from/a.c", "{DIR}/to/a.c"), "hard_link onto an existing name gave true")
    assert_eq(fs.read("{DIR}/to/a.c").unwrap(), "old\n")
    assert(!build_fs.hard_link("{DIR}/from/none.c", "{DIR}/to/none.c"), "hard_link of a missing file gave true")
    assert(!path_exists("{DIR}/to/none.c"))
}
