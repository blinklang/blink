// A dev build rebuilds a std archive another compiler built. A compiler archive built
// against the replaced std archive must then be refused, not linked beside the new one:
// its bodies were compiled against the other archive.

import compile_test_helpers

fn sh(cmd: Str) -> Str {
    process.run("sh", ["-c", cmd]).unwrap().out.trim()
}

test "blink build refuses a compiler archive built against a std archive it rebuilt" {
    let root = sh("pwd -P")
    let blink = sh("readlink -f build/blink")
    let arc = sh("dirname \"$(readlink -f build/libblink_std.h)\"")
    let tree = "{compile_test_helpers.scratch_root()}/_compiler_archive_std_{getpid()}"
    process.run("sh", ["-c", "rm -rf {tree}"])?
    process.run("sh", ["-c", "mkdir -p {tree}/build"])?
    // A copy, not a link: the install root comes from realpath(argv[0]).
    process.run("sh", ["-c", "cp {blink} {tree}/build/blink"])?
    process.run("sh", ["-c", "ln -s {root}/lib {tree}/lib"])?
    process.run("sh", ["-c", "ln -s {root}/lib {tree}/build/lib"])?
    process.run("sh", ["-c", "ln -s {root}/src {tree}/src"])?
    process.run("sh", ["-c", "cp -L {root}/blink.toml {tree}/blink.toml"])?
    process.run("sh", ["-c", "cp -L {root}/build/runtime.h {tree}/build/runtime.h"])?
    process.run("sh", ["-c", "cp -L {arc}/libblink_std.a {arc}/libblink_std.h {arc}/skip_modules.txt {arc}/.archive-id {tree}/build/"])?
    let carch = "{tree}/carch"
    let cr = process.run("sh", ["-c", "cd {tree} && env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE build/blink __build-compiler-archive {carch} tokens 2>&1"])?
    assert(cr.success(), "compiler archive did not build: {cr.out}")

    // Another compiler's std archive takes the tree, and the compiler archive was built
    // against it.
    let ones = "1111111111111111111111111111111111111111111111111111111111111111"
    process.run("sh", ["-c", "cut -d'|' -f1,2 {arc}/.archive-id | sed 's/$/|{ones}|other/' > {tree}/stale.id"])?
    process.run("sh", ["-c", "rm -f {tree}/build/.archive-id && cp {tree}/stale.id {tree}/build/.archive-id && cp {tree}/stale.id {carch}/std-archive-id"])?
    fs.write("{tree}/user.bl", "import tokens\n\nfn main() \{\n    io.println(tokens.token_kind_name(tokens.keyword_lookup(\"fn\")))\n\}\n").unwrap()

    let r = process.run("sh", ["-c", "cd {tree} && env -u BLINK_ROOT BLINK_CACHE_DIR= BLINK_COMPILER_ARCHIVE={carch} build/blink build user.bl -o {tree}/user 2>&1"])?
    assert(!r.success(), "build linked a compiler archive built against another std archive: {r.out}")
    assert(r.out.contains("built against another stdlib archive"), "unexpected failure: {r.out}")
    assert(!compile_test_helpers.path_exists("{tree}/user"))
    process.run("sh", ["-c", "rm -rf {tree}"])?
}
