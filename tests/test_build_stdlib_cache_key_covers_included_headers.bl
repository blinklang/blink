// The stdlib archive is cached under a key hashed from what built it. The runtime header the
// build reads can be a file of includes only, so an edit to a header it includes changes the
// archive as much as an edit to the header itself does, and must change the key too. A key
// that missed it would link a new program against an archive built for the old runtime.

import std_cache_key.{compute_cache_key}

let DIR = "build/std_cache_key_probe"

fn write_runtime(part: Str) ! FS.Write {
    fs.write("{DIR}/runtime.h", "#include \"runtime_part.h\"\n").unwrap()
    fs.write("{DIR}/runtime_part.h", part).unwrap()
}

fn key() -> Str ! IO, FS.Read {
    compute_cache_key("{DIR}/compiler", DIR, "{DIR}/runtime.h", "manifest\n")
}

test "an edit to a header the runtime header includes changes the cache key" {
    process.run("sh", ["-c", "rm -rf {DIR} && mkdir -p {DIR}"])?
    fs.write("{DIR}/compiler", "compiler\n").unwrap()
    write_runtime("int blink_part(void);\n")
    let before = key()
    write_runtime("int blink_part(void* ud);\n")
    let after = key()
    process.run("sh", ["-c", "rm -rf {DIR}"])?
    assert(before != "")
    assert(before != after)
}

test "the cache key is stable while no header changes" {
    process.run("sh", ["-c", "rm -rf {DIR}_same && mkdir -p {DIR}_same"])?
    fs.write("{DIR}_same/compiler", "compiler\n").unwrap()
    fs.write("{DIR}_same/runtime.h", "#include \"runtime_part.h\"\n").unwrap()
    fs.write("{DIR}_same/runtime_part.h", "int blink_part(void);\n").unwrap()
    let a = compute_cache_key("{DIR}_same/compiler", "{DIR}_same", "{DIR}_same/runtime.h", "manifest\n")
    let b = compute_cache_key("{DIR}_same/compiler", "{DIR}_same", "{DIR}_same/runtime.h", "manifest\n")
    process.run("sh", ["-c", "rm -rf {DIR}_same"])?
    assert(a != "")
    assert_eq(a, b)
}
