// The stdlib archive is cached under a key hashed from what built it. The runtime header the
// build reads can be a file of includes only, so an edit to a header it includes changes the
// archive as much as an edit to the header itself does, and must change the key too. A key
// that missed it would link a new program against an archive built for the old runtime.

import std_cache_key.{compute_cache_key}

let DIR = "build/std_cache_key_probe"

fn write_runtime(part: Str) {
    write_file("{DIR}/runtime.h", "#include \"runtime_part.h\"\n")
    write_file("{DIR}/runtime_part.h", part)
}

fn key() -> Str {
    compute_cache_key("", DIR, "{DIR}/runtime.h", "manifest\n")
}

test "an edit to a header the runtime header includes changes the cache key" {
    shell_exec("rm -rf {DIR} && mkdir -p {DIR}")
    write_runtime("int blink_part(void);\n")
    let before = key()
    write_runtime("int blink_part(void* ud);\n")
    let after = key()
    shell_exec("rm -rf {DIR}")
    assert(before != "")
    assert(before != after)
}

test "the cache key is stable while no header changes" {
    shell_exec("rm -rf {DIR}_same && mkdir -p {DIR}_same")
    write_file("{DIR}_same/runtime.h", "#include \"runtime_part.h\"\n")
    write_file("{DIR}_same/runtime_part.h", "int blink_part(void);\n")
    let a = compute_cache_key("", "{DIR}_same", "{DIR}_same/runtime.h", "manifest\n")
    let b = compute_cache_key("", "{DIR}_same", "{DIR}_same/runtime.h", "manifest\n")
    shell_exec("rm -rf {DIR}_same")
    assert(a != "")
    assert_eq(a, b)
}
