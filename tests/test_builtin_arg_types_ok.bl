import compile_test_helpers

test "List.contains int literal carve-out" {
    let src = "fn main() \{ let l = [1, 2, 3]\n let _ = l.contains(2)\n \}\n"
    compile_test_helpers.expect_no_error(src, "ok_list_contains", "E0300")
}

test "List.get/slice Int args" {
    let src = "fn main() \{ let l = [1, 2, 3]\n let _ = l.get(0)\n let _ = l.slice(0, 1)\n \}\n"
    compile_test_helpers.expect_no_error(src, "ok_list_get_slice", "E0300")
}

test "Str.contains/starts_with/split Str args" {
    let src = "fn main() \{ let _ = \"hi\".contains(\"h\")\n let _ = \"hi\".starts_with(\"h\")\n let _ = \"a,b\".split(\",\")\n \}\n"
    compile_test_helpers.expect_no_error(src, "ok_str_methods", "E0300")
}

test "Str.substring/byte_at Int args" {
    let src = "fn main() \{ let _ = \"hi\".substring(0, 1)\n let _ = \"hi\".byte_at(0)\n \}\n"
    compile_test_helpers.expect_no_error(src, "ok_str_int_args", "E0300")
}

test "Map.get/insert correct key/value types" {
    let src = "fn main() \{ let mut m: Map[Str, Int] = Map()\n let _ = m.get(\"a\")\n m.insert(\"a\", 1)\n \}\n"
    compile_test_helpers.expect_no_error(src, "ok_map_methods", "E0300")
}

test "Set.contains/insert Str args" {
    let src = "fn main() \{ let mut s: Set[Str] = Set()\n let _ = s.contains(\"a\")\n s.insert(\"a\")\n \}\n"
    compile_test_helpers.expect_no_error(src, "ok_set_methods", "E0300")
}

test "typed-empty List Unknown-element guard" {
    let src = "fn main() \{ let l: List[Int] = []\n let _ = l.contains(1)\n \}\n"
    compile_test_helpers.expect_no_error(src, "ok_list_typed_empty", "E0300")
}
