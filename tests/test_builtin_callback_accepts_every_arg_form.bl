// The right programs the callback check must let through, and the values they compute. Each
// case runs, so a false error or a wrong instance shows here.

import test_fn_named_as_value_helper

type CbHolder { cb: fn(Int) -> Int }
type CbAge = Int

trait CbBump { fn bump(self) -> Int }
impl CbBump for Int { fn bump(self) -> Int { self + 1 } }

fn cb_double(x: Int) -> Int { x * 2 }
fn cb_alias(x: CbAge) -> CbAge { x + 1 }
fn cb_pos(x: Int) -> Bool { x > 0 }
fn cb_add(a: Int, x: Int) -> Int { a + x }
fn cb_rep(x: Int) -> List[Int] { [x, x] }
fn cb_iter(x: Int) -> Iterator[Int] { [x, x].into_iter() }
fn cb_cmp_desc(a: Int, b: Int) -> Ordering { b.cmp(a) }
fn cb_identity[T](x: T) -> T { x }
fn cb_bumped[T: CbBump](x: T) -> Int { x.bump() }
fn cb_consume(x: Int) { let _ = x }
fn cb_push(acc: List[Int], x: Int) -> List[Int] { acc.append([x]) }
fn cb_same[T](a: T, b: T) -> T {
    let _ = b
    a
}
fn cb_on_param(xs: List[Int], f: fn(Int) -> Int) -> List[Int] { xs.map(f) }
fn cb_generic_identity[T](xs: List[T]) -> List[T] { xs.map(cb_identity) }
fn cb_bound_held[T: CbBump](xs: List[T]) -> List[Int] { xs.map(cb_bumped) }

test "a named fn" {
    assert_eq([1, 2].map(cb_double), [2, 4])
    assert_eq([1, -2].filter(cb_pos), [1])
    assert_eq([1, 2].flat_map(cb_rep), [1, 1, 2, 2])
    assert_eq([1, 2].fold(0, cb_add), 3)
    assert([1, 2].any(cb_pos))
    assert([1, 2].all(cb_pos))
    assert_eq([1, 2].find(cb_pos), Some(1))
    assert_eq([1, 2].sort_by(cb_cmp_desc), [2, 1])
}

test "an alias of the element type is the element type" {
    assert_eq([1].map(cb_alias), [2])
}

test "a generic fn takes its instance from the element" {
    let ys = [1, 2].map(cb_identity)
    assert_eq(ys.len(), 2)
    assert_eq([1, 2].map(cb_identity).len(), 2)
    assert_eq(["a"].map(cb_identity), ["a"])
    assert_eq([1, 2].map(cb_bumped), [2, 3])
    assert_eq([1, 2].fold(0, cb_same), 0)
}

test "a fn-typed local, parameter and field" {
    let f = cb_double
    assert_eq([1].map(f), [2])
    let g = fn(x: Int) -> Int { x + 5 }
    assert_eq([1].map(g), [6])
    assert_eq(cb_on_param([3], cb_double), [6])
    let h = CbHolder { cb: cb_double }
    assert_eq([4].map(h.cb), [8])
}

test "the value of an if" {
    let flag = [1].len() == 1
    assert_eq([1].map(if flag { cb_double } else { cb_identity }), [2])
}

test "a keyword argument" {
    assert_eq([1].map(f: cb_double), [2])
}

test "a qualified fn" {
    assert_eq([1].map(test_fn_named_as_value_helper.fnv_triple), [3])
    assert_eq([1].map(test_fn_named_as_value_helper.fnv_same), [1])
}

test "an empty receiver takes its element from the callback" {
    let ys = [].map(cb_double)
    assert_eq(ys.len(), 0)
    let mut xs = []
    let zs = xs.map(cb_double)
    xs.push(1)
    assert_eq(zs.len(), 0)
}

test "fold's accumulator can take its type from the callback" {
    assert_eq([1, 2].fold([], cb_push), [1, 2])
}

test "a typevar receiver" {
    assert_eq(cb_generic_identity([1, 2]), [1, 2])
    assert_eq(cb_generic_identity(["s"]), ["s"])
    assert_eq(cb_bound_held([1]), [2])
}

test "Iterator flat_map takes a step that returns an Iterator" {
    assert_eq([1].into_iter().flat_map(cb_iter).collect(), [1, 1])
}

test "Iterator methods" {
    let it = [1, 2].into_iter()
    assert_eq(it.map(cb_double).collect(), [2, 4])
    assert_eq([1, -2].into_iter().filter(cb_pos).collect(), [1])
    assert_eq([1, 2].into_iter().fold(0, cb_add), 3)
    assert_eq([1, 2].into_iter().map(cb_identity).collect(), [1, 2])
    assert([1].into_iter().any(cb_pos))
    [1].into_iter().for_each(cb_consume)
}

test "for_each with a fn that returns nothing" {
    [1].for_each(cb_consume)
}

test "a closure whose body answers to the signature" {
    assert_eq([1, 2].filter(fn(x) { return x > 1 }), [2])
    assert_eq([1, 2].filter(fn(x) {
        if x > 1 { return true }
        false
    }), [2])
    assert_eq([1, 2].fold(0, fn(a, x) { a + x }), 3)
    assert_eq([1, 2].fold([0], fn(a, x) { a.append([x]) }), [0, 1, 2])
    assert_eq([1, 2].sort_by(fn(a, b) { b.cmp(a) }), [2, 1])
    assert_eq([1, 2].flat_map(fn(x) { [x, x] }), [1, 1, 2, 2])
    assert_eq([1, 2].into_iter().flat_map(fn(x) { [x].into_iter() }).collect(), [1, 2])
    assert([1].into_iter().any(fn(x) { x == 1 }))
    assert_eq([1].into_iter().find(fn(x) { x == 1 }), Some(1))
    assert_eq([1, 2].into_iter().fold(0, fn(a, x) { a + x }), 3)
}

test "a closure given as a keyword argument" {
    assert_eq([1, 2].map(f: fn(x) { "{x}" }), ["1", "2"])
    assert_eq([1, 2].fold(0, f: fn(a, x) { a + x }), 3)
}

test "a closure's dropped tail under for_each" {
    let mut n = 0
    [1, 2].for_each(fn(x) {
        n = n + x
        x
    })
    assert_eq(n, 3)
}

test "a closure that never completes fits every return" {
    let empty: List[Int] = []
    assert_eq(empty.filter(fn(x) { panic("{x}") }), empty)
    assert_eq(empty.fold(0, fn(a, x) { panic("{a}{x}") }), 0)
    let ys: List[Int] = empty.flat_map(fn(x) { panic("{x}") })
    assert_eq(ys, empty)
}

test "with_ptr takes its closure through a keyword" {
    let b = Bytes.from_str("ab")
    let n: Int = b.with_ptr(f: fn(p) { 1 })
    assert_eq(n, 1)
}
