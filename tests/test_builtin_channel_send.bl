// Channel.send is one of the builtin-receiver "cg_call methods: X is not built" ICEs
// still open in the tid-native codegen rewrite. Channel.recv() and Channel.close() as
// direct method calls are ALSO unbuilt (only the for-in-drained reader lowers today), so
// these tests send into a buffered channel first, then drain with a for-in loop that
// breaks once it has read back everything it sent -- recv never blocks because every
// value it asks for is already buffered before the loop starts.

test "Channel.send delivers a value a for-in read reads back" {
    let ch: Channel[Int] = Channel(4)
    ch.send(42)
    let mut got: List[Int] = []
    for x in ch {
        got.push(x)
        if got.len() == 1 { break }
    }
    assert_eq(got.get(0).unwrap(), 42)
}

test "Channel.send preserves order across two sends" {
    let ch: Channel[Int] = Channel(4)
    ch.send(1)
    ch.send(2)
    let mut got: List[Int] = []
    for x in ch {
        got.push(x)
        if got.len() == 2 { break }
    }
    assert_eq(got.get(0).unwrap(), 1)
    assert_eq(got.get(1).unwrap(), 2)
}
