// Enum.to_str is a builtin-receiver "cg_call methods: X is not built" ICE still open in
// the tid-native codegen rewrite. Enum.display/debug are a separate ticket and untouched
// here. A PLAIN (non-str-backed) enum's .to_str() is left out of these tests: typecheck
// never stamps a return type for that shape (a separately tracked bug), so it never
// reaches this codegen path at all -- only str-backed enums do.

type Level { Low = "low", High = "high" }

test "a str-backed enum's to_str answers its assigned string" {
    let l = Level.Low
    assert_eq(l.to_str(), "low")
    assert_eq(Level.High.to_str(), "high")
}
