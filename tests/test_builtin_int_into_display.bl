// Int.into / Int.display are builtin-receiver "cg_call methods: X is not built" ICEs
// still open in the tid-native codegen rewrite. `.into()` is target-directed, so each
// case here annotates the binding it flows into.

import compile_test_helpers

test "Int.into converts to Float" {
    let i: Int = 5
    let f: Float = i.into()
    assert_eq(f, 5.0)
}

// Int to U8 narrows, so it is TryFrom and not From (section 3c.3); into() refuses it.
test "Int.into converts to a sized int" {
    let src = "fn main() \{\n    let i: Int = 200\n    let b: U8 = i.into()\n    io.println(\"\{b}\")\n}\n"
    compile_test_helpers.expect_compile_error(src, "int_into_u8", "E0312")
}

test "Int.display renders the decimal text" {
    let i: Int = 42
    assert_eq(i.display(), "42")
    let neg: Int = -7
    assert_eq(neg.display(), "-7")
}
