// List.count / List.chain / List.take are builtin-receiver "cg_call methods: X is not
// built" ICEs still open in the tid-native codegen rewrite.

test "List.count answers the same as len" {
    let l = [1, 2, 3]
    assert_eq(l.count(), 3)
    let e: List[Int] = []
    assert_eq(e.count(), 0)
}

test "List.chain appends a second list without mutating either" {
    let a = [1, 2]
    let b = [3, 4]
    let c = a.chain(b)
    assert_eq(c.len(), 4)
    assert_eq(c.get(0).unwrap(), 1)
    assert_eq(c.get(3).unwrap(), 4)
    assert_eq(a.len(), 2)
    assert_eq(b.len(), 2)
}

test "List.take keeps only the first n elements" {
    let l = [1, 2, 3, 4, 5]
    let t = l.take(3)
    assert_eq(t.len(), 3)
    assert_eq(t.get(0).unwrap(), 1)
    assert_eq(t.get(2).unwrap(), 3)
    assert_eq(l.len(), 5)
}

test "List.take of 0 is empty" {
    let l = [1, 2, 3]
    assert_eq(l.take(0).len(), 0)
}
