// m533yk: built-in Str/SB/Bytes methods must lower to direct runtime calls
// (no stdlib trait import required). This test exercises the full method
// surface so the codegen intrinsics are verified end-to-end.

test "str len + is_empty" {
    assert_eq("hello".len(), 5)
    assert_eq("".len(), 0)
    assert("".is_empty())
    assert("x".is_empty() == false)
}

test "str char_at + byte_at" {
    assert_eq("abc".byte_at(0), 97)
    assert_eq("abc".byte_at(2), 99)
    let opt = "abc".char_at(1)
    assert(opt.is_some())
}

test "str contains/starts_with/ends_with/index_of" {
    assert("hello world".contains("world"))
    assert(("hello".contains("xyz")) == false)
    assert("hello".starts_with("hel"))
    assert("hello".ends_with("llo"))
    assert_eq("hello world".index_of("world"), 6)
    assert_eq("hello".index_of("xyz"), -1)
}

test "str substring/slice/concat" {
    assert_eq("hello".substring(0, 3), "hel")
    assert_eq("hello".substr(1, 3), "ell")
    assert_eq("hello".slice(1, 4), "ell")
    assert_eq("foo".concat("bar"), "foobar")
}

test "str split/lines" {
    let parts = "a,b,c".split(",")
    assert_eq(parts.len(), 3)
    assert_eq(parts.get(1).unwrap(), "b")

    let ls = "x\ny\nz".lines()
    assert_eq(ls.len(), 3)
    assert_eq(ls.get(2).unwrap(), "z")
}

test "str to_upper/to_lower" {
    assert_eq("Hello".to_upper(), "HELLO")
    assert_eq("Hello".to_lower(), "hello")
}

test "str trim variants" {
    assert_eq("  hi  ".trim(), "hi")
    assert_eq("  hi  ".trim_left(), "hi  ")
    assert_eq("  hi  ".trim_right(), "  hi")
}

test "str replace" {
    assert_eq("foo bar foo".replace("foo", "qux"), "qux bar qux")
    assert_eq("hello".replace("xyz", "abc"), "hello")
}

test "str parse_int/parse_float/to_int" {
    assert_eq("42".parse_int(), 42)
    assert_eq("-7".parse_int(), -7)
    assert_eq("9".to_int(), 9)
    let f = "3.14".parse_float()
    assert(f > 3.13)
    assert(f < 3.15)
}

test "sb basic" {
    let sb = StringBuilder.new()
    sb.write("hello")
    sb.write(" ")
    sb.write("world")
    assert_eq(sb.to_str(), "hello world")
    assert_eq(sb.len(), 11)
    assert(sb.is_empty() == false)
}

test "sb capacity/clear" {
    let sb = StringBuilder.new()
    sb.write("abc")
    let cap = sb.capacity()
    assert(cap >= 3)
    sb.clear()
    assert(sb.is_empty())
    assert_eq(sb.len(), 0)
}

test "sb write_char" {
    let sb = StringBuilder.new()
    sb.write("X")
    sb.write_char("Y")
    assert_eq(sb.to_str(), "XY")
}

test "bytes len/is_empty/push/get" {
    let b = Bytes.new()
    assert(b.is_empty())
    assert_eq(b.len(), 0)
    b.push(65)
    b.push(66)
    assert_eq(b.len(), 2)
    assert_eq(b.get(0).unwrap(), 65)
    assert_eq(b.get(1).unwrap(), 66)
    assert(b.is_empty() == false)
}

test "bytes set/slice/concat" {
    let b = Bytes.new()
    b.push(1)
    b.push(2)
    b.push(3)
    b.set(1, 99)
    assert_eq(b.get(1).unwrap(), 99)
    let s = b.slice(0, 2)
    assert_eq(s.len(), 2)
    let c = b.concat(s)
    assert_eq(c.len(), 5)
}

test "bytes to_hex" {
    let b = Bytes.new()
    b.push(222)
    b.push(173)
    assert_eq(b.to_hex(), "dead")
}

test "bytes int reads big-endian" {
    let b = Bytes.new()
    b.push(18)
    b.push(52)
    b.push(86)
    b.push(120)
    assert_eq(b.read_u16_be(0).unwrap(), 4660)
    assert_eq(b.read_u32_be(0).unwrap(), 305419896)
    assert_eq(b.read_i32_be(0).unwrap(), 305419896)
}

test "bytes int writes big-endian append" {
    let w = Bytes.new()
    w.write_u16_be(43981)
    assert_eq(w.len(), 2)
    assert_eq(w.get(0).unwrap(), 171)
    assert_eq(w.get(1).unwrap(), 205)
}

test "bytes int reads little-endian" {
    let b = Bytes.new()
    b.push(120)
    b.push(86)
    b.push(52)
    b.push(18)
    assert_eq(b.read_u16_le(0).unwrap(), 22136)
    assert_eq(b.read_u32_le(0).unwrap(), 305419896)
    assert_eq(b.read_i32_le(0).unwrap(), 305419896)
}

test "bytes int writes little-endian append" {
    let w = Bytes.new()
    w.write_u16_le(43981)
    assert_eq(w.len(), 2)
    assert_eq(w.get(0).unwrap(), 205)
    assert_eq(w.get(1).unwrap(), 171)
}
