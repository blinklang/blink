import std.path
import compile_test_helpers

// Test that methods resolve correctly on built-in function return values

fn main() ! IO, Process.Spawn, Env.Read, FS.Read, FS.Write {
    // fs.read(..).unwrap() returns Str — string methods should work
    fs.write("{compile_test_helpers.scratch_root()}/_test_bm.txt", "  hello world  ").unwrap()
    let content = fs.read("{compile_test_helpers.scratch_root()}/_test_bm.txt").unwrap()
    let trimmed = content.trim()
    assert_eq(trimmed, "hello world")

    let has = content.contains("hello")
    assert(has)

    let parts = content.trim().split(" ")
    assert_eq(parts.len(), 2)

    // path_join returns Str
    let p = path.path_join("a", "b")
    assert(p.contains("b"))

    // path_dirname returns Str
    let d = path.path_dirname("/a/b/c")
    assert(d.len() > 0)

    // path_basename returns Str
    let b = path.path_basename("/a/b/c.txt")
    assert_eq(b, "c.txt")

    // env.args() elements are Str
    let a = env.args().get(0).unwrap()
    assert(a.len() > 0)

    // env.var returns Option[Str] — unwrap then method
    let home = env.var("HOME") ?? "/tmp"
    assert(home.len() > 0)

    process.run("sh", ["-c", "rm -f {compile_test_helpers.scratch_root()}/_test_bm.txt"]).unwrap()
    io.println("PASS: all builtin method tests")
}
