// Ptr.addr / Ptr.to_str are builtin-receiver "cg_call methods: X is not built" ICEs
// still open in the tid-native codegen rewrite. Str.as_cstr() -> Ptr[U8] already lowers,
// so it is used here to produce a non-null Ptr[U8] to round-trip through.

test "Ptr.addr answers a non-zero integer address for a live pointer" {
    let s = "hello"
    let p = s.as_cstr()
    assert(p.addr() != 0)
}

test "Ptr.to_str round-trips a Str through as_cstr" {
    let s = "hello"
    let p = s.as_cstr()
    match p.to_str() {
        Some(r) => assert_eq(r, "hello")
        None => assert(false)
    }
}
