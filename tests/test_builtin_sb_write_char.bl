// StringBuilder.write_char is a builtin-receiver "cg_call methods: X is not built" ICE
// still open in the tid-native codegen rewrite.

test "StringBuilder.write_char appends one char" {
    let mut sb = StringBuilder.new()
    sb.write("ab")
    sb.write_char('c')
    assert_eq(sb.to_str(), "abc")
}

test "StringBuilder.write_char on an empty builder" {
    let mut sb = StringBuilder.new()
    sb.write_char('z')
    assert_eq(sb.to_str(), "z")
}
