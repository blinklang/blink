// The built-in types implement Clone, Debug, Hash and Eq by the tables in sections/03_types.md
// (*Clone Semantics*, *Built-in Trait Implementations*). Each method answers on a value of the
// type itself and through a bound on a type parameter, with the same result.

fn bv_dup[T: Clone](x: T) -> T {
    x.clone()
}

fn bv_show[T: Debug](x: T) -> Str {
    x.debug()
}

fn bv_key[T: Hash](x: T) -> U64 {
    x.hash()
}

fn bv_same[T: Eq](a: T, b: T) -> Bool {
    a.eq(b)
}

test "the clone of a value type is the value" {
    let small: U8 = 3
    assert_eq(7.clone(), 7)
    assert_eq(1.5.clone(), 1.5)
    assert_eq(true.clone(), true)
    assert_eq('c'.clone(), 'c')
    assert_eq("text".clone(), "text")
    assert_eq(small.clone(), small)
    assert_eq(bv_dup(7), 7)
    assert_eq(bv_dup("text"), "text")
    assert_eq(bv_dup(small), small)
}

test "the clone of a tuple or an option of value types is the value" {
    let pair = (1, "a").clone()
    assert_eq(pair.0, 1)
    assert_eq(pair.1, "a")
    assert_eq(bv_dup((2, 'b')).1, 'b')
    assert_eq(Some(4).clone(), Some(4))
    assert_eq(bv_dup(Some("s")), Some("s"))
}

test "the clone of a list shares the list" {
    let mut a = [1, 2]
    let b = a.clone()
    a.push(3)
    assert_eq(b.len(), 3)
    let mut c = [5]
    let d = bv_dup(c)
    c.push(6)
    assert_eq(d.len(), 2)
}

test "the debug text of a scalar" {
    let small: U8 = 3
    assert_eq(7.debug(), "7")
    assert_eq(1.5.debug(), "1.5")
    assert_eq(true.debug(), "true")
    assert_eq('c'.debug(), "'c'")
    assert_eq("a\"b".debug(), "\"a\\\"b\"")
    assert_eq(small.debug(), "3")
    assert_eq(bv_show(7), "7")
    assert_eq(bv_show("s"), "\"s\"")
    assert_eq(bv_show(false), "false")
}

test "the debug text of a container" {
    assert_eq([1, 2].debug(), "[1, 2]")
    assert_eq(["a"].debug(), "[\"a\"]")
    assert_eq(Some(3).debug(), "Some(3)")
    let none: Option[Int] = None
    assert_eq(none.debug(), "None")
    let mut m: Map[Str, Int] = Map()
    m.insert("k", 1)
    assert_eq(m.debug(), "\{\"k\": 1}")
    assert_eq(bv_show([[1], [2, 3]]), "[[1], [2, 3]]")
    assert_eq(bv_show(Some("x")), "Some(\"x\")")
}

test "the hash of a value is the same through a bound" {
    let small: U8 = 3
    assert_eq(7.hash(), bv_key(7))
    assert_eq("ab".hash(), bv_key("ab"))
    assert_eq('c'.hash(), bv_key('c'))
    assert_eq(true.hash(), bv_key(true))
    assert_eq(small.hash(), bv_key(small))
    assert("ab".hash() != "ba".hash())
}

test "the equality of a built-in value" {
    assert([1, 2].eq([1, 2]))
    assert(![1, 2].eq([1, 3]))
    assert(Some(1).eq(Some(1)))
    assert(!Some(1).eq(None))
    assert((1, "a").eq((1, "a")))
    assert(!(1, "a").eq((1, "b")))
    let ok: Result[Int, Str] = Ok(1)
    assert(ok.eq(Ok(1)))
    assert(bv_same([1], [1]))
    assert(!bv_same(Some("a"), Some("b")))
    assert(bv_same((1, 2), (1, 2)))
}
