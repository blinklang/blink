// br bvh7qt — a transparent `type Port = Int` must resolve to Int at EVERY position
// it appears, including nested child slots of the tid tree. resolve_type_parts peeled
// only the outermost name, so `Map[Port, Int]` kept `Port` in its key slot while the
// annotation/param path lowered it to Int — two spellings of one type.
//
// A compound carrier over the alias-keyed map exposes it: a fn returning
// `Option[Map[Port, Int]]` / `Result[Map[Port, Int], Str]` emitted
// `void _mkey = (void)(80);` — the alias in the key slot erased the insert-key temp to
// void, a cc error. The shape must be the sole user of `Map[Port, Int]`: an annotated
// `let mut m: Map[Port, Int]` elsewhere primes the mono key-type and masks the bug (the
// annotated-let/Set canonical behavior is guarded by test_f8t5wb row 17). Keep this file
// carrier-only.
//
// Scope: this covers a SINGLE-LEVEL alias to a builtin (`type Port = Int`). A multi-level
// chain (`type Kelvin = Temp = Int`) or a struct-typed alias (`type Coord = Point`) as a
// Map key inside a carrier still miscompiles at a downstream codegen carrier-mono site the
// leaf peel does not reach — tracked separately.

type Port = Int

fn find_ports(n: Int) -> Option[Map[Port, Int]] {
    if n > 0 {
        let mut m: Map[Port, Int] = Map()
        m.insert(80, n)
        Some(m)
    } else {
        None
    }
}

fn load_ports(n: Int) -> Result[Map[Port, Int], Str] {
    if n > 0 {
        let mut m: Map[Port, Int] = Map()
        m.insert(443, n)
        Ok(m)
    } else {
        Err("empty")
    }
}

test "alias-keyed map inside an Option carrier round-trips" {
    let r = find_ports(5)
    assert(r.is_some())
    assert_eq(r.unwrap().get(80) ?? -1, 5)
}

test "alias-keyed map inside a Result carrier round-trips" {
    let r = load_ports(7)
    assert_eq(r.unwrap().get(443) ?? -1, 7)
}
