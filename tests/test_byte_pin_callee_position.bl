import compile_test_helpers

// A Bytes.with_ptr whose result is immediately called, so the with_ptr sits in
// the CALLEE position of an outer Call node. The byte-pin walker must descend a
// Call through its callee (node_left), not the MethodCall-receiver field
// (node_obj); descending the wrong field missed a pin in callee position.
fn fixture_callee_pin() -> Str {
    #"@ffi("c", "do_io")
fn c_io(p: Ptr[U8], n: U64) -> I64

fn run(data: Bytes) -> Int {
    data.with_ptr(fn(p) -> fn(Int) -> Int {
        let _ = c_io(p, data.len().to_u64())
        fn(x: Int) -> Int { x + 1 }
    })(3)
}

fn main() {
    let _ = run(Bytes.zeroed(4))
}
"#
}

test "audit --ffi descends a Call callee to find a with_ptr in callee position" {
    let out = compile_test_helpers.audit_ffi_via_cli(fixture_callee_pin(), "byte_pin_callee", 1)
    assert(out.contains("byte-pin"))
    // The with_ptr call is on line 5 of the fixture; before the fix the byte-pin
    // list was empty because the Call arm descended node_obj instead of node_left.
    assert(out.contains("\"line\":5"))
    assert(out.contains("\"byte_pin\":1"))
}
