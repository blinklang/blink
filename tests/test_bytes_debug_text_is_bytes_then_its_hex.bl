// The debug text of a Bytes value is "Bytes(" + b.to_hex() + ")": lower-case hex, two digits
// per byte, no separator, and `Bytes()` when empty (sections/03_types.md §3.6.1 *Container
// Debug Rendering*, the Bytes row). The text is the same on every path: `.debug()`, a derived
// field, an element or payload of a container, a Debug bound, and the panic text of `unwrap`
// and `unwrap_err`. `debug()` never cuts its text, and it agrees with `Eq`.

@derive(Debug)
type BdWrap { b: Bytes }

type BdAlias = Bytes

@derive(Debug)
type BdAliased { b: BdAlias }

@derive(Debug)
type BdHolder { list: List[Bytes], opt: Option[Bytes], map: Map[Str, Option[Bytes]] }

@derive(Debug)
type BdPacket {
    Empty
    Data(payload: Bytes)
}

@derive(Debug)
type BdNested { inner: BdWrap, tag: Int }

@derive(Debug)
type BdBox[T] { v: T }

fn bd_bytes(xs: List[Int]) -> Bytes {
    let mut b = Bytes.new()
    for x in xs { b.push(x) }
    b
}

fn bd_show[T: Debug](x: T) -> Str {
    x.debug()
}

fn bd_err() -> Result[Int, Bytes] {
    Err(Bytes.from_str("hi"))
}

fn bd_ok() -> Result[Bytes, Int] {
    Ok(bd_bytes([0, 255, 10]))
}

test "the debug text of a Bytes is Bytes then its hex digits" {
    assert_eq(Bytes.new().debug(), "Bytes()")
    assert_eq(Bytes.from_str("hi").debug(), "Bytes(6869)")
    assert_eq(bd_bytes([0, 255, 10]).debug(), "Bytes(00ff0a)")
    assert_eq(bd_bytes([171, 205, 239]).debug(), "Bytes(abcdef)")
}

test "a NUL byte and a byte that is not UTF-8 have a text" {
    assert_eq(bd_bytes([0]).debug(), "Bytes(00)")
    assert_eq(bd_bytes([195, 40, 128]).debug(), "Bytes(c32880)")
}

test "a derived field of type Bytes renders by the Bytes row" {
    assert_eq(BdWrap { b: bd_bytes([0, 255, 10]) }.debug(), "BdWrap \{ b: Bytes(00ff0a) }")
    assert_eq(BdWrap { b: Bytes.new() }.debug(), "BdWrap \{ b: Bytes() }")
    assert_eq(BdNested { inner: BdWrap { b: Bytes.from_str("a") }, tag: 3 }.debug(),
        "BdNested \{ inner: BdWrap \{ b: Bytes(61) }, tag: 3 }")
}

test "a field spelled with an alias of Bytes renders by the Bytes row" {
    assert_eq(BdAliased { b: Bytes.from_str("hi") }.debug(), "BdAliased \{ b: Bytes(6869) }")
}

test "a variant payload of type Bytes renders by the Bytes row" {
    assert_eq(BdPacket.Data(Bytes.from_str("a")).debug(), "Data(Bytes(61))")
    assert_eq(BdPacket.Empty.debug(), "Empty")
}

test "Bytes inside a list, an option and a map renders by the Bytes row" {
    assert_eq([Bytes.from_str("a")].debug(), "[Bytes(61)]")
    assert_eq([Bytes.new(), Bytes.from_str("hi")].debug(), "[Bytes(), Bytes(6869)]")
    assert_eq(Some(Bytes.from_str("a")).debug(), "Some(Bytes(61))")
    let none: Option[Bytes] = None
    assert_eq(none.debug(), "None")
    // One entry per map: the sorted entry order of a Map's debug text is not built yet.
    let mut m: Map[Str, Option[Bytes]] = Map.new()
    m.insert("k", Some(Bytes.from_str("a")))
    assert_eq(m.debug(), "\{\"k\": Some(Bytes(61))}")
    let mut e: Map[Str, Option[Bytes]] = Map.new()
    e.insert("e", None)
    assert_eq(e.debug(), "\{\"e\": None}")
}

test "derived container fields of Bytes render by the Bytes row" {
    let mut m: Map[Str, Option[Bytes]] = Map.new()
    m.insert("k", Some(bd_bytes([255])))
    let h = BdHolder { list: [Bytes.from_str("a"), Bytes.new()], opt: Some(Bytes.from_str("hi")), map: m }
    assert_eq(h.debug(), "BdHolder \{ list: [Bytes(61), Bytes()], opt: Some(Bytes(6869)), map: \{\"k\": Some(Bytes(ff))} }")
}

test "a generic derived field at Bytes renders by the Bytes row" {
    assert_eq(BdBox { v: Bytes.from_str("a") }.debug(), "BdBox \{ v: Bytes(61) }")
    assert_eq(BdBox { v: [Some(Bytes.from_str("a"))] }.debug(), "BdBox \{ v: [Some(Bytes(61))] }")
}

test "a Debug bound renders a Bytes by the Bytes row" {
    assert_eq(bd_show(Bytes.from_str("hi")), "Bytes(6869)")
    assert_eq(bd_show([Bytes.from_str("a")]), "[Bytes(61)]")
}

test "debug never cuts a long Bytes" {
    let big = Bytes.zeroed(1000)
    assert_eq(big.debug().len(), 2007)
    assert_eq(big.debug(), "Bytes({big.to_hex()})")
}

test "the debug text agrees with Eq" {
    let a = Bytes.from_str("hi")
    let b = bd_bytes([104, 105])
    assert(a == b)
    assert_eq(a.debug(), b.debug())
    let c = bd_bytes([104, 106])
    assert(a != c)
    assert_ne(a.debug(), c.debug())
}

test "unwrap on an Err of Bytes panics with the Bytes text" {
    assert_panics(matching: "unwrap called on Err: Bytes(6869)") {
        let _ = bd_err().unwrap()
    }
}

test "unwrap_err on an Ok of Bytes panics with the Bytes text" {
    assert_panics(matching: "unwrap_err called on Ok: Bytes(00ff0a)") {
        let _ = bd_ok().unwrap_err()
    }
}
