import compile_test_helpers

// Bytes.new() (static-method form) must infer to Bytes, so bindings
// stay typed and later b.method(...) args are still typechecked. Previously it
// inferred TYPE_UNKNOWN, silently disabling downstream arg-checks.

test "Bytes.new() len() result is typed (Str = Int rejected)" {
    let src = "fn main() \{ let b = Bytes.new()\n let n: Str = b.len() }\n"
    compile_test_helpers.expect_compile_error(src, "bytes_new_infer_len_str", "E0300")
}

test "Bytes.new() push rejects Float arg" {
    let src = "fn main() \{ let b = Bytes.new()\n b.push(2.0) }\n"
    compile_test_helpers.expect_compile_error(src, "bytes_new_infer_push_float", "E0300")
}

test "Bytes.new() push accepts Int arg" {
    let src = "fn main() \{ let b = Bytes.new()\n b.push(2) }\n"
    compile_test_helpers.expect_no_error(src, "bytes_new_infer_push_int", "E0300")
}

// Parity control — bare Bytes() constructor must still reject Float.
test "Bytes() push rejects Float arg, like the other integer-arg methods" {
    let src = "fn main() \{ let b = Bytes()\n b.push(2.0) }\n"
    compile_test_helpers.expect_compile_error(src, "bytes_new_infer_bare_float", "E0300")
}
