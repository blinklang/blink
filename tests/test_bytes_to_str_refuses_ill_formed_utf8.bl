// Every Str is valid UTF-8 (sections/03_types.md), so Bytes.to_str answers Err for a byte
// sequence that has the right lead and continuation bit patterns but is still not UTF-8.

fn from_ints(xs: List[Int]) -> Bytes {
    let mut b = Bytes.new()
    for x in xs { b.push(x) }
    b
}

test "an overlong encoding is not UTF-8" {
    assert(from_ints([192, 175]).to_str().is_err())
    assert(from_ints([224, 128, 175]).to_str().is_err())
    assert(from_ints([240, 128, 128, 175]).to_str().is_err())
}

test "an encoded surrogate is not UTF-8" {
    assert(from_ints([237, 160, 128]).to_str().is_err())
    assert(from_ints([237, 191, 191]).to_str().is_err())
}

test "a code point past U+10FFFF is not UTF-8" {
    assert(from_ints([244, 144, 128, 128]).to_str().is_err())
    assert(from_ints([245, 128, 128, 128]).to_str().is_err())
}

test "the edges of each range stay valid" {
    assert_eq(from_ints([194, 128]).to_str(), Ok("\u{80}"))
    assert_eq(from_ints([224, 160, 128]).to_str(), Ok("\u{800}"))
    assert_eq(from_ints([237, 159, 191]).to_str(), Ok("\u{d7ff}"))
    assert_eq(from_ints([238, 128, 128]).to_str(), Ok("\u{e000}"))
    assert_eq(from_ints([240, 144, 128, 128]).to_str(), Ok("\u{10000}"))
    assert_eq(from_ints([244, 143, 191, 191]).to_str(), Ok("\u{10ffff}"))
}
