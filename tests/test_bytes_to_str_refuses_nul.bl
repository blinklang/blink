// A Str cannot hold NUL (sections/02_syntax.md), so Bytes.to_str answers Err for a NUL byte
// rather than a Str that a C reader would see end at it.

fn from_ints(xs: List[Int]) -> Bytes {
    let mut b = Bytes.new()
    for x in xs { b.push(x) }
    b
}

test "a NUL byte is refused wherever it sits" {
    assert(from_ints([0]).to_str().is_err())
    assert(from_ints([97, 0]).to_str().is_err())
    assert(from_ints([0, 97]).to_str().is_err())
    assert(from_ints([97, 0, 98]).to_str().is_err())
}

test "the refusal names the NUL byte" {
    match from_ints([97, 0]).to_str() {
        Ok(_) => assert(false)
        Err(why) => assert(why.contains("NUL"))
    }
}

test "bytes either side of a NUL stay text on their own" {
    assert_eq(from_ints([97]).to_str(), Ok("a"))
    assert_eq(from_ints([1, 127]).to_str(), Ok("\u{1}\u{7f}"))
}
