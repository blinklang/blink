// Bytes.with_ptr's closure param is typed Ptr[U8] by typecheck (deref returns
// U8, addr returns Int), but codegen must emit the C param itself as a sized
// pointer so dereferencing it compiles — not as a bare void* that only
// happens to work for addr() because addr casts the pointer value, never the
// pointee.

import compile_test_helpers.{compile_and_run}

test "Bytes.with_ptr closure param derefs as U8, not through a void* param" {
    let src = #"
import std.io

fn main() ! IO {
    let b = Bytes.new()
    b.push(42)
    let first = b.with_ptr(fn(p) { p.deref().to_int() })
    io.println("{first}")
}
"#
    let r = compile_and_run(src, "_bytes_with_ptr_closure_param_deref")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "42\n")
}
