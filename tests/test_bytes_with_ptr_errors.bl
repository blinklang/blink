import compile_test_helpers

test "with_ptr body that pushes on receiver emits E0814" {
    let src = "fn main() \{ let b = Bytes.new()\n b.push(1)\n let n = b.with_ptr(fn(p) \{ b.push(2)\n 0 }) }\n"
    compile_test_helpers.expect_compile_error(src, "with_ptr_push", "E0814")
}

test "with_ptr body that calls clear on receiver emits E0814" {
    let src = "fn main() \{ let b = Bytes.new()\n b.push(1)\n let n = b.with_ptr(fn(p) \{ b.clear()\n 0 }) }\n"
    compile_test_helpers.expect_compile_error(src, "with_ptr_clear", "E0814")
}

test "with_ptr body that calls write_u32_le on receiver emits E0814" {
    let src = "fn main() \{ let b = Bytes.new()\n b.push(1)\n let n = b.with_ptr(fn(p) \{ b.write_u32_le(0)\n 0 }) }\n"
    compile_test_helpers.expect_compile_error(src, "with_ptr_write_le", "E0814")
}

test "with_ptr body that passes receiver as arg emits E0815" {
    let src = "fn helper(x: Bytes) \{ }\nfn main() \{ let b = Bytes.new()\n b.push(1)\n let n = b.with_ptr(fn(p) \{ helper(b)\n 0 }) }\n"
    compile_test_helpers.expect_compile_error(src, "with_ptr_pass_arg", "E0815")
}

test "with_ptr body that only reads receiver compiles" {
    let src = "fn main() \{ let b = Bytes.new()\n b.push(1)\n let n = b.with_ptr(fn(p) \{ b.len() })\n }\n"
    compile_test_helpers.expect_no_error(src, "with_ptr_read_ok", "E0814")
}

// The closure param is a Ptr[U8], so offset has no @ffi.struct stride and must
// error — even when it shadows an outer Ptr[T] that does. A reader that located
// the param by C-kind alone (both are pointers) would skip the unstamped param
// and borrow the outer struct's stride, silently miscompiling. E0822 must fire.
test "with_ptr param shadowing an outer ffi ptr cannot borrow its offset stride" {
    let src = "@ffi.struct(header: \"poll.h\", name: \"pollfd\")\npub type Pollfd \{ fd: I32, events: I16, revents: I16 }\nfn go() ! FFI \{ with ffi.scope() as scope \{ let p: Ptr[Pollfd] = scope.alloc_n(2)\n let b = Bytes.new()\n b.push(1)\n let _r = b.with_ptr(fn(p) \{ p.offset(1) }) } }\nfn main() \{ }\n"
    compile_test_helpers.expect_compile_error(src, "with_ptr_shadow_offset", "E0822")
}
