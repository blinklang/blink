// A whole-value ident match binder over a tuple scrutinee must bind the WHOLE
// tuple so field access through the binder resolves. The top-level
// tuple-scrutinee fast path pre-expands the tuple into one match_scruts entry per
// element (scrut_len == n_elems), but the IdentPattern arm only bound a
// whole-value ident when scrut_len == 1 -- so a whole binder over a tuple was
// silently dropped: no binding emitted, and `whole.0` rendered the literal
// `<value>` (a silent miscompile that compiled and ran with wrong output). The
// arm now reconstructs the whole tuple from the per-element scruts as a compound
// literal, names the carrier from the binder tid (gated on find_tuple_entry), and
// stamps the tid so the binder participates in the tid-sole-authority migration.
import compile_test_helpers

test "whole ident binder over a let-bound tuple resolves field access" {
    let src = "fn main() \{\n"
        .concat("    let t = (7, 9)\n")
        .concat("    match t \{ whole => io.println(\"\{whole.0\} \{whole.1\}\") \}\n")
        .concat("\}\n")
    let r = compile_test_helpers.compile_and_run(src, "_c2gn5z_let_tuple")
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("7 9"))
    assert(!r.out.contains("<value>"))
}

test "whole ident binder over a tuple literal scrutinee resolves field access" {
    let src = "fn main() \{\n"
        .concat("    match (7, 9) \{ whole => io.println(\"\{whole.0\} \{whole.1\}\") \}\n")
        .concat("\}\n")
    let r = compile_test_helpers.compile_and_run(src, "_c2gn5z_lit_tuple")
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("7 9"))
    assert(!r.out.contains("<value>"))
}

test "whole ident binder over a Map-element tuple spells the field as a pointer" {
    // A Map tuple element is the uniform blink_map* pointer, not a by-value
    // carrier: the tid tuple speller must encode it exactly like the value path,
    // else the reconstructed compound literal assigns a blink_map* into a
    // blink_map field and cc rejects it (and the shared Tuple2_map_int typedef is
    // poisoned for every other same-shape tuple in the unit).
    let src = "fn main() \{\n"
        .concat("    let mut m: Map[Str, Int] = Map()\n")
        .concat("    m.insert(\"a\", 1)\n")
        .concat("    match (m, 3) \{ whole => \{\n")
        .concat("        let mm = whole.0\n")
        .concat("        io.println(\"\{mm.get(\"a\").unwrap()\} \{whole.1\}\")\n")
        .concat("    \} \}\n")
        .concat("\}\n")
    let r = compile_test_helpers.compile_and_run(src, "_c2gn5z_map_tuple")
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("1 3"))
    assert(!r.out.contains("<value>"))
}

test "whole ident binder over a struct-element tuple resolves nested field access" {
    let src = "type TP \{ x: Int, y: Int \}\n"
        .concat("fn main() \{\n")
        .concat("    let t = (TP \{ x: 5, y: 6 \}, 7)\n")
        .concat("    match t \{ whole => \{\n")
        .concat("        let a = whole.0\n")
        .concat("        io.println(\"\{a.x\} \{a.y\} \{whole.1\}\")\n")
        .concat("    \} \}\n")
        .concat("\}\n")
    let r = compile_test_helpers.compile_and_run(src, "_c2gn5z_struct_tuple")
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("5 6 7"))
    assert(!r.out.contains("<value>"))
}
