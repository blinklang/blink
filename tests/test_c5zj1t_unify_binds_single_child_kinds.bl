// A typevar reachable only through Channel/Handle/Ptr/Template bound nowhere, and THREE
// separate walkers each had to list the kind for it to work:
//
//   tc_ann_head_matches_tid   — authorizes the annotation-vs-tid index alignment the mono-arg
//                               resolver's deep tail walks. Declining here is what produced the
//                               I0001 below; it is the only one of the three that is sufficient.
//   unify_typevar_binds       — discovery, for the call's RETURN instantiation.
//   substitute_typevar_tid    — the substitution half of that same pair.
//
// A kind missing from any of them is not a missed optimization: the signature is uncallable.

import compile_test_helpers

fn channel_src() -> Str {
    #"import std.io

fn take_one[T](c: Channel[T]) -> T {
    c.recv()
}

fn main() {
    let ch: Channel[Int] = Channel(1)
    ch.send(7)
    io.println("v={take_one(ch)}")
}
"#
}

test "a typevar reachable only through Channel binds" {
    let out = compile_test_helpers.compile_and_capture(channel_src(), "c5zj1t_chan")
    compile_test_helpers.expect_clean(out, "Channel[T] param")
    if out.contains("I0001") { compile_test_helpers.expect_contains(out, "!!never!!", "Channel[T] must not reach codegen unsolved") }
    if out.contains("UnsolvedTypeVar") { compile_test_helpers.expect_contains(out, "!!never!!", "Channel[T] must not reach codegen unsolved") }
}

test "a typevar reachable only through Channel runs" {
    let r = compile_test_helpers.compile_and_run(channel_src(), "c5zj1t_chan_run")
    if !r.out.contains("v=7") { compile_test_helpers.expect_contains(r.out, "v=7", "Channel[T] runtime") }
    assert(r.out.contains("v=7"))
}

// The arm that already exists, as the control: it proves the shape of the test itself is
// sound, so a failure above is the missing arm and not the harness.
fn list_src() -> Str {
    #"import std.io

fn take_one[T](l: List[T]) -> T {
    l.get(0).unwrap()
}

fn main() {
    let xs: List[Int] = [7]
    io.println("v={take_one(xs)}")
}
"#
}

test "the existing List arm keeps binding" {
    let r = compile_test_helpers.compile_and_run(list_src(), "c5zj1t_list_run")
    if !r.out.contains("v=7") { compile_test_helpers.expect_contains(r.out, "v=7", "List[T] runtime") }
    assert(r.out.contains("v=7"))
}
