// A call expression used directly as a callee (mk()(41)) must invoke the
// returned closure, not print a placeholder value.

fn mk() -> fn(Int) -> Int { fn(x: Int) -> Int { x + 1 } }

test.failing(
    "calling the result of a call expression invokes the closure",
    reason: "a call expression used as a callee is not recognized as a callee; the whole call is replaced by the placeholder string \"<value>\"",
    ticket: "311nk2",
) {
    let s = "r={mk()(41)}"
    assert_eq(s, "r=42")
}

test.failing(
    "calling a closure fetched from a container element",
    reason: "same callee-shape gap when the closure comes from a container accessor chain instead of a bare call",
    ticket: "311nk2",
) {
    let f = fn(x: Int) -> Int { x + 1 }
    let mut fs: List[fn(Int) -> Int] = []
    fs.push(f)
    let s = "r={fs.get(0).unwrap()(41)}"
    assert_eq(s, "r=42")
}
