// A call through a bound reads the trait's declared signature (sections/03_types.md §3.6,
// sections/03c_protocols.md). The bound says which trait and at which arguments, so the
// signature is read with `Self` as the receiver's type parameter and each trait type
// parameter as the bound's argument: through `U: Tr[Int]`, `T` is `Int`. Both spellings of
// the call, `u.m()` and `Tr.m(u)`, read it the same way.

type Pt {
    v: Int
}

trait Tr[T] {
    fn pick(self, x: T) -> Option[T]
    fn put(self, x: T) -> T
    fn missing(self, x: T, -- d: Option[T] = None) -> Bool
}

impl Tr[Int] for Pt {
    fn pick(self, x: Int) -> Option[Int] {
        Some(x + self.v)
    }
    fn put(self, x: Int) -> Int {
        x * 2
    }
    fn missing(self, x: Int, -- d: Option[Int] = None) -> Bool {
        d.is_none()
    }
}

type Name {
    s: Str
}

impl Tr[Str] for Name {
    fn pick(self, x: Str) -> Option[Str] {
        Some("{self.s}{x}")
    }
    fn put(self, x: Str) -> Str {
        x.concat(x)
    }
    fn missing(self, x: Str, -- d: Option[Str] = None) -> Bool {
        d.is_none()
    }
}

type Boxed[T] {
    t: T
}

impl[T] Tr[T] for Boxed[T] {
    fn pick(self, x: T) -> Option[T] {
        Some(x)
    }
    fn put(self, x: T) -> T {
        x
    }
    fn missing(self, x: T, -- d: Option[T] = None) -> Bool {
        d.is_none()
    }
}

trait Maker {
    fn make(self) -> Self
    fn maybe(self) -> Option[Self]
    fn same(self, -- other: Option[Self] = None) -> Bool
}

impl Maker for Pt {
    fn make(self) -> Self {
        Pt { v: self.v + 10 }
    }
    fn maybe(self) -> Option[Self] {
        Some(Pt { v: self.v + 20 })
    }
    fn same(self, -- other: Option[Self] = None) -> Bool {
        other.is_none()
    }
}

trait Measured {
    fn size(self) -> Int
}

impl Measured for Name {
    fn size(self) -> Int {
        self.s.len()
    }
}

fn picked[U: Tr[Int]](u: U) -> Int {
    u.pick(1).unwrap()
}

fn picked_qualified[U: Tr[Int]](u: U) -> Int {
    Tr.pick(u, 1).unwrap()
}

fn put_twice[U: Tr[Int]](u: U) -> Int {
    u.put(u.put(3))
}

fn missing_default[U: Tr[Int]](u: U) -> Bool {
    u.missing(1)
}

fn missing_default_qualified[U: Tr[Int]](u: U) -> Bool {
    Tr.missing(u, 1)
}

fn made[T: Maker](v: T) -> T {
    v.make()
}

fn made_qualified[T: Maker](v: T) -> T {
    Maker.make(v)
}

fn maybe_made[T: Maker](v: T) -> Option[T] {
    v.maybe()
}

fn same_default[T: Maker](v: T) -> Bool {
    v.same()
}

fn sized_and_picked[U: Measured + Tr[Str]](u: U) -> Str {
    "{u.size()} {u.pick("!").unwrap()}"
}

fn picked_at[V, U: Tr[V]](u: U, x: V) -> V {
    u.put(x)
}

fn both_defaults[U: Tr[Int], W: Tr[Str]](u: U, w: W) -> Str {
    "{u.missing(1)} {w.missing("a")}"
}

test "a call through a bound returns the trait's type parameter at the bound's argument" {
    assert_eq(picked(Pt { v: 1 }), 2)
    assert_eq(picked_qualified(Pt { v: 1 }), 2)
}

test "an argument through a bound is read at the bound's argument" {
    assert_eq(put_twice(Pt { v: 0 }), 12)
}

test "a default typed by the trait's type parameter fills at the bound's argument" {
    assert(missing_default(Pt { v: 0 }))
    assert(missing_default_qualified(Pt { v: 0 }))
}

test "a call through a bound returns Self as the receiver's type parameter" {
    assert_eq(made(Pt { v: 1 }).v, 11)
    assert_eq(made_qualified(Pt { v: 1 }).v, 11)
}

test "a call through a bound returns Option of Self as Option of the receiver's type parameter" {
    assert_eq(maybe_made(Pt { v: 1 }).unwrap().v, 21)
}

test "a default typed by Self fills at the receiver's type parameter" {
    assert(same_default(Pt { v: 1 }))
}

test "a bound beside another bound reads its own trait arguments" {
    assert_eq(sized_and_picked(Name { s: "ab" }), "2 ab!")
}

test "a bound whose argument is another type parameter reads that parameter" {
    assert_eq(picked_at(Pt { v: 0 }, 4), 8)
    assert_eq(picked_at(Name { s: "" }, "x"), "xx")
}

test "two bounds on one trait at two arguments each fill the trait's default at their own" {
    assert_eq(both_defaults(Pt { v: 0 }, Name { s: "" }), "true true")
}

test "a generic impl reached through a bound fills the trait's default at the bound's argument" {
    assert(missing_default(Boxed { t: 0 }))
    assert(missing_default_qualified(Boxed { t: 0 }))
    assert_eq(put_twice(Boxed { t: 0 }), 3)
    assert_eq(picked(Boxed { t: 0 }), 1)
}

// An impl's `where` bound is a bound on the impl's binder, read the same way.
type Held[A] {
    a: A
}

trait Shown {
    fn shown(self) -> Int
    fn shown_qualified(self) -> Int
    fn shown_default(self) -> Bool
}

impl[A] Shown for Held[A] where A: Tr[Int] {
    fn shown(self) -> Int {
        self.a.put(1)
    }
    fn shown_qualified(self) -> Int {
        Tr.pick(self.a, 1).unwrap()
    }
    fn shown_default(self) -> Bool {
        self.a.missing(1)
    }
}

type Pair[A, B] {
    a: A
    b: B
}

trait Paired {
    fn paired(self) -> Str
}

impl[A, B] Paired for Pair[A, B] where A: Measured + Tr[B], B: Display {
    fn paired(self) -> Str {
        "{self.a.size()} {self.a.put(self.b)}"
    }
}

fn via_shown[S: Shown](s: S) -> Int {
    s.shown()
}

test "a call through an impl where-bound reads the trait at the where-bound's argument" {
    assert_eq(Held { a: Pt { v: 2 } }.shown(), 2)
    assert_eq(Held { a: Pt { v: 2 } }.shown_qualified(), 3)
    assert_eq(via_shown(Held { a: Pt { v: 2 } }), 2)
}

test "a default typed by the trait's type parameter fills at an impl where-bound's argument" {
    assert(Held { a: Pt { v: 2 } }.shown_default())
}

test "a where-bound whose argument is another impl binder reads that binder" {
    assert_eq(Pair { a: Name { s: "ab" }, b: "x" }.paired(), "2 xx")
}
