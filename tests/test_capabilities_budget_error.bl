import compile_test_helpers

test "budget violation emits E0501" {
    let src = "@capabilities(IO)\n\nfn violates_budget() ! FS.Read \{\n    let _x = 1\n\}\n\nfn main() \{\n    violates_budget()\n\}\n"
    fs.write("{compile_test_helpers.scratch_root()}/_test_cap_budget.bl", src).unwrap()
    let args = ["{compile_test_helpers.scratch_root()}/_test_cap_budget.bl", "/dev/null", "--format", "json"]
    let result = process.run("build/blinkc", args)?
    let output = "{result.out}{result.err_out}"
    assert(output.contains("E0501"))
    assert(output.contains("CapabilityBudgetExceeded"))
    assert(output.contains("FS.Read"))
    assert(!output.contains("E0503"))
    assert(!output.contains("InsufficientCapability"))
    process.run("sh", ["-c", "rm -f {compile_test_helpers.scratch_root()}/_test_cap_budget.bl"])?
}

test "budget allows declared effects" {
    let src = "@capabilities(IO, FS.Read)\n\nfn uses_io() ! IO \{\n    let _x = 1\n\}\n\nfn uses_fs() ! FS.Read \{\n    let _x = 1\n\}\n\nfn main() \{\n    uses_io()\n    uses_fs()\n\}\n"
    fs.write("{compile_test_helpers.scratch_root()}/_test_cap_ok.bl", src).unwrap()
    let args = ["{compile_test_helpers.scratch_root()}/_test_cap_ok.bl", "/dev/null", "--format", "json"]
    let result = process.run("build/blinkc", args)?
    let output = "{result.out}{result.err_out}"
    assert(!output.contains("E0501"))
    process.run("sh", ["-c", "rm -f {compile_test_helpers.scratch_root()}/_test_cap_ok.bl"])?
}

test "parent effect covers child" {
    let src = "@capabilities(IO)\n\nfn uses_child() ! IO.Print \{\n    let _x = 1\n\}\n\nfn main() \{\n    uses_child()\n\}\n"
    fs.write("{compile_test_helpers.scratch_root()}/_test_cap_parent.bl", src).unwrap()
    let args = ["{compile_test_helpers.scratch_root()}/_test_cap_parent.bl", "/dev/null", "--format", "json"]
    let result = process.run("build/blinkc", args)?
    let output = "{result.out}{result.err_out}"
    assert(!output.contains("E0501"))
    process.run("sh", ["-c", "rm -f {compile_test_helpers.scratch_root()}/_test_cap_parent.bl"])?
}
