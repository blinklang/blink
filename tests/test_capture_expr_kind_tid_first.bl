// jctkac: a plain-captured identifier's C kind (expr_result_type) is read at the
// capture branch of the identifier emitter. It led with the flat pool kind
// (tp_get_kind), which stamps CT_INT on a captured data enum — while the emitted
// string, spelled through capture_cast_expr -> capture_ct (tid-first since xexddt),
// is a by-value struct deref. A consumer that reads the kind without a tid backstop
// then mistypes the value: a captured data enum put into a list literal builds a
// List[Int] whose element the C code later reads as a blink_Shape struct — invalid C.
// Reading the kind through capture_ct (tid-first) makes the type channel agree with
// the string: a data enum names an aggregate, so its kind is CT_STRUCT and the list
// carries it by value.

type Shape { Circle(Int), Square(Int) }

fn area(s: Shape) -> Int {
    match s {
        Circle(r) => r * r * 3
        Square(w) => w * w
    }
}

fn make_list_thunk(s: Shape) -> fn() -> Int {
    fn() -> Int {
        let xs = [s, s]
        area(xs.get(0).unwrap()) + area(xs.get(1).unwrap())
    }
}

test "a captured data enum keeps its struct kind through a list literal" {
    let f = make_list_thunk(Circle(10))
    assert_eq(f(), 600)
    let g = make_list_thunk(Square(6))
    assert_eq(g(), 72)
}

type Point { x: Int, y: Int }

fn sum(p: Point) -> Int { p.x + p.y }

fn make_struct_list_thunk(p: Point) -> fn() -> Int {
    fn() -> Int {
        let ps = [p, p]
        sum(ps.get(0).unwrap()) + sum(ps.get(1).unwrap())
    }
}

test "a captured struct keeps its kind through a list literal" {
    let f = make_struct_list_thunk(Point { x: 3, y: 4 })
    assert_eq(f(), 14)
}
