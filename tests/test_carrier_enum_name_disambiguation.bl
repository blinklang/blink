// enum_logical_name must not false-match an enum-named COMPONENT of a larger
// C tag. Two traps the loose suffix-walk fell into:
//   A. a struct whose C tag ends in `_<enum>` (Foo_Bar, with a sibling enum Bar)
//   B. a compound carrier tag that contains a payload-less enum arm
//      (Result_Int_Cmd inside Option[Result[Int, Cmd]])
// Either false-match makes is_payloadless_enum lie, boxing/unboxing the wrong
// shape. Guards the tid-sole-authority by-value carrier migration.

type Bar { A B }
type Foo_Bar { x: Int }

type Cmd { Start Stop }

fn mk_nested() -> Option[Result[Int, Cmd]] { Some(Ok(7)) }

test "struct with enum-suffix name is not a payloadless enum" {
    let items = [Foo_Bar { x: 30 }]
    match items.get(0) {
        Some(f) => assert_eq(f.x, 30)
        None => assert_eq(0, 1)
    }
}

test "compound carrier tag with payloadless err arm is boxed, not inline" {
    match mk_nested() {
        Some(r) => match r { Ok(v) => assert_eq(v, 7) Err(_) => assert_eq(0, 1) }
        None => assert_eq(0, 1)
    }
}
