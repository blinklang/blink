import std.errno.{Errno}

// A payload-less enum and a transparent newtype both live BY VALUE inside an
// Option carrier (inline ordinal / inline int64_t, never a heap box). The `?`
// and `??` consumers must read the carrier value directly, not deref it as a
// pointer. Guards the tid-sole-authority by-value carrier migration.

type Cmd { Start Stop }

fn opt_pl() -> Option[Cmd] { Some(Cmd.Stop) }
fn opt_tn() -> Option[Errno] { Some(Errno(7)) }

fn try_pl() -> Option[Int] {
    let c = opt_pl()?
    match c { Start => Some(1) Stop => Some(2) }
}

fn try_tn() -> Option[Int] {
    let e = opt_tn()?
    match e { Errno(rc) => Some(rc) }
}

test "payloadless-enum ?? reads inline ordinal" {
    let c = opt_pl() ?? Cmd.Start
    match c { Start => assert_eq(0, 1) Stop => assert_eq(1, 1) }
}

test "transparent-newtype ?? reads inline int64" {
    let e = opt_tn() ?? Errno(0)
    match e { Errno(rc) => assert_eq(rc, 7) }
}

test "payloadless-enum ? propagates inline ordinal" {
    match try_pl() { Some(v) => assert_eq(v, 2) None => assert_eq(0, 1) }
}

test "transparent-newtype ? propagates inline int64" {
    match try_tn() { Some(v) => assert_eq(v, 7) None => assert_eq(0, 1) }
}

test "payloadless-enum unwrap and match-bind still by value" {
    let c = opt_pl().unwrap()
    match c { Start => assert_eq(0, 1) Stop => assert_eq(1, 1) }
}

test "transparent-newtype unwrap and match-bind still by value" {
    let e = opt_tn().unwrap()
    match e { Errno(rc) => assert_eq(rc, 7) }
}
