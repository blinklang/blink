// An Option/Result carrier field whose inner is a concrete generic-struct
// instance must keep that instance's mono args even when the carrier field
// lives inside a DIFFERENT generic enclosing struct.

import compile_test_helpers.{compile_and_run}

test.failing(
    "an Option of Box of Int field inside a generic enclosing struct keeps the Box mono args",
    reason: "emit_mono_struct_typedef's Option/Result branches resolve the carrier inner via carrier_inner_instance_stem, which returns the bare base 'Box' instead of the mono stem 'Box_0Int' when the enclosing struct is itself generic",
    ticket: "9m9yaj",
) {
    let src = #"
import std.io

type Box[T] { val: T }
type G[T] {
    tag: T
    m: Option[Box[Int]]
}

fn f() -> Int {
    let g = G { tag: 1, m: Some(Box { val: 15 }) }
    g.m.unwrap().val
}

fn main() ! IO {
    io.println("{f()}")
}
"#
    let r = compile_and_run(src, "_carrier_inner_generic_instance_inside_generic_struct")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "15\n")
}
