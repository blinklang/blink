// A target-directed `.into()` inside an Option or Result payload must build the
// carrier from the RESOLVED payload type, not from the argument's own type.
//
// `Some(i.into())` where the target is `Option[Float]` used to spell
// `(blink_Option_int){.tag = 1, .value = i}` — the source carrier over the
// unconverted source value. Today the C compiler rejects that, so the defect is
// a build failure, but the class is a wrong-type emit: the same mistake between
// two types of equal C width would compile and reinterpret the bits.
//
// Every assertion is on a VALUE. The float payloads are chosen so an integer
// carrier cannot produce them: 3.into() / 2 is 1.5 through a Float slot and 1
// through an Int one.

fn opt_float_from_int(i: Int) -> Option[Float] {
    Some(i.into())
}

fn res_float_from_int(i: Int) -> Result[Float, Str] {
    Ok(i.into())
}

fn res_err_float_from_int(i: Int) -> Result[Str, Float] {
    Err(i.into())
}

test "an Option payload built by into() carries the target's Float" {
    let v = opt_float_from_int(3).unwrap()
    assert_eq(v / 2.0, 1.5)
    assert_eq(opt_float_from_int(7).unwrap(), 7.0)
}

test "a Result ok payload built by into() carries the target's Float" {
    let v = res_float_from_int(3).unwrap()
    assert_eq(v / 2.0, 1.5)
}

test "a Result err payload built by into() carries the target's Float" {
    match res_err_float_from_int(3) {
        Ok(_) => { assert_eq(1, 0) }
        Err(e) => { assert_eq(e / 2.0, 1.5) }
    }
}

test "an annotated let of an Option payload built by into() carries Float" {
    let a: Option[Float] = Some(3.into())
    assert_eq(a.unwrap() / 2.0, 1.5)
}

test "an annotated let of a Result payload built by into() carries Float" {
    let r: Result[Float, Str] = Ok(3.into())
    assert_eq(r.unwrap() / 2.0, 1.5)
}
