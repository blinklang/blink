// jctkac: fn/method return spelling for carrier, tuple, Ptr, and Handler returns
// is driven by the return-annotation tid (c_type_from_tid), not the flat
// resolve_ret_type_from_ann carrier. Three emit sites carried a now-dead
// `if r_spelled != "" { r_spelled } else { resolved }` fallback: emit_fn_decl
// (sig_ret_decl_resolved), emit_fn_def (sig_ret_def_resolved), and
// emit_impl_method_def (impl_sig_ret_resolved). The else fired only when the tid
// declined (r_spelled == ""), which cannot happen at these sites: an annotated
// carrier return always registers a populated ret_tid (the RetType tid is
// totalized), and the one shape whose tid declines — a typevar carrier inner on a
// generic template — is never emitted (an uncalled generic has no monomorph, and a
// called one is emitted per concrete instance with a spellable inner).
//
// The functions and the trait method BELOW are the coverage: each carrier /
// tuple return here is emitted through one of the three resolved sites when this
// test compiles, and every body reads a concrete value back through the carrier so
// a wrong or empty return spelling would fail to compile or return the wrong
// answer. This exercises the tid-sole return spelling end to end; because the
// fallback arm was already dead, no user-constructible shape flips its answer, so
// these rows are a characterization pin plus a regression guard against a future
// tid-decline at a return position (which, with the fallback gone, would emit an
// empty type rather than silently spelling the flat carrier).

type Pt { x: Int, y: Int }
type Col { Red, Green, Blue }

// Free-fn carrier returns — the sig_ret_decl_resolved / sig_ret_def_resolved sites.
fn opt_struct() -> Option[Pt] { Some(Pt { x: 1, y: 2 }) }
fn opt_enum() -> Option[Col] { Some(Col.Green) }
fn res_struct() -> Result[Pt, Str] { Ok(Pt { x: 3, y: 4 }) }
fn res_nested() -> Result[Option[Int], Str] { Ok(Some(5)) }
fn tup_ret() -> (Int, Str, Bool) { (9, "b", true) }
fn opt_list() -> Option[List[Int]] { Some([10, 20, 30]) }

// Trait-method carrier return — the impl_sig_ret_resolved site.
trait Carrier {
    fn as_opt(self) -> Option[Int]
    fn as_res(self) -> Result[Int, Str]
    fn as_tup(self) -> (Int, Int)
}

impl Carrier for Pt {
    fn as_opt(self) -> Option[Int] { Some(self.x) }
    fn as_res(self) -> Result[Int, Str] { Ok(self.y) }
    fn as_tup(self) -> (Int, Int) { (self.x, self.y) }
}

test "free-fn Option[struct] return carries the struct" {
    match opt_struct() {
        Some(p) => assert(p.x == 1 && p.y == 2)
        None => assert(false)
    }
}

test "free-fn Option[enum] return carries the enum" {
    match opt_enum() {
        Some(c) => assert(c == Col.Green)
        None => assert(false)
    }
}

test "free-fn Result[struct,Str] return carries the ok struct" {
    match res_struct() {
        Ok(p) => assert(p.x == 3 && p.y == 4)
        Err(_) => assert(false)
    }
}

test "free-fn Result[Option[Int],Str] nested carrier return round-trips" {
    match res_nested() {
        Ok(inner) => {
            match inner {
                Some(v) => assert(v == 5)
                None => assert(false)
            }
        }
        Err(_) => assert(false)
    }
}

test "free-fn tuple return carries all three fields" {
    let t = tup_ret()
    assert(t.0 == 9)
    assert(t.1 == "b")
    assert(t.2 == true)
}

test "free-fn Option[List[Int]] return carries the list" {
    match opt_list() {
        Some(xs) => {
            assert(xs.len() == 3)
            assert(xs.get(1).unwrap() == 20)
        }
        None => assert(false)
    }
}

test "impl-method Option/Result/tuple returns carry their payloads" {
    let p = Pt { x: 11, y: 12 }
    match p.as_opt() {
        Some(v) => assert(v == 11)
        None => assert(false)
    }
    match p.as_res() {
        Ok(v) => assert(v == 12)
        Err(_) => assert(false)
    }
    let t = p.as_tup()
    assert(t.0 == 11)
    assert(t.1 == 12)
}
