// A Map whose VALUE is itself compound — Map[Str, Option[Int]], Map[Str, Map[Str,Int]] —
// recovered through a carrier `.unwrap()` or a match binder. The map's flat value channels
// cannot hold a compound value, so the older path stamped a scalar floor at the decline site;
// `.get` now recovers the value from the receiver's authoritative tid instead, so the compound
// value survives regardless of the floored flat meta.
//
fn mk_opt_val() -> Option[Map[Str, Option[Int]]] {
    let mut m: Map[Str, Option[Int]] = Map()
    m.insert("k", Some(42))
    Some(m)
}

fn mk_map_val() -> Result[Map[Str, Map[Str, Int]], Str] {
    let mut inner: Map[Str, Int] = Map()
    inner.insert("in", 7)
    let mut m: Map[Str, Map[Str, Int]] = Map()
    m.insert("k", inner)
    Ok(m)
}

test "unwrap-recovered Map[Str, Option[Int]] keeps the Option value" {
    let m = mk_opt_val().unwrap()
    let got = m.get("k").unwrap().unwrap()
    assert_eq(got, 42)
}

test "unwrap-recovered Map[Str, Map[Str,Int]] keeps the Map value" {
    let m = mk_map_val().unwrap()
    let inner = m.get("k").unwrap()
    assert_eq(inner.get("in").unwrap(), 7)
}

test "match-binder Map[Str, Option[Int]] keeps the Option value" {
    let outer = mk_opt_val()
    match outer {
        Some(m) => {
            let got = m.get("k").unwrap().unwrap()
            assert_eq(got, 42)
        }
        None => assert_eq(0, 1)
    }
}
