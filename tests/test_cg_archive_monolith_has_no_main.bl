// An archive monolith is a translation unit of shared definitions with no entry point of
// its own: the program that links against it supplies its own main() and calls into the
// archive by name. A unit built in archive mode that still writes the C main() shim
// defines the same symbol twice the moment a user program links against it.
import std.fs
import std.io
import layout.{layout_reset}
import cname.{cname_reset}
import cg_test_helpers.{cg_probe_compile}
import cg.{CgConfig, generate}
import mono.{run_mono}

fn assert_lacks(text: Str, needle: Str) {
    if text.index_of(needle) >= 0 {
        io.println("FAIL: output must not have '{needle}'\n--- output ---\n{text}")
    }
    assert(text.index_of(needle) < 0)
}

fn build_probe(src: Str, name: Str) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS.Delete {
    let path = "build/{name}.bl"
    let program = cg_probe_compile(path, src)
    run_mono(program)
    layout_reset()
    cname_reset()
    let _ = fs.delete(path)
    program
}

fn archive_cfg() -> CgConfig {
    CgConfig { debug_mode: 0, trace_codegen: 0, deterministic: 0, emit_only_module: "",
        skip_modules: Map(), user_tu_mode: 0, blink_ev_extern_only: 0, archive_build_mode: 1 }
}

fn main_src() -> Str {
    #"fn main() {
    let x = 1
}
"#
}

test "an archive monolith over a program with fn main emits no main() shim" {
    let program = build_probe(main_src(), "cg_archive_no_main_probe")
    let text = generate(program, archive_cfg())
    assert_lacks(text, "int main(")
}
