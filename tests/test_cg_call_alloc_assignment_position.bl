// scope.alloc/alloc_n reached through an assignment target (`p = scope.alloc_n(4)`)
// rather than through a `let` binding. typecheck seeds the assignment target's declared
// type into the hint that answers the allocation's pointee (tc_infer_assigned_value), so
// this stage sees the same tid it would see from a `let`. It refuses for the same reason
// the `let` form does — no IR node carries a size, so nothing here may write one — and it
// must refuse by the same name, not fall through to a miscompile: this is the shape of the
// bug the allocator used to have (sizeof(void) from an unseeded size), pinned as a refusal
// instead of a silent wrong size.
import lower_test_helpers.{probe, assert_ice_saying}
import parser.{node_kind, node_target, node_value, nodes}
import ast.{NodeKind, nk_of}
import cg_call.{lower_call}
import mono.{run_mono}

// The right-hand side of `<ident> = ...` in the probe. There is exactly one assignment in
// each probe here, so the first one found is the one under test.
fn assignment_rhs() -> Int {
    let mut i = 0
    while i < nodes.len() {
        if nk_of(node_kind(i)) == NodeKind.Assignment {
            let t = node_target(i)
            if nk_of(node_kind(t)) == NodeKind.Ident { return node_value(i) }
        }
        i = i + 1
    }
    -1
}

test "scope.alloc_n assigned into an existing pointer refuses the same as a let binding" {
    let program = probe("cg_call_alloc_assign_n", #"
fn main() {
    with ffi.scope() as scope {
        let mut p: Ptr[Int] = scope.alloc()
        p = scope.alloc_n(4)
    }
}
"#)
    run_mono(program)
    assert_ice_saying("alloc_n via assignment", lower_call(assignment_rhs()), "AllocationSizeNotInIr",
        "no IR node carries a size")
}

test "scope.alloc assigned into an existing pointer refuses the same as a let binding" {
    let program = probe("cg_call_alloc_assign", #"
fn main() {
    with ffi.scope() as scope {
        let mut p: Ptr[Int] = scope.alloc()
        p = scope.alloc()
    }
}
"#)
    run_mono(program)
    assert_ice_saying("alloc via assignment", lower_call(assignment_rhs()), "AllocationSizeNotInIr",
        "no IR node carries a size")
}
