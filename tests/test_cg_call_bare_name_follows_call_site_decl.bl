// A bare free-function call and a module-qualified one both resolve to the exact
// declaration name resolution already decided the call means (typecheck.tc_call_decl_node),
// not to a fresh search of every declaration in the program by spelling.
//
// tests/zzcd_calls/src/zzcd_left.bl and zzcd_right.bl both declare `zzcd_pick`. A codegen
// stage that re-derived the callee by name alone would find both and could not tell them
// apart; the caller's own import list already settled which one a bare call in that file
// means, and the call-site table records that answer once so codegen never re-asks.

import compiler.{compile_to_program}
import typecheck.{check_types}
import diagnostics.{diag_reset, diag_entries}
import parser.{node_kind, node_name, node_left, node_obj, node_method, node_module, nodes}
import ast.{NodeKind, nk_of}
import layout.{layout_reset}
import ir.{ir_reset, IrKind, ir_kind, ir_kind_name, ir_c_name}
import cg_expr.{cg_expr_reset}
import cg_reg.{cg_reg_reset, cg_reg_build, cg_reg_fn_decls}
import cg_call.{lower_call}
import mono.{run_mono}
import cname.{c_fn_decl_name}
import cg_test_helpers.{cg_probe_begin, cg_probe_front_end_clean}
import std.io

fn dump_ice() {
    for d in diag_entries {
        if d.severity == "ice" || d.severity == "error" { io.println("  [{d.severity}] {d.name}: {d.message}") }
    }
}

// The fixture already exists on disk, so compiling it is the same walk every other
// compile_to_program probe in this suite does, minus the write this one does not need.
fn compile_fixture(path: Str) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck {
    diag_reset()
    cg_probe_begin(path)
    let program = compile_to_program(path, 1)
    cg_probe_front_end_clean("import resolution")
    check_types(program)
    cg_probe_front_end_clean("type checking")
    layout_reset()
    ir_reset()
    cg_expr_reset()
    cg_reg_reset()
    cg_reg_build(program)
    program
}

fn bare_call(name: Str) -> Int {
    let mut i = 0
    while i < nodes.len() {
        if nk_of(node_kind(i)) == NodeKind.Call {
            let callee = node_left(i)
            if callee != -1 && nk_of(node_kind(callee)) == NodeKind.Ident && node_name(callee) == name {
                return i
            }
        }
        i = i + 1
    }
    io.println("FAIL: no bare call to '{name}' found")
    assert(false)
    -1
}

fn qualified_call(qualifier: Str, member: Str) -> Int {
    let mut i = 0
    while i < nodes.len() {
        if nk_of(node_kind(i)) == NodeKind.MethodCall && node_method(i) == member {
            let obj = node_obj(i)
            if obj != -1 && nk_of(node_kind(obj)) == NodeKind.Ident && node_name(obj) == qualifier {
                return i
            }
        }
        i = i + 1
    }
    io.println("FAIL: no qualified call '{qualifier}.{member}' found")
    assert(false)
    -1
}

fn decl_named_in(module_key: Str, name: Str) -> Int {
    for f in cg_reg_fn_decls() {
        if node_name(f) == name && node_module(f) == module_key { return f }
    }
    io.println("FAIL: no declaration of '{name}' in module '{module_key}'")
    assert(false)
    -1
}

fn assert_calls_symbol(label: Str, id: Int, want_module: Str, want_name: Str) {
    if id < 0 {
        io.println("FAIL: {label}: lowering refused instead of answering a call")
        dump_ice()
    }
    assert(id >= 0)
    if ir_kind(id) != IrKind.CallDirect {
        io.println("FAIL: {label}: kind is {ir_kind_name(ir_kind(id))}, want CallDirect")
    }
    assert_eq(ir_kind(id), IrKind.CallDirect)
    let want = c_fn_decl_name(decl_named_in(want_module, want_name))
    if ir_c_name(id) != want {
        io.println("FAIL: {label}: symbol is '{ir_c_name(id)}', want '{want}'")
    }
    assert_eq(ir_c_name(id), want)
}

test "a bare name two modules declare calls the declaration this file's import selected" {
    let program = compile_fixture("tests/zzcd_calls/src/main_left.bl")
    run_mono(program)
    assert_calls_symbol("left", lower_call(bare_call("zzcd_pick")), "zzcd_left", "zzcd_pick")
}

// The same spelling, the other import: proves the answer follows the importing file rather
// than being a fixed winner of a scan over every declaration named `zzcd_pick`.
test "the same bare name in a second file's import calls the other module's declaration" {
    let program = compile_fixture("tests/zzcd_calls/src/main_right.bl")
    run_mono(program)
    assert_calls_symbol("right", lower_call(bare_call("zzcd_pick")), "zzcd_right", "zzcd_pick")
}

// zzcd_user.bl aliases a different module's function to the name `zzcd_tag`. The qualifier
// in main_qualified.bl settles the module before any name is read, so that alias — bound in
// a file this program also loads — must not reach across into what the qualifier means.
test "a module-qualified call reaches the qualifier's own declaration despite another file's alias" {
    let program = compile_fixture("tests/zzcd_calls/src/main_qualified.bl")
    run_mono(program)
    assert_calls_symbol("qualified", lower_call(qualified_call("zzcd_tagger", "zzcd_tag")), "zzcd_tagger", "zzcd_tag")
}
