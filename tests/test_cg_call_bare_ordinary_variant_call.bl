// A bare call to an ordinary enum variant, `Circle(2)` rather than `Shape.Circle(2)`,
// where the variant's own name is not shared with its enum (unlike the newtype shape
// std.errno.Errno covers in test_cg_call_bare_self_named_variant.bl). Before typecheck's
// nr_resolve_bare_decl learned to record the variant arm for this shape, a bare call
// only ever reached tc_call_decl_node's declined (-1) answer through the two-declarations-
// at-once collision a same-name newtype causes; an ordinary variant, unique in the program
// by name, never collided and so never produced a call-site declaration at all. Now that
// the resolver records the arm for this shape too, tc_call_decl_node answers a real
// NodeKind.TypeVariant node -- and that answer must route to the same variant-construction
// path a qualified `Shape.Circle(2)` already takes, not fall through to cc_free_call, which
// reads the variant node as though it declared a function and reaches for a C symbol no
// function under that name ever defines.
import lower_test_helpers.{ probe, rhs_of, assert_eq_str, assert_kind, assert_verifies }
import cg_expr.{lower_expr}
import ir.{ir_c_name, ir_kid, IrKind}
import diagnostics.{diag_ice_count}

fn src() -> Str {
    #"type Shape {
    Circle(r: Int)
    Rect(w: Int, h: Int)
}

fn main() {
    let ring = Circle(2)
    let _keep = ring
}
"#
}

test "a bare ordinary variant call builds the same shape as the qualified constructor" {
    probe("bare_ordinary_variant", src())
    let built = lower_expr(rhs_of("ring"))
    assert_kind("kind", built, IrKind.EnumNew)
    assert_eq_str("member", ir_c_name(built), "Circle")
    let tag = ir_kid(built, 0)
    assert_kind("tag kind", tag, IrKind.Const)
    assert_eq_str("tag", ir_c_name(tag), "blink_Shape_Circle_TAG")
    assert_verifies("bare ordinary variant", built)
    assert_eq(diag_ice_count, 0)
}
