// A newtype's single variant shares its name with the type, e.g. `std.errno`'s
// `pub type Errno { Errno(Int) }`. A caller who imports only `Errno` and writes it bare,
// `Errno(5)`, names two declarations at once: the type and its own variant. Name
// resolution's global-unique pass (typecheck's nr_resolve_bare_decl) sees both candidates
// and declines to pick either, so typecheck.tc_call_decl_node answers -1 for the call --
// not because the call is wrong, but because two things share the spelling.
//
// The spec's variant-construction rule (sections/03_types.md, "Variant Construction") makes
// this exact shape the point of a newtype: a bare call should resolve to the one enum
// variant that name matches program-wide. Reading typecheck's decline as "no such callee"
// instead sends the call to the generic ICE and poisons the value; this newtype is meant to
// be constructed exactly this way, so the decline must fall back to the same variant-
// construction path a qualified `Errno.Errno(5)` already takes.
import lower_test_helpers.{ probe, rhs_of, assert_eq_str, assert_kind, assert_verifies }
import cg_expr.{lower_expr}
import ir.{ir_c_name, IrKind}
import diagnostics.{diag_ice_count}

fn src() -> Str {
    #"import std.errno.{Errno}

fn main() {
    let e = Errno(5)
    let _keep = e
}
"#
}

test "a bare self-named single-variant call builds the variant, not a free-function call" {
    probe("bare_self_named_variant", src())
    let built = lower_expr(rhs_of("e"))
    assert_kind("kind", built, IrKind.EnumNew)
    assert_eq_str("member", ir_c_name(built), "Errno")
    assert_verifies("errno", built)
    assert_eq(diag_ice_count, 0)
}
