// Bare calls to a name the compiler recognises without any Blink declaration behind it.
//
// `is_builtin_fn` is the front end's own list of these names, read before any declared
// function is looked up, so a program cannot shadow one by declaring a function of the same
// name. Three shapes reach that list through the ordinary bare-call path (`Ident(args)`):
// a plain runtime call such as `file_exists`, a builtin type's own constructor spelled bare
// (`Bytes()`) rather than through its qualified `Type.new()` form, and a name this stage
// does not lower yet (`assert`, `Set`), which must keep refusing exactly as it did before.

import lower_test_helpers.{
    probe, probe_but, rhs_of, let_node_of, assert_kind, assert_eq_str, assert_shape,
    assert_verifies, assert_ice_saying,
}
import parser.{node_kind, node_left, node_name, nodes}
import ast.{NodeKind, nk_of}
import ir.{IrKind, ir_c_name}
import cg_expr.{lower_expr}
import std.io

// A call written as a statement binds no name, so it is found by walking forward from a
// binding the probe does name: a statement parses after the binding above it, so its node
// id is higher. The callee is read off the Call node's own left child, not a method name,
// because a bare call has no qualifier for a method name to sit after.
fn call_after(anchor: Str, name: Str) -> Int {
    let mut i = let_node_of(anchor)
    while i < nodes.len() {
        if nk_of(node_kind(i)) == NodeKind.Call {
            let callee = node_left(i)
            if callee >= 0 && nk_of(node_kind(callee)) == NodeKind.Ident && node_name(callee) == name {
                return i
            }
        }
        i = i + 1
    }
    io.println("FAIL: probe has no call of '{name}' after '{anchor}'")
    assert(false)
    -1
}

// One call per plain runtime name, each written with the arity its runtime call takes.
// `write_file` and `exit` answer nothing, so they sit as statements; the rest answer a
// value and are bound.
fn src_plain() -> Str {
    #"fn main() {
    let path = "hi.txt"
    let content = "hi"
    let exists = file_exists(path)
    let dir = is_dir(path)
    let text = read_file(path)
    write_file(path, content)
    let entries = list_dir(path)
    fs_remove(path)
    let code = shell_exec("true")
    let now = time_ms()
    let n = arg_count()
    let a0 = get_arg(0)
    let _keep = [exists, dir, code, now, n]
    let _also = [text.len(), entries.len(), a0.len()]
    exit(0)
}
"#
}

// The process family and `getpid`: plain runtime names exactly like the ones above, whose
// runtime call already exists (bootstrap/runtime_process.h, runtime_core.h) and whose
// return type is already known to typecheck (a scalar, TYPE_VOID, or the already-registered
// runtime-owned ProcessResult struct) -- only the cc_builtin_free_symbol/arity rows are
// missing, so every one of these still falls into the generic "closure values and
// compiler-provided calls" refusal until this file's rows are added.
fn src_process() -> Str {
    #"fn main() {
    let cmd = "true"
    let args: List[Str] = []
    let pid = getpid()
    let res = process_run(cmd, args)
    let res2 = process_run_with_stdin(cmd, args, "in")
    process_exec(cmd, args)
    let handle = process_spawn(cmd, args)
    let waited = process_pid_wait(handle)
    let killed = process_pid_kill(handle, 9)
    let signaled = process_pid_send_signal(handle, 9)
    process_install_signal_forwarding()
    let _keep = [pid, handle, killed, signaled]
    let _also = [res.exit_code, res2.exit_code, waited.exit_code]
}
"#
}

// A wrong-arity `process_run` call, exercising the same arity backstop the other plain
// runtime names already share once process_run has a row of its own.
fn src_process_arity_wrong() -> Str {
    #"fn main() {
    let res = process_run("true")
    let _keep = res
}
"#
}

// A builtin type's own constructor spelled bare, and a bare `Channel(n)` under the
// annotation that resolves its element metavar.
fn src_ctors() -> Str {
    #"fn main() {
    let cap = 16
    let text = "hi"
    let builder = StringBuilder()
    let empty = Bytes()
    let ch: Channel[Int] = Channel(4)
    let _keep = [cap.to_str(), text]
    let _also = ch
    let _also2 = builder
    let _also3 = empty
}
"#
}

// A closure value called where a plain name would go, and one bound name shadowing what
// would otherwise be a builtin's own name. Neither is a free name (cc_is_free_name reads
// the binder scope before is_builtin_fn is ever asked), so both must keep going through
// the closure-call path unchanged.
fn src_closure_arg() -> Str {
    #"fn main() {
    let add_one = fn(x: Int) -> Int { x + 1 }
    let via_binding = add_one(4)
    let via_iife = (fn(y: Int) -> Int { y * 2 })(3)
    let _keep = [via_binding, via_iife]
}
"#
}

// The tail this slice leaves refused: `Set()` names a keyed container whose key operations
// this stage cannot choose from a call alone, and must still refuse through the exact
// mechanism it refused through before this slice touched the free-call path.
fn src_refused() -> Str {
    #"fn main() {
    let mut seen = Set()
    seen.insert(7)
    let _keep = seen.len()
}
"#
}

// The four assertion builtins are statement-shaped compiler sugar with no value-returning
// lowering here: each names its own gap now, rather than sharing the generic "closure
// values and compiler-provided calls" refusal every other unbuilt name still falls into.
fn src_assert_family() -> Str {
    #"fn main() {
    let start = 0
    assert(1 == 1)
    assert_eq(1 + 1, 2)
    assert_ne(1, 2)
    debug_assert(1 == 1)
    let _keep = start
}
"#
}

// A wrong-arity call to a plain runtime name. Typecheck does not check the arity of these,
// so this program still type-checks and the backstop this slice adds is what refuses it.
fn src_free_arity_wrong() -> Str {
    #"fn main() {
    let now = time_ms(1)
    let _keep = now
}
"#
}

// A wrong-arity bare `Channel(...)` call, exercising the new Channel row through the same
// backstop the other builtin constructors already share.
fn src_channel_arity_wrong() -> Str {
    #"fn main() {
    let ch: Channel[Int] = Channel()
    let _keep = ch
}
"#
}

test "file_exists reaches the runtime call with its path argument" {
    probe("cg_call_bf_file_exists", src_plain())
    let built = lower_expr(rhs_of("exists"))
    assert_kind("kind", built, IrKind.CallRuntime)
    assert_shape("shape", built, "CallRuntime(VarRef)")
    assert_eq_str("symbol", ir_c_name(built), "blink_file_exists")
    assert_verifies("file_exists", built)
}

test "is_dir reaches the runtime call with its path argument" {
    probe("cg_call_bf_is_dir", src_plain())
    let built = lower_expr(rhs_of("dir"))
    assert_shape("shape", built, "CallRuntime(VarRef)")
    assert_eq_str("symbol", ir_c_name(built), "blink_is_dir")
    assert_verifies("is_dir", built)
}

