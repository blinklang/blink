test "a wrong-arity process_run call refuses rather than emit an uncompilable call" {
    probe("cg_call_bf_process_run_arity", src_process_arity_wrong())
    assert_ice_saying("process_run(\"true\")", lower_expr(rhs_of("res")),
        "RuntimeFreeCallArityWrong",
        "'process_run' takes 2 argument(s), and this call was given 1")
}

test "a bare StringBuilder() reaches the same runtime constructor as StringBuilder.new()" {
    probe("cg_call_bf_sb_bare", src_ctors())
    let built = lower_expr(rhs_of("builder"))
    assert_kind("kind", built, IrKind.CallRuntime)
    assert_shape("shape", built, "CallRuntime")
    assert_eq_str("symbol", ir_c_name(built), "blink_sb_new")
    assert_verifies("StringBuilder bare", built)
}

