// Bare calls to a name the compiler recognises without any Blink declaration behind it.
//
// `is_builtin_fn` is the front end's own list of these names. Typecheck and lowering both
// look for a declared function of the same name first, and a declared function wins, so only
// a bare call that no declaration answers reaches that list. A removed free function such as
// `exit` is not on that list, so a bare call to it that no declaration answers is an
// undefined function. Three shapes reach that list through the ordinary bare-call path
// (`Ident(args)`): a plain runtime call such as `time_ms`, a builtin type's own constructor
// spelled bare (`Bytes()`, `Set()`) rather than through its qualified `Type.new()` form, and a
// name this stage does not lower yet (`assert`), which must keep refusing exactly as it did
// before.

import lower_test_helpers.{
    probe, probe_but, rhs_of, let_node_of, assert_kind, assert_eq_str, assert_shape,
    assert_verifies, assert_ice_saying,
}
import parser.{node_count, node_kind, node_left, node_name, node_method}
import ast.{NodeKind}
import ir.{IrKind, ir_c_name, ir_kops_table}
import cg_expr.{lower_expr}
import diagnostics.{diag_entries}
import std.io

// A call written as a statement binds no name, so it is found by walking forward from a
// binding the probe does name: a statement parses after the binding above it, so its node
// id is higher. The callee is read off the Call node's own left child, not a method name,
// because a bare call has no qualifier for a method name to sit after.
fn call_after(anchor: Str, name: Str) -> Int ! IO.Print {
    let mut i = let_node_of(anchor)
    while i < node_count() {
        if node_kind(i) == NodeKind.Call {
            let callee = node_left(i)
            if callee >= 0 && node_kind(callee) == NodeKind.Ident && node_name(callee) == name {
                return i
            }
        }
        i = i + 1
    }
    io.println("FAIL: probe has no call of '{name}' after '{anchor}'")
    assert(false)
    -1
}

// A plain runtime name, written with the arity its runtime call takes.
fn src_plain() -> Str {
    #"fn main() {
    let now = time_ms()
    let _keep = [now]
}
"#
}

// Bare `exit` is a removed free function, so the name is free for a program to declare, and
// a program ends the process through `env.exit` instead.
fn src_own_exit() -> Str {
    #"fn exit(c: Int) -> Int {
    c + 1
}

fn main() {
    let code = 0
    let _r = exit(code)
    env.exit(code)
}
"#
}

fn method_call_after(anchor: Str, method: Str) -> Int ! IO.Print {
    let mut i = let_node_of(anchor)
    while i < node_count() {
        if node_kind(i) == NodeKind.MethodCall && node_method(i) == method { return i }
        i = i + 1
    }
    io.println("FAIL: probe has no call of '{method}' after '{anchor}'")
    assert(false)
    -1
}

// `getpid`: a plain runtime name like the ones above, whose runtime call is in
// bootstrap/runtime_core.h and whose return type typecheck already knows.
fn src_process() -> Str {
    #"fn main() {
    let pid = getpid()
    let _keep = [pid]
}
"#
}

// A builtin type's own constructor spelled bare, and a channel built the one way the spec
// allows, `channel.new[T](buffer: n)`. StringBuilder and Channel have no bare form, so each
// is built through its own constructor.
fn src_ctors() -> Str {
    #"fn main() {
    let cap = 16
    let text = "hi"
    let builder = StringBuilder.new()
    let empty = Bytes()
    let ch: Channel[Int] = channel.new[Int](buffer: 4)
    let _keep = [cap.to_str(), text]
    let _also = ch
    let _also2 = builder
    let _also3 = empty
}
"#
}

// A closure value called where a plain name would go, and one bound name shadowing what
// would otherwise be a builtin's own name. Neither is a free name (cc_is_free_name reads
// the binder scope before is_builtin_fn is ever asked), so both must keep going through
// the closure-call path unchanged.
fn src_closure_arg() -> Str {
    #"fn main() {
    let add_one = fn(x: Int) -> Int { x + 1 }
    let via_binding = add_one(4)
    let via_iife = (fn(y: Int) -> Int { y * 2 })(3)
    let _keep = [via_binding, via_iife]
}
"#
}

// `Set()` names a keyed container: typecheck resolves it to the same tid a qualified
// `Set.new()` would, so codegen builds it the same way, reading the runtime constructor
// and the element's operations table off that tid rather than off which spelling was
// written. It no longer falls through to the generic "closure values and compiler-provided
// calls" refusal every other unbuilt free name still shares.
fn src_set_ctor() -> Str {
    #"fn main() {
    let mut seen = Set()
    seen.insert(7)
    let _keep = seen.len()
}
"#
}

// The four assertion builtins are statement-shaped compiler sugar with no value-returning
// lowering here: each names its own gap now, rather than sharing the generic "closure
// values and compiler-provided calls" refusal every other unbuilt name still falls into.
fn src_assert_family() -> Str {
    #"fn main() {
    let start = 0
    assert(1 == 1)
    assert_eq(1 + 1, 2)
    assert_ne(1, 2)
    debug_assert(1 == 1)
    let _keep = start
}
"#
}

// A wrong-arity call to a plain runtime name. Typecheck does not check the arity of these,
// so this program still type-checks and the backstop this slice adds is what refuses it.
fn src_free_arity_wrong() -> Str {
    #"fn main() {
    let now = time_ms(1)
    let _keep = now
}
"#
}

// A `channel.new` with no buffer. Typecheck refuses it as a missing keyword argument, so the
// probe names that refusal and lowering still has to decline rather than emit a call with no
// capacity: the ctor-arity backstop the other builtin constructors share.
fn src_channel_arity_wrong() -> Str {
    #"fn main() {
    let ch: Channel[Int] = channel.new[Int]()
    let _keep = ch
}
"#
}

test "time_ms reaches the runtime clock with no argument" {
    probe("cg_call_bf_time_ms", src_plain())
    let built = lower_expr(rhs_of("now"))
    assert_shape("shape", built, "CallRuntime")
    assert_eq_str("symbol", ir_c_name(built), "blink_time_ms")
    assert_verifies("time_ms", built)
}

test "a bare exit calls the program's own fn, not the runtime" {
    probe("cg_call_bf_own_exit", src_own_exit())
    let built = lower_expr(rhs_of("_r"))
    assert_shape("shape", built, "CallDirect(VarRef)")
    assert_eq_str("symbol", ir_c_name(built), "blink_u_exit")
    assert_verifies("own exit", built)
}

test "env.exit passes its code to the Env exit slot" {
    probe("cg_call_bf_env_exit", src_own_exit())
    let built = lower_expr(method_call_after("_r", "exit"))
    assert_shape("shape", built, "EffectPerform(FieldGet(EvidenceVector), VarRef)")
    assert_eq_str("slot", ir_c_name(built), "exit_fn")
    assert_verifies("env.exit", built)
}

test "getpid reaches the runtime call with no argument" {
    probe("cg_call_bf_getpid", src_process())
    let built = lower_expr(rhs_of("pid"))
    assert_shape("shape", built, "CallRuntime")
    assert_eq_str("symbol", ir_c_name(built), "blink_getpid")
    assert_verifies("getpid", built)
}

test "StringBuilder.new() reaches the runtime builder constructor" {
    probe("cg_call_bf_sb_bare", src_ctors())
    let built = lower_expr(rhs_of("builder"))
    assert_kind("kind", built, IrKind.CallRuntime)
    assert_shape("shape", built, "CallRuntime")
    assert_eq_str("symbol", ir_c_name(built), "blink_sb_new")
    assert_verifies("StringBuilder bare", built)
}

test "a bare Bytes() reaches the same runtime constructor as Bytes.new()" {
    probe("cg_call_bf_bytes_bare", src_ctors())
    let built = lower_expr(rhs_of("empty"))
    assert_shape("shape", built, "CallRuntime")
    assert_eq_str("symbol", ir_c_name(built), "blink_bytes_new")
    assert_verifies("Bytes bare", built)
}

test "channel.new[T](buffer: n) reaches the runtime channel constructor with its capacity and element size" {
    probe("cg_call_bf_channel_new", src_ctors())
    let built = lower_expr(rhs_of("ch"))
    assert_shape("shape", built, "CallRuntime(Const, Const)")
    assert_eq_str("symbol", ir_c_name(built), "blink_channel_new_sized")
    assert_verifies("channel.new", built)
}

test "a closure value bound to a name is still called through the closure-call path" {
    probe("cg_call_bf_closure_binding", src_closure_arg())
    let built = lower_expr(rhs_of("via_binding"))
    assert_kind("kind", built, IrKind.CallClosure)
    assert_verifies("closure via binding", built)
}

test "an immediately-invoked closure literal is still called through the closure-call path" {
    probe("cg_call_bf_closure_iife", src_closure_arg())
    let built = lower_expr(rhs_of("via_iife"))
    assert_kind("kind", built, IrKind.CallClosure)
    assert_verifies("closure via iife", built)
}

test "a bare Set() builds the runtime constructor with the element's operations table" {
    probe("cg_call_bf_set_bare", src_set_ctor())
    let built = lower_expr(rhs_of("seen"))
    assert_kind("kind", built, IrKind.ContainerNew)
    assert_eq_str("ctor", ir_c_name(built), "blink_set_new")
    if ir_kops_table(built) == "" {
        io.println("FAIL: Set(): built with an empty kops_table")
    }
    assert(ir_kops_table(built) != "")
    assert_verifies("Set() bare", built)
    let mut refusals = 0
    for d in diag_entries {
        let is_stage_gap = d.severity == "ice" && d.name == "CodegenStageNotBuilt"
        let mentions_this_call = d.message.contains("free call") || d.message.contains("Set()")
        if is_stage_gap && mentions_this_call { refusals = refusals + 1 }
    }
    assert_eq(refusals, 0)
}

// Each assertion builtin now names its own gap instead of falling through to the generic
// refusal every other unbuilt free name still shares. The runtime only exposes fail-path
// helpers (the two __blink_assert_fail*_user_msg_at, __blink_debug_assert_fail) that
// imply a conditional built at the call site; composing that conditional from IrKind.If,
// IrKind.ExprStmt and IrKind.CallRuntime is cg_stmt's shape for the statement-position
// form the parser fabricates, not a plain call this stage's one-value-producing contract
// can build alone. This file only covers assert used in expression position, which still
// refuses here.
test "assert names its own gap instead of the generic closure-value refusal" {
    probe("cg_call_bf_assert_family", src_assert_family())
    assert_ice_saying("assert", lower_expr(call_after("start", "assert")),
        "AssertLoweringNotBuilt", "assert has no lowering")
}

test "assert_eq names its own gap instead of the generic closure-value refusal" {
    probe("cg_call_bf_assert_family", src_assert_family())
    assert_ice_saying("assert_eq", lower_expr(call_after("start", "assert_eq")),
        "AssertLoweringNotBuilt", "assert_eq has no lowering")
}

test "assert_ne names its own gap instead of the generic closure-value refusal" {
    probe("cg_call_bf_assert_family", src_assert_family())
    assert_ice_saying("assert_ne", lower_expr(call_after("start", "assert_ne")),
        "AssertLoweringNotBuilt", "assert_ne has no lowering")
}

test "debug_assert names its own gap instead of the generic closure-value refusal" {
    probe("cg_call_bf_assert_family", src_assert_family())
    assert_ice_saying("debug_assert", lower_expr(call_after("start", "debug_assert")),
        "AssertLoweringNotBuilt", "debug_assert has no lowering")
}

test "a wrong-arity plain runtime call refuses rather than emit an uncompilable call" {
    probe("cg_call_bf_time_ms_arity", src_free_arity_wrong())
    assert_ice_saying("time_ms(1)", lower_expr(rhs_of("now")),
        "RuntimeFreeCallArityWrong",
        "`time_ms` takes 0 argument(s), and this call was given 1")
}

test "a channel.new with no buffer refuses through the same ctor-arity backstop" {
    probe_but("cg_call_bf_channel_arity", src_channel_arity_wrong(), "MissingKeywordArg")
    assert_ice_saying("channel.new[Int]()", lower_expr(rhs_of("ch")),
        "RuntimeCtorArityWrong",
        "`channel.new` takes 1 argument(s), and this call was given 0")
}
