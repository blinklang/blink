// Reading one element out of a container.
//
// The runtime slot is one machine word. An element that fits the word travels through that
// word as an integer of the word's own width and is cast home to its own type after. An
// element that is already a pointer is the word's width to begin with and needs no word. An
// element that does not fit, and a double that must not be punned through an integer, live
// behind a pointer instead: the slot holds the address, so the read casts to the pointer
// type and then dereferences it.
//
// Which of the two a read is does not depend on what the element type is. `[i]` answers the
// element and `.get(i)` answers an Option over it, and a container of Option elements makes
// those two answers the same type, so the syntax that was written is what says which.

import lower_test_helpers.{
    probe, rhs_of, assert_kind, assert_eq_str, assert_shape, assert_verifies,
    assert_ice_saying,
}
import ir.{IrKind, ir_c_name, ir_c_spelling, ir_kid, ir_kind, ir_kind_name, ir_node_count}
import cg_expr.{lower_expr, cg_expr_pending_count, cg_expr_take_pending}
import cg_call.{lower_element_read}
import layout.{container_slot_spelling}
import diagnostics.{Diag}
import std.io

fn src_reads() -> Str {
    #"type Point { x: Int, y: Int }

fn main() {
    let at = 0
    let ints = [1, 2, 3]
    let int_read = ints[at]
    let words = ["a", "b"]
    let word_read = words[at]
    let reals = [1.5, 2.5]
    let real_read = reals[at]
    let points = [Point { x: 1, y: 2 }]
    let point_read = points[at]
    let opts = [Some(1), None]
    let opt_read = opts[at]
    let checked = ints.get(at)
    let counted = words.len()
    let _keep = [int_read, real_read.to_int(), point_read.x, opt_read.unwrap()]
    let _keep2 = [word_read.len(), checked.unwrap(), counted]
}
"#
}

// A free type variable is the element type that still refuses. Every refusal a plain
// `xs[i]` over a concrete element could raise has an answer by now, and typecheck already
// holds `[i]` to a List, so the container arm cannot be reached from a program either.
fn src_unbuilt_read() -> Str {
    #"fn first[T](xs: List[T]) -> T {
    let looked = xs[0]
    looked
}

fn main() {
    let _keep = first([1, 2])
}
"#
}

// ── A refusal builds neither operand ─────────────────────────────────────

// The read resolves before it lowers anything, so an element it cannot spell builds no node
// at all. The count is the whole claim: the refused read answers -1 either way, and the
// node count is the only record of the difference. It measures the order, not emitted C.
// A node no answer names is never printed, because the printer reaches a node only through
// the kids of a root it is given; the statements that would reach C go to the pending
// buffer, which lower_expr already takes back on any refusal.
test "a read this stage cannot build lowers neither of its operands" {
    probe("cg_call_orphan", src_unbuilt_read())
    let before = ir_node_count()
    assert_ice_saying("generic element", lower_expr(rhs_of("looked")),
        "UnspellableElementType", "container element has no C layout")
    assert_eq_str("nodes built", "{ir_node_count() - before}", "0")
}

// ── Elements that fit the runtime's word ─────────────────────────────────

test "an Int element takes the word, so the read is a cast off the word and a cast home" {
    probe("cg_call_element", src_reads())
    let id = lower_expr(rhs_of("int_read"))
    assert_kind("kind", id, IrKind.Cast)
    assert_shape("shape", id, "Cast(Cast(CallRuntime(VarRef, VarRef)))")
    assert_eq_str("cast type", ir_c_spelling(id), "int64_t")
    assert_verifies("verify", id)
}

test "a Str element is a pointer that fits the word, so it too is one cast" {
    probe("cg_call_element", src_reads())
    let id = lower_expr(rhs_of("word_read"))
    assert_shape("shape", id, "Cast(CallRuntime(VarRef, VarRef))")
    assert_eq_str("cast type", ir_c_spelling(id), "const char*")
    assert_verifies("verify", id)
}

// The runtime call itself always answers the container's own void* cell -- that is the one
// C signature every container helper shares, whatever element type the caller asked for.
// The two casts above it are what carry the element's own type home; the call node beneath
// them must keep the cell's type, not borrow the element's, because a statement that hoists
// this call into a temp of its own reads this node's own label to declare that temp, and a
// void* returned into a variable declared int64_t is not a conversion C performs on its own.
test "the runtime call under the casts is labelled with the cell it returns, not the element" {
    probe("cg_call_element", src_reads())
    let id = lower_expr(rhs_of("int_read"))
    let raw = ir_kid(ir_kid(id, 0), 0)
    assert_eq_str("kind", ir_kind_name(ir_kind(raw)), "CallRuntime")
    assert_eq_str("call type", ir_c_spelling(raw), container_slot_spelling())
}

// ── Elements the slot holds behind a pointer ─────────────────────────────

// A double punned through the runtime's integer word would come back as a different
// number, so the slot holds its address. The cast names the pointer type layout gives for
// the slot, and the dereference names the element's own type.
test "a Float element is read by casting to the pointer type and dereferencing it" {
    probe("cg_call_element", src_reads())
    let id = lower_expr(rhs_of("real_read"))
    assert_kind("kind", id, IrKind.Unbox)
    assert_shape("shape", id, "Unbox(Cast(CallRuntime(VarRef, VarRef)))")
    assert_eq_str("cast type", ir_c_spelling(ir_kid(id, 0)), "double*")
    assert_eq_str("element type", ir_c_spelling(id), "double")
    assert_verifies("verify", id)
}

// An aggregate cannot fit a word at all, so it takes the same path a double does. The two
// share it because the slot's shape decides, not the element's kind.
test "a struct element is read the same way, through the slot's pointer" {
    probe("cg_call_element", src_reads())
    let id = lower_expr(rhs_of("point_read"))
    assert_kind("kind", id, IrKind.Unbox)
    assert_shape("shape", id, "Unbox(Cast(CallRuntime(VarRef, VarRef)))")
    assert_eq_str("cast type", ir_c_spelling(ir_kid(id, 0)), "blink_Point*")
    assert_eq_str("element type", ir_c_spelling(id), "blink_Point")
    assert_verifies("verify", id)
}

// ── Which read was written ───────────────────────────────────────────────

// `[i]` on a container of Option elements answers an Option, and so does `.get(i)` on a
// container of anything. Reading the answer's type cannot tell them apart, so this read
// must be the plain one: it was written as an index.
test "an index into a container of carriers is a plain read, not a checked one" {
    probe("cg_call_element", src_reads())
    let id = lower_expr(rhs_of("opt_read"))
    assert_kind("kind", id, IrKind.Unbox)
    assert_shape("shape", id, "Unbox(Cast(CallRuntime(VarRef, VarRef)))")
    assert_verifies("verify", id)
}

// `.get(i)` tests the bounds and answers a carrier: the receiver and the index are read
// once, a guard compares the index against the container's own length, and one of two
// arms fills the carrier -- Some with the element the plain read would have answered,
// None with nothing. It is selected by the syntax that was written, the same as the
// plain read above, not by the type either one answers.
fn src_checked() -> Str {
    #"fn main() {
    let ints = [1, 2, 3]
    let at = 0
    let missing = 9
    let neg = 0 - 1
    let in_bounds = ints.get(at)
    let past_end = ints.get(missing)
    let negative = ints.get(neg)
}
"#
}

// What one checked read hoists: however many statements the guard needs, the last of
// them is the `if` that fills the carrier, and the value the caller reads back is a
// VarRef naming it -- exactly the shape lower_element_read's own map-remove sibling
// already builds for a presence test.
type CheckedReadLowered { answer: Int  branch: Int }

fn cc_probe_checked(anchor: Str) -> CheckedReadLowered ! Diag.Report {
    let mark = cg_expr_pending_count()
    let built = lower_element_read(rhs_of(anchor))
    let stmts = cg_expr_take_pending(mark)
    if stmts.len() == 0 {
        io.println("FAIL: '{anchor}' hoisted no statements")
        assert(false)
    }
    CheckedReadLowered { answer: built, branch: stmts.get(stmts.len() - 1).unwrap() }
}

fn checked_arm_value(branch: Int, which: Int) -> Int {
    ir_kid(ir_kid(ir_kid(branch, which), 0), 1)
}

test "an in-bounds index answers a carrier, and the answer is a plain read of it" {
    probe("cg_call_checked_read", src_checked())
    let low = cc_probe_checked("in_bounds")
    assert_shape("answer", low.answer, "VarRef")
    assert_verifies("answer", low.answer)
}

test "the in-bounds arm carries the element as Some" {
    probe("cg_call_checked_read", src_checked())
    let low = cc_probe_checked("in_bounds")
    let some = checked_arm_value(low.branch, 1)
    assert_eq_str("member", ir_c_name(some), "value")
    assert_eq_str("tag", ir_c_name(ir_kid(some, 0)), "1")
}

test "an out-of-bounds index answers the None arm" {
    probe("cg_call_checked_read", src_checked())
    let low = cc_probe_checked("past_end")
    let none = checked_arm_value(low.branch, 2)
    assert_eq_str("member", ir_c_name(none), "")
    assert_eq_str("tag", ir_c_name(ir_kid(none, 0)), "0")
}

// A negative index is never one of the container's own slots, so the guard must be a
// real range test (an index at least zero and below the length), not a check that only
// happens to reject the values a runtime error code would use. Reusing the runtime's own
// blink_list_in_bounds is what keeps this row honest: an index of -1 has to fail that
// call's own range test, not a sign bit this stage guessed at on its own.
test "a negative index answers the None arm, through the same range test" {
    probe("cg_call_checked_read", src_checked())
    let low = cc_probe_checked("negative")
    let none = checked_arm_value(low.branch, 2)
    assert_eq_str("member", ir_c_name(none), "")
    assert_eq_str("tag", ir_c_name(ir_kid(none, 0)), "0")
}

test "the whole checked read, with the statements it hoists, is a well-formed tree" {
    probe("cg_call_checked_read", src_checked())
    let low = cc_probe_checked("in_bounds")
    assert_verifies("branch", low.branch)
    assert_verifies("answer", low.answer)
}

// The seam is reached from two arms of the caller's dispatch and from nowhere else. A node
// that is neither read is a wrong arm, not a shape this stage has yet to build, so it is
// named as the caller's fault and not as a gap here.
test "a node that is neither read is refused as a wrong dispatch, not as a gap" {
    probe("cg_call_element", src_reads())
    assert_ice_saying("not a read", lower_element_read(rhs_of("at")),
        "NotAnElementRead", "is not an element read")
}

// `.get(i)` is the checked read, and no other method is. A seam that took any method call
// for a checked read would answer that refusal for `.len()` too, which names the wrong
// gap: the length of a container is not an element of it.
test "a method that is not the checked read is a wrong dispatch, not a bounds test" {
    probe("cg_call_element", src_reads())
    assert_ice_saying("other method", lower_element_read(rhs_of("counted")),
        "NotAnElementRead", "is not an element read")
}
