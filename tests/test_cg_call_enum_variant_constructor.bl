// A variant constructor written as a call: `Shape.Circle(2)`.
//
// The value is one arm of a tagged union: a tag beside the union member the tag selects,
// and the member is a struct with one field per payload element. The type's own typedef
// emitter lays that shape out, so the constructor reads the same two facts the emitter
// wrote with: the variant node, in declaration order, and the field layout of each
// payload field. Reading either of them a second way here would let a value be built in
// a shape the typedef does not declare.
import lower_test_helpers.{ probe, rhs_of, assert_eq_str, assert_kind, assert_shape,
    assert_verifies }
import cg_expr.{lower_expr}
import cg_call.{cc_enum_variant_construct}
import ir.{ir_c_name, ir_kid, IrKind}
import mono.{run_mono}
import ast.{NodeKind, nk_of}
import parser.{node_fields, node_args, node_name, node_kind, sublist_get, sublist_length}
import layout.{tid_of_node}
import typecheck.{tc_tid_decl_node}

fn src_shapes() -> Str {
    #"type Shape {
    Circle(r: Int)
    Rect(w: Int, h: Int)
    Dot
}

fn main() {
    let ring = Shape.Circle(2)
    let slab = Shape.Rect(3, 4)
    let _keep = [ring, slab]
}
"#
}

// The union member the payload fills is named after the variant, because that is the name
// the typedef gave the member.
test "a variant constructor fills the union member the variant names" {
    probe("enum_ctor_member", src_shapes())
    let built = lower_expr(rhs_of("ring"))
    assert_kind("kind", built, IrKind.EnumNew)
    assert_eq_str("member", ir_c_name(built), "Circle")
}

// The tag is a constant, and its literal is the macro the type's typedef defines. A number
// written here instead would be a second answer to which arm is which.
test "the tag is the macro the type's own typedef defines" {
    probe("enum_ctor_tag", src_shapes())
    let tag = ir_kid(lower_expr(rhs_of("ring")), 0)
    assert_kind("tag kind", tag, IrKind.Const)
    assert_eq_str("tag", ir_c_name(tag), "blink_Shape_Circle_TAG")
}

// Two payload fields travel in declaration order, after the tag.
test "the payload travels in declaration order after the tag" {
    probe("enum_ctor_order", src_shapes())
    assert_shape("rect", lower_expr(rhs_of("slab")), "EnumNew(Const, Const, Const)")
}

// The node is held to its declaration: the tid is the enum, the variant is one the enum
// declares, and the payload count is the variant's arity.
test "a variant constructor verifies against its declaration" {
    probe("enum_ctor_verify", src_shapes())
    assert_verifies("circle", lower_expr(rhs_of("ring")))
    assert_verifies("rect", lower_expr(rhs_of("slab")))
}

fn src_tree() -> Str {
    #"type Tree {
    Leaf(v: Int)
    Node(kid: Tree)
}

fn main() {
    let tip = Tree.Leaf(1)
    let up = Tree.Node(tip)
    let _keep = [tip, up]
}
"#
}

// A field that reaches its own enum is stored by pointer, because the enum's typedef is
// still incomplete where the member is declared. The constructor boxes it, so the value
// written into the member is the shape the member was declared with.
test "a payload that reaches its own enum is boxed" {
    probe("enum_ctor_boxed", src_tree())
    assert_shape("node", lower_expr(rhs_of("up")), "EnumNew(Const, Box(VarRef))")
}

fn src_side() -> Str {
    #"type Side[L, R] {
    Left(l: L)
    Right(r: R)
}

fn main() {
    let picked: Side[Int, Str] = Side.Left(7)
    let _keep = picked
}
"#
}

// A generic enum's tags belong to the instance, not to the generic declaration: two
// instances lay out two typedefs and two sets of macros.
test "a generic enum names the instance's own tag" {
    run_mono(probe("enum_ctor_generic", src_side()))
    let tag = ir_kid(lower_expr(rhs_of("picked")), 0)
    assert_eq_str("tag", ir_c_name(tag), "blink_Side_0Int_0Str_Left_TAG")
}

// A payload may be written by field name, and a name carries its own position: the field it
// names is the field it fills, whatever order the names are written in. The arm is a struct
// whose fields are written in the order they were declared, so a payload built in written
// order would put `h` where `w` is declared and cross the two.
fn src_named() -> Str {
    #"type Crate {
    Box(w: Int, h: Int)
}

fn main() {
    let c = Crate.Box(h: 4, w: 3)
    let _keep = c
}
"#
}

test "a payload written by field name is built in declared order" {
    probe("enum_named", src_named())
    let built = lower_expr(rhs_of("c"))
    assert_shape("arm", built, "EnumNew(Const, Const, Const)")
    assert_eq_str("the w field first", ir_c_name(ir_kid(built, 1)), "3")
    assert_eq_str("then the h field", ir_c_name(ir_kid(built, 2)), "4")
    assert_verifies("arm", built)
}

// The declared field this variant names, walking the enum's own TypeVariant list the way
// cc_variant_node does internally — a struct-style literal will resolve vnode this same
// way, off the enum's declaration, not off a call's written arguments.
fn variant_node(decl: Int, name: Str) -> Int {
    let vars = node_fields(decl)
    if vars == -1 { return -1 }
    let mut i = 0
    while i < sublist_length(vars) {
        let v = sublist_get(vars, i)
        if nk_of(node_kind(v)) == NodeKind.TypeVariant && node_name(v) == name { return v }
        i = i + 1
    }
    -1
}

// cc_enum_variant_construct is the shared core both a call-style constructor and a
// struct-style variant literal build through: the call spelling resolves its own written
// arguments to declared order and hands the values down; the literal spelling (cg_expr,
// not this file) will do the same from its own fields. Calling the entry directly here,
// bypassing cc_enum_variant_call's own argument resolution, pins that the entry alone
// builds the identical EnumNew shape a call-style constructor produces — the two surface
// spellings are meant to converge on exactly this.
test "cc_enum_variant_construct builds the same shape as a call-style constructor" {
    probe("enum_ctor_direct_entry", src_shapes())
    let node = rhs_of("ring")
    let tid = tid_of_node(node)
    let decl = tc_tid_decl_node(tid)
    let vnode = variant_node(decl, "Circle")
    let args = node_args(node)
    let mut values: List[Int] = []
    let mut i = 0
    while i < sublist_length(args) {
        values.push(sublist_get(args, i))
        i = i + 1
    }
    let built = cc_enum_variant_construct(node, tid, vnode, "Shape", "Circle", values)
    assert_kind("kind", built, IrKind.EnumNew)
    assert_eq_str("member", ir_c_name(built), "Circle")
    let tag = ir_kid(built, 0)
    assert_kind("tag kind", tag, IrKind.Const)
    assert_eq_str("tag", ir_c_name(tag), "blink_Shape_Circle_TAG")
    assert_verifies("direct entry", built)
}
