// An `@ffi` binding whose Blink name gives the C name of its symbol has no wrapper, so the
// call names the symbol itself. A `Ptr[T]` passed to its `Ptr[Void]` parameter must still
// cross as `void *` (07 *A `Ptr` at an `@ffi` Call*): the call casts that argument, and only
// that one, to the one spelling layout gives an erased pointer.
import lower_test_helpers.{probe, rhs_of, assert_eq_str, assert_kind, assert_verifies}
import ir.{IrKind, ir_c_spelling, ir_kid, ir_kid_count}
import cg_expr.{lower_expr}
import layout.{erased_pointer_spelling}
import diagnostics.{Diag}

fn src_direct() -> Str {
    #"@ffi("blink_str_count_cps")
@trusted(audit: "CPS")
fn str_count_cps(p: Ptr[Void], n: Int) -> Int ! () {}

@trusted(audit: "CPS")
fn count(c: Ptr[I64]) -> Int {
    let counted = str_count_cps(c, 8)
    counted
}

fn main() {}
"#
}

test "a direct @ffi call casts the coerced Ptr argument to the erased pointer spelling" {
    with handler Diag {} {
        let _ = probe("cg_call_ffi_direct_erase", src_direct())
        let call = lower_expr(rhs_of("counted"))
        assert(call >= 0)
        assert_verifies("counted", call)
        assert_kind("counted", call, IrKind.CallDirect)
        assert_eq(ir_kid_count(call), 2)
        let p = ir_kid(call, 0)
        assert_kind("p", p, IrKind.Cast)
        assert_eq_str("p", ir_c_spelling(p), erased_pointer_spelling())
        let n = ir_kid(call, 1)
        assert(n >= 0)
        assert(ir_c_spelling(n) != erased_pointer_spelling())
    }
}
