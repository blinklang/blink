// io.print_raw and io.eprint_raw write straight to the standard streams. The spec gives
// them no vtable slot, so no handler sees them and no trace records them: each one is a
// direct call to the runtime's default writer, with the value rendered to text first by
// the same seam an interpolation hole uses.

import lower_test_helpers.{probe, let_node_of, assert_kind, assert_eq_str, assert_shape, assert_verifies}
import parser.{node_kind, node_method, nodes}
import ast.{NodeKind, nk_of}
import ir.{IrKind, ir_c_name, ir_kids}
import cg_expr.{lower_expr}
import std.io

// A statement call binds no name, so it is found by walking forward from a binding the
// probe does name: a statement parses after the binding above it, so its node id is higher.
fn call_after(anchor: Str, method: Str) -> Int {
    let mut i = let_node_of(anchor)
    while i < nodes.len() {
        if nk_of(node_kind(i)) == NodeKind.MethodCall && node_method(i) == method { return i }
        i = i + 1
    }
    io.println("FAIL: probe has no call of '{method}' after '{anchor}'")
    assert(false)
    -1
}

fn src_raw() -> Str {
    #"fn main() {
    let count = 4
    io.print_raw("text")
    io.eprint_raw("err")
    io.print_raw(count)
    io.eprint_raw("n={count}")
}
"#
}

test "io.print_raw passes its text to the runtime's default stdout writer" {
    probe("cg_call_raw_print", src_raw())
    let built = lower_expr(call_after("count", "print_raw"))
    assert_kind("kind", built, IrKind.CallRuntime)
    assert_shape("shape", built, "CallRuntime(Const, Const)")
    assert_eq_str("symbol", ir_c_name(built), "blink_io_default_print_no_nl")
    assert_verifies("print_raw", built)
}

test "io.eprint_raw passes its text to the runtime's default stderr writer" {
    probe("cg_call_raw_eprint", src_raw())
    let built = lower_expr(call_after("count", "eprint_raw"))
    assert_kind("kind", built, IrKind.CallRuntime)
    assert_shape("shape", built, "CallRuntime(Const, Const)")
    assert_eq_str("symbol", ir_c_name(built), "blink_io_default_eprint_no_nl")
    assert_verifies("eprint_raw", built)
}

test "io.print_raw renders a non-text value through the formatter first" {
    probe("cg_call_raw_print_int", src_raw())
    let first = call_after("count", "print_raw")
    let built = lower_expr(call_after_node(first, "print_raw"))
    assert_eq_str("symbol", ir_c_name(built), "blink_io_default_print_no_nl")
    let text = ir_kids(built).get(1).unwrap()
    assert_kind("text kind", text, IrKind.CallRuntime)
    assert_eq_str("text symbol", ir_c_name(text), "blink_str_format")
    assert_verifies("print_raw int", built)
}

test "io.eprint_raw passes an interpolation as the one text it formats" {
    probe("cg_call_raw_eprint_interp", src_raw())
    let first = call_after("count", "eprint_raw")
    let built = lower_expr(call_after_node(first, "eprint_raw"))
    assert_eq_str("symbol", ir_c_name(built), "blink_io_default_eprint_no_nl")
    let text = ir_kids(built).get(1).unwrap()
    assert_eq_str("text symbol", ir_c_name(text), "blink_str_format")
    assert_verifies("eprint_raw interp", built)
}

// The second call of a name: the first match's node id bounds the search from below.
fn call_after_node(after: Int, method: Str) -> Int {
    let mut i = after + 1
    while i < nodes.len() {
        if nk_of(node_kind(i)) == NodeKind.MethodCall && node_method(i) == method { return i }
        i = i + 1
    }
    io.println("FAIL: probe has no second call of '{method}'")
    assert(false)
    -1
}
