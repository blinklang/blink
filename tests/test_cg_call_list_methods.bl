// A method call whose receiver is a List.
//
// These tests split the eight List methods the way the lowering does: by what answers the
// call. Three reach a function the standard library declares, two reach a runtime
// primitive, one is a scan built as a loop, two -- get and pop -- are length- or
// bounds-tested reads that hoist their own statements, and one is refused under its own
// name. What each test pins is the symbol the call names, the shape of the built node, and
// for the stores which argument was the element that went into the slot.
import lower_test_helpers.{
    probe, probe_but, rhs_of, let_node_of, assert_eq_str, assert_shape, assert_verifies,
    assert_ice_saying, assert_refused_saying,
}
import parser.{node_kind, node_method, nodes}
import ast.{NodeKind, nk_of}
import ir.{ir_c_name, ir_kid, ir_kid_count, ir_kind, ir_kind_name}
import layout.{layout_take_typedefs}
import cg_expr.{lower_expr, cg_expr_pending_count, cg_expr_take_pending}
import std.io

// Whether anything queued the typedef that a spelling names. The queue is drained here, so
// this is asked once per probe.
fn queued(spelling: Str) -> Str {
    for t in layout_take_typedefs() {
        if t.index_of(spelling) >= 0 { return "queued" }
    }
    "missing"
}

// A call written as a statement binds no name, so it is found by walking forward from the
// binding above it: a statement parses after that binding, so its node id is higher.
fn call_after(anchor: Str, method: Str) -> Int {
    let mut i = let_node_of(anchor)
    while i < nodes.len() {
        if nk_of(node_kind(i)) == NodeKind.MethodCall && node_method(i) == method { return i }
        i = i + 1
    }
    io.println("FAIL: probe has no call of '{method}' after '{anchor}'")
    assert(false)
    -1
}

// The three methods the standard library declares a function for. `append` and `slice`
// are foreign bindings, so each spells the symbol its annotation names; `join` is written
// in Blink and spells the module it was written in.
fn src_declared() -> Str {
    #"fn main() {
    let xs: List[Int] = [1, 2]
    let ys: List[Int] = [3]
    let both = xs.append(ys)
    let part = xs.slice(0, 1)
    let words: List[Str] = ["a", "b"]
    let sentence = words.join(",")
    let _keep = [both.len(), part.len(), sentence.len(), words.len(), ys.len()]
}
"#
}

// An element that fits the word. Nothing is boxed: the value goes in as the slot's own word.
fn src_word_elem() -> Str {
    #"fn main() {
    let mut xs: List[Int] = []
    let n = 5
    xs.push(n)
    xs.set(0, n)
    let _keep = xs.len()
}
"#
}

// An element wider than the word. layout answers PointerBoxed for a struct in a container
// slot, so the value is copied to the heap and the slot holds the pointer.
fn src_boxed_elem() -> Str {
    #"type Point {
    x: Int
    y: Int
}

fn main() {
    let mut pts: List[Point] = []
    let p = Point { x: 1, y: 2 }
    pts.push(p)
    let q = Point { x: 3, y: 4 }
    pts.set(0, q)
    let _keep = pts.len()
}
"#
}

// An element whose C spelling is a carrier typedef. layout spells it, but nothing has
// emitted the typedef that spelling names, so the call would reach C naming a type the
// unit does not declare.
fn src_carrier_elem() -> Str {
    #"fn main() {
    let mut opts: List[Option[Int]] = []
    let o: Option[Int] = Some(1)
    opts.push(o)
    let _keep = opts.len()
}
"#
}

// `join` reads every slot as a string pointer, so the element type decides whether the
// call is buildable at all. Typecheck rejects `List[Int].join` outright, so the only way
// to reach this stage with an element str_join cannot read is through a generic body,
// where typecheck's own check fails open. That is what this probe writes.
fn src_join_int() -> Str {
    #"fn nums[T](xs: List[T]) -> Str {
    let xs_joined = xs.join(",")
    xs_joined
}

fn main() {
    let ints: List[Int] = [1, 2]
    let text = nums(ints)
    let _keep = text.len()
}
"#
}

// `get` and `pop` both answer an Option, which is a carrier filled by statements a guard
// hoists ahead of it -- a bounds test for `get`, a length test for `pop`.
fn src_refused() -> Str {
    #"fn main() {
    let mut xs: List[Int] = [1]
    let g = xs.get(0)
    let p = xs.pop()
    let _keep = [g.is_some(), p.is_some()]
}
"#
}

// A Str is a pointer, so its elements compare through the runtime's byte comparison
// rather than C's `==`, which would compare addresses.
fn src_scan_str_elem() -> Str {
    #"fn main() {
    let words: List[Str] = ["a", "b"]
    let hit = words.contains("a")
    let _keep = hit
}
"#
}

// A word-sized Int is its own whole value, so its elements compare with C's `==`.
fn src_scan_word_elem() -> Str {
    #"fn main() {
    let xs: List[Int] = [1, 2]
    let hit = xs.contains(2)
    let _keep = hit
}
"#
}

// A Float compares through the runtime's total-order equality, which says NaN equals NaN,
// as C's `==` does not.
fn src_scan_float_elem() -> Str {
    #"fn main() {
    let xs: List[Float] = [1.0, 2.0]
    let hit = xs.contains(2.0)
    let _keep = hit
}
"#
}

// A payload-free enum is `Eq` with no derive, and is one ordinal word.
fn src_scan_enum_elem() -> Str {
    #"type Suit { Clubs, Diamonds, Hearts, Spades }

fn main() {
    let suits: List[Suit] = [Suit.Clubs]
    let hit = suits.contains(Suit.Clubs)
    let _keep = hit
}
"#
}

// A struct that derives Eq compares through its derived method. It derives Hash as well,
// so it also carries a key table, and the scan must not read that table: the table is for
// a keyed container's slot, and the element type's own `==` is what `contains` means.
fn src_scan_struct_with_table_elem() -> Str {
    #"@derive(Eq, Hash)
type HashPoint {
    x: Int
    y: Int
}

fn main() {
    let pts: List[HashPoint] = [HashPoint { x: 1, y: 2 }]
    let hit = pts.contains(HashPoint { x: 1, y: 2 })
    let _keep = hit
}
"#
}

// A method written with more arguments than it takes.
fn src_long_push() -> Str {
    #"fn main() {
    let mut xs: List[Int] = []
    xs.push(1, 2)
    let _keep = xs.len()
}
"#
}

test "append names the standard library's list concatenation" {
    probe("lm_app", src_declared())
    let built = lower_expr(rhs_of("both"))
    assert_eq_str("symbol", ir_c_name(built), "blink_list_concat")
    assert_verifies("append", built)
}

test "slice names the standard library's list slice" {
    probe("lm_sl", src_declared())
    let built = lower_expr(rhs_of("part"))
    assert_eq_str("symbol", ir_c_name(built), "blink_list_slice")
    assert_verifies("slice", built)
}

test "join names the string function that joins a list of strings" {
    probe("lm_join", src_declared())
    let built = lower_expr(rhs_of("sentence"))
    assert_eq_str("symbol", ir_c_name(built), "blink_std_str_str_join")
    assert_verifies("join", built)
}

// A word-sized element reaches the same two runtime entry points a boxed one does. It gets
// there differently, by riding the slot's own word rather than by leaving a heap copy
// behind, and that difference is the whole of what separates these two tests from the two
// below. Which symbol each store names does not depend on it.
test "a word-sized element push names the runtime append and leaves nothing on the heap" {
    probe("lm_pw", src_word_elem())
    let built = lower_expr(call_after("n", "push"))
    assert_eq_str("symbol", ir_c_name(built), "blink_list_push")
    assert_shape("shape", built, "CallRuntime(VarRef, Cast(Cast(VarRef)))")
    assert_verifies("push word", built)
}

test "a word-sized element set names the runtime write and leaves nothing on the heap" {
    probe("lm_sw", src_word_elem())
    let built = lower_expr(call_after("n", "set"))
    assert_eq_str("symbol", ir_c_name(built), "blink_list_set")
    assert_shape("shape", built, "CallRuntime(VarRef, Const, Cast(Cast(VarRef)))")
    assert_verifies("set word", built)
}

test "an element wider than the word is boxed before it is pushed" {
    probe("lm_pb", src_boxed_elem())
    let built = lower_expr(call_after("p", "push"))
    assert_eq_str("symbol", ir_c_name(built), "blink_list_push")
    assert_shape("shape", built, "CallRuntime(VarRef, Box(VarRef))")
    assert_verifies("push boxed", built)
}

// `set` writes the element second, not first. Boxing the wrong argument would put the
// index on the heap and hand the runtime a pointer where it reads a position, so which
// argument IS the element is asserted and not assumed.
test "an element wider than the word is boxed before it is set, and the index is not" {
    probe("lm_sb", src_boxed_elem())
    let built = lower_expr(call_after("q", "set"))
    assert_eq_str("symbol", ir_c_name(built), "blink_list_set")
    assert_shape("shape", built, "CallRuntime(VarRef, Const, Box(VarRef))")
    assert_verifies("set boxed", built)
}

// A boxed element is allocated and dereferenced by its own C spelling. For a carrier that
// spelling names a typedef, so the store has to queue it: a call naming a type the unit
// never declares does not compile, and this stage is the only one that knows the element
// went into a slot.
test "a carrier element is boxed and its typedef is queued" {
    probe("lm_pc", src_carrier_elem())
    let built = lower_expr(call_after("o", "push"))
    assert_eq_str("symbol", ir_c_name(built), "blink_list_push")
    assert_shape("shape", built, "CallRuntime(VarRef, Box(VarRef))")
    let pointee = ir_c_name(ir_kid(built, 1))
    assert_eq_str("typedef", queued(pointee), "queued")
    assert_verifies("push carrier", built)
}

test "a join is refused by name unless the element is Str" {
    probe("lm_ji", src_join_int())
    let built = lower_expr(rhs_of("xs_joined"))
    assert_ice_saying("join", built, "JoinElementNotStr", "joining a List of")
}

test "a get answering a carrier is a bounds-tested read, not a refusal" {
    probe("lm_get", src_refused())
    let mark = cg_expr_pending_count()
    let built = lower_expr(rhs_of("g"))
    let stmts = cg_expr_take_pending(mark)
    assert_shape("answer", built, "VarRef")
    assert_verifies("answer", built)
    let guard = stmts.get(2).unwrap()
    assert_eq_str("guard symbol", ir_c_name(ir_kid(guard, 0)), "blink_list_in_bounds")
    let branch = stmts.get(stmts.len() - 1).unwrap()
    let some = ir_kid(ir_kid(ir_kid(branch, 1), 0), 1)
    let payload = ir_kid(some, 1)
    assert_eq_str("some symbol", ir_c_name(ir_kid(ir_kid(payload, 0), 0)), "blink_list_get")
}

// `pop` takes no index, so it hoists one fewer statement than `get`: a length test stands
// in for the bounds test, and the runtime's own blink_list_pop -- which removes the tail
// and answers it, and panics on an empty list the same way blink_list_get panics on an
// out-of-bounds index -- is called only from the Some arm the length test has already
// guarded.
test "a pop answering a carrier is a length-tested read, not a refusal" {
    probe("lm_pop", src_refused())
    let mark = cg_expr_pending_count()
    let built = lower_expr(rhs_of("p"))
    let stmts = cg_expr_take_pending(mark)
    assert_shape("answer", built, "VarRef")
    assert_verifies("answer", built)
    let guard = stmts.get(1).unwrap()
    assert_eq_str("guard symbol", ir_c_name(ir_kid(guard, 0)), "blink_list_len")
    let branch = stmts.get(stmts.len() - 1).unwrap()
    let some = ir_kid(ir_kid(ir_kid(branch, 1), 0), 1)
    let payload = ir_kid(some, 1)
    assert_eq_str("some symbol", ir_c_name(ir_kid(ir_kid(payload, 0), 0)), "blink_list_pop")
}

// The loop `contains` builds hoists every one of its statements ahead of the expression
// that reads its answer, through the same pending-statement mark the two carrier reads
// above hoist through. The loop itself is always the last of them, and the `if` that sets
// the answer and breaks is always the last statement in the loop's own body, whichever of
// the two ways an element travels put anything else in front of either.
fn contains_loop_and_match(stmts: List[Int]) -> Int {
    let scan_loop = stmts.get(stmts.len() - 1).unwrap()
    let body = ir_kid(scan_loop, 0)
    ir_kid(body, ir_kid_count(body) - 1)
}

// The comparison the `if` branches on, as its node kind and the name it carries: the
// operator for a Binary, the function for a call.
fn contains_compare(matched: Int) -> Str {
    let cmp = ir_kid(matched, 0)
    "{ir_kind_name(ir_kind(cmp))} {ir_c_name(cmp)}"
}

test "a contains over Str elements compares bytes, not addresses" {
    probe("lm_cs", src_scan_str_elem())
    let mark = cg_expr_pending_count()
    let built = lower_expr(rhs_of("hit"))
    let stmts = cg_expr_take_pending(mark)
    assert_shape("answer", built, "VarRef")
    assert_eq_str("compare", contains_compare(contains_loop_and_match(stmts)), "CallRuntime blink_str_eq")
    assert_verifies("contains str", built)
}

test "a contains over word-sized elements compares with C's ==" {
    probe("lm_ci", src_scan_word_elem())
    let mark = cg_expr_pending_count()
    let built = lower_expr(rhs_of("hit"))
    let stmts = cg_expr_take_pending(mark)
    assert_shape("answer", built, "VarRef")
    assert_eq_str("compare", contains_compare(contains_loop_and_match(stmts)), "Binary ==")
    assert_verifies("contains word", built)
}

test "a contains over Float elements compares through the total-order equality helper" {
    probe("lm_cf", src_scan_float_elem())
    let mark = cg_expr_pending_count()
    let built = lower_expr(rhs_of("hit"))
    let stmts = cg_expr_take_pending(mark)
    assert_shape("answer", built, "VarRef")
    let matched = contains_loop_and_match(stmts)
    assert_eq_str("helper", ir_c_name(ir_kid(matched, 0)), "blink_float_eq")
    assert_verifies("contains float", built)
}

test "a contains over a payload-free enum compares the ordinal with C's ==" {
    probe("lm_ce", src_scan_enum_elem())
    let mark = cg_expr_pending_count()
    let built = lower_expr(rhs_of("hit"))
    let stmts = cg_expr_take_pending(mark)
    assert_shape("answer", built, "VarRef")
    assert_eq_str("compare", contains_compare(contains_loop_and_match(stmts)), "Binary ==")
    assert_verifies("contains enum", built)
}

test "a contains over a struct that derives Eq calls its derived eq, not its key table" {
    probe("lm_ct", src_scan_struct_with_table_elem())
    let mark = cg_expr_pending_count()
    let built = lower_expr(rhs_of("hit"))
    let stmts = cg_expr_take_pending(mark)
    assert_shape("answer", built, "VarRef")
    let compare = contains_compare(contains_loop_and_match(stmts))
    if !compare.starts_with("CallDirect ") || !compare.contains("HashPoint") || !compare.contains("eq") {
        io.println("FAIL: contains struct compares through '{compare}'")
    }
    assert(compare.starts_with("CallDirect ") && compare.contains("HashPoint") && compare.contains("eq"))
    assert_verifies("contains struct", built)
}

test "a runtime-backed method called with too many arguments is refused by name" {
    probe_but("lm_long", src_long_push(), "TypeError")
    let built = lower_expr(call_after("xs", "push"))
    assert_ice_saying("long", built, "IntrinsicArityWrong", "takes 1 argument(s)")
}
