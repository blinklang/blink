// The net.* and term.* intrinsics the runtime publishes a call for. lower_net_call and
// lower_term_call (src/cg_call.bl) redirect each by method name to the runtime symbol
// c_runtime_helper spells, the same table shape lower_fs_call's fs_redirect_fn_name uses.
//
// `net.write`, `net.close` and `net.set_timeout` answer Void, so they are written as
// statements rather than as the right side of a binding, the same reason
// test_cg_call_list_hof_call.bl's for_each test reaches lower_fn instead of lower_expr.
// `net.write` itself is left out of this file: typecheck records no tid for it in
// statement position today (a separate, already-typed defect upstream of this table), so a
// probe of it would fail on the front end this file does not own.
import lower_test_helpers.{ probe, rhs_of, fn_decl_of, assert_eq_str, ice_count }
import cg_expr.{lower_expr}
import cg_stmt.{lower_fn}
import ir.{ir_c_name}
import mono.{run_mono}
import std.io

fn src_net_reads() -> Str {
    #"fn main() {
    let a = net.connect("localhost", 8080)
    let b = net.listen("localhost", 8080)
    let c = net.accept(b)
    let d = net.read(a, 64)
    let e = net.read_all(a)
    let f = net.read_bytes(a, 64)
    let g = net.write_bytes(a, Bytes.new())
    let _keep = [a, b, c, g]
    let _also = [d, e]
    let _bytes = f
}
"#
}

test "net.connect reaches blink_tcp_connect" {
    run_mono(probe("net_connect", src_net_reads()))
    assert_eq_str("symbol", ir_c_name(lower_expr(rhs_of("a"))), "blink_tcp_connect")
}

test "net.listen reaches blink_tcp_listen" {
    run_mono(probe("net_listen", src_net_reads()))
    assert_eq_str("symbol", ir_c_name(lower_expr(rhs_of("b"))), "blink_tcp_listen")
}

test "net.accept reaches blink_tcp_accept" {
    run_mono(probe("net_accept", src_net_reads()))
    assert_eq_str("symbol", ir_c_name(lower_expr(rhs_of("c"))), "blink_tcp_accept")
}

test "net.read reaches blink_tcp_read" {
    run_mono(probe("net_read", src_net_reads()))
    assert_eq_str("symbol", ir_c_name(lower_expr(rhs_of("d"))), "blink_tcp_read")
}

test "net.read_all reaches blink_tcp_read_all" {
    run_mono(probe("net_read_all", src_net_reads()))
    assert_eq_str("symbol", ir_c_name(lower_expr(rhs_of("e"))), "blink_tcp_read_all")
}

test "net.read_bytes reaches blink_tcp_read_bytes" {
    run_mono(probe("net_read_bytes", src_net_reads()))
    assert_eq_str("symbol", ir_c_name(lower_expr(rhs_of("f"))), "blink_tcp_read_bytes")
}

test "net.write_bytes reaches blink_tcp_write_bytes" {
    run_mono(probe("net_write_bytes", src_net_reads()))
    assert_eq_str("symbol", ir_c_name(lower_expr(rhs_of("g"))), "blink_tcp_write_bytes")
}

fn src_net_close() -> Str {
    #"fn main() {
    let a = net.connect("localhost", 8080)
    net.close(a)
}
"#
}

test "a statement-position net.close reaches blink_tcp_close with no internal error" {
    run_mono(probe("net_close", src_net_close()))
    let before = ice_count()
    let _b = lower_fn(fn_decl_of("main"))
    if ice_count() != before {
        io.println("FAIL: a statement-position net.close recorded an internal error")
        assert(false)
    }
}

fn src_net_set_timeout() -> Str {
    #"fn main() {
    let a = net.connect("localhost", 8080)
    net.set_timeout(a, 1000)
}
"#
}

test "a statement-position net.set_timeout reaches blink_tcp_set_timeout with no internal error" {
    run_mono(probe("net_set_timeout", src_net_set_timeout()))
    let before = ice_count()
    let _b = lower_fn(fn_decl_of("main"))
    if ice_count() != before {
        io.println("FAIL: a statement-position net.set_timeout recorded an internal error")
        assert(false)
    }
}

fn src_term() -> Str {
    #"fn main() {
    let w = term.width()
    let h = term.height()
    let t = term.isatty(1)
    let _keep = [w, h, t]
}
"#
}

test "term.width reaches blink_term_width" {
    run_mono(probe("term_width", src_term()))
    assert_eq_str("symbol", ir_c_name(lower_expr(rhs_of("w"))), "blink_term_width")
}

test "term.height reaches blink_term_height" {
    run_mono(probe("term_height", src_term()))
    assert_eq_str("symbol", ir_c_name(lower_expr(rhs_of("h"))), "blink_term_height")
}

test "term.isatty still reaches blink_term_isatty" {
    run_mono(probe("term_isatty", src_term()))
    assert_eq_str("symbol", ir_c_name(lower_expr(rhs_of("t"))), "blink_term_isatty")
}
