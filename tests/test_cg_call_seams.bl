// The call stage's five seams: a direct call to a free function, an impl method, the
// operator method an Eq comparison desugars to, the Display call an interpolation hole
// needs, the container copy a spread performs, and the container element read that
// `[i]` and `.get(i)` share.

import lower_test_helpers.{
    probe, rhs_of, ident_node_of, assert_kind, assert_eq_str, assert_shape,
    assert_verifies, assert_ice, assert_ice_saying,
}
import ir.{IrKind, ir_c_name, ir_c_spelling, ir_kid}
import cg_call.{
    lower_call, lower_operator_method, lower_display_call, lower_spread, lower_element_read,
}
import parser.{node_elements, sublist_get}

fn src_calls() -> Str {
    #"import std.io

@derive(Eq)
type Point { x: Int, y: Int }

@derive(Eq)
type Tagged { A(n: Int), B(s: Str) }

trait Shown { fn shown(self) -> Int }

impl Shown for Point {
    fn shown(self) -> Int { self.x }
}

fn twice(n: Int) -> Int { n + n }

fn mk() -> fn(Int) -> Int { fn(x: Int) -> Int { x + 1 } }

fn counted() -> Int ! IO { 1 }

fn compare(left: Tagged, right: Tagged) -> Bool {
    let tagged = left == right
    tagged
}

fn effectful() -> Int ! IO {
    let raised = counted()
    let printed = io.println("p")
    let _ignore = printed
    raised
}

fn main() {
    let plain = twice(3)
    let one = Point { x: 1, y: 2 }
    let two = Point { x: 1, y: 3 }
    let viewed = one.shown()
    let adder = fn(k: Int) -> Int { k + 1 }
    let called = adder(2)
    let iife = mk()(41)
    let built = StringBuilder.new()
    let same = one == two
    let differs = one != two
    let nums = [1, 2, 3]
    let at = 1
    let elem = nums[at]
    let maybe = nums.get(at)
    let spread = [..nums, 9]
    let _keep = [plain, viewed, at, elem]
    let _keep2 = [same, differs]
    let _keep3 = [spread.len(), two.y]
    let _keep4 = [maybe]
    let _keep5 = [called, built.len()]
    let _keep6 = [iife]
}
"#
}

fn src_trait_args() -> Str {
    #"type Boxed { n: Int }

trait Holds[T] { fn held(self) -> T }

impl Holds[Int] for Boxed {
    fn held(self) -> Int { self.n }
}

fn main() {
    let boxed = Boxed { n: 1 }
    let holds = boxed.held()
    let _keep = [holds]
}
"#
}

fn src_display() -> Str {
    #"import std.traits

type Wrapped { n: Int }

impl Display for Wrapped {
    fn fmt(self, sb: StringBuilder) { sb.write("w") }
}

fn main() {
    let shown_once = Wrapped { n: 1 }
    let text = "{shown_once}"
    let shouted = io.println("p")
    let _keep = [text]
    let _keep2 = [shouted]
}
"#
}

test "a call to a free function is a direct call on the function's own C name" {
    probe("cg_call_seams", src_calls())
    let id = lower_call(rhs_of("plain"))
    assert_kind("kind", id, IrKind.CallDirect)
    assert_eq_str("symbol", ir_c_name(id), "blink_u_twice")
    assert_shape("shape", id, "CallDirect(Const)")
    assert_verifies("verify", id)
}

test "an impl method call passes the receiver as the first argument" {
    probe("cg_call_seams", src_calls())
    let id = lower_call(rhs_of("viewed"))
    assert_kind("kind", id, IrKind.CallDirect)
    assert_eq_str("symbol", ir_c_name(id), "blink_Point_Shown_shown")
    assert_shape("shape", id, "CallDirect(VarRef)")
    assert_eq_str("receiver", ir_c_name(ir_kid(id, 0)), "one")
    assert_verifies("verify", id)
}

test "a call to an effectful function appends the vector's address as its last argument" {
    probe("cg_call_seams", src_calls())
    let id = lower_call(rhs_of("raised"))
    assert_kind("kind", id, IrKind.CallDirect)
    assert_shape("shape", id, "CallDirect(EvidenceAddress(EvidenceVector))")
    assert_verifies("verify", id)
}

test "a call on a namespace takes the intrinsic route, not the receiver route" {
    probe("cg_call_seams", src_calls())
    let id = lower_call(rhs_of("printed"))
    assert_kind("namespace", id, IrKind.EffectPerform)
    assert_verifies("verify", id)
}

test "a struct equality desugars to the derived eq method over both operands" {
    probe("cg_call_seams", src_calls())
    let node = rhs_of("same")
    let id = lower_operator_method(node, "==")
    assert_kind("kind", id, IrKind.CallDirect)
    assert_eq_str("symbol", ir_c_name(id), "blink_Point_eq")
    assert_shape("shape", id, "CallDirect(VarRef, VarRef)")
    assert_verifies("verify", id)
}

test "a struct inequality negates the same derived eq method" {
    probe("cg_call_seams", src_calls())
    let node = rhs_of("differs")
    let id = lower_operator_method(node, "!=")
    assert_kind("kind", id, IrKind.Unary)
    assert_eq_str("op", ir_c_name(id), "!")
    assert_shape("shape", id, "Unary(CallDirect(VarRef, VarRef))")
    assert_eq_str("symbol", ir_c_name(ir_kid(id, 0)), "blink_Point_eq")
    assert_verifies("verify", id)
}

test "a data enum equality desugars to that enum's own derived eq method" {
    probe("cg_call_seams", src_calls())
    let node = rhs_of("tagged")
    let id = lower_operator_method(node, "==")
    assert_eq_str("symbol", ir_c_name(id), "blink_Tagged_eq")
    assert_verifies("verify", id)
}

test "an ordering operator on a struct operand has no lowering yet" {
    probe("cg_call_seams", src_calls())
    let node = rhs_of("same")
    assert_ice("ord", lower_operator_method(node, "<"), "OrderingMethodNotLowered")
}

test "an interpolation hole calls the sealed display dispatcher of its own impl" {
    probe("cg_call_display", src_display())
    let part = ident_node_of("shown_once")
    let id = lower_display_call(part)
    assert_kind("kind", id, IrKind.CallDirect)
    assert_eq_str("symbol", ir_c_name(id), "blink_Wrapped_Display_display")
    assert_eq_str("type", ir_c_spelling(id), "const char*")
    assert_verifies("verify", id)
}

test "a spread element has no container copy yet" {
    probe("cg_call_seams", src_calls())
    let literal = rhs_of("spread")
    let element = sublist_get(node_elements(literal), 0)
    assert_ice("spread", lower_spread(element, -1), "SpreadCopyNotLowered")
}

test "an element read of the element type casts the slot back through the word it rode" {
    probe("cg_call_seams", src_calls())
    let id = lower_element_read(rhs_of("elem"))
    assert_shape("shape", id, "Cast(Cast(CallRuntime(VarRef, VarRef)))")
    assert_eq_str("symbol", ir_c_name(ir_kid(ir_kid(id, 0), 0)), "blink_list_get")
    assert_eq_str("type", ir_c_spelling(id), "int64_t")
    assert_verifies("verify", id)
}

test "an element read answering Option needs statements this stage cannot hoist" {
    probe("cg_call_seams", src_calls())
    assert_ice("checked", lower_element_read(rhs_of("maybe")),
        "CheckedElementReadNotLowered")
}

test "an impl of a trait with type arguments is not a generic template" {
    probe("cg_call_trait_args", src_trait_args())
    let id = lower_call(rhs_of("holds"))
    assert_kind("kind", id, IrKind.CallDirect)
    assert_shape("shape", id, "CallDirect(VarRef)")
    assert_verifies("verify", id)
}

test "a call on a builtin namespace needs no import to reach the intrinsic stage" {
    probe("cg_call_display", src_display())
    let id = lower_call(rhs_of("shouted"))
    assert_kind("builtin", id, IrKind.EffectPerform)
    assert_verifies("verify", id)
}

test "a call of a closure value is a call form this stage has not built" {
    probe("cg_call_seams", src_calls())
    assert_ice("closure", lower_call(rhs_of("called")), "CodegenStageNotBuilt")
}

test "a call whose callee is itself a call expression is a closure-value callee, not an unbuilt qualified call" {
    probe("cg_call_seams", src_calls())
    assert_ice_saying("iife", lower_call(rhs_of("iife")), "CodegenStageNotBuilt", "closure-value callee")
}

test "a call on a type's own name takes the static route, not the receiver route" {
    probe("cg_call_seams", src_calls())
    let id = lower_call(rhs_of("built"))
    assert_kind("static kind", id, IrKind.CallRuntime)
    assert_eq_str("static symbol", ir_c_name(id), "blink_sb_new")
    assert_verifies("static", id)
}
