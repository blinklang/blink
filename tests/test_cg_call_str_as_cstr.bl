// `Str.as_cstr` is the one Ptr-producing method the spec states outright: a heap copy of
// the string's bytes, made by a runtime call over the receiver and nothing else. No Blink
// declaration answers it and no argument travels beside the receiver, so it lowers the
// same way `scope.cstr` and a Char's `to_str` do: a runtime symbol wrapped around the
// receiver, spelled at the tid the call itself carries.

import lower_test_helpers.{probe, rhs_of, assert_kind, assert_eq_str, assert_shape, assert_verifies}
import ir.{IrKind, ir_c_name, ir_c_spelling, ir_kid}
import cg_call.{lower_call}

fn src_as_cstr() -> Str {
    #"fn main() {
    let s = "hello"
    let raw = s.as_cstr()
}
"#
}

test "s.as_cstr() calls the runtime copy over the receiver, nothing else" {
    probe("cg_call_str_as_cstr", src_as_cstr())
    let id = lower_call(rhs_of("raw"))
    assert_kind("kind", id, IrKind.CallRuntime)
    assert_eq_str("symbol", ir_c_name(id), "blink_strdup")
    assert_shape("shape", id, "CallRuntime(VarRef)")
    assert_eq_str("receiver", ir_c_name(ir_kid(id, 0)), "s")
    assert_verifies("verify", id)
}

test "as_cstr answers a pointer to bytes, which is what its tid says" {
    probe("cg_call_str_as_cstr", src_as_cstr())
    assert_eq_str("spelling", ir_c_spelling(lower_call(rhs_of("raw"))), "uint8_t*")
}
