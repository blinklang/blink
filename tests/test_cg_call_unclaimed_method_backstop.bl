// A method call no arm of inference claimed carries typecheck's stand-down marker in its
// own tid (src/typecheck.bl: tc_unclaimed_call_tid, tc_mark_unclaimed_call), and typecheck
// names the receiver and the method (section 6.3.5), so codegen never runs on such a program.
// The backstop in lower_call stays as an assertion. A call that reaches it is a compiler bug,
// because a stop that only a build reports is a defect (section 6.7), so it is the internal
// error UnresolvedMethodAtCodegen (I0022), and it names the receiver and the method.

import lower_test_helpers.{probe, probe_but, rhs_of, assert_refused_saying, assert_ice_saying, ice_count, last_ice_code}
import cg_call.{lower_call}
import std.io

// `.concat` is a builtin method name (Str and Bytes both declare one), so name resolution
// lets it pass, and List declares no method by that name, so no arm of inference claims it.
// `.append` is what typecheck's own help text points a caller toward instead.
fn src_unclaimed() -> Str {
    #"fn main() {
    let xs: List[Int] = [1]
    let ys = xs.concat([2])
    let _keep = [xs.len()]
}
"#
}

// The same receiver, a method List does declare. Nothing about the guard this test adds
// should ever be reached for a call inference already typed.
fn src_claimed() -> Str {
    #"fn main() {
    let xs: List[Int] = [1]
    let n = xs.len()
    let _keep = [n]
}
"#
}

test "an unclaimed method call is internal error I0022 that names the receiver type and method" {
    let _program = probe_but("cg_call_unclaimed_concat", src_unclaimed(), "UnresolvedMethod")
    let id = lower_call(rhs_of("ys"))
    assert_ice_saying("unclaimed call", id, "UnresolvedMethodAtCodegen", "`.concat` on type List[Int]")
    assert_eq(last_ice_code(), "I0022")
    // The one error is the type check's own; the backstop adds no second one.
    assert_refused_saying("unclaimed call", "unresolved method `.concat` on type List[Int]", 1)
    assert_refused_saying("unclaimed call", "", 1)
}

test "a claimed call is unaffected by the unclaimed-call backstop" {
    let _program = probe("cg_call_claimed_len", src_claimed())
    let id = lower_call(rhs_of("n"))
    if id < 0 { io.println("FAIL: lower_call refused a call inference had already claimed") }
    assert(id >= 0)
    assert_eq(ice_count(), 0)
    assert_refused_saying("claimed call", "unresolved method", 0)
}

// `net` is a builtin namespace; `frobnicate` is neither an intrinsic method nor a name any
// module declares, so no arm of inference claims this call either. The receiver is a
// namespace qualifier, not a value, so it carries no type of its own: naming "the receiver
// type" the way the value-receiver backstop above does would have to read a type that does
// not exist, which is exactly the shape that used to escape as an unrelated, unnamed
// NoTypeForNode ICE instead of a refusal that names the module and the method.
fn src_unclaimed_namespace_method() -> Str {
    #"fn main() {
    let host = "localhost"
    let port = 8080
    let fd = net.frobnicate(host, port)
    let _keep = [fd]
}
"#
}

test "an unclaimed call over a namespace qualifier names the module and method, never the value-receiver ICE" {
    let _program = probe_but("cg_call_unclaimed_net_frobnicate", src_unclaimed_namespace_method(), "UnresolvedMethod")
    let id = lower_call(rhs_of("fd"))
    assert_ice_saying("unclaimed namespace call", id, "UnresolvedMethodAtCodegen", "`frobnicate` on module `net`")
    assert_eq(last_ice_code(), "I0022")
    // The one error is the type check's own; the backstop adds no second one.
    assert_refused_saying("unclaimed namespace call", "no member `frobnicate` on module `net`", 1)
    assert_refused_saying("unclaimed namespace call", "", 1)
}
