// wrapping_add/wrapping_sub/wrapping_mul on a sized int (sections/03_types.md:790-800,870-872).
//
// Signed overflow is undefined behavior in C, so the wrap is computed in the unsigned C
// type at the receiver's own width, where wraparound is well defined, then cast back down
// to the receiver's own type. One row per width and sign pins that both operands travel
// through the unsigned type and the result comes back out as the receiver's own type.

import lower_test_helpers.{probe, probe_but, rhs_of, assert_eq_str, assert_shape, assert_verifies, assert_ice_saying}
import ir.{ir_c_name, ir_c_spelling, ir_kid}
import cg_expr.{lower_expr}

fn src_u8() -> Str {
    #"fn main() {
    let x: U8 = 255
    let y = x.wrapping_add(1)
    let _keep = y
}
"#
}

fn src_i8() -> Str {
    #"fn main() {
    let x: I8 = 127
    let y = x.wrapping_add(1)
    let _keep = y
}
"#
}

fn src_u32_sub() -> Str {
    #"fn main() {
    let x: U32 = 0
    let y = x.wrapping_sub(1)
    let _keep = y
}
"#
}

fn src_i32_mul() -> Str {
    #"fn main() {
    let x: I32 = 2000000000
    let y = x.wrapping_mul(2)
    let _keep = y
}
"#
}

fn src_u16() -> Str {
    #"fn main() {
    let x: U16 = 0
    let y = x.wrapping_sub(1)
    let _keep = y
}
"#
}

fn src_i16() -> Str {
    #"fn main() {
    let x: I16 = 30000
    let y = x.wrapping_add(1)
    let _keep = y
}
"#
}

fn src_u64() -> Str {
    #"fn main() {
    let x: U64 = 0
    let y = x.wrapping_add(1)
    let _keep = y
}
"#
}

fn src_short_call() -> Str {
    #"fn main() {
    let x: U8 = 1
    let y = x.wrapping_add()
    let _keep = y
}
"#
}

// Both operands, and the sum, travel through Cast(...(Binary(Cast, Cast))) - never a bare
// Binary at the receiver's own (possibly signed) width.
test "U8.wrapping_add casts through uint8_t and back to uint8_t" {
    probe("wrap_u8", src_u8())
    let built = lower_expr(rhs_of("y"))
    assert_shape("shape", built, "Cast(Binary(Cast(VarRef), Cast(Const)))")
    assert_eq_str("outer type", ir_c_spelling(built), "uint8_t")
    assert_eq_str("op", ir_c_name(ir_kid(built, 0)), "+")
    assert_verifies("u8", built)
}

test "I8.wrapping_add casts through uint8_t and back to int8_t" {
    probe("wrap_i8", src_i8())
    let built = lower_expr(rhs_of("y"))
    assert_shape("shape", built, "Cast(Binary(Cast(VarRef), Cast(Const)))")
    assert_eq_str("outer type", ir_c_spelling(built), "int8_t")
    assert_verifies("i8", built)
}

test "U32.wrapping_sub casts through uint32_t and back to uint32_t" {
    probe("wrap_u32", src_u32_sub())
    let built = lower_expr(rhs_of("y"))
    assert_shape("shape", built, "Cast(Binary(Cast(VarRef), Cast(Const)))")
    assert_eq_str("outer type", ir_c_spelling(built), "uint32_t")
    assert_eq_str("op", ir_c_name(ir_kid(built, 0)), "-")
    assert_verifies("u32", built)
}

test "I32.wrapping_mul casts through uint32_t and back to int32_t" {
    probe("wrap_i32", src_i32_mul())
    let built = lower_expr(rhs_of("y"))
    assert_shape("shape", built, "Cast(Binary(Cast(VarRef), Cast(Const)))")
    assert_eq_str("outer type", ir_c_spelling(built), "int32_t")
    assert_eq_str("op", ir_c_name(ir_kid(built, 0)), "*")
    assert_verifies("i32", built)
}

test "U16.wrapping_sub casts through uint16_t and back to uint16_t" {
    probe("wrap_u16", src_u16())
    let built = lower_expr(rhs_of("y"))
    assert_shape("shape", built, "Cast(Binary(Cast(VarRef), Cast(Const)))")
    assert_eq_str("outer type", ir_c_spelling(built), "uint16_t")
    assert_eq_str("op", ir_c_name(ir_kid(built, 0)), "-")
    assert_verifies("u16", built)
}

test "I16.wrapping_add casts through uint16_t and back to int16_t" {
    probe("wrap_i16", src_i16())
    let built = lower_expr(rhs_of("y"))
    assert_shape("shape", built, "Cast(Binary(Cast(VarRef), Cast(Const)))")
    assert_eq_str("outer type", ir_c_spelling(built), "int16_t")
    assert_verifies("i16", built)
}

test "U64.wrapping_add casts through uint64_t and back to uint64_t" {
    probe("wrap_u64", src_u64())
    let built = lower_expr(rhs_of("y"))
    assert_shape("shape", built, "Cast(Binary(Cast(VarRef), Cast(Const)))")
    assert_eq_str("outer type", ir_c_spelling(built), "uint64_t")
    assert_verifies("u64", built)
}

test "wrapping_add called with the wrong argument count is refused by name" {
    probe_but("wrap_short", src_short_call(), "TypeError")
    let built = lower_expr(rhs_of("y"))
    assert_ice_saying("short", built, "IntrinsicArityWrong", "takes 1 argument(s)")
}
