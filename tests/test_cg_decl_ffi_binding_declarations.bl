import std.fs
import std.io
import layout.{layout_reset}
import cname.{cname_reset}
import cg_print.{print_reset, print_take}
import cg_reg.{cg_reg_reset, cg_reg_build}
import cg_decl.{cg_decl_reset, cg_decl_emit_fn_decls}
import cg_test_helpers.{cg_probe_compile}

fn assert_has(text: Str, needle: Str) {
    if text.index_of(needle) < 0 {
        io.println("FAIL: output has no '{needle}'\n--- output ---\n{text}")
    }
    assert(text.index_of(needle) >= 0)
}

fn assert_lacks(text: Str, needle: Str) {
    if text.index_of(needle) >= 0 {
        io.println("FAIL: output must not have '{needle}'\n--- output ---\n{text}")
    }
    assert(text.index_of(needle) < 0)
}

fn build_probe(src: Str, name: Str) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS.Delete {
    let path = "build/{name}.bl"
    let program = cg_probe_compile(path, src)
    layout_reset()
    cname_reset()
    let _ = fs.delete(path)
    print_reset()
    cg_reg_reset()
    cg_reg_build(program)
    cg_decl_reset()
    program
}

fn ffi_src() -> Str {
    #"@ffi("blink_bytes_len")
@trusted
fn bytes_len(b: Bytes) -> Int ! FFI {}

@ffi("foreign_thing")
@trusted
fn wrapped(x: Int) -> Int ! FFI {}

@ffi("blink_set_contains")
@trusted
fn set_has[T](s: Set[T], key: Str) -> Int ! FFI {}

fn main() { assert(true) }
"#
}

// A binding whose wrapper would carry the foreign symbol's own name is not a wrapper:
// the call goes straight to the foreign function, and the header that declares it owns
// the prototype. Writing a second prototype from the Blink signature guesses at
// qualifiers the real header has, and C rejects the mismatch.
test "a binding that needs no wrapper is not declared" {
    let _ = build_probe(ffi_src(), "cg_decl_ffi_probe")
    cg_decl_emit_fn_decls()
    let text = print_take()
    assert_lacks(text, "blink_bytes_len(")
    assert_has(text, "int64_t blink_wrapped(int64_t x);")
}

// A foreign symbol has one address, so a binding over it has one wrapper however many
// binders its Blink signature carries. Nothing here is monomorphized: the binders only
// reach types whose C spelling does not depend on them.
test "a generic foreign binding is declared once" {
    let _ = build_probe(ffi_src(), "cg_decl_ffi_generic_probe")
    cg_decl_emit_fn_decls()
    let text = print_take()
    assert_has(text, "int64_t blink_set_has(blink_set* s, const char* key);")
}
