// A module-scope global (`let`/`const`/`pub let` at top level) must not sit as a bare C
// declaration with no initializer: a reader that runs before anything explicitly sets it
// sees garbage. A value the front end already knows at compile time (an int, bool, char,
// float, or plain string literal) goes straight on the definition line. Anything else
// (a struct literal, a call, a container constructor) keeps a bare declaration and is
// assigned once, in declaration order, by a generated init function the shim runs before
// any test or main dispatch. An extern (header) declaration never carries an initializer
// either way.

import std.fs
import std.io
import layout.{layout_reset}
import mono.{run_mono}
import cname.{cname_reset, c_module_init_globals_name}
import cg_test_helpers.{cg_probe_compile, cg_text_occurrences}
import cg.{CgConfig, generate, generate_archive_header, generate_module_header, generate_module_object}
import cg_print.{print_reset, print_take}
import cg_reg.{cg_reg_reset, cg_reg_build, cg_reg_global_decls}
import cg_decl.{cg_decl_reset, cg_decl_emit_globals}

fn build_full_probe(path: Str, src: Str) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS.Delete {
    let program = cg_probe_compile(path, src)
    run_mono(program)
    layout_reset()
    cname_reset()
    let _ = fs.delete(path)
    program
}

fn full_cfg() -> CgConfig {
    CgConfig { debug_mode: 0, trace_codegen: 0, deterministic: 0, emit_only_module: "",
        skip_modules: Map(), user_tu_mode: 0, blink_ev_extern_only: 0, archive_build_mode: 0 }
}

fn assert_has(text: Str, needle: Str) {
    if text.index_of(needle) < 0 {
        io.println("FAIL: output has no '{needle}'\n--- output ---\n{text}")
    }
    assert(text.index_of(needle) >= 0)
}

fn assert_missing(text: Str, needle: Str) {
    if text.index_of(needle) >= 0 {
        io.println("FAIL: output unexpectedly has '{needle}'\n--- output ---\n{text}")
    }
    assert(text.index_of(needle) < 0)
}

fn find_at(text: Str, needle: Str) -> Int {
    let i = text.index_of(needle)
    if i < 0 {
        io.println("FAIL: output has no '{needle}'\n--- output ---\n{text}")
    }
    assert(i >= 0)
    i
}

fn literal_probe_src() -> Str {
    #"const answer: Int = 42
const flag: Bool = true
const grade: Char = 'A'
const ratio: Float = 1.5
const label: Str = "hi"

test "read the literal globals" {
    assert_eq(answer, 42)
    assert(flag)
    assert_eq(grade, 'A')
    assert_eq(ratio, 1.5)
    assert_eq(label, "hi")
}
"#
}

test "an int global gets its literal inlined on the definition line" {
    let program = build_full_probe("build/cg_decl_globals_int.bl", literal_probe_src())
    let text = generate(program, full_cfg())
    assert_has(text, "int64_t answer = 42;")
}

test "a bool global gets its literal inlined on the definition line" {
    let program = build_full_probe("build/cg_decl_globals_bool.bl", literal_probe_src())
    let text = generate(program, full_cfg())
    assert_has(text, "int flag = 1;")
}

test "a char global gets its literal inlined on the definition line" {
    let program = build_full_probe("build/cg_decl_globals_char.bl", literal_probe_src())
    let text = generate(program, full_cfg())
    assert_has(text, "int32_t grade = 65;")
}

test "a float global gets its literal inlined on the definition line" {
    let program = build_full_probe("build/cg_decl_globals_float.bl", literal_probe_src())
    let text = generate(program, full_cfg())
    assert_has(text, "double ratio = 1.5;")
}

test "a string-literal global gets its literal inlined on the definition line" {
    let program = build_full_probe("build/cg_decl_globals_str.bl", literal_probe_src())
    let text = generate(program, full_cfg())
    assert_has(text, #"const char* label = "hi";"#)
}

fn struct_probe_src() -> Str {
    #"type Point { x: Int, y: Int }

let origin: Point = Point { x: 1, y: 2 }

test "read the struct global" {
    assert_eq(origin.x, 1)
    assert_eq(origin.y, 2)
}
"#
}

// A non-constant initializer (here, a struct literal) cannot sit on the definition line
// in C, so the definition stays bare and the value is assigned by the deferred init
// function instead.
test "a struct-literal global keeps a bare declaration, not an inline initializer" {
    let program = build_full_probe("build/cg_decl_globals_struct_decl.bl", struct_probe_src())
    let text = generate(program, full_cfg())
    // A bare `name;` declaration proves the definition line carries no initializer; if
    // one had been folded in, the text at this point would read `name = ...;` instead
    // and this exact needle would not match. The value still has to land somewhere —
    // the two tests below cover that it does, and in the right place.
    let _decl = find_at(text, " origin;")
}

// The deferred value still has to land somewhere: the generated init function's body
// names the global it assigns.
test "a struct-literal global is assigned inside the generated init function" {
    let program = build_full_probe("build/cg_decl_globals_struct_init.bl", struct_probe_src())
    let text = generate(program, full_cfg())
    let start = find_at(text, "__blink_init_globals")
    let after_init = text.substring(start, text.len() - start)
    assert(after_init.contains("origin"))
}

// The shim must run the deferred init function before it hands control to a test or to
// main, or a global a test reads is still unset when the test runs.
test "the deferred init function runs before test dispatch and before main" {
    let program = build_full_probe("build/cg_decl_globals_struct_order.bl", struct_probe_src())
    let text = generate(program, full_cfg())
    let init_call = find_at(text, "__blink_init_globals();")
    let run_tests = find_at(text, "__blink_run_tests(argc")
    assert(init_call < run_tests)
}

fn main_probe_src() -> Str {
    #"type Point { x: Int, y: Int }

let origin: Point = Point { x: 1, y: 2 }

fn main() {
    io.println("{origin.x}")
}
"#
}

test "the deferred init function runs before main when there are no tests" {
    let program = build_full_probe("build/cg_decl_globals_struct_main_order.bl", main_probe_src())
    let text = generate(program, full_cfg())
    let init_call = find_at(text, "__blink_init_globals();")
    let main_call = find_at(text, "blink_main(&__blink_ev);")
    assert(init_call < main_call)
}

// A program with no non-constant global needs no deferred init function at all.
test "no deferred init function is generated when every global is a literal" {
    let program = build_full_probe("build/cg_decl_globals_no_deferred.bl", literal_probe_src())
    let text = generate(program, full_cfg())
    assert_missing(text, "__blink_init_globals")
}

// An extern (header) declaration never carries an initializer, constant or not.
test "the archive header declares every global extern with no initializer" {
    let program = build_full_probe("build/cg_decl_globals_header.bl", literal_probe_src())
    let text = generate_archive_header(program, full_cfg())
    assert_has(text, "extern int64_t answer;")
    assert_missing(text, "answer = 42")
    assert_missing(text, "__blink_init_globals")
}

test "the archive header declares a non-constant global extern with no deferred call" {
    let program = build_full_probe("build/cg_decl_globals_header_struct.bl", struct_probe_src())
    let text = generate_archive_header(program, full_cfg())
    assert_has(text, "extern")
    assert_missing(text, "origin = ")
    assert_missing(text, "__blink_init_globals")
}

// Classification is purely by the lowered IR kind, never by re-inspecting the source
// shape. A negated literal is not const-folded anywhere in this pipeline (no producer
// folds a UnaryOp over a literal into a Const), so it takes the same deferred path as a
// struct literal even though a reader might expect a negative number to be "obviously"
// constant. Nothing here special-cases "looks like a literal" to force it inline.
test "a negated literal is not const-folded, so it defers like any other non-const value" {
    let program = build_full_probe("build/cg_decl_globals_neg.bl", #"const neg: Int = -5

test "read neg" { assert_eq(neg, -5) }
"#)
    let text = generate(program, full_cfg())
    let _decl = find_at(text, " neg;")
    let start = find_at(text, "__blink_init_globals")
    let after_init = text.substring(start, text.len() - start)
    assert(after_init.contains("neg"))
}

fn cross_module_helper_src() -> Str {
    #"pub let helper_base: Int = compute_helper_base()

fn compute_helper_base() -> Int { 10 }
"#
}

fn cross_module_main_src() -> Str {
    #"import cg_decl_globals_cross_helper.{helper_base}

let derived: Int = helper_base + 1

test "cross-module derived value" {
    assert_eq(derived, 11)
}
"#
}

// The deferred-init order is declaration order within a module, and modules in the
// order enumerate_program_modules yields them (first-seen, never re-sorted). An
// imported module is merged ahead of the importing module (merge_programs appends the
// entry module's own declarations last), so a global whose initializer reads an
// imported module's global proves the order rather than assuming it: if the entry
// module's assignment ran first, `derived` would read helper_base before it is set.
//
// A call-initialized global cannot take its value on the declaration line — the call
// itself has to run, which only the init function's own body may do — so both finds
// are scoped to after the init function starts. A looser find_at over the whole text
// would match an inline `= 0` fallback the same as a genuine deferred assignment.
test "a deferred initializer runs in module order: an imported module's global before the importing module's own" {
    let helper_path = "src/cg_decl_globals_cross_helper.bl"
    write_file(helper_path, cross_module_helper_src())
    let program = build_full_probe("build/cg_decl_globals_cross_main.bl", cross_module_main_src())
    let _ = fs.delete(helper_path)
    let text = generate(program, full_cfg())
    assert_missing(text, "int64_t helper_base = ")
    let start = find_at(text, "__blink_init_globals")
    let after_init = text.substring(start, text.len() - start)
    let helper_assign = find_at(after_init, "helper_base = ")
    let derived_assign = find_at(after_init, "derived = ")
    assert(helper_assign < derived_assign)
}

// An empty inits map answers no IrKind.Const for any global, so cg_decl_emit_globals
// must fall back to a bare declaration and no initializer at all, never a type-based
// zero default. This pins the invariant a scalar-zero fallback would otherwise mask.
test "an empty inits map yields a bare declaration and no initializer" {
    let program = build_full_probe("build/cg_decl_globals_empty_inits.bl", literal_probe_src())
    print_reset()
    cg_reg_reset()
    cg_reg_build(program)
    cg_decl_reset()
    let _ = cg_decl_emit_globals(false, cg_reg_global_decls(), Map())
    let text = print_take()
    let _decl = find_at(text, " answer;")
    assert_missing(text, "answer = ")
}

// Each global is registered once (cg_reg_global_decls walks the top-level statement list
// with no de-duplication of its own), so the fix must not emit its initializer twice.
test "a global's initializer is emitted exactly once" {
    let program = build_full_probe("build/cg_decl_globals_once.bl", #"pub let shared: Int = 7

test "read shared" { assert_eq(shared, 7) }
"#)
    let text = generate(program, full_cfg())
    assert_eq(cg_text_occurrences(text, "shared = 7"), 1)
}

// ── Per-module generator ──────────────────────────────────────────────────────
//
// The per-module mode compiles each module to its own object, so the module that
// declares a global is the only one allowed to define it: two objects defining the same
// C symbol is a link error, not a codegen detail. A non-const global's deferred
// assignment can only run from the module that owns it, so that module needs an init
// function callable from outside its own translation unit, declared in its own header
// and called by the entry unit's shim alongside its own.

fn pm_helper_src() -> Str {
    #"pub let helper_const: Int = 5
pub let helper_dynamic: Int = compute_helper_dynamic()

fn compute_helper_dynamic() -> Int { 9 }
"#
}

fn pm_main_src() -> Str {
    #"import cg_decl_globals_pm_helper.{helper_const, helper_dynamic}

let main_dynamic: Int = helper_dynamic + helper_const

test "read them" {
    assert_eq(main_dynamic, 14)
}
"#
}

fn build_pm_probe(entry_path: Str) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS.Delete {
    let helper_path = "src/cg_decl_globals_pm_helper.bl"
    write_file(helper_path, pm_helper_src())
    let program = build_full_probe(entry_path, pm_main_src())
    let _ = fs.delete(helper_path)
    program
}

test "per-module: the entry module's object does not redefine a global another module owns" {
    let program = build_pm_probe("build/cg_decl_globals_pm_main_a.bl")
    let text = generate_module_object(program, "__main__", "_blink_all.h", full_cfg())
    assert_missing(text, "helper_const = 5")
    assert_missing(text, " helper_dynamic;")
}

test "per-module: a non-entry module's own object still inlines its own const global" {
    let program = build_pm_probe("build/cg_decl_globals_pm_main_b.bl")
    let text = generate_module_object(program, "cg_decl_globals_pm_helper", "_blink_all.h", full_cfg())
    assert_has(text, "helper_const = 5")
}

test "per-module: a non-entry module's own non-const global stays a bare declaration in its own object" {
    let program = build_pm_probe("build/cg_decl_globals_pm_main_c.bl")
    let text = generate_module_object(program, "cg_decl_globals_pm_helper", "_blink_all.h", full_cfg())
    let _decl = find_at(text, " helper_dynamic;")
}

test "per-module: a non-entry module's own object defines a non-static init function for its own deferred global" {
    let program = build_pm_probe("build/cg_decl_globals_pm_main_d.bl")
    let text = generate_module_object(program, "cg_decl_globals_pm_helper", "_blink_all.h", full_cfg())
    assert_missing(text, "static void __blink_init_globals_cg_decl_globals_pm_helper")
    let start = find_at(text, "__blink_init_globals_cg_decl_globals_pm_helper(")
    let after = text.substring(start, text.len() - start)
    assert(after.contains("helper_dynamic"))
}

test "per-module: a non-entry module's own header declares its init function's prototype" {
    let program = build_pm_probe("build/cg_decl_globals_pm_main_e.bl")
    let text = generate_module_header(program, "cg_decl_globals_pm_helper", full_cfg())
    let init_fn = c_module_init_globals_name("cg_decl_globals_pm_helper")
    assert_has(text, "void {init_fn}();")
}

test "per-module: the entry module's shim calls the imported module's init function before its own" {
    let program = build_pm_probe("build/cg_decl_globals_pm_main_f.bl")
    let text = generate_module_object(program, "__main__", "_blink_all.h", full_cfg())
    let helper_call = find_at(text, "__blink_init_globals_cg_decl_globals_pm_helper();")
    let main_call = find_at(text, "__blink_init_globals___main__();")
    assert(helper_call < main_call)
}

test "per-module: the shim calls every module's init function before test dispatch" {
    let program = build_pm_probe("build/cg_decl_globals_pm_main_g.bl")
    let text = generate_module_object(program, "__main__", "_blink_all.h", full_cfg())
    let main_call = find_at(text, "__blink_init_globals___main__();")
    let run_tests = find_at(text, "__blink_run_tests(argc")
    assert(main_call < run_tests)
}

test "per-module: no init-fn prototype is declared when every global in that module is a literal" {
    let program = build_full_probe("build/cg_decl_globals_pm_all_const_h.bl", literal_probe_src())
    let text = generate_module_header(program, "__main__", full_cfg())
    assert_missing(text, "__blink_init_globals")
}

test "per-module: no init-fn call is emitted for a module whose globals are all literals" {
    let program = build_full_probe("build/cg_decl_globals_pm_all_const_o.bl", literal_probe_src())
    let text = generate_module_object(program, "__main__", "_blink_all.h", full_cfg())
    assert_missing(text, "__blink_init_globals")
}
