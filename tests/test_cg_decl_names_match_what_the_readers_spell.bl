import std.fs
import std.io
import layout.{layout_reset}
import cname.{c_field_name, c_local_name}
import cg_print.{print_reset, print_take}
import cg_reg.{cg_reg_reset, cg_reg_build}
import cg_decl.{cg_decl_reset, cg_decl_emit_typedefs, cg_decl_emit_fn_decls}
import cg_test_helpers.{cg_probe_compile}

// The names here are chosen to straddle the two reserved-word sets a C name can be
// measured against: `read` and `time` are libc symbols but not C keywords, `asm` is a C
// keyword but not a libc symbol, `default` is both, and `radius` is neither.
fn probe_src() -> Str {
    #"type Odd { read: Int, time: Int, asm: Int, default: Int, radius: Int }
type Ev { Tick(read: Int, asm: Int), Tock }
fn scan(open: Int, radius: Int) -> Int { open + radius }
fn main() {
    let o = Odd { read: 1, time: 2, asm: 3, default: 4, radius: 5 }
    assert(o.read + o.time + o.asm + o.default + o.radius == 15)
    let e: Ev = Ev.Tock
    match e {
        Ev.Tick(a, b) => assert(a == b)
        Ev.Tock => assert(true)
    }
    assert(scan(1, 2) == 3)
}
"#
}

fn emit_text(want_fns: Bool) -> Str ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS.Delete {
    let path = "build/cg_decl_reader_names_probe_src.bl"
    let program = cg_probe_compile(path, probe_src())
    layout_reset()
    let _ = fs.delete(path)
    print_reset()
    cg_reg_reset()
    cg_reg_build(program)
    cg_decl_reset()
    if want_fns { cg_decl_emit_fn_decls() } else { cg_decl_emit_typedefs() }
    print_take()
}

fn assert_has(text: Str, needle: Str) {
    if text.index_of(needle) < 0 {
        io.println("FAIL: output has no '{needle}'\n--- output ---\n{text}")
    }
    assert(text.index_of(needle) >= 0)
}

fn assert_eq_str(label: Str, got: Str, want: Str) {
    if got != want {
        io.println("FAIL: {label}: got '{got}' want '{want}'")
    }
    assert_eq(got, want)
}

// A struct member is written once and read wherever a field access is lowered. The reader
// asks c_field_name for the spelling, so the declaration must ask the same producer: a
// member declared under one answer and read under another is an undeclared identifier in C.
test "a struct member is declared under the name a field read spells" {
    let text = emit_text(false)
    assert_has(text, " {c_field_name(\"read\")};")
    assert_has(text, " {c_field_name(\"time\")};")
    assert_has(text, " {c_field_name(\"asm\")};")
    assert_has(text, " {c_field_name(\"default\")};")
    assert_has(text, " {c_field_name(\"radius\")};")
}

// A variant payload is a struct member of the union arm and is read the same way, so the
// same producer governs it.
test "a variant payload field is declared under the name a field read spells" {
    let text = emit_text(false)
    assert_has(text, " {c_field_name(\"read\")};")
    assert_has(text, " {c_field_name(\"asm\")};")
}

// A parameter is a local inside the body, and the body reads it through c_local_name.
test "a parameter is declared under the name a local read spells" {
    let text = emit_text(true)
    assert_has(text, " {c_local_name(\"open\")},")
    assert_has(text, " {c_local_name(\"radius\")})")
}

// The escape has to move every name C itself owns, keyword or library symbol. `asm` and
// `typeof` are keywords GCC and Clang both take, so a declaration that keeps either
// spelling is not C a compiler accepts.
test "the escape moves a C keyword the libc list does not name" {
    assert_eq_str("asm", c_field_name("asm"), "_blink_asm")
    assert_eq_str("typeof", c_local_name("typeof"), "_blink_typeof")
}

// A name C does not own keeps its Blink spelling, which is what makes the emitted C
// readable next to the source it came from.
test "the escape leaves a name C already accepts alone" {
    assert_eq_str("field", c_field_name("radius"), "radius")
    assert_eq_str("local", c_local_name("radius"), "radius")
}
