import std.fs
import std.io
import layout.{layout_reset}
import cg_test_helpers.{cg_probe_compile, cg_probe_ices_named}
import cname.{c_ev_field_name, c_ev_type_name, c_vtable_type_name}
import cg_print.{print_reset, print_take}
import cg_reg.{cg_reg_reset, cg_reg_build}
import typecheck.{make_handler_type}
import cg_decl.{cg_decl_reset, cg_decl_emit_prologue, cg_decl_emit_epilogue, cg_decl_emit_ev}

fn assert_eq_int(label: Str, got: Int, want: Int) {
    if got != want {
        io.println("FAIL: {label}: got {got} want {want}")
    }
    assert_eq(got, want)
}

fn assert_has(text: Str, needle: Str) {
    if text.index_of(needle) < 0 {
        io.println("FAIL: output has no '{needle}'\n--- output ---\n{text}")
    }
    assert(text.index_of(needle) >= 0)
}

fn assert_lacks(text: Str, needle: Str) {
    if text.index_of(needle) >= 0 {
        io.println("FAIL: output must not have '{needle}'\n--- output ---\n{text}")
    }
    assert(text.index_of(needle) < 0)
}

fn build_probe(src: Str, name: Str) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS.Delete {
    let path = "build/{name}.bl"
    let program = cg_probe_compile(path, src)
    layout_reset()
    let _ = fs.delete(path)
    print_reset()
    cg_reg_reset()
    cg_reg_build(program)
    cg_decl_reset()
    program
}

fn plain_src() -> Str {
    #"fn main() { assert(true) }
"#
}

// A standalone unit owns the runtime outright.
test "a standalone unit includes the runtime header and no archive header" {
    let _ = build_probe(plain_src(), "cg_decl_prologue_plain_probe")
    cg_decl_emit_prologue(false, false, false, "", "")
    let text = print_take()
    assert_has(text, "#include \"runtime.h\"")
    assert_lacks(text, "libblink_std.h")
    assert_lacks(text, "BLINK_USE_EXTERN_RUNTIME_STORAGE")
}

// User code linked against the archive shares the archive's runtime storage rather than
// defining a second copy of it.
test "a unit linked against the archive shares the archive storage" {
    let _ = build_probe(plain_src(), "cg_decl_prologue_user_probe")
    cg_decl_emit_prologue(true, false, false, "", "")
    let text = print_take()
    assert_has(text, "#include \"libblink_std.h\"")
    assert_has(text, "#define BLINK_USE_EXTERN_RUNTIME_STORAGE 1")
    assert_lacks(text, "#define BLINK_RUNTIME_STORAGE_DEFINE 1")
}

test "the archive itself defines the runtime storage" {
    let _ = build_probe(plain_src(), "cg_decl_prologue_archive_probe")
    cg_decl_emit_prologue(false, true, false, "", "")
    let text = print_take()
    assert_has(text, "#define BLINK_RUNTIME_STORAGE_DEFINE 1")
}

// A header is included more than once, so it carries an include guard.
test "a header opens and closes its include guard" {
    let _ = build_probe(plain_src(), "cg_decl_prologue_header_probe")
    cg_decl_emit_prologue(false, false, false, "BLINK_STD_H", "")
    cg_decl_emit_epilogue("BLINK_STD_H")
    let text = print_take()
    assert_has(text, "#ifndef BLINK_STD_H")
    assert_has(text, "#define BLINK_STD_H")
    assert_has(text, "#endif")
}

fn sqlite_src() -> Str {
    #"import std.db_sqlite.{sqlite_open, sqlite_close}
fn main() {
    let h = sqlite_open(":memory:")
    let _ = sqlite_close(h)
}
"#
}

// runtime_sqlite.h declares the sqlite shims and includes <sqlite3.h> only under the
// gate, and the link line pulls in the vendored sqlite only when the unit defines it. The
// runtime header reads it, so it must come before the include.
test "a program that uses std.db_sqlite defines the sqlite gate before the runtime include" {
    let _ = build_probe(sqlite_src(), "cg_decl_prologue_sqlite_probe")
    cg_decl_emit_prologue(false, false, false, "", "")
    let text = print_take()
    let gate = text.index_of("#define BLINK_USE_SQLITE 1\n")
    assert_has(text, "#define BLINK_USE_SQLITE 1\n")
    assert(gate < text.index_of("#include \"runtime.h\""))
}

// Every unit of a program carries every typedef, and a sqlite handle is spelled `sqlite3*`
// in them, so a header and a module object need the gate as much as the entry unit does.
test "a header and a unit linked against the archive both define the sqlite gate" {
    let _ = build_probe(sqlite_src(), "cg_decl_prologue_sqlite_header_probe")
    cg_decl_emit_prologue(false, false, false, "BLINK_MOD_H", "")
    let header = print_take()
    assert(header.index_of("#define BLINK_USE_SQLITE 1\n") > header.index_of("#define BLINK_MOD_H"))
    cg_decl_emit_prologue(true, false, false, "", "")
    let user = print_take()
    assert(user.index_of("#define BLINK_USE_SQLITE 1\n") >= 0)
    assert(user.index_of("#define BLINK_USE_SQLITE 1\n") < user.index_of("#include \"libblink_std.h\""))
}

test "a program that does not use sqlite defines no sqlite gate" {
    let _ = build_probe(plain_src(), "cg_decl_prologue_no_sqlite_probe")
    cg_decl_emit_prologue(false, false, false, "", "")
    assert_lacks(print_take(), "BLINK_USE_SQLITE")
}

// The archive is compiled against a shorter evidence vector than a user unit sees, so the
// builtin fields must stay first and in this order forever.
test "the evidence vector keeps the builtin fields first and in order" {
    let _ = build_probe(plain_src(), "cg_decl_ev_probe")
    cg_decl_emit_ev("")
    let text = print_take()
    let want = ["io", "fs", "net", "crypto", "rand", "time", "env", "process"]
    let mut prev = -1
    for f in want {
        let at = text.index_of("blink_{f}_vtable* {f};")
        if at < 0 { io.println("FAIL: no field '{f}'\n--- output ---\n{text}") }
        assert(at > prev)
        prev = at
    }
    assert_has(text, "} {c_ev_type_name()};")
    assert_has(text, "{c_ev_type_name()} blink_ev_default(void)")
}

// A unit that only refers to the vector declares it and defines no default, so the
// program keeps exactly one definition.
test "a referring unit declares the evidence vector extern" {
    let _ = build_probe(plain_src(), "cg_decl_ev_extern_probe")
    cg_decl_emit_ev("extern ")
    let text = print_take()
    assert_has(text, "extern {c_ev_type_name()} __blink_ev;")
    assert_lacks(text, "blink_ev_default(void)")
}

fn user_effect_src() -> Str {
    #"effect Logger {
    effect Write {
        fn log(msg: Str)
    }
}
fn main() { assert(true) }
"#
}

// A user effect adds a vtable and an evidence field, and this stage writes both. A vector
// missing the field would miscompile every handler for that effect.
test "a user-declared effect reports no unbuilt stage" {
    let _ = build_probe(user_effect_src(), "cg_decl_ev_user_effect_probe")
    cg_decl_emit_ev("")
    assert_eq_int("the probe's own effect reports no unbuilt stage",
        cg_probe_ices_named("CodegenStageNotBuilt"), 0)
}

// The slot a user effect owns. Both names come from cname, which is what the handler
// install reads, so a test that wrote them down here would prove only its own spelling.
fn logger_vtable() -> Str { c_vtable_type_name(make_handler_type("Logger")) }
fn logger_field() -> Str { c_ev_field_name(make_handler_type("Logger")) }

// A handler install writes one field of the vector, so an effect with no field of its own
// has nowhere to install to.
test "a user-declared effect gets a field of its own in the evidence vector" {
    let _ = build_probe(user_effect_src(), "cg_decl_ev_user_field_probe")
    cg_decl_emit_ev("")
    let text = print_take()
    assert_has(text, "{logger_vtable()}* {logger_field()};")
}

// The archive is compiled against a vector that stops after the builtin fields, so a user
// field that moved ahead of one of them would read the archive's slot as its own.
test "a user field sits after every builtin field" {
    let _ = build_probe(user_effect_src(), "cg_decl_ev_user_order_probe")
    cg_decl_emit_ev("")
    let text = print_take()
    let at = text.index_of("{logger_vtable()}* {logger_field()};")
    assert(at >= 0)
    for f in ["io", "fs", "net", "crypto", "rand", "time", "env", "process"] {
        let b = text.index_of("blink_{f}_vtable* {f};")
        assert(b >= 0)
        assert(b < at)
    }
}

// Every field of the vector starts at its default, or an effect nobody handles is read
// through a pointer the program never set.
test "the default vector initializes the user field too" {
    let _ = build_probe(user_effect_src(), "cg_decl_ev_user_default_probe")
    cg_decl_emit_ev("")
    let text = print_take()
    assert_has(text, "ev.{logger_field()} = &{logger_vtable()}_default;")
}
