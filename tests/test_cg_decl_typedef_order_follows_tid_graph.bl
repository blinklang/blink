import std.fs
import std.io
import layout.{layout_reset}
import cg_print.{print_reset, print_take}
import cg_reg.{cg_reg_reset, cg_reg_build}
import cg_decl.{cg_decl_reset, cg_decl_emit_typedefs, cg_decl_emit_ev}
import cg_test_helpers.{cg_probe_compile}

fn assert_eq_int(label: Str, got: Int, want: Int) {
    if got != want {
        io.println("FAIL: {label}: got {got} want {want}")
    }
    assert_eq(got, want)
}

// Holder and Outer are written BEFORE the Leaf they embed, so an emitter that follows
// source order or first-writer-wins puts Leaf last and the C compiler sees an incomplete
// member. Only an order computed from the type graph puts Leaf first.
fn probe_src() -> Str {
    #"type Holder { pair: (Option[Int], Leaf) }
type Outer { inner: Leaf }
type Leaf { n: Int }
fn main() {
    let h: Holder = Holder { pair: (None, Leaf { n: 1 }) }
    let o: Outer = Outer { inner: Leaf { n: 2 } }
    assert(o.inner.n == 2)
    match h.pair.0 {
        Some(v) => assert(v == 0)
        None => assert(true)
    }
}
"#
}

// A handler field holds a pointer to its root effect's vtable, so that typedef is a
// dependency of the embedding struct exactly as a nominal member is. The operation takes a
// struct by value, which makes the graph run through the effect in both directions: Point
// must be complete where the vtable names it, and the vtable must be complete where Env
// names it.
fn handler_field_src() -> Str {
    #"type Point {
    x: Int
    y: Int
}
effect Metrics {
    effect Emit {
        fn at(p: Point)
    }
}
type Env {
    m: Handler[Metrics]
}
fn mk() -> Handler[Metrics] {
    handler Metrics {
        fn at(p: Point) {
            io.println("{p.x},{p.y}")
        }
    }
}
fn main() {
    let e: Env = Env { m: mk() }
    with e.m {
        metrics.at(Point { x: 1, y: 2 })
    }
}
"#
}

// Each enum reaches itself through a tuple payload, directly, nested one tuple deeper, and
// at a generic instance. The field is boxed, but its tuple carrier holds the enum by
// value, so that carrier can only follow the enum's own typedef.
fn selfrec_tuple_src() -> Str {
    #"type Box { Pair(p: (Box, Box)), Leaf(v: Int) }
type Nest { Node(p: (Int, (Nest, Nest))), End(v: Int) }
type Gen[T] { Two(p: (Gen[T], Gen[T])), One(v: T) }
fn main() {
    let b: Box = Box.Pair((Box.Leaf(1), Box.Leaf(2)))
    let n: Nest = Nest.Node((9, (Nest.End(3), Nest.End(4))))
    let g: Gen[Int] = Gen.Two((Gen.One(5), Gen.One(6)))
    match b {
        Box.Pair(p) => assert(true)
        Box.Leaf(v) => assert(v == 0)
    }
    match n {
        Nest.Node(p) => assert(p.0 == 9)
        Nest.End(v) => assert(v == 0)
    }
    match g {
        Gen.Two(p) => assert(true)
        Gen.One(v) => assert(v == 0)
    }
}
"#
}

// The probe is deleted BEFORE any assertion so a red row never leaves the file behind.
fn typedefs_of(name: Str, src: Str) -> Str ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS.Delete {
    let path = "build/{name}.bl"
    let program = cg_probe_compile(path, src)
    layout_reset()
    let _ = fs.delete(path)
    print_reset()
    cg_reg_reset()
    cg_reg_build(program)
    cg_decl_reset()
    cg_decl_emit_typedefs()
    print_take()
}

// The whole declaration half in the order `emit_declarations` writes it: the typedefs, then
// the evidence vector the effect declarations feed. A unit is what a C compiler reads, so a
// typedef written once by the graph walk and once again by the vector is measured here.
fn declaration_half_of(name: Str, src: Str) -> Str ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS.Delete {
    let path = "build/{name}.bl"
    let program = cg_probe_compile(path, src)
    layout_reset()
    let _ = fs.delete(path)
    print_reset()
    cg_reg_reset()
    cg_reg_build(program)
    cg_decl_reset()
    cg_decl_emit_typedefs()
    cg_decl_emit_ev("")
    print_take()
}

fn typedef_text() -> Str ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS.Delete {
    typedefs_of("cg_decl_typedef_order_probe_src", probe_src())
}

fn at(text: Str, needle: Str) -> Int {
    let i = text.index_of(needle)
    if i < 0 {
        io.println("FAIL: typedef output has no '{needle}'")
    }
    assert(i >= 0)
    i
}

fn assert_before(text: Str, first: Str, second: Str) {
    let a = at(text, first)
    let b = at(text, second)
    if a >= b {
        io.println("FAIL: '{first}' at {a} must come before '{second}' at {b}")
    }
    assert(a < b)
}

fn count_of(text: Str, needle: Str) -> Int {
    let mut n = 0
    let mut rest = text
    while true {
        let i = rest.index_of(needle)
        if i < 0 { break }
        n = n + 1
        rest = rest.slice(i + needle.len(), rest.len())
    }
    n
}

// A member's type must be complete where the embedding typedef names it, so the emission
// order is the dependency order of the type graph, not the order the declarations were
// written in.
test "a struct over a tuple over an Option emits its members first" {
    let text = typedef_text()
    assert_before(text, "} blink_Option_int;", "} blink_Tuple2_Option_int_Leaf;")
    assert_before(text, "} blink_Leaf;", "} blink_Tuple2_Option_int_Leaf;")
    assert_before(text, "} blink_Tuple2_Option_int_Leaf;", "} blink_Holder;")
}

// A struct embedding another struct by value follows the same rule, even when the embedded
// declaration is written later in the file.
test "an embedded struct declared later still emits first" {
    let text = typedef_text()
    assert_before(text, "} blink_Leaf;", "} blink_Outer;")
}

// Each typedef is written once, under its guard, however many members reach it.
test "a shared member type is emitted once under one guard" {
    let text = typedef_text()
    assert_eq_int("one Leaf typedef", count_of(text, "} blink_Leaf;"), 1)
    assert_eq_int("one Leaf guard", count_of(text, "#ifndef BLINK_TD_blink_Leaf\n"), 1)
    assert_eq_int("one Holder typedef", count_of(text, "} blink_Holder;"), 1)
}


// A struct field of handler type names the root effect's vtable by pointer, and C must have
// read that typedef where the field names it. The vtable is written by the effect
// declarations, so the graph walk has to reach it from the member the same way it reaches a
// nominal struct.
test "a struct with a handler field emits the effect vtable typedef first" {
    let text = typedefs_of("cg_decl_handler_field_probe_src", handler_field_src())
    assert_before(text, "} blink_ue_metrics_vtable;", "} blink_Env;")
}

// The dependency runs the other way through the operation's signature: a parameter taken by
// value is named inside the vtable typedef, so its own typedef comes first.
test "an operation parameter taken by value is complete where the vtable names it" {
    let text = typedefs_of("cg_decl_handler_param_probe_src", handler_field_src())
    assert_before(text, "} blink_Point;", "} blink_ue_metrics_vtable;")
}

// One vtable typedef per unit, whichever half of the declaration pass reaches the effect
// first. The evidence vector names the same type, and a second typedef of it would be a
// redefinition in the unit that carries both.
test "the declaration half writes one vtable typedef however it is reached" {
    let text = declaration_half_of("cg_decl_handler_unit_probe_src", handler_field_src())
    assert_eq_int("one vtable typedef", count_of(text, "} blink_ue_metrics_vtable;"), 1)
    assert_eq_int("one vtable guard", count_of(text, "#ifndef BLINK_TD_blink_ue_metrics_vtable\n"), 1)
    assert_before(text, "} blink_ue_metrics_vtable;", "} blink_Env;")
}

// A payload field that reaches its own enum is stored boxed, so the enum typedef needs no
// complete carrier. The carrier holds the enum by value, so it is the one that waits.
test "a tuple payload that reaches its own enum follows the enum typedef" {
    let text = typedefs_of("cg_decl_selfrec_tuple_probe_src", selfrec_tuple_src())
    assert_before(text, "} blink_Box;", "} blink_Tuple2_Box_Box;")
}

// The inner tuple embeds the enum by value and the outer tuple embeds the inner one, so
// both carriers wait for the enum.
test "a nested tuple payload that reaches its own enum follows the enum typedef" {
    let text = typedefs_of("cg_decl_selfrec_nested_probe_src", selfrec_tuple_src())
    assert_before(text, "} blink_Nest;", "} blink_Tuple2_Nest_Nest;")
    assert_before(text, "} blink_Tuple2_Nest_Nest;", "} blink_Tuple2_int_Tuple2_Nest_Nest;")
}

// A generic instance follows the same rule at its own tid.
test "a tuple payload that reaches its own generic instance follows that instance" {
    let text = typedefs_of("cg_decl_selfrec_generic_probe_src", selfrec_tuple_src())
    assert_before(text, "} blink_Gen_0Int;", "} blink_Tuple2_Gen_0Int_Gen_0Int;")
    assert_eq_int("one carrier typedef", count_of(text, "} blink_Tuple2_Gen_0Int_Gen_0Int;"), 1)
}
