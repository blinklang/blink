// The C a @derive(Clone) type gets: the value handed in, answered whole. The language
// defines a clone as a logical copy one level deep, and a C assignment of a whole value
// is exactly that copy, so a pointer field is copied as the pointer and the two values
// share what it points at.
//
// That is the one place Clone parts from Eq, Debug and Hash. Those three read what is
// inside each field, so each walks the declared fields and calls the field type's own
// derived method. Clone must not, because a copy that recursed would deep-copy what the
// language says the two values share, and no test of the copy's contents would show it.
//
// So these tests pin the absence of a field walk as hard as they pin the copy: no member
// is named, no tag is switched on, and no nested derived method is called.

import std.io
import layout.{layout_reset}
import cg_print.{print_reset, print_take}
import cg_reg.{cg_reg_reset, cg_reg_build, cg_reg_type_decls}
import cg_derive.{cg_derive_reset, cg_derive_emit_decls, cg_derive_emit_bodies}
import cg_test_helpers.{cg_probe_compile, cg_probe_compile_but, cg_probe_ices_saying, cg_text_occurrences}
import diagnostics.{CODEGEN_STAGE_NOT_BUILT_NAME}

// Four shapes that a field walk would have treated four ways: Point holds two scalars,
// Named holds a pointer beside a scalar, Color has a tag and no payload, and Shape carries
// payloads under two tags. One copy answers all four.
fn clone_src() -> Str {
    #"@derive(Clone)
type Point { x: Int, y: Int }
@derive(Clone)
type Named { name: Str, id: Int }
@derive(Clone)
type Color { Red, Green, Blue }
@derive(Clone)
type Shape {
    Circle(radius: Int)
    Rect(w: Int, h: Int)
}
fn main() { }
"#
}

// Compiling resets the diagnostic counters, so a test that counts what this stage
// records must read the counters after the probe is built, never before it.
fn program_of(stem: Str, src: Str) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck {
    let program = cg_probe_compile("build/{stem}_probe_src.bl", src)
    layout_reset()
    print_reset()
    cg_reg_reset()
    cg_reg_build(program)
    cg_derive_reset()
    program
}

fn bodies_of(stem: Str, src: Str) -> Str ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck {
    let _p = program_of(stem, src)
    cg_derive_emit_bodies(cg_reg_type_decls())
    print_take()
}

// A probe the front end now refuses: typecheck reports the derive, so this stage is
// never asked for a body. The probe still runs, because what it proves is that no body
// is written for the declaration the front end turned away.
fn program_of_but(stem: Str, src: Str, expected: Str) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck {
    let program = cg_probe_compile_but("build/{stem}_probe_src.bl", src, expected)
    layout_reset()
    print_reset()
    cg_reg_reset()
    cg_reg_build(program)
    cg_derive_reset()
    program
}

fn bodies_of_but(stem: Str, src: Str, expected: Str) -> Str ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck {
    let _p = program_of_but(stem, src, expected)
    cg_derive_emit_bodies(cg_reg_type_decls())
    print_take()
}

fn decls_of(stem: Str, src: Str) -> Str ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck {
    let _p = program_of(stem, src)
    cg_derive_emit_decls(cg_reg_type_decls())
    print_take()
}

// How many times the body pass records one named refusal saying one thing, for a probe's
// own file. A count of every internal error would be satisfied by an unrelated refusal in
// the same probe, so a test that names one refusal would pass whether or not it fired.
fn refusals_saying(stem: Str, src: Str, name: Str, marker: Str) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck {
    let _p = program_of(stem, src)
    cg_derive_emit_bodies(cg_reg_type_decls())
    cg_probe_ices_saying(name, marker)
}

fn assert_has(text: Str, needle: Str) {
    if text.index_of(needle) < 0 {
        io.println("FAIL: output has no '{needle}'\n--- output ---\n{text}")
    }
    assert(text.index_of(needle) >= 0)
}

fn assert_lacks(text: Str, needle: Str) {
    if text.index_of(needle) >= 0 {
        io.println("FAIL: output still has '{needle}'\n--- output ---\n{text}")
    }
    assert(text.index_of(needle) < 0)
}

// The C of one function, from its opening line to the brace that closes it in column
// zero. A needle checked against the whole unit would match another function's body.
fn one_fn(text: Str, head: Str) -> Str {
    let start = text.index_of(head)
    if start < 0 { io.println("FAIL: output has no '{head}'\n--- output ---\n{text}") }
    assert(start >= 0)
    let rest = text.substring(start, text.len() - start)
    let end = rest.index_of("\n}")
    assert(end >= 0)
    rest.substring(0, end)
}

test "a derived clone takes its own type and answers its own type" {
    assert_has(bodies_of("cg_derive_clone", clone_src()),
        #"blink_Point blink_Point_clone(blink_Point self) {"#)
}

// One definition per type. A second definition of the same symbol is a duplicate the C
// compiler rejects, and the name stage is the only thing that may choose the spelling.
test "a struct is cloned by exactly one definition of the symbol the name stage chose" {
    let text = bodies_of("cg_derive_clone", clone_src())
    assert_eq(cg_text_occurrences(text, #"blink_Point blink_Point_clone(blink_Point self) {"#), 1)
    assert_eq(cg_text_occurrences(text, #"blink_Named blink_Named_clone(blink_Named self) {"#), 1)
    assert_eq(cg_text_occurrences(text, #"blink_Shape blink_Shape_clone(blink_Shape self) {"#), 1)
}

// The whole value is one copy, so no field is named. A body that named its fields would
// answer the same bytes today and would stop answering them the day a field is added to
// the declaration and missed here.
test "a struct is answered as one copy of the value handed in" {
    let text = one_fn(bodies_of("cg_derive_clone", clone_src()), "blink_Point blink_Point_clone")
    assert_has(text, "return self;")
    assert_lacks(text, "self.x")
    assert_lacks(text, "self.y")
}

// A Str is a pointer and the language says a clone shares what it points at. The member is
// never named, so no helper is called on it and no second string is allocated.
test "a pointer field is copied as the pointer, not through a copying helper" {
    let text = one_fn(bodies_of("cg_derive_clone", clone_src()), "blink_Named blink_Named_clone")
    assert_has(text, "return self;")
    assert_lacks(text, "self.name")
}

// A value layout gives as one word is answered the same way as an aggregate, because the
// copy is written against the whole value either way.
test "a payload-less enum answers its own word instead of reading a member" {
    let text = one_fn(bodies_of("cg_derive_clone", clone_src()), "blink_Color blink_Color_clone")
    assert_has(text, "return self;")
    assert_lacks(text, ".tag =")
}

// One copy carries the tag and the payload together, so the two can never be seen to
// disagree. A body that wrote them as separate statements would leave a value whose tag
// and payload disagree for as long as the writes took.
test "a payload enum carries its tag and its payload in one copy" {
    let text = one_fn(bodies_of("cg_derive_clone", clone_src()), "blink_Shape blink_Shape_clone")
    assert_has(text, "return self;")
    assert_lacks(text, ".tag")
    assert_lacks(text, ".data")
}

// Reading a payload at all means choosing which union member the value holds, and a
// payload read under the wrong variant's tag reads a member the value does not hold. A
// whole-value copy never chooses, so the safe body is the one that switches on nothing.
test "no variant is read through a tag, because no variant is read at all" {
    let text = one_fn(bodies_of("cg_derive_clone", clone_src()), "blink_Shape blink_Shape_clone")
    assert_lacks(text, "blink_Shape_Circle_TAG")
    assert_lacks(text, "blink_Shape_Rect_TAG")
}

// Eq, Debug and Hash each have to panic on a tag no variant declares, because each one
// chooses a payload to read and no choice is right. A copy reads no payload, so it needs
// no such choice and must raise no such panic: a value that is already corrupt is copied
// as it stands, which is what the caller asked for.
test "a copy needs no panic for a tag no variant declares, because it reads no payload" {
    let text = one_fn(bodies_of("cg_derive_clone", clone_src()), "blink_Shape blink_Shape_clone")
    assert_lacks(text, "met a tag no variant declares")
    assert_lacks(text, "__blink_panic_dispatch")
}

test "the declaration pass writes a signature for the clone method and no body" {
    let text = decls_of("cg_derive_clone_decls", clone_src())
    assert_has(text, "blink_Point blink_Point_clone(blink_Point self);")
    assert_lacks(text, "return self;")
}

test "a clone body is no longer refused as unbuilt" {
    assert_eq(refusals_saying("cg_derive_clone_built", clone_src(), CODEGEN_STAGE_NOT_BUILT_NAME,
        "@derive(Clone)"), 0)
}

// A field whose own type derives Clone is the shape where a recursive copy would compile
// and link, because the nested method exists. The language says a clone is one level deep,
// so the copy stays a value copy and the nested method is never called.
fn nested_derive_src() -> Str {
    #"@derive(Clone)
type Inner { v: Int }
@derive(Clone)
type Outer { i: Inner, n: Int }
fn main() { }
"#
}

test "a field whose type also derives Clone is copied, not cloned recursively" {
    let text = one_fn(bodies_of("cg_derive_clone_nested", nested_derive_src()),
        "blink_Outer blink_Outer_clone")
    assert_has(text, "return self;")
    assert_lacks(text, "self.i")
    assert_lacks(text, "blink_Inner_clone(")
}

// Clone does not call the field type's own method, so a field of a generic type is
// copied like any other value. Eq, Debug and Hash have to refuse this shape because they
// would call a body that has one definition per instance and none yet.
fn generic_field_src() -> Str {
    #"type Box[T] { v: T }
@derive(Clone)
type Holder { b: Box[Int], n: Int }
fn main() { }
"#
}

test "a field of a generic type is copied rather than refused" {
    assert_eq(refusals_saying("cg_derive_clone_generic", generic_field_src(),
        CODEGEN_STAGE_NOT_BUILT_NAME, "@derive(Clone)"), 0)
    assert_eq(cg_text_occurrences(bodies_of("cg_derive_clone_generic", generic_field_src()),
        #"blink_Holder blink_Holder_clone(blink_Holder self) {"#), 1)
    let text = one_fn(bodies_of("cg_derive_clone_generic", generic_field_src()),
        "blink_Holder_clone")
    assert_has(text, "return self;")
    assert_lacks(text, "self.b")
}

// An @ffi.opaque handle is a pointer to a body this compiler cannot see. It exposes no
// fields, so a field walk over it answers a value with nothing copied into it.
fn opaque_src() -> Str {
    #"@derive(Clone)
@ffi.opaque(header: "stdio.h", name: "FILE")
type CFile
fn main() { }
"#
}

test "an opaque handle is refused, not answered as a value with nothing copied" {
    assert_lacks(bodies_of_but("cg_derive_clone_opaque", opaque_src(), "NonDerivableTrait"), "_clone")
}

// A field that reaches its own enum is stored as an opaque word holding a heap pointer.
// Eq, Debug and Hash have to refuse that word, because each of them answers from what is
// behind it and this stage does not walk a pointer. A clone never looks behind it, and a
// whole-value copy never even names the field, so the shape is answered like any other.
fn recursive_field_src() -> Str {
    #"@derive(Clone)
type Tree {
    Leaf
    Node(v: Int, next: Tree)
}
fn main() { }
"#
}

test "a type holding a field that reaches itself is cloned, not refused" {
    assert_eq(refusals_saying("cg_derive_clone_boxed", recursive_field_src(),
        CODEGEN_STAGE_NOT_BUILT_NAME, "@derive(Clone)"), 0)
    let text = one_fn(bodies_of("cg_derive_clone_boxed", recursive_field_src()),
        "blink_Tree blink_Tree_clone")
    assert_has(text, "return self;")
    assert_lacks(text, "self.data.Node.next")
}

// An enum with one variant that carries a payload and one that carries none. A body that
// built its answer member by member would write nothing at all under the variant with no
// payload, and would answer bytes no statement had written. Copying the whole value is
// what removes that hole, so the test pins that the answer is the value handed in and not
// a local this stage filled in.
fn mixed_enum_src() -> Str {
    #"@derive(Clone)
type Maybe {
    Nothing
    Just(v: Int)
}
fn main() { }
"#
}

test "the value a clone answers is the value handed in, not a local this stage filled" {
    let text = one_fn(bodies_of("cg_derive_clone_mixed", mixed_enum_src()),
        "blink_Maybe blink_Maybe_clone")
    assert_has(text, "return self;")
    assert_lacks(text, #"= {0};"#)
    assert_lacks(text, ".tag")
    assert_lacks(text, ".data")
}

// A transparent newtype is a bare word, so the word is the whole value and there is no
// member to copy.
fn newtype_src() -> Str {
    #"@derive(Clone)
type Errno { Errno(Int) }
fn main() { }
"#
}

test "a transparent newtype answers its word instead of building a value" {
    let text = one_fn(bodies_of("cg_derive_clone_newtype", newtype_src()), "blink_Errno_clone")
    assert_has(text, "return self;")
    assert_lacks(text, "self.tag")
    assert_lacks(text, "self.data")
}
