// The C a @derive(Eq) type gets: one comparison per declared field, read off the
// declared shape and spelled by layout. A field kind this stage cannot compare is an
// internal error, not a skipped field: skipping one makes two unequal values answer
// equal, which is a wrong answer that compiles cleanly.

import std.io
import typecheck.{tc_type_decl_nodes}
import layout.{layout_reset, decl_derive_args, tid_is_opaque_handle}
import cname.{cname_mark_transparent_newtype}
import ast.{NodeKind, nk_of}
import cg_print.{print_reset, print_take}
import cg_reg.{cg_reg_reset, cg_reg_build, cg_reg_tid_for_decl, cg_reg_type_decls}
import cg_derive.{cg_derive_reset, cg_derive_emit_decls, cg_derive_emit_bodies}
import cg_promote.{cg_promote_reset}
import cg_test_helpers.{cg_probe_compile, cg_probe_compile_but, cg_probe_ices_saying}
import parser.{node_name, nodes, node_kind, node_source_module}
import diagnostics.{diag_entries, CODEGEN_STAGE_NOT_BUILT_NAME}

// The transparent-newtype mark is scoped to lib/std, so a probe that declares its own
// newtype sets the mark by hand to reach the lowering under test.
fn mark_probe_errno() {
    let mut i = 0
    while i < nodes.len() {
        if nk_of(node_kind(i)) == NodeKind.TypeDef && node_name(i) == "Errno" && node_source_module(i) == "__main__" {
            cname_mark_transparent_newtype(i)
        }
        i = i + 1
    }
}

// Point is compared by two scalars, Named by a string and a scalar, Pair by a nested
// derived type and a bool, Color rides its tag alone, and Shape carries payloads.
fn eq_src() -> Str {
    #"@derive(Eq)
type Point { x: Int, y: Int }
@derive(Eq)
type Named { name: Str, id: Int }
@derive(Eq)
type Pair { p: Point, flag: Bool }
@derive(Eq)
type Color { Red, Green, Blue }
@derive(Eq)
type Shape {
    Circle(radius: Int)
    Rect(w: Int, h: Int)
}
fn main() { }
"#
}

// Compiling resets the diagnostic counters, so a test that counts what this stage
// records must read the counters after the probe is built, never before it. The on-demand
// function table is reset as each unit's is: a symbol one probe wrote is not in the next.
fn program_of(stem: Str, src: Str) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck {
    let program = cg_probe_compile("build/{stem}_probe_src.bl", src)
    layout_reset()
    mark_probe_errno()
    print_reset()
    cg_reg_reset()
    cg_reg_build(program)
    cg_derive_reset()
    cg_promote_reset()
    program
}

fn bodies_of(stem: Str, src: Str) -> Str ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck {
    let _p = program_of(stem, src)
    cg_derive_emit_bodies(cg_reg_type_decls())
    print_take()
}

// A probe the front end now refuses: typecheck reports the derive, so this stage is
// never asked for a body. The probe still runs, because what it proves is that no body
// is written for the declaration the front end turned away.
fn program_of_but(stem: Str, src: Str, expected: Str) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck {
    let program = cg_probe_compile_but("build/{stem}_probe_src.bl", src, expected)
    layout_reset()
    mark_probe_errno()
    print_reset()
    cg_reg_reset()
    cg_reg_build(program)
    cg_derive_reset()
    cg_promote_reset()
    program
}

fn bodies_of_but(stem: Str, src: Str, expected: Str) -> Str ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck {
    let _p = program_of_but(stem, src, expected)
    cg_derive_emit_bodies(cg_reg_type_decls())
    print_take()
}

fn decls_of(stem: Str, src: Str) -> Str ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck {
    let _p = program_of(stem, src)
    cg_derive_emit_decls(cg_reg_type_decls())
    print_take()
}

// How many times the body pass records one named refusal saying one thing, for a probe's
// own file. A count of every internal error would be satisfied by an unrelated refusal in
// the same probe, so a test that names one refusal would pass whether or not it fired.
fn refusals_saying(stem: Str, src: Str, name: Str, marker: Str) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck {
    let _p = program_of(stem, src)
    cg_derive_emit_bodies(cg_reg_type_decls())
    cg_probe_ices_saying(name, marker)
}

fn assert_has(text: Str, needle: Str) {
    if text.index_of(needle) < 0 {
        io.println("FAIL: output has no '{needle}'\n--- output ---\n{text}")
    }
    assert(text.index_of(needle) >= 0)
}

fn assert_lacks(text: Str, needle: Str) {
    if text.index_of(needle) >= 0 {
        io.println("FAIL: output still has '{needle}'\n--- output ---\n{text}")
    }
    assert(text.index_of(needle) < 0)
}

// The C of one function, from its opening line to the brace that closes it in column
// zero. A needle checked against the whole unit would match another function's body.
fn one_fn(text: Str, head: Str) -> Str {
    let start = text.index_of(head)
    if start < 0 { io.println("FAIL: output has no '{head}'\n--- output ---\n{text}") }
    assert(start >= 0)
    let rest = text.substring(start, text.len() - start)
    let end = rest.index_of("\n}")
    assert(end >= 0)
    rest.substring(0, end)
}

test "a derived eq takes two values of its own type and answers an int" {
    assert_has(bodies_of("cg_derive_eq", eq_src()), #"int blink_Point_eq(blink_Point self, blink_Point other) {"#)
}

test "a scalar field is compared with the C inequality operator" {
    let text = one_fn(bodies_of("cg_derive_eq", eq_src()), "int blink_Point_eq")
    assert_has(text, #"if (self.x != other.x) {"#)
    assert_has(text, #"if (self.y != other.y) {"#)
    assert_has(text, "return 0;")
    assert_has(text, "return 1;")
}

// A Str is a pointer, so == would compare addresses. The runtime helper compares bytes.
test "a string field is compared through the runtime helper" {
    assert_has(bodies_of("cg_derive_eq", eq_src()), #"if (!blink_str_eq(self.name, other.name)) {"#)
}

test "a bool field is compared with the inequality operator" {
    assert_has(bodies_of("cg_derive_eq", eq_src()), #"if (self.flag != other.flag) {"#)
}

// The language gives a Float a total equality: NaN equals NaN, and -0.0 equals 0.0. C's
// != answers true for two NaNs, so the operator every other scalar uses would report that
// a value differs from itself. The runtime helper answers the equality the language names.
fn float_field_src() -> Str {
    #"@derive(Eq)
type Reading { v: Float }
fn main() { }
"#
}

test "a Float field is compared through the runtime helper, not by an operator that reports a NaN differs from itself" {
    let text = one_fn(bodies_of("cg_derive_eq_float", float_field_src()), "int blink_Reading_eq")
    assert_has(text, #"if (!blink_float_eq(self.v, other.v)) {"#)
    assert_lacks(text, "self.v != other.v")
}

// A payload reaches the same field walk as a struct member, so a Float in a variant is
// compared by the helper too.
fn float_payload_src() -> Str {
    #"@derive(Eq)
type Sample {
    Empty
    Reading(v: Float)
}
fn main() { }
"#
}

test "a Float in an enum payload is compared through the runtime helper" {
    let text = one_fn(bodies_of("cg_derive_eq_float_payload", float_payload_src()),
        "int blink_Sample_eq")
    assert_has(text, "blink_float_eq(self.data.Reading.v, other.data.Reading.v)")
    assert_lacks(text, "self.data.Reading.v != other.data.Reading.v")
}

// A nested type that derives Eq itself is compared by calling its derived method, so
// the comparison stays one call deep however far the nesting goes.
test "a nested derived field is compared by calling the nested derived method" {
    assert_has(bodies_of("cg_derive_eq", eq_src()), #"if (!blink_Point_eq(self.p, other.p)) {"#)
}

// A payload-less enum is a C enum, so the ordinal is the whole value.
test "a payload-less enum compares its whole value" {
    let text = one_fn(bodies_of("cg_derive_eq", eq_src()), "int blink_Color_eq")
    assert_has(text, #"int blink_Color_eq(blink_Color self, blink_Color other) {"#)
    assert_has(text, "return (self == other);")
    assert_lacks(text, "self.tag")
}

// A payload enum must agree on the variant before it reads a payload: reading the union
// through the wrong variant is undefined.
test "a payload enum compares the tag first, then the payload of the shared variant" {
    let text = one_fn(bodies_of("cg_derive_eq", eq_src()), "int blink_Shape_eq")
    assert_has(text, #"if (self.tag != other.tag) {"#)
    assert_has(text, "blink_Shape_Circle_TAG")
    assert_has(text, #"if (self.data.Circle.radius != other.data.Circle.radius) {"#)
    assert_has(text, #"if (self.data.Rect.w != other.data.Rect.w) {"#)
    assert_has(text, #"if (self.data.Rect.h != other.data.Rect.h) {"#)
}

// The declaration pass writes signatures only. The driver runs it before the body
// pass so a type declared after the type that compares it is still declared first.
test "the declaration pass writes a signature for every derived method and no body" {
    let text = decls_of("cg_derive_eq_decls", eq_src())
    assert_has(text, "int blink_Point_eq(blink_Point self, blink_Point other);")
    assert_has(text, "int blink_Shape_eq(blink_Shape self, blink_Shape other);")
    assert_lacks(text, "return 1;")
}

fn unknown_src() -> Str {
    #"@derive(Eqq)
type Thing { x: Int }
fn main() { }
"#
}

// The name is rejected while the types are checked, so the row measures the whole of
// diag_entries rather than a window opened after the front end.
test "a derive name the compiler does not know is an error, not a silent skip" {
    let _p = cg_probe_compile_but("build/cg_derive_unknown_probe_src.bl", unknown_src(), "UnknownDerive")
    let mut found = ""
    let mut i = 0
    while i < diag_entries.len() {
        let d = diag_entries.get(i).unwrap()
        if d.code == "E1112" { found = d.name }
        i = i + 1
    }
    assert_eq(found, "UnknownDerive")
}

fn unbuilt_src() -> Str {
    #"import std.json
@derive(Deserialize)
type Rec { xs: Option[Int] }
fn main() { }
"#
}

// A derive this stage has not built reports an internal error. A body it wrote by
// guessing would compile and then answer wrongly at run time.
test "a derive this stage has not built reports an internal error" {
    assert_eq(refusals_saying("cg_derive_unbuilt", unbuilt_src(), CODEGEN_STAGE_NOT_BUILT_NAME,
        "@derive(Deserialize) on field `xs` of kind Option"), 1)
}

// A Ptr's equality is its address (sections/07_trust_modules_metadata.md), so the word
// comparison every scalar uses is the value comparison here.
fn unsupported_field_src() -> Str {
    #"@derive(Eq)
type Handle { raw: Ptr[U8] }
fn main() { }
"#
}

test "a Ptr field is compared by address with the inequality operator, not refused" {
    assert_eq(refusals_saying("cg_derive_unsupported", unsupported_field_src(), CODEGEN_STAGE_NOT_BUILT_NAME,
        "@derive(Eq)"), 0)
    let text = one_fn(bodies_of("cg_derive_unsupported", unsupported_field_src()), "int blink_Handle_eq")
    assert_has(text, #"if (self.raw != other.raw) {"#)
}

// A container, carrier or tuple field compares by Container Equality, through the same
// comparison `==` calls. That comparison is printed on demand, so it must be in the unit
// before the derived body that calls it.
fn container_field_src() -> Str {
    #"@derive(Eq)
type Bag {
    names: List[Str]
    counts: Map[Str, Int]
    seen: Set[Int]
    label: Option[Str]
    outcome: Result[Int, Str]
    pair: (Int, Str)
}
fn main() { }
"#
}

test "a container field calls the comparison == uses, printed before the derived body" {
    assert_eq(refusals_saying("cg_derive_container", container_field_src(), CODEGEN_STAGE_NOT_BUILT_NAME,
        "@derive(Eq)"), 0)
    let text = bodies_of("cg_derive_container", container_field_src())
    let body = one_fn(text, "int blink_Bag_eq(")
    assert_has(body, "(self.names, other.names)")
    assert_has(body, "(self.counts, other.counts)")
    assert_has(body, "(self.seen, other.seen)")
    assert_has(body, "(self.label, other.label)")
    assert_has(body, "(self.outcome, other.outcome)")
    assert_has(body, "(self.pair, other.pair)")
    let first_helper = text.index_of("blink_eq_")
    assert(first_helper >= 0)
    assert(first_helper < text.index_of("int blink_Bag_eq("))
}

// A field whose type implements Eq by hand compares through that impl, the method `==`
// on two of those values would call.
fn hand_eq_field_src() -> Str {
    #"type Celsius { deg: Int }
impl Eq for Celsius {
    fn eq(self, other: Celsius) -> Bool { self.deg / 10 == other.deg / 10 }
}
@derive(Eq)
type Room { t: Celsius }
fn main() { }
"#
}

test "a field whose type implements Eq by hand calls that impl" {
    assert_eq(refusals_saying("cg_derive_hand_eq", hand_eq_field_src(), CODEGEN_STAGE_NOT_BUILT_NAME,
        "implements Eq by hand"), 0)
    let body = one_fn(bodies_of("cg_derive_hand_eq", hand_eq_field_src()), "int blink_Room_eq(")
    assert_has(body, "(self.t, other.t)")
}

// layout.bl owns the one reader of the @derive annotation, so the derive stage and
// layout's own kops question ask the same nodes.
test "the derive annotation reader answers every name written on a declaration" {
    let program = program_of("cg_derive_reader", eq_src())
    assert(program >= 0)
    let names = derive_names_of(find_type_decl("Point"))
    assert_eq(names.len(), 1)
    assert_eq(names.get(0).unwrap(), "Eq")
    assert_eq(derive_names_of(find_type_decl("Shape")).len(), 1)
}

fn find_type_decl(name: Str) -> Int {
    let td = tc_type_decl_nodes.get(name) ?? -1
    if td < 0 { io.println("FAIL: probe has no type '{name}'") }
    assert(td >= 0)
    td
}

fn derive_names_of(decl: Int) -> List[Str] {
    let mut out: List[Str] = []
    for a in decl_derive_args(decl) { out.push(node_name(a)) }
    out
}

// An @ffi.opaque handle is a pointer to a body this compiler cannot see. It has no
// fields, so a field walk over it answers "every field agreed" and two distinct
// handles compare equal.
fn opaque_src() -> Str {
    #"@derive(Eq)
@ffi.opaque(header: "stdio.h", name: "FILE")
type CFile
fn main() { }
"#
}

test "an opaque handle is refused, not compared as always equal" {
    // The prelude derives too (Instant, Duration), so the needle names this probe's type.
    assert_lacks(bodies_of_but("cg_derive_opaque", opaque_src(), "NonDerivableTrait"), "CFile")
}

// A transparent newtype is a bare word, so its parameter has no tag member to read.
fn newtype_src() -> Str {
    #"@derive(Eq)
type Errno { Errno(Int) }
fn main() { }
"#
}

test "a transparent newtype compares its word instead of reading a tag" {
    let text = bodies_of("cg_derive_newtype", newtype_src())
    assert_has(text, "return (self == other);")
    assert_lacks(text, "self.tag")
    assert_lacks(text, "self.data")
}

// A generic type gets one body per instance, named from the instance's typedef, so a
// field of one calls that instance's body and never a name the declaration would spell.
fn generic_field_src() -> Str {
    #"@derive(Eq)
type Box[T] { v: T }
@derive(Eq)
type Holder { b: Box[Int], n: Int }
fn main() { }
"#
}

test "a field of a generic type calls the body its instance gets" {
    assert_eq(refusals_saying("cg_derive_generic_field", generic_field_src(), CODEGEN_STAGE_NOT_BUILT_NAME, "generic"), 0)
    let text = bodies_of("cg_derive_generic_field", generic_field_src())
    assert_has(text, "blink_Box_0Int_eq(self.b, other.b)")
    assert_lacks(text, "blink_Box_eq(")
}

// A field that reaches its own enum is stored as an opaque word holding a heap pointer.
// Comparing two of those words compares two addresses, which answers false for two values
// that are equal. Every derive that reads what is inside a field meets this, so the refusal
// belongs to the shared field reader and is pinned here for all three.
fn boxed_field_src() -> Str {
    #"@derive(Eq)
type Tree {
    Leaf
    Node(v: Int, next: Tree)
}
fn main() { }
"#
}

test "a field held as a boxed word is refused, not compared as two addresses" {
    assert_eq(refusals_saying("cg_derive_eq_boxed", boxed_field_src(), CODEGEN_STAGE_NOT_BUILT_NAME,
        "@derive(Eq) on the boxed field `data.Node.next`"), 1)
}

// The tag label and the payload block are two adjacent switch kids. Swapping them by
// one position reads every payload through the neighbouring variant, which is
// undefined and which a presence-only assertion cannot see.
test "each variant's payload is compared under that variant's own tag" {
    let text = one_fn(bodies_of("cg_derive_eq", eq_src()), "int blink_Shape_eq")
    let circle_tag = text.index_of("blink_Shape_Circle_TAG")
    let circle_field = text.index_of("self.data.Circle.radius")
    let rect_tag = text.index_of("blink_Shape_Rect_TAG")
    let rect_field = text.index_of("self.data.Rect.w")
    assert(circle_tag >= 0 && circle_field >= 0 && rect_tag >= 0 && rect_field >= 0)
    assert(circle_tag < circle_field)
    assert(circle_field < rect_tag)
    assert(rect_tag < rect_field)
}

// Two names in one annotation and two annotations on one declaration are both legal
// spellings, so the reader must answer every name from both.
fn many_derives_src() -> Str {
    #"@derive(Eq, Hash)
@derive(Debug)
type Many { x: Int }
fn main() { }
"#
}

test "the derive annotation reader answers names from every annotation on a declaration" {
    let program = program_of("cg_derive_many", many_derives_src())
    assert(program >= 0)
    let names = derive_names_of(find_type_decl("Many"))
    assert_eq(names.len(), 3)
    assert_eq(names.get(0).unwrap(), "Eq")
    assert_eq(names.get(1).unwrap(), "Hash")
    assert_eq(names.get(2).unwrap(), "Debug")
}

// layout owns the opaque-handle question: the handle's word form is a layout fact, and
// a second reader of the annotation would be free to disagree with it.
test "layout answers whether a type id is an opaque handle" {
    let program = program_of_but("cg_derive_opaque_query", opaque_src(), "NonDerivableTrait")
    assert(program >= 0)
    assert(tid_is_opaque_handle(cg_reg_tid_for_decl(find_type_decl("CFile"))))
    let _q = program_of("cg_derive_opaque_query", eq_src())
    assert(!tid_is_opaque_handle(cg_reg_tid_for_decl(find_type_decl("Point"))))
}
