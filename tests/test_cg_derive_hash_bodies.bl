// The C a @derive(Hash) type gets: one accumulator, every declared field mixed into it
// in declaration order, read off the declared shape and spelled by layout. A field kind
// this stage cannot hash is an internal error, not a skipped field: skipping one makes
// two unequal values hash alike, which costs correctness the moment the hash decides a
// bucket and silently costs nothing until then.

import std.io
import layout.{layout_reset}
import parser.{nodes, node_kind, node_name, node_source_module}
import cname.{cname_mark_transparent_newtype}
import ast.{NodeKind, nk_of}
import cg_print.{print_reset, print_take}
import cg_reg.{cg_reg_reset, cg_reg_build, cg_reg_type_decls}
import cg_derive.{cg_derive_reset, cg_derive_emit_decls, cg_derive_emit_bodies}
import cg_test_helpers.{cg_probe_compile, cg_probe_compile_but, cg_probe_ices_naming, cg_text_occurrences}

// The transparent-newtype mark is scoped to lib/std, so a probe that declares its own
// newtype sets the mark by hand to reach the lowering under test.
fn mark_probe_errno() {
    let mut i = 0
    while i < nodes.len() {
        if nk_of(node_kind(i)) == NodeKind.TypeDef && node_name(i) == "Errno" && node_source_module(i) == "__main__" {
            cname_mark_transparent_newtype(i)
        }
        i = i + 1
    }
}

// Point is hashed by two scalars, Named by a string and a scalar, Pair by a nested
// derived type, Color rides its own ordinal, and Shape carries payloads.
fn hash_src() -> Str {
    #"@derive(Hash, Eq)
type Point { x: Int, y: Int }
@derive(Hash, Eq)
type Named { name: Str, id: Int }
@derive(Hash, Eq)
type Pair { p: Point, n: Int }
@derive(Hash, Eq)
type Color { Red, Green, Blue }
@derive(Hash, Eq)
type Shape {
    Circle(radius: Int)
    Rect(w: Int, h: Int)
}
@derive(Hash, Eq)
type Maybe {
    Nothing
    Just(v: Int)
}
fn main() { }
"#
}

fn program_of(stem: Str, src: Str) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck {
    let program = cg_probe_compile("build/{stem}_probe_src.bl", src)
    layout_reset()
    mark_probe_errno()
    print_reset()
    cg_reg_reset()
    cg_reg_build(program)
    cg_derive_reset()
    program
}

fn bodies_of(stem: Str, src: Str) -> Str ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck {
    let _p = program_of(stem, src)
    cg_derive_emit_bodies(cg_reg_type_decls())
    print_take()
}

fn decls_of(stem: Str, src: Str) -> Str ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck {
    let _p = program_of(stem, src)
    cg_derive_emit_decls(cg_reg_type_decls())
    print_take()
}

// How many internal errors this stage recorded whose message names the given phrase. A
// bare count would pass on any internal error, including one this stage raised for an
// unrelated reason in the same probe.
fn ices_naming(stem: Str, src: Str, phrase: Str) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck {
    let _p = program_of(stem, src)
    cg_derive_emit_bodies(cg_reg_type_decls())
    cg_probe_ices_naming(phrase)
}

fn assert_has(text: Str, want: Str) {
    if !text.contains(want) {
        io.println("FAIL: expected to find:\n  {want}\nin:\n{text}")
    }
    assert(text.contains(want))
}

fn assert_lacks(text: Str, unwanted: Str) {
    if text.contains(unwanted) {
        io.println("FAIL: expected NOT to find:\n  {unwanted}\nin:\n{text}")
    }
    assert(!text.contains(unwanted))
}

// One function's text, from its head to the close brace in column zero.
fn one_fn(text: Str, head: Str) -> Str {
    let start = text.index_of(head)
    if start < 0 {
        io.println("FAIL: no function starting '{head}' in:\n{text}")
    }
    assert(start >= 0)
    let rest = text.substring(start, text.len() - start)
    let end = rest.index_of("\n}")
    assert(end >= 0)
    rest.substring(0, end + 2)
}

// The accumulator's name is minted, so a test reads it off the declaration rather than
// writing down a spelling the minter owns.
fn acc_of(text: Str) -> Str {
    for line in text.lines() {
        let t = line.trim()
        if t.starts_with("uint64_t ") && t.contains("BLINK_HASH_INIT") {
            return t.split(" ").get(1).unwrap()
        }
    }
    io.println("FAIL: no accumulator declared in:\n{text}")
    assert(false)
    ""
}

test "a derived hash takes one value of its own type and answers a U64" {
    let text = bodies_of("cg_derive_hash_sig", hash_src())
    assert_has(text, #"uint64_t blink_Point_hash(blink_Point self) {"#)
}

test "a product type mixes every declared field into one accumulator" {
    let text = one_fn(bodies_of("cg_derive_hash_struct", hash_src()), "uint64_t blink_Point_hash")
    let h = acc_of(text)
    assert_has(text, "uint64_t {h} = BLINK_HASH_INIT;")
    assert_has(text, "{h} = blink_kops_mix_u64(({h} ^ ((uint64_t)(self.x))));")
    assert_has(text, "{h} = blink_kops_mix_u64(({h} ^ ((uint64_t)(self.y))));")
    assert_has(text, "return {h};")
}

test "a string field is hashed by the runtime string hasher, never cast to an integer" {
    let text = one_fn(bodies_of("cg_derive_hash_str", hash_src()), "uint64_t blink_Named_hash")
    let h = acc_of(text)
    assert_has(text, "{h} = blink_kops_mix_u64(({h} ^ blink_map_hash(self.name)));")
    assert_lacks(text, "(uint64_t)(self.name)")
}

test "a nested derived field is hashed by calling the nested derived method" {
    let text = one_fn(bodies_of("cg_derive_hash_nested", hash_src()), "uint64_t blink_Pair_hash")
    let h = acc_of(text)
    assert_has(text, "{h} = blink_kops_mix_u64(({h} ^ blink_Point_hash(self.p)));")
}

test "a payload-less enum hashes its own ordinal value" {
    let text = one_fn(bodies_of("cg_derive_hash_ordinal", hash_src()), "uint64_t blink_Color_hash")
    assert_has(text, "return blink_kops_mix_u64((BLINK_HASH_INIT ^ ((uint64_t)(self))));")
    assert_lacks(text, "self.tag")
    assert_lacks(text, "blink_Color_Red")
}

test "a payload enum mixes its tag before it reads any payload" {
    let text = one_fn(bodies_of("cg_derive_hash_tag_first", hash_src()), "uint64_t blink_Shape_hash")
    let init = text.index_of(" = blink_kops_mix_u64((BLINK_HASH_INIT ^ ((uint64_t)(self.tag))));")
    let first_tag = text.index_of("blink_Shape_Circle_TAG")
    assert(init >= 0 && first_tag > init)
}

test "each variant's payload is mixed under that variant's own tag" {
    let text = one_fn(bodies_of("cg_derive_hash_variants", hash_src()), "uint64_t blink_Shape_hash")
    let circle = text.index_of("blink_Shape_Circle_TAG")
    let radius = text.index_of("self.data.Circle.radius")
    let rect = text.index_of("blink_Shape_Rect_TAG")
    let w = text.index_of("self.data.Rect.w")
    assert(circle >= 0 && radius > circle && rect > radius && w > rect)
}

test "a unit variant of a payload enum contributes its tag and nothing else" {
    let text = one_fn(bodies_of("cg_derive_hash_unit_variant", hash_src()), "uint64_t blink_Maybe_hash")
    assert_has(text, "blink_Maybe_Nothing_TAG")
    assert_lacks(text, "self.data.Nothing")
}


test "an enum whose tag matches no variant panics instead of hashing a stand-in" {
    let text = one_fn(bodies_of("cg_derive_hash_corrupt", hash_src()), "uint64_t blink_Shape_hash")
    let last_tag = text.index_of("blink_Shape_Rect_TAG")
    let panic_at = text.index_of("__blink_panic")
    assert(last_tag >= 0 && panic_at > last_tag)
    assert_has(text, "@derive(Hash) on Shape met a tag no variant declares")
    assert(cg_text_occurrences(text, "return ") == 1)
}

// A Float has no hash coherent with its equality and a container has no hash at all,
// so neither can reach this stage. The refusal belongs to the front end, where the
// message can name the field; the ICE this stage keeps for such a field is a backstop
// that fires only if that gate is ever removed. Pinning the gate here is what keeps the
// backstop honest, because a test that built the shape could not get past type checking.
fn front_end_refuses(stem: Str, src: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck {
    let _p = cg_probe_compile_but("build/{stem}_probe_src.bl", src, "NonDerivableTrait")
}

test "a float field is refused by the front end before this stage can hash it" {
    front_end_refuses("cg_derive_hash_float", #"@derive(Hash, Eq)
type Sample { ratio: Float }
fn main() { }
"#)
}

test "a container field is refused by the front end before this stage can hash it" {
    front_end_refuses("cg_derive_hash_container", #"@derive(Hash, Eq)
type Bag { items: List[Int] }
fn main() { }
"#)
}

test "the declaration pass writes a hash signature for every derived type and no body" {
    let text = decls_of("cg_derive_hash_decls", hash_src())
    for name in ["Point", "Named", "Pair", "Color", "Shape", "Maybe"] {
        assert_has(text, "uint64_t blink_{name}_hash(blink_{name} self);")
    }
    assert_lacks(text, "BLINK_HASH_INIT")
}

test "a transparent newtype hashes the payload of its one variant" {
    let text = one_fn(bodies_of("cg_derive_hash_newtype", #"@derive(Hash, Eq)
type Errno { Errno(Int) }
fn main() { }
"#), "uint64_t blink_Errno_hash")
    assert_has(text, "return blink_kops_mix_u64((BLINK_HASH_INIT ^ ((uint64_t)(self))));")
    assert_lacks(text, "self.tag")
}

// A string payload holds a pointer. Widening that pointer would hash the address rather
// than the bytes, so two equal keys built separately would land in different buckets.
// Only a word-wide payload is stored transparently, so a one-variant type over a string
// keeps its tag and reaches the payload through the union.
test "a one-variant type over a string hashes its bytes, not the pointer it holds" {
    let text = one_fn(bodies_of("cg_derive_hash_newtype_str", #"@derive(Hash, Eq)
type Name { Name(Str) }
fn main() { }
"#), "uint64_t blink_Name_hash")
    let h = acc_of(text)
    assert_has(text, "{h} = blink_kops_mix_u64(({h} ^ blink_map_hash(self.data.Name._0)));")
    assert_lacks(text, "(uint64_t)(self.data")
}

// The key-operations table a keyed container binds names a hash and an eq. Hash's
// supertrait is Eq and the compiler derives a supertrait the author leaves out, so a type
// naming Hash alone gets the eq the table names rather than an undefined symbol at link
// time. The eq is written once, the same way a type naming Ord alone gets one.
test "a type deriving Hash alone is given the eq its key table names" {
    let text = bodies_of("cg_derive_hash_without_eq", #"@derive(Hash)
type Lonely { x: Int }
fn main() { }
"#)
    assert_has(text, "uint64_t blink_Lonely_hash(blink_Lonely self) \{")
    assert_eq(cg_text_occurrences(text, "int blink_Lonely_eq(blink_Lonely self, blink_Lonely other) \{"), 1)
    assert_has(text, "blink_Lonely_eq(*(blink_Lonely const*)a, *(blink_Lonely const*)b)")
}

// A type becomes usable as a key when it gets a hash body, so the body pass emits the
// key table too. The table's shape is pinned in the kops test file; this file guards only
// that the pass no longer refuses to produce one.
test "a hash body carries the key table rather than refusing it" {
    let n = ices_naming("cg_derive_hash_kops_table", hash_src(), "key-operations table")
    assert(n == 0)
}

// Bool, Char and the sized integers ride in a word the same way an Int does, so each is
// widened into the accumulator. A missing arm would refuse a type the spec calls hashable.
test "a bool, a char and a sized integer are widened into the accumulator like an int" {
    let text = one_fn(bodies_of("cg_derive_hash_words", #"@derive(Hash, Eq)
type Flags { on: Bool, letter: Char, small: U8 }
fn main() { }
"#), "uint64_t blink_Flags_hash")
    let h = acc_of(text)
    assert_has(text, "{h} = blink_kops_mix_u64(({h} ^ ((uint64_t)(self.on))));")
    assert_has(text, "{h} = blink_kops_mix_u64(({h} ^ ((uint64_t)(self.letter))));")
    assert_has(text, "{h} = blink_kops_mix_u64(({h} ^ ((uint64_t)(self.small))));")
}

// An enum field is a nested derived type as much as a struct field is. Widening its tag
// in place would hash a value the nested type never agreed to, and would drop the payload.
test "a field whose type is a derived enum is hashed by calling that enum's own method" {
    let text = one_fn(bodies_of("cg_derive_hash_nested_enum", #"@derive(Hash, Eq)
type Color { Red, Green, Blue }
@derive(Hash, Eq)
type Paint { c: Color, n: Int }
fn main() { }
"#), "uint64_t blink_Paint_hash")
    let h = acc_of(text)
    assert_has(text, "{h} = blink_kops_mix_u64(({h} ^ blink_Color_hash(self.c)));")
}

// Hash reaches a field's own derived method, so a field whose type does not derive Hash
// has no method to call. The front end names the field; the refusal this stage keeps for
// the same shape is a backstop that can only fire if that gate is removed.
test "a field whose type does not derive Hash is refused by the front end" {
    front_end_refuses("cg_derive_hash_nested_undrived", #"@derive(Eq)
type Inner { a: Int }
@derive(Hash, Eq)
type Outer { i: Inner }
fn main() { }
"#)
}

// A field type that derives Hash alone has the eq Hash's supertrait obliges, so the outer
// type's Eq gate finds the field comparable and its Hash gate finds it hashable. Both
// types are admitted, and the field is hashed by calling the method its own type carries.
test "a field whose type derives Hash alone is hashed by calling that type's method" {
    let text = one_fn(bodies_of("cg_derive_hash_nested_no_eq", #"@derive(Hash)
type Inner { a: Int }
@derive(Hash, Eq)
type Outer { i: Inner }
fn main() { }
"#), "uint64_t blink_Outer_hash")
    let h = acc_of(text)
    assert_has(text, "{h} = blink_kops_mix_u64(({h} ^ blink_Inner_hash(self.i)));")
}

// A generic type has no single layout to hash, so each instance gets its own body and the
// declaration gets none. This probe runs no monomorphization, so there is nothing to hash.
test "a generic type is not hashed at one arbitrary instantiation" {
    let src = #"@derive(Hash, Eq)
type Box[T] { v: T }
fn main() { }
"#
    assert(ices_naming("cg_derive_hash_generic", src, "@derive(Hash) on the generic type `Box`") == 0)
    assert_lacks(bodies_of("cg_derive_hash_generic", src), "_hash")
}

// Ord's supertrait is Eq, and this stage derives it for a type that names only Ord. A type
// deriving Hash and Ord therefore has an eq definition, and the key table names a symbol
// that exists. Refusing this shape refuses what the spec allows.
test "a type deriving Hash and Ord is hashed through the eq Ord derives" {
    let text = bodies_of("cg_derive_hash_with_ord", #"@derive(Hash, Ord)
type Keyed { x: Int }
fn main() { }
"#)
    assert_has(text, "uint64_t blink_Keyed_hash(blink_Keyed self) \{")
    assert_eq(cg_text_occurrences(text, "int blink_Keyed_eq(blink_Keyed self, blink_Keyed other) \{"), 1)
    assert_has(text, "blink_Keyed_eq(*(blink_Keyed const*)a, *(blink_Keyed const*)b)")
}

// Whether an eq exists is a property of the declaration, not of the order the derive
// names are written in. Reading a record the earlier derive left behind would answer one
// order and refuse the other.
test "the order Hash and Ord are written in does not decide whether the hash is built" {
    let text = bodies_of("cg_derive_hash_ord_first", #"@derive(Ord, Hash)
type Sorted { x: Int }
fn main() { }
"#)
    assert_has(text, "uint64_t blink_Sorted_hash(blink_Sorted self) \{")
    assert_eq(cg_text_occurrences(text, "int blink_Sorted_eq(blink_Sorted self, blink_Sorted other) \{"), 1)
    assert_has(text, "blink_Sorted_eq(*(blink_Sorted const*)a, *(blink_Sorted const*)b)")
}
