// A derive refusal is read by the person who wrote the type, so it names the field as
// they wrote it. The C member path (`b_raw`, `data.b_Wrap.b_raw`) is how the emitted
// code reads the field, and nobody wrote that.

import layout.{layout_reset}
import cg_print.{print_reset}
import cg_reg.{cg_reg_reset, cg_reg_build, cg_reg_type_decls}
import cg_derive.{cg_derive_reset, cg_derive_emit_bodies}
import cg_test_helpers.{cg_probe_compile, cg_probe_ices_saying}
import diagnostics.{CODEGEN_STAGE_NOT_BUILT_NAME}

fn refusals_saying(stem: Str, src: Str, marker: Str) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck {
    let program = cg_probe_compile("build/{stem}_probe_src.bl", src)
    layout_reset()
    print_reset()
    cg_reg_reset()
    cg_reg_build(program)
    cg_derive_reset()
    cg_derive_emit_bodies(cg_reg_type_decls())
    cg_probe_ices_saying(CODEGEN_STAGE_NOT_BUILT_NAME, marker)
}

fn ord_src() -> Str {
    #"@derive(Ord)
type Handle { raw: Ptr[U8] }
@derive(Ord)
type Slot {
    Empty
    Wrap(raw: Ptr[U8])
}
fn main() { }
"#
}

test "an Ord refusal names a struct field by its Blink name" {
    assert_eq(refusals_saying("cg_derive_label_ord", ord_src(), "@derive(Ord) on the Ptr field `raw`"), 1)
    assert_eq(refusals_saying("cg_derive_label_ord", ord_src(), "b_raw"), 0)
}

test "an Ord refusal names a variant field as variant and field" {
    assert_eq(refusals_saying("cg_derive_label_ord", ord_src(), "@derive(Ord) on the Ptr field `Wrap.raw`"), 1)
    assert_eq(refusals_saying("cg_derive_label_ord", ord_src(), "b_Wrap"), 0)
}

fn hash_src() -> Str {
    #"@derive(Hash)
type Handle { raw: Ptr[U8] }
@derive(Hash)
type Slot {
    Empty
    Wrap(raw: Ptr[U8])
}
fn main() { }
"#
}

test "a Hash refusal names struct and variant fields by their Blink names" {
    assert_eq(refusals_saying("cg_derive_label_hash", hash_src(), "@derive(Hash) on the Ptr field `raw`"), 1)
    assert_eq(refusals_saying("cg_derive_label_hash", hash_src(), "@derive(Hash) on the Ptr field `Wrap.raw`"), 1)
    assert_eq(refusals_saying("cg_derive_label_hash", hash_src(), "b_raw"), 0)
}
