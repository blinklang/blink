// A derived method and a hand-written one of the same trait are the same kind of C
// function, so they spell their parameters by one rule: the receiver and the other operand
// carry the Blink name prefix like every other parameter. A raw `self` or `other` in one of
// them is a name a C macro can still reach.

import std.io
import layout.{layout_reset}
import cname.{cname_reset}
import cg_print.{print_reset, print_take}
import cg_reg.{cg_reg_reset, cg_reg_build, cg_reg_type_decls}
import cg_decl.{cg_decl_reset, cg_decl_emit_impl_method_decls}
import cg_derive.{cg_derive_reset, cg_derive_emit_bodies}
import cg_test_helpers.{cg_probe_compile}

fn probe_src() -> Str {
    #"@derive(Eq)
type Made { x: Int }

type Hand { x: Int }

impl Eq for Hand {
    fn eq(self, other: Hand) -> Bool { self.x == other.x }
}

fn main() { }
"#
}

fn emitted() -> Str ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck {
    let program = cg_probe_compile("build/cg_receiver_alike_probe_src.bl", probe_src())
    layout_reset()
    cname_reset()
    print_reset()
    cg_reg_reset()
    cg_reg_build(program)
    cg_decl_reset()
    cg_derive_reset()
    cg_decl_emit_impl_method_decls()
    cg_derive_emit_bodies(cg_reg_type_decls())
    print_take()
}

// The parameter names of the first C signature whose function name ends in `marker`.
fn param_names(text: Str, marker: Str) -> List[Str] {
    let at = text.byte_index_of(marker, 0) ?? -1
    if at < 0 {
        io.println("FAIL: no '{marker}' in\n{text}")
        return []
    }
    let open = at + marker.byte_len()
    let close = text.byte_index_of(")", open) ?? -1
    let mut names: List[Str] = []
    for p in text.byte_slice(open, close).split(", ") {
        let words = p.split(" ")
        names.push(words.get(words.len() - 1).unwrap())
    }
    names
}

test "a derived eq and a hand-written eq name their parameters alike" {
    let text = emitted()
    let made = param_names(text, "blink_Made_eq(")
    let hand = param_names(text, "_Eq_eq(")
    if made != hand { io.println("FAIL: derived {made.join(", ")}, hand-written {hand.join(", ")}\n{text}") }
    assert_eq(made, ["b_self", "b_other"])
    assert_eq(hand, ["b_self", "b_other"])
}
