// The driver's side of @derive: a derived method is a body no source declares, so the
// unit that emits it is chosen here and nowhere else. Two things are proved: a unit that
// emits definitions emits the derived ones too, and it emits only the ones its own module
// declared. The second is what keeps a per-module build from defining one symbol twice.

import std.fs
import std.io
import layout.{Position, layout_of, layout_reset}
import cname.{c_derive_method_name, cname_reset}
import cg_test_helpers.{cg_probe_compile}
import cg.{CgConfig, generate, generate_module_header, generate_module_object}
import cg_reg.{cg_reg_tid_for_decl, cg_reg_type_decls}
import mono.{run_mono}
import parser.{node_name}

fn assert_has(text: Str, needle: Str) {
    if text.index_of(needle) < 0 {
        io.println("FAIL: output has no '{needle}'\n--- output ---\n{text}")
    }
    assert(text.index_of(needle) >= 0)
}

fn assert_lacks(text: Str, needle: Str) {
    if text.index_of(needle) >= 0 {
        io.println("FAIL: output must not have '{needle}'\n--- output ---\n{text}")
    }
    assert(text.index_of(needle) < 0)
}

fn standalone_cfg() -> CgConfig {
    CgConfig { debug_mode: 0, trace_codegen: 0, deterministic: 0, emit_only_module: "",
        skip_modules: Map(), user_tu_mode: 0, blink_ev_extern_only: 0, archive_build_mode: 0 }
}

// The symbol and the parameter spelling both come from the producers the emitter reads,
// so this proves the driver emitted the method and not one particular spelling of it.
fn derive_decl_of(type_name: Str) -> Int {
    for d in cg_reg_type_decls() { if node_name(d) == type_name { return d } }
    -1
}

fn eq_signature(type_name: Str) -> Str ! Diag.Report {
    let decl = derive_decl_of(type_name)
    assert(decl >= 0)
    let spelling = layout_of(cg_reg_tid_for_decl(decl), Position.Param).c_spelling
    "int {c_derive_method_name(decl, "eq")}({spelling} self, {spelling} other)"
}

fn single_file_probe(stem: Str, src: Str) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS.Delete {
    let path = "build/{stem}.bl"
    let program = cg_probe_compile(path, src)
    run_mono(program)
    layout_reset()
    cname_reset()
    let _ = fs.delete(path)
    program
}

fn eq_src() -> Str {
    #"@derive(Eq)
type Point { x: Int, y: Int }

fn main() {
    let a = Point { x: 1, y: 2 }
    let b = Point { x: 1, y: 2 }
    let _same = a == b
}
"#
}

test "a whole-program unit defines the methods @derive asked for" {
    let program = single_file_probe("cg_drv_derive_one", eq_src())
    let text = generate(program, standalone_cfg())
    assert_has(text, "{eq_signature("Point")} \{")
}

test "the derived method a body calls is declared before the body that calls it" {
    let program = single_file_probe("cg_drv_derive_decl", eq_src())
    let text = generate(program, standalone_cfg())
    let sig = eq_signature("Point")
    let decl = text.index_of("{sig};")
    let body = text.index_of("{sig} \{")
    if decl < 0 { io.println("FAIL: no prototype for the derived method\n--- output ---\n{text}") }
    assert(decl >= 0)
    assert(decl < body)
}

// A derived method belongs to the module its type was declared in, the same rule every
// other definition follows. Emitting it wherever the type is merely used would define one
// symbol in two objects, which the linker rejects.
fn pkg_probe(stem: Str) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck {
    let root = "build/{stem}_pkg"
    let _clean = process_run("rm", ["-rf", root])
    let _mk = process_run("mkdir", ["-p", "{root}/src"])
    write_file("{root}/blink.toml", "[package]\nname = \"{stem}\"\nversion = \"0.1.0\"\n")
    write_file("{root}/src/mymod.bl", #"@derive(Eq)
pub type Point { x: Int, y: Int }
"#)
    let path = "{root}/src/probe.bl"
    let program = cg_probe_compile(path, #"import mymod.{Point}

fn main() {
    let a = Point { x: 1, y: 2 }
    let b = Point { x: 1, y: 2 }
    let _same = a == b
}
"#)
    run_mono(program)
    layout_reset()
    cname_reset()
    let _rm = process_run("rm", ["-rf", root])
    program
}

test "the module that declared the type is the one module that defines its derived method" {
    let program = pkg_probe("cg_drv_derive_scope")
    let owner = generate_module_object(program, "mymod", "mymod.h", standalone_cfg())
    let sig = eq_signature("Point")
    assert_has(owner, "{sig} \{")
    let user = generate_module_object(program, "__main__", "probe.h", standalone_cfg())
    assert_lacks(user, "{sig} \{")
}

// The caller's unit still has to know the name it calls, so the declaration half is not
// scoped the way the definition half is.
test "a module that only uses a derived method still sees its declaration" {
    let program = pkg_probe("cg_drv_derive_seen")
    let header = generate_module_header(program, "__main__", standalone_cfg())
    assert_has(header, "{eq_signature("Point")};")
}
