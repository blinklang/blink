// A closure that reads a local of its enclosing function, and the capture words it rides
// on.
//
// sections/02_syntax.md:336 settles what a capture means: every capture is a shared
// reference to the original binding. For a `let` binding that is observationally
// equivalent to a by-value copy, because the value never changes, and the spec says the
// compiler may copy it freely. For a `let mut` binding it is not: a write on either side
// has to be visible on the other, which needs one heap cell that the enclosing function
// and the thunk both hold — a copy would compile, run, and answer the wrong number, which
// is the one outcome worth a test of its own. tests/test_cg_eff_shared_mutable_capture_cell.bl
// is where that cell itself is pinned; the two mutable cases below only check that the
// statement stage routes a shared `let mut` through it instead of refusing the capture.
//
// The capture array is `void**`, which is the same slot a list element rides in, so the
// word a capture is punned through is Position.ContainerSlot's answer and not a second
// one. InlineWord at that position is a capture this stage can build: slot_word names the
// integer an Int or a Bool rides through, and an empty slot_word means the value is
// already a pointer. PointerBoxed means the value does not fit the word, so it travels as
// a heap copy and the word holds the address, which is what a container element wider
// than its slot already does. A copy is only sound for a binding nothing assigns; a
// shared `let mut` rides its cell instead, which is already pointer-wide, so an oversized
// one needs no box either.

import typecheck.{TYPE_FLOAT, TYPE_INT, TYPE_STR}
import cname_test_helpers.{find_decl}
import cg_test_helpers.{cg_probe_compile, cg_text_occurrences}
import ast.{NodeKind}
import parser.{node_body, node_value}
import layout.{bind_binder_mut, binder_scope_pop, binder_scope_push, layout_reset}
import ir.{IrKind, ir_c_name, ir_capture_descs, ir_promoter, ir_kid_count, ir_kid, ir_kind, ir_reset, ir_verify}
import cg_reg.{cg_reg_build}
import cg_expr.{cg_expr_reset}
import cg_print.{print_reset, print_take}
import cg_stmt.{cg_stmt_reset, lower_block_returning, lower_fn}
import cg_eff.{
    cg_eff_lower_closure, cg_eff_pending_thunks, cg_eff_print_thunk, cg_eff_reset,
    cg_eff_scan_shared_binders, cg_eff_thunk_body_node, cg_eff_thunk_close, cg_eff_thunk_open,
    cg_eff_thunks_drained,
}
import diagnostics.{diag_entries, diag_reset}
import std.fs
import std.io

// One closure per case, each bound to a `let` of its own name so a case can name the one
// it means. The enclosing locals are declared here too, because a capture is only a
// capture against a frame that binds the name.
fn probe_src() -> Str {
    #"import std.io

fn one_int_capture() -> Int {
    let n = 5
    let g_int = fn(x: Int) -> Int { x + n }
    g_int(1)
}

fn one_name_read_twice() -> Int {
    let n = 5
    let g_twice = fn(x: Int) -> Int { x + n + n }
    g_twice(1)
}

fn two_names_captured() -> Int {
    let n = 5
    let m = 7
    let g_two = fn(x: Int) -> Int { x + n + m }
    g_two(1)
}

fn a_pointer_capture() -> Int {
    let s = "ab"
    let g_str = fn(x: Int) -> Int { x + s.len() }
    g_str(1)
}

fn a_boxed_capture() -> Float {
    let f = 1.5
    let g_float = fn(x: Float) -> Float { x + f }
    g_float(2.0)
}

fn a_mutable_capture() -> Int {
    let mut c = 0
    let g_mut = fn(x: Int) -> Int { x + c }
    c = 9
    g_mut(1)
}

fn a_mutable_boxed_capture() -> Float {
    let mut fm = 1.5
    let g_mut_float = fn(x: Float) -> Float { x + fm }
    fm = 2.5
    g_mut_float(2.0)
}

fn nested_over_outer_param() -> Int {
    let g_outer = fn(x: Int) -> Int {
        let inner = fn(y: Int) -> Int { y + x }
        inner(2)
    }
    g_outer(3)
}

fn no_capture_at_all() -> Int {
    let g_none = fn(x: Int) -> Int { x + 1 }
    g_none(1)
}

// `mut` on a param parses, though name resolution does not honor it yet -- see
// bind_params in src/cg_stmt.bl. The capture must still refuse this the way a shared
// `let mut` does, not copy it, because copying would go stale the day reassignment works.
fn capture_mut_param(mut p: Int) -> Int {
    let g_mut_param = fn(x: Int) -> Int { x + p }
    g_mut_param(1)
}

// `let mut (a, b) = t` spells its mutability once, on the LetBinding, not per leaf. A
// closure sharing a leaf needs the same cell a plain `let mut` capture needs.
fn a_mutable_tuple_destructure_capture() -> Int {
    let mut (a, b) = (1, 2)
    let g_mut_tuple = fn(x: Int) -> Int { x + a + b }
    a = 9
    g_mut_tuple(1)
}

fn main() {
    io.println("{one_int_capture()}")
    io.println("{one_name_read_twice()}")
    io.println("{two_names_captured()}")
    io.println("{a_pointer_capture()}")
    io.println("{a_boxed_capture()}")
    io.println("{a_mutable_capture()}")
    io.println("{a_mutable_boxed_capture()}")
    io.println("{nested_over_outer_param()}")
    io.println("{no_capture_at_all()}")
    io.println("{capture_mut_param(1)}")
    io.println("{a_mutable_tuple_destructure_capture()}")
}
"#
}

fn ices() -> Int {
    let mut n = 0
    for d in diag_entries {
        if d.severity == "ice" { n = n + 1 }
    }
    n
}

fn ices_mentioning(text: Str) -> Int {
    let mut n = 0
    for d in diag_entries {
        if d.severity == "ice" && d.message.contains(text) { n = n + 1 }
    }
    n
}

fn report_ices(label: Str) {
    io.eprintln("  {label}:")
    for d in diag_entries {
        if d.severity == "ice" { io.eprintln("    ICE {d.code} {d.message}") }
    }
}

fn setup() ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS.Delete {
    diag_reset()
    ir_reset()
    layout_reset()
    cg_stmt_reset()
    cg_expr_reset()
    cg_eff_reset()
    let path = "build/cg_eff_closure_captures_probe.bl"
    let program = cg_probe_compile(path, probe_src())
    let _ = fs.delete(path)
    cg_reg_build(program)
    diag_reset()
}

// What capture word `i` ultimately reads. A word that needs the integer bridge is a cast
// over the read, so the name sits on the leaf; a pointer word is the read itself.
fn word_reads(v: Int, i: Int) -> Str {
    let word = ir_kid(v, i)
    if word < 0 { return "" }
    if ir_kind(word) == IrKind.Cast { return ir_c_name(ir_kid(word, 0)) }
    ir_c_name(word)
}

fn closure_of(let_name: Str) -> Int {
    let binding = find_decl(NodeKind.LetBinding, let_name, "")
    assert(binding >= 0)
    node_value(binding)
}

// Lowers one closure with `names` bound at `tid` in an enclosing frame, which is what
// makes a name a capture rather than a module-level name the thunk reaches on its own.
// The names bind immutable, because a binder whose mutability is not recorded is refused.
fn lower_capturing(let_name: Str, names: List[Str], tid: Int) -> Int ! Diag.Report {
    let outer = binder_scope_push()
    for nm in names { bind_binder_mut(outer, nm, tid, false) }
    let v = cg_eff_lower_closure(closure_of(let_name))
    binder_scope_pop()
    v
}

// Lowers a whole function body through the statement stage, which is the only way the
// binders a capture resolves against are recorded by the code that actually binds them.
// The trailing call in each probe body is a closure call no stage builds yet, so a body
// lowered this way reports that; these cases measure the capture, not the total.
fn lower_body_of(fn_name: Str) -> Int ! Diag.Report {
    let f = find_decl(NodeKind.FnDef, fn_name, "")
    cg_eff_scan_shared_binders(f)
    lower_block_returning(node_body(f))
}

// Lowers a whole function through the driver's own lower_fn, which binds the function's
// own parameters before the body lowers. lower_body_of skips straight to the body, which
// is fine for the no-param probes above but leaves a parameter of the function itself
// unbound -- this is the path a capture of one actually resolves against.
fn lower_whole_fn(fn_name: Str) -> Int ! Diag.Report {
    let f = find_decl(NodeKind.FnDef, fn_name, "")
    lower_fn(f)
}

test "a closure reading an immutable Int local answers a record instead of refusing" {
    setup()
    let v = lower_capturing("g_int", ["n"], TYPE_INT)
    if v < 0 || ices() != 0 { report_ices("g_int was refused") }
    assert(v >= 0)
    assert(ir_kind(v) == IrKind.ClosureNew)
    assert_eq(ices(), 0)
}

test "the record carries one capture word, and the word reads the enclosing local" {
    setup()
    let v = lower_capturing("g_int", ["n"], TYPE_INT)
    assert(v >= 0)
    assert_eq(ir_kid_count(v), 1)
    // The word is a read of the enclosing local, not a fresh value: a capture that named
    // something else would compile and hold the wrong number.
    assert(word_reads(v, 0).contains("n"))
    assert_eq(ir_verify(v).len(), 0)
}

test "a capture list with no promoter names no descriptor table" {
    // The descriptor table exists for one reader: the generated promoter that deep-copies
    // captures into an arena. bootstrap/runtime_core.h stores the table and never walks it
    // otherwise, and blink_closure_get_capture does not consult it. So the table and the
    // promoter stand or fall together, and a closure that is never arena-promoted carries
    // neither. Emitting a table anyway would put an array in the C that nothing reads.
    setup()
    let v = lower_capturing("g_int", ["n"], TYPE_INT)
    assert(v >= 0)
    assert_eq(ir_capture_descs(v), "")
    assert_eq(ir_promoter(v), "")
}

test "the thunk body binds the captured name, so a read inside resolves without the enclosing frame" {
    // The thunk is a separate C function. The enclosing function's local is not in scope
    // there, so unless the prologue binds the name the body lowers a read of an identifier
    // the thunk never declares.
    setup()
    let v = lower_capturing("g_int", ["n"], TYPE_INT)
    assert(v >= 0)
    assert_eq(cg_eff_pending_thunks(), 1)
    assert(cg_eff_thunk_open(0) >= 0)
    let body = lower_block_returning(cg_eff_thunk_body_node(0))
    cg_eff_thunk_close()
    if body < 0 || ices() != 0 { report_ices("the thunk body did not lower") }
    assert(body >= 0)
    assert_eq(ir_verify(body).len(), 0)
    assert_eq(ices(), 0)
}

test "two reads of one captured name take one capture word" {
    setup()
    let v = lower_capturing("g_twice", ["n"], TYPE_INT)
    assert(v >= 0)
    assert_eq(ir_kid_count(v), 1)
}

test "two distinct captured names take two capture words in first-read order" {
    // The descriptor table and the thunk prologue both index by position, so the order the
    // words are built in is the order the thunk reads them back out in.
    setup()
    let v = lower_capturing("g_two", ["n", "m"], TYPE_INT)
    assert(v >= 0)
    assert_eq(ir_kid_count(v), 2)
    assert(word_reads(v, 0).contains("n"))
    assert(word_reads(v, 1).contains("m"))
}

test "a pointer-shaped capture rides the slot without an integer pun" {
    setup()
    let v = lower_capturing("g_str", ["s"], TYPE_STR)
    if v < 0 || ices() != 0 { report_ices("g_str was refused") }
    assert(v >= 0)
    assert_eq(ir_kid_count(v), 1)
    assert_eq(ices(), 0)
}

test "a capture of an outer closure's own parameter builds a copy, not a refusal" {
    // The inner closure captures the outer thunk's parameter. A parameter cannot be
    // reassigned, so bind_params records it immutable at the bind site, and the capture
    // is an ordinary one: it builds and reads a copy, the same as any other capture.
    setup()
    let v = lower_capturing("g_outer", [], TYPE_INT)
    assert(v >= 0)
    assert_eq(cg_eff_pending_thunks(), 1)
    assert(cg_eff_thunk_open(0) >= 0)
    let body = lower_block_returning(cg_eff_thunk_body_node(0))
    cg_eff_thunk_close()
    if body < 0 || ices() != 0 { report_ices("g_outer's body did not lower") }
    assert(body >= 0)
    assert_eq(ices(), 0)
    // The inner closure's own capture of `x` queued a second thunk.
    assert_eq(cg_eff_pending_thunks(), 2)
    print_reset()
    assert(cg_eff_thunk_open(1) >= 0)
    let inner_body = lower_block_returning(cg_eff_thunk_body_node(1))
    cg_eff_thunk_close()
    assert(inner_body >= 0)
    cg_eff_print_thunk(1, inner_body)
    let text = print_take()
    if ices() != 0 { report_ices("inner's thunk did not print") }
    assert_eq(ices(), 0)
    assert(cg_text_occurrences(text, "blink_closure_get_capture") == 1)
}

test "the queue still drains to zero once a captured closure is printed" {
    setup()
    let v = lower_capturing("g_int", ["n"], TYPE_INT)
    assert(v >= 0)
    assert(cg_eff_thunk_open(0) >= 0)
    let body = lower_block_returning(cg_eff_thunk_body_node(0))
    cg_eff_thunk_close()
    cg_eff_print_thunk(0, body)
    cg_eff_thunks_drained(1)
    assert_eq(cg_eff_pending_thunks(), 0)
    assert_eq(ices(), 0)
}

test "a closure with no captures still answers no capture words and no descriptor table" {
    setup()
    let v = lower_capturing("g_none", [], TYPE_INT)
    assert(v >= 0)
    assert_eq(ir_kid_count(v), 0)
    assert_eq(ir_capture_descs(v), "")
    assert_eq(ir_promoter(v), "")
    assert_eq(ices(), 0)
}

test "a capture that does not fit the word rides a heap copy of the value" {
    // A Float must not ride through an integer, so Position.ContainerSlot answers
    // PointerBoxed for it. The word then holds the address of a heap copy, the same route
    // a container element wider than its slot takes.
    setup()
    let v = lower_capturing("g_float", ["f"], TYPE_FLOAT)
    if v < 0 || ices() != 0 { report_ices("g_float was refused") }
    assert(v >= 0)
    assert_eq(ir_kid_count(v), 1)
    assert(ir_kind(ir_kid(v, 0)) == IrKind.Box)
    // The copy is of the enclosing local, not of some other value.
    assert(ir_c_name(ir_kid(ir_kid(v, 0), 0)).contains("f"))
    assert_eq(ices(), 0)
    assert_eq(cg_eff_pending_thunks(), 1)
}

test "the thunk reads a boxed capture back through the pointer, not as the pointer" {
    // The prologue binds the captured name at the value's own type. A prologue that bound
    // the address instead would compile and then read a pointer as a Float.
    setup()
    print_reset()
    let v = lower_capturing("g_float", ["f"], TYPE_FLOAT)
    assert(v >= 0)
    assert(cg_eff_thunk_open(0) >= 0)
    let body = lower_block_returning(cg_eff_thunk_body_node(0))
    cg_eff_thunk_close()
    assert(body >= 0)
    cg_eff_print_thunk(0, body)
    let text = print_take()
    if ices() != 0 { report_ices("the boxed thunk did not print") }
    assert_eq(ices(), 0)
    assert(cg_text_occurrences(text, "double f = (*(") == 1)
}

test "an oversized binding the enclosing function can assign builds through its cell, not a box" {
    // The size question and the sharing question both apply to a `let mut` Float. The
    // cell it now shares with the closure is already pointer-wide, so the box the
    // immutable oversized case takes never comes up here.
    setup()
    let built = lower_body_of("a_mutable_boxed_capture")
    if built < 0 || ices() != 0 { report_ices("a_mutable_boxed_capture was refused") }
    assert(built >= 0)
    assert_eq(ices_mentioning("'fm'"), 0)
    assert_eq(ices_mentioning("shared"), 0)
    assert_eq(cg_eff_pending_thunks(), 1)
}

test "a let records its own mutability, so a mut capture builds through a cell just like a plain one" {
    // sections/02_syntax.md:336: a write through either side has to be visible on the
    // other, which needs one shared cell. The mutable case is the one that gets a cell;
    // the plain one still rides a copy.
    //
    // Both bodies are lowered through the statement stage rather than bound by hand, so
    // what is measured is the recorded mutability of a real `let`. The control matters as
    // much as the mutable case: a stage that recorded every binder mutable would cell the
    // plain capture too, and a stage that recorded none would leave the mutable one
    // uncelled.
    setup()
    let built = lower_body_of("a_mutable_capture")
    if built < 0 || ices() != 0 { report_ices("a_mutable_capture was refused") }
    assert(built >= 0)
    assert_eq(ices_mentioning("'c'"), 0)
    assert_eq(ices_mentioning("shared"), 0)
    assert_eq(cg_eff_pending_thunks(), 1)

    setup()
    let built2 = lower_body_of("one_int_capture")
    assert(built2 >= 0)
    assert_eq(ices_mentioning("'n'"), 0)
    assert_eq(cg_eff_pending_thunks(), 1)
}

test "a mut param records mutable and refuses the capture, not a silent copy" {
    // Name resolution does not honor `mut` on a param yet, but bind_params records the
    // parsed flag anyway. A mutable, non-celled binder hits the same refusal a shared
    // `let mut` hits before its cell lands -- capturing it must not silently copy a
    // value the day reassignment starts working. lower_fn swallows a stopped body into
    // an empty block rather than a negative id, so the refusal is read off the ICE, not
    // off lower_whole_fn's return.
    setup()
    lower_whole_fn("capture_mut_param")
    assert(ices_mentioning("'p'") > 0)
    assert(ices_mentioning("has no cell yet") > 0)
    assert_eq(cg_eff_pending_thunks(), 0)
}

test "a mutable tuple-destructure leaf builds through a cell just like a plain mut local" {
    setup()
    let built = lower_whole_fn("a_mutable_tuple_destructure_capture")
    if ices() != 0 { report_ices("a_mutable_tuple_destructure_capture was refused") }
    assert(built >= 0)
    assert_eq(ices_mentioning("'a'"), 0)
    assert_eq(ices_mentioning("shared"), 0)
    assert_eq(cg_eff_pending_thunks(), 1)
}
