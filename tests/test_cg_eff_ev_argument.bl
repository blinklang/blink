// A callee that carries an effect row receives the evidence vector as a trailing
// `blink_ev*` parameter, so every call to one appends the address of the program's one
// vector as its last argument. That address is exact at every call site, including inside
// an effectful function, because a handler install writes the one vector in place and
// restores it on the way out, so there is never a second vector to choose between.
//
// The argument comes from one producer in the effect stage, and the call stage reaches it
// from every path that can resolve an effectful callee. What these tests pin is that the
// argument is the same on all of those paths, that it lands LAST so it matches the
// position the callee declares, and that a callee with no row appends nothing.

import lower_test_helpers.{
    probe, rhs_of, assert_kind, assert_eq_str, assert_shape, assert_verifies,
}
import ir.{IrKind, ir_kid, ir_c_spelling, ir_c_name}
import cg_call.{lower_call}
import cg_eff.{cg_eff_ev_argument}
import cname.{c_ev_type_name, c_ev_global_name}
import layout.{pointer_spelling}

fn src_effectful_callees() -> Str {
    #"import std.io

type Meter { n: Int }

trait Ticks { fn tick(self) -> Int ! IO }

impl Ticks for Meter {
    fn tick(self) -> Int ! IO { self.n }
}

fn counted() -> Int ! IO { 1 }

fn pure_twice(n: Int) -> Int { n + n }

fn effectful() -> Int ! IO {
    let meter = Meter { n: 2 }
    let freed = counted()
    let ticked = meter.tick()
    let qualified = Ticks.tick(meter)
    let plain = pure_twice(3)
    freed + ticked + qualified + plain
}

fn main() {
    let _k = effectful()
}
"#
}

// The producer reads through cname for both spellings, so the argument cannot drift from
// the vector it takes the address of.
test "the evidence argument is the address of the one vector, spelled as a pointer" {
    probe("cg_eff_ev_argument", src_effectful_callees())
    let id = cg_eff_ev_argument(rhs_of("freed"))
    assert_kind("kind", id, IrKind.EvidenceAddress)
    assert_shape("shape", id, "EvidenceAddress(EvidenceVector)")
    assert_eq_str("spelling", ir_c_spelling(id), pointer_spelling(c_ev_type_name()))
    assert_eq_str("vector", ir_c_name(ir_kid(id, 0)), c_ev_global_name())
    assert_verifies("verify", id)
}

// Last, because that is the position the callee declares the parameter in. A free call
// writes no receiver, so the vector's address is its only argument.
test "a free call to an effectful function appends the address last" {
    probe("cg_eff_ev_argument", src_effectful_callees())
    let id = lower_call(rhs_of("freed"))
    assert_kind("kind", id, IrKind.CallDirect)
    assert_shape("shape", id, "CallDirect(EvidenceAddress(EvidenceVector))")
    assert_verifies("verify", id)
}

// The receiver travels first and the vector last, so an effectful method call proves the
// two ends do not trade places.
test "a method call on an effectful impl method appends the address after the receiver" {
    probe("cg_eff_ev_argument", src_effectful_callees())
    let id = lower_call(rhs_of("ticked"))
    assert_kind("kind", id, IrKind.CallDirect)
    assert_shape("shape", id, "CallDirect(VarRef, EvidenceAddress(EvidenceVector))")
    assert_eq_str("receiver", ir_c_name(ir_kid(id, 0)), "meter")
    assert_verifies("verify", id)
}

// Written under the trait rather than on the value, the same body is reached, so the
// argument list has to come out the same as the method call's above.
test "a trait-qualified call to an effectful impl method appends the address too" {
    probe("cg_eff_ev_argument", src_effectful_callees())
    let id = lower_call(rhs_of("qualified"))
    assert_kind("kind", id, IrKind.CallDirect)
    assert_shape("shape", id, "CallDirect(VarRef, EvidenceAddress(EvidenceVector))")
    assert_verifies("verify", id)
}

// The argument belongs to the callee's row, so a callee without one appends nothing. A
// gate that asked something else would hand this call a vector it never declared.
test "a call to a function with no effect row appends nothing" {
    probe("cg_eff_ev_argument", src_effectful_callees())
    let id = lower_call(rhs_of("plain"))
    assert_kind("kind", id, IrKind.CallDirect)
    assert_shape("shape", id, "CallDirect(Const)")
    assert_verifies("verify", id)
}
