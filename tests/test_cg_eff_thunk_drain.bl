// The thunk queue on its way out: one definition per queued closure, and an empty queue
// at the start of every unit.
//
// A closure literal leaves its definition in a queue for the driver to print after the
// enclosing body. This file proves the two ends of that protocol the driver relies on:
// one queued thunk prints as exactly one definition and then leaves the queue with no
// report, and a unit begun after another one starts from an empty queue, so a thunk of a
// program that is no longer current can never be printed into the next unit.

import cname_test_helpers.{find_decl}
import cg_test_helpers.{
    cg_ice_count, cg_ices_named, cg_ices_saying, cg_probe_compile, cg_report_ices,
    cg_text_occurrences,
}
import ast.{NodeKind}
import parser.{node_value}
import layout.{layout_reset}
import ir.{ir_reset}
import mono.{run_mono}
import cg_reg.{cg_reg_build}
import cg.{CgConfig, generate}
import cg_print.{print_reset, print_take}
import cg_expr.{cg_expr_reset}
import cg_stmt.{cg_stmt_reset, lower_block_returning}
import cg_eff.{
    cg_eff_lower_closure, cg_eff_pending_thunks, cg_eff_print_thunk, cg_eff_reset,
    cg_eff_thunk_body_node, cg_eff_thunk_close, cg_eff_thunk_open, cg_eff_thunk_symbol,
    cg_eff_thunks_drained,
}
import diagnostics.{diag_reset}
import std.fs
import std.io

fn closure_src() -> Str {
    #"fn plain_closure() -> Int {
    let g_plain = fn(x: Int) -> Int { x + 1 }
    g_plain(1)
}

fn main() { let x = 1 }
"#
}

// A unit with no closure in it, so a thunk found in its output can only be a stale one.
fn plain_src() -> Str {
    #"fn plain(a: Int) -> Int { a }
fn main() { let x = 1 }
"#
}

fn reset_stages() {
    diag_reset()
    ir_reset()
    print_reset()
    layout_reset()
    cg_stmt_reset()
    cg_expr_reset()
    cg_eff_reset()
}

fn probe_program(name: Str, src: Str) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS.Delete {
    let path = "build/{name}.bl"
    let program = cg_probe_compile(path, src)
    let _ = fs.delete(path)
    program
}

fn setup_closure_program() -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS.Delete {
    reset_stages()
    let program = probe_program("cg_eff_thunk_drain_closure_probe", closure_src())
    cg_reg_build(program)
    diag_reset()
    program
}

// The closure literal a `let` of this name is initialized with. Every closure probe reads
// its subject this way, out of a binding the probe source really wrote, rather than out of
// a node the test built for itself. It is not in cg_test_helpers because that harness would
// then import cname_test_helpers for find_decl, and a name reachable through an import of
// an import counts as in scope, which makes assert_eq_str ambiguous in every suite file
// that also imports lower_test_helpers.
fn closure_of(let_name: Str) -> Int {
    let binding = find_decl(NodeKind.LetBinding, let_name, "")
    assert(binding >= 0)
    node_value(binding)
}

fn standalone_cfg() -> CgConfig {
    CgConfig { debug_mode: 0, trace_codegen: 0, deterministic: 0, emit_only_module: "",
        skip_modules: Map(), user_tu_mode: 0, blink_ev_extern_only: 0, archive_build_mode: 0 }
}

// The same steps the driver takes for one queued thunk: open its frame, lower its body
// through the statement stage, close the frame, print the definition.
fn drain_one(i: Int) ! Diag.Report {
    assert(cg_eff_thunk_open(i) >= 0)
    let body = lower_block_returning(cg_eff_thunk_body_node(i))
    cg_eff_thunk_close()
    assert(body >= 0)
    cg_eff_print_thunk(i, body)
}

test "one non-capturing closure prints exactly one thunk definition and the drain records nothing" {
    let _ = setup_closure_program()
    let _ = cg_eff_lower_closure(closure_of("g_plain"))
    assert_eq(cg_eff_pending_thunks(), 1)
    let symbol = cg_eff_thunk_symbol(0)
    drain_one(0)
    let text = print_take()
    if cg_text_occurrences(text, "{symbol}(") != 1 || cg_ice_count() != 0 {
        io.println("FAIL: expected one definition of {symbol}:")
        cg_report_ices("the drain reported")
        io.println(text)
    }
    assert_eq(cg_text_occurrences(text, "{symbol}("), 1)
    assert_eq(cg_text_occurrences(text, "{symbol}(const blink_closure* __self, int64_t"), 1)
    cg_eff_thunks_drained(1)
    assert_eq(cg_eff_pending_thunks(), 0)
    assert_eq(cg_ice_count(), 0)
}

test "two emits in one process start the second with an empty queue" {
    let _ = setup_closure_program()
    let _ = cg_eff_lower_closure(closure_of("g_plain"))
    let stale = cg_eff_thunk_symbol(0)
    assert_eq(cg_eff_pending_thunks(), 1)
    let plain = probe_program("cg_eff_thunk_drain_plain_probe", plain_src())
    run_mono(plain)
    let text = generate(plain, standalone_cfg())
    if cg_eff_pending_thunks() != 0 || text.index_of(stale) >= 0 {
        io.println("FAIL: the stale thunk {stale} survived into the next unit:")
        cg_report_ices("the second unit reported")
    }
    assert_eq(cg_eff_pending_thunks(), 0)
    assert(text.index_of(stale) < 0)
    assert_eq(cg_ices_named("ThunkQueueNotDrained"), 0)
    assert_eq(cg_ices_named("NoSuchThunk"), 0)
    assert_eq(cg_ices_named("ThunkFrameNested"), 0)
    assert_eq(cg_ices_named("UnspellableThunkSlot"), 0)
    assert_eq(cg_ices_named("ClosureTypeHasNoSlot"), 0)
}

test "a drain count that does not match the queue is an internal error and keeps the queue" {
    let _ = setup_closure_program()
    let _ = cg_eff_lower_closure(closure_of("g_plain"))
    cg_eff_thunks_drained(0)
    assert_eq(cg_ices_saying("ThunkQueueNotDrained", "the driver printed 0 thunks but 1 are queued"), 1)
    assert_eq(cg_ice_count(), 1)
    assert_eq(cg_eff_pending_thunks(), 1)
}

test "printing a thunk the queue does not hold is an internal error and prints nothing" {
    let _ = setup_closure_program()
    let _ = cg_eff_lower_closure(closure_of("g_plain"))
    drain_one(0)
    let _ = print_take()
    cg_eff_print_thunk(1, 0)
    assert_eq(cg_ices_saying("NoSuchThunk", "thunk 1 is not in the queue of 1"), 1)
    assert_eq(cg_ice_count(), 1)
    assert_eq(cg_text_occurrences(print_take(), "closure"), 0)
}
