// Which cleanup protocol a `with <expr> as <name>` resource gets, answered from the
// resource's tid.
//
// Three answers. A type that implements BlockHandler hands the block its context and takes
// an exit(ok) on every path; a Closeable type is one, through the impl the parser writes
// for it (sections/04_effects.md §4.7.2). An FFI scope frees its arena. Anything else is a
// plain binding that runs nothing on the way out; typecheck refuses such an item (E0839),
// so the plain answer is proved on a probe compiled with that error expected, and is the
// answer codegen gives if that gate ever relaxes.
//
// The FFI scope carries the symbol the guard local runs on the way out: the runtime's own.
// A BlockHandler must also call enter(), which no resource does, so the with stage lowers
// it through cg_eff_block_handler_calls and never asks this seam. Asked anyway, the seam
// answers the protocol with no symbol and one internal error, never a guessed symbol.

import cname.{c_impl_method_name}
import cname_test_helpers.{find_decl, find_impl}
import cg_test_helpers.{
    cg_ice_count, cg_ices_mentioning, cg_probe_compile, cg_probe_compile_but,
}
import ast.{NodeKind}
import cg_reg.{cg_reg_build}
import cg_eff.{CleanupProtocol, cg_eff_block_handler_calls, cg_eff_block_handler_impl, cg_eff_resource_cleanup}
import layout.{tid_of_node}
import parser.{node_value}
import typecheck.{TYPE_INT}
import diagnostics.{diag_reset}
import std.fs
import std.io

fn probe_src() -> Str {
    #"import std.traits

type Logged { n: Int }
type Guarded { fd: Int }
type Latch { Open, Closed }

impl Closeable for Logged {
    fn close(self) {}
}

impl Closeable for Latch {
    fn close(self) {}
}

impl BlockHandler for Guarded {
    type Context = Int
    fn enter(self) -> Int { self.fd }
    fn exit(self, _ok: Bool) {}
}

fn main() {
    let l = Logged { n: 2 }
    let g = Guarded { fd: 3 }
    let h = Latch.Open
    with l as logged { io.println("{logged.n}") }
    with g as guarded { io.println("{guarded}") }
    with h as latch { io.println("{latch.to_int()}") }
    with ffi.scope() as scope { let _ = scope }
}
"#
}

// Items that are neither a handler nor a scoped value: typecheck refuses each (E0839).
fn refused_probe_src() -> Str {
    #"type Plainish { v: Int }
type Boxed[T] { v: T }

fn hold[T](r: T) -> Int {
    with r as unsubstituted {
        0
    }
}

fn main() {
    let p = Plainish { v: 1 }
    let bx = Boxed { v: 5 }
    with p as plain { io.println("{plain.v}") }
    with bx as boxed { io.println("{boxed.v}") }
    io.println("{hold(1)}")
}
"#
}

// A generic receiver written with type arguments claims ONE instance, and every instance
// shares the generic's declaration node, so the declaration alone cannot tell `Boxed[Int]`
// from `Boxed[Str]`. E0908 rejects the shape at typecheck today, which is why this probe
// is compiled on its own and its errors are expected: the point is that cg_eff does not
// answer the wrong protocol if that gate ever relaxes.
fn illegal_probe_src() -> Str {
    #"import std.traits

type Boxed[T] { v: T }

impl Closeable for Boxed[Int] {
    fn close(self) {}
}

fn main() {
    let a = Boxed { v: 1 }
    let b = Boxed { v: "s" }
    with a as ai { io.println("{ai.v}") }
    with b as bs { io.println("{bs.v}") }
}
"#
}

// The same instance impl written as a BlockHandler, which goes to the impl matcher itself.
fn instance_block_handler_src() -> Str {
    #"import std.traits

type Boxed[T] { v: T }

impl BlockHandler for Boxed[Int] {
    type Context = Int
    fn enter(self) -> Int { 0 }
    fn exit(self, _ok: Bool) {}
}

fn main() {
    let a = Boxed { v: 1 }
    let b = Boxed { v: "s" }
    with a as ai { io.println("{ai}") }
    with b as bs { io.println("{bs}") }
}
"#
}

fn compile(stem: Str, src: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS.Delete {
    let path = "build/{stem}.bl"
    let program = cg_probe_compile(path, src)
    let _ = fs.delete(path)
    cg_reg_build(program)
}

// The same for a probe whose source the front end rejects by one named error, which the
// probe expects and which must still be recorded.
fn compile_expecting(stem: Str, src: Str, expected: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS.Delete {
    let path = "build/{stem}.bl"
    let program = cg_probe_compile_but(path, src, expected)
    let _ = fs.delete(path)
    cg_reg_build(program)
}

// The probe is compiled once per test: the registry and the diagnostics list are process
// globals, so a test that read another test's leftovers would not be reading its own.
fn setup() ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS.Delete {
    diag_reset()
    compile("cg_eff_with_resource_cleanup_probe", probe_src())
}

fn setup_refused() ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS.Delete {
    diag_reset()
    compile_expecting("cg_eff_with_resource_refused_probe", refused_probe_src(), "NonHandlerWithItem")
}

// One `with <expr> as <name>` item of the probe, named by the binder it introduces. The
// seam takes the item, so every case below asks it about a resource a program really
// wrote rather than about a type id assembled by hand.
fn item(binder: Str) -> Int {
    find_decl(NodeKind.WithResource, binder, "")
}

test "a type that implements no protocol is a plain binding that runs nothing" {
    setup_refused()
    diag_reset()
    let rc = cg_eff_resource_cleanup(item("plain"))
    assert(rc.protocol == CleanupProtocol.Plain)
    assert_eq(rc.impl_block, -1)
    assert_eq(cg_ice_count(), 0)
}

// A generic type's instance shares its declaration with every other instance, and no impl
// claims it, so this is the plain answer reached the long way: through the impl scan.
test "an instance of a generic type with no impl is a plain binding" {
    setup_refused()
    diag_reset()
    let rc = cg_eff_resource_cleanup(item("boxed"))
    assert(rc.protocol == CleanupProtocol.Plain)
    assert_eq(rc.impl_block, -1)
    assert_eq(cg_ice_count(), 0)
}

test "a Closeable struct takes the block handler protocol through the impl the parser writes" {
    setup()
    diag_reset()
    let bh = find_impl("Logged", "BlockHandler", "")
    assert(bh >= 0)
    assert_eq(cg_eff_block_handler_impl(node_value(item("logged"))), bh)
    assert_eq(cg_ice_count(), 0)
}

// An enum carries a declaration an impl block can be written for, exactly as a struct
// does, so the protocol cannot be keyed on structs alone.
test "a Closeable enum takes the block handler protocol through the impl the parser writes" {
    setup()
    diag_reset()
    let bh = find_impl("Latch", "BlockHandler", "")
    assert(bh >= 0)
    assert_eq(cg_eff_block_handler_impl(node_value(item("latch"))), bh)
    assert_eq(cg_ice_count(), 0)
}

// The binder of a BlockHandler resource holds the handler's Context, which for this probe
// is `Int`. Reading the binder's type instead of the resource's would answer a plain
// binding and never run exit(), so the seam takes the item and reads the resource itself.
test "a BlockHandler resource takes the enter and exit protocol, not its Context's answer" {
    setup()
    diag_reset()
    let rc = cg_eff_resource_cleanup(item("guarded"))
    assert(rc.protocol == CleanupProtocol.BlockHandler)
    assert_eq(rc.impl_block, find_impl("Guarded", "BlockHandler", ""))
}

// The with stage asks this of every item's expression before choosing a path, so an FFI
// scope answering an impl here would lose its own cleanup.
test "a BlockHandler item's expression answers its impl, and a resource's answers none" {
    setup()
    diag_reset()
    let bh = find_impl("Guarded", "BlockHandler", "")
    assert_eq(cg_eff_block_handler_impl(node_value(item("guarded"))), bh)
    assert_eq(cg_eff_block_handler_impl(node_value(item("scope"))), -1)
    assert_eq(cg_ice_count(), 0)
}

test "a BlockHandler's calls name its exit method and type its Context from enter" {
    setup()
    diag_reset()
    let bh = find_impl("Guarded", "BlockHandler", "")
    let expr = node_value(item("guarded"))
    let calls = cg_eff_block_handler_calls(bh, tid_of_node(expr), item("guarded"))
    assert_eq(calls.impl_block, bh)
    assert_eq(calls.exit_symbol, c_impl_method_name(bh, "exit"))
    assert_eq(calls.context_tid, TYPE_INT)
    assert_eq(cg_ice_count(), 0)
}

test "an FFI scope resource takes the scope protocol, not a plain binding" {
    setup()
    diag_reset()
    let rc = cg_eff_resource_cleanup(item("scope"))
    assert(rc.protocol == CleanupProtocol.FfiScope)
    assert_eq(rc.impl_block, -1)
}

// A BlockHandler reaching this seam means the with stage failed to route it. It travels
// with its impl block and one internal error, rather than degrading to a plain binding
// that would never run exit().
test "a BlockHandler resource reports exactly one internal error, naming what is missing" {
    setup()
    diag_reset()
    let rc = cg_eff_resource_cleanup(item("guarded"))
    assert(rc.protocol == CleanupProtocol.BlockHandler)
    assert_eq(rc.exit_symbol, "")
    if cg_ice_count() != 1 {
        io.println("FAIL: guarded: {cg_ice_count()} internal errors, want 1")
    }
    assert_eq(cg_ice_count(), 1)
}

// A Closeable's exit is the exit method of the impl the parser writes, and its Context is
// the value itself. Both probes are checked, because a struct and an enum reach it by
// different declaration shapes. The expected symbol is built by the producer the
// definition is spelled with, never written out, so a rename moves both.
test "a Closeable struct names the impl's exit symbol and takes itself as Context" {
    setup()
    diag_reset()
    let bh = find_impl("Logged", "BlockHandler", "")
    let expr = node_value(item("logged"))
    let calls = cg_eff_block_handler_calls(bh, tid_of_node(expr), item("logged"))
    assert_eq(calls.exit_symbol, c_impl_method_name(bh, "exit"))
    assert_eq(calls.context_tid, tid_of_node(expr))
    assert_eq(cg_ice_count(), 0)
}

test "a Closeable enum names the impl's exit symbol and takes itself as Context" {
    setup()
    diag_reset()
    let bh = find_impl("Latch", "BlockHandler", "")
    let expr = node_value(item("latch"))
    let calls = cg_eff_block_handler_calls(bh, tid_of_node(expr), item("latch"))
    assert_eq(calls.exit_symbol, c_impl_method_name(bh, "exit"))
    assert_eq(calls.context_tid, tid_of_node(expr))
    assert_eq(cg_ice_count(), 0)
}

// FfiScope is the one protocol here with a runner of its own: the runtime's
// blink_ffi_scope_cleanup, so it reports no internal error.
test "an FFI scope resource reports no internal error" {
    setup()
    diag_reset()
    let rc = cg_eff_resource_cleanup(item("scope"))
    assert_eq(rc.protocol, CleanupProtocol.FfiScope)
    assert_eq(rc.exit_symbol, "blink_ffi_scope_cleanup")
    assert_eq(cg_ice_count(), 0)
}

// An unsubstituted binder cannot be asked which protocol it takes. Answering Plain would
// leave a scoped value never exited with nothing said about it.
test "an unsubstituted typevar resource is an internal error, not a plain binding" {
    setup_refused()
    diag_reset()
    let rc = cg_eff_resource_cleanup(item("unsubstituted"))
    assert(rc.protocol == CleanupProtocol.Plain)
    assert(cg_ices_mentioning("unsubstituted") > 0)
}

// The seam reads the resource expression off the item it is given, so a node that is not
// a with-resource has no resource to read. It reports rather than answering the plain
// binding, which would drop a cleanup that a real resource needed.
test "a node that is not a with-resource item is an internal error, not a plain binding" {
    setup()
    diag_reset()
    let rc = cg_eff_resource_cleanup(find_decl(NodeKind.WithBlock, "", ""))
    assert(rc.protocol == CleanupProtocol.Plain)
    assert(cg_ice_count() > 0)
}

// A receiver written with type arguments matches the generic's declaration, so the
// scoped-value selector would hand `Boxed[Str]` the impl written for `Boxed[Int]`. It reports
// instead, and reports for `Boxed[Int]` too: the two are indistinguishable here. E0908
// rejects the shape at typecheck today, so the probe is compiled on its own with that
// error expected.
test "a Closeable impl written for one instance of a generic type is reported, not matched" {
    diag_reset()
    compile_expecting("cg_eff_generic_recv_probe", illegal_probe_src(), "PolyImplUnsupported")
    let what = "Closeable impl is written for a generic type"
    for binder in ["ai", "bs"] {
        diag_reset()
        assert_eq(cg_eff_block_handler_impl(node_value(item(binder))), -2)
        if cg_ices_mentioning(what) != 1 {
            io.println("FAIL: {binder}: {cg_ices_mentioning(what)} internal errors")
        }
        assert_eq(cg_ices_mentioning(what), 1)
    }
}

test "a BlockHandler impl written for one instance of a generic type is reported, not matched" {
    diag_reset()
    compile_expecting("cg_eff_instance_bh_probe", instance_block_handler_src(), "PolyImplUnsupported")
    let what = "one instance of a generic type"
    for binder in ["ai", "bs"] {
        diag_reset()
        assert_eq(cg_eff_block_handler_impl(node_value(item(binder))), -2)
        if cg_ices_mentioning(what) != 1 {
            io.println("FAIL: {binder}: {cg_ices_mentioning(what)} internal errors")
        }
        assert_eq(cg_ices_mentioning(what), 1)
    }
}
