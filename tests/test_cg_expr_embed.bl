// `#embed` is a compile-time file read. The bytes become one string constant, so nothing
// about the file survives into the generated program: no array declaration, no runtime
// read, no name for a later stage to declare.
//
// The thing that is easy to get wrong and is pinned here is the path: it is written
// relative to the source file that holds the `#embed`, not to the directory the compiler
// runs in, because the stdlib registry writes every one of its paths that way.

import lower_test_helpers.{probe, rhs_of, assert_kind, assert_eq_str, assert_verifies}
import ir.{IrKind, ir_c_name, ir_c_spelling}
import cg_expr.{lower_expr}

let data_path = "../tests/test_embed_data.txt"

fn src() -> Str {
    "fn main() \{\n    let text = #embed(\"{data_path}\")\n\}\n"
}

fn sibling_src() -> Str {
    "fn main() \{\n    let sib = #embed(\"cg_expr_embed_sibling.txt\")\n\}\n"
}

test "an embedded file is one string constant holding the file's bytes" {
    probe("cg_expr_embed", src())
    let id = lower_expr(rhs_of("text"))
    assert_kind("kind", id, IrKind.Const)
    assert_eq_str("type", ir_c_spelling(id), "const char*")
    assert_eq_str("text", ir_c_name(id), #""Hello from embedded file!\nLine 2 with \"quotes\" and {braces}.\n""#)
    assert_verifies("verify", id)
}

test "the path is read relative to the file holding the #embed, not the process directory" {
    write_file("build/cg_expr_embed_sibling.txt", "sibling\n")
    probe("cg_expr_embed_sibling", sibling_src())
    let id = lower_expr(rhs_of("sib"))
    assert_kind("kind", id, IrKind.Const)
    assert_eq_str("text", ir_c_name(id), #""sibling\n""#)
}

// A path that names no file is proved in
// tests/test_diagnostics_loader_reports_a_missing_embed_target.bl. The loader reports it
// and stops, so a probe never reaches the lowering stage's own check of the same path.
