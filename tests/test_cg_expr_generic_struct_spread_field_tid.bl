// A spread over a GENERIC struct instance. The field the literal does not name is copied
// from the source, and the copy has to carry the field's type AT THIS INSTANCE — Int for a
// ZzHold[Int] — not the declaration's type parameter.
//
// The declared reader normalises an instance tid back to the base declaration on purpose,
// because binding a spread's parameters needs the un-substituted form. Codegen needs the
// opposite answer: a FieldGet stamped with a bare type parameter names no C type, so the
// emitted read has no width and mono never sees an instance to register.

import lower_test_helpers.{probe, rhs_of, assert_kind, assert_eq_str, assert_shape}
import ir.{IrKind, ir_c_name, ir_kid, ir_tid}
import cg_expr.{lower_expr}
import typecheck.{tc_type_str, TYPE_INT}

fn src() -> Str {
    #"type ZzHold[T] { value: T, tag: Int }
type ZzFlat { value: Int, tag: Int }
fn zzsource() -> ZzHold[Int] { ZzHold { value: 7, tag: 1 } }
fn zzflat() -> ZzFlat { ZzFlat { value: 7, tag: 1 } }
fn main() {
    let zzbase = zzsource()
    let zzmoved = ZzHold { tag: 2, ..zzbase }
    let zzfbase = zzflat()
    let zzfmoved = ZzFlat { tag: 2, ..zzfbase }
    let _keep = [zzmoved.value, zzfmoved.value]
}
"#
}

// The FieldGet the spread produced for `value`. Fields come out in declaration order and
// the literal names only `tag`, so the first field of the StructNew is the spread's copy.
fn spread_copy_of(binding: Str) -> Int ! Diag.Report {
    let id = lower_expr(rhs_of(binding))
    assert_kind("kind", id, IrKind.StructNew)
    assert_shape("shape", id, "StructNew(FieldGet(VarRef), Const)")
    assert_eq_str("the copied field", ir_c_name(ir_kid(id, 0)), "value")
    ir_kid(id, 0)
}

test "a spread over a generic instance copies the field at the instance type" {
    probe("cg_expr_gen_spread", src())
    let got = ir_tid(spread_copy_of("zzmoved"))
    assert_eq_str("field type", tc_type_str(got), tc_type_str(TYPE_INT))
    assert_eq(got, TYPE_INT)
}

test "the non-generic twin copies the same field the same way" {
    probe("cg_expr_gen_spread", src())
    assert_eq(ir_tid(spread_copy_of("zzfmoved")), TYPE_INT)
}
