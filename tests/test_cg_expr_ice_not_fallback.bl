// What lowering refuses. Every miss here is an internal error with a name and a node; none
// of them is a guess, a default type or a placeholder value.

import lower_test_helpers.{
    probe, rhs_of, assert_ice_saying, assert_eq_str, assert_kind, ice_count, assert_verifies,
}
import parser.{node_obj, node_elements, sublist_get}
import cg_expr.{lower_expr, cg_expr_register_value}
import ir.{IrKind, ir_c_name, ir_kid, ir_kops_table}
import diagnostics.{diag_entries}

fn src() -> Str {
    #"type Colour { Red, Green }
fn wrap[T](v: T) -> Option[T] {
    let held = Some(v)
    held
}
fn same[T: Eq](a: T, b: T) -> Bool {
    let alike = a == b
    alike
}
fn main() {
    let red = Colour.Red
    let list = [1, 2, 3]
    let at = list[0]
    let f = fn(x: Int) -> Int { x + 1 }
    let called = f(1)
    assert(called >= 0)
    let m = at.to_str()
    let bare_map: Map[Int, Int] = Map()
    let branch = if called > 0 { 1 } else { 2 }
    let span = 1..3
    let copied = [..list, 4]
    let _keep = [red, Colour.Green]
    let _keep2 = [at, branch, span.len()]
    let _keep3 = [copied.len(), bare_map.len()]
    let _keep4 = [m]
}
"#
}

test "an expression carrying no type refuses to lower" {
    probe("cg_expr_ice", src())
    let type_name = node_obj(rhs_of("red"))
    assert_ice_saying("bare type name", lower_expr(type_name), "NoTypeForNode",
        "reached layout with no recorded type")
}

test "a carrier whose payload is still a type parameter refuses to lower" {
    probe("cg_expr_ice", src())
    assert_ice_saying("generic Some", lower_expr(rhs_of("held")), "UnspellableExprType",
        "no C layout")
}

// This file's other tests say a gap is refused out loud. This one says the opposite of the
// same rule: a read that IS built answers a value and records nothing, because a stage that
// quietly recorded an internal error and answered anyway would read as built from outside.
test "a built index read answers a value and records no internal error" {
    probe("cg_expr_ice", src())
    let before = ice_count()
    let id = lower_expr(rhs_of("at"))
    assert_kind("index read", id, IrKind.Cast)
    assert_eq_str("reader", ir_c_name(ir_kid(ir_kid(id, 0), 0)), "blink_list_get")
    assert_eq(ice_count(), before)
}

// The other half of this file's rule, as for the index read above: a stage that quietly
// recorded an internal error and answered anyway would read as built from outside.
test "a built closure value answers a record and records no internal error" {
    probe("cg_expr_ice", src())
    let before = ice_count()
    let id = lower_expr(rhs_of("f"))
    assert_kind("closure value", id, IrKind.ClosureNew)
    assert_eq(ice_count(), before)
}

// The method here has to be one no impl block declares, and one no seam claims by name. A
// method a stdlib impl declares, `len` among them, now reaches the body that impl writes,
// `get` is the name the checked element read answers to, and `contains` is the name the
// element scan answers to, so any of them would stop measuring the refusal this test is
// about. Map and Set both have a table arm now, so their methods no longer measure it
// either. `Int.to_str` is the stable choice: how a scalar renders itself is held open by a
// spec question, so no slice can claim it until that question is answered.
//
// The free call used to be a bare `Map()`: is_builtin_fn knows the name, but the
// runtime-ctor table this stage reads a bare constructor from carried no row for it. It now
// builds, reading the runtime constructor and the key's operations table off the same tid a
// qualified `Map.new()` would, so this half of the test instead pins that the build was
// delegated to the call stage rather than assembled here. `assert` no longer measures this
// either: it now answers its own named refusal instead of the generic one, and a closure
// value now calls through its own `fn_ptr` rather than refusing.
test "a call this build delegates is built, and a method call it cannot dispatch is refused" {
    probe("cg_expr_ice", src())
    let built = lower_expr(rhs_of("bare_map"))
    assert_kind("free call", built, IrKind.ContainerNew)
    assert_eq_str("ctor", ir_c_name(built), "blink_map_new")
    assert(ir_kops_table(built) != "")
    assert_verifies("bare_map", built)
    let mut refusals = 0
    for d in diag_entries {
        let is_stage_gap = d.severity == "ice" && d.name == "CodegenStageNotBuilt"
        let mentions_this_call = d.message.contains("free call") || d.message.contains("Map()")
        if is_stage_gap && mentions_this_call { refusals = refusals + 1 }
    }
    assert_eq(refusals, 0)
    assert_ice_saying("method call", lower_expr(rhs_of("m")), "CodegenStageNotBuilt",
        "methods")
}

test "an if in value position is refused unless the statement stage claimed its temp" {
    probe("cg_expr_ice", src())
    assert_ice_saying("unmaterialised if", lower_expr(rhs_of("branch")), "UnmaterialisedValueExpr",
        "in value position was not materialised")
}

test "an expression kind with no arm is named, not silently dropped" {
    probe("cg_expr_ice", src())
    assert_ice_saying("range", lower_expr(rhs_of("span")), "UnhandledExprKind",
        "has no lowering")
}

test "a spread with no container around it is refused: no literal names its destination" {
    probe("cg_expr_ice", src())
    let element = sublist_get(node_elements(rhs_of("copied")), 0)
    assert_ice_saying("bare spread", lower_expr(element), "SpreadElementNotLowered",
        "no container to copy into")
}

test "a materialised value registered without a type is refused, not read untyped" {
    probe("cg_expr_ice", src())
    let branch = rhs_of("branch")
    cg_expr_register_value(branch, "_t1", -1)
    assert_ice_saying("typeless temp", lower_expr(branch), "MaterialisedValueHasNoType",
        "registered without a type")
}

test "an operand with no C layout is named as unspellable, not as needing dispatch" {
    probe("cg_expr_ice", src())
    assert_ice_saying("typevar operand", lower_expr(rhs_of("alike")), "UnspellableExprType",
        "no C layout")
}
