// `xs[i]` with a value in the brackets. Blink has no index operator (sections/03_types.md
// §3.4), so typecheck reports every such read as NoIndexOperator (E0313) and names the
// `.get` call that reads the element instead. Codegen holds no lowering for the read: an
// IndexExpr that reaches lower_expr anyway is an internal error, not a value. Every test of
// that refusal starts at lower_expr, the entry a statement reaches.

import lower_test_helpers.{probe_but, rhs_of, assert_ice_saying, assert_refused_saying}
import ir.{ir_node_count}
import cg_expr.{lower_expr}
import diagnostics.{diag_entries}
import std.io

fn src_reads() -> Str {
    #"fn main() {
    let nums = [1, 2, 3]
    let at = 1
    let literal_read = nums[0]
    let named_read = nums[at]
    let compound_read = nums[at + 1]
    let past_end = nums[99]
    let words = ["a", "b"]
    let word_read = words[at]
    let reals = [1.5, 2.5]
    let real_read = reals[at]
    let opts = [Some(1), None]
    let opt_read = opts[at]
    let _keep = [literal_read, named_read, compound_read, past_end]
    let _keep2 = [word_read.len(), real_read.to_int(), opt_read.unwrap()]
}
"#
}

// Exactly one NoIndexOperator says `help`, so each row pins the read it names.
fn assert_help(label: Str, help: Str) {
    let mut found = 0
    for d in diag_entries {
        if d.severity == "error" && d.name == "NoIndexOperator" && d.help == help { found = found + 1 }
    }
    if found != 1 {
        io.println("FAIL: {label}: {found} NoIndexOperator errors with help '{help}', want 1:")
        for d in diag_entries {
            if d.severity == "error" { io.println("  {d.name}: {d.message} | help: {d.help}") }
        }
    }
    assert_eq(found, 1)
}

test "a literal index is NoIndexOperator, and the help names the .get read" {
    probe_but("cg_expr_index", src_reads(), "NoIndexOperator")
    assert_refused_saying("one per read", "Blink has no index operator", 7)
    assert_help("literal", "`nums.get(0)` returns `Option[Int]`")
}

test "a named index is NoIndexOperator, and the help names it as the .get argument" {
    probe_but("cg_expr_index", src_reads(), "NoIndexOperator")
    assert_help("named", "`nums.get(at)` returns `Option[Int]`")
}

test "a compound index is NoIndexOperator, and the help keeps the whole index" {
    probe_but("cg_expr_index", src_reads(), "NoIndexOperator")
    assert_help("compound", "`nums.get(at + 1)` returns `Option[Int]`")
}

// The compiler does not know the list's length, so an index past the end is refused for the
// same reason as any other, and not for its value.
test "an index past the end is NoIndexOperator like any other constant index" {
    probe_but("cg_expr_index", src_reads(), "NoIndexOperator")
    assert_help("past the end", "`nums.get(99)` returns `Option[Int]`")
}

fn src_str_index() -> Str {
    #"fn main() {
    let nums = [1, 2, 3]
    let key = "one"
    let refused = nums[key]
    let _keep = [refused]
}
"#
}

// A read is refused before its index type is checked, so a Str index gets the one report
// and no TypeError beside it.
test "an index that is not an Int is NoIndexOperator alone" {
    probe_but("cg_expr_index_str", src_str_index(), "NoIndexOperator")
    assert_refused_saying("str index", "index must be an Int", 0)
    assert_help("str index", "`nums.get(key)` returns `Option[Int]`")
}

test "a Str element read is NoIndexOperator, and the help names its Option" {
    probe_but("cg_expr_index", src_reads(), "NoIndexOperator")
    assert_help("word", "`words.get(at)` returns `Option[Str]`")
}

test "a Float element read is NoIndexOperator, and the help names its Option" {
    probe_but("cg_expr_index", src_reads(), "NoIndexOperator")
    assert_help("real", "`reals.get(at)` returns `Option[Float]`")
}

// An element that is itself an Option comes back wrapped once more, and the help says so
// rather than naming the element type alone.
test "an element whose own type is a carrier gets help that names the nested Option" {
    probe_but("cg_expr_index", src_reads(), "NoIndexOperator")
    assert_help("opt", "`opts.get(at)` returns `Option[Option[Int]]`")
}

// The refusal must not build an operand before it refuses, or the operand is stranded in the
// arena with no statement that names it.
test "an index read that reaches lower_expr is an internal error and leaves no node behind" {
    probe_but("cg_expr_index", src_reads(), "NoIndexOperator")
    let before = ir_node_count()
    assert_ice_saying("index read", lower_expr(rhs_of("named_read")),
        "IndexExprReachedCodegen", "an index expression reached codegen")
    assert_eq(ir_node_count(), before)
}

fn src_generic_element() -> Str {
    #"fn pick[T](xs: List[T]) -> T {
    let got = xs[0]
    got
}
fn main() {
    let nums = [1, 2, 3]
    let _keep = [pick(nums)]
}
"#
}

test "an index read in a generic body is NoIndexOperator before any instance is built" {
    probe_but("cg_expr_index_generic", src_generic_element(), "NoIndexOperator")
    assert_refused_saying("generic", "Blink has no index operator", 1)
    assert_help("generic", "`xs.get(0)` returns `Option[T]`")
}
