// `xs[i]` lowered as an expression. The read itself belongs to the call stage, which owns
// the one reader `[i]` and `.get(i)` share; this stage only finds the two operands and
// hands them over. Every test of a lowering starts at lower_expr, the entry a statement
// reaches, so such a test fails if the dispatch arm is missing rather than passing on a
// direct call to the seam.

import lower_test_helpers.{
    probe, probe_but, rhs_of, assert_kind, assert_eq_str, assert_shape, assert_verifies,
    assert_ice_saying, assert_refused_saying,
}
import ir.{IrKind, ir_c_name, ir_c_spelling, ir_kid, ir_node_count}
import cg_expr.{lower_expr, cg_expr_pending_count, cg_expr_take_pending}

fn src_reads() -> Str {
    #"fn main() {
    let nums = [1, 2, 3]
    let at = 1
    let literal_read = nums[0]
    let named_read = nums[at]
    let compound_read = nums[at + 1]
    let past_end = nums[99]
    let words = ["a", "b"]
    let word_read = words[at]
    let reals = [1.5, 2.5]
    let real_read = reals[at]
    let opts = [Some(1), None]
    let opt_read = opts[at]
    let _keep = [literal_read, named_read, compound_read, past_end]
    let _keep2 = [word_read.len(), real_read.to_int(), opt_read.unwrap()]
}
"#
}

test "a literal index reads the element through the container's runtime reader" {
    probe("cg_expr_index", src_reads())
    let id = lower_expr(rhs_of("literal_read"))
    assert_kind("kind", id, IrKind.Cast)
    assert_shape("shape", id, "Cast(Cast(CallRuntime(VarRef, Const)))")
    assert_eq_str("reader", ir_c_name(ir_kid(ir_kid(id, 0), 0)), "blink_list_get")
    assert_verifies("verify", id)
}

test "a named index lowers its operand like any other expression" {
    probe("cg_expr_index", src_reads())
    let id = lower_expr(rhs_of("named_read"))
    assert_shape("shape", id, "Cast(Cast(CallRuntime(VarRef, VarRef)))")
    assert_eq_str("reader", ir_c_name(ir_kid(ir_kid(id, 0), 0)), "blink_list_get")
    assert_verifies("verify", id)
}

// The add is checked (sections/03_types.md:781), so it runs once ahead of the read: the
// Const held once, the result temp, one overflow test, and the reader reads that temp.
test "a compound index is lowered whole, not folded or re-read" {
    probe("cg_expr_index", src_reads())
    let mark = cg_expr_pending_count()
    let id = lower_expr(rhs_of("compound_read"))
    let pre = cg_expr_take_pending(mark)
    assert_shape("shape", id, "Cast(Cast(CallRuntime(VarRef, VarRef)))")
    assert_verifies("verify", id)
    assert_eq(pre.len(), 3)
    assert_shape("const held once", pre.get(0).unwrap(), "Let(Const)")
    assert_shape("result temp", pre.get(1).unwrap(), "Let")
    assert_shape("one checked add", pre.get(2).unwrap(),
        "If(CallRuntime(VarRef, VarRef, Unary(VarRef)), Block(Panic(CallRuntime(Const, Cast(VarRef), Cast(VarRef)))))")
    assert_eq_str("add", ir_c_name(ir_kid(pre.get(2).unwrap(), 0)), "__builtin_add_overflow")
    let index = ir_kid(ir_kid(ir_kid(id, 0), 0), 1)
    assert_eq_str("reads the result", ir_c_name(index), ir_c_name(pre.get(1).unwrap()))
}

// Nothing here knows the container's length, and a constant index is not a promise about
// it: the bounds test is the runtime reader's. An index past the end must therefore lower
// exactly like any other constant, or this stage would be deciding a question it cannot see.
test "an index past the end lowers like any other constant index" {
    probe("cg_expr_index", src_reads())
    let past = lower_expr(rhs_of("past_end"))
    let inside = lower_expr(rhs_of("literal_read"))
    assert_shape("past the end", past, "Cast(Cast(CallRuntime(VarRef, Const)))")
    assert_shape("inside", inside, "Cast(Cast(CallRuntime(VarRef, Const)))")
    assert_eq_str("same reader", ir_c_name(ir_kid(past, 0)), ir_c_name(ir_kid(inside, 0)))
    assert_verifies("verify", past)
}

fn src_str_index() -> Str {
    #"fn main() {
    let nums = [1, 2, 3]
    let key = "one"
    let refused = nums[key]
    let _keep = [refused]
}
"#
}

// A Str index is typecheck's to refuse, and it does. This stage never sees one, so it needs
// no arm for it; the test is here to keep that boundary where it is. The code alone would
// not say so — every type error carries it — so the sentence is what the test reads.
test "an index that is not an Int is refused before this stage, by typecheck" {
    probe_but("cg_expr_index_str", src_str_index(), "TypeError")
    assert_refused_saying("str index", "index must be an Int", 1)
}

// A Str is already the width of the runtime's word, so it takes no integer on the way back
// and needs one cast where an Int needs two. One reader serves both, which is the point of
// there being one.
test "a pointer element reads through the same one reader, with no word between" {
    probe("cg_expr_index", src_reads())
    let id = lower_expr(rhs_of("word_read"))
    assert_shape("shape", id, "Cast(CallRuntime(VarRef, VarRef))")
    assert_eq_str("reader", ir_c_name(ir_kid(id, 0)), "blink_list_get")
    assert_verifies("verify", id)
}

// A double must not be punned through the runtime's integer word, so the runtime holds a
// Float behind a pointer. This stage still only hands the operands over: what comes back
// is the call stage's two-step read, the cast naming the slot's pointer and the
// dereference naming the element.
test "an element held behind a pointer comes back as a cast the read dereferences" {
    probe("cg_expr_index", src_reads())
    let id = lower_expr(rhs_of("real_read"))
    assert_kind("kind", id, IrKind.Unbox)
    assert_shape("shape", id, "Unbox(Cast(CallRuntime(VarRef, VarRef)))")
    assert_eq_str("cast type", ir_c_spelling(ir_kid(id, 0)), "double*")
    assert_eq_str("element type", ir_c_spelling(id), "double")
    assert_verifies("verify", id)
}

// An element that simply is an Option answers the same type a bounds-checked read answers,
// so the answer's type cannot say which read was written. The syntax can: this one is an
// index, so it reads the element and the carrier it finds there is just the element.
test "an element whose own type is a carrier is read, not taken for a checked result" {
    probe("cg_expr_index", src_reads())
    let id = lower_expr(rhs_of("opt_read"))
    assert_kind("kind", id, IrKind.Unbox)
    assert_shape("shape", id, "Unbox(Cast(CallRuntime(VarRef, VarRef)))")
    assert_eq_str("cast type", ir_c_spelling(ir_kid(id, 0)), "blink_Option_int*")
    assert_eq_str("element type", ir_c_spelling(id), "blink_Option_int")
    assert_verifies("verify", id)
}

fn src_unspellable_element() -> Str {
    #"fn pick[T](xs: List[T]) -> T {
    let got = xs[0]
    got
}
fn main() {
    let nums = [1, 2, 3]
    let _keep = [pick(nums)]
}
"#
}

// The dispatch arm must not build an operand of its own before handing the read on. It has
// none to build while the read is a straight delegation, so what this pins is that it stays
// one: an arm that lowered an operand first would strand it whenever the read refuses. The
// stage that owns the read pins the same count from its own side, where the reasons for the
// fixture and for counting rather than checking a shape are written down.
test "a refused index read leaves no orphan node behind in the arena" {
    probe("cg_expr_index_unspellable", src_unspellable_element())
    let before = ir_node_count()
    assert_ice_saying("unspellable element", lower_expr(rhs_of("got")),
        "UnspellableElementType", "container element has no C layout")
    assert_eq(ir_node_count(), before)
}
