// The leaf expressions: the five literal forms, a string with no holes, and a read of a
// binder in scope. Each lowers to one IR value node carrying the tid's C spelling.
//
// A shape the stage does not build yet must refuse. The two refusal tests below are the
// proof that an unbuilt kind and an out-of-scope name stop the caller instead of
// producing a value that would print as wrong C.

import lower_test_helpers.{
    probe, rhs_of, assert_kind, assert_eq_str, assert_ice, assert_verifies,
}
import ir.{IrKind, ir_c_name, ir_c_spelling, ir_tid}
import cg_expr.{lower_expr}
import layout.{bind_binder, binder_scope_pop, binder_scope_push, current_binder_scope, tid_of_node}

fn src() -> Str {
    #"fn main() {
    let i = 42
    let f = 1.5
    let b = true
    let c = 'q'
    let s = "hi"
    let esc = "a\"b\n"
    let sum = i + 1
    let again = i
}
"#
}

test "an int literal is one constant carrying the literal text and the Int spelling" {
    probe("cg_expr_leaf", src())
    let id = lower_expr(rhs_of("i"))
    assert_kind("kind", id, IrKind.Const)
    assert_eq_str("text", ir_c_name(id), "42")
    assert_eq_str("type", ir_c_spelling(id), "int64_t")
    assert_verifies("verify", id)
}

test "a float literal keeps its written form" {
    probe("cg_expr_leaf", src())
    let id = lower_expr(rhs_of("f"))
    assert_kind("kind", id, IrKind.Const)
    assert_eq_str("text", ir_c_name(id), "1.5")
    assert_eq_str("type", ir_c_spelling(id), "double")
}

test "a bool literal is 1 or 0, not a C keyword" {
    probe("cg_expr_leaf", src())
    let id = lower_expr(rhs_of("b"))
    assert_kind("kind", id, IrKind.Const)
    assert_eq_str("text", ir_c_name(id), "1")
    assert_eq_str("type", ir_c_spelling(id), "int")
}

test "a char literal is its code point at the Char spelling" {
    probe("cg_expr_leaf", src())
    let id = lower_expr(rhs_of("c"))
    assert_kind("kind", id, IrKind.Const)
    assert_eq_str("text", ir_c_name(id), "113")
    assert_eq_str("type", ir_c_spelling(id), "int32_t")
}

test "a string with no holes is one quoted constant, not a runtime call" {
    probe("cg_expr_leaf", src())
    let id = lower_expr(rhs_of("s"))
    assert_kind("kind", id, IrKind.Const)
    assert_eq_str("text", ir_c_name(id), #""hi""#)
    assert_eq_str("type", ir_c_spelling(id), "const char*")
}

test "a quote and a newline in a string are escaped once, by the name producer" {
    probe("cg_expr_leaf", src())
    let id = lower_expr(rhs_of("esc"))
    assert_eq_str("text", ir_c_name(id), #""a\"b\n""#)
}

test "a name bound in scope is a variable read at the binder's C spelling" {
    probe("cg_expr_leaf", src())
    let rhs = rhs_of("again")
    let scope = binder_scope_push()
    bind_binder(scope, "i", tid_of_node(rhs))
    let id = lower_expr(rhs)
    binder_scope_pop()
    assert_kind("kind", id, IrKind.VarRef)
    assert_eq_str("name", ir_c_name(id), "i")
    assert_eq_str("type", ir_c_spelling(id), "int64_t")
    assert_eq(ir_tid(id), tid_of_node(rhs))
}

test "a name with no binder in scope is refused, not spelled as a local" {
    probe("cg_expr_leaf", src())
    assert_eq(current_binder_scope(), -1)
    assert_ice("out of scope", lower_expr(rhs_of("again")), "CodegenStageNotBuilt")
}

// The stage reads the open frame rather than keeping a scope stack of its own, so the
// two cannot disagree about which names are in scope.
test "the frame lowering is inside is the one the statement stage last opened" {
    probe("cg_expr_leaf", src())
    let outer = binder_scope_push()
    assert_eq(current_binder_scope(), outer)
    let inner = binder_scope_push()
    assert_eq(current_binder_scope(), inner)
    binder_scope_pop()
    assert_eq(current_binder_scope(), outer)
    binder_scope_pop()
    assert_eq(current_binder_scope(), -1)
}

test "an expression kind this stage does not build yet is refused" {
    probe("cg_expr_leaf", src())
    assert_ice("binop", lower_expr(rhs_of("sum")), "CodegenStageNotBuilt")
}
