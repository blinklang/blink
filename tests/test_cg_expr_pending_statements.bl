// The pending buffer is how a lowered expression asks for statements to run before it.
// The call stage owns shapes this stage cannot lower, materialises each into a temp, and
// needs the same buffer for the statements that fill those temps. It cannot import this
// stage's private cell, so the push is a seam.

import lower_test_helpers.{probe, rhs_of, assert_eq_str, last_ice, last_ice_code}
import cg_expr.{
    lower_expr, cg_expr_reset, cg_expr_push_pending, cg_expr_pending_count,
    cg_expr_take_pending,
}
import ir.{ir_expr_stmt}

fn src() -> Str {
    #"fn main() {
    let one = 1
}
"#
}

// Order is the contract: the caller emits the list front to back, so a statement pushed
// first must run first. A buffer that answered in reverse would still pass a count test.
test "pushed statements come back in the order they were pushed" {
    probe("cg_expr_pending", src())
    let a = ir_expr_stmt(rhs_of("one"), lower_expr(rhs_of("one")))
    let b = ir_expr_stmt(rhs_of("one"), lower_expr(rhs_of("one")))
    let before = cg_expr_pending_count()
    cg_expr_push_pending(rhs_of("one"), a)
    cg_expr_push_pending(rhs_of("one"), b)
    assert_eq(cg_expr_pending_count(), before + 2)
    let out = cg_expr_take_pending()
    assert_eq(out.len(), before + 2)
    assert_eq(out.get(out.len() - 2).unwrap(), a)
    assert_eq(out.get(out.len() - 1).unwrap(), b)
}

// Taking the buffer empties it, so one unit's statements cannot be emitted twice or
// leak into the next expression the caller lowers.
test "taking the pending statements empties the buffer" {
    probe("cg_expr_pending", src())
    cg_expr_push_pending(rhs_of("one"), ir_expr_stmt(rhs_of("one"), lower_expr(rhs_of("one"))))
    let _ = cg_expr_take_pending()
    assert_eq(cg_expr_pending_count(), 0)
}

// A poisoned statement means the caller reported its own failure and carried on instead
// of stopping. Buffering it would put a node that does not exist in front of the
// expression that reads the temp it was meant to fill, and the printer would read the
// buffered id as a real node. The seam crosses a module boundary, so it cannot assume
// the caller's poison discipline and has to check.
test "a poisoned statement is refused rather than buffered" {
    probe("cg_expr_pending", src())
    cg_expr_reset()
    cg_expr_push_pending(rhs_of("one"), -1)
    assert_eq_str("poisoned push", last_ice(), "PendingStatementNotLowered")
    assert_eq_str("poisoned push code", last_ice_code(), "I0005")
    assert_eq(cg_expr_pending_count(), 0)
}

// Node id 0 is a real node, so the guard must test for negative and not for falsy. A
// guard written as `if stmt == 0` or `if !stmt` would refuse the first node the unit
// ever built.
test "statement id zero is a real statement and is buffered" {
    probe("cg_expr_pending", src())
    cg_expr_reset()
    cg_expr_push_pending(rhs_of("one"), 0)
    assert_eq(cg_expr_pending_count(), 1)
    let out = cg_expr_take_pending()
    assert_eq(out.len(), 1)
    assert_eq(out.get(0).unwrap(), 0)
}

// A caller that lost the statement may have lost the expression too. The node readers
// exit the process on an id that is not in the pool, so blaming the node without first
// checking it would turn a recorded internal error into a silent hard exit, which is the
// one outcome the driver cannot see, report or count.
test "a poisoned statement with no expression to blame still reports" {
    probe("cg_expr_pending", src())
    cg_expr_reset()
    cg_expr_push_pending(-1, -1)
    assert_eq_str("no span to blame", last_ice(), "PendingStatementNotLowered")
    assert_eq_str("no span to blame code", last_ice_code(), "I0005")
    assert_eq(cg_expr_pending_count(), 0)
}
