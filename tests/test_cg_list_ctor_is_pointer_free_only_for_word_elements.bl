// A list whose slots hold integer words is built pointer-free, so the collector never scans
// its storage. A slot that holds a pointer (a Str, a boxed Float, an Option, a payload
// variant, a nested list) must stay scanned, or the collector frees what the slot points at.

import lower_test_helpers.{probe, rhs_of, assert_kind, assert_eq_str}
import ir.{IrKind, ir_c_name}
import cg_expr.{lower_expr}
import layout.{list_slots_hold_no_pointer}
import typecheck.{tc_lookup_node_tid}

fn src() -> Str {
    #"type Colour { Red, Green }
type Shape { Dot, Line(Int) }
fn main() {
    let ints = [1, 2]
    let flags = [true, false]
    let chars = ['a', 'b']
    let colours = [Colour.Red, Colour.Green]
    let texts = ["a", "b"]
    let floats = [1.5, 2.5]
    let opts = [Some(1), None]
    let shapes = [Shape.Dot, Shape.Line(1)]
    let nested = [[1], [2]]
    let count = 1
    let _keep = [ints.len(), flags.len(), chars.len(), colours.len(), texts.len(), floats.len(), opts.len(), shapes.len(), nested.len(), count]
}
"#
}

fn ctor_of(name: Str) -> Str ! Diag.Report {
    let id = lower_expr(rhs_of(name))
    assert_kind(name, id, IrKind.ContainerNew)
    ir_c_name(id)
}

test "a list of integer words is built pointer-free" {
    probe("cg_list_ctor_kind", src())
    assert_eq_str("Int", ctor_of("ints"), "blink_list_new_atomic")
    assert_eq_str("Bool", ctor_of("flags"), "blink_list_new_atomic")
    assert_eq_str("Char", ctor_of("chars"), "blink_list_new_atomic")
    assert_eq_str("ordinal enum", ctor_of("colours"), "blink_list_new_atomic")
}

test "a list whose slots can hold a pointer stays scanned" {
    probe("cg_list_ctor_kind", src())
    assert_eq_str("Str", ctor_of("texts"), "blink_list_new")
    assert_eq_str("Float", ctor_of("floats"), "blink_list_new")
    assert_eq_str("Option", ctor_of("opts"), "blink_list_new")
    assert_eq_str("payload enum", ctor_of("shapes"), "blink_list_new")
    assert_eq_str("nested list", ctor_of("nested"), "blink_list_new")
}

test "only a list type can answer that its slots hold no pointer" {
    probe("cg_list_ctor_kind", src())
    assert(list_slots_hold_no_pointer(tc_lookup_node_tid(rhs_of("ints"))))
    assert(!list_slots_hold_no_pointer(tc_lookup_node_tid(rhs_of("texts"))))
    assert(!list_slots_hold_no_pointer(tc_lookup_node_tid(rhs_of("count"))))
    assert(!list_slots_hold_no_pointer(-1))
}
