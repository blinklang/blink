import cg_call.{cc_panic_line}
import parser.{nodes}
import ast.{AstNode}

// A panic message names the line of the node that panicked. A node the compiler built
// carries no line, and the message must say so rather than name line 0.

test "a node with no line reads as <synthesized>" {
    let synth = nodes.len()
    nodes.push(AstNode { line: 0 })
    assert_eq(cc_panic_line(synth), "<synthesized>")
}

test "a node with a line reads as that line in decimal" {
    let real = nodes.len()
    nodes.push(AstNode { line: 42 })
    assert_eq(cc_panic_line(real), "42")
}
