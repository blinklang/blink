// Which impl methods the body stage writes per instance, and which it writes once.
//
// The mono pass registers one instance per element only for the impl shape that is
// per-element: a List receiver over a single binder whose methods can see the element.
// Every other impl it walks as a root, which asks the body stage for one shared body.
// So the rule that sends a method down the per-instance path must be the same rule,
// or the two stages disagree about the same declaration: codegen waits for instances
// the pass never registers, and the body a live call needs is written nowhere.
//
// The disagreement is not a missing body alone. A method whose binder is named in a
// signature has no single correct body either. The stage that names such a method must
// say so when it has no instance, rather than leave the symbol to fail at link.

import std.io
import layout.{layout_reset}
import cname.{cname_reset, c_display_dispatch_name, c_impl_method_name}
import cg_test_helpers.{cg_probe_compile, cg_probe_ices_saying}
import cg.{CgConfig, generate}
import cg_reg.{cg_reg_impl_methods, cg_reg_impl_of}
import mono.{has_own_binders, run_mono, instances, is_poly_impl, poly_impl_is_element_agnostic}
import parser.{node_name}
import diagnostics.{CODEGEN_STAGE_NOT_BUILT_NAME, diag_entries}

fn standalone_cfg() -> CgConfig {
    CgConfig { debug_mode: 0, trace_codegen: 0, deterministic: 0, emit_only_module: "",
        skip_modules: Map(), user_tu_mode: 0, blink_ev_extern_only: 0, archive_build_mode: 0, archive_over_std: 0, compiler_archive_modules: Map() }
}

fn traced_cfg() -> CgConfig {
    CgConfig { debug_mode: 0, trace_codegen: 1, deterministic: 0, emit_only_module: "",
        skip_modules: Map(), user_tu_mode: 0, blink_ev_extern_only: 0, archive_build_mode: 0, archive_over_std: 0, compiler_archive_modules: Map() }
}

fn probe(stem: Str, src: Str) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, Env.Exit, Env.Read, FS.Read, FS.Write, IO {
    let program = cg_probe_compile("build/{stem}.bl", src)
    run_mono(program)
    layout_reset()
    cname_reset()
    program
}

// Every stop the probe recorded, whatever its name. A test that says nothing stops reads this,
// so a new refusal cannot pass it by having a new name.
fn stops() -> Int {
    let mut n = 0
    for d in diag_entries {
        if d.severity == "ice" { n = n + 1 }
    }
    n
}

// The same count, on the files this probe does not own. A whole-program unit lowers the
// prelude too, so the container impls the standard library writes are measured here rather
// than folded into the probe's own count.
fn prelude_stops(stem: Str) -> Int {
    let mut n = 0
    for d in diag_entries {
        if d.severity == "ice" && d.file != "build/{stem}.bl" { n = n + 1 }
    }
    n
}

// The impl block a probe's method was written in, so a claim about the two stages can be
// made on the node both of them classify.
fn impl_of(mname: Str) -> Int ! IO.Print {
    for m in cg_reg_impl_methods() {
        if node_name(m) == mname { return cg_reg_impl_of(m) }
    }
    io.println("FAIL: no impl method named '{mname}' in the registry")
    assert(false)
    -1
}

// The symbol the name stage chose for an impl method, so a claim about the body that was
// written is not a second spelling of the naming rule.
fn method_symbol(mname: Str) -> Str ! IO.Print {
    c_impl_method_name(impl_of(mname), mname)
}

// The symbol the mono pass chose for one instance of an impl method, for the same reason.
fn instance_symbol(mname: Str) -> Str ! IO.Print {
    for m in cg_reg_impl_methods() {
        if node_name(m) != mname { continue }
        for mi in instances() {
            if mi.base_decl_node == m { return mi.c_name }
        }
    }
    io.println("FAIL: the mono pass registered no instance of '{mname}'")
    assert(false)
    ""
}

// What the Display site says when it stops.
let DISPLAY_STOP = "Display through a `fmt` with one body per instance"

// A definition is written at file scope, so its line is unindented and opens a brace.
fn definitions_of(text: Str, symbol: Str) -> Int {
    let open_brace = #"{"#
    let call = "{symbol}("
    let mut n = 0
    for l in text.split("\n") {
        if l.starts_with(" ") { continue }
        if l.contains(call) && l.ends_with(open_brace) { n = n + 1 }
    }
    n
}

// No method signature names the binder, so the impl cannot move or inspect an element and
// its C does not depend on the element type. The mono pass registers no instance for it
// and expects the one shared body instead, which is the body a call to it reaches.
test "an element-agnostic container impl method is written once and reported never" {
    let stem = "cg_pim_agnostic"
    let program = probe(stem, #"trait Tally {
    fn tally(self) -> Int
}

impl[T] Tally for List[T] {
    fn tally(self) -> Int { 7 }
}

fn main() {
    let xs = [1, 2, 3]
    let n = xs.tally()
    assert(n == 7)
}
"#)
    let text = generate(program, standalone_cfg())
    let im = impl_of("tally")
    assert(poly_impl_is_element_agnostic(im))
    assert(!is_poly_impl(im))
    assert_eq(stops(), 0)
    assert_eq(definitions_of(text, method_symbol("tally")), 1)
}

// The other side of the same predicate. A method signature names the binder, so the C
// does depend on the element and the pass registers one instance per element. Here the
// per-instance path is the right one and its rows are there, so nothing is reported.
test "a per-element container impl method is written per instance" {
    let stem = "cg_pim_per_element"
    let program = probe(stem, #"trait Pick[T] {
    fn pick(self, d: T) -> T
}

impl[T] Pick[T] for List[T] {
    fn pick(self, d: T) -> T { d }
}

fn main() {
    let xs = [1, 2, 3]
    let n = xs.pick(4)
    assert(n == 4)
}
"#)
    let text = generate(program, standalone_cfg())
    assert(!poly_impl_is_element_agnostic(impl_of("pick")))
    assert(is_poly_impl(impl_of("pick")))
    assert_eq(stops(), 0)
    assert_eq(definitions_of(text, instance_symbol("pick")), 1)
}

// The standard library's own container impls are element-agnostic in the same way, and a
// whole-program unit lowers all of them. They are the standing measure of whether the two
// stages agree: one report from any of them is the same disagreement, on prelude code.
test "the prelude's container impl methods are reported never" {
    let stem = "cg_pim_prelude"
    let program = probe(stem, #"fn main() {
    let xs = [1, 2, 3]
    let n = xs.len()
    assert(n == 3)
}
"#)
    let text = generate(program, standalone_cfg())
    assert_eq(prelude_stops(stem), 0)
    assert_eq(definitions_of(text, method_symbol("len")), 1)
}

// A method carrying its own type parameters is instantiated by the mono pass: it registers
// one instance per choice of those binders, keyed by the impl block that gives the symbol
// its stem. So the per-instance path has a row to write, and the body a call reaches is
// written under that instance's name rather than reported as a gap.
test "a generic method in a concrete impl is written per instance and by the prelude never" {
    let stem = "cg_pim_generic_method"
    let program = probe(stem, #"type Holder {
    v: Int
}

trait Peek {
    fn peek[T](self, x: T) -> Int
}

impl Peek for Holder {
    fn peek[T](self, _x: T) -> Int { self.v }
}

fn main() {
    let h = Holder { v: 7 }
    let n = h.peek(3)
    assert(n == 7)
}
"#)
    let text = generate(program, standalone_cfg())
    assert_eq(stops(), 0)
    assert_eq(definitions_of(text, instance_symbol("peek")), 1)
    assert_eq(prelude_stops(stem), 0)
}

// A generic user type is a different C struct per argument and has no spelling at all
// until one is chosen. So an impl over one has no single body either, however little its
// methods say about the binder: each instance a call reaches gets its own body.
test "a generic user type receiver gets one body per instance however agnostic its methods are" {
    let stem = "cg_pim_user_generic_recv"
    let program = probe(stem, #"type Box[T] {
    v: T
}

trait Sz {
    fn sz(self) -> Int
}

impl[T] Sz for Box[T] {
    fn sz(self) -> Int { 1 }
}

fn main() {
    assert(Box { v: 1 }.sz() == 1)
    assert(Box { v: "a" }.sz() == 1)
}
"#)
    let text = generate(program, standalone_cfg())
    assert(poly_impl_is_element_agnostic(impl_of("sz")))
    assert(is_poly_impl(impl_of("sz")))
    assert_eq(stops(), 0)
    let symbols = instance_symbols("sz")
    assert_eq(symbols.len(), 2)
    for s in symbols { assert_eq(definitions_of(text, s), 1) }
}

// Every symbol the mono pass chose for an impl method's instances.
fn instance_symbols(mname: Str) -> List[Str] {
    let mut out: List[Str] = []
    for m in cg_reg_impl_methods() {
        if node_name(m) != mname { continue }
        for mi in instances() {
            if mi.base_decl_node == m { out.push(mi.c_name) }
        }
    }
    out
}

// A method no call reaches has no row, and a body stage with no row has nothing to write.
// It cannot ask for a row to make one, because no type argument exists to make it with.
test "a generic impl method no call reaches is written nowhere and reported never" {
    let stem = "cg_pim_unreached"
    let program = probe(stem, #"type Box[T] {
    v: T
}

trait Sz {
    fn sz(self) -> Int
    fn unreached(self) -> Int
}

impl[T] Sz for Box[T] {
    fn sz(self) -> Int { 1 }
    fn unreached(self) -> Int { 2 }
}

fn main() {
    assert(Box { v: 1 }.sz() == 1)
}
"#)
    let text = generate(program, standalone_cfg())
    assert_eq(stops(), 0)
    assert_eq(instance_symbols("sz").len(), 1)
    assert_eq(instance_symbols("unreached").len(), 0)
    assert(!text.contains(method_symbol("unreached")))
}

// An interpolation reaches the dispatcher beside `fmt`, by a name that takes no instance.
// The pass registers no instance for that site. With no body to call, the site itself must
// stop, because the body stage reads "no row" as "no call" and writes nothing.
test "a site that names a dispatcher with no instance stops at that site" {
    let stem = "cg_pim_display_reached"
    let program = probe(stem, #"type Box[T] {
    v: T
}

impl[T] Display for Box[T] {
    fn fmt(self, sb: StringBuilder) { sb.write("box") }
}

fn main() {
    let b = Box { v: 1 }
    let s = "{b}"
    assert(s == "box")
}
"#)
    generate(program, standalone_cfg())
    assert_eq(cg_probe_ices_saying(CODEGEN_STAGE_NOT_BUILT_NAME, DISPLAY_STOP), 1)
    assert_eq(stops(), 1)
}

// The dispatcher of a `fmt` with its own type parameter does not exist either.
test "an interpolation whose fmt takes its own type parameter stops at that site" {
    let stem = "cg_pim_display_own_binder"
    let program = probe(stem, #"type P {
    v: Int
}

impl Display for P {
    fn fmt[U](_self, sb: StringBuilder) { sb.write("p") }
}

fn main() {
    let p = P { v: 1 }
    assert("{p}" == "p")
}
"#)
    generate(program, standalone_cfg())
    assert_eq(cg_probe_ices_saying(CODEGEN_STAGE_NOT_BUILT_NAME, DISPLAY_STOP), 1)
    assert_eq(stops(), 1)
}

// A message that only names a value has a placeholder for a type it cannot show, so it takes
// that over a stop: the program is valid, and only its failure text is plainer.
test "assert_eq and unwrap name a value by its type when its Display has no dispatcher" {
    let stem = "cg_pim_message_placeholder"
    let program = probe(stem, #"type W[T] {
    v: T
}

impl[T] Display for W[T] {
    fn fmt(_self, sb: StringBuilder) { sb.write("w") }
}

impl[T] Eq for W[T] {
    fn eq(_self, _o: W[T]) -> Bool { true }
}

impl[T] Debug for W[T] {
    fn debug(_self) -> Str { "w" }
}

fn f() -> Result[Int, W[Int]] { Ok(1) }

fn main() {
    assert_eq(W { v: 1 }, W { v: 1 })
    assert_eq(f().unwrap(), 1)
}
"#)
    let text = generate(program, standalone_cfg())
    assert_eq(stops(), 0)
    assert(text.contains("<W"))
}

// A traced build reads each value it records, with no call in the source. It has a Debug and
// a placeholder route for a value it cannot show, so a program that runs must also trace.
test "a traced value whose Display has no dispatcher takes the route below it" {
    let stem = "cg_pim_trace_display"
    let program = probe(stem, #"type W[T] {
    v: T
}

impl[T] Display for W[T] {
    fn fmt(_self, sb: StringBuilder) { sb.write("w") }
}

fn gw(w: W[Int]) -> Int { w.v }

fn main() {
    assert(gw(W { v: 1 }) == 1)
}
"#)
    let text = generate(program, traced_cfg())
    assert_eq(stops(), 0)
    assert(text.contains("<W"))
}

test "a traced value whose debug takes its own type parameter takes the placeholder" {
    let stem = "cg_pim_trace_debug_own_binder"
    let program = probe(stem, #"type P {
    n: Int
}

impl Debug for P {
    fn debug[U](_self) -> Str { "p" }
}

fn f(p: P) -> Int { p.n }

fn main() {
    assert(f(P { n: 1 }) == 1)
}
"#)
    let text = generate(program, traced_cfg())
    assert_eq(stops(), 0)
    assert(text.contains("<P"))
}

// A foreign `fmt` has one name, so an interpolation calls the dispatcher beside it, and the
// body stage must write that dispatcher there as it does beside a Blink body. With none,
// the program fails at link.
test "a foreign fmt has its dispatcher written beside the wrapper" {
    let stem = "cg_pim_foreign_fmt"
    let program = probe(stem, #"type Foo {
    n: Int
}

impl Display for Foo {
    @ffi("gnu_get_libc_version") fn fmt(self, sb: StringBuilder)
}

fn main() {
    let f = Foo { n: 1 }
    assert("{f}" == "")
}
"#)
    let text = generate(program, standalone_cfg())
    assert_eq(stops(), 0)
    assert_eq(definitions_of(text, c_display_dispatch_name(impl_of("fmt"))), 1)
}

// Only a call gives a type argument for a method's own binder, so a type instance alone must
// not ask for a copy. The body here has a type no argument solves.
test "a type instance registers no operator method with its own binder" {
    let stem = "cg_pim_operator_own_binder_unreached"
    let program = probe(stem, #"type Box[T] {
    v: T
}

fn id[A](x: A) -> A { x }

impl[T] Eq for Box[T] {
    fn eq[U](_self, _o: Box[T]) -> Bool {
        let c: Option[Box[U]] = None
        let d = id(c)
        d.is_none()
    }
}

fn main() {
    assert(Box { v: 1 }.v == 1)
}
"#)
    generate(program, standalone_cfg())
    assert_eq(stops(), 0)
    assert_eq(instance_symbols("eq").len(), 0)
}

// The body of `eq` calls the bound's method. At an argument without the trait there is no
// such method, so the pass must read that bound too before it asks for a copy.
test "a type instance registers no operator method where a bound on a program trait fails" {
    let stem = "cg_pim_operator_program_bound"
    let program = probe(stem, #"trait Sh {
    fn sh(self) -> Int
}

type NB {
    x: Int
}

type B[T] {
    v: T
}

impl[T: Sh] Eq for B[T] {
    fn eq(self, o: B[T]) -> Bool { self.v.sh() == o.v.sh() }
}

impl[T: Sh] Clone for B[T] {
    fn clone(self) -> B[T] { B { v: self.v } }
}

fn main() {
    assert(B { v: NB { x: 1 } }.v.x == 1)
}
"#)
    generate(program, standalone_cfg())
    assert_eq(stops(), 0)
    assert_eq(instance_symbols("eq").len(), 0)
    assert_eq(instance_symbols("clone").len(), 0)
}

test "a type instance registers its operator method where the bound on a program trait holds" {
    let stem = "cg_pim_operator_program_bound_met"
    let program = probe(stem, #"trait Sh {
    fn sh(self) -> Int
}

type NB {
    x: Int
}

impl Sh for NB {
    fn sh(self) -> Int { self.x }
}

type B[T] {
    v: T
}

impl[T: Sh] Eq for B[T] {
    fn eq(self, o: B[T]) -> Bool { self.v.sh() == o.v.sh() }
}

fn main() {
    let a = B { v: NB { x: 1 } }
    assert(a == a)
}
"#)
    let text = generate(program, standalone_cfg())
    assert_eq(stops(), 0)
    assert_eq(definitions_of(text, instance_symbol("eq")), 1)
}

// The other side of the row above: `==` does reach it, and a binder no call solves has no
// body to name.
test "an operator on a generic type whose method takes its own type parameter stops at that site" {
    let stem = "cg_pim_generic_operator_own_binder"
    let program = probe(stem, #"type Box[T] {
    v: T
}

impl[T] Eq for Box[T] {
    fn eq[U](_self, _o: Box[T]) -> Bool { true }
}

fn main() {
    let a = Box { v: 1 }
    assert(a == a)
}
"#)
    generate(program, standalone_cfg())
    assert_eq(cg_probe_ices_saying("MonoInstanceNotRegistered", "`eq` of"), 1)
    assert_eq(stops(), 1)
}

// The with stage names enter and exit by the name of the impl, with no instance.
test "a with-item whose handler method takes its own type parameter stops at that site" {
    let stem = "cg_pim_handler_own_binder"
    let program = probe(stem, #"type P {
    v: Int
}

impl BlockHandler for P {
    type Context = Int
    fn enter[U](self) -> Int { self.v }
    fn exit(self, ok: Bool) { }
}

fn main() {
    with P { v: 1 } as b {
        assert(b == 1)
    }
}
"#)
    generate(program, standalone_cfg())
    assert_eq(cg_probe_ices_saying(CODEGEN_STAGE_NOT_BUILT_NAME, "BlockHandler method has its own type parameter"), 1)
    assert_eq(stops(), 1)
}

test "a with-item whose exit takes its own type parameter stops at that site" {
    let stem = "cg_pim_handler_exit_own_binder"
    let program = probe(stem, #"type P {
    v: Int
}

impl BlockHandler for P {
    type Context = Int
    fn enter(self) -> Int { self.v }
    fn exit[U](_self, _ok: Bool) { }
}

fn main() {
    with P { v: 1 } as b {
        assert(b == 1)
    }
}
"#)
    generate(program, standalone_cfg())
    assert_eq(cg_probe_ices_saying(CODEGEN_STAGE_NOT_BUILT_NAME, "BlockHandler method has its own type parameter"), 1)
    assert_eq(stops(), 1)
}

// An operator reaches its method through the symbol of the impl, which a per-instance body
// never defines.
test "an operator whose method takes its own type parameter stops at that site" {
    let stem = "cg_pim_operator_own_binder"
    let program = probe(stem, #"type P {
    v: Int
}

impl Eq for P {
    fn eq[U](self, o: P) -> Bool { self.v == o.v }
}

fn main() {
    let a = P { v: 1 }
    assert(a == a)
}
"#)
    generate(program, standalone_cfg())
    assert_eq(cg_probe_ices_saying("MonoInstanceNotRegistered", "`eq` of"), 1)
    assert_eq(stops(), 1)
}

// The impl's binder is not the method's own: it has an argument at each instance of the type.
test "a method has its own binders only where it declares them" {
    let stem = "cg_pim_own_binders"
    let program = probe(stem, #"type Box[T] {
    v: T
}

trait Tr {
    fn plain(self) -> Int
    fn own[U](self, u: U) -> Int
}

impl[T] Tr for Box[T] {
    fn plain(_self) -> Int { 1 }
    fn own[U](_self, _u: U) -> Int { 2 }
}

fn main() {
    assert(Box { v: 1 }.v == 1)
}
"#)
    generate(program, standalone_cfg())
    let mut seen = 0
    for m in cg_reg_impl_methods() {
        if node_name(m) == "plain" {
            assert(!has_own_binders(m))
            seen = seen + 1
        }
        if node_name(m) == "own" {
            assert(has_own_binders(m))
            seen = seen + 1
        }
    }
    assert_eq(seen, 2)
}

// A type with two instances of one generic trait has one impl per instance, and a call
// through a bound runs only the impl of the instance the bound names. The mono pass and
// the body stage each choose that impl, so each impl must have its own one row, and the
// call the body stage writes must reach that row: a stage that chose the other impl would
// call a symbol the pass never registered.
test "a call through a bound on a type with two instances reaches the impl mono chose" {
    let stem = "cg_pim_two_instances"
    let program = probe(stem, #"trait Conv[U] {
    fn conv(self) -> U
}

type Box[T] {
    v: T
}

impl[T] Conv[List[T]] for Box[T] {
    fn conv(self) -> List[T] { [self.v] }
}

impl[T] Conv[Int] for Box[T] {
    fn conv(self) -> Int { 42 }
}

fn as_int[X: Conv[Int]](x: X) -> Int { x.conv() }
fn as_strs[X: Conv[List[Str]]](x: X) -> List[Str] { x.conv() }

fn main() {
    assert(as_int(Box { v: "s" }) == 42)
    assert(as_strs(Box { v: "s" }).len() == 1)
}
"#)
    let text = generate(program, standalone_cfg())
    assert_eq(stops(), 0)
    let mut impls = 0
    for m in cg_reg_impl_methods() {
        if node_name(m) != "conv" { continue }
        impls = impls + 1
        let mut rows: List[Str] = []
        for mi in instances() {
            if mi.base_decl_node == m { rows.push(mi.c_name) }
        }
        assert_eq(rows.len(), 1)
        let symbol = rows.get(0) ?? ""
        assert_eq(definitions_of(text, symbol), 1)
        assert(text.split("{symbol}(").len() > 2)
    }
    assert_eq(impls, 2)
}
