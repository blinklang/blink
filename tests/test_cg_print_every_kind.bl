import std.io
import ir.{
    IrKind, ir_new, ir_reset, ir_verify, ir_all_kinds, ir_kind_name, ir_kind_is_value, ir_kind, ir_held_by_pointer,
    ir_const, ir_var_ref, ir_global_ref, ir_unary, ir_binary, ir_cast, ir_select, ir_field_get, ir_struct_new, ir_tuple_new, ir_enum_new,
    ir_container_new, ir_container_spread, ir_box, ir_box_into, ir_unbox, ir_carrier_wrap, ir_carrier_unwrap, ir_carrier_tag,
    ir_call_direct, ir_call_indirect, ir_call_closure, ir_call_virtual, ir_call_runtime, ir_closure_new, ir_sized_alloc, ir_heap_alloc,
    ir_effect_perform, ir_evidence_vector, ir_evidence_address, ir_arena_target, ir_promote_ctx, ir_promote_ctx_param, ir_field_set, ir_handler_install, ir_let, ir_cell_let,
    ir_cell_ref, ir_assign, ir_expr_stmt, ir_return, ir_if,
    ir_loop, ir_break, ir_continue, ir_block, ir_switch, ir_with_scope, ir_panic, ir_unreachable,
    ir_panic_catch, ir_panic_catch_exit, ir_volatile_let,
}
import layout.{SlotForm}
import cname.{c_cell_name, c_enum_tag_member, c_enum_payload_member}
import cg_print.{
    print_resource_guard_support,
    print_reset, print_take, print_expr, print_stmt, print_block_body,
    print_struct_typedef, print_simple_enum_typedef, print_tagged_enum_typedef,
    print_effect_vtable_typedef, print_effect_default_vtable,
    print_ev, print_main_shim,
}
import cg_decl.{cg_decl_reset}
import diagnostics.{diag_reset, diag_ice_count}
// lexer and parser read the trace globals that compiler.bl owns, so a test that imports
// typecheck through layout must load compiler as well.
import compiler.{compile_to_program}

fn int_const(text: Str) -> Int { ir_const(1, 0, "int64_t", text) }
fn int_var(name: Str) -> Int { ir_var_ref(1, 0, "int64_t", name, SlotForm.InlineWord) }
fn s_var() -> Int { ir_var_ref(6, 0, "blink_S", "s", SlotForm.Inline) }
fn sp_var() -> Int { ir_var_ref(7, 0, "blink_S*", "sp", SlotForm.PointerBoxed) }
fn opt_var() -> Int { ir_var_ref(8, 0, "blink_Option_int", "o", SlotForm.Inline) }
fn cl_var() -> Int { ir_var_ref(9, 0, "blink_closure*", "cl", SlotForm.PointerBoxed) }

fn spread_sample() -> Int { ir_container_spread(4, 0, "blink_list*", "blink_list_extend", ir_var_ref(4, 0, "blink_list*", "xs", SlotForm.PointerBoxed)) }

// One node of every value kind, as a `(kind, node)` pair, in the same order as ir_all_kinds.
fn value_sample(k: IrKind) -> Int {
    match k {
        IrKind.Const => int_const("1")
        IrKind.VarRef => int_var("a")
        IrKind.CellRef => ir_cell_ref(1, 0, "int64_t", "a", SlotForm.InlineWord)
        IrKind.GlobalRef => ir_global_ref(1, 0, "int64_t", "g", SlotForm.InlineWord)
        IrKind.Unary => ir_unary(1, 0, "int64_t", "-", int_var("a"))
        IrKind.Binary => ir_binary(1, 0, "int64_t", "+", int_var("a"), int_const("2"))
        IrKind.Cast => ir_cast(5, 0, "double", int_var("a"))
        IrKind.Select => ir_select(1, 0, "int64_t", SlotForm.InlineWord, int_var("ok"), int_const("1"), int_const("0"))
        IrKind.FieldGet => ir_field_get(1, 0, "int64_t", "x", SlotForm.InlineWord, sp_var())
        IrKind.StructNew => ir_struct_new(6, 0, "blink_S", [int_const("1"), int_const("2")])
        IrKind.TupleNew => ir_tuple_new(10, 0, "blink_Tuple_int_int", [int_const("1"), int_const("2")])
        IrKind.EnumNew => ir_enum_new(12, 0, "blink_Shape", 0, "Rect", ir_const(5, 0, "int", "blink_Shape_Rect_TAG"), [int_const("1"), int_var("a")])
        IrKind.ContainerNew => ir_container_new(4, 0, "blink_list*", "blink_list_new", "", [int_var("a"), spread_sample()])
        IrKind.ContainerSpread => spread_sample()
        IrKind.Box => ir_box(7, 0, "blink_S*", "blink_S", s_var())
        IrKind.Unbox => ir_unbox(6, 0, "blink_S", SlotForm.Inline, sp_var())
        IrKind.CarrierWrap => ir_carrier_wrap(8, 0, "blink_Option_int", "value", int_const("1"), int_var("a"))
        IrKind.CarrierUnwrap => ir_carrier_unwrap(1, 0, "int64_t", "value", SlotForm.InlineWord, opt_var())
        IrKind.CarrierTag => ir_carrier_tag(5, 0, "int", opt_var())
        IrKind.CallDirect => ir_call_direct(1, 0, "int64_t", "main_f", SlotForm.InlineWord, [int_var("a")])
        IrKind.CallIndirect => ir_call_indirect(1, 0, "int64_t", SlotForm.InlineWord, ir_var_ref(11, 0, "int64_t (*)(int64_t)", "fp", SlotForm.InlineWord), [int_var("a")])
        IrKind.CallClosure => ir_call_closure(1, 0, "int64_t", "int64_t(*)(const blink_closure*, int64_t)", SlotForm.InlineWord, cl_var(), [int_var("a")])
        IrKind.CallVirtual => ir_call_virtual(1, 0, "int64_t", "get", SlotForm.InlineWord, sp_var(), [int_var("a")])
        IrKind.CallRuntime => ir_call_runtime(1, 0, "int64_t", "blink_list_len", SlotForm.InlineWord, [ir_var_ref(4, 0, "blink_list*", "xs", SlotForm.PointerBoxed)])
        IrKind.ClosureNew => ir_closure_new(9, 0, "blink_closure*", "__closure_0", "__closure_0_descs", "__closure_0_promote", [sp_var()])
        IrKind.EvidenceVector => ir_evidence_vector(0, "blink_ev*", "__ev", SlotForm.PointerBoxed)
        IrKind.EvidenceAddress => ir_evidence_address(0, ir_evidence_vector(0, "blink_ev", "__blink_ev", SlotForm.Inline))
        IrKind.ArenaTarget => ir_arena_target(0, "target")
        IrKind.PromoteCtx => ir_promote_ctx(0, ir_arena_target(0, "target"))
        IrKind.SizedAlloc => ir_sized_alloc(14, 0, "blink_Pollfd*", "blink_Pollfd", ir_var_ref(15, 0, "blink_list*", "sc", SlotForm.PointerBoxed), int_var("n"))
        IrKind.HeapAlloc => ir_heap_alloc(14, 0, "blink_Pollfd*", "blink_Pollfd")
        IrKind.EffectPerform => ir_effect_perform(1, 0, "int64_t", "get", SlotForm.InlineWord,
            ir_field_get(12, 0, "blink_ue_x_vtable*", "ue_x", SlotForm.PointerBoxed, ir_evidence_vector(0, "blink_ev*", "__ev", SlotForm.PointerBoxed)), [int_var("a")])
        _ => -1
    }
}

fn stmt_sample(k: IrKind) -> Int {
    match k {
        IrKind.FieldSet => ir_field_set(0, "x", sp_var(), int_const("3"))
        IrKind.HandlerInstall => ir_handler_install(0, "ue_x", ir_var_ref(12, 0, "blink_ue_x_vtable*", "hv", SlotForm.PointerBoxed), ir_block(0, []))
        IrKind.Let => ir_let(1, 0, "int64_t", "b", SlotForm.InlineWord, int_const("4"))
        IrKind.CellLet => ir_cell_let(1, 0, "int64_t", "c", SlotForm.InlineWord, int_const("6"))
        IrKind.VolatileLet => ir_volatile_let(4, 0, "blink_list*", "vs", SlotForm.PointerBoxed, ir_var_ref(4, 0, "blink_list*", "xs", SlotForm.PointerBoxed))
        IrKind.Assign => ir_assign(0, int_var("a"), int_const("5"))
        IrKind.ExprStmt => ir_expr_stmt(0, ir_call_direct(1, 0, "int64_t", "main_f", SlotForm.InlineWord, []))
        IrKind.Return => ir_return(0, int_var("a"))
        IrKind.If => ir_if(0, int_var("a"), ir_block(0, []), ir_block(0, []))
        IrKind.Loop => ir_loop(0, ir_block(0, [ir_break(0)]))
        IrKind.Break => ir_loop(0, ir_block(0, [ir_break(0)]))
        IrKind.Continue => ir_loop(0, ir_block(0, [ir_continue(0)]))
        IrKind.Block => ir_block(0, [])
        IrKind.Switch => ir_switch(0, int_var("a"), [int_const("1"), ir_block(0, [])], ir_block(0, []))
        IrKind.WithScope => ir_with_scope(0, "blink_file_close", ir_var_ref(13, 0, "blink_file*", "f", SlotForm.PointerBoxed), ir_block(0, []))
        IrKind.Panic => ir_panic(0, ir_const(2, 0, "const char*", "\"boom\""))
        IrKind.Unreachable => ir_unreachable(0)
        IrKind.PanicCatch => panic_catch_sample("ap_m", ir_var_ref(2, 0, "const char*", "m", SlotForm.InlineWord), ir_block(0, []))
        // An exit prints only inside the frame it names, so its sample is that frame.
        IrKind.PanicCatchExit => panic_catch_sample("ap_x", -1, ir_block(0, [ir_panic_catch_exit(0, "ap_x")]))
        _ => -1
    }
}

fn panic_catch_sample(frame: Str, matcher: Int, body: Int) -> Int {
    ir_panic_catch(0, frame, ir_const(2, 0, "const char*", "\"t.bl\""), int_const("3"), int_const("5"), matcher, body)
}

fn expect_c(label: Str, got: Str, needle: Str) {
    if !got.contains(needle) { io.println("FAIL: {label}: want '{needle}' in:\n{got}") }
    assert(got.contains(needle))
}

// ContainerSpread is the one value kind that never prints on its own: its ContainerNew
// writes it, so it is left out here and checked as an ICE below.
test "every value kind prints in value position without an ICE" {
    ir_reset()
    diag_reset()
    let mut seen = 0
    for k in ir_all_kinds() {
        if ir_kind_is_value(k) == 0 || k == IrKind.ContainerSpread { continue }
        let n = value_sample(k)
        assert(n >= 0)
        assert_eq(ir_kind(n), k)
        print_reset()
        let text = print_expr(n)
        let pre = print_take()
        assert(text != "")
        assert(!text.contains("I0003"))
        assert(!pre.contains("I0003"))
        seen += 1
    }
    assert_eq(seen, 31)
    assert_eq(diag_ice_count, 0)
}

// The WithScope sample names a Closeable exit whose guard support the TU must define first.
fn with_scope_support() ! Diag.Report { print_resource_guard_support("blink_file_close", "blink_file*", false) }

test "every statement kind prints in statement position without an ICE" {
    ir_reset()
    diag_reset()
    let mut seen = 0
    for k in ir_all_kinds() {
        if ir_kind_is_value(k) == 1 { continue }
        let n = stmt_sample(k)
        assert(n >= 0)
        let errs = ir_verify(n)
        if errs.len() > 0 { io.println("FAIL verify {ir_kind_name(k)}: {errs.join(" | ")}") }
        assert_eq(errs.len(), 0)
        print_reset()
        with_scope_support()
        let _ = print_take()
        print_stmt(n)
        let c = print_take()
        assert(!c.contains("I0003"))
        seen += 1
    }
    assert_eq(seen, 19)
    assert_eq(diag_ice_count, 0)
}

// The printer repeats the word the node carries. A node built raw carries neither name,
// so a printer that spelled either one itself would print a correct designator here; it
// reports an internal error instead, which is what a designator with nothing after the
// dot deserves.
test "a tagged value the constructors did not build names no member" {
    ir_reset()
    diag_reset()
    print_reset()
    let raw = ir_new(IrKind.CarrierTag, 5, 0, "int", "", SlotForm.InlineWord, [opt_var()])
    let text = print_expr(raw)
    assert_eq(diag_ice_count, 1)
    assert(!text.contains("o.{c_enum_tag_member()}"))
    assert(text.contains("BLINK_I0003"))
}

test "each kind prints its documented C form" {
    ir_reset()
    diag_reset()
    print_reset()
    expect_c("Unary", print_expr(value_sample(IrKind.Unary)), "(-a)")
    expect_c("Binary", print_expr(value_sample(IrKind.Binary)), "(a + 2)")
    expect_c("Cast", print_expr(value_sample(IrKind.Cast)), "((double)(a))")
    expect_c("Select", print_expr(value_sample(IrKind.Select)), "(ok ? 1 : 0)")
    expect_c("FieldGet through pointer", print_expr(value_sample(IrKind.FieldGet)), "sp->x")
    expect_c("StructNew", print_expr(value_sample(IrKind.StructNew)), "((blink_S)\{1, 2})")
    expect_c("TupleNew", print_expr(value_sample(IrKind.TupleNew)), "((blink_Tuple_int_int)\{1, 2})")
    expect_c("EnumNew", print_expr(value_sample(IrKind.EnumNew)), "((blink_Shape)\{.tag = blink_Shape_Rect_TAG, .data.Rect = \{1, a}})")
    expect_c("EnumNew payload-less", print_expr(ir_enum_new(12, 0, "blink_Shape", 0, "", ir_const(5, 0, "int", "blink_Shape_Empty_TAG"), [])), "((blink_Shape)\{.tag = blink_Shape_Empty_TAG})")
    expect_c("Unbox", print_expr(value_sample(IrKind.Unbox)), "(*(sp))")
    expect_c("CarrierWrap", print_expr(value_sample(IrKind.CarrierWrap)), "((blink_Option_int)\{.tag = 1, .value = a})")
    expect_c("CarrierUnwrap", print_expr(value_sample(IrKind.CarrierUnwrap)), "o.value")
    expect_c("CarrierTag", print_expr(value_sample(IrKind.CarrierTag)), "o.tag")
    expect_c("CallDirect", print_expr(value_sample(IrKind.CallDirect)), "main_f(a)")
    expect_c("CallIndirect", print_expr(value_sample(IrKind.CallIndirect)), "(fp)(a)")
    expect_c("CallClosure", print_expr(value_sample(IrKind.CallClosure)), "((int64_t(*)(const blink_closure*, int64_t))cl->fn_ptr)(cl, a)")
    expect_c("CallVirtual", print_expr(value_sample(IrKind.CallVirtual)), "(sp)->get(a)")
    expect_c("CallRuntime", print_expr(value_sample(IrKind.CallRuntime)), "blink_list_len(xs)")
    expect_c("EvidenceVector", print_expr(value_sample(IrKind.EvidenceVector)), "__ev")
    expect_c("ArenaTarget", print_expr(value_sample(IrKind.ArenaTarget)), "target")
    expect_c("PromoteCtx", print_expr(value_sample(IrKind.PromoteCtx)), "BLINK_PROMOTE_CTX(target)")
    expect_c("PromoteCtx parameter", print_expr(ir_promote_ctx_param(0, "ctx")), "ctx")
    expect_c("EffectPerform", print_expr(value_sample(IrKind.EffectPerform)), "(__ev->ue_x)->get((__ev->ue_x)->__userdata_get, a)")
    expect_c("SizedAlloc", print_expr(value_sample(IrKind.SizedAlloc)), "((blink_Pollfd*)blink_ffi_scope_track(sc, calloc((size_t)(n), sizeof(blink_Pollfd))))")
    expect_c("HeapAlloc", print_expr(value_sample(IrKind.HeapAlloc)), "((blink_Pollfd*)blink_alloc(sizeof(blink_Pollfd)))")
    let box_tmp = print_expr(value_sample(IrKind.Box))
    let cont_tmp = print_expr(value_sample(IrKind.ContainerNew))
    let cl_tmp = print_expr(value_sample(IrKind.ClosureNew))
    let pre = print_take()
    expect_c("Box alloc", pre, "blink_S* {box_tmp} = (blink_S*)blink_alloc(sizeof(blink_S));")
    expect_c("Box store", pre, "*{box_tmp} = s;")
    let into_tmp = print_expr(ir_box_into(7, 0, "blink_S*", "blink_S", s_var(), ir_promote_ctx_param(0, "ctx")))
    expect_c("Box into the promotion target", print_take(), "blink_S* {into_tmp} = (blink_S*)blink_promote_ctx_alloc(ctx, sizeof(blink_S));")
    expect_c("ContainerNew ctor", pre, "blink_list* {cont_tmp} = blink_list_new();")
    expect_c("ContainerNew push", pre, "blink_list_push({cont_tmp}, a);")
    expect_c("ContainerSpread", pre, "blink_list_extend({cont_tmp}, xs);")
    expect_c("ClosureNew", pre, "blink_closure* {cl_tmp} = blink_closure_new_typed((void*)__closure_0, ")
    expect_c("ClosureNew descriptors and promoter", pre, ", __closure_0_descs, 1, __closure_0_promote);")

    print_reset()
    with_scope_support()
    let _ = print_take()
    for k in ir_all_kinds() {
        if ir_kind_is_value(k) == 0 { print_stmt(stmt_sample(k)) }
    }
    let c = print_take()
    expect_c("FieldSet", c, "sp->x = 3;")
    expect_c("HandlerInstall", c, "__blink_ev.ue_x = hv;")
    expect_c("HandlerInstall fresh ev", c, "blink_ev* __ev = &_evw")
    expect_c("Let", c, "int64_t b = 4;")
    // The cell is the storage, so one statement declares the pointer and the next seeds it.
    expect_c("CellLet allocates", c, "int64_t* {c_cell_name("c")} = (int64_t*)blink_alloc(sizeof(*{c_cell_name("c")}));")
    expect_c("CellLet seeds", c, "*{c_cell_name("c")} = 6;")
    // The qualifier binds to the pointer the local holds, not to the list it points at.
    expect_c("VolatileLet", c, "blink_list* volatile vs = xs;")
    expect_c("Assign", c, "a = 5;")
    expect_c("ExprStmt", c, "main_f();")
    expect_c("Return", c, "return a;")
    expect_c("If", c, "if (a) \{")
    expect_c("Else", c, "else \{")
    expect_c("Loop", c, "while (1) \{")
    expect_c("Break", c, "break;")
    expect_c("Continue", c, "continue;")
    expect_c("Switch", c, "if (a == 1) \{")
    expect_c("WithScope resource", c, "__attribute__((cleanup(__blink_rs_cleanup_blink_file_close))) = \{ .resource = f, .ok = 0, .done = 0 };")
    expect_c("Panic", c, "__blink_panic_dispatch(\"boom\");")
    expect_c("Unreachable", c, "__builtin_unreachable();")
    expect_c("PanicCatch record", c, "__blink_panic_frame ap_m;")
    expect_c("PanicCatch enter", c, "__blink_panic_frame_enter(&ap_m);")
    expect_c("PanicCatch setjmp", c, "if (setjmp(__blink_panic_jmp) == 0) \{")
    expect_c("PanicCatch returned", c, "__blink_assert_panics_returned(\"t.bl\", 3, 5);")
    expect_c("PanicCatch matcher", c, "if (!strstr(__blink_panic_msg, m)) \{ __blink_assert_panics_mismatch(m, __blink_panic_msg, \"t.bl\", 3, 5); }")
    expect_c("PanicCatch leave", c, "__blink_panic_frame_leave(&ap_m);")
    expect_c("PanicCatchExit", c, "goto ap_x_returned;")
    expect_c("PanicCatchExit label", c, "ap_x_returned: __attribute__((unused));")
    assert_eq(diag_ice_count, 0)
}

test "a statement kind in value position is an ICE, not a silent skip" {
    ir_reset()
    diag_reset()
    print_reset()
    let text = print_expr(ir_break(0))
    assert(text.contains("I0003"))
    assert_eq(diag_ice_count, 1)
}

test "a ContainerSpread reached on its own is an ICE, it prints only through its ContainerNew" {
    ir_reset()
    diag_reset()
    print_reset()
    let sp = ir_container_spread(4, 0, "blink_list*", "blink_list_extend", ir_var_ref(4, 0, "blink_list*", "xs", SlotForm.InlineWord))
    assert(print_expr(sp).contains("I0003"))
    assert_eq(diag_ice_count, 1)
}

test "a value kind in statement position is an ICE, not a silent skip" {
    ir_reset()
    diag_reset()
    print_reset()
    print_stmt(int_const("1"))
    let c = print_take()
    assert(c.contains("I0003"))
    assert_eq(diag_ice_count, 1)
}

test "a non-Block where a Block is required is an ICE with a visible marker" {
    ir_reset()
    diag_reset()
    print_reset()
    print_block_body(ir_break(0))
    assert(print_take().contains("I0003"))
    assert_eq(diag_ice_count, 1)
}

test "a map or set is constructed with the key-operations table its node names" {
    ir_reset()
    diag_reset()
    print_reset()
    let st = ir_container_new(13, 0, "blink_set*", "blink_set_new", "blink_kops_str", [])
    expect_c("empty set", print_expr(st), "blink_set_new(&blink_kops_str)")
    let m = ir_container_new(12, 0, "blink_map*", "blink_map_new", "blink_kops_int", [int_var("k"), int_var("v")])
    let tmp = print_expr(m)
    let pre = print_take()
    expect_c("map construction", pre, "blink_map* {tmp} = blink_map_new(&blink_kops_int);")
    expect_c("map entry", pre, "blink_map_set({tmp}, k, v);")
    assert_eq(diag_ice_count, 0)
}

test "a map that names no key-operations table is an ICE" {
    ir_reset()
    diag_reset()
    print_reset()
    let m = ir_container_new(12, 0, "blink_map*", "blink_map_new", "", [int_var("k"), int_var("v")])
    assert(print_expr(m).contains("I0003"))
    assert_eq(diag_ice_count, 1)
    let st = ir_container_new(13, 0, "blink_set*", "blink_set_new", "", [])
    assert(print_expr(st).contains("I0003"))
    assert_eq(diag_ice_count, 2)
}

test "a typedef helper given lists of unequal length is an ICE with a visible marker" {
    diag_reset()
    print_reset()
    print_effect_vtable_typedef("", "blink_ue_y_vtable", ["get"], ["__userdata_get"], [], [[]])
    print_ev("", ["blink_ue_y_vtable"], [], "")
    let c = print_take()
    assert(c.contains("I0003"))
    assert_eq(diag_ice_count, 2)
}

test "the effect vector takes the storage class the driver names" {
    print_reset()
    print_ev("", [], [], "static ")
    let a = print_take()
    assert(a.contains("static blink_ev __blink_ev;"))
    assert(a.contains("blink_ev_default(void)"))
    print_reset()
    print_ev("", [], [], "extern ")
    let b = print_take()
    assert(b.contains("extern blink_ev __blink_ev;"))
    assert(!b.contains("blink_ev_default"))
}

test "main initialises the runtime trace only when the driver asks" {
    print_reset()
    print_main_shim(true, false, false, false, true, 0, [])
    let a = print_take()
    assert(a.contains("blink_trace_init(argc, argv);"))
    print_reset()
    print_main_shim(true, false, false, false, false, 0, [])
    assert(!print_take().contains("blink_trace_init"))
}

test "each typedef helper prints its documented form inside the guard it is given" {
    print_reset()
    print_struct_typedef("BLINK_TD_blink_S", "blink_S", ["int64_t x", "const char* name"])
    print_struct_typedef("", "blink_Bare", ["int64_t x"])
    print_simple_enum_typedef("BLINK_TD_blink_Color", "blink_Color", ["blink_Color_Red", "blink_Color_Blue"])
    print_tagged_enum_typedef("BLINK_TD_blink_Shape", "blink_Shape", "int32_t", "tag", "data", ["Dot", "Line"], [[], ["int64_t _0"]], ["BLINK_TAG_Shape_Dot", "BLINK_TAG_Shape_Line"])
    print_effect_vtable_typedef("BLINK_TD_blink_ue_x_vtable", "blink_ue_x_vtable", ["get", "put"], ["__userdata_get", "__userdata_put"], ["int64_t", "void"], [["int64_t a"], []])
    print_effect_vtable_typedef("", "blink_ue_bare_vtable", [], [], [], [])
    print_effect_default_vtable("blink_ue_x_vtable", ["blink_ue_x_default_get", "blink_ue_x_default_put"])
    let c = print_take()
    expect_c("struct guard", c, "#ifndef BLINK_TD_blink_S\n#define BLINK_TD_blink_S\ntypedef struct \{\n    int64_t x;\n    const char* name;\n} blink_S;\n#endif")
    expect_c("an empty guard prints none", c, "} blink_Bare;\n#ifndef BLINK_TD_blink_Color")
    expect_c("simple enum", c, "typedef enum \{ blink_Color_Red, blink_Color_Blue } blink_Color;")
    expect_c("tagged enum tag", c, "    int32_t tag;\n    union \{")
    expect_c("tagged enum variant", c, "        struct \{\n            int64_t _0;\n        } Line;")
    expect_c("tagged enum data", c, "    } data;\n} blink_Shape;")
    expect_c("tag macro", c, "#ifndef BLINK_TAG_Shape_Line\n#define BLINK_TAG_Shape_Line 1\n#endif")
    expect_c("vtable slots then capture words", c, "    int64_t (*get)(void* __self, int64_t a);\n    void (*put)(void* __self);\n    void* __userdata_get;\n    void* __userdata_put;\n} blink_ue_x_vtable;")
    expect_c("bare vtable is never empty", c, "typedef struct \{\n    void* __userdata;\n} blink_ue_bare_vtable;")
    expect_c("default vtable order", c, "blink_ue_x_vtable_default = \{\n    blink_ue_x_default_get,\n    blink_ue_x_default_put,\n    NULL,\n    NULL,\n};")
}

test "field access spells -> through a pointer-held object and . through an inline one" {
    ir_reset()
    print_reset()
    let sp = sp_var()
    let sv = s_var()
    assert(ir_held_by_pointer(sp))
    assert(!ir_held_by_pointer(sv))
    assert_eq(print_expr(ir_field_get(1, 0, "int64_t", "x", SlotForm.InlineWord, sp)), "sp->x")
    assert_eq(print_expr(ir_field_get(1, 0, "int64_t", "x", SlotForm.InlineWord, sv)), "s.x")
    assert_eq(print_expr(ir_call_virtual(1, 0, "int64_t", "get", SlotForm.InlineWord, sp, [])), "(sp)->get()")
    assert_eq(print_expr(ir_call_virtual(1, 0, "int64_t", "get", SlotForm.InlineWord, sv, [])), "(s).get()")
}
