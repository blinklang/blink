import std.io
import std.process.{ProcessResult}
import ir.{
    ir_reset, ir_verify, ir_mark_materialize,
    ir_const, ir_var_ref, ir_global_ref, ir_unary, ir_binary, ir_cast, ir_field_get, ir_struct_new,
    ir_container_new, ir_box, ir_unbox, ir_carrier_wrap, ir_carrier_unwrap, ir_carrier_tag,
    ir_call_direct, ir_call_closure, ir_call_virtual, ir_call_runtime, ir_closure_new, ir_effect_perform, ir_evidence_vector,
    ir_handler_install, ir_let, ir_assign, ir_expr_stmt, ir_return, ir_if, ir_loop, ir_break, ir_block,
    ir_switch, ir_with_scope,
}
import layout.{SlotForm}
import cg_print.{
    print_reset, print_take, print_prologue, print_ev, print_fn_decl, print_fn, print_closure_thunk_decl,
    print_closure_thunk, print_struct_typedef, print_typedef_blocks, print_effect_vtable_typedef,
    print_effect_default_vtable, print_scope_restore_support, print_main_shim,
}
// lexer and parser read the trace globals that compiler.bl owns, so a test that imports
// typecheck through layout must load compiler as well.
import compiler.{compile_to_program}

fn scratch_dir() -> Str {
    let d = env.var("BLINK_TEST_SCRATCH") ?? "build/cg_print_scratch"
    shell_exec("mkdir -p {d}")
    d
}

// The printed C targets the pinned gen0 archive. gen0 lives under build/gen0/ at the repo
// root, which is a parent of a worktree, so walk up from the working directory.
fn gen0_share_dir() -> Str {
    let forced = env.var("BLINK_GEN0") ?? ""
    if forced != "" { return "{forced}/share/blink" }
    let mut prefix = ""
    let mut depth = 0
    while depth < 6 {
        let cand = "{prefix}build/gen0/share/blink"
        if file_exists("{cand}/libblink_std.a") == 1 { return cand }
        prefix = "{prefix}../"
        depth += 1
    }
    ""
}

fn cc_and_run(tag: Str, c_text: Str) -> ProcessResult {
    let share = gen0_share_dir()
    if share == "" {
        io.println("FAIL[{tag}]: build/gen0/share/blink not found from the working directory")
        assert(false)
    }
    let dir = scratch_dir()
    let c_path = "{dir}/{tag}.c"
    let bin = "{dir}/{tag}"
    write_file(c_path, c_text)
    let cc = process_run("cc", ["-o", bin, c_path, "-I{share}", "{share}/libblink_std.a", "-lm", "-lgc", "-pthread", "-Wl,--gc-sections"])
    if cc.exit_code != 0 {
        io.println("FAIL[{tag}] cc exit={cc.exit_code}\n{cc.err_out}{cc.out}")
        return cc
    }
    process_run(bin, [])
}

fn int_const(text: Str) -> Int { ir_const(1, 0, "int64_t", text) }
fn str_const(text: Str) -> Int { ir_const(2, 0, "const char*", "\"{text}\"") }
fn int_var(name: Str) -> Int { ir_var_ref(1, 0, "int64_t", name, SlotForm.InlineWord) }
fn word(v: Int) -> Int { ir_cast(3, 0, "void*", ir_cast(1, 0, "intptr_t", v)) }

fn ev_param() -> Int { ir_evidence_vector(0, "blink_ev*", "__ev", SlotForm.PointerBoxed) }

fn io_print(arg: Int) -> Int {
    let io_slot = ir_field_get(20, 0, "blink_io_vtable*", "io", SlotForm.PointerBoxed, ev_param())
    ir_expr_stmt(0, ir_effect_perform(0, 0, "void", "print", SlotForm.Inline, io_slot, [arg]))
}

fn log_perform(arg: Int) -> Int {
    let log_slot = ir_field_get(14, 0, "blink_ue_log_vtable*", "ue_log", SlotForm.PointerBoxed, ev_param())
    ir_expr_stmt(0, ir_effect_perform(0, 0, "void", "log", SlotForm.Inline, log_slot, [arg]))
}

fn fmt_int(v: Int, fmt: Str) -> Int {
    ir_call_runtime(2, 0, "const char*", "blink_str_format", SlotForm.InlineWord,
        [str_const(fmt), ir_cast(1, 0, "long long", v)])
}

// fn first_pos(xs: List[Int]) -> Option[Int]: a loop, an if, a Break, an early Return of
// Some and a final None.
fn first_pos_body() -> Int {
    let n = ir_let(1, 0, "int64_t", "n", SlotForm.InlineWord,
        ir_call_runtime(1, 0, "int64_t", "blink_list_len", SlotForm.InlineWord, [ir_var_ref(4, 0, "blink_list*", "xs", SlotForm.PointerBoxed)]))
    let i0 = ir_let(1, 0, "int64_t", "i", SlotForm.InlineWord, int_const("0"))
    let done = ir_if(0, ir_binary(5, 0, "int", ">=", int_var("i"), int_var("n")), ir_block(0, [ir_break(0)]), -1)
    let got = ir_call_runtime(3, 0, "void*", "blink_list_get", SlotForm.InlineWord,
        [ir_var_ref(4, 0, "blink_list*", "xs", SlotForm.PointerBoxed), int_var("i")])
    let v = ir_let(1, 0, "int64_t", "v", SlotForm.InlineWord, ir_cast(1, 0, "int64_t", ir_cast(1, 0, "intptr_t", got)))
    let some = ir_carrier_wrap(8, 0, "blink_Option_int", "value", int_const("1"), int_var("v"))
    let hit = ir_if(0, ir_binary(5, 0, "int", ">", int_var("v"), int_const("0")), ir_block(0, [ir_return(0, some)]), -1)
    let step = ir_assign(0, int_var("i"), ir_binary(1, 0, "int64_t", "+", int_var("i"), int_const("1")))
    let lp = ir_loop(0, ir_block(0, [done, v, hit, step]))
    let none = ir_carrier_wrap(8, 0, "blink_Option_int", "", int_const("0"), -1)
    ir_block(0, [n, i0, lp, ir_return(0, none)])
}

// The closure thunk adds its argument to the x field of a captured, boxed Point.
fn closure_body() -> Int {
    let cap = ir_call_runtime(3, 0, "void*", "blink_closure_get_capture", SlotForm.InlineWord,
        [ir_var_ref(9, 0, "const blink_closure*", "__self", SlotForm.PointerBoxed), int_const("0")])
    let pt = ir_unbox(6, 0, "blink_Point", SlotForm.Inline, ir_cast(7, 0, "blink_Point*", cap))
    let x = ir_field_get(1, 0, "int64_t", "x", SlotForm.InlineWord, pt)
    ir_block(0, [ir_return(0, ir_binary(1, 0, "int64_t", "+", int_var("a"), x))])
}

// The handler for Log.log writes through the io slot of the global vector, which a plain
// vtable function reaches as a global receiver.
fn handler_body() -> Int {
    let recv = ir_global_ref(10, 0, "blink_io_vtable*", "__blink_ev.io", SlotForm.PointerBoxed)
    let msg = ir_call_runtime(2, 0, "const char*", "blink_str_format", SlotForm.InlineWord,
        [str_const("[log] %s"), ir_var_ref(2, 0, "const char*", "msg", SlotForm.InlineWord)])
    ir_block(0, [ir_expr_stmt(0, ir_call_virtual(0, 0, "void", "print", SlotForm.Inline, recv, [msg]))])
}

fn main_body() -> Int {
    let xs = ir_let(4, 0, "blink_list*", "xs", SlotForm.PointerBoxed,
        ir_container_new(4, 0, "blink_list*", "blink_list_new", "", [word(int_const("0")), word(int_const("-3")), word(int_const("7"))]))
    let o = ir_let(8, 0, "blink_Option_int", "o", SlotForm.Inline,
        ir_call_direct(8, 0, "blink_Option_int", "first_pos", SlotForm.Inline,
            [ir_var_ref(4, 0, "blink_list*", "xs", SlotForm.PointerBoxed), ir_var_ref(11, 0, "blink_ev*", "__ev", SlotForm.PointerBoxed)]))
    let o_ref = ir_var_ref(8, 0, "blink_Option_int", "o", SlotForm.Inline)
    let found = io_print(fmt_int(ir_carrier_unwrap(1, 0, "int64_t", "value", SlotForm.InlineWord, o_ref), "found %lld"))
    let sw = ir_switch(0, ir_carrier_tag(5, 0, "int", o_ref), [int_const("1"), ir_block(0, [found])], ir_block(0, [io_print(str_const("none"))]))

    let p = ir_let(6, 0, "blink_Point", "p", SlotForm.Inline, ir_struct_new(6, 0, "blink_Point", [int_const("7"), int_const("9")]))
    let pb = ir_let(7, 0, "blink_Point*", "pb", SlotForm.PointerBoxed,
        ir_box(7, 0, "blink_Point*", "blink_Point", ir_var_ref(6, 0, "blink_Point", "p", SlotForm.Inline)))
    let add = ir_let(9, 0, "blink_closure*", "add", SlotForm.PointerBoxed,
        ir_closure_new(9, 0, "blink_closure*", "__closure_0", "", "", [ir_var_ref(7, 0, "blink_Point*", "pb", SlotForm.PointerBoxed)]))
    let r = ir_let(1, 0, "int64_t", "r", SlotForm.InlineWord,
        ir_call_closure(1, 0, "int64_t", "int64_t(*)(const blink_closure*, int64_t)", SlotForm.InlineWord,
            ir_var_ref(9, 0, "blink_closure*", "add", SlotForm.PointerBoxed), [int_const("4")]))
    let show_r = io_print(fmt_int(int_var("r"), "%lld"))

    let hv = ir_let(12, 0, "blink_ue_log_vtable", "hv", SlotForm.Inline,
        ir_struct_new(12, 0, "blink_ue_log_vtable", [ir_global_ref(13, 0, "void*", "handler_log", SlotForm.InlineWord), ir_const(3, 0, "void*", "NULL")]))
    let log_call = log_perform(str_const("from handler"))
    let install = ir_handler_install(0, "ue_log",
        ir_unary(14, 0, "blink_ue_log_vtable*", "&", ir_var_ref(12, 0, "blink_ue_log_vtable", "hv", SlotForm.Inline)),
        ir_block(0, [log_call]))
    let silent = log_perform(str_const("dropped by default"))
    let arena = ir_with_scope(0, "", -1, ir_block(0, [io_print(str_const("in arena"))]))
    ir_block(0, [xs, o, sw, p, pb, add, r, show_r, hv, install, silent, arena])
}

fn print_program() -> Str ! Diag.Report {
    print_reset()
    print_prologue(true, false, false, "", "")
    print_struct_typedef("BLINK_TD_blink_Point", "blink_Point", ["int64_t x", "int64_t y"])
    print_typedef_blocks(["#ifndef BLINK_TD_blink_Option_int\n#define BLINK_TD_blink_Option_int\ntypedef struct \{ int tag; int64_t value; } blink_Option_int;\n#endif"])
    print_effect_vtable_typedef("BLINK_TD_blink_ue_log_vtable", "blink_ue_log_vtable", ["log"], ["void"], [["const char* msg"]])
    print_fn(true, "void", "blink_ue_log_default_log", ["const char* msg"], false, ir_block(0, []))
    print_effect_default_vtable("blink_ue_log_vtable", ["blink_ue_log_default_log"])
    print_ev("BLINK_TD_blink_ev", ["blink_ue_log_vtable"], ["ue_log"], "")
    print_scope_restore_support()
    print_fn_decl(true, "blink_Option_int", "first_pos", ["blink_list* xs"], true)
    print_closure_thunk_decl("int64_t", "__closure_0", ["int64_t a"])
    print_fn_decl(true, "void", "handler_log", ["const char* msg"], false)
    print_fn_decl(false, "void", "blink_main", [], true)
    print_fn(true, "blink_Option_int", "first_pos", ["blink_list* xs"], true, first_pos_body())
    print_closure_thunk("int64_t", "__closure_0", ["int64_t a"], closure_body())
    print_fn(true, "void", "handler_log", ["const char* msg"], false, handler_body())
    print_fn(false, "void", "blink_main", [], true, main_body())
    print_main_shim(true, false, false, true, false, 0, [])
    print_take()
}

test "a program with Option, List, struct, closure and effect handler compiles and runs" {
    ir_reset()
    let c_text = print_program()
    write_file("{scratch_dir()}/cg_print_fn_shapes.c", c_text)
    assert(c_text.contains("static blink_Option_int first_pos(blink_list* xs, blink_ev* __ev) \{"))
    assert(c_text.contains("static int64_t __closure_0(const blink_closure* __self, int64_t a) \{"))
    assert(c_text.contains("return ((blink_Option_int)\{.tag = 1, .value = v});"))
    assert(c_text.contains("return ((blink_Option_int)\{.tag = 0});"))
    assert(c_text.contains("blink_list_push(_c0, ((void*)(((intptr_t)(0)))));"))
    assert(c_text.contains(" = o.tag;"))
    assert(c_text.contains(" == 1) \{"))
    assert(c_text.contains(" = (blink_Point*)blink_alloc(sizeof(blink_Point));"))
    assert(c_text.contains("blink_closure_new_typed((void*)__closure_0, _caps"))
    assert(c_text.contains("((int64_t(*)(const blink_closure*, int64_t))add->fn_ptr)(add, 4);"))
    assert(c_text.contains("(__blink_ev.io)->print(blink_str_format(\"[log] %s\", msg));"))
    assert(c_text.contains("__blink_ev.ue_log = (&hv);"))
    assert(c_text.contains("(__ev->ue_log)->log(\"from handler\");"))
    assert(c_text.contains("__attribute__((cleanup(__blink_arena_restore)))"))

    let r = cc_and_run("cg_print_fn_shapes", c_text)
    if r.exit_code != 0 { io.println("FAIL run exit={r.exit_code}\n{r.err_out}{r.out}") }
    assert_eq(r.exit_code, 0)
    assert_eq(r.out, "found 7\n11\n[log] from handler\nin arena\n")
}
