import std.io
import ir.{
    ir_reset, ir_verify, ir_mark_materialize,
    ir_const, ir_var_ref, ir_binary, ir_call_direct, ir_let, ir_expr_stmt, ir_return, ir_if, ir_block,
    ir_assign, ir_field_set, ir_field_get,
}
import layout.{SlotForm}
import cg_print.{print_reset, print_take, print_block_body}
// lexer and parser read the trace globals that compiler.bl owns, so a test that imports
// typecheck through layout must load compiler as well.
import compiler.{compile_to_program}

fn int_const(text: Str) -> Int { ir_const(1, 0, "int64_t", text) }
fn int_var(name: Str) -> Int { ir_var_ref(1, 0, "int64_t", name, SlotForm.InlineWord) }
fn call_f(args: List[Int]) -> Int { ir_call_direct(1, 0, "int64_t", "main_f", SlotForm.InlineWord, args) }

fn print_body(block: Int) -> Str ! Diag.Report {
    let errs = ir_verify(block)
    if errs.len() > 0 { io.println("FAIL verify: {errs.join(" | ")}") }
    assert_eq(errs.len(), 0)
    print_reset()
    print_block_body(block)
    print_take()
}

fn lines_of(c: Str) -> List[Str] {
    let mut out: List[Str] = []
    for l in c.split("\n") { if l != "" { out.push(l) } }
    out
}

test "an unflagged value tree prints as one nested C expression" {
    ir_reset()
    let e = ir_binary(1, 0, "int64_t", "*", ir_binary(1, 0, "int64_t", "+", int_var("a"), call_f([int_const("1")])), int_const("2"))
    let c = print_body(ir_block(0, [ir_let(1, 0, "int64_t", "x", SlotForm.InlineWord, e)]))
    let ls = lines_of(c)
    assert_eq(ls.len(), 1)
    assert_eq(ls.get(0).unwrap(), "int64_t x = ((a + main_f(1)) * 2);")
}

test "a flagged value is bound to a temporary before the statement that uses it" {
    ir_reset()
    let call = call_f([])
    ir_mark_materialize(call)
    let e = ir_binary(1, 0, "int64_t", "+", call, int_const("2"))
    let c = print_body(ir_block(0, [ir_let(1, 0, "int64_t", "x", SlotForm.InlineWord, e)]))
    let ls = lines_of(c)
    assert_eq(ls.len(), 2)
    assert_eq(ls.get(0).unwrap(), "int64_t _t0 = main_f();")
    assert_eq(ls.get(1).unwrap(), "int64_t x = (_t0 + 2);")
}

test "a shared flagged node is evaluated once and its temporary is reused" {
    ir_reset()
    let call = call_f([])
    ir_mark_materialize(call)
    let e = ir_binary(1, 0, "int64_t", "+", call, call)
    let c = print_body(ir_block(0, [ir_return(0, e)]))
    let ls = lines_of(c)
    assert_eq(ls.len(), 2)
    assert_eq(ls.get(0).unwrap(), "int64_t _t0 = main_f();")
    assert_eq(ls.get(1).unwrap(), "return (_t0 + _t0);")
}

test "temporaries land in the block that consumes them, before the consuming statement" {
    ir_reset()
    let call = call_f([])
    ir_mark_materialize(call)
    let inner = ir_block(0, [ir_return(0, ir_binary(1, 0, "int64_t", "-", call, int_const("1")))])
    let cond = ir_binary(5, 0, "int", ">", int_var("a"), int_const("0"))
    let c = print_body(ir_block(0, [ir_if(0, cond, inner, -1)]))
    let ls = lines_of(c)
    assert_eq(ls.len(), 4)
    assert_eq(ls.get(0).unwrap(), "if ((a > 0)) \{")
    assert_eq(ls.get(1).unwrap(), "    int64_t _t0 = main_f();")
    assert_eq(ls.get(2).unwrap(), "    return (_t0 - 1);")
    assert_eq(ls.get(3).unwrap(), "}")
}

test "a void expression statement prints bare even when flagged" {
    ir_reset()
    let call = ir_call_direct(0, 0, "void", "main_g", SlotForm.Inline, [])
    ir_mark_materialize(call)
    let c = print_body(ir_block(0, [ir_expr_stmt(0, call)]))
    let ls = lines_of(c)
    assert_eq(ls.len(), 1)
    assert_eq(ls.get(0).unwrap(), "main_g();")
}

test "a flagged non-void expression statement binds once and a later reach reuses the temporary" {
    ir_reset()
    let call = call_f([])
    ir_mark_materialize(call)
    let c = print_body(ir_block(0, [ir_expr_stmt(0, call), ir_return(0, call)]))
    let ls = lines_of(c)
    assert_eq(ls.len(), 3)
    assert_eq(ls.get(0).unwrap(), "int64_t _t0 = main_f();")
    assert_eq(ls.get(1).unwrap(), "(void)_t0;")
    assert_eq(ls.get(2).unwrap(), "return _t0;")
}

test "an unflagged expression statement prints bare" {
    ir_reset()
    let c = print_body(ir_block(0, [ir_expr_stmt(0, call_f([]))]))
    let ls = lines_of(c)
    assert_eq(ls.len(), 1)
    assert_eq(ls.get(0).unwrap(), "main_f();")
}

test "the temp counter restarts at zero for each function" {
    ir_reset()
    let call = call_f([])
    ir_mark_materialize(call)
    let first = print_body(ir_block(0, [ir_let(1, 0, "int64_t", "x", SlotForm.InlineWord, call)]))
    assert(first.contains("_t0"))
    let again = call_f([])
    ir_mark_materialize(again)
    let second = print_body(ir_block(0, [ir_let(1, 0, "int64_t", "y", SlotForm.InlineWord, again)]))
    assert(second.contains("int64_t _t0 = main_f();"))
}

test "a store through a shared flagged lvalue lands in place, never in the temporary" {
    ir_reset()
    let p = ir_var_ref(7, 0, "blink_S*", "p", SlotForm.PointerBoxed)
    let px = ir_field_get(1, 0, "int64_t", "x", SlotForm.InlineWord, p)
    ir_mark_materialize(px)
    let sum = ir_binary(1, 0, "int64_t", "+", px, int_const("1"))
    let c = print_body(ir_block(0, [ir_assign(0, px, sum)]))
    let ls = lines_of(c)
    assert_eq(ls.len(), 2)
    assert_eq(ls.get(0).unwrap(), "int64_t _t0 = p->x;")
    assert_eq(ls.get(1).unwrap(), "p->x = (_t0 + 1);")
}

test "two flagged operands bind in source order, left before right" {
    ir_reset()
    let f = call_f([])
    let g = ir_call_direct(1, 0, "int64_t", "main_g", SlotForm.InlineWord, [])
    ir_mark_materialize(f)
    ir_mark_materialize(g)
    let e = ir_binary(1, 0, "int64_t", "+", f, g)
    let c = print_body(ir_block(0, [ir_let(1, 0, "int64_t", "x", SlotForm.InlineWord, e)]))
    let ls = lines_of(c)
    assert_eq(ls.len(), 3)
    assert_eq(ls.get(0).unwrap(), "int64_t _t0 = main_f();")
    assert_eq(ls.get(1).unwrap(), "int64_t _t1 = main_g();")
    assert_eq(ls.get(2).unwrap(), "int64_t x = (_t0 + _t1);")
}

test "a field store evaluates its value after the target, in source order" {
    ir_reset()
    let p = ir_var_ref(7, 0, "blink_S*", "p", SlotForm.PointerBoxed)
    let v = call_f([])
    ir_mark_materialize(v)
    let c = print_body(ir_block(0, [ir_field_set(0, "x", p, v)]))
    let ls = lines_of(c)
    assert_eq(ls.len(), 2)
    assert_eq(ls.get(0).unwrap(), "int64_t _t0 = main_f();")
    assert_eq(ls.get(1).unwrap(), "p->x = _t0;")
}

test "a shared flagged void call runs once across two expression statements" {
    ir_reset()
    let call = ir_call_direct(0, 0, "void", "main_g", SlotForm.Inline, [])
    ir_mark_materialize(call)
    let c = print_body(ir_block(0, [ir_expr_stmt(0, call), ir_expr_stmt(0, call)]))
    let ls = lines_of(c)
    assert_eq(ls.len(), 1)
    assert_eq(ls.get(0).unwrap(), "main_g();")
}
