// The C a `with expr as name` resource gets on the way out: a guard local whose cleanup
// attribute runs the resource's exit method once on every C exit path, and a cleanup-stack
// entry so an armed panic (assert_panics) runs the same exit through the runtime's longjmp
// drain. The printer is handed the exit symbol and the resource's C spelling; it decides
// only the C text.

import std.io
import std.process.{ProcessResult}
import cg_print.{print_reset, print_take, print_prologue, print_fn, print_stmt, print_resource_guard_support}
import ir.{ir_var_ref, ir_const, ir_block, ir_expr_stmt, ir_return, ir_if, ir_call_runtime, ir_with_scope}
import layout.{SlotForm}
// lexer and parser read the trace globals that compiler.bl owns, so a test that imports
// typecheck through layout must load compiler as well.
import compiler.{compile_to_program}
import diagnostics.{diag_reset, diag_ice_count}

fn lines_of(c: Str) -> List[Str] {
    let mut out: List[Str] = []
    for l in c.split("\n") { if l != "" { out.push(l.trim()) } }
    out
}

fn scratch_dir() -> Str {
    let d = env.var("BLINK_TEST_SCRATCH") ?? "build/cg_print_scratch"
    shell_exec("mkdir -p {d}")
    d
}

// The printed C targets the pinned gen0 archive. gen0 lives under build/gen0/ at the repo
// root, which is a parent of a worktree, so walk up from the working directory.
fn gen0_share_dir() -> Str {
    let forced = env.var("BLINK_GEN0") ?? ""
    if forced != "" { return "{forced}/share/blink" }
    let mut prefix = ""
    let mut depth = 0
    while depth < 6 {
        let cand = "{prefix}build/gen0/share/blink"
        if file_exists("{cand}/libblink_std.a") == 1 { return cand }
        prefix = "{prefix}../"
        depth += 1
    }
    ""
}

fn cc_and_run(tag: Str, c_text: Str) -> ProcessResult {
    let share = gen0_share_dir()
    if share == "" {
        io.println("FAIL[{tag}]: build/gen0/share/blink not found from the working directory")
        assert(false)
    }
    let dir = scratch_dir()
    let c_path = "{dir}/{tag}.c"
    let bin = "{dir}/{tag}"
    write_file(c_path, c_text)
    let cc = process_run("cc", ["-o", bin, c_path, "-I{share}", "{share}/libblink_std.a", "-lm", "-lgc", "-pthread", "-Wl,--gc-sections"])
    if cc.exit_code != 0 {
        io.println("FAIL[{tag}] cc exit={cc.exit_code}\n{cc.err_out}{cc.out}")
        return cc
    }
    process_run(bin, [])
}

fn str_const(s: Str) -> Int { ir_const(2, 0, "const char*", "\"{s}\"") }
fn int_const(s: Str) -> Int { ir_const(1, 0, "int64_t", s) }
fn puts_stmt(s: Str) -> Int { ir_expr_stmt(0, ir_call_runtime(-1, 0, "void", "puts", SlotForm.Inline, [str_const(s)])) }
fn res_ref() -> Int { ir_var_ref(13, 0, "Res", "r", SlotForm.Inline) }

test "an exit that takes no ok flag gets a state typedef, a run-once runner and an attribute cleanup" {
    print_reset()
    print_resource_guard_support("Res_close", "Res", false)
    let ls = lines_of(print_take())
    assert_eq(ls.len(), 12)
    assert_eq(ls.get(0).unwrap(), "typedef struct \{ Res resource; int ok; int done; } __blink_rs_state_Res_close;")
    assert_eq(ls.get(1).unwrap(), "static void __blink_rs_run_Res_close(void* p, int ok) \{")
    assert_eq(ls.get(2).unwrap(), "(void)ok;")
    assert_eq(ls.get(3).unwrap(), "__blink_rs_state_Res_close* st = (__blink_rs_state_Res_close*)p;")
    assert_eq(ls.get(4).unwrap(), "if (st->done) \{ return; }")
    assert_eq(ls.get(5).unwrap(), "st->done = 1;")
    assert_eq(ls.get(6).unwrap(), "Res_close(st->resource);")
    assert_eq(ls.get(7).unwrap(), "}")
    assert_eq(ls.get(8).unwrap(), "static void __blink_rs_cleanup_Res_close(__blink_rs_state_Res_close* st) \{")
    assert_eq(ls.get(9).unwrap(), "__blink_cleanup_pop((void*)st);")
    assert_eq(ls.get(10).unwrap(), "__blink_rs_run_Res_close((void*)st, st->ok);")
    assert_eq(ls.get(11).unwrap(), "}")
}

test "an exit that takes the ok flag is handed the runner's ok" {
    print_reset()
    print_resource_guard_support("Res_exit", "Res", true)
    let c = print_take()
    assert(c.contains("Res_exit(st->resource, ok);"))
    assert(!c.contains("(void)ok;"))
}

test "support for one exit symbol is defined once per TU however often it is asked for" {
    print_reset()
    print_resource_guard_support("Res_close", "Res", false)
    print_resource_guard_support("Res_close", "Res", false)
    let once = print_take()
    print_reset()
    print_resource_guard_support("Res_close", "Res", false)
    assert_eq(once, print_take())
}

test "a resource scope binds a guard, registers it while armed, and marks ok after the body" {
    print_reset()
    print_resource_guard_support("Res_exit", "Res", true)
    let _ = print_take()
    print_stmt(ir_with_scope(0, "Res_exit", res_ref(), ir_block(0, [puts_stmt("body")])))
    let ls = lines_of(print_take())
    assert_eq(ls.len(), 6)
    assert_eq(ls.get(0).unwrap(), "\{")
    assert_eq(ls.get(1).unwrap(), "__blink_rs_state_Res_exit _rs0 __attribute__((cleanup(__blink_rs_cleanup_Res_exit))) = \{ .resource = r, .ok = 0, .done = 0 };")
    assert_eq(ls.get(2).unwrap(), "if (__blink_panic_armed) \{ __blink_cleanup_push((void*)&_rs0, __blink_rs_run_Res_exit, &_rs0.done); }")
    assert_eq(ls.get(3).unwrap(), "puts(\"body\");")
    assert_eq(ls.get(4).unwrap(), "_rs0.ok = 1;")
    assert_eq(ls.get(5).unwrap(), "}")
}

// One resource type with an exit method that reports the ok flag it was handed. `probe`
// leaves its scope by falling through or by an early return; `drain` simulates the armed
// unwind by asking the runtime to run the cleanup stack while the body is still open.
fn guard_program(prologue: Str, support: Str, fns: Str) -> Str {
    let head = "typedef struct \{ int64_t id; } Res;\nstatic void Res_exit(Res r, int ok) \{ printf(\"exit %lld %d\\n\", (long long)r.id, ok); }\n"
    let main_body = "    Res r = \{ 7 };\n    probe(r, 0);\n    probe(r, 1);\n    __blink_panic_armed = 1;\n    drain(r);\n    __blink_panic_armed = 0;\n    puts(\"end\");\n"
    "{prologue}{head}{support}{fns}int main(void) \{\n    GC_INIT();\n{main_body}    return 0;\n}\n"
}

fn early_return() -> Int {
    ir_if(0, ir_var_ref(1, 0, "int64_t", "early", SlotForm.InlineWord), ir_block(0, [ir_return(0, -1)]), -1)
}

test "the exit runs exactly once on fall-through, on return and on an armed drain, with the right ok" {
    print_reset()
    print_prologue(true, false, false, "", "")
    let prologue = print_take()
    print_resource_guard_support("Res_exit", "Res", true)
    let support = print_take()
    let probe_body = ir_block(0, [ir_with_scope(0, "Res_exit", res_ref(), ir_block(0, [early_return(), puts_stmt("body")]))])
    print_fn(true, "void", "probe", ["Res r", "int64_t early"], false, probe_body)
    let drain_call = ir_expr_stmt(0, ir_call_runtime(-1, 0, "void", "__blink_cleanup_run_to", SlotForm.Inline, [int_const("0")]))
    let drain_body = ir_block(0, [ir_with_scope(0, "Res_exit", res_ref(), ir_block(0, [drain_call, puts_stmt("after drain")]))])
    print_fn(true, "void", "drain", ["Res r"], false, drain_body)
    let r = cc_and_run("cg_print_resource_guard", guard_program(prologue, support, print_take()))
    if r.exit_code != 0 { io.println("FAIL run exit={r.exit_code}\n{r.err_out}{r.out}") }
    assert_eq(r.exit_code, 0)
    assert_eq(r.out, "body\nexit 7 1\nexit 7 0\nexit 7 0\nafter drain\nend\n")
}

// The shapes the printer refuses: no exit symbol, an exit symbol whose support this TU never
// defined, and a resource value spelled unlike the support's state field. Each records an
// ICE and prints a plain binding, so the TU still compiles and the ICE is the signal.
test "a resource scope without a defined guard support is an ICE that prints a plain binding" {
    diag_reset()
    print_reset()
    print_stmt(ir_with_scope(0, "Res_exit", res_ref(), ir_block(0, [])))
    let c = print_take()
    assert_eq(diag_ice_count, 1)
    assert(c.contains("Res _rs0 = r;"))
    assert(!c.contains("__attribute__"))
}

test "a resource scope with no exit symbol is an ICE, not a silent guard" {
    diag_reset()
    print_reset()
    print_stmt(ir_with_scope(0, "", res_ref(), ir_block(0, [])))
    let c = print_take()
    assert_eq(diag_ice_count, 1)
    assert(c.contains("Res _rs0 = r;"))
}

test "a resource spelled unlike the support's state field is an ICE" {
    diag_reset()
    print_reset()
    print_resource_guard_support("Res_exit", "Res*", true)
    print_stmt(ir_with_scope(0, "Res_exit", res_ref(), ir_block(0, [])))
    let c = print_take()
    assert_eq(diag_ice_count, 1)
    assert(c.contains("Res _rs0 = r;"))
}

test "a second support request that disagrees on the resource spelling is an ICE" {
    diag_reset()
    print_reset()
    print_resource_guard_support("Res_exit", "Res", true)
    print_resource_guard_support("Res_exit", "Res*", true)
    assert_eq(diag_ice_count, 1)
    assert_eq(lines_of(print_take()).len(), 11)
}
