import std.fs
import std.io
import typecheck.{lookup_named_type}
import parser.{node_name, node_set_module}
import cg_reg.{
    cg_reg_reset, cg_reg_build, cg_reg_type_decls, cg_reg_fn_decls, cg_reg_effect_decls,
    cg_reg_global_decls, cg_reg_trait_decls, cg_reg_impl_decls, cg_reg_test_decls,
    cg_reg_decl_for_tid, cg_reg_tid_for_decl, cg_reg_module_of, cg_reg_modules, cg_reg_has_main,
}
import layout.{layout_reset}
import cg_test_helpers.{cg_probe_compile, cg_probe_key_count, cg_probe_key_index}

fn assert_eq_int(label: Str, got: Int, want: Int) {
    if got != want {
        io.println("FAIL: {label}: got {got} want {want}")
    }
    assert_eq(got, want)
}

fn assert_eq_str(label: Str, got: Str, want: Str) {
    if got != want {
        io.println("FAIL: {label}: got '{got}' want '{want}'")
    }
    assert_eq(got, want)
}

// The module rows below stamp the keys they need onto the parsed declarations, so they
// read the same whatever key the front end gave the probe's own file.
fn probe_src() -> Str {
    #"type Point { x: Int, y: Int }
type Color { Red, Green }
effect Metrics {
    effect Emit {
        fn counter(name: Str)
    }
}
trait Named {
    fn label(self) -> Str
}
impl Named for Point {
    fn label(self) -> Str { "p" }
}
let origin: Int = 0
fn helper(p: Point) -> Int { p.x }
fn main() {
    assert(helper(Point { x: 1, y: 2 }) == 1)
}
test "point keeps its x" {
    assert(Point { x: 3, y: 4 }.x == 3)
}
"#
}

// The probe is deleted BEFORE any assertion so a red row never leaves the file behind.
fn build_probe() -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS.Delete {
    let path = "build/cg_reg_registry_probe_src.bl"
    let program = cg_probe_compile(path, probe_src())
    layout_reset()
    let _ = fs.delete(path)
    cg_reg_reset()
    cg_reg_build(program)
    program
}

fn named(decls: List[Int], name: Str) -> Int {
    let mut i = 0
    while i < decls.len() {
        let d = decls.get(i).unwrap()
        if node_name(d) == name { return d }
        i = i + 1
    }
    -1
}

fn assert_registered(label: Str, decls: List[Int], name: Str) -> Int {
    let d = named(decls, name)
    if d == -1 {
        io.println("FAIL: {label}: no registered declaration named '{name}'")
    }
    assert(d != -1)
    d
}

// Every declaration kind the driver walks lands in its own registry, so no later stage
// re-walks the AST hunting for one.
test "cg_reg_build files each declaration kind in its own registry" {
    let _program = build_probe()
    let _ = assert_registered("types", cg_reg_type_decls(), "Point")
    let _ = assert_registered("types", cg_reg_type_decls(), "Color")
    let _ = assert_registered("fns", cg_reg_fn_decls(), "helper")
    let _ = assert_registered("fns", cg_reg_fn_decls(), "main")
    let _ = assert_registered("effects", cg_reg_effect_decls(), "Metrics")
    let _ = assert_registered("traits", cg_reg_trait_decls(), "Named")
    let _ = assert_registered("globals", cg_reg_global_decls(), "origin")
    assert(cg_reg_impl_decls().len() > 0)
    assert(cg_reg_test_decls().len() > 0)
    assert(cg_reg_has_main())
}

// The registry is keyed on the type id, not on the printed type name: a tid answers its
// declaration node and that node answers the same tid back.
test "a nominal type id round-trips to its declaration node" {
    let _program = build_probe()
    let point_decl = assert_registered("types", cg_reg_type_decls(), "Point")
    let point_tid = lookup_named_type("Point")
    assert(point_tid >= 0)
    assert_eq_int("tid answers decl", cg_reg_decl_for_tid(point_tid), point_decl)
    assert_eq_int("decl answers tid", cg_reg_tid_for_decl(point_decl), point_tid)

    let color_decl = assert_registered("types", cg_reg_type_decls(), "Color")
    let color_tid = lookup_named_type("Color")
    assert(color_tid >= 0)
    assert_eq_int("enum tid answers decl", cg_reg_decl_for_tid(color_tid), color_decl)
    assert_eq_int("enum decl answers tid", cg_reg_tid_for_decl(color_decl), color_tid)
}

// A type id with no declaration of its own answers -1 rather than a neighbour's node.
test "an unregistered type id answers no declaration node" {
    let _program = build_probe()
    assert_eq_int("Int has no decl node", cg_reg_decl_for_tid(lookup_named_type("Int")), -1)
    assert_eq_int("negative tid", cg_reg_decl_for_tid(-1), -1)
    assert_eq_int("unregistered node", cg_reg_tid_for_decl(999999), -1)
}

// The module list holds each key once in first-seen order, which is the order the
// per-module driver emits in. A declaration the parser left unattributed rides in the
// aggregate output and names no module of its own.
//
// The keys below are stamped by hand, and the claims are about those keys' positions
// relative to each other rather than about the length of the list. The list also carries a
// key for every prelude module the unit lowers, so a claim about its length would be a
// claim about the prelude and would move whenever the prelude does.
test "the module list is first-seen, unique, and skips unattributed declarations" {
    let program = build_probe()
    let point_decl = assert_registered("types", cg_reg_type_decls(), "Point")
    let color_decl = assert_registered("types", cg_reg_type_decls(), "Color")
    let helper_decl = assert_registered("fns", cg_reg_fn_decls(), "helper")
    let main_decl = assert_registered("fns", cg_reg_fn_decls(), "main")
    // The front end stamps a probe's own declarations with the main-module key. Naming
    // the key is the point: cg_reg_module_of passes a plain declaration's key straight
    // through, so comparing it to node_source_module would compare a reader to itself.
    assert_eq_str("the key the front end stamped", cg_reg_module_of(point_decl), "__main__")
    node_set_module(point_decl, "probe.alpha")
    node_set_module(color_decl, "probe.beta")
    node_set_module(helper_decl, "probe.alpha")
    node_set_module(main_decl, "")

    cg_reg_build(program)
    let mods = cg_reg_modules()
    assert_eq_int("the key two declarations share is listed once",
        cg_probe_key_count(mods, "probe.alpha"), 1)
    assert_eq_int("the second key is listed once", cg_probe_key_count(mods, "probe.beta"), 1)
    assert_eq_int("an unattributed declaration contributes no key", cg_probe_key_count(mods, ""), 0)
    assert(cg_probe_key_index(mods, "probe.alpha") < cg_probe_key_index(mods, "probe.beta"))
    assert_eq_str("Point's module", cg_reg_module_of(point_decl), "probe.alpha")
    assert_eq_str("helper's module", cg_reg_module_of(helper_decl), "probe.alpha")
    assert_eq_str("main is unattributed", cg_reg_module_of(main_decl), "")
}

// A reset empties every registry, so a second compilation in one process never sees the
// first one's declarations.
test "cg_reg_reset empties every registry" {
    let _program = build_probe()
    assert(cg_reg_type_decls().len() > 0)
    cg_reg_reset()
    assert_eq_int("types", cg_reg_type_decls().len(), 0)
    assert_eq_int("fns", cg_reg_fn_decls().len(), 0)
    assert_eq_int("effects", cg_reg_effect_decls().len(), 0)
    assert_eq_int("globals", cg_reg_global_decls().len(), 0)
    assert_eq_int("traits", cg_reg_trait_decls().len(), 0)
    assert_eq_int("impls", cg_reg_impl_decls().len(), 0)
    assert_eq_int("tests", cg_reg_test_decls().len(), 0)
    assert_eq_int("modules", cg_reg_modules().len(), 0)
    assert_eq_int("no main", if cg_reg_has_main() { 1 } else { 0 }, 0)
}
