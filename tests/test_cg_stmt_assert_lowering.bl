import std.fs
import std.io
import typecheck.{check_types, TYPE_INT}
import layout.{layout_reset}
import mono.{run_mono}
import ir.{ir_dump, ir_reset, ir_verify}
import parser.{nodes, node_kind, node_name, node_body}
import ast.{NodeKind}
import compiler.{compile_to_program}
import diagnostics.{diag_entries, diag_reset}
import cg_stmt.{cg_stmt_reset, cg_stmt_set_debug_mode, lower_fn}

fn find_fn(name: Str) -> Int {
    let mut i = 0
    while i < nodes.len() {
        if node_kind(i) == NodeKind.FnDef && node_name(i) == name { return i }
        i = i + 1
    }
    -1
}

// The nested compile resolves the prelude from BLINK_ROOT; the harness runs from the
// repo root, so the cwd is that root.
fn run_probe(path: Str, src: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS.Delete {
    env.set_var("BLINK_ROOT", env.cwd())
    ir_reset()
    layout_reset()
    cg_stmt_reset()
    diag_reset()
    write_file(path, src)
    let program = compile_to_program(path, 1)
    check_types(program)
    run_mono(program)
    let _ = fs.delete(path)
}

fn dump_of(name: Str) -> Str ! Diag.Report {
    let f = find_fn(name)
    assert(f >= 0)
    let root = lower_fn(f)
    for err in ir_verify(root) { io.println("VERIFY: {err}") }
    assert_eq(ir_verify(root).len(), 0)
    ir_dump(root)
}

fn count_of(text: Str, needle: Str) -> Int {
    let mut n = 0
    let mut rest = text
    while rest.contains(needle) {
        n = n + 1
        rest = rest.slice(rest.index_of(needle) + needle.len(), rest.len())
    }
    n
}

// How many internal errors carry this diagnostic name.
fn ice_mentioning(text: Str) -> Int {
    let mut n = 0
    for d in diag_entries {
        if d.severity == "ice" && d.name == text { n = n + 1 }
    }
    n
}

test "assert on a non-decomposable condition lowers to one guarded fail call" {
    run_probe("build/cg_stmt_assert_plain.bl", #"fn probe(x: Bool) {
    assert(x)
}
fn main() { probe(true) }
"#)
    let text = dump_of("probe")
    assert_eq(count_of(text, "(If "), 1)
    assert_eq(count_of(text, "__blink_assert_fail_intro"), 1)
}

test "assert on a comparison decomposes both sides into bound temps" {
    run_probe("build/cg_stmt_assert_decompose.bl", #"fn probe(x: Int) {
    assert(x > 2)
}
fn main() { probe(3) }
"#)
    let text = dump_of("probe")
    // Once on the Let that binds the temp, once on the first VarRef that reads it; a
    // shared node past that first read prints only as a back-reference to the same id.
    assert_eq(count_of(text, "\"_cg_pa_l"), 2)
    assert_eq(count_of(text, "\"_cg_pa_r"), 2)
    assert_eq(count_of(text, "__blink_assert_fail_intro"), 1)
}

test "assert_eq on integers casts both sides into the shared default bucket" {
    run_probe("build/cg_stmt_assert_eq_int.bl", #"fn probe(a: Int, b: Int) {
    assert_eq(a, b)
}
fn main() { probe(1, 1) }
"#)
    let text = dump_of("probe")
    // Once on the Let that binds the temp, once on the first VarRef that reads it.
    assert_eq(count_of(text, "\"_cg_left"), 2)
    assert_eq(count_of(text, "\"_cg_right"), 2)
    assert_eq(count_of(text, "__blink_assert_fail_eq"), 1)
}

test "assert_eq on strings compares with the runtime string equality helper" {
    run_probe("build/cg_stmt_assert_eq_str.bl", #"fn probe(a: Str, b: Str) {
    assert_eq(a, b)
}
fn main() { probe("a", "b") }
"#)
    let text = dump_of("probe")
    assert_eq(count_of(text, "blink_str_eq"), 1)
    assert_eq(count_of(text, "__blink_assert_fail_eq"), 1)
}

test "assert_ne calls the plain fail path with no expected/actual split" {
    run_probe("build/cg_stmt_assert_ne.bl", #"fn probe(a: Int, b: Int) {
    assert_ne(a, b)
}
fn main() { probe(1, 2) }
"#)
    let text = dump_of("probe")
    assert_eq(count_of(text, "__blink_assert_fail_eq"), 0)
    assert_eq(count_of(text, "\"__blink_assert_fail\""), 1)
}

test "assert_eq over a struct refuses by name instead of guessing a comparison" {
    run_probe("build/cg_stmt_assert_eq_struct.bl", #"type Point { x: Int, y: Int }
fn probe(a: Point, b: Point) {
    assert_eq(a, b)
}
fn main() { probe(Point { x: 1, y: 2 }, Point { x: 1, y: 2 }) }
"#)
    let f = find_fn("probe")
    assert(f >= 0)
    let _ = lower_fn(f)
    assert(ice_mentioning("AssertCompareAggregateNotBuilt") > 0)
}

test "debug_assert lowers to nothing when the debug build flag is off" {
    cg_stmt_set_debug_mode(false)
    run_probe("build/cg_stmt_debug_assert_off.bl", #"fn probe(x: Int) {
    debug_assert(x == 1)
}
fn main() { probe(1) }
"#)
    let text = dump_of("probe")
    assert_eq(count_of(text, "__blink_debug_assert_fail"), 0)
}

test "debug_assert lowers to a guarded fail call when the debug build flag is on" {
    cg_stmt_set_debug_mode(true)
    run_probe("build/cg_stmt_debug_assert_on.bl", #"fn probe(x: Int) {
    debug_assert(x == 1)
}
fn main() { probe(1) }
"#)
    let text = dump_of("probe")
    cg_stmt_set_debug_mode(false)
    assert_eq(count_of(text, "__blink_debug_assert_fail"), 1)
}
