test "assert_eq over an Option refuses by name instead of guessing a comparison" {
    run_probe("build/cg_stmt_assert_eq_option.bl", #"fn probe(a: Option[Int], b: Option[Int]) {
    assert_eq(a, b)
}
fn main() { probe(Some(1), Some(1)) }
"#)
    let f = find_fn("probe")
