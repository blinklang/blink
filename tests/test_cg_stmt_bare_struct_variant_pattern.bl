// A struct-style variant matched WITHOUT its type qualifier (`NotFound { msg }`, not
// `QueryError.NotFound { msg }`) parses as a StructPattern — the parser has no type
// info at parse time to tell a real struct pattern from a bare variant one, so both
// spellings share one node kind. The field read must still go through the variant's
// union member (`scrutinee.data.NotFound.msg`), the same place the qualified spelling
// reads it from; reading the scrutinee's own struct fields directly fails the C
// compile, since the enum's C shape has no such members at the top level. This proves
// itself by compiling and running, not by inspecting IR: a wrong prefix is a C error,
// not a wrong value.
type QueryError {
    NotFound { msg: Str }
    Timeout { seconds: Int }
}

fn describe(e: QueryError) -> Str {
    match e {
        NotFound { msg } => "not found: {msg}"
        Timeout { seconds } => "timeout {seconds}"
    }
}

// A single-field struct-style variant is not enough on its own to prove the prefix is
// per-variant rather than some other coincidentally-correct address, so a second
// variant with a differently named field sits alongside it.
test "bare struct-style variant pattern reads its field through the variant's union member" {
    assert_eq(describe(NotFound { msg: "ann" }), "not found: ann")
    assert_eq(describe(Timeout { seconds: 30 }), "timeout 30")
}
