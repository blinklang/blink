import std.fs
import std.io
import typecheck.{check_types, TYPE_INT}
import layout.{layout_reset}
import mono.{run_mono}
import ir.{ir_dump, ir_reset, ir_verify}
import parser.{nodes, node_kind, node_name, node_body}
import ast.{NodeKind}
import compiler.{compile_to_program}
import diagnostics.{diag_entries, diag_reset}
import cg_stmt.{cg_stmt_reset, lower_fn, lower_block_into}
import cname.{c_mint_local}

fn find_fn(name: Str) -> Int {
    let mut i = 0
    while i < nodes.len() {
        if node_kind(i) == NodeKind.FnDef && node_name(i) == name { return i }
        i = i + 1
    }
    -1
}

fn run_probe(path: Str, src: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS.Delete {
    ir_reset()
    layout_reset()
    cg_stmt_reset()
    diag_reset()
    write_file(path, src)
    let program = compile_to_program(path, 1)
    check_types(program)
    run_mono(program)
    let _ = fs.delete(path)
}

// Lowers one named function of the probe and answers its dump. The expression stage is
// not built yet, so every value in the tree is a placeholder; the statement shape around
// those placeholders is what these tests read.
fn dump_of(name: Str) -> Str ! Diag.Report {
    let f = find_fn(name)
    assert(f >= 0)
    let root = lower_fn(f)
    for err in ir_verify(root) { io.println("VERIFY: {err}") }
    assert_eq(ir_verify(root).len(), 0)
    ir_dump(root)
}

fn count_of(text: Str, needle: Str) -> Int {
    let mut n = 0
    let mut rest = text
    while rest.contains(needle) {
        n = n + 1
        rest = rest.slice(rest.index_of(needle) + needle.len(), rest.len())
    }
    n
}

// How many internal errors mention this text. A count of every ICE would be dominated by
// the unbuilt expression stage, which reports once per value.
fn ice_mentioning(text: Str) -> Int {
    let mut n = 0
    for d in diag_entries {
        if d.severity == "ice" && d.message.contains(text) { n = n + 1 }
    }
    n
}

// This must run before any test that typechecks: the node-to-type table is presized only
// by check_types and survives between tests, so a later unstamped parse would read the
// stale stamps of an earlier one instead of finding nothing.
test "a body whose types were never recorded is an internal error" {
    ir_reset()
    layout_reset()
    cg_stmt_reset()
    diag_reset()
    write_file("build/cg_stmt_unstamped.bl", #"fn probe() -> Int {
    let a = 1
    a
}
fn main() { assert(probe() == 1) }
"#)
    let _program = compile_to_program("build/cg_stmt_unstamped.bl", 1)
    let _ = fs.delete("build/cg_stmt_unstamped.bl")
    let f = find_fn("probe")
    assert(f >= 0)
    let _ = lower_fn(f)
    assert(ice_mentioning("no recorded type") > 0)
}

test "a let binding lowers to one Let under the binder's own C name" {
    run_probe("build/cg_stmt_let.bl", #"fn probe() -> Int {
    let a = 1
    let b: Int = 2
    a + b
}
fn main() { assert(probe() == 3) }
"#)
    let d = dump_of("probe")
    assert_eq(count_of(d, "(Let "), 2)
    assert(d.contains("\"a\""))
    assert(d.contains("\"b\""))
    assert(d.contains("(Return "))
}

test "a tuple destructuring let binds every element from one holder" {
    run_probe("build/cg_stmt_destructure.bl", #"fn probe() -> Int {
    let (x, y) = (1, 2)
    x + y
}
fn main() { assert(probe() == 3) }
"#)
    let d = dump_of("probe")
    assert_eq(count_of(d, "(Let "), 3)
    assert_eq(count_of(d, "(FieldGet "), 2)
    assert(d.contains("\"_0\""))
    assert(d.contains("\"_1\""))
}

test "an if in tail position returns from inside both arms" {
    run_probe("build/cg_stmt_if_tail.bl", #"fn probe(n: Int) -> Int {
    if n > 0 { 1 } else { 2 }
}
fn main() { assert(probe(1) == 1) }
"#)
    let d = dump_of("probe")
    assert_eq(count_of(d, "(If "), 1)
    assert_eq(count_of(d, "(Return "), 2)
}

test "a while loop breaks on the negated condition before its body" {
    run_probe("build/cg_stmt_while.bl", #"fn probe() -> Int {
    let mut i = 0
    while i < 3 { i = i + 1 }
    i
}
fn main() { assert(probe() == 3) }
"#)
    let d = dump_of("probe")
    assert_eq(count_of(d, "(Loop "), 1)
    assert_eq(count_of(d, "(Break "), 1)
    assert(d.contains("\"==\""))
}

test "a counted for-in lowers to an init, a break guard, the body and a step" {
    run_probe("build/cg_stmt_for_range.bl", #"fn probe() -> Int {
    let mut total = 0
    for i in 0..3 { total = total + i }
    total
}
fn main() { assert(probe() == 3) }
"#)
    let d = dump_of("probe")
    assert_eq(count_of(d, "(Loop "), 1)
    assert_eq(count_of(d, "(Break "), 1)
    assert(d.contains("\">=\""))
    assert(d.contains("\"+\""))
}

test "an unguarded enum match lowers to a switch over the discriminant" {
    run_probe("build/cg_stmt_match_enum.bl", #"type Color { Red, Green, Blue }
fn probe(c: Color) -> Int {
    match c {
        Color.Red => 1
        Color.Green => 2
        _ => 3
    }
}
fn main() { assert(probe(Color.Red) == 1) }
"#)
    let d = dump_of("probe")
    assert_eq(count_of(d, "(Switch "), 1)
    // A payload-less enum is a plain C enum, one machine word with no tag member beside
    // it, so the switch tests the scrutinee directly rather than reading a `.tag` member
    // off a value that has none.
    assert_eq(count_of(d, "(CarrierTag "), 0)
    assert(d.contains("_Red"))
    assert(d.contains("_Green"))
    assert(!d.contains("_Red_TAG"))
    assert(!d.contains("_Green_TAG"))
}

test "an Option match binds its payload through the carrier member" {
    run_probe("build/cg_stmt_match_option.bl", #"fn probe(o: Option[Int]) -> Int {
    match o {
        Some(v) => v
        None => 0
    }
}
fn main() { assert(probe(Some(4)) == 4) }
"#)
    let d = dump_of("probe")
    assert_eq(count_of(d, "(Switch "), 1)
    assert_eq(count_of(d, "(CarrierUnwrap "), 1)
    assert(d.contains("\"value\""))
}

test "an Option match over a boxed struct payload unboxes the carrier member" {
    // Pt3 is three Ints wide, so it does not fit the one word an Option's carrier member
    // holds inline: the typedef stores `Pt3* value`, by the same rule as a scalar Option's
    // `int64_t value`, just on the pointer branch instead of the inline one. The binder is
    // still declared at Pt3 by value, so reading the member straight into it is the exact
    // pointer/value mismatch seen when a match binder reads a boxed carrier member.
    run_probe("build/cg_stmt_match_option_boxed.bl", #"type Pt3 { x: Int, y: Int, z: Int }
fn probe(o: Option[Pt3]) -> Int {
    match o {
        Some(p) => p.x + p.y + p.z
        None => 0
    }
}
fn main() { assert(probe(Some(Pt3 { x: 1, y: 2, z: 3 })) == 6) }
"#)
    let d = dump_of("probe")
    assert_eq(count_of(d, "(Switch "), 1)
    assert_eq(count_of(d, "(CarrierUnwrap "), 1)
    // The member is boxed, so the binder's Let has to read it through an Unbox: a bare
    // CarrierUnwrap with no Unbox around it is exactly the shape that hands a pointer to a
    // by-value Let and fails C compilation with "invalid initializer".
    assert_eq(count_of(d, "(Unbox "), 1)
}

test "a guarded match arm lowers to a flag-gated chain, not a switch" {
    run_probe("build/cg_stmt_match_guard.bl", #"fn probe(n: Int) -> Int {
    match n {
        x if x > 5 => 1
        _ => 2
    }
}
fn main() { assert(probe(9) == 1) }
"#)
    let d = dump_of("probe")
    assert_eq(count_of(d, "(Switch "), 0)
    assert_eq(count_of(d, "(Unreachable "), 1)
    // Three arms of the chain plus the guard nested inside the first of them. A guard
    // tested in the chain condition instead would leave three.
    assert_eq(count_of(d, "(If "), 4)
}

test "a with arena block lowers to a scope that carries no resource" {
    run_probe("build/cg_stmt_with_arena.bl", #"fn probe() -> Int {
    with arena {
        let xs = [1, 2]
        xs.len()
    }
}
fn main() { assert(probe() == 2) }
"#)
    let d = dump_of("probe")
    assert_eq(count_of(d, "(WithScope "), 1)
}

test "a for-in over a list lowers to a loop, not an internal error" {
    run_probe("build/cg_stmt_for_list.bl", #"fn probe() -> Int {
    let mut total = 0
    for x in [1, 2] { total = total + x }
    total
}
fn main() { assert(probe() == 3) }
"#)
    let d = dump_of("probe")
    assert_eq(count_of(d, "(Loop "), 1)
    assert_eq(ice_mentioning("for-in over this iterable"), 0)
}

test "a match on a string lowers to a str_eq call, not a switch" {
    run_probe("build/cg_stmt_match_str.bl", #"fn probe(s: Str) -> Int {
    match s {
        "a" => 1
        _ => 0
    }
}
fn main() { assert(probe("a") == 1) }
"#)
    let d = dump_of("probe")
    assert_eq(count_of(d, "(Switch "), 0)
    assert_eq(count_of(d, "(CallRuntime "), 1)
    assert(d.contains("blink_str_eq"))
    assert_eq(ice_mentioning("a match on this pattern shape"), 0)
}

test "a for-in range steps at the top of the loop so continue cannot skip the step" {
    run_probe("build/cg_stmt_for_range_continue.bl", #"fn probe() -> Int {
    let mut total = 0
    for i in 0..5 {
        if i == 2 { continue }
        total = total + i
    }
    total
}
fn main() { assert(probe() == 8) }
"#)
    let d = dump_of("probe")
    assert(d.index_of("\"+\"") < d.index_of("(Break "))
    assert_eq(count_of(d, "(Continue "), 1)
}

test "a for-in range hoists its end and carries a first-iteration flag" {
    run_probe("build/cg_stmt_for_range_hoist.bl", #"fn probe() -> Int {
    let mut n = 0
    for i in 0..3 { n = n + 1 }
    n
}
fn main() { assert(probe() == 3) }
"#)
    let d = dump_of("probe")
    assert_eq(count_of(d, "(Let "), 4)
    assert(d.contains("_cg_end"))
    assert(d.contains("_cg_first"))
}

test "an inclusive for-in range breaks on a strict greater-than" {
    run_probe("build/cg_stmt_for_range_inclusive.bl", #"fn probe() -> Int {
    let mut n = 0
    for i in 0..=3 { n = n + 1 }
    n
}
fn main() { assert(probe() == 4) }
"#)
    let d = dump_of("probe")
    assert(d.contains("\">\""))
    assert_eq(count_of(d, "\">=\""), 0)
}

test "a two-item with block nests each scope inside a block the verifier accepts" {
    run_probe("build/cg_stmt_with_two_items.bl", #"fn probe() -> Int {
    let mut n = 0
    with arena, arena { n = 1 }
    n
}
fn main() { assert(probe() == 1) }
"#)
    let d = dump_of("probe")
    assert_eq(count_of(d, "(WithScope "), 2)
}

test "a void function discards its tail value rather than returning it" {
    run_probe("build/cg_stmt_void_tail.bl", #"fn probe() {
    let n = 1
    n + 1
}
fn main() { probe() }
"#)
    let d = dump_of("probe")
    assert_eq(count_of(d, "(Return "), 0)
}

test "an exhaustive enum match needs no unreachable default arm" {
    run_probe("build/cg_stmt_match_exhaustive.bl", #"type Color { Red, Green, Blue }
fn probe(c: Color) -> Int {
    match c {
        Color.Red => 1
        Color.Green => 2
        Color.Blue => 3
    }
}
fn main() { assert(probe(Color.Red) == 1) }
"#)
    let d = dump_of("probe")
    assert_eq(ice_mentioning("guaranteed to run"), 0)
    assert_eq(count_of(d, "(Switch "), 1)
    assert_eq(count_of(d, "(Unreachable "), 0)
}

test "a match that leaves a variant unnamed is an internal error" {
    run_probe("build/cg_stmt_match_partial.bl", #"type Color { Red, Green, Blue }
fn probe(c: Color) -> Int {
    match c {
        Color.Red => 1
        Color.Green => 2
    }
}
fn main() { assert(probe(Color.Red) == 1) }
"#)
    let _ = dump_of("probe")
    assert(ice_mentioning("guaranteed to run") > 0)
}

test "a match over a generic enum instance counts the variants of its declaration" {
    run_probe("build/cg_stmt_match_generic_enum.bl", #"type Box[T] { Full(T), Empty }
fn probe(b: Box[Int]) -> Int {
    match b {
        Box.Full(v) => v
        Box.Empty => 0
    }
}
fn main() { assert(probe(Box.Empty) == 0) }
"#)
    let _ = dump_of("probe")
    assert_eq(ice_mentioning("guaranteed to run"), 0)
}

test "a variant named inside a variant payload is an internal error, not a bare tag test" {
    run_probe("build/cg_stmt_match_nested_variant.bl", #"fn probe(r: Result[Option[Int], Str]) -> Int {
    match r {
        Ok(None) => 0
        _ => 1
    }
}
fn main() { assert(probe(Ok(None)) == 0) }
"#)
    let d = dump_of("probe")
    assert(ice_mentioning("a match on this pattern shape") > 0)
    // A bare tag test here would run arm one for every Ok, whatever it holds.
    assert_eq(count_of(d, "(Switch "), 0)
}

test "a function that declares Void discards its tail" {
    run_probe("build/cg_stmt_void_annotation.bl", #"fn probe() -> Void {
    let x = 1
    assert(x == 1)
}
fn main() { probe() }
"#)
    let d = dump_of("probe")
    assert_eq(count_of(d, "(Return "), 0)
    assert_eq(ice_mentioning("return annotation"), 0)
}

test "an assignment to a field lowers through the field reader as its lvalue" {
    run_probe("build/cg_stmt_assign_field.bl", #"type Pt { x: Int, y: Int }
fn probe() -> Int {
    let mut p = Pt { x: 1, y: 2 }
    p.x = 5
    p.x
}
fn main() { assert(probe() == 5) }
"#)
    let d = dump_of("probe")
    assert_eq(ice_mentioning("an assignment to a place that is not a local"), 0)
    assert_eq(count_of(d, "(Assign "), 1)
    assert(d.contains("FieldGet"))
}

test "a compound assignment to a module-level global lowers through the global reader as its lvalue" {
    run_probe("build/cg_stmt_compound_assign_global.bl", #"let mut counter: Int = 0
fn probe() -> Int {
    counter += 1
    counter
}
fn main() { assert(probe() == 1) }
"#)
    let d = dump_of("probe")
    assert_eq(ice_mentioning("an assignment to a place that is not a local"), 0)
    assert_eq(count_of(d, "(Assign "), 1)
    assert(d.contains("GlobalRef"))
}

test "an assignment to a module-level global lowers through the global reader as its lvalue" {
    run_probe("build/cg_stmt_assign_global.bl", #"let mut counter: Int = 0
fn probe() -> Int {
    counter = counter + 1
    counter
}
fn main() { assert(probe() == 1) }
"#)
    let d = dump_of("probe")
    assert_eq(ice_mentioning("an assignment to a place that is not a local"), 0)
    assert_eq(count_of(d, "(Assign "), 1)
    assert(d.contains("GlobalRef"))
}

test "a block lowered into a destination assigns its tail rather than returning it" {
    run_probe("build/cg_stmt_block_into_dest.bl", #"fn probe(n: Int) -> Int {
    let d = n + 1
    d
}
fn main() { assert(probe(1) == 2) }
"#)
    let f = find_fn("probe")
    assert(f >= 0)
    let root = lower_block_into(node_body(f), "_cg_dest", TYPE_INT)
    assert_eq(ir_verify(root).len(), 0)
    let d = ir_dump(root)
    assert_eq(count_of(d, "(Return "), 0)
    assert_eq(count_of(d, "(Assign "), 1)
    assert(d.contains("_cg_dest"))
}

test "a refutable tuple pattern is tested rather than taken as a catch-all" {
    run_probe("build/cg_stmt_tuple_pattern_refutable.bl", #"fn probe(p: (Int, Int)) -> Int {
    match p {
        (1, y) => y
        (x, _) => x
    }
}
fn main() { assert(probe((1, 7)) == 7) }
"#)
    let d = dump_of("probe")
    assert(d.contains("\"&&\""))
    // The test itself is the poisoned one a nested-pattern shape reports, not a real
    // comparison: what this proves is that the arm is gated at all.
    assert(ice_mentioning("a match on this pattern shape") > 0)
}

test "a with-resource over a type with no cleanup protocol is a plain bind with no guard" {
    run_probe("build/cg_stmt_with_resource.bl", #"type Res { id: Int }
fn make() -> Res { Res { id: 1 } }
fn probe() -> Int {
    with make() as r { r.id }
}
fn main() { assert(probe() == 1) }
"#)
    let d = dump_of("probe")
    assert_eq(ice_mentioning("with-resource cleanup"), 0)
    assert(count_of(d, "(Let ") > 0)
    assert_eq(count_of(d, "(WithScope "), 0)
}

test "an effect handler install lowers to a HandlerInstall over its vtable field" {
    run_probe("build/cg_stmt_handler_install.bl", #"effect Beep { fn beep() -> Int }
fn probe() -> Int {
    with handler Beep { fn beep() -> Int { 1 } } { 2 }
}
fn main() { assert(probe() == 2) }
"#)
    let d = dump_of("probe")
    assert_eq(ice_mentioning("effect vtable field"), 0)
    assert_eq(count_of(d, "(HandlerInstall "), 1)
    assert(d.contains("\"ue_beep\""))
}

test "a struct pattern of shorthand fields matches anything" {
    run_probe("build/cg_stmt_struct_shorthand.bl", #"type Pt { x: Int, y: Int }
fn probe(p: Pt) -> Int {
    match p { Pt { x, y } => x + y }
}
fn main() { assert(probe(Pt { x: 1, y: 2 }) == 3) }
"#)
    let d = dump_of("probe")
    assert_eq(ice_mentioning("guaranteed to run"), 0)
    assert_eq(ice_mentioning("a match on this pattern shape"), 0)
    assert_eq(ice_mentioning("a nested pattern"), 0)
    // A struct holds no discriminant, so neither a tag read nor a switch belongs here.
    assert_eq(count_of(d, "(CarrierTag "), 0)
    assert_eq(count_of(d, "(Switch "), 0)
}

test "a match over both booleans is covered" {
    run_probe("build/cg_stmt_match_bool.bl", #"fn probe(b: Bool) -> Int {
    match b { true => 1  false => 0 }
}
fn main() { assert(probe(true) == 1) }
"#)
    let _ = dump_of("probe")
    assert_eq(ice_mentioning("guaranteed to run"), 0)
}

test "an or-pattern arm covers every variant it names" {
    run_probe("build/cg_stmt_match_or_cover.bl", #"type Color { Red, Green, Blue }
fn probe(c: Color) -> Int {
    match c {
        Color.Red | Color.Green => 1
        Color.Blue => 2
    }
}
fn main() { assert(probe(Color.Blue) == 2) }
"#)
    let _ = dump_of("probe")
    assert_eq(ice_mentioning("guaranteed to run"), 0)
}

test "a local this stage mints is never handed out again by the shared minter" {
    run_probe("build/cg_stmt_shared_minter.bl", #"fn probe() -> Int {
    let (a, b) = (1, 2)
    a + b
}
fn main() { assert(probe() == 3) }
"#)
    let d = dump_of("probe")
    // Two counters would hand this stage and the expression stage the same identifier for
    // two different values. Every name minted while lowering must already be spent, so
    // the next one the shared minter answers cannot be one the tree already uses.
    let next = c_mint_local("tup")
    assert(d.contains("_cg_tup"))
    assert(!d.contains(next))
}
