// The match coverage proof over two shapes it used to give up on: list patterns whose
// lengths jointly cover every list, and tuple arms where some arms refute at more than
// one position while the rest cover one shared position. Each negative row is a shape
// that really leaves a value unmatched, so its lowering must panic when no arm runs.

import std.fs
import std.io
import typecheck.{check_types}
import layout.{layout_reset}
import mono.{run_mono}
import ir.{ir_dump, ir_reset, ir_verify}
import parser.{nodes, node_kind, node_name}
import ast.{NodeKind}
import compiler.{compile_to_program}
import diagnostics.{diag_entries, diag_reset}
import cg_stmt.{cg_stmt_reset, lower_fn}

fn find_fn(name: Str) -> Int {
    let mut i = 0
    while i < nodes.len() {
        if node_kind(i) == NodeKind.FnDef && node_name(i) == name { return i }
        i = i + 1
    }
    -1
}

fn run_probe(path: Str, src: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS.Delete {
    ir_reset()
    layout_reset()
    cg_stmt_reset()
    diag_reset()
    write_file(path, src)
    let program = compile_to_program(path, 1)
    check_types(program)
    run_mono(program)
    let _ = fs.delete(path)
}

fn dump_of(name: Str) -> Str ! Diag.Report {
    let f = find_fn(name)
    assert(f >= 0)
    let root = lower_fn(f)
    for err in ir_verify(root) { io.println("VERIFY: {err}") }
    assert_eq(ir_verify(root).len(), 0)
    ir_dump(root)
}

fn count_of(text: Str, needle: Str) -> Int {
    let mut n = 0
    let mut rest = text
    while rest.contains(needle) {
        n = n + 1
        rest = rest.slice(rest.index_of(needle) + needle.len(), rest.len())
    }
    n
}

// A switch and a chain of ifs each prove cover their own way, and neither way counts for
// the other: a covered switch has no default that panics, and a covered chain ends in an
// unreachable tail.
fn lowered_as_covered(d: Str) -> Bool {
    let panics = count_of(d, "non-exhaustive match")
    let unreachables = count_of(d, "(Unreachable ")
    if count_of(d, "(Switch ") > 0 { return panics == 0 && unreachables == 0 }
    panics == 0 && unreachables == 1
}

// The path where no arm ran panics, and nothing claims that path cannot run.
fn lowered_as_uncovered(d: Str) -> Bool {
    count_of(d, "non-exhaustive match") == 1 && count_of(d, "(Unreachable ") == 0
}

fn ice_count() -> Int {
    let mut n = 0
    for d in diag_entries {
        if d.severity == "ice" { n = n + 1 }
    }
    n
}

// Lowers `probe` from a program whose only function besides main is `body`, and answers
// its dump.
fn lowered_probe(path: Str, body: Str) -> Str ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS.Delete {
    run_probe(path, "{body}\nfn main() \{ \}\n")
    let d = dump_of("probe")
    assert_eq(ice_count(), 0)
    d
}

test "an empty arm and a rest arm of one element cover every list" {
    assert(lowered_as_covered(lowered_probe("build/cg_cov_list_empty_rest.bl", #"fn probe(xs: List[Int]) -> Int {
    match xs {
        [] => 0
        [first, ...] => first
    }
}"#)))
}

test "exact arms for every length below the shortest rest arm cover every list" {
    assert(lowered_as_covered(lowered_probe("build/cg_cov_list_exact_then_rest.bl", #"fn probe(xs: List[Int]) -> Int {
    match xs {
        [] => 0
        [a] => a
        [a, b, ...] => a + b
    }
}"#)))
}

test "a binder named with as inside a rest arm still counts toward the lengths" {
    assert(lowered_as_covered(lowered_probe("build/cg_cov_list_as_binder.bl", #"fn probe(xs: List[Int]) -> Int {
    match xs {
        [] => 0
        [a as whole, ...] => whole
    }
}"#)))
}

test "a list match with no arm for the empty list panics when no arm runs" {
    assert(lowered_as_uncovered(lowered_probe("build/cg_cov_list_no_empty.bl", #"fn probe(xs: List[Int]) -> Int {
    match xs {
        [x] => x
        [x, y, ...] => x + y
    }
}"#)))
}

test "a list match with no arm for length one panics when no arm runs" {
    assert(lowered_as_uncovered(lowered_probe("build/cg_cov_list_no_one.bl", #"fn probe(xs: List[Int]) -> Int {
    match xs {
        [] => 0
        [x, y, ...] => x + y
    }
}"#)))
}

test "a rest arm whose element can refuse proves nothing about lengths" {
    assert(lowered_as_uncovered(lowered_probe("build/cg_cov_list_refuting_int.bl", #"fn probe(xs: List[Int]) -> Int {
    match xs {
        [] => 0
        [1, ...] => 1
    }
}"#)))
    assert(lowered_as_uncovered(lowered_probe("build/cg_cov_list_refuting_str.bl", #"fn probe(xs: List[Str]) -> Int {
    match xs {
        [] => 0
        ["a", ...] => 1
    }
}"#)))
}

test "arms that refute at one shared position cover it even beside an arm that refutes at two" {
    assert(lowered_as_covered(lowered_probe("build/cg_cov_tuple_option_shared.bl", #"fn probe(t: (Option[Int], Int)) -> Int {
    match t {
        (Some(v), 1) => v
        (Some(v), _) => v + 1
        (None, _) => 0
    }
}"#)))
    assert(lowered_as_covered(lowered_probe("build/cg_cov_tuple_result_shared.bl", #"fn probe(t: (Result[Int, Str], Int)) -> Int {
    match t {
        (Ok(x), 0) => x
        (Ok(x), _) => x + 1
        (Err(e), _) => 0
    }
}"#)))
}

test "an arm that refutes at two positions does not help cover the shared one" {
    assert(lowered_as_uncovered(lowered_probe("build/cg_cov_tuple_two_refutes.bl", #"fn probe(t: (Option[Int], Int)) -> Int {
    match t {
        (Some(v), 1) => v
        (None, _) => 0
    }
}"#)))
}

test "a variant whose payload can refuse does not name the variant as covered" {
    assert(lowered_as_uncovered(lowered_probe("build/cg_cov_tuple_refuting_payload.bl", #"fn probe(t: (Option[Int], Int)) -> Int {
    match t {
        (Some(1), _) => 1
        (None, _) => 0
    }
}"#)))
}
