// `match` on a Str scrutinee against string-literal patterns. C cannot switch on a string,
// so each arm's test is a runtime string-equality call rather than the integer label a
// match on an ordinal or a tagged value gets; this proves the arms pick the right one by
// running.

fn day_kind(name: Str) -> Str {
    match name {
        "sat" => "weekend"
        "sun" => "weekend"
        _ => "weekday"
    }
}

fn day_kind_or(name: Str) -> Str {
    match name {
        "sat" | "sun" => "weekend"
        _ => "weekday"
    }
}

fn greet(who: Str) -> Str {
    match who {
        "" => "who's there?"
        other => "hello, {other}"
    }
}

test "a string pattern picks its own arm" {
    assert_eq(day_kind("sat"), "weekend")
    assert_eq(day_kind("sun"), "weekend")
}

test "a string pattern falls through to the wildcard on no match" {
    assert_eq(day_kind("mon"), "weekday")
}

test "an or-pattern of string literals matches either side" {
    assert_eq(day_kind_or("sat"), "weekend")
    assert_eq(day_kind_or("sun"), "weekend")
    assert_eq(day_kind_or("tue"), "weekday")
}

test "a string pattern is compared by content, not by address" {
    let built = "sa".concat("t")
    assert_eq(day_kind(built), "weekend")
}

test "an ident arm after a string pattern still binds the scrutinee" {
    assert_eq(greet(""), "who's there?")
    assert_eq(greet("nick"), "hello, nick")
}
