// A variant with NAMED payload fields (`Circle(radius: Float)`) matched positionally
// (`Circle(r) => ...`) must read the field the declaration named, not `_0`/`_1`. A wrong
// spelling fails the C compile, not typecheck, so this proves itself by running.
type Shape {
    Circle(radius: Float)
    Rectangle(width: Float, height: Float)
}

// A POSITIONAL declaration's synthesized field names must keep matching positionally.
type Wrapper {
    Boxed(Float)
}

fn radius_of(s: Shape) -> Float {
    match s {
        Shape.Circle(r) => r
        Shape.Rectangle(_, _) => 0.0
    }
}

fn area_of(s: Shape) -> Float {
    match s {
        Shape.Circle(_) => 0.0
        Shape.Rectangle(w, h) => w * h
    }
}

fn unboxed(w: Wrapper) -> Float {
    match w {
        Wrapper.Boxed(v) => v
    }
}

test "single named payload field matched positionally reads the declared member" {
    assert_eq(radius_of(Shape.Circle(2.0)), 2.0)
}

test "multiple named payload fields matched positionally read their declared members in order" {
    assert_eq(area_of(Shape.Rectangle(3.0, 4.0)), 12.0)
}

test "positional payload field matched positionally still works" {
    assert_eq(unboxed(Wrapper.Boxed(5.0)), 5.0)
}
