// A pattern nested inside a variant payload -- `Ok(Some(x))`, `Ok(None)`, and a
// struct-style sub-pattern inside a payload -- must both test and bind through the
// payload slot's own tid and layout, recursively, the same as a top-level scrutinee.
// This proves itself by compiling and running, not by inspecting IR: a wrong read
// through the wrong union member is a C error or a wrong value, not a diagnostic.

type Point {
    x: Int
    y: Int
}

fn classify(r: Result[Option[Int], Str]) -> Str {
    match r {
        Ok(Some(x)) => "some {x}"
        Ok(None) => "none"
        Err(e) => "err {e}"
    }
}

fn describe_point(r: Result[Point, Str]) -> Str {
    match r {
        Ok(Point { x, y }) => "point {x},{y}"
        Err(e) => "err {e}"
    }
}

test "nested variant pattern inside a payload binds and tests correctly" {
    assert_eq(classify(Ok(Some(7))), "some 7")
    assert_eq(classify(Ok(None)), "none")
    assert_eq(classify(Err("bad")), "err bad")
}

test "struct-style sub-pattern inside a payload reads through the variant's own member" {
    assert_eq(describe_point(Ok(Point { x: 1, y: 2 })), "point 1,2")
    assert_eq(describe_point(Err("nope")), "err nope")
}
