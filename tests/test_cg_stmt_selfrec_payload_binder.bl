// A self-recursive struct-style variant field (`Add { left: Expr, right: Expr }`, where
// `left`/`right` name the enclosing enum itself) is stored BOXED — the arm's own C
// typedef declares it as a bare pointer-sized word, not a full `Expr` by value, since a
// by-value field could not otherwise give the enum type a finite size. A match binder
// over that field must deref through the box, the same way construction filled it; the
// bound name has the arm's ordinary (unboxed) type, only the read that fills it differs.
type Expr {
    Lit(Int)
    Add { left: Expr, right: Expr }
}

fn depth(e: Expr) -> Int {
    match e {
        Lit(_) => 1
        Add { left, right } => {
            let l = depth(left)
            let r = depth(right)
            1 + (if l > r { l } else { r })
        }
    }
}

test "match binder over a boxed self-recursive struct-style variant field derefs the box" {
    let tree = Expr.Add {
        left: Expr.Lit(1),
        right: Expr.Add { left: Expr.Lit(2), right: Expr.Lit(3) },
    }
    assert_eq(depth(tree), 3)
}
