// A variant sub-pattern nested inside a tuple element -- `(Ok(inner), _)` -- must bind
// and test through that element's own tid, and the match's coverage proof must accept
// two arms that jointly exhaust the scrutinee by refuting at the same tuple position
// even though no single arm's pattern is one flat label. Probe over the lowered IR, for
// the same reason as tests/test_cg_stmt_nested_variant_payload_pattern.bl: build/gen0
// cannot itself compile this shape to C yet. The run-it, end-to-end version lives in
// tests/test_nested_variant_payload_patterns_run.bl.

import std.fs
import std.io
import typecheck.{check_types}
import layout.{layout_reset}
import mono.{run_mono}
import ir.{ir_dump, ir_reset, ir_verify}
import parser.{nodes, node_kind, node_name}
import ast.{NodeKind}
import compiler.{compile_to_program}
import diagnostics.{diag_entries, diag_reset}
import cg_stmt.{cg_stmt_reset, lower_fn}

fn find_fn(name: Str) -> Int {
    let mut i = 0
    while i < nodes.len() {
        if node_kind(i) == NodeKind.FnDef && node_name(i) == name { return i }
        i = i + 1
    }
    -1
}

fn run_probe(path: Str, src: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS.Delete {
    ir_reset()
    layout_reset()
    cg_stmt_reset()
    diag_reset()
    write_file(path, src)
    let program = compile_to_program(path, 1)
    check_types(program)
    run_mono(program)
    let _ = fs.delete(path)
}

fn dump_of(name: Str) -> Str ! Diag.Report {
    let f = find_fn(name)
    assert(f >= 0)
    let root = lower_fn(f)
    for err in ir_verify(root) { io.println("VERIFY: {err}") }
    assert_eq(ir_verify(root).len(), 0)
    ir_dump(root)
}

fn ice_mentioning(text: Str) -> Int {
    let mut n = 0
    for d in diag_entries {
        if d.severity == "ice" && d.message.contains(text) { n = n + 1 }
    }
    n
}

fn count_of(text: Str, needle: Str) -> Int {
    let mut n = 0
    let mut rest = text
    while rest.contains(needle) {
        n = n + 1
        rest = rest.slice(rest.index_of(needle) + needle.len(), rest.len())
    }
    n
}

// A switch and a chain of ifs each prove cover their own way, and neither way counts for
// the other: a covered switch has no default that panics, and a covered chain ends in an
// unreachable tail.
fn lowered_as_covered(d: Str) -> Bool {
    let panics = count_of(d, "non-exhaustive match")
    let unreachables = count_of(d, "(Unreachable ")
    if count_of(d, "(Switch ") > 0 { return panics == 0 && unreachables == 0 }
    panics == 0 && unreachables == 1
}

// The path where no arm ran panics, and nothing claims that path cannot run.
fn lowered_as_uncovered(d: Str) -> Bool {
    count_of(d, "non-exhaustive match") == 1 && count_of(d, "(Unreachable ") == 0
}

fn ice_count() -> Int {
    let mut n = 0
    for d in diag_entries {
        if d.severity == "ice" { n = n + 1 }
    }
    n
}

test "a variant sub-pattern nested in a tuple element binds and the match is proven exhaustive" {
    run_probe("build/cg_stmt_tuple_wrapped_nested.bl", #"fn probe(pair: (Result[Int, Str], Int)) -> Int {
    match pair {
        (Ok(inner), tag) => inner + tag
        (Err(e), tag) => tag
    }
}
fn main() { assert(probe((Ok(9), 1)) == 10) }
"#)
    let d = dump_of("probe")
    assert_eq(ice_mentioning("a match on this pattern shape"), 0)
    // Neither arm alone names every Result variant, so a coverage proof that only looks
    // at one arm at a time would wrongly call this non-exhaustive and add an unreachable
    // default that could run.
    assert_eq(ice_count(), 0)
    assert(lowered_as_covered(d))
    assert(d.contains("\"&&\""))
}
