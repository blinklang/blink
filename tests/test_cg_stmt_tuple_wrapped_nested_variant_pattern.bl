// A variant sub-pattern nested inside a tuple element -- `(Ok(inner), _)` -- must bind
// and test through that element's own tid, and the match's coverage proof must accept
// two arms that jointly exhaust the scrutinee by refusing at the same tuple position
// even though no single arm's pattern is one flat label. This proves itself by compiling
// and running: an unbuilt coverage proof is a diagnostic, not a wrong value, but a wrong
// bind or test is.

fn classify(pair: (Result[Int, Str], Int)) -> Str {
    match pair {
        (Ok(inner), tag) => "ok {inner} {tag}"
        (Err(e), tag) => "err {e} {tag}"
    }
}

test "variant sub-pattern nested in a tuple element binds and covers" {
    assert_eq(classify((Ok(9), 1)), "ok 9 1")
    assert_eq(classify((Err("boom"), 2)), "err boom 2")
}
