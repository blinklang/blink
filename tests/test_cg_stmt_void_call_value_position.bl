// A Void-returning call reassigned into an already-declared Void-typed local (`m =
// nothing()`, `m += nothing()`) lowers through the ordinary Assignment/CompoundAssign
// path, which builds `target = value;` unconditionally. The call's own C return type is
// `void`, so that store is illegal C ("invalid use of void expression") -- the same shape
// `let x = nothing()` was fixed for (lower_let's Void arm), just reached through
// Assignment and CompoundAssign instead of LetBinding. The target already holds the
// int64_t placeholder its own `let` gave it, and Void has exactly one value, so nothing
// needs to be written back; only the call's side effect has to run.
//
// The same shape recurs where a match arm's tail value is stored into a dest temp
// (TAIL_ASSIGN): a diverging arm whose tail is a Void-returning call (`env.exit`) has
// nothing to store either, since dest_tid there is the match's own type (decided by a
// sibling arm), not this arm's.

fn nothing() { }

fn reassign_void() -> Int {
    let mut m = nothing()
    m = nothing()
    m += nothing()
    5
}

fn diverging_arm_tail_call(n: Int) -> Int {
    let r = match n {
        0 => env.exit(9)
        _ => 2
    }
    r
}

test "reassigning a Void-typed local through a genuine void call compiles and runs" {
    assert_eq(reassign_void(), 5)
}

test "a braceless diverging arm whose call is Void-typed keeps the sibling arm value" {
    assert_eq(diverging_arm_tail_call(1), 2)
}
