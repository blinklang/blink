// A `with <expr> as <name>` item, wired from the protocol cg_eff_resource_cleanup answers
// into the IR wrap_resource builds.
//
// A resource that implements no protocol never reaches lowering: typecheck refuses it
// (E0839), with or without `as`. An FFI scope wraps the bind in a WithScope naming the
// runtime's own blink_ffi_scope_cleanup. A scoped value never reaches wrap_resource: its
// binder holds the Context that enter() answers, so the with stage lowers it on a path of
// its own that calls enter and guards the rest with the exit method. A Closeable type is a
// scoped value through the BlockHandler impl the compiler provides, so it takes that path
// too, and its guard names that impl's exit, which calls close().

import std.fs
import std.io
import typecheck.{check_types}
import layout.{layout_reset}
import mono.{run_mono}
import ir.{IrKind, ir_c_name, ir_kid, ir_kid_count, ir_kind, ir_kind_name, ir_reset, ir_verify}
import parser.{node_count, node_kind, node_name}
import ast.{NodeKind}
import compiler.{compile_to_program}
import diagnostics.{diag_entries, diag_reset}
import cg_test_helpers.{cg_probe_compile_but}
import cname.{c_impl_method_name}
import cname_test_helpers.{find_impl}
import cg_stmt.{cg_local_c_name, cg_stmt_reset, lower_fn}
import cg_reg.{cg_reg_build}

fn find_fn(name: Str) -> Int {
    let mut i = 0
    while i < node_count() {
        if node_kind(i) == NodeKind.FnDef && node_name(i) == name { return i }
        i = i + 1
    }
    -1
}

fn probe_src() -> Str {
    #"import std.traits

type Logged { n: Int }
type Guarded { fd: Int }

impl Closeable for Logged {
    fn close(self) {}
}

impl BlockHandler for Guarded {
    type Context = Int
    fn enter(self) -> Int { self.fd }
    fn exit(self, _ok: Bool) {}
}

fn ffi_case() {
    with ffi.scope() as scope {
        let _ = scope
    }
}

fn closeable_case() {
    let l = Logged { n: 2 }
    with l as logged {
    }
}

fn block_handler_case() {
    let g = Guarded { fd: 3 }
    with g as guarded {
    }
}

fn main() {
    ffi_case()
    closeable_case()
    block_handler_case()
}
"#
}

fn refused_probe_src() -> Str {
    #"type Plainish { v: Int }

fn main() {
    let p = Plainish { v: 1 }
    with p as plain {
        io.println("{plain.v}")
    }
}
"#
}

// Registry, IR and diagnostics are process globals, so each test rebuilds them from the
// same probe rather than reading a sibling test's leftovers.
fn run_probe() ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS.Delete {
    ir_reset()
    layout_reset()
    cg_stmt_reset()
    diag_reset()
    let path = "build/cg_stmt_with_resource_probe.bl"
    write_file(path, probe_src())
    let program = compile_to_program(path, 1)
    check_types(program)
    run_mono(program)
    let _ = fs.delete(path)
    cg_reg_build(program)
}

fn ices() -> Int {
    let mut n = 0
    for d in diag_entries {
        if d.severity == "ice" { n = n + 1 }
    }
    n
}

fn ices_mentioning(text: Str) -> Int {
    let mut n = 0
    for d in diag_entries {
        if d.severity == "ice" && d.message.contains(text) { n = n + 1 }
    }
    n
}

// The first node of `kind` in the tree under `id`, depth-first, or -1. A dump keyed on
// AST node ids shifts whenever the probe gains a line; a search by kind does not.
fn find_kind(id: Int, kind: IrKind) -> Int {
    if id < 0 { return -1 }
    if ir_kind(id) == kind { return id }
    let mut i = 0
    while i < ir_kid_count(id) {
        let found = find_kind(ir_kid(id, i), kind)
        if found >= 0 { return found }
        i = i + 1
    }
    -1
}

test "a resource that implements no protocol is refused before it reaches lowering" {
    ir_reset()
    layout_reset()
    cg_stmt_reset()
    diag_reset()
    let path = "build/cg_stmt_with_resource_refused_probe.bl"
    let _ = cg_probe_compile_but(path, refused_probe_src(), "NonHandlerWithItem")
    let _ = fs.delete(path)
    let mut named = 0
    for d in diag_entries {
        if d.message.contains("got Plainish") { named = named + 1 }
    }
    assert_eq(named, 1)
}

test "an FFI scope resource binds, then wraps the rest of the block in a WithScope naming the runtime cleanup" {
    run_probe()
    diag_reset()
    let root = lower_fn(find_fn("ffi_case"))
    for err in ir_verify(root) { io.println("VERIFY: {err}") }
    assert_eq(ir_verify(root).len(), 0)
    let bind = find_kind(root, IrKind.Let)
    assert(bind >= 0)
    let scoped = find_kind(root, IrKind.WithScope)
    assert(scoped >= 0)
    assert_eq(ir_c_name(scoped), "blink_ffi_scope_cleanup")
    // The scope's resource kid reads the very local the bind just declared.
    assert_eq(ir_kid_count(scoped), 2)
    assert_eq(ir_kind(ir_kid(scoped, 0)), IrKind.VarRef)
    assert_eq(ir_c_name(ir_kid(scoped, 0)), ir_c_name(bind))
    assert_eq(ices(), 0)
}

// The exit of the BlockHandler impl the compiler provides is the exit runner, so the symbol
// is built by the producer that spells its definition. A literal here would pass while the
// definition moved, and the guard would then call a function the unit never defines.
test "a Closeable resource binds its Context, then wraps the rest of the block in a WithScope naming its provided exit" {
    run_probe()
    diag_reset()
    let root = lower_fn(find_fn("closeable_case"))
    for err in ir_verify(root) { io.println("VERIFY: {err}") }
    assert_eq(ir_verify(root).len(), 0)
    assert(find_kind(root, IrKind.Let) >= 0)
    let scoped = find_kind(root, IrKind.WithScope)
    assert(scoped >= 0)
    assert_eq(ir_c_name(scoped), c_impl_method_name(find_impl("Logged", "BlockHandler", ""), "exit"))
    // The guard reads the hidden local enter() was called on, not the binder, which holds
    // the Context enter() answered: one lowering for every scoped value.
    assert_eq(ir_kid_count(scoped), 2)
    assert_eq(ir_kind(ir_kid(scoped, 0)), IrKind.VarRef)
    assert(ir_c_name(ir_kid(scoped, 0)) != cg_local_c_name("logged"))
    assert_eq(ices(), 0)
}

// The handler sits in a hidden local that enter and the guard both read, and the binder
// holds enter's Context, so the guard's resource is that hidden local, not the binder.
test "a BlockHandler resource binds its Context, then wraps the rest of the block in a WithScope naming its own exit method" {
    run_probe()
    diag_reset()
    let root = lower_fn(find_fn("block_handler_case"))
    for err in ir_verify(root) { io.println("VERIFY: {err}") }
    assert_eq(ir_verify(root).len(), 0)
    assert(find_kind(root, IrKind.Let) >= 0)
    let scoped = find_kind(root, IrKind.WithScope)
    assert(scoped >= 0)
    assert_eq(ir_c_name(scoped), c_impl_method_name(find_impl("Guarded", "BlockHandler", ""), "exit"))
    assert_eq(ir_kid_count(scoped), 2)
    assert_eq(ir_kind(ir_kid(scoped, 0)), IrKind.VarRef)
    assert(ir_c_name(ir_kid(scoped, 0)) != cg_local_c_name("guarded"))
    assert_eq(ices(), 0)
    assert_eq(ices_mentioning("BlockHandler"), 0)
}
