import std.fs
import std.io
import layout.{layout_reset}
import cname.{cname_reset}
import cg.{CgConfig, generate}
import cg_reg.{cg_reg_reset, cg_reg_build, cg_reg_type_decls}
import cg_test_helpers.{cg_probe_compile, cg_probe_module_of}

// No functions, so the probe's own module contributes the declaration half alone and no
// body of its own is lowered. What is left must still be a C translation unit a compiler
// accepts: the typedef order, the guards, the evidence vector and the globals are all
// checked at once by handing the output to the C compiler.
//
// The unit is scoped to the probe's own module. The prologue, the typedefs, the evidence
// vector and the globals take no module filter, so every one of them is emitted for the
// whole program and checked here. What the filter drops is the prelude's function
// signatures and bodies, which belong to the stages that own them, not to this premise.
fn probe_src() -> Str {
    #"type Leaf { n: Int }
type Grade { Pass, Fail }
type Shape { Circle(radius: Int), Dot }
type Holder { pair: (Option[Int], Leaf), inner: Leaf }
type Odd { default: Int, register: Int }
let origin: Leaf = Leaf { n: 0 }
let tally: Int = 0
let labels: List[Str] = []
let lookup: Map[Str, Int] = Map()
"#
}

test "the declaration half of a unit is C a compiler accepts" {
    let src_path = "build/cg_unit_valid_c_probe.bl"
    let program = cg_probe_compile(src_path, probe_src())
    cg_reg_reset()
    cg_reg_build(program)
    let probe_module = cg_probe_module_of(cg_reg_type_decls(), "Leaf")
    layout_reset()
    cname_reset()
    let _ = fs.delete(src_path)

    let cfg = CgConfig { debug_mode: 0, trace_codegen: 0, deterministic: 1,
        emit_only_module: probe_module, skip_modules: Map(), user_tu_mode: 0,
        blink_ev_extern_only: 0, archive_build_mode: 0 }
    let c_path = "build/cg_unit_valid_c_probe.c"
    write_file(c_path, generate(program, cfg))

    let log = "build/cg_unit_valid_c_probe.log"
    let rc = shell_exec("cc -std=c11 -fsyntax-only -Ibootstrap {c_path} > {log} 2>&1")
    if rc != 0 {
        io.println("FAIL: the C compiler rejected the unit:")
        io.println(read_file(log))
    }
    assert_eq(rc, 0)
    let _ = fs.delete(c_path)
    let _ = fs.delete(log)
}
