import std.fs
import std.io
import layout.{layout_reset}
import cname.{cname_reset}
import cg_test_helpers.{cg_probe_begin, cg_probe_compile, cg_probe_errors, cg_probe_errors_named,
    cg_probe_ices_named, cg_probe_ices_naming}
import cg.{CgConfig, generate, generate_module_header, generate_module_object}
import mono.{run_mono, instances}
import compiler.{compile_to_program}

fn assert_eq_int(label: Str, got: Int, want: Int) {
    if got != want {
        io.println("FAIL: {label}: got {got} want {want}")
    }
    assert_eq(got, want)
}

fn assert_has(text: Str, needle: Str) {
    if text.index_of(needle) < 0 {
        io.println("FAIL: output has no '{needle}'\n--- output ---\n{text}")
    }
    assert(text.index_of(needle) >= 0)
}

fn assert_lacks(text: Str, needle: Str) {
    if text.index_of(needle) >= 0 {
        io.println("FAIL: output must not have '{needle}'\n--- output ---\n{text}")
    }
    assert(text.index_of(needle) < 0)
}

// The same order the real drivers use. The mono pass is not part of generate, so a probe
// that skips it has no instance table and a generic base looks like a base with no uses.
fn build_probe(src: Str, name: Str) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, FS.Delete {
    let path = "build/{name}.bl"
    let program = cg_probe_compile(path, src)
    run_mono(program)
    layout_reset()
    cname_reset()
    let _ = fs.delete(path)
    program
}

fn standalone_cfg() -> CgConfig {
    CgConfig { debug_mode: 0, trace_codegen: 0, deterministic: 0, emit_only_module: "",
        skip_modules: Map(), user_tu_mode: 0, blink_ev_extern_only: 0, archive_build_mode: 0 }
}

// A module the front end cannot resolve is reported and then left out, so the program is
// still a program and the emitters still run. Every probe here guards against that by
// counting error diagnostics. This test proves the count they read can rise.
fn lost_import_src() -> Str {
    #"import no_such_module_at_all.{nope}

fn main() { let x = 1 }
"#
}

test "a module the front end cannot resolve is an error rather than a silent omission" {
    let path = "build/cg_def_lost_import_probe.bl"
    cg_probe_begin(path)
    write_file(path, lost_import_src())
    let _program = compile_to_program(path, 1)
    let _rm = fs.delete(path)
    assert_eq_int("the module that could not be resolved is reported",
        cg_probe_errors_named("ModuleNotFound"), 1)
    assert_eq_int("and it is the only error, so the count a probe reads is this one",
        cg_probe_errors(), 1)
}

// `plain` is a root body: every type in it is concrete, so it has one definition. `ident`
// is a generic base, which has a definition only once a type argument is chosen — one per
// monomorphized instance, and none under the base itself.
// `main` holds only a leaf value so this whole unit lowers without a report. A probe that
// reports for an unrelated reason cannot be used to prove that some other shape is silent.
fn root_src() -> Str {
    #"fn plain(a: Int) -> Int { a }
fn ident[T](x: T) -> T { x }
fn main() { let x = 1 }
"#
}

// A root body reaches the statement stage and comes back as a definition, not only the
// prototype the declaration half already wrote.
test "a root function body is emitted as a definition" {
    let program = build_probe(root_src(), "cg_def_root_probe")
    let text = generate(program, standalone_cfg())
    assert_has(text, "int64_t blink_u_plain(int64_t a);")
    assert_has(text, "int64_t blink_u_plain(int64_t a) \{")
}

// The definition of a generic base is one per instance, so the base itself contributes
// none. An empty body under the base's own name would be a function that returns nothing
// where its signature promises a value.
test "a generic base contributes no root definition" {
    let program = build_probe(root_src(), "cg_def_generic_probe")
    let text = generate(program, standalone_cfg())
    assert_has(text, "int64_t blink_u_plain(int64_t a) \{")
    assert_lacks(text, "blink_u_ident")
}

// A generic base nobody used has no instances, so there is no body to write and no caller
// left undefined. That is the one shape where a generic base contributes nothing and is
// not a gap, so it must stay silent rather than report a stage it does not need.
test "an unused generic base emits nothing and reports nothing" {
    let program = build_probe(root_src(), "cg_def_unused_generic_probe")
    let text = generate(program, standalone_cfg())
    assert_lacks(text, "blink_u_ident")
    assert_eq_int("an unused generic base reports no stage",
        cg_probe_ices_naming("is not built"), 0)
}

// A foreign binding's Blink body is empty by construction, so the wrapper's body is not a
// lowering of it: it is the call to the foreign symbol. Lowering the empty body instead
// would emit a wrapper that falls off the end of a value-returning function.
fn ffi_src() -> Str {
    #"@ffi("foreign_thing")
@trusted
fn wrapped(x: Int) -> Int ! FFI {}

fn main() { assert(true) }
"#
}

test "a foreign binding wrapper is never emitted as an empty body" {
    let program = build_probe(ffi_src(), "cg_def_ffi_probe")
    let text = generate(program, standalone_cfg())
    assert_has(text, "int64_t blink_wrapped(int64_t x) \{")
    assert_has(text, "return foreign_thing(x);")
    assert_eq_int("no foreign-wrapper refusal",
        cg_probe_ices_naming("cg foreign wrapper bodies"), 0)
}

// The statement stage numbers its temporaries from zero in each unit. Two emits of one
// program in one process must therefore agree, or the second is reading state the first
// left behind.
test "two emits of one program produce the same unit" {
    let program = build_probe(root_src(), "cg_def_reset_probe")
    let first = generate(program, standalone_cfg())
    let second = generate(program, standalone_cfg())
    assert_eq_int("the two emits are the same length", second.len(), first.len())
    assert(first == second)
}

// A method's name carries its receiver type and trait, so the declaration and the definition
// must agree on it. One producer answers for both, and a prototype the definition does not
// match compiles a caller against a symbol no unit defines.
fn method_src() -> Str {
    #"type Box { v: Int }

trait Peek {
    fn peek(self) -> Int
}

impl Peek for Box {
    fn peek(self) -> Int { self.v }
}

fn main() { assert(true) }
"#
}

test "an impl method is declared and defined under one name" {
    let program = build_probe(method_src(), "cg_def_method_probe")
    let text = generate(program, standalone_cfg())
    assert_has(text, "int64_t blink_Box_Peek_peek(blink_Box self);")
    assert_has(text, "int64_t blink_Box_Peek_peek(blink_Box self) \{")
}

// The acceptance shape for the definition half. Every value here is a leaf the expression
// stage lowers for real, so these bodies cross the whole pipeline: the driver asks where
// each body goes, the statement stage lowers it, and the printer writes it. Nothing in the
// unit may report an unbuilt stage, which is the one assertion that cannot pass by accident.
fn leaf_src() -> Str {
    #"fn vals() {
    let a = 1
    let b = true
    let c = "hi"
    let d = a
}

fn main() { let x = 1 }
"#
}

test "a body of leaf values lowers end to end with no stage left unbuilt" {
    let program = build_probe(leaf_src(), "cg_def_leaf_probe")
    let text = generate(program, standalone_cfg())
    assert_has(text, "void blink_u_vals(void) \{")
    assert_has(text, "int64_t a = 1;")
    assert_has(text, "int b = 1;")
    assert_has(text, "const char* c = \"hi\";")
    assert_has(text, "int64_t d = a;")
    assert_has(text, "void blink_main(blink_ev* __ev) \{")
    assert_has(text, "int64_t x = 1;")
    assert_eq_int("no stage is left unbuilt", cg_probe_ices_naming("is not built"), 0)
}

// A generic base has one body per instance, and each instance spells its own substituted
// types. Two instances of one base therefore produce two definitions that differ in their
// signature, not two copies of the binder.
fn two_instance_src() -> Str {
    #"fn ident[T](x: T) -> T { x }

fn use_both() {
    let a = ident(1)
    let b = ident(true)
}

fn after(n: Int) -> Int { n }

fn main() { let x = 1 }
"#
}

test "a generic base with two instances emits one definition per instance" {
    let program = build_probe(two_instance_src(), "cg_def_two_inst_probe")
    assert_eq_int("the base has two instances", instances().len(), 2)
    let text = generate(program, standalone_cfg())

    // Each instance spells its own substituted types. Int is the machine word and Bool is
    // C's int, so a body that still read the binder could not produce both.
    assert_has(text, "int64_t blink_ident_0Int(int64_t x) \{")
    assert_has(text, "int blink_ident_0Bool(int x) \{")
    assert_has(text, "return x;")

    // Declared as well as defined. A caller compiled before the definition needs the
    // prototype, and the base itself is declared by neither half.
    assert_has(text, "int64_t blink_ident_0Int(int64_t x);")
    assert_has(text, "int blink_ident_0Bool(int x);")
    assert_lacks(text, "blink_u_ident")
}

// The instance walk makes an instance current and must put the root back. A declaration
// node belongs to no instance, so a root left unrestored is refused by name rather than
// answered, and the declarations after it would vanish from the unit.
test "declarations still emit after an instance body has run" {
    let program = build_probe(two_instance_src(), "cg_def_after_inst_probe")
    let text = generate(program, standalone_cfg())
    assert_has(text, "int64_t blink_ident_0Int(int64_t x) \{")
    // `after` is the discriminating one: it is emitted after the instance bodies and its
    // param and return annotation are declaration nodes, so it is the first thing in the
    // unit that reads a type through whatever the instance walk left current.
    assert_has(text, "int64_t blink_u_after(int64_t n);")
    assert_has(text, "int64_t blink_u_after(int64_t n) \{")
    assert_has(text, "void blink_main(blink_ev* __ev) \{")
    assert_eq_int("no declaration was read through an instance",
        cg_probe_ices_named("MonoNodeNotInInstance"), 0)
}

// The per-module mode selects declarations by the module they were written in, and only
// an imported file carries a module key of its own, so this shape needs a package: a
// generic base in one module and the calls that instantiate it in another.
fn pkg_probe(stem: Str) -> Int ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck {
    let root = "build/{stem}_pkg"
    let _clean = process_run("rm", ["-rf", root])
    let _mk = process_run("mkdir", ["-p", "{root}/src"])
    write_file("{root}/blink.toml", "[package]\nname = \"{stem}\"\nversion = \"0.1.0\"\n")
    write_file("{root}/src/mymod.bl", #"pub fn ident[T](x: T) -> T { x }
"#)
    let path = "{root}/src/probe.bl"
    let program = cg_probe_compile(path, #"import mymod.{ident}

fn use_both() {
    let _a = ident(1)
    let _b = ident(true)
}

fn main() { let _x = 1 }
"#)
    run_mono(program)
    layout_reset()
    cname_reset()
    let _rm = process_run("rm", ["-rf", root])
    program
}

// The per-module mode splits one module into a header of declarations and an object of
// definitions. Whatever the object defines the header must declare, or a caller in
// another module reads a name this translation unit never told it about. Instances are
// where the two halves can drift, because an instance is named after itself and not
// after any declaration that a walk over declarations would find on its own. The names
// come from the instance table rather than being written out here, so this proves the
// symmetry and not one particular spelling.
test "a module header declares every instance its object defines" {
    let program = pkg_probe("cg_def_split")
    assert_eq_int("the base has two instances", instances().len(), 2)
    let header = generate_module_header(program, "mymod", standalone_cfg())
    let object = generate_module_object(program, "mymod", "mymod.h", standalone_cfg())
    for inst in instances() {
        assert_has(object, "{inst.c_name}(")
        assert_has(header, "{inst.c_name}(")
    }
    // The split stays a split: the bodies are in the object and in no header.
    assert_has(object, "return x;")
    assert_lacks(header, "return x;")
}
