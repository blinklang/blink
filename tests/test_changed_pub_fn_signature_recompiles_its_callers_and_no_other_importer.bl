// A per-module build keys each unit's object on the C it compiles, and a unit holds the
// declaration of each symbol of another module it names. A changed signature of a pub fn
// changes that declaration, so each unit that calls the fn compiles again and the binary runs
// the new fn. A unit that imports the module but does not call that fn keeps its C and its
// object.

import std.process.{ProcessResult}

fn sh(cmd: Str) -> Str {
    process_run("sh", ["-c", cmd]).out.trim()
}

fn dev_tree(root: Str, tree: Str) {
    shell_exec("rm -rf {tree}")
    shell_exec("mkdir -p {tree}/build {tree}/app/src")
    // A copy, not a link: the install root comes from realpath(argv[0]).
    shell_exec("cp {sh("readlink -f build/blink")} {tree}/build/blink")
    shell_exec("ln -s {root}/lib {tree}/lib")
    shell_exec("ln -s {root}/lib {tree}/build/lib")
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        shell_exec("[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}")
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    shell_exec("[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h")
    write_file("{tree}/app/blink.toml", "[package]\nname = \"signature_change_app\"\nversion = \"0.1.0\"\n")
    write_file("{tree}/app/src/lib.bl", [
        #"pub fn used_fn(n: Int) -> Int {"#,
        #"    n * 2"#,
        #"}"#,
        #""#,
        #"pub fn other_fn() -> Int {"#,
        #"    5"#,
        #"}"#,
        #""#,
    ].join("\n"))
    write_file("{tree}/app/src/caller.bl", [
        #"import lib.{used_fn}"#,
        #""#,
        #"pub fn caller_value() -> Int {"#,
        #"    used_fn(2)"#,
        #"}"#,
        #""#,
    ].join("\n"))
    write_file("{tree}/app/src/bystander.bl", [
        #"import lib.{other_fn}"#,
        #""#,
        #"pub fn bystander_value() -> Int {"#,
        #"    other_fn() + 1"#,
        #"}"#,
        #""#,
    ].join("\n"))
    write_file("{tree}/app/src/main.bl", [
        #"import bystander.{bystander_value}"#,
        #"import caller.{caller_value}"#,
        #""#,
        #"fn main() {"#,
        #"    io.println("values {caller_value()} {bystander_value()}")"#,
        #"}"#,
        #""#,
    ].join("\n"))
}

// The corpus exports BLINK_COMPILER_ARCHIVE, which, like the module filters, makes a build
// one unit, so the run drops them.
fn blink_in(tree: Str, args: Str) -> ProcessResult {
    process_run("sh", ["-c", "cd {tree} && env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_PER_MODULE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE BLINK_CACHE_DIR={tree}/objcache BLINK_TRACE_CHANNELS=build.units build/blink {args}"])
}

// The units a build compiled, read from its build.units trace, sorted.
fn units_compiled(r: ProcessResult) -> List[Str] {
    let mut out: List[Str] = []
    for line in "{r.out}\n{r.err_out}".split("\n") {
        let mark = "[dbg:build.units] compile "
        if line.starts_with(mark) {
            out.push(line.byte_slice(mark.byte_len(), line.byte_len()).trim())
        }
    }
    let mut i = 1
    while i < out.len() {
        let cur = out.get(i).unwrap()
        let mut j = i
        while j > 0 && out.get(j - 1).unwrap() > cur {
            out.set(j, out.get(j - 1).unwrap())
            j = j - 1
        }
        out.set(j, cur)
        i = i + 1
    }
    out
}

fn build_units(tree: Str) -> List[Str] {
    let r = blink_in(tree, "build app/src/main.bl -o {tree}/out/app --per-module")
    assert(r.exit_code == 0, "per-module build failed: {r.out}{r.err_out}")
    units_compiled(r)
}

test "a changed signature of a pub fn recompiles each unit that calls it and no other importer" {
    let root = sh("pwd -P")
    let tree = "{root}/.tmp/_pub_fn_signature_{getpid()}"
    dev_tree(root, tree)
    let cold = build_units(tree)
    let out_cold = sh("{tree}/out/app")
    let lib = "{tree}/app/src/lib.bl"
    write_file(lib, read_file(lib).replace("used_fn(n: Int) -> Int \{\n    n * 2", "used_fn(n: Int, -- k: Int = 5) -> Int \{\n    n * k"))
    let lib_text = read_file(lib)
    let changed = build_units(tree)
    let out_changed = sh("{tree}/out/app")
    shell_exec("rm -rf {tree}")
    assert(lib_text.contains("n * k"), "the edit did not apply: {lib_text}")
    assert(cold.contains("bystander") && cold.contains("caller"), "the cold build did not compile every unit: {cold.join(",")}")
    assert_eq(changed.join(","), "caller,lib")
    assert_eq(out_cold, "values 4 6")
    assert_eq(out_changed, "values 10 6")
}
