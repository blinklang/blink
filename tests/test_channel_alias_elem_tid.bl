// A channel bound from another channel var (`let ch2 = ch1`) must carry its element type to
// every consumption seam through the element's tid, the same as a freshly constructed channel.
//
// This is the one channel-binding shape the rest of the corpus does not write: every other
// channel test constructs its channel in place (`let ch = Channel(n)`), so the copy path that
// binds a channel from an existing channel VARIABLE reached codegen unexercised. A reader that
// leans on the flat element channel here instead of the tid mis-boxes a Str or a struct as an
// integer word and prints a pointer, exit 0.

type Box { n: Int }

test "an aliased Str channel carries its element through recv" {
    let ch: Channel[Str] = Channel(4)
    let alias = ch
    alias.send("hello")
    assert_eq(ch.recv(), "hello")
}

test "an aliased Str channel carries its element through a for-in drain" {
    let ch: Channel[Str] = Channel(4)
    let alias = ch
    alias.send("ab")
    alias.send("cde")
    alias.close()
    let mut total = 0
    for v in alias {
        total = total + v.len()
    }
    assert_eq(total, 5)
}

test "an aliased struct channel drains by value" {
    let ch: Channel[Box] = Channel(4)
    let alias = ch
    alias.send(Box { n: 7 })
    alias.send(Box { n: 35 })
    alias.close()
    let mut total = 0
    for b in alias {
        total = total + b.n
    }
    assert_eq(total, 42)
}

test "an aliased Int channel round-trips including a zero" {
    let ch: Channel[Int] = Channel(4)
    let alias = ch
    alias.send(0)
    alias.send(9)
    assert_eq(alias.recv(), 0)
    assert_eq(ch.recv(), 9)
}
