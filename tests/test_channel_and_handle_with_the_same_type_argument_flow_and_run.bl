// A Channel or a Handle whose type argument matches its slot still builds and runs, through a
// `let`, a call argument, a return and a struct field: the compatibility check compares the
// type argument and must not refuse a match.

type Pipe {
    ch: Channel[Str]
    h: Handle[Int]
}

fn relay(c: Channel[Str]) -> Channel[Str] {
    c
}

fn keep(h: Handle[Int]) -> Handle[Int] {
    h
}

fn fill(c: Channel[Str]) {
    c.send("a")
    c.send("b")
    c.close()
}

test "the same type argument flows through every place" {
    let ch: Channel[Str] = channel.new[Str](buffer: 2)
    let same: Channel[Str] = ch
    fill(same)
    let h: Handle[Int] = async.spawn(fn() { 41 + 1 })
    let p = Pipe { ch: relay(same), h: keep(h) }
    let mut got: List[Str] = []
    for s in p.ch {
        got.push(s)
    }
    assert_eq(got.join(","), "a,b")
    assert_eq(p.h.await, 42)
}
