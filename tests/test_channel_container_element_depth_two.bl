// A container element inside a Channel (Channel[List[Int]]) must be usable both from a
// for-in binder and from a recv() result, even though the channel itself is fully
// annotated. Both reads decode the slot through the element's full type, so a List
// element keeps its own inner element type.

import compile_test_helpers.{compile_and_run}

test "a List element received via Channel for-in supports .len()" {
    let src = #"
fn main() ! IO {
    let ch: Channel[List[Int]] = channel.new[List[Int]](buffer: 4)
    ch.send([1, 2, 3])
    ch.close()
    let mut t = 0
    for l in ch { t = t + l.len() }
    io.println("t={t}")
}
"#
    let r = compile_and_run(src, "_channel_container_elem_forin")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "t=3\n")
}

test "a List element received via Channel.recv() supports .len()" {
    let src = #"
fn main() ! IO {
    let ch: Channel[List[Int]] = channel.new[List[Int]](buffer: 4)
    ch.send([1, 2, 3])
    io.println("n={ch.recv().unwrap().len()}")
}
"#
    let r = compile_and_run(src, "_channel_container_elem_recv")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "n=3\n")
}
