// A container element inside a Channel (Channel[List[Int]]) must be usable both from a
// for-in binder and from a recv() result, even though the channel itself is fully
// annotated. The channel's flat (CT, sname) representation only holds a depth-1 element,
// so a List/Map/Set element inside a channel loses its own inner element type.

import compile_test_helpers.{compile_and_run}

test.failing(
    "a List element received via Channel for-in supports .len()",
    reason: "the for-in binder over a channel narrows the recv'd element to a flat (CT, sname) pair that cannot represent a container's own element type, so codegen emits a mistyped call to the List method",
    ticket: "zpq3yn",
) {
    let src = #"
fn main() ! IO {
    let ch: Channel[List[Int]] = Channel(4)
    ch.send([1, 2, 3])
    ch.close()
    let mut t = 0
    for l in ch { t = t + l.len() }
    io.println("t={t}")
}
"#
    let r = compile_and_run(src, "_channel_container_elem_forin")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "t=3\n")
}

test.failing(
    "a List element received via Channel.recv() supports .len()",
    reason: "the channel recv arm reinterprets the received box through chan_elem_c_type(elem_ct, elem_sname), which is depth-1 only, so a List element's own element type is dropped and codegen emits a mistyped call to the List method",
    ticket: "zpq3yn",
) {
    let src = #"
fn main() ! IO {
    let ch: Channel[List[Int]] = Channel(4)
    ch.send([1, 2, 3])
    io.println("n={ch.recv().len()}")
}
"#
    let r = compile_and_run(src, "_channel_container_elem_recv")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "n=3\n")
}
