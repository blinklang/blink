// A channel built with only a buffer capacity and never annotated once took its element type
// from a later send. The spec builds a channel only through `channel.new[T](buffer: N)`
// (sections/04_effects.md), which writes the element at the construction site, so nothing is
// left to back-infer: the bare call is refused as an undefined function with that repair,
// before a generic fn it is passed to is instantiated at anything.

import compile_test_helpers

test "an unannotated Channel(n) passed to a generic call is refused, not back-inferred from a send" {
    let src = #"
import std.io

fn relay[T](src: Channel[T], dst: Channel[T]) {
    dst.send(src.recv())
}

fn main() ! IO {
    let a = Channel(10)
    let b = Channel(10)
    a.send(99)
    relay(a, b)
    io.println("ok")
}
"#
    let out = compile_test_helpers.compile_and_capture(src, "_channel_element_type_not_back_inferred_from_send")
    compile_test_helpers.expect_error(out, "E0504", "bare Channel(n) is an undefined function")
    compile_test_helpers.expect_contains(out, "channel.new[T](buffer: n)", "the repair names the spec constructor")
    assert(!out.contains("E0301"))
}
