// A Channel created with only a buffer-capacity argument and never annotated
// takes its element type from a later send, so a generic fn it is passed to
// is instantiated at that type rather than reaching codegen unsolved.

import compile_test_helpers.{compile_and_run}

test "an unannotated Channel's element type back-infers from a later send for a generic call" {
    let src = #"
import std.io

fn relay[T](src: Channel[T], dst: Channel[T]) {
    dst.send(src.recv())
}

fn main() ! IO {
    let a = Channel(10)
    let b = Channel(10)
    a.send(99)
    relay(a, b)
    io.println("ok")
}
"#
    let r = compile_and_run(src, "_channel_element_type_not_back_inferred_from_send")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "ok\n")
}
