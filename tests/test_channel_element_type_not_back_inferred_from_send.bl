// A Channel created with only a buffer-capacity argument and never annotated
// does not get its element type back-inferred from a later send, so passing
// it to a generic fn reaches monomorphization with an unsolved type param and
// the compiler emits internal error I0001 UnsolvedTypeVarAtCodegen instead of
// either inferring the element type or reporting E0301 CannotInferType.

import compile_test_helpers.{compile_and_run}

test.failing(
    "an unannotated Channel's element type back-infers from a later send for a generic call",
    reason: "an unannotated Channel(10) does not back-infer its element type from a later a.send(99), so passing it into a generic fn relay[T](src: Channel[T], dst: Channel[T]) reaches monomorphization with an unsolved type param, hitting internal error I0001 UnsolvedTypeVarAtCodegen instead of compiling (or reporting E0301 CannotInferType if inference is not possible)",
    ticket: "2ccm87",
) {
    let src = #"
import std.io

fn relay[T](src: Channel[T], dst: Channel[T]) {
    dst.send(src.recv())
}

fn main() ! IO {
    let a = Channel(10)
    let b = Channel(10)
    a.send(99)
    relay(a, b)
    io.println("ok")
}
"#
    let r = compile_and_run(src, "_channel_element_type_not_back_inferred_from_send")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "ok\n")
}
