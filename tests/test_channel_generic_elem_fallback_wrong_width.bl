fn sum_channel[T: Add](ch: Channel[T], zero: T) -> T {
    let mut total = zero
    for v in ch {
        total = total + v
    }
    total
}

test "for-in over a generic Channel[T] sums Float elements correctly" {
    let ch: Channel[Float] = Channel(4)
    ch.send(1.5)
    ch.send(2.5)
    ch.close()
    assert_eq(sum_channel(ch, 0.0), 4.0)
}
