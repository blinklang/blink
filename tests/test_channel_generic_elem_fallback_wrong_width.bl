fn sum_channel[T: Add](ch: Channel[T], zero: T) -> T {
    let mut total = zero
    for v in ch {
        total = total + v
    }
    total
}

test.failing(
    "for-in over a generic Channel[T] sums Float elements correctly",
    reason: "tc_channel_elem_ct cannot resolve the element type through the unbound type parameter, so codegen falls back to treating the received box as a raw int64_t word instead of dereferencing the boxed Float; the typecheck tid (Float) and the codegen container tag (the CT_INT fallback) disagree and the loop variable is read at the wrong width",
    ticket: "a4jvjk",
) {
    let ch: Channel[Float] = Channel(4)
    ch.send(1.5)
    ch.send(2.5)
    ch.close()
    assert_eq(sum_channel(ch, 0.0), 4.0)
}
