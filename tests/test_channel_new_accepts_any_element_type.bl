// channel.new[T](buffer: n) takes any type as T (§4, channel construction), the same as
// any other explicit call type argument: unit, a nested generic, a tuple, and the spec's
// own channel.new[Option[Int]] example all build a channel of that element. The element
// type is checked like any other type argument: exactly one, and it must name a type.

import compile_test_helpers.{compile_and_run, compile_and_capture}

fn error_count(output: Str) -> Int {
    let mut n = 0
    for line in output.split("\n") {
        if line.contains("\"severity\":\"error\"") { n = n + 1 }
    }
    n
}

test "channel.new[()] builds a channel of unit" {
    let src = #"
import std.io

fn main() ! IO {
    let ch = channel.new[()](buffer: 2)
    ch.send(())
    ch.close()
    let mut n = 0
    for _u in ch { n = n + 1 }
    io.println("n={n}")
}
"#
    let r = compile_and_run(src, "_chan_new_unit_elem")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "n=1\n")
}

test "channel.new[List[Int]] builds a channel of a nested generic" {
    let src = #"
import std.io

fn main() ! IO {
    let ch = channel.new[List[Int]](buffer: 4)
    ch.send([1, 2, 3])
    ch.close()
    for xs in ch { io.println("len={xs.len()}") }
}
"#
    let r = compile_and_run(src, "_chan_new_list_elem")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "len=3\n")
}

test "channel.new[(Int, Str)] builds a channel of a tuple" {
    let src = #"
import std.io

fn main() ! IO {
    let ch = channel.new[(Int, Str)](buffer: 1)
    ch.send((7, "seven"))
    ch.close()
    for pair in ch { io.println("{pair.0} {pair.1}") }
}
"#
    let r = compile_and_run(src, "_chan_new_tuple_elem")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "7 seven\n")
}

test "channel.new[Option[Int]] carries a sent None as a value" {
    let src = #"
import std.io

fn main() ! IO {
    let ch = channel.new[Option[Int]](buffer: 2)
    ch.send(None)
    ch.send(Some(3))
    ch.close()
    for v in ch {
        match v {
            Some(n) => io.println("some {n}")
            None => io.println("none")
        }
    }
}
"#
    let r = compile_and_run(src, "_chan_new_option_elem")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "none\nsome 3\n")
}

test "the element type written in channel.new[T] is the channel's element type" {
    let src = #"
import std.io

fn main() ! IO {
    let ch = channel.new[List[Str]](buffer: 1)
    ch.send(["a", "b"])
    ch.close()
    for got in ch {
        let words: List[Str] = got
        io.println(words.join(","))
    }
}
"#
    let r = compile_and_run(src, "_chan_new_elem_is_annotation")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "a,b\n")
}

test "an unknown element type in channel.new[T] is an unknown type" {
    let src = "fn main() \{\n    let _ch = channel.new[List[Nope]](buffer: 2)\n}\n"
    let output = compile_and_capture(src, "_chan_new_unknown_elem")
    assert(output.contains("E0507"), output)
    assert(error_count(output) == 1, output)
}

test "channel.new with two type arguments is a type-argument count error" {
    let src = "fn main() \{\n    let _ch = channel.new[Int, Str](buffer: 2)\n}\n"
    let output = compile_and_capture(src, "_chan_new_two_targs")
    assert(output.contains("E0307"), output)
    assert(error_count(output) == 1, output)
}

test "a value where channel.new's element type belongs is one parse error that names the element type" {
    let src = "fn main() \{\n    let _ch = channel.new[5](buffer: 2)\n}\n"
    let output = compile_and_capture(src, "_chan_new_value_elem")
    assert(output.contains("E1100"), output)
    assert(output.contains("element type"), output)
    assert(error_count(output) == 1, output)
}
