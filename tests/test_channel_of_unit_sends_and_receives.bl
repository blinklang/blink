// A channel of the unit `()` carries a real element. The runtime reads a NULL slot as
// "closed and empty", so each unit travels boxed as its placeholder word, and a reader
// sees every sent unit before it sees the channel close.

import compile_test_helpers.{compile_and_run}

test "a unit sent on a channel is received as a value" {
    let src = #"
import std.io

fn main() ! IO {
    let ch: Channel[()] = channel.new[()](buffer: 2)
    ch.send(())
    ch.send(())
    let a: () = ch.recv().unwrap()
    let b: () = ch.recv().unwrap()
    io.println("got {a == b}")
}
"#
    let r = compile_and_run(src, "_unit_chan_recv")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "got true\n")
}

test "a unit call sent on a channel runs once" {
    let src = #"
import std.io

fn nothing() -> () { io.println("side") }

fn main() ! IO {
    let ch: Channel[()] = channel.new[()](buffer: 1)
    ch.send(nothing())
    let _got: () = ch.recv().unwrap()
    io.println("got")
}
"#
    let r = compile_and_run(src, "_unit_chan_call")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "side\ngot\n")
}

test "a for-in drain of a closed unit channel reads every unit sent" {
    let src = #"
import std.io

fn main() ! IO {
    let ch: Channel[()] = channel.new[()](buffer: 3)
    ch.send(())
    ch.send(())
    ch.send(())
    ch.close()
    let mut n = 0
    for _u in ch {
        n = n + 1
    }
    io.println("{n}")
}
"#
    let r = compile_and_run(src, "_unit_chan_drain")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "3\n")
}
