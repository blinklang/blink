// recv answers the element itself, not an Option, so a closed channel with nothing left
// has no value to give. It panics rather than hand back a zero no reader could tell from
// a real one.

import compile_test_helpers.{compile_and_run}

fn src_closed_recv() -> Str {
    #"fn main() {
    let ch: Channel[Int] = channel.new[Int](buffer: 1)
    ch.send(4)
    ch.close()
    let a = ch.recv()
    io.println("got {a}")
    let b = ch.recv()
    io.println("then {b}")
}
"#
}

test "recv on a closed, empty channel panics after the values it held" {
    let r = compile_and_run(src_closed_recv(), "channel_recv_closed_empty")
    assert(r.out.contains("got 4"))
    assert(!r.out.contains("then"))
    assert(r.exit_code != 0)
    assert(r.err_out.contains("recv on a closed, empty channel"))
}
