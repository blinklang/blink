// recv answers Option[T], so a call site written for a bare T gets a type error. The help
// names the forms that handle the closed case before `.unwrap()`, which panics on it
// (decisions/channel-recv-closed-empty.md: `?? default`, `match` and `for` come first).

import compile_test_helpers.{compile_and_capture}

fn src_let_int_from_recv() -> Str {
    #"fn main() {
    let ch = channel.new[Int](buffer: 1)
    ch.send(1)
    let x: Int = ch.recv()
    io.println("{x}")
}
"#
}

test "a recv bound as a bare Int is a type error whose help puts ?? before unwrap" {
    let out = compile_and_capture(src_let_int_from_recv(), "_chan_recv_mismatch_help")
    assert(out.contains("TypeError"))
    assert(out.contains("Option[Int]"))
    assert(out.contains("??"))
    assert(out.contains("match"))
    assert(out.contains("for v in"))
    assert(out.contains(".unwrap()"))
    assert(out.index_of("??") < out.index_of(".unwrap()"))
}

fn src_let_option_from_recv() -> Str {
    #"fn main() {
    let ch = channel.new[Int](buffer: 1)
    ch.send(1)
    let x: Option[Int] = ch.recv()
    io.println("{x ?? 0}")
}
"#
}

test "a recv bound as Option[Int] type-checks" {
    let out = compile_and_capture(src_let_option_from_recv(), "_chan_recv_option_ok")
    assert(!out.contains("error"))
}
