pub let ch: Channel[Int] = channel.new[Int](buffer: 10)

test "top-level channel init" {
    ch.send(99)
    let v = ch.recv().unwrap()
    assert_eq(v, 99)
}

test "top-level channel multiple sends" {
    ch.send(1)
    ch.send(2)
    ch.send(3)
    assert_eq(ch.recv().unwrap(), 1)
    assert_eq(ch.recv().unwrap(), 2)
    assert_eq(ch.recv().unwrap(), 3)
}
