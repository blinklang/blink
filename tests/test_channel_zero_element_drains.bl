// The runtime reads a NULL slot as "closed and empty", so a sent value must never reach
// the channel as NULL. An Int 0 is the value that would, if the slot held the word itself.

test "a zero sent on a channel is drained like any other value" {
    let ch: Channel[Int] = Channel(10)
    ch.send(5)
    ch.send(0)
    ch.send(7)
    ch.close()
    let mut total = 0
    let mut seen = 0
    for v in ch {
        total = total + v
        seen = seen + 1
    }
    assert_eq(seen, 3)
    assert_eq(total, 12)
}

test "recv hands back a zero that was sent" {
    let ch: Channel[Int] = Channel(2)
    ch.send(0)
    ch.send(9)
    assert_eq(ch.recv(), 0)
    assert_eq(ch.recv(), 9)
}

test "a false sent on a channel is received as false" {
    let ch: Channel[Bool] = Channel(2)
    ch.send(false)
    ch.send(true)
    ch.close()
    let mut got: List[Bool] = []
    for b in ch {
        got.push(b)
    }
    assert_eq(got.len(), 2)
    assert(!got[0])
    assert(got[1])
}
