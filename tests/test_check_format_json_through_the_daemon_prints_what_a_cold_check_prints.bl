// With the project's daemon up, `check --format json` prints what it prints with no daemon:
// the same exit code, the JSON status row on stdout and the JSON diagnostics on stderr, and
// the same bytes as `check --json`. An unknown --format value is the same usage error with
// the daemon up: the client rejects it before it asks the daemon. The daemon may make a check
// faster, never different.

import std.process.{ProcessResult}

let DIR = ".tmp/daemon_check_format_json"

fn sh(cmd: Str) -> ProcessResult {
    process_run("sh", ["-c", cmd])
}

fn ok_src() -> Str {
    "fn main() \{\n    io.println(\"hi\")\n}\n"
}

fn warn_src() -> Str {
    "fn main() \{\n    let x = 1\n    io.println(\"hi\")\n}\n"
}

fn err_src() -> Str {
    "fn main() \{\n    let x: Int = \"s\"\n    io.println(\"\{x}\")\n}\n"
}

fn check(flags: Str) -> ProcessResult {
    sh("B=$(pwd)/build/blink; cd {DIR} && timeout 60 $B check {flags} main.bl")
}

// The pid of a daemon serving main.bl, or -1. The timeout ends a daemon that nothing stopped.
fn start_daemon() -> Int {
    let r = sh("B=$(pwd)/build/blink; cd {DIR} && rm -rf .blink && (timeout 120 $B daemon start main.bl > daemon.log 2>&1 &); for i in $(seq 1 400); do if [ -S .blink/daemon.sock ]; then cat .blink/daemon.pid; exit 0; fi; sleep 0.05; done; [ -f .blink/daemon.pid ] && kill $(cat .blink/daemon.pid); exit 1")
    if r.exit_code != 0 { return -1 }
    r.out.trim().to_int()
}

fn stop_daemon(pid: Int) {
    let _ = sh("kill {pid}; for i in $(seq 1 100); do kill -0 {pid} 2>/dev/null || exit 0; sleep 0.05; done; kill -9 {pid}")
}

// The router's counts from `daemon status`, from "entries" on.
fn served() -> Str {
    let out = sh("B=$(pwd)/build/blink; cd {DIR} && $B daemon status").out
    match out.byte_index_of("\"entries\":", 0) {
        Some(at) => out.byte_slice(at, out.byte_len()).trim()
        None => "no status: {out}"
    }
}

// The first difference between two results, or "".
fn differ(label: Str, a: ProcessResult, b: ProcessResult) -> Str {
    if a.exit_code != b.exit_code { return "{label}: exit {a.exit_code} vs {b.exit_code}" }
    if a.out != b.out { return "{label}: stdout:\n{a.out}\n-- vs --\n{b.out}" }
    if a.err_out != b.err_out { return "{label}: stderr:\n{a.err_out}\n-- vs --\n{b.err_out}" }
    ""
}

test "check --format json through the daemon prints what a cold check prints, and what --json prints" {
    let _ = sh("rm -rf {DIR}; mkdir -p {DIR}")
    write_file("{DIR}/blink.toml", "[package]\nname = \"daemon_format_json\"\nversion = \"0.1.0\"\n")
    // A lock no older than blink.toml keeps "resolving dependencies..." out of every check here.
    write_file("{DIR}/blink.lock", "[metadata]\nlockfile-version = 1\n")
    let cases = [("ok", ok_src(), "\{\"status\":\"ok\",\"file\":\"main.bl\"}\n"), ("warn", warn_src(), "\{\"status\":\"ok\",\"file\":\"main.bl\"}\n"), ("err", err_src(), "\{\"status\":\"error\",\"file\":\"main.bl\"}\n")]
    let mut cold: List[ProcessResult] = []
    for c in cases {
        let (_, src, _) = c
        write_file("{DIR}/main.bl", src)
        cold.push(check("--format json"))
    }
    let cold_bad = check("--format xyz")

    let pid = start_daemon()
    assert(pid > 0, "the daemon did not start")
    let mut wrong: List[Str] = []
    let mut i = 0
    for c in cases {
        let (name, src, status) = c
        write_file("{DIR}/main.bl", src)
        let warm = check("--format json")
        let warm_json = check("--json")
        let cold_one = cold.get(i).unwrap()
        wrong.push(differ("{name}: daemon --format json vs cold --format json", warm, cold_one))
        wrong.push(differ("{name}: daemon --format json vs daemon --json", warm, warm_json))
        if warm.out != status { wrong.push("{name}: daemon stdout is not `{status}`:\n{warm.out}") }
        i = i + 1
    }
    let warm_bad = check("--format xyz")
    let counts = served()
    stop_daemon(pid)
    let _ = sh("rm -rf {DIR}")

    wrong.push(differ("--format xyz: daemon vs cold", warm_bad, cold_bad))
    if warm_bad.exit_code != 1 || !warm_bad.err_out.contains("error: --format must be json, got 'xyz'") {
        wrong.push("--format xyz with the daemon up: exit {warm_bad.exit_code}\n{warm_bad.err_out}")
    }
    // The daemon answered the checks, not a cold check behind it.
    if !counts.contains("\"checks\":6") { wrong.push("daemon status: {counts}") }
    let found: List[Str] = wrong.filter(fn(w) { w != "" })
    assert_eq(found.join("\n"), "")
}
