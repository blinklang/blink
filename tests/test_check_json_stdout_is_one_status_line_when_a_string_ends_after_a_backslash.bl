// `blink check --json` keeps stdout for its one JSON status line when the source ends inside a
// string just after a backslash. The lexer report goes to stderr with the other diagnostics; on
// stdout it would break every tool that parses the status line. The check still fails.

import std.process.{ProcessResult}
import std.json.{json_clear, json_parse, json_get, json_as_str}

fn sh(cmd: Str) -> ProcessResult {
    process_run("sh", ["-c", cmd])
}

test "check --json stdout holds only the status line when a string ends after a backslash" {
    let dir = sh("mktemp -d /tmp/blink_json_string_backslash.XXXXXX").out.trim()
    write_file("{dir}/main.bl", "fn main() \{\n    let s = \"a\\")
    let r = sh("B=$(pwd)/build/blink; cd {dir} && $B check --json main.bl")
    let _ = sh("rm -rf {dir}")

    assert_eq(r.exit_code, 1)
    assert_eq(r.out.trim().split("\n").len(), 1)
    json_clear()
    let root = json_parse(r.out.trim())
    assert(root >= 0)
    assert_eq(json_as_str(json_get(root, "status")), "error")
    assert(r.err_out.contains("\"code\":\"E1126\""), r.err_out)
}
