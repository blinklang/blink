// `blink check --json` keeps stdout for its one JSON status line when blink.toml sets a lint to a
// level that is not off, warn or error. The InvalidLintLevel error goes to stderr; on stdout it
// would break every tool that parses the status line. The fixture lives under a fresh temporary
// directory, since the test tree itself sits inside a project.

import std.process.{ProcessResult}
import std.json.{json_clear, json_parse, json_get, json_as_str}

fn sh(cmd: Str) -> ProcessResult {
    process_run("sh", ["-c", cmd])
}

test "check --json stdout holds only the status line with an unknown lint level" {
    let dir = sh("mktemp -d /tmp/blink_json_lint_level.XXXXXX").out.trim()
    let _ = sh("mkdir -p {dir}/src")
    write_file("{dir}/blink.toml", "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[lints]\nW0703 = \"loud\"\n")
    // A lock no older than blink.toml keeps dependency resolution out of the check.
    write_file("{dir}/blink.lock", "[metadata]\nlockfile-version = 1\n")
    write_file("{dir}/src/main.bl", "fn main() \{\n    io.println(\"hi\")\n}\n")
    let r = sh("B=$(pwd)/build/blink; cd {dir} && $B check --json src/main.bl")
    let _ = sh("rm -rf {dir}")

    assert_eq(r.exit_code, 1)
    assert_eq(r.out.trim().split("\n").len(), 1)
    json_clear()
    let root = json_parse(r.out.trim())
    assert(root >= 0)
    assert_eq(json_as_str(json_get(root, "status")), "error")
    assert(r.err_out.contains("invalid lint level `loud` for `W0703`"))
}
