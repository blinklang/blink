// `blink check <path>` checks the file it names, daemon or no daemon. The daemon answers only
// for the file it serves, asked from the directory it started in; for any other file the check
// runs cold. The client finds the socket beside the file it checks (`<dir of path>/.blink`),
// which is where `blink daemon start <path>` puts it.

import std.process.{ProcessResult}

let DIR = ".tmp/check_daemon_named_file"

fn sh(cmd: Str) -> ProcessResult {
    process_run("sh", ["-c", cmd])
}

fn clean_src() -> Str {
    "fn main() \{\n    io.println(\"hi\")\n}\n"
}

fn error_src() -> Str {
    "fn main() \{\n    let s: Int = \"no\"\n    io.println(\"\{s}\")\n}\n"
}

// The pid of a daemon started in DIR on `entry`, or -1. `sock_dir` is where its socket goes.
// The timeout ends a daemon that nothing stopped.
fn start_daemon(entry: Str, sock_dir: Str) -> Int {
    let r = sh("B=$(pwd)/build/blink; cd {DIR} && rm -rf {sock_dir}/.blink && (timeout 120 $B daemon start {entry} > daemon.log 2>&1 &); for i in $(seq 1 400); do if [ -S {sock_dir}/.blink/daemon.sock ]; then cat {sock_dir}/.blink/daemon.pid; exit 0; fi; sleep 0.05; done; [ -f {sock_dir}/.blink/daemon.pid ] && kill $(cat {sock_dir}/.blink/daemon.pid); exit 1")
    if r.exit_code != 0 { return -1 }
    r.out.trim().to_int()
}

fn stop_daemon(pid: Int) {
    let _ = sh("kill {pid}; for i in $(seq 1 100); do kill -0 {pid} 2>/dev/null || exit 0; sleep 0.05; done; kill -9 {pid}")
}

fn served_checks(sock_dir: Str) -> Str {
    let out = sh("B=$(pwd)/build/blink; cd {DIR}/{sock_dir} && $B daemon status").out
    match out.byte_index_of("\"checks\":", 0) {
        Some(at) => out.byte_slice(at, out.byte_len()).trim()
        None => "no status: {out}"
    }
}

test "a check of another file in the daemon's directory checks that file" {
    let _ = sh("rm -rf {DIR}; mkdir -p {DIR}")
    write_file("{DIR}/main.bl", clean_src())
    write_file("{DIR}/other.bl", error_src())
    let cold = sh("B=$(pwd)/build/blink; cd {DIR} && $B check other.bl")
    let pid = start_daemon("main.bl", ".")
    let warm = sh("B=$(pwd)/build/blink; cd {DIR} && $B check other.bl")
    let after = served_checks(".")
    if pid > 0 { stop_daemon(pid) }

    assert(pid > 0)
    if warm.out != cold.out || warm.err_out != cold.err_out {
        io.eprintln("cold: {cold.out}{cold.err_out}\nwith a daemon on main.bl: {warm.out}{warm.err_out}")
    }
    assert_eq(cold.exit_code, 1)
    assert(cold.err_out.contains("other.bl:2"))
    assert_eq(warm.exit_code, cold.exit_code)
    assert_eq(warm.out, cold.out)
    assert_eq(warm.err_out, cold.err_out)
    assert_eq(after, "\"checks\":0}")
}

test "a check finds the daemon socket beside the file it names" {
    let _ = sh("rm -rf {DIR}; mkdir -p {DIR}/sub")
    write_file("{DIR}/sub/main.bl", error_src())
    let cold = sh("B=$(pwd)/build/blink; cd {DIR} && $B check sub/main.bl")
    let pid = start_daemon("sub/main.bl", "sub")
    let warm = sh("B=$(pwd)/build/blink; cd {DIR} && $B check sub/main.bl")
    let after = served_checks("sub")
    if pid > 0 { stop_daemon(pid) }

    assert(pid > 0)
    if warm.out != cold.out || warm.err_out != cold.err_out {
        io.eprintln("cold: {cold.out}{cold.err_out}\nthrough the daemon: {warm.out}{warm.err_out}")
    }
    assert_eq(cold.exit_code, 1)
    assert_eq(warm.exit_code, cold.exit_code)
    assert_eq(warm.out, cold.out)
    assert_eq(warm.err_out, cold.err_out)
    assert_eq(after, "\"checks\":1}")
}
