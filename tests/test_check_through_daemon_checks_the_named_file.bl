// `blink check <path>` checks the file it names, daemon or no daemon. The daemon answers for
// any file of the project, the one it started on or another, with what a cold check prints.
// The client finds the project's daemon in .blink/ at the project root (the
// directory holding blink.toml), wherever in the project the file it checks lives.

import std.process.{ProcessResult, ChildEnd}
import compile_test_helpers

let DIR = "{compile_test_helpers.scratch_root()}/check_daemon_named_file"

fn sh(cmd: Str) -> ProcessResult {
    process.run("sh", ["-c", cmd]).unwrap()
}

fn clean_src() -> Str {
    "fn main() \{\n    io.println(\"hi\")\n}\n"
}

fn error_src() -> Str {
    "fn main() \{\n    let s: Int = \"no\"\n    io.println(\"\{s}\")\n}\n"
}

// The pid of a daemon started in DIR on `entry`, or -1. Its socket goes at the project root,
// DIR. The timeout ends a daemon that nothing stopped.
fn start_daemon(entry: Str) -> Int {
    let r = sh("B=$(pwd)/build/blink; cd {DIR} && rm -rf .blink && (timeout 120 $B daemon start {entry} > daemon.log 2>&1 &); for i in $(seq 1 400); do if [ -S .blink/daemon.sock ]; then cat .blink/daemon.pid; exit 0; fi; sleep 0.05; done; [ -f .blink/daemon.pid ] && kill $(cat .blink/daemon.pid); exit 1")
    if !r.success() { return -1 }
    r.out.trim().to_int()
}

fn stop_daemon(pid: Int) {
    let _ = sh("kill {pid}; for i in $(seq 1 100); do kill -0 {pid} 2>/dev/null || exit 0; sleep 0.05; done; kill -9 {pid}")
}

fn served_checks() -> Str {
    let out = sh("B=$(pwd)/build/blink; cd {DIR} && $B daemon status").out
    match out.byte_index_of("\"checks\":", 0) {
        Some(at) => out.byte_slice(at, out.byte_len()).trim()
        None => "no status: {out}"
    }
}

test "a check of another file in the daemon's directory checks that file" {
    let _ = sh("rm -rf {DIR}; mkdir -p {DIR}")
    write_file("{DIR}/blink.toml", "[package]\nname = \"check_named_file\"\nversion = \"0.1.0\"\n")
    // A lock no older than blink.toml keeps "resolving dependencies..." out of every check here.
    write_file("{DIR}/blink.lock", "[metadata]\nlockfile-version = 1\n")
    write_file("{DIR}/main.bl", clean_src())
    write_file("{DIR}/other.bl", error_src())
    let cold = sh("B=$(pwd)/build/blink; cd {DIR} && $B check other.bl")
    let pid = start_daemon("main.bl")
    let warm = sh("B=$(pwd)/build/blink; cd {DIR} && $B check other.bl")
    let after = served_checks()
    if pid > 0 { stop_daemon(pid) }

    assert(pid > 0)
    if warm.out != cold.out || warm.err_out != cold.err_out {
        io.eprintln("cold: {cold.out}{cold.err_out}\nwith a daemon on main.bl: {warm.out}{warm.err_out}")
    }
    assert_eq(cold.end, ChildEnd.Exited(1))
    assert(cold.err_out.contains("other.bl:2"))
    assert_eq(warm.end, cold.end)
    assert_eq(warm.out, cold.out)
    assert_eq(warm.err_out, cold.err_out)
    assert_eq(after, "\"checks\":1}")
}

test "a check of a file in a subdirectory asks the project daemon" {
    let _ = sh("rm -rf {DIR}; mkdir -p {DIR}/sub")
    write_file("{DIR}/blink.toml", "[package]\nname = \"check_named_file\"\nversion = \"0.1.0\"\n")
    write_file("{DIR}/blink.lock", "[metadata]\nlockfile-version = 1\n")
    write_file("{DIR}/sub/main.bl", error_src())
    let cold = sh("B=$(pwd)/build/blink; cd {DIR} && $B check sub/main.bl")
    let pid = start_daemon("sub/main.bl")
    let warm = sh("B=$(pwd)/build/blink; cd {DIR} && $B check sub/main.bl")
    let after = served_checks()
    if pid > 0 { stop_daemon(pid) }

    assert(pid > 0)
    if warm.out != cold.out || warm.err_out != cold.err_out {
        io.eprintln("cold: {cold.out}{cold.err_out}\nthrough the daemon: {warm.out}{warm.err_out}")
    }
    assert_eq(cold.end, ChildEnd.Exited(1))
    assert_eq(warm.end, cold.end)
    assert_eq(warm.out, cold.out)
    assert_eq(warm.err_out, cold.err_out)
    assert_eq(after, "\"checks\":1}")
}
