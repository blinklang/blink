// A lexer error reads the same with or without a daemon: through the daemon `blink check` prints
// the same bytes on stdout and stderr, and exits with the same code, as a cold check, for a bad
// escape, a bad char literal and a string left open at the end of the file. A clean check after
// them shows that nothing from those checks stays in the daemon.

import std.process.{ProcessResult}
import compile_test_helpers

let DIR = "{compile_test_helpers.scratch_root()}/check_daemon_lexer_error"

fn sh(cmd: Str) -> ProcessResult {
    process.run("sh", ["-c", cmd]).unwrap()
}

fn clean_src() -> Str {
    "fn main() \{\n    let s = \"a\"\n    io.println(s)\n}\n"
}

fn escape_src() -> Str {
    ["fn main() \{", #"    let s = "a\qb""#, "    io.println(s)", "}", ""].join("\n")
}

fn char_src() -> Str {
    ["fn main() \{", #"    let c = 'ab'"#, #"    io.println("{c.to_int()}")"#, "}", ""].join("\n")
}

fn unclosed_src() -> Str {
    ["fn main() \{", #"    let s = "abc"#, "    let n = 1", "}", ""].join("\n")
}

fn check(flag: Str) -> ProcessResult {
    sh("B=$(pwd)/build/blink; cd {DIR} && $B check {flag} main.bl")
}

// The pid of a daemon serving main.bl, or -1. The timeout ends a daemon that nothing stopped.
fn start_daemon() -> Int {
    let r = sh("B=$(pwd)/build/blink; cd {DIR} && rm -rf .blink && (timeout 120 $B daemon start main.bl > daemon.log 2>&1 &); for i in $(seq 1 400); do if [ -S .blink/daemon.sock ]; then cat .blink/daemon.pid; exit 0; fi; sleep 0.05; done; [ -f .blink/daemon.pid ] && kill $(cat .blink/daemon.pid); exit 1")
    if r.exit_code != 0 { return -1 }
    r.out.trim().to_int()
}

fn stop_daemon(pid: Int) {
    let _ = sh("kill {pid}; for i in $(seq 1 100); do kill -0 {pid} 2>/dev/null || exit 0; sleep 0.05; done; kill -9 {pid}")
}

fn served_checks() -> Str {
    let out = sh("B=$(pwd)/build/blink; cd {DIR} && $B daemon status").out
    match out.byte_index_of("\"checks\":", 0) {
        Some(at) => out.byte_slice(at, out.byte_len()).trim()
        None => "no status: {out}"
    }
}

fn same(label: Str, cold: ProcessResult, warm: ProcessResult) -> Bool {
    let ok = cold.out == warm.out && cold.err_out == warm.err_out && cold.exit_code == warm.exit_code
    if !ok {
        io.eprintln("{label} cold (exit {cold.exit_code}):\n{cold.out}\n--stderr--\n{cold.err_out}")
        io.eprintln("{label} daemon (exit {warm.exit_code}):\n{warm.out}\n--stderr--\n{warm.err_out}")
    }
    ok
}

test "check through the daemon prints a lexer error like a cold check" {
    let _ = sh("rm -rf {DIR}; mkdir -p {DIR}")
    write_file("{DIR}/blink.toml", "[package]\nname = \"check_daemon_lexer\"\nversion = \"0.1.0\"\n")
    // A lock no older than blink.toml keeps "resolving dependencies..." out of every check here.
    write_file("{DIR}/blink.lock", "[metadata]\nlockfile-version = 1\n")
    write_file("{DIR}/main.bl", escape_src())
    let cold_escape = check("")
    let cold_escape_json = check("--json")
    write_file("{DIR}/main.bl", char_src())
    let cold_char = check("")
    write_file("{DIR}/main.bl", unclosed_src())
    let cold_unclosed = check("")
    let cold_unclosed_json = check("--json")
    write_file("{DIR}/main.bl", clean_src())
    let cold_clean = check("")

    write_file("{DIR}/main.bl", escape_src())
    let pid = start_daemon()
    let warm_escape = check("")
    let warm_escape_json = check("--json")
    write_file("{DIR}/main.bl", char_src())
    let warm_char = check("")
    write_file("{DIR}/main.bl", unclosed_src())
    let warm_unclosed = check("")
    let warm_unclosed_json = check("--json")
    write_file("{DIR}/main.bl", clean_src())
    let warm_clean = check("")
    let after = served_checks()
    if pid > 0 { stop_daemon(pid) }

    assert(pid > 0)
    assert_eq(cold_escape.exit_code, 1)
    assert(cold_escape.err_out.contains("error[UnknownEscape]"), cold_escape.err_out)
    assert(cold_char.err_out.contains("error[MultiCharLiteral]"), cold_char.err_out)
    assert(cold_unclosed.err_out.contains("error[UnterminatedLiteral]"), cold_unclosed.err_out)
    assert(cold_unclosed_json.err_out.contains("\"code\":\"E1126\""), cold_unclosed_json.err_out)
    assert_eq(cold_clean.exit_code, 0)
    assert(same("escape", cold_escape, warm_escape))
    assert(same("escape json", cold_escape_json, warm_escape_json))
    assert(same("char", cold_char, warm_char))
    assert(same("unclosed", cold_unclosed, warm_unclosed))
    assert(same("unclosed json", cold_unclosed_json, warm_unclosed_json))
    assert(same("clean", cold_clean, warm_clean))
    // Each of the six checks above is the daemon's own, not a cold check behind it.
    assert_eq(after, "\"checks\":6}")
}
