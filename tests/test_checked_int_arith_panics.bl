// sections/03_types.md:781: "Arithmetic overflow is checked by default. An operation that
// exceeds the type's range panics at runtime with a descriptive message." The table above it
// puts Int in the same family as the sized types, so plain Int is checked too.
//
// These rows run the operators and read what the panic says. The message form is the one
// the spec shows at :785, "U8 overflow in addition (255 + 1)", with the type, the operation
// and both operands.

import std.io
import compile_test_helpers

let mut arith_calls = 0

fn counted(v: Int) -> Int {
    arith_calls = arith_calls + 1
    v
}

test "U8 addition past its maximum panics with the type, operation and operands" {
    assert_panics(matching: "U8 overflow in addition (255 + 1)") {
        let m: U8 = 255
        let _ = m + 1
    }
}

test "I8 subtraction past its minimum panics" {
    assert_panics(matching: "I8 overflow in subtraction (-128 - 1)") {
        let m: I8 = -128
        let _ = m - 1
    }
}

test "I32 multiplication past its range panics" {
    assert_panics(matching: "I32 overflow in multiplication (65536 * 65536)") {
        let m: I32 = 65536
        let _ = m * m
    }
}

test "U64 subtraction below zero panics" {
    assert_panics(matching: "U64 overflow in subtraction (0 - 1)") {
        let z: U64 = 0
        let _ = z - 1
    }
}

test "plain Int addition past its maximum panics" {
    assert_panics(matching: "Int overflow in addition (9223372036854775807 + 1)") {
        let m = 9223372036854775807
        let _ = m + 1
    }
}

test "a compound addition is checked like the operator" {
    assert_panics(matching: "U8 overflow in addition (250 + 10)") {
        let mut b: U8 = 250
        b += 10
    }
}

test "a compound division by zero panics" {
    assert_panics(matching: "Int division by zero") {
        let mut q = 10
        let z = 0
        q /= z
    }
}

test "negating the minimum of a signed type panics" {
    assert_panics(matching: "I8 overflow in negation") {
        let m: I8 = -128
        let _ = -m
    }
}

test "the minimum over a variable -1 panics" {
    assert_panics(matching: "I32 overflow in division (-2147483648 / -1)") {
        let m: I32 = -2147483648
        let d: I32 = -1
        let _ = m / d
    }
}

test "the minimum over a literal -1 panics" {
    assert_panics(matching: "Int overflow in division") {
        let m = -9223372036854775807 - 1
        let _ = m / -1
    }
}

test "a negative literal at the minimum is a value, not a negation" {
    let m: I8 = -128
    let n: I32 = -2147483648
    let k = -9223372036854775807 - 1
    if m + 1 != -127 { io.println("FAIL: I8 minimum reads {m}") }
    assert_eq(m + 1, -127)
    if n + 1 != -2147483647 { io.println("FAIL: I32 minimum reads {n}") }
    assert_eq(n + 1, -2147483647)
    if k + 1 != -9223372036854775807 { io.println("FAIL: Int minimum reads {k}") }
    assert_eq(k + 1, -9223372036854775807)
}

test "arithmetic that reaches each bound exactly does not panic" {
    let a: U8 = 250
    let b: I8 = -127
    let c: I8 = -64
    let d: Int = 9223372036854775806
    assert_eq(a + 5, 255)
    assert_eq(b - 1, -128)
    assert_eq(c * 2, -128)
    assert_eq(d + 1, 9223372036854775807)
    let e: I32 = -2147483647
    assert_eq(-e, 2147483647)
    assert_eq(e / -1, 2147483647)
}

test "each operand of a checked operator runs once" {
    arith_calls = 0
    let s = counted(3) + counted(4)
    let p = counted(5) * counted(6)
    let q = counted(20) / counted(4)
    if arith_calls != 6 { io.println("FAIL: operands ran {arith_calls} times, want 6") }
    assert_eq(arith_calls, 6)
    assert_eq(s, 7)
    assert_eq(p, 30)
    assert_eq(q, 5)
}

fn guard_pick(n: Int) -> Int {
    match n {
        k if k + 1 > 3 => 1
        _ => 0
    }
}

test "a match guard that checks its arithmetic takes both arms" {
    assert_eq(guard_pick(5), 1)
    assert_eq(guard_pick(1), 0)
}

fn src_global_overflow() -> Str {
    #"let A: U8 = 255
let B: U8 = A + 1

fn main() {
    io.println("B={B}")
}
"#
}

fn src_global_in_range() -> Str {
    #"let A: U8 = 200
let B: U8 = A + 1

fn main() {
    io.println("B={B}")
}
"#
}

test "a module-scope initializer that overflows panics before main runs" {
    let r = compile_test_helpers.compile_and_run(src_global_overflow(), "checked_arith_global_ovf")
    let said = "{r.out}{r.err_out}"
    if !said.contains("U8 overflow in addition (255 + 1)") { io.println("FAIL: global init said: {said}") }
    assert(said.contains("U8 overflow in addition (255 + 1)"))
    assert(r.exit_code != 0)
    assert(!said.contains("B="))
}

test "a module-scope initializer in range takes its value" {
    let r = compile_test_helpers.compile_and_run(src_global_in_range(), "checked_arith_global_ok")
    if r.exit_code != 0 { io.println("FAIL: exit {r.exit_code}: {r.err_out}") }
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("B=201"))
}

fn src_located() -> Str {
    #"fn main() {
    let m: I16 = 32767
    let n = m + 1
    io.println("n={n}")
}
"#
}

test "the overflow panic names the file and line of the operator" {
    let r = compile_test_helpers.compile_and_run(src_located(), "checked_arith_located")
    let said = "{r.out}{r.err_out}"
    if !said.contains("panic: I16 overflow in addition (32767 + 1) at ") { io.println("FAIL: said: {said}") }
    assert(said.contains("panic: I16 overflow in addition (32767 + 1) at "))
    if !said.contains("checked_arith_located.bl:3") { io.println("FAIL: no location in: {said}") }
    assert(said.contains("checked_arith_located.bl:3"))
    assert(r.exit_code != 0)
}
