// A ChildEnd displays as `exit N`, `signal <name>` or `limit <kind>`.

import std.process.{ChildEnd, LimitKind, SIGKILL, SIGSEGV}

test "an exit displays as exit and the code" {
    assert_eq("{ChildEnd.Exited(0)}", "exit 0")
    assert_eq("{ChildEnd.Exited(3)}", "exit 3")
}

test "a signal displays as signal and the signal name" {
    assert_eq("{ChildEnd.Signaled(SIGKILL)}", "signal SIGKILL")
    assert_eq("{ChildEnd.Signaled(SIGSEGV)}", "signal SIGSEGV")
}

test "a signal with no name displays as signal and SIG with the number" {
    assert_eq("{ChildEnd.Signaled(34)}", "signal SIG34")
}

test "each limit displays as limit and the kind in lower case" {
    assert_eq("{ChildEnd.Limit(LimitKind.Timeout)}", "limit timeout")
    assert_eq("{ChildEnd.Limit(LimitKind.Memory)}", "limit memory")
    assert_eq("{ChildEnd.Limit(LimitKind.Processes)}", "limit processes")
}

test "the end of a real run displays the same way" {
    let r = process.run("sh", ["-c", "exit 5"])?
    assert_eq(r.end.display(), "exit 5")
}
