// `Child` has no `kill` or `send_signal` method: a signal goes through the handle,
// `process.signal(child, sig)` (sections/04_effects.md, rows for methods of `Child`). The
// released `kill` took the signal 0 to mean SIGKILL, so a literal 0 names SIGKILL, any other
// literal stays, and an argument that is not a literal gets a suggestion that warns about 0.
import lower_test_helpers.{probe_but, assert_eq_str}
import diagnostics.{diag_entries}

// The one UnresolvedMethod the probe reports, as "message | help", or why there is not one.
fn unresolved() -> Str {
    let mut out: List[Str] = []
    for d in diag_entries {
        if d.name == "UnresolvedMethod" {
            out.push("{d.message} | {d.help}")
        }
    }
    if out.len() == 1 { out.get(0).unwrap() } else { "{out.len()} UnresolvedMethod reports: {out.join(\"; \")}" }
}

fn probe_call(tag: Str, call: Str) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck, Env.Exit, Env.Read, FS.Read, FS.Write, IO {
    let _p = probe_but(tag, "import std.process.\{Child}\n\nfn stop(child: Child, sig: Int) \{\n    let _r = {call}\n}\n\nfn main() \{}\n", "UnresolvedMethod")
}

test "child.kill(0) names SIGKILL" {
    probe_call("child_kill_zero", "child.kill(0)")
    assert_eq_str("kill(0)", unresolved(), "unresolved method `.kill` on type Child | `kill` was removed; call `process.signal(child, SIGKILL)`, because the signal 0 meant SIGKILL")
}

test "child.kill with another literal keeps the literal" {
    probe_call("child_kill_nine", "child.kill(9)")
    assert_eq_str("kill(9)", unresolved(), "unresolved method `.kill` on type Child | `kill` was removed; call `process.signal(child, 9)`")
}

test "child.kill with a non-literal argument is a suggestion that warns about 0" {
    probe_call("child_kill_var", "child.kill(sig)")
    assert_eq_str("kill(sig)", unresolved(), "unresolved method `.kill` on type Child | `kill` was removed; call `process.signal(child, sig)`, and pass SIGKILL where the argument can be 0, because the signal 0 meant SIGKILL")
}

test "child.send_signal points at process.signal" {
    probe_call("child_send_signal", "child.send_signal(sig)")
    assert_eq_str("send_signal", unresolved(), "unresolved method `.send_signal` on type Child | `send_signal` was removed; call `process.signal(child, sig)`")
}

test "a user type named Child gets no removed-method row" {
    let _p = probe_but("child_user_type", "type Child \{\n    n: Int\n}\n\nfn stop(child: Child) \{\n    let _r = child.kill(0)\n}\n\nfn main() \{}\n", "UnresolvedMethod")
    assert_eq_str("user Child", unresolved(), "unresolved method `.kill` on type Child | ")
}
