// End-to-end CLI workflow: blink init → create git lib → blink add --git → build → run
// Tests the full package management user journey through the CLI.

import compile_test_helpers

fn trim_newlines(s: Str) -> Str {
    let mut end = s.byte_len()
    while end > 0 {
        let ch = s.byte_at(end - 1)
        if ch == 10 || ch == 13 {
            end = end - 1
        } else {
            return s.byte_slice(0, end)
        }
    }
    ""
}

fn main() {
    let base = "{compile_test_helpers.scratch_root()}/_test_cli_pkg"
    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
    process.run("sh", ["-c", "rm -rf ~/.blink/cache/git/*_test_cli_pkg_*"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {base}"]).unwrap()

    // Step 1: Create a git library
    process.run("sh", ["-c", "mkdir -p {base}/mathlib/src"]).unwrap()
    fs.write("{base}/mathlib/blink.toml", "[package]\nname = \"mathlib\"\nversion = \"0.1.0\"\n\n[dependencies]\n").unwrap()
    fs.write("{base}/mathlib/src/mathlib.bl", "pub fn add(a: Int, b: Int) -> Int \{\n    a + b\n\}\n").unwrap()
    process.run("sh", ["-c", "cd {base}/mathlib && git init && git add -A && git commit -m 'init' > /dev/null 2>&1"]).unwrap()
    process.run("sh", ["-c", "cd {base}/mathlib && git tag v0.1.0"]).unwrap()

    let abs_result = process.run("sh", ["-c", "cd {base}/mathlib && pwd -P"]).unwrap()
    let lib_path = trim_newlines(abs_result.out)
    let git_url = "file://{lib_path}"

    // Get absolute path to blink binary
    let blink_abs = process.run("sh", ["-c", "pwd -P"]).unwrap()
    let blink_root = trim_newlines(blink_abs.out)

    // Step 2: Create a consumer project using blink init
    // blink init creates files in CWD, so make a subdir first
    let proj = "{base}/myapp"
    process.run("sh", ["-c", "mkdir -p {proj}"]).unwrap()
    let init_result = process.run("sh", ["-c", "cd {proj} && {blink_root}/build/blink init myapp 2>&1"]).unwrap()
    if !init_result.success() {
        io.println("FAIL: blink init failed: {init_result.out}")
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        return
    }
    io.println("PASS: blink init created project")

    if !compile_test_helpers.path_exists("{proj}/blink.toml") && !compile_test_helpers.path_exists("{proj}/blink.toml") {
        io.println("FAIL: blink init did not create blink.toml")
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        return
    }
    if !compile_test_helpers.path_exists("{proj}/src/main.bl") {
        io.println("FAIL: blink init did not create src/main.bl")
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        return
    }

    // Step 3: Add git dependency
    let add_result = process.run("sh", ["-c", "cd {proj} && {blink_root}/build/blink add mathlib --git {git_url} --tag v0.1.0 2>&1"]).unwrap()
    if add_result.out.starts_with("error") {
        io.println("FAIL: blink add failed: {add_result.out}")
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        return
    }
    io.println("PASS: blink add --git succeeded")

    if !compile_test_helpers.path_exists("{proj}/blink.lock") && !compile_test_helpers.path_exists("{proj}/blink.lock") {
        io.println("FAIL: blink add did not create lock file")
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        return
    }
    io.println("PASS: lock file created")

    // Step 4: Write main.bl that uses the dependency
    fs.write("{proj}/src/main.bl", "import mathlib.\{add\}\n\nfn main() \{\n    if add(2, 3) == 5 \{\n        io.println(\"correct\")\n    \} else \{\n        io.println(\"wrong\")\n    \}\n\}\n").unwrap()

    // Step 5: Build using blink build
    let build_result = process.run("sh", ["-c", "cd {proj} && {blink_root}/build/blink build src/main.bl 2>&1"]).unwrap()
    if !build_result.success() {
        io.println("FAIL: blink build failed: {build_result.out}")
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        return
    }
    io.println("PASS: blink build succeeded")

    // Step 6: Run the built binary
    let run_result = process.run("sh", ["-c", "cd {proj} && ./build/main 2>&1"]).unwrap()
    let output = trim_newlines(run_result.out)
    if output == "correct" {
        io.println("PASS: built binary produced correct output")
    } else {
        io.println("FAIL: expected 'correct', got: '{output}'")
    }

    // Cleanup
    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
}
