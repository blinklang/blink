// `blink run` finds a bad trace filter before it builds the program (§8.15.12). It is a usage
// error: text on stderr, nothing on stdout, exit code 2, and no binary. Only `--trace` builds
// traced, so `blink run` checks an inherited `BLINK_TRACE` only through the flag, which
// replaces it; with no flag it builds untraced and gives a note (§8.15.13). The check of
// `blink run` and the check of the traced binary must agree on each value, so a value that
// `blink run` lets through never stops the program it starts.

import compile_test_helpers
import std.process.{ProcessResult, ChildEnd}

let SRC = #"fn add(a: Int, b: Int) -> Int { a + b }
fn main() {
    let mut total = 0
    total = add(1, 2)
    io.println(total)
}
"#

let BAD = [
    "nope:1", "fn:", "fn: + ", "depth:x", "depth:2x", "depth:", "event:stat",
    "event:enter+stat", "1", "fn", "depth : 2", "Fn:add", "fn:add,bogus",
    "all,fn:add", "fn:add,all", "all,fn:add,all", "depth:-1", "depth:+3",
    "depth:99999999999999999999", "modul:x",
]

let GOOD = [
    "all", "fn:add", " fn:add , depth:2 ", "fn:add+main", "fn:add,,", "event:enter+exit",
    "event:state", "event:effect", "event:note", "effect:IO", "state:total", "depth:0",
    "all,", "all,all", "depth:03",
]

fn write_src(stem: Str) -> Str ! FS.Write, Process.Spawn, Env.Read {
    let path = "{compile_test_helpers.scratch_root()}/{stem}.bl"
    fs.write(path, SRC).unwrap()
    path
}

fn bin_of(stem: Str) -> Str ! Process.Spawn, Env.Read {
    "{compile_test_helpers.scratch_root()}/{stem}_bin"
}

// A build also writes `<bin>.c` and the directory `<bin>.units`.
fn clean(path: Str, bin: Str) ! Process.Spawn {
    compile_test_helpers.sh("rm -rf {path} {bin} {bin}.c {bin}.units")
}

fn exists(path: Str) -> Bool ! Process.Spawn {
    compile_test_helpers.sh("test -e {path} && echo yes") == "yes"
}

// What is wrong with the result of a run that a bad filter stopped, or "".
fn usage_error_for(r: ProcessResult, bin: Str, prefix: Str) -> Str ! Process.Spawn {
    if r.end != ChildEnd.Exited(2) { return "ended with {r.end}, not 2:\n{r.err_out}" }
    if r.out != "" { return "printed on stdout:\n{r.out}" }
    if !r.err_out.starts_with(prefix) { return "stderr does not start with `{prefix}`:\n{r.err_out}" }
    if exists(bin) { return "built {bin}" }
    ""
}

test "run stops on a bad --trace filter before it builds" {
    let stem = "trace_run_bad_flag"
    let path = write_src(stem)
    let bin = bin_of(stem)
    for value in BAD {
        let r = process.run("build/blink", ["run", "--trace={value}", path, "-o", bin]).unwrap()
        let prefix = "error: bad --trace value \"{value}\": "
        assert_eq("`{value}`: {usage_error_for(r, bin, prefix)}", "`{value}`: ")
    }
    clean(path, bin)
}

// The lines of stderr that are notes.
fn notes(err_out: Str) -> List[Str] {
    err_out.split("\n").filter(fn(l: Str) -> Bool { l.starts_with("note: ") })
}

test "run with BLINK_TRACE set and no --trace builds untraced, says so in a note and prints 3" {
    let stem = "trace_run_env_only"
    let path = write_src(stem)
    let bin = bin_of(stem)
    for value in ["fn:add", "all", " fn:add , ", "event:stat", "depth:-1", "all,fn:add"] {
        let r = process.run("env", ["BLINK_TRACE={value}", "build/blink", "run", path, "-o", bin]).unwrap()
        assert_eq("`{value}`: {r.end} {r.out}", "`{value}`: {ChildEnd.Exited(0)} 3\n")
        assert(!r.err_out.contains("\"event\""), "`{value}` wrote a trace event:\n{r.err_out}")
        let lines = notes(r.err_out)
        assert_eq(lines.len(), 1, "`{value}`:\n{r.err_out}")
        assert(lines.get(0).unwrap().contains("BLINK_TRACE"))
        assert(lines.get(0).unwrap().contains("--trace"))
    }
    clean(path, bin)
}

test "run gives no note when BLINK_TRACE has no items or the command has --trace" {
    let stem = "trace_run_env_no_note"
    let path = write_src(stem)
    let bin = bin_of(stem)
    let unset = process.run("env", ["-u", "BLINK_TRACE", "build/blink", "run", path, "-o", bin]).unwrap()
    assert_eq(unset.out, "3\n")
    assert_eq(notes(unset.err_out).len(), 0)
    for value in ["", " , ", "\t,,"] {
        let r = process.run("env", ["BLINK_TRACE={value}", "build/blink", "run", path, "-o", bin]).unwrap()
        assert_eq("`{value}`: {r.out}", "`{value}`: 3\n")
        assert_eq(notes(r.err_out).len(), 0, "`{value}`:\n{r.err_out}")
        assert(!r.err_out.contains("\"event\""))
    }
    let flagged = process.run("env", ["BLINK_TRACE=fn:add", "build/blink", "run", "--trace", path, "-o", bin]).unwrap()
    assert_eq(flagged.out, "3\n")
    assert_eq(notes(flagged.err_out).len(), 0)
    clean(path, bin)
}

test "run --trace replaces a bad BLINK_TRACE, so the shell value is not checked" {
    let stem = "trace_run_bad_env_replaced"
    let path = write_src(stem)
    let bin = bin_of(stem)
    let r = process.run("env", ["BLINK_TRACE=event:stat", "build/blink", "run", "--trace=fn:add", path, "-o", bin]).unwrap()
    assert_eq(r.out, "3\n")
    assert(r.success())
    assert(r.err_out.contains("\"event\":\"enter\",\"fn\":\"{stem}.add\""))
    clean(path, bin)
}

test "run and the traced binary give the same reason for each bad filter" {
    let stem = "trace_run_bad_same"
    let path = write_src(stem)
    let bin = bin_of(stem)
    let built = process.run("build/blink", ["build", "--trace", path, "-o", bin]).unwrap()
    assert(built.success())
    let other = bin_of("trace_run_bad_same_run")
    for value in BAD {
        let ran = process.run("env", ["BLINK_TRACE={value}", bin]).unwrap()
        assert_eq(ran.end, ChildEnd.Exited(2))
        let run = process.run("build/blink", ["run", "--trace={value}", path, "-o", other]).unwrap()
        assert_eq(run.end, ChildEnd.Exited(2))
        let binary_why = ran.err_out.replace("error: bad BLINK_TRACE value \"{value}\": ", "")
        let run_why = run.err_out.replace("error: bad --trace value \"{value}\": ", "")
        assert_eq(run_why, binary_why)
    }
    clean(path, bin)
    clean(path, other)
}

test "run lets each good filter through, as the traced binary does" {
    let stem = "trace_run_good"
    let path = write_src(stem)
    let bin = bin_of(stem)
    for value in GOOD {
        let r = process.run("build/blink", ["run", "--trace={value}", path, "-o", bin]).unwrap()
        assert_eq("`{value}`: {r.end == ChildEnd.Exited(0)} {r.out}", "`{value}`: true 3\n")
        let again = process.run("env", ["BLINK_TRACE={value}", bin]).unwrap()
        assert_eq("`{value}`: {again.end == ChildEnd.Exited(0)} {again.out}", "`{value}`: true 3\n")
    }
    clean(path, bin)
}

test "run names --trace and the whole value in the text of a bad filter" {
    let stem = "trace_run_bad_words"
    let path = write_src(stem)
    let bin = bin_of(stem)
    let r = process.run("build/blink", ["run", "--trace=depth:-1", path, "-o", bin]).unwrap()
    assert_eq(r.err_out, "error: bad --trace value \"depth:-1\": depth takes digits only\n")
    let big = process.run("build/blink", ["run", "--trace=depth:99999999999999999999", path, "-o", bin]).unwrap()
    assert_eq(big.err_out, "error: bad --trace value \"depth:99999999999999999999\": depth takes digits only, and the number must fit in Int\n")
    let mixed = process.run("build/blink", ["run", "--trace=fn:add,all", path, "-o", bin]).unwrap()
    assert_eq(mixed.err_out, "error: bad --trace value \"fn:add,all\": `all` cannot be used with another filter\n")
    let typo = process.run("build/blink", ["run", "--trace=event:stat", path, "-o", bin]).unwrap()
    assert_eq(typo.err_out, "error: bad --trace value \"event:stat\": unknown event type `stat`; did you mean `state`?\n")
    clean(path, bin)
}

test "run --trace=all,all and an empty --trace= write every event of main and add" {
    let stem = "trace_run_every_event"
    let path = write_src(stem)
    let bin = bin_of(stem)
    for flag in ["--trace=all,all", "--trace=", "--trace= , "] {
        let r = process.run("build/blink", ["run", flag, path, "-o", bin]).unwrap()
        assert_eq("`{flag}`: {r.end == ChildEnd.Exited(0)} {r.out}", "`{flag}`: true 3\n")
        assert_eq(compile_test_helpers.trace_enter_fns(r.err_out), "{stem}.main {stem}.add")
    }
    clean(path, bin)
}

test "run --help says that only --trace builds the program traced" {
    let r = process.run("build/blink", ["run", "--help"]).unwrap()
    assert(r.out.contains("Only --trace builds the program traced"), r.out)
}
