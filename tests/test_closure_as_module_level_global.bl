// A closure literal used as a module-level (top-level `let`) global's
// initializer must typecheck and compile the same as a closure bound inside a
// function body. Today no pipeline stage handles it: typecheck ICEs with
// error[NodeCarriesNoType] on the closure's own Param/IntLit/Ident nodes, even
// when main never reads the global. Behind that ICE, codegen also emits the
// global initializer at file scope ABOVE the lifted closure body and its
// promote thunk (`__closure_0 undeclared`).

import compile_test_helpers.{compile_and_run}

test.failing(
    "a closure literal bound to a module-level global compiles and runs",
    reason: "a closure literal used as a top-level let's initializer is not typechecked as a closure (ICE NodeCarriesNoType on its Param/IntLit/Ident nodes); the same closure bound inside a function body compiles and runs correctly",
    ticket: "s0te0t",
) {
    let src = #"
import std.io
let g = fn(n: Int) -> Int { n + 1 }
fn main() {
    let f = g
    io.println("{f(41)}")
}
"#
    let r = compile_and_run(src, "_closure_as_module_level_global")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "42\n")
}
