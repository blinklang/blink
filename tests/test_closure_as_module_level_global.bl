// A closure literal used as a module-level (top-level `let`) global's
// initializer typechecks and compiles the same as a closure bound inside a
// function body: its body is walked as any initializer's is, and the global is
// set after the lifted closure it reads is declared.

import compile_test_helpers.{compile_and_run}

test "a closure literal bound to a module-level global compiles and runs" {
    let src = #"
import std.io
let g = fn(n: Int) -> Int { n + 1 }
fn main() {
    let f = g
    io.println("{f(41)}")
}
"#
    let r = compile_and_run(src, "_closure_as_module_level_global")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "42\n")
}
