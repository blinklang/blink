// A closure's body is typechecked wherever the closure is written. A list spread and the
// arguments of `channel.new[T](..)` are value positions like any other, but the walk that
// reaches nested closure bodies did not descend into them, so a body there was never checked
// and its return type was never settled.

import compile_test_helpers

test "a closure body inside a list spread is typechecked" {
    let out = compile_test_helpers.compile_and_capture(#"
fn main() {
    let n = 1
    let xs = [..[fn() {
        let s: Str = 5
        n
    }]]
    assert_eq(xs.len(), 1)
}
"#, "_spread_closure_body")
    compile_test_helpers.expect_contains(out, "variable `s`: declared type Str but got Int", "spread: the body's let is checked")
}

test "a closure body inside a channel buffer argument is typechecked" {
    let out = compile_test_helpers.compile_and_capture(#"
fn main() {
    let n = 1
    async.scope {
        let ch = channel.new[Int](buffer: async.spawn(fn() {
            let t: Str = 6
            n
        }).await)
        ch.send(1)
    }
}
"#, "_channel_buffer_closure_body")
    compile_test_helpers.expect_contains(out, "variable `t`: declared type Str but got Int", "channel buffer: the body's let is checked")
}

test "closures in a spread and a channel buffer compile and return their body values" {
    let out = compile_test_helpers.compile_and_capture(#"
fn main() {
    let n = 2
    async.scope {
        let hs = [..[async.spawn(fn() { n })]]
        assert_eq(hs.len(), 1)
        let ch = channel.new[Int](buffer: async.spawn(fn() { n }).await)
        ch.send(1)
    }
    let fs = [..[fn(i: Int) { i * n }]]
    assert_eq(fs.get(0).unwrap()(4), 8)
}
"#, "_spread_channel_closure_clean")
    compile_test_helpers.expect_compiles_clean(out, "spread and channel buffer closures compile")
    let ice = out.contains("\"severity\":\"ice\"")
    if ice { io.println("FAIL: internal compiler error: {out}") }
    assert(!ice)
}
