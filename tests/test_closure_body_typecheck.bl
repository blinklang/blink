import compile_test_helpers

// ds1f7m — gkr3fs Part B: type-check the BODY of an unannotated closure in List
// HOFs against the container element type. Unannotated params bind to the elem
// (or accumulator) type so a wrong body raises E0300 at typecheck, not at cc.
//
// NOTE: bodies use `-`/`*` rather than `+`. The `+` operator special-cases a Str
// operand as concatenation (typecheck.bl:4863), so `Str + Int` is accepted as
// coercion regardless of closure body checking — tracked separately. `-`/`*` have
// no such carve-out, so they exercise the body walk this feature adds.

// ── RED: wrong unannotated closure bodies must emit E0300 ──────────────

test "List.map unannotated body type mismatch" {
    let src = "fn main() \{ let l: List[Str] = [\"a\"]\n let r = l.map(fn(x) \{ x - 1 }) }\n"
    compile_test_helpers.expect_compile_error(src, "ds1f7m_map_body", "E0300")
}

test "List.for_each statement-position body type mismatch" {
    let src = "fn main() \{ let l: List[Str] = [\"a\"]\n l.for_each(fn(x) \{ let y = x * 2 }) }\n"
    compile_test_helpers.expect_compile_error(src, "ds1f7m_foreach_body", "E0300")
}

test "List.fold unannotated acc body type mismatch" {
    let src = "fn main() \{ let l: List[Int] = [1, 2, 3]\n let r = l.fold(\"s\", fn(acc, x) \{ acc - x }) }\n"
    compile_test_helpers.expect_compile_error(src, "ds1f7m_fold_body", "E0300")
}

// ── GREEN: correct closures (annotated or not) must NOT emit E0300 ─────

test "List.map unannotated correct body compiles" {
    let src = "fn main() \{ let l: List[Int] = [1, 2, 3]\n let r = l.map(fn(x) \{ x + 1 }) }\n"
    compile_test_helpers.expect_no_error(src, "ds1f7m_map_ok", "E0300")
}

test "List.map unannotated Str method body compiles" {
    let src = "fn main() \{ let l: List[Str] = [\"a\"]\n let r = l.map(fn(x) \{ x.len() }) }\n"
    compile_test_helpers.expect_no_error(src, "ds1f7m_map_str_ok", "E0300")
}

test "Nested unannotated closures compile" {
    let src = "fn main() \{ let l: List[Int] = [1, 2, 3]\n let r = l.map(fn(x) \{ let inner = [x]\n inner.map(fn(y) \{ y + 1 }) }) }\n"
    compile_test_helpers.expect_no_error(src, "ds1f7m_nested_ok", "E0300")
}

test "Explicitly-annotated correct closure compiles without double-error" {
    let src = "fn main() \{ let l: List[Int] = [1, 2, 3]\n let r = l.map(fn(x: Int) -> Int \{ x + 1 }) }\n"
    compile_test_helpers.expect_no_error(src, "ds1f7m_annotated_ok", "E0300")
}
