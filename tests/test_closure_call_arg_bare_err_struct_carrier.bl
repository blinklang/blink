// A bare Ok(struct)/Err(struct) passed directly as an argument to a
// closure-typed parameter is emitted without consulting the closure's
// declared parameter type: the Result carrier is inferred as
// blink_Result_int_void (struct side erased to void) instead of the closure's
// declared Result[Bool,Line]. Named-fn call args get arg_type_ann_at
// annotations; closure-call args do not.

import compile_test_helpers.{compile_and_run}

test.failing(
    "a bare Err(struct) passed to a closure-typed param keeps its carrier",
    reason: "a closure-call argument does not consult the closure's declared parameter type when inferring a bare Ok/Err carrier, so a struct Err value infers blink_Result_int_void (the struct side erased to void) instead of the closure's declared blink_Result_bool_Line, causing a C compile error",
    ticket: "068c50",
) {
    let src = #"
import std.io

type Line { a: Int }

fn main() ! IO {
    let cb = fn(r: Result[Bool, Line]) -> Int {
        match r {
            Ok(_) => 0
            Err(l) => l.a
        }
    }
    let out = cb(Err(Line { a: 7 }))
    io.println("{out}")
}
"#
    let r = compile_and_run(src, "_closure_call_arg_bare_err_struct_carrier")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "7\n")
}
