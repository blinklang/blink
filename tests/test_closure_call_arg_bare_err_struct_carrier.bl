// A bare Ok(struct)/Err(struct) passed directly as an argument to a
// closure-typed parameter takes its Result carrier from the closure's
// declared parameter type, Result[Bool, Line], as a named-fn call argument
// does.

import compile_test_helpers.{compile_and_run}

test "a bare Err(struct) passed to a closure-typed param keeps its carrier" {
    let src = #"
import std.io

type Line { a: Int }

fn main() ! IO {
    let cb = fn(r: Result[Bool, Line]) -> Int {
        match r {
            Ok(_) => 0
            Err(l) => l.a
        }
    }
    let out = cb(Err(Line { a: 7 }))
    io.println("{out}")
}
"#
    let r = compile_and_run(src, "_closure_call_arg_bare_err_struct_carrier")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "7\n")
}
