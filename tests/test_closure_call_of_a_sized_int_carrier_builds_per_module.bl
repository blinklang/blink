// A closure call casts the closure's fn pointer to a C function type that names the carrier
// typedef of each parameter and of the result. On the per-module build each unit writes only
// the carriers it asks for, so the cast itself must ask for each one; a carrier of a sized
// integer type that nothing else in the unit names would be left undeclared.

test "counting a list of U8 through its iterator builds and runs" {
    let xs: List[U8] = [1, 2, 3]
    assert_eq(xs.into_iter().count(), 3)
}

test "a closure that returns an Option of I16 builds and runs" {
    let f = fn(x: I16) -> Option[I16] { if x > 0 { Some(x) } else { None } }
    let a: I16 = 4
    assert_eq(f(a).unwrap(), a)
}

test "a closure that returns a Result of U16 builds and runs" {
    let f = fn(x: U16) -> Result[U16, Str] { if x > 0 { Ok(x) } else { Err("zero") } }
    let a: U16 = 7
    assert_eq(f(a).unwrap(), a)
}

test "a closure that returns a tuple of I32 builds and runs" {
    let f = fn(x: I32) -> (I32, I32) { (x, x + 1) }
    let a: I32 = 2
    let (p, q) = f(a)
    assert_eq(p, a)
    assert_eq(q, a + 1)
}

test "a closure that takes an Option of U32 builds and runs" {
    let f = fn(x: Option[U32]) -> Bool { x.is_some() }
    let a: U32 = 9
    assert(f(Some(a)))
}
