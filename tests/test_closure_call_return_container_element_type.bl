// A closure variable's declared container return type (List/Map/Set) must survive
// through the call so the caller can invoke methods on the result, not just the
// scalar/Option shapes.

test "closure returning Map keeps its element types after the call" {
    let c = fn() -> Map[Int, Str] { Map() }
    let m = c()
    assert_eq(m.len(), 0)
}

test "closure returning List keeps its element type after the call" {
    let c = fn() -> List[Int] { [1, 2, 3] }
    let l = c()
    assert_eq(l.len(), 3)
    assert_eq(l.get(1).unwrap(), 2)
}

test "IIFE call returning a container also keeps its element type" {
    let m = fn() -> Map[Int, Str] { Map() }()
    let l = fn() -> List[Int] { [4, 5] }()
    assert_eq(m.len(), 0)
    assert_eq(l.len(), 2)
}
