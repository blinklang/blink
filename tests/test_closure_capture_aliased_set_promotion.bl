// Capturing an aliased Set in a closure must not make closure-capture
// promotion emit a call to a nonexistent blink_promote_Int. A closure that is
// never promoted out of an arena runs correctly, and a closure returned out of
// `with arena { }` keeps its Set after a later arena reuses the memory
// (spec 05 §5.2.1 clause 7: every capture kind that can hold arena memory has
// a walker).

import compile_test_helpers.{compile_and_run}

test "capturing an aliased Set in a closure that is never arena-promoted runs correctly" {
    let src = #"
import std.io
fn main() ! IO {
    let mut s: Set[Int] = Set()
    s.insert(7)
    let alias = s
    let count = fn() -> Int { alias.len() }
    io.println("{count()}")
}
"#
    let r = compile_and_run(src, "_closure_capture_aliased_set_no_promotion")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "1\n")
}

test "returning a closure that captures an aliased Set out of an arena block keeps the Set" {
    let src = #"
import std.io
fn clobber() {
    with arena {
        let mut t: List[Int] = []
        let mut i = 0
        while i < 4000 {
            t.push(-7)
            i = i + 1
        }
    }
}
fn main() ! IO {
    let mut s: Set[Int] = Set()
    s.insert(7)
    let alias = s
    let count = with arena {
        fn() -> Int { alias.len() }
    }
    clobber()
    io.println("{count()}")
}
"#
    let r = compile_and_run(src, "_closure_capture_aliased_set_arena_promotion")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "1\n")
}
