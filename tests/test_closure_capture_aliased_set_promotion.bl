// Capturing an aliased Set in a closure must not make closure-capture
// promotion emit a call to a nonexistent blink_promote_Int. A closure that is
// never promoted out of an arena runs correctly; returning such a closure out
// of `with arena { }` is rejected at compile time with E0702d
// ArenaClosureUnsupportedCapture rather than emitting broken C.

import compile_test_helpers.{compile_and_run, compile_and_capture, expect_error}

test "capturing an aliased Set in a closure that is never arena-promoted runs correctly" {
    let src = #"
import std.io
fn main() ! IO {
    let mut s: Set[Int] = Set()
    s.insert(7)
    let alias = s
    let count = fn() -> Int { alias.len() }
    io.println("{count()}")
}
"#
    let r = compile_and_run(src, "_closure_capture_aliased_set_no_promotion")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "1\n")
}

test "returning a closure that captures an aliased Set out of an arena block is a clean compile error" {
    let src = #"
import std.io
fn main() ! IO {
    let mut s: Set[Int] = Set()
    s.insert(7)
    let alias = s
    let count = with arena {
        fn() -> Int { alias.len() }
    }
    io.println("{count()}")
}
"#
    let out = compile_and_capture(src, "_closure_capture_aliased_set_arena_promotion")
    expect_error(out, "E0702d", "arena-promoting a closure that captures an aliased Set should report ArenaClosureUnsupportedCapture, not emit broken C")
}
