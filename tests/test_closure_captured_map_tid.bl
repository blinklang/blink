// A closure that captures a Map must spell the captured map's key and value kinds
// from the capture-entry tid, with no flat inner1/inner2 snapshot. These rows cover
// the key/value shapes the capture-branch map readers must reproduce — scalar key,
// scalar value, struct value, enum value, tuple value, list value, int key, and an
// untyped Map() whose key/value stay unknown until an insert types them. A tuple value
// is name-carried like a struct: the reader answers CT_VOID via the tid's tuple speller.
// A wrong key or value kind
// mis-spells the insert/get inside the closure body and reads back the wrong value or
// fails to compile.

type CapPt { x: Int, y: Int }
type CapColor { Red, Green, Blue }

test "closure captures Map[Str,Int] and reads a scalar value back" {
    let mut m: Map[Str, Int] = Map()
    m.insert("k", 7)
    let get_val = fn() -> Int {
        m.get("k").unwrap()
    }
    assert_eq(get_val(), 7)
}

test "closure captures Map[Int,Str] with an int key" {
    let mut m: Map[Int, Str] = Map()
    m.insert(3, "three")
    let lookup = fn(k: Int) -> Str {
        m.get(k).unwrap()
    }
    assert_eq(lookup(3), "three")
}

test "closure captures Map[Str,Struct] and reads the struct value" {
    let mut m: Map[Str, CapPt] = Map()
    m.insert("origin", CapPt { x: 1, y: 2 })
    let get_pt = fn() -> CapPt {
        m.get("origin").unwrap()
    }
    let p = get_pt()
    assert_eq(p.x, 1)
    assert_eq(p.y, 2)
}

test "closure captures Map[Str,Enum] and matches the enum value" {
    let mut m: Map[Str, CapColor] = Map()
    m.insert("c", CapColor.Green)
    let get_color = fn() -> CapColor {
        m.get("c").unwrap()
    }
    let ok = match get_color() {
        CapColor.Green => { true }
        _ => { false }
    }
    assert(ok)
}

test "closure captures Map[Str,(Int,Int)] and reads the tuple value" {
    let mut m: Map[Str, (Int, Int)] = Map()
    m.insert("p", (3, 4))
    let get_pt = fn() -> (Int, Int) {
        m.get("p").unwrap()
    }
    let t = get_pt()
    assert_eq(t.0, 3)
    assert_eq(t.1, 4)
}

test "closure captures Map[Str,List[Int]] and reads the list value" {
    let mut m: Map[Str, List[Int]] = Map()
    m.insert("xs", [1, 2, 3])
    let get_xs = fn() -> List[Int] {
        m.get("xs").unwrap()
    }
    let mut total = 0
    for v in get_xs() { total = total + v }
    assert_eq(total, 6)
}

test "closure writes into a captured Map[Str,Int]" {
    let mut m: Map[Str, Int] = Map()
    let setter = fn() {
        m.insert("x", 42)
    }
    setter()
    assert_eq(m.get("x").unwrap(), 42)
}

test "closure captures an untyped Map() typed only by a later insert" {
    let mut m = Map()
    m.insert("k", 9)
    let get_val = fn() -> Int {
        m.get("k").unwrap()
    }
    assert_eq(get_val(), 9)
}
