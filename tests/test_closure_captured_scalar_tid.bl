// A scalar local (String, Bool, Int, Float) set through the generic set_var path is born
// with a canonical tid, not an empty one. A closure that captures such a local snapshots
// its type through the tid-first capture readers, so a wrong or absent tid would mis-spell
// the captured value and read it back corrupted. These rows exercise each scalar kind
// through a capture and assert the value survives the round trip.

test "closure captures a String scalar and reads it back" {
    let greeting = "magnificent"
    let echo = fn() -> Str {
        greeting
    }
    assert(echo() == "magnificent")
}

test "closure captures a Bool scalar and reads it back" {
    let flag = true
    let get = fn() -> Bool {
        flag
    }
    assert(get())
}

test "closure captures Int and Float scalars together" {
    let count = 42
    let ratio = 1.5
    let sum = fn() -> Float {
        count.to_float() + ratio
    }
    assert(sum() == 43.5)
}

test "closure mutates over a captured String scalar" {
    let prefix = "id-"
    let label = fn(n: Int) -> Str {
        prefix.concat(n.to_string())
    }
    assert(label(7) == "id-7")
    assert(label(99) == "id-99")
}
