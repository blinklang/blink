// A closure that captures a Set must reproduce the captured set's element kind on the
// capture-branch set readers. These rows cover a scalar element and a struct element,
// the two shapes those readers must spell. A wrong element kind mis-hashes the
// insert/contains inside the closure body, so a present element reads back as absent
// or the body fails to compile.

@derive(Hash, Eq)
type SetPt { x: Int, y: Int }

test "closure captures Set[Int] and reads membership back" {
    let mut s: Set[Int] = Set()
    s.insert(256)
    s.insert(512)
    let has = fn(n: Int) -> Bool {
        s.contains(n)
    }
    assert(has(256))
    assert(has(512))
    assert(!has(7))
}

test "closure writes into a captured Set[Int]" {
    let mut s: Set[Int] = Set()
    let add = fn(n: Int) {
        s.insert(n)
    }
    add(9)
    add(11)
    assert(s.contains(9))
    assert(s.contains(11))
    assert(!s.contains(9999))
}

test "closure captures Set[SetPt] with a struct element" {
    let mut s: Set[SetPt] = Set()
    s.insert(SetPt { x: 1, y: 2 })
    let has_origin = fn() -> Bool {
        s.contains(SetPt { x: 1, y: 2 })
    }
    assert(has_origin())
    assert(!s.contains(SetPt { x: 9, y: 9 }))
}
