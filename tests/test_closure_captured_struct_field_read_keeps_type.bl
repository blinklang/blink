// A struct captured by value into a closure (no mut, no cell) must keep its declared type
// inside the closure body: reading a scalar field or calling a method on a container field
// must resolve the same way inside the closure as it does outside it.

type Wrap { n: Int }
fn wrap1() -> Wrap { Wrap { n: 1 } }

test "a captured struct's scalar field reads its declared type inside the closure body" {
    let e = wrap1()
    let apply = fn() { let _m = e.n }
    apply()
    assert_eq(e.n, 1)
}

type WrapSet { s: Set[Int] }
fn wrap_set() -> WrapSet { WrapSet { s: Set() } }

test "a captured struct's container field dispatches methods inside the closure body" {
    let e = wrap_set()
    let apply = fn() { let _n = e.s.len() }
    apply()
    e.s.insert(256)
    assert_eq(e.s.len(), 1)
}
