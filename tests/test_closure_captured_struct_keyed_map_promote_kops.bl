// A closure that captures a struct-keyed Map triggers arena promotion of that
// capture. The generated blink_promote_Map_<K>_<V> helper must select the
// struct kops for a CT_STRUCT key the same way the annotation path does.
// Instead it falls through to an undeclared BLINK_COMPILER_BUG_kops_unsupported_K
// sentinel.

import compile_test_helpers.{compile_and_run}

test.failing(
    "a closure capturing a struct-keyed Map promotes with the struct kops, not a compiler-bug sentinel",
    reason: "blink_promote_Map_<K>_<V>'s kops selection has no case for a CT_STRUCT key, so it emits a reference to an undeclared BLINK_COMPILER_BUG_kops_unsupported_K_ct23_ sentinel and declares the key temp void, even though the non-captured annotation path picks the struct kops correctly",
    ticket: "w187xg",
) {
    let src = #"
import std.io

@derive(Hash, Eq)
type CapKey { a: Int, b: Int }

fn main() ! IO {
    let mut m: Map[CapKey, Str] = Map()
    m.insert(CapKey { a: 1, b: 2 }, "hit")
    let lookup = fn() -> Str { m.get(CapKey { a: 1, b: 2 }).unwrap() }
    io.println(lookup())
}
"#
    let r = compile_and_run(src, "_closure_captured_struct_keyed_map_promote_kops")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "hit\n")
}
