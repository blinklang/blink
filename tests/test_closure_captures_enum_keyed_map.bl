// An enum-keyed Map captured into a closure and read inside the closure
// body must select the enum kops correctly, not misread the captured key
// kind as a plain struct.

@derive(Hash, Eq)
type Color { Red, Green, Blue }

fn captured_enum_key() -> Int {
    let mut m: Map[Color, Int] = Map()
    m.insert(Color.Red, 10)
    m.insert(Color.Blue, 32)
    let lookup = fn() -> Int {
        m.get(Color.Red).unwrap() + m.get(Color.Blue).unwrap()
    }
    lookup()
}

test "captured enum-keyed map" {
    assert_eq(captured_enum_key(), 42)
}
