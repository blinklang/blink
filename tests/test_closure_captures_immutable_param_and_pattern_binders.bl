// A parameter and every pattern binder (match payload, match catch-all,
// tuple-destructure, with-resource) never recorded their own mutability at the bind
// site, so a closure capturing one hit CaptureMutabilityNotRecorded even though none
// of them can be reassigned: the language gives none of these forms a `mut` spelling,
// so each is immutable as a matter of syntax, the same as a for-in binder already is.

type Shape {
    Circle(Int)
    Square(Int)
}

type Counter {
    n: Int
}

impl Closeable for Counter {
    fn close(self) {}
}

fn capture_param(x: Int) -> Int {
    let f = fn() -> Int { x }
    f()
}

fn capture_match_payload_binder(s: Shape) -> Int {
    match s {
        Circle(r) => {
            let f = fn() -> Int { r }
            f()
        }
        Square(w) => w
    }
}

fn capture_match_catchall_binder(s: Shape) -> Int {
    match s {
        whole => {
            let f = fn() -> Int {
                match whole { Circle(r) => r  Square(w) => w }
            }
            f()
        }
    }
}

fn capture_tuple_destructure_binder(t: (Int, Int)) -> Int {
    let (a, b) = t
    let f = fn() -> Int { a + b }
    f()
}

fn capture_for_in_tuple_binder(pairs: List[(Int, Int)]) -> Int {
    let mut total = 0
    for (a, b) in pairs {
        let f = fn() -> Int { a + b }
        total = total + f()
    }
    total
}

fn capture_with_resource_binder() -> Int {
    with Counter { n: 5 } as c {
        let f = fn() -> Int { c.n }
        f()
    }
}

test "closure captures a plain fn parameter" {
    assert_eq(capture_param(9), 9)
}

test "closure captures a match payload binder" {
    assert_eq(capture_match_payload_binder(Circle(4)), 4)
}

test "closure captures a match catch-all binder" {
    assert_eq(capture_match_catchall_binder(Square(11)), 11)
}

test "closure captures a tuple-destructure binder" {
    assert_eq(capture_tuple_destructure_binder((2, 3)), 5)
}

test "closure captures a for-in tuple-destructure binder" {
    assert_eq(capture_for_in_tuple_binder([(1, 2), (3, 4)]), 10)
}

test "closure captures a with-resource binder" {
    assert_eq(capture_with_resource_binder(), 5)
}
