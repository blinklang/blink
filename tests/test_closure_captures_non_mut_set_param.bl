// A non-mut Set param captured by a nested closure must promote correctly
// (not fall through to an Int promoter due to an empty capture descriptor).

fn sum_captured(s: Set[Int]) -> Int {
    let g = fn() -> Int {
        let mut t = 0
        for x in s { t = t + x }
        t
    }
    g()
}

test "closure captures non-mut Set param" {
    let mut a = Set()
    a.insert(3)
    a.insert(4)
    assert_eq(sum_captured(a), 7)
}
