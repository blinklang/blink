// A struct field that holds a function is called with the field-call form `(h.cb)(args)`.
// Dot means method (sections/03c_protocols.md §3c.4): `h.cb(args)` is a method call, and a
// field is never a method, so it is UnresolvedMethod (E0505) with help that shows the
// field call. The field's declared type is the call's signature: the return type, the
// arity and every argument type are checked against it, and the message names the field.

import compile_test_helpers

// `type Handler { cb: fn(Int) -> Str }` plus a main that binds one.
fn one_field(body: Str) -> Str {
    let mut s = "type Handler \{ cb: fn(Int) -> Str }\n\n"
    s = s.concat("fn main() \{\n")
    s = s.concat("    let h = Handler \{ cb: fn(n: Int) -> Str \{ \"n=\{n}\" } }\n")
    s = s.concat(body)
    s = s.concat("}\n")
    s
}

// The message names Str, so the call answers the field's declared return type.
test "a closure field's Str return cannot bind to an Int-declared name" {
    let src = one_field("    let bad: Int = (h.cb)(3)\n    io.println(\"bad=\{bad}\")\n")
    let out = compile_test_helpers.compile_and_capture(src, "closure_field_call_signature_ret")
    assert(out.contains("declared type Int but got Str"))
}

test "a closure field on a nested struct receiver is checked" {
    let mut s = "type Inner \{ on_error: fn(Int, Str) -> Str }\n\n"
    s = s.concat("type Outer \{ inner: Inner }\n\n")
    s = s.concat("fn main() \{\n")
    s = s.concat("    let o = Outer \{ inner: Inner \{ on_error: fn(n: Int, m: Str) -> Str \{ \"\{n}:\{m}\" } } }\n")
    s = s.concat("    let bad: Int = (o.inner.on_error)(1, \"x\")\n")
    s = s.concat("    io.println(\"bad=\{bad}\")\n")
    s = s.concat("}\n")
    let out = compile_test_helpers.compile_and_capture(s, "closure_field_call_signature_nested")
    assert(out.contains("declared type Int but got Str"))
}

test "a closure field's struct return is a typed struct receiver" {
    let mut s = "type Box \{ n: Int }\n\n"
    s = s.concat("type Handler \{ cb: fn(Int) -> Box }\n\n")
    s = s.concat("fn main() \{\n")
    s = s.concat("    let h = Handler \{ cb: fn(n: Int) -> Box \{ Box \{ n: n } } }\n")
    s = s.concat("    let b = (h.cb)(3)\n")
    s = s.concat("    let bad: Str = b.n\n")
    s = s.concat("    io.println(\"bad=\{bad}\")\n")
    s = s.concat("}\n")
    let out = compile_test_helpers.compile_and_capture(s, "closure_field_call_signature_struct_ret")
    assert(out.contains("declared type Str but got Int"))
}

test "a closure field's return cannot pass as a mismatched parameter" {
    let mut s = "type Handler \{ cb: fn(Int) -> Str }\n\n"
    s = s.concat("fn want_int(n: Int) -> Int \{ n }\n\n")
    s = s.concat("fn main() \{\n")
    s = s.concat("    let h = Handler \{ cb: fn(n: Int) -> Str \{ \"n=\{n}\" } }\n")
    s = s.concat("    io.println(\"\{want_int((h.cb)(3))}\")\n")
    s = s.concat("}\n")
    compile_test_helpers.expect_compile_error(s, "closure_field_call_signature_argpos", "TypeError")
}

test "a closure field's Str return is a Str receiver for the next call in the chain" {
    let src = one_field("    let hit = (h.cb)(3).starts_with(5)\n    io.println(\"\{hit}\")\n")
    compile_test_helpers.expect_compile_error(src, "closure_field_call_signature_chain", "TypeError")
}

test "too many arguments to a closure field is rejected" {
    let src = one_field("    io.println((h.cb)(3, 4))\n")
    let out = compile_test_helpers.compile_and_capture(src, "closure_field_call_signature_arity_over")
    assert(out.contains("field `Handler.cb` expects 1 argument(s), got 2"))
}

test "too few arguments to a closure field is rejected" {
    let src = one_field("    io.println((h.cb)())\n")
    let out = compile_test_helpers.compile_and_capture(src, "closure_field_call_signature_arity_under")
    assert(out.contains("field `Handler.cb` expects 1 argument(s), got 0"))
}

test "a wrong argument type to a closure field is rejected" {
    let src = one_field("    io.println((h.cb)(\"wrong\"))\n")
    let out = compile_test_helpers.compile_and_capture(src, "closure_field_call_signature_argtype")
    assert(out.contains("field `Handler.cb` argument 0 expects Int, got Str"))
}

test "a closure field call compiles and runs with its declared types" {
    let src = one_field("    let s: Str = (h.cb)(3)\n    io.println(\"got=\{s}|len=\{s.len()}\")\n")
    let r = compile_test_helpers.compile_and_run(src, "closure_field_call_signature_good")
    assert(r.exit_code == 0)
    assert(r.out.contains("got=n=3|len=3"))
}

// `h.cb()` is a method call, so the trait method runs (99), not the field ("n=3").
test "a trait-impl method shadows a same-named closure field in both phases" {
    let mut s = "trait Runner \{\n    fn cb(self) -> Int\n}\n\n"
    s = s.concat("type Handler \{ cb: fn(Int) -> Str }\n\n")
    s = s.concat("impl Runner for Handler \{\n    fn cb(_self) -> Int \{\n        99\n    }\n}\n\n")
    s = s.concat("fn main() \{\n")
    s = s.concat("    let h = Handler \{ cb: fn(n: Int) -> Str \{ \"n=\{n}\" } }\n")
    s = s.concat("    io.println(\"\{h.cb()}\")\n")
    s = s.concat("}\n")
    let r = compile_test_helpers.compile_and_run(s, "closure_field_call_signature_shadow")
    assert(r.exit_code == 0)
    assert(r.out.contains("99"))
}

// A field read into a local, then called, is checked as the direct field call is.
test "a closure field hoisted through a let is still checked" {
    let src = one_field("    let g = h.cb\n    let bad: Int = g(3)\n    io.println(\"bad=\{bad}\")\n")
    let out = compile_test_helpers.compile_and_capture(src, "closure_field_call_signature_hoisted")
    assert(out.contains("declared type Int but got Str"))
}

test "a zero-arg closure field checks its arity and its Void return" {
    let mut good = "type Cleanup \{ action: fn() -> Void }\n\n"
    good = good.concat("fn main() \{\n")
    good = good.concat("    let c = Cleanup \{ action: fn() -> Void \{ io.println(\"ran\") } }\n")
    good = good.concat("    (c.action)()\n")
    good = good.concat("}\n")
    let r = compile_test_helpers.compile_and_run(good, "closure_field_call_signature_void_good")
    assert(r.exit_code == 0)
    assert(r.out.contains("ran"))

    let mut bad = "type Cleanup \{ action: fn() -> Void }\n\n"
    bad = bad.concat("fn main() \{\n")
    bad = bad.concat("    let c = Cleanup \{ action: fn() -> Void \{ io.println(\"ran\") } }\n")
    bad = bad.concat("    (c.action)(1)\n")
    bad = bad.concat("}\n")
    let out = compile_test_helpers.compile_and_capture(bad, "closure_field_call_signature_void_arity")
    assert(out.contains("field `Cleanup.action` expects 0 argument(s), got 1"))
}

// The shape of lib/std/http_server.bl: a handler field reached through another field.
// The bad argument is the second one, so every argument is checked, not only the first.
test "a two-parameter handler field checks both arguments" {
    let mut s = "type ErrorHandler \{ on_error: fn(Int, Str) -> Str }\n\n"
    s = s.concat("type Server \{ error_handler: ErrorHandler }\n\n")
    s = s.concat("fn main() \{\n")
    s = s.concat("    let srv = Server \{ error_handler: ErrorHandler \{ on_error: fn(code: Int, msg: Str) -> Str \{ \"\{code}: \{msg}\" } } }\n")
    s = s.concat("    io.println((srv.error_handler.on_error)(500, true))\n")
    s = s.concat("}\n")
    let out = compile_test_helpers.compile_and_capture(s, "closure_field_call_signature_two_params")
    assert(out.contains("field `ErrorHandler.on_error` argument 1 expects Str, got Bool"))
}

// The dot form of a field call is a method call, and the struct has no method `cb`. The help
// rewrites the call the user wrote into the field-call form.
test "a fn field called with the dot form is an unresolved method" {
    let src = one_field("    io.println(h.cb(3))\n")
    let out = compile_test_helpers.compile_and_capture(src, "closure_field_call_signature_dot_form")
    assert(out.contains("UnresolvedMethod"))
    assert(out.contains("unresolved method `.cb` on type Handler"))
    assert(out.contains("`cb` is a field, not a method; call the field: `(h.cb)(3)`"))
}

test "a fn field reached through another field and called with the dot form is an unresolved method" {
    let mut s = "type ErrorHandler \{ on_error: fn(Int, Str) -> Str }\n\n"
    s = s.concat("type Server \{ error_handler: ErrorHandler }\n\n")
    s = s.concat("fn main() \{\n")
    s = s.concat("    let srv = Server \{ error_handler: ErrorHandler \{ on_error: fn(code: Int, msg: Str) -> Str \{ \"\{code}: \{msg}\" } } }\n")
    s = s.concat("    let m = \"x\"\n")
    s = s.concat("    io.println(srv.error_handler.on_error(500, m))\n")
    s = s.concat("}\n")
    let out = compile_test_helpers.compile_and_capture(s, "closure_field_call_signature_dot_nested")
    assert(out.contains("UnresolvedMethod"))
    assert(out.contains("unresolved method `.on_error` on type ErrorHandler"))
    assert(out.contains("call the field: `(srv.error_handler.on_error)(500, m)`"))
}

// A Void field called with the dot form, as a statement, is also a method call.
test "a zero-arg fn field called with the dot form is an unresolved method" {
    let mut s = "type Cleanup \{ action: fn() -> Void }\n\n"
    s = s.concat("fn main() \{\n")
    s = s.concat("    let c = Cleanup \{ action: fn() -> Void \{ io.println(\"ran\") } }\n")
    s = s.concat("    c.action()\n")
    s = s.concat("}\n")
    let out = compile_test_helpers.compile_and_capture(s, "closure_field_call_signature_dot_void")
    assert(out.contains("UnresolvedMethod"))
    assert(out.contains("unresolved method `.action` on type Cleanup"))
    assert(out.contains("call the field: `(c.action)()`"))
}

// The help spells any receiver as written, not only a path of names.
test "a fn field on a receiver that a call returns, called with the dot form, gets its written receiver in the help" {
    let src = one_field("    io.println(Some(h).unwrap().cb(1 + 2))\n")
    let out = compile_test_helpers.compile_and_capture(src, "closure_field_call_signature_dot_call_receiver")
    assert(out.contains("unresolved method `.cb` on type Handler"))
    assert(out.contains("call the field: `(Some(h).unwrap().cb)(1 + 2)`"))
}

// A call over two lines has no one-line spelling, so the help says it in words and shows no
// stand-in code.
test "a fn field called with the dot form over two lines gets the help in words" {
    let src = one_field("    io.println(h.cb(\n        3))\n")
    let out = compile_test_helpers.compile_and_capture(src, "closure_field_call_signature_dot_two_lines")
    assert(out.contains("unresolved method `.cb` on type Handler"))
    assert(out.contains("`cb` is a field, not a method; wrap the field access in parentheses before the call"))
    assert(!out.contains("(x.cb)"))
}

// A trait method and a fn field of one name: the dot form calls the method and the
// field-call form calls the field, in one program.
test "the dot form calls the method and the field-call form calls the field of one name" {
    let mut s = "trait Runner \{\n    fn cb(self) -> Int\n}\n\n"
    s = s.concat("type Handler \{ cb: fn(Int) -> Str }\n\n")
    s = s.concat("impl Runner for Handler \{\n    fn cb(_self) -> Int \{\n        99\n    }\n}\n\n")
    s = s.concat("fn main() \{\n")
    s = s.concat("    let h = Handler \{ cb: fn(n: Int) -> Str \{ \"n=\{n}\" } }\n")
    s = s.concat("    io.println(\"\{h.cb()}\")\n")
    s = s.concat("    io.println((h.cb)(3))\n")
    s = s.concat("}\n")
    let r = compile_test_helpers.compile_and_run(s, "closure_field_call_signature_both")
    assert(r.exit_code == 0)
    assert_eq(r.out, "99\nn=3\n")
}
