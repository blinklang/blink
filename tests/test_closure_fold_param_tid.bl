// r1c1kv: an unannotated closure param must be typed per-position from the type the
// HOF supplies, not uniformly from the list element type. fold's closure takes
// (accumulator, element): the accumulator is Int here while the element is a struct,
// so a position-blind element hint mistyped the accumulator as the struct and the
// generated C failed to compile (`blink_Pt acc` = int64_t). The closure's Fn tid must
// carry acc:Int, p:Pt per position. (The closure return is annotated here on purpose —
// an unannotated closure return is a separate gap, tracked elsewhere.)

type Pt { x: Int y: Int }

fn sum_x(pts: List[Pt]) -> Int {
    pts.fold(0, fn(acc, p) -> Int { acc + p.x })
}

fn sum_y_via_for_each(pts: List[Pt]) -> Int {
    let mut total = 0
    pts.for_each(fn(p) { total = total + p.y })
    total
}

test "fold accumulator keeps its own type, distinct from the element type" {
    let pts = [Pt { x: 1, y: 2 }, Pt { x: 3, y: 4 }]
    assert_eq(sum_x(pts), 4)
}

test "single-elem HOF (for_each) still types its element param off the same list" {
    let pts = [Pt { x: 0, y: 10 }, Pt { x: 0, y: 5 }]
    assert_eq(sum_y_via_for_each(pts), 15)
}
