// A closure defined inside a generic fn body, whose declared return type is a
// struct parameterized by that fn's own type variable, must monomorphize both the
// closure definition and the call-site to the caller's concrete instance.

import compile_test_helpers.{compile_and_run}

test "closure inside a generic fn returning a typevar-parameterized struct compiles and runs" {
    let src = #"
type Box[T] { v: T }
fn wrap[T](x: T) -> Box[T] {
    let c = fn() -> Box[T] { Box { v: x } }
    c()
}
fn main() ! IO {
    io.println("i={wrap(7).v} s={wrap("a").v}")
}
"#
    let r = compile_and_run(src, "_closure_generic_fn_typevar_struct_return")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "i=7 s=a\n")
}
