// A closure inside a generic fn can spell a carrier that only the instance knows, such as
// Option[Pt]. The C for that carrier has to come before the closure's own function.

type Pt {
    x: Int
}

fn probe_once[T](v: T) -> fn() -> Int {
    let inner = fn() -> Option[T] { Some(v) }
    fn() -> Int {
        match inner() {
            Some(_) => 1
            None => 0
        }
    }
}

fn pair_up[T](v: T) -> fn() -> Result[(Int, T), Str] {
    fn() -> Result[(Int, T), Str] { Ok((1, v)) }
}

test "a closure returning Option of a struct instance" {
    let f = probe_once(Pt { x: 3 })
    assert_eq(f(), 1)
}

test "a closure returning a Result over a tuple instance" {
    let g = pair_up(Pt { x: 7 })
    match g() {
        Ok((n, p)) => {
            assert_eq(n, 1)
            assert_eq(p.x, 7)
        }
        Err(_) => assert(false)
    }
}
