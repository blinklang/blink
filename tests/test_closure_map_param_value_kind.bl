// A closure whose own parameter (not a capture) is a Map must keep the value
// kind of the Map's value type, so a .get() on that param types as
// Option[V], not Option[Int].

type CapPt { x: Int, y: Int }

test "a closure Map param keeps its struct value kind" {
    let getter = fn(mm: Map[Str, CapPt]) -> CapPt { mm.get("origin").unwrap() }
    let mut m: Map[Str, CapPt] = Map()
    m.insert("origin", CapPt { x: 1, y: 2 })
    assert_eq(getter(m).x, 1)
}
