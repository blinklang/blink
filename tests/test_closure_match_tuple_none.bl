// Regression for ymw2w7: a bare `None` in a tuple slot inside a *closure* match
// arm lost its `Option[Cmd]` target type, defaulting to `Option[int]`. Root cause:
// emit_closure never set cg_current_fn_node to the closure node, so emit_tuple_lit's
// parent-ann derivation (which reads the fn return annotation) couldn't see the
// closure's `(Int, Option[Cmd])` annotation and the bare-None slot stayed Option[int].
// `blink check` passed; only the emitted C carried the wrong Option element type, so
// the two arms produced incompatible tuple structs and the program miscompiled.

type Cmd { code: Int }

fn run_update(want_cmd: Bool, body: fn(Bool) -> (Int, Option[Cmd])) -> (Int, Option[Cmd]) {
    body(want_cmd)
}

test "closure match arm with bare None tuple slot keeps Option[Cmd]" {
    let upd = fn(want_cmd: Bool) -> (Int, Option[Cmd]) {
        match want_cmd {
            true => (1, Some(Cmd { code: 42 }))
            false => (0, None)
        }
    }

    let (n0, c0) = upd(false)
    assert_eq(n0, 0)
    assert_eq(c0.is_none(), true)

    let (n1, c1) = upd(true)
    assert_eq(n1, 1)
    assert_eq(c1.is_some(), true)
    assert_eq(c1.unwrap().code, 42)
}

test "closure tuple None slot round-trips through dispatcher" {
    let upd = fn(want_cmd: Bool) -> (Int, Option[Cmd]) {
        match want_cmd {
            true => (1, Some(Cmd { code: 7 }))
            false => (0, None)
        }
    }
    let (n, c) = run_update(true, upd)
    assert_eq(n, 1)
    assert_eq(c.unwrap().code, 7)

    let (n2, c2) = run_update(false, upd)
    assert_eq(n2, 0)
    assert_eq(c2.is_none(), true)
}
