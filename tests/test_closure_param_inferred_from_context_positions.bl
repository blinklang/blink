// An unannotated closure param takes its type from the signature the CONTEXT expects. Three
// positions supply such a signature and none of them did: a lazy-iterator HOF (only the eager
// List half handed the element down), a closure in return position (explicit and implicit
// tail), and a keyword argument (typecheck paired args positionally while codegen reorders them
// by name, so a reordered call was checked against one parameter and emitted against another).
//
// RED before the fix: the iterator and return cases reported error[CannotInferType] for the
// param, and the keyword case reported a type error against the WRONG parameter.

fn mk_implicit_tail() -> fn(Int) -> Int {
    fn(x) { x + 1 }
}

fn mk_explicit_return() -> fn(Int) -> Int {
    return fn(x) { x * 3 }
}

fn run_two(-- first: fn(Int) -> Int, second: fn(Str) -> Int) -> Int {
    first(1) + second("abcd")
}

test "a lazy iterator HOF types its closure param from the element" {
    let xs = [1, 2, 3]
    let ys = xs.into_iter().map(fn(x) { x * 2 }).collect()
    assert(ys.len() == 3)
    let first = ys.get(0) ?? 0
    let last = ys.get(2) ?? 0
    assert(first == 2)
    assert(last == 6)
}

test "a lazy iterator filter types its closure param from the element" {
    let xs = [1, 2, 3, 4]
    let ys = xs.into_iter().filter(fn(x) { x > 2 }).collect()
    assert(ys.len() == 2)
    let kept = ys.get(0) ?? 0
    assert(kept == 3)
}

test "a closure in implicit tail position types its param from the declared return" {
    let f = mk_implicit_tail()
    assert(f(41) == 42)
}

test "a closure in explicit return position types its param from the declared return" {
    let f = mk_explicit_return()
    assert(f(4) == 12)
}

test "a keyword closure argument is typed against the parameter it names" {
    assert(run_two(second: fn(s) { s.len() }, first: fn(k) { k + 1 }) == 6)
}

test "keyword arguments in declaration order stay correct" {
    assert(run_two(first: fn(k) { k + 1 }, second: fn(s) { s.len() }) == 6)
}
