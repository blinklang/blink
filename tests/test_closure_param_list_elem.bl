// t2h5qe: a closure parameter typed List[T] must stamp its element metadata,
// like a named-fn parameter does. Without it the closure-param scope var reads
// its List element back as CT_INT, so a body `for x in inner` (inner a nested
// container) ICEs (UnhandledIterableAtCodegen) or misreads the element.

test "closure param List[Set[Int]] iterates its Set element" {
    let mut s: Set[Int] = Set()
    s.insert(1)
    s.insert(2)
    let outer: List[List[Set[Int]]] = [[s]]
    let mut total = 0
    outer.for_each(fn(inner: List[Set[Int]]) {
        for st in inner {
            for x in st { total = total + x }
        }
    })
    assert_eq(total, 3)
}

test "closure param List[List[Int]] iterates its inner list" {
    let outer: List[List[List[Int]]] = [[[4, 5], [6]]]
    let mut total = 0
    outer.for_each(fn(inner: List[List[Int]]) {
        for lst in inner {
            for x in lst { total = total + x }
        }
    })
    assert_eq(total, 15)
}

test "closure param List[Option[Int]] keeps the inner Option" {
    let outer: List[List[Option[Int]]] = [[Some(7), None, Some(9)]]
    let mut total = 0
    outer.for_each(fn(inner: List[Option[Int]]) {
        for o in inner {
            match o {
                Some(v) => { total = total + v }
                None => {}
            }
        }
    })
    assert_eq(total, 16)
}
