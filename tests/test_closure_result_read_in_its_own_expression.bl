// A `map` / `flat_map` closure with no `-> U` produces the type its body computes, and the
// expression that holds the call reads that type at once: an operator, a method, a field and
// a template hole on the element work as they do once the result is bound to a name.

type Pt {
    x: Int
}

fn first_doubled(xs: List[Int]) -> Int {
    return xs.map(fn(v) { v * 2 }).get(0).unwrap() + 1
}

fn checked(v: Int) -> Result[Int, Str] {
    if v > 0 { Ok(v) } else { Err("neg") }
}

fn first_checked(xs: List[Int]) -> Result[Int, Str] {
    let n = xs.map(fn(v) { checked(v) }).get(0).unwrap()? + 1
    Ok(n)
}

test "an iterator chain's element is added to" {
    assert_eq([1, 2].into_iter().map(fn(v) { v * 10 }).collect().get(0).unwrap() + 1, 11)
}

test "a List chain's element is subtracted from" {
    assert_eq([1, 2].map(fn(v) { v * 10 }).get(0).unwrap() - 1, 9)
}

test "a mapped element is compared and ordered" {
    assert([1, 2].map(fn(v) { v * 10 }).get(0).unwrap() == 10)
    assert([1, 2].map(fn(v) { v * 10 }).get(0).unwrap() < 11)
}

test "a mapped element's own methods are called" {
    assert_eq([1, 2].map(fn(v) { "ab{v}" }).get(0).unwrap().len(), 3)
    assert([1, 2].map(fn(v) { "ab{v}" }).get(1).unwrap().contains("b2"))
}

test "a mapped struct's field is read" {
    assert_eq([1, 2].map(fn(v) { Pt { x: v } }).get(1).unwrap().x, 2)
}

test "a mapped element fills a template hole" {
    assert_eq("{[1, 2].map(fn(v) { v * 10 }).get(1).unwrap() + 1}", "21")
}

test "a missing mapped element falls back" {
    assert_eq([1, 2].map(fn(v) { v * 10 }).get(5) ?? 7, 7)
}

test "a question mark reads a mapped Result element" {
    assert_eq(first_checked([4]).unwrap(), 5)
    assert(first_checked([0]).is_err())
}

test "flat_map, filter and fold results are read in one expression" {
    assert_eq([1, 2].flat_map(fn(v) { [v, v] }).get(3).unwrap() + 1, 3)
    assert_eq([1, 2].map(fn(v) { v * 10 }).filter(fn(s) { s > 10 }).get(0).unwrap() + 1, 21)
    assert_eq([1, 2].map(fn(v) { Pt { x: v } }).fold(0, fn(a, p) { a + p.x }) + 1, 4)
}

test "a map nested in a map is read through both" {
    assert_eq([[1], [2]].map(fn(r) { r.map(fn(v) { v * 10 }) }).get(1).unwrap().get(0).unwrap() + 1, 21)
    assert_eq([[1], [2]].map(fn(r) { r.map(fn(v) { v * 10 }).get(0).unwrap() + 1 }).get(1).unwrap(), 21)
}

test "an effectful closure's element is read" {
    let mut seen = 0
    let n = [1, 2].map(fn(v) {
        seen = seen + 1
        v * 10
    }).get(0).unwrap() + 1
    assert_eq(n, 11)
    assert_eq(seen, 2)
}

test "an assigned and a returned element are read" {
    let mut z = 0
    z = [1, 2].map(fn(v) { v * 10 }).get(1).unwrap() + 1
    assert_eq(z, 21)
    assert_eq(first_doubled([4]), 9)
}

test "a mapped element is read by an if, a while, a for and a match" {
    let mut hits = 0
    if [1, 2].map(fn(v) { v * 10 }).get(0).unwrap() + 1 == 11 { hits = hits + 1 }
    let mut i = 0
    while [1, 2].map(fn(v) { v * 10 }).get(0).unwrap() + i < 12 { i = i + 1 }
    for _ in [1, 2].map(fn(v) { v * 10 }).filter(fn(v) { v > 10 }) { hits = hits + 1 }
    match [1, 2].map(fn(v) { v * 10 }).get(1).unwrap() + 1 {
        21 => { hits = hits + 1 }
        _ => {}
    }
    assert_eq(hits, 3)
    assert_eq(i, 2)
}
