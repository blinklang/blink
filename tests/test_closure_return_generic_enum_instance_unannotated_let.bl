// A closure with an inferred (unannotated) let binding, whose declared return type is
// a generic enum instance, must typedef and spell that instance consistently between
// the closure definition, the variant construction, and the call site.

type Tree[T] { Leaf(v: T), Nil }

test "closure returning a generic enum instance round-trips through a match" {
    let l = fn(n: Int) -> Tree[Int] { Tree.Leaf(v: n) }
    let t = l(4)
    let result = match t {
        Leaf(v) => v
        Nil => -1
    }
    assert_eq(result, 4)
}
