// A closure's return type, declared or inferred from its body, is the `U` of the parameter
// `fn(T) -> U` it fills (sections/03_types.md 3.3, bidirectional inference), so a closure solves
// the binder of any generic fn, not only of the built-in List.map. A `U` nothing solves is
// reported as an under-determined type (3.4).

import std.process.{ProcessResult}

fn sh(cmd: Str) -> ProcessResult {
    process.run("sh", ["-c", cmd]).unwrap()
}

fn project(src: Str) -> Str {
    let dir = sh("mktemp -d /tmp/blink_closure_ret.XXXXXX").out.trim()
    let _ = sh("mkdir -p {dir}/src")
    write_file("{dir}/blink.toml", "[package]\nname = \"app\"\nversion = \"0.1.0\"\n")
    write_file("{dir}/src/main.bl", src)
    dir
}

fn expect_runs(src: Str, want: Str) {
    let dir = project(src)
    let mut ok = true
    let c = sh("B=$(pwd)/build/blink; cd {dir} && timeout 120 $B check src/main.bl < /dev/null 2>&1")
    if !c.success() {
        io.eprintln("blink check: exit {c.exit_code}\n{c.out}")
        ok = false
    }
    for args in ["run --no-per-module", "run --per-module"] {
        let r = sh("B=$(pwd)/build/blink; cd {dir} && timeout 120 $B {args} src/main.bl < /dev/null 2>&1")
        if !r.success() || !r.out.trim().ends_with(want) {
            io.eprintln("blink {args}: exit {r.exit_code}\n{r.out}")
            ok = false
        }
    }
    let _ = sh("rm -rf {dir}")
    assert(ok)
}

fn expect_rejects(src: Str, want: Str) {
    let dir = project(src)
    let mut ok = true
    for args in ["check", "build --no-per-module", "build --per-module"] {
        let r = sh("B=$(pwd)/build/blink; cd {dir} && timeout 120 $B {args} src/main.bl < /dev/null 2>&1")
        if r.success() || !r.out.contains(want) || r.out.contains("internal compiler error") {
            io.eprintln("blink {args}: exit {r.exit_code}, want `{want}`\n{r.out}")
            ok = false
        }
    }
    let _ = sh("rm -rf {dir}")
    assert(ok)
}

test "an unannotated closure's body type solves the callee's return binder" {
    expect_runs(#"fn apply[T, U](x: T, f: fn(T) -> U) -> U {
    f(x)
}
fn main() {
    let a = apply(1, fn(v) { "{v}" })
    let n = apply("abc", fn(s) { s.len() })
    io.println("{a.len()} {n}")
}
"#, "1 3")
}

test "the solved binder reaches a method call in the same expression" {
    expect_runs(#"fn apply[T, U](x: T, f: fn(T) -> U) -> U {
    f(x)
}
fn main() {
    io.println("{apply(12, fn(v) { "{v}" }).len()}")
}
"#, "2")
}

test "a closure solves a generic method's binder" {
    expect_runs(#"type Box { v: Int }
trait Then { fn then[U](self, f: fn(Int) -> U) -> U }
impl Then for Box {
    fn then[U](self, f: fn(Int) -> U) -> U { f(self.v) }
}
fn main() {
    let b = Box { v: 3 }
    let c = b.then(fn(x) { "{x}{x}" })
    io.println("{c.len()} {b.then(fn(x) { [x] }).len()}")
}
"#, "2 1")
}

test "a closure that builds a generic container solves the binder" {
    expect_runs(#"fn apply[T, U](x: T, f: fn(T) -> U) -> U {
    f(x)
}
type Box[T] { v: T }
fn main() {
    let a = apply(1, fn(v) { [v, v] })
    let b = apply("x", fn(s) { Box { v: s } })
    let c = apply(2, fn(v) { Some(v) })
    io.println("{a.len()} {b.v} {c.unwrap()}")
}
"#, "2 x 2")
}

test "a later use fills what the closure body leaves open" {
    expect_runs(#"fn apply[T, U](x: T, f: fn(T) -> U) -> U {
    f(x)
}
fn main() {
    let mut a = apply(1, fn(v) { [] })
    a.push("y")
    io.println("{a.len()} {a.get(0).unwrap()}")
}
"#, "1 y")
}

test "the type the closure gives the binder is checked at its uses" {
    expect_rejects(#"fn apply[T, U](x: T, f: fn(T) -> U) -> U {
    f(x)
}
fn main() {
    let a = apply(1, fn(v) { "{v}" })
    let q = a + 1
    io.println("{q}")
}
"#, "`+` does not work on Str")
}

test "a binder the closure leaves open and no use fills is reported" {
    expect_rejects(#"fn apply[T, U](x: T, f: fn(T) -> U) -> U {
    f(x)
}
fn main() {
    let a = apply(1, fn(v) { [] })
    io.println("x")
}
"#, "cannot infer a type for `a`")
}

test "a closure fills a formal that wraps the binder in a container" {
    expect_runs(#"fn wrap[T, U](x: T, f: fn(T) -> List[U]) -> List[U] {
    f(x)
}
fn main() {
    let a = wrap(1, fn(v) { [v, v] })
    io.println("{a.len()}")
}
"#, "2")
}

test "a closure inside a generic body solves the callee's binder from the body's own type" {
    expect_runs(#"fn apply[T, U](x: T, f: fn(T) -> U) -> U {
    f(x)
}
fn wrap[T](x: T) -> List[T] { apply(x, fn(v) { [v] }) }
fn pair[T](x: T) -> (T, Int) { apply(x, fn(v) { (v, 1) }) }
fn opt[T](x: T) -> Option[T] { apply(x, fn(v) { Some(v) }) }
fn kept[T](x: T) -> List[T] {
    let r = apply(x, fn(v) { [v] })
    r
}
fn main() {
    let w = wrap("a").get(0).unwrap()
    let p = pair(2).0
    let o = opt("b").unwrap()
    io.println("{wrap(1).len()} {w} {p} {o} {kept(3).len()}")
}
"#, "1 a 2 b 1")
}

test "a closure a block or an if hands over is checked at its uses" {
    expect_rejects(#"fn apply[T, U](x: T, f: fn(T) -> U) -> U {
    f(x)
}
fn main() {
    let a = apply(1, { fn(v) { "{v}" } }) + 1
    io.println("{a}")
}
"#, "`+` does not work on Str")
    expect_rejects(#"fn apply[T, U](x: T, f: fn(T) -> U) -> U {
    f(x)
}
fn main() {
    let a = apply(1, if true { fn(v) { "{v}" } } else { fn(v) { "q" } }) + 1
    io.println("{a}")
}
"#, "`+` does not work on Str")
}
