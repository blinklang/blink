// A closure inside a generic fn whose body just returns the fn's own type
// parameter must spell a consistent C type at both its definition and its
// call-site cast, for every instantiation of the type parameter.

fn apply[T](v: T) -> T {
    let f = fn(_x: Int) -> T { v }
    f(3)
}

test "closure returning a bound type parameter round-trips a Float instantiation" {
    let got: Float = apply(1.5)
    assert_eq(got, 1.5)
}

test "closure returning a bound type parameter round-trips an Int instantiation" {
    let got: Int = apply(7)
    assert_eq(got, 7)
}
