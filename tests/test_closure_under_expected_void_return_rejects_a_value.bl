// `return e` checks e against the closure's return type, () included, and the expected type gives
// that return (sections/03_types.md *`return` with a value*). The tail is dropped; the operand of
// a `return` never is.

import compile_test_helpers

let PRELUDE = "fn h(cb: fn(Int) -> ()) \{ cb(1) }\nfn lg() \{ }\n"

fn rejects(body: Str, tag: Str) ! FS.Delete, FS.Write, Process.Spawn, FS.Read, Env.Read, IO.Print {
    let out = compile_test_helpers.compile_and_capture("{PRELUDE}fn main() \{ {body} }\n", tag)
    compile_test_helpers.expect_error(out, "E0300", tag)
    compile_test_helpers.expect_contains(out, "Int", tag)
    compile_test_helpers.expect_contains(out, "drop the value", tag)
}

fn accepts(body: Str, tag: Str) ! FS.Delete, FS.Write, Process.Spawn, FS.Read, Env.Read, IO.Print {
    compile_test_helpers.expect_compiles_clean(compile_test_helpers.compile_and_capture("{PRELUDE}fn main() \{ {body} }\n", tag), tag)
}

test "a value in a return is E0300" {
    rejects("[1].for_each(fn(x) \{ return x })", "cvr_list")
    rejects("[1].into_iter().for_each(fn(x) \{ return x })", "cvr_iter")
    rejects("h(fn(i: Int) \{ return i })", "cvr_user")
    rejects("[1].for_each(fn(x) \{ if x > 0 \{ return x }\n lg() })", "cvr_early")
}

test "a return with no value, a unit value or a Never operand stays legal" {
    accepts("[1].for_each(fn(x) \{ return })", "cvr_ok_bare")
    accepts("[1].for_each(fn(x) \{ return () })", "cvr_ok_unit")
    accepts("[1].for_each(fn(x) \{ return lg() })", "cvr_ok_call")
    accepts("[1].for_each(fn(x) \{ if x > 5 \{ return panic(\"x\") } })", "cvr_ok_never")
    accepts("h(fn(i: Int) \{ i })", "cvr_ok_tail")
}

test "a closure with no expected type still takes its return from the body" {
    let k = fn() { return 5 }
    assert_eq(k(), 5)
}

// The closure's walk runs before these later uses, so the operand's type is open there.
test "a return value that a later use types gets the same report" {
    let out = compile_test_helpers.compile_and_capture("{PRELUDE}fn main() \{ let mut r = []\n h(fn(i) \{ return r.get(0).unwrap() })\n r.push(5) }\n", "cvr_later")
    compile_test_helpers.expect_error(out, "E0300", "cvr_later")
    compile_test_helpers.expect_contains(out, "Int", "cvr_later")
    assert(!out.contains("type ?"), out)
}

test "a return value that a later use types as unit is legal" {
    accepts("let mut r = []\n h(fn(i) \{ return r.get(0).unwrap() })\n r.push(())", "cvr_ok_later_unit")
}

test "a return value that nothing types is E0301 alone" {
    let src = "fn mk[T]() -> T \{ panic(\"x\") }\nfn h(f: fn(Int) -> ()) \{ f(1) }\nfn main() \{ h(fn(i) \{ return mk() }) }\n"
    let out = compile_test_helpers.compile_and_capture(src, "cvr_open")
    compile_test_helpers.expect_error(out, "E0301", "cvr_open")
    assert(!out.contains("return value type"), out)
}

// The head of `List[?]` is not (), whatever fills the slot, so the open slot need not wait for a use.
fn rejects_open(body: Str, tag: Str) ! FS.Delete, FS.Write, Process.Spawn, FS.Read, Env.Read, IO.Print {
    let out = compile_test_helpers.compile_and_capture("{PRELUDE}fn main() \{ {body} }\n", tag)
    compile_test_helpers.expect_error(out, "E0300", tag)
    compile_test_helpers.expect_contains(out, "drop the value", tag)
    assert(!out.contains("internal compiler error"), out)
}

test "an open construct in a return is E0300 before it reaches codegen" {
    rejects_open("[1].for_each(fn(x) \{ return [] })", "cvr_open_list")
    rejects_open("[1].for_each(fn(x) \{ return List.new() })", "cvr_open_list_new")
    rejects_open("[1].for_each(fn(x) \{ return [[]] })", "cvr_open_nested")
    rejects_open("[1].for_each(fn(x) \{ return Map() })", "cvr_open_map")
    rejects_open("[1].for_each(fn(x) \{ return Set() })", "cvr_open_set")
    rejects_open("[1].for_each(fn(x) \{ return (1, []) })", "cvr_open_tuple")
    rejects_open("[1].for_each(fn(x) \{ return ([], 1) })", "cvr_open_tuple_first")
    rejects_open("h(fn(i) \{ return [] })", "cvr_open_user")
    rejects_open("let k: fn() -> () = fn() \{ return [] }\n k()", "cvr_open_let")
    rejects_open("[1].for_each(fn(x) \{ if x > 0 \{ return [] }\n return () })", "cvr_open_early")
}

test "a return of an open construct that a later use types names the settled type" {
    let out = compile_test_helpers.compile_and_capture("{PRELUDE}fn main() \{ let mut r = []\n h(fn(i) \{ return r })\n r.push(5) }\n", "cvr_open_later")
    compile_test_helpers.expect_error(out, "E0300", "cvr_open_later")
    compile_test_helpers.expect_contains(out, "List[Int]", "cvr_open_later")
}

fn one_error(body: Str, tag: Str, want: Str) ! FS.Delete, FS.Write, Process.Spawn, FS.Read, Env.Read, IO.Print {
    let out = compile_test_helpers.compile_and_capture("{PRELUDE}fn main() \{ {body} }\n", tag)
    compile_test_helpers.expect_contains(out, want, tag)
    assert(!out.contains("return value type"), out)
    assert(!out.contains("<?>"), out)
    assert(!out.contains("internal compiler error"), out)
}

test "an operand an earlier error left without a type adds no second error" {
    one_error("h(fn(i) \{ return [undefined_x] })", "cvr_undef_list", "undefined_x")
    one_error("h(fn(i) \{ return Some(undefined_x) })", "cvr_undef_some", "undefined_x")
}

test "a closure that writes -> () holds its return to it" {
    // The `()` is on the closure here, and no expected function type exists to blame.
    let written = compile_test_helpers.compile_and_capture("fn main() \{ let k = fn() -> () \{ return 1 }\n k() }\n", "cvr_written_text")
    assert(!written.contains("expected function type gives"), written)
    assert(!written.contains("to the expected function type"), written)
    compile_test_helpers.expect_contains(written, "change `-> ()` to `-> T`, or drop the value", "cvr_written_text")
    rejects("let k = fn() -> () \{ return 1 }\n k()", "cvr_written_int")
    let out = compile_test_helpers.compile_and_capture("fn main() \{ let k = fn() -> () \{ return [] }\n k() }\n", "cvr_written_open")
    compile_test_helpers.expect_error(out, "E0300", "cvr_written_open")
    assert(!out.contains("internal compiler error"), out)
}

// The repairs come in this order, and the error points to where the () comes from
// (sections/03_types.md *`return` with a value*).
test "a closure under an expected type names that type as the source of its ()" {
    for body in ["h(fn(i) \{ return i })", "let f: fn(Int) -> () = fn(x) \{ return x }\n f(1)"] {
        let out = compile_test_helpers.compile_and_capture("{PRELUDE}fn main() \{ {body} }\n", "cvr_expected_text")
        compile_test_helpers.expect_contains(out, "which the expected function type gives", "cvr_expected_text")
        compile_test_helpers.expect_contains(out, "add `-> T` to the expected function type, or drop the value", "cvr_expected_text")
    }
}

test "the text of a value settled later names the same source" {
    let out = compile_test_helpers.compile_and_capture("fn mk[T]() -> T \{ panic(\"x\") }\nfn take(a: Int) \{ }\nfn main() \{ let k = fn() -> () \{ let v = mk()\n if true \{ return v }\n take(v)\n }\n k() }\n", "cvr_written_later")
    compile_test_helpers.expect_contains(out, "change `-> ()` to `-> T`", "cvr_written_later")
}
