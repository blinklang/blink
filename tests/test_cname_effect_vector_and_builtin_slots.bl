// The names an effect perform prints around the evidence vector: the parameter every
// effectful C function takes, the global the program installs into, and the runtime
// vtable slot a builtin caller name reaches. Expected bytes come from the pinned
// compiler's C and from the runtime's blink_io_vtable and blink_env_vtable.

import cname.{c_ev_param_name, c_ev_global_name, c_builtin_effect_slot}
import cname_test_helpers.{assert_eq_str}
import diagnostics.{diag_is_ice_seg}
import std.io

test "the vector parameter and the vector global have fixed names" {
    assert_eq_str("param", c_ev_param_name(), "__ev")
    assert_eq_str("global", c_ev_global_name(), "__blink_ev")
}

test "io caller names reach the runtime's print slots" {
    assert_eq_str("println", c_builtin_effect_slot("io", "println"), "print")
    assert_eq_str("print", c_builtin_effect_slot("io", "print"), "print_no_nl")
    assert_eq_str("eprintln", c_builtin_effect_slot("io", "eprintln"), "eprint")
    assert_eq_str("eprint", c_builtin_effect_slot("io", "eprint"), "eprint_no_nl")
    assert_eq_str("log", c_builtin_effect_slot("io", "log"), "log")
}

test "env caller names reach the runtime's env slots" {
    assert_eq_str("var", c_builtin_effect_slot("env", "var"), "read")
    assert_eq_str("set_var", c_builtin_effect_slot("env", "set_var"), "write")
    assert_eq_str("remove_var", c_builtin_effect_slot("env", "remove_var"), "remove")
    assert_eq_str("cwd", c_builtin_effect_slot("env", "cwd"), "cwd")
    assert_eq_str("exit", c_builtin_effect_slot("env", "exit"), "exit_fn")
}

test "a name outside the runtime's tables answers an ICE segment, never a guess" {
    let unknown_op = c_builtin_effect_slot("io", "print_raw")
    if !diag_is_ice_seg(unknown_op) { io.println("FAIL: io.print_raw answered '{unknown_op}'") }
    assert(diag_is_ice_seg(unknown_op))
    let unknown_ns = c_builtin_effect_slot("fs", "read")
    if !diag_is_ice_seg(unknown_ns) { io.println("FAIL: fs.read answered '{unknown_ns}'") }
    assert(diag_is_ice_seg(unknown_ns))
    let cased = c_builtin_effect_slot("IO", "println")
    if !diag_is_ice_seg(cased) { io.println("FAIL: IO.println answered '{cased}'") }
    assert(diag_is_ice_seg(cased))
}
