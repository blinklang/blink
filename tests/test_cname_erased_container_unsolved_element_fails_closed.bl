test "every erased container over a solved element keeps its base spelling" {
    let m = compile_probe("cname_erased_unsolved", probe_src())
    let i = tid_of(m, "Int")
    assert_eq_str("List[Int] top", c_seg_top(make_list_type(i)), "List")
    assert_eq_str("List[Int] inner", c_seg_inner(make_list_type(i)), "list")
    assert_eq_str("Set[Int] top", c_seg_top(make_set_type(i)), "Set")
    assert_eq_str("Set[Int] inner", c_seg_inner(make_set_type(i)), "set")
    assert_eq_str("Iterator[Int] top", c_seg_top(make_iterator_type(i)), "Iterator")
    assert_eq_str("Iterator[Int] inner", c_seg_inner(make_iterator_type(i)), "iter")
    assert_eq_str("Channel[Int] top", c_seg_top(make_channel_type(i)), "Channel")
    assert_eq_str("Channel[Int] inner", c_seg_inner(make_channel_type(i)), "channel")
    assert_eq_str("Handle[Int] top", c_seg_top(make_handle_type(i)), "Handle")
    assert_eq_str("Handle[Int] inner", c_seg_inner(make_handle_type(i)), "handle")
    assert_eq_str("Ptr[Int] top", c_seg_top(make_ptr_type(i)), "Ptr")
    assert_eq_str("Ptr[Int] inner", c_seg_inner(make_ptr_type(i)), "ptr")
    assert_eq_str("Map[Int, Int] top", c_seg_top(make_map_type(i, i)), "Map")
    assert_eq_str("Map[Int, Int] inner", c_seg_inner(make_map_type(i, i)), "map")
}

test "Map over an unbound key or value fails closed at top and inner" {
    let m = compile_probe("cname_erased_unsolved", probe_src())
    let i = tid_of(m, "Int")
    erased_unsolved_top("Map key", make_map_type(make_metavar(), i))
    erased_unsolved_inner("Map key", make_map_type(make_metavar(), i))
    erased_unsolved_top("Map value", make_map_type(i, make_metavar()))
    erased_unsolved_inner("Map value", make_map_type(i, make_metavar()))
}

// A type parameter left unsubstituted is as unsolved as a metavariable: its `<tv>` segment
// is refused where it would be spelled, so it must not pass where it is dropped.
test "an erased container over an unsubstituted type parameter fails closed" {
    let _m = compile_probe("cname_erased_unsolved", probe_src())
    erased_unsolved_top("List[T]", make_list_type(make_typevar("T")))
    erased_unsolved_inner("List[T]", make_list_type(make_typevar("T")))
    erased_unsolved_top("Map[T, T]", make_map_type(make_typevar("T"), make_typevar("T")))
}

// A nested erased container is the same hole one level down.
test "a List of a List over an unbound metavariable fails closed" {
    let _m = compile_probe("cname_erased_unsolved", probe_src())
    erased_unsolved_top("List[List]", make_list_type(make_list_type(make_metavar())))
    erased_unsolved_inner("List[List]", make_list_type(make_list_type(make_metavar())))
}
