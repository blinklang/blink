// A one-element container that erases its element in the C type (one blink_list* serves
// every List) still must not spell a name around an unsolved element. The name would be a
// legal C identifier, so an unsolved type would reach codegen with no diagnostic. A solved
// element keeps the erased base spelling.

import typecheck.{
    make_metavar, make_list_type, make_set_type, make_iterator_type, make_channel_type,
    make_handle_type, make_ptr_type, make_map_type, make_typevar,
}
import diagnostics.{ICE_SEG_UNSOLVED_TYPEVAR}
import cname.{c_seg_top, c_seg_inner}
import cname_test_helpers.{assert_eq_str, tid_of, compile_probe}

fn probe_src() -> Str {
    #"fn main() {
    let i: Int = 7
    assert(i == 7)
}
"#
}

fn erased_unsolved_top(label: Str, tid: Int) {
    assert_eq_str("{label}[metavar] top", c_seg_top(tid), ICE_SEG_UNSOLVED_TYPEVAR)
}

fn erased_unsolved_inner(label: Str, tid: Int) {
    assert_eq_str("{label}[metavar] inner", c_seg_inner(tid), ICE_SEG_UNSOLVED_TYPEVAR)
}

test "List over an unbound metavariable fails closed at top" {
    let _m = compile_probe("cname_erased_unsolved", probe_src())
    erased_unsolved_top("List", make_list_type(make_metavar()))
}

test "List over an unbound metavariable fails closed at inner" {
    let _m = compile_probe("cname_erased_unsolved", probe_src())
    erased_unsolved_inner("List", make_list_type(make_metavar()))
}

test "Set over an unbound metavariable fails closed at top" {
    let _m = compile_probe("cname_erased_unsolved", probe_src())
    erased_unsolved_top("Set", make_set_type(make_metavar()))
