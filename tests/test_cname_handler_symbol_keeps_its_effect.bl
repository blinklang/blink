// Every effect's handler is its own C vtable type, so a name built for a symbol keeps the
// effect. Without it, two effects' instances of one generic declaration share one symbol.

import cname.{c_promote_walker_name}
import cname_test_helpers.{assert_eq_str, compile_probe, tid_of}

fn probe_src() -> Str {
    #"effect Ping {
    effect Ask {
        fn ping() -> Int
    }
}

effect Log {
    effect Info {
        fn info() -> Int
    }
    effect Warn {
        fn warn() -> Int
    }
}

fn main() {
    let p: Handler[Ping] = handler Ping {
        fn ping() -> Int { 1 }
    }
    let i: Handler[Log.Info] = handler Log.Info {
        fn info() -> Int { 2 }
    }
    let w: Handler[Log.Warn] = handler Log.Warn {
        fn warn() -> Int { 3 }
    }
    let ps: List[Handler[Ping]] = [p]
    assert(ps.len() == 1)
    let _keep = [i]
    let _keep2 = [w]
}
"#
}

test "a handler's symbol name keeps its effect" {
    let m = compile_probe("cname_handler_symbol", probe_src())
    assert_eq_str("ping", c_promote_walker_name(tid_of(m, "Handler[Ping]")), "blink_promote_Handler_Ping")
    assert_eq_str("list of ping", c_promote_walker_name(tid_of(m, "List[Handler[Ping]]")), "blink_promote_List_handler_Ping")
}

test "two sub-effects of one root get two symbol names" {
    let m = compile_probe("cname_handler_sub_effects", probe_src())
    assert_eq_str("info", c_promote_walker_name(tid_of(m, "Handler[Log.Info]")), "blink_promote_Handler_Log_Info")
    assert_eq_str("warn", c_promote_walker_name(tid_of(m, "Handler[Log.Warn]")), "blink_promote_Handler_Log_Warn")
}
