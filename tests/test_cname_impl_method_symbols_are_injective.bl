// The C symbol of a trait impl's method must be injective over (module of the impl, type,
// trait key, method): two methods that spell one symbol are one C function, so the C compiler
// refuses the program or the linker keeps one body for both. A trait key is the trait's name,
// or `Name@module` when more than one module declares the name. Each name below holds `_` in
// a spot where a bare `_` join would let it pass for a joiner, or holds `_` before a digit
// where an escape or a marker could be faked, and the pool takes every combination, so a
// later change to one segment cannot trade one collision for another. A From or TryFrom
// method's stem takes its source too, and must not meet any trait impl method's stem.

import cname.{c_impl_method_symbol}
import typecheck.{tc_impl_conv_stem, tc_impl_method_stem}
import std.io

fn modules() -> List[Str] { ["", "a", "a_b", "b", "b_c", "m", "x"] }

fn types() -> List[Str] { ["b", "C", "b_C", "T", "C_m", "Tr", "Ticker", "b_", "T_2x", "_A", "T_0Int"] }

fn trait_keys() -> List[Str] {
    [
        "Tr", "m", "C", "Tr_a", "Tr_a_b", "Tr_x", "C_m", "Tr_", "Tr_2a", "from", "to", "From", "TryFrom",
        "Tr@a", "Tr@a_b", "Tr@x", "C@m", "m@a", "Tr_a@b", "Tr@b_c", "Tr_@a", "Tr@a_2b", "From@m",
    ]
}

fn methods() -> List[Str] { ["go", "m_go", "a_go", "Tr_go", "go_", "m_2go", "from", "try_from", "json", "Int"] }

test "distinct (module, type, trait, method) tuples spell distinct symbols" {
    let mut seen: Map[Str, Str] = Map()
    let mut clashes = 0
    for m in modules() {
        for t in types() {
            for k in trait_keys() {
                for meth in methods() {
                    let row = "({m}, {t}, {k}, {meth})"
                    let sym = c_impl_method_symbol(m, t, k, meth)
                    match seen.get(sym) {
                        Some(other) => {
                            io.println("FAIL: {other} and {row} both spell '{sym}'")
                            clashes = clashes + 1
                        }
                        None => seen.insert(sym, row)
                    }
                }
            }
        }
    }
    assert(clashes == 0)
}

test "a From or TryFrom stem never meets a trait impl method's stem" {
    let mut seen: Map[Str, Str] = Map()
    let mut clashes = 0
    for t in types() {
        for k in trait_keys() {
            for meth in methods() {
                seen.insert(tc_impl_method_stem(t, k, meth), "({t}, {k}, {meth})")
            }
        }
    }
    for t in types() {
        for conv in [("From", "from"), ("TryFrom", "try_from")] {
            for src in types() {
                let row = "({t}, {conv.0}[{src}], {conv.1})"
                let stem = tc_impl_conv_stem(t, conv.0, conv.1, src)
                match seen.get(stem) {
                    Some(other) => {
                        io.println("FAIL: {other} and {row} both spell '{stem}'")
                        clashes = clashes + 1
                    }
                    None => seen.insert(stem, row)
                }
            }
        }
    }
    assert(clashes == 0)
}
