// Golden names for impl-method symbols: the trait-qualified form, the
// From/TryFrom source-typed form and the synthesized Display dispatcher, in
// the main module and in a named module. Expected bytes come from the pinned
// compiler's C.

import compiler.{compile_to_program}

import cname.{c_impl_method_name, c_impl_method_name_q, c_display_dispatch_name}
import cname_test_helpers.{assert_eq_str, find_impl, compile_probe, compile_pkg_probe}
import std.io

fn single_probe_src() -> Str {
    #"type Point { x: Int, y: Int }
trait Greet {
    fn greet(self) -> Str
}
impl Greet for Point {
    fn greet(self) -> Str { "p" }
}
impl Display for Point {
    fn fmt(self, sb: StringBuilder) { sb.write("({self.x}, {self.y})") }
}
impl From[Int] for Point {
    fn from(v: Int) -> Point { Point { x: v, y: v } }
}
fn main() {
    let p = Point { x: 1, y: 2 }
    io.println("{p.greet()} {p.display()} {Point.from(3).x}")
}
"#
}

fn mymod_src() -> Str {
    #"pub type Ngx { n: Int }
pub trait Greet2 {
    fn greet2(self) -> Str
}
impl Greet2 for Ngx {
    fn greet2(self) -> Str { "n" }
}
impl Display for Ngx {
    fn fmt(self, sb: StringBuilder) { sb.write("{self.n}") }
}
impl From[Int] for Ngx {
    fn from(v: Int) -> Ngx { Ngx { n: v } }
}
"#
}

fn pkg_main_src() -> Str {
    #"import mymod.{Ngx, Greet2}
fn main() {
    let n = Ngx { n: 1 }
    io.println("{n.greet2()} {n.display()} {Ngx.from(2).n}")
}
"#
}

test "trait-qualified impl method: blink_<Type>_<Trait>_<method>" {
    let _m = compile_probe("cname_impl_methods", single_probe_src())
    let greet = find_impl("Point", "Greet", "")
    let disp = find_impl("Point", "Display", "")
    assert_eq_str("greet", c_impl_method_name(greet, "greet"), "blink_Point_Greet_greet")
    assert_eq_str("fmt", c_impl_method_name(disp, "fmt"), "blink_Point_Display_fmt")
    assert_eq_str("q form", c_impl_method_name_q(greet, "Greet", "greet"), "blink_Point_Greet_greet")
}

test "From impl method: blink_<Target>_<method>_<Source>" {
    let _m = compile_probe("cname_impl_methods", single_probe_src())
    let from = find_impl("Point", "From", "")
    assert_eq_str("from", c_impl_method_name(from, "from"), "blink_Point_from_Int")
}

test "synthesized Display dispatcher: blink_<Type>_Display_display" {
    let _m = compile_probe("cname_impl_methods", single_probe_src())
    let disp = find_impl("Point", "Display", "")
    assert_eq_str("display", c_display_dispatch_name(disp), "blink_Point_Display_display")
}

test "impl methods in a module carry the impl's module prefix" {
    let _m = compile_pkg_probe("cname_impl_methods", "cnameimpl", mymod_src(), pkg_main_src())
    let greet = find_impl("Ngx", "Greet2", "mymod")
    let disp = find_impl("Ngx", "Display", "mymod")
    let from = find_impl("Ngx", "From", "mymod")
    assert_eq_str("greet2", c_impl_method_name(greet, "greet2"), "blink_mymod_Ngx_Greet2_greet2")
    assert_eq_str("fmt", c_impl_method_name(disp, "fmt"), "blink_mymod_Ngx_Display_fmt")
    assert_eq_str("display", c_display_dispatch_name(disp), "blink_mymod_Ngx_Display_display")
    assert_eq_str("from", c_impl_method_name(from, "from"), "blink_mymod_Ngx_from_Int")
}
