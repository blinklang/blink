// The C tokens carried over from Blink source: a local's name, a field's name, a string
// constant, and the runtime and compiler symbols a lowered expression can need.

import cname.{c_local_name, c_field_name, c_string_literal, c_container_ctor, c_runtime_helper,
    c_overflow_builtin, c_int_min_macro}
import typecheck.{TyKind}
import cname_test_helpers.{compile_probe, assert_eq_str, tid_of}
import diagnostics.{diag_is_ice_seg}
import std.str.{str_from_code_point}

fn src() -> Str {
    #"fn main() {
    let l = [1]
    let m: Map[Str, Int] = Map()
    let s: Set[Int] = Set()
    let o: Option[Int] = None
    let _k = [l.len(), m.len(), s.len()]
    let _k2 = [o]
}
"#
}

test "a name C does not own is kept, and one it owns is prefixed" {
    assert_eq_str("plain", c_local_name("count"), "count")
    assert_eq_str("keyword", c_local_name("register"), "_blink_register")
    assert_eq_str("libc", c_local_name("stdout"), "_blink_stdout")
    assert_eq_str("main", c_local_name("main"), "_blink_main")
}

test "a field name follows the same rule as a local name" {
    assert_eq_str("plain", c_field_name("width"), "width")
    assert_eq_str("keyword", c_field_name("default"), "_blink_default")
}

test "a string constant is quoted and escaped for C" {
    assert_eq_str("plain", c_string_literal("hi"), #""hi""#)
    assert_eq_str("quote", c_string_literal(#"a"b"#), #""a\"b""#)
    assert_eq_str("empty", c_string_literal(""), #""""#)
}

test "a per cent sign is data to C and is not escaped by the literal producer" {
    assert_eq_str("percent", c_string_literal("100%"), #""100%""#)
}

test "each runtime container names its own constructor and nothing else does" {
    let m = compile_probe("cname_lowering_names", src())
    assert_eq_str("list", c_container_ctor(tid_of(m, "List[Int]")), "blink_list_new")
    assert_eq_str("map", c_container_ctor(tid_of(m, "Map[Str, Int]")), "blink_map_new")
    assert_eq_str("set", c_container_ctor(tid_of(m, "Set[Int]")), "blink_set_new")
    assert(diag_is_ice_seg(c_container_ctor(tid_of(m, "Option[Int]"))))
}

test "a runtime helper is named by its operation, with the prefix added here" {
    assert_eq_str("format", c_runtime_helper("str_format"), "blink_str_format")
    assert_eq_str("compare", c_runtime_helper("str_cmp"), "blink_str_cmp")
    assert(diag_is_ice_seg(c_runtime_helper("")))
}

test "each checked operator names its own builtin, and an operator with no check declines" {
    assert_eq_str("add", c_overflow_builtin("+"), "__builtin_add_overflow")
    assert_eq_str("sub", c_overflow_builtin("-"), "__builtin_sub_overflow")
    assert_eq_str("mul", c_overflow_builtin("*"), "__builtin_mul_overflow")
    assert(diag_is_ice_seg(c_overflow_builtin("/")))
    assert(diag_is_ice_seg(c_overflow_builtin("")))
}

test "each signed type names its own minimum, and a type with no negative range declines" {
    assert_eq_str("I8", c_int_min_macro(TyKind.I8), "INT8_MIN")
    assert_eq_str("I16", c_int_min_macro(TyKind.I16), "INT16_MIN")
    assert_eq_str("I32", c_int_min_macro(TyKind.I32), "INT32_MIN")
    assert_eq_str("Int", c_int_min_macro(TyKind.Int), "INT64_MIN")
    assert(diag_is_ice_seg(c_int_min_macro(TyKind.U8)))
    assert(diag_is_ice_seg(c_int_min_macro(TyKind.Float)))
}

test "a control byte becomes a three digit octal escape, which a digit cannot extend" {
    let one = str_from_code_point(1)
    assert_eq_str("octal", c_string_literal("a".concat(one).concat("7")), "\"a\\0017\"")
}
