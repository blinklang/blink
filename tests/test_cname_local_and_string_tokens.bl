// The two C tokens carried over from Blink source: the identifier of a local and the
// spelling of a string constant. Both are lexical questions about C, answered once here
// so a binder and every read of it cannot disagree.

import cname.{c_local_name, c_string_literal}
import cname_test_helpers.{assert_eq_str}
import std.str.{str_from_code_point}

// No list of the names C, libc or a header owns is complete, so every local takes the
// prefix, owned or not.
test "every local takes the Blink prefix, whether C owns the name or not" {
    assert_eq_str("plain", c_local_name("count"), "b_count")
    assert_eq_str("keyword", c_local_name("register"), "b_register")
    assert_eq_str("libc", c_local_name("stdout"), "b_stdout")
    assert_eq_str("main", c_local_name("main"), "b_main")
    assert_eq_str("macro", c_local_name("EINVAL"), "b_EINVAL")
}

// open and sleep were in one of the two lists an older producer replaced and not the
// other, so a local named either was declared under one spelling and read under another.
test "a libc name that only one of the old lists held is prefixed" {
    assert_eq_str("open", c_local_name("open"), "b_open")
    assert_eq_str("sleep", c_local_name("sleep"), "b_sleep")
}

test "a string constant is quoted and escaped for C" {
    assert_eq_str("plain", c_string_literal("hi"), #""hi""#)
    assert_eq_str("quote", c_string_literal(#"a"b"#), #""a\"b""#)
    assert_eq_str("empty", c_string_literal(""), #""""#)
}

test "a per cent sign is data to C and is not escaped by the literal producer" {
    assert_eq_str("percent", c_string_literal("100%"), #""100%""#)
}

test "a control byte becomes a three digit octal escape, which a digit cannot extend" {
    let one = str_from_code_point(1)
    assert_eq_str("octal", c_string_literal("a".concat(one).concat("7")), "\"a\\0017\"")
}
