// The compiler mints locals that no Blink source named: the temp an expression is
// materialised into, the holder a tuple destructure binds through, the bound a loop
// tests against. One counter mints them all, so two stages cannot hand back the same
// identifier for two different values.

import cname.{c_mint_local, c_is_minted_temp, c_cell_name, c_local_name, c_field_name, cname_reset, c_ensures_result_name, c_old_snapshot_name}
import cname_test_helpers.{assert_eq_str, compile_probe, tid_of}

// The stem is a hint for the reader of the C, not an identity. Two stems drawing on one
// counter is the point: a minted name is unique across the whole unit, not merely within
// the stage that asked for it.
test "two stems never mint the same identifier" {
    cname_reset()
    let a = c_mint_local("tmp")
    let b = c_mint_local("scrut")
    let c = c_mint_local("tmp")
    assert(a != b)
    assert(a != c)
    assert(b != c)
}

test "the unit reset restarts the counter" {
    cname_reset()
    let first = c_mint_local("tmp")
    let second = c_mint_local("tmp")
    assert(first != second)
    cname_reset()
    assert_eq_str("after reset", c_mint_local("tmp"), first)
}

// A minted name must not collide with a name a program wrote. An underscore starts a
// legal Blink identifier, so a program can write the very spelling the minter produces
// and the minted prefix on its own guarantees nothing. The Blink prefix on every name a
// program wrote is what keeps the two apart.
test "a user name in the minted namespace is moved away from the minted name" {
    cname_reset()
    let minted = c_mint_local("tmp")
    assert(minted.starts_with("_cg_"))
    assert(c_local_name(minted) != minted)
}

// The prefix has to be injective or it only moves the collision. `b_` also starts a legal
// Blink identifier, so a program can write the exact name the prefix produces for another
// name; that name must take the prefix again rather than land on the other's answer.
test "a user name cannot be aimed at another name's prefixed spelling" {
    assert(c_local_name("b_int") != c_local_name("int"))
    assert(c_local_name("_blink_int") != c_local_name("int"))
}

// Two fields of one struct with one member name would be the same collision inside the
// struct, so the field producer needs the injective rule too.
test "two field names cannot reach one member name" {
    let m = compile_probe("cname_minted_fields", "type Pair \{ b_int: Int, int: Int }\nfn main() \{ let _p = Pair \{ b_int: 1, int: 2 } }\n")
    let pair = tid_of(m, "Pair")
    assert(c_field_name(pair, "b_int") != c_field_name(pair, "int"))
}

// A contract check's return temp and old() snapshot keep their own stems, so they draw on
// the one counter, and no name a program wrote can reach those stems, as it cannot reach
// the minted prefix.
test "a contract temp is unique and a user name cannot land on it" {
    cname_reset()
    let rv = c_ensures_result_name()
    let old = c_old_snapshot_name()
    let tmp = c_mint_local("tmp")
    assert(rv.starts_with("__ens_rv_"))
    assert(old.starts_with("__old_"))
    assert(rv != old && rv != tmp && old != tmp)
    assert(c_local_name(rv) != rv)
    assert(c_local_name(old) != old)
}

// A reader may name a minted temp again instead of copying it, because only the construct
// that minted it assigns it. A name the program wrote, and a cell, which is
// a mutable binding the program named, must not pass for one.
test "only a minted temp counts as one" {
    cname_reset()
    let minted = c_mint_local("u")
    assert(c_is_minted_temp(minted))
    assert(!c_is_minted_temp(c_local_name("x")))
    assert(!c_is_minted_temp(c_local_name(minted)))
    assert(!c_is_minted_temp(c_cell_name("x")))
    assert(!c_is_minted_temp(c_cell_name(minted)))
}
