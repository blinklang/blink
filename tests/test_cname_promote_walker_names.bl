// A value leaves an arena through a walker named from its type. Two element types need
// two bodies, so the name has to keep the element type, not only the container.

import cname.{
    c_capture_cell_fill_name, c_capture_table_name, c_capture_word_walker_name,
    c_promote_closure_walker_name, c_promote_walker_name,
}
import cname_test_helpers.{assert_eq_str, compile_probe, tid_of}

fn probe_src() -> Str {
    #"fn main() {
    let a: List[Int] = [1]
    let b: List[Str] = ["x"]
    let f = fn(i: Int) -> Int { i + a.len() }
    assert(a.len() == b.len() && f(0) == 1)
}
"#
}

test "a promotion walker's name keeps the element type" {
    let m = compile_probe("cname_promote_walker", probe_src())
    assert_eq_str("ints", c_promote_walker_name(tid_of(m, "List[Int]")), "blink_promote_List_int")
    assert_eq_str("strs", c_promote_walker_name(tid_of(m, "List[Str]")), "blink_promote_List_str")
}

// A capture moves through an entry its descriptor names. A word and a `let mut` cell of one
// type are moved by different bodies, so the two names differ, and each keeps the type.
test "a capture's word walker and cell fill are named per type" {
    let m = compile_probe("cname_capture_walkers", probe_src())
    let ints = tid_of(m, "List[Int]")
    assert_eq_str("word", c_capture_word_walker_name(ints), "blink_capture_word_List_int")
    assert_eq_str("cell", c_capture_cell_fill_name(ints), "blink_capture_cell_List_int")
    assert_eq_str("other element", c_capture_cell_fill_name(tid_of(m, "List[Str]")), "blink_capture_cell_List_str")
}

// Every closure of one signature is promoted by one walker over its own descriptors, and
// each closure literal has its own table, named after the thunk it describes.
test "a closure walker is named per signature and a descriptor table per thunk" {
    let m = compile_probe("cname_closure_walker", probe_src())
    assert_eq_str("closure walker", c_promote_closure_walker_name(tid_of(m, "Fn(Int) -> Int")), "blink_promote_closure_Fn1_int_int")
    assert_eq_str("table", c_capture_table_name("_cg_closure20"), "_cg_closure20_descs")
}
