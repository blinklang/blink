// Golden names for the functions codegen builds on demand for a range. Each expected string
// was read from the C the compiler emits (`blink build --emit c`) for a program that calls
// the method on a range of the same bound type. The name keeps the bound type, so two bound
// types get two bodies.

import cname.{c_range_debug_name, c_range_clone_name}
import cname_test_helpers.{assert_eq_str, tid_of, compile_probe}

fn probe_src() -> Str {
    #"@derive(Eq, Ord)
type Pt { x: Int }
impl Clone for Pt {
    fn clone(self) -> Pt { Pt { x: self.x } }
}
fn main() {
    let r = 1..3
    let s = "a"..="b"
    let p = Pt { x: 1 }..Pt { x: 2 }
}
"#
}

test "a range's debug function is named for its bound type" {
    let m = compile_probe("cname_range_fn_names", probe_src())
    assert_eq_str("Range[Int]", c_range_debug_name(tid_of(m, "Range[Int]")), "blink_range_debug_Range_int")
    assert_eq_str("Range[Str]", c_range_debug_name(tid_of(m, "Range[Str]")), "blink_range_debug_Range_str")
}

test "a range's clone function is named for its bound type" {
    let m = compile_probe("cname_range_fn_names", probe_src())
    assert_eq_str("Range[Pt]", c_range_clone_name(tid_of(m, "Range[Pt]")), "blink_range_clone_Range_Pt")
}
