// A Str constant in the emitted C is its 16-byte length header and its text in one C
// array, with the expression pointing past the header. The header is the byte length,
// little-endian over eight bytes, then the codepoint count plus one, little-endian over
// four bytes, then the magic 0x9E3779B1, also little-endian, which the runtime checks
// before it trusts the length.

import cname.{c_str_const, c_str_cps_plus1}
import cname_test_helpers.{assert_eq_str}

let MAGIC: Str = #"\261\171\067\236"#

test "the empty Str has a zero length header" {
    assert_eq_str("empty", c_str_const(""),
        "(\"".concat(#"\000\000\000\000\000\000\000\000"#).concat(#"\001\000\000\000"#).concat(MAGIC).concat(#"" "" + 16)"#))
}

test "the header holds the byte length and the text keeps its escapes" {
    assert_eq_str("plain", c_str_const("hi"),
        "(\"".concat(#"\002\000\000\000\000\000\000\000"#).concat(#"\003\000\000\000"#).concat(MAGIC).concat(#"" "hi" + 16)"#))
    assert_eq_str("escaped", c_str_const("a\nb"),
        "(\"".concat(#"\003\000\000\000\000\000\000\000"#).concat(#"\004\000\000\000"#).concat(MAGIC).concat(#"" "a\nb" + 16)"#))
}

test "the length counts bytes, not characters" {
    assert_eq_str("two byte", c_str_const("café"),
        "(\"".concat(#"\005\000\000\000\000\000\000\000"#).concat(#"\005\000\000\000"#).concat(MAGIC).concat("\" \"café\" + 16)"))
}

test "a length past one byte spreads over the low bytes first" {
    let sb = StringBuilder.new()
    let mut i = 0
    while i < 300 {
        sb.write("a")
        i = i + 1
    }
    let text = sb.to_str()
    // 300 is 0x012C: 054 then 001 in octal. The count plus one, 301, is 055 then 001.
    assert_eq_str("long", c_str_const(text),
        "(\"".concat(#"\054\001\000\000\000\000\000\000"#).concat(#"\055\001\000\000"#).concat(MAGIC).concat("\" \"").concat(text).concat("\" + 16)"))
}

test "the codepoint count field counts characters, not bytes" {
    // café is 5 bytes and 4 characters; the euro sign is 3 bytes and the emoji 4.
    assert_eq(c_str_cps_plus1(""), 1)
    assert_eq(c_str_cps_plus1("café"), 5)
    assert_eq(c_str_cps_plus1("€😀"), 3)
    assert_eq(c_str_cps_plus1("aé€😀"), 5)
}

test "the codepoint count comes from the decoded text, not the source escapes" {
    // Each escape is two source characters but one decoded character.
    assert_eq(c_str_cps_plus1("\t\n\\\"\{\}é"), 8)
    assert_eq_str("escapes", c_str_const("\té"),
        "(\"".concat(#"\003\000\000\000\000\000\000\000"#).concat(#"\003\000\000\000"#).concat(MAGIC).concat("\" \"\\t").concat("é\" + 16)"))
}
