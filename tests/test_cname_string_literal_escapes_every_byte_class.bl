// Every class of byte the C string-literal producer handles, and the joins between plain
// runs and escapes, so a producer that copies plain bytes in runs cannot drop or repeat a
// byte at a boundary.

import cname.{c_string_literal}
import cname_test_helpers.{assert_eq_str}
import std.str.{str_from_code_point}

test "each named escape is written as its C escape" {
    assert_eq_str("backslash", c_string_literal(#"a\b"#), #""a\\b""#)
    assert_eq_str("newline", c_string_literal("a\nb"), #""a\nb""#)
    assert_eq_str("return", c_string_literal("a\rb"), #""a\rb""#)
    assert_eq_str("tab", c_string_literal("a\tb"), #""a\tb""#)
    assert_eq_str("backspace", c_string_literal("a\bb"), #""a\bb""#)
    assert_eq_str("form feed", c_string_literal("a\fb"), #""a\fb""#)
}

// A bare `??` followed by some characters is a trigraph to an old C compiler.
test "a question mark is escaped so it cannot start a trigraph" {
    assert_eq_str("trigraph", c_string_literal("??="), #""\?\?=""#)
}

test "DEL and a low control byte become octal escapes" {
    let del = str_from_code_point(127)
    assert_eq_str("del", c_string_literal("x".concat(del)), #""x\177""#)
    let unit_sep = str_from_code_point(31)
    assert_eq_str("unit separator", c_string_literal(unit_sep), #""\037""#)
}

test "a multi-byte character passes through unchanged" {
    assert_eq_str("two byte", c_string_literal("café"), "\"café\"")
    assert_eq_str("three byte", c_string_literal("a→b"), "\"a→b\"")
    assert_eq_str("four byte", c_string_literal("😀"), "\"😀\"")
}

test "escapes at the edges and next to each other keep every plain byte" {
    assert_eq_str("leading escape", c_string_literal("\nab"), #""\nab""#)
    assert_eq_str("trailing escape", c_string_literal("ab\n"), #""ab\n""#)
    assert_eq_str("adjacent escapes", c_string_literal("a\n\tb"), #""a\n\tb""#)
    assert_eq_str("only escapes", c_string_literal("\"\\\n"), #""\"\\\n""#)
    assert_eq_str("one plain byte", c_string_literal("z"), #""z""#)
    assert_eq_str("plain after octal", c_string_literal(str_from_code_point(2).concat("9")), #""\0029""#)
}

test "a long string with escapes throughout comes out whole" {
    let input = StringBuilder.new()
    let want = StringBuilder.new()
    want.write("\"")
    let mut i = 0
    while i < 20000 {
        input.write("ab\"c\n")
        want.write(#"ab\"c\n"#)
        i = i + 1
    }
    want.write("\"")
    let got = c_string_literal(input.to_str())
    assert_eq(got.len(), want.len())
    assert_eq(got, want.to_str())
}
