// A tuple has no declaration to name its derived methods from, so they are named from its
// typedef name instead. The key-operations table a Map or a Set binds is spelled from that
// same name, so the two symbols and the table that holds them agree by construction rather
// than by two readers spelling one name the same way.

import cname.{c_tid_derive_method_name, c_typedef_name}
import layout.{layout_of, Position}
import cname_test_helpers.{assert_eq_str, compile_probe, tid_of}

fn probe_src() -> Str {
    #"fn main() {
    let mut m: Map[(Str, Int), Int] = Map()
    let k = ("a", 1)
    m.insert(k, 7)
    let inner = (1, "b")
    let mut n: Map[(Int, (Int, Str)), Int] = Map()
    n.insert((2, inner), 3)
    assert(m.len() == 1)
    assert(n.len() == 1)
}
"#
}

test "a tuple's derived method symbols are spelled from its typedef name" {
    let m = compile_probe("cname_structural_key", probe_src())
    let pair = tid_of(m, "(Str, Int)")
    assert_eq_str("hash", c_tid_derive_method_name(pair, "hash"), "blink_Tuple2_str_int_hash")
    assert_eq_str("eq", c_tid_derive_method_name(pair, "eq"), "blink_Tuple2_str_int_eq")
    assert_eq_str("stem", c_typedef_name(pair), "blink_Tuple2_str_int")
    assert_eq_str("table", layout_of(pair, Position.Param).kops_table, "kops_blink_Tuple2_str_int")
}

// An element that is a tuple is compared and hashed by its own pair of methods, so the
// inner name has to be reachable from the inner type alone.
test "a nested tuple element is named from its own typedef name" {
    let m = compile_probe("cname_structural_key", probe_src())
    let inner = tid_of(m, "(Int, Str)")
    assert_eq_str("inner hash", c_tid_derive_method_name(inner, "hash"), "blink_Tuple2_int_str_hash")
    assert_eq_str("inner eq", c_tid_derive_method_name(inner, "eq"), "blink_Tuple2_int_str_eq")
}
