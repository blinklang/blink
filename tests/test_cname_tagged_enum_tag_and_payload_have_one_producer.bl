// A tagged enum's C shape has three facts: what the tag member is called, what the payload
// union is called, and what type the tag is. Each is written in more than one module today,
// so this pins the one producer of each. The tag is a 32-bit signed integer, which is what
// the typedef declares; the machine-word type is a different width and is not it.

import typecheck.{TYPE_INT}
import layout.{c_type_of, layout_reset, Position, enum_tag_tid}
import cname.{c_enum_tag_member, c_enum_payload_member}
import cname_test_helpers.{assert_eq_str, compile_probe}

fn probe_src() -> Str {
    #"type Shape {
    Circle(r: Int)
    Rect(w: Int, h: Int)
}
fn main() {
    let s: Shape = Shape.Circle(1)
    match s {
        Shape.Circle(r) => assert(r == 1)
        Shape.Rect(w, h) => assert(w == h)
    }
}
"#
}

fn load() ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck {
    compile_probe("cname_tagged_enum_members", probe_src())
    layout_reset()
}

test "the tag member of a tagged enum is named by one producer" {
    assert_eq_str("tag member", c_enum_tag_member(), "tag")
}

test "the payload union of a tagged enum is named by one producer" {
    assert_eq_str("payload member", c_enum_payload_member(), "data")
}

test "the tag of a tagged enum is a 32-bit signed integer" {
    load()
    assert_eq_str("tag spelling", c_type_of(enum_tag_tid(), Position.Field), "int32_t")
}

test "the machine-word type is not what the tag declares" {
    load()
    assert_eq_str("machine word", c_type_of(TYPE_INT, Position.Field), "int64_t")
}
