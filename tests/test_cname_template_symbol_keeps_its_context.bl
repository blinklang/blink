// One runtime struct holds every template, but a template of each context is its own
// type, so a name built for a symbol keeps the context. Without it, two contexts'
// instances of one generic declaration share one symbol.

import cname.{c_promote_walker_name}
import cname_test_helpers.{assert_eq_str, compile_probe, tid_of}

fn probe_src() -> Str {
    #"effect DB {
    effect Query {
        fn query(t: Template[DB]) -> Int
    }
}

effect Shell {
    effect Run {
        fn run(t: Template[Shell]) -> Int
    }
}

type Point {
    x: Int
    y: Int
}

fn db(t: Template[DB]) -> Int { t.count() }

fn sh(t: Template[Shell]) -> Int { t.count() }

fn pt(t: Template[Point]) -> Int { t.count() }

fn dbs(ts: List[Template[DB]]) -> Int { ts.len() }

fn main() {
    let n = 1
    assert(db("n={n}") + sh("n={n}") + pt("n={n}") == 3)
}
"#
}

test "a template's symbol name keeps its effect context" {
    let m = compile_probe("cname_template_symbol", probe_src())
    assert_eq_str("db", c_promote_walker_name(tid_of(m, "Template[DB]")), "blink_promote_Template_DB")
    assert_eq_str("shell", c_promote_walker_name(tid_of(m, "Template[Shell]")), "blink_promote_Template_Shell")
    assert_eq_str("list of db", c_promote_walker_name(tid_of(m, "List[Template[DB]]")), "blink_promote_List_template_DB")
}

test "a template over a struct context keeps the struct" {
    let m = compile_probe("cname_template_struct_context", probe_src())
    assert_eq_str("point", c_promote_walker_name(tid_of(m, "Template[Point]")), "blink_promote_Template_Point")
}
