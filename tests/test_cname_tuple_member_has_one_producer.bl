// The C member name of a tuple slot is written on two sides that must agree: the typedef
// that declares the struct, and every access that reads a slot out of it. Three modules
// spelled it independently, so a change to one would have left the typedef and the access
// disagreeing. cc catches that only when the two slots differ in width; two same-width
// neighbours swap silently and the program answers the wrong element.
//
// So the rows below do not merely check a string. The second one emits a real tuple typedef
// and reads the member names back out of it, which is the side of the agreement the string
// alone cannot prove.

import typecheck.{TYPE_INT, TYPE_STR, make_tuple_type}
import layout.{ensure_typedef_for, layout_reset, layout_take_typedefs}
import cname.{c_tuple_member}
import cname_test_helpers.{assert_eq_str, compile_probe}

fn probe_src() -> Str {
    #"fn main() {
    let t = (1, "a")
    let n = t.0
}
"#
}

fn load() ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck {
    compile_probe("cname_tuple_member", probe_src())
    layout_reset()
}

test "the member name of a tuple slot comes from one producer" {
    assert_eq_str("slot 0", c_tuple_member(0), "_0")
    assert_eq_str("slot 7", c_tuple_member(7), "_7")
}

test "the typedef declares the members the producer names" {
    load()
    let tup = make_tuple_type([TYPE_INT, TYPE_STR])
    let _ = ensure_typedef_for(tup)
    let mut body = ""
    for td in layout_take_typedefs() {
        if td.contains("typedef struct") && td.contains(" _0;") { body = td }
    }
    assert(body != "", "expected a tuple typedef to be emitted")
    assert(body.contains(" {c_tuple_member(0)};"), "slot 0 missing from {body}")
    assert(body.contains(" {c_tuple_member(1)};"), "slot 1 missing from {body}")
    assert(!body.contains(" {c_tuple_member(2)};"), "a two-slot tuple declared a third: {body}")
}
