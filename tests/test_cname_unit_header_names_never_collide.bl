// A per-module build writes every header into one directory, and a unit includes headers by
// name, so two headers with one name would make a unit read the wrong declarations. Each
// header also has its own guard: a unit includes a module's two headers and the types header
// together, and one guard shared by two of them would drop the second.

import cname.{
    c_module_header_guard, c_module_header_name, c_module_private_header_guard,
    c_module_private_header_name, c_program_types_header_guard, c_program_types_header_name,
}

fn all_distinct(xs: List[Str]) -> Bool {
    let mut seen: Map[Str, Int] = Map()
    for x in xs {
        if seen.contains_key(x) { return false }
        seen.insert(x, 1)
    }
    true
}

// Module keys that come closest to the fixed names: a key is a C identifier, so it can
// spell every part of them except the dot.
fn keys() -> List[Str] {
    ["blink", "blink_types", "_blink_types", "types", "priv", "__main__", "std_str"]
}

test "no module header is named like another module's header or the types header" {
    let mut names = [c_program_types_header_name()]
    for k in keys() {
        names.push(c_module_header_name(k))
        names.push(c_module_private_header_name(k))
    }
    assert(all_distinct(names), "names: {names.join(",")}")
    assert_eq(c_module_header_name("shapes"), "shapes.h")
    assert_eq(c_module_private_header_name("shapes"), "shapes.priv.h")
}

test "every unit header has its own include guard" {
    let mut guards = [c_program_types_header_guard()]
    for k in keys() {
        guards.push(c_module_header_guard(k))
        guards.push(c_module_private_header_guard(k))
    }
    assert(all_distinct(guards), "guards: {guards.join(",")}")
}
