// `==` on a type with no equality method of its own calls a function built from the type.
// Two element types need two bodies, so the name keeps the element type, and a tuple's
// name must differ from the derived eq a tuple key's table names.

import cname.{c_values_eq_name, c_tid_derive_method_name}
import cname_test_helpers.{assert_eq_str, compile_probe, tid_of}

fn probe_src() -> Str {
    #"fn main() {
    let a: List[Int] = [1]
    let b: List[Str] = ["x"]
    let t = (1, "a")
    assert(a == [1] && b == ["x"] && t == (1, "a"))
}
"#
}

test "a values equality function's name keeps the element type" {
    let m = compile_probe("cname_values_eq", probe_src())
    assert_eq_str("ints", c_values_eq_name(tid_of(m, "List[Int]")), "blink_eq_List_int")
    assert_eq_str("strs", c_values_eq_name(tid_of(m, "List[Str]")), "blink_eq_List_str")
}

test "a tuple's values equality function is not its key table's derived eq" {
    let m = compile_probe("cname_values_eq", probe_src())
    let pair = tid_of(m, "(Int, Str)")
    assert(c_values_eq_name(pair) != c_tid_derive_method_name(pair, "eq"))
}
