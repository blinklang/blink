// `??` applied to a module-level (top-level `let`) Option global emits C that
// declares the coalesce temp as int64_t and then casts the Option carrier
// struct into it, rather than reading the carrier's tag/value fields directly.
// The identical `g ?? 0` expression compiles and runs fine when `g` is a LOCAL
// binding instead of a module-level global; annotating the global's type
// (`let g: Option[Int] = Some(8)`) changes nothing, so this is specifically
// about the coalesce lowering's handling of a global operand, not about type
// inference on the global's declaration.

import compile_test_helpers.{compile_and_run}

test "?? on a module-level Option global compiles and reads the carrier correctly" {
    let src = #"
import std.io
let g = Some(8)
fn main() { io.println("{g ?? 0}") }
"#
    let r = compile_and_run(src, "_coalesce_module_level_option_global")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "8\n")
}
