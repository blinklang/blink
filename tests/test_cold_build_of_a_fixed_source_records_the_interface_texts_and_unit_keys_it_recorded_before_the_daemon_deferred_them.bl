// The daemon now fills the interface texts after its reply, from the same parse, where a check
// once filled them at once. A build keys every unit it keeps on those texts, so a text that
// changed by one byte would make each warm build miss or, worse, match a unit built from other
// bytes. The golden bytes below come from a cold build of this fixture by the compiler before
// that change, and the build after it gave the same bytes. A change that moves them on purpose
// (a new interface text format, or new facts in a unit key) takes new values from a cold build
// of this fixture, and says why in its commit. No object key is pinned: each holds the
// compiler's sha and the sha of its C, so no two compilers share one.

import std.process.{ProcessResult}

let DIR = ".tmp/golden_interface_texts"

let MAIN_INTERFACE: Str = "5:@item6:import6:import6:import5:IDENT5:shape1:.1:.1:\{1:\{5:IDENT5:Shape1:,1:,5:IDENT8:describe1:,1:,5:IDENT6:origin1:\}1:\}7:NEWLINE2:\\n5:@item7:fn main2:fn2:fn5:IDENT4:main1:(1:(1:)1:)1:\{1:\{1:\}1:\}7:NEWLINE2:\\n5:@item3:end3:EOF0:"

let SHAPE_INTERFACE: Str = "7:COMMENT96: A shape module whose interface holds a type, a variant type, a trait, an impl, a const and fns.7:NEWLINE2:\\n5:@item9:let SIDES3:pub3:pub3:let3:let5:IDENT5:SIDES1::1::5:IDENT3:Int1:=1:=3:INT1:47:NEWLINE2:\\n5:@item5:other3:pub3:pub4:type4:type5:IDENT5:Point1:\{1:\{7:NEWLINE2:\\n5:IDENT1:x1::1::5:IDENT3:Int7:NEWLINE2:\\n5:IDENT1:y1::1::5:IDENT3:Int7:NEWLINE2:\\n1:\}1:\}7:NEWLINE2:\\n5:@item5:other3:pub3:pub4:type4:type5:IDENT5:Shape1:\{1:\{7:NEWLINE2:\\n5:IDENT6:Square1:(1:(5:IDENT3:Int1:)1:)7:NEWLINE2:\\n5:IDENT4:Rect1:(1:(5:IDENT3:Int1:,1:,5:IDENT3:Int1:)1:)7:NEWLINE2:\\n1:\}1:\}7:NEWLINE2:\\n5:@item15:trait Area area3:pub3:pub5:trait5:trait5:IDENT4:Area1:\{1:\{7:NEWLINE2:\\n2:fn2:fn5:IDENT4:area1:(1:(4:self4:self1:)1:)2:->2:->5:IDENT3:Int7:NEWLINE2:\\n1:\}1:\}7:NEWLINE2:\\n5:@item5:other4:impl4:impl5:IDENT4:Area3:for3:for5:IDENT5:Shape1:\{1:\{7:NEWLINE2:\\n2:fn2:fn5:IDENT4:area1:(1:(4:self4:self1:)1:)2:->2:->5:IDENT3:Int1:\{1:\{1:\}1:\}7:NEWLINE2:\\n1:\}1:\}7:NEWLINE2:\\n5:@item11:fn describe3:pub3:pub2:fn2:fn5:IDENT8:describe1:(1:(5:IDENT1:s1::1::5:IDENT5:Shape1:)1:)2:->2:->5:IDENT3:Str1:\{1:\{1:\}1:\}7:NEWLINE2:\\n5:@item9:fn helper2:fn2:fn5:IDENT6:helper1:(1:(5:IDENT1:p1::1::5:IDENT5:Point1:)1:)2:->2:->5:IDENT3:Int1:\{1:\{1:\}1:\}7:NEWLINE2:\\n5:@item9:fn origin3:pub3:pub2:fn2:fn5:IDENT6:origin1:(1:(1:)1:)2:->2:->5:IDENT5:Point1:\{1:\{1:\}1:\}7:NEWLINE2:\\n5:@item3:end3:EOF0:"

let SHAPE_SOURCE: Str = "// A shape module whose interface holds a type, a variant type, a trait, an impl, a const and fns.\n\npub let SIDES: Int = 4\n\npub type Point \{\n    x: Int\n    y: Int\n}\n\npub type Shape \{\n    Square(Int)\n    Rect(Int, Int)\n}\n\npub trait Area \{\n    fn area(self) -> Int\n}\n\nimpl Area for Shape \{\n    fn area(self) -> Int \{\n        match self \{\n            Square(s) => s * s\n            Rect(w, h) => w * h\n        }\n    }\n}\n\npub fn describe(s: Shape) -> Str \{\n    let a = s.area()\n    \"area \{a} of \{SIDES} sides\"\n}\n\nfn helper(p: Point) -> Int \{\n    p.x + p.y\n}\n\npub fn origin() -> Point \{\n    Point \{ x: 0, y: helper(Point \{ x: 1, y: -1 }) }\n}\n"

let MAIN_SOURCE: Str = "import shape.\{Shape, describe, origin}\n\nfn main() \{\n    let p = origin()\n    io.println(describe(Shape.Rect(2, 3)))\n    io.println(\"\{p.x},\{p.y}\")\n}\n"

fn sh(cmd: Str) -> ProcessResult {
    process_run("sh", ["-c", cmd])
}

// The interface field the inputs text holds for path: after its file field and its text
// field, as "interface <len>\n<bytes>\n". "" when the text holds no such field.
fn interface_field(inputs: Str, path: Str) -> Str {
    let file_at = match inputs.byte_index_of("file {path.byte_len()}\n{path}\n", 0) {
        Some(i) => i
        None => return ""
    }
    let at = match inputs.byte_index_of("\ninterface ", file_at) {
        Some(i) => i + 1
        None => return ""
    }
    let nl = match inputs.byte_index_of("\n", at) {
        Some(i) => i
        None => return ""
    }
    let len = inputs.byte_slice(at + "interface ".byte_len(), nl).to_int()
    if len < 0 || nl + 1 + len > inputs.byte_len() { return "" }
    inputs.byte_slice(nl + 1, nl + 1 + len)
}

test "a cold build of a fixed source records the interface texts and unit keys it recorded before" {
    let _ = sh("rm -rf {DIR}; mkdir -p {DIR}/src")
    write_file("{DIR}/blink.toml", "[package]\nname = \"golden_app\"\nversion = \"0.1.0\"\n")
    write_file("{DIR}/blink.lock", "[metadata]\nlockfile-version = 1\n")
    write_file("{DIR}/src/shape.bl", SHAPE_SOURCE)
    write_file("{DIR}/src/main.bl", MAIN_SOURCE)
    // The per-module path (the default) writes the record; an empty cache makes the build cold.
    let built = sh("B=$(pwd)/build/blink; cd {DIR} && env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_PER_MODULE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE BLINK_CACHE_DIR=$(pwd)/cache $B build src/main.bl -o out/app")
    let ran = sh("cd {DIR} && ./out/app")
    let inputs = read_file("{DIR}/out/app.units/.emit-inputs")
    let record = read_file("{DIR}/out/app.units/.emit-record")
    if built.exit_code != 0 || interface_field(inputs, "src/shape.bl") != SHAPE_INTERFACE {
        io.eprintln("build: {built.out}{built.err_out}\nshape interface: {interface_field(inputs, "src/shape.bl")}\nmain interface: {interface_field(inputs, "src/main.bl")}\nrecord: {record}")
    }

    assert_eq(built.exit_code, 0)
    assert_eq(ran.out, "area 6 of 4 sides\n0,0\n")
    assert_eq(interface_field(inputs, "src/main.bl"), MAIN_INTERFACE)
    assert_eq(interface_field(inputs, "src/shape.bl"), SHAPE_INTERFACE)
    assert(record.contains("\nentry fba41e32b5bb410e5402760854f5e3e61b81732c768b12a4ac7253a223eacc04\n"))
    assert(record.contains("\nhkey __main__ b2d007e732427cd9fc9eb2d950022283a29a3dfa26ea28b6608d7b5ef7607ea5\n"))
    assert(record.contains("\nhkey shape b2d007e732427cd9fc9eb2d950022283a29a3dfa26ea28b6608d7b5ef7607ea5\n"))
    assert(record.contains("\nunit shape 4279 blink.types.h\nuses shape src/shape.bl\n"))
    assert(record.contains("\nunit __main__ 3077 blink.types.h\nuses __main__ src/main.bl\n"))
}
