// Sibling to the Result-outer collapsed-nested-pattern test:
// a collapsed nested pattern whose OUTER carrier is an Option must dereference the boxed inner
// carrier correctly, the same as when the outer carrier is a Result.

import compile_test_helpers.{compile_and_run}

test.failing(
    "Some(Some(v)) — Option-outer, Option-inner collapsed binds Int",
    reason: "unwrap_carrier's Option branch walks the boxed inner enum's raw .value/.tag fields instead of dereferencing the boxed pointer, so the emitted C treats a pointer field as a struct and cc rejects it",
    ticket: "2k8cz9",
) {
    let src = #"
import std.io

fn main() {
    let c: Option[Option[Int]] = Some(Some(11))
    match c { Some(Some(v)) => { io.println("c={v}") } _ => {} }
}
"#
    let r = compile_and_run(src, "_collapsed_nested_pattern_option_outer_some_some")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "c=11\n")
}

test.failing(
    "Some(Ok(v)) — Option-outer, Result-inner collapsed binds Int",
    reason: "the same Option-outer boxed-carrier walk breaks whenever the inner slot is itself a compound carrier, Result included",
    ticket: "2k8cz9",
) {
    let src = #"
import std.io

fn main() {
    let e: Option[Result[Int, Str]] = Some(Ok(17))
    match e { Some(Ok(v)) => { io.println("e={v}") } _ => {} }
}
"#
    let r = compile_and_run(src, "_collapsed_nested_pattern_option_outer_some_ok")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "e=17\n")
}
