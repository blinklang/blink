import compiler.{compiler_sets_free_space_divisor, tune_compiler_gc, COMPILER_FREE_SPACE_DIVISOR}

@ffi("GC_get_free_space_divisor", header: "gc.h")
@trusted(audit: "Reads the collector's free-space divisor; takes no arguments and returns a GC_word.")
fn collector_free_space_divisor() -> U64 ! FFI {}

@ffi("GC_set_free_space_divisor", header: "gc.h")
@trusted(audit: "Sets the collector's free-space divisor; takes a GC_word and returns nothing.")
fn set_collector_free_space_divisor(divisor: U64) ! FFI {}

test "the compiler sets the divisor only when GC_FREE_SPACE_DIVISOR is unset" {
    assert(compiler_sets_free_space_divisor(None))
    assert(!compiler_sets_free_space_divisor(Some("3")))
    assert(!compiler_sets_free_space_divisor(Some("")))
}

test "an explicit GC_FREE_SPACE_DIVISOR keeps the collector's divisor" {
    let before = collector_free_space_divisor()
    set_collector_free_space_divisor(7)
    tune_compiler_gc(Some("7"))
    assert_eq(collector_free_space_divisor(), 7)
    set_collector_free_space_divisor(before)
}

test "with GC_FREE_SPACE_DIVISOR unset the compiler sets its own divisor" {
    let before = collector_free_space_divisor()
    set_collector_free_space_divisor(7)
    tune_compiler_gc(None)
    assert_eq(collector_free_space_divisor().to_int(), COMPILER_FREE_SPACE_DIVISOR)
    set_collector_free_space_divisor(before)
}
