// The compiler hashes files to key its caches and to check that an installed archive is its
// own. macOS ships `shasum`, not GNU `sha256sum`. A hash that needs `sha256sum` comes back
// empty there, and an installed blink then refuses its own archive on every build.
//
// Each test runs the helper with a PATH that holds `shasum` and the other tools the helper
// needs, but no `sha256sum`, and expects the hash a full PATH gives.

import std_cache_key.{compute_cache_key, sha256_of_file_first}

let DIR = "build/compiler_hashes_shasum_probe"
let BIN = "build/compiler_hashes_shasum_probe/bin"

fn setup() {
    shell_exec("rm -rf {DIR} && mkdir -p {BIN}")
    write_file("{DIR}/compiler", "compiler\n")
    write_file("{DIR}/runtime.h", "int blink_part(void);\n")
    write_file("{DIR}/a.bl", "fn a() \{}\n")
    let tools = ["sh", "awk", "cat", "head", "cut", "dirname", "cc", "shasum"]
    for t in tools {
        let rc = shell_exec("ln -s \"$(command -v {t})\" {BIN}/{t}")
        assert_eq(rc, 0)
    }
}

fn without_sha256sum(f: fn() -> Str) -> Str {
    let path = env.var("PATH") ?? ""
    env.set_var("PATH", "{env.cwd()}/{BIN}")
    let out = f()
    env.set_var("PATH", path)
    out
}

test "a file hash without sha256sum on PATH equals the sha256sum hash" {
    setup()
    let want = sha256_of_file_first("{DIR}/compiler")
    let got = without_sha256sum(fn() { sha256_of_file_first("{DIR}/compiler") })
    shell_exec("rm -rf {DIR}")
    assert_eq(want.len(), 64)
    assert_eq(got, want)
}

test "the stdlib cache key without sha256sum on PATH equals the sha256sum key" {
    setup()
    let key = fn() { compute_cache_key("{DIR}/compiler", DIR, "{DIR}/runtime.h", "manifest\n") }
    let want = key()
    let got = without_sha256sum(key)
    shell_exec("rm -rf {DIR}")
    assert_eq(want.len(), 16)
    assert_eq(got, want)
}
