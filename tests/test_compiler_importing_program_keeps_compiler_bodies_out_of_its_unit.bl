import std.process.{ProcessResult}
import compile_test_helpers

// A program that imports the compiler modules should take their bodies from the prebuilt
// compiler archive, not compile them again in its own unit. Each corpus test that imports
// the compiler otherwise pays for a full compiler compile. The fixture is built the way the
// corpus builds such a test: through the CLI, with --debug, and with BLINK_COMPILER_ARCHIVE
// naming the archive the corpus built for the run.

fn fixture_src() -> Str {
    "import tokens.\{keyword_lookup\}\nimport compiler.\{compile_to_program\}\n\nfn main() \{\n    io.println(\"\{keyword_lookup(\"fn\").to_int()\}\")\n\}\n"
}

fn src_modules() -> List[Str] {
    let listing = process_run("sh", ["-c", "ls src"]).out
    let mut out: List[Str] = []
    for name in listing.split("\n") {
        if name.ends_with(".bl") {
            out.push(name.byte_slice(0, name.byte_len() - 3))
        }
    }
    out
}

// The name of the function a line of C defines, or "" when the line opens no external
// definition. A static function is a private copy, which no archive could hold.
fn defined_fn_name(line: Str) -> Str {
    if !line.ends_with(") \{") { return "" }
    if line.starts_with(" ") || line.starts_with("static") || line.starts_with("typedef") || line.starts_with("extern") || line.starts_with("#") {
        return ""
    }
    let open = line.byte_index_of("(", 0) ?? -1
    if open < 0 { return "" }
    let words = line.byte_slice(0, open).split(" ")
    words.get(words.len() - 1).unwrap().replace("*", "")
}

// The src-module functions the C defines, each with whether it takes the evidence vector.
fn compiler_defs(c: Str) -> List[(Str, Bool)] {
    let mods = src_modules()
    let mut out: List[(Str, Bool)] = []
    for line in c.split("\n") {
        let name = defined_fn_name(line)
        if name == "" { continue }
        for m in mods {
            if name.starts_with("blink_{m}_") {
                out.push((name, line.contains("blink_ev*")))
                break
            }
        }
    }
    out
}

// Scratch paths carry this file's name, so a parallel `blink test` of another file
// cannot write to them.
fn scratch(name: Str) -> Str {
    "{process_run("pwd", []).out.trim()}/build/test_compiler_importing_program_keeps_compiler_bodies_out_of_its_unit-{name}"
}

fn build_archive(dir: Str) {
    let built = process_run("build/blink", ["__build-compiler-archive", dir, "tokens", "compiler"])
    assert_eq(built.exit_code, 0, "the compiler archive did not build:\n{built.err_out}")
    assert(file_exists("{dir}/libblink_compiler.a") != 0, "no compiler archive at {dir}:\n{built.out}{built.err_out}")
}

// The archive the corpus built for this run, or one this test builds from the fixture's
// imports when it runs on its own.
let mut built_archive_dir: Str = ""

fn archive_dir() -> Str {
    if built_archive_dir != "" { return built_archive_dir }
    let mut dir = env.var("BLINK_COMPILER_ARCHIVE") ?? ""
    if dir == "" {
        dir = scratch("archive")
        build_archive(dir)
    }
    // An empty archive would leave nothing out of the program's unit, and the rows that
    // count what the unit defines would pass on it.
    let nm = process_run("nm", ["--defined-only", "{dir}/libblink_compiler.a"])
    assert(nm.out.contains(" T blink_tokens_keyword_1lookup"), "the compiler archive at {dir} does not define the function the fixture calls")
    built_archive_dir = dir
    dir
}

// `env` sets or removes BLINK_COMPILER_ARCHIVE for the one child, so neither mode leaks
// into the other.
fn cli(env_args: List[Str], cli_args: List[Str]) -> ProcessResult {
    let mut args = env_args
    args.push("build/blink")
    for a in cli_args { args.push(a) }
    process_run("env", args)
}

fn emit_c(env_args: List[Str], tag: Str, src: Str) -> Str {
    let path = "{compile_test_helpers.scratch_root()}/_emitc_{tag}.bl"
    write_file(path, src)
    let _ = cli(env_args, ["build", "--emit", "c", "--debug", path])
    fs_remove(path)
    let c_path = "build/_emitc_{tag}.c"
    if file_exists(c_path) == 0 { return "" }
    let c = read_file(c_path)
    fs_remove(c_path)
    c
}

fn fixture_c() -> Str {
    emit_c(["BLINK_COMPILER_ARCHIVE={archive_dir()}"], "compiler_importing_fixture", fixture_src())
}

// The one-unit build, as a program gets it when no compiler archive is named.
fn fixture_c_one_unit() -> Str {
    emit_c(["-u", "BLINK_COMPILER_ARCHIVE"], "compiler_importing_fixture_one_unit", fixture_src())
}

test "the fixture builds and its unit defines main" {
    assert(src_modules().contains("compiler"), "src/ lists no compiler module from this cwd")
    let c = fixture_c()
    assert(c.contains("int main("), "the fixture did not reach codegen")
}

test "the definition scanner finds an external compiler function and skips static ones" {
    let c = "static int blink_tokens_private(int x) \{\nint64_t blink_tokens_is_keyword(const char* s) \{\nconst char* blink_lexer_lex(int64_t n, blink_ev* __ev) \{\nint64_t blink_u_main(void) \{\n"
    let defs = compiler_defs(c)
    assert_eq(defs.len(), 2)
    assert_eq(defs.get(0).unwrap(), ("blink_tokens_is_keyword", false))
    assert_eq(defs.get(1).unwrap(), ("blink_lexer_lex", true))
}

// Without this control the rows below would pass on a scanner that finds nothing.
test "the program's unit defines compiler functions when no compiler archive is named" {
    let c = fixture_c_one_unit()
    assert(c.contains("int main("), "the fixture did not reach codegen")
    let mut plain = 0
    for d in compiler_defs(c) {
        if !d.1 { plain = plain + 1 }
    }
    assert(plain > 0, "the one-unit build defines no compiler function that skips the evidence vector")
}

test "the program built through the compiler archive links and runs" {
    let path = "{compile_test_helpers.scratch_root()}/_linkcli_compiler_importing_fixture.bl"
    let bin = scratch("bin")
    write_file(path, fixture_src())
    let b = cli(["BLINK_COMPILER_ARCHIVE={archive_dir()}"], ["build", "--debug", path, "-o", bin])
    fs_remove(path)
    assert_eq(b.exit_code, 0, "the build failed:\n{b.err_out}")
    let nm = process.run("nm", [bin])?
    assert(nm.out.contains("__blink_init_compiler_globals"), "the binary did not link the compiler archive")
    let r = process.run(bin, [])?
    fs_remove(bin)
    if file_exists("{bin}.c") != 0 { fs_remove("{bin}.c") }
    assert_eq(r.exit_code, 0, "the run failed:\n{r.err_out}")
    assert_eq(r.out.trim(), "0")
}

test "the program's unit defines no compiler function that skips the evidence vector" {
    let c = fixture_c()
    assert(c.contains("int main("), "the fixture did not reach codegen")
    let mut plain: List[Str] = []
    for d in compiler_defs(c) {
        if !d.1 { plain.push(d.0) }
    }
    assert_eq(plain.len(), 0)
}

test "the program's unit defines no compiler function at all" {
    let c = fixture_c()
    assert(c.contains("int main("), "the fixture did not reach codegen")
    assert_eq(compiler_defs(c).len(), 0)
}

// An archive built from another version of a module the program imports would link two
// versions of the compiler into one binary.
test "a compiler archive built from other source than the program imports is refused" {
    let dir = scratch("stale-archive")
    build_archive(dir)
    let copy = "{dir}/src/tokens.bl"
    assert(file_exists(copy) != 0, "the archive keeps no copy of tokens")
    write_file(copy, "{read_file(copy)}\n// changed after the build\n")
    let path = "{compile_test_helpers.scratch_root()}/_stalecli_compiler_importing_fixture.bl"
    write_file(path, fixture_src())
    let r = cli(["BLINK_COMPILER_ARCHIVE={dir}"], ["build", "--emit", "c", "--debug", path])
    fs_remove(path)
    let _ = process.run("rm", ["-rf", dir])?
    assert(r.exit_code != 0, "a stale archive still reached codegen")
    assert(r.err_out.contains("is stale: tokens changed"), "the refusal does not name the changed module:\n{r.err_out}")
    assert(r.err_out.contains("rebuild the compiler archive"), "the refusal does not say to rebuild the archive:\n{r.err_out}")
}

// The archive holds a module by its source text, not its name: a program's own module
// that shares a compiler module's name is not the one the archive holds.
test "a program whose own module is named like a compiler module builds in one unit and runs" {
    let held = read_file("{archive_dir()}/skip_modules.txt").split("\n")
    assert(held.contains("ast"), "the compiler archive holds no module named ast, so this row proves nothing")
    let pkg = scratch("ast-pkg")
    let _ = process.run("rm", ["-rf", pkg])?
    let _ = process.run("mkdir", ["-p", "{pkg}/src"])?
    write_file("{pkg}/blink.toml", "[package]\nname = \"astfixture\"\n")
    write_file("{pkg}/src/ast.bl", "pub fn answer() -> Int \{\n    42\n\}\n")
    write_file("{pkg}/main.bl", "import ast.\{answer\}\n\nfn main() \{\n    io.println(\"\{answer()\}\")\n\}\n")
    let bin = "{pkg}/main"
    let b = cli(["BLINK_COMPILER_ARCHIVE={archive_dir()}"], ["build", "--debug", "{pkg}/main.bl", "-o", bin])
    assert_eq(b.exit_code, 0, "the build failed:\n{b.err_out}")
    let nm = process.run("nm", [bin])?
    let r = process.run(bin, [])?
    let _ = process.run("rm", ["-rf", pkg])?
    assert(!nm.out.contains("__blink_init_compiler_globals"), "the program linked the compiler archive")
    assert_eq(r.exit_code, 0, "the run failed:\n{r.err_out}")
    assert_eq(r.out.trim(), "42")
}

// ── The evidence vector the archive and the program share ───────────────────────────

// A program that runs a compiler function taking the evidence vector, so the archive's
// copy of that body reads the vector the program's own unit defines.
fn ev_fixture_src() -> Str {
    [
        #"import tokens.{keyword_lookup}"#,
        #"import lexer.{lex, tokens}"#,
        "",
        #"fn main() {"#,
        #"    lex("fn main() 1")"#,
        #"    io.println("{keyword_lookup("fn").to_int()} {tokens.kinds.len()}")"#,
        "}",
        "",
    ].join("\n")
}

// A program that declares an effect of its own, which gives its vector a slot the archive's
// does not have. `root` names the effect, so a program can also reuse the name of an effect
// the archive holds.
fn own_effect_fixture_src(root: Str) -> Str {
    [
        #"import tokens.{keyword_lookup}"#,
        "",
        #"effect #{root} {"#,
        #"    effect Ask {"#,
        #"        fn ping() -> Int"#,
        "    }",
        "}",
        "",
        #"fn ask() -> Int ! #{root}.Ask {"#,
        #"    #{root.to_lower()}.ping()"#,
        "}",
        "",
        #"fn main() {"#,
        #"    with handler #{root} {"#,
        #"        fn ping() -> Int { 7 }"#,
        #"    } {"#,
        #"        io.println("{keyword_lookup("fn").to_int()} {ask()}")"#,
        "    }",
        "}",
        "",
    ].join("\n")
}

// A program that installs its own handlers around a compiler function the archive holds:
// one for an archive effect and one for IO. The archive's `lex` records an error for a string
// that ends after a backslash, and the archive's `diag_flush` prints it to stderr through IO;
// only the program's eprint_no_nl puts that report on stdout, so the line shows whose handler it called.
fn own_handler_fixture_src() -> Str {
    [
        #"import lexer.{lex}"#,
        #"import diagnostics.{diag_flush}"#,
        "",
        #"fn main() {"#,
        #"    with handler Lex {"#,
        #"    }, handler IO {"#,
        #"        fn eprint_no_nl(msg: Str) { default.print("[mine] {msg}") }"#,
        #"    } {"#,
        #"        lex("\"\\")"#,
        #"        diag_flush()"#,
        "    }",
        "}",
        "",
    ].join("\n")
}

type FixtureRun { linked: Bool, exit_code: Int, out: Str, err_out: Str }

// Builds `src` with the archive named, the way the corpus builds a test, and runs it.
fn build_and_run(tag: Str, src: Str) -> FixtureRun {
    let path = "{compile_test_helpers.scratch_root()}/_evcli_{tag}.bl"
    let bin = scratch("{tag}-bin")
    write_file(path, src)
    let b = cli(["BLINK_COMPILER_ARCHIVE={archive_dir()}"], ["build", "--debug", path, "-o", bin])
    fs_remove(path)
    assert_eq(b.exit_code, 0, "the build of {tag} failed:\n{b.err_out}")
    let nm = process_run("nm", [bin])
    let r = process_run(bin, [])
    fs_remove(bin)
    if file_exists("{bin}.c") != 0 { fs_remove("{bin}.c") }
    FixtureRun { linked: nm.out.contains("__blink_init_compiler_globals"), exit_code: r.exit_code, out: r.out, err_out: r.err_out }
}

// The guarded typedef of the evidence vector in a unit's C, or "" when the unit has none.
fn ev_typedef_block(c: Str) -> Str {
    let open = "#ifndef BLINK_TD_blink_ev\n"
    let start = c.byte_index_of(open, 0) ?? -1
    if start < 0 { return "" }
    let close = "} blink_ev;\n#endif\n"
    let end = c.byte_index_of(close, start) ?? -1
    if end < 0 { return "" }
    c.byte_slice(start, end + close.byte_len())
}

test "the evidence vector scanner takes the guarded typedef and nothing around it" {
    let c = "int a;\n#ifndef BLINK_TD_blink_ev\n#define BLINK_TD_blink_ev\ntypedef struct \{\n    blink_io_vtable* io;\n} blink_ev;\n#endif\nint b;\n"
    assert_eq(ev_typedef_block(c), "#ifndef BLINK_TD_blink_ev\n#define BLINK_TD_blink_ev\ntypedef struct \{\n    blink_io_vtable* io;\n} blink_ev;\n#endif\n")
    assert_eq(ev_typedef_block("int a;\n"), "")
}

// Two units that spell the vector apart read each other's fields at the wrong offsets, and
// C reports nothing: the archive's bodies and the program must compile against one
// typedef text.
test "the archive's bodies and its header spell one evidence vector" {
    let dir = archive_dir()
    let header = ev_typedef_block(read_file("{dir}/libblink_compiler.h"))
    assert(header.contains("ue_diag"), "the compiler archive header carries no evidence vector with the archive's effects:\n{header}")
    assert_eq(ev_typedef_block(read_file("{dir}/monolith.c")), header)
}

test "a program that links the compiler archive takes its evidence vector from the archive header" {
    let c = fixture_c()
    assert(c.contains("#include \"libblink_compiler.h\""), "the program's unit does not read the compiler archive header")
    assert_eq(ev_typedef_block(c), "")
}

// Without this control the row above would pass on a build that wrote no vector at all.
// The program it builds is the one the next row runs: it reaches fewer effects than the
// archive holds, so on its own it spells a vector the archive's bodies would read at other
// offsets, and the run below cannot pass only because the two vectors happen to agree.
test "the one-unit build spells its own evidence vector, shorter than the archive's" {
    let own = ev_typedef_block(emit_c(["-u", "BLINK_COMPILER_ARCHIVE"], "ev_fixture_one_unit", ev_fixture_src()))
    let archive = ev_typedef_block(read_file("{archive_dir()}/libblink_compiler.h"))
    assert(own.contains("blink_io_vtable* io;"), "the one-unit build wrote no evidence vector:\n{own}")
    assert(own.byte_len() < archive.byte_len(), "the program's own vector is not shorter than the archive's:\n{own}")
}

test "a program that runs a compiler function taking the evidence vector links the archive and runs" {
    let r = build_and_run("ev_fixture", ev_fixture_src())
    assert(r.linked, "the binary did not link the compiler archive")
    assert_eq(r.exit_code, 0, "the run failed:\n{r.err_out}")
    assert_eq(r.out.trim(), "0 6")
}

// The program's unit builds the handler values the archive's bodies read from the vector,
// so it must take their vtable types from the archive header and not spell its own.
test "a program that links the compiler archive takes an archive effect's vtable from the header" {
    let c = emit_c(["BLINK_COMPILER_ARCHIVE={archive_dir()}"], "own_handler_fixture", own_handler_fixture_src())
    assert(c.contains("blink_ue_lex_vtable*"), "the program's unit installs no Lex handler:\n{c}")
    assert(!c.contains("} blink_ue_lex_vtable;"), "the program's unit spells its own Lex vtable")
    assert(read_file("{archive_dir()}/libblink_compiler.h").contains("} blink_ue_lex_vtable;"), "the compiler archive header has no Lex vtable")
}

test "a program that installs its own handlers around an archive body links the archive and the body calls them" {
    let r = build_and_run("own_handler_fixture", own_handler_fixture_src())
    assert(r.linked, "the binary did not link the compiler archive")
    assert_eq(r.exit_code, 0, "the run failed:\n{r.err_out}")
    assert(r.out.starts_with("[mine] error[UnterminatedLiteral]: unterminated string literal"), r.out)
}

test "a program that declares an effect of its own builds in one unit and runs" {
    let r = build_and_run("own_effect_fixture", own_effect_fixture_src("Extra"))
    assert(!r.linked, "a program with an effect the archive does not hold linked the compiler archive")
    assert_eq(r.exit_code, 0, "the run failed:\n{r.err_out}")
    assert_eq(r.out.trim(), "0 7")
}

// The archive holds an effect by the module that declares it, not by its name.
test "a program that declares its own effect under an archive effect's name builds in one unit and runs" {
    assert(read_file("{archive_dir()}/libblink_compiler.h").contains("ue_lex"), "the compiler archive holds no Lex effect, so this row proves nothing")
    let r = build_and_run("same_name_effect_fixture", own_effect_fixture_src("Lex"))
    assert(!r.linked, "a program with its own Lex effect linked the compiler archive")
    assert_eq(r.exit_code, 0, "the run failed:\n{r.err_out}")
    assert_eq(r.out.trim(), "0 7")
}
