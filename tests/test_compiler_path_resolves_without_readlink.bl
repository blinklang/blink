// The compiler hashes its own binary to key its caches and to check that an installed archive
// is its own. A path found through a child `readlink -f` is empty where that tool is missing
// (macOS before 12.3), and an installed blink then refuses its own archive on every build.
//
// The test finds the path with a PATH that holds no tools at all, and expects the path a full
// PATH gives.

import std_cache_key.{archive_compiler_path}
import std.fs.{FsErrorExt}

// A stat that fails for another reason than a missing entry counts as there.
fn path_exists(path: Str) -> Bool ! FS.Read {
    match fs.stat(path) {
        Ok(_) => true
        Err(e) => !e.not_found()
    }
}

let DIR = "build/compiler_path_no_readlink_probe"

test "the compiler path needs no tool on PATH" {
    process.run("sh", ["-c", "rm -rf {DIR} && mkdir -p {DIR}"])?
    let want = archive_compiler_path()
    let path = env.var("PATH") ?? ""
    env.set_var("PATH", "{env.cwd()}/{DIR}")
    let got = archive_compiler_path()
    env.set_var("PATH", path)
    process.run("sh", ["-c", "rm -rf {DIR}"])?
    assert(want.starts_with("/"))
    assert(path_exists(want))
    assert_eq(got, want)
}
