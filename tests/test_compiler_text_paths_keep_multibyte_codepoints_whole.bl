// The compiler copies source text between ASCII delimiters when it escapes a string for C,
// for an assert message and for the formatter. Each fixture holds a 2-, 3- and 4-byte
// codepoint (é, €, 😀) next to an escape, where a copy of one byte at a time would cut it.

import compile_test_helpers
import std.process.{ChildEnd}

test "an interpolated string keeps 2-, 3- and 4-byte codepoints next to escapes" {
    let src = "fn main() \{\n    let n = 1\n    io.println(\"a\\té€😀\{n\}é€😀\\\"\")\n\}\n"
    let r = compile_test_helpers.compile_and_run(src, "text_paths_interp")
    assert_eq(r.exit_code, 0)
    assert_eq(r.out, "a\té€😀1é€😀\"\n")
}

test "an assert message keeps 2-, 3- and 4-byte codepoints in the quoted source" {
    let src = "fn main() \{\n    let s = \"é€😀\"\n    assert(\"\{s\}é€😀\" == \"x\")\n\}\n"
    let r = compile_test_helpers.compile_and_run(src, "text_paths_assert")
    assert(r.exit_code != 0)
    assert(r.err_out.contains("assertion failed: assert(\"\{s\}é€😀\" == \"x\")"))
    assert(r.err_out.contains("= é€😀é€😀"))
}

test "a json diagnostic keeps 2-, 3- and 4-byte codepoints in the file name whole" {
    let src = "fn main() \{\n    let x: Int = \"s\"\n    io.println(\"\{x\}\")\n\}\n"
    let output = compile_test_helpers.compile_and_capture(src, "text_paths_a\"é€😀")
    compile_test_helpers.expect_error(output, "E0300", "type mismatch is E0300")
    compile_test_helpers.expect_contains(output, "\"file\":\"{compile_test_helpers.scratch_root()}/text_paths_a\\\"é€😀.bl\"", "json file name keeps the codepoints")
}

test "blink fmt leaves 2-, 3- and 4-byte codepoints next to escapes unchanged" {
    let fixture = "{compile_test_helpers.scratch_root()}/_test_text_paths_fmt_{getpid()}.bl"
    let src = "fn main() \{\n    let n = 1\n    io.println(\"a\\té€😀\{n\}é€😀\\\"\")\n    io.println(\"é€😀\\n\")\n\}\n"
    write_file(fixture, src)
    let r = process.run("build/blink", ["fmt", fixture])?
    let after = read_file(fixture)
    shell_exec("rm -f {fixture}")
    assert_eq(r.end, ChildEnd.Exited(0))
    assert_eq(after, src)
}
