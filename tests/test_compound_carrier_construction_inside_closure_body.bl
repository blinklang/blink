// A compound carrier (Option[Map[K,V]]) constructed INSIDE a closure body must be built
// at the same concrete C type as the enclosing declared cell it is assigned into.

test "Some(map) constructed inside a closure body assigns into an Option[Map[Str,Int]] cell" {
    let mut m: Map[Str, Int] = Map()
    m.insert("a", 1)
    let mut cell: Option[Map[Str, Int]] = None
    let fill = fn() { cell = Some(m) }
    fill()
    let n = match cell {
        Some(mm) => mm.len()
        None => -1
    }
    assert_eq(n, 1)
}
