// A Result nested under another carrier whose Err side is itself compound
// (Option[B]) must spell that Err side from the fn-return marker on both the Ok
// and Err construction arms, not erase it to a lowercase carrier that mismatches
// the declared return type. Companion of the compound-ok-side reconstruction on
// the same fn-return construction path.

type A { v: Int }
type B { w: Int }

fn build(n: Int) -> Option[Result[Option[A], Option[B]]] {
    if n == 0 { Some(Ok(Some(A { v: 1 }))) } else { Some(Err(Some(B { w: 2 }))) }
}

fn main() {
    let a = build(0)
    match a {
        Some(res) => {
            match res {
                Ok(o) => {
                    match o {
                        Some(x) => { assert_eq(x.v == 1, true) }
                        None => assert_eq(1, 0)
                    }
                }
                Err(_e) => assert_eq(1, 0)
            }
        }
        None => assert_eq(1, 0)
    }

    let b = build(1)
    match b {
        Some(res) => {
            match res {
                Ok(_o) => assert_eq(1, 0)
                Err(e) => {
                    match e {
                        Some(y) => { assert_eq(y.w == 2, true) }
                        None => assert_eq(1, 0)
                    }
                }
            }
        }
        None => assert_eq(1, 0)
    }
}
