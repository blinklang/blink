// `==` on `List`, `Set`, `Map`, tuples and a payload enum with no `Eq` derive compares
// values (sections/03_types.md, *Container Equality*). A list compares length and then
// each index. A set or map compares by membership, so insertion order and removed
// entries are not part of the value. An enum with no derive compares the tag and then
// the payload.

@derive(Eq)
type Point {
    x: Int
    y: Int
}

type Shape {
    Circle(r: Int)
    Label(text: Str)
    Dot
}

type Tree {
    Leaf(n: Int)
    Node(kids: List[Tree])
}

fn same[T: Eq](a: List[T], b: List[T]) -> Bool {
    a == b
}

test "List compares length and then each index" {
    let a = [1, 2, 3]
    let b = [1, 2, 3]
    let shorter = [1, 2]
    let other = [1, 2, 4]
    assert(a == b)
    assert(!(a != b))
    assert(a != shorter)
    assert(shorter != a)
    assert(a != other)
    assert(a == a)
    let e1: List[Int] = []
    let e2: List[Int] = []
    assert(e1 == e2)
    assert(e1 != shorter)
}

test "List over Str, Float, Bool and sized ints compares by value" {
    let s1 = ["a", "b"]
    let s2 = ["a".concat(""), "b"]
    assert(s1 == s2)
    assert(s1 != ["a", "c"])
    let nan = 0.0 / 0.0
    let f1 = [1.5, nan, 0.0]
    let f2 = [1.5, nan, -0.0]
    assert(f1 == f2)
    assert(f1 != [1.5, nan, 1.0])
    assert([true, false] == [true, false])
    assert([true, false] != [true, true])
    let u1: List[U8] = [1.to_u8(), 2.to_u8()]
    let u2: List[U8] = [1.to_u8(), 2.to_u8()]
    assert(u1 == u2)
}

test "nested lists, lists of structs and lists of tuples compare by value" {
    let a = [[1, 2], [3]]
    let b = [[1, 2], [3]]
    let c = [[1, 2], [4]]
    assert(a == b)
    assert(a != c)
    let p = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }]
    let q = [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }]
    let r = [Point { x: 1, y: 2 }, Point { x: 3, y: 5 }]
    assert(p == q)
    assert(p != r)
    let t1 = [(1, "a"), (2, "b")]
    let t2 = [(1, "a"), (2, "b")]
    assert(t1 == t2)
    assert(t1 != [(1, "a"), (2, "c")])
}

test "a List under a bounded type parameter compares by value" {
    assert(same([1, 2], [1, 2]))
    assert(!same([1, 2], [2, 1]))
    assert(same(["x"], ["x"]))
}

test "Set ignores insertion order" {
    let mut a: Set[Int] = Set()
    a.insert(1)
    a.insert(2)
    a.insert(3)
    let mut b: Set[Int] = Set()
    b.insert(3)
    b.insert(1)
    b.insert(2)
    assert(a == b)
    assert(!(a != b))
}

test "Set of equal size with different members is not equal" {
    let mut a: Set[Int] = Set()
    a.insert(1)
    a.insert(2)
    let mut b: Set[Int] = Set()
    b.insert(1)
    b.insert(3)
    assert(a != b)
    assert(!(a == b))
    let mut c: Set[Int] = Set()
    c.insert(1)
    assert(a != c)
    assert(c != a)
}

test "Set ignores removed members and compares Str members by value" {
    let mut a: Set[Str] = Set()
    a.insert("x")
    a.insert("y")
    a.insert("z")
    let _ = a.remove("y")
    let mut b: Set[Str] = Set()
    b.insert("z")
    b.insert("x".concat(""))
    assert(a == b)
    let e1: Set[Str] = Set()
    let e2: Set[Str] = Set()
    assert(e1 == e2)
    assert(e1 != b)
}

test "Map ignores insertion order" {
    let mut a: Map[Str, Int] = Map()
    a["one"] = 1
    a["two"] = 2
    a["three"] = 3
    let mut b: Map[Str, Int] = Map()
    b["three"] = 3
    b["one"] = 1
    b["two"] = 2
    assert(a == b)
    assert(!(a != b))
}

test "Map of equal size with different keys or values is not equal" {
    let mut a: Map[Int, Int] = Map()
    a[1] = 10
    a[2] = 20
    let mut other_key: Map[Int, Int] = Map()
    other_key[1] = 10
    other_key[3] = 20
    let mut other_value: Map[Int, Int] = Map()
    other_value[1] = 10
    other_value[2] = 21
    assert(a != other_key)
    assert(!(a == other_key))
    assert(a != other_value)
    assert(!(a == other_value))
    let mut small: Map[Int, Int] = Map()
    small[1] = 10
    assert(a != small)
    assert(small != a)
}

test "Map ignores removed entries and compares container values by value" {
    let mut a: Map[Str, List[Int]] = Map()
    a["k"] = [1, 2]
    a["gone"] = [9]
    a["m"] = [3]
    let _ = a.remove("gone")
    let mut b: Map[Str, List[Int]] = Map()
    b["m"] = [3]
    b["k"] = [1, 2]
    assert(a == b)
    b["m"] = [4]
    assert(a != b)
}

test "tuples compare element by element" {
    let a = (1, "a", true)
    let b = (1, "a", true)
    let c = (1, "b", true)
    assert(a == b)
    assert(a != c)
    let n1 = ((1, 2), [3])
    let n2 = ((1, 2), [3])
    let n3 = ((1, 2), [4])
    assert(n1 == n2)
    assert(n1 != n3)
}

test "Option and Result over containers compare the payload by value" {
    let a: Option[List[Int]] = Some([1])
    let b: Option[List[Int]] = Some([1])
    let c: Option[List[Int]] = Some([2])
    let none: Option[List[Int]] = None
    assert(a == b)
    assert(a != c)
    assert(a != none)
    assert(none == None)
    let ok1: Result[List[Int], Str] = Ok([1, 2])
    let ok2: Result[List[Int], Str] = Ok([1, 2])
    let err: Result[List[Int], Str] = Err("x")
    assert(ok1 == ok2)
    assert(ok1 != err)
}

test "an enum with no derive compares the tag and then the payload" {
    assert(Shape.Circle(1) == Shape.Circle(1))
    assert(Shape.Circle(1) != Shape.Circle(2))
    assert(Shape.Circle(1) != Shape.Dot)
    assert(Shape.Dot == Shape.Dot)
    assert(Shape.Label("a") == Shape.Label("a".concat("")))
    assert(Shape.Label("a") != Shape.Label("b"))
    assert([Shape.Dot, Shape.Circle(3)] == [Shape.Dot, Shape.Circle(3)])
}

test "an enum with no derive that holds a List of itself compares by value" {
    let a = Tree.Node([Tree.Leaf(1), Tree.Node([Tree.Leaf(2)])])
    let b = Tree.Node([Tree.Leaf(1), Tree.Node([Tree.Leaf(2)])])
    let c = Tree.Node([Tree.Leaf(1), Tree.Node([Tree.Leaf(3)])])
    assert(a == b)
    assert(a != c)
    assert(Tree.Leaf(1) != Tree.Node([]))
}
