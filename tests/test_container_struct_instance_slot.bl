// br bwyfy1 (codegen-structured-tids epic, project nqq29j). The recon-identified
// gap in the -1-hole family: NO existing fixture covers a struct INSTANCE used as
// a CONTAINER element — a List element (`List[Box[Int]]`) or a Map value
// (`Map[Str, Box[Int]]`). These are exactly the slot shapes STEP B newly admits
// onto the structured-tid path once tc_tid_encodable stops deferring struct/enum
// instances and the register_struct_instance_from_tid -1-hole is closed.
//
// These container-element shapes already round-tripped via the STRING inference
// path (they emit blink_Box_Int, never bare blink_Box), so this fixture is a
// REGRESSION GUARD, not a red-first spec: STEP B flips struct/enum INSTANCE slots
// onto the structured-tid path, and the guard proves the tid path spells them
// byte-identically to the string path so the inner Int/Str still survives insert +
// read. The failure it prevents is a STEP-B de-holing that erases an instance slot
// back to the bare head (blink_Box) — a cc "unknown type name" both gens agree on.
//
// Sibling of test_nss31w (generic-fn struct-instance ARG) and test_zrybya
// (compound-of-scalar FIELD); this one exercises the STRUCT-INSTANCE-IN-CONTAINER
// slot the family never touched, plus the generic-fn mono-CSV, tuple-of-struct
// (B3), and nested-instance (B4) tid paths.

type Box[T] {
    value: T
}

type Pt {
    x: Int
    y: Int
}

fn ident[T](v: T) -> T {
    v
}

test "List[Box[Int]] round-trips the inner Int through the element carrier" {
    let mut xs: List[Box[Int]] = []
    xs.push(Box { value: 42 })
    xs.push(Box { value: 7 })
    assert_eq(xs.get(0).unwrap().value, 42)
    assert_eq(xs.get(1).unwrap().value, 7)
    assert_eq(xs.len(), 2)
}

test "Map[Str, Box[Int]] round-trips the inner Int through the value carrier" {
    let mut m: Map[Str, Box[Int]] = Map()
    m.insert("a", Box { value: 100 })
    m.insert("b", Box { value: 200 })
    assert_eq(m.get("a").unwrap().value, 100)
    assert_eq(m.get("b").unwrap().value, 200)
}

test "List[Box[Str]] element carrier stays on the Str spelling" {
    let mut xs: List[Box[Str]] = []
    xs.push(Box { value: "boxed" })
    assert_eq(xs.get(0).unwrap().value, "boxed")
}

// B3: a tuple whose element is a bare struct, passed through a generic fn `T`.
// The mono suffix must ride the tid path (tc_mono_csv → tc_tid_tuple_tag) and
// spell the struct element via c_type_tag_for_struct, byte-identical to the
// string path's resolve_tuple_ann — round-tripping the struct field.
test "tuple with struct element round-trips through a generic fn" {
    let t = ident((Pt { x: 3, y: 4 }, 5))
    assert_eq(t.0.x, 3)
    assert_eq(t.0.y, 4)
    assert_eq(t.1, 5)
}

test "Box[Int] instance round-trips through a generic fn (mono-CSV tid path)" {
    let b = ident(Box { value: 77 })
    assert_eq(b.value, 77)
}

// B4: a NESTED struct-instance slot (Box[Box[Int]]) must carry its real slot tid
// in arg_tids (not -1) and round-trip via the recursing tid encoder to Box_Box_Int.
test "Box[Box[Int]] nested instance round-trips through a generic fn" {
    let b = ident(Box { value: Box { value: 88 } })
    assert_eq(b.value.value, 88)
}

test "List[Box[Box[Int]]] doubly-nested container element round-trips" {
    let mut xs: List[Box[Box[Int]]] = []
    xs.push(Box { value: Box { value: 9 } })
    assert_eq(xs.get(0).unwrap().value.value, 9)
}

// GREEN control: a plain-scalar container element must stay undisturbed.
test "List[Int] container element is undisturbed" {
    let mut xs: List[Int] = []
    xs.push(1)
    xs.push(2)
    assert_eq(xs.get(1).unwrap(), 2)
}
