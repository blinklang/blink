// kk0mv7: Contains for List (element membership) and Map (key membership).
// Per nrbq84 §3.2.2. List.contains is a codegen intrinsic with per-element-type
// dispatch (primitives: Int, Bool, Str, Float). Map.contains mirrors contains_key.

test "List.contains: Int element present/absent" {
    let l = [1, 2, 3]
    assert(l.contains(2))
    assert(!l.contains(5))
}

test "List.contains: Str element present/absent" {
    let l = ["a", "b"]
    assert(l.contains("b"))
    assert(!l.contains("z"))
}

test "List.contains: Float element present/absent" {
    let l = [1.5, 2.5]
    assert(l.contains(2.5))
    assert(!l.contains(9.9))
}

test "List.contains: Bool element" {
    let l = [true, false]
    assert(l.contains(false))
}

test "List.contains: empty list is false" {
    let l: List[Int] = []
    assert(!l.contains(1))
}

test "Map.contains: key present/absent, contains_key still works" {
    let mut m: Map[Str, Int] = Map()
    m.insert("a", 1)
    assert(m.contains("a"))
    assert(!m.contains("b"))
    assert(m.contains_key("a"))
    assert(!m.contains_key("b"))
}
