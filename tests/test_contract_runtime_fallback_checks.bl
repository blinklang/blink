// sections/03b_contracts.md 3b.4: with no SMT solver every contract is Unknown, and
// `@verify(fallback: "runtime")` turns an Unknown contract into a runtime check.
// `@verify(fallback: "trust")` accepts it with no check. A @where refinement needs no
// @verify: 3b.1 checks it at every boundary the solver cannot, which today is every boundary.

import compile_test_helpers
import diagnostics.{diag_explain, CONTRACT_UNVERIFIABLE}

// ── @requires ─────────────────────────────────────────────────────────

test "a runtime-fallback @requires aborts on a violating argument" {
    let src = "@requires(x > 0)\n@verify(fallback: \"runtime\")\nfn rq_pos(x: Int) -> Int \{ x }\nfn main() \{ rq_pos(0) }\n"
    let r = compile_test_helpers.compile_and_run(src, "_crf_req_bad")
    assert(r.exit_code != 0)
    assert(r.err_out.contains("precondition failed"))
}

test "a runtime-fallback @requires lets a satisfying argument through" {
    let src = "@requires(x > 0)\n@verify(fallback: \"runtime\")\nfn rq_pos(x: Int) -> Int \{ x }\nfn main() \{\n    assert(rq_pos(4) == 4)\n}\n"
    let r = compile_test_helpers.compile_and_run(src, "_crf_req_ok")
    assert(r.exit_code == 0)
}

// ── @ensures on every exit ────────────────────────────────────────────

test "a runtime-fallback @ensures aborts when the tail value violates it" {
    let src = "@ensures(result > 100)\n@verify(fallback: \"runtime\")\nfn en_tail(x: Int) -> Int \{ x }\nfn main() \{ en_tail(1) }\n"
    let r = compile_test_helpers.compile_and_run(src, "_crf_ens_tail")
    assert(r.exit_code != 0)
    assert(r.err_out.contains("postcondition failed"))
}

test "a runtime-fallback @ensures aborts when an early return violates it" {
    let src = "@ensures(result >= 0)\n@verify(fallback: \"runtime\")\nfn en_early(x: Int) -> Int \{\n    if x < 0 \{ return x }\n    x\n}\nfn main() \{ en_early(0 - 3) }\n"
    let r = compile_test_helpers.compile_and_run(src, "_crf_ens_early")
    assert(r.exit_code != 0)
    assert(r.err_out.contains("postcondition failed"))
}

test "a runtime-fallback @ensures holds on an early return that satisfies it" {
    let src = "@ensures(result >= 0)\n@verify(fallback: \"runtime\")\nfn en_clamp(x: Int) -> Int \{\n    if x < 0 \{ return 0 }\n    x\n}\nfn main() \{\n    assert(en_clamp(0 - 3) == 0)\n    assert(en_clamp(5) == 5)\n}\n"
    let r = compile_test_helpers.compile_and_run(src, "_crf_ens_early_ok")
    assert(r.exit_code == 0)
}

test "a runtime-fallback @ensures aborts when the failure arm of ? violates it" {
    let src = "fn en_fail(x: Int) -> Result[Int, Str] \{\n    if x < 0 \{ return Err(\"neg\") }\n    Ok(x)\n}\n@ensures(result.is_ok())\n@verify(fallback: \"runtime\")\nfn en_try(x: Int) -> Result[Int, Str] \{\n    let v = en_fail(x)?\n    Ok(v + 1)\n}\nfn main() \{\n    let _ = en_try(0 - 1)\n}\n"
    let r = compile_test_helpers.compile_and_run(src, "_crf_ens_try")
    assert(r.exit_code != 0)
    assert(r.err_out.contains("postcondition failed"))
}

test "an old() snapshot of a Float keeps the Float's C type" {
    let src = "@ensures(result >= old(x))\n@verify(fallback: \"runtime\")\nfn en_up(x: Float) -> Float \{ x + 0.5 }\nfn main() \{\n    assert(en_up(1.25) == 1.75)\n}\n"
    let c = compile_test_helpers.compile_and_emit_c(src, "_crf_old_float_c")
    assert(c.contains("double __old_"))
    let r = compile_test_helpers.compile_and_run(src, "_crf_old_float_run")
    assert(r.exit_code == 0)
}

test "an old() snapshot is taken at entry, before the body changes what it reads" {
    let src = "type Ctr \{ n: Int }\n@ensures(result == old(c.n) + 1)\n@verify(fallback: \"runtime\")\nfn en_bump(c: Ctr) -> Int \{\n    let mut d = c\n    d.n = d.n + 1\n    d.n\n}\nfn main() \{\n    assert(en_bump(Ctr \{ n: 4 }) == 5)\n}\n"
    let r = compile_test_helpers.compile_and_run(src, "_crf_old_entry")
    assert(r.exit_code == 0)
}

// ── trust and bad values ──────────────────────────────────────────────

test "a trust-fallback contract emits no check and lets a violating call run" {
    let src = "@requires(x > 0)\n@ensures(result > 100)\n@verify(fallback: \"trust\")\nfn tr_any(x: Int) -> Int \{ x }\nfn main() \{ tr_any(0) }\n"
    let c = compile_test_helpers.compile_and_emit_c(src, "_crf_trust_c")
    assert(!c.contains("precondition failed"))
    assert(!c.contains("postcondition failed"))
    let r = compile_test_helpers.compile_and_run(src, "_crf_trust_run")
    assert(r.exit_code == 0)
}

test "a fallback other than runtime or trust is refused" {
    let src = "@requires(x > 0)\n@verify(fallback: \"sometimes\")\nfn bad_fb(x: Int) -> Int \{ x }\nfn main() \{ bad_fb(1) }\n"
    let out = compile_test_helpers.compile_and_capture(src, "_crf_bad_fallback")
    assert(out.contains("E1110"))
}

test "@verify on a function with no contract is accepted" {
    let src = "@verify(fallback: \"runtime\")\nfn no_ct(x: Int) -> Int \{ x }\nfn main() \{\n    assert(no_ct(2) == 2)\n}\n"
    let r = compile_test_helpers.compile_and_run(src, "_crf_verify_alone")
    assert(r.exit_code == 0)
}

// ── no @verify: V0003 ─────────────────────────────────────────────────

test "a contract with no @verify is refused with V0003" {
    let src = "@requires(x > 0)\nfn un_req(x: Int) -> Int \{ x }\nfn main() \{ un_req(0) }\n"
    let out = compile_test_helpers.compile_and_capture(src, "_crf_unannotated")
    assert(out.contains("V0003"), "got: {out}")
    assert(out.contains("ContractUnverifiable"), "got: {out}")
    assert(out.contains("Simplify the contract predicate"), "got: {out}")
    assert(out.contains("to insert a runtime check"), "got: {out}")
    assert(out.contains("to accept without verification"), "got: {out}")
}

test "an @ensures with no @verify is refused with V0003" {
    let src = "@ensures(result >= 0)\nfn un_ens(x: Int) -> Int \{ x }\nfn main() \{ un_ens(1) }\n"
    let out = compile_test_helpers.compile_and_capture(src, "_crf_unannotated_ens")
    assert(out.contains("V0003"), "got: {out}")
}

test "each contract with no @verify gets its own V0003" {
    let src = "@requires(x > 0)\n@ensures(result > 0)\nfn un_two(x: Int) -> Int \{ x }\nfn main() \{ un_two(1) }\n"
    let out = compile_test_helpers.compile_and_capture(src, "_crf_unannotated_two")
    assert_eq(out.split("V0003").len() - 1, 2)
}

test "a predicate already refused as undecidable gets no V0003" {
    let src = "@requires(result > 0)\nfn un_bad(x: Int) -> Int \{ x }\nfn main() \{ un_bad(1) }\n"
    let out = compile_test_helpers.compile_and_capture(src, "_crf_unannotated_rejected")
    assert(out.contains("E1304"), "got: {out}")
    assert(!out.contains("V0003"), "got: {out}")
}

test "a contract on an @ffi fn gets E0803 and no V0003" {
    let src = "@ffi(\"strlen\")\n@trusted(audit: \"TEST-CONTRACT-RUNTIME-FALLBACK\")\n@requires(true)\nfn c_strlen(s: Ptr[U8]) -> Int ! FFI \{ }\nfn main() \{ }\n"
    let out = compile_test_helpers.compile_and_capture(src, "_crf_unannotated_ffi")
    assert(out.contains("E0803"), "got: {out}")
    assert(!out.contains("V0003"), "got: {out}")
}

test "the V0003 explainer names both fallbacks" {
    let text = diag_explain(CONTRACT_UNVERIFIABLE)
    assert(text.contains("ContractUnverifiable"), "got: {text}")
    assert(text.contains("@verify(fallback: \"runtime\")"), "got: {text}")
    assert(text.contains("@verify(fallback: \"trust\")"), "got: {text}")
}

// ── impl methods ──────────────────────────────────────────────────────

test "an impl method contract with no @verify is refused with V0003" {
    let src = "type Ctr \{ n: Int }\ntrait Bump \{\n    fn bump(self, x: Int) -> Int\n}\nimpl Bump for Ctr \{\n    @requires(x > 0)\n    fn bump(self, x: Int) -> Int \{ self.n + x }\n}\nfn main() \{ let _ = Ctr \{ n: 1 }.bump(1) }\n"
    let out = compile_test_helpers.compile_and_capture(src, "_crf_impl_unannotated")
    assert(out.contains("V0003"), "got: {out}")
}

test "an impl method with a trust fallback compiles and emits no check" {
    let src = "type Ctr \{ n: Int }\ntrait Bump \{\n    fn bump(self, x: Int) -> Int\n}\nimpl Bump for Ctr \{\n    @requires(x > 0)\n    @verify(fallback: \"trust\")\n    fn bump(self, x: Int) -> Int \{ self.n + x }\n}\nfn main() \{\n    assert(Ctr \{ n: 1 }.bump(0) == 1)\n}\n"
    let c = compile_test_helpers.compile_and_emit_c(src, "_crf_impl_trust_c")
    assert(!c.contains("precondition failed"))
    let r = compile_test_helpers.compile_and_run(src, "_crf_impl_trust_run")
    assert(r.exit_code == 0, "got: {r.out}{r.err_out}")
}

test "a runtime fallback on an impl method reports its stage is not built" {
    let src = "type Ctr \{ n: Int }\ntrait Bump \{\n    fn bump(self, x: Int) -> Int\n}\nimpl Bump for Ctr \{\n    @requires(x > 0)\n    @verify(fallback: \"runtime\")\n    fn bump(self, x: Int) -> Int \{ self.n + x }\n}\nfn main() \{ let _ = Ctr \{ n: 1 }.bump(1) }\n"
    let out = compile_test_helpers.compile_and_capture(src, "_crf_impl_runtime")
    assert(out.contains("I0004"), "got: {out}")
}

// ── @where at the param and return boundaries ─────────────────────────

test "a @where refinement aborts when a parameter violates it" {
    let src = "type Pct = Int @where(self >= 0 && self <= 100)\nfn use_pct(p: Pct) -> Int \{ p }\nfn main() \{ use_pct(101) }\n"
    let r = compile_test_helpers.compile_and_run(src, "_crf_where_param")
    assert(r.exit_code != 0)
    assert(r.err_out.contains("refinement violated"))
}

test "a @where refinement aborts when a returned value violates it" {
    let src = "type Pct = Int @where(self >= 0 && self <= 100)\nfn mk_pct(x: Int) -> Pct \{ x }\nfn main() \{ mk_pct(0 - 1) }\n"
    let r = compile_test_helpers.compile_and_run(src, "_crf_where_ret")
    assert(r.exit_code != 0)
    assert(r.err_out.contains("refinement violated"))
}

test "a @where refinement over a Str checks through a method call" {
    let src = "type Name = Str @where(self.len() > 0)\nfn greet(n: Name) -> Int \{ n.len() }\nfn main() \{\n    assert(greet(\"ab\") == 2)\n    greet(\"\")\n}\n"
    let r = compile_test_helpers.compile_and_run(src, "_crf_where_str")
    assert(r.exit_code != 0)
    assert(r.err_out.contains("refinement violated"))
}
