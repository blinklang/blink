// A conversion runs the impl whose source type is the value's type. An alias source is
// its target type, so `impl From[Meters]` answers a Meters value. Every type converts to
// itself (section 3c.2), and Int widens to Float through From.

type Meters = Int

type Bag {
    n: Int
}

impl From[Meters] for Bag {
    fn from(m: Meters) -> Bag { Bag { n: m * 10 } }
}

test "into and from over an alias source run the impl" {
    let m: Meters = 3
    let b: Bag = m.into()
    let c: Bag = Bag.from(m)
    assert_eq(b.n, 30)
    assert_eq(c.n, 30)
}

test "a Str converts to itself through into and from" {
    let s: Str = "ab"
    let t: Str = s.into()
    let u: Str = Str.from(s)
    assert_eq(t, "ab")
    assert_eq(u, "ab")
}

test "an Int converts to itself through into" {
    let a: Int = 5
    let b: Int = a.into()
    assert_eq(b, 5)
}

test "a struct converts to itself through into" {
    let b = Bag { n: 4 }
    let c: Bag = b.into()
    assert_eq(c.n, 4)
}

test "Int widens to Float through into and from" {
    let a: Int = 7
    let f: Float = a.into()
    let g: Float = Float.from(a)
    assert_eq(f, 7.0)
    assert_eq(g, 7.0)
}
