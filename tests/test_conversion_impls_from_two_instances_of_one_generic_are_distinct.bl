// Two conversion impls whose sources are two instances of one generic type share no
// instance, so both are legal (sections/03_types.md "No Impl Overlap") and each call
// runs its own body. The source names the impl by its whole type, not by its head:
// From[List[Int]] and From[List[Str]] are two impls, not one written twice.

type Count { n: Int }

impl From[List[Int]] for Count {
    fn from(v: List[Int]) -> Count { Count { n: v.len() } }
}

impl From[List[Str]] for Count {
    fn from(v: List[Str]) -> Count { Count { n: 0 - v.len() } }
}

type Picked { n: Int }

impl TryFrom[Option[Int]] for Picked {
    fn try_from(v: Option[Int]) -> Result[Picked, ConversionError] {
        match v {
            Some(x) => Ok(Picked { n: x })
            None => Err(ConversionError { message: "no int", source_type: "Option[Int]", target_type: "Picked" })
        }
    }
}

impl TryFrom[Option[Str]] for Picked {
    fn try_from(v: Option[Str]) -> Result[Picked, ConversionError] {
        match v {
            Some(s) => Ok(Picked { n: 0 - s.len() })
            None => Err(ConversionError { message: "no str", source_type: "Option[Str]", target_type: "Picked" })
        }
    }
}

type Tally { n: Int }

impl From[Map[Str, Int]] for Tally {
    fn from(m: Map[Str, Int]) -> Tally {
        let mut total = 0
        for k in m.keys() { total = total + (m.get(k) ?? 0) }
        Tally { n: total }
    }
}

impl From[Map[Str, Str]] for Tally {
    fn from(m: Map[Str, Str]) -> Tally { Tally { n: 0 - m.len() } }
}

test "From over two List instances runs the impl each source names" {
    let a = Count.from([1, 2])
    let b = Count.from(["a"])
    assert_eq("{a.n} {b.n}", "2 -1")
}

test "TryFrom over two Option instances runs the impl each source names" {
    let some_int: Option[Int] = Some(7)
    let some_str: Option[Str] = Some("abc")
    let a = Picked.try_from(some_int)
    let b = Picked.try_from(some_str)
    match a {
        Ok(p) => assert_eq(p.n, 7)
        Err(_) => assert(false)
    }
    match b {
        Ok(p) => assert_eq(p.n, -3)
        Err(_) => assert(false)
    }
}

fn int_counts() -> Map[Str, Int] {
    let mut m: Map[Str, Int] = Map()
    m.insert("x", 4)
    m.insert("y", 5)
    m
}

fn str_labels() -> Map[Str, Str] {
    let mut m: Map[Str, Str] = Map()
    m.insert("x", "a")
    m
}

test "From over two Map instances runs the impl each source names" {
    let a = Tally.from(int_counts())
    let b = Tally.from(str_labels())
    assert_eq("{a.n} {b.n}", "9 -1")
}
