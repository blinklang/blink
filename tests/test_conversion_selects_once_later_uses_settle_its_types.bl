// A conversion whose source or target is still open at the call is chosen once inference is
// done (sections/03_types.md 3.4: a later use in the same definition may fix an open type, and
// E0301 fires only if it stays open). A single impl that fits is such a use: it fixes what the
// call left open, as a call to a function fixes its argument. The one-unit build and the
// per-module build agree.

import std.process.{ProcessResult}

fn sh(cmd: Str) -> ProcessResult {
    process.run("sh", ["-c", cmd]).unwrap()
}

fn expect_runs(src: Str, want: Str) {
    let dir = sh("mktemp -d /tmp/blink_conv_late.XXXXXX").out.trim()
    let _ = sh("mkdir -p {dir}/src")
    write_file("{dir}/blink.toml", "[package]\nname = \"app\"\nversion = \"0.1.0\"\n")
    write_file("{dir}/src/main.bl", src)
    let mut ok = true
    for args in ["run --no-per-module", "run --per-module"] {
        let r = sh("B=$(pwd)/build/blink; cd {dir} && timeout 120 $B {args} src/main.bl < /dev/null 2>&1")
        let lines = r.out.trim().split("\n")
        if !r.success() || lines.get(lines.len() - 1) != Some(want) {
            io.eprintln("blink {args}: exit {r.exit_code}\n{r.out}")
            ok = false
        }
    }
    let _ = sh("rm -rf {dir}")
    assert(ok)
}

// `blink check` and `blink build` give the same refusal, and only that one.
fn expect_refused(src: Str, want: Str) {
    let dir = sh("mktemp -d /tmp/blink_conv_late.XXXXXX").out.trim()
    write_file("{dir}/main.bl", src)
    let mut ok = true
    for cmd in ["check", "build"] {
        let r = sh("B=$(pwd)/build/blink; cd {dir} && timeout 120 $B {cmd} main.bl < /dev/null 2>&1")
        let one = r.out.starts_with("1 error(s) found") || r.out.contains("\n1 error(s) found")
        if r.success() || !r.out.contains(want) || !one || r.out.contains("internal compiler error") {
            io.eprintln("blink {cmd}: exit {r.exit_code}\n{r.out}")
            ok = false
        }
    }
    let _ = sh("rm -rf {dir}")
    assert(ok)
}

test "a source an earlier statement settles converts by its settled type" {
    expect_runs(#"type Tally { n: Int }
impl From[Map[Str, Int]] for Tally {
    fn from(m: Map[Str, Int]) -> Tally { Tally { n: m.len() } }
}
fn main() {
    let mut m = Map()
    m.insert("a", 1)
    let a = Tally.from(m)
    let b: Tally = m.into()
    io.println("{a.n} {b.n}")
}
"#, "1 1")
}

test "a source a later statement settles converts by its settled type" {
    expect_runs(#"type X { n: Int }
impl From[List[Int]] for X {
    fn from(xs: List[Int]) -> X { X { n: xs.len() + 1 } }
}
impl From[List[Str]] for X {
    fn from(xs: List[Str]) -> X { X { n: xs.len() + 10 } }
}
fn main() {
    let mut xs = []
    let a = X.from(xs)
    let b: X = xs.into()
    xs.push(1)
    let mut ys = []
    let c = X.from(ys)
    ys.push("s")
    io.println("{a.n} {b.n} {c.n}")
}
"#, "1 1 10")
}

test "the only impl that fits fixes an empty source" {
    expect_runs(#"type Box[T] { v: List[T] }
impl[T] From[List[T]] for Box[T] {
    fn from(xs: List[T]) -> Box[T] { Box { v: xs } }
}
type X { n: Int }
impl From[List[Int]] for X {
    fn from(xs: List[Int]) -> X { X { n: xs.len() + 5 } }
}
fn main() {
    let b: Box[Int] = Box.from([])
    let c: Box[Str] = [].into()
    let x = X.from([])
    io.println("{b.v.len()} {c.v.len()} {x.n}")
}
"#, "0 0 5")
}

test "into for a generic parameter takes the type the impl fills in" {
    expect_runs(#"type Box[T] { v: List[T] }
impl[T] From[List[T]] for Box[T] {
    fn from(xs: List[T]) -> Box[T] { Box { v: xs } }
}
fn take[U](b: Box[U]) -> Int { b.v.len() }
fn show[U: Display](b: Box[U]) -> Str { "{b.v.get(0).unwrap()}" }
fn main() {
    io.println("{take([1, 2].into())} {show(["s"].into())}")
}
"#, "2 s")
}

test "a source no use settles is refused where two impls fit it" {
    expect_refused(#"type X { n: Int }
impl From[List[Int]] for X {
    fn from(xs: List[Int]) -> X { X { n: xs.len() } }
}
impl From[List[Str]] for X {
    fn from(xs: List[Str]) -> X { X { n: xs.len() } }
}
fn main() {
    let a = X.from([])
    io.println("{a.n}")
}
"#, "matches more than one impl")
}

test "a binder only an empty source names is still refused" {
    expect_refused(#"type X { n: Int }
impl[U] From[List[U]] for X {
    fn from(xs: List[U]) -> X { X { n: xs.len() } }
}
fn main() {
    let a = X.from([])
    io.println("{a.n}")
}
"#, "type parameter `U` of `impl From[List[U]] for X` is unbound at this call")
}

test "a source a later statement settles to a type with no impl is refused" {
    expect_refused(#"type X { n: Int }
impl From[List[Int]] for X {
    fn from(xs: List[Int]) -> X { X { n: xs.len() } }
}
fn main() {
    let mut xs = []
    let a = X.from(xs)
    xs.push(true)
    io.println("{a.n}")
}
"#, "List[Bool] does not convert to X")
}

test "an open source the binding blames is reported once" {
    expect_refused(#"type X { n: Int }
impl From[List[Int]] for X {
    fn from(xs: List[Int]) -> X { X { n: xs.len() } }
}
impl From[List[Str]] for X {
    fn from(xs: List[Str]) -> X { X { n: xs.len() } }
}
fn main() {
    let xs = []
    let a = X.from(xs)
    io.println("{a.n}")
}
"#, "error[CannotInferType]")
}

test "the only impl that fits fixes a named empty source" {
    expect_runs(#"type X { n: Int }
impl From[List[Int]] for X {
    fn from(xs: List[Int]) -> X { X { n: xs.len() + 5 } }
}
fn main() {
    let xs = []
    let a = X.from(xs)
    let ys = []
    let b: X = ys.into()
    io.println("{a.n} {b.n}")
}
"#, "5 5")
}

test "one conversion's choice settles the next" {
    expect_runs(#"type X { n: Int }
impl From[List[Int]] for X {
    fn from(xs: List[Int]) -> X { X { n: 1 } }
}
type Y { n: Int }
impl From[List[Int]] for Y {
    fn from(xs: List[Int]) -> Y { Y { n: 2 } }
}
impl From[List[Str]] for Y {
    fn from(xs: List[Str]) -> Y { Y { n: 3 } }
}
fn apply[T](xs: List[T], g: fn(List[T]) -> Y, f: fn(List[T]) -> X) -> Int { g(xs).n * 10 + f(xs).n }
fn main() {
    io.println("{apply([], fn(q) { Y.from(q) }, fn(p) { X.from(p) })}")
}
"#, "21")
}

test "a source that could be the target itself ties with the impl" {
    expect_refused(#"type W { n: Int }
impl From[List[Int]] for W {
    fn from(xs: List[Int]) -> W { W { n: xs.len() } }
}
fn main() {
    let w = W.from([].get(0).unwrap())
    io.println("{w.n}")
}
"#, "matches more than one impl: `impl From[T] for T` and `impl From[List[Int]] for W`")
}

test "a binder the identity and an impl could both fill is reported as unbound" {
    expect_refused(#"type X { n: Int }
impl From[List[Int]] for X {
    fn from(xs: List[Int]) -> X { X { n: xs.len() } }
}
fn take[U](u: U) -> Int { 1 }
fn main() {
    io.println("{take([1].into())}")
}
"#, "type parameter `U` of `take` is unbound at this call")
}

test "an open source the only impl fits two ways is refused" {
    expect_refused(#"type X { n: Int }
impl From[(List[Int], List[Str])] for X {
    fn from(p: (List[Int], List[Str])) -> X { X { n: p.0.len() + p.1.len() } }
}
fn dup[T](x: List[T]) -> (List[T], List[T]) { (x, x) }
fn main() {
    let a = X.from(dup([]))
    io.println("{a.n}")
}
"#, "type parameter `T` of `dup` is unbound at this call")
}

test "a conversion in a generic body takes the body's own type parameter" {
    expect_runs(#"type Box[T] { v: List[T] }
impl[T] From[List[T]] for Box[T] {
    fn from(xs: List[T]) -> Box[T] { Box { v: xs } }
}
fn g[T](t: T) -> Box[T] {
    let b: Box[T] = [].into()
    b.v.push(t)
    b
}
fn h[T](t: T) -> Box[T] {
    let b: Box[T] = Box.from([])
    b.v.push(t)
    b
}
fn main() {
    io.println("{g(1).v.len()} {h("s").v.len()} {g("s").v.get(0).unwrap()}")
}
"#, "1 1 s")
}
