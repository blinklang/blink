// There is no FFI effect (sections/07_trust_modules_metadata.md), so a test fn states the
// effects it has and an @ffi binding states the effects of the C it calls. The bindings listed
// below still carry `! FFI` because the spec does not yet say which effect covers them: errno
// and the GC's switches are C global state, the fd-table calls (close, dup2, pipe, fcntl,
// memfd_create, socketpair, isatty) have no named effect, and the runtime's default handler
// bodies implement an effect themselves. Any other top-level fn in tests/ that the symbol index
// lists under FFI fails this test. Fixture text inside strings is not in the index.

import std.process.{ProcessResult}
import std.json.{json_clear, json_parse, json_get, json_at, json_len, json_as_str}

fn ffi_fns_in(file: Str) -> ProcessResult {
    process_run("sh", ["-c", "$(pwd)/build/blink query tests/{file} --effect FFI"])
}

fn result_names(json: Str) -> List[Str] {
    json_clear()
    let root = json_parse(json)
    assert(root != -1)
    let results = json_get(root, "results")
    let mut names: List[Str] = []
    let mut i = 0
    while i < json_len(results) {
        names.push(json_as_str(json_get(json_at(results, i), "name")))
        i = i + 1
    }
    names
}

test "only the held test @ffi bindings carry an FFI row" {
    let held = [
        "test_arena_process_and_socket_reads_grow_past_first_buffer.bl socketpair_packed",
        "test_arena_stdin_read_bytes_grows_past_first_buffer.bl t_close",
        "test_arena_stdin_read_bytes_grows_past_first_buffer.bl t_dup2",
        "test_arena_stdin_read_bytes_grows_past_first_buffer.bl t_memfd_create",
        "test_boxed_struct_fields_survive_collection_with_typed_layout.bl t_gc_collect",
        "test_compiler_free_space_divisor_yields_to_env.bl collector_free_space_divisor",
        "test_compiler_free_space_divisor_yields_to_env.bl set_collector_free_space_divisor",
        "test_compiler_load_phase_gc_off.bl collector_disable_count",
        "test_ffi_binding_with_a_library_links_and_runs.bl c_cos",
        "test_ffi_binding_with_a_library_links_and_runs.bl c_sqrt",
        "test_ffi_extern_conflict.bl c_atoi",
        "test_ffi_isatty.bl c_isatty",
        "test_io_stdin_reads_take_from_one_stream.bl t_close",
        "test_io_stdin_reads_take_from_one_stream.bl t_dup2",
        "test_io_stdin_reads_take_from_one_stream.bl t_fcntl",
        "test_io_stdin_reads_take_from_one_stream.bl t_memfd_create",
        "test_io_stdin_reads_take_from_one_stream.bl t_pipe",
        "test_libc_bytes.bl t_close",
        "test_libc_bytes.bl t_memfd_create",
        "test_list_elements_survive_collection_whatever_their_slot_kind.bl t_gc_collect",
        "test_process_spawn_gives_the_child_the_null_device_as_stdin.bl t_close",
        "test_process_spawn_gives_the_child_the_null_device_as_stdin.bl t_dup2",
        "test_process_spawn_gives_the_child_the_null_device_as_stdin.bl t_memfd_create",
        "test_ptr_offset_walks_primitive_alloc_n_regions.bl ptr_offset_close",
        "test_ptr_offset_walks_primitive_alloc_n_regions.bl ptr_offset_pipe",
        "test_read_fully_loops_until_n_bytes_or_eof.bl t_close",
        "test_read_fully_loops_until_n_bytes_or_eof.bl t_memfd_create",
        "test_runtime_default_vtable_str_results.bl crypto_default_decrypt",
        "test_runtime_default_vtable_str_results.bl crypto_default_encrypt",
        "test_runtime_default_vtable_str_results.bl crypto_default_hash",
        "test_runtime_default_vtable_str_results.bl crypto_default_sign",
        "test_runtime_default_vtable_str_results.bl net_default_dns",
        "test_str_records_its_codepoint_count_for_every_producer.bl socketpair_packed",
        "test_tcp_handles_report_closed_state.bl socketpair_packed",
        "test_tcp_socket.bl socketpair_packed",
    ]
    let mut found: List[Str] = []
    for file in list_dir("tests") {
        if !file.starts_with("test_") || !file.ends_with(".bl") { continue }
        let r = ffi_fns_in(file)
        if r.exit_code != 0 {
            io.eprintln("tests/{file}:\n{r.out}\nstderr:\n{r.err_out}")
        }
        assert_eq(r.exit_code, 0)
        for name in result_names(r.out) {
            found.push("{file} {name}")
        }
    }
    assert_eq(found.sort().join("\n"), held.join("\n"))
}
