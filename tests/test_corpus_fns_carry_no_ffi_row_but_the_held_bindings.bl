// There is no FFI effect (sections/07_trust_modules_metadata.md), so a test fn states the
// effects it has and an @ffi binding states the effects of the C it calls. The bindings listed
// below still carry `! FFI` because the spec does not yet say which effect covers them: C calls
// whose side effect is hidden C state (atoi, cos and sqrt set errno, strerror shares one buffer),
// the GC's switches, the fd-table calls (close, dup2, pipe, fcntl, memfd_create, socketpair,
// isatty, and lseek on a memfd), and the runtime's default handler bodies, which implement an
// effect themselves. Any other top-level fn in a .bl file under tests/ that the symbol index lists
// under FFI fails this test. The index holds neither impl or trait methods nor fixture text
// inside strings, so this test does not see those.

import std.json.{json_clear, json_parse, json_get, json_at, json_len, json_as_str}
import std.process.{ChildEnd}

fn result_names(json: Str) -> List[Str] {
    json_clear()
    let root = json_parse(json)
    assert(root != -1)
    let results = json_get(root, "results")
    let mut names: List[Str] = []
    let mut i = 0
    while i < json_len(results) {
        names.push(json_as_str(json_get(json_at(results, i), "name")))
        i = i + 1
    }
    names
}

test "only the held test @ffi bindings carry an FFI row" {
    let held = [
        "tests/test_arena_process_and_socket_reads_grow_past_first_buffer.bl socketpair_packed",
        "tests/test_arena_stdin_read_bytes_grows_past_first_buffer.bl t_close",
        "tests/test_arena_stdin_read_bytes_grows_past_first_buffer.bl t_dup2",
        "tests/test_arena_stdin_read_bytes_grows_past_first_buffer.bl t_lseek",
        "tests/test_arena_stdin_read_bytes_grows_past_first_buffer.bl t_memfd_create",
        "tests/test_boxed_struct_fields_survive_collection_with_typed_layout.bl t_gc_collect",
        "tests/test_compiler_free_space_divisor_yields_to_env.bl collector_free_space_divisor",
        "tests/test_compiler_free_space_divisor_yields_to_env.bl set_collector_free_space_divisor",
        "tests/test_compiler_load_phase_gc_off.bl collector_disable_count",
        "tests/test_ffi_binding_with_a_library_links_and_runs.bl c_cos",
        "tests/test_ffi_binding_with_a_library_links_and_runs.bl c_sqrt",
        "tests/test_ffi_extern_conflict.bl c_atoi",
        "tests/test_ffi_isatty.bl c_isatty",
        "tests/test_io_stdin_reads_take_from_one_stream.bl t_close",
        "tests/test_io_stdin_reads_take_from_one_stream.bl t_dup2",
        "tests/test_io_stdin_reads_take_from_one_stream.bl t_fcntl",
        "tests/test_io_stdin_reads_take_from_one_stream.bl t_lseek",
        "tests/test_io_stdin_reads_take_from_one_stream.bl t_memfd_create",
        "tests/test_io_stdin_reads_take_from_one_stream.bl t_pipe",
        "tests/test_libc_bytes.bl t_close",
        "tests/test_libc_bytes.bl t_lseek",
        "tests/test_libc_bytes.bl t_memfd_create",
        "tests/test_list_elements_survive_collection_whatever_their_slot_kind.bl t_gc_collect",
        "tests/test_process_spawn_gives_the_child_the_null_device_as_stdin.bl t_close",
        "tests/test_process_spawn_gives_the_child_the_null_device_as_stdin.bl t_dup2",
        "tests/test_process_spawn_gives_the_child_the_null_device_as_stdin.bl t_lseek",
        "tests/test_process_spawn_gives_the_child_the_null_device_as_stdin.bl t_memfd_create",
        "tests/test_ptr_offset_walks_primitive_alloc_n_regions.bl ptr_offset_close",
        "tests/test_ptr_offset_walks_primitive_alloc_n_regions.bl ptr_offset_pipe",
        "tests/test_read_fully_loops_until_n_bytes_or_eof.bl t_close",
        "tests/test_read_fully_loops_until_n_bytes_or_eof.bl t_lseek",
        "tests/test_read_fully_loops_until_n_bytes_or_eof.bl t_memfd_create",
        "tests/test_runtime_default_vtable_str_results.bl crypto_default_decrypt",
        "tests/test_runtime_default_vtable_str_results.bl crypto_default_encrypt",
        "tests/test_runtime_default_vtable_str_results.bl crypto_default_hash",
        "tests/test_runtime_default_vtable_str_results.bl crypto_default_sign",
        "tests/test_runtime_default_vtable_str_results.bl net_default_dns",
        "tests/test_str_eq_and_hash_agree_for_every_producer.bl libc_strerror",
        "tests/test_str_records_its_codepoint_count_for_every_producer.bl socketpair_packed",
        "tests/test_tcp_handles_report_closed_state.bl socketpair_packed",
        "tests/test_tcp_socket.bl socketpair_packed",
    ]
    // -H: the corpus sandbox links tests/ in, and find does not walk a linked start point.
    let files = process.run("find", ["-H", "tests", "-name", "*.bl"])?
    assert_eq(files.end, ChildEnd.Exited(0))
    let mut found: List[Str] = []
    for path in files.out.trim().split("\n") {
        // The index is built from the parse alone, so a row that names FFI has the text in the
        // file; skipping the rest saves one blink process per test file.
        if !read_file(path).contains("FFI") { continue }
        let r = process.run("build/blink", ["query", path, "--effect", "FFI"])?
        if !r.success() {
            io.eprintln("{path}:\n{r.out}\nstderr:\n{r.err_out}")
        }
        assert_eq(r.end, ChildEnd.Exited(0))
        for name in result_names(r.out) {
            found.push("{path} {name}")
        }
    }
    assert_eq(found.sort().join("\n"), held.join("\n"))
}
