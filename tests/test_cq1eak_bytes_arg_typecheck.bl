import compile_test_helpers

// cq1eak — Bytes intrinsic methods take Int offsets/values; a Float arg must raise E0300.

test "Bytes.push rejects Float arg" {
    let src = "fn main() \{ let b = Bytes()\n b.push(2.0) }\n"
    compile_test_helpers.expect_compile_error(src, "cq1eak_push", "E0300")
}

test "Bytes.push accepts Int arg" {
    let src = "fn main() \{ let b = Bytes()\n b.push(2) }\n"
    compile_test_helpers.expect_no_error(src, "cq1eak_push_ok", "E0300")
}

test "Bytes.get rejects Float index" {
    let src = "fn main() \{ let b = Bytes()\n b.push(1)\n let x = b.get(1.0) }\n"
    compile_test_helpers.expect_compile_error(src, "cq1eak_get", "E0300")
}

test "Bytes.set rejects Float value" {
    let src = "fn main() \{ let b = Bytes()\n b.push(1)\n b.set(0, 9.0) }\n"
    compile_test_helpers.expect_compile_error(src, "cq1eak_set_val", "E0300")
}

test "Bytes.set rejects Float index" {
    let src = "fn main() \{ let b = Bytes()\n b.push(1)\n b.set(0.0, 9) }\n"
    compile_test_helpers.expect_compile_error(src, "cq1eak_set_idx", "E0300")
}

test "Bytes.slice rejects Float bounds" {
    let src = "fn main() \{ let b = Bytes()\n b.push(1)\n let s = b.slice(0, 1.0) }\n"
    compile_test_helpers.expect_compile_error(src, "cq1eak_slice", "E0300")
}

test "Bytes.write_u32_le rejects Float value" {
    let src = "fn main() \{ let b = Bytes()\n b.write_u32_le(5.0) }\n"
    compile_test_helpers.expect_compile_error(src, "cq1eak_write_val", "E0300")
}

test "Bytes.read_u32_le rejects Float offset" {
    let src = "fn main() \{ let b = Bytes()\n b.write_u32_le(5)\n let r = b.read_u32_le(0.0) }\n"
    compile_test_helpers.expect_compile_error(src, "cq1eak_read_off", "E0300")
}

test "Bytes valid Int args compile" {
    let src = "fn main() \{ let b = Bytes()\n b.push(1)\n b.set(0, 2)\n let s = b.slice(0, 1)\n b.write_u32_le(9)\n let r = b.read_u32_le(0) }\n"
    compile_test_helpers.expect_no_error(src, "cq1eak_valid", "E0300")
}
