// br cr4gqk: mangle_generic_name collision, CROSS-KIND shape — a generic FN and a generic
// STRUCT collide on the same mangled name, proving the shared namespace spans both
// mono_fns and mono_instances (they are separate registries but feed one C symbol space).
//
// `fn Box_Inner[T]` (a free fn, despite the capitalized name — Blink fn names are not
// case-restricted) and `type Box[T]` both exist. Box_Inner[Int] mangles to
// mangle_generic_name("Box_Inner", "Int"); Box[Inner[Int]] mangles to
// mangle_generic_name("Box", "Inner_Int") (registered via register_mono_instance, mirroring
// test_cr4gqk_mono_name_collision_struct.bl's struct/struct shape but this time the
// colliding entry is a mono FN, not a mono struct). Before the fix both are
// "Box_Inner_Int": a fn definition and a struct typedef sharing one C name is worse than
// two typedefs sharing a guard — `cc` sees a function and a struct claiming the same
// identifier, an outright redefinition error, not merely a dropped body.
//
// After the fix, "Box_Inner_Int" (the fn) and "Box__Inner_Int" (the struct instance's
// slot-carrying typedef name via mangle_generic_name("Box", "Inner_Int")) are distinct.

type Inner[T] { value: T }
type Box[T] { slot: T }

fn Box_Inner[T](x: T) -> T {
    x
}

fn main() {
    let a = Box_Inner(3)
    let b: Box[Inner[Int]] = Box { slot: Inner { value: 4 } }
    assert(a == 3)
    assert(b.slot.value == 4)
}
