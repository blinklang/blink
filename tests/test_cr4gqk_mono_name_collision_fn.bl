// br cr4gqk: mangle_generic_name collision, fn/fn shape.
//
// `fn wrap[T]` and `fn wrap_Box[T]` both exist. wrap[Box[Int]] mangles to
// mangle_generic_name("wrap", "Box_Int") and wrap_Box[Int] to
// mangle_generic_name("wrap_Box", "Int") — before the fix both are "wrap_Box_Int", so the
// second fn definition emitted under that C symbol collides with the first at `cc`:
// "conflicting types for 'blink_wrap_Box_Int'" (or a redefinition error, depending on
// whether the two signatures happen to agree). This is not a contrived shape — lib/ already
// has underscore-bearing generic fn names (list_map, map_merge, cmg_first_of), so any pair
// of an underscore-bearing generic fn name plus a matching mono argument segment collides.
//
// After the fix, "wrap_Box_Int" and "wrap__Box_Int" are the two symbols and both fn bodies
// survive.

type Box[T] { v: T }

fn wrap[T](x: T) -> T {
    x
}

fn wrap_Box[T](x: T) -> T {
    x
}

fn main() {
    let a = wrap(Box { v: 5 })
    let b = wrap_Box(7)
    assert(a.v == 5)
    assert(b == 7)
}
