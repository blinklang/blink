// br cr4gqk: mangle_generic_name collision, struct/struct shape.
//
// `type Inner[T]` and `type Box_Inner[T]` both exist; `Box[Inner[Int]]` mangles its slot's
// segment to "Box_Inner_Int" (mono over Box, arg "Inner_Int" from the inner Box_Inner...
// no — concretely: register_mono_instance("Box", "Inner_Int", ...) for Box[Inner[Int]], and
// register_mono_instance("Box_Inner", "Int", ...) for Box_Inner[Int]). Before the cr4gqk
// escape fix, mangle_generic_name("Box", "Inner_Int") == mangle_generic_name("Box_Inner",
// "Int") == "Box_Inner_Int": one C symbol for two distinct struct instances.
//
// emit_mono_struct_typedef recomputes this name and walks mono_instances in push order —
// it does not go through the (already-broken) mono_rev_idx — so BOTH typedef bodies get
// emitted under "blink_Box_Inner_Int", guarded by the same `#ifndef BLINK_TD_
// blink_Box_Inner_Int`. The second body is silently discarded by the include guard, so
// whichever instance is emitted second loses its fields in the generated C. At HEAD this
// fails at `cc`: "'blink_Box_Inner_Int' has no member named 'value'" (or similar — field
// names diverge with whichever instance survives the guard).
//
// After the fix, "Box_Inner_Int" and "Box__Inner_Int" are the two symbols — distinct C
// types, both typedefs survive, and this compiles and runs.

type Inner[T] { value: T }
type Box_Inner[T] { tag: T }
type Box[T] { slot: T }

fn main() {
    let a: Box_Inner[Int] = Box_Inner { tag: 7 }
    let b: Box[Inner[Int]] = Box { slot: Inner { value: 9 } }
    assert(a.tag == 7)
    assert(b.slot.value == 9)
}
