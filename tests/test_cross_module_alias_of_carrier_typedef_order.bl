// A pub type alias for Option[Struct] declared in an imported module emits its
// typedef before the carrier typedef it names, so cc rejects it as an unknown
// type. A top-level `let` over the same carrier type, declared in the
// importing module, also disagrees with its own initializer's carrier name.
// Staged as its own two-file package since the defect is inherently
// cross-module.

import std.path.{path_join}

fn blink_bin_path() -> Str {
    let root = env.var("BLINK_ROOT") ?? ""
    if root != "" {
        let p = path_join(root, "build/blink")
        if file_exists(p) == 1 {
            return p
        }
    }
    "build/blink"
}

test.failing(
    "a cross-module alias of a carrier over an imported struct compiles and runs",
    reason: "the alias typedef is emitted before the carrier typedef it names (unknown type name in cc), and a top-level let over the same carrier is declared at one carrier name but initialized with a different one",
    ticket: "s2jezp",
) {
    let root = ".tmp/_cross_module_alias_of_carrier_typedef_order"
    let src_dir = "{root}/src"
    let _mk = process_run("mkdir", ["-p", src_dir])
    write_file("{root}/blink.toml", "[package]\nname = \"aliasxmod\"\nversion = \"0.1.0\"\n")
    write_file("{src_dir}/helper.bl", "pub type HPoint \{ x: Int, y: Int }\npub type MB = Option[HPoint]\n\npub fn make_alias_opt() -> MB \{\n    Some(HPoint \{ x: 11, y: 12 })\n}\n")
    let entry_path = "{src_dir}/main.bl"
    write_file(entry_path, "import helper\nimport std.io\n\nlet seed: Option[helper.HPoint] = None\n\nfn main() \{\n    io.println(\"seed=\{seed.is_none()}\")\n    let ao = helper.make_alias_opt()\n    io.println(\"ao=\{ao.unwrap().x}\")\n}\n")
    let r = process_run(blink_bin_path(), ["run", entry_path])
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert(r.out.contains("seed=true"), "wrong output: {r.out}")
    assert(r.out.contains("ao=11"), "wrong output: {r.out}")
}
