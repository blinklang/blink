// znad0f -- cross-module @derive method-name mangling mismatch.
//
// Derived methods are type-owned: their definition + forward-decl are emitted
// via `{c_type_c_name(T)}_<method>` (the type's MODULE prefix). The call sites
// (.eq()/.cmp() dispatch and ==/< operator desugar) built the symbol via
// `c_fn_name("{T}_eq")`, which keys the whole "T_eq" string against the FN
// prefix table (no match) -> bare `blink_T_eq`. For a type declared in another
// module the two disagree -> `implicit declaration of function 'blink_T_eq'`.
//
// Same-module worked only because __main__ types carry an empty prefix so both
// sides collapse to the bare name. These tests stage a two-file package so the
// derived type lives behind a real module prefix, then drive the FULL pipeline
// (compile -> C -> link -> run) — the symptom is a C link error that the
// `--format json` typecheck/codegen stage cannot observe.
//
// String literals below escape `\{`/`\}` so the staged Blink source survives
// this file's own interpolation pass, and `\"` for the @module quotes.

import compile_test_helpers.{run_xmod}

test "cross-module @derive(Eq) struct: ==/.eq() links and runs" {
    let helper = "@module(\"om\")\n@derive(Eq)\npub type Tag \{ major: Int, minor: Int \}\npub fn make_tag(a: Int, b: Int) -> Tag \{ Tag \{ major: a, minor: b \} \}\n"
    let entry = "import om.helper.\{Tag, make_tag\}\npub fn main() \{\n    let t1 = make_tag(1, 0)\n    let t2 = make_tag(1, 0)\n    if t1 == t2 \{ io.println(\"eq\") \}\n    if t1.eq(t2) \{ io.println(\"eq2\") \}\n\}\n"
    let r = run_xmod(entry, "om", "helper", helper, "znad0f_struct")
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("eq"))
    assert(r.out.contains("eq2"))
}

test "cross-module @derive(Eq, Ord) struct: ==/< links and runs" {
    let helper = "@module(\"om\")\n@derive(Eq, Ord)\npub type Ver \{ major: Int, minor: Int \}\npub fn ver(a: Int, b: Int) -> Ver \{ Ver \{ major: a, minor: b \} \}\n"
    let entry = "import om.helper.\{Ver, ver\}\npub fn main() \{\n    let v1 = ver(1, 0)\n    let v2 = ver(1, 5)\n    if v1 == v1 \{ io.println(\"eqok\") \}\n    if v1 < v2 \{ io.println(\"ltok\") \}\n\}\n"
    let r = run_xmod(entry, "om", "helper", helper, "znad0f_ord")
    assert_eq(r.exit_code, 0)
    assert(r.out.contains("eqok"))
    assert(r.out.contains("ltok"))
}
