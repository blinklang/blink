import test_cross_module_generic_fn_helper

test "MQ-call generic fn with primitive T = Int" {
    let n = test_cross_module_generic_fn_helper.cmg_identity(42)
    assert_eq(n, 42)
}

test "MQ-call generic fn with primitive T = Str" {
    let s = test_cross_module_generic_fn_helper.cmg_identity("hello")
    assert_eq(s, "hello")
}

test "MQ-call generic fn with user struct T" {
    let p = test_cross_module_generic_fn_helper.cmg_identity(test_cross_module_generic_fn_helper.CmgPoint { x: 3, y: 4 })
    assert_eq(p.x, 3)
    assert_eq(p.y, 4)
}

test "MQ-call generic fn returning generic struct" {
    let b = test_cross_module_generic_fn_helper.cmg_make_box(99)
    assert_eq(b.value, 99)
}

test "MQ-call generic fn taking generic struct" {
    let b = test_cross_module_generic_fn_helper.cmg_make_box("boxed")
    let v = test_cross_module_generic_fn_helper.cmg_unbox(b)
    assert_eq(v, "boxed")
}

test "MQ-call multi-tparam generic fn" {
    let a = test_cross_module_generic_fn_helper.cmg_pair_first(1, "two")
    assert_eq(a, 1)
    let b = test_cross_module_generic_fn_helper.cmg_pair_second(1, "two")
    assert_eq(b, "two")
}

test "MQ-call generic fn with first-of pattern" {
    let r = test_cross_module_generic_fn_helper.cmg_first_of(10, 20)
    assert_eq(r, 10)
}
