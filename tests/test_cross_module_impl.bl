import test_ec_orphan_b

// eczcwr regression guard: a cross-module (orphan) trait impl — the type `Ngx`
// is declared in module test_ec_orphan_a, but `trait Bump` and `impl Bump for
// Ngx` live in test_ec_orphan_b. The method symbol is prefixed by the IMPL's
// module (ec_b) while `self: Ngx` must resolve to the TYPE's module (ec_a).
//
// The eczcwr composite-key machinery must NOT write "{impl_mod}:{type}" at the
// impl-target site: that poisoned c_type_c_name so `self: Ngx` resolved to the
// impl's module (blink_..._ec_b_Ngx, a nonexistent type) while the definition
// used the type's real module (blink_..._ec_a_Ngx) → gcc conflicting-types.
// Composite keys belong only to the type-DECLARATION sites.

test "cross-module orphan trait impl compiles and runs" {
    assert_eq(test_ec_orphan_b.run(), 42)
}
