import test_cross_module_generic_fn_helper

// q4etvt guard: a cross-module generic-struct INSTANCE (CmgBox[Int]/CmgBox[Str]
// defined in test_cross_module_generic_fn_helper) flowed through Option / Result /
// Map carriers IN THE CONSUMING MODULE via explicit type annotations. After q4etvt's
// mono-registry physical-base split the instance mangles PHYSICALLY — by its DEFINING
// module — as blink_test_cross_module_generic_fn_helper_CmgBox_Int (and the carrier
// tracks it: blink_Option_test_cross_module_generic_fn_helper_CmgBox_Int), instead of
// the old bare blink_CmgBox_Int that never matched the physical fn-param signature
// (param_c_type). This fixture locks that RUNTIME behavior.
//
// DELIBERATELY EXCLUDED (separate pre-existing bugs, each with its own MVCE that
// reproduces SAME-MODULE — orthogonal to this module-qualifier reconcile):
//   - bare-typevar generic-fn `-> Option[T]` return over a struct instance
//     (`wrap_opt(box)`) — bd4mg6.
//   - tuple carrier over a struct instance (`(box, 100): (CmgBox[Int], Int)`) —
//     637sy9 (the tuple-element speller erases the instance args).
//   - two modules defining a SAME-NAMED generic (`Qbx[T]` in two files), both
//     `Qbx[Int]` — eczcwr (mod_type_prefix is keyed by bare name and collapses
//     them to one module's prefix; below the mono-registry layer this fix touches).

test "cross-module CmgBox[Int] through Option carrier" {
    let b = test_cross_module_generic_fn_helper.cmg_make_box(7)
    let o: Option[test_cross_module_generic_fn_helper.CmgBox[Int]] = Some(b)
    assert_eq(o.unwrap().value, 7)
}

test "cross-module CmgBox[Str] through Result carrier" {
    let b = test_cross_module_generic_fn_helper.cmg_make_box("hi")
    let r: Result[test_cross_module_generic_fn_helper.CmgBox[Str], Str] = Ok(b)
    assert_eq(r.unwrap().value, "hi")
}

test "cross-module CmgBox[Int] through Map value carrier" {
    let b = test_cross_module_generic_fn_helper.cmg_make_box(42)
    let mut m: Map[Str, test_cross_module_generic_fn_helper.CmgBox[Int]] = Map()
    m.insert("k", b)
    assert_eq(m.get("k").unwrap().value, 42)
}

test "cross-module CmgBox[Int] direct field access" {
    let b = test_cross_module_generic_fn_helper.cmg_make_box(3)
    assert_eq(b.value, 3)
}
