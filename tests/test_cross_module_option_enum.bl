import test_cross_module_option_enum_helper.{Cmd}

fn is_quit(c: Option[Cmd]) -> Bool {
    match c {
        Some(Cmd.Quit) => true
        _ => false
    }
}

fn first_cmd() -> Option[Cmd] {
    Some(Cmd.Quit)
}

fn no_cmd() -> Option[Cmd] {
    None
}

test "cross-module Option[UserEnum] param matches Some variant" {
    assert_eq(is_quit(first_cmd()), true)
}

test "cross-module Option[UserEnum] param matches None" {
    assert_eq(is_quit(no_cmd()), false)
}

test "cross-module Option[UserEnum] param matches non-Quit variant" {
    assert_eq(is_quit(Some(Cmd.Continue)), false)
}
