import test_cross_module_result_enum_helper.{Status}

fn is_ok(r: Result[Status, Str]) -> Bool {
    match r {
        Ok(Status.Ok200) => true
        _ => false
    }
}

fn make_ok() -> Result[Status, Str] {
    Ok(Status.Ok200)
}

fn make_err() -> Result[Status, Str] {
    Err("boom")
}

fn make_other_ok() -> Result[Status, Str] {
    Ok(Status.NotFound)
}

test "cross-module Result[UserEnum, Str] param matches Ok variant" {
    assert_eq(is_ok(make_ok()), true)
}

test "cross-module Result[UserEnum, Str] param matches Err variant" {
    assert_eq(is_ok(make_err()), false)
}

test "cross-module Result[UserEnum, Str] param matches non-Ok200 Ok variant" {
    assert_eq(is_ok(make_other_ok()), false)
}
