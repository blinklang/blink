// br cwb2my — a plain call to a generic fn returning Map[K, StructInstance],
// consumed DIRECTLY (no intermediate let), must keep the value-struct type on
// the call's transient Map temp. The value type resolves via the tid
// (v_name = "Box_Int"), but the register was gated on is_struct_type(v_name),
// a struct_reg_set string check that fails closed while build_map's own Box_Int
// mono is still being registered in the same codegen pass — so the direct
// call's Map temp carried no value-struct metadata and `.get(k).unwrap().value`
// spelled `_ounw.value` as int64_t (blink_Option_int), making `.value.value`
// a member access on a non-struct (hard cc failure).
//
// The let-bound and annotated-receiver forms were greened by intervening tid
// work; the direct-call shape the title names is the residual. Both are pinned
// here so neither regresses.

type Box[T] { value: T }

fn build_map[K, V](k: K, v: V) -> Map[K, V] {
    let mut m: Map[K, V] = Map()
    m.insert(k, v)
    m
}

test "direct chained call keeps the Map value struct" {
    assert_eq(build_map("k", Box { value: 42 }).get("k").unwrap().value, 42)
}

test "direct chained call, Int key keeps the Map value struct" {
    assert_eq(build_map(1, Box { value: 99 }).get(1).unwrap().value, 99)
}

test "let-bound generic Map struct-value return stays green" {
    let m = build_map("k", Box { value: 555 })
    assert_eq(m.get("k").unwrap().value, 555)
}

test "annotated-receiver generic Map struct-value return stays green" {
    let m: Map[Str, Box[Int]] = build_map("z", Box { value: 7 })
    assert_eq(m.get("z").unwrap().value, 7)
}
