import compile_test_helpers

fn main() {
    let base = "{compile_test_helpers.scratch_root()}/_test_cycle_detection"
    let pact = "{env.cwd()}/build/blink"
    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()

    // --- Test 1: Cross-package cycle should emit E1002 ---
    process.run("sh", ["-c", "mkdir -p {base}/cross/src/alpha"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {base}/cross/src/beta"]).unwrap()
    fs.write("{base}/cross/src/alpha/alpha.pact", "import beta.beta.\{get_beta}\n\npub fn get_alpha() -> Str \{\n    \"alpha\"\n}\n").unwrap()
    fs.write("{base}/cross/src/beta/beta.pact", "import alpha.alpha.\{get_alpha}\n\npub fn get_beta() -> Str \{\n    \"beta\"\n}\n").unwrap()
    fs.write("{base}/cross/src/main.pact", "import alpha.alpha.\{get_alpha}\n\nfn main() \{\n    io.println(get_alpha())\n}\n").unwrap()

    let cross_out = process.run("sh", ["-c", "cd {base}/cross && {pact} build src/main.pact -o build/cross 2>&1"]).unwrap()
    let cross_combined = "{cross_out.out}{cross_out.err_out}"
    if cross_combined.contains("circular package dependency") {
        io.println("PASS: cross-package cycle detected (E1002)")
    } else {
        if !cross_out.success() {
            io.println("FAIL: build failed but no cycle error: {cross_combined}")
        } else {
            io.println("FAIL: cross-package cycle was not detected (compiled successfully)")
        }
    }

    // --- Test 2: Intra-package cycle should compile fine ---
    process.run("sh", ["-c", "mkdir -p {base}/intra/src/pkg"]).unwrap()
    fs.write("{base}/intra/src/pkg/a.pact", "import pkg.b.\{from_b}\n\npub fn from_a() -> Str \{\n    \"a\"\n}\n").unwrap()
    fs.write("{base}/intra/src/pkg/b.pact", "import pkg.a.\{from_a}\n\npub fn from_b() -> Str \{\n    \"b\"\n}\n").unwrap()
    fs.write("{base}/intra/src/main.pact", "import pkg.a.\{from_a}\n\nfn main() \{\n    io.println(from_a())\n}\n").unwrap()

    let intra_build = process.run("sh", ["-c", "cd {base}/intra && {pact} build src/main.pact -o build/intra 2>&1"]).unwrap()
    if intra_build.success() {
        let intra_out = process.run("{base}/intra/build/intra", []).unwrap()
        if intra_out.out.starts_with("a") {
            io.println("PASS: intra-package cycle allowed")
        } else {
            io.println("FAIL: intra-package compiled but wrong output: {intra_out.out}")
        }
    } else {
        io.println("FAIL: intra-package cycle should compile but failed ({intra_build.end})")
        io.println("{intra_build.out}{intra_build.err_out}")
    }

    // --- Test 3: Three-package cycle A -> B -> C -> A ---
    process.run("sh", ["-c", "mkdir -p {base}/tri/src/aa"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {base}/tri/src/bb"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {base}/tri/src/cc"]).unwrap()
    fs.write("{base}/tri/src/aa/aa.pact", "import cc.cc.\{get_cc}\n\npub fn get_aa() -> Str \{\n    \"aa\"\n}\n").unwrap()
    fs.write("{base}/tri/src/bb/bb.pact", "import aa.aa.\{get_aa}\n\npub fn get_bb() -> Str \{\n    \"bb\"\n}\n").unwrap()
    fs.write("{base}/tri/src/cc/cc.pact", "import bb.bb.\{get_bb}\n\npub fn get_cc() -> Str \{\n    \"cc\"\n}\n").unwrap()
    fs.write("{base}/tri/src/main.pact", "import aa.aa.\{get_aa}\n\nfn main() \{\n    io.println(get_aa())\n}\n").unwrap()

    let tri_out = process.run("sh", ["-c", "cd {base}/tri && {pact} build src/main.pact -o build/tri 2>&1"]).unwrap()
    let tri_combined = "{tri_out.out}{tri_out.err_out}"
    if tri_combined.contains("circular package dependency") {
        io.println("PASS: three-package cycle detected (E1002)")
    } else {
        if !tri_out.success() {
            io.println("FAIL: tri build failed but no cycle error: {tri_combined}")
        } else {
            io.println("FAIL: three-package cycle was not detected")
        }
    }

    // --- Test 4: Verify help text is included ---
    if cross_combined.contains("extract shared types into a common package") {
        io.println("PASS: help text present in error output")
    } else {
        io.println("FAIL: help text missing from error output")
    }

    // --- Test 5: Non-cyclic cross-package import should work ---
    process.run("sh", ["-c", "mkdir -p {base}/nocycle/src/lib1"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {base}/nocycle/src/lib2"]).unwrap()
    fs.write("{base}/nocycle/src/lib1/lib1.pact", "pub fn value1() -> Str \{\n    \"v1\"\n}\n").unwrap()
    fs.write("{base}/nocycle/src/lib2/lib2.pact", "import lib1.lib1.\{value1}\n\npub fn combined() -> Str \{\n    value1()\n}\n").unwrap()
    fs.write("{base}/nocycle/src/main.pact", "import lib2.lib2.\{combined}\n\nfn main() \{\n    io.println(combined())\n}\n").unwrap()

    let nocycle_build = process.run("sh", ["-c", "cd {base}/nocycle && {pact} build src/main.pact -o build/nocycle 2>&1"]).unwrap()
    if nocycle_build.success() {
        let nocycle_out = process.run("{base}/nocycle/build/nocycle", []).unwrap()
        if nocycle_out.out.starts_with("v1") {
            io.println("PASS: non-cyclic cross-package import works")
        } else {
            io.println("FAIL: non-cyclic compiled but wrong output: {nocycle_out.out}")
        }
    } else {
        io.println("FAIL: non-cyclic cross-package should compile but failed ({nocycle_build.end})")
        io.println("{nocycle_build.out}{nocycle_build.err_out}")
    }

    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
}
