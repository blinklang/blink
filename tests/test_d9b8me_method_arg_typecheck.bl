import compile_test_helpers

// d9b8me — user struct/enum trait-method args must be typechecked.
// A method `fn add_to(self, a: Int)` called with a Float arg must raise E0300.

test "struct method rejects wrong-typed arg" {
    let src = "type Point \{ x: Int }\ntrait Adder \{ fn add_to(self, a: Int) -> Int }\nimpl Adder for Point \{ fn add_to(self, a: Int) -> Int \{ a + self.x } }\nfn main() \{ let p = Point \{ x: 1 }\n let r = p.add_to(2.0)\n io.println(\"\{r}\") }\n"
    compile_test_helpers.expect_compile_error(src, "d9b8me_struct_arg", "E0300")
}

test "struct method accepts correctly-typed arg" {
    let src = "type Point \{ x: Int }\ntrait Adder \{ fn add_to(self, a: Int) -> Int }\nimpl Adder for Point \{ fn add_to(self, a: Int) -> Int \{ a + self.x } }\nfn main() \{ let p = Point \{ x: 1 }\n let r = p.add_to(2)\n io.println(\"\{r}\") }\n"
    compile_test_helpers.expect_no_error(src, "d9b8me_struct_arg_ok", "E0300")
}

test "struct method rejects wrong-typed Str arg" {
    let src = "type Point \{ x: Int }\ntrait Adder \{ fn add_to(self, a: Int) -> Int }\nimpl Adder for Point \{ fn add_to(self, a: Int) -> Int \{ a + self.x } }\nfn main() \{ let p = Point \{ x: 1 }\n let r = p.add_to(\"hi\")\n io.println(\"\{r}\") }\n"
    compile_test_helpers.expect_compile_error(src, "d9b8me_struct_str_arg", "E0300")
}
