// A build keys its objects by the compiler's sha256. The daemon serves only a client that runs
// its own compiler, so it hashes that compiler once, at its start, and each build child it forks
// keeps that hash: no build child hashes the compiler again. Each build's output stays what a
// cold build gives.
import std.process.{ProcessResult}
import std.testing.{cleanup}
import compile_test_helpers

fn sh(cmd: Str) -> Str {
    process.run("sh", ["-c", cmd]).unwrap().out.trim()
}

fn dev_tree(root: Str, tree: Str) {
    shell_exec("rm -rf {tree}")
    shell_exec("mkdir -p {tree}/build {tree}/app/src {tree}/shim")
    // A copy, not a link: the install root comes from realpath(argv[0]).
    shell_exec("cp {sh("readlink -f build/blink")} {tree}/build/blink")
    shell_exec("ln -s {root}/lib {tree}/build/lib")
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        shell_exec("[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}")
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    shell_exec("[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h")
    // Each sh found on PATH logs the command line of the process that started it, then its script.
    write_file("{tree}/shim/sh", [
        #"#!/bin/sh"#,
        #"printf '%s\t%s\n' "$(tr '\000' ' ' < /proc/$PPID/cmdline)" "$(printf '%s' "$2" | tr '\n' ' ')" >> "$(dirname "$0")/../sh.log""#,
        #"exec /bin/sh "$@""#,
        #""#,
    ].join("\n"))
    shell_exec("chmod +x {tree}/shim/sh")
    write_file("{tree}/app/blink.toml", "[package]\nname = \"daemon_child_sha_app\"\nversion = \"0.1.0\"\n")
    // A lock no older than blink.toml keeps "resolving dependencies..." out of every build.
    write_file("{tree}/app/blink.lock", "[metadata]\nlockfile-version = 1\n")
    write_file("{tree}/app/src/leaf.bl", [
        #"pub fn leaf_value() -> Str {"#,
        #"    "leaf""#,
        #"}"#,
        #""#,
    ].join("\n"))
    write_file("{tree}/app/src/main.bl", [
        #"import leaf.{leaf_value}"#,
        #""#,
        #"fn main() {"#,
        #"    io.println("main {leaf_value()}")"#,
        #"}"#,
        #""#,
    ].join("\n"))
}

// The corpus exports BLINK_COMPILER_ARCHIVE and may export BLINK_PER_MODULE; the first makes
// a build one unit, so the run drops both, and the module filters. The daemon starts under
// the same env, since it serves only a client whose env is its own.
fn env_of(tree: Str) -> Str {
    "env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_PER_MODULE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE BLINK_CACHE_DIR={tree}/objcache PATH={tree}/shim:$PATH"
}

fn client(tree: Str, args: Str) -> ProcessResult {
    process.run("sh", ["-c", "cd {tree}/app && {env_of(tree)} ../build/blink {args}"]).unwrap()
}

// The pid of the daemon serving src/main.bl in tree, or -1. The timeout ends a daemon that
// nothing stopped.
fn start_daemon(tree: Str) -> Int {
    shell_exec("cd {tree}/app && ({env_of(tree)} timeout 300 ../build/blink daemon start src/main.bl > {tree}/daemon.log 2>&1 &)")
    let up = process.run("sh", ["-c", "for i in $(seq 1 600); do [ -S {tree}/app/.blink/daemon.sock ] && exit 0; sleep 0.05; done; exit 1"]).unwrap()
    let pid = sh("cat {tree}/app/.blink/daemon.pid 2>/dev/null").to_int()
    if !up.success() {
        stop_daemon(pid)
        return -1
    }
    pid
}

// Stops the daemon and each worker it started, by pid.
fn stop_daemon(pid: Int) {
    if pid <= 0 { return }
    let workers = sh("pgrep -P {pid}").split("\n").join(" ")
    shell_exec("kill {pid} 2>/dev/null; for i in $(seq 1 100); do kill -0 {pid} 2>/dev/null || break; sleep 0.05; done; kill -9 {pid} 2>/dev/null; for w in {workers}; do kill -9 $w 2>/dev/null; done; true")
}

// A field of `daemon status`, such as "builds", or -1 when the status has none.
fn served(tree: Str, field: Str) -> Int {
    let out = client(tree, "daemon status").out
    let key = "\"{field}\":"
    match out.byte_index_of(key, 0) {
        Some(at) => {
            let rest = out.byte_slice(at + key.byte_len(), out.byte_len())
            let mut n = ""
            for c in rest {
                if c < '0' || c > '9' { break }
                n = "{n}{c}"
            }
            if n == "" { -1 } else { n.to_int() }
        }
        None => -1
    }
}

// What a command printed, with its tree's path and a build's private units directory's random
// name spelled the same in every tree.
fn plain(tree: Str, s: Str) -> Str {
    let t = s.replace(tree, "TREE")
    let mut out = ""
    let mut rest = t
    loop {
        match rest.byte_index_of(".units.", 0) {
            Some(at) => {
                let end = if at + 13 <= rest.byte_len() { at + 13 } else { rest.byte_len() }
                out = "{out}{rest.byte_slice(0, at)}.units.XXXXXX"
                rest = rest.byte_slice(end, rest.byte_len())
            }
            None => break
        }
    }
    "{out}{rest}"
}

// The first difference between two results of the same command in two trees, or "".
fn differ(a_tree: Str, a: ProcessResult, b_tree: Str, b: ProcessResult) -> Str {
    if a.exit_code != b.exit_code { return "exit {a.exit_code} vs {b.exit_code}:\n{a.out}{a.err_out}\n-- vs --\n{b.out}{b.err_out}" }
    if plain(a_tree, a.out) != plain(b_tree, b.out) { return "stdout:\n{a.out}\n-- vs --\n{b.out}" }
    if plain(a_tree, a.err_out) != plain(b_tree, b.err_out) { return "stderr:\n{a.err_out}\n-- vs --\n{b.err_out}" }
    ""
}

// What two trees' last builds left that differs: a C file of the units, or the program.
fn output_differ(a_tree: Str, b_tree: Str) -> Str {
    sh("cd {b_tree}/app/out/app.units && for f in *.c *.h; do cmp -s $f {a_tree}/app/out/app.units/$f || echo $f; done; cd {a_tree}/app/out/app.units && for f in *.c *.h; do [ -e {b_tree}/app/out/app.units/$f ] || echo extra:$f; done; cmp -s {a_tree}/app/out/app {b_tree}/app/out/app || echo program").split("\n").join(" ")
}

// The compiler hashes a build child ran: each logged line whose parent is the daemon and whose
// script runs sha256sum on the compiler.
fn child_compiler_hashes(tree: Str) -> Str {
    sh("grep -F 'daemon start' {tree}/sh.log 2>/dev/null | grep -F 'sha256sum {tree}/build/blink '").split("\n").join(" | ")
}

test "no daemon build child hashes the compiler again, and each build matches a cold build" {
    let root = sh("pwd -P")
    let warm = "{compile_test_helpers.scratch_root()}/_daemon_child_sha_warm_{getpid()}"
    let cold = "{compile_test_helpers.scratch_root()}/_daemon_child_sha_cold_{getpid()}"
    dev_tree(root, warm)
    dev_tree(root, cold)
    let pid = start_daemon(warm)
    let mut problems: List[Str] = []
    let mut hashes = ""
    let mut builds = -1
    with cleanup(fn() { stop_daemon(pid) }) {
        assert(pid > 0, "the daemon did not start: {read_file("{warm}/daemon.log")}")
        shell_exec("rm -f {warm}/sh.log")
        let mut i = 0
        for args in ["build src/main.bl -o out/app", "run src/main.bl"] {
            // Each build compiles an edit, so none can reuse what the one before it wrote.
            i = i + 1
            for t in [warm, cold] { write_file("{t}/app/src/leaf.bl", "pub fn leaf_value() -> Str \{\n    \"leaf {i}\"\n\}\n") }
            let d = differ(warm, client(warm, args), cold, client(cold, args))
            if d != "" { problems.push("{args}: {d}") }
        }
        let o = output_differ(warm, cold)
        if o != "" { problems.push(o) }
        hashes = child_compiler_hashes(warm)
        builds = served(warm, "builds")
    }
    shell_exec("rm -rf {warm} {cold}")
    assert_eq(problems.join("\n"), "")
    assert_eq(builds, 2)
    assert_eq(hashes, "")
}
