// Builds of two entries can write the same outputs: a shared -o, units dir or obj cache. So
// the daemon runs one build at a time over all its entries, oldest first. A build of a second
// entry sent while a build of the first runs waits for it, and each matches a cold build.

import std.process.{ProcessResult, ChildEnd}
import std.testing.{cleanup}
import compile_test_helpers
import compile_test_helpers.{sh, appears, bg_result}

fn dev_tree(root: Str, tree: Str, name: Str) {
    shell_exec("rm -rf {tree}")
    shell_exec("mkdir -p {tree}/build {tree}/app/src")
    // A copy, not a link: the install root comes from realpath(argv[0]).
    shell_exec("cp {sh("readlink -f build/blink")} {tree}/build/blink")
    shell_exec("ln -s {root}/lib {tree}/build/lib && ln -s {root}/lib {tree}/lib")
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        shell_exec("[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}")
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    shell_exec("[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h")
    // The daemon listens at the project root, so each tree is a project of its own.
    write_file("{tree}/app/blink.toml", "[package]\nname = \"{name}\"\nversion = \"0.1.0\"\n")
    // A lock no older than blink.toml keeps "resolving dependencies..." out of every build.
    write_file("{tree}/app/blink.lock", "[metadata]\nlockfile-version = 1\n")
    write_file("{tree}/app/src/base.bl", [
        #"pub fn tag(s: Str) -> Str {"#,
        #"    "[{s}]""#,
        #"}"#,
        #""#,
    ].join("\n"))
    write_file("{tree}/app/src/leaf.bl", [
        #"import base.{tag}"#,
        #""#,
        #"pub fn leaf_value() -> Str {"#,
        #"    tag("leaf")"#,
        #"}"#,
        #""#,
    ].join("\n"))
    for name in ["main", "second"] {
        write_file("{tree}/app/src/{name}.bl", [
            #"import base.{tag}"#,
            #"import leaf.{leaf_value}"#,
            #""#,
            #"fn main() {"#,
            "    io.println(\"\{tag(\"{name}\")\} \{leaf_value()\}\")",
            #"}"#,
            #""#,
        ].join("\n"))
    }
}

// The corpus exports BLINK_COMPILER_ARCHIVE and may export BLINK_PER_MODULE; the first makes
// a build one unit, so the run drops both, and the module filters. The daemon starts under
// the same env, since it serves only a client whose env is its own.
// The cc first on PATH is the tree's, which holds a compile while cc.hold exists.
fn env_of(tree: Str) -> Str {
    "env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_PER_MODULE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE BLINK_CACHE_DIR={tree}/objcache PATH={tree}/ccwrap:$PATH"
}

// A cc that tells the test it started and then waits while cc.hold exists, then runs the
// real cc. A build whose cc is held can not end, so whatever the test sees meanwhile it sees
// while that build runs.
fn hold_cc(tree: Str) {
    let real = sh("command -v cc")
    shell_exec("mkdir -p {tree}/ccwrap")
    write_file("{tree}/ccwrap/cc", "#!/bin/sh\nif [ -e {tree}/cc.hold ]; then\n    touch {tree}/cc.started\n    while [ -e {tree}/cc.hold ]; do sleep 0.05; done\nfi\nexec {real} \"$@\"\n")
    shell_exec("chmod +x {tree}/ccwrap/cc")
}

// The command in tree, with a bound, so a daemon that never answers fails the test instead of
// hanging it.
fn blink_bounded(tree: Str, args: Str) -> ProcessResult {
    process.run("sh", ["-c", "cd {tree}/app && {env_of(tree)} timeout 20 ../build/blink {args}"]).unwrap()
}

// Starts the command in tree in the background. Its stdout, stderr and exit code land in
// tree/<tag>.out, .err and .rc, and the pid of the blink process in tree/<tag>.pid: the shell
// that writes it execs env, which execs blink.
fn blink_bg(tree: Str, args: Str, tag: Str) {
    shell_exec("cd {tree}/app && (sh -c 'echo $$ > {tree}/{tag}.pid; exec {env_of(tree)} ../build/blink {args}' > {tree}/{tag}.out 2> {tree}/{tag}.err; echo $? > {tree}/{tag}.rc.tmp; mv {tree}/{tag}.rc.tmp {tree}/{tag}.rc) > /dev/null 2>&1 &")
}

// The pid of the daemon serving src/main.bl in tree, or -1. The timeout ends a daemon that
// nothing stopped.
fn start_daemon(tree: Str) -> Int {
    shell_exec("cd {tree}/app && ({env_of(tree)} timeout 300 ../build/blink daemon start src/main.bl > {tree}/daemon.log 2>&1 &)")
    let up = process.run("sh", ["-c", "for i in $(seq 1 600); do [ -S {tree}/app/.blink/daemon.sock ] && exit 0; sleep 0.05; done; exit 1"]).unwrap()
    let pid = sh("cat {tree}/app/.blink/daemon.pid 2>/dev/null").to_int()
    if !up.success() {
        stop_daemon(pid)
        return -1
    }
    pid
}

fn stop_daemon(pid: Int) {
    if pid <= 0 { return }
    shell_exec("kill {pid} 2>/dev/null; for i in $(seq 1 100); do kill -0 {pid} 2>/dev/null || exit 0; sleep 0.05; done; kill -9 {pid}")
}

// A field of a status reply, such as "builds", or -1 when the reply has none.
fn field_of(out: Str, field: Str) -> Int {
    let key = "\"{field}\":"
    match out.byte_index_of(key, 0) {
        Some(at) => {
            let rest = out.byte_slice(at + key.byte_len(), out.byte_len())
            let mut n = ""
            for c in rest {
                if c < '0' || c > '9' { break }
                n = "{n}{c}"
            }
            if n == "" { -1 } else { n.to_int() }
        }
        None => -1
    }
}

fn served(tree: Str, field: Str) -> Int {
    field_of(blink_bounded(tree, "daemon status").out, field)
}

// What a build printed, with its tree's path and its private units directory's random name
// spelled the same in every tree.
fn plain(tree: Str, s: Str) -> Str {
    let t = s.replace(tree, "TREE")
    let mut out = ""
    let mut rest = t
    loop {
        match rest.byte_index_of(".units.", 0) {
            Some(at) => {
                let end = if at + 13 <= rest.byte_len() { at + 13 } else { rest.byte_len() }
                out = "{out}{rest.byte_slice(0, at)}.units.XXXXXX"
                rest = rest.byte_slice(end, rest.byte_len())
            }
            None => break
        }
    }
    "{out}{rest}"
}

// The first difference between two results of the same command in two trees, or "".
fn differ(a_tree: Str, a: ProcessResult, b_tree: Str, b: ProcessResult) -> Str {
    if a.end != b.end { return "{a.end} vs {b.end}:\n{a.out}{a.err_out}\n-- vs --\n{b.out}{b.err_out}" }
    if plain(a_tree, a.out) != plain(b_tree, b.out) { return "stdout:\n{a.out}\n-- vs --\n{b.out}" }
    if plain(a_tree, a.err_out) != plain(b_tree, b.err_out) { return "stderr:\n{a.err_out}\n-- vs --\n{b.err_out}" }
    ""
}

// What the builds to out in two trees left that differs: a C file of the units, or the
// program.
fn output_differ(a_tree: Str, b_tree: Str, out: Str) -> Str {
    let a = "{a_tree}/app/{out}"
    let b = "{b_tree}/app/{out}"
    sh("cd {b}.units && for f in *.c *.h; do cmp -s $f {a}.units/$f || echo $f; done; cd {a}.units && for f in *.c *.h; do [ -e {b}.units/$f ] || echo extra:$f; done; cmp -s {a} {b} || echo program").split("\n").join(" ")
}

fn edit(tree: Str, file: Str, sed: Str) {
    let path = "{tree}/app/src/{file}"
    let before = read_file(path)
    shell_exec("sed -i '{sed}' {path}")
    assert(read_file(path) != before, "the edit `{sed}` did not change {file}")
}

// Whether one status reply shows one build running and one waiting, within secs seconds.
fn one_builds_one_waits(tree: Str, secs: Int) -> Bool {
    let deadline = time_ms() + secs * 1000
    while time_ms() < deadline {
        let out = blink_bounded(tree, "daemon status").out
        if field_of(out, "building") == 1 && field_of(out, "queued") == 1 { return true }
        shell_exec("sleep 0.1")
    }
    false
}

fn cold_build(tree: Str, args: Str) -> ProcessResult {
    process.run("sh", ["-c", "cd {tree}/app && {env_of(tree)} ../build/blink {args}"]).unwrap()
}

test "a build of a second entry sent while a build of the first runs waits its turn and both match cold" {
    let root = sh("pwd -P")
    let warm = "{compile_test_helpers.scratch_root()}/_daemon_one_turn_warm_{getpid()}"
    let cold = "{compile_test_helpers.scratch_root()}/_daemon_one_turn_cold_{getpid()}"
    dev_tree(root, warm, "daemon_one_turn_app")
    dev_tree(root, cold, "daemon_one_turn_app")
    hold_cc(warm)
    let pid = start_daemon(warm)
    let mut held = false
    let mut waited = false
    let mut running = false
    let mut b1 = ProcessResult { out: "", err_out: "", end: ChildEnd.Exited(-1) }
    let mut b2 = ProcessResult { out: "", err_out: "", end: ChildEnd.Exited(-1) }
    let mut c1 = ProcessResult { out: "", err_out: "", end: ChildEnd.Exited(-1) }
    let mut c2 = ProcessResult { out: "", err_out: "", end: ChildEnd.Exited(-1) }
    let mut o1 = "no build"
    let mut o2 = "no build"
    let mut builds = -1
    with cleanup(fn() {
        shell_exec("rm -f {warm}/cc.hold")
        stop_daemon(pid)
    }) {
        assert(pid > 0, "the daemon did not start: {read_file("{warm}/daemon.log")}")
        // Each entry warm first, so the edit below makes each build compile its own leaf.
        let _w0 = blink_bounded(warm, "build src/second.bl -o out/second")
        let _w1 = blink_bounded(warm, "build src/main.bl -o out/app")
        edit(warm, "leaf.bl", #"s/"leaf"/"lea2"/"#)
        shell_exec("touch {warm}/cc.hold")
        blink_bg(warm, "build src/main.bl -o out/app", "b1")
        held = appears("{warm}/cc.started", 120)
        blink_bg(warm, "build src/second.bl -o out/second", "b2")
        waited = one_builds_one_waits(warm, 60)
        running = file_exists("{warm}/b1.rc") != 1 && file_exists("{warm}/b2.rc") != 1
        shell_exec("rm -f {warm}/cc.hold")
        b1 = bg_result(warm, "b1")
        b2 = bg_result(warm, "b2")
        let _c0 = cold_build(cold, "build src/second.bl -o out/second")
        let _c1 = cold_build(cold, "build src/main.bl -o out/app")
        edit(cold, "leaf.bl", #"s/"leaf"/"lea2"/"#)
        c1 = cold_build(cold, "build src/main.bl -o out/app")
        c2 = cold_build(cold, "build src/second.bl -o out/second")
        o1 = output_differ(warm, cold, "out/app")
        o2 = output_differ(warm, cold, "out/second")
        builds = served(warm, "builds")
    }
    shell_exec("rm -rf {warm} {cold}")
    assert(held, "no cc started in the first build through the daemon")
    assert(waited, "no status showed one build running and one waiting")
    assert(running, "a build ended while the first build's cc was held")
    assert_eq(differ(warm, b1, cold, c1), "")
    assert_eq(differ(warm, b2, cold, c2), "")
    assert_eq(o1, "")
    assert_eq(o2, "")
    assert_eq(builds, 4)
}

// Whether status shows a stop under way within secs seconds.
fn stopping(tree: Str, secs: Int) -> Bool {
    let deadline = time_ms() + secs * 1000
    while time_ms() < deadline {
        if served(tree, "stopping") == 1 { return true }
        shell_exec("sleep 0.05")
    }
    false
}

test "a stop sent while one entry builds and another waits sends the waiting build cold only once the first ends" {
    let root = sh("pwd -P")
    let warm = "{compile_test_helpers.scratch_root()}/_daemon_one_turn_stop_warm_{getpid()}"
    let cold = "{compile_test_helpers.scratch_root()}/_daemon_one_turn_stop_cold_{getpid()}"
    dev_tree(root, warm, "daemon_one_turn_stop_app")
    dev_tree(root, cold, "daemon_one_turn_stop_app")
    hold_cc(warm)
    let pid = start_daemon(warm)
    let mut waited = false
    let mut stop_seen = false
    let mut still_waits = ""
    let mut b1 = ProcessResult { out: "", err_out: "", end: ChildEnd.Exited(-1) }
    let mut b2 = ProcessResult { out: "", err_out: "", end: ChildEnd.Exited(-1) }
    let mut s = ProcessResult { out: "", err_out: "", end: ChildEnd.Exited(-1) }
    let mut c1 = ProcessResult { out: "", err_out: "", end: ChildEnd.Exited(-1) }
    let mut c2 = ProcessResult { out: "", err_out: "", end: ChildEnd.Exited(-1) }
    let mut o1 = "no build"
    let mut o2 = "no build"
    with cleanup(fn() {
        shell_exec("rm -f {warm}/cc.hold")
        stop_daemon(pid)
    }) {
        assert(pid > 0, "the daemon did not start: {read_file("{warm}/daemon.log")}")
        let _w0 = blink_bounded(warm, "build src/second.bl -o out/second")
        let _w1 = blink_bounded(warm, "build src/main.bl -o out/app")
        edit(warm, "leaf.bl", #"s/"leaf"/"lea2"/"#)
        shell_exec("touch {warm}/cc.hold")
        blink_bg(warm, "build src/main.bl -o out/app", "b1")
        let _held = appears("{warm}/cc.started", 120)
        blink_bg(warm, "build src/second.bl -o out/second", "b2")
        waited = one_builds_one_waits(warm, 60)
        blink_bg(warm, "daemon stop", "s")
        stop_seen = stopping(warm, 20)
        // The waiting worker hears of the stop only once the first build ends, so it still
        // holds its build a while after the stop came.
        shell_exec("sleep 0.5")
        let st = blink_bounded(warm, "daemon status").out
        still_waits = "building={field_of(st, "building")} queued={field_of(st, "queued")} b2_ended={file_exists("{warm}/b2.rc")}"
        shell_exec("rm -f {warm}/cc.hold")
        b1 = bg_result(warm, "b1")
        b2 = bg_result(warm, "b2")
        s = bg_result(warm, "s")
        let _c0 = cold_build(cold, "build src/second.bl -o out/second")
        let _c1 = cold_build(cold, "build src/main.bl -o out/app")
        edit(cold, "leaf.bl", #"s/"leaf"/"lea2"/"#)
        c1 = cold_build(cold, "build src/main.bl -o out/app")
        c2 = cold_build(cold, "build src/second.bl -o out/second")
        o1 = output_differ(warm, cold, "out/app")
        o2 = output_differ(warm, cold, "out/second")
    }
    let left = sh("cd {warm}/app/.blink && ls -A | grep -v '^check\\.' | tr '\\n' ' '")
    shell_exec("rm -rf {warm} {cold}")
    assert(waited, "no status showed one build running and one waiting")
    assert(stop_seen, "no status showed the stop under way")
    assert_eq(still_waits, "building=1 queued=1 b2_ended=0")
    assert_eq(s.end, ChildEnd.Exited(0))
    assert_eq(differ(warm, b1, cold, c1), "")
    assert_eq(differ(warm, b2, cold, c2), "")
    assert_eq(o1, "")
    assert_eq(o2, "")
    assert_eq(left, "")
}
