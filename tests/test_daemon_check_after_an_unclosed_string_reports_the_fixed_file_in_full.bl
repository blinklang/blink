// An unclosed string at the end of a file hides the errors after its opening for that one check.
// The daemon keeps running, so the next check of the same file, once the string is closed, must
// report every error and warning in it, as a cold check does.

import std.process.{ProcessResult}
import compile_test_helpers

let DIR = "{compile_test_helpers.scratch_root()}/daemon_check_after_unclosed"

fn sh(cmd: Str) -> ProcessResult {
    process.run("sh", ["-c", cmd]).unwrap()
}

fn unclosed_src() -> Str {
    ["fn main() \{", #"    let s = "abc"#, "    let n = 1", "}", ""].join("\n")
}

// The string is closed now; a type error and an unused binding sit after where it opened.
fn fixed_src() -> Str {
    ["fn main() \{", #"    let s = "abc""#, "    let unused = 1", #"    let n: Int = "no""#, "    io.println(s)", "    io.println(n)", "}", ""].join("\n")
}

fn check() -> ProcessResult {
    sh("B=$(pwd)/build/blink; cd {DIR} && $B check main.bl")
}

// The pid of a daemon serving main.bl, or -1. The timeout ends a daemon that nothing stopped.
fn start_daemon() -> Int {
    let r = sh("B=$(pwd)/build/blink; cd {DIR} && rm -rf .blink && (timeout 120 $B daemon start main.bl > daemon.log 2>&1 &); for i in $(seq 1 400); do if [ -S .blink/daemon.sock ]; then cat .blink/daemon.pid; exit 0; fi; sleep 0.05; done; [ -f .blink/daemon.pid ] && kill $(cat .blink/daemon.pid); exit 1")
    if !r.success() { return -1 }
    r.out.trim().to_int()
}

fn stop_daemon(pid: Int) {
    let _ = sh("kill {pid}; for i in $(seq 1 100); do kill -0 {pid} 2>/dev/null || exit 0; sleep 0.05; done; kill -9 {pid}")
}

fn served_checks() -> Str {
    let out = sh("B=$(pwd)/build/blink; cd {DIR} && $B daemon status").out
    match out.byte_index_of("\"checks\":", 0) {
        Some(at) => out.byte_slice(at, out.byte_len()).trim()
        None => "no status: {out}"
    }
}

test "a daemon check of a file after its unclosed string is closed reports what a cold check does" {
    let _ = sh("rm -rf {DIR}; mkdir -p {DIR}")
    write_file("{DIR}/blink.toml", "[package]\nname = \"daemon_check_after_unclosed\"\nversion = \"0.1.0\"\n")
    // A lock no older than blink.toml keeps "resolving dependencies..." out of every check here.
    write_file("{DIR}/blink.lock", "[metadata]\nlockfile-version = 1\n")
    write_file("{DIR}/main.bl", fixed_src())
    let cold = check()

    write_file("{DIR}/main.bl", unclosed_src())
    let pid = start_daemon()
    let warm_unclosed = check()
    write_file("{DIR}/main.bl", fixed_src())
    let warm = check()
    let after = served_checks()
    if pid > 0 { stop_daemon(pid) }
    let _ = sh("rm -rf {DIR}")

    assert(pid > 0)
    assert(warm_unclosed.err_out.contains("error[UnterminatedLiteral]"), warm_unclosed.err_out)
    assert(cold.err_out.contains("error[TypeError]"), cold.err_out)
    assert(cold.err_out.contains("warning["), cold.err_out)
    assert_eq(warm.err_out, cold.err_out)
    assert_eq(warm.exit_code, cold.exit_code)
    // Both checks above are the daemon's own, not a cold check behind it.
    assert_eq(after, "\"checks\":2}")
}
