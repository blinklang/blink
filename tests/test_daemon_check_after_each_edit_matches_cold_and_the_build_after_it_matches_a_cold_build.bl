// A daemon answers a check before it writes what only a later request reads: the other output
// format, the interface text of each source, and the stats it polls. It writes them once the
// reply is sent. A check through the daemon after each edit must still print what a cold check
// prints, in both formats, and the build after it must print what a cold build prints and
// leave the same files, the binary and each unit's record too.

import std.process.{ProcessResult}
import std.testing.{cleanup}
import compile_test_helpers

fn sh(cmd: Str) -> Str {
    process_run("sh", ["-c", cmd]).out.trim()
}

fn dev_tree(root: Str, tree: Str) {
    shell_exec("rm -rf {tree}")
    shell_exec("mkdir -p {tree}/build {tree}/app/src")
    // A copy, not a link: the install root comes from realpath(argv[0]).
    shell_exec("cp {sh("readlink -f build/blink")} {tree}/build/blink")
    shell_exec("ln -s {root}/lib {tree}/build/lib && ln -s {tree}/build/lib {tree}/lib")
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        shell_exec("[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}")
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    shell_exec("[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h")
    // The daemon listens at the project root, so each tree is a project of its own.
    write_file("{tree}/app/blink.toml", "[package]\nname = \"daemon_check_then_build_app\"\nversion = \"0.1.0\"\n")
    // A lock no older than blink.toml keeps "resolving dependencies..." out of every build.
    write_file("{tree}/app/blink.lock", "[metadata]\nlockfile-version = 1\n")
    write_file("{tree}/app/src/lib.bl", [
        #"pub fn used_fn(n: Int) -> Int {"#,
        #"    n * 2"#,
        #"}"#,
        #""#,
        #"pub fn other_fn() -> Int {"#,
        #"    5"#,
        #"}"#,
        #""#,
    ].join("\n"))
    write_file("{tree}/app/src/user.bl", [
        #"import lib.{used_fn}"#,
        #""#,
        #"pub fn user_value() -> Int {"#,
        #"    used_fn(2)"#,
        #"}"#,
        #""#,
    ].join("\n"))
    write_file("{tree}/app/src/main.bl", [
        #"import lib.{other_fn}"#,
        #"import user.{user_value}"#,
        #""#,
        #"fn main() {"#,
        #"    io.println("values {user_value()} {other_fn()}")"#,
        #"}"#,
        #""#,
    ].join("\n"))
}

// The corpus exports BLINK_COMPILER_ARCHIVE and may export BLINK_PER_MODULE; the first makes
// a build one unit, so the run drops both, and the module filters. The daemon starts under
// the same env, since it serves only a client whose env is its own.
fn env_of(tree: Str) -> Str {
    "env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_PER_MODULE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE BLINK_CACHE_DIR={tree}/objcache"
}

fn blink_in(tree: Str, args: Str) -> ProcessResult {
    process_run("sh", ["-c", "cd {tree}/app && {env_of(tree)} ../build/blink {args}"])
}

// The pid of the daemon serving src/main.bl in tree, or -1. The timeout ends a daemon that
// nothing stopped.
fn start_daemon(tree: Str) -> Int {
    shell_exec("cd {tree}/app && ({env_of(tree)} timeout 300 ../build/blink daemon start src/main.bl > {tree}/daemon.log 2>&1 &)")
    let up = process_run("sh", ["-c", "for i in $(seq 1 600); do [ -S {tree}/app/.blink/daemon.sock ] && exit 0; sleep 0.05; done; exit 1"])
    let pid = sh("cat {tree}/app/.blink/daemon.pid 2>/dev/null").to_int()
    if up.exit_code != 0 {
        stop_daemon(pid)
        return -1
    }
    pid
}

// Ends the daemon and each worker it started, by pid.
fn stop_daemon(pid: Int) {
    if pid <= 0 { return }
    let workers = sh("ps -o pid= --ppid {pid} | tr -s ' \\n' ' '").trim()
    shell_exec("kill {pid} {workers} 2>/dev/null; for i in $(seq 1 100); do left=''; for p in {pid} {workers}; do kill -0 $p 2>/dev/null && left=1; done; [ -z \"$left\" ] && exit 0; sleep 0.05; done; kill -9 {pid} {workers} 2>/dev/null")
}

// A field of `daemon status`, such as "builds", or -1 when the status has none.
fn served(tree: Str, field: Str) -> Int {
    let out = blink_in(tree, "daemon status").out
    let key = "\"{field}\":"
    match out.byte_index_of(key, 0) {
        Some(at) => {
            let rest = out.byte_slice(at + key.byte_len(), out.byte_len())
            let mut n = ""
            for c in rest {
                if c < '0' || c > '9' { break }
                n = "{n}{c}"
            }
            n.to_int()
        }
        None => -1
    }
}

// What a build printed, with its tree's path and its private units directory's random name
// spelled the same in every tree.
fn plain(tree: Str, s: Str) -> Str {
    let t = s.replace(tree, "TREE")
    let mut out = ""
    let mut rest = t
    loop {
        match rest.byte_index_of(".units.", 0) {
            Some(at) => {
                let end = if at + 13 <= rest.byte_len() { at + 13 } else { rest.byte_len() }
                out = "{out}{rest.byte_slice(0, at)}.units.XXXXXX"
                rest = rest.byte_slice(end, rest.byte_len())
            }
            None => break
        }
    }
    "{out}{rest}"
}

// The first difference between two results of the same command in two trees, or "".
fn differ(a_tree: Str, a: ProcessResult, b_tree: Str, b: ProcessResult) -> Str {
    if a.exit_code != b.exit_code { return "exit {a.exit_code} vs {b.exit_code}:\n{a.out}{a.err_out}\n-- vs --\n{b.out}{b.err_out}" }
    if plain(a_tree, a.out) != plain(b_tree, b.out) { return "stdout:\n{a.out}\n-- vs --\n{b.out}" }
    if plain(a_tree, a.err_out) != plain(b_tree, b.err_out) { return "stderr:\n{a.err_out}\n-- vs --\n{b.err_out}" }
    ""
}

// What a file in a tree's out/ holds, with the tree's path spelled the same in every tree.
// The record names the inputs text by its sha, which the path is part of, so that line goes.
fn out_file(tree: Str, name: Str) -> Str {
    let text = read_file("{tree}/app/out/{name}").replace(tree, "TREE")
    if !name.ends_with("/.emit-record") { return text }
    text.split("\n").filter(fn(l) { !l.starts_with("inputs ") }).join("\n")
}

// The files each tree's out/ holds, by name and then content, that the other's does not.
fn files_differ(a_tree: Str, b_tree: Str) -> Str {
    let list = "find . -type f | LC_ALL=C sort"
    let a = sh("mkdir -p {a_tree}/app/out && cd {a_tree}/app/out && {list}")
    let b = sh("mkdir -p {b_tree}/app/out && cd {b_tree}/app/out && {list}")
    if a != b { return "out/ holds\n{a}\n-- vs --\n{b}" }
    let mut different: List[Str] = []
    for name in a.split("\n") {
        if name != "" && out_file(a_tree, name) != out_file(b_tree, name) { different.push(name) }
    }
    different.join(" ")
}

fn edit_lib(tree: Str, from: Str, to: Str) {
    let path = "{tree}/app/src/lib.bl"
    let before = read_file(path)
    write_file(path, before.replace(from, to))
    assert(read_file(path) != before, "the edit to {from} did not change lib.bl")
}

test "a daemon check after each edit prints the cold check in each format, and the build after it matches a cold build" {
    let root = sh("pwd -P")
    let warm = "{compile_test_helpers.scratch_root()}/_daemon_check_then_build_warm_{getpid()}"
    let cold = "{compile_test_helpers.scratch_root()}/_daemon_check_then_build_cold_{getpid()}"
    dev_tree(root, warm)
    dev_tree(root, cold)
    let mut problems: List[Str] = []
    let mut outputs: List[Str] = []
    let mut checks = -1
    let mut builds = -1
    let pid = start_daemon(warm)
    with cleanup(fn() { stop_daemon(pid) }) {
        assert(pid > 0, "the daemon did not start: {read_file("{warm}/daemon.log")}")
        let edits = [
            ("", ""),
            ("pub fn other_fn() -> Int \{\n    5", "pub fn other_fn() -> Int \{\n    let unused_v = 3\n    5"),
            ("pub fn other_fn", "pub fn added_fn() -> Int \{\n    7\n}\n\npub fn other_fn"),
            ("used_fn(n: Int) -> Int \{\n    n * 2", "used_fn(n: Int, -- k: Int = 5) -> Int \{\n    n * k"),
        ]
        for (from, to) in edits {
            if from != "" {
                for t in [warm, cold] { edit_lib(t, from, to) }
            }
            // The first check after an edit rechecks and renders the format it is asked for;
            // the second is served from that check, in the other format.
            for args in ["check --json src/main.bl", "check src/main.bl"] {
                let d = differ(warm, blink_in(warm, args), cold, blink_in(cold, args))
                if d != "" { problems.push("`{args}` after `{to}`: {d}") }
            }
            // The cold tree's build stays cold: its last units and objects go first.
            shell_exec("rm -rf {cold}/app/out {cold}/objcache")
            let args = "build src/main.bl -o out/app"
            let w = blink_in(warm, args)
            let c = blink_in(cold, args)
            let d = differ(warm, w, cold, c)
            if d != "" { problems.push("build after `{to}`: {d}") }
            let f = files_differ(warm, cold)
            if f != "" { problems.push("build after `{to}`: {f}") }
            outputs.push(sh("{warm}/app/out/app"))
        }
        checks = served(warm, "checks")
        builds = served(warm, "builds")
    }
    shell_exec("rm -rf {warm} {cold}")
    assert_eq(problems.join("\n"), "")
    assert_eq(outputs.join(","), "values 4 5,values 4 5,values 4 5,values 10 5")
    assert_eq(checks, 8)
    assert_eq(builds, 4)
}
