// A check reads the compiler binary and the environment besides its sources, so the daemon
// checks only for a client that runs its compiler under its environment. A client with another
// variable is not served, and prints what a cold check prints. The dev knob
// BLINK_DEV_PARSER_LIMIT makes the parse of a file that holds the named identifier stop as a
// parser limit does, so the client's environment changes what its check prints; the daemon
// starts without it.

import std.process.{ProcessResult}

let DIR = ".tmp/daemon_check_other_env"
let KNOB = "BLINK_DEV_PARSER_LIMIT=other_env_probe_ident"

fn sh(cmd: Str) -> ProcessResult {
    process_run("sh", ["-c", cmd])
}

fn probe_src() -> Str {
    "fn main() \{\n    let other_env_probe_ident = 1\n    io.println(\"\{other_env_probe_ident}\")\n}\n"
}

// The timeout keeps a client that waits on a dead worker from hanging the test: it exits 124.
fn check(env_args: Str, flags: Str) -> ProcessResult {
    sh("B=$(pwd)/build/blink; cd {DIR} && {env_args} timeout 60 $B check {flags} main.bl")
}

// The pid of a daemon serving main.bl, or -1. The timeout ends a daemon that nothing stopped.
fn start_daemon() -> Int {
    let r = sh("B=$(pwd)/build/blink; cd {DIR} && rm -rf .blink && (timeout 120 $B daemon start main.bl > daemon.log 2>&1 &); for i in $(seq 1 400); do if [ -S .blink/daemon.sock ]; then cat .blink/daemon.pid; exit 0; fi; sleep 0.05; done; [ -f .blink/daemon.pid ] && kill $(cat .blink/daemon.pid); exit 1")
    if r.exit_code != 0 { return -1 }
    r.out.trim().to_int()
}

fn stop_daemon(pid: Int) {
    let _ = sh("kill {pid}; for i in $(seq 1 100); do kill -0 {pid} 2>/dev/null || exit 0; sleep 0.05; done; kill -9 {pid}")
}

// The checks the daemon's workers served, from `daemon status`.
fn checks_served() -> Str {
    let out = sh("B=$(pwd)/build/blink; cd {DIR} && $B daemon status").out
    match out.byte_index_of("\"checks\":", 0) {
        Some(at) => out.byte_slice(at, out.byte_len()).trim()
        None => "no status: {out}"
    }
}

fn same(label: Str, cold: ProcessResult, warm: ProcessResult) -> Bool {
    let ok = cold.out == warm.out && cold.err_out == warm.err_out && cold.exit_code == warm.exit_code
    if !ok {
        io.eprintln("{label} cold (exit {cold.exit_code}):\n{cold.out}\n--stderr--\n{cold.err_out}")
        io.eprintln("{label} daemon (exit {warm.exit_code}):\n{warm.out}\n--stderr--\n{warm.err_out}")
    }
    ok
}

test "a check from a client of another environment is not served and prints what a cold check prints" {
    let _ = sh("rm -rf {DIR}; mkdir -p {DIR}")
    write_file("{DIR}/blink.toml", "[package]\nname = \"daemon_check_other_env\"\nversion = \"0.1.0\"\n")
    // A lock no older than blink.toml keeps "resolving dependencies..." out of every check here.
    write_file("{DIR}/blink.lock", "[metadata]\nlockfile-version = 1\n")
    write_file("{DIR}/main.bl", probe_src())
    let cold = check(KNOB, "")
    let cold_json = check(KNOB, "--json")
    assert_eq(cold.exit_code, 101)
    assert(cold.err_out.contains("internal compiler error[ParserInternalLimit]"), "cold stderr: {cold.err_out}")

    let pid = start_daemon()
    assert(pid > 0, "the daemon did not start")
    let warm = check(KNOB, "")
    let warm_json = check(KNOB, "--json")
    let after = checks_served()
    stop_daemon(pid)

    assert(same("check", cold, warm), "a check from another environment differs from cold")
    assert(same("check --json", cold_json, warm_json), "a check --json from another environment differs from cold")
    assert(after.starts_with("\"checks\":0"), "the daemon served a client of another environment: {after}")
}
