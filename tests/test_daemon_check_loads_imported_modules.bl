// The daemon checks the program the build compiles: the entry file, the modules it imports and
// the prelude. A daemon that checks the entry file alone reports the imported name as undefined
// and never sees the error inside the imported module.

import std.process.{ProcessResult}
import compile_test_helpers

let DIR = "{compile_test_helpers.scratch_root()}/daemon_check_imports"

fn sh(cmd: Str) -> ProcessResult {
    process.run("sh", ["-c", cmd]).unwrap()
}

test "daemon check reports a type error inside an imported module" {
    let _ = sh("rm -rf {DIR}; mkdir -p {DIR}/src")
    write_file("{DIR}/blink.toml", "[package]\nname = \"daemon_imports\"\nversion = \"0.1.0\"\n")
    write_file("{DIR}/src/helper.bl", "pub fn helper() -> Int \{\n    let s: Int = \"no\"\n    s\n}\n")
    write_file("{DIR}/src/main.bl", "import helper\n\nfn main() \{\n    io.println(\"\{helper.helper()}\")\n}\n")
    // The daemon starts from the package root, where `src/main.bl` finds blink.toml, and
    // answers a check of the same path from the same directory. The timeout ends a daemon that
    // a failed assert left running.
    let started = sh("B=$(pwd)/build/blink; cd {DIR} && (timeout 120 $B daemon start src/main.bl > daemon.log 2>&1 &); for i in $(seq 1 400); do [ -S .blink/daemon.sock ] && exit 0; sleep 0.05; done; exit 1")
    assert_eq(started.exit_code, 0)
    let out = sh("B=$(pwd)/build/blink; cd {DIR} && $B check --json src/main.bl 2>&1").out
    let _ = sh("B=$(pwd)/build/blink; cd {DIR}/src && $B daemon stop")
    if !out.contains("E0300") || out.contains("E0506") { io.eprintln("daemon check: {out}") }
    assert(out.contains("E0300"))
    assert(out.contains("helper.bl"))
    assert(!out.contains("E0506"))
}
