// A daemon serves every file of its project, not only the entry it started on. A check of
// another entry through it prints and exits as a cold check in a twin tree does, and the
// daemon answers it itself: its status counts the check and the warm entry.

import std.process.{ProcessResult}
import std.testing.{cleanup}
import compile_test_helpers

fn sh(cmd: Str) -> Str {
    process.run("sh", ["-c", cmd]).unwrap().out.trim()
}

fn dev_tree(root: Str, tree: Str) {
    shell_exec("rm -rf {tree}")
    shell_exec("mkdir -p {tree}/build {tree}/app/src")
    // A copy, not a link: the install root comes from realpath(argv[0]).
    shell_exec("cp {sh("readlink -f build/blink")} {tree}/build/blink")
    shell_exec("ln -s {root}/lib {tree}/build/lib && ln -s {root}/lib {tree}/lib")
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        shell_exec("[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}")
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    shell_exec("[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h")
    // The daemon listens at the project root, so each tree is a project of its own.
    write_file("{tree}/app/blink.toml", "[package]\nname = \"daemon_second_check_app\"\nversion = \"0.1.0\"\n")
    write_file("{tree}/app/blink.lock", "[metadata]\nlockfile-version = 1\n")
    write_file("{tree}/app/src/base.bl", [
        #"pub fn tag(s: Str) -> Str {"#,
        #"    "[{s}]""#,
        #"}"#,
        #""#,
    ].join("\n"))
    write_file("{tree}/app/src/main.bl", [
        #"import base.{tag}"#,
        #""#,
        #"fn main() {"#,
        #"    io.println(tag("main"))"#,
        #"}"#,
        #""#,
    ].join("\n"))
    // The unused local gives the check a warning to print, which names the file.
    write_file("{tree}/app/src/second.bl", [
        #"import base.{tag}"#,
        #""#,
        #"fn main() {"#,
        #"    let spare = 1"#,
        #"    io.println(tag("second"))"#,
        #"}"#,
        #""#,
    ].join("\n"))
}

// The corpus exports BLINK_COMPILER_ARCHIVE and may export BLINK_PER_MODULE; the run drops
// both, and the module filters, and the daemon starts under the same env.
fn env_of(tree: Str) -> Str {
    "env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_PER_MODULE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE BLINK_CACHE_DIR={tree}/objcache"
}

fn blink_in(tree: Str, args: Str) -> ProcessResult {
    process.run("sh", ["-c", "cd {tree}/app && {env_of(tree)} timeout 120 ../build/blink {args}"]).unwrap()
}

// The pid of the daemon serving src/main.bl in tree, or -1. The timeout ends a daemon that
// nothing stopped. It runs blink by the path the clients use, since the daemon builds
// only for a client that names its compiler the same way.
fn start_daemon(tree: Str) -> Int {
    shell_exec("cd {tree}/app && ({env_of(tree)} timeout 300 ../build/blink daemon start src/main.bl > {tree}/daemon.log 2>&1 &)")
    let up = process.run("sh", ["-c", "for i in $(seq 1 600); do [ -S {tree}/app/.blink/daemon.sock ] && exit 0; sleep 0.05; done; exit 1"]).unwrap()
    let pid = sh("cat {tree}/app/.blink/daemon.pid 2>/dev/null").to_int()
    if !up.success() {
        stop_daemon(pid)
        return -1
    }
    pid
}

fn stop_daemon(pid: Int) {
    if pid <= 0 { return }
    shell_exec("kill {pid} 2>/dev/null; for i in $(seq 1 100); do kill -0 {pid} 2>/dev/null || exit 0; sleep 0.05; done; kill -9 {pid}")
}

// A field of `daemon status`, such as "checks", or -1 when the status has none.
fn served(tree: Str, field: Str) -> Int {
    let out = blink_in(tree, "daemon status").out
    let key = "\"{field}\":"
    match out.byte_index_of(key, 0) {
        Some(at) => {
            let rest = out.byte_slice(at + key.byte_len(), out.byte_len())
            let mut n = ""
            for c in rest {
                if c < '0' || c > '9' { break }
                n = "{n}{c}"
            }
            if n == "" { -1 } else { n.to_int() }
        }
        None => -1
    }
}

// The first difference between two results of the same command in two trees, or "".
fn differ(a_tree: Str, a: ProcessResult, b_tree: Str, b: ProcessResult) -> Str {
    if a.exit_code != b.exit_code { return "exit {a.exit_code} vs {b.exit_code}:\n{a.out}{a.err_out}\n-- vs --\n{b.out}{b.err_out}" }
    if a.out.replace(a_tree, "TREE") != b.out.replace(b_tree, "TREE") { return "stdout:\n{a.out}\n-- vs --\n{b.out}" }
    if a.err_out.replace(a_tree, "TREE") != b.err_out.replace(b_tree, "TREE") { return "stderr:\n{a.err_out}\n-- vs --\n{b.err_out}" }
    ""
}

fn compare_checks(warm: Str, cold: Str, args: Str) -> Str {
    let d = differ(warm, blink_in(warm, args), cold, blink_in(cold, args))
    if d != "" { "{args}: {d}" } else { "" }
}

test "a check of a second entry through the daemon matches a cold check and the daemon serves it" {
    let root = sh("pwd -P")
    let warm = "{compile_test_helpers.scratch_root()}/_daemon_second_check_warm_{getpid()}"
    let cold = "{compile_test_helpers.scratch_root()}/_daemon_second_check_cold_{getpid()}"
    dev_tree(root, warm)
    dev_tree(root, cold)
    let pid = start_daemon(warm)
    let mut problems: List[Str] = []
    let mut counts: List[Str] = []
    with cleanup(fn() { stop_daemon(pid) }) {
        assert(pid > 0, "the daemon did not start: {read_file("{warm}/daemon.log")}")
        problems.push(compare_checks(warm, cold, "check src/second.bl"))
        counts.push("checks={served(warm, "checks")} entries={served(warm, "entries")}")
        // A type error makes the check exit 1 with the error on stderr.
        for t in [warm, cold] { shell_exec("sed -i 's/tag(\"second\")/tag(2)/' {t}/app/src/second.bl") }
        problems.push(compare_checks(warm, cold, "check src/second.bl"))
        problems.push(compare_checks(warm, cold, "check --json src/second.bl"))
        problems.push(compare_checks(warm, cold, "check src/main.bl"))
        counts.push("checks={served(warm, "checks")} entries={served(warm, "entries")}")
    }
    shell_exec("rm -rf {warm} {cold}")
    let found: List[Str] = problems.filter(fn(p) { p != "" })
    assert_eq(found.join("\n"), "")
    assert_eq(counts.join(", "), "checks=1 entries=2, checks=4 entries=2")
}
