// A client from before the daemon compared a check's identity sends a check with no identity
// and no settings. The daemon can not tell which compiler and environment that client runs, so
// it answers not served, and sends the client to no worker: the client then checks cold.

import std.process.{ProcessResult}
import compile_test_helpers

let DIR = "{compile_test_helpers.scratch_root()}/daemon_check_no_identity"

fn sh(cmd: Str) -> ProcessResult {
    process_run("sh", ["-c", cmd])
}

// The pid of a daemon serving main.bl, or -1. The timeout ends a daemon that nothing stopped.
fn start_daemon() -> Int {
    let r = sh("B=$(pwd)/build/blink; cd {DIR} && rm -rf .blink && (timeout 120 $B daemon start main.bl > daemon.log 2>&1 &); for i in $(seq 1 400); do if [ -S .blink/daemon.sock ]; then cat .blink/daemon.pid; exit 0; fi; sleep 0.05; done; [ -f .blink/daemon.pid ] && kill $(cat .blink/daemon.pid); exit 1")
    if r.exit_code != 0 { return -1 }
    r.out.trim().to_int()
}

fn stop_daemon(pid: Int) {
    let _ = sh("kill {pid}; for i in $(seq 1 100); do kill -0 {pid} 2>/dev/null || exit 0; sleep 0.05; done; kill -9 {pid}")
}

// The daemon's reply to one request line, or "" when none came.
fn ask(request: Str) -> Str {
    let fd = unix_socket_connect("{DIR}/.blink/daemon.sock")
    if fd < 0 { return "" }
    if socket_write(fd, request.concat("\n")) < 0 {
        unix_socket_close(fd)
        return ""
    }
    let reply = socket_read_line(fd)
    unix_socket_close(fd)
    reply
}

test "a check request that names no identity is not served and goes to no worker" {
    let _ = sh("rm -rf {DIR}; mkdir -p {DIR}")
    write_file("{DIR}/blink.toml", "[package]\nname = \"daemon_check_no_identity\"\nversion = \"0.1.0\"\n")
    // A lock no older than blink.toml keeps "resolving dependencies..." out of every check here.
    write_file("{DIR}/blink.lock", "[metadata]\nlockfile-version = 1\n")
    write_file("{DIR}/main.bl", "fn main() \{\n    io.println(\"hi\")\n}\n")
    let cwd = sh("cd {DIR} && pwd -P").out.trim()

    let pid = start_daemon()
    assert(pid > 0, "the daemon did not start")
    let check = ask("\{\"type\":\"check\",\"cwd\":\"{cwd}\",\"path\":\"main.bl\",\"json\":0,\"diag_json\":0,\"strict\":0}")
    let query = ask("\{\"type\":\"query\",\"query_type\":\"fn\",\"name\":\"main\"}")
    stop_daemon(pid)

    assert(check.contains("\"served\":0") && !check.contains("\"worker\""), "check reply: {check}")
    assert(query.contains("\"served\":0") && !query.contains("\"worker\""), "query reply: {query}")
}
