// A daemon worker runs the front end in its own process, so a parser internal limit, which
// stops the compiler on the spot, ends that worker. The client of that check must still get
// what a cold `blink check` gives: exit 101, the internal error on stderr, and under --json the
// ice status line. The router must serve on, and the next check of the entry must be served by
// a new worker. No source program reaches a limit, so the dev knob BLINK_DEV_PARSER_LIMIT makes
// the parse of a file that holds the named identifier stop as a limit does. The knob goes to
// the daemon and to every client alike, so a cold check behind the daemon meets it too.

import std.process.{ProcessResult}
import compile_test_helpers

let DIR = "{compile_test_helpers.scratch_root()}/daemon_check_parser_limit"
let KNOB = "BLINK_DEV_PARSER_LIMIT=parser_limit_probe_ident"

fn sh(cmd: Str) -> ProcessResult {
    process.run("sh", ["-c", cmd]).unwrap()
}

fn clean_src() -> Str {
    "fn main() \{\n    io.println(\"hi\")\n}\n"
}

fn fault_src() -> Str {
    "fn main() \{\n    let parser_limit_probe_ident = 1\n    io.println(\"\{parser_limit_probe_ident}\")\n}\n"
}

// The timeout keeps a client that waits on a dead worker from hanging the test: it exits 124.
fn check(flags: Str) -> ProcessResult {
    sh("B=$(pwd)/build/blink; cd {DIR} && {KNOB} timeout 60 $B check {flags} main.bl")
}

// The pid of a daemon serving main.bl, or -1. The timeout ends a daemon that nothing stopped.
fn start_daemon() -> Int {
    let r = sh("B=$(pwd)/build/blink; cd {DIR} && rm -rf .blink && ({KNOB} timeout 120 $B daemon start main.bl > daemon.log 2>&1 &); for i in $(seq 1 400); do if [ -S .blink/daemon.sock ]; then cat .blink/daemon.pid; exit 0; fi; sleep 0.05; done; [ -f .blink/daemon.pid ] && kill $(cat .blink/daemon.pid); exit 1")
    if r.exit_code != 0 { return -1 }
    r.out.trim().to_int()
}

fn stop_daemon(pid: Int) {
    let _ = sh("kill {pid}; for i in $(seq 1 100); do kill -0 {pid} 2>/dev/null || exit 0; sleep 0.05; done; kill -9 {pid}")
}

fn alive(pid: Int) -> Bool {
    sh("kill -0 {pid}").exit_code == 0
}

// The router's counts from `daemon status`, from "entries" on.
fn served() -> Str {
    let out = sh("B=$(pwd)/build/blink; cd {DIR} && {KNOB} $B daemon status").out
    match out.byte_index_of("\"entries\":", 0) {
        Some(at) => out.byte_slice(at, out.byte_len()).trim()
        None => "no status: {out}"
    }
}

fn same(label: Str, cold: ProcessResult, warm: ProcessResult) -> Bool {
    let ok = cold.out == warm.out && cold.err_out == warm.err_out && cold.exit_code == warm.exit_code
    if !ok {
        io.eprintln("{label} cold (exit {cold.exit_code}):\n{cold.out}\n--stderr--\n{cold.err_out}")
        io.eprintln("{label} daemon (exit {warm.exit_code}):\n{warm.out}\n--stderr--\n{warm.err_out}")
    }
    ok
}

test "a daemon check that meets a parser internal limit prints what a cold check prints and the daemon serves on" {
    let _ = sh("rm -rf {DIR}; mkdir -p {DIR}")
    write_file("{DIR}/blink.toml", "[package]\nname = \"daemon_parser_limit\"\nversion = \"0.1.0\"\n")
    // A lock no older than blink.toml keeps "resolving dependencies..." out of every check here.
    write_file("{DIR}/blink.lock", "[metadata]\nlockfile-version = 1\n")
    write_file("{DIR}/main.bl", fault_src())
    let cold = check("")
    let cold_json = check("--json")
    assert_eq(cold.exit_code, 101)
    assert(cold.err_out.contains("internal compiler error[ParserInternalLimit]"), "cold stderr: {cold.err_out}")
    assert_eq(cold_json.out, "\{\"status\":\"ice\",\"file\":\"main.bl\"}\n")

    let pid = start_daemon()
    assert(pid > 0, "the daemon did not start")
    let warm = check("")
    let warm_json = check("--json")
    let router_after_fault = alive(pid)
    // The router reaps a dead worker on its next turn, which may come just after this client.
    let mut after_fault = served()
    let mut tries = 0
    while !after_fault.starts_with("\"entries\":0,") && tries < 40 {
        let _ = sh("sleep 0.05")
        after_fault = served()
        tries = tries + 1
    }
    write_file("{DIR}/main.bl", clean_src())
    let clean = check("")
    let after_clean = served()
    write_file("{DIR}/main.bl", fault_src())
    let warm_again = check("")
    let router_at_end = alive(pid)
    stop_daemon(pid)

    assert(same("check", cold, warm), "a daemon check that met the limit differs from cold")
    assert(same("check --json", cold_json, warm_json), "a daemon check --json that met the limit differs from cold")
    assert(router_after_fault, "the router ended with the worker")
    // The worker that met the limit is gone, and the router reaped it.
    assert(after_fault.starts_with("\"entries\":0,"), "status after the fault: {after_fault}")
    assert_eq(clean.exit_code, 0)
    assert_eq(clean.out, "ok: main.bl\n")
    // A new worker served the clean check, not a cold check behind the daemon.
    assert(after_clean.starts_with("\"entries\":1,") && after_clean.contains("\"checks\":1"), "status after the clean check: {after_clean}")
    assert(same("check after a served check", cold, warm_again), "a warm worker that met the limit differs from cold")
    assert(router_at_end, "the router ended after the second fault")
}
