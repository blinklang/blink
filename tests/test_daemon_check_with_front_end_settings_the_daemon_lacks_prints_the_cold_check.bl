// A setting that changes what the front end reports makes the daemon's checked program the
// wrong one to answer from, so a check that names one is not served, and prints what a cold
// check prints. The daemon checks with the settings a check with no flags applies:
// --strict-struct-layout makes an undeclared @ffi.struct header an error, and --blink-trace
// prints the front end's trace.

import std.process.{ProcessResult}

let DIR = ".tmp/daemon_check_other_settings"

fn sh(cmd: Str) -> ProcessResult {
    process_run("sh", ["-c", cmd])
}

fn layout_src() -> Str {
    "@ffi.struct(header: \"poll.h\", name: \"pollfd\")\npub type Pollfd \{ fd: I32, events: I16, revents: I16 }\n\nfn main() \{\n    io.println(\"hi\")\n}\n"
}

fn check(flags: Str) -> ProcessResult {
    sh("B=$(pwd)/build/blink; cd {DIR} && timeout 60 $B check {flags} main.bl")
}

// The pid of a daemon serving main.bl, or -1. The timeout ends a daemon that nothing stopped.
fn start_daemon() -> Int {
    let r = sh("B=$(pwd)/build/blink; cd {DIR} && rm -rf .blink && (timeout 120 $B daemon start main.bl > daemon.log 2>&1 &); for i in $(seq 1 400); do if [ -S .blink/daemon.sock ]; then cat .blink/daemon.pid; exit 0; fi; sleep 0.05; done; [ -f .blink/daemon.pid ] && kill $(cat .blink/daemon.pid); exit 1")
    if r.exit_code != 0 { return -1 }
    r.out.trim().to_int()
}

fn stop_daemon(pid: Int) {
    let _ = sh("kill {pid}; for i in $(seq 1 100); do kill -0 {pid} 2>/dev/null || exit 0; sleep 0.05; done; kill -9 {pid}")
}

// The checks the daemon's workers served, from `daemon status`.
fn checks_served() -> Str {
    let out = sh("B=$(pwd)/build/blink; cd {DIR} && $B daemon status").out
    match out.byte_index_of("\"checks\":", 0) {
        Some(at) => out.byte_slice(at, out.byte_len()).trim()
        None => "no status: {out}"
    }
}

fn same(label: Str, cold: ProcessResult, warm: ProcessResult) -> Bool {
    let ok = cold.out == warm.out && cold.err_out == warm.err_out && cold.exit_code == warm.exit_code
    if !ok {
        io.eprintln("{label} cold (exit {cold.exit_code}):\n{cold.out}\n--stderr--\n{cold.err_out}")
        io.eprintln("{label} daemon (exit {warm.exit_code}):\n{warm.out}\n--stderr--\n{warm.err_out}")
    }
    ok
}

test "a check with front-end settings the daemon lacks is not served and prints what a cold check prints" {
    let _ = sh("rm -rf {DIR}; mkdir -p {DIR}")
    write_file("{DIR}/blink.toml", "[package]\nname = \"daemon_check_other_settings\"\nversion = \"0.1.0\"\n")
    // A lock no older than blink.toml keeps "resolving dependencies..." out of every check here.
    write_file("{DIR}/blink.lock", "[metadata]\nlockfile-version = 1\n")
    write_file("{DIR}/main.bl", layout_src())
    let flag_sets = ["--strict-struct-layout", "--blink-trace parse"]
    let mut colds: List[ProcessResult] = []
    for flags in flag_sets {
        colds.push(check(flags))
    }
    assert(colds.get(0).unwrap().exit_code != 0, "the strict layout check passed cold: {colds.get(0).unwrap().err_out}")
    assert(colds.get(0).unwrap().err_out.contains("MissingCanonicalHeader"), "cold stderr: {colds.get(0).unwrap().err_out}")

    let pid = start_daemon()
    assert(pid > 0, "the daemon did not start")
    let mut ok = true
    let mut i = 0
    for flags in flag_sets {
        if !same("check {flags}", colds.get(i).unwrap(), check(flags)) { ok = false }
        i = i + 1
    }
    let after = checks_served()
    stop_daemon(pid)

    assert(ok, "a check with front-end settings the daemon lacks differs from cold")
    assert(after.starts_with("\"checks\":0"), "the daemon served a client with other settings: {after}")
}
