// A client that closes its connection before reading the reply must not take the daemon down:
// the daemon's write fails, and it serves the next request. The reply here is long, so the
// daemon is still writing when it finds the peer gone.

import std.process.{ProcessResult}

let DIR = ".tmp/daemon_outlives_early_close"

fn sh(cmd: Str) -> ProcessResult {
    process_run("sh", ["-c", cmd])
}

fn src_with_warnings(n: Int) -> Str {
    let mut sb = StringBuilder.new()
    let mut i = 0
    while i < n {
        sb.write("fn f{i}() -> Int \{\n    return {i}\n    {i}\n}\n\n")
        i = i + 1
    }
    sb.write("fn main() \{\n    io.println(\"\{f0()}\")\n}\n")
    sb.to_str()
}

// The pid of a daemon serving main.bl, or -1. The timeout ends a daemon that nothing stopped.
fn start_daemon() -> Int {
    let r = sh("B=$(pwd)/build/blink; cd {DIR} && rm -rf .blink && ((timeout 120 $B daemon start main.bl > daemon.log 2>&1; echo \"daemon exit $?\" >> daemon.log) > /dev/null 2>&1 &); for i in $(seq 1 400); do if [ -S .blink/daemon.sock ]; then cat .blink/daemon.pid; exit 0; fi; sleep 0.05; done; [ -f .blink/daemon.pid ] && kill $(cat .blink/daemon.pid); exit 1")
    if r.exit_code != 0 { return -1 }
    r.out.trim().to_int()
}

fn stop_daemon(pid: Int) {
    let _ = sh("kill {pid}; for i in $(seq 1 100); do kill -0 {pid} 2>/dev/null || exit 0; sleep 0.05; done; kill -9 {pid}")
}

fn request() -> Str {
    let cwd = sh("cd {DIR} && pwd -P").out.trim()
    "\{\"type\":\"check\",\"cwd\":\"{cwd}\",\"path\":\"main.bl\"}\n"
}

test "the daemon serves the next request after a client closed without reading" {
    let _ = sh("rm -rf {DIR}; mkdir -p {DIR}")
    write_file("{DIR}/main.bl", src_with_warnings(500))
    let pid = start_daemon()
    let req = request()
    let mut early = -1
    let mut reply = ""
    if pid > 0 {
        early = unix_socket_connect("{DIR}/.blink/daemon.sock")
        if early >= 0 {
            socket_write(early, req)
            unix_socket_close(early)
        }
        // The daemon checks before it writes; give it time to find the peer gone.
        let _ = sh("sleep 2")
        let fd = unix_socket_connect("{DIR}/.blink/daemon.sock")
        if fd >= 0 {
            socket_write(fd, req)
            reply = socket_read_line(fd)
            unix_socket_close(fd)
        }
    }
    let alive = sh("kill -0 {pid}").exit_code == 0
    if pid > 0 { stop_daemon(pid) }
    if !alive { io.eprintln(read_file("{DIR}/daemon.log")) }

    assert(pid > 0)
    assert(early >= 0)
    assert(alive)
    assert(reply.starts_with("\{\"ok\":true"))
}
