// A client that closes its connection before reading the reply must not take the daemon down:
// the daemon's write fails, the daemon says so in its log, and it serves the next request. The
// reply here is long, so the daemon is still writing when it finds the peer gone.

import std.process.{ProcessResult}
import std.json.{json_clear, json_parse, json_get, json_as_str}
import compile_test_helpers

let DIR = "{compile_test_helpers.scratch_root()}/daemon_outlives_early_close"

fn sh(cmd: Str) -> ProcessResult {
    process_run("sh", ["-c", cmd])
}

fn src_with_warnings(n: Int) -> Str {
    let mut sb = StringBuilder.new()
    let mut i = 0
    while i < n {
        sb.write("fn f{i}() -> Int \{\n    return {i}\n    {i}\n}\n\n")
        i = i + 1
    }
    sb.write("fn main() \{\n    io.println(\"\{f0()}\")\n}\n")
    sb.to_str()
}

// The fields a check with no flags names, as this compiler under this environment spells
// them: the daemon serves only a client of its own compiler, environment and settings.
fn front_fields() -> Str {
    let f = sh("B=$(pwd)/build/blink; $B __daemon-front-fields").out.trim()
    f.byte_slice(1, f.byte_len() - 1)
}

// The pid of a daemon serving main.bl, or -1. The timeout ends a daemon that nothing stopped.
fn start_daemon() -> Int {
    let r = sh("B=$(pwd)/build/blink; cd {DIR} && rm -rf .blink && ((timeout 120 $B daemon start main.bl > daemon.log 2>&1; echo \"daemon exit $?\" >> daemon.log) > /dev/null 2>&1 &); for i in $(seq 1 400); do if [ -S .blink/daemon.sock ]; then cat .blink/daemon.pid; exit 0; fi; sleep 0.05; done; [ -f .blink/daemon.pid ] && kill $(cat .blink/daemon.pid); exit 1")
    if r.exit_code != 0 { return -1 }
    r.out.trim().to_int()
}

fn stop_daemon(pid: Int) {
    let _ = sh("kill {pid}; for i in $(seq 1 100); do kill -0 {pid} 2>/dev/null || exit 0; sleep 0.05; done; kill -9 {pid}")
}

// The socket of the worker that serves req: the router replies to a check with that worker's
// name, and the request goes there. "" when the router named none.
fn worker_socket(req: Str) -> Str {
    let fd = unix_socket_connect("{DIR}/.blink/daemon.sock")
    if fd < 0 { return "" }
    socket_write(fd, req)
    let reply = socket_read_line(fd)
    unix_socket_close(fd)
    json_clear()
    let root = json_parse(reply)
    let name = if root < 0 { "" } else { json_as_str(json_get(root, "worker")) }
    if name == "" { "" } else { "{DIR}/.blink/{name}/daemon.sock" }
}

fn request() -> Str {
    let cwd = sh("cd {DIR} && pwd -P").out.trim()
    "\{{front_fields()},\"cwd\":\"{cwd}\",\"path\":\"main.bl\"}\n"
}

test "the daemon serves the next request after a client closed without reading" {
    let _ = sh("rm -rf {DIR}; mkdir -p {DIR}")
    write_file("{DIR}/blink.toml", "[package]\nname = \"early_close\"\nversion = \"0.1.0\"\n")
    write_file("{DIR}/main.bl", src_with_warnings(500))
    let pid = start_daemon()
    let req = request()
    let mut early = -1
    let mut reply = ""
    if pid > 0 {
        early = unix_socket_connect(worker_socket(req))
        if early >= 0 {
            socket_write(early, req)
            unix_socket_close(early)
        }
        // The daemon checks before it writes; give it time to find the peer gone.
        let _ = sh("sleep 2")
        let fd = unix_socket_connect(worker_socket(req))
        if fd >= 0 {
            socket_write(fd, req)
            reply = socket_read_line(fd)
            unix_socket_close(fd)
        }
    }
    let alive = sh("kill -0 {pid}").exit_code == 0
    if pid > 0 { stop_daemon(pid) }
    let log = read_file("{DIR}/daemon.log")
    if !alive { io.eprintln(log) }

    assert(pid > 0)
    assert(early >= 0)
    assert(alive)
    assert(log.contains("daemon: could not send the reply, so it dropped the connection"))
    assert(reply.starts_with("\{\"ok\":true"))
}
