// The daemon serves a connection, and a client sends a request, only when the kernel names this
// user at the other end. A call for the peer's uid that fails must refuse the peer, as the
// daemon can not tell who it is. Only a platform with no such call serves unchecked, where the
// closed .blink directory is the guard. Accept and both client sockets take this one decision.

import daemon.{daemon_peer_uid_allowed, daemon_peer_check_supported, daemon_connected_peer_uid, daemon_own_uid}

let FAILED = -1
let UNSUPPORTED = -2

fn sh(cmd: Str) -> Str {
    process_run("sh", ["-c", cmd]).out.trim()
}

test "a failed call refuses the peer and only an unsupported platform serves unchecked" {
    let own = daemon_own_uid()
    assert(!daemon_peer_uid_allowed(FAILED, own), "a failed call must refuse the peer")
    assert(daemon_peer_uid_allowed(UNSUPPORTED, own), "no call on this platform: the closed directory is the guard")
    assert(daemon_peer_uid_allowed(own, own), "this user is served")
    assert(!daemon_peer_uid_allowed(own + 1, own), "another user is refused")
}

test "linux supports the check whatever the arch, and a descriptor that is no socket names nobody" {
    if sh("uname -s") == "Linux" {
        assert(daemon_peer_check_supported(), "SO_PEERCRED is on every Linux")
    }
    assert(daemon_connected_peer_uid(-1).is_none(), "-1 is no socket")
}
