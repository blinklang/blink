// The daemon serves only its own user, and a client sends its environment only to a daemon of
// its own user. Both ask the kernel which user is at the other end of the socket. Where the
// peer check is supported, that is this process's user for a connection it made to itself, and
// nobody for a descriptor that is no socket.

import daemon.{daemon_peer_uid, daemon_own_uid}

fn sh(cmd: Str) -> Str {
    process_run("sh", ["-c", cmd]).out.trim()
}

fn shown(uid: Option[Int]) -> Str {
    match uid {
        Some(u) => "{u}"
        None => "nobody"
    }
}

test "the peer of a connection this process made to itself is its own user" {
    let me = sh("id -u")
    assert_eq("{daemon_own_uid()}", me)
    let dir = sh("mktemp -d")
    let path = "{dir}/peer.sock"
    let listener = unix_socket_listen(path)
    let client = unix_socket_connect(path)
    let server = unix_socket_accept_timeout(listener, 1000)
    let ok = listener >= 0 && client >= 0 && server >= 0
    let from_server = shown(daemon_peer_uid(server))
    let from_client = shown(daemon_peer_uid(client))
    let none = shown(daemon_peer_uid(-1))
    unix_socket_close(server)
    unix_socket_close(client)
    unix_socket_close(listener)
    let _ = sh("rm -rf '{dir}'")
    assert(ok, "the socket connection failed")
    let arch = sh("uname -s -m")
    if arch == "Linux x86_64" || arch == "Linux aarch64" {
        assert_eq(from_server, me)
        assert_eq(from_client, me)
    } else {
        assert_eq(from_server, "nobody")
        assert_eq(from_client, "nobody")
    }
    assert_eq(none, "nobody")
}
