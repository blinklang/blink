// A query reads the file as it is on disk now. After an edit, with no check or build between,
// a query through the daemon prints what a cold query of the edited file prints, never the
// symbols the daemon indexed before the edit. The edit keeps the file's size, so only its
// bytes tell it apart. Once the daemon has checked the edit on its own, it serves the query
// again.

import std.process.{ProcessResult}
import compile_test_helpers

let DIR = "{compile_test_helpers.scratch_root()}/daemon_query_after_edit"

fn sh(cmd: Str) -> ProcessResult {
    process.run("sh", ["-c", cmd]).unwrap()
}

fn blink(args: Str) -> ProcessResult {
    sh("B=$(pwd)/build/blink; cd {DIR} && timeout 60 $B {args}")
}

// The pid of a daemon serving src/main.bl, or -1. The timeout ends a daemon that nothing
// stopped.
fn start_daemon() -> Int {
    let r = sh("B=$(pwd)/build/blink; cd {DIR} && rm -rf .blink && (timeout 120 $B daemon start src/main.bl > daemon.log 2>&1 &); for i in $(seq 1 400); do if [ -S .blink/daemon.sock ]; then cat .blink/daemon.pid; exit 0; fi; sleep 0.05; done; [ -f .blink/daemon.pid ] && kill $(cat .blink/daemon.pid); exit 1")
    if !r.success() { return -1 }
    r.out.trim().to_int()
}

fn stop_daemon(pid: Int) {
    let _ = sh("kill {pid}; for i in $(seq 1 100); do kill -0 {pid} 2>/dev/null || exit 0; sleep 0.05; done; kill -9 {pid}")
}

// A field of `daemon status`, such as "queries", or -1 when the status has none.
fn status_field(field: Str) -> Int {
    let out = blink("daemon status").out
    let key = "\"{field}\":"
    match out.byte_index_of(key, 0) {
        Some(at) => {
            let rest = out.byte_slice(at + key.byte_len(), out.byte_len())
            let mut n = ""
            for c in rest {
                if c < '0' || c > '9' { break }
                n = "{n}{c}"
            }
            if n == "" { -1 } else { n.to_int() }
        }
        None => -1
    }
}

fn differ(args: Str, warm: ProcessResult, cold: ProcessResult) -> Str {
    if warm.exit_code != cold.exit_code { return "{args}: exit {warm.exit_code} vs {cold.exit_code}" }
    if warm.out != cold.out { return "{args}: stdout\n{warm.out}-- vs --\n{cold.out}" }
    if warm.err_out != cold.err_out { return "{args}: stderr\n{warm.err_out}-- vs --\n{cold.err_out}" }
    ""
}

fn source(name: Str) -> Str {
    "pub fn {name}(x: Int) -> Int \{\n    x + 1\n}\n\nfn main() \{\n    io.println(\"\{{name}(1)}\")\n}\n"
}

test "a query after an edit with no check between prints what a cold query of the edited file prints" {
    let _ = sh("rm -rf {DIR}; mkdir -p {DIR}/src")
    write_file("{DIR}/blink.toml", "[package]\nname = \"daemon_query_after_edit\"\nversion = \"0.1.0\"\n")
    write_file("{DIR}/blink.lock", "[metadata]\nlockfile-version = 1\n")
    write_file("{DIR}/src/main.bl", source("before"))
    let cases = ["query src/main.bl --fn before", "query src/main.bl --fn after", "query src/main.bl"]

    let pid = start_daemon()
    assert(pid > 0, "the daemon did not start")
    let served_before = blink(cases.get(0).unwrap())
    let first = status_field("queries")
    write_file("{DIR}/src/main.bl", source("after").replace("fn main", "fn  main"))
    let mut warms: List[ProcessResult] = []
    for c in cases { warms.push(blink(c)) }
    // The daemon checks an edit on its own once no request came for half a second; a query
    // after that is served.
    let mut refreshed = -1
    let mut _k = 0
    while _k < 40 {
        let _ = sh("sleep 0.7")
        let _ = blink(cases.get(1).unwrap())
        refreshed = status_field("queries")
        if refreshed > first { break }
        _k = _k + 1
    }
    stop_daemon(pid)
    let mut problems: List[Str] = []
    let mut i = 0
    while i < cases.len() {
        let d = differ(cases.get(i).unwrap(), warms.get(i).unwrap(), blink(cases.get(i).unwrap()))
        if d != "" { problems.push(d) }
        i = i + 1
    }
    let _ = sh("rm -rf {DIR}")

    assert(served_before.out.contains("\"name\":\"before\""), "the first query found no before: {served_before.out}")
    assert_eq(problems.join("\n"), "")
    assert_eq(first, 1)
    assert(refreshed > first, "no query was served after the daemon checked the edit: queries={refreshed}")
}
