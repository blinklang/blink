// A query runs the front end too, so the daemon answers one only for a client that runs its
// compiler under its environment. A client with another variable is not served, and prints
// what a cold query prints. The dev knob BLINK_DEV_PARSER_LIMIT makes the parse of a file
// that holds the named identifier stop as a parser limit does; the daemon starts without it.

import std.process.{ProcessResult}

let DIR = ".tmp/daemon_query_other_env"
let KNOB = "BLINK_DEV_PARSER_LIMIT=query_env_probe"

fn sh(cmd: Str) -> ProcessResult {
    process_run("sh", ["-c", cmd])
}

fn query() -> ProcessResult {
    sh("B=$(pwd)/build/blink; cd {DIR} && {KNOB} timeout 60 $B query main.bl --fn query_env_probe")
}

// The pid of a daemon serving main.bl, or -1. The timeout ends a daemon that nothing stopped.
fn start_daemon() -> Int {
    let r = sh("B=$(pwd)/build/blink; cd {DIR} && rm -rf .blink && (timeout 120 $B daemon start main.bl > daemon.log 2>&1 &); for i in $(seq 1 400); do if [ -S .blink/daemon.sock ]; then cat .blink/daemon.pid; exit 0; fi; sleep 0.05; done; [ -f .blink/daemon.pid ] && kill $(cat .blink/daemon.pid); exit 1")
    if r.exit_code != 0 { return -1 }
    r.out.trim().to_int()
}

fn stop_daemon(pid: Int) {
    let _ = sh("kill {pid}; for i in $(seq 1 100); do kill -0 {pid} 2>/dev/null || exit 0; sleep 0.05; done; kill -9 {pid}")
}

test "a query from a client of another environment is not served and prints what a cold query prints" {
    let _ = sh("rm -rf {DIR}; mkdir -p {DIR}")
    write_file("{DIR}/blink.toml", "[package]\nname = \"daemon_query_other_env\"\nversion = \"0.1.0\"\n")
    // A lock no older than blink.toml keeps "resolving dependencies..." out of every query here.
    write_file("{DIR}/blink.lock", "[metadata]\nlockfile-version = 1\n")
    write_file("{DIR}/main.bl", "pub fn query_env_probe(x: Int) -> Int \{\n    x + 1\n}\n\nfn main() \{\n    io.println(\"\{query_env_probe(1)}\")\n}\n")
    let cold = query()
    assert_eq(cold.exit_code, 101)

    let pid = start_daemon()
    assert(pid > 0, "the daemon did not start")
    let warm = query()
    stop_daemon(pid)

    assert_eq(warm.exit_code, cold.exit_code)
    assert_eq(warm.out, cold.out)
    assert_eq(warm.err_out, cold.err_out)
}
