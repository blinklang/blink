// A query of a file other than the entry the daemon started on prints what a cold query of
// that file prints, never the symbols of the first entry. Before any worker checks the file
// the daemon leaves the query cold, since starting a worker for it would cost more than the
// query; once a check of it made a worker, that worker answers it.

import std.process.{ProcessResult}

let DIR = ".tmp/daemon_query_second_entry"

fn sh(cmd: Str) -> ProcessResult {
    process_run("sh", ["-c", cmd])
}

fn blink(args: Str) -> ProcessResult {
    sh("B=$(pwd)/build/blink; cd {DIR} && timeout 60 $B {args}")
}

// The pid of a daemon serving src/main.bl, or -1. The timeout ends a daemon that nothing
// stopped.
fn start_daemon() -> Int {
    let r = sh("B=$(pwd)/build/blink; cd {DIR} && rm -rf .blink && (timeout 120 $B daemon start src/main.bl > daemon.log 2>&1 &); for i in $(seq 1 400); do if [ -S .blink/daemon.sock ]; then cat .blink/daemon.pid; exit 0; fi; sleep 0.05; done; [ -f .blink/daemon.pid ] && kill $(cat .blink/daemon.pid); exit 1")
    if r.exit_code != 0 { return -1 }
    r.out.trim().to_int()
}

fn stop_daemon(pid: Int) {
    let _ = sh("kill {pid}; for i in $(seq 1 100); do kill -0 {pid} 2>/dev/null || exit 0; sleep 0.05; done; kill -9 {pid}")
}

// A field of `daemon status`, such as "queries", or -1 when the status has none.
fn status_field(field: Str) -> Int {
    let out = blink("daemon status").out
    let key = "\"{field}\":"
    match out.byte_index_of(key, 0) {
        Some(at) => {
            let rest = out.byte_slice(at + key.byte_len(), out.byte_len())
            let mut n = ""
            for c in rest {
                if c < '0' || c > '9' { break }
                n = "{n}{c}"
            }
            if n == "" { -1 } else { n.to_int() }
        }
        None => -1
    }
}

fn differ(args: Str, warm: ProcessResult, cold: ProcessResult) -> Str {
    if warm.exit_code != cold.exit_code { return "{args}: exit {warm.exit_code} vs {cold.exit_code}" }
    if warm.out != cold.out { return "{args}: stdout\n{warm.out}-- vs --\n{cold.out}" }
    if warm.err_out != cold.err_out { return "{args}: stderr\n{warm.err_out}-- vs --\n{cold.err_out}" }
    ""
}

test "a query of a second entry prints what a cold query of it prints, and its worker serves it once a check made one" {
    let _ = sh("rm -rf {DIR}; mkdir -p {DIR}/src")
    write_file("{DIR}/blink.toml", "[package]\nname = \"daemon_query_second_entry\"\nversion = \"0.1.0\"\n")
    write_file("{DIR}/blink.lock", "[metadata]\nlockfile-version = 1\n")
    write_file("{DIR}/src/main.bl", "pub fn f(x: Int) -> Int \{\n    x + 1\n}\n\nfn main() \{\n    io.println(\"\{f(1)}\")\n}\n")
    write_file("{DIR}/src/second.bl", "pub fn h(x: Int) -> Int \{\n    x * 2\n}\n\nfn main() \{\n    io.println(\"\{h(1)}\")\n}\n")
    let cases = ["query src/second.bl --fn h", "query src/second.bl", "query src/second.bl --fn f"]
    let mut colds: List[ProcessResult] = []
    for c in cases { colds.push(blink(c)) }
    assert(colds.get(0).unwrap().out.contains("\"module\":\"second\""), "the cold query found no h: {colds.get(0).unwrap().out}")

    let pid = start_daemon()
    assert(pid > 0, "the daemon did not start")
    let mut problems: List[Str] = []
    let mut counts: List[Str] = []
    let mut i = 0
    while i < cases.len() {
        let d = differ("before a check: {cases.get(i).unwrap()}", blink(cases.get(i).unwrap()), colds.get(i).unwrap())
        if d != "" { problems.push(d) }
        i = i + 1
    }
    counts.push("queries={status_field("queries")} entries={status_field("entries")}")
    let checked = blink("check src/second.bl")
    i = 0
    while i < cases.len() {
        let d = differ("after a check: {cases.get(i).unwrap()}", blink(cases.get(i).unwrap()), colds.get(i).unwrap())
        if d != "" { problems.push(d) }
        i = i + 1
    }
    counts.push("queries={status_field("queries")} entries={status_field("entries")}")
    stop_daemon(pid)
    let _ = sh("rm -rf {DIR}")

    assert_eq(checked.exit_code, 0)
    assert_eq(problems.join("\n"), "")
    assert_eq(counts.join(", "), "queries=0 entries=1, queries=3 entries=2")
}
