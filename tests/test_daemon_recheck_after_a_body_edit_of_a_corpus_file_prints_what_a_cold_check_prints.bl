// A warm daemon check keeps the parsed nodes of each source whose bytes did not change. For
// each corpus file here, a warm check of the file, then of the file with one more statement
// in its first fn body, must print what a cold check of a twin tree prints, byte for byte, in
// human and JSON form; the edit leaves the imported sources kept, so the daemon must say it
// reused some. BODY_EDIT_ALL=1 runs every tests/test_*.bl rather than the few named below.

import std.process.{ProcessResult}

fn sh(cmd: Str) -> Str {
    process.run("sh", ["-c", cmd]).unwrap().out.trim()
}

fn twin_tree(root: Str, tree: Str) {
    shell_exec("rm -rf {tree}")
    shell_exec("mkdir -p {tree}/build {tree}/app")
    // A copy, not a link: the install root comes from realpath(argv[0]).
    shell_exec("cp {sh("readlink -f build/blink")} {tree}/build/blink")
    shell_exec("ln -s {root}/lib {tree}/build/lib && ln -s {root}/lib {tree}/lib")
    // The files a corpus file reads sit beside it, under the same spellings.
    shell_exec("cp -rL {root}/tests {tree}/app/tests")
    // A manifest makes app/ the project, so the daemon does not take the enclosing checkout
    // as its root; a lock no older than it keeps "resolving dependencies..." out of each check.
    write_file("{tree}/app/blink.toml", "[package]\nname = \"body_edit\"\nversion = \"0.1.0\"\n")
    write_file("{tree}/app/blink.lock", "[metadata]\nlockfile-version = 1\n")
    // The idle poll would check an edit cold and keep no source, if the request after the
    // edit came later than its wait; the hold keeps it off, so each warm check is a request's.
    write_file("{tree}/hold", "")
}

// The corpus exports BLINK_COMPILER_ARCHIVE and may export BLINK_PER_MODULE and the module
// filters; the daemon serves only a client whose env is its own, so both drop them. Both
// name the idle hold, which only the warm tree's daemon reads.
fn env_of(tree: Str) -> Str {
    "env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_PER_MODULE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE BLINK_CACHE_DIR={tree}/objcache BLINK_DEV_DAEMON_IDLE_HOLD={tree}/hold"
}

fn blink_in(tree: Str, args: Str) -> ProcessResult {
    process.run("sh", ["-c", "cd {tree}/app && {env_of(tree)} timeout 120 {tree}/build/blink {args}"]).unwrap()
}

// The pid of the daemon started in tree, or -1. The timeout ends a daemon that nothing
// stopped.
fn start_daemon(tree: Str, file: Str, life: Int) -> Int {
    shell_exec("cd {tree}/app && ({env_of(tree)} timeout {life} {tree}/build/blink daemon start {file} > {tree}/daemon.log 2>&1 &)")
    let up = process.run("sh", ["-c", "for i in $(seq 1 600); do [ -S {tree}/app/.blink/daemon.sock ] && exit 0; sleep 0.05; done; exit 1"]).unwrap()
    let pid = sh("cat {tree}/app/.blink/daemon.pid 2>/dev/null").to_int()
    if !up.success() {
        stop_daemon(pid)
        return -1
    }
    pid
}

fn stop_daemon(pid: Int) {
    if pid <= 0 { return }
    shell_exec("kill {pid} 2>/dev/null; for i in $(seq 1 100); do kill -0 {pid} 2>/dev/null || exit 0; sleep 0.05; done; kill -9 {pid}")
}

// A field of `daemon status`, such as "reused", or -1 when the status has none.
fn served(tree: Str, field: Str) -> Int {
    let out = blink_in(tree, "daemon status").out
    let key = "\"{field}\":"
    match out.byte_index_of(key, 0) {
        Some(at) => {
            let rest = out.byte_slice(at + key.byte_len(), out.byte_len())
            let mut n = ""
            for c in rest {
                if c < '0' || c > '9' { break }
                n = "{n}{c}"
            }
            if n == "" { -1 } else { n.to_int() }
        }
        None => -1
    }
}

// The first difference between two results of the same command in two trees, or "".
fn differ(a_tree: Str, a: ProcessResult, b_tree: Str, b: ProcessResult) -> Str {
    let ao = a.out.replace(a_tree, "TREE")
    let bo = b.out.replace(b_tree, "TREE")
    let ae = a.err_out.replace(a_tree, "TREE")
    let be = b.err_out.replace(b_tree, "TREE")
    if a.exit_code != b.exit_code { return "exit {a.exit_code} vs {b.exit_code}:\n{ao}{ae}\n-- vs --\n{bo}{be}" }
    if ao != bo { return "stdout:\n{ao}\n-- vs --\n{bo}" }
    if ae != be { return "stderr:\n{ae}\n-- vs --\n{be}" }
    ""
}

fn compare(warm: Str, cold: Str, file: Str, step: Str) -> Str {
    let mut out: List[Str] = []
    let human = "check {file}"
    let json = "check --format json {file}"
    let d = differ(warm, blink_in(warm, human), cold, blink_in(cold, human))
    if d != "" { out.push("{file}: after {step}: {human}: {d}") }
    let cj = blink_in(cold, json)
    let dj = differ(warm, blink_in(warm, json), cold, cj)
    if dj != "" { out.push("{file}: after {step}: {json}: {dj}") }
    out.join("\n")
}

// The text with `    let _body_edit_probe = 0` after the first line that opens a fn body,
// or "" when no line does.
fn body_edited(text: Str) -> Str {
    let lines = text.split("\n")
    let mut out: List[Str] = []
    let mut done = false
    for line in lines {
        out.push(line)
        if !done && line.starts_with("fn ") && line.trim().ends_with("\{") {
            out.push("    let _body_edit_probe = 0")
            done = true
        }
    }
    if done { out.join("\n") } else { "" }
}

// Corpus files of several kinds: effects and handlers, closures, generics, fn values, and a
// stdlib import.
let PICKS: List[Str] = [
    "tests/test_generic_instances_over_two_effects_handlers.bl",
    "tests/test_ev_closures_effects.bl",
    "tests/test_fn_named_as_value_forwards_to_its_declaration.bl",
    "tests/test_effect_vtable.bl",
    "tests/test_unpinned_channel_e0301.bl",
    "tests/test_an_invalid_lint_level_stays_an_error_under_allow_lints_and_strict.bl",
]

test "a warm recheck after a body edit of a corpus file prints what a cold check prints" {
    let root = sh("pwd")
    let warm = "{root}/build/body_edit_warm"
    let cold = "{root}/build/body_edit_cold"
    twin_tree(root, warm)
    twin_tree(root, cold)
    let all = (env.var("BODY_EDIT_ALL") ?? "") == "1"
    let mut files: List[Str] = []
    if all {
        for f in sh("cd {warm}/app && ls tests/test_*.bl").split("\n") { files.push(f) }
    } else {
        for f in PICKS {
            files.push(f)
        }
    }
    let pid = start_daemon(warm, files.get(0).unwrap(), if all { 86400 } else { 600 })
    assert(pid > 0, "the daemon did not start")
    let mut problems: List[Str] = []
    let mut edited = 0
    let mut unreused: List[Str] = []
    let mut reused = served(warm, "reused")
    for f in files {
        let text = read_file("{warm}/app/{f}")
        problems.push(compare(warm, cold, f, "a switch to the file"))
        let edit = body_edited(text)
        if edit != "" {
            edited = edited + 1
            for t in [warm, cold] { write_file("{t}/app/{f}", edit) }
            problems.push(compare(warm, cold, f, "a body edit"))
            let now = served(warm, "reused")
            for t in [warm, cold] { write_file("{t}/app/{f}", text) }
            if now <= reused { unreused.push(f) }
            reused = now
        }
        if all { io.eprintln("{f}: edited={edit != ""} reused={reused}") }
    }
    let checks = served(warm, "checks")
    stop_daemon(pid)
    shell_exec("rm -rf {warm} {cold}")
    let found: List[Str] = problems.filter(fn(p) { p != "" })
    // A program annotation in the entry is handed to the parse of each source after it, by
    // node id, so an edit of such an entry keeps no source; the full run lists those files.
    if all { io.eprintln("files={files.len()} edited={edited} checks={checks} problems={found.len()} unreused={unreused.join(" ")}") }
    assert_eq(found.join("\n"), "")
    assert(edited > 0, "no file had a fn body to edit")
    assert(reused > 0, "the daemon reused no source: reused={reused}")
    if !all { assert_eq(unreused.join(" "), "") }
}
