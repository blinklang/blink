// A daemon recheck that keeps parsed sources first undoes the last check: it puts back each
// node the passes after the parse wrote, and drops every node made after the parses, such as
// the nodes typecheck makes. A dropped node is dead, so no output shows one that stays; the
// pool would only grow with each check. The journal trace channel prints, on each undo, how
// many writes it undid and the pool size after it, which must be the parsed end.

import std.process.{ProcessResult}
import std.testing.{cleanup}
import compile_test_helpers

fn sh(cmd: Str) -> Str {
    process.run("sh", ["-c", cmd]).unwrap().out.trim()
}

fn leaf_text(value: Str) -> Str {
    "pub fn leaf_value() -> Str \{\n    let parts = [\"{value}\", \"x\"]\n    parts.join(\"-\")\n}\n"
}

fn dev_tree(root: Str, tree: Str) {
    shell_exec("rm -rf {tree}")
    shell_exec("mkdir -p {tree}/build {tree}/app/src")
    // A copy, not a link: the install root comes from realpath(argv[0]).
    shell_exec("cp {sh("readlink -f build/blink")} {tree}/build/blink")
    shell_exec("ln -s {root}/lib {tree}/build/lib && ln -s {root}/lib {tree}/lib")
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        shell_exec("[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}")
    }
    shell_exec("[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h")
    write_file("{tree}/app/blink.toml", "[package]\nname = \"daemon_undo_app\"\nversion = \"0.1.0\"\n")
    write_file("{tree}/app/blink.lock", "[metadata]\nlockfile-version = 1\n")
    write_file("{tree}/app/src/leaf.bl", leaf_text("one"))
    write_file("{tree}/app/src/main.bl", "import leaf.\{leaf_value}\n\nfn main() \{\n    io.println(leaf_value())\n}\n")
    // The idle poll would check an edit cold, which undoes nothing, and leave the request
    // after it nothing to check, if the request came later than its wait; the hold keeps it off.
    write_file("{tree}/hold", "")
}

// The daemon serves only a client whose env is its own, so both run with the channel on and
// the idle hold set.
fn env_of(tree: Str) -> Str {
    "env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_PER_MODULE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE BLINK_CACHE_DIR={tree}/objcache BLINK_TRACE_CHANNELS=journal BLINK_DEV_DAEMON_IDLE_HOLD={tree}/hold"
}

fn blink_in(tree: Str, args: Str) -> ProcessResult {
    process.run("sh", ["-c", "cd {tree}/app && {env_of(tree)} timeout 120 ../build/blink {args}"]).unwrap()
}

// The pid of the daemon serving src/main.bl in tree, or -1. The timeout ends a daemon that
// nothing stopped.
fn start_daemon(tree: Str) -> Int {
    shell_exec("cd {tree}/app && ({env_of(tree)} timeout 300 ../build/blink daemon start src/main.bl > {tree}/daemon.log 2>&1 &)")
    let up = process.run("sh", ["-c", "for i in $(seq 1 600); do [ -S {tree}/app/.blink/daemon.sock ] && exit 0; sleep 0.05; done; exit 1"]).unwrap()
    let pid = sh("cat {tree}/app/.blink/daemon.pid 2>/dev/null").to_int()
    if !up.success() {
        stop_daemon(pid)
        return -1
    }
    pid
}

fn stop_daemon(pid: Int) {
    if pid <= 0 { return }
    shell_exec("kill {pid} 2>/dev/null; for i in $(seq 1 100); do kill -0 {pid} 2>/dev/null || exit 0; sleep 0.05; done; kill -9 {pid}")
}

// The Int after `key` in line, or -1.
fn int_after(line: Str, key: Str) -> Int {
    match line.byte_index_of(key, 0) {
        Some(at) => {
            let rest = line.byte_slice(at + key.byte_len(), line.byte_len())
            let mut n = ""
            for c in rest {
                if c < '0' || c > '9' { break }
                n = "{n}{c}"
            }
            if n == "" { -1 } else { n.to_int() }
        }
        None => -1
    }
}

test "a daemon recheck drops every node made after the parses before it loads" {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_daemon_undo_{getpid()}"
    dev_tree(root, tree)
    let pid = start_daemon(tree)
    let mut errs: List[Str] = []
    let mut exits: List[Int] = []
    with cleanup(fn() { stop_daemon(pid) }) {
        assert(pid > 0, "the daemon did not start: {read_file("{tree}/daemon.log")}")
        let _ = blink_in(tree, "check src/main.bl")
        for v in ["two", "three", "four"] {
            write_file("{tree}/app/src/leaf.bl", leaf_text(v))
            let r = blink_in(tree, "check src/main.bl")
            exits.push(r.exit_code)
            errs.push(r.err_out)
        }
    }
    // A check may undo more than once, and an undo before the check's output is captured
    // prints to the daemon's own stderr.
    errs.push(read_file("{tree}/daemon.log"))
    shell_exec("rm -rf {tree}")

    for e in exits { assert_eq(e, 0) }
    let mut after_typecheck = 0
    for err in errs {
        for line in err.split("\n") {
            if !line.starts_with("[dbg:journal] undo") { continue }
            let writes = int_after(line, "undid ")
            let pool = int_after(line, "pool ")
            let parsed = int_after(line, "parsed end ")
            assert(writes >= 0, "no write count in: {line}")
            assert(parsed > 0, "no parsed end in: {line}")
            assert_eq(pool, parsed)
            if writes > 0 { after_typecheck = after_typecheck + 1 }
        }
    }
    // Each check of an edit undoes the typecheck of the check before it.
    assert_eq(after_typecheck, 3)
}
