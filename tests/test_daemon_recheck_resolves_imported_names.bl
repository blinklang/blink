// A daemon recheck after an edit checks the whole program, so a name the entry file imports
// from another module still resolves. A daemon that rechecks the entry file alone reports a
// clean program as calling an undefined function. The test asks the daemon over its socket, so
// the reply shows that the daemon answered and that it rechecked; a cold check cannot pass it.

import std.process.{ProcessResult}

let DIR = ".tmp/daemon_recheck_imports"

fn sh(cmd: Str) -> ProcessResult {
    process_run("sh", ["-c", cmd])
}

// The pid of a daemon serving src/main.bl, or -1. The timeout ends a daemon that nothing stopped.
fn start_daemon() -> Int {
    let r = sh("B=$(pwd)/build/blink; cd {DIR} && rm -rf src/.blink && (timeout 120 $B daemon start src/main.bl > daemon.log 2>&1 &); for i in $(seq 1 400); do if [ -S src/.blink/daemon.sock ]; then cat src/.blink/daemon.pid; exit 0; fi; sleep 0.05; done; [ -f src/.blink/daemon.pid ] && kill $(cat src/.blink/daemon.pid); exit 1")
    if r.exit_code != 0 { return -1 }
    r.out.trim().to_int()
}

fn stop_daemon(pid: Int) {
    let _ = sh("kill {pid}; for i in $(seq 1 100); do kill -0 {pid} 2>/dev/null || exit 0; sleep 0.05; done; kill -9 {pid}")
}

// The daemon's raw reply to a check of the entry it serves, as the client would send it.
fn ask_daemon() -> Str {
    let cwd = sh("cd {DIR} && pwd -P").out.trim()
    let fd = unix_socket_connect("{DIR}/src/.blink/daemon.sock")
    if fd < 0 { return "no connection" }
    socket_write(fd, "\{\"type\":\"check\",\"cwd\":\"{cwd}\",\"path\":\"src/main.bl\",\"json\":0,\"diag_json\":0,\"strict\":0}\n")
    let reply = socket_read_line(fd)
    unix_socket_close(fd)
    reply
}

test "daemon recheck after an edit resolves a selectively imported function" {
    let _ = sh("rm -rf {DIR}; mkdir -p {DIR}/src")
    write_file("{DIR}/blink.toml", "[package]\nname = \"daemon_recheck\"\nversion = \"0.1.0\"\n")
    write_file("{DIR}/src/helper.bl", "pub fn helper() -> Int \{\n    42\n}\n")
    write_file("{DIR}/src/main.bl", "import helper.\{helper}\n\nfn main() \{\n    io.println(\"\{helper()}\")\n}\n")
    let pid = start_daemon()
    let mut first = ""
    let mut after_edit = ""
    let mut through_cli = sh("true")
    if pid > 0 {
        first = ask_daemon()
        let _ = sh("printf \"\\n\" >> {DIR}/src/main.bl")
        after_edit = ask_daemon()
        through_cli = sh("B=$(pwd)/build/blink; cd {DIR} && $B check src/main.bl")
    }
    if pid > 0 { stop_daemon(pid) }
    if !after_edit.contains("\"changed\":1") || !after_edit.contains("\"exit\":0") {
        let log = read_file("{DIR}/daemon.log")
        io.eprintln("first: {first}\nafter edit: {after_edit}\ndaemon log: {log}")
    }

    assert(pid > 0)
    assert(first.contains("\"served\":1"))
    assert(first.contains("\"exit\":0"))
    assert(after_edit.contains("\"served\":1"))
    assert(after_edit.contains("\"changed\":1"))
    assert(after_edit.contains("\"exit\":0"))
    assert(!after_edit.contains("UndefinedFunction"))
    assert(!after_edit.contains("OrphanFile"))
    assert_eq(through_cli.exit_code, 0)
    assert(through_cli.out.contains("ok: src/main.bl"))
}
