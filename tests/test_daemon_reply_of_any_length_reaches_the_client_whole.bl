// A daemon reply is one line, and a client reads it whole however long it is. Each unreachable
// statement below adds one warning to the reply, so the counts put the reply past 4 KiB and past
// 64 KiB. The test is the client: it sends the check request on the socket itself and reads
// the line with socket_read_line.

import std.process.{ProcessResult}
import std.json.{json_clear, json_parse, json_get, json_as_str}

let DIR = ".tmp/daemon_reply_any_length"

fn sh(cmd: Str) -> ProcessResult {
    process_run("sh", ["-c", cmd])
}

fn src_with_warnings(n: Int) -> Str {
    let mut sb = StringBuilder.new()
    let mut i = 0
    while i < n {
        sb.write("fn f{i}() -> Int \{\n    return {i}\n    {i}\n}\n\n")
        i = i + 1
    }
    sb.write("fn main() \{\n    io.println(\"\{f0()}\")\n}\n")
    sb.to_str()
}

// The pid of a daemon serving main.bl, or -1. The timeout ends a daemon that nothing stopped.
fn start_daemon() -> Int {
    let r = sh("B=$(pwd)/build/blink; cd {DIR} && rm -rf .blink && (timeout 120 $B daemon start main.bl > daemon.log 2>&1 &); for i in $(seq 1 400); do if [ -S .blink/daemon.sock ]; then cat .blink/daemon.pid; exit 0; fi; sleep 0.05; done; [ -f .blink/daemon.pid ] && kill $(cat .blink/daemon.pid); exit 1")
    if r.exit_code != 0 { return -1 }
    r.out.trim().to_int()
}

fn stop_daemon(pid: Int) {
    let _ = sh("kill {pid}; for i in $(seq 1 100); do kill -0 {pid} 2>/dev/null || exit 0; sleep 0.05; done; kill -9 {pid}")
}

// The socket of the worker that serves req: the router replies to a check with that worker's
// name, and the request goes there. "" when the router named none.
fn worker_socket(req: Str) -> Str {
    let fd = unix_socket_connect("{DIR}/.blink/daemon.sock")
    if fd < 0 { return "" }
    socket_write(fd, req)
    let reply = socket_read_line(fd)
    unix_socket_close(fd)
    json_clear()
    let root = json_parse(reply)
    let name = if root < 0 { "" } else { json_as_str(json_get(root, "worker")) }
    if name == "" { "" } else { "{DIR}/.blink/{name}/daemon.sock" }
}

fn ask_check() -> Str {
    let cwd = sh("cd {DIR} && pwd -P").out.trim()
    let req = "\{\"type\":\"check\",\"cwd\":\"{cwd}\",\"path\":\"main.bl\"}\n"
    let fd = unix_socket_connect(worker_socket(req))
    if fd < 0 { return "" }
    socket_write(fd, req)
    let reply = socket_read_line(fd)
    unix_socket_close(fd)
    reply
}

fn reply_for(warnings: Int) -> Str {
    let _ = sh("rm -rf {DIR}; mkdir -p {DIR}")
    write_file("{DIR}/blink.toml", "[package]\nname = \"reply_any_length\"\nversion = \"0.1.0\"\n")
    write_file("{DIR}/main.bl", src_with_warnings(warnings))
    let pid = start_daemon()
    let reply = if pid > 0 { ask_check() } else { "daemon did not start" }
    if pid > 0 { stop_daemon(pid) }
    reply
}

fn is_whole_json(reply: Str) -> Bool {
    json_clear()
    reply.ends_with("}") && json_parse(reply) >= 0
}

test "a daemon reply longer than 4 KiB reaches the client whole" {
    let reply = reply_for(40)
    if !is_whole_json(reply) {
        let from = if reply.byte_len() > 80 { reply.byte_len() - 80 } else { 0 }
        io.eprintln("reply of {reply.byte_len()} bytes ends: {reply.byte_slice(from, reply.byte_len())}")
    }
    assert(reply.byte_len() > 4096)
    assert(is_whole_json(reply))
}

test "a daemon reply longer than 64 KiB reaches the client whole" {
    let reply = reply_for(500)
    if !is_whole_json(reply) { io.eprintln("reply of {reply.byte_len()} bytes") }
    assert(reply.byte_len() > 65536)
    assert(is_whole_json(reply))
}
