// The router answers a check with the name of the worker that serves the entry, and the client
// sends the check there. The router's reply says not served, so a client that does not follow
// it, such as a cli from before the router, reads it as a refusal and checks cold. The
// worker's reply is the answer, and says served.

import std.process.{ProcessResult}
import std.json.{json_clear, json_parse, json_get, json_as_str, json_as_int}
import compile_test_helpers

let DIR = "{compile_test_helpers.scratch_root()}/daemon_router_redirect"

fn sh(cmd: Str) -> ProcessResult {
    process.run("sh", ["-c", cmd]).unwrap()
}

// The fields a check with no flags names, as this compiler under this environment spells
// them: the daemon serves only a client of its own compiler, environment and settings.
fn front_fields() -> Str {
    let f = sh("B=$(pwd)/build/blink; $B __daemon-front-fields").out.trim()
    f.byte_slice(1, f.byte_len() - 1)
}

// The pid of a daemon serving main.bl, or -1. The timeout ends a daemon that nothing stopped.
fn start_daemon() -> Int {
    let r = sh("B=$(pwd)/build/blink; cd {DIR} && rm -rf .blink && (timeout 120 $B daemon start main.bl > daemon.log 2>&1 &); for i in $(seq 1 400); do if [ -S .blink/daemon.sock ]; then cat .blink/daemon.pid; exit 0; fi; sleep 0.05; done; [ -f .blink/daemon.pid ] && kill $(cat .blink/daemon.pid); exit 1")
    if !r.success() { return -1 }
    r.out.trim().to_int()
}

fn stop_daemon(pid: Int) {
    let _ = sh("kill {pid}; for i in $(seq 1 100); do kill -0 {pid} 2>/dev/null || exit 0; sleep 0.05; done; kill -9 {pid}")
}

// The reply to req on the socket at path, or "" with no connection.
fn ask(path: Str, req: Str) -> Str {
    let fd = unix_socket_connect(path)
    if fd < 0 { return "" }
    socket_write(fd, req)
    let reply = socket_read_line(fd)
    unix_socket_close(fd)
    reply
}

// "served=<n> worker=<name>" of a reply, with the name's pid part left out, as a router
// names its workers w<its pid>-<n>.
fn shape(reply: Str) -> Str {
    json_clear()
    let root = json_parse(reply)
    if root < 0 { return "no reply: {reply}" }
    let worker = json_as_str(json_get(root, "worker"))
    let n = match worker.byte_index_of("-", 0) {
        Some(at) => "w-{worker.byte_slice(at + 1, worker.byte_len())}"
        None => worker
    }
    "served={json_as_int(json_get(root, "served"))} worker={n}"
}

fn worker_of(reply: Str) -> Str {
    json_clear()
    let root = json_parse(reply)
    if root < 0 { "" } else { json_as_str(json_get(root, "worker")) }
}

test "the router's reply to a check names a worker and says not served, and the worker's says served" {
    let _ = sh("rm -rf {DIR}; mkdir -p {DIR}")
    write_file("{DIR}/blink.toml", "[package]\nname = \"router_redirect\"\nversion = \"0.1.0\"\n")
    write_file("{DIR}/main.bl", "fn main() \{\n    io.println(\"hi\")\n}\n")
    write_file("{DIR}/second.bl", "fn main() \{\n    io.println(\"two\")\n}\n")
    let pid = start_daemon()
    let cwd = sh("cd {DIR} && pwd -P").out.trim()
    let mut seen: List[Str] = []
    if pid > 0 {
        for path in ["main.bl", "second.bl"] {
            let req = "\{{front_fields()},\"cwd\":\"{cwd}\",\"path\":\"{path}\",\"json\":0,\"diag_json\":0,\"strict\":0}\n"
            let routed = ask("{DIR}/.blink/daemon.sock", req)
            seen.push("{path} router: {shape(routed)}")
            let answer = ask("{DIR}/.blink/{worker_of(routed)}/daemon.sock", req)
            seen.push("{path} worker: {shape(answer)}")
        }
        stop_daemon(pid)
    }
    assert(pid > 0)
    assert_eq(seen.join("\n"), "main.bl router: served=0 worker=w-1\nmain.bl worker: served=1 worker=\nsecond.bl router: served=0 worker=w-2\nsecond.bl worker: served=1 worker=")
}
