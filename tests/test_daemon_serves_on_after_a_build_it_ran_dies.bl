// The daemon runs each build in a child it forks, so a build that dies, here killed while its
// cc runs, ends that client's build alone: the client exits as the shell reports the death, and
// the daemon goes on serving builds that match a cold build.

import std.process.{ProcessResult}
import std.testing.{cleanup}

fn sh(cmd: Str) -> Str {
    process_run("sh", ["-c", cmd]).out.trim()
}

fn dev_tree(root: Str, tree: Str) {
    shell_exec("rm -rf {tree}")
    shell_exec("mkdir -p {tree}/build {tree}/app/src")
    // A copy, not a link: the install root comes from realpath(argv[0]).
    shell_exec("cp {sh("readlink -f build/blink")} {tree}/build/blink")
    // The compiler's lib/ is a real directory, so it can hold a bundled pkg module that a
    // local file later shadows. The stdlib stays the tree's.
    shell_exec("mkdir -p {tree}/build/lib/pkg && ln -s {root}/lib/std {tree}/build/lib/std && ln -s {tree}/build/lib {tree}/lib")
    write_file("{tree}/build/lib/pkg/probe.bl", "pub fn where() -> Str \{\n    \"bundled\"\n\}\n")
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        shell_exec("[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}")
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    shell_exec("[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h")
    // The daemon listens at the project root, so each tree is a project of its own.
    write_file("{tree}/app/blink.toml", "[package]\nname = \"daemon_crash_app\"\nversion = \"0.1.0\"\n")
    // A lock no older than blink.toml keeps "resolving dependencies..." out of every build.
    write_file("{tree}/app/blink.lock", "[metadata]\nlockfile-version = 1\n")
    write_file("{tree}/app/src/base.bl", [
        #"import pkg.probe.{where}"#,
        #""#,
        #"pub fn tag(s: Str) -> Str {"#,
        #"    "[{s} {where()}]""#,
        #"}"#,
        #""#,
    ].join("\n"))
    write_file("{tree}/app/src/leaf.bl", [
        #"import base.{tag}"#,
        #""#,
        #"pub fn leaf_value() -> Str {"#,
        #"    tag("leaf")"#,
        #"}"#,
        #""#,
    ].join("\n"))
    write_file("{tree}/app/src/extra.bl", [
        #"pub fn extra_value() -> Str {"#,
        #"    "extra""#,
        #"}"#,
        #""#,
    ].join("\n"))
    write_file("{tree}/app/src/main.bl", [
        #"import base.{tag}"#,
        #"import leaf.{leaf_value}"#,
        #"import extra.{extra_value}"#,
        #""#,
        #"fn main() {"#,
        #"    io.println("{tag("main")} {leaf_value()} {extra_value()}")"#,
        #"}"#,
        #""#,
    ].join("\n"))
}

// The corpus exports BLINK_COMPILER_ARCHIVE and may export BLINK_PER_MODULE; the first makes
// a build one unit, so the run drops both, and the module filters. The daemon starts under
// the same env, since it serves only a client whose env is its own.
// The cc first on PATH is the tree's, which holds a compile while cc.hold exists.
fn env_of(tree: Str) -> Str {
    "env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_PER_MODULE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE BLINK_CACHE_DIR={tree}/objcache BLINK_TRACE_CHANNELS=build.units PATH={tree}/ccwrap:$PATH"
}

// A cc that tells the test it started and then waits while cc.hold exists, so the test can
// kill the build it runs in, then runs the real cc. A held cc of a killed build gives up,
// so it writes nothing a later build reads.
fn hold_cc(tree: Str) {
    let real = sh("command -v cc")
    shell_exec("mkdir -p {tree}/ccwrap")
    write_file("{tree}/ccwrap/cc", "#!/bin/sh\nif [ -e {tree}/cc.hold ]; then\n    touch {tree}/cc.started\n    while [ -e {tree}/cc.hold ]; do sleep 0.05; done\n    [ -e {tree}/cc.abandon ] && exit 1\nfi\nexec {real} \"$@\"\n")
    shell_exec("chmod +x {tree}/ccwrap/cc")
}

fn blink_in(tree: Str, args: Str) -> ProcessResult {
    process_run("sh", ["-c", "cd {tree}/app && {env_of(tree)} ../build/blink {args}"])
}

// The pid of the daemon serving src/main.bl in tree, or -1. The timeout ends a daemon that
// nothing stopped.
fn start_daemon(tree: Str) -> Int {
    shell_exec("cd {tree}/app && ({env_of(tree)} timeout 300 ../build/blink daemon start src/main.bl > {tree}/daemon.log 2>&1 &)")
    let up = process_run("sh", ["-c", "for i in $(seq 1 600); do [ -S {tree}/app/.blink/daemon.sock ] && exit 0; sleep 0.05; done; exit 1"])
    let pid = sh("cat {tree}/app/.blink/daemon.pid 2>/dev/null").to_int()
    if up.exit_code != 0 {
        stop_daemon(pid)
        return -1
    }
    pid
}

fn stop_daemon(pid: Int) {
    if pid <= 0 { return }
    shell_exec("kill {pid} 2>/dev/null; for i in $(seq 1 100); do kill -0 {pid} 2>/dev/null || exit 0; sleep 0.05; done; kill -9 {pid}")
}

// A field of `daemon status`, such as "builds", or -1 when the status has none.
fn served(tree: Str, field: Str) -> Int {
    let out = blink_in(tree, "daemon status").out
    let key = "\"{field}\":"
    match out.byte_index_of(key, 0) {
        Some(at) => {
            let rest = out.byte_slice(at + key.byte_len(), out.byte_len())
            let mut n = ""
            for c in rest {
                if c < '0' || c > '9' { break }
                n = "{n}{c}"
            }
            n.to_int()
        }
        None => -1
    }
}

// What a build printed, with its tree's path and its private units directory's random name
// spelled the same in every tree.
fn plain(tree: Str, s: Str) -> Str {
    let t = s.replace(tree, "TREE")
    let mut out = ""
    let mut rest = t
    loop {
        match rest.byte_index_of(".units.", 0) {
            Some(at) => {
                let end = if at + 13 <= rest.byte_len() { at + 13 } else { rest.byte_len() }
                out = "{out}{rest.byte_slice(0, at)}.units.XXXXXX"
                rest = rest.byte_slice(end, rest.byte_len())
            }
            None => break
        }
    }
    "{out}{rest}"
}

// The first difference between two results of the same command in two trees, or "".
fn differ(a_tree: Str, a: ProcessResult, b_tree: Str, b: ProcessResult) -> Str {
    if a.exit_code != b.exit_code { return "exit {a.exit_code} vs {b.exit_code}:\n{a.out}{a.err_out}\n-- vs --\n{b.out}{b.err_out}" }
    if plain(a_tree, a.out) != plain(b_tree, b.out) { return "stdout:\n{a.out}\n-- vs --\n{b.out}" }
    if plain(a_tree, a.err_out) != plain(b_tree, b.err_out) { return "stderr:\n{a.err_out}\n-- vs --\n{b.err_out}" }
    ""
}

// What two trees' last builds left that differs: a C file of the units, or the program.
fn output_differ(a_tree: Str, b_tree: Str) -> Str {
    sh("cd {b_tree}/app/out/app.units && for f in *.c *.h; do cmp -s $f {a_tree}/app/out/app.units/$f || echo $f; done; cd {a_tree}/app/out/app.units && for f in *.c *.h; do [ -e {b_tree}/app/out/app.units/$f ] || echo extra:$f; done; [ -e {a_tree}/app/out/app ] || [ -e {b_tree}/app/out/app ] || exit 0; cmp -s {a_tree}/app/out/app {b_tree}/app/out/app || echo program").split("\n").join(" ")
}

fn edit(tree: Str, file: Str, sed: Str) {
    let path = "{tree}/app/src/{file}"
    let before = read_file(path)
    shell_exec("sed -i '{sed}' {path}")
    assert(read_file(path) != before, "the edit `{sed}` did not change {file}")
}

fn edit_both(warm: Str, cold: Str, file: Str, sed: Str) {
    edit(warm, file, sed)
    edit(cold, file, sed)
}

fn build(tree: Str) -> ProcessResult {
    blink_in(tree, "build src/main.bl -o out/app")
}

test "a build that dies in the daemon leaves the daemon serving" {
    let root = sh("pwd -P")
    let warm = "{root}/.tmp/_daemon_crash_warm_{getpid()}"
    let cold = "{root}/.tmp/_daemon_crash_cold_{getpid()}"
    dev_tree(root, warm)
    dev_tree(root, cold)
    hold_cc(warm)
    hold_cc(cold)
    let pid = start_daemon(warm)
    let mut first = -1
    let mut held = false
    let mut killed = ""
    let mut crash_rc = ""
    let mut alive = false
    let mut after_crash = -1
    let mut d = "no build"
    let mut o = "no build"
    let mut builds = -1
    with cleanup(fn() {
        shell_exec("rm -f {warm}/cc.hold")
        stop_daemon(pid)
    }) {
        assert(pid > 0, "the daemon did not start: {read_file("{warm}/daemon.log")}")
        let _w0 = build(warm)
        let _c0 = build(cold)
        first = served(warm, "builds")
        // An edit, so the next build compiles a unit and its cc runs.
        edit_both(warm, cold, "leaf.bl", #"s/"leaf"/"lea2"/"#)
        shell_exec("touch {warm}/cc.hold")
        shell_exec("cd {warm}/app && ({env_of(warm)} ../build/blink build src/main.bl -o out/app > {warm}/crash.out 2>&1; echo $? > {warm}/crash.rc) > /dev/null 2>&1 &")
        held = process_run("sh", ["-c", "for i in $(seq 1 1200); do [ -e {warm}/cc.started ] && exit 0; sleep 0.05; done; exit 1"]).exit_code == 0
        // The daemon's one child is the build: the daemon waits on it and runs nothing else.
        killed = sh("ps -o pid= --ppid {pid} | tr -d ' '")
        if held && killed != "" { shell_exec("kill -KILL {killed}") }
        shell_exec("touch {warm}/cc.abandon; rm -f {warm}/cc.hold")
        let _ = process_run("sh", ["-c", "for i in $(seq 1 1200); do [ -s {warm}/crash.rc ] && exit 0; sleep 0.05; done; exit 1"])
        crash_rc = sh("cat {warm}/crash.rc 2>/dev/null")
        alive = shell_exec("kill -0 {pid} 2>/dev/null") == 0
        after_crash = served(warm, "builds")
        d = differ(warm, build(warm), cold, build(cold))
        o = output_differ(warm, cold)
        builds = served(warm, "builds")
    }
    shell_exec("rm -rf {warm} {cold}")
    assert_eq(first, 1)
    assert(held, "no cc started in the build through the daemon")
    assert(killed != "", "the daemon had no child while its build ran")
    // 128 + SIGKILL, as a shell reports a build killed by it.
    assert_eq(crash_rc, "137")
    assert(alive, "the daemon died with its build")
    assert_eq(after_crash, 2)
    assert_eq(d, "")
    assert_eq(o, "")
    assert_eq(builds, 3)
}
