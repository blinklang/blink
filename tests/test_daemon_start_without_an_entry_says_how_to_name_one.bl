// blink.toml names no entry file, so `blink daemon start` with no argument cannot know what to
// serve. It must fail and say how to name the entry, not exit 0 having started nothing.

import std.process.{ProcessResult}
import compile_test_helpers

let DIR = "{compile_test_helpers.scratch_root()}/daemon_start_no_entry"

fn sh(cmd: Str) -> ProcessResult {
    process_run("sh", ["-c", cmd])
}

test "daemon start with no entry fails and says how to name one" {
    let _ = sh("rm -rf {DIR}; mkdir -p {DIR}/src")
    write_file("{DIR}/blink.toml", "[package]\nname = \"daemon_no_entry\"\nversion = \"0.1.0\"\n")
    write_file("{DIR}/src/main.bl", "fn main() \{\n    io.println(\"hi\")\n}\n")
    let r = sh("B=$(pwd)/build/blink; cd {DIR} && timeout 30 $B daemon start 2>&1")
    let sock = sh("[ -e {DIR}/.blink/daemon.sock ]").exit_code == 0

    assert_eq(r.exit_code, 1)
    assert(r.out.contains("blink daemon start <file.bl>"))
    assert(!sock)
}
