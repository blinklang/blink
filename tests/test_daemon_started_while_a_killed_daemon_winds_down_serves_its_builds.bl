// A daemon of a project starts while the workers of a daemon killed before it still run: each
// such worker ends only once it sees its router is gone, and then removes its own files. The
// new daemon serves its builds all the same, so what the old workers remove is never the new
// daemon's.

import std.process.{ProcessResult}
import std.testing.{cleanup}
import compile_test_helpers

fn sh(cmd: Str) -> Str {
    process.run("sh", ["-c", cmd]).unwrap().out.trim()
}

fn dev_tree(root: Str, tree: Str) {
    shell_exec("rm -rf {tree}")
    shell_exec("mkdir -p {tree}/build {tree}/app/src {tree}/app/tools")
    // A copy, not a link: the install root comes from realpath(argv[0]).
    shell_exec("cp {sh("readlink -f build/blink")} {tree}/build/blink")
    shell_exec("ln -s {root}/lib {tree}/build/lib && ln -s {root}/lib {tree}/lib")
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        shell_exec("[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}")
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    shell_exec("[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h")
    // The daemon listens at the project root, so each tree is a project of its own.
    write_file("{tree}/app/blink.toml", "[package]\nname = \"daemon_after_killed_app\"\nversion = \"0.1.0\"\n")
    // A lock no older than blink.toml keeps "resolving dependencies..." out of every build.
    write_file("{tree}/app/blink.lock", "[metadata]\nlockfile-version = 1\n")
    write_file("{tree}/app/src/base.bl", [
        #"pub fn tag(s: Str) -> Str {"#,
        #"    "[{s}]""#,
        #"}"#,
        #""#,
    ].join("\n"))
    for name in ["main", "second", "third"] {
        // The unused local gives each check a warning to print, which names the file.
        write_file("{tree}/app/src/{name}.bl", [
            #"import base.{tag}"#,
            #""#,
            #"fn main() {"#,
            "    let spare_{name} = 1",
            "    io.println(tag(\"{name}\"))",
            #"}"#,
            #""#,
        ].join("\n"))
    }
}

// The corpus exports BLINK_COMPILER_ARCHIVE and may export BLINK_PER_MODULE; the first makes
// a build one unit, so the run drops both, and the module filters. The daemon starts under
// the same env, since it builds only for a client whose env is its own.
fn env_of(tree: Str) -> Str {
    "env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_PER_MODULE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE BLINK_CACHE_DIR={tree}/objcache"
}

// Runs blink with args in dir, a directory of the project at tree/app.
fn blink_at(tree: Str, dir: Str, args: Str) -> ProcessResult {
    process.run("sh", ["-c", "cd {tree}/app/{dir} && {env_of(tree)} timeout 120 {tree}/build/blink {args}"]).unwrap()
}

fn blink_in(tree: Str, args: Str) -> ProcessResult {
    blink_at(tree, ".", args)
}

// The pid of the daemon started on src/main.bl in tree, or -1. A daemon killed before it
// leaves its socket and pid file, so the wait is for a pid file that names another daemon and
// a socket that answers. The timeout ends a daemon that nothing stopped. It runs blink by the
// path the clients use, since the daemon builds only for a client that names its compiler the
// same way.
fn start_daemon(tree: Str, before: Int) -> Int {
    shell_exec("cd {tree}/app && ({env_of(tree)} timeout 300 {tree}/build/blink daemon start src/main.bl > {tree}/daemon.log 2>&1 &)")
    let up = process.run("sh", ["-c", "cd {tree}/app && for i in $(seq 1 600); do p=$(cat .blink/daemon.pid 2>/dev/null); [ -n \"$p\" ] && [ \"$p\" != {before} ] && {env_of(tree)} {tree}/build/blink daemon status > /dev/null 2>&1 && exit 0; sleep 0.05; done; exit 1"]).unwrap()
    let pid = sh("cat {tree}/app/.blink/daemon.pid 2>/dev/null").to_int()
    if !up.success() || pid == before {
        stop_daemon(pid)
        return -1
    }
    pid
}

fn stop_daemon(pid: Int) {
    if pid <= 0 { return }
    shell_exec("kill {pid} 2>/dev/null; for i in $(seq 1 100); do kill -0 {pid} 2>/dev/null || exit 0; sleep 0.05; done; kill -9 {pid}")
}

// A field of `daemon status`, such as "checks", or -1 when the status has none.
fn served(tree: Str, field: Str) -> Int {
    let out = blink_in(tree, "daemon status").out
    let key = "\"{field}\":"
    match out.byte_index_of(key, 0) {
        Some(at) => {
            let rest = out.byte_slice(at + key.byte_len(), out.byte_len())
            let mut n = ""
            for c in rest {
                if c < '0' || c > '9' { break }
                n = "{n}{c}"
            }
            if n == "" { -1 } else { n.to_int() }
        }
        None => -1
    }
}

fn counts(tree: Str) -> Str {
    "builds={served(tree, "builds")} entries={served(tree, "entries")}"
}

fn build(tree: Str, entry: Str) -> Str {
    let r = blink_in(tree, "build src/{entry}.bl -o out/{entry}")
    if !r.success() { "build of {entry} ended with {r.end}: {r.out}{r.err_out}" } else { "" }
}

test "a daemon started while the workers of a killed daemon still end serves its builds" {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_daemon_after_killed_{getpid()}"
    dev_tree(root, tree)
    let mut problems: List[Str] = []
    let mut seen: List[Str] = []
    let mut old_workers = ""
    let mut old_ended = ""
    let first = start_daemon(tree, -1)
    with cleanup(fn() { stop_daemon(first) }) {
        assert(first > 0, "the first daemon did not start: {read_file("{tree}/daemon.log")}")
        problems.push(build(tree, "second"))
        problems.push(build(tree, "main"))
        seen.push(counts(tree))
        old_workers = sh("ps -o pid= --ppid {first} | tr '\\n' ' '")
    }
    // Each worker of the first daemon has just begun to wait for a request, so it outlives
    // its router while the second daemon starts its own workers.
    let second = start_daemon(tree, first)
    with cleanup(fn() { stop_daemon(second) }) {
        assert(second > 0, "the second daemon did not start: {read_file("{tree}/daemon.log")}")
        // The builds wait for each old worker to end, so each has removed its files by then.
        old_ended = sh("for i in $(seq 1 600); do left=''; for p in {old_workers}; do kill -0 $p 2>/dev/null && left=\"$left $p\"; done; [ -z \"$left\" ] && exit 0; sleep 0.05; done; echo $left")
        problems.push(build(tree, "main"))
        problems.push(build(tree, "second"))
        seen.push(counts(tree))
    }
    shell_exec("rm -rf {tree}")
    assert(old_workers.trim() != "", "the first daemon had no workers")
    assert_eq(old_ended, "")
    let found: List[Str] = problems.filter(fn(p) { p != "" })
    assert_eq(found.join("\n"), "")
    assert_eq(seen.join(", "), "builds=2 entries=2, builds=2 entries=2")
}
