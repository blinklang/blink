// `blink daemon stop` with no argument stops the daemon of the project the cwd is in, wherever
// in the project the daemon was started, and the daemon takes its socket with it.

import std.process.{ProcessResult}
import compile_test_helpers

let DIR = "{compile_test_helpers.scratch_root()}/daemon_stop_no_arg"

fn sh(cmd: Str) -> ProcessResult {
    process.run("sh", ["-c", cmd]).unwrap()
}

fn make_project(dir: Str) {
    let _ = sh("rm -rf {dir}; mkdir -p {dir}/src")
    write_file("{dir}/blink.toml", "[package]\nname = \"daemon_stop\"\nversion = \"0.1.0\"\n")
    write_file("{dir}/src/main.bl", "fn main() \{\n    io.println(\"hi\")\n}\n")
}

// Starts `blink daemon start <entry>` from `from` and gives the pid of its timeout runner, which
// passes a kill on to the daemon. The timeout ends a daemon that nothing stopped.
fn start_daemon(from: Str, entry: Str, log: Str) -> Int {
    let r = sh("B=$(pwd)/build/blink; L={log}; cd {from} && (timeout 120 $B daemon start {entry} > $L 2>&1 & echo $!)")
    r.out.trim().to_int()
}

// True once the socket at `sock` exists, within 20 seconds.
fn wait_for_socket(sock: Str) -> Bool {
    sh("for i in $(seq 1 400); do [ -S {sock} ] && exit 0; sleep 0.05; done; exit 1").exit_code == 0
}

fn stop_daemon(pid: Int) {
    if pid <= 0 { return }
    let _ = sh("kill {pid}; for i in $(seq 1 100); do kill -0 {pid} 2>/dev/null || exit 0; sleep 0.05; done; kill -9 {pid}")
}

test "stop with no argument at the project root stops a daemon started in a subdirectory" {
    let dir = "{DIR}/from_sub"
    make_project(dir)
    let pid = start_daemon("{dir}/src", "main.bl", "{dir}/daemon.log")
    let up = wait_for_socket("{dir}/.blink/daemon.sock")
    let stop = sh("B=$(pwd)/build/blink; cd {dir} && $B daemon stop")
    let gone = sh("for i in $(seq 1 200); do kill -0 {pid} 2>/dev/null || exit 0; sleep 0.05; done; exit 1").exit_code == 0
    stop_daemon(pid)
    let sock_left = sh("[ -e {dir}/.blink/daemon.sock ]").exit_code == 0
    if !up || !gone { io.eprintln(read_file("{dir}/daemon.log")) }

    assert(pid > 0)
    assert(up)
    assert_eq(stop.exit_code, 0)
    assert(stop.out.contains("Daemon stopped"))
    assert(gone)
    assert(!sock_left)
}

test "stop with no argument in a subdirectory stops a daemon started at the project root" {
    let dir = "{DIR}/from_root"
    make_project(dir)
    let pid = start_daemon(dir, "src/main.bl", "{dir}/daemon.log")
    let up = wait_for_socket("{dir}/.blink/daemon.sock")
    let stop = sh("B=$(pwd)/build/blink; cd {dir}/src && $B daemon stop")
    let gone = sh("for i in $(seq 1 200); do kill -0 {pid} 2>/dev/null || exit 0; sleep 0.05; done; exit 1").exit_code == 0
    stop_daemon(pid)
    let sock_left = sh("[ -e {dir}/.blink/daemon.sock ]").exit_code == 0
    if !up || !gone { io.eprintln(read_file("{dir}/daemon.log")) }

    assert(pid > 0)
    assert(up)
    assert_eq(stop.exit_code, 0)
    assert(stop.out.contains("Daemon stopped"))
    assert(gone)
    assert(!sock_left)
}
