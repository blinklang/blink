// Bug 7g2zd9: a fn returning a NON-transparent data enum (e.g.
// `type Box { Full(Int) Empty }`) was value-typed as CT_INT even though its C
// signature was correctly `blink_Box`. This broke every path that materializes
// a temp from the return: emit_if_expr declared `int64_t _if_0;` then assigned a
// `blink_Box` struct literal (cc "incompatible types"), and a data-enum call used
// directly as a match scrutinee mis-typed the `_scrut_` temp. The fix registers
// data-enum returns as CT_STRUCT + reg_fn_struct_ret so value-typing agrees with
// the signature, while keeping the transparent newtype `Errno` on bare int64_t.

pub type Box { Full(Int) Empty }

// if-expr body returning a data enum (the direct emit_if_expr symptom).
fn mk_if(n: Int) -> Box {
    if n == 0 { Empty } else { Full(n) }
}

fn mk(n: Int) -> Box {
    Full(n)
}

fn describe(b: Box) -> Str {
    match b {
        Full(x) => return "full {x}"
        Empty => return "empty"
    }
}

test "if-expr body returning a data enum materializes a struct temp" {
    let a = mk_if(0)
    assert_eq(describe(a), "empty")
    let b = mk_if(7)
    assert_eq(describe(b), "full 7")
}

test "data-enum-returning call used directly as a match scrutinee" {
    match mk(3) {
        Full(x) => assert_eq(x, 3)
        Empty => assert_eq(1, 0)
    }
    match mk_if(0) {
        Full(_) => assert_eq(1, 0)
        Empty => assert_eq(1, 1)
    }
}
