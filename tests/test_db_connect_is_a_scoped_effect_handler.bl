import std.db { DB }
import std.db_error { DBError, db_error_display }

fn count_rows(path: Str) -> Result[Int, DBError] {
    with db.connect(path)? {
        db.exec("CREATE TABLE t (v INT)")?
        db.exec("INSERT INTO t VALUES (1)")?
        db.exec("INSERT INTO t VALUES (2)")?
        let rows = db.query("SELECT v FROM t")?
        Ok(rows.len())
    }
}

test "db.connect installs DB for the body of a with" {
    assert_eq(count_rows(":memory:").unwrap(), 2)
}

test "db.connect reports a path it cannot open as ConnectionError" {
    match count_rows("/nonexistent-blink-dir/sub/x.db") {
        Err(DBError.ConnectionError(_)) => {}
        Err(e) => assert_eq(db_error_display(e), "connection_error")
        Ok(n) => assert_eq(n, -1)
    }
}
