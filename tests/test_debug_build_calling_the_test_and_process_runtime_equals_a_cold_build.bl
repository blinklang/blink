// A debug build whose units call the runtime of the test and process headers, and that takes
// one unit from the object cache after an edit, links the same binary as a build with an
// empty cache, and the binary runs the same.

import std.process.{ProcessResult}
import compile_test_helpers

fn sh(cmd: Str) -> Str ! Process.Spawn {
    process.run("sh", ["-c", cmd]).unwrap().out.trim()
}

fn dev_tree(root: Str, tree: Str) ! Process.Spawn, FS.Write {
    process.run("sh", ["-c", "rm -rf {tree}"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {tree}/build {tree}/app/src"]).unwrap()
    // A copy, not a link: the install root comes from realpath(argv[0]).
    process.run("sh", ["-c", "cp {sh("readlink -f build/blink")} {tree}/build/blink"]).unwrap()
    process.run("sh", ["-c", "ln -s {root}/lib {tree}/lib"]).unwrap()
    process.run("sh", ["-c", "ln -s {root}/lib {tree}/build/lib"]).unwrap()
    for f in ["runtime.h", "libblink_std.a", "libblink_std.h", "skip_modules.txt", ".archive-id"] {
        process.run("sh", ["-c", "[ -e {root}/build/{f} ] && cp -L {root}/build/{f} {tree}/build/{f}"]).unwrap()
    }
    // A dev build/ can hold runtime.h only beside the archive it links to.
    process.run("sh", ["-c", "[ -e {tree}/build/runtime.h ] || cp -L $(dirname $(readlink -f {root}/build/libblink_std.h))/runtime.h {tree}/build/runtime.h"]).unwrap()
    fs.write("{tree}/app/blink.toml", "[package]\nname = \"debug_cold_app\"\nversion = \"0.1.0\"\n").unwrap()
    fs.write("{tree}/app/src/part.bl", [
        #"pub fn run_child() -> Str {"#,
        #"    let r = process.run("sh", ["-c", "printf out; printf err >&2; exit 3"]).unwrap()"#,
        #"    "{r.out} {r.err_out} {r.end}""#,
        #"}"#,
        #""#,
    ].join("\n")).unwrap()
    edit_main(tree, 1)
}

fn edit_main(tree: Str, n: Int) ! FS.Write {
    fs.write("{tree}/app/src/main.bl", [
        #"import part.{run_child}"#,
        #""#,
        #"fn main() {"#,
        "    let n = {n}",
        #"    assert(n > 0, "n is {n}")"#,
        #"    io.println("child {run_child()} n {n}")"#,
        #"    assert_eq(n, 1)"#,
        #"}"#,
        #""#,
    ].join("\n")).unwrap()
}

// The corpus exports BLINK_COMPILER_ARCHIVE and may export BLINK_PER_MODULE; the first makes
// --per-module build one unit, so the run drops both, and the module filters.
fn blink_in(tree: Str, args: Str) -> ProcessResult ! Process.Spawn {
    process.run("sh", ["-c", "cd {tree} && env -u BLINK_ROOT -u BLINK_COMPILER_ARCHIVE -u BLINK_PER_MODULE -u BLINK_SKIP_MODULES -u BLINK_ONLY_MODULE BLINK_CACHE_DIR={tree}/objcache BLINK_TRACE_CHANNELS=blink.build.units build/blink {args}"]).unwrap()
}

fn build_debug(tree: Str) -> ProcessResult ! Process.Spawn {
    let r = blink_in(tree, "build app/src/main.bl -o {tree}/out/app --per-module --debug")
    assert(r.success(), "debug build failed: {r.out}{r.err_out}")
    r
}

// The binary's sha, and what it prints with its exit code.
fn result(tree: Str) -> (Str, Str) ! Process.Spawn {
    let r = process.run("{tree}/out/app", []).unwrap()
    (sh("sha256sum < {tree}/out/app"), "{r.out.trim()} | {r.err_out.trim()} | {r.end}")
}

test "a debug build that takes a cached unit equals a cold build" {
    let root = sh("pwd -P")
    let tree = "{compile_test_helpers.scratch_root()}/_debug_runtime_cold_equal_{getpid()}"
    dev_tree(root, tree)
    let _first = build_debug(tree)
    edit_main(tree, 2)
    let warm = build_debug(tree)
    let (warm_sha, warm_run) = result(tree)
    process.run("sh", ["-c", "rm -rf {tree}/objcache {tree}/out"])?
    let _cold = build_debug(tree)
    let (cold_sha, cold_run) = result(tree)
    process.run("sh", ["-c", "rm -rf {tree}"])?
    // part's unit comes from the cache: the edit touched only main.bl.
    assert("{warm.out}{warm.err_out}".contains("[trace:blink.build.units] reuse unit part"), "no unit taken: {warm.out}{warm.err_out}")
    assert_eq(warm_sha, cold_sha)
    assert_eq(warm_run, cold_run)
    assert_eq(cold_run, "child out err exit 3 n 2 | ASSERT_EQ FAILED: 2 != 1 (line 7) | exit 101")
}
