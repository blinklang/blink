// A struct field default and a keyword argument default are written in the module that
// declares them, and every name in one reads there (sections/02_syntax.md §2.13, §2.14,
// §2.21), whichever module leaves the field or the argument out. A diagnostic inside a
// default points at the default in its own file.

import compile_test_helpers

fn cleanup(base: Str) {
    let _ = process.run("rm", ["-rf", base]).unwrap()
}

fn fail(base: Str, msg: Str) {
    io.println("FAIL: {msg}")
    cleanup(base)
    assert(false)
}

fn blink_bin() -> Str {
    let blink_root = process.run("sh", ["-c", "pwd -P"]).unwrap().out.trim_right()
    "{blink_root}/build/blink"
}

fn new_package(base: Str) {
    cleanup(base)
    let _ = process.run("mkdir", ["-p", "{base}/src"]).unwrap()
    write_file("{base}/blink.toml", "[package]\nname = \"app\"\nversion = \"0.1.0\"\n")
}

// The combined output of `blink <cmd> src/main.bl`, with its exit status on the last line.
fn blink_in(base: Str, cmd: Str) -> Str {
    let r = process.run("sh", ["-c", "cd {base} && {blink_bin()} {cmd} src/main.bl 2>&1"]).unwrap()
    "{r.out}\nexit {r.exit_code}"
}

fn exited_clean(out: Str) -> Bool {
    out.ends_with("\nexit 0")
}

// Writes alpha and beta, and a main file that imports them in `order`.
fn write_package(base: Str, alpha: Str, beta: Str, order: List[Str]) {
    new_package(base)
    write_file("{base}/src/alpha.bl", alpha)
    write_file("{base}/src/beta.bl", beta)
    let mut imports = ""
    for m in order {
        let line = if m == "alpha" { "import alpha.\{make_a\}\n" } else { "import beta.\{make_b\}\n" }
        imports = imports.concat(line)
    }
    write_file("{base}/src/main.bl", "{imports}\nfn main() \{ io.println(\"\{make_a()\} \{make_b()\}\") \}\n")
}

// Checks the package and runs it as one C unit per module and as one unit for the whole
// program, in both import orders; each run's output must hold `want`.
fn expect_run(base: Str, alpha: Str, beta: Str, want: Str) {
    for order in [["alpha", "beta"], ["beta", "alpha"]] {
        write_package(base, alpha, beta, order)
        let names = order.join(", ")
        let chk = blink_in(base, "check")
        if !exited_clean(chk) {
            fail(base, "importing {names} should check clean, got: {chk}")
            return
        }
        for cmd in ["run", "run --no-per-module"] {
            let run = blink_in(base, cmd)
            if !exited_clean(run) || !run.contains(want) {
                fail(base, "importing {names}, `{cmd}` should print `{want}`, got: {run}")
                return
            }
        }
    }
    cleanup(base)
}

test "a keyword default naming a namesake type reads the declaring module's type" {
    let alpha = #"pub type Hue {
    Red
    Green
}

pub fn code(n: Int, -- h: Hue = Hue.Green) -> Int {
    match h {
        Red => n + 1
        Green => n + 2
    }
}

pub fn make_a() -> Int {
    code(0)
}
"#
    let beta = #"import alpha.{code}

pub type Hue {
    Blue
    Gray
}

pub fn make_b() -> Int {
    code(10)
}
"#
    expect_run("{compile_test_helpers.scratch_root()}/_test_defaults_kw_namesake_type", alpha, beta, "2 12")
}

test "a keyword default naming a namesake const reads the declaring module's const" {
    let alpha = #"const start = 1

pub fn take(-- n: Int = start) -> Int {
    n
}

pub fn make_a() -> Int {
    take()
}
"#
    let beta = #"import alpha.{take}

const start = "two"

pub fn make_b() -> Str {
    "{start}{take()}"
}
"#
    expect_run("{compile_test_helpers.scratch_root()}/_test_defaults_kw_namesake_const", alpha, beta, "1 two1")
}

// main has no `K` of its own, and the declaring module never uses its own defaults.
test "a field default and a keyword default naming a const work from a module without it" {
    let base = "{compile_test_helpers.scratch_root()}/_test_defaults_const_elsewhere"
    new_package(base)
    write_file("{base}/src/base.bl", #"pub const K: Int = 3

pub type Cfg {
    n: Int = K
}

pub fn wait(-- n: Int = K) -> Int {
    n
}
"#)
    write_file("{base}/src/main.bl", #"import base.{Cfg, wait}

fn main() {
    let c = Cfg {}
    io.println("{c.n} {wait()}")
}
"#)
    for cmd in ["run", "run --no-per-module"] {
        let run = blink_in(base, cmd)
        if !exited_clean(run) || !run.contains("3 3") {
            fail(base, "`{cmd}` should print `3 3`, got: {run}")
            return
        }
    }
    cleanup(base)
}

// A local of the caller is not in scope where the default was written.
test "a default reads the declaring module's const over a caller local of the same name" {
    let alpha = #"const start = 1

pub type Spot {
    n: Int = start
}

pub fn take(-- n: Int = start) -> Int {
    n
}

pub fn make_a() -> Int {
    take()
}
"#
    let beta = #"import alpha.{Spot, take}

pub fn make_b() -> Int {
    let start = 40
    let s = Spot {}
    start + s.n + take()
}
"#
    expect_run("{compile_test_helpers.scratch_root()}/_test_defaults_caller_local", alpha, beta, "1 42")
}

test "a keyword default naming a bare variant reads the declaring module's enum" {
    let alpha = #"pub type Hue {
    Red
    Green
}

pub fn code(-- h: Hue = Green) -> Int {
    match h {
        Red => 1
        Green => 2
    }
}

pub fn make_a() -> Int {
    code()
}
"#
    let beta = #"import alpha.{code}

pub type Shade {
    Green
    Blue
}

pub fn make_b() -> Int {
    let s = Shade.Blue
    let n = match s {
        Green => 10
        Blue => 20
    }
    n + code()
}
"#
    expect_run("{compile_test_helpers.scratch_root()}/_test_defaults_kw_bare_variant", alpha, beta, "2 22")
}

// The generic fn is instantiated from beta, but its default is alpha's.
test "a keyword default of a generic fn instantiated from another module reads its own module" {
    let alpha = #"const start = 1

pub fn pick[T](_x: T, -- n: Int = start) -> Int {
    n
}

pub fn make_a() -> Int {
    pick(true)
}
"#
    let beta = #"import alpha.{pick}

const start = "two"

pub fn make_b() -> Str {
    let n = pick("q")
    "{start}{n}"
}
"#
    expect_run("{compile_test_helpers.scratch_root()}/_test_defaults_generic", alpha, beta, "1 two1")
}

// One default node serves every instance, so each call must read it at its own type.
test "a keyword default typed by a type parameter takes each instance's type" {
    let alpha = #"pub fn first[T](xs: List[T], -- fallback: Option[T] = None) -> Option[T] {
    if xs.len() > 0 {
        return xs.get(0)
    }
    fallback
}

pub fn make_a() -> Int {
    let none: List[Int] = []
    (first([7]) ?? 0) + (first(none) ?? 1)
}
"#
    let beta = #"import alpha.{first}

pub fn make_b() -> Str {
    let none: List[Str] = []
    "{first(["q"]) ?? "-"}{first(none) ?? "-"}"
}
"#
    expect_run("{compile_test_helpers.scratch_root()}/_test_defaults_generic_typed", alpha, beta, "8 q-")
}

// beta builds alpha's generic struct at its own type argument.
test "a field default over a type parameter takes the literal's type argument from another module" {
    let alpha = #"pub type Box[T] {
    v: Option[T] = None
    n: Int = start
}

const start = 1

pub fn make_a() -> Int {
    let b: Box[Int] = Box {}
    if b.v.is_none() { b.n } else { 0 }
}
"#
    let beta = #"import alpha.{Box}

const start = "two"

pub fn make_b() -> Str {
    let b: Box[Str] = Box {}
    "{start}{b.v ?? "-"}{b.n}"
}
"#
    expect_run("{compile_test_helpers.scratch_root()}/_test_defaults_generic_field", alpha, beta, "1 two-1")
}

// The call is in beta, but the mistake is the default, so the report names alpha's line.
test "a keyword default of the wrong type is reported at the default in its own file" {
    let base = "{compile_test_helpers.scratch_root()}/_test_defaults_wrong_type_span"
    let alpha = #"pub fn take(-- n: Int = "x") -> Int {
    n
}

pub fn make_a() -> Int {
    1
}
"#
    let beta = #"import alpha.{take}

pub fn make_b() -> Int {
    take()
}
"#
    for order in [["alpha", "beta"], ["beta", "alpha"]] {
        write_package(base, alpha, beta, order)
        let chk = blink_in(base, "check")
        if exited_clean(chk) || !chk.contains("src/alpha.bl:1:25") || chk.contains("src/main.bl") || chk.contains("src/beta.bl") {
            fail(base, "importing {order.join(", ")} should report the default at src/alpha.bl:1:25 alone, got: {chk}")
            return
        }
    }
    cleanup(base)
}

// A call through a module qualifier fills the default as a bare call does, in the module
// that declares it.
test "a module-qualified call that leaves out a keyword default fills it in the declaring module" {
    let alpha = #"const k = 3

pub fn scaled(n: Int, -- by: Int = k) -> Int {
    n * by
}

pub fn make_a() -> Int {
    scaled(2)
}
"#
    let beta = #"import alpha

const k = "two"

pub fn make_b() -> Str {
    "{k}{alpha.scaled(2)}/{alpha.scaled(2, by: 5)}"
}
"#
    expect_run("{compile_test_helpers.scratch_root()}/_test_defaults_qualified", alpha, beta, "6 two6/10")
}

test "a module-qualified generic call that leaves out a keyword default fills it in the declaring module" {
    let alpha = #"const k = 3

pub fn tagged[T](x: T, -- n: Int = k) -> Int {
    let _ = x
    n
}

pub fn make_a() -> Int {
    tagged(true)
}
"#
    let beta = #"import alpha

const k = "two"

pub fn make_b() -> Str {
    "{k}{alpha.tagged("q")}/{alpha.tagged(1, n: 5)}"
}
"#
    expect_run("{compile_test_helpers.scratch_root()}/_test_defaults_qualified_generic", alpha, beta, "3 two3/5")
}

// beta declares its own `scaled` with another signature; the qualifier names alpha's.
test "a module-qualified call checks against the signature of the module the qualifier names" {
    let alpha = #"pub fn scaled(n: Int, -- by: Int = 3) -> Int {
    n * by
}

pub fn make_a() -> Int {
    scaled(1)
}
"#
    let beta = #"import alpha

fn scaled(s: Str) -> Str {
    "s{s}"
}

pub fn make_b() -> Str {
    "{scaled("x")}{alpha.scaled(2)}/{alpha.scaled(2, by: 4)}"
}
"#
    expect_run("{compile_test_helpers.scratch_root()}/_test_defaults_qualified_namesake_fn", alpha, beta, "3 sx6/8")
}

// Each call is a mistake a bare call to the same fn reports; the qualifier must not hide it.
test "a module-qualified call reports the argument mistakes a bare call reports" {
    let base = "{compile_test_helpers.scratch_root()}/_test_defaults_qualified_mistakes"
    let alpha = #"pub fn scaled(n: Int, -- by: Int = 3) -> Int {
    n * by
}

pub fn make_a() -> Int {
    1
}
"#
    let cases = [
        ["alpha.scaled()", "argument(s), got 0"],
        ["alpha.scaled(2, bx: 5)", "names no keyword parameter"],
        ["alpha.scaled(2, 5)", "take their arguments by label"],
        ["alpha.scaled(\"a\")", "expects Int, got Str"],
    ]
    for c in cases {
        let call = c.get(0).unwrap()
        let want = c.get(1).unwrap()
        let beta = "import alpha\n\npub fn make_b() -> Int \{\n    {call}\n\}\n"
        write_package(base, alpha, beta, ["alpha", "beta"])
        let chk = blink_in(base, "check")
        if exited_clean(chk) || !chk.contains(want) || chk.contains("internal compiler error") {
            fail(base, "`{call}` should report `{want}`, got: {chk}")
            return
        }
    }
    cleanup(base)
}

test "a module-qualified call of a deprecated fn warns as a bare call does" {
    let base = "{compile_test_helpers.scratch_root()}/_test_defaults_qualified_deprecated"
    let alpha = #"@deprecated(since: "1.0", replacement: "make_a")
pub fn old(n: Int) -> Int {
    n
}

pub fn make_a() -> Int {
    1
}
"#
    let beta = #"import alpha

pub fn make_b() -> Int {
    alpha.old(2)
}
"#
    write_package(base, alpha, beta, ["alpha", "beta"])
    let chk = blink_in(base, "check")
    if !exited_clean(chk) || !chk.contains("use of deprecated function `alpha.old`") {
        fail(base, "`alpha.old(2)` should check clean with a deprecation warning, got: {chk}")
        return
    }
    cleanup(base)
}

// A call through a bound, in either spelling, fills the default from the trait's declaration,
// so that default reads in the trait's module. The direct and the qualified call on the
// concrete type fill from the impl, which here sits beside the trait and writes the same
// default.
test "a trait method's keyword default reads the trait's module through a bound" {
    let alpha = #"const K = 3

pub type Pt {
    v: Int
}

pub trait Bump {
    fn bump(self, -- d: Int = K) -> Int
}

impl Bump for Pt {
    fn bump(self, -- d: Int = K) -> Int {
        self.v + d
    }
}

pub fn make_a() -> Int {
    0
}
"#
    let beta = #"import alpha.{Pt, Bump}

const K = 100

fn viab[T: Bump](x: T) -> Int {
    x.bump()
}

fn viaq[T: Bump](x: T) -> Int {
    Bump.bump(x)
}

pub fn make_b() -> Str {
    let p = Pt { v: 1 }
    "{viab(p)} {viaq(p)} {p.bump()} {Bump.bump(p)} {K}"
}
"#
    expect_run("{compile_test_helpers.scratch_root()}/_test_defaults_trait_bound", alpha, beta, "0 4 4 4 4 100")
}

// A method with a default body declares its defaults the same way a required one does.
test "a keyword default on a trait method with a default body reads the trait's module" {
    let alpha = #"const K = 3

pub type Pt {
    v: Int
}

pub trait Hi {
    fn hi(self, -- d: Int = K) -> Int {
        d
    }
}

impl Hi for Pt {
    fn hi(self, -- d: Int = K) -> Int {
        self.v + d
    }
}

pub fn make_a() -> Int {
    0
}
"#
    let beta = #"import alpha.{Pt, Hi}

const K = 100

fn viab[T: Hi](x: T) -> Int {
    x.hi()
}

pub fn make_b() -> Str {
    "{viab(Pt { v: 1 })} {K}"
}
"#
    expect_run("{compile_test_helpers.scratch_root()}/_test_defaults_trait_default_body", alpha, beta, "0 4 100")
}

// The impl and the bounded call sit in a module with its own `K`; the trait's default still
// names the trait module's.
test "a trait method's keyword default reads the trait's module when the impl is the caller's" {
    let alpha = #"const K = 3

pub trait Bump {
    fn bump(self, -- d: Int = K) -> Int
}

pub fn make_a() -> Int {
    0
}
"#
    let beta = #"import alpha.{Bump}

const K = 100

type Q {
    v: Int
}

impl Bump for Q {
    fn bump(self, -- d: Int = 3) -> Int {
        self.v + d
    }
}

fn viab[T: Bump](x: T) -> Int {
    x.bump()
}

pub fn make_b() -> Str {
    "{viab(Q { v: 1 })} {K}"
}
"#
    expect_run("{compile_test_helpers.scratch_root()}/_test_defaults_trait_impl_in_caller", alpha, beta, "0 4 100")
}

test "a trait method's keyword default declared in the main file fills a bounded call there" {
    let base = "{compile_test_helpers.scratch_root()}/_test_defaults_trait_in_main"
    new_package(base)
    write_file("{base}/src/main.bl", #"const K = 3

type Pt {
    v: Int
}

trait Bump {
    fn bump(self, -- d: Int = K) -> Int
}

impl Bump for Pt {
    fn bump(self, -- d: Int = K) -> Int {
        self.v + d
    }
}

fn viab[T: Bump](x: T) -> Int {
    x.bump()
}

fn main() {
    io.println("{viab(Pt { v: 1 })}")
}
"#)
    for cmd in ["run", "run --no-per-module"] {
        let run = blink_in(base, cmd)
        if !exited_clean(run) || !run.contains("4") {
            fail(base, "`{cmd}` should print `4`, got: {run}")
            return
        }
    }
    cleanup(base)
}

test "a trait method's keyword default of the wrong type is reported at the trait in its own file" {
    let base = "{compile_test_helpers.scratch_root()}/_test_defaults_trait_wrong_type_span"
    let alpha = #"pub trait Bump {
    fn bump(self, -- d: Int = "x") -> Int
}

pub fn make_a() -> Int {
    1
}
"#
    let beta = #"import alpha.{Bump}

type Q {
    v: Int
}

impl Bump for Q {
    fn bump(self, -- d: Int = 2) -> Int {
        self.v + d
    }
}

fn viab[T: Bump](x: T) -> Int {
    x.bump()
}

pub fn make_b() -> Int {
    viab(Q { v: 1 })
}
"#
    for order in [["alpha", "beta"], ["beta", "alpha"]] {
        write_package(base, alpha, beta, order)
        let chk = blink_in(base, "check")
        if exited_clean(chk) || !chk.contains("src/alpha.bl:2:31") || chk.contains("src/main.bl") || chk.contains("src/beta.bl") {
            fail(base, "importing {order.join(", ")} should report the default at src/alpha.bl:2:31 alone, got: {chk}")
            return
        }
    }
    cleanup(base)
}

// Through `U: Tr[Int]` the trait's `T` is `Int`, so a default typed by `T` or by `Self` fills
// at the bound's argument and the receiver's type parameter, in the trait's module.
test "a generic trait method's keyword default fills at the bound's arguments from another module" {
    let alpha = #"const K = 3

pub type Pt {
    v: Int
}

pub trait Tr[T] {
    fn pick(self, x: T, -- d: Option[T] = None, -- k: Int = K) -> Int
    fn same(self, -- other: Option[Self] = None) -> Bool
}

impl Tr[Int] for Pt {
    fn pick(self, x: Int, -- d: Option[Int] = None, -- k: Int = K) -> Int {
        x + k + (d ?? 0)
    }
    fn same(self, -- other: Option[Self] = None) -> Bool {
        other.is_none()
    }
}

pub fn make_a() -> Int {
    0
}
"#
    let beta = #"import alpha.{Pt, Tr}

const K = 100

fn viab[U: Tr[Int]](u: U) -> Int {
    u.pick(1)
}

fn viaq[U: Tr[Int]](u: U) -> Int {
    Tr.pick(u, 1)
}

fn vias[U: Tr[Int]](u: U) -> Bool {
    u.same()
}

pub fn make_b() -> Str {
    let p = Pt { v: 1 }
    "{viab(p)} {viaq(p)} {vias(p)} {K}"
}
"#
    expect_run("{compile_test_helpers.scratch_root()}/_test_defaults_generic_trait_bound", alpha, beta, "0 4 4 true 100")
}
