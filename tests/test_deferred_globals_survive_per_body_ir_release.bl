// The globals below cannot take their value on the definition line, so the compiler
// lowers their initializers before any function body and writes the function that
// assigns them after every body. Each body's lowered tree is released once the body is
// printed, so the initializers must outlive all of them; the closures, the generic
// instances and the test bodies between them must each print their own tree.
fn seed(n: Int) -> Int { n * 3 + 1 }

fn names() -> List[Str] { ["ada", "brian", "cora"] }

let base: Int = seed(4)
let table: List[Int] = [seed(1), seed(2), base]
let greeting: Str = "hi {names().get(1).unwrap()} {base}"
let lookup: Map[Str, Int] = make_lookup()

fn make_lookup() -> Map[Str, Int] {
    let mut m: Map[Str, Int] = Map()
    for name in names() { m.insert(name, name.len()) }
    m
}

fn first_of[T](xs: List[T]) -> T { xs.get(0).unwrap() }

fn apply_twice(f: fn(Int) -> Int, x: Int) -> Int { f(f(x)) }

fn scaled(k: Int) -> List[Int] {
    let by = fn(x: Int) -> Int { x * k + base }
    table.map(by)
}

fn total() -> Int {
    let mut sum = 0
    for x in table { sum += x }
    sum + apply_twice(fn(x: Int) -> Int { x + 1 }, base)
}

test "the deferred globals hold the values their initializers computed" {
    assert_eq(base, 13)
    assert_eq(table.len(), 3)
    assert_eq(table.get(2).unwrap(), 13)
    assert_eq(greeting, "hi brian 13")
    assert_eq(lookup.get("cora").unwrap(), 4)
}

test "bodies lowered between the initializers and their assignment read them" {
    assert_eq(scaled(2), [21, 27, 39])
    assert_eq(total(), 4 + 7 + 13 + 15)
    assert_eq(first_of(table), 4)
    assert_eq(first_of(names()), "ada")
}
