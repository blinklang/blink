// A derive on a generic type holds at an instance only when each field type, read at that
// instance, has what the derive writes for it. The field `b: B[(T, Int)]` is read as
// `B[(Int, Int)]` at `W[Int]`, not as `T = Int` alone. The declaration stays valid, as a
// field type that names a type parameter is judged at each instance (sections/03_types.md
// *Generic Type Bound Inference*), and a program that does not call the method builds.

import compile_test_helpers

fn pair_src(derives: Str, imp: Str, call: Str) -> Str {
    "{imp}@derive({derives})\ntype B[T] \{ v: T }\n@derive({derives})\ntype W[T] \{ b: B[(T, Int)], n: Int }\nfn main() \{\n    let w = W \{ b: B \{ v: (1, 2) }, n: 3 }\n    io.println({call})\n}\n"
}

// A tuple is Debug when each element is (sections/03_types.md *Debug vs Display*), so the
// call is never refused as a missing trait. Until the compiler writes the text of a tuple,
// it refuses the call as not built. When it does, change this row with its test.failing
// partner in tests/test_derive_debug_at_an_instance_renders_a_tuple_field_part.bl.
test "a derived debug at an instance whose field part is a tuple is refused as not built, not for its trait" {
    let out = compile_test_helpers.check_via_cli(pair_src("Debug", "", "w.debug()"), "inst_debug_call")
    assert(!out.contains("does not implement `Debug`"), out)
    assert(out.contains("`debug` on `W[Int]` is not built yet: the compiler cannot write the debug text of a tuple"), out)
}

test "a derived debug whose field part names a tuple at a type parameter checks clean" {
    let out = compile_test_helpers.check_via_cli(pair_src("Debug", "", "\"\{w.n}\""), "inst_debug_decl_ok")
    assert(out.contains("\"status\":\"ok\""), out)
}

test "a derived debug at an instance whose field part has no Debug is refused at check" {
    let src = "@derive(Debug)\ntype B[T] \{ v: T }\n@derive(Debug)\ntype W[T] \{ b: B[(T, fn() -> Int)], n: Int }\nfn show(w: W[Int]) -> Str \{ w.debug() }\nfn main() \{ io.println(\"ok\") }\n"
    let out = compile_test_helpers.check_via_cli(src, "inst_debug_fn_part")
    assert(out.contains("`W[Int]` does not implement `Debug`"), out)
}

test "a derived to_json at an instance whose field part has none is refused at check" {
    let out = compile_test_helpers.check_via_cli(pair_src("Serialize", "import std.json\n", "w.to_json()"), "inst_ser_call")
    assert(out.contains("`W[Int]` does not implement `Serialize`"), out)
}

test "an instance whose field part is a tuple builds when nothing calls debug" {
    let r = compile_test_helpers.compile_and_run(pair_src("Debug", "", "\"\{w.n}\""), "inst_debug_no_call")
    assert_eq(r.out.trim(), "3")
}

test "an instance whose field part has no Serialize builds when nothing calls to_json" {
    let r = compile_test_helpers.compile_and_run(pair_src("Serialize", "import std.json\n", "\"\{w.n}\""), "inst_ser_no_call")
    assert_eq(r.out.trim(), "3")
}

// A Float has no Hash (sections/03_types.md *Non-hashable keys and elements in general*).
test "a derived hash at an instance whose field part holds a Float is refused at check" {
    let src = "@derive(Eq, Hash)\ntype B[T] \{ v: T }\n@derive(Eq, Hash)\ntype W[T] \{ b: B[(T, Int)], n: Int }\nfn main() \{\n    let w = W \{ b: B \{ v: (1.5, 2) }, n: 3 }\n    io.println(\"\{w.hash()}\")\n}\n"
    let out = compile_test_helpers.check_via_cli(src, "inst_hash_float")
    assert(out.contains("`W[Float]` does not implement `Hash`"), out)
}

test "a derived debug at an instance whose field part has Debug runs" {
    let src = "@derive(Debug)\ntype B[T] \{ v: T }\n@derive(Debug)\ntype W[T] \{ b: B[List[T]], n: Int }\nfn main() \{\n    let w = W \{ b: B \{ v: [1] }, n: 3 }\n    io.println(w.debug())\n}\n"
    let r = compile_test_helpers.compile_and_run(src, "inst_debug_list")
    assert(r.out.contains("[1]"), "{r.out}{r.err_out}")
    assert(r.out.contains("3"), "{r.out}{r.err_out}")
}

test "a type that holds itself at the same instance still derives Debug" {
    let src = "@derive(Debug)\ntype L[T] \{ v: T, next: Option[L[T]] }\nfn main() \{\n    let l = L \{ v: 1, next: Some(L \{ v: 2, next: None }) }\n    io.println(l.debug())\n}\n"
    let r = compile_test_helpers.compile_and_run(src, "inst_debug_self")
    assert(r.out.contains("1"), "{r.out}{r.err_out}")
    assert(r.out.contains("2"), "{r.out}{r.err_out}")
}

test "two types that hold each other still derive Debug" {
    let src = "@derive(Debug)\ntype P[T] \{ v: T, q: Option[Q[T]] }\n@derive(Debug)\ntype Q[T] \{ w: T, p: Option[P[T]] }\nfn main() \{\n    let p = P \{ v: 1, q: Some(Q \{ w: 2, p: None }) }\n    io.println(p.debug())\n}\n"
    let r = compile_test_helpers.compile_and_run(src, "inst_debug_mutual")
    assert(r.out.contains("1"), "{r.out}{r.err_out}")
    assert(r.out.contains("2"), "{r.out}{r.err_out}")
}

fn enum_src(body: Str) -> Str {
    "@derive(Debug)\ntype E[T] \{ A(T), B(Int) }\n@derive(Debug)\ntype W[T] \{ e: E[Set[T]], n: Int }\nfn main() \{\n    let w: W[Int] = W \{ e: E.B(1), n: 4 }\n    {body}\n}\n"
}

// A Set is Debug when its element is (sections/03_types.md *Debug vs Display*). Until the
// compiler writes the text of a Set, it refuses the call as not built. When it does, change
// this row with its test.failing partner in
// tests/test_derive_debug_at_an_instance_renders_a_set_variant_part.bl.
test "a derived debug at an instance whose variant part is a Set is refused as not built, not for its trait" {
    let out = compile_test_helpers.check_via_cli(enum_src("io.println(w.debug())"), "inst_debug_enum_set")
    assert(!out.contains("does not implement `Debug`"), out)
    assert(out.contains("`debug` on `W[Int]` is not built yet: the compiler cannot write the debug text of a Set"), out)
}

// A field type that names no type parameter is judged where the type is declared, by the
// same two questions. When the compiler writes the text of a tuple, change this row with its
// test.failing partner in tests/test_derive_debug_at_an_instance_renders_a_tuple_field_part.bl.
test "a Debug field whose type has Debug but no built text is refused as not built at the declaration" {
    let src = "@derive(Debug)\ntype B[T] \{ v: T }\n@derive(Debug)\ntype S \{ b: B[(Int, Int)] }\nfn main() \{ io.println(\"x\") }\n"
    let out = compile_test_helpers.check_via_cli(src, "inst_debug_decl_tuple")
    assert(out.contains("field `b` has type `B[(Int, Int)]` whose debug text is not built yet: the compiler cannot write the debug text of a tuple"), out)
}

// The bound holds, since a tuple of Debug parts is Debug, and the call through it is not
// built. When the compiler writes the text of a tuple, change this row with its test.failing
// partner in tests/test_derive_debug_at_an_instance_renders_a_tuple_field_part.bl.
test "a Debug bound at an instance whose field part is a tuple is refused as not built" {
    let src = "@derive(Debug)\ntype B[T] \{ v: T }\n@derive(Debug)\ntype W[T] \{ b: B[(T, Int)] }\nfn show[T: Debug](x: T) -> Str \{ x.debug() }\nfn main() \{ io.println(show(W \{ b: B \{ v: (1, 2) } })) }\n"
    let out = compile_test_helpers.check_via_cli(src, "inst_debug_bound_tuple")
    assert(out.contains("the Debug bound on type parameter T is not built yet for `W[Int]`: the compiler cannot write the debug text of a tuple"), out)
}

test "an instance whose variant part is a Set builds when nothing calls debug" {
    let r = compile_test_helpers.compile_and_run(enum_src("io.println(\"\{w.n}\")"), "inst_debug_enum_no_call")
    assert_eq(r.out.trim(), "4")
}
