import compile_test_helpers

@derive(Debug)
type Point { x: Int, y: Int }

@derive(Debug)
type Person { name: Str, age: Int }

@derive(Debug)
type Color { Red, Green, Blue }

@derive(Debug)
type Shape {
    Circle(radius: Int)
    Rect(w: Int, h: Int)
}

@derive(Debug)
type Line { start: Point, end: Point }

@derive(Debug)
type WithList { nums: List[Int] }

@derive(Debug)
type WithStrList { names: List[Str] }

@derive(Debug)
type WithPointList { pts: List[Point] }

@derive(Debug)
type WithOption { maybe: Option[Int] }

@derive(Debug)
type WithStrIntMap { counts: Map[Str, Int] }

@derive(Debug)
type WithIntIntMap { table: Map[Int, Int] }

@derive(Debug)
type WithChar { c: Char }

@derive(Debug)
type WithCharList { cs: List[Char] }

@derive(Debug)
type WithCharOption { c: Option[Char] }

@derive(Debug)
type WithCharIntMap { m: Map[Char, Int] }

@derive(Debug)
type WithBoolIntMap { m: Map[Bool, Int] }

@derive(Debug)
type WithI8IntMap { m: Map[I8, Int] }

@derive(Debug)
type WithI16IntMap { m: Map[I16, Int] }

@derive(Debug)
type WithI32IntMap { m: Map[I32, Int] }

@derive(Debug)
type WithU8IntMap { m: Map[U8, Int] }

test "struct of primitives" {
    let p = Point { x: 5, y: 10 }
    assert_eq(p.debug(), "Point \{ x: 5, y: 10 }")
}

test "struct with quoted str field" {
    let pr = Person { name: "Alice", age: 30 }
    assert_eq(pr.debug(), "Person \{ name: \"Alice\", age: 30 }")
}

test "str field with escapes" {
    let pr = Person { name: "a\"b\nc", age: 1 }
    assert_eq(pr.debug(), "Person \{ name: \"a\\\"b\\nc\", age: 1 }")
}

test "unit enum variant" {
    let c = Color.Green
    assert_eq(c.debug(), "Green")
}

test "data enum variant positional" {
    let s = Shape.Rect(3, 4)
    assert_eq(s.debug(), "Rect(3, 4)")
}

test "single-field data enum variant" {
    let s = Shape.Circle(7)
    assert_eq(s.debug(), "Circle(7)")
}

test "nested struct field recurses" {
    let l = Line { start: Point { x: 1, y: 2 }, end: Point { x: 3, y: 4 } }
    assert_eq(l.debug(), "Line \{ start: Point \{ x: 1, y: 2 }, end: Point \{ x: 3, y: 4 } }")
}

test "list of ints renders elements" {
    let wl = WithList { nums: [1, 2, 3] }
    assert_eq(wl.debug(), "WithList \{ nums: [1, 2, 3] }")
}

test "empty list renders as brackets" {
    let wl = WithList { nums: [] }
    assert_eq(wl.debug(), "WithList \{ nums: [] }")
}

test "list of str renders quoted elements" {
    let wl = WithStrList { names: ["a", "b"] }
    assert_eq(wl.debug(), "WithStrList \{ names: [\"a\", \"b\"] }")
}

test "list of struct recurses element debug" {
    let wl = WithPointList { pts: [Point { x: 1, y: 2 }] }
    assert_eq(wl.debug(), "WithPointList \{ pts: [Point \{ x: 1, y: 2 }] }")
}

test "option some renders inner debug" {
    let wo = WithOption { maybe: Some(42) }
    assert_eq(wo.debug(), "WithOption \{ maybe: Some(42) }")
}

test "option none renders bare None" {
    let wo = WithOption { maybe: None }
    assert_eq(wo.debug(), "WithOption \{ maybe: None }")
}

test "str-keyed map renders quoted key and value" {
    let mut counts: Map[Str, Int] = Map()
    counts.insert("a", 1)
    let wm = WithStrIntMap { counts: counts }
    assert_eq(wm.debug(), "WithStrIntMap \{ counts: \{\"a\": 1} }")
}

test "empty map renders as braces" {
    let counts: Map[Str, Int] = Map()
    let wm = WithStrIntMap { counts: counts }
    assert_eq(wm.debug(), "WithStrIntMap \{ counts: \{} }")
}

test "int-keyed map renders bare key and value" {
    let mut table: Map[Int, Int] = Map()
    table.insert(7, 9)
    let wm = WithIntIntMap { table: table }
    assert_eq(wm.debug(), "WithIntIntMap \{ table: \{7: 9} }")
}

test "nested field type without Debug is a compile error" {
    let src = "type Inner \{ a: Int }\n@derive(Debug)\ntype Outer \{ i: Inner }\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "debug_nested_no_derive", "does not derive Debug")
}

test "list of non-Debug element is a compile error" {
    let src = "type Plain \{ a: Int }\n@derive(Debug)\ntype Outer \{ xs: List[Plain] }\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "debug_list_no_derive", "does not derive Debug")
}

test "nested container is a compile error naming the v1 ticket" {
    let src = "@derive(Debug)\ntype Outer \{ xs: List[List[Int]] }\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "debug_nested_container", "ye9ty9")
}

test "enum-variant container field is a compile error" {
    let src = "@derive(Debug)\ntype E \{ V(items: List[Int]) }\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "debug_variant_container", "E0520")
}

test "char field renders single-quoted, not codepoint" {
    let w = WithChar { c: 'a' }
    assert_eq(w.debug(), "WithChar \{ c: 'a' }")
}

test "char field escapes newline" {
    let w = WithChar { c: '\n' }
    assert_eq(w.debug(), "WithChar \{ c: '\\n' }")
}

test "char field escapes single quote" {
    let w = WithChar { c: '\'' }
    assert_eq(w.debug(), "WithChar \{ c: '\\'' }")
}

test "char field escapes backslash" {
    let w = WithChar { c: '\\' }
    assert_eq(w.debug(), "WithChar \{ c: '\\\\' }")
}

test "char field escapes tab" {
    let w = WithChar { c: '\t' }
    assert_eq(w.debug(), "WithChar \{ c: '\\t' }")
}

test "list of char renders single-quoted elements" {
    let w = WithCharList { cs: ['h', 'i'] }
    assert_eq(w.debug(), "WithCharList \{ cs: ['h', 'i'] }")
}

test "option char some renders single-quoted inner" {
    let w = WithCharOption { c: Some('z') }
    assert_eq(w.debug(), "WithCharOption \{ c: Some('z') }")
}

test "option char none renders bare None" {
    let w = WithCharOption { c: None }
    assert_eq(w.debug(), "WithCharOption \{ c: None }")
}

test "char-keyed map renders single-quoted key" {
    let mut m: Map[Char, Int] = Map()
    m.insert('a', 1)
    let w = WithCharIntMap { m: m }
    assert_eq(w.debug(), "WithCharIntMap \{ m: \{'a': 1} }")
}

test "bool-keyed map renders bare bool key" {
    let mut m: Map[Bool, Int] = Map()
    m.insert(false, 2)
    let w = WithBoolIntMap { m: m }
    assert_eq(w.debug(), "WithBoolIntMap \{ m: \{false: 2} }")
}

test "i8-keyed map renders signed key at correct width" {
    let mut m: Map[I8, Int] = Map()
    m.insert(-1, 9)
    let w = WithI8IntMap { m: m }
    assert_eq(w.debug(), "WithI8IntMap \{ m: \{-1: 9} }")
}

test "i16-keyed map renders signed key at correct width" {
    let mut m: Map[I16, Int] = Map()
    m.insert(-2, 9)
    let w = WithI16IntMap { m: m }
    assert_eq(w.debug(), "WithI16IntMap \{ m: \{-2: 9} }")
}

test "i32-keyed map renders signed key at correct width" {
    let mut m: Map[I32, Int] = Map()
    m.insert(-300, 9)
    let w = WithI32IntMap { m: m }
    assert_eq(w.debug(), "WithI32IntMap \{ m: \{-300: 9} }")
}

test "u8-keyed map renders unsigned key at correct width" {
    let mut m: Map[U8, Int] = Map()
    m.insert(200, 9)
    let w = WithU8IntMap { m: m }
    assert_eq(w.debug(), "WithU8IntMap \{ m: \{200: 9} }")
}
