import compile_test_helpers

@derive(Debug)
type Point { x: Int, y: Int }

@derive(Debug)
type Person { name: Str, age: Int }

@derive(Debug)
type Color { Red, Green, Blue }

@derive(Debug)
type Shape {
    Circle(radius: Int)
    Rect(w: Int, h: Int)
}

@derive(Debug)
type Line { start: Point, end: Point }

@derive(Debug)
type WithList { nums: List[Int] }

@derive(Debug)
type WithStrList { names: List[Str] }

@derive(Debug)
type WithPointList { pts: List[Point] }

@derive(Debug)
type WithOption { maybe: Option[Int] }

@derive(Debug)
type WithStrIntMap { counts: Map[Str, Int] }

@derive(Debug)
type WithIntIntMap { table: Map[Int, Int] }

@derive(Debug)
type WithChar { c: Char }

@derive(Debug)
type WithCharList { cs: List[Char] }

@derive(Debug)
type WithCharOption { c: Option[Char] }

@derive(Debug)
type WithCharIntMap { m: Map[Char, Int] }

@derive(Debug)
type WithBoolIntMap { m: Map[Bool, Int] }

@derive(Debug)
type WithI8IntMap { m: Map[I8, Int] }

@derive(Debug)
type WithI16IntMap { m: Map[I16, Int] }

@derive(Debug)
type WithI32IntMap { m: Map[I32, Int] }

@derive(Debug)
type WithU8IntMap { m: Map[U8, Int] }

@derive(Debug, Hash, Eq)
type Coord { x: Int, y: Int }

@derive(Debug)
type WithStructKeyMap { m: Map[Coord, Int] }

// Nested-container coverage (ye9ty9): fully-recursive Debug rendering.
@derive(Debug)
type WithGrid { grid: List[List[Int]] }

@derive(Debug)
type WithOptList { maybe: Option[List[Int]] }

@derive(Debug)
type WithStrListMap { m: Map[Str, List[Int]] }

@derive(Debug)
type WithOptIntList { xs: List[Option[Int]] }

@derive(Debug)
type WithNestedMap { m: Map[Str, Map[Str, Int]] }

@derive(Debug)
type WithMapList { xs: List[Map[Str, Int]] }

@derive(Debug)
type WithI8Grid { m: Map[I8, List[Int]] }

@derive(Debug)
type WithOptOpt { o: Option[Option[Int]] }

@derive(Debug)
type WithOptStruct { o: Option[Point] }

@derive(Debug)
type WithPointGridList { pts: List[Point] }

// Cross-source parity (ye9ty9 tp-tree vs x112x7 string parser): the SAME
// Map[Str, List[Int]] type must render byte-identically whether it arrives
// via a struct field or an enum-variant field.
@derive(Debug)
type StructMapField { m: Map[Str, List[Int]] }

// Enum-variant container fields (x112x7).
@derive(Debug)
type Ev { V(items: List[Int]) }

@derive(Debug)
type EvNestedMap { W(m: Map[Str, List[Int]]) }

@derive(Debug)
type EvPointList { P(pts: List[Point]) }

test "struct of primitives" {
    let p = Point { x: 5, y: 10 }
    assert_eq(p.debug(), "Point \{ x: 5, y: 10 }")
}

test "struct with quoted str field" {
    let pr = Person { name: "Alice", age: 30 }
    assert_eq(pr.debug(), "Person \{ name: \"Alice\", age: 30 }")
}

test "str field with escapes" {
    let pr = Person { name: "a\"b\nc", age: 1 }
    assert_eq(pr.debug(), "Person \{ name: \"a\\\"b\\nc\", age: 1 }")
}

test "unit enum variant" {
    let c = Color.Green
    assert_eq(c.debug(), "Green")
}

test "data enum variant positional" {
    let s = Shape.Rect(3, 4)
    assert_eq(s.debug(), "Rect(3, 4)")
}

test "single-field data enum variant" {
    let s = Shape.Circle(7)
    assert_eq(s.debug(), "Circle(7)")
}

test "nested struct field recurses" {
    let l = Line { start: Point { x: 1, y: 2 }, end: Point { x: 3, y: 4 } }
    assert_eq(l.debug(), "Line \{ start: Point \{ x: 1, y: 2 }, end: Point \{ x: 3, y: 4 } }")
}

test "list of ints renders elements" {
    let wl = WithList { nums: [1, 2, 3] }
    assert_eq(wl.debug(), "WithList \{ nums: [1, 2, 3] }")
}

test "empty list renders as brackets" {
    let wl = WithList { nums: [] }
    assert_eq(wl.debug(), "WithList \{ nums: [] }")
}

test "list of str renders quoted elements" {
    let wl = WithStrList { names: ["a", "b"] }
    assert_eq(wl.debug(), "WithStrList \{ names: [\"a\", \"b\"] }")
}

test "list of struct recurses element debug" {
    let wl = WithPointList { pts: [Point { x: 1, y: 2 }] }
    assert_eq(wl.debug(), "WithPointList \{ pts: [Point \{ x: 1, y: 2 }] }")
}

test "option some renders inner debug" {
    let wo = WithOption { maybe: Some(42) }
    assert_eq(wo.debug(), "WithOption \{ maybe: Some(42) }")
}

test "option none renders bare None" {
    let wo = WithOption { maybe: None }
    assert_eq(wo.debug(), "WithOption \{ maybe: None }")
}

test "str-keyed map renders quoted key and value" {
    let mut counts: Map[Str, Int] = Map()
    counts.insert("a", 1)
    let wm = WithStrIntMap { counts: counts }
    assert_eq(wm.debug(), "WithStrIntMap \{ counts: \{\"a\": 1} }")
}

test "empty map renders as braces" {
    let counts: Map[Str, Int] = Map()
    let wm = WithStrIntMap { counts: counts }
    assert_eq(wm.debug(), "WithStrIntMap \{ counts: \{} }")
}

test "int-keyed map renders bare key and value" {
    let mut table: Map[Int, Int] = Map()
    table.insert(7, 9)
    let wm = WithIntIntMap { table: table }
    assert_eq(wm.debug(), "WithIntIntMap \{ table: \{7: 9} }")
}

test "nested field type without Debug is a compile error" {
    let src = "type Inner \{ a: Int }\n@derive(Debug)\ntype Outer \{ i: Inner }\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "debug_nested_no_derive", "does not derive Debug")
}

test "list of non-Debug element is a compile error" {
    let src = "type Plain \{ a: Int }\n@derive(Debug)\ntype Outer \{ xs: List[Plain] }\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "debug_list_no_derive", "does not derive Debug")
}

test "nested list of lists renders recursively" {
    let wg = WithGrid { grid: [[1, 2], [3]] }
    assert_eq(wg.debug(), "WithGrid \{ grid: [[1, 2], [3]] }")
}

test "empty nested list renders nested brackets" {
    let wg = WithGrid { grid: [[]] }
    assert_eq(wg.debug(), "WithGrid \{ grid: [[]] }")
}

test "empty outer nested list renders bare brackets" {
    let wg = WithGrid { grid: [] }
    assert_eq(wg.debug(), "WithGrid \{ grid: [] }")
}

test "option of list some renders nested" {
    let wo = WithOptList { maybe: Some([1, 2]) }
    assert_eq(wo.debug(), "WithOptList \{ maybe: Some([1, 2]) }")
}

test "option of list none renders bare None" {
    let wo = WithOptList { maybe: None }
    assert_eq(wo.debug(), "WithOptList \{ maybe: None }")
}

test "map of str to list renders nested list value" {
    let mut m: Map[Str, List[Int]] = Map()
    m.insert("a", [1, 2])
    let w = WithStrListMap { m: m }
    assert_eq(w.debug(), "WithStrListMap \{ m: \{\"a\": [1, 2]} }")
}

test "list of option renders each element" {
    // NOTE: uses .push() rather than a [Some(1), None] literal because list
    // literals of Option elements emit an invalid struct-to-pointer cast today
    // (br 4yzsfc); .push() boxes correctly. Switch to a literal once 4yzsfc lands.
    let mut xs: List[Option[Int]] = []
    xs.push(Some(1))
    xs.push(None)
    let w = WithOptIntList { xs: xs }
    assert_eq(w.debug(), "WithOptIntList \{ xs: [Some(1), None] }")
}

test "map of str to map renders nested map value" {
    let mut inner: Map[Str, Int] = Map()
    inner.insert("x", 1)
    let mut m: Map[Str, Map[Str, Int]] = Map()
    m.insert("a", inner)
    let w = WithNestedMap { m: m }
    assert_eq(w.debug(), "WithNestedMap \{ m: \{\"a\": \{\"x\": 1}} }")
}

test "list of map renders each map element" {
    let mut inner: Map[Str, Int] = Map()
    inner.insert("x", 1)
    let w = WithMapList { xs: [inner] }
    assert_eq(w.debug(), "WithMapList \{ xs: [\{\"x\": 1}] }")
}

test "option of option some-some renders nested" {
    let inner: Option[Int] = Some(7)
    let w = WithOptOpt { o: Some(inner) }
    assert_eq(w.debug(), "WithOptOpt \{ o: Some(Some(7)) }")
}

test "option of option some-none renders inner None" {
    let inner: Option[Int] = None
    let w = WithOptOpt { o: Some(inner) }
    assert_eq(w.debug(), "WithOptOpt \{ o: Some(None) }")
}

test "option of option outer none" {
    let w = WithOptOpt { o: None }
    assert_eq(w.debug(), "WithOptOpt \{ o: None }")
}

test "option of struct renders boxed inner via struct debug" {
    let w = WithOptStruct { o: Some(Point { x: 1, y: 2 }) }
    assert_eq(w.debug(), "WithOptStruct \{ o: Some(Point \{ x: 1, y: 2 }) }")
}

test "option of struct none" {
    let w = WithOptStruct { o: None }
    assert_eq(w.debug(), "WithOptStruct \{ o: None }")
}

test "narrow-int key map with nested list value" {
    let mut m: Map[I8, List[Int]] = Map()
    m.insert(-1, [7, 8])
    let w = WithI8Grid { m: m }
    assert_eq(w.debug(), "WithI8Grid \{ m: \{-1: [7, 8]} }")
}

test "list of struct nested in list" {
    let w = WithPointGridList { pts: [Point { x: 1, y: 2 }, Point { x: 3, y: 4 }] }
    assert_eq(w.debug(), "WithPointGridList \{ pts: [Point \{ x: 1, y: 2 }, Point \{ x: 3, y: 4 }] }")
}

test "enum-variant list container field renders" {
    let e = Ev.V([1, 2])
    assert_eq(e.debug(), "V([1, 2])")
}

test "enum-variant nested map container field renders" {
    let mut m: Map[Str, List[Int]] = Map()
    m.insert("a", [1, 2])
    let e = EvNestedMap.W(m)
    assert_eq(e.debug(), "W(\{\"a\": [1, 2]})")
}

test "enum-variant list of struct renders" {
    let e = EvPointList.P([Point { x: 1, y: 2 }])
    assert_eq(e.debug(), "P([Point \{ x: 1, y: 2 }])")
}

test "struct and enum-variant fields of same type render byte-identically" {
    let mut m: Map[Str, List[Int]] = Map()
    m.insert("a", [1, 2])
    let s = StructMapField { m: m }
    let mut m2: Map[Str, List[Int]] = Map()
    m2.insert("a", [1, 2])
    let e = EvNestedMap.W(m2)
    // Struct field renders "StructMapField { m: {"a": [1, 2]} }" and
    // enum-variant renders "W({"a": [1, 2]})" — the shared inner Map fragment
    // ({"a": [1, 2]}) must be identical, proving both front doors mangle to the
    // same generated blink_debug_* fn.
    assert_eq(s.debug(), "StructMapField \{ m: \{\"a\": [1, 2]} }")
    assert_eq(e.debug(), "W(\{\"a\": [1, 2]})")
}

test "nested field type without Debug is still a compile error" {
    let src = "type Plain \{ a: Int }\n@derive(Debug)\ntype Outer \{ xs: List[List[Plain]] }\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "debug_deep_nested_no_derive", "does not derive Debug")
}

test "nested Set element is still a compile error" {
    let src = "@derive(Debug)\ntype Outer \{ xs: List[Set[Int]] }\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "debug_nested_set", "E0520")
}

test "container Map key is still a compile error" {
    let src = "@derive(Debug)\ntype Outer \{ m: Map[List[Int], Int] }\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "debug_container_map_key", "E0520")
}

test "char field renders single-quoted, not codepoint" {
    let w = WithChar { c: 'a' }
    assert_eq(w.debug(), "WithChar \{ c: 'a' }")
}

test "char field escapes newline" {
    let w = WithChar { c: '\n' }
    assert_eq(w.debug(), "WithChar \{ c: '\\n' }")
}

test "char field escapes single quote" {
    let w = WithChar { c: '\'' }
    assert_eq(w.debug(), "WithChar \{ c: '\\'' }")
}

test "char field escapes backslash" {
    let w = WithChar { c: '\\' }
    assert_eq(w.debug(), "WithChar \{ c: '\\\\' }")
}

test "char field escapes tab" {
    let w = WithChar { c: '\t' }
    assert_eq(w.debug(), "WithChar \{ c: '\\t' }")
}

test "list of char renders single-quoted elements" {
    let w = WithCharList { cs: ['h', 'i'] }
    assert_eq(w.debug(), "WithCharList \{ cs: ['h', 'i'] }")
}

test "option char some renders single-quoted inner" {
    let w = WithCharOption { c: Some('z') }
    assert_eq(w.debug(), "WithCharOption \{ c: Some('z') }")
}

test "option char none renders bare None" {
    let w = WithCharOption { c: None }
    assert_eq(w.debug(), "WithCharOption \{ c: None }")
}

test "char-keyed map renders single-quoted key" {
    let mut m: Map[Char, Int] = Map()
    m.insert('a', 1)
    let w = WithCharIntMap { m: m }
    assert_eq(w.debug(), "WithCharIntMap \{ m: \{'a': 1} }")
}

test "bool-keyed map renders bare bool key" {
    let mut m: Map[Bool, Int] = Map()
    m.insert(false, 2)
    let w = WithBoolIntMap { m: m }
    assert_eq(w.debug(), "WithBoolIntMap \{ m: \{false: 2} }")
}

test "i8-keyed map renders signed key at correct width" {
    let mut m: Map[I8, Int] = Map()
    m.insert(-1, 9)
    let w = WithI8IntMap { m: m }
    assert_eq(w.debug(), "WithI8IntMap \{ m: \{-1: 9} }")
}

test "i16-keyed map renders signed key at correct width" {
    let mut m: Map[I16, Int] = Map()
    m.insert(-2, 9)
    let w = WithI16IntMap { m: m }
    assert_eq(w.debug(), "WithI16IntMap \{ m: \{-2: 9} }")
}

test "i32-keyed map renders signed key at correct width" {
    let mut m: Map[I32, Int] = Map()
    m.insert(-300, 9)
    let w = WithI32IntMap { m: m }
    assert_eq(w.debug(), "WithI32IntMap \{ m: \{-300: 9} }")
}

test "u8-keyed map renders unsigned key at correct width" {
    let mut m: Map[U8, Int] = Map()
    m.insert(200, 9)
    let w = WithU8IntMap { m: m }
    assert_eq(w.debug(), "WithU8IntMap \{ m: \{200: 9} }")
}

test "struct-keyed map renders key via key struct debug" {
    let mut m: Map[Coord, Int] = Map()
    m.insert(Coord { x: 1, y: 2 }, 9)
    let w = WithStructKeyMap { m: m }
    assert_eq(w.debug(), "WithStructKeyMap \{ m: \{Coord \{ x: 1, y: 2 }: 9} }")
}

test "non-Debug struct map key is a compile error" {
    let src = "@derive(Hash, Eq)\ntype K \{ a: Int }\n@derive(Debug)\ntype Outer \{ m: Map[K, Int] }\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "debug_struct_key_no_derive", "does not derive Debug")
}
