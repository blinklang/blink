// A Set or a tuple is Debug when its parts are (sections/03_types.md *Debug vs Display* and
// *Tuples*), and its text is its parts' debug texts (*Container Debug Rendering*). So a
// derived debug renders a field whose type argument is a Set or a tuple at the instance.

import compile_test_helpers

test.failing(
    "a derived debug at an instance renders a Set type argument",
    reason: "the compiler cannot write the debug text of a Set yet, so check refuses the call as not built",
) {
    let src = "@derive(Debug)\ntype W[T] \{ x: T }\nfn main() \{\n    let mut s: Set[Int] = Set.new()\n    s.insert(7)\n    io.println(W \{ x: s }.debug())\n}\n"
    let r = compile_test_helpers.compile_and_run(src, "inst_debug_set_arg_render")
    assert(r.exit_code == 0, "{r.out}{r.err_out}")
    assert(r.out.contains("\{7}"), "{r.out}{r.err_out}")
}

test.failing(
    "a derived debug at an instance renders a tuple type argument",
    reason: "the compiler cannot write the debug text of a tuple yet, so check refuses the call as not built",
) {
    let src = "@derive(Debug)\ntype W[T] \{ x: T }\nfn main() \{ io.println(W \{ x: (1, 2) }.debug()) }\n"
    let r = compile_test_helpers.compile_and_run(src, "inst_debug_tuple_arg_render")
    assert(r.exit_code == 0, "{r.out}{r.err_out}")
    assert(r.out.contains("(1, 2)"), "{r.out}{r.err_out}")
}
