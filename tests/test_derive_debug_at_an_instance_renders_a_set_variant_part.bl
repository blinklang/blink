// A Set is Debug when its element is (sections/03_types.md *Debug vs Display*), and its text
// is its elements' debug texts in braces (*Container Debug Rendering*). So a derived debug
// renders a variant part that is a Set at the instance.

import compile_test_helpers

test.failing(
    "a derived debug at an instance renders a Set variant part",
    reason: "the compiler cannot write the debug text of a Set yet, so check refuses the call as not built",
) {
    let src = "@derive(Debug)\ntype E[T] \{ A(T), B(Int) }\n@derive(Debug)\ntype W[T] \{ e: E[Set[T]], n: Int }\nfn main() \{\n    let mut s: Set[Int] = Set.new()\n    s.insert(7)\n    let w: W[Int] = W \{ e: E.A(s), n: 4 }\n    io.println(w.debug())\n}\n"
    let r = compile_test_helpers.compile_and_run(src, "inst_debug_set_render")
    assert(r.exit_code == 0, "{r.out}{r.err_out}")
    assert(r.out.contains("\{7}"), "{r.out}{r.err_out}")
}
