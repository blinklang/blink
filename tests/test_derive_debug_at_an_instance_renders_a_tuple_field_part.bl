// A tuple is Debug when each element is (sections/03_types.md *Debug vs Display*), and its
// text is its elements' debug texts in parentheses (*Container Debug Rendering*). So a derived
// debug renders a field part that is a tuple at the instance, whether a type parameter or the
// declaration names it.

import compile_test_helpers

test.failing(
    "a derived debug at an instance renders a tuple field part",
    reason: "the compiler cannot write the debug text of a tuple yet, so check refuses the call as not built",
) {
    let src = "@derive(Debug)\ntype B[T] \{ v: T }\n@derive(Debug)\ntype W[T] \{ b: B[(T, Int)], n: Int }\nfn main() \{\n    let w = W \{ b: B \{ v: (1, 2) }, n: 3 }\n    io.println(w.debug())\n}\n"
    let r = compile_test_helpers.compile_and_run(src, "inst_debug_tuple_render")
    assert(r.exit_code == 0, "{r.out}{r.err_out}")
    assert(r.out.contains("(1, 2)"), "{r.out}{r.err_out}")
}

test.failing(
    "a derived debug renders a field whose declared type is an instance with a tuple part",
    reason: "the compiler cannot write the debug text of a tuple yet, so check refuses the field as not built",
) {
    let src = "@derive(Debug)\ntype B[T] \{ v: T }\n@derive(Debug)\ntype S \{ b: B[(Int, Int)] }\nfn main() \{\n    let s = S \{ b: B \{ v: (1, 2) } }\n    io.println(s.debug())\n}\n"
    let r = compile_test_helpers.compile_and_run(src, "inst_debug_tuple_decl_render")
    assert(r.exit_code == 0, "{r.out}{r.err_out}")
    assert(r.out.contains("(1, 2)"), "{r.out}{r.err_out}")
}
