// A generic data-enum with a value derive (Debug/Ord/Clone/Serialize) must join
// its mono instance into the real derive lists the same way a generic struct
// does. Method dispatch keys on the bare enum name and still emits a call to
// the mono-instance derive fn, but the enum join site never runs, so that fn
// is never defined.

import compile_test_helpers.{compile_and_run}

test.failing(
    "a generic enum's derived debug monomorphizes and round-trips",
    reason: "emit_mono_enum_typedef never calls the derive-list join that register_mono_field_types runs for structs, so blink_Opt_0Int_debug is called but never defined",
) {
    let src = #"
import std.io

@derive(Debug)
type Opt[T] {
    Some(val: T)
    Nothing
}

fn go() -> Str {
    let o = Opt.Some(5)
    o.debug()
}

fn main() ! IO {
    io.println(go())
}
"#
    let r = compile_and_run(src, "_derive_debug_generic_enum")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "Some(5)\n")
}
