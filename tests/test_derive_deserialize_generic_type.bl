// @derive(Deserialize) on a generic type must monomorphize both the
// generated from_json definition and every static call-site instance, the
// same as the other six derive kinds already do for a value they dispatch on.

import compile_test_helpers.{compile_and_run}

test.failing(
    "a generic type's derived from_json monomorphizes and round-trips",
    reason: "codegen has no stage yet for a derived Deserialize on a generic type, and the static call Box.from_json gets no concrete instance, so the build stops with ICE CodegenStageNotBuilt",
) {
    let src = #"
import std.io
import std.json

@derive(Serialize, Deserialize)
type Box[T] { v: T }

fn ds() -> Int {
    let seed = Box { v: 0 }
    let r = Box.from_json("\{\"v\":9}")
    match r {
        Ok(b) => b.v
        Err(_) => -1
    }
}

fn main() ! IO {
    io.println("{ds()}")
}
"#
    let r = compile_and_run(src, "_derive_deserialize_generic_type")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "9\n")
}
