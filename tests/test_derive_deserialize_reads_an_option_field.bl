// A derived from_json reads an Option field by the Option row of §3.6.2 *Type Mapping*:
// `null` is None and any other value is the inner type's read wrapped in Some. A key that is
// absent reads as `null` (*Missing and Extra Keys*), so it is None too.

@derive(Deserialize)
type Opt {
    n: Int?
    s: Str?
}

@derive(Deserialize)
type Inner {
    x: Int
}

@derive(Deserialize)
type Nest {
    i: Inner?
    xs: List[Int]?
    ys: List[Int?]
}

@derive(Deserialize)
type Box[T] {
    v: T
}

@derive(Deserialize)
type Shape {
    Dot(label: Str?)
    Empty
}

test "a present value is Some" {
    let o = Opt.from_json(#"{"n": 5, "s": "a"}"#).unwrap()
    assert_eq(o.n, Some(5))
    assert_eq(o.s, Some("a"))
}

test "a present null is None" {
    let o = Opt.from_json(#"{"n": null, "s": null}"#).unwrap()
    assert_eq(o.n, None)
    assert_eq(o.s, None)
}

test "an absent key is None" {
    let o = Opt.from_json("\{}").unwrap()
    assert_eq(o.n, None)
    assert_eq(o.s, None)
}

test "a value of the wrong JSON type is an error, not None" {
    assert(Opt.from_json(#"{"n": "five"}"#).is_err())
    assert(Opt.from_json(#"{"s": 5}"#).is_err())
}

test "an Option of a struct or a list reads the inner type" {
    let a = Nest.from_json(#"{"i": {"x": 7}, "xs": [1, 2], "ys": [3, null, 4]}"#).unwrap()
    assert_eq(a.i.unwrap().x, 7)
    assert_eq(a.xs.unwrap().len(), 2)
    assert_eq(a.ys.len(), 3)
    assert_eq(a.ys.get(0).unwrap(), Some(3))
    assert_eq(a.ys.get(1).unwrap(), None)
    assert_eq(a.ys.get(2).unwrap(), Some(4))
    let b = Nest.from_json(#"{"ys": []}"#).unwrap()
    assert(b.i.is_none())
    assert(b.xs.is_none())
}

test "an error inside the Some is passed up" {
    assert(Nest.from_json(#"{"i": {"x": "seven"}, "ys": []}"#).is_err())
}

// A field declared `T??` is refused at check, but a generic field may hold one (§3.6.2).
test "a generic held at an Option of an Option reads null as None and a value as Some of Some" {
    let n: Result[Box[Option[Int?]], Str] = Box.from_json(#"{"v": null}"#)
    assert_eq(n.unwrap().v, None)
    let a: Result[Box[Option[Int?]], Str] = Box.from_json("\{}")
    assert_eq(a.unwrap().v, None)
    let s: Result[Box[Option[Int?]], Str] = Box.from_json(#"{"v": 5}"#)
    assert_eq(s.unwrap().v, Some(Some(5)))
}

test "a generic held at an Option reads its field as an Option" {
    let r: Result[Box[Int?], Str] = Box.from_json(#"{"v": 3}"#)
    assert_eq(r.unwrap().v, Some(3))
    let e: Result[Box[Int?], Str] = Box.from_json("\{}")
    assert_eq(e.unwrap().v, None)
}

test "an Option field of an enum variant reads the same way" {
    match Shape.from_json(#"{"type": "Dot", "label": "p"}"#).unwrap() {
        Shape.Dot(label) => assert_eq(label, Some("p"))
        Shape.Empty => assert(false, "read Empty")
    }
    match Shape.from_json(#"{"type": "Dot"}"#).unwrap() {
        Shape.Dot(label) => assert_eq(label, None)
        Shape.Empty => assert(false, "read Empty")
    }
}
