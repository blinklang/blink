// A @derive(Eq) compares a container, carrier or tuple field by Container Equality
// (sections/03_types.md, *Derived Equality*): element by element, with Map and Set
// ignoring insertion order. A derive that compared those fields by address would answer
// false for two equal values built apart.

// Its equality reads only the tens, so two values that differ in the ones digit are
// equal. A derive that skipped this impl and compared the field's words would disagree.
type Celsius { deg: Int }

impl Eq for Celsius {
    fn eq(self, other: Celsius) -> Bool { self.deg / 10 == other.deg / 10 }
}

@derive(Eq)
type Record {
    names: List[Str]
    counts: Map[Str, Int]
    seen: Set[Int]
    label: Option[Str]
    outcome: Result[Int, Str]
    pair: (Int, Str)
    temp: Celsius
    reading: Option[Float]
}

fn zero() -> Float { 0.0 }

fn nan() -> Float { zero() / zero() }

fn counts(first: Str, second: Str) -> Map[Str, Int] {
    let mut m: Map[Str, Int] = Map()
    m.insert(first, first.len())
    m.insert(second, second.len())
    m
}

fn seen(a: Int, b: Int) -> Set[Int] {
    let mut s: Set[Int] = Set()
    s.insert(a)
    s.insert(b)
    s
}

fn record(name: Str, deg: Int, reading: Float) -> Record {
    Record {
        names: [name, "b"]
        counts: counts("one", "three")
        seen: seen(1, 2)
        label: Some(name)
        outcome: Ok(deg)
        pair: (deg, name)
        temp: Celsius { deg: deg }
        reading: Some(reading)
    }
}

test "two records built apart with equal fields are equal" {
    assert(record("a", 21, 1.5) == record("a", 21, 1.5))
    assert(!(record("a", 21, 1.5) != record("a", 21, 1.5)))
    assert(record("a", 21, 1.5).eq(record("a", 21, 1.5)))
}

test "a record whose List field differs in one element is not equal" {
    let a = record("a", 21, 1.5)
    let mut b = record("a", 21, 1.5)
    b.names = ["a", "c"]
    assert(a != b)
}

test "Map and Set fields compare by content, not insertion order" {
    let a = record("a", 21, 1.5)
    let mut b = record("a", 21, 1.5)
    b.counts = counts("three", "one")
    b.seen = seen(2, 1)
    assert(a == b)
    b.seen = seen(2, 3)
    assert(a != b)
}

test "Option, Result and tuple fields compare their contents" {
    let a = record("a", 21, 1.5)
    let mut b = record("a", 21, 1.5)
    b.label = None
    assert(a != b)
    b = record("a", 21, 1.5)
    b.outcome = Err("no")
    assert(a != b)
    b = record("a", 21, 1.5)
    b.pair = (21, "z")
    assert(a != b)
}

test "a field whose type implements Eq by hand compares through that impl" {
    let a = record("a", 21, 1.5)
    let mut b = record("a", 21, 1.5)
    b.temp = Celsius { deg: 24 }
    assert(a == b)
    b.temp = Celsius { deg: 31 }
    assert(a != b)
}

test "a Float inside an Option field equals itself even when it is NaN" {
    assert(record("a", 21, nan()) == record("a", 21, nan()))
}

@derive(Eq)
type Node { name: Str, kids: List[Node] }

fn leaf(name: Str) -> Node { Node { name: name, kids: [] } }

test "a self-recursive List field compares the whole tree" {
    let a = Node { name: "root", kids: [leaf("x"), Node { name: "y", kids: [leaf("z")] }] }
    let b = Node { name: "root", kids: [leaf("x"), Node { name: "y", kids: [leaf("z")] }] }
    let c = Node { name: "root", kids: [leaf("x"), Node { name: "y", kids: [leaf("w")] }] }
    assert(a == b)
    assert(a != c)
}

@derive(Eq)
type Event {
    Batch(items: List[Int])
    Idle
}

test "an enum payload that is a List compares by its elements" {
    assert(Event.Batch([1, 2]) == Event.Batch([1, 2]))
    assert(Event.Batch([1, 2]) != Event.Batch([2, 1]))
    assert(Event.Batch([]) != Event.Idle)
}

@derive(Eq)
type Box[T] { v: T }

@derive(Eq)
type Slot[T] {
    Held(v: T)
    Empty
}

@derive(Eq)
type Pair[A, B] { a: A, b: B }

test "a generic derive compares each instance by its own fields' values" {
    assert(Box { v: 3 } == Box { v: 3 })
    assert(Box { v: 3 } != Box { v: 4 })
    let xs: Box[List[Int]] = Box { v: [1, 2] }
    let ys: Box[List[Int]] = Box { v: [1, 2] }
    assert(xs == ys)
    let held: Slot[Str] = Slot.Held("k")
    let empty: Slot[Str] = Slot.Empty
    assert(held == Slot.Held("k"))
    assert(held != empty)
    let p: Pair[List[Int], Str] = Pair { a: [1], b: "s" }
    let q: Pair[List[Int], Str] = Pair { a: [1], b: "s" }
    let r: Pair[List[Int], Str] = Pair { a: [2], b: "s" }
    assert(p == q)
    assert(p != r)
}
