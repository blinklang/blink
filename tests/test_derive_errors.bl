import compile_test_helpers

test "a derive name that denotes no trait emits E1402" {
    let src = "@derive(Eqq)\ntype Point \{ x: Int, y: Int }\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "derive_unknown", "E1402")
}

test "@derive(Display) emits E1402 until the compiler synthesizes Display" {
    let src = "@derive(Display)\ntype Point \{ x: Int, y: Int }\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "derive_display", "E1402")
}
