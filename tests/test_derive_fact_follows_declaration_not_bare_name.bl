// A @derive fact belongs to a DECLARATION, not to the bare name it is spelled with.
// Two modules may each declare `DcColl` (spec sections/03_types.md:1038) and only one
// of them may carry the derive. A fact read out of a bare-name index answers with
// whichever declaration registered last, so the derived type was judged by its
// namesake: a qualified `dcmod.DcColl` was rejected as a Map key, and a value of it
// was rejected against a Debug bound, both while carrying the derive in plain sight.
//
// Both rows assert the ABSENCE of the false diagnostic, and the helper also fails the
// row if any other error appears, so a green row cannot come from a vacuous compile.

import compile_test_helpers

test "a qualified key type keeps its own derive when a namesake has none" {
    compile_test_helpers.expect_no_error_xmod(
        "import dcmod\n\ntype DcColl \{ b: Int }\n\nfn main() \{\n    let mut m: Map[dcmod.DcColl, Int] = Map()\n    io.println(\"\{m.len()}\")\n}\n",
        "dcmod",
        "@derive(Hash, Eq)\npub type DcColl \{ a: Int }\n",
        "_dcoll_key",
        "MapKeyNotHashable")
}

test "a value of the derived namesake is not rejected against a Debug bound" {
    compile_test_helpers.expect_no_error_xmod(
        "import dcmod\n\ntype DcRec \{ b: Int }\n\nfn need_debug[T: Debug](_x: T) -> Int \{ 1 }\n\nfn main() \{\n    io.println(\"\{need_debug(dcmod.mk())}\")\n}\n",
        "dcmod",
        "@derive(Debug)\npub type DcRec \{ a: Int }\n\npub fn mk() -> DcRec \{ DcRec \{ a: 1 } }\n",
        "_dcoll_bound",
        "TraitBoundNotSatisfied")
}
