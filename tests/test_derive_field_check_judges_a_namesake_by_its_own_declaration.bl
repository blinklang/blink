// Two modules may each declare a type of one name (sections/03_types.md:1038), and only one
// of the two may carry a derive. Each derive field check must judge a field by the
// declaration its type names, in the module that declares the field, for each derivable
// trait. A field whose type names the namesake without the derive is refused; a field
// whose type names the one with the derive is not, also through a renamed import.

import compile_test_helpers

fn helper_src(tr: Str, imp: Str) -> Str {
    "{imp}type MP \{ a: Int }\n@derive({tr})\npub type N \{ p: MP }\npub type K \{ a: Int }\n@derive({tr})\npub type G \{ a: Int }\n@derive({tr})\npub type MW \{ k: K }\n@derive({tr})\npub type MG \{ g: G }\n"
}

fn entry_src(tr: Str, imp: Str) -> Str {
    "{imp}import m\nimport m.\{G as Q, K as R}\ntype N \{ x: Int }\n@derive({tr})\ntype K \{ a: Int }\ntype G \{ b: Int }\n@derive({tr})\ntype UsesM \{ g: m.G }\n@derive({tr})\ntype UsesMK \{ k: m.K }\n@derive({tr})\ntype UsesN \{ n: N }\n@derive({tr})\ntype UsesQ \{ q: Q }\n@derive({tr})\ntype UsesR \{ r: R }\nfn main() \{ io.println(\"\{N \{ x: 1 }.x} \{K \{ a: 1 }.a} \{G \{ b: 1 }.b}\") }\n"
}

fn assert_each_namesake_judged(tr: Str, imp: Str, tag: Str) ! Process.Spawn, FS.Write, FS.Read, Env.Read {
    let out = compile_test_helpers.compile_xmod_capture(entry_src(tr, imp), "m", helper_src(tr, imp), tag)
    let refused = ["on `m.N`: field `p`", "on `MW`: field `k`", "on `UsesMK`: field `k`", "on `UsesN`: field `n`", "on `UsesR`: field `r`"]
    for r in refused {
        assert(out.contains("@derive({tr}) {r}"), "{tr}: no refusal {r}\n{out}")
    }
    let kept = ["on `UsesM`:", "on `UsesQ`:", "on `MG`:", "on `K`:", "on `G`:"]
    for k in kept {
        assert(!out.contains(k), "{tr}: a refusal {k}\n{out}")
    }
}

test "a Hash field is judged by the declaration its type names" {
    assert_each_namesake_judged("Hash", "", "nsfield_hash")
}

test "an Eq field is judged by the declaration its type names" {
    assert_each_namesake_judged("Eq", "", "nsfield_eq")
}

test "an Ord field is judged by the declaration its type names" {
    assert_each_namesake_judged("Ord", "", "nsfield_ord")
}

test "a Serialize field is judged by the declaration its type names" {
    assert_each_namesake_judged("Serialize", "import std.json\n", "nsfield_ser")
}

test "a Debug field is judged by the declaration its type names" {
    assert_each_namesake_judged("Debug", "", "nsfield_debug")
}
