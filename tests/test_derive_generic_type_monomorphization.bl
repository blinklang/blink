// @derive on a generic type is written once per instance, not once under the bare
// declared name. Two surfaces: the Serialize buffer, which each to_json call must start
// empty, and the Hash/Eq key table a Set over a generic key type binds.

import compile_test_helpers.{compile_and_run}

@derive(Serialize)
type Box[T] { v: T }

test "repeated to_json calls on a generic derive-Serialize instance return the same value" {
    let b: Box[Int] = Box { v: 5 }
    let s1 = b.to_json()
    let s2 = b.to_json()
    assert_eq(s1, #"{"v":5}"#)
    assert_eq(s2, #"{"v":5}"#)
}

test "derive Hash/Eq on a generic type works as a Set[T] element key" {
    let src = #"
@derive(Hash, Eq)
type Box[T] { v: T }

fn main() ! IO {
    let mut s: Set[Box[Int]] = Set()
    s.insert(Box { v: 1 })
    s.insert(Box { v: 1 })
    s.insert(Box { v: 2 })
    io.println("{s.len()}")
}
"#
    let r = compile_and_run(src, "_derive_generic_hash_eq_set_key")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "2\n")
}
