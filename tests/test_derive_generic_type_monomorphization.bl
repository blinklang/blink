// @derive on a generic type must be monomorphized per instance, not registered
// once under the bare declared name. Two distinct surfaces: a shared/unreset
// buffer for the generic Serialize path (calling .to_json() twice accumulates
// output instead of returning the same value each time), and the Hash/Eq
// kops-table-name seam consumed via Set[T] over a generic key type (degrades
// to the bare name and fails C compilation).

import compile_test_helpers.{compile_and_run}

@derive(Serialize)
type Box[T] { v: T }

test "repeated to_json calls on a generic derive-Serialize instance return the same value" {
    let b: Box[Int] = Box { v: 5 }
    let s1 = b.to_json()
    let s2 = b.to_json()
    assert_eq(s1, #"{"v":5}"#)
    assert_eq(s2, #"{"v":5}"#)
}

test.failing(
    "derive Hash/Eq on a generic type works as a Set[T] element key",
    reason: "the kops table-name seam only ever holds the bare declared name (Box), never the per-instantiation mono stem (Box_Int), so the emitted C references an undeclared kops symbol",
    ticket: "t5ervf",
) {
    let src = #"
@derive(Hash, Eq)
type Box[T] { v: T }

fn main() ! IO {
    let mut s: Set[Box[Int]] = Set()
    s.insert(Box { v: 1 })
    s.insert(Box { v: 1 })
    s.insert(Box { v: 2 })
    io.println("{s.len()}")
}
"#
    let r = compile_and_run(src, "_derive_generic_hash_eq_set_key")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "2\n")
}
