// A derived to_json writes an Option field and a Result field by §3.6.2 *Option and Result in
// JSON*: None writes null and Some(v) writes v, Ok(v) writes {"Ok":v} and Err(e) writes
// {"Err":e}. The same rule holds inside a List, inside another carrier, and in a variant
// field, and a derived from_json reads each text back to an equal value.

@derive(Serialize, Deserialize)
type Inner { n: Int }

@derive(Serialize, Deserialize)
type Sub { X, Y }

@derive(Serialize, Deserialize)
type Kind {
    A(i: Inner)
    B(k: Sub)
    C(r: Result[Int, Str])
}

@derive(Serialize, Deserialize)
type Rec {
    o: Int?
    os: Str?
    oc: Char?
    oi: Inner?
    r: Result[Int, Str]
    rl: Result[List[U8], Inner]
    lo: List[Int?]
    ro: Result[Int?, Str]
    k: Kind
}

@derive(Serialize)
type Never2[T] { r: Result[T, Never] }

fn full() -> Rec {
    Rec { o: Some(3), os: Some("a\"b"), oc: Some('z'), oi: Some(Inner { n: 1 }), r: Ok(7), rl: Ok([1, 2]),
        lo: [Some(1), None], ro: Ok(None), k: Kind.A(i: Inner { n: 2 }) }
}

fn empty() -> Rec {
    Rec { o: None, os: None, oc: None, oi: None, r: Err("busy"), rl: Err(Inner { n: 5 }),
        lo: [], ro: Err("x"), k: Kind.B(k: Sub.Y) }
}

test "Some writes the value and Ok writes an object with one Ok key" {
    assert_eq(full().to_json(), #"{"o":3,"os":"a\"b","oc":"z","oi":{"n":1},"r":{"Ok":7},"rl":{"Ok":[1,2]},"lo":[1,null],"ro":{"Ok":null},"k":{"type":"A","i":{"n":2}}}"#)
}

test "None writes null and Err writes an object with one Err key" {
    assert_eq(empty().to_json(), #"{"o":null,"os":null,"oc":null,"oi":null,"r":{"Err":"busy"},"rl":{"Err":{"n":5}},"lo":[],"ro":{"Err":"x"},"k":{"type":"B","k":"Y"}}"#)
}

test "a Result in a variant field is written by the same rule" {
    assert_eq(Kind.C(r: Err("no")).to_json(), #"{"type":"C","r":{"Err":"no"}}"#)
}

test "from_json reads the text of each Option and Result back" {
    for r in [full(), empty()] {
        let text = r.to_json()
        match Rec.from_json(text) {
            Ok(back) => assert_eq(back.to_json(), text)
            Err(e) => assert(false, "{text}: {e}")
        }
    }
}

test "a Result whose error type is Never writes its Ok value" {
    let v: Never2[Int] = Never2 { r: Ok(1) }
    assert_eq(v.to_json(), #"{"r":{"Ok":1}}"#)
}

// No node spells these carriers: each is only a List element, or comes from a type argument.
@derive(Serialize, Debug)
type Lone { n: Int }

@derive(Serialize, Debug)
type Lonely { xs: List[Lone?] }

@derive(Serialize)
type LoneResults { rs: List[Result[Lone, Bool]] }

@derive(Serialize, Debug)
type Gen[T] { l: List[T?] }

test "a carrier that is only a List element writes" {
    let v = Lonely { xs: [Some(Lone { n: 1 }), None] }
    assert_eq(v.to_json(), #"{"xs":[{"n":1},null]}"#)
    assert(v.debug().contains("None"), v.debug())
    let r = LoneResults { rs: [Ok(Lone { n: 2 }), Err(true)] }
    assert_eq(r.to_json(), #"{"rs":[{"Ok":{"n":2}},{"Err":true}]}"#)
    let g: Gen[Str] = Gen { l: [Some("a"), None] }
    assert_eq(g.to_json(), #"{"l":["a",null]}"#)
    assert(g.debug().contains("None"), g.debug())
}
