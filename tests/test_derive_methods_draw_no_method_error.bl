import compile_test_helpers

fn expect_compile_warning(src: Str, tag: Str, warning_code: Str) ! FS.Write, Process.Spawn, Env.Read {
    fs.write("{compile_test_helpers.scratch_root()}/_test_{tag}.bl", src).unwrap()
    let args = ["{compile_test_helpers.scratch_root()}/_test_{tag}.bl", "/dev/null", "--format", "json"]
    let result = process.run("build/blinkc", args).unwrap()
    let output = "{result.out}{result.err_out}"
    assert(output.contains(warning_code), "expected {warning_code} in output: {output}")
    process.run("sh", ["-c", "rm -f {compile_test_helpers.scratch_root()}/_test_{tag}.bl"]).unwrap()
}

fn expect_compile_error(src: Str, tag: Str, error_code: Str) ! FS.Write, Process.Spawn, Env.Read {
    fs.write("{compile_test_helpers.scratch_root()}/_test_{tag}.bl", src).unwrap()
    let args = ["{compile_test_helpers.scratch_root()}/_test_{tag}.bl", "/dev/null", "--format", "json"]
    let result = process.run("build/blinkc", args).unwrap()
    let output = "{result.out}{result.err_out}"
    assert(output.contains(error_code), "expected {error_code} in output: {output}")
    process.run("sh", ["-c", "rm -f {compile_test_helpers.scratch_root()}/_test_{tag}.bl"]).unwrap()
}

fn expect_no_warning(src: Str, tag: Str, warning_code: Str) ! FS.Write, Process.Spawn, Env.Read {
    fs.write("{compile_test_helpers.scratch_root()}/_test_{tag}.bl", src).unwrap()
    let args = ["{compile_test_helpers.scratch_root()}/_test_{tag}.bl", "/dev/null", "--format", "json"]
    let result = process.run("build/blinkc", args).unwrap()
    let output = "{result.out}{result.err_out}"
    assert(!output.contains(warning_code), "expected NO {warning_code} in output: {output}")
    process.run("sh", ["-c", "rm -f {compile_test_helpers.scratch_root()}/_test_{tag}.bl"]).unwrap()
}

test "@derive(Clone) clone() draws no E0505" {
    let src = "@derive(Clone)\ntype P \{ x: Int \}\nfn main() \{\n  let p = P \{ x: 1 \}\n  let _ = p.clone()\n\}\n"
    expect_no_warning(src, "der_clone", "E0505")
}

test "@derive(Eq) eq() draws no E0505" {
    let src = "@derive(Eq)\ntype P \{ x: Int \}\nfn main() \{\n  let a = P \{ x: 1 \}\n  let b = P \{ x: 1 \}\n  let _ = a.eq(b)\n\}\n"
    expect_no_warning(src, "der_eq", "E0505")
}

test "@derive(Hash, Eq) hash() draws no E0505" {
    let src = "@derive(Hash, Eq)\ntype P \{ x: Int \}\nfn main() \{\n  let p = P \{ x: 1 \}\n  let _ = p.hash()\n\}\n"
    expect_no_warning(src, "der_hash", "E0505")
}

test "@derive(Debug) debug() draws no E0505" {
    let src = "@derive(Debug)\ntype P \{ x: Int \}\nfn main() \{\n  let p = P \{ x: 1 \}\n  let _ = p.debug()\n\}\n"
    expect_no_warning(src, "der_debug", "E0505")
}

test "@derive(Serialize) to_json() draws no E0505" {
    let src = "@derive(Serialize)\ntype P \{ x: Int \}\nfn main() \{\n  let p = P \{ x: 1 \}\n  let _ = p.to_json()\n\}\n"
    expect_no_warning(src, "der_serialize", "E0505")
}

test "@derive(Eq, Clone) enum clone() and eq() draw no E0505" {
    let src = "@derive(Eq, Clone)\ntype Color \{ Red, Green, Blue \}\nfn main() \{\n  let c = Color.Red\n  let d = c.clone()\n  let _ = c.eq(d)\n\}\n"
    expect_no_warning(src, "der_enum", "E0505")
}

// The control for the rows above: the derive registration must not silence a name it does
// not supply. `P` is a declared type, so the receiver type is known and the report is the
// hard E0505, not the soft name-only warning.
test "unknown method on @derive type is an error" {
    let src = "@derive(Clone)\ntype P \{ x: Int \}\nfn main() \{\n  let p = P \{ x: 1 \}\n  let _ = p.no_such_method()\n\}\n"
    expect_compile_error(src, "der_control", "E0505")
}

test "Bytes.zeroed() draws no E0505" {
    let src = "fn main() \{\n  let b = Bytes.zeroed(8)\n  let _ = b.len()\n\}\n"
    expect_no_warning(src, "bytes_zeroed", "E0505")
}

// Same control on the builtin side. `Bytes` is a known receiver type, so this is E0505 too.
test "unknown method on Bytes is an error" {
    let src = "fn main() \{\n  let b = Bytes.zeroed(8)\n  let _ = b.bogus()\n\}\n"
    expect_compile_error(src, "bytes_bogus", "E0505")
}
