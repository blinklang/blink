// The derived hash/eq for a nested generic-struct instance must forward
// declare (or emit after) the inner instance's own derived hash/eq, since
// the outer's body calls the inner's functions by name.

import compile_test_helpers.{compile_and_run}

test.failing(
    "nested @derive(Hash, Eq) instance can call its inner instance's hash/eq",
    reason: "the outer instance's derived hash/eq references the inner instance's derived hash/eq before it is declared, so cc reports implicit declaration and then conflicting types",
    ticket: "edvw8r",
) {
    let src = #"
import std.io

@derive(Hash, Eq)
type HBox[T] { value: T }

type Wrap { hit: Bool }

fn mk[T](k: T) -> Map[HBox[HBox[T]], Int] {
    let mut m: Map[HBox[HBox[T]], Int] = Map()
    m.insert(HBox { value: HBox { value: k } }, 7)
    m
}

fn probe[T](m: Map[HBox[HBox[T]], Int], k: T) -> Wrap {
    Wrap { hit: m.contains(HBox { value: HBox { value: k } }) }
}

fn main() ! IO {
    let m = mk(5)
    io.println("{probe(m, 5).hit}")
}
"#
    let r = compile_and_run(src, "_derive_nested_generic_hash_forward_order")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "true\n")
}
