fn expect_compile_warning(src: Str, tag: Str, warning_code: Str) {
    write_file(".tmp/_test_{tag}.bl", src)
    let args = [".tmp/_test_{tag}.bl", "/dev/null", "--format", "json"]
    let result = process_run("build/blinkc", args)
    let output = "{result.out}{result.err_out}"
    assert(output.contains(warning_code), "expected {warning_code} in output: {output}")
    shell_exec("rm -f .tmp/_test_{tag}.bl")
}

fn expect_no_warning(src: Str, tag: Str, warning_code: Str) {
    write_file(".tmp/_test_{tag}.bl", src)
    let args = [".tmp/_test_{tag}.bl", "/dev/null", "--format", "json"]
    let result = process_run("build/blinkc", args)
    let output = "{result.out}{result.err_out}"
    assert(!output.contains(warning_code), "expected NO {warning_code} in output: {output}")
    shell_exec("rm -f .tmp/_test_{tag}.bl")
}

test "@derive(Clone) clone() does not warn W0501" {
    let src = "@derive(Clone)\ntype P \{ x: Int \}\nfn main() \{\n  let p = P \{ x: 1 \}\n  let _ = p.clone()\n\}\n"
    expect_no_warning(src, "der_clone", "W0501")
}

test "@derive(Eq) eq() does not warn W0501" {
    let src = "@derive(Eq)\ntype P \{ x: Int \}\nfn main() \{\n  let a = P \{ x: 1 \}\n  let b = P \{ x: 1 \}\n  let _ = a.eq(b)\n\}\n"
    expect_no_warning(src, "der_eq", "W0501")
}

test "@derive(Hash, Eq) hash() does not warn W0501" {
    let src = "@derive(Hash, Eq)\ntype P \{ x: Int \}\nfn main() \{\n  let p = P \{ x: 1 \}\n  let _ = p.hash()\n\}\n"
    expect_no_warning(src, "der_hash", "W0501")
}

test "@derive(Debug) debug() does not warn W0501" {
    let src = "@derive(Debug)\ntype P \{ x: Int \}\nfn main() \{\n  let p = P \{ x: 1 \}\n  let _ = p.debug()\n\}\n"
    expect_no_warning(src, "der_debug", "W0501")
}

test "@derive(Serialize) to_json() does not warn W0501" {
    let src = "@derive(Serialize)\ntype P \{ x: Int \}\nfn main() \{\n  let p = P \{ x: 1 \}\n  let _ = p.to_json()\n\}\n"
    expect_no_warning(src, "der_serialize", "W0501")
}

test "@derive(Eq, Clone) enum clone() and eq() do not warn W0501" {
    let src = "@derive(Eq, Clone)\ntype Color \{ Red, Green, Blue \}\nfn main() \{\n  let c = Color.Red\n  let d = c.clone()\n  let _ = c.eq(d)\n\}\n"
    expect_no_warning(src, "der_enum", "W0501")
}

test "unknown method on @derive type still warns W0501" {
    let src = "@derive(Clone)\ntype P \{ x: Int \}\nfn main() \{\n  let p = P \{ x: 1 \}\n  let _ = p.no_such_method()\n\}\n"
    expect_compile_warning(src, "der_control", "W0501")
}

test "Bytes.zeroed() does not warn W0501" {
    let src = "fn main() \{\n  let b = Bytes.zeroed(8)\n  let _ = b.len()\n\}\n"
    expect_no_warning(src, "bytes_zeroed", "W0501")
}

test "unknown method on Bytes still warns W0501" {
    let src = "fn main() \{\n  let b = Bytes.zeroed(8)\n  let _ = b.bogus()\n\}\n"
    expect_compile_warning(src, "bytes_bogus", "W0501")
}
