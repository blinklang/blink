// E1401 NonDerivableTrait (spec §3.6.6): a @derive(Hash/Eq/Ord) type may only
// contain fields whose type implements the derived trait. Collections have no
// hash or ordering; Float is not Hash; Bool is not Ord. An Eq field is checked by the
// rule `==` uses (sections/03_types.md, *Container Equality*), so a collection, an
// Option or a tuple field derives Eq when its parts are Eq, and the error names the
// innermost type that is not.

import compile_test_helpers

// --- NEGATIVE: each must emit E1401 -----------------------------------------

test "struct Map field under @derive(Hash) emits E1401" {
    let src = "@derive(Hash)\ntype S \{ m: Map[Str, Int] }\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "derive_hash_map", "E1401")
}

test "struct Float field under @derive(Hash) emits E1401" {
    let src = "@derive(Hash)\ntype S \{ f: Float }\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "derive_hash_float", "E1401")
}

test "enum Map-field variant under @derive(Hash) emits E1401" {
    let src = "@derive(Hash)\ntype E \{\n    A(m: Map[Str, Int])\n    B\n}\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "derive_hash_enum_map", "E1401")
}

test "struct Bool field under @derive(Ord) emits E1401" {
    let src = "@derive(Ord)\ntype S \{ b: Bool }\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "derive_ord_bool", "E1401")
}

test "struct List field of an Eq element under @derive(Eq) passes" {
    let src = "@derive(Eq)\ntype S \{ xs: List[Int] }\nfn main() \{}\n"
    let out = compile_test_helpers.compile_and_capture(src, "derive_eq_list")
    compile_test_helpers.expect_compiles_clean(out, "derive_eq_list")
}

test "struct tuple field under @derive(Hash) emits E1401" {
    // Tuples are structurally hashable, but codegen cannot synthesize a hash
    // for a tuple STRUCT field in v1 (BLINK_COMPILER_BUG sentinel) — reject
    // clearly rather than emit a degenerate constant hash.
    let src = "@derive(Hash, Eq)\ntype C \{ t: (Int, Str), n: Int }\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "derive_hash_tuple", "E1401")
}

// --- POSITIVE: must still pass ----------------------------------------------

test "struct Float field under @derive(Eq) passes" {
    let src = "@derive(Eq)\ntype S \{ f: Float }\nfn main() \{}\n"
    compile_test_helpers.expect_no_error(src, "derive_eq_float_ok", "E1401")
}

test "struct Float field under @derive(Ord) passes" {
    let src = "@derive(Ord)\ntype S \{ f: Float }\nfn main() \{}\n"
    compile_test_helpers.expect_no_error(src, "derive_ord_float_ok", "E1401")
}

// --- @derive(Eq) follows the rule `==` uses ----------------------------------

test "a List field whose element has no Eq emits E1401 naming the element" {
    let src = "type Widget \{ id: Int }\n@derive(Eq)\ntype S \{ ws: List[Widget] }\nfn main() \{}\n"
    let out = compile_test_helpers.compile_and_capture(src, "derive_eq_list_widget")
    compile_test_helpers.expect_error(out, "E1401", "derive_eq_list_widget")
    compile_test_helpers.expect_contains(out, "`Widget`", "derive_eq_list_widget names Widget")
    compile_test_helpers.expect_contains(out, "add `@derive(Eq)` to `type Widget`", "derive_eq_list_widget help")
}

test "an enum payload of nested containers under @derive(Eq) passes" {
    let src = "@derive(Eq)\ntype E \{\n    A(m: Option[Map[Str, List[Int]]])\n    B\n}\nfn main() \{}\n"
    let out = compile_test_helpers.compile_and_capture(src, "derive_eq_enum_nested")
    compile_test_helpers.expect_compiles_clean(out, "derive_eq_enum_nested")
}

test "a tuple field under @derive(Eq) alone passes" {
    let src = "@derive(Eq)\ntype C \{ t: (Int, Str), n: Int }\nfn main() \{}\n"
    let out = compile_test_helpers.compile_and_capture(src, "derive_eq_tuple")
    compile_test_helpers.expect_compiles_clean(out, "derive_eq_tuple")
}

test "a field over the type's own parameter under @derive(Eq) passes" {
    let src = "@derive(Eq)\ntype Box[T] \{ v: T, vs: List[T] }\nfn main() \{}\n"
    let out = compile_test_helpers.compile_and_capture(src, "derive_eq_tparam")
    compile_test_helpers.expect_compiles_clean(out, "derive_eq_tparam")
}

test "a function field under @derive(Eq) emits E1401" {
    let src = "@derive(Eq)\ntype H \{ run: fn() }\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "derive_eq_fn_field", "E1401")
}

test "an Option field whose payload has no Eq emits E1401 naming the payload" {
    let src = "type Widget \{ id: Int }\n@derive(Eq)\ntype S \{ w: Option[Widget] }\nfn main() \{}\n"
    let out = compile_test_helpers.compile_and_capture(src, "derive_eq_opt_widget")
    compile_test_helpers.expect_error(out, "E1401", "derive_eq_opt_widget")
    compile_test_helpers.expect_contains(out, "add `@derive(Eq)` to `type Widget`", "derive_eq_opt_widget help")
}
