import compile_test_helpers

// `None` is less than every `Some`, and two `Some` values order by their payloads
// (sections/03_types.md *Ord for `Option` and `Result`*). A tuple of `Ord` parts is `Ord`, so
// a derived cmp orders a tuple field that holds an Option. The row does not print: an
// expected red runs a second time for the --test-json report, which reads stdout.
test.failing(
    "an Ord field of a tuple that holds an Option orders None before Some",
    reason: "Option and Result are not Ord in this compiler yet, so check refuses the field",
) {
    let decls = "@derive(Eq, Ord)\ntype W \{ a: (Int, Option[Int]) }\n"
    let body = "fn main() \{\n    let lo = W \{ a: (1, None) }\n    io.println(\"\{lo < W \{ a: (1, Some(0)) }} \{W \{ a: (1, Some(2)) } < W \{ a: (1, Some(1)) }} \{lo < lo}\")\n}\n"
    let r = compile_test_helpers.compile_and_run("{decls}{body}", "dord_tuple_option")
    assert(r.exit_code == 0 && r.out == "true false false\n")
}
