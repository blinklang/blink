// A payload-less enum stored by-value as an intptr-packed ordinal inside a List
// element must be read back as that ordinal, not dereferenced as a pointer.
// emit_list_serialize's element-read for a @derive(Serialize) List[enum] field
// treats the payload-less enum as a heap-boxed value and dereferences the ordinal
// itself as an address, segfaulting instead of producing JSON.

import compile_test_helpers.{compile_and_run}

test "@derive(Serialize) on a struct with a List[payload-less enum] field serializes without crashing" {
    let src = #"
import std.io

@derive(Serialize)
type Color { Red, Green, Blue }
@derive(Serialize)
type Palette { shades: List[Color] }

fn main() ! IO {
    let p = Palette { shades: [Color.Red, Color.Blue] }
    let s = p.to_json()
    io.println("{s.len() > 0}")
}
"#
    let r = compile_and_run(src, "_derive_serialize_list_payloadless_enum_segfault")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "true\n")
}
