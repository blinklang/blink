import compile_test_helpers

// @derive(Serialize) refuses, with E1401 NonDerivableTrait, a field whose type has no JSON
// form (sections/03_types.md §3.6.2 *Built-in Types in JSON*, §3.6.6). Before this check, a
// Ptr, an @ffi.opaque handle or a user type with no Serialize impl reached codegen, which
// wrote the literal "null" for it, a silent stand-in for a value.
// A field type has a JSON form when it is Int, Float, Bool, Str, Char, I8 to U32, or a List,
// Option or Result of such types, or a struct or enum that derives Serialize. The same list
// holds for a struct field and an enum-variant field. U64 has no JSON form, and F32/F64
// (reserved, no type yet) are refused by name resolution.

fn ptr_field_src() -> Str {
    #"@derive(Serialize)
type Box { p: Ptr[U8] }
fn main() {
    io.println("hi")
}
"#
}

test "derive Serialize with a Ptr field is E1401" {
    compile_test_helpers.expect_compile_error(ptr_field_src(), "derive_serialize_rejects_unserializable_field_ptr", "E1401")
}

fn opaque_field_src() -> Str {
    #"@ffi.opaque(header: "stdio.h", name: "FILE")
type CFile
@derive(Serialize)
type Wrap { f: CFile }
fn main() {
    io.println("hi")
}
"#
}

test "derive Serialize with an @ffi.opaque field is E1401" {
    compile_test_helpers.expect_compile_error(opaque_field_src(), "derive_serialize_rejects_unserializable_field_opaque", "E1401")
}

fn nonserialize_struct_field_src() -> Str {
    #"type Plain { a: Int }
@derive(Serialize)
type Holder { inner: Plain }
fn main() {
    io.println("hi")
}
"#
}

test "derive Serialize with a non-Serialize user struct field is E1401" {
    compile_test_helpers.expect_compile_error(nonserialize_struct_field_src(), "derive_serialize_rejects_unserializable_field_userstruct", "E1401")
}

// An Option field writes `null` for None and the value for Some(v) (sections/03_types.md
// *Option and Result in JSON*).
fn option_field_src() -> Str {
    #"@derive(Serialize)
type Box { v: Option[Int] }
fn main() {
    io.println(Box { v: Some(1) }.to_json())
    io.println(Box { v: None }.to_json())
}
"#
}

// Each row asserts the exact text the derived to_json writes, so a field that falls through
// to a literal "null" fails it.
fn writes(src: Str, tag: Str, want: Str) ! FS.Delete, FS.Write, Process.Spawn, FS.Read, Env.Read, IO.Print {
    let r = compile_test_helpers.compile_and_run(src, tag)
    if r.exit_code != 0 || r.out != want {
        io.println("FAIL: {tag}: exit {r.exit_code}, out '{r.out}', err '{r.err_out}'")
    }
    assert(r.exit_code == 0 && r.out == want)
}

test "derive Serialize with an Option field writes null or the value" {
    writes(option_field_src(), "derive_serialize_rejects_unserializable_field_option", "\{\"v\":1}\n\{\"v\":null}\n")
}

fn map_field_src() -> Str {
    #"@derive(Serialize)
type Box { m: Map[Str, Int] }
fn main() {
    io.println("hi")
}
"#
}

test "derive Serialize with a Map field is E1401" {
    compile_test_helpers.expect_compile_error(map_field_src(), "derive_serialize_rejects_unserializable_field_map", "E1401")
}

// An enum-variant field is judged by the same list as a struct field.
fn enum_variant_ptr_src() -> Str {
    #"@derive(Serialize)
type E { V(p: Ptr[U8]) }
fn main() {
    io.println("hi")
}
"#
}

test "derive Serialize with a non-serializable enum-variant field is E1401" {
    compile_test_helpers.expect_compile_error(enum_variant_ptr_src(), "derive_serialize_rejects_unserializable_field_enumvariant", "E1401")
}

// A List whose element type is not serializable is rejected — the check recurses into the List.
fn list_of_ptr_src() -> Str {
    #"@derive(Serialize)
type Box { xs: List[Ptr[U8]] }
fn main() {
    io.println("hi")
}
"#
}

test "derive Serialize with a List of non-serializable element is E1401" {
    compile_test_helpers.expect_compile_error(list_of_ptr_src(), "derive_serialize_rejects_unserializable_field_listptr", "E1401")
}

// Guards: legitimate serializable types must still derive cleanly (no false E1401).
fn primitives_src() -> Str {
    #"@derive(Serialize)
type User { name: Str
age: Int
score: Float
active: Bool }
fn main() {
    io.println("hi")
}
"#
}

test "derive Serialize over scalar primitives still typechecks (no false E1401)" {
    compile_test_helpers.expect_no_error(primitives_src(), "derive_serialize_rejects_unserializable_field_primitives", "E1401")
}

fn nested_serialize_struct_src() -> Str {
    #"@derive(Serialize)
type Address { city: Str
zip: Str }
@derive(Serialize)
type Person { name: Str
address: Address }
fn main() {
    io.println("hi")
}
"#
}

test "derive Serialize with a nested Serialize struct field still typechecks (no false E1401)" {
    compile_test_helpers.expect_no_error(nested_serialize_struct_src(), "derive_serialize_rejects_unserializable_field_nested", "E1401")
}

fn list_of_str_src() -> Str {
    #"@derive(Serialize)
type Post { tags: List[Str] }
fn main() {
    io.println("hi")
}
"#
}

test "derive Serialize with a List[Str] field still typechecks (no false E1401)" {
    compile_test_helpers.expect_no_error(list_of_str_src(), "derive_serialize_rejects_unserializable_field_liststr", "E1401")
}

fn list_of_serialize_struct_src() -> Str {
    #"@derive(Serialize)
type Item { sku: Str }
@derive(Serialize)
type Cart { items: List[Item] }
fn main() {
    io.println("hi")
}
"#
}

test "derive Serialize with a List of Serialize struct still typechecks (no false E1401)" {
    compile_test_helpers.expect_no_error(list_of_serialize_struct_src(), "derive_serialize_rejects_unserializable_field_listitem", "E1401")
}

fn enum_primitive_src() -> Str {
    #"@derive(Serialize)
type Shape { Circle(radius: Float)
Point }
fn main() {
    io.println("hi")
}
"#
}

test "derive Serialize enum with primitive variant fields still typechecks (no false E1401)" {
    compile_test_helpers.expect_no_error(enum_primitive_src(), "derive_serialize_rejects_unserializable_field_enumprim", "E1401")
}

// A generic type parameter cannot be resolved at derive time — the check fails open, deferring
// the serializability decision to instantiation (mirrors the Debug / Hash-Eq-Ord passes).
fn generic_param_src() -> Str {
    #"@derive(Serialize)
type Box[T] { value: T }
fn main() {
    io.println("hi")
}
"#
}

test "derive Serialize over a generic type param does not false-positive E1401" {
    compile_test_helpers.expect_no_error(generic_param_src(), "derive_serialize_rejects_unserializable_field_generic", "E1401")
}

// A Char writes a JSON string of its one scalar value (sections/03_types.md *Built-in Types
// in JSON*).
fn char_field_src() -> Str {
    #"@derive(Serialize)
type Box { c: Char }
fn main() {
    io.println("hi")
}
"#
}

test "derive Serialize with a Char field derives" {
    compile_test_helpers.expect_compiles_clean(compile_test_helpers.check_via_cli(char_field_src(), "derive_serialize_rejects_unserializable_field_char"), "char field derives Serialize")
}

// I8 to U32 write a JSON integer (sections/03_types.md *Built-in Types in JSON*).
fn sized_int_field_src() -> Str {
    #"@derive(Serialize)
type Box { n: U8 }
fn main() {
    io.println("hi")
}
"#
}

test "derive Serialize with a sized-int field derives" {
    compile_test_helpers.expect_compiles_clean(compile_test_helpers.check_via_cli(sized_int_field_src(), "derive_serialize_rejects_unserializable_field_sized"), "sized field derives Serialize")
}

// A U64 can hold a value above 2^63 - 1, which a JSON reader would round, so it has no
// JSON form (sections/03_types.md *Built-in Types in JSON*).
test "derive Serialize with a U64 field is E1401" {
    let src = "@derive(Serialize)\ntype Box \{ n: U64 }\nfn main() \{\n    io.println(\"hi\")\n}\n"
    compile_test_helpers.expect_compile_error(src, "derive_serialize_rejects_unserializable_field_u64", "E1401")
}

// F32 is a reserved type name with no type behind it yet, so the field is refused by name
// resolution. A derive judges the field's type, and the field has none to judge.
fn f32_field_src() -> Str {
    #"@derive(Serialize)
type Box { x: F32 }
fn main() {
    io.println("hi")
}
"#
}

test "derive Serialize with an F32 field is refused as a reserved type" {
    compile_test_helpers.expect_compile_error(f32_field_src(), "derive_serialize_rejects_unserializable_field_f32", "E0507")
}

// A List is Serialize where its element is, so a List of a List writes each inner list.
fn nested_list_field_src() -> Str {
    #"@derive(Serialize)
type Box { grid: List[List[Int]] }
fn main() {
    io.println(Box { grid: [[1, 2], [], [3]] }.to_json())
}
"#
}

test "derive Serialize with a List of List field writes each inner list" {
    writes(nested_list_field_src(), "derive_serialize_rejects_unserializable_field_nestedlist", "\{\"grid\":[[1,2],[],[3]]}\n")
}

// A variant field is written by the same rule as a struct field.
fn enum_variant_list_src() -> Str {
    #"@derive(Serialize)
type E { V(xs: List[Int]) }
fn main() {
    io.println(E.V(xs: [1, 2]).to_json())
}
"#
}

test "derive Serialize with an enum-variant List field writes the list" {
    writes(enum_variant_list_src(), "derive_serialize_rejects_unserializable_field_enumlist", "\{\"type\":\"V\",\"xs\":[1,2]}\n")
}

fn enum_variant_enum_field_src() -> Str {
    #"@derive(Serialize)
type Inner { A, B }
@derive(Serialize)
type Outer { V(inner: Inner) }
fn main() {
    io.println(Outer.V(inner: Inner.B).to_json())
}
"#
}

test "derive Serialize with an enum-typed enum-variant field writes the inner enum" {
    writes(enum_variant_enum_field_src(), "derive_serialize_rejects_unserializable_field_enumenum", "\{\"type\":\"V\",\"inner\":\"B\"}\n")
}

// Guard: a struct field whose type is an enum that derives Serialize has a JSON form.
fn struct_enum_field_src() -> Str {
    #"@derive(Serialize)
type Status { Active, Idle }
@derive(Serialize)
type Rec { s: Status }
fn main() {
    io.println("hi")
}
"#
}

test "derive Serialize with a struct field of derived-enum type still typechecks (no false E1401)" {
    compile_test_helpers.expect_no_error(struct_enum_field_src(), "derive_serialize_rejects_unserializable_field_structenum", "E1401")
}

// Guard: a List whose element is an enum that derives Serialize has a JSON form.
fn list_of_enum_src() -> Str {
    #"@derive(Serialize)
type Status { Active, Idle }
@derive(Serialize)
type Log { entries: List[Status] }
fn main() {
    io.println("hi")
}
"#
}

test "derive Serialize with a List of derived-enum element still typechecks (no false E1401)" {
    compile_test_helpers.expect_no_error(list_of_enum_src(), "derive_serialize_rejects_unserializable_field_listenum", "E1401")
}
