// A derived Debug that renders a range field calls the range's debug body, which is built on
// demand. When nothing else in the program renders that range type, the derived body is the
// first to name it, so it must still be defined above the derived body that calls it.

@derive(Debug)
type RangeOnlyInDerive {
    span: Range[U16]
}

test "a derived Debug renders a range type no other code renders" {
    let lo: U16 = 2
    let hi: U16 = 9
    assert_eq(RangeOnlyInDerive { span: lo..=hi }.debug(), "RangeOnlyInDerive \{ span: 2..=9 }")
}
