// src/diag_catalog.bl is generated from ERROR_CATALOG.md, and `@allow` and `[lints]` reach a
// name only when its row is under *Warning Names* (§4.16.8). These rows check that the
// generated lookup gives each section its kind, by name and by code, leaves a retired row out,
// and keeps the audit-gated names, which E0837 and not E0847 refuses, on the warning side.

import diag_catalog.{diag_catalog_kind, diag_catalog_name, diag_catalog_code, diag_catalog_repair}
import diagnostics.{diag_is_audit_gated, diag_non_warning_kind, RAW_BYPASSES_PARAM, UNAUDITED_FFI}

test "each section gives its kind, by name and by code" {
    assert_eq(diag_catalog_kind("NonExhaustiveMatch"), "error")
    assert_eq(diag_catalog_kind("E0004"), "error")
    assert_eq(diag_catalog_kind("UnusedVariable"), "warning")
    assert_eq(diag_catalog_kind("ContractProven"), "info")
    assert_eq(diag_catalog_kind("V0001"), "info")
    assert_eq(diag_catalog_kind("UnsolvedTypeVarAtCodegen"), "ice")
    assert_eq(diag_catalog_kind("NotAWarningName"), "error")
}

test "a retired row and an unknown string have no kind" {
    assert_eq(diag_catalog_kind("CallSiteTypeArgs"), "")
    assert_eq(diag_catalog_kind("E0307"), "")
    assert_eq(diag_catalog_kind("WithPtrBodyTooComplex"), "")
    assert_eq(diag_catalog_kind("NoSuchDiagnostic"), "")
    assert_eq(diag_catalog_kind(""), "")
}

test "a name and its code map to each other" {
    assert_eq(diag_catalog_code("NonExhaustiveMatch"), "E0004")
    assert_eq(diag_catalog_code("E0004"), "E0004")
    assert_eq(diag_catalog_name("E0004"), "NonExhaustiveMatch")
    assert_eq(diag_catalog_name("NotAWarningName"), "NotAWarningName")
    assert_eq(diag_catalog_name("E0307"), "")
}

test "the repairs table gives a repair only to the rows it lists" {
    assert_eq(diag_catalog_repair("ContractUnverifiable"), "change `@verify(fallback: ...)`")
    assert_eq(diag_catalog_repair("CapabilityBudgetExceeded"), "widen `@capabilities`")
    assert_eq(diag_catalog_repair("NonExhaustiveMatch"), "")
}

test "a warning promoted by a setting is still not a non-warning kind" {
    assert_eq(diag_non_warning_kind("UnusedVariable"), "")
    assert_eq(diag_non_warning_kind("NoSuchDiagnostic"), "")
    assert_eq(diag_non_warning_kind("TypeError"), "error")
}

test "every audit-gated name is a warning row" {
    for key in ["RawBypassesParam", RAW_BYPASSES_PARAM, UNAUDITED_FFI] {
        assert_eq(diag_is_audit_gated(key), 1, key)
        assert_eq(diag_catalog_kind(key), "warning", key)
    }
}
