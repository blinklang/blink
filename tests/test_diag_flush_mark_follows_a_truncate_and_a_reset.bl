// diag_flush prints only the entries recorded since the last flush. A truncate that drops
// printed entries, or a reset, must move that mark back, or the entries recorded next would
// never print.

import diagnostics.{Diag, diag_reset, diag_flush, diag_truncate, diag_unflushed, diag_warn_in_file_notes}

fn warn(message: Str) ! Diag.Report {
    diag_warn_in_file_notes("UnusedVariable", "W0551", message, "probe.bl", 1, 1, "", [])
}

test "a flush prints only what was recorded since the last flush" {
    diag_reset()
    warn("first")
    assert(diag_unflushed(0).contains("first"))
    diag_flush()
    assert_eq(diag_unflushed(0), "")
    warn("second")
    let text = diag_unflushed(0)
    assert(text.contains("second"))
    assert(!text.contains("first"))
    diag_reset()
}

test "entries recorded after a truncate below the flush mark print" {
    diag_reset()
    warn("first")
    warn("dropped")
    diag_flush()
    diag_truncate(1)
    warn("after the truncate")
    let text = diag_unflushed(0)
    assert(text.contains("after the truncate"))
    assert(!text.contains("first"))
    diag_reset()
}

test "entries recorded after a reset print" {
    diag_reset()
    warn("first")
    warn("second")
    diag_flush()
    diag_reset()
    warn("after the reset")
    assert(diag_unflushed(0).contains("after the reset"))
    diag_reset()
}
