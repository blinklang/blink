import std.fs
import compile_test_helpers

fn run_human(path: Str, src: Str) -> Str ! FS.Delete {
    write_file(path, src)
    let args = [path, "/dev/null"]
    let result = process.run("build/blinkc", args).unwrap()
    let output = "{result.out}{result.err_out}"
    let _ = fs.delete(path)
    output
}

test "caret line pads to the error column and spans the token" {
    let src = "fn main() \{\n  let while = 1\n\}\n"
    let output = run_human("{compile_test_helpers.scratch_root()}/_test_caret_span.bl", src)
    assert(output.contains("\n2 |   let while = 1\n  |       ^^^^^\n"))
}

test "gutter width follows the line number digits" {
    let src = "fn main() \{\n  let a = 1\n  let b = 2\n  let c = 3\n  let d = 4\n  let e = 5\n  let f = 6\n  let g = 7\n  let h = 8\n  let i = 9\n  let j = 10\n  let while = 1\n\}\n"
    let output = run_human("{compile_test_helpers.scratch_root()}/_test_caret_gutter.bl", src)
    assert(output.contains("\n12 |   let while = 1\n   |       ^^^^^\n"))
}
