// A diagnostic quotes the source line the compiler read, not the file as it is on disk when
// the diagnostic prints. The two differ when the file changes during the compile, and for
// an editor buffer the disk never held the text at all.

import cg_test_helpers.{cg_probe_compile_but}
import diagnostics.{diag_entries, diag_entry_text}

fn first_error_text() -> Str {
    let mut i = 0
    while i < diag_entries.len() {
        if diag_entries.get(i).unwrap().severity == "error" { return diag_entry_text(i, 0) }
        i = i + 1
    }
    ""
}

test "the snippet shows the text as loaded after the file changes on disk" {
    let path = "build/diagnostic_snippet_loaded_text_probe.bl"
    let _ = cg_probe_compile_but(path, "fn main() \{\n    let _x: Int = \"as loaded\"\n\}\n", "TypeError")
    fs.write(path, "fn main() \{\n    let _x: Int = \"changed on disk\"\n\}\n")?
    let text = first_error_text()
    fs.delete(path)?
    assert(text.contains("let _x: Int = \"as loaded\""), "snippet does not quote the loaded text:\n{text}")
    assert(!text.contains("changed on disk"), "snippet quotes the disk:\n{text}")
}

test "the snippet survives the removal of the file after the load" {
    let path = "build/diagnostic_snippet_unread_probe.bl"
    let _ = cg_probe_compile_but(path, "fn main() \{\n    let _x: Int = \"as loaded\"\n\}\n", "TypeError")
    fs.delete(path)?
    let text = first_error_text()
    assert(text.contains("--> {path}:2:"), "no location:\n{text}")
    assert(text.contains("let _x: Int = \"as loaded\""), "the removed file lost its snippet:\n{text}")
}
