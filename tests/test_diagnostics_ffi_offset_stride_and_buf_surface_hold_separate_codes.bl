// Two different FFI rules had both claimed one code. The spec states that naming `Buf`
// outside the `@ffi.fn` / `@ffi.struct` surface is E0822; the tree's constant and the
// catalog row gave the same code to `Ptr.offset` on an element type whose stride is not
// known. A code that names two rules explains neither: a reader who runs `blink explain`
// on it is shown text for whichever rule happened to be written down, with nothing saying
// the other exists. The spec's rule keeps the code and the stride rule takes a new one.
//
// Neither rule has an emit site yet, so these rows read the explain text directly. That is
// the whole of what the split changes — which rule each code answers for.

import diagnostics.{diag_explain, FFI_OFFSET_UNKNOWN_STRIDE, BUF_OUTSIDE_FFI_SURFACE}

test "the stride rule answers on its own code, not on the one the spec assigns elsewhere" {
    assert_eq(FFI_OFFSET_UNKNOWN_STRIDE, "E0838")

    let text = diag_explain("E0838")
    assert(text.contains("FfiOffsetUnknownStride"))
    assert(text.contains("E0838"))
    assert(text.contains("offset"))
}

test "the code the spec assigns to the Buf surface explains the Buf surface" {
    assert_eq(BUF_OUTSIDE_FFI_SURFACE, "E0822")

    let text = diag_explain("E0822")
    assert(text.contains("BufOutsideFfiSurface"))
    assert(text.contains("E0822"))
    assert(text.contains("Buf"))
}

// The failure mode the split exists to end. Before it, this text described `Ptr.offset`.
test "the Buf surface code no longer explains the stride rule" {
    let text = diag_explain("E0822")

    assert(!text.contains("FfiOffsetUnknownStride"))
    assert(!text.contains("stride"))
}

// The spec directs an author who names `Buf` to the byte-bridge helpers and to the typed
// region form, and names the doc page as the one canonical explainer. Text that states the
// rule without naming a repair leaves the author where they started.
test "the Buf surface explainer names the repairs the spec names" {
    let text = diag_explain("E0822")

    assert(text.contains("recv_bytes"))
    assert(text.contains("alloc_n"))
    assert(text.contains("bytes-bridge"))
}
