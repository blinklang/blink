import std.io
import diagnostics.{
    diag_reset, diag_ice, diag_error, diag_entry_count, diag_ice_rendered_count,
    diag_ice_count, diag_count,
}

fn assert_eq_int(label: Str, got: Int, want: Int) {
    if got != want { io.println("FAIL: {label}: got {got} want {want}") }
    assert_eq(got, want)
}

fn ice_at(line: Int) ! Diag.Report {
    diag_ice("CodegenStageNotBuilt", "I0004", "the definition half is not built", line, 3, "use a released build")
}

fn same_ice() ! Diag.Report { ice_at(7) }

// A caller reads the count to decide whether what a stage handed back is usable. Two
// emits of one program raise the same internal error at the same place, so a count of
// distinct reports goes flat on the second and the caller accepts a unit with a body
// missing. The count therefore measures reports.
test "an internal error reported twice at one site counts twice" {
    diag_reset()
    same_ice()
    assert_eq_int("first report", diag_ice_count, 1)
    same_ice()
    assert_eq_int("second report at the same site", diag_ice_count, 2)
}

// Suppressing the repeat is a rendering rule and stays one: a reader sees the fault once.
test "the repeat is suppressed in what is rendered, not in what is counted" {
    diag_reset()
    same_ice()
    same_ice()
    same_ice()
    assert_eq_int("counted", diag_ice_count, 3)
    assert_eq_int("rendered", diag_entry_count(), 1)
    // The summary line names what the reader can find above it, so it follows the
    // rendering and not the reporting.
    assert_eq_int("summarised", diag_ice_rendered_count(), 1)
}

test "two internal errors at different sites count and render separately" {
    diag_reset()
    ice_at(7)
    ice_at(9)
    assert_eq_int("counted", diag_ice_count, 2)
    assert_eq_int("rendered", diag_entry_count(), 2)
    assert_eq_int("summarised", diag_ice_rendered_count(), 2)
}

// An error is read once per compile, not once per emit, so it keeps counting what is
// rendered and does not move with this rule. The warning count shares that path.
test "an error still counts what is rendered" {
    diag_reset()
    diag_error("TypeError", "E0300", "cannot unify", 1, 1, "annotate the binding")
    diag_error("TypeError", "E0300", "cannot unify", 1, 1, "annotate the binding")
    assert_eq_int("errors", diag_count, 1)
    assert_eq_int("rendered", diag_entry_count(), 1)
}
