// A module-level `let` and a `fn` of one name, and why the pair is refused.
//
// sections/02_syntax.md forbids two module-level `let` bindings of one name, and its
// reason is that module scope is a flat namespace: there is no inner scope for one
// declaration to shadow the other from, so a bare read of the name has no rule that
// picks between them. A `let` beside a `fn` of one name is the same collision. The
// section does not name that pair, but nothing separates it from the pair the section
// does name.
//
// A second reason is the compiler's own. The two declarations need one C symbol between
// them, so whichever loses it cannot be spelled at all. Resolving the read to the
// binding removes the internal error and emits C that assigns to a function instead,
// which is a worse report of the same collision. So the pair is refused, and refused in
// name resolution where the collision is visible, rather than left for codegen.
//
// The refusal is narrow. A binding and a function of DIFFERENT names still stand, a read
// of the binding still records the binding, and a call still records the function.

import lower_test_helpers.{probe, probe_but, ident_node_of, let_node_of, fn_decl_of, rhs_of, assert_refused_saying}
import typecheck.{tc_global_decl_node, tc_call_decl_node}
import std.io

fn colliding_src() -> Str {
    #"let mut thing: List[Int] = []

fn thing(i: Int) -> Int {
    if i >= 1 { return 0 }
    i
}

fn main() {
    thing.push(7)
    let got = thing(0)
    let _keep = [got]
}
"#
}

fn distinct_src() -> Str {
    #"let mut things: List[Int] = []

fn pick(i: Int) -> Int {
    if i >= 1 { return 0 }
    i
}

fn main() {
    things.push(7)
    let got = pick(0)
    let _keep = [got]
}
"#
}

test "a module binding and a function of one name are refused" {
    let _program = probe_but("module_let_and_fn_collide", colliding_src(), "DuplicateModuleBinding")

    assert_refused_saying("the colliding pair",
        "module-level binding `thing` has the name of a function this module declares", 1)
}

test "a module binding and a function of different names both stand" {
    let _program = probe("module_let_and_fn_distinct", distinct_src())

    let read = ident_node_of("things")
    let binding = let_node_of("things")
    let decl = tc_global_decl_node(read)

    if decl != binding {
        io.println("FAIL: the read of 'things' resolved to node {decl}, want the binding at node {binding}")
    }
    assert_eq(decl, binding)
}

test "a call still resolves to the function beside a binding of another name" {
    let _program = probe("module_let_and_fn_distinct_call", distinct_src())

    let call = rhs_of("got")
    let declared = fn_decl_of("pick")
    let decl = tc_call_decl_node(call)

    if decl != declared {
        io.println("FAIL: the call resolved to node {decl}, want the function at node {declared}")
    }
    assert_eq(decl, declared)
}

fn main() {
    io.println("module let and fn of one name")
}
