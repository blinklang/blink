// An import that resolves to no file must be reported, and reported by the function that
// fails to resolve it, not by whatever later stage happens to trip over the missing names.
// A host that embeds the compiler reads the diagnostic count to learn a compile failed, so
// a resolution that returns the empty path without recording anything hands that host a
// program built from a module it never loaded.
//
// The pass counts too: a name the stdlib namespace does hold must resolve to a path and
// record nothing, or the rule would reject every ordinary program.

import compiler.{resolve_module_path}
import diagnostics.{diag_entries, diag_reset}
import std.io

fn reports(name: Str, needle: Str) -> Int {
    let mut n = 0
    for d in diag_entries {
        if d.severity == "error" && d.name == name && d.message.contains(needle) { n = n + 1 }
    }
    n
}

fn report_text() -> Str {
    let mut out = ""
    for d in diag_entries {
        out = out.concat("[{d.severity}] {d.name}: {d.message}\n")
    }
    out
}

test "a stdlib module that does not exist is reported, not silently skipped" {
    env.set_var("BLINK_ROOT", env.cwd())
    diag_reset()

    let path = resolve_module_path("std.zznotastdlibmodule", "")

    assert_eq_str("no path for a module that does not exist", path, "")
    if reports("ModuleNotFound", "std.zznotastdlibmodule") < 1 {
        io.println("FAIL: nothing reported. Reports:\n{report_text()}")
    }
    assert(reports("ModuleNotFound", "std.zznotastdlibmodule") >= 1)
}

test "a stdlib module that does exist resolves and reports nothing" {
    env.set_var("BLINK_ROOT", env.cwd())
    diag_reset()

    let path = resolve_module_path("std.traits", "")

    assert(path != "")
    assert_eq(diag_entries.len(), 0)
}

fn assert_eq_str(label: Str, got: Str, want: Str) {
    if got != want {
        io.println("FAIL: {label}: got '{got}' want '{want}'")
    }
    assert_eq(got, want)
}
