test "Int display" {
    let n = 42
    assert(n.display() == "42")
}

test "Float display" {
    let f = 3.5
    assert(f.display() == "3.5")
}

test "Bool display" {
    let t = true
    let f = false
    assert(t.display() == "true")
    assert(f.display() == "false")
}

test "Char display" {
    let c = 'x'
    assert(c.display() == "x")
}

test "Str display is identity" {
    let s = "hello"
    assert(s.display() == "hello")
}

test "scalar fmt writes into a StringBuilder" {
    let sb = StringBuilder()
    let n = 7
    n.fmt(sb)
    sb.write(" ")
    let f = 1.5
    f.fmt(sb)
    sb.write(" ")
    let b = true
    b.fmt(sb)
    sb.write(" ")
    let c = 'z'
    c.fmt(sb)
    sb.write(" ")
    let s = "end"
    s.fmt(sb)
    assert(sb.to_str() == "7 1.5 true z end")
}
