// A ConversionError is the one error every fallible conversion answers, and a program that
// unwraps one, or writes it into a message, has to be able to show it. It renders as
// `source -> target: message`, so the reader sees which conversion failed before why.

test "a hand-built ConversionError renders source, target and message" {
    let e = ConversionError { message: "negative percentage", source_type: "Int", target_type: "Percent" }
    assert_eq("{e}", "Int -> Percent: negative percentage")
}

test "the error a narrowing conversion answers renders the same way" {
    let e = match I8.try_from(300) {
        Ok(_) => "unexpected Ok"
        Err(err) => "{err}"
    }
    assert_eq(e, "Int -> I8: value out of I8 range")
}

test "the error Char.from_code_point answers names the Int to Char conversion" {
    let e = match Char.from_code_point(-1) {
        Ok(_) => "unexpected Ok"
        Err(err) => "{err}"
    }
    assert(e.starts_with("Int -> Char: "))
}

test "a ConversionError is written into a StringBuilder through fmt" {
    let e = ConversionError { message: "value out of range", source_type: "Int", target_type: "U8" }
    let sb = StringBuilder.new()
    e.fmt(sb)
    assert_eq(sb.to_str(), "Int -> U8: value out of range")
}
