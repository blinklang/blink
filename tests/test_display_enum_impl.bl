type Color {
    Red
    Green
    Blue
}

type Shape {
    Circle(radius: Int)
    Rect(w: Int, h: Int)
}

impl Display for Color {
    fn fmt(self, sb: StringBuilder) {
        match self {
            Red => { sb.write("red") }
            Green => { sb.write("green") }
            Blue => { sb.write("blue") }
        }
    }
}

impl Display for Shape {
    fn fmt(self, sb: StringBuilder) {
        match self {
            Circle(radius) => { sb.write("Circle({radius})") }
            Rect(w, h) => { sb.write("Rect({w}x{h})") }
        }
    }
}

test "simple enum Display impl" {
    let c = Color.Green
    assert(c.display() == "green")
}

test "data enum Display impl" {
    let s = Shape.Circle(radius: 3)
    assert(s.display() == "Circle(3)")
    let r = Shape.Rect(w: 2, h: 5)
    assert(r.display() == "Rect(2x5)")
}

test "enum fmt into caller-provided StringBuilder" {
    let sb = StringBuilder()
    let c = Color.Red
    c.fmt(sb)
    assert(sb.to_str() == "red")
}
