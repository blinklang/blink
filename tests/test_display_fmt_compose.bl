type Inner {
    v: Int
}

type Outer {
    name: Str
    inner: Inner
}

impl Display for Inner {
    fn fmt(self, sb: StringBuilder) {
        sb.write("Inner({self.v})")
    }
}

impl Display for Outer {
    fn fmt(self, sb: StringBuilder) {
        sb.write("{self.name}[")
        self.inner.fmt(sb)
        sb.write("]")
    }
}

test "nested fmt writes into the same StringBuilder" {
    let o = Outer { name: "box", inner: Inner { v: 7 } }
    assert(o.display() == "box[Inner(7)]")
}

test "composed fmt into caller-provided builder keeps prior content" {
    let o = Outer { name: "kit", inner: Inner { v: 9 } }
    let sb = StringBuilder()
    sb.write(">> ")
    o.fmt(sb)
    sb.write(" <<")
    assert(sb.to_str() == ">> kit[Inner(9)] <<")
}
