import compile_test_helpers

// br j2xxyd: calling .display() on a type with no `impl Display` used to
// emit a bare E0505 with empty help. Honor the ticket's spirit under the
// current Display design (4q2etk): the diagnostic stays E0505 but now
// carries actionable help suggesting `impl Display for <Type>`.

test ".display() without an impl suggests `impl Display for <Type>`" {
    let src = "type NoDisp \{ x: Int }\nfn main() \{\n    let n = NoDisp \{ x: 1 }\n    let s = n.display()\n    io.println(s)\n}\n"
    let out = compile_test_helpers.compile_and_capture(src, "_display_hint")
    assert(out.contains("E0505"))
    assert(out.contains("impl Display for NoDisp"))
}
