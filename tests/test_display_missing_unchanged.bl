import compile_test_helpers

// Pins the wbf74w boundary: calling .display() on a type with NO Display
// impl errors exactly as it does today (E0505 UnresolvedMethod), with no
// new missing-impl suggestion behavior.
test ".display() on a type without Display impl is E0505" {
    let src = "type NoDisp \{ x: Int }\nfn main() \{\n    let n = NoDisp \{ x: 1 }\n    let s = n.display()\n    io.println(s)\n}\n"
    compile_test_helpers.expect_compile_error(src, "display_missing_impl", "E0505")
}
