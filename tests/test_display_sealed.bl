import compile_test_helpers

test "user impl Display defining display() is E0731" {
    let src = "type P \{ x: Int }\nimpl Display for P \{\n    fn fmt(self, sb: StringBuilder) \{ sb.write(\"p\") }\n    fn display(self) -> Str \{ \"nope\" }\n}\nfn main() \{\n}\n"
    compile_test_helpers.expect_compile_error(src, "display_sealed_override", "E0731")
}

test "impl Display missing fmt still reports E0900" {
    let src = "type P \{ x: Int }\nimpl Display for P \{\n}\nfn main() \{\n}\n"
    compile_test_helpers.expect_compile_error(src, "display_missing_fmt", "E0900")
}

test "E0731 impl still gets contract checks (missing fmt + display override)" {
    let src = "type P \{ x: Int }\nimpl Display for P \{\n    fn display(self) -> Str \{ \"nope\" }\n}\nfn main() \{\n}\n"
    let out = compile_test_helpers.compile_and_capture(src, "display_sealed_and_missing")
    assert(out.contains("E0731"))
    assert(out.contains("E0900"))
}

test "user-defined trait with a display method stays legal" {
    let src = "trait Printable \{\n    fn display(self) -> Str\n}\ntype Q \{ x: Int }\nimpl Printable for Q \{\n    fn display(self) -> Str \{ \"q\" }\n}\nfn main() \{\n    let q = Q \{ x: 1 }\n    io.println(q.display())\n}\n"
    let out = compile_test_helpers.compile_and_capture(src, "display_printable_ok")
    assert(out.contains("E0731") == false)
    assert(out.contains("E0900") == false)
}
