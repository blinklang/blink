// `sb.write(x)` and the io print functions take any Display value and render it through its
// `fmt` (sections/03_types.md *Display Format Protocol*, sections/04_effects.md §4.4).

import std.testing.{capture_print, capture_log}

type Pt {
    x: Int
    y: Int
}

impl Display for Pt {
    fn fmt(self, sb: StringBuilder) {
        sb.write("(")
        sb.write(self.x)
        sb.write_char(',')
        sb.write(self.y)
        sb.write(")")
    }
}

type Seg {
    a: Pt
    b: Pt
}

impl Display for Seg {
    fn fmt(self, sb: StringBuilder) {
        sb.write(self.a)
        sb.write("-")
        self.b.fmt(sb)
    }
}

type Light {
    Red
    Green
}

impl Display for Light {
    fn fmt(self, sb: StringBuilder) {
        match self {
            Red => sb.write("red")
            Green => sb.write("green")
        }
    }
}

test "sb.write renders a struct and an enum through fmt" {
    let sb = StringBuilder.new()
    sb.write(Pt { x: 1, y: 2 })
    sb.write(" ")
    sb.write(Light.Green)
    assert_eq(sb.to_str(), "(1,2) green")
}

test "sb.write of a value whose fmt writes another Display value nests" {
    let sb = StringBuilder.new()
    sb.write(Seg { a: Pt { x: 1, y: 2 }, b: Pt { x: 3, y: 4 } })
    assert_eq(sb.to_str(), "(1,2)-(3,4)")
}

test "sb.write renders a Char, a tuple and a sized int" {
    let sb = StringBuilder.new()
    let t = (1, "a")
    sb.write('c')
    sb.write(t)
    let b: U8 = 200
    sb.write(b)
    let n: I16 = -3
    sb.write(n)
    assert_eq(sb.to_str(), "c(1, a)200-3")
    assert_eq(sb.to_str(), "c{t}{b}{n}")
}

test "sb.write of a Str ends and appends it once" {
    let sb = StringBuilder.new()
    sb.write("x")
    sb.write("")
    sb.write("yz")
    assert_eq(sb.to_str(), "xyz")
}

fn show[T: Display](x: T) -> Str {
    let sb = StringBuilder.new()
    sb.write(x)
    sb.to_str()
}

test "StringBuildOps.write renders a struct through fmt, as the method form does" {
    let sb = StringBuilder.new()
    StringBuildOps.write(sb, Pt { x: 7, y: 8 })
    assert_eq(sb.to_str(), "(7,8)")
}

test "sb.write of a Display type parameter renders each instance" {
    assert_eq(show(42), "42")
    assert_eq(show(1.5), "1.5")
    assert_eq(show((1, "a")), "(1, a)")
    assert_eq(show('q'), "q")
    assert_eq(show(Pt { x: 5, y: 6 }), "(5,6)")
}

test "a print handler sees the same message for a value and for its text" {
    let msgs: List[Str] = []
    with capture_print(msgs) {
        io.println(42)
        io.println("42")
        io.print(Pt { x: 1, y: 2 })
        io.print("(1,2)")
        io.println('c')
        io.println((1, 2))
    }
    assert_eq(msgs.len(), 6)
    assert_eq(msgs.get(0).unwrap(), "42")
    assert_eq(msgs.get(1).unwrap(), "42")
    assert_eq(msgs.get(2).unwrap(), "(1,2)")
    assert_eq(msgs.get(3).unwrap(), "(1,2)")
    assert_eq(msgs.get(4).unwrap(), "c")
    assert_eq(msgs.get(5).unwrap(), "(1, 2)")
}

test "a log handler sees the rendered value" {
    let msgs: List[Str] = []
    with capture_log(msgs) {
        io.log(Light.Red)
        io.log(2)
    }
    assert_eq(msgs.len(), 2)
    assert_eq(msgs.get(0).unwrap(), "red")
    assert_eq(msgs.get(1).unwrap(), "2")
}
