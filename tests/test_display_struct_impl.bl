type Point {
    x: Int
    y: Int
}

impl Display for Point {
    fn fmt(self, sb: StringBuilder) {
        sb.write("Point({self.x}, {self.y})")
    }
}

test "struct Display impl synthesizes display()" {
    let p = Point { x: 1, y: 2 }
    assert(p.display() == "Point(1, 2)")
}

test "display() composes in expressions" {
    let p = Point { x: 3, y: 4 }
    let msg = "got: ".concat(p.display())
    assert(msg == "got: Point(3, 4)")
}

test "fmt() writes into a caller-provided StringBuilder" {
    let p = Point { x: 5, y: 6 }
    let sb = StringBuilder()
    sb.write("before ")
    p.fmt(sb)
    assert(sb.to_str() == "before Point(5, 6)")
}
