type Coord {
    x: Int
    y: Int
}

impl Display for Coord {
    fn fmt(self, sb: StringBuilder) {
        sb.write("({self.x},{self.y})")
    }
}

fn show[T: Display](x: T) -> Str {
    return x.display()
}

fn show_via_fmt[T: Display](x: T) -> Str {
    let sb = StringBuilder()
    x.fmt(sb)
    return sb.to_str()
}

test "T: Display bound works for a struct" {
    let c = Coord { x: 1, y: 2 }
    assert(show(c) == "(1,2)")
    assert(show_via_fmt(c) == "(1,2)")
}

test "T: Display bound works for scalars" {
    assert(show(42) == "42")
    assert(show("str") == "str")
    assert(show_via_fmt(7) == "7")
    assert(show_via_fmt(true) == "true")
}
