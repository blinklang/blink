import compile_test_helpers

// sections/03_types.md §3.3: `Never` is a subtype of every type and has no values. An
// arm-bearing form with one diverging arm therefore takes its type from the arms that
// remain — `Never` is the identity of the merge, not an absorbing element. A branch that
// cannot produce a value must not erase the value its sibling does produce.

fn loop_then_int(cond: Bool) -> Int {
    let y = if cond { loop { io.println("spin") } } else { 5 }
    y
}

fn loop_then_int_tail(cond: Bool) -> Int {
    if cond { loop { io.println("spin") } } else { 5 }
}

fn int_then_loop(cond: Bool) -> Int {
    let y = if cond { 5 } else { loop { io.println("spin") } }
    y
}

fn return_then_int(cond: Bool) -> Int {
    let y = if cond { return 99 } else { 5 }
    y + 1
}

fn exit_then_int(cond: Bool) -> Int {
    let y = if cond { env.exit(3) } else { 5 }
    y
}

fn match_arm_returns(n: Int) -> Int {
    let y = match n {
        0 => { return 99 }
        _ => { 5 }
    }
    y + 1
}

fn diverging_branch_with_option(cond: Bool) -> Option[Int] {
    let y = if cond { return None } else { Some(5) }
    y
}

fn diverging_branch_with_str(cond: Bool) -> Str {
    let y = if cond { loop { io.println("spin") } } else { "kept" }
    y
}

test "a diverging then branch keeps the else branch value" {
    assert_eq(loop_then_int(false), 5)
}

test "a diverging then branch keeps the else branch value as a bare tail" {
    assert_eq(loop_then_int_tail(false), 5)
}

test "a diverging else branch keeps the then branch value" {
    assert_eq(int_then_loop(true), 5)
}

test "a return in one branch keeps the other branch value" {
    assert_eq(return_then_int(false), 6)
    assert_eq(return_then_int(true), 99)
}

test "an env exit in one branch keeps the other branch value" {
    assert_eq(exit_then_int(false), 5)
}

test "a returning match arm keeps the other arm value" {
    assert_eq(match_arm_returns(1), 6)
    assert_eq(match_arm_returns(0), 99)
}

test "a diverging branch keeps an Option sibling" {
    assert_eq(diverging_branch_with_option(false) ?? 0, 5)
    assert_eq(diverging_branch_with_option(true) ?? 0, 0)
}

test "a diverging branch keeps a Str sibling" {
    assert_eq(diverging_branch_with_str(false), "kept")
}

// The sibling's type is what the binding holds, so a declared type on the `let` must
// agree with the sibling and not with the bottom type.
test "a declared let type agrees with the non diverging branch" {
    let src = "fn f(c: Bool) -> Int \{\n    let y: Int = if c \{ return 1 } else \{ 5 }\n    y\n}\nfn main() \{ io.println(\"\{f(false)}\") }\n"
    let r = compile_test_helpers.compile_and_run(src, "divbranch_declared_let")
    assert_eq(r.exit_code, 0)
    compile_test_helpers.expect_contains(r.out, "5", "the declared Int binding holds the sibling value")
}
