import compile_test_helpers
import std.process.{ChildEnd}

test "doc comment on first function is attached to function not header" {
    fs.write("{compile_test_helpers.scratch_root()}/test_doc_first.bl", "/// Greets the user\nfn greet(name: Str) -> Str \{\n    \"hello\"\n\}\n").unwrap()
    let result = process.run("build/blink", ["query", "{compile_test_helpers.scratch_root()}/test_doc_first.bl", "--fn", "greet", "-j"])?
    assert_eq(result.end, ChildEnd.Exited(0))
    assert(result.out.contains("Greets the user"))
}

test "doc comment on first pub function is attached to function" {
    fs.write("{compile_test_helpers.scratch_root()}/test_doc_first_pub.bl", "/// Public greeter\npub fn greet(name: Str) -> Str \{\n    \"hello\"\n\}\n").unwrap()
    let result = process.run("build/blink", ["query", "{compile_test_helpers.scratch_root()}/test_doc_first_pub.bl", "--fn", "greet", "-j"])?
    assert_eq(result.end, ChildEnd.Exited(0))
    assert(result.out.contains("Public greeter"))
}

test "doc comment on second function still works" {
    fs.write("{compile_test_helpers.scratch_root()}/test_doc_second.bl", "fn main() \{\n    greet(\"world\")\n\}\n\n/// Greets the user\nfn greet(name: Str) -> Str \{\n    \"hello\"\n\}\n").unwrap()
    let result = process.run("build/blink", ["query", "{compile_test_helpers.scratch_root()}/test_doc_second.bl", "--fn", "greet", "-j"])?
    assert_eq(result.end, ChildEnd.Exited(0))
    assert(result.out.contains("Greets the user"))
}

test "regular comment before first fn is not treated as doc" {
    fs.write("{compile_test_helpers.scratch_root()}/test_comment_first.bl", "// Just a comment\nfn greet() -> Str \{\n    \"hello\"\n\}\n").unwrap()
    let result = process.run("build/blink", ["query", "{compile_test_helpers.scratch_root()}/test_comment_first.bl", "--fn", "greet", "-j"])?
    assert_eq(result.end, ChildEnd.Exited(0))
    assert(result.out.contains("\"doc\":") == false)
}
