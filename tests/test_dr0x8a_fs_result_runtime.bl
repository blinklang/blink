// dr0x8a (fs-result-surface Stage 2): the runtime fs wrappers return
// Result[T, FsError]. The raw C ops signal errno (no longer exit(1)); a Blink
// wrapper turns that errno into Err(FsError{op, path, code}) or Ok(value) — the
// same shape http_do_request builds Result[Response, NetError] from a raw socket
// op. These wrappers are the redirect target Stage 3 will point fs.read/write/
// list_dir/delete at; here they are exercised directly.
import std.fs.{fs_do_read, fs_do_write, fs_do_list_dir, fs_do_delete, FsError, FsOp}

test "fs_do_write then fs_do_read round-trips Ok" {
    let path = "build/dr0x8a_rw.txt"
    match fs_do_write(path, "hello dr0x8a") {
        Ok(_) => assert(true)
        Err(_) => assert(false)
    }
    match fs_do_read(path) {
        Ok(content) => assert_eq(content, "hello dr0x8a")
        Err(_) => assert(false)
    }
    let _ = fs_do_delete(path)
}

test "fs_do_read of a missing path is Err(FsError) with Read op and a nonzero code" {
    match fs_do_read("build/dr0x8a_does_not_exist.txt") {
        Ok(_) => assert(false)
        Err(e) => {
            assert_eq(e.path, "build/dr0x8a_does_not_exist.txt")
            match e.op {
                FsOp.Read => assert(true)
                _ => assert(false)
            }
            match e.code {
                Errno(rc) => assert(rc != 0)
            }
        }
    }
}

test "fs_do_write into a missing directory is Err(FsError) with Write op" {
    match fs_do_write("build/dr0x8a_no_such_dir/f.txt", "x") {
        Ok(_) => assert(false)
        Err(e) => {
            match e.op {
                FsOp.Write => assert(true)
                _ => assert(false)
            }
            match e.code {
                Errno(rc) => assert(rc != 0)
            }
        }
    }
}

test "fs_do_delete removes an existing file, then reading it is Err" {
    let path = "build/dr0x8a_del.txt"
    let _ = fs_do_write(path, "doomed")
    match fs_do_delete(path) {
        Ok(_) => assert(true)
        Err(_) => assert(false)
    }
    match fs_do_read(path) {
        Ok(_) => assert(false)
        Err(e) => match e.op {
            FsOp.Read => assert(true)
            _ => assert(false)
        }
    }
}

test "fs_do_delete of a missing path is Err(FsError) with Delete op" {
    match fs_do_delete("build/dr0x8a_missing_del.txt") {
        Ok(_) => assert(false)
        Err(e) => {
            match e.op {
                FsOp.Delete => assert(true)
                _ => assert(false)
            }
            match e.code {
                Errno(rc) => assert(rc != 0)
            }
        }
    }
}

test "fs_do_list_dir of an existing directory is Ok" {
    match fs_do_list_dir(".") {
        Ok(entries) => assert(entries.len() > 0)
        Err(_) => assert(false)
    }
}

test "fs_do_list_dir of a missing directory is Err(FsError) with ListDir op" {
    match fs_do_list_dir("build/dr0x8a_no_such_dir_xyz") {
        Ok(_) => assert(false)
        Err(e) => {
            match e.op {
                FsOp.ListDir => assert(true)
                _ => assert(false)
            }
            match e.code {
                Errno(rc) => assert(rc != 0)
            }
        }
    }
}
