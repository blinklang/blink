import test_cross_module_generic_fn_helper

// dwhm4v: a polymorphic trait impl over `List[T]` where the concrete T is a
// CROSS-MODULE struct (CmgPoint, defined in test_cross_module_generic_fn_helper).
// The poly-impl mono-CSV producer (poly_impl_concrete_args) folded the raw
// QUALIFIED get_list_elem_struct return (`sv.sname2`, a dotted cross-module
// name) verbatim into the CSV, so mangle_generic_name emitted a literal `.` in
// the C symbol:
//     blink_List_Echoable_echo_test_cross_module_generic_fn_helper.CmgPoint(...)
// which is a hard gcc syntax error. The fix canonicalizes the struct branch
// through c_type_tag_for_struct (matching every other cross-module mono-seg
// producer), yielding the dot-free
//     blink_List_Echoable_echo_test_cross_module_generic_fn_helper_CmgPoint.
//
// A dotted C symbol never compiles, so a runtime test that reaches its asserts
// proves the emitted symbol is a valid C identifier.

trait Echoable[T] {
    fn echo(self, x: T) -> T
}

impl[T] Echoable[T] for List[T] {
    fn echo(_self, x: T) -> T { x }
}

test "poly impl on List[T] with cross-module struct T" {
    let pts: List[test_cross_module_generic_fn_helper.CmgPoint] = [
        test_cross_module_generic_fn_helper.CmgPoint { x: 1, y: 2 }
    ]
    let echoed = pts.echo(test_cross_module_generic_fn_helper.CmgPoint { x: 3, y: 4 })
    assert_eq(echoed.x, 3)
    assert_eq(echoed.y, 4)
}
