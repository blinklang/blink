// Stage 3+4 (gqg3rk m251hx / 9xn635): error[CannotInferType] (E0301).
//
// Two-state inference (decision 8vcj2c, 6-0): every type variable resolves to a
// concrete type, or the unresolved ones are REPORTED. No Void/Int default. When
// HM finishes a binding's region with a metavar still unbound — the empty
// container was never pinned by any constraining use — that is E0301. The sole
// repair is a type annotation.
//
// STRICT (decision Q4): an element-agnostic use (`.len()`, `.is_empty()`) does
// NOT rescue the element type — it leaves α open, so it still errors.
//
// Spec: sections/03_types.md §3.3 lines 1132-1194. Catalog: ERROR_CATALOG.md E0301.

import compile_test_helpers

// ── bare [] with no constraining use ────────────────────────────────────────

test "empty list never pinned errors E0301" {
    let src = "fn main() ! IO \{\n    let x = []\n    let n = x.len()\n    assert_eq(n, 0)\n}\n"
    compile_test_helpers.expect_compile_error(src, "e0301_list_len_only", "E0301")
}

// ── bare None with no constraining use ──────────────────────────────────────

test "bare None never constrained errors E0301" {
    let src = "fn main() ! IO \{\n    let x = None\n    match x \{\n        Some(v) => \{}\n        None => \{}\n    }\n}\n"
    compile_test_helpers.expect_compile_error(src, "e0301_bare_none", "E0301")
}

// ── empty Map()/Set() with element-agnostic use only ────────────────────────

test "empty Set with only len errors E0301" {
    let src = "fn main() ! IO \{\n    let s = Set()\n    assert_eq(s.len(), 0)\n}\n"
    compile_test_helpers.expect_compile_error(src, "e0301_set_len_only", "E0301")
}

test "empty Map with only len errors E0301" {
    let src = "fn main() ! IO \{\n    let m = Map()\n    assert_eq(m.len(), 0)\n}\n"
    compile_test_helpers.expect_compile_error(src, "e0301_map_len_only", "E0301")
}

// ── annotation is the repair (each must NOT error) ──────────────────────────

test "annotated empty list does not error" {
    let src = "fn main() ! IO \{\n    let x: List[Int] = []\n    assert_eq(x.len(), 0)\n}\n"
    compile_test_helpers.expect_no_error(src, "e0301_list_annotated", "E0301")
}

test "annotated None does not error" {
    let src = "fn main() ! IO \{\n    let x: Int? = None\n    match x \{ Some(v) => \{} None => \{} }\n}\n"
    compile_test_helpers.expect_no_error(src, "e0301_none_annotated", "E0301")
}

test "annotated empty Set does not error" {
    let src = "fn main() ! IO \{\n    let s: Set[Str] = Set()\n    assert_eq(s.len(), 0)\n}\n"
    compile_test_helpers.expect_no_error(src, "e0301_set_annotated", "E0301")
}

// ── under-constrained generic construction (the GKV exhibit) ────────────────

test "generic struct with unconstrained inner Map errors E0301" {
    let src = "type GKV[K, V] \{ m: Map[K, V] }\nfn main() ! IO \{\n    let g = GKV \{ m: Map() }\n    assert_eq(g.m.len(), 0)\n}\n"
    compile_test_helpers.expect_compile_error(src, "e0301_gkv_map", "E0301")
}

// ── empty ctor passed to a GENERIC param is RESOLVED from sibling args ──────
// fill[K,V](Map(), 256, "x") recovers K→Int, V→Str from the k/v args and pins the
// Map() argument's element metavars to Int/Str (tc_pin_generic_args_from_binds).
// So the type IS determined — no E0301. (A residual codegen seam still emits the
// str kops for this bare-arg case — tracked separately; the runtime ensure_kops
// patch masks it in single-TU builds.)

test "empty Map passed to a generic-param fn resolves (no E0301)" {
    let src = "fn fill[K, V](m: Map[K, V], k: K, v: V) \{ m.insert(k, v) }\nfn main() ! IO \{\n    fill(Map(), 256, \"x\")\n}\n"
    compile_test_helpers.expect_no_error(src, "mv_generic_param_map", "E0301")
}

test "empty list passed to a generic-param fn resolves (no E0301)" {
    let src = "fn take[T](xs: List[T], x: T) \{ xs.push(x) }\nfn main() ! IO \{\n    take([], 1)\n}\n"
    compile_test_helpers.expect_no_error(src, "mv_generic_param_list", "E0301")
}

// ── E0301 is in the catalog and `blink explain E0301` works ─────────────────

test "blink explain E0301 returns the catalog entry" {
    compile_test_helpers.verify_catalog_entry("E0301", "CannotInferType")
}
