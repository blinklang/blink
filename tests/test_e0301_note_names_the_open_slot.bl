// The E0301 note and help name what the binding's value is and what the missing type is to
// it. A null_ptr()/alloc_ptr() is a call, not an empty construction, and a Ptr misses its
// pointee type; a spawned task's Handle misses its result type. The empty literals keep
// "element type".

import compile_test_helpers

fn note_and_help(src: Str, tag: Str, note: Str, help: Str) {
    let out = compile_test_helpers.compile_and_capture(src, tag)
    compile_test_helpers.expect_error(out, "CannotInferType", tag)
    compile_test_helpers.expect_contains(out, note, "{tag} note")
    compile_test_helpers.expect_contains(out, help, "{tag} help")
}

test "an unpinned null_ptr names the call and the pointee type" {
    let src = "@trusted(audit: \"a\")\nfn main() \{\n    let n = null_ptr()\n    assert(n.is_null())\n}\n"
    note_and_help(src, "e0301_note_null_ptr",
        "the `null_ptr()` call here has no pointee type to infer at line 3",
        "add a type annotation, e.g. `let n: Ptr[T] = ...` (replace the placeholder with the intended pointee type)")
}

test "an unpinned alloc_ptr names the call and the pointee type" {
    let src = "@trusted(audit: \"a\")\nfn main() \{\n    let p = alloc_ptr()\n    assert(!p.is_null())\n}\n"
    note_and_help(src, "e0301_note_alloc_ptr",
        "the `alloc_ptr()` call here has no pointee type to infer at line 3",
        "add a type annotation, e.g. `let p: Ptr[T] = ...` (replace the placeholder with the intended pointee type)")
}

test "an unpinned spawn handle names the call and the result type" {
    let src = "fn main() ! Async \{\n    let h = async.spawn(fn() \{ [] })\n    let _x = h\n}\n"
    note_and_help(src, "e0301_note_spawn",
        "the `async.spawn()` call here has no result type to infer at line 2",
        "add a type annotation, e.g. `let h: Handle[T] = ...` (replace the placeholder with the intended result type)")
}

// A copy of another binding constructs nothing, so the note names the value, not a construction.
test "a copied unpinned handle names the value and the result type" {
    let src = "fn main() ! Async \{\n    let h = async.spawn(fn() \{ [] })\n    let _x = h\n}\n"
    note_and_help(src, "e0301_note_spawn_copy",
        "the value here has no result type to infer at line 3",
        "add a type annotation, e.g. `let _x: Handle[T] = ...` (replace the placeholder with the intended result type)")
}

test "an unpinned empty list keeps the empty-construction note" {
    let src = "fn main() \{\n    let xs = []\n    assert(xs.len() == 0)\n}\n"
    note_and_help(src, "e0301_note_empty_list",
        "the empty construction here has no element type to infer at line 2",
        "add a type annotation, e.g. `let xs: List[T] = ...` (replace the placeholder with the intended element type)")
}

test "an unpinned iterator over an empty list keeps the element-type note" {
    let src = "fn main() \{\n    let it = [].into_iter()\n    assert(it.count() == 0)\n}\n"
    note_and_help(src, "e0301_note_empty_iter",
        "the empty construction here has no element type to infer at line 2",
        "add a type annotation, e.g. `let it: Iterator[T] = ...` (replace the placeholder with the intended element type)")
}

test "an unpinned empty map keeps the empty-construction note" {
    let src = "fn main() \{\n    let m = Map()\n    assert(m.len() == 0)\n}\n"
    note_and_help(src, "e0301_note_empty_map",
        "the empty construction here has no element type to infer at line 2",
        "add a type annotation, e.g. `let m: Map[K, V] = ...` (replace the placeholder with the intended element type)")
}

test "an unpinned None keeps the empty-construction note" {
    let src = "fn main() \{\n    let o = None\n    assert(o.is_none())\n}\n"
    note_and_help(src, "e0301_note_none",
        "the empty construction here has no element type to infer at line 2",
        "add a type annotation, e.g. `let o: T? = ...` (replace the placeholder with the intended element type)")
}
