// null_ptr[T]() and alloc_ptr[T]() name no pointee, so a binding that no annotation
// or later use pins leaves T open, and an open type variable at a binding is
// error[CannotInferType] (sections/03_types.md §3.4 Under-Determined Types). Ptr is a
// one-element container like List or Channel, so it must not be the one kind the
// check skips.

import compile_test_helpers

fn ffi_main(body: Str) -> Str {
    "@trusted(audit: \"T1\")\nfn main() \{\n{body}}\n"
}

test "an unpinned null_ptr binding errors E0301" {
    let src = ffi_main("    let n = null_ptr()\n    assert(n.is_null())\n")
    compile_test_helpers.expect_compile_error(src, "e0301_null_ptr_bare", "E0301")
}

test "an unpinned alloc_ptr binding errors E0301" {
    let src = ffi_main("    let p = alloc_ptr()\n    assert(!p.is_null())\n")
    compile_test_helpers.expect_compile_error(src, "e0301_alloc_ptr_bare", "E0301")
}

test "an unpinned null_ptr inside an Option binding errors E0301" {
    let src = ffi_main("    let o = Some(null_ptr())\n    assert(o.is_some())\n")
    compile_test_helpers.expect_compile_error(src, "e0301_null_ptr_in_option", "E0301")
}

test "an unpinned null_ptr inside a tuple binding errors E0301" {
    let src = ffi_main("    let pair = (null_ptr(), 1)\n    assert(pair.1 == 1)\n")
    compile_test_helpers.expect_compile_error(src, "e0301_null_ptr_in_tuple", "E0301")
}

// The repair names the pointer, not a bare placeholder: `let n: T` would not even type-check.
test "the E0301 help for an unpinned null_ptr shows a Ptr annotation" {
    let src = ffi_main("    let n = null_ptr()\n    assert(n.is_null())\n")
    let out = compile_test_helpers.compile_and_capture(src, "e0301_null_ptr_help")
    compile_test_helpers.expect_contains(out, "let n: Ptr[T] = ...", "Ptr annotation hint")
}

// ── controls: an annotation or a later use pins T ────────────────────────────

test "an annotated null_ptr binding does not error" {
    let src = ffi_main("    let n: Ptr[Int] = null_ptr()\n    assert(n.is_null())\n")
    compile_test_helpers.expect_no_error(src, "e0301_null_ptr_annotated", "E0301")
}

test "a null_ptr binding pinned by a later argument use does not error" {
    let main = ffi_main("    let n = null_ptr()\n    assert(take(n))\n")
    let src = "@trusted(audit: \"T1\")\nfn take(p: Ptr[Int]) -> Bool \{ p.is_null() }\n{main}"
    compile_test_helpers.expect_no_error(src, "e0301_null_ptr_later_use", "E0301")
}

test "a null_ptr binding pinned by the return type does not error" {
    let src = "@trusted(audit: \"T1\")\nfn none() -> Ptr[Int] \{\n    let n = null_ptr()\n    n\n}\nfn main() \{ assert(none().is_null()) }\n"
    compile_test_helpers.expect_no_error(src, "e0301_null_ptr_return_pin", "E0301")
}
