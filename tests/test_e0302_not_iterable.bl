// error[NotIterable] (E0302) — a `for` loop's iterable must be one of Blink's
// built-in IntoIterator kinds. Before this check, a non-iterable target (e.g. a
// bare Int) fell through emit_for_in's unhandled-else and compiled to a silent
// no-op loop — the user got no diagnostic and no error, just zero iterations.
//
// Spec: sections/03c_protocols.md:178-186 (Built-in IntoIterator Implementations
// table: List/Set/Map/Range/Str/Iterator). Channel is accepted too, as a
// pre-existing receive extension outside that table (tests/test_channels.bl).
//
// Catalog: ERROR_CATALOG.md E0302.

import compile_test_helpers

// ── genuinely non-iterable targets error ────────────────────────────────────

test "for-in over Int errors E0302" {
    let src = "fn main() \{\n    for x in 5 \{\n        let _ = x\n    }\n}\n"
    compile_test_helpers.expect_compile_error(src, "e0302_int", "E0302")
}

test "for-in over Bool errors E0302" {
    let src = "fn main() \{\n    for x in true \{\n        let _ = x\n    }\n}\n"
    compile_test_helpers.expect_compile_error(src, "e0302_bool", "E0302")
}

test "for-in over a bare struct with no IntoIterator errors E0302" {
    let src = "type Pt \{ x: Int }\nfn main() \{\n    let p = Pt \{ x: 1 }\n    for v in p \{\n        let _ = v\n    }\n}\n"
    compile_test_helpers.expect_compile_error(src, "e0302_struct", "E0302")
}

// ── every spec-legal iterable is accepted, never E0302 ──────────────────────

test "for-in over List does not error E0302" {
    let src = "fn main() \{\n    let xs = [1, 2, 3]\n    for x in xs \{\n        let _ = x\n    }\n}\n"
    compile_test_helpers.expect_no_error(src, "e0302_list_ok", "E0302")
}

test "for-in over Range does not error E0302" {
    let src = "fn main() \{\n    for x in 0..3 \{\n        let _ = x\n    }\n}\n"
    compile_test_helpers.expect_no_error(src, "e0302_range_ok", "E0302")
}

test "for-in over Str does not error E0302" {
    let src = "fn main() \{\n    for c in \"abc\" \{\n        let _ = c\n    }\n}\n"
    compile_test_helpers.expect_no_error(src, "e0302_str_ok", "E0302")
}

test "for-in over Bytes does not error E0302" {
    let src = "fn main() \{\n    let b = Bytes()\n    for x in b \{\n        let _ = x\n    }\n}\n"
    compile_test_helpers.expect_no_error(src, "e0302_bytes_ok", "E0302")
}

test "for-in over Set does not error E0302" {
    let src = "fn main() \{\n    let s: Set[Int] = Set()\n    for x in s \{\n        let _ = x\n    }\n}\n"
    compile_test_helpers.expect_no_error(src, "e0302_set_ok", "E0302")
}

test "for-in over Map does not error E0302" {
    let src = "fn main() \{\n    let m: Map[Str, Int] = Map()\n    for (k, v) in m \{\n        let _ = k\n    }\n}\n"
    compile_test_helpers.expect_no_error(src, "e0302_map_ok", "E0302")
}

// ── the code is in the catalog and `blink explain E0302` works ──────────────

test "blink explain E0302 returns the catalog entry" {
    compile_test_helpers.verify_catalog_entry("E0302", "NotIterable")
}

test "blink explain I0002 returns the catalog entry" {
    compile_test_helpers.verify_catalog_entry("I0002", "UnhandledIterableAtCodegen")
}
