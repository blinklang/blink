// error[TypeArgArity] (E0303) — kind-correctness of type expressions.
//
// Spec: sections/03_types.md §3.4 lines 1228-1273. Catalog: ERROR_CATALOG.md E0303.
//
// A type constructor named in a TYPE position must be applied to EXACTLY its
// declared arity. Under-application — of which a bare name (k=0) is the extreme —
// and over-application are one failure, one code, decided at name resolution
// before inference. Uniform across builtins (Channel/List/Map/Set/Option/Result/
// Iterator/Handle), user generics, and 0-arity scalars (Int/Str/…); arity is read
// from the declaration. Every type position is covered: params, returns, fields,
// bindings, NESTED type arguments (Box[List]), impl-header receivers, and
// effect-operation signatures. Trait references in bounds/impl headers are OUT of
// scope (E0910 governs those).

import compile_test_helpers

// ── bare constructor (k=0), the extreme of under-application ─────────────────

test "bare Channel param errors E0303" {
    let src = "fn f(ch: Channel) \{}\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "e0303_bare_channel", "E0303")
}

test "bare Handle param errors E0303" {
    let src = "fn f(h: Handle) \{}\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "e0303_bare_handle", "E0303")
}

test "bare List param errors E0303" {
    let src = "fn f(xs: List) \{}\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "e0303_bare_list", "E0303")
}

test "bare List return errors E0303" {
    let src = "fn f() -> List \{ [] }\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "e0303_bare_list_ret", "E0303")
}

test "bare Option param errors E0303" {
    let src = "fn f(o: Option) \{}\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "e0303_bare_option", "E0303")
}

test "bare Result param errors E0303" {
    let src = "fn f(r: Result) \{}\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "e0303_bare_result", "E0303")
}

test "bare Iterator param errors E0303" {
    let src = "fn f(it: Iterator) \{}\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "e0303_bare_iterator", "E0303")
}

test "bare constructor in a let-binding annotation errors E0303" {
    let src = "fn main() \{ let xs: List = [] }\n"
    compile_test_helpers.expect_compile_error(src, "e0303_bare_binding", "E0303")
}

test "bare constructor in a top-level struct field errors E0303" {
    let src = "type Holder \{ xs: List }\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "e0303_bare_field", "E0303")
}

// ── under-application (too few) ──────────────────────────────────────────────

test "under-applied Map errors E0303" {
    let src = "fn f(m: Map[Str]) \{}\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "e0303_map_under", "E0303")
}

// ── over-application (too many) ──────────────────────────────────────────────

test "over-applied List errors E0303" {
    let src = "fn f(xs: List[Int, Str]) \{}\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "e0303_list_over", "E0303")
}

test "over-applied Set errors E0303" {
    let src = "fn f(s: Set[Int, Str]) \{}\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "e0303_set_over", "E0303")
}

test "over-applied user generic errors E0303" {
    let src = "type Reg[T] \{ xs: List[T] }\nfn f(r: Reg[Int, Str]) \{}\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "e0303_user_over", "E0303")
}

// ── a 0-arity scalar is a constructor too: applying it is over-application ────

test "over-applied scalar Int errors E0303" {
    let src = "fn f(x: Int[Str]) \{}\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "e0303_int_over", "E0303")
}

// ── user generic, same rule (arity from the declaration) ────────────────────

test "bare user generic param errors E0303" {
    let src = "type Reg[T] \{ xs: List[T] }\nfn f(r: Reg) \{}\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "e0303_user_bare", "E0303")
}

// ── nested type argument is a type position (§3.4:1228) ──────────────────────

test "bare nested arg under a user generic param errors E0303" {
    let src = "type Box[T] \{ v: T }\nfn f(b: Box[List]) \{}\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "e0303_nested_param", "E0303")
}

test "under-applied nested arg in a user generic field errors E0303" {
    let src = "type Box[T] \{ v: T }\ntype Holder \{ b: Box[Map[Str]] }\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "e0303_nested_field", "E0303")
}

// ── effect-operation signature is a type position ────────────────────────────

test "bare constructor in an effect-op param errors E0303" {
    let src = "effect Store \{ effect Put \{ fn put(item: Channel) } }\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "e0303_effect_op", "E0303")
}

// ── a channel.new turbofish element is a type position too ────────────────────
// `channel.new[List]` under-applies List; nested `channel.new[List[Int]]` is a
// separate parser limitation, so a bare container element there is genuinely
// under-determined and must be reported, not silently accepted.

test "bare element in a channel.new turbofish errors E0303" {
    let src = "fn main() \{ let c = channel.new[List](buffer: 1) io.println(\"x\") }\n"
    compile_test_helpers.expect_compile_error(src, "e0303_channel_new_bare", "E0303")
}

// ── a type parameter in scope is a type variable, not a constructor (§3.4:1259) ─
// A binder whose name collides with a type/builtin shadows it: applying zero args
// to it is correct, so E0303 must NOT fire on the in-scope parameter. Each control
// also asserts the program is otherwise clean, so the no-E0303 result is a real
// accept, not an unrelated error masking a still-firing E0303.

test "a type parameter shadowing a user generic is not E0303" {
    let src = "type Node[T] \{ v: T }\nfn walk[Node](x: Node) -> Int \{ 0 }\nfn main() \{}\n"
    let out = compile_test_helpers.compile_and_capture(src, "e0303_tparam_shadow_user")
    assert(!out.contains("E0303"))
    assert(!out.contains("\"severity\":\"error\""))
}

test "a type parameter shadowing a builtin is not E0303" {
    let src = "fn relay[Channel](x: Channel) -> Int \{ 0 }\nfn main() \{}\n"
    let out = compile_test_helpers.compile_and_capture(src, "e0303_tparam_shadow_builtin")
    assert(!out.contains("E0303"))
    assert(!out.contains("\"severity\":\"error\""))
}

test "a type parameter shadowing a builtin in a struct field is not E0303" {
    let src = "type Wrap[List] \{ v: List }\nfn main() \{}\n"
    let out = compile_test_helpers.compile_and_capture(src, "e0303_tparam_shadow_field")
    assert(!out.contains("E0303"))
    assert(!out.contains("\"severity\":\"error\""))
}

test "a type parameter shadowing a builtin in a type alias body is not E0303" {
    let src = "type Wrap[List] = List\nfn main() \{}\n"
    let out = compile_test_helpers.compile_and_capture(src, "e0303_tparam_shadow_alias")
    assert(!out.contains("E0303"))
    assert(!out.contains("\"severity\":\"error\""))
}

test "a binder shadowing a builtin in an impl receiver arg is not E0303" {
    let src = "trait Sz \{ fn sz(self) -> Int }\nimpl[Map] Sz for List[Map] \{ fn sz(self) -> Int \{ 0 } }\nfn main() \{}\n"
    let out = compile_test_helpers.compile_and_capture(src, "e0303_tparam_shadow_impl_recv")
    assert(!out.contains("E0303"))
}

test "a real bare builtin still errors when a sibling param shadows one" {
    // `Channel` is the binder in scope; `List` is a genuine bare builtin. E0303 must
    // name the under-applied constructor (List) in its MESSAGE, not the shadowing
    // binder (Channel) — though the normative help legitimately suggests applying the
    // in-scope parameter, so 'Channel' does appear there (`List[Channel]`).
    let src = "fn f[Channel](x: Channel, ys: List) -> Int \{ 0 }\nfn main() \{}\n"
    let out = compile_test_helpers.compile_and_capture(src, "e0303_tparam_scope_precise")
    assert(out.contains("E0303"))
    assert(out.contains("type constructor 'List'"))
    assert(!out.contains("type constructor 'Channel'"))
}

// ── impl-header receiver is a type position ───────────────────────────────────

test "bare impl-header receiver errors E0303" {
    let src = "trait Show \{ fn show(self) -> Str }\ntype Box[T] \{ v: T }\nimpl Show for Box \{ fn show(self) -> Str \{ \"x\" } }\nfn main() \{}\n"
    compile_test_helpers.expect_compile_error(src, "e0303_impl_recv_bare", "E0303")
}

// ── the first help offered is normative, and case-specific (§3.4:1255-1264) ───

test "bare + a type parameter in scope: help applies the parameter" {
    let src = "fn relay[T](src: Channel) \{}\nfn main() \{}\n"
    let out = compile_test_helpers.compile_and_capture(src, "e0303_help_apply_inscope")
    assert(out.contains("E0303"))
    assert(out.contains("apply the type parameter in scope"))
}

test "bare + no type parameter in scope: help declares a binder" {
    let src = "fn relay(src: Channel) \{}\nfn main() \{}\n"
    let out = compile_test_helpers.compile_and_capture(src, "e0303_help_declare_binder")
    assert(out.contains("E0303"))
    assert(out.contains("declare a type parameter"))
}

test "under-applied: help supplies the missing argument" {
    let src = "fn f(m: Map[Str]) \{}\nfn main() \{}\n"
    let out = compile_test_helpers.compile_and_capture(src, "e0303_help_supply_missing")
    assert(out.contains("E0303"))
    assert(out.contains("supply the missing"))
}

test "over-applied: help removes the extra argument" {
    let src = "fn f(xs: List[Int, Str]) \{}\nfn main() \{}\n"
    let out = compile_test_helpers.compile_and_capture(src, "e0303_help_remove_extra")
    assert(out.contains("E0303"))
    assert(out.contains("remove the extra"))
}

// ── correct application is the repair (each must NOT error) ──────────────────

test "applied Channel[T] does not error E0303" {
    let src = "fn relay[T](src: Channel[T], dst: Channel[T]) \{}\nfn main() \{}\n"
    compile_test_helpers.expect_no_error(src, "e0303_channel_ok", "E0303")
}

test "applied Map[K,V] does not error E0303" {
    let src = "fn f[K, V](m: Map[K, V]) \{}\nfn main() \{}\n"
    compile_test_helpers.expect_no_error(src, "e0303_map_ok", "E0303")
}

test "bare scalar Int does not error E0303" {
    let src = "fn f(x: Int) -> Int \{ x }\nfn main() \{}\n"
    compile_test_helpers.expect_no_error(src, "e0303_int_ok", "E0303")
}

test "applied user generic does not error E0303" {
    let src = "type Reg[T] \{ xs: List[T] }\nfn f[T](r: Reg[T]) \{}\nfn main() \{}\n"
    compile_test_helpers.expect_no_error(src, "e0303_user_ok", "E0303")
}

test "correct nested arg under a user generic does not error E0303" {
    let src = "type Box[T] \{ v: T }\nfn f(b: Box[List[Int]]) \{}\nfn main() \{}\n"
    compile_test_helpers.expect_no_error(src, "e0303_nested_ok", "E0303")
}

test "applied constructor in an effect-op param does not error E0303" {
    let src = "effect Store \{ effect Put \{ fn put(item: Channel[Int]) } }\nfn main() \{}\n"
    compile_test_helpers.expect_no_error(src, "e0303_effect_op_ok", "E0303")
}

test "a scalar channel.new turbofish does not error E0303" {
    let src = "fn main() \{ let c = channel.new[Str](buffer: 1) io.println(\"x\") }\n"
    compile_test_helpers.expect_no_error(src, "e0303_channel_new_ok", "E0303")
}

test "a type-param channel.new turbofish does not error E0303" {
    let src = "fn relay[T]() -> Int \{ let c = channel.new[T](buffer: 1) 0 }\nfn main() \{}\n"
    compile_test_helpers.expect_no_error(src, "e0303_channel_new_tparam", "E0303")
}

test "applied impl-header receiver does not error E0303" {
    let src = "trait Sz \{ fn sz(self) -> Int }\nimpl[T] Sz for List[T] \{ fn sz(self) -> Int \{ 0 } }\nfn main() \{}\n"
    compile_test_helpers.expect_no_error(src, "e0303_impl_recv_ok", "E0303")
}

// ── a trait name in a bound is NOT a type position (E0910 governs it) ────────

test "trait bound only does not error E0303" {
    let src = "fn sort[T: Ord](xs: List[T]) -> List[T] \{ xs }\nfn main() \{}\n"
    compile_test_helpers.expect_no_error(src, "e0303_bound_ok", "E0303")
}

// ── E0303 is in the catalog and `blink explain E0303` works ─────────────────

test "blink explain E0303 returns the catalog entry" {
    compile_test_helpers.verify_catalog_entry("E0303", "TypeArgArity")
}
