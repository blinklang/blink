// E0827 -- SkipOutsideTest (br pt1f33 / spec br cbk2wq)
//
// The compiler currently emits E0516 (SkipOutsideTestBody) at the
// typecheck site for skip() outside a test. E0827 is the
// spec-canonical name for the same condition and is wired through
// the catalog and diag_explain pending a one-release rename.

import compile_test_helpers.{verify_catalog_entry}

test "blink explain E0827 returns the catalog entry" {
    verify_catalog_entry("E0827", "SkipOutsideTest")
}
