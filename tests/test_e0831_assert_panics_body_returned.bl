// E0831 -- AssertPanicsBodyReturned (spec §2.20, decisions/assert-panics-semantics.md)
//
// The assert_panics block returned normally (or a `?`-propagated Err/None
// exited it) without panicking. Real emit-site test: compile a fixture whose
// test body uses assert_panics over non-panicking code, run the test binary,
// and assert the runner reports the failure with the E0831 message.

import compile_test_helpers.{compile_and_run_test_json, verify_catalog_entry}

test "blink explain E0831 returns the catalog entry" {
    verify_catalog_entry("E0831", "AssertPanicsBodyReturned")
}

test "body returns normally -> failure (expected the block to panic)" {
    let src = "test \"t\" \{\n    assert_panics \{\n        let _ = 1 + 1\n    }\n}\n"
    let r = compile_and_run_test_json(src, "_e0831_returned")
    assert(r.out.contains("\"status\":\"failed\""))
    assert(r.out.contains("returned normally"))
}

test "?-propagated Err exiting the body without panicking -> failure" {
    let src = "fn fails() -> Result[Int, Str] \{ Err(\"boom\") }\ntest \"t\" \{\n    assert_panics \{\n        let _ = fails()?\n    }\n}\n"
    let r = compile_and_run_test_json(src, "_e0831_qm_err")
    assert(r.out.contains("\"status\":\"failed\""))
    assert(r.out.contains("returned normally"))
}
