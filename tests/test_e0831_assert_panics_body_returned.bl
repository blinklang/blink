// E0831 -- AssertPanicsBodyReturned (br pt1f33 / spec br cbk2wq)
//
// Catalog-only test. assert_panics is not yet implemented in the
// parser/typecheck/stdlib (see decisions/std-testing-user-api.md Q4
// and br cbk2wq). The runtime check that the body actually panicked
// will live alongside the assert_panics implementation; until then,
// this test verifies the catalog entry is reachable via diag_explain.

test "blink explain E0831 returns the catalog entry" {
    let res = process_run("build/blink", ["explain", "E0831"])
    assert_eq(res.exit_code, 0)
    assert(res.out.contains("E0831"))
    assert(res.out.contains("AssertPanicsBodyReturned"))
}
