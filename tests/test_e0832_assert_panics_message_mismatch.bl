// E0832 -- AssertPanicsMessageMismatch (br pt1f33 / spec br cbk2wq)
//
// Catalog-only test. assert_panics is not yet implemented; the
// runtime message-pattern check that fires this code requires the
// matcher itself to exist. Catalog presence verified via diag_explain.

test "blink explain E0832 returns the catalog entry" {
    let res = process_run("build/blink", ["explain", "E0832"])
    assert_eq(res.exit_code, 0)
    assert(res.out.contains("E0832"))
    assert(res.out.contains("AssertPanicsMessageMismatch"))
}
