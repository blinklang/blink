// E0832 -- AssertPanicsMessageMismatch (spec §2.20, decisions/assert-panics-semantics.md)
//
// The block panicked, but the panic message did not contain the matching:
// substring. Golden-output ship-gate (per the DevOps panel condition): the
// rendering MUST show the expected substring + the FULL actual panic message
// + the panic origin — not a bare "assertion failed". Real emit-site test.

import compile_test_helpers.{compile_and_run_test_json, verify_catalog_entry}

test "blink explain E0832 returns the catalog entry" {
    verify_catalog_entry("E0832", "AssertPanicsMessageMismatch")
}

test "matching substring missing -> failure renders expected + full actual + origin" {
    let src = "test \"t\" \{\n    assert_panics(matching: \"wrong substring\") \{\n        let xs: [Int] = []\n        let _ = xs.get(0).unwrap()\n    }\n}\n"
    let r = compile_and_run_test_json(src, "_e0832_mismatch")
    assert(r.out.contains("\"status\":\"failed\""))
    // expected substring is echoed back
    assert(r.out.contains("wrong substring"))
    // full actual panic message is shown (the unwrap-None panic text)
    assert(r.out.contains("unwrap called on None"))
    // NOT a bare "assertion failed" with no detail — the introspection carries
    // the expected/actual rendering.
    assert(r.out.contains("did not contain the expected substring"))
}
