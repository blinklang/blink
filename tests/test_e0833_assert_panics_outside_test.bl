// E0833 -- AssertPanicsOutsideTest (spec §2.20, decisions/assert-panics-semantics.md)
//
// assert_panics is test-only, like skip(). Using it in a non-test function is
// rejected at typecheck. Real emit-site test. NOTE: like skip(), it IS allowed
// inside a closure that is lexically within a test body (e.g. a for_each case),
// because tc_in_test_body stays set through such closures — so the negative
// case here is a top-level helper fn, not an in-test closure.

import compile_test_helpers.{expect_compile_error, expect_no_error, verify_catalog_entry}

test "blink explain E0833 returns the catalog entry" {
    verify_catalog_entry("E0833", "AssertPanicsOutsideTest")
}

test "assert_panics in a non-test fn is E0833" {
    let src = "fn helper() \{\n    assert_panics \{\n        let xs: [Int] = []\n        let _ = xs.get(0).unwrap()\n    }\n}\n"
    expect_compile_error(src, "e0833_helper", "E0833")
}

test "assert_panics inside a test body is accepted (no E0833)" {
    let src = "test \"t\" \{\n    assert_panics \{\n        let xs: [Int] = []\n        let _ = xs.get(0).unwrap()\n    }\n}\n"
    expect_no_error(src, "e0833_in_test", "E0833")
}

// A module-level global is outside every test block, so a closure bound to one cannot
// reach a catch frame either.
test.failing(
    "assert_panics in a closure bound to a module-level let is E0833",
    reason: "the body of a closure bound to a top-level let is never typechecked, so the check reports NodeCarriesNoType on its nodes before the fence can see assert_panics",
    ticket: "ds7es8",
) {
    let src = "let f = fn() \{\n    assert_panics \{\n        let xs: [Int] = []\n        let _ = xs.get(0).unwrap()\n    }\n}\n\nfn main() \{\n    f()\n}\n"
    expect_compile_error(src, "e0833_global_closure", "E0833")
}

// A handler method body is a third lexical way into a function body besides a test and a
// closure, and a handler value bound at module level stands outside every test block.
test "assert_panics in a handler method of a module-level handler value is E0833" {
    let src = "effect Ping \{\n    effect Op \{\n        fn ping() -> Int\n    }\n}\n\nlet h: Handler[Ping] = handler Ping \{\n    fn ping() -> Int \{\n        assert_panics \{\n            let xs: [Int] = []\n            let _ = xs.get(0).unwrap()\n        }\n        1\n    }\n}\n\nfn main() \{\n}\n"
    expect_compile_error(src, "e0833_global_handler", "E0833")
}
