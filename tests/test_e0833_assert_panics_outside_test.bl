// E0833 -- AssertPanicsOutsideTest (br pt1f33 / spec br cbk2wq)
//
// Catalog-only test. assert_panics is not recognized by the parser
// yet, so the typecheck-layer "outside a test" check has no emit
// site. Catalog presence verified via diag_explain.

test "blink explain E0833 returns the catalog entry" {
    let res = process_run("bin/blink", ["explain", "E0833"])
    assert_eq(res.exit_code, 0)
    assert(res.out.contains("E0833"))
    assert(res.out.contains("AssertPanicsOutsideTest"))
}
