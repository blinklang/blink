// E0834 -- AssertPanicsNestedExpectPanic (br pt1f33 / spec br cbk2wq)
//
// Catalog-only test. assert_panics is not recognized by the parser
// yet, so the nested-call check has no emit site. Catalog presence
// verified via diag_explain.

test "blink explain E0834 returns the catalog entry" {
    let res = process_run("build/blink", ["explain", "E0834"])
    assert_eq(res.exit_code, 0)
    assert(res.out.contains("E0834"))
    assert(res.out.contains("AssertPanicsNestedExpectPanic"))
}
