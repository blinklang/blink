// E0834 -- AssertPanicsNestedExpectPanic (spec §2.20, decisions/assert-panics-semantics.md)
//
// A lexically-nested assert_panics inside another assert_panics is rejected at
// typecheck — the outer block would swallow the inner's mechanism, making
// "which panic is THE expected panic" ambiguous. E0833 + E0834 together keep
// the runtime armed counter in {0,1}. Real emit-site test.

import compile_test_helpers.{expect_compile_error, expect_no_error, verify_catalog_entry}

test "blink explain E0834 returns the catalog entry" {
    verify_catalog_entry("E0834", "AssertPanicsNestedExpectPanic")
}

test "assert_panics nested inside assert_panics is E0834" {
    let src = "test \"t\" \{\n    assert_panics \{\n        assert_panics \{\n            let xs: [Int] = []\n            let _ = xs.get(0).unwrap()\n        }\n    }\n}\n"
    expect_compile_error(src, "e0834_nested", "E0834")
}

test "two sibling assert_panics blocks are not nested (no E0834)" {
    let src = "test \"t\" \{\n    assert_panics \{ let xs: [Int] = []\n        let _ = xs.get(0).unwrap() }\n    assert_panics \{ let ys: [Int] = []\n        let _ = ys.get(0).unwrap() }\n}\n"
    expect_no_error(src, "e0834_siblings", "E0834")
}
