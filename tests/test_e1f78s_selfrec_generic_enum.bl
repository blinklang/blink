// A self-recursive GENERIC enum (`LL[T]` with a `tail: LL[T]` field) must mono
// its nullary variant constructor (`LL.Nil`) onto the scrutinee's stem and box
// the self-recursive field through a deref in the match binder. The nullary
// FieldAccess constructor emitted a BARE cast (blink_LL) and skipped mono
// registration, and the struct-style binder for a generic self-recursive field
// assigned the boxed int64_t field directly with no deref — both invalid C.

import compile_test_helpers

fn src_cons_head() -> Str {
    #"import std.io

type LL[T] { Nil, Cons { head: T, tail: LL[T] } }

fn main() {
    let inner: LL[Int] = LL.Nil
    let outer: LL[Int] = LL.Cons { head: 7, tail: inner }
    match outer {
        LL.Cons { head: h, tail: t } => io.println("head={h}")
        LL.Nil => io.println("nil")
    }
}
"#
}

test "self-recursive generic enum Cons binder reads the scalar head" {
    let r = compile_test_helpers.compile_and_run(src_cons_head(), "e1f78s_cons")
    if !r.out.contains("head=7") {
        compile_test_helpers.expect_contains(r.out, "head=7", "selfrec generic Cons binder — got '{r.out}' / '{r.err_out}'")
    }
    assert(r.out.contains("head=7"))
    assert(!r.out.contains("nil"))
    assert_eq(r.exit_code, 0)
}

fn src_nullary_only() -> Str {
    #"import std.io

type LL[T] { Nil, Cons { head: T, tail: LL[T] } }

fn main() {
    let x: LL[Int] = LL.Nil
    match x {
        LL.Nil => io.println("nil")
        LL.Cons { head: h, tail: t } => io.println("head={h}")
    }
}
"#
}

test "self-recursive generic enum nullary-only constructor instantiates its mono" {
    let r = compile_test_helpers.compile_and_run(src_nullary_only(), "e1f78s_nullary")
    if !r.out.contains("nil") {
        compile_test_helpers.expect_contains(r.out, "nil", "selfrec generic nullary-only — got '{r.out}' / '{r.err_out}'")
    }
    assert(r.out.contains("nil"))
    assert(!r.out.contains("head"))
    assert_eq(r.exit_code, 0)
}

fn src_nested_match_on_binder() -> Str {
    #"import std.io

type LL[T] { Nil, Cons { head: T, tail: LL[T] } }

fn main() {
    let n: LL[Int] = LL.Nil
    let mid: LL[Int] = LL.Cons { head: 2, tail: n }
    let top: LL[Int] = LL.Cons { head: 1, tail: mid }
    match top {
        LL.Cons { head: h, tail: t } => {
            match t {
                LL.Cons { head: h2, tail: _ } => io.println("h={h} h2={h2}")
                LL.Nil => io.println("h={h} nil")
            }
        }
        LL.Nil => io.println("empty")
    }
}
"#
}

test "nested match on a bound self-recursive binder recovers the mono instance" {
    let r = compile_test_helpers.compile_and_run(src_nested_match_on_binder(), "e1f78s_nested")
    if !r.out.contains("h=1 h2=2") {
        compile_test_helpers.expect_contains(r.out, "h=1 h2=2", "selfrec generic nested match on binder — got '{r.out}' / '{r.err_out}'")
    }
    assert(r.out.contains("h=1 h2=2"))
    assert_eq(r.exit_code, 0)
}
