// E2E test: git dependencies — clone, build, lockfile, blink run, tag update.
import compile_test_helpers

fn run_cmd(cmd: Str, label: Str) -> Bool ! Process.Spawn, IO.Print {
    let r = process.run("sh", ["-c", cmd]).unwrap()
    if !r.success() {
        io.println("FAIL: {label} ({r.end})")
        io.println("{r.out}{r.err_out}")
    }
    r.success()
}

fn check_output(path: Str, expected: Str, label: Str) -> Str ! Process.Spawn, FS.Read, IO {
    process.run("sh", ["-c", "{path} > {path}_out.txt 2>&1 || true"]).unwrap()
    let output = fs.read("{path}_out.txt").unwrap()
    if output.starts_with(expected) {
        io.println("PASS: {label}")
    } else {
        io.println("FAIL: {label} — expected '{expected}', got: {output}")
    }
    output
}

fn trim(s: Str) -> Str {
    let mut end = s.byte_len()
    while end > 0 {
        let ch = s.byte_at(end - 1)
        if ch == 10 || ch == 13 || ch == 32 {
            end = end - 1
        } else {
            return s.byte_slice(0, end)
        }
    }
    ""
}

fn main() {
    let base = "{compile_test_helpers.scratch_root()}/_test_e2e_gitdep"
    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
    process.run("sh", ["-c", "rm -rf ~/.blink/cache/git/*_test_e2e_*"]).unwrap()
    // Get absolute path for file:// URLs
    process.run("sh", ["-c", "mkdir -p {base}"]).unwrap()
    process.run("sh", ["-c", "realpath {base} > {base}/_abs"]).unwrap()
    let abs = trim(fs.read("{base}/_abs").unwrap())
    let git_cfg = "-c user.email='t@t' -c user.name='t'"
    // --- Setup: create libb as a git repo with tag v1.0 ---
    process.run("sh", ["-c", "mkdir -p {base}/repos/libb/src"]).unwrap()
    fs.write("{base}/repos/libb/blink.toml", "[package]\nname = \"libb\"\nversion = \"1.0.0\"\n").unwrap()
    fs.write("{base}/repos/libb/src/libb.bl", "pub fn greet() -> Str \{\n    \"hello-git\"\n}\n").unwrap()
    process.run(
        "sh",
        ["-c", "cd {base}/repos/libb && git init -q && git add -A && git {git_cfg} commit -q -m 'init' && git tag v1.0"],
    ).unwrap()
    // --- Test 1: Basic git dep build ---
    process.run("sh", ["-c", "mkdir -p {base}/proja/src"]).unwrap()
    fs.write(
        "{base}/proja/blink.toml",
        "[package]\nname = \"proja\"\nversion = \"1.0.0\"\n\n[dependencies]\nlibb = \{ git = \"file://{abs}/repos/libb\", tag = \"v1.0\" }\n"
    ).unwrap()
    fs.write(
        "{base}/proja/src/main.bl",
        "import libb\n\nfn main() \{\n    io.println(greet())\n}\n"
    ).unwrap()
    let pact = "{env.cwd()}/build/blink"
    let ok1 = run_cmd(
        "cd {base}/proja && {pact} build src/main.bl -o build/app 2>&1",
        "build proja with git dep"
    )
    if !ok1 {
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        process.run("sh", ["-c", "rm -rf ~/.blink/cache/git/*_test_e2e_*"]).unwrap()
        return
    }
    check_output("{base}/proja/build/app", "hello-git", "basic git dep output")
    if compile_test_helpers.path_exists("{base}/proja/blink.lock") {
        // --- Test 2: Lockfile written ---
        io.println("PASS: lockfile written after git dep build")
    } else {
        io.println("FAIL: lockfile not found after git dep build")
    }
    // --- Test 3: blink run with git dep ---
    fs.write(
        "{base}/proja/src/runme.bl",
        "import libb\n\nfn main() \{\n    io.println(greet())\n    io.println(\"run-ok\")\n}\n"
    ).unwrap()
    process.run("sh", ["-c", "cd {base}/proja && {pact} run src/runme.bl > run_output.txt 2>&1 || true"]).unwrap()
    let run_out = fs.read("{base}/proja/run_output.txt").unwrap()
    if run_out.contains("hello-git") && run_out.contains("run-ok") {
        io.println("PASS: blink run with git dep")
    } else {
        io.println("FAIL: blink run — expected 'hello-git' and 'run-ok', got: {run_out}")
    }
    // --- Test 4: Tag update (v1.0 → v2.0) ---
    fs.write(
        "{base}/repos/libb/src/libb.bl",
        "pub fn greet() -> Str \{\n    \"hello-git-v2\"\n}\n"
    ).unwrap()
    process.run(
        "sh",
        ["-c", "cd {base}/repos/libb && git add -A && git {git_cfg} commit -q -m 'v2' && git tag v2.0"],
    ).unwrap()
    fs.write(
        "{base}/proja/blink.toml",
        "[package]\nname = \"proja\"\nversion = \"1.0.0\"\n\n[dependencies]\nlibb = \{ git = \"file://{abs}/repos/libb\", tag = \"v2.0\" }\n"
    ).unwrap()
    process.run("sh", ["-c", "rm -f {base}/proja/blink.lock"]).unwrap()
    let ok4 = run_cmd(
        "cd {base}/proja && {pact} build src/main.bl -o build/app2 2>&1",
        "build proja with git dep v2.0"
    )
    if !ok4 {
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        process.run("sh", ["-c", "rm -rf ~/.blink/cache/git/*_test_e2e_*"]).unwrap()
        return
    }
    check_output("{base}/proja/build/app2", "hello-git-v2", "tag update v2.0 output")
    // --- Cleanup ---
    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
    process.run("sh", ["-c", "rm -rf ~/.blink/cache/git/*_test_e2e_*"]).unwrap()
}
