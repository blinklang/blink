// E2E test: two packages (A depends on B via path dep), verify compile + run works.
// Also tests transitive deps (A → B → C) and selective imports.

import compile_test_helpers

fn run_cmd(cmd: Str, label: Str) -> Bool ! Process.Spawn, IO.Print {
    let r = process.run("sh", ["-c", cmd]).unwrap()
    if !r.success() {
        io.println("FAIL: {label} ({r.end})")
        io.println("{r.out}{r.err_out}")
    }
    r.success()
}

fn check_output(path: Str, expected: Str, label: Str) -> Str ! Process.Spawn, FS.Read, IO {
    process.run("sh", ["-c", "{path} > {path}_out.txt 2>&1 || true"]).unwrap()
    let output = fs.read("{path}_out.txt").unwrap()
    if output.starts_with(expected) {
        io.println("PASS: {label}")
    } else {
        io.println("FAIL: {label} — expected '{expected}', got: {output}")
    }
    output
}

fn main() {
    let base = "{compile_test_helpers.scratch_root()}/_test_e2e_pathdep"
    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()

    // --- Test 1: A depends on B, B exports a function A calls ---
    process.run("sh", ["-c", "mkdir -p {base}/proja/src"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {base}/libb/src"]).unwrap()

    fs.write("{base}/libb/blink.toml", "[package]\nname = \"libb\"\nversion = \"0.2.0\"\n").unwrap()
    fs.write("{base}/libb/src/libb.bl", "pub fn add(a: Int, b: Int) -> Int \{\n    a + b\n\}\n\npub fn greeting() -> Str \{\n    \"hello from B\"\n\}\n").unwrap()

    fs.write("{base}/proja/blink.toml", "[package]\nname = \"proja\"\nversion = \"1.0.0\"\n\n[dependencies]\nlibb = \{ path = \"../libb\" \}\n").unwrap()
    fs.write("{base}/proja/src/main.bl", "import libb.\{greeting, add\}\n\nfn main() \{\n    io.println(greeting())\n    let sum = add(2, 3)\n    io.println(\"\{sum\}\")\n\}\n").unwrap()

    let pact = "{env.cwd()}/build/blink"
    let ok1 = run_cmd("cd {base}/proja && {pact} build src/main.bl -o build/app 2>&1", "build A→B")
    if !ok1 {
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        return
    }
    let out1 = check_output("{base}/proja/build/app", "hello from B", "A calls B.greeting()")

    if out1.contains("5") {
        io.println("PASS: A calls B.add(2,3) = 5")
    } else {
        io.println("FAIL: expected '5' in output, got: {out1}")
    }

    // --- Test 2: Selective import — import libb.{add} ---
    fs.write("{base}/proja/src/selective.bl", "import libb.\{add\}\n\nfn main() \{\n    let r = add(10, 20)\n    io.println(\"\{r\}\")\n\}\n").unwrap()

    let ok2 = run_cmd("cd {base}/proja && {pact} build src/selective.bl -o build/selective 2>&1", "build selective import")
    if !ok2 {
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        return
    }
    check_output("{base}/proja/build/selective", "30", "selective import libb.\{add\}")

    // --- Test 3: Transitive deps — A → B → C ---
    process.run("sh", ["-c", "mkdir -p {base}/libc/src"]).unwrap()

    fs.write("{base}/libc/blink.toml", "[package]\nname = \"libc\"\nversion = \"0.1.0\"\n").unwrap()
    fs.write("{base}/libc/src/libc.bl", "pub fn base_value() -> Int \{\n    42\n\}\n").unwrap()

    // B now depends on C
    fs.write("{base}/libb/blink.toml", "[package]\nname = \"libb\"\nversion = \"0.2.0\"\n\n[dependencies]\nlibc = \{ path = \"../libc\" \}\n").unwrap()
    fs.write("{base}/libb/src/libb.bl", "import libc.\{base_value\}\n\npub fn add(a: Int, b: Int) -> Int \{\n    a + b\n\}\n\npub fn greeting() -> Str \{\n    \"hello from B\"\n\}\n\npub fn combined() -> Int \{\n    add(base_value(), 8)\n\}\n").unwrap()

    // A imports both B and C
    fs.write("{base}/proja/src/transitive.bl", "import libb.\{combined\}\nimport libc.\{base_value\}\n\nfn main() \{\n    let c = combined()\n    let b = base_value()\n    io.println(\"\{c\}\")\n    io.println(\"\{b\}\")\n\}\n").unwrap()

    // Remove stale lockfile so it re-resolves
    process.run("sh", ["-c", "rm -f {base}/proja/blink.lock"]).unwrap()
    // Update A's manifest to also declare C (or rely on transitive resolution)
    fs.write("{base}/proja/blink.toml", "[package]\nname = \"proja\"\nversion = \"1.0.0\"\n\n[dependencies]\nlibb = \{ path = \"../libb\" \}\nlibc = \{ path = \"../libc\" \}\n").unwrap()

    let ok3 = run_cmd("cd {base}/proja && {pact} build src/transitive.bl -o build/transitive 2>&1", "build A→B→C transitive")
    if !ok3 {
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        return
    }
    let out3 = check_output("{base}/proja/build/transitive", "50", "transitive: combined() = add(42, 8) = 50")

    if out3.contains("42") {
        io.println("PASS: transitive: A calls C.base_value() = 42 directly")
    } else {
        io.println("FAIL: expected '42' in output, got: {out3}")
    }

    // --- Test 4: blink run (compile+execute in one step) ---
    process.run("sh", ["-c", "rm -f {base}/proja/blink.lock"]).unwrap()
    fs.write("{base}/proja/blink.toml", "[package]\nname = \"proja\"\nversion = \"1.0.0\"\n\n[dependencies]\nlibb = \{ path = \"../libb\" \}\n").unwrap()
    fs.write("{base}/proja/src/runme.bl", "import libb.\{add\}\n\nfn main() \{\n    let r = add(100, 23)\n    io.println(\"\{r\}\")\n\}\n").unwrap()

    process.run("sh", ["-c", "cd {base}/proja && {pact} run src/runme.bl > run_output.txt 2>&1 || true"]).unwrap()
    let run_out = fs.read("{base}/proja/run_output.txt").unwrap()
    if run_out.contains("123") {
        io.println("PASS: blink run with path dep produces correct output")
    } else {
        io.println("FAIL: blink run — expected '123' in output, got: {run_out}")
    }

    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
}
