// E2E test: transitive dependencies — path chains, git chains, and diamond deps.
import compile_test_helpers

fn run_cmd(cmd: Str, label: Str) -> Bool ! Process.Spawn, IO.Print {
    let r = process.run("sh", ["-c", cmd]).unwrap()
    if !r.success() {
        io.println("FAIL: {label} ({r.end})")
        io.println("{r.out}{r.err_out}")
    }
    r.success()
}

fn check_output(path: Str, expected: Str, label: Str) -> Str ! Process.Spawn, FS.Read, IO {
    process.run("sh", ["-c", "{path} > {path}_out.txt 2>&1 || true"]).unwrap()
    let output = fs.read("{path}_out.txt").unwrap()
    if output.starts_with(expected) {
        io.println("PASS: {label}")
    } else {
        io.println("FAIL: {label} — expected '{expected}', got: {output}")
    }
    output
}

fn trim(s: Str) -> Str {
    let mut end = s.byte_len()
    while end > 0 {
        let ch = s.byte_at(end - 1)
        if ch == 10 || ch == 13 || ch == 32 {
            end = end - 1
        } else {
            return s.byte_slice(0, end)
        }
    }
    ""
}

fn main() {
    let base = "{compile_test_helpers.scratch_root()}/_test_e2e_transitive"
    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
    process.run("sh", ["-c", "rm -rf ~/.blink/cache/git/*_test_e2e_*"]).unwrap()
    // ========================================================================
    // Test 1: Path chain A → B → C
    // ========================================================================
    process.run("sh", ["-c", "mkdir -p {base}/libc/src"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {base}/libb/src"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {base}/proja/src"]).unwrap()
    fs.write("{base}/libc/blink.toml", "[package]\nname = \"libc\"\nversion = \"0.1.0\"\n").unwrap()
    fs.write("{base}/libc/src/libc.bl", "pub fn base_val() -> Int \{\n    42\n}\n").unwrap()
    fs.write(
        "{base}/libb/blink.toml",
        "[package]\nname = \"libb\"\nversion = \"0.1.0\"\n\n[dependencies]\nlibc = \{ path = \"../libc\" }\n"
    ).unwrap()
    fs.write(
        "{base}/libb/src/libb.bl",
        "import libc\n\npub fn combined() -> Int \{\n    base_val() + 8\n}\n"
    ).unwrap()
    fs.write(
        "{base}/proja/blink.toml",
        "[package]\nname = \"proja\"\nversion = \"1.0.0\"\n\n[dependencies]\nlibb = \{ path = \"../libb\" }\nlibc = \{ path = \"../libc\" }\n"
    ).unwrap()
    fs.write(
        "{base}/proja/src/main.bl",
        "import libb\nimport libc\n\nfn main() \{\n    io.println(\"\{combined()}\")\n    io.println(\"\{base_val()}\")\n}\n"
    ).unwrap()
    let pact = "{env.cwd()}/build/blink"
    let ok1 = run_cmd(
        "cd {base}/proja && {pact} build src/main.bl -o build/app 2>&1",
        "build path chain A→B→C"
    )
    if !ok1 {
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        return
    }
    check_output("{base}/proja/build/app", "50\n42", "path chain: combined()=50, base_val()=42")
    // ========================================================================
    // Test 2: Git chain A → B(git) → C(git)
    // ========================================================================
    process.run("sh", ["-c", "mkdir -p {base}/repos/libc/src"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {base}/repos/libb/src"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {base}/projgit/src"]).unwrap()
    // Create libc git repo
    fs.write("{base}/repos/libc/blink.toml", "[package]\nname = \"libc\"\nversion = \"1.0.0\"\n").unwrap()
    fs.write("{base}/repos/libc/src/libc.bl", "pub fn c_val() -> Str \{\n    \"from-c\"\n}\n").unwrap()
    let ok2a = run_cmd(
        "cd {base}/repos/libc && git init && git add -A && git -c user.email='t@t' -c user.name='t' commit -m 'init' && git tag v1.0 2>&1",
        "git init libc"
    )
    if !ok2a {
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        return
    }
    // Get absolute path for file:// URLs
    process.run("sh", ["-c", "realpath {base}/repos/libc > {base}/_abs_libc.txt"]).unwrap()
    let abs_libc = trim(fs.read("{base}/_abs_libc.txt").unwrap())
    process.run("sh", ["-c", "realpath {base}/repos/libb > {base}/_abs_libb.txt"]).unwrap()
    let abs_libb = trim(fs.read("{base}/_abs_libb.txt").unwrap())
    // Create libb git repo (depends on libc via git)
    fs.write(
        "{base}/repos/libb/blink.toml",
        "[package]\nname = \"libb\"\nversion = \"1.0.0\"\n\n[dependencies]\nlibc = \{ git = \"file://{abs_libc}\", tag = \"v1.0\" }\n"
    ).unwrap()
    fs.write(
        "{base}/repos/libb/src/libb.bl",
        "import libc\n\npub fn b_val() -> Str \{\n    c_val()\n}\n"
    ).unwrap()
    let ok2b = run_cmd(
        "cd {base}/repos/libb && git init && git add -A && git -c user.email='t@t' -c user.name='t' commit -m 'init' && git tag v1.0 2>&1",
        "git init libb"
    )
    if !ok2b {
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        return
    }
    // projgit depends on libb via git
    fs.write(
        "{base}/projgit/blink.toml",
        "[package]\nname = \"projgit\"\nversion = \"1.0.0\"\n\n[dependencies]\nlibb = \{ git = \"file://{abs_libb}\", tag = \"v1.0\" }\n"
    ).unwrap()
    fs.write(
        "{base}/projgit/src/main.bl",
        "import libb\n\nfn main() \{\n    io.println(b_val())\n}\n"
    ).unwrap()
    let ok2c = run_cmd(
        "cd {base}/projgit && {pact} build src/main.bl -o build/app 2>&1",
        "build git chain A→B(git)→C(git)"
    )
    if !ok2c {
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        process.run("sh", ["-c", "rm -rf ~/.blink/cache/git/*_test_e2e_*"]).unwrap()
        return
    }
    check_output(
        "{base}/projgit/build/app",
        "from-c",
        "git chain: b_val() returns c_val() = from-c"
    )
    // ========================================================================
    // Test 3: Diamond — A depends on B and C, B also depends on C
    // ========================================================================
    process.run("sh", ["-c", "mkdir -p {base}/diamond/libc/src"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {base}/diamond/libb/src"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {base}/diamond/proja/src"]).unwrap()
    fs.write("{base}/diamond/libc/blink.toml", "[package]\nname = \"libc\"\nversion = \"0.1.0\"\n").unwrap()
    fs.write("{base}/diamond/libc/src/libc.bl", "pub fn base_val() -> Int \{\n    42\n}\n").unwrap()
    fs.write(
        "{base}/diamond/libb/blink.toml",
        "[package]\nname = \"libb\"\nversion = \"0.1.0\"\n\n[dependencies]\nlibc = \{ path = \"../libc\" }\n"
    ).unwrap()
    fs.write(
        "{base}/diamond/libb/src/libb.bl",
        "import libc\n\npub fn combined() -> Int \{\n    base_val() + 8\n}\n"
    ).unwrap()
    // A depends on BOTH B and C directly — diamond pattern (B also depends on C)
    fs.write(
        "{base}/diamond/proja/blink.toml",
        "[package]\nname = \"proja\"\nversion = \"1.0.0\"\n\n[dependencies]\nlibb = \{ path = \"../libb\" }\nlibc = \{ path = \"../libc\" }\n"
    ).unwrap()
    fs.write(
        "{base}/diamond/proja/src/main.bl",
        "import libb\nimport libc\n\nfn main() \{\n    let c = combined()\n    let b = base_val()\n    io.println(\"\{c}\")\n    io.println(\"\{b}\")\n}\n"
    ).unwrap()
    let pact3 = "{env.cwd()}/build/blink"
    let ok3 = run_cmd(
        "cd {base}/diamond/proja && {pact3} build src/main.bl -o build/app 2>&1",
        "build diamond A→B+C, B→C"
    )
    if !ok3 {
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        process.run("sh", ["-c", "rm -rf ~/.blink/cache/git/*_test_e2e_*"]).unwrap()
        return
    }
    check_output(
        "{base}/diamond/proja/build/app",
        "50\n42",
        "diamond: combined()=50, base_val()=42 (no conflict)"
    )
    // Cleanup
    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
    process.run("sh", ["-c", "rm -rf ~/.blink/cache/git/*_test_e2e_*"]).unwrap()
}
