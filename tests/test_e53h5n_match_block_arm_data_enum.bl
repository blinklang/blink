// Regression for e53h5n: block-arm match over a data enum in tail position must
// wire the pattern-bound variant-field value into the function return.
type Shape {
    Circle(radius: Int)
    Square(side: Int)
}

fn measure(s: Shape) -> Int {
    match s {
        Circle(r) => { r }
        Square(side) => { side }
    }
}

test "block-arm match over data enum in tail position returns field value" {
    assert_eq(measure(Circle(5)), 5)
    assert_eq(measure(Square(9)), 9)
}
