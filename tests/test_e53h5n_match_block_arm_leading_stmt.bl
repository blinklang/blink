// Regression for e53h5n: block-arm match where the block has a leading statement
// before the pattern-bound tail identifier. Exercises infer_block_type walking to
// the last statement and the pattern fallback still resolving the tail ident.
fn pick(o: Option[Int]) -> Int {
    match o {
        Some(v) => {
            let _msg = "found"
            v
        }
        None => {
            let _msg = "missing"
            0
        }
    }
}

test "block-arm match with leading stmt in tail position returns arm value" {
    assert_eq(pick(Some(21)), 21)
    assert_eq(pick(None), 0)
}
