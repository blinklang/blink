// Regression for e53h5n: a `match` expression in tail position with BLOCK-bodied
// arms ({ v }, not bare v) must wire arm values into the function's return slot.
// Previously block-arm inference ran before pattern vars were bound, yielding
// CT_VOID, which discarded arm values via `(void)v;` and returned 0.
fn pick(o: Option[Int]) -> Int {
    match o {
        Some(v) => { v }
        None => { -1 }
    }
}

test "block-arm match over Option in tail position returns arm value" {
    assert_eq(pick(Some(42)), 42)
    assert_eq(pick(None), -1)
}
