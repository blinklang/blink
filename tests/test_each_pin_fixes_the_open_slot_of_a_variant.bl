// The open type parameter of a variant construction is fixed by any one of the pins the spec
// names (sections/03_types.md §3.4 *What pins `E`*): an annotation, a `?`, a match arm that
// reads the error, or a return type. A call argument of a known type fixes it too, as an
// expected type does, and so does the type of the parameter a default belongs to. Each
// program here checks and runs.

type Pick[T, U] {
    A(T)
    B(U)
}

fn take(r: Result[Int, Str]) -> Int {
    match r {
        Ok(v) => v
        Err(_) => -1
    }
}

fn want(s: Str) -> Int { s.len() }

fn ret_ok() -> Result[Int, Str] { Ok(3) }

fn ret_pick() -> Pick[Int, Str] { Pick.A(7) }

fn ret_none() -> Int? { None }

type Spot { v: Int }

trait Same {
    fn same(self, -- other: Option[Self] = None) -> Bool
}

impl Same for Spot {
    fn same(self, -- other: Option[Self] = None) -> Bool { other.is_none() }
}

fn via_question(x: Int) -> Result[Int, Str] {
    let z = Ok(x + 1)?
    Ok(z)
}

test "an annotation fixes the error slot of an Ok receiver" {
    let r: Result[Int, Str] = Ok(2)
    assert_eq(r.unwrap(), 2)
}

test "a call argument of a known type fixes the error slot" {
    assert_eq(take(Ok(4)), 4)
}

test "a match arm that reads the error fixes the error slot" {
    let n = match Ok(3) {
        Ok(v) => v
        Err(e) => want(e)
    }
    assert_eq(n, 3)
}

test "a return type fixes the open slot of a variant" {
    assert_eq(ret_ok().unwrap(), 3)
    match ret_pick() {
        Pick.A(v) => assert_eq(v, 7)
        Pick.B(_) => assert(false)
    }
    assert(ret_none().is_none())
}

test "a question mark fixes the error slot it propagates" {
    assert_eq(via_question(5).unwrap(), 6)
}

test "the Option[Self] parameter of an impl method fixes its None default" {
    assert(Spot { v: 1 }.same())
}
