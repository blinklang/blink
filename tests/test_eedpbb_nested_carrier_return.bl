// A fn returning a nested carrier must spell every intermediate carrier from the
// authoritative type, not the erased flat inner channel. When the Ok side of a
// Result nested under another carrier is compound (Option[Point]) or a bare
// struct/enum, the fn-return construction path erased it to a void/lowercase
// carrier that mismatched the value's real carrier type.

type Point { x: Int, y: Int }
type Color { Red, Green }

fn build_opt(n: Int) -> Option[Result[Option[Point], Str]] {
    if n == 0 { Some(Ok(Some(Point { x: 5, y: 6 }))) } else { None }
}

fn build_struct(n: Int) -> Option[Result[Point, Str]] {
    if n == 0 { Some(Ok(Point { x: 7, y: 8 })) } else { None }
}

fn build_enum(n: Int) -> Option[Result[Color, Str]] {
    if n == 0 { Some(Ok(Color.Green)) } else { None }
}

fn main() {
    // Compound (Option[Point]) ok side, three levels deep.
    let a = build_opt(0)
    match a {
        Some(r) => {
            match r {
                Ok(o) => {
                    match o {
                        Some(p) => {
                            assert_eq(p.x == 5, true)
                            assert_eq(p.y == 6, true)
                        }
                        None => assert_eq(1, 0)
                    }
                }
                Err(_e) => assert_eq(1, 0)
            }
        }
        None => assert_eq(1, 0)
    }
    let a2 = build_opt(1)
    match a2 {
        Some(_r) => assert_eq(1, 0)
        None => assert_eq(1, 1)
    }

    // Bare struct ok side.
    let b = build_struct(0)
    match b {
        Some(r) => {
            match r {
                Ok(p) => {
                    assert_eq(p.x == 7, true)
                    assert_eq(p.y == 8, true)
                }
                Err(_e) => assert_eq(1, 0)
            }
        }
        None => assert_eq(1, 0)
    }

    // Bare enum ok side.
    let c = build_enum(0)
    match c {
        Some(r) => {
            match r {
                Ok(col) => {
                    match col {
                        Color.Green => assert_eq(1, 1)
                        Color.Red => assert_eq(1, 0)
                    }
                }
                Err(_e) => assert_eq(1, 0)
            }
        }
        None => assert_eq(1, 0)
    }
}
