// An effect's handle is its name in lower case, so `effect Path` has the handle `path`,
// which is also the qualifier `import std.path` binds. Typecheck decides per call:
// `path.root()` performs the effect's operation, and `path.path_join(..)` calls the
// module's function. Codegen must lower each call the way typecheck typed it. std.db
// is the case users hit: `db.exec(..)` performs while `db.connect(..)` calls the module.

import std.path

effect Path {
    effect Read {
        fn root() -> Str
        fn path_stem(p: Str) -> Str
    }
}

// A generic function spelled like an operation: instantiating it for the perform would be
// a by-name guess with nothing to bind its type parameter from.
fn root[T](x: T) -> T {
    x
}

fn root_joined(leaf: Str) -> Str ! Path {
    path.path_join(path.root(), leaf)
}

fn root_beside[T](x: T) -> T ! Path {
    let _ = path.root()
    x
}

effect Label {
    effect Read {
        fn label() -> Str
    }
}

fn read_label() -> Str ! Label {
    label.label()
}

test "an operation reached through a handle named like a module is performed" {
    with handler Path {
        fn root() -> Str { "/r" }
        fn path_stem(p: Str) -> Str { "stem:{p}" }
    } {
        assert_eq(path.root(), "/r")
    }
}

test "a function of the module under the same spelling still reaches the module" {
    assert_eq(path.path_join("/a", "b"), "/a/b")
}

test "both readings of the spelling resolve in one expression" {
    with handler Path {
        fn root() -> Str { "/r" }
        fn path_stem(p: Str) -> Str { "stem:{p}" }
    } {
        assert_eq(root_joined("x"), "/r/x")
    }
}

test "the operation is performed from a generic function body" {
    with handler Path {
        fn root() -> Str { "/r" }
        fn path_stem(p: Str) -> Str { "stem:{p}" }
    } {
        assert_eq(root_beside(7), 7)
    }
}

test "the operation is performed from another handler's operation body" {
    with handler Path {
        fn root() -> Str { "/r" }
        fn path_stem(p: Str) -> Str { "stem:{p}" }
    } {
        with handler Label {
            fn label() -> Str { path.root() }
        } {
            assert_eq(read_label(), "/r")
        }
    }
}

test "an operation spelled like a function of the module is still performed" {
    with handler Path {
        fn root() -> Str { "/r" }
        fn path_stem(p: Str) -> Str { "stem:{p}" }
    } {
        assert_eq(path.path_stem("a/b.txt"), "stem:a/b.txt")
    }
}

test "a generic function spelled like the operation is not instantiated for the perform" {
    with handler Path {
        fn root() -> Str { "/r" }
        fn path_stem(p: Str) -> Str { "stem:{p}" }
    } {
        assert_eq(path.root(), "/r")
        assert_eq(root(3), 3)
    }
}
