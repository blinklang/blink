// An effect's handle is its name in lower case, so `effect Path` has the handle `path`,
// which is also the qualifier `import std.path` binds. Typecheck decides per call:
// `path.root()` performs the effect's operation, and `path.path_join(..)` calls the
// module's function. Codegen must lower each call the way typecheck typed it. std.db
// is the case users hit: `db.exec(..)` performs while `db.connect(..)` calls the module.

import std.path

effect Path {
    effect Read {
        fn root() -> Str
    }
}

fn root_joined(leaf: Str) -> Str ! Path {
    path.path_join(path.root(), leaf)
}

test "an operation reached through a handle named like a module is performed" {
    with handler Path {
        fn root() -> Str { "/r" }
    } {
        assert_eq(path.root(), "/r")
    }
}

test "a function of the module under the same spelling still reaches the module" {
    assert_eq(path.path_join("/a", "b"), "/a/b")
}

test "both readings of the spelling resolve in one expression" {
    with handler Path {
        fn root() -> Str { "/r" }
    } {
        assert_eq(root_joined("x"), "/r/x")
    }
}
