// br ehn3s9 — codegen erases a list literal's element type when the leading spread source is a
// CALL, even though typecheck infers it correctly (br 08a267 fixed the typecheck half).
//
// THE CAUSE, in one line: `emit_list_lit` (src/codegen_expr.bl) recovered a leading spread's
// element with `get_list_elem_type(src_str)` / `get_list_elem_struct(src_str)` — a flat lookup
// keyed on the EMITTED C EXPRESSION STRING. That string is a variable NAME when the source is a
// variable (the flat table has an entry, so it works) and a fresh TEMP when the source is a call
// (no entry -> -1 -> the element silently defaults to Int). The axis is call-vs-variable in
// codegen, not the spread: `let a: List[Str] = [...]` + `[..a]` was already right.
//
// It is the br hgd2az / br twq9kz string-keyed hazard shape a third time, and it is the reason
// the tid collapse's Stage 3 sources element types from the producing NODE's tid memo instead of
// from a table keyed on emitted text.
//
// FAIL-OPEN MODES, each reproduced by RUNNING a program (see the doc section):
//
//   1. `let a = [..mk_strs()]`, read `a.get(0).unwrap()` — SILENT, printed `a0=94902105437782`:
//      the Str pointer as an integer.
//   2. A struct element, `d.get(0).unwrap().v` — SILENT, printed `d0=<value>`: the field read
//      lowered against an Int-erased element.
//   3. A BUILTIN method as the source, `[.."x,y".split(",")]` — SILENT, same pointer-as-integer.
//   4. `let s: Str = a.get(0).unwrap()` then `s.len()` — `error[UnresolvedMethod]: unresolved
//      method '.len' on type Str`, the codegen backstop firing on a correctly-typed Str because
//      the receiver's flat ctype was not CT_STRING.
//
// An Int element is the one shape that accidentally worked: Int IS the default the erasure falls
// back to. The row below pins it so a future change cannot "fix" the family by moving the default.

type Box { v: Int }

type Holder { xs: List[Str] }

trait Items {
    fn items(self) -> List[Str]
}

impl Items for Holder {
    fn items(self) -> List[Str] {
        self.xs
    }
}

fn mk_strs() -> List[Str] { ["ab", "cd"] }

fn mk_ints() -> List[Int] { [7, 8] }

fn mk_boxes() -> List[Box] { [Box { v: 5 }] }

fn mk_opts() -> List[Option[Str]] { [Some("ef")] }

fn mk_nested() -> List[List[Str]] { [["gh"]] }

fn mk_maps() -> List[Map[Str, Int]] {
    let mut m: Map[Str, Int] = Map()
    m.insert("k", 3)
    [m]
}

// ── The silent-wrong-value modes ─────────────────────────────────────────────────────

test "a leading spread of a call result carries the return type's element" {
    let a = [..mk_strs()]
    assert_eq(a.len(), 2)
    assert_eq(a.get(0).unwrap(), "ab")
    assert_eq(a.get(1).unwrap(), "cd")
}

test "the recovered element dispatches methods, not just prints" {
    let a = [..mk_strs()]
    let s: Str = a.get(0).unwrap()
    assert_eq(s.len(), 2)
    assert_eq(s.to_upper(), "AB")
}

test "a struct element survives the call spread" {
    let d = [..mk_boxes()]
    assert_eq(d.len(), 1)
    assert_eq(d.get(0).unwrap().v, 5)
}

test "a BUILTIN method result is a spread source too" {
    let g = [.."x,y".split(",")]
    assert_eq(g.len(), 2)
    assert_eq(g.get(0).unwrap(), "x")
    assert_eq(g.get(1).unwrap(), "y")
}

test "a TRAIT method call is a spread source too" {
    let h = Holder { xs: ["ij"] }
    let hs = [..h.items()]
    assert_eq(hs.len(), 1)
    assert_eq(hs.get(0).unwrap(), "ij")
}

// A FIELD ACCESS source already worked before the fix, which is worth a pin because it looks like
// the broken shape: `h.xs` is not a variable name either. It works because emit_expr's field-access
// path stamps the flat element onto the temp it emits (the struct's field type is known per-def),
// so the string-keyed lookup finds an entry. A CALL has no such per-def stamp — the return type
// lives only in the tid.
test "a FIELD ACCESS source was never affected" {
    let h = Holder { xs: ["mn", "op"] }
    let hs = [..h.xs]
    assert_eq(hs.len(), 2)
    assert_eq(hs.get(0).unwrap(), "mn")
}

// ── Compound elements: the same seam, one level deeper ───────────────────────────────
//
// These three read back through a CARRIER (Option), a nested container (List), and a Map. Before
// the fix each was a LOUD codegen backstop error rather than a silent wrong value —
// `error[UnresolvedMethod]: unresolved method '.unwrap' on type Option[Str]` — because the flat
// miss erased the element to Int and no dispatch arm matched the named type. They pass now
// because the element is recovered from the operand's tid, which reaches the same
// deep_tp_from_tid tree the declared path uses.

test "an Option-carrier element survives the call spread" {
    let c = [..mk_opts()]
    assert_eq(c.len(), 1)
    assert_eq(c.get(0).unwrap().unwrap(), "ef")
}

test "a nested List element survives the call spread" {
    let e = [..mk_nested()]
    assert_eq(e.len(), 1)
    assert_eq(e.get(0).unwrap().get(0).unwrap(), "gh")
}

test "a Map element survives the call spread" {
    let f = [..mk_maps()]
    assert_eq(f.len(), 1)
    assert_eq(f.get(0).unwrap().get("k").unwrap(), 3)
}

// ── Regression pins ─────────────────────────────────────────────────────────────────

test "an Int element still lands on Int" {
    let b = [..mk_ints()]
    assert_eq(b.len(), 2)
    assert_eq(b.get(0).unwrap() + 1, 8)
}

test "a VARIABLE source was never affected" {
    let a: List[Str] = ["kl", "mn"]
    let b = [..a]
    assert_eq(b.len(), 2)
    assert_eq(b.get(1).unwrap(), "mn")
}

test "a call spread in a NON-leading position takes the leading element" {
    let b = ["op", ..mk_strs()]
    assert_eq(b.len(), 3)
    assert_eq(b.get(0).unwrap(), "op")
    assert_eq(b.get(2).unwrap(), "cd")
}

test "two call spreads in a row" {
    let b = [..mk_strs(), ..mk_strs()]
    assert_eq(b.len(), 4)
    assert_eq(b.get(3).unwrap(), "cd")
}

test "a call-spread list is iterable" {
    let mut joined = ""
    for s in [..mk_strs()] {
        joined = joined.concat(s)
    }
    assert_eq(joined, "abcd")
}
