// Regression for 9jz5pa: the embedded-stdlib registry keys lib/std/*
// and lib/pkg/* into separate namespaces so a hypothetical
// `lib/std/pkg_audit.bl` cannot silently shadow `lib/pkg/audit.bl`.
//
// j5wtcx replaced the asymmetric `pkg_<base>` / `<base>` scheme with
// `<ns>/<base>`. We verify resolution survives the migration by
// importing both a std.* and a pkg.* module that share a confusable
// stem family ("audit" vs "pkg_audit" was the original collision in
// the bug report). If keys ever re-collide, one of these imports
// will resolve to the wrong source and the assertion below will fail
// to compile.

import std.libc.{POLL_EVT_IN}
import pkg.audit.{escalation_names, audit_clear}

test "std.* and pkg.* resolve to distinct embedded sources" {
    // std.libc resolves through key "std/libc"; pkg.audit through "pkg/audit".
    // Before j5wtcx the two namespaces shared a flat string keyspace and a
    // future lib/std/pkg_audit.bl would have shadowed lib/pkg/audit.bl.
    audit_clear()
    assert_eq(escalation_names.len(), 0)
    assert_eq(POLL_EVT_IN, 1)
}
