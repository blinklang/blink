// The per-module emit writes one C file per module. A file it cannot write is a failed emit,
// so it says which path and why and exits nonzero.

import std.process.{ProcessResult}

fn sh(cmd: Str) -> ProcessResult {
    process.run("sh", ["-c", cmd]).unwrap()
}

test "the per-module emit of a unit it cannot write exits nonzero and names the path" {
    let d = sh("mktemp -d /tmp/blink_emit_per_module_cannot_write.XXXXXX").out.trim()
    fs.write("{d}/main.bl", "fn main() \{\n    io.println(\"hi\")\n}\n")?
    // A directory where the unit goes: the write fails for root too.
    sh("mkdir -p {d}/out/__main__.c")
    let r = process.run("build/blink", ["__emit-per-module", "{d}/main.bl", "{d}/out"]).unwrap()
    sh("rm -rf {d}")
    let text = "{r.out}{r.err_out}"
    assert(!r.success(), "the command answered success:\n{text}")
    assert(text.contains("write {d}/out/__main__.c: "), "the error does not name the path:\n{text}")
}

test "the per-module emit of a header it cannot write exits nonzero and names the path" {
    let d = sh("mktemp -d /tmp/blink_emit_per_module_cannot_write_header.XXXXXX").out.trim()
    fs.write("{d}/main.bl", "fn main() \{\n    io.println(\"hi\")\n}\n")?
    sh("mkdir -p {d}/out/blink.types.h")
    let r = process.run("build/blink", ["__emit-per-module", "{d}/main.bl", "{d}/out"]).unwrap()
    sh("rm -rf {d}")
    let text = "{r.out}{r.err_out}"
    assert(!r.success(), "the command answered success:\n{text}")
    assert(text.contains("write {d}/out/blink.types.h: "), "the error does not name the path:\n{text}")
}
