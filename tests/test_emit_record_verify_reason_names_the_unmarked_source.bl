// When BLINK_EMIT_REUSE_VERIFY finds a unit that is not the unit a cold emit writes, the error
// says why: each source the cold emit read that the unit did not mark, or, when none is
// missing for the entry unit, that its key leaves out a fact of the whole program; and the
// first line that differs.

import emit_record

fn xs(n: Int) -> Str {
    let mut out = ""
    for _i in 0..n { out = "{out}x" }
    out
}

test "a source the cold emit read that the unit did not mark is named" {
    let r = emit_record.verify_differ_reason("leaf", ["app/src/leaf.bl"], ["app/src/leaf.bl", "app/src/base.bl"], "a\nb\nc", "a\nB\nc")
    assert_eq(r, "the cold emit read app/src/base.bl, which the unit did not mark; line 2 is `b` here and `B` in the cold emit")
}

test "the entry unit with every source marked names a fact its key leaves out" {
    let r = emit_record.verify_differ_reason("__main__", ["src/main.bl", "lib/std/list.bl"], ["src/main.bl"], "x\ny", "x\ny\nz")
    assert_eq(r, "every source the cold emit read is marked, so the entry key leaves out a fact of the whole program that differs; line 3 is past the end here and `z` in the cold emit")
}

test "another unit with every source marked says only that" {
    let r = emit_record.verify_differ_reason("leaf", ["app/src/leaf.bl"], ["app/src/leaf.bl"], "q", "r")
    assert_eq(r, "every source the cold emit read is marked; line 1 is `q` here and `r` in the cold emit")
}

test "a long line is cut" {
    let long = xs(200)
    let r = emit_record.verify_differ_reason("leaf", [], [], long, "y")
    assert_eq(r, "every source the cold emit read is marked; line 1 is `{xs(120)}...` here and `y` in the cold emit")
}
