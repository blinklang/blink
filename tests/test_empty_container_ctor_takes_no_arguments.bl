// An empty container's constructor takes no arguments: `Map()`, `Set()`, `Map.new()` and
// `Set.new()` build a container with nothing in it, with or without type arguments in
// brackets. A written argument is refused at the front end, never dropped.

import compile_test_helpers

fn expect_no_arguments(src: Str, tag: Str) {
    let out = compile_test_helpers.compile_and_capture(src, tag)
    compile_test_helpers.expect_error(out, "\"code\":\"E0300\"", tag)
    compile_test_helpers.expect_contains(out, "takes no arguments, got 1", tag)
    assert(!out.contains("\"code\":\"E0307\""))
    assert(!out.contains("\"severity\":\"ice\""))
}

test "Map given an argument is refused" {
    expect_no_arguments(#"fn main() {
    let m: Map[Str, Int] = Map(5)
    io.println("{m.len()}")
}
"#, "_empty_ctor_map_bare")
}

test "Set given an argument is refused" {
    expect_no_arguments(#"fn main() {
    let s: Set[Int] = Set(5)
    io.println("{s.len()}")
}
"#, "_empty_ctor_set_bare")
}

test "Map.new given an argument is refused" {
    expect_no_arguments(#"fn main() {
    let m: Map[Str, Int] = Map.new(5)
    io.println("{m.len()}")
}
"#, "_empty_ctor_map_new")
}

test "Set.new given an argument is refused" {
    expect_no_arguments(#"fn main() {
    let s: Set[Int] = Set.new(5)
    io.println("{s.len()}")
}
"#, "_empty_ctor_set_new")
}

test "Map with type arguments given an argument is refused" {
    expect_no_arguments(#"fn main() {
    let m = Map[Str, Int](5)
    io.println("{m.len()}")
}
"#, "_empty_ctor_map_brackets")
}

test "Set with a type argument given an argument is refused" {
    expect_no_arguments(#"fn main() {
    let s = Set[Int](5)
    io.println("{s.len()}")
}
"#, "_empty_ctor_set_brackets")
}

test "Map.new with type arguments given an argument is refused" {
    expect_no_arguments(#"fn main() {
    let m = Map.new[Str, Int](5)
    io.println("{m.len()}")
}
"#, "_empty_ctor_map_new_brackets")
}

test "Set.new with a type argument given an argument is refused" {
    expect_no_arguments(#"fn main() {
    let s = Set.new[Int](5)
    io.println("{s.len()}")
}
"#, "_empty_ctor_set_new_brackets")
}

test "List.new given an argument is refused with the same message" {
    expect_no_arguments(#"fn main() {
    let l: List[Int] = List.new(5)
    io.println("{l.len()}")
}
"#, "_empty_ctor_list_new")
}
