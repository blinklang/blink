// A fn with @ensures that returns a struct must spell the postcondition's
// return-value temp with the struct's C type, not `void`, so `.field` reads
// on the temp and the final return both type-check.

import compile_test_helpers.{compile_and_run}

test "an @ensures fn returning a struct keeps the struct type on the return temp" {
    let src = #"
type Point { x: Int, y: Int }

@ensures(result.x == 1)
@verify(fallback: "runtime")
fn mk() -> Point { return Point { x: 1, y: 2 } }

fn main() ! IO {
    let p = mk()
    io.println("{p.x}")
}
"#
    let r = compile_and_run(src, "_ensures_struct_return_temp_keeps_struct_type")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "1\n")
}
