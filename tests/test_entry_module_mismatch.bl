// Tests E1008 InvalidModuleAnnotation on the package entry file:
// when src/<pkg>.bl declares @module(X) where X != [package].name, reject.

import compile_test_helpers

fn main() {
    let base = "{compile_test_helpers.scratch_root()}/_test_entry_module_mismatch"
    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
    let blink = "{env.cwd()}/build/blink"

    process.run("sh", ["-c", "mkdir -p {base}/mismatchlib/src"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {base}/app/src"]).unwrap()
    // [package].name = "mismatchlib" but @module says "wrong"
    fs.write("{base}/mismatchlib/blink.toml", "[package]\nname = \"mismatchlib\"\nversion = \"0.1.0\"\n").unwrap()
    fs.write("{base}/mismatchlib/src/mismatchlib.bl", "@module(\"wrong\")\n\npub fn hi() -> Str \{\n    \"hi\"\n}\n").unwrap()

    fs.write("{base}/app/blink.toml", "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\nmismatchlib = \{ path = \"../mismatchlib\" \}\n").unwrap()
    fs.write("{base}/app/src/main.bl", "import mismatchlib.\{hi\}\n\nfn main() \{\n    io.println(hi())\n}\n").unwrap()

    process.run("sh", ["-c", "cd {base}/app && {blink} build src/main.bl -o build/app > err.txt 2>&1; true"]).unwrap()
    let err = fs.read("{base}/app/err.txt").unwrap()
    if err.contains("InvalidModuleAnnotation") {
        io.println("PASS: entry-file @module mismatch with [package].name emits InvalidModuleAnnotation/E1008")
    } else {
        io.println("FAIL: expected InvalidModuleAnnotation for entry-file @module mismatch, got: {err}")
    }

    // --- Test 2: matching @module on entry is accepted ---
    let base2 = "{compile_test_helpers.scratch_root()}/_test_entry_module_match"
    process.run("sh", ["-c", "rm -rf {base2}"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {base2}/matchlib/src"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {base2}/app/src"]).unwrap()
    fs.write("{base2}/matchlib/blink.toml", "[package]\nname = \"matchlib\"\nversion = \"0.1.0\"\n").unwrap()
    fs.write("{base2}/matchlib/src/matchlib.bl", "@module(\"matchlib\")\n\npub fn hi() -> Str \{\n    \"hello-match\"\n}\n").unwrap()

    fs.write("{base2}/app/blink.toml", "[package]\nname = \"app\"\nversion = \"0.1.0\"\n\n[dependencies]\nmatchlib = \{ path = \"../matchlib\" \}\n").unwrap()
    fs.write("{base2}/app/src/main.bl", "import matchlib.\{hi\}\n\nfn main() \{\n    io.println(hi())\n}\n").unwrap()

    process.run("sh", ["-c", "cd {base2}/app && {blink} build src/main.bl -o build/app > err.txt 2>&1; true"]).unwrap()
    let err2 = fs.read("{base2}/app/err.txt").unwrap()
    if err2.contains("InvalidModuleAnnotation") {
        io.println("FAIL: matching entry @module should not emit InvalidModuleAnnotation, got: {err2}")
    } else {
        io.println("PASS: matching entry @module accepted")
    }

    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
    process.run("sh", ["-c", "rm -rf {base2}"]).unwrap()
}
