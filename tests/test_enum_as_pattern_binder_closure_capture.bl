// A data-enum whole-value binder introduced by an as-pattern, captured by a
// closure, keeps its aggregate layout through the closure capture and can be
// matched again inside the closure body.

type Shape {
    Circle(Int)
    Square(Int)
}
type Nested {
    Inner(Shape)
    Other(Int)
}

test "as-pattern enum binder survives closure capture" {
    let n = Nested.Inner(Shape.Square(8))
    let g = match n {
        Nested.Inner(s as Shape) => fn() -> Int {
            match s { Shape.Circle(x) => x  Shape.Square(y) => y }
        }
        Nested.Other(k) => fn() -> Int { k }
    }
    assert_eq(g(), 8)
}
