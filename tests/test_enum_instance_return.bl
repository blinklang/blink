// br 82ajft item 3: a concrete fn RETURNING a generic-enum INSTANCE (`-> Tree[Int]`)
// now lowers to the mono carrier (blink_Tree_Int), not the erased bare blink_Tree.
//
// Before, fn_enum_rets stored the bare return head ("Tree") and every fn-signature
// emit site consulted it first (`c_type_from_tag("Tree")` → bare blink_Tree), so the
// return type, the call-site `_sr` temp, and the `let t = make_leaf()` binding all
// erased — the subsequent `leaf_value(t)` got a type mismatch against blink_Tree_Int.
//
// Seams closed (mirroring the ns7qdm generic-struct-return path):
//   - tc_fnsig_param_instance_tid widened to TK_ENUM (make_enum_instance_type) so the
//     return annotation re-interns as a structural Tree[Int] instance.
//   - the fn-signature emit sites (emit_fn_decl / emit_fn_def / impl-method) spell the
//     mono stem via tc_tid_struct_mono_name off the return-annotation tid.
//   - codegen.bl's data-enum-return registration stores the mono stem (Tree_Int) as the
//     struct-ret (feeds the call-site temp + let binding); fn_enum_rets stays BARE for
//     value-typing / variant lookups.

type Tree[T] {
    Leaf(value: T)
    Branch(left: Tree[T], right: Tree[T])
}

fn make_leaf() -> Tree[Int] {
    Leaf(42)
}

fn leaf_value(t: Tree[Int]) -> Int {
    match t {
        Leaf(v) => return v
        Branch(_l, _r) => return 0
    }
}

test "concrete fn returning a generic-enum instance Tree[Int]" {
    let t = make_leaf()
    assert_eq(leaf_value(t), 42)
}

// Bare-typevar `-> T` bound to an enum instance rides the existing reroute set
// (no extension needed — verified: identity(t: Tree[Int]) threads blink_Tree_Int).
fn identity[T](x: T) -> T {
    x
}

test "bare-typevar return over a generic-enum instance" {
    let t: Tree[Int] = Leaf(7)
    let u = identity(t)
    assert_eq(leaf_value(u), 7)
}
