// A MONOMORPHIC enum whose variant payload is a by-value carrier (`Option[P]`) must emit that
// carrier typedef BEFORE the enum typedef that embeds it. Here the payload VALUE comes from
// `ps.get(0)` (an `Option[P]` temp), not a `Some(..)` literal — a second shape for the same
// enum-typedef carrier-ordering fix that test_44x9qw covers with literals. The payload value
// itself infers fine; the bug was purely the typedef emit ORDER (the enum branch lacked the
// per-type field-carrier pre-flush the struct branch has), so codegen referenced the not-yet-
// emitted `blink_Option_P`.

import compile_test_helpers

fn src_structlit() -> Str {
    #"import std.io

type P { x: Int, y: Int }

type E {
    V { p: Option[P] }
}

fn main() {
    let ps = [P { x: 1, y: 2 }]
    let e = E.V { p: ps.get(0) }
    match e {
        E.V { p } => {
            match p {
                Some(v) => io.println("x={v.x} y={v.y}")
                None => io.println("none")
            }
        }
    }
}
"#
}

fn src_ctor() -> Str {
    #"import std.io

type P { x: Int, y: Int }

type E { V(Option[P]) }

fn main() {
    let ps = [P { x: 1, y: 2 }]
    let e = E.V(ps.get(0))
    match e {
        E.V(p) => {
            match p {
                Some(v) => io.println("x={v.x} y={v.y}")
                None => io.println("none")
            }
        }
    }
}
"#
}

test "mono enum struct-literal payload value mints its Option[struct] carrier typedef" {
    let r = compile_test_helpers.compile_and_run(src_structlit(), "9ewta2_enum_structlit_payload")
    if !r.out.contains("x=1 y=2") {
        compile_test_helpers.expect_contains(r.out, "x=1 y=2", "mono enum structlit payload — got '{r.err_out}'")
    }
    assert(r.out.contains("x=1 y=2"))
    assert_eq(r.exit_code, 0)
}

test "mono enum ctor payload value mints its Option[struct] carrier typedef" {
    let r = compile_test_helpers.compile_and_run(src_ctor(), "9ewta2_enum_ctor_payload")
    if !r.out.contains("x=1 y=2") {
        compile_test_helpers.expect_contains(r.out, "x=1 y=2", "mono enum ctor payload — got '{r.err_out}'")
    }
    assert(r.out.contains("x=1 y=2"))
    assert_eq(r.exit_code, 0)
}
