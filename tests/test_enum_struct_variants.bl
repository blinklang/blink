// Tests for struct-style enum variant declaration, construction, and matching.
// Bug: parser/typecheck did not support `Variant { field: Type }` syntax.

type Shape {
    Circle(radius: Float)
    Rect { width: Float, height: Float }
    Point
}

fn describe(s: Shape) -> Str {
    match s {
        Shape.Circle(r) => "circle:{r}"
        Shape.Rect { width, height } => "rect:{width}x{height}"
        Shape.Point => "point"
    }
}

type Msg {
    Simple(text: Str)
    Rich { code: Int, message: Str }
}

fn format_msg(m: Msg) -> Str {
    match m {
        Msg.Simple(t) => t
        Msg.Rich { code, message } => "{code}: {message}"
    }
}

test "struct variant construction and match" {
    let r = Shape.Rect { width: 3.0, height: 4.0 }
    assert_eq(describe(r), "rect:3x4")
}

test "tuple variant still works alongside struct variant" {
    let c = Shape.Circle(5.0)
    assert_eq(describe(c), "circle:5")
}

test "unit variant still works alongside struct variant" {
    let p = Shape.Point
    assert_eq(describe(p), "point")
}

test "struct variant with Str and Int fields" {
    let m = Msg.Rich { code: 42, message: "hello" }
    assert_eq(format_msg(m), "42: hello")
}

test "tuple variant alongside struct variant (Msg)" {
    let m = Msg.Simple("world")
    assert_eq(format_msg(m), "world")
}

// ── Bare struct-style variant construction (wzhx8z) ──────────────────

type QueryError {
    NotFound { msg: Str }
    Timeout { seconds: Int }
}

fn describe_qe(e: QueryError) -> Str {
    match e {
        NotFound { msg } => "notfound:{msg}"
        Timeout { seconds } => "timeout:{seconds}"
    }
}

// #1 bare construction (let) resolves to the variant, no UnknownType.
test "bare struct-style variant construction (unique)" {
    let e = NotFound { msg: "x" }
    assert_eq(describe_qe(e), "notfound:x")
}

// #2 hint via binding annotation (shared name disambiguated by annotation).
test "bare construction hint via binding annotation" {
    let e: QueryError = NotFound { msg: "ann" }
    assert_eq(describe_qe(e), "notfound:ann")
}

// #3 hint via return type.
fn make_qe() -> QueryError {
    return NotFound { msg: "ret" }
}

test "bare construction hint via return type" {
    assert_eq(describe_qe(make_qe()), "notfound:ret")
}

// #4 hint via fn-arg param.
fn take_qe(e: QueryError) -> Str {
    describe_qe(e)
}

test "bare construction hint via fn-arg param" {
    assert_eq(take_qe(NotFound { msg: "arg" }), "notfound:arg")
}

// #5 hint via struct-field position (enum-typed field).
type QeHolder {
    err: QueryError
}

test "bare construction hint via struct field" {
    let h = QeHolder { err: NotFound { msg: "field" } }
    assert_eq(describe_qe(h.err), "notfound:field")
}

// #6 carrier: Err(NotFound {..}) with Result[T, QueryError] return.
fn fallible() -> Result[Int, QueryError] {
    return Err(NotFound { msg: "carrier" })
}

test "bare construction via Err carrier" {
    match fallible() {
        Ok(_) => assert(false)
        Err(e) => assert_eq(describe_qe(e), "notfound:carrier")
    }
}

// #7 Kind B legal, no hint, unique variant → no error, resolves.
type SoleState {
    OnlyHere { tag: Int }
}

test "bare construction unique variant no hint" {
    let s = OnlyHere { tag: 9 }
    match s {
        OnlyHere { tag } => assert_eq(tag, 9)
    }
}
