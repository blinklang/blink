// `.to_int()` answers an enum value's tag (section 3, "Enums Are Nominally Distinct from Int").
// The spec gives no way to write a tag, so a variant's tag is its place in the declaration,
// counted from 0. A payload moves the tag into a member of the value and a one-variant newtype
// is its payload alone, but the answer is the same place in the declaration for all three.

type Latch { Open Shut Done }

type Shape {
    Dot
    Circle { r: Int }
    Rect { w: Int, h: Int }
}

type Code { Code(Int) }

fn shape_at(i: Int) -> Shape {
    if i == 0 { return Shape.Dot }
    if i == 1 { return Shape.Circle(r: 3) }
    Shape.Rect(w: 2, h: 4)
}

test "a unit variant answers its place in the declaration" {
    assert_eq(Latch.Open.to_int(), 0)
    assert_eq(Latch.Shut.to_int(), 1)
    assert_eq(Latch.Done.to_int(), 2)
}

test "a unit enum held in a binding answers the same" {
    let latch = Latch.Done
    let n: Int = latch.to_int()
    assert_eq(n + 1, 3)
}

test "a payload enum answers the tag of the variant it holds" {
    assert_eq(shape_at(0).to_int(), 0)
    assert_eq(shape_at(1).to_int(), 1)
    assert_eq(shape_at(2).to_int(), 2)
}

test "a unit variant of a payload enum answers its place too" {
    assert_eq(Shape.Dot.to_int(), 0)
}

test "a one-variant newtype answers 0, not its payload" {
    assert_eq(Code(5).to_int(), 0)
}

test "the tags of one enum tell its variants apart" {
    let tags = [Latch.Open.to_int(), Latch.Shut.to_int(), Latch.Done.to_int()]
    assert_eq(tags.len(), 3)
    assert(tags.get(0).unwrap() != tags.get(2).unwrap())
}
