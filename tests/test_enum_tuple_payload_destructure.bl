// Destructuring an enum variant Tuple payload with a nested tuple sub-pattern must
// bind each element, not panic. The variant-field recursion pushed a single
// whole-tuple match_scruts entry, but the TuplePattern arm indexes one entry per
// element (scrut_off + j), so element 1+ unwrapped a None -> compiler panic.
// The fix expands the tuple field into per-element scruts before recursing, the
// same way the top-level tuple-scrutinee fast path does.

import compile_test_helpers

fn src_positional_destructure() -> Str {
    #"import std.io

type P { x: Int, y: Int }

type E { V((P, P)) }

fn main() {
    let e = E.V((P { x: 7, y: 8 }, P { x: 9, y: 10 }))
    match e {
        E.V((a, b)) => io.println("a={a.x} b={b.y}")
    }
}
"#
}

fn src_structlit_destructure() -> Str {
    #"import std.io

type P { x: Int, y: Int }

type F {
    V { pair: (P, P) }
}

fn main() {
    let f = F.V { pair: (P { x: 1, y: 2 }, P { x: 3, y: 4 }) }
    match f {
        F.V { pair: (a, b) } => io.println("a={a.x} b={b.y}")
    }
}
"#
}

fn src_scalar_tuple_destructure() -> Str {
    #"import std.io

type E { V((Int, Int)) }

fn main() {
    let e = E.V((3, 4))
    match e {
        E.V((a, b)) => io.println("sum={a + b}")
    }
}
"#
}

test "enum positional Tuple payload destructures into element bindings" {
    let r = compile_test_helpers.compile_and_run(src_positional_destructure(), "hqwx7k_pos")
    if !r.out.contains("a=7 b=10") {
        compile_test_helpers.expect_contains(r.out, "a=7 b=10", "positional tuple destructure — got '{r.err_out}'")
    }
    assert(r.out.contains("a=7 b=10"))
    assert_eq(r.exit_code, 0)
}

test "enum struct-literal Tuple payload destructures into element bindings" {
    let r = compile_test_helpers.compile_and_run(src_structlit_destructure(), "hqwx7k_struct")
    if !r.out.contains("a=1 b=4") {
        compile_test_helpers.expect_contains(r.out, "a=1 b=4", "structlit tuple destructure — got '{r.err_out}'")
    }
    assert(r.out.contains("a=1 b=4"))
    assert_eq(r.exit_code, 0)
}

test "enum scalar Tuple payload destructures into element bindings" {
    let r = compile_test_helpers.compile_and_run(src_scalar_tuple_destructure(), "hqwx7k_scalar")
    if !r.out.contains("sum=7") {
        compile_test_helpers.expect_contains(r.out, "sum=7", "scalar tuple destructure — got '{r.err_out}'")
    }
    assert(r.out.contains("sum=7"))
    assert_eq(r.exit_code, 0)
}
