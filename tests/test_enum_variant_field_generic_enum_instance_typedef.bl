// An enum variant field whose type is a generic-enum instance (Pair[Int]) must
// keep its mono instance name (blink_Pair_0Int) in the variant's typedef, not the
// bare unmangled base (blink_Pair), while construction correctly builds the full
// instance. No match/binder is needed to trigger this: it is a pure typedef +
// construction bug.

import compile_test_helpers.{compile_and_run}

test.failing(
    "an enum variant field of a generic-enum instance type keeps its mono name in the typedef",
    reason: "the enum variant-field typedef speller drops the generic instance args for a field like Pair[Int], emitting the bare unmangled name blink_Pair (never typedef'd) instead of blink_Pair_0Int, while construction correctly builds the full mono instance, so cc fails on the mismatch",
    ticket: "p45k15",
) {
    let src = #"
import std.io

type Pair[T] { Both(T, T), One(T) }
type Boxed { Hold(Pair[Int]), Empty }

fn main() ! IO {
    let b = Boxed.Hold(Pair.One(9))
    match b {
        Hold(p) => match p {
            One(v) => io.println("one {v}")
            Both(a, c) => io.println("both {a} {c}")
        }
        Empty => io.println("empty")
    }
}
"#
    let r = compile_and_run(src, "_enum_variant_field_generic_enum_instance_typedef")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "one 9\n")
}
