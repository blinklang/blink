// br 44xww4: enumerate()/zip() return genuine (Int, T) / (T, U) tuples
// (spec §3.8 + §3c). Pairs materialize as Tuple2 structs so per-slot compound
// metadata, .0/.1 field access, and for (i,x) destructuring all work — including
// over a List of pointer-boxed Option/Result elements (the z9gkt3 follow-up).

test "enumerate scalar list yields tuple pairs via .0/.1" {
    let mut a: List[Int] = []
    a.push(10)
    a.push(20)
    a.push(30)

    let e = a.enumerate()
    assert_eq(e.len(), 3)

    let p0 = e.get(0).unwrap()
    assert_eq(p0.0, 0)
    assert_eq(p0.1, 10)

    let p2 = e.get(2).unwrap()
    assert_eq(p2.0, 2)
    assert_eq(p2.1, 30)
}

test "enumerate scalar list destructures with for (i, x)" {
    let mut a: List[Int] = []
    a.push(5)
    a.push(6)
    a.push(7)

    let mut idx_sum = 0
    let mut val_sum = 0
    for (i, x) in a.enumerate() {
        idx_sum = idx_sum + i
        val_sum = val_sum + x
    }
    assert_eq(idx_sum, 3)
    assert_eq(val_sum, 18)
}

test "zip scalar lists yields tuple pairs via .0/.1" {
    let mut x: List[Int] = []
    x.push(1)
    x.push(2)
    x.push(3)

    let mut y: List[Int] = []
    y.push(100)
    y.push(200)
    y.push(300)

    let z = x.zip(y)
    assert_eq(z.len(), 3)

    let zp1 = z.get(1).unwrap()
    assert_eq(zp1.0, 2)
    assert_eq(zp1.1, 200)
}

test "zip scalar lists destructures with for (a, b)" {
    let mut x: List[Int] = []
    x.push(1)
    x.push(2)

    let mut y: List[Int] = []
    y.push(10)
    y.push(20)

    let mut dot = 0
    for (a, b) in x.zip(y) {
        dot = dot + a * b
    }
    assert_eq(dot, 50)
}

// The compound sources below use LIST LITERALS, not .push(): iter_from_source
// only detects a List[compound] carrier through the nested-tp convention that a
// list literal / annotation stamps, not the struct-tag convention a push-built
// list records (elem_struct="Option_int", elem_type=CT_VOID). That gap is
// pre-existing and shared by EVERY compound HOF (map/filter/take/collect alike),
// not specific to enumerate/zip — tracked separately (see br). The z9gkt3/j0cdey
// suites use list literals for the same reason.

test "enumerate over List[Option[Int]] recovers compound via .1" {
    let xs: List[Option[Int]] = [Some(7), None, Some(9)]

    let e = xs.enumerate()
    assert_eq(e.len(), 3)

    let p0 = e.get(0).unwrap()
    assert_eq(p0.0, 0)
    assert_eq(p0.1.is_some(), true)
    assert_eq(p0.1.unwrap(), 7)

    let p1 = e.get(1).unwrap()
    assert_eq(p1.0, 1)
    assert_eq(p1.1.is_none(), true)

    let p2 = e.get(2).unwrap()
    assert_eq(p2.1.unwrap(), 9)
}

test "enumerate over List[Option[Int]] destructures for (i, x)" {
    let xs: List[Option[Int]] = [Some(4), None, Some(6)]

    let mut present = 0
    let mut total = 0
    for (i, x) in xs.enumerate() {
        if x.is_some() {
            present = present + 1
            total = total + x.unwrap() + i
        }
    }
    assert_eq(present, 2)
    assert_eq(total, 12)
}

test "zip over List[Option[Int]] recovers compound via .0/.1" {
    let xs: List[Option[Int]] = [Some(1), None]
    let ys: List[Option[Int]] = [Some(10), Some(20)]

    let z = xs.zip(ys)
    assert_eq(z.len(), 2)

    let zp0 = z.get(0).unwrap()
    assert_eq(zp0.0.unwrap(), 1)
    assert_eq(zp0.1.unwrap(), 10)

    let zp1 = z.get(1).unwrap()
    assert_eq(zp1.0.is_none(), true)
    assert_eq(zp1.1.unwrap(), 20)
}

test "enumerate over List[Result[Int, Str]] recovers compound via .1" {
    let rs: List[Result[Int, Str]] = [Ok(42), Err("boom")]

    let e = rs.enumerate()
    assert_eq(e.len(), 2)

    let p0 = e.get(0).unwrap()
    assert_eq(p0.0, 0)
    assert_eq(p0.1.is_ok(), true)
    assert_eq(p0.1.unwrap(), 42)

    let p1 = e.get(1).unwrap()
    assert_eq(p1.0, 1)
    assert_eq(p1.1.is_err(), true)
}

test "zip over List[Result[Int, Str]] recovers compound via .0/.1" {
    let rs: List[Result[Int, Str]] = [Ok(3), Err("x")]
    let ss: List[Result[Int, Str]] = [Ok(5), Ok(6)]

    let z = rs.zip(ss)
    assert_eq(z.len(), 2)

    let zp0 = z.get(0).unwrap()
    assert_eq(zp0.0.unwrap(), 3)
    assert_eq(zp0.1.unwrap(), 5)

    let zp1 = z.get(1).unwrap()
    assert_eq(zp1.0.is_err(), true)
    assert_eq(zp1.1.unwrap(), 6)
}
