// enumerate/zip must type as List[(Int,T)] / List[(T,U)] (spec §3c:98,102), not
// the TYPE_UNKNOWN they memoized as before an arm existed in the List method-typing
// block. Without a precise type the tuple carrier could not be recovered from the
// node tid — a downstream `.get().unwrap()` fell back to the flat sname. A wrong
// annotation on the result now surfaces a real TypeError instead of unifying
// vacuously with Unknown. Same tid-completeness family as filter/take/skip/chain.

import compile_test_helpers

fn src_wrong_enumerate_annotation() -> Str {
    #"import std.io

fn main() {
    let a: List[Int] = [10, 20, 30]
    let bad: List[Int] = a.enumerate().collect()
    io.println("{bad.len()}")
}
"#
}

test "a wrong annotation on an enumerate result is a type error" {
    // enumerate yields (Int, Int) pairs, so List[Int] must not unify with the result.
    compile_test_helpers.expect_compile_error(src_wrong_enumerate_annotation(), "enum_wrong_ann", "but got List[(Int, Int)]")
}

fn src_wrong_zip_annotation() -> Str {
    #"import std.io

fn main() {
    let a: List[Int] = [1, 2, 3]
    let b: List[Str] = ["x", "y", "z"]
    let bad: List[Int] = a.zip(b).collect()
    io.println("{bad.len()}")
}
"#
}

test "a wrong annotation on a zip result is a type error" {
    compile_test_helpers.expect_compile_error(src_wrong_zip_annotation(), "zip_wrong_ann", "but got List[(Int, Str)]")
}

test "enumerate and zip flow through their precise tuple-list types" {
    let a: List[Int] = [10, 20, 30]
    let pairs: List[(Int, Int)] = a.enumerate().collect()
    assert_eq(pairs.len(), 3)
    assert_eq(pairs.get(0).unwrap().0, 0)
    assert_eq(pairs.get(2).unwrap().1, 30)

    let b: List[Str] = ["p", "q", "r"]
    let zipped: List[(Int, Str)] = a.zip(b).collect()
    assert_eq(zipped.len(), 3)
    assert_eq(zipped.get(1).unwrap().0, 20)
    assert_eq(zipped.get(1).unwrap().1, "q")
}
