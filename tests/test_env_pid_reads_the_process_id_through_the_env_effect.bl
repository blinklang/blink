// `env.pid() -> Int` is an operation of `Env.Read` (sections/04_effects.md §4.4.3). The real
// handler answers the operating-system process ID, and a user `Env` handler answers the op
// from its own state. `Env` is not marked `@handle_all`, so a handler that omits `pid`
// delegates to the enclosing handler with no warning (§4.7.1).

import compile_test_helpers

fn pid_src() -> Str {
    #"
fn fixed(n: Int) -> Handler[Env] {
    handler Env {
        fn pid() -> Int { n }
    }
}

fn cwd_only() -> Handler[Env] {
    handler Env {
        fn cwd() -> Str { "/mock" }
    }
}

fn reading() -> Int ! Env.Read {
    env.pid()
}

fn main() {
    io.println("real: positive: {env.pid() > 0}")
    io.println("real: same as the OS: {env.pid() == getpid()}")
    io.println("real: stable: {env.pid() == env.pid()}")
    with cwd_only() {
        io.println("omitted at top: {env.pid() == getpid()}")
    }
    with handler Env {
        fn pid() -> Int { 4242 }
    } {
        io.println("handler: {env.pid()}")
        with cwd_only() {
            io.println("omitted: {env.pid()}")
        }
        with fixed(7) {
            io.println("captured: {env.pid()}")
        }
        io.println("through a fn: {reading()}")
    }
}
"#
}

fn expect_pid_output(out: Str) {
    assert(out.contains("real: positive: true\n"))
    assert(out.contains("real: same as the OS: true\n"))
    assert(out.contains("real: stable: true\n"))
    assert(out.contains("omitted at top: true\n"))
    assert(out.contains("handler: 4242\n"))
    assert(out.contains("omitted: 4242\n"))
    assert(out.contains("captured: 7\n"))
    assert(out.contains("through a fn: 4242\n"))
}

test "env.pid reads the real process ID and the installed Env handler" {
    let r = compile_test_helpers.compile_and_run(pid_src(), "env_pid_handler")
    if r.exit_code != 0 { io.eprintln(r.err_out) }
    assert_eq(r.exit_code, 0)
    expect_pid_output(r.out)
}

test "env.pid gives the same answers under --per-module" {
    let r = compile_test_helpers.run_via_cli(pid_src(), "env_pid_per_module", "--per-module")
    if r.exit_code != 0 { io.eprintln(r.err_out) }
    assert_eq(r.exit_code, 0)
    expect_pid_output(r.out)
}

test "env.pid takes no argument" {
    let out = compile_test_helpers.compile_and_capture(#"
fn main() {
    let p = env.pid(1)
}
"#, "env_pid_arity")
    compile_test_helpers.expect_contains(out, "function `env.pid` expects 0 argument(s), got 1", "env.pid arity")
}

test "an env.pid reading is an Int" {
    let out = compile_test_helpers.compile_and_capture(#"
fn main() {
    let s: Str = env.pid()
}
"#, "env_pid_is_int")
    compile_test_helpers.expect_contains(out, "declared type Str but got Int", "env.pid is an Int")
}
