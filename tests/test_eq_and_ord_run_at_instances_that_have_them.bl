// A derive on a generic type holds only at the instances whose arguments have the trait, and
// a written impl holds where its own bounds do (sections/03_types.md, *Generic Type Bound
// Inference*). A program may still hold a value of an instance where the derive does not
// hold, so long as it never asks for the trait there. Each row here must build and run.

type Widget { id: Int }

@derive(Eq)
type Box[T] { v: T }

@derive(Ord)
type Rank[T] { v: T }

@derive(Hash)
type Keyed[T] { v: T }

@derive(Debug)
type Shown[T] { v: T }

@derive(Eq)
type Tag[T] { id: Int }

type Holder[T] { v: T }

impl[T] Eq for Holder[T] {
    fn eq(self, other: Holder[T]) -> Bool { true }
}

type Bounded[T] { v: T }

impl[T: Eq] Eq for Bounded[T] {
    fn eq(self, other: Bounded[T]) -> Bool { self.v == other.v }
}

type Guarded[T] { v: T }

impl[T] Eq for Guarded[T] where T: Eq {
    fn eq(self, other: Guarded[T]) -> Bool { self.v == other.v }
}

@derive(Eq)
type Shelf { h: Holder[Int] }

fn same[T: Eq](a: T, b: T) -> Bool { a == b }

fn less[T: Ord](a: T, b: T) -> Bool { a < b }

test "an unbounded written Eq impl on a generic type runs through ==" {
    let a = Holder { v: Widget { id: 1 } }
    let b = Holder { v: Widget { id: 2 } }
    assert(a == b)
    assert(!(a != b))
    assert(same(a, b))
}

test "an unbounded written Eq impl runs at more than one instance" {
    assert(Holder { v: 1 } == Holder { v: 2 })
    assert(Holder { v: "a" } == Holder { v: "b" })
}

test "a written Eq impl on a generic type runs inside a list and a derived struct" {
    let xs = [Holder { v: 1 }]
    let ys = [Holder { v: 2 }]
    assert(xs == ys)
    assert(Shelf { h: Holder { v: 1 } } == Shelf { h: Holder { v: 9 } })
}

test "a written Eq impl with a binder bound runs where the bound holds" {
    assert(Bounded { v: 1 } == Bounded { v: 1 })
    assert(Bounded { v: 1 } != Bounded { v: 2 })
    assert(same(Bounded { v: "a" }, Bounded { v: "a" }))
}

test "a written Eq impl with a where bound runs where the bound holds" {
    assert(Guarded { v: 1 } == Guarded { v: 1 })
    assert(Guarded { v: 1 } != Guarded { v: 2 })
}

test "a derived Eq or Ord instance runs where its arguments have the trait" {
    assert(same(Box { v: 1 }, Box { v: 1 }))
    assert(!same(Box { v: Box { v: 1 } }, Box { v: Box { v: 2 } }))
    assert(less(Rank { v: 1 }, Rank { v: 2 }))
    assert(Rank { v: 1 } < Rank { v: 2 })
    let xs = [Rank { v: 3 }, Rank { v: 1 }, Rank { v: 2 }].sort()
    assert(xs.get(0).unwrap().v == 1)
}

test "a phantom parameter adds no bound" {
    let a: Tag[Widget] = Tag { id: 1 }
    let b: Tag[Widget] = Tag { id: 1 }
    assert(a == b)
    assert(same(a, b))
}

test "a value of an instance where the derive does not hold is fine when the trait is never asked for" {
    let b = Box { v: Widget { id: 1 } }
    let r = Rank { v: Widget { id: 2 } }
    let k = Keyed { v: Widget { id: 3 } }
    let s = Shown { v: Widget { id: 4 } }
    assert(b.v.id + r.v.id + k.v.id + s.v.id == 10)
}
