// Deriving Hash auto-derives its supertrait Eq (§3.6.1 *Supertrait Auto-Derivation*), so `==`
// on a type that names only Hash compares its fields.

@derive(Hash)
type P { x: Int  y: Int }

@derive(Hash)
type Shape { Dot(p: P)  Empty }

test "== on a struct that derives only Hash compares its fields" {
    assert(P { x: 1, y: 2 } == P { x: 1, y: 2 })
    assert(P { x: 1, y: 2 } != P { x: 1, y: 3 })
}

test "== on an enum that derives only Hash compares its payloads" {
    assert(Shape.Dot(P { x: 1, y: 2 }) == Shape.Dot(P { x: 1, y: 2 }))
    assert(Shape.Dot(P { x: 1, y: 2 }) != Shape.Dot(P { x: 2, y: 2 }))
    assert(Shape.Dot(P { x: 1, y: 2 }) != Shape.Empty)
}

test "a Map keyed by a type that derives only Hash finds an equal key" {
    let mut m: Map[P, Int] = Map.new()
    m.insert(P { x: 1, y: 2 }, 7)
    assert_eq(m.get(P { x: 1, y: 2 }), Some(7))
    assert_eq(m.get(P { x: 2, y: 2 }), None)
}
