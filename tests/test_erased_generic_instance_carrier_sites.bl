// A compound carrier (Option/Result) over a generic-struct INSTANCE whose inner
// is never constructed as a value: the tid erases the instance to its bare head
// (blink_Option_Inner), dropping the mono stem the flat channel still carries
// (Inner_0Int). Every carrier-spelling site — the let-binding declaration and
// the match scrutinee, for both Option and Result — must keep the flat mono
// stem for this non-compound shape, leading with the tid only for a compound
// inner. Regression guard for the let-decl and Option-match sites, which led
// with the erased tid and failed to compile the emitted C.

type Inner[T] { v: T }
type OB[T] { o: Option[Inner[T]] }
type RB[T] { r: Result[Inner[T], Str] }

test "let-then-match of an erased Option[Inner[Int]]" {
    let b: OB[Int] = OB { o: None }
    let o = b.o
    let got = match o {
        Some(w) => w.v
        None => 111
    }
    assert_eq(got, 111)
}

test "direct match of an erased Option[Inner[Int]]" {
    let b: OB[Int] = OB { o: None }
    let got = match b.o {
        Some(w) => w.v
        None => 222
    }
    assert_eq(got, 222)
}

test "let-then-match of an erased Result[Inner[Int], Str]" {
    let b: RB[Int] = RB { r: Err("x") }
    let r = b.r
    let got = match r {
        Ok(w) => w.v
        Err(_) => 333
    }
    assert_eq(got, 333)
}

test "direct match of an erased Result[Inner[Int], Str]" {
    let b: RB[Int] = RB { r: Err("y") }
    let got = match b.r {
        Ok(w) => w.v
        Err(_) => 444
    }
    assert_eq(got, 444)
}
