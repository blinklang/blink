// A nested Ok(struct) constructed as the payload of an Err in a doubly-nested
// carrier must store the struct-ok side by value, not box it into a long-int slot.
// The outer Result's Err side is itself Result[A, Str]; the inner Ok(A) rides the
// same resolved-leaf construction path that spells a nested Result Err side, so the
// inner Result carrier declares its ok member as blink_A by value. Err-side mirror
// of the nested Result-of-Result ok reconstruction.

type A { v: Int }

fn build(n: Int) -> Option[Result[Str, Result[A, Str]]] {
    if n == 0 { None } else { Some(Err(Ok(A { v: 7 }))) }
}

fn main() {
    let d = build(1)
    match d {
        Some(res) => {
            match res {
                Ok(_o) => assert_eq(1, 0)
                Err(e) => {
                    match e {
                        Ok(x) => assert_eq(x.v == 7, true)
                        Err(_s) => assert_eq(1, 0)
                    }
                }
            }
        }
        None => assert_eq(1, 0)
    }

    let c = build(0)
    match c {
        Some(_res) => assert_eq(1, 0)
        None => assert_eq(1, 1)
    }
}
