// A user data-enum whose variant payload is the transparent-newtype Errno
// must stay transparent (bare int64_t) at that seam too, like the already
// covered Result-arm, Option, and struct-field seams.

import compile_test_helpers.{compile_and_run}

test.failing(
    "an Errno-typed enum variant payload stays a bare int64_t through match",
    reason: "emit_mono_enum_typedef/emit_enum_typedef box an Errno-typed variant payload as the nominal struct while the match binder reads it flat, so cc rejects the read-back initializer",
    ticket: "zgq9k1",
) {
    let src = #"
import std.io
import std.errno.{Errno}

type Wrap { W(Errno) }

fn main() ! IO {
    let w = Wrap.W(Errno(3))
    match w {
        Wrap.W(e) => match e {
            Errno(rc) => io.println("{rc}")
        }
    }
}
"#
    let r = compile_and_run(src, "_errno_enum_variant_payload_transparent")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "3\n")
}
