// A transparent-newtype (Errno) tuple element must stay a bare int64_t
// through registration and emission, like the already covered Result-arm,
// Option, struct-field, and enum-variant-payload seams.

import std.errno.{Errno}

test "an Errno tuple element stays a bare int64_t through access" {
    let t = mk()
    match t.0 {
        Errno(rc) => assert_eq(rc, 4)
    }
    assert_eq(t.1, 10)
}

fn mk() -> (Errno, Int) { return (Errno(4), 10) }
