import compile_test_helpers

test "blink check catches arena escape (E0700) — regression for missed escape pass" {
    let src = "let mut saved: List[Int] = []\nfn main() \{\n    with arena \{\n        let xs = [1, 2, 3]\n        saved = xs\n    \}\n\}\n"
    let output = compile_test_helpers.check_via_cli(src, "escape_check_e0700")
    assert(output.contains("E0700"))
}
