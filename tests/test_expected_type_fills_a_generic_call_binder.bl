// A let annotation, a parameter type, a return type, a field, a payload, a list element, a tuple
// slot and a `?`/`??` operand are each an expected type for a value
// (sections/03_types.md 3.3, bidirectional inference), so each fixes a generic call's binder
// that the arguments leave open, however a block, an if or a match wraps the call.

import std.process.{ProcessResult}

fn sh(cmd: Str) -> ProcessResult {
    process_run("sh", ["-c", cmd])
}

fn expect_runs(src: Str, want: Str) {
    let dir = sh("mktemp -d /tmp/blink_let_binder.XXXXXX").out.trim()
    let _ = sh("mkdir -p {dir}/src")
    write_file("{dir}/blink.toml", "[package]\nname = \"app\"\nversion = \"0.1.0\"\n")
    write_file("{dir}/src/main.bl", src)
    let mut ok = true
    let c = sh("B=$(pwd)/build/blink; cd {dir} && timeout 120 $B check src/main.bl < /dev/null 2>&1")
    if c.exit_code != 0 {
        io.eprintln("blink check: exit {c.exit_code}\n{c.out}")
        ok = false
    }
    for args in ["run --no-per-module", "run --per-module"] {
        let r = sh("B=$(pwd)/build/blink; cd {dir} && timeout 120 $B {args} src/main.bl < /dev/null 2>&1")
        if r.exit_code != 0 || !r.out.trim().ends_with(want) {
            io.eprintln("blink {args}: exit {r.exit_code}\n{r.out}")
            ok = false
        }
    }
    let _ = sh("rm -rf {dir}")
    assert(ok)
}

test "a let annotation fixes the binder an empty argument leaves open" {
    expect_runs(#"type Box[T] { v: List[T] }
type Pair[A, B] { a: List[A]  b: Option[B] }
fn mk[T](xs: List[T]) -> Box[T] { Box { v: xs } }
fn pair[A, B](a: List[A], b: Option[B]) -> Pair[A, B] { Pair { a: a, b: b } }
fn main() {
    let b: Box[Int] = mk([])
    let p: Pair[Str, Int] = pair([], None)
    let q: Pair[Str, Int] = pair(["x"], None)
    io.println("{b.v.len()} {p.a.len()} {q.a.len()} {q.b.is_none()}")
}
"#, "0 0 1 true")
}

test "a return type and a parameter type fix the same binder" {
    expect_runs(#"type Box[T] { v: List[T] }
fn mk[T](xs: List[T]) -> Box[T] { Box { v: xs } }
fn ret() -> Box[Str] { mk([]) }
fn use_box(b: Box[Int]) -> Int { b.v.len() }
fn main() {
    io.println("{ret().v.len()} {use_box(mk([]))}")
}
"#, "0 0")
}

test "the annotation reaches a call inside a block, an if, or a match" {
    expect_runs(#"type Box[T] { v: List[T] }
fn mk[T](xs: List[T]) -> Box[T] { Box { v: xs } }
fn main() {
    let c = true
    let b: Box[Int] = if c { mk([]) } else { mk([]) }
    let d: Box[Int] = { mk([]) }
    let m: Box[Str] = match c {
        true => mk([])
        false => { mk(["x"]) }
    }
    let mut e: Box[Int] = mk([1])
    e = if c { mk([]) } else { e }
    io.println("{b.v.len()} {d.v.len()} {m.v.len()} {e.v.len()}")
}
"#, "0 0 0 0")
}

test "the annotation reaches a conversion inside an if" {
    expect_runs(#"type Box[T] { v: List[T] }
impl[T] From[List[T]] for Box[T] {
    fn from(xs: List[T]) -> Box[T] { Box { v: xs } }
}
fn main() {
    let c = true
    let b: Box[Int] = if c { Box.from([]) } else { [].into() }
    let d: Box[Int] = { [].into() }
    io.println("{b.v.len()} {d.v.len()}")
}
"#, "0 0")
}

test "a return type reaches a call inside a block" {
    expect_runs(#"type Box[T] { v: List[T] }
fn mk[T](xs: List[T]) -> Box[T] { Box { v: xs } }
fn ret() -> Box[Str] {
    let _n = 1
    { mk([]) }
}
fn main() {
    io.println("{ret().v.len()}")
}
"#, "0")
}

test "a let annotation reaches the call in every wrapper" {
    expect_runs(#"type Box[T] { v: List[T] }
fn mk[T](xs: List[T]) -> Box[T] { Box { v: xs } }
fn main() {
    let c = true
    let b: Box[Int] = { mk([]) }
    let i: Box[Int] = if c { mk([]) } else { mk([1]) }
    let m: Box[Int] = match c {
        true => mk([])
        false => mk([1])
    }
    let n: Box[Int] = { { mk([]) } }
    io.println("{b.v.len()} {i.v.len()} {m.v.len()} {n.v.len()}")
}
"#, "0 0 0 0")
}

test "a parameter type reaches the call in every wrapper" {
    expect_runs(#"type Box[T] { v: List[T] }
fn mk[T](xs: List[T]) -> Box[T] { Box { v: xs } }
fn take(b: Box[Int]) -> Int { b.v.len() }
fn main() {
    let c = true
    let b = take({ mk([]) })
    let i = take(if c { mk([]) } else { mk([1]) })
    let m = take(match c {
        true => mk([])
        false => mk([1])
    })
    let n = take({ { mk([]) } })
    io.println("{b} {i} {m} {n}")
}
"#, "0 0 0 0")
}

test "a return type reaches the call in every wrapper" {
    expect_runs(#"type Box[T] { v: List[T] }
fn mk[T](xs: List[T]) -> Box[T] { Box { v: xs } }
fn b() -> Box[Int] { { mk([]) } }
fn i(c: Bool) -> Box[Int] { if c { mk([]) } else { mk([1]) } }
fn m(c: Bool) -> Box[Int] {
    match c {
        true => mk([])
        false => mk([1])
    }
}
fn n() -> Box[Int] { { { mk([]) } } }
fn main() {
    io.println("{b().v.len()} {i(true).v.len()} {m(true).v.len()} {n().v.len()}")
}
"#, "0 0 0 0")
}

test "a field type and a list element type reach the call in every wrapper" {
    expect_runs(#"type Box[T] { v: List[T] }
type W { b: Box[Int] }
fn mk[T](xs: List[T]) -> Box[T] { Box { v: xs } }
fn main() {
    let c = true
    let w = W { b: { mk([]) } }
    let wi = W { b: if c { mk([]) } else { mk([1]) } }
    let wm = W { b: match c {
        true => mk([])
        false => mk([1])
    } }
    let xs: List[Box[Int]] = [if c { mk([]) } else { mk([1]) }, { { mk([]) } }]
    io.println("{w.b.v.len()} {wi.b.v.len()} {wm.b.v.len()} {xs.len()}")
}
"#, "0 0 0 2")
}

// A value that stays open keeps E0301, and a payload of the wrong type is still a mismatch,
// whichever spelling builds the variant.
fn expect_rejects(src: Str, want: Str) {
    let dir = sh("mktemp -d /tmp/blink_let_binder.XXXXXX").out.trim()
    let _ = sh("mkdir -p {dir}/src")
    write_file("{dir}/blink.toml", "[package]\nname = \"app\"\nversion = \"0.1.0\"\n")
    write_file("{dir}/src/main.bl", src)
    let mut ok = true
    for args in ["check", "build --no-per-module", "build --per-module"] {
        let r = sh("B=$(pwd)/build/blink; cd {dir} && timeout 120 $B {args} src/main.bl < /dev/null 2>&1")
        if r.exit_code == 0 || !r.out.contains(want) || r.out.contains("internal compiler error") {
            io.eprintln("blink {args}: exit {r.exit_code}, want `{want}`\n{r.out}")
            ok = false
        }
    }
    let _ = sh("rm -rf {dir}")
    assert(ok)
}

test "both arms open: a field, a list element, a let, an argument and a return" {
    expect_runs(#"type Box[T] { v: List[T] }
type W { b: Box[Int] }
fn mk[T](xs: List[T]) -> Box[T] { Box { v: xs } }
fn take(b: Box[Int]) -> Int { b.v.len() }
fn ret(c: Bool) -> Box[Int] { if c { mk([]) } else { mk([]) } }
fn main() {
    let c = true
    let w = W { b: if c { mk([]) } else { mk([]) } }
    let wm = W { b: match c {
        true => mk([])
        false => { mk([]) }
    } }
    let xs: List[Box[Int]] = [if c { mk([]) } else { mk([]) }, { { mk([]) } }]
    let l: Box[Int] = if c { mk([]) } else { mk([]) }
    let a = take(if c { mk([]) } else { mk([]) })
    io.println("{w.b.v.len()} {wm.b.v.len()} {xs.len()} {l.v.len()} {a} {ret(c).v.len()}")
}
"#, "0 0 2 0 0 0")
}

test "a positional variant payload takes the field type in every wrapper" {
    expect_runs(#"type Box[T] { v: List[T] }
type E { P(Box[Int])  Q(Box[Int], Int) }
fn mk[T](xs: List[T]) -> Box[T] { Box { v: xs } }
fn n(e: E) -> Int {
    match e {
        P(b) => b.v.len()
        Q(b, k) => b.v.len() + k
    }
}
fn main() {
    let c = true
    let q1 = E.P({ mk([]) })
    let q2 = E.P(if c { mk([]) } else { mk([]) })
    let q3 = E.Q(match c {
        true => mk([])
        false => mk([])
    }, 1)
    let q4 = E.P({ { mk([]) } })
    let b0: E = P(mk([]))
    let b1: E = P({ mk([]) })
    let b2: E = P(if c { mk([]) } else { mk([]) })
    let b3: E = Q(match c {
        true => mk([])
        false => { mk([]) }
    }, 1)
    let b4 = n(P({ { mk([]) } }))
    io.println("{n(q1)} {n(q2)} {n(q3)} {n(q4)} {n(b0)} {n(b1)} {n(b2)} {n(b3)} {b4}")
}
"#, "0 0 1 0 0 0 0 1 0")
}

test "a generic enum payload takes the field type at the expected instance" {
    expect_runs(#"type Box[T] { v: List[T] }
type G[T] { GP(Box[T])  GN }
fn mk[T](xs: List[T]) -> Box[T] { Box { v: xs } }
fn n(g: G[Int]) -> Int {
    match g {
        GP(b) => b.v.len()
        GN => 9
    }
}
fn main() {
    let c = true
    let a: G[Int] = G.GP(mk([]))
    let b: G[Int] = GP({ mk([]) })
    let d: G[Int] = G.GP(if c { mk([]) } else { mk([]) })
    let e = n(GP(match c {
        true => mk([])
        false => { { mk([]) } }
    }))
    io.println("{n(a)} {n(b)} {n(d)} {e}")
}
"#, "0 0 0 0")
}

test "a tuple slot takes its type in every wrapper" {
    expect_runs(#"type Box[T] { v: List[T] }
type WT[T] { value: T }
fn mk[T](xs: List[T]) -> Box[T] { Box { v: xs } }
fn pair[A, B](a: A, b: B) -> (A, B) { (a, b) }
fn ret() -> (Box[Int], Int) { ({ mk([]) }, 2) }
fn main() {
    let c = true
    let t0: (Map[Str, Str], Int) = pair(Map(), 1)
    let w: WT[(Map[Str, Str], Int)] = WT { value: pair(Map(), 1) }
    let t1: (Box[Int], Int) = ({ mk([]) }, 1)
    let t2: (Box[Int], Int) = (if c { mk([]) } else { mk([]) }, 1)
    let t3: (Box[Int], Int) = (match c {
        true => mk([])
        false => mk([])
    }, 1)
    let t4: (Box[Int], Int) = { ({ { mk([]) } }, 1) }
    let t5: (Box[Int], Int) = if c { (mk([]), 1) } else { pair(mk([]), 1) }
    io.println("{t0.0.len()} {w.value.1} {t1.0.v.len()} {t2.0.v.len()} {t3.0.v.len()} {t4.0.v.len()} {t5.0.v.len()} {ret().1}")
}
"#, "0 1 0 0 0 0 0 2")
}

test "a ?? default and a ? operand take the expected type in every wrapper" {
    expect_runs(#"type Box[T] { v: List[T] }
fn mk[T](xs: List[T]) -> Box[T] { Box { v: xs } }
fn mkr[T](xs: List[T]) -> Result[Box[T], Str] { Ok(Box { v: xs }) }
fn mko[T](xs: List[T]) -> Option[Box[T]] { Some(Box { v: xs }) }
fn g(c: Bool) -> Result[Int, Str] {
    let x: Box[Int] = (if c { mkr([]) } else { mkr([]) })?
    let y: Box[Int] = { mkr([]) }?
    Ok(x.v.len() + y.v.len())
}
fn h(c: Bool) -> Option[Int] {
    let x: Box[Int] = (match c {
        true => mko([])
        false => mko([])
    })?
    Some(x.v.len())
}
fn main() {
    let c = true
    let o: Option[Box[Int]] = None
    let a = o ?? mk([])
    let b: Box[Int] = o ?? { mk([]) }
    let d = o ?? (if c { mk([]) } else { mk([]) })
    let e: Box[Int] = mko([]) ?? (match c {
        true => mk([])
        false => mk([])
    })
    let f: Box[Int] = (if c { mko([]) } else { mko([]) }) ?? mk([])
    io.println("{a.v.len()} {b.v.len()} {d.v.len()} {e.v.len()} {f.v.len()} {g(c).is_ok()} {h(c).is_some()}")
}
"#, "0 0 0 0 0 true true")
}

test "a value nothing determines is still E0301, and a wrong payload is still a mismatch" {
    expect_rejects(#"type Box[T] { v: List[T] }
type G[T] { GP(Box[T])  GN }
fn mk[T](xs: List[T]) -> Box[T] { Box { v: xs } }
fn main() {
    let g = GP(mk([]))
    match g {
        GP(b) => io.println("{b.v.len()}")
        GN => {}
    }
}
"#, "CannotInferType")
    expect_rejects(#"type Box[T] { v: List[T] }
fn mk[T](xs: List[T]) -> Box[T] { Box { v: xs } }
fn main() {
    let t = ({ mk([]) }, 1)
    io.println("{t.1}")
}
"#, "CannotInferType")
    expect_rejects(#"type E { P(Int)  Q(Str) }
fn main() {
    let e = P("x")
    match e {
        P(n) => io.println("{n + 1}")
        Q(s) => io.println(s)
    }
}
"#, "expects Int, got Str")
}

test "a generic struct field and a spread take the type at the expected instance" {
    expect_runs(#"type Box[T] { v: List[T] }
type GW[T] { b: Box[T]  n: Int }
fn mk[T](xs: List[T]) -> Box[T] { Box { v: xs } }
fn none[T]() -> List[Box[T]] { [] }
fn main() {
    let c = true
    let g: GW[Int] = GW { b: if c { mk([]) } else { mk([]) }, n: 1 }
    let h: GW[Int] = GW { b: match c {
        true => { { mk([]) } }
        false => mk([])
    }, n: 2 }
    let base: List[Box[Int]] = [mk([1])]
    let xs: List[Box[Int]] = [..base, mk([])]
    let ys: List[Box[Int]] = [..none(), ..base]
    io.println("{g.b.v.len()} {g.n} {h.n} {xs.len()} {xs.get(0).unwrap().v.len()} {ys.len()}")
}
"#, "0 1 2 2 1 1")
}

test "a payload meets its own field type, not an expected type around some other value" {
    expect_runs(#"type Tree[T] { Leaf(T)  Nil }
type G[T] { GP(Int)  GQ(T) }
type N[A, B] { NV(a: A, b: B) }
fn size[T](t: Tree[T]) -> Int { match t { Leaf(_) => 1  Nil => 0 } }
fn main() {
    let r: Tree[Int] = match Leaf("s") {
        Leaf(v) => Leaf(v.len())
        Nil => Nil
    }
    let g: G[Str] = {
        let z = G.GQ(5)
        match z {
            G.GQ(n) => G.GQ("{n}")
            G.GP(n) => G.GP(n)
        }
    }
    let k = match g { GQ(s) => s  GP(_) => "" }
    let w: N[Int, Str] = NV(b: "x", a: 7)
    let m = match w { NV(a, b) => "{a}{b}" }
    io.println("{size(r)} {k} {m}")
}
"#, "1 5 7x")
}

test "a wrong payload at an expected instance is reported once" {
    expect_rejects(#"type Tree[T] { Leaf(T)  Nil }
fn main() {
    let t: Tree[Int] = Leaf("x")
    match t { Leaf(n) => io.println("{n}")  Nil => {} }
}
"#, "1 error(s) found")
}

test "a recursive generic variant nests with an expected type and without one" {
    expect_runs(#"type L[T] { Cons(T, L[T])  Nil }
fn len[T](l: L[T]) -> Int { match l { Cons(_, r) => 1 + len(r)  Nil => 0 } }
fn main() {
    let l: L[Int] = Cons(1, Cons(2, Nil))
    let m = Cons(3, Nil)
    let q = L.Cons("a", L.Nil)
    io.println("{len(l)} {len(m)} {len(q)}")
}
"#, "2 1 1")
}

test "two payloads of one type parameter must agree" {
    expect_rejects(#"type P[T] { Two(T, T) }
fn main() {
    let p = Two(1, "x")
    match p { Two(a, _) => io.println("{a}") }
}
"#, "argument 2 of `Two` expects Int, got Str")
}

test "an Option or Result payload takes the slot type in every wrapper" {
    expect_runs(#"type Box[T] { v: List[T] }
fn mk[T](xs: List[T]) -> Box[T] { Box { v: xs } }
fn main() {
    let c = true
    let o: Option[Box[Int]] = Some(if c { mk([]) } else { mk([]) })
    let r: Result[Box[Int], Str] = Ok(match c {
        true => mk([])
        false => { { mk([]) } }
    })
    let e: Result[Int, Box[Str]] = Err(if c { mk([]) } else { mk([]) })
    let n = match o { Some(b) => b.v.len()  None => 9 }
    let m = match r { Ok(b) => b.v.len()  Err(_) => 9 }
    let k = match e { Ok(_) => 9  Err(b) => b.v.len() }
    io.println("{n} {m} {k}")
}
"#, "0 0 0")
}

test "a brace variant field takes its type at the expected instance" {
    expect_runs(#"type Box[T] { v: List[T] }
type V { B { b: Box[Int] }  C }
type GV[T] { GB { b: Box[T] }  GC }
fn mk[T](xs: List[T]) -> Box[T] { Box { v: xs } }
fn main() {
    let v = V.B { b: mk([]) }
    let g: GV[Int] = GV.GB { b: mk([]) }
    let h: GV[Str] = GB { b: mk([]) }
    let n = match v { V.B { b } => b.v.len()  V.C => 9 }
    let p = match g { GB { b } => b.v.len()  GC => 9 }
    let q = match h { GB { b } => b.v.len()  GC => 9 }
    io.println("{n} {p} {q}")
}
"#, "0 0 0")
}

test "an empty payload takes the expected instance" {
    expect_runs(#"type Tr[X] { Leaf(List[X])  Nd }
type Box[T] { v: List[T] }
type H[T] { HB(Box[T])  HN }
fn n[X](t: Tr[X]) -> Int { match t { Leaf(l) => l.len()  Nd => 9 } }
fn main() {
    let a: Tr[Int] = Leaf([])
    let b: Tr[Int] = Tr.Leaf([])
    let h: H[Int] = HB(Box { v: [] })
    let m = match h { HB(x) => x.v.len()  HN => 9 }
    io.println("{n(a)} {n(b)} {m}")
}
"#, "0 0 0")
}

test "a later use fills a payload binder the construction leaves open" {
    expect_runs(#"type Box[T] { v: List[T] }
type GV[T] { GB { b: Box[T] }  GC  GP(Box[T]) }
fn mk[T](xs: List[T]) -> Box[T] { Box { v: xs } }
fn use(g: GV[Int]) -> Int { match g { GB { b } => b.v.len()  GP(b) => b.v.len() + 1  GC => 9 } }
fn main() {
    let g = GP(mk([]))
    let h = GV.GB { b: mk([]) }
    io.println("{use(g)} {use(h)}")
}
"#, "1 0")
}

test "a payload no use fills is reported at its binding" {
    expect_rejects(#"type Box[T] { v: List[T] }
type GV[T] { GB { b: Box[T] }  GC }
fn mk[T](xs: List[T]) -> Box[T] { Box { v: xs } }
fn main() {
    let g = GV.GB { b: mk([]) }
    io.println("x")
}
"#, "cannot infer a type for `g`")
}

test.failing(
    "a brace variant field takes its type in every wrapper",
    reason: "typecheck fills each binder, but codegen does not materialise an if, a match or a block in a brace variant field, nor in a struct literal that leaves a field to its default",
) {
    expect_runs(#"type Box[T] { v: List[T] }
type V { B { b: Box[Int] }  C }
type GV[T] { GB { b: Box[T] }  GC }
fn mk[T](xs: List[T]) -> Box[T] { Box { v: xs } }
fn main() {
    let c = true
    let v = V.B { b: if c { mk([]) } else { mk([]) } }
    let w: V = B { b: match c {
        true => mk([])
        false => { mk([]) }
    } }
    let g: GV[Int] = GV.GB { b: if c { mk([]) } else { mk([]) } }
    let h: GV[Str] = GB { b: { { mk([]) } } }
    let n = match v { V.B { b } => b.v.len()  V.C => 9 }
    let m = match w { B { b } => b.v.len()  C => 9 }
    let p = match g { GB { b } => b.v.len()  GC => 9 }
    let q = match h { GB { b } => b.v.len()  GC => 9 }
    io.println("{n} {m} {p} {q}")
}
"#, "0 0 0 0")
}

test "a closure's declared return reaches its body tail" {
    expect_runs(#"type Box[T] { v: List[T] }
fn mk[T](xs: List[T]) -> Box[T] { Box { v: xs } }
fn main() {
    let c = true
    let f = fn() -> Box[Int] { mk([]) }
    let g = fn() -> Box[Int] { if c { mk([]) } else { mk([]) } }
    let h = fn() -> Box[Str] { { mk([]) } }
    let k = fn(n: Int) -> Box[Int] {
        if n > 0 {
            return mk([])
        }
        match c {
            true => mk([])
            false => { mk([1]) }
        }
    }
    io.println("{f().v.len()} {g().v.len()} {h().v.len()} {k(1).v.len()} {k(0).v.len()}")
}
"#, "0 0 0 0 0")
}

test "an expected fn type reaches an unannotated closure's body tail" {
    expect_runs(#"type Box[T] { v: List[T] }
fn mk[T](xs: List[T]) -> Box[T] { Box { v: xs } }
fn run(f: fn() -> Box[Int]) -> Int { f().v.len() }
fn main() {
    let c = true
    let h: fn() -> Box[Int] = fn() { { mk([]) } }
    let i: fn() -> Box[Int] = fn() { mk([]) }
    let j = run(fn() { if c { mk([]) } else { mk([]) } })
    io.println("{h().v.len()} {i().v.len()} {j}")
}
