import compile_test_helpers

// A failing assert() outside a test block must fail the same way any other
// runtime panic does: a message on stderr, exit(1), and stdout the program
// already printed flushed and preserved. It must never segfault or silently
// drop buffered output.

fn crashing_assert_src() -> Str {
    #"fn main() ! IO {
    io.println("before")
    assert(1 == 2)
}
"#
}

test "a failing assert outside a test block panics cleanly instead of segfaulting" {
    let r = compile_test_helpers.compile_and_run(crashing_assert_src(), "_assert_outside_test")
    assert(r.exit_code != 139, "must not segfault, got exit_code={r.exit_code}")
    assert(r.out.contains("before"), "buffered stdout must survive the panic: out={r.out}")
    assert(r.err_out != "", "a panic diagnostic must be printed to stderr")
}
