// br farq9f: a declared Map/Set return type does not pin its tail ctor's element
// type. `fn mkmap() -> Map[Int, Str] { Map() }` emits `blink_map_new(&blink_kops_str)`
// — the STRING key-ops vtable for an Int key — because tc_pin_tail_ret_generic
// (src/typecheck.bl) gates on TK_STRUCT/TK_ENUM and excludes TK_MAP/TK_SET, and
// codegen's resolve_ctor_kops_elem has no return-annotation tier, so a tail ctor with
// no let-target/call-arg annotation falls to its CT_STRING default.
//
// THREE REAL SYMPTOMS (the ticket's own "crashes, exit 139" does not reproduce):
//   1. Silent wrong answer, exit 0 — insert(256)/insert(512) collide under the
//      string hasher (both keys carry a 0x00 low byte, hashing as "").
//   2. Genuine memory unsafety, ASAN-only — blink_kops_eq_str reads past the 8-byte
//      key slot for a key with no zero byte (e.g. -1). Silent under plain gcc.
//   3. Lost key — insert(-1) then get(-1) panics `unwrap called on None` while len()
//      still reads 2.
//
// THE FIX, staged (three regens):
//   (A) src/typecheck.bl — tc_pin_admits_declared admits TK_MAP/TK_SET to the pin
//       gate, so tc_pin_tail_ret_generic's tc_unify solves the ctor's own metavars.
//   (C) src/codegen_expr.bl — a def-side return-annotation decoder tier
//       (ctor_ret_ann_kops_elem) answers the cases the pin cannot reach: impl
//       methods, annotated closures, and mono generic-fn instances.
//   (B) src/typecheck.bl + src/codegen_expr.bl — a tail-gated fail-closed I0001 when
//       every tier declines AND the tid's kops-deciding slot is still unsolved,
//       closing the silent CT_STRING default for good.
//
// Spec: sections/03_types.md:1031 (a fn's declared return type is an expected-type
// source), :1134/:1192/:1624 (hash coherence), :1973 (one vtable per Map/Set),
// DECISIONS.md:342 (never Void-default). Structured on
// tests/test_y1n3ck_generic_return_tail_infer.bl (its assert_has/assert_lacks and the
// three-family assert_no_erasure, which is a documented LOWER BOUND per CLAUDE.md).
//
// NEVER use compile_test_helpers.expect_contains/expect_error — they only io.println
// their verdict and can never go red (br zzpeg8).

import compile_test_helpers
import std.io

fn assert_has(c: Str, needle: Str, label: Str) {
    if !c.contains(needle) { io.println("FAIL: {label} — missing '{needle}'") }
    assert(c.contains(needle))
}

fn assert_lacks(c: Str, needle: Str, label: Str) {
    if c.contains(needle) { io.println("FAIL: {label} — forbidden '{needle}' present") }
    assert(!c.contains(needle))
}

// Per CLAUDE.md the `_Void` grep is a LOWER BOUND — check all three erasure families.
fn assert_no_erasure(c: Str, label: Str) {
    assert_lacks(c, "_Void", "{label} / string-producer erasure")
    assert_lacks(c, "blink_map_void", "{label} / erased Map carrier field")
    assert_lacks(c, "blink_set_void", "{label} / erased Set carrier field")
}

// ══════════════════════════════════════════════════════════════════════════
// Stage 1 — (A) admits Map/Set to the pin gate
// ══════════════════════════════════════════════════════════════════════════

// ── implicit tail, Map and Set, the MVCE ─────────────────────────────────────

fn src_map_tail() -> Str {
    let mut s = "fn mkmap() -> Map[Int, Str] \{ Map() }\n"
    s = s.concat("fn main() \{\n")
    s = s.concat("    let m = mkmap()\n")
    s = s.concat("    m.insert(256, \"lo\")\n")
    s = s.concat("    m.insert(512, \"hi\")\n")
    s = s.concat("    assert_eq(m.len(), 2)\n")
    s = s.concat("    assert(m.get(256).unwrap() == \"lo\")\n")
    s = s.concat("    assert(m.get(512).unwrap() == \"hi\")\n")
    s = s.concat("}\n")
    s
}

test "MVCE: implicit-tail Map[Int,Str] does not ICE" {
    compile_test_helpers.expect_no_error(src_map_tail(), "farq9f_map_tail_ice", "I0001")
}

test "MVCE: implicit-tail Map[Int,Str] selects the i64 kops, not the string one" {
    let c = compile_test_helpers.compile_and_emit_c(src_map_tail(), "farq9f_map_tail_c")
    assert_has(c, "blink_map_new(&blink_kops_i64)", "Int-key kops")
    assert_lacks(c, "blink_map_new(&blink_kops_str)", "must not hash an Int key as a string")
    assert_no_erasure(c, "implicit-tail Map")
}

test "MVCE: implicit-tail Map[Int,Str] round-trips 256 and 512 at runtime" {
    let r = compile_test_helpers.compile_and_run(src_map_tail(), "farq9f_map_tail_run")
    if r.exit_code != 0 { io.println("FAIL: implicit-tail Map runtime — exit {r.exit_code}: {r.err_out}") }
    assert_eq(r.exit_code, 0)
}

fn src_set_tail() -> Str {
    let mut s = "fn mkset() -> Set[Int] \{ Set() }\n"
    s = s.concat("fn main() \{\n")
    s = s.concat("    let s = mkset()\n")
    s = s.concat("    s.insert(256)\n")
    s = s.concat("    s.insert(512)\n")
    s = s.concat("    assert_eq(s.len(), 2)\n")
    s = s.concat("    assert(s.contains(256))\n")
    s = s.concat("    assert(s.contains(512))\n")
    s = s.concat("}\n")
    s
}

test "MVCE: implicit-tail Set[Int] does not ICE" {
    compile_test_helpers.expect_no_error(src_set_tail(), "farq9f_set_tail_ice", "I0001")
}

test "MVCE: implicit-tail Set[Int] selects the i64 kops, not the string one" {
    let c = compile_test_helpers.compile_and_emit_c(src_set_tail(), "farq9f_set_tail_c")
    assert_has(c, "blink_set_new(&blink_kops_i64)", "Int-elem kops")
    assert_lacks(c, "blink_set_new(&blink_kops_str)", "must not hash an Int elem as a string")
    assert_no_erasure(c, "implicit-tail Set")
}

test "MVCE: implicit-tail Set[Int] round-trips 256 and 512 at runtime" {
    let r = compile_test_helpers.compile_and_run(src_set_tail(), "farq9f_set_tail_run")
    if r.exit_code != 0 { io.println("FAIL: implicit-tail Set runtime — exit {r.exit_code}: {r.err_out}") }
    assert_eq(r.exit_code, 0)
}

// ── the no-zero-byte keys: the ASAN read + the lost-key symptom ─────────────
// -1/-2 carry no 0x00 byte at all, so under the string hasher this is not merely a
// collision — it's an out-of-bounds read (ASAN-only) and, per the ticket's third
// symptom, a lost key: insert(-1) then get(-1) panics `unwrap called on None` while
// len() still reads 2. Plain gcc masks the read, so the panic is the witness here;
// the ASAN run is a separate verification step (not part of `task ci`).

test "negative keys with no shared zero byte round-trip at runtime" {
    let mut s = "fn mkmap() -> Map[Int, Str] \{ Map() }\n"
    s = s.concat("fn main() \{\n")
    s = s.concat("    let m = mkmap()\n")
    s = s.concat("    m.insert(-1, \"a\")\n")
    s = s.concat("    m.insert(-2, \"b\")\n")
    s = s.concat("    assert_eq(m.len(), 2)\n")
    s = s.concat("    assert(m.get(-1).unwrap() == \"a\")\n")
    s = s.concat("    assert(m.get(-2).unwrap() == \"b\")\n")
    s = s.concat("}\n")
    let r = compile_test_helpers.compile_and_run(s, "farq9f_negkeys_run")
    if r.exit_code != 0 { io.println("FAIL: negative-key runtime — exit {r.exit_code}: {r.err_out}") }
    assert_eq(r.exit_code, 0)
}

test "Set negative elements with no shared zero byte round-trip at runtime" {
    let mut s = "fn mkset() -> Set[Int] \{ Set() }\n"
    s = s.concat("fn main() \{\n")
    s = s.concat("    let s = mkset()\n")
    s = s.concat("    s.insert(-1)\n")
    s = s.concat("    s.insert(-2)\n")
    s = s.concat("    assert_eq(s.len(), 2)\n")
    s = s.concat("    assert(s.contains(-1))\n")
    s = s.concat("    assert(s.contains(-2))\n")
    s = s.concat("}\n")
    let r = compile_test_helpers.compile_and_run(s, "farq9f_negelems_run")
    if r.exit_code != 0 { io.println("FAIL: negative-elem runtime — exit {r.exit_code}: {r.err_out}") }
    assert_eq(r.exit_code, 0)
}

// ── explicit return, and the intermediate-let form ───────────────────────────

test "explicit `return Map()` pins identically to the implicit tail" {
    let mut s = "fn mkmap() -> Map[Int, Str] \{ return Map() }\n"
    s = s.concat("fn main() \{\n")
    s = s.concat("    let m = mkmap()\n")
    s = s.concat("    m.insert(256, \"lo\")\n")
    s = s.concat("    m.insert(512, \"hi\")\n")
    s = s.concat("    assert_eq(m.len(), 2)\n")
    s = s.concat("}\n")
    compile_test_helpers.expect_no_error(s, "farq9f_explicit_return_ice", "I0001")
    let c = compile_test_helpers.compile_and_emit_c(s, "farq9f_explicit_return_c")
    assert_has(c, "blink_map_new(&blink_kops_i64)", "explicit-return Int-key kops")
    assert_lacks(c, "blink_map_new(&blink_kops_str)", "explicit-return must not hash Int as string")
    let r = compile_test_helpers.compile_and_run(s, "farq9f_explicit_return_run")
    assert_eq(r.exit_code, 0)
}

test "an intermediate let before the tail still pins" {
    let mut s = "fn mkmap() -> Map[Int, Str] \{\n"
    s = s.concat("    let m = Map()\n")
    s = s.concat("    m\n")
    s = s.concat("}\n")
    s = s.concat("fn main() \{\n")
    s = s.concat("    let m = mkmap()\n")
    s = s.concat("    m.insert(256, \"lo\")\n")
    s = s.concat("    m.insert(512, \"hi\")\n")
    s = s.concat("    assert_eq(m.len(), 2)\n")
    s = s.concat("}\n")
    compile_test_helpers.expect_no_error(s, "farq9f_interlet_ice", "I0001")
    let c = compile_test_helpers.compile_and_emit_c(s, "farq9f_interlet_c")
    assert_has(c, "blink_map_new(&blink_kops_i64)", "intermediate-let Int-key kops")
    assert_lacks(c, "blink_map_new(&blink_kops_str)", "intermediate-let must not hash Int as string")
    let r = compile_test_helpers.compile_and_run(s, "farq9f_interlet_run")
    assert_eq(r.exit_code, 0)
}

// ── Str-keyed controls: kops choice unchanged (kops_str is CORRECT here) ─────

test "control: a declared Str-keyed Map return keeps the string kops" {
    let mut s = "fn mkmap() -> Map[Str, Int] \{ Map() }\n"
    s = s.concat("fn main() \{\n")
    s = s.concat("    let m = mkmap()\n")
    s = s.concat("    m.insert(\"a\", 1)\n")
    s = s.concat("    assert_eq(m.get(\"a\").unwrap(), 1)\n")
    s = s.concat("}\n")
    let c = compile_test_helpers.compile_and_emit_c(s, "farq9f_str_control_c")
    assert_has(c, "blink_map_new(&blink_kops_str)", "Str key correctly keeps string kops")
    let r = compile_test_helpers.compile_and_run(s, "farq9f_str_control_run")
    assert_eq(r.exit_code, 0)
}

test "control: a declared Str-elem Set return keeps the string kops" {
    let mut s = "fn mkset() -> Set[Str] \{ Set() }\n"
    s = s.concat("fn main() \{\n")
    s = s.concat("    let s = mkset()\n")
    s = s.concat("    s.insert(\"a\")\n")
    s = s.concat("    assert(s.contains(\"a\"))\n")
    s = s.concat("}\n")
    let c = compile_test_helpers.compile_and_emit_c(s, "farq9f_str_set_control_c")
    assert_has(c, "blink_set_new(&blink_kops_str)", "Str elem correctly keeps string kops")
    let r = compile_test_helpers.compile_and_run(s, "farq9f_str_set_control_run")
    assert_eq(r.exit_code, 0)
}

// ── non-container tails must NOT be touched by the widened gate ─────────────
// tc_pin_admits_declared admits only MAP/SET/STRUCT/ENUM by construction — these
// exercise OPTION/LIST/TUPLE explicitly, since a metavar-bearing tail is exactly
// where a too-wide gate would show up first.

test "a declared Option[Int] tail carrying None is untouched" {
    let mut s = "fn f() -> Option[Int] \{ None }\n"
    s = s.concat("fn main() \{\n")
    s = s.concat("    let o = f()\n")
    s = s.concat("    assert(o.is_none())\n")
    s = s.concat("}\n")
    let r = compile_test_helpers.compile_and_run(s, "farq9f_guard_option")
    assert_eq(r.exit_code, 0)
}

test "a declared List[Int] tail carrying an empty literal is untouched" {
    let mut s = "fn f() -> List[Int] \{ [] }\n"
    s = s.concat("fn main() \{\n")
    s = s.concat("    let l = f()\n")
    s = s.concat("    assert_eq(l.len(), 0)\n")
    s = s.concat("}\n")
    let r = compile_test_helpers.compile_and_run(s, "farq9f_guard_list")
    assert_eq(r.exit_code, 0)
}

test "a declared tuple tail carrying a bare None is untouched" {
    let mut s = "fn f() -> (Int, Option[Int]) \{ (1, None) }\n"
    s = s.concat("fn main() \{\n")
    s = s.concat("    let t = f()\n")
    s = s.concat("    assert_eq(t.0, 1)\n")
    s = s.concat("    assert(t.1.is_none())\n")
    s = s.concat("}\n")
    let r = compile_test_helpers.compile_and_run(s, "farq9f_guard_tuple")
    assert_eq(r.exit_code, 0)
}

// ── non-Int scalar keys: Bool / Char / I32 ───────────────────────────────────

test "a declared Bool-keyed Map return pins the bool kops" {
    let mut s = "fn mkmap() -> Map[Bool, Str] \{ Map() }\n"
    s = s.concat("fn main() \{\n")
    s = s.concat("    let m = mkmap()\n")
    s = s.concat("    m.insert(true, \"yes\")\n")
    s = s.concat("    assert(m.get(true).unwrap() == \"yes\")\n")
    s = s.concat("}\n")
