    assert_has(c, "blink_map_new(&blink_kops_i32)", "i32 kops")
    let r = compile_test_helpers.compile_and_run(s, "farq9f_i32_run")
    assert_eq(r.exit_code, 0)
}

// ── @derive(Hash, Eq) struct key ──────────────────────────────────────────────
// The pin itself (tc_unify against the declared TK_MAP) reaches the constructor
// for a struct key exactly like a scalar key — confirmed here at the C-emission
// level. Compiling THIS SNIPPET further (linking + running) hits an unrelated,
// pre-existing gap: a struct-keyed Map returned from a plain (non-generic) fn
// boxes the key as `void` at the .insert()/.get() call sites, because
// reg_fn_ret_from_ann's Map branch never records the key/value struct name and
// the plain-call CT_MAP arm (codegen_expr.bl:~4746) never reads it back — filed
// as br 97d605, independent of farq9f. This row stops at compile_and_emit_c so
// it verifies only what farq9f actually fixes.

test "a declared @derive(Hash,Eq) struct-keyed Map return pins the struct kops" {
    let mut s = "@derive(Hash, Eq)\ntype Point \{ x: Int, y: Int }\n"
    s = s.concat("fn mkmap() -> Map[Point, Str] \{ Map() }\n")
    s = s.concat("fn main() \{\n")
    s = s.concat("    let m = mkmap()\n")
    s = s.concat("}\n")
    compile_test_helpers.expect_no_error(s, "farq9f_structkey_ice", "I0001")
    let c = compile_test_helpers.compile_and_emit_c(s, "farq9f_structkey_c")
    assert_has(c, "kops_blink_Point", "struct-key kops (or the mangled equivalent)")
    assert_lacks(c, "blink_map_new(&blink_kops_str)", "struct key must not fall back to string kops")
}

// ── alias return: capture Stage-0 behavior, then require the pin to reach through ──
// tc_pin_tail_ret_generic already calls resolve_alias_tid(declared_ret) before
// reading `.kind`, so an aliased declared return is not a new gate — it rides the
// same TK_MAP check as a spelled-out Map[Int,Str]. Verified at the C-emission
// level: the constructor correctly picks blink_kops_i64 through the alias.
// Compiling THIS SNIPPET further (linking + running) hits an unrelated,
// pre-existing gap: c_type_for_alias (codegen_types.bl:7656) has no case for a
// container base name, so `type IntMap = Map[Int, Str]` emits an invalid
// `typedef blink_Map blink_IntMap;` regardless of return position — filed as
// br sncncd, independent of farq9f. This row stops at compile_and_emit_c.

test "a type-aliased Map return still pins through the alias" {
    let mut s = "type IntMap = Map[Int, Str]\n"
    s = s.concat("fn mkmap() -> IntMap \{ Map() }\n")
    s = s.concat("fn main() \{\n")
    s = s.concat("    let m = mkmap()\n")
    s = s.concat("}\n")
    compile_test_helpers.expect_no_error(s, "farq9f_alias_ice", "I0001")
    let c = compile_test_helpers.compile_and_emit_c(s, "farq9f_alias_c")
    assert_has(c, "blink_map_new(&blink_kops_i64)", "aliased Int-key kops")
    assert_lacks(c, "blink_map_new(&blink_kops_str)", "aliased Int key must not hash as a string")
}

// ── a genuine mismatch must still be diagnosed ───────────────────────────────
// The pin runs only where types_compatible ALREADY agreed (:1576-1578); a real
// mismatch keeps its diagnostic untouched.

test "a declared/body Map key mismatch is still diagnosed" {
    let mut s = "fn mkmap() -> Map[Int, Str] \{\n"
    s = s.concat("    let m: Map[Str, Int] = Map()\n")
    s = s.concat("    m\n")
    s = s.concat("}\n")
    s = s.concat("fn main() \{ let _m = mkmap() }\n")
    compile_test_helpers.expect_compile_error(s, "farq9f_mismatch", "E0300")
}

// ══════════════════════════════════════════════════════════════════════════
// Stage 2 — (C) def-side return-annotation tier
// ══════════════════════════════════════════════════════════════════════════
// The typecheck pin never reaches an impl method (br ya8qyf — lookup_fnsig misses
// for every method) or a closure (tc_in_closure_depth gate, by design). Both need
// codegen's OWN return-annotation reader.

test "an impl method's declared Map return pins the i64 kops" {
    let mut s = "type Holder \{ n: Int }\n"
    s = s.concat("trait Maker \{ fn make(self) -> Map[Int, Str] }\n")
    s = s.concat("impl Maker for Holder \{\n")
    s = s.concat("    fn make(self) -> Map[Int, Str] \{ Map() }\n")
    s = s.concat("}\n")
    s = s.concat("fn main() \{\n")
    s = s.concat("    let h = Holder \{ n: 1 }\n")
    s = s.concat("    let m = h.make()\n")
    s = s.concat("    m.insert(256, \"lo\")\n")
    s = s.concat("    m.insert(512, \"hi\")\n")
    s = s.concat("    assert_eq(m.len(), 2)\n")
    s = s.concat("}\n")
    compile_test_helpers.expect_no_error(s, "farq9f_impl_ice", "I0001")
    let c = compile_test_helpers.compile_and_emit_c(s, "farq9f_impl_c")
    assert_has(c, "blink_map_new(&blink_kops_i64)", "impl-method Int-key kops")
    assert_lacks(c, "blink_map_new(&blink_kops_str)", "impl-method must not hash Int as string")
    let r = compile_test_helpers.compile_and_run(s, "farq9f_impl_run")
    assert_eq(r.exit_code, 0)
}

test "an annotated closure's own declared Map return pins the i64 kops" {
    let mut s = "fn a() -> Map[Int, Str] \{\n"
    s = s.concat("    let c = fn() -> Map[Int, Str] \{ Map() }\n")
    s = s.concat("    c()\n")
    s = s.concat("}\n")
    s = s.concat("fn main() \{\n")
    s = s.concat("    let m = a()\n")
    s = s.concat("    m.insert(256, \"lo\")\n")
    s = s.concat("    m.insert(512, \"hi\")\n")
    s = s.concat("    assert_eq(m.len(), 2)\n")
    s = s.concat("}\n")
    compile_test_helpers.expect_no_error(s, "farq9f_closure_ann_ice", "I0001")
    let c = compile_test_helpers.compile_and_emit_c(s, "farq9f_closure_ann_c")
    assert_has(c, "blink_map_new(&blink_kops_i64)", "annotated-closure Int-key kops")
    assert_lacks(c, "blink_map_new(&blink_kops_str)", "annotated closure must not hash Int as string")
    let r = compile_test_helpers.compile_and_run(s, "farq9f_closure_ann_run")
    assert_eq(r.exit_code, 0)
}

// ── tuple key through a declared return ──────────────────────────────────────
// The ctor itself (ctor_ret_ann_kops_elem reading the return annotation) correctly
// picks blink_kops_blink_Tuple2_int_int — confirmed here at the C-emission level.
// Compiling THIS SNIPPET further (linking + running) hits the same unrelated,
// pre-existing gap as the struct-keyed row above: a compound-keyed Map returned
// from a plain (non-generic) fn boxes the key as `void` at the .insert()/.get()
// call sites, because reg_fn_ret_from_ann's Map branch never records the
// key/value carrier name and the plain-call CT_MAP arm never reads it back — now
// confirmed to also fire for a tuple key, not just a struct key (br 97d605, noted
// there). This row stops at compile_and_emit_c so it verifies only what farq9f's
// Stage 2 actually fixes: the ctor's kops selection.
test "a declared tuple-keyed Map return pins the tuple carrier, not the string default" {
    let mut s = "fn mkmap() -> Map[(Int, Int), Str] \{ Map() }\n"
    s = s.concat("fn main() \{\n")
    s = s.concat("    let m = mkmap()\n")
    s = s.concat("}\n")
    compile_test_helpers.expect_no_error(s, "farq9f_tuplekey_ice", "I0001")
    let c = compile_test_helpers.compile_and_emit_c(s, "farq9f_tuplekey_c")
    assert_lacks(c, "blink_map_new(&blink_kops_str)", "tuple key must not fall back to string kops")
    assert_lacks(c, "BLINK_COMPILER_BUG", "tuple key must register a real kops table")
    assert_has(c, "kops_blink_Tuple2_int_int", "tuple carrier kops registered")
}

// ── generic-fn return, monomorphized at a concrete K ─────────────────────────

test "a generic fn's declared Map[K,Str] return pins per-instantiation" {
    let mut s = "fn mk[K]() -> Map[K, Str] \{ Map() }\n"
    s = s.concat("fn main() \{\n")
    s = s.concat("    let m: Map[Int, Str] = mk()\n")
    s = s.concat("    m.insert(256, \"lo\")\n")
    s = s.concat("    m.insert(512, \"hi\")\n")
    s = s.concat("    assert_eq(m.len(), 2)\n")
    s = s.concat("}\n")
    compile_test_helpers.expect_no_error(s, "farq9f_genericfn_ice", "I0001")
    let c = compile_test_helpers.compile_and_emit_c(s, "farq9f_genericfn_c")
    assert_has(c, "blink_map_new(&blink_kops_i64)", "generic-fn mono Int-key kops")
    assert_lacks(c, "blink_map_new(&blink_kops_str)", "generic-fn mono must not hash Int as string")
    let r = compile_test_helpers.compile_and_run(s, "farq9f_genericfn_run")
    assert_eq(r.exit_code, 0)
}

// ── control: a generic fn with a Map[T,Str] return that is NEVER monomorphized
// concretely must not ICE — codegen only visits monomorphized instances, so a
// purely generic, never-called body has nothing to fail closed on. ──

test "an un-monomorphized generic Map-returning fn does not ICE" {
    let mut s = "fn mk[T]() -> Map[T, Str] \{ Map() }\n"
    s = s.concat("fn main() \{ assert_eq(1, 1) }\n")
    compile_test_helpers.expect_no_error(s, "farq9f_generic_unused_ice", "I0001")
}

// ══════════════════════════════════════════════════════════════════════════
// Stage 3 — (B) fail-closed on a provably-unsolved kops slot
// ══════════════════════════════════════════════════════════════════════════
// Both rows below are genuinely under-determined AND slip past the front-end E0301
// region-boundary check (it is scope-pop-triggered; a bare tail ctor with no
// intervening let has no scope-pop to fire it, and a bare generic typevar target
// makes types_compatible permissive rather than a mismatch). This is precisely the
// gap (B) exists to close: a loud I0001 instead of the old silent kops_str default.

test "a bare generic-typevar return whose body is Map() fails closed with I0001" {
    let mut s = "fn mk[T]() -> T \{ Map() }\n"
    s = s.concat("fn main() \{\n")
    s = s.concat("    let m: Map[Int, Str] = mk()\n")
    s = s.concat("    let _n = m.len()\n")
    s = s.concat("}\n")
    compile_test_helpers.expect_compile_error(s, "farq9f_bare_typevar_ice", "I0001")
}

// The closure route. Was spelled `let c = fn() \{ Map() }` under a `-> Map[Int, Str]` fn; that
// no longer reaches (B) because a closure literal now carries a real TyKind.Fn tid whose omitted
// `-> T` means Void (br nz7drz), so typecheck rejects the call with the ordinary TypeError a
// named `fn c() \{ Map() }` has always drawn. An ANNOTATED generic return is the closure shape
// that still gets past the front end with the kops slot provably unbound. The retired spelling
// is pinned as a TypeError-not-ICE row in tests/test_i0001_unsolved_typevar_at_codegen.bl.
test "a closure's generic-typevar Map return fails closed with I0001" {
    let mut s = "fn a[K, V]() -> Int \{\n"
    s = s.concat("    let c = fn() -> Map[K, V] \{ Map() }\n")
    s = s.concat("    let _m = c()\n")
    s = s.concat("    1\n")
    s = s.concat("}\n")
    s = s.concat("fn main() \{ let _x = a() }\n")
    compile_test_helpers.expect_compile_error(s, "farq9f_closure_generic_ret_ice", "I0001")
}

// ── over-fire guards: every shape below must compile AND run clean ──────────
// These are the most important rows in the file. (B) is gated tail-only, so none of
// these — none of them a bare tail Map()/Set() against a declared MAP/SET/STRUCT/ENUM
// return — may reach the fail-closed chokepoint.

test "over-fire guard: the annotated-let workaround stays clean" {
    let mut s = "fn mkmap() -> Map[Int, Str] \{\n"
    s = s.concat("    let m: Map[Int, Str] = Map()\n")
    s = s.concat("    m\n")
    s = s.concat("}\n")
    s = s.concat("fn main() \{\n")
    s = s.concat("    let m = mkmap()\n")
    s = s.concat("    m.insert(256, \"lo\")\n")
    s = s.concat("    assert_eq(m.len(), 1)\n")
    s = s.concat("}\n")
    compile_test_helpers.expect_no_error(s, "farq9f_guard_annotated_let", "I0001")
    let r = compile_test_helpers.compile_and_run(s, "farq9f_guard_annotated_let_run")
    assert_eq(r.exit_code, 0)
}

// The src/escape.bl:208 shape: Map() as a call ARG (not a tail value) inside a
// Void-returning fn. Neither the declared-return type (Void) nor tail position
// admits this to the pin or to (B) — this is the `task regen` canary.
test "over-fire guard: List[Map[Str,Str]] push(Map()) (the escape.bl:208 shape)" {
    let mut s = "fn main() \{\n"
    s = s.concat("    let mut fs: List[Map[Str, Str]] = []\n")
    s = s.concat("    fs.push(Map())\n")
    s = s.concat("    assert_eq(fs.len(), 1)\n")
    s = s.concat("}\n")
    compile_test_helpers.expect_no_error(s, "farq9f_guard_list_push", "I0001")
    let r = compile_test_helpers.compile_and_run(s, "farq9f_guard_list_push_run")
    assert_eq(r.exit_code, 0)
}

// A non-tail struct-literal field Map() inside a fn returning a DIFFERENT container
// (so `struct_lit_is_fn_tail_value`-style gates must see this as NOT the tail value).
test "over-fire guard: a non-tail struct field Map() inside a differently-typed return" {
    let mut s = "type Holder \{ m: Map[Str, Int] }\n"
    s = s.concat("fn f() -> List[Int] \{\n")
    s = s.concat("    let h = Holder \{ m: Map() }\n")
    s = s.concat("    h.m.insert(\"a\", 1)\n")
    s = s.concat("    [h.m.get(\"a\").unwrap()]\n")
    s = s.concat("}\n")
    s = s.concat("fn main() \{\n")
    s = s.concat("    let l = f()\n")
    s = s.concat("    assert_eq(l.get(0).unwrap(), 1)\n")
    s = s.concat("}\n")
    compile_test_helpers.expect_no_error(s, "farq9f_guard_nontail_field", "I0001")
    let r = compile_test_helpers.compile_and_run(s, "farq9f_guard_nontail_field_run")
    assert_eq(r.exit_code, 0)
}

// A map_filter-shaped HOF: Map() constructed inside a helper whose OWN declared
// return is the same concrete Map type, mirroring lib/std/map.bl's map_filter.
test "over-fire guard: a map_filter-shaped HOF stays clean" {
    let mut s = "fn keep_gt(m: Map[Int, Str], threshold: Int) -> Map[Int, Str] \{\n"
    s = s.concat("    let mut out = Map()\n")
    s = s.concat("    for k in m.keys() \{\n")
    s = s.concat("        if k > threshold \{ out.insert(k, m.get(k).unwrap()) }\n")
    s = s.concat("    }\n")
    s = s.concat("    out\n")
    s = s.concat("}\n")
    s = s.concat("fn main() \{\n")
    s = s.concat("    let mut m: Map[Int, Str] = Map()\n")
    s = s.concat("    m.insert(256, \"a\")\n")
    s = s.concat("    m.insert(1, \"b\")\n")
    s = s.concat("    let out = keep_gt(m, 10)\n")
    s = s.concat("    assert_eq(out.len(), 1)\n")
    s = s.concat("    assert(out.get(256).unwrap() == \"a\")\n")
    s = s.concat("}\n")
    compile_test_helpers.expect_no_error(s, "farq9f_guard_hof", "I0001")
    let r = compile_test_helpers.compile_and_run(s, "farq9f_guard_hof_run")
    assert_eq(r.exit_code, 0)
}

// A generic-struct field Map() with NO declared return in scope at all must stay
// E0301 (a loud front-end stop), never silently promoted to I0001 by (B) — (B) only
// answers "no tier could name this AND it is still under-determined," and here the
// front end already has the definitive answer.
test "over-fire guard: an unpinnable generic-struct field stays E0301, not I0001" {
    let mut s = "type GKV[K, V] \{ m: Map[K, V] }\n"
    s = s.concat("fn f() \{ let _x = GKV \{ m: Map() } }\n")
    s = s.concat("fn main() \{ f() }\n")
    compile_test_helpers.expect_compile_error(s, "farq9f_guard_e0301", "E0301")
    compile_test_helpers.expect_no_error(s, "farq9f_guard_e0301_not_ice", "I0001")
}

test "blink explain I0001 still returns the catalog entry" {
    compile_test_helpers.verify_catalog_entry("I0001", "UnsolvedTypeVarAtCodegen")
}
