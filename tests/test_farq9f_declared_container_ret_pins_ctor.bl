    let c = compile_test_helpers.compile_and_emit_c(s, "farq9f_bool_c")
    assert_has(c, "blink_map_new(&blink_kops_bool)", "bool kops")
    let r = compile_test_helpers.compile_and_run(s, "farq9f_bool_run")
    assert_eq(r.exit_code, 0)
}

