test "a declared I32-keyed Map return pins the i32 kops" {
    let mut s = "fn mkmap() -> Map[I32, Str] \{ Map() }\n"
    s = s.concat("fn main() \{\n")
    s = s.concat("    let m = mkmap()\n")
    s = s.concat("    m.insert(256, \"lo\")\n")
    s = s.concat("    m.insert(512, \"hi\")\n")
    s = s.concat("    assert_eq(m.len(), 2)\n")
    s = s.concat("}\n")
    compile_test_helpers.expect_no_error(s, "farq9f_i32_ice", "I0001")
