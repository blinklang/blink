// Bug fcqfhf: Nested Option[Option[T]] direct-construction .unwrap().unwrap()
// emitted mis-ordered C — the CT_OPTION unwrap branch left the outer-level
// `expr_option_inner_struct` global stale, so the chained second .unwrap()
// re-read the OUTER carrier (`blink_Option_Option_int`) and assigned an
// already-one-level-unwrapped value into it ("invalid initializer" at cc).

test "nested option unwrap" {
    let o: Option[Option[Int]] = Some(Some(5))
    assert_eq(o.unwrap().unwrap(), 5)
}

test "nested option unwrap into string interp" {
    let o: Option[Option[Int]] = Some(Some(42))
    assert_eq("{o.unwrap().unwrap()}", "42")
}
