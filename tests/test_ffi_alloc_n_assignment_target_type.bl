// Reassigning a Ptr[T]-typed variable from scope.alloc_n(n) must infer the pointee type
// T from the assignment target's own declared type, the same way a `let` binding does.

import compile_test_helpers.{compile_and_run}

test "scope.alloc_n(n) in assignment position infers the pointee from the target's declared type" {
    let src = #"
import blink.ffi
fn main() ! IO {
    with ffi.scope() as scope {
        let mut p: Ptr[I64] = scope.alloc()
        p.write(5)
        io.println("a {p.deref()}")
        p = scope.alloc_n(4)
        p.write(1)
        io.println("b {p.deref()}")
    }
}
"#
    let r = compile_and_run(src, "_ffi_alloc_n_assign_target")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "a 5\nb 1\n")
}
