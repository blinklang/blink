// A binding written as @ffi("library", "symbol") names the library its symbol lives in.
// The unit carries that name for the link line, and the call reaches the foreign symbol
// through the binding's wrapper.
@trusted(audit: "TEST-FFI-BINDING-WITH-A-LIBRARY")
@ffi("m", "cos")
fn c_cos(x: Float) -> Float ! FFI

@trusted(audit: "TEST-FFI-BINDING-WITH-A-LIBRARY")
@ffi("m", "sqrt")
fn c_sqrt(x: Float) -> Float ! FFI

fn main() {
    assert(c_cos(0.0) == 1.0, "cos(0) is 1")
    assert(c_sqrt(16.0) == 4.0, "sqrt(16) is 4")
    io.println("ok")
}
