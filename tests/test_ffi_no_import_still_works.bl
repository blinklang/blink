// Non-breakage guard for the blink.ffi resolution change (q0brkj): the `ffi`
// namespace is a no-import intrinsic. Using `@ffi` / `Ptr` / `ffi.scope` with
// NO `import blink.ffi` must keep compiling exactly as before — the import is
// optional, never required.
//
// Decision: decisions/ffi-import-namespace-resolution.md (6-0, q0brkj).

@ffi("labs")
@trusted
fn c_abs(n: Int) -> Int ! FFI { }

@trusted(audit: "test")
fn use_ptr_no_import() ! FFI {
    with ffi.scope() as scope {
        let p: Ptr[Int] = scope.alloc()
        p.write(11)
        let _ = p.deref()
    }
}

fn main() {
    io.println("abs(-9) = {c_abs(-9)}")
    use_ptr_no_import()
    io.println("no-import ffi still works")
}
