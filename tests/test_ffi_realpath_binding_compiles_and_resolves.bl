// stdlib.h declares realpath with char* parameters, which no Blink type spells, so a
// binding over it is called through the header's prototype and not one written from the
// Blink signature. glibc hides that prototype under the runtime's _POSIX_C_SOURCE, so the
// runtime declares it there; without it this file does not compile.

@ffi("realpath", header: "stdlib.h")
@trusted(audit: "Wraps realpath(3). path is a NUL-terminated copy from ffi.scope(); resolved is a 4096-byte buffer from ffi.scope(), which realpath fills on success.")
fn c_realpath(path: Ptr[U8], resolved: Ptr[U8]) -> Ptr[U8] ! FS.Read {}

fn resolve(path: Str) -> Option[Str] ! FS.Read {
    let mut real: Option[Str] = None
    with ffi.scope() as scope {
        let buf = scope.alloc_n[U8](4096)
        if !c_realpath(scope.cstr(path), buf).is_null() {
            real = buf.to_str()
        }
    }
    real
}

test "realpath drops the dot and repeated slashes of the root" {
    assert_eq(resolve("//.") ?? "", "/")
}

test "realpath of a missing path is None" {
    assert(resolve("/no/such/dir/for/the/realpath/test").is_none())
}
