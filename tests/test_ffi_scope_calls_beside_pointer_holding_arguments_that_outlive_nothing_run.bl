// sections/07_trust_modules_metadata.md, *Scope tags*, rule 4: each call here passes a pointer
// next to an argument, and none stores a younger pointer into an older cell, so each compiles
// and runs.

@trusted(audit: "RUN-1")
fn put_slot(slot: Ptr[Ptr[U8]], p: Ptr[U8]) {
    slot.write(p)
}

@trusted(audit: "RUN-2")
fn copy_byte(dst: Ptr[U8], src: Ptr[U8]) {
    dst.write(src.deref())
}

@trusted(audit: "RUN-3")
fn keep(ps: List[Ptr[U8]], p: Ptr[U8]) {
    ps.push(p)
}

test "put_slot stores a pointer of the scope that owns the slot" {
    with ffi.scope() as outer {
        let slot = outer.alloc[Ptr[U8]]()
        let buf = outer.alloc[U8]()
        buf.write(7)
        put_slot(slot, buf)
        assert_eq(slot.deref().deref(), 7)
        with ffi.scope() as inner {
            put_slot(slot, inner.take(inner.alloc[U8]()))
        }
        assert(!slot.deref().is_null())
    }
}

test "two Ptr[U8] arguments from different scopes copy a byte" {
    with ffi.scope() as outer {
        let dst = outer.alloc[U8]()
        with ffi.scope() as inner {
            let src = inner.alloc[U8]()
            src.write(42)
            copy_byte(dst, src)
        }
        assert_eq(dst.deref(), 42)
    }
}

test "an inner list holds pointers of its own scope and of outer scopes" {
    with ffi.scope() as outer {
        let buf = outer.alloc[U8]()
        with ffi.scope() as inner {
            let mut local: List[Ptr[U8]] = []
            local.push(inner.alloc[U8]())
            local.push(buf)
            keep(local, inner.alloc[U8]())
            assert_eq(local.len(), 3)
        }
    }
}

test "an outer list holds a pointer of its scope and a taken one" {
    with ffi.scope() as outer {
        let mut ps: List[Ptr[U8]] = []
        keep(ps, outer.alloc[U8]())
        with ffi.scope() as inner {
            ps.push(inner.take(inner.alloc[U8]()))
        }
        assert_eq(ps.len(), 2)
    }
}
