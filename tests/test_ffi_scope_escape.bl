// Tests for E0601 value-escape (PtrEscapesFfiScope) infrastructure.
//
// Spec: decisions/ffi-struct-construction.md L121-131 mandates the
// `value-escape` sub-kind for `E0601`. The codegen-side check guards the
// case where a Ptr minted from a locally-bound `ffi_scope()` would be
// returned from the function that owns the scope.
//
// In today's surface syntax, returning a bare `Ptr[T]` from a non-@ffi
// function is already blocked by E0811 PtrOutsideFFI in typecheck, so
// the value-escape rule is latent — the check is defensive code that
// activates when Ptr-in-signature restrictions are relaxed (or when an
// internal pass otherwise produces a Ptr-returning fn without @ffi).
//
// Reachable today: confirm the bookkeeping (origin tag, scope.take()
// reset, parameter-Ptr exemption) does not false-positive on legitimate
// code patterns. The bookkeeping is exercised by every existing
// test_ffi_struct_*.bl + lib/std/libc.bl `poll` consumer; the cases
// below codify the contract.

import compile_test_helpers

@ffi.struct(header: "poll.h", name: "pollfd")
pub type Pollfd { fd: I32, events: I16, revents: I16 }

test "scope.alloc with same-scope offset chain compiles" {
    let src = "@ffi.struct(header: \"poll.h\", name: \"pollfd\")\npub type Pollfd \{ fd: I32, events: I16, revents: I16 }\nfn main() \{\n    let mut s = ffi_scope()\n    let buf: Ptr[Pollfd] = s.alloc_n(4)\n    let cell = buf.offset(1)\n    cell.fd.write(0)\n}\n"
    compile_test_helpers.expect_no_error(src, "ffi_scope_offset_chain", "E0601")
}

test "scope.take() clears origin so the Ptr no longer reports value-escape" {
    let src = "@ffi.struct(header: \"poll.h\", name: \"pollfd\")\npub type Pollfd \{ fd: I32, events: I16, revents: I16 }\nfn main() \{\n    let mut s = ffi_scope()\n    let p: Ptr[Pollfd] = s.take(s.alloc())\n    let _ = p.is_null()\n}\n"
    compile_test_helpers.expect_no_error(src, "ffi_scope_take_clears_origin", "E0601")
}

test "scope.alloc inside a function body that returns non-Ptr compiles" {
    let src = "@ffi.struct(header: \"poll.h\", name: \"pollfd\")\npub type Pollfd \{ fd: I32, events: I16, revents: I16 }\nfn make() -> Int \{\n    let mut s = ffi_scope()\n    let p: Ptr[Pollfd] = s.alloc()\n    if p.is_null() \{ 0 } else \{ 1 }\n}\nfn main() \{\n    let _ = make()\n}\n"
    compile_test_helpers.expect_no_error(src, "ffi_scope_internal_use", "E0601")
}
