// A field read through a Ptr[T] to an @ffi.struct must carry the field's declared
// type both into a plain let binding and into a string interpolation.

@ffi.struct(header: "poll.h", name: "pollfd")
pub type Pollfd { fd: I32, events: I16, revents: I16 }

test "ffi struct field read through Ptr.alloc binds its declared type" {
    with ffi.scope() as scope {
        let p: Ptr[Pollfd] = scope.alloc()
        p.fd.write(9)
        let v = p.fd.read()
        assert_eq(v, 9)
    }
}

test "ffi struct field read through Ptr.alloc interpolates its value" {
    with ffi.scope() as scope {
        let p: Ptr[Pollfd] = scope.alloc()
        p.fd.write(9)
        assert_eq("v={p.fd.read()}", "v=9")
    }
}
