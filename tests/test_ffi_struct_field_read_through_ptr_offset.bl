// A field read through an offset Ptr[T] to an @ffi.struct must carry the field's
// declared type into a plain let binding, not just into a comparison.

@ffi.struct(header: "poll.h", name: "pollfd")
pub type Pollfd { fd: I32, events: I16, revents: I16 }

test "ffi struct field read through Ptr.offset binds its declared type" {
    with ffi.scope() as scope {
        let buf: Ptr[Pollfd] = scope.alloc_n(2)
        let cell = buf.offset(1)
        cell.fd.write(9)
        let v = cell.fd.read()
        assert_eq(v, 9)
    }
}
