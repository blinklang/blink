// A C struct that points at its own type (a list node, struct addrinfo's ai_next) or at
// a struct that points back must build: the mirror names the pointee before its typedef.

@ffi.struct
type ListNode { v: I32, next: Ptr[ListNode] }

@ffi.struct
type CycleLeft { x: I32, right: Ptr[CycleRight] }

@ffi.struct
type CycleRight { y: I32, left: Ptr[CycleLeft] }

@ffi.struct
type NodeSlot { v: I32, cell: Ptr[Ptr[NodeSlot]] }

test "a Ptr field to its own struct links two nodes" {
    with ffi.scope() as scope {
        let a: Ptr[ListNode] = scope.alloc[ListNode]()
        let b: Ptr[ListNode] = scope.alloc[ListNode]()
        a.v.write(3)
        b.v.write(4)
        a.next.write(b)
        b.next.write(null_ptr[ListNode]())
        assert_eq(a.next.read().v.read(), 4)
        assert(a.next.read().next.read().is_null())
    }
}

test "two structs that point at each other" {
    with ffi.scope() as scope {
        let l: Ptr[CycleLeft] = scope.alloc[CycleLeft]()
        let r: Ptr[CycleRight] = scope.alloc[CycleRight]()
        l.x.write(5)
        r.y.write(7)
        l.right.write(r)
        r.left.write(l)
        assert_eq(l.right.read().y.read(), 7)
        assert_eq(r.left.read().x.read(), 5)
    }
}

test "a Ptr[Ptr] field to its own struct" {
    with ffi.scope() as scope {
        let n: Ptr[NodeSlot] = scope.alloc[NodeSlot]()
        let cell: Ptr[Ptr[NodeSlot]] = scope.alloc[Ptr[NodeSlot]]()
        cell.write(n)
        n.v.write(9)
        n.cell.write(cell)
        assert_eq(n.cell.read().deref().v.read(), 9)
    }
}
