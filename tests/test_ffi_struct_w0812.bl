fn run_build(tag: Str, src: Str, extra: List[Str]) -> Str {
    let bl_path = ".tmp/_test_{tag}.bl"
    write_file(bl_path, src)
    let mut args = ["build", bl_path, "--emit", "c"]
    let mut i = 0
    while i < extra.len() {
        args.push(extra.get(i).unwrap())
        i = i + 1
    }
    let result = process_run("build/blink", args)
    let combined = "{result.out}{result.err_out}"
    shell_exec("rm -f {bl_path} build/_test_{tag}.c")
    combined
}

test "ffi.struct with undeclared header emits W0812 warning by default" {
    let src = "@ffi.struct(header: \"poll.h\", name: \"pollfd\")\npub type Pollfd \{ fd: I32, events: I16, revents: I16 }\nfn main() \{ }\n"
    let out = run_build("ffi_w0812_warn", src, [])
    assert(out.contains("MissingCanonicalHeader"))
    assert(out.contains("warning"))
}

test "ffi.struct undeclared header escalates to error under --strict-struct-layout" {
    let src = "@ffi.struct(header: \"poll.h\", name: \"pollfd\")\npub type Pollfd \{ fd: I32, events: I16, revents: I16 }\nfn main() \{ }\n"
    let out = run_build("ffi_w0812_strict", src, ["--strict-struct-layout"])
    assert(out.contains("MissingCanonicalHeader"))
    assert(out.contains("error"))
}

test "no @ffi.struct means no W0812" {
    let src = "fn main() \{ }\n"
    let out = run_build("ffi_w0812_clean", src, [])
    assert(!out.contains("MissingCanonicalHeader"))
}

test "ffi.opaque with undeclared header emits W0812 warning by default" {
    let src = "@ffi.opaque(header: \"stdio.h\", name: \"FILE\")\npub type CFile\nfn main() \{ }\n"
    let out = run_build("ffi_w0812_opaque", src, [])
    assert(out.contains("MissingCanonicalHeader"))
    assert(out.contains("warning"))
}

fn check_pkg(root: Str, manifest: Str) -> Str {
    let _mk = process_run("mkdir", ["-p", "{root}/src"])
    write_file("{root}/blink.toml", manifest)
    let entry = "{root}/src/main.bl"
    write_file(entry, "@ffi.struct(header: \"poll.h\", name: \"pollfd\")\npub type Pollfd \{ fd: I32, events: I16, revents: I16 }\nfn main() \{ }\n")
    let result = process_run("build/blink", ["check", entry])
    shell_exec("rm -rf {root}")
    "{result.out}{result.err_out}"
}

// The same package warns until its manifest declares the header, so the quiet case is
// not quiet only because no manifest was found.
test "ffi.struct whose header a native dependency declares emits no W0812" {
    let pkg = "[package]\nname = \"ffi_w0812_pkg\"\nversion = \"0.1.0\"\n"
    let undeclared = check_pkg(".tmp/ffi_w0812_undeclared", pkg)
    assert(undeclared.contains("MissingCanonicalHeader"))
    let declared = check_pkg(".tmp/ffi_w0812_declared", "{pkg}\n[native-dependencies]\npoll = \{ system = true, headers = [\"poll.h\"] }\n")
    assert(declared.contains("ok:"))
    assert(!declared.contains("MissingCanonicalHeader"))
}
