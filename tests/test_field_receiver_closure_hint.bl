// br 3kswg7 — an unannotated closure param over a HOF whose receiver is reached through a field
// (b.items.map(fn(p) { ... }), items: List[Pt]). The flat element-CT registry is keyed on the
// receiver's var name and returns CT_VOID for a field-provenance receiver, so the hint arm — when
// gated on the flat CT alone — skipped it and the param spelled `void p` (illegal C). The element
// tid resolves correctly regardless of provenance, so the arm now fires whenever the tid is
// spellable and leads with it; the cast half gates on the same channel to stay ABI-paired.

import compile_test_helpers
import std.io

fn field_src() -> Str {
    #"import std.io

type Pt { x: Int y: Int }
type Box { items: List[Pt] }

fn main() {
    let b = Box { items: [Pt { x: 1, y: 2 }, Pt { x: 3, y: 4 }] }
    let xs = b.items.map(fn(p) -> Int { p.x + p.y })
    let total = xs.fold(0, fn(a: Int, v: Int) -> Int { a + v })
    io.println("{total}")
}
"#
}

test "closure param over a field receiver spells its struct type, not void" {
    let c = compile_test_helpers.compile_and_emit_c(field_src(), "3kswg7_field")
    if c.contains("void p)") {
        io.println("FAIL: field-receiver hint param still spelled void")
    }
    assert(!c.contains("void p)"))
    assert(c.contains("blink_Pt p)"))
    assert(c.contains(", blink_Pt))"))
}

test "closure param over a field receiver compiles and runs" {
    let r = compile_test_helpers.compile_and_run(field_src(), "3kswg7_field_run")
    if r.exit_code != 0 {
        io.println("FAIL: did not run cleanly (exit {r.exit_code})")
        io.println(r.err_out)
    }
    assert(r.exit_code == 0)
    assert(r.out.contains("10"))
}
