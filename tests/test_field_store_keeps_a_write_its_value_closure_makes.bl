// `s.f = rhs` evaluates `rhs` and then stores to `s.f` (sections/02_syntax.md §2.22 *Assignment
// places*). A closure that `rhs` calls may write to another field of `s`, and that write is
// still there after the store, because the store writes one field of the `s` it reads after
// `rhs` returns.

type Stats {
    count: Int
    total: Int
}

test "a field store keeps a write that its value's closure makes to the same struct" {
    let mut s = Stats { count: 0, total: 0 }
    let record = fn() -> Int {
        s.count = s.count + 1
        5
    }
    s.total = record()
    assert_eq(s.count, 1)
    assert_eq(s.total, 5)
}

test "a compound field store keeps a write that its value's closure makes" {
    let mut s = Stats { count: 0, total: 10 }
    let record = fn() -> Int {
        s.count = s.count + 1
        5
    }
    s.total += record()
    assert_eq(s.count, 1)
    assert_eq(s.total, 15)
}
