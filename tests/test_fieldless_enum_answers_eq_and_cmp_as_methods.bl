// A fieldless enum is `Eq` and `Ord` with no derive, by variant and in declaration order, and
// this is the real instance: `.eq()` and `.cmp()` work, the qualified calls work, and an `Eq`
// or `Ord` bound accepts the enum (sections/03_types.md *Enums*, *Enum Ord*).

type FeColor {
    Red
    Green
    Blue
}

fn fe_same[T: Eq](a: T, b: T) -> Bool {
    a.eq(b)
}

fn fe_same_qualified[T: Eq](a: T, b: T) -> Bool {
    Eq.eq(a, b)
}

fn fe_less[T: Ord](a: T, b: T) -> Bool {
    a < b
}

fn fe_order[T: Ord](a: T, b: T) -> Ordering {
    a.cmp(b)
}

test "eq and cmp as methods compare the variant" {
    assert(FeColor.Red.eq(FeColor.Red))
    assert(!FeColor.Red.eq(FeColor.Green))
    assert_eq(FeColor.Red.cmp(FeColor.Blue), Ordering.Less)
    assert_eq(FeColor.Blue.cmp(FeColor.Green), Ordering.Greater)
    assert_eq(FeColor.Green.cmp(FeColor.Green), Ordering.Equal)
}

test "the qualified eq and cmp compare the variant" {
    assert(Eq.eq(FeColor.Green, FeColor.Green))
    assert(!Eq.eq(FeColor.Green, FeColor.Blue))
    assert_eq(Ord.cmp(FeColor.Red, FeColor.Green), Ordering.Less)
}

test "an Eq or Ord bound accepts a fieldless enum" {
    assert(fe_same(FeColor.Blue, FeColor.Blue))
    assert(!fe_same(FeColor.Blue, FeColor.Red))
    assert(fe_same_qualified(FeColor.Red, FeColor.Red))
    assert(fe_less(FeColor.Red, FeColor.Blue))
    assert(!fe_less(FeColor.Blue, FeColor.Red))
    assert_eq(fe_order(FeColor.Green, FeColor.Red), Ordering.Greater)
}
