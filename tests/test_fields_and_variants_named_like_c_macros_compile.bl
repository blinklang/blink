// A struct field, an enum variant, a variant's named field and an effect operation are
// all names the program chose, so each must compile whatever macro a C header in the unit
// defines by the same name. Each derive reads every one of them.

import std.json

@derive(Eq, Hash, Ord, Debug, Clone, Serialize, Deserialize)
type Flags { EINVAL: Int, POLLIN: Int, errno: Int, stdout: Int }

@derive(Eq, Hash, Ord, Debug, Clone, Serialize, Deserialize)
type Fault {
    EINVAL(Int)
    EAGAIN { minor: Int, errno: Int }
    SIGTERM
}

effect Probe {
    effect Ask {
        fn errno() -> Int
        fn EINVAL(n: Int) -> Int
    }
}

fn describe(f: Fault) -> Int {
    match f {
        Fault.EINVAL(n) => n
        Fault.EAGAIN { minor, errno } => minor + errno
        Fault.SIGTERM => 15
    }
}

test "struct fields named like macros: literal, read, write, copy-update" {
    let mut f = Flags { EINVAL: 22, POLLIN: 1, errno: 4, stdout: 1 }
    f.errno = f.errno + 1
    let g = Flags { POLLIN: 2, ..f }
    assert_eq(f.EINVAL + f.errno + g.POLLIN + g.stdout, 30)
}

test "variants and variant fields named like macros: construct, match, compare" {
    let a = Fault.EINVAL(22)
    let b = Fault.EAGAIN { minor: 3, errno: 11 }
    assert_eq(describe(a) + describe(b) + describe(Fault.SIGTERM), 51)
    assert(a == Fault.EINVAL(22))
    assert(b != Fault.EAGAIN { minor: 3, errno: 12 })
    assert(a < b)
}

test "every derive reads fields named like macros" {
    let f = Flags { EINVAL: 22, POLLIN: 1, errno: 4, stdout: 1 }
    let c = f.clone()
    assert(c == f)
    assert(f.hash() == c.hash())
    assert(f.debug().contains("EINVAL: 22"))
    let back = Flags.from_json(f.to_json()).unwrap()
    assert(back == f)
    let b = Fault.EAGAIN { minor: 3, errno: 11 }
    assert(b.clone() == b)
    assert(b.hash() == b.clone().hash())
    assert(b.debug().contains("EAGAIN"))
    assert(Fault.from_json(b.to_json()).unwrap() == b)
}

// The C spelling is not the program's: debug text and JSON keys still use the Blink names.
test "derived text names each field and variant as the program wrote it" {
    let f = Flags { EINVAL: 22, POLLIN: 1, errno: 4, stdout: 1 }
    let j = f.to_json()
    assert(j.contains("\"EINVAL\":"), "got: {j}")
    assert(j.contains("\"errno\":"), "got: {j}")
    assert(!j.contains("b_"), "got: {j}")
    let k = Fault.EAGAIN { minor: 3, errno: 11 }.to_json()
    assert(k.contains("EAGAIN"), "got: {k}")
    assert(k.contains("\"errno\":"), "got: {k}")
    assert(!k.contains("b_"), "got: {k}")
    assert_eq(Fault.EAGAIN { minor: 3, errno: 11 }.debug(), "EAGAIN(3, 11)")
    assert(f.debug().contains("errno: 4"))
}

test "a field named like a macro as a map key" {
    let mut m: Map[Flags, Int] = Map.new()
    m.insert(Flags { EINVAL: 1, POLLIN: 2, errno: 3, stdout: 4 }, 7)
    assert_eq(m.get(Flags { EINVAL: 1, POLLIN: 2, errno: 3, stdout: 4 }) ?? 0, 7)
}

test "effect operations named like macros" {
    with handler Probe {
        fn errno() -> Int { 5 }
        fn EINVAL(n: Int) -> Int { n + 22 }
    } {
        assert_eq(probe.errno() + probe.EINVAL(1), 28)
    }
}
