// A fix can have more than one edit, such as a call rewrite and the import the new call needs.
// `blink fix` applies every edit of such a fix or none of them: half a fix leaves a file that
// does not compile (sections/06_tooling.md §8.6 *Applying fixes*). An edit that two fixes
// share still applies once.

import fix_edits.{FixEdit, fix_plan, fix_apply}

fn edit(diag: Int, start: Int, end: Int, text: Str) -> FixEdit {
    FixEdit { file: "a.bl", start: start, end: end, text: text, diag: diag }
}

test "both edits of a fix apply, and the fix counts once" {
    let plan = fix_plan([edit(0, 10, 15, "b"), edit(0, 0, 0, "i\n")])
    assert_eq(plan.applied.len(), 2)
    assert_eq(plan.fixed, [0])
    assert_eq(plan.conflicts.len(), 0)
    assert_eq(fix_apply("0123456789aaaaa\n", plan.applied), "i\n0123456789b\n")
}

test "a conflict on one edit of a fix drops its other edit too" {
    let plan = fix_plan([edit(0, 10, 15, "b"), edit(0, 0, 0, "i\n"), edit(1, 12, 13, "c")])
    assert_eq(plan.applied.len(), 0)
    assert_eq(plan.fixed.len(), 0)
    assert_eq(plan.conflicts.len(), 2)
    assert_eq(plan.conflicts.get(0).unwrap().diag, 0)
    assert_eq(plan.conflicts.get(0).unwrap().other, 1)
    assert_eq(plan.conflicts.get(1).unwrap().diag, 1)
}

test "an edit that two fixes share applies once, with the other edits of both" {
    let plan = fix_plan([edit(0, 10, 15, "b"), edit(0, 0, 0, "i\n"), edit(1, 20, 25, "d"), edit(1, 0, 0, "i\n")])
    assert_eq(plan.applied.len(), 3)
    assert_eq(plan.fixed, [0, 1])
    assert_eq(fix_apply("0123456789aaaaa-----ccccc\n", plan.applied), "i\n0123456789b-----d\n")
}

test "a shared edit still applies when the fix that first carried it is dropped" {
    let plan = fix_plan([edit(0, 10, 15, "b"), edit(0, 0, 0, "i\n"), edit(1, 12, 13, "c"), edit(2, 0, 0, "i\n"), edit(2, 20, 25, "d")])
    assert_eq(plan.fixed, [2])
    assert_eq(fix_apply("0123456789aaaaa-----ccccc\n", plan.applied), "i\n0123456789aaaaa-----d\n")
}
