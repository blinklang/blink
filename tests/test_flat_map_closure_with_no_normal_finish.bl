// A closure that never finishes answers to any carrier and names no element (sections/03_types.md
// *Never*), so what follows a flat_map over it gets its element from an expected type or from an
// E0301. It never reaches codegen with the element open.

import compile_test_helpers

fn open_element(body: Str, tag: Str) ! FS.Delete, FS.Write, Process.Spawn, FS.Read, Env.Read, IO.Print {
    let out = compile_test_helpers.compile_and_capture("fn main() \{ let xs = [1]\n {body} }\n", tag)
    compile_test_helpers.expect_error(out, "E0301", tag)
    assert(!out.contains("internal compiler error"), out)
}

test "a use that names no element is E0301" {
    open_element("let _ = xs.flat_map(fn(x) \{ panic(\"no\") }).len()", "fmn_len")
    open_element("xs.flat_map(fn(x) \{ panic(\"no\") })", "fmn_stmt")
    open_element("let _ = xs.into_iter().flat_map(fn(x) \{ panic(\"no\") }).count()", "fmn_it_count")
    open_element("let _ = xs.flat_map(fn(x) \{ [] }).len()", "fmn_empty_list")
}

test "a binding that names no element is E0301 at the call" {
    let out = compile_test_helpers.compile_and_capture("fn main() \{ let xs = [1]\n let e = xs.flat_map(fn(x) \{ panic(\"no\") })\n io.println(\"\{e.len()}\") }\n", "fmn_let")
    compile_test_helpers.expect_error(out, "E0301", "fmn_let")
    compile_test_helpers.expect_contains(out, "`xs.flat_map()` call", "fmn_let")
}

test "a declared list gives the element" {
    let xs: List[Int] = []
    let a: List[Int] = xs.flat_map(fn(x) { panic("no") })
    assert_eq(a.len(), 0)
}

test "a declared iterator gives the element" {
    let xs: List[Int] = []
    let a: Iterator[Int] = xs.into_iter().flat_map(fn(x) { panic("no") })
    assert_eq(a.count(), 0)
}
