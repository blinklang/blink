import compile_test_helpers

// flat_map yielding a container-typed element (List[Set[Int]]) must produce
// an iterator whose element type the nested for-in can actually consume.

fn flat_map_container_element_src() -> Str {
    #"fn main() ! IO {
    let base: List[Int] = [1, 2]
    let it = base.into_iter().flat_map(fn(x: Int) -> List[Set[Int]] {
        let mut s: Set[Int] = Set()
        s.insert(x)
        [s]
    })
    let mut total = 0
    for g in it { for v in g { total = total + v } }
    io.println("total={total}")
}
"#
}

test.failing(
    "flat_map yielding a container element compiles and sums through nested for-in",
    reason: "typecheck does not solve the output type parameter U of flat_map when the closure returns a List of Set, so mono stops with ICE MonoUnsolvedTypeParam",
) {
    let r = compile_test_helpers.compile_and_run(flat_map_container_element_src(), "_flatmap_container")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "total=3\n")
}
