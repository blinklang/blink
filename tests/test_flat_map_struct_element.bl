// flat_map whose closure returns a List of a STRUCT element must thread the element type
// through the flattened List tid, so a downstream `.get(i).unwrap().field` reads the real
// field. Without the element tid the result collapses to List[?] and codegen names a flat
// carrier that erases the struct, so field access reads garbage.
//
// The flattened P elements live in a heap List and are read by pointer, so the by-value
// multi-eightbyte struct-return truncation that blocks `.map` here does not apply.

type FmPoint { x: Int, y: Int }

fn fan(p: FmPoint) -> List[FmPoint] {
    let mut r: List[FmPoint] = []
    r.push(p)
    r.push(FmPoint { x: p.x + 100, y: p.y + 100 })
    r
}

test "flat_map over a struct element reads fields through the threaded tid" {
    let ps: List[FmPoint] = [FmPoint { x: 1, y: 2 }, FmPoint { x: 3, y: 4 }]
    let out = ps.flat_map(fn(p: FmPoint) -> List[FmPoint] { fan(p) })
    assert_eq(out.len(), 4)
    assert_eq(out.get(0).unwrap().x, 1)
    assert_eq(out.get(1).unwrap().x, 101)
    assert_eq(out.get(1).unwrap().y, 102)
    assert_eq(out.get(2).unwrap().x, 3)
    assert_eq(out.get(3).unwrap().x, 103)
}
