// The Float bit methods sections/03_types.md "Float Bits" defines: `to_bits` reads the IEEE
// 754 binary64 pattern as a U64, `Float.from_bits` writes one back, and `is_sign_negative`
// reads the sign bit. The laws covered here are the round trip (every pattern comes back,
// signaling NaNs included), bits being finer than `==`, and the sign test. The copy law has
// its own file, tests/test_float_bits_survive_copies_fields_lists_and_ffi.bl.
//
// No literal here reaches 0x8000000000000000: a pattern with the sign bit set is built from
// the bits of -0.0. Each pattern constant is bound to a U64 before it is returned or used
// with `|`, since a bare literal there types as Int.

// Built rather than written, so the value is a run-time value and not a literal the front
// end could fold.
fn zero() -> Float { 0.0 }

fn neg_zero() -> Float { zero() * -1.0 }

fn sign_bit() -> U64 { neg_zero().to_bits() }

// 0x7FF0000000000001: the exponent all ones, the quiet bit clear, payload 1.
fn signaling_nan_bits() -> U64 {
    let b: U64 = 9218868437227405313
    b
}

// 0x7FF8000000000001: the quiet bit set, payload 1.
fn quiet_nan_bits() -> U64 {
    let b: U64 = 9221120237041090561
    b
}

// 0x3FF0000000000000
fn one_bits() -> U64 {
    let b: U64 = 4607182418800017408
    b
}

test "to_bits reads the binary64 pattern" {
    assert(zero().to_bits() == 0)
    assert(1.0.to_bits() == one_bits())
    assert((1.5).to_bits() == 4609434218613702656)
    assert((-1.0).to_bits() == sign_bit() | one_bits())
}

test "from_bits writes the binary64 pattern" {
    assert(Float.from_bits(one_bits()) == 1.0)
    assert(Float.from_bits(sign_bit() | one_bits()) == -1.0)
    let z: U64 = 0
    assert(Float.from_bits(z) == 0.0)
    assert(!Float.from_bits(z).is_sign_negative())
}

test "a signaling NaN keeps every bit through from_bits and to_bits" {
    let b = signaling_nan_bits()
    let x = Float.from_bits(b)
    assert(x.to_bits() == b)
    assert(!x.ieee_eq(x))
}

test "a negative quiet NaN keeps its sign and payload" {
    let b = sign_bit() | quiet_nan_bits()
    let x = Float.from_bits(b)
    assert(x.to_bits() == b)
    assert(x.is_sign_negative())
}

test "a negative signaling NaN keeps its sign and payload" {
    let b = sign_bit() | signaling_nan_bits()
    assert(Float.from_bits(b).to_bits() == b)
}

test "the round trip holds for patterns at both ends of the range" {
    let low_63: U64 = 9223372036854775807
    let max_u64 = sign_bit() | low_63
    assert(Float.from_bits(max_u64).to_bits() == max_u64)
    assert(Float.from_bits(sign_bit()).to_bits() == sign_bit())
    let tiny: U64 = 1
    assert(Float.from_bits(tiny).to_bits() == tiny)
}

test "-0.0 equals 0.0 while their bits differ" {
    assert(neg_zero() == zero())
    assert(neg_zero().to_bits() != zero().to_bits())
    assert(neg_zero().to_bits() == sign_bit())
    let lit = -0.0
    assert(lit == 0.0)
    assert(lit.to_bits() != 0.0.to_bits())
}

test "two NaNs with different payloads are == while their bits differ" {
    let a = Float.from_bits(quiet_nan_bits())
    let b = Float.from_bits(signaling_nan_bits())
    assert(a == b)
    assert(a.to_bits() != b.to_bits())
}

test "is_sign_negative is true exactly when the sign bit is set" {
    assert(neg_zero().is_sign_negative())
    assert((-0.0).is_sign_negative())
    assert((-1.0).is_sign_negative())
    assert(Float.from_bits(sign_bit() | quiet_nan_bits()).is_sign_negative())
    assert(!zero().is_sign_negative())
    assert(!0.0.is_sign_negative())
    assert(!1.0.is_sign_negative())
    assert(!Float.from_bits(quiet_nan_bits()).is_sign_negative())
}

test "an untyped integer literal takes U64 as the argument of from_bits" {
    let nan = Float.from_bits(9221120237041090561)
    assert(nan == zero() / zero())
    assert(nan.to_bits() == 9221120237041090561)
}

test "an untyped integer literal takes U64 on one side of ==" {
    let u: U64 = quiet_nan_bits()
    assert(u == 9221120237041090561)
    assert(9221120237041090561 == u)
}
