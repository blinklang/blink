// sections/03_types.md "Float Bits", the copy law: a copy, a move, storage, and passing to
// or from an `@ffi` function keep every bit of a Float. A signaling NaN is the value a
// float load or an arithmetic step would quiet, so each row carries one, and a negative
// quiet NaN with a payload, through one of those paths and reads the bits back.
//
// tests/test_float_bits_survive_an_o2_build_in_one_unit_and_per_module.bl runs the same
// paths in a -O2 build.

// copysign is a bit operation (IEEE 754 §5.5.1), so with both arguments the same value it
// answers that value with every bit kept; libc has no plainer identity on a double.
@ffi("m", "copysign")
@trusted(audit: "TEST-FLOAT-BITS-FFI-IDENTITY")
fn c_copysign(x: Float, y: Float) -> Float ! () { }

type Holder { value: Float }

fn sign_bit() -> U64 { (-0.0).to_bits() }

// Bound before it is returned or used with `|`, since a bare literal there types as Int.
fn signaling_nan_bits() -> U64 {
    let b: U64 = 9218868437227405313
    b
}

fn negative_quiet_nan_bits() -> U64 {
    let quiet: U64 = 9221120237041090561
    sign_bit() | quiet
}

fn patterns() -> List[U64] { [signaling_nan_bits(), negative_quiet_nan_bits(), sign_bit()] }

fn pass_through(x: Float) -> Float { x }

test "a let copy keeps every bit" {
    for b in patterns() {
        let x = Float.from_bits(b)
        let y = x
        let mut z = 1.0
        z = y
        assert(y.to_bits() == b)
        assert(z.to_bits() == b)
    }
}

test "a function argument and return keep every bit" {
    for b in patterns() {
        assert(pass_through(Float.from_bits(b)).to_bits() == b)
    }
}

test "a struct field keeps every bit" {
    for b in patterns() {
        let h = Holder { value: Float.from_bits(b) }
        let copy = h
        assert(h.value.to_bits() == b)
        assert(copy.value.to_bits() == b)
    }
}

test "a List element keeps every bit" {
    let mut xs: List[Float] = []
    for b in patterns() { xs.push(Float.from_bits(b)) }
    let mut i = 0
    for b in patterns() {
        assert(xs.get(i).unwrap().to_bits() == b)
        i = i + 1
    }
}

test "an @ffi call keeps every bit going in and coming out" {
    for b in patterns() {
        let x = Float.from_bits(b)
        assert(c_copysign(x, x).to_bits() == b)
    }
}
