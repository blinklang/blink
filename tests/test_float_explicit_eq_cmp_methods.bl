// `x.eq(y)` and `x.cmp(y)` on a Float are the same total order the operators use
// (sections/03_types.md "Float Total Ordering"): NaN equals NaN and sorts above every other
// value, +inf included, and -0.0 equals 0.0.

fn zero() -> Float { 0.0 }

fn nan() -> Float { zero() / zero() }

fn inf() -> Float { 1.0 / zero() }

fn neg_zero() -> Float { zero() * -1.0 }

fn order_of[T: Ord](a: T, b: T) -> Ordering { a.cmp(b) }

fn equal_to[T: Eq](a: T, b: T) -> Bool { a.eq(b) }

test "eq on a Float answers for less, equal and greater" {
    let a = 1.0
    let b = 2.0
    assert(!a.eq(b))
    assert(!b.eq(a))
    assert(a.eq(1.0))
}

test "cmp on a Float answers Less, Equal and Greater" {
    let a = 1.0
    let b = 2.0
    assert(a.cmp(b) == Less)
    assert(a.cmp(1.0) == Equal)
    assert(b.cmp(a) == Greater)
}

test "NaN equals itself and sorts above infinity through the methods" {
    let n = nan()
    assert(n.eq(n))
    assert(!n.eq(1.0))
    assert(!inf().eq(n))
    assert(n.cmp(inf()) == Greater)
    assert(inf().cmp(n) == Less)
    assert(n.cmp(n) == Equal)
    assert(n.cmp(1.0) == Greater)
}

test "negative zero equals zero through the methods" {
    let nz = neg_zero()
    assert(nz.eq(0.0))
    assert(nz.cmp(0.0) == Equal)
    assert(zero().cmp(nz) == Equal)
}

test "the methods agree with the operators on every pair" {
    let vals = [nan(), inf(), -1.0 * inf(), neg_zero(), 0.0, 1.0, -2.5]
    for a in vals {
        for b in vals {
            assert(a.eq(b) == (a == b))
            assert((a.cmp(b) == Less) == (a < b))
            assert((a.cmp(b) == Greater) == (a > b))
            assert((a.cmp(b) == Equal) == (a == b))
        }
    }
}

test "an Ord bound on Float orders by the total order" {
    assert(order_of(nan(), 1.0) == Greater)
    assert(order_of(1.0, nan()) == Less)
    assert(order_of(nan(), nan()) == Equal)
    assert(order_of(neg_zero(), 0.0) == Equal)
    assert(order_of(1.0, 2.0) == Less)
}

test "an Eq bound on Float equates NaN with itself" {
    assert(equal_to(nan(), nan()))
    assert(equal_to(neg_zero(), 0.0))
    assert(!equal_to(1.0, 2.0))
}
