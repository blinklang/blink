// The total order sections/03_types.md "Float Total Ordering" gives a bare Float: NaN
// equals NaN, NaN sorts greater than every other value, and -0.0 equals 0.0. C's own
// operators answer none of the NaN rows, so every site that compares a Float must go
// through the runtime helpers. tests/test_float_total_ordering.bl covers the same order
// through a derived Eq and Ord; this file covers the operators, generics, contains, the
// assert family, and the IEEE escape `ieee_eq`.

import std.float.{close_to, is_nan}

// Built rather than written, so the value is a run-time value and not a literal the front
// end could fold into a comparison of its own.
fn zero() -> Float { 0.0 }

fn nan() -> Float { zero() / zero() }

fn inf() -> Float { 1.0 / zero() }

fn neg_zero() -> Float { zero() * -1.0 }

fn same[T: Eq](a: T, b: T) -> Bool { a == b }

fn before[T: Ord](a: T, b: T) -> Bool { a < b }

fn least[T: Ord](a: T, b: T) -> T { if b < a { b } else { a } }

test "NaN equals NaN through the operators" {
    let n = nan()
    assert(n == n)
    assert(nan() == nan())
    assert(!(n != n))
}

test "NaN sorts greater than every other value, infinity included" {
    let n = nan()
    assert(n > 1.0)
    assert(n > inf())
    assert(1.0 < n)
    assert(inf() < n)
    assert(!(n < 1.0))
    assert(n >= inf())
    assert(!(n <= inf()))
}

test "two NaNs order equal" {
    let n = nan()
    assert(!(n < n))
    assert(!(n > n))
    assert(n <= n)
    assert(n >= n)
}

test "negative zero equals positive zero and neither sorts first" {
    assert(neg_zero() == zero())
    assert(!(neg_zero() != zero()))
    assert(!(neg_zero() < zero()))
    assert(!(neg_zero() > zero()))
    assert(neg_zero() <= zero())
}

test "an ordinary pair still compares by value" {
    let a = 1.0
    let b = 2.0
    assert(a < b)
    assert(b > a)
    assert(a <= a)
    assert(a != b)
    assert(a == 1.0)
}

test "a generic body at T = Float uses the same total order" {
    let n = nan()
    assert(same(n, n))
    assert(same(neg_zero(), zero()))
    assert(before(1.0, n))
    assert(!before(n, inf()))
    assert(least(n, 1.0) == 1.0)
    assert(least(n, n) == n)
}

test "contains finds NaN and finds 0.0 for -0.0" {
    let xs = [1.0, nan()]
    assert(xs.contains(nan()))
    assert([zero()].contains(neg_zero()))
    assert(!xs.contains(2.0))
}

test "assert_eq and assert_ne use the total order" {
    assert_eq(nan(), nan())
    assert_eq(neg_zero(), zero())
    assert_ne(nan(), 1.0)
}

test "ieee_eq is the IEEE 754 comparison" {
    let n = nan()
    assert(!n.ieee_eq(n))
    let one = 1.0
    assert(!n.ieee_eq(one))
    assert(one.ieee_eq(1.0))
    assert(!one.ieee_eq(2.0))
}

test "is_nan still finds NaN and only NaN" {
    assert(is_nan(nan()))
    assert(!is_nan(1.0))
    assert(!is_nan(inf()))
    assert(!is_nan(neg_zero()))
}

test "close_to keeps its contract" {
    assert(!close_to(nan(), nan(), 1.0))
    assert(!close_to(1.0, 1.0, nan()))
    assert(!close_to(1.0, 1.0, -1.0))
    assert(close_to(neg_zero(), zero(), 0.0))
    assert(close_to(inf(), inf(), 0.0))
    assert(!close_to(inf(), zero() - inf(), 1.0))
    assert(close_to(1.0, 1.05, 0.1))
}
