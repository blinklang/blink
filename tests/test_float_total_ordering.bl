// The total order the language gives a Float, exercised through a derived Eq and Ord.
// sections/03_types.md "Float Total Ordering": NaN equals NaN, NaN sorts greater than
// every other value, and -0.0 equals 0.0. IEEE 754 agrees with none of the first two, so
// the C operators cannot answer these on their own and the runtime helpers do it instead.
//
// This file runs the behaviour. The tests that pin which helper the derive calls are in
// tests/test_cg_derive_eq_bodies.bl and tests/test_cg_derive_ord_bodies.bl, because the
// codegen rewrite cannot emit C yet and those run in process.
//
// Every value here is read through a derived Eq and Ord. The same order on a bare Float
// (the operators, generics, contains, assert_eq) is in tests/test_float_total_equality.bl.

@derive(Eq, Ord)
type Reading { v: Float }

// Built rather than written, so the reader is a value at run time and not a literal the
// front end could fold into a comparison of its own.
fn zero() -> Float { 0.0 }

fn nan() -> Float { zero() / zero() }

fn neg_zero() -> Float { zero() * -1.0 }

fn r(x: Float) -> Reading { Reading { v: x } }

test "NaN equals NaN, so a reading equals itself" {
    assert(r(nan()) == r(nan()))
    assert(!(r(nan()) != r(nan())))
}

test "NaN sorts greater than every other value" {
    assert(r(nan()) > r(1.0))
    assert(r(nan()) > r(0.0))
    assert(r(1.0) < r(nan()))
    assert(!(r(nan()) < r(1.0)))
}

test "two NaNs are neither less nor greater, so they order equal" {
    assert(!(r(nan()) < r(nan())))
    assert(!(r(nan()) > r(nan())))
    assert(r(nan()) <= r(nan()))
    assert(r(nan()) >= r(nan()))
}

test "negative zero equals positive zero and neither sorts before the other" {
    assert(r(neg_zero()) == r(zero()))
    assert(!(r(neg_zero()) < r(zero())))
    assert(!(r(neg_zero()) > r(zero())))
}

test "an ordinary pair still orders by value" {
    assert(r(1.0) < r(2.0))
    assert(r(2.0) > r(1.0))
    assert(r(1.0) == r(1.0))
    assert(r(1.0) != r(2.0))
}

// Equality and order must answer the same question: a pair the order calls equal must not
// be a pair equality calls different. NaN and -0.0 are the two pairs where IEEE splits
// them, so a derive that routed one through a helper and the other through an operator
// would disagree with itself.
test "equality and order agree on every pair IEEE splits" {
    assert((r(nan()) == r(nan())) == (!(r(nan()) < r(nan())) && !(r(nan()) > r(nan()))))
    assert((r(neg_zero()) == r(zero())) == (!(r(neg_zero()) < r(zero())) && !(r(neg_zero()) > r(zero()))))
}
