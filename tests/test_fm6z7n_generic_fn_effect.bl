import test_fm6z7n_generic_fn_effect_helper { fm6_emit, FmTele, FmPoint }

// Repro for fm6z7n: generic fn monomorphizations must propagate the
// `! Effect` annotation from the generic source so internal effecting
// calls don't trigger UndeclaredEffect (E0500).
//
// fm6_identity[T] declares `! FmTele.Emit` and calls fm6_emit (also
// `! FmTele.Emit`). Before the fix, monomorphs were registered with
// empty effect sets and the call to fm6_emit inside fm6_identity_Int /
// fm6_identity_FmPoint failed effect propagation.

pub fn fm6_identity[T](x: T) -> T ! FmTele.Emit {
    fm6_emit("tag", 0)
    x
}

test "generic fn ! Effect monomorph propagates effect annotation (Int)" {
    with handler FmTele {
        fn record(_name: Str, _value: Int) { }
    } {
        let n = fm6_identity(42)
        assert_eq(n, 42)
    }
}

test "generic fn ! Effect monomorph propagates effect annotation (user struct)" {
    with handler FmTele {
        fn record(_name: Str, _value: Int) { }
    } {
        let p = fm6_identity(FmPoint { x: 3, y: 4 })
        assert_eq(p.x, 3)
        assert_eq(p.y, 4)
    }
}
