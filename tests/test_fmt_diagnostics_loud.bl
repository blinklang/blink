// Regression: formatter mode (`blink fmt` / `--format blink`)
// must surface parser diagnostics — non-zero exit + diags on stderr —
// instead of silently writing corrupt output and exiting 0.
import compile_test_helpers

fn main() {
    let base = "{compile_test_helpers.scratch_root()}/fmt_diagnostics_loud"
    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {base}"]).unwrap()
    let blink = "{env.cwd()}/build/blink"

    // Deliberate parse error: stray `)` inside the return expression.
    fs.write("{base}/bad.bl", "fn main() -> Int \{\n    return 1)\n}\n").unwrap()

    let result = process.run("sh", ["-c", "cd {base} && {blink} fmt bad.bl > out.txt 2>err.txt; echo rc=$?"]).unwrap()
    let combined = "{result.out}{result.err_out}"
    let err = fs.read("{base}/err.txt").unwrap()

    if combined.contains("rc=0") {
        io.println("FAIL: blink fmt on parse error exited 0; stderr was: {err}")
    } else {
        io.println("PASS: blink fmt on parse error exited non-zero")
    }

    if err.len() == 0 {
        io.println("FAIL: blink fmt on parse error produced empty stderr")
    } else {
        io.println("PASS: blink fmt on parse error wrote diagnostics to stderr")
    }

    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
}
