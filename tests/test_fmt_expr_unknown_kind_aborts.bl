// The formatter lays out an expression by its node kind. A kind it has no layout for must
// stop the run and name the kind: answering an empty string writes a file with that code
// deleted, and `blink fmt` then reports success.
//
// The stop ends the process, so the test runs this binary again as a child with `probe`,
// and main formats a parameter node, a kind that is never an expression.

import compiler.{compile_to_program}
import parser.{node_count, node_kind, node_name}
import ast.{NodeKind, nk_of}
import formatter.{format_expr}
import std.io

// The node pool grows across probes, so the last node of the kind is this probe's.
fn last_node_named(kind: NodeKind, name: Str) -> Int {
    let mut i = node_count() - 1
    while i >= 0 {
        if nk_of(node_kind(i)) == kind && node_name(i) == name { return i }
        i = i - 1
    }
    -1
}

fn format_a_param() ! Lex.Tokenize, Parse, Parse.Build, Diag.Report {
    let path = "build/fmt_unknown_kind_probe.bl"
    write_file(path, "fn probe(fmt_subject: Int) -> Int \{\n    fmt_subject\n}\n\nfn main() \{\n    let _ = probe(1)\n}\n")
    let _program = compile_to_program(path, 1)
    let _rm = process_run("rm", ["-f", path])
    let param = last_node_named(NodeKind.Param, "fmt_subject")
    if param < 0 {
        io.eprintln("probe: no parameter node named fmt_subject")
        exit(2)
    }
    io.println("formatted as: '{format_expr(param)}'")
}

fn main() {
    let args = env.args()
    if args.len() > 1 && args.get(1).unwrap() == "probe" { format_a_param() }
}

test "a node kind with no expression layout stops the formatter and names the kind" {
    let r = process_run(env.args().get(0).unwrap(), ["probe"])
    if r.exit_code != 101 {
        io.println("child exit {r.exit_code}, stdout: {r.out}, stderr: {r.err_out}")
    }
    assert_eq(r.exit_code, 101)
    assert(r.err_out.contains("no expression layout for node kind Param"))
    assert(!r.out.contains("formatted as"))
}
