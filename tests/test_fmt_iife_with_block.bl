type Connection { fd: Int }
type IIFEErr { msg: Str }
impl Closeable for Connection { fn close(_self) {} }

fn open_conn() -> Result[Connection, IIFEErr] { Ok(Connection { fd: 7 }) }

test "iife with `with..? as` body is reparseable after format" {
  let result = fn() -> Result[Int, IIFEErr] {
    with open_conn()? as conn { Ok(conn.fd) }
  }()
  match result {
    Ok(v) => { assert(v == 7) }
    Err(_) => { assert(false) }
  }
}

test "empty body IIFE stays inline" {
  let v = fn() -> Int { 0 }()
  assert(v == 0)
}

test "iife with args formats and runs" {
  let r = fn(x: Int) -> Result[Int, IIFEErr] {
    with open_conn()? as conn { Ok(conn.fd + x) }
  }(3)
  match r {
    Ok(v) => { assert(v == 10) }
    Err(_) => { assert(false) }
  }
}

fn iife_runner(f: fn() -> Result[Int, IIFEErr]) -> Result[Int, IIFEErr] {
  f()
}

test "method-call IIFE shape via fn-passing" {
  let r = iife_runner(fn() -> Result[Int, IIFEErr] {
    with open_conn()? as conn { Ok(conn.fd) }
  })
  match r {
    Ok(v) => { assert(v == 7) }
    Err(_) => { assert(false) }
  }
}

test "nested iifes with with-blocks" {
  let outer = fn() -> Result[Int, IIFEErr] {
    let inner = fn() -> Result[Int, IIFEErr] {
      with open_conn()? as c { Ok(c.fd) }
    }()
    match inner {
      Ok(v) => Ok(v + 1)
      Err(e) => Err(e)
    }
  }()
  match outer {
    Ok(v) => { assert(v == 8) }
    Err(_) => { assert(false) }
  }
}
