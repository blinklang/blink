// Regression: formatter must preserve escaped quotes inside a
// test-block name. Input `test "a\"b" {}` was being re-emitted as
// `test "a"b" {}` (unparseable) because format_test_block emitted the
// parser-decoded name without routing through fmt_escape_str_literal.

import compile_test_helpers

fn main() {
    let blink_root = process.run("sh", ["-c", "pwd -P"]).unwrap().out.trim_right()
    let blinkc = "{blink_root}/build/blinkc"

    let base = "{compile_test_helpers.scratch_root()}/_test_fmt_test_name_quote_escape"
    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {base}"]).unwrap()

    let src_path = "{base}/in.bl"
    let src_body = "test \"a\\\"b\" \{\n    assert_eq(1, 1)\n\}\n"
    fs.write(src_path, src_body).unwrap()

    let fmt1_path = "{base}/fmt1.bl"
    let r1 = process.run(blinkc, [src_path, fmt1_path, "--emit", "blink"]).unwrap()
    if !r1.success() {
        io.println("FAIL: blinkc --emit blink (pass 1) ended with {r1.end}: {r1.out}")
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        return
    }
    let fmt1 = fs.read(fmt1_path).unwrap()

    if !fmt1.contains("\\\"") {
        io.println("FAIL: formatted output dropped `\\\"` escape — got: {fmt1}")
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        return
    }

    let fmt2_path = "{base}/fmt2.bl"
    let r2 = process.run(blinkc, [fmt1_path, fmt2_path, "--emit", "blink"]).unwrap()
    if !r2.success() {
        io.println("FAIL: blinkc --emit blink (pass 2) ended with {r2.end}: {r2.out}")
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        return
    }
    let fmt2 = fs.read(fmt2_path).unwrap()
    if fmt1 != fmt2 {
        io.println("FAIL: formatter not idempotent")
        io.println("pass 1: {fmt1}")
        io.println("pass 2: {fmt2}")
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        return
    }

    io.println("PASS: formatter preserves test-name quote escape and round-trips")
    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
}
