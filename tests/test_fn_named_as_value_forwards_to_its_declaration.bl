// A top-level function named as a value is a closure that forwards to the function. The
// closure ABI passes the record first and a plain function takes no record, so the value
// has to be a thunk that calls the declaration, not the declaration's own symbol.

import test_fn_named_as_value_helper.{fnv_triple}
import test_fm6z7n_generic_fn_effect_helper { fm6_emit, FmTele }

type FnvModel { x: Int }

fn fnv_bump(m: FnvModel) -> FnvModel { FnvModel { x: m.x + 1 } }
fn fnv_double(n: Int) -> Int { n * 2 }
fn fnv_add(a: Int, b: Int) -> Int { a + b }

// Module globals: a named function cannot reach a test's locals, and a handler operation
// cannot capture one yet.
let mut fnv_runs: Int = 0
let mut fnv_seen: Int = 0

fn fnv_note(n: Int) { fnv_runs = fnv_runs + n }

fn fnv_apply(m: FnvModel, f: fn(FnvModel) -> FnvModel) -> FnvModel { f(m) }
fn fnv_apply_int(n: Int, f: fn(Int) -> Int) -> Int { f(n) }
fn fnv_apply2(a: Int, b: Int, f: fn(Int, Int) -> Int) -> Int { f(a, b) }
fn fnv_run(n: Int, f: fn(Int)) { f(n) }

test "a function passed by name forwards a struct argument and result" {
    assert_eq(fnv_apply(FnvModel { x: 1 }, fnv_bump).x, 2)
}

test "a function bound to a let is called through the binding" {
    let g = fnv_double
    assert_eq(g(21), 42)
}

test "a two-parameter function forwards both arguments in order" {
    assert_eq(fnv_apply2(10, 3, fnv_add), 13)
}

test "a function that returns nothing is called for its effect" {
    fnv_run(2, fnv_note)
    assert_eq(fnv_runs, 2)
}

test "a function selected from another module is named as a value" {
    assert_eq(fnv_apply_int(4, fnv_triple), 12)
}

fn fnv_tick(n: Int) -> Int ! FmTele.Emit {
    fm6_emit("tick", n)
    n + 1
}

fn fnv_apply_eff(n: Int, f: fn(Int) -> Int) -> Int ! FmTele.Emit { f(n) }

test "a function with a declared effect reaches the handler installed around the call" {
    with handler FmTele {
        fn record(_n: Str, v: Int) { fnv_seen = v }
    } {
        assert_eq(fnv_apply_eff(7, fnv_tick), 8)
    }
    assert_eq(fnv_seen, 7)
}
