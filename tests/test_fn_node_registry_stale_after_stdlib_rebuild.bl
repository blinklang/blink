// Regression for ms8q16: a stale fn_node_registry id leaking from the
// in-process stdlib archive compile into a subsequent fixture compile.
// BLINK_FORCE_STDLIB_REBUILD=1 forces the in-process stdlib compile (compile #1)
// ahead of the fixture compile (compile #2) in the SAME process — deterministic repro.
//
// The child runs in an isolated scratch cwd with its own build/ so the forced
// rebuild writes build/std-cache there (cwd-relative) instead of clobbering the
// shared build/libblink_std.a that the parallel test harness links against.
test "stale fn_node_registry id does not survive in-process stdlib rebuild" {
    let root = process_run("sh", ["-c", "pwd -P"]).out.trim()
    let scratch = "{root}/.tmp/_test_fnreg_{getpid()}"
    shell_exec("rm -rf {scratch}")
    shell_exec("mkdir -p {scratch}/build")
    write_file("{scratch}/fe.bl", "import std.testing.\{for_each\}\n\ntest \"f\" \{\n    for_each([(\"alpha\", 1), (\"bravo\", 2)], fn(v: Int) \{ assert_eq(v, 1) \})\n\}\n")
    let cmd = "cd {scratch} && BLINK_ROOT={root} BLINK_FORCE_STDLIB_REBUILD=1 {root}/build/blink test --json fe.bl"
    let result = process_run("sh", ["-c", cmd])
    let output = result.out.concat(result.err_out)
    assert(!output.contains("out of bounds"), "stale fn_node_registry id leaked into fixture compile: {output}")
    assert(output.contains("\"status\":\"fail\""), "expected normal test execution: {output}")
    shell_exec("rm -rf {scratch}")
}
