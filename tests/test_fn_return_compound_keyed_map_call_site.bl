// A Map[K,V] returned from a fn (plain or generic) whose key K is a
// compound type (a struct, a tuple, or a generic struct instance) must
// keep the key's struct/tuple identity at the CALLER's insert/get call
// sites, not box it as void. The constructor already picks the right
// kops vtable; this exercises the separate call-return key-propagation
// path.

@derive(Hash, Eq)
type Point { x: Int, y: Int }

fn mkmap_struct_key() -> Map[Point, Str] { Map() }

test "plain fn returning a struct-keyed map works at the call site" {
    let mut m = mkmap_struct_key()
    m.insert(Point { x: 1, y: 2 }, "p1")
    assert_eq(m.get(Point { x: 1, y: 2 }).unwrap(), "p1")
}

fn mkmap_tuple_key() -> Map[(Int, Int), Str] { Map() }

test "plain fn returning a tuple-keyed map works at the call site" {
    let mut m = mkmap_tuple_key()
    m.insert((256, 0), "a")
    assert_eq(m.get((256, 0)).unwrap(), "a")
}

@derive(Hash, Eq)
type Box[T] { value: T }

fn build_map[K, V](k: K, v: V) -> Map[K, V] {
    let mut m: Map[K, V] = Map()
    m.insert(k, v)
    m
}

fn wrap_key[T](inner: T, v: Str) -> Map[Box[T], Str] {
    build_map(Box { value: inner }, v)
}

test "generic fn returning a generic-struct-keyed map works at the call site" {
    let m = wrap_key(5, "hi")
    assert_eq(m.get(Box { value: 5 }).unwrap(), "hi")
}
