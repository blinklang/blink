// br 7983tp — a fn returning List[Result[Map[K,V],E]] must emit the carrier
// typedef for the list ELEMENT (blink_Result_Map_int_str_str). The same shape
// built inline in one fn already compiles; returned from a fn, the for-in over
// the returned list references the element carrier typedef that was never
// emitted, so cc fails with "unknown type name blink_Result_Map_int_str_str".
// Distinct from 705b70 (bare-Option-carrier signature/caller sites): here the
// missing typedef is the LIST-ELEMENT compound carrier of a cross-fn value.

fn res() -> List[Result[Map[Int, Str], Str]] {
    let mut m: Map[Int, Str] = Map()
    m.insert(9, "ok9")
    [Ok(m), Err("bad")]
}

test "for-in over a fn-returned List[Result[Map[K,V],E]] keeps the element carrier" {
    let lr: List[Result[Map[Int, Str], Str]] = res()
    let mut c = ""
    for item in lr {
        match item {
            Ok(mm) => {
                match mm.get(9) { Some(s) => { c = c.concat(s) } None => {} }
            }
            Err(e) => { c = c.concat(e) }
        }
    }
    assert_eq(c, "ok9bad")
}
