// br 177cse — a type parameter that appears only in an Fn RETURN position
// (`make_getter[T](x: T) -> fn() -> T`) was never bound at the call site, so the
// closure's T reached monomorphization unsolved (UnsolvedTypeVarAtCodegen). The
// tid-authority migration added a TyKind.Fn arm to unify_typevar_binds that binds T
// from the Fn return, so `make_getter(42)` now resolves T=Int and runs.

fn make_getter[T](x: T) -> fn() -> T {
    fn() -> T { x }
}

test "a tparam in an Fn return position binds from the call and runs" {
    let f = make_getter(42)
    assert_eq(f(), 42)
}

test "the same shape binds a Str tparam" {
    let g = make_getter("hi")
    assert(g() == "hi")
}
