// The fn-row trace names each flow of a fn value into a fn type whose row does not admit it.
// Here `eo` has the row `! IO.Print`, and each fn type it flows into has no row, so each flow
// kind gives one line, at its own source line.

import compile_test_helpers.{fn_row_flows_via_cli}

test "the fn-row trace names a flow at each place a fn value meets a fn type" {
    let src = #"type S {
    f: fn() -> Int
}

fn say(n: Int) -> Int ! IO.Print {
    io.println("{n}")
    n
}

fn eo() -> Int ! IO.Print { say(1) }

let G: fn() -> Int = eo

fn take(f: fn() -> Int) -> Int { f() }

fn through(h: fn(fn() -> Int) -> Int) -> Int { h(eo) }

fn tail() -> fn() -> Int { eo }

fn early() -> fn() -> Int { return eo }

fn main() ! IO.Print {
    let a: fn() -> Int = eo
    let s = S { f: eo }
    let mut m: fn() -> Int = fn() -> Int { 1 }
    m = eo
    io.println("{take(fn() -> Int { say(2) })}")
    io.println("{a()}{(s.f)()}{m()}{tail()()}{early()()}{through(take)}{G()}")
}
"#
    let lines = fn_row_flows_via_cli(src, "fn_row_each_flow_{getpid()}")
    let mut at: List[Int] = []
    for l in lines {
        let pos = l.split(".bl:").get(1) ?? ""
        at.push((pos.split(":").get(0) ?? "").to_int())
    }
    // module let, call through a fn value, block tail, return, let, field, assignment, call arg
    assert_eq(at.sort().debug(), [12, 16, 18, 20, 23, 24, 26, 27].debug(), lines.join("\n"))
}

test "the fn-row trace names a flow into a param default and into an enum variant field" {
    let src = #"fn say(n: Int) -> Int ! IO.Print {
    io.println("{n}")
    n
}

fn eo() -> Int ! IO.Print { say(1) }

type E {
    V { f: fn() -> Int }
}

type G[T] {
    W { v: T, f: fn() -> Int }
}

fn g(-- f: fn() -> Int = eo) -> Int { f() }

fn main() ! IO.Print {
    let e = E.V { f: eo }
    let w = G.W { v: 1, f: eo }
    let c = E.V { f: fn() -> Int { say(2) } }
    io.println("{g()}")
    match e { E.V { f } => io.println("{f()}") }
    match w { G.W { v, f } => io.println("{v}{f()}") }
    match c { E.V { f } => io.println("{f()}") }
}
"#
    let lines = fn_row_flows_via_cli(src, "fn_row_default_flow_{getpid()}")
    let mut at: List[Int] = []
    for l in lines {
        let pos = l.split(".bl:").get(1) ?? ""
        at.push((pos.split(":").get(0) ?? "").to_int())
    }
    // param default, enum variant field, generic enum variant field, closure into a variant field
    assert_eq(at.sort().debug(), [16, 19, 20, 21].debug(), lines.join("\n"))
}
