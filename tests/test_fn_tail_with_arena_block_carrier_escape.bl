// A with-arena block in fn-tail position (no intermediate let) whose value is
// wrapped in a builtin carrier constructor (Ok/Some) must promote the value
// out of the arena, the same as the let-bound shape
// `let r: Result[List[Int], Str] = with arena { Ok([1, 2, 3]) }` already does
// (tests/test_arena_promote_result_option.bl). In fn-tail position the escape
// checker instead reads the constructor's argument as escaping via a function
// argument rather than via the function's own return, and rejects it.

import compile_test_helpers.{compile_and_run}

test.failing(
    "a with-arena block wrapped in Ok and used directly as a fn's own tail compiles",
    reason: "the fn-tail with-block loses the in-scope handling that a let-bound with-arena expression gets; wrapping the tail value in Ok/Some is misread as the value escaping via a function argument instead of via the function's own return, even though the identical shape assigned to a let compiles and runs correctly",
    ticket: "dht83f",
) {
    let src = #"
import std.io

fn build() -> Result[List[Int], Str] {
    with arena {
        Ok([1, 2, 3])
    }
}

fn main() {
    match build() {
        Ok(xs) => io.println("{xs.len()}")
        Err(e) => io.println("err {e}")
    }
}
"#
    let r = compile_and_run(src, "_fn_tail_with_arena_block_carrier_escape")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "3\n")
}
