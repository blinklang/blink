// tc_check_call_against_fn_tid's three call sites guard with `type_kind(x) == TyKind.Fn`,
// which resolves metavariables. The function must read the same entry the guard approved, or
// a metavar BOUND to a Fn is read as its own pool entry — params_count 0 and inner1 pointing
// at the solution rather than the Fn's return.
//
// The annotated row is the control: it takes the same code path with a concrete Fn tid, so a
// regression that breaks resolution shows up as one row failing and not the other.

import compile_test_helpers
import std.io

fn inferred_elem_src() -> Str {
    #"import std.io

fn main() {
    let mut fs = []
    fs.push(fn(x: Int) -> Int { x * 2 })
    let f = fs.get(0).unwrap()
    let total = 100
    io.println("r={total + f(1)}")
}
"#
}

test "a closure reached through an inferred list element accepts its arguments" {
    let out = compile_test_helpers.compile_and_capture(inferred_elem_src(), "q0szsg_inferred")
    compile_test_helpers.expect_clean(out, "closure call through a metavar-bound Fn tid")
}

test "a closure reached through an inferred list element runs" {
    let r = compile_test_helpers.compile_and_run(inferred_elem_src(), "q0szsg_inferred_run")
    if !r.out.contains("r=102") { io.println("FAIL: inferred element — got '{r.out}' / '{r.err_out}'") }
    assert(r.out.contains("r=102"))
}

fn annotated_elem_src() -> Str {
    #"import std.io

fn main() {
    let mut fs: List[fn(Int) -> Int] = []
    fs.push(fn(x: Int) -> Int { x * 2 })
    let f = fs.get(0).unwrap()
    let total = 100
    io.println("r={total + f(1)}")
}
"#
}

test "the annotated element form keeps working" {
    let r = compile_test_helpers.compile_and_run(annotated_elem_src(), "q0szsg_annotated_run")
    if !r.out.contains("r=102") { io.println("FAIL: annotated element — got '{r.out}' / '{r.err_out}'") }
    assert(r.out.contains("r=102"))
}

// Resolution must not swallow a genuine arity error: the diagnostic still has to fire once
// the entry being read is the right one.
fn wrong_arity_src() -> Str {
    #"import std.io

fn main() {
    let mut fs = []
    fs.push(fn(x: Int) -> Int { x * 2 })
    let f = fs.get(0).unwrap()
    io.println("r={f(1, 2)}")
}
"#
}

test "a real arity mismatch through the same path still errors" {
    let out = compile_test_helpers.compile_and_capture(wrong_arity_src(), "q0szsg_arity")
    compile_test_helpers.expect_contains(out, "expects 1 argument(s), got 2", "arity check survives resolution")
}
