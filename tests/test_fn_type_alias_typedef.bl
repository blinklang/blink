// A type alias whose right side is a function type lowers to a typedef naming a C
// type that is never declared (`blink_Fn`), instead of the closure C type the
// unaliased fn type itself uses.

import compile_test_helpers.{compile_and_run}

test "a type alias over a fn type lowers to the real closure C type" {
    let src = #"
import std.io

type F = fn(Int) -> Int

fn apply(f: F, x: Int) -> Int { f(x) }

fn main() {
    let g: F = fn(n: Int) -> Int { n + 1 }
    io.println("{apply(g, 41)}")
}
"#
    let r = compile_and_run(src, "_fn_type_alias_typedef")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "42\n")
}
