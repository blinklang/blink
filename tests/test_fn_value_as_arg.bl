// fm6z7n: passing a bare fn by name as a closure-typed argument must
// codegen a properly mangled, closure-boxed value (not an unmangled
// fn-pointer that fails C compilation).
//
// Covers all surfaces touched by the Ident-arm shim path:
// - non-generic callee with struct payload
// - non-generic callee with Int payload
// - generic callee with Int payload
// - generic callee with struct payload
// - effect-bearing callee that threads __ev through the shim
import test_fm6z7n_generic_fn_effect_helper { fm6_emit, FmTele }

type Model { x: Int }

fn bump(m: Model) -> Model { Model { x: m.x + 1 } }
fn bump_int(x: Int) -> Int { x + 1 }

fn take_fn(x: Model, f: fn(Model) -> Model) -> Model { f(x) }
fn take_fn_int(x: Int, f: fn(Int) -> Int) -> Int { f(x) }
fn take_fn_g[T](x: T, f: fn(T) -> T) -> T { f(x) }

test "non-generic: bare fn as closure arg (struct payload)" {
    let r = take_fn(Model { x: 1 }, bump)
    assert_eq(r.x, 2)
}

test "non-generic: bare fn as closure arg (Int payload)" {
    let r = take_fn_int(10, bump_int)
    assert_eq(r, 11)
}

test "generic: bare fn as closure arg (Int)" {
    let r = take_fn_g(10, bump_int)
    assert_eq(r, 11)
}

test "generic: bare fn as closure arg (Model)" {
    let r = take_fn_g(Model { x: 5 }, bump)
    assert_eq(r.x, 6)
}

fn tick(x: Int) -> Int ! FmTele.Emit {
    fm6_emit("tick", x)
    x + 1
}

fn apply_eff(x: Int, f: fn(Int) -> Int) -> Int ! FmTele.Emit { f(x) }

test "bare effectful fn as closure arg threads ev correctly" {
    with handler FmTele {
        fn record(_n: Str, _v: Int) { }
    } {
        let r = apply_eff(7, tick)
        assert_eq(r, 8)
    }
}
