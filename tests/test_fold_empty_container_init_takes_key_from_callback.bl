// An empty `Map()` or `Set()` accumulator gets its key from the callback's accumulator type, the
// same as a declared type gives it, because a container's key operations are chosen from the key.

fn fec_map(acc: Map[Int, Int], x: Int) -> Map[Int, Int] {
    let mut m = acc
    m.insert(x, x)
    m
}

fn fec_set(acc: Set[Int], x: Int) -> Set[Int] {
    let mut s = acc
    s.insert(x)
    s
}

test "a named fn gives Map its key" {
    assert_eq([1].fold(Map(), fec_map).len(), 1)
    assert_eq([1].into_iter().fold(Map(), fec_map).len(), 1)
}

test "a named fn gives Set its key" {
    assert_eq([1].fold(Set(), fec_set).len(), 1)
    assert_eq([1].into_iter().fold(Set(), fec_set).len(), 1)
}

test "a closure with typed parameters gives Map its key" {
    assert_eq([1].fold(Map(), fn(a: Map[Int, Int], x: Int) -> Map[Int, Int] { fec_map(a, x) }).len(), 1)
}
