// In a generic fn, the callback of `fold` gives an empty container its key type: `T` there is
// the enclosing fn's own type parameter, a known type at the call.

fn fe_count[T: Hash + Eq](xs: List[T]) -> Map[T, Int] {
    xs.fold(Map.new(), fn(mut a: Map[T, Int], x: T) -> Map[T, Int] {
        a.insert(x, 1)
        a
    })
}

fn fe_count_annotated[T: Hash + Eq](xs: List[T]) -> Int {
    let r: Map[T, Int] = xs.fold(Map.new(), fn(mut a: Map[T, Int], x: T) -> Map[T, Int] {
        a.insert(x, 1)
        a
    })
    r.len()
}

fn fe_count_bare[T: Hash + Eq](xs: List[T]) -> Int {
    let m = xs.fold(Map.new(), fn(mut a: Map[T, Int], x: T) -> Map[T, Int] {
        a.insert(x, 1)
        a
    })
    m.len()
}

fn fe_step[T: Hash + Eq](mut a: Map[T, Int], x: T) -> Map[T, Int] {
    a.insert(x, 1)
    a
}

fn fe_count_named[T: Hash + Eq](xs: List[T]) -> Map[T, Int] { xs.fold(Map.new(), fe_step) }

fn fe_unique[T: Hash + Eq](xs: List[T]) -> Set[T] {
    xs.fold(Set.new(), fn(mut a: Set[T], x: T) -> Set[T] {
        a.insert(x)
        a
    })
}

test "a closure's written key type reaches Map.new in return position" {
    assert_eq(fe_count([1, 2, 2]).len(), 2)
    assert_eq(fe_count(["a"]).len(), 1)
}

test "a closure's written key type reaches Map.new under an annotated let" {
    assert_eq(fe_count_annotated([1, 2, 2]), 2)
}

test "a closure's written key type reaches Map.new under a bare let" {
    assert_eq(fe_count_bare([1, 2, 2]), 2)
}

test "a named generic fn's key type reaches Map.new" {
    assert_eq(fe_count_named([1, 2, 2]).len(), 2)
}

test "a closure's written element type reaches Set.new" {
    assert_eq(fe_unique([1, 2, 2]).len(), 2)
}
