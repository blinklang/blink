// fold's unannotated accumulator param must be typed from its own position
// on the closure's signature (the accumulator type), not from the list's
// element type — the two differ here (Str accumulator over a List[Int]).

test "fold's unannotated accumulator keeps its own type when it differs from the element type" {
    let a: List[Int] = [2, 1, 3]
    let s: Str = a.fold("x", fn(acc, v) { "{acc}{v}" })
    assert_eq(s, "x213")
}
