// An unannotated closure passed to fold must have its return type inferred
// from the accumulator, not spelled void, so the accumulated call reads a
// real value instead of an uninitialized register.

test "fold's unannotated closure return infers the accumulator type" {
    let s = [1, 2, 3].fold(0, fn(acc, x) { acc + x })
    assert_eq(s, 6)
}
