// When a for_each case fails, the test runner JSON output must include the
// active case label as a "case" field so consumers can tell which case failed
// (not just the parent test name). We shell out to `build/blink test --json` on
// a fixture file that contains a failing for_each, then inspect the JSON for
// "case":"<label>".

test "for_each case label appears in JSON failure record" {
    // Fixture basename must be unique per worker: `build/blink test` writes the
    // compiled child binary to `build/<basename>`, and sibling workers racing
    // on the same path hit ETXTBSY ("Text file busy") on execvp.
    let tag = "fe_fail_{getpid()}"
    let scratch = ".tmp/_test_for_each_label_{getpid()}_fail"
    shell_exec("rm -rf {scratch}")
    shell_exec("mkdir -p {scratch}")
    let fixture = "{scratch}/{tag}.bl"
    let src = "import std.testing.\{for_each\}\n\ntest \"failing_for_each\" \{\n    for_each([\n        (\"alpha\", 1),\n        (\"bravo\", 2),\n    ], fn(v: Int) \{\n        assert_eq(v, 1)\n    \})\n\}\n"
    write_file(fixture, src)
    let result = process_run("build/blink", ["test", "--json", fixture])
    let output = result.out.concat(result.err_out)
    let diag = "exit_code={result.exit_code}; captured:\n{output}"
    assert(output.contains("\"status\":\"failed\""), "no status:failed; {diag}")
    assert(output.contains("\"case\":\"bravo\""), "no case:bravo; {diag}")
    shell_exec("rm -rf {scratch}")
}

test "for_each passing case does not emit stale label in fail records" {
    // See sibling test above for why the fixture basename must be unique.
    let tag = "fe_pass_{getpid()}"
    let scratch = ".tmp/_test_for_each_label_{getpid()}_pass"
    shell_exec("rm -rf {scratch}")
    shell_exec("mkdir -p {scratch}")
    let fixture = "{scratch}/{tag}.bl"
    let src = "import std.testing.\{for_each\}\n\ntest \"passing_for_each\" \{\n    for_each([\n        (\"first\", 1),\n        (\"second\", 2),\n    ], fn(v: Int) \{\n        assert(v > 0)\n    \})\n\}\n"
    write_file(fixture, src)
    let result = process_run("build/blink", ["test", "--json", fixture])
    let output = result.out.concat(result.err_out)
    let diag = "exit_code={result.exit_code}; captured:\n{output}"
    assert(result.exit_code == 0, "child should exit 0; {diag}")
    assert(output.contains("\"status\":\"pass\""), "no status:pass; {diag}")
    shell_exec("rm -rf {scratch}")
}
