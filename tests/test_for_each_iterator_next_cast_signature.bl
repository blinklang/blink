// The C emitted for a closure passed to Iterator.for_each casts the
// iterator's `next` function pointer through `void*` instead of the
// callee's real receiver-pointer type. Calling through an incompatible
// function type is undefined behaviour in C even though the program
// currently prints the right values, so this must be caught structurally
// in the emitted C, not just by a runtime-value assertion (which cannot
// see the miscast at all).

import compile_test_helpers.{compile_and_emit_c}

test.failing(
    "the for_each iterator-next call is cast through the iterator's real pointer type, not void*",
    reason: "the emitted call-site cast spells the next fn pointer's parameter as void* while the callee blink_ListIterator_int_next takes a typed blink_ListIterator_int* receiver, an incompatible-function-type call (UB) that gcc warns about",
) {
    let src = #"
import std.io

fn main() ! IO {
    let xs = [1, 2, 3]
    xs.into_iter().for_each(fn(x: Int) { io.println("{x}") })
}
"#
    let c = compile_and_emit_c(src, "_for_each_iterator_next_cast_signature")
    assert(c.contains("blink_ListIterator_int_next(blink_ListIterator_int* self)"), "expected callee declaration not found:\n{c}")
    assert(!c.contains("(void*))blink_ListIterator_int_next"), "call-site cast still spells the next fn pointer's param as void*:\n{c}")
}
