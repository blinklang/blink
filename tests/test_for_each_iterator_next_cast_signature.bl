// The C emitted for a closure passed to Iterator.for_each must call the
// iterator's `next` function pointer through the callee's real type, never
// through a cast to a `void*` receiver. A call through an incompatible
// function type is undefined behaviour in C even when the program prints
// the right values, so the test checks the emitted C, not only the output.

import compile_test_helpers.{compile_and_emit_c}

test "the for_each iterator-next call is cast through the iterator's real pointer type, not void*" {
    let src = #"
import std.io

fn main() ! IO {
    let xs = [1, 2, 3]
    xs.into_iter().for_each(fn(x: Int) { io.println("{x}") })
}
"#
    let c = compile_and_emit_c(src, "_for_each_iterator_next_cast_signature")
    assert(c.contains("((blink_Option_int(*)(const blink_closure*))next->fn_ptr)(next)"), "expected call through the closure's real type not found:\n{c}")
    assert(!c.contains("(*)(void*"), "a call-site cast spells a fn pointer's param as void*:\n{c}")
}
