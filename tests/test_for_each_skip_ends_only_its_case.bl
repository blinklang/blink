import std.testing.{for_each, skip}

let mut _log: List[Str] = []

fn record(v: Str) {
    _log.push(v)
}

test "for_each skip ends only the skipping case" {
    for_each([
        ("a", "alpha"),
        ("b", "bravo"),
        ("c", "charlie"),
    ], fn(v: Str) {
        if v == "bravo" { skip("skip this case") }
        record(v)
    })
}

test "z_verify_skip_did_not_stop_later_cases" {
    assert_eq(_log.len(), 2)
    assert_eq(_log.get(0).unwrap(), "alpha")
    assert_eq(_log.get(1).unwrap(), "charlie")
}
