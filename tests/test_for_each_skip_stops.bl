import std.testing.{for_each, skip}

let mut _log: List[Str] = []

fn record(v: Str) {
    _log.push(v)
}

test "for_each bails on skip" {
    for_each([
        ("a", "alpha"),
        ("b", "bravo"),
        ("c", "charlie"),
    ], fn(v: Str) {
        record(v)
        if v == "bravo" { skip("stop here") }
    })
}

test "z_verify_bail_after_b" {
    assert_eq(_log.len(), 2)
    assert_eq(_log.get(0).unwrap(), "alpha")
    assert_eq(_log.get(1).unwrap(), "bravo")
}
