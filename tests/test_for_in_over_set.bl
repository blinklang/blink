// 7b1t5a: `for x in <Set>` compiled clean and ran zero iterations -- emit_for_in
// had no CT_SET arm and fell into a bare "/* unsupported iterable */" comment.
// Fixed by normalizing the set to a list via blink_set_to_list (existing,
// previously-uncalled runtime fn) and reusing the CT_LIST loop emitter.
//
// Spec: sections/03c_protocols.md:178-186 (Set[T] -> T, unspecified order).
// Per DECISIONS.md:335, Set iteration order is unspecified and randomized
// per-process -- these assert on sum/membership/count, never on order.

@derive(Hash, Eq)
type Pt { x: Int, y: Int }

test "for-in over Set[Str]" {
    let mut s: Set[Str] = Set()
    s.insert("a")
    s.insert("bb")
    s.insert("ccc")
    let mut total_len = 0
    let mut count = 0
    for x in s {
        total_len = total_len + x.len()
        count = count + 1
    }
    assert_eq(count, 3)
    assert_eq(total_len, 6)
}

test "for-in over Set[Int]" {
    let mut s: Set[Int] = Set()
    s.insert(7)
    s.insert(9)
    s.insert(20)
    let mut sum = 0
    let mut count = 0
    for x in s {
        sum = sum + x
        count = count + 1
    }
    assert_eq(count, 3)
    assert_eq(sum, 36)
}

test "for-in over Set[I8] round-trips a negative element (narrow-width packing)" {
    let mut s: Set[I8] = Set()
    s.insert(-1)
    s.insert(5)
    let mut found_neg = false
    let mut count = 0
    for x in s {
        if x == -1 {
            found_neg = true
        }
        count = count + 1
    }
    assert_eq(count, 2)
    assert_eq(found_neg, true)
}

test "for-in over Set[Char]" {
    let mut s: Set[Char] = Set()
    s.insert('x')
    s.insert('y')
    let mut count = 0
    let mut found_x = false
    for c in s {
        if c == 'x' {
            found_x = true
        }
        count = count + 1
    }
    assert_eq(count, 2)
    assert_eq(found_x, true)
}

test "for-in over Set[@derive(Hash,Eq) struct]" {
    let mut s: Set[Pt] = Set()
    s.insert(Pt { x: 1, y: 2 })
    s.insert(Pt { x: 3, y: 4 })
    let mut sum_x = 0
    let mut count = 0
    for p in s {
        sum_x = sum_x + p.x
        count = count + 1
    }
    assert_eq(count, 2)
    assert_eq(sum_x, 4)
}

test "for-in over Set[(Int, Str)] tuple element" {
    let mut s: Set[(Int, Str)] = Set()
    s.insert((1, "a"))
    s.insert((2, "bb"))
    let mut sum_n = 0
    let mut total_len = 0
    let mut count = 0
    for (n, str_val) in s {
        sum_n = sum_n + n
        total_len = total_len + str_val.len()
        count = count + 1
    }
    assert_eq(count, 2)
    assert_eq(sum_n, 3)
    assert_eq(total_len, 3)
}

test "for-in over an empty Set runs zero iterations" {
    let s: Set[Int] = Set()
    let mut ran = false
    for _x in s {
        ran = true
    }
    assert_eq(ran, false)
}

test "for-in over a Set reached through List[Set[Int]]" {
    let mut a: Set[Int] = Set()
    a.insert(1)
    a.insert(2)
    let mut b: Set[Int] = Set()
    b.insert(3)
    let sets: List[Set[Int]] = [a, b]
    let mut total = 0
    let mut count = 0
    for inner in sets {
        for x in inner {
            total = total + x
            count = count + 1
        }
    }
    assert_eq(count, 3)
    assert_eq(total, 6)
}
