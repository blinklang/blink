// `for c in s` binds each Unicode scalar value of `s` as a Char, in order
// (sections/03_types.md, sections/03c_protocols.md). UTF-8 spends one to four bytes on a
// character, so each width gets a row of its own: a walk that stepped by byte, or guessed a
// width, would split the character and answer the wrong code points.

fn code_points(s: Str) -> List[Int] {
    let mut out: List[Int] = []
    for c in s {
        out.push(c.to_int())
    }
    out
}

fn greeting() -> Str {
    "héllo"
}

test "an ASCII string yields one Char per byte" {
    let s = "hello"
    let mut chars: List[Char] = []
    for c in s {
        chars.push(c)
    }
    assert_eq(chars.len(), 5)
    assert_eq(chars.get(0).unwrap(), 'h')
    assert_eq(chars.get(4).unwrap(), 'o')
}

test "a two-byte character is one Char" {
    let cps = code_points("héllo")
    assert_eq(cps.len(), 5)
    assert_eq(cps.get(1).unwrap(), 233)
    assert_eq(cps.get(2).unwrap(), 108)
}

test "a three-byte character is one Char" {
    let cps = code_points("a€b")
    assert_eq(cps.len(), 3)
    assert_eq(cps.get(0).unwrap(), 97)
    assert_eq(cps.get(1).unwrap(), 8364)
    assert_eq(cps.get(2).unwrap(), 98)
}

test "a four-byte character is one Char" {
    let cps = code_points("x😀y")
    assert_eq(cps.len(), 3)
    assert_eq(cps.get(1).unwrap(), 128512)
    assert_eq(cps.get(2).unwrap(), 121)
}

test "the empty string runs no turns" {
    let mut turns = 0
    for _c in "" {
        turns = turns + 1
    }
    assert_eq(turns, 0)
}

test "a continue skips the rest of the turn and the walk goes on" {
    let mut kept = ""
    for c in "a é b" {
        if c == ' ' {
            continue
        }
        kept = kept.concat(c.to_str())
    }
    assert_eq(kept, "aéb")
}

test "a break stops the walk at the character it names" {
    let mut before = ""
    for c in "ab€cd" {
        // 8364 is '€': the lexer does not yet read a multi-byte char literal.
        if c.to_int() == 8364 {
            break
        }
        before = before.concat(c.to_str())
    }
    assert_eq(before, "ab")
}

test "a string that arrives as a parameter or a call result is walked the same way" {
    assert_eq(code_points(greeting()).len(), 5)
    let mut n = 0
    for _c in greeting() {
        n = n + 1
    }
    assert_eq(n, 5)
}

test "a string loop inside a string loop keeps a position of its own" {
    let mut pairs = 0
    let mut same = 0
    for x in "é€" {
        for y in "a€😀" {
            pairs = pairs + 1
            if x == y { same = same + 1 }
        }
    }
    assert_eq(pairs, 6)
    assert_eq(same, 1)
}

test "joining every Char back gives the original string" {
    let s = "héllo, wörld € 😀!"
    let mut back = ""
    for c in s {
        back = back.concat(c.to_str())
    }
    assert_eq(back, s)
}

// Bytes.to_str refuses ill-formed UTF-8, so this text comes in through FFI, the one door
// where a Str's validity rests on the author of the boundary (sections/03_types.md).
@trusted(audit: "TEST-FOR-IN-STR: hand the decoder a surrogate that no safe path can make")
fn surrogate_text() -> Str ! FFI {
    with ffi.scope() as scope {
        // ED A0 80 is the encoded form of surrogate U+D800.
        let bytes = [97, 237, 160, 128, 98, 0]
        let p = scope.alloc_n[U8](bytes.len())
        let mut i = 0
        while i < bytes.len() {
            p.offset(i).write(bytes.get(i).unwrap().to_u8())
            i += 1
        }
        p.to_str().unwrap()
    }
}

test "an ill-formed sequence from FFI reads as U+FFFD, never as a surrogate" {
    let s = surrogate_text()
    let cps = code_points(s)
    assert_eq(cps.len(), 5)
    assert_eq(cps.get(0).unwrap(), 97)
    assert_eq(cps.get(1).unwrap(), 65533)
    assert_eq(cps.get(2).unwrap(), 65533)
    assert_eq(cps.get(3).unwrap(), 65533)
    assert_eq(cps.get(4).unwrap(), 98)
}
