// The for-in element recovery calls named_elem_of_elem_tid when the flat channels carry no
// element name, but the call site reads only `.plain_enum` from the result. A struct element
// answers {tag: "P", name: "P", plain_enum: false}, so nothing is read, elem_struct stays ""
// and the iterator is emitted over `void`.
//
// The generic-fn source is what empties the flat channels — a directly-built list keeps them,
// which is why the control row below passes today and is here to stay passing.

import compile_test_helpers
import std.io

fn generic_src() -> Str {
    #"import std.io

type P {
    x: Int
}

fn mkl[T](a: T) -> List[T] {
    [a]
}

fn main() {
    let mut sum = 0
    for p in mkl(P { x: 3 }) {
        sum = sum + p.x
    }
    io.println("sum={sum}")
}
"#
}

test "a struct element recovered from the tid types the iterator" {
    let c = compile_test_helpers.compile_and_emit_c(generic_src(), "h2n6bw_c")
    if c.contains("blink_ListIterator_void") { io.println("FAIL: iterator emitted over void") }
    assert(!c.contains("blink_ListIterator_void"))
}

test "iterating a generic-fn-produced list of structs compiles and runs" {
    let r = compile_test_helpers.compile_and_run(generic_src(), "h2n6bw_run")
    if !r.out.contains("sum=3") { io.println("FAIL: generic list of structs — got '{r.out}' / '{r.err_out}'") }
    assert(r.out.contains("sum=3"))
}

// The flat channels are populated here, so this row never reached the tid recovery. It pins
// that the fix adds an answer where there was none rather than changing one that worked.
fn direct_src() -> Str {
    #"import std.io

type P {
    x: Int
}

fn main() {
    let mut sum = 0
    for p in [P { x: 3 }, P { x: 4 }] {
        sum = sum + p.x
    }
    io.println("sum={sum}")
}
"#
}

test "a directly-built list of structs keeps working" {
    let r = compile_test_helpers.compile_and_run(direct_src(), "h2n6bw_direct")
    if !r.out.contains("sum=7") { io.println("FAIL: direct list of structs — got '{r.out}' / '{r.err_out}'") }
    assert(r.out.contains("sum=7"))
}
