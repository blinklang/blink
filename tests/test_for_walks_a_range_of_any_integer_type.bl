// A `for` walks a range of any integer type, and an int literal bound takes the type of the
// other bound (sections/02_syntax.md §2.10 "An inclusive range up to the largest value of its
// type", sections/03_types.md *Operator operands*). `lo..=hi` yields `hi` last and stops, also
// when `hi` is the largest value of its type.

test "a U8 range up to 255 runs 6 times and stops" {
    let top: U8 = 255
    let mut turns = 0
    let mut last: U8 = 0
    for i in 250..=top {
        turns += 1
        last = i
    }
    assert_eq(turns, 6)
    assert_eq(last, top)
}

test "an inclusive range at the largest value of each signed type stops there" {
    let m8: I8 = 127
    let mut t8 = 0
    for _i in 125..=m8 { t8 += 1 }
    assert_eq(t8, 3)
    let m16: I16 = 32767
    let mut t16 = 0
    for _i in 32765..=m16 { t16 += 1 }
    assert_eq(t16, 3)
    let m32: I32 = 2147483647
    let mut t32 = 0
    for _i in 2147483645..=m32 { t32 += 1 }
    assert_eq(t32, 3)
    let m64: I64 = 9223372036854775807
    let mut t64 = 0
    for _i in 9223372036854775805..=m64 { t64 += 1 }
    assert_eq(t64, 3)
    let mint = 9223372036854775807
    let mut tint = 0
    for _i in 9223372036854775805..=mint { tint += 1 }
    assert_eq(tint, 3)
}

test "an inclusive range at the largest value of each unsigned type stops there" {
    let m16: U16 = 65535
    let mut t16 = 0
    for _i in 65533..=m16 { t16 += 1 }
    assert_eq(t16, 3)
    let m32: U32 = 4294967295
    let mut t32 = 0
    for _i in 4294967293..=m32 { t32 += 1 }
    assert_eq(t32, 3)
    let m64: U64 = 18446744073709551615
    let mut t64 = 0
    let mut last: U64 = 0
    for i in 18446744073709551613..=m64 {
        t64 += 1
        last = i
    }
    assert_eq(t64, 3)
    assert_eq(last, m64)
}

test "a range from the smallest value of a signed type counts up from it" {
    let mut turns = 0
    let lo: I8 = -128
    let mut first: I8 = 0
    for i in lo..=-126 {
        if turns == 0 { first = i }
        turns += 1
    }
    assert_eq(turns, 3)
    assert_eq(first, lo)
}

test "a literal end takes the sized type of the start" {
    let lo: I16 = -3
    let mut sum: I16 = 0
    for i in lo..3 { sum += i }
    assert_eq(sum, -3)
}

test "an empty sized range runs zero times and a one-value range runs once" {
    let five: U8 = 5
    let mut empty = 0
    for _i in five..3 { empty += 1 }
    for _i in five..=4 { empty += 1 }
    for _i in five..5 { empty += 1 }
    assert_eq(empty, 0)
    let mut once = 0
    for _i in five..=5 { once += 1 }
    assert_eq(once, 1)
}

test "break and continue in a U8 loop at the largest value" {
    let top: U8 = 255
    let mut seen = 0
    for i in 250..=top {
        if i == 251 { continue }
        seen += 1
    }
    assert_eq(seen, 5)
    let mut stop: U8 = 0
    for i in 250..=top {
        stop = i
        if i == 253 { break }
    }
    assert_eq(stop, 253)
}

test "a for over a Range[U8] value walks it" {
    let top: U8 = 255
    let r = 253..=top
    let mut turns = 0
    for _i in r { turns += 1 }
    assert_eq(turns, 3)
}

test "a range of int literals takes its element type from the declared type" {
    let r: Range[U8] = 253..=255
    let mut turns = 0
    let mut last: U8 = 0
    for i in r {
        turns += 1
        last = i
    }
    assert_eq(turns, 3)
    assert_eq(last, 255)
}
