// The two-argument form of a foreign constant names a library key of `[native-dependencies]`
// (§9.1, §9.1.2). A key the manifest does not declare is MissingNativeDep (E0820). A declared
// key gives the dependency's headers to the build, and no link flag: a foreign constant is a
// value from a header, not a symbol the program links.
import std.process.{ProcessResult}

fn sh(cmd: Str) -> ProcessResult {
    process.run("sh", ["-c", cmd]).unwrap()
}

let MANIFEST = "[package]\nname = \"fcnd\"\nversion = \"0.1.0\"\n\n[native-dependencies]\nzz_no_such_lib = \{ system = true \}\nfoo = \{ type = \"vendored\", path = \"vendor/foo.c\", headers = [\"foo.h\"] \}\n"

// A project with a vendored dep `foo` whose header defines FOO_MAX, and a system dep that no
// linker can find. Answers the build's output and the program's.
fn build_project(main_src: Str) -> (ProcessResult, Str) {
    build_in(main_src, true)
}

// A project with the manifest above, or with no manifest at all.
fn build_in(main_src: Str, with_manifest: Bool) -> (ProcessResult, Str) {
    let dir = sh("mktemp -d /tmp/blink_fc_nd.XXXXXX").out.trim()
    let _ = sh("mkdir -p {dir}/src {dir}/vendor")
    if with_manifest {
        write_file("{dir}/blink.toml", MANIFEST)
        write_file("{dir}/blink.lock", "[metadata]\nlockfile-version = 1\n")
    }
    write_file("{dir}/vendor/foo.h", "#define FOO_MAX 42\n")
    write_file("{dir}/vendor/foo_inner.h", "#include <blink_no_such_inner.h>\n#define FOO_OK 42\n")
    write_file("{dir}/vendor/foo_macro.h", "#define FOO_X (FOO_UNDEF + 1)\n")
    write_file("{dir}/vendor/foo.c", "#include \"foo.h\"\nint foo_max(void) \{ return FOO_MAX; \}\n")
    write_file("{dir}/src/main.bl", main_src)
    let r = sh("B=$(pwd)/build/blink; cd {dir} && timeout 120 $B build src/main.bl -o {dir}/out")
    let ran = if r.success() { sh("{dir}/out").out } else { "" }
    let _ = sh("rm -rf {dir}")
    (r, ran)
}

test "a library key the manifest does not declare is MissingNativeDep" {
    let src = "@ffi(\"bar\", \"INT_MAX\", header: \"limits.h\")\npub let BIG: Int\n\nfn main() \{\n    io.println(\"\{BIG}\")\n}\n"
    let (r, _) = build_project(src)
    let text = "{r.out}{r.err_out}"
    assert(!r.success(), "got: {text}")
    assert(text.contains("error[MissingNativeDep]"), "got: {text}")
    assert(text.contains("undeclared native dependency \"bar\""), "got: {text}")
    assert(text.contains("src/main.bl:2:9"), "the error is at the declaration, got: {text}")
}

test "the runtime keys c and m need no manifest entry" {
    let src = "@ffi(\"c\", \"INT_MAX\", header: \"limits.h\")\npub let BIG: Int\n\n@ffi(\"m\", \"FP_NAN\", header: \"math.h\")\npub let FPN: Int\n\nfn main() \{\n    io.println(\"\{BIG} \{FPN == FPN}\")\n}\n"
    let (r, ran) = build_project(src)
    assert(r.success(), "got: {r.out}{r.err_out}")
    assert_eq(ran, "2147483647 true\n")
}

test "with no manifest, a key other than c and m is MissingNativeDep" {
    let src = "@ffi(\"c\", \"INT_MAX\", header: \"limits.h\")\npub let BIG: Int\n\n@ffi(\"bar\", \"INT_MIN\", header: \"limits.h\")\npub let LOW: Int\n\nfn main() \{\n    io.println(\"\{BIG} \{LOW}\")\n}\n"
    let (r, _) = build_in(src, false)
    let text = "{r.out}{r.err_out}"
    assert(!r.success(), "got: {text}")
    assert(text.contains("undeclared native dependency \"bar\""), "got: {text}")
    assert(!text.contains("\"c\""), "got: {text}")
}

test "a declared key gives its headers and no link flag" {
    let src = "@ffi(\"foo\", \"FOO_MAX\", header: \"foo.h\")\npub let FOO_MAX: Int\n\n@ffi(\"zz_no_such_lib\", \"INT_MAX\", header: \"limits.h\")\npub let BIG: Int\n\nfn main() \{\n    io.println(\"\{FOO_MAX} \{BIG}\")\n}\n"
    let (r, ran) = build_project(src)
    assert(r.success(), "got: {r.out}{r.err_out}")
    assert_eq(ran, "42 2147483647\n")
}

test "a header that fails to compile is ForeignConstInvalid, not a raw C error" {
    let src = "@ffi(\"foo\", \"FOO_OK\", header: \"foo_inner.h\")\npub let FOO_OK: Int\n\nfn main() \{\n    io.println(\"\{FOO_OK}\")\n}\n"
    let (r, _) = build_project(src)
    let text = "{r.out}{r.err_out}"
    assert(!r.success(), "got: {text}")
    assert(text.contains("error[ForeignConstInvalid]"), "got: {text}")
    assert(text.contains("`FOO_OK` is not an integer constant on "), "got: {text}")
    assert(text.contains("`foo_inner.h` does not compile"), "got: {text}")
    assert(!text.contains("blink_no_such_inner.h"), "no raw C error reaches the user, got: {text}")
}

test "a macro that fails where it expands is not an integer constant" {
    let src = "@ffi(\"foo\", \"FOO_X\", header: \"foo_macro.h\")\npub let FOO_X: Int\n\nfn main() \{\n    io.println(\"\{FOO_X}\")\n}\n"
    let (r, _) = build_project(src)
    let text = "{r.out}{r.err_out}"
    assert(!r.success(), "got: {text}")
    assert(text.contains("`FOO_X` is not an integer constant on "), "got: {text}")
    assert(!text.contains("does not fit"), "got: {text}")
}
