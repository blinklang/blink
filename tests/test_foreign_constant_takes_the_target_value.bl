// A foreign constant takes its value from the build target's C headers (§9.1), so each test
// reads the value back through something the host itself defines: its strerror text.
import std.fs.{FsError, FsOp}
import std.errno.{Errno}

@ffi("ENOTSUP", header: "errno.h")
pub let FC_ENOTSUP: Int

@ffi("EINVAL", header: "errno.h")
pub let FC_EINVAL: U8

@ffi("ENOENT", header: "errno.h")
let FC_ENOENT: I32

let KNOWN = [FC_ENOENT.to_int(), FC_ENOTSUP]

let NOTSUP_ALIAS = FC_ENOTSUP

type Watch {
    code: Int
}

let WATCH = Watch { code: FC_ENOTSUP }

fn text_of(code: Int) -> Str {
    "{FsError { op: FsOp.Read, path: "p", code: Errno(code) }}"
}

test "a foreign constant is the number the host's C library names after it" {
    assert_eq(text_of(FC_ENOTSUP), "read p: Operation not supported")
    assert_eq(text_of(FC_EINVAL.to_int()), "read p: Invalid argument")
    assert_eq(text_of(FC_ENOENT.to_int()), "read p: No such file or directory")
}

test "a foreign constant reads the same through a module let, a list and a struct" {
    assert_eq(NOTSUP_ALIAS, FC_ENOTSUP)
    assert_eq(KNOWN.get(0).unwrap(), FC_ENOENT.to_int())
    assert_eq(KNOWN.get(1).unwrap(), FC_ENOTSUP)
    assert_eq(WATCH.code, FC_ENOTSUP)
}

test "a guard compares with a foreign constant" {
    let code = text_of(FC_EINVAL.to_int()).len()
    let what = match FC_EINVAL.to_int() {
        n if n == FC_ENOTSUP => "notsup"
        n if n == FC_EINVAL.to_int() => "inval"
        _ => "other {code}"
    }
    assert_eq(what, "inval")
}
