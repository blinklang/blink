// A foreign constant is defined once, in the unit of the module that declares it, where the
// header is read. Another module reads it through a declaration only, so a module-level
// `let`, a list and a struct literal there take its value when the module starts, never as
// a C constant expression of their own unit.
import compile_test_helpers.{run_xmod}

let HELPER = "@ffi(\"ENOTSUP\", header: \"errno.h\")\npub let ENOTSUP: Int\n\n@ffi(\"ENOENT\", header: \"errno.h\")\npub let ENOENT: I32\n"

test "a module let, a list and a struct literal in another module read the foreign constant" {
    let entry = "import std.fs.\{FsError, FsOp}\nimport std.errno.\{Errno}\nimport codes.consts.\{ENOTSUP, ENOENT}\n\ntype Watch \{\n    code: Int\n}\n\nlet X = ENOTSUP\nlet L = [ENOTSUP, ENOENT.to_int()]\nlet W = Watch \{ code: ENOTSUP }\n\nfn text(code: Int) -> Str \{\n    \"\{FsError \{ op: FsOp.Read, path: \"p\", code: Errno(code) }}\"\n}\n\nfn main() \{\n    io.println(text(X))\n    io.println(text(L.get(1).unwrap()))\n    io.println(text(W.code))\n}\n"
    let r = run_xmod(entry, "codes", "consts", HELPER, "foreign_const_xmod")
    assert_eq(r.err_out, "")
    assert_eq(r.out, "read p: Operation not supported\nread p: No such file or directory\nread p: Operation not supported\n")
    assert_eq(r.exit_code, 0)
}
