// A foreign constant named after a signal reads the macro signal.h defines, in a unit that
// also includes the runtime's process code. The runtime must leave that macro defined, and a
// local of a signal's name beside it is the program's own.

@ffi("SIGBUS", header: "signal.h")
pub let SIGBUS: Int

@ffi("SIGTERM", header: "signal.h")
let FC_SIGTERM: Int

fn host_signal(name: Str) -> Int {
    let r = process.run("sh", ["-c", "kill -l {name}"]).unwrap()
    r.out.trim().parse_int().unwrap()
}

test "a signal constant is the number the host names it" {
    assert_eq(SIGBUS, host_signal("BUS"))
    assert_eq(FC_SIGTERM, host_signal("TERM"))
}

test "a local named like a signal sits beside the signal constant" {
    let SIGTERM = 99
    assert_eq(SIGTERM, 99)
    assert(SIGBUS != SIGTERM)
    assert_eq(FC_SIGTERM, host_signal("TERM"))
}
