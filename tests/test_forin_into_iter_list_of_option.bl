import compile_test_helpers

// for-in over a List[Option[Int]].into_iter() must keep the element's
// Option carrier, not drop its identity to a bare scalar.

fn forin_into_iter_option_src() -> Str {
    #"fn main() ! IO {
    let a: List[Option[Int]] = [Some(1), None, Some(3)]
    let mut n = 0
    for o in a.into_iter() {
        n = n + 1
    }
    io.println("n={n}")
}
"#
}

test "for-in over List[Option[Int]].into_iter() compiles and counts every element" {
    let r = compile_test_helpers.compile_and_run(forin_into_iter_option_src(), "_forin_into_iter")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "n=3\n")
}
