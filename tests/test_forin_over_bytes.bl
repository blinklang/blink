import compile_test_helpers

fn forin_bytes_src() -> Str {
    #"import std.bytes.{bytes_from_str}

fn main() {
    let b = bytes_from_str("hi")
    for x in b {
        io.println("{x}")
    }
}
"#
}

test "for-in over a Bytes value reads each byte by position, in order" {
    let r = compile_test_helpers.compile_and_run(forin_bytes_src(), "_forin_over_bytes")
    assert(r.exit_code == 0, "expected clean run, got exit_code={r.exit_code} err={r.err_out}")
    assert(r.out == "104\n105\n", "expected each byte of \"hi\" on its own line, got out={r.out}")
}
