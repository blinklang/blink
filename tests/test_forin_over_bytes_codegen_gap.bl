import compile_test_helpers

fn forin_bytes_src() -> Str {
    #"import std.bytes.{bytes_from_str}

fn main() {
    let b = bytes_from_str("hi")
    for x in b {
        io.println("{x}")
    }
}
"#
}

test.failing(
    "for-in over a Bytes value compiles instead of hitting an internal compiler error",
    reason: "for-in over Bytes passes the front-end iterable check but has no codegen loop emitter, so it reaches codegen as UnhandledIterableAtCodegen instead of either being rejected at typecheck or lowered",
    ticket: "sn48d1",
) {
    let r = compile_test_helpers.compile_and_run(forin_bytes_src(), "_forin_over_bytes_codegen_gap")
    assert(r.exit_code == 0, "expected clean run, got exit_code={r.exit_code} err={r.err_out}")
}
