test "for-in over a Map with a single-name binder reads the (K, V) pair" {
    let mut m: Map[Str, Int] = Map.new()
    m.insert("a", 1)
    m.insert("b", 2)
    let mut total = 0
    let mut count = 0
    for pair in m {
        total = total + pair.1
        count = count + 1
    }
    assert_eq(count, 2)
    assert_eq(total, 3)
}

test "for-in over a Map with a (k, v) binder destructures the pair" {
    let mut m: Map[Str, Int] = Map.new()
    m.insert("a", 1)
    m.insert("b", 2)
    let mut sum_v = 0
    let mut total_key_len = 0
    let mut count = 0
    for (k, v) in m {
        sum_v = sum_v + v
        total_key_len = total_key_len + k.len()
        count = count + 1
    }
    assert_eq(count, 2)
    assert_eq(sum_v, 3)
    assert_eq(total_key_len, 2)
}
