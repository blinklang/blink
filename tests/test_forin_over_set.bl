test "for-in over a Set sums every element exactly once" {
    let mut s: Set[Int] = Set.new()
    s.insert(3)
    s.insert(1)
    s.insert(2)
    let mut total = 0
    let mut count = 0
    for x in s {
        total = total + x
        count = count + 1
    }
    assert_eq(count, 3)
    assert_eq(total, 6)
}
