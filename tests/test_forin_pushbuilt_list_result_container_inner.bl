// A for-in over a push()-built List[Result[Map/List inner, E]] must emit its
// scrutinee temp with the element's full carrier type, not an erased lossy
// carrier tag (e.g. blink_Result_map_str) that mismatches the element.

import compile_test_helpers.{compile_and_run}

test "for-in over a push-built List[Result[Map,Str]] matches the container inner correctly" {
    let src = #"
import std.io

fn main() ! IO {
    let mut xs: List[Result[Map[Int, Str], Str]] = []
    let mut m: Map[Int, Str] = Map()
    m.insert(1, "a")
    xs.push(Ok(m))
    for r in xs {
        match r {
            Ok(mp) => io.println("ok len={mp.len()}")
            Err(e) => io.println("err={e}")
        }
    }
}
"#
    let r = compile_and_run(src, "_forin_pushbuilt_list_result_map_inner")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "ok len=1\n")
}

test "for-in over a push-built List[Result[List,Str]] matches the container inner correctly" {
    let src = #"
import std.io

fn main() ! IO {
    let mut xs: List[Result[List[Int], Str]] = []
    xs.push(Ok([1, 2, 3]))
    for r in xs {
        match r {
            Ok(l) => io.println("ok len={l.len()}")
            Err(e) => io.println("err={e}")
        }
    }
}
"#
    let r = compile_and_run(src, "_forin_pushbuilt_list_result_list_inner")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "ok len=3\n")
}
