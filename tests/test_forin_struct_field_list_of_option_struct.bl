import compile_test_helpers

// A for-in loop over a struct field of type List[Option[Struct]] must give
// the loop var the correct element carrier, not an erased Option scalar.

fn forin_field_list_option_struct_src() -> Str {
    #"type Point { x: Int, y: Int }
type Holder {
    xs: List[Option[Point]]
}
fn main() ! IO {
    let h = Holder { xs: [Some(Point { x: 2, y: 3 })] }
    for item in h.xs {
        match item {
            Some(p) => { io.println("sum={p.x + p.y}") }
            None => { io.println("none") }
        }
    }
}
"#
}

test.failing(
    "for-in over a struct-field List[Option[Struct]] compiles and matches the element",
    reason: "the for-in loop-var binder derives the element carrier from a NAME-keyed lookup that only covers a local variable receiver; for a struct-field receiver it declines and defaults to an erased Option_int, which then mismatches the match arm's correctly recovered Option_Point scrutinee type",
    ticket: "nycnt7",
) {
    let r = compile_test_helpers.compile_and_run(forin_field_list_option_struct_src(), "_forin_field")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "sum=5\n")
}
