import compile_test_helpers.{compile_and_run}

// A plain function (not just an effect operation) declaring a Template[C] parameter
// must decompose a string-literal argument into a template value, per
// sections/03b_contracts.md's Template[C] literal-coercion rule.

test "an ordinary fn with a Template[Str] param decomposes a string literal argument" {
    let src = #"
fn takes(t: Template[Str]) -> Int {
    t.count()
}
fn main() ! IO {
    let n = 1
    io.println("c={takes("n={n}")}")
}
"#
    let r = compile_and_run(src, "_free_fn_template_param_literal")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "c=1\n")
}
