// A clause of an FS handler implements one operation of §4.4.5, so it must name one and take
// and answer exactly that operation's types. A clause that does not would be accepted and
// then either never run or be called through a slot of another C type.

import compile_test_helpers

fn fs_handler(clauses: Str) -> Str {
    "import std.fs.\{FsError, FileInfo}\nfn main() ! IO, FS \{\n    with handler FS \{\n{clauses}\n    } \{\n        let _ = fs.read(\"x\")\n    }\n}\n"
}

test "an FS read clause that answers Str instead of Result[Str, FsError] is rejected" {
    let src = fs_handler("        fn read(path: Str) -> Str \{ path }")
    compile_test_helpers.expect_compile_error(src, "_fs_clause_wrong_ret", "E0300")
}

test "an FS write clause with a parameter of the wrong type is rejected" {
    let src = fs_handler("        fn write(path: Str, content: Int) -> Result[(), FsError] \{ Ok(()) }")
    compile_test_helpers.expect_compile_error(src, "_fs_clause_wrong_param", "E0300")
}

test "an FS delete clause with an extra parameter is rejected" {
    let src = fs_handler("        fn delete(path: Str, force: Bool) -> Result[(), FsError] \{ Ok(()) }")
    compile_test_helpers.expect_compile_error(src, "_fs_clause_extra_param", "E0300")
}

test "an FS clause naming no FS operation is rejected" {
    let src = fs_handler("        fn remove(path: Str) -> Result[(), FsError] \{ Ok(()) }")
    compile_test_helpers.expect_compile_error(src, "_fs_clause_unknown_op", "E0505")
}

test "an FS.Read handler clause for the FS.Delete operation is rejected" {
    let src = "import std.fs.\{FsError}\nfn main() ! IO, FS \{\n    with handler FS.Read \{\n        fn delete(path: Str) -> Result[(), FsError] \{ Ok(()) }\n    } \{\n        let _ = fs.read(\"x\")\n    }\n}\n"
    compile_test_helpers.expect_compile_error(src, "_fs_clause_wrong_sub_effect", "E0505")
}

test "FS clauses with the spec signatures compile clean" {
    let src = fs_handler("        fn read(path: Str) -> Result[Str, FsError] \{ Ok(path) }\n        fn write(_p: Str, _c: Str) -> Result[(), FsError] \{ Ok(()) }\n        fn list_dir(_p: Str) -> Result[List[Str], FsError] \{ Ok([]) }\n        fn stat(p: Str) -> Result[FileInfo, FsError] \{ default.stat(p) }\n        fn delete(_p: Str) -> Result[(), FsError] \{ Ok(()) }")
    let out = compile_test_helpers.compile_and_capture(src, "_fs_clause_spec_shape")
    compile_test_helpers.expect_compiles_clean(out, "spec-shaped FS handler")
}
