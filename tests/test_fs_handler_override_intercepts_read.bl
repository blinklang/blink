// A `with handler FS { fn read(...) {...} }` block must intercept fs.read calls made
// inside its body, the same way `handler IO`/`handler Env` already intercept their ops.

import compile_test_helpers.{compile_and_run}

test.failing(
    "with handler FS overrides fs.read for calls made inside the with-block",
    reason: "fs.read does not dispatch through the installed FS handler, so the call inside the with-block reads the real file system and the unwrap panics on the missing file",
) {
    let src = #"
import std.fs
fn main() ! IO, FS {
    with handler FS {
        fn read(path: Str) -> Str {
            "[mock] {path}"
        }
    } {
        let r = fs.read("nonexistent.txt")
        io.println(r.unwrap())
    }
}
"#
    let r = compile_and_run(src, "_fs_handler_override_read")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "[mock] nonexistent.txt\n")
}
