// fs.read, fs.write, and fs.list_dir are builtin-receiver "cg_call intrinsic 'fs.X' is not
// built" ICEs still open in the tid-native codegen rewrite (fs.delete and fs.errno are
// already lowered). Each redirects to its fs_do_* declared function in fs_ops.bl, the same
// shape fs.delete already uses.

import std.fs

test "fs.write then fs.read round-trips a file's content" {
    let path = "build/test_fs_intrinsic_rw.txt"
    match fs.write(path, "hello intrinsics") {
        Ok(_) => assert(true)
        Err(_) => assert(false)
    }
    match fs.read(path) {
        Ok(content) => assert_eq(content, "hello intrinsics")
        Err(_) => assert(false)
    }
    let _ = fs.delete(path)
}

test "fs.list_dir answers a non-empty list for an existing directory" {
    match fs.list_dir(".") {
        Ok(entries) => assert(entries.len() > 0)
        Err(_) => assert(false)
    }
}

test "fs.read of a missing path answers Err" {
    match fs.read("build/test_fs_intrinsic_no_such_file.txt") {
        Ok(_) => assert(false)
        Err(_) => assert(true)
    }
}
