// The `fs` operation handle needs no import (sections/04_effects.md §4.4.5); only a program
// that names FsError, FsOp, FileInfo or FileKind imports std.fs to reach them.

import compile_test_helpers.{compile_and_run, compile_and_capture, expect_error, run_xmod}

test "fs.write, read, stat, list_dir and delete compile and run with no import" {
    let src = #"
fn main() ! IO, FS {
    let dir = "build/_fs_ops_no_import_dir"
    let path = "{dir}/probe.txt"
    match fs.stat(dir) {
        Ok(_) => io.println("dir there")
        Err(_) => io.println("no dir")
    }
    let _mk = process.run("mkdir", ["-p", dir])
    fs.write(path, "hello").unwrap()
    io.println(fs.read(path).unwrap())
    io.println("size {fs.stat(path).unwrap().size}")
    io.println("entries {fs.list_dir(dir).unwrap().len()}")
    fs.delete(path).unwrap()
    match fs.read(path) {
        Ok(_) => io.println("still there")
        Err(e) => io.println("gone: {e}")
    }
}
"#
    let r = compile_and_run(src, "_fs_ops_no_import")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "no dir\nhello\nsize 5\nentries 1\ngone: read build/_fs_ops_no_import_dir/probe.txt: No such file or directory\n")
}

test "a module that is not the entry performs fs.* with no import" {
    let helper = #"
pub fn size_of(p: Str) -> Int ! FS.Read {
    match fs.stat(p) {
        Ok(info) => info.size
        Err(_) => -1
    }
}
"#
    let entry = #"
import fx.helper

fn main() ! IO, FS {
    io.println("{helper.size_of("build/_fs_ops_no_import_absent.txt")}")
}
"#
    let r = run_xmod(entry, "fx", "helper", helper, "fs_ops_no_import_xmod")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert(r.out.ends_with("-1\n"), "out was {r.out}")
}

test "the fs error type still needs the import" {
    let src = #"
fn describe(e: FsError) -> Str { "{e}" }

fn main() ! IO, FS {
    match fs.read("build/_fs_ops_no_import_absent.txt") {
        Ok(_) => io.println("there")
        Err(e) => io.println(describe(e))
    }
}
"#
    let out = compile_and_capture(src, "_fs_error_type_needs_import")
    expect_error(out, "ImportNotSelected", "FsError named with no import")
}
