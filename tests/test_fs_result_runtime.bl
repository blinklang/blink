// The fs ops return Result[T, FsError]. The raw C ops signal errno; the op's default
// body (private to std.fs_ops) turns that errno into Err(FsError{op, path, code}) or
// Ok(value). These tests call the ops through the `fs` handle, the only way user code
// reaches the default bodies.
import std.fs.{FsError, FsOp}

test "fs.write then fs.read round-trips Ok" {
    let path = "build/fs_result_runtime_rw.txt"
    match fs.write(path, "hello fs result") {
        Ok(_) => assert(true)
        Err(_) => assert(false)
    }
    match fs.read(path) {
        Ok(content) => assert_eq(content, "hello fs result")
        Err(_) => assert(false)
    }
    let _ = fs.delete(path)
}

test "fs.read of a missing path is Err(FsError) with Read op and a nonzero code" {
    match fs.read("build/fs_result_runtime_does_not_exist.txt") {
        Ok(_) => assert(false)
        Err(e) => {
            assert_eq(e.path, "build/fs_result_runtime_does_not_exist.txt")
            match e.op {
                FsOp.Read => assert(true)
                _ => assert(false)
            }
            match e.code {
                Errno(rc) => assert(rc != 0)
            }
        }
    }
}

test "fs.write into a missing directory is Err(FsError) with Write op" {
    match fs.write("build/fs_result_runtime_no_such_dir/f.txt", "x") {
        Ok(_) => assert(false)
        Err(e) => {
            match e.op {
                FsOp.Write => assert(true)
                _ => assert(false)
            }
            match e.code {
                Errno(rc) => assert(rc != 0)
            }
        }
    }
}

test "fs.delete removes an existing file, then reading it is Err" {
    let path = "build/fs_result_runtime_del.txt"
    let _ = fs.write(path, "doomed")
    match fs.delete(path) {
        Ok(_) => assert(true)
        Err(_) => assert(false)
    }
    match fs.read(path) {
        Ok(_) => assert(false)
        Err(e) => match e.op {
            FsOp.Read => assert(true)
            _ => assert(false)
        }
    }
}

test "fs.delete of a missing path is Err(FsError) with Delete op" {
    match fs.delete("build/fs_result_runtime_missing_del.txt") {
        Ok(_) => assert(false)
        Err(e) => {
            match e.op {
                FsOp.Delete => assert(true)
                _ => assert(false)
            }
            match e.code {
                Errno(rc) => assert(rc != 0)
            }
        }
    }
}

test "fs.list_dir of an existing directory is Ok" {
    match fs.list_dir(".") {
        Ok(entries) => assert(entries.len() > 0)
        Err(_) => assert(false)
    }
}

test "fs.list_dir of a missing directory is Err(FsError) with ListDir op" {
    match fs.list_dir("build/fs_result_runtime_no_such_dir_xyz") {
        Ok(_) => assert(false)
        Err(e) => {
            match e.op {
                FsOp.ListDir => assert(true)
                _ => assert(false)
            }
            match e.code {
                Errno(rc) => assert(rc != 0)
            }
        }
    }
}
