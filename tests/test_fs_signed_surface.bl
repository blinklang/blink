// vyvez3 (fs-result-surface Stage 3): the PUBLIC fs.* surface returns
// Result[T, FsError] per sections/04_effects.md:800-838. fs.read/write/list_dir
// redirect codegen to the fs_do_* wrappers (like net.request -> http_do_request);
// fs.delete replaces the old bare fs.remove. Consumers use ? / match / unwrap.
import std.fs.{FsError, FsOp}

fn read_signed(path: Str) -> Result[Str, FsError] ! FS.Read {
    let text = fs.read(path)?
    Ok(text)
}

test "fs.write then fs.read round-trips through the signed surface" {
    let path = "build/vyvez3_rw.txt"
    match fs.write(path, "hello vyvez3") {
        Ok(_) => assert(true)
        Err(_) => assert(false)
    }
    match fs.read(path) {
        Ok(content) => assert_eq(content, "hello vyvez3")
        Err(_) => assert(false)
    }
    let _ = fs.delete(path)
}

test "? propagates FsError unchanged from fs.read" {
    match read_signed("build/vyvez3_missing.txt") {
        Ok(_) => assert(false)
        Err(e) => {
            assert_eq(e.path, "build/vyvez3_missing.txt")
            match e.op {
                FsOp.Read => assert(true)
                _ => assert(false)
            }
        }
    }
}

test "fs.list_dir returns Ok(List[Str]) for an existing directory" {
    match fs.list_dir(".") {
        Ok(entries) => assert(entries.len() > 0)
        Err(_) => assert(false)
    }
}

test "fs.delete of a missing path is Err(FsError) with Delete op" {
    match fs.delete("build/vyvez3_no_such_del.txt") {
        Ok(_) => assert(false)
        Err(e) => {
            match e.op {
                FsOp.Delete => assert(true)
                _ => assert(false)
            }
            match e.code {
                Errno(rc) => assert(rc != 0)
            }
        }
    }
}
