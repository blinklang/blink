// fs.stat (sections/04_effects.md §4.4.5) answers the metadata of the file at a path, or
// the FsError of the failed stat(2).

import compile_test_helpers.{compile_and_run}

test "fs.stat reports kind, size and mtime, and a missing path as not_found" {
    let src = #"
import std.fs.{FsError, FsOp, FileKind, FsErrorExt}

fn main() ! IO, FS {
    let path = "build/_fs_stat_probe.txt"
    fs.write(path, "12345").unwrap()
    let info = fs.stat(path).unwrap()
    io.println("file: {info.kind == FileKind.File} {info.size} {info.mtime.to_unix_secs() > 0}")
    io.println("dir: {fs.stat("build").unwrap().kind == FileKind.Dir}")
    fs.delete(path).unwrap()
    match fs.stat(path) {
        Ok(_) => io.println("still there")
        Err(e) => io.println("gone: {e.not_found()} {e.op == FsOp.Stat} {e}")
    }
}
"#
    let r = compile_and_run(src, "_fs_stat_probe")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "file: true 5 true\ndir: true\ngone: true true stat build/_fs_stat_probe.txt: No such file or directory\n")
}
