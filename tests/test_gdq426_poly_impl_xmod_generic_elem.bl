// br gdq426: a poly-impl call on `List[<module-qualified generic instance>]` erased the
// element's TYPE ARGUMENT, collapsing two instantiations onto one C symbol.
//
// poly_impl_concrete_args built the mono CSV for a poly-impl List receiver and, when
// tc_poly_elem_slot_encodable declined the element tid, fell to the string branch
// `c_type_tag_for_struct(get_list_elem_struct(obj_str))`. That helper spells only the
// struct HEAD — `multifile_helper_HelperBox` — dropping the `[Int]` / `[HelperPoint]`.
// So both instantiations below mangled the single symbol
//     blink_List_Firsty_first_or_multifile_helper_HelperBox
// and the C compile failed passing a HelperBox_HelperPoint where HelperBox_Int was
// declared.
//
// This is a REACHABILITY guard: with the two elements collapsed the program does not
// compile at all. The assertions pin the values so a future collapse that happens to
// still compile is caught too.
//
// THE AXIS IS THE QUALIFIED TYPE REFERENCE, NOT THE IMPORT FORM. Writing these same two
// types under a SELECTIVE import (`import multifile_helper.{HelperBox, HelperPoint}`,
// then bare `HelperBox[Int]`) took the tid branch and was already correct — measured, not
// assumed. `import multifile_helper` + `multifile_helper.HelperBox[Int]` is what reaches
// the string branch. Do not "simplify" this fixture to the selective form; it stops
// testing anything.
//
// The element must ALSO be generic. Measured with a temporary `polycsv` tap over 13
// hand-built element shapes (scalars, bare containers, tuples, compounds, same-module
// struct instances, qualified BARE structs and enums) plus the 726-file corpus: every
// other shape's string spelling AGREED with the ungated tid spelling. A qualified bare
// `multifile_helper.HelperPoint` element took the tid branch and spelled correctly, which
// is why the control row below passed before the fix too.
//
// Fixed at the PRODUCER per qnpb2d I5: the seam renders its CSV from the element tid,
// which already spelled both correctly. Do NOT re-guard by widening
// c_type_tag_for_struct — the string CSV producer is gone.
//
// The body is if/return rather than the more natural `match self.get(0) { ... }` because
// a match body hits a SEPARATE pre-existing defect (br pskbqh): the synthesized
// fall-through `return 0` after the match is int-typed and fails to compile for a
// struct-typed T. That is independent of this seam — it reproduces with a same-module
// `Box[Int]` element under a correctly spelled symbol.

import multifile_helper

trait Firsty[T] {
    fn first_or(self, d: T) -> T
}

impl[T] Firsty[T] for List[T] {
    fn first_or(self, d: T) -> T {
        if self.len() > 0 {
            return self.get(0).unwrap()
        }
        return d
    }
}

test "poly-impl over two qualified generic instances keeps distinct C symbols" {
    let a: List[multifile_helper.HelperBox[Int]] = [multifile_helper.HelperBox { v: 7 }]
    let b: List[multifile_helper.HelperBox[multifile_helper.HelperPoint]] = [multifile_helper.HelperBox { v: multifile_helper.HelperPoint { x: 3, y: 4 } }]

    assert_eq(a.first_or(multifile_helper.HelperBox { v: 0 }).v, 7)
    assert_eq(b.first_or(multifile_helper.HelperBox { v: multifile_helper.HelperPoint { x: 0, y: 0 } }).v.x, 3)
}

// A single qualified generic instance alone is enough to erase the type argument; the
// two-element shape above is what turns the erasure into a COLLISION. Keep both: if only
// the collision is tested, a fix that erases CONSISTENTLY would pass.
test "one qualified generic instance keeps its type argument" {
    let a: List[multifile_helper.HelperBox[Int]] = [multifile_helper.HelperBox { v: 11 }]
    assert_eq(a.first_or(multifile_helper.HelperBox { v: 0 }).v, 11)
}

// Control: a qualified BARE struct element already took the tid branch and spelled
// `multifile_helper_HelperPoint` correctly. It must keep working, and must keep a symbol
// distinct from the generic-instance ones.
test "qualified bare struct element is unaffected" {
    let p: List[multifile_helper.HelperPoint] = [multifile_helper.HelperPoint { x: 5, y: 6 }]
    assert_eq(p.first_or(multifile_helper.HelperPoint { x: 0, y: 0 }).y, 6)
}
