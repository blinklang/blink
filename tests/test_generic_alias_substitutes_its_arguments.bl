// A generic alias stands for its target with the alias's arguments put in place of its
// parameters. The target's parameters are not the alias's: `Swap[A, B] = Pair[B, A]` reorders
// them, `Fixed[X] = Box[Int]` drops one, and `Listed[X] = Box[List[X]]` nests one.

type Box[T] { x: T }
type Pair[A, B] { a: A, b: B }
type Tree[T] { Leaf(T), Empty }

type Same[X] = Box[X]
type Later[Y] = Declared[Y]
type Declared[X] = Box[X]
type Swap[X, Y] = Pair[Y, X]
type Half[X] = Pair[X, Int]
type Fixed[X] = Box[Int]
type Listed[X] = Box[List[X]]
type Kind[X] = Tree[X]
type Seq[X] = List[X]
type Named[V] = Map[Str, V]
type Maybe[X] = Option[X]
type Res[X] = Result[X, Str]
type Twice[X] = (X, X)
type Step[X] = fn(X) -> X
type Self2[X] = X
// A type parameter of std's Map helpers has this name. The alias must not reach it.
type K[X] = List[X]

type Holds { s: Same[Int] }
type HoldsT[T] { s: Same[T], k: Kind[T] }
type Payload { Has(Same[Int]), Gone }

trait Adds[X] { fn adds(self, a: Same[X]) -> Same[X] }
type Adder { n: Int }
impl Adds[Int] for Adder { fn adds(self, a: Same[Int]) -> Same[Int] { Box { x: a.x + self.n } } }

fn sig(a: Same[Int]) -> Same[Int] { Box { x: a.x + 1 } }
fn sig_swap(s: Swap[Int, Str]) -> Str { s.a }
fn sig_fixed(f: Fixed[Str]) -> Int { f.x + 1 }
fn sig_listed(l: Listed[Int]) -> Int { l.x.len() }
fn sig_kind(k: Kind[Int]) -> Int {
    match k {
        Tree.Leaf(v) => v
        Tree.Empty => 0
    }
}
fn gen_arg[T](a: Same[T]) -> T { a.x }
fn gen_seq[T](xs: Seq[T]) -> Int { xs.len() }
fn gen_local[U](u: U) -> U {
    let a: Same[U] = Box { x: u }
    a.x
}
fn gen_ret[T](t: T) -> Listed[T] { Box { x: [t] } }
fn alias_mk[T](t: T) -> Same[T] { Box { x: t } }
fn alias_id[T](a: Same[T]) -> Same[T] { a }
fn binder_named_like_alias[K](k: K) -> K {
    let a: List[K] = [k]
    a.get(0).unwrap()
}
fn try_res(x: Int) -> Res[Int] {
    let y: Result[Int, Str] = Ok(x)
    let z = y?
    Ok(z + 1)
}

test "an alias of a struct in a local annotation" {
    let a: Same[Int] = Box { x: 1 }
    assert_eq(a.x, 1)
    let b: Box[Int] = a
    let c: Same[Int] = b
    assert_eq(c.x, 1)
}

test "an alias of an alias, declared in either order" {
    let a: Later[Str] = Box { x: "s" }
    assert_eq(a.x, "s")
}

test "an alias that reorders, fixes, drops or nests a parameter" {
    let s: Swap[Int, Str] = Pair { a: "s", b: 1 }
    assert_eq(s.a, "s")
    assert_eq(s.b, 1)
    let h: Half[Str] = Pair { a: "s", b: 1 }
    assert_eq(h.a, "s")
    let f: Fixed[Str] = Box { x: 1 }
    assert_eq(f.x, 1)
    let l: Listed[Int] = Box { x: [1, 2] }
    assert_eq(l.x.len(), 2)
}

test "an alias of an enum" {
    let k: Kind[Int] = Tree.Leaf(4)
    assert_eq(sig_kind(k), 4)
    assert_eq(sig_kind(Tree.Empty), 0)
}

test "an alias of a builtin type" {
    let l: Seq[Int] = [1, 2]
    assert_eq(l.len(), 2)
    let mut m: Named[Int] = Map()
    m.insert("a", 1)
    assert_eq(m.get("a") ?? 0, 1)
    let o: Maybe[Int] = Some(1)
    assert_eq(o ?? 0, 1)
    let r: Res[Int] = Ok(1)
    assert(r.is_ok())
    let t: Twice[Int] = (1, 2)
    assert_eq(t.1, 2)
    let st: Step[Int] = fn(a) { a + 1 }
    assert_eq(st(1), 2)
    let n: Self2[Int] = 3
    assert_eq(n + 1, 4)
}

test "an alias nested in another type" {
    let xs: List[Same[Int]] = [Box { x: 1 }]
    assert_eq(xs.get(0).unwrap().x, 1)
    let o: Option[Same[Str]] = Some(Box { x: "a" })
    assert_eq(o.unwrap().x, "a")
    let n: Same[Same[Int]] = Box { x: Box { x: 1 } }
    assert_eq(n.x.x, 1)
}

test "an alias in a field and a variant payload" {
    let h = Holds { s: Box { x: 1 } }
    assert_eq(h.s.x, 1)
    let g = HoldsT { s: Box { x: "s" }, k: Tree.Leaf("k") }
    assert_eq(g.s.x, "s")
    let p = Payload.Has(Box { x: 2 })
    let got = match p {
        Payload.Has(b) => b.x
        Payload.Gone => 0
    }
    assert_eq(got, 2)
}

test "an alias in a signature means the target at the alias's arguments" {
    assert_eq(sig(Box { x: 1 }).x, 2)
    assert_eq(sig_swap(Pair { a: "s", b: 1 }), "s")
    assert_eq(sig_fixed(Box { x: 1 }), 2)
    assert_eq(sig_listed(Box { x: [1, 2, 3] }), 3)
}

test "an alias under a type parameter" {
    assert_eq(gen_arg(Box { x: 1 }), 1)
    assert_eq(gen_arg(Box { x: "s" }), "s")
    let s: Seq[Int] = [1, 2]
    assert_eq(gen_seq(s), 2)
    assert_eq(gen_seq(["a"]), 1)
    assert_eq(gen_local(1), 1)
    assert_eq(gen_local("s"), "s")
    assert_eq(gen_ret(1).x.len(), 1)
}

test "an alias through a generic call, a fn type and a trait method" {
    assert_eq(alias_id(alias_mk(1)).x, 1)
    let b: List[Same[Str]] = [alias_mk("s")]
    assert_eq(b.len(), 1)
    let f: fn(Same[Int]) -> Same[Int] = alias_id
    assert_eq(f(Box { x: 3 }).x, 3)
    assert_eq(Adder { n: 1 }.adds(Box { x: 1 }).x, 2)
}

test "a type parameter named like an alias binds its own type" {
    let k: K[Int] = [1]
    assert_eq(k.len(), 1)
    assert_eq(binder_named_like_alias("s"), "s")
}

test "a question mark in a fn that returns an alias of Result" {
    assert_eq(try_res(1).unwrap(), 2)
}

type DropPair[A, B] { a: A, b: B }
type DropSwap[A, B] = DropPair[B, A]
type DropFixed[X] = DropPair[Int, Int]
type RawOf[X] = Raw[X]

fn from_swap[T](p: DropSwap[Int, T]) -> T { p.a }
fn from_return[T](_p: DropFixed[T]) -> List[T] { [] }
fn takes_raw(_h: RawOf[Str]) -> Int { 1 }

test "a binder an alias passes on has a source, and the return can source one the alias drops" {
    assert_eq(from_swap(DropPair { a: "ok", b: 1 }), "ok")
    let none: List[Str] = from_return(DropPair { a: 1, b: 2 })
    assert_eq(none.len(), 0)
}

test "an alias to Raw substitutes its argument" {
    assert_eq(takes_raw(Raw("x")), 1)
}
