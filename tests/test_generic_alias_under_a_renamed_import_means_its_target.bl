// An alias imported under another name means the target of its own declaration, at the
// arguments the reading file wrote. The fixture lives under a fresh temporary directory, since
// the test tree itself sits inside a project.

import std.process.{ProcessResult, ChildEnd}

fn sh(cmd: Str) -> ProcessResult ! Process.Spawn {
    process.run("sh", ["-c", cmd]).unwrap()
}

test "a generic alias imported under another name builds and runs" {
    let dir = sh("mktemp -d /tmp/blink_renamed_generic_alias.XXXXXX").out.trim()
    let _ = sh("mkdir -p {dir}/src")
    fs.write("{dir}/blink.toml", "[package]\nname = \"app\"\nversion = \"0.1.0\"\n").unwrap()
    // A lock no older than blink.toml keeps dependency resolution out of the command.
    fs.write("{dir}/blink.lock", "[metadata]\nlockfile-version = 1\n").unwrap()
    fs.write("{dir}/src/shapes.bl", "pub type Pair[A, B] \{ a: A, b: B }\npub type Swap[X, Y] = Pair[Y, X]\n").unwrap()
    fs.write("{dir}/src/main.bl", "import shapes.\{Pair, Swap as Flip}\n\nfn first(s: Flip[Int, Str]) -> Str \{ s.a }\n\nfn main() \{\n    let s: Flip[Int, Str] = Pair \{ a: \"s\", b: 2 }\n    io.println(\"\{first(s)} \{s.b}\")\n}\n").unwrap()
    // BLINK_BIN makes the build workers the compiler under test, not the blink on PATH.
    let r = sh("B=$(pwd)/build/blink; cd {dir} && BLINK_BIN=$B $B run src/main.bl 2>&1")
    let _ = sh("rm -rf {dir}")

    assert_eq(r.out.trim(), "s 2")
    assert_eq(r.end, ChildEnd.Exited(0))
}
