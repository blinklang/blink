// Annotations inside a generic body that name a generic struct or enum with the body's
// own type parameter, alone or under a container, run with the argument each call gives.
// The enum case builds in its own program: its compile error must fail only its row.

import compile_test_helpers.{compile_and_run}

type Box[T] { value: T }

fn mk[T](v: T) -> Box[T] {
    let b: Box[T] = Box { value: v }
    b
}

fn wrap_list[T](v: T) -> List[Box[T]] {
    let xs: List[Box[T]] = [Box { value: v }]
    xs
}

fn wrap_map[T](v: T) -> Map[Str, Box[T]] {
    let mut m: Map[Str, Box[T]] = Map()
    m.insert("k", Box { value: v })
    m
}

fn some_box[T](v: T) -> Option[Box[T]] {
    let o: Option[Box[T]] = Some(Box { value: v })
    o
}

fn twice[T](v: T) -> Box[Box[T]] {
    let b: Box[Box[T]] = Box { value: Box { value: v } }
    b
}

test "a generic struct annotation in a generic body" {
    assert_eq(mk(3).value, 3)
    assert_eq(mk("s").value, "s")
}

test.failing(
    "a generic enum annotation in a generic body",
    reason: "a positional generic enum variant constructor inside a generic fn body gets no monomorphised result type, so codegen reports UnspellableCallType for Tree",
) {
    let src = #"
import std.io

type Tree[T] { Leaf(T), Empty }

fn leaf[T](v: T) -> Tree[T] {
    let t: Tree[T] = Tree.Leaf(v)
    t
}

fn main() ! IO {
    match leaf(4) {
        Tree.Leaf(n) => io.println("leaf {n}")
        Tree.Empty => io.println("empty")
    }
}
"#
    let r = compile_and_run(src, "_generic_annotation_in_a_generic_body_enum")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "leaf 4\n")
}

test "a generic struct under a container annotation in a generic body" {
    assert_eq(wrap_list(1).get(0).unwrap().value, 1)
    assert_eq(wrap_map(7).get("k").unwrap().value, 7)
    assert_eq(some_box("x").unwrap().value, "x")
}

test "a generic struct nested in a generic struct annotation in a generic body" {
    assert_eq(twice(5).value.value, 5)
}
