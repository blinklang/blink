// Arguments that agree on a type parameter run as one instance. The empty list and the bare
// None leave T open after the first argument; the second argument fixes it.
fn pick[T](a: T, b: T) -> T {
    let pair = (a, b)
    pair.0
}

test "two Ints pick the first" {
    assert_eq(pick(2, 3), 2)
}

test "an integer literal after a sized integer is that integer" {
    let x: I8 = 3
    let r = pick(x, 1)
    assert_eq(r, x)
}

test "an empty list first takes its element from the second argument" {
    let r = pick([], [1])
    assert_eq(r.len(), 0)
}

test "a bare None first takes its payload from the second argument" {
    let r = pick(None, Some(1))
    assert_eq(r ?? 7, 7)
}
