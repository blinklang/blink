// A bare carrier argument (`None`, `Err(e)`, `Ok(v)`) to a generic fn leaves a slot
// that only a sibling argument names. Each row fails when that slot keeps the callee's
// own type parameter, which nothing at the call site can ever make concrete.

fn or_default[T](o: Option[T], d: T) -> T { o ?? d }

fn ok_or[T](r: Result[T, Str], d: T) -> T {
    match r {
        Ok(v) => { return v }
        Err(_) => { return d }
    }
}

fn err_len[E](r: Result[Int, E], f: fn(E) -> Int) -> Int {
    match r {
        Ok(v) => { return v }
        Err(e) => { return f(e) }
    }
}

fn first_or[T](xs: List[Option[T]], d: T) -> T { xs.get(0).unwrap() ?? d }

test "None takes its element from a sibling Int argument" {
    assert_eq(or_default(None, 9), 9)
}

test "None takes its element from a sibling Str argument" {
    assert_eq(or_default(None, "z").len(), 1)
}

test "Err takes its ok slot from a sibling argument" {
    assert_eq(ok_or(Err("boom"), 4), 4)
}

test "Ok takes its err slot from the signature, not a parameter" {
    assert_eq(err_len(Ok(7), fn(e: Str) -> Int { e.len() }), 7)
}

test "None inside a list literal takes its element from a sibling argument" {
    assert_eq(first_or([None], 5), 5)
}
