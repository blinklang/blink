// br ya0739 (premise corrected) + jsmbtn (struct-value case): a generic fn
// building `Map[K, V]` inside its own body, called from ANOTHER generic
// context so V is bound to a struct instance rather than a concrete literal,
// erases the Map value to the bare generic head. The registration bail in
// register_map_elem_struct_mono (src/codegen_expr.bl, "An arg still spelled as
// a declared type-param means the caller is itself generic") fires on a
// STRING test (tparams_sl_contains on the resolved arg spelling) even when the
// tid path already resolved the concrete instance -- so a real binding gets
// discarded as if it were a genuine unresolved defer.
//
// Model: test_yvq32w_compound_inner_in_mono_body.bl (scalar-only V; this is
// its struct-value companion). The failure surfaces at runtime field access,
// so this MUST run via `task test` (archive-linked), not just compile.

type Box[T] {
    value: T
}

fn build_map[K, V](k: K, v: V) -> Map[K, V] {
    let mut m: Map[K, V] = Map()
    m.insert(k, v)
    m
}

fn wrap_and_build[T](k: Str, inner: T) -> Map[Str, Box[T]] {
    build_map(k, Box { value: inner })
}

test "generic caller of a generic Map-builder with a struct-instance value" {
    let m = wrap_and_build("k", 777)
    assert_eq(m.get("k").unwrap().value, 777)
}
