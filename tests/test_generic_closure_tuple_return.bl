import test_generic_closure_tuple_return_helper

type GctModel { count: Int }

fn gct_update(m: GctModel) -> (GctModel, Int) {
    (GctModel { count: m.count + 1 }, 7)
}

fn gct_label(m: GctModel) -> (GctModel, Str) {
    (m, "done")
}

test "generic closure returning tuple lowers to a tuple struct, wildcard discards second element" {
    let m = test_generic_closure_tuple_return_helper.gct_run_discard(GctModel { count: 10 }, gct_update)
    assert_eq(m.count, 11)
}

test "generic closure tuple wildcard discards first element, keeps scalar second" {
    let n = test_generic_closure_tuple_return_helper.gct_run_keep(GctModel { count: 0 }, gct_update)
    assert_eq(n, 7)
}

test "generic closure tuple with Str second element through destructure" {
    let s = test_generic_closure_tuple_return_helper.gct_run_pair(GctModel { count: 0 }, gct_label)
    assert_eq(s, "done")
}
