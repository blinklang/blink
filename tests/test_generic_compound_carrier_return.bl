// br 705b70 — a generic fn whose return is a compound carrier over a compound
// inner (Map[K,V] / Option[T] / Result[T,E]) must spell that carrier the SAME
// way at all three C sites: the mono fn signature, the return-expression, and
// the caller's let-decl. The mono ARGS are correct at every site (the mangled
// name carries 0Str_0Int), so the authoritative tid is in hand — only the
// C-spelling code disagreed, erasing the inner args at the signature
// (blink_Option_Map_void_void) and dropping them at the caller
// (blink_Option_map), while the return-expression spelled it correctly
// (blink_Option_Map_str_int). Three disagreeing spellings in one TU = hard cc
// failure. Option[List[T]] escapes because its carrier tag is param-less.
//
// Distinct from qy9ssr (missing reset borrowing an unrelated producer's
// carrier) and h4hpbq (cross-module MQ return substitution): here there is no
// other producer and no stale global — each site independently mis-spells the
// type it already has.

fn wrap_map[K, V](m: Map[K, V]) -> Option[Map[K, V]] { Some(m) }

fn oo[T](v: T) -> Option[Option[T]] { Some(Some(v)) }

fn orr[T](v: T) -> Option[Result[T, Str]] { Some(Ok(v)) }

test "generic fn returning Option[Map[K,V]] keeps K,V at signature and caller" {
    let mut m: Map[Str, Int] = Map()
    m.insert("k", 7)
    let om = wrap_map(m)
    let mut got = 0
    match om {
        Some(inner) => { got = inner.get("k").unwrap() }
        None => { got = -1 }
    }
    assert_eq(got, 7)
}

test "generic fn returning Option[Option[T]] keeps the inner T" {
    let mut got = 0
    match oo(5) {
        Some(o) => { got = o.unwrap() }
        None => { got = -1 }
    }
    assert_eq(got, 5)
}

test "generic fn returning Option[Result[T,Str]] keeps the Ok side" {
    let mut got = ""
    match orr("x") {
        Some(r) => { got = r.unwrap() }
        None => { got = "NONE" }
    }
    assert_eq(got, "x")
}
