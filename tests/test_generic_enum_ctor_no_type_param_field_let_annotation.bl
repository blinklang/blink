// Constructing a generic-enum variant that carries NO type-param payload
// (so T can only come from the let annotation, not the constructor value)
// must still specialize the enum instance from the annotation, not erase
// it to the bare enum head.

type Box[T] { Full(value: T) Empty(sentinel: Int) }

test "generic enum ctor with no T-bearing field infers from let annotation" {
    let e: Box[Int] = Empty(0)
    match e {
        Full(_v) => assert(false, "unexpected")
        Empty(s) => assert_eq(s, 0)
    }
}
