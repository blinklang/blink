// A generic enum's constructor must resolve to its own mono instance type
// even when one of its variant names collides with a variant name on an
// unrelated sibling enum.

import compile_test_helpers.{compile_and_run}

test.failing(
    "a generic enum ctor keeps its mono instance type despite a colliding sibling variant name",
    reason: "a generic enum constructor whose variant name also names a sibling enum's variant is not monomorphized, so codegen stops with ICE LayoutDeclined on the bare generic EG",
) {
    let src = #"
import std.io

type EW { Wrap(o: Int), Empty }
type EG[T] { Wrap(tag: T, o: Int), Empty }

fn f() -> Int {
    let e = EG.Wrap(1, 16)
    match e {
        EG.Wrap(_t, o) => o
        EG.Empty => 0
    }
}

fn main() ! IO {
    io.println("{f()}")
}
"#
    let r = compile_and_run(src, "_generic_enum_ctor_variant_name_collision")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "16\n")
}
