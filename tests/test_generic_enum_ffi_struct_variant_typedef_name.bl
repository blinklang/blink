// A generic enum with a struct-style variant, monomorphized over an
// @ffi.struct payload accessed through Ptr[T], must emit the correctly
// mangled per-instantiation typedef name.

@ffi.struct(header: "poll.h", name: "pollfd")
pub type Pollfd { fd: I32, events: I16, revents: I16 }

type GE[T] { V { p: Ptr[T] } Nil }

test "generic enum struct-style variant over an ffi struct pointer round-trips a value" {
    with ffi.scope() as scope {
        let ptr: Ptr[Pollfd] = scope.alloc()
        ptr.write(Pollfd { fd: 5, events: 1, revents: 0 })
        let e: GE[Pollfd] = GE.V { p: ptr }
        match e {
            GE.V { p } => assert_eq(p.deref().fd, 5)
            GE.Nil => assert(false)
        }
    }
}
