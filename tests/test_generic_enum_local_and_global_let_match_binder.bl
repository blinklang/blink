// A generic enum instance bound to a local or module-level `let` must spell its
// monomorphized type consistently at the constructor cast, and the match arm's
// payload binder must take the substituted payload type, not void.

type Tree[T] { Leaf, Node(v: T) }

let global_t: Tree[Int] = Tree.Node(v: 3)

test "local let of a generic enum instance matches its payload correctly" {
    let t: Tree[Int] = Tree.Node(v: 3)
    let m = match t {
        Tree.Leaf => 0
        Tree.Node(v) => v
    }
    assert_eq(m, 3)
}

test "module-level let of a generic enum instance matches its payload correctly" {
    let m = match global_t {
        Tree.Leaf => 0
        Tree.Node(v) => v
    }
    assert_eq(m, 3)
}
