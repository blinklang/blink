// jjhnf3: generic enum (type Name[T]) monomorphization.
// Directly-constructed instance Tree[Int] must:
//   (a) bind the type arg in typecheck,
//   (b,c) emit a per-instance mono enum typedef (Tree_Int) with real payloads,
//   (e) construct + match over the mono'd union.

type Tree[T] {
    Leaf(value: T)
    Branch(left: Tree[T], right: Tree[T])
}

fn leaf_value(t: Tree[Int]) -> Int {
    match t {
        Leaf(v) => return v
        Branch(_l, _r) => return 0
    }
}

fn main() ! IO {
    let t = Branch(Leaf(1), Leaf(2))   // Tree[Int]
    match t {
        Leaf(v) => {
            io.println("unexpected leaf: {v}")
        }
        Branch(l, r) => {
            let lv = leaf_value(l)
            let rv = leaf_value(r)
            assert(lv == 1, "left leaf value should be 1")
            assert(rv == 2, "right leaf value should be 2")
            io.println("ok lv={lv} rv={rv}")
        }
    }
}

test "generic enum Tree[Int] construct and match" {
    let t = Branch(Leaf(1), Leaf(2))
    match t {
        Leaf(_v) => assert(false, "should be a branch")
        Branch(l, r) => {
            assert_eq(leaf_value(l), 1)
            assert_eq(leaf_value(r), 2)
        }
    }
}
