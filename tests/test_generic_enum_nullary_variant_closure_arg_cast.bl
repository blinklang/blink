// A payload-less variant of a generic enum, constructed as the argument of an indirect
// (closure-typed) call, must cast to the concrete monomorphic instance type — the same
// instance the payload-carrying variant of the same enum already casts to correctly.

import compile_test_helpers.{compile_and_run}

test.failing(
    "a payload-less generic-enum variant passed through a closure-typed call site casts to its concrete instance",
    reason: "the argument compound-literal speller for a payload-less variant reads the declaring enum's bare base name instead of the expected concrete instance type when the call goes through a closure value, so the emitted C references an undeclared bare struct",
    ticket: "snbmkv",
) {
    let src = #"
type Maybe[T] {
    Nothing,
    Just(v: T)
}
fn main() ! IO {
    let f: fn(Maybe[Int]) -> Int = fn(m: Maybe[Int]) -> Int {
        match m {
            Maybe.Just(v) => v
            Maybe.Nothing => 0
        }
    }
    let a = f(Maybe.Just(42))
    let b = f(Maybe.Nothing)
    io.println("{a} {b}")
}
"#
    let r = compile_and_run(src, "_generic_enum_nullary_closure_arg")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "42 0\n")
}

test "a payload-less generic-enum variant inside an inline list literal casts to its concrete instance" {
    let src = #"
type Tree[T] { Leaf(T), Empty }
fn main() ! IO {
    let first = [Tree.Leaf(5), Tree.Empty].get(0).unwrap()
    let second = [Tree.Leaf(5), Tree.Empty].get(1).unwrap()
    match first {
        Tree.Leaf(n) => io.println("leaf {n}")
        Tree.Empty => io.println("empty")
    }
    match second {
        Tree.Leaf(n) => io.println("leaf {n}")
        Tree.Empty => io.println("empty")
    }
}
"#
    let r = compile_and_run(src, "_generic_enum_nullary_list_lit")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "leaf 5\nempty\n")
}
