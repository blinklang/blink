// A nullary variant of a generic enum, constructed directly inside Err(...), must mangle
// to its mono instance name (blink_Parsed_0Int) the same way it does when the value first
// passes through a let-annotation. Reading the bare node tid instead of the instance tid
// at the Err() call site drops the mono suffix and emits the unmangled base name, which
// was never declared.

import compile_test_helpers.{compile_and_run}

test.failing(
    "a generic enum's nullary variant built inline inside Err() mangles to its mono instance name",
    reason: "the Err()-wrapped nullary constructor Parsed.Bad reads the bare node tid instead of the instance tid used on the let-annotation channel, so codegen emits (blink_Parsed)\{.tag = 1\} instead of (blink_Parsed_0Int)\{.tag = 1\}, and blink_Parsed was never declared",
    ticket: "28gx4r",
) {
    let src = #"
import std.io

type Parsed[T] { Good(T), Bad }

fn f() -> Result[Int, Parsed[Int]] { return Err(Parsed.Bad) }

fn main() ! IO {
    match f() {
        Ok(_) => io.println("ok")
        Err(_) => io.println("err")
    }
}
"#
    let r = compile_and_run(src, "_generic_enum_nullary_variant_in_err_ctor_mangling")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "err\n")
}
