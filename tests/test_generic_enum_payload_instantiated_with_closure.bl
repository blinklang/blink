// A generic enum's type parameter, instantiated with a FUNCTION/closure type as the
// payload (Box.Full(fn(x: Int) -> Int { ... })), never gets T solved for monomorphization.
// This is a different shape from tests/test_closure_return_generic_enum_instance_unannotated_let.bl
// (a closure RETURNS a generic enum instance) and
// tests/test_match_arm_binder_generic_enum_closure_call_result.bl (a closure-typed value
// returns a generic enum instantiated with a concrete Str, not a closure, payload) -- here
// the enum's own type parameter T is substituted WITH a closure/Fn type.

import compile_test_helpers.{compile_and_run}

test.failing(
    "a generic enum instantiated with a closure payload monomorphizes",
    reason: "the mono name for the enum's Fn-typed variant field is built from an I0001 placeholder instead of a real Fn kind segment, so T reaches monomorphization unsolved and trips the UnsolvedTypeVarAtCodegen internal-compiler-error backstop at enum_typedef_tuple_prepass",
) {
    let src = #"
import std.io

type Box[T] { Empty, Full(T) }

fn main() {
    let b = Box.Full(fn(x: Int) -> Int { x + 1 })
    match b {
        Box.Empty => io.println("empty")
        Box.Full(f) => io.println("{f(41)}")
    }
}
"#
    let r = compile_and_run(src, "_generic_enum_payload_instantiated_with_closure")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "42\n")
}
