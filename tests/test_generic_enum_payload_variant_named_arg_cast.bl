// Constructing a generic enum's payload variant with a NAMED argument must instantiate
// the same concrete instance type as the positional form of the same construction.

test "named-arg construction of a generic enum payload variant matches the positional form" {
    let m = Maybe.Just(v: "hi")
    let named = match m {
        Maybe.Just(v) => v
        Maybe.Nothing => "nothing"
    }
    assert_eq(named, "hi")

    let m2 = Maybe.Just("hi")
    let positional = match m2 {
        Maybe.Just(v) => v
        Maybe.Nothing => "nothing"
    }
    assert_eq(positional, "hi")
}

type Maybe[T] {
    Nothing,
    Just(v: T)
}
