import compile_test_helpers

fn generic_enum_return_src() -> Str {
    #"type LTree[T] { Leaf, Node(T) }
fn mk_tree() -> LTree[Int] { LTree.Node(17) }
fn main() {
    match mk_tree() {
        LTree.Node(n) => { io.println("{n}") }
        LTree.Leaf => { io.println("leaf") }
    }
}
"#
}

test "a fn whose declared return type is a generic enum instance compiles to valid C" {
    let r = compile_test_helpers.compile_and_run(generic_enum_return_src(), "_enum_return")
    assert(r.exit_code == 0, "expected clean run, got exit_code={r.exit_code} err={r.err_out}")
    assert(r.out.contains("17"), "expected node value in output: out={r.out}")
}
