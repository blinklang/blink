// Destructuring a generic enum's struct-style variant in a match arm must bind the
// payload field with the scrutinee's instance type, not the bare declared typevar.

type Tree[T] {
    Leaf { value: T }
    Empty
}

fn show(t: Tree[Int]) -> Str {
    match t {
        Tree.Leaf { value } => "leaf:{value}"
        Tree.Empty => "empty"
    }
}

test "struct-style generic enum variant pattern binds the payload's instance type" {
    assert_eq(show(Tree.Leaf { value: 5 }), "leaf:5")
    assert_eq(show(Tree.Empty), "empty")
}
