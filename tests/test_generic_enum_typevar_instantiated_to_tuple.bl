// A generic enum whose type parameter is instantiated to a Tuple (not a
// scalar) must emit a valid mono typedef: the per-instance payload field
// takes the tuple carrier type, and the tuple carrier typedef itself is
// emitted so the field type resolves.

test "generic enum variant payload instantiated to a tuple type builds and reads back" {
    let b = Box.Hold((1, 2))
    match b {
        Box.Hold(v) => {
            assert_eq(v.0, 1)
            assert_eq(v.1, 2)
        }
    }
}

type Box[T] {
    Hold(value: T)
}
