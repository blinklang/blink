// Constructing a generic-enum variant through an Option carrier (Some(Tree.Leaf(v: 9))) must
// mangle to the mono instance's own name, not the unmangled base.

type Tree[T] { Leaf(v: T), Nil }
fn f() -> Option[Tree[Int]] { Some(Tree.Leaf(v: 9)) }

test "a generic-enum variant constructed through a carrier monomorphizes correctly" {
    match f().unwrap() {
        Leaf(v) => assert_eq(v, 9)
        Nil => assert(false)
    }
}
