import compile_test_helpers

fn generic_fn_concrete_carrier_param_src() -> Str {
    #"type GBx[T] {
    v: T
}

fn pick_first[T](o: Option[GBx[Int]], xs: List[T], d: T) -> T {
    match o {
        Some(b) => { if b.v > 0 { return xs.get(0) ?? d } }
        None => {}
    }
    d
}

fn main() {
    let xs: List[Str] = ["a", "b"]
    io.println("{pick_first(Some(GBx { v: 1 }), xs, "z")}")
    io.println("{pick_first(None, xs, "z")}")
}
"#
}

test("a generic fn's carrier param over a concrete generic struct compiles") {
    let r = compile_test_helpers.compile_and_run(generic_fn_concrete_carrier_param_src(), "_generic_fn_concrete_carrier_param")
    assert(r.exit_code == 0, "expected clean run, got exit_code={r.exit_code} err={r.err_out}")
    assert(r.out.contains("a"), "expected the Some branch to pick the first list element: out={r.out}")
    assert(r.out.contains("z"), "expected the None branch to fall back to the default: out={r.out}")
}
