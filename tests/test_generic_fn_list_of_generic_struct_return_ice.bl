// A generic fn returning List[Box[T]] (Box[T] a generic struct instantiated per-call
// with the fn's own type parameter) must monomorphize Box's field T to the concrete
// call-site type (Int for wrap2(7)), so the struct typedef never keeps a bare T slot.

import compile_test_helpers.{compile_and_run}

test "a generic fn returning List[Box[T]] monomorphizes Box's field type and runs" {
    let src = #"
import std.io
type Box[T] { v: T }
fn wrap2[T](x: T) -> List[Box[T]] {
    let mut xs: List[Box[T]] = []
    xs.push(Box { v: x })
    xs
}
fn main() ! IO {
    let mut es = wrap2(7)
    let mut total = 0
    for b in es { total = total + b.v }
    io.println("total={total}")
}
"#
    let r = compile_and_run(src, "_generic_fn_list_of_generic_struct_return_ice")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "total=7\n")
}
