// A generic fn returning Map[Str, Wrap[T]], where Wrap[T] is a generic enum
// and T is the fn's own typevar, must mint a real Wrap instance tid for the
// map value and for the enum ctor inside the fn body. The enum ctor inside
// the generic fn body doesn't mono-mint an instance, so the emitted C falls
// back to the bare, incomplete `blink_Wrap` head type.

import compile_test_helpers.{compile_and_run}

test.failing(
    "generic fn returning Map[Str, Wrap[T]] compiles and reads back the payload",
    reason: "the enum ctor inside the generic fn body doesn't mono-mint an instance, so codegen emits the bare incomplete `blink_Wrap` head type",
    ticket: "cee2s7",
) {
    let src = #"
import std.io

type Wrap[T] {
    Empty
    W(value: T)
}

fn mk_map[T](v: T) -> Map[Str, Wrap[T]] {
    let mut m: Map[Str, Wrap[T]] = Map()
    m.insert("k", W(v))
    m
}

fn main() ! IO {
    let m = mk_map(99)
    match m.get("k").unwrap() {
        W(x) => io.println("x={x}")
        Empty => io.println("empty")
    }
}
"#
    let r = compile_and_run(src, "_generic_fn_map_value_generic_enum_typevar")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "x=99\n")
}
