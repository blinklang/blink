// A generic function named as a value has one body per instance, so the value forwards to the
// instance that the expected type solved. Each reference is its own value and can reach its own
// instance (sections/03_types.md, "A generic function named as a value").

import test_generic_fn_effect_helper { fm6_emit, FmTele }

type GfvBox { n: Int }

fn gfv_identity[T](x: T) -> T { x }
fn gfv_first[A, B](a: A, b: B) -> A {
    let _ = b
    a
}
fn gfv_emit[T](x: T) -> T ! FmTele.Emit {
    fm6_emit("gfv", 1)
    x
}

fn gfv_apply(f: fn(Int) -> Int, n: Int) -> Int { f(n) }
fn gfv_apply_str(f: fn(Str) -> Str, s: Str) -> Str { f(s) }
fn gfv_apply2(f: fn(Int, Str) -> Int, n: Int, s: Str) -> Int { f(n, s) }
fn gfv_apply_box(f: fn(GfvBox) -> GfvBox, b: GfvBox) -> GfvBox { f(b) }
fn gfv_apply_eff(f: fn(Int) -> Int, n: Int) -> Int ! FmTele.Emit { f(n) }

// The binder here is the enclosing function's own, so the instance differs per outer instance.
fn gfv_in_generic[T](x: T) -> T {
    let f: fn(T) -> T = gfv_identity
    f(x)
}

test "the parameter type solves the binder of a named generic fn" {
    assert_eq(gfv_apply(gfv_identity, 3), 3)
}

test "the annotation solves the binder of a named generic fn" {
    let g: fn(Str) -> Str = gfv_identity
    assert_eq(g("ok"), "ok")
}

test "two references reach two instances" {
    assert_eq(gfv_apply(gfv_identity, 7), 7)
    assert_eq(gfv_apply_str(gfv_identity, "s"), "s")
}

test "every binder of a named generic fn is solved" {
    assert_eq(gfv_apply2(gfv_first, 4, "x"), 4)
}

test "a struct payload passes through the forwarding value" {
    assert_eq(gfv_apply_box(gfv_identity, GfvBox { n: 9 }).n, 9)
}

test "a named generic fn inside a generic body takes the outer instance" {
    assert_eq(gfv_in_generic(5), 5)
    assert_eq(gfv_in_generic("t"), "t")
}

test "the forwarding value of a generic fn with a row threads the handler" {
    with handler FmTele {
        fn record(_n: Str, _v: Int) { }
    } {
        assert_eq(gfv_apply_eff(gfv_emit, 8), 8)
    }
}
