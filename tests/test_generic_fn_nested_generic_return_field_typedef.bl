// A generic fn returning a nested generic instance (Box[Box[T]]) must spell
// the outer instance's field type as the inner mono instance (blink_Box_int),
// not the bare generic base (blink_Box). A nested generic struct LITERAL
// directly in a let already works; this is specific to instantiation reached
// THROUGH a generic fn's own nested return type.

import compile_test_helpers.{compile_and_run}

test "a generic fn returning Box[Box[T]] compiles and round-trips the nested value" {
    let src = #"
import std.io

type Box[T] { value: T }
fn mk_nested[T](v: T) -> Box[Box[T]] {
    Box { value: Box { value: v } }
}

fn main() ! IO {
    io.println("v={mk_nested(5).value.value}")
}
"#
    let r = compile_and_run(src, "_generic_fn_nested_generic_return_field_typedef")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "v=5\n")
}
