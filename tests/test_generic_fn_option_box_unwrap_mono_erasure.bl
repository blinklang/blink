// Inside a generic fn, Option[Box[T]].unwrap() (via a helper that returns
// Option[Box[T]]) must keep the Box mono instance name (blink_Box_0Int,
// blink_Box_0Str) throughout the Option carrier typedef and the unwrap binding,
// not the bare unmangled blink_Box, which was never declared standalone.

import compile_test_helpers.{compile_and_run}

test "Option[Box[T]] unwrapped inside a generic fn keeps the Box mono instance name" {
    let src = #"
import std.io

type Box[T] { v: T }

fn make_box_opt[T](x: T) -> Option[Box[T]] {
    Some(Box { v: x })
}

fn wrap_unwrap[T](x: T, y: T) -> T {
    let mut b = make_box_opt(x).unwrap()
    let f = fn() { b = Box { v: y } }
    f()
    b.v
}

fn main() ! IO {
    let i = wrap_unwrap(1, 2)
    io.println("i={i}")
    let s = wrap_unwrap("a", "b")
    io.println("s={s}")
}
"#
    let r = compile_and_run(src, "_generic_fn_option_box_unwrap_mono_erasure")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "i=2\ns=b\n")
}
