// A generic fn over Iterator[T] must solve T from the argument and carry it into the
// return type, as it does for List[T], so each call gets an instance of its own.

fn first_or[T](it: Iterator[T], fallback: T) -> T {
    for x in it {
        return x
    }
    fallback
}

fn pull_count[T](it: Iterator[T]) -> Int {
    it.count()
}

fn lazily[T](xs: List[T]) -> Iterator[T] {
    xs.into_iter()
}

test "T is solved from an Iterator[T] argument" {
    assert_eq(first_or([4, 5].into_iter(), 0), 4)
    assert_eq(first_or(["a", "b"].into_iter(), "z"), "a")
    assert_eq(pull_count([1, 2, 3].into_iter()), 3)
}

test "an empty iterator falls back" {
    let empty: List[Int] = []
    assert_eq(first_or(empty.into_iter(), 9), 9)
}

test "T flows into an Iterator[T] return" {
    let got = lazily(["x", "yy"]).map(fn(s: Str) -> Int { s.len() }).collect()
    assert_eq(got.get(1).unwrap(), 2)
}
