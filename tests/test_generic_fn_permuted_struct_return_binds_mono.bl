// Generic fn returning a struct whose type args are a PERMUTATION of the
// fn's own type params (Pair[B, A] over params [A, B]) must bind the caller
// to the correctly-specialized mono instance, not an arg-erased bare struct.

type Pair[X, Y] { first: X, second: Y }

fn make_swapped[A, B](a: A, b: B) -> Pair[B, A] {
    Pair { first: b, second: a }
}

test "generic fn permuted struct return keeps caller fields typed" {
    let p: Pair[Str, Int] = make_swapped(7, "hello")
    assert_eq(p.first, "hello")
    assert_eq(p.second, 7)
}
