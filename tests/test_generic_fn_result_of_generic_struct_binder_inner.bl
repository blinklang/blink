// A generic fn returning Result[Inner[T], Str] (Inner[T] a pure enclosing-binder inner,
// same shape t67cda fixed for CT_OPTION/CT_LIST) must keep the same mono-suffixed carrier
// name (blink_Result_Inner_0Int_str) at both the function's return-type declaration and
// every call/match site. The CT_RESULT branch still resolves the inner name via
// resolve_mono_slot's bare fallback, so the declared type erases to blink_Inner while the
// value side spells the correct blink_Inner_0Int.

import compile_test_helpers.{compile_and_run}

test "a generic fn returning Result[Inner[T], Str] keeps the mono-suffixed carrier name" {
    let src = #"
import std.io

type Inner[T] { v: T }

fn f[T](x: T) -> Result[Inner[T], Str] {
    Ok(Inner { v: x })
}

fn main() ! IO {
    match f(5) {
        Ok(inner) => io.println("ok {inner.v}")
        Err(e) => io.println("err {e}")
    }
}
"#
    let r = compile_and_run(src, "_generic_fn_result_of_generic_struct_binder_inner")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "ok 5\n")
}
