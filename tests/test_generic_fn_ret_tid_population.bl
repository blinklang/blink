// A generic function returning a generic struct instance registered the call
// expression's text as a scope var carrying the mono-instance carrier on the flat
// sname channel but no type id, so field access directly on the call result
// (mk(x).field) recovered the carrier through the flat sname alone.
// emit_generic_fn_call_tail now also stamps the call node's tid on that var
// (guarded to the reader's mono-name round-trip), so sv_struct_tid_first recovers
// the instance from the tid. This is a tid-population step: the emitted C is
// unchanged; the tests guard that field access on a generic-fn call result still
// resolves across the one-param, two-param, and nested shapes.
type Box[T] { value: T }
type Pair[A, B] { first: A, second: B }

fn mk_box[T](v: T) -> Box[T] {
    Box { value: v }
}

fn mk_pair[A, B](a: A, b: B) -> Pair[A, B] {
    Pair { first: a, second: b }
}

test "field access on a generic-fn call result resolves" {
    assert_eq(mk_box(7).value, 7)
}

test "both fields on a two-param generic-fn call result resolve" {
    assert_eq(mk_pair(3, 9).first, 3)
    assert_eq(mk_pair(3, 9).second, 9)
}

test "generic-fn call result bound to a let resolves field access" {
    let b = mk_box(11)
    assert_eq(b.value, 11)
}
