import compile_test_helpers.{compile_and_run}

// A generic fn returning Option[GT[Int]] (a concrete generic-struct instance wrapped in an
// Option carrier) must emit the carrier typedef with the SAME mono-instance inner as the
// value it constructs, not erase the inner to the bare generic base name.
//
// The inner erased because the instance itself was never built: `GT { s: Set() }` read its
// field type at the DECLARATION, where the field is spelled over GT's own parameter, so the
// empty Set kept an unsolved element and the literal never became GT[Int]. The field type is
// read at the instance the annotation names instead.

test "a generic fn's Option[generic-struct-instance] return carrier keeps its mono inner" {
    let src = #"
type GT[T] { s: Set[T] }
fn wrap[T](x: T) -> Option[GT[Int]] {
    let e: GT[Int] = GT { s: Set() }
    let _u = x
    Some(e)
}
fn main() ! IO {
    io.println("{wrap(7).is_some()}")
}
"#
    let r = compile_and_run(src, "_generic_fn_return_option_struct_instance_carrier")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "true\n")
}
