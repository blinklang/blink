// A monomorphized generic fn body that constructs and returns
// Option[Box[T]]/Result[Box[T],E] must emit the specialized carrier typedef
// (blink_Option_Box_Int) and use it consistently, not a stray erased
// blink_Option_Box typedef with an undeclared inner-struct member.

import compile_test_helpers.{compile_and_run}

test.failing(
    "generic fn returning Option over a generic struct instance compiles and unwraps",
    reason: "codegen emits a stray erased blink_Option_Box typedef (undeclared blink_Box member) alongside the correctly specialized blink_Option_Box_0Int return carrier, so the generated C fails to compile",
    ticket: "jhsn57",
) {
    let src = #"
type Box[T] { value: T }
fn make_box_opt[T](x: T) -> Option[Box[T]] {
    Some(Box { value: x })
}
fn main() ! IO {
    let o = make_box_opt(5)
    io.println("{o.unwrap().value}")
}
"#
    let r = compile_and_run(src, "_generic_fn_return_option_over_struct_instance_carrier")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "5\n")
}
