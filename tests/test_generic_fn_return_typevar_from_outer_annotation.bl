import compile_test_helpers

// A generic fn's return-position type var that is never mentioned in its
// body (only reachable via the call site's own annotation) must be solved
// from that outer let annotation and propagated into the mono instance,
// even when the return type is a carrier nested inside another carrier.

fn generic_fn_typevar_from_outer_src() -> Str {
    #"type Point { x: Int }
type Woe { msg: Str }
fn wrap2[T, E](v: T) -> Option[Result[T, E]] { Some(Ok(v)) }
fn main() ! IO {
    let o: Option[Result[Point, Woe]] = wrap2(Point { x: 5 })
    io.println("x={o.unwrap().unwrap().x}")
}
"#
}

test "generic fn's unconstrained return type var solves from a nested outer annotation" {
    let r = compile_test_helpers.compile_and_run(generic_fn_typevar_from_outer_src(), "_typevar_outer")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "x=5\n")
}
