// A generic fn instantiated at T=Void must still build: the let-binding and
// reassignment of a Void-typed value inside the mono'd body should compile
// clean, not fall through the Void guard because codegen never re-infers the
// bare typevar per mono-instantiation.

import compile_test_helpers.{compile_and_run}

test.failing(
    "generic fn body instantiated at T=Void builds and runs",
    reason: "codegen re-derives Void-ness per instantiation but falls through when the memoized tid still resolves to the abstract typevar T instead of Void, emitting an illegal `void val` parameter / `void m = val` binding",
    ticket: "p6b4a8",
) {
    let src = #"
fn nothing() { }

fn set_it[T](val: T) -> T {
    let mut m = val
    m = val
    m
}

fn main() ! IO {
    let v = set_it(nothing())
    io.println("done")
}
"#
    let r = compile_and_run(src, "_generic_fn_void_instantiation_reassignment")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "done\n")
}
