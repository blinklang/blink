// An unannotated closure param passed to a GENERIC higher-order function must
// get its type from a sibling non-closure argument that solves the same type
// parameter (`apply2[T](f: fn(T) -> T, v: T)`, T solved from `v: T = 5`).
// check_arg_shapes types call arguments left to right in one pass, so the
// closure is typed before T is bound from the later `v` argument. This is
// distinct from the fixed-signature HOF cases in
// tests/test_closure_param_inferred_from_context_positions.bl (no unbound
// type parameter is involved there).

import compile_test_helpers.{compile_and_run}

test.failing(
    "an unannotated closure param to a generic HOF is inferred from a sibling argument that solves T",
    reason: "check_arg_shapes types arguments left to right in one pass, so the closure argument is typed before T is bound from a later sibling argument; reports CannotInferType for the closure param and a spurious MissingDisplayImpl(Void) for the call's own return",
) {
    let src = #"
import std.io

fn apply2[T](f: fn(T) -> T, v: T) -> T { f(v) }
fn main() ! IO {
    io.println("{apply2(fn(x) { x }, 5)}")
}
"#
    let r = compile_and_run(src, "_generic_hof_closure_param_sibling_infer")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "5\n")
}
