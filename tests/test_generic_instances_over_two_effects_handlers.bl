// A generic instance's symbol names its type arguments. Two handler types of different
// effects are two C types, so an instance over each needs its own symbol, or the unit
// defines one function twice with two signatures.

effect Ping {
    effect Ask {
        fn ping() -> Int
    }
}

effect Pong {
    effect Ask {
        fn pong() -> Int
    }
}

fn keep[T](x: T) -> T {
    x
}

fn first[T](xs: List[T]) -> T {
    xs.get(0).unwrap()
}

fn make_ping() -> Handler[Ping] {
    handler Ping {
        fn ping() -> Int {
            1
        }
    }
}

fn make_pong() -> Handler[Pong] {
    handler Pong {
        fn pong() -> Int {
            2
        }
    }
}

fn use_ping() -> Int ! Ping {
    ping.ping()
}

fn use_pong() -> Int ! Pong {
    pong.pong()
}

test "one generic fn over handlers of two effects keeps each handler" {
    let a = keep(make_ping())
    let b = keep(make_pong())
    let x = with a { use_ping() }
    let y = with b { use_pong() }
    assert_eq(x, 1)
    assert_eq(y, 2)
}

test "one generic fn over lists of handlers of two effects keeps each handler" {
    let a = first([make_ping()])
    let b = first([make_pong()])
    let x = with a { use_ping() }
    let y = with b { use_pong() }
    assert_eq(x, 1)
    assert_eq(y, 2)
}
