// The annotation on the let fixes the element type of the inner empty literal only through
// the field access, so the outer literal's own type must pick that up too: codegen spells
// the outer literal, not just the let.
type Box[T] { value: T }

fn main() {
    let a: Box[List[Int]] = Box { value: Box { value: [] } }.value
    assert(a.value.len() == 0)

    let mut b: Box[Set[Int]] = Box { value: Box { value: Set() } }.value
    b.value.insert(3)
    assert(b.value.len() == 1)

    let mut c: Box[Map[Str, Int]] = Box { value: Box { value: Map() } }.value
    c.value.insert("k", 1)
    assert(c.value.get("k").unwrap() == 1)

    let d: List[Int] = Box { value: [] }.value
    assert(d.len() == 0)
    io.println("ok")
}
