// A payload-less variant of a generic enum carries no argument to infer its binders from,
// so the expected type is their only source, as it is for `None`. A reference nothing pins
// is under-determined and reports CannotInferType at the binding.

import compile_test_helpers

type NTree[T] { Leaf, Node(T) }
type NPair[A, B] { Nothing, Both(A, B) }
type NList[T] { Nil, Cons { head: T, tail: NList[T] } }

fn ntree_value(t: NTree[Int]) -> Int {
    match t {
        NTree.Node(n) => n
        NTree.Leaf => -1
    }
}

fn npair_sum(p: NPair[Int, Int]) -> Int {
    match p {
        NPair.Both(a, b) => a + b
        NPair.Nothing => 0
    }
}

fn nlist_len(l: NList[Str]) -> Int {
    match l {
        NList.Cons { head: _, tail } => 1 + nlist_len(tail)
        NList.Nil => 0
    }
}

fn ntree_empty() -> NTree[Str] {
    NTree.Leaf
}

test "a qualified nullary variant takes its binder from a let annotation" {
    let t: NTree[Int] = NTree.Leaf
    assert_eq(ntree_value(t), -1)
}

test "a qualified nullary variant takes its binder from the parameter it is passed to" {
    assert_eq(ntree_value(NTree.Leaf), -1)
    assert_eq(ntree_value(NTree.Node(5)), 5)
}

test "a bare nullary variant takes its binder from a let annotation" {
    let t: NTree[Int] = Leaf
    assert_eq(ntree_value(t), -1)
}

test "a nullary variant takes every binder of a two-parameter enum" {
    let p: NPair[Int, Int] = NPair.Nothing
    assert_eq(npair_sum(p), 0)
    assert_eq(npair_sum(NPair.Both(2, 3)), 5)
}

test "a nullary variant takes its binder from the return type" {
    match ntree_empty() {
        NTree.Node(_) => assert(false)
        NTree.Leaf => assert(true)
    }
}

test "a nullary variant of a self-recursive enum ends a struct-variant chain" {
    let n: NList[Str] = NList.Nil
    let l: NList[Str] = NList.Cons { head: "a", tail: NList.Cons { head: "b", tail: n } }
    assert_eq(nlist_len(l), 2)
}

test "a nullary variant takes its binder from a later assignment" {
    let mut t = NTree.Leaf
    assert_eq(ntree_value(t), -1)
    t = NTree.Node(9)
    assert_eq(ntree_value(t), 9)
}

fn src_unpinned() -> Str {
    #"type UTree[T] { Leaf, Node(T) }

fn main() {
    let t = UTree.Leaf
}
"#
}

test "a nullary variant nothing pins is under-determined" {
    compile_test_helpers.expect_compile_error(src_unpinned(), "nullary_variant_unpinned", "E0301")
}
