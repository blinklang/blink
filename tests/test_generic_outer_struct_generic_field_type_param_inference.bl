// A generic outer struct whose field type is a generic-struct instance over the
// outer's own type parameter must infer that parameter from the field literal
// instead of reaching codegen unsolved.

import compile_test_helpers.{compile_and_run}

test "Outer[T] with a nested Inner[T] field infers T from the field literal" {
    let src = #"
import std.io

type Inner[T] { v: T }
type Outer[T] { i: Inner[T] }

fn main() {
    let o = Outer { i: Inner { v: 3 } }
    io.println("{o.i.v}")
}
"#
    let r = compile_and_run(src, "_generic_outer_struct_generic_field_type_param_inference")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "3\n")
}
