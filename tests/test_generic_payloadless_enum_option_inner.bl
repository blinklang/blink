import compile_test_helpers

// A generic payloadless enum instance stored as an Option's inner type is
// stored by ordinal (scalar), but the mono-name Option reader spells it as
// struct-carrying and reads a .value/.tag pair, mismatching the storage.

fn payloadless_enum_option_inner_src() -> Str {
    #"type Phantom[T] { A B }
fn main() ! IO {
    let o: Option[Phantom[Int]] = Some(Phantom.A)
    match o.unwrap() {
        Phantom.A => { io.println("a") }
        Phantom.B => { io.println("b") }
    }
}
"#
}

test.failing(
    "generic payloadless enum as Option inner compiles and matches its variant",
    reason: "the mono branch of the Option inner-struct reader spells the payloadless enum as struct-carrying (blink_Option_Phantom with a .value/.tag pair) instead of the scalar ordinal storage the enum actually uses, so cc rejects undeclared blink_Phantom/blink_Phantom_A/blink_Phantom_B",
    ticket: "054bs2",
) {
    let r = compile_test_helpers.compile_and_run(payloadless_enum_option_inner_src(), "_phantom_option")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "a\n")
}
