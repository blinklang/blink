type SomeStruct {
    x: Int
}

trait HasX {
    fn get_x(self) -> Int
}

impl HasX for SomeStruct {
    fn get_x(self) -> Int { self.x }
}

fn handle_result[T: HasX](r: Result[T, Str]) -> Int {
    match r {
        Ok(v) => { return v.get_x() }
        Err(_m) => { return 0 }
    }
}

fn handle_option[T: HasX](o: Option[T]) -> Int {
    match o {
        Some(v) => { return v.get_x() }
        None => { return 0 }
    }
}

fn handle_scalar[T](r: Result[T, Str]) -> Option[T] {
    match r {
        Ok(v) => { return Some(v) }
        Err(_m) => { return None }
    }
}

test "generic Result[T,E] param infers T from Ok(struct) arg" {
    let n = handle_result(Ok(SomeStruct { x: 10 }))
    assert_eq(n, 10)
}

test "generic Option[T] param infers T from Some(struct) arg" {
    let n = handle_option(Some(SomeStruct { x: 22 }))
    assert_eq(n, 22)
}

test "generic Result[T,E] param infers scalar T from Ok(int) arg" {
    let n = handle_scalar(Ok(7))
    assert_eq(n.unwrap(), 7)
}
