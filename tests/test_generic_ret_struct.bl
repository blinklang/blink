// br 8wyq1k (codegen-structured-tids epic, kvn6w8): a generic fn returning a
// bare type-param `-> T` bound to a STRUCT INSTANCE must give the caller the
// concrete struct type, not `void`.
//
// Root cause is in typecheck, not codegen: the generic fn param `b: Box[T]`
// interns in the fnsig as a BARE Box tid (params_count 0) because resolve_type_ann
// refuses to intern an all-typevar instance. So unify_typevar_binds' TK_STRUCT
// arm sees param-count 0 vs arg-count 1 (the arg `outer: Box[Box[Int]]` IS a
// proper instance) → arity mismatch → binds nothing → instantiate_return_type
// leaves `T` unsubstituted → the call node memoizes a TK_TYPEVAR return tid →
// codegen types the result `void` and `got.value` fails to compile.
//
// Fix: register_fn_sig builds a STRUCTURAL Box[T] param instance tid (typevar
// slots preserved) so the existing unify_typevar_binds TK_STRUCT arm binds
// T → Box[Int]. types_compatible is unaffected (a typevar slot matches anything).

type Box[T] {
    value: T
}

fn unbox[T](b: Box[T]) -> T {
    b.value
}

test "generic fn returning T bound to a struct instance keeps the struct type" {
    let inner: Box[Int] = Box { value: 42 }
    let outer: Box[Box[Int]] = Box { value: inner }
    let got = unbox(outer)
    assert_eq(got.value, 42)
}

test "unboxed struct instance round-trips through a field read" {
    let outer: Box[Box[Str]] = Box { value: Box { value: "hi" } }
    let got = unbox(outer)
    assert_eq(got.value, "hi")
}

// GREEN control: a generic fn returning T bound to a SCALAR stays undisturbed.
test "generic fn returning scalar T is undisturbed" {
    let b: Box[Int] = Box { value: 3 }
    assert_eq(unbox(b), 3)
}
