// A generic call whose return type is pinned by its context must bind the open
// metavariables of a constructor nested in a struct-literal argument. Each row fails
// when the pin reaches a different metavariable than the one the literal keeps.

import compile_test_helpers
import std.io

fn prelude() -> Str {
    let mut s = "type Box[T] \{ value: T }\n"
    s = s.concat("fn unbox[T](b: Box[T]) -> T \{ b.value }\n")
    s = s.concat("fn id[T](x: T) -> T \{ x }\n")
    s
}

fn run_ok(body: Str, fixture: Str, label: Str) {
    let src = prelude().concat(body)
    let r = compile_test_helpers.compile_and_run(src, fixture)
    if r.exit_code != 0 { io.println("FAIL: {label}: {r.err_out}") }
    assert(r.exit_code == 0)
}

test "a let annotation binds Map() inside a struct-literal argument" {
    let mut s = "fn main() \{\n"
    s = s.concat("    let mut m: Map[Int, Str] = unbox(Box \{ value: Map() })\n")
    s = s.concat("    m.insert(256, \"a\")\n")
    s = s.concat("    assert(m.get(256).unwrap() == \"a\")\n")
    s = s.concat("}\n")
    run_ok(s, "gen_ret_ctor_let_map", "let Map")
}

// A Float value read back through Str kops would read a pointer, so this row stays red
// if the slot compiles with an erased key.
test "a let annotation binds a Map[Str, Float] inside a struct-literal argument" {
    let mut s = "fn main() \{\n"
    s = s.concat("    let mut m: Map[Str, Float] = unbox(Box \{ value: Map() })\n")
    s = s.concat("    m.insert(\"pi\", 3.5)\n")
    s = s.concat("    assert(m.get(\"pi\").unwrap() == 3.5)\n")
    s = s.concat("}\n")
    run_ok(s, "gen_ret_ctor_let_float", "let Map[Str, Float]")
}

test "an assignment target binds Map() inside a struct-literal argument" {
    let mut s = "fn main() \{\n"
    s = s.concat("    let mut m: Map[Int, Str] = Map()\n")
    s = s.concat("    m = unbox(Box \{ value: Map() })\n")
    s = s.concat("    m.insert(256, \"a\")\n")
    s = s.concat("    assert(m.get(256).unwrap() == \"a\")\n")
    s = s.concat("}\n")
    run_ok(s, "gen_ret_ctor_assign_map", "assign Map")
}

test "a declared return type binds Map() inside a struct-literal argument" {
    let mut s = "fn make() -> Map[Int, Str] \{ unbox(Box \{ value: Map() }) }\n"
    s = s.concat("fn main() \{\n")
    s = s.concat("    let mut m = make()\n")
    s = s.concat("    m.insert(256, \"a\")\n")
    s = s.concat("    assert(m.get(256).unwrap() == \"a\")\n")
    s = s.concat("}\n")
    run_ok(s, "gen_ret_ctor_return_map", "return Map")
}

test "a let annotation binds Set() inside a struct-literal argument" {
    let mut s = "fn main() \{\n"
    s = s.concat("    let mut t: Set[Int] = unbox(Box \{ value: Set() })\n")
    s = s.concat("    t.insert(7)\n")
    s = s.concat("    assert(t.contains(7))\n")
    s = s.concat("}\n")
    run_ok(s, "gen_ret_ctor_let_set", "let Set")
}

test "a let annotation binds an empty list inside a struct-literal argument" {
    let mut s = "fn main() \{\n"
    s = s.concat("    let mut l: List[Int] = unbox(Box \{ value: [] })\n")
    s = s.concat("    l.push(3)\n")
    s = s.concat("    assert(l.get(0).unwrap() == 3)\n")
    s = s.concat("}\n")
    run_ok(s, "gen_ret_ctor_let_list", "let empty list")
}

test "a let annotation reaches Map() through a nested generic call" {
    let mut s = "fn main() \{\n"
    s = s.concat("    let mut m: Map[Int, Str] = unbox(Box \{ value: id(Map()) })\n")
    s = s.concat("    m.insert(256, \"a\")\n")
    s = s.concat("    assert(m.get(256).unwrap() == \"a\")\n")
    s = s.concat("}\n")
    run_ok(s, "gen_ret_ctor_nested_id", "nested id")
}
