// A generic struct instance used as a List element type must keep its
// mangled per-instantiation spelling through codegen.

type QBox[T] { v: T }

test "generic struct instance as list element type" {
    let l: List[QBox[Int]] = [QBox { v: 1 }, QBox { v: 2 }]
    assert_eq(l.get(1).unwrap().v, 2)
}
