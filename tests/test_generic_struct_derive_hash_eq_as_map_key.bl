// A generic struct instance with @derive(Hash, Eq) is itself the Map key. Its key table
// is named from the instance's typedef, so each instance brings its own. This differs
// from the tests that put an illegal key (Float) INSIDE a struct's type argument.

import compile_test_helpers.{compile_and_run}

test "a generic struct instance with @derive(Hash, Eq) can be used directly as a Map key" {
    let src = #"
import std.io

@derive(Hash, Eq)
type Box[T] { v: T }

fn main() {
    let mut m: Map[Box[Int], Int] = Map()
    m.insert(Box { v: 1 }, 2)
    io.println("{m.len()}")
}
"#
    let r = compile_and_run(src, "_generic_struct_derive_hash_eq_as_map_key")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "1\n")
}
