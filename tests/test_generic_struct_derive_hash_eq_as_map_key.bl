// A generic struct instance with @derive(Hash, Eq) used directly as a Map
// key type still has no kops vtable entry selected for it: validate_map_key
// / validate_set_elem (src/typecheck.bl) are declaration-level checks and
// never see the derive, so the type is accepted, but codegen's
// kops_table_name (src/codegen_types.bl) has no case for a generic struct
// key and falls through to the sentinel marker name
// BLINK_COMPILER_BUG_kops_unsupported_K_<tag>, an undeclared C identifier.
// Distinct from the struct-type-argument hashability tests, which put an
// illegal key (Float) INSIDE a struct's type argument; here the struct
// ITSELF, with a legitimate @derive(Hash, Eq), is the key.

import compile_test_helpers.{compile_and_run}

test.failing(
    "a generic struct instance with @derive(Hash, Eq) can be used directly as a Map key",
    reason: "kops_table_name has no vtable case for a generic struct key, so it falls through to the BLINK_COMPILER_BUG_kops_unsupported_K_<tag> sentinel, an undeclared identifier in the emitted C, even though @derive(Hash, Eq) is present",
    ticket: "4xf1rw",
) {
    let src = #"
import std.io

@derive(Hash, Eq)
type Box[T] { v: T }

fn main() {
    let mut m: Map[Box[Int], Int] = Map()
    m.insert(Box { v: 1 }, 2)
    io.println("{m.len()}")
}
"#
    let r = compile_and_run(src, "_generic_struct_derive_hash_eq_as_map_key")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "1\n")
}
