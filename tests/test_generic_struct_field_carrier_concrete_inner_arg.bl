// A generic struct field whose Result carrier wraps a generic-struct instance with a
// CONCRETE inner type argument (Result[Inner[Int], U], not a pure enclosing binder like
// Result[Inner[T], U]) must resolve to the SAME mono-suffixed carrier name on both the
// field declaration and every value/match site. carrier_inner_instance_stem only binds
// inner type-args that are enclosing binders (via tparam_tid_via_mono), so a literal
// element like `Int` bails the whole helper and the def side falls back to the erased
// bare name, while the value side still resolves it correctly and diverges.

import compile_test_helpers.{compile_and_run}

test.failing(
    "a Result carrier field wrapping a generic-struct instance with a concrete inner arg stays consistently mono-named",
    reason: "carrier_inner_instance_stem resolves inner type-args only via tparam_tid_via_mono, which returns -1 for a concrete literal like Int, so the struct field declaration erases to blink_Result_Inner_str (Inner un-mono'd) while every value and match site correctly resolves blink_Result_Inner_0Int_str, and the generated C fails to compile on the mismatch",
    ticket: "d3y80v",
) {
    let src = #"
import std.io

type Inner[T] { v: T }
type Box[U] { r: Result[Inner[Int], U] }

fn main() ! IO {
    let ok_box: Box[Str] = Box { r: Ok(Inner { v: 5 }) }
    let err_box: Box[Str] = Box { r: Err("bad") }
    match ok_box.r {
        Ok(inner) => io.println("ok {inner.v}")
        Err(e) => io.println("err {e}")
    }
    match err_box.r {
        Ok(inner) => io.println("ok {inner.v}")
        Err(e) => io.println("err {e}")
    }
}
"#
    let r = compile_and_run(src, "_generic_struct_field_carrier_concrete_inner_arg")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "ok 5\nerr bad\n")
}
