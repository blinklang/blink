// b49srt: a generic struct's field defaults must apply, exactly like its
// non-generic twin. emit_struct_typedef early-returned for generics before
// registering StructFieldDefault rows, so the default loop in emit_struct_lit
// found nothing and the field was left zero-initialized.

type G[T] { v: T, n: Int = 42 }
type GNonGen { v: Int, n: Int = 42 }
type GC[T] { v: T, m: Map[Int, Int] = Map() }

test "generic struct scalar default applies" {
    let g: G[Int] = G { v: 1 }
    assert_eq(g.n, 42)
}

test "non-generic twin still applies its default" {
    let ng: GNonGen = GNonGen { v: 1 }
    assert_eq(ng.n, 42)
}

test "generic struct container default is initialized" {
    let g: GC[Int] = GC { v: 1 }
    assert_eq(g.m.len(), 0)
}

test "explicitly provided field overrides the default" {
    let g: G[Int] = G { v: 1, n: 7 }
    assert_eq(g.n, 7)
}
