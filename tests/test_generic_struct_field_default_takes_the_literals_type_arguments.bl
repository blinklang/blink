// A field default of a generic struct is written once, over the struct's own type
// parameters, and a literal that leaves the field out builds it at the literal's type
// arguments (sections/02_syntax.md §2.14).

const START = 5

type Box[T] {
    v: Option[T] = None
}

type Bag[T] {
    xs: List[T] = []
}

type Tab[K, V] {
    m: Map[K, V] = Map()
}

type Outer[T] {
    inner: Box[Box[T]] = Box {}
}

type Cell[T] {
    n: Int = START
    v: Option[T] = None
}

fn mk[T]() -> Box[T] {
    Box {}
}

test "an Option default over T is None at the literal's type" {
    let a: Box[Int] = Box {}
    let b: Box[Str] = Box {}
    assert(a.v.is_none())
    assert(b.v.is_none())
}

test "a List default over T is empty at each literal's type" {
    let a: Bag[Str] = Bag {}
    let b: Bag[Int] = Bag {}
    assert_eq(a.xs.len() + b.xs.len(), 0)
}

test "a Map default over K and V is empty at the literal's types" {
    let t: Tab[Str, Int] = Tab {}
    assert_eq(t.m.len(), 0)
    assert(t.m.get("a").is_none())
}

test "a default that is itself a generic literal nests the type arguments" {
    let o: Outer[Int] = Outer {}
    assert(o.inner.v.is_none())
}

test "a const default beside a T field keeps its value" {
    let c: Cell[Str] = Cell {}
    assert_eq(c.n, 5)
    assert(c.v.is_none())
}

test "a literal inside a generic fn takes the type arguments of each instance" {
    let a: Box[Int] = mk()
    let b: Box[Str] = mk()
    assert(a.v.is_none())
    assert(b.v.is_none())
}
