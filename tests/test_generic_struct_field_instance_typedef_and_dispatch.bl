// A struct field declared as a generic-struct instance (RGT[Int]) must lower to that
// instance's own mono typedef (blink_RGT_Int), not to the bare generic base name, and a
// method chain through such a field (h.g.s.insert(...)) must dispatch on the mono instance.

type RGT[T] { s: Set[T] }
type H { g: RGT[Int] }

test "a struct field typed as a generic-struct instance builds and dispatches through a two-level chain" {
    let h = H { g: RGT { s: Set() } }
    h.g.s.insert(256)
    assert(h.g.s.contains(256))
    assert_eq(h.g.s.len(), 1)
}

test "reading a generic-struct-instance field into a local still resolves its methods" {
    let h = H { g: RGT { s: Set() } }
    let inner = h.g
    inner.s.insert(256)
    assert(inner.s.contains(256))
    assert_eq(inner.s.len(), 1)
}
