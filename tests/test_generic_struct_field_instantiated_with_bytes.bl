// A generic struct's type parameter instantiated with Bytes reaches monomorphization
// unsolved, even though the identical shape over Str, Int, List[Int], Option[Int],
// Set[Int], and Map[Str, Int] all compile and run. The gap is specific to the Bytes
// builtin in the struct-instance mono registration path (register_mono_field_types).

import compile_test_helpers.{compile_and_run}

test.failing(
    "a generic struct field instantiated with Bytes monomorphizes",
    reason: "register_mono_field_types resolves the struct's T slot to a void/_Void field for a Bytes-instantiated type argument instead of the real Bytes ctype, so T reaches monomorphization unsolved and trips the UnsolvedTypeVarAtCodegen internal-compiler-error backstop, with a follow-on UnresolvedMethod on the field's .len() call",
    ticket: "he67xg",
) {
    let src = #"
import std.io

type EBox[T] { v: T }

fn main() {
    let b = EBox { v: Bytes.from_str("ab") }
    io.println("{b.v.len()}")
}
"#
    let r = compile_and_run(src, "_generic_struct_field_instantiated_with_bytes")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "2\n")
}
