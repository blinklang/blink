// A mono generic struct field typed Option[Option[T]] must lower to the same
// blink_Option_Option_<T> carrier name every construction/read site expects.
// ensure_carrier_from_tag mis-names the inner Option_int tag as "option" (routed
// through compound_tag_ct) instead of the canonical "Option_int", producing a
// blink_Option_Option_void typedef that no other site spells.

import compile_test_helpers.{compile_and_run}

test "generic struct field Option[Option[T]] round-trips a Some(Some(v))" {
    let src = #"
type Box[T] { v: Option[Option[T]] }

fn main() ! IO {
    let b: Box[Int] = Box { v: Some(Some(5)) }
    match b.v {
        Some(inner) => match inner {
            Some(v) => io.println("{v}")
            None => io.println("none-inner")
        }
        None => io.println("none-outer")
    }
}
"#
    let r = compile_and_run(src, "_generic_struct_field_nested_option_carrier_name")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "5\n")
}
