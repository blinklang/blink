// A Result[Int, Errno] used as a generic-struct field lowers to the SAME canonical
// carrier typedef name used everywhere else (blink_Result_int_std_errno_Errno), and the
// Err arm stays the transparent-newtype int64_t rather than erasing to void.

import compile_test_helpers.{compile_and_run}

test "Result[Int, Errno] as a generic-struct field keeps one canonical carrier name and a live Err arm" {
    let src = #"
import std.io
import std.errno.{Errno}

type Carrier[T] { v: T }

fn mk_ok() -> Result[Int, Errno] { return Ok(9) }
fn mk_err() -> Result[Int, Errno] { return Err(Errno(2)) }

fn wrap(r: Result[Int, Errno]) -> Carrier[Result[Int, Errno]] { return Carrier { v: r } }

fn main() ! IO {
    let ok_box = wrap(mk_ok())
    let err_box = wrap(mk_err())
    match ok_box.v {
        Ok(v) => io.println("ok {v}")
        Err(e) => io.println("err")
    }
    match err_box.v {
        Ok(v) => io.println("ok {v}")
        Err(Errno(rc)) => io.println("err {rc}")
    }
}
"#
    let r = compile_and_run(src, "_generic_struct_field_result_errno_carrier_name")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "ok 9\nerr 2\n")
}
