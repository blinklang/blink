// A for-in loop over a Set that is a field of a generic struct instantiated
// with a tuple element type compiles and runs, same as a plain Set[(Int,Int)]
// local, an aliased Set[(Int,Int)], and a generic-struct-field Set[Int]/Set[Point].

import compile_test_helpers.{compile_and_run}

test "a for-in over a generic-struct field Set of a tuple element type compiles and runs" {
    let src = #"
import std.io

type Holder[T] { s: Set[T] }

fn main() ! IO {
    let mut h: Holder[(Int, Int)] = Holder { s: Set() }
    h.s.insert((1, 2))
    let mut total = 0
    for elem in h.s {
        total = total + elem.0
    }
    io.println("{total}")
}
"#
    let r = compile_and_run(src, "_generic_struct_field_set_tuple_element_forin_ice")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "1\n")
}
