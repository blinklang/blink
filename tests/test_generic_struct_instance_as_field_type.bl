// A field whose declared type is a generic-struct instance, on a
// non-generic outer struct, must keep its mangled spelling in codegen.

type Inner[T] { v: T }
type Outer { i: Inner[Int] }

test "generic struct instance as field type on non-generic outer" {
    let o = Outer { i: Inner { v: 3 } }
    assert_eq(o.i.v, 3)
}
