import compile_test_helpers.{compile_and_run}

// A generic-struct INSTANCE (with @derive(Hash, Eq)) used as a Set element type must get a
// real per-instance kops table, not the fail-closed BLINK_COMPILER_BUG_kops sentinel.

test "a Set of a derive(Hash,Eq) generic-struct instance builds and hashes correctly" {
    let src = #"
@derive(Hash, Eq)
type QB[T] { v: T }
fn main() ! IO {
    let mut s: Set[QB[Int]] = Set()
    s.insert(QB { v: 1 })
    io.println("{s.len()} {s.contains(QB { v: 1 })}")
}
"#
    let r = compile_and_run(src, "_generic_struct_instance_keyed_set_kops")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "1 true\n")
}
