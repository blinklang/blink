// A generic struct literal's result temp was registered through set_var_struct
// with the mono-instance carrier (Box_Int) on the flat sname channel but no type
// id, so every field read on it recovered the carrier through the flat sname
// alone. emit_struct_lit now also stamps the literal's tid on the temp (guarded
// to the reader's mono-name round-trip), so sv_struct_tid_first recovers the
// generic instance from the tid. This is a tid-population step: the emitted C is
// unchanged; the tests guard that a generic struct literal temp still resolves
// its field access across the plain, two-param, nested, and in-list shapes.
type Box[T] { value: T }
type Pair[A, B] { first: A, second: B }

test "generic struct literal temp resolves field access" {
    let b = Box { value: 7 }
    assert_eq(b.value, 7)
}

test "two-param generic struct literal temp resolves both fields" {
    let p = Pair { first: 3, second: 9 }
    assert_eq(p.first, 3)
    assert_eq(p.second, 9)
}

test "nested generic struct literal temp resolves through both levels" {
    let bb = Box { value: Box { value: 5 } }
    let inner = bb.value
    assert_eq(inner.value, 5)
}

test "generic struct literal element in a list resolves field access" {
    let xs: List[Box[Int]] = [Box { value: 4 }, Box { value: 6 }]
    let a = xs.get(0).unwrap()
    let c = xs.get(1).unwrap()
    assert_eq(a.value, 4)
    assert_eq(c.value, 6)
}
