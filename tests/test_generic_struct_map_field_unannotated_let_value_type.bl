// A Map-typed field of a generic struct, read back through an UNANNOTATED
// let (the struct instance comes from a fn call return, not a let
// annotation), must keep the map's declared VALUE type in codegen. Uses a
// non-interned string so a wrong int64_t/pointer reinterpretation would
// produce a genuine mismatch rather than an accidental pointer-equal pass.

type GKV[K, V] { m: Map[K, V] }

fn mk() -> GKV[Int, Str] {
    let mut m: Map[Int, Str] = Map()
    m.insert(256, "he".concat("llo"))
    GKV { m: m }
}

test "map field of a generic struct keeps its value type via unannotated let" {
    let g = mk()
    let v = g.m.get(256).unwrap()
    assert_eq(v, "hello")
}
