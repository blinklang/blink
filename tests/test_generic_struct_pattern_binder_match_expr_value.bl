// A struct-pattern binder over a generic struct's own type-parameter field must
// bind the substituted concrete type, even when the match is used as a value
// expression bound to a `let`.

import compile_test_helpers.{compile_and_run}

test "let-bound match expression over a generic struct pattern binds the field's concrete type" {
    let src = #"
import std.io

type Box[T] { v: T }

fn main() ! IO {
    let b = Box { v: "hello" }
    let got = match b { Box { v } => { v } }
    io.println(got)
}
"#
    let r = compile_and_run(src, "_generic_struct_pattern_binder_match_expr_value")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "hello\n")
}
