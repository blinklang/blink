// A struct-pattern binder over a generic struct field whose type is the struct's own type
// parameter must bind the field's actual value, not a garbage/void read.

import compile_test_helpers.{compile_and_run}

type Box[T] { v: T, tag: Str }

test.failing(
    "shorthand struct-pattern binder over a type-parameter field binds the real value",
    reason: "generic-struct type-parameter substitution gap in typecheck/mono makes the binder read the field as an untyped/Int slot, printing a garbage integer instead of the Str value",
    ticket: "789e83",
) {
    let b = Box { v: "hello", tag: "t1" }
    match b {
        Box { v, tag } => {
            let s = "{v}/{tag}"
            assert_eq(s, "hello/t1")
        }
    }
}

test.failing(
    "named struct-pattern binder over a type-parameter field binds the real value",
    reason: "the same substitution gap makes the named binder emit a void-typed C local for the field, so the C compiler rejects the program",
    ticket: "789e83",
) {
    let src = #"
import std.io

type Box[T] { v: T, tag: Str }

fn main() ! IO {
    let b = Box { v: "hello", tag: "t1" }
    match b {
        Box { v: inner, tag: tg } => io.println("{inner}/{tg}")
    }
}
"#
    let r = compile_and_run(src, "_generic_struct_pattern_binder_named")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "hello/t1\n")
}
