// A generic struct whose type argument is a tuple containing an instance of the SAME
// struct must not collide the inner and outer literals onto one mono name: each nesting
// level gets its own typedef, in dependency order, and field/tuple access through it works.

type Box[T] { v: T }

test "a generic struct nested inside a tuple type arg of the same struct round-trips" {
    let b: Box[(Box[Int], Int)] = Box { v: (Box { v: 7 }, 5) }
    assert_eq(b.v.0.v, 7)
    assert_eq(b.v.1, 5)
}
