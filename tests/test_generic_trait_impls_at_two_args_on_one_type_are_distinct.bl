// One type may implement one generic trait at several arguments (sections/03c_protocols.md:
// a generic trait takes its full instance). Each impl is its own method, and a call through
// a bound runs the impl of the instance the bound names.

trait Conv[T] {
    fn conv(self) -> T
}

type Foo { n: Int }

impl Conv[Int] for Foo {
    fn conv(self) -> Int { self.n + 1 }
}

impl Conv[Str] for Foo {
    fn conv(self) -> Str { "foo {self.n}" }
}

impl Conv[Bool] for Foo {
    fn conv(self) -> Bool { self.n > 2 }
}

impl Conv[List[Int]] for Foo {
    fn conv(self) -> List[Int] { [self.n, self.n] }
}

impl Conv[List[Str]] for Foo {
    fn conv(self) -> List[Str] { ["a{self.n}"] }
}

// No call reaches these two, so only the impls themselves must build.
type Idle { n: Int }

impl Conv[Int] for Idle {
    fn conv(self) -> Int { self.n }
}

impl Conv[Str] for Idle {
    fn conv(self) -> Str { "idle {self.n}" }
}

impl Conv[Int] for Str {
    fn conv(self) -> Int { self.len() }
}

impl Conv[Bool] for Str {
    fn conv(self) -> Bool { self.len() > 2 }
}

type Pick { A, B }

impl Conv[Int] for Pick {
    fn conv(self) -> Int {
        match self {
            Pick.A => 7
            Pick.B => 8
        }
    }
}

impl Conv[Str] for Pick {
    fn conv(self) -> Str {
        match self {
            Pick.A => "a"
            Pick.B => "b"
        }
    }
}

trait Pair[A, B] {
    fn pick(self, a: A) -> B
}

impl Pair[Int, Str] for Foo {
    fn pick(self, a: Int) -> Str { "is {a + self.n}" }
}

impl Pair[Str, Int] for Foo {
    fn pick(self, a: Str) -> Int { a.len() + self.n }
}

type Wrap[T] { v: T, tag: Int }

impl[T] Pair[Int, Str] for Wrap[T] {
    fn pick(self, a: Int) -> Str { "w {a + self.tag}" }
}

impl[T] Pair[Str, Int] for Wrap[T] {
    fn pick(self, a: Str) -> Int { a.len() * 100 + self.tag }
}

impl[T] Conv[T] for Wrap[T] {
    fn conv(self) -> T { self.v }
}

// The methods name no binder, so each impl has one body for every element, and the trait
// argument keeps its binder in that body's name.
trait Mark[T] {
    fn mark(self) -> Int
}

impl[T] Mark[Option[T]] for List[T] {
    fn mark(self) -> Int { self.len() }
}

impl[T] Mark[List[T]] for Set[T] {
    fn mark(self) -> Int { self.len() * 10 }
}

fn via_int[X: Conv[Int]](x: X) -> Int { x.conv() }
fn via_str[X: Conv[Str]](x: X) -> Str { x.conv() }
fn via_str_qualified[X: Conv[Str]](x: X) -> Str { Conv.conv(x) }
fn via[Y, X: Conv[Y]](x: X) -> Y { x.conv() }
fn via_outer[Y, X: Conv[Y]](x: X) -> Y { via[Y, X](x) }
fn pick_str[X: Pair[Int, Str]](x: X) -> Str { x.pick(1) }
fn pick_int[X: Pair[Str, Int]](x: X) -> Int { x.pick("abc") }

test "a bound names the instance whose impl runs" {
    let f = Foo { n: 3 }
    assert_eq(via_int(f), 4)
    assert_eq(via_str(f), "foo 3")
    assert_eq(via_str_qualified(f), "foo 3")
}

test "a bound over a type parameter takes the instance the call settles" {
    let f = Foo { n: 3 }
    assert_eq(via[Int, Foo](f), 4)
    assert_eq(via[Str, Foo](f), "foo 3")
    assert_eq(via[Bool, Foo](f), true)
    assert_eq(via[List[Int], Foo](f).len(), 2)
    assert_eq(via[List[Str], Foo](f).get(0) ?? "", "a3")
    assert_eq(via_outer[Str, Foo](f), "foo 3")
    assert_eq(via_outer[Int, Foo](f), 4)
}

test "a builtin and an enum receiver take each instance" {
    assert_eq(via[Int, Str]("abcd"), 4)
    assert_eq(via[Bool, Str]("a"), false)
    assert_eq(via[Int, Pick](Pick.A), 7)
    assert_eq(via[Str, Pick](Pick.B), "b")
}

test "a trait of two parameters takes each instance" {
    let f = Foo { n: 10 }
    assert_eq(pick_str(f), "is 11")
    assert_eq(pick_int(f), 13)
}

test "a generic impl takes each instance" {
    let w = Wrap { v: 1, tag: 0 }
    assert_eq(pick_str(w), "w 1")
    assert_eq(pick_int(w), 300)
    assert_eq(via[Str, Wrap[Str]](Wrap { v: "wv", tag: 0 }), "wv")
    assert_eq(via[Int, Wrap[Int]](Wrap { v: 9, tag: 0 }), 9)
}

test "an impl with one body for every element takes each instance" {
    assert_eq([1, 2].mark(), 2)
    assert_eq(["a", "b", "c"].mark(), 3)
    let mut s: Set[Int] = Set()
    s.insert(4)
    assert_eq(s.mark(), 10)
}
