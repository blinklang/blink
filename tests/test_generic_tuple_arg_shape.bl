import compile_test_helpers

test "List[Int] passed to List[(Str, T)] param emits E0300" {
    let src = "fn for_each[T](pairs: List[(Str, T)]) \{\n \}\nfn main() \{ for_each([1, 2]) \}\n"
    compile_test_helpers.expect_compile_error(src, "j9v92x_list_shape", "E0300")
}

test "List[(Int, Int)] passed to List[(Str, T)] param emits E0300" {
    let src = "fn for_each[T](pairs: List[(Str, T)]) \{\n \}\nfn main() \{ for_each([(1, 2)]) \}\n"
    compile_test_helpers.expect_compile_error(src, "j9v92x_tuple_shape", "E0300")
}

test "List[(Str, Int)] passed to List[(Str, T)] param compiles" {
    let src = "fn for_each[T](pairs: List[(Str, T)]) \{\n \}\nfn main() \{ for_each([(\"a\", 1), (\"b\", 2)]) \}\n"
    compile_test_helpers.expect_no_error(src, "j9v92x_positive", "E0300")
}

test "negative int literal passed to sized-int param compiles" {
    let src = "fn takes_i32(x: I32) -> I32 \{ x }\nfn main() \{ let _ = takes_i32(-5) }\n"
    compile_test_helpers.expect_no_error(src, "j9v92x_neg_lit", "E0300")
}

test "int literal passed to sized-int param compiles" {
    let src = "fn takes_u8(x: U8) -> U8 \{ x }\nfn main() \{ let _ = takes_u8(200) }\n"
    compile_test_helpers.expect_no_error(src, "j9v92x_pos_lit", "E0300")
}
