// Bug 295z9x: a generic fn returning (M, Option[UserEnum]) mangled the tuple
// type name three different ways during C lowering, all dropping Option's type
// parameter: the caller built blink_Tuple_Model_Option (Site A), the mono
// signature emitted `void` (Site B), and the body tuple literal built
// blink_Tuple2_Model_Cmd with a bare-Cmd field (Site C). `blink check` passed;
// the C compiler rejected the mismatches. All three must converge on the
// canonical name from resolve_tuple_ann.

type Z9Cmd { Quit }
type Z9Model { count: Int }

fn z9_upd(m: Z9Model) -> (Z9Model, Option[Z9Cmd]) {
    (m, Some(Z9Cmd.Quit))
}

fn z9_step[M](model: M, f: fn(M) -> (M, Option[Z9Cmd])) -> (M, Option[Z9Cmd]) {
    let mut m = model
    let mut last_cmd: Option[Z9Cmd] = None
    let (m2, cmd) = f(m)
    m = m2
    match cmd {
        Some(_) => last_cmd = cmd
        None => {}
    }
    (m, last_cmd)
}

test "generic fn returning (M, Option[enum]) lowers a single canonical tuple" {
    let (m, c) = z9_step(Z9Model { count: 5 }, z9_upd)
    assert_eq(m.count, 5)
    assert_eq(c.is_some(), 1)
}
