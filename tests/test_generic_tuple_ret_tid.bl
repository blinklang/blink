// A generic fn returning a tuple (`-> (T, T)`) materializes a `_gtr` codegen temp
// (emit_generic_struct_ret_temp) that was registered CT_STRUCT with the tuple
// carrier name (Tuple2_int_int) on the flat ScopeVar.sname channel but carried no
// tid (publish_result_tid(-1)), so a field read through it fell back to the flat
// channel. The producer now stamps the call node's resolved tid when it round-trips
// to exactly that carrier name, so the tid leads. These guard field access through
// such a temp once the flat channel is gone.
fn pair_up[T](x: T, y: T) -> (T, T) {
    (x, y)
}

fn mixed_pair[A, B](a: A, b: B) -> (A, B) {
    (a, b)
}

test "field read through a generic-fn tuple-return temp" {
    let p = pair_up(3, 4)
    assert_eq(p.0 + p.1, 7)
}

test "mixed-type generic-fn tuple return keeps both element types" {
    let p = mixed_pair(9, "hi")
    let n: Int = p.0
    let s: Str = p.1
    assert_eq(n, 9)
    assert_eq(s, "hi")
}

test "field read directly on the generic-fn tuple return with no binding" {
    assert_eq(pair_up(11, 4).0, 11)
}
