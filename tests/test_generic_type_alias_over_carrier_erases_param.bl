// A generic type alias whose target is a carrier (Option/Result/List/Map) does
// not substitute its concrete type argument through to the alias typedef. The
// alias def is monomorphized with T erased to void while the use site
// monomorphizes to the concrete type, producing two different C type names.

import compile_test_helpers.{compile_and_run}

test.failing(
    "a generic type alias over a carrier keeps the concrete instantiation, not void",
    reason: "a generic type alias whose target is a carrier such as Option of T does not substitute the concrete type argument into the alias typedef; the alias def monomorphizes T to void (typedef blink_Option_void blink_MB) while the call site monomorphizes to the concrete type (blink_Option_Point), so cc fails with unknown type name and conflicting types for the function that returns the alias",
    ticket: "pf8za4",
) {
    let src = #"
import std.io

type Point { x: Int }
type MB[T] = Option[T]
fn make_opt(p: Point) -> MB[Point] { Some(p) }

fn main() ! IO {
    let m = make_opt(Point { x: 42 })
    io.println("{m.unwrap().x}")
}
"#
    let r = compile_and_run(src, "_generic_type_alias_over_carrier_erases_param")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "42\n")
}
