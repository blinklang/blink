// A variant constructor of a generic enum is a call. Inside a generic body its instance is the
// enum at the body's own type parameter, which each monomorphised copy substitutes, the same as
// any other expression type there (sections/03_types.md §3.4, "Variant Construction").

type Tree[T] {
    Leaf(T)
    Node(v: T)
    Empty
}

type Pair[T] {
    left: T
    tree: Tree[T]
}

fn show[T](t: Tree[T]) -> Str {
    match t {
        Tree.Leaf(x) => "leaf {x}"
        Tree.Node(v) => "node {v}"
        Tree.Empty => "empty"
    }
}

fn qualified[T](v: T) -> Tree[T] {
    Tree.Leaf(v)
}

fn bare[T](v: T) -> Tree[T] {
    Leaf(v)
}

fn annotated[T](v: T) -> Tree[T] {
    let t: Tree[T] = Tree.Leaf(v)
    t
}

fn unannotated[T](v: T) -> Tree[T] {
    let t = Tree.Leaf(v)
    t
}

fn labelled[T](v: T) -> Tree[T] {
    Tree.Node(v: v)
}

fn braced[T](v: T) -> Tree[T] {
    Tree.Node { v: v }
}

fn in_closure[T](v: T) -> Tree[T] {
    let f = fn(x: T) -> Tree[T] { Tree.Leaf(x) }
    f(v)
}

fn empty_returned[T](_v: T) -> Tree[T] {
    Tree.Empty
}

fn empty_let[T](_v: T) -> Tree[T] {
    let t: Tree[T] = Tree.Empty
    t
}

fn empty_field[T](v: T) -> Pair[T] {
    Pair { left: v, tree: Tree.Empty }
}

fn empty_listed[T](v: T) -> List[Tree[T]] {
    [Tree.Leaf(v), Tree.Empty]
}

fn show_beside[T](t: Tree[T], _v: T) -> Str {
    show(t)
}

fn empty_passed[T](v: T) -> Str {
    show_beside(Tree.Empty, v)
}

fn or_else[T](a: Option[T], b: T) -> T {
    a ?? b
}

fn none_passed[T](v: T) -> T {
    or_else(None, v)
}

fn leaf_passed[T](v: T) -> Str {
    show(Tree.Leaf(v))
}

type Holder[T] {
    v: T
}

trait Wrap[T] {
    fn wrap(self) -> Tree[T]
}

impl[T] Wrap[T] for Holder[T] {
    fn wrap(self) -> Tree[T] {
        Tree.Leaf(self.v)
    }
}

trait Dup {
    fn dup(self) -> Self
}

impl[T] Dup for Tree[T] {
    fn dup(self) -> Tree[T] {
        match self {
            Tree.Leaf(x) => Tree.Node(v: x)
            Tree.Node(v) => Leaf(v)
            Tree.Empty => Empty
        }
    }
}

test "a variant built in a generic fn body runs at each instance" {
    assert_eq(show(qualified(4)), "leaf 4")
    assert_eq(show(qualified("s")), "leaf s")
    assert_eq(show(bare(5)), "leaf 5")
    assert_eq(show(bare("b")), "leaf b")
    assert_eq(show(annotated(6)), "leaf 6")
    assert_eq(show(unannotated(7)), "leaf 7")
}

test "a labelled and a braced variant built in a generic fn body run" {
    assert_eq(show(labelled(8)), "node 8")
    assert_eq(show(labelled("l")), "node l")
    assert_eq(show(braced(9)), "node 9")
    assert_eq(show(braced("r")), "node r")
}

test "a variant built in a closure in a generic body runs" {
    assert_eq(show(in_closure(10)), "leaf 10")
    assert_eq(show(in_closure("c")), "leaf c")
}

test "a nullary variant of a generic enum in a generic body runs in each position" {
    assert_eq(show(empty_returned(1)), "empty")
    assert_eq(show(empty_let("x")), "empty")
    let p = empty_field(2)
    assert_eq(p.left, 2)
    assert_eq(show(p.tree), "empty")
    let xs = empty_listed("e")
    assert_eq(show(xs.get(0).unwrap()), "leaf e")
    assert_eq(show(xs.get(1).unwrap()), "empty")
    assert_eq(empty_passed(3), "empty")
    assert_eq(leaf_passed("p"), "leaf p")
}

test "a generic call takes its type parameter from an argument typed with the body's own" {
    assert_eq(none_passed(13), 13)
    assert_eq(none_passed("n"), "n")
}

test "a variant built in a generic impl method on a generic struct runs" {
    assert_eq(show(Holder { v: 11 }.wrap()), "leaf 11")
    assert_eq(show(Holder { v: "h" }.wrap()), "leaf h")
}

test "a variant built in a trait impl on a generic enum runs" {
    let a: Tree[Int] = Tree.Leaf(12)
    assert_eq(show(a.dup()), "node 12")
    let b: Tree[Str] = Tree.Node(v: "d")
    assert_eq(show(b.dup()), "leaf d")
    let c: Tree[Int] = Tree.Empty
    assert_eq(show(c.dup()), "empty")
}
