// A variant field that is a tuple wrapping a NON-self generic instance
// (type W[T] { V(p: (Other[T], Int)) }) must keep the mono tuple carrier at a
// whole-tuple match binder `V(p)`, the same carrier the constructor built.

import compile_test_helpers.{compile_and_run}

test "a match binder for a variant's tuple field wrapping a non-self generic instance keeps its mono carrier name" {
    let src = #"
import std.io

type Other[T] { Wrap(x: T) }
type W[T] { V(p: (Other[T], Int)), E }

fn main() ! IO {
    let w: W[Int] = W.V((Other.Wrap(5), 7))
    match w {
        V(p) => match p.0 {
            Wrap(x) => io.println("v {x} {p.1}")
        }
        E => io.println("e")
    }
}
"#
    let r = compile_and_run(src, "_generic_variant_tuple_field_nonself_generic_binder")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "v 5 7\n")
}
