// A variant field that is a tuple wrapping a NON-self generic instance
// (type W[T] { V(p: (Other[T], Int)) }) erases its tuple carrier type at a
// match binder: whole-tuple bind `V(p)` emits `blink_Tuple2_Other_int p = ...`
// (erased, missing the mono suffix) against the arg-full constructed value
// `blink_Tuple2_Other_0Int_int`, which the C compiler rejects.

import compile_test_helpers.{compile_and_run}

test.failing(
    "a match binder for a variant's tuple field wrapping a non-self generic instance keeps its mono carrier name",
    reason: "a variant field that is a tuple wrapping a non-self generic instance (Other[T] inside W[T]'s V variant) erases the tuple's carrier type at the whole-tuple match binder, emitting blink_Tuple2_Other_int instead of the mono-suffixed blink_Tuple2_Other_0Int_int that construction actually built, causing a C compile error",
    ticket: "frqm51",
) {
    let src = #"
import std.io

type Other[T] { Wrap(x: T) }
type W[T] { V(p: (Other[T], Int)), E }

fn main() ! IO {
    let w: W[Int] = W.V((Other.Wrap(5), 7))
    match w {
        V(p) => match p.0 {
            Wrap(x) => io.println("v {x} {p.1}")
        }
        E => io.println("e")
    }
}
"#
    let r = compile_and_run(src, "_generic_variant_tuple_field_nonself_generic_binder")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "v 5 7\n")
}
