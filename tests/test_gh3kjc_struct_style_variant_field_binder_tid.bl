// br gh3kjc — a struct-style enum-variant field binder (`match s { E.V { field } => ... }`) spells
// its C type from the field-pattern node's published tid, not the flat CT. The tid is published by
// the EnumPattern struct-style typecheck arm (the sibling of the StructPattern arm's publish); the
// codegen scalar fallthrough in bind_struct_style_variant_fields then lets c_type_from_tid lead,
// keeping the flat spelling only where the tid declines or is void.
//
// For the reachable scalar field types (Int/Str/Bool/Float) the tid AGREES with the flat spelling,
// so the flip is byte-identical here — this guards that the tid-authoritative path keeps spelling
// each scalar binder with its correct C type once the typecheck arm publishes the tid.

import compile_test_helpers
import std.io

fn variant_field_src() -> Str {
    #"import std.io

type Shape {
    Rect { w: Int, h: Int },
    Named { label: Str, area: Float },
    Flag { on: Bool }
}

fn main() {
    let r = Shape.Rect { w: 2, h: 3 }
    match r {
        Shape.Rect { w, h } => io.println("rect {w} {h}")
        Shape.Named { label, area } => io.println("named {label} {area}")
        Shape.Flag { on } => io.println("flag {on}")
    }
    let n = Shape.Named { label: "sq", area: 9.5 }
    match n {
        Shape.Rect { w, h } => io.println("rect {w} {h}")
        Shape.Named { label, area } => io.println("named {label} {area}")
        Shape.Flag { on } => io.println("flag {on}")
    }
}
"#
}

test "struct-style variant field binders spell each scalar C type from the tid" {
    let c = compile_test_helpers.compile_and_emit_c(variant_field_src(), "gh3kjc_emit")
    if !c.contains("int64_t w = ") {
        io.println("FAIL: Int variant field binder not spelled int64_t")
    }
    assert(c.contains("int64_t w = "))
    assert(c.contains("int64_t h = "))
    if !c.contains("const char* label = ") {
        io.println("FAIL: Str variant field binder not spelled const char*")
    }
    assert(c.contains("const char* label = "))
    if !c.contains("double area = ") {
        io.println("FAIL: Float variant field binder not spelled double")
    }
    assert(c.contains("double area = "))
    assert(c.contains("int on = "))
}

test "struct-style variant field binders compile and run" {
    let r = compile_test_helpers.compile_and_run(variant_field_src(), "gh3kjc_run")
    if r.exit_code != 0 {
        io.println("FAIL: did not run cleanly (exit {r.exit_code})")
        io.println(r.err_out)
    }
    assert(r.exit_code == 0)
    assert(r.out.contains("rect 2 3"))
    assert(r.out.contains("named sq 9.5"))
}
