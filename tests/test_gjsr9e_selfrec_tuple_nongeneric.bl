// A NON-generic self-recursive enum whose variant payload is a TUPLE of the
// enum itself (`Pair(p: (Box, Box))`) must emit the mono tuple carrier AFTER the
// enum typedef, not before. The carrier `Tuple2_Box_Box` embeds `blink_Box` by
// value, so preflushing it ahead of the enum (as normal field carriers are)
// forward-references an undefined type — `unknown type name 'blink_Box'`. The
// enum boxes the field to int64_t, then the carrier is emitted afterward. This
// is the non-generic global-ordering tail of the e1f78s self-recursive-enum
// family (the generic case is covered by test_41v64m).

import compile_test_helpers

fn src_pair_leaf() -> Str {
    #"import std.io

type Box { Pair(p: (Box, Box)), Leaf(v: Int) }

fn main() {
    let b: Box = Box.Leaf(5)
    match b {
        Box.Leaf(v) => io.println("leaf {v}")
        Box.Pair(p) => io.println("pair")
    }
}
"#
}

test "non-generic self-recursive tuple-field enum compiles and matches Leaf" {
    let r = compile_test_helpers.compile_and_run(src_pair_leaf(), "gjsr9e_leaf")
    if !r.out.contains("leaf 5") {
        compile_test_helpers.expect_contains(r.out, "leaf 5", "non-generic selfrec tuple-field Leaf — got '{r.out}' / '{r.err_out}'")
    }
    assert(r.out.contains("leaf 5"))
    assert(!r.out.contains("pair"))
    assert_eq(r.exit_code, 0)
}

fn src_pair_walk() -> Str {
    #"import std.io

type Box { Pair(p: (Box, Box)), Leaf(v: Int) }

fn sum(b: Box) -> Int {
    match b {
        Box.Leaf(v) => v
        Box.Pair(p) => sum(p.0) + sum(p.1)
    }
}

fn main() {
    let l: Box = Box.Leaf(3)
    let r: Box = Box.Leaf(4)
    let root: Box = Box.Pair((l, r))
    io.println("sum {sum(root)}")
}
"#
}

test "non-generic self-recursive tuple-field enum walks the boxed tuple" {
    let r = compile_test_helpers.compile_and_run(src_pair_walk(), "gjsr9e_walk")
    if !r.out.contains("sum 7") {
        compile_test_helpers.expect_contains(r.out, "sum 7", "non-generic selfrec tuple-field walk — got '{r.out}' / '{r.err_out}'")
    }
    assert(r.out.contains("sum 7"))
    assert_eq(r.exit_code, 0)
}
