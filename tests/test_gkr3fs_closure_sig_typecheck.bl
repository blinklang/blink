import compile_test_helpers

// gkr3fs Part A — closure-taking HOFs validate explicit closure annotations
// against the container element type. List[Int].map(fn(x: Str)...) must raise E0300.

test "List.map rejects closure param type mismatch" {
    let src = "fn main() \{ let l: List[Int] = [1, 2, 3]\n let r = l.map(fn(x: Str) -> Int \{ 1 }) }\n"
    compile_test_helpers.expect_compile_error(src, "gkr3fs_map_param", "E0300")
}

test "List.map accepts matching closure param type" {
    let src = "fn main() \{ let l: List[Int] = [1, 2, 3]\n let r = l.map(fn(x: Int) -> Int \{ x + 1 }) }\n"
    compile_test_helpers.expect_no_error(src, "gkr3fs_map_param_ok", "E0300")
}

test "List.filter rejects closure param type mismatch" {
    let src = "fn main() \{ let l: List[Int] = [1, 2, 3]\n let r = l.filter(fn(x: Str) -> Bool \{ true }) }\n"
    compile_test_helpers.expect_compile_error(src, "gkr3fs_filter_param", "E0300")
}

test "List.filter rejects non-Bool closure return" {
    let src = "fn main() \{ let l: List[Int] = [1, 2, 3]\n let r = l.filter(fn(x: Int) -> Str \{ \"y\" }) }\n"
    compile_test_helpers.expect_compile_error(src, "gkr3fs_filter_ret", "E0300")
}

test "List.for_each rejects closure param type mismatch" {
    let src = "fn main() \{ let l: List[Int] = [1, 2, 3]\n l.for_each(fn(x: Str) \{ io.println(x) }) }\n"
    compile_test_helpers.expect_compile_error(src, "gkr3fs_foreach_param", "E0300")
}

test "List.any rejects non-Bool closure return" {
    let src = "fn main() \{ let l: List[Int] = [1, 2, 3]\n let r = l.any(fn(x: Int) -> Str \{ \"y\" }) }\n"
    compile_test_helpers.expect_compile_error(src, "gkr3fs_any_ret", "E0300")
}

test "List.fold rejects closure elem param mismatch" {
    let src = "fn main() \{ let l: List[Int] = [1, 2, 3]\n let r = l.fold(0, fn(acc: Int, x: Str) -> Int \{ acc }) }\n"
    compile_test_helpers.expect_compile_error(src, "gkr3fs_fold_param", "E0300")
}

test "List HOFs with matching annotations compile" {
    let src = "fn main() \{ let l: List[Int] = [1, 2, 3]\n let a = l.filter(fn(x: Int) -> Bool \{ x > 1 })\n l.for_each(fn(x: Int) \{ io.println(\"\{x}\") })\n let b = l.any(fn(x: Int) -> Bool \{ x > 2 })\n let c = l.fold(0, fn(acc: Int, x: Int) -> Int \{ acc + x }) }\n"
    compile_test_helpers.expect_no_error(src, "gkr3fs_valid", "E0300")
}
