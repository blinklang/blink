// br gq0sty — validate_set_elem / validate_map_key end in a silent fall-through: their
// final rejection arm only fires for named_type_map members (user structs/enums), so a
// non-hashable BUILTIN element (Option/Result/List/Map/Set itself, Bytes, StringBuilder,
// fn types) falls off the end and is accepted with no diagnostic. Measured at HEAD
// (1a2010f): most shapes below reach an opaque `cc` failure —
// BLINK_COMPILER_BUG_kops_unsupported_K_ct... — with no Blink diagnostic at all, and
// Set[(Int, Option[Int])] is worse: it compiles and runs, silently losing elements
// (Option is dropped from hashing entirely).
//
// THE FIX. Both validators now deny-by-default: accept known-hashable (builtin scalar,
// @derive(Hash) user type, or a tuple whose elements all accept) -> defer an unresolved
// name that is_primitive_type does not recognize and that is not a registered user type
// (a generic type parameter, opaque here on purpose) -> reject everything else, since
// is_primitive_type enumerates every concrete builtin name the compiler knows and none of
// them (besides the already-accepted scalars) implement Hash.
//
// This file exercises every row from the ticket's failure-mode table plus the green
// controls and the f8t5wb typevar-deferral tripwires that must NOT regress.

import compile_test_helpers
import std.io

// ── REJECT: bare builtin-container Set elements ───────────────────────────────────────

test "Set[Option[Int]] is rejected" {
    let src = "fn main() \{\n    let s: Set[Option[Int]] = Set()\n    assert(s.len() == 0)\n}\n"
    compile_test_helpers.expect_compile_error(src, "gq0sty_set_option", "MapKeyNotHashable")
}

test "Set[Result[Int,Str]] is rejected" {
    let src = "fn main() \{\n    let s: Set[Result[Int, Str]] = Set()\n    assert(s.len() == 0)\n}\n"
    compile_test_helpers.expect_compile_error(src, "gq0sty_set_result", "MapKeyNotHashable")
}

test "Set[List[Int]] is rejected" {
    let src = "fn main() \{\n    let s: Set[List[Int]] = Set()\n    assert(s.len() == 0)\n}\n"
    compile_test_helpers.expect_compile_error(src, "gq0sty_set_list", "MapKeyNotHashable")
}

test "Set[Map[Str,Int]] is rejected" {
    let src = "fn main() \{\n    let s: Set[Map[Str, Int]] = Set()\n    assert(s.len() == 0)\n}\n"
    compile_test_helpers.expect_compile_error(src, "gq0sty_set_map", "MapKeyNotHashable")
}

test "Set[Set[Int]] is rejected" {
    let src = "fn main() \{\n    let s: Set[Set[Int]] = Set()\n    assert(s.len() == 0)\n}\n"
    compile_test_helpers.expect_compile_error(src, "gq0sty_set_set", "MapKeyNotHashable")
}

test "Set[Bytes] is rejected" {
    let src = "fn main() \{\n    let s: Set[Bytes] = Set()\n    assert(s.len() == 0)\n}\n"
    compile_test_helpers.expect_compile_error(src, "gq0sty_set_bytes", "MapKeyNotHashable")
}

test "Set[StringBuilder] is rejected" {
    let src = "fn main() \{\n    let s: Set[StringBuilder] = Set()\n    assert(s.len() == 0)\n}\n"
    compile_test_helpers.expect_compile_error(src, "gq0sty_set_sb", "MapKeyNotHashable")
}

test "Set[fn() -> Int] is rejected" {
    let src = "fn main() \{\n    let s: Set[fn() -> Int] = Set()\n    assert(s.len() == 0)\n}\n"
    compile_test_helpers.expect_compile_error(src, "gq0sty_set_fn", "MapKeyNotHashable")
}

// ── REJECT: the Map-key twin ───────────────────────────────────────────────────────────

test "Map[Option[Int],Str] is rejected" {
    let src = "fn main() \{\n    let m: Map[Option[Int], Str] = Map()\n    assert(m.len() == 0)\n}\n"
    compile_test_helpers.expect_compile_error(src, "gq0sty_map_option_key", "MapKeyNotHashable")
}

test "Map[List[Int],Int] is rejected" {
    let src = "fn main() \{\n    let m: Map[List[Int], Int] = Map()\n    assert(m.len() == 0)\n}\n"
    compile_test_helpers.expect_compile_error(src, "gq0sty_map_list_key", "MapKeyNotHashable")
}

// ── REJECT: the silent-miscompile row — a tuple element must fail if ANY of its own
// elements is non-hashable. Before the fix this compiled and ran, silently losing the
// `Some(7)`/`Some(99)` distinction because Option was never checked once recursed into.

test "Set[(Int, Option[Int])] is rejected — the silent-miscompile shape" {
    let src = "fn main() \{\n    let mut s: Set[(Int, Option[Int])] = Set()\n    s.insert((1, Some(7)))\n    assert(s.len() == 1)\n}\n"
    compile_test_helpers.expect_compile_error(src, "gq0sty_tuple_option_elem", "MapKeyNotHashable")
}

// ── REJECT: a type alias to a container gets the CONTAINER help, not @derive advice ────
//
// HEAD rejects this too (MaybeInt lands in named_type_map, since register_struct_type
// inserts every `type X = Y` alias name unconditionally), but with the wrong help text —
// "add @derive(Hash, Eq) to 'MaybeInt'" is a category error, since an alias can't carry a
// derive for its base type. alias_name_decidable now hops through container/Bytes/
// StringBuilder/Fn names (never Tuple — a bare name has no element nodes to recurse into,
// and Tuple's hashability depends on its elements) so the message names the real reason.

fn src_maybeint_set() -> Str {
    let mut s = "type MaybeInt = Option[Int]\n"
    s = s.concat("fn main() \{\n")
    s = s.concat("    let x: Set[MaybeInt] = Set()\n")
    s = s.concat("    assert(x.len() == 0)\n")
    s = s.concat("}\n")
    s
}

test "Set[MaybeInt] is rejected with the container help, not @derive advice" {
    let out = compile_test_helpers.compile_and_capture(src_maybeint_set(), "gq0sty_maybeint")
    if !out.contains("MapKeyNotHashable") { io.println("FAIL: MaybeInt / expected MapKeyNotHashable, got: {out}") }
    assert(out.contains("MapKeyNotHashable"))
    if !out.contains("'MaybeInt'") { io.println("FAIL: MaybeInt / message must name what the user wrote") }
    assert(out.contains("'MaybeInt'"))
    if out.contains("add @derive(Hash, Eq) to") { io.println("FAIL: MaybeInt / must not give derive advice for an Option alias, got: {out}") }
    assert(!out.contains("add @derive(Hash, Eq) to"))
}

// ── REJECT: the type-arg-walk route through a struct ──────────────────────────────────

test "Box[Set[Option[Int]]] is rejected via the struct type-arg walk" {
    let src = "type Box[T] \{ value: T }\nfn main() \{\n    let x: Box[Set[Option[Int]]] = Box \{ value: Set() }\n    assert(x.value.len() == 0)\n}\n"
    compile_test_helpers.expect_compile_error(src, "gq0sty_box_set_option", "MapKeyNotHashable")
}

// ── GREEN CONTROLS: must stay accepted ─────────────────────────────────────────────────

test "Set[Str] stays accepted" {
    let src = "fn main() \{\n    let s: Set[Str] = Set()\n    assert(s.len() == 0)\n}\n"
    compile_test_helpers.expect_no_error(src, "gq0sty_ctl_str", "MapKeyNotHashable")
}

test "Set[Int] stays accepted" {
    let src = "fn main() \{\n    let s: Set[Int] = Set()\n    assert(s.len() == 0)\n}\n"
    compile_test_helpers.expect_no_error(src, "gq0sty_ctl_int", "MapKeyNotHashable")
}

test "Set[Bool] stays accepted" {
    let src = "fn main() \{\n    let s: Set[Bool] = Set()\n    assert(s.len() == 0)\n}\n"
    compile_test_helpers.expect_no_error(src, "gq0sty_ctl_bool", "MapKeyNotHashable")
}

test "Set[Char] stays accepted" {
    let src = "fn main() \{\n    let s: Set[Char] = Set()\n    assert(s.len() == 0)\n}\n"
    compile_test_helpers.expect_no_error(src, "gq0sty_ctl_char", "MapKeyNotHashable")
}

test "Set[U8] stays accepted" {
    let src = "fn main() \{\n    let s: Set[U8] = Set()\n    assert(s.len() == 0)\n}\n"
    compile_test_helpers.expect_no_error(src, "gq0sty_ctl_u8", "MapKeyNotHashable")
}

test "Set[(Int, Str)] stays accepted — every tuple element is hashable" {
    let src = "fn main() \{\n    let mut s: Set[(Int, Str)] = Set()\n    s.insert((1, \"a\"))\n    s.insert((1, \"a\"))\n    s.insert((2, \"b\"))\n    assert(s.len() == 2)\n}\n"
    compile_test_helpers.expect_no_error(src, "gq0sty_ctl_tuple_hashable", "MapKeyNotHashable")
}

test "Set[K] for a @derive(Hash, Eq) type K stays accepted" {
    let src = "@derive(Hash, Eq)\ntype K \{ n: Int }\nfn main() \{\n    let s: Set[K] = Set()\n    assert(s.len() == 0)\n}\n"
    compile_test_helpers.expect_no_error(src, "gq0sty_ctl_derived_struct", "MapKeyNotHashable")
}

test "Map[Float,Str] is still rejected on the Float key, unchanged" {
    let src = "fn main() \{\n    let m: Map[Float, Str] = Map()\n    assert(m.len() == 0)\n}\n"
    compile_test_helpers.expect_compile_error(src, "gq0sty_ctl_float_key", "MapKeyNotHashable")
}

// ── TRIPWIRES: the f8t5wb typevar-deferral rows must not regress ──────────────────────
//
// A generic type parameter is opaque here on purpose — it matches neither a builtin
// hashable name nor is_primitive_type nor a registered user type, so it must stay SILENT,
// not be swept into the new reject bucket. If this regresses, every generic container
// (List[Map[K,V]] inside a generic fn, etc.) starts failing to compile.

fn src_typevar_set_elem() -> Str {
    let mut s = "type Wrap[K] \{ s: Set[K], n: Int }\n"
    s = s.concat("fn main() \{\n")
    s = s.concat("    assert(true)\n")
    s = s.concat("}\n")
    s
}

test "a type-param Set element inside a generic struct is not falsely rejected" {
    let out = compile_test_helpers.compile_and_capture(src_typevar_set_elem(), "gq0sty_typevar_set")
    if out != "" { io.println("FAIL: typevar Set element / expected silence, got: {out}") }
    assert(out == "")
}

fn src_typevar_map_key() -> Str {
    let mut s = "type WrapM[K] \{ m: Map[K, Int] }\n"
    s = s.concat("fn main() \{\n")
    s = s.concat("    assert(true)\n")
    s = s.concat("}\n")
    s
}

test "a type-param Map key inside a generic struct is not falsely rejected" {
    let out = compile_test_helpers.compile_and_capture(src_typevar_map_key(), "gq0sty_typevar_map")
    if out != "" { io.println("FAIL: typevar Map key / expected silence, got: {out}") }
    assert(out == "")
}
