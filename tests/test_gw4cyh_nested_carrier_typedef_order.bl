// br gw4cyh (codegen-structured-tids). An Option/Result carrier whose leaf is a
// generic-struct INSTANCE nested inside a compound carrier: the inner compound
// carrier's typedef was emitted AFTER the outer Option referenced it, so GCC read
// the still-undeclared member as `int *` (a cc `incompatible pointer type` error).
// The member SPELLING was already correct (`blink_Result_Box_Int_str* value`);
// the defect is typedef emission ORDER. The scalar twin Option[Result[Int,Str]]
// only worked by category-flush luck. The fix recurses emit_struct_option/
// result_typedef into an embedded compound-carrier dependency (mirroring the
// existing embedded-tuple recursion). Runtime field access, so this MUST run via
// `task test` (archive-linked), not just compile.
//
// NOTE: value access is via `match`, not a `.unwrap().unwrap()` chain — a chained
// middle .unwrap() on a nested carrier trips a SEPARATE pre-existing typecheck
// erasure (fails even for the scalar twin Option[Result[Int,Str]]), out of scope
// for gw4cyh's codegen-order fix.
//
// Model: test_2bd4aa_nested_result_carrier.

type Box[T] {
    value: T
}

test "Option[Result[Box[Int], Str]] carrier round-trips inner Int" {
    let o: Option[Result[Box[Int], Str]] = Some(Ok(Box { value: 21 }))
    assert_eq(o.is_some(), true)
    match o {
        Some(r) => {
            match r {
                Ok(b) => { assert_eq(b.value, 21) }
                Err(_e) => { assert(false) }
            }
        }
        None => { assert(false) }
    }
}

test "Option[Result[Option[Box[Int]], Str]] deeper nesting round-trips inner Int" {
    let o: Option[Result[Option[Box[Int]], Str]] = Some(Ok(Some(Box { value: 42 })))
    assert_eq(o.is_some(), true)
    match o {
        Some(r) => {
            match r {
                Ok(inner) => {
                    match inner {
                        Some(b) => { assert_eq(b.value, 42) }
                        None => { assert(false) }
                    }
                }
                Err(_e) => { assert(false) }
            }
        }
        None => { assert(false) }
    }
}
