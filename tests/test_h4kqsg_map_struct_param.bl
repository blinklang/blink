// br h4kqsg: a by-value fn param annotated Map[Str, Box[Int]] stamps its value
// struct name via the bare generic head (src/codegen_stmt.bl emit_fn_def, the
// `ptype == "Map"` param branch) -- `node_name(val_ann)` reads only "Box", never
// consulting `node_elements(val_ann)` (holding Int), so the mono stem "Box_Int"
// is lost. Same defect class as td9n5k (sibling writer into the same
// set_map_types/set_map_value_struct sink); here the writer is the plain-fn
// param binder rather than the Assignment arm. Model: test_1452w4 (let-only).
// The failure surfaces at runtime field access, so this MUST run via `task
// test` (archive-linked), not just compile.

type Box[T] {
    value: T
}

fn read_boxed_value(m: Map[Str, Box[Int]]) -> Int {
    m.get("k").unwrap().value
}

test "Map[Str, Box[Int]] value struct survives a by-value fn param" {
    let mut m: Map[Str, Box[Int]] = Map()
    m.insert("k", Box { value: 555 })
    assert_eq(read_boxed_value(m), 555)
}
