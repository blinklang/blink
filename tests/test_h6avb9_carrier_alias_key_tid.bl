// br h6avb9 — the compound-carrier tag namer (resolve_ann_tag_ctx) spelled a nested
// Map-key leaf from type_from_name, which single-hops a transparent alias. A struct
// alias (`type MyKey = Point`, non-scalar) and a multi-hop chain (`type A = B = Int`)
// both fell through to CT_VOID and the carrier typedef emitted `blink_Option_Map_void_int`
// while the signature path spelled the key from the canonical tid — two spellings, cc
// error. The leaf now peels the alias to its underlying tid and spells from it, matching
// the signature. Single-builtin-alias keys (`type Port = Int`) were already covered by
// bvh7qt; these two rows guard the struct-alias and alias-chain cases.

@derive(Hash, Eq)
type Point { x: Int, y: Int }
type MyKey = Point

fn make_struct_alias(n: Int) -> Option[Map[MyKey, Int]] {
    let mut m: Map[MyKey, Int] = Map()
    m.insert(Point { x: 1, y: 2 }, n)
    Some(m)
}

type ChainB = Int
type ChainA = ChainB

fn make_chain(n: Int) -> Option[Map[ChainA, Int]] {
    let mut m: Map[ChainA, Int] = Map()
    m.insert(1, n)
    Some(m)
}

test "a struct-alias key inside an Option[Map] carrier round-trips" {
    let got = make_struct_alias(9).unwrap().get(Point { x: 1, y: 2 }) ?? -1
    assert_eq(got, 9)
}

test "a multi-hop alias-chain key inside an Option[Map] carrier round-trips" {
    let got = make_chain(4).unwrap().get(1) ?? -1
    assert_eq(got, 4)
}
