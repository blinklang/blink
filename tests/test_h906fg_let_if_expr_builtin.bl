// Regression for h906fg: `let x = if cond { ... } else { ... }` where both
// branches produce a builtin heap value (Bytes, List, Map, StringBuilder) emitted
// broken C — the branch values were discarded (`(void)blink_bytes_new();`) and the
// binding declared `const void x = 0;`. The if-expr result temp's C type was taken
// from a fragile pre-pass that has no case for builtin constructors, so it fell to
// CT_VOID. Same bug class as anphdt (struct-returning calls), extended to builtins.
//
// The carrier cases (Result/Option) guard the fn-return-type hint paths, which
// legitimately rely on the enclosing fn's return type for bare Ok/Err/Some/None.

fn pick_bytes(c: Int) -> Bytes {
    let p = if c > 0 { Bytes.new() } else { Bytes.from_str("abc") }
    p
}

fn pick_list(c: Int) -> List[Int] {
    let p = if c > 0 { [] } else { [1, 2] }
    p
}

fn pick_map(c: Int) -> Map[Str, Int] {
    // The annotation on `p` is still required even after farq9f (declared-return
    // pinning of a TAIL Map()/Set() ctor). Here the two Map() literals sit one level
    // down inside the if-branches, feeding an un-annotated `p` that is only later
    // returned by name — farq9f's tier C declines because the ctor node itself is not
    // the fn's tail value, and (confirmed empirically) this reaches neither an E0301
    // nor farq9f's Stage-B I0001 backstop: it silently keeps the string-kops default
    // and segfaults on the first Int-keyed insert. Filed as a distinct follow-up
    // (br mxe4q9) rather than folded into farq9f, since it's a different entry path
    // (if-expr branch merge into an un-annotated let) than the direct tail case this
    // ticket fixes. The annotation below is the workaround, not a stylistic choice.
    let p: Map[Str, Int] = if c > 0 { Map() } else { Map() }
    p
}

fn pick_sb(c: Int) -> StringBuilder {
    let p = if c > 0 { StringBuilder.new() } else { StringBuilder.new() }
    p
}

// The exact ticket shape: a builtin-heap if-expr bound inside a Result-returning
// fn, then wrapped in Ok. Previously the if-expr temp was declared `const void`.
fn build_bytes(c: Int) -> Result[Bytes, Str] {
    let payload = if c > 0 { Bytes.new() } else { Bytes.new() }
    Ok(payload)
}

// Carrier-hint guard: a non-carrier (Int) if-expr inside a Result-returning fn,
// then wrapped in a bare Ok — exercises the CT_RESULT fn-ret hint path, which
// must stay intact after the VOID/STRUCT-path rewrite.
fn build_result(c: Int) -> Result[Int, Str] {
    let n = if c > 0 { 1 } else { 0 }
    Ok(n)
}

// Carrier-hint guard for the CT_OPTION fn-ret hint path.
fn build_option(c: Int) -> Option[Int] {
    let n = if c > 0 { 1 } else { 0 }
    Some(n)
}

test "let = if/else with Bytes branches" {
    assert_eq(pick_bytes(1).len(), 0)
    assert_eq(pick_bytes(0).len(), 3)
}

test "let = if/else with List branches" {
    assert_eq(pick_list(1).len(), 0)
    assert_eq(pick_list(0).len(), 2)
}

test "let = if/else with Map branches" {
    assert_eq(pick_map(1).len(), 0)
}

test "let = if/else with StringBuilder branches" {
    assert_eq(pick_sb(1).len(), 0)
}

test "let = if/else Bytes inside Result-returning fn" {
    assert_eq(build_bytes(1).is_ok(), true)
}

test "carrier hint: Int if-expr inside Result-returning fn still works" {
    assert_eq(build_result(1).unwrap(), 1)
    assert_eq(build_result(0).unwrap(), 0)
}

test "carrier hint: Int if-expr inside Option-returning fn still works" {
    assert_eq(build_option(1).unwrap(), 1)
}
