// Handle[T].await keeps its type T both for an unannotated let binding
// (rendered value, not a placeholder) and for a type-annotated one, and can
// be awaited more than once on the same handle.

test "unannotated and annotated Handle[Int].await both keep the Int value" {
    let h = async.spawn(fn() -> Int { 21 })
    let v = h.await
    assert_eq(v, 21)
    let w: Int = h.await
    assert_eq(w, 21)
}
