// A handler value keeps the handler it was built over. An operation that performs its own
// root reaches that handler, and an operation the literal omits answers through it too, so
// the two paths agree. A second build of the same literal over another handler must not
// redirect a value that already exists.

effect Tag {
    effect Ops {
        fn tag() -> Str
        fn other() -> Str
    }
}

fn wrap() -> Handler[Tag] {
    handler Tag {
        fn tag() -> Str { "w({tag.tag()})" }
    }
}

// No captures here: this file is about the delegation target alone.
fn base_a() -> Handler[Tag] {
    handler Tag {
        fn tag() -> Str { "A" }
        fn other() -> Str { "oA" }
    }
}

fn base_b() -> Handler[Tag] {
    handler Tag {
        fn tag() -> Str { "B" }
        fn other() -> Str { "oB" }
    }
}

fn read_both() -> Str ! Tag.Ops {
    "{tag.tag()} {tag.other()}"
}

test "a wrapper built over A reaches A when installed under B" {
    let a = base_a()
    let b = base_b()
    let mut wa: Handler[Tag] = a
    with a { wa = wrap() }
    with b {
        with wa { assert_eq(read_both(), "w(A) oA") }
    }
}

test "a later build over B does not redirect the wrapper built over A" {
    let a = base_a()
    let b = base_b()
    let mut wa: Handler[Tag] = a
    with a { wa = wrap() }
    let mut wb: Handler[Tag] = a
    with b { wb = wrap() }
    with a {
        with wa { assert_eq(read_both(), "w(A) oA") }
    }
    with a {
        with wb { assert_eq(read_both(), "w(B) oB") }
    }
}
