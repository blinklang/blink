import compile_test_helpers

fn handler_option_param_src() -> Str {
    #"effect Ledger2 {
    effect Post {
        fn entry(o: Option[Int], label: Str) -> Int
    }
}

fn ledger2_via(o: Option[Int], label: Str) -> Int ! Ledger2.Post {
    ledger2.entry(o, label)
}

fn main() {
    with handler Ledger2 {
        fn entry(o: Option[Int], label: Str) -> Int {
            (o ?? -1) + label.len()
        }
    } {
        io.println("{ledger2_via(Some(4), "ab")}")
        io.println("{ledger2_via(None, "abc")}")
    }
}
"#
}

test "a handler method with an Option parameter compiles and dispatches through the vtable" {
    let r = compile_test_helpers.compile_and_run(handler_option_param_src(), "_handler_method_option_param")
    assert(r.exit_code == 0, "expected clean run, got exit_code={r.exit_code} err={r.err_out}")
    assert(r.out.contains("6"), "expected Some(4)+'ab'.len()=6: out={r.out}")
    assert(r.out.contains("2"), "expected None -> -1+'abc'.len()=2: out={r.out}")
}
