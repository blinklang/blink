// Locks the handler-param readers against a tid-led guard change. A handler
// passed as a parameter must dispatch `with h` to its OWN effect vtable, read
// back at each `with` from the binding in scope — never a stale outer one, and
// never confused with a second handler param of a different effect. A value-
// returning op flows the answer out so a wrong vtable field fails the assert
// loudly rather than only misprinting.

effect Store {
    effect Query {
        fn fetch(key: Str) -> Int
    }
}

effect Tally {
    effect Count {
        fn total(label: Str) -> Int
    }
}

fn make_store() -> Handler[Store] {
    handler Store {
        fn fetch(_key: Str) -> Int {
            11
        }
    }
}

fn make_tally() -> Handler[Tally] {
    handler Tally {
        fn total(_label: Str) -> Int {
            22
        }
    }
}

fn via_store(h: Handler[Store]) -> Int {
    with h {
        store.fetch("k")
    }
}

fn via_tally(h: Handler[Tally]) -> Int {
    with h {
        tally.total("t")
    }
}

fn sum_both(s: Handler[Store], t: Handler[Tally]) -> Int {
    let mut acc = 0
    with s {
        acc = acc + store.fetch("a")
    }
    with t {
        acc = acc + tally.total("b")
    }
    acc
}

test "a handler param dispatches its value op to its own effect" {
    assert_eq(via_store(make_store()), 11)
    assert_eq(via_tally(make_tally()), 22)
}

test "two handler params of different effects do not cross-dispatch" {
    assert_eq(sum_both(make_store(), make_tally()), 33)
}

test "a handler param named like a caller local reads its own binding" {
    let h = 99
    assert_eq(via_store(make_store()), 11)
    assert_eq(h, 99)
}
