// Two handler values of one effect still join where inference makes one type of them: a list
// literal, a generic call, a method argument and a `??`. The unifier compares a handler's
// effect, and must not refuse a match. Each joined handler then installs and answers.

effect Metrics {
    effect Emit {
        fn counter(name: Str) -> Str
    }
}

fn tagged(tag: Str) -> Handler[Metrics] {
    handler Metrics {
        fn counter(name: Str) -> Str { "{tag}:{name}" }
    }
}

fn pick[T](a: T, _b: T) -> T { a }

fn run(h: Handler[Metrics]) -> Str {
    with h {
        metrics.counter("hits")
    }
}

test "handlers of one effect join and each one runs" {
    let xs = [(tagged("a"), []), (tagged("b"), [1])]
    let mut got: List[Str] = []
    for x in xs {
        got.push("{run(x.0)}/{x.1.len()}")
    }
    let p = pick((tagged("c"), []), (tagged("d"), [2]))
    got.push("{run(p.0)}/{p.1.len()}")
    let mut ys = [(tagged("e"), [])]
    ys.push((tagged("f"), [3]))
    got.push(run(ys.get(1).unwrap().0))
    let o: Option[Handler[Metrics]] = None
    got.push(run(o ?? tagged("g")))
    assert_eq(got.join(","), "a:hits/0,b:hits/1,c:hits/0,f:hits,g:hits")
}
