// Regression: has_test_blocks (src/cli.bl) must also match
// `test.failing(` — otherwise a file containing only test.failing blocks
// (§8.10.6, not yet implemented) would be invisible to collect_test_files
// and `blink test` would silently skip it. test.failing( is a lexical
// pre-filter, not a parse check, so this only verifies the file is
// SELECTED (not stopped by the "no test files in" usage error),
// not that it compiles.

import compile_test_helpers
import std.process.{ChildEnd}

test "file with only test.failing( is discovered, not skipped" {
    let scratch = "{compile_test_helpers.scratch_root()}/_test_failing_gate_{getpid()}"
    process.run("sh", ["-c", "rm -rf {scratch}"])?
    process.run("sh", ["-c", "mkdir -p {scratch}"])?

    fs.write("{scratch}/only_failing_{getpid()}.bl", "test.failing(\"placeholder\")\n").unwrap()

    let result = process.run("build/blink", ["test", "--json", scratch])?
    let output = result.out.concat(result.err_out)
    let diag = "{result.end}; captured:\n{output}"

    assert(!output.contains("no test files in"), "expected file with test.failing( to be picked up; {diag}")

    process.run("sh", ["-c", "rm -rf {scratch}"])?
}

test "file with neither test nor test.failing( is correctly skipped" {
    let scratch = "{compile_test_helpers.scratch_root()}/_test_failing_gate_neg_{getpid()}"
    process.run("sh", ["-c", "rm -rf {scratch}"])?
    process.run("sh", ["-c", "mkdir -p {scratch}"])?

    fs.write("{scratch}/no_tests_{getpid()}.bl", "// just a comment, no test blocks\nfn helper() -> Int \{ 1 }\n").unwrap()

    let result = process.run("build/blink", ["test", "--json", scratch])?
    let output = result.out.concat(result.err_out)
    let diag = "{result.end}; captured:\n{output}"

    // A run with no file to test is a usage error (sections/06_tooling.md §8.10).
    assert_eq(result.end, ChildEnd.Exited(2), "expected file with no test blocks to be skipped; {diag}")
    assert(result.err_out.contains("error: no test files in {scratch} (a test file is a .bl file with a test block)\n"), "expected file with no test blocks to be skipped; {diag}")

    process.run("sh", ["-c", "rm -rf {scratch}"])?
}
