// Regression (br vv51bm): has_test_blocks (src/cli.bl) must also match
// `test.failing(` — otherwise a file containing only test.failing blocks
// (§8.10.6, not yet implemented) would be invisible to collect_test_files
// and `blink test` would silently skip it. test.failing( is a lexical
// pre-filter, not a parse check, so this only verifies the file is
// SELECTED (not short-circuited by "no files with test blocks found"),
// not that it compiles.

test "file with only test.failing( is discovered, not skipped" {
    let scratch = ".tmp/_test_failing_gate_{getpid()}"
    shell_exec("rm -rf {scratch}")
    shell_exec("mkdir -p {scratch}")

    write_file("{scratch}/only_failing_{getpid()}.bl", "test.failing(\"placeholder\")\n")

    let result = process_run("build/blink", ["test", "--json", scratch])
    let output = result.out.concat(result.err_out)
    let diag = "exit_code={result.exit_code}; captured:\n{output}"

    assert(!output.contains("no files with test blocks found"), "expected file with test.failing( to be picked up; {diag}")

    shell_exec("rm -rf {scratch}")
}

test "file with neither test nor test.failing( is correctly skipped" {
    let scratch = ".tmp/_test_failing_gate_neg_{getpid()}"
    shell_exec("rm -rf {scratch}")
    shell_exec("mkdir -p {scratch}")

    write_file("{scratch}/no_tests_{getpid()}.bl", "// just a comment, no test blocks\nfn helper() -> Int \{ 1 }\n")

    let result = process_run("build/blink", ["test", "--json", scratch])
    let output = result.out.concat(result.err_out)
    let diag = "exit_code={result.exit_code}; captured:\n{output}"

    assert(output.contains("\"files\":[],\"summary\":\{\"files\":0"), "expected file with no test blocks to be skipped; {diag}")

    shell_exec("rm -rf {scratch}")
}
