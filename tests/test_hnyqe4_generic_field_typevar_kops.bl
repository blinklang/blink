// br hnyqe4: a generic-struct field Map[K,V]/Set[K] whose KEY/ELEM is a typevar
// that monomorphizes to a scalar (Int) must construct the container with the
// scalar kops vtable (blink_kops_i64), NOT the string default. Latent before the
// fix: the Map()/Set() ctor saw the field's key as an erased typevar (Void) so
// kops_elem_is_concrete was false and it fell to blink_kops_str, which hashes/
// compares the int key bytes as a C string. Int keys with a 0x00 low byte (256,
// 512, ...) then collide as the empty string -> silent overwrite / wrong get().
// 256 & 512 are the canonical corruption signature (both end in 0x00).
type GKV[K, V] { m: Map[K, V] }
type GSet[T] { s: Set[T] }

test "generic-struct Map[K,V] typevar int key does not collide (annotated)" {
    let b: GKV[Int, Str] = GKV { m: Map() }
    b.m.insert(256, "two-fifty-six")
    b.m.insert(512, "five-twelve")
    assert_eq(b.m.get(256).unwrap(), "two-fifty-six")
    assert_eq(b.m.get(512).unwrap(), "five-twelve")
}

test "generic-struct Map[K,V] typevar int key does not collide (inferred)" {
    let b = GKV { m: Map() }
    b.m.insert(256, "two-fifty-six")
    b.m.insert(512, "five-twelve")
    assert_eq(b.m.get(256).unwrap(), "two-fifty-six")
    assert_eq(b.m.get(512).unwrap(), "five-twelve")
}

test "generic-struct Set[T] typevar int elem does not collide (annotated)" {
    let g: GSet[Int] = GSet { s: Set() }
    g.s.insert(256)
    g.s.insert(512)
    assert_eq(g.s.len(), 2)
    assert(g.s.contains(256))
    assert(g.s.contains(512))
}

test "generic-struct Set[T] typevar int elem does not collide (inferred)" {
    let g = GSet { s: Set() }
    g.s.insert(256)
    g.s.insert(512)
    assert_eq(g.s.len(), 2)
    assert(g.s.contains(256))
    assert(g.s.contains(512))
}

// Review regression (code-review finding #2 / arity): two sibling generic-struct
// instances with DIFFERENT concrete type args in the same scope must each get
// their own kops — the monomorphization context must not leak from one let-target
// to the next. A str-keyed GKV and an int-keyed GKV side by side stay independent.
test "sibling generic maps with different key types stay independent" {
    let si: GKV[Str, Str] = GKV { m: Map() }
    let ii: GKV[Int, Str] = GKV { m: Map() }
    si.m.insert("hello", "world")
    ii.m.insert(256, "two-fifty-six")
    ii.m.insert(512, "five-twelve")
    assert_eq(si.m.get("hello").unwrap(), "world")
    assert_eq(ii.m.get(256).unwrap(), "two-fifty-six")
    assert_eq(ii.m.get(512).unwrap(), "five-twelve")
}
