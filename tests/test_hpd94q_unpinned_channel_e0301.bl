// A channel whose element nothing names is no longer a program that can be written.
//
// A bare `Channel(n)` once minted Channel[metavar], and this file held it to E0301 whenever
// no use pinned the element (decisions/under-determined-types.md). The spec builds a channel
// only through `channel.new[T](buffer: N)` (sections/04_effects.md), which writes the element
// at the construction site, so the bare call is now refused as an undefined function with
// that repair. Each shape that used to reach E0301, and each that a constraining use used to
// rescue, must reach that refusal and not E0301: the element question is never asked.
//
// A bare `Channel` in a TYPE position (`fn f(ch: Channel)`) is a different rule --
// error[TypeArgArity] E0303 (sections/03_types.md) -- and is not what this file checks.

import compile_test_helpers

fn assert_refused(src: Str, tag: Str) {
    let out = compile_test_helpers.compile_and_capture(src, tag)
    compile_test_helpers.expect_error(out, "E0504", "{tag}: bare Channel(n) is an undefined function")
    compile_test_helpers.expect_contains(out, "channel.new[T](buffer: n)", "{tag}: the repair names the spec constructor")
    assert(!out.contains("E0301"))
}

// ── shapes that were E0301: now refused before inference asks about the element ──

test "an unused bare Channel(n) is refused, not E0301" {
    let src = "fn main() \{ let ch = Channel(4) io.println(\"done\") }\n"
    assert_refused(src, "hpd94q_unused_channel")
}

test "a for-in-only bare Channel(n) is refused, not E0301" {
    let src = "fn main() \{ let ch = Channel(4) for v in ch \{ io.println(\"x\") } }\n"
    assert_refused(src, "hpd94q_forin_channel")
}

test "a recv-only bare Channel(n) is refused, not E0301" {
    let src = "fn main() \{ let ch = Channel(4) let _ = ch.recv() }\n"
    assert_refused(src, "hpd94q_recv_channel")
}

test "the refusal of an unpinned bare Channel(n) names channel.new[T]" {
    let src = "fn main() \{ let ch = Channel(4) io.println(\"done\") }\n"
    let out = compile_test_helpers.compile_and_capture(src, "hpd94q_channel_hint")
    assert(out.contains("E0504"))
    assert(out.contains("channel.new[T](buffer: n)"))
}

// ── shapes a constraining use used to rescue: a later use cannot make the call legal ──

test "a bare Channel(n) pinned by send is still refused" {
    let src = "fn main() \{ let ch = Channel(4) ch.send(\"x\") let _ = ch.recv() }\n"
    assert_refused(src, "hpd94q_send_channel")
}

test "an annotated Channel[T] binding is not E0301" {
    let src = "fn main() \{ let ch: Channel[Int] = channel.new[Int](buffer: 4) io.println(\"done\") }\n"
    compile_test_helpers.expect_no_error(src, "hpd94q_annotated_channel", "E0301")
}

test "a bare Channel(n) pinned by a concrete Channel[T] parameter is still refused" {
    let src = "fn take(ch: Channel[Str]) \{ ch.send(\"x\") }\nfn main() \{ let ch = Channel(4) take(ch) io.println(\"done\") }\n"
    assert_refused(src, "hpd94q_param_channel")
}
