import std.http_client.{parse_response}
import std.net_error.{net_error_display}
import std.http_types.{request_new, request_with_body, request_with_header, response_ok, response_is_ok, response_not_found}

test "request construction" {
    let req = request_new("GET", "http://example.com/test")
    assert_eq(req.method, "GET")
    assert_eq(req.url, "http://example.com/test")
    assert_eq(req.timeout_ms, 30000)

    let req2 = request_with_body(req, "hello")
    assert_eq(req2.body, "hello")

    let req3 = request_with_header(req, "Accept", "application/json")
    assert_eq(req3.method, "GET")
}

test "response helpers" {
    let r = response_ok("hi")
    assert_eq(r.status, 200)
    assert_eq(r.body, "hi")
    assert(response_is_ok(r) != 0)

    let r2 = response_not_found("nope")
    assert_eq(r2.status, 404)
}

test "chunked response body keeps 2-, 3- and 4-byte characters whole" {
    // chunk sizes count bytes: "aé" is 3, "€b" is 4, "😀" is 4
    let raw = "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n3\r\naé\r\n4\r\n€b\r\n4\r\n😀\r\n0\r\n\r\n"
    let resp = parse_response(raw).unwrap()
    assert_eq(resp.status, 200)
    assert_eq(resp.body, "aé€b😀")
}

test "chunked response body stops at a chunk that runs past the end" {
    let raw = "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n2\r\né\r\nA\r\n€"
    let resp = parse_response(raw).unwrap()
    assert_eq(resp.body, "é€")
}

test "a chunked body that is not text says why the bytes were refused" {
    // a size of 1 cuts the two-byte "é" after its first byte
    let raw = "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n1\r\né\r\n0\r\n\r\n"
    match parse_response(raw) {
        Ok(resp) => assert_eq(resp.body, "a refusal")
        Err(e) => assert_eq(net_error_display(e), "protocol_error: chunked body is not text: invalid UTF-8: truncated sequence")
    }
}
