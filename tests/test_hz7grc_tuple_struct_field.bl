type Holder { p: Tuple[Int, Int] }

test "match on a Tuple field" {
    let h = Holder { p: (3, 4) }
    let r = match h.p {
        (3, y) => y
        _ => 0
    }
    assert_eq(r, 4)
}

test "direct read of Tuple field elements" {
    let h = Holder { p: (3, 4) }
    assert_eq(h.p._0, 3)
    assert_eq(h.p._1, 4)
}

test "bind Tuple field to let then match" {
    let h = Holder { p: (3, 4) }
    let x = h.p
    let r = match x {
        (a, b) => a + b
    }
    assert_eq(r, 7)
}
