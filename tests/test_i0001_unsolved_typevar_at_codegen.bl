// internal compiler error[UnsolvedTypeVarAtCodegen] (I0001) — the codegen-side
// backstop for the two-state inference decision (8vcj2c). E0301 is the FRONT-END
// half: a genuinely under-determined binding is reported to the user. I0001 is the
// invariant half: if a declared type param nevertheless reaches monomorphization
// without a concrete spelling, the compiler must STOP rather than mint an erased
// name like blink_GKV_Void_Void — a valid C identifier that compiles and links
// while collapsing distinct instantiations onto one #ifndef BLINK_TD_ typedef.
//
// The chokepoint is emit_struct_lit: every generic-struct literal's mono name
// funnels through it, so a "Void" segment in the mono-args CSV is caught there.
//
// Catalog: ERROR_CATALOG.md I0001. Metric note: CLAUDE.md "Measuring type-erasure".

import compile_test_helpers

// ── the chokepoint fires ────────────────────────────────────────────────────
// A PHANTOM type param: no field of W mentions T, so no field-value inference arm
// can ever match it, and there is nothing under-determined for E0301 to latch onto
// either. Before the I0001 chokepoint this silently registered blink_W_Void, an
// erased name that compiled and linked. It must be a diagnosed I0001 instead.
//
// This shape reaches the chokepoint via tid_native_struct_mono (which declines for it,
// leaving the erased-slot sentinel), NOT via infer_struct_type_args — verified by probe. The test is a
// guard on the OUTCOME, so it holds whichever producer supplies the Void segment.

test "phantom type param raises I0001 rather than erasing or emitting bare C" {
    let src = "type W[T] \{ n: Int }\nfn main() ! IO \{\n    let w = W \{ n: 5 }\n    assert_eq(w.n, 5)\n}\n"
    compile_test_helpers.expect_compile_error(src, "i0001_phantom_tparam", "I0001")
}

// FLIPPED by br 6cvvh8 — this row used to pin an I0001. Field `a: T` binds T to
// Option[Int], which the STRING speller cannot name (type_name_from_ct has no CT_OPTION
// arm, so the segment erased to "Void"), and the row's premise was that the sibling
// `Inner_Int` slot — a struct INSTANCE — kept the tid-native path deferring, leaving the
// erased string CSV authoritative. 6cvvh8 admitted struct-instance slots to the tid tier,
// so the tid path now answers first and spells BOTH slots.
//
// This is the chokepoint working as designed rather than being weakened: it stops an
// erased name, and the correct response to it firing is to teach a producer to spell the
// slot, never to relax the gate. What replaced the ICE is the whole name, not a partial
// one — so the row asserts the full spelling of both segments and the absence of any
// erased segment, which is what would regress if a producer lost either slot.
test "a struct-instance sibling slot lets the tid tier spell an Option-bound param" {
    let mut s = "type Inner[X] \{ q: X }\n"
    s = s.concat("type W[T, U] \{ a: T, b: U }\n")
    s = s.concat("fn main() \{\n")
    s = s.concat("    let w = W \{ a: Some(1), b: Inner \{ q: 5 } }\n")
    s = s.concat("    assert_eq(w.b.q, 5)\n")
    s = s.concat("}\n")
    let c = compile_test_helpers.compile_and_emit_c(s, "i0001_unspellable_matched")
    // Both slots spelled: the Option-bound param AND the struct-instance sibling. Read
    // structurally, so the row pins the two segments rather than the mangler's joinery.
    let ws = compile_test_helpers.mono_typedef_names(c, "W")
    if ws.len() != 1 { io.println("FAIL: W instances — want 1, got {ws.len()}") }
    assert(ws.len() == 1)
    let w = ws.get(0).unwrap()
    if !w.contains("Option") || !w.contains("int") || !w.contains("Inner") || !w.contains("Int") {
        io.println("FAIL: W mono name '{w}' does not spell both slots")
    }
    assert(w.contains("Option") && w.contains("int"))
    assert(w.contains("Inner") && w.contains("Int"))
    assert(!c.contains("_Void"))
    let r = compile_test_helpers.compile_and_run(s, "i0001_unspellable_matched_run")
    assert_eq(r.exit_code, 0)
}

// ── the SECOND chokepoint: ctor_kops_fail_closed (br farq9f Stage B) ────────
// A different producer, same invariant, full detail in
// tests/test_farq9f_declared_container_ret_pins_ctor.bl. emit_struct_lit's chokepoint
// above catches an erased mono NAME on a generic-struct literal; ctor_kops_fail_closed
// catches an unsolved kops-DECIDING slot (the key for Map, the element for Set) on a
// bare Map()/Set() ctor in TAIL position — the one position with no downstream
// call-arg/insert-site correction to catch a wrong guess. Gated tightly: tail position
// AND the ctor's own memoized tid proves the slot is a genuinely unbound metavar
// (tc_tid_kops_slot_unsolved) — not merely "no tier answered", which would also slander
// a real TK_TYPEVAR or the shared TYPE_UNKNOWN singleton. Before this backstop, both
// shapes below silently registered blink_map_new(&blink_kops_str) instead.

test "a bare generic-typevar return whose body is Map() fails closed with I0001" {
    let mut s = "fn mk[T]() -> T \{ Map() }\n"
    s = s.concat("fn main() \{\n")
    s = s.concat("    let m: Map[Int, Str] = mk()\n")
    s = s.concat("    let _n = m.len()\n")
    s = s.concat("}\n")
    compile_test_helpers.expect_compile_error(s, "i0001_kops_bare_typevar", "I0001")
}

// The closure route to an unpinnable kops slot. This row used to spell the shape
// `let c = fn() \{ Map() }` inside a `-> Map[Int, Str]` fn, i.e. an UN-ANNOTATED closure whose
// Map() tail nothing could pin. That spelling no longer reaches codegen at all: once a closure
// literal gained a real TyKind.Fn tid (br nz7drz), an omitted `-> T` is a Void return — the
// same rule named fns already had — so typecheck now rejects `c()` in a Map-returning tail with
// the ordinary, user-facing
//
//     error[TypeError]: return value type Void does not match function 'a' return type Map[Int, Str]
//
// at the call, byte-identical to what `fn c() \{ Map() }` has always produced. An ICE backstop
// being replaced by the correct diagnostic upstream is the outcome I0001 exists to make
// possible, so the row moves to the closure shape that still gets PAST typecheck: an ANNOTATED
// generic return, where the typevars are real and genuinely unbound at the call site.
test "a closure's generic-typevar Map return fails closed with I0001" {
    let mut s = "fn a[K, V]() -> Int \{\n"
    s = s.concat("    let c = fn() -> Map[K, V] \{ Map() }\n")
    s = s.concat("    let _m = c()\n")
    s = s.concat("    1\n")
    s = s.concat("}\n")
    s = s.concat("fn main() \{ let _x = a() }\n")
    compile_test_helpers.expect_compile_error(s, "i0001_kops_closure_generic_ret", "I0001")
}

// The retired spelling, kept as the pin for WHY it retired: this must stay a plain TypeError
// and must never regress into an ICE or a silent blink_kops_str guess.
test "an un-annotated closure's Map() tail is a TypeError, not an ICE" {
    let mut s = "fn a() -> Map[Int, Str] \{\n"
    s = s.concat("    let c = fn() \{ Map() }\n")
    s = s.concat("    c()\n")
    s = s.concat("}\n")
    s = s.concat("fn main() \{ let _m = a() }\n")
    compile_test_helpers.expect_compile_error(s, "i0001_kops_closure_void_tail", "TypeError")
    compile_test_helpers.expect_no_error(s, "i0001_kops_closure_void_tail_noice", "I0001")
}

// ── no false positives on the shapes that DO lower ──────────────────────────
// Each of these spells every tparam concretely, so I0001 must stay silent. These
// are also the type-IDENTITY guards: the emitted C must contain no erased _Void
// segment, and the annotated/inferred twins must agree on ONE mono name.

test "annotated phantom type param lowers without I0001" {
    let src = "type W[T] \{ n: Int }\nfn main() ! IO \{\n    let w: W[Int] = W \{ n: 5 }\n    assert_eq(w.n, 5)\n}\n"
    compile_test_helpers.expect_no_error(src, "i0001_phantom_annotated", "I0001")
}

test "bound metavar slot lowers concretely without I0001" {
    let src = "type P[K, V] \{ m: Map[K, V], n: Int }\nfn main() ! IO \{\n    let mut p = P \{ m: Map(), n: 1 }\n    p.m.insert(\"a\", 256)\n    assert_eq(p.m.get(\"a\").unwrap(), 256)\n}\n"
    compile_test_helpers.expect_no_error(src, "i0001_bound_metavar", "I0001")
}

test "compound slot beside a bare-struct slot lowers concretely without I0001" {
    let src = "type Pt \{ x: Int }\ntype W[T, U] \{ a: T, b: U }\nfn main() ! IO \{\n    let w = W \{ a: Some(1), b: Pt \{ x: 4 } }\n    assert_eq(w.b.x, 4)\n}\n"
    compile_test_helpers.expect_no_error(src, "i0001_compound_and_bare_struct", "I0001")
}

// ── the emitted C carries no erased segment (the SOUND erasure metric) ───────
// Grep the emitted C for _Void, per CLAUDE.md. This is the SOUND metric and now the
// only one: the csvresolve trace channel is retired (the string resolver it tapped is
// deleted), and it was never a substitute anyway — an erased GSet_Void could be emitted
// with ZERO csvresolve hits, because a producer's "Void" initializer never routed
// through the tapped return.

test "inferred and annotated twins share one non-erased mono name" {
    let src = "type P[K, V] \{ m: Map[K, V], n: Int }\nfn main() ! IO \{\n    let mut p = P \{ m: Map(), n: 1 }\n    p.m.insert(\"a\", 256)\n    let q: P[Str, Int] = P \{ m: Map(), n: 2 }\n    assert_eq(p.m.get(\"a\").unwrap(), 256)\n    assert_eq(q.n, 2)\n}\n"
    let c_src = compile_test_helpers.compile_and_emit_c(src, "i0001_twin_mono_name")
    // ONE instance shared by both twins, spelling both args — read structurally so the
    // row survives a mangling-scheme change.
    let ps = compile_test_helpers.mono_typedef_names(c_src, "P")
    if ps.len() != 1 || !ps.get(0).unwrap().contains("Str") || !ps.get(0).unwrap().contains("Int") {
        io.println("FAIL: twins spell one P[Str, Int] instance — got {ps.len()}")
    }
    assert(ps.len() == 1)
    assert(ps.get(0).unwrap().contains("Str") && ps.get(0).unwrap().contains("Int"))
    if c_src.contains("_Void") {
        io.println("FAIL: emitted C contains an erased _Void segment")
    }
    assert(!c_src.contains("_Void"))
}

test "bare-struct slot spells the struct name, not Void" {
    let src = "type Pt \{ x: Int }\ntype W[T, U] \{ a: T, b: U }\nfn main() ! IO \{\n    let w = W \{ a: Some(1), b: Pt \{ x: 4 } }\n    assert_eq(w.b.x, 4)\n}\n"
    let c_src = compile_test_helpers.compile_and_emit_c(src, "i0001_bare_struct_seg")
    let ws = compile_test_helpers.mono_typedef_names(c_src, "W")
    if ws.len() != 1 || !ws.get(0).unwrap().contains("Option") || !ws.get(0).unwrap().contains("Pt") {
        io.println("FAIL: bare struct slot spells Pt — got {ws.len()}")
    }
    assert(ws.len() == 1)
    assert(ws.get(0).unwrap().contains("Option") && ws.get(0).unwrap().contains("Pt"))
    if c_src.contains("_Void") {
        io.println("FAIL: emitted C contains an erased _Void segment")
    }
    assert(!c_src.contains("_Void"))
}

// ── the code is in the catalog and `blink explain I0001` works ──────────────

test "blink explain I0001 returns the catalog entry" {
    compile_test_helpers.verify_catalog_entry("I0001", "UnsolvedTypeVarAtCodegen")
}
