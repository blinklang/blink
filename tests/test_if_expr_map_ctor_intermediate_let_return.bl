import compile_test_helpers.{compile_and_run}

// An if-expression whose branches are both bare Map() constructors, assigned to an
// un-annotated intermediate let and then returned by name, must still pin the map's
// key/value element kops from the enclosing fn's declared return type — same as a
// direct tail-position Map() literal does.

test "if-expr Map() branches merged into an un-annotated let still pin Int keys via the declared return type" {
    let src = #"
fn pick_map(c: Int) -> Map[Int, Str] {
    let p = if c > 0 { Map() } else { Map() }
    p
}
fn main() ! IO {
    let mut m = pick_map(1)
    m.insert(256, "lo")
    m.insert(512, "hi")
    io.println("{m.len()}")
}
"#
    let r = compile_and_run(src, "_if_expr_map_ctor_intermediate_let_return")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "2\n")
}
