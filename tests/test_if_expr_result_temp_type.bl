// An if-expression whose branches both evaluate to a Result[T, E] value (via
// calls or via bare Ok/Err literals) must forward-declare its result temp with
// the real Result[T, E] carrier type, not a blink_Result_void_void stub that
// is never even emitted.

import compile_test_helpers.{compile_and_run}

test "an if-expr whose both arms are Result-typed forward-declares the real carrier, not Result of void void" {
    let src = #"
import std.io

fn classify(n: Int) -> Result[Int, Str] {
    if n > 0 { Ok(n) } else { Err("neg") }
}

fn via_calls(n: Int) -> Bool {
    let r = if true { classify(n) } else { classify(-1) }
    r.is_ok()
}

fn via_literals(n: Int) -> Bool {
    let r = if n > 0 { Ok(n) } else { Err("neg") }
    r.is_ok()
}

fn main() ! IO {
    io.println("calls={via_calls(5)} literals={via_literals(5)} literals_neg={via_literals(-1)}")
}
"#
    let r = compile_and_run(src, "_if_expr_result_temp_type")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "calls=true literals=true literals_neg=false\n")
}
