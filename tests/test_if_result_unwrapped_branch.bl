// Regression for k849am (repro B): an if/match-expr where both branches reduce to a
// plain `Bytes` value — one via `read_one()?` (the `?` unwraps the Ok type and
// propagates Err, so the branch value is `Bytes`, not `Result[Bytes, Str]`), the other
// a bare `Bytes.new()` — was typed as the *enclosing fn's* full return type
// `Result[(Int, Bytes), Str]` instead of `Bytes`. The temp was mis-declared and the
// init `long int = blink_Result_...` produced incompatible-type C. `blink check`
// passed; only `blink build`/`blink test` surfaced the broken C.
//
// Found in libs/pg's read_frame wire layer.

fn read_one() -> Result[Bytes, Str] {
    Ok(Bytes.new())
}

fn read_pair_if(want: Int) -> Result[(Int, Bytes), Str] {
    let payload = if want > 0 {
        read_one()?
    } else {
        Bytes.new()
    }
    Ok((1, payload))
}

fn read_pair_match(want: Int) -> Result[(Int, Bytes), Str] {
    let payload = match want {
        0 => Bytes.new()
        _ => read_one()?
    }
    Ok((1, payload))
}

test "if-expr both branches Bytes (one via ?) inside Result-returning fn" {
    let (n, b) = read_pair_if(1).unwrap()
    assert_eq(n, 1)
    assert_eq(b.len(), 0)

    let (n2, b2) = read_pair_if(0).unwrap()
    assert_eq(n2, 1)
    assert_eq(b2.len(), 0)
}

test "match-expr both branches Bytes (one via ?) inside Result-returning fn" {
    let (n, b) = read_pair_match(1).unwrap()
    assert_eq(n, 1)
    assert_eq(b.len(), 0)

    let (n2, b2) = read_pair_match(0).unwrap()
    assert_eq(n2, 1)
    assert_eq(b2.len(), 0)
}
