// An assignment RHS if-expr where one arm diverges via `return` should still
// compile: the non-diverging arm's return-only tparam pins from the
// assignment target's current type, and the diverging arm's return-only
// tparam pins from the enclosing fn's declared return type. Today the whole
// compile fails loud with an internal compiler error instead.
//
// This is distinct from test_ifarm_tail_ret_only_pins_from_declared.bl's
// "a diverging return arm is not pinned from the assignment target" test,
// which only pins down that the diverging arm must NOT be wrongly monomorphized
// from the assignment target (the miscompile-safety net) -- it does not require
// the surrounding program to actually compile and run.

import compile_test_helpers.{compile_and_run}

test.failing(
    "an if-assignment RHS with a diverging return arm compiles and runs",
    reason: "tc_ifmatch_arms_all_ret_mint declines the whole see-through when any arm diverges via Return, leaving the non-diverging arm's return-only tparam unpinned, and the Assignment pin site never tc_check_body's the RHS, so the diverging arm's return-only tparam is never pinned from the fn's declared return type either -- both tparams reach codegen unsolved and raise UnsolvedTypeVarAtCodegen (I0001)",
) {
    let src = #"
import std.io

type RGT[T] { s: Set[T] }
fn mk[T]() -> RGT[T] { RGT { s: Set() } }
fn mkret[T]() -> RGT[T] { RGT { s: Set() } }
fn mkint() -> RGT[Int] { RGT { s: Set() } }

fn f(c: Bool) -> RGT[Str] {
    let mut e = mkint()
    e = if c { mk() } else { return mkret() }
    e.s.insert(7)
    mkret()
}

fn main() ! IO {
    let r = f(true)
    io.println("{r.s.len()}")
}
"#
    let r = compile_and_run(src, "_ifarm_diverging_return_pins_nondiverging_arm")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "0\n")
}
