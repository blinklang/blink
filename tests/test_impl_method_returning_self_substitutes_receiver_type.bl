import compile_test_helpers.{compile_and_run}

// An impl method declared `-> Self` must resolve to the concrete receiver type at
// the call site, both for a user struct receiver and for a builtin-type receiver.

test.failing(
    "an impl method declared -> Self on a user struct resolves to the receiver type at the call site",
    reason: "the call result of an impl method declared -> Self keeps the Self type variable instead of the receiver type, so codegen stops with ICE LayoutDeclined",
) {
    let src = #"
trait Cloner { fn dup(self) -> Self }
type Foo { x: Int }
impl Cloner for Foo { fn dup(self) -> Self { Foo { x: self.x } } }
fn main() ! IO {
    let f = Foo { x: 3 }
    let g = f.dup()
    io.println("{g.x}")
}
"#
    let r = compile_and_run(src, "_impl_self_struct_receiver")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "3\n")
}

test.failing(
    "an impl method declared -> Self on a builtin-type receiver resolves to the receiver type at the call site",
    reason: "the method call on an Int receiver now dispatches, but its result keeps the Self type variable instead of Int, so codegen stops with ICE LayoutDeclined",
) {
    let src = #"
trait Dup { fn dup(self) -> Self }
impl Dup for Int { fn dup(self) -> Self { self } }
fn main() ! IO {
    let x = 3.dup()
    io.println("{x + 1}")
}
"#
    let r = compile_and_run(src, "_impl_self_builtin_receiver")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "4\n")
}
