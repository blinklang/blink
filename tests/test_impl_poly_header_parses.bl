// cd7zvd -- `impl[T] Trait[T] for Recv[T]` must PARSE and expose the binder
// list and receiver type-args on the AST (spec §3.6 canonical binding form).
// Compiling such impls is rejected separately (E0908, project b1bdnh); this
// test only covers the parser + AST surface via `blink ast` JSON dump.

fn main() {
    let blink_root = process_run("sh", ["-c", "pwd -P"]).out.trim_right()

    let base = ".tmp/_test_impl_poly_header"
    shell_exec("rm -rf {base}")
    shell_exec("mkdir -p {base}")

    let src = "pub trait Bound \{\n    fn bnd(self) -> Int\n\}\n\npub trait MyTrait[T] \{\n    fn op(self, x: T) -> Int\n\}\n\ntype Box[V] \{ value: V \}\n\nimpl[T: Bound] MyTrait[T] for Box[T] \{\n    fn op(self, _x: T) -> Int \{ 0 \}\n\}\n"
    write_file("{base}/poly.bl", src)

    let cmd = "cd {base} && {blink_root}/build/blink ast poly.bl 2>&1"
    let result = process_run("sh", ["-c", cmd])

    if result.exit_code != 0 {
        io.println("FAIL: impl[T: Bound] MyTrait[T] for Box[T] should parse, got exit {result.exit_code}")
        io.println("got: {result.out}")
        shell_exec("rm -rf {base}")
        return
    }
    if !result.out.contains("\"impl_binders\"") {
        io.println("FAIL: AST dump missing 'impl_binders' sublist on ImplBlock")
        shell_exec("rm -rf {base}")
        return
    }
    if !result.out.contains("\"recv_type_args\"") {
        io.println("FAIL: AST dump missing 'recv_type_args' sublist on ImplBlock")
        shell_exec("rm -rf {base}")
        return
    }
    if !result.out.contains("\"TypeParam\"") {
        io.println("FAIL: impl_binders should contain TypeParam nodes")
        shell_exec("rm -rf {base}")
        return
    }
    if !result.out.contains("\"Bound\"") {
        io.println("FAIL: binder bound 'Bound' should appear in the AST dump")
        shell_exec("rm -rf {base}")
        return
    }

    // Binders-without-recv-args and recv-args-without-binders must each
    // parse on their own as well.
    let src2 = "pub trait Tr0 \{\n    fn op(self) -> Int\n\}\n\ntype Holder \{ value: Int \}\ntype Box[V] \{ value: V \}\n\nimpl[T] Tr0 for Holder \{\n    fn op(self) -> Int \{ 0 \}\n\}\n\nimpl Tr0 for Box[Int] \{\n    fn op(self) -> Int \{ 1 \}\n\}\n"
    write_file("{base}/poly2.bl", src2)
    let cmd2 = "cd {base} && {blink_root}/build/blink ast poly2.bl 2>&1"
    let result2 = process_run("sh", ["-c", cmd2])
    if result2.exit_code != 0 {
        io.println("FAIL: standalone binder / recv-arg forms should parse, got exit {result2.exit_code}")
        io.println("got: {result2.out}")
        shell_exec("rm -rf {base}")
        return
    }
    if !result2.out.contains("\"impl_binders\"") || !result2.out.contains("\"recv_type_args\"") {
        io.println("FAIL: standalone forms should expose impl_binders / recv_type_args")
        shell_exec("rm -rf {base}")
        return
    }

    io.println("PASS: polymorphic impl headers parse and expose binders + receiver type args")
    shell_exec("rm -rf {base}")
}
