// cd7zvd -- polymorphic impl headers parse but are not yet compiled
// (project b1bdnh). Typecheck must reject all three forms with E0908
// before codegen so nothing miscompiles:
//   1. impl[T] Trait[T] for Concrete     (binders)
//   2. impl Trait for Box[Int]           (receiver type-args, no binders)
//   3. impl[T] Trait[T] for Box[T]       (combined)

fn check_form(blink_root: Str, base: Str, label: Str, src: Str) -> Int {
    write_file("{base}/mvce.bl", src)
    let cmd = "cd {base} && {blink_root}/build/blink check --json mvce.bl 2>&1"
    let result = process_run("sh", ["-c", cmd])
    if result.exit_code == 0 {
        io.println("FAIL: {label} should be rejected, but check exited 0")
        return 1
    }
    if !result.out.contains("\"code\":\"E0908\"") {
        io.println("FAIL: {label} should report E0908 (polymorphic impls not yet compiled)")
        io.println("got: {result.out}")
        return 1
    }
    0
}

fn main() {
    let blink_root = process_run("sh", ["-c", "pwd -P"]).out.trim_right()

    let base = ".tmp/_test_impl_poly_unsupported"
    shell_exec("rm -rf {base}")
    shell_exec("mkdir -p {base}")
    write_file("{base}/blink.toml", "[package]\nname = \"ipu\"\nversion = \"0.1.0\"\n\n[dependencies]\n")

    let src1 = "pub trait MyTrait[T] \{\n    fn op(self, x: T) -> Int\n\}\n\ntype Holder \{ value: Int \}\n\nimpl[T] MyTrait[T] for Holder \{\n    fn op(self, _x: T) -> Int \{ self.value \}\n\}\n\nfn main() \{\n    io.println(\"unreachable\")\n\}\n"
    if check_form(blink_root, base, "impl[T] MyTrait[T] for Holder", src1) != 0 {
        shell_exec("rm -rf {base}")
        return
    }

    let src2 = "pub trait Tr0 \{\n    fn op(self) -> Int\n\}\n\ntype Box[V] \{ value: V \}\n\nimpl Tr0 for Box[Int] \{\n    fn op(self) -> Int \{ 1 \}\n\}\n\nfn main() \{\n    io.println(\"unreachable\")\n\}\n"
    if check_form(blink_root, base, "impl Tr0 for Box[Int]", src2) != 0 {
        shell_exec("rm -rf {base}")
        return
    }

    let src3 = "pub trait MyTrait[T] \{\n    fn op(self, x: T) -> Int\n\}\n\ntype Box[V] \{ value: V \}\n\nimpl[T] MyTrait[T] for Box[T] \{\n    fn op(self, _x: T) -> Int \{ 0 \}\n\}\n\nfn main() \{\n    io.println(\"unreachable\")\n\}\n"
    if check_form(blink_root, base, "impl[T] MyTrait[T] for Box[T]", src3) != 0 {
        shell_exec("rm -rf {base}")
        return
    }

    io.println("PASS: all three polymorphic impl forms rejected with E0908")
    shell_exec("rm -rf {base}")
}
