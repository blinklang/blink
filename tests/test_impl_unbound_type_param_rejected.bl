// bpf7tq -- `impl Trait[T] for U` with T unbound must be rejected at typecheck
// rather than silently lowering T to `void` in the emitted C. Spec §3.6 defines
// the canonical binding form as `impl[T] Trait[T] for U`, which is not yet
// implemented (tracked under project b1bdnh). Until then, any unbound name in
// an impl's trait_type_args is malformed.

fn main() {
    let blink_root = process_run("sh", ["-c", "pwd -P"]).out.trim_right()

    let base = ".tmp/_test_impl_unbound_tparam"
    shell_exec("rm -rf {base}")
    shell_exec("mkdir -p {base}")
    write_file("{base}/blink.toml", "[package]\nname = \"iutp\"\nversion = \"0.1.0\"\n\n[dependencies]\n")

    let src = "pub trait MyTrait[T] \{\n    fn op(self, x: T) -> Int\n\}\n\ntype Holder \{ value: Int \}\n\nimpl MyTrait[T] for Holder \{\n    fn op(self, _x: T) -> Int \{ self.value \}\n\}\n\nfn main() \{\n    let h = Holder \{ value: 42 \}\n    let _r = h.op(\"hello\")\n    io.println(\"unreachable\")\n\}\n"
    write_file("{base}/mvce.bl", src)

    let cmd = "cd {base} && {blink_root}/build/blink check mvce.bl 2>&1"
    let result = process_run("sh", ["-c", cmd])

    if result.exit_code == 0 {
        io.println("FAIL: impl MyTrait[T] for Holder should be rejected, but check exited 0")
        shell_exec("rm -rf {base}")
        return
    }
    if !result.out.contains("UnknownType") && !result.out.contains("unknown type") {
        io.println("FAIL: expected UnknownType diagnostic for unbound 'T' in impl header")
        io.println("got: {result.out}")
        shell_exec("rm -rf {base}")
        return
    }
    if !result.out.contains("'T'") && !result.out.contains("`T`") {
        io.println("FAIL: diagnostic should name the offending type 'T'")
        io.println("got: {result.out}")
        shell_exec("rm -rf {base}")
        return
    }

    io.println("PASS: impl Trait[T] with unbound T is rejected with UnknownType")
    shell_exec("rm -rf {base}")
}
