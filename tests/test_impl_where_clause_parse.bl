// impl `where`-clause parse + store:
//   `impl[T] Tr for Box[T] where T: Bound { ... }` must PARSE. Before this
//   ticket, the trailing `where` produced E1100 (expected {, got IDENT).
//   Scope is parse-only, so we assert on `check --json` diagnostics rather
//   than compiling/running. A passing parse means E1100 is absent.

import compile_test_helpers

fn main() {
    let blink_root = process.run("sh", ["-c", "pwd -P"]).unwrap().out.trim_right()

    let base = "{compile_test_helpers.scratch_root()}/_test_impl_where_clause_parse"
    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
    process.run("sh", ["-c", "mkdir -p {base}"]).unwrap()
    fs.write("{base}/blink.toml", "[package]\nname = \"iwcp\"\nversion = \"0.1.0\"\n\n[dependencies]\n").unwrap()

    // Case 1: single bound -> must NOT report a parse error (E1100).
    let src1 = "pub trait Tr0 \{\n    fn op(self) -> Int\n\}\n\ntype Box[V] \{ value: V \}\n\nimpl[T] Tr0 for Box[T] where T: Tr0 \{\n    fn op(self) -> Int \{ 0 \}\n\}\n\nfn main() \{\n    io.println(\"unreachable\")\n\}\n"
    fs.write("{base}/mvce1.bl", src1).unwrap()
    let cmd1 = "cd {base} && {blink_root}/build/blink check --json mvce1.bl 2>&1"
    let result1 = process.run("sh", ["-c", cmd1]).unwrap()
    if result1.out.contains("\"code\":\"E1100\"") {
        io.println("FAIL: where-clause should parse, but got E1100 (parse error)")
        io.println("got: {result1.out}")
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        return
    }

    // Case 2: multiple binders, multiple comma-separated constraints, and a
    // `+`-combined bound list -> still parses (no E1100).
    let src2 = "pub trait A \{\n    fn a(self) -> Int\n\}\n\npub trait B \{\n    fn b(self) -> Int\n\}\n\ntype Pair[X, Y] \{ x: X, y: Y \}\n\nimpl[X, Y] A for Pair[X, Y] where X: A + B, Y: A \{\n    fn a(self) -> Int \{ 0 \}\n\}\n\nfn main() \{\n    io.println(\"unreachable\")\n\}\n"
    fs.write("{base}/mvce2.bl", src2).unwrap()
    let cmd2 = "cd {base} && {blink_root}/build/blink check --json mvce2.bl 2>&1"
    let result2 = process.run("sh", ["-c", cmd2]).unwrap()
    if result2.out.contains("\"code\":\"E1100\"") {
        io.println("FAIL: multi-bound where-clause should parse, but got E1100 (parse error)")
        io.println("got: {result2.out}")
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        return
    }

    io.println("PASS: impl where-clause parses (single + multi-bound, no E1100)")
    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
}
