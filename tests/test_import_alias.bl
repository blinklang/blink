import compile_test_helpers

fn run_cmd(cmd: Str, label: Str) -> Bool ! Process.Spawn, IO.Print {
    let r = process.run("sh", ["-c", cmd]).unwrap()
    if !r.success() {
        io.println("FAIL: {label} ({r.end})")
        io.println("{r.out}{r.err_out}")
    }
    r.success()
}

fn check_output(path: Str, expected: Str, label: Str) ! Process.Spawn, FS.Read, IO {
    process.run("sh", ["-c", "{path} > {path}_out.txt 2>&1 || true"]).unwrap()
    let output = fs.read("{path}_out.txt").unwrap()
    if output.starts_with(expected) {
        io.println("PASS: {label}")
    } else {
        io.println("FAIL: {label} — expected '{expected}', got: {output}")
    }
}

fn main() {
    let base = "{compile_test_helpers.scratch_root()}/_test_import_alias"
    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
    let pact = "{env.cwd()}/build/blink"

    process.run("sh", ["-c", "mkdir -p {base}/mylib/src"]).unwrap()
    fs.write("{base}/mylib/blink.toml", "[package]\nname = \"mylib\"\nversion = \"0.1.0\"\n").unwrap()
    fs.write(
        "{base}/mylib/src/mylib.bl",
        "pub fn add(a: Int, b: Int) -> Int \{\n    a + b\n}\n\npub fn multiply(a: Int, b: Int) -> Int \{\n    a * b\n}\n"
    ).unwrap()

    process.run("sh", ["-c", "mkdir -p {base}/app/src"]).unwrap()
    fs.write(
        "{base}/app/blink.toml",
        "[package]\nname = \"app\"\nversion = \"1.0.0\"\n\n[dependencies]\nmylib = \{ path = \"../mylib\" }\n"
    ).unwrap()

    // Test 1: Alias works — add imported as plus
    fs.write(
        "{base}/app/src/t1.bl",
        "import mylib.\{add as plus\}\n\nfn main() \{\n    io.println(\"\{plus(2, 3)\}\")\n}\n"
    ).unwrap()
    let ok1 = run_cmd("cd {base}/app && {pact} build src/t1.bl -o build/t1 2>&1", "build alias")
    if !ok1 {
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        return
    }
    check_output("{base}/app/build/t1", "5", "alias: plus works")

    // Test 2: Original name rejected when aliased
    fs.write(
        "{base}/app/src/t2.bl",
        "import mylib.\{add as plus\}\n\nfn main() \{\n    io.println(\"\{add(2, 3)\}\")\n}\n"
    ).unwrap()
    process.run("sh", ["-c", "mkdir -p {base}/app/build"]).unwrap()
    let ok2 = process.run("sh", ["-c", "cd {base}/app && {pact} build src/t2.bl -o build/t2 > ../err2.txt 2>&1"]).unwrap().success()
    if ok2 {
        io.println("FAIL: original name should be rejected when aliased")
    } else {
        let err = fs.read("{base}/err2.txt").unwrap()
        if err.contains("add") {
            io.println("PASS: original name rejected when aliased")
        } else {
            io.println("FAIL: expected error about add, got: {err}")
        }
    }

    // Test 3: Alias + selective — alias and non-aliased together
    fs.write(
        "{base}/app/src/t3.bl",
        "import mylib.\{add as plus, multiply\}\n\nfn main() \{\n    io.println(\"\{plus(2, 3)\}\")\n    io.println(\"\{multiply(4, 5)\}\")\n}\n"
    ).unwrap()
    let ok3 = run_cmd("cd {base}/app && {pact} build src/t3.bl -o build/t3 2>&1", "build alias+selective")
    if !ok3 {
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        return
    }
    check_output("{base}/app/build/t3", "5", "alias+selective: both work")

    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
}
