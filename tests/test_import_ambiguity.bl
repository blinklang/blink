import compile_test_helpers

fn run_cmd(cmd: Str, label: Str) -> Bool ! Process.Spawn, IO.Print {
    let r = process.run("sh", ["-c", cmd]).unwrap()
    if !r.success() {
        io.println("FAIL: {label} ({r.end})")
        io.println("{r.out}{r.err_out}")
    }
    r.success()
}

fn check_output(path: Str, expected: Str, label: Str) ! Process.Spawn, FS.Read, IO {
    process.run("sh", ["-c", "{path} > {path}_out.txt 2>&1 || true"]).unwrap()
    let output = fs.read("{path}_out.txt").unwrap()
    if output.starts_with(expected) {
        io.println("PASS: {label}")
    } else {
        io.println("FAIL: {label} — expected '{expected}', got: {output}")
    }
}

fn main() {
    let base = "{compile_test_helpers.scratch_root()}/_test_import_ambiguity"
    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
    let pact = "{env.cwd()}/build/blink"

    // Create two libs with same pub fn name
    process.run("sh", ["-c", "mkdir -p {base}/liba/src"]).unwrap()
    fs.write("{base}/liba/blink.toml", "[package]\nname = \"liba\"\nversion = \"0.1.0\"\n").unwrap()
    fs.write("{base}/liba/src/liba.bl", "pub fn process(x: Int) -> Int \{\n    x + 1\n}\n\npub fn only_a() -> Int \{\n    42\n}\n").unwrap()

    process.run("sh", ["-c", "mkdir -p {base}/libb/src"]).unwrap()
    fs.write("{base}/libb/blink.toml", "[package]\nname = \"libb\"\nversion = \"0.1.0\"\n").unwrap()
    fs.write("{base}/libb/src/libb.bl", "pub fn process(x: Int) -> Int \{\n    x * 2\n}\n\npub fn only_b() -> Int \{\n    99\n}\n").unwrap()

    process.run("sh", ["-c", "mkdir -p {base}/app/src"]).unwrap()
    fs.write(
        "{base}/app/blink.toml",
        "[package]\nname = \"app\"\nversion = \"1.0.0\"\n\n[dependencies]\nliba = \{ path = \"../liba\" }\nlibb = \{ path = \"../libb\" }\n"
    ).unwrap()

    // Test 1: Two imports with same name — E1005 error
    fs.write(
        "{base}/app/src/t1.bl",
        "import liba.\{process\}\nimport libb.\{process\}\n\nfn main() \{\n    io.println(\"\{process(5)\}\")\n}\n"
    ).unwrap()
    process.run("sh", ["-c", "mkdir -p {base}/app/build"]).unwrap()
    let ok1 = process.run("sh", ["-c", "cd {base}/app && {pact} build src/t1.bl -o build/t1 > ../err1.txt 2>&1"]).unwrap().success()
    if ok1 {
        io.println("FAIL: ambiguous import should produce error")
    } else {
        let err = fs.read("{base}/err1.txt").unwrap()
        if err.contains("ambiguous") || err.contains("E1005") {
            io.println("PASS: ambiguous import detected")
        } else {
            io.println("FAIL: expected ambiguity error, got: {err}")
        }
    }

    // Test 2: Non-conflicting unique names from single module
    fs.write(
        "{base}/app/src/t2.bl",
        "import liba.\{only_a\}\n\nfn main() \{\n    io.println(\"\{only_a()\}\")\n}\n"
    ).unwrap()
    let ok2 = run_cmd("cd {base}/app && {pact} build src/t2.bl -o build/t2 2>&1", "build single module non-conflicting")
    if !ok2 {
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        return
    }
    check_output("{base}/app/build/t2", "42", "single module non-conflicting import")

    // Test 3: Two modules with NO conflicting names — no ambiguity
    process.run("sh", ["-c", "mkdir -p {base}/libc/src"]).unwrap()
    fs.write("{base}/libc/blink.toml", "[package]\nname = \"libc\"\nversion = \"0.1.0\"\n").unwrap()
    fs.write("{base}/libc/src/libc.bl", "pub fn greet() -> Int \{\n    100\n}\n").unwrap()
    process.run("sh", ["-c", "mkdir -p {base}/libd/src"]).unwrap()
    fs.write("{base}/libd/blink.toml", "[package]\nname = \"libd\"\nversion = \"0.1.0\"\n").unwrap()
    fs.write("{base}/libd/src/libd.bl", "pub fn farewell() -> Int \{\n    200\n}\n").unwrap()
    fs.write(
        "{base}/app/blink.toml",
        "[package]\nname = \"app\"\nversion = \"1.0.0\"\n\n[dependencies]\nlibc = \{ path = \"../libc\" }\nlibd = \{ path = \"../libd\" }\n"
    ).unwrap()
    fs.write(
        "{base}/app/src/t3.bl",
        "import libc.\{greet\}\nimport libd.\{farewell\}\n\nfn main() \{\n    io.println(\"\{greet() + farewell()\}\")\n}\n"
    ).unwrap()
    let ok3 = run_cmd("cd {base}/app && {pact} build src/t3.bl -o build/t3 2>&1", "build two modules no conflict")
    if !ok3 {
        process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
        return
    }
    check_output("{base}/app/build/t3", "300", "two modules no conflicting names")

    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
}
