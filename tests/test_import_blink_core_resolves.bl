// Spec §07:1601 + §07:1659 — `import blink.core` resolves as a recognized inert
// no-op. §07:1601 tells users to `import blink.core` for `ConversionError` when
// implementing `TryFrom` manually; that import previously errored ModuleNotFound.
// `ConversionError` itself is prelude-visible, so the import is optional, but it
// must RESOLVE.
//
// Decision: decisions/ffi-import-namespace-resolution.md (6-0, q0brkj).

import blink.core.{ConversionError}

type Percent { value: Int }

impl TryFrom[Int] for Percent {
    fn try_from(value: Int) -> Result[Percent, ConversionError] {
        if value < 0 {
            Err(ConversionError { message: "negative percentage", source_type: "Int", target_type: "Percent" })
        } else {
            Ok(Percent { value: value })
        }
    }
}

fn main() {
    match Percent.try_from(42) {
        Ok(p) => io.println("ok: {p.value}")
        Err(e) => io.println("err: {e.target_type}")
    }
    io.println("blink.core resolved")
}
