// Spec §07:1659 + §9.1.1 — `import blink.ffi` resolves as a recognized inert
// no-op (never ModuleNotFound). The `ffi` namespace is a no-import intrinsic
// like io/net/time; the import is an OPTIONAL documentation marker, so a file
// that both imports it AND uses `@ffi`/`Ptr`/`ffi.scope` compiles and runs.
//
// Decision: decisions/ffi-import-namespace-resolution.md (6-0, q0brkj).
// Regression: `import blink.ffi` previously errored ModuleNotFound.

import blink.ffi

@ffi("labs")
@trusted
fn c_abs(n: Int) -> Int ! FFI { }

@trusted(audit: "test")
fn use_ptr() ! FFI {
    with ffi.scope() as scope {
        let p: Ptr[Int] = scope.alloc()
        p.write(7)
        let _ = p.deref()
    }
}

fn main() {
    io.println("abs(-42) = {c_abs(-42)}")
    use_ptr()
    io.println("ffi import resolved")
}
