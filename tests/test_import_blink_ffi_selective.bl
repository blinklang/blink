// Spec §9.1.1 — selective import of compiler-known FFI names resolves as a
// satisfiable no-op. `Ptr`, `Void`, `alloc_ptr`, `null_ptr` are compiler-known
// (types + intrinsic free fns), not file symbols, so the selective import is
// accepted and never reports "not exported".
//
// Decision: decisions/ffi-import-namespace-resolution.md (6-0, q0brkj).

import blink.ffi.{Ptr, Void, alloc_ptr}

@ffi("labs")
@trusted
fn c_abs(n: Int) -> Int ! FFI { }

@trusted(audit: "test")
fn use_selected() ! FFI {
    with ffi.scope() as scope {
        let p: Ptr[Void] = scope.alloc()
        let _ = p.is_null()
    }
}

fn main() {
    io.println("abs(-1) = {c_abs(-1)}")
    use_selected()
    io.println("selective blink.ffi resolved")
}
