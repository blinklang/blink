// The edit that lets a file call a function of a module through its qualifier: a new
// `import module` line. It goes where a new selective import line goes: after the last import,
// or, in a file with no import, before the first code line, below a header comment and above
// a doc comment. A selective import of the module is not merged into, since a list does not
// hold the whole module.

import import_edit.{import_module_edit}

fn applied(src: Str) -> Str {
    let e = import_module_edit(src.split("\n"), "std.random")
    let lines = src.split("\n")
    let mut out: List[Str] = []
    let mut i = 0
    while i < lines.len() {
        let line = lines.get(i).unwrap()
        if i + 1 == e.line {
            out.push(line.byte_slice(0, e.col - 1).concat(e.text).concat(line.byte_slice(e.end_col - 1, line.byte_len())))
        } else {
            out.push(line)
        }
        i = i + 1
    }
    out.join("\n")
}

test "with no import, the line goes before the first code line, below a header comment" {
    assert_eq(applied("fn main() \{}\n"), "import std.random\n\nfn main() \{}\n")
    assert_eq(applied("// Cards.\n\nfn main() \{}\n"), "// Cards.\n\nimport std.random\n\nfn main() \{}\n")
    assert_eq(applied("/// Deals.\nfn deal() \{}\n"), "import std.random\n\n/// Deals.\nfn deal() \{}\n")
}

test "a new line goes after the last import, even one that runs over lines" {
    assert_eq(applied("import std.fs\n\nfn main() \{}\n"), "import std.fs\nimport std.random\n\nfn main() \{}\n")
    assert_eq(applied("import std.process.\{\n    ChildEnd,\n}\nfn main() \{}\n"), "import std.process.\{\n    ChildEnd,\n}\nimport std.random\nfn main() \{}\n")
}

test "a selective import of the module gets a new line, not a merge" {
    assert_eq(applied("import std.random.\{choice}\n\nfn main() \{}\n"), "import std.random.\{choice}\nimport std.random\n\nfn main() \{}\n")
}

test "a comment in an import does not change where the line goes" {
    assert_eq(applied("import std.fs // \{\nfn main() \{}\n"), "import std.fs // \{\nimport std.random\nfn main() \{}\n")
}
