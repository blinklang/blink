// The edit that lets a file call a name from a module by its bare name. A one-line selective
// import of the module gets the name added to its list. Otherwise a new import line goes after
// the last import, or, in a file with no import, before the first code line, below a header
// comment and above a doc comment. A name the file already imports needs no edit, and a name
// the file imports under an alias gets none.

import import_edit.{ImportEdit, ImportNeed, import_need}

fn need(src: Str) -> ImportNeed {
    import_need(src.split("\n"), "std.random", "shuffle")
}

fn applied(src: Str) -> Str {
    match need(src) {
        ImportNeed.Add(e) => {
            let lines = src.split("\n")
            let mut out: List[Str] = []
            let mut i = 0
            while i < lines.len() {
                let line = lines.get(i).unwrap()
                if i + 1 == e.line {
                    out.push(line.byte_slice(0, e.col - 1).concat(e.text).concat(line.byte_slice(e.end_col - 1, line.byte_len())))
                } else {
                    out.push(line)
                }
                i = i + 1
            }
            out.join("\n")
        }
        ImportNeed.Present => "present"
        ImportNeed.Blocked => "blocked"
    }
}

test "a one-line selective import of the module gets the name added to its list" {
    assert_eq(applied("import std.random.\{choice}\n\nfn main() \{}\n"), "import std.random.\{choice, shuffle}\n\nfn main() \{}\n")
    assert_eq(applied("import std.random.\{ choice }\n"), "import std.random.\{ choice, shuffle }\n")
    assert_eq(applied("import std.random.\{choice,}\n"), "import std.random.\{choice, shuffle}\n")
    assert_eq(applied("import std.random.\{}\n"), "import std.random.\{shuffle}\n")
    assert_eq(applied("pub import std.random.\{choice}\n"), "pub import std.random.\{choice, shuffle}\n")
}

test "the edit is an insertion with 1-based byte columns" {
    match need("import std.random.\{choice}\n") {
        ImportNeed.Add(e) => assert_eq(e, ImportEdit { line: 1, col: 26, end_line: 1, end_col: 26, text: ", shuffle" })
        _ => assert(false, "want an edit")
    }
}

test "with no selective import of the module, a new line goes after the last import" {
    assert_eq(applied("import std.fs\nimport std.random\n\nfn main() \{}\n"), "import std.fs\nimport std.random\nimport std.random.\{shuffle}\n\nfn main() \{}\n")
    assert_eq(applied("import std.process.\{\n    ChildEnd,\n}\nfn main() \{}\n"), "import std.process.\{\n    ChildEnd,\n}\nimport std.random.\{shuffle}\nfn main() \{}\n")
}

test "a selective import of the module that runs over lines gets a new line, not a merge" {
    assert_eq(applied("import std.random.\{\n    choice,\n}\nfn main() \{}\n"), "import std.random.\{\n    choice,\n}\nimport std.random.\{shuffle}\nfn main() \{}\n")
}

test "with no import, the line goes before the first code line, below a header comment" {
    assert_eq(applied("// Cards.\n\nfn main() \{}\n"), "// Cards.\n\nimport std.random.\{shuffle}\n\nfn main() \{}\n")
    assert_eq(applied("/// Deals.\nfn deal() \{}\n"), "import std.random.\{shuffle}\n\n/// Deals.\nfn deal() \{}\n")
}

test "a name the file imports needs no edit, even in a list that runs over lines" {
    assert_eq(applied("import std.random.\{choice, shuffle}\n"), "present")
    assert_eq(applied("import std.random.\{\n    choice,\n    shuffle,\n}\n"), "present")
}

test "a name the file imports under an alias gets no edit" {
    assert_eq(applied("import std.random.\{shuffle as mix}\n"), "blocked")
}

test "an import of another module that shares the prefix is not merged into" {
    assert_eq(applied("import std.randomx.\{shuffle}\n"), "import std.randomx.\{shuffle}\nimport std.random.\{shuffle}\n")
}
