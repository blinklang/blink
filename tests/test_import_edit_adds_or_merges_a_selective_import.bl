// The edit that lets a file call a name from a module by its bare name. A one-line selective
// import of the module gets the name added to its list. Otherwise a new import line goes after
// the last import, or, in a file with no import, before the first code line, below a header
// comment and above a doc comment. A name the file already imports needs no edit, and a name
// the file binds to another item with `as` gets none. A name the file imports only under an
// alias still gets the edit, as one item may be imported under two names. A `pub
// import` is not merged into, since a fix must not export the name, and a comment in an import
// does not change where the edit goes. Several names get one edit that imports the ones the file
// lacks. The lexer, not the text, says which lines start an import, so a line of a string literal
// that reads as one is no import. A run of blanks, a tab among them, reads as one space, and the
// list of an import that renames the module's qualifier is read too.

import import_edit.{ImportEdit, ImportNeed, import_need}
import lexer.{Lex, lex, token_count, token_at}
import diagnostics.{Diag}
import tokens.{TokenKind}

// The lines on which the lexer starts an import statement, which the callers pass.
fn import_lines(src: Str) -> List[Int] ! Lex.Tokenize, Diag.Report {
    lex(src)
    let mut out: List[Int] = []
    let mut i = 0
    while i < token_count() {
        if token_at(i).kind == TokenKind.Import { out.push(token_at(i).line - 1) }
        i = i + 1
    }
    out
}

fn need(src: Str) -> ImportNeed ! Lex.Tokenize, Diag.Report {
    import_need(src.split("\n"), import_lines(src), "std.random", ["shuffle"])
}

fn applied(src: Str) -> Str ! Lex.Tokenize, Diag.Report {
    applied_names(src, ["shuffle"])
}

fn applied_names(src: Str, names: List[Str]) -> Str ! Lex.Tokenize, Diag.Report {
    match import_need(src.split("\n"), import_lines(src), "std.random", names) {
        ImportNeed.Add(e) => {
            let lines = src.split("\n")
            let mut out: List[Str] = []
            let mut i = 0
            while i < lines.len() {
                let line = lines.get(i).unwrap()
                if i + 1 == e.line {
                    out.push(line.byte_slice(0, e.col - 1).concat(e.text).concat(line.byte_slice(e.end_col - 1, line.byte_len())))
                } else {
                    out.push(line)
                }
                i = i + 1
            }
            out.join("\n")
        }
        ImportNeed.Present => "present"
        ImportNeed.Blocked => "blocked"
    }
}

test "a one-line selective import of the module gets the name added to its list" {
    assert_eq(applied("import std.random.\{choice}\n\nfn main() \{}\n"), "import std.random.\{choice, shuffle}\n\nfn main() \{}\n")
    assert_eq(applied("import std.random.\{ choice }\n"), "import std.random.\{ choice, shuffle }\n")
    assert_eq(applied("import std.random.\{choice,}\n"), "import std.random.\{choice, shuffle}\n")
    assert_eq(applied("import std.random.\{}\n"), "import std.random.\{shuffle}\n")
}

test "a pub import of the module is not merged into, so the fix exports nothing" {
    assert_eq(applied("pub import std.random.\{choice}\n"), "pub import std.random.\{choice}\nimport std.random.\{shuffle}\n")
    assert_eq(applied("pub import std.random.\{shuffle}\n"), "present")
}

test "the edit is an insertion with 1-based byte columns" {
    match need("import std.random.\{choice}\n") {
        ImportNeed.Add(e) => assert_eq(e, ImportEdit { line: 1, col: 26, end_line: 1, end_col: 26, text: ", shuffle" })
        _ => assert(false, "want an edit")
    }
}

test "with no selective import of the module, a new line goes after the last import" {
    assert_eq(applied("import std.fs\nimport std.random\n\nfn main() \{}\n"), "import std.fs\nimport std.random\nimport std.random.\{shuffle}\n\nfn main() \{}\n")
    assert_eq(applied("import std.process.\{\n    ChildEnd,\n}\nfn main() \{}\n"), "import std.process.\{\n    ChildEnd,\n}\nimport std.random.\{shuffle}\nfn main() \{}\n")
}

test "a selective import of the module that runs over lines gets a new line, not a merge" {
    assert_eq(applied("import std.random.\{\n    choice,\n}\nfn main() \{}\n"), "import std.random.\{\n    choice,\n}\nimport std.random.\{shuffle}\nfn main() \{}\n")
}

test "with no import, the line goes before the first code line, below a header comment" {
    assert_eq(applied("// Cards.\n\nfn main() \{}\n"), "// Cards.\n\nimport std.random.\{shuffle}\n\nfn main() \{}\n")
    assert_eq(applied("/// Deals.\nfn deal() \{}\n"), "import std.random.\{shuffle}\n\n/// Deals.\nfn deal() \{}\n")
}

test "a name the file imports needs no edit, even in a list that runs over lines" {
    assert_eq(applied("import std.random.\{choice, shuffle}\n"), "present")
    assert_eq(applied("import std.random.\{\n    choice,\n    shuffle,\n}\n"), "present")
}

test "a name the file imports only under an alias gets its bare name added" {
    assert_eq(applied("import std.random.\{shuffle as mix}\n"), "import std.random.\{shuffle as mix, shuffle}\n")
    assert_eq(applied("import std.random.\{shuffle as shuffle}\n"), "present")
}

test "a name that `as` binds to another item gets no edit" {
    assert_eq(applied("import std.random.\{choice as shuffle}\n"), "blocked")
    assert_eq(applied("import std.random.\{\n    choice as shuffle,\n}\n"), "blocked")
}

test "a brace or a name in a comment does not change the edit" {
    assert_eq(applied("import std.random.\{\n    // keep \{sorted}\n    choice,\n}\nfn main() \{}\n"), "import std.random.\{\n    // keep \{sorted}\n    choice,\n}\nimport std.random.\{shuffle}\nfn main() \{}\n")
    assert_eq(applied("import std.random.\{\n    shuffle // mix\n}\n"), "present")
    assert_eq(applied("import std.fs // \{\nfn main() \{}\n"), "import std.fs // \{\nimport std.random.\{shuffle}\nfn main() \{}\n")
    assert_eq(applied("import std.random.\{choice} // pick\n"), "import std.random.\{choice, shuffle} // pick\n")
}

test "an import of another module that shares the prefix is not merged into" {
    assert_eq(applied("import std.randomx.\{shuffle}\n"), "import std.randomx.\{shuffle}\nimport std.random.\{shuffle}\n")
}

test "several names get one edit with the names the file lacks" {
    assert_eq(applied_names("fn main() \{}\n", ["choice", "shuffle"]), "import std.random.\{choice, shuffle}\n\nfn main() \{}\n")
    assert_eq(applied_names("import std.random.\{choice}\n", ["choice", "shuffle"]), "import std.random.\{choice, shuffle}\n")
    assert_eq(applied_names("import std.random.\{shuffle}\n", ["choice", "shuffle"]), "import std.random.\{shuffle, choice}\n")
    assert_eq(applied_names("import std.random.\{choice, shuffle}\n", ["choice", "shuffle"]), "present")
    assert_eq(applied_names("import std.random.\{choice as c}\n", ["choice", "shuffle"]), "import std.random.\{choice as c, choice, shuffle}\n")
    assert_eq(applied_names("import std.random.\{shuffle as choice}\n", ["choice", "shuffle"]), "blocked")
}

test "a line of a string that reads as an import of the module is not merged into" {
    let src = "fn main() \{\n    let _s = #\"\nimport std.random.\{choice}\n\"#\n}\n"
    assert_eq(applied(src), "import std.random.\{shuffle}\n\nfn main() \{\n    let _s = #\"\nimport std.random.\{choice}\n\"#\n}\n")
}

test "any run of blanks around `as` reads as one blank" {
    assert_eq(applied("import std.random.\{choice\tas shuffle}\n"), "blocked")
    assert_eq(applied("import std.random.\{choice as\tshuffle}\n"), "blocked")
    assert_eq(applied("import std.random.\{choice  as  shuffle}\n"), "blocked")
    assert_eq(applied("import std.random.\{shuffle\tas mix}\n"), "import std.random.\{shuffle\tas mix, shuffle}\n")
}

test "a selective import that renames the qualifier of the module is read for its list" {
    assert_eq(applied("import std.random as rng.\{choice as shuffle}\n"), "blocked")
    assert_eq(applied("import std.random as rng.\{shuffle}\n"), "present")
    assert_eq(applied("import std.random as rng.\{choice}\n"), "import std.random as rng.\{choice, shuffle}\n")
}

test "an import with blanks before it or after its keyword is an import" {
    assert_eq(applied("    import std.random.\{choice}\n"), "    import std.random.\{choice, shuffle}\n")
    assert_eq(applied("import\tstd.random.\{choice}\n"), "import\tstd.random.\{choice, shuffle}\n")
    assert_eq(applied("\timport std.fs\nfn main() \{}\n"), "\timport std.fs\nimport std.random.\{shuffle}\nfn main() \{}\n")
}

test "a list whose items have no comma between them is read item by item, as the parser reads it" {
    assert_eq(applied("import std.random.\{choice shuffle2}\n"), "import std.random.\{choice shuffle2, shuffle}\n")
    assert_eq(applied("import std.random.\{choice shuffle}\n"), "present")
    assert_eq(applied("import std.random.\{choice as c shuffle}\n"), "present")
    assert_eq(applied("import std.random.\{shuffle2 choice as shuffle}\n"), "blocked")
}
