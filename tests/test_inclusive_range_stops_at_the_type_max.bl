// `lo..=hi` yields `hi` last and stops, also when `hi` is the largest Int: the loop does not
// step past the end, wrap or panic. Each loop counts its turns and stops itself after a few
// more than it should take, so a loop that runs past the end fails the assert and does not hang.

test "a literal range up to the largest Int runs its last value once and stops" {
    let mut seen: List[Int] = []
    for i in 9223372036854775806..=9223372036854775807 {
        seen.push(i)
        if seen.len() > 5 { break }
    }
    assert_eq(seen, [9223372036854775806, 9223372036854775807])
}

test "a literal range from the largest Int to itself runs once" {
    let mut n = 0
    for i in 9223372036854775807..=9223372036854775807 {
        assert_eq(i, 9223372036854775807)
        n = n + 1
        if n > 5 { break }
    }
    assert_eq(n, 1)
}

test "an inclusive range with equal ends runs once" {
    let mut seen: List[Int] = []
    for i in 5..=5 { seen.push(i) }
    assert_eq(seen, [5])
}

test "an inclusive range whose start is past its end runs zero times" {
    let mut n = 0
    for _i in 5..=4 { n = n + 1 }
    for _i in 9223372036854775807..=9223372036854775806 { n = n + 1 }
    assert_eq(n, 0)
}

test "continue in the body still reaches the end test at the largest Int" {
    let mut seen: List[Int] = []
    let mut turns = 0
    for i in 9223372036854775805..=9223372036854775807 {
        turns = turns + 1
        if turns > 5 { break }
        if i == 9223372036854775806 { continue }
        seen.push(i)
    }
    assert_eq(turns, 3)
    assert_eq(seen, [9223372036854775805, 9223372036854775807])
}

test "continue on the last value at the largest Int stops the loop" {
    let mut turns = 0
    for _i in 9223372036854775806..=9223372036854775807 {
        turns = turns + 1
        if turns > 5 { break }
        continue
    }
    assert_eq(turns, 2)
}

test "break in the body leaves a range that ends at the largest Int" {
    let mut seen: List[Int] = []
    for i in 9223372036854775805..=9223372036854775807 {
        if i == 9223372036854775806 { break }
        seen.push(i)
    }
    assert_eq(seen, [9223372036854775805])
}

test "a write to a mut binder does not move the counter past the largest Int" {
    let mut seen: List[Int] = []
    for mut i in 9223372036854775806..=9223372036854775807 {
        seen.push(i)
        i = 0
        if seen.len() > 5 { break }
    }
    assert_eq(seen, [9223372036854775806, 9223372036854775807])
}

test "an inclusive range value up to the largest Int runs its last value once and stops" {
    let r = 9223372036854775806..=9223372036854775807
    let mut seen: List[Int] = []
    for i in r {
        seen.push(i)
        if seen.len() > 5 { break }
    }
    assert_eq(seen, [9223372036854775806, 9223372036854775807])
}

test "an exclusive range value up to the largest Int leaves out the end" {
    let r = 9223372036854775806..9223372036854775807
    let mut seen: List[Int] = []
    for i in r {
        seen.push(i)
        if seen.len() > 5 { break }
    }
    assert_eq(seen, [9223372036854775806])
}

test "range values with equal ends or a start past the end" {
    let mut seen: List[Int] = []
    let once = 9223372036854775807..=9223372036854775807
    for i in once {
        seen.push(i)
        if seen.len() > 5 { break }
    }
    let none_incl = 9223372036854775807..=9223372036854775806
    for i in none_incl { seen.push(i) }
    let none_excl = 9223372036854775807..9223372036854775807
    for i in none_excl { seen.push(i) }
    assert_eq(seen, [9223372036854775807])
}

fn walk(r: Range[Int]) -> List[Int] {
    let mut seen: List[Int] = []
    for i in r {
        if i == 9223372036854775806 { continue }
        seen.push(i)
        if seen.len() > 5 { break }
    }
    seen
}

test "a range value passed to a fn stops at the largest Int" {
    assert_eq(walk(9223372036854775805..=9223372036854775807), [9223372036854775805, 9223372036854775807])
    assert_eq(walk(9223372036854775805..9223372036854775807), [9223372036854775805])
}

test "a write to a mut binder over a range value does not move the counter past the largest Int" {
    let r = 9223372036854775805..=9223372036854775807
    let mut seen: List[Int] = []
    for mut i in r {
        seen.push(i)
        i = 0
        if seen.len() > 5 { break }
    }
    assert_eq(seen, [9223372036854775805, 9223372036854775806, 9223372036854775807])
}
