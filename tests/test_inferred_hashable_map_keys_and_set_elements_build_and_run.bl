// A Map key or Set element type that inference finds and that has Hash builds and runs: the
// check that refuses an unhashable inferred key (sections/03_types.md §3.6, E1400) passes
// each of these, and codegen gets the key operations it needs for each.
@derive(Hash, Eq)
type HWidget { id: Int }

@derive(Hash, Eq)
type Keyed[T] { v: T }

fn key() -> HWidget { HWidget { id: 7 } }

fn mk[K]() -> Map[K, Int] { Map() }

test "a derived key found from its inserts" {
    let mut m = Map()
    m.insert(HWidget { id: 1 }, "one")
    m.insert(HWidget { id: 2 }, "two")
    m.insert(HWidget { id: 1 }, "uno")
    assert(m.len() == 2)
    assert(m.get(HWidget { id: 1 }) == Some("uno"))
}

test "a generic derived element at a Hash instance" {
    let mut s = Set()
    s.insert(Keyed { v: HWidget { id: 1 } })
    s.insert(Keyed { v: HWidget { id: 1 } })
    let mut t = Set()
    t.insert(Keyed { v: 3 })
    assert(s.len() == 1)
    assert(t.contains(Keyed { v: 3 }))
}

test "a key found from a function return" {
    let mut m = Map.new()
    m.insert(key(), 1)
    assert(m.get(HWidget { id: 7 }) == Some(1))
}

test "an element found from a closure argument" {
    let mut s = Set()
    let add = fn(w: HWidget) { s.insert(w) }
    add(HWidget { id: 4 })
    add(HWidget { id: 4 })
    assert(s.len() == 1)
}

test "a tuple key of hashable elements" {
    let mut m = Map()
    m.insert((1, "a", HWidget { id: 1 }), 10)
    assert(m.get((1, "a", HWidget { id: 1 })) == Some(10))
}

test "a generic call whose key parameter a later insert solves" {
    let mut m = mk()
    m.insert(HWidget { id: 9 }, 1)
    assert(m.len() == 1)
}

test "a scalar element found from a literal" {
    let mut s = Set()
    s.insert('c')
    s.insert('c')
    assert(s.len() == 1)
}
