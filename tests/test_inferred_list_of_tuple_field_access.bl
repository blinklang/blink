import compile_test_helpers

// A List whose element type is inferred from .push (rather than an explicit
// annotation) must support tuple field access on its elements the same way
// an explicitly-annotated List[(Int, Int)] does.

fn inferred_list_tuple_field_src() -> Str {
    #"fn main() ! IO {
    let mut qs = []
    qs.push((10, 20))
    let v = qs.get(0).unwrap().0
    io.println("v={v}")
}
"#
}

test "an inferred List-of-tuple supports .0 field access on its elements" {
    let r = compile_test_helpers.compile_and_run(inferred_list_tuple_field_src(), "_inferred_tuple")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "v=10\n")
}
