// An inferred `let mut m = Map()` with an enum key keeps working past the
// first insert, both with and without an explicit type annotation.

@derive(Hash, Eq)
type Col { Red, Green }

test "annotated map, two enum-key inserts" {
    let mut m: Map[Col, Int] = Map()
    m.insert(Col.Red, 1)
    m.insert(Col.Green, 2)
    assert_eq(m.len(), 2)
}

test "inferred map, two enum-key inserts" {
    let mut m2 = Map()
    m2.insert(Col.Red, 1)
    m2.insert(Col.Green, 2)
    assert_eq(m2.len(), 2)
}
