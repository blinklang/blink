// A fully-inline deep method chain through two carrier unwraps
// (mk().unwrap().get(k).unwrap().get(0).unwrap()) must resolve .get on the
// Map[Str, List[Int]] and .get on the resulting List[Int] at typecheck, even
// with no intermediate let-binding to carry the element type across the hops.

fn mk() -> Result[Map[Str, List[Int]], Str] {
    let mut m: Map[Str, List[Int]] = Map()
    m.insert("k", [9])
    Ok(m)
}

test "a fully-inline Result[Map[Str,List[Int]],Str] chain resolves both unwrap+get hops" {
    let got = mk().unwrap().get("k").unwrap().get(0).unwrap()
    assert_eq(got, 9)
}
