// pv95mj: inline f(args).unwrap()/.unwrap_err() on a Result/Option-returning user fn lost
// the OK/Some inner type (defaulted to Int), so a chained method emitted
// "unresolved method on type Int". Root cause: Result.unwrap codegen read the inner only
// from the scope-var registry, never falling back to the live expr_result_* globals (unlike
// Option.unwrap). Reproduced in a plain fn too — not test-specific.

fn mk_bytes(_c: Int) -> Result[Bytes, Str] { Ok(Bytes.new()) }
fn mk_list(_c: Int)  -> Result[List[Int], Str] { Ok([1, 2, 3]) }
fn mk_str(_c: Int)   -> Result[Str, Str] { Ok("hi") }
fn mk_opt_bytes(_c: Int) -> Option[Bytes] { Some(Bytes.new()) }
fn driver() -> Int { mk_bytes(1).unwrap().len() }   // inline in a NON-test fn

test "pv95mj: inline Result[Bytes].unwrap().len()" { assert_eq(mk_bytes(1).unwrap().len(), 0) }
test "pv95mj: inline Result[List].unwrap().len()"  { assert_eq(mk_list(1).unwrap().len(), 3) }
test "pv95mj: inline Result[Str].unwrap().len()"   { assert_eq(mk_str(1).unwrap().len(), 2) }
test "pv95mj: inline Option[Bytes].unwrap().len()" { assert_eq(mk_opt_bytes(1).unwrap().len(), 0) }
test "pv95mj guard: stored form still works"       { let r = mk_bytes(1) assert_eq(r.unwrap().len(), 0) }
test "pv95mj: inline unwrap in non-test fn"        { assert_eq(driver(), 0) }
