// The declaration check goes through the register routes that the build walk uses, so a state it
// leaves set would stop the build walk from making instances.

import mono.{check_instance_cycles, run_mono, instances}
import parser.{node_name}
import diagnostics.{diag_count}
import cg_test_helpers.{cg_probe_compile}

test "the build walk makes each instance after the declaration check ends" {
    let path = "build/instance_check_probe.bl"
    let program = cg_probe_compile(path, "fn id[T](x: T) -> T \{ x }\nfn main() \{ let _a = id(1) }\n")
    let _rm = process.run("rm", ["-f", path]).unwrap()
    check_instance_cycles(program)
    assert_eq(diag_count, 0)
    run_mono(program)
    let mut found = false
    for inst in instances() {
        if node_name(inst.base_decl_node) == "id" { found = true }
    }
    assert(found)
}
