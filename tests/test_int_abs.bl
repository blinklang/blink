// `Int.abs`. No spec table gives `Int` this method, and the spec has not settled whether `Int`
// has it. The behavior follows the rule the sized integer table in sections/03_types.md gives
// each signed type, "Panics on min value for signed types": the minimum has no positive value
// in its own type, so it panics and never comes back negative.

fn lo() -> Int { -9223372036854775807 - 1 }

test "abs of zero is zero" {
    assert_eq(0.abs(), 0)
}

test "abs of a positive value is the value" {
    assert_eq(42.abs(), 42)
    assert_eq(9223372036854775807.abs(), 9223372036854775807)
}

test "abs of a negative value is its negation" {
    assert_eq((-42).abs(), 42)
    let x = -1
    assert_eq(x.abs(), 1)
    assert_eq((lo() + 1).abs(), 9223372036854775807)
}

test "abs reads its receiver once" {
    let mut calls = 0
    let f = fn() -> Int {
        calls = calls + 1
        -5
    }
    assert_eq(f().abs(), 5)
    assert_eq(calls, 1)
}

test "abs of the minimum panics" {
    assert_panics(matching: "Int overflow in abs") {
        let v = lo().abs()
        io.println("{v}")
    }
}
