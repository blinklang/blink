// Each integer operator group chains left on its own, and every group binds tighter than
// comparison and equality and looser than unary prefix (sections/02_syntax.md §2.19). The bare
// forms below are kept bare on purpose: the formatter adds parentheses around a shift or bitwise
// operand of a comparison, and the idempotency check runs over this file.

fn main() {
    let flags = 48
    let x = 6
    let y = 3
    let limit = 13
    let one: U32 = 1

    // `flags & 15 == 0` is `(flags & 15) == 0`, not `flags & (15 == 0)`.
    assert(flags & 15 == 0)
    assert(flags & 16 != 0)
    assert(x << 1 < limit)
    assert(x >> 1 == y)
    assert(x | y == 7)
    assert(x ^ y == 5)
    assert(x + y == 9)
    assert(x * y > x + y)

    // One group chains left without parentheses.
    assert_eq(x << 2 >> 1, 12)
    assert_eq(x | y | 8, 15)
    assert_eq(x & y & 2, 2)
    assert_eq(x ^ y ^ 1, 4)
    assert_eq(x - y - 1, 2)
    assert_eq(x + y * 2, 12)
    assert_eq(x * y + 2, 20)
    assert_eq(x / y * 2, 4)

    // Unary prefix binds tighter than every group.
    assert_eq(~x & 15, 9)
    assert_eq(-x << 1, -12)

    // Parentheses pick either grouping across groups.
    assert_eq((x << 1) + 1, 13)
    assert_eq(x << (one + 1), 24)
    assert_eq((x | y) & 2, 2)
    assert_eq(x | (y & 2), 6)
    io.println("ok")
}
