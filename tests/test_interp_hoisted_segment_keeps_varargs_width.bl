// An interpolation segment passes through `...` widened to the width its conversion
// reads. When a later segment does work ahead of the format call (a `??`, a `?`, a
// checked operator), the earlier segments are held in temps first, and the held value
// must still reach the format widened, or the conversion reads the wrong bytes.

fn id_i8(n: I8) -> I8 { n }
fn id_i16(n: I16) -> I16 { n }
fn id_i32(n: I32) -> I32 { n }
fn id_u8(n: U8) -> U8 { n }
fn id_u16(n: U16) -> U16 { n }
fn id_u32(n: U32) -> U32 { n }
fn id_u64(n: U64) -> U64 { n }
fn id_int(n: Int) -> Int { n }
fn id_float(n: Float) -> Float { n }
fn id_char(n: Char) -> Char { n }
fn id_bool(n: Bool) -> Bool { n }

type Small { value: I8 }

fn id_small(n: Small) -> Small { n }

fn none() -> Option[Int] { None }

fn beside_question(o: Option[Int]) -> Option[Str] {
    let lo: I8 = -128
    let hi: U64 = 18446744073709551615
    Some("{id_i8(lo)} {id_u64(hi)} {o?}")
}

test "a sized int held beside a coalesce keeps its value" {
    let i8_lo: I8 = -128
    let i8_hi: I8 = 127
    let i16_lo: I16 = -32768
    let i16_hi: I16 = 32767
    let i32_lo: I32 = -2147483648
    let i32_hi: I32 = 2147483647
    let u8_hi: U8 = 255
    let u16_hi: U16 = 65535
    let u32_hi: U32 = 4294967295
    let u64_hi: U64 = 18446744073709551615
    let zero: U8 = 0
    assert_eq("{id_i8(i8_lo)} {id_i8(i8_hi)} {none() ?? 0}", "-128 127 0")
    assert_eq("{id_i16(i16_lo)} {id_i16(i16_hi)} {none() ?? 0}", "-32768 32767 0")
    assert_eq("{id_i32(i32_lo)} {id_i32(i32_hi)} {none() ?? 0}", "-2147483648 2147483647 0")
    assert_eq("{id_u8(zero)} {id_u8(u8_hi)} {none() ?? 0}", "0 255 0")
    assert_eq("{id_u16(u16_hi)} {none() ?? 0}", "65535 0")
    assert_eq("{id_u32(u32_hi)} {none() ?? 0}", "4294967295 0")
    assert_eq("{id_u64(u64_hi)} {none() ?? 0}", "18446744073709551615 0")
}

test "a sized int inlined keeps its value" {
    let i8_lo: I8 = -128
    let i16_lo: I16 = -32768
    let i32_lo: I32 = -2147483648
    let u64_hi: U64 = 18446744073709551615
    assert_eq("{id_i8(i8_lo)}", "-128")
    assert_eq("{id_i16(i16_lo)}", "-32768")
    assert_eq("{id_i32(i32_lo)}", "-2147483648")
    assert_eq("{id_u64(u64_hi)}", "18446744073709551615")
}

test "a sized int held beside a propagate keeps its value" {
    assert_eq(beside_question(Some(3)) ?? "none", "-128 18446744073709551615 3")
    assert_eq(beside_question(None) ?? "none", "none")
}

test "a sized int held beside a checked operator keeps its value" {
    let i16_lo: I16 = -32768
    let i32_lo: I32 = -2147483648
    assert_eq("{id_i16(i16_lo)} {id_int(5) + id_int(6)}", "-32768 11")
    assert_eq("{id_i32(i32_lo)} {id_int(5) * id_int(6)}", "-2147483648 30")
}

test "a sized int field held beside a coalesce keeps its value" {
    let s = Small { value: -7 }
    assert_eq("{id_small(s).value} {none() ?? 0}", "-7 0")
}

test "the other scalars held beside a coalesce keep their values" {
    assert_eq("{id_float(1.5)} {id_char('x')} {id_bool(true)} {id_int(-9)} {none() ?? 0}", "1.5 x true -9 0")
}
