// `.into()` needs an `impl From[S] for T`. Int widens to Float through one. Float to Int
// and Int to Str have none (section 3c.3 spells them `.truncate()` and `.to_string()`),
// so they are refused with E0312.

import compile_test_helpers

test "Int to Float conversion" {
    let x: Int = 42
    let y: Float = x.into()
    assert_eq(y, 42.0)
}

test "Float to Int truncation" {
    let src = "fn main() \{\n    let a: Float = 3.14\n    let b: Int = a.into()\n    io.println(\"\{b}\")\n}\n"
    compile_test_helpers.expect_compile_error(src, "into_float_int", "E0312")
}

test "Int to Str conversion" {
    let src = "fn main() \{\n    let c: Int = 100\n    let d: Str = c.into()\n    io.println(d)\n}\n"
    compile_test_helpers.expect_compile_error(src, "into_int_str", "E0312")
}
