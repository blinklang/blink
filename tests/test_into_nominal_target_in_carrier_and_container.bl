// `.into()` reads its target from the call node's own type. When that target is a
// NOMINAL type (a struct or enum reached through a `From` impl) the converted value
// must also be spelled as that target, not as the argument it was built from --
// otherwise the enclosing carrier or container is spelled from the source type and
// the emitted C names a type that was never declared.

type Cel { deg: Int }

type Far { deg: Int }

impl From[Cel] for Far {
    fn from(c: Cel) -> Far {
        Far { deg: c.deg * 9 / 5 + 32 }
    }
}

fn to_opt(c: Cel) -> Option[Far] {
    Some(c.into())
}

fn to_res(c: Cel) -> Result[Far, Str] {
    Ok(c.into())
}

fn to_err(c: Cel) -> Result[Str, Far] {
    Err(c.into())
}

test "a nominal into() target inside an Option return" {
    let f = to_opt(Cel { deg: 100 }).unwrap()
    assert_eq(f.deg, 212)
}

test "a nominal into() target inside a Result ok return" {
    let f = to_res(Cel { deg: 0 }).unwrap()
    assert_eq(f.deg, 32)
}

test "a nominal into() target inside a Result err return" {
    let r = to_err(Cel { deg: 100 })
    assert_eq(r.is_err(), true)
    assert_eq(r.unwrap_err().deg, 212)
}

test "a nominal into() target inside a let-bound Option" {
    let c = Cel { deg: 100 }
    let o: Option[Far] = Some(c.into())
    assert_eq(o.unwrap().deg, 212)
}

test "a nominal into() target as a list element" {
    let c = Cel { deg: 100 }
    let xs: List[Far] = [c.into()]
    assert_eq(xs.get(0).unwrap().deg, 212)
}

test "a nominal into() target at a plain let still works" {
    let c = Cel { deg: 100 }
    let f: Far = c.into()
    assert_eq(f.deg, 212)
}
