// `.into()` is target-directed: the conversion picked depends on the type the result
// flows into. tests/test_total_stamp_typecheck_holes.bl already covers several target
// positions (a fn's implicit tail, a list element, a carrier payload) but none of them
// are a plain ASSIGNMENT target (`f = c.into()` reassigning an existing `mut` binding,
// as opposed to a `let` annotation). Typecheck does not propagate the assignment
// target's type into the RHS call node, so the MethodCall reaches the end of inference
// with no type at all and trips the NodeCarriesNoType internal-compiler-error backstop.

import compile_test_helpers.{compile_and_run}

test.failing(
    "into() on the right of a plain reassignment resolves its target type",
    reason: "typecheck does not propagate an assignment target's type into the RHS .into() call node, so the MethodCall node reaches the end of inference with no type and trips the NodeCarriesNoType internal-compiler-error backstop instead of compiling",
    ticket: "njyr92",
) {
    let src = #"
import std.io

type Cel { deg: Int }
type RFar { deg: Int }
impl From[Cel] for RFar {
    fn from(c: Cel) -> RFar { RFar { deg: c.deg + 1 } }
}
fn main() {
    let c = Cel { deg: 1 }
    let mut f: RFar = RFar { deg: 0 }
    f = c.into()
    io.println("{f.deg}")
}
"#
    let r = compile_and_run(src, "_into_reassignment_target_type")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "2\n")
}
