// A `.into()` call inside a struct-literal field must resolve against the
// FIELD's declared type, not against an outer let binding's annotation.

type H { s: Str }

fn take(h: H) -> Float {
    assert_eq(h.s, "42")
    1.5
}

test "into() in a struct-literal field resolves against the field's own type" {
    let x: Float = take(H { s: 42.into() })
    assert(x > 1.0)
}
