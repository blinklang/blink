// A `.into()` call inside a struct-literal field must resolve against the
// FIELD's declared type, not against an outer let binding's annotation.

import compile_test_helpers

type Deg { v: Int }

impl From[Int] for Deg {
    fn from(n: Int) -> Deg { Deg { v: n } }
}

type H { d: Deg }

fn take(h: H) -> Float {
    assert_eq(h.d.v, 42)
    1.5
}

test "into() in a struct-literal field resolves against the field's own type" {
    let x: Float = take(H { d: 42.into() })
    assert(x > 1.0)
}

// Int has no From impl into Str, so a Str field is refused even though the outer Float is a From target.
test "into() in a Str struct-literal field is refused" {
    let src = "type S \{ s: Str }\n\nfn take(h: S) -> Float \{ 1.5 }\n\nfn main() \{\n    let x: Float = take(S \{ s: 42.into() })\n    io.println(\"\{x}\")\n}\n"
    compile_test_helpers.expect_compile_error(src, "into_str_field", "E0312")
}
