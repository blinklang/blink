// Tests E1011 InvalidPackageName: [package].name must match [a-z][a-z0-9_]*

import compile_test_helpers

fn main() {
    let base = "{compile_test_helpers.scratch_root()}/_test_invalid_pkg_name"
    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
    let blink = "{env.cwd()}/build/blink"

    // --- Test 1: hyphen in name ---
    process.run("sh", ["-c", "mkdir -p {base}/badhyphen/src"]).unwrap()
    fs.write("{base}/badhyphen/blink.toml", "[package]\nname = \"bad-name\"\nversion = \"0.1.0\"\n").unwrap()
    fs.write("{base}/badhyphen/src/badname.bl", "pub fn x() -> Int \{ 1 \}\n").unwrap()
    fs.write("{base}/badhyphen/src/main.bl", "fn main() \{ io.println(\"x\") }\n").unwrap()
    process.run("sh", ["-c", "cd {base}/badhyphen && {blink} build src/main.bl -o build/app > err.txt 2>&1; true"]).unwrap()
    let err1 = fs.read("{base}/badhyphen/err.txt").unwrap()
    if err1.contains("E1011") || err1.contains("invalid") {
        io.println("PASS: hyphen in package name rejected with E1011")
    } else {
        io.println("FAIL: expected E1011 for hyphen, got: {err1}")
    }

    // --- Test 2: leading digit ---
    process.run("sh", ["-c", "mkdir -p {base}/baddigit/src"]).unwrap()
    fs.write("{base}/baddigit/blink.toml", "[package]\nname = \"1bad\"\nversion = \"0.1.0\"\n").unwrap()
    fs.write("{base}/baddigit/src/main.bl", "fn main() \{ io.println(\"x\") }\n").unwrap()
    process.run("sh", ["-c", "cd {base}/baddigit && {blink} build src/main.bl -o build/app > err.txt 2>&1; true"]).unwrap()
    let err2 = fs.read("{base}/baddigit/err.txt").unwrap()
    if err2.contains("E1011") || err2.contains("invalid") {
        io.println("PASS: leading digit in package name rejected with E1011")
    } else {
        io.println("FAIL: expected E1011 for leading digit, got: {err2}")
    }

    // --- Test 3: uppercase ---
    process.run("sh", ["-c", "mkdir -p {base}/badupper/src"]).unwrap()
    fs.write("{base}/badupper/blink.toml", "[package]\nname = \"BadName\"\nversion = \"0.1.0\"\n").unwrap()
    fs.write("{base}/badupper/src/main.bl", "fn main() \{ io.println(\"x\") }\n").unwrap()
    process.run("sh", ["-c", "cd {base}/badupper && {blink} build src/main.bl -o build/app > err.txt 2>&1; true"]).unwrap()
    let err3 = fs.read("{base}/badupper/err.txt").unwrap()
    if err3.contains("E1011") || err3.contains("invalid") {
        io.println("PASS: uppercase in package name rejected with E1011")
    } else {
        io.println("FAIL: expected E1011 for uppercase, got: {err3}")
    }

    // --- Test 4: valid name passes ---
    process.run("sh", ["-c", "mkdir -p {base}/goodname/src"]).unwrap()
    fs.write("{base}/goodname/blink.toml", "[package]\nname = \"good_name_42\"\nversion = \"0.1.0\"\n").unwrap()
    fs.write("{base}/goodname/src/good_name_42.bl", "pub fn x() -> Int \{ 42 \}\n").unwrap()
    fs.write("{base}/goodname/src/main.bl", "fn main() \{ io.println(\"42\") }\n").unwrap()
    process.run("sh", ["-c", "cd {base}/goodname && {blink} build src/main.bl -o build/app > err.txt 2>&1; true"]).unwrap()
    let err4 = fs.read("{base}/goodname/err.txt").unwrap()
    if err4.contains("E1011") || err4.contains("invalid") {
        io.println("FAIL: valid package name 'good_name_42' should not emit E1011, got: {err4}")
    } else {
        io.println("PASS: valid package name 'good_name_42' accepted")
    }

    process.run("sh", ["-c", "rm -rf {base}"]).unwrap()
}
