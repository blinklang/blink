// io.print_raw and io.print_raw_bytes are operations of IO.Print, and io.eprint_raw is an
// operation of IO.Eprint (sections/04_effects.md §4.4), so the innermost handler of that
// sub-effect receives each call. print_raw and eprint_raw are derived: a handler that omits
// one runs its default body, which calls print_no_nl or eprint_no_nl on that same handler.
// print_raw_bytes is primitive: a handler that omits it forwards it to the enclosing handler.
// A clause here reports what it got through io.print, which the enclosing capture_print
// receives, so each list shows which clause ran.

import std.testing.{capture_print, capture_eprint, capture_log}

test "io.print_raw under capture_print lands in the list" {
    let out: List[Str] = []
    with capture_print(out) {
        io.print_raw("raw ")
        io.println("line")
    }
    assert_eq(out, ["raw ", "line"])
}

test "io.eprint_raw under capture_eprint lands in the list" {
    let err: List[Str] = []
    with capture_eprint(err) {
        io.eprint_raw("raw ")
        io.eprintln("line")
    }
    assert_eq(err, ["raw ", "line"])
}

test "a print_raw clause receives io.print_raw" {
    let out: List[Str] = []
    with capture_print(out) {
        with handler IO.Print {
            fn print_raw(s: Str) { io.print("raw clause: {s}") }
        } {
            io.print_raw("x")
        }
    }
    assert_eq(out, ["raw clause: x"])
}

test "a print_raw_bytes clause receives io.print_raw_bytes" {
    let out: List[Str] = []
    with capture_print(out) {
        with handler IO.Print {
            fn print_raw_bytes(b: Bytes) { io.print("bytes clause: {b.len()}") }
        } {
            io.print_raw_bytes(Bytes.from_str("abc"))
        }
    }
    assert_eq(out, ["bytes clause: 3"])
}

test "a handler that omits print_raw gets the text as its own print_no_nl call" {
    let out: List[Str] = []
    with capture_print(out) {
        with handler IO.Print {
            fn print_raw(s: Str) { io.print("outer raw clause: {s}") }
        } {
            with handler IO.Print {
                fn print_no_nl(msg: Str) { io.print("inner no_nl clause: {msg}") }
            } {
                io.print_raw("x")
            }
        }
    }
    assert_eq(out, ["inner no_nl clause: x"])
}

test "a handler that omits eprint_raw gets the text as its own eprint_no_nl call" {
    let out: List[Str] = []
    with capture_print(out) {
        with handler IO.Eprint {
            fn eprint_raw(s: Str) { io.print("outer raw clause: {s}") }
        } {
            with handler IO.Eprint {
                fn eprint_no_nl(msg: Str) { io.print("inner no_nl clause: {msg}") }
            } {
                io.eprint_raw("x")
            }
        }
    }
    assert_eq(out, ["inner no_nl clause: x"])
}

test "a handler that omits print_raw_bytes forwards it to the enclosing handler" {
    let out: List[Str] = []
    with capture_print(out) {
        with handler IO.Print {
            fn print_raw_bytes(b: Bytes) { io.print("outer bytes clause: {b.len()}") }
        } {
            with handler IO.Print {
                fn print(msg: Str) { io.print("inner print clause: {msg}") }
            } {
                io.print_raw_bytes(Bytes.from_str("ab"))
            }
        }
    }
    assert_eq(out, ["outer bytes clause: 2"])
}

test "capture_print forwards io.print_raw_bytes to the enclosing handler today" {
    let err: List[Str] = []
    let inner: List[Str] = []
    with capture_eprint(err) {
        with handler IO.Print {
            fn print_raw_bytes(b: Bytes) { io.eprint("outer bytes clause: {b.len()}") }
        } {
            with capture_print(inner) {
                io.print_raw_bytes(Bytes.from_str("abcd"))
            }
        }
    }
    assert_eq(inner.len(), 0)
    assert_eq(err, ["outer bytes clause: 4"])
}

test "an IO.Log handler leaves io.print_raw to the enclosing IO.Print handler" {
    let out: List[Str] = []
    let logs: List[Str] = []
    with capture_print(out) {
        with capture_log(logs) {
            io.print_raw("x")
        }
    }
    assert_eq(out, ["x"])
    assert_eq(logs.len(), 0)
}
