// A unit's C carries the line and column of nodes in other sources, and a body edit there
// moves them without changing that source's interface. So each read through ir_line and
// ir_col, and each ir_note_source, marks the node's source as one the unit read.

import lower_test_helpers.{probe, fn_decl_of}
import parser.{node_count, node_line, node_col}
import ir.{ir_col, ir_line, ir_note_source, ir_reset, ir_sources_read, ir_track_sources}

fn src_two_fns() -> Str {
    #"fn first_fn() -> Int { 1 }

fn second_fn() -> Int { 2 }

fn main() {
    let _v = first_fn() + second_fn()
}
"#
}

// The two fns as source ranges: first_fn's node starts range 0, second_fn's starts range 1.
fn track_two_fns() -> (Int, Int) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck {
    let _p = probe("line_col_marks", src_two_fns())
    let a = fn_decl_of("first_fn")
    let b = fn_decl_of("second_fn")
    assert(a < b)
    ir_reset()
    ir_track_sources([a, b], [b, node_count()])
    assert_eq(ir_sources_read().len(), 0)
    (a, b)
}

test "ir_line marks the source of the node it reads" {
    let (_a, b) = track_two_fns()
    assert_eq(ir_line(b), node_line(b))
    assert_eq(ir_sources_read(), [1])
    ir_track_sources([], [])
    ir_reset()
}

test "ir_col marks the source of the node it reads" {
    let (a, _b) = track_two_fns()
    assert_eq(ir_col(a), node_col(a))
    assert_eq(ir_sources_read(), [0])
    ir_track_sources([], [])
    ir_reset()
}

test "ir_note_source marks the source of the node it names" {
    let (_a, b) = track_two_fns()
    ir_note_source(b)
    assert_eq(ir_sources_read(), [1])
    ir_track_sources([], [])
    ir_reset()
}
