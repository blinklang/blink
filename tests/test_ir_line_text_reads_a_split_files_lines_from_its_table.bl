// A file of a split unit reads each line from its module's table, so that a line added above
// a function changes the table and not each chunk below the edit. ir_line_text gives such a
// file the next index of the table and records the line there; outside a split file it
// gives the line as a number. The table holds through ir_reset, which a file's emit calls
// for each body.

import lower_test_helpers.{probe, fn_decl_of}
import parser.{node_line}
import ir.{ir_line_tabled, ir_line_text, ir_pos_begin, ir_pos_take, ir_reset}

fn src_two_fns() -> Str {
    #"fn first_fn() -> Int { 1 }

fn second_fn() -> Int { 2 }

fn main() {
    let _v = first_fn() + second_fn()
}
"#
}

fn two_fns() -> (Int, Int) ! Lex.Tokenize, Parse, Parse.Build, Diag.Report, TypeCheck {
    let _p = probe("line_text_table", src_two_fns())
    (fn_decl_of("first_fn"), fn_decl_of("second_fn"))
}

test "outside a split file a line is written as its number" {
    let (a, _b) = two_fns()
    assert(!ir_line_tabled(a))
    assert_eq(ir_line_text(a), "{node_line(a)}")
    assert_eq(ir_pos_take(), [])
}

test "in a split file each line takes the next index of the table" {
    let (a, b) = two_fns()
    ir_pos_begin("__blink_pos_m_head")
    assert(ir_line_tabled(a))
    assert_eq(ir_line_text(b), "__blink_pos_m_head[0]")
    ir_reset()
    assert_eq(ir_line_text(a), "__blink_pos_m_head[1]")
    assert_eq(ir_line_text(b), "__blink_pos_m_head[2]")
    assert_eq(ir_pos_take(), [node_line(b), node_line(a), node_line(b)])
    assert(!ir_line_tabled(a))
    assert_eq(ir_line_text(a), "{node_line(a)}")
}
