// A lowering whose answer its caller keys on directly, and then throws away, must mark no
// source as read by the unit: between ir_sources_pause and ir_sources_resume a node built in
// any range marks nothing, and resume brings back the record as it was, with the marks made
// before the pause, so marks go on after it.

import ir.{ir_const, ir_reset, ir_sources_pause, ir_sources_read, ir_sources_resume, ir_track_sources}

test "ir_sources_pause marks no source until ir_sources_resume brings the record back" {
    ir_reset()
    ir_track_sources([0, 10, 20], [10, 20, 30])
    let _a = ir_const(0, 3, "int64_t", "1")
    let track = ir_sources_pause()
    let _b = ir_const(0, 12, "int64_t", "2")
    let _c = ir_const(0, 25, "int64_t", "3")
    assert_eq(ir_sources_read().len(), 0)
    ir_sources_resume(track)
    assert_eq(ir_sources_read(), [0])
    let _d = ir_const(0, 27, "int64_t", "4")
    assert_eq(ir_sources_read(), [0, 2])
    ir_track_sources([], [])
    ir_reset()
}
