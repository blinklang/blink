// ir_sources_read names each source range a node built since ir_track_sources spans, and no
// other: not a range no node spans, and not one for a span outside every range. An arena
// reset keeps the record, since a unit's emit resets the arena many times; a new
// ir_track_sources starts it again.

import ir.{ir_const, ir_reset, ir_sources_read, ir_track_sources}

test "ir_sources_read names each range a node spans and keeps it over a reset" {
    ir_reset()
    ir_track_sources([0, 10, 20, 40], [10, 20, 30, 50])
    let _a = ir_const(0, 12, "int64_t", "1")
    let _b = ir_const(0, 29, "int64_t", "2")
    let _c = ir_const(0, 35, "int64_t", "3")
    let _d = ir_const(0, -1, "int64_t", "4")
    assert_eq(ir_sources_read(), [1, 2])
    ir_reset()
    let _e = ir_const(0, 40, "int64_t", "5")
    assert_eq(ir_sources_read(), [1, 2, 3])
    ir_track_sources([0, 10], [10, 20])
    assert_eq(ir_sources_read().len(), 0)
    let _f = ir_const(0, 0, "int64_t", "6")
    assert_eq(ir_sources_read(), [0])
    ir_track_sources([], [])
    ir_reset()
}
