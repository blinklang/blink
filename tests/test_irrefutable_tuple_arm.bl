// Bug xgkep8: an irrefutable tuple pattern `(a, n)` makes pattern_condition
// return "", so the arm loop classified it as a wildcard: the first arm emitted
// a bare `{` with no `if`, and a trailing `_` arm emitted `} else {` -> C error
// "'else' without a previous 'if'". An irrefutable arm makes any following arm
// dead code; the fix breaks the arm chain after an irrefutable arm.

test "irrefutable tuple arm followed by dead wildcard arm" {
    let r = match (5, 9) {
        (a, n) => a + n
        _ => 0
    }
    assert_eq(r, 14)
}

test "sole irrefutable tuple arm still works" {
    let r = match (5, 9) {
        (a, n) => a + n
    }
    assert_eq(r, 14)
}

test "bare-ident catch-all arm followed by dead arm" {
    let r = match (5, 9) {
        x => 1
        _ => 0
    }
    assert_eq(r, 1)
}
