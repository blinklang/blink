// The iterator-family twin of b7zdk3/nz84sz. A List whose element is an
// Option/Result carrier over a nested container, driven through the iterator
// family (find + the lazy adapters), spelled its element carrier with the inner
// container head ERASED to a bare default (Option_int) when the flat type
// channels were erased by a field-bound receiver, while the deref/consumer
// demanded the container carrier -> cc type mismatch. The carrier must be
// recovered from the receiver's node tid at the iterator source, exactly as the
// direct get/pop accessors already do.

type Holder {
    rows: List[Option[Map[Str, Int]]]
}

fn find_field_bound() -> Int {
    let mut m: Map[Str, Int] = Map()
    m.insert("k", 4)
    let h = Holder { rows: [Some(m)] }
    let found = h.rows.find(fn(e: Option[Map[Str, Int]]) -> Bool { e.is_some() })
    found.unwrap().unwrap().get("k").unwrap()
}

fn filter_field_bound() -> Int {
    let mut m: Map[Str, Int] = Map()
    m.insert("k", 6)
    let h = Holder { rows: [Some(m)] }
    let kept = h.rows.filter(fn(e: Option[Map[Str, Int]]) -> Bool { e.is_some() })
    kept.get(0).unwrap().unwrap().get("k").unwrap()
}

test "List[Option[Map]] element keeps its Map inner through find" {
    assert_eq(find_field_bound(), 4)
}

test "List[Option[Map]] element keeps its Map inner through filter adapter" {
    assert_eq(filter_field_bound(), 6)
}
