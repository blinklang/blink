// The eager iteration world of §3c.1: a collection adapter answers a collection.
// `list.map(f)` returns a List you can use directly — `.len()`, `.get()`, another
// adapter — with no `.into_iter()` door and no `.collect()` crossing. This is the
// half that mirrors the lazy world (tested in test_iterator_lazy_world.bl); the two
// must agree element-for-element (deforestation-equivalent, §3c.1 / decision D2-A).
//
// Before hn269g, typecheck typed these eagerly (List in, List out) but codegen
// lowered every adapter to a lazy CT_ITERATOR, so `a.map(f).len()` tripped the
// codegen backstop "unresolved method '.len'". These tests pin the eager result.

fn dbl(x: Int) -> Int { x * 2 }
fn is_even(x: Int) -> Bool { x % 2 == 0 }
fn tag(x: Int) -> Str { "n{x}" }
fn explode(x: Int) -> List[Int] { [x, x] }

test "eager map answers a usable list" {
    let a: List[Int] = [1, 2, 3]
    let out = a.map(fn(x: Int) -> Int { dbl(x) })
    assert_eq(out.len(), 3)
    assert_eq(out.get(0).unwrap(), 2)
    assert_eq(out.get(2).unwrap(), 6)
}

test "eager map can change the element type" {
    let a: List[Int] = [1, 2, 3]
    let out = a.map(fn(x: Int) -> Str { tag(x) })
    assert_eq(out.len(), 3)
    assert_eq(out.get(0).unwrap(), "n1")
    assert_eq(out.get(2).unwrap(), "n3")
}

test "eager filter answers a usable list" {
    let a: List[Int] = [1, 2, 3, 4, 5]
    let out = a.filter(fn(x: Int) -> Bool { is_even(x) })
    assert_eq(out.len(), 2)
    assert_eq(out.get(0).unwrap(), 2)
    assert_eq(out.get(1).unwrap(), 4)
}

test "eager take answers a usable list" {
    let a: List[Int] = [10, 20, 30, 40]
    let out = a.take(2)
    assert_eq(out.len(), 2)
    assert_eq(out.get(0).unwrap(), 10)
    assert_eq(out.get(1).unwrap(), 20)
}

test "eager skip answers a usable list" {
    let a: List[Int] = [10, 20, 30, 40]
    let out = a.skip(2)
    assert_eq(out.len(), 2)
    assert_eq(out.get(0).unwrap(), 30)
    assert_eq(out.get(1).unwrap(), 40)
}

test "eager chain answers a usable list" {
    let a: List[Int] = [1, 2]
    let b: List[Int] = [3, 4]
    let out = a.chain(b)
    assert_eq(out.len(), 4)
    assert_eq(out.get(0).unwrap(), 1)
    assert_eq(out.get(3).unwrap(), 4)
}

test "eager flat_map answers a usable list" {
    let a: List[Int] = [1, 2, 3]
    let out = a.flat_map(fn(x: Int) -> List[Int] { explode(x) })
    assert_eq(out.len(), 6)
    assert_eq(out.get(0).unwrap(), 1)
    assert_eq(out.get(1).unwrap(), 1)
    assert_eq(out.get(5).unwrap(), 3)
}

test "eager adapters chain collection-to-collection" {
    let a: List[Int] = [1, 2, 3, 4, 5, 6]
    let out = a.map(fn(x: Int) -> Int { dbl(x) }).filter(fn(x: Int) -> Bool { x % 4 == 0 })
    assert_eq(out.len(), 3)
    assert_eq(out.get(0).unwrap(), 4)
    assert_eq(out.get(1).unwrap(), 8)
    assert_eq(out.get(2).unwrap(), 12)
}

test "eager enumerate answers a usable list of pairs" {
    let a: List[Str] = ["a", "b", "c"]
    let out = a.enumerate()
    assert_eq(out.len(), 3)
}

test "eager map to float answers heap-boxed doubles" {
    let a: List[Int] = [2, 4, 6]
    let out = a.map(fn(x: Int) -> Float { x.to_float() / 2.0 })
    assert_eq(out.len(), 3)
    assert_eq(out.get(0).unwrap(), 1.0)
    assert_eq(out.get(2).unwrap(), 3.0)
}
