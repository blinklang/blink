// The iterator var's element CT reaches its consumers (for-in, alias, closure
// hint) through get_var_iterator_inner. Two shapes diverge from a plain scalar
// into_iter and must keep their element intact when the reader takes the element
// off the tid: a SET source, which normalizes to a list first (the receiver is a
// Set, so the element tid must be recovered from the set receiver, not the
// synthesized list), and a STRUCT-carrier adapter, whose element is pointer-boxed
// (physical CT_INT) with the true struct identity on the iterator var's carrier
// tag. A mistyped element flips the looped value or drops the struct deref.

type Pt { x: Int, y: Int }

test "for-in over a scalar Set iterator sums its elements" {
    let mut s: Set[Int] = Set()
    s.insert(2)
    s.insert(4)
    s.insert(6)
    let mut total = 0
    for v in s.into_iter() {
        total = total + v
    }
    assert_eq(total, 12)
}

test "for-in over a Str Set iterator counts its elements" {
    let mut s: Set[Str] = Set()
    s.insert("a")
    s.insert("b")
    let mut n = 0
    for _v in s.into_iter() {
        n = n + 1
    }
    assert_eq(n, 2)
}

test "for-in over a filtered struct iterator var reads struct fields" {
    let a: List[Pt] = [Pt { x: 1, y: 2 }, Pt { x: -1, y: 9 }, Pt { x: 3, y: 4 }]
    let it = a.into_iter().filter(fn(p: Pt) -> Bool { p.x > 0 })
    let mut sum = 0
    for p in it {
        sum = sum + p.x + p.y
    }
    assert_eq(sum, 10)
}

test "a struct iterator alias loops the same struct elements" {
    let a: List[Pt] = [Pt { x: 5, y: 6 }, Pt { x: 7, y: 8 }]
    let it = a.into_iter().take(2)
    let alias = it
    let mut sum = 0
    for p in alias {
        sum = sum + p.x
    }
    assert_eq(sum, 12)
}

fn two_sets() -> List[Set[Int]] {
    let mut a: Set[Int] = Set()
    a.insert(1)
    a.insert(2)
    let mut b: Set[Int] = Set()
    b.insert(3)
    b.insert(4)
    [a, b]
}

test "a CONTAINER-element iterator var loops each set" {
    let r = two_sets()
    let it = r.into_iter()
    let mut total = 0
    for g in it {
        for x in g { total = total + x }
    }
    assert_eq(total, 10)
}

test "a CONTAINER-element iterator alias loops each set" {
    let r = two_sets()
    let it = r.into_iter()
    let alias = it
    let mut total = 0
    for g in alias {
        for x in g { total = total + x }
    }
    assert_eq(total, 10)
}

test "a lazy filter over a CONTAINER element keeps each set" {
    let r = two_sets()
    let it = r.into_iter().filter(fn(g: Set[Int]) -> Bool { g.contains(1) })
    let mut total = 0
    for g in it {
        for x in g { total = total + x }
    }
    assert_eq(total, 3)
}
