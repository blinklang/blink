// enumerate()/zip() on an Iterator materialize eagerly to a List (spec-permitted
// for a finite intermediate) and drop the Iterator tid. The collect() step after
// enumerate() must still compile; today it emits a malformed cast to a
// nonexistent blink_Option_void.

import compile_test_helpers.{compile_and_run}

test.failing(
    "enumerate on a List iterator followed by collect compiles and runs",
    reason: "collect() chained after enumerate() on a List's into_iter() emits a malformed cast to a nonexistent type ((blink_Option_void (*)(void*)))(&__enum_2) with a missing function pointer target, a syntax-level C compile error, worse than the originally-documented lazy-contract/Iterator-tid gap which the ticket recorded as a passing guard",
    ticket: "3fkkv3",
) {
    let src = #"
import std.io

fn main() ! IO {
    let a: List[Int] = [10, 20]
    let out = a.into_iter().enumerate().collect()
    io.println("{out.len()}")
}
"#
    let r = compile_and_run(src, "_iterator_enumerate_collect_after_zip_materialize")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "2\n")
}
