// enumerate() on an Iterator stays lazy, and the collect() after it pulls pairs off that
// recipe into a List. Both steps must compile and run.

import compile_test_helpers.{compile_and_run}

test "enumerate on a List iterator followed by collect compiles and runs" {
    let src = #"
import std.io

fn main() ! IO {
    let a: List[Int] = [10, 20]
    let out = a.into_iter().enumerate().collect()
    io.println("{out.len()}")
}
"#
    let r = compile_and_run(src, "_iterator_enumerate_collect_after_zip_materialize")
    assert(r.exit_code == 0, "compile or run failed: {r.out}{r.err_out}")
    assert_eq(r.out, "2\n")
}
