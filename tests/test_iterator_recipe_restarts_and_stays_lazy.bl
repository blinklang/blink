// An Iterator is a restartable recipe (sections/03c_protocols.md): a copy shares no
// cursor, a second traversal starts over, and no element is touched until a consumer
// or a for loop pulls from the end.

import compile_test_helpers.{expect_compile_error}

type Holder {
    it: Iterator[Int]
}

type Pt {
    x: Int
    y: Int
}

fn evens_of(xs: List[Int]) -> Iterator[Int] {
    xs.into_iter().filter(fn(x: Int) -> Bool { x % 2 == 0 })
}

test "a second collect of one iterator starts over" {
    let it = [1, 2, 3, 4, 5, 6].into_iter().filter(fn(x: Int) -> Bool { x % 2 == 0 })
    let a = it.collect()
    let b = it.collect()
    assert_eq(a.len(), 3)
    assert_eq(b.len(), 3)
    assert_eq(b.get(0).unwrap(), 2)
}

test "a copy of an iterator shares no position" {
    let a = [10, 20, 30].into_iter()
    let b = a
    assert_eq(b.take(2).count(), 2)
    assert_eq(a.collect().get(0).unwrap(), 10)
}

test "an adapter runs no closure until something consumes" {
    let mut calls = 0
    let it = [1, 2, 3].into_iter().map(fn(x: Int) -> Int {
        calls = calls + 1
        x * 2
    })
    assert_eq(calls, 0)
    let got = it.take(2).collect()
    assert_eq(got.len(), 2)
    assert_eq(calls, 2)
}

test "a for loop walks an iterator" {
    let mut sum = 0
    for x in [1, 2, 3, 4].into_iter().skip(1) {
        sum = sum + x
    }
    assert_eq(sum, 9)
}

test "an iterator returned from a function and stored in a field" {
    let h = Holder { it: evens_of([1, 2, 3, 4]) }
    let got = h.it.collect()
    assert_eq(got.len(), 2)
    assert_eq(got.get(1).unwrap(), 4)
}

test "an iterator over Str elements maps to another element type" {
    let words: List[Str] = ["a", "bb", "ccc"]
    let lens = words.into_iter().filter(fn(w: Str) -> Bool { w.len() > 1 }).map(fn(w: Str) -> Int { w.len() }).collect()
    assert_eq(lens.len(), 2)
    assert_eq(lens.get(1).unwrap(), 3)
}

test "an iterator over struct elements" {
    let pts = [Pt { x: 1, y: 2 }, Pt { x: 3, y: 4 }]
    let ys = pts.into_iter().map(fn(p: Pt) -> Int { p.y }).collect()
    assert_eq(ys.get(1).unwrap(), 4)
}

test "a Set enters the lazy world" {
    let mut s: Set[Int] = Set()
    s.insert(5)
    s.insert(7)
    assert_eq(s.into_iter().fold(0, fn(acc: Int, x: Int) -> Int { acc + x }), 12)
}

test "chain, enumerate and zip stay lazy and collect" {
    let a = [1, 2].into_iter().chain([3].into_iter())
    assert_eq(a.count(), 3)
    let pairs = [7, 8].into_iter().enumerate().collect()
    assert_eq(pairs.get(1).unwrap().0, 1)
    let z = [1, 2, 3].into_iter().zip(["a", "b"].into_iter()).collect()
    assert_eq(z.len(), 2)
}

// The carrier's inside is the standard library's own business: the helpers that open
// and build one are private to std.iter, so the seal holds against an explicit import.
test "a program cannot open an iterator through std.iter" {
    let src = "import std.iter\n\nfn main() \{\n    let r = iter.iter_recipe([1].into_iter())\n}\n"
    expect_compile_error(src, "iter_recipe_private", "E1003")
}

test "a program cannot call an iterator adapter body through std.iter" {
    let src = "import std.iter.\{iter_filter}\n\nfn main() \{\n    let n = iter_filter([1].into_iter(), fn(x: Int) -> Bool \{ x > 0 }).count()\n}\n"
    expect_compile_error(src, "iter_filter_private", "E1003")
}
