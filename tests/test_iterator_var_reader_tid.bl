// jctkac: get_var_iterator_inner reads a CT_ITERATOR var's element off the tid.
// test_jctkac_sv_inner_tid rows 4/5 pin the reader through the adapter+collect
// chain; these rows pin the two reader sites that chain does not reach — a for-in
// DIRECTLY over an iterator var (codegen_stmt for-in CT_ITERATOR branch) and an
// iterator-var ALIAS (`let b = it`, codegen_stmt CT_ITERATOR copy branch). Both
// take the element CT from get_var_iterator_inner, so a mistyped element flips the
// collected/looped scalar. Int/Str/Float exercise distinct scalar element widths.

test "for-in over an Int iterator var sums its elements" {
    let a: List[Int] = [1, 2, 3, 4]
    let it = a.into_iter().filter(fn(x: Int) -> Bool { x % 2 == 0 })
    let mut total = 0
    for x in it {
        total = total + x
    }
    assert_eq(total, 6)
}

test "for-in over a Str iterator var concatenates its elements" {
    let b: List[Str] = ["a", "b", "c"]
    let it = b.into_iter()
    let mut out = ""
    for s in it {
        out = out.concat(s)
    }
    assert_eq(out, "abc")
}

test "for-in over a Float iterator var sums its elements" {
    let f: List[Float] = [1.5, 2.5, 3.0]
    let it = f.into_iter()
    let mut sum = 0.0
    for v in it {
        sum = sum + v
    }
    assert_eq(sum, 7.0)
}

test "an Int iterator alias collects the same elements" {
    let a: List[Int] = [10, 20, 30, 40]
    let it = a.into_iter().take(3)
    let alias = it
    let got = alias.collect()
    assert_eq(got.len(), 3)
    assert_eq(got.get(0).unwrap(), 10)
    assert_eq(got.get(2).unwrap(), 30)
}

test "a Float iterator alias loops the same elements" {
    let f: List[Float] = [1.0, 2.0, 3.0]
    let it = f.into_iter()
    let alias = it
    let mut sum = 0.0
    for v in alias {
        sum = sum + v
    }
    assert_eq(sum, 6.0)
}
