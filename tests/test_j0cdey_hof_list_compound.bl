// j0cdey: higher-order functions (.map/.filter/.for_each/.fold/.any/.all/.find/
// .count/.take/.skip/.chain/.flat_map/.enumerate/.zip) on a
// `List[Option[T]]` / `List[Result[T,E]]` emitted UNDEFINED C — iter_from_source
// keyed the list iterator on `c_type_tag(CT_OPTION)="option"`, producing
// `blink_list_into_iter_option` / `blink_Option_option` / a `void` closure arg.
// The element compound is pointer-boxed on the list (gemr3z), so the HOF path must
// route it through the generic pointer iterator and deref the carrier before
// handing it to the closure/adapter. These runtime asserts reach their
// comparisons only if each HOF decodes the compound element correctly.

test "List[Option[Int]] for_each" {
    let c: List[Option[Int]] = [Some(9), None, Some(4)]
    let mut sum = 0
    c.for_each(fn(x: Option[Int]) {
        match x {
            Some(v) => sum = sum + v
            None => sum = sum + 100
        }
    })
    assert_eq(sum, 113)
}

test "List[Option[Int]] fold" {
    let c: List[Option[Int]] = [Some(1), Some(2), None, Some(3)]
    let total = c.fold(0, fn(acc: Int, x: Option[Int]) -> Int {
        match x {
            Some(v) => acc + v
            None => acc
        }
    })
    assert_eq(total, 6)
}

test "List[Option[Int]] any / all" {
    let c: List[Option[Int]] = [Some(2), None, Some(4)]
    let has_none = c.any(fn(x: Option[Int]) -> Bool { x.is_none() })
    let all_some = c.all(fn(x: Option[Int]) -> Bool { x.is_some() })
    assert(has_none)
    assert(!all_some)
}

test "List[Option[Int]] count" {
    let c: List[Option[Int]] = [Some(1), None, Some(3), None]
    assert_eq(c.count(), 4)
}

// z9gkt3: the lazy ADAPTER HOFs over a compound source — .map/.filter/.take/
// .skip/.chain/.flat_map — now decode the pointer-boxed compound element via a
// per-carrier adapter iterator (blink_MapIterator_Option_int, keyed on the
// carrier tag not the element CT) that derefs the boxed carrier by value before
// handing it to the closure. Below: one test per adapter over List[Option[Int]]
// and List[Result[Int,Str]], plus nested-container compositions and the
// scalar-forward List[Map[K,V]] path (guards the guard removal).

test "List[Option[Int]] filter().count()" {
    let c: List[Option[Int]] = [Some(1), None, Some(3)]
    let n = c.filter(fn(x: Option[Int]) -> Bool { x.is_some() }).count()
    assert_eq(n, 2)
}

test "List[Option[Int]] map(is_some) decodes carrier" {
    let c: List[Option[Int]] = [Some(1), None, Some(3)]
    // closure RETURNS a scalar Bool — map forward element keys on the return.
    let flags: List[Bool] = c.map(fn(x: Option[Int]) -> Bool { x.is_some() })
    assert_eq(flags.len(), 3)
    assert(flags.get(0).unwrap())
    assert(!flags.get(1).unwrap())
    assert(flags.get(2).unwrap())
}

test "List[Option[Int]] map(unwrap_or) non-identity" {
    let c: List[Option[Int]] = [Some(5), None, Some(7)]
    let vals: List[Int] = c.map(fn(x: Option[Int]) -> Int {
        match x {
            Some(v) => v
            None => 0
        }
    })
    assert_eq(vals.len(), 3)
    assert_eq(vals.get(0).unwrap(), 5)
    assert_eq(vals.get(1).unwrap(), 0)
    assert_eq(vals.get(2).unwrap(), 7)
}

test "List[Option[Int]] take(2) keeps carrier" {
    let c: List[Option[Int]] = [Some(1), None, Some(3), Some(4)]
    let taken: List[Option[Int]] = c.take(2)
    assert_eq(taken.len(), 2)
    match taken.get(0).unwrap() {
        Some(v) => assert_eq(v, 1)
        None => assert(false)
    }
    assert(taken.get(1).unwrap().is_none())
}

test "List[Option[Int]] skip(1) keeps carrier" {
    let c: List[Option[Int]] = [Some(1), None, Some(3)]
    let rest: List[Option[Int]] = c.skip(1)
    assert_eq(rest.len(), 2)
    assert(rest.get(0).unwrap().is_none())
    match rest.get(1).unwrap() {
        Some(v) => assert_eq(v, 3)
        None => assert(false)
    }
}

test "List[Option[Int]] chain().count() keeps carrier" {
    let a: List[Option[Int]] = [Some(1), None]
    let b: List[Option[Int]] = [Some(3), None, Some(5)]
    assert_eq(a.chain(b).count(), 5)
    let joined: List[Option[Int]] = a.chain(b)
    assert_eq(joined.len(), 5)
    assert(joined.get(1).unwrap().is_none())
    match joined.get(2).unwrap() {
        Some(v) => assert_eq(v, 3)
        None => assert(false)
    }
}

test "List[Option[Int]] flat_map decodes carrier" {
    let c: List[Option[Int]] = [Some(2), None, Some(3)]
    let expanded: List[Int] = c.flat_map(fn(x: Option[Int]) -> List[Int] {
        match x {
            Some(v) => [v, v]
            None => []
        }
    })
    assert_eq(expanded.len(), 4)
    assert_eq(expanded.get(0).unwrap(), 2)
    assert_eq(expanded.get(1).unwrap(), 2)
    assert_eq(expanded.get(2).unwrap(), 3)
    assert_eq(expanded.get(3).unwrap(), 3)
}

test "List[Result[Int,Str]] filter().count()" {
    let c: List[Result[Int, Str]] = [Ok(1), Err("x"), Ok(3)]
    let n = c.filter(fn(x: Result[Int, Str]) -> Bool { x.is_ok() }).count()
    assert_eq(n, 2)
}

test "List[Result[Int,Str]] map()" {
    let c: List[Result[Int, Str]] = [Ok(4), Err("x"), Ok(6)]
    let vals: List[Int] = c.map(fn(x: Result[Int, Str]) -> Int {
        match x {
            Ok(v) => v
            Err(_e) => -1
        }
    })
    assert_eq(vals.len(), 3)
    assert_eq(vals.get(0).unwrap(), 4)
    assert_eq(vals.get(1).unwrap(), -1)
    assert_eq(vals.get(2).unwrap(), 6)
}

test "List[Option[List[Int]]] filter().count() nested-container carrier" {
    let a: List[Int] = [1, 2]
    let b: List[Int] = [3]
    let c: List[Option[List[Int]]] = [Some(a), None, Some(b)]
    let n = c.filter(fn(x: Option[List[Int]]) -> Bool { x.is_some() }).count()
    assert_eq(n, 2)
}

test "List[Option[Map[Int,Str]]] filter().count() nested-container carrier" {
    let mut m: Map[Int, Str] = Map()
    m.insert(1, "a")
    let c: List[Option[Map[Int, Str]]] = [Some(m), None]
    let n = c.filter(fn(x: Option[Map[Int, Str]]) -> Bool { x.is_some() }).count()
    assert_eq(n, 1)
}

// List[Map[K,V]] element rides the SCALAR forward path (list_compound_carrier_tag
// returns "" for a bare Map — Map is not Option/Result). Verify that path is
// correct after the guard removal — do not assume.
test "List[Map[Int,Str]] filter().count() scalar-forward path" {
    let mut m1: Map[Int, Str] = Map()
    m1.insert(1, "a")
    let mut m2: Map[Int, Str] = Map()
    let c: List[Map[Int, Str]] = [m1, m2]
    let n = c.filter(fn(m: Map[Int, Str]) -> Bool { m.len() > 0 }).count()
    assert_eq(n, 1)
}

test "List[Option[Int]] find first none" {
    let c: List[Option[Int]] = [Some(1), Some(2), None, Some(4)]
    let found = c.find(fn(x: Option[Int]) -> Bool { x.is_none() })
    assert(found.is_some())
    match found {
        Some(inner) => assert(inner.is_none())
        None => assert(false)
    }
}

// z9gkt3: .take/.skip are lazy ADAPTERS too (return a CT_ITERATOR) — they carry
// the boxed carrier through verbatim (only the typedef NAME changes so a
// same-TU scalar iter can't collide) and store the carrier tag on the iterator
// var's sname channel so a downstream for-in / element read re-decodes it.
// Exercised by the take/skip tests above.

test "List[Option[Str]] for_each accumulates" {
    let c: List[Option[Str]] = [Some("a"), None, Some("b")]
    let mut acc = ""
    c.for_each(fn(x: Option[Str]) {
        match x {
            Some(s) => acc = acc.concat(s)
            None => acc = acc.concat("_")
        }
    })
    assert_eq(acc, "a_b")
}

test "List[Result[Int, Str]] for_each" {
    let c: List[Result[Int, Str]] = [Ok(7), Err("bad"), Ok(3)]
    let mut sum = 0
    let mut errs = 0
    c.for_each(fn(x: Result[Int, Str]) {
        match x {
            Ok(v) => sum = sum + v
            Err(_e) => errs = errs + 1
        }
    })
    assert_eq(sum, 10)
    assert_eq(errs, 1)
}

test "List[Result[Int, Str]] fold" {
    let c: List[Result[Int, Str]] = [Ok(1), Err("x"), Ok(2)]
    let total = c.fold(0, fn(acc: Int, x: Result[Int, Str]) -> Int {
        match x {
            Ok(v) => acc + v
            Err(_e) => acc
        }
    })
    assert_eq(total, 3)
}

test "List[Result[Int, Str]] any is_err" {
    let c: List[Result[Int, Str]] = [Ok(1), Err("x"), Ok(2)]
    let has_err = c.any(fn(x: Result[Int, Str]) -> Bool { x.is_err() })
    assert(has_err)
}

test "List[Result[Int, Str]] find first ok" {
    let c: List[Result[Int, Str]] = [Err("a"), Ok(7), Err("b")]
    let found = c.find(fn(x: Result[Int, Str]) -> Bool { x.is_ok() })
    assert(found.is_some())
    match found {
        Some(inner) => {
            match inner {
                Ok(v) => assert_eq(v, 7)
                Err(_e) => assert(false)
            }
        }
        None => assert(false)
    }
}

test "List[Option[Map[Int, Str]]] for_each composes with whg65a" {
    let mut m1: Map[Int, Str] = Map()
    m1.insert(1, "x")
    let mut m2: Map[Int, Str] = Map()
    m2.insert(1, "y")
    let c: List[Option[Map[Int, Str]]] = [Some(m1), None, Some(m2)]
    let mut acc = ""
    c.for_each(fn(x: Option[Map[Int, Str]]) {
        match x {
            Some(mm) => {
                match mm.get(1) {
                    Some(s) => acc = acc.concat(s)
                    None => {}
                }
            }
            None => acc = acc.concat("_")
        }
    })
    assert_eq(acc, "x_y")
}
