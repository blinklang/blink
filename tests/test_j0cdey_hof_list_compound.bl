// j0cdey: higher-order functions (.map/.filter/.for_each/.fold/.any/.all/.find/
// .count/.take/.skip/.chain/.flat_map/.enumerate/.zip/.collect) on a
// `List[Option[T]]` / `List[Result[T,E]]` emitted UNDEFINED C — iter_from_source
// keyed the list iterator on `c_type_tag(CT_OPTION)="option"`, producing
// `blink_list_into_iter_option` / `blink_Option_option` / a `void` closure arg.
// The element compound is pointer-boxed on the list (gemr3z), so the HOF path must
// route it through the generic pointer iterator and deref the carrier before
// handing it to the closure/adapter. These runtime asserts reach their
// comparisons only if each HOF decodes the compound element correctly.

test "List[Option[Int]] for_each" {
    let c: List[Option[Int]] = [Some(9), None, Some(4)]
    let mut sum = 0
    c.for_each(fn(x: Option[Int]) {
        match x {
            Some(v) => sum = sum + v
            None => sum = sum + 100
        }
    })
    assert_eq(sum, 113)
}

test "List[Option[Int]] fold" {
    let c: List[Option[Int]] = [Some(1), Some(2), None, Some(3)]
    let total = c.fold(0, fn(acc: Int, x: Option[Int]) -> Int {
        match x {
            Some(v) => acc + v
            None => acc
        }
    })
    assert_eq(total, 6)
}

test "List[Option[Int]] any / all" {
    let c: List[Option[Int]] = [Some(2), None, Some(4)]
    let has_none = c.any(fn(x: Option[Int]) -> Bool { x.is_none() })
    let all_some = c.all(fn(x: Option[Int]) -> Bool { x.is_some() })
    assert(has_none)
    assert(!all_some)
}

test "List[Option[Int]] count" {
    let c: List[Option[Int]] = [Some(1), None, Some(3), None]
    assert_eq(c.count(), 4)
}

// NOTE: the lazy ADAPTER HOFs over a compound source — .map / .filter / .chain /
// .flat_map / .enumerate / .zip — are deferred to a follow-up (the adapter C
// templates blink_MapIterator/blink_FilterIterator/… are keyed on the element CT
// and can't yet deref a per-carrier pointer-boxed compound). The EAGER consumers
// below (for_each/fold/any/all/find/count/take/skip/collect) all decode the
// compound element correctly.

test "List[Option[Int]] find first none" {
    let c: List[Option[Int]] = [Some(1), Some(2), None, Some(4)]
    let found = c.find(fn(x: Option[Int]) -> Bool { x.is_none() })
    assert(found.is_some())
    match found {
        Some(inner) => assert(inner.is_none())
        None => assert(false)
    }
}

// NOTE: .take / .skip are also lazy ADAPTERS (return a CT_ITERATOR keyed on the
// element CT) — deferred to z9gkt3 alongside .map/.filter/…: over a List[compound]
// they lose the pointer-boxed carrier, so a downstream collect/decode is wrong.
// They now fail loudly (guarded in emit_list_method), not silently.

test "List[Option[Str]] for_each accumulates" {
    let c: List[Option[Str]] = [Some("a"), None, Some("b")]
    let mut acc = ""
    c.for_each(fn(x: Option[Str]) {
        match x {
            Some(s) => acc = acc.concat(s)
            None => acc = acc.concat("_")
        }
    })
    assert_eq(acc, "a_b")
}

test "List[Result[Int, Str]] for_each" {
    let c: List[Result[Int, Str]] = [Ok(7), Err("bad"), Ok(3)]
    let mut sum = 0
    let mut errs = 0
    c.for_each(fn(x: Result[Int, Str]) {
        match x {
            Ok(v) => sum = sum + v
            Err(_e) => errs = errs + 1
        }
    })
    assert_eq(sum, 10)
    assert_eq(errs, 1)
}

test "List[Result[Int, Str]] fold" {
    let c: List[Result[Int, Str]] = [Ok(1), Err("x"), Ok(2)]
    let total = c.fold(0, fn(acc: Int, x: Result[Int, Str]) -> Int {
        match x {
            Ok(v) => acc + v
            Err(_e) => acc
        }
    })
    assert_eq(total, 3)
}

test "List[Result[Int, Str]] any is_err" {
    let c: List[Result[Int, Str]] = [Ok(1), Err("x"), Ok(2)]
    let has_err = c.any(fn(x: Result[Int, Str]) -> Bool { x.is_err() })
    assert(has_err)
}

test "List[Result[Int, Str]] find first ok" {
    let c: List[Result[Int, Str]] = [Err("a"), Ok(7), Err("b")]
    let found = c.find(fn(x: Result[Int, Str]) -> Bool { x.is_ok() })
    assert(found.is_some())
    match found {
        Some(inner) => {
            match inner {
                Ok(v) => assert_eq(v, 7)
                Err(_e) => assert(false)
            }
        }
        None => assert(false)
    }
}

test "List[Option[Map[Int, Str]]] for_each composes with whg65a" {
    let mut m1: Map[Int, Str] = Map()
    m1.insert(1, "x")
    let mut m2: Map[Int, Str] = Map()
    m2.insert(1, "y")
    let c: List[Option[Map[Int, Str]]] = [Some(m1), None, Some(m2)]
    let mut acc = ""
    c.for_each(fn(x: Option[Map[Int, Str]]) {
        match x {
            Some(mm) => {
                match mm.get(1) {
                    Some(s) => acc = acc.concat(s)
                    None => {}
                }
            }
            None => acc = acc.concat("_")
        }
    })
    assert_eq(acc, "x_y")
}
