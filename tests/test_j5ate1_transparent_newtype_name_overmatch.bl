// The transparent-newtype classifier covers ONE type: std.errno.Errno. Errno lowers to a bare
// int64_t, so a collection read materializes it by value and drops the box. A user type must
// not get that treatment.
//
// The old name gate matched any tag that ends in `_Errno`, then read the real Errno's shape.
// So a user type named `Foo_Errno` (the same single-Int shape) passed both gates and lost its
// box. A single-Int payload survives a dropped box, so a value round-trip cannot show the bug.
// The visible symptom is the derived Debug: the misclassified type gets no `.debug()` method
// and its variant name disappears. `Foo_Ctrl` has the same shape but a name that does not end
// in `_Errno` — it renders normally, which proves the NAME gate discriminates, not the shape.
//
// In the corpus so the shape is the real self-hosted build, not a compile_and_run string
// (feedback_corpus_sweep_is_not_coverage).

@derive(Debug)
type Foo_Errno { Foo_Errno(Int) }

@derive(Debug)
type Foo_Ctrl { Foo_Ctrl(Int) }

test "a user type named Foo_Errno keeps its box through a List read (debug renders the variant)" {
    let xs: List[Foo_Errno] = [Foo_Errno(10), Foo_Errno(20)]
    let e = xs.get(0).unwrap()
    assert_eq(e.debug(), "Foo_Errno(10)")
    let f = xs.get(1).unwrap()
    assert_eq(f.debug(), "Foo_Errno(20)")
}

test "a same-shape control type not ending in _Errno renders its variant (name gate, not shape)" {
    let xs: List[Foo_Ctrl] = [Foo_Ctrl(10), Foo_Ctrl(20)]
    let e = xs.get(0).unwrap()
    assert_eq(e.debug(), "Foo_Ctrl(10)")
    let f = xs.get(1).unwrap()
    assert_eq(f.debug(), "Foo_Ctrl(20)")
}

test "a Foo_Errno payload still round-trips its Int through a match after a collection read" {
    let xs: List[Foo_Errno] = [Foo_Errno(3), Foo_Errno(7)]
    let a = match xs.get(0).unwrap() { Foo_Errno(code) => code }
    assert_eq(a, 3)
    let b = match xs.get(1).unwrap() { Foo_Errno(code) => code }
    assert_eq(b, 7)
}
