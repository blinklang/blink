// br j8krjg: triple-nested Result destructuring — a match binder at nesting
// depth 3 (the innermost Ok/Err arm of Result[Result[Result[Int,Str],Str],Str])
// was reportedly left undeclared in the emitted C. The ticket was filed while
// fixing the 2bd4aa nested-carrier *construction* bug and describes the remaining
// *destructuring* axis. It has since been fixed by the compound-carrier commit
// family (4192342, c1a6128); this regression locks the depth-3/depth-4
// nested-match destructuring in so it cannot silently regress. (See sibling
// test_2bd4aa_nested_result_carrier.bl for the construction axis.)

test "depth-3 Ok(Ok(Ok(v))) destructured via nested match statements" {
    let r: Result[Result[Result[Int, Str], Str], Str] = Ok(Ok(Ok(7)))
    match r {
        Ok(a) => {
            match a {
                Ok(b) => {
                    match b {
                        Ok(v) => { assert_eq(v, 7) }
                        Err(_e) => { assert(false) }
                    }
                }
                Err(_e) => { assert(false) }
            }
        }
        Err(_e) => { assert(false) }
    }
}

test "depth-3 Err in the innermost slot binds its payload" {
    let r: Result[Result[Result[Int, Str], Str], Str] = Ok(Ok(Err("boom")))
    match r {
        Ok(a) => {
            match a {
                Ok(b) => {
                    match b {
                        Ok(_v) => { assert(false) }
                        Err(e) => { assert_eq(e, "boom") }
                    }
                }
                Err(_e) => { assert(false) }
            }
        }
        Err(_e) => { assert(false) }
    }
}

test "depth-4 Ok(Ok(Ok(Ok(v)))) destructured via nested match statements" {
    let r: Result[Result[Result[Result[Int, Str], Str], Str], Str] = Ok(Ok(Ok(Ok(9))))
    match r {
        Ok(a) => {
            match a {
                Ok(b) => {
                    match b {
                        Ok(c) => {
                            match c {
                                Ok(v) => { assert_eq(v, 9) }
                                Err(_e) => { assert(false) }
                            }
                        }
                        Err(_e) => { assert(false) }
                    }
                }
                Err(_e) => { assert(false) }
            }
        }
        Err(_e) => { assert(false) }
    }
}
