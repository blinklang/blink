test "C7: Box[List[Option[Map[Str,Int]]]] recurses two levels deep (the depth witness)" {
    let c = compile_test_helpers.compile_and_emit_c(src_c7(), "jcr0zz_c7_c")
    assert_has(c, "Option_Map_str_int", "C7 / two-level carrier tag present")
    assert_lacks(c, "blink_Option_map", "C7 / not collapsed to a flat map default")
    let r = compile_test_helpers.compile_and_run(src_c7(), "jcr0zz_c7_run")
    if r.exit_code != 0 { io.println("FAIL: C7 runtime — {r.err_out}") }
    assert(r.exit_code == 0)
}

fn src_c8() -> Str {
    let mut s = box_decl()
    s = s.concat("fn main() \{\n")
    s = s.concat("    let b: Box[List[Option[Str]]] = Box \{ v: [Some(\"x\"), None] }\n")
    s = s.concat("    for item in b.v \{\n")
    s = s.concat("        if item.is_some() \{ io.println(\"got \{item.unwrap()}\") } else \{ io.println(\"none\") }\n")
    s = s.concat("    }\n")
    s = s.concat("}\n")
    s
}

test "C8: for-in over b.v reads the Option element through the GLOBAL elem-type channel" {
    let r = compile_test_helpers.compile_and_run(src_c8(), "jcr0zz_c8_run")
    if r.exit_code != 0 { io.println("FAIL: C8 runtime — {r.err_out}") }
    assert(r.exit_code == 0)
    assert(r.out.contains("got x"))
    assert(r.out.contains("none"))
}

fn src_c9() -> Str {
    let mut s = box_decl()
    s = s.concat("fn main() \{\n")
    s = s.concat("    let b: Box[List[Result[Int, Str]]] = Box \{ v: [Ok(7)] }\n")
    s = s.concat("    let g = b.v\n")
    s = s.concat("    assert(g.pop().unwrap().unwrap() == 7)\n")
