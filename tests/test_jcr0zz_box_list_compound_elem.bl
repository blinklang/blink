fn src_c10() -> Str {
    let mut s = box_decl()
    s = s.concat("fn main() \{\n")
    s = s.concat("    let bo: Box[List[Option[Str]]] = Box \{ v: [Some(\"a\")] }\n")
    s = s.concat("    let br: Box[List[Result[Int, Str]]] = Box \{ v: [Ok(1)] }\n")
    s = s.concat("    let bm: Box[List[Map[Str, Int]]] = Box \{ v: [Map()] }\n")
    s = s.concat("    let m: Map[Str, Int] = Map()\n")
    s = s.concat("    m.insert(\"k\", 9)\n")
    s = s.concat("    let bom: Box[List[Option[Map[Str, Int]]]] = Box \{ v: [Some(m)] }\n")
    s = s.concat("    let go = bo.v\n")
    s = s.concat("    let gr = br.v\n")
    s = s.concat("    let gm = bm.v\n")
    s = s.concat("    let gom = bom.v\n")
    s = s.concat("    assert(go.get(0).unwrap().unwrap() == \"a\")\n")
    s = s.concat("    assert(gr.get(0).unwrap().unwrap() == 1)\n")
    s = s.concat("    assert(gm.get(0).unwrap().len() == 0)\n")
    s = s.concat("    assert(gom.get(0).unwrap().unwrap().get(\"k\").unwrap() == 9)\n")
    s = s.concat("}\n")
    s
}

test "C10: Option/Result/Map/nested-Option-Map slots all live in one main, sharing one symbol" {
    let c = compile_test_helpers.compile_and_emit_c(src_c10(), "jcr0zz_c10_c")
    assert_has(c, "blink_Box_List", "C10 / one shared List symbol")
    assert_lacks(c, "blink_Box_List_Option", "C10 / no per-element List symbol")
    let r = compile_test_helpers.compile_and_run(src_c10(), "jcr0zz_c10_run")
    if r.exit_code != 0 { io.println("FAIL: C10 runtime — {r.err_out}") }
    assert(r.exit_code == 0)
}

fn src_c11() -> Str {
    let mut s = box_decl()
    s = s.concat("fn main() \{\n")
    s = s.concat("    let b: Box[List[Set[Str]]] = Box \{ v: [Set()] }\n")
    s = s.concat("    let g = b.v\n")
    s = s.concat("    let _n = g.get(0).unwrap().len()\n")
