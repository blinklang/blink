    s = s.concat("    let g = b.v\n")
    s = s.concat("    assert(g.get(0).unwrap().get(\"k\").unwrap() == 5)\n")
    s = s.concat("}\n")
    s
}

test "C4: Box[List[Map[Str,Int]]] recovers the Map element through an unannotated re-bind" {
    let r = compile_test_helpers.compile_and_run(src_c4(), "jcr0zz_c4_run")
