    s = s.concat("    let xs: List[Option[QBox[Int]]] = [Some(QBox \{ v: 9 })]\n")
    s = s.concat("    assert(xs.get(0).unwrap().unwrap().v == 9)\n")
    s = s.concat("}\n")
    s
}

test "C6b: DECLARED List[Option[QBox[Int]]] also spells the mono stem (the §3 fold-in)" {
    let c = compile_test_helpers.compile_and_emit_c(src_c6b(), "jcr0zz_c6b_c")
