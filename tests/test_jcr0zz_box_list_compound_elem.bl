fn src_c5() -> Str {
    let mut s = "type Point \{ x: Int, y: Int }\n"
    s = s.concat(box_decl())
    s = s.concat("fn main() \{\n")
    s = s.concat("    let b: Box[List[Option[Point]]] = Box \{ v: [Some(Point \{ x: 3, y: 4 })] }\n")
    s = s.concat("    let g = b.v\n")
    s = s.concat("    let p = g.get(0).unwrap().unwrap()\n")
    s = s.concat("    assert(p.x == 3)\n")
    s = s.concat("}\n")
    s
}

test "C5: Box[List[Option[Point]]] recovers a struct leaf nested inside Option" {
    let r = compile_test_helpers.compile_and_run(src_c5(), "jcr0zz_c5_run")
    if r.exit_code != 0 { io.println("FAIL: C5 runtime — {r.err_out}") }
    assert(r.exit_code == 0)
}

fn src_c6() -> Str {
    let mut s = "type QBox[T] \{ v: T }\n"
    s = s.concat(box_decl())
    s = s.concat("fn main() \{\n")
    s = s.concat("    let b: Box[List[Option[QBox[Int]]]] = Box \{ v: [Some(QBox \{ v: 9 })] }\n")
    s = s.concat("    let g = b.v\n")
    s = s.concat("    assert(g.get(0).unwrap().unwrap().v == 9)\n")
    s = s.concat("}\n")
    s
}

test "C6: Box[List[Option[QBox[Int]]]] spells the mono STEM, not the bare generic head" {
    let c = compile_test_helpers.compile_and_emit_c(src_c6(), "jcr0zz_c6_c")
    assert_has(c, "blink_QBox_Int", "C6 / mono stem present")
    assert_lacks(c, "blink_Option_QBox;", "C6 / not the bare-head Option carrier")
    let r = compile_test_helpers.compile_and_run(src_c6(), "jcr0zz_c6_run")
    if r.exit_code != 0 { io.println("FAIL: C6 runtime — {r.err_out}") }
    assert(r.exit_code == 0)
}

fn src_c6b() -> Str {
    let mut s = "type QBox[T] \{ v: T }\n"
