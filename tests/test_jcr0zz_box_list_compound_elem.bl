}

fn src_c7() -> Str {
    let mut s = box_decl()
    s = s.concat("fn main() \{\n")
    s = s.concat("    let m: Map[Str, Int] = Map()\n")
    s = s.concat("    m.insert(\"k\", 5)\n")
