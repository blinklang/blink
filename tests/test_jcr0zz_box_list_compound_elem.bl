}

test "C11 NEGATIVE: Box[List[Set[Str]]] stays honestly erased — no parity target" {
    compile_test_helpers.expect_compile_error(src_c11(), "jcr0zz_c11", "UnresolvedMethod")
}

fn src_c12() -> Str {
    "fn main() \{\n    let d: List[Set[Str]] = [Set()]\n    let _n = d.get(0).unwrap().len()\n}\n"
}

test "C12 NEGATIVE TWIN: DECLARED List[Set[Str]] fails identically — C11 is parity, not a regression" {
    compile_test_helpers.expect_compile_error(src_c12(), "jcr0zz_c12", "UnresolvedMethod")
}

fn src_c13() -> Str {
    "type Holder \{ xs: List[Option[Str]] }\nfn main() \{\n    let h = Holder \{ xs: [Some(\"a\"), None] }\n    assert(h.xs.get(0).unwrap().unwrap() == \"a\")\n}\n"
}

test "C13 GREEN CONTROL: a non-generic declared List[Option[Str]] field is unaffected" {
    let r = compile_test_helpers.compile_and_run(src_c13(), "jcr0zz_c13_run")
    if r.exit_code != 0 { io.println("FAIL: C13 runtime — {r.err_out}") }
    assert(r.exit_code == 0)
}

fn src_c14() -> Str {
    let mut s = "type Point \{ x: Int, y: Int }\n"
    s = s.concat(box_decl())
    s = s.concat("fn main() \{\n")
    s = s.concat("    let a: Box[List[List[Str]]] = Box \{ v: [[\"a\", \"b\"]] }\n")
    s = s.concat("    let inner = a.v.get(0).unwrap()\n")
    s = s.concat("    assert(inner.get(1).unwrap() == \"b\")\n")
    s = s.concat("    let p: Box[List[Point]] = Box \{ v: [Point \{ x: 3, y: 4 }] }\n")
    s = s.concat("    assert(p.v.get(0).unwrap().x == 3)\n")
    s = s.concat("}\n")
    s
}

test "C14 GREEN CONTROL: nested List and plain-struct elements are unaffected (§4e untouched)" {
    let r = compile_test_helpers.compile_and_run(src_c14(), "jcr0zz_c14_run")
    if r.exit_code != 0 { io.println("FAIL: C14 runtime — {r.err_out}") }
    assert(r.exit_code == 0)
}
