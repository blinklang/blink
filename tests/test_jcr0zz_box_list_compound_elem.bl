test "C9: .pop() reads the Result element (the second reader family, independent of .get)" {
    let r = compile_test_helpers.compile_and_run(src_c9(), "jcr0zz_c9_run")
    if r.exit_code != 0 { io.println("FAIL: C9 runtime — {r.err_out}") }
