// A closure captured by another closure, promoted out of a `with arena` block, is
// described by descriptor_from_capture's CT_CLOSURE arm. That arm hashes the captured
// closure's signature into the descriptor "C:<hash>", which names BOTH the runtime
// capture-desc string and the promoter symbol. The hash was fed the flat pool sname
// (tp_get_sname on the capture's tp_id); this converges it onto the tid via
// closure_sig_from_tid, with the flat sname kept only as the no-tid fallback. The
// promoter must round-trip the inner closure so the returned closure still calls it.

fn make_adder(n: Int) -> fn(Int) -> Int {
    fn(x: Int) -> Int { x + n }
}

fn build() -> fn(Int) -> Int {
    with arena {
        let inner = make_adder(10)
        let outer = fn(y: Int) -> Int { inner(y) + 1 }
        outer
    }
}

test "an arena-promoted closure that captures a closure still calls the inner one" {
    let f = build()
    assert_eq(f(5), 16)
    assert_eq(f(0), 11)
}
