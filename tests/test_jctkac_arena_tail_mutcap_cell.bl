// Lock the block-local mut-capture cell arm of a 'with arena { }' tail closure
// for a struct and a data enum. An immutable capture skips this arm, so no other
// test reaches it.

type PromPoint { x: Int, y: Int }

type PromShape { Circle(Int), Square(Int) }

fn prom_area(s: PromShape) -> Int {
    match s {
        Circle(r) => r * r
        Square(w) => w * w * 2
    }
}

test "arena-tail closure promotes a block-local mut struct cell" {
    let g = with arena {
        let mut cell = PromPoint { x: 1, y: 2 }
        fn(d: Int) -> Int {
            cell = PromPoint { x: cell.x + d, y: cell.y }
            cell.x + cell.y
        }
    }
    assert(g(10) == 13)
}

test "arena-tail closure promotes a block-local mut data-enum cell" {
    let g = with arena {
        let mut cell = Circle(5)
        fn(d: Int) -> Int {
            cell = Square(d)
            prom_area(cell)
        }
    }
    assert(g(3) == 18)
}
