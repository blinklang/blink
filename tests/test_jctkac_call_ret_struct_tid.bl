// A struct- or tuple-returning CALL materializes its result into a codegen temp
// (_sr / _scrut) that has no typecheck node, so let_binding_tid can never stamp
// it — the temp's struct name has lived only on the flat ScopeVar.sname channel.
// sv_struct_tid_first now recovers that name from the call node's own tid, so the
// flat sname is only a fallback. These guard that field access, tuple-pattern
// match, and method chaining through a call-result temp still resolve once the
// flat channel is gone — across the plain-struct, tuple, and generic-instance
// return shapes, for both free functions and impl methods.
type Point { x: Int, y: Int }
type Box[T] { value: T }

fn make_point() -> Point { Point { x: 3, y: 7 } }
fn make_pair() -> Tuple[Int, Int] { (11, 13) }
fn make_box() -> Box[Int] { Box { value: 42 } }

type Factory { seed: Int }
trait Makes {
    fn point(self) -> Point
    fn boxed(self) -> Box[Int]
}
impl Makes for Factory {
    fn point(self) -> Point { Point { x: self.seed, y: self.seed + 1 } }
    fn boxed(self) -> Box[Int] { Box { value: self.seed } }
}

test "field access directly on a struct-returning call" {
    assert_eq(make_point().x, 3)
    assert_eq(make_point().y, 7)
}

test "tuple-returning call resolves through match" {
    match make_pair() {
        (a, b) => {
            assert_eq(a, 11)
            assert_eq(b, 13)
        }
    }
}

test "generic-instance-returning call resolves inner field" {
    assert_eq(make_box().value, 42)
}

test "field access on an impl-method struct return" {
    let f = Factory { seed: 5 }
    assert_eq(f.point().x, 5)
    assert_eq(f.point().y, 6)
    assert_eq(f.boxed().value, 5)
}
