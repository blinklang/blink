// jctkac: a Map read inside a closure body resolves its key and value kind through
// the CAPTURE branch of the map-kind readers, not the scope-var branch — the
// captured map is out of scope inside the closure, so the reader falls through the
// scope_vars loop to the capture list.
//
// Those capture branches read the flat inner1/inner2 snapshot carried on the
// CaptureEntry (copied from the captured scope var at capture time) rather than the
// tp_* pool children, so the capture path reports the same key/value kind as the
// authoritative scope-var path. A scalar Int key and value drive the _raw readers
// (get_map_key_type_raw/get_map_value_type_raw), whose capture branches have no tid
// pre-check and so reach the flat read directly; the non-_raw readers answer a
// resolved scalar from the tid first and reach the flat read only on an enum key or
// an unresolved value, both degenerate here (enum-key capture is blocked upstream),
// so this pins the _raw flat reads behaviourally.
//
// Distinct from test_map_closure (Str keys and values) and
// test_hs78tq_captured_map_struct_value (a struct value answered by the tid): the
// Int key and value carry CT_INT on both flat channels.

fn captured_map_int_key_value() -> Int {
    let mut m: Map[Int, Int] = Map()
    m.insert(1, 40)
    m.insert(2, 2)
    let lookup = fn() -> Int {
        m.get(1).unwrap() + m.get(2).unwrap()
    }
    lookup()
}

test "a Map[Int,Int] captured into a closure resolves its scalar key and value via the capture branch" {
    assert_eq(captured_map_int_key_value(), 42)
}

fn captured_map_int_key_str_value() -> Str {
    let mut m: Map[Int, Str] = Map()
    m.insert(7, "ok")
    let lookup = fn(k: Int) -> Str {
        m.get(k).unwrap()
    }
    lookup(7)
}

test "a Map[Int,Str] captured into a closure resolves a computed Int key across the capture branch" {
    assert_eq(captured_map_int_key_str_value(), "ok")
}
