// A generic-instance inner of an Option/Result carrier (Box[Int] -> Box_0Int)
// must be named from the mono tid, not the flat sname fallback. These shapes
// exercise every scope-var carrier struct-name accessor over a let-bound (and
// mut-rebound) carrier whose inner is a generic instance: unwrap, `?`,
// match-bind, and post-unwrap field access, on both the Ok and Err arms.
// Guards the retirement of the flat sname/sname2 fallback in the carrier
// struct-name readers (tid-sole-authority endgame).

type Box[T] { value: T }

fn opt_unwrap() -> Int {
    let o: Option[Box[Int]] = Some(Box { value: 7 })
    let b = o.unwrap()
    b.value
}

fn opt_match() -> Int {
    let o: Option[Box[Int]] = Some(Box { value: 9 })
    match o { Some(b) => b.value None => 0 }
}

fn opt_try() -> Option[Int] {
    let o: Option[Box[Int]] = Some(Box { value: 13 })
    let b = o?
    Some(b.value)
}

fn res_ok_match() -> Int {
    let r: Result[Box[Int], Str] = Ok(Box { value: 11 })
    match r { Ok(b) => b.value Err(_) => 0 }
}

fn res_err_match() -> Int {
    let r: Result[Int, Box[Int]] = Err(Box { value: 21 })
    match r { Ok(_) => 0 Err(b) => b.value }
}

fn opt_mut_rebind() -> Int {
    let mut o: Option[Box[Int]] = Some(Box { value: 1 })
    o = Some(Box { value: 31 })
    o.unwrap().value
}

test "generic-instance Option inner via unwrap names the mono stem" {
    assert_eq(opt_unwrap(), 7)
}

test "generic-instance Option inner via match-bind names the mono stem" {
    assert_eq(opt_match(), 9)
}

test "generic-instance Option inner via ? names the mono stem" {
    match opt_try() { Some(v) => assert_eq(v, 13) None => assert_eq(0, 1) }
}

test "generic-instance Result Ok inner via match-bind names the mono stem" {
    assert_eq(res_ok_match(), 11)
}

test "generic-instance Result Err inner via match-bind names the mono stem" {
    assert_eq(res_err_match(), 21)
}

test "generic-instance Option inner survives a mut rebind" {
    assert_eq(opt_mut_rebind(), 31)
}
