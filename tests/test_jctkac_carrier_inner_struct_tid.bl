// A carrier variable (Option[Point] / Result[Point, Str]) stores its inner (Ok)
// struct name on the flat ScopeVar.sname channel; sv_struct_tid_first now recovers
// that inner name from the carrier's own tid (sev_option_inner_name /
// sev_result_ok_name) so the flat sname is only a fallback. These guard that field
// access through a carrier var still resolves once the flat channel is gone —
// across the Option[plain-struct], Result[plain-struct, scalar], generic-instance,
// and nested-carrier shapes.
type Point { x: Int, y: Int }
type Box[T] { value: T }

test "option plain-struct carrier resolves inner field access" {
    let o: Option[Point] = Some(Point { x: 3, y: 7 })
    let p = o.unwrap()
    assert_eq(p.x, 3)
    assert_eq(p.y, 7)
}

test "result plain-struct ok carrier resolves inner field access" {
    let r: Result[Point, Str] = Ok(Point { x: 5, y: 9 })
    match r {
        Ok(p) => {
            assert_eq(p.x, 5)
            assert_eq(p.y, 9)
        }
        Err(_e) => assert_eq(0, 1)
    }
}

test "option generic-instance carrier resolves inner field access" {
    let o: Option[Box[Int]] = Some(Box { value: 42 })
    let b = o.unwrap()
    assert_eq(b.value, 42)
}

test "option nested-carrier inner resolves through tid" {
    let o: Option[Option[Point]] = Some(Some(Point { x: 11, y: 13 }))
    let inner = o.unwrap()
    let p = inner.unwrap()
    assert_eq(p.x, 11)
    assert_eq(p.y, 13)
}
