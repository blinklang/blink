// get_var_closure_sig resolves a closure's C signature from the Fn tid alone; the
// flat tp_id/sname channel it once fell back to is gone. A `with`-expression whose tail
// is a closure is the one shape that publishes its result through a tid-less
// set_var_closure, so these cases exercise the accessor for exactly that shape: the
// signature must still be spelled correctly for the fn-ptr cast at each call site, or the
// call miscompiles. The compound param/return cases stress closure_sig_from_tid, which
// walks each child type and yields "" if any child fails to spell.

type SigPoint {
    x: Int
    y: Int
}

// ── non-capturing closure yielded from a with-expr, called directly ──
test "a with-expr non-capturing closure calls through a tid-spelled sig" {
    let g = with arena {
        fn(x: Int) -> Int { x + 1 }
    }
    assert_eq(g(5), 6)
}

// ── compound param: fn(SigPoint) -> Int forces a struct child in the sig ──
test "a with-expr closure with a struct param spells its compound sig" {
    let g = with arena {
        fn(p: SigPoint) -> Int { p.x + p.y }
    }
    assert_eq(g(SigPoint { x: 4, y: 5 }), 9)
}

// ── compound return: fn(Int) -> Option[Int] forces a carrier child in the sig ──
test "a with-expr closure returning an Option spells its compound sig" {
    let g = with arena {
        fn(x: Int) -> Option[Int] { Some(x + 1) }
    }
    assert_eq(g(9).unwrap(), 10)
}

// ── capturing closure yielded from a with-expr, called directly ──
test "a with-expr capturing closure calls through a tid-spelled sig" {
    let base = 100
    let g = with arena {
        fn(x: Int) -> Int { x + base }
    }
    assert_eq(g(7), 107)
}
