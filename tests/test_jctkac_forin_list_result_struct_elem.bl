// Guards that iterating a List[Result[Struct, scalar]] with for-in binds the loop
// var with the real Result carrier (ok struct recovered), not the lossy
// Result_int_str. The flat elem channel of a push-built list omits the ok struct,
// so the element tid must lead; when it is erased the loop var reads `.ok` as int
// and the emitted C fails with an invalid initializer.

type Point { x: Int }

test "for-in over List[Result[Struct, scalar]] keeps the ok struct" {
    let mut xs: List[Result[Point, Str]] = []
    xs.push(Ok(Point { x: 10 }))
    let mut g = 0
    for r in xs {
        g = r.unwrap().x
    }
    assert_eq(g, 10)
}

test "for-in over List[Result[scalar, Struct]] keeps the err struct" {
    let mut xs: List[Result[Int, Point]] = []
    xs.push(Err(Point { x: 7 }))
    let mut g = 0
    for r in xs {
        match r {
            Ok(v) => g = v
            Err(p) => g = p.x
        }
    }
    assert_eq(g, 7)
}

test "for-in over List[Result[Int, Str]] still binds the scalar sides" {
    let mut xs: List[Result[Int, Str]] = []
    xs.push(Ok(3))
    xs.push(Err("bad"))
    let mut oks = 0
    let mut errs = 0
    for r in xs {
        match r {
            Ok(v) => oks = oks + v
            Err(_) => errs = errs + 1
        }
    }
    assert_eq(oks, 3)
    assert_eq(errs, 1)
}
