// A `Type.from(x)` static call whose impl method is declared `-> Self` used to
// type as the Self typevar, not the concrete target — so the call result's
// struct name lived only on the flat ScopeVar.sname channel (stamped by codegen's
// static From dispatch). typecheck now substitutes Self -> the concrete target at
// the dispatch return, so the result's tid names the struct directly. These guard
// that binding + field access through such a result still resolve once the flat
// channel is gone.
type Celsius { deg: Int }

impl From[Int] for Celsius {
    fn from(n: Int) -> Self {
        Celsius { deg: n }
    }
}

test "From-impl result field access resolves through the result tid" {
    let c = Celsius.from(20)
    assert_eq(c.deg, 20)
}

test "From-impl result flows into a second binding" {
    let a = Celsius.from(5)
    let b = a
    assert_eq(b.deg, 5)
}

test "From-impl result field access with no intermediate binding" {
    assert_eq(Celsius.from(20).deg, 20)
}
