// A generic-struct-INSTANCE parameter (v: Box[Int]) was registered through
// set_var_struct with the mono-instance carrier (Box_Int) on the flat sname
// channel but no type id, so every field read on the parameter recovered the
// carrier through the flat sname alone. Both param-registration sites (free-fn
// and impl-method) now also stamp the annotation's tid on the param var (guarded
// to the reader's mono-name round-trip), so sv_struct_tid_first recovers the
// instance from the tid. This is a tid-population step: the emitted C is
// unchanged; the tests guard that field access on a generic-instance parameter
// still resolves across the free-fn, two-param, and impl-method shapes.
type Box[T] { value: T }
type Pair[A, B] { first: A, second: B }

fn read_box(b: Box[Int]) -> Int {
    b.value
}

fn read_pair(p: Pair[Int, Int]) -> Int {
    p.first + p.second
}

type Reader { tag: Int }

trait BoxReader {
    fn via_box(self, b: Box[Int]) -> Int
}

impl BoxReader for Reader {
    fn via_box(self, b: Box[Int]) -> Int {
        b.value + self.tag
    }
}

test "generic-instance parameter resolves field access in a free fn" {
    assert_eq(read_box(Box { value: 7 }), 7)
}

test "two-param generic-instance parameter resolves both fields" {
    assert_eq(read_pair(Pair { first: 3, second: 9 }), 12)
}

test "generic-instance parameter resolves field access in an impl method" {
    let r = Reader { tag: 100 }
    assert_eq(r.via_box(Box { value: 5 }), 105)
}
