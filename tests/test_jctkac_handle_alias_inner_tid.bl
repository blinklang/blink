// A Handle bound from another Handle VARIABLE (`let h2 = h`) drains the emit_let_binding
// CT_HANDLE rebind path, which the direct-spawn handle tests never reach — every other handle
// test binds the handle straight from async.spawn. The rebind re-derives the new binding's kind
// through get_var_handle_inner / _inner2 on the SOURCE var, so awaiting the alias must unbox with
// the same kind the tid names. A lost kind here awaits with the wrong unbox and reads a garbage
// value or fails to compile.

type Node {
    n: Int
}

// ── scalar Int handle, aliased, awaited ──────────────────────────────────────────────────
test "an aliased Int handle awaits the scalar" {
    let h = async.spawn(fn() -> Int {
        3
    })
    let h2 = h
    assert_eq(h2.await, 3)
}

// ── scalar Str handle, aliased, awaited ──────────────────────────────────────────────────
test "an aliased Str handle awaits the string" {
    let h = async.spawn(fn() -> Str {
        "skippy"
    })
    let h2 = h
    assert_eq(h2.await, "skippy")
}

// ── Option[Node] handle, aliased, awaited, inner struct field ─────────────────────────────
test "an aliased Option[struct] handle unwraps the inner struct field" {
    let h = async.spawn(fn() -> Option[Node] {
        Some(Node { n: 9 })
    })
    let h2 = h
    let o = h2.await
    assert_eq(o.unwrap().n, 9)
}

// ── Result[Node, Str] handle, aliased, awaited, ok struct field (scalar err) ──────────────
test "an aliased Result[struct, Str] handle unwraps the ok struct field" {
    let h = async.spawn(fn() -> Result[Node, Str] {
        Ok(Node { n: 5 })
    })
    let h2 = h
    let r = h2.await
    assert_eq(r.unwrap().n, 5)
}

// ── Result[Int, Node] handle, aliased, awaited, struct ERR field ──────────────────────────
// A struct err drives the inner2/sname2 CT_VOID + struct-name arm the scalar-err case above
// never reaches — the aliased handle must still name the err struct so unwrap_err reads its field.
test "an aliased Result[Int, struct] handle unwraps the struct err field" {
    let h = async.spawn(fn() -> Result[Int, Node] {
        Err(Node { n: 7 })
    })
    let h2 = h
    let r = h2.await
    assert_eq(r.unwrap_err().n, 7)
}
