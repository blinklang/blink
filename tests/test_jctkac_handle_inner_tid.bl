// get_var_handle_inner / get_var_handle_inner2 name the outer kind (inner1) and the Option-elem /
// Result-err kind (inner2) an async.spawn Handle carries, so awaiting the handle emits the right
// unbox for that kind. These rows pin the scalar and scalar-container dispatch classes that the
// struct-bearing handle tests (test_k1z1q8, test_jctkac_handle_sname_tid) do not exercise:
//   - a scalar Str/Bool/Float return -> inner1's CT_STRING / CT_BOOL / CT_FLOAT await branch
//   - an Option[Int]                  -> inner1 CT_OPTION + inner2 scalar-elem path (option_c_type)
//   - a Result[Int, Str]              -> inner1 CT_RESULT + inner2 scalar-err path (no struct arm)
// A wrong inner1/inner2 kind picks the wrong unbox and fails to compile or reads a garbage value.

// ── scalar Str return → await ────────────────────────────────────────────────────────────
test "an async handle of a Str awaits the string channel" {
    let h = async.spawn(fn() -> Str {
        "skippy"
    })
    assert_eq(h.await, "skippy")
}

// ── scalar Bool return → await ───────────────────────────────────────────────────────────
test "an async handle of a Bool awaits the bool channel" {
    let h = async.spawn(fn() -> Bool {
        true
    })
    assert_eq(h.await, true)
}

// ── scalar Float return → await ──────────────────────────────────────────────────────────
test "an async handle of a Float awaits the float channel" {
    let h = async.spawn(fn() -> Float {
        2.5
    })
    assert_eq(h.await, 2.5)
}

// ── Option[Int] → await → unwrap the scalar inner ────────────────────────────────────────
test "an async handle of an Option[Int] awaits the scalar option" {
    let h = async.spawn(fn() -> Option[Int] {
        Some(41)
    })
    let o = h.await
    assert_eq(o.unwrap(), 41)
}

// ── Result[Int, Str] → await → unwrap the scalar ok (scalar err) ──────────────────────────
test "an async handle of a Result[Int, Str] awaits the scalar result" {
    let h = async.spawn(fn() -> Result[Int, Str] {
        Ok(7)
    })
    let r = h.await
    assert_eq(r.unwrap(), 7)
}
