// get_var_handle_sname / get_var_handle_sname2 name the structs an async.spawn Handle carries on its
// ok / inner / struct-return / err channels, so awaiting the handle emits the right struct cast and
// member access. Each row spawns a task whose return type nests a struct, awaits it, and reads a
// struct field off the result — a wrong or empty name fails to compile or reads the wrong field. The
// rows cover every dispatch position of the two readers:
//   - a Struct return         -> sname's CT_STRUCT branch
//   - an Option[Struct]        -> sname's CT_OPTION inner-struct branch
//   - a Result[Struct, Str]    -> sname's CT_RESULT ok-struct branch (scalar err)
//   - a Result[Struct, Struct] -> sname's ok-struct branch + sname2's CT_RESULT err-struct branch
//   - an Int return            -> no struct, names "" (negative round-trip)

type Point {
    x: Int
    y: Int
}

type Oops {
    code: Int
}

// ── Struct return → await → read a struct field ────────────────────────────────────────
test "an async handle of a struct reads a field off the awaited result" {
    let h = async.spawn(fn() -> Point {
        Point { x: 3, y: 4 }
    })
    let p = h.await
    assert_eq(p.x + p.y, 7)
}

// ── Option[Struct] return → await → unwrap inner struct field ───────────────────────────
test "an async handle of an option reads the inner struct field" {
    let h = async.spawn(fn() -> Option[Point] {
        Some(Point { x: 8, y: 9 })
    })
    let o = h.await
    assert_eq(o.unwrap().x, 8)
}

// ── Result[Struct, Str] return → await → unwrap ok struct field (scalar err) ─────────────
test "an async handle of a result reads the ok struct field" {
    let h = async.spawn(fn() -> Result[Point, Str] {
        Ok(Point { x: 5, y: 6 })
    })
    let r = h.await
    assert_eq(r.unwrap().y, 6)
}

// ── Result[Struct, Struct] return → await → the err channel also names its struct ────────
test "an async handle of a result with a struct err names both arms" {
    let h = async.spawn(fn() -> Result[Point, Oops] {
        Ok(Point { x: 11, y: 12 })
    })
    let r = h.await
    assert_eq(r.unwrap().x, 11)
}

// ── negative: an Int return has no struct, names "" and still round-trips ────────────────
test "an async handle of an int round-trips without a struct name" {
    let h = async.spawn(fn() -> Int {
        21 + 21
    })
    assert_eq(h.await, 42)
}
