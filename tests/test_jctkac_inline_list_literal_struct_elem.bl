// An INLINE (unbound) list literal whose element is a generic-struct instance
// must name its element from the temp's List tid, not the flat sname2 channel. A
// let-bound list gets its tid stamped by the binding path, so the corpus's
// bound-list tests never exercise this: only a literal read in place —
// `[Box { value: 7 }].get(0)` — leaves the temp on ty=-1, where emit_list_lit
// must stamp the List tid so get_list_elem_struct spells the mono stem (Box_0Int)
// instead of collapsing the carrier to blink_Option_int. These rows read the
// literal in place — .get (through the Option carrier) and for-in (the element
// binder) — the two downstream consumers of the temp's element name. (.pop can't
// join them: it needs a `let mut` binding, and that binding stamps the tid on its
// own ScopeVar through the let-binding path, so it never reaches this inline stamp.)

type Box[T] { value: T }

test "an inline List[Box[Int]] literal names its struct element through .get" {
    let got = [Box { value: 7 }, Box { value: 9 }].get(1).unwrap().value
    assert_eq(got, 9)
}

test "an inline List[Box[Int]] literal names its struct element through for-in" {
    let mut total = 0
    for b in [Box { value: 1 }, Box { value: 2 }, Box { value: 3 }] {
        total = total + b.value
    }
    assert_eq(total, 6)
}
