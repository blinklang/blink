// A DOUBLE carrier — Option[Option[T]] or Option[Result[T,E]] — produced by a push-built
// list's .get()/.pop(), bound to a `let`, then unwrapped through that binding must keep the
// inner carrier nominal. The chained forms (xs.get(0).unwrap().unwrap()) flow the first
// unwrap's inner through the expr_option_* globals and are already correct; the exposing
// shape is the INTERMEDIATE let: `let e = xs.get(0)` copies the carrier metadata into e's
// ScopeVar, and if that copy drops the inner nominal, `e.unwrap()` spells the erased
// blink_Option_option (codegen) — or, on the pop path, types the inner as the scalar and a
// scalar op on the wrong level fails at typecheck. Written in the corpus so the shapes are
// the real self-hosted build, not a compile_and_run string.

// --- Surface 1: get-via-let, Option[Option[Str]] ---
test "a let-bound Option[Option[Str]] from get unwraps to the inner Option then a scalar" {
    let mut xs = []
    xs.push(Some("hi"))
    xs.push(None)
    let e = xs.get(0)
    let inner = e.unwrap()
    let s = inner.unwrap()
    assert_eq(s.len(), 2)
}

// --- Surface 1: get-via-let, Option[Option[Int]] (scalar-independent) ---
test "a let-bound Option[Option[Int]] from get unwraps through two levels to the int" {
    let mut xs = []
    xs.push(Some(7))
    xs.push(None)
    let e = xs.get(0)
    let inner = e.unwrap()
    let v = inner.unwrap()
    assert_eq(v, 7)
}

// --- Surface 2: pop-via-let, Option[Option[Int]] ---
test "a let-bound Option[Option[Int]] from pop unwraps through two levels to the int" {
    let mut xs = []
    xs.push(Some(3))
    xs.push(Some(9))
    let last = xs.pop()
    let inner = last.unwrap()
    let v = inner.unwrap()
    assert_eq(v, 9)
}

// --- Surface 2: pop-via-let, Option[Option[Str]] (the recorded "unresolved .len on Str") ---
test "a let-bound Option[Option[Str]] from pop unwraps to a scalar used in a typed position" {
    let mut xs = []
    xs.push(Some("alpha"))
    xs.push(Some("world"))
    let last = xs.pop()
    let inner = last.unwrap()
    let s = inner.unwrap()
    assert_eq(s.len(), 5)
}

// --- Result inner carrier: get-via-let, Option[Result[Str,Int]] ---
test "a let-bound Option[Result[Str,Int]] from get unwraps to the Result then an Ok scalar" {
    let mut xs = []
    xs.push(Ok("alpha"))
    xs.push(Err(1))
    let e = xs.get(0)
    let r = e.unwrap()
    let s = r.unwrap()
    assert_eq(s.len(), 5)
}

// --- Result inner carrier: pop-via-let, Option[Result[Str,Int]] ---
// The Err push pins the Result's E side; without it E is an unbound metavar and the
// element type is under-determined (E0301), which is a distinct, correct error.
test "a let-bound Option[Result[Str,Int]] from pop unwraps to the Result then an Ok scalar" {
    let mut xs = []
    xs.push(Ok("beta"))
    xs.push(Err(2))
    xs.push(Ok("gamma"))
    let last = xs.pop()
    let r = last.unwrap()
    let s = r.unwrap()
    assert_eq(s.len(), 5)
}
