// An iterator adapter over a List whose element is a tuple or a compound carrier
// (Option/Result) produces a fresh result List temp (__collect_*) whose element
// identity must ride the tid. The producing adapter/collect call node types
// List[elem], so emit_iter_collect stamps the result temp with that tid — the same
// element get_list_elem_struct spells. Without the tid stamp the identity would
// survive only on the flat sname2 channel, and a later .get()/for-in read would
// collapse the carrier (`blink_Option_Tuple2_int_str = blink_Option_int`, an invalid
// C initializer). These rows exercise the adapters that build such temps — take,
// filter, skip, chain, collect — then read the element back. Written in the corpus
// so the shape compiles through the real self-hosted build, not a compile_and_run string.

test "a List[(Int, Str)] keeps its tuple element through take/filter/skip results" {
    let l: List[(Int, Str)] = [(1, "a"), (2, "b"), (3, "c")]
    assert_eq(l.take(2).get(1).unwrap().0, 2)
    assert_eq(l.skip(1).get(0).unwrap().0, 2)
    let kept = l.filter(fn(t: (Int, Str)) -> Bool { t.0 > 1 })
    assert_eq(kept.get(0).unwrap().0, 2)
    assert(kept.get(0).unwrap().1 == "b")
}

test "a List[Option[Int]] keeps its Option element through take/filter results" {
    let l: List[Option[Int]] = [Some(1), None, Some(3)]
    assert_eq(l.take(2).get(0).unwrap().unwrap(), 1)
    let kept = l.filter(fn(o: Option[Int]) -> Bool { o.is_some() })
    assert_eq(kept.len(), 2)
    assert_eq(kept.get(1).unwrap().unwrap(), 3)
}

test "a List[(Int, Str)] chains two lists and reads the tuple element back" {
    let a: List[(Int, Str)] = [(1, "a")]
    let b: List[(Int, Str)] = [(2, "b")]
    let both = a.chain(b)
    assert_eq(both.len(), 2)
    assert_eq(both.get(1).unwrap().0, 2)
    assert(both.get(1).unwrap().1 == "b")
}
