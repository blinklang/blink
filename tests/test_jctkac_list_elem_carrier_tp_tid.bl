// Re-binding a list whose element is a compound carrier (Option/Result/Map) with an
// unannotated `let dst = src` runs copy_list_compound_elem, which carries the element's
// deep inner tp across the rebind. The get_list_elem_*_tp family that reads that inner is
// now tid-first (peel the list tid to its element, spell the grandchild from the tree),
// falling back to the flat pool only when the tid declines. These shapes keep a NESTED
// container inner (a Map value, a Map inside a Result, a List inside a Map) two carriers
// deep, which the flat channels erase — so a regression in the tid-first reader would drop
// the inner type and misread the value or fail to compile. Element values are Str / nested
// containers, not bare Int, so an erasure is observable rather than decoding back to Int.

test "rebound List[Option[Map]] keeps the map value across the copy" {
    let mut src: List[Option[Map[Str, Int]]] = []
    let mut m: Map[Str, Int] = Map()
    m.insert("a", 7)
    src.push(Some(m))
    let dst = src
    match dst.get(0).unwrap() {
        Some(mm) => assert_eq(mm.get("a").unwrap(), 7)
        None => assert(false)
    }
}

test "rebound List[Result[Map, Str]] keeps the ok map across the copy" {
    let mut src: List[Result[Map[Str, Int], Str]] = []
    let mut m: Map[Str, Int] = Map()
    m.insert("k", 42)
    src.push(Ok(m))
    let dst = src
    match dst.get(0).unwrap() {
        Ok(mm) => assert_eq(mm.get("k").unwrap(), 42)
        Err(_) => assert(false)
    }
}

test "rebound List[Map[Str, List]] keeps the nested list value across the copy" {
    let mut src: List[Map[Str, List[Int]]] = []
    let mut m: Map[Str, List[Int]] = Map()
    m.insert("xs", [3, 4, 5])
    src.push(m)
    let dst = src
    let got = dst.get(0).unwrap()
    assert_eq(got.get("xs").unwrap().len(), 3)
    assert_eq(got.get("xs").unwrap().get(2).unwrap(), 5)
}
