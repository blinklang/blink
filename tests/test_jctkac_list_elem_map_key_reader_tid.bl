// A List[Map[K,V]] must recover its element-map KEY type from the list tid so a value
// reads back correctly through get() and pop(). Each row builds a List[Map[K, V]],
// pushes a map, then reads a value back by key. The tid must spell every key shape:
//
//   * a scalar key (Str, Int) — the leaf-scalar arm.
//   * a struct key (@derive(Hash, Eq)) — the non-scalar arm.
//   * an inferred `Map()` whose key metavar is bound late by `.insert` — read only
//     through resolution.

@derive(Hash, Eq)
type Kp { a: Int, b: Int }

test "a Str-keyed List[Map] reads a value back through the key" {
    let mut frames: List[Map[Str, Int]] = []
    let mut m: Map[Str, Int] = Map()
    m.insert("k", 42)
    frames.push(m)
    let frame = frames.get(0).unwrap()
    assert_eq(frame.get("k").unwrap(), 42)
}

test "an Int-keyed List[Map] reads a value back through the key" {
    let mut frames: List[Map[Int, Int]] = []
    let mut m: Map[Int, Int] = Map()
    m.insert(7, 70)
    frames.push(m)
    let frame = frames.get(0).unwrap()
    assert_eq(frame.get(7).unwrap(), 70)
}

test "a struct-keyed List[Map] reads a value back through the struct key" {
    let mut frames: List[Map[Kp, Int]] = []
    let mut m: Map[Kp, Int] = Map()
    m.insert(Kp { a: 1, b: 2 }, 99)
    frames.push(m)
    let frame = frames.get(0).unwrap()
    assert_eq(frame.get(Kp { a: 1, b: 2 }).unwrap(), 99)
}

test "a struct-keyed List[Map] survives push-only inferred-Map construction" {
    let mut frames: List[Map[Kp, Int]] = []
    let mut m = Map()
    m.insert(Kp { a: 3, b: 4 }, 12)
    frames.push(m)
    let frame = frames.get(0).unwrap()
    assert_eq(frame.get(Kp { a: 3, b: 4 }).unwrap(), 12)
}

test "a struct-keyed List[Map] survives the List[Map].pop chain" {
    let mut frames: List[Map[Kp, Int]] = []
    let mut m: Map[Kp, Int] = Map()
    m.insert(Kp { a: 5, b: 6 }, 33)
    frames.push(m)
    let popped = frames.pop().unwrap()
    assert_eq(popped.get(Kp { a: 5, b: 6 }).unwrap(), 33)
}
