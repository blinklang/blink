// A List whose ELEMENT is a struct/enum must name that element from the list
// tid, so get_list_elem_struct can lead with the tid instead of the flat sname2
// channel. Covers a plain non-generic struct element (Point), a generic-instance
// struct element (Box[Int] -> mono stem), and a payloadless enum element (Color),
// read back via .get().unwrap() field/variant access and via for-in iteration.
// The change is emit-C byte-identical corpus-wide, so this is a behavioral guard
// that the element name survives, not a channel-attribution test (a runtime .bl
// test cannot see which channel produced an identical name). Guards the tid-first
// migration of get_list_elem_struct (tid-sole-authority, list-elem-struct family).

type Point { x: Int, y: Int }
type Box[T] { value: T }

type Color { Red, Green, Blue }

fn plain_struct_elem_get() -> Int {
    let mut xs: List[Point] = []
    xs.push(Point { x: 3, y: 4 })
    let p = xs.get(0).unwrap()
    p.x + p.y
}

fn plain_struct_elem_forin() -> Int {
    let mut xs: List[Point] = []
    xs.push(Point { x: 5, y: 6 })
    let mut acc = 0
    for v in xs {
        acc = acc + v.x + v.y
    }
    acc
}

fn generic_instance_elem_get() -> Int {
    let mut xs: List[Box[Int]] = []
    xs.push(Box { value: 42 })
    let b = xs.get(0).unwrap()
    b.value
}

fn generic_instance_elem_forin() -> Int {
    let mut xs: List[Box[Int]] = []
    xs.push(Box { value: 21 })
    let mut acc = 0
    for v in xs {
        acc = acc + v.value
    }
    acc
}

fn enum_elem_get() -> Int {
    let mut xs: List[Color] = []
    xs.push(Color.Green)
    match xs.get(0).unwrap() {
        Color.Red => 1
        Color.Green => 2
        Color.Blue => 3
    }
}

test "plain struct list element names Point via the tid on get" {
    assert_eq(plain_struct_elem_get(), 7)
}

test "enum list element names Color via the tid on get" {
    assert_eq(enum_elem_get(), 2)
}

test "plain struct list element names Point via the tid on for-in" {
    assert_eq(plain_struct_elem_forin(), 11)
}

test "generic-instance list element names the mono stem via get" {
    assert_eq(generic_instance_elem_get(), 42)
}

test "generic-instance list element names the mono stem via for-in" {
    assert_eq(generic_instance_elem_forin(), 21)
}
