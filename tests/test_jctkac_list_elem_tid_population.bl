// An INFERRED list (no List[T] annotation) whose element is a plain, non-generic,
// non-transparent struct/enum must carry the List[Elem] tid on ScopeVar.ty,
// recovered from the named-type registry at set_list_elem_struct time, so
// get_list_elem_struct names the element from the tid instead of the flat sname2
// channel. Complements test_jctkac_list_elem_struct_tid.bl, which covers the
// ANNOTATED case (already tid-carrying) — this covers the ty=-1 inferred case the
// population step moves onto the tid. The change is emit-C byte-identical
// corpus-wide, so this is a behavioral guard that the element name survives the
// tid path, not a channel-attribution test (a runtime .bl test cannot see which
// channel produced an identical name). Guards the tid-population step of the
// tid-sole-authority migration (sv.ty via make_list_type in set_list_elem_struct).

type IPoint { x: Int, y: Int }

type IColor { Red, Green, Blue }

fn inferred_struct_elem_get() -> Int {
    let mut xs = []
    xs.push(IPoint { x: 3, y: 4 })
    let p = xs.get(0).unwrap()
    p.x + p.y
}

fn inferred_struct_elem_forin() -> Int {
    let mut xs = []
    xs.push(IPoint { x: 5, y: 6 })
    let mut acc = 0
    for v in xs {
        acc = acc + v.x + v.y
    }
    acc
}

fn inferred_enum_elem_get() -> Int {
    let mut xs = []
    xs.push(IColor.Green)
    match xs.get(0).unwrap() {
        IColor.Red => 1
        IColor.Green => 2
        IColor.Blue => 3
    }
}

test "inferred-list struct element names IPoint via the tid on get" {
    assert_eq(inferred_struct_elem_get(), 7)
}

test "inferred-list struct element names IPoint via the tid on for-in" {
    assert_eq(inferred_struct_elem_forin(), 11)
}

test "inferred-list enum element names IColor via the tid on get" {
    assert_eq(inferred_enum_elem_get(), 2)
}
