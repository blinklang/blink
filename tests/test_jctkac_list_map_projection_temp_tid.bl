// A List[Map[K,V]] receiver that is a projection temp — a fn-return value, a
// tuple element — carries no ScopeVar tid of its own, only the node tid typecheck
// recorded. emit_list_method now stamps that node tid onto the temp before the
// by-value element readers run, so get_list_elem_map_val_struct answers the map
// value's C type from the tid. The flat pool child2_sname fallback it once leaned
// on is gone, so a projection receiver whose temp went unstamped would spell the
// value wrong. Each row reads the value back through .get()/.pop() + field access.

type Point { x: Int }
type Box[T] { value: T }

fn frames_of_point() -> List[Map[Str, Point]] {
    let mut frames: List[Map[Str, Point]] = []
    let mut m: Map[Str, Point] = Map()
    m.insert("k", Point { x: 11 })
    frames.push(m)
    frames
}

fn frames_of_box() -> List[Map[Str, Box[Int]]] {
    let mut frames: List[Map[Str, Box[Int]]] = []
    let mut m: Map[Str, Box[Int]] = Map()
    m.insert("k", Box { value: 13 })
    frames.push(m)
    frames
}

test "a plain-struct map value survives a fn-return projection .get" {
    let frame = frames_of_point().get(0).unwrap()
    assert_eq(frame.get("k").unwrap().x, 11)
}

test "a generic-instance map value survives a fn-return projection .get" {
    let frame = frames_of_box().get(0).unwrap()
    assert_eq(frame.get("k").unwrap().value, 13)
}

test "a plain-struct map value survives a fn-return projection .pop" {
    let popped = frames_of_point().pop().unwrap()
    assert_eq(popped.get("k").unwrap().x, 11)
}

test "a plain-struct map value survives a tuple-element projection .get" {
    let t = (frames_of_point(), 99)
    let frame = t.0.get(0).unwrap()
    assert_eq(frame.get("k").unwrap().x, 11)
}
