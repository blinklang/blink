// Guards that a List[Option[T]] element-option's inner struct/tuple name survives
// every read path when it must come from the list tid — including a projection-temp
// receiver (a fn return, a tuple element), which has no ScopeVar tid until
// emit_list_method stamps the list tid from the node tid.
//
// Each row builds a List[Option[V]], reads an element back through
// .get()/.pop()/iteration + .unwrap(), and checks the inner value — covering the
// mono stem (Box), the struct head (Point), and the tuple branch, across the push
// carry, get/pop recovery, copy carry, iteration, and a fn-return projection.

type Point { x: Int }
type Box[T] { value: T }

fn opts_of_point() -> List[Option[Point]] {
    let mut xs: List[Option[Point]] = []
    xs.push(Some(Point { x: 11 }))
    xs
}

test "a plain-struct option inner survives the List[Option].get chain" {
    let mut xs: List[Option[Point]] = []
    xs.push(Some(Point { x: 42 }))
    assert_eq(xs.get(0).unwrap().unwrap().x, 42)
}

test "a generic-instance option inner survives the List[Option].get chain" {
    let mut xs: List[Option[Box[Int]]] = []
    xs.push(Some(Box { value: 9 }))
    assert_eq(xs.get(0).unwrap().unwrap().value, 9)
}

test "a tuple option inner survives the List[Option].get chain" {
    let mut xs: List[Option[(Int, Int)]] = []
    xs.push(Some((3, 4)))
    assert_eq(xs.get(0).unwrap().unwrap().0, 3)
}

test "a plain-struct option inner survives the List[Option].pop chain" {
    let mut xs: List[Option[Point]] = []
    xs.push(Some(Point { x: 55 }))
    assert_eq(xs.pop().unwrap().unwrap().x, 55)
}

test "a plain-struct option inner survives a list copy" {
    let mut a: List[Option[Point]] = []
    a.push(Some(Point { x: 7 }))
    let b = a
    assert_eq(b.get(0).unwrap().unwrap().x, 7)
}

test "a plain-struct option inner survives iteration" {
    let mut xs: List[Option[Point]] = []
    xs.push(Some(Point { x: 8 }))
    let mut got = 0
    for o in xs {
        got = o.unwrap().x
    }
    assert_eq(got, 8)
}

test "a plain-struct option inner survives a fn-return projection .get" {
    let o = opts_of_point().get(0).unwrap()
    assert_eq(o.unwrap().x, 11)
}
