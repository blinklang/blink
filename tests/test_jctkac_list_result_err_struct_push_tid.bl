// Guards that pushing an Err(struct) into a List[Result[scalar, Struct]] keeps
// the err struct on the pushed carrier. The list element tid drives the pushed
// Err arg's expected type; when the struct side is erased the carrier lowers to
// Result_<ok>_void and the emitted C fails to compile (a void union field). The
// read side (get_list_elem_result_err_struct) already spells the struct, so a
// mismatch here is a push/Err-carrier inference hole, not a read hole.

type Point { x: Int }
type Line { a: Int }

test "an Err(struct) pushed into a List[Result[scalar, Struct]] keeps the struct" {
    let mut xs: List[Result[Int, Point]] = []
    xs.push(Err(Point { x: 6 }))
    assert_eq(xs.len(), 1)
}

test "the pushed Err struct reads back through .get" {
    let mut xs: List[Result[Int, Point]] = []
    xs.push(Err(Point { x: 42 }))
    let r = xs.get(0).unwrap()
    match r {
        Ok(v) => assert_eq(v, -1)
        Err(p) => assert_eq(p.x, 42)
    }
}

test "an Ok pushed alongside keeps the scalar ok side" {
    let mut xs: List[Result[Int, Point]] = []
    xs.push(Ok(7))
    xs.push(Err(Point { x: 9 }))
    let r0 = xs.get(0).unwrap()
    match r0 {
        Ok(v) => assert_eq(v, 7)
        Err(p) => assert_eq(p.x, -1)
    }
}

test "an Ok(struct) pushed into a List[Result[Struct, scalar]] keeps the struct" {
    let mut xs: List[Result[Point, Int]] = []
    xs.push(Ok(Point { x: 12 }))
    let r = xs.get(0).unwrap()
    match r {
        Ok(p) => assert_eq(p.x, 12)
        Err(v) => assert_eq(v, -1)
    }
}
