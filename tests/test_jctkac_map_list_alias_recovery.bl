// A List-valued map's value kind reaches an unannotated alias only through the recovery
// channels: copy_map_value_meta copies the value-list element via set_map_value_list_elem,
// which writes the `extra` channel. set_var inits inner2 = -1, so before this fix an alias
// carried its "value is a List" fact ONLY in `extra`. These rows pin that a List-valued map
// keeps its list value across the alias/unwrap recovery paths, so stamping the authoritative
// value kind (CT_LIST) onto inner2 at set_map_value_list_elem stays byte-identical: each map
// still returns the list it stored. They also guard the eventual removal of the `extra`
// value-kind short-circuit — once inner2 carries CT_LIST, these must still pass.

type Point {
    x: Int
    y: Int
}

fn make_opt() -> Option[Map[Str, List[Int]]] {
    let mut m: Map[Str, List[Int]] = Map()
    m.insert("k", [1, 2, 3])
    Some(m)
}

fn make_res() -> Result[Map[Str, List[Str]], Str] {
    let mut m: Map[Str, List[Str]] = Map()
    m.insert("a", ["one", "two"])
    Ok(m)
}

// ── unannotated alias chain of a List-valued map ──────────────────────────────────────────
test "an unannotated alias chain of Map[Str,List[Int]] keeps the list value" {
    let mut m1: Map[Str, List[Int]] = Map()
    m1.insert("k", [10, 20, 30, 40])
    let m2 = m1
    let m3 = m2
    let k = m3.get("k").unwrap()
    assert_eq(k.len(), 4)
    assert_eq(k.get(3).unwrap(), 40)
}

// ── alias then read through a for-loop over the pairs ─────────────────────────────────────
test "an aliased List-valued map iterates its pairs" {
    let mut m1: Map[Str, List[Str]] = Map()
    m1.insert("a", ["x", "y"])
    m1.insert("b", ["z"])
    let m2 = m1
    let mut total = 0
    for (_kk, vv) in m2 {
        total = total + vv.len()
    }
    assert_eq(total, 3)
}

// ── recovered through Option[Map[K,List[V]]].unwrap() ─────────────────────────────────────
test "a Map[K,List[V]] recovered from Option.unwrap round-trips its list" {
    let x = make_opt().unwrap()
    let k = x.get("k").unwrap()
    assert_eq(k.len(), 3)
    assert_eq(k.get(1).unwrap(), 2)
}

// ── recovered through Result[Map[K,List[V]],E].unwrap() ───────────────────────────────────
test "a Map[K,List[V]] recovered from Result.unwrap round-trips its list" {
    let x = make_res().unwrap()
    let a = x.get("a").unwrap()
    assert_eq(a.len(), 2)
    assert_eq(a.get(0).unwrap(), "one")
}

// ── aliased List-valued map pushed into a List[Map[...]] container ────────────────────────
test "an aliased List-valued map pushes into a List[Map[...]] and round-trips" {
    let mut m1: Map[Str, List[Int]] = Map()
    m1.insert("k", [5, 6])
    let m2 = m1
    let mut container: List[Map[Str, List[Int]]] = []
    container.push(m2)
    let got = container.get(0).unwrap()
    assert_eq(got.get("k").unwrap().len(), 2)
}
