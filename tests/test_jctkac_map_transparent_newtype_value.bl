// A Map whose value is a transparent newtype (`Errno`, the language's only one) must read
// back through `.get()` as a BY-VALUE scalar carrier. Errno lowers to a bare int64_t (no box),
// so the map stores it inline (`blink_map_set(m, k, (void*)(intptr_t)rc)`) and the `.get()`
// Option carrier's `.value` field is int64_t. The get-lowering read the value struct name off
// the flat sname2 channel ("Errno") and took the boxed-struct branch, casting the stored
// intptr to a `blink_std_errno_Errno*` pointer into that int64_t field — invalid C. The tid
// speller already DECLINES a transparent newtype (it has no C struct); the flat channel
// disagreed, and that disagreement drove the wrong cast. The carrier type and the Errno
// identity are already right; only the value cast was wrong. Mirrors the payload-less-enum
// map-get arm and the list transparent-newtype element arm (both cast by value, not by pointer).
// Written in the corpus so the shape is the real self-hosted build, not a compile_and_run
// string (feedback_corpus_sweep_is_not_coverage).

import std.errno.{Errno}

test "a Map[Str, Errno] reads its transparent value back through get().unwrap() then a match" {
    let mut m: Map[Str, Errno] = Map()
    m.insert("a", Errno(5))
    m.insert("b", Errno(9))
    let e = m.get("a").unwrap()
    let ra = match e { Errno(rc) => rc }
    assert_eq(ra, 5)
    let f = m.get("b").unwrap()
    let rb = match f { Errno(rc) => rc }
    assert_eq(rb, 9)
}

test "a Map[Str, Errno] reads back through a match on the Option directly" {
    let mut m: Map[Str, Errno] = Map()
    m.insert("x", Errno(3))
    let got = match m.get("x") {
        Some(e) => match e { Errno(rc) => rc }
        None => -1
    }
    assert_eq(got, 3)
}

test "a Map[Str, Errno] reads back through a ?? default coalesce" {
    let mut m: Map[Str, Errno] = Map()
    m.insert("a", Errno(7))
    let e = m.get("a") ?? Errno(0)
    let ra = match e { Errno(rc) => rc }
    assert_eq(ra, 7)
    let miss = m.get("z") ?? Errno(42)
    let rm = match miss { Errno(rc) => rc }
    assert_eq(rm, 42)
}

test "a missing key yields None over a transparent Map value" {
    let mut m: Map[Str, Errno] = Map()
    m.insert("a", Errno(1))
    assert(!m.get("z").is_some())
    assert(m.get("a").is_some())
}

// Class-B path: the value type is INFERRED from the insert (no annotation), so
// the map's value identity must ride the tid, not only the flat sname2 channel.
test "an inferred Map value (no annotation) reads its transparent value by value" {
    let mut m = Map()
    m.insert("a", Errno(5))
    m.insert("b", Errno(9))
    let e = m.get("a").unwrap()
    let ra = match e { Errno(rc) => rc }
    assert_eq(ra, 5)
    let f = m.get("b").unwrap()
    let rb = match f { Errno(rc) => rc }
    assert_eq(rb, 9)
}
