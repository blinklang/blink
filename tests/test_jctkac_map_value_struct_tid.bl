// A Map whose VALUE is a struct/enum must name that value from the map tid, so
// get_map_value_struct can lead with the tid instead of the flat sname2 channel.
// Covers a plain non-generic struct value (Point), a generic-instance struct
// value (Box[Int] -> mono stem), and a payloadless enum value (Color), read back
// via .get().unwrap() field/variant access and via for-in pair iteration. The
// change is emit-C byte-identical corpus-wide, so this is a behavioral guard that
// the value name survives, not a channel-attribution test (a runtime .bl test
// cannot see which channel produced an identical name). Guards the tid-first
// migration of get_map_value_struct (tid-sole-authority, map-value-struct family).

type Point { x: Int, y: Int }
type Box[T] { value: T }

type Color { Red, Green, Blue }

fn plain_struct_value_get() -> Int {
    let mut m: Map[Str, Point] = Map()
    m.insert("a", Point { x: 3, y: 4 })
    let p = m.get("a").unwrap()
    p.x + p.y
}

fn plain_struct_value_forin() -> Int {
    let mut m: Map[Str, Point] = Map()
    m.insert("a", Point { x: 5, y: 6 })
    let mut acc = 0
    for (_k, v) in m {
        acc = acc + v.x + v.y
    }
    acc
}

fn generic_instance_value_get() -> Int {
    let mut m: Map[Str, Box[Int]] = Map()
    m.insert("a", Box { value: 42 })
    let b = m.get("a").unwrap()
    b.value
}

fn generic_instance_value_forin() -> Int {
    let mut m: Map[Str, Box[Int]] = Map()
    m.insert("a", Box { value: 21 })
    let mut acc = 0
    for (_k, v) in m {
        acc = acc + v.value
    }
    acc
}

fn enum_value_get() -> Int {
    let mut m: Map[Str, Color] = Map()
    m.insert("a", Color.Green)
    match m.get("a").unwrap() {
        Color.Red => 1
        Color.Green => 2
        Color.Blue => 3
    }
}

test "plain struct map value names Point via the tid on get" {
    assert_eq(plain_struct_value_get(), 7)
}

test "enum map value names Color via the tid on get" {
    assert_eq(enum_value_get(), 2)
}

test "plain struct map value names Point via the tid on for-in" {
    assert_eq(plain_struct_value_forin(), 11)
}

test "generic-instance map value names the mono stem via get" {
    assert_eq(generic_instance_value_get(), 42)
}

test "generic-instance map value names the mono stem via for-in" {
    assert_eq(generic_instance_value_forin(), 21)
}
