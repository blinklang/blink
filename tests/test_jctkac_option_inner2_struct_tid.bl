// get_var_option_inner2_struct names the STRUCT held inside an Option var's List/Map inner, so
// unwrapping the Option and then reading a field off a list element / map value emits the right
// struct member access. Every row unwraps through the carrier and reads a struct field, so an
// empty or wrong name fails to compile or reads the wrong field. The rows cover the accessor's
// dispatch positions:
//   - Ident-read of an Option[List[Struct]] / Option[Map[K,Struct]] var
//   - a match scrutinee on such a var
//   - a reassignment of a mutable such var
//   - a generic struct INSTANCE inner (Box[Int]) — the mono-stem name path
//   - a scalar inner (Int) — no nested struct, names ""

type Point {
    x: Int
    y: Int
}

type Box[T] {
    value: T
}

// ── Option[List[Struct]] var → Ident-read + unwrap + index + field ─────────────────────
test "an Option-of-list-of-struct var reads a nested struct field" {
    let o: Option[List[Point]] = Some([Point { x: 1, y: 2 }, Point { x: 3, y: 4 }])
    let lst = o.unwrap()
    assert_eq(lst.get(1).unwrap().x, 3)
}

// ── Option[Map[Str,Struct]] var → Ident-read + unwrap + get + field ────────────────────
test "an Option-of-map-of-struct var reads a nested struct field" {
    let mut m: Map[Str, Point] = Map()
    m.insert("a", Point { x: 5, y: 6 })
    let o: Option[Map[Str, Point]] = Some(m)
    let mm = o.unwrap()
    assert_eq(mm.get("a").unwrap().y, 6)
}

// ── match scrutinee on the Option var → the inner list binder keeps its struct element ──
test "a match on an Option-of-list-of-struct var binds the inner list" {
    let o: Option[List[Point]] = Some([Point { x: 7, y: 8 }])
    let r = match o {
        Some(lst) => lst.get(0).unwrap().x
        None => -1
    }
    assert_eq(r, 7)
}

// ── reassignment of a mutable Option var → the set path re-stamps the nested struct ─────
test "a reassigned Option-of-list-of-struct var reads the new struct field" {
    let mut o: Option[List[Point]] = None
    o = Some([Point { x: 9, y: 10 }])
    assert_eq(o.unwrap().get(0).unwrap().y, 10)
}

// ── generic struct INSTANCE inner → the mono-stem naming path (Box_0Int) ────────────────
test "an Option-of-list-of-generic-instance var reads the boxed field" {
    let o: Option[List[Box[Int]]] = Some([Box { value: 42 }])
    assert_eq(o.unwrap().get(0).unwrap().value, 42)
}

// ── negative: a scalar inner has no nested struct, and must still round-trip ────────────
test "an Option-of-list-of-scalar var round-trips without a nested struct" {
    let o: Option[List[Int]] = Some([11, 22])
    assert_eq(o.unwrap().get(1).unwrap(), 22)
}
