// get_var_option_inner_struct / get_var_result_ok_struct / get_var_result_err_struct name the struct
// held on an Option's inner slot, a Result's ok slot and a Result's err slot. Each reader tries the
// binding tid first and then falls back to the flat sname/sname2 channel; these rows reach the readers
// through paths that do NOT stamp that flat channel (fn return, match binding, alias chain, struct
// field, generic instance), so once the fallback is severed the struct name must still round-trip from
// the authoritative tid alone. Every row unwraps/matches and reads a field off the struct — a wrong or
// empty name fails to compile or reads the wrong field.

@derive(Hash, Eq)
type Point {
    x: Int
    y: Int
}

type Oops {
    code: Int
}

// A transparent newtype and a payloadless enum both erase to scalar C storage, yet their
// module-qualified nominal name is still the carrier-tag half (blink_Result_int_..._Code). The
// carrier tag must round-trip from the var's authoritative type, so these rows guard the Result
// ok/err tag against being erased when the type is recovered rather than carried alongside it.
type Code {
    Code(Int)
}

type Grade { Low, High }

fn make_code_err() -> Result[Int, Code] {
    Err(Code(5))
}

fn make_grade_err() -> Result[Int, Grade] {
    Err(Grade.Low)
}

type Box[T] {
    value: T
}

fn make_opt() -> Option[Point] {
    Some(Point { x: 1, y: 2 })
}

fn make_ok() -> Result[Point, Str] {
    Ok(Point { x: 5, y: 6 })
}

fn make_err_struct() -> Result[Int, Oops] {
    Ok(7)
}

// ── Option[Struct] recovered from a fn return, unwrapped ──────────────────────────────────
test "Option[Point] from a fn return names its inner struct" {
    let o = make_opt()
    let p = o.unwrap()
    assert_eq(p.x, 1)
    assert_eq(p.y, 2)
}

// ── Option[Struct] through a match binding ────────────────────────────────────────────────
test "Option[Point] through match Some binds the inner struct" {
    let o = make_opt()
    match o {
        Some(p) => {
            assert_eq(p.x, 1)
            assert_eq(p.y, 2)
        }
        None => { assert_eq(0, 1) }
    }
}

// ── Option[Struct] through an alias chain ─────────────────────────────────────────────────
test "Option[Point] keeps its inner struct across an alias chain" {
    let o1: Option[Point] = Some(Point { x: 10, y: 20 })
    let o2 = o1
    let o3 = o2
    let p = o3.unwrap()
    assert_eq(p.x, 10)
    assert_eq(p.y, 20)
}

// ── Option[Struct] as a struct field ──────────────────────────────────────────────────────
type OWrap {
    item: Option[Point]
}

test "an Option[Point] struct field names its inner struct" {
    let w = OWrap { item: Some(Point { x: 7, y: 8 }) }
    let p = w.item.unwrap()
    assert_eq(p.x, 7)
    assert_eq(p.y, 8)
}

// ── Option[generic struct INSTANCE] (Box_0Int mono stem) ──────────────────────────────────
test "Option[Box[Int]] names its boxed inner struct" {
    let o: Option[Box[Int]] = Some(Box { value: 99 })
    assert_eq(o.unwrap().value, 99)
}

// ── Result[Struct, Str] ok slot from a fn return ──────────────────────────────────────────
test "Result[Point, Str] from a fn return names its ok struct" {
    let r = make_ok()
    let p = r.unwrap()
    assert_eq(p.x, 5)
    assert_eq(p.y, 6)
}

// ── Result[Struct, Str] ok slot through a match binding ───────────────────────────────────
test "Result[Point, Str] through match Ok binds the ok struct" {
    let r = make_ok()
    match r {
        Ok(p) => {
            assert_eq(p.x, 5)
            assert_eq(p.y, 6)
        }
        Err(_) => { assert_eq(0, 1) }
    }
}

// ── Result[Struct, Str] ok slot across an alias chain ─────────────────────────────────────
test "Result[Point, Str] keeps its ok struct across an alias chain" {
    let r1: Result[Point, Str] = Ok(Point { x: 30, y: 40 })
    let r2 = r1
    let r3 = r2
    let p = r3.unwrap()
    assert_eq(p.x, 30)
    assert_eq(p.y, 40)
}

// ── Result[Int, Struct] err slot from a fn return, matched on Err ─────────────────────────
test "Result[Int, Oops] names its err struct through a match Err arm" {
    let r: Result[Int, Oops] = Err(Oops { code: 42 })
    match r {
        Ok(_) => { assert_eq(0, 1) }
        Err(e) => { assert_eq(e.code, 42) }
    }
}

// ── Result[Int, Struct] err slot across an alias chain ────────────────────────────────────
test "Result[Int, Oops] keeps its err struct across an alias chain" {
    let r1: Result[Int, Oops] = Err(Oops { code: 7 })
    let r2 = r1
    match r2 {
        Ok(_) => { assert_eq(0, 1) }
        Err(e) => { assert_eq(e.code, 7) }
    }
}

// ── Class-B: Option[Struct] recovered from a list-element temp (.get) ──────────────────────
test "Option[Point] from a list-element temp names its inner struct" {
    let ps: List[Point] = [Point { x: 3, y: 4 }]
    let p = ps.get(0).unwrap()
    assert_eq(p.x, 3)
    assert_eq(p.y, 4)
}

// ── Class-B: Option[Struct] recovered from a map-value temp (.get) ─────────────────────────
test "Option[Point] from a map-value temp names its inner struct" {
    let mut m: Map[Int, Point] = Map()
    m.insert(1, Point { x: 11, y: 12 })
    let p = m.get(1).unwrap()
    assert_eq(p.x, 11)
    assert_eq(p.y, 12)
}

// ── Class-B: Option[Result[Struct,Struct]].unwrap() read directly (the _ounv_ Result temp) ──
// Matching on the unwrap result with no intermediate let reads the synthesized Result temp
// itself, whose err struct name must round-trip from the stamped tid once the flat channel is gone.
test "match on Option[Result].unwrap() names the Result err struct" {
    let r: Result[Point, Oops] = Err(Oops { code: 42 })
    let o: Option[Result[Point, Oops]] = Some(r)
    match o.unwrap() {
        Ok(_) => { assert_eq(0, 1) }
        Err(e) => { assert_eq(e.code, 42) }
    }
}

// ── Class-B: Result[Struct,E].unwrap().field reads the _runv_ struct temp directly ──────────
// Reading a field off the unwrap result with no intermediate let reads the synthesized struct
// temp itself (get_var_struct), whose name must round-trip from the stamped tid once flat is gone.
test "Result[Point, Str].unwrap().field names the ok struct temp" {
    let r: Result[Point, Str] = Ok(Point { x: 9, y: 8 })
    assert_eq(r.unwrap().x, 9)
    assert_eq(r.unwrap().y, 8)
}

// ── Class-B: Result[Int,Struct].unwrap_err().field reads the _ruerr_ struct temp directly ───
test "Result[Int, Oops].unwrap_err().field names the err struct temp" {
    let r: Result[Int, Oops] = Err(Oops { code: 77 })
    assert_eq(r.unwrap_err().code, 77)
}

// ── Result[Int, transparent-newtype] err tag round-trips ───────────────────────────────────
// A discard binding declares the carrier type from the var's type alone, so the err tag must come
// from the authoritative type; this is the shape that erases the newtype err to blink_Result_int_void
// if the carrier tag is ever dropped for a scalar-erased err arm.
test "Result[Int, Code] err newtype names its carrier tag through a discard and a match" {
    let _ = make_code_err()
    let r = make_code_err()
    match r {
        Ok(_) => { assert_eq(0, 1) }
        Err(Code(n)) => { assert_eq(n, 5) }
    }
}

// ── Result[Int, payloadless-enum] err tag round-trips ──────────────────────────────────────
test "Result[Int, Grade] err enum names its carrier tag through a discard and a match" {
    let _ = make_grade_err()
    let r = make_grade_err()
    match r {
        Ok(_) => { assert_eq(0, 1) }
        Err(g) => {
            match g {
                Grade.Low => { assert_eq(1, 1) }
                Grade.High => { assert_eq(0, 1) }
            }
        }
    }
}

// ── negative: a scalar Option inner has no struct, and must still round-trip ───────────────
test "Option[Int] round-trips without an inner struct" {
    let o: Option[Int] = Some(33)
    assert_eq(o.unwrap(), 33)
}

// ── negative: a scalar Result ok/err has no struct, and must still round-trip ──────────────
test "Result[Int, Str] round-trips without an ok or err struct" {
    let r: Result[Int, Str] = Ok(44)
    assert_eq(r.unwrap(), 44)
}
