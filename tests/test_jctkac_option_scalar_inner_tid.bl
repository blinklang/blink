// A scalar Option inner (Int/Str/Float/Char/Bool) has a canonical singleton tid, so
// set_var_option now stamps the exact Option carrier tid instead of leaving the binder
// dormant (ty=-1) on the flat inner1 channel alone. These rows reach the scalar-Option
// readers through paths that register the var via the plain set_var_option setter (fn
// return, alias chain, match binding, list/map temp, nested carrier) — each must still
// round-trip its inner value once the tid is the authority. A wrong carrier tid mis-spells
// the unwrap/match and reads the wrong value or fails to compile.

fn make_opt_int() -> Option[Int] {
    Some(7)
}

fn make_opt_str() -> Option[Str] {
    Some("hi")
}

fn make_none_int() -> Option[Int] {
    None
}

test "Option[Int] from a fn return unwraps its scalar" {
    let o = make_opt_int()
    assert_eq(o.unwrap(), 7)
}

test "Option[Str] from a fn return unwraps its scalar" {
    let o = make_opt_str()
    assert_eq(o.unwrap(), "hi")
}

test "Option[Int] None from a fn return is empty" {
    let o = make_none_int()
    assert_eq(o.is_some(), false)
}

test "Option[Float] keeps its scalar across an alias chain" {
    let o1: Option[Float] = Some(3.5)
    let o2 = o1
    let o3 = o2
    assert_eq(o3.unwrap(), 3.5)
}

test "Option[Int] through a match Some binds the scalar" {
    let o: Option[Int] = Some(42)
    match o {
        Some(n) => { assert_eq(n, 42) }
        None => { assert_eq(0, 1) }
    }
}

test "Option[Str] from a list-element temp unwraps its scalar" {
    let xs: List[Str] = ["a", "b"]
    let v = xs.get(1).unwrap()
    assert_eq(v, "b")
}

test "Option[Int] from a map-value temp unwraps its scalar" {
    let mut m: Map[Str, Int] = Map()
    m.insert("k", 99)
    assert_eq(m.get("k").unwrap(), 99)
}

test "Option[Bool] from a fn return unwraps its scalar" {
    let o: Option[Bool] = Some(true)
    assert_eq(o.unwrap(), true)
}

test "Option[Int] with a default coalesces to the inner scalar" {
    let o: Option[Int] = Some(5)
    let v = o ?? 0
    assert_eq(v, 5)
}
