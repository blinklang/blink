import compile_test_helpers.{expect_compile_error}
import blink.ffi

// `Ptr.addr()` yields the integer address, so its result type is Int and codegen emits
// `(int64_t)(intptr_t)…`. typecheck now records that Int tid on the result instead of leaving
// it an unresolved metavar, so the declared type of a binding IS compared against it. This is
// the tid becoming the authority for the addr result: an address stored into a non-Int binding
// is a TypeError with a Blink span, where the metavar used to unify silently and let it through.
//
// `deref` is deliberately NOT pinned here — it stays unsigned in typecheck until br axpq22
// (see test_q3ssqw_ptr_call_return_pointee), so an addr row is the one this step can freeze.

test "Ptr.addr() is usable as an Int" {
    let s = "hi"
    let p = s.as_cstr()
    let a = p.addr()
    assert(a > 0)
    assert_eq(a + 0, a)
}

test "an address stored into a Str binding is a TypeError" {
    let src = "import blink.ffi\nfn main() \{\n    let s = \"hi\"\n    let p = s.as_cstr()\n    let bad: Str = p.addr()\n    io.println(\"\{bad}\")\n}\n"
    expect_compile_error(src, "jctkac_addr_into_str", "TypeError")
}
