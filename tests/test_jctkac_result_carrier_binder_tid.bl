// A Result carrier bound as the INNER of another carrier (`Some(r)` where r is a
// Result) reaches bind_pattern_vars' nested-carrier arm. For a struct or scalar ok/err
// the tag-setter recovers the carrier tid; for a COMPOUND ok/err (Set/Option/List/Map)
// the tag carries no reconstructable tid, so before the tid stamp the ok/err kind came
// off the flat inner1/inner2 channel. Stamping the binder's own authoritative tid moves
// every shape in this arm onto the tid, so the compound cases below exercise the newly
// tid-resolved ok/err path. A lost or mistyped ok/err kind unwraps the wrong shape and
// reads a garbage field.

type Node {
    n: Int
}

fn mk_set(a: Int, b: Int, c: Int) -> Set[Int] {
    let mut s = Set()
    s.insert(a)
    s.insert(b)
    s.insert(c)
    s
}

// ── compound ok: Option[Result[Set[Int], Str]] — Some(r) then r.unwrap() is a Set ──
test "a Result[Set,Str] carrier binder unwraps the ok set" {
    let src: Option[Result[Set[Int], Str]] = Some(Ok(mk_set(1, 2, 3)))
    match src {
        Some(r) => assert_eq(r.unwrap().len(), 3)
        None => assert_eq(1, 0)
    }
}

// ── compound err: Option[Result[Int, Set[Int]]] — Some(r) then r.unwrap_err() is a Set ──
test "a Result[Int,Set] carrier binder unwrap_errs the err set" {
    let src: Option[Result[Int, Set[Int]]] = Some(Err(mk_set(4, 5, 6)))
    match src {
        Some(r) => assert_eq(r.unwrap_err().len(), 3)
        None => assert_eq(1, 0)
    }
}

// ── compound ok: Option[Result[Option[Int], Str]] — Some(r) then r.unwrap() is an Option ──
test "a Result[Option,Str] carrier binder unwraps the ok option" {
    let src: Option[Result[Option[Int], Str]] = Some(Ok(Some(77)))
    match src {
        Some(r) => assert_eq(r.unwrap().unwrap(), 77)
        None => assert_eq(1, 0)
    }
}

// ── struct ok: Option[Result[struct, Str]] — recovered via the tag-setter ──
test "a Result[struct,Str] carrier binder unwraps the ok struct field" {
    let src: Option[Result[Node, Str]] = Some(Ok(Node { n: 11 }))
    match src {
        Some(r) => assert_eq(r.unwrap().n, 11)
        None => assert_eq(1, 0)
    }
}

// ── struct err: Option[Result[Int, struct]] — recovered via the tag-setter ──
test "a Result[Int,struct] carrier binder unwrap_errs the err struct field" {
    let src: Option[Result[Int, Node]] = Some(Err(Node { n: 22 }))
    match src {
        Some(r) => assert_eq(r.unwrap_err().n, 22)
        None => assert_eq(1, 0)
    }
}

// ── scalar ok: Option[Result[Int, Str]] — the plain carrier binder still unwraps ──
test "a scalar Result[Int,Str] carrier binder unwraps the scalar ok" {
    let src: Option[Result[Int, Str]] = Some(Ok(33))
    match src {
        Some(r) => assert_eq(r.unwrap(), 33)
        None => assert_eq(1, 0)
    }
}
