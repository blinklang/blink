// A Result carrier whose ok AND err slots are both scalars (Int/Str/Float/Bool/Char/
// sized-int) has a canonical singleton tid per slot, so the plain fresh-push set_var_result
// now stamps the exact Result carrier tid instead of leaving the binder dormant (ty=-1) on
// the flat inner1/inner2 channels alone. This is the Result twin of the scalar-Option carrier
// reconstruct. These rows register through the plain set_var_result setter (no struct name):
// fn return, alias chain, match Ok/Err, `?` propagation. Each must still round-trip its ok and
// err values once the tid is the authority. A wrong carrier tid mis-spells the match/unwrap and
// reads the wrong value or fails to compile. A slot that is Void or a struct is NOT scalar and
// stays flat-authoritative — those live in the sibling Void/struct spec tests, not here.

fn ri_str(fail: Bool) -> Result[Int, Str] {
    if fail { return Err("bad") }
    Ok(11)
}

fn rs_int(fail: Bool) -> Result[Str, Int] {
    if fail { return Err(404) }
    Ok("ok")
}

fn rf_str(fail: Bool) -> Result[Float, Str] {
    if fail { return Err("nan") }
    Ok(2.5)
}

fn rb_str(fail: Bool) -> Result[Bool, Str] {
    if fail { return Err("no") }
    Ok(true)
}

fn rc_int(fail: Bool) -> Result[Char, Int] {
    if fail { return Err(2) }
    Ok('Z')
}

fn ri32_u8(fail: Bool) -> Result[I32, U8] {
    if fail {
        let e: U8 = 9
        return Err(e)
    }
    let v: I32 = 1000
    Ok(v)
}

fn chain_ri() -> Result[Int, Str] {
    let v = ri_str(false)?
    Ok(v + 1)
}

test "Result[Int, Str] from a fn return matches both arms" {
    let ok = ri_str(false)
    match ok {
        Ok(n) => assert_eq(n, 11)
        Err(_) => assert(false)
    }
    let bad = ri_str(true)
    match bad {
        Ok(_) => assert(false)
        Err(m) => assert_eq(m, "bad")
    }
}

test "Result[Str, Int] from a fn return matches both arms" {
    let ok = rs_int(false)
    match ok {
        Ok(s) => assert_eq(s, "ok")
        Err(_) => assert(false)
    }
    let bad = rs_int(true)
    match bad {
        Ok(_) => assert(false)
        Err(code) => assert_eq(code, 404)
    }
}

test "Result[Float, Str] keeps its scalar ok across an alias chain" {
    let r1 = rf_str(false)
    let r2 = r1
    let r3 = r2
    match r3 {
        Ok(f) => assert_eq(f, 2.5)
        Err(_) => assert(false)
    }
}

test "Result[Bool, Str] from a fn return binds the scalar ok" {
    let ok = rb_str(false)
    match ok {
        Ok(b) => assert_eq(b, true)
        Err(_) => assert(false)
    }
}

test "Result[Char, Int] from a fn return matches both scalar arms" {
    let ok = rc_int(false)
    match ok {
        Ok(c) => assert_eq(c, 'Z')
        Err(_) => assert(false)
    }
    let bad = rc_int(true)
    match bad {
        Ok(_) => assert(false)
        Err(n) => assert_eq(n, 2)
    }
}

test "Result[I32, U8] from a fn return matches both sized-int arms" {
    let ok = ri32_u8(false)
    match ok {
        Ok(n) => assert_eq(n, 1000)
        Err(_) => assert(false)
    }
    let bad = ri32_u8(true)
    match bad {
        Ok(_) => assert(false)
        Err(e) => assert_eq(e, 9)
    }
}

test "Result[Int, Str] propagates its scalar ok through the ? carrier" {
    match chain_ri() {
        Ok(n) => assert_eq(n, 12)
        Err(_) => assert(false)
    }
}
