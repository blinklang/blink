// jctkac: a non-carrier, non-enum return spells its C type from the
// return-annotation tid (c_type_from_tid), not the flat type_from_name/c_type_str
// spelling. Two emit sites route these returns through the scalar branch:
// emit_fn_decl (sig_ret_decl_scalar) and emit_fn_def (sig_ret_def_scalar). The
// branch leads with the tid and keeps the flat spelling only as a fallback for
// when the tid declines (`if s_spelled != "" { .. } else { ret_c }`).
//
// A plain scalar and a scalar type alias resolve to the same string on both
// channels (Int -> int64_t), so those are characterization pins. The load-bearing
// rows are the type-alias returns to a struct and to a generic-struct instance:
// the flat channel spells `void` for an alias name it does not recognise as a
// struct, so a return spelled from it would emit `void f()` and read the wrong
// value; only the tid spells the true carrier (blink_Pt, blink_Box_Int). Each body
// reads a concrete field or value back, so a wrong or empty return spelling would
// fail to compile or compare the wrong bytes. Enum returns route through the
// separate enum branch and struct/generic-struct returns through the carrier
// branch; neither is part of this scalar-branch pin.

type Pt { x: Int, y: Int }
type Box[T] { val: T }
type Foo = Pt
type BoxI = Box[Int]
type Port = Int

fn r_int() -> Int { 7 }
fn r_port() -> Port { 9 }
fn r_alias_struct() -> Foo { Pt { x: 1, y: 2 } }
fn r_alias_generic() -> BoxI { Box { val: 42 } }

test "plain scalar return carries its value" {
    assert(r_int() == 7)
}

test "scalar type-alias return carries its value" {
    assert(r_port() == 9)
}

test "struct type-alias return carries its fields" {
    let p = r_alias_struct()
    assert(p.x == 1)
    assert(p.y == 2)
}

test "generic-instance type-alias return carries its value" {
    let b = r_alias_generic()
    assert(b.val == 42)
}
