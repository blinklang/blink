// A struct field whose type is a tuple (or a nested struct) is read through
// FieldAccess (`h.p`). emit_field_access registers the result expression's struct
// name on the flat ScopeVar.sname channel (get_struct_field_stype) but stamped no
// tid, so a chained read or a match through that field fell back to the flat name.
// The producer now stamps the field node's resolved tid when it round-trips to
// that same carrier name, so the tid leads. Two of the FieldAccess struct-name
// exits stamp the tid: the flat-registered field and the mono generic
// tparam-substituted field. The tuple positional element exit cannot: the
// element-access node's own tid is void (the element type lives on the carrier's
// elem_structs, recovered only from the receiver's tuple tid), so those reads
// stay on the flat sname fallback until a tuple-element recovery path lands.
// These guard field-through-field access once the flat channel is gone.
type THolder { p: (Int, Int) }
type Inner { v: Int }
type SHolder { i: Inner }

type Box[T] { value: T }
type Holder[T] { item: T }
type P { x: Int }

test "chained read through a tuple-typed struct field" {
    let h = THolder { p: (3, 4) }
    assert_eq(h.p._0, 3)
    assert_eq(h.p._1, 4)
}

test "match through a tuple-typed struct field" {
    let h = THolder { p: (5, 6) }
    let r = match h.p {
        (5, y) => y
        _ => 0
    }
    assert_eq(r, 6)
}

test "chained read through a struct-typed struct field" {
    let s = SHolder { i: Inner { v: 9 } }
    assert_eq(s.i.v, 9)
}

test "chained read through a mono generic-instance tparam field" {
    let h: Holder[Box[Int]] = Holder { item: Box { value: 7 } }
    assert_eq(h.item.value, 7)
}

test "chained read through a plain-struct tparam field" {
    let h: Holder[P] = Holder { item: P { x: 5 } }
    assert_eq(h.item.x, 5)
}

test "chained read through a tuple positional struct element" {
    let t: (P, Int) = (P { x: 8 }, 9)
    assert_eq(t._0.x, 8)
}

test "chained read through a tuple positional mono-instance element" {
    let t: (Box[Int], Int) = (Box { value: 4 }, 2)
    assert_eq(t._0.value, 4)
}
